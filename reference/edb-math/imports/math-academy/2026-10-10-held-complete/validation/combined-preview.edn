592186045499 13194139533478 17592186045585 true] [17592186401963 1084 #uuid "d00f8b18-cb37-5c31-961a-3438330ad683" 13194139533478 17592186045585 true] [17592186401964 1081 "p+q=-11\\,\\,\\,{x}_{1}+{x}_{2}=4" 13194139533478 17592186045585 true] [17592186401964 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401964 1084 #uuid "ae0444d5-a369-5e49-89bd-c5ebc8c0237a" 13194139533478 17592186045585 true] [17592186401965 1081 "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=-4" 13194139533478 17592186045585 true] [17592186401965 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401965 1084 #uuid "44f7e400-b932-5f1e-a0ab-bdb9a22e3846" 13194139533478 17592186045585 true] [17592186401966 1081 "p+q=9\\,,\\,\\,{x}_{1}+{x}_{2}=4" 13194139533478 17592186045585 true] [17592186401966 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186401966 1084 #uuid "7d8857d6-881c-5549-bde0-3f1a4f61d2d7" 13194139533478 17592186045585 true] [17592186401967 1068 #edb/ref 17592186401968 13194139533478 17592186045585 true] [17592186401967 1069 "q-30055" 13194139533478 17592186045585 true] [17592186401967 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186401967 1071 "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" 13194139533478 17592186045585 true] [17592186401967 1072 #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" 13194139533478 17592186045585 true] [17592186401967 1074 "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$" 13194139533478 17592186045585 true] [17592186401968 1075 #edb/ref 17592186401969 13194139533478 17592186045585 true] [17592186401968 1075 #edb/ref 17592186401970 13194139533478 17592186045585 true] [17592186401968 1075 #edb/ref 17592186401971 13194139533478 17592186045585 true] [17592186401968 1075 #edb/ref 17592186401972 13194139533478 17592186045585 true] [17592186401968 1075 #edb/ref 17592186401973 13194139533478 17592186045585 true] [17592186401968 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186401968 1077 "selection" 13194139533478 17592186045585 true] [17592186401968 1079 #edb/ref 17592186401971 13194139533478 17592186045585 true] [17592186401968 1080 #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" 13194139533478 17592186045585 true] [17592186401969 1081 "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533478 17592186045585 true] [17592186401969 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186401969 1084 #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" 13194139533478 17592186045585 true] [17592186401970 1081 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" 13194139533478 17592186045585 true] [17592186401970 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186401970 1084 #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" 13194139533478 17592186045585 true] [17592186401971 1081 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533478 17592186045585 true] [17592186401971 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186401971 1084 #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" 13194139533478 17592186045585 true] [17592186401972 1081 "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533478 17592186045585 true] [17592186401972 1083 #edb/ref 17592186045500 13194139533478 17592186045585 tr