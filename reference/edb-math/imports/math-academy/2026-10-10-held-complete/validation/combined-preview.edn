t{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(8-\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t+64-16\\operatorname{sin}⁡t+{sin}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}\\sqrt{10{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t\\,.\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186400086 1075 #edb/ref 17592186400087 13194139533478 17592186045585 true] [17592186400086 1075 #edb/ref 17592186400088 13194139533478 17592186045585 true] [17592186400086 1075 #edb/ref 17592186400089 13194139533478 17592186045585 true] [17592186400086 1075 #edb/ref 17592186400090 13194139533478 17592186045585 true] [17592186400086 1075 #edb/ref 17592186400091 13194139533478 17592186045585 true] [17592186400086 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186400086 1077 "selection" 13194139533478 17592186045585 true] [17592186400086 1079 #edb/ref 17592186400091 13194139533478 17592186045585 true] [17592186400086 1080 #uuid "51bd27ca-b51f-55c8-a2b1-03c787e77a4f" 13194139533478 17592186045585 true] [17592186400087 1081 "2{\\int }_{-1}^{1}\\sqrt{5{sin}^{2}⁡t-8\\operatorname{sin}⁡t+32}\\,\\text{d}t" 13194139533478 17592186045585 true] [17592186400087 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186400087 1084 #uuid "95a19ab2-d61e-5cd4-9296-0ccc2a2ce9cc" 13194139533478 17592186045585 true] [17592186400088 1081 "{\\int }_{-1}^{1}\\sqrt{9{sin}^{2}⁡t-8\\operatorname{sin}⁡t+64}\\,\\text{d}t" 13194139533478 17592186045585 true] [17592186400088 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186400088 1084 #uuid "6f516eb5-80db-56b9-88c4-8fec44175002" 13194139533478 17592186045585 true] [17592186400089 1081 "{\\int }_{-1}^{1}\\sqrt{{sin}^{2}⁡t-16\\operatorname{sin}⁡t+64}\\,\\text{d}t" 13194139533478 17592186045585 true] [17592186400089 1083 #edb/ref 17592186045499 13194139533478 1759