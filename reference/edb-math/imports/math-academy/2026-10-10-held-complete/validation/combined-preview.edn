2186045585 true] [17592186403619 1069 "q-73190" 13194139533478 17592186045585 true] [17592186403619 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186403619 1071 "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." 13194139533478 17592186045585 true] [17592186403619 1072 #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" 13194139533478 17592186045585 true] [17592186403619 1074 "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$" 13194139533478 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403621 13194139533478 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403622 13194139533478 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403623 13194139533478 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403624 13194139533478 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403625 13194139533478 17592186045585 true] [17592186403620 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403620 1077 "selection" 13194139533478 17592186045585 true] [17592186403620 1079 #edb/ref 17592186403622 13194139533478 17592186045585 true] [17592186403620 1080 #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" 13194139533478 17592186045585 true] [17592186403621 1081 "$(0,0,0)$ and $(2,0,0)$" 13194139533478 17592186045585 true] [17592186403621 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403621 1084 #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" 13194139533478 17592186045585 true] [17592186403622 1081 "$(-2,0,0)$ and $(4,0,0)$" 13194139533478 17592186045585 true] [17592186403622 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403622 1084 #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" 13194139533478 17592186045585 true] [17592186403623 1081 "$(-4,0,0)$ and $(4,0,0)$" 13194139533478 17592186045585 true] [17592186403623 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403623 1084 #uuid "81a50ee6-a29f-5cf2-ba44-251758623d8b" 13194139533478 17592186045585 true] [17592186403624 1081 "$(4,0,0)$ only" 13194139533478 17592186045585 true] [17592186403624 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403624 1084 #uuid "ef09c53b-97f7-594e-a8f7-fee68af6a063" 13194139533478 17592186045585 true] [17592186403625 1081 "$(-3\\sqrt{2},0,0)$ and $(3\\sqrt{2},0,0)$" 13194139533478 17592186045585 true] [17592186403625 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186403625 1084 #uuid "b4640bb5-2749-5d8c-bb08-ee4349a6f316" 13194139533478 17592186045585 true] [17592186403626 1068 #edb/ref 17592186403627 13194139533478 17592186045585 true] [17592186403626 1069 "q-73210" 13194139533478 17592186045585 true] [17592186403626 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186403626 1071 "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=t{e}^{-2t}$, where $t\\ge 0$ is the time, measured in seconds. Find the time intervals in which the particle is moving in the direction of increasing $x.$" 13194139533478 17592186045585 true] [17592186403626 1072 #uuid "08503449-abde-5746-b6d7-46180193efed" 13194139533478 17592186045585 true] [17592186403626 1074 "If the particle moves in the direction of increasing $x,$ then its velocity is positive. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t{e}^{-2t}) \\\\  & ={e}^{-2t}(1-2t)\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of increasing $x$, we solve $v(t)>0:$\n\n$$\n\\begin{aligned}v(t) & >0 \\\\ {e}^{-2t}(1-2t) & >0 \\\\ 1-2t & >0 \\\\ 2t & <1 \\\\ t & <\\frac{1}{2}\\end{aligned}\n$$\n\nHence, the time interval in which the particle is moving to the direction of increasing $x$ is $t\\in [0,\\frac{1}{2}).$" 13194139533478 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403628 13194139533478 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403629 13194139533478 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403630 13194139533478 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403631 13194139533478 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403632 13194139533478 17592186045585 true] [17592186403627 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186403627 1077 "selection" 13194139533478 17592186045585 true] [17592186403627 1079 #edb/ref 17592186403631 13194139533478 17592186045585 true] [17592186403627 1080 #uuid "04f008a8-35a2-5209-a21c-d7193e72a599" 13194139533478 17592186045585 true] [17592186403628 1081 "[0,\\frac{1}{4})" 13194139533478 17592186045585 true] [17592186403628 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403628 1084 #uuid "dc080a13-8e0c-5832-9bea-08398f14a3f0" 13194139533478 17592186045585 true] [17592186403629 1081 "(\\frac{1}{2},\\infty )" 13194139533478 17592186045585 true] [17592186403629 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403629 1084 #uuid "c0cca4dd-1e7a-5b07-a0de-042fce6f3d42" 13194139533478 17592186045585 true] [17592186403630 1081 "[0,1)" 13194139533478 17592186045585 true] [17592186403630 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186403630 1084 #uuid "37d286fa-57c9-5bfb-a268-edcd61ddcadd" 13194139533478 17592186045585 tr