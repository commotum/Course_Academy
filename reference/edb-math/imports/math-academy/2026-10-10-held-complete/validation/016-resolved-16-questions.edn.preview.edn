 11\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & 3 & 6 \\\\ -5 & 15 & 11\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 3 & 2 \\\\ 0 & 3 & 6 \\\\ 0 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=1,$ which has no solution.\n\nSo, there are no values of $s$ and $t$ such that \n\n$$\n\\begin{aligned}sb+tc=u.\\end{aligned}\n$$\n\nTherefore, we conclude that $u$ does *not* lie on the plane $Π.$" 13194139533478 17592186045585 true] [17592186399566 1075 #edb/ref 17592186399567 13194139533478 17592186045585 true] [17592186399566 1075 #edb/ref 17592186399568 13194139533478 17592186045585 true] [17592186399566 1075 #edb/ref 17592186399569 13194139533478 17592186045585 true] [17592186399566 1075 #edb/ref 17592186399570 13194139533478 17592186045585 true] [17592186399566 1075 #edb/ref 17592186399571 13194139533478 17592186045585 true] [17592186399566 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399566 1077 "selection" 13194139533478 17592186045585 true] [17592186399566 1079 #edb/ref 17592186399571 13194139533478 17592186045585 true] [17592186399566 1080 #uuid "b97ac01d-f426-551c-8b2f-1c4b7bdf001e" 13194139533478 17592186045585 true] [17592186399567 1081 "\\frac{5}{6}" 13194139533478 17592186045585 true] [17592186399567 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399567 1084 #uuid "e98f85e7-255d-57c4-987f-635dd16edd05" 13194139533478 17592186045585 true] [17592186399568 1081 "-10" 13194139533478 17592186045585 true] [17592186399568 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399568 1084 #uuid "22eae911-bfae-55d1-acf2-f7cf5e10e29a" 13194139533478 17592186045585 true] [17592186399569 1081 "8" 13194139533478 17592186045585 true] [17592186399569 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399569 1084 #uuid