139533478 17592186045585 true] [17592186399397 1081 "y={(\\frac{1}{2})}^{x}+2" 13194139533478 17592186045585 true] [17592186399397 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399397 1084 #uuid "cdf02042-68e8-57bc-821d-c4e709f6e6d5" 13194139533478 17592186045585 true] [17592186399398 1068 #edb/ref 17592186399399 13194139533478 17592186045585 true] [17592186399398 1069 "q-72913" 13194139533478 17592186045585 true] [17592186399398 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399398 1071 "Calculate the points where the ellipse $2{x}^{2}+3{y}^{2}-20x+6y+47=0$ intercepts the $x$-axis." 13194139533478 17592186045585 true] [17592186399398 1072 #uuid "3538d2b4-fd15-5d04-9456-067812f7d246" 13194139533478 17592186045585 true] [17592186399398 1074 "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}2{x}^{2}+3{y}^{2}-20x+6y+47 & =0 \\\\ 2{x}^{2}+3(0)^{2}-20x+6(0)+47 & =0 \\\\ 2{x}^{2}-20x+47 & =0 \\\\ 2[{x}^{2}-10x]+47 & =0 \\\\ 2[(x-5)^{2}-25]+47 & =0 \\\\ 2(x-5)^{2}-50+47 & =0 \\\\ 2(x-5)^{2} & =3 \\\\ (x-5)^{2} & =\\frac{3}{2} \\\\ x-5 & =\\pm \\sqrt{\\frac{3}{2}} \\\\ x & =5\\pm \\sqrt{\\frac{3}{2}}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(5-\\sqrt{\\frac{3}{2}},0)$ and $(5+\\sqrt{\\frac{3}{2}},0).$" 13194139533478 17592186045585 true] [17592186399399 1075 #edb/ref 17592186399400 13194139533478 17592186045585 true] [17592186399399 1075 #edb/ref 17592186399401 13194139533478 17592186045585 true] [17592186399399 1075 #edb/ref 17592186399402 13194139533478 17592186045585 true] [17592186399399 1075 #edb/ref 17592186399403 13194139533478 17592186045585 true] [17592186399399 1075 #edb/ref 17592186399404 13194139533478 17592186045585 true] [17592186399399 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399399 1077 "selection" 13194139533478 17592186045585 true] [17592186399399 1079 #edb/ref 17592186399400 13194139533478 17592186045585 true] [17592186399399 1080 #uuid "629087fb-db7f-51a8-827b-0862fb389bb9" 13194139533478 17592186045585 true] [17592186399400 1081 "(5\\pm \\sqrt{\\frac{3}{2}},0)" 13194139533478 17592186045585 true] [17592186399400 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399400 1084 #uuid "ef8edbea-4da2-562c-be95-1803e0e50af8" 13194139533478 17592186045585 true] [17592186399401 1081 "(10\\pm \\frac{3\\sqrt{2}}{2},0)" 13194139533478 17592186045585 true] [17592186399401 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399401 1084 #uuid "e45d242e-ec58-51d9-b98e-0c301509d596" 13194139533478 17592186045585 true] [17592186399402 1081 "There is no $x$-intercept" 13194139533478 17592186045585 true] [17592186399402 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399402 1084 #uuid "9141967a-e95f-5916-97f3-21bd825b34c3" 13194139533478 17592186045585 true] [17592186399403 1081 "(5\\pm \\frac{\\sqrt{3}}{2},0)" 13194139533478 17592186045585 true] [17592186399403 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399403 1084 #uuid "3903afea-29b9-5179-b7c5-dc45513572f2" 13194139533478 17592186045585 true] [17592186399404 1081 "(10\\pm \\frac{\\sqrt{3}}{2},0)" 13194139533478 17592186045585 true] [17592186399404 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399404 1084 #uuid "88c9f761-6944-512d-b426-301b6d2b5ff0" 13194139533478 17592186045585 true] [17592186399405 1068 #edb/ref 17592186399406 13194139533478 17592186045585 true] [17592186399405 1069 "q-72934" 13194139533478 17592186045585 true] [17592186399405 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399405 1071 "Determine  the lengths of the major and minor axes of the ellipse whose equation is ${x}^{2}+4{y}^{2}-4x+16y=-16.$" 13194139533478 17592186045585 true] [17592186399405 1072 #uuid "a0bc6070-452c-59d7-b850-234ba4c8bcd8" 13194139533478 17592186045585 true] [17592186399405 1074 "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-4x+16y & =-16 \\\\ ({x}^{2}-4x)+(4{y}^{2}+16y) & =-16\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-4x)+(4{y}^{2}+16y) & =-16 \\\\ ({x}^{2}-4x)+4({y}^{2}+4y) & =-16 \\\\ [(x-2)^{2}-4]+4[(y+2)^{2}-4] & =-16 \\\\ (x-2)^{2}-4+4(y+2)^{2}-16 & =-16\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-2)^{2}-4+4(y+2)^{2}-16 & =-16 \\\\ (x-2)^{2}+4(y+2)^{2} & =-16+16+4 \\\\ (x-2)^{2}+4(y+2)^{2} & =4 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y+2)^{2}}{1} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y+2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2>1,$ the length of the major axis is $2\\cdot 2=4,$ and the length of the minor axis is $2\\cdot 1=2.$" 13194139533478 17592186045585 true] [17592186399406 1075 #edb/ref 17592186399407 13194139533478 17592186045585 true] [17592186399406 1075 #edb/ref 17592186399408 13194139533478 17592186045585 true] [17592186399406 1075 #edb/ref 17592186399409 13194139533478 17592186045585 true] [17592186399406 1075 #edb/ref 17592186399410 13194139533478 17592186045585 true] [17592186399406 1075 #edb/ref 17592186399411 13194139533478 17592186045585 true] [17592186399406 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399406 1077 "selection" 13194139533478 17592186045585 true] [17592186399406 1079 #edb/ref 17592186399410 13194139533478 17592186045585 true] [17592186399406 1080 #uuid "66032e6a-59fa-5bca-a1f1-2d6e69a901e8" 13194139533478 17592186045585 true] [17592186399407 1081 "$4$ and $1$" 13194139533478 17592186045585 true] [17592186399407 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399407 1084 #uuid "7c381e28-47d1-516c-ba70-794