[17592186399407 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399407 1084 #uuid "286a7a4d-b364-5fd1-bc1c-cdcc0f25f9a8" 13194139533478 17592186045585 true] [17592186399408 1081 "Every number is greater than its square." 13194139533478 17592186045585 true] [17592186399408 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399408 1084 #uuid "676c24b5-3446-5b45-8adc-2f8128e722d4" 13194139533478 17592186045585 true] [17592186399409 1081 "There is a number whose square is between $0$ and $1.$" 13194139533478 17592186045585 true] [17592186399409 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399409 1084 #uuid "db1e01e2-6988-5261-bb19-4bde540dddf9" 13194139533478 17592186045585 true] [17592186399410 1081 "Every number between $0$ and $1$ is greater than its square." 13194139533478 17592186045585 true] [17592186399410 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399410 1084 #uuid "9830dd3d-604d-5712-a275-601b3e2f9f76" 13194139533478 17592186045585 true] [17592186399411 1068 #edb/ref 17592186399412 13194139533478 17592186045585 true] [17592186399411 1069 "q-17392" 13194139533478 17592186045585 true] [17592186399411 1070 #edb/ref 17592186045486 13194139533478 17592186045585 true] [17592186399411 1071 "Given that $y=2{x}^{e}-ln⁡x$, find the instantaneous rate of change at $x=1.$" 13194139533478 17592186045585 true] [17592186399411 1072 #uuid "104d7814-9b21-55a2-864d-c61ec56f5c8f" 13194139533478 17592186045585 true] [17592186399411 1074 "To find the instantaneous rate of change at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{e}-ln⁡x) \\\\  & =2e{x}^{e-1}-\\frac{1}{x}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1} & ={(2e{x}^{e-1}-\\frac{1}{x})|}_{x=1} \\\\  & =2e\\cdot {1}^{e-1}-\\frac{1}{1} \\\\  & =2e-1\\,.\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186399412 1075 #edb/ref 17592186399413 13194139533478 17592186045585 true] [17592186399412 1075 #edb/ref 17592186399414 13194139533478 17592186045585 true] [17592186399412 1075 #edb/ref 17592186399415 13194139533478 17592186045585 true] [17592186399412 1075 #edb/ref 17592186399416 13194139533478 17592186045585 true] [17592186399412 1075 #edb/ref 17592186399417 13194139533478 17592186045585 true] [17592186399412 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399412 1077 "selection" 13194139533478 17592186045585 true] [17592186399412 1079 #edb/ref 17592186399414 13194139533478 17592186045585 true] [17592186399412 1080 #uuid "5088efea-7f9e-57d5-8f9c-14c688a0e06b" 13194139533478 17592186045585 true] [17592186399413 1081 "2e" 13194139533478 17592186045585 true] [17592186399413 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399413 1084 #uuid "0beb1ecb-7649-51d5-8923-8085f1d146bc" 13194139533478 17592186045585 true] [17592186399414 1081 "2e-1" 13194139533478 17592186045585 true] [17592186399414 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399414 1084 #uuid "aa5ec049-b8d0-5c17-a28c-05813122674f" 13194139533478 17592186045585 true] [17592186399415 1081 "2" 13194139533478 17592186045585 true] [17592186399415 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399415 1084 #uuid "c2d87b1b-17a5-523c-a973-f5e0ad287cd3" 13194139533478 17592186045585 true] [17592186399416 1081 "2e+1" 13194139533478 17592186045585 true] [17592186399416 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399416 1084 #uuid "ea4f4094-0cfd-5ae4-8308-88f0b83b2c27" 13194139533478 17592186045585 true] [17592186399417 1081 "-1" 13194139533478 17592186045585 true] [17592186399417 1083 #edb/ref 17592186045499 13194139533478 175921860455