 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399589 1071 "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" 13194139533478 17592186045585 true] [17592186399589 1072 #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" 13194139533478 17592186045585 true] [17592186399589 1074 "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186399590 1075 #edb/ref 17592186399591 13194139533478 17592186045585 true] [17592186399590 1075 #edb/ref 17592186399592 13194139533478 17592186045585 true] [17592186399590 1075 #edb/ref 17592186399593 13194139533478 17592186045585 true] [17592186399590 1075 #edb/ref 17592186399594 13194139533478 17592186045585 true] [17592186399590 1075 #edb/ref 17592186399595 13194139533478 17592186045585 true] [17592186399590 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399590 1077 "selection" 13194139533478 17592186045585 true] [17592186399590 1079 #edb/ref 17592186399593 13194139533478 17592186045585 true] [17592186399590 1080 #uuid "f7aeb284-4f80-510f-8935-07a7e23c626b" 13194139533478 17592186045585 true] [17592186399591 1081 "{x}^{4}{csc}^{2}⁡x+8{x}^{3}cot⁡x" 13194139533478 17592186045585 true] [17592186399591 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399591 1084 #uuid "0a34f86b-faa2-5844-9680-3f6951dc4ecf" 13194139533478 17592186045585 true] [17592186399592 1081 "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}csc⁡x" 13194139533478 17592186045585 true] [17592186399592 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399592 1084 #uuid "63214331-a811-5bf2-8cb7-4da5c8c1d678" 13194139533478 17592186045585 true] [17592186399593 1081 "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}c