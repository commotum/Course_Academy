5 & 1 & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & \\frac{5}{6} \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186399490 1072 #uuid "0ac0783b-5b73-5c8c-959b-6029e5d56c68" 13194139533478 17592186045585 true] [17592186399490 1074 "We write down $J$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $J$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[J\\,|\\,I] & =[\\begin{aligned}2 & -5 & 1 & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}] & {R}_{1} & :={R}_{1}+\\frac{5}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & \\frac{5}{6} \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:=\\frac{1}{2}{R}_{1},\\,{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}.\n$$\n\nThe matrix ${J}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{J}^{-1}=[\\begin{aligned}\\frac{1}{2} & \\frac{5}{6} \\\\ 0 & \\frac{1}{3}\\end{aligned}].\n$$" 13194139533478 17592186045585 true] [17592186399491 1075 #edb/ref 17592186399492 13194139533478 17592186045585 true] [17592186399491 1075 #edb/ref 17592186399493 13194139533478 17592186045585 true] [17592186399491