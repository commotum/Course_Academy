x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$" 13194139533478 17592186045585 true] [17592186399471 1075 #edb/ref 17592186399472 13194139533478 17592186045585 true] [17592186399471 1075 #edb/ref 17592186399473 13194139533478 17592186045585 true] [17592186399471 1075 #edb/ref 17592186399474 13194139533478 17592186045585 true] [17592186399471 1075 #edb/ref 17592186399475 13194139533478 17592186045585 true] [17592186399471 1075 #edb/ref 17592186399476 13194139533478 17592186045585 true] [17592186399471 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399471 1077 "selection" 13194139533478 17592186045585 true] [17592186399471 1079 #edb/ref 17592186399474 13194139533478 17592186045585 true] [17592186399471 1080 #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" 13194139533478 17592186045585 true] [17592186399472 1081 "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533478 17592186045585 true] [17592186399472 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399472 1084 #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" 13194139533478 17592186045585 true] [17592186399473 1081 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" 13194139533478 17592186045585 true] [17592186399473 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399473 1084 #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" 13194139533478 17592186045585 true] [17592186399474 1081 "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533478 17592186045585 true] [17592186399474 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399474 1084 #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" 13194139533478 17592186045585 true] [17592186399475 1081 "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" 13194139533478 17592186045585 true] [17592186399475 1083 #edb/ref 17592186045500 13194139533478 17592186045585 true] [17592186399475 1084 #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" 13194139533478 17592186045585 true] [17592186399476 1081 "$pq=-