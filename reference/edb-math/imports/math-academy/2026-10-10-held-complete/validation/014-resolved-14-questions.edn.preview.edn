5 true] [17592186399606 1081 "y=cos⁡(x)" 13194139533478 17592186045585 true] [17592186399606 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399606 1084 #uuid "7651d643-52d0-5fbc-a55d-9c2d891d4dec" 13194139533478 17592186045585 true] [17592186399607 1081 "y=-cos⁡(x)" 13194139533478 17592186045585 true] [17592186399607 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399607 1084 #uuid "f54912f6-668c-587e-a31b-1ebd55260469" 13194139533478 17592186045585 true] [17592186399608 1081 "y=-cos⁡(x+1)" 13194139533478 17592186045585 true] [17592186399608 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399608 1084 #uuid "67c9f2ed-6bc9-5306-bbd4-92c22c1a12b0" 13194139533478 17592186045585 true] [17592186399609 1081 "y=-cos⁡(x+1)-1" 13194139533478 17592186045585 true] [17592186399609 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399609 1084 #uuid "b68c49b7-6a46-50a7-8650-9997f0344c42" 13194139533478 17592186045585 true] [17592186399610 1068 #edb/ref 17592186399611 13194139533478 17592186045585 true] [17592186399610 1069 "q-67703" 13194139533478 17592186045585 true] [17592186399610 1070 #edb/ref 17592186045487 13194139533478 17592186045585 true] [17592186399610 1071 "![](images/0b/0b0074bb582011695cec9807beab1623c6aab894e0c6abeb1bf3068be6ed3543.png)\n\nFind ${lim}_{x\\to \\,3}\\frac{\\sqrt{25-f(x)}}{2}$ for the function $f(x)$ plotted above." 13194139533478 17592186045585 true] [17592186399610 1072 #uuid "8c978569-5523-50ca-8c37-1ccfd41ba3f3" 13194139533478 17592186045585 true] [17592186399610 1074 "From the graph, we get that ${lim}_{x\\to \\,3}f(x)=9.$ \n\nApplying the root rule, we get\n \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,3}\\frac{\\sqrt{25-f(x)}}{2} & =\\frac{1}{2}\\sqrt{{lim}_{x\\to \\,3}(25-f(x))} \\\\  & =\\frac{1}{2}\\sqrt{25-9} \\\\  & =\\frac{\\sqrt{16}}{2} \\\\  & =\\frac{4}{2} \\\\  & =2\\,.\\end{aligned}\n$$" 13194139533478 17592186045585 true] [17592186399611 1075 #edb/ref 17592186399612 13194139533478 17592186045585 true] [17592186399611 1075 #edb/ref 17592186399613 13194139533478 17592186045585 true] [17592186399611 1075 #edb/ref 17592186399614 13194139533478 17592186045585 true] [17592186399611 1075 #edb/ref 17592186399615 13194139533478 17592186045585 true] [17592186399611 1075 #edb/ref 17592186399616 13194139533478 17592186045585 true] [17592186399611 1076 #edb/ref 17592186045493 13194139533478 17592186045585 true] [17592186399611 1077 "selection" 13194139533478 17592186045585 true] [17592186399611 1079 #edb/ref 17592186399614 13194139533478 17592186045585 true] [17592186399611 1080 #uuid "89a133e4-dd1e-5f83-ae36-ea8f3bd624c1" 13194139533478 17592186045585 true] [17592186399612 1081 "\\frac{\\sqrt{19}}{2}" 13194139533478 17592186045585 true] [17592186399612 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399612 1084 #uuid "d3e5e428-55c6-547c-8a43-b717c453f470" 13194139533478 17592186045585 true] [17592186399613 1081 "-\\frac{\\sqrt{19}}{2}" 13194139533478 17592186045585 true] [17592186399613 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399613 1084 #uuid "5a425311-e469-5ff8-a1bd-9454c87692d4" 13194139533478 17592186045585 true] [17592186399614 1081 "2" 13194139533478 17592186045585 true] [17592186399614 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399614 1084 #uuid "deefb1bd-abfc-5373-b490-cefccc51642f" 13194139533478 17592186045585 true] [17592186399615 1081 "4" 13194139533478 17592186045585 true] [17592186399615 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399615 1084 #uuid "35d21c38-0370-5025-8bcc-f844ea185348" 13194139533478 17592186045585 true] [17592186399616 1081 "\\text{DNE}" 13194139533478 17592186045585 true] [17592186399616 1083 #edb/ref 17592186045499 13194139533478 17592186045585 true] [17592186399616 1084 #uuid "934c6624-2691-5291-bbc2-1f43189f8e12" 13194139533478 17592186045585 true] [17592