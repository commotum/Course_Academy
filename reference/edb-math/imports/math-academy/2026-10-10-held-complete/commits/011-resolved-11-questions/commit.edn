 equilibrium point is\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}].\n$$" 13194139533488 17592186045585 true] [17592186402161 1075 #edb/ref 17592186402162 13194139533488 17592186045585 true] [17592186402161 1075 #edb/ref 17592186402163 13194139533488 17592186045585 true] [17592186402161 1075 #edb/ref 17592186402164 13194139533488 17592186045585 true] [17592186402161 1075 #edb/ref 17592186402165 13194139533488 17592186045585 true] [17592186402161 1075 #edb/ref 17592186402166 13194139533488 17592186045585 true] [17592186402161 1076 #edb/ref 17592186045493 13194139533488 17592186045585 true] [17592186402161 1077 "selection" 13194139533488 17592186045585 true] [17592186402161 1079 #edb/ref 17592186402162 13194139533488 17592186045585 true] [17592186402161 1080 #uuid "151341a6-4b50-5d9d-ac35-c33852fb4d04" 13194139533488 17592186045585 true] [17592186402162 1081 "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ only" 13194139533488 17592186045585 true] [17592186402162 1083 #edb/ref 17592186045500 13194139533488 17592186045585 true] [17592186402162 1084 #uuid "8c9870a1-f792-53e1-9097-5a43d6035fea" 13194139533488 17592186045585 true] [17592186402163 1081 "$[\\begin{aligned}1 \\\\ 3\\end{aligned}]$ only" 13194139533488 17592186045585 true] [17592186402163 1083 #edb/ref 17592186045500 13194139533488 17592186045585 true] [17592186402163 1084 #uuid "a89a0be5-8768-5590-83e4-bcbf4ea9fb31" 13194139533488 17592186045585 true] [17592186402164 1081 "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ only" 13194139533488 17592186045585 true] [17592186402164 1083 #edb/ref 17592186045500 13194139533488 17592186045585 true] [17592186402164 1084 #uuid "b2bb60e5-5192-5666-b667-43311399f89e" 13194139533488 17592186045585 true] [17592186402165 1081 "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ 3\\end{aligned}]$" 13194139533488 17592186045585 true] [17592186402165 1083 #edb/ref 17592186045500 13194139533488 17592186045585 true] [1759