/id #uuid "bd18628c-8037-5444-b888-242bcbacc434" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402181} {:answer-field/choices [{:answer/id #uuid "4c576259-6c6e-5669-aec9-e51c2e3a2db4" :answer/type {:db/ident :answer.type/text} :answer/value "a stable" :db/id #edb/ref 17592186402188} {:answer/id #uuid "0e0d100e-f419-5e52-ad61-2a7b332cb3eb" :answer/type {:db/ident :answer.type/text} :answer/value "an asymptotically stable" :db/id #edb/ref 17592186402189} {:answer/id #uuid "b989226b-07e6-5ad1-b581-53eaefe710a9" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186402190}] :answer-field/correct {:answer/id #uuid "b989226b-07e6-5ad1-b581-53eaefe710a9" :answer/type {:db/ident :answer.type/text} :answer/value "an unstable" :db/id #edb/ref 17592186402190} :answer-field/id #uuid "9789c812-7c97-531a-824f-9417cc8dcf9f" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402187} {:answer-field/choices [{:answer/id #uuid "50b2fb90-c997-5d8a-8c2c-58b338a6f24d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{1,2}=\\pm \\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186402192} {:answer/id #uuid "08f236ff-2d54-5d0a-9a7e-8ff4039379f1" :answer/type {:db/ident :answer.type/text} :answer/value "${\\lambda }_{1}=1$ and ${\\lambda }_{2}=0$" :db/id #edb/ref 17592186402193} {:answer/id #uuid "3f4b1ff7-1db5-5449-8eca-1856421419d6" :answer/type {:db/ident :answer.type/text} :answer/value "${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-1$" :db/id #edb/ref 17592186402194} {:answer/id #uuid "0c454302-58ca-534d-8058-79080afdbc7f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{1,2}=-1\\pm \\text{i}" :db/id #edb/ref 17592186402195}] :answer-field/correct {:answer/id #uuid "3f4b1ff7-1db5-5449-8eca-1856421419d6" :answer/type {:db/ident :answer.type/text} :answer/value "${\\lambda }_{1}=2$ and ${\\lambda }_{2}=-1$" :db/id #edb/ref 17592186402194} :answer-field/id #uuid "9ec1d3de-2fa8-5b5a-8056-b8048e2d2c5f" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402191} {:answer-field/choices [{:answer/id #uuid "e955cf27-4a78-5b0f-b7ec-5c73a099158a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186402197} {:answer/id #uuid "a7ce8925-7aab-5d44-8d17-190f2ab88070" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186402198} {:answer/id #uuid "23cfb8c5-255e-5158-b6db-ebeed815d0c7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402199} {:answer/id #uuid "05f5aeb2-90c4-5542-aae3-0b1805b8b11b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186402200} {:answer/id #uuid "3dc0d3bb-e263-584c-b9a3-061b452a9fe4" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186402201}] :answer-field/correct {:answer/id #uuid "e955cf27-4a78-5b0f-b7ec-5c73a099158a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186402197} :answer-field/id #uuid "1e4c4a93-dbec-5b00-abd1-6fcd3ca98426" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402196} {:answer-field/choices [{:answer/id #uuid "c5db373a-5647-5ce8-8433-d7e2b7577c88" :answer/type {:db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186402203} {:answer/id #uuid "c3d2ea67-a8da-5f60-bb52-55911eab4262" :answer/type {:db/ident :answer.type/text} :answer/value "center" :db/id #edb/ref 17592186402204} {:answer/id #uuid "d08de9b2-d089-5cb2-8453-42cf5ef7f2b8" :answer/type {:db/ident :answer.type/text} :answer/value "source" :db/id #edb/ref 17592186402205} {:answer/id #uuid "35596737-20e2-5919-bb07-79a6a164ef81" :answer/type {:db/ident :answer.type/text} :answer/value "sink" :db/id #edb/ref 17592186402206}] :answer-field/correct {:answer/id #uuid "c5db373a-5647-5ce8-8433-d7e2b7577c88" :answer/type {:db/ident :answer.type/text} :answer/value "saddle" :db/id #edb/ref 17592186402203} :answer-field/id #uuid "405aaccb-2b09-58c3-8f37-96ad6fe067ff" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402202} {:answer-field/choices [{:answer/id #uuid "0234f41d-c506-5e78-8e79-e58ee1e19085" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186402208} {:answer/id #uuid "b2b777f7-364c-5626-889b-acd8d2432b4f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186402209} {:answer/id #uuid "f86c81e4-5ffc-590a-bee6-c31a2b4d7942" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402210} {:answer/id #uuid "26b4b7f1-4d1e-5d04-a085-a90adb893d85" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186402211} {:answer/id #uuid "88cb0c2c-4eb3-51aa-922a-e0d82d33d145" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186402212}] :answer-field/correct {:answer/id #uuid "f86c81e4-5ffc-590a-bee6-c31a2b4d7942" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402210} :answer-field/id #uuid "b25976c6-d6cc-526b-8713-ff3cdf0d728b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402207}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbc98d60-8975-59af-8c09-070d79da0e68" :question/math-academy-id "q-335673" :question/problem "$$\n{\\begin{aligned}{x}^{′}=2x(1-2x)-xy \\\\ {y}^{′}=-y+xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model with carrying capacity above, where $x=x(t)$ represents the prey and $y=y(t)$ represents the predators. Select the correct options in the reasoning below.$\\,$ Evaluating the Jacobian of the system at the equilibrium ${x}^{∗}=[0,\\,0]^{T},$ we get\n\n$$J(x^{\\ast})=\\begin{bmatrix}{{field-1}}&{{field-2}}\\\\{{field-3}}&{{field-4}}\\end{bmatrix}.$$\n\n$\\,$ The eigenvalues of the Jacobian matrix are \n{{field-5}}.\n\n$\\,$ Therefore, the equilibrium at ${x}^{∗}$ is \n{{field-6}}{{field-7}}." :question/worked-solution "Let's denote ${f}_{1}(x,y)=2x(1-2x)-xy$ and ${f}_{2}(x,y)=-y+xy.$\n\nNow, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(2x(1-2x)-xy)=2-8x-y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(2x(1-2x)-xy)=-x \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(-y+xy)=y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(-y+xy)=-1+x\\end{aligned}\n$$\n\nThus, the Jacobian matrix is\n\n$$\nJ=[\\begin{aligned}2-8x-y & -x \\\\ y & -1+x\\end{aligned}].\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ to get\n\n$$\nJ({x}^{∗})=[\\begin{aligned}2-8(0)-0 & -0 \\\\ 0 & -1+0\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nThe eigenvalues of the Jacobian matrix are ${\\lambda }_{1}=2\\text{ and }{\\lambda }_{2}=-1.$ Since the eigenvalues are real with opposite signs, our equilibrium is $\\text{an unstable}$ $\\text{saddle}.$"}] [{:db/id #edb/ref 17592186402213 :knowledge-point/_questions [{:knowledge-point/id #uuid "a34d342c-e7fc-581b-b3d1-ed6a49f1a62f" :knowledge-point/title "Identifying Boundary Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fd99f64-1a0e-5d84-8e13-95caae8d936d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186402215} {:answer/id #uuid "8b10290b-80cb-5b29-9f79-1f195229c212" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186402216} {:answer/id #uuid "05e09efb-9144-55ca-b467-bbf73a07f532" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186402217} {:answer/id #uuid "49d1e9f7-e09c-5fb0-9b7e-39e20b2c166e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186402218} {:answer/id #uuid "9983cf80-2f24-55d7-be17-9eb6b4c84e81" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402219}] :answer-field/correct {:answer/id #uuid "9983cf80-2f24-55d7-be17-9eb6b4c84e81" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402219} :answer-field/id #uuid "acf1e061-7a98-5801-95c8-22217b716f6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402214}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a42fad0a-c170-522e-8f97-0f501aa9bc73" :question/math-academy-id "q-338587" :question/problem "Which of the following systems is a boundary value problem?\n\nI. $4{y}^{″}-{y}^{′}=\\operatorname{cos}⁡(x),\\,y(0)=1$\nII. ${y}^{″}+xy={e}^{x},\\,y(1)=0,\\,y(3)=2$\nIII. ${y}^{″}={x}^{3},\\,y(2)=5$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at *different* locations in the domain of $y,$ then this is a **boundary value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not a boundary value problem. It consists of a differential equation combined with only one condition.\n\n- The second system is a boundary value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=1$ and $x=3$).\n\n- The third system is not a boundary value problem. It consists of a differential equation combined with only one condition."}] [{:db/id #edb/ref 17592186402220 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8c898fc-6802-5296-9866-c844f9ed0349" :knowledge-point/title "Classifying Boundary Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51963deb-494b-5038-a567-d52bbae853d7" :answer/type {:db/ident :answer.type/text} :answer/value "Other" :db/id #edb/ref 17592186402222} {:answer/id #uuid "ca70af21-75b9-54e1-a733-f7fe2f7fa12e" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186402223} {:answer/id #uuid "320aef74-4e39-5907-aac3-4ae1dafcfabd" :answer/type {:db/ident :answer.type/text} :answer/value "Neumann" :db/id #edb/ref 17592186402224} {:answer/id #uuid "99d38800-e0a0-56b4-b188-2bf47e62f659" :answer/type {:db/ident :answer.type/text} :answer/value "Periodic" :db/id #edb/ref 17592186402225} {:answer/id #uuid "b97382cb-a37a-52dd-8bc5-72cf2224232a" :answer/type {:db/ident :answer.type/text} :answer/value "Dirichlet" :db/id #edb/ref 17592186402226}] :answer-field/correct {:answer/id #uuid "ca70af21-75b9-54e1-a733-f7fe2f7fa12e" :answer/type {:db/ident :answer.type/text} :answer/value "Robin" :db/id #edb/ref 17592186402223} :answer-field/id #uuid "dd10be9b-3b17-5633-861a-6fa42ef0e0d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402221}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc494029-58f4-51d4-95fe-9c9b2384d2b2" :question/math-academy-id "q-338623" :question/problem "Consider the following boundary value problem.\n\n$$\n{y}^{″}(x)-{y}^{′}(x)+y(x)={x}^{2},\\,y(1)=0,\\,3y(3)+{y}^{′}(3)=6,\\,1\\le x\\le 3\n$$\n\nWhich of the following best classifies the boundary conditions for this problem?" :question/worked-solution "For a second-order boundary value problem, \n\n$$\n{y}^{″}(x)+P(x){y}^{′}(x)+Q(x)y(x)=f(x),\\,a\\le x\\le b\n$$\n\nwhere $P(x),Q(x)$ and $f(x)$ are all continuous on $[a,b],$ we have the following boundary condition classifications. \n\n- Dirichlet:\n\n$$\ny(a)={\\gamma }_{1},\\,y(b)={\\gamma }_{2}\n$$\n\n- Neumann:\n\n$$\n{y}^{′}(a)={\\gamma }_{1},\\,{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Robin (mixed):\n\n$$\n{\\alpha }_{1}y(a)+{\\beta }_{1}{y}^{′}(a)={\\gamma }_{1},\\,{\\alpha }_{2}y(b)+{\\beta }_{2}{y}^{′}(b)={\\gamma }_{2}\n$$\n\n- Periodic:\n\n$$\ny(a)=y(b),\\,{y}^{′}(a)={y}^{′}(b)\n$$\n\nwhere ${\\gamma }_{i},{\\alpha }_{i},$ and ${\\beta }_{i}$ are real numbers with $({\\alpha }_{i},{\\beta }_{i})\\ne (0,0).$ \n\nIn our case, we have the following boundary conditions, defined on $x=a=1$ and $x=b=3.$\n\n$$\ny(1)=0,\\,3y(3)+{y}^{′}(3)=6\n$$\n\nThese are Robin (mixed) boundary conditions."}] [{:db/id #edb/ref 17592186402227 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ea69de7-f96b-5949-9aec-584cb4e2f214" :knowledge-point/title "Computing an Unknown Time Given an Exponential Growth or Decay Model With an Unknown Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "386007b3-91ce-5982-8534-d31233322fdb" :answer/type {:db/ident :answer.type/text} :answer/value "$6.3$ weeks" :db/id #edb/ref 17592186402229} {:answer/id #uuid "0a01f341-43f3-528c-b811-0f8051a23c3c" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ weeks" :db/id #edb/ref 17592186402230} {:answer/id #uuid "8ac92552-dc2b-5d29-986a-281a4e64330d" :answer/type {:db/ident :answer.type/text} :answer/value "$6.4$ weeks" :db/id #edb/ref 17592186402231} {:answer/id #uuid "c1738319-0cbe-5aa8-beb9-61d8c99fe62b" :answer/type {:db/ident :answer.type/text} :answer/value "$6.5$ weeks" :db/id #edb/ref 17592186402232} {:answer/id #uuid "aa2f0725-683a-50fc-855c-66c7d9ba756f" :answer/type {:db/ident :answer.type/text} :answer/value "$6.2$ weeks" :db/id #edb/ref 17592186402233}] :answer-field/correct {:answer/id #uuid "386007b3-91ce-5982-8534-d31233322fdb" :answer/type {:db/ident :answer.type/text} :answer/value "$6.3$ weeks" :db/id #edb/ref 17592186402229} :answer-field/id #uuid "b4ae4df5-40ba-5454-aa69-0f62becda821" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402228}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b562af2b-8343-5000-806c-d01887adea11" :question/math-academy-id "q-339222" :question/problem "The number of subscribers $N(t)$ to an e-learning platform varies according to the differential equation ${N}^{′}(t)=rN(t),$ where $t$ is the time since the platform was launched, measured in weeks, and $r>0.$ It is known that the number of subscribers doubles after the first four weeks. How long does it take for the number of subscribers to triple after the platform is launched? Round your answer to one decimal place." :question/worked-solution "The general solution to the given differential equation is\n\n$$\nN(t)={N}_{0}{e}^{rt},\n$$\n\nwhere ${N}_{0}$ is the number of subscribers when $t=0.$\n\nLet ${t}_{1}$ be the time when the number of subscribers equals $3{N}_{0}.$ Then, we have \n\n$$\n\\begin{aligned}N({t}_{1}) & =3{N}_{0}\\,⇒\\,{N}_{0}{e}^{r{t}_{1}}=3{N}_{0}.\\end{aligned}\n$$\n\nWe solve this equation for ${t}_{1},$ as follows:\n\n$$\n\\begin{aligned}{N}_{0}{e}^{r{t}_{1}} & =3{N}_{0} \\\\ \\cancel{{N}_{0}}{e}^{r{t}_{1}} & =3\\cancel{{N}_{0}} \\\\ {e}^{r{t}_{1}} & =3 \\\\ \\operatorname{ln}⁡({e}^{r{t}_{1}}) & =\\operatorname{ln}⁡(3) \\\\ r{t}_{1} & =\\operatorname{ln}⁡3 \\\\ {t}_{1} & =\\frac{\\operatorname{ln}⁡3}{r}\\,\\,(∗)\\end{aligned}\n$$\n\nWe now need to calculate $r.$ We're told that the number of subscribers doubles after the first four weeks the platform is launched. Therefore,\n\n$$\nN(4)=2{N}_{0}\\,⇒\\,{N}_{0}{e}^{4r}=2{N}_{0}.\n$$\n\nWe solve this equation for $r,$ as follows:\n\n$$\n\\begin{aligned}{N}_{0}{e}^{4r} & =2{N}_{0} \\\\ \\cancel{{N}_{0}}{e}^{4r} & =2\\cancel{{N}_{0}} \\\\ {e}^{4r} & =2 \\\\ \\operatorname{ln}⁡({e}^{4r}) & =\\operatorname{ln}⁡(2) \\\\ r & =\\frac{\\operatorname{ln}⁡2}{4}\\end{aligned}\n$$\n\nFinally, substituting this into $(∗)$ and evaluating, we get\n\n$$\n\\begin{aligned}{t}_{1} & =\\frac{\\operatorname{ln}⁡3}{r} \\\\  & =\\frac{\\operatorname{ln}⁡3}{(\\frac{\\operatorname{ln}⁡2}{4})} \\\\  & =\\frac{4\\operatorname{ln}⁡3}{\\operatorname{ln}⁡2} \\\\  & ≈6.3,\\end{aligned}\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186402234 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ea69de7-f96b-5949-9aec-584cb4e2f214" :knowledge-point/title "Computing an Unknown Time Given an Exponential Growth or Decay Model With an Unknown Rate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10efe48b-a9f4-5aa8-8700-8513aef294db" :answer/type {:db/ident :answer.type/text} :answer/value "$2.4$ years" :db/id #edb/ref 17592186402236} {:answer/id #uuid "9483f82e-0758-5787-8ce2-48f26c64a23d" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ years" :db/id #edb/ref 17592186402237} {:answer/id #uuid "85698021-f6eb-5674-af9e-26f88bf35ee6" :answer/type {:db/ident :answer.type/text} :answer/value "$2.3$ years" :db/id #edb/ref 17592186402238} {:answer/id #uuid "ec0b804f-53f8-5360-9835-166b54051187" :answer/type {:db/ident :answer.type/text} :answer/value "$2.1$ years" :db/id #edb/ref 17592186402239} {:answer/id #uuid "85d74bd3-72ef-5c17-a201-f97592fcc512" :answer/type {:db/ident :answer.type/text} :answer/value "$2.5$ years" :db/id #edb/ref 17592186402240}] :answer-field/correct {:answer/id #uuid "85698021-f6eb-5674-af9e-26f88bf35ee6" :answer/type {:db/ident :answer.type/text} :answer/value "$2.3$ years" :db/id #edb/ref 17592186402238} :answer-field/id #uuid "fa46205e-ab90-5810-a697-993aab9f4c54" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402235}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8375c335-8cf2-5c82-b2c9-770890e7d65a" :question/math-academy-id "q-339226" :question/problem "The value $V(t)$ of a tech device varies according to the differential equation ${V}^{′}(t)=-rV(t),$ where $t$ is the time, measured in years, and $r>0.$ It is known that the value reduces by one-half after the first year. How long does it take for the value to reduce to one-fifth of its original value? Round your answer to one decimal place." :question/worked-solution "The general solution to the given differential equation is\n\n$$\nV(t)={V}_{0}{e}^{-rt},\n$$\n\nwhere ${V}_{0}$ is the value when $t=0.$\n\nLet ${t}_{1}$ be the time when the value equals $\\frac{1}{5}{V}_{0}.$ Then, we have \n\n$$\n\\begin{aligned}V({t}_{1}) & =\\frac{1}{5}{V}_{0}\\,⇒\\,{V}_{0}{e}^{-r{t}_{1}}=\\frac{1}{5}{V}_{0}.\\end{aligned}\n$$\n\nWe solve this equation for ${t}_{1},$ as follows:\n\n$$\n\\begin{aligned}{V}_{0}{e}^{-r{t}_{1}} & =\\frac{1}{5}{V}_{0} \\\\ \\cancel{{V}_{0}}{e}^{-r{t}_{1}} & =\\frac{1}{5}\\cancel{{V}_{0}} \\\\ {e}^{-r{t}_{1}} & =\\frac{1}{5} \\\\ \\operatorname{ln}⁡({e}^{-r{t}_{1}}) & =\\operatorname{ln}⁡(\\frac{1}{5}) \\\\ -r{t}_{1} & =-\\operatorname{ln}⁡5 \\\\ {t}_{1} & =\\frac{\\operatorname{ln}⁡5}{r}\\,\\,(∗)\\end{aligned}\n$$\n\nWe now need to calculate $r.$ We're told that the value reduces by one-half after the first year. Therefore,\n\n$$\nV(1)=\\frac{1}{2}{V}_{0}\\,⇒\\,{V}_{0}{e}^{-r}=\\frac{1}{2}{V}_{0}.\n$$\n\nWe solve this equation for $r,$ as follows:\n\n$$\n\\begin{aligned}{V}_{0}{e}^{-r} & =\\frac{1}{2}{V}_{0} \\\\ \\cancel{{V}_{0}}{e}^{-r} & =\\frac{1}{2}\\cancel{{V}_{0}} \\\\ {e}^{-r} & =\\frac{1}{2} \\\\ \\operatorname{ln}⁡({e}^{-r}) & =\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ -r & =-\\operatorname{ln}⁡2 \\\\ r & =\\operatorname{ln}⁡2\\end{aligned}\n$$\n\nFinally, substituting this into $(∗)$ and evaluating, we get\n\n$$\n\\begin{aligned}{t}_{1} & =\\frac{\\operatorname{ln}⁡5}{r} \\\\  & =\\frac{\\operatorname{ln}⁡5}{\\operatorname{ln}⁡2} \\\\  & ≈2.3,\\end{aligned}\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186402241 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aeeaf85-0cbd-58ab-91d6-93448ff54b4d" :knowledge-point/title "Calculating an Unknown Initial Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98555ddd-6e37-50dd-95fe-cea932afb900" :answer/type {:db/ident :answer.type/text} :answer/value "$$31.13$" :db/id #edb/ref 17592186402243} {:answer/id #uuid "bcf3ab14-e63c-5a07-8f00-c6624545c11c" :answer/type {:db/ident :answer.type/text} :answer/value "$$116.01$" :db/id #edb/ref 17592186402244} {:answer/id #uuid "e23ede75-277e-5685-b92b-dcc0d6291e35" :answer/type {:db/ident :answer.type/text} :answer/value "$$122.03$" :db/id #edb/ref 17592186402245} {:answer/id #uuid "145dc5fb-065b-57b6-ab94-00b00d6949c4" :answer/type {:db/ident :answer.type/text} :answer/value "$$113.25$" :db/id #edb/ref 17592186402246} {:answer/id #uuid "41ca3324-7989-5875-90e2-784c63f6f17b" :answer/type {:db/ident :answer.type/text} :answer/value "$$114.93$" :db/id #edb/ref 17592186402247}] :answer-field/correct {:answer/id #uuid "41ca3324-7989-5875-90e2-784c63f6f17b" :answer/type {:db/ident :answer.type/text} :answer/value "$$114.93$" :db/id #edb/ref 17592186402247} :answer-field/id #uuid "b6cbfe2e-3815-5b36-b83f-63a2f8eb905b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402242}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1d42a16-3984-5dae-bf8b-539545f414f5" :question/math-academy-id "q-339248" :question/problem "The rate of increase ${E}^{′}(t)$ of the average monthly cost of electricity in a particular region varies according to the differential equation ${E}^{′}(t)=0.02E(t),$ where $t$ is the time, in years, since the year $2017.$ In $2021,$ the average monthly cost was $$124.50.$ What was the average monthly cost of electricity in $2017?$" :question/worked-solution "The general solution to the given differential equation is\n\n$$\nE(t)={E}_{0}\\,{e}^{0.02t},\n$$\n\nwhere ${E}_{0}$ is the average monthly cost of electricity in $2017.$\n\nWe are given that the monthly residential electricity cost was $$124.50$ in $2021,$ so after $t=4$ years. Hence, substituting $t=4$ and $E(4)=124.50$ into our general solution and solving for ${E}_{0},$ we get\n\n$$\n\\begin{aligned}E(4) & ={E}_{0}\\,{e}^{0.02\\cdot 4} \\\\ 124.50 & ={E}_{0}\\,{e}^{0.08} \\\\ {E}_{0} & =\\frac{124.50}{{e}^{0.08}} \\\\  & ≈114.93\\end{aligned}\n$$\n\nrounded to the nearest cent.\n\nTherefore, the average monthly cost in $2017$ was $$114.93.$"}] [{:db/id #edb/ref 17592186402248 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aababf37-9c33-5d0f-9433-1d0cf555f97b" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186402250} {:answer/id #uuid "3fa28dc5-5323-59c1-89c5-ec291f51cc7d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186402251} {:answer/id #uuid "fe799d91-4567-55b5-9d6d-065742893e23" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186402252} {:answer/id #uuid "0560bd9f-1114-574e-9bb5-08d3e454f4bc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186402253} {:answer/id #uuid "f1484f26-148e-5676-bd10-764ffcb28ef8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402254}] :answer-field/correct {:answer/id #uuid "3fa28dc5-5323-59c1-89c5-ec291f51cc7d" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186402251} :answer-field/id #uuid "de781819-e735-5446-8359-21f70d676ce4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c104c7c7-be1b-5f7c-9495-548d3d354240" :question/math-academy-id "q-339251" :question/problem "Which of the following systems is an initial value problem?\n\nI. ${x}^{2}{y}^{″}-2{y}^{′}+y=\\operatorname{ln}⁡x,\\,y(4)=1,\\,{y}^{′}(4)=-1$\nII. $x{y}^{″}+{y}^{′}-2y=9$\nIII. ${x}^{2}{y}^{″}-8x{y}^{′}+16y=\\operatorname{cos}⁡x,\\,y(2)=0,\\,{y}^{′}(2)=3$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=4$).\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=2$)."}] [{:db/id #edb/ref 17592186402255 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8892f2f5-e370-5028-8460-a0e49e8ec9cc" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186402257} {:answer/id #uuid "88eda162-b9e7-53c5-aaf0-8ab22fd5c91a" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186402258} {:answer/id #uuid "42ef59eb-cad5-5519-b0d9-e972100a8fd9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186402259} {:answer/id #uuid "eddbd1d4-bb8e-5d05-a1f6-e513d4b1a8cd" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186402260} {:answer/id #uuid "e7ad3aa9-ab9b-50bd-8028-70bf56ae664a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402261}] :answer-field/correct {:answer/id #uuid "42ef59eb-cad5-5519-b0d9-e972100a8fd9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186402259} :answer-field/id #uuid "5e74f1dd-50b5-55df-99cd-c5f3fc2522c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402256}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7b3292e-ae09-5cdf-bbb6-9d5f24a711b9" :question/math-academy-id "q-339256" :question/problem "Which of the following systems is an initial value problem?\n\nI. $x{y}^{″}-{y}^{′}+2y=\\operatorname{cos}⁡x,\\,y(0)=1,\\,{y}^{′}(0)=-1$\nII. ${x}^{2}{y}^{″}+{y}^{′}-y=5x$\nIII. ${x}^{2}{y}^{″}-3x{y}^{′}+4y={x}^{2},\\,y(1)=0,\\,{y}^{′}(4)=2$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=0$).\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=1$ and $x=4$). This is a **boundary value problem.**"}] [{:db/id #edb/ref 17592186402262 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee24fdf4-e1ee-5f88-bc78-1cd69107c3af" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,4,2)" :db/id #edb/ref 17592186402264} {:answer/id #uuid "3cff9213-8332-5106-9a38-96d7ec4a4378" :answer/type {:db/ident :answer.type/math} :answer/value "(9,5,3)" :db/id #edb/ref 17592186402265} {:answer/id #uuid "9d7ebdfb-49aa-56f4-a0ad-f4d48aa68b14" :answer/type {:db/ident :answer.type/math} :answer/value "(3,5,9)" :db/id #edb/ref 17592186402266} {:answer/id #uuid "6adfa3c5-c5cd-56cd-841d-1fd0fc016077" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-1,6)" :db/id #edb/ref 17592186402267} {:answer/id #uuid "cd22fb61-25ce-5f17-bad1-fbd4ce2f0694" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186402268}] :answer-field/correct {:answer/id #uuid "cd22fb61-25ce-5f17-bad1-fbd4ce2f0694" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186402268} :answer-field/id #uuid "f9e05243-350c-5a1d-ad1e-5c71c37318cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402263}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbfd2820-3a30-53a2-832d-407032fe3cf1" :question/math-academy-id "q-33987" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,5,9⟩+t⟨4,-1,6⟩,\\,Π:-2x+4y+2z-16=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨3+4t,5-t,9+6t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-2x+4y+2z-16 & =0 \\\\ -2x+4y+2z & =16 \\\\ ⟨x,y,z⟩\\cdot ⟨-2,4,2⟩ & =16 \\\\ r\\cdot ⟨-2,4,2⟩ & =16\\end{aligned}\n$$\n\nNow, substituting $r=⟨3+4t,5-t,9+6t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-2,4,2⟩ & =16 \\\\ ⟨3+4t,5-t,9+6t⟩\\cdot ⟨-2,4,2⟩ & =16 \\\\ -2(3+4t)+4(5-t)+2(9+6t) & =16 \\\\ -6-8t+20-4t+18+12t & =16 \\\\ 32 & =16.\\end{aligned}\n$$\n\nThe equation has no solution. Therefore, we conclude that the line $l$ and the plane $Π$ do not intersect."}] [{:db/id #edb/ref 17592186402269 :knowledge-point/_questions [{:knowledge-point/id #uuid "c1e01d04-6c13-52eb-a4b6-ad9a5cde8134" :knowledge-point/title "Integrating a Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56be28be-e705-54a4-a778-9f6ec8ce939a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{5})" :db/id #edb/ref 17592186402271} {:answer/id #uuid "6aed1c1d-e07b-56b5-8813-9bc524e3b177" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\operatorname{cos}⁡(\\frac{n\\pi x}{5}))" :db/id #edb/ref 17592186402272} {:answer/id #uuid "a9f5bf53-f4d6-5d6a-980c-1b00b877e968" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{5})" :db/id #edb/ref 17592186402273} {:answer/id #uuid "413d3322-907e-5aaf-a499-45064137e05b" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\operatorname{sin}⁡(\\frac{n\\pi x}{5}))" :db/id #edb/ref 17592186402274}] :answer-field/correct {:answer/id #uuid "6aed1c1d-e07b-56b5-8813-9bc524e3b177" :answer/type {:db/ident :answer.type/math} :answer/value "(1-\\operatorname{cos}⁡(\\frac{n\\pi x}{5}))" :db/id #edb/ref 17592186402272} :answer-field/id #uuid "6520f82c-2711-5a08-aef8-d05fa583c5ad" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186402270} {:answer-field/choices [{:answer/id #uuid "0840c9bd-29c8-51d1-97c9-4c4a62931e39" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{n\\pi x}{10})" :db/id #edb/ref 17592186402276} {:answer/id #uuid "6426dfc7-965f-5694-8849-76b5475c6032" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{n\\pi x}{5})" :db/id #edb/ref 17592186402277} {:answer/id #uuid "af28147c-5f72-550f-b281-517b8bce6252" :answer/type {:db/ident :a