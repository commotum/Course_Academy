sin}⁡2x}_{⏟}}_{Q(x)}\\,.\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=2\\operatorname{cot}⁡x$ and $Q(x)=-\\operatorname{sin}⁡2x.$" 13194139533495 17592186045585 true] [17592186404266 1075 #edb/ref 17592186404267 13194139533495 17592186045585 true] [17592186404266 1075 #edb/ref 17592186404268 13194139533495 17592186045585 true] [17592186404266 1075 #edb/ref 17592186404269 13194139533495 17592186045585 true] [17592186404266 1075 #edb/ref 17592186404270 13194139533495 17592186045585 true] [17592186404266 1075 #edb/ref 17592186404271 13194139533495 17592186045585 true] [17592186404266 1076 #edb/ref 17592186045493 13194139533495 17592186045585 true] [17592186404266 1077 "selection" 13194139533495 17592186045585 true] [17592186404266 1079 #edb/ref 17592186404271 13194139533495 17592186045585 true] [17592186404266 1080 #uuid "29d75aab-799f-5138-9f8f-42b050f51ab1" 13194139533495 17592186045585 true] [17592186404267 1081 "\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡2x=-2y\\operatorname{cot}⁡x" 13194139533495 17592186045585 true] [17592186404267 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404267 1084 #uuid "d23ea584-4a5e-5d3f-b114-caef1a56d6ff" 13194139533495 17592186045585 true] [17592186404268 1081 "\\frac{\\text{d}y}{\\text{d}x}=-2y\\operatorname{cot}⁡x-\\operatorname{sin}⁡2x" 13194139533495 17592186045585 true] [17592186404268 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404268 1084 #uuid "178d8403-eb54-593d-abc3-5b52a35b7885" 13194139533495 17592186045585 true] [17592186404269 1081 "2y\\operatorname{cot}⁡x=-\\frac{\\text{d}y}{\\text{d}x}-\\operatorname{sin}⁡2x" 13194139533495 17592186045585 true] [17592186404269 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404269 1084 #uuid "ee26e4a3-b2b4-56a4-a778-0012ee7e2935" 13194139533495 17592186045585 true] [17592186404270 1081 "y=-\\frac{1}{2\\operatorname{cot}⁡x}\\frac{\\text{d}y}{\\text{d}x}-\\frac{\\operatorname{sin}⁡2x}{2\\operatorname{cot}⁡x}" 13194139533495 17592186045585 true] [17592186404270 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404270 1084 #uuid "38e4fc3c-40eb-5ddc-a361-e415766dbedb" 13194139533495 17592186045585 true] [17592186404271 1081 "\\frac{\\text{d}y}{\\text{d}x}+2(\\operatorname{cot}⁡x)y=-\\operatorname{sin}⁡2x" 13194139533495 17592186045585 true] [17592186404271 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404271 1084 #uuid "0883a541-a5d0-5369-94ee-df510266f33b" 13194139533495 17592186045585 true] [17592186404272 1068 #edb/ref 17592186404273 13194139533495 17592186045585 true] [17592186404272 1069 "q-8369" 13194139533495 17592186045585 true] [17592186404272 1070 #edb/ref 17592186045485 13194139533495 17592186045585 true] [17592186404272 1071 "Which of the following is a first-order homogeneous ordinary differential equation?" 13194139533495 17592186045585 true] [17592186404272 1072 #uuid "29260781-8760-5b93-aff1-74357dc9fb2c" 13194139533495 17592186045585 true] [17592186404272 1074 "A first-order ordinary differential equation that is written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y)\n$$\n\nis said to be homogeneous if it satisfies the following property:\n\n$$\nf(tx,ty)=f(x,y)\\,\n$$\n\nThe only option in which this is the case is\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}-{x}^{2}}{{x}^{2}+{y}^{2}}.\n$$\n\nWe can check this using one of two methods.\n\n**Method 1**\n\nLet $f(x,y)=\\frac{{y}^{2}-{x}^{2}}{{y}^{2}+{x}^{2}}.$\n\nWe see that both the numerator and denominator are homogeneous polynomials of degree $2.$ Therefore, $f(x,y)$ is a homogeneous function of degree $2-2=0.$\n\nHence, the original differential equation is homogeneous.\n\n**Method 2**\n\nTo check this in detail using the definition, we first write:\n\n$$\nf(x,y)=\\frac{{y}^{2}-{x}^{2}}{{y}^{2}+{x}^{2}}\n$$\n\nWe can check that this is homogeneous showing that $f(tx,ty)=f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f(tx,ty) & =\\frac{(ty)^{2}-(tx)^{2}}{(ty)^{2}+(tx)^{2}} \\\\  & =\\frac{{t}^{2}{y}^{2}-{t}^{2}{x}^{2}}{{t}^{2}{y}^{2}+{t}^{2}{x}^{2}} \\\\  & =\\frac{{t}^{2}({y}^{2}-{x}^{2})}{{t}^{2}({y}^{2}+{x}^{2})} \\\\  & =\\frac{{y}^{2}-{x}^{2}}{{y}^{2}+{x}^{2}} \\\\  & =f(x,y)\\end{aligned}\n$$\n\nSince $f(tx,ty)=f(x,y),$ the original differential equation is homogeneous." 13194139533495 17592186045585 true] [17592186404273 1075 #edb/ref 17592186404274 13194139533495 17592186045585 true] [17592186404273 1075 #edb/ref 17592186404275 13194139533495 17592186045585 true] [17592186404273 1075 #edb/ref 17592186404276 13194139533495 17592186045585 true] [17592186404273 1075 #edb/ref 17592186404277 13194139533495 17592186045585 true] [17592186404273 1075 #edb/ref 17592186404278 13194139533495 17592186045585 true] [17592186404273 1076 #edb/ref 17592186045493 13194139533495 17592186045585 true] [17592186404273 1077 "selection" 13194139533495 17592186045585 true] [17592186404273 1079 #edb/ref 17592186404276 13194139533495 17592186045585 true] [17592186404273 1080 #uuid "b19317f0-552c-5bb1-aa73-1ed888b17d05" 13194139533495 17592186045585 true] [17592186404274 1081 "\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}-{x}^{2}}{{y}^{2}+x}" 13194139533495 17592186045585 true] [17592186404274 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404274 1084 #uuid "5069fb02-022e-544e-b7ca-c45166ca4bac" 13194139533495 17592186045585 true] [17592186404275 1081 "\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}-x}{{y}^{2}+{x}^{2}}" 13194139533495 17592186045585 true] [17592186404275 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [17592186404275 1084 #uuid "ffcfa690-e3cd-5cc8-9177-2dc5f0ed3023" 13194139533495 17592186045585 true] [17592186404276 1081 "\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{2}-{x}^{2}}{{y}^{2}+{x}^{2}}" 13194139533495 17592186045585 true] [17592186404276 1083 #edb/ref 17592186045499 13194139533495 17592186045585 true] [175921