}_{0}^{x}(-1+xy+{e}^{x-y})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[-y+\\frac{x{y}^{2}}{2}-{e}^{x-y}]}_{y=0}^{y=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-x+\\frac{{x}^{3}}{2}-1+{e}^{x})\\,\\text{d}x \\\\  & ={[-\\frac{{x}^{2}}{2}+\\frac{{x}^{4}}{8}-x+{e}^{x}]}_{0}^{1} \\\\  & =(-\\frac{1}{2}+\\frac{1}{8}-1+e)-1 \\\\  & =-\\frac{19}{8}+e\\end{aligned}\n$$" 13194139533484 17592186045585 true] [17592186401268 1075 #edb/ref 17592186401269 13194139533484 17592186045585 true] [17592186401268 1075 #edb/ref 17592186401270 13194139533484 17592186045585 true] [17592186401268 1075 #edb/ref 17592186401271 13194139533484 17592186045585 true] [17592186401268 1075 #edb/ref 17592186401272 13194139533484 17592186045585 true] [17592186401268 1075 #edb/ref 17592186401273 13194139533484 17592186045585 true] [17592186401268 1076 #edb/ref 17592186045493 13194139533484 17592186045585 true] [17592186401268 1077 "selection" 13194139533484 17592186045585 true] [17592186401268 1079 #edb/ref 17592186401271 13194139533484 17592186045585 true] [17592186401268 1080 #uuid "67d473e4-fb62-570e-a504-252ea46fe0d2" 13194139533484 17592186045585 true] [17592186401269 1081 "{e}^{2}-\\frac{17}{8}" 13194139533484 17592186045585 true] [17592186401269 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401269 1084 #uuid "9aab621f-8cde-5ff7-83da-d05fc13356ba" 13194139533484 17592186045585 true] [17592186401270 1081 "{e}^{2}+e-\\frac{19}{8}" 13194139533484 17592186045585 true] [17592186401270 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401270 1084 #uuid "1a1077bb-f87e-5cca-9aef-16e4fb33aef6" 13194139533484 17592186045585 true] [17592186401271 1081 "e-\\frac{19}{8}" 13194139533484 17592186045585 true] [17592186401271 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401271 1084 #uuid "2adea1b0-35c6-5e84-940d-c02c34a5479d" 13194139533484 17592186045585 true] [17592186401272 1081 "e-\\frac{15}{8}" 13194139533484 1759218604558