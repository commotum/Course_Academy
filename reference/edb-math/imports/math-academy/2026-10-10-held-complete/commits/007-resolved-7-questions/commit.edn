4 17592186045585 true] [17592186401218 1070 #edb/ref 17592186045485 13194139533484 17592186045585 true] [17592186401218 1071 "$$\n⟨\\text{_______}\\,,\\,-{x}^{2}\\operatorname{cos}⁡\\theta ,\\,-{x}^{2}\\operatorname{sin}⁡\\theta ⟩\n$$\n\nThe fundamental vector product of the surface of revolution generated by rotating the curve $y={x}^{2}$ by $2\\pi $ radians about the $x$-axis for $x\\in [0,1]$ is given above. What is the $1$st component of the product?" 13194139533484 17592186045585 true] [17592186401218 1072 #uuid "fd6b23cf-0f4d-571e-a46d-8551c4a4d4b5" 13194139533484 17592186045585 true] [17592186401218 1074 "Notice that $y={x}^{2}\\ge 0$ for all $x\\in [0,1].$ The parametrization of our surface of revolution is \n\n$$\n\\begin{aligned}r=⟨x,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)={x}^{2},$ and \n\n$$\nD={(x,\\theta )\\,:\\,0\\le x\\le 1,\\,0\\le \\theta <2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,-|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f={x}^{2},$ we obtain ${f}^{′}=2x.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′}=⟨2{x}^{3},\\,-{x}^{2}\\operatorname{cos}⁡\\theta ,\\,-{x}^{2}\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$" 13194139533484 17592186045585 true] [17592186401219 1075 #edb/ref 17592186401220 13194139533484 17592186045585 true] [17592186401219 1075 #edb/ref 17592186401221 13194139533484 17592186045585 true] [17592186401219 1075 #edb/ref 17592186401222 13194139533484 17592186045585 true] [17592186401219 1075 #edb/ref 17592186401223 13194139533484 17592186045585 true] [17592186401219 1075 #edb/ref 17592186401224 13194139533484 17592186045585 true] [17592186401219 1076 #edb/ref 17592186045493 13194139533484 17592186045585 true] [17592186401219 1077 "selection" 13194139533484 17592186045585 true] [17592186401219 1079 #edb/ref 17592186401222 13194139533484 17592186045585 true] [17592186401219 1080 #uuid "09e4fe92-85aa-505b-a8c5-4df7656265ff" 13194139533484 17592186045585 true] [17592186401220 1081 "3{x}^{2}" 13194139533484 17592186045585 true] [17592186401220 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401220 1084 #uuid "0ac04977-1a37-5d3c-9110-290be918a633" 13194139533484 17592186045585 true] [17592186401221 1081 "{x}^{2}-2" 13194139533484 17592186045585 true] [17592186401221 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401221 1084 #uuid "5d7eb081-9f2c-5f53-a5b0-e0278d5a43e9" 13194139533484 17592186045585 true] [17592186401222 1081 "2{x}^{3}" 13194139533484 17592186045585 true] [17592186401222 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401222 1084 #uuid "8b485d3f-8ad7-53a4-b507-d079c7107b80" 13194139533484 17592186045585 true] [17592186401223 1081 "x-1" 13194139533484 17592186045585 true] [17592186401223 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401223 1084 #uuid "0e733731-6884-58f7-9e73-fde236398200" 13194139533484 17592186045585 true] [17592186401224 1081 "{x}^{2}-2x" 13194139533484 17592186045585 true] [17592186401224 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401224 1084 #uuid "a04db056-3485-5f6c-b6b6-d2d4f8e80aee" 13194139533484 17592186045585 true] [17592186401225 1068 #edb/ref 17592186401226 13194139533484 17592186045585 true] [17592186401225 1069 "q-161198" 13194139533484 17592186045585 true] [17592186401225 1070 #edb/ref 17592186045485 13194139533484 17592186045585 true] [17592186401225 1071 "Consider the vector field $F$ and the surface $S$ with unit normal vector $n,$ where\n\n$$\nF(x,y,z)=⟨{z}^{2},\\,x,\\,y-{z}^{2}⟩\\,,\\,n(x,y,z)=\\frac{1}{3}⟨2,\\,-1,\\,2⟩\\,.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S=\\frac{1}{3}{∬}_{S}\\boxed{}\\,\\text{d}S,\n$$\n\nwhat is the missing expression?" 13194139533484 17592186045585 true] [17592186401225 1072 #uuid "dd68aee4-128c-55a1-8849-b847e40933c1" 13194139533484 17592186045585 true] [17592186401225 1074 "If $S$ is an oriented surface with unit normal vector $n,$ and $F$ is continuous vector field, then the flux of $F$ across $S$ measured with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S.\n$$\n\nCalculating the dot product, we have\n\n$$\n\\begin{aligned}F\\cdot n & =⟨{z}^{2},\\,x,\\,y-{z}^{2}⟩\\cdot \\frac{1}{3}⟨2,\\,-1,\\,2⟩ \\\\  & =\\frac{1}{3}⟨{z}^{2},\\,x,\\,y-{z}^{2}⟩\\cdot ⟨2,\\,-1,\\,2⟩ \\\\  & =\\frac{1}{3}(2{z}^{2}-x+2(y-{z}^{2})) \\\\  & =\\frac{2y-x}{3}.\\end{aligned}\n$$\n\nTherefore, the flux can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{S}\\frac{2y-x}{3}\\,\\text{d}S \\\\  & =\\frac{1}{3}{∬}_{S}2y-x\\,\\text{d}S.\\end{aligned}\n$$" 13194139533484 17592186045585 true] [17592186401226 1075 #edb/ref 17592186401227 13194139533484 17592186045585 true] [17592186401226 1075 #edb/ref 17592186401228 13194139533484 17592186045585 true] [17592186401226 1075 #edb/ref 17592186401229 13194139533484 17592186045585 true] [17592186401226 1075 #edb/ref 17592186401230 13194139533484 17592186045585 true] [17592186401226 1075 #edb/ref 17592186401231 13194139533484 17592186045585 true] [17592186401226 1076 #edb/ref 17592186045493 13194139533484 17592186045585 true] [17592186401226 1077 "selection" 13194139533484 17592186045585 true] [17592186401226 1079 #edb/ref 17592186401230 13194139533484 17592186045585 true] [17592186401226 1080 #uuid "a21eed7a-f07f-5d01-b24f-3b6ba15f83ad" 13194139533484 17592186045585 true] [17592186401227 1081 "2y-x-2{z}^{2}" 13194139533484 17592186045585 true] [17592186401227 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401227 1084 #uuid "419c0982-db99-5289-b52f-a761ea3d1bae" 13194139533484 17592186045585 true] [17592186401228 1081 "2y+{z}^{2}" 13194139533484 17592186045585 true] [17592186401228 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401228 1084 #uuid "d412c461-4939-5aa5-9ddd-df78a8e85bc2" 13194139533484 17592186045585 true] [17592186401229 1081 "x+y+{z}^{2}" 13194139533484 17592186045585 true] [17592186401229 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401229 1084 #uuid "a93a034f-199c-5c52-af3b-9d0a37596a31" 13194139533484 17592186045585 true] [17592186401230 1081 "2y-x" 13194139533484 17592186045585 true] [17592186401230 1083 #edb/ref 17592186045499 13194139533484 17592186045585 true] [17592186401230 1084 #uuid "dfbb580a-2ddc-5e43-a8f4-c46a6440cff0" 13194139533484 17592186045585 true] [17592186401231 108