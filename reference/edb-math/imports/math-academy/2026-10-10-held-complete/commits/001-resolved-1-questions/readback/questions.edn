#{[{:db/id #edb/ref 17592186399356 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00" :knowledge-point/title "Identifying Divergent Improper Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c286d992-e374-59ca-b86a-46b1f01569c8" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186399358} {:answer/id #uuid "aa7fc32d-93c3-5f24-9422-4d81ca03151b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186399359} {:answer/id #uuid "fdb062ee-82cd-5edc-b0e4-91caa68a5294" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399360} {:answer/id #uuid "3ee651ae-0ee5-5625-ab56-eb885ff22e22" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399361} {:answer/id #uuid "eeefac1c-9901-5975-9c13-7fedfd50614c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186399362}] :answer-field/correct {:answer/id #uuid "eeefac1c-9901-5975-9c13-7fedfd50614c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186399362} :answer-field/id #uuid "027a26b9-e238-53ff-b245-735c0d2abc04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79e7ca1d-1ed8-5888-8523-0ec8ed90db1c" :question/math-academy-id "q-101736" :question/problem "Which of the following improper integrals are divergent?\n\nI. ${\\int }_{2}^{\\infty }\\frac{1}{(u-1)^{3}}\\,\\text{d}u$\nII. ${\\int }_{-\\infty }^{1}3{z}^{2}\\,\\text{d}z$\nIII. ${\\int }_{-\\infty }^{-2}\\frac{1}{{x}^{2}}\\,\\text{d}x$" :question/worked-solution "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{(u-1)^{3}}\\,\\text{d}u & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{(u-1)^{3}}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{2(u-1)^{2}}]}_{2}^{a} \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{2(a-1)^{2}}+\\frac{1}{2(2-1)^{2}}) \\\\  & ={lim}_{a\\to \\infty }(\\frac{1}{2}-\\frac{1}{2(a-1)^{2}}) \\\\  & =\\frac{1}{2},\\end{aligned}\n$$\n\nso the integral is convergent.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}3{z}^{2}\\,\\text{d}z & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}3{z}^{2}\\,\\text{d}z \\\\  & ={lim}_{a\\to -\\infty }{[{z}^{3}]}_{a}^{1} \\\\  & ={lim}_{a\\to -\\infty }(1-{a}^{3}) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{1}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-2}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[-\\frac{1}{x}]}_{a}^{-2} \\\\  & ={lim}_{a\\to -\\infty }(\\frac{1}{2}+\\frac{1}{a}) \\\\  & =\\frac{1}{2},\\end{aligned}\n$$\n\nso the integral is convergent.\n\nIn conclusion, only integral II is divergent."}] [{:db/id #edb/ref 17592186399363 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d059c56-ae7f-5fb6-8bc6-2ce97bb7f876" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Even Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adc85dfc-82e2-5c66-b389-b41fb19ad864" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186399365} {:answer/id #uuid "87681650-9284-54e8-be92-9a5cd93affcb" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186399366} {:answer/id #uuid "4985ec58-2715-5a72-bb02-e635fceaf350" :answer/type {:db/ident :answer.type/math} :answer/value "x=-3" :db/id #edb/ref 17592186399367} {:answer/id #uuid "0d09f94b-1dad-5156-8246-f259631b39c3" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186399368} {:answer/id #uuid "11fb9990-7479-5943-99db-72bf7ba516e8" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186399369}] :answer-field/correct {:answer/id #uuid "adc85dfc-82e2-5c66-b389-b41fb19ad864" :answer/type {:db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186399365} :answer-field/id #uuid "f2f61551-3d94-5e79-8565-51a2b48bb8e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399364}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "21e6eb75-d6ca-5925-b747-58f532d52df9" :question/math-academy-id "q-102548" :question/problem "Find the root of $f(x)=-3\\sqrt[6]{2x-5}-3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n-3\\sqrt[6]{2x-5}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}-3\\sqrt[6]{2x-5}-3 & =0 \\\\ -3\\sqrt[6]{2x-5} & =3 \\\\ \\sqrt[6]{2x-5} & =-1\\end{aligned}\n$$\n\nThis equation does not have any solutions since its left-hand side is always nonnegative, while the right-hand side is negative.\n\nTherefore, $f(x)$ has no root."}] [{:db/id #edb/ref 17592186399370 :knowledge-point/_questions [{:knowledge-point/id #uuid "228b0a63-bf0e-57bf-aa1e-ef5518236462" :knowledge-point/title "Identifying Mathematical Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d281e4c-12f3-5079-93f5-be66bce4c00b" :answer/type {:db/ident :answer.type/text} :answer/value "Compute the sum of the first two natural numbers." :db/id #edb/ref 17592186399372} {:answer/id #uuid "4fc90903-d3c5-5540-9c56-a82ad70a2ac1" :answer/type {:db/ident :answer.type/text} :answer/value "The set of rational numbers." :db/id #edb/ref 17592186399373} {:answer/id #uuid "e4002685-8407-5008-9596-c51979ab7920" :answer/type {:db/ident :answer.type/text} :answer/value "The diagonal of a quadrilateral." :db/id #edb/ref 17592186399374} {:answer/id #uuid "cbdda3a7-d2ed-58bf-a55c-bd1037a65ec2" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ is a rational number." :db/id #edb/ref 17592186399375} {:answer/id #uuid "4a90792e-413a-5402-b9c4-94db6437b94a" :answer/type {:db/ident :answer.type/text} :answer/value "What is a prime number?" :db/id #edb/ref 17592186399376}] :answer-field/correct {:answer/id #uuid "cbdda3a7-d2ed-58bf-a55c-bd1037a65ec2" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ is a rational number." :db/id #edb/ref 17592186399375} :answer-field/id #uuid "87c7d492-3fd1-55b7-9667-7d1d03627d97" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399371}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b625ee5e-9a08-5485-b20f-479dacadfb89" :question/math-academy-id "q-102843" :question/problem "Which of the following is a mathematical statement?" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nOf the given sentences, the only sentence that is either true or false is \"$1$ is a rational number.\" (This sentence is true.)\n\nAll the other sentences are neither true nor false."}] [{:db/id #edb/ref 17592186399377 :knowledge-point/_questions [{:knowledge-point/id #uuid "228b0a63-bf0e-57bf-aa1e-ef5518236462" :knowledge-point/title "Identifying Mathematical Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a784fbf-5f25-5f31-843d-4a1a9bed8d7d" :answer/type {:db/ident :answer.type/text} :answer/value "$7$ is an irrational number." :db/id #edb/ref 17592186399379} {:answer/id #uuid "8769f8ce-2100-5aca-8698-f82c9b4a44df" :answer/type {:db/ident :answer.type/text} :answer/value "The square of $\\pi .$" :db/id #edb/ref 17592186399380} {:answer/id #uuid "d5eac8b2-d6c1-5b6f-ada4-a50844ad0a29" :answer/type {:db/ident :answer.type/text} :answer/value "Subtract $1$ from $1.$" :db/id #edb/ref 17592186399381} {:answer/id #uuid "91c592d6-03b1-5649-a123-0a33bf3cde4c" :answer/type {:db/ident :answer.type/text} :answer/value "The set of odd numbers less than $10.$" :db/id #edb/ref 17592186399382} {:answer/id #uuid "ea124ef4-f130-5275-8fe3-1850d9bc3756" :answer/type {:db/ident :answer.type/text} :answer/value "The set of all divisors of $6.$" :db/id #edb/ref 17592186399383}] :answer-field/correct {:answer/id #uuid "3a784fbf-5f25-5f31-843d-4a1a9bed8d7d" :answer/type {:db/ident :answer.type/text} :answer/value "$7$ is an irrational number." :db/id #edb/ref 17592186399379} :answer-field/id #uuid "fa76a497-6918-56f0-8610-0ecc043a8984" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e5f15d4-32b4-5cff-adbb-2083e71d617a" :question/math-academy-id "q-102851" :question/problem "Which of the following is a mathematical statement?" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nOf the given sentences, the only sentence that is either true or false is \"$7$ is an irrational number.\" (This sentence is false.)\n\nAll the other sentences are neither true nor false."}] [{:db/id #edb/ref 17592186176185 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f3fa70e-d9fd-5020-8d01-97279a5b60aa" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186399385} {:answer/id #uuid "7a3c2998-ab10-5957-b910-2752efbf8d70" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186399386} {:answer/id #uuid "1f216635-c914-52de-88e1-6952ef94cf93" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186399387} {:answer/id #uuid "a17d10f0-af39-51d6-9fd8-af2bb4027703" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186399388} {:answer/id #uuid "5d620a9b-4de0-507f-b244-65b871a59f2f" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186399389}] :answer-field/correct {:answer/id #uuid "5d620a9b-4de0-507f-b244-65b871a59f2f" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186399389} :answer-field/id #uuid "18b0e616-81e7-50de-bff1-696cf07845e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399384}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5012f64-5f75-5c60-9687-8fa0fb8ccd67" :question/math-academy-id "q-102908" :question/problem "What surface is defined by the equation $r=3$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\nr=3\n$$\n\nThis equation requires that the distance from any point on the surface to the $z$-axis equals $3,$ while $\\theta $ and $z$ can vary arbitrarily in their respective domains. \n\nTherefore, our surface is the circular cylinder shown below.\n\n![](images/aa/aa435c0ad4b4482c85a05af32afbbb7819b330a4292762ec66bad30a6ed31a44.png)"}] [{:db/id #edb/ref 17592186399390 :knowledge-point/_questions [{:knowledge-point/id #uuid "bfc0d9e1-bce1-5d62-b3c8-f7d7bb226497" :knowledge-point/title "Finding the Radius and Interval of Convergence of a Power Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae1e039d-033d-5fb2-afe2-058a41532346" :answer/type {:db/ident :answer.type/text} :answer/value "$R=5$ and $I=[-1,1]$" :db/id #edb/ref 17592186399392} {:answer/id #uuid "b5518e7e-ad19-5fdf-b048-f6f07aa85005" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and $I=(-6,-4)$" :db/id #edb/ref 17592186399393} {:answer/id #uuid "a777899f-4fb2-599e-8bac-fd1080f27455" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and $I=[-6,-4]$" :db/id #edb/ref 17592186399394} {:answer/id #uuid "730ca820-682a-52b2-87ed-4d379934e772" :answer/type {:db/ident :answer.type/text} :answer/value "$R=5$ and $I=(-1,1)$" :db/id #edb/ref 17592186399395} {:answer/id #uuid "89a3a902-db89-527e-ac98-aebc7e8b5c3b" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and $I=[-6,-4)$" :db/id #edb/ref 17592186399396}] :answer-field/correct {:answer/id #uuid "a777899f-4fb2-599e-8bac-fd1080f27455" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and $I=[-6,-4]$" :db/id #edb/ref 17592186399394} :answer-field/id #uuid "f3aed52a-be07-5913-ae72-4601a0fc9425" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c3c2591-89b8-5e94-a7b0-e02f5b424693" :question/math-academy-id "q-103125" :question/problem "Find the radius of convergence $R$ and interval of convergence $I$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x+5)^{n}}{n(n+1)}\\,.\n$$" :question/worked-solution "To apply the ratio test, we define ${a}_{n}=\\frac{(x+5)^{n}}{n(n+1)}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x+5)^{n+1}}{(n+1)(n+2)}\\cdot \\frac{n(n+1)}{(x+5)^{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{n(x+5)}{n+2}| \\\\  & =|x+5|{lim}_{n\\to \\infty }\\frac{n}{n+2} \\\\  & =|x+5|{lim}_{n\\to \\infty }(\\frac{1}{(1+\\frac{2}{n})}) \\\\  & =|x+5|\\cdot 1 \\\\  & =|x+5|\\end{aligned}\n$$\n\nThe series converges if $L<1.$ Therefore,\n\n$$\n\\begin{aligned}|x+5| & <1 \\\\ -1<x+5 & <1 \\\\ -6<x & <-4.\\end{aligned}\n$$\n\nSo, the radius of convergence is $R=1,$ and the series converges for any $x$ that lies in the open interval $(-6,-4).$\n\nThe ratio test gives no conclusion about the convergence of the series when $L=1.$ So, when $|x+5|=1,$ we do not know if the series converges. This means that the endpoints $x=-6$ and $x=-4$ need to be investigated separately using another test for convergence.\n\n- When $x=-6$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x+5)^{n}}{n(n+1)} & ={\\sum }_{n=1}^{\\infty }\\frac{(-6+5)^{n}}{n(n+1)} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{2}+n}\\end{aligned}\n$$\n\nwhich is convergent by the alternating series test.\n\n- When $x=-4$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x+5)^{n}}{n(n+1)} & ={\\sum }_{n=1}^{\\infty }\\frac{(-4+5)^{n}}{n(n+1)} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{{1}^{n}}{{n}^{2}+n} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2}+n}\\end{aligned}\n$$\n\nComparing the above series with  ${\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{2}},$\nwe see that the series is convergent by the comparison test.\n\nSo the interval of convergence is $I=[-6,-4].$"}] [{:db/id #edb/ref 17592186399397 :knowledge-point/_questions [{:knowledge-point/id #uuid "3497c02b-4c62-58d9-8c73-ee1a1142c429" :knowledge-point/title "Calculating the Rate of Change of a Leg Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1a38a30-8bac-5468-8fc8-e062c24e84e9" :answer/type {:db/ident :answer.type/math} :answer/value "20\\,\\text{km/h}" :db/id #edb/ref 17592186399399} {:answer/id #uuid "2ee69ac9-d35a-5e97-8f90-c9134043ab2e" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{km/h}" :db/id #edb/ref 17592186399400} {:answer/id #uuid "e1875e6f-6a69-5440-9e5d-70da4eede3b6" :answer/type {:db/ident :answer.type/math} :answer/value "22\\,\\text{km/h}" :db/id #edb/ref 17592186399401} {:answer/id #uuid "9b355bd5-cbe7-5ac4-861e-9679d2919c24" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,\\text{km/h}" :db/id #edb/ref 17592186399402} {:answer/id #uuid "9ac6560e-0780-5b4e-8401-cff5e6d38baa" :answer/type {:db/ident :answer.type/math} :answer/value "21\\,\\text{km/h}" :db/id #edb/ref 17592186399403}] :answer-field/correct {:answer/id #uuid "d1a38a30-8bac-5468-8fc8-e062c24e84e9" :answer/type {:db/ident :answer.type/math} :answer/value "20\\,\\text{km/h}" :db/id #edb/ref 17592186399399} :answer-field/id #uuid "9d3c6cce-0af7-56ae-b62a-c1633c9bc4d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "861245ce-e152-550e-a0d5-a98fa38203e9" :question/math-academy-id "q-103781" :question/problem "A hot air balloon that is launched vertically is observed by a child located on the ground $4\\,\\text{km}$ from the launch site. What is the vertical speed of the balloon at the instant when its distance from the child is $5\\,\\text{km}$ and this distance is increasing at a rate of $12\\,\\text{km/h}?$" :question/worked-solution "We start by drawing a diagram of the problem.\n\n![](images/40/40957ce27304474263d1d231a3a0df93193ac0461d8a7444cde3b12047d1a214.png)\n\nIn the diagram,\n\n- $x$ is the distance between the child and the launch site,\n\n- $y$ is the distance between the launch site and the balloon,\n\n- $z$ is the distance between the child and the balloon.\n\nAs shown in the diagram, $x,$ $y,$ and $z$ form a right triangle with $z$ as the hypotenuse. We wish to find the rate of change of $y,$ which is $\\frac{\\text{d}y}{\\text{d}t}.$ \n\nWe know that $z=5\\,\\text{km}$ and $x=4\\,\\text{km}.$ We can find $y$ using the Pythagorean Theorem, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={z}^{2} \\\\ {4}^{2}+{y}^{2} & ={5}^{2} \\\\ {y}^{2} & =9 \\\\ y & =3\\,\\text{km}\\end{aligned}\n$$\n\nWe also know that:\n\n- $\\frac{\\text{d}z}{\\text{d}t}=12\\,\\text{km}/\\text{h},$\n\n- the distance between the child and the launch site ($x$) remains the same, so $\\frac{\\text{d}x}{\\text{d}t}=0.$\n\nFinally, we differentiate both sides of ${x}^{2}+{y}^{2}={z}^{2}$ with respect to $t$ and then substitute in the known values, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}({z}^{2}) \\\\ 2x\\frac{\\text{d}x}{\\text{d}t}+2y\\frac{\\text{d}y}{\\text{d}t} & =2z\\frac{\\text{d}z}{\\text{d}t} \\\\ 2(4)(0)+2(3)\\frac{\\text{d}y}{\\text{d}t} & =2(5)(12) \\\\ 6\\frac{\\text{d}y}{\\text{d}t} & =120 \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{120}{6} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =20\\end{aligned}\n$$\n\nTherefore, the vertical speed of the hot air balloon is $20\\,\\text{km}/\\text{h}.$"}] [{:db/id #edb/ref 17592186399404 :knowledge-point/_questions [{:knowledge-point/id #uuid "92d6129b-a5c5-597a-86ee-3f19af20f326" :knowledge-point/title "Describing the General Properties of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb60cb3-357c-5e48-b8d1-0086b493c7eb" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186399406} {:answer/id #uuid "19ccc92a-6243-5f86-923a-b5c24bd00fd5" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186399407} {:answer/id #uuid "ce053c47-98cc-5de1-940a-50290e3cb268" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186399408} {:answer/id #uuid "db658c44-2180-5d2a-b3df-00809159cb77" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399409} {:answer/id #uuid "fc8ab29b-c5b0-5fbd-9665-137b0c595045" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399410}] :answer-field/correct {:answer/id #uuid "1fb60cb3-357c-5e48-b8d1-0086b493c7eb" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186399406} :answer-field/id #uuid "df865d93-f1c0-5ed8-a22e-b99b64edd838" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399405}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4383ecaa-1c57-5705-8853-cba2341fc9fa" :question/math-academy-id "q-103812" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nI. The range of the function is $(-\\infty ,-1].$\nII. $y=-1$ is the maximum value of the function.\nIII. $x=15\\pi $ is in the domain." :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ therefore the function doesn't have a maximum value. Hence, statements I and II are both false.\n\n- The function's domain is all real numbers except the integer multiples of $\\pi $, such as $0,\\pm \\pi ,\\pm 2\\pi ,….$ Hence, statement III is false."}] [{:db/id #edb/ref 17592186399411 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6874921-2d2f-5f05-b3f8-8b581a1d8844" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{sin}^{2}⁡(3\\theta )+{cos}^{2}⁡(3\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186399413} {:answer/id #uuid "ed64815a-d2d8-553b-a6f7-b8434bf21b56" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{cos}^{2}⁡(3\\theta )-{sin}^{2}⁡(3\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186399414} {:answer/id #uuid "98fb496d-54bd-55f2-a700-7d72677cb636" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{sin}^{2}⁡(3\\theta )+9{cos}^{2}⁡(3\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186399415} {:answer/id #uuid "bdb7b1c9-29a2-5223-81e5-94639a44cc1d" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{cos}^{2}⁡(3\\theta )+9{sin}^{2}⁡(3\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186399416} {:answer/id #uuid "83e1d477-bc0c-53ce-bc7e-6ddda95d6630" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{cos}^{2}⁡(3\\theta )-3{sin}^{2}⁡(3\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186399417}] :answer-field/correct {:answer/id #uuid "bdb7b1c9-29a2-5223-81e5-94639a44cc1d" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{cos}^{2}⁡(3\\theta )+9{sin}^{2}⁡(3\\theta )}\\,\\text{d}\\theta " :db/id #edb/ref 17592186399416} :answer-field/id #uuid "f5c70003-7fda-53ca-a766-8fe5b6a753c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399412}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fff3852c-f58f-5d0e-926d-65e98b09f1bd" :question/math-academy-id "q-103831" :question/problem "![](images/b1/b1a0f5b8438b5abeafafccadd5a3a33572441c4d58d2e97f7254bd28987c223c.png)\n\nWhich of the following gives the arc length of the polar curve $r=4\\operatorname{cos}⁡(3\\theta )$ for $\\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}$ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=4\\operatorname{cos}⁡(3\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-12\\operatorname{sin}⁡(3\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{(4\\operatorname{cos}⁡(3\\theta ))^{2}+(-12\\operatorname{sin}⁡(3\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{16{cos}^{2}⁡(3\\theta )+144{sin}^{2}⁡(3\\theta )}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{16({cos}^{2}⁡(3\\theta )+9{sin}^{2}⁡(3\\theta ))}\\,\\text{d}\\theta  \\\\  & =4{\\int }_{\\pi /2}^{5\\pi /6}\\sqrt{{cos}^{2}⁡(3\\theta )+9{sin}^{2}⁡(3\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399418 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b34439c-2388-5711-9ac8-63f5bf3cf549" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-7,0)$, radius: $49$" :db/id #edb/ref 17592186399420} {:answer/id #uuid "1eb48f02-d998-5b04-842c-b869161eadb6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186399421} {:answer/id #uuid "317341c2-5258-5001-88cf-9b017288ada7" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{4}$" :db/id #edb/ref 17592186399422} {:answer/id #uuid "f3bcc4ce-6ce1-5ebf-8946-9df961f73342" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186399423} {:answer/id #uuid "1ed03bf8-4e63-5262-8883-5b8d87a82e28" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(7,0)$, radius: $7$" :db/id #edb/ref 17592186399424}] :answer-field/correct {:answer/id #uuid "1eb48f02-d998-5b04-842c-b869161eadb6" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-\\frac{7}{2},0)$, radius: $\\frac{7}{2}$" :db/id #edb/ref 17592186399421} :answer-field/id #uuid "4c479e6f-23bb-5fd5-ab28-ff2cfcd0fb64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399419}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f6a0f67-fd62-5333-8099-37761d6fc395" :question/math-academy-id "q-103892" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+7x=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+7x & =0 \\\\ ({x}^{2}+7x)+{y}^{2} & =0 \\\\ ({x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2})+{y}^{2} & ={(\\frac{7}{2})}^{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x+\\frac{7}{2})}^{2}+{y}^{2} & ={(\\frac{7}{2})}^{2} \\\\ {(x-(-\\frac{7}{2}))}^{2}+(y-0)^{2} & ={(\\frac{7}{2})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{7}{2},0)$ and its radius is $\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186399425 :knowledge-point/_questions [{:knowledge-point/id #uuid "361ff4ea-4bf0-5084-ae3e-e6b810cba5cd" :knowledge-point/title "Optimizing the Area of a Rectangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15350554-e886-5e11-8207-77bbb3e0bec9" :answer/type {:db/ident :answer.type/math} :answer/value "12.93\\,{m}^{2}" :db/id #edb/ref 17592186399427} {:answer/id #uuid "fb654c8f-375d-5fa0-b333-4fd2c3d1805a" :answer/type {:db/ident :answer.type/math} :answer/value "13.72\\,{m}^{2}" :db/id #edb/ref 17592186399428} {:answer/id #uuid "2b6c956a-c96c-5420-a899-8859c8a907f0" :answer/type {:db/ident :answer.type/math} :answer/value "17.35\\,{m}^{2}" :db/id #edb/ref 17592186399429} {:answer/id #uuid "3a202375-39cd-502a-81cb-6cca990bb170" :answer/type {:db/ident :answer.type/math} :answer/value "14.06\\,{m}^{2}" :db/id #edb/ref 17592186399430} {:answer/id #uuid "d3bc53a0-6be4-5825-a047-05acf7782f6a" :answer/type {:db/ident :answer.type/math} :answer/value "16.08\\,{m}^{2}" :db/id #edb/ref 17592186399431}] :answer-field/correct {:answer/id #uuid "3a202375-39cd-502a-81cb-6cca990bb170" :answer/type {:db/ident :answer.type/math} :answer/value "14.06\\,{m}^{2}" :db/id #edb/ref 17592186399430} :answer-field/id #uuid "c9367409-a53f-579f-8cdb-a83c5faaa2a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399426}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1af9295c-5eff-510e-ba44-71a6e28cc19c" :question/math-academy-id "q-104195" :question/problem "A gardener wants to fence a rectangular flowerbed with $15$ meters of fencing. To two decimal places, what is the largest area that he can make with the fencing?" :question/worked-solution "**Step 1**: Let us call $x$ and $y$ the dimensions of the rectangle.\n\n![](images/be/bebb7c4ca5e38d75136146f6e4547b0e72d529ce24453a3d0212bca1ffbfe4c0.png)\n\n**Step 2**: We need to find the values of $x$ and $y$ such as the area\n\n$$\nA=xy\n$$\n\nis the greatest possible value.\n\n**Step 3**: This is subject to the constraint that the perimeter is $15.$ This gives the equation\n\n$$\n2x+2y=15.\n$$\n\n**Step 4**: We make one of the variables the subject in the constraint equation:\n\n$$\n\\begin{aligned}2x+2y & =15 \\\\ y & =\\frac{15}{2}-x\\end{aligned}\n$$\n\nThen, we substitute $y=\\frac{15}{2}-x$ in the expression $A=xy$ and get\n\n$$\n\\begin{aligned}A & =x(\\frac{15}{2}-x) \\\\ A & =\\frac{15}{2}x-{x}^{2}.\\end{aligned}\n$$\n\n**Step 5**: We solve the equation ${A}^{′}(x)=0.$ Taking the derivative, we have\n\n$$\n{A}^{′}(x)=\\frac{15}{2}-2x,\n$$\n\nand solving for the stationary points, we get\n\n$$\n\\begin{aligned}{A}^{′}(x) & =0 \\\\ \\frac{15}{2}-2x & =0 \\\\ 2x & =\\frac{15}{2} \\\\ x & =\\frac{15}{4}.\\end{aligned}\n$$\n\n**Step 6**: We confirm that $x=\\frac{15}{4}$ is a maximum using the second derivative test. The second derivative is\n\n$$\n{A}^{″}(x)=-2\\,⟹\\,{A}^{″}(\\frac{15}{4})=-2<0.\n$$\n\nSince ${A}^{″}(\\frac{15}{4})$ is negative, we conclude that $x=\\frac{15}{4}$ is indeed a maximum of $A(x).$\n\nFinally, when $x=\\frac{15}{4}$, we have \n\n$$\ny=\\frac{15}{2}-\\frac{15}{4}=\\frac{15}{4}.\n$$\n\nTherefore, the dimensions of the rectangle with the largest area are $x=\\frac{15}{4}$ and $y=\\frac{15}{4},$ and we conclude that\n\n$$\nA=xy=\\frac{15}{4}\\cdot \\frac{15}{4}≈14.06\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186399432 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25597751-6416-5ceb-91cb-601deaf1fd9b" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186399434} {:answer/id #uuid "eaf0226c-3780-550c-9206-c7ed7218262a" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186399435} {:answer/id #uuid "3b0aa564-3f7e-5327-a8c8-1edf032ad3dd" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186399436} {:answer/id #uuid "ec9e7d27-4886-5176-9858-61f489c8b0db" :answer/type {:db/ident :answer.type/text} :answer/value "A half-cone" :db/id #edb/ref 17592186399437} {:answer/id #uuid "fd280fe8-8330-515c-b61b-f9b9b8476f89" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186399438}] :answer-field/correct {:answer/id #uuid "3b0aa564-3f7e-5327-a8c8-1edf032ad3dd" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186399436} :answer-field/id #uuid "f35e2e43-0eed-5ef2-9529-98c9c99a49c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb65e6d9-45e5-53d5-8bab-c34cad517cf2" :question/math-academy-id "q-104223" :question/problem "What surface is defined by the equation $z=3$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\nz=3\n$$\n\nThis equation requires that $z$-coordinate of any point on our surface equals $3,$ while $r$ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, our surface is the plane that is parallel to the $xy$-plane shown below.\n\n![](images/ab/ab98ba68465b36fcc3c7ac2de4f50a8f3f16f5e7e10f2c08625cbd933c59f3c4.png)"}] [{:db/id #edb/ref 17592186399439 :knowledge-point/_questions [{:knowledge-point/id #uuid "2f4472e5-68af-5e8c-83cb-ceab2a6dfe1e" :knowledge-point/title "Identifying Cones and Half-Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dad703c3-2424-5fc7-a7e2-7cdbd0fd3e2e" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186399441} {:answer/id #uuid "c30f7111-a28b-57da-8d7e-ebcc59c3fd70" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186399442} {:answer/id #uuid "02bb600e-803e-556b-aa29-aeb145a011b0" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186399443} {:answer/id #uuid "97be7a2c-b317-5f2f-802a-fdce30804bb7" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186399444} {:answer/id #uuid "11005b22-0b1f-5136-95e7-619b8932e0bf" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186399445}] :answer-field/correct {:answer/id #uuid "dad703c3-2424-5fc7-a7e2-7cdbd0fd3e2e" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186399441} :answer-field/id #uuid "a3e58f04-a3aa-5025-b3f4-1d84092aa5ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f99fad58-2ad5-52cb-8779-f22e2997958e" :question/math-academy-id "q-104236" :question/problem "What surface is defined by the equation ${z}^{2}=4{r}^{2}$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\n{z}^{2}=4{r}^{2}\n$$\n\nThis equation requires that the square of the distance from any point on the surface to the $xy$-plane equals $4$ times the square of the distance from that point to the $z$-axis. In other words, the tangent of the angle between any position vector on the surface and the $z$-axis must be equal to\n\n$$\n\\frac{r}{z}=\\sqrt{\\frac{{r}^{2}}{{z}^{2}}}=\\pm \\sqrt{\\frac{{r}^{2}}{4{r}^{2}}}=\\pm \\frac{1}{2}.\n$$\n\nSince the tangent of this angle can be a positive or negative number, the $z$-coordinate can also be positive or negative.\n\nOn the other hand, $\\theta $ can vary arbitrarily in its domain. \n\nTherefore, our surface is the cone shown below.\n\n![](images/7c/7c8d0cefa5eb8da76f6cba59570670e4078c278c801aeb12344dce3183733149.png)"}] [{:db/id #edb/ref 17592186399446 :knowledge-point/_questions [{:knowledge-point/id #uuid "485fd759-96b3-553f-9eaa-849878c30885" :knowledge-point/title "Identifying a Jump Discontinuity Given a Function Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70879cb5-6de6-5c72-8bca-efcd9e00d5ad" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ and $g(x)$ only" :db/id #edb/ref 17592186399448} {:answer/id #uuid "64fa8265-bf29-50e5-a85f-52766a310a0e" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ only" :db/id #edb/ref 17592186399449} {:answer/id #uuid "74a6e98c-2555-5075-8ac8-02954d0ca6be" :answer/type {:db/ident :answer.type/text} :answer/value "$g(x)$ and $h(x)$ only" :db/id #edb/ref 17592186399450} {:answer/id #uuid "acd84fc2-8564-5e54-9ef8-6e0e0bcd95c0" :answer/type {:db/ident :answer.type/text} :answer/value "$g(x)$ only" :db/id #edb/ref 17592186399451} {:answer/id #uuid "82a92379-88b6-5257-8966-edf92b316844" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ and $h(x)$ only" :db/id #edb/ref 17592186399452}] :answer-field/correct {:answer/id #uuid "70879cb5-6de6-5c72-8bca-efcd9e00d5ad" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ and $g(x)$ only" :db/id #edb/ref 17592186399448} :answer-field/id #uuid "4fb0ec18-8ed9-5ea3-80aa-7d898a1ea97e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399447}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b7deaa4c-aeeb-5438-8da3-4314b016404f" :question/math-academy-id "q-104693" :question/problem "Given the functions $f(x),g(x)$ and $h(x)$ below, which of them has a jump discontinuity at $x=4?$\n\n$$\n\\begin{aligned}f(x) & ={\\begin{aligned}5, & x<4 \\\\ {x}^{2}-10, & x\\ge 4\\end{aligned} \\\\ g(x) & ={\\begin{aligned}5-2x, & x\\le 4 \\\\ x+3, & x>4\\end{aligned} \\\\ h(x) & ={\\begin{aligned}5x, & x\\ne 4 \\\\ 5, & x=4\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "For $y=f(x),$ let's go through our continuity checklist:\n\n- $f(4)={4}^{2}-10=6$ exists $\\,\\,✓$\n\n- Let's now check the left and right limits. We see that\n\n$$\n{lim}_{x\\to {4}^{-}}f(x)={lim}_{x\\to {4}^{-}}5=5\n$$\n\nwhile\n\n$$\n{lim}_{x\\to {4}^{+}}f(x)={lim}_{x\\to {4}^{+}}({x}^{2}-10)={4}^{2}-10=6.\n$$\n\nSo both the left and right limits exist and are finite, but they are not equal. $\\,\\,\\times $\n\nTherefore, $f(x)$ has a jump discontinuity at $x=4.$\n\nNow, for $y=g(x),$ let's go through our continuity checklist:\n\n- $g(4)=5-2(4)=-3$ exists  $\\,\\,✓$ $\\,\\,\\,$\n\n- Let's now check the left and right limits. We see that\n\n$$\n{lim}_{x\\to {4}^{-}}g(x)={lim}_{x\\to {4}^{-}}(5-2x)=5-2(4)=-3\n$$\n\nwhile\n\n$$\n{lim}_{x\\to {4}^{+}}g(x)={lim}_{x\\to {4}^{+}}(x+3)=4+3=7.\n$$\n\nSo both the left and right limits exist and are finite, but they are not equal. $\\,\\,\\times $\n\nTherefore, $g(x)$ has a jump discontinuity at $x=4.$\n\nFinally, for $y=h(x),$ let's go through our continuity checklist:\n\n- $h(4)=5$ exists $\\,\\,✓$\n\n- Let's now check the left and right limits. We see that\n\n$$\n{lim}_{x\\to {4}^{-}}h(x)={lim}_{x\\to {4}^{-}}5x=5(4)=20\n$$\n\nwhile\n\n$$\n{lim}_{x\\to {4}^{+}}h(x)={lim}_{x\\to {4}^{+}}5x=5(4)=20.\n$$\n\nTherefore, the overall limit exists and ${lim}_{x\\to 4}h(x)=20.$\n\n- Finally, we check that the value of the limit equals the value of the function:\n\n$$\n{lim}_{x\\to 4}h(x)=20\\ne h(4)\\,\\,\\times \n$$\n\nSo the value of the limit does not equal the value of the function.\n\nTherefore, $h(x)$ has a removable discontinuity at $x=4.$"}] [{:db/id #edb/ref 17592186399453 :knowledge-point/_questions [{:knowledge-point/id #uuid "485fd759-96b3-553f-9eaa-849878c30885" :knowledge-point/title "Identifying a Jump Discontinuity Given a Function Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1593076-afed-532f-8b5e-2e4afd02e692" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ and $g(x)$ only" :db/id #edb/ref 17592186399455} {:answer/id #uuid "e2de21a0-aed4-576b-b358-dac7e65d8b27" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ only" :db/id #edb/ref 17592186399456} {:answer/id #uuid "5049ae34-a5e0-5729-805c-ac38fc185f31" :answer/type {:db/ident :answer.type/text} :answer/value "$g(x)$ and $h(x)$ only" :db/id #edb/ref 17592186399457} {:answer/id #uuid "3d7c0866-e84d-5794-bfbb-3f8a3e776248" :answer/type {:db/ident :answer.type/text} :answer/value "$g(x)$ only" :db/id #edb/ref 17592186399458} {:answer/id #uuid "b66503c4-812b-5e60-9fc3-6bb35a779f97" :answer/type {:db/ident :answer.type/text} :answer/value "$h(x)$ only" :db/id #edb/ref 17592186399459}] :answer-field/correct {:answer/id #uuid "e2de21a0-aed4-576b-b358-dac7e65d8b27" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x)$ only" :db/id #edb/ref 17592186399456} :answer-field/id #uuid "13f403fd-c2cf-5ac8-a693-4329792d5baa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399454}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "24bfaf28-dbb7-577c-ab56-7ff13a09d906" :question/math-academy-id "q-104701" :question/problem "Given the functions $f(x),g(x)$ and $h(x)$ below, which of them has a jump discontinuity at $x=7?$\n\n$$\n\\begin{aligned}f(x) & ={\\begin{aligned}2x-1, & x\\le 7 \\\\ {x}^{2}-30, & x>7,\\end{aligned} \\\\ g(x) & ={\\begin{aligned}{x}^{2}, & x<7 \\\\ 5x+14, & x\\ge 7,\\end{aligned} \\\\ h(x) & ={\\begin{aligned}\\frac{1}{x-7}, & x<7 \\\\ \\frac{1}{7}, & x\\ge 7,\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "For $f(x),$ let's go through our continuity checklist:\n\n- $f(7)=2(7)-1=13$ exists $\\,\\,✓$\n\n- Let's now check the left and right limits. We see that\n\n$$\n{lim}_{x\\to \\,{7}^{-}}f(x)={lim}_{x\\to \\,{7}^{-}}(2x-1)=2(7)-1=13\n$$\n\nwhile\n\n$$\n{lim}_{x\\to \\,{7}^{+}}f(x)={lim}_{x\\to \\,{7}^{+}}({x}^{2}-30)={7}^{2}-30=19.\n$$\n\nSo both the left and right limits exist and are finite, but they are not equal.$\\,\\,\\times $\n\nTherefore, $f(x)$ has a jump discontinuity at $x=7.$\n\nNow, for $g(x),$ let's go through our continuity checklist:\n\n- $g(7)=5(7)+14=49$ exists $\\,\\,✓$\n\n- Let's now check the left and right limits. We see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{7}^{-}}g(x) & ={lim}_{x\\to \\,{7}^{-}}{x}^{2}=49, \\\\ {lim}_{x\\to \\,{7}^{+}}g(x) & ={lim}_{x\\to \\,{7}^{+}}(5x+14)=5(7)+14=49.\\end{aligned}\n$$\n\nTherefore, the overall limit exists and ${lim}_{x\\to 7}f(x)=49.\\,\\,✓$ $\\,\\,\\,$\n\n- Finally, we check that the value of the limit equals the value of the function: \n\n$$\n{lim}_{x\\to \\,7}g(x)=49=g(7).\\,\\,✓\n$$\n\nTherefore, $g(x)$ is continuous at $x=7.$\n\nFor $h(x),$ let's go through our continuity checklist:\n\n- $h(7)=\\frac{1}{7}$ exists $\\,\\,✓$\n\n- Let's now check the left and right limits. We see that\n\n$$\n{lim}_{x\\to \\,{7}^{-}}h(x)={lim}_{x\\to \\,{7}^{-}}\\frac{1}{x-7}=-\\infty \n$$\n\nwhile\n\n$$\n{lim}_{x\\to \\,{7}^{+}}h(x)={lim}_{x\\to \\,{7}^{+}}\\frac{1}{7}=\\frac{1}{7}.\n$$\n\nSince the left limit is infinite, $h(x)$ does not have a jump discontinuity at $x=7.$"}] [{:db/id #edb/ref 17592186399460 :knowledge-point/_questions [{:knowledge-point/id #uuid "d441155e-dbcb-598d-afc7-949ee4eddbee" :knowledge-point/title "Solving for Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebc9a652-78bc-56e9-bbb9-e0e432ff2290" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{s}" :db/id #edb/ref 17592186399462} {:answer/id #uuid "46566ccb-f018-5fbf-8a9a-fb8e12ab7d33" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,\\text{s}" :db/id #edb/ref 17592186399463} {:answer/id #uuid "69f9e871-80df-5ab4-8c4c-e720f8a5a815" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{s}" :db/id #edb/ref 17592186399464} {:answer/id #uuid "b478efaf-4aec-5b20-a501-f7d67ed8b782" :answer/type {:db/ident :answer.type/math} :answer/value "2.5\\,\\text{s}" :db/id #edb/ref 17592186399465} {:answer/id #uuid "0e084290-9667-5d4e-9d9c-9adb52547631" :answer/type {:db/ident :answer.type/math} :answer/value "4.2\\,\\text{s}" :db/id #edb/ref 17592186399466}] :answer-field/correct {:answer/id #uuid "69f9e871-80df-5ab4-8c4c-e720f8a5a815" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{s}" :db/id #edb/ref 17592186399464} :answer-field/id #uuid "ea12a079-2c84-586d-a9b7-8507a867fa80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399461}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2086c80-ba1e-5c33-a529-5c1e9cecd9e9" :question/math-academy-id "q-10510" :question/problem "A ball is dropped vertically downward from a height of $44.1\\,\\text{m}.$ How long does it take for the ball to hit the ground?\n\n*Hint: The acceleration due to gravity is $9.8\\,{\\text{m/s}}^{2}.$*" :question/worked-solution "To solve this problem, we use the formula\n\n$$\ns=ut+\\frac{1}{2}g{t}^{2},\n$$\n\nwhere $s$ is the displacement, measured from the starting position in the direction of the initial motion, $u$ is the initial velocity, $t$ is the time since the beginning of the motion, and $g$ is the acceleration due to gravity.\n\nLet's summarize the information we have:\n\n- The initial velocity of the ball is $u=0\\,\\text{m/s}.$\n\n- The ball covers the distance of $s=44.1\\,\\text{m}.$\n\n- The acceleration due to gravity is $g=9.8\\,{\\text{m/s}}^{2}.$\n\nSubstituting these values into the formula and solving for $t,$ we obtain the following:\n\n$$\n\\begin{aligned}s & =ut+\\frac{1}{2}g{t}^{2} \\\\ 44.1 & =(0)t+\\frac{1}{2}(9.8){t}^{2} \\\\ 44.1 & =4.9{t}^{2} \\\\ {t}^{2} & =\\frac{44.1}{4.9} \\\\ {t}^{2} & =9 \\\\ t & =\\pm 3\\end{aligned}\n$$\n\nWe disregard the negative solution. Therefore, the ball hits the ground after $t=3$ seconds."}] [{:db/id #edb/ref 17592186399467 :knowledge-point/_questions [{:knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be" :knowledge-point/title "Determining Whether a Vector Lies on a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5469c2f4-10d4-551a-8387-1f41e195f9f3" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186399469} {:answer/id #uuid "b5aaf75e-0319-5e2f-b6a1-406f9f457622" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186399470} {:answer/id #uuid "6f0f386a-54e4-5bbd-999d-c5b1e894fea2" :answer/type {:db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186399471} {:answer/id #uuid "ea345608-0f4c-5f8a-9cea-a53c46ba68a9" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186399472} {:answer/id #uuid "f370dd07-5630-5589-a9df-b8eef801b693" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ does not lie on $Π$" :db/id #edb/ref 17592186399473}] :answer-field/correct {:answer/id #uuid "f370dd07-5630-5589-a9df-b8eef801b693" :answer/type {:db/ident :answer.type/text} :answer/value "$u$ does not lie on $Π$" :db/id #edb/ref 17592186399473} :answer-field/id #uuid "3ded2025-f849-5e24-ae50-154d00e66f84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da64bb93-914e-5229-bb6d-b7d97e6fa1bb" :question/math-academy-id "q-105248" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨1,-4,2⟩$, $c=⟨3,-10,2⟩$, and  $u=⟨-2,5,0⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ -4 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ -10 \\\\ 2\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 5 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s+3t=-2 \\\\ -4s-10t=5 \\\\ 2s+2t=0\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 3 & -2 \\\\ -4 & -10 & 5 \\\\ 2 & 2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 2 & -3 \\\\ 2 & 2 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 2 & -3 \\\\ 0 & -4 & 4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & -2 \\\\ 0 & 2 & -3 \\\\ 0 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=-2,$ which has no solution.\n\nSo, there are no values of $s$ and $t$ such that \n\n$$\n\\begin{aligned}sb+tc=u.\\end{aligned}\n$$\n\nTherefore, we conclude that $u$ does *not* lie on the plane $Π.$"}] [{:db/id #edb/ref 17592186399474 :knowledge-point/_questions [{:knowledge-point/id #uuid "61cadd46-5fae-51c6-8e5b-8114e48b12da" :knowledge-point/title "Finding and Classifying All Critical Points Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "984bdcd8-65fe-53ce-9365-592fb416acc7" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(0,0)$ and a local minimum at $(\\frac{1}{2},\\frac{1}{4})$" :db/id #edb/ref 17592186399476} {:answer/id #uuid "6f09a46f-378b-5666-b31d-7d594024f410" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(0,0)$ and a local maximum at $(\\frac{1}{2},\\frac{1}{4})$" :db/id #edb/ref 17592186399477} {:answer/id #uuid "6299c235-6bfa-5841-89fe-0705634d245b" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a local maximum at $(0,0)$ and a local minimum at $(\\frac{1}{2},\\frac{1}{4})$" :db/id #edb/ref 17592186399478} {:answer/id #uuid "2d302c69-b32c-57f8-ae7a-4cd8d92c0343" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has local maximum at $(0,0)$ and a local minimum at $(1,\\frac{1}{2})$" :db/id #edb/ref 17592186399479} {:answer/id #uuid "d62b096f-ff9c-5138-8170-e9ee40a546da" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(0,0)$ and a local maximum at $(1,\\frac{1}{2})$" :db/id #edb/ref 17592186399480}] :answer-field/correct {:answer/id #uuid "984bdcd8-65fe-53ce-9365-592fb416acc7" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(0,0)$ and a local minimum at $(\\frac{1}{2},\\frac{1}{4})$" :db/id #edb/ref 17592186399476} :answer-field/id #uuid "905988c5-8a51-5ced-aa99-8546923bfeea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399475}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f004a40-028a-581c-ab25-3ac8bd7f4fe7" :question/math-academy-id "q-105281" :question/problem "Find and categorize all the local extrema of the function \n$f(x,y)$ \ngiven that\n\n$$\n{f}^{′}(x,y)=[\\begin{aligned}{x}^{2}-y & 8{y}^{2}-x\\end{aligned}].\n$$" :question/worked-solution "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}{x}^{2}-y & 8{y}^{2}-x\\end{aligned}],$ we must have\n\n$$\n\\frac{∂f}{∂x}={x}^{2}-y,\\,\\frac{∂f}{∂y}=8{y}^{2}-x.\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting ${f}^{′}(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n{\\begin{aligned}{x}^{2}-y=0 \\\\ 8{y}^{2}-x=0\\end{aligned}\n$$\n\nSolving the first equation for $y,$ we get\n\n$$\n{x}^{2}-y=0\\,⟹\\,y={x}^{2}.\n$$\n\nThen, substituting this into the second equation, we get\n\n$$\n\\begin{aligned}8{({x}^{2})}^{2}-x & =0 \\\\ 8{x}^{4}-x & =0 \\\\ x(8{x}^{3}-1) & =0 \\\\ x & =0,\\frac{1}{2}.\\end{aligned}\n$$\n\nBack-substituting these values into $y={x}^{2},$ we obtain\n\n$$\nx=0\\,\\,\\,\\,⟹\\,y={0}^{2}=0,\\,\\,x=\\frac{1}{2}\\,⟹\\,y={(\\frac{1}{2})}^{2}=\\frac{1}{4}.\n$$\n\nHence, $(0,0)$ and $(\\frac{1}{2},\\frac{1}{4})$ are stationary points of $f(x,y).$\n\nTo classify these stationary points, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}({x}^{2}-y)=2x\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(8{y}^{2}-x)=-1 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}({x}^{2}-y)=-1\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(8{y}^{2}-x)=16y\\end{aligned}\n$$\n\nSo, the second derivative is \n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂x∂y}\\end{aligned}]=[\\begin{aligned}2x & -1 \\\\ -1 & 16y\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate the second derivative at each of the stationary points and use it to categorize them:\n\n- Evaluating the second derivative at $(0,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,0)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(0,0),$ we get\n\n$$\nH(0,0)=det({f}^{″}(0,0))={0}^{2}-(-1)^{2}=-1<0,\n$$\n\nTherefore, $f(0,0)$ is a saddle point.\n\n- Evaluating the second derivative at $(\\frac{1}{2},\\frac{1}{4}),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(\\frac{1}{2},\\frac{1}{4})=[\\begin{aligned}1 & -1 \\\\ -1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(\\frac{1}{2},\\frac{1}{4}),$ we get\n\n$$\nH(\\frac{1}{2},\\frac{1}{4})=det({f}^{″}(\\frac{1}{2},\\frac{1}{4}))=1\\cdot 4-(-1)^{2}=3>0\n$$\n\nFinally, since $H(\\frac{1}{2},\\frac{1}{4})>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(\\frac{1}{2},\\frac{1}{4})={h}_{11}=1>0.$ Therefore, we have a local minimum at $(\\frac{1}{2},\\frac{1}{4}).$\n\nIn conclusion, $f(x,y)$ has a saddle point at $(0,0)$ and a local minimum at $(\\frac{1}{2},\\frac{1}{4}).$"}] [{:db/id #edb/ref 17592186399481 :knowledge-point/_questions [{:knowledge-point/id #uuid "61cadd46-5fae-51c6-8e5b-8114e48b12da" :knowledge-point/title "Finding and Classifying All Critical Points Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3afd00a5-3aad-54a4-9a70-7c2101ecdf05" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a local minimum at $(e,0)$" :db/id #edb/ref 17592186399483} {:answer/id #uuid "31d284b3-9581-5047-bd3c-06f5026f21ae" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(1,0)$" :db/id #edb/ref 17592186399484} {:answer/id #uuid "695ef7e4-8c5b-50c4-8cf4-14edfc45ad32" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a local maximum at $(1,0)$" :db/id #edb/ref 17592186399485} {:answer/id #uuid "0f6f1aac-15a6-50d6-aa33-e5d5e4a93551" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a local minimum at $(1,0)$" :db/id #edb/ref 17592186399486} {:answer/id #uuid "c771dbaf-56aa-550b-b408-073f99da90f1" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(e,0)$" :db/id #edb/ref 17592186399487}] :answer-field/correct {:answer/id #uuid "31d284b3-9581-5047-bd3c-06f5026f21ae" :answer/type {:db/ident :answer.type/text} :answer/value "$f(x,y)$ has a saddle point at $(1,0)$" :db/id #edb/ref 17592186399484} :answer-field/id #uuid "7119470b-d6b1-5d18-94e0-b83f9d1bc35d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399482}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e1b5f6e8-a9c9-5be3-86f7-77f082bfcf04" :question/math-academy-id "q-105338" :question/problem "Find and categorize all local the extrema of the function $f(x,y)=y\\operatorname{ln}⁡x-{y}^{2},$ and determine which of the following statements is true." :question/worked-solution "The local extrema of $f$ occur at its critical points. A point $a$ in the domain of $f$ is a critical point of $f$ if ${f}^{′}(a)={0}^{T}$ (for stationary points) or ${f}^{′}(a)$ doesn't exist.\n\nThe second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}f′(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}(y\\operatorname{ln}⁡x-{y}^{2}) & \\frac{∂}{∂y}(y\\operatorname{ln}⁡x-{y}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{y}{x} & \\operatorname{ln}⁡x-2y\\end{aligned}]\\end{aligned}\n$$\n\nThe first derivative exists for any $(x,y)$ in the domain of the function, so we only need to find the stationary points. Setting $f′(x,y)={0}^{T},$ we obtain the following system:\n\n$$\n{\\begin{aligned}\\frac{y}{x}=0 \\\\ \\operatorname{ln}⁡x-2y=0\\end{aligned}\n$$\n\nSolving the first equation for $y,$ we get\n\n$$\n\\frac{y}{x}=0\\,⟹\\,y=0.\n$$\n\nThen, substituting this into the second equation, we obtain\n\n$$\n\\operatorname{ln}⁡x-2(0)=\\operatorname{ln}⁡x=0\\,⟹\\,x=1.\n$$\n\nHence, $(1,0)$ is a stationary point of $f(x,y).$\n\nTo classify this stationary point, we use the second partial derivative test.\n\nFirst, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{y}{x})=-\\frac{y}{{x}^{2}}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡x-2y)=\\frac{1}{x} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(\\frac{y}{x})=\\frac{1}{x}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡x-2y)=-2\\end{aligned}\n$$\n\nSo, the second derivative  is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}-\\frac{y}{{x}^{2}} & \\frac{1}{x} \\\\ \\frac{1}{x} & -2\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating the second derivative at $(1,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,0)=[\\begin{aligned}0 & 1 \\\\ 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nComputing the determinant $H(1,0),$ we get\n\n$$\nH(1,0)=det({f}^{″}(1,0))=0\\cdot (-2)-{1}^{2}=-1<0.\n$$\n\nTherefore, applying the second partial derivative test, we have that $f(x,y)$ has a saddle point at $(1,0).$"}] [{:db/id #edb/ref 17592186399488 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd4abd5d-2642-5f0d-af2f-5ed5c265526a" :knowledge-point/title "Dividing a Polynomial by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed9271b-c279-5a55-948c-92d0d1f3cb4f" :answer/type {:db/ident :answer.type/text} :answer/value "$2{x}^{2}-2x+1\\,$ and $\\,-3{x}^{2}+x$" :db/id #edb/ref 17592186399490} {:answer/id #uuid "8998fe59-12df-54be-b54d-ca8f0f8a155a" :answer/type {:db/ident :answer.type/text} :answer/value "$2{x}^{2}+x+2\\,$ and $\\,+3{x}^{2}-x$" :db/id #edb/ref 17592186399491} {:answer/id #uuid "8c584647-74c7-50d8-b7b4-101a4b15dae4" :answer/type {:db/ident :answer.type/text} :answer/value "$2{x}^{2}-x+2\\,$ and $\\,-3{x}^{2}+x$" :db/id #edb/ref 17592186399492} {:answer/id #uuid "84021088-abb5-5ad2-8756-f12c652e2c35" :answer/type {:db/ident :answer.type/text} :answer/value "$2{x}^{2}+2x+1\\,$ and $\\,6{x}^{2}+x$" :db/id #edb/ref 17592186399493} {:answer/id #uuid "f1db7d2c-8cf3-5b19-8259-5193b46ec41d" :answer/type {:db/ident :answer.type/text} :answer/value "$2{x}^{2}-2x+2\\,$ and $\\,-6{x}^{2}+x$" :db/id #edb/ref 17592186399494}] :answer-field/correct {:answer/id #uuid "8c584647-74c7-50d8-b7b4-101a4b15dae4" :answer/type {:db/ident :answer.type/text} :answer/value "$2{x}^{2}-x+2\\,$ and $\\,-3{x}^{2}+x$" :db/id #edb/ref 17592186399492} :answer-field/id #uuid "c64ca425-bacd-5a4c-ad53-32525c95cc75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43288d06-2433-5fb0-a435-3396899a6f12" :question/math-academy-id "q-105591" :question/problem "From top to bottom, what are the missing expressions in the following polynomial division problem?\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\boxed{} \\\\  & 3x-1\\,\\enclose{longdiv}{6{x}^{3}-5{x}^{2}+7x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,3{x}^{2}+7x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{\\boxed{}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6\\end{aligned}\n$$" :question/worked-solution "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,2{x}^{2}-x+2 \\\\  & 3x-1\\,\\enclose{longdiv}{6{x}^{3}-5{x}^{2}+7x+4\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6{x}^{3}-2{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,-\\,3{x}^{2}+7x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{-\\,3{x}^{2}+\\,\\,x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6x+4 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{6x-2}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,6\\end{aligned}\n$$\n\n  \n\nTherefore, the missing expressions are \n\n$\\,$ $2{x}^{2}-x+2\\,$ and $\\,-3{x}^{2}+x.$"}] [{:db/id #edb/ref 17592186399495 :knowledge-point/_questions [{:knowledge-point/id #uuid "7dffa987-022c-52a2-bc21-cdace7455eab" :knowledge-point/title "Determining the Number of Solutions Given a Table of Values of a Continuous Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8858bd6f-a8b4-5fe8-a1a9-895135df061c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186399497} {:answer/id #uuid "0d8e6bb5-117f-5248-aff1-eaa568696772" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186399498} {:answer/id #uuid "b8c430e6-21f3-568a-b0df-7908527787ba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186399499} {:answer/id #uuid "a3df0798-6d2d-530c-9c43-5edfc69b105b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186399500} {:answer/id #uuid "a1ac30b3-74c8-525d-adab-ab72d29ef667" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186399501}] :answer-field/correct {:answer/id #uuid "8858bd6f-a8b4-5fe8-a1a9-895135df061c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186399497} :answer-field/id #uuid "5d82b2e4-6f95-5829-98a0-f3c805de2c17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399496}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07c30a16-0504-5c16-ba6b-3435983938c4" :question/math-academy-id "q-105701" :question/problem "The function $g(x)$ is continuous over $x\\in [2,7].$ Some values of $g(x)$ are given in the table below. \n\n| $x$ | $2$ | $3$ | $4$ | $5$ | $6$ | $7$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $g(x)$ | $-2$ | $1$ | $-3$ | $1$ | $0$ | $2$ |\n\nWhat is the smallest possible number of solutions to the equation $g(x)=-1?$" :question/worked-solution "Since $g$ is a continuous function on $[2,7]$, we can apply the intermediate value theorem (IVT) in any subinterval of $[2,7].$\n\nSo, we will go through each subinterval of $[2,7]$ and check if the IVT guarantees a solution to the equation $g(x)=-1.$\n\n- On the subinterval $[2,3],$ we have $g(2)=-2$ and $g(3)=1.$ Since $-1\\in [-2,1],$  the IVT *does * guarantee a solution to the equation $g(x)=-1$ on this subinterval.\n\n- On the subinterval $[3,4],$ we have $g(3)=1$ and $g(4)=-3.$ Since $-1\\in [-3,1],$ the IVT *does* guarantee a solution to the equation $g(x)=-1$ on this subinterval.\n\n- On the subinterval $[4,5],$ we have $g(4)=-3$ and $g(5)=1.$ Since $-1\\in [-3,1],$ the IVT *does * guarantee a solution to the equation $g(x)=-1$ on this subinterval.\n\n- On the subinterval $[5,6],$ we have $g(5)=1$ and $g(6)=0.$ Since $-1\\notin [0,1],$ the IVT does *not* guarantee a solution to the equation $g(x)=-1$ on this subinterval.\n\n- On the subinterval $[6,7],$ we have $g(6)=0$ and $g(7)=2.$ Since $-1\\notin [0,2],$ the IVT does *not* guarantee a solution to the equation $g(x)=-1$ on this subinterval.\n\nThe IVT guarantees solutions to $g(x)=-1$ on the subintervals $[2,3],$ $[3,4]$  and $[4,5].$ Therefore, $g(x)=-1$ has at least three solutions on $[2,7].$"}] [{:db/id #edb/ref 17592186399502 :knowledge-point/_questions [{:knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146d3b28-8e29-5eb2-9b1c-13a2a90ec385" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +2,\\,y=\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186399504} {:answer/id #uuid "d4d5787b-b5bd-5b27-a033-31a126fb604a" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +2,\\,y=2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186399505} {:answer/id #uuid "ebd95806-d79f-5932-8502-3d798b511be9" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +1,\\,y=2\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399506} {:answer/id #uuid "c7286f56-415b-5975-9965-cac2f25bbe61" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta -1,\\,y=2\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186399507} {:answer/id #uuid "4df757e2-103b-56a4-a77e-0738b69bd499" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta -2,\\,y=2\\operatorname{sin}⁡\\theta -1" :db/id #edb/ref 17592186399508}] :answer-field/correct {:answer/id #uuid "d4d5787b-b5bd-5b27-a033-31a126fb604a" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +2,\\,y=2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186399505} :answer-field/id #uuid "05f37ecc-6d85-5118-a9aa-9f9f01af2578" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "656ebe17-b886-53ff-b069-a7253f396457" :question/math-academy-id "q-106049" :question/problem "![](images/21/2135f70f6703878d5f82d3524c890af08e194d7fdfbe92e97a5305d142f73779.png)\n\nConsider the circle of radius $2$ centered at $(2,1)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(4,1)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $2$ centered at the point $(2,1).$ Therefore, the parametric equations of the circle are\n\n$$\nx=2\\operatorname{cos}⁡\\theta +2,\\,y=2\\operatorname{sin}⁡\\theta +1,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186399509 :knowledge-point/_questions [{:knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f37153f-6b80-5708-b6a4-edebf7c3a823" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399511} {:answer/id #uuid "d0b71958-0b7a-58d5-aa67-e69e50d38e5b" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186399512} {:answer/id #uuid "e501da01-42b8-58ee-9609-f73020f69f4d" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta +2,\\,y=3\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186399513} {:answer/id #uuid "08a3ceb4-1e5e-5d85-b566-0b5a554e82e5" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399514} {:answer/id #uuid "08282cf0-c65d-5a51-98dd-3a937c9e9dc5" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta -3,\\,y=2\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186399515}] :answer-field/correct {:answer/id #uuid "08a3ceb4-1e5e-5d85-b566-0b5a554e82e5" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399514} :answer-field/id #uuid "4b61b62a-5e5d-5935-a620-97cbe92e0582" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399510}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c45d1161-cc6e-56e5-89da-543c3e758d02" :question/math-academy-id "q-106051" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $3$ centered at the point $(-3,2)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, we have a circle of radius $3$ centered at the point $(-3,2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=3\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186399516 :knowledge-point/_questions [{:knowledge-point/id #uuid "db20f4a5-27a4-5fbc-aae2-2febf8f99cb1" :knowledge-point/title "The Parametric Equations of an Ellipse Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d35582-3a44-5c08-8455-d2f9e84525d5" :answer/type {:db/ident :answer.type/math} :answer/value "x=9\\operatorname{cos}⁡\\theta ,\\,y=36\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186399518} {:answer/id #uuid "aba5b46d-91ae-5e56-a685-c83b09b8b31b" :answer/type {:db/ident :answer.type/math} :answer/value "x=6\\operatorname{sin}⁡\\theta ,\\,y=3\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186399519} {:answer/id #uuid "d7d5554c-9aa3-5296-9ebc-642d7ab8668d" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta ,\\,y=6\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186399520} {:answer/id #uuid "21ab22a6-9eb5-5460-a37a-51dabf9c5da8" :answer/type {:db/ident :answer.type/math} :answer/value "x=36\\operatorname{sin}⁡\\theta ,\\,y=9\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186399521} {:answer/id #uuid "a8369c3d-7d61-5b31-87ce-5b1b018ff986" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\sqrt{3}\\operatorname{cos}⁡\\theta ,\\,y=\\sqrt{6}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186399522}] :answer-field/correct {:answer/id #uuid "d7d5554c-9aa3-5296-9ebc-642d7ab8668d" :answer/type {:db/ident :answer.type/math} :answer/value "x=3\\operatorname{cos}⁡\\theta ,\\,y=6\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186399520} :answer-field/id #uuid "36c47bf3-1ccf-54fd-84c2-b2131105d199" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23823644-896c-5b5c-b67a-e94d42442783" :question/math-academy-id "q-106391" :question/problem "![](images/6b/6b8b0f54b4bc1e9c7362bd0b22f3dbc2550594855a1225350d366b9a86b0e3f0.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" :question/worked-solution "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=3$ and $b=6.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=6\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186399523 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f9ea905-6eb5-55fe-b487-b115406bbc46" :knowledge-point/title "Finding Points That Satisfy the Mean Value Theorem for Three-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b63ab9ff-56cc-569e-a2eb-37c7b01b50d4" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\frac{1}{2},\\frac{2}{3},\\frac{1}{2})$ and $(-\\frac{2}{3},\\frac{1}{3},\\frac{2}{3})$" :db/id #edb/ref 17592186399525} {:answer/id #uuid "ccb712d9-a5c5-5d8c-831a-ab2ad2eb58be" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\frac{1}{2},\\frac{2}{3},\\frac{1}{2})$ and $(0,1,0)$" :db/id #edb/ref 17592186399526} {:answer/id #uuid "c0e7b9b8-1b51-5d9a-a752-82b801722063" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\frac{2}{3},\\frac{1}{3},\\frac{2}{3})$ and $(0,1,0)$" :db/id #edb/ref 17592186399527} {:answer/id #uuid "39a8fbcf-5380-5a95-af67-4ee1a6d74327" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0,1)$ and $(-\\frac{1}{3},\\frac{2}{3},\\frac{1}{3})$" :db/id #edb/ref 17592186399528} {:answer/id #uuid "55cd1cb9-8166-5d71-80af-8f3412ded7b9" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0,1)$ and $(-\\frac{1}{2},\\frac{2}{3},\\frac{1}{2})$" :db/id #edb/ref 17592186399529}] :answer-field/correct {:answer/id #uuid "c0e7b9b8-1b51-5d9a-a752-82b801722063" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\frac{2}{3},\\frac{1}{3},\\frac{2}{3})$ and $(0,1,0)$" :db/id #edb/ref 17592186399527} :answer-field/id #uuid "b7e2b45d-5b9d-5091-9941-06bd82a064b8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399524}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6a0cb1f4-667e-57bd-8d19-2b32f34f6a8a" :question/math-academy-id "q-106585" :question/problem "Find the points that satisfy the mean value theorem for $f(x,y,z)={x}^{2}-{z}^{3}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨-1,0,1⟩$ and $b=⟨0,1,0⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that $f(x,y,z)={x}^{2}-{z}^{3}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨-1,0,1⟩$ and $b=⟨0,1,0⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(0,1,0)-f(-1,0,1) & =∇f(c)\\cdot (⟨0,1,0⟩-⟨-1,0,1⟩) \\\\ 0-0 & =∇f(c)\\cdot ⟨1,1,-1⟩ \\\\ 0 & =∇f(c)\\cdot ⟨1,1,-1⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨2x,0,-3{z}^{2}⟩ \\\\ ∇f(c) & =⟨2{c}_{1},0,-3{c}_{3}^{2}⟩.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}0 & =∇f(c)\\cdot ⟨1,1,-1⟩ \\\\ 0 & =⟨2{c}_{1},0,-3{c}_{3}^{2}⟩\\cdot ⟨1,1,-1⟩ \\\\ 0 & =2{c}_{1}+3{c}_{3}^{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{x-(-1)}{1} & =\\frac{y-0}{1}=\\frac{z-1}{(-1)} \\\\ x+1 & =y=1-z\\end{aligned}\n$$\n\nParametrizing the line, we get\n\n$$\nx=t-1\\,\\,y=t,\\,z=1-t,\\,0\\le t\\le 1.\n$$\n\nSince $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩$ satisfies the equation of the line, we have\n\n$$\n{c}_{1}=t-1\\,\\,{c}_{2}=t,\\,{c}_{3}=1-t.\n$$\n\nSubstituting the above in the equation $2{c}_{1}+3{c}_{3}^{2}=0,$ we get\n\n$$\n\\begin{aligned}2(t-1)+3(1-t)^{2} & =0 \\\\ (t-1)[2+3(t-1)] & =0 \\\\ (t-1)(3t-1) & =0 \\\\ t & =\\frac{1}{3},\\,1.\\end{aligned}\n$$\n\nNow we proceed to find the coordinates of the points that satisfy the mean value theorem.\n\n- For $t=\\frac{1}{3},$ we get\n\n$$\n\\begin{aligned}{c}_{1} & =\\frac{1}{3}-1=-\\frac{2}{3}, \\\\ {c}_{2} & =\\frac{1}{3}, \\\\ {c}_{3} & =1-\\frac{1}{3}=\\frac{2}{3}.\\end{aligned}\n$$\n\nThus, the coordinates of the first point $C$ are $(-\\frac{2}{3},\\frac{1}{3},\\frac{2}{3}).$\n\n- For $t=1,$ we get\n\n$$\n\\begin{aligned}{c}_{1} & =1-1=0, \\\\ {c}_{2} & =1, \\\\ {c}_{3} & =1-1=0.\\end{aligned}\n$$\n\nThus, the coordinates of the second point $C$ are $(0,1,0).$"}] [{:db/id #edb/ref 17592186399530 :knowledge-point/_questions [{:knowledge-point/id #uuid "dffa4760-00cb-5395-8fab-dc7f9fe20597" :knowledge-point/title "Finding the Inverse of a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a03c021-ed0f-56d1-9f86-6e79e9f2243f" :answer/type {:db/ident :answer.type/text} :answer/value "If it is not raining, then it is winter." :db/id #edb/ref 17592186399532} {:answer/id #uuid "a3563445-92f5-50b0-ac76-9bc11efc53d6" :answer/type {:db/ident :answer.type/text} :answer/value "If it is not winter, then it is raining." :db/id #edb/ref 17592186399533} {:answer/id #uuid "56c3fd5e-3d94-5fa6-86e5-8f3bba739552" :answer/type {:db/ident :answer.type/text} :answer/value "If it is winter, then it is not raining." :db/id #edb/ref 17592186399534} {:answer/id #uuid "1d41538a-0fa0-518c-be9a-da1a8f9015d9" :answer/type {:db/ident :answer.type/text} :answer/value "If it is not raining, then it is not winter." :db/id #edb/ref 17592186399535} {:answer/id #uuid "778cf961-301a-523b-93e0-fd59d3bcd024" :answer/type {:db/ident :answer.type/text} :answer/value "If it is raining, then it is winter." :db/id #edb/ref 17592186399536}] :answer-field/correct {:answer/id #uuid "1a03c021-ed0f-56d1-9f86-6e79e9f2243f" :answer/type {:db/ident :answer.type/text} :answer/value "If it is not raining, then it is winter." :db/id #edb/ref 17592186399532} :answer-field/id #uuid "f115b663-1b63-53de-8458-d4ee1cff91f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399531}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ec898c4f-16e5-5b8b-9206-977a4ec7986a" :question/math-academy-id "q-106678" :question/problem "Find the inverse of the following statement: \n\n$\\,$ **If** it is raining, **then** it is not winter." :question/worked-solution "In our conditional statement:\n\n- The antecedent is $A:$ It is raining.\n\n- The consequent is $B:$ It is not winter.\n\nThe inverse of a conditional statement $A⇒B$ is given by \n\n$$\n¬A⇒¬B.\n$$\n\nFirst, we write down the negations of $A$ and $B:$\n\n- $¬A:$ It is not raining.\n\n- $¬B:$ It is winter.\n\nTherefore, the inverse is the following: \n\n$\\,$ If it is not raining, then it is winter."}] [{:db/id #edb/ref 17592186399537 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d82541c-40ca-5df9-aa17-c20b201fadd4" :knowledge-point/title "The Parametric Equations of an Ellipse Centered at a General Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b497d42e-bb82-5ad8-b534-e2c147e1ff42" :answer/type {:db/ident :answer.type/math} :answer/value "x=36\\operatorname{cos}⁡\\theta -2,\\,y=16\\operatorname{sin}⁡\\theta +3" :db/id #edb/ref 17592186399539} {:answer/id #uuid "0713f8eb-12ff-5fe2-9526-65877bb581ff" :answer/type {:db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta +3,\\,y=4\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186399540} {:answer/id #uuid "3969d63a-a2eb-506f-beb7-6cde82a0d05c" :answer/type {:db/ident :answer.type/math} :answer/value "x=12\\operatorname{cos}⁡\\theta +2,\\,y=8\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186399541} {:answer/id #uuid "9a825ff3-cad9-54b1-8ffe-6c0d2f47c301" :answer/type {:db/ident :answer.type/math} :answer/value "x=12\\operatorname{cos}⁡\\theta -3,\\,y=8\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399542} {:answer/id #uuid "da3c9fdb-6c6a-55f0-8a89-dc38f3583e7c" :answer/type {:db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta -3,\\,y=4\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399543}] :answer-field/correct {:answer/id #uuid "da3c9fdb-6c6a-55f0-8a89-dc38f3583e7c" :answer/type {:db/ident :answer.type/math} :answer/value "x=6\\operatorname{cos}⁡\\theta -3,\\,y=4\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186399543} :answer-field/id #uuid "031319c8-f560-5ad6-9024-95c6acad5a42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399538}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df313a83-5c0b-5be0-b850-d3d38af97ca0" :question/math-academy-id "q-106706" :question/problem "![](images/b7/b77fa9e3a398cf9f6cc3a3ea163b83cb75f1e5c9ea98aa1ae34730616c47977c.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" :question/worked-solution "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(-3,2),$ $a=6$ and $b=4.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=6\\operatorname{cos}⁡\\theta -3,\\,y=4\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186399544 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4e9867f-15ba-5073-a20f-542045fced08" :knowledge-point/title "Finding the Eigenvalue that Corresponds to a Given Eigenvector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17797bd9-5452-599e-90e2-f82db113737c" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186399546} {:answer/id #uuid "d97a9b83-e803-56f7-9eb3-247224ecca7e" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ is not an eigenvector of $A$" :db/id #edb/ref 17592186399547} {:answer/id #uuid "9d24ac33-bad1-5eef-bbbc-5c38f32cda9e" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186399548} {:answer/id #uuid "dc542406-6a78-5728-b72b-ed2d72b9ad25" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186399549} {:answer/id #uuid "b6650df1-dfaf-53a5-afd8-f7fca95b0e9f" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186399550}] :answer-field/correct {:answer/id #uuid "d97a9b83-e803-56f7-9eb3-247224ecca7e" :answer/type {:db/ident :answer.type/text} :answer/value "$v$ is not an eigenvector of $A$" :db/id #edb/ref 17592186399547} :answer-field/id #uuid "dd4725f6-2b66-51a3-bec8-dcfb0783e6bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399545}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "56a4f3a9-ccca-53d2-8026-09ec5330fdbb" :question/math-academy-id "q-106775" :question/problem "Determine if $v=[\\begin{aligned}2 \\\\ -4\\end{aligned}]$ is an eigenvector of the matrix \n$A=[\\begin{aligned}6 & -1 \\\\ 2 & 3\\end{aligned}].$\nIf so, then what is the corresponding eigenvalue?" :question/worked-solution "The eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}6 & -1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ -8\\end{aligned}].\\end{aligned}\n$$\n\nIf $v$ is an eigenvector, then there must exist a real number $\\lambda $ such that $Av=\\lambda v.$ Hence, we have\n\n$$\n[\\begin{aligned}16 \\\\ -8\\end{aligned}]=\\lambda [\\begin{aligned}2 \\\\ -4\\end{aligned}].\n$$\n\nThis leads to the following system of equations for $\\lambda :$\n\n$$\n{\\begin{aligned}16=2\\lambda  \\\\ -8=-4\\lambda \\end{aligned}\n$$\n\nThis system has no solution. Therefore, $v$ is not an eigenvector of $A.$"}] [{:db/id #edb/ref 17592186399551 :knowledge-point/_questions [{:knowledge-point/id #uuid "dffa4760-00cb-5395-8fab-dc7f9fe20597" :knowledge-point/title "Finding the Inverse of a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ec6224-b57d-5ca7-859c-dcbbb6e108fa" :answer/type {:db/ident :answer.type/text} :answer/value "If it is winter, then Anna goes skiing on Saturdays." :db/id #edb/ref 17592186399553} {:answer/id #uuid "2d891f24-73b0-5875-b44f-79ba4ad7b991" :answer/type {:db/ident :answer.type/text} :answer/value "If it is not winter, then Anna does not go skiing on Saturdays." :db/id #edb/ref 17592186399554} {:answer/id #uuid "8e25f155-4a90-53a9-ade6-7dd66b5bf399" :answer/type {:db/ident :answer.type/text} :answer/value "If Anna does not go skiing on Saturdays, then it is not winter." :db/id #edb/ref 17592186399555} {:answer/id #uuid "f9ea204b-edb8-5f0a-b463-fa4e8dbd7a83" :answer/type {:db/ident :answer.type/text} :answer/value "If Anna goes skiing on Saturdays, then it is winter." :db/id #edb/ref 17592186399556} {:answer/id #uuid "2727ad80-44b0-53a5-bd56-cfe79b7d5689" :answer/type {:db/ident :answer.type/text} :answer/value "If it is not winter, then Anna goes skiing on Saturdays." :db/id #edb/ref 17592186399557}] :answer-field/correct {:answer/id #uuid "13ec6224-b57d-5ca7-859c-dcbbb6e108fa" :answer/type {:db/ident :answer.type/text} :answer/value "If it is winter, then Anna goes skiing on Saturdays." :db/id #edb/ref 17592186399553} :answer-field/id #uuid "5c616883-7332-5955-9182-72154b59acc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399552}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aea77357-df90-532a-9605-f078e917d667" :question/math-academy-id "q-106784" :question/problem "Find the inverse of the following statement: \n\n$\\,$ **If** it is not winter, **then** Anna does not go skiing on Saturdays." :question/worked-solution "In our conditional statement:\n\n- The antecedent is $A:$ It is not winter.\n\n- The consequent is $B:$ Anna does not go skiing on Saturdays.\n\nThe inverse of a conditional statement $A⇒B$ is given by \n\n$$\n¬A⇒¬B.\n$$\n\nFirst, we write down the negations of $A$ and $B:$\n\n- $¬A:$ It is winter.\n\n- $¬B:$ Anna goes skiing on Saturdays.\n\nTherefore, the inverse is the following: \n\n$\\,$ If it is winter, then Anna goes skiing on Saturdays."}] [{:db/id #edb/ref 17592186399558 :knowledge-point/_questions [{:knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bb68e1d-d899-5edf-a1fd-ffb8a94a6684" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186399560} {:answer/id #uuid "bbd9a95f-29f2-5eb4-9ab2-b3bcac27f74e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399561} {:answer/id #uuid "c722f147-0203-5a71-936b-072e37a9b502" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186399562} {:answer/id #uuid "04f5e601-e8f1-5165-8c77-5f70ab657db3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399563} {:answer/id #uuid "14770830-03c3-5a6c-94ae-f9b8f3466ab3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399564}] :answer-field/correct {:answer/id #uuid "bbd9a95f-29f2-5eb4-9ab2-b3bcac27f74e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399561} :answer-field/id #uuid "d50f7ea4-15ce-5b02-8fb1-f1bba0bb77a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399559}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "682029cb-a24a-5772-887f-fb965b3c043f" :question/math-academy-id "q-106842" :question/problem "Given that \n$A=[\\begin{aligned}4 & 7 & 0 \\\\ 4 & 9 & 1 \\\\ 0 & 0 & -5\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 7 & 0 \\\\ 4 & 9 & 1 \\\\ 0 & 0 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}4 & 7 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & -5\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}4 & 7 & 0 \\\\ 0 & 2 & 1 \\\\ 0 & 0 & -5\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399565 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03772422-1c36-5538-ad98-2c341599f95b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399567} {:answer/id #uuid "c2fca63d-f8ed-5f29-879b-652f96b8979f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186399568} {:answer/id #uuid "d42309d2-7714-52af-b242-8be64341a7ca" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186399569} {:answer/id #uuid "2ef8e9e4-6087-5646-8666-05b609a8e68f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186399570} {:answer/id #uuid "0d7c55b5-02cc-530a-a0d0-c4f52cb2cc8d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399571}] :answer-field/correct {:answer/id #uuid "0d7c55b5-02cc-530a-a0d0-c4f52cb2cc8d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399571} :answer-field/id #uuid "eaa733b0-227a-5a23-8495-605d957fadaa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7278f295-d94d-5655-a394-3d2aeae2f280" :question/math-academy-id "q-106847" :question/problem "Suppose that a $3\\times 3$ matrix $H$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}-3{R}_{1},\\,{R}_{3}:={R}_{3}-{R}_{1}.\n$$\n\nGiven that $H$ has the LU factorization $H=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+(-3)\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+(-1)\\cdot {R}_{1}$ is equivalent to multiplying $H$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot H=U\n$$\n\nNow, since ${E}_{2}{E}_{1}H=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399572 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c91fb2b-5607-555d-b897-f0e76765dfa6" :knowledge-point/title "Finding the Lower Triangular Matrix Given the Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fed22c0d-0f9b-57d1-92a2-caecdc72420b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -4 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399574} {:answer/id #uuid "3dfb8aa6-6f92-55b7-84d4-1a32fd997449" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399575} {:answer/id #uuid "ac6e2e5e-e175-5321-89f2-b8167e85c478" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186399576} {:answer/id #uuid "b3fa4db5-51d1-519e-a890-420dd4b64ea4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 4 & 1 & 0 \\\\ -1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399577} {:answer/id #uuid "4e8948a3-a5b2-529f-a83b-2897c1197641" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399578}] :answer-field/correct {:answer/id #uuid "4e8948a3-a5b2-529f-a83b-2897c1197641" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399578} :answer-field/id #uuid "35865859-bc92-5d3f-aac6-8f0761f92bd8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399573}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4eefc328-7753-58ac-9913-74a31d74d60d" :question/math-academy-id "q-106849" :question/problem "Suppose that a $3\\times 3$ matrix $H$ is reduced to row echelon form using the following elementary row operations, applied in the order in which they appear:\n\n$$\n{R}_{2}:={R}_{2}+{R}_{1},\\,{R}_{3}:={R}_{3}-4{R}_{1}.\n$$\n\nGiven that $H$ has the LU factorization $H=LU,$ then $L=$" :question/worked-solution "Applying ${R}_{2}:={R}_{2}+1\\cdot {R}_{1}$ and then ${R}_{3}:={R}_{3}+(-4)\\cdot {R}_{1}$ is equivalent to multiplying $H$ from the left by the following elementary matrices:\n\n$$\n{{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{2}}\\cdot {{[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}_{⏟}}_{{E}_{1}}\\cdot H=U\n$$\n\nNow, since ${E}_{2}{E}_{1}H=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}H & =U \\\\ {E}_{1}H & ={E}_{2}^{-1}U \\\\ H & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ H & ={[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}U \\\\ H & =([\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}])U \\\\ H & ={{[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot U\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399579 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e460dcd-59cf-54d2-80e6-c0d72b6bafdd" :knowledge-point/title "Finding the LU Factorization Using Two or More Elementary Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cf06c8c-fa37-5fb4-9bae-97c3d61f33d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399581} {:answer/id #uuid "21c0bd19-0548-5d99-9e33-6c9f927b3b22" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399582} {:answer/id #uuid "703a2c37-9c3b-5152-85d4-282f6208240c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186399583} {:answer/id #uuid "79134b3c-db1d-513d-a8c1-a59e34a636a6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186399584} {:answer/id #uuid "d3a10085-0e10-5d8b-b074-4aa9f88186b2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399585}] :answer-field/correct {:answer/id #uuid "d3a10085-0e10-5d8b-b074-4aa9f88186b2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186399585} :answer-field/id #uuid "b2955c7f-5f50-5316-9dc4-5bd9b60c3d48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399580}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1feecf50-2291-54b0-bdd0-e3e3488def82" :question/math-academy-id "q-106851" :question/problem "Given that \n$A=[\\begin{aligned}1 & -1 & 2 \\\\ 3 & -2 & 6 \\\\ -2 & 2 & -5\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & -1 & 2 \\\\ 3 & -2 & 6 \\\\ -2 & 2 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 0 \\\\ -2 & 2 & -5\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} & ⟺ & \\,\\overset{{E}_{2}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]}}\\cdot {E}_{1}\\cdot A \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{2}{E}_{1}A=U,$ we can invert ${E}_{2}$ and ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{2}{E}_{1}A & =U \\\\ {E}_{1}A & ={E}_{2}^{-1}U \\\\ A & ={E}_{1}^{-1}{E}_{2}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]}^{-1}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & =([\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}])U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -2 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399586 :knowledge-point/_questions [{:knowledge-point/id #uuid "74a902da-f299-54a3-8e93-ad2716d0e887" :knowledge-point/title "Modeling Inhibited Decay"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f5f9e59-3c36-5807-b8f1-60d5c867aee4" :answer/type {:db/ident :answer.type/math} :answer/value "{T}^{′}(t)=kT(T-21)" :db/id #edb/ref 17592186399588} {:answer/id #uuid "e3ef51c8-be4a-5a5f-b4b6-7b12be0bb5cc" :answer/type {:db/ident :answer.type/math} :answer/value "{T}^{′}(t)=-kT(T-21)" :db/id #edb/ref 17592186399589} {:answer/id #uuid "3f26a705-024d-5901-899b-988f84681bf6" :answer/type {:db/ident :answer.type/math} :answer/value "{T}^{′}(t)=-k(T-21)" :db/id #edb/ref 17592186399590} {:answer/id #uuid "49678131-628e-553a-9844-5179f76e8b91" :answer/type {:db/ident :answer.type/math} :answer/value "{T}^{′}(t)=k(T+21)" :db/id #edb/ref 17592186399591} {:answer/id #uuid "e7d4bea4-992f-5fb1-be9b-5bc63898ddea" :answer/type {:db/ident :answer.type/math} :answer/value "{T}^{′}(t)=-k(T+21)" :db/id #edb/ref 17592186399592}] :answer-field/correct {:answer/id #uuid "3f26a705-024d-5901-899b-988f84681bf6" :answer/type {:db/ident :answer.type/math} :answer/value "{T}^{′}(t)=-k(T-21)" :db/id #edb/ref 17592186399590} :answer-field/id #uuid "8c7c9128-4613-5828-914f-598e6ef01189" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399587}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d44d9a6b-035e-5168-a3f6-72ab2e21a7d8" :question/math-academy-id "q-106878" :question/problem "The rate at which a body cools is proportional to the difference between its temperature and the temperature of its surroundings. Let $T(t)$ be the temperature of the body in degrees Celsius, and let $t>0$ be the time in minutes. If the temperature of the surroundings is ${21}^{∘}\\text{C},$ which differential equation could be used to model the temperature of the liquid? Assume that $k>0$ is a constant of proportionality." :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={21}^{∘}\\text{C},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-21).\n$$"}] [{:db/id #edb/ref 17592186399593 :knowledge-point/_questions [{:knowledge-point/id #uuid "9bdb6bc9-47e2-5330-a1ee-270882f2aced" :knowledge-point/title "Proving Statements Using the Vector Space Axioms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96cab4fe-b011-5072-be3e-391125bf75c8" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{A3}$, $\\text{A6}$" :db/id #edb/ref 17592186399595} {:answer/id #uuid "479eb2f9-8717-57b1-9f07-9c964bbfdbab" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{A2}$, $\\text{A7}$" :db/id #edb/ref 17592186399596} {:answer/id #uuid "fcde83fb-02ab-5892-a45a-6c4b43adb9eb" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{A7}$, $\\text{A5}$" :db/id #edb/ref 17592186399597} {:answer/id #uuid "e44c72a4-6813-558a-a34c-560c1aff92da" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{A3}$, $\\text{A5}$" :db/id #edb/ref 17592186399598} {:answer/id #uuid "afcd5ca7-6625-5f48-ac5f-5ce7f390cf1f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{A6}$, $\\text{A3}$" :db/id #edb/ref 17592186399599}] :answer-field/correct {:answer/id #uuid "e44c72a4-6813-558a-a34c-560c1aff92da" :answer/type {:db/ident :answer.type/text} :answer/value "$\\text{A3}$, $\\text{A5}$" :db/id #edb/ref 17592186399598} :answer-field/id #uuid "0fb9d1c7-c909-596f-a04a-7d5c7e74340d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399594}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "258def85-3c26-5841-81d2-c1a1f3c916a4" :question/math-academy-id "q-106944" :question/problem "From top to bottom, fill in the blanks and hence complete the proof of the following statement using the axioms $[\\text{A}1]-[\\text{A}8]$ given below.\n\n*Statement: *\n\n*$0\\cdot 0=0$* \n\n*Proof:*\n\n$$\n\\begin{aligned}0\\cdot 0 & =0\\cdot 0 &  & [\\,\\text{given}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+1\\cdot 0 &  & [\\,\\text{axiom __}\\,\\,] \\\\ 0\\cdot 0 & =(0+1)\\cdot 0 &  & [\\,\\text{axiom A7}\\,] \\\\ 0\\cdot 0 & =1\\cdot 0 &  & [\\,\\text{addition of integers}\\,] \\\\ 0\\cdot 0 & =0 &  & [\\,\\text{axiom A5}\\,]\\end{aligned}\n$$\n\nThe axioms:\n\n$$\n\\begin{aligned}\\text{[A1]}:x+y=y+x & \\text{[A5]}:1\\cdot x=x \\\\ \\text{[A2]}:(x+y)+z=x+(y+z) & \\text{[A6]}:\\alpha (\\beta x)=(\\alpha \\beta )x \\\\ \\text{[A3]}:x+0=x & \\text{[A7]}:(\\alpha +\\beta )x=\\alpha x+\\beta x \\\\ \\text{[A4]}:x+(-x)=0 & \\text{[A8]}:\\alpha (x+y)=\\alpha x+\\alpha y\\end{aligned}\n$$" :question/worked-solution "Using the vector space axioms, we obtain the following: \n\n$$\n\\begin{aligned}0\\cdot 0 & =0\\cdot 0 &  & [\\,\\text{given}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+0 &  & [\\,\\text{axiom }\\text{A3}\\,] \\\\ 0\\cdot 0 & =0\\cdot 0+1\\cdot 0 &  & [\\,\\text{axiom }\\text{A5}\\,] \\\\ 0\\cdot 0 & =(0+1)\\cdot 0 &  & [\\,\\text{axiom A7}\\,] \\\\ 0\\cdot 0 & =1\\cdot 0 &  & [\\,\\text{addition of integers}\\,] \\\\ 0\\cdot 0 & =0 &  & [\\,\\text{axiom A5}\\,]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399600 :knowledge-point/_questions [{:knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "376a79e9-d0ed-5d98-b798-72ca9227f724" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,3,\\,2" :db/id #edb/ref 17592186399602} {:answer/id #uuid "4cd98211-258a-5e8b-9826-333a09416ffc" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,11,\\,9" :db/id #edb/ref 17592186399603} {:answer/id #uuid "e5de46c8-2b46-59f3-a61a-c8717e914bc4" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,5,\\,2" :db/id #edb/ref 17592186399604} {:answer/id #uuid "f7363fb5-4228-5670-abac-cfd957f39d4a" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,3,\\,9" :db/id #edb/ref 17592186399605} {:answer/id #uuid "b0ba1f0a-e0cd-5a53-91e0-55dc2a65a9d6" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,5,\\,9" :db/id #edb/ref 17592186399606}] :answer-field/correct {:answer/id #uuid "f7363fb5-4228-5670-abac-cfd957f39d4a" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,3,\\,9" :db/id #edb/ref 17592186399605} :answer-field/id #uuid "841df764-7b9e-514d-aafe-cc62e02035ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3e8fc64-f987-59d3-bd53-7963fa833f0a" :question/math-academy-id "q-106960" :question/problem "$$\n{{[\\begin{aligned}5 & -2 & 0 \\\\ -10 & 7 & 9 \\\\ 40 & -13 & 8\\end{aligned}]}_{⏟}}_{A}={{[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 8 & 1 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot {{[\\begin{aligned}5 & -2 & 0 \\\\ \\boxed{} & \\boxed{} & \\boxed{} \\\\ 0 & 0 & -1\\end{aligned}]}_{⏟}}_{U}.\n$$\n\nConsider the LU factorization of the matrix $A$ above. From left to right, what are the missing elements from the second row of the matrix $U?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make $0$ at the position ${a}_{21}$ of the matrix $A,$ we proceed as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}5 & -2 & 0 \\\\ -10 & 7 & 9 \\\\ 40 & -13 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}5 & -2 & 0 \\\\ 0 & 3 & 9 \\\\ 40 & -13 & 8\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, from left to right, the elements from the second row of $U$ are $0,3,$ and $9.$"}] [{:db/id #edb/ref 17592186399607 :knowledge-point/_questions [{:knowledge-point/id #uuid "6cd4158d-6baf-5a61-96a2-74c66231d082" :knowledge-point/title "Calculating the Eigenvalues of a Triangular/Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01f56157-c856-594f-bcca-b2f8da6f00bf" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =23$ (double root)" :db/id #edb/ref 17592186399609} {:answer/id #uuid "111cfb7a-0aa1-52bb-b913-fa8eeada729f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-8$ and $\\lambda =23$" :db/id #edb/ref 17592186399610} {:answer/id #uuid "3251384a-bd76-556b-bcfe-3f1aa78e11e9" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186399611} {:answer/id #uuid "55ef529b-1cb5-572b-ba1f-9971235a7825" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\lambda =23$" :db/id #edb/ref 17592186399612} {:answer/id #uuid "cea4ab75-7a00-54a6-a620-80a16ba62788" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\lambda =23$" :db/id #edb/ref 17592186399613}] :answer-field/correct {:answer/id #uuid "55ef529b-1cb5-572b-ba1f-9971235a7825" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\lambda =23$" :db/id #edb/ref 17592186399612} :answer-field/id #uuid "26e48940-3e05-56cb-b07f-bc8efe7f00fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399608}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6bc4edb2-a90d-543d-9659-c11413861acf" :question/math-academy-id "q-106999" :question/problem "Find all real eigenvalues of the matrix\n$N=[\\begin{aligned}23 & -8 \\\\ 0 & 0\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $N-\\lambda I:$\n﻿﻿﻿\n\n$$\nN-\\lambda I=[\\begin{aligned}23-\\lambda  & -8 \\\\ 0 & 0-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(N-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(N-\\lambda I) & =0 \\\\ |\\begin{aligned}23-\\lambda  & -8 \\\\ 0 & -\\lambda \\end{aligned}| & =0 \\\\ (23-\\lambda )(-\\lambda )-0\\cdot (-8) & =0 \\\\ \\lambda (\\lambda -23) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =0$ and $\\lambda =23.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."}] [{:db/id #edb/ref 17592186399614 :knowledge-point/_questions [{:knowledge-point/id #uuid "abef3da6-252e-51e4-b816-9ef7233b9a5d" :knowledge-point/title "Finding the Intersection Point of a Line in Vector Form and a Plane in Dot Product Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01df1bcb-4a7b-5150-ad54-aeccce8f3856" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5,2)" :db/id #edb/ref 17592186399616} {:answer/id #uuid "38c936a1-d976-513a-81ce-1b234231b7aa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,5,-4)" :db/id #edb/ref 17592186399617} {:answer/id #uuid "039d4336-0a52-5143-9cf6-0afb00570546" :answer/type {:db/ident :answer.type/math} :answer/value "(0,7,5)" :db/id #edb/ref 17592186399618} {:answer/id #uuid "663befe7-68ee-5370-a09d-addae6ba4a9d" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186399619} {:answer/id #uuid "012c8472-6cf0-52d5-b45e-45eeef9775df" :answer/type {:db/ident :answer.type/math} :answer/value "(3,1,-4)" :db/id #edb/ref 17592186399620}] :answer-field/correct {:answer/id #uuid "01df1bcb-4a7b-5150-ad54-aeccce8f3856" :answer/type {:db/ident :answer.type/math} :answer/value "(1,5,2)" :db/id #edb/ref 17592186399616} :answer-field/id #uuid "44bd467d-d957-573d-927f-7c7473314928" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "310a805e-d3a4-5eae-9540-0ee13a3dc212" :question/math-academy-id "q-108309" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨2,3,-1⟩+t⟨-1,2,3⟩,\\,Π:r\\cdot ⟨-2,1,4⟩=11.\n$$" :question/worked-solution "Let's write the equation of the line as\n\n$$\nr=⟨2-t,3+2t,-1+3t⟩.\n$$\n\nNow, substituting $r=⟨2-t,3+2t,-1+3t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-2,1,4⟩ & =11 \\\\ ⟨2-t,3+2t,-1+3t⟩\\cdot ⟨-2,1,4⟩ & =11 \\\\ -2(2-t)+1(3+2t)+4(-1+3t) & =11 \\\\ -4+2t+3+2t-4+12t & =11 \\\\ 16t & =16 \\\\ t & =1.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=1$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨2-1,3+2(1),-1+3(1)⟩ \\\\  & =⟨1,5,2⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(1,5,2).$"}] [{:db/id #edb/ref 17592186399621 :knowledge-point/_questions [{:knowledge-point/id #uuid "abef3da6-252e-51e4-b816-9ef7233b9a5d" :knowledge-point/title "Finding the Intersection Point of a Line in Vector Form and a Plane in Dot Product Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05af7225-4beb-5fce-9b53-b954446029e8" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-1,1)" :db/id #edb/ref 17592186399623} {:answer/id #uuid "8eed67c2-0aa3-5e76-b961-1c7f471f1326" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3,0)" :db/id #edb/ref 17592186399624} {:answer/id #uuid "0c95b6c8-08a8-5564-b42b-eddd5578aa82" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,5,-1)" :db/id #edb/ref 17592186399625} {:answer/id #uuid "b4bbb97f-13d1-5230-847b-f5130e3b18df" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186399626} {:answer/id #uuid "631fd696-26bf-5859-a6c1-43ab338d85a4" :answer/type {:db/ident :answer.type/math} :answer/value "(-8,7,-2)" :db/id #edb/ref 17592186399627}] :answer-field/correct {:answer/id #uuid "631fd696-26bf-5859-a6c1-43ab338d85a4" :answer/type {:db/ident :answer.type/math} :answer/value "(-8,7,-2)" :db/id #edb/ref 17592186399627} :answer-field/id #uuid "0dbc9dfe-4ec5-5030-8d6e-d34195de294f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399622}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e5fe668-3628-59a7-b261-da619f1e8497" :question/math-academy-id "q-108310" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-2,3,0⟩+t⟨3,-2,1⟩,\\,Π:r\\cdot ⟨4,1,-3⟩=-19.\n$$" :question/worked-solution "Let's write the equation of the line as\n\n$$\nr=⟨-2+3t,3-2t,t⟩.\n$$\n\nNow, substituting $r=⟨-2+3t,3-2t,t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,1,-3⟩ & =-19 \\\\ ⟨-2+3t,3-2t,t⟩\\cdot ⟨4,1,-3⟩ & =-19 \\\\ 4(-2+3t)+1(3-2t)-3t & =-19 \\\\ -8+12t+3-2t-3t & =-19 \\\\ 7t & =-14 \\\\ t & =-2.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=-2$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨-2+3(-2),3-2(-2),(-2)⟩ \\\\  & =⟨-8,7,-2⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(-8,7,-2).$"}] [{:db/id #edb/ref 17592186399628 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1bd5231-6855-55f3-a5ec-61c58423a2bb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1,9)" :db/id #edb/ref 17592186399630} {:answer/id #uuid "3a87675b-c089-5d14-9db0-504805f8a6af" :answer/type {:db/ident :answer.type/math} :answer/value "(2,3,3)" :db/id #edb/ref 17592186399631} {:answer/id #uuid "02bc6063-6eef-56d8-b50b-eec9ca9b7e38" :answer/type {:db/ident :answer.type/math} :answer/value "(4,4,0)" :db/id #edb/ref 17592186399632} {:answer/id #uuid "b949434a-7780-5a3d-b4d8-3bbde783f79d" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186399633} {:answer/id #uuid "44390ca7-20ca-5d21-b624-15837dd00ca6" :answer/type {:db/ident :answer.type/math} :answer/value "(8,6,-6)" :db/id #edb/ref 17592186399634}] :answer-field/correct {:answer/id #uuid "c1bd5231-6855-55f3-a5ec-61c58423a2bb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1,9)" :db/id #edb/ref 17592186399630} :answer-field/id #uuid "b8515a18-0ebe-5740-9abf-0e5d9167649f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "60f0cd70-b4b4-5b35-85ba-563cceee9aad" :question/math-academy-id "q-108326" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=6+2t \\\\ y=5+t \\\\ z=-3-3t\\end{aligned}\\,\\text{and}\\,Π:5x+3y-4z=-43.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}5x+3y-4z & =-43 \\\\ 5(6+2t)+3(5+t)-4(-3-3t) & =-43 \\\\ 30+10t+15+3t+12+12t & =-43 \\\\ 25t & =-100 \\\\ t & =-4\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-4$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=6+2(-4) \\\\ y=5+(-4) \\\\ z=-3-3(-4)\\end{aligned}\n$$\n\nSo, the intersection point is $P(-2,1,9).$"}]}
