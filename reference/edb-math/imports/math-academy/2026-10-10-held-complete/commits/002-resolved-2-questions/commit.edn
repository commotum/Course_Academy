33479 17592186045585 true] [17592186399815 1074 "Using the method of polynomial division, we obtain the following:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,4{x}^{2}+11x+45 \\\\  & x-4\\,\\,\\enclose{longdiv}{\\,\\,4{x}^{3}-5{x}^{2}+x-5\\,\\,} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{4{x}^{3}-16{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,11{x}^{2}+x-5 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{11{x}^{2}-44x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,45x-5 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,{45x-180}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,175\\end{aligned}\n$$\n\n \n\nTherefore, the missing expressions are \n\n$\\,$ $4{x}^{2}+11x+45\\,$ and $\\,11{x}^{2}+x-5.$" 13194139533479 17592186045585 true] [17592186399816 1075 #edb/ref 17592186399817 13194139533479 17592186045585 true] [17592186399816 1075 #edb/ref 17592186399818 13194139533479 17592186045585 true] [17592186399816 1075 #edb/ref 17592186399819 13194139533479 17592186045585 true] [17592186399816 1075 #edb/ref 17592186399820 13194139533479 17592186045585 true] [17592186399816 1075 #edb/ref 17592186399821 13194139533479 17592186045585 true] [17592186399816 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399816 1077 "selection" 13194139533479 17592186045585 true] [17592186399816 1079 #edb/ref 17592186399818 13194139533479 17592186045585 true] [17592186399816 1080 #uuid "0867db7a-c2e5-5027-95ed-b5d29db04306" 13194139533479 17592186045585 true] [17592186399817 1081 "$4{x}^{2}+10x+55\\,$ and $\\,9{x}^{2}+2x-5$" 13194139533479 17592186045585 true] [17592186399817 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399817 1084 #uuid "86d5db80-994e-5702-8c1d-e12a82935e1b" 13194139533479 17592186045585 true] [17592186399818 1081 "$4{x}^{2}+11x+45\\,$ and $\\,11{x}^{2}+x-5$" 13194139533479 17592186045585 true] [17592186399818 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399818 1084 #uuid "6ca4866b-d86b-545d-bf2a-54b1083ad0ac" 13194139533479 17592186045585 true] [17592186399819 1081 "$4{x}^{2}+11x-35\\,$ and $\\,11{x}^{2}-x-5$" 13194139533479 17592186045585 true] [17592186399819 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399819 1084 #uuid "f8d8695e-5196-5de3-8a7b-43fe3997211b" 13194139533479 17592186045585 true] [17592186399820 1081 "$4{x}^{2}+10x+45\\,$ and $\\,11{x}^{2}-x-5$" 13194139533479 17592186045585 true] [17592186399820 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399820 1084 #uuid "07b0d23d-ec2d-59ef-9ff0-7ee1b6fd0027" 13194139533479 17592186045585 true] [17592186399821 1081 "$4{x}^{2}-11x+45\\,$ and $\\,11{x}^{2}-2x-5$" 13194139533479 17592186045585 true] [17592186399821 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399821 1084 #uuid "27453f3a-03ff-59ee-9447-15e61177956e" 13194139533479 17592186045585 true] [17592186399822 1068 #edb/ref 17592186399823 13194139533479 17592186045585 true] [17592186399822 1069 "q-113767" 13194139533479 17592186045585 true] [17592186399822 1070 #edb/ref 17592186045487 13194139533479 17592186045585 true] [17592186399822 1071 "Given the function $f(x)=\\frac{{x}^{2}+1}{{e}^{x}},$ which of the following statements are true?" 13194139533479 17592186045585 true] [17592186399822 1072 #uuid "5d605cec-3072-5304-adcf-70f0f4b40d1d" 13194139533479 17592186045585 true] [17592186399822 1074 "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{2x{e}^{x}-({x}^{2}+1){e}^{x}}{{e}^{2x}} \\\\  & =-\\frac{{x}^{2}-2x+1}{{e}^{x}} \\\\  & =-\\frac{(x-1)^{2}}{{e}^{x}}.\\end{aligned}\n$$\n\nSolving ${f}^{′}(x)=0$ gives\n\n$$\n-\\frac{(x-1)^{2}}{{e}^{x}}\\,⟹\\,x=1.\n$$\n\nNote that we used the fact that ${e}^{x}>0$ for all values of $x.$\n\nSo, $x=1$ is the only stationary point of $f(x).$ Next, to determine whether this point is a local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=0,2$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-\\frac{(0-1)^{2}}{{e}^{0}}=-1<0 \\\\ {f}^{′}(2) & =-\\frac{(2-1)^{2}}{{e}^{2}}=-{e}^{-2}<0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(-\\infty ,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $0$ |  | $2$ |\n| ${f}^{′}$ | $-$ | $0$ | $-$ |\n| $f$ | $↘$ |  | $↘$ |\n\nThe first derivative does not change sign at $x=1.$ Therefore, we conclude that $x=1$ is neither a minimum nor a maximum.\n\nTherefore, the first derivative test shows that the function has no local extrema." 13194139533479 17592186045585 true] [17592186399823 1075 #edb/ref 17592186399824 13194139533479 17592186045585 true] [17592186399823 1075 #edb/ref 17592186399825 13194139533479 17592186045585 true] [17592186399823 1075 #edb/ref 17592186399826 13194139533479 17592186045585 true] [17592186399823 1075 #edb/ref 17592186399827 13194139533479 17592186045585 true] [17592186399823 1075 #edb/ref 17592186399828 13194139533479 17592186045585 true] [17592186399823 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399823 1077 "selection" 13194139533479 17592186045585 true] [17592186399823 1079 #edb/ref 17592186399826 13194139533479 17592186045585 true] [17592186399823 1080 #uuid "9f06b88a-0b3e-517c-8884-684e65abf6f2" 13194139533479 17592186045585 true] [17592186399824 1081 "There is a local minimum at $x=-1$" 13194139533479 17592186045585 true] [17592186399824 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399824 1084 #uuid "4d2b2d3d-bc75-52df-bb2c-abdcbe9305ba" 13194139533479 17592186045585 true] [17592186399825 1081 "There is a local minimum at $x=1$" 13194139533479 17592186045585 true] [17592186399825 1083 #e