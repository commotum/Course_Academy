0f740a2e2b94" 13194139533479 17592186045585 true] [17592186399852 1081 "$x=1$ only" 13194139533479 17592186045585 true] [17592186399852 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399852 1084 #uuid "76c31317-40e5-598b-9f1c-48b7b99ba737" 13194139533479 17592186045585 true] [17592186399853 1081 "$x=\\pm 1$ only" 13194139533479 17592186045585 true] [17592186399853 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399853 1084 #uuid "98942d10-5093-5b9e-b56e-6cb0c197d275" 13194139533479 17592186045585 true] [17592186399854 1081 "$x=-1$ only" 13194139533479 17592186045585 true] [17592186399854 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399854 1084 #uuid "94d7a6b5-dc7f-5665-8396-f95fbd37d4d2" 13194139533479 17592186045585 true] [17592186399855 1081 "$g(x)$ has no inflection points" 13194139533479 17592186045585 true] [17592186399855 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399855 1084 #uuid "1d987e38-5562-5ec2-8fa2-95ef362d9640" 13194139533479 17592186045585 true] [17592186399856 1068 #edb/ref 17592186399857 13194139533479 17592186045585 true] [17592186399856 1069 "q-115134" 13194139533479 17592186045585 true] [17592186399856 1070 #edb/ref 17592186045485 13194139533479 17592186045585 true] [17592186399856 1071 "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{36}=1?$" 13194139533479 17592186045585 true] [17592186399856 1072 #uuid "3113828e-6ca6-530b-804d-2cdc91aade73" 13194139533479 17592186045585 true] [17592186399856 1074 "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=49$ and ${b}^{2}=36.$\n\n- Since ${a}^{2}=49,$ the length of the horizontal radius must be $a=\\sqrt{49}=7.$\n\n- Since ${b}^{2}=36,$ the length of the vertical radius must be $b=\\sqrt{36}=6.$\n\nThus, the semi-major axis has length $a=7,$ and the semi-minor axis has length $b=6.$\n\nTherefore, the major axis has length $2a=2\\cdot 7=14,$ and the minor axis has length $2b=2\\cdot 6=12.$" 13194139533479 17592186045585 true] [17592186399857 1075 #edb/ref 17592186399858 13194139533479 17592186045585 true] [17592186399857 1075 #edb/ref 17592186399859 13194139533479 17592186045585 true] [17592186399857 1075 #edb/ref 17592186399860 13194139533479 17592186045585 true] [17592186399857 1075 #edb/ref 17592186399861 13194139533479 17592186045585 true] [17592186399857 1075 #edb/ref 17592186399862 13194139533479 17592186045585 true] [17592186399857 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399857 1077 "selection" 13194139533479 17592186045585 true] [17592186399857 1079 #edb/ref 17592186399860 13194139533479 17592186045585 true] [17592186399857 1080 #uuid "44102d96-20a4-51fc-add2-7a7a026df6ba" 13194139533479 17592186045585 true] [17592186399858 1081 "$28$ and $24$" 13194139533479 17592186045585 true] [17592186399858 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399858 1084 #uuid "d4ffa0ff-df0b-5bc5-b896-3f6772a35019" 13194139533479 17592186045585 true] [17592186399859 1081 "$24.5$ and $18$" 13194139533479 17592186045585 true] [17592186399859 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399859 1084 #uuid "e8f1177f-3e11-593f-ad9c-dda3299fba50" 13194139533479 17592186045585 true] [17592186399860 1081 "$14$ and $12$" 13194139533479 17592186045585 true] [17592186399860 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399860 1084 #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" 13194139533479 17592186045585 true] [17592186399861 1081 "$49$ and $36$" 13194139533479 17592186045585 true] [17592186399861 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399861 1084 #uuid "ee829b75-97f1-545e-8cf4-3704340f4ba1" 13194139533479 17592186045585 true] [17592186399862 1081 "$7$ and $6$" 13194139533479 17592186045585 true] [17592186399862 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399862 1084 #uuid "f8e390e1-9f85-5321-a954-3f147b97e82b" 13194139533479 17592186045585 true] [17592186399863 1068 #edb/ref 17592186399864 13194139533479 17592186045585 true] [17592186399863 1069 "q-115265" 13194139533479 17592186045585 true] [17592186399863 1070 #edb/ref 17592186045485 13194139533479 17592186045585 true] [17592186399863 1071 "The graph of the function $y=f(x)$ passes through $(1,2)$ and is concave up on the interval $(0,2).$ If ${f}^{′}(1)=-2,$ estimate the value of $f(0.8)$ using the tangent line approximation of $f(x)$ at $x=1$ and determine whether the approximation is an underestimate or overestimate." 13194139533479 17592186045585 true] [17592186399863 1072 #uuid "f5a82529-6969-5fb0-8f80-d44b22e50fb0" 13194139533479 17592186045585 true] [17592186399863 1074 "The tangent line approximation of $f(x)$ at the point $a=1$ is \n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(1)+{f}^{′}(1)(x-1).\\end{aligned}\n$$\n\nThe function passes through the point $(1,2),$ so we have $f(1)=2.$ Also, we're told that ${f}^{′}(1)=-2,$ so we get\n\n$$\n\\begin{aligned}L(x) & =2+(-2)(x-1) \\\\  & =2-2(x-1).\\end{aligned}\n$$\n\nWe can approximate $f(0.8)$ by evaluating the tangent line approximation at $x=0.8.$ We get\n\n$$\n\\begin{aligned}f(0.8) & ≈L(0.8) \\\\  & =2-2(0.8-1) \\\\  & =2-2(-0.2) \\\\  & =2.4.\\end{aligned}\n$$\n\nFinally, since the function is concave up on the interval $(0,2),$ the linear approximation $L(x)$ is below the graph close to $x=1,$ and therefore we have an underestimate." 13194139533479 17592186045585 true] [17592186399864 1075 #edb/ref 17592186399865 13194139533479 17592186045585 true] [17592186399864 1075 #edb/ref 17592186399866 13194139533479 17592186045585 true] [17592186399864 1075