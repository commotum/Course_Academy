 & =39 \\\\ (-3)(3+5t)+2(1+2t)-(-4+3t) & =39 \\\\ -9-15t+2+4t+4-3t & =39 \\\\ -14t & =42 \\\\ t & =-3.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-3$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨3+5(-3),1+2(-3),-4+3(-3)⟩ \\\\  & =⟨-12,-5,-13⟩.\\end{aligned}\n$$\n\nSo, we get $P(-12,-5,-13).$" 13194139533479 17592186045585 true] [17592186399657 1075 #edb/ref 17592186399658 13194139533479 17592186045585 true] [17592186399657 1075 #edb/ref 17592186399659 13194139533479 17592186045585 true] [17592186399657 1075 #edb/ref 17592186399660 13194139533479 17592186045585 true] [17592186399657 1075 #edb/ref 17592186399661 13194139533479 17592186045585 true] [17592186399657 1075 #edb/ref 17592186399662 13194139533479 17592186045585 true] [17592186399657 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399657 1077 "selection" 13194139533479 17592186045585 true] [17592186399657 1079 #edb/ref 17592186399660 13194139533479 17592186045585 true] [17592186399657 1080 #uuid "3cd4a0b3-55ce-54d3-98c8-8b7021d46e30" 13194139533479 17592186045585 true] [17592186399658 1081 "(13,7,2)" 13194139533479 17592186045585 true] [17592186399658 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399658 1084 #uuid "c181d54f-7b5e-5e40-b660-5db606239a3a" 13194139533479 17592186045585 true] [17592186399659 1081 "(8,3,-1)" 13194139533479 17592186045585 true] [17592186399659 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399659 1084 #uuid "7c2c2f01-60e6-5197-ae47-76dd272575a0" 13194139533479 17592186045585 true] [17592186399660 1081 "(-12,-5,-13)" 13194139533479 17592186045585 true] [17592186399660 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399660 1084 #uuid "100fc206-faa0-5c9a-8c1d-f828c27459ba" 13194139533479 17592186045585 true] [17592186399661 1081 "(-7,-3,-10)" 13194139533479 17592186045585 true] [17592186399661 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399661 1084 #uuid "a03ac96b-8e87-5579-959e-6059ecf3486c" 13194139533479 17592186045585 true] [17592186399662 1081 "No intersection" 13194139533479 17592186045585 true] [17592186399662 1083 #edb/ref 17592186045500 13194139533479 17592186045585 true] [17592186399662 1084 #uuid "d6d8eeca-91ef-5d44-a9a1-da7d1707ffce" 13194139533479 17592186045585 true] [17592186399663 1068 #edb/ref 17592186399664 13194139533479 17592186045585 true] [17592186399663 1069 "q-109158" 13194139533479 17592186045585 true] [17592186399663 1070 #edb/ref 17592186045486 13194139533479 17592186045585 true] [17592186399663 1071 "Find the general solution to the differential equation\n\n$$\n{x}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}={x}^{3}{y}^{2}+xy.\n$$" 13194139533479 17592186045585 true] [17592186399663 1072 #uuid "8cbfb9b8-f301-5858-97fc-1b90fa72d9ae" 13194139533479 17592186045585 true] [17592186399663 1074 "First, we rearrange the equation, as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & ={x}^{3}{y}^{2}+xy \\\\ {x}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}-xy & ={x}^{3}{y}^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}-\\frac{y}{x} & =x{y}^{2}\\end{aligned}\n$$\n\nNotice that our equation is an instance of the Bernoulli differential equation\n\n$$\n\\frac{dy}{dx}+p(x)y=q(x){y}^{n}.\n$$\n\nIn this case, we have\n\n$$\np(x)=-\\frac{1}{x},\\,q(x)=x,\\,n=2.\n$$\n\nNow, we divide the differential equation by ${y}^{2},$ and we get\n\n$$\n{y}^{-2}\\frac{dy}{dx}-\\frac{{y}^{-1}}{x}=x.\\,\\,(∗)\n$$\n\nThen, we make the substitution\n\n$$\nz={y}^{1-n}={y}^{-1}.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get \n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=-{y}^{-2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,{y}^{-2}\\frac{\\text{d}y}{\\text{d}x}=-\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\n \n\nTherefore, equation $(∗)$ can be written as a linear equation in $z(x)$ as follows:\n\n$$\n-\\,\\frac{\\text{d}z}{\\text{d}x}-\\frac{1}{x}z=x\n$$\n\nThis differential equation is linear, so we can use the method of integrating factors. But first, we write the above equation in standard form:\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}+\\frac{1}{x}z=-x\n$$\n\nThe above equation is now in the standard form\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}+P(x)z=Q(x),\n$$\n\nwith\n\n$$\n\\begin{aligned}P(x)=\\frac{1}{x},\\,Q(x)=-x\\,.\\end{aligned}\n$$\n\nWe then compute an integrating factor:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int (1/x)\\,\\text{d}x} \\\\  & ={e}^{\\operatorname{ln}⁡x} \\\\  & =x\\end{aligned}\n$$\n\nMultiplying both sides of the standard form equation by $I(x)=x$ yields\n\n$$\n\\begin{aligned}x\\cdot (\\frac{\\text{d}z}{\\text{d}x}+\\frac{1}{x}z) & =x\\cdot (-x) \\\\ x\\cdot \\frac{\\text{d}z}{\\text{d}x}+z & =-{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(xz) & =-{x}^{2}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(xz)\\,\\text{d}x & =-\\int {x}^{2}\\,\\text{d}x \\\\ xz & =-\\frac{{x}^{3}}{3}+{C}_{1} \\\\ z & =\\frac{C-{x}^{3}}{3x},\\end{aligned}\n$$\n\nwhere $C=3{C}_{1}.$\n\nFinally, we determine $y(x)$ by writing $z={y}^{-1}.$ This results in\n\n$$\n{y}^{-1}=\\frac{C-{x}^{3}}{3x}\\,⇒\\,y=\\frac{3x}{C-{x}^{3}}\\,.\n$$" 13194139533479 17592186045585 true] [17592186399664 1075 #edb/ref 17592186399665 13194139533479 17592186045585 true] [17592186399664 1075 #edb/ref 17592186399666 13194139533479 17592186045585 true] [17592186399664 1075 #edb/ref 17592186399667 13194139533479 17592186045585 true] [17592186399664 1075 #edb/ref 17592186399668 13194139533479 17592186045585 true] [17592186399664 1075 #edb/ref 17592186399669 13194139533479 17592186045585 true] [17592186399664 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399664 1077 "selection" 13194139533479 17592186045585 true] [17592186399664 1079 #edb/ref 17592186399666 13194139533479 17592186045585 true] [17592186399664 1080 #uuid "782ea541-65bb-5fe7-a7fe-a730b04302d9" 13194139533479 17592186045585 true] [17592186399665 1081 "y=\\frac{{x}^{3}}{C-x}" 13194139533479 17592186045585 true] [17592186399665 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399665 1084 #uuid "6773b545-4c85-529f-8c68-3b883278b649" 13194139533479 17592186045585 true] [17592186399666 1081 "y=\\frac{3x}{C-{x}^{3}}" 13194139533479 17592186045585 true] [17592186399666 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399666 1084 #uuid "f60a96fe-942a-5e12-a66c-9e48bde3cb0d" 13194139533479 17592186045585 true] [17592186399667 1081 "y=\\frac{3{x}^{2}}{C+2{x}^{3}}" 13194139533479 17592186045585 true] [17592186399667 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399667 1084 #uuid "fe66776a-5049-554f-b295-b90565404145" 13194139533479 17592186045585 true] [17592186399668 1081 "y=\\frac{{x}^{3}+C}{{x}^{2}}" 13194139533479 17592186045585 true] [17592186399668 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399668 1084 #uuid "e00a7e53-ea54-5b25-9e84-5594638cadcf" 13194139533479 17592186045585 true] [17592186399669 1081 "y=\\frac{x}{C-{x}^{2}}" 13194139533479 17592186045585 true] [17592186399669 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399669 1084 #uuid "f849933c-eec0-5349-a930-557222d316e5" 13194139533479 17592186045585 true] [17592186399670 1068 #edb/ref 17592186399671 13194139533479 17592186045585 true] [17592186399670 1069 "q-109302" 13194139533479 17592186045585 true] [17592186399670 1070 #edb/ref 17592186045487 13194139533479 17592186045585 true] [17592186399670 1071 "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=2{t}^{3}-9{t}^{2}+3t-2,\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." 13194139533479 17592186045585 true] [17592186399670 1072 #uuid "6414dac4-9443-5e38-b246-ae2ca315e478" 13194139533479 17592186045585 true] [17592186399670 1074 "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-9{t}^{2}+3t-2) \\\\  & =6{t}^{2}-18t+3\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-18t+3) \\\\  & =12t-18\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}12t-18 & =0 \\\\ t & =\\frac{18}{12} \\\\ t & =\\frac{3}{2}\\end{aligned}\n$$\n\nNow, the acceleration is zero when $t=\\frac{3}{2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(\\frac{3}{2}) & =6{(\\frac{3}{2})}^{2}-18(\\frac{3}{2})+3 \\\\  & =6(\\frac{9}{4})-27+3 \\\\  & =\\frac{27}{2}-27+3 \\\\  & =-\\frac{21}{2}\\end{aligned}\n$$" 13194139533479 17592186045585 true] [17592186399671 1075 #edb/ref 17592186399672 13194139533479 17592186045585 true] [17592186399671 1075 #edb/ref 17592186399673 13194139533479 17592186045585 true] [17592186399671 1075 #edb/ref 17592186399674 13194139533479 17592186045585 true] [17592186399671 1075 #edb/ref 17592186399675 13194139533479 17592186045585 true] [17592186399671 1075 #edb/ref 17592186399676 13194139533479 17592186045585 true] [17592186399671 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399671 1077 "selection" 13194139533479 17592186045585 true] [17592186399671 1079 #edb/ref 17592186399673 13194139533479 17592186045585 true] [17592186399671 1080 #uuid "689f3bd0-df18-5a92-92e6-a4a5162ad010" 13194139533479 17592186045585 true] [17592186399672 1081 "t=1,\\,v=\\frac{15}{2}" 13194139533479 17592186045585 true] [17592186399672 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399672 1084 #uuid "5103ad76-a94a-5286-8ba5-a77f53f60465" 13194139533479 17592186045585 true] [17592186399673 1081 "t=\\frac{3}{2},\\,v=-\\frac{21}{2}" 13194139533479 17592186045585 true] [17592186399673 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399673 1084 #uuid "8436223b-700a-5cfc-999b-c15dd1c4967a" 13194139533479 17592186045585 true] [17592186399674 1081 "t=1,\\,v=-7" 13194139533479 17592186045585 true] [17592186399674 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399674 1084 #uuid "48bbfde1-4a90-5800-90a2-a13b81b7ffae" 13194139533479 17592186045585 true] [17592186399675 1081 "t=\\frac{3}{2},\\,v=9" 13194139533479 17592186045585 true] [17592186399675 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399675 1084 #uuid "dbee7bb0-5392-5018-a5d9-d29c6d9994e1" 13194139533479 17592186045585 true] [17592186399676 1081 "t=\\frac{1}{2},\\,v=-\\frac{8}{3}" 13194139533479 17592186045585 true] [17592186399676 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399676 1084 #uuid "9445423e-a521-575c-b99b-639347c58fec" 13194139533479 17592186045585 true] [17592186399677 1068 #edb/ref 17592186399678 13194139533479 17592186045585 true] [17592186399677 1069 "q-109307" 13194139533479 17592186045585 true] [17592186399677 1070 #edb/ref 17592186045487 13194139533479 17592186045585 true] [17592186399677 1071 "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=7{t}^{2}-{t}^{3},\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." 13194139533479 17592186045585 true] [17592186399677 1072 #uuid "7704a427-55d1-5f8e-bf57-d941d8544127" 13194139533479 17592186045585 true] [17592186399677 1074 "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(7{t}^{2}-{t}^{3}) \\\\  & =14t-3{t}^{2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(14t-3{t}^{2}) \\\\  & =14-6t\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}14-6t & =0 \\\\ -6t & =-14 \\\\ t & =\\frac{7}{3}\\end{aligned}\n$$\n\nNow, the acceleration is zero when $t=\\frac{7}{3}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v(\\frac{7}{3}) & =14(\\frac{7}{3})-3{(\\frac{7}{3})}^{2} \\\\  & =\\frac{98}{3}-\\frac{49}{3} \\\\  & =\\frac{49}{3}\\end{aligned}\n$$" 13194139533479 17592186045585 true] [17592186399678 1075 #edb/ref 17592186399679 13194139533479 17592186045585 true] [17592186399678 1075 #edb/ref 17592186399680 13194139533479 17592186045585 true] [17592186399678 1075 #edb/ref 17592186399681 13194139533479 17592186045585 true] [17592186399678 1075 #edb/ref 17592186399682 13194139533479 17592186045585 true] [17592186399678 1075 #edb/ref 17592186399683 13194139533479 17592186045585 true] [17592186399678 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399678 1077 "selection" 13194139533479 17592186045585 true] [17592186399678 1079 #edb/ref 17592186399681 13194139533479 17592186045585 true] [17592186399678 1080 #uuid "1669c4fe-448a-5ecd-96c2-60941d083824" 13194139533479 17592186045585 true] [17592186399679 1081 "t=\\frac{3}{2},\\,v=-\\frac{9}{2}" 13194139533479 17592186045585 true] [17592186399679 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399679 1084 #uuid "e1f8e3ed-64ac-534b-9097-97dd33f2545d" 13194139533479 17592186045585 true] [17592186399680 1081 "t=2,\\,v=-4" 13194139533479 17592186045585 true] [17592186399680 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399680 1084 #uuid "106f9321-de03-58f4-8540-f31885a755c3" 13194139533479 17592186045585 true] [17592186399681 1081 "t=\\frac{7}{3},\\,v=\\frac{49}{3}" 13194139533479 17592186045585 true] [17592186399681 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399681 1084 #uuid "084bda93-d0d6-514b-b8c7-73ce821b2053" 13194139533479 17592186045585 true] [17592186399682 1081 "t=2,\\,v=6" 13194139533479 17592186045585 true] [17592186399682 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399682 1084 #uuid "367c159c-f8cf-54ab-9cdc-cfddc4ed2a5b" 13194139533479 17592186045585 true] [17592186399683 1081 "t=\\frac{7}{3},\\,v=\\frac{15}{6}" 13194139533479 17592186045585 true] [17592186399683 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399683 1084 #uuid "212ea060-615f-5258-8e09-ac350ea1ca59" 13194139533479 17592186045585 true] [17592186399684 1068 #edb/ref 17592186399685 13194139533479 17592186045585 true] [17592186399684 1069 "q-109639" 13194139533479 17592186045585 true] [17592186399684 1070 #edb/ref 17592186045485 13194139533479 17592186045585 true] [17592186399684 1071 "The second-order initial value problem\n\n$$\n{y}^{″}-4{e}^{t}{y}^{′}+5y=0,\\,y(0)=2,\\,{y}^{′}(0)=-1\n$$\n\ncan be written as a system of first-order differential equations, as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2},\\, & {x}_{1}(0)=p \\\\ {x}_{2}^{′}=f(t),\\, & {x}_{2}(0)=q\\end{aligned}\n$$\n\nwhere ${x}_{1}(t)=y(t),$ ${x}_{2}(t)={y}^{′}(t),$ and $p$ and $q$ are constants. Calculate  $(p-q)\\cdot f(t).$" 13194139533479 17592186045585 true] [17592186399684 1072 #uuid "ebf9231a-650d-5b8c-8818-efc1d0c42664" 13194139533479 17592186045585 true] [17592186399684 1074 "First, we make the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =y \\\\ {x}_{2}(t) & ={y}^{′}.\\end{aligned}\n$$\n\nWe also convert the initial conditions, as follows:\n\n$$\n\\begin{aligned}y(0) & ={x}_{1}(0)=2 \\\\ {y}^{′}(0) & ={x}_{2}(0)=-1\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′}(t) & ={y}^{′} \\\\ {x}_{2}^{′}(t) & ={y}^{″}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={y}^{″}.\\end{aligned}\n$$\n\nAt this point, we're almost done. We just need to write the right-hand side of the last equation in terms of ${x}_{1}$ and ${x}_{2}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{″}),$ we obtain\n\n$$\n{y}^{″}=4{e}^{t}{y}^{′}-5y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{″}=4{e}^{t}{x}_{2}-5{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2},\\, & {x}_{1}(0)=2 \\\\ {x}_{2}^{′}=-5{x}_{1}+4{e}^{t}{x}_{2},\\, & {x}_{2}(0)=-1\\end{aligned}\n$$\n\nFinally, $p=2,q=-1,f(t)=-5{x}_{1}+4{x}_{2},$ and \n\n$$\n\\begin{aligned}(p-q)\\cdot f(t) & =(2-(-1))(-5{x}_{1}+4{e}^{t}{x}_{2}) \\\\  & =3(-5{x}_{1}+4{e}^{t}{x}_{2}) \\\\  & =-15{x}_{1}+12{e}^{t}{x}_{2}).\\end{aligned}\n$$" 13194139533479 17592186045585 true] [17592186399685 1075 #edb/ref 17592186399686 13194139533479 17592186045585 true] [17592186399685 1075 #edb/ref 17592186399687 13194139533479 17592186045585 true] [17592186399685 1075 #edb/ref 17592186399688 13194139533479 17592186045585 true] [17592186399685 1075 #edb/ref 17592186399689 13194139533479 17592186045585 true] [17592186399685 1075 #edb/ref 17592186399690 13194139533479 17592186045585 true] [17592186399685 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399685 1077 "selection" 13194139533479 17592186045585 true] [17592186399685 1079 #edb/ref 17592186399686 13194139533479 17592186045585 true] [17592186399685 1080 #uuid "8605a456-8f74-549b-ba68-da660540b8c0" 13194139533479 17592186045585 true] [17592186399686 1081 "-15{x}_{1}+12{e}^{t}{x}_{2}" 13194139533479 17592186045585 true] [17592186399686 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399686 1084 #uuid "af7079ea-861b-500c-9d7f-1e6deedf2499" 13194139533479 17592186045585 true] [17592186399687 1081 "15{e}^{t}{x}_{1}-12{x}_{2}" 13194139533479 17592186045585 true] [17592186399687 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399687 1084 #uuid "6b240488-157e-59e5-bed1-15811d8bfd83" 13194139533479 17592186045585 true] [17592186399688 1081 "12{x}_{1}-15{e}^{t}{x}_{2}" 13194139533479 17592186045585 true] [17592186399688 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399688 1084 #uuid "0a2b02a7-5e76-599c-b59b-0e2513d27664" 13194139533479 17592186045585 true] [17592186399689 1081 "-8{e}^{t}{x}_{1}+10{x}_{2}" 13194139533479 17592186045585 true] [17592186399689 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399689 1084 #uuid "b2a5f6c5-4aef-5b2b-b492-7a62db70e223" 13194139533479 17592186045585 true] [17592186399690 1081 "5{x}_{1}-4{e}^{t}{x}_{2}" 13194139533479 17592186045585 true] [17592186399690 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399690 1084 #uuid "9224e1b1-aac6-5da0-9fca-0ec4d20218c5" 13194139533479 17592186045585 true] [17592186399691 1068 #edb/ref 17592186399692 13194139533479 17592186045585 true] [17592186399691 1069 "q-110078" 13194139533479 17592186045585 true] [17592186399691 1070 #edb/ref 17592186045485 13194139533479 17592186045585 true] [17592186399691 1071 "![](images/39/3905dacc3977857933a48ced329fc245b357f732aec520e67998efc0b5d7cdab.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" 13194139533479 17592186045585 true] [17592186399691 1072 #uuid "b9a72356-7e05-5f10-b6ac-a2418c3b4fa6" 13194139533479 17592186045585 true] [17592186399691 1074 "Consider the line $x+2y=-8.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-\\frac{1}{2}x-4.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -\\frac{1}{2}x-4,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+2y\\ge -8.\n$$\n\nNow consider the line $y=\\frac{1}{2}x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le \\frac{1}{2}x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1.\\end{aligned}\n$$" 13194139533479 17592186045585 true] [17592186399692 1075 #edb/ref 17592186399693 13194139533479 17592186045585 true] [17592186399692 1075 #edb/ref 17592186399694 13194139533479 17592186045585 true] [17592186399692 1075 #edb/ref 17592186399695 13194139533479 17592186045585 true] [17592186399692 1075 #edb/ref 17592186399696 13194139533479 17592186045585 true] [17592186399692 1075 #edb/ref 17592186399697 13194139533479 17592186045585 true] [17592186399692 1076 #edb/ref 17592186045493 13194139533479 17592186045585 true] [17592186399692 1077 "selection" 13194139533479 17592186045585 true] [17592186399692 1079 #edb/ref 17592186399697 13194139533479 17592186045585 true] [17592186399692 1080 #uuid "fce68956-d8ec-5373-80c1-0576c6b35476" 13194139533479 17592186045585 true] [17592186399693 1081 "{\\begin{aligned}x+2y\\le -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" 13194139533479 17592186045585 true] [17592186399693 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399693 1084 #uuid "84a02541-33c6-5f69-a920-35696f66c170" 13194139533479 17592186045585 true] [17592186399694 1081 "{\\begin{aligned}x+2y>-8 \\\\ y>\\frac{1}{2}x+1\\end{aligned}" 13194139533479 17592186045585 true] [17592186399694 1083 #edb/ref 17592186045499 13194139533479 17592186045585 true] [17592186399694 108