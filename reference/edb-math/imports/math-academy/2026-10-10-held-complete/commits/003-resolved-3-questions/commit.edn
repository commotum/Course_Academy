6045585 true] [17592186400018 1084 #uuid "3e99f652-e012-503c-97ae-9e43e478b1cb" 13194139533480 17592186045585 true] [17592186400019 1081 "I and III only" 13194139533480 17592186045585 true] [17592186400019 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400019 1084 #uuid "c83a4309-acbf-5679-9e28-465cf4e9d799" 13194139533480 17592186045585 true] [17592186400020 1081 "I only" 13194139533480 17592186045585 true] [17592186400020 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400020 1084 #uuid "6f833c32-c9f2-5bff-b68d-05c9a5598f8c" 13194139533480 17592186045585 true] [17592186400021 1081 "III only" 13194139533480 17592186045585 true] [17592186400021 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400021 1084 #uuid "8444d1db-6a27-52c8-bd42-58d682c3d6b1" 13194139533480 17592186045585 true] [17592186400022 1081 "I and II only" 13194139533480 17592186045585 true] [17592186400022 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400022 1084 #uuid "68a0723d-e0c2-5c94-b776-962ebe8b99f2" 13194139533480 17592186045585 true] [17592186400023 1068 #edb/ref 17592186400024 13194139533480 17592186045585 true] [17592186400023 1069 "q-120778" 13194139533480 17592186045585 true] [17592186400023 1070 #edb/ref 17592186045487 13194139533480 17592186045585 true] [17592186400023 1071 "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=12-3{t}^{2},$ where $t>0$ is the time  in seconds. If the particle has velocity $v=15\\,\\text{m}/\\text{s}$ when $t=1\\,\\text{s},$ calculate the maximum velocity ${v}_{\\text{max}}$ of the particle and determine the time when the particle reaches its maximum velocity." 13194139533480 17592186045585 true] [17592186400023 1072 #uuid "a883694e-b003-511e-8990-ce136a285dc8" 13194139533480 17592186045585 true] [17592186400023 1074 "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 12-3{t}^{2} & =0 \\\\ 3(2-t)(2+t) & =0 \\\\ t & =\\pm 2.\\end{aligned}\n$$\n\nSince $t>0,$ the extremum of the velocity function occurs when $t=2\\,\\text{s}.$\n\nWe now test the extreme value using the second derivative test. For this, we find the second derivative of $v(t)$ and evaluate it at $t=2:$\n\n$$\n\\begin{aligned}{v}^{″}(t) & =\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\text{d}v}{\\text{d}t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(12-3{t}^{2}) \\\\  & =-6t \\\\ {v}^{″}(2) & =-6(2) \\\\  & =-12\\end{aligned}\n$$\n\nSince ${v}^{″}(2)<0,$ we conclude that the velocity is maximized when $t=2\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (12-3{t}^{2})\\text{d}t \\\\  & =12t-{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(1)=15.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}12(1)-(1)^{3}+C & =15 \\\\ 11+C & =15\\,⟹\\,C=4.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=4+12t-{t}^{3}.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(2)=4+12(2)-(2)^{3}=20\\,\\text{m}/\\text{s}\n$$" 13194139533480 17592186045585 true] [17592186400024 1075 #edb/ref 17592186400025 13194139533480 17592186045585 true] [17592186400024 1075 #edb/ref 17592186400026 13194139533480 17592186045585 true] [17592186400024 1075 #edb/ref 17592186400027 13194139533480 17592186045585 true] [17592186400024 1075 #edb/ref 17592186400028 13194139533480 17592186045585 true] [17592186400024 1075 #edb/ref 175921864