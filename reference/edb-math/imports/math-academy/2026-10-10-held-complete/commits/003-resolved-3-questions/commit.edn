 /2}\\sqrt{(-5\\operatorname{sin}⁡(5t))^{2}+(6\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" 13194139533480 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400094 13194139533480 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400095 13194139533480 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400096 13194139533480 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400097 13194139533480 17592186045585 true] [17592186400093 1075 #edb/ref 17592186400098 13194139533480 17592186045585 true] [17592186400093 1076 #edb/ref 17592186045493 13194139533480 17592186045585 true] [17592186400093 1077 "selection" 13194139533480 17592186045585 true] [17592186400093 1079 #edb/ref 17592186400098 13194139533480 17592186045585 true] [17592186400093 1080 #uuid "065d677c-9998-56e4-8b57-ce841d04bf36" 13194139533480 17592186045585 true] [17592186400094 1081 "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(5t)+36\\operatorname{cos}⁡(6t)}\\,\\text{d}t" 13194139533480 17592186045585 true] [17592186400094 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400094 1084 #uuid "221b2a78-3ed9-5fcc-a904-b72ed2d8cda6" 13194139533480 17592186045585 true] [17592186400095 1081 "2{\\int }_{0}^{\\pi /2}\\sqrt{5{sin}^{2}⁡(5t)+6{cos}^{2}⁡(t)}\\,\\text{d}t" 13194139533480 17592186045585 true] [17592186400095 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400095 1084 #uuid "2037ceca-da9b-5e6c-99af-f9e9635c71f9" 13194139533480 17592186045585 true] [17592186400096 1081 "{\\int }_{0}^{\\pi /2}\\sqrt{10{sin}^{2}⁡(5t)+12{cos}^{2}⁡(t)}\\,\\text{d}t" 13194139533480 17592186045585 true] [17592186400096 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400096 1084 #uuid "f6282b39-25dd-527c-8c08-c5ccbd4d5888" 13194139533480 17592186045585 true] [17592186400097 1081 "{\\int }_{0}^{\\pi /2}\\sqrt{25\\operatorname{sin}⁡(t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" 13194139533480 17592186045585 true] [17592186400097 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400097 1084 #uuid "3954ccd4-113c-522e-8865-af8dedf5924f" 13194139533480 17592186045585 true] [17592186400098 1081 "{\\int }_{0}^{\\pi /2}\\sqrt{25{sin}^{2}⁡(5t)+36{cos}^{2}⁡(t)}\\,\\text{d}t" 13194139533480 17592186045585 true] [17592186400098 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400098 1084 #uuid "5f536300-dcae-55c0-9423-568faa002b3a" 13194139533480 17592186045585 true] [17592186400099 1068 #edb/ref 17592186400100 13194139533480 17592186045585 true] [17592186400099 1069 "q-123315" 13194139533480 17592186045585 true] [17592186400099 1070 #edb/ref 17592186045485 13194139533480 17592186045585 true] [17592186400099 1071 "Which of the following sequences diverge?\n\nI. ${a}_{n}=\\frac{{n}^{5}}{2{n}^{5}-1}$ for $n\\ge 1$\nII. ${a}_{n}=\\frac{n-{n}^{5}}{2-{n}^{4}}$ for $n\\ge 1$\nIII. ${a}_{n}=\\frac{5}{{n}^{6}}$ for $n\\ge 1$" 13194139533480 17592186045585 true] [17592186400099 1072 #uuid "4187c6ec-17d9-5b83-9a20-6aff01cc94de" 13194139533480 17592186045585 true] [17592186400099 1074 "Let's analyze each sequence in turn. We need to calculate the limit of each sequence as $n$ approaches infinity.\n\n- In sequence I,  the dominant term in the denominator is $2{n}^{5},$ so we divide the numerator and the denominator by ${n}^{5}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{{n}^{5}}{2{n}^{5}-1} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{{n}^{5}}{{n}^{5}})}{(\\frac{2{n}^{5}}{{n}^{5}}-\\frac{1}{{n}^{5}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{1}{(2-\\frac{1}{{n}^{5}})} \\\\  & =\\frac{1}{2-0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence II, the dominant term in the denominator is $-{n}^{4},$ so we divide the numerator and the denominator by ${n}^{4}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{n-{n}^{5}}{2-{n}^{4}} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{n}{{n}^{4}}-\\frac{{n}^{5}}{{n}^{4}})}{(\\frac{2}{{n}^{4}}-\\frac{{n}^{4}}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{1}{{n}^{3}}-n)}{(\\frac{2}{{n}^{4}}-1)} \\\\  & ={lim}_{n\\to \\infty }\\frac{0-n}{0-1} \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges.\n\n- In sequence III,  the limit is\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{5}{{n}^{6}}=0.\n$$\n\nThe limit exists, so the sequence converges.\n\nIn conclusion, sequence II diverges." 13194139533480 17592186045585 true] [17592186400100 1075 #edb/ref 17592186400101 13194139533480 17592186045585 true] [17592186400100 1075 #edb/ref 17592186400102 13194139533480 17592186045585 true] [17592186400100 1075 #edb/ref 17592186400103 13194139533480 17592186045585 true] [17592186400100 1075 #edb/ref 17592186400104 13194139533480 17592186045585 true] [17592186400100 1075 #edb/ref 17592186400105 13194139533480 17592186045585 true] [17592186400100 1076 #edb/ref 17592186045493 13194139533480 17592186045585 true] [17592186400100 1077 "selection" 13194139533480 17592186045585 true] [17592186400100 1079 #edb/ref 17592186400105 13194139533480 17592186045585 true] [17592186400100 1080 #uuid "3fa5013e-ecbb-5612-b808-2ece59956c79" 13194139533480 17592186045585 true] [17592186400101 1081 "II and III only" 13194139533480 17592186045585 true] [17592186400101 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400101 1084 #uuid "ecdf47cc-f0cb-56b3-84ca-bee8e2b8bfe4" 13194139533480 17592186045585 true] [17592186400102 1081 "I only" 13194139533480 17592186045585 true] [17592186400102 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400102 1084 #uuid "8dbe54b5-3db6-5098-b2a3-f74e2eac1a0a" 13194139533480 17592186045585 true] [17592186400103 1081 "None" 13194139533480 17592186045585 true] [17592186400103 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400103 1084 #uuid "11b9ceb7-9605-5fd8-a9d6-37030667401b" 13194139533480 17592186045585 true] [17592186400104 1081 "I and II only" 13194139533480 17592186045585 true] [17592186400104 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400104 1084 #uuid "4243a661-e4ea-5bc4-a52d-96a26f5bb3ae" 13194139533480 17592186045585 true] [17592186400105 1081 "II only" 13194139533480 17592186045585 true] [17592186400105 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400105 1084 #uuid "28ee4859-be0f-5573-bbed-f85800832371" 13194139533480 17592186045585 true] [17592186400106 1068 #edb/ref 17592186400107 13194139533480 17592186045585 true] [17592186400106 1069 "q-123331" 13194139533480 17592186045585 true] [17592186400106 1070 #edb/ref 17592186045487 13194139533480 17592186045585 true] [17592186400106 1071 "What is the limit of the sequence ${a}_{n}=\\frac{({n}^{3}+1)({n}^{3}-1)}{n(2-n)}$ for $n>2?$" 13194139533480 17592186045585 true] [17592186400106 1072 #uuid "8d56bb6b-dd41-54d2-8847-130e4a93bbfc" 13194139533480 17592186045585 true] [17592186400106 1074 "First, we multiply out the numerator and denominator of the sequence and get\n\n$$\n{a}_{n}=\\frac{({n}^{3}+1)({n}^{3}-1)}{n(2-n)}=\\frac{{n}^{6}-1}{2n-{n}^{2}}.\n$$\n\nSo to find the limit, we will need to compute\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{{n}^{6}-1}{2n-{n}^{2}}.\n$$\n\nThe dominant term in the denominator is $-{n}^{2},$ so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }\\frac{{n}^{6}-1}{2n-{n}^{2}} & ={lim}_{n\\to \\infty }\\frac{(\\frac{{n}^{6}}{{n}^{2}}-\\frac{1}{{n}^{2}})}{(\\frac{2n}{{n}^{2}}-\\frac{{n}^{2}}{{n}^{2}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{({n}^{4}-\\frac{1}{{n}^{2}})}{(\\frac{2}{n}-1)} \\\\  & ={lim}_{n\\to \\infty }\\frac{{n}^{4}-0}{0-1} \\\\  & =-\\infty .\\end{aligned}\n$$\n\nConsequently, the sequence diverges." 13194139533480 17592186045585 true] [17592186400107 1075 #edb/ref 17592186400108 13194139533480 17592186045585 true] [17592186400107 1075 #edb/ref 17592186400109 13194139533480 17592186045585 true] [17592186400107 1075 #edb/ref 17592186400110 13194139533480 17592186045585 true] [17592186400107 1075 #edb/ref 17592186400111 13194139533480 17592186045585 true] [17592186400107 1075 #edb/ref 17592186400112 13194139533480 17592186045585 true] [17592186400107 1076 #edb/ref 17592186045493 13194139533480 17592186045585 true] [17592186400107 1077 "selection" 13194139533480 17592186045585 true] [17592186400107 1079 #edb/ref 17592186400112 13194139533480 17592186045585 true] [17592186400107 1080 #uuid "e7cccdfc-23c3-5334-80a8-20fa60433aa3" 13194139533480 17592186045585 true] [17592186400108 1081 "-\\frac{1}{2}" 13194139533480 17592186045585 true] [17592186400108 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400108 1084 #uuid "484017d2-f86d-53d7-ba7b-17877ef8618f" 13194139533480 17592186045585 true] [17592186400109 1081 "1" 13194139533480 17592186045585 true] [17592186400109 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400109 1084 #uuid "f6d356bc-0293-5d2b-8823-146a5682e27a" 13194139533480 17592186045585 true] [17592186400110 1081 "0" 13194139533480 17592186045585 true] [17592186400110 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400110 1084 #uuid "32df7dc7-96c6-574d-a78c-a84f8f49fddb" 13194139533480 17592186045585 true] [17592186400111 1081 "-1" 13194139533480 17592186045585 true] [17592186400111 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400111 1084 #uuid "4cbf65d1-e958-54ce-8140-5842c29862df" 13194139533480 17592186045585 true] [17592186400112 1081 "The sequence diverges" 13194139533480 17592186045585 true] [17592186400112 1083 #edb/ref 17592186045500 13194139533480 17592186045585 true] [17592186400112 1084 #uuid "f8888596-d7ab-5567-adcf-d438bdbdd0fe" 13194139533480 17592186045585 true] [17592186400113 1068 #edb/ref 17592186400114 13194139533480 17592186045585 true] [17592186400113 1069 "q-123519" 13194139533480 17592186045585 true] [17592186400113 1070 #edb/ref 17592186045487 13194139533480 17592186045585 true] [17592186400113 1071 "Which of the following is equivalent to ${\\int }_{C}\\,\\text{d}s,$ where $C$ is the path along the polar curve $r=\\sqrt{1-\\operatorname{cos}⁡\\theta }\\,$ for $-\\frac{\\pi }{2}\\le \\theta \\le \\frac{\\pi }{2}$ ?" 13194139533480 17592186045585 true] [17592186400113 1072 #uuid "ffdfd696-312e-58bb-aa35-858898cb0c00" 13194139533480 17592186045585 true] [17592186400113 1074 "The line integral of unity with respect to arc length over $C$ is equal to the arc length $L$ of $C,$ i.e.,\n\n$$\n{\\int }_{C}\\,\\text{d}s=L.\n$$\n\nIn polar coordinates, the arc length element $\\text{d}s$ is given by\n\n$$\n\\text{d}s=\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSo, for a polar curve defined as $r=r(\\theta )$ for ${\\theta }_{1}\\le \\theta \\le {\\theta }_{2},$ we have\n\n$$\nL={\\int }_{C}\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\sqrt{1-\\operatorname{cos}⁡\\theta }\\,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=\\frac{\\operatorname{sin}⁡\\theta }{2\\sqrt{1-\\operatorname{cos}⁡\\theta }}.\n$$\n\nTherefore, the expression for our line integral is\n\n$$\n\\begin{aligned}{\\int }_{C}\\,\\text{d}s & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{{(\\sqrt{1-\\operatorname{cos}⁡\\theta })}^{2}+{(\\frac{\\operatorname{sin}⁡\\theta }{2\\sqrt{1-\\operatorname{cos}⁡\\theta }})}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{(1-\\operatorname{cos}⁡\\theta )+\\frac{{sin}^{2}⁡\\theta }{4(1-\\operatorname{cos}⁡\\theta )}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{\\frac{4(1-\\operatorname{cos}⁡\\theta )^{2}+(1-{cos}^{2}⁡\\theta )}{4(1-\\operatorname{cos}⁡\\theta )}}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{\\frac{(1-\\operatorname{cos}⁡\\theta )(4-4\\operatorname{cos}⁡\\theta +1+\\operatorname{cos}⁡\\theta )}{1-\\operatorname{cos}⁡\\theta }}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{5-3\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" 13194139533480 17592186045585 true] [17592186400114 1075 #edb/ref 17592186400115 13194139533480 17592186045585 true] [17592186400114 1075 #edb/ref 17592186400116 13194139533480 17592186045585 true] [17592186400114 1075 #edb/ref 17592186400117 13194139533480 17592186045585 true] [17592186400114 1075 #edb/ref 17592186400118 13194139533480 17592186045585 true] [17592186400114 1075 #edb/ref 17592186400119 13194139533480 17592186045585 true] [17592186400114 1076 #edb/ref 17592186045493 13194139533480 17592186045585 true] [17592186400114 1077 "selection" 13194139533480 17592186045585 true] [17592186400114 1079 #edb/ref 17592186400118 13194139533480 17592186045585 true] [17592186400114 1080 #uuid "4bff7a0b-d96e-5598-95de-cbbd3ac2a012" 13194139533480 17592186045585 true] [17592186400115 1081 "\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(5+3\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta " 13194139533480 17592186045585 true] [17592186400115 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400115 1084 #uuid "04289a9d-17cf-573a-9701-d41c64ef2496" 13194139533480 17592186045585 true] [17592186400116 1081 "{\\int }_{-\\pi /2}^{\\pi /2}\\sqrt{6-5\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " 13194139533480 17592186045585 true] [17592186400116 1083 #edb/ref 17592186045499 13194139533480 17592186045585 true] [17592186400116 1084 #uuid