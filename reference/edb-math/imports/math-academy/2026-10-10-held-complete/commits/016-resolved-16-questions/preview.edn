139533493 17592186045585 true] [17592186403604 1081 "y={(\\frac{1}{2})}^{x}+2" 13194139533493 17592186045585 true] [17592186403604 1083 #edb/ref 17592186045499 13194139533493 17592186045585 true] [17592186403604 1084 #uuid "cdf02042-68e8-57bc-821d-c4e709f6e6d5" 13194139533493 17592186045585 true] [17592186403605 1068 #edb/ref 17592186403606 13194139533493 17592186045585 true] [17592186403605 1069 "q-72913" 13194139533493 17592186045585 true] [17592186403605 1070 #edb/ref 17592186045487 13194139533493 17592186045585 true] [17592186403605 1071 "Calculate the points where the ellipse $2{x}^{2}+3{y}^{2}-20x+6y+47=0$ intercepts the $x$-axis." 13194139533493 17592186045585 true] [17592186403605 1072 #uuid "3538d2b4-fd15-5d04-9456-067812f7d246" 13194139533493 17592186045585 true] [17592186403605 1074 "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}2{x}^{2}+3{y}^{2}-20x+6y+47 & =0 \\\\ 2{x}^{2}+3(0)^{2}-20x+6(0)+47 & =0 \\\\ 2{x}^{2}-20x+47 & =0 \\\\ 2[{x}^{2}-10x]+47 & =0 \\\\ 2[(x-5)^{2}-25]+47 & =0 \\\\ 2(x-5)^{2}-50+47 & =0 \\\\ 2(x-5)^{2} & =3 \\\\ (x-5)^{2} & =\\frac{3}{2} \\\\ x-5 & =\\pm \\sqrt{\\frac{3}{2}} \\\\ x & =5\\pm \\sqrt{\\frac{3}{2}}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(5-\\sqrt{\\frac{3}{2}},0)$ and $(5+\\sqrt{\\frac{3}{2}},0).$" 13194139533493 17592186045585 true] [17592186403606 1075 #edb/ref 17592186403607 13194139533493 17592186045585 true] [17592186403606 1075 #edb/ref 17592186403608 13194139533493 17592186045585 true] [17592186403606 1075 #edb/ref 17592186403609 13194139533493 17592186045585 true] [17592186403606 1075 #edb/ref 17592186403610 13194139533493 17592186045585 true] [17592186403606 1075 #edb/ref 17592186403611 13194139533493 17592186045585 true] [17592186403606 1076 #edb/ref 17592186045493 13194139533493 17592186045585 true] [17592186403606 1077 "selection" 13194139533493 17592186045585 true] [17592186403606 1079 #edb/ref 17592186403607 13194139533493 17592186045585 true] [17592186403606 1080 #uuid "629087fb-db7f-51a8-827b-0862fb389bb9" 13194139533493 17592186045585 true] [17592186403607 1081 "(5\\pm \\sqrt{\\frac{3}{2}},0)" 13194139533493 17592186045585 true] [17592186403607 1083 #edb/ref 17592186045499 13194139533493 17592186045585 true] [17592186403607 1084 #uuid "ef8edbea-4da2-562c-be95-1803e0e50af8" 13194139533493 17592186045585 true] [17592186403608 1081 "(10\\pm \\frac{3\\sqrt{2}}{2},0)" 13194139533493 17592186045585 true] [17592186403608 1083 #edb/ref 17592186045499 13194139533493 17592186045585 true] [17592186403608 1084 #uuid "e45d242e-ec58-51d9-b98e-0c301509d596" 13194139533493 17592186045585 true] [17592186403609 1081 "There is no $x$-intercept" 13194139533493 17592186045585 true] [17592186403609 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403609 1084 #uuid "9141967a-e95f-5916-97f3-21bd825b34c3" 13194139533493 17592186045585 true] [17592186403610 1081 "(5\\pm \\frac{\\sqrt{3}}{2},0)" 13194139533493 17592186045585 true] [17592186403610 1083 #edb/ref 17592186045499 13194139533493 17592186045585 true] [17592186403610 1084 #uuid "3903afea-29b9-5179-b7c5-dc45513572f2" 13194139533493 17592186045585 true] [17592186403611 1081 "(10\\pm \\frac{\\sqrt{3}}{2},0)" 13194139533493 17592186045585 true] [17592186403611 1083 #edb/ref 17592186045499 13194139533493 17592186045585 true] [17592186403611 1084 #uuid "88c9f761-6944-512d-b426-301b6d2b5ff0" 13194139533493 17592186045585 true] [17592186403612 1068 #edb/ref 17592186403613 13194139533493 17592186045585 true] [17592186403612 1069 "q-72934" 13194139533493 17592186045585 true] [17592186403612 1070 #edb/ref 17592186045487 13194139533493 17592186045585 true] [17592186403612 1071 "Determine  the lengths of the major and minor axes of the ellipse whose equation is ${x}^{2}+4{y}^{2}-4x+16y=-16.$" 13194139533493 17592186045585 true] [17592186403612 1072 #uuid "a0bc6070-452c-59d7-b850-234ba4c8bcd8" 13194139533493 17592186045585 true] [17592186403612 1074 "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-4x+16y & =-16 \\\\ ({x}^{2}-4x)+(4{y}^{2}+16y) & =-16\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-4x)+(4{y}^{2}+16y) & =-16 \\\\ ({x}^{2}-4x)+4({y}^{2}+4y) & =-16 \\\\ [(x-2)^{2}-4]+4[(y+2)^{2}-4] & =-16 \\\\ (x-2)^{2}-4+4(y+2)^{2}-16 & =-16\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-2)^{2}-4+4(y+2)^{2}-16 & =-16 \\\\ (x-2)^{2}+4(y+2)^{2} & =-16+16+4 \\\\ (x-2)^{2}+4(y+2)^{2} & =4 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y+2)^{2}}{1} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y+2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2>1,$ the length of the major axis is $2\\cdot 2=4,$ and the length of the minor axis is $2\\cdot 1=2.$" 13194139533493 17592186045585 true] [17592186403613 1075 #edb/ref 17592186403614 13194139533493 17592186045585 true] [17592186403613 1075 #edb/ref 17592186403615 13194139533493 17592186045585 true] [17592186403613 1075 #edb/ref 17592186403616 13194139533493 17592186045585 true] [17592186403613 1075 #edb/ref 17592186403617 13194139533493 17592186045585 true] [17592186403613 1075 #edb/ref 17592186403618 13194139533493 17592186045585 true] [17592186403613 1076 #edb/ref 17592186045493 13194139533493 17592186045585 true] [17592186403613 1077 "selection" 13194139533493 17592186045585 true] [17592186403613 1079 #edb/ref 17592186403617 13194139533493 17592186045585 true] [17592186403613 1080 #uuid "66032e6a-59fa-5bca-a1f1-2d6e69a901e8" 13194139533493 17592186045585 true] [17592186403614 1081 "$4$ and $1$" 13194139533493 17592186045585 true] [17592186403614 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403614 1084 #uuid "7c381e28-47d1-516c-ba70-7941c1b4c573" 13194139533493 17592186045585 true] [17592186403615 1081 "$8$ and $4$" 13194139533493 17592186045585 true] [17592186403615 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403615 1084 #uuid "c7ab0ed2-8c80-5ee7-ad45-3c43ece3b795" 13194139533493 17592186045585 true] [17592186403616 1081 "$8$ and $2$" 13194139533493 17592186045585 true] [17592186403616 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403616 1084 #uuid "e0ac736d-0463-57d0-9db1-2a7177ddc558" 13194139533493 17592186045585 true] [17592186403617 1081 "$4$ and $2$" 13194139533493 17592186045585 true] [17592186403617 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403617 1084 #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" 13194139533493 17592186045585 true] [17592186403618 1081 "$2$ and $1$" 13194139533493 17592186045585 true] [17592186403618 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403618 1084 #uuid "cfd845e5-ca89-50e3-8d11-42ad65bcd599" 13194139533493 17592186045585 true] [17592186403619 1068 #edb/ref 17592186403620 13194139533493 17592186045585 true] [17592186403619 1069 "q-73190" 13194139533493 17592186045585 true] [17592186403619 1070 #edb/ref 17592186045487 13194139533493 17592186045585 true] [17592186403619 1071 "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." 13194139533493 17592186045585 true] [17592186403619 1072 #uuid "fc3f69db-faba-5b23-aeec-3cea350fe1f0" 13194139533493 17592186045585 true] [17592186403619 1074 "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$" 13194139533493 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403621 13194139533493 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403622 13194139533493 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403623 13194139533493 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403624 13194139533493 17592186045585 true] [17592186403620 1075 #edb/ref 17592186403625 13194139533493 17592186045585 true] [17592186403620 1076 #edb/ref 17592186045493 13194139533493 17592186045585 true] [17592186403620 1077 "selection" 13194139533493 17592186045585 true] [17592186403620 1079 #edb/ref 17592186403622 13194139533493 17592186045585 true] [17592186403620 1080 #uuid "d82b2d36-5f6d-5949-984e-5d1d9ec7556d" 13194139533493 17592186045585 true] [17592186403621 1081 "$(0,0,0)$ and $(2,0,0)$" 13194139533493 17592186045585 true] [17592186403621 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403621 1084 #uuid "adcb33db-de68-50f5-9cbe-6b7d8f84aaae" 13194139533493 17592186045585 true] [17592186403622 1081 "$(-2,0,0)$ and $(4,0,0)$" 13194139533493 17592186045585 true] [17592186403622 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403622 1084 #uuid "ee548906-3638-5d51-96d2-b358b4a1f8b6" 13194139533493 17592186045585 true] [17592186403623 1081 "$(-4,0,0)$ and $(4,0,0)$" 13194139533493 17592186045585 true] [17592186403623 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403623 1084 #uuid "81a50ee6-a29f-5cf2-ba44-251758623d8b" 13194139533493 17592186045585 true] [17592186403624 1081 "$(4,0,0)$ only" 13194139533493 17592186045585 true] [17592186403624 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403624 1084 #uuid "ef09c53b-97f7-594e-a8f7-fee68af6a063" 13194139533493 17592186045585 true] [17592186403625 1081 "$(-3\\sqrt{2},0,0)$ and $(3\\sqrt{2},0,0)$" 13194139533493 17592186045585 true] [17592186403625 1083 #edb/ref 17592186045500 13194139533493 17592186045585 true] [17592186403625 1084 #uuid "b4640bb5-2749-5d8c-bb08-ee4349a6f316" 13194139533493 17592186045585 true] [17592186403626 1068 #edb/ref 17592186403627 13194139533493 17592186045585 true] [17592186403626 1069 "q-73210" 13194139533493 17592186045585 true] [17592186403626 1070 #edb/ref 17592186045487 13194139533493 17592186045585 true] [17592186403626 1071 "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=t{e}^{-2t}$, where $t\\ge 0$ is the time, measured in seconds. Find the time intervals in which the particle is moving in the direction of increasing $x.$" 13194139533493 17592186045585 true] [17592186403626 1072 #uuid "08503449-abde-5746-b6d7-46180193efed" 13194139533493 17592186045585 true] [17592186403626 1074 "If the particle moves in the direction of increasing $x,$ then its velocity is positive. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t{e}^{-2t}) \\\\  & ={e}^{-2t}(1-2t)\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of increasing $x$, we solve $v(t)>0:$\n\n$$\n\\begin{aligned}v(t) & >0 \\\\ {e}^{-2t}(1-2t) & >0 \\\\ 1-2t & >0 \\\\ 2t & <1 \\\\ t & <\\frac{1}{2}\\end{aligned}\n$$\n\nHence, the time interval in which the particle is moving to the direction of increasing $x$ is $t\\in [0,\\frac{1}{2}).$" 13194139533493 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403628 13194139533493 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403629 13194139533493 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403630 13194139533493 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403631 13194139533493 17592186045585 true] [17592186403627 1075 #edb/ref 17592186403632 13194139533