& 1\\end{aligned}| \\\\  & =4|\\begin{aligned}2 & 3 \\\\ -1 & 1\\end{aligned}|-2|\\begin{aligned}1 & 3 \\\\ -2 & 1\\end{aligned}|-1|\\begin{aligned}1 & 2 \\\\ -2 & -1\\end{aligned}| \\\\  & =4(2+3)-2(1+6)-1(-1+4) \\\\  & =4\\cdot 5-2\\cdot 7-1\\cdot 3 \\\\  & =20-14-3 \\\\  & =3\\end{aligned}\n$$\n\n \n\nSince $det(T)=3\\ne 0$, the matrix is **not** singular. \n\nTherefore, only statement III is true." 13194139533492 17592186045585 true] [17592186403342 1075 #edb/ref 17592186403343 13194139533492 17592186045585 true] [17592186403342 1075 #edb/ref 17592186403344 13194139533492 17592186045585 true] [17592186403342 1075 #edb/ref 17592186403345 13194139533492 17592186045585 true] [17592186403342 1075 #edb/ref 17592186403346 13194139533492 17592186045585 true] [17592186403342 1075 #edb/ref 17592186403347 13194139533492 17592186045585 true] [17592186403342 1076 #edb/ref 17592186045493 13194139533492 17592186045585 true] [17592186403342 1077 "selection" 13194139533492 17592186045585 true] [17592186403342 1079 #edb/ref 17592186403345 13194139533492 17592186045585 true] [17592186403342 1080 #uuid "05d568df-a773-5610-b6f1-a54dd33cdd03" 13194139533492 17592186045585 true] [17592186403343 1081 "II and III only" 13194139533492 17592186045585 true] [17592186403343 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403343 1084 #uuid "4785662b-0e80-5d82-a4b6-65ed19a1e5b5" 13194139533492 17592186045585 true] [17592186403344 1081 "I only" 13194139533492 17592186045585 true] [17592186403344 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403344 1084 #uuid "67f02759-121c-50a3-ba4c-f3f827ec1037" 13194139533492 17592186045585 true] [17592186403345 1081 "III only" 13194139533492 17592186045585 true] [17592186403345 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403345 1084 #uuid "2757e4c4-8529-58e9-af0a-851f146d1b34" 13194139533492 17592186045585 true] [17592186403346 1081 "I and II only" 13194139533492 17592186045585 true] [17592186403346 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403346 1084 #uuid "c536ca24-85a3-52eb-b210-bc09f11e7748" 13194139533492 17592186045585 true] [17592186403347 1081 "II only" 13194139533492 17592186045585 true] [17592186403347 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403347 1084 #uuid "817109bb-c334-57d7-996b-d026c9e54f89" 13194139533492 17592186045585 true] [17592186403348 1068 #edb/ref 17592186403349 13194139533492 17592186045585 true] [17592186403348 1069 "q-70184" 13194139533492 17592186045585 true] [17592186403348 1070 #edb/ref 17592186045487 13194139533492 17592186045585 true] [17592186403348 1071 "Calculate the points where the ellipse ${x}^{2}+9{y}^{2}+4x+54y+76=0$ intercepts the $x$-axis." 13194139533492 17592186045585 true] [17592186403348 1072 #uuid "59316311-32d9-5b38-a573-15e21c936803" 13194139533492 17592186045585 true] [17592186403348 1074 "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+9{y}^{2}+4x+54y+76 & =0 \\\\ {x}^{2}+9\\cdot {0}^{2}+4x+54\\cdot 0+76 & =0 \\\\ {x}^{2}+4x+76 & =0 \\\\ (x+2)^{2}-4+76 & =0 \\\\ (x+2)^{2}+72 & =0 \\\\ (x+2)^{2} & =-72.\\end{aligned}\n$$\n\nSince $(x+2)^{2}\\ge 0$, there is no $x$ such that $(x+2)^{2}=-72.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point." 13194139533492 17592186045585 true] [17592186403349 1075 #edb/ref 17592186403350 13194139533492 17592186045585 true] [17592186403349 1075 #edb/ref 17592186403351 13194139533492 17592186045585 true] [17592186403349 1075 #edb/ref 17592186403352 13194139533492 17592186045585 true] [17592186403349 1075 #edb/ref 17592186403353 13194139533492 17592186045585 true] [17592186403349 1075 #edb/ref 17592186403354 13194139533492 17592186045585 true] [17592186403349 1076 #edb/ref 17592186045493 13194139533492 17592186045585 true] [17592186403349 1077 "selection" 13194139533492 17592186045585 true] [17592186403349 1079 #edb/ref 17592186403351 13194139533492 17592186045585 true] [17592186403349 1080 #uuid "9e096da9-0f95-5ade-b790-a678ba6390cc" 13194139533492 17592186045585 true] [17592186403350 1081 "(\\pm 6\\sqrt{2},0)" 13194139533492 17592186045585 true] [17592186403350 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403350 1084 #uuid "7c1bbae5-ee9d-5107-904f-6970a8ac3118" 13194139533492 17592186045585 true] [17592186403351 1081 "There is no $x$-intercept" 13194139533492 17592186045585 true] [17592186403351 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403351 1084 #uuid "8465821e-9ea7-5368-9666-8f226d3419ef" 13194139533492 17592186045585 true] [17592186403352 1081 "(-2-6\\sqrt{2},0)" 13194139533492 17592186045585 true] [17592186403352 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403352 1084 #uuid "25ff9425-9a2f-590b-afc0-b4d1c3a9a722" 13194139533492 17592186045585 true] [17592186403353 1081 "(-6\\sqrt{2},0)" 13194139533492 17592186045585 true] [17592186403353 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403353 1084 #uuid "ce1f047f-812c-57ba-bcb0-cbcaa0662d30" 13194139533492 17592186045585 true] [17592186403354 1081 "(-2\\pm 6\\sqrt{2},0)" 13194139533492 17592186045585 true] [17592186403354 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403354 1084 #uuid "fd29b37b-8dc3-5dc5-a940-4e57bf4082c3" 13194139533492 17592186045585 true] [17592186403355 1068 #edb/ref 17592186403356 13194139533492 17592186045585 true] [17592186403355 1069 "q-70185" 13194139533492 17592186045585 true] [17592186403355 1070 #edb/ref 17592186045485 13194139533492 17592186045585 true] [17592186403355 1071 "Determine the points where the ellipse $4{x}^{2}+{y}^{2}-8x-4y=8$ intercepts the $y$-axis." 13194139533492 17592186045585 true] [17592186403355 1072 #uuid "bb24f0ce-8ec6-592f-8577-163f3821ff7d" 13194139533492 17592186045585 true] [17592186403355 1074 "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-4y & =8 \\\\ 4\\cdot {0}^{2}+{y}^{2}-8\\cdot 0-4y & =8 \\\\ {y}^{2}-4y & =8 \\\\ (y-2)^{2}-4 & =8 \\\\ (y-2)^{2} & =8+4 \\\\ (y-2)^{2} & =12 \\\\ x-2 & =\\pm 2\\sqrt{3} \\\\ x & =2\\pm 2\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at $(0,2-2\\sqrt{3})$ and $(0,2+2\\sqrt{3}).$" 13194139533492 17592186045585 true] [17592186403356 1075 #edb/ref 17592186403357 13194139533492 17592186045585 true] [17592186403356 1075 #edb/ref 17592186403358 13194139533492 17592186045585 true] [17592186403356 1075 #edb/ref 17592186403359 13194139533492 17592186045585 true] [17592186403356 1075 #edb/ref 17592186403360 13194139533492 17592186045585 true] [17592186403356 1075 #edb/ref 17592186403361 13194139533492 17592186045585 true] [17592186403356 1076 #edb/ref 17592186045493 13194139533492 17592186045585 true] [17592186403356 1077 "selection" 13194139533492 17592186045585 true] [17592186403356 1079 #edb/ref 17592186403357 13194139533492 17592186045585 true] [17592186403356 1080 #uuid "95684ce7-0099-5fec-8c6e-29f3ec84dc36" 13194139533492 17592186045585 true] [17592186403357 1081 "(0,2\\pm 2\\sqrt{3})" 13194139533492 17592186045585 true] [17592186403357 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403357 1084 #uuid "b9a9fd67-307c-5267-8145-f7345da1670e" 13194139533492 17592186045585 true] [17592186403358 1081 "(0,1\\pm 4\\sqrt{3})" 13194139533492 17592186045585 true] [17592186403358 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403358 1084 #uuid "e1be8d15-da88-5d38-9ea2-b30ea374905b" 13194139533492 1759218604