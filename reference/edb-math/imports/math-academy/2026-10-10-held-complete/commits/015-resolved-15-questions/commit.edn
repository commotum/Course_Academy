frac{1}{2})=3 \\\\ y=2(\\frac{1}{2})=1 \\\\ z=2(\\frac{1}{2})=1,\\end{aligned}\n$$\n\nso the second point is $(3,1,1).$\n\nTherefore, the points of intersection are $(-3,-1,-1)$ and $(3,1,1).$" 13194139533492 17592186045585 true] [17592186403454 1075 #edb/ref 17592186403455 13194139533492 17592186045585 true] [17592186403454 1075 #edb/ref 17592186403456 13194139533492 17592186045585 true] [17592186403454 1075 #edb/ref 17592186403457 13194139533492 17592186045585 true] [17592186403454 1075 #edb/ref 17592186403458 13194139533492 17592186045585 true] [17592186403454 1075 #edb/ref 17592186403459 13194139533492 17592186045585 true] [17592186403454 1076 #edb/ref 17592186045493 13194139533492 17592186045585 true] [17592186403454 1077 "selection" 13194139533492 17592186045585 true] [17592186403454 1079 #edb/ref 17592186403455 13194139533492 17592186045585 true] [17592186403454 1080 #uuid "3d0d2f96-6d7a-588d-b004-73302eb57f1e" 13194139533492 17592186045585 true] [17592186403455 1081 "$(-3,-1,-1)$ and $(3,1,1)$" 13194139533492 17592186045585 true] [17592186403455 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403455 1084 #uuid "5e35151e-94c1-5a28-86f9-d1e5c5cea37b" 13194139533492 17592186045585 true] [17592186403456 1081 "$(3,1,1)$ only" 13194139533492 17592186045585 true] [17592186403456 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403456 1084 #uuid "4ce65dfe-c619-537f-bd0a-0601aac378d9" 13194139533492 17592186045585 true] [17592186403457 1081 "$(\\frac{3}{2},-\\frac{1}{2},-\\frac{1}{2})$ and $(\\frac{3}{2},\\frac{1}{2},\\frac{1}{2})$" 13194139533492 17592186045585 true] [17592186403457 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [17592186403457 1084 #uuid "50390114-a2aa-5b09-ac89-67aac491ce67" 13194139533492 17592186045585 true] [17592186403458 1081 "$(3,-1,1)$ and $(-3,1,-1)$" 13194139533492 17592186045585 true] [17592186403458 1083 #edb/ref 17592186045500 13194139533492 17592186045585 true] [1759