3470 1081 "y={(\\frac{1}{3})}^{x}-3" 13194139533492 17592186045585 true] [17592186403470 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403470 1084 #uuid "dc7c1d24-77af-5b22-8748-eb78e3181bee" 13194139533492 17592186045585 true] [17592186403471 1081 "y={(\\frac{1}{3})}^{x}" 13194139533492 17592186045585 true] [17592186403471 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403471 1084 #uuid "ac8a280a-f3e5-57ca-a313-b4a7d3f28178" 13194139533492 17592186045585 true] [17592186403472 1081 "y={(\\frac{1}{3})}^{x}+3" 13194139533492 17592186045585 true] [17592186403472 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403472 1084 #uuid "2e259bca-b084-538c-98c1-c8f9fb1db908" 13194139533492 17592186045585 true] [17592186403473 1081 "y={(\\frac{1}{3})}^{x}-2" 13194139533492 17592186045585 true] [17592186403473 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403473 1084 #uuid "54400882-3ae8-5fef-9856-f37d1e3a6878" 13194139533492 17592186045585 true] [17592186403474 1068 #edb/ref 17592186403475 13194139533492 17592186045585 true] [17592186403474 1069 "q-71407" 13194139533492 17592186045585 true] [17592186403474 1070 #edb/ref 17592186045487 13194139533492 17592186045585 true] [17592186403474 1071 "Find a vector equation of the normal line to the surface $z=2{x}^{2}+2{y}^{2}+x$ at the point $(\\frac{1}{2},1,3).$" 13194139533492 17592186045585 true] [17592186403474 1072 #uuid "ca7dad4d-8007-5c21-9019-38d66b5366c7" 13194139533492 17592186045585 true] [17592186403474 1074 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}z & =2{x}^{2}+2{y}^{2}+x \\\\ z-2{x}^{2}-2{y}^{2}-x & =0\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=z-2{x}^{2}-2{y}^{2}-x$, our surface can be viewed as the level surface $f(x,y,z)=0.$ \n\nA normal vector to the level surface that passes through the point $(\\frac{1}{2},1,3)$ can be found by computing $∇f(\\frac{1}{2},1,3).$ \n\nSo, we find the gradient and evaluate it at $(\\frac{1}{2},1,3):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(z-2{x}^{2}-2{y}^{2}-x)i+\\frac{∂}{∂y}(z-2{x}^{2}-2{y}^{2}-x)j+\\frac{∂}{∂z}(z-2{x}^{2}-2{y}^{2}-x)k \\\\  & =(-4x-1)\\text{ }i-4y\\text{ }j+k \\\\ ∇f(\\frac{1}{2},1,3) & =(-4(\\frac{1}{2})-1)\\,i-4(1)\\text{ }j+k \\\\  & =-3\\,i-4\\,j+k \\\\  & =⟨-3,-4,1⟩\\end{aligned}\n$$\n\nFinally, the vector equation of the line that is parallel to $∇f(\\frac{1}{2},1,3)$ and passes through the point $(\\frac{1}{2},1,3)$ can be written as\n\n$$\n\\begin{aligned}r & =⟨\\frac{1}{2},1,3⟩+t\\,∇f(\\frac{1}{2},1,3)=⟨\\frac{1}{2},1,3⟩+t\\,⟨-3,-4,1⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$" 13194139533492 17592186045585 true] [17592186403475 1075 #edb/ref 17592186403476 13194139533492 17592186045585 true] [17592186403475 1075 #edb/ref 17592186403477 13194139533492 17592186045585 true] [17592186403475 1075 #edb/ref 17592186403478 13194139533492 17592186045585 true] [17592186403475 1075 #edb/ref 17592186403479 13194139533492 17592186045585 true] [17592186403475 1075 #edb/ref 17592186403480 13194139533492 17592186045585 true] [17592186403475 1076 #edb/ref 17592186045493 13194139533492 17592186045585 true] [17592186403475 1077 "selection" 13194139533492 17592186045585 true] [17592186403475 1079 #edb/ref 17592186403480 13194139533492 17592186045585 true] [17592186403475 1080 #uuid "3a86f3ea-971f-5c0c-ab0d-7a86359ca0e2" 13194139533492 17592186045585 true] [17592186403476 1081 "r=⟨-3,-4,1⟩+t\\,⟨\\frac{1}{2},1,3⟩" 13194139533492 17592186045585 true] [17592186403476 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403476 1084 #uuid "74e84be6-fb21-5888-bde0-2b1fc8861800" 13194139533492 17592186045585 true] [17592186403477 1081 "r=⟨3,-4,1⟩+t\\,⟨\\frac{1}{2},1,3⟩" 13194139533492 17592186045585 true] [17592186403477 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403477 1084 #uuid "125b86ba-8a17-5cc7-bb9b-688c88040c9a" 13194139533492 17592186045585 true] [17592186403478 1081 "r=⟨\\frac{1}{2},1,3⟩+t\\,⟨3,4,1⟩" 13194139533492 17592186045585 true] [17592186403478 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403478 1084 #uuid "a563a551-487d-52b0-b121-65d93d53f35f" 13194139533492 17592186045585 true] [17592186403479 1081 "r=⟨\\frac{1}{2},1,3⟩+t\\,⟨3,-4,1⟩" 13194139533492 17592186045585 true] [17592186403479 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403479 1084 #uuid "74e61dbd-b0b0-51fb-aee1-a797c08c8fb2" 13194139533492 17592186045585 true] [17592186403480 1081 "r=⟨\\frac{1}{2},1,3⟩+t\\,⟨-3,-4,1⟩" 13194139533492 17592186045585 true] [17592186403480 1083 #edb/ref 17592186045499 13194139533492 17592186045585 true] [17592186403480 1084 #uuid "65d0bd41-c0f7-5813-a9d5-53b92a3b0d8a" 13194139533492 17592186045585 true] [17592186403481 1068 #edb/ref 17592186403482 13194139533492 17592186045585 true] [17592186403481 1069 "q-71474" 13194139533492 17592186045585 true] [17592186403481 1070 #edb/ref 17592186045486 13194139533492 17592186045585 true] [17592186403481 1071 "Given that $f(x,y,z)=\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z$, find the points $(x,y,z)$ where $∇f(x,y,z)=0.$" 13194139533492 17592186045585 true] [17592186403481 1072 #uuid "c503ae86-f71f-5a21-9c90-e19ce4d410a1" 13194139533492 17592186045585 true] [17592186403481 1074 "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{{x}^{2}y}+0-\\frac{1}{z{x}^{2}}-0 \\\\  & =-\\frac{z+y}{{x}^{2}yz} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{x{y}^{2}}-\\frac{1}{{y}^{2}}+0-0 \\\\  & =-\\frac{1+x}{x{y}^{2}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =0+0-\\frac{1}{{z}^{2}x}-1 \\\\  & =-\\frac{1+{z}^{2}x}{{z}^{2}x}\\end{aligned}\n$$\n\nHence, $∇f(x,y,z)=-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k.$ \n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficient of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}=0 \\\\ -\\frac{1+x}{x{y}^{2}}=0 \\\\ -\\frac{1+{z}^{2}x}{{z}^{2}x}=0\\end{aligned}\n$$\n\nFrom the second equation, we get $x=-1.$ Substituting these into the third equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{1+{z}^{2}x}{{z}^{2}x} & =0 \\\\ -\\frac{1+{z}^{2}(-1)}{{z}^{2}(-1)} & =0 \\\\ 1-{z}^{2} & =0 \\\\ {z}^{2} & =1 \\\\ z & =\\pm 1\\end{aligned}\n$$\n\nSubstituting $x=-1$ into the first equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{z+y}{(-1)^{2}yz} & =0 \\\\ z+y & =0 \\\\ y & =-z\\end{aligned}\n$$\n\nWhen $z=1,$ we have $y=-1$ and when $z=-1,$ we have $y=1.$\n\nHence, $∇f(x,y,z)=0$ at two points: $(-1,-1,1)$ and $(-1,1,-1).$" 13194139533492 17592186045585 true] [17592186403482 1075 #edb/ref 17592186403483 13194139533492 17592186045585 true] [17592186403482 1075 #edb/ref 17592186403484 13194139533492 17592186045585 true] [17592186403482 1075 #edb/ref 17592186403485 13194139533492 17592186045585 true] [17592186403482 1075 #edb/ref 17592186403486 13194139533492 17592186045585 true] [17592186403482 1075 #edb/ref 17592186403487 13194139533492 17592186045585 true] [17592186403482 1076 #edb/ref 17592186045493 13194139533492 17592186045585 true] [17592186403482 1077 "selection" 13194139533492 17592186045585 true] [17592186403482 1079 #edb/ref 17592186403485 13194139533492 17592186045585 true] [17592186403482 1080 #uuid "ca042fa0-0bbe-58d3-8050-de243a925b8d" 13194139533492 17592186045585 true] [17592186403483 1081 "$(-1,-1,1)$ only" 13194139533492 17592186045585 true] [17592186403483 1083 #edb/ref 17592186045500 13194139533492 17