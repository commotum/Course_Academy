#{[{:db/id #edb/ref 17592186129532 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b4a31c6-01be-5b15-88f5-9150f350e944" :knowledge-point/title "Determining the Critical Points of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ecd82e-c85b-5221-81f4-5aa437d23a7f" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the $vw-$plane." :db/id #edb/ref 17592186401296} {:answer/id #uuid "1680c5f5-1c51-52cd-a03a-ad30d3c07c77" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the parabolic cylinder $u=2{w}^{2}.$" :db/id #edb/ref 17592186401297} {:answer/id #uuid "92c1139b-4ea6-5a6e-91ff-1cd1ee2688f2" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the plane $u=2v.$" :db/id #edb/ref 17592186401298} {:answer/id #uuid "9ea440aa-4bbc-5828-a750-3ec0ce76a35d" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the parabolic cylinder $u=-{w}^{2}.$" :db/id #edb/ref 17592186401299} {:answer/id #uuid "b1928d32-8a83-5bc0-a68f-3b8d2a17bd07" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the plane $u=w.$" :db/id #edb/ref 17592186401300}] :answer-field/correct {:answer/id #uuid "9ea440aa-4bbc-5828-a750-3ec0ce76a35d" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the parabolic cylinder $u=-{w}^{2}.$" :db/id #edb/ref 17592186401299} :answer-field/id #uuid "17caa721-6c88-5948-86f1-24aa0f77f9b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "685e989d-8721-5a8c-a4d8-0e44efe4bc9b" :question/math-academy-id "q-161819" :question/problem "Find the locations of all of the critical points of the transformation $T,$ where $T$ is defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}{u}^{2}-{w}^{2} \\\\ w{e}^{u} \\\\ u-v\\end{aligned}].\n$$" :question/worked-solution "For a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]\\to [\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y,z)}{∂(u,v,w)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} & \\frac{∂x}{∂w} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v} & \\frac{∂y}{∂w} \\\\ \\frac{∂z}{∂u} & \\frac{∂z}{∂v} & \\frac{∂z}{∂w}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have \n\n$$\nx(u,v,w)={u}^{2}-{w}^{2},\\,y(u,v,w)=w{e}^{u},\\,z(u,v,w)=u-v.\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =2u & \\,\\frac{∂x}{∂v} & =0 & \\,\\frac{∂x}{∂w} & =-2w \\\\ \\frac{∂y}{∂u} & =w{e}^{u} & \\,\\frac{∂y}{∂v} & =0 & \\,\\frac{∂y}{∂w} & ={e}^{u} \\\\ \\frac{∂z}{∂u} & =1 & \\,\\frac{∂z}{∂v} & =-1 & \\,\\frac{∂z}{∂w} & =0\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =|\\begin{aligned}2u & 0 & -2w \\\\ w{e}^{u} & 0 & {e}^{u} \\\\ 1 & -1 & 0\\end{aligned}| \\\\  & =2u|\\begin{aligned}0 & {e}^{u} \\\\ -1 & 0\\end{aligned}|-2w|\\begin{aligned}w{e}^{u} & 0 \\\\ 1 & -1\\end{aligned}| \\\\  & =2u(0+{e}^{u})-2w(-w{e}^{u}-0) \\\\  & =2u{e}^{u}+2{w}^{2}{e}^{u} \\\\  & =2{e}^{u}({w}^{2}+u).\\end{aligned}\n$$\n\nThe function has critical points when $\\frac{∂(x,y,z)}{∂(u,v,w)}=0.$ So, we obtain\n\n$$\n\\begin{aligned}\\frac{∂(x,y,z)}{∂(u,v,w)} & =0 \\\\ 2{e}^{u}({w}^{2}+u) & =0 \\\\ {w}^{2}+u & =0.\\end{aligned}\n$$\n\nThe equation ${w}^{2}+u=0$ defines the parabolic cylinder $u=-{w}^{2}.$"}] [{:db/id #edb/ref 17592186401301 :knowledge-point/_questions [{:knowledge-point/id #uuid "fde60ded-ec05-5a2c-8844-26e8e02c9afb" :knowledge-point/title "Expressing Part of a Sphere in Spherical Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdff4620-93ff-550e-afdc-c665cb0060db" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 9,\\,3\\pi /2\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le 2\\pi }" :db/id #edb/ref 17592186401303} {:answer/id #uuid "6fa29027-2d4f-5367-917f-52c169af3941" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,3\\pi /2\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }" :db/id #edb/ref 17592186401304} {:answer/id #uuid "9a681f25-a3d3-54aa-8220-4047401f3201" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{3},\\,3\\pi /2\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }" :db/id #edb/ref 17592186401305} {:answer/id #uuid "ebb3ebdb-8986-5120-bc0e-293da834f2da" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 9,\\,3\\pi /2\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi /2}" :db/id #edb/ref 17592186401306} {:answer/id #uuid "ec03a2a0-b115-5ed7-a6b0-20a8edc98e96" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi }" :db/id #edb/ref 17592186401307}] :answer-field/correct {:answer/id #uuid "6fa29027-2d4f-5367-917f-52c169af3941" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,3\\pi /2\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }" :db/id #edb/ref 17592186401304} :answer-field/id #uuid "07b9fac4-36f4-5471-8875-46834f232265" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401302}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0831acd-ddeb-5e04-811c-4d36ad3d1496" :question/math-academy-id "q-161827" :question/problem "![](images/9f/9f7ed51c1273b73243beb574535686f4ce3498b28c84cbe76833a3096674792c.png)\n\nThe solid enclosed by the quarter-sphere ${x}^{2}+{y}^{2}+{z}^{2}=9$ for $x\\ge 0$ and $y\\le 0,$ shown above, can be described in spherical polar coordinates as" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\n![](images/d3/d338181a6631c513330ef2dd3899cfb9b01cb6f4c4ff7d9cd65038b381e7fec4.png)\n\n  \n\nNotice that inside our region, the spherical polar coordinates vary withing the following domains:\n\n- $\\rho \\in [0,3]$\n\n- $\\theta \\in [\\frac{3\\pi }{2},2\\pi ]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }.\n$$"}] [{:db/id #edb/ref 17592186401308 :knowledge-point/_questions [{:knowledge-point/id #uuid "a898f345-9210-5976-9a42-f415a0e7eaf5" :knowledge-point/title "Performing a Change of Variables in a Triple Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e70215a-59ba-5fc4-8869-08fd079debf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401310} {:answer/id #uuid "2e6baa46-2362-5360-8c5f-7031d62e1411" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cos}^{2}⁡v\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401311} {:answer/id #uuid "7adad8b8-d3ef-52ef-b487-e4018ac1507b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cos}^{2}⁡(u-v)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401312} {:answer/id #uuid "06bed278-63d1-5662-b5c3-13bc65e1ffc5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{cos}^{2}⁡(u)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401313} {:answer/id #uuid "03678aa6-e1ae-5bec-8d2a-faf8e1de8ec2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{cos}^{2}⁡(uv)\\operatorname{cos}⁡v-u" :db/id #edb/ref 17592186401314}] :answer-field/correct {:answer/id #uuid "9e70215a-59ba-5fc4-8869-08fd079debf2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v" :db/id #edb/ref 17592186401310} :answer-field/id #uuid "6b627816-1293-53a9-a8e8-93bf2fb0fcef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401309}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4004275e-59e4-54d2-bbaa-29203ac29308" :question/math-academy-id "q-161879" :question/problem "Consider the finite region $R$ in the $xyz$-space, given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x+3y\\le \\frac{\\pi }{2},\\,0\\le z-3y\\le \\frac{\\pi }{2},\\,0\\le z\\le 2}.\n$$\n\nGiven the change of variables\n\n$$\nu=x+3y,\\,v=z-3y,\\,w=z,\n$$\n\nwhich of the following could be the missing part of the expression below?\n\n$$\n{∭}_{R}{cos}^{2}⁡(x+z)\\operatorname{cos}⁡(z-3y)\\,dV={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}\\,dw\\,dv\\,du\n$$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v \\\\ w\\end{aligned}]⟶[\\begin{aligned}x(u,v,w) \\\\ y(u,v,w) \\\\ z(u,v,w)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uvw$-space to our region $R$ in the $xyz$-space.\n\nTo find the required integral, we can use the change of variables formula\n\n$$\n{∭}_{R}f(x,y,z)\\text{ }dV={∭}_{Δ}\\text{ }f(x(u,v,w),y(u,v,w),z(u,v,w))\\,|\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w\n$$\n\nwhere $\\frac{∂(x,y,z)}{∂(u,v,w)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=x+3y,\\,v=z-3y,\\,w=z\n$$\n\ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]\\to [\\begin{aligned}u(x,y,z) \\\\ v(x,y,z) \\\\ w(x,y,z)\\end{aligned}].\n$$\n\nTo find the required integral, we proceed in four steps:\n\n**Step 1**: Find $Δ,$ which is the image of $R$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uvw$-space is\n\n$$\n\\begin{aligned}Δ & ={(x,y,z)\\,:\\,0\\le u\\le \\frac{\\pi }{2},\\,0\\le v\\le \\frac{\\pi }{2},\\,0\\le w\\le 2}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v,w)}{∂(x,y,z)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} & \\frac{∂u}{∂z} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y} & \\frac{∂v}{∂z} \\\\ \\frac{∂w}{∂x} & \\frac{∂w}{∂y} & \\frac{∂w}{∂z}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 3 & 0 \\\\ 0 & -3 & 1 \\\\ 0 & 0 & 1\\end{aligned}| \\\\  & =1|\\begin{aligned}-3 & 1 \\\\ 0 & 1\\end{aligned}| \\\\  & =1(-3-0) \\\\  & =-3.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y,z)}{∂(u,v,w)}={(\\frac{∂(u,v,w)}{∂(x,y,z)})}^{-1}=-\\frac{1}{3}.\n$$\n\nNote that $\\frac{∂(x,y,z)}{∂(u,v,w)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\n$$\n\\begin{aligned}{∭}_{R}{cos}^{2}⁡(x+z)\\operatorname{cos}⁡(z-3y)\\,dV & ={∭}_{Δ}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v\\cdot |\\frac{∂(x,y,z)}{∂(u,v,w)}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={∭}_{Δ}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v\\cdot |-\\frac{1}{3}|\\,\\text{d}u\\text{d}v\\text{d}w \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}\\,\\frac{1}{3}{cos}^{2}⁡(u+v)\\operatorname{cos}⁡v\\,\\,dw\\,dv\\,du\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401315 :knowledge-point/_questions [{:knowledge-point/id #uuid "d4d69d3c-3bb7-5e99-b606-1bbd538fa1c4" :knowledge-point/title "Expressing Flux as a Double Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6df4d06f-b85b-5df3-8dc8-2bb8f495582f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{\\sqrt{{x}^{2}+{y}^{2}}}-y" :db/id #edb/ref 17592186401317} {:answer/id #uuid "1a198055-107c-5684-9d14-e7c623094522" :answer/type {:db/ident :answer.type/math} :answer/value "y-\\frac{{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}" :db/id #edb/ref 17592186401318} {:answer/id #uuid "4925a5be-07f7-506e-b9ae-faf7c7f0dd10" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\frac{xy}{\\sqrt{{x}^{2}+{y}^{2}}}" :db/id #edb/ref 17592186401319} {:answer/id #uuid "83f96e24-8d6b-5eba-89cf-5696e34a9895" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}-y" :db/id #edb/ref 17592186401320} {:answer/id #uuid "ffa2c4ff-8c1b-548e-992e-27aec7e25032" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3xy}{\\sqrt{{x}^{2}+{y}^{2}}}" :db/id #edb/ref 17592186401321}] :answer-field/correct {:answer/id #uuid "83f96e24-8d6b-5eba-89cf-5696e34a9895" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}-y" :db/id #edb/ref 17592186401320} :answer-field/id #uuid "531e02f0-754c-57e9-98aa-5097314bafb8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401316}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f21c0998-8903-5ed2-945d-a8c8324dedb7" :question/math-academy-id "q-161902" :question/problem "Consider the vector field $F=⟨0,\\,y,\\,-x⟩$ and the closed surface $S$ that encloses the finite region between the cone $z=3\\sqrt{{x}^{2}+{y}^{2}}-9$ and the plane $z=y-x.$ Let $D$ be the projection of $S$ onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as \n\n$$\n{∬}_{S}F\\cdot dS={∬}_{D}\\,\\,\\text{d}A.\n$$\n\nWhich of the following could be the missing expression?" :question/worked-solution "Since we have a closed surface, the positive orientation is outward-pointing by convention. So,\n\n- the upper surface ${S}_{1}:z=g(x,y)=y-x$ is oriented upward, and\n\n- the lower surface ${S}_{2}:z=h(x,y)=3\\sqrt{{x}^{2}+{y}^{2}}-9$ is oriented downward.\n\nNow, we write down the flux across each of the surfaces separately.\n\n- Consider the upper plane ${S}_{1}.$\n\nWe compute the partial derivatives of $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(y-x)=-1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(y-x)=1\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=0,\\,Q=y,\\,R=-x.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-0\\cdot (-1)-y\\cdot 1+(-x))\\,\\text{d}A \\\\  & ={∬}_{D}(-y-x)\\,\\text{d}A.\\end{aligned}\n$$\n\n- Consider lower cone ${S}_{2}.$ \n\nWe compute the partial derivatives of $z=h(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂h}{∂x} & =\\frac{∂}{∂x}(3\\sqrt{{x}^{2}+{y}^{2}}-9)=\\frac{3x}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\ \\frac{∂h}{∂y} & =\\frac{∂}{∂y}(3\\sqrt{{x}^{2}+{y}^{2}}-9)=\\frac{3y}{\\sqrt{{x}^{2}+{y}^{2}}}\\end{aligned}\n$$\n\nIf we denote $F=⟨P,\\,Q,\\,R⟩,$ then\n\n$$\nP=0,\\,Q=y,\\,R=-x.\n$$\n\n \n\nAs a result, since the positive orientation is upward, we have\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot \\text{d}S & =-{∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & =-{∬}_{D}(-0\\cdot \\frac{3x}{\\sqrt{{x}^{2}+{y}^{2}}}-y\\cdot \\frac{3y}{\\sqrt{{x}^{2}+{y}^{2}}}+(-x))\\,\\text{d}A \\\\  & =-{∬}_{D}(-\\frac{3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}-x)\\,\\text{d}A \\\\  & ={∬}_{D}(\\frac{3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}+x)\\,\\text{d}A.\\end{aligned}\n$$\n\nTherefore, the flux across the entire surface is \n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot \\text{d}S+{∬}_{{S}_{2}}F\\cdot \\text{d}S \\\\  & ={∬}_{D}(-y-x)\\,\\text{d}A+{∬}_{D}(\\frac{3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}+x)\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{3{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}-y\\,\\text{d}A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106074 :knowledge-point/_questions [{:knowledge-point/id #uuid "3fea43b6-fd7b-5edc-b6b7-7f8b2cbab502" :knowledge-point/title "Identifying the Type of Image Formed by a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e72b8eba-d97d-557f-a8cb-b177b5a694e1" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186401323} {:answer/id #uuid "239808c3-6662-5144-b216-bf28876d8c30" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186401324} {:answer/id #uuid "d95c8151-cc29-5467-9bd0-4f7145939834" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186401325} {:answer/id #uuid "a539e88c-cfb9-5231-b8f6-481fa85848fe" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186401326} {:answer/id #uuid "ace8a67a-e74f-5f27-9582-9a2b3428a829" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186401327}] :answer-field/correct {:answer/id #uuid "e72b8eba-d97d-557f-a8cb-b177b5a694e1" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186401323} :answer-field/id #uuid "3dd41be4-e0dd-5cb0-830a-bc68816c31ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401322}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ba678a53-c013-5d44-b391-2d5cc0a9cc96" :question/math-academy-id "q-162150" :question/problem "![](images/e2/e2ab6906100a96a123b4b1520613f1e38fe2c7e77af390a8efe0596a2861727d.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $T$ is the origin."}] [{:db/id #edb/ref 17592186401328 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c9eee90-f971-51b3-ba5c-dec986388b62" :knowledge-point/title "Swapping the Order of Integration When the Projection Is Partitioned"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e986629f-0cb1-5b73-9387-7e5c6bf680ed" :answer/type {:db/ident :answer.type/math} :answer/value "p={x}^{2},\\,\\,\\,q=2,\\,\\,\\,r=\\operatorname{ln}⁡x" :db/id #edb/ref 17592186401330} {:answer/id #uuid "7747ad8c-9dab-5071-9712-612e09ef49ee" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\sqrt{x},\\,\\,\\,q=e,\\,\\,\\,r=x" :db/id #edb/ref 17592186401331} {:answer/id #uuid "365f610c-9ced-572c-8125-8961f4f896a9" :answer/type {:db/ident :answer.type/math} :answer/value "p=2x,\\,\\,\\,q=2,\\,\\,\\,r={e}^{x}" :db/id #edb/ref 17592186401332} {:answer/id #uuid "fe0cb55f-4047-582e-8d1c-338eb7a2d14f" :answer/type {:db/ident :answer.type/math} :answer/value "p={x}^{2},\\,\\,\\,q=e,\\,\\,\\,r=\\operatorname{ln}⁡x" :db/id #edb/ref 17592186401333} {:answer/id #uuid "3c2f91e1-1b84-5255-9e54-b6238d498937" :answer/type {:db/ident :answer.type/math} :answer/value "p=2x,\\,\\,\\,q=e,\\,\\,\\,r={e}^{x}" :db/id #edb/ref 17592186401334}] :answer-field/correct {:answer/id #uuid "fe0cb55f-4047-582e-8d1c-338eb7a2d14f" :answer/type {:db/ident :answer.type/math} :answer/value "p={x}^{2},\\,\\,\\,q=e,\\,\\,\\,r=\\operatorname{ln}⁡x" :db/id #edb/ref 17592186401333} :answer-field/id #uuid "06475241-fc29-5967-a1f6-50975e64e9e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401329}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9a894708-53b5-506d-832d-c14b94f740a4" :question/math-academy-id "q-162322" :question/problem "By changing the order of integration, find the missing limits in the following repeated integral.\n\n$$\n{\\int }_{0}^{1}{\\int }_{\\sqrt{z}}^{{e}^{z}}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z={\\int }_{0}^{1}{\\int }_{0}^{p}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x+{\\int }_{1}^{q}{\\int }_{r}^{1}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$" :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x+{\\int }_{c}^{d}{\\int }_{{v}_{3}(x)}^{{v}_{4}(x)}{\\int }_{{u}_{3}(x,z)}^{{u}_{4}(x,z)}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type III region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,\\sqrt{z}\\le x\\le {e}^{z},\\,\\,{z}^{2}-1\\le y\\le x+z}\n$$\n\nSince all repeated integrals first integrate with respect to $y,$ the $y$-limits remain the same as before:\n\n$$\n{\\int }_{0}^{1}{\\int }_{\\sqrt{z}}^{{e}^{z}}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x+{\\int }_{c}^{d}{\\int }_{{v}_{3}(x)}^{{v}_{4}(x)}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $xz$-plane shown below.\n\n![](images/41/41b06d98498273a03b9df8eeaa60f4e74cb00168e8dd0b3b395c5b0a23518e57.png)\n\nThe region $D$ is a type II region in the $xz$-plane:\n\n$$\nD={(x,z)\\,:\\,0\\le z\\le 1,\\,\\sqrt{z}\\le x\\le {e}^{z}}.\n$$\n\nTo change the order of integration from $\\text{d}y\\,\\text{d}x\\,\\text{d}z$ to $\\text{d}y\\,\\text{d}z\\,\\text{d}x,$ we split $D$ into two type I regions.\n\n![](images/07/07a37b90df8b37d07c40af03ecba8e665797cfff368758db7ae17e45f11683cf.png)\n\nNotice that the bottom and top boundaries of the left region, written in the form $z=z(x),$ are\n\n$\\,$ $z=0\\,$ and $\\,z={x}^{2}.$\n\nAlso, the bottom and top boundaries of the right region, written in the form $z=z(x),$ are\n\n$\\,$ $z=\\operatorname{ln}⁡x\\,$ and $\\,z=1.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}={(x,z)\\,:\\,0\\le x\\le 1,\\,0\\le z\\le {x}^{2}}\n$$\n\nand\n\n$$\n{D}_{2}={(x,z)\\,:\\,1\\le x\\le e,\\,\\operatorname{ln}⁡x\\le z\\le 1}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x+{\\int }_{1}^{e}{\\int }_{\\operatorname{ln}⁡x}^{1}{\\int }_{{z}^{2}-1}^{x+z}\\,\\text{d}y\\,\\text{d}z\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401335 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c9eee90-f971-51b3-ba5c-dec986388b62" :knowledge-point/title "Swapping the Order of Integration When the Projection Is Partitioned"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f703bd0-2dd8-50a8-84be-59480e209b05" :answer/type {:db/ident :answer.type/math} :answer/value "p=1,\\,\\,\\,q=2,\\,\\,\\,r={z}^{2}-4" :db/id #edb/ref 17592186401337} {:answer/id #uuid "16f6fbe8-a535-5960-a6c7-b5dd576f6b56" :answer/type {:db/ident :answer.type/math} :answer/value "p=1,\\,\\,\\,q=2,\\,\\,\\,r=4-2z" :db/id #edb/ref 17592186401338} {:answer/id #uuid "6e9b1939-7256-56eb-8c7a-9b505da6122c" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{1}{2},\\,\\,\\,q=1,\\,\\,\\,r={z}^{2}-4" :db/id #edb/ref 17592186401339} {:answer/id #uuid "e24c4541-f269-56ad-b95a-224e52a4e088" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{1}{2},\\,\\,\\,q=3,\\,\\,\\,r=4-2z" :db/id #edb/ref 17592186401340} {:answer/id #uuid "d0a313c4-3307-5cf2-9cf8-be47e0fcc064" :answer/type {:db/ident :answer.type/math} :answer/value "p=1,\\,\\,\\,q=1,\\,\\,\\,r=z-2" :db/id #edb/ref 17592186401341}] :answer-field/correct {:answer/id #uuid "16f6fbe8-a535-5960-a6c7-b5dd576f6b56" :answer/type {:db/ident :answer.type/math} :answer/value "p=1,\\,\\,\\,q=2,\\,\\,\\,r=4-2z" :db/id #edb/ref 17592186401338} :answer-field/id #uuid "f079fa33-36ea-54da-8c9a-cfed3ba497cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401336}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f9c68a00-265c-5c7e-8372-6f380b398f1a" :question/math-academy-id "q-162332" :question/problem "By changing the order of integration, find the missing limits in the following repeated integral.\n\n$$\n{\\int }_{0}^{2}{\\int }_{\\sqrt{2y}-1}^{2-y/2}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y={\\int }_{-1}^{p}{\\int }_{0}^{(z+1)^{2}/2}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{1}^{q}{\\int }_{0}^{r}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$" :question/worked-solution "We wish to find the limits of integration such that our integral can be expressed as\n\n$$\n{\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{c}^{d}{\\int }_{{v}_{3}(z)}^{{v}_{4}(z)}{\\int }_{{u}_{3}(xy,z)}^{{u}_{4}(y,z)}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$\n\nFrom the repeated integral, we see that the domain of integration $R$ can be written as a type II region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,\\sqrt{2y}-1\\le z\\le 2-\\frac{y}{2},\\,\\,-2z\\le x\\le y+3}\n$$\n\nSince all repeated integrals first integrate with respect to $x,$ the $x$-limits remain the same as before:\n\n$$\n{\\int }_{0}^{2}{\\int }_{\\sqrt{2y}-1}^{2-y/2}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}z\\,\\text{d}y={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(x)}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{c}^{d}{\\int }_{{v}_{3}(z)}^{{v}_{4}(x)}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z\n$$\n\n \n\nNow, we consider the projection $D$ of $R$ onto the $yz$-plane shown below.\n\n![](images/a4/a4de9d9df51efcec67253a1c7118466f29459ffd5c9136c144d33500ec5557bc.png)\n\nThe region $D$ is a type I region in the $yz$-plane:\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,\\sqrt{2y}-1\\le z\\le 2-\\frac{y}{2}}.\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}z\\,\\text{d}y$ to $\\text{d}x\\,\\text{d}y\\,\\text{d}z,$ we split $D$ into two type II regions.\n\n![](images/18/18bb3e55f076e022176bb60df27d5665ed2d91d75d618969c04ce192378db922.png)\n\nNotice that the bottom and top boundaries of the lower region, written in the form $y=y(z),$ are\n\n$\\,$ $y=0\\,$ and $\\,y=\\frac{1}{2}(z+1)^{2}.$\n\nAlso, the bottom and top boundaries of the upper region, written in the form $y=y(z),$ are\n\n$\\,$ $y=0\\,$ and $\\,y=4-2z.$\n\nSo, we can write $D$ as a union of\n\n$$\n{D}_{1}={(y,z)\\,:\\,-1\\le z\\le 1,\\,0\\le y\\le \\frac{1}{2}(z+1)^{2}}\n$$\n\nand\n\n$$\n{D}_{2}={(y,z)\\,:\\,1\\le z\\le 2,\\,0\\le x\\le 4-2z}.\n$$\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{0}^{(z+1)^{2}/2}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z+{\\int }_{1}^{2}{\\int }_{0}^{4-2z}{\\int }_{-2z}^{y+3}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401342 :knowledge-point/_questions [{:knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69eaa3fe-4c03-532c-9d1a-cd84b8703ad2" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{4}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401344} {:answer/id #uuid "460112aa-e36b-52a6-a02b-783fee9d05b2" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{xy}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401345} {:answer/id #uuid "9d2fbcee-821a-5cd9-8a6e-f9412bd4ab5e" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,\\frac{{x}^{2}}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401346} {:answer/id #uuid "e12cffd5-0b22-5b0b-a3e3-7270fff61900" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401347} {:answer/id #uuid "1540b931-3add-5e5c-99b4-77aa9c86e5f9" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{{y}^{2}}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401348}] :answer-field/correct {:answer/id #uuid "e12cffd5-0b22-5b0b-a3e3-7270fff61900" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n\\begin{aligned}{\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x\\end{aligned}\n$$" :db/id #edb/ref 17592186401347} :answer-field/id #uuid "17de6bba-7478-572d-9fe3-ada91a6e9edc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a28026ac-9427-5db7-b40f-31513274adc4" :question/math-academy-id "q-162365" :question/problem "Let $C$ be the intersection of the surface $z=\\frac{1}{{x}^{2}+{y}^{2}+1}$ and the boundary of the infinite vertical column enclosed by the planes $x=\\pm 1,$ and $y=\\pm 1.$ Given that the curve $C$ is oriented counter-clockwise when viewed from above and $\\text{curl}\\,F=⟨x,\\,y,\\,-2z⟩,$ the circulation of $F$ along $C$ can be written as \n\n$$\n{∮}_{C}F\\cdot dr=\n$$" :question/worked-solution "Let $S$ be an oriented piecewise-smooth surface bounded by a simple, closed, piecewise-smooth boundary $C$ with positive orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $S,$ then Stokes' theorem states that\n\n$$\n{∮}_{C}F\\cdot dr={∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S.\n$$\n\nThere are many surfaces whose boundary is the curve $C$ representing the intersection of the surface $z=\\frac{1}{{x}^{2}+{y}^{2}+1}$ and the boundary of our infinite vertical column. One such surface is our surface $S$ with the equation \n\n$$\nz=g(x,y)=\\frac{1}{{x}^{2}+{y}^{2}+1}.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{{x}^{2}+{y}^{2}+1})=\\frac{-2x}{({x}^{2}+{y}^{2}+1)^{2}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{{x}^{2}+{y}^{2}+1})=\\frac{-2y}{({x}^{2}+{y}^{2}+1)^{2}}\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into expression for $\\text{curl}\\,F:$\n\n$$\n\\begin{aligned}\\text{curl}\\,F\\,{|}_{z=g(x,y)} & =⟨x,\\,y,\\,-2z⟩{|}_{z=1/({x}^{2}+{y}^{2}+1)} \\\\  & =⟨{{x}_{⏟}}_{P},\\,{{y}_{⏟}}_{Q},\\,{{-\\frac{2}{{x}^{2}+{y}^{2}+1}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nSo, we have \n\n$$\n\\begin{aligned}{∬}_{S}\\text{curl}\\,F\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-x\\cdot \\frac{-2x}{({x}^{2}+{y}^{2}+1)^{2}}-y\\cdot \\frac{-2y}{({x}^{2}+{y}^{2}+1)^{2}}-\\frac{2}{{x}^{2}+{y}^{2}+1})\\,\\text{d}A \\\\  & ={∬}_{D}-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}A,\\end{aligned}\n$$\n\nwhere $D$ is region enclosed by the projection of $C$ onto the $xy$-plane, shown below.\n\n![](images/b2/b215ec1e3330f96e7e606e085721b2dd1f50d113f0151e36ec98e6d0a6f54e73.png)\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-1}^{1}\\,-\\frac{2}{({x}^{2}+{y}^{2}+1)^{2}}\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401349 :knowledge-point/_questions [{:knowledge-point/id #uuid "814655d8-f459-5df5-b722-3024b87065db" :knowledge-point/title "Finding the Curvature of a Plane Curve Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78fb291c-c31f-5ac0-9d77-7a2e07aadd0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{({sin}^{2}⁡t+1)}^{3}}" :db/id #edb/ref 17592186401351} {:answer/id #uuid "2bc16458-ce9f-50c1-8fbf-48870b72fe4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{({sin}^{2}⁡t+1)}" :db/id #edb/ref 17592186401352} {:answer/id #uuid "1153c6c7-bf78-52f2-9e1f-684f7eccb765" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{({sin}^{3}⁡t+1)}" :db/id #edb/ref 17592186401353} {:answer/id #uuid "17520325-a116-5295-9221-ca1e38e5c07a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{(\\operatorname{sin}⁡t+1)}^{3}}" :db/id #edb/ref 17592186401354} {:answer/id #uuid "0447c179-7aef-50a6-824a-496d140ba7c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{(-\\operatorname{sin}⁡t+1)}^{3}}" :db/id #edb/ref 17592186401355}] :answer-field/correct {:answer/id #uuid "78fb291c-c31f-5ac0-9d77-7a2e07aadd0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{{({sin}^{2}⁡t+1)}^{3}}" :db/id #edb/ref 17592186401351} :answer-field/id #uuid "b978e6f7-e64f-5b80-8951-81925452e0ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401350}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5ac123c-3663-55fc-a172-6e4b0415bb6a" :question/math-academy-id "q-162414" :question/problem "The curvature of the plane curve $r(t)=\\operatorname{cos}⁡t\\,i+t\\,j$ is given by \n\n$$\nκ(t)=\\frac{\\operatorname{cos}⁡t}{},\\,0\\le t\\le \\frac{\\pi }{2}.\n$$\n\n \nWhat is the missing part of the expression?" :question/worked-solution "The curvature $κ(t)$ of a plane curve $r(t)=x(t)\\,i+y(t)\\,j$ is given by\n\n$$\nκ(t)=\\frac{|{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)|}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nAlong our curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t,\\,y(t)=t.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-\\operatorname{sin}⁡t,\\, & {y}^{′}(t) & =1 \\\\ {x}^{″}(t) & =-\\operatorname{cos}⁡t,\\, & {y}^{″}(t) & =0\\end{aligned}\n$$\n\nSubstituting these into the formula for the curvature, we get the following:\n\n$$\n\\begin{aligned}κ(t) & =\\frac{|(-\\operatorname{sin}⁡t)\\cdot 0-(-\\operatorname{cos}⁡t)\\cdot 1|}{{((\\operatorname{sin}⁡t)^{2}+{1}^{2})}^{3/2}} \\\\  & =\\frac{|\\operatorname{cos}⁡t|}{{({sin}^{2}⁡t+1)}^{3/2}} \\\\  & =\\frac{\\operatorname{cos}⁡t}{\\sqrt{{({sin}^{2}⁡t+1)}^{3}}}\\end{aligned}\n$$\n\nNotice that we removed the absolute value because cosine is positive for $t\\in [0,\\frac{\\pi }{2}].$"}] [{:db/id #edb/ref 17592186401356 :knowledge-point/_questions [{:knowledge-point/id #uuid "814655d8-f459-5df5-b722-3024b87065db" :knowledge-point/title "Finding the Curvature of a Plane Curve Given in Parametric Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57815f7b-af61-528d-a997-36687ced0737" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186401358} {:answer/id #uuid "d4db65b8-6f9c-5494-a06b-92bcdce809b7" :answer/type {:db/ident :answer.type/math} :answer/value "t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t" :db/id #edb/ref 17592186401359} {:answer/id #uuid "eb263125-4fe2-540b-a807-c4ea79034c46" :answer/type {:db/ident :answer.type/math} :answer/value "-t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/id #edb/ref 17592186401360} {:answer/id #uuid "9709336c-60b5-5d73-aab9-35c162acf334" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186401361} {:answer/id #uuid "7440cb05-c5ac-59cb-a23c-02e409faf53f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186401362}] :answer-field/correct {:answer/id #uuid "9709336c-60b5-5d73-aab9-35c162acf334" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t" :db/id #edb/ref 17592186401361} :answer-field/id #uuid "e0797b50-1acd-58f0-8079-590c6e07a834" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9e9607-a2dd-5594-94f3-d6c7ba9a234a" :question/math-academy-id "q-162418" :question/problem "The signed curvature of the plane curve $r(t)=⟨\\operatorname{sin}⁡t,\\,-{t}^{2}⟩$ is given by\n\n$$\nk(t)=\\frac{2\\cdot (\\,\\,)}{\\sqrt{({cos}^{2}⁡t+4{t}^{2})^{3}}}.\n$$\n\nWhat is the missing part of the expression?" :question/worked-solution "The signed curvature $k(t)$ of a plane curve $r(t)=⟨x(t),y(t)⟩$ is given by\n\n$$\nk(t)=\\frac{{x}^{′}(t){y}^{″}(t)-{y}^{′}(t){x}^{″}(t)}{([{x}^{′}(t)]^{2}+[{y}^{′}(t)]^{2})^{3/2}}.\n$$\n\nAlong our curve, we have\n\n$$\nx(t)=\\operatorname{sin}⁡t,\\,y(t)=-{t}^{2}.\n$$\n\nFirst, we calculate the derivatives of the components:\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\operatorname{cos}⁡t,\\, & {y}^{′}(t) & =-2t \\\\ {x}^{″}(t) & =-\\operatorname{sin}⁡t,\\, & {y}^{″}(t) & =-2\\end{aligned}\n$$\n\nSubstituting these into the formula for the signed curvature, we get:\n\n$$\n\\begin{aligned}k(t) & =\\frac{\\operatorname{cos}⁡t\\cdot (-2)-(-2t)\\cdot (-\\operatorname{sin}⁡t)}{{((\\operatorname{cos}⁡t)^{2}+(-2t)^{2})}^{3/2}} \\\\  & =\\frac{-2\\operatorname{cos}⁡t-2t\\operatorname{sin}⁡t}{{({cos}^{2}⁡t+4{t}^{2})}^{3/2}} \\\\  & =\\frac{2(-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)}{\\sqrt{({cos}^{2}⁡t+4{t}^{2})^{3}}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401363 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffa79034-bdcc-5524-aa39-e81a79b48ded" :knowledge-point/title "Determining a Stream Function for a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc634ad5-e010-5c6c-accf-cdd1bfc87d09" :answer/type {:db/ident :answer.type/math} :answer/value "ψ(x,y)=(x-y)^{2}" :db/id #edb/ref 17592186401365} {:answer/id #uuid "4ee290fe-8425-5228-94c2-57bd0a2da175" :answer/type {:db/ident :answer.type/math} :answer/value "ψ(x,y)=(xy)^{2}" :db/id #edb/ref 17592186401366} {:answer/id #uuid "726bbe70-cba3-547c-bf90-2310b15873c6" :answer/type {:db/ident :answer.type/math} :answer/value "ψ(x,y)={x}^{2}{y}^{3}" :db/id #edb/ref 17592186401367} {:answer/id #uuid "9a3e8097-9217-5fb9-b7d3-fa8eb7bed46e" :answer/type {:db/ident :answer.type/math} :answer/value "ψ(x,y)=(x+y)^{2}" :db/id #edb/ref 17592186401368} {:answer/id #uuid "1354e106-6bc4-5c0a-9398-0cd9067aa706" :answer/type {:db/ident :answer.type/math} :answer/value "ψ(x,y)={x}^{3}{y}^{2}" :db/id #edb/ref 17592186401369}] :answer-field/correct {:answer/id #uuid "4ee290fe-8425-5228-94c2-57bd0a2da175" :answer/type {:db/ident :answer.type/math} :answer/value "ψ(x,y)=(xy)^{2}" :db/id #edb/ref 17592186401366} :answer-field/id #uuid "5c61b134-7c57-530f-8b97-97a808179f81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401364}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d5fedbb-f6c9-5abe-b595-3219e3d242a3" :question/math-academy-id "q-162517" :question/problem "Which of the following is a stream function for the vector field\n$F(x,y)=2{x}^{2}y\\,i-2x{y}^{2}\\,j?$" :question/worked-solution "A vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that $F(x,y)=2{x}^{2}y\\,i-2x{y}^{2}\\,j$ is a vector field with simply connected domain $D={R}^{2},$ where $P(x,y)=2{x}^{2}y$ and $Q(x,y)=-2x{y}^{2}.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=4xy,\\,\\frac{∂Q}{∂y} & =-4xy.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=4xy+(-4xy)=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}=2{x}^{2}y,\\,\\frac{∂ψ}{∂x}=2x{y}^{2}.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)={x}^{2}{y}^{2}+f(x),\\,ψ(x,y)={x}^{2}{y}^{2}+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\nψ(x,y)={x}^{2}{y}^{2}=(xy)^{2}.\n$$"}] [{:db/id #edb/ref 17592186401370 :knowledge-point/_questions [{:knowledge-point/id #uuid "553f7b9d-c387-59b0-a0d6-9624d012e414" :knowledge-point/title "Domains of Functions With Trigonometric Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8b48905-c922-5f0b-904d-031f2f366d2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186401372} {:answer/id #uuid "07837613-c6cb-599f-a1fe-60f06f0661aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi +2n\\pi " :db/id #edb/ref 17592186401373} {:answer/id #uuid "823a0eb9-049b-54c7-87a1-4762c639c714" :answer/type {:db/ident :answer.type/math} :answer/value "n\\pi " :db/id #edb/ref 17592186401374} {:answer/id #uuid "e5f740a3-7481-581f-876f-a404eea190e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186401375} {:answer/id #uuid "730966c2-9ffc-5f1d-9533-075afe811e99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186401376}] :answer-field/correct {:answer/id #uuid "730966c2-9ffc-5f1d-9533-075afe811e99" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186401376} :answer-field/id #uuid "b2067c3d-0d1e-5094-9c41-cc29fa1d1f8b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401371}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c16eaa20-dd31-5858-a148-07284cbf2219" :question/math-academy-id "q-162632" :question/problem "The domain of the vector-valued function $f(t)=2{t}^{3}\\,i+(1+\\operatorname{cos}⁡t)\\,j+\\operatorname{sec}⁡t\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $2{t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $1+\\operatorname{cos}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{sec}⁡t$ is $t\\in (-\\infty ,\\infty )$, $t\\ne \\frac{\\pi }{2}+n\\pi ,$ where $n$ is an integer.\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer."}] [{:db/id #edb/ref 17592186401377 :knowledge-point/_questions [{:knowledge-point/id #uuid "553f7b9d-c387-59b0-a0d6-9624d012e414" :knowledge-point/title "Domains of Functions With Trigonometric Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2be7336-43db-505e-abb5-f6af2521593a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186401379} {:answer/id #uuid "4e991727-db18-5685-87e2-0cd52a14f4de" :answer/type {:db/ident :answer.type/math} :answer/value "n\\pi " :db/id #edb/ref 17592186401380} {:answer/id #uuid "69604832-174f-53c1-981d-5cd931a50089" :answer/type {:db/ident :answer.type/math} :answer/value "2n\\pi " :db/id #edb/ref 17592186401381} {:answer/id #uuid "16e55850-0a5e-5ef0-8d3f-6ca688ae95ba" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186401382} {:answer/id #uuid "9f552a50-0a13-51c1-93c6-c2242cda08ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186401383}] :answer-field/correct {:answer/id #uuid "4e991727-db18-5685-87e2-0cd52a14f4de" :answer/type {:db/ident :answer.type/math} :answer/value "n\\pi " :db/id #edb/ref 17592186401380} :answer-field/id #uuid "50528b4c-2db1-5768-b4f5-380b6c2e954d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401378}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66bd138c-5fd7-52b5-b1a8-7c242f9884ae" :question/math-academy-id "q-162633" :question/problem "The domain of the vector-valued function $f(t)=(1-\\operatorname{cot}⁡t)\\,i+\\operatorname{sin}⁡2t\\,j+{t}^{2}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $1-\\operatorname{cot}⁡t$ is $t\\in (-\\infty ,\\infty ),$ , $t\\ne n\\pi ,$ where $n$ is an integer.\n\n- The domain of the 2nd component $\\operatorname{sin}⁡2t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component ${t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne n\\pi ,\n$$\n\nwhere $n$ is an integer."}] [{:db/id #edb/ref 17592186401384 :knowledge-point/_questions [{:knowledge-point/id #uuid "553f7b9d-c387-59b0-a0d6-9624d012e414" :knowledge-point/title "Domains of Functions With Trigonometric Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ede8e16-494c-5ead-ba64-5838ef07def5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{2}" :db/id #edb/ref 17592186401386} {:answer/id #uuid "4bb8a9be-6f0a-565b-b6b2-11bc4789ac9d" :answer/type {:db/ident :answer.type/math} :answer/value "n\\pi " :db/id #edb/ref 17592186401387} {:answer/id #uuid "70995bca-c45d-5efe-9c86-d0ad7a6058b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}+n\\pi " :db/id #edb/ref 17592186401388} {:answer/id #uuid "50f624a9-d806-5717-a7e5-2f6fcc28ebd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186401389} {:answer/id #uuid "2e3fe947-d5c0-5bd5-8ca5-786edda0e0d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186401390}] :answer-field/correct {:answer/id #uuid "2e3fe947-d5c0-5bd5-8ca5-786edda0e0d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186401390} :answer-field/id #uuid "9a56ee90-9fa8-5ebf-a7cd-271d63b533b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7adf6f23-c582-5c46-b1a7-7edbfe6210af" :question/math-academy-id "q-162637" :question/problem "The domain of the vector-valued function $f(t)=(1-{t}^{3})\\,i+3\\operatorname{tan}⁡t\\,j+\\sqrt{{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $1-{t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $3\\operatorname{tan}⁡t$ is $t\\in (-\\infty ,\\infty )$, $t\\ne \\frac{\\pi }{2}+n\\pi ,$ where $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer."}] [{:db/id #edb/ref 17592186124820 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "383b8761-c8df-5055-82bc-b135e677607f" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186401392} {:answer/id #uuid "6a24a551-0d67-54fa-a898-81b6b8a70318" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186401393} {:answer/id #uuid "54876cd1-0314-5deb-ab1d-b12e5527f92e" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186401394} {:answer/id #uuid "0963c530-23fc-5035-8a90-8f3a474c35e1" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186401395} {:answer/id #uuid "0d45bd81-d2af-5d91-9d5a-2b641a8316e0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186401396}] :answer-field/correct {:answer/id #uuid "0d45bd81-d2af-5d91-9d5a-2b641a8316e0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186401396} :answer-field/id #uuid "f27a5b4e-3727-5966-9e47-39feb88a654c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401391}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0151a70d-ce12-5172-8abb-638426f2b102" :question/math-academy-id "q-162747" :question/problem "![](images/b6/b698fe735caaf3bc260c1e921bb95596df8869eba67ec9ce72484b4d86cc8c69.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?" :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch regions exist for the points $A$ and $D.$ Hence $A$ and $D$ are local minimum points.\n\n**Note**: For the point $D({x}_{D},{y}_{D},{z}_{D}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{D},{y}_{D})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\ge f(a,b)$, the point $D$ does satisfy the conditions for a local minimum.\n\n![](images/0a/0a371aa559222bd28c37677bace18eb912bdc978e364bab4cb3d83f7a310de3f.png)"}] [{:db/id #edb/ref 17592186401397 :knowledge-point/_questions [{:knowledge-point/id #uuid "355c5dfd-d06f-56ef-9c38-8dccf702467e" :knowledge-point/title "Constructing a Lagrange System With Two Constraints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b59bf81-336b-5b77-a5ab-993e5da369cc" :answer/type {:db/ident :answer.type/text} :answer/value "$y$ and $2z$" :db/id #edb/ref 17592186401399} {:answer/id #uuid "cd2b1eac-ff7d-50ba-8e40-931f60aee6f6" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $y$" :db/id #edb/ref 17592186401400} {:answer/id #uuid "372a272b-dcaf-5ac5-a75d-2792619b147e" :answer/type {:db/ident :answer.type/text} :answer/value "$2x$ and $2y$" :db/id #edb/ref 17592186401401} {:answer/id #uuid "92eb8681-34a4-5d3f-9b19-cabe81d62073" :answer/type {:db/ident :answer.type/text} :answer/value "$2x$ and $2z$" :db/id #edb/ref 17592186401402} {:answer/id #uuid "eda1895b-7d76-519b-8bab-824851119ae2" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186401403}] :answer-field/correct {:answer/id #uuid "372a272b-dcaf-5ac5-a75d-2792619b147e" :answer/type {:db/ident :answer.type/text} :answer/value "$2x$ and $2y$" :db/id #edb/ref 17592186401401} :answer-field/id #uuid "9ec7c466-5f47-5c18-934e-2ba7c46ca3fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8afa6e7b-08b3-5fd6-b960-921c9d4bc534" :question/math-academy-id "q-162811" :question/problem "Suppose we would like to find the maximum value of the function $f(x,y,z)={x}^{2}+{y}^{2}z$ on the intersection of the surfaces ${x}^{2}+{z}^{2}=1$ and ${y}^{2}+z=9$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system:\n\n$$\n{\\begin{aligned}⟨2x,\\,2yz,\\,{y}^{2}⟩=\\lambda ⟨\\boxed{}\\,, \\,0,\\,2z⟩+\\mu ⟨0,\\boxed{}\\,,\\,1⟩ \\\\ {x}^{2}+{z}^{2}=1 \\\\ {y}^{2}+z=9\\end{aligned}\n$$\n\nFrom left to right, what are the missing expressions?" :question/worked-solution "We need to find the maximum value of \n\n$$\nf(x,y,z)={x}^{2}+{y}^{2}z\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)={x}^{2}+{z}^{2}=1,\\,h(x,y,z)={y}^{2}+z=9.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=1 \\\\ h(x,y,z)=9\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨2x,\\,2yz,\\,{y}^{2}⟩ & =\\lambda ⟨2x,\\,0,\\,2z⟩+\\mu ⟨0,\\,2y,\\,1⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401404 :knowledge-point/_questions [{:knowledge-point/id #uuid "355c5dfd-d06f-56ef-9c38-8dccf702467e" :knowledge-point/title "Constructing a Lagrange System With Two Constraints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a26a345-848a-52d6-9cff-309d48842caa" :answer/type {:db/ident :answer.type/text} :answer/value "$z\\,$ and $2x$" :db/id #edb/ref 17592186401406} {:answer/id #uuid "0336a2fb-21ec-5932-b4bf-96df7edcc264" :answer/type {:db/ident :answer.type/text} :answer/value "$2\\,$ and $x$" :db/id #edb/ref 17592186401407} {:answer/id #uuid "7d3832c6-972f-5f02-873d-640f27294ef7" :answer/type {:db/ident :answer.type/text} :answer/value "$1\\,$ and $2z$" :db/id #edb/ref 17592186401408} {:answer/id #uuid "f73da70f-25e8-5f76-94d0-6c2f5b70918f" :answer/type {:db/ident :answer.type/text} :answer/value "$1\\,$ and $2$" :db/id #edb/ref 17592186401409} {:answer/id #uuid "13062583-c8cd-58e7-92bd-33acf71104ee" :answer/type {:db/ident :answer.type/text} :answer/value "$x\\,$ and $-y$" :db/id #edb/ref 17592186401410}] :answer-field/correct {:answer/id #uuid "7d3832c6-972f-5f02-873d-640f27294ef7" :answer/type {:db/ident :answer.type/text} :answer/value "$1\\,$ and $2z$" :db/id #edb/ref 17592186401408} :answer-field/id #uuid "6944c355-576e-5c8e-b344-9b3d5fd644ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401405}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a114a88-7824-55e2-8ac4-08f991d5f004" :question/math-academy-id "q-162812" :question/problem "Suppose we would like to find the minimum value of the function $f(x,y,z)=xy+{z}^{2}$ on the intersection of the surfaces $y-x=0$ and ${x}^{2}+{y}^{2}+{z}^{2}=4$ using the method of Lagrange multipliers. Then, the corresponding Lagrange multipliers $\\lambda $ and $\\mu $ satisfy the following system: \n\n$$\n{\\begin{aligned}⟨y,\\,x,\\,2z⟩=\\lambda ⟨-1,\\boxed{}\\,, \\,0⟩+\\mu ⟨2x,\\,2y,\\boxed{}\\,⟩ \\\\ y-x=0 \\\\ {x}^{2}+{y}^{2}+{z}^{2}=4\\end{aligned}\n$$\n\nFrom left to right, what are the missing expressions?" :question/worked-solution "We need to find the minimum value of \n\n$$\nf(x,y,z)=xy+{z}^{2}\n$$\n\n \n\nsubject to the constraints \n\n$$\ng(x,y,z)=y-x=0,\\,h(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}=4.\n$$\n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=0 \\\\ h(x,y,z)=4\\end{aligned}\n$$\n\nWe now expand the first equation of the system:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨y,\\,x,\\,2z⟩ & =\\lambda ⟨-1,\\,1,\\,0⟩+\\mu ⟨2x,\\,2y,\\,2z⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401411 :knowledge-point/_questions [{:knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0982cdc8-9442-57fe-b7fa-346753e57354" :answer/type {:db/ident :answer.type/text} :answer/value "$x,\\,$ $2x,\\,$ and $x\\operatorname{sin}⁡(xy)$" :db/id #edb/ref 17592186401413} {:answer/id #uuid "d02b2ee1-2d41-522a-96b3-adfd227f36c3" :answer/type {:db/ident :answer.type/text} :answer/value "$x,\\,$ $2x,\\,$ and $y\\operatorname{sin}⁡(xy)$" :db/id #edb/ref 17592186401414} {:answer/id #uuid "9b952bee-251b-539e-8f7d-67e73938f6f8" :answer/type {:db/ident :answer.type/text} :answer/value "$x,\\,$ $x,\\,$ and $y\\operatorname{cos}⁡(xy)$" :db/id #edb/ref 17592186401415} {:answer/id #uuid "03a4583d-e5ff-5e79-9be7-41b39f117fc3" :answer/type {:db/ident :answer.type/text} :answer/value "$x,\\,$ $2x,\\,$ and $y\\operatorname{cos}⁡(xy)$" :db/id #edb/ref 17592186401416} {:answer/id #uuid "71423d40-798c-5652-a081-532957655dd8" :answer/type {:db/ident :answer.type/text} :answer/value "$x,\\,$ $x,\\,$ and $x\\operatorname{cos}⁡(xy)$" :db/id #edb/ref 17592186401417}] :answer-field/correct {:answer/id #uuid "03a4583d-e5ff-5e79-9be7-41b39f117fc3" :answer/type {:db/ident :answer.type/text} :answer/value "$x,\\,$ $2x,\\,$ and $y\\operatorname{cos}⁡(xy)$" :db/id #edb/ref 17592186401416} :answer-field/id #uuid "5bc9a4e2-1d70-54d1-8a2a-b5a3fd7bf284" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401412}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e019c258-2f09-55a3-ab9c-d440f05baea0" :question/math-academy-id "q-163092" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{3},$ defined as\n\n$$\nf(x)=[\\begin{aligned}xy \\\\ {x}^{2}-y \\\\ \\operatorname{sin}⁡(xy)\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\nthe total derivative ${f}^{′}$ is given by \n\n$$\n{f}^{′}(x)=[\\begin{aligned}y & \\boxed{} \\\\ \\boxed{} & -1 \\\\ \\boxed{} & x\\operatorname{cos}⁡(xy)\\end{aligned}].\n$$\n\nFrom top to bottom, what are the missing entries?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y} \\\\ \\frac{∂{f}_{3}}{∂x} & \\frac{∂{f}_{3}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(xy)=y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(xy)=x, \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}-y)=2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}-y)=-1, \\\\ \\frac{∂{f}_{3}}{∂x} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy))=y\\operatorname{cos}⁡(xy),\\, & \\frac{∂{f}_{3}}{∂y} & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy))=x\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}y & x \\\\ 2x & -1 \\\\ y\\operatorname{cos}⁡(xy) & x\\operatorname{cos}⁡(xy)\\end{aligned}].\n$$\n\nThus, the missing entries are $x,\\,$ $2x,\\,$ and $y\\operatorname{cos}⁡(xy).$"}] [{:db/id #edb/ref 17592186401418 :knowledge-point/_questions [{:knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d959d5d7-cbc1-5318-b797-c37a0afbbf37" :answer/type {:db/ident :answer.type/text} :answer/value "$x{e}^{xyz},\\,$ $z,\\,$ and $z$" :db/id #edb/ref 17592186401420} {:answer/id #uuid "b30dc2cc-68a4-5912-8a3e-df5e08613c6e" :answer/type {:db/ident :answer.type/text} :answer/value "${e}^{xyz},\\,$ $2x,\\,$ and $y$" :db/id #edb/ref 17592186401421} {:answer/id #uuid "3fd45803-73b4-58a2-b054-1d9f41e88d38" :answer/type {:db/ident :answer.type/text} :answer/value "$yz{e}^{yz},\\,$ $0,\\,$ and $y$" :db/id #edb/ref 17592186401422} {:answer/id #uuid "43123342-28a0-58f0-8627-2ed0371a4ca3" :answer/type {:db/ident :answer.type/text} :answer/value "$yz{e}^{xyz},\\,$ $z,\\,$ and $y$" :db/id #edb/ref 17592186401423} {:answer/id #uuid "1c151508-a070-5be8-9646-29a3b6c0d0e1" :answer/type {:db/ident :answer.type/text} :answer/value "$z{e}^{xyz},\\,$ $z,\\,$ and $z$" :db/id #edb/ref 17592186401424}] :answer-field/correct {:answer/id #uuid "43123342-28a0-58f0-8627-2ed0371a4ca3" :answer/type {:db/ident :answer.type/text} :answer/value "$yz{e}^{xyz},\\,$ $z,\\,$ and $y$" :db/id #edb/ref 17592186401423} :answer-field/id #uuid "9cbe7815-5a90-5779-9948-27720bbf467a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401419}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e4436f3f-18fe-5775-815d-04fe166d17a2" :question/math-academy-id "q-163100" :question/problem "For the transformation $f:{R}^{3}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}{e}^{xyz} \\\\ x+yz\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}],\n$$\n\nthe total derivative ${f}^{′}$ is given by \n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\boxed{} & xz{e}^{xyz} & xy{e}^{xyz} \\\\ 1 & \\boxed{} & \\boxed{}\\end{aligned}].\n$$\n\nFrom left to right, what are the missing entries?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} & \\frac{∂{f}_{1}}{∂z} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y} & \\frac{∂{f}_{2}}{∂z}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({e}^{xyz})=yz{e}^{xyz},\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({e}^{xyz})=xz{e}^{xyz},\\, & \\frac{∂{f}_{1}}{∂z} & =\\frac{∂}{∂z}({e}^{xyz})=xy{e}^{xyz} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(x+yz)=1,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(x+yz)=z,\\, & \\frac{∂{f}_{2}}{∂z} & =\\frac{∂}{∂z}(x+yz)=y\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}yz{e}^{xyz} & xz{e}^{xyz} & xy{e}^{xyz} \\\\ 1 & z & y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186401425 :knowledge-point/_questions [{:knowledge-point/id #uuid "233eab4c-ab17-53a8-ae03-f6f28ac78922" :knowledge-point/title "Classifying Local Extrema Using Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a1cab09-af4c-5681-b572-7073c44cadd1" :answer/type {:db/ident :answer.type/text} :answer/value "local maximum" :db/id #edb/ref 17592186401427} {:answer/id #uuid "79bc2964-acb4-51b0-b007-9d90d00e18e8" :answer/type {:db/ident :answer.type/text} :answer/value "inconclusive" :db/id #edb/ref 17592186401428} {:answer/id #uuid "17c52ede-9d07-5f7f-8b20-6215a7509689" :answer/type {:db/ident :answer.type/text} :answer/value "not a critical point" :db/id #edb/ref 17592186401429} {:answer/id #uuid "869eb4f4-f69e-53fa-8018-2d9ffbf80a5f" :answer/type {:db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186401430} {:answer/id #uuid "e113570c-5c60-57ef-a5c6-a06bf8ad264a" :answer/type {:db/ident :answer.type/text} :answer/value "saddle point" :db/id #edb/ref 17592186401431}] :answer-field/correct {:answer/id #uuid "869eb4f4-f69e-53fa-8018-2d9ffbf80a5f" :answer/type {:db/ident :answer.type/text} :answer/value "local minimum" :db/id #edb/ref 17592186401430} :answer-field/id #uuid "c860e53e-f867-5749-aa4f-e7a554c597fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9ce8c10-95e8-5421-97ed-611d96bbf7c9" :question/math-academy-id "q-163771" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈-\\frac{4}{3}+\\frac{1}{2}(x-a)^{T}[\\begin{aligned}2 & -1 & 0 \\\\ -1 & 2 & 0 \\\\ 0 & 0 & 2\\end{aligned}](x-a).\n$$\n\nGiven that the eigenvalues of ${f}^{″}(a)$ are ${\\lambda }_{1}=1,{\\lambda }_{2}=2,$ and ${\\lambda }_{3}=3,$ what type of point is $a?$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nThe quadratic Taylor expansion of a function $f:{R}^{n}\\to R$ about $x=a\\in {R}^{n}$ given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}(x-a)^{T}{f}^{″}(a)(x-a).\n$$\n\nSince the quadratic Taylor expansion of $f$ has no $(x-a)$ term, we can conclude that ${f}^{′}(a)={0}^{T}.$ Hence, $a$ is a critical point of $f.$\n\nFinally, notice that all the eigenvalues of ${f}^{″}(a)$ are positive:\n\n$$\n\\begin{aligned}{\\lambda }_{1} & =1>0 \\\\ {\\lambda }_{2} & =2>0 \\\\ {\\lambda }_{3} & =3>0\\end{aligned}\n$$\n\nSo, the matrix is positive definite. Therefore, $a$ is a local minimum of $f.$"}] [{:db/id #edb/ref 17592186401432 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ee9cbe8-ad40-5155-b42d-1802f36adf27" :knowledge-point/title "Identifying the Global Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d12bfd22-9e9d-5d37-bbd0-35e563e5e30a" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,0,-2)$ and $(2,3,0)$" :db/id #edb/ref 17592186401434} {:answer/id #uuid "99f7cc57-ad3a-5493-ba20-b02d01c3c072" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-2,1.2)$  only" :db/id #edb/ref 17592186401435} {:answer/id #uuid "7d4d1de4-cb9d-5b3a-b919-1ee28c961db6" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,3,0)$  only" :db/id #edb/ref 17592186401436} {:answer/id #uuid "27f2d2ad-7cab-5c68-bfaf-a31ab980901d" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,1,3)$ only" :db/id #edb/ref 17592186401437} {:answer/id #uuid "d947cbda-24ab-58ef-b437-c399ba283d13" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-2,1.2)$ and $(-2,1,3)$" :db/id #edb/ref 17592186401438}] :answer-field/correct {:answer/id #uuid "27f2d2ad-7cab-5c68-bfaf-a31ab980901d" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,1,3)$ only" :db/id #edb/ref 17592186401437} :answer-field/id #uuid "32d7053b-a2c6-58ee-8efc-3a03178f6bd3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401433}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c163c8c-12fc-59a2-9e1d-9f264f8ad03a" :question/math-academy-id "q-163834" :question/problem "![](images/21/215b322e06280dd01e5858df9a17cd56673b5cdec69521decca205e03771ac21.png)\n\nThe graph $z=f(x,y)$ is shown above. What are the global maximum points of the function?" :question/worked-solution "First, we recall the following definitions:\n\n- The global maximum of a function is the largest value it attains on its domain. There can only be (at most) one global maximum.\n\n- A global maximum point is a point $(x,y,z)$ where a function reaches a global maximum. There can be zero, one, or many global maximum points.\n\nFor our function, the maximum value reached by the function is $f(x,y)=3.$ Therefore, the global maximum is $3.$ The function reaches this value when $(x,y)=(-2,1),$ so the global maximum point is $(-2,1,3).$\n\n![](images/d5/d5f948483a80f37257b285d48cd1e6bbf1d8a6ba9b66d1fea5edd865c787711a.png)"}] [{:db/id #edb/ref 17592186088038 :knowledge-point/_questions [{:knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4bcf009-6fca-5110-8ae8-643678b3cb9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(2\\operatorname{sin}⁡x)y=\\frac{1+3\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186401440} {:answer/id #uuid "eb82a4b2-58af-556c-a366-f92624768704" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(4\\operatorname{sin}⁡x)y=1+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186401441} {:answer/id #uuid "f4a26a57-987c-5668-b531-e2f3db2b75bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(2\\operatorname{sin}⁡x)y=1+\\frac{3}{2}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186401442} {:answer/id #uuid "b6972414-a235-5987-855e-567ba571b605" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(4\\operatorname{cos}⁡x)y=1+3\\operatorname{sin}⁡x" :db/id #edb/ref 17592186401443} {:answer/id #uuid "e08cc03c-cea4-583d-b68b-e5c8622f76e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+\\frac{1+3\\operatorname{cos}⁡x}{2}=(2\\operatorname{sin}⁡x)y" :db/id #edb/ref 17592186401444}] :answer-field/correct {:answer/id #uuid "c4bcf009-6fca-5110-8ae8-643678b3cb9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{d}y}{\\text{d}x}+(2\\operatorname{sin}⁡x)y=\\frac{1+3\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186401440} :answer-field/id #uuid "ef647b19-79e2-5b54-b8df-1bf5fe9db9b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401439}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5c269fd-ead8-50e4-b16e-9d9e9b4a244c" :question/math-academy-id "q-16400" :question/problem "Write the following first-order linear ODE in standard form.\n\n$$\n2\\frac{\\text{d}y}{\\text{d}x}-3\\operatorname{cos}⁡x=1-4y\\operatorname{sin}⁡x\n$$" :question/worked-solution "A first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nConverting the given equation to standard form, we have\n\n$$\n\\begin{aligned}2\\frac{\\text{d}y}{\\text{d}x}-3\\operatorname{cos}⁡x & =1-4y\\operatorname{sin}⁡x \\\\ 2\\frac{\\text{d}y}{\\text{d}x}+4y\\operatorname{sin}⁡x & =1+3\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x}+{{(2\\operatorname{sin}⁡x)}_{⏟}}_{P(x)}y & ={{\\frac{1+3\\operatorname{cos}⁡x}{2}}_{⏟}}_{Q(x)}.\\end{aligned}\n$$\n\nNow, the equation is written in standard form with $P(x)=2\\operatorname{sin}⁡x$ and $Q(x)=\\frac{1+3\\operatorname{cos}⁡x}{2}.$"}] [{:db/id #edb/ref 17592186401445 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "475ce117-63c5-5ee4-b359-fc20c9c51651" :answer/type {:db/ident :answer.type/text} :answer/value "The function does not have local maxima" :db/id #edb/ref 17592186401447} {:answer/id #uuid "cc880a4e-5176-5965-abb2-4d59cb691ec9" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186401448} {:answer/id #uuid "e2bd567a-a4c4-543c-81f0-2381cab6d5e8" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186401449} {:answer/id #uuid "56368805-72a8-566e-a53d-bb48170c39e2" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186401450} {:answer/id #uuid "41a0973a-78e5-5b21-83f7-bcf5f3ddb6d3" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186401451}] :answer-field/correct {:answer/id #uuid "41a0973a-78e5-5b21-83f7-bcf5f3ddb6d3" :answer/type {:db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186401451} :answer-field/id #uuid "b8d87059-ea13-55bb-b541-23109862b322" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401446}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2740d2d6-bc06-5779-9308-da4a9d560214" :question/math-academy-id "q-164152" :question/problem "![](images/c4/c460920f6b2516ac8603852e12d15840cca051736555ea43cf15a278ef9e0155.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?" :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch neighborhoods exist for the points $C$ and $D.$ Hence $C$ and $D$ are local maxima.\n\n![](images/cc/cc526bb1cf73fb5b5579966e91077ccd096aea475a4cf13196166bd65ac88d7b.png)"}] [{:db/id #edb/ref 17592186401452 :knowledge-point/_questions [{:knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd89ecad-0fc0-5ba5-a620-05712d3a1b08" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-\\frac{1}{2},0)$ and $(0,1,0)$" :db/id #edb/ref 17592186401454} {:answer/id #uuid "d50858b8-1fd8-5038-a72e-57fc3037d5e2" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,\\frac{1}{2},0)$" :db/id #edb/ref 17592186401455} {:answer/id #uuid "0fd95cab-9721-51ba-b9c4-0bf0be760265" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ and $(0,1,0)$" :db/id #edb/ref 17592186401456} {:answer/id #uuid "99d03f44-97f1-5754-9f11-086ea13d97fe" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ and $(0,\\frac{1}{2},0)$" :db/id #edb/ref 17592186401457} {:answer/id #uuid "4408e820-21f8-5788-8399-5558cbe467ac" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-\\frac{1}{2},0)$ and $(0,\\frac{1}{2},0)$" :db/id #edb/ref 17592186401458}] :answer-field/correct {:answer/id #uuid "0fd95cab-9721-51ba-b9c4-0bf0be760265" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ and $(0,1,0)$" :db/id #edb/ref 17592186401456} :answer-field/id #uuid "de275abf-f996-5e86-903d-b371c046139e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50783562-e3df-58d6-82c6-67c9daca87a3" :question/math-academy-id "q-164267" :question/problem "Given the ellipsoid $\\frac{(x+2)^{2}}{8}+\\frac{{y}^{2}}{4}+\\frac{(z-2)^{2}}{16}=1$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+2)^{2}}{8}+\\frac{{y}^{2}}{4}+\\frac{(0-2)^{2}}{16} & =1 \\\\ \\frac{4}{8}+\\frac{{y}^{2}}{4}+\\frac{4}{16} & =1 \\\\ \\frac{{y}^{2}}{4} & =\\frac{1}{4} \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nHence, we get the solutions $y=-1$ and $y=1.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-1,0)$ and $(0,1,0).$"}] [{:db/id #edb/ref 17592186401459 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf44a846-8458-5e2f-bef3-72cf87a6035f" :knowledge-point/title "Identifying the Intercepts of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bb29e98-356d-5e90-ac97-d29d6178c40e" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,-3)$ only" :db/id #edb/ref 17592186401461} {:answer/id #uuid "6a12cd1c-6682-5df8-923c-6c5944da1e21" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,-3)$ and $(0,0,1)$" :db/id #edb/ref 17592186401462} {:answer/id #uuid "6dea4a01-2c2d-5563-9522-56b73624cc0d" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,-2)$ and $(0,0,2)$" :db/id #edb/ref 17592186401463} {:answer/id #uuid "9addb0b5-d438-50d6-917d-38fb314ead17" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,-1)$ only" :db/id #edb/ref 17592186401464} {:answer/id #uuid "5e7a3e71-8adf-5c96-a5b6-a2346b9e5122" :answer/type {:db/ident :answer.type/text} :answer/value "The hyperboloid does not intersect the $z$-axis" :db/id #edb/ref 17592186401465}] :answer-field/correct {:answer/id #uuid "6a12cd1c-6682-5df8-923c-6c5944da1e21" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,-3)$ and $(0,0,1)$" :db/id #edb/ref 17592186401462} :answer-field/id #uuid "2c38e30b-5bcd-54ca-8ea6-28e179828a4c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401460}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b589cdc8-22e6-5881-b7f2-9fb3725db0fb" :question/math-academy-id "q-164272" :question/problem "Given the hyperboloid of two sheets ${x}^{2}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{4}=-1,$ find its $z$-intercepts." :question/worked-solution "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation: \n\n$$\n\\begin{aligned}{0}^{2}+\\frac{{0}^{2}}{2}-\\frac{(z+1)^{2}}{4} & =-1 \\\\ -\\frac{(z+1)^{2}}{4} & =-1 \\\\ (z+1)^{2} & =4 \\\\ z+1 & =\\pm 2 \\\\ z & =-1\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $z=-3$ and $z=1.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-3)$ and $(0,0,1).$"}] [{:db/id #edb/ref 17592186401466 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339" :knowledge-point/title "The Domain of a Sphere or Ellipsoid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e71a948-a9c5-5faf-b47c-17e50a3f8324" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,1)$" :db/id #edb/ref 17592186401468} {:answer/id #uuid "1e85c958-d38e-5452-bf22-85abbc7a75bf" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(1,-3)$" :db/id #edb/ref 17592186401469} {:answer/id #uuid "df3c0953-d686-59f3-a7d7-fe00ebde4e1d" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,1)$" :db/id #edb/ref 17592186401470} {:answer/id #uuid "c7c4b9ff-1b21-54cc-b53e-7eb6f046091b" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(3,2)$" :db/id #edb/ref 17592186401471} {:answer/id #uuid "598580ec-0b00-5ab0-a4fe-2e46a90d75e6" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(1,3)$" :db/id #edb/ref 17592186401472}] :answer-field/correct {:answer/id #uuid "9e71a948-a9c5-5faf-b47c-17e50a3f8324" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,1)$" :db/id #edb/ref 17592186401468} :answer-field/id #uuid "182e0ed3-43fe-59b0-b733-03b03b4eb82f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3e6a384d-7ca2-5551-9c7a-30830f5ff58a" :question/math-academy-id "q-164311" :question/problem "Given the sphere $(x-3)^{2}+(y-1)^{2}+(z-2)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-3)^{2}+(y-1)^{2}+(z-2)^{2} & =9 \\\\ (z-2)^{2} & =9-((x-3)^{2}+(y-1)^{2}) \\\\ z-2 & =\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})} \\\\ z & =2\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x-3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x-3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(3,1)$ in the $xy$-plane."}] [{:db/id #edb/ref 17592186401473 :knowledge-point/_questions [{:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff45c2a2-3a41-5311-99ca-5e68d6a5cab4" :answer/type {:db/ident :answer.type/text} :answer/value "The parabola $(x+3)^{2}=6z$" :db/id #edb/ref 17592186401475} {:answer/id #uuid "de23290b-1126-571c-a0e8-9a9fda87468d" :answer/type {:db/ident :answer.type/text} :answer/value "The line $y=3$" :db/id #edb/ref 17592186401476} {:answer/id #uuid "86e5f373-6dc5-578d-9dab-a014632c2480" :answer/type {:db/ident :answer.type/text} :answer/value "The parabola ${x}^{2}=6(z-3)$" :db/id #edb/ref 17592186401477} {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401478} {:answer/id #uuid "defd7bf9-9f21-5237-ad4c-3feffa02e09e" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $y=-3$ and $y=15$" :db/id #edb/ref 17592186401479}] :answer-field/correct {:answer/id #uuid "017e8e93-5da0-5960-ba95-563c27bee3c1" :answer/type {:db/ident :answer.type/text} :answer/value "The line $y=\\frac{3}{2}$" :db/id #edb/ref 17592186401478} :answer-field/id #uuid "770068c0-e321-5534-9c7a-f0ff2132d3c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401474}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c06a8e8-6e3d-50f3-ae2e-200f38471a76" :question/math-academy-id "q-164400" :question/problem "What is the trace in the $yz$-plane of the parabolic cylinder $(x+3)^{2}=6y?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}(0+3)^{2} & =6y \\\\ 9 & =6y \\\\ y & =\\frac{9}{6} \\\\ y & =\\frac{3}{2}\\end{aligned}\n$$\n\nThis gives us the equation of a line in the $yz$-plane."}] [{:db/id #edb/ref 17592186401480 :knowledge-point/_questions [{:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddfe34f7-e006-5620-84fe-1db6fc963651" :answer/type {:db/ident :answer.type/text} :answer/value "The line $x=4$" :db/id #edb/ref 17592186401482} {:answer/id #uuid "b838d302-7461-5223-8e33-c740bbf20ff9" :answer/type {:db/ident :answer.type/text} :answer/value "The line $x=6$" :db/id #edb/ref 17592186401483} {:answer/id #uuid "161fe7ca-7c93-5282-b813-a0a45f65d7ac" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $x=2$ and $x=6$" :db/id #edb/ref 17592186401484} {:answer/id #uuid "2cfcfb48-24ef-595a-a479-2f2b1a35f56d" :answer/type {:db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(x-4)^{2}}{8}+\\frac{{z}^{2}}{2}=1$" :db/id #edb/ref 17592186401485} {:answer/id #uuid "b309b4aa-316e-5e47-b444-65898ffba0f5" :answer/type {:db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{{x}^{2}}{8}-\\frac{(z-1)^{2}}{2}=1$" :db/id #edb/ref 17592186401486}] :answer-field/correct {:answer/id #uuid "161fe7ca-7c93-5282-b813-a0a45f65d7ac" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $x=2$ and $x=6$" :db/id #edb/ref 17592186401484} :answer-field/id #uuid "53177c21-6f8b-5255-86cb-d89db3a9a51a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401481}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98ad452f-818a-5095-bf60-3f83ccbaae0f" :question/math-academy-id "q-164401" :question/problem "What is the trace in the $xz$-plane of the elliptic cylinder $\\frac{(x-4)^{2}}{8}+\\frac{(y-1)^{2}}{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-4)^{2}}{8}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8}+\\frac{1}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8} & =\\frac{1}{2} \\\\ (x-4)^{2} & =4 \\\\ x-4 & =\\pm 2 \\\\ x & =4\\pm 2 \\\\ x & =2,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $x=2$ and $x=6$ in the $xz$-plane."}] [{:db/id #edb/ref 17592186401487 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91eeb41c-1501-568e-81cf-b44bd4f6787f" :answer/type {:db/ident :answer.type/text} :answer/value "A paraboloid" :db/id #edb/ref 17592186401489} {:answer/id #uuid "2b39f102-3558-5351-90f8-01a7c7dbb286" :answer/type {:db/ident :answer.type/text} :answer/value "A cylinder" :db/id #edb/ref 17592186401490} {:answer/id #uuid "9d64cbe0-4403-549f-94d2-cf3c73ceb779" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186401491} {:answer/id #uuid "6ffa2b0d-b957-5c7c-a016-40f0594d1ea0" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186401492} {:answer/id #uuid "01e9c23e-64f6-5d8c-a235-0d406e419811" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186401493}] :answer-field/correct {:answer/id #uuid "01e9c23e-64f6-5d8c-a235-0d406e419811" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186401493} :answer-field/id #uuid "903d6dd5-4634-519d-8334-fc52eabb5e80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401488}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ef46611-6066-5608-b7b6-cb53d9ef1a50" :question/math-academy-id "q-164403" :question/problem "Identify the following surface: \n\n$$\n\\frac{(x-1)^{2}}{9}+\\frac{(y+2)^{2}}{7}+\\frac{{z}^{2}}{4}=1\n$$" :question/worked-solution "Recall that the equation of an ellipsoid centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1,\n$$\n\nand an ellipsoid centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}+\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=1,\n$$\n\nThus, our equation is an ellipsoid with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(1,-2,0),\\,a=3,\\,b=\\sqrt{7},\\,c=2.\n$$"}] [{:db/id #edb/ref 17592186401494 :knowledge-point/_questions [{:knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bf04dd9-c165-5182-ac9b-5676db24ff34" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186401496} {:answer/id #uuid "c793d63c-12e4-5933-97de-c7ed09f6bb6c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,-1)$" :db/id #edb/ref 17592186401497} {:answer/id #uuid "c61e78a2-beab-5682-9dcd-c175e8fd13fa" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}:\\text{ }x-y>12}" :db/id #edb/ref 17592186401498} {:answer/id #uuid "cb19e2aa-343d-50f8-8950-85499a932e8a" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(1,0)$" :db/id #edb/ref 17592186401499} {:answer/id #uuid "011e26cf-a2f4-5e6c-9930-618f8d6227cb" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,1)$" :db/id #edb/ref 17592186401500}] :answer-field/correct {:answer/id #uuid "c793d63c-12e4-5933-97de-c7ed09f6bb6c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,-1)$" :db/id #edb/ref 17592186401497} :answer-field/id #uuid "5199bacc-b680-59e5-9422-f0c044740659" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401495}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57563ddb-cece-5702-b61c-95f3f8e1ba05" :question/math-academy-id "q-164416" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1}.\n$$\n\nThis is a hyperbola centered at $(0,-1).$"}] [{:db/id #edb/ref 17592186401501 :knowledge-point/_questions [{:knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74d4f589-684f-54c3-98d4-d4a82b6d1f66" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186401503} {:answer/id #uuid "c8b1b394-3eb1-53d4-aa43-d93c484ebf19" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(5,1)$" :db/id #edb/ref 17592186401504} {:answer/id #uuid "52adf993-254f-51e6-8678-427a0e39d183" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}:xy=1}" :db/id #edb/ref 17592186401505} {:answer/id #uuid "92358f72-d64b-514a-80c8-595390361c59" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-5,0)$" :db/id #edb/ref 17592186401506} {:answer/id #uuid "1238065d-225e-5276-ac70-011b60b63f35" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(5,0)$" :db/id #edb/ref 17592186401507}] :answer-field/correct {:answer/id #uuid "92358f72-d64b-514a-80c8-595390361c59" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-5,0)$" :db/id #edb/ref 17592186401506} :answer-field/id #uuid "7ccdc892-8830-5973-bdbd-4e9a1948683b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401502}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a066ac1-6120-502f-9195-eb35e4541908" :question/math-academy-id "q-164417" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $(x+5)^{2}-{y}^{2}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n(x+5)^{2}-{y}^{2}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }(x+5)^{2}-{y}^{2}=1}.\n$$\n\nThis is a hyperbola centered at $(-5,0).$"}] [{:db/id #edb/ref 17592186401508 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "917478a6-9f85-5c2f-9abc-0e94e7aaed04" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186401510} {:answer/id #uuid "1549a164-9e45-5667-87ff-e1b8a78bcfbb" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186401511} {:answer/id #uuid "2993d1fe-f7db-55c9-8175-8657b7efaf2a" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186401512} {:answer/id #uuid "b72085af-190b-5b99-82c7-f2f831e98d50" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401513} {:answer/id #uuid "c6b6af54-c6f0-5204-a41b-545422423ddc" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186401514}] :answer-field/correct {:answer/id #uuid "917478a6-9f85-5c2f-9abc-0e94e7aaed04" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186401510} :answer-field/id #uuid "25021911-f878-5c6e-8755-61db8e40936f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401509}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1cc40487-6e8d-55c3-bbc9-868108f22530" :question/math-academy-id "q-164476" :question/problem "Identify the following surface: \n\n$$\n\\frac{(x+1)^{2}}{3}+\\frac{{y}^{2}}{4}-(z-2)^{2}=-1\n$$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1,\n$$\n\nand a hyperboloid of two sheets centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}-\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=-1,\n$$\n\nThus, our equation is a hyperboloid of two sheets with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(-1,0,2),\\,a=\\sqrt{3},\\,b=2,\\,c=1.\n$$"}] [{:db/id #edb/ref 17592186401515 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a76405be-1788-5e72-94d6-117c29e7aadb" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186401517} {:answer/id #uuid "f9d6b36f-0169-5c05-b658-232c406af7ef" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186401518} {:answer/id #uuid "548a6000-5c46-5dd3-9714-417aaea346a7" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186401519} {:answer/id #uuid "d5e1f556-c2cb-575c-8407-5c88361da39e" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186401520} {:answer/id #uuid "5e8fd86a-c981-5765-9ec0-cde9abb54c7b" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401521}] :answer-field/correct {:answer/id #uuid "548a6000-5c46-5dd3-9714-417aaea346a7" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186401519} :answer-field/id #uuid "962dfec3-feb3-5f4c-9675-1a5ee6fae954" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401516}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37f3129a-ae32-5711-8b8d-cb83602d7d4e" :question/math-academy-id "q-164477" :question/problem "Identify the following surface:\n\n$$\n\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{2}=1,\\,-\\infty <z<\\infty .\n$$" :question/worked-solution "Recall that the equation of an elliptic cylinder centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is an elliptic cylinder with $a=b=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186401522 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea6ba4f0-2d64-5c1c-b8ce-059c4ac25b64" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186401524} {:answer/id #uuid "94d5b7bc-b4a2-5f44-8d1f-5fae8941458e" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186401525} {:answer/id #uuid "224f132d-2588-5cb3-93cf-da8c9190c61d" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186401526} {:answer/id #uuid "8f342e45-8c79-5472-a082-fe42127fb510" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186401527} {:answer/id #uuid "6db8c8a8-71c1-5bf5-8418-3d407d9ca9f1" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401528}] :answer-field/correct {:answer/id #uuid "6db8c8a8-71c1-5bf5-8418-3d407d9ca9f1" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401528} :answer-field/id #uuid "4009320d-45e7-537c-bae9-47fb3fceb5ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401523}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a3947ec-3744-5af7-8ce2-1be319e6d154" :question/math-academy-id "q-164479" :question/problem "Identify the following surface: \n\n$$\n\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{16}=1,\\,-\\infty <z<\\infty .\n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder, whose axis of symmetry is the $z$-axis, is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is a hyperbolic cylinder with $a=3,\\,b=4.$"}] [{:db/id #edb/ref 17592186401529 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121542ce-6356-51c9-90a7-86cd6ba2b5e8" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186401531} {:answer/id #uuid "e8d6c8c7-34c2-5007-b993-6a2477b8f4ff" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186401532} {:answer/id #uuid "b98c944e-85b6-5534-ab35-0f7cf75123b1" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186401533} {:answer/id #uuid "9e8f1c2e-2ed2-5741-ad54-ce3d99d51afd" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186401534} {:answer/id #uuid "d521747d-2c8e-5cb8-b7c2-c2125829bd87" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401535}] :answer-field/correct {:answer/id #uuid "d521747d-2c8e-5cb8-b7c2-c2125829bd87" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186401535} :answer-field/id #uuid "689c4fa8-7285-5e24-ac05-5212e0e90119" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "540afee8-a0c6-54b4-b0fc-ff72c9dd4c07" :question/math-academy-id "q-164481" :question/problem "Identify the following surface: \n\n$$\n(x+2)^{2}-(y-1)^{2}=1,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder, whose axis of symmetry is the $z$-axis, is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1,\n$$\n\nand a hyperbolic cylinder, whose axis of symmetry is parallel to the $z$-axis and passes through the point $({x}_{0},{y}_{0})$ in the $xy$-plane, is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is a hyperbolic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(-2,1),\\,a=b=1.\n$$"}] [{:db/id #edb/ref 17592186284506 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd6eaa8-586c-5103-b0cc-92a8aaaf1a7e" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186281813} {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282020} {:answer/id #uuid "2b318cd8-3045-5788-9bb8-ab1134992947" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282075} {:answer/id #uuid "56d2cf8c-c2ea-5087-9d96-d9a6dcd9d5dd" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186282432} {:answer/id #uuid "eafb0571-17a8-5784-a800-513c70030f56" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186283749}] :answer-field/correct {:answer/id #uuid "2556d713-7643-5e10-b347-3ff594c56f13" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186282020} :answer-field/id #uuid "09284adb-1272-5cf4-81c3-aa20d058b0a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e28adc4e-c42a-55a7-ab38-db39626f07cf" :question/math-academy-id "q-164510" :question/problem "Identify the surface $x=\\frac{{y}^{2}}{2}+\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic paraboloid centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\nx=\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic paraboloid whose axis of symmetry is the $x$-axis and $b=\\sqrt{2},\\,c=2.$"}] [{:db/id #edb/ref 17592186401536 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed669204-c56c-5225-aefc-956037ae0d37" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401538} {:answer/id #uuid "359f70ba-f3cf-563a-9d19-52e3ff5fe27b" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401539} {:answer/id #uuid "d5285b0d-7ee4-5490-8561-775dea047606" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186401540} {:answer/id #uuid "74313148-6534-5531-9101-2416622ea616" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis is the $z$-axis" :db/id #edb/ref 17592186401541} {:answer/id #uuid "d9ce9479-a493-554f-88d6-f3b32cbf67e2" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186401542}] :answer-field/correct {:answer/id #uuid "359f70ba-f3cf-563a-9d19-52e3ff5fe27b" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186401539} :answer-field/id #uuid "fa665e14-2670-50c6-9aa4-6148466ac38d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50443007-c819-5285-a74f-1d6dfd323e6d" :question/math-academy-id "q-164547" :question/problem "Identify the following surface:\n\n$$\n{y}^{2}=2z,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{y}^{2}=4pz.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186401543 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "755a881c-6b14-5e96-bd68-6af58d5ef813" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $1$" :db/id #edb/ref 17592186401545} {:answer/id #uuid "5965e390-56a0-55ef-a7dc-eff34c09cc53" :answer/type {:db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $1$" :db/id #edb/ref 17592186401546} {:answer/id #uuid "1f629da2-c549-5180-8903-3a78b8767616" :answer/type {:db/ident :answer.type/text} :answer/value "$4\\sqrt{2}$ and $2$" :db/id #edb/ref 17592186401547} {:answer/id #uuid "1c1fc5c2-bdfa-52e9-a59e-c6227d171448" :answer/type {:db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186401548} {:answer/id #uuid "47a16fa9-9d49-55d0-a143-c2b6cca5c4dc" :answer/type {:db/ident :answer.type/text} :answer/value "$2\\sqrt{2}$ and $2$" :db/id #edb/ref 17592186401549}] :answer-field/correct {:answer/id #uuid "1f629da2-c549-5180-8903-3a78b8767616" :answer/type {:db/ident :answer.type/text} :answer/value "$4\\sqrt{2}$ and $2$" :db/id #edb/ref 17592186401547} :answer-field/id #uuid "b41dd28d-0ca0-5222-9cfe-700ddaa37f17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401544}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e791f5b6-5e18-534a-99e5-45cc16c1809f" :question/math-academy-id "q-16455" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{1}+\\frac{{y}^{2}}{8}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=1$ and ${b}^{2}=8.$\n\n- Since ${a}^{2}=1,$ the length of the horizontal radius must be $a=\\sqrt{1}=1.$\n\n- Since ${b}^{2}=8,$ the length of the vertical radius must be $b=\\sqrt{8}=2\\sqrt{2}.$\n\nSo the semi-major axis has length $b=2\\sqrt{2},$ and the semi-minor axis has length $a=1.$\n\nTherefore, the major axis has length $2b=2\\cdot 2\\sqrt{2}=4\\sqrt{2},$ and the minor axis has length $2a=2\\cdot 1=2.$"}] [{:db/id #edb/ref 17592186401550 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1243d3b-361e-5bdf-975f-049a3ec6fa01" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,-1)$" :db/id #edb/ref 17592186401552} {:answer/id #uuid "fa487f89-3be7-5d40-961d-7546309e11de" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186401553} {:answer/id #uuid "025044f2-a8e8-56c9-abcc-e56e1609a263" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186401554} {:answer/id #uuid "1c63b753-83a9-5faf-9522-2b10200701ec" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186401555} {:answer/id #uuid "a76c934a-6a50-5b6b-97fe-08774387e03f" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,1,1)$" :db/id #edb/ref 17592186401556}] :answer-field/correct {:answer/id #uuid "fa487f89-3be7-5d40-961d-7546309e11de" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186401553} :answer-field/id #uuid "fffbfe5a-e6b2-509f-a19b-67c3c7c49922" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401551}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "040e9acf-1af9-5813-86f6-e469cb0eecc9" :question/math-academy-id "q-164553" :question/problem "Identify the surface $5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15 & =0 \\\\ 5({x}^{2}+4x)-{y}^{2}-5({z}^{2}-2z)+15 & =0 \\\\ 5[(x+2)^{2}-4]-{y}^{2}-5[(z-1)^{2}-1]+15 & =0 \\\\ 5(x+2)^{2}-20-{y}^{2}-5(z-1)^{2}+5+15 & =0 \\\\ 5(x+2)^{2}-{y}^{2}-5(z-1)^{2} & =0 \\\\ -5(x+2)^{2}+{y}^{2}+5(z-1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(-2,0,1).$"}] [{:db/id #edb/ref 17592186401557 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff8dd7e4-d04f-54e0-9c82-7503faa98408" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,-2,0)$" :db/id #edb/ref 17592186401559} {:answer/id #uuid "6ee2009b-db2c-5ad5-a30f-47e82534faf3" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/id #edb/ref 17592186401560} {:answer/id #uuid "0eacccc9-5134-5c35-b00f-adda5251c8bd" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,2,1)$" :db/id #edb/ref 17592186401561} {:answer/id #uuid "1d5f9579-d5b4-564c-9ff2-31895a46959d" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,-2,0)$" :db/id #edb/ref 17592186401562} {:answer/id #uuid "c2873b29-87cc-5f23-93ab-b79ab215b691" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,2,1)$" :db/id #edb/ref 17592186401563}] :answer-field/correct {:answer/id #uuid "ff8dd7e4-d04f-54e0-9c82-7503faa98408" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,-2,0)$" :db/id #edb/ref 17592186401559} :answer-field/id #uuid "f0d3a90f-543b-5602-bf42-4796008282b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401558}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "84fd9eec-1cf5-594c-8917-00bf240277f1" :question/math-academy-id "q-164555" :question/problem "Identify the surface ${x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11 & =0 \\\\ ({x}^{2}-2x)+5({y}^{2}+4y)+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5([y+2)^{2}-4]+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5(y+2)^{2}-20+{z}^{2}+11 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2} & =10 \\\\ \\frac{(x-1)^{2}}{10}+\\frac{(y+2)^{2}}{2}+\\frac{{z}^{2}}{10} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipsoid centered at $(1,-2,0).$"}]}
