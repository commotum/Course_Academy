#{[{:db/id #edb/ref 17592186401839 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ddbc91f-a2bc-5c20-979a-ce7e906dc06d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}2x+y-2z=1 \\\\ 3x+2y+3z=2 \\\\ 4x+3y+4z=3\\end{aligned}" :db/id #edb/ref 17592186401841} {:answer/id #uuid "ca1394d8-a03f-5e29-aaba-bb0176d8f59b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}2x+y+2z=1 \\\\ 3x-2y+3z=2 \\\\ 4x+3y+4z=3\\end{aligned}" :db/id #edb/ref 17592186401842} {:answer/id #uuid "9761f4c8-5981-5fd5-88ce-d6d56601691c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}2x+y+2z=1 \\\\ 3x+2y+3z=2 \\\\ 4x+3y+4z=3\\end{aligned}" :db/id #edb/ref 17592186401843} {:answer/id #uuid "13919b67-24a3-5f25-90aa-a16013b5b7e6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}2x+y+2z=1 \\\\ x+2y+3z=2 \\\\ 4x+3y+z=3\\end{aligned}" :db/id #edb/ref 17592186401844} {:answer/id #uuid "2f7be1b8-6206-50f4-9b88-856c8d8e718a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}2x+y+2z=1 \\\\ 3x+y+3z=-2 \\\\ x+3y+4z=3\\end{aligned}" :db/id #edb/ref 17592186401845}] :answer-field/correct {:answer/id #uuid "9761f4c8-5981-5fd5-88ce-d6d56601691c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}2x+y+2z=1 \\\\ 3x+2y+3z=2 \\\\ 4x+3y+4z=3\\end{aligned}" :db/id #edb/ref 17592186401843} :answer-field/id #uuid "a8af118b-89c1-56df-aee8-e8ea929b9eb7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5cb76d6-8596-56c0-bf91-5764390c6dbb" :question/math-academy-id "q-20362" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}2 & 1 & 2 & 1 \\\\ 3 & 2 & 3 & 2 \\\\ 4 & 3 & 4 & 3\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n{\\begin{aligned}2x+y+2z=1 \\\\ 3x+2y+3z=2 \\\\ 4x+3y+4z=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401846 :knowledge-point/_questions [{:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401848} {:answer/id #uuid "7b15bc55-e6d8-5c21-b55e-568e588591b8" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186401849} {:answer/id #uuid "2c8c26cd-3204-5045-8920-160928c0068e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186401850} {:answer/id #uuid "7828179c-427e-5c33-a7ae-bd0edbe05cfe" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186401851} {:answer/id #uuid "db0ee922-0122-505b-abc7-21b2699ea220" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186401852}] :answer-field/correct {:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401848} :answer-field/id #uuid "0ec6f4c2-cef2-5136-bda0-046075ea56a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a11f695c-004e-57f4-b1f5-cd09434f69e2" :question/math-academy-id "q-20851" :question/problem "For the parametric curve \n\n$$\nx=2\\sqrt{t},\\,y=12t+1,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{1}{\\sqrt{t}},\\,{y}^{′}(t)=12.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{12}{\\frac{1}{\\sqrt{t}}}=12\\sqrt{t}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =12\\sqrt{1} \\\\  & =12\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106155 :knowledge-point/_questions [{:knowledge-point/id #uuid "65f742e7-89c6-543b-b43a-f41c27f35abf" :knowledge-point/title "Finding the General Solution of a Singular 3x3 System of Equations with One Pivot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b345fefc-1a1b-5902-8dd5-899abe1effb3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]+z[\\begin{aligned}4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186401854} {:answer/id #uuid "bc5fc700-54a5-5fd4-baab-ddc94fdb3fc0" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186401855} {:answer/id #uuid "85a5ea74-3dfe-53d7-a75c-1f909a7f8bb7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]+z[\\begin{aligned}-4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186401856} {:answer/id #uuid "c137c596-06bd-536e-868a-22fa042d4332" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186401857} {:answer/id #uuid "01f0000f-6b48-549c-8c07-55de9522db7b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}1 \\\\ 0 \\\\ -1\\end{aligned}]+z[\\begin{aligned}4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186401858}] :answer-field/correct {:answer/id #uuid "c137c596-06bd-536e-868a-22fa042d4332" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186401857} :answer-field/id #uuid "81971273-5ed1-5672-ab54-cbe5f79a2ee1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401853}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d7b7ec-0149-5969-9f8f-fedef6cf0475" :question/math-academy-id "q-20966" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & -1 & 4 & -1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$\n\nFind the general solution of the linear system represented by the matrix." :question/worked-solution "The system corresponding to $M$ is\n\n$$\n{\\begin{aligned}x-y+4z=-1 \\\\ 0x+0y+0z=0 \\\\ 0x+0y+0z=0.\\end{aligned}\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations $0x+0y+0z=0,$ we can remove these equations from the system. So, our system now consists of just a single equation:\n\n$$\nx-y+4z=-1\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables $y$ and $z.$ That means we need to find $x$ in terms of $y,z.$ Doing this, we get\n\n$$\nx=-1+y-4z.\n$$\n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}x=-1+y-4z \\\\ y=y \\\\ z=z,\\end{aligned}\n$$\n\nwhere $y$, $z$ (free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-1+y-4z \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-4 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401859 :knowledge-point/_questions [{:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "886ea0dd-2f3b-5230-a912-ca494bbb228c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2e}" :db/id #edb/ref 17592186401861} {:answer/id #uuid "1b58ab2c-a7ae-5296-9ea9-aaaf06b0d86c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186401862} {:answer/id #uuid "3480faea-4f30-5410-8c55-291a77967982" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3e}" :db/id #edb/ref 17592186401863} {:answer/id #uuid "1933a3b0-751e-5adc-a9a1-355a8352674b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186401864} {:answer/id #uuid "f9dd7c11-42ae-55e1-8e09-7e1133cc18c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186401865}] :answer-field/correct {:answer/id #uuid "f9dd7c11-42ae-55e1-8e09-7e1133cc18c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186401865} :answer-field/id #uuid "532bfa22-570e-5521-a58b-09bf6df9181b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401860}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c14e172-0d42-58ef-86b2-05fb93de9caa" :question/math-academy-id "q-20990" :question/problem "![](images/58/5855e92b04ffbf8447d32c7edb190cd16046a13e8808e6ffaade1f59e414c869.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=2t{e}^{t},\\,y={t}^{2}+2t,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2{e}^{t}(t+1),\\,{y}^{′}(t)=2t+2.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2t+2}{2{e}^{t}(t+1)}=\\frac{1}{{e}^{t}}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1}{{e}^{1}} \\\\  & =\\frac{1}{e}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083619 :knowledge-point/_questions [{:knowledge-point/id #uuid "3fc81cba-b997-54bc-9e11-0a4ff130833e" :knowledge-point/title "Determining the Points Where the Tangent is Horizontal or Vertical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "177fc0fe-e31a-5f41-9aab-356a0006fb3a" :answer/type {:db/ident :answer.type/text} :answer/value "$t=\\frac{3\\pi }{2}$ only" :db/id #edb/ref 17592186401867} {:answer/id #uuid "10683790-7483-51aa-9bcd-7831b9d3d041" :answer/type {:db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$" :db/id #edb/ref 17592186401868} {:answer/id #uuid "1843433f-102c-52fd-970b-a78c3d6b3a06" :answer/type {:db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ only" :db/id #edb/ref 17592186401869} {:answer/id #uuid "50097778-e660-56b2-929d-8baced007acc" :answer/type {:db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ and $t=\\frac{3\\pi }{4}$" :db/id #edb/ref 17592186401870} {:answer/id #uuid "835e0688-6998-5bbb-863e-83fa6322632b" :answer/type {:db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ only" :db/id #edb/ref 17592186401871}] :answer-field/correct {:answer/id #uuid "10683790-7483-51aa-9bcd-7831b9d3d041" :answer/type {:db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$" :db/id #edb/ref 17592186401868} :answer-field/id #uuid "f9d95bd4-f167-53f1-8c45-da39995abe7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbd878d8-e318-5109-beb9-89ecefca7f9d" :question/math-academy-id "q-21081" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4\\operatorname{sin}⁡t+7,\\,y=4\\operatorname{cos}⁡t+10,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=-4\\operatorname{sin}⁡t.\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n4\\operatorname{cos}⁡t=0\\,⟹\\,t=\\frac{\\pi }{2},\\frac{3\\pi }{2}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =-4\\ne 0, \\\\ {y}^{′}(\\frac{3\\pi }{2}) & =4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the tangent to the curve is indeed vertical when $t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}.$"}] [{:db/id #edb/ref 17592186401872 :knowledge-point/_questions [{:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3" :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve Containing Special Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a58988e-9e60-53e1-9ccc-6195ac2bdc85" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}-1}\\,\\text{d}t" :db/id #edb/ref 17592186401874} {:answer/id #uuid "c4824b8b-2ed7-5c3c-ae44-9e7e39c2adaa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186401875} {:answer/id #uuid "8e755153-eb7c-5c80-ac13-6bd2f55ebc06" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}-1}\\,\\text{d}t" :db/id #edb/ref 17592186401876} {:answer/id #uuid "8dadc22b-b156-5944-b045-f3c498f81787" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{t}+2}\\,\\text{d}t" :db/id #edb/ref 17592186401877} {:answer/id #uuid "89771be0-5923-5fe1-8923-30d66256f236" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186401878}] :answer-field/correct {:answer/id #uuid "89771be0-5923-5fe1-8923-30d66256f236" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186401878} :answer-field/id #uuid "f3d97d84-3165-5293-95f8-8ad9ae1b81ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a60afb71-a1f2-5589-86e8-84aaf38f221a" :question/math-academy-id "q-21353" :question/problem "![](images/4a/4aa2bca8faab077c47fb968882579233babe7d323ba3120088e8ea5599fbd570.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y=t$\nfrom $t=0$ to $t=2$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{({e}^{t})^{2}+(1)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}\\sqrt{{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401879 :knowledge-point/_questions [{:knowledge-point/id #uuid "875d7f2a-43ec-5635-8e72-48ae83d0339b" :knowledge-point/title "Translating Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ba36cad-3d3b-52fe-8da9-534ffd79e6c1" :answer/type {:db/ident :answer.type/text} :answer/value "For all $x\\in (1,\\infty ),\\,\\,{x}^{2}>x.$" :db/id #edb/ref 17592186401881} {:answer/id #uuid "d6110e32-9a48-58f5-a9da-5ed70f94bf07" :answer/type {:db/ident :answer.type/text} :answer/value "For some $x\\in (1,\\infty ),\\,\\,{x}^{2}>x.$" :db/id #edb/ref 17592186401882} {:answer/id #uuid "738c391b-269d-5c3a-8b74-cd075c624a45" :answer/type {:db/ident :answer.type/text} :answer/value "There exists at least one number $x\\in (1,\\infty )$ such that ${x}^{2}>x.$" :db/id #edb/ref 17592186401883} {:answer/id #uuid "c7d4a42d-e83d-55f4-8466-098995f56994" :answer/type {:db/ident :answer.type/text} :answer/value "If ${x}^{2}>x,$ then $x\\in (1,\\infty ).$" :db/id #edb/ref 17592186401884} {:answer/id #uuid "07c9511c-28dc-5f7a-9d27-cc053b0e17fa" :answer/type {:db/ident :answer.type/text} :answer/value "For all real numbers $x,$ either $x\\in (1,\\infty )$ or ${x}^{2}>x.$" :db/id #edb/ref 17592186401885}] :answer-field/correct {:answer/id #uuid "7ba36cad-3d3b-52fe-8da9-534ffd79e6c1" :answer/type {:db/ident :answer.type/text} :answer/value "For all $x\\in (1,\\infty ),\\,\\,{x}^{2}>x.$" :db/id #edb/ref 17592186401881} :answer-field/id #uuid "da2f987f-545e-5531-8f85-0b57a2cd730e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6336cc3e-143c-5d52-83b4-52b2733f351b" :question/math-academy-id "q-216463" :question/problem "$\\,$ $P(x):{x}^{2}>x$\n\nGiven the predicate above, which of the following expresses the statement $∀x\\in (1,\\infty ),\\,P(x)?$" :question/worked-solution "The universal quantifier \"$∀$\" means \"for all.\" So, the statement \n$∀x\\in (1,\\infty ),\\,P(x)$ \nreads as follows:\n\n$\\,$ **For all** $x\\in (1,\\infty ),$ ${x}^{2}>x.$\n\n**Note:** This statement is true."}] [{:db/id #edb/ref 17592186401886 :knowledge-point/_questions [{:knowledge-point/id #uuid "eb609a7e-467e-5003-b4c4-2a1637977443" :knowledge-point/title "Negating Existential Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5119e50-bd14-5fee-9b82-2344f54225fe" :answer/type {:db/ident :answer.type/text} :answer/value "For all $y\\in R,$ $\\frac{y}{2}$ is not real." :db/id #edb/ref 17592186401888} {:answer/id #uuid "36b80171-403c-5326-9454-7cb78c2f2f4d" :answer/type {:db/ident :answer.type/text} :answer/value "For all $y\\in R,$ $\\frac{y}{2}$ is real." :db/id #edb/ref 17592186401889} {:answer/id #uuid "45708669-67c8-542c-9a91-dd315dbb834d" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed." :db/id #edb/ref 17592186401890} {:answer/id #uuid "b3e7f6e8-1e52-5cc5-98e3-04a7bbd84474" :answer/type {:db/ident :answer.type/text} :answer/value "There exists $y\\in R$ such that $\\frac{y}{2}$ is real." :db/id #edb/ref 17592186401891} {:answer/id #uuid "45896d61-d63d-552c-858f-190cb028d8e6" :answer/type {:db/ident :answer.type/text} :answer/value "There exists $y\\in R$ such that $\\frac{y}{2}$ is not real." :db/id #edb/ref 17592186401892}] :answer-field/correct {:answer/id #uuid "36b80171-403c-5326-9454-7cb78c2f2f4d" :answer/type {:db/ident :answer.type/text} :answer/value "For all $y\\in R,$ $\\frac{y}{2}$ is real." :db/id #edb/ref 17592186401889} :answer-field/id #uuid "24925563-239f-5c15-a72e-dbb52acac1ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "804b67f2-c953-5690-bdac-d7da623929f0" :question/math-academy-id "q-216689" :question/problem "Negate the following statement:\n\n$\\,$ There exists $y\\in R$ such that $\\frac{y}{2}$ is not real." :question/worked-solution "If we denote\n\n$$\nP(y):\\frac{y}{2}\\text{ is real},\n$$\n\nour statement can be written as\n\n$$\n∃y\\in R,\\,¬P(y).\n$$\n\nNegating this, we obtain\n\n$$\n\\begin{aligned}¬(∃y\\in R,\\,¬P(y)) & ≡∀y\\in R,\\,¬¬P(y) \\\\  & ≡∀y\\in R,\\,P(y).\\end{aligned}\n$$\n\nFinally, $∀y\\in R,\\,P(y)$ reads as follows:\n\n$\\,$ **For all** $y\\in R,$ $\\frac{y}{2}$ is real."}] [{:db/id #edb/ref 17592186401893 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f423be97-7cf1-5892-a889-cd6b8dad197b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡|\\operatorname{ln}⁡x|}+C" :db/id #edb/ref 17592186401895} {:answer/id #uuid "a1be16c0-5889-5190-9b94-52c61fcd25d5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186401896} {:answer/id #uuid "e01f3245-4ea5-537d-ba0e-1dda5e71ae4e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡(\\operatorname{ln}⁡\\sqrt{2})+C" :db/id #edb/ref 17592186401897} {:answer/id #uuid "0802bc99-bb18-5591-b8e0-f242435e7f0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186401898} {:answer/id #uuid "99159f55-3655-56b7-986e-53df7b0da90a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{\\operatorname{ln}⁡|\\operatorname{ln}⁡x|}+C" :db/id #edb/ref 17592186401899}] :answer-field/correct {:answer/id #uuid "0802bc99-bb18-5591-b8e0-f242435e7f0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186401898} :answer-field/id #uuid "0ff01c23-3bf9-54e8-b3ae-815e53dd5059" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401894}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e0472f6-3d3e-5a0e-bbc2-09db07e6e756" :question/math-academy-id "q-2194" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{2}}{x\\operatorname{ln}⁡x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{2}}{x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\sqrt{2}\\int \\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\sqrt{2}\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\sqrt{2}\\operatorname{ln}⁡|u|+C \\\\  & =\\sqrt{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401900 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf2d579-5da0-5061-94f2-eec22eae7902" :knowledge-point/title "Finding Part of an Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "793fda82-4b8f-5357-8355-7eb714c2f363" :answer/type {:db/ident :answer.type/math} :answer/value "2t" :db/id #edb/ref 17592186401902} {:answer/id #uuid "b6a3c59d-ed02-5238-a8c6-fd2024482e82" :answer/type {:db/ident :answer.type/math} :answer/value "2-t" :db/id #edb/ref 17592186401903} {:answer/id #uuid "f6cd580d-4800-5b0c-92e0-e1600068f58e" :answer/type {:db/ident :answer.type/math} :answer/value "t" :db/id #edb/ref 17592186401904} {:answer/id #uuid "b627bbcd-b10a-5d39-a559-125ce37018ed" :answer/type {:db/ident :answer.type/math} :answer/value "2+t" :db/id #edb/ref 17592186401905} {:answer/id #uuid "ee753101-7bb5-5dbb-a4a6-c54e0820154f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186401906}] :answer-field/correct {:answer/id #uuid "b6a3c59d-ed02-5238-a8c6-fd2024482e82" :answer/type {:db/ident :answer.type/math} :answer/value "2-t" :db/id #edb/ref 17592186401903} :answer-field/id #uuid "618ade45-7715-5c2b-8e23-5edac27f8883" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401901}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6706b3e3-ba1f-5e48-a0c6-87c0de600ccd" :question/math-academy-id "q-225023" :question/problem "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx=v(2-u),\\,y=u{v}^{3}.\n$$\n\nThe image of the side ${S}_{3}$ under the action of $T$ is given by\n\n$$\nx=x(t),\\,y=t,\\,1\\ge t\\ge 0.\n$$\n\nFind the function $x(t).$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the side ${S}_{3}.$\n\nFor the side ${S}_{3},$ we have $1\\ge u\\ge 0$ and $v=1.$ Substituting $v=1$ into our transformation equations, we obtain \n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(v(2-u),\\,u{v}^{3}) \\\\  & =(1(2-u),\\,u(1)^{3}) \\\\  & =(2-u,u).\\end{aligned}\n$$\n\nSo, the image of ${S}_{3}$ can be parametrized by\n\n$$\nx=2-u,\\,y=u,\\,1\\ge u\\ge 0.\n$$\n\n \n\nWriting this in the usual notation, we have\n\n$$\nx(t)=2-t,\\,y(t)=t,\\,1\\ge t\\ge 0.\n$$"}] [{:db/id #edb/ref 17592186401907 :knowledge-point/_questions [{:knowledge-point/id #uuid "148c9c1d-236d-571f-89be-d1c03f7c39aa" :knowledge-point/title "Cases When a Square’s Side Is Mapped to a Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d42c473-b845-56f6-91ed-2f7569cdadf9" :answer/type {:db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from   $(1,1)$ to $(0,2).$" :db/id #edb/ref 17592186401909} {:answer/id #uuid "6dd13488-86ae-53ef-94b1-8445c40feae7" :answer/type {:db/ident :answer.type/text} :answer/value "An arc of a upward-opening parabola, traversed from $(0,2)$ to $(1,1).$" :db/id #edb/ref 17592186401910} {:answer/id #uuid "2eaf5793-614c-59c2-8266-69fcc04e0964" :answer/type {:db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(0,1)$ to $(-1,2).$" :db/id #edb/ref 17592186401911} {:answer/id #uuid "1cea9769-6304-556d-88e7-17fabaf6e8d9" :answer/type {:db/ident :answer.type/text} :answer/value "An arc of a right-opening parabola, traversed from $(0,1)$ to $(-1,2).$" :db/id #edb/ref 17592186401912} {:answer/id #uuid "132e7131-949c-5374-87b4-fafc2b9fee75" :answer/type {:db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(-1,2)$ to $(0,1).$" :db/id #edb/ref 17592186401913}] :answer-field/correct {:answer/id #uuid "2eaf5793-614c-59c2-8266-69fcc04e0964" :answer/type {:db/ident :answer.type/text} :answer/value "An arc of an upward-opening parabola, traversed from $(0,1)$ to $(-1,2).$" :db/id #edb/ref 17592186401911} :answer-field/id #uuid "47132c57-ee0e-5ec3-b95e-67a15913786d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401908}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bd99021-9f7b-5102-9e9a-342e79f39167" :question/math-academy-id "q-225228" :question/problem "![](images/33/33e48fa5bdbb034bcf489e038ccf80fc5f67baabeccacc1b7abd741183ebf05d.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nwhere \n\n$$\nx=\\frac{v-1}{u+1},\\,y=(u+v-1)^{2}+1.\n$$\n\nWhich of the following is the image of the side ${S}_{4}$ under the action of $T?$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the side ${S}_{4}.$\n\nFor the side ${S}_{4},$ we have $u=0$ and $1\\ge v\\ge 0.$ Substituting $u=0$ into our transformation equations, we obtain \n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(\\frac{v-1}{u+1},\\,(u+v-1)^{2}+1) \\\\  & =(\\frac{v-1}{0+1},\\,(0+v-1)^{2}+1) \\\\  & =(v-1,\\,(v-1)^{2}+1).\\end{aligned}\n$$\n\nSo, the image of ${S}_{4}$ can be parametrized by\n\n$$\nx=v-1,\\,y=(v-1)^{2}+1,\\,1\\ge v\\ge 0.\n$$\n\n \n\nWriting this in the usual notation, we have\n\n$$\nx=t-1,\\,y=(t-1)^{2}+1,\\,1\\ge t\\ge 0.\n$$\n\nThese are parametric equations of a parabolic arc. Notice that if we eliminate $t$ from the equations, we get\n\n$$\ny={x}^{2}+1\n$$\n\nwhich is an upward-opening parabola whose vertex is at $(0,1).$\n\nMoreover, the endpoints of ${S}_{4}$ are mapped to the $xy$-plane as follows:\n\n$$\n\\begin{aligned} & T:(0,1)\\to (\\frac{1-1}{0+1},(0+1-1)^{2}+1)=(0,1) \\\\  & T:(0,0)\\to (\\frac{0-1}{0+1},(0+0-1)^{2}+1)=(-1,2)\\end{aligned}\n$$\n\nTherefore, the image of ${S}_{4}$ is an arc of a upward-opening parabola, traversed from $(0,1)$ to $(-1,2).$\n\n![](images/69/69a2a8ab136360c01d1a17a58dc2fc4864ae2089330a551df913b200d923f087.png)"}] [{:db/id #edb/ref 17592186401914 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc62d8df-450f-5f7a-b647-b53c051f8339" :knowledge-point/title "Solving a System Containing Decimals in Both Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c29c57bf-e265-52a1-bca7-e9f5dad2f3f4" :answer/type {:db/ident :answer.type/text} :answer/value "$x=\\frac{4}{3},$ $y=-2$" :db/id #edb/ref 17592186401916} {:answer/id #uuid "211a2e7b-9745-58a0-94ae-5560db869797" :answer/type {:db/ident :answer.type/text} :answer/value "$x=1,$ $y=-3$" :db/id #edb/ref 17592186401917} {:answer/id #uuid "862aa3fb-5e83-5622-8209-8caba2d722df" :answer/type {:db/ident :answer.type/text} :answer/value "$x=\\frac{7}{3},$ $y=1$" :db/id #edb/ref 17592186401918} {:answer/id #uuid "30d0a7a2-ddd3-5355-ab33-3b6c7d057ae2" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2,$ $y=0$" :db/id #edb/ref 17592186401919} {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401920}] :answer-field/correct {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401920} :answer-field/id #uuid "e422abe5-7836-5aa6-bfb2-34896476a4d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401915}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d7c59ff-df86-5863-a05a-c20fb84b2ead" :question/math-academy-id "q-26223" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 \\\\ 0.6x+0.8y=0.2\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply both equations by $10,$ as follows:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 & |\\,\\times 10 \\\\ 0.6x+0.8y=0.2 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ 6x+8y=2\\end{aligned}\n$$\n\nNotice that if we divide the second equation by $(-2),$ we will get a $-3x$ term in the second equation that can cancel with the $3x$ term in the first equation:\n\n$$\n{\\begin{aligned}3x-y=6 &  \\\\ 6x+8y=2 & |\\,÷(-2)\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ -3x-4y=-1\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\cancel{3x}-y & =6 \\\\ -\\cancel{3x}-4y & =-1 \\\\ (-y-4y) & =(6-1) \\\\ -5y & =5 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally, we can substitute $y=-1$ into the equation $3x-y=6$ to solve for $x:$\n\n$$\n\\begin{aligned}3x-y & =6 \\\\ 3x-(-1) & =6 \\\\ 3x & =5 \\\\ x & =\\frac{5}{3}\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=\\frac{5}{3}$ and $y=-1.$"}] [{:db/id #edb/ref 17592186401921 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401923} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401924} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401925} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401926} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401927}] :answer-field/correct {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401927} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186115711 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e366677-1acc-548b-9d8a-043caa67d076" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186401929} {:answer/id #uuid "34c4cf88-6a77-5dc4-9298-de12464e93a4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401930} {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401931} {:answer/id #uuid "8e52e4ac-f6da-59c1-9b6c-569b5c0f46d4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401932} {:answer/id #uuid "87f49733-d7a3-52db-ba58-c47681214494" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401933}] :answer-field/correct {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401931} :answer-field/id #uuid "ae9fdfce-f210-5819-a39f-6d6ef14bee25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401928}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{sec}⁡x=1$\nII. $\\operatorname{sec}⁡x=2$\nIII. $\\operatorname{sec}⁡x=\\frac{1}{2}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186401934 :knowledge-point/_questions [{:knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c28cb971-d849-577e-9682-a8890d4ae773" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y>-x+1\\end{aligned}" :db/id #edb/ref 17592186401936} {:answer/id #uuid "d4c91422-9ef9-5a21-a3cd-6168971db223" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401937} {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401938} {:answer/id #uuid "129beb51-d7c5-5a45-86b1-53f54c6e7926" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401939} {:answer/id #uuid "1f5ea53c-6d9f-56de-99b0-c8f54f45ac23" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401940}] :answer-field/correct {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401938} :answer-field/id #uuid "210acf01-110f-53da-bf3c-8725abe1a7d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401935}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8229e-2a6a-582b-a6c3-627b88cf6816" :question/math-academy-id "q-29384" :question/problem "![](images/a7/a740aafbb9f74e2681506d3027f848fa92e7eea2bac3e08ccaf3fc7e0acf8fa1.png)\n\nWhich of the following systems of inequalities defines the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>x+2.\n$$\n\n    \n\nNow consider the line $y=-x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401941 :knowledge-point/_questions [{:knowledge-point/id #uuid "3497c02b-4c62-58d9-8c73-ee1a1142c429" :knowledge-point/title "Calculating the Rate of Change of a Leg Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074992e8-e1fa-5890-859b-ab91c898befa" :answer/type {:db/ident :answer.type/math} :answer/value "61\\text{ km/h}" :db/id #edb/ref 17592186401943} {:answer/id #uuid "95aa0b04-7251-5fbf-b2eb-66bafc65e559" :answer/type {:db/ident :answer.type/math} :answer/value "65.5\\text{ km/h}" :db/id #edb/ref 17592186401944} {:answer/id #uuid "336d2d1d-872d-56d4-a5f4-5bec78ef5250" :answer/type {:db/ident :answer.type/math} :answer/value "60\\text{ km/h}" :db/id #edb/ref 17592186401945} {:answer/id #uuid "35306f0e-0e84-5e47-a2f4-679a063c0acb" :answer/type {:db/ident :answer.type/math} :answer/value "70\\text{ km/h}" :db/id #edb/ref 17592186401946} {:answer/id #uuid "f0f8d307-81e4-50be-9385-c254d6f22bfb" :answer/type {:db/ident :answer.type/math} :answer/value "75.2\\text{ km/h}" :db/id #edb/ref 17592186401947}] :answer-field/correct {:answer/id #uuid "35306f0e-0e84-5e47-a2f4-679a063c0acb" :answer/type {:db/ident :answer.type/math} :answer/value "70\\text{ km/h}" :db/id #edb/ref 17592186401946} :answer-field/id #uuid "6827bd64-2698-5152-a010-779141f5c62e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "507fbe2b-2f95-5bfa-be32-3403810daadf" :question/math-academy-id "q-2939" :question/problem "![](images/92/9283bcc77ac8e63c1ba00f9a81e659bcbcf41bc98b94a1a0617b02feab71cf0a.png)\n\nCar $B$ is being driven due south toward Caltech at a speed of $60\\,\\text{km/h},$ while car $A$ is being driven due east away from Caltech. When car $B$ is $0.6\\,\\text{km}$ away from Caltech, car $A$ is $0.8\\,\\text{km}$ from Caltech. If the distance between the two vehicles is increasing at a rate of $20\\,\\text{km/h},$ what is the speed of car $A?$" :question/worked-solution "![](images/6e/6e7ef0d4665710a31c1c601048498f20ad6b3099769c1d140320074805964ec7.png)\n\nIn the diagram,\n\n- $x$ is the distance between Caltech and car $A$,\n\n- $y$ is the distance between Caltech and car $B$,\n\n- $z$ is the distance between the two cars.\n\nAs shown in the diagram, $x,$ $y,$ and $z$ form a right triangle with $z$ as the hypotenuse. We wish to find the rate of change of $x,$ which is $\\frac{\\text{d}x}{\\text{d}t}.$ \n\nWe know that $x=0.8\\,\\text{km}$ and $y=0.6\\,\\text{km}.$ We can find $z$ using the Pythagorean Theorem, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={z}^{2} \\\\ {0.8}^{2}+{0.6}^{2} & ={z}^{2} \\\\ {z}^{2} & =1 \\\\ z & =1\\,\\text{km}\\end{aligned}\n$$\n\nWe also know that:\n\n- $\\frac{\\text{d}y}{\\text{d}t}=-60\\,\\text{km}/\\text{h},$\n\n- $\\frac{\\text{d}z}{\\text{d}t}=20\\,\\text{km}/\\text{h}.$\n\nFinally, we differentiate both sides of ${x}^{2}+{y}^{2}={z}^{2}$ with respect to $t$ and then substitute in the known values, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}({z}^{2}) \\\\ 2x\\frac{\\text{d}x}{\\text{d}t}+2y\\frac{\\text{d}y}{\\text{d}t} & =2z\\frac{\\text{d}z}{\\text{d}t} \\\\ 2(0.8)\\frac{\\text{d}x}{\\text{d}t}+2(0.6)(-60) & =2(1)(20) \\\\ 1.6\\frac{\\text{d}x}{\\text{d}t} & =40+72 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{112}{1.6} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =70.\\end{aligned}\n$$\n\nTherefore, the speed of the car $A$ is $70\\,\\text{km}/\\text{h}.$"}] [{:db/id #edb/ref 17592186064711 :knowledge-point/_questions [{:knowledge-point/id #uuid "3497c02b-4c62-58d9-8c73-ee1a1142c429" :knowledge-point/title "Calculating the Rate of Change of a Leg Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e61c15b-79c7-5166-b178-3747e17866dd" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,000\\,\\text{km/h}" :db/id #edb/ref 17592186401949} {:answer/id #uuid "b14cf7b0-2299-5e5f-b5c6-d5c85c148877" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,250\\text{km/h}" :db/id #edb/ref 17592186401950} {:answer/id #uuid "b8011803-44bb-5708-a342-7bae100244be" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,350\\,\\text{km/h}" :db/id #edb/ref 17592186401951} {:answer/id #uuid "e2f10350-a4ef-5fe3-aef8-799220547f92" :answer/type {:db/ident :answer.type/math} :answer/value "975\\,\\text{km/h}" :db/id #edb/ref 17592186401952} {:answer/id #uuid "062254bd-0f6e-5f77-8e3b-5a1990d9eb27" :answer/type {:db/ident :answer.type/math} :answer/value "750\\,\\text{m/h}" :db/id #edb/ref 17592186401953}] :answer-field/correct {:answer/id #uuid "b14cf7b0-2299-5e5f-b5c6-d5c85c148877" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,250\\text{km/h}" :db/id #edb/ref 17592186401950} :answer-field/id #uuid "81478755-4be2-5ae2-9535-e8dd0fd9f860" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "216f383a-6fa0-5f0b-b2c6-22682df9e591" :question/math-academy-id "q-2941" :question/problem "A rocket that is launched vertically is tracked by a radar station located on\nthe ground $3\\,\\text{km}$ from the launch site. What is the vertical speed of the rocket at the instant when its distance from the radar station is $5\\,\\text{km}$ and this distance is increasing at a rate of $1\\,000\\,\\text{km/h}?$" :question/requires-calculator true :question/worked-solution "We start by drawing a diagram of the problem.\n\n![](images/7a/7af033f137fd76e5e3003926a598e695f4e0852b11dc27dfa84d58040144972b.png)\n\nIn the diagram,\n\n- $x$ is the distance between the radar station and the launch point,\n\n- $y$ is the distance between the launch point and the rocket, and\n\n- $z$ is the distance between the radar station and the rocket.\n\nAs shown in the diagram, $x,$ $y,$ and $z$ form a right triangle with $z$ as the hypotenuse. We wish to find the rate of change of $y,$ which is $\\frac{\\text{d}y}{\\text{d}t}.$ \n\nWe know that $x=3\\,\\text{km}$ and $z=5\\,\\text{km}.$ We can find $y$ using the Pythagorean Theorem, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={z}^{2} \\\\ {3}^{2}+{y}^{2} & ={5}^{2} \\\\ {y}^{2} & =16 \\\\ y & =4\\,\\text{km}\\end{aligned}\n$$\n\nWe also know that:\n\n- $\\frac{\\text{d}z}{\\text{d}t}=1\\,000\\,\\text{km}/\\text{h},$\n\n- the distance between the radar station and the launch point ($x$) remains the same, so $\\frac{\\text{d}x}{\\text{d}t}=0.$\n\nFinally, we differentiate both sides of ${x}^{2}+{y}^{2}={z}^{2}$ with respect to $t$ and then substitute in the known values:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}({z}^{2}) \\\\ 2x\\frac{\\text{d}x}{\\text{d}t}+2y\\frac{\\text{d}y}{\\text{d}t} & =2z\\frac{\\text{d}z}{\\text{d}t} \\\\ 2(3)(0)+2(4)\\frac{\\text{d}y}{\\text{d}t} & =2(5)(1\\,000) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{10\\,000}{8} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =1\\,250\\end{aligned}\n$$\n\nTherefore, the vertical speed of the rocket is $1\\,250\\,\\text{km}/\\text{h}.$"}] [{:db/id #edb/ref 17592186401954 :knowledge-point/_questions [{:knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b53db17c-c360-5669-8f88-e93f4bdbd8fb" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186401956} {:answer/id #uuid "25dcd0ff-82e2-5596-97c0-808147eeda5b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401957} {:answer/id #uuid "c06a013e-9247-5fe8-9462-4797376bce04" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401958} {:answer/id #uuid "5d5c203d-08c8-5beb-ba1e-76f154f20aea" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401959} {:answer/id #uuid "12121f61-eccf-5393-b245-c6404140579b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401960}] :answer-field/correct {:answer/id #uuid "25dcd0ff-82e2-5596-97c0-808147eeda5b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401957} :answer-field/id #uuid "8895f00a-eea4-5d81-b69d-a26ada8cb409" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401955}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c11092b-9e53-51e1-b299-c5287bf677e1" :question/math-academy-id "q-29477" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{csc}⁡x=\\frac{1}{3}$\nII. $\\operatorname{csc}⁡x=3$\nIII. $\\operatorname{csc}⁡x=1$" :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions."}] [{:db/id #edb/ref 17592186069223 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401962} {:answer/id #uuid "d00f8b18-cb37-5c31-961a-3438330ad683" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=6" :db/id #edb/ref 17592186401963} {:answer/id #uuid "ae0444d5-a369-5e49-89bd-c5ebc8c0237a" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=-11\\,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401964} {:answer/id #uuid "44f7e400-b932-5f1e-a0ab-bdb9a22e3846" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186401965} {:answer/id #uuid "7d8857d6-881c-5549-bde0-3f1a4f61d2d7" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=9\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401966}] :answer-field/correct {:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401962} :answer-field/id #uuid "b5fa6494-6274-595a-88b0-e033638de4a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401961}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c02e0e4e-c511-5b9e-9632-6db46dfe1bf6" :question/math-academy-id "q-30052" :question/problem "The equation ${x}^{2}-4x+4=9$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p+q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =9 \\\\ {x}^{2}-4x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =5 \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-4 & =5 \\\\ (x-2)^{2}-4 & =5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-2)^{2}-4 & =5 \\\\ (x-2)^{2} & =9\\end{aligned}\n$$\n\nSo, $p=-2,q=9,$ and $p+q=7.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =9 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{9} \\\\ x-2 & =\\pm 3 \\\\ x & =2\\pm 3\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+3=5 \\\\ {x}_{2} & =2-3=-1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=-1$ and ${x}_{2}=5.$ Thus, the sum is $4.$"}] [{:db/id #edb/ref 17592186401967 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401969} {:answer/id #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186401970} {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401971} {:answer/id #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401972} {:answer/id #uuid "b9d50863-24e6-52af-928c-18cf82d1862f" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186401973}] :answer-field/correct {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401971} :answer-field/id #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401968}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] [{:db/id #edb/ref 17592186097224 :knowledge-point/_questions [{:knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a3b2c4a-a63b-5807-aacc-5245a5e6b02f" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-4$ and $x=4$" :db/id #edb/ref 17592186401975} {:answer/id #uuid "46b9e8a3-14f5-5f69-831f-e7e0d797a1ec" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ and $x=4$" :db/id #edb/ref 17592186401976} {:answer/id #uuid "c082a9b0-d023-52a6-be52-56d8828805a4" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-6$ and $x=-2$" :db/id #edb/ref 17592186401977} {:answer/id #uuid "ea3248ac-1443-5057-98d3-f07c503f35c9" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186401978} {:answer/id #uuid "6e0e922d-f9cb-5465-99c6-9d8aecf68d80" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-4,$ $x=0,$ and $x=4$" :db/id #edb/ref 17592186401979}] :answer-field/correct {:answer/id #uuid "46b9e8a3-14f5-5f69-831f-e7e0d797a1ec" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ and $x=4$" :db/id #edb/ref 17592186401976} :answer-field/id #uuid "9ff50305-88e5-5409-b5ae-8fb7fea82cf0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05af1cea-c88c-5fcc-8838-0055bd7f29aa" :question/math-academy-id "q-31213" :question/problem "![](images/19/19e9763d62ca7818024bf49522a127a48dd04f76d1175c93e060a1043b6a5795.png)\n\nThe function $f(x)$ is continuous and twice-differentiable for all $x.$ The graph $y={f}^{″}(x)$ is shown above. At what value(s) of $x$ does $f(x)$ have a point of inflection?" :question/worked-solution "First, notice that since $f(x)$ is twice-differentiable, the tangent line to the graph exists for all real $x.$\n\nInflection points occur when a graph changes concavity. In order for the graph to change concavity, the value of the second derivative ${f}^{″}(x)$ must switch sign. So, we are looking for points where the graph of ${f}^{″}(x)$ crosses the $x$-axis.\n\nWe can see that the graph $y={f}^{″}(x)$ crosses the $x$-axis at $x=0$ and $x=4.$ \n\nTherefore, $f(x)$ has points of inflection at $x=0$ and $x=4.$"}] [{:db/id #edb/ref 17592186401980 :knowledge-point/_questions [{:knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f18ae8c-d034-5c1c-af41-b32f52e9728d" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-6$ and $x=2$" :db/id #edb/ref 17592186401982} {:answer/id #uuid "3c2ac919-d0f0-55be-b66b-077be2492a74" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-6$ and $x=-2$" :db/id #edb/ref 17592186401983} {:answer/id #uuid "b6faa5c0-12ea-54ed-86d4-4c1d75cbd567" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-2$ and $x=2$" :db/id #edb/ref 17592186401984} {:answer/id #uuid "96d32a85-ec32-5353-9868-3cb1ac090a40" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186401985} {:answer/id #uuid "a41d1397-7de6-584c-b009-e1eca0c2916b" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-6,\\,$ $x=-2,$ and $x=2$" :db/id #edb/ref 17592186401986}] :answer-field/correct {:answer/id #uuid "7f18ae8c-d034-5c1c-af41-b32f52e9728d" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-6$ and $x=2$" :db/id #edb/ref 17592186401982} :answer-field/id #uuid "2def65a7-d460-55e9-9537-f22df65257ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401981}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98bca65a-5215-5c3c-9419-26f83fa4001a" :question/math-academy-id "q-31219" :question/problem "![](images/5d/5d776a61d1039639d91e2c667c68965d3e2c901cdc926e8c54e6356cf1d87c2e.png)\n\nThe function $g(x)$ is continuous and twice-differentiable for all $x.$ The graph $y={g}^{″}(x)$ is shown above. At what value(s) of $x$ does $g(x)$ have a point of inflection?" :question/worked-solution "First, notice that since $g(x)$ is twice-differentiable, the tangent line to the graph exists for all real $x.$ \n\nInflection points occur when a graph changes concavity. In order for the graph to change concavity, the value of the second derivative ${g}^{″}(x)$ must switch signs. So, we are looking for points where the graph of ${g}^{″}(x)$ crosses the $x$-axis.\n\nWe can see that the graph $y={g}^{″}(x)$ crosses the $x$-axis at $x=-6$ and $x=2.$\n\nTherefore, $g(x)$ has points of inflection at $x=-6$ and $x=2.$"}] [{:db/id #edb/ref 17592186401987 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "491969ed-8b76-5f12-8e92-e2c07f40a5f2" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{5}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}" :db/id #edb/ref 17592186401989} {:answer/id #uuid "47e753ff-b001-5c13-a3e5-fa0b1469d565" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}" :db/id #edb/ref 17592186401990} {:answer/id #uuid "0f0a1d9a-26c8-5f3e-8675-24c9ff948a9f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=3{R}_{2},\\,{R}_{1}:={R}_{1}+5{R}_{2}" :db/id #edb/ref 17592186401991} {:answer/id #uuid "345a93b2-c8e2-542e-9732-fd3c08c01fef" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{1}{3}{R}_{2}" :db/id #edb/ref 17592186401992} {:answer/id #uuid "80637310-e8ef-5a17-b8ea-c4cf7c2aacb4" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}" :db/id #edb/ref 17592186401993}] :answer-field/correct {:answer/id #uuid "47e753ff-b001-5c13-a3e5-fa0b1469d565" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}" :db/id #edb/ref 17592186401990} :answer-field/id #uuid "f08b9f41-8719-5f37-ae27-999f6560f9f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401988}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0ac0783b-5b73-5c8c-959b-6029e5d56c68" :question/math-academy-id "q-31872" :question/problem "The inverse of the matrix $J$ is found using row operations, as shown below. What are the row operations corresponding to the blank spaces?\n\n$$\n\\begin{aligned}[J\\,|\\,I] & =[\\begin{aligned}2 & -5 & 1 & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & \\frac{5}{6} \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $J$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $J$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[J\\,|\\,I] & =[\\begin{aligned}2 & -5 & 1 & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{5}{2} & \\frac{1}{2} & 0 \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}] & {R}_{1} & :={R}_{1}+\\frac{5}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & \\frac{1}{2} & \\frac{5}{6} \\\\ 0 & 1 & 0 & \\frac{1}{3}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:=\\frac{1}{2}{R}_{1},\\,{R}_{2}:=\\frac{1}{3}{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{5}{2}{R}_{2}.\n$$\n\nThe matrix ${J}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{J}^{-1}=[\\begin{aligned}\\frac{1}{2} & \\frac{5}{6} \\\\ 0 & \\frac{1}{3}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186401994 :knowledge-point/_questions [{:knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bd5bb7-0a8a-5edb-975d-4fd5f046599e" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186401996} {:answer/id #uuid "08992256-6bf5-5ba6-a198-d2f970ef2ab7" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401997} {:answer/id #uuid "52bbf42f-38cf-5d5c-af4e-ee00925fa061" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401998} {:answer/id #uuid "61cc3875-ca37-5eff-9f67-f6c05f654183" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401999} {:answer/id #uuid "5af54dbb-f852-501b-bb4f-1e25a922f13c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402000}] :answer-field/correct {:answer/id #uuid "08992256-6bf5-5ba6-a198-d2f970ef2ab7" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401997} :answer-field/id #uuid "b3cd4133-bfb2-57ca-9d13-24b0af1c763d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "561c404c-366e-5e58-b3aa-1094d48ff6e7" :question/math-academy-id "q-31919" :question/problem "Which of the following completes the statement so that it is true:\n\n*If $det(A)\\ne 0,$ where $A$ is a $2\\times 2$-matrix, then $A$ is $\\text{__________}$ .*\n\nI. invertible\nII. **not ** invertible\nIII. singular" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.  \n\nNow, since the fifth part of the invertible matrix theorem is true ($det(A)\\ne 0$), all the other parts of the theorem are true too. Therefore, according to the theorem, only option I gives a true statement:\n\n- *If $det(A)\\ne 0$ , then $A$ is invertible.* $\\,✓$"}] [{:db/id #edb/ref 17592186402001 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e" :knowledge-point/title "Determining the Row Operations Required To Find the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4eea07e-f2f3-5991-9f8c-d1a3d485cb8f" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1},\\,{R}_{1}:={R}_{1}+4{R}_{2}" :db/id #edb/ref 17592186402003} {:answer/id #uuid "b42745fe-be44-51aa-b6af-8f31a15a57a1" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-2){R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{3}{4}{R}_{2}" :db/id #edb/ref 17592186402004} {:answer/id #uuid "428db092-3f21-5636-9fa7-75f2fd6123d6" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+(-1){R}_{1},\\,{R}_{1}:={R}_{1}+(-3){R}_{2}" :db/id #edb/ref 17592186402005} {:answer/id #uuid "8f69e7f4-02bf-5a3c-99ee-ec0db4ec6abb" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+\\frac{1}{2}{R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{1}{3}{R}_{2}" :db/id #edb/ref 17592186402006} {:answer/id #uuid "3e91bc4e-4104-5e61-9a68-1d8607d11d41" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{4}{3}{R}_{2}" :db/id #edb/ref 17592186402007}] :answer-field/correct {:answer/id #uuid "3e91bc4e-4104-5e61-9a68-1d8607d11d41" :answer/type {:db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{1}:={R}_{1}+\\frac{4}{3}{R}_{2}" :db/id #edb/ref 17592186402007} :answer-field/id #uuid "b2cc2c12-ff60-5e41-a718-fde30b82b390" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402002}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8e64088-2308-5369-8285-5d893b0dfcdf" :question/math-academy-id "q-31945" :question/problem "The inverse of the matrix $K$ is found using row operations, as shown below. What are the row operations corresponding to the blank spaces?\n\n$$\n\\begin{aligned}[K\\,|\\,I] & =[\\begin{aligned}-3 & 4 & 1 & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3} & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & 1 & -2 & 3\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & -3 & 4 \\\\ 0 & 1 & -2 & 3\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $K$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $K$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[K\\,|\\,I] & =[\\begin{aligned}-3 & 4 & 1 & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ -2 & 3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3} & 1\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{4}{3} & -\\frac{1}{3} & 0 \\\\ 0 & 1 & -2 & 3\\end{aligned}] & {R}_{1} & :={R}_{1}+\\frac{4}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -3 & 4 \\\\ 0 & 1 & -2 & 3\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:=-\\frac{1}{3}{R}_{1},\\,{R}_{2}:={R}_{2}+2{R}_{1},\\,{R}_{2}:=3{R}_{2},\\,{R}_{1}:={R}_{1}+\\frac{4}{3}{R}_{2}.\n$$\n\nThe matrix ${K}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{K}^{-1}=[\\begin{aligned}-3 & 4 \\\\ -2 & 3\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186402008 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a4b135f-df0d-5443-bb93-796f32c380c6" :knowledge-point/title "Identifying the Inverse of a 2x2 Matrix Calculated Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4683baa-7e31-565a-90dd-81bc97617456" :answer/type {:db/ident :answer.type/math} :answer/value "{D}^{-1}=[\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186402010} {:answer/id #uuid "e66e39bf-af21-54ee-9c01-1e665e79afcb" :answer/type {:db/ident :answer.type/math} :answer/value "{D}^{-1}=[\\begin{aligned}-1 & -1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186402011} {:answer/id #uuid "ffb3bda1-f364-5e06-b3f9-1ec1294cdafe" :answer/type {:db/ident :answer.type/math} :answer/value "{D}^{-1}=[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186402012} {:answer/id #uuid "8ae71a29-b56a-5e44-b3f7-481f0faef4bc" :answer/type {:db/ident :answer.type/math} :answer/value "{D}^{-1}=[\\begin{aligned}1 & 1 \\\\ 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186402013} {:answer/id #uuid "e81114b5-b5d4-5ed1-9aad-cfda69edeb8e" :answer/type {:db/ident :answer.type/math} :answer/value "{D}^{-1}=[\\begin{aligned}1 & 1 \\\\ -1 & -2\\end{aligned}]" :db/id #edb/ref 17592186402014}] :answer-field/correct {:answer/id #uuid "d4683baa-7e31-565a-90dd-81bc97617456" :answer/type {:db/ident :answer.type/math} :answer/value "{D}^{-1}=[\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186402010} :answer-field/id #uuid "ce793d72-97c8-5680-9b23-e9cde7d661bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402009}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1fb0889d-6fed-5243-aaf7-929089854f2b" :question/math-academy-id "q-31954" :question/problem "The inverse of the $2\\times 2$ matrix $D$ is found using row operations, as shown below. Complete the process, and determine ${D}^{-1}.$\n\n$$\n\\begin{aligned}[D\\,|\\,I] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & -1 & -2 & 1\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{1} & :=\\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 &  &  \\\\ 0 & 1 &  & \\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $D$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $D$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[D\\,|\\,I] & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & -1 & -2 & 1\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 1 \\\\ 0 & 1 & 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nThe matrix ${D}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{D}^{-1}=[\\begin{aligned}-1 & 1 \\\\ 2 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186402015 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d81e3f1-d930-59ee-b439-2a3645aebb6c" :knowledge-point/title "Solving a Consistent System of Equations Using Gauss-Jordan Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3ccae38-2121-52d3-adbe-774101358f5f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402017} {:answer/id #uuid "bd1763ae-5fcd-5d4b-b18a-af3a643749d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8-{x}_{3} \\\\ 3+3{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402018} {:answer/id #uuid "300bc792-b634-5ba3-8561-858fdf7d8d69" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-8{x}_{3} \\\\ 6-6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402019} {:answer/id #uuid "55911223-4948-5180-95bf-96b38f95603a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-6{x}_{3} \\\\ 10+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402020} {:answer/id #uuid "e5a39045-c764-56cd-a094-6caa0b024ef0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-{x}_{3} \\\\ 6+{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402021}] :answer-field/correct {:answer/id #uuid "c3ccae38-2121-52d3-adbe-774101358f5f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186402017} :answer-field/id #uuid "94d6271a-24bd-58c0-9553-83b2dc10742e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f65d67ed-b94b-50cc-87d4-9aa7130f7547" :question/math-academy-id "q-32247" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}{x}_{1}+2{x}_{2}-2{x}_{3}=4 \\\\ -2{x}_{1}-3{x}_{2}-2{x}_{3}=-2.\\end{aligned}\n$$\n\n \nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{aligned}].\n$$\n\nUsing the standard Gauss-Jordan method, we can reduce this matrix to reduced row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -2 & 4 \\\\ -2 & -3 & -2 & -2\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -2 & 4 \\\\ 0 & 1 & -6 & 6\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 10 & -8 \\\\ 0 & 1 & -6 & 6\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now  \n\n$$\n{\\begin{aligned} & {x}_{1}+10{x}_{3}=-8 \\\\  & {x}_{2}-6{x}_{3}=6.\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are ${x}_{1}$ and ${x}_{2},$ and we have one free variable, ${x}_{3}.$ That means we need to find ${x}_{1}$ and ${x}_{2}$ in terms of ${x}_{3}.$ \n\nTherefore, the general solution is\n\n$$\n{\\begin{aligned}{x}_{1}=-8-10{x}_{3} \\\\ {x}_{2}=6+6{x}_{3} \\\\ {x}_{3}={x}_{3},\\end{aligned}\n$$\n\nwhere ${x}_{3}$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402022 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8d3a4ec-7531-5a58-8454-d19869fb21eb" :knowledge-point/title "Determining the Continuity of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09f63e48-7661-5659-ba85-f776e6101ea1" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186402024} {:answer/id #uuid "c5afdbb2-d8b4-53b7-a14e-dc8bce9f0e87" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $h(t)$ only" :db/id #edb/ref 17592186402025} {:answer/id #uuid "cbd1d4d3-2d1e-5b75-ba7e-8c3f063e1ddf" :answer/type {:db/ident :answer.type/text} :answer/value "All the functions are continuous at $t=0$" :db/id #edb/ref 17592186402026} {:answer/id #uuid "5a43738f-363a-5de1-9bad-40504d08726c" :answer/type {:db/ident :answer.type/text} :answer/value "$g(t)$ and $h(t)$ only" :db/id #edb/ref 17592186402027} {:answer/id #uuid "1dedb7fb-0e93-57f7-a7d5-b9044d3f5144" :answer/type {:db/ident :answer.type/text} :answer/value "$g(t)$ only" :db/id #edb/ref 17592186402028}] :answer-field/correct {:answer/id #uuid "cbd1d4d3-2d1e-5b75-ba7e-8c3f063e1ddf" :answer/type {:db/ident :answer.type/text} :answer/value "All the functions are continuous at $t=0$" :db/id #edb/ref 17592186402026} :answer-field/id #uuid "a2d80644-598d-52f6-81f1-3f59a94eb57e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402023}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95526ab5-adbc-57eb-9fe3-cf21f5b51d6d" :question/math-academy-id "q-32373" :question/problem "Which of the following vector-valued functions are continuous at $t=0?$\n\n$$\n\\begin{aligned}f(t) & =⟨{t}^{2},\\,7t+6,\\,3-{t}^{3}⟩ \\\\ g(t) & =⟨1,\\,{t}^{2/3},\\,t⟩ \\\\ h(t) & =⟨{t}^{2},\\,\\sqrt[3]{t},\\,2t+3⟩\\end{aligned}\n$$" :question/worked-solution "A vector-valued function is continuous at a point if and only if each of its components is continuous at that point. \n\nLet's consider the functions one-by-one. \n\n- The function $f(t)$ is continuous at $t=0$ because each of its components ${t}^{2}$, $7t+6$ and $3-{t}^{3}$are continuous at $t=0.$\n\n- The function $g(t)$ is continuous at $t=0$ because each of its components $1$,  ${t}^{2/3}$ and $t$  are continuous at $t=0.$\n\n- The function $h(t)$ is continuous at $t=0$ because each of its components ${t}^{2}$, $\\sqrt[3]{t}$ and $2t+3$ are continuous at $t=0.$\n\nTherefore, the answer is:\n\n$\\,$ All the functions are continuous at $t=0$"}] [{:db/id #edb/ref 17592186129586 :knowledge-point/_questions [{:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39" :knowledge-point/title "Finding the General Solution to a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a872eb-6635-5701-9ed5-8eb0a33709e2" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1}\\in R" :db/id #edb/ref 17592186402030} {:answer/id #uuid "3bb3d6c2-db2b-5faa-b000-9d6b331c8070" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402031} {:answer/id #uuid "abb39b52-dd18-5df8-a5af-f84fac501c06" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402032} {:answer/id #uuid "55dfb5d2-b647-54c5-af77-52b2a5d5ea07" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402033} {:answer/id #uuid "dfba25c3-fa45-56a2-a736-7025ac326b12" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1}\\in R" :db/id #edb/ref 17592186402034}] :answer-field/correct {:answer/id #uuid "55dfb5d2-b647-54c5-af77-52b2a5d5ea07" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402033} :answer-field/id #uuid "f95e5646-83c9-5ea4-84fa-6be151721bec" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402029}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b78e718-c7bd-590c-b65a-fabb1ffe4981" :question/math-academy-id "q-324453" :question/problem "Find the general solution to the system of differential equations \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=2.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}1 & 3 \\\\ 1 & -1\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-2\\,\\text{and}\\,{\\lambda }_{2}=2.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-2,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}3 & 3 \\\\ 1 & 1\\end{aligned}]∼[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=2,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-1 & 3 \\\\ 1 & -3\\end{aligned}]∼[\\begin{aligned}1 & -3 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}3 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129587 :knowledge-point/_questions [{:knowledge-point/id #uuid "2a962d5e-5cc9-530e-9f95-85c399af7e4b" :knowledge-point/title "Determining the Decoupling Substitution of a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a797ac7-33c4-512f-90f8-59eb16783f56" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-2{u}_{2}(t) \\\\ {x}_{2}(t)=3{u}_{2}(t)\\end{aligned}" :db/id #edb/ref 17592186402036} {:answer/id #uuid "54d062ef-f5a7-554f-9aec-32b3e4d45203" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)=-{u}_{2}(t)\\end{aligned}" :db/id #edb/ref 17592186402037} {:answer/id #uuid "a9817443-5f2f-5697-b9b4-facc30ec893f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/id #edb/ref 17592186402038} {:answer/id #uuid "bb06d79b-0719-5c04-a4f5-69705749bb3e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}_{1}(t)=2{u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)=2{u}_{2}(t)\\end{aligned}" :db/id #edb/ref 17592186402039} {:answer/id #uuid "a0f2d3e6-cd5c-5ab7-a220-8d6563dfe260" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)+{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/id #edb/ref 17592186402040}] :answer-field/correct {:answer/id #uuid "a9817443-5f2f-5697-b9b4-facc30ec893f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/id #edb/ref 17592186402038} :answer-field/id #uuid "d6c339bd-cf81-5ede-a22f-a63cc71054fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402035}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c347aa2-fe8e-5437-94e5-a44fd44640d6" :question/math-academy-id "q-324455" :question/problem "Find the substitution that will decouple the following system of differential equations: \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{2}(t)\\end{aligned}\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}].$\n\n- Since $A$ is upper-triangular, the eigenvalues are \n\n$$\n{\\lambda }_{1}=3\\,\\text{and}\\,{\\lambda }_{2}=1.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=3,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}0 & 2 \\\\ 0 & -2\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}2 & 2 \\\\ 0 & 0\\end{aligned}]∼[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nTherefore, we have $E=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}].$\n\nFinally, the change of variables that decouples the system is given by $x(t)=Eu(t)$, or equivalently,\n\n$$\n{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402041 :knowledge-point/_questions [{:knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d476e061-e62e-516d-a210-085f525da0f0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186402043} {:answer/id #uuid "fd6e6397-9397-52a6-ae26-dbbab796036e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186402044} {:answer/id #uuid "4e9ea285-612d-5a27-90ce-9aac6b9d11bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 0 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186402045} {:answer/id #uuid "683b97cc-4e24-5dae-871f-704c3c57f91e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186402046} {:answer/id #uuid "936ed705-fd9f-5e57-9360-5bc6b86acdee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186402047}] :answer-field/correct {:answer/id #uuid "fd6e6397-9397-52a6-ae26-dbbab796036e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186402044} :answer-field/id #uuid "10f01866-5785-5c51-bd4f-76009cfa054f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402042}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df166e56-b183-5016-9f58-5d60ce55786e" :question/math-academy-id "q-32546" :question/problem "Given that $A=[\\begin{aligned}2 & -3 \\\\ 4 & -5\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices: \n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & -3 \\\\ 4 & -5\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115776 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b06f36c-5690-5392-a40a-f670e7419923" :knowledge-point/title "Determining the Differentiability of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ba69f7-a434-5ff4-969c-fa8fa69d9be0" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186402049} {:answer/id #uuid "3264961f-a437-5289-bec4-efa2d5756979" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $h(t)$ only" :db/id #edb/ref 17592186402050} {:answer/id #uuid "f87b02d9-9e85-582c-84c5-09942dae9dd3" :answer/type {:db/ident :answer.type/text} :answer/value "None of them are differentiable on $(0,\\pi )$" :db/id #edb/ref 17592186402051} {:answer/id #uuid "fae54900-ccf7-5a50-91e3-eb3eccd28c4d" :answer/type {:db/ident :answer.type/text} :answer/value "All of them are differentiable on $(0,\\pi )$" :db/id #edb/ref 17592186402052} {:answer/id #uuid "ff0a0f63-eca8-57ec-a462-c2093a71fe9e" :answer/type {:db/ident :answer.type/text} :answer/value "$g(t)$ and $h(t)$ only" :db/id #edb/ref 17592186402053}] :answer-field/correct {:answer/id #uuid "15ba69f7-a434-5ff4-969c-fa8fa69d9be0" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186402049} :answer-field/id #uuid "0d70eb46-6632-54ee-b92a-5875a0ef49c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11a6774d-821b-5df3-83c4-601fbb258758" :question/math-academy-id "q-32568" :question/problem "Which of the following vector-valued functions are differentiable with respect to $t$ on $t\\in (0,\\pi )?$\n\n$$\n\\begin{aligned}f(t) & =⟨\\operatorname{sin}⁡(2t),\\,\\operatorname{cos}⁡t,\\,2-\\operatorname{cos}⁡(2t)⟩ \\\\ g(t) & =⟨1+{t}^{2},\\,-t+2,\\,\\sqrt{t}⟩ \\\\ h(t) & =⟨\\frac{1}{t},\\,\\operatorname{tan}⁡t,\\,\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "All of these vector-valued functions are defined for all $t\\in (0,\\pi ).$ \n\nA function is differentiable on the interval $(0,\\pi )$ if and only if each of \n its component functions are differentiable on that interval.\n\nLet's now consider the functions one-by-one.\n\n- We differentiate $f(t)$ to find ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2-\\operatorname{cos}⁡(2t))⟩ \\\\  & =⟨2\\operatorname{cos}⁡(2t),\\,-\\operatorname{sin}⁡t,\\,2\\operatorname{sin}⁡(2t)⟩\\end{aligned}\n$$\n\nSince each component of ${f}^{′}(t)$ is defined for all  $t\\in (0,\\pi )$, we conclude that $f(t)$ is differentiable on this interval.\n\n- Next, we differentiate $g(t)$  to find ${g}^{′}(t):$\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1+{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-t+2),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨2t,\\,-1,\\,\\frac{1}{2\\sqrt{t}}⟩\\end{aligned}\n$$\n\nSince each component of ${g}^{′}(t)$ is defined for all $(0,\\pi )$, we have that   $g(t)$ is also differentiable on this interval.\n\n- Finally, we differentiate $h(t)$ to find ${h}^{′}(t):$\n\n$$\n\\begin{aligned}{h}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =⟨-\\frac{1}{{t}^{2}},\\,{sec}^{2}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nSince the second component of this vector, $\\operatorname{sec}⁡t$, is undefined at $t=\\frac{\\pi }{2}$,  we conclude that the function $h(t)$ is not differentiable on $(0,\\pi ).$\n\nTherefore, the answer is:\n\n$\\,$ $f(t)$ and $g(t)$ only"}] [{:db/id #edb/ref 17592186120196 :knowledge-point/_questions [{:knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7abb7a-38b8-51e1-aca2-0d2b5391e4f5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402055} {:answer/id #uuid "1602c8f1-24ac-5bc4-886f-c23bd7016636" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186402056} {:answer/id #uuid "9cc39e06-17c8-5b75-b657-4b4e1555cf14" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186402057} {:answer/id #uuid "c3f664b1-8db7-5e54-b116-e1469468f127" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 5 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402058} {:answer/id #uuid "a602201c-06fb-5598-8925-dcc674ce2b17" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402059}] :answer-field/correct {:answer/id #uuid "a602201c-06fb-5598-8925-dcc674ce2b17" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186402059} :answer-field/id #uuid "b453da57-6eef-5d7a-9c79-162c447ab3b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402054}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10430503-ea48-51a6-b4f8-6c1fb5c683b2" :question/math-academy-id "q-32569" :question/problem "Given that \n$A=[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{aligned}]$\nhas the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices.\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} & ⟺ & \\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 4\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 4\\end{aligned}]}_{⏟}}_{U}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402060 :knowledge-point/_questions [{:knowledge-point/id #uuid "9279d979-74ba-5504-b98a-63692db3af72" :knowledge-point/title "Finding the LU Factorization of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eab33316-9a2a-5e12-b51c-b02a826d1b0c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]" :db/id #edb/ref 17592186402062} {:answer/id #uuid "1bad7312-2e66-5700-9aae-eb7c85b9c383" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186402063} {:answer/id #uuid "7f572362-82aa-5062-a6d6-241eb9bbaaef" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 18 & 1\\end{aligned}]" :db/id #edb/ref 17592186402064} {:answer/id #uuid "a48759ab-5bd7-525d-8ee8-1aa323ee45c5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 5 & 32\\end{aligned}]" :db/id #edb/ref 17592186402065} {:answer/id #uuid "55aa56c5-1a06-51f3-9787-5f99d9d8585f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186402066}] :answer-field/correct {:answer/id #uuid "55aa56c5-1a06-51f3-9787-5f99d9d8585f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186402066} :answer-field/id #uuid "1f4ecb30-087b-5664-9448-53b7642eb521" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402061}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7e3bf80-d71d-502c-8977-ed540b710cc2" :question/math-academy-id "q-32608" :question/problem "Given that  $A=[\\begin{aligned}1 & 5 \\\\ -5 & -7\\end{aligned}]$ has the LU decomposition $A=LU,$ then $L=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 \\\\ -5 & -7\\end{aligned}] & {R}_{2} & :={R}_{2}+5{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}}\\cdot D \\\\  & ∼[\\begin{aligned}1 & 5 \\\\ 0 & 18\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -5 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 5 \\\\ 0 & 18\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120212 :knowledge-point/_questions [{:knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24743710-ccae-5ce6-b9bd-ec3e3a56e15a" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,-2,\\,3" :db/id #edb/ref 17592186402068} {:answer/id #uuid "d50d3f79-94d2-5665-9a7d-33432a11e564" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,-5,\\,3" :db/id #edb/ref 17592186402069} {:answer/id #uuid "aa28f05d-2582-5b23-a7d7-5ac2da1040ef" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,-5,\\,1" :db/id #edb/ref 17592186402070} {:answer/id #uuid "7167e25c-1100-59e0-8e73-47c13073ebe0" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,-5,\\,4" :db/id #edb/ref 17592186402071} {:answer/id #uuid "4746c90f-6d0d-57b3-b8bf-7604a4ec6128" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,-2,\\,4" :db/id #edb/ref 17592186402072}] :answer-field/correct {:answer/id #uuid "7167e25c-1100-59e0-8e73-47c13073ebe0" :answer/type {:db/ident :answer.type/math} :answer/value "0,\\,-5,\\,4" :db/id #edb/ref 17592186402071} :answer-field/id #uuid "a81fb830-b280-555b-983a-34f12dd2e101" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402067}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce5c7307-c449-5fe7-8928-1317176c796c" :question/math-academy-id "q-32772" :question/problem "$$\n{{[\\begin{aligned}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{aligned}]}_{⏟}}_{A}={{[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 2 & 0 & 1\\end{aligned}]}_{⏟}}_{L}\\cdot {{[\\begin{aligned}2 & 3 & -1 \\\\ \\boxed{} & \\boxed{} & \\boxed{} \\\\ 0 & 0 & -2\\end{aligned}]}_{⏟}}_{U}.\n$$\n\nConsider the LU factorization of the matrix $A$ above. From left to right, what are the missing elements from the second row of the matrix $U?$" :question/worked-solution "The matrix $U$ in the LU decomposition is obtained from the original matrix $A$ by row-reducing using Gaussian elementation. In particular, to make $0$ at the position ${a}_{21}$ of the matrix $A,$ we proceed as follows:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 3 & -1 \\\\ 0 & -5 & 4 \\\\ 4 & 6 & -4\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, from left to right, the elements from the second row of $U$ are $0,-5,$ and $4.$"}] [{:db/id #edb/ref 17592186402073 :knowledge-point/_questions [{:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39" :knowledge-point/title "Finding the General Solution to a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa35b3d1-b162-5941-885d-8db182d4c937" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402075} {:answer/id #uuid "47bb5c03-56ca-5b3a-9ba9-d6c4be7af812" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402076} {:answer/id #uuid "72f7434b-6af7-53ee-bdbc-e38c8f39837c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402077} {:answer/id #uuid "5f0e91d3-d561-5c05-80db-683f07d1c4f4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402078} {:answer/id #uuid "93e87a9b-599c-5a66-8fb7-bd8983873641" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402079}] :answer-field/correct {:answer/id #uuid "47bb5c03-56ca-5b3a-9ba9-d6c4be7af812" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402076} :answer-field/id #uuid "0fe2e4cc-de53-5a7a-8325-103564fb6a3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402074}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cca77f3c-b8b3-5463-80d6-aae528e0d55f" :question/math-academy-id "q-327976" :question/problem "Find the general solution to the system of differential equations \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-4{x}_{1}(t)+3{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=1.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-3 & 2 \\\\ -4 & 3\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-1\\,\\text{and}\\,{\\lambda }_{2}=1.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-1,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-2 & 2 \\\\ -4 & 4\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-4 & 2 \\\\ -4 & 2\\end{aligned}]∼[\\begin{aligned}1 & -\\frac{1}{2} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402080 :knowledge-point/_questions [{:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39" :knowledge-point/title "Finding the General Solution to a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d02b41e1-8e36-5518-81f1-e2f6825869f4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402082} {:answer/id #uuid "cd48207e-6122-5485-be51-43956eb3e0ac" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1}\\in R" :db/id #edb/ref 17592186402083} {:answer/id #uuid "5032c363-ccdd-5824-884a-40d99378e4cd" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402084} {:answer/id #uuid "112f3fd7-e749-5dda-8050-204e1edb598f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{4t},\\,{c}_{1}\\in R" :db/id #edb/ref 17592186402085} {:answer/id #uuid "88dceeef-1df2-5cb0-92dd-bbf3d61e6940" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402086}] :answer-field/correct {:answer/id #uuid "5032c363-ccdd-5824-884a-40d99378e4cd" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186402084} :answer-field/id #uuid "3737eb4c-9c7f-5503-aca6-74894a835bb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402081}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94d96b96-98bb-5063-b4f0-15839c9585ed" :question/math-academy-id "q-327989" :question/problem "Find the general solution to the system of differential equations\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=4{x}_{1}(t)-2{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=2.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}3 & -1 \\\\ 4 & -2\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-1\\,\\text{and}\\,{\\lambda }_{2}=2.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-1,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}4 & -1 \\\\ 4 & -1\\end{aligned}]∼[\\begin{aligned}1 & -\\frac{1}{4} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].$\n\n- For ${\\lambda }_{2}=2,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}1 & -1 \\\\ 4 & -4\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120222 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4636870-89db-5bf9-8a04-777407957e33" :knowledge-point/title "Finding Points Where a Tangent Vector is Parallel to Another Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "754f30f6-05c6-5575-a6bd-d8228629df28" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1,2)$ and $(8,e,2e)$" :db/id #edb/ref 17592186402088} {:answer/id #uuid "9cf74d58-2c01-59d6-a721-6e7f621cea0e" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1,1)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402089} {:answer/id #uuid "31f3d5ba-15f4-5f33-b534-c97e0bf58653" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,1,2)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402090} {:answer/id #uuid "3fbd3fdc-1447-52b4-83b7-2d0d7c8672c5" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1,2)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402091} {:answer/id #uuid "78a43baf-f3b1-5839-b974-cb8da7856e5a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1,1)$ and $(4,e,2e)$" :db/id #edb/ref 17592186402092}] :answer-field/correct {:answer/id #uuid "3fbd3fdc-1447-52b4-83b7-2d0d7c8672c5" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1,2)$ and $(8,{e}^{2},2{e}^{2})$" :db/id #edb/ref 17592186402091} :answer-field/id #uuid "1c2ccd35-074d-50ff-bf17-a0b3922ccfb0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402087}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e918f3b-d930-5ea5-9b21-8651bb576465" :question/math-academy-id "q-32918" :question/problem "Given the curve $r(t)=⟨2{t}^{2}\\,,\\,{e}^{t}\\,,\\,2{e}^{t}⟩$, find all of the points at which ${r}^{′}(t)$ and $r(t)$ are parallel." :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}(2{e}^{t})⟩ \\\\  & =⟨4t,\\,{e}^{t},\\,2{e}^{t}⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $r(t)$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that $r({t}_{0})=c\\,{r}^{′}({t}_{0}).$ So, we have\n\n$$\n\\begin{aligned}r(t) & =c\\,{r}^{′}(t) \\\\ ⟨2{t}^{2},\\,{e}^{t},\\,2{e}^{t}⟩ & =c\\,⟨4t,\\,{e}^{t},\\,2{e}^{t}⟩ \\\\ ⟨2{t}^{2},\\,{e}^{t},\\,2{e}^{t}⟩ & =⟨4ct,\\,c{e}^{t},\\,2c{e}^{t}⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n{\\begin{aligned}2{t}^{2}=4ct \\\\ {e}^{t}=c{e}^{t} \\\\ 2{e}^{t}=2c{e}^{t}\\end{aligned}\n$$\n\nFrom the second and third equations, we obtain that $c=1.$ Substituting into the first equation, we get\n\n$$\n\\begin{aligned}2{t}^{2} & =1\\cdot 4t \\\\ {t}^{2} & =2t \\\\ {t}^{2}-2t & =0 \\\\ t(t-2) & =0.\\end{aligned}\n$$\n\nTherefore, $r$ and ${r}^{′}$ are parallel only at the points corresponding to $t=0$ and $2.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(0) & =⟨2(0)^{2},\\,{e}^{0},\\,2{e}^{0}⟩ \\\\  & =⟨0,\\,1,\\,2⟩ \\\\ r(2) & =⟨2(2)^{2},\\,{e}^{2},\\,2{e}^{2}⟩ \\\\  & =⟨8,\\,{e}^{2},\\,2{e}^{2}⟩,\\end{aligned}\n$$\n\nwe conclude that $r(t)$ and ${r}^{′}(t)$ are parallel at the points $(0,1,2)$ and $(8,{e}^{2},2{e}^{2}).$"}] [{:db/id #edb/ref 17592186120245 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d74ada3-9243-5f7c-ade2-62caa4b9c021" :answer/type {:db/ident :answer.type/math} :answer/value "(7,1,-4)" :db/id #edb/ref 17592186402094} {:answer/id #uuid "2ddeb712-2499-5385-8cf5-8d5841c638be" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,7)" :db/id #edb/ref 17592186402095} {:answer/id #uuid "c3a42789-8ed3-50da-bd89-5ed82656d5bd" :answer/type {:db/ident :answer.type/math} :answer/value "(-8,1,1)" :db/id #edb/ref 17592186402096} {:answer/id #uuid "4f5b4306-4e52-5f8f-a6c5-d9a8c474f65b" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186402097} {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402098}] :answer-field/correct {:answer/id #uuid "b73612ac-9159-5b03-82b8-04dc3dbeb325" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-4,1)" :db/id #edb/ref 17592186402098} :answer-field/id #uuid "1ba93ced-d091-5536-afc3-ce47413fdf3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402093}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49e4fa98-401d-5c2d-a49c-1997a8550033" :question/math-academy-id "q-33203" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-5,0,1⟩+t⟨-3,1,0⟩,\\,Π:-3x+y-2z+27=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-5-3t,t,1⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}-3x+y-2z+27 & =0 \\\\ -3x+y-2z & =-27 \\\\ ⟨x,y,z⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ r\\cdot ⟨-3,1,-2⟩ & =-27\\end{aligned}\n$$\n\nNow, substituting $r=⟨-5-3t,t,1⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ ⟨-5-3t,t,1⟩\\cdot ⟨-3,1,-2⟩ & =-27 \\\\ -3(-5-3t)+1\\cdot t-2\\cdot 1 & =-27 \\\\ 15+9t+t-2 & =-27 \\\\ 10t & =-40 \\\\ t & =-4.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-4$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-5-3(-4),-4,1⟩ \\\\  & =⟨7,-4,1⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(7,-4,1).$"}] [{:db/id #edb/ref 17592186402099 :knowledge-point/_questions [{:knowledge-point/id #uuid "caf29808-4551-56a0-ac86-a4587a06fc0f" :knowledge-point/title "Finding the Intersection Point of a Line and a Plane Given in Other Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/ident :answer.type/math} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402101} {:answer/id #uuid "2cec0929-bdd8-5d7b-8ece-52cdde4c6f93" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-2,6)" :db/id #edb/ref 17592186402102} {:answer/id #uuid "c23c18d5-4a2a-5884-8422-592e07e7f5b2" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186402103} {:answer/id #uuid "50770341-c200-5dd2-a57c-f88a32fa60ee" :answer/type {:db/ident :answer.type/math} :answer/value "(3,4,8)" :db/id #edb/ref 17592186402104} {:answer/id #uuid "b695496a-1b9b-5846-a379-f0e3c0d96851" :answer/type {:db/ident :answer.type/math} :answer/value "(14,8,3)" :db/id #edb/ref 17592186402105}] :answer-field/correct {:answer/id #uuid "fb5e385e-d48b-552d-92db-b2c42b730f55" :answer/type {:db/ident :answer.type/math} :answer/value "(3,8,14)" :db/id #edb/ref 17592186402101} :answer-field/id #uuid "0878a66a-d92b-5043-a146-6c379d55810e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402100}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eaab1f60-24fb-5572-8cfb-474f418bf09f" :question/math-academy-id "q-33205" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-1,-2,6⟩+t⟨2,5,4⟩,\\,Π:x+2y+z-33=0.\n$$" :question/worked-solution "Let's start by writing the equation of the line as\n\n$$\nr=⟨-1+2t,-2+5t,6+4t⟩.\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}x+2y+z-33 & =0 \\\\ x+2y+z & =33 \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ r\\cdot ⟨1,2,1⟩ & =33\\end{aligned}\n$$\n\nNow, substituting $r=⟨-1+2t,-2+5t,6+4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,2,1⟩ & =33 \\\\ ⟨-1+2t,-2+5t,6+4t⟩\\cdot ⟨1,2,1⟩ & =33 \\\\ -1+2t+2(-2+5t)+6+4t & =33 \\\\ -1+2t-4+10t+6+4t & =33 \\\\ 16t & =32 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨-1+2(2),-2+5(2),6+4(2)⟩ \\\\  & =⟨3,8,14⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(3,8,14).$"}]}
