 {:db/id "q-15133/ma-source-field/1e1037b28b4bfbf7682f4a6184c2f8ff3613aed7833bb6fab3572c72f2e293dc/914aad4d0420d1799c5c315a7e1271b89a310f23c1b44a95935775721acf1c19" :answer/id #uuid "c77b2f36-6be8-50c0-ae22-868fa6cf86a1" :answer/type :answer.type/math :answer/value "3{\\int }_{0}^{\\pi /4}\\sqrt{{sin}^{2}⁡(4\\theta )+16{cos}^{2}⁡(4\\theta )}\\,\\text{d}\\theta " :db/ensure [:answer/validate]}
