 {:db/id "q-143037/ma-source-field/440bfe2adc4481798ce184d45c43505ef190758d0ffcb740230143c5712dcb51/f7bbaf7d27c02d59fc150831da2577db4ffa51037a582d8fe1f2cf9725dea0df" :answer/id #uuid "e048b22c-334e-593c-a1bb-448f1e70ae12" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}H}{\\text{d}t}=-kH,\\,\\,k>0" :db/ensure [:answer/validate]}
