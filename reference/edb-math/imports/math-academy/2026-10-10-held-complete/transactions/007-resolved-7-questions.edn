 {:db/id "q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4" :answer-field/id #uuid "b3dd9699-b980-5dfd-8981-2e277c08e891" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4/cbc4e187b2ebd68afcd828e04c9ab102796dd48ed6f097171966f76a9f8bc623" "q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4/30759faa981004f4a845018305cd97b05b3df401f1af5f03828f351be9981bc8" "q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4/d09fcc5c04955b4f0467ac1dba0a88f70432fcff7629f87ea1957530ff9b8841" "q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4/af6a17b410251a9b2c880bc4617c4c19e71ddd64dda2f7b850f53dbfc8c847d1" "q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4/8747571c5bfc3ec50ef90efe2dbdc6a3bc073ec1be0dd315aa12a6433ca3345d"] :answer-field/correct "q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4/d09fcc5c04955b4f0467ac1dba0a88f70432fcff7629f87ea1957530ff9b8841" :db/ensure [:answer-field/validate]}
 {:db/id "q-15323" :question/id #uuid "676c520e-2bd4-5a9f-a56a-7aedf1c83e6b" :question/math-academy-id "q-15323" :question/problem "Which of the following gives the length of the curve $y=\\operatorname{ln}⁡x$ on $[1,2]?$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\operatorname{ln}⁡x,$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{1}{x}\n$$\n\nSubstituting ${f}^{′}(x)=\\frac{1}{x}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}\\sqrt{1+{[{f}^{′}(x)]}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\sqrt{1+\\frac{1}{{x}^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\sqrt{\\frac{1+{x}^{2}}{{x}^{2}}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{\\sqrt{1+{x}^{2}}}{x}\\,\\text{d}x\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15323/ma-source-field/f97b5ffe65ff57b3897d3751f9ee60ca5a3d4e5bd1dc12853c3557eb0837c2c4"] :db/ensure [:question/validate]}
