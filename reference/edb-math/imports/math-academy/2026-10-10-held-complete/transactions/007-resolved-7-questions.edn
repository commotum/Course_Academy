 {:db/id "q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c" :answer-field/id #uuid "9ac60323-fbe0-5435-bfb2-619a71c7a175" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c/b9c139909868a3d4b752b5a75b5ac5232bbd7bfcdb6447a7eefeb8019de9b92a" "q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c/6adc291ee7bb1cc8576285c20160d2a33c881576edb977260dc662dab0efcda6" "q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c/c472159a782af18f1ece5b4fa4430da4e7d47d5d6393b9a6e8bda979d7466cb1" "q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c/a8b31d1634a327d12d205d04c66213864f5dedc9f286571b9dbe0a8b51d46441" "q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c/850405fce28be121a63a508f203fc6e13ead7312ec57a01ad98494105c577dc0"] :answer-field/correct "q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c/a8b31d1634a327d12d205d04c66213864f5dedc9f286571b9dbe0a8b51d46441" :db/ensure [:answer-field/validate]}
 {:db/id "q-15174" :question/id #uuid "dddf8a10-d360-5144-aae4-5bd6e2bd6915" :question/math-academy-id "q-15174" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}+{t}^{2},\\,y={t}^{3}-{t}^{2}$\nfrom $t=0$ to $t=1$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}+{t}^{2})=3{t}^{2}+2t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-{t}^{2})=3{t}^{2}-2t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(3{t}^{2}+2t)}^{2}+{(3{t}^{2}-2t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{9{t}^{4}+12{t}^{3}+4{t}^{2}+9{t}^{4}-12{t}^{3}+4{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{18{t}^{4}+8{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t\\sqrt{18{t}^{2}+8}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15174/ma-source-field/eab32d706d70a3444098b914dad130a082bd7a4c7bd70daa353a7da7046e978c"] :db/ensure [:question/validate]}
