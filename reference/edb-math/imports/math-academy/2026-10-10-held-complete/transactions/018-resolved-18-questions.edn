 {:db/id "q-87289/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/72fd1f0079d054315a89de1a806511a99edf60de21f2577cbc2dfa13c97964c5" :answer/id #uuid "12b1de4e-720b-5103-b02a-93df60a43fdc" :answer/type :answer.type/text :answer/value "$A$ and $B$ are mutually exclusive events, since $P(A\\cap B)=0$" :db/ensure [:answer/validate]}
 {:db/id "q-87289/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/9fb5c612ee365ea61ce6f134c95ae853f67289ad9f707d5c163f9eafe471bb65" :answer/id #uuid "4cdbc724-6263-5eb1-9f31-2c494f2f3956" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)<P(A\\cup B)$" :db/ensure [:answer/validate]}
