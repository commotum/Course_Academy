 {:db/id "q-80999" :question/id #uuid "e2aeaa42-0925-5203-ab6b-c6edd9263eda" :question/math-academy-id "q-80999" :question/problem "What is the truth value of the following mathematical statement?\n\n$\\,$ A square has exactly $3$ sides." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nThis statement is false because a square has exactly $4$ sides." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80999/ma-source-field/b913a2ccf05b162a65d6301f41f8545fd4fcf81514fee9ccacc1747e86f454d4"] :db/ensure [:question/validate]}
