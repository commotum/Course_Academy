 {:db/id "q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107" :answer-field/id #uuid "a53c95c7-2729-5853-ad5b-f91dbb44a5b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107/ab93d05e2e7f1a2462892e1723419d61d62530369d9d6f1c5fcc6f4ffc2e8b1e" "q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107/168d0b32249ed1235931fc9fd986b98824ad54edef8bbc3e55e6b7a42651e8bd" "q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107/a6610cc48cf5ba6e6c8027cd705ccbd2cbd7a7d0bd1ede730a2c56f6b5575bd4" "q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107/b80f83958fc4b22365c2f784eef13ab777f0515a2df9e8691a1cb5b2b6d3b481" "q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107/30b54dd1a350dac8e252487e33c88babe60df1b59d0c1bc2d7b605327513af10"] :answer-field/correct "q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107/a6610cc48cf5ba6e6c8027cd705ccbd2cbd7a7d0bd1ede730a2c56f6b5575bd4" :db/ensure [:answer-field/validate]}
 {:db/id "q-129133" :question/id #uuid "f0c417e1-432e-591b-889d-c01227fedeb7" :question/math-academy-id "q-129133" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & -8 & 4 & -\\frac{7}{4} \\\\ 0 & 5 & \\frac{2}{3} & 8 \\\\ \\frac{3}{2} & \\frac{1}{3} & 4 & 6\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n{\\begin{aligned}0x-8y+4z=-\\frac{7}{4} \\\\ 0x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$\n\nBy simplifying, we obtain \n\n$$\n{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-129133/ma-source-field/644150623c447c73be6777f14ce2a3d16a155287ad49959f6199a820fc3f9107"] :db/ensure [:question/validate]}
 {:db/id [:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d"] :knowledge-point/questions ["q-129133"] :db/ensure [:knowledge-point/validate]}
 {:db/id "q-129197/ma-source-field/3b4b4d92ec880e63d1b5f219b8ce61ecc02d0900e28ca55664123dc06b3a6fcd/afb5f70f46a804f8cb3242b5f199a251ea4c184ee6b9cb47ff258732d5b1b683" :answer/id #uuid "80d5b36d-2d40-5c18-8e0d-6d105a433548" :answer/type :answer.type/text :answer/value "A family of planes: $z=3cx+\\frac{c}{2}y$" :db/ensure [:answer/validate]}
 {:db/id "q-129197/ma-source-field/3b4b4d92ec880e63d1b5f219b8ce61ecc02d0900e28ca55664123dc06b3a6fcd/5ab180ee839abec300a28a19e92b396797b22e67f84a71b94827e4b3bae98dba" :answer/id #uuid "ffc4b44b-454f-562b-a12c-dc2a52ba993b" :answer/type :answer.type/text :answer/value "A family of planes: $z=\\frac{c}{3}x+2cy$" :db/ensure [:answer/validate]}
