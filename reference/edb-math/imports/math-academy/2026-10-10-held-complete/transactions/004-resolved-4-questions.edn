 {:db/id "q-129198/ma-source-field/b9706b4bd73d2010ef818d33186937f9db87c801f09db8fcd8778d9b5923ac60/f423b63d45a56c25d6c7bc6d3aa00cc865d15248c66c27c579a701f0e8bffe7d" :answer/id #uuid "aae33ccf-22b5-51bd-9555-81b6dcd47141" :answer/type :answer.type/text :answer/value "A family of planes: $x-2y+z=-{r}^{2}$" :db/ensure [:answer/validate]}
