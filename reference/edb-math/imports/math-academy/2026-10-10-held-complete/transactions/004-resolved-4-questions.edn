 {:db/id "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/d01f6fab86631ceb6f9b9fc6098cc48e6fb888c29ca67581bc7b9abd4566dc2e" :answer/id #uuid "12b9fcee-9cc1-5cd7-9dcf-0488b3381528" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6-(x-2)+\\frac{1}{4}(x-2)^{2}+⋯" :db/ensure [:answer/validate]}
 {:db/id "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/9956bc00263ed67c629e82e77397cea242ca58ad6c2679fdc4429609570c6022" :answer/id #uuid "549a5daf-5666-553f-82f5-27205446194a" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(3x)=\\operatorname{ln}⁡6-\\frac{1}{2}(x-2)^{2}+\\frac{1}{8}(x-2)^{4}+⋯" :db/ensure [:answer/validate]}
 {:db/id "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da" :answer-field/id #uuid "9533d8c7-2fb9-5174-8f0a-9eef9e450415" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/dc2ca9b2661cf4f56684318a465f5faeb9d871ad02746daf18a36237b4420eb7" "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/a23c3e231b6dbe47b42b39ba23b63edbb642eed231aeb4faa785e794b884533e" "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/c171cc2af30e98532c72a9b9bb9259bbafa7115070533ec07f6e10c71f7002bc" "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/d01f6fab86631ceb6f9b9fc6098cc48e6fb888c29ca67581bc7b9abd4566dc2e" "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/9956bc00263ed67c629e82e77397cea242ca58ad6c2679fdc4429609570c6022"] :answer-field/correct "q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da/c171cc2af30e98532c72a9b9bb9259bbafa7115070533ec07f6e10c71f7002bc" :db/ensure [:answer-field/validate]}
 {:db/id "q-126844" :question/id #uuid "7b7eb3fc-d271-5f71-a892-30b0a27230ca" :question/math-academy-id "q-126844" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{ln}⁡(3x)$ about the point $x=2.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{ln}⁡(3x)$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(3x) \\\\ f(2) & =\\operatorname{ln}⁡(3\\cdot 2)=\\operatorname{ln}⁡6 \\\\ {f}^{′}(x) & =\\frac{1}{x} \\\\ {f}^{′}(2) & =\\frac{1}{2} \\\\ {f}^{″}(x) & =-\\frac{1}{{x}^{2}} \\\\ {f}^{″}(2) & =-\\frac{1}{{2}^{2}}=-\\frac{1}{4}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(3x) & =\\operatorname{ln}⁡6+(\\frac{1}{2})(x-2)+\\frac{1}{2!}(-\\frac{1}{4})(x-2)^{2}+⋯ \\\\  & =\\operatorname{ln}⁡6+\\frac{1}{2}(x-2)-\\frac{1}{8}(x-2)^{2}+⋯\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126844/ma-source-field/db8a5f2ec52d8bdcf445fdc56b2d6713764a5a2fb6de2b0cd11255c8767543da"] :db/ensure [:question/validate]}
