 {:db/id "q-95069/ma-source-field/f9bbd54df30a0116d8e9a9d186a2316cb508ba2f2362fd0a60a8385b8895c863/5b256da48ef0b0308200ba2dd86b038812c54f7c223dbd3dfadc19667c985a9a" :answer/id #uuid "58794a90-ab7c-51d4-af96-b3bf9bf1f667" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}4 & 0 \\\\ 0 & 2\\end{aligned}]$ and $P=[\\begin{aligned}-\\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{aligned}]$" :db/ensure [:answer/validate]}
