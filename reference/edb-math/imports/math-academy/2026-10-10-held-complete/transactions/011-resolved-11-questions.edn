 {:db/id "q-35379" :question/id #uuid "da57a6bc-d0db-59f4-81d7-c54fef1172ef" :question/math-academy-id "q-35379" :question/problem "Evaluate ${lim}_{x\\to -\\infty }(-{x}^{4}+3).$" :question/worked-solution "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-{x}^{4}+3) & ={lim}_{x\\to -\\infty }(-{x}^{4}) \\\\  & =-{lim}_{x\\to -\\infty }({x}^{4}) \\\\  & =-\\,(\\infty ) \\\\  & =-\\infty \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-35379/ma-source-field/dc65e31453dd72132e8241d5924f67db090e935811c82ff130346b71a18c4157"] :db/ensure [:question/validate]}
