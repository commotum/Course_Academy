 {:db/id "q-90054/ma-source-field/6f2a660693428571ee54f07fe024c45aac93d49eb753174e187c64617ef23081/a9b98547abbe447c538aefa651f6edfa6f6f7911a4e8d16d127fcf3e71a7df6f" :answer/id #uuid "2f5ca256-25d0-5c51-b2d0-61bafb216142" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x+y<3 \\\\ y<2x\\end{aligned}" :db/ensure [:answer/validate]}
