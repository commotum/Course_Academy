 {:db/id "q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a" :answer-field/id #uuid "16d27f97-4329-5b65-b357-06a7d75d56ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a/0a39b98f8bc8c43c345a4bae7e8d899031d3abc4e6d432eb59023f3e4a934d9e" "q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a/3c21bc415faa3a987801a2012718d7249c83fd2bae5109c3b81e2c6c1a675230" "q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a/405b6d8e1398e68dbb5d7724d547e08f62dccb2ce3cbc21fce36ec120b6725de" "q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a/81048e996037ec00ebd726d167ee0e4dea99dbed7e0902b4c74051f50a81a729" "q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a/f124288bd3d21f14877ebfd267ce89e7d4073e646afae54376bf8b1ce2836291"] :answer-field/correct "q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a/f124288bd3d21f14877ebfd267ce89e7d4073e646afae54376bf8b1ce2836291" :db/ensure [:answer-field/validate]}
 {:db/id "q-127736" :question/id #uuid "9fd0e8ab-5ed1-5462-b099-07b3173547c9" :question/math-academy-id "q-127736" :question/problem "Calculate ${Z}^{-1}$ where\n$Z=[\\begin{aligned}1 & 2 \\\\ 3 & 8\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nZ=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $Z$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Z)=1\\cdot 8-3\\cdot 2=2\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Z{Z}^{-1} & =[\\begin{aligned}1 & 2 \\\\ 3 & 8\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {Z}^{-1}Z & =\\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127736/ma-source-field/4f4b954a0650e5a02557ff8c2a2e2e61e6cf4b79fed21bd4bd21e47488d1269a"] :db/ensure [:question/validate]}
