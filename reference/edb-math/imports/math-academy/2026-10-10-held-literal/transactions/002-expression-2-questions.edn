 {:db/id "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904" :answer-field/id #uuid "f07588f6-2130-5bc1-a3cb-f62e9cade978" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/abc4e01626eb87b45206b4cbe5fadc3db03bb1c6e9e7425dea4cb5a219c87fae" "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/5a5de0862c4d09f62aeb98af5d5416c44c9fdd0290590d3d3b62f7225a4b20e1" "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/ca362485a36b019a9aa6a4f86d346efd68d75b73713a3c8e4b2fa4ebb48ada47"] :answer-field/correct "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :db/ensure [:answer-field/validate]}
 {:db/id "q-115910" :question/id #uuid "682478c9-f41b-564c-8e03-bd7edda3fd9a" :question/math-academy-id "q-115910" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(-\\frac{1}{4})x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{4}.$ Therefore, our parabola has its vertex at $(0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904"] :db/ensure [:question/validate]}
