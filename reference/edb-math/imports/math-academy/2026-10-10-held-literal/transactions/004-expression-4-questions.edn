 {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/cd52cf227650f39a8c6263ff2c716eaad063c335a52efa09f7d551199797d4f1" :answer/id #uuid "dc5a5fd6-f1c0-5816-bbff-d97051dd254d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ -3\\end{aligned}]$ has exactly one solution" :db/ensure [:answer/validate]}
 {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/577cb9c5dab6da3808833c53d87670e53309521ee74e4a5d2a38217f53e1fe66" :answer/id #uuid "6da42ba2-60ea-55ee-a8cc-e05327ecf3a1" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is the unique solution of $[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]x=0$" :db/ensure [:answer/validate]}
