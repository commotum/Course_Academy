4139533472 17592186045585 true] [17592186397962 1084 #uuid "bd6b2f33-a870-578b-9b44-33252827ba71" 13194139533472 17592186045585 true] [17592186397963 1068 #edb/ref 17592186397964 13194139533472 17592186045585 true] [17592186397963 1069 "q-109943" 13194139533472 17592186045585 true] [17592186397963 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186397963 1071 "$$\n{∬}_{D}\\boxed{}\\,\\text{d}A,\\,D={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 2}\n$$\n\nThe integral above gives the surface area of the parametric surface $r(u,v)=⟨u+v,\\,3-v,\\,1+4u+5v⟩$ for $0\\le u\\le 1$ and $0\\le v\\le 2.$ What is the missing expression?" 13194139533472 17592186045585 true] [17592186397963 1072 #uuid "8259cc12-8425-5d9e-923a-3106edaae5d3" 13194139533472 17592186045585 true] [17592186397963 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u+v),\\,\\frac{∂}{∂u}(3-v),\\,\\frac{∂}{∂u}(1+4u+5v)⟩ \\\\  & =⟨1,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u+v),\\,\\frac{∂}{∂v}(3-v),\\,\\frac{∂}{∂v}(1+4u+5v)⟩ \\\\  & =⟨1,\\,-1,\\,5⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 4 \\\\ 1 & -1 & 5\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 4 \\\\ -1 & 5\\end{aligned}|,\\,-|\\begin{aligned}1 & 4 \\\\ 1 & 5\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}|⟩ \\\\  & =⟨4,\\,-1,\\,-1⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨4,\\,-1,\\,-1⟩‖ \\\\  & =\\sqrt{(4)^{2}+(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{16+1+1} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}3\\sqrt{2}\\,\\text{d}A\\end{aligned}\n$$" 13194139533472 17592186045585 true] [17592186397964 1075 #edb/ref 17592186397965 13194139533472 17592186045585 true] [17592186397964 1075 #edb/ref 17592186397966 13194139533472 17592186045585 true] [17592186397964 1075 #edb/ref 17592186397967 13194139533472 17592186045585 true] [17592186397964 1075 #edb/ref 17592186397968 13194139533472 17592186045585 true] [17592186397964 1075 #edb/ref 17592186397969 13194139533472 17592186045585 true] [17592186397964 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186397964 1077 "selection" 13194139533472 17592186045585 true] [17592186397964 1079 #edb/ref 17592186397969 13194139533472 17592186045585 true] [17592186397964 1080 #uuid "3dc7b100-8716-5ef0-ac33-e0d012d77654" 13194139533472 17592186045585 true] [17592186397965 1081 "\\sqrt{10}" 13194139533472 17592186045585 true] [17592186397965 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397965 1084 #uuid "e335f1ce-f85b-55fb-9898-0984e81e5a0f" 13194139533472 17592186045585 true] [17592186397966 1081 "\\sqrt{3}" 13194139533472 17592186045585 true] [17592186397966 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397966 1084 #uuid "058877bc-b659-5e3e-87cf-faeec5fcf705" 13194139533472 17592186045585 true] [17592186397967 1081 "u\\sqrt{{v}^{2}+1}" 13194139533472 17592186045585 true] [17592186397967 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397967 1084 #uuid "cd8caafa-3ec3-522c-ad87-8c146d142f74" 13194139533472 17592186045585 true] [17592186397968 1081 "2\\sqrt{u+v}" 13194139533472 17592186045585 true] [17592186397968 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397968 1084 #uuid "354ff6f5-50a5-5ef5-9619-794c2e23d89b" 13194139533472 17592186045585 true] [17592186397969 1081 "3\\sqrt{2}" 13194139533472 17592186045585 true] [17592186397969 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397969 1084 #uuid "a8e0a436-d109-5391-b4da-ce44a96c863e" 13194139533472 17592186045585 true] [17592186397970 1068 #edb/ref 17592186397971 13194139533472 17592186045585 true] [17592186397970 1069 "q-109947" 13194139533472 17592186045585 true] [17592186397970 1070 #edb/ref 17592186045486 13194139533472 17592186045585 true] [17592186397970 1071 "$$\n{∬}_{D}\\boxed{}\\,\\text{d}A,\\,D={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 1}\n$$\n\nThe integral above gives the surface area of the parametric surface $r(u,v)=⟨u+v,\\,3{u}^{2},\\,u-v⟩$ for $0\\le u\\le 1$ and $0\\le v\\le 1.$ What is the missing expression?" 13194139533472 17592186045585 true] [17592186397970 1072 #uuid "c235bda4-b647-59f5-b137-7fc5bc86576a" 13194139533472 17592186045585 true] [17592186397970 1074 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u+v),\\,\\frac{∂}{∂u}(3{u}^{2}),\\,\\frac{∂}{∂u}(u-v)⟩ \\\\  & =⟨1,\\,6u,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u+v),\\,\\frac{∂}{∂v}(3{u}^{2}),\\,\\frac{∂}{∂v}(u-v)⟩ \\\\  & =⟨1,\\,0,\\,-1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 6u & 1 \\\\ 1 & 0 & -1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}6u & 1 \\\\ 0 & -1\\end{aligned}|,\\,-|\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}|,\\,|\\begin{aligned}1 & 6u \\\\ 1 & 0\\end{aligned}|⟩ \\\\  & =⟨-6u,\\,2,\\,-6u⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨-6u,\\,2,\\,-6u⟩‖ \\\\  & =\\sqrt{(-6u)^{2}+(2)^{2}+(-6u)^{2}} \\\\  & =\\sqrt{36{u}^{2}+4+36{u}^{2}} \\\\  & =\\sqrt{72{u}^{2}+4} \\\\  & =\\sqrt{4(18{u}^{2}+1)} \\\\  & =2\\sqrt{18{u}^{2}+1}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}2\\sqrt{18{u}^{2}+1}\\,\\text{d}A\\end{aligned}\n$$" 13194139533472 17592186045585 true] [17592186397971 1075 #edb/ref 17592186397972 13194139533472 17592186045585 true] [17592186397971 1075 #edb/ref 17592186397973 13194139533472 17592186045585 true] [17592186397971 1075 #edb/ref 17592186397974 13194139533472 17592186045585 true] [17592186397971 1075 #edb/ref 17592186397975 13194139533472 17592186045585 true] [17592186397971 1075 #edb/ref 17592186397976 13194139533472 17592186045585 true] [17592186397971 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186397971 1077 "selection" 13194139533472 17592186045585 true] [17592186397971 1079 #edb/ref 17592186397975 13194139533472 17592186045585 true] [17592186397971 1080 #uuid "96083256-eb07-5ebd-a86e-e5865f463363" 13194139533472 17592186045585 true] [17592186397972 1081 "\\sqrt{{u}^{2}+4}" 13194139533472 17592186045585 true] [17592186397972 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397972 1084 #uuid "5545b0b7-751d-5798-9bd4-dfa8faf23f03" 13194139533472 17592186045585 true] [17592186397973 1081 "2u\\sqrt{9{u}^{2}+1}" 13194139533472 17592186045585 true] [17592186397973 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397973 1084 #uuid "a470c598-2c0a-5ceb-ac0e-1fb73e235141" 13194139533472 17592186045585 true] [17592186397974 1081 "2\\sqrt{{u}^{2}+1}" 13194139533472 17592186045585 true] [17592186397974 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397974 1084 #uuid "dade9321-241a-5817-902c-2195520cffda" 13194139533472 175921