86045585 true] [17592186397837 1084 #uuid "517768cd-d993-5dab-8ee7-13eb0fb7a83c" 13194139533472 17592186045585 true] [17592186397838 1081 "{{0,10,20,…,890},{20,40,60,…,900}}" 13194139533472 17592186045585 true] [17592186397838 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397838 1084 #uuid "848c6957-5caa-540d-8bff-a3623c7884b2" 13194139533472 17592186045585 true] [17592186397839 1081 "{∅,{0,10,20,…,900}}" 13194139533472 17592186045585 true] [17592186397839 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397839 1084 #uuid "d94b7475-aea7-5f37-8f91-5a6a224b1a14" 13194139533472 17592186045585 true] [17592186397840 1081 "{{10,30,50…,890},{0,20,40,60,…,800}}" 13194139533472 17592186045585 true] [17592186397840 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397840 1084 #uuid "d0faafc2-3404-5731-82db-935a87f5c58e" 13194139533472 17592186045585 true] [17592186397841 1081 "{{10,30,50…,890},{20,40,60,…,900}}" 13194139533472 17592186045585 true] [17592186397841 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397841 1084 #uuid "d0a46e46-ce61-509d-a4ff-748ab842be55" 13194139533472 17592186045585 true] [17592186397842 1068 #edb/ref 17592186397843 13194139533472 17592186045585 true] [17592186397842 1069 "q-106293" 13194139533472 17592186045585 true] [17592186397842 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186397842 1071 "![](images/d6/d698646baac96e15db7f447c0e1af6dbc0cb03cae50084fbfbb6cab15eabf565.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" 13194139533472 17592186045585 true] [17592186397842 1072 #uuid "da600baa-a9d3-5724-9a5b-8920df8b8600" 13194139533472 17592186045585 true] [17592186397842 1074 "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=2.$ So, the parametric equations of the *full* circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/b7/b76043921a3f9399049d6c3b4f557c7263da4d38a070c66a2dd444dbe2806c8e.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{\\pi }{2},\\pi ]$, we get the required quarter-circle.\n\nTherefore, the parametric equations of the quarter-circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\frac{\\pi }{2},\\pi ].\n$$" 13194139533472 17592186045585 true] [17592186397843 1075 #edb/ref 17592186397844 13194139533472 17592186045585 true] [17592186397843 1075 #edb/ref 17592186397845 13194139533472 17592186045585 true] [17592186397843 1075 #edb/ref 17592186397846 13194139533472 17592186045585 true] [17592186397843 1075 #edb/ref 17592186397847 13194139533472 17592186045585 true] [17592186397843 1075 #edb/ref 17592186397848 13194139533472 17592186045585 true] [17592186397843 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186397843 1077 "selection" 13194139533472 17592186045585 true] [17592186397843 1079 #edb/ref 17592186397846 13194139533472 17592186045585 true] [17592186397843 1080 #uuid "dad99554-fa4d-57b5-9d6d-0148f288e880" 13194139533472 17592186045585 true] [17592186397844 1081 "[\\frac{\\pi }{2},\\frac{3\\pi }{2}]" 13194139533472 17592186045585 true] [17592186397844 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397844 1084 #uuid "232441c2-f7f1-5f16-bc4b-60b09c0b1593" 13194139533472 17592186045585 true] [17592186397845 1081 "[0,\\frac{\\pi }{2}]" 13194139533472 17592186045585 true] [17592186397845 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397845 1084 #uuid "82fba5c9-0131-541c-8948-a25c0d8eae2f" 13194139533472 17592186045585 true] [17592186397846 1081 "[\\frac{\\pi }{2},\\pi ]" 13194139533472 17592186045585 true] [17592186397846 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397846 1084 #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" 13194139533472 17592186045585 true] [17592186397847 1081 "[0,\\pi ]" 13194139533472 17592186045585 true] [17592186397847 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397847 1084 #uuid "0f87d6d3-3c3b-5273-849d-9b1476a53757" 13194139533472 17592186045585 true] [17592186397848 1081 "[\\frac{\\pi }{2},2\\pi )" 13194139533472 17592186045585 true] [17592186397848 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397848 1084 #uuid "c5222c9f-23b7-5ec8-b93f-57e76ab64107" 13194139533472 17592186045585 true] [17592186397849 1068 #edb/ref 17592186397850 13194139533472 17592186045585 true] [17592186397849 1069 "q-106654" 13194139533472 17592186045585 true] [17592186397849 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186397849 1071 "Given that $y>30$ and $t>0,$ which of the following is an inhibited decay equation?" 13194139533472 17592186045585 true] [17592186397849 1072 #uuid "6f61f141-3dc0-53a6-8909-845a088a0525" 13194139533472 17592186045585 true] [17592186397849 1074 "An inhibited decay equation has the form\n\n$$\n\\frac{dy}{dt}=-k(y-a),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $y>a$ for all $t>0.$\n\nFrom the given options, the only inhibited decay equation is\n\n$$\n\\frac{dy}{dt}=840-28y.\n$$\n\nTo see this, let's factor the right-hand side of the equation. This gives,\n\n$$\n\\frac{dy}{dt}=-28(y-30).\n$$\n\nIn this case, the constant of proportionality is $k=28,$ and $a=30.$ Note that for inhibited decay, we must have $y>30$ for all $t>0.$" 13194139533472 17592186045585 true] [17592186