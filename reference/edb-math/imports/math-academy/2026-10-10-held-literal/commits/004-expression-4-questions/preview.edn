5) \\\\  & =(x+5)(x-5)(x-5) \\\\  & =(x-5{)}^{2}(x+5)\\end{aligned}\n$$\n\nTo find the roots and their multiplicities, we look at the factors:\n\n- The factor $(x-5)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=5$ has multiplicity $2.$\n\n- The factor $(x+5)$ has an exponent of $1$ in the factored form of $p(x).$ So the root $x=-5$ has multiplicity $1.$\n\nIn conclusion, only the root $x=5$ has multiplicity $2.$" 13194139533475 17592186045585 true] [17592186398645 1075 #edb/ref 17592186398646 13194139533475 17592186045585 true] [17592186398645 1075 #edb/ref 17592186398647 13194139533475 17592186045585 true] [17592186398645 1075 #edb/ref 17592186398648 13194139533475 17592186045585 true] [17592186398645 1075 #edb/ref 17592186398649 13194139533475 17592186045585 true] [17592186398645 1075 #edb/ref 17592186398650 13194139533475 17592186045585 true] [17592186398645 1076 #edb/ref 17592186045493 13194139533475 17592186045585 true] [17592186398645 1077 "selection" 13194139533475 17592186045585 true] [17592186398645 1079 #edb/ref 17592186398647 13194139533475 17592186045585 true] [17592186398645 1080 #uuid "7a80fbe4-dbfb-530c-af35-e0f30a4a5542" 13194139533475 17592186045585 true] [17592186398646 1081 "x=-5,\\,5" 13194139533475 17592186045585 true] [17592186398646 1083 #edb/ref 17592186045499 13194139533475 17592186045585 true] [17592186398646 1084 #uuid "49f83912-5796-573a-b936-a61ffb603ff7" 13194139533475 17592186045585 true] [17592186398647 1081 "x=5" 13194139533475 17592186045585 true] [17592186398647 1083 #edb/ref 17592186045499 13194139533475 17592186045585 true] [17592186398647 1084 #uuid "b6a7c8bb-09ff-5a0f-b690-cf0f292ac7ee" 13194139533475 17592186045585 true] [17592186398648 1081 "x=\\frac{1}{5}" 13194139533475 17592186045585 true] [17592186398648 1083 #edb/ref 17592186045499 13194139533475 17592186045585 true] [17592186398648 1084 #uuid "d012c549-4023-5194-9620-c38392bb0ca8" 13194139533475 17592186045585 true] [17592186398649 1081 "x=-\\frac{1}{5}" 13194139533475 17592186045585 true] [17592186398649 1083 #edb/ref 17592186045499 13194139533475 17592186045585 true] [17592186398649 1084 #uuid "1ca07054-2359-5a47-9068-5f524310351e" 13194139533475 17592186045585 true] [17592186398650 1081 "x=-5" 13194139533475 17592186045585 true] [17592186398650 1083 #edb/ref 17592186045499 13194139533475 17592186045585 true] [17592186398650 1084 #uuid "d7f9a8cc-12c2-5db4-9c8e-f8300024f0d2" 13194139533475 17592186045585 true] [17592186398651 1068 #edb/ref 17592186398652 13194139533475 17592186045585 true] [17592186398651 1069 "q-178288" 13194139533475 17592186045585 true] [17592186398651 1070 #edb/ref 17592186045485 13194139533475 17592186045585 true] [17592186398651 1071 "Use the first three terms of the binomial expansion of $(1+x)^{7}$ in ascending powers of $x$ to approximate $(0.99)^{7}.$ Give your answer to four decimal places." 13194139533475 17592186045585 true] [17592186398651 1072 #uuid "1dd05574-640c-5b9b-a9a5-c23bbe5e5973" 13194139533475 17592186045585 true] [17592186398651 1074 "Recall that when $n$ is a positive integer, \n\n$$\n(1+x)^{n}=1+nx+\\frac{1}{2!}n(n-1){x}^{2}+⋯+{x}^{n}.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{(1+x)}^{7} & =1+7x+\\frac{1}{2}\\cdot 7\\cdot 6\\cdot {x}^{2}+⋯+{x}^{7} \\\\  & =1+7x+21{x}^{2}+⋯+{x}^{7}.\\end{aligned}\n$$\n\nSo, for small $x,$ we have\n\n$$\n{(1+x)}^{7}≈1+7x+21{x}^{2}.\n$$\n\nFinally, we substitute $x=-0.01$ into the above approximation of $(1+x)^{7}:$ \n\n$$\n\\begin{aligned}(0.99)^{7} & =(1+(-0.01))^{7} \\\\  & ≈1+7(-0.01)+21(-0.01)^{2} \\\\  & =1-7(0.01)+21(0.000\\,1) \\\\  & =1-0.07+0.002\\,1 \\\\  & =0.932\\,1,\\end{aligned}\n$$\n\nto four decimal places." 13194139533475 17592186045585 true] [17592186398652 1075 #edb/ref 17592186398653 13194139533475 17592186045585 true] [17592186398652 1075 #edb/ref 17592186398654 13194139533475 17592186045585 true] [17592186398652 1075 #edb/ref 17592186398655 13194139533475 17592186045585 true] [17592186398652 1075 #edb/ref 1