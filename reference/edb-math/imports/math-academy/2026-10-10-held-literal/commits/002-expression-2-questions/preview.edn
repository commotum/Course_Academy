533473 17592186045585 true] [17592186398201 1084 #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" 13194139533473 17592186045585 true] [17592186398202 1081 "y=sin⁡(-x)+6" 13194139533473 17592186045585 true] [17592186398202 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398202 1084 #uuid "1f1a872d-3b88-5a7f-8b75-ab249c2d63b9" 13194139533473 17592186045585 true] [17592186398203 1081 "y=sin⁡(-\\frac{x}{6})" 13194139533473 17592186045585 true] [17592186398203 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398203 1084 #uuid "839a4786-7b8b-587f-884b-34a3e1fb530a" 13194139533473 17592186045585 true] [17592186398204 1081 "y=\\frac{1}{6}sin⁡(-x)" 13194139533473 17592186045585 true] [17592186398204 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398204 1084 #uuid "fbef0156-6d81-5b0b-80b2-e4c086df567d" 13194139533473 17592186045585 true] [17592186398205 1081 "y=sin⁡(-6x)" 13194139533473 17592186045585 true] [17592186398205 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398205 1084 #uuid "ab0aa795-c7d5-534e-922f-0ead75cd6cdc" 13194139533473 17592186045585 true] [17592186398206 1068 #edb/ref 17592186398207 13194139533473 17592186045585 true] [17592186398206 1069 "q-119039" 13194139533473 17592186045585 true] [17592186398206 1070 #edb/ref 17592186045485 13194139533473 17592186045585 true] [17592186398206 1071 "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=20{x}^{3}.$" 13194139533473 17592186045585 true] [17592186398206 1072 #uuid "9f503fbb-9abb-5178-8aa2-5b5187c150ec" 13194139533473 17592186045585 true] [17592186398206 1074 "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =20\\int {x}^{3}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =20\\cdot \\frac{1}{4}{x}^{4}+C \\\\  & =5{x}^{4}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (5{x}^{4}+C)\\text{d}x \\\\ y & =5\\cdot \\frac{1}{5}{x}^{5}+Cx+D \\\\  & ={x}^{5}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" 13194139533473 17592186045585 true] [17592186398207 1075 #edb/ref 17592186398208 13194139533473 17592186045585 true] [17592186398207 1075 #edb/ref 17592186398209 13194139533473 17592186045585 true] [17592186398207 1075 #edb/ref 17592186398210 13194139533473 17592186045585 true] [17592186398207 1075 #edb/ref 17592186398211 13194139533473 17592186045585 true] [17592186398207 1075 #edb/ref 17592186398212 13194139533473 17592186045585 true] [17592186398207 1076 #edb/ref 17592186045493 13194139533473 17592186045585 true] [17592186398207 1077 "selection" 13194139533473 17592186045585 true] [17592186398207 1079 #edb/ref 17592186398210 13194139533473 17592186045585 true] [17592186398207 1080 #uuid "7d7d8f65-a93b-5daa-b8fa-34a0b4f4a5ba" 13194139533473 17592186045585 true] [17592186398208 1081 "y={x}^{5}+C{x}^{2}+Dx" 13194139533473 17592186045585 true] [17592186398208 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398208 1084 #uuid "2339eddd-c520-53fc-835c-406bf5642b8b" 13194139533473 17592186045585 true] [17592186398209 1081 "y=4{x}^{4}+C{x}^{2}+Dx" 13194139533473 17592186045585 true] [17592186398209 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398209 1084 #uuid "6cfc929f-0e67-5e47-80b6-d2949d1be4b0" 13194139533473 17592186045585 true] [17592186398210 1081 "y={x}^{5}+Cx+D" 13194139533473 17592186045585 true] [17592186398210 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398210 1084 #uuid "4dd5ffc9-d74f-592b-a383-53ba3803f136" 13194139533473 17592186045585 true] [17592186398211 1081 "y=4{x}^{5}+Cx+D" 13194139533473 17592186045585 true] [17592186398211 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398211 1084 #uuid "395e4984-cf1d-534b-b01f-09b03aa00ba5" 13194139533473 17592186045585 true] [17592186398212 1081 "y=5{x}^{4}+Cx+D" 13194139533473 17592186045585 true] [17592186398212 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398212 1084 #uuid "796c5808-234b-5385-a5e5-513d3b55563c" 13194139533473 17592186045585 true] [17592186398213 1068 #edb/ref 17592186398214 13194139533473 17592186045585 true] [17592186398213 1069 "q-120844" 13194139533473 17592186045585 true] [17592186398213 1070 #edb/ref 17592186045487 13194139533473 17592186045585 true] [17592186398213 1071 "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=-\\frac{4}{{t}^{2}},$ where $t>0$ is the time in seconds. If the particle has velocity $v=\\frac{1}{3}\\,\\text{m}/\\text{s}$ when $t=4\\,\\text{s},$  determine the moment in time when the particle is stationary." 13194139533473 17592186045585 true] [17592186398213 1072 #uuid "0588ded7-d4bd-5616-b35b-33100943aa76" 13194139533473 17592186045585 true] [17592186398213 1074 "The particle is stationary when $v=0\\,\\text{m}/\\text{s}.$\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int -\\frac{4}{{t}^{2}}\\text{d}t \\\\  & =\\frac{4}{t}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(4)=\\frac{1}{3}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{3} & =\\frac{4}{(4)}+C \\\\ \\frac{1}{3} & =1+C \\\\ C & =-\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=\\frac{4}{t}-\\frac{2}{3}.$\n\nNow, we find the moments in time when $v=0\\,\\text{m}/\\text{s}:$\n\n$$\n\\begin{aligned}\\frac{4}{t}-\\frac{2}{3} & =0 \\\\ \\frac{4}{t} & =\\frac{2}{3} \\\\ t & =\\frac{12}{2} \\\\ t & =6\\end{aligned}\n$$\n\nTherefore, the particle is stationary when $t=6\\,\\text{s}.$" 13194139533473 17592186045585 true] [17592186398214 1075 #edb/ref 17592186398215 13194139533473 17592186045585 true] [17592186398214 1075 #edb/ref 17592186398216 13194139533473 17592186045585 true] [17592186398214 1075 #edb/ref 17592186398217 13194139533473 17592186045585 true] [17592186398214 1075 #edb/ref 17592186398218 13194139533473 17592186045585 true] [17592186398214 1075 #edb/ref 17592186398219 13194139533473 17592186045585 true] [17592186398214 1076 #edb/ref 17592186045493 13194139533473 17592186045585 true] [17592186398214 1077 "selection" 13194139533473 17592186045585 true] [17592186398214 1079 #edb/ref 17592186398218 13194139533473 17592186045585 true] [17592186398214 1080 #uuid "695e7fd0-433d-51f0-b01d-00b9f5bc61a3" 13194139533473 17592186045585 true] [17592186398215 1081 "t=3\\,\\text{s}" 13194139533473 17592186045585 true] [17592186398215 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398215 1084 #uuid "602aa483-d67f-5404-8467-f27f01940f90" 13194139533473 17592186045585 true] [17592186398216 1081 "t=4\\,\\text{s}" 13194139533473 17592186045585 true] [17592186398216 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398216 1084 #uuid "14d09f20-c9c1-5eab-bc98-c123faf3e1b4" 13194139533473 17592186045585 true] [17592186398217 1081 "t=0\\,\\text{s}" 13194139533473 17592186045585 true] [17592186398217 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398217 1084 #uuid "dbad500b-d968-57c7-8690-6808ade1af6f" 13194139533473 17592186045585 true] [17592186398218 1081 "t=6\\,\\text{s}" 13194139533473 17592186045585 true] [17592186398218 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398218 1084 #uuid "427f7f46-348f-5d5b-8214-11acace487f2" 13194139533473 17592186045585 true] [17592186398219 1081 "t=2\\,\\text{s}" 13194139533473 17592186045585 true] [17592186398219 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398219 1084 #uuid "5f5d956d-a3db-5f17-a60a-c65874e02299" 13194139533473 17592186045585 true] [17592186398220 1068 #edb/ref 17592186398221 13194139533473 17592186045585 true] [17592186398220 1069 "q-120911" 13194139533473 17592186045585 true] [17592186398220 1070 #edb/ref 17592186045486 13194139533473 17592186045585 true] [17592186398220 1071 "Consider the following initial value problem:\n\n$$\n{y}^{′}=x\\sqrt{y},\\,y(0)=1\n$$\n\nUse Euler's method with three steps of equal size to approximate $y(3).$" 13194139533473 17592186045585 true] [17592186398220 1072 #uuid "13b68e5e-22d6-5fa0-a4a4-6c5d1f4c0a70" 13194139533473 17592186045585 true] [17592186398220 1074 "First, note that we are given $y(0)$ and asked to find $y(3).$ The distance from $x=0$ and $x=3$ is $3,$ and since we are asked to use three steps of equal size, our step size must be\n\n$$\nΔx=\\frac{3-0}{3}=\\frac{3}{3}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x\\sqrt{y}=0\\cdot 1=0 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ {x}_{\\text{new}} & =x+Δx=0+1=1 \\\\ {y}_{\\text{new}} & =y+Δy=1+0=1\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $0$ |\n| $1$ | $1$ | $$ | $$ |\n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x\\sqrt{y}=1\\cdot \\sqrt{1}=1 \\\\ Δy & ={y}^{′}\\cdot Δx=1\\cdot 1=1 \\\\ {x}_{\\text{new}} & =x+Δx=2+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=1+1=2\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $0$ |\n| $1$ | $1$ | $1$ | $1$ |\n| $2$ | $2$ | $$ | $$ |\n\n**Step 3.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the third row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x\\sqrt{y}=2\\sqrt{2} \\\\ Δy & ={y}^{′}\\cdot Δx=2\\sqrt{2}\\cdot 1=2\\sqrt{2} \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3 \\\\ {y}_{\\text{new}} & =y+Δy=2+2\\sqrt{2}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $0$ |\n| $1$ | $1$ | $1$ | $1$ |\n| $2$ | $2$ | $2\\sqrt{2}$ | $2\\sqrt{2}$ |\n| $3$ | $2+2\\sqrt{2}$ |  |  |\n\nTherefore, we conclude that $y(3)≈2+2\\sqrt{2}.$" 13194139533473 17592186045585 true] [17592186398221 1075 #edb/ref 17592186398222 13194139533473 17592186045585 true] [17592186398221 1075 #edb/ref 17592186398223 13194139533473 17592186045585 true] [17592186398221 1075 #edb/ref 17592186398224 13194139533473 17592186045585 true] [17592186398221 1075 #edb/ref 17592186398225 13194139533473 17592186045585 true] [17592186398221 1075 #edb/ref 17592186398226 13194139533473 17592186045585 true] [17592186398221 1076 #edb/ref 17592186045493 13194139533473 17592186045585 true] [17592186398221 1077 "selection" 13194139533473 17592186045585 true] [17592186398221 1079 #edb/ref 17592186398223 13194139533473 17592186045585 true] [17592186398221 1080 #uuid "34d0bc62-23d7-51e0-a40e-82b353c65411" 13194139533473 17592186045585 true] [17592186398222 1081 "4\\sqrt{2}" 13194139533473 17592186045585 true] [17592186398222 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398222 1084 #uuid "111eb72f-77db-56c0-809e-6b4a599df81c" 13194139533473 17592186045585 true] [17592186398223 1081 "2+2\\sqrt{2}" 131941