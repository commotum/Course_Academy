′}(0)‖ & =\\frac{1}{8}\\sqrt{{3}^{2}+(-\\sqrt{3})^{2}} \\\\  & =\\frac{2\\sqrt{3}}{8} \\\\  & =\\frac{\\sqrt{3}}{4}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(0)$ and obtain the principal normal to the curve at the point where $t=0:$\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(0)}{‖{T}^{′}(0)‖} \\\\  & =\\frac{\\frac{1}{8}⟨3,-\\sqrt{3}⟩}{(\\frac{\\sqrt{3}}{4})} \\\\  & =\\frac{1}{2}⟨\\sqrt{3},-1⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=0,$ we get\n\n$$\n\\begin{aligned}T(0)\\cdot N(0) & =\\frac{1}{2}q(0)\\cdot \\frac{1}{2}⟨\\sqrt{3},-1⟩ \\\\  & =\\frac{1}{2}⟨1,\\sqrt{3}⟩\\cdot \\frac{1}{2}⟨\\sqrt{3},-1⟩ \\\\  & =\\frac{1}{4}(1\\cdot \\sqrt{3}+\\sqrt{3}\\cdot (-1)) \\\\  & =\\frac{1}{4}(\\sqrt{3}-\\sqrt{3}) \\\\  & =0.\\,✓\\end{aligned}\n$$" 13194139533473 17592186045585 true] [17592186398319 1075 #edb/ref 17592186398320 13194139533473 17592186045585 true] [17592186398319 1075 #edb/ref 17592186398321 13194139533473 17592186045585 true] [17592186398319 1075 #edb/ref 17592186398322 13194139533473 17592186045585 true] [17592186398319 1075 #edb/ref 17592186398323 13194139533473 17592186045585 true] [17592186398319 1075 #edb/ref 17592186398324 13194139533473 17592186045585 true] [17592186398319 1076 #edb/ref 17592186045493 13194139533473 17592186045585 true] [17592186398319 1077 "selection" 13194139533473 17592186045585 true] [17592186398319 1079 #edb/ref 17592186398321 13194139533473 17592186045585 true] [17592186398319 1080 #uuid "e61eec78-2599-57fe-a41d-57c6c6d95dc1" 13194139533473 17592186045585 true] [17592186398320 1081 "\\frac{1}{\\sqrt{2}}⟨\\sqrt{3},-1⟩" 13194139533473 17592186045585 true] [17592186398320 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398320 1084 #uuid "cb3a5249-e2a5-57f9-8e7b-da061704300d" 13194139533473 17592186045585 true] [17592186398321 1081 "\\frac{1}{2}⟨\\sqrt{3},-1⟩" 13194139533473 17592186045585 true] [17592186398321 1083 #edb/ref 17592186045