t{d}x}[-\\frac{1}{2(x-2)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\frac{\\text{d}}{\\text{d}x}[(x-2)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\cdot (-2)\\cdot (x-2)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-2)+0 \\\\  & =1\\cdot \\frac{1}{(x-2)^{3}}\\cdot 1 \\\\  & =\\frac{1}{(x-2)^{3}}\\,✓\\end{aligned}\n$$" 13194139533473 17592186045585 true] [17592186398116 1075 #edb/ref 17592186398117 13194139533473 17592186045585 true] [17592186398116 1075 #edb/ref 17592186398118 13194139533473 17592186045585 true] [17592186398116 1075 #edb/ref 17592186398119 13194139533473 17592186045585 true] [17592186398116 1075 #edb/ref 17592186398120 13194139533473 17592186045585 true] [17592186398116 1075 #edb/ref 17592186398121 13194139533473 17592186045585 true] [17592186398116 1076 #edb/ref 17592186045493 13194139533473 17592186045585 true] [17592186398116 1077 "selection" 13194139533473 17592186045585 true] [17592186398116 1079 #edb/ref 17592186398121 13194139533473 17592186045585 true] [17592186398116 1080 #uuid "c13dea0f-f218-5cd2-a503-c7b2250d51fb" 13194139533473 17592186045585 true] [17592186398117 1081 "-\\frac{1}{2(x-2)^{4}}+C" 13194139533473 17592186045585 true] [17592186398117 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398117 1084 #uuid "87bb5e34-8a7e-5077-9056-44171c31d68f" 13194139533473 17592186045585 true] [17592186398118 1081 "\\frac{1}{2(x-2)^{2}}+C" 13194139533473 17592186045585 true] [17592186398118 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398118 1084 #uuid "73df82c1-76f6-50ea-99b9-53a33ba7607d" 13194139533473 17592186045585 true] [17592186398119 1081 "-\\frac{2}{(x-2)^{2}}+C" 13194139533473 17592186045585 true] [17592186398119 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398119 1084 #uuid "cfab3df7-4bb6-5eeb-9342-3841991827b8" 13194139533473 17592186045585 true] [1759218639812