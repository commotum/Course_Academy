^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\cdot (-2)(9-5x)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(9-5x)+0 \\\\  & =-\\frac{1}{5}(9-5x)^{-3}\\cdot (-5) \\\\  & =(9-5x)^{-3} \\\\  & =\\frac{1}{{(9-5x)}^{3}}\\,✓\\end{aligned}\n$$" 13194139533473 17592186045585 true] [17592186398123 1075 #edb/ref 17592186398124 13194139533473 17592186045585 true] [17592186398123 1075 #edb/ref 17592186398125 13194139533473 17592186045585 true] [17592186398123 1075 #edb/ref 17592186398126 13194139533473 17592186045585 true] [17592186398123 1075 #edb/ref 17592186398127 13194139533473 17592186045585 true] [17592186398123 1075 #edb/ref 17592186398128 13194139533473 17592186045585 true] [17592186398123 1076 #edb/ref 17592186045493 13194139533473 17592186045585 true] [17592186398123 1077 "selection" 13194139533473 17592186045585 true] [17592186398123 1079 #edb/ref 17592186398127 13194139533473 17592186045585 true] [17592186398123 1080 #uuid "3b49b60e-8217-5844-bea9-fe48c12aaf25" 13194139533473 17592186045585 true] [17592186398124 1081 "\\frac{1}{20(9-5x)^{4}}+C" 13194139533473 17592186045585 true] [17592186398124 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398124 1084 #uuid "06f0d601-5b9e-5b34-b1e4-35332ff61132" 13194139533473 17592186045585 true] [17592186398125 1081 "-\\frac{1}{5(9-5x)^{2}}+C" 13194139533473 17592186045585 true] [17592186398125 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398125 1084 #uuid "ae0f063f-eba9-55db-a617-104bbe47e493" 13194139533473 17592186045585 true] [17592186398126 1081 "-\\frac{1}{10(9-5x)^{2}}+C" 13194139533473 17592186045585 true] [17592186398126 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [17592186398126 1084 #uuid "199a03cb-71ce-557c-b3af-135bd3564f86" 13194139533473 17592186045585 true] [17592186398127 1081 "\\frac{1}{10(9-5x)^{2}}+C" 13194139533473 17592186045585 true] [17592186398127 1083 #edb/ref 17592186045499 13194139533473 17592186045585 true] [175