472 17592186045585 true] [17592186398850 1081 "k=1" 13194139533472 17592186045585 true] [17592186398850 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398850 1084 #uuid "b3570634-e445-5816-bd14-931c93860185" 13194139533472 17592186045585 true] [17592186398851 1081 "k=-6" 13194139533472 17592186045585 true] [17592186398851 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398851 1084 #uuid "af392d2a-05d0-5dd2-abb7-493478be4513" 13194139533472 17592186045585 true] [17592186398852 1081 "k=-1" 13194139533472 17592186045585 true] [17592186398852 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398852 1084 #uuid "958e4525-323d-5584-adaa-91a9e8036aac" 13194139533472 17592186045585 true] [17592186398853 1081 "k=0" 13194139533472 17592186045585 true] [17592186398853 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398853 1084 #uuid "ae811028-5105-53e1-bc94-6774288d6c46" 13194139533472 17592186045585 true] [17592186398854 1068 #edb/ref 17592186398855 13194139533472 17592186045585 true] [17592186398854 1069 "q-48234" 13194139533472 17592186045585 true] [17592186398854 1070 #edb/ref 17592186045485 13194139533472 17592186045585 true] [17592186398854 1071 "![](images/43/43786cb577705d6ae13d44e75203fef441905e9ccfc3713726f07d36c147c7b3.png)\n\nOn which of the following intervals is the function $y=f(x)$ above continuous? You may assume that all points of discontinuity of $f(x)$ are shown in the diagram." 13194139533472 17592186045585 true] [17592186398854 1072 #uuid "8b5e7d86-6590-5293-af9e-465db1c9211b" 13194139533472 17592186045585 true] [17592186398854 1074 "To determine the intervals of continuity of a function, we take the domain of the function and exclude any points of discontinuity. \n\nThe function is defined on the interval $(-\\infty ,\\infty ).$ The function is discontinuous at $x=-3$ and at $x=3,$ so we need to exclude these points..\n\nTherefore, the function is continuous on the intervals $(-\\infty ,-3),$ $(-3,3),$ and $(-3,\\infty ).$  It is also continuous on any subinterval of these intervals.\n\nAmong the answer choices, the correct one is the following: \n\n$\\,$ $(-\\infty ,-3)$\n\nNotice that:\n\n- $(-4,-2)$ and $(-\\infty ,1)$ contain the excluded point $-3,$  so the function is not continuous on these intervals.\n\n- $(-2,4)$ and $(2,\\infty )$ contain the excluded point $3,$ so the function is not continuous on these intervals." 13194139533472 17592186045585 true] [17592186398855 1075 #edb/ref 17592186398856 13194139533472 17592186045585 true] [17592186398855 1075 #edb/ref 17592186398857 13194139533472 17592186045585 true] [17592186398855 1075 #edb/ref 17592186398858 13194139533472 17592186045585 true] [17592186398855 1075 #edb/ref 17592186398859 13194139533472 17592186045585 true] [17592186398855 1075 #edb/ref 17592186398860 13194139533472 17592186045585 true] [17592186398855 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398855 1077 "selection" 13194139533472 17592186045585 true] [17592186398855 1079 #edb/ref 17592186398857 13194139533472 17592186045585 true] [17592186398855 1080 #uuid "134c28b1-b3ff-5d06-b647-ccf5e9b6bae2" 13194139533472 17592186045585 true] [17592186398856 1081 "(2,\\infty )" 13194139533472 17592186045585 true] [17592186398856 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398856 1084 #uuid "225115ed-fe14-54a2-9ff7-14b01a6ca201" 13194139533472 17592186045585 true] [17592186398857 1081 "(-\\infty ,-3)" 13194139533472 17592186045585 true] [17592186398857 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398857 1084 #uuid "d9c706c6-a7cb-5cbf-a31c-59d0e18e0111" 13194139533472 17592186045585 true] [17592186398858 1081 "(-4,-2)" 13194139533472 17592186045585 true] [17592186398858 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398858 1084 #uuid "0db6826b-749e-538b-898e-9f8e45963932" 13194139533472 17592186045585 true] [17592186398859 1081 "(-\\infty ,1)" 13194139533472 17592186045585 true] [17592186398859 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398859 1084 #uuid "b3965102-b7bf-58c1-9626-978cbd7ed7aa" 13194139533472 17592186045585 true] [17592186398860 1081 "(-2,4)" 13194139533472 17592186045585 true] [17592186398860 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398860 1084 #uuid "b32f9c1b-732e-5499-a950-ae4e40e8d8a5" 13194139533472 17592186045585 true] [17592186398861 1068 #edb/ref 17592186398862 13194139533472 17592186045585 true] [17592186398861 1069 "q-48372" 13194139533472 17592186045585 true] [17592186398861 1070 #edb/ref 17592186045486 13194139533472 17592186045585 true] [17592186398861 1071 "![](images/4f/4f636c252da8e886c1f4bf9f0d87387339fce91e5a72f6275e6b24bba787d288.png)\n\nAnna is an environmentalist and is studying the impact of deforestation in a pine forest located in a square-shaped region. Anna discovers that the area of ​​the deforested region is decreasing at a rate of $0.4{\\text{ km}}^{2}/\\text{month}.$ At what rate are the region's diagonals decreasing if the diagonals are $20\\text{ km}$ long?" 13194139533472 17592186045585 true] [17592186398861 1072 #uuid "51c2bb08-d00d-5a09-b26c-2e5b5f8107fb" 13194139533472 17592186045585 true] [17592186398861 1074 "Let $h$ and $A$ be the length of the diagonals and the area of the square, respectively. Using the Pythagorean theorem, it can be shown that the relationship between $A$ and $h$ is\n\n$$\nA=\\frac{{h}^{2}}{2}.\n$$\n\nWe want to find\n\n$$\n\\frac{\\text{d}h}{\\text{d}t}.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{h}^{2}}{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}h}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}h}(\\frac{{h}^{2}}{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}h}{\\text{d}t}\\cdot h \\\\ \\frac{\\text{d}h}{\\text{d}t} & =\\frac{1}{h}\\cdot \\frac{\\text{d}A}{\\text{d}t}.\\end{aligned}\n$$\n\nWe're told that $A$ decreases at a rate of $0.4{\\text{ km}}^{2}/\\text{month},$ so\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =-0.4.\\end{aligned}\n$$\n\nAlso, we want to compute the rate of change of the diagonals when the diagonal has length $h=20.$ Substituting this information into our expression for $\\frac{\\text{d}h}{\\text{d}t},$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}h}{\\text{d}t} & =\\frac{1}{20}\\cdot (-0.4) \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-\\frac{0.4}{20} \\\\ \\frac{\\text{d}h}{\\text{d}t} & =-0.02\\,\\text{km}\\text{/month}.\\end{aligned}\n$$\n\nWe conclude that the diagonals of the region are decreasing at a rate of  $0.02\\text{ km}/\\text{month}.$" 13194139533472 17592186045585 true] [17592186398862 1075 #edb/ref 17592186398863 13194139533472 17592186045585 true] [17592186398862 1075 #edb/ref 17592186398864 13194139533472 17592186045585 true] [17592186398862 1075 #edb/ref 17592186398865 13194139533472 17592186045585 true] [17592186398862 1075 #edb/ref 17592186398866 13194139533472 17592186045585 true] [17592186398862 1075 #edb/ref 17592186398867 13194139533472 17592186045585 true] [17592186398862 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398862 1077 "selection" 13194139533472 17592186045585 true] [17592186398862 1079 #edb/ref 17592186398867 13194139533472 17592186045585 true] [17592186398862 1080 #uuid "aa8c5ef9-0c37-5adf-839c-99af73ffe32d" 13194139533472 17592186045585 true] [17592186398863 1081 "0.05\\text{ km}/\\text{month}" 13194139533472 17592186045585 true] [17592186398863 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398863 1084 #uuid "9c33f2db-ee69-5899-b254-c9920d0cc08c" 13194139533472 17592186045585 true] [17592186398864 1081 "0.5\\text{ km}/\\text{month}" 13194139533472 17592186045585 true] [17592186398864 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398864 1084 #uuid "07f94e7c-eaf0-50a5-82b2-936289c3244e" 13194139533472 17592186045585 true] [17592186398865 1081 "0.25\\text{ km}/\\text{month}" 13194139533472 17592186045585 true] [17592186398865 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398865 1084 #uuid "0b0dea4f-92e3-5582-a8c3-1096bf841a98" 13194139533472 17592186045585 true] [17592186398866 1081 "0.1\\text{ km}/\\text{month}" 13194139533472 17592186045585 true] [17592186398866 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398866 1084 #uuid "df4e741b-904e-553c-b625-b7472668b725" 13194139533472 17592186045585 true] [17592186398867 1081 "0.02\\text{ km}/\\text{month}" 13194139533472 17592186045585 true] [17592186398867 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398867 1084 #uuid "7c5bdcf3-a541-5f6f-8726-df468ddf9f59" 13194139533472 17592186045585 true] [17592186398868 1068 #edb/ref 17592186398869 13194139533472 17592186045585 true] [17592186398868 1069 "q-49027" 13194139533472 17592186045585 true] [17592186398868 1070 #edb/ref 17592186045485 13194139533472 17592186045585 true] [17592186398868 1071 "For which value of $x$ does the function $f(x)=\\frac{\\sqrt{x}}{1+x}$ defined for $x\\in (0,\\infty )$ have a local maximum?" 13194139533472 17592186045585 true] [17592186398868 1072 #uuid "d7fa8c48-a61b-5fbf-8ae6-af7bb5265a7d" 13194139533472 17592186045585 true] [17592186398868 1074 "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{(\\frac{1}{2\\sqrt{x}})\\cdot (1+x)-\\sqrt{x}}{(1+x)^{2}} \\\\  & =\\frac{(1+x)-2x}{2\\sqrt{x}(1+x)^{2}} \\\\  & =\\frac{1-x}{2\\sqrt{x}(1+x)^{2}}.\\end{aligned}\n$$\n\nSolving for ${f}^{′}(x)=0$ on $(0,\\infty )$ gives\n\n$$\n\\begin{aligned}\\frac{1-x}{2\\sqrt{x}(1+x)^{2}} & =0 \\\\ 1-x & =0 \\\\ x & =1.\\end{aligned}\n$$\n\nSo $x=1$ is a stationary point. Next, to determine whether this point is a local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=\\frac{1}{2},2$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{1}{2}) & =\\frac{(1-\\frac{1}{2})}{2\\sqrt{\\frac{1}{2}}{(1+\\frac{1}{2})}^{2}}=\\frac{2}{9\\sqrt{2}}>0 \\\\ {f}^{′}(2) & =\\frac{1-2}{2\\sqrt{2}(1+2)^{2}}=-\\frac{1}{18\\sqrt{2}}<0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(0,1)$ | $1$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $\\frac{1}{2}$ |  | $2$ |\n| ${f}^{′}$ | $+$ | $0$ | $-$ |\n| $f$ | $↗$ | max | $↘$ |\n\nFinally, let's use the table above to classify the critical point.\n\n- At $x=1,$ the first derivative changes sign from positive to negative. Therefore, $x=1$ is a local maximum.\n\nWe conclude that $f(x)$ has a local maximum at $x=1.$" 13194139533472 17592186045585 true] [17592186398869 1075 #edb/ref 17592186398870 13194139533472 17592186045585 true] [17592186398869 1075 #edb/ref 17592186398871 13194139533472 17592186045585 true] [17592186398869 1075 #edb/ref 17592186398872 13194139533472 17592186045585 true] [17592186398869 1075 #edb/ref 17592186398873 13194139533472 17592186045585 true] [17592186398869 1075 #edb/ref 17592186398874 13194139533472 17592186045585 true] [17592186398869 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398869 1077 "selection" 13194139533472 17592186045585 true] [17592186398869 1079 #edb/ref 17592186398872 13194139533472 17592186045585 true] [17592186398869 1080 #uuid "95508699-f6d9-5815-8c2e-e441b5ff17ea" 13194139533472 17592186045585 true] [17592186398870 1081 "$f(x)$ does not have any local maxima" 13194139533472 17592186045585 true] [17592186398870 1083 #edb/ref 17592186045500 13194139533472 17592186045585 true] [17592186398870 1084 #uuid "54bbe447-6b4b-5f58-83a2-faffcfe8e2db" 13194139533472 17592186045585 true] [17592186398871 1081 "2" 13194