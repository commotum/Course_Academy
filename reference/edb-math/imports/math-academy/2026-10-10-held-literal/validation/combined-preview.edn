33472 17592186045585 true] [17592186398365 1083 #edb/ref 17592186045500 13194139533472 17592186045585 true] [17592186398365 1084 #uuid "4e12b0f0-56b4-5aeb-bedc-2549e8257ee3" 13194139533472 17592186045585 true] [17592186398366 1081 "7\\times 5" 13194139533472 17592186045585 true] [17592186398366 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398366 1084 #uuid "004a8839-e101-5295-a1c9-8f3e01aa9901" 13194139533472 17592186045585 true] [17592186398367 1068 #edb/ref 17592186398368 13194139533472 17592186045585 true] [17592186398367 1069 "q-131116" 13194139533472 17592186045585 true] [17592186398367 1070 #edb/ref 17592186045485 13194139533472 17592186045585 true] [17592186398367 1071 "For the function $f(x,y,z)={x}^{3}+{z}^{2}{y}^{2}+2z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,-1).$" 13194139533472 17592186045585 true] [17592186398367 1072 #uuid "da3be12b-b270-5258-9b1c-409842422d29" 13194139533472 17592186045585 true] [17592186398367 1074 "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,-1)$ can be found by computing \n$∇f(1,-1,-1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(1,-1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,i+\\frac{∂}{∂y}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,j+\\frac{∂}{∂z}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,k \\\\  & =3{x}^{2}\\text{ }i+2{z}^{2}y\\text{ }j+(2z{y}^{2}+2)\\text{ }k \\\\ ∇f(1,-1,-1) & =3(1)^{2}\\,i+2(-1)^{2}(-1)\\,j+(2(-1)(-1)^{2}+2)k \\\\  & =3\\,i-2\\,j\\end{aligned}\n$$\n\nTherefore, $3\\,i-2\\,j$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,-1).$" 13194139533472 17592186045585 true] [17592186398368 1075 #edb/ref 17592186398369 13194139533472 17592186045585 true] [17592186398368 1075 #edb/ref 17592186398370 13194139533472 17592186045585 true] [17592186398368 1075 #edb/ref 17592186398371 13194139533472 17592186045585 true] [17592186398368 1075 #edb/ref 17592186398372 13194139533472 17592186045585 true] [17592186398368 1075 #edb/ref 17592186398373 13194139533472 17592186045585 true] [17592186398368 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398368 1077 "selection" 13194139533472 17592186045585 true] [17592186398368 1079 #edb/ref 17592186398371 13194139533472 17592186045585 true] [17592186398368 1080 #uuid "530f90fa-b927-569c-b4dd-79831f2442af" 13194139533472 17592186045585 true] [17592186398369 1081 "3\\,i+j+k" 13194139533472 17592186045585 true] [17592186398369 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398369 1084 #uuid "ed1a1ab0-6d18-5f30-b80b-be9f46dd80b5" 13194139533472 17592186045585 true] [17592186398370 1081 "j-k" 13194139533472 17592186045585 true] [17592186398370 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398370 1084 #uuid "d1cbc8d4-c2ee-5478-860e-c731a5274aec" 13194139533472 17592186045585 true] [17592186398371 1081 "3\\,i-2\\,j" 13194139533472 17592186045585 true] [17592186398371 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398371 1084 #uuid "f499f957-93d0-5ca6-8e65-57c931e33b8e" 13194139533472 17592186045585 true] [17592186398372 1081 "2\\,i-2\\,j-k" 13194139533472 17592186045585 true] [17592186398372 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398372 1084 #uuid "d7aa6514-a3ad-578c-8808-8284836b7b95" 13194139533472 17592186045585 true] [17592186398373 1081 "-2\\,i+k" 13194139533472 17592186045585 true] [17592186398373 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398373 1084 #uuid "431e58b2-3a4b-54f5-a2fc-05d378bf57ce" 13194139533472 17592186045585 true] [17592186398374 1068 #edb/ref 17592186398375 13194139533472 17592186045585 true] [17592186398374 1069 "q-131386" 13194139533472 17592186045585 true] [17592186398374 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186398374 1071 "The inverse of the matrix $A$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -10 & -2 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -2 & 10 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -5 & -\\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$" 13194139533472 17592186045585 true] [17592186398374 1072 #uuid "fd68e3fc-b0d0-52a2-ba1f-362abdda52e2" 13194139533472 17592186045585 true] [17592186398374 1074 "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -10 & -2 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+10{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -2 & 10 & 1\\end{aligned}] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -5 & -\\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:={R}_{2}+10{R}_{1},\\,{R}_{2}:=-\\frac{1}{2}{R}_{2}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}1 & 0 \\\\ -5 & -\\frac{1}{2}\\end{aligned}].\n$$" 13194139533472 17592186045585 true] [17592186398375 1075 #edb/ref 17592186398376 13194139533472 17592186045585 true] [17592186398375 1075 #edb/ref 17592186398377 13194139533472 17592186045585 true] [17592186398375 1075 #edb/ref 17592186398378 13194139533472 17592186045585 true] [17592186398375 1075 #edb/ref 17592186398379 13194139533472 17592186045585 true] [17592186398375 1075 #edb/ref 17592186398380 13194139533472 17592186045585 true] [17592186398375 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398375 1077 "selection" 13194139533472 17592186045585 true] [17592186398375 1079 #edb/ref 17592186398378 13194139533472 17592186045585 true] [17592186398375 1080 #uuid "bb1f59ea-afae-5791-b037-851820be3121" 13194139533472 17592186045585 true] [17592186398376 1081 "{R}_{2}:={R}_{2}-\\frac{2}{5}{R}_{1},\\,{R}_{2}:=-2{R}_{2}" 13194139533472 17592186045585 true] [17592186398376 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398376 1084 #uuid "b4f319df-a903-5b7d-9efb-4112ab91989e" 13194139533472 17592186045585 true] [17592186398377 1081 "{R}_{2}:={R}_{2}-5{R}_{1},\\,{R}_{2}:=-\\frac{1}{4}{R}_{2}" 13194139533472 17592186045585 true] [17592186398377 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398377 1084 #uuid "86d81ce8-36fb-51e8-93be-187e54e0f77a" 13194139533472 17592186045585 true] [17592186398378 1081 "{R}_{2}:={R}_{2}+10{R}_{1},\\,{R}_{2}:=-\\frac{1}{2}{R}_{2}" 13194139533472 17592186045585 true] [17592186398378 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398378 1084 #uuid "80c239f1-2477-589f-86a5-ea556c241ef3" 13194139533472 17592186045585 true] [17592186398379 1081 "{R}_{2}:={R}_{2}-10{R}_{1},\\,{R}_{2}:=-2{R}_{2}" 13194139533472 17592186045585 true] [17592186398379 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398379 1084 #uuid "6488a307-e785-52c8-8088-0ef9aa800065" 13194139533472 17592186045585 true] [17592186398380 1081 "{R}_{2}:={R}_{2}+5{R}_{1},\\,{R}_{2}:=\\frac{1}{2}{R}_{2}" 13194139533472 17592186045585 true] [17592186398380 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398380 1084 #uuid "4decee1b-a5c5-5ee9-bf41-5de4e35527d8" 13194139533472 17592186045585 true] [17592186398381 1068 #edb/ref 17592186398382 13194139533472 17592186045585 true] [17592186398381 1069 "q-131999" 13194139533472 17592186045585 true] [17592186398381 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186398381 1071 "The inverse of the matrix $Y$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[Y\\,|\\,I] & =[\\begin{aligned}4 & -1 & 1 & 0 \\\\ -3 & 1 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ -3 & 1 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 3 & 4\\end{aligned}]\\end{aligned}\n$$" 13194139533472 17592186045585 true] [17592186398381 1072 #uuid "41dc19c4-f697-52b3-b9b5-76ded5157f14" 13194139533472 17592186045585 true] [17592186398381 1074 "We write down $Y$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $Y$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[Y\\,|\\,I\\,] & =[\\begin{aligned}4 & -1 & 1 & 0 \\\\ -3 & 1 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ -3 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 3 & 4\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:={R}_{1}+{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}.\n$$\n\nThe matrix ${Y}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{Y}^{-1}=[\\begin{aligned}1 & 1 \\\\ 3 & 4\\end{aligned}].\n$$" 13194139533472 17592186045585 true] [17592186398382 1075 #edb/ref 17592186398383 13194139533472 17592186045585 true] [17592186398382 1075 #edb/ref 17592186398384 13194139533472 17592186045585 true] [17592186398382 1075 #edb/ref 17592186398385 13194139533472 17592186045585 true] [17592186398382 1075 #edb/ref 17592186398386 13194139533472 17