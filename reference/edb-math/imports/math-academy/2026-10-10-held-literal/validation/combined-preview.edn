2 17592186045585 true] [17592186397879 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397879 1084 #uuid "17f05824-89d2-5eee-9fad-4b619056a261" 13194139533472 17592186045585 true] [17592186397880 1081 "10" 13194139533472 17592186045585 true] [17592186397880 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397880 1084 #uuid "323f84f8-1752-51d6-9fd1-154c3f413867" 13194139533472 17592186045585 true] [17592186397881 1081 "3" 13194139533472 17592186045585 true] [17592186397881 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397881 1084 #uuid "7b271fcb-78b4-5e17-a88e-0d1383c450ba" 13194139533472 17592186045585 true] [17592186397882 1081 "18" 13194139533472 17592186045585 true] [17592186397882 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397882 1084 #uuid "5b3c521b-46ca-5a62-aa16-5ac3977b3251" 13194139533472 17592186045585 true] [17592186397883 1068 #edb/ref 17592186397884 13194139533472 17592186045585 true] [17592186397883 1069 "q-106888" 13194139533472 17592186045585 true] [17592186397883 1070 #edb/ref 17592186045485 13194139533472 17592186045585 true] [17592186397883 1071 "What is the dimension of ${\\text{M}}_{8}(R),$ the vector space of all $8\\times 8$ matrices over $R?$" 13194139533472 17592186045585 true] [17592186397883 1072 #uuid "90418efb-5f81-5124-80f6-ce7467b7ec0a" 13194139533472 17592186045585 true] [17592186397883 1074 "The standard basis of ${\\text{M}}_{n}(R)$ contains a total of ${n}^{2}$ matrices, each with one nonzero entry that is equal to $1.$ \n\nFor example, the standard basis of ${\\text{M}}_{2}(R)$ contains ${2}^{2}=4$ elements, and is given by\n\n$$\n{[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}],\\,[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}]}.\n$$\n\nTherefore, for ${\\text{M}}_{8}(R),$ we have\n\n$$\n\\text{dim}({\\text{M}}_{8}(R))={8}^{2}=64.\n$$\n\nIn general, \n\n$$\n\\text{dim}({\\text{M}}_{n}(R))={n}^{2}.\n$$" 13194139533472 17592186045585 true] [17592186397884 1075 #edb/ref 17592186397885 13194139533472 17592186045585 true] [17592186397884 1075 #edb/ref 17592186397886 13194139533472 17592186045585 true] [17592186397884 1075 #edb/ref 17592186397887 13194139533472 17592186045585 true] [17592186397884 1075 #edb/ref 17592186397888 13194139533472 17592186045585 true] [17592186397884 1075 #edb/ref 17592186397889 13194139533472 17592186045585 true] [17592186397884 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186397884 1077 "selection" 13194139533472 17592186045585 true] [17592186397884 1079 #edb/ref 17592186397885 13194139533472 17592186045585 true] [17592186397884 1080 #uuid "94ee78a5-d74a-542f-9cb8-9d156de061c9" 13194139533472 17592186045585 true] [17592186397885 1081 "64" 13194139533472 17592186045585 true] [17592186397885 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397885 1084 #uuid "22b9d3a8-da80-5055-a4ac-61a8de4abec6" 13194139533472 17592186045585 true] [17592186397886 1081 "16" 13194139533472 17592186045585 true] [17592186397886 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397886 1084 #uuid "6b5db82b-df8d-5504-91e7-fcc98356c581" 13194139533472 17592186045585 true] [17592186397887 1081 "84" 13194139533472 17592186045585 true] [17592186397887 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397887 1084 #uuid "9af72902-6c61-5539-95d7-3ad5251165aa" 13194139533472 17592186045585 true] [17592186397888 1081 "52" 13194139533472 17592186045585 true] [17592186397888 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397888 1084 #uuid "9cb6755f-48c1-5f6b-9cd2-eb9cbe4c57c1" 13194139533472 17592186045585 true] [17592186397889 1081 "48" 13194139533472 17592186045585 true] [17592186397889 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397889 1084 #uuid "6ba279e7-9cb7-5403-9454-8ad5b15d2a89" 13194139533472 17592186045585 true] [17592186397890 1068 #edb/ref 17592186397891 13194139533472 17592186045585 true] [17592186397890 1069 "q-107125" 13194139533472 17592186045585 true] [17592186397890 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186397890 1071 "Simon measures the temperature of the tea in his cup, and the thermometer displays a reading of ${60}^{∘}C.$ After $10$ minutes, Simon repeats the measurement and the thermometer displays a reading of  ${52}^{∘}C.$ To the nearest minute, how long does it take for the tea to decrease its temperature to ${40}^{∘}C$ if the temperature in the room is ${28}^{∘}C?$ \n\n*Hint: You may assume that the temperature $T(t)$ of the tea in Simon's cup decreases at a rate that obeys Newton's law of cooling, where $T$ is measured in degrees Celsius and $t>0$ is the time, in minutes, since the first measurement.*" 13194139533472 17592186045585 true] [17592186397890 1072 #uuid "fee906ee-def7-5194-a87e-a1f77108aa56" 13194139533472 17592186045585 true] [17592186397890 1074 "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the inhibited decay equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={28}^{∘}\\text{C},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-28).\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-28} & =-k\\,dt \\\\ \\int \\frac{dT}{T-28} & =-k\\int dt \\\\ \\operatorname{ln}⁡|T-28| & =-kt+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-28>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-28 & ={e}^{-kt+C} \\\\ T-28 & ={e}^{C}{e}^{-kt} \\\\ T-28 & =K{e}^{-kt} \\\\ T & =28+K{e}^{-kt}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nWe're told that the initial temperature reading was ${60}^{∘}C.$ So, we apply the initial condition $T(0)=60,$ and solve for $K:$\n\n$$\n\\begin{aligned}60 & =28+K{e}^{0} \\\\ 60 & =28+K \\\\ K & =32\\end{aligned}\n$$\n\nTherefore, we have the following expression for $T(t):$\n\n$$\nT(t)=28+32{e}^{-kt}\n$$\n\nWe're also told that, after $10$ minutes, the thermometer reading is ${52}^{∘}C.$ So, applying the condition $T(10)=52,$ we can solve for $k:$\n\n$$\n\\begin{aligned}52 & =28+32{e}^{-10k} \\\\ 24 & =32{e}^{-10k} \\\\ \\frac{3}{4} & ={e}^{-10k} \\\\ \\operatorname{ln}⁡(\\frac{3}{4}) & =-10k \\\\ k & =-\\frac{1}{10}\\operatorname{ln}⁡(\\frac{3}{4})\\end{aligned}\n$$\n\nFinally, let ${t}_{1}$ be the time when the temperature of the tea is ${40}^{∘}C.$ Then, we have\n\n$$\n\\begin{aligned}T({t}_{1}) & =40 \\\\ 28+32{e}^{-k{t}_{1}} & =40 \\\\ 32{e}^{-k{t}_{1}} & =12 \\\\ {e}^{-k{t}_{1}} & =\\frac{3}{8} \\\\ -k{t}_{1} & =\\operatorname{ln}⁡(\\frac{3}{8}) \\\\ {t}_{1} & =-\\frac{1}{k}\\operatorname{ln}⁡(\\frac{3}{8}).\\end{aligned}\n$$\n\nSubstituting in our value for $k,$ we conclude that the tea will have a temperature of ${40}^{∘}C$ after\n\n$$\n{t}_{1}=\\frac{-\\operatorname{ln}⁡(\\frac{3}{8})}{-\\frac{1}{10}\\operatorname{ln}⁡(\\frac{3}{4})}≈34\\,\\text{min},\n$$\n\nrounded to the nearest minute." 13194139533472 17592186045585 true] [17592186397891 1075 #edb/ref 17592186397892 13194139533472 17592186045585 true] [17592186397891 1075 #edb/ref 17592186397893 13194139533472 17592186045585 true] [17592186397891 1075 #edb/ref 17592186397894 13194139533472 17592186045585 true] [17592186397891 1075 #edb/ref 17592186397895 13194139533472 17592186045585 true] [17592186397891 1075 #edb/ref 17592186397896 13194139533472 17592186045585 true] [17592186397891 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] 