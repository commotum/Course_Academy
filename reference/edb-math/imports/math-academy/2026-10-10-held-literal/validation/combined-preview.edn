rue] [17592186398409 1070 #edb/ref 17592186045485 13194139533472 17592186045585 true] [17592186398409 1071 "A particle moves with a constant velocity of $u=(i+4j)\\,\\text{km/h}.$ Find the speed of the particle, rounding your answer to two decimal places." 13194139533472 17592186045585 true] [17592186398409 1072 #uuid "ede10ea1-892c-5590-9caf-f40ffde6984b" 13194139533472 17592186045585 true] [17592186398409 1074 "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|i+4j| \\\\  & =\\sqrt{{1}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+16} \\\\  & =\\sqrt{17} \\\\  & ≈4.12\\,\\text{km/h}\\end{aligned}\n$$\n\nrounded to two decimal places." 13194139533472 17592186045585 true] [17592186398410 1075 #edb/ref 17592186398411 13194139533472 17592186045585 true] [17592186398410 1075 #edb/ref 17592186398412 13194139533472 17592186045585 true] [17592186398410 1075 #edb/ref 17592186398413 13194139533472 17592186045585 true] [17592186398410 1075 #edb/ref 17592186398414 13194139533472 17592186045585 true] [17592186398410 1075 #edb/ref 17592186398415 13194139533472 17592186045585 true] [17592186398410 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398410 1077 "selection" 13194139533472 17592186045585 true] [17592186398410 1079 #edb/ref 17592186398415 13194139533472 17592186045585 true] [17592186398410 1080 #uuid "7bfbd15d-6ca5-5972-85ed-d1d5920988e9" 13194139533472 17592186045585 true] [17592186398411 1081 "2.24\\,\\text{km/h}" 13194139533472 17592186045585 true] [17592186398411 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398411 1084 #uuid "1e2cbc40-aff5-51fc-94bf-9cdd5efe425d" 13194139533472 17592186045585 true] [17592186398412 1081 "3.87\\,\\text{km/h}" 13194139533472 17592186045585 true] [17592186398412 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398412 1084 #uuid "5b06ec27-4c21-5388-b505-c3433887b18b" 13194139533472 1759218