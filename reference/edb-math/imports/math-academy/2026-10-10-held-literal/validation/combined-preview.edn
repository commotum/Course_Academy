85 true] [17592186398928 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398928 1084 #uuid "f713561b-1443-55ab-a6f8-528c853237ff" 13194139533472 17592186045585 true] [17592186398929 1081 "\\frac{1}{2}" 13194139533472 17592186045585 true] [17592186398929 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398929 1084 #uuid "35eebbf8-cb3d-55be-881a-6d4dee741c09" 13194139533472 17592186045585 true] [17592186398930 1081 "1" 13194139533472 17592186045585 true] [17592186398930 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398930 1084 #uuid "1304d7b1-7fd6-5fdd-8ab5-88b53194f932" 13194139533472 17592186045585 true] [17592186398931 1081 "\\frac{3}{2}" 13194139533472 17592186045585 true] [17592186398931 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398931 1084 #uuid "03399f19-3885-5f0b-a462-01f7b14158b2" 13194139533472 17592186045585 true] [17592186398932 1068 #edb/ref 17592186398933 13194139533472 17592186045585 true] [17592186398932 1069 "q-65550" 13194139533472 17592186045585 true] [17592186398932 1070 #edb/ref 17592186045487 13194139533472 17592186045585 true] [17592186398932 1071 "![](images/c9/c904a1eb628e726647a6f655a567a0939f7b7d404f0b32c6c4b4adaeca847916.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B-D?$" 13194139533472 17592186045585 true] [17592186398932 1072 #uuid "2a31794b-90ed-5858-8a23-bda34267af75" 13194139533472 17592186045585 true] [17592186398932 1074 "The period $T$ of the function is\n\n$$\nT=\\frac{4\\pi }{5}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{4\\pi }{5}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{4\\pi }{5})}=\\frac{5}{4}.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $3$ units down. Hence, $D=-3.$\n\nTherefore, $B-D=(\\frac{5}{4})-(-3)=\\frac{5}{4}+3=\\frac{17}{4}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(\\frac{5x}{4})-3.\n$$" 13194139533472 17592186045585 true] [17592186398933 1075 #edb/ref 17592186398934 13194139533472 17592186045585 true] [17592186398933 1075 #edb/ref 17592186398935 13194139533472 17592186045585 true] [17592186398933 1075 #edb/ref 17592186398936 13194139533472 17592186045585 true] [17592186398933 1075 #edb/ref 17592186398937 13194139533472 17592186045585 true] [17592186398933 1075 #edb/ref 17592186398938 13194139533472 17592186045585 true] [17592186398933 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398933 1077 "selection" 13194139533472 17592186045585 true] [17592186398933 1079 #edb/ref 17592186398938 13194139533472 17592186045585 true] [17592186398933 1080 #uuid "fd0dd138-ee92-58b5-a97c-038d65811dd6" 13194139533472 17592186045585 true] [17592186398934 1081 "-\\frac{7}{4}" 13194139533472 17592186045585 true] [17592186398934 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398934 1084 #uuid "c00c5e3a-5697-52dc-aa31-3d95907996f7" 13194139533472 17592186045585 true] [17592186398935 1081 "-\\frac{5}{4}" 13194139533472 17592186045585 true] [17592186398935 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398935 1084 #uuid "1cfeda65-26b6-5502-a718-3aca8a4514b7" 13194139533472 17592186045585 true] [17592186398936 1081 "\\frac{3}{4}" 13194139533472 17592186045585 true] [17592186398936 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398936 1084 #uuid "4633095b-b665-59ce-aeaa-96dbb9f25eb3" 13194139533472 17592186045585 true] [17592186398937 1081 "4" 13194139533472 17592186045585 true] [17592186398937 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398937 1084 #uuid "f41004c5-d81d-5e7e-bb0b-5fc9c65c979d" 13194139533472 175921860455