 up to the order of the Jordan blocks." 13194139533472 17592186045585 true] [17592186398019 1075 #edb/ref 17592186398020 13194139533472 17592186045585 true] [17592186398019 1075 #edb/ref 17592186398021 13194139533472 17592186045585 true] [17592186398019 1075 #edb/ref 17592186398022 13194139533472 17592186045585 true] [17592186398019 1075 #edb/ref 17592186398023 13194139533472 17592186045585 true] [17592186398019 1075 #edb/ref 17592186398024 13194139533472 17592186045585 true] [17592186398019 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186398019 1077 "selection" 13194139533472 17592186045585 true] [17592186398019 1079 #edb/ref 17592186398024 13194139533472 17592186045585 true] [17592186398019 1080 #uuid "ab915e03-b049-5d6e-9faa-ad202c3447b3" 13194139533472 17592186045585 true] [17592186398020 1081 "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" 13194139533472 17592186045585 true] [17592186398020 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398020 1084 #uuid "21d923ee-5277-570b-854b-1f054ce6b20d" 13194139533472 17592186045585 true] [17592186398021 1081 "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & -1\\end{aligned}]" 13194139533472 17592186045585 true] [17592186398021 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398021 1084 #uuid "9863101e-36a7-5d75-87dd-952fbe68619f" 13194139533472 17592186045585 true] [17592186398022 1081 "[\\begin{aligned}-1 & -1 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & -1\\end{aligned}]" 13194139533472 17592186045585 true] [17592186398022 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398022 1084 #uuid "eee2c664-527e-54d2-ab4e-0ea9aefbbaa6" 13194139533472 17592186045585 true] [17592186398023 1081 "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" 13194139533472 17592186045585 true] [17592186398023 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186398023 1084 #uui