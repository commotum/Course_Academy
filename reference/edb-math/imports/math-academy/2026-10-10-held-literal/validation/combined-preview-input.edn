source-field/cde3e526a44fb09602ab0168e3ae5ab12194f62352c24fb31f14c553a02e1439/7eaaf6b3718360deeeca9ebdbe8a0f6e5db328eaf908afea02df55c2fabc2c86" "q-175315/ma-source-field/cde3e526a44fb09602ab0168e3ae5ab12194f62352c24fb31f14c553a02e1439/4b825257e7ccf8e0f8393c759d8bceaa5e2ffde25584ad9601249399de860ca5" "q-175315/ma-source-field/cde3e526a44fb09602ab0168e3ae5ab12194f62352c24fb31f14c553a02e1439/b31a679b2455adfc7094086a849d57186f491df78ffa2f94bbb8e4e1daf7a41e"] :answer-field/correct "q-175315/ma-source-field/cde3e526a44fb09602ab0168e3ae5ab12194f62352c24fb31f14c553a02e1439/4b825257e7ccf8e0f8393c759d8bceaa5e2ffde25584ad9601249399de860ca5" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "3dc836e6-a152-59c0-a817-45e5b70cbfb8"] :question/problem "$\\,$ $x\\in R$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "In plain English, our predicate $P(x)$ means the following: \n\n$\\,$ $x$ is a member of the set of real numbers.\n\nThe symbol \"$¬$\" represents negation. To negate our plain English expression, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ is a member of the set of real numbers.\n\nIn other words, $x$ is *not* a member of $R.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x\\notin R$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-175315/ma-source-field/cde3e526a44fb09602ab0168e3ae5ab12194f62352c24fb31f14c553a02e1439"] :db/ensure [:question/validate]} {:db/id "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/efff3bdfde16afae5029519c2de7064722a60542922a627748194901ca37ffe9" :answer/id #uuid "7a27a7e6-a9f2-5d69-9ce2-25ac6a1448c5" :answer/type :answer.type/math :answer/value "(-1,2,-3)" :db/ensure [:answer/validate]} {:db/id "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/1c6ca0440246a1bab194896b7af9bcb63c7e0495a03dc43f686291ecd793c649" :answer/id #uuid "57cf4f60-5a5b-5023-8efc-4c4539d402c8" :answer/type :answer.type/math :answer/value "(2,3,1)" :db/ensure [:answer/validate]} {:db/id "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/979f7ff66c8beb12b898e14c043dd5254fd20baea431bfdc67630f6c1213a457" :answer/id #uuid "1bb43111-b5c6-506a-9572-f434c68db87b" :answer/type :answer.type/math :answer/value "(3,-2,1)" :db/ensure [:answer/validate]} {:db/id "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/456201fc71ac3199f4c99a317daf5ec888979c82028dc43644ff79524203c448" :answer/id #uuid "8ec42430-265d-5e60-ab37-b8ed51e07c2e" :answer/type :answer.type/math :answer/value "(3,2,1)" :db/ensure [:answer/validate]} {:db/id "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/0465052260954474650ed19a5e6bcb2e6ebcce3f410bd8008b61ca8887c14b89" :answer/id #uuid "61541d10-8686-53a1-b1bf-94e0ef8661d2" :answer/type :answer.type/math :answer/value "(4,5,0)" :db/ensure [:answer/validate]} {:db/id "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03" :answer-field/id #uuid "98a42fbd-b4c4-5033-b650-f9ced006793a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/efff3bdfde16afae5029519c2de7064722a60542922a627748194901ca37ffe9" "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/1c6ca0440246a1bab194896b7af9bcb63c7e0495a03dc43f686291ecd793c649" "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/979f7ff66c8beb12b898e14c043dd5254fd20baea431bfdc67630f6c1213a457" "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/456201fc71ac3199f4c99a317daf5ec888979c82028dc43644ff79524203c448" "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/0465052260954474650ed19a5e6bcb2e6ebcce3f410bd8008b61ca8887c14b89"] :answer-field/correct "q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03/979f7ff66c8beb12b898e14c043dd5254fd20baea431bfdc67630f6c1213a457" :db/ensure [:answer-field/validate]} {:db/id "q-176834" :question/id #uuid "9ba92e56-0c67-534f-87e7-bf0cdfa829cc" :question/math-academy-id "q-176834" :question/problem "Find the center of the elliptic cone $4(x-3)^{2}+5(y+2)^{2}=20(z-1)^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}4(x-3)^{2}+5(y+2)^{2} & =20(z-1)^{2} \\\\ \\frac{(x-3)^{2}}{1/4}+\\frac{(y+2)^{2}}{1/5} & =\\frac{(z-1)^{2}}{1/20} \\\\ \\frac{(x-3)^{2}}{1/4}+\\frac{(y-(-2))^{2}}{1/5} & =\\frac{(z-1)^{2}}{1/20}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(3,-2,1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-176834/ma-source-field/b1875be31de5f555e56fa5f0648a254bf8c7d444ceef3b76b64229cc37939d03"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd"] :knowledge-point/questions ["q-176834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-176865/ma-source-field/c7ebd3dd29aeff04c1715c78ec785028311403a823d4e82f5852c39c8cd7e166/66421ed265c4c11f591792941e8cbb8df0de1d9edfb1686ec48731f0ddc1bb4b" :answer/id #uuid "04dfe78b-c811-5b57-8684-5e4f44c6e6fe" :answer/type :answer.type/math :answer/value "¬(P∨Q)" :db/ensure [:answer/validate]} {:db/id "q-176865/ma-source-field/c7ebd3dd29aeff04c1715c78ec785028311403a823d4e82f5852c39c8cd7e166/17e4385d9d12e368554257ac70321297bdd8f458c72ebf