[{:db/id "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/18066732cd9ddfcaf3676c95f0cd6c78ff96754a3404b40890e832fe4afff084" :answer/id #uuid "5eefff0b-47f1-50f6-aa20-45a25564434f" :answer/type :answer.type/math :answer/value "\\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}+x{e}^{2x}y=\\frac{\\operatorname{cos}⁡x}{y}" :db/ensure [:answer/validate]} {:db/id "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/03f8514da25a9f98ded39382901e473ed2173b3df8528adf4297485098da4002" :answer/id #uuid "9eee3b1f-7860-522c-8e25-2ab9122c7049" :answer/type :answer.type/math :answer/value "\\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}-x{e}^{2x}=\\frac{\\operatorname{cos}⁡x}{y}" :db/ensure [:answer/validate]} {:db/id "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/4777ffd3191612436a1c59c9bb59b3417140c65bacd0cedde1dfe3bf118bee93" :answer/id #uuid "0dbcb751-5dd5-5c6c-8ef4-1f0333f1da29" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}y}{\\text{d}x}-x{e}^{y}={x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/dbf0265f5194dc5c171bbc12b1ac58dfafcb61e07222fbed554c728909314015" :answer/id #uuid "54197164-398c-585a-83dd-5174235ce646" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}y}{\\text{d}x}-y{e}^{2x}=\\frac{\\operatorname{cos}⁡x}{y}" :db/ensure [:answer/validate]} {:db/id "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/4f9a5aad0adf821eb3ec7c12dc42efe15793a95b140e25e14f86bc779039d17c" :answer/id #uuid "c6c9d281-4555-5a44-af3e-d9d7b6b8f65b" :answer/type :answer.type/math :answer/value "y\\frac{\\text{d}y}{\\text{d}x}-x{e}^{x}=\\frac{\\operatorname{sin}⁡x}{y}" :db/ensure [:answer/validate]} {:db/id "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed" :answer-field/id #uuid "440a36ad-3e7f-5834-9223-8af4fce0e717" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/18066732cd9ddfcaf3676c95f0cd6c78ff96754a3404b40890e832fe4afff084" "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/03f8514da25a9f98ded39382901e473ed2173b3df8528adf4297485098da4002" "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/4777ffd3191612436a1c59c9bb59b3417140c65bacd0cedde1dfe3bf118bee93" "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/dbf0265f5194dc5c171bbc12b1ac58dfafcb61e07222fbed554c728909314015" "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/4f9a5aad0adf821eb3ec7c12dc42efe15793a95b140e25e14f86bc779039d17c"] :answer-field/correct "q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed/03f8514da25a9f98ded39382901e473ed2173b3df8528adf4297485098da4002" :db/ensure [:answer-field/validate]} {:db/id "q-103567" :question/id #uuid "420cf089-e2ca-55d0-b4d5-3e91f54aadf7" :question/math-academy-id "q-103567" :question/problem "Which of the following is a first-order linear ordinary differential equation?" :question/worked-solution "To determine which of the following differential equations is a first-order linear ordinary differential equation, we attempt to write each option in the standard form.\n\nA first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nLet's attempt to write $\\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}-x{e}^{2x}=\\frac{\\operatorname{cos}⁡x}{y}$ in the standard form:\n\n$$\n\\begin{aligned}\\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}-x{e}^{2x} & =\\frac{\\operatorname{cos}⁡x}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x}-x{e}^{2x}y & =y\\cdot \\frac{\\operatorname{cos}⁡x}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x}-x{e}^{2x}y & =\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nThis differential equation is in standard form with  $P(x)=-x{e}^{2x}$ and $Q(x)=\\operatorname{cos}⁡x.$ Since the equation is written in standard form, we conclude that it is a first-order linear ODE.\n\nAll of the other equations cannot be written in the standard form, and therefore they are not first-order linear ODEs." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-103567/ma-source-field/7f5981f417cc055f7586995233fb26855feb1035c07cbec41573984078fe46ed"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc50a680-dbf8-5d45-a8c3-72c3c15243f6"] :knowledge-point/questions ["q-103567"] :db/ensure [:knowledge-point/validate]} {:db/id "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "297fec68-7633-5a4f-b758-461f512bfa1f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "fc7e14f3-bd1f-5912-9586-f5fdac2f41f6" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "67f68e51-f432-57bf-9c04-5cee503b7449" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7c0961d6-77ee-5ef6-b56f-f97f7519ca2c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2ec330cc-8c77-5e4b-b2b9-ffed05aa242e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406" :answer-field/id #uuid "bdede32f-8b30-513b-878d-48ae1f1b992d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :answer-field/correct "q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :db/ensure [:answer-field/validate]} {:db/id "q-103991" :question/id #uuid "d8d217e5-8474-5d6b-93f2-6f6e1253c6f4" :question/math-academy-id "q-103991" :question/problem "Given that\n\n$$\n\\int \\frac{7}{(x-1)(x+6)}\\,\\text{d}x=a\\operatorname{ln}⁡|x-1|+b\\operatorname{ln}⁡|x+6|+C,\n$$\n\nfind the value of $a+b.$" :question/worked-solution "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\begin{aligned}\\frac{7}{(x-1)(x+6)} & =\\frac{A}{x-1}+\\frac{B}{x+6},\\end{aligned}\n$$\n\nwhich gives\n\n$$\n7=A(x+6)+B(x-1).\n$$\n\nPlugging in $x=-6,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}7 & =A(-6+6)+B(-6-1) \\\\ 7 & =-7B \\\\ B & =-1\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=1,$ we can eliminate $B$ and solve for $A:$\n\n$$\n\\begin{aligned}7 & =A(1+6)+B(1-1) \\\\ 7 & =7A \\\\ A & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{7}{(x-1)(x+6)} & =\\frac{1}{x-1}-\\frac{1}{x+6}.\\end{aligned}\n$$\n\nFinally, we integrate, and we get\n\n$$\n\\begin{aligned}\\int \\frac{7}{(x-1)(x+6)}\\,\\text{d}x & =\\int (\\frac{1}{x-1}-\\frac{1}{x+6})\\text{d}x \\\\  & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{1}{x+6}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x-1|-\\operatorname{ln}⁡|x+6|+C.\\end{aligned}\n$$\n\nFinally, $a=1,b=-1,$ and $a+b=1-1=0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103991/ma-source-field/3cc8627a90c84a8a6f847bf43f5ca5f627d3e09780736f31123dbd1837107406"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d54bab77-d77f-5275-b454-ddb565eaa280"] :knowledge-point/questions ["q-103991"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105039/ma-source-field/e42ea873ee538626cf850e7133110248a47f3f135a3835302534254c83faeec0/c42f019dadccbd9996e4dce4187120308318269e2075531a8100fdebaef4be4b" :answer/id #uuid "21c8b940-ec49-5b82-a241-60223400265a" :answer/type :answer.type/math :answer/value "N⊆C" :db/ensure [:answer/validate]} {:db/id "q-105039/ma-source-field/e42ea873ee538626cf850e7133110248a47f3f135a3835302534254c83faeec0/2520799201045cc7dc06c8256150ce4374f140fa1ff4e1996526da5bd7a711a8" :answer/id #uuid "019a7ddb-b642-5b73-91c7-35328420ce62" :answer/type :answer.type/math :answer/value "Q⊆Q" :db/ensure [:answer/validate]} {:db/id "q-105039/ma-source-field/e42ea873ee538626cf850e7133110248a47f3f135a3835302534254c83faeec0/608aa8eee889cc9ba516a8468964f58babe8f298be2aea159122552581473af6" :answer/id #uuid "0b8ad165-2667-54ac-a98b-52fc9e