nd{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}=-2,$ ${\\lambda }_{2}=-3,$ and ${\\lambda }_{3}=-4.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a $3\\times 3$ matrix that has precisely $3$ distinct eigenvalues. \n\nTherefore, $A$ is diagonalizable, and its Jordan canonical form is\n\n$$\n{J}_{1}(-2)\\,⊕\\,{J}_{1}(-3)\\,⊕\\,{J}_{1}(-4)=[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & -4\\end{aligned}].\n$$\n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-110384/ma-source-field/515ab47273771789fe8f76527c6af2e6921c7c86bac61ba6f4b39aadacaf9d69"] :db/ensure [:question/validate]} {:db/id "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/5b7ffd34cdce965bf58c59c9f5392f68ed244257fa5400d1fc2e9ad59ffcd71d" :answer/id #uuid "5c039344-7829-5d64-b135-a5c8246b2396" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/0446fe32e53bff905dcf12854cc717acae086d5bcb545a9a74aabb32c9af8b5d" :answer/id #uuid "23ec273e-1ae2-5144-a326-6fbeb15c8dff" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/099a53472eba76f4f0c836e92e737f6f748524ec895e6324026453ebaaf08593" :answer/id #uuid "c72cb468-f276-54c6-bc38-32777e90c4cf" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/121e27e28b80c539bf505521fedc9abf0faba13e208f3b2133f8c61cded33382" :answer/id #uuid "02d7497c-4fd7-5870-b97b-cf4ae3a172a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/7fd1e3bad5ad169cfa4afbd74ed693bc5925e6033fb8072b56a6e865168aea4d" :answer/id #uuid "349b2037-067b-54a7-a04d-01371c51a6fa" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 1 & 0 \\\\ 0 & 3 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245" :answer-field/id #uuid "f6654880-b8cd-51ed-b3de-b163e5cfa06e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/5b7ffd34cdce965bf58c59c9f5392f68ed244257fa5400d1fc2e9ad59ffcd71d" "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/0446fe32e53bff905dcf12854cc717acae086d5bcb545a9a74aabb32c9af8b5d" "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/099a53472eba76f4f0c836e92e737f6f748524ec895e6324026453ebaaf08593" "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/121e27e28b80c539bf505521fedc9abf0faba13e208f3b2133f8c61cded33382" "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/7fd1e3bad5ad169cfa4afbd74ed693bc5925e6033fb8072b56a6e865168aea4d"] :answer-field/correct "q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245/0446fe32e53bff905dcf12854cc717acae086d5bcb545a9a74aabb32c9af8b5d" :db/ensure [:answer-field/validate]} {:db/id "q-110413" :question/id #uuid "d3c916b6-0455-5385-89d6-bc5b62f0897f" :question/math-academy-id "q-110413" :question/problem "$$\nA=[\\begin{aligned}-8 & -4 & -8 \\\\ -9 & 2 & -2 \\\\ 9 & 1 & 5\\end{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}={\\lambda }_{2}=-2$ and ${\\lambda }_{3}=3.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a $3\\times 3$ matrix with the following eigenvalues:\n\n- $\\lambda =-2$ of algebraic multiplicity $2$\n\n- $\\lambda =3$ of algebraic multiplicity $1$\n\nAs a result, we have one $1\\times 1$ Jordan block ${J}_{1}(3)$ corresponding to $\\lambda =3.$\nHowever, there are two possibilities for the Jordan blocks corresponding to $\\lambda =-2:$\n\n- *Case I.* We may get the single $2\\times 2$ Jordan block ${J}_{2}(-2).$ This happens when the generalized eigenvectors ${v}_{1}$ and ${v}_{2}$ corresponding to the eigenvalue $\\lambda =-2$ form the following chain:\n\n$$\n{v}_{2}\\overset{A+2I\\,}{\\to }{v}_{1}\\overset{A+2I\\,}{\\to }0\n$$\n\n- *Case II.* We may get a composition of two $1\\times 1$ Jordan blocks, namely ${J}_{1}(-2)\\,⊕\\,{J}_{1}(-2).$ This happens when the generalized eigenvectors ${v}_{1}$ and ${v}_{2}$ corresponding to the eigenvalue $\\lambda =-2$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{1}\\overset{A+2I\\,}{\\to }0 &  \\\\ {v}_{2}\\overset{A+2I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTo figure out which of the cases we obtain in this situation, let's find the number of linearly independent eigenvectors corresponding to $\\lambda =-2.$\n\nComputing $A+2I,$ we get\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}-8 & -4 & -8 \\\\ -9 & 2 & -2 \\\\ 9 & 1 & 5\\end{aligned}]+2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-6 & -4 & -8 \\\\ -9 & 4 & -2 \\\\ 9 & 1 & 7\\end{aligned}].\\end{aligned}\n$$\n\nNow, we reduce this matrix to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}-6 & -4 & -8 \\\\ -9 & 4 & -2 \\\\ 9 & 1 & 7\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-\\frac{3}{2}){R}_{1} \\\\ {R}_{3}:={R}_{3}+\\frac{3}{2}{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}-6 & -4 & -8 \\\\ 0 & 10 & 10 \\\\ 0 & -5 & -5\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+\\frac{1}{2}{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}-6 & -4 & -8 \\\\ 0 & 10 & 10 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $\\text{nullity}(A+2I)=1,$ there will be only one eigenvector that corresponds to the eigenvalue $\\lambda =-2,$ say, ${v}_{1}.$ So, the generalized eigenvectors corresponding to the eigenvalue $\\lambda =-2$ form the following chain: \n\n$$\n{v}_{2}\\overset{A+2I\\,}{\\to }{v}_{1}\\overset{A+2I\\,}{\\to }0\n$$\n\nTherefore, we have *case I*, and $A$ has the following Jordan canonical form:\n\n$$\n{J}_{1}(3)\\,⊕\\,{J}_{2}(-2)=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110413/ma-source-field/56cba56f79e5b3e6c7f50d8db12ae7a82dab6f3e50a8d3cad1feb3255e4ae245"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a7076c0-fa73-5cb1-9206-2b129dd08be1"] :knowledge-point/questions ["q-110413"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/fcb49a9aa830af4d1148e4cab7820eb36385cb87859683a7c37b23527529fd05" :answer/id #uuid "a53c398e-7555-5fb9-a6a0-0938ab2c88c8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/b3f67c2b8d2bd55cea55f80b3224e341832b2662e6ecb1d8db9281cf7efacc22" :answer/id #uuid "245b397f-1f2b-575c-8f12-28d64866f083" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -3 & 0 \\\\ 0 & 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/804e86573fe4438d78cbbf92cb7f40a996738cdb6ec554ea518214318b53416e" :answer/id #uuid "b629b33d-8fad-5327-90c0-4d0788d4b71a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -3 & 1 \\\\ 0 & 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/8012d235075ccecedfcb5e66d28001747d810c161f22fe639cfa30f00250d167" :answer/id #uuid "690eed49-647b-5ee9-b694-64f206d6f376" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 1 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/6e3a4ff1902b37ed692fb5acc234a747c049210001c165996f048116ef70e516" :answer/id #uuid "17f321da-1a74-5111-854e-26f1799287a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 1 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464" :answer-field/id #uuid "5bead4eb-4c8c-5120-9abe-029ac9344bbe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/fcb49a9aa830af4d1148e4cab7820eb36385cb87859683a7c37b23527529fd05" "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/b3f67c2b8d2bd55cea55f80b3224e341832b2662e6ecb1d8db9281cf7efacc22" "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/804e86573fe4438d78cbbf92cb7f40a996738cdb6ec554ea518214318b53416e" "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/8012d235075ccecedfcb5e66d28001747d810c161f22fe639cfa30f00250d167" "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/6e3a4ff1902b37ed692fb5acc234a747c049210001c165996f048116ef70e516"] :answer-field/correct "q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464/fcb49a9aa830af4d1148e4cab7820eb36385cb87859683a7c37b23527529fd05" :db/ensure [:answer-field/validate]} {:db/id "q-110438" :question/id #uuid "7de0c22b-158b-598d-9b98-621628ea06b6" :question/math-academy-id "q-110438" :question/problem "$$\nA=[\\begin{aligned}-8 & -1 & 6 \\\\ -6 & -3 & 6 \\\\ -6 & -1 & 4\\end{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}={\\lambda }_{2}=-2,$ and ${\\lambda }_{3}=-3.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a $3\\times 3$ matrix with the following eigenvalues:\n\n- $\\lambda =-2$ of algebraic multiplicity $2$\n\n- $\\lambda =-3$ of algebraic multiplicity $1$\n\nAs a result, we have one $1\\times 1$ Jordan block ${J}_{1}(-3)$ corresponding to $\\lambda =-3.$\nHowever, there are two possibilities for the Jordan blocks corresponding to $\\lambda =-2:$\n\n- *Case I.* We may get the single $2\\times 2$ Jordan block ${J}_{2}(-2).$ This happens when the generalized eigenvectors ${v}_{1}$ and ${v}_{2}$ corresponding to the eigenvalue $\\lambda =-2$ form the following chain:\n\n$$\n{v}_{2}\\overset{A+2I\\,}{\\to }{v}_{1}\\overset{A+2I\\,}{\\to }0\n$$\n\n- *Case II.* We may get a composition of two $1\\times 1$ Jordan blocks, namely ${J}_{1}(-2)\\,⊕\\,{J}_{1}(-2).$ This happens when the generalized eigenvectors ${v}_{1}$ and ${v}_{2}$ corresponding to the eigenvalue $\\lambda =-2$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{1}\\overset{A+2I\\,}{\\to }0 &  \\\\ {v}_{2}\\overset{A+2I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTo figure out which of the cases we obtain in this situation, let's find the number of linearly independent eigenvectors corresponding to $\\lambda =-2.$\n\nComputing $A+2I,$ we get\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}-8 & -1 & 6 \\\\ -6 & -3 & 6 \\\\ -6 & -1 & 4\\end{aligned}]+2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-6 & -1 & 6 \\\\ -6 & -1 & 6 \\\\ -6 & -1 & 6\\end{aligned}].\\end{aligned}\n$$\n\nNow, we reduce this matrix to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}-6 & -1 & 6 \\\\ -6 & -1 & 6 \\\\ -6 & -1 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}-6 & -1 & 6 \\\\ 0 & 0 & 0 \\\\ -6 & -1 & 6\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}-6 & -1 & 6 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $\\text{nullity}(A+2I)=2,$ there will be two eigenvectors that correspond to the eigenvalue $\\lambda =-2,$ say, ${v}_{1}$ and ${v}_{2}.$ So, the generalized eigenvectors corresponding to the eigenvalue $\\lambda =-2$ form the following chains: \n\n$$\n\\begin{aligned}{v}_{1}\\overset{A+2I\\,}{\\to }0 \\\\ {v}_{2}\\overset{A+2I\\,}{\\to }0\\end{aligned}\n$$\n\nTherefore, we have *case II*, and $A$ has the following Jordan canonical form:\n\n$$\n{J}_{1}(-2)\\,⊕\\,{J}_{1}(-2)\\,⊕\\,{J}_{1}(-3)=[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -3\\end{aligned}]\n$$\n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110438/ma-source-field/6333f80a51317255b0d1b8563136d69b7c893e7ca8686aa5fc58238dd88bc464"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a7076c0-fa73-5cb1-9206-2b129dd08be1"] :knowledge-point/questions ["q-110438"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/c0164cf136af52220771800c3701884e5b6dfff29b5e10934faf57a35ba45599" :answer/id #uuid "eee2c664-527e-54d2-ab4e-0ea9aefbbaa6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & -1 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/b3a8f49e49d18503b36a451cb9bf7473a3333c1599d1b68d692cad11e322fb1b" :answer/id #uuid "9863101e-36a7-5d75-87dd-952fbe68619f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/e388a7cca8d2e26834b368f9d50aee879d7d3f4a6a14a361cf2057cb452c513f" :answer/id #uuid "1f2682f5-572d-5d14-977a-a2e20d52ee12" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/6295676c521b85d957d0736e51f6a57fa4a5863983270a40aaa3eff00a8acdcc" :answer/id #uuid "21d923ee-5277-570b-854b-1f054ce6b20d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/e6db707eb06488a7bf285519c80c9cf96bbe4a27d6818997394442b4e6a47e32" :answer/id #uuid "270ba111-a391-5409-ab6e-c124c9429896" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5" :answer-field/id #uuid "ab915e03-b049-5d6e-9faa-ad202c3447b3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/c0164cf136af52220771800c3701884e5b6dfff29b5e10934faf57a35ba45599" "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/b3a8f49e49d18503b36a451cb9bf7473a3333c1599d1b68d692cad11e322fb1b" "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/e388a7cca8d2e26834b368f9d50aee879d7d3f4a6a14a361cf2057cb452c513f" "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/6295676c521b85d957d0736e51f6a57fa4a5863983270a40aaa3eff00a8acdcc" "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/e6db707eb06488a7bf285519c80c9cf96bbe4a27d6818997394442b4e6a47e32"] :answer-field/correct "q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5/e6db707eb06488a7bf285519c80c9cf96bbe4a27d6818997394442b4e6a47e32" :db/ensure [:answer-field/validate]} {:db/id "q-110499" :question/id #uuid "71312644-ebc0-5211-a7dd-54a8017a0c75" :question/math-academy-id "q-110499" :question/problem "$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 2 & -1 \\\\ 0 & 1 & 0\\end{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}={\\lambda }_{2}={\\lambda }_{3}=1.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a non-scalar $3\\times 3$ matrix that has the eigenvalue $\\lambda =1$ of algebraic multiplicity $3.$ \n\nAs a result, there are two possibilities for the Jordan blocks corresponding to $\\lambda =1:$\n\n- *Case I.* We may have the single $3\\times 3$ Jordan block ${J}_{3}(1).$ This happens when the generalized eigenvectors ${v}_{1},{v}_{2}$ and ${v}_{3}$ corresponding to $\\lambda =1$ form the following chain:\n\n$$\n{v}_{3}\\overset{A-I\\,}{\\to }{v}_{2}\\overset{A-I\\,}{\\to }{v}_{1}\\overset{A-I\\,}{\\to }0\n$$\n\n- *Case II.* We may have a composition of one $2\\times 2$ and one $1\\times 1$ Jordan block, say ${J}_{2}(1)\\,⊕\\,{J}_{1}(1).$ This happens when the generalized eigenvectors ${v}_{1},{v}_{2}$ and ${v}_{3}$ corresponding to $\\lambda =1$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{2}\\overset{A-I\\,}{\\to }{v}_{1}\\overset{A-I\\,}{\\to }0 &  \\\\ {v}_{3}\\overset{A-I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTo figure out which of the cases we have in this situation, we find the number of linearly independent eigenvectors corresponding to $\\lambda =1.$\n\nComputing $A-I,$ we get\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 2 & -1 \\\\ 0 & 1 & 0\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we reduce this matrix to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{1}↔{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 1 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}↔{R}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}2 & 1 & -1 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $\\text{nullity}(A-I)=1,$ there will be only one eigenvector that corresponds to the eigenvalue $\\lambda =1,$ say, ${v}_{1}.$ So, the generalized eigenvectors corresponding to the eigenvalue $\\lambda =1$ form the following chain: \n\n$$\n{v}_{3}\\overset{A-I\\,}{\\to }{v}_{2}\\overset{A-I\\,}{\\to }{v}_{1}\\overset{A-I\\,}{\\to }0\n$$\n\n \n\nTherefore, we have *case I*, and $A$ has the following Jordan canonical form:\n\n$$\n{J}_{3}(1)=[\\begin{aligned}1 & 1 & 0 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\n \n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110499/ma-source-field/96be223ad86a93a99a2327d39389b25fce744639a67f4a3e9da1c97054f0bab5"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83ce5e23-e0ef-5f59-afe8-5c63d901b290"] :knowledge-point/questions ["q-110499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/471e769ecd39727265d7199476614658b88b96efa318b2c7582d7b503da6b4de" :answer/id #uuid "0998f283-a905-59c1-9509-3bf9f34ed91f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-5 & 1 & 0 \\\\ 0 & -5 & 1 \\\\ 0 & 0 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/dc454497baa366e799de059fd4c0b94638a366bdfac76a6d1036112c96874973" :answer/id #uuid "22a26e41-a128-529a-80bd-127bc659ab25" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/16331f32dc5a5aec902ed3f3994b57d6fecf99910fd1997afa477c27ed10b8f2" :answer/id #uuid "fc6d2713-8b88-5129-ad16-14efae66478a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 1 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/1fb105916efba8f88d8c78d1c78da6ebb3f7d6ad4543fc53813bcce4da9764db" :answer/id #uuid "a6cce340-2fd9-58a0-92b2-d3d5f9ec7d26" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 1 & 0 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & -5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/93ca02f72917854b21153eef5f92f770f12a14007f6a6b0d26ba6b434c0577fc" :answer/id #uuid "2edbcdfc-73f7-5526-b6fe-d7840dc88482" :answer/type :answer.type/math :answer/value "[\\begin{aligned}5 & 1 & 0 \\\\ 0 & 5 & 1 \\\\ 0 & 0 & 5\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b" :answer-field/id #uuid "9f5c176b-7979-5eff-a76f-39031b1756d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/471e769ecd39727265d7199476614658b88b96efa318b2c7582d7b503da6b4de" "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/dc454497baa366e799de059fd4c0b94638a366bdfac76a6d1036112c96874973" "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/16331f32dc5a5aec902ed3f3994b57d6fecf99910fd1997afa477c27ed10b8f2" "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/1fb105916efba8f88d8c78d1c78da6ebb3f7d6ad4543fc53813bcce4da9764db" "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/93ca02f72917854b21153eef5f92f770f12a14007f6a6b0d26ba6b434c0577fc"] :answer-field/correct "q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b/16331f32dc5a5aec902ed3f3994b57d6fecf99910fd1997afa477c27ed10b8f2" :db/ensure [:answer-field/validate]} {:db/id "q-110519" :question/id #uuid "e4031e9e-1517-5e53-b202-bd9db6b4d16d" :question/math-academy-id "q-110519" :question/problem "$$\nA=[\\begin{aligned}5 & 1 & -1 \\\\ 0 & 6 & -1 \\\\ 0 & 1 & 4\\end{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}={\\lambda }_{2}={\\lambda }_{3}=5.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a non-scalar $3\\times 3$ matrix that has the eigenvalue $\\lambda =5$ of algebraic multiplicity $3.$ \n\nAs a result, there are two possibilities for the Jordan blocks corresponding to $\\lambda =5:$\n\n- *Case I.* We may have the single $3\\times 3$ Jordan block ${J}_{3}(5).$ This happens when the generalized eigenvectors ${v}_{1},{v}_{2}$ and ${v}_{3}$ corresponding to $\\lambda =5$ form the following chain: \n\n$$\n{v}_{3}\\overset{A-5I\\,}{\\to }{v}_{2}\\overset{A-5I\\,}{\\to }{v}_{1}\\overset{A-5I\\,}{\\to }0\n$$\n\n- *Case II.* We may have a composition of one $2\\times 2$ and one $1\\times 1$ Jordan block, say ${J}_{2}(5)\\,⊕\\,{J}_{1}(5).$ This happens when the generalized eigenvectors ${v}_{1},{v}_{2}$ and ${v}_{3}$ corresponding to $\\lambda =5$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{2}\\overset{A-5I\\,}{\\to }{v}_{1}\\overset{A-5I\\,}{\\to }0 &  \\\\ {v}_{3}\\overset{A-5I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTo figure out which of the cases we have in this situation, we find the number of linearly independent eigenvectors corresponding to $\\lambda =5.$\n\nComputing $A-5I,$ we get\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}5 & 1 & -1 \\\\ 0 & 6 & -1 \\\\ 0 & 1 & 4\\end{aligned}]-5[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 1 & -1 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we reduce this matrix to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}0 & 1 & -1 \\\\ 0 & 1 & -1 \\\\ 0 & 1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 1 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 1 & -1\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 1 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the matrix above, there is one pivot column (the 2nd  one). So, the rank of $A-5I$ is $1.$ Using the rank-nullity theorem, we have that \n\n$$\n\\begin{aligned}\\text{nullity}(A-5I) & =3-\\text{rank}(A-5I) \\\\  & =3-1 \\\\  & =2.\\end{aligned}\n$$\n\n \n\nRecall that the nullity of $A-5I$ gives the number of eigenvectors corresponding to $\\lambda =5.$ Therefore, there must be two such eigenvectors, say, ${v}_{1}$ and ${v}_{3}.$ \nSo, the generalized eigenvectors corresponding to the eigenvalue $\\lambda =1$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{2}\\overset{A-5I\\,}{\\to }{v}_{1}\\overset{A-5I\\,}{\\to }0 &  \\\\ {v}_{3}\\overset{A-5I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTherefore, we have *case II*, and $A$ has the following Jordan canonical form:\n\n$$\n{J}_{2}(5)\\,⊕\\,{J}_{1}(5)=[\\begin{aligned}5 & 1 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 5\\end{aligned}]\n$$\n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110519/ma-source-field/83e7edbbdebefdf0f523382a749c17bd95e6c2b5a5162fe42dfdf8cc2906b86b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83ce5e23-e0ef-5f59-afe8-5c63d901b290"] :knowledge-point/questions ["q-110519"] :db/ensure [:knowledge-point/validate]} {:db/id "q-111309/ma-source-field/0982cae828061fffebd855b2fadcd0bee092212d9793c59bf9cc6585dbda4aab/441f9a41e4c1d7c29719a73a7d795c394ee1337b1a990ebfb59a7b69a254418f" :answer/id #uuid "4d1aa619-6cc5-5d75-b134-af72b193895b" :answer/type :answer.type/math :answer/value "0.7" :db/ensure [:answer/validate]} {:db/id "q-111309/ma-source-field/0982cae828061fffebd855b2fadcd0bee092212d9793c59bf9cc6585dbda4aab/eff549b88f0dad60b4aaf57a41812ed8f8a24b530f6b82e0efa8a15dca6852b6" :answer/id #uuid "003fd3e7-d9ba-5c66-bdc0-bf0b319a14ec" :answer/type :answer.type/math :answer/value "3.1" :db/ensure [:answer/validate]} {:db/id "q-111309/ma-source-field/0982cae828061fffebd855b2fadcd0bee092212d9793c59bf9cc6585dbda4aab/76c4fc174488a2dfcb2fd772cf3f97232b8e3aa256c18a493e6dd516bc975248" :answer/id #uuid "a34e4842-6531-564e-a6a6-c96f33ae44d7" :answer/type :answer.type/math :answer/value "3.4" :db/ensure [:answer/validate]} {:db/id "q-111309/ma-source-