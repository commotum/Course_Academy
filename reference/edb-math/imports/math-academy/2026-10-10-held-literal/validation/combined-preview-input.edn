558b244e1ef998a9fc3d799828ea62de904/ca362485a36b019a9aa6a4f86d346efd68d75b73713a3c8e4b2fa4ebb48ada47"] :answer-field/correct "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :db/ensure [:answer-field/validate]} {:db/id "q-115910" :question/id #uuid "682478c9-f41b-564c-8e03-bd7edda3fd9a" :question/math-academy-id "q-115910" :question/problem "What are the coordinates of the vertex of the parabola ${y}^{2}=-x?$" :question/worked-solution "The standard equation of a left- or right-opening parabola that has its vertex at the origin is\n\n$$\n{y}^{2}=4px,\n$$\n\nwhere $p$ is a constant.\n\nWe can rewrite the given equation as \n\n$$\n{y}^{2}=4(-\\frac{1}{4})x.\n$$\n\nIt is now clear that our equation is of the standard type with $p=-\\frac{1}{4}.$ Therefore, our parabola has its vertex at $(0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e302810-8b14-5c8c-8bbb-245386a66b7c"] :knowledge-point/questions ["q-115910"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116051/ma-source-field/fb702f1ba880a8130a77c4c5016ffc0399e8cc9d10b882fbb8763b0b8a3a0ddc/2988eb935b0c3e8aec7e62ee98879dcc40dce13116f3cbe31166f18c84c6eeab" :answer/id #uuid "ad1ee6ea-b061-51dc-b501-839195b28399" :answer/type :answer.type/math :answer/value "10\\text{ m}/\\text{min}" :db/ensure [:answer/validate]} {:db/id "q-116051/ma-source-field/fb702f1ba880a8130a77c4c5016ffc0399e8cc9d10b882fbb8763b0b8a3a0ddc/2be24b258d1c8100b297597cacf7db0cb6f22f9e2491846693e273412246b9b3" :answer/id #uuid "58cdd8af-ecc0-5a53-9201-682ba5b6106b" :answer/type :answer.type/math :answer/value "12\\text{ m}/\\text{min}" :db/ensure [:answer/validate]} {:db/id "q-116051/ma-source-field/fb702f1ba880a8130a77c4c5016ffc0399e8cc9d10b882fbb876