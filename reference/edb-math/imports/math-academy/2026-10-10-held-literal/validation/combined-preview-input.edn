34f4883/55e34e8a8645bf9a6f5e4cb4d0f92368a138290515792fdec8a2d4bb857e972e" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "17751a3b-ed4b-5966-a450-330460c02715"] :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=-10.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =-10\\int \\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-10x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-10x+C)\\text{d}x \\\\ y & =-10\\cdot \\frac{{x}^{2}}{2}+Cx+D \\\\  & =-5{x}^{2}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-50139/ma-source-field/d50cb7942c0f354a9eeb3afec62053aeaef745ae8437be93c1dd3c76034f4883"] :db/ensure [:question/validate]} [:db/retract 17592186097307 :question/answer-fields 17592186095736] {:db/id "q-50148/ma-source-field/af8207d7cb15cf9b264f494c523ef136c9ac9b180a6f231e94e2c04b17b54426/37e98befdb2e3df95d4d61d45c8f4fb56fa95d619543b6c6a1abed8d23ca01ff" :answer/id #uuid "1e9d1539-56f7-56d2-9de6-1e9901343c60" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{3}{e}^{3x}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-50148/ma-source-field/af8207d7cb15cf9b264f494c523ef136c9ac9b180a6f231e94e2c04b17b54426/f2ba9f51e2cde996ce0e2434cdb78e2945edabf7d6a8073b1ca4238dff069e8e" :answer/id #uuid "89be7220-c09b-594d-8bff-c3a06f0b9221" :answer/type :answer.type/math :answer/value "y=-\\frac{1}{9}{e}^{3x}+C{x}^{2}+D" :db/ensure [:answer/validate]} {:db/id "q-50148/ma-source-field/af8207d7cb15cf9b264f494c523ef136c9ac9b180a6f231e94e2c04b17b54426/9a78f17b777446126d510433bf387e1c2d54c0544253357d711ed4ab51500210" :answer/id #uuid "bd19773a-598c-5d4a-993