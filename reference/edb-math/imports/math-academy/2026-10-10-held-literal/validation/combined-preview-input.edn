34a4f405" "q-139454/ma-source-field/9883ce04a6b031a9b5ca76f96c2375889765c56c629bdcd3b14d844f2c2987a1/a3a5487afcc81a1c06c56ceaee82744a099a79debc8be0e8469f77e68bf12a04" "q-139454/ma-source-field/9883ce04a6b031a9b5ca76f96c2375889765c56c629bdcd3b14d844f2c2987a1/4bbfb72628082fa3896a6f4aeda1ea54666447e3f72d7f426fd031c3378b97bb" "q-139454/ma-source-field/9883ce04a6b031a9b5ca76f96c2375889765c56c629bdcd3b14d844f2c2987a1/f98c18a27dcb118caf5a5576c91aab2f7c6ef2dcdc9bdea8485ada011f865eac" "q-139454/ma-source-field/9883ce04a6b031a9b5ca76f96c2375889765c56c629bdcd3b14d844f2c2987a1/82c79a11c5f316588a4977bf9de059017422d38604e630b6407357df3b622d75"] :answer-field/correct "q-139454/ma-source-field/9883ce04a6b031a9b5ca76f96c2375889765c56c629bdcd3b14d844f2c2987a1/82c79a11c5f316588a4977bf9de059017422d38604e630b6407357df3b622d75" :db/ensure [:answer-field/validate]} {:db/id "q-139454" :question/id #uuid "3c94d6f3-17f8-58e7-b287-f9a855b746d1" :question/math-academy-id "q-139454" :question/problem "Which of the following is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =-4$ for the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}-4 & 0 & 0 \\\\ 1 & -4 & 0 \\\\ 0 & 1 & -4\\end{aligned}]?\n$$\n\n*Hint: You may wish to make use of the following results:*\n\n$$\n\\begin{aligned}(A+4I)^{2}=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 1 & 0 & 0\\end{aligned}],\\,(A+4I)^{3}=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}.\n$$" :question/worked-solution "Given a matrix $A$ with eigenvalue $\\lambda ,$ a generalized eigenvector of rank $k$ is a vector $v$ that satisfies\n\n$$\n(A-\\lambda I)^{k}v=0\\,\\text{and}\\,(A-\\lambda I)^{k-1}v\\ne 0.\n$$\n\nTo find a generalized eigenvector of rank $3$ corresponding to $\\lambda =-4,$ we need to find a vector $v$ that satisfies\n\n$$\n(A+4I)^{3}v=0\\,\\text{and}\\,(A+4I)^{2}v\\ne 0.\n$$\n\nLet's consider each condition:\n\n- We start by solving $(A+4I)^{3}v=0.$ We're given that\n\n$$\n(A+4I)^{3}=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\,.\n$$\n\nThis means that *any* vector in ${R}^{3}$ is a solution to $(A+4I)^{3}v=0.$ Therefore, the solution to $(A+4I)^{3}v=0$ can be written as\n\n$$\n\\begin{aligned}v=[\\begin{aligned}{v}_{1} \\\\ {v}_{2} \\\\ {v}_{3}\\end{aligned}]={v}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]+{v}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{v}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we solve $(A+4I)^{2}v=0.$ We have\n\n$$\n(A+4I)^{2}=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\\,.\n$$\n\nThis means that the solution to $(A+4I)^{2}v=0$ is ${v}_{1}=0,$ where ${v}_{2}$ and ${v}_{3}$ are free variables. Therefore, the solution to $(A+4I)^{2}v=0$ can be written as\n\n$$\n\\begin{aligned}v=[\\begin{aligned}{v}_{1} \\\\ {v}_{2} \\\\ {v}_{3}\\end{aligned}]=[\\begin{aligned}0 \\\\ {v}_{2} \\\\ {v}_{3}\\end{aligned}]={v}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+{v}_{3}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nComparing the solutions, we see that the vector $[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]$ satisfies $(A+4I)^{3}v=0$ but does *not* satisfy $(A+4I)^{2}v=0.$ \n\nHence, $[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]$ is a generalized eigenvector of rank $3$ of $A.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-139454/ma-source-field/9883ce04a6b031a9b5ca76f96c2375889765c56c629bdcd3b14d844f2c2987a1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de97ba5b-7e05-5f3d-b11d-bf8e10c3bc54"] :knowledge-point/questions ["q-139454"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/b5af170cb1a071e9e1186efb567bab86ed0f83ee17fe770cfa72a6acd38547b4" :answer/id #uuid "8642137f-d66c-5a2c-ae0a-4ef5266bcf18" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ 1 \\\\ 4 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/69110279b97442a4f79d77aa23e4ceb6d2729b686fed66030ab82dbc259a7b71" :answer/id #uuid "71b74f4c-2b14-5f0c-9aa3-db59d3b3ef3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 1 \\\\ -2 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/1091a26a6bb7c58e5ddcc949bf49b622e5d748db3973c68cb89d6460831de0a7" :answer/id #uuid "ef772d27-a54c-5362-adfe-f41ae7b23dca" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-6 \\\\ 2 \\\\ -2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/de10d9c21f2abd99bbc7ec87649eb80885fbb611fd99a530f20ab6b963895aeb" :answer/id #uuid "34b99926-5586-5bc7-ba1f-bc66c66e6e8e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-9 \\\\ 1 \\\\ -2 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/5e56c231163065200378f879837f84bd4f17a016abb79c1aea27e5def4688984" :answer/id #uuid "a557db17-2b18-5b72-9311-1df4e238f75d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99" :answer-field/id #uuid "f74f3682-41ce-5a31-9b35-9471ffa05fed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/b5af170cb1a071e9e1186efb567bab86ed0f83ee17fe770cfa72a6acd38547b4" "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/69110279b97442a4f79d77aa23e4ceb6d2729b686fed66030ab82dbc259a7b71" "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/1091a26a6bb7c58e5ddcc949bf49b622e5d748db3973c68cb89d6460831de0a7" "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/de10d9c21f2abd99bbc7ec87649eb80885fbb611fd99a530f20ab6b963895aeb" "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/5e56c231163065200378f879837f84bd4f17a016abb79c1aea27e5def4688984"] :answer-field/correct "q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99/1091a26a6bb7c58e5ddcc949bf49b622e5d748db3973c68cb89d6460831de0a7" :db/ensure [:answer-field/validate]} {:db/id "q-140117" :question/id #uuid "d62d6869-fd0d-50a4-9c77-6fb492970304" :question/math-academy-id "q-140117" :question/problem "Let $x=[\\begin{aligned}-5 \\\\ 5 \\\\ -3 \\\\ 1\\end{aligned}]$ and $a=[\\begin{aligned}2 \\\\ 6 \\\\ -2 \\\\ 4\\end{aligned}].$ If $x=y+z,$ where $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ then $z=$" :question/worked-solution "![](images/d8/d887852fe51f08cb7296437e69b6a9632721cfd155558e6abf9a99b4f59f7ad6.png)\n\nFirst, we find the orthogonal projection of $x$ onto $\\text{Span}{a}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,x & =\\frac{a\\cdot x}{a\\cdot a}a \\\\  & =\\frac{2\\cdot (-5)+6\\cdot 5+(-2)\\cdot (-3)+4\\cdot 1}{{2}^{2}+{6}^{2}+(-2)^{2}+{4}^{2}}a \\\\  & =\\frac{-10+30+6+4}{4+36+4+16}a \\\\  & =\\frac{30}{60}a \\\\  & =\\frac{1}{2}a \\\\  & =\\frac{1}{2}[\\begin{aligned}2 \\\\ 6 \\\\ -2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 3 \\\\ -1 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get the following: \n\n$$\n\\begin{aligned}y & ={\\text{proj}}_{a}\\,x=[\\begin{aligned}1 \\\\ 3 \\\\ -1 \\\\ 2\\end{aligned}] \\\\ z & =x-{\\text{proj}}_{a}\\,x=[\\begin{aligned}-5 \\\\ 5 \\\\ -3 \\\\ 1\\end{aligned}]-[\\begin{aligned}1 \\\\ 3 \\\\ -1 \\\\ 2\\end{aligned}]=[\\begin{aligned}-6 \\\\ 2 \\\\ -2 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nNotice that $y\\in \\text{Span}{a}$ and $z⊥\\text{Span}{a},$ as shown in the picture above.\n\nIn conclusion, $z=[\\begin{aligned}-6 \\\\ 2 \\\\ -2 \\\\ -1\\end{aligned}].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140117/ma-source-field/c05c4fdefff749bf1ca44db3b9f1a058be9387376582fe202ed1101610958b99"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "144d1258-f8d5-55e9-be38-ec25b6f84bd3"] :knowledge-point/questions ["q-140117"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "ce317114-fb9b-5281-ada3-55ec1a4af574" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "17e9ceb5-4080-500e-8bcd-622b7ae80448" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "bcf9e771-6593-534a-bec0-24bdaeea40ef" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "40f9a0c5-f923-59d8-b738-65afcd30e84e" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e" :answer/id #uuid "5a488685-74ca-5b6f-8ca3-f7e24eb44fc8" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46" :answer-field/id #uuid "679ffd13-8aa6-5264-8220-82a24974cff9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e"] :answer-field/correct "q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :db/ensure [:answer-field/validate]} {:db/id "q-140579" :question/id #uuid "32164094-a2a0-521c-8478-fb3407c48f4e" :question/math-academy-id "q-140579" :question/problem "![](images/a7/a71e2e5e4cd2fddac779a7c2d21d072663f406bc6595ef9c7e15c885bbb83889.png)\n\nThe total area $A$ of the region between the curve $y=1-\\frac{4}{x+3}$ and the $x$-axis from $x=-2$ to $x=5$ is given by the integral expression below. What is the value of $a?$\n\n$$\nA=-{\\int }_{-2}^{a}(1-\\frac{4}{x+3})\\text{d}x+{\\int }_{a}^{5}(1-\\frac{4}{x+3})\\text{d}x.\n$$" :question/worked-solution "To determine the missing limit of integration, we need to find the $x$-intercept of the curve $y=1-\\frac{4}{x+3}.$ So, we set $y=0$ and solve for $x$ as follows:\n\n$$\n\\begin{aligned}1-\\frac{4}{x+3} & =0 \\\\ -\\frac{4}{x+3} & =-1 \\\\ \\frac{4}{x+3} & =1 \\\\ 4 & =x+3 \\\\ 1 & =x \\\\ x & =1\\end{aligned}\n$$\n\nSince $1\\in [-2,5],$ we have two regions:\n\n- The area between the curve and the $x$-axis from $x=-2$ to $x=1.$\n\n- The area between the curve and the $x$-axis from $x=1$ to $x=5.$\n\nSo, $a=1$ and the final expression will be\n\n$$\nA=-{\\int }_{-2}^{1}(1-\\frac{4}{x+3})\\text{d}x+{\\int }_{1}^{5}(1-\\frac{4}{x+3})\\text{d}x.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140579/ma-source-field/1b62fec68668a05d86c88b30df6669b995b10e8ca3b48c329c08f9c91491cd46"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18cd52a9-1524-5099-b1d8-858345328bad"] :knowledge-point/questions ["q-140579"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141113/ma-source-field/f4b14c6b2ca55491a1fc127585c041467e8dc29fe66c015f768a8c992a0c619a/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "5be53b7e-12b8-56ea-82fa-df826cb81389" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-141113/ma-source-field/f4b14c6b2ca55491a1fc127585c041467e8dc29fe66c015f768a8c992a0c619a/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "6ffa9645-4799-55ea-b858-499c63ccbd0f" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-141113/ma-source-field/f4b14c6b2ca55491a1fc127585c041467e8dc29fe66c015f768a8c992a0c619a/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6125d774-7a34-522e-a338-4e504b088a07" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-141113/ma-source-field/f4b14c6b2ca55491a1fc127585c041467e8dc29fe66c015f768a8c992a0c619a/be9e