dda52e2" :question/math-academy-id "q-131386" :question/problem "The inverse of the matrix $A$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -10 & -2 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -2 & 10 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -5 & -\\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ -10 & -2 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+10{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & -2 & 10 & 1\\end{aligned}] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -5 & -\\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:={R}_{2}+10{R}_{1},\\,{R}_{2}:=-\\frac{1}{2}{R}_{2}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}1 & 0 \\\\ -5 & -\\frac{1}{2}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131386/ma-source-field/80d2b30f05a3096f0a84976044992f612667b50f9b2ad270eac962102f3a7621"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e"] :knowledge-point/questions ["q-131386"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/38733643a7782b36b9a9ebeec0a0aa14aa3145bae68928ef575be22f921dc5f3" :answer/id #uuid "92b6e22e-e14f-536e-a8cf-ab5edfb0d027" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+2{R}_{2},\\,{R}_{2}:={R}_{2}-{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/add1e024b9e87cfd79cd986e95f22ace73e5ead79047fd6fac2528844c026988" :answer/id #uuid "8a98a201-ff8f-5c9f-a6de-5a59d7503724" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+3{R}_{2},\\,{R}_{2}:={R}_{2}-2{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/77a2fef4c5482b22c0163f5f3517be0940e0c08ddb84bd9e195c05b055513100" :answer/id #uuid "3540d783-48ba-526c-a122-0ebe4bb9b9be" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}+{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/73a8951f7eb0c167105724e15ab41c62d364ab86e1832cc8f26336c232696a6d" :answer/id #uuid "3f468114-a837-5315-9463-743e098f65ca" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}-{R}_{2},\\,{R}_{2}:={R}_{2}+2{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/a5e638b4161a6c831673fe378b7ae2beb921e5495c22abd6a9bb60ca07b908c5" :answer/id #uuid "dd01665e-3643-581b-8e10-6bc426a9baba" :answer/type :answer.type/math :answer/value "{R}_{1}:={R}_{1}-{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46" :answer-field/id #uuid "89863539-4901-5ced-a4bc-1a69933efb51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/38733643a7782b36b9a9ebeec0a0aa14aa3145bae68928ef575be22f921dc5f3" "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/add1e024b9e87cfd79cd986e95f22ace73e5ead79047fd6fac2528844c026988" "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/77a2fef4c5482b22c0163f5f3517be0940e0c08ddb84bd9e195c05b055513100" "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/73a8951f7eb0c167105724e15ab41c62d364ab86e1832cc8f26336c232696a6d" "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/a5e638b4161a6c831673fe378b7ae2beb921e5495c22abd6a9bb60ca07b908c5"] :answer-field/correct "q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46/77a2fef4c5482b22c0163f5f3517be0940e0c08ddb84bd9e195c05b055513100" :db/ensure [:answer-field/validate]} {:db/id "q-131999" :question/id #uuid "41dc19c4-f697-52b3-b9b5-76ded5157f14" :question/math-academy-id "q-131999" :question/problem "The inverse of the matrix $Y$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[Y\\,|\\,I] & =[\\begin{aligned}4 & -1 & 1 & 0 \\\\ -3 & 1 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ -3 & 1 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 3 & 4\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $Y$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $Y$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[Y\\,|\\,I\\,] & =[\\begin{aligned}4 & -1 & 1 & 0 \\\\ -3 & 1 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ -3 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 3 & 4\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{1}:={R}_{1}+{R}_{2},\\,{R}_{2}:={R}_{2}+3{R}_{1}.\n$$\n\nThe matrix ${Y}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{Y}^{-1}=[\\begin{aligned}1 & 1 \\\\ 3 & 4\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131999/ma-source-field/a20dfd96920431886480355a32b315b1a1d103936817bf6d5e18d54780177c46"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b7f42188-bf51-5546-89fb-e33ba47c4b5e"] :knowledge-point/questions ["q-131999"] :db/ensure [:knowledge-point/validate]} {:db/id "q-134085/ma-source-field/410c04f8b1c31fe53eb0a8a4b90b1cfbb7f3980a241fb3afeb3edbba3bb3682f/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3b931d3b-ada2-5b04-a7ba-3e5388b9aa35" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-134085/ma-source-field/410c04f8b1c31fe53eb0a8a4b90b1cfbb7f3980a241fb3afeb3edbba3bb3682f/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c0d3ff95-8a16-5335-b1eb-84d2fbc5830f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-134085/ma-source-field/410c04f8b1c31fe53eb0a8a4b90b1cfbb7f3980a241fb3afeb3edbba3bb3682f/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "cf078eaa-4e8e-529e-aeaf-cf7c18b72b3c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-134085/ma-source-field/410c04f8b1c31fe53eb0a8a4b90b1cfbb7f3980a241fb3afeb3edbba3bb3682f/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-134085/ma-source-field/410c04f8b1c31fe53eb0a8a4b90b1cfbb7f3980a241fb