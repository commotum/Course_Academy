\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {U}^{-1}U & =[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127737/ma-source-field/4b455212074f8a6318f8f9676766203401985ad4af4d22496ec12e4706af70e9"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3"] :knowledge-point/questions ["q-127737"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128499/ma-source-field/1a95d056b5f94964012324f767ff172767bc8df4eb544ab694ecff5b87c0e35e/f713e3c51be20750b1705399d88e20c65c6db6c19140d6bc7085e3e11b48f828" :answer/id #uuid "3fbcf038-f3dc-5a71-b0c2-b0f15532c018" :answer/type :answer.type/math :answer/value "r=⟨1,5,11⟩+s⟨2,4,1⟩+t⟨2,3,-5⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128499/ma-source-field/1a95d056b5f94964012324f767ff172767bc8df4eb544ab694ecff5b87c0e35e/e9f448bb65e82945dc599f862c2a07a6795f6b59531ba3cb1ae52398bec3bf7b" :answer/id #uuid "fd9a749a-2d90-567b-9b9e-9eea1e14d989" :answer/type :answer.type/math :answer/value "r=⟨1,5,13⟩+s⟨-2,4,1⟩+t⟨2,5,-3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128499/ma-source-field/1a95d056b5f94964012324f767ff172767bc8df4eb544ab694ecff5b87c0e35e/df5e315860448f0143299572af17309a9892a83bd2489596fca0983f2aaf502f" :answer/id #uuid "ee62040f-08f9-5abf-8ec9-6681c3d75424" :answer/type :answer.type/math :answer/value "r=⟨1,5,13⟩+s⟨4,-2,1⟩+t⟨3,5,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-128499/ma-source-field/1a95d056b5f94964012324f767ff172767bc8df4eb544ab694ecff5b87c0e35e/2bf6099f6a9973b8307e08f883a440474edbb996ec474204a39fc02ae75563ab" :answer/id #uuid "6c55c069-4c02-5970-a366-2d87c0faefc8" :answer/type :answer.type/math :answer/value "r=⟨1,5,13