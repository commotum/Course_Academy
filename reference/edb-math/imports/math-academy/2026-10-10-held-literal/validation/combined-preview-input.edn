4d69a998c9292437/260670870f47ac0afc1711b86fae2fd29ae9dc8f763b5359a1bc9b6772edc5d9" "q-181636/ma-source-field/aa13cb96d3021811d41b0041e874a15b8a21f84e53f232624d69a998c9292437/183f3836ba22f5fc0c4fbb1d395b6023e02499586e7d3d905b843990e8ff8085" "q-181636/ma-source-field/aa13cb96d3021811d41b0041e874a15b8a21f84e53f232624d69a998c9292437/c8fae187e2b746ae6c3f6e0a10dc409aa0f6ae43350dbfd9ccdab719e632acf0" "q-181636/ma-source-field/aa13cb96d3021811d41b0041e874a15b8a21f84e53f232624d69a998c9292437/352066b6755eed50889389d2cc58100b23f5bfdf1e488ccc63c8adb0295cc189"] :answer-field/correct "q-181636/ma-source-field/aa13cb96d3021811d41b0041e874a15b8a21f84e53f232624d69a998c9292437/183f3836ba22f5fc0c4fbb1d395b6023e02499586e7d3d905b843990e8ff8085" :db/ensure [:answer-field/validate]} {:db/id "q-181636" :question/id #uuid "999b2586-fcdd-5ed0-85a5-01e4b7a4e6e1" :question/math-academy-id "q-181636" :question/problem "Which set is equivalent to $S={4,{2,4},4,2,2,{2}}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n4,\\,{2,4},\\,2,\\,{2}\n$$\n\nTherefore, the only set equivalent to $S$ is ${2,{2},4,{2,4}}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${2,4}$ is missing the elements ${2}$ and ${2,4}.$ Note that ${2}\\ne 2.$\n\n- ${2,{2},{4},{2,4}}$ is missing the element $4.$ Note that $4\\ne {4}.$\n\n- ${{2},{2,4}}$ is missing the elements $2$ and $4.$\n\n- ${2,4,{2,4}}$ is missing the element ${2}.$ Note that ${2}\\ne 2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-181636/ma-source-field/aa13cb96d3021811d41b0041e874a15b8a21f84e53f232624d69a998c9292437"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a"] :knowledge-point/questions ["q-181636"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/5c3fdd61b8458cdcb5ee71c573f7b8db0c7866baaaca5f7660fe58ea192a8439" :answer/id #uuid "971797e1-7cd0-559f-b79c-db991941d744" :answer/type :answer.type/math :answer/value "t=15" :db/ensure [:answer/validate]} {:db/id "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/bddb16fb60275d07c2d2a20d0ff2251caf856d27ab8e69dbd10410685c39553a" :answer/id #uuid "adc48da0-7a45-53ff-8426-6904a74735d6" :answer/type :answer.type/math :answer/value "t=3" :db/ensure [:answer/validate]} {:db/id "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/44855ba0613121a1ddbb17cff307d99cb533fdec60ddec9161b81ae8332a6ab0" :answer/id #uuid "1e2f25be-663b-5e68-9722-12735bca3998" :answer/type :answer.type/math :answer/value "t=5" :db/ensure [:answer/validate]} {:db/id "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/3c5e157e7f6663f1890b2b106ba57efe2f273c47b96853b2504b92d6602e697b" :answer/id #uuid "33850b31-c878-5fea-9b61-e81a78da818e" :answer/type :answer.type/math :answer/value "t=9" :db/ensure [:answer/validate]} {:db/id "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/ba556e7acb517f0757d7e8ff8c635d14d7a8f4df2c8d0cf8e776462b90909863" :answer/id #uuid "4018584b-ff8b-5b49-9e0d-0cd138d9f9ef" :answer/type :answer.type/text :answer/value "No stationary points" :db/ensure [:answer/validate]} {:db/id "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f" :answer-field/id #uuid "77ccd9ba-8bd4-5cef-a96f-0066b2374cc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/5c3fdd61b8458cdcb5ee71c573f7b8db0c7866baaaca5f7660fe58ea192a8439" "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/bddb16fb60275d07c2d2a20d0ff2251caf856d27ab8e69dbd10410685c39553a" "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/44855ba0613121a1ddbb17cff307d99cb533fdec60ddec9161b81ae8332a6ab0" "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/3c5e157e7f6663f1890b2b106ba57efe2f273c47b96853b2504b92d6602e697b" "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/ba556e7acb517f0757d7e8ff8c635d14d7a8f4df2c8d0cf8e776462b90909863"] :answer-field/correct "q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f/bddb16fb60275d07c2d2a20d0ff2251caf856d27ab8e69dbd10410685c39553a" :db/ensure [:answer-field/validate]} {:db/id "q-31633" :question/id #uuid "359dea7b-c28c-5695-9f78-2decd6212dc8" :question/math-academy-id "q-31633" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na=⟨5,3⟩,\\,-\\infty <t<\\infty .\n$$\n\nGiven that the particle has velocity $v=⟨-5,-3⟩$ when $t=2,$ calculate the times at which the particle is stationary." :question/worked-solution "The particle is stationary when its velocity is zero. So first, we need to compute the velocity of the particle.\n\nTo compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨5,3⟩\\,\\text{d}t \\\\  & =⟨\\int 5\\,\\text{d}t,\\int 3\\,\\text{d}t⟩ \\\\  & =⟨5t+{C}_{1},\\,3t+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(2)=⟨-5,-3⟩.$ Substituting $t=2,$ we get\n\n$$\n\\begin{aligned}v(2) & =⟨5(2)+{C}_{1},\\,3(2)+{C}_{2}⟩ \\\\ ⟨-5,-3⟩ & =⟨10+{C}_{1},\\,6+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=-15$ and ${C}_{2}=-9.$ Therefore, the velocity is given by\n\n$$\n\\begin{aligned}v(t) & =⟨5t-15,\\,3t-9⟩.\\end{aligned}\n$$\n\nTo find the times at which the particle is stationary, we solve for the times at which the velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨5t-15,\\,3t-9⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo, we need\n\n$$\n\\begin{aligned}5t-15 & =0\\,⇒\\,t=3, \\\\ 3t-9 & =0\\,⇒\\,t=3.\\end{aligned}\n$$\n\nThe only solution that satisfies both equations is $t=3,$ so this is the only value of $t$ when the particle is stationary." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31633/ma-source-field/e408e63a529421f7965d79123a524bf98ec2c1059c1d2680fe7fbf027609ec3f"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02a9771f-af0a-5af7-94b7-9d6cb6f060d5"] :knowledge-point/questions ["q-31633"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/9448ada8d052c355940fea09219b64af1f94b37363b53fdcc805f8be086814ad" :answer/id #uuid "a826eeba-192e-5ff2-a840-7081a7617cbe" :answer/type :answer.type/math :answer/value "t=-1" :db/ensure [:answer/validate]} {:db/id "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/2a7c1a99e9e23adaa901d3875aa3d18803784074d59c1f3334ed37864b04f786" :answer/id #uuid "556b0b1a-ef70-52c4-a7d0-96bbcbfcc873" :answer/type :answer.type/math :answer/value "t=0" :db/ensure [:answer/validate]} {:db/id "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/24b44fba53578fd75922a19937c1240a9736e2dc7d7ad97ff6285932419cf4ea" :answer/id #uuid "f466dd59-61f4-547d-a107-450511600e57" :answer/type :answer.type/math :answer/value "t=1" :db/ensure [:answer/validate]} {:db/id "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/44855ba0613121a1ddbb17cff307d99cb533fdec60ddec9161b81ae8332a6ab0" :answer/id #uuid "49466a8b-457a-5b0d-9311-1b094e128cd8" :answer/type :answer.type/math :answer/value "t=5" :db/ensure [:answer/validate]} {:db/id "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/ba556e7acb517f0757d7e8ff8c635d14d7a8f4df2c8d0cf8e776462b90909863" :answer/id #uuid "4f1ecf19-e487-59df-a981-9b10a28bf994" :answer/type :answer.type/text :answer/value "No stationary points" :db/ensure [:answer/validate]} {:db/id "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6" :answer-field/id #uuid "2daecc26-2e53-5776-b8fe-ae2b66da8823" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/9448ada8d052c355940fea09219b64af1f94b37363b53fdcc805f8be086814ad" "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/2a7c1a99e9e23adaa901d3875aa3d18803784074d59c1f3334ed37864b04f786" "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/24b44fba53578fd75922a19937c1240a9736e2dc7d7ad97ff6285932419cf4ea" "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/44855ba0613121a1ddbb17cff307d99cb533fdec60ddec9161b81ae8332a6ab0" "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/ba556e7acb517f0757d7e8ff8c635d14d7a8f4df2c8d0cf8e776462b90909863"] :answer-field/correct "q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6/44855ba0613121a1ddbb17cff307d99cb533fdec60ddec9161b81ae8332a6ab0" :db/ensure [:answer-field/validate]} {:db/id "q-31634" :question/id #uuid "d1d2200e-dbc1-5e87-951b-4fac16df86f2" :question/math-academy-id "q-31634" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na=⟨3{t}^{2}-10t,2t-4⟩,\\,-\\infty <t<\\infty .\n$$\n\nGiven that the particle has velocity $v=⟨-18,-8⟩$ when $t=3,$ calculate the times at which the particle is stationary." :question/worked-solution "The particle is stationary when its velocity is zero. So first, we need to compute the velocity of the particle.\n\nTo compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨3{t}^{2}-10t,2t-4⟩\\,\\text{d}t \\\\  & =⟨\\int (3{t}^{2}-10t)\\,\\text{d}t,\\int (2t-4)\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}-5{t}^{2}+{C}_{1},\\,{t}^{2}-4t+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(3)=⟨-18,-8⟩.$ Substituting $t=3,$ we get\n\n$$\n\\begin{aligned}v(3) & =⟨(3)^{3}-5(3)^{2}+{C}_{1},\\,(3)^{2}-4(3)+{C}_{2}⟩ \\\\ ⟨-18,-8⟩ & =⟨-18+{C}_{1},\\,-3+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=-5.$ Therefore, the velocity is given by\n\n$$\n\\begin{aligned}v(t) & =⟨{t}^{3}-5{t}^{2},\\,{t}^{2}-4t-5⟩.\\end{aligned}\n$$\n\nTo find the times at which the particle is stationary, we solve for the times at which the velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨{t}^{3}-5{t}^{2},\\,{t}^{2}-4t-5⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo, we need\n\n$$\n\\begin{aligned}{t}^{3}-5{t}^{2}={t}^{2}(t-5) & =0\\,⇒\\,t=0,5, \\\\ {t}^{2}-4t-5=(t+1)(t-5) & =0\\,⇒\\,t=-1,5.\\end{aligned}\n$$\n\nThe only solution that satisfies both equations is $t=5,$ so this is the only value of $t$ when the particle is stationary." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31634/ma-source-field/009aea7d1fe072b15a6217ea3fa58fb778e76b16ca383a483c788e5d8ba37ae6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "02a9771f-af0a-5af7-94b7-9d6cb6f060d5"] :knowledge-point/questions ["q-31634"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186115737 :question/answer-fields 17592186113358] {:db/id "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/c951c6ac6e107e0fc0d3a45a39f545ca63c39a3f81854148c99e6d1c547f6a54" :answer/id #uuid "d3ba0c9a-7588-50be-bba0-9e1ec3e66758" :answer/type :answer.type/math :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/2662d44179edd5426c3e0e3e6758ff6a07d28ee493128b8e483f0bf68263f810" :answer/id #uuid "fe1a813f-c908-5653-a64d-7211791782ac" :answer/type :answer.type/math :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{2}:={R}_{2}+2{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/10815dece170e0a91a5d2ffc9a1a78f4a161060893529412a2103d42ec3fe3c9" :answer/id #uuid "1452f7af-82c6-55ad-851f-0af4df86350c" :answer/type :answer.type/math :answer/value "{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{2}:={R}_{2}-2{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/6c90d54e8beac901eebb5a18749782e24aff3308e0d0b3d76906174dfe792651" :answer/id #uuid "481208ae-3c57-5f00-939f-d1f24b8106ad" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/fd9cfc76a2121f7b7b42ebb6ad731691aac512930bbc9b8c1fe8def4fb2af3d9" :answer/id #uuid "c0d4923d-606c-58ee-8c6b-a4ff5482ef83" :answer/type :answer.type/math :answer/value "{R}_{2}↔{R}_{2},\\,{R}_{2}:={R}_{2}-\\frac{1}{2}{R}_{1}" :db/ensure [:answer/validate]} {:db/id "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a" :answer-field/id #uuid "d60d7e8d-d42b-5c16-b699-93d0d7f45a76" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/c951c6ac6e107e0fc0d3a45a39f545ca63c39a3f81854148c99e6d1c547f6a54" "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/2662d44179edd5426c3e0e3e6758ff6a07d28ee493128b8e483f0bf68263f810" "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/10815dece170e0a91a5d2ffc9a1a78f4a161060893529412a2103d42ec3fe3c9" "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/6c90d54e8beac901eebb5a18749782e24aff3308e0d0b3d76906174dfe792651" "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/fd9cfc76a2121f7b7b42ebb6ad731691aac512930bbc9b8c1fe8def4fb2af3d9"] :answer-field/correct "q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a/c951c6ac6e107e0fc0d3a45a39f545ca63c39a3f81854148c99e6d1c547f6a54" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "5202eb69-24ce-5ca6-bebd-52036979fd02"] :question/problem "The inverse of the matrix $A$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 2 & 0 & 1\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}] &  & \\text{___________} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "We write down $A$ and the identity matrix $I$ side-by-side (as shown below) and apply the standard Gauss-Jordan method to transform the matrix $A$ into the identity matrix. We perform the same row operations on both matrices:\n\n$$\n\\begin{aligned}[A\\,|\\,I] & =[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 2 & 0 & 1\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}] & {R}_{1} & :={R}_{1}+2{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{aligned}]\\end{aligned}\n$$\n\nThe corresponding row operations are\n\n$$\n{R}_{2}:=\\frac{1}{2}{R}_{2},\\,{R}_{1}:={R}_{1}+2{R}_{2}.\n$$\n\nThe matrix ${A}^{-1}$ is given by the right-hand side of our big matrix after all of the transformations have been completed. Therefore, \n\n$$\n{A}^{-1}=[\\begin{aligned}1 & 1 \\\\ 0 & \\frac{1}{2}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31862/ma-source-field/d95edf8f0ab2fb1ee925eb2c5568575cc9f1c1d1d7c993e0bab3d7f4f656b13a"] :db/ensure [:question/validate]} {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/17744788330f58841addf62dc48c17a05e2f80fa6fdc64b1079a2792d0799996" :answer/id #uuid "a7c8774e-9109-5016-afc5-bf50bfde4b21" :answer/type :answer.type/math :answer/value "det[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]=0" :db/ensure [:answer/validate]} {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/97217f148d283b2a801b997676ec5e3fb6645b795768229d725ef4661661acbe" :answer/id #uuid "e5c547a0-c335-58ec-ab07-57aced1b8ae4" :answer/type :answer.type/math :answer/value "det[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]\\ne 0" :db/ensure [:answer/validate]} {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/cd52cf227650f39a8c6263ff2c716eaad063c335a52efa09f7d551199797d4f1" :answer/id #uuid "dc5a5fd6-f1c0-5816-bbff-d97051dd254d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ -3\\end{aligned}]$ has exactly one solution" :db/ensure [:answer/validate]} {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/577cb9c5dab6da3808833c53d87670e53309521ee74e4a5d2a38217f53e1fe66" :answer/id #uuid "6da42ba2-60ea-55ee-a8cc-e05327ecf3a1" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is the unique solution of $[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]x=0$" :db/ensure [:answer/validate]} {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/d30e858d75a10955b00db25dc9355af51eb20ee0e80bca7870da7cbac118565e" :answer/id #uuid "404e1d93-c357-5c09-b96b-df966f10e2b3" :answer/type :answer.type/text :answer/value "${[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]}^{-1}$ is invertible" :db/ensure [:answer/validate]} {:db/id "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07" :answer-field/id #uuid "a491e86e-1311-5936-86d4-f5c880062fc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/17744788330f58841addf62dc48c17a05e2f80fa6fdc64b1079a2792d0799996" "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/97217f148d283b2a801b997676ec5e3fb6645b795768229d725ef4661661acbe" "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/cd52cf227650f39a8c6263ff2c716eaad063c335a52efa09f7d551199797d4f1" "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/577cb9c5dab6da3808833c53d87670e53309521ee74e4a5d2a38217f53e1fe66" "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/d30e858d75a10955b00db25dc9355af51eb20ee0e80bca7870da7cbac118565e"] :answer-field/correct "q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07/17744788330f58841addf62dc48c17a05e2f80fa6fdc64b1079a2792d0799996" :db/ensure [:answer-field/validate]} {:db/id "q-32092" :question/id #uuid "d83ee387-80b0-5c7f-bd0c-361b0164d684" :question/math-academy-id "q-32092" :question/problem "Consider the lines $y-5x=-1$ and $kx-y=-3$, where $k$ is a constant. Complete the following statement so that it is true:\n\n*If the lines don't intersect, then $\\text{__________}\\,.$*" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nAccording to the invertible matrix theorem, if the lines $y-5x=-1$ and $kx-y=-3$ intersect exactly at one point, then the matrix\n\n$$\nA=[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]\n$$\n\nis invertible and $det(A)\\ne 0.$ \nAdditionally, the unique solution to $Ax=0$ is $⟨0,0⟩$ and\n\n$$\n[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}{b}_{1} \\\\ {b}_{2}\\end{aligned}]\n$$\n\nhas exactly one solution  for any $2\\times 1$ column vector $b.$  \n\nTherefore, the true statement is as follows:\n\n *If the lines **don't** intersect, then $det[\\begin{aligned}-5 & 1 \\\\ k & -1\\end{aligned}]=0.$*" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-32092/ma-source-field/ec7c730b5d3b1533a4c2473dddd07415e6241faa7f88a32cfbd1eb27e3236a07"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04"] :knowledge-point/questions ["q-32092"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186167172 :question/answer-fields 17592186164039] {:db/id "q-324062/ma-source-field/197f61a1119f21afc9f0440b5e826b68d13861c047935bea4cfb18cdef4172f7/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "90eec9dd-510c-502d-8e