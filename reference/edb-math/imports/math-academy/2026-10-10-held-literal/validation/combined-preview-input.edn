8b4496d4875b0b2f074" "q-180821/ma-source-field/1e615f886be468ac7799fcd262bcb37a57707317cf2cb1d8af6433931bacc702/d8ed6349ed5ab2fb089a180020d2393d3532d02972b643dff483641c73ccebd1"] :answer-field/correct "q-180821/ma-source-field/1e615f886be468ac7799fcd262bcb37a57707317cf2cb1d8af6433931bacc702/8b08b66cad4c4bcf10afb72ea316eb6c449ec6fe003f4e303c1e25cf574cdc97" :db/ensure [:answer-field/validate]} {:db/id "q-180821" :question/id #uuid "26d0ae9a-cd8a-5695-b354-4253c50dee18" :question/math-academy-id "q-180821" :question/problem "Which set is equivalent to $S={0,{1},{0},1,0,{0}}?$" :question/worked-solution "Two sets are equivalent if they contain the same elements. It doesn't matter if the elements are listed differently or if one set has duplicates and the other does not.\n\nTo determine which of the given sets is equivalent to $S,$ we start by listing the elements of $S,$ ignoring any duplicates:\n\n$$\n0,\\,{1},\\,{0},\\,1\n$$\n\nTherefore, the only set equivalent to $S$ is ${0,1,{0},{1}}$ since it contains the same elements as $S.$\n\nThe other sets are not equivalent to $S:$\n\n- ${0,1,{1}}$ is missing the element ${0}$ (note that ${0}\\ne 0$).\n\n- ${{0},0,1}$ is missing the element ${1}$ (note that ${1}\\ne 1$).\n\n- ${0,1,{0,1},{0},{1}}$ has the element ${0,1}$ that is not in $S.$\n\n- ${0,1,{1},2,{0}}$ has the element $2$ that is not in $S.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-180821/ma-source-field/1e615f886be468ac7799fcd262bcb37a57707317cf2cb1d8af6433931bacc702"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d478c5a-3a9e-5219-8111-2cfc828a609a"] :knowledge-point/questions ["q-180821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-181611/ma-source-field/1ff8632c90fb342b0bcb6816d9fbf55dcefd2da0a6720e1d5d277de68231105c/a5305dbd06284b92c30a7b294d681cc9a5cf75694523dfd09d839a69594c9fb0" :answer/id #uuid "d01f46ed-8703-5a3d-b4d3-61f5a32b8bbd" :answer/type :answer.type/math :answer/value "{a,b,c,d}" :d