1e3f29c300a/e34c082c765062d3675d7288e6e42869d1a0be320564152f8d050c85fcdcc2dd" "q-160559/ma-source-field/abfcf50969203d91f97aa0a14ae197a17ac067d8aa968a631464a1e3f29c300a/846df385986ecd89ffcf1c04d1cb44f6fa18b34ef014428437ad80af48635d31" "q-160559/ma-source-field/abfcf50969203d91f97aa0a14ae197a17ac067d8aa968a631464a1e3f29c300a/1d2279bb1d03766e93881d6c42634292439d232d1a13f2bbe53d9e90b0a0494b" "q-160559/ma-source-field/abfcf50969203d91f97aa0a14ae197a17ac067d8aa968a631464a1e3f29c300a/89827b0fe1255206cbd885a9a5b12c2019f6417adf1f67a653ea45c90e3ba69b"] :answer-field/correct "q-160559/ma-source-field/abfcf50969203d91f97aa0a14ae197a17ac067d8aa968a631464a1e3f29c300a/1d2279bb1d03766e93881d6c42634292439d232d1a13f2bbe53d9e90b0a0494b" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "f0c60c12-3acb-5c5a-8aba-c02d0db96c2a"] :question/problem "Consider the finite region $D$ enclosed in the first quadrant of the $xy$-plane between the curves\n\n$$\ny=x,\\,y=3x,\\,y=\\frac{1}{x},\\,y=\\frac{5}{x}.\n$$\n\nA transformation $T,$ where\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nmaps a rectangular region $Δ$ with sides parallel to the $u$- and $v$-axes from the $uv$-plane onto $D$ in the $xy$-plane. Given that\n\n$$\nT:(u,v)\\to (\\sqrt{\\frac{v}{u}},\\,\\,),\n$$\n\nwhat could be the missing expression?" :question/worked-solution "We would like to find a rectangular region of the form\n\n$$\n\\begin{aligned}Δ & ={(u,v)\\,:\\,a\\le u\\le b,\\,\\,c\\le v\\le d} \\\\  & ={(u,v)\\,:\\,a\\le u(x,y)\\le b,\\,\\,c\\le v(x,y)\\le d},\\end{aligned}\n$$\n\nwhere the equations of the left, right, bottom, and top sides are\n\n$$\nu(x,y)=a,\\,u(x,y)=b,\\,v(x,y)=c,\\,v(x,y)=d.\n$$\n\nWith that in mind, let's analyze the boundary of our region $D.$ \n\nRewriting the equations \n\n$$\ny=x,\\,y=3x,\\,y=\\frac{1}{x},\\,y=\\frac{5}{x}\n$$\n\nby moving both variables $x$ and $y$ to the left-hand side, we obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}=1,\\,\\frac{y}{x}=3,\\,xy=1,\\,xy=5.\\end{aligned}\n$$\n\nTherefore, if we put $u(x,y)=\\frac{y}{x}$ and $v(x,y)=xy,$ we can define the transformation ${T}^{-1}$ as\n\n$$\n{T}^{-1}:(x,y)\\to (\\,\\frac{y}{x}\\,,\\,xy).\n$$\n\nTo find $T,$ we should express $x$ and $y$ in terms of $u$ and $v.$ Recall that we have\n\n$$\n{\\begin{aligned}u=\\frac{y}{x} \\\\ v=xy.\\end{aligned}\n$$\n\nFrom the first equation, $y=ux.$ Substituting this into the second equation, we get \n\n$$\nv=u{x}^{2}\\,⟹\\,{x}^{2}=\\frac{v}{u}\\,⟹\\,x=\\sqrt{\\frac{v}{u}}.\n$$\n\nFinally, substituting $x=\\sqrt{\\frac{v}{u}}$ back into $y=ux,$ we obtain\n\n$$\ny=u\\sqrt{\\frac{v}{u}}=\\sqrt{uv}.\n$$\n\nTherefore, the transformation $T$ can be given by\n\n$$\nT:(u,v)\\to (\\sqrt{\\frac{v}{u}},\\,\\sqrt{uv}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160559/ma-source-field/abfcf50969203d91f97aa0a14ae197a17ac067d8aa968a631464a1e3f29c300a"] :db/ensure [:question/validate]} {:db/id "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/821dd8ed7daef7398474de64a02ed06acb0ff0876b3c43c33c7514bed5d0390b" :answer/id #uuid "ee730d87-2f06-5106-8cf9-62838e1fb416" :answer/type :answer.type/math :answer/value "\\frac{u}{v}" :db/ensure [:answer/validate]} {:db/id "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/628ce67488c1409828dd68ac0270d9a964bc03018b0663c2af65f2ad092760a1" :answer/id #uuid "b6492003-1c71-5f35-931d-cbf5fe819f15" :answer/type :answer.type/math :answer/value "\\frac{v}{u}" :db/ensure [:answer/validate]} {:db/id "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/846df385986ecd89ffcf1c04d1cb44f6fa18b34ef014428437ad80af48635d31" :answer/id #uuid "74974743-e247-56a3-b446-988e3a2779de" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{v}{u}}" :db/ensure [:answer/validate]} {:db/id "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/6f90d1d1d67d59368a2daea8e4e7c86d4e84eae5963dd53759dd92c5283187bf" :answer/id #uuid "f8c90f3c-320e-52bd-b987-c216a3f4625d" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{v}{{u}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/189c768f44ab7aa866abd1b7ebb5ab93712265b7dc1fa61cf8d9ee7cd70248d8" :answer/id #uuid "2522b823-b6ab-5931-a981-d1897549cad3" :answer/type :answer.type/math :answer/value "\\sqrt{\\frac{{v}^{2}}{u}}" :db/ensure [:answer/validate]} {:db/id "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b" :answer-field/id #uuid "a2f44abc-ac48-5c5f-840d-7b78fa1a5463" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/821dd8ed7daef7398474de64a02ed06acb0ff0876b3c43c33c7514bed5d0390b" "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/628ce67488c1409828dd68ac0270d9a964bc03018b0663c2af65f2ad092760a1" "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/846df385986ecd89ffcf1c04d1cb44f6fa18b34ef014428437ad80af48635d31" "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/6f90d1d1d67d59368a2daea8e4e7c86d4e84eae5963dd53759dd92c5283187bf" "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/189c768f44ab7aa866abd1b7ebb5ab93712265b7dc1fa61cf8d9ee7cd70248d8"] :answer-field/correct "q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b/846df385986ecd89ffcf1c04d1cb44f6fa18b34ef014428437ad80af48635d31" :db/ensure [:answer-field/validate]} {:db/id "q-161086" :question/id #uuid "e82a0cbf-06e5-5031-a4c7-160ebc24fbd2" :question/math-academy-id "q-161086" :question/problem "Consider the finite region $D$ enclosed in the first quadrant of the $xy$-plane between the curves\n\n$$\ny=2x,\\,y=5x,\\,y=\\frac{3}{x},\\,y=\\frac{4}{x}.\n$$\n\nA transformation $T,$ where\n\n$$\nT:(u,v)\\to (x(u,v),y(u,v)),\n$$\n\nmaps a rectangular region $Δ$ with sides parallel to the $u$- and $v$-axes from the $uv$-plane onto $D$ in the $xy$-plane. Given that\n\n$$\nT:(u,v)\\to (\\,\\,,\\,\\,\\sqrt{uv}),\n$$\n\nwhat could be the missing expression?" :question/worked-solution "We would like to find a rectangular region of the form\n\n$$\n\\begin{aligned}Δ & ={(u,v)\\,:\\,a\\le u\\le b,\\,\\,c\\le v\\le d} \\\\  & ={(u,v)\\,:\\,a\\le u(x,y)\\le b,\\,\\,c\\le v(x,y)\\le d},\\end{aligned}\n$$\n\nwhere the equations of the left, right, bottom, and top sides are\n\n$$\nu(x,y)=a,\\,u(x,y)=b,\\,v(x,y)=c,\\,v(x,y)=d.\n$$\n\nWith that in mind, let's analyze the boundary of our region $D.$ \n\nRewriting the equations \n\n$$\ny=2x,\\,y=5x,\\,y=\\frac{3}{x},\\,y=\\frac{4}{x}\n$$\n\nby moving both variables $x$ and $y$ to the left-hand side, we obtain\n\n$$\n\\begin{aligned}\\frac{y}{x}=2,\\,\\frac{y}{x}=5,\\,xy=3,\\,xy=4.\\end{aligned}\n$$\n\nTherefore, if we put $u(x,y)=\\frac{y}{x}$ and $v(x,y)=xy,$ we can define the transformation ${T}^{-1}$ as\n\n$$\n{T}^{-1}:(x,y)\\to (\\,\\frac{y}{x}\\,,\\,xy).\n$$\n\nTo find $T,$ we should express $x$ and $y$ in terms of $u$ and $v.$ Recall that we have\n\n$$\n{\\begin{aligned}u=\\frac{y}{x} \\\\ v=xy.\\end{aligned}\n$$\n\nFrom the first equation, $y=ux.$ Substituting this into the second equation, we get \n\n$$\nv=u{x}^{2}\\,⟹\\,{x}^{2}=\\frac{v}{u}\\,⟹\\,x=\\sqrt{\\frac{v}{u}}.\n$$\n\nFinally, substituting $x=\\sqrt{\\frac{v}{u}}$ back into $y=ux,$ we obtain\n\n$$\ny=u\\sqrt{\\frac{v}{u}}=\\sqrt{uv}.\n$$\n\nTherefore, the transformation $T$ can be given by\n\n$$\nT:(u,v)\\to (\\,\\sqrt{\\frac{v}{u}},\\,\\sqrt{uv}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161086/ma-source-field/7d16f54998fd1be8a76bd1219650d8760bc74d45494e30dda60685bb3da5438b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de3fa2fa-304c-583a-8c73-a5ff1db972e2"] :knowledge-point/questions ["q-161086"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/b0ad8c6d527eb7879c4db50f366aaa11ab38bf63a6600430da769cb6f7e2bfe8" :answer/id #uuid "c1b5545b-f437-5265-821f-6ea217aea603" :answer/type :answer.type/math :answer/value "-3{u}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/a564df14b9f3fd4776b074f9ffb8a0d598600f9ea76de4e05ad223355200e9cb" :answer/id #uuid "06d6268a-1fe9-5430-934f-527eb0153af9" :answer/type :answer.type/math :answer/value "-5{u}^{3}" :db/ensure [:answer/validate]} {:db/id "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/7c09c2380253f3967cc094968b27fb927489ccbbecd250a4ae799721371f3b6d" :answer/id #uuid "2e773ddf-4b3c-5bc1-b538-c1702b36529f" :answer/type :answer.type/math :answer/value "2{u}^{2}\\operatorname{sin}⁡v\\operatorname{cos}⁡v" :db/ensure [:answer/validate]} {:db/id "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/07f604a1a5724ff73ed3947f1895e0cd15f32c1031456f0e01983df159dad57c" :answer/id #uuid "4d89472a-c8a6-58ee-ad06-702bb85242bc" :answer/type :answer.type/math :answer/value "6{u}^{3}" :db/ensure [:answer/validate]} {:db/id "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/62a3fa3bcf27f412ebd28dc07ab53529ee00902b164351c9b1c9c7098a3db42a" :answer/id #uuid "6ceed292-fdb3-5c81-a5ef-e21d4577bafc" :answer/type :answer.type/math :answer/value "{u}^{3}\\operatorname{sin}⁡v\\operatorname{cos}⁡v" :db/ensure [:answer/validate]} {:db/id "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b" :answer-field/id #uuid "f48bed04-e645-581d-90b2-d43b8caed324" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/b0ad8c6d527eb7879c4db50f366aaa11ab38bf63a6600430da769cb6f7e2bfe8" "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/a564df14b9f3fd4776b074f9ffb8a0d598600f9ea76de4e05ad223355200e9cb" "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/7c09c2380253f3967cc094968b27fb927489ccbbecd250a4ae799721371f3b6d" "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/07f604a1a5724ff73ed3947f1895e0cd15f32c1031456f0e01983df159dad57c" "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/62a3fa3bcf27f412ebd28dc07ab53529ee00902b164351c9b1c9c7098a3db42a"] :answer-field/correct "q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b/a564df14b9f3fd4776b074f9ffb8a0d598600f9ea76de4e05ad223355200e9cb" :db/ensure [:answer-field/validate]} {:db/id "q-161251" :question/id #uuid "50f21d4c-115f-5f6b-a6fe-50fa77f7169e" :question/math-academy-id "q-161251" :question/problem "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨3x,\\,3y,\\,z⟩,\\,r(u,v)=⟨u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v,\\,{u}^{2}⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨-2{u}^{2}\\operatorname{cos}⁡v,\\,-2{u}^{2}\\operatorname{sin}⁡v,\\,u⟩.$*" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨-2{u}^{2}\\operatorname{cos}⁡v,\\,-2{u}^{2}\\operatorname{sin}⁡v,\\,u⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨3x,\\,3y,\\,z⟩{|}_{x=u\\operatorname{cos}⁡v\\,y=u\\operatorname{sin}⁡v\\,z={u}^{2}} \\\\  & =⟨3u\\operatorname{cos}⁡v,\\,3u\\operatorname{sin}⁡v,\\,{u}^{2}⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨3u\\operatorname{cos}⁡v,\\,3u\\operatorname{sin}⁡v,\\,{u}^{2}⟩\\cdot ⟨-2{u}^{2}\\operatorname{cos}⁡v,\\,-2{u}^{2}\\operatorname{sin}⁡v,\\,u⟩ \\\\  & =3u\\operatorname{cos}⁡v\\cdot (-2{u}^{2}\\operatorname{cos}⁡v)+3u\\operatorname{sin}⁡v\\cdot (-2{u}^{2}\\operatorname{sin}⁡v)+{u}^{2}\\cdot u \\\\  & =-6{u}^{3}({cos}^{2}⁡v+{sin}^{2}⁡v)+{u}^{3} \\\\  & =-5{u}^{3}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,-5{u}^{3}\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161251/ma-source-field/21fe55bd1569f729ff52cd789e789549880c9776ddb270c955940ce15a6c320b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e9b46ce4-cfe0-5da6-bc91-65ae8c544393"] :knowledge-point/questions ["q-161251"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/3483a8b73bef95f967c3ea109c98bfe9d90a6bbf466824ffab52b308a887400a" :answer/id #uuid "82fdd23c-cc42-585e-88f4-5b182b40e621" :answer/type :answer.type/math :answer/value "-2u+v" :db/ensure [:answer/validate]} {:db/id "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/95e55e09c8fd088b369b94477d725ae2e75cac1e692891f1ba56c531a79712c4" :answer/id #uuid "e4493f5f-d9a0-53f7-a4c1-2310218fdc19" :answer/type :answer.type/math :answer/value "11uv" :db/ensure [:answer/validate]} {:db/id "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/6e59713f6b879702b491b97312323568e2b8ba7e2b05cbe3c2cdd120cb8436fd" :answer/id #uuid "23aa505d-ac0a-5049-b866-d1c5cc38bc93" :answer/type :answer.type/math :answer/value "3uv" :db/ensure [:answer/validate]} {:db/id "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/e1ba13e972f703b9c92836ec51aa344b6aa57627d23a0d26323d3f3acbe15d3e" :answer/id #uuid "8b17b653-bdb9-591a-a066-41676556f6e8" :answer/type :answer.type/math :answer/value "5u-6v" :db/ensure [:answer/validate]} {:db/id "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/b457ef847266cf0f37ae72a63d53032673dd9a313030dd351d996287f2cfe925" :answer/id #uuid "8e689bac-8fa3-596f-82fa-c4985e2215d2" :answer/type :answer.type/math :answer/value "u+v" :db/ensure [:answer/validate]} {:db/id "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30" :answer-field/id #uuid "d15555d0-ef8f-523d-8686-3e2c75b76cda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/3483a8b73bef95f967c3ea109c98bfe9d90a6bbf466824ffab52b308a887400a" "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/95e55e09c8fd088b369b94477d725ae2e75cac1e692891f1ba56c531a79712c4" "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/6e59713f6b879702b491b97312323568e2b8ba7e2b05cbe3c2cdd120cb8436fd" "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/e1ba13e972f703b9c92836ec51aa344b6aa57627d23a0d26323d3f3acbe15d3e" "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/b457ef847266cf0f37ae72a63d53032673dd9a313030dd351d996287f2cfe925"] :answer-field/correct "q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30/e1ba13e972f703b9c92836ec51aa344b6aa57627d23a0d26323d3f3acbe15d3e" :db/ensure [:answer-field/validate]} {:db/id "q-161357" :question/id #uuid "eec4b66c-4af6-5b13-942b-337cb7b8732a" :question/math-academy-id "q-161357" :question/problem "Consider the vector field $F(x,y,z)=⟨x+y,\\,2x-y,\\,x+z⟩$ and the surface $S$ defined by $z=2x-2y$ for $0\\le x\\le 2$ and $-1\\le y\\le 2.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{0}^{2}{\\int }_{-1}^{2}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,2u-2v⟩\n$$\n\nover the domain \n\n$$\nD={(u,v)\\,:\\,0\\le u\\le 2,\\,-1\\le v\\le 2}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(2u-2v)⟩ \\\\  & =⟨1,\\,0,\\,2⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(2u-2v)⟩ \\\\  & =⟨0,\\,1,\\,-2⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 2 \\\\ 0 & 1 & -2\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 2 \\\\ 1 & -2\\end{aligned}|,\\,-|\\begin{aligned}1 & 2 \\\\ 0 & -2\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-2,\\,2,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨x+y,\\,2x-y,\\,x+z⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=2u-2v} \\\\  & =⟨u+v,\\,2u-v,\\,u+(2u-2v)⟩ \\\\  & =⟨u+v,\\,2u-v,\\,3u-2v⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨u+v,\\,2u-v,\\,3u-2v⟩\\cdot ⟨-2,\\,2,\\,1⟩ \\\\  & =(u+v)\\cdot (-2)+(2u-v)\\cdot (2)+(3u-2v)\\cdot 1 \\\\  & =-2u-2v+4u-2v+3u-2v \\\\  & =5u-6v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨x+y,\\,2x-y,\\,x+z⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(5u-6v)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{2}(5u-6v)\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161357/ma-source-field/6f461694d6b705fbc23495e3cc068406619cc995ee475d84809ae4b132803e30"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a3486150-b3c2-5faf-99d5-b42ced350996"] :knowledge-point/questions ["q-161357"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/c3d20475246818166b7bd614ae7dc243ccd19389acb8115a1367398a47870d0d" :answer/id #uuid "7b2e8a80-65c9-5d70-9b0e-0e801e7e718d" :answer/type :answer.type/math :answer/value "(u+v)^{2}" :db/ensure [:answer/validate]} {:db/id "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/da772ca5bbe7da853d2e6a3756f6ee2df1b44d18f238029ee5ac1fbea666e3c2" :answer/id #uuid "9f182d4d-0129-52ff-90b2-56e5acb487b3" :answer/type :answer.type/math :answer/value "(u-v)^{2}" :db/ensure [:answer/validate]} {:db/id "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/eaae3272142bda04bf332ba57a7cee56c8de50819ed615ab69dfe74979a7eb07" :answer/id #uuid "c1e4fd3a-37bb-5bcd-85c6-185c9a1d61c2" :answer/type :answer.type/math :answer/value "{u}^{2}+uv-{v}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/7159a960144a256245bf8387c88bea2e4b5e1b1ff6bb2a0b76dd9d85aee7518b" :answer/id #uuid "c8c22e69-9068-5d72-8593-ce78861036f9" :answer/type :answer.type/math :answer/value "{u}^{2}-uv+{v}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/c193e136e97cc4b0206137d7bc339daf600e96eec10a71c0cea8f06e3982d36b" :answer/id #uuid "2f4db3f6-9c97-526b-8cb2-065c8f5de466" :answer/type :answer.type/math :answer/value "{u}^{2}-{v}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b" :answer-field/id #uuid "396da9a4-de3b-5bd7-8b5e-dfc780e10bb9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/c3d20475246818166b7bd614ae7dc243ccd19389acb8115a1367398a47870d0d" "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/da772ca5bbe7da853d2e6a3756f6ee2df1b44d18f238029ee5ac1fbea666e3c2" "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/eaae3272142bda04bf332ba57a7cee56c8de50819ed615ab69dfe74979a7eb07" "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/7159a960144a256245bf8387c88bea2e4b5e1b1ff6bb2a0b76dd9d85aee7518b" "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/c193e136e97cc4b0206137d7bc339daf600e96eec10a71c0cea8f06e3982d36b"] :answer-field/correct "q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b/7159a960144a256245bf8387c88bea2e4b5e1b1ff6bb2a0b76dd9d85aee7518b" :db/ensure [:answer-field/validate]} {:db/id "q-161359" :question/id #uuid "d5e1155b-c484-5f31-a815-946d2d63d6df" :question/math-academy-id "q-161359" :question/problem "Consider the vector field $F(x,y,z)=⟨zy,\\,xz,\\,xy⟩$ and the surface $S$ defined by $z=x-y$ for $-1\\le x\\le 1$ and $0\\le y\\le 1.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{-1}^{1}{\\int }_{0}^{1}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,u-v⟩\n$$\n\nover the domain \n\n$$\nD={(u,v)\\,:\\,-1\\le u\\le 1,\\,0\\le v\\le 1}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(u-v)⟩ \\\\  & =⟨1,\\,0,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(u-v)⟩ \\\\  & =⟨0,\\,1,\\,-1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 0 & 1 & -1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 1 \\\\ 1 & -1\\end{aligned}|,\\,-|\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-1,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨zy,\\,xz,\\,xy⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=u-v} \\\\  & =⟨(u-v)v,\\,(u-v)u,\\,uv⟩\\end{aligned}\n$$\n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨(u-v)v,\\,(u-v)u,\\,uv⟩\\cdot ⟨-1,\\,1,\\,1⟩ \\\\  & =(u-v)v\\cdot (-1)+(u-v)u\\cdot (1)+uv\\cdot 1 \\\\  & =-uv+{v}^{2}+{u}^{2}-uv+uv \\\\  & ={u}^{2}-uv+{v}^{2}.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨zy,\\,xz,\\,xy⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}({u}^{2}-uv+{v}^{2})\\,\\text{d}A \\\\  & ={\\int }_{-1}^{1}{\\int }_{0}^{1}({u}^{2}-uv+{v}^{2})\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161359/ma-source-field/3240769f6bcec23f0fa71cbdd81880d8b0a9f9e80471eeaf348972ebc0b09b7b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a3486150-b3c2-5faf-99d5-b42ced350996"] :knowledge-point/questions ["q-161359"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186198616 :question/answer-fields 17592186194297] {:db/id "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/d4dfee1d713efc201fde7860abe8dac58b5127f931b3cd399af5c017fa4e63f1" :answer/id #uuid "3a53a3c7-e2f5-50e9-afd4-d3b986017cf4" :answer/type :answer.type/math :answer/value "2(u+v)^{2}" :db/ensure [:answer/validate]} {:db/id "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/b1c1b65814368dff35eac0b0e5912f2bd18c24d566e52278d206a5d2bbab9fbd" :answer/id #uuid "e85142cb-e059-512c-8b7b-18eee7a8c253" :answer/type :answer.type/math :answer/value "2uv" :db/ensure [:answer/validate]} {:db/id "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/aef05162c6e1334d7c7f14de08c6a85222303b11d7c1c4fa480d78bd14c1a549" :answer/id #uuid "d28df103-ae23-5647-a506-1bc60c332868" :answer/type :answer.type/math :answer/value "{u}^{2}+uv+{v}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/6298f8f959e14dd05a6923c80ed5003a42cb2ad6f758f2894c7767847a920c56" :answer/id #uuid "f754a120-8886-56d3-b535-398f13b91c9f" :answer/type :answer.type/math :answer/value "{u}^{2}+{v}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/c193e136e97cc4b0206137d7bc339daf600e96eec10a71c0cea8f06e3982d36b" :answer/id #uuid "e433762d-59a0-5efb-bef2-7687d8583f2a" :answer/type :answer.type/math :answer/value "{u}^{2}-{v}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf" :answer-field/id #uuid "185487e5-090f-5815-93b2-dfc0c983e691" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/d4dfee1d713efc201fde7860abe8dac58b5127f931b3cd399af5c017fa4e63f1" "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/b1c1b65814368dff35eac0b0e5912f2bd18c24d566e52278d206a5d2bbab9fbd" "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/aef05162c6e1334d7c7f14de08c6a85222303b11d7c1c4fa480d78bd14c1a549" "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/6298f8f959e14dd05a6923c80ed5003a42cb2ad6f758f2894c7767847a920c56" "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/c193e136e97cc4b0206137d7bc339daf600e96eec10a71c0cea8f06e3982d36b"] :answer-field/correct "q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf/b1c1b65814368dff35eac0b0e5912f2bd18c24d566e52278d206a5d2bbab9fbd" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "a3bcb9d3-050c-5ab9-bd2a-436465223147"] :question/problem "Consider the vector field $F(x,y,z)=⟨{x}^{2},\\,{y}^{2},\\,{z}^{2}⟩$ and the surface $S$ defined by $z=x+y$ for $0\\le x\\le 2$ and $0\\le y\\le 2.$ Using the parametrization $x=u$ and $y=v,$ the flux of $F$ through $S$ can be expressed as\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={\\int }_{0}^{2}{\\int }_{0}^{2}\\boxed{}\\,\\text{d}v\\,\\text{d}u.\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nUsing the parametrization, where $x=u$ and $y=v,$ our surface can be parameterized as\n\n$$\nr(u,v)=⟨u,\\,v,\\,u+v⟩\n$$\n\nover the domain \n\n$$\nD={(u,v)\\,:\\,0\\le u\\le 2,\\,0\\le v\\le 2}.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u),\\,\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(u+v)⟩ \\\\  & =⟨1,\\,0,\\,1⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u),\\,\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(u+v)⟩ \\\\  & =⟨0,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 1 \\\\ 0 & 1 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 1 \\\\ 1 & 1\\end{aligned}|,\\,-|\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}|⟩ \\\\  & =⟨-1,\\,-1,\\,1⟩.\\end{aligned}\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨{x}^{2},\\,{y}^{2},\\,{z}^{2}⟩{|}_{x=u,\\,\\,y=v,\\,\\,z=u+v} \\\\  & =⟨{u}^{2},\\,{v}^{2},\\,(u+v)^{2}⟩\\end{aligned}\n$$\n\n \n\nThen, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨{u}^{2},\\,{v}^{2},\\,(u+v)^{2}⟩\\cdot ⟨-1,\\,-1,\\,1⟩ \\\\  & ={u}^{2}\\cdot (-1)+{v}^{2}\\cdot (-1)+(u+v)^{2}\\cdot 1 \\\\  & =-{u}^{2}-{v}^{2}+{u}^{2}+2uv+{v}^{2} \\\\  & =2uv.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}⟨{x}^{2},\\,{y}^{2},\\,{z}^{2}⟩\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}(2uv)\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}2uv\\,\\text{d}v\\,\\text{d}u.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161360/ma-source-field/cbd4105f4110afffd848078685078793a1c61f8c4750ad85df2ef1865308a1cf"] :db/ensure [:question/validate]} {:db/id "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/c67612d47b4a9e14df4ce0f9c736c7e5452f54dcce89c72daef3abaccc57bba6" :answer/id #uuid "3330207b-8637-52ec-b488-bd1a488b22dc" :answer/type :answer.type/math :answer/value "u{v}^{2}+uv+2{u}^{2}v" :db/ensure [:answer/validate]} {:db/id "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/cfe7e9489b11e9b73d03c3715947077cd6e9f0f537abcae3bccec2e9713f4c16" :answer/id #uuid "915a87fb-c1cd-571b-be39-7c31f1761641" :answer/type :answer.type/math :answer/value "u{v}^{2}-uv+{u}^{2}v" :db/ensure [:answer/validate]} {:db/id "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/2c1734e9eaaeec066457a846b8192ecad6a9d6ac3b48db00f4e19c019329322d" :answer/id #uuid "0823e1c6-a66c-59c3-bb60-2b11710017b1" :answer/type :answer.type/math :answer/value "u{v}^{2}-{u}^{2}v" :db/ensure [:answer/validate]} {:db/id "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/1dd7ff8d7081e4c044b078c9361a6c81cc102e1d000e95f44250d0f7d18dd1a4" :answer/id #uuid "9f13cf51-1f17-54c3-b3d0-3a4ed9f6cc76" :answer/type :answer.type/math :answer/value "{u}^{2}v" :db/ensure [:answer/validate]} {:db/id "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/768c2ce8fe765e029abeda1a3dc01fdb8bd2d51720334e9ce1a3acb6be2f2118" :answer/id #uuid "7a803047-69b8-53fa-8d05-7893832957a3" :answer/type :answer.type/math :answer/value "{u}^{2}{v}^{2}-2uv" :db/ensure [:answer/validate]} {:db/id "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a" :answer-field/id #uuid "af2f16f5-115b-5596-b71d-8a4dab14117a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/c67612d47b4a9e14df4ce0f9c736c7e5452f54dcce89c72daef3abaccc57bba6" "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/cfe7e9489b11e9b73d03c3715947077cd6e9f0f537abcae3bccec2e9713f4c16" "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/2c1734e9eaaeec066457a846b8192ecad6a9d6ac3b48db00f4e19c019329322d" "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/1dd7ff8d7081e4c044b078c9361a6c81cc102e1d000e95f44250d0f7d18dd1a4" "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/768c2ce8fe765e029abeda1a3dc01fdb8bd2d51720334e9ce1a3acb6be2f2118"] :answer-field/correct "q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a/cfe7e9489b11e9b73d03c3715947077cd6e9f0f537abcae3bccec2e9713f4c16" :db/ensure [:answer-field/validate]} {:db/id "q-161383" :question/id #uuid "cd17085b-48fe-5be2-bc57-b62ce4e45b8c" :question/math-academy-id "q-161383" :question/problem "Consider the vector field $F$ and the surface $S$ with parametrization $r(u,v),$ where\n\n$$\nF(x,y,z)=⟨xz,\\,y,\\,xz⟩,\\,r(u,v)=⟨u,\\,uv,\\,v⟩,\\,(u,v)\\in D⊂{R}^{2}.\n$$\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}\\boxed{}\\,\\text{d}A\n$$\n\nwhat is the missing expression?\n\n*Hint: You can use the fact that ${r}_{u}^{′}\\times {r}_{v}^{′}=⟨v,\\,-1,\\,u⟩.$*" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nNotice we are told that the fundamental vector product for our surface is\n\n$$\n{r}_{u}^{′}\\times {r}_{v}^{′}=⟨v,\\,-1,\\,u⟩.\n$$\n\nNext, we substitute the coordinate expressions of $r(u,v)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(r(u,v)) & =⟨xz,\\,y,\\,xz⟩{|}_{x=u\\,y=uv\\,z=v} \\\\  & =⟨uv,\\,uv,\\,uv⟩\\end{aligned}\n$$\n\nFinally, we calculate the dot product of $F$ and ${r}_{u}^{′}\\times {r}_{v}^{′}:$\n\n$$\n\\begin{aligned}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′}) & =⟨uv,\\,uv,\\,uv⟩\\cdot ⟨v,\\,-1,\\,u⟩ \\\\  & =uv\\cdot v+uv\\cdot (-1)+uv\\cdot u \\\\  & =u{v}^{2}-uv+{u}^{2}v.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}\\,u{v}^{2}-uv+{u}^{2}v\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161383/ma-source-field/2721e4d9ff15a1c0af37386718e4f9bdb63682c8ff1779698b21c2a015cd863a"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e9b46ce4-cfe0-5da6-bc91-65ae8c544393"] :knowledge-point/questions ["q-161383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/59a1c04e5350d09cb7a55c95401aa2700b9c3232533f3568c1f7013647e7512e" :answer/id #uuid "60fe7301-045a-5922-aa2a-aedead638f72" :answer/type :answer.type/math :answer/value "2y<{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/53bc2777d766c98092bff9ef445f835185ca46d3f2582e8bf62618248fe2b2c2" :answer/id #uuid "1d579745-18a7-56b7-b4e9-a431ad9e37a4" :answer/type :answer.type/math :answer/value "2y={x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/a2eebbe73cc0b4d1319c9e7d1b9f6f1853f95c1c2525ecf0e65877195b66ae94" :answer/id #uuid "0ee6ce91-1488-5148-9828-b5f162dc0426" :answer/type :answer.type/math :answer/value "2y>{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/b45b7c60aff602e6b94d3fce153ebb6d57a080c2af6f6d79bdc5a6a16ece4da3" :answer/id #uuid "ce65b7bc-eb4f-514e-9543-adb8c74d66b2" :answer/type :answer.type/math :answer/value "2y\\ge {x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/fc92b33b3546d3e990acfaf952d2ad325dd5876a3a40fcfad72ecdf55b8216fc" :answer/id #uuid "0806981f-6419-5645-885d-52700289c9e2" :answer/type :answer.type/math :answer/value "2y\\le {x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07" :answer-field/id #uuid "4c52cd76-cfd3-58c7-bc1f-d28ea902272b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/59a1c04e5350d09cb7a55c95401aa2700b9c3232533f3568c1f7013647e7512e" "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/53bc2777d766c98092bff9ef445f835185ca46d3f2582e8bf62618248fe2b2c2" "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/a2eebbe73cc0b4d1319c9e7d1b9f6f1853f95c1c2525ecf0e65877195b66ae94" "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/b45b7c60aff602e6b94d3fce153ebb6d57a080c2af6f6d79bdc5a6a16ece4da3" "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/fc92b33b3546d3e990acfaf952d2ad325dd5876a3a40fcfad72ecdf55b8216fc"] :answer-field/correct "q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07/53bc2777d766c98092bff9ef445f835185ca46d3f2582e8bf62618248fe2b2c2" :db/ensure [:answer-field/validate]} {:db/id "q-161550" :question/id #uuid "a8f9ff3a-79fc-5066-8340-3c87867ab323" :question/math-academy-id "q-161550" :question/problem "![](images/d3/d3ded2a039746e3c8f7a7ee4afb70b0d697468d1aee8f0e9dab24b1ca87897d2.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A={(x,y)\\in {R}^{2}\\,:\\,\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/d1/d1946cea37f202705e6517ba760afa6617075f748901b10588ea98628a3e9e50.png)\n\nFrom the diagram, the boundary points of $A$ lie on the parabola $2y={x}^{2}.$\n\nTherefore, \n\n$$\n∂A={(x,y)\\in {R}^{2}\\,:\\,2y={x}^{2}\\,}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161550/ma-source-field/f92628938c22c42e12fa744a3b9d8a32ea6afef265fd70e56bc06272c1758f07"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e534c006-a5b4-5f76-bbd6-451496358d3a"] :knowledge-point/questions ["q-161550"] :db/ensure [:knowledge-point/valid