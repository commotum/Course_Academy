04c1715c78ec785028311403a823d4e82f5852c39c8cd7e166/519f96ed9a7eb65b5ed50d957de0cd25bf34fc6adde3454aa37d6878ac9fe541"] :answer-field/correct "q-176865/ma-source-field/c7ebd3dd29aeff04c1715c78ec785028311403a823d4e82f5852c39c8cd7e166/cc79b4ff5e57877b19c312bd528649c68f82425285d1dc55e0d1d7027dbdce04" :db/ensure [:answer-field/validate]} {:db/id "q-176865" :question/id #uuid "9b8bbb71-5c94-5fce-b0d2-f79d72a9b4c7" :question/math-academy-id "q-176865" :question/problem "$\\frac{1}{2}$ is **not** a rational number, or $-2$ is negative.\n\nExpress the compound statement above in symbolic form given the following:\n\n- $P:\\frac{1}{2}\\text{ is a rational number}$\n\n- $Q:-2\\text{ is negative}$" :question/worked-solution "The sentence\n\n$\\frac{1}{2}$ is **not** a rational number \n\ncan be expressed symbolically as $¬P.$ \n\nThe sentence\n\n$-2$ is negative\n\ncan be expressed symbolically as $Q.$\n\nTherefore, the sentence\n\n$\\frac{1}{2}$ is **not** a rational number, or $-2$ is negative\n\ncan be expressed symbolically as $¬P∨Q.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-176865/ma-source-field/c7ebd3dd29aeff04c1715c78ec785028311403a823d4e82f5852c39c8cd7e166"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93415651-fbcb-56d3-ad93-2b7f34e7bf4c"] :knowledge-point/questions ["q-176865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/fe5a032e59d7fded868435047a730ed7188d990dd7ef43315a6539fb759cc2e5" :answer/id #uuid "d7f9a8cc-12c2-5db4-9c8e-f8300024f0d2" :answer/type :answer.type/math :answer/value "x=-5" :db/ensure [:answer/validate]} {:db/id "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/3d7d6de9dce0cd78ccae871a5be6f2119d84fffb11edbfb635f5393e682f2570" :answer/id #uuid "49f83912-5796-573a-b936-a61ffb603ff7" :answer/type :answer.type/math :answer/value "x=-5,\\,5" :db/ensure [:answer/validate]} {:db/id "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/e4b7c4cbf28f06ecbb646d806bb142fa7a0d99b6831fcb7002d5eaf47c08a27d" :answer/id #uuid "1ca07054-2359-5a47-9068-5f524310351e" :answer/type :answer.type/math :answer/value "x=-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" :answer/id #uuid "b6a7c8bb-09ff-5a0f-b690-cf0f292ac7ee" :answer/type :answer.type/math :answer/value "x=5" :db/ensure [:answer/validate]} {:db/id "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/ac5810274ce9ebd0193f702545e078424975ff7cdc71c664a300d8035f9286b8" :answer/id #uuid "d012c549-4023-5194-9620-c38392bb0ca8" :answer/type :answer.type/math :answer/value "x=\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b" :answer-field/id #uuid "7a80fbe4-dbfb-530c-af35-e0f30a4a5542" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/fe5a032e59d7fded868435047a730ed7188d990dd7ef43315a6539fb759cc2e5" "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/3d7d6de9dce0cd78ccae871a5be6f2119d84fffb11edbfb635f5393e682f2570" "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/e4b7c4cbf28f06ecbb646d806bb142fa7a0d99b6831fcb7002d5eaf47c08a27d" "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/ac5810274ce9ebd0193f702545e078424975ff7cdc71c664a300d8035f9286b8"] :answer-field/correct "q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b/942405f500b03a053b52160d81933044177bc757c5f35618476b53dffbbccf08" :db/ensure [:answer-field/validate]} {:db/id "q-178256" :question/id #uuid "d601c130-3a93-5630-8b35-93cbbfae4d1b" :question/math-academy-id "q-178256" :question/problem "Which root(s) of the polynomial $p(x)={x}^{3}-5{x}^{2}-25x+125$ have multiplicity $2?$" :question/worked-solution "First, we need to factor the polynomial. For this polynomial, we can factor by grouping:\n\n$$\n\\begin{aligned}p(x) & ={x}^{3}-5{x}^{2}-25x+125 \\\\  & ={x}^{2}(x-5)-25(x-5) \\\\  & =({x}^{2}-25)(x-5) \\\\  & =(x+5)(x-5)(x-5) \\\\  & =(x-5{)}^{2}(x+5)\\end{aligned}\n$$\n\nTo find the roots and their multiplicities, we look at the factors:\n\n- The factor $(x-5)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=5$ has multiplicity $2.$\n\n- The factor $(x+5)$ has an exponent of $1$ in the factored form of $p(x).$ So the root $x=-5$ has multiplicity $1.$\n\nIn conclusion, only the root $x=5$ has multiplicity $2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-178256/ma-source-field/d165d5112c3fc386f49ec34181a6ced8e689f092b16f7f28705d781ac3bcd33b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7f6e86-a083-5dcd-beaa-8c3eae151bf1"] :knowledge-point/questions ["q-178256"] :db/ensure [:knowledge-point/validate]} {:db/id "q-178288/ma-source-field/83b86282e674a816d65e498f45850828a8bd56be4e149ac03f3e11befb2cc44c/93ecb1d8750b92d61b5b18c7eb347b07acbf45be9865bd3c26070ed0d040a8be" :answer/id #uuid "e7336544-f099-55c7-9031-17018a6d0ad9" :answer/type :answer.type/math :answer/value "0.067\\,9" :db/ensure [:answer/validate]} {:db/id "q-178288/ma-source-field/83b86282e674a816d65e498f45850828a8bd56be4e149ac03f3e11befb2cc44c/0b8f08ed61afef7084ed47ed3b3701583d406f0fbec5b323157af0d8ca38a9a8" :answer/id #uuid "0bb84096-c5db-5ab5-b2a4-918374d6c439" :answer/type :answer.