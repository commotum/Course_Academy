f/36e412d7ad8fba0b23ce32b7430ba3116ea9cfd4333a54537adf24eed762de89" :answer/id #uuid "dc0eea45-e863-58d6-862a-727382209bd0" :answer/type :answer.type/math :answer/value "-2\\,i+j+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/d5eaaf07f0505e9d5b231b8075c51e274f896039e198fc1181cc54f3b52b276e" :answer/id #uuid "da9bac7a-0578-5611-970c-aaa5ef3c56ad" :answer/type :answer.type/math :answer/value "-2\\,i+k" :db/ensure [:answer/validate]} {:db/id "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/5eca12de70941307282351d77251177fcda255baa40948e1e5a5334edc2466a1" :answer/id #uuid "f143a8ac-50ee-51ef-b268-61d02a927238" :answer/type :answer.type/math :answer/value "-2\\,i-j+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/c17b3979c4d8b80b24f2523b9b6f45c31cb6f8e7c34b6b57044b559b50426bed" :answer/id #uuid "997b1e10-3a89-5f14-bd4d-db6ba1a97e9c" :answer/type :answer.type/math :answer/value "2\\,i+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f" :answer-field/id #uuid "e4b666e0-c6c9-5c9c-b88e-9912d89e0283" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/f1b90fba0b7aefa993098330c09b33324e47e14d835633417020e21211084705" "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/36e412d7ad8fba0b23ce32b7430ba3116ea9cfd4333a54537adf24eed762de89" "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/d5eaaf07f0505e9d5b231b8075c51e274f896039e198fc1181cc54f3b52b276e" "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/5eca12de70941307282351d77251177fcda255baa40948e1e5a5334edc2466a1" "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/c17b3979c4d8b80b24f2523b9b6f45c31cb6f8e7c34b6b57044b559b50426bed"] :answer-field/correct "q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f/f1b90fba0b7aefa993098330c09b33324e47e14d835633417020e21211084705" :db/ensure [:answer-field/validate]} {:db/id "q-71396" :question/id #uuid "b0863b6f-83a0-5fff-bd6b-d5b930ec7673" :question/math-academy-id "q-71396" :question/problem "For the function $f(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(-1,0,1).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(-1,0,1)$ can be found by computing \n$∇f(-1,0,1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(-1,0,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}+{z}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2}+{z}^{2})\\,j+\\frac{∂}{∂z}({x}^{2}+{y}^{2}+{z}^{2})\\,k \\\\  & =2x\\text{ }i+2y\\text{ }j+2z\\text{ }k \\\\ ∇f(-1,0,1) & =2(-1)\\,i+2(0)\\,j+2(1)\\,k \\\\  & =-2\\,i+2\\,k\\end{aligned}\n$$\n\nTherefore, $-2\\,i+2\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(-1,0,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71396/ma-source-field/90ea1f5b9b05685619d8c3316f3da00cea89de6a5764ba620b6df70f4730256f"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4516cb28-0fc0-5c15-b9b2-747c3827e189"] :knowledge-point/questions ["q-71396"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/39985d70ab4dfc808aa1f5d35d6745e4a01934de0e02ce0c162419cb6ed06f7b" :answer/id #uuid "4643060a-8d1d-5789-a362-102d70382db9" :answer/type :answer.type/math :answer/value "2\\,i+2\\,j+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/65804235d7bb4b17b7f416e60a2e70b14da5e8ccdcf4ea5163765c822cba76d5" :answer/id #uuid "8070bb66-d16c-505c-85ee-2a417bc81d72" :answer/type :answer.type/math :answer/value "2\\,i+2\\,j+k" :db/ensure [:answer/validate]} {:db/id "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/6c0cf2e3db20a0bea079d3658ec5b4df2ccf15a94420b1c5738af55d521bf260" :answer/id #uuid "0bdcaf70-4358-5973-a594-026557c83288" :answer/type :answer.type/math :answer/value "2\\,i+j+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/fc3cf9a9c9d0f107d15f4c431948eb277ad3e5d7c87f47ffc2e9cd7858d13f7d" :answer/id #uuid "b9c9c882-083f-5978-8947-be71bba2f10e" :answer/type :answer.type/math :answer/value "2\\,i+j+k" :db/ensure [:answer/validate]} {:db/id "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/c1dce1f2a3d4009077e0c813dd56fd73b6c9f74650457c5a083f9a0b429122da" :answer/id #uuid "61e68fe8-0332-53d0-b214-d38a39b52899" :answer/type :answer.type/math :answer/value "i+2\\,j+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af" :answer-field/id #uuid "91095769-6695-5735-bdf7-d8d4bfdca38b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/39985d70ab4dfc808aa1f5d35d6745e4a01934de0e02ce0c162419cb6ed06f7b" "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/65804235d7bb4b17b7f416e60a2e70b14da5e8ccdcf4ea5163765c822cba76d5" "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/6c0cf2e3db20a0bea079d3658ec5b4df2ccf15a94420b1c5738af55d521bf260" "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/fc3cf9a9c9d0f107d15f4c431948eb277ad3e5d7c87f47ffc2e9cd7858d13f7d" "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/c1dce1f2a3d4009077e0c813dd56fd73b6c9f74650457c5a083f9a0b429122da"] :answer-field/correct "q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af/39985d70ab4dfc808aa1f5d35d6745e4a01934de0e02ce0c162419cb6ed06f7b" :db/ensure [:answer-field/validate]} {:db/id "q-71399" :question/id #uuid "58a67c4a-aa8b-5b64-8268-56928e2716de" :question/math-academy-id "q-71399" :question/problem "For the function $f(x,y,z)={e}^{x+y+z}+x+y+z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(0,0,0).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(0,0,0)$ can be found by computing \n$∇f(0,0,0).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(0,0,0):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({e}^{x+y+z}+x+y+z)\\,i+\\frac{∂}{∂y}({e}^{x+y+z}+x+y+z)\\,j+\\frac{∂}{∂z}({e}^{x+y+z}+x+y+z)\\,k \\\\  & =({e}^{x+y+z}+1)\\text{ }i+({e}^{x+y+z}+1)\\text{ }j+({e}^{x+y+z}+1)\\text{ }k \\\\ ∇f(0,0,0) & =({e}^{0+0+0}+1)\\,i+({e}^{0+0+0}+1)\\,j+({e}^{0+0+0}+1)\\,k \\\\  & =2\\,i+2\\,j+2\\,k\\end{aligned}\n$$\n\nTherefore, $2\\,i+2\\,j+2\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(0,0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71399/ma-source-field/d193c0ffc41648c13993eb8fb5f6d5700ed892168930f8cea17c5cbad60bd5af"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4516cb28-0fc0-5c15-b9b2-747c3827e189"] :knowledge-point/questions ["q-71399"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/7529b7133782017e05b48223dfcc8144183a9209d0523b2879f2e66d86c3a9f9" :answer/id #uuid "2b200597-1f86-5ecd-b8bc-18b09c132aad" :answer/type :answer.type/math :answer/value "(7-2x)^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/1ff9a5e93a9ba9ced3e62c1051de16084073dc64c3f9eceb5b64571c2b31b0ab" :answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type :answer.type/math :answer/value "-(7-2x)^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/249ea44cb4cacbb3b17fab795934c30f760ba3239a91f6479b8a6943eba80464" :answer/id #uuid "615ab3c3-1cc9-56db-a561-9ade7641ace4" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}(7-2x)^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/ebde65345d79b2dfdff9a01b83d42555a1df95902af4433ec5edb5a8c4fab2d5" :answer/id #uuid "5674f007-df38-5b04-ac90-1342c70182a8" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(7-2x)^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/de9f392d1940f7db3083b0fe123bd5dc60da2632316f2d04d563ccd6728ff4ca" :answer/id #uuid "13a3fa38-b420-5956-8a4b-2194f2d8ef30" :answer/type :answer.type/math :answer/value "\\frac{1}{8}(7-2x)^{8}+C" :db/ensure [:answer/validate]} {:db/id "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a" :answer-field/id #uuid "6ee57767-a470-5ed2-888e-e7479cb9accb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/7529b7133782017e05b48223dfcc8144183a9209d0523b2879f2e66d86c3a9f9" "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/1ff9a5e93a9ba9ced3e62c1051de16084073dc64c3f9eceb5b64571c2b31b0ab" "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/249ea44cb4cacbb3b17fab795934c30f760ba3239a91f6479b8a6943eba80464" "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/ebde65345d79b2dfdff9a01b83d42555a1df95902af4433ec5edb5a8c4fab2d5" "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/de9f392d1940f7db3083b0fe123bd5dc60da2632316f2d04d563ccd6728ff4ca"] :answer-field/correct "q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a/1ff9a5e93a9ba9ced3e62c1051de16084073dc64c3f9eceb5b64571c2b31b0ab" :db/ensure [:answer-field/validate]} {:db/id "q-72424" :question/id #uuid "8c75bb9c-44e2-5f73-9a68-3c296ae237a7" :question/math-academy-id "q-72424" :question/problem "$\\int 16(7-2x)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=7-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 16(7-2x)^{7}\\,\\text{d}x & =\\int 16{u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\int {u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\cdot (-\\frac{1}{2})\\int {u}^{7}\\,\\text{d}u \\\\  & =-8\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =-{u}^{8}+C \\\\  & =-(7-2x)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-(7-2x)^{8}+C] & =-\\frac{\\text{d}}{\\text{d}x}[(7-2x)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-8(7-2x)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(7-2x)+0 \\\\  & =-8(7-2x)^{7}\\cdot (-2) \\\\  & =16(7-2x)^{7}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72424/ma-source-field/a545d198b9ccb422d599aaf8831a744e861bc745094d56d80b18241ee26e0f4a"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc"] :knowledge-point/questions ["q-72424"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/03a4102f13ad3e0ac65ab53676c3f89cede3c650c4dd4e31a2b43a62847e184f" :answer/id #uuid "687b3878-1e39-592e-bd4f-4e2a35fe8bce" :answer/type :answer.type/math :answer/value "-2.5" :db/ensure [:answer/validate]} {:db/id "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "c9517166-8455-5ea8-9ddf-2d37ba3c4a74" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/82ec26c0001ae04b27cd2a63ab6318b183a710f05feb55d071b767b49c260b88" :answer/id #uuid "9e4e0c07-55d1-57ed-b3d5-98c24c51573e" :answer/type :answer.type/math :answer/value "-\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/c2223b402abc62f38e0912260502c4886959d43580edcea4b6bfd37e37b0f72b" :answer/id #uuid "595a3d87-e66e-5226-9996-f9b7f1bda018" :answer/type :answer.type/math :answer/value "-\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/c6aee8d6d50719f300760eb2495148ceeb4788aba7a3722d82e109afb19d07de" :answer/id #uuid "d269d88b-5397-5afd-96ec-8432693fda8b" :answer/type :answer.type/math :answer/value "-\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00" :answer-field/id #uuid "809e550a-3235-53e3-bcae-5eabda876862" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/03a4102f13ad3e0ac65ab53676c3f89cede3c650c4dd4e31a2b43a62847e184f" "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/82ec26c0001ae04b27cd2a63ab6318b183a710f05feb55d071b767b49c260b88" "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/c2223b402abc62f38e0912260502c4886959d43580edcea4b6bfd37e37b0f72b" "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/c6aee8d6d50719f300760eb2495148ceeb4788aba7a3722d82e109afb19d07de"] :answer-field/correct "q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :db/ensure [:answer-field/validate]} {:db/id "q-73894" :question/id #uuid "6fa85593-213a-592b-beaa-a7478f15ea2f" :question/math-academy-id "q-73894" :question/problem "![](images/0e/0e0466f463644e25cd2a615c445b6b32a6d9ae236c44658609cd778c5222fcae.png)\n\nThe total area $A$ of the region between the curve $y={x}^{2}+3x$ and the $x$-axis from $x=-4$ to $x=-1$ is given by the integral expression below. What is the value of $a?$\n\n$$\nA={\\int }_{-4}^{a}({x}^{2}+3x)\\,\\text{d}x-{\\int }_{a}^{-1}({x}^{2}+3x)\\,\\text{d}x.\n$$" :question/worked-solution "To determine the missing limit of integration, we need to find the $x$-intercept of the curve $y={x}^{2}+3x.$ So, we set $y=0$ and solve for $x$ as follows:\n\n$$\n\\begin{aligned}y & ={x}^{2}+3x \\\\ 0 & ={x}^{2}+3x \\\\ x(x+3) & =0.\\end{aligned}\n$$\n\nSo we have $x=0$ or $x=-3.$ The only solution between $x=-4$ and $x=-1$ is $x=-3.$\n\nSince $-3\\in [-4,-1]$, we have two regions:\n\n- The area between the curve and the $x$-axis from $x=-4$ to $x=-3.$\n\n- The area between the curve and the $x$-axis from $x=-3$ to $x=-1.$\n\nSo, $a=-3$ and the final expression will be\n\n$$\nA={\\int }_{-4}^{-3}({x}^{2}+3x)\\,\\text{d}x-{\\int }_{-3}^{-1}({x}^{2}+3x)\\,\\text{d}x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73894/ma-source-field/d564a7afd754a23ea25838e9021e3b1becdeea043a7877efe0efabc2dcb3aa00"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "18cd52a9-1524-5099-b1d8-858345328bad"] :knowledge-point/questions ["q-73894"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/da2defb1a2879ca37c892270155c3683623a00c348ee578c50f88225e92402ca" :answer/id #uuid "daa40cbf-4d3b-590b-81d0-b66a0577167e" :answer/type :answer.type/math :answer/value "A=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/e4415d110b95407c48496205ebaea52e47d3ae984a76406d0f220f0b23657d36" :answer/id #uuid "7585a86b-d9f0-55bc-8e6f-efb92e7d43c2" :answer/type :answer.type/math :answer/value "B=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/2af633efd1a9961154638f26740396de9836f102df5ac6902c12e2e17970d18b" :answer/id #uuid "d64405d0-289f-509a-b6c2-4ddc819a550c" :answer/type :answer.type/math :answer/value "C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/6e3a506b61e3dda37e201ba938ebd1ff99f85e5f16043ca415d4a105f27b3790" :answer/id #uuid "21195042-f7c2-5911-a358-864f5699c6dd" :answer/type :answer.type/math :answer/value "D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/daae0cdd4e30fe74acae7a6f9007caacfd334161a206fe310f04d2e9fa71b4d0" :answer/id #uuid "4b82a1dd-a8a6-5b78-82c9-fa1f39c4845b" :answer/type :answer.type/math :answer/value "E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b" :answer-field/id #uuid "29184956-f54b-5670-ad89-7254d448c06c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/da2defb1a2879ca37c892270155c3683623a00c348ee578c50f88225e92402ca" "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/e4415d110b95407c48496205ebaea52e47d3ae984a76406d0f220f0b23657d36" "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/2af633efd1a9961154638f26740396de9836f102df5ac6902c12e2e17970d18b" "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/6e3a506b61e3dda37e201ba938ebd1ff99f85e5f16043ca415d4a105f27b3790" "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/daae0cdd4e30fe74acae7a6f9007caacfd334161a206fe310f04d2e9fa71b4d0"] :answer-field/correct "q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b/e4415d110b95407c48496205ebaea52e47d3ae984a76406d0f220f0b23657d36" :db/ensure [:answer-field/validate]} {:db/id "q-74316" :question/id #uuid "9af406e1-4ead-558e-9219-f0bb53a377fc" :question/math-academy-id "q-74316" :question/problem "Which of the following is a lower triangular matrix?" :question/worked-solution "Notice that $B$ is a matrix for which all entries *above* the diagonal are $0$'s:\n\n$$\nB=[\\begin{aligned}0 & 0 & 0 \\\\ 2 & 5 & 0 \\\\ 1 & 4 & 3\\end{aligned}]\n$$\n\nHence, it is a lower triangular matrix. \n\nBy contrast, matrices $A$, $C$, $D$, and $E$ each have at least one non-zero entry above the diagonal:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 3\\end{aligned}],\\,C=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],\\,D=[\\begin{aligned}2 & -3 \\\\ 0 & 3\\end{aligned}],\\,E=[\\begin{aligned}0 & -4 & 0 \\\\ 5 & 0 & -7 \\\\ 1 & 2 & 0\\end{aligned}].\n$$\n\nSo, they are not lower triangular matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74316/ma-source-field/f71a14cfd5e38f5667ad5e1cfcd38a954d3d2638999ac9ad4fc67a92840c4a4b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc"] :knowledge-point/questions ["q-74316"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/40a1a273986776af283f3fe5271d8cce9b3f9fa9c2c7fc5bf8516dd5a30de4b0" :answer/id #uuid "43b3ca27-4022-5e94-91a9-05d77b4b0c3b" :answer/type :answer.type/math :answer/value "k=-2" :db/ensure [:answer/validate]} {:db/id "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/fec406b037c336df04ddc47abb8cf02e3ae194404415f3659041d4a99c636727" :answer/id #uuid "a9f1972b-cdc9-5bbd-bf68-8c034ebe8712" :answer/type :answer.type/math :answer/value "k=-4" :db/ensure [:answer/validate]} {:db/id "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/248b51d8dbaf80f78dea125bdb05eb0e56e973e920360179ea3a5b84faaf510d" :answer/id #uuid "3d7403d1-9523-59ef-892c-8762070fc770" :answer/type :answer.type/math :answer/value "k=-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" :answer/id #uuid "321a43c8-209e-53e7-bddf-716f4dd735c7" :answer/type :answer.type/math :answer/value "k=2" :db/ensure [:answer/validate]} {:db/id "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/137501af3ee859ebc04c1ab0d44d1b8c87d2d9c5abf6c7a5030f36ed2b1cd52b" :answer/id #uuid "e3df6cd2-68c7-5027-b94c-cebc3edbefd0" :answer/type :answer.type/math :answer/value "k=\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57" :answer-field/id #uuid "ce520123-e722-5fc8-b4b5-0ce963a1fe4b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/40a1a273986776af283f3fe5271d8cce9b3f9fa9c2c7fc5bf8516dd5a30de4b0" "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/fec406b037c336df04ddc47abb8cf02e3ae194404415f3659041d4a99c636727" "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/248b51d8dbaf80f78dea125bdb05eb0e56e973e920360179ea3a5b84faaf510d" "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/137501af3ee859ebc04c1ab0d44d1b8c87d2d9c5abf6c7a5030f36ed2b1cd52b"] :answer-field/correct "q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57/a9d809426690fc6065e8673c85a555723d4ab72d745ec39834681473e579f93a" :db/ensure [:answer-field/validate]} {:db/id "q-74650" :question/id #uuid "2b1df7fe-03a7-50e4-93e7-ab9ba910308e" :question/math-academy-id "q-74650" :question/problem "Determine the value of $k$ for which the following system of linear equations is consistent dependent:\n\n$$\n{\\begin{aligned} & 2x+6y=4 \\\\  & x+(k+1)y=2\\end{aligned}\n$$" :question/worked-solution "The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 6 & 4 \\\\ 1 & k+1 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 6 & 4 \\\\ 0 & k-2 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe corresponding system is now \n\n$$\n{\\begin{aligned} & 2x+6y=4 \\\\  & (k-2)y=0.\\end{aligned}\n$$\n\nThe system is consistent dependent if it has infinitely many solutions. For the system to have infinitely many solutions, it must have at least one free variable.\n\nIf $k=2,$ then the second equation is $0=0,$ which is true for any value of $y.$ So, we can remove this equation from the system. As a result, the system will contain only one equation, $2x+6y=4.$  \n\nThen, the basic variable will be $x,$ and we will have a free variable $y.$ That means the system will have infinitely many solutions.\n\nTherefore, our system is consistent dependent when $k=2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74650/ma-source-field/3786831e217eb031f10c3c1dff87ed301bb2000b1e5298c99515304f8f641b57"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "22733f71-de4a-5058-a41c-039e66e333c5"] :knowledge-point/questions ["q-74650"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74781/ma-source-field/7901ac252fd88d2ca678066be87fd2b8b4f1d108105953de1807f67650431778/38a4b83d7fcbca28dd18bcaed20029e3c594df97bdd7c7b7b7e3d614b1ea6ccd" :answer/id #uuid "f08777ee-7bc2-552d-b942-d0cc1bce2816" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-21 \\\\ -17 \\\\ 14\\end{aligned}]" :db