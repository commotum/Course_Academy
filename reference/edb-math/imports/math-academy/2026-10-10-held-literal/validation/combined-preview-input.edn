c40795a81e1614ff035456d27cf9e743013c2b5a16ccf208fe8d02c1482f/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :answer-field/correct "q-115706/ma-source-field/6fa9c40795a81e1614ff035456d27cf9e743013c2b5a16ccf208fe8d02c1482f/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :db/ensure [:answer-field/validate]} {:db/id "q-115706" :question/id #uuid "69d6e7a9-706b-5fd1-9cdb-c1c105740396" :question/math-academy-id "q-115706" :question/problem "![](images/88/883a60e9ac0d526d76243a44cff129f04ca148c1c2f0fb6a4b34db630b2193cd.png)\n\nThe differential equation that generates the slope field shown above is given by ${y}^{′}=(x-a)(x-b).$ Find the value of $a+b.$" :question/worked-solution "![](images/01/012fe788fa1ac778b361fe62c3f70344546c6c5008fa6dcce536cc721d4ba5e9.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $x=-2$ and $x=1,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nSo, our differential equation must be\n\n$$\n{y}^{′}=(x+2)(x-1).\n$$\n\nTherefore, we conclude that $a=-2,b=1$ and $a+b=-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115706/ma-source-field/6fa9c40795a81e1614ff035456d27cf9e743013c2b5a16ccf208fe8d02c1482f"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ede6800b-ecfd-5ef8-a386-4aec94ddd89c"] :knowledge-point/questions ["q-115706"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/abc4e01626eb87b45206b4cbe5fadc3db03bb1c6e9e7425dea4cb5a219c87fae" :answer/id #uuid "2cf0c4d3-d5f0-5202-86d5-80c8f41021ba" :answer/type :answer.type/math :answer/value "(-1,0)" :db/ensure [:answer/validate]} {:db/id "q-115910/ma-source-field/748a33d8d1ff9f3a979598d6c4f1d558b244e1ef998a9fc3d799828ea62de904/5a5de0862c4d09f62aeb98af5d5416c44c9fdd0290590d3d3b62f7225a4b20e1" :answer/id #uuid "77