3d8c8470611d466858d4dcaadef99c31785f/3156fa3aa006e591d496860456be38662b872375433bbcf5b2f4cb01e08eaa8b" "q-175312/ma-source-field/b67191599fa2f471bb635670d4013d8c8470611d466858d4dcaadef99c31785f/5173736ae882a1b3eae40fa6f73283fa167bfb5e486732274182ba783b306195" "q-175312/ma-source-field/b67191599fa2f471bb635670d4013d8c8470611d466858d4dcaadef99c31785f/8a97a7b0c219b9a578af3f8d919c6afb363fd5573836e771e2a0d8196bcd9d7e" "q-175312/ma-source-field/b67191599fa2f471bb635670d4013d8c8470611d466858d4dcaadef99c31785f/cc9276ce83922b0b6c4de3fdac00d51985b90b15647c31c81375b7ce7282f39c"] :answer-field/correct "q-175312/ma-source-field/b67191599fa2f471bb635670d4013d8c8470611d466858d4dcaadef99c31785f/cc9276ce83922b0b6c4de3fdac00d51985b90b15647c31c81375b7ce7282f39c" :db/ensure [:answer-field/validate]} {:db/id "q-175312" :question/id #uuid "a6022d77-1162-5219-998d-09e9a6dcc354" :question/math-academy-id "q-175312" :question/problem "$\\,$ $x=3$\n\nThe predicate $P(x)$ is given above. Which of following represents $¬P(x)?$" :question/worked-solution "In plain English, our predicate $P(x)$ means the following:\n\n$\\,$ $x$ equals $3.$\n\nThe symbol \"$¬$\" represents negation. To negate our plain English expression, we place the words \"It is not true that\" in front of it. This gives the following:\n\n$\\,$ It is not true that $x$ equals $3.$\n\nIn other words, $x$ is *not equal to* $3.$ Therefore, $¬P(x)$ means the following:\n\n$\\,$ $x\\ne 3$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-175312/ma-source-field/b67191599fa2f471bb635670d4013d8c8470611d466858d4dcaadef99c31785f"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7943a26b-d4fa-5ce1-bc47-5ea4873fc367"] :knowledge-point/questions ["q-175312"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186198728 :question/answer-fields 17592186194964] {:db/id "q-175315/ma-source-field/cde3e526a44fb09602ab0168e3ae5ab12194f62352c24fb31f14c553a02e1439/1c077bb4b9124a24d5b1de30376662e25