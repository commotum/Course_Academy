estion/difficulty :question.difficulty/moderate :question/answer-fields ["q-74782/ma-source-field/67a4938bb9be1fa7c427d98f7c3a8e3720c54329629c4695b69a758f496409d1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417"] :knowledge-point/questions ["q-74782"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120525 :question/answer-fields 17592186119234] {:db/id "q-74799/ma-source-field/dc9022d84a6050c3dfa686855614f8c96f848a1b4e8f65d3554addb73dc651a8/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "5f99f5bf-c4dc-5243-9e20-a60473d43cdf" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-74799/ma-source-field/dc9022d84a6050c3dfa686855614f8c96f848a1b4e8f65d3554addb73dc651a8/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "322571b5-cff6-5af1-8ffc-3d69d30c42af" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74799/ma-source-field/dc9022d84a6050c3dfa686855614f8c96f848a1b4e8f65d3554addb73dc651a8/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ca4c369b-196d-5064-b6ae-30dbe1fb3ef8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-74799/ma-source-field/dc9022d84a6050c3dfa686855614f8c96f848a1b4e8f65d3554addb73dc651a8/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "464b6f7e-c173-51c1-b8b9-0696fe3717dd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-74799/ma-source-field/dc9022d84a6050c3dfa686855614f8c96f848a1b4e8f65d3554addb73dc651a8/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "39980026-393f-53ea-96db-18546c54f0ef" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74799/ma-source-field/dc9022d84a6050c3dfa686855614f8c96f848a1b4e8f6