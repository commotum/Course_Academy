536f9dc1848f8aa2cd199a0b7b35c2dbd765c15b/48926eb34f1e846b681031fafa97063badde87056b576f4fc700078200d4dc3e" "q-162581/ma-source-field/318c12ea7c36f63e2939bbed536f9dc1848f8aa2cd199a0b7b35c2dbd765c15b/93622583d91246fe5dc138371feb07bd9b70d3000b99f9f7ad6a567421106f61" "q-162581/ma-source-field/318c12ea7c36f63e2939bbed536f9dc1848f8aa2cd199a0b7b35c2dbd765c15b/d8f9fc7f929748e021c371fb9cb157d983a78128d4e44c5c96a0b17cb0ab3cc3" "q-162581/ma-source-field/318c12ea7c36f63e2939bbed536f9dc1848f8aa2cd199a0b7b35c2dbd765c15b/dd703bda1dbe0c1f2061c401d52b12e2735c58169be6d35e33d604614ddea885"] :answer-field/correct "q-162581/ma-source-field/318c12ea7c36f63e2939bbed536f9dc1848f8aa2cd199a0b7b35c2dbd765c15b/dd703bda1dbe0c1f2061c401d52b12e2735c58169be6d35e33d604614ddea885" :db/ensure [:answer-field/validate]} {:db/id "q-162581" :question/id #uuid "e0d14173-8029-50a6-8f00-d7853c057071" :question/math-academy-id "q-162581" :question/problem "Let $S$ be the boundary of the rectangular prism enclosed by the planes $x=-1,$ $x=0,$ $y=1,$ $y=2,$ $z=0,$ $z=1.$ Given that the surface $S$ is positively (outward) oriented and $F=xy\\,i+2y\\,j+{x}^{2}zk,$ the flux of $F$ across $S$ can be written as \n\n$$\n{∬}_{S}F\\cdot dS={\\int }_{-1}^{0}{\\int }_{1}^{2}{\\int }_{0}^{1}\\,\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$\n\nWhat is the missing part of the expression?" :question/worked-solution "Let $R$ be a simple solid region bounded by a closed surface $S$ with positive (outward) orientation. If a vector field $F$ has continuous partial derivatives for all its components in an open region in space that contains $R,$ then the divergence theorem states that\n\n$$\n{∬}_{S}F\\cdot dS={∭}_{R}\\text{div}\\,F\\,\\text{d}V.\n$$\n\nComputing the divergence of $F,$ we obtain\n\n$$\n\\begin{aligned}\\text{div}\\,F & =\\frac{∂}{∂x}(xy)+\\frac{∂}{∂y}(2y)+\\frac{∂}{∂z}({x}^{2}z) \\\\  & =y+2+{x}^{2} \\\\  & ={x}^{2}+y+2.\\end{aligned}\n$$\n\nLet $R$ be the solid region enclosed by $S.$ Then, using the divergence theorem, we have\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot dS & ={∭}_{R}({x}^{2}+y+2)\\,\\text{d}V \\\\  & ={\\int }_{-1}^{0}{\\int }_{1}^{2}{\\int }_{0}^{1}\\,{x}^{2}+y+2\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-162581/ma-source-field/318c12ea7c36f63e2939bbed536f9dc1848f8aa2cd199a0b7b35c2dbd765c15b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a3fd63f-9991-5781-b4f8-9c4b0abc65ec"] :knowledge-point/questions ["q-162581"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162583/ma-source-field/d3eaa4a41879e4fcc24147adc77c2dd1e6b6d7b864d7190c049b1f450aece74c/6cfbbb056524e6ddc9cd35a423174595bb966a12ed61e5437d7b89b001228730" :answer/id #uuid "fc53f04c-d5bb-59dd-b389-8e0eefab0229" :answer/type :answer.type/math :answer/value "2x+3z" :db/ensure [:answer/validate]} {:db/id "q-162583/ma-source-field/d3eaa4a41879e4fcc24147adc77c2dd1e6b6d7b864d7190c049b1f450aece74c/f5e27680dccf325a2e1eff7c59a550bc6faa6324173f4446d6066305db5e7c5a" :answer/id #uuid "fc84079a-9c1c-54c9-bc3c-5fd874d6a1dc" :answer/type :answer.type/math :answer/value "2x-y-2z" :db/ensure [:answer/validate]} {:db/id "q-162583/ma-source-field/d3eaa4a41879e4fcc24147adc77c2dd1e6b6d7b864d7190c049b1f450aece74c/823e0b5d952e18913c8ca09efd5d6bebaed6397015c00aa11ecfbc771e3dfe40" :answer/id #uuid "af12ea26-8299-5100-8312-7691bb7b67f0" :answer/type :answer.type/math :answer/value "2x-z+4" :db/ensure [:answer/validate]} {:db/id "q-162583/ma-source-field/d3eaa4a41879e4fcc24147adc77c2dd1e6b6d7b864d7190c049b1f450aece74c/d883a6d355136141c5b13cb2651adf99d05e1490ef67e5d137cea50bb4338635" :answer/id #uuid "221c39d4-97a7-58e1-af0f-bd5bd145ae18" :answer/type :answer.type/math :answer/value "6x+4z" :db/ensure [:answer/validate]} {:db/id "q-162583/ma-source-field/d3eaa4a41879e4fcc24147adc77c2dd1e6b6d7b864d7190c049b1f450aece74c/94f570e3e356d78a1e722a70592be36f821bcd6c36c39f2acb0c19fe88a7865f" :answer/id #uuid "958be202-ad70-5f6