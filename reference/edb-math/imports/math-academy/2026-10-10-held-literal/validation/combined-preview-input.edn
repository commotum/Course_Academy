29d2e22ee67"] :answer-field/correct "q-75025/ma-source-field/1166a66061b1a7d0ccb764d2ad99de3d761c0baaa0ded4458bdb6abaef988238/6b7e07594c8480d7ff7c3b053b30beff09b309eb8e24fcdd35f2f542c523b790" :db/ensure [:answer-field/validate]} {:db/id "q-75025" :question/id #uuid "505e94a9-1916-5eb5-8401-0ae000faefd5" :question/math-academy-id "q-75025" :question/problem "Given the matrix $A=[\\begin{aligned}2 & -5 & 3 & 1 \\\\ 1 & -3 & 1 & 2\\end{aligned}]$, find a basis of $\\text{Null}(A).$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & -5 & 3 & 1 \\\\ 1 & -3 & 1 & 2\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 1 & 2 \\\\ 2 & -5 & 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 1 & 2 \\\\ 0 & 1 & 1 & -3\\end{aligned}] & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 & -7 \\\\ 0 & 1 & 1 & -3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+4{x}_{3}-7{x}_{4}=0 \\\\ {x}_{2}+{x}_{3}-3{x}_{4}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=-4{x}_{3}+7{x}_{4}$ and ${x}_{2}=-{x}_{3}+3{x}_{4},$ where ${x}_{3}$ and ${x}_{4}$ are free variables. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] & =[\\begin{aligned}-4{x}_{3}+7{x}_{4} \\\\ -{x}_{3}+3{x}_{4} \\\\ {x}_{3} \\\\ {x}_{4}\\end{aligned}] \\\\  & =[\\begin{aligned}-4{x}_{3} \\\\ -{x}_{3} \\\\ {x}_{3} \\\\ 0\\end{aligned}]+[\\begin{aligned}7{x}_{4} \\\\ 3{x}_{4} \\\\ 0 \\\\ {x}_{4}\\end{aligned}] \\\\  & ={x}_{3}[\\begin{aligned}-4 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{4}[\\begin{aligned}7 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3},{x}_{4}\\in R.\\end{aligned}\n$$\n\nThis implies that \n\n$$\nB={[\\begin{aligned}-4 \\\\ -1 \\\\ 1 \\\\ 0\\end{aligned}],[\\begin{aligned}7 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-75025/ma-source-field/1166a66061b1a7d0ccb764d2ad99de3d761c0baaa0ded4458bdb6abaef988238"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fd5a675-c692-505e-900b-d7500fb7c653"] :knowledge-point/questions ["q-75025"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "ff494868-b717-56d0-b9b8-ba8b8cadd615" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "ba58499f-83c5-5590-b067-5c72d5b139a2" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "46a45cff-fcc3-53f3-b793-ae6574c91421" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "991289dd-6e89-58ad-98ec-431b03eb6134" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "61a41175-cafd-5d7f-88b5-4b344125cf85" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a" :answer-field/id #uuid "63a6c2d7-95e4-53da-98cc-2de47ce76700" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :answer-field/correct "q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :db/ensure [:answer-field/validate]} {:db/id "q-75177" :question/id #uuid "30a5731c-2a02-53f9-9c62-2c24fdfa7142" :question/math-academy-id "q-75177" :question/problem "Given that\n$A=[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}]$\nhas the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}-2 & 3 \\\\ 1 & \\,\\,\\,-\\frac{3}{2}\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{2}{R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ \\frac{1}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ -\\frac{1}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}-2 & 3 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=-\\frac{1}{2},$ ${u}_{22}=0,$ and ${l}_{21}+{u}_{22}=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-75177/ma-source-field/b53a11151424a90fe6b3a347ed58bf25ef5938f7a3103a4bb15f530d1b7b807a"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2"] :knowledge-point/questions ["q-75177"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120528 :question/answer-fields 17592186119252] {:db/id "q-75519/ma-source-field/f2b38d9347a2ab25fa90f6fe8c865aeb849922a7eebdfa3eea066496651252e1/1d77d86dae2ed61625b4af15a6dd7a32243e0b9026ac7b1e9c222245e5eff213" :answer/id #uuid "77f84ef6-724c-531f-b459-e7fb46313f95" :answer/type :answer.type/math :answer/value "(1,1)" :db/ensure [:answer/validate]} {:db/id "q-75519/ma-source-field/f2b38d9347a2ab25fa90f6fe8c865aeb849922a7eebdfa3eea066496651252e1/be09feb4df8bae751a90cde3334bcc475d10fe16a8ba2a9a51e3b1c078806911" :answer/id #uuid "ee3fd924-6b61-5f7a-b8ee-202868ddd4db" :answer/type :answer.type/math :answer/value "(\\frac{1}{e},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-75519/ma-source-field/f2b38d9347a2ab25fa90f6fe8c865aeb849922a7eebdfa3eea066496651252e1/615ce298b3b2caa00e45c128718c0a33d13c6501a5640a019cc4872d406c5622" :answer/id #uuid "3d50a6a9-757b-54ed-a3ea-ef9ca589d5e8" :answer/type :answer