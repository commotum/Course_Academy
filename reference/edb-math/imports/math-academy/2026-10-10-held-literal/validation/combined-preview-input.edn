field/77a1f1aa8c3b54e7fcc071a8e18b4b2afaffd795ed8a726002958a2068279340/d364a8f4952113723a80a93957107ad5ce79e5147e7a3766085659e6da22fe39" "q-161596/ma-source-field/77a1f1aa8c3b54e7fcc071a8e18b4b2afaffd795ed8a726002958a2068279340/fe85096b3987d33f82bed6ac26bd9023c11210c3fca79130614988dcba307bb5" "q-161596/ma-source-field/77a1f1aa8c3b54e7fcc071a8e18b4b2afaffd795ed8a726002958a2068279340/1d231b1693da1e98fa1778269972768a08520933f8e1dace9acee66f31c95856" "q-161596/ma-source-field/77a1f1aa8c3b54e7fcc071a8e18b4b2afaffd795ed8a726002958a2068279340/3521148ed436b0680950e8d3c022e60eb03f713e138141c1bf96427e16784d10"] :answer-field/correct "q-161596/ma-source-field/77a1f1aa8c3b54e7fcc071a8e18b4b2afaffd795ed8a726002958a2068279340/d364a8f4952113723a80a93957107ad5ce79e5147e7a3766085659e6da22fe39" :db/ensure [:answer-field/validate]} {:db/id "q-161596" :question/id #uuid "28ca8dae-bb66-5179-8a04-f47a13f5a86d" :question/math-academy-id "q-161596" :question/problem "![](images/2b/2bb25857047d7a0200d4c58ee3756b0efa0f2d13aaca8664b1fe49414c18a461.png)\n\nConsider the set $A,$ shown above. The boundary of $A$ is given by\n\n$$\n∂A={(x,y)\\in {R}^{2}\\,:\\,\\,}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/88/88f35519cf1aa01bcc9e4fb91b24c2bc2a1a823867ec2670563b0b45f2643a0a.png)\n\nFrom the diagram, the boundary points of $A$ lie on the parabola ${y}^{2}=-x.$\n\nTherefore, \n\n$$\n∂A={(x,y)\\in {R}^{2}\\,:\\,{y}^{2}=-x\\,}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161596/ma-source-field/77a1f1aa8c3b54e7fcc071a8e18b4b2afaffd795ed8a726002958a2068279340"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e534c006-a5b4-5f76-bbd6-451496358d3a"] :knowledge-point/questions ["q-161596"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161598/ma-source-field/f