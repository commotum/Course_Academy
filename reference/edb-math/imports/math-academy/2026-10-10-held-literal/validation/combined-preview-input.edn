a93c7a9df" "q-49439/ma-source-field/5c41871ef3df294e0835180881b2fbcb9ccaaa6ed37365d9cd8590292d661a82/ec38b0c5baa6ee7873e32107029003fcdf7ddf65720270e96afe5bb35c9e7122" "q-49439/ma-source-field/5c41871ef3df294e0835180881b2fbcb9ccaaa6ed37365d9cd8590292d661a82/6b848d3aa968c50eb063907d0f140b6223bbfaf655610faf36d4c72c137e6c72" "q-49439/ma-source-field/5c41871ef3df294e0835180881b2fbcb9ccaaa6ed37365d9cd8590292d661a82/d448715a3e7003bc8c650fcda64c17c16a37da4802f2a7b1a5c8cc1b08742700"] :answer-field/correct "q-49439/ma-source-field/5c41871ef3df294e0835180881b2fbcb9ccaaa6ed37365d9cd8590292d661a82/6af968862cd0db87d034c8bd8a089a62100664ee29ad7f6bfc426f5a93c7a9df" :db/ensure [:answer-field/validate]} {:db/id "q-49439" :question/id #uuid "61d8dd43-99c6-5162-9111-9fc96bb88dcd" :question/math-academy-id "q-49439" :question/problem "Calculate the integral $\\int \\sqrt[4]{(x-100)^{7}}\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (x-100)^{7/4}\\,\\text{d}x.\n$$\n\nNow, we let  $u=x-100.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int (x-100)^{7/4}\\,\\text{d}x & =\\int {u}^{7/4}\\,\\text{d}u \\\\  & =\\frac{{u}^{11/4}}{11/4}+C \\\\  & =\\frac{4}{11}(x-100)^{11/4}+C \\\\  & =\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{4}{11}\\sqrt[4]{(x-100)^{11}}+C] & =\\frac{4}{11}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\sqrt[4]{(x-100)^{11}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{4}{11}\\cdot \\frac{\\text{d}}{\\text{d}x}[(x-100)^{11/4}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{4}{11}\\cdot \\frac{11}{4}(x-100)^{7/4}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-100)+0 \\\\  & =(x-100)^{7/4}\\cdot 1 \\\\  & =\\sqrt[4]{(x-100)^{7}}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49439/ma-source-field/5c41871ef3df294e0835180881b2fbcb9ccaaa6ed37365d9cd8590292d661a82"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7"] :knowledge-point/questions ["q-49439"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/7a5f3ce7b330c10d2531acacab99f1128dd2a7f3e27823a835266036416059c0" :answer/id #uuid "ef8f42a5-cc05-5072-93b3-0b55ad819b57" :answer/type :answer.type/math :answer/value "2\\sqrt[5]{{(s+1)}^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/1713b69c60f2939a9b17aad2130db2fc7631f64062cf3744498de211a148b0fb" :answer/id #uuid "64f1bb19-f6a2-538a-8094-300b1e55cc31" :answer/type :answer.type/math :answer/value "5\\sqrt[5]{{(s+1)}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/ae0b08f9eadea9dc733167885b6ab02db28a1c5037f474d3b2ef0fd6cdf8b81c" :answer/id #uuid "eeef3e88-28df-595f-88f1-2280a46131c0" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\sqrt[5]{{(s+1)}^{3}}+C" :db/ensure [:answer/validate]} {:db/id "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/d3553828190ba618bd96e797e7e0114fa8895d7e7dc1e44c21ce6a856e4e531d" :answer/id #uuid "c04d34f3-85b9-5e8c-b8f6-dc61a84a62ab" :answer/type :answer.type/math :answer/value "\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/a20ddc92c278bfee059db77148671abcf7188a9a7082d11524c223e760613926" :answer/id #uuid "1c531862-1246-5d33-83db-faf2c5f53bfb" :answer/type :answer.type/math :answer/value "\\sqrt[5]{{(s+1)}^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301" :answer-field/id #uuid "69629315-77cc-510c-b6be-75d926e5d966" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/7a5f3ce7b330c10d2531acacab99f1128dd2a7f3e27823a835266036416059c0" "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/1713b69c60f2939a9b17aad2130db2fc7631f64062cf3744498de211a148b0fb" "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/ae0b08f9eadea9dc733167885b6ab02db28a1c5037f474d3b2ef0fd6cdf8b81c" "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/d3553828190ba618bd96e797e7e0114fa8895d7e7dc1e44c21ce6a856e4e531d" "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/a20ddc92c278bfee059db77148671abcf7188a9a7082d11524c223e760613926"] :answer-field/correct "q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301/d3553828190ba618bd96e797e7e0114fa8895d7e7dc1e44c21ce6a856e4e531d" :db/ensure [:answer-field/validate]} {:db/id "q-49468" :question/id #uuid "2058ea27-d95b-5f37-8b22-5c724bfe6f2c" :question/math-academy-id "q-49468" :question/problem "$\\int \\frac{1}{\\sqrt[5]{{(s+1)}^{3}}}\\,\\text{d}s=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int {(s+1)}^{-3/5}\\,\\text{d}s.\n$$\n\nNow, we let  $u=s+1.$ Then differentiating with respect to $s$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}s}=1\\,⟹\\,\\text{d}s=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int {(s+1)}^{-3/5}\\,\\text{d}s & =\\int {u}^{-3/5}\\,\\text{d}u \\\\  & =\\frac{1}{2/5}{u}^{2/5}+C \\\\  & =\\frac{5}{2}{u}^{2/5}+C \\\\  & =\\frac{5}{2}{(s+1)}^{2/5}+C \\\\  & =\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}s}[\\frac{5}{2}\\sqrt[5]{{(s+1)}^{2}}+C] & =\\frac{5}{2}\\cdot \\frac{\\text{d}}{\\text{d}s}[\\sqrt[5]{{(s+1)}^{2}}]+\\frac{\\text{d}}{\\text{d}s}(C) \\\\  & =\\frac{5}{2}\\cdot \\frac{\\text{d}}{\\text{d}s}[{(s+1)}^{2/5}]+\\frac{\\text{d}}{\\text{d}s}(C) \\\\  & =\\frac{5}{2}\\cdot \\frac{2}{5}{(s+1)}^{-3/5}\\cdot \\frac{\\text{d}}{\\text{d}s}(s+1)+0 \\\\  & ={(s+1)}^{-3/5}\\cdot 1 \\\\  & =\\frac{1}{\\sqrt[5]{{(s+1)}^{3}}}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49468/ma-source-field/7a3edbd5e0663fb8769d1f548cc9b354b411dc737c6534ac672c089a0588a301"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7"] :knowledge-point/questions ["q-49468"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186097306 :question/answer-fields 17592186095730] {:db/id "q-50139/ma-source-field/d50cb7942c0f354a9eeb3afec62053aeaef745ae8437be93c1dd3c76034f4883/43ae3bae5f1c56d93616a352ae417694008cdb30e5bf6526697075a3befb7849" :answer/id #uuid "29a4235d-41c9-5a0e-b658-3ec6b027584e" :answer/type :answer.type/math :answer/value "y=-5{x}^{2}+Cx" :db/ensure [:answer/validate]} {:db/id "q-50139/ma-source-field/d50cb7942c0f354a9eeb3afec62053aeaef745ae8437be93c1dd3c76034f4883/55e34e8a8645bf9a6f5e4cb4d0f92368a138290515792fdec8a2d4bb857e972e" :answer/id #uuid "4b317621-35b4-53d1-939d-fab67d8f1031" :answer/type :answer.type/math :answer/value "y=-5{x}^{2}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-50139/ma-source-field/d50cb7942c0f354a9eeb3afec62053aeaef745ae8437be93c1d