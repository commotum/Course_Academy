 as $P∨Q.$\n\nThe negation is represented by the symbol \"$¬$\". \n\nTherefore, the given sentence is expressed symbolically as $¬(P∨Q).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81372/ma-source-field/c1c4ccc94845abad1c93b4e6783c1ff134ba5ef122c4383cf62627335f410950"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93415651-fbcb-56d3-ad93-2b7f34e7bf4c"] :knowledge-point/questions ["q-81372"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81402/ma-source-field/9916c635bf103df74e67fe846dc430ce738db7b9303ed935d687911f01fc3aee/bbb1cf4a106bf4367cc6beedd17f1625d08ffdd9eac3386366c949c303f9fe19" :answer/id #uuid "1a0e58c2-034a-5988-b77b-6f3ef046dde8" :answer/type :answer.type/math :answer/value "¬(P∧Q)" :db/ensure [:answer/validate]} {:db/id "q-81402/ma-source-field/9916c635bf103df74e67fe846dc430ce738db7b9303ed935d687911f01fc3aee/66421ed265c4c11f591792941e8cbb8df0de1d9edfb1686ec48731f0ddc1bb4b" :answer/id #uuid "be756830-49dc-5e43-9651-def9f8fc55f6" :answer/type :answer.type/math :answer/value "¬(P∨Q)" :db/ensure [:answer/validate]} {:db/id "q-81402/ma-source-field/9916c635bf103df74e67fe846dc430ce738db7b9303ed935d687911f01fc3aee/f471b1465bd6da1a8201a87ba955bbab1a372591aacd84f2e1ea866f6663c8b0" :answer/id #uuid "9348944a-e977-519b-8cc8-d0c7b6b75730" :answer/type :answer.type/math :answer/value "¬(P∨¬Q)" :db/ensure [:answer/validate]} {:db/id "q-81402/ma-source-field/9916c635bf103df74e67fe846dc430ce738db7b9303ed935d687911f01fc3aee/cc79b4ff5e57877b19c312bd528649c68f82425285d1dc55e0d1d7027dbdce04" :answer/id #uuid "523005d0-2bae-5503-80be-1e748c72d8eb" :answer/type :answer.type/math :answer/value "¬P∨Q" :db/ensure [:answer/validate]} {:db/id "q-81402/ma-source-field/9916c635bf103df74e67fe846dc430ce738db7b9303ed935d687911f01fc3aee/519f96ed9a7eb65b5ed50d957de0cd25bf34fc6adde3454aa37d6878ac9fe541" :answer/id #uuid "aa470d03-c579-5191-9d6e-817237797af8" :answer/type :answer.type/math :answer/value "¬P∨¬Q" :db/ensure [:answe