 in $D.$ Since the number of columns in $C$ equals the number of rows in $D,$ the matrices $C$ and $D$ are conformable for multiplication, and $CD$ is a $5\\times 1$ matrix: \n\n$$\n{C}_{5\\times \\boxed{\\text{7}}}{\\times }_{✓}{D}_{\\boxed{\\text{7}}\\times 1}={CD}_{5\\times 1}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129480/ma-source-field/97e416c242c1ad261694a0d2ecc4cb409b33c27fd7a52280fe8b1c0e164791ff"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce"] :knowledge-point/questions ["q-129480"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/d5eaaf07f0505e9d5b231b8075c51e274f896039e198fc1181cc54f3b52b276e" :answer/id #uuid "431e58b2-3a4b-54f5-a2fc-05d378bf57ce" :answer/type :answer.type/math :answer/value "-2\\,i+k" :db/ensure [:answer/validate]} {:db/id "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/947da72898dd46ce941403ebe7333a79145120cefb4cbf008e02fe37a359af49" :answer/id #uuid "d7aa6514-a3ad-578c-8808-8284836b7b95" :answer/type :answer.type/math :answer/value "2\\,i-2\\,j-k" :db/ensure [:answer/validate]} {:db/id "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/07f4227f1fca5f7d6a41fe60d797c0c31d6108906270b35c6b6f12f706f549c9" :answer/id #uuid "ed1a1ab0-6d18-5f30-b80b-be9f46dd80b5" :answer/type :answer.type/math :answer/value "3\\,i+j+k" :db/ensure [:answer/validate]} {:db/id "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/7fc44339767192def569051958b4da8a6320146f6867510d397160a8bafc7f59" :answer/id #uuid "f499f957-93d0-5ca6-8e65-57c931e33b8e" :answer/type :answer.type/math :answer/value "3\\,i-2\\,j" :db/ensure [:answer/validate]} {:db/id "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/620152572f25d2e6461570ce4b61cd78d53815be5338059714b5504833a0afbb" :answer/id #uuid "d1cbc8d4-c2ee-5478-860e-c731a5274aec" :answer/type :answer.type/math :answer/value "j-k" :db/ensure [:answer/validate]} {:db/id "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4" :answer-field/id #uuid "530f90fa-b927-569c-b4dd-79831f2442af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/d5eaaf07f0505e9d5b231b8075c51e274f896039e198fc1181cc54f3b52b276e" "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/947da72898dd46ce941403ebe7333a79145120cefb4cbf008e02fe37a359af49" "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/07f4227f1fca5f7d6a41fe60d797c0c31d6108906270b35c6b6f12f706f549c9" "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/7fc44339767192def569051958b4da8a6320146f6867510d397160a8bafc7f59" "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/620152572f25d2e6461570ce4b61cd78d53815be5338059714b5504833a0afbb"] :answer-field/correct "q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4/7fc44339767192def569051958b4da8a6320146f6867510d397160a8bafc7f59" :db/ensure [:answer-field/validate]} {:db/id "q-131116" :question/id #uuid "da3be12b-b270-5258-9b1c-409842422d29" :question/math-academy-id "q-131116" :question/problem "For the function $f(x,y,z)={x}^{3}+{z}^{2}{y}^{2}+2z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,-1).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,-1)$ can be found by computing \n$∇f(1,-1,-1).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(1,-1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,i+\\frac{∂}{∂y}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,j+\\frac{∂}{∂z}({x}^{3}+{z}^{2}{y}^{2}+2z)\\,k \\\\  & =3{x}^{2}\\text{ }i+2{z}^{2}y\\text{ }j+(2z{y}^{2}+2)\\text{ }k \\\\ ∇f(1,-1,-1) & =3(1)^{2}\\,i+2(-1)^{2}(-1)\\,j+(2(-1)(-1)^{2}+2)k \\\\  & =3\\,i-2\\,j\\end{aligned}\n$$\n\nTherefore, $3\\,i-2\\,j$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131116/ma-source-field/5db62383c700c871a14ce96fbb1c91484e04ef928dce2ebef99fd9d5f9a4bcd4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4516cb28-0fc0-5c15-b9b2-747c3827e189"] :knowledge-point/questions ["q-131116"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131386/ma-source-field/80d2b30f05a3096f0a84976044992f612667b50f9b2ad270eac962102f3a7621/5b6ac77306c80f3fdc09b40a1fe98a00ba2c59d1f8b0976d14cdd3e0860eceba" :answer/id #uuid "80c239f1-2477-589f-86a5-ea556c241ef3" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}+10{R}_{1},\\,{R}_{2}:=-\\frac{1}{2}{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-131386/ma-source-field/80d2b30f05a3096f0a84976044992f612667b50f9b2ad270eac962102f3a7621/97c269130dbf5c46569f36f1220b3e472b4a8e8218d3ad85c59008ada24e50f5" :answer/id #uuid "4decee1b-a5c5-5ee9-bf41-5de4e35527d8" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}+5{R}_{1},\\,{R}_{2}:=\\frac{1}{2}{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-131386/ma-source-field/80d2b30f05a3096f0a84976044992f612667b50f9b2ad270eac962102f3a7621/8265d61838e978a7ecad1e167804f50d574a00f378ee7a9ed921bb331797b3ae" :answer/id #uuid "6488a307-e785-52c8-8088-0ef9aa800065" :answer/type :answer.type/math :answer/value "{R}_{2}:={R}_{2}-10{R}_{1},\\,{R}_{2}:=-2{R}_{2}" :db/ensure [:answer/validate]} {:db/id "q-131386/ma-source-field/80d2b30f05a