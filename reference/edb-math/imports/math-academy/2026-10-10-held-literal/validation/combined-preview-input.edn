 "91d09261-286a-5e85-a61f-8483207f7bbc" :question/math-academy-id "q-105039" :question/problem "Which statement is **not** true?" :question/worked-solution "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only ${Z}^{-}⊆N$ is not true. This statement is not true because not every negative integer is a natural number. For example, we have $-1\\in {Z}^{-}$ but $-1\\notin N.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105039/ma-source-field/e42ea873ee538626cf850e7133110248a47f3f135a3835302534254c83faeec0"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d"] :knowledge-point/questions ["q-105039"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105684/ma-source-field/eeb2438a6d8705502a3a42072684f614f995f6063924f7a9c63a3f28f1512701/a80a330cf07901aff7b5aa904c4a3541c2351751eef1834664dea83e123d76ff" :answer/id #uuid "fcbf2cfc-cc1d-5edf-a3e3-c5e70fa29687" :answer/type :answer.type/math :answer/value "k=1" :db/ensure [:answer/validate]} {:db/id "q-105684/ma-source-field/eeb2438a6d8705502a3a42072684f614f995f6063924f7a9c63a3f28f1512701/5ecba1d45a9d16913fd88aa066593c45c993e24db75e55ae5baf151dd6db7997" :answer/id #uuid "ce4dd8a6-aedf-5374-b33e-ed3ae01d38e7" :answer/type :answer.type/math :answer/value "k=10" :db/ensure [:answer/validate]} {:db/id "q-105684/ma-source-field/eeb2438a6d8705502a3a42072684f614f995f6063924f7a9c63a3f28f1512701/4e2429b00a3baaac76f6e33158fbcdff5dcf0af49a1b90a9dac6995df4919225" :answer/id #uuid "96097c76-4105-5c5a-ae9d-9b4ab896fa31" :answer/type :answer.type/math :answer/value "k=5" :db/ensure [:answer/validate]} {:db/id "q-105684/ma-source-field/eeb2438a6d8705502a3a42072684f614f995f6063924f7a9c63a3f28f1512701/53cb6fffc80c9612581a177458e2cc038c228df19ee12acca12be555f8ff8b68" :answer/id #uuid "dadb0c21-2455-5c3f-a616-4c04263c9727" :answer/type :answer.type/math :answer/value "k=50" :db/ensure [: