31/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/5ad2374df36afafb9656b3ac1604d0e5f45e0f98de12bc28b364f736f54d04c8" :answer/id #uuid "907e5e7f-7e94-57d6-9bfb-14bd7f6ece40" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{\\sqrt{13}} \\\\ -\\frac{2}{\\sqrt{13}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/fc6f9bb4a3b99278df2d8d16e97eb20e68385b47aaf500b5de6560f296dd13a9" :answer/id #uuid "2546f306-2d7a-5ce6-8172-c0754a16f6b1" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{3}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9" :answer-field/id #uuid "7b34650b-cc77-5f2b-8326-4e505803a14c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/868bfaa88d0dff2a56a67a03d8d1734d3ae94a2865a6f23a081967eba5121f89" "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/c25b4c5a34c9f50ba5cab12d26d91674670de71293237dd889d3975aa50ccc8f" "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/43b1c758d20a0ac1fe227f218df968cc4f00e632fdc038b1232e082fa5d25c5d" "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/5ad2374df36afafb9656b3ac1604d0e5f45e0f98de12bc28b364f736f54d04c8" "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/fc6f9bb4a3b99278df2d8d16e97eb20e68385b47aaf500b5de6560f296dd13a9"] :answer-field/correct "q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9/5ad2374df36afafb9656b3ac1604d0e5f45e0f98de12bc28b364f736f54d04c8" :db/ensure [:answer-field/validate]} {:db/id "q-96231" :question/id #uuid "eab879a0-3375-58dd-903d-5ef4248752b2" :question/math-academy-id "q-96231" :question/problem "$$\nU=[\\begin{aligned}\\frac{2}{\\sqrt{13}} & \\,∗\\, \\\\ \\frac{3}{\\sqrt{13}} & \\,∗\\,\\end{aligned}]\n$$\n\nConsider the matrix $U$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ which of the following could be the second column of the matrix $U?$" :question/worked-solution "Recall that since $A=UΣ{V}^{T}$ is a singular value decomposition of a $2\\times 2$ matrix $A,$ the matrix $U$ must be a $2\\times 2$ orthogonal matrix. This means that \n\n- the first column must be orthogonal to the second column, and\n\n- the norm of the second column must be equal to $1.$\n\nAmong the given options, only the vector $[\\begin{aligned}\\frac{3}{\\sqrt{13}} \\\\ -\\frac{2}{\\sqrt{13}}\\end{aligned}]$ has both properties." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96231/ma-source-field/3b7ec209ab8cefcb1763c231cf2607c86367130cfbb363a005ae9f755a7130e9"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c94ec9c4-650f-5d39-9294-651b03b172bf"] :knowledge-point/questions ["q-96231"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96752/ma-source-field/68d0461fbe20bf0fba36165a2af17287d11f87a1ce66cf21cfa1ca2adfdeb6ca/8bfaa3491b305c5361fa54572212f3b443cfba0df8f4a41a2231aae854cc9528" :answer/id #uuid "411ec587-a129-5e2e-b6ff-63373524322f" :answer/type :answer.type/math :answer/value "f:Q\\to Y" :db/ensure [:answer/validate]} {:db/id "q-96752/ma-source-field/68d0461fbe20bf0fba36165a2af17287d11f87a1ce66cf21cfa1ca2adfdeb6ca/38a521ad1e8973f8d7bcec74350172a7990131a83de0c70c9defee10f4a7fde0" :answer/id #uuid "b9b0c9cc-603c-54c1-8347-229d13e4b8a6" :answer/type :answer.type/math :answer/value "f:R\\to R" :db/ensure [:answer/validate]} {:db/id "q-96752/ma-source-field/68d0461fbe20bf0fba36165a2af17287d11f87a1ce66cf21cfa1ca2adfdeb6ca/20b8c5e79c50bd9ac3742d090