d}y}{\\text{d}x}={e}^{-y},\\,y(1)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=1.$\n\nSubstituting the initial condition $y(1)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(A+x) \\\\ 1 & =\\operatorname{ln}⁡(A+1) \\\\ {e}^{1} & ={e}^{\\operatorname{ln}⁡(A+1)} \\\\ e & =A+1 \\\\ A & =e-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{ln}⁡(e-1+x).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141115/ma-source-field/6d307acd0451d69023785b1d04885f5f25a27061517acbdb414c97b1942b66ef"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d"] :knowledge-point/questions ["q-141115"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "86af0317-94e9-53ec-8661-5ce6b18962d1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "2dcefcd7-21a2-550b-82e1-cdf9e8efcbda" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "89f9fe65-61ad-531c-91e5-0d74f2e05f24" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d47c7e95-9d5a-515c-9902-a9d88176c6d6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "4b4230d9-c571-50ea-9f01-98df054d2c1d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c" :answer-field/id #uuid "9f0c471e-3bc9-5406-b7a8-dfcd6f763630" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :answer-field/correct "q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :db/ensure [:answer-field/validate]} {:db/id "q-141116" :question/id #uuid "ea6ff592-81a4-59f3-84d6-c97bdc2e3a4f" :question/math-academy-id "q-141116" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-{y}^{2},\\,y(0)=\\frac{1}{2}.\n$$\n\nYou're given that $y=\\frac{1}{A+x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{1}{A+x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(0)=\\frac{1}{2}.$\n\nSubstituting the initial condition $y(0)=\\frac{1}{2}$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{A+x} \\\\ \\frac{1}{2} & =\\frac{1}{A+0} \\\\ \\frac{1}{2} & =\\frac{1}{A} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{1}{2+x}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-141116/ma-source-field/1b6ebe9d2f21f227bfad338fd0f130bf8cc9155f22b22f6c2fb3f8e27037500c"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d"] :knowledge-point/questions ["q-141116"] :db/ensure [:knowledge-point/validate]} {:db/id "q-141999/ma-source-field/d1e4091c5e8ad6c936e75fc933962122d1b54f60f1d5b52ce64100a5cbab417a/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "21d7fa3c-5da8-50fa-8d80-231c8289856a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-141999/ma-source-field/d1e4091c5e8ad6c936e75fc933962122d1b54f60f1d5b52ce64100a5cbab417a/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "70cad25b-cabf-5869-8148-7ca6a521ce0d" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-141999/ma-source-field/d1e4091c5e8ad6c936e75fc933962122d1b54f60f1d5b52ce64100a5cbab417a/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "b6d90684-6641-5156-b37c-32b