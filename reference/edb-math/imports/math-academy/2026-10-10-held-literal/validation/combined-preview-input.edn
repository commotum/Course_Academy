f1c49ac473e" "q-109390/ma-source-field/215e14deff61cd0a869a6ae6d2678e1918ea9cdc3d54a204c6870f26222d835c/8771075ab5ece97a2905061ea1c862eaf929dbbeac1834cda7c847dcbd62ea61" "q-109390/ma-source-field/215e14deff61cd0a869a6ae6d2678e1918ea9cdc3d54a204c6870f26222d835c/9d4f7d909bfd9fd78114724c1c1bf2a652c8616dfb7dc36857e0c403d7e7f870"] :answer-field/correct "q-109390/ma-source-field/215e14deff61cd0a869a6ae6d2678e1918ea9cdc3d54a204c6870f26222d835c/5611c708a18a4198a7a9071e80a0f1a03885f349c6a8d22da93e1a69972d1a00" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "132107ab-2199-5d46-b51c-37977a6efa1d"] :question/problem "$$\nA=[\\begin{aligned}-1 & 0 & -4 \\\\ -1 & 2 & 1 \\\\ -1 & 0 & -1\\end{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}=2,$ ${\\lambda }_{2}=1,$ and ${\\lambda }_{3}=-3.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a $3\\times 3$ matrix that has precisely $3$ distinct eigenvalues. \n\nTherefore, $A$ is diagonalizable, and its Jordan canonical form is\n\n$$\n{J}_{1}(2)\\,⊕\\,{J}_{1}(1)\\,⊕\\,{J}_{1}(-3)=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -3\\end{aligned}].\n$$\n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-109390/ma-source-field/215e14deff61cd0a869a6ae6d2678e1918ea9cdc3d54a204c6870f26222d835c"] :db/ensure [:question/validate]} [:db/retract 17592186162292 :question/answer-fields 17592186158924] {:db/id "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/a8f495b34476a049d0a1594525832eb024f68fb3d4ab672588cf77399ac57cfd" :answer/id #uuid "c6d92618-77c9-57fa-8614-5cc787fcf3fd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/3888064ae240d71282ecdabe2297edfa3cdc957349881895e812ed3e15fcb7d2" :answer/id #uuid "928a85ac-2175-55e1-8289-3f7714b6a18f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 0 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/8b0f588d508fe2df955cb1cd2f0927c4a51fcae6baa356c5cd1a18132cce5bbf" :answer/id #uuid "3254f5f5-d4ee-59f9-99d3-4da8cc500280" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/7334455e5748b828cae5e5e7cd464b929944a3710ce1cf4d3939a961fe07df3f" :answer/id #uuid "2985eccb-b56f-5c7c-af97-5fb1a0cb720e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 1 & 0 \\\\ 0 & -2 & 1 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/121ec07d03da902538ef3c0e5cdad4e9b8ea06458da20090917fbec157ca9b2a" :answer/id #uuid "ca812fec-5eb8-5112-bc4c-811b9e0789d3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 1 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892" :answer-field/id #uuid "3ed95f90-e206-599b-8f02-4b8e13f5a4b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/a8f495b34476a049d0a1594525832eb024f68fb3d4ab672588cf77399ac57cfd" "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/3888064ae240d71282ecdabe2297edfa3cdc957349881895e812ed3e15fcb7d2" "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/8b0f588d508fe2df955cb1cd2f0927c4a51fcae6baa356c5cd1a18132cce5bbf" "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/7334455e5748b828cae5e5e7cd464b929944a3710ce1cf4d3939a961fe07df3f" "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/121ec07d03da902538ef3c0e5cdad4e9b8ea06458da20090917fbec157ca9b2a"] :answer-field/correct "q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892/a8f495b34476a049d0a1594525832eb024f68fb3d4ab672588cf77399ac57cfd" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "d0e31f06-6711-501a-84f6-2cd9da1c46e9"] :question/problem "$$\nA=[\\begin{aligned}-2 & 0 & 0 \\\\ 3 & 1 & 3 \\\\ 3 & 3 & 1\\end{aligned}]\n$$\n\nThe matrix above has eigenvalues ${\\lambda }_{1}={\\lambda }_{2}=-2,$ and ${\\lambda }_{3}=4.$ Find a Jordan canonical form of the matrix." :question/worked-solution "Notice that we are given a $3\\times 3$ matrix with the following eigenvalues:\n\n- $\\lambda =-2$ of algebraic multiplicity $2$\n\n- $\\lambda =4$ of algebraic multiplicity $1$\n\nAs a result, we have one $1\\times 1$ Jordan block ${J}_{1}(4)$ corresponding to $\\lambda =4.$\nHowever, there are two possibilities for the Jordan blocks corresponding to $\\lambda =-2:$\n\n- *Case I.* We may get the single $2\\times 2$ Jordan block ${J}_{2}(-2).$ This happens when the generalized eigenvectors ${v}_{1}$ and ${v}_{2}$ corresponding to the eigenvalue $\\lambda =-2$ form the following chain:\n\n$$\n{v}_{2}\\overset{A+2I\\,}{\\to }{v}_{1}\\overset{A+2I\\,}{\\to }0\n$$\n\n- *Case II.* We may get a composition of two $1\\times 1$ Jordan blocks, namely ${J}_{1}(-2)\\,⊕\\,{J}_{1}(-2).$ This happens when the generalized eigenvectors ${v}_{1}$ and ${v}_{2}$ corresponding to the eigenvalue $\\lambda =-2$ form the following chains:\n\n$$\n\\begin{aligned}{v}_{1}\\overset{A+2I\\,}{\\to }0 &  \\\\ {v}_{2}\\overset{A+2I\\,}{\\to }0 & \\end{aligned}\n$$\n\nTo figure out which of the cases we obtain in this situation, let's find the number of linearly independent eigenvectors corresponding to $\\lambda =-2.$\n\nComputing $A+2I,$ we get\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}-2 & 0 & 0 \\\\ 3 & 1 & 3 \\\\ 3 & 3 & 1\\end{aligned}]+2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & 0 \\\\ 3 & 3 & 3 \\\\ 3 & 3 & 3\\end{aligned}].\\end{aligned}\n$$\n\nNow, we reduce this matrix to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}A+2I & =[\\begin{aligned}0 & 0 & 0 \\\\ 3 & 3 & 3 \\\\ 3 & 3 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{1}↔{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}3 & 3 & 3 \\\\ 0 & 0 & 0 \\\\ 3 & 3 & 3\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+(-1){R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}3 & 3 & 3 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSince $\\text{nullity}(A+2I)=2,$ there will be two eigenvectors that correspond to the eigenvalue $\\lambda =-2,$ say, ${v}_{1}$ and ${v}_{2}.$ So, the generalized eigenvectors corresponding to the eigenvalue $\\lambda =-2$ form the following chains: \n\n$$\n\\begin{aligned}{v}_{1}\\overset{A+2I\\,}{\\to }0 \\\\ {v}_{2}\\overset{A+2I\\,}{\\to }0\\end{aligned}\n$$\n\nTherefore, we have *case II*, and $A$ has the following Jordan canonical form:\n\n$$\n{J}_{1}(4)\\,⊕\\,{J}_{1}(-2)\\,⊕\\,{J}_{1}(-2)=[\\begin{aligned}4 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\n**Note:** The Jordan canonical form is unique up to the order of the Jordan blocks." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-109395/ma-source-field/40b18e7d2e05ac52bf79dc6e22c7ceebc334fdfed833446cf046937332ee8892"] :db/ensure [:question/validate]} {:db/id "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/8a236e501d52126cb889385f0d30f7b4cbfdb66163cbe8f1955e21cb3c620bed" :answer/id #uuid "7571298e-d143-52c5-8a71-2df55588cb75" :answer/type :answer.type/math :answer/value "-(3{t}^{2}+2)" :db/ensure [:answer/validate]} {:db/id "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/9909387cad715efd84810cbc3093a5f44d425ad2b050b39fa080445b6dbde394" :answer/id #uuid "ae9ed90b-7117-5937-8889-4116c30d453c" :answer/type :answer.type/math :answer/value "1-3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/d5ee214fc4ebdb964d67239e3da5811b7c787bb4ef47ec0ccbaa764f05d5fe99" :answer/id #uuid "aabfbbf3-e9be-54ea-9bf2-77eeebfa370d" :answer/type :answer.type/math :answer/value "3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/7a14e161b9701c2c1678a00df7b4ce39522df64ffff663ec5c1c7f84264bf6b6" :answer/id #uuid "47f6d5bf-dad6-561f-b2ae-e9864d44d8fe" :answer/type :answer.type/math :answer/value "3{t}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/7697b742b99d3fcc3812743ec3e07f8fd8e673d6fe459880d276020f3ffa1217" :answer/id #uuid "c7229bfb-a300-5998-a619-1f9803777e61" :answer/type :answer.type/math :answer/value "3{t}^{2}-4" :db/ensure [:answer/validate]} {:db/id "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79" :answer-field/id #uuid "efb92f1c-9bb7-5cc3-9d68-87a83b156926" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/8a236e501d52126cb889385f0d30f7b4cbfdb66163cbe8f1955e21cb3c620bed" "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/9909387cad715efd84810cbc3093a5f44d425ad2b050b39fa080445b6dbde394" "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/d5ee214fc4ebdb964d67239e3da5811b7c787bb4ef47ec0ccbaa764f05d5fe99" "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/7a14e161b9701c2c1678a00df7b4ce39522df64ffff663ec5c1c7f84264bf6b6" "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/7697b742b99d3fcc3812743ec3e07f8fd8e673d6fe459880d276020f3ffa1217"] :answer-field/correct "q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79/7697b742b99d3fcc3812743ec3e07f8fd8e673d6fe459880d276020f3ffa1217" :db/ensure [:answer-field/validate]} {:db/id "q-109695" :question/id #uuid "0737f5ff-3d66-5f51-b7b8-b8bf8fe97f67" :question/math-academy-id "q-109695" :question/problem "The third-order differential equation ${y}^{‴}+5{y}^{″}-3{t}^{2}{y}^{′}=0$\ncan be expressed as the matrix equation ${x}^{′}(t)=Ax(t),$ where \n\n$$\nx(t)=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}],\\,A=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & b \\\\ 0 & a & c\\end{aligned}],\n$$\n\nand for $y=y(t),$ we have\n\n$$\n{\\begin{aligned}y={x}_{1}(t) \\\\ {y}^{′}={x}_{2}(t) \\\\ {y}^{″}={x}_{3}(t).\\end{aligned}\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "We first need to express the given differential equation as a system of first-order differential equations. Then, we write the system as a matrix equation.\n\nWe start by making the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1} & =y \\\\ {x}_{2} & ={y}^{′} \\\\ {x}_{3} & ={y}^{″}\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′}={y}^{′} \\\\ {x}_{2}^{′}={y}^{″} \\\\ {x}_{3}^{′}={y}^{‴}\\end{aligned}\n$$\n\nwhich we can rewrite as\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={x}_{3}, \\\\ {x}_{3}^{′}={y}^{‴}.\\end{aligned}\n$$\n\nWe must now write the right-hand side of the last equation in terms of ${x}_{1},{x}_{2}$ and ${x}_{3}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{‴}),$ we obtain\n\n$$\n{y}^{‴}=-5{y}^{″}+3{t}^{2}{y}^{′}.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{‴}=-5{x}_{3}+3{t}^{2}{x}_{2}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}={x}_{3} \\\\ {x}_{3}^{′}=3{t}^{2}{x}_{2}-5{x}_{3}\\end{aligned}\n$$\n\nWe can represent this system as the matrix differential equation ${x}^{′}(t)=Ax(t)$ as follows:\n\n$$\n[\\begin{aligned}{x}_{1}^{′} \\\\ {x}_{2}^{′} \\\\ {x}_{3}^{′}\\end{aligned}]=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 3{t}^{2} & -5\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}].\n$$\n\nHence, $a=3{t}^{2},b=1,c=-5,$ and $a+b+c=3{t}^{2}-4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-109695/ma-source-field/d7bb4c829f43ac00f9bcf6f955f5be5da537085ef2904ea7bfd99e141b640a79"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7657ff9-3918-5080-b9a2-8f6a6d8b4fd9"] :knowledge-point/questions ["q-109695"] :db/ensure [:knowledge-point/validate]} {:db/id "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "56c51500-8cb8-5a36-bd12-a252536d69f4" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "f2d9458d-2fc2-511b-b168-546e5cb519aa" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "77926a28-0a64-59aa-a3c1-f068ea2f02ea" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3f68b8a2-4b66-562a-bdaf-d78b6dbee320" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "b1750a74-76be-58a5-93dc-9469638fc1d7" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef" :answer-field/id #uuid "e03dd41f-134c-570f-ba29-59c8bf53a6bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :answer-field/correct "q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :db/ensure [:answer-field/validate]} {:db/id "q-109696" :question/id #uuid "854fff95-597d-57db-aef7-0e595418f814" :question/math-academy-id "q-109696" :question/problem "The third-order differential equation ${y}^{‴}-3{y}^{′}+4y=0$\ncan be expressed as the matrix equation ${x}^{′}(t)=Ax(t),$ where \n\n$$\nx(t)=[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}],\\,A=[\\begin{aligned}0 & b & 0 \\\\ 0 & 0 & 1 \\\\ a & c & 0\\end{aligned}],\n$$\n\nand for $y=y(t),$ we have\n\n$$\n{\\begin{aligned}y={x}_{1}(t) \\\\ {y}^{′}={x}_{2}(t) \\\\ {y}^{″}={x}_{3}(t).\\end{aligned}\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "We first need to express the given differential equation as a system of first-order differential equations. Then, we write the system as a matrix equation.\n\nWe start by making the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1} & =y \\\\ {x}_{2} & ={y}^{′} \\\\ {x}_{3} & ={y}^{″}\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′}={y}^{′} \\\\ {x}_{2}^{′}={y}^{″} \\\\ {x}_{3}^{′}={y}^{‴}\\end{aligned}\n$$\n\nwhich we can rewrite as\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={x}_{3}, \\\\ {x}_{3}^{′}={y}^{‴}.\\end{aligned}\n$$\n\nWe must now write the right-hand side of the last equation in terms of ${x}_{1},{x}_{2}$ and ${x}_{3}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{‴}),$ we obtain\n\n$$\n{y}^{‴}=3{y}^{′}-4y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{‴}=3{x}_{2}-4{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}={x}_{3} \\\\ {x}_{3}^{′}=-4{x}_{1}+3{x}_{2}\\end{aligned}\n$$\n\nWe can represent this system as the matrix differential equation ${x}^{′}(t)=Ax(t)$ as follows:\n\n$$\n[\\begin{aligned}{x}_{1}^{′} \\\\ {x}_{2}^{′} \\\\ {x}_{3}^{′}\\end{aligned}]=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ -4 & 3 & 0\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}].\n$$\n\nHence, $a=-4,b=1,c=3,$ and $a+b+c=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-109696/ma-source-field/20dcc7fa31d8d2639d9169f0ebc13e24a0cb1b68df57143ff77c2778223277ef"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7657ff9-3918-5080-b9a2-8f6a6d8b4fd9"] :knowledge-point/questions ["q-109696"] :db/ensure [:knowledge-point/validate]} {:db/id "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/dd384871c0bc1fca475e51fa9975b2c7867938d8313eef675c9512786643a778" :answer/id #uuid "cdb64b6f-1b25-51d5-b7e0-ba9afd526ad9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/73c455d9cdcde966fc18a3b4156cfdc99e018c47d1a912eaf41f211595335433" :answer/id #uuid "c7927f9f-bfad-5eb3-aa99-90cba77fb4c6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/0973783224fad89690dd60a31c1e058a207df2bf2441de12ba5ac0b1c6524593" :answer/id #uuid "d532b568-40fd-5c42-bd50-9c531a27d8f0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/42382e0ba38584e07136c417a6bfd75787536e4723d00423e51dd04375f4ffe3" :answer/id #uuid "7be7d0d9-fe40-5825-a710-69d11c7d3940" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/57ccfa5e19bbc9dfcbcffafe40dca6e201deeb133889d79885922e7d578cb51a" :answer/id #uuid "0178b2e4-7a61-5504-922f-6c54eb1b2c87" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d" :answer-field/id #uuid "2dca7bc2-b356-50e5-bfa8-29c4a44dbc8a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/dd384871c0bc1fca475e51fa9975b2c7867938d8313eef675c9512786643a778" "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/73c455d9cdcde966fc18a3b4156cfdc99e018c47d1a912eaf41f211595335433" "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/0973783224fad89690dd60a31c1e058a207df2bf2441de12ba5ac0b1c6524593" "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/42382e0ba38584e07136c417a6bfd75787536e4723d00423e51dd04375f4ffe3" "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/57ccfa5e19bbc9dfcbcffafe40dca6e201deeb133889d79885922e7d578cb51a"] :answer-field/correct "q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/57ccfa5e19bbc9dfcbcffafe40dca6e201deeb133889d79885922e7d578cb51a" :db/ensure [:answer-field/validate]} {:db/id "q-109720" :question/id #uuid "8e6ff191-ba87-53ce-9025-284cccecf39d" :question/math-academy-id "q-109720" :question/problem "Which of the following is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =6$ for the matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}6 & 0 \\\\ -2 & 6\\end{aligned}]?\n$$" :question/worked-solution "Given a matrix $A$ with eigenvalue $\\lambda ,$ a generalized eigenvector of rank $k$ is a vector $v$ that satisfies\n\n$$\n(A-\\lambda I)^{k}v=0\\,\\text{and}\\,(A-\\lambda I)^{k-1}v\\ne 0.\n$$\n\nTo find a generalized eigenvector of rank $2$ corresponding to $\\lambda =6,$ we need to find a vector $v$ that satisfies\n\n$$\n(A-6I)^{2}v=0\\,\\text{and}\\,(A-6I)v\\ne 0.\n$$\n\nLet's consider each condition:\n\n- We start by solving $(A-6I)^{2}v=0.$ First, we have\n\n$$\nA-6I=[\\begin{aligned}0 & 0 \\\\ -2 & 0\\end{aligned}].\n$$\n\nComputing its square, we see that this matrix is nilpotent:\n\n$$\n(A-6I)^{2}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]\n$$\n\nThis means that *any* vector in ${R}^{2}$ is a solution to $(A-6I)^{2}v=0.$ Therefore, the solution to $(A-6I)^{2}v=0$ can be written as\n\n$$\n\\begin{aligned}v=[\\begin{aligned}{v}_{1} \\\\ {v}_{2}\\end{aligned}]={v}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{v}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we solve $(A-6I)v=0.$ We have\n\n$$\nA-6I=[\\begin{aligned}0 & 0 \\\\ -2 & 0\\end{aligned}]\\,.\n$$\n\nConverting this matrix to reduced row echelon form, we get\n\n$$\nA-6I∼[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nThis means that the solution to $(A-6I)v=0$ is ${v}_{1}=0,$ where ${v}_{2}$ is a free variable. Therefore, the solution to $(A-6I)v=0$ can be written as\n\n$$\n\\begin{aligned}v=[\\begin{aligned}{v}_{1} \\\\ {v}_{2}\\end{aligned}]=[\\begin{aligned}0 \\\\ {v}_{2}\\end{aligned}]={v}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nComparing our two solutions, we see that the vector $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ satisfies $(A-6I)^{2}v=0$ but does *not* satisfy $(A-6I)v=0.$  \n\nHence, $[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ is a generalized eigenvector of rank $2$ of $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-109720/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c1e72b8c-ae67-5344-93bc-3a6f89255514"] :knowledge-point/questions ["q-109720"] :db/ensure [:knowledge-point/validate]} {:db/id "q-109739/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/dd384871c0bc1fca475e51fa9975b2c7867938d8313eef675c9512786643a778" :answer/id #uuid "d62f0927-56c7-51d7-8bad-0389d2905e20" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109739/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/73c455d9cdcde966fc18a3b4156cfdc99e018c47d1a912eaf41f211595335433" :answer/id #uuid "0a16bd0a-f467-5ad6-93c8-62261785fdf8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109739/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/0973783224fad89690dd60a31c1e058a207df2bf2441de12ba5ac0b1c6524593" :answer/id #uuid "aee402a8-e25f-5f7d-a299-4a23b73ed1f5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109739/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/42382e0ba38584e07136c417a6bfd75787536e4723d00423e51dd04375f4ffe3" :answer/id #uuid "ad9bfac8-1d7c-5077-8a13-0b233ce0e476" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109739/ma-source-field/ea3da38a6510d87a426a8b794d6dbeefd9c9111c2d47be9ee96bb651b71a010d/57ccfa5e19bbc9dfcbcffafe40dca6e201deeb133889d79885922e7d578cb51a" :answer/id #uuid "dec6d280-d470-557d-a512-81311849870b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109