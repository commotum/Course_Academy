e709e0b3361e7f508e79d731cb4fd27b5" "q-113502/ma-source-field/9ecd37f5b7334b05c2ca95cc64f63754426e4cc7d8c79d7f0f72b6ce560ca8fa/862a60fa21b17f3de998a3ab1413d0bbb8b7f8af32d4495ac7c7a59c39236638" "q-113502/ma-source-field/9ecd37f5b7334b05c2ca95cc64f63754426e4cc7d8c79d7f0f72b6ce560ca8fa/5d7255b1e6d0ed12751dd0eb1f28e93112ef78b006a3e44c8c5c4d27e8897f24"] :answer-field/correct "q-113502/ma-source-field/9ecd37f5b7334b05c2ca95cc64f63754426e4cc7d8c79d7f0f72b6ce560ca8fa/0a193d250e974687a3d07c190e91ec5e709e0b3361e7f508e79d731cb4fd27b5" :db/ensure [:answer-field/validate]} {:db/id "q-113502" :question/id #uuid "201b1303-edfe-5a94-b70a-3687fd03d284" :question/math-academy-id "q-113502" :question/problem "$\\int 18(2-5x)^{5}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 18(2-5x)^{5}\\,\\text{d}x & =\\int 18{u}^{5}\\cdot (-\\frac{1}{5})\\text{d}u \\\\  & =18\\cdot (-\\frac{1}{5})\\int {u}^{5}\\cdot \\,\\text{d}u \\\\  & =-\\frac{18}{5}\\int {u}^{5}\\,\\text{d}u \\\\  & =-\\frac{18}{5}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{3}{5}{u}^{6}+C \\\\  & =-\\frac{3}{5}(2-5x)^{6}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{3}{5}(2-5x)^{6}+C] & =-\\frac{\\text{d}}{\\text{d}x}[\\frac{3}{5}(2-5x)^{6}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot \\frac{\\text{d}}{\\text{d}x}(2-5x)+0 \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot (-5) \\\\  & =18(2-5x)^{5}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113502/ma-source-field/9ecd37f5b7334b05c2ca95cc64f63754426e4cc7d8c79d7f0f72b6ce560ca8fa"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc"] :knowledge-point/questions ["q-113502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/89be4e31dfe89dd94565fe5047d41cbbb21418a044e9b9171f37281340066dd4" :answer/id #uuid "1e49762e-1e14-5248-8c9e-16a5e673bda1" :answer/type :answer.type/math :answer/value "-\\frac{1}{(x-2)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/dda3e580b25e46f679f5ba4d7ba3c62be541b831d1750b9462a6eb0c1a806b31" :answer/id #uuid "15a56691-9975-5ae2-aa7b-fda010fe63b8" :answer/type :answer.type/math :answer/value "-\\frac{1}{2(x-2)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/2a75f0c6db199f2c91d99be8720183630df97590f41c9846c1a804683d5c3de2" :answer/id #uuid "87bb5e34-8a7e-5077-9056-44171c31d68f" :answer/type :answer.type/math :answer/value "-\\frac{1}{2(x-2)^{4}}+C" :db/ensure [:answer/validate]} {:db/id "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/69c7eef1a5de02bd919c92675a8d47d3bbfaf3de4473ac2bdb8fcd4555069ba3" :answer/id #uuid "cfab3df7-4bb6-5eeb-9342-3841991827b8" :answer/type :answer.type/math :answer/value "-\\frac{2}{(x-2)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/492c68970b8f243405c9d3410b93d69a061d7c169e720cf482251d9443f3fb5a" :answer/id #uuid "73df82c1-76f6-50ea-99b9-53a33ba7607d" :answer/type :answer.type/math :answer/value "\\frac{1}{2(x-2)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834" :answer-field/id #uuid "c13dea0f-f218-5cd2-a503-c7b2250d51fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/89be4e31dfe89dd94565fe5047d41cbbb21418a044e9b9171f37281340066dd4" "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/dda3e580b25e46f679f5ba4d7ba3c62be541b831d1750b9462a6eb0c1a806b31" "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/2a75f0c6db199f2c91d99be8720183630df97590f41c9846c1a804683d5c3de2" "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/69c7eef1a5de02bd919c92675a8d47d3bbfaf3de4473ac2bdb8fcd4555069ba3" "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/492c68970b8f243405c9d3410b93d69a061d7c169e720cf482251d9443f3fb5a"] :answer-field/correct "q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834/dda3e580b25e46f679f5ba4d7ba3c62be541b831d1750b9462a6eb0c1a806b31" :db/ensure [:answer-field/validate]} {:db/id "q-113509" :question/id #uuid "1948aa2d-5fbb-59f5-8ccc-6dd9cfd6ef51" :question/math-academy-id "q-113509" :question/problem "Calculate the integral $\\int \\frac{1}{(x-2)^{3}}\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (x-2)^{-3}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (x-2)^{-3}\\,\\text{d}x & =\\int {u}^{-3}\\cdot \\text{d}u \\\\  & =-\\frac{1}{2}\\cdot {u}^{-2}+C \\\\  & =-\\frac{1}{2{u}^{2}}+C \\\\  & =-\\frac{1}{2(x-2)^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\frac{\\text{d}}{\\text{d}x}[(x-2)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\cdot (-2)\\cdot (x-2)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-2)+0 \\\\  & =1\\cdot \\frac{1}{(x-2)^{3}}\\cdot 1 \\\\  & =\\frac{1}{(x-2)^{3}}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-113509/ma-source-field/00dbe07a0315098aed073253ea0d3726ba1dfec194094fbee8d077c608b77834"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "387d85df-b839-5837-89b9-5e4bb4daa073"] :knowledge-point/questions ["q-113509"] :db/ensure [:knowledge-point/validate]} {:db/id "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/7a8cb8781b7337c5abb9b909d5c72db4e1ad89cb3c8f09eb627981c9b13f1570" :answer/id #uuid "199a03cb-71ce-557c-b3af-135bd3564f86" :answer/type :answer.type/math :answer/value "-\\frac{1}{10(9-5x)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/fc48b89f6ad649a6f762577e09dc4f79c622730b607c4d4a28596a9ee6257aed" :answer/id #uuid "51978e0d-c725-5111-8fd8-58bfe89fa4d2" :answer/type :answer.type/math :answer/value "-\\frac{1}{2(9-5x)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/6f0a2f22377c8633e137563df34be15dc43318bef68efcef571c2bb6fbb726b1" :answer/id #uuid "ae0f063f-eba9-55db-a617-104bbe47e493" :answer/type :answer.type/math :answer/value "-\\frac{1}{5(9-5x)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/b09e0311d1562959cfcaae070c8c54ed64d4936b514834c67b33c4d55605018b" :answer/id #uuid "418bd3f4-e4c0-5bc7-b4ac-5541696af9d9" :answer/type :answer.type/math :answer/value "\\frac{1}{10(9-5x)^{2}}+C" :db/ensure [:answer/validate]} {:db/id "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/656e46750f014406e1b4e634d98a6ea72995bc7ccb09f43f709f280b16939695" :answer/id #uuid "06f0d601-5b9e-5b34-b1e4-35332ff61132" :answer/type :answer.type/math :answer/value "\\frac{1}{20(9-5x)^{4}}+C" :db/ensure [:answer/validate]} {:db/id "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297" :answer-field/id #uuid "3b49b60e-8217-5844-bea9-fe48c12aaf25" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/7a8cb8781b7337c5abb9b909d5c72db4e1ad89cb3c8f09eb627981c9b13f1570" "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/fc48b89f6ad649a6f762577e09dc4f79c622730b607c4d4a28596a9ee6257aed" "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/6f0a2f22377c8633e137563df34be15dc43318bef68efcef571c2bb6fbb726b1" "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/b09e0311d1562959cfcaae070c8c54ed64d4936b514834c67b33c4d55605018b" "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/656e46750f014406e1b4e634d98a6ea72995bc7ccb09f43f709f280b16939695"] :answer-field/correct "q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297/b09e0311d1562959cfcaae070c8c54ed64d4936b514834c67b33c4d55605018b" :db/ensure [:answer-field/validate]} {:db/id "q-113517" :question/id #uuid "d34fadec-e1db-5f0e-b3fb-64f3326f1376" :question/math-academy-id "q-113517" :question/problem "$\\int \\frac{1}{(9-5x)^{3}}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (9-5x)^{-3}\\,\\text{d}x.\n$$\n\nLet $u=9-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (9-5x)^{-3}\\text{d}x & =\\int {u}^{-3}\\cdot (-\\frac{1}{5})\\,\\text{d}u \\\\  & =-\\frac{1}{5}\\int {u}^{-3}\\,\\text{d}u \\\\  & =-\\frac{1}{5}\\cdot (-\\frac{1}{2}){u}^{-2}+C \\\\  & =\\frac{1}{10{u}^{2}}+C \\\\  & =\\frac{1}{10(9-5x)^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{10(9-5x)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{10(9-5x)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\frac{\\text{d}}{\\text{d}x}[(9-5x)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\cdot (-2)(9-5x)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(9-5x)+0 \\\\  & =-\\frac{1}{5}(9-5x)^{-3}\\cdot (-5) \\\\  & =(9-5x)^{-3} \\\\  & =\\frac{1}{{(9-5x)}^{3}}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113517/ma-source-field/5ea5575ab7144816deb3ac46a291c44351cc9f1abd8ce993c9750bb0d159c297"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "387d85df-b839-5837-89b9-5e4bb4daa073"] :knowledge-point/questions ["q-113517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-115706/ma-source-field/6fa9c40795a81e1614ff035456d27cf9e743013c2b5a16ccf208fe8d02c1482f/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "c9bd5262-3c42-523a-8ed8-f13fd5baad53" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-115706/ma-source-field/6fa9c40795a81e1614ff035456d27cf9e743013c2b5a16ccf208fe8d02c1482f/b13ac151352392d38026eed