57a3041bc2adf1aae663cb57db7cb6b0f02ad35161"] :answer-field/correct "q-50202/ma-source-field/d54072a16f099b2b76723a2083a4b2545b899864f703a6aa1b916ab904356b56/2895e70e985f304ea1ed522fbf0ba33baccbbdbdb3df8da836a00be18dac334e" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "38244b69-b2ff-532d-ba91-ffcf585c5c43"] :question/problem "If ${F}^{′}(t)=⟨{e}^{t}-4,\\operatorname{sin}⁡t⟩$, then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨{e}^{t}-4,\\operatorname{sin}⁡t⟩\\,\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t}-4,\\,\\operatorname{sin}⁡t⟩\\,\\text{d}t & =⟨\\int ({e}^{t}-4)\\,\\text{d}t,\\,\\int \\operatorname{sin}⁡t\\,\\text{d}t⟩ \\\\  & =⟨{e}^{t}-4t+{c}_{1},\\,-\\operatorname{cos}⁡t+{c}_{2}⟩ \\\\  & =⟨{e}^{t}-4t,\\,-\\operatorname{cos}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{e}^{t}-4t,\\,-\\operatorname{cos}⁡t⟩+C,\\end{aligned}\n$$\n\n \n\nwhere $C$ is an arbitrary (vector) constant of integration." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-50202/ma-source-field/d54072a16f099b2b76723a2083a4b2545b899864f703a6aa1b916ab904356b56"] :db/ensure [:question/validate]} [:db/retract 17592186148143 :question/answer-fields 17592186146582] {:db/id "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/dbbf552523e2b77610b46f6166a507d489a7f8b41418bb6a5b457c01b27a7387" :answer/id #uuid "1c9883a3-e621-51df-8ff0-6226c6cc7a53" :answer/type :answer.type/math :answer/value "2\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/1404f3d3729d38c0a42f770c059db3dd2fc90c02f320711801f7e6cc341847b7" :answer/id #uuid "1c31bfae-7a2b-57b5-be88-9bba287cfa95" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/239a7b64b769c1c3759cd853548d8c1fefc47d45b5465d1c23d73ba1c47e14a6" :answer/id #uuid "35503e6a-2171-51db-a1b2-faac2bb3bbef" :answer/type :answer.type/math :answer/value "\\frac{2}{3}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/17a585f7e449097654e6203a1cecfc345eb0add5b0dd21896ece23319aa2c53b" :answer/id #uuid "887614ac-f9d9-5ee3-8657-1014ae4d97b4" :answer/type :answer.type/math :answer/value "\\frac{3}{2}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/ae4acecefd291bbb4c1267f64c71fe1373723e1ae6a91483805d82fa52cb9d25" :answer/id #uuid "062efcb7-7d81-5189-88be-46dade40919e" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48" :answer-field/id #uuid "1f8a8ed4-95f9-5ce5-8821-f45a9b7f474d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/dbbf552523e2b77610b46f6166a507d489a7f8b41418bb6a5b457c01b27a7387" "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/1404f3d3729d38c0a42f770c059db3dd2fc90c02f320711801f7e6cc341847b7" "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/239a7b64b769c1c3759cd853548d8c1fefc47d45b5465d1c23d73ba1c47e14a6" "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/17a585f7e449097654e6203a1cecfc345eb0add5b0dd21896ece23319aa2c53b" "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/ae4acecefd291bbb4c1267f64c71fe1373723e1ae6a91483805d82fa52cb9d25"] :answer-field/correct "q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48/239a7b64b769c1c3759cd853548d8c1fefc47d45b5465d1c23d73ba1c47e14a6" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "012482b3-0bd8-57c6-8936-9b9b3da520e7"] :question/problem "The position $y(t),$ measured in meters, of a particle oscillating with simple harmonic motion, is governed by the equation\n\n$$\n{y}^{″}+144y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with a velocity of $8\\,\\text{m/s},$ find the amplitude of the oscillation." :question/worked-solution "The simple harmonic motion (SHM) equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written as\n\n$$\ny=R\\operatorname{sin}⁡(\\omega t+ϕ),\n$$\n\nwhere $R$ is the amplitude, and $ϕ$ is the phase. In our case\n\n$$\n{\\omega }^{2}=144\\,⟹\\,\\omega =12.\n$$\n\nThus, we have\n\n$$\ny=R\\operatorname{sin}⁡(12t+ϕ).\n$$\n\nWe're given the initial condition $y(0)=0.$ Substituing this into the equation gives\n\n$$\nR\\operatorname{sin}⁡ϕ=0\\,⟹\\,ϕ=0.\n$$\n\nSo our general solution reduces to\n\n$$\ny=R\\operatorname{sin}⁡12t.\n$$\n\nWe're told that the velocity is $8\\,\\text{m/s}$ when $t=0,$ which means that ${y}^{′}(0)=8.$ Differentiating the general solution with respect to $t$ gives\n\n$$\n{y}^{′}=12R\\operatorname{cos}⁡12t.\n$$\n\nSubstituting ${y}^{′}(0)=8$ into the above gives\n\n$$\n8=12R\\,⟹\\,R=\\frac{2}{3}.\n$$\n\nTherefore, the amplitude is $\\frac{2}{3}\\,\\text{m}.$ The solution for $y(t)$ is\n\n$$\ny(t)=\\frac{2}{3}\\operatorname{sin}⁡12t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64254/ma-source-field/4ab251dde99b3fdf526a92acc9ff43f6587a62452968dcfa9e156f6dacbfac48"] :db/ensure [:question/validate]} [:db/retract 17592186125195 :question/answer-fields 17592186123740] {:db/id "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/38420f0fd0b8e5ce9c4a4980362ed70e347824687dfc4ebe436332b7105b8445" :answer/id #uuid "a68112ca-e7ee-5f12-8c6b-6f964b2fce64" :answer/type :answer.type/math :answer/value "-3\\,i+4j+2\\,k" :db/ensure [:answer/validate]} {:db/id "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/aca5e668c87c305c2230263813a26d094cb87557443d51ac4f40f552e83595ac" :answer/id #uuid "9e270cd2-2ed5-5ff9-a8d2-046b4683fe91" :answer/type :answer.type/math :answer/value "12\\,i+4j+3\\,k" :db/ensure [:answer/validate]} {:db/id "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/911090489a3d162b8876d5c70f82800c0aef2a43c8ec9314d13727d8884265bd" :answer/id #uuid "fc61dd7b-3fa9-5347-ad13-eae563990528" :answer/type :answer.type/math :answer/value "2\\,i-j+3\\,k" :db/ensure [:answer/validate]} {:db/id "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/fa127e2efc15a3212534578d8ab8b668d0b45aef3bd86743f40e30b4f261ab5e" :answer/id #uuid "12f59294-d897-5332-9fd4-6a0a58840be5" :answer/type :answer.type/math :answer/value "3\\,i-2j+6\\,k" :db/ensure [:answer/validate]} {:db/id "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/7f436f7c9f0500d761d2100945c95c4dd04e803f766760ce8d92ccee874c26f2" :answer/id #uuid "5739b0cd-fba7-5818-952f-616d15f8cd4f" :answer/type :answer.type/math :answer/value "\\,i-4j+3\\,k" :db/ensure [:answer/validate]} {:db/id "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a" :answer-field/id #uuid "027e0dd0-8fb0-53bb-95b9-27c1e0e20a6a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/38420f0fd0b8e5ce9c4a4980362ed70e347824687dfc4ebe436332b7105b8445" "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/aca5e668c87c305c2230263813a26d094cb87557443d51ac4f40f552e83595ac" "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/911090489a3d162b8876d5c70f82800c0aef2a43c8ec9314d13727d8884265bd" "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/fa127e2efc15a3212534578d8ab8b668d0b45aef3bd86743f40e30b4f261ab5e" "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/7f436f7c9f0500d761d2100945c95c4dd04e803f766760ce8d92ccee874c26f2"] :answer-field/correct "q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a/7f436f7c9f0500d761d2100945c95c4dd04e803f766760ce8d92ccee874c26f2" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "15fe86f3-62bf-5e0d-8567-00ad11df9f8d"] :question/problem "For the function $f(x,y,z)=x{y}^{2}-2yz+z$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-1,1)$ can be found by computing \n$∇f(1,-1,1).$ \n\nSo, we first find the gradient of $f(x,y,z)$  and evaluate it at $(x,y,z)=(1,-1,1):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-2yz+z)\\,i+\\frac{∂}{∂y}(x{y}^{2}-2yz+z)\\,j+\\frac{∂}{∂z}(x{y}^{2}-2yz+z)\\,k \\\\  & ={y}^{2}\\text{ }i+(2xy-2z)\\text{ }j+(-2y+1)\\text{ }k \\\\ ∇f(1,-1,1) & =(-1)^{2}\\,i+(2(1)(-1)-2(1))\\,j+(-2(-1)+1)\\,k \\\\  & =1\\,i-4j+3\\,k\\end{aligned}\n$$\n\n \n\nTherefore, $\\,i-4\\,j+3\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65167/ma-source-field/bd0bd465430c9fc38f9e982fe1ebf599f8de551efaed7eda46b0b241e600c04a"] :db/ensure [:question/validate]} [:db/retract 17592186184832 :question/answer-fields 17592186183571] {:db/id "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "0b461b10-efaf-5737-8be0-2296935fd388" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1304d7b1-7fd6-5fdd-8ab5-88b53194f932" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "f713561b-1443-55ab-a6f8-528c853237ff" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "35eebbf8-cb3d-55be-881a-6d4dee741c09" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "03399f19-3885-5f0b-a462-01f7b14158b2" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9" :answer-field/id #uuid "9a53e49d-1068-5089-bc50-b1b5ed69d2d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :answer-field/correct "q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "cf5f1258-fe1b-5b76-b089-dbb4191effcc"] :question/problem "![](images/10/10912ded2166eb7ae28ee81c2936f008bf14eb288ec95969b822dd138be509d8.png)\n\nThe graph above shows the function $y=\\operatorname{tan}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B+D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\pi -(-\\pi )=2\\pi .\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{tan}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n2\\pi =\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{2\\pi }=\\frac{1}{2}.\n$$\n\nThe parameter $D$ represents the vertical shift of the tangent function. We see that the function has been translated by $1$ unit up. Hence, $D=1.$\n\nTherefore, $B+D=\\frac{1}{2}+1=\\frac{3}{2}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{tan}⁡(\\frac{x}{2})+1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65448/ma-source-field/6f71d1c9b8dbf5d3555fa48656a59e73c362c4b95e538546b5bf2b84e2d284c9"] :db/ensure [:question/validate]} {:db/id "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/b01ba7e917b2f2dc3ff90ccb2c435764c9ebef2dea263cc318e0c231eb7eeb1d" :answer/id #uuid "1cfeda65-26b6-5502-a718-3aca8a4514b7" :answer/type :answer.type/math :answer/value "-\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/7627fb02fec1c7a865cb3e7797f7ea7835cb8ec3423f266885f8f5d01084e358" :answer/id #uuid "c00c5e3a-5697-52dc-aa31-3d95907996f7" :answer/type :answer.type/math :answer/value "-\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "f41004c5-d81d-5e7e-bb0b-5fc9c65c979d" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" :answer/id #uuid "919cc779-2edd-5c5e-b2ef-d5ab24d25505" :answer/type :answer.type/math :answer/value "\\frac{17}{4}" :db/ensure [:answer/validate]} {:db/id "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "4633095b-b665-59ce-aeaa-96dbb9f25eb3" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12" :answer-field/id #uuid "fd0dd138-ee92-58b5-a97c-038d65811dd6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/b01ba7e917b2f2dc3ff90ccb2c435764c9ebef2dea263cc318e0c231eb7eeb1d" "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/7627fb02fec1c7a865cb3e7797f7ea7835cb8ec3423f266885f8f5d01084e358" "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :answer-field/correct "q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" :db/ensure [:answer-field/validate]} {:db/id "q-65550" :question/id #uuid "2a31794b-90ed-5858-8a23-bda34267af75" :question/math-academy-id "q-65550" :question/problem "![](images/c9/c904a1eb628e726647a6f655a567a0939f7b7d404f0b32c6c4b4adaeca847916.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is $B-D?$" :question/worked-solution "The period $T$ of the function is\n\n$$\nT=\\frac{4\\pi }{5}.\n$$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{4\\pi }{5}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{4\\pi }{5})}=\\frac{5}{4}.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $3$ units down. Hence, $D=-3.$\n\nTherefore, $B-D=(\\frac{5}{4})-(-3)=\\frac{5}{4}+3=\\frac{17}{4}.$\n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(\\frac{5x}{4})-3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65550/ma-source-field/a5b07ec82de3372a37f99ccb4c5981202564ebef0541a1de91da3bf0b3313e12"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b"] :knowledge-point/questions ["q-65550"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/cc0bce14af6fdfda5f6bcaa5ac544017c5690924809b713d0ec3cc78db7d187a" :answer/id #uuid "e91811cd-e84f-5193-992b-8e19fb4b2fd7" :answer/type :answer.type/math :answer/value "3\\times 3" :db/ensure [:answer/validate]} {:db/id "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/32b576f4542317720bbdf1508d578b257b9189a9fa822416e84e9028addf8a12" :answer/id #uuid "b564fdb5-7bef-5c8d-bb5a-f31df9ccfc05" :answer/type :answer.type/math :answer/value "3\\times 6" :db/ensure [:answer/validate]} {:db/id "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/939f6ce3ff3240a846db7d304e9dc21fdc58f53d86a93fa0e742bf1683a9dd40" :answer/id #uuid "23d64532-8958-5da6-8df1-cb9fe4287a58" :answer/type :answer.type/math :answer/value "4\\times 6" :db/ensure [:answer/validate]} {:db/id "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/6d272c05c628e38d31fe472061086156c1e946dbf2578dfd17d34b85e5d02bd6" :answer/id #uuid "a5d45f5c-228f-58da-85c7-1c11eac34107" :answer/type :answer.type/math :answer/value "6\\times 4" :db/ensure [:answer/validate]} {:db/id "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/67e2f68495bf59024298cc5a843e3c22980b8438c9ec5b0733bc7ed8ce150777" :answer/id #uuid "47006db5-4174-5eb6-b810-c0e20d9e381d" :answer/type :answer.type/text :answer/value "The product is undefined" :db/ensure [:answer/validate]} {:db/id "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588" :answer-field/id #uuid "dbd50308-1094-5812-ac39-d5903b1dffda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/cc0bce14af6fdfda5f6bcaa5ac544017c5690924809b713d0ec3cc78db7d187a" "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/32b576f4542317720bbdf1508d578b257b9189a9fa822416e84e9028addf8a12" "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/939f6ce3ff3240a846db7d304e9dc21fdc58f53d86a93fa0e742bf1683a9dd40" "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/6d272c05c628e38d31fe472061086156c1e946dbf2578dfd17d34b85e5d02bd6" "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/67e2f68495bf59024298cc5a843e3c22980b8438c9ec5b0733bc7ed8ce150777"] :answer-field/correct "q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588/939f6ce3ff3240a846db7d304e9dc21fdc58f53d86a93fa0e742bf1683a9dd40" :db/ensure [:answer-field/validate]} {:db/id "q-70703" :question/id #uuid "10f06241-6aca-53ce-a0c6-b82287839cf2" :question/math-academy-id "q-70703" :question/problem "What are the dimensions of $ML$, if $M$ is a $4\\times 3$ matrix and $L$ is a $3\\times 6$ matrix?" :question/worked-solution "There are $3$ columns in $M$ and $3$ rows in $L.$ Since the number of columns in $M$ equals the number of rows in $L,$ the matrices $M$ and $L$ are conformable for multiplication, and $ML$ is a $4\\times 6$ matrix:\n\n$$\n{M}_{4\\times \\boxed{\\text{3}}}{\\times }_{✓}{L}_{\\boxed{\\text{3}}\\times 6}={ML}_{4\\times 6}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70703/ma-source-field/b6bc4ba00e03d9ab3f08d6b4d62d17bce476dd265aabd38afdb5f4b5a7323588"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce"] :knowledge-point/questions ["q-70703"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70743/ma-source-field/75dd49a6dc092b51eb4c34c98c54dd42296b0cc9a63b0a5f76343594f8f652d7/8e918182341451051ce2dca07cf