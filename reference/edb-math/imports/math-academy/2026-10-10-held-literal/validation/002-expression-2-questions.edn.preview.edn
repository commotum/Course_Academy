 =⟨-\\operatorname{cot}⁡t+{c}_{1},\\,-\\operatorname{cos}⁡t+{c}_{2}⟩ \\\\  & =⟨-\\operatorname{cot}⁡t,\\,-\\operatorname{cos}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-\\operatorname{cot}⁡t,\\,-\\operatorname{cos}⁡t⟩+C,\\end{aligned}\n$$\n\n \n\nwhere $C$ is an arbitrary (vector) constant of integration." 13194139533472 17592186045585 true] [17592186397990 1075 #edb/ref 17592186397991 13194139533472 17592186045585 true] [17592186397990 1075 #edb/ref 17592186397992 13194139533472 17592186045585 true] [17592186397990 1075 #edb/ref 17592186397993 13194139533472 17592186045585 true] [17592186397990 1075 #edb/ref 17592186397994 13194139533472 17592186045585 true] [17592186397990 1075 #edb/ref 17592186397995 13194139533472 17592186045585 true] [17592186397990 1076 #edb/ref 17592186045493 13194139533472 17592186045585 true] [17592186397990 1077 "selection" 13194139533472 17592186045585 true] [17592186397990 1079 #edb/ref 17592186397993 13194139533472 17592186045585 true] [17592186397990 1080 #uuid "64acc1de-28dc-54ce-adbc-dcf7bb04d3d9" 13194139533472 17592186045585 true] [17592186397991 1081 "⟨-\\operatorname{cot}⁡t,\\,{cos}^{2}⁡t⟩+C" 13194139533472 17592186045585 true] [17592186397991 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397991 1084 #uuid "a5a50cd8-428b-58d0-a480-7da1a3f92ab5" 13194139533472 17592186045585 true] [17592186397992 1081 "⟨-\\operatorname{tan}⁡t,\\,-\\operatorname{cos}⁡t⟩+C" 13194139533472 17592186045585 true] [17592186397992 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397992 1084 #uuid "755944bf-0315-57de-b5d7-7333349ddb7a" 13194139533472 17592186045585 true] [17592186397993 1081 "⟨-\\operatorname{cot}⁡t,\\,-\\operatorname{cos}⁡t⟩+C" 13194139533472 17592186045585 true] [17592186397993 1083 #edb/ref 17592186045499 13194139533472 17592186045585 true] [17592186397993 1084 #uuid "5c4a2e11-a04e-5177-8722-5ab93ed5a8c4" 13194139533472 17592186045585 true] [17592186397994 1081 "⟨-\\operatorname{csc}⁡t,\\,-\\