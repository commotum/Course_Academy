/ref 17592186116932}] :question/id #uuid "d6f9badf-44cd-56b4-946a-abae3220a5b7" :question/math-academy-id "q-13759" :question/problem "How can we best describe the following matrix?\n\n$A = \\begin{bmatrix}7 & 0 & 0 \\\\ 3 & -1 & 0 \\\\ 0 & 5 & 0\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186272286 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e35ad90-2f1b-5a63-97f8-d0ee68eca5d1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269398} {:answer/id #uuid "2fde21b2-4071-56ca-975f-426d92a1cb17" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269704} {:answer/id #uuid "752357c7-c757-545e-b673-5e6aef138895" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270310} {:answer/id #uuid "9758a9f8-4285-59af-9944-c703f3e02a1f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270604} {:answer/id #uuid "c828b14e-ea43-5244-865e-f22017cdf7a1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186271038}] :answer-field/correct {:answer/id #uuid "2fde21b2-4071-56ca-975f-426d92a1cb17" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269704} :answer-field/id #uuid "bbc92cb1-fc14-5bd0-a868-45afb00eeb79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271857}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34dfcc70-f55e-5b7a-a24a-4dbf1116a030" :question/math-academy-id "q-14144" :question/problem "For the polynomial $f(x)=3{x}^{8}-18{x}^{2}-33x-18,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-18,$ and its factors are $\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6,\\,\\pm 9$ and  $\\pm 18.$\n\n- The leading coefficient is $3,$ and its factors are $\\pm 1$ and $\\pm 3.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{3}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{3}, \\\\ \\pm \\frac{3}{1}, & \\pm \\frac{3}{3}, \\\\ \\pm \\frac{6}{1}, & \\pm \\frac{6}{3}, \\\\ \\pm \\frac{9}{1}, & \\pm \\frac{9}{3}, \\\\ \\pm \\frac{18}{1}, & \\pm \\frac{18}{3}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{3}, \\\\ \\pm 2, & \\pm \\frac{2}{3}, \\\\ \\pm 3, & \\pm 1, \\\\ \\pm 6, & \\pm 2, \\\\ \\pm 9, & \\pm 3, \\\\ \\pm 18, & \\pm 6.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{3},\\,\\pm \\frac{2}{3}\\,\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6,\\,\\pm 9,\\,\\pm 18.\n$$\n\nThis makes a total of $16$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 8=16.$)"}] [{:db/id #edb/ref 17592186198850 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab9b0b3f-b15e-5055-8391-6a00a8a6ab80" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3} \\cdot 2^{n}" :db/id #edb/ref 17592186196112} {:answer/id #uuid "cbfa0d86-cf70-5f60-9429-04161e