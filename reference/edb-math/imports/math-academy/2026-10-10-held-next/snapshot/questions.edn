 17592186155379} {:answer/id #uuid "7268eed5-cd68-5ed5-99a0-d0af2f4f1a2c" :answer/type {:db/ident :answer.type/math} :answer/value "L4" :db/id #edb/ref 17592186155380}] :answer-field/id #uuid "005e5191-da7d-5185-ac3c-67cc478128b1" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186155377}] :question/id #uuid "189a55f5-72ee-590d-b213-1f6bb96fbc77" :question/math-academy-id "q-334685" :question/problem "Consider the following statement.\n\n> If $f(x) = 3e^{2x} + 2x$, then $f = O(e^{2x})$ as $x → ∞$.\n\nA proof of the statement is given below\n\n> $L1:f = O(3e^{2x} + 2x)$\n> $L2:lim_(x → ∞)(\\frac{2x}{3e^{2x}}) = 0$\n> $L3:2x = O(3e^{2x})$\n> $L4:f = O(3e^{2x})$\n> $L5:f = O(e^{2x})$\n\nSelect the correct options to justify each step of the reasoning.\n\nLine $L1$ follows from {{field-1}}.\n\nLine $L4$ follows from lines\n{{field-2}} and\n{{field-3}}.\n\nLine $L5$ follows from line {{field-4}} and\n{{field-5}}."}] [{:db/id #edb/ref 17592186167254 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c9c2220-030e-5418-915c-e34d7962c077" :knowledge-point/title "Analyzing a Solution of the Lotka-Volterra Model Given the Phase Portrait"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90980cfd-c2a9-5638-b772-14f9a957f705" :answer/type {:db/ident :answer.type/text} :answer/value "decreases" :db/id #edb/ref 17592186164602} {:answer/id #uuid "1a92706f-1a2c-5944-b227-27df5e3ec74d" :answer/type {:db/ident :answer.type/text} :answer/value "increases" :db/id #edb/ref 17592186164603}] :answer-field/id #uuid "c0e771e7-f906-5919-9acb-50d46d1c60f0" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164601} {:answer-field/choices [{:answer/id #uuid "9bd7fc13-4be5-50a3-877b-3c4f8f830f14" :answer/type {:db/ident :answer.type/text} :answer/value "approaches" :db/id #edb/ref 17592186164605} {:answer/id #uuid "3332e3c3-22f4-5d10-9c69-31d83438ef41" :an