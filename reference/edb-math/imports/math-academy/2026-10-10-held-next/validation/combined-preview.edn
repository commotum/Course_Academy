3466 17592186045585 true] [17592186395835 1068 #edb/ref 17592186395836 13194139533466 17592186045585 true] [17592186395835 1069 "q-13912" 13194139533466 17592186045585 true] [17592186395835 1070 #edb/ref 17592186045487 13194139533466 17592186045585 true] [17592186395835 1071 "Find the radius of convergence $R$ and interval of convergence $I$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}}\\,.\n$$" 13194139533466 17592186045585 true] [17592186395835 1072 #uuid "4c54e973-6e64-50b6-b096-4b16776e42ab" 13194139533466 17592186045585 true] [17592186395835 1074 "To apply the ratio test we define ${a}_{n}=\\frac{(x-1)^{3n}}{{n}^{3}}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-1)^{3(n+1)}}{(n+1)^{3}}\\cdot \\frac{{n}^{3}}{(x-1)^{3n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{{n}^{3}(x-1)^{3}}{(n+1)^{3}}| \\\\  & =|x-1{|}^{3}{lim}_{n\\to \\infty }{(\\frac{n}{n+1})}^{3} \\\\  & =|x-1{|}^{3}\\cdot 1 \\\\  & =|x-1{|}^{3}\\end{aligned}\n$$\n\nThe series converges if $L<1.$ Therefore,\n\n$$\n\\begin{aligned}|x-1{|}^{3} & <1 \\\\ |x-1| & <1 \\\\ -1<x-1 & <1 \\\\ 0<x & <2.\\end{aligned}\n$$\n\nSo, the radius of convergence is $R=1,$ and the series converges for any $x$ that lies in the open interval $(0,2).$\n\nThe ratio test gives no conclusion about the convergence of the series when $L=1.$ So, when $|x-1|=1,$ we do not know if the series converges. This means that the endpoints $x=0$ and $x=2$ need to be investigated separately using another test for convergence.\n\n- When $x=0$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{3}} \\\\  & =-1+\\frac{1}{{2}^{3}}-\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the alternating series test.\n\n- When $x=2$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(2-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}} \\\\  & =1+\\frac{1}{{2}^{3}}+\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the $p$-series test.\n\nConsequently, the interval of convergence is $I=[0,2].$" 13194139533466 17592186045585 true] [17592186395836 1075 #edb/ref 17592186395837 13194139533466 17592186045585 true] [17592186395836 1075 #edb/ref 17592186395838 13194139533466 17592186045585 true] [17592186395836 1075 #edb/ref 17592186395839 13194139533466 17592186045585 true] [17592186395836 1075 #edb/ref 17592186395840 13194139533466 17592186045585 true] [17592186395836 1075 #edb/ref 17592186395841 13194139533466 17592186045585 true] [17592186395836 1076 #edb/ref 17592186045493 13194139533466 17592186045585 true] [17592186395836 1077 "selection" 13194139533466 17592186045585 true] [17592186395836 1079 #edb/ref 17592186395840 13194139533466 17592186045585 true] [17592186395836 1080 #uuid "bdf61ccf-2627-5fa3-a051-531ba920ddff" 13194139533466 17592186045585 true] [17592186395837 1081 "$R=1$ and  $I=(0,2]$" 13194139533466 17592186045585 true] [17592186395837 1083 #edb/ref 17592186045500 13194139533466 17592186045585 true] [17592186395837 1084 #uuid "71cb4bda-fc1e-5f5c-a387-81bc7f680311" 13194139533466 17592186045585 true] [17592186395838 1081 "$R=\\infty $ and  $I=(-\\infty ,\\infty )$" 13194139533466 17592186045585 true] [17592186395838 1083 #edb/ref 17592186045500 13194139533466 17592186045585 true] [17592186395838 1084 #uuid "c5872ac5-73b0-58bc-a4ce-df051df3c8ad" 13194139533466 17592186045585 true] [17592186395839 1081 "$R=1$ and  $I=[0,2)$" 13194139533466 17592186045585 true] [17592186395839 1083 #edb/ref 17592186045500 13194139533466 17592186045585 true] [17592186395839 1084 #uuid "de6804fa-3d4a-5001-8f45-18bc86c68bd6