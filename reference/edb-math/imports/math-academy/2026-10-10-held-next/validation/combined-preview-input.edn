3c962b2ec5dde7fab6512afacf6068205283833d787" :answer/id #uuid "8c8f3e39-d3c1-5e7f-a209-959cacdc0344" :answer/type :answer.type/math :answer/value "3\\operatorname{sinh}⁡(2(t-1))+\\operatorname{cosh}⁡(2(t-1))" :db/ensure [:answer/validate]} {:db/id "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/df1354f2032af6663a3df7a424f4f480b2f720204e0d4b8668d57f2f7b7ff5b9" :answer/id #uuid "b60dd011-c5bd-5d35-bf92-6b2b7e46ffc2" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(2(t-1))+3\\operatorname{cosh}⁡(2(t-1))" :db/ensure [:answer/validate]} {:db/id "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/0811206ed75759cb25d68a8d46c368c6825501a721435a81b8f938d9094229eb" :answer/id #uuid "110c49bf-db59-5807-8c76-e8a356cd26d1" :answer/type :answer.type/math :answer/value "\\operatorname{sinh}⁡(2(t-1))-3\\operatorname{cosh}⁡(2(t-1))" :db/ensure [:answer/validate]} {:db/id "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b" :answer-field/id #uuid "309e3e22-428f-58e4-8c8d-2ab6315d5bb2" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/choices ["q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/37a95eeb2cab5bccfcba30e95ce15c7f8d7c73e31245ff9aac7bd78cdb8b0313" "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/6793abc0bbd40457d7e993c962b2ec5dde7fab6512afacf6068205283833d787" "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/df1354f2032af6663a3df7a424f4f480b2f720204e0d4b8668d57f2f7b7ff5b9" "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/0811206ed75759cb25d68a8d46c368c6825501a721435a81b8f938d9094229eb"] :answer-field/correct "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b/6793abc0bbd40457d7e993c962b2ec5dde7fab6512afacf6068205283833d787" :db/ensure [:answer-field/validate]} {:db/id "q-334924" :question/id #uuid "e1bc76f0-5438-50ce-a2c1-3d7bf5ef80b4" :question/math-academy-id "q-334924" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}]x+[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}],\\,x(1)=[\\begin{aligned}3 \\\\ 1\\end{aligned}]\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}].$*\n\n| $x(t)=\\,\\,$ |  | $3\\operatorname{cosh}⁡(2(t-1))+\\operatorname{sinh}⁡(2(t-1))$ |  | $\\,\\,+{\\int }_{1}^{t}\\,\\,$ |  | {{field-1}} |  | $\\,\\,\\text{d}s$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-2}} |  |  | ${e}^{2s}\\operatorname{sinh}⁡(2(t-s))$ |  |  |  |  |" :question/worked-solution "Given the system ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as the sum of the homogeneous part and a particular solution:\n\n$$\nx(t)={{{e}^{A(t-{t}_{0})}\\,x({t}_{0})}_{⏟}}_{\\text{homogeneous part}}+{{{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s}_{⏟}}_{\\text{particular solution}},\n$$\n\nwhere $x({t}_{0})$ is the initial condition vector. \n\nLet's evaluate each part separately:\n\n- First, we find the homogeneous part. We are given that ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(2t) & \\operatorname{sinh}⁡(2t) \\\\ \\operatorname{sinh}⁡(2t) & \\operatorname{cosh}⁡(2t)\\end{aligned}].$ So,\n\n$$\n\\begin{aligned}{e}^{A(t-1)}\\,x(1) & =[\\begin{aligned}\\operatorname{cosh}⁡(2(t-1)) & \\operatorname{sinh}⁡(2(t-1)) \\\\ \\operatorname{sinh}⁡(2(t-1)) & \\operatorname{cosh}⁡(2(t-1))\\end{aligned}][\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3\\operatorname{cosh}⁡(2(t-1))+\\operatorname{sinh}⁡(2(t-1)) \\\\ 3\\operatorname{sinh}⁡(2(t-1))+\\operatorname{cosh}⁡(2(t-1))\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cosh}⁡(2(t-s)) & \\operatorname{sinh}⁡(2(t-s)) \\\\ \\operatorname{sinh}⁡(2(t-s)) & \\operatorname{cosh}⁡(2(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cosh}⁡(2(t-s)) & \\operatorname{sinh}⁡(2(t-s)) \\\\ \\operatorname{sinh}⁡(2(t-s)) & \\operatorname{cosh}⁡(2(t-s))\\end{aligned}][\\begin{aligned}{e}^{2s} \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{2s}\\operatorname{cosh}⁡(2(t-s)) \\\\ {e}^{2s}\\operatorname{sinh}⁡(2(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}3\\operatorname{cosh}⁡(2(t-1))+\\operatorname{sinh}⁡(2(t-1)) \\\\ 3\\operatorname{sinh}⁡(2(t-1))+\\operatorname{cosh}⁡(2(t-1))\\end{aligned}]+{\\int }_{1}^{t}[\\begin{aligned}{e}^{2s}\\operatorname{cosh}⁡(2(t-s)) \\\\ {e}^{2s}\\operatorname{sinh}⁡(2(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334924/ma-source-field/339271da1f138101a62f343dbea4c6c036fbcaa87693a6b4f8456723c6546447" "q-334924/ma-source-field/d2585eedb8b9fd9c1053d05d0ef3704672355f859dccfb3db30e0151f600827b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8"] :knowledge-point/questions ["q-334924"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334942/ma-source-field/3adeee9b055be9627e083e3b4f6bbfb12a239c6e56a1757a446660b8319a721a/a5cdea5168ae9bb2eb7863f2eedecc59eb80fc3e5f31e5d967a1e9a00bcca67a" :answer/id #uuid "bed3fb95-e63c-5cb4-9873-36c7021753ff" :answer/type :answer.type/math :answer/value "|\\begin{aligned}-\\pi  & 0 \\\\ 2 & 0\\end{aligned}|" :db/ensure [:answer/validate]} {:db/id "q-334942/ma-source-field/3adeee9b