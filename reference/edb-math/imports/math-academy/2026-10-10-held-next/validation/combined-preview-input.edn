er-fields 17592186102102] {:db/id "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/6ff1a1ab15ee1674e7b0f75a4562fdd47b69b2b904c572dfad95f708067b0b9e" :answer/id #uuid "8c271403-1e23-550b-9359-7ec7a8d9dd0b" :answer/type :answer.type/text :answer/value "A horizontal shear with a shear factor of $10$" :db/ensure [:answer/validate]} {:db/id "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/c8316283981d6f144f16f894c103c3a966e9af81b1b28d57cd93f02300f7599a" :answer/id #uuid "1e78af7e-059a-524f-9ce9-77e30b3e4934" :answer/type :answer.type/text :answer/value "A stretch of scale factor $10$ in the $x$-direction" :db/ensure [:answer/validate]} {:db/id "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/2673b4cd74cc10d0941e9b4be5582a9f10c7e5a8fe6de35a4bd7dda51f5780cd" :answer/id #uuid "1e0d6486-d718-528b-bd33-68b4cd544cdb" :answer/type :answer.type/text :answer/value "A stretch of scale factor $10$ in the $y$-direction" :db/ensure [:answer/validate]} {:db/id "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/3e6da98bd51d835a6b7427dd971b1d5be04f991920d144930a903c512d898699" :answer/id #uuid "2ec8852b-bfa4-53a1-8fe2-e8c75b78fa64" :answer/type :answer.type/text :answer/value "A vertical shear with a shear factor of $1$" :db/ensure [:answer/validate]} {:db/id "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/ee5d98675c45b56de742b4dfb3f04b04b3b1ecb4fa834ee78fa2a0f0edf4b847" :answer/id #uuid "db26a554-6026-5b02-9aa7-d6f9e0ad3b18" :answer/type :answer.type/text :answer/value "A vertical shear with a shear factor of $10$" :db/ensure [:answer/validate]} {:db/id "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255" :answer-field/id #uuid "e17cbcad-7731-506c-bd2a-44566af3416a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/6ff1a1ab15ee1674e7b0f75a4562fdd47b69b2b904c572dfad95f708067b0b9e" "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/c8316283981d6f144f16f894c103c3a966e9af81b1b28d57cd93f02300f7599a" "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/2673b4cd74cc10d0941e9b4be5582a9f10c7e5a8fe6de35a4bd7dda51f5780cd" "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/3e6da98bd51d835a6b7427dd971b1d5be04f991920d144930a903c512d898699" "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/ee5d98675c45b56de742b4dfb3f04b04b3b1ecb4fa834ee78fa2a0f0edf4b847"] :answer-field/correct "q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255/6ff1a1ab15ee1674e7b0f75a4562fdd47b69b2b904c572dfad95f708067b0b9e" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "6ec67f6b-b339-5863-9fd2-be6322d61819"] :question/problem "What linear transformation is represented by the following matrix\n$[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}]?$" :question/worked-solution "We can find the images of the standard basis vectors $i$ and $j$ under the action of  $T,$ as follows:\n\n$$\n\\begin{aligned}T(i) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ T(j) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}10 \\\\ 1\\end{aligned}]=10i+j\\end{aligned}\n$$\n\nTherefore, the matrix represents a *horizontal* shear with a shear factor of $10.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255"] :db/ensure [:question/validate]} {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/72fd1f0079d054315a89de1a806511a99edf60de21f2577cbc2dfa13c97964c5" :answer/id #uuid "229bdc3a-27fc-56da-aa6a-896f13040c5d" :answer/type :answer.type/text :answer/value "$A$ and $B$ are mutually exclusive events, since $P(A\\cap B)=0$" :db/ensure [:answer/validate]} {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/9fb5c612ee365ea61ce6f134c95ae853f67289ad9f707d5c163f9eafe471bb65" :answer/id #uuid "5fb8d3e3-cdce-512d-ad4f-36dcf03d5780" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)<P(A\\cup B)$" :db/ensure [:answer/validate]} {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/0061b50a1bd801002aefb7fcd79da6338d0e8284ab98965d23896361b15e0c35" :answer/id #uuid "6482f0f2-1c1d-5fea-a1fb-3579ff2c32b4" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)\\ne P(A\\cup B)$" :db/ensure [:answer/validate]} {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/fd78638e3bc30d2e897905460d8513d277f3f3c07109a4384279262d8a838492" :answer/id #uuid "4c73addd-4987-575f-af08-f65362be8bdf" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\ne P(B)$" :db/ensure [:answer/validate]} {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/adb82c8e48b920522dec6825f8ed26c41c791120cdcc513e1721071259b292ed" :answer/id #uuid "909efe4d-2b15-56ed-93cf-072fb3e590e0" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A\\cap B)\\ne 0$" :db/ensure [:answer/validate]} {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d" :answer-field/id #uuid "50eb031e-ead1-553b-9ace-42643ea8d178" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/72fd1f0079d054315a89de1a806511a99edf60de21f2577cbc2dfa13c97964c5" "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/9fb5c612ee365ea61ce6f134c95ae853f67289ad9f707d5c163f9eafe471bb65" "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/0061b50a1bd801002aefb7fcd79da6338d0e8284ab98965d23896361b15e0c35" "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/fd78638e3bc30d2e897905460d8513d277f3f3c07109a4384279262d8a838492" "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/adb82c8e48b920522dec6825f8ed26c41c791120cdcc513e1721071259b292ed"] :answer-field/correct "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/adb82c8e48b920522dec6825f8ed26c41c791120cdcc513e1721071259b292ed" :db/ensure [:answer-field/validate]} {:db/id "q-12549" :question/id #uuid "d5829032-59a0-5111-b1d8-47c7a5a05911" :question/math-academy-id "q-12549" :question/problem "Given $P(A)=0.25$, $P(B)=0.75$, $P(A\\cup B)=0.8$, determine whether  $A$ and $B$ are mutually exclusive events." :question/worked-solution "To check if $A$ and $B$ are mutually exclusive, we must check that $P(A\\cap B)=0.$\n\nWe can calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.8 & =0.25+0.75-P(A\\cap B) \\\\ P(A\\cap B) & =0.25+0.75-0.8 \\\\  & =0.2\\ne 0.\\,\\times \\end{aligned}\n$$\n\nTherefore, $A$ and $B$ are not mutually exclusive events." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65bec174-0235-5a32-a0d2-