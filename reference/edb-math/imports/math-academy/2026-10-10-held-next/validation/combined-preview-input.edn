f75ad83ea6187e934622856ecd610f920418ca" :answer-field/id #uuid "4259dafc-1a37-55ff-aa39-09cc98e980bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca/02684cbc3cb9cf19534614add5c44dcac0f8c90699569d5cb05d9b21dc74178b" "q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca/354549e05d30f5acb6c9a5e876a1b220679b1daee3381277145bd16fe273c514" "q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca/83351679bef40cdde3e69e55c2c6f08222a317ed82557f1e3ec0abdce5a513f4" "q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca/7fa603eaeff54701c0d44670b8ee09b596de6f8708827eb6deb18e39238c5ef7" "q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca/6913df9b151f2261420536f52f0de81cdd0d2e27ea8c5c83cbd8846242d77d1b"] :answer-field/correct "q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca/7fa603eaeff54701c0d44670b8ee09b596de6f8708827eb6deb18e39238c5ef7" :db/ensure [:answer-field/validate]} {:db/id "q-8060" :question/id #uuid "e53a5dab-4c76-5167-b8bb-303aab059a57" :question/math-academy-id "q-8060" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}]?$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors, as shown below. \n\n![](images/9e/9e322e6ed1ddb8f1d094633e931cd179b7eb9d6f47acd7c7d0809f113df91b22.png)\n\nNow, we compute the images of ${i,j}$ under $T$, as follows:\n\n$$\n\\begin{aligned}{i}^{′} & =T(i)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =T(j)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following image:\n\n![](images/4a/4a83673a409fd2e5d33b0b5f743f57af08cfb27c38e312a636179102c2172b04.png)\n\nTherefore, the matrix represents a reflection in the line $y=-x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8060/ma-source-field/c6c4c324748e06fe987c447f41f75ad83ea6187e934622856ecd610f920418ca"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c"] :knowledge-point/questions ["q-8060"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186088423 :question/answer-fields 17592186087161] {:db/id "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "8a2fc306-e79b-5a44-8145-c511e597d027" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "9017ed40-b00d-55a3-877f-c3d4b075da7d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "f9010786-eb95-569b-8bf6-50b7c4d11251" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "8b5eb027-48d1-5f9c-9af9-618b997023bf" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "e2a1da3a-abde-5c78-94f6-9beb1ca8472a" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc" :answer-field/id #uuid "169533db-26aa-5a83-a7a7-fa42593fd137" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25"] :answer-field/correct "q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "a9a96319-3bb3-5dd4-a3ac-27f5effab07d"] :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}y \\\\ x\\end{aligned}].$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}ky \\\\ kx\\end{aligned}] \\\\  & =k[\\begin{aligned}y \\\\ x\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{y}_{1}+{y}_{2} \\\\ {x}_{1}+{x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{y}_{1} \\\\ {x}_{1}\\end{aligned}]+[\\begin{aligned}{y}_{2} \\\\ {x}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8331/ma-source-field/b5576dd195defd6552aec68c0a2f8b9d2abda4581287781e7beca3488a97d9cc"] :db/ensure [:question/validate]} {:db/id "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/66620fa72116de6a1c7ab974b1747da9d5a3faa176b3e70f5dbff40b02f28c46" :answer/id #uuid "f9c3d72a-e3e2-5b15-805c-281c715443c5" :answer/type :answer.type/text :answer/value "$p=-4$, $q=-6$" :db/ensure [:answer/validate]} {:db/id "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/e2414c0eedc98b5ddf0526a5a5461d85c31868762acd5a918929adede443679b" :answer/id #uuid "8040e082-5a53-57e6-970d-918d3f7e5a59" :answer/type :answer.type/text :answer/value "$p=-6$, $q=-4$" :db/ensure [:answer/validate]} {:db/id "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/68c547c61926f6e7e2c2fb2bf91ef4aa27f3f24962288287be282e2eac931ef4" :answer/id #uuid "a89a7c87-829a-57da-9854-e45cadac30dc" :answer/type :answer.type/text :answer/value "$p=2$, $q=-3$" :db/ensure [:answer/validate]} {:db/id "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/46c42ada6abcb41716851769cb8fc1f8b3012e31f1b8a5641539378cd1189aeb" :answer/id #uuid "ea8dceb1-70ef-5b3f-9be1-4054c67c27ad" :answer/type :answer.type/text :answer/value "$p=4$, $q=-6$" :db/ensure [:answer/validate]} {:db/id "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/ac77b90d982717a466fd3673d0e6b4c5c21c47b766409480ad16aa3e59d434b8" :answer/id #uuid "9e2b3abe-1bd5-54fd-969d-0ed12647e9f2" :answer/type :answer.type/text :answer/value "$p=6$, $q=-4$" :db/ensure [:answer/validate]} {:db/id "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2" :answer-field/id #uuid "a244a31a-a197-5f00-a4e9-0789e9701cad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/66620fa72116de6a1c7ab974b1747da9d5a3faa176b3e70f5dbff40b02f28c46" "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/e2414c0eedc98b5ddf0526a5a5461d85c31868762acd5a918929adede443679b" "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/68c547c61926f6e7e2c2fb2bf91ef4aa27f3f24962288287be282e2eac931ef4" "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/46c42ada6abcb41716851769cb8fc1f8b3012e31f1b8a5641539378cd1189aeb" "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/ac77b90d982717a466fd3673d0e6b4c5c21c47b766409480ad16aa3e59d434b8"] :answer-field/correct "q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2/46c42ada6abcb41716851769cb8fc1f8b3012e31f1b8a5641539378cd1189aeb" :db/ensure [:answer-field/validate]} {:db/id "q-8408" :question/id #uuid "216ae57a-81ed-5f5e-b145-ffbb67f1cde3" :question/math-academy-id "q-8408" :question/problem "Given that $-3-2\\text{i}=\\frac{p+\\text{i}q}{2\\text{i}}$, calculate $p$ and $q.$" :question/worked-solution "First, we multiply both sides of the equation by $2\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}-3-2\\text{i} & =\\frac{p+\\text{i}q}{2\\text{i}} \\\\ 2\\text{i}(-3-2\\text{i}) & =p+\\text{i}q \\\\ -6\\text{i}-4{\\text{i}}^{2} & =p+\\text{i}q \\\\ 4-6\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n4=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}-6 & =q.\\end{aligned}\n$$\n\nTherefore, $p=4$ and $q=-6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8408/ma-source-field/c4461c031b3f6fc5ab5a378c6f3d64aea4d8c3bd3d324284778ca07689d0a9c2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d"] :knowledge-point/questions ["q-8408"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8460/ma-source-field/bbbccff7f695aae58a3ead4cb8c4a8c2b3773c8140a42615be74b4f6994e4a39/309fd678c4f2009dfa7ad16dc13f67a173c0d6ff78c5fa684e5969f2927d9235" :answer/id #uuid "03144c06-7ea7-5356-984b-d27469d4030d" :answer/type :answer.type/text :answer/value "A rotation of $\\frac{5\\pi }{6}$ radians counterclockwise about the origin." :db/ensure [:answer/validate]} {:db/id "q-8460/ma-source-field/bbbccff7f695aae58a3ead4cb8c4a8c2b3773c8140a42615be74b4f6994e4a39/e0b5c330f193506986cafc5a146aca7a001afb9b9ce56ab0831626a2b5837a08" :answer/id #uuid "51d074ff-dd81-5b0a-b60b-15fa779ff015" :answer/type 