ca9b7c-358a-5f62-9a53-a696df0dd0ff"] :knowledge-point/questions ["q-13781"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/ece93812d967d1ec58816d96e6d73871693d020c19dc84b6c8dd4b513b275ffc" :answer/id #uuid "f635175f-1efc-5299-8c7e-5584974b36e7" :answer/type :answer.type/text :answer/value "$R=1$ and  $I=(0,2)$" :db/ensure [:answer/validate]} {:db/id "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/0a45858a305cf09d88b27c471e82d061648635fb6f2c04290610fda5f5a0ad2e" :answer/id #uuid "71cb4bda-fc1e-5f5c-a387-81bc7f680311" :answer/type :answer.type/text :answer/value "$R=1$ and  $I=(0,2]$" :db/ensure [:answer/validate]} {:db/id "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/dff6684862eb71c7b1b3e3b98f09294701a43d9ad50fc4a2dcac9d83238357bd" :answer/id #uuid "de6804fa-3d4a-5001-8f45-18bc86c68bd6" :answer/type :answer.type/text :answer/value "$R=1$ and  $I=[0,2)$" :db/ensure [:answer/validate]} {:db/id "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/e8e8c01b4c5259494051f2189be4b864c55e93e2b4aa9483952a548d0413e010" :answer/id #uuid "a52347ba-5949-5d61-b02a-567dd46a130d" :answer/type :answer.type/text :answer/value "$R=1$ and  $I=[0,2]$" :db/ensure [:answer/validate]} {:db/id "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/4cda7cd783e807714ba39243be65ad5faf7b14b0d6fc1549301bd76f413138ad" :answer/id #uuid "c5872ac5-73b0-58bc-a4ce-df051df3c8ad" :answer/type :answer.type/text :answer/value "$R=\\infty $ and  $I=(-\\infty ,\\infty )$" :db/ensure [:answer/validate]} {:db/id "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824" :answer-field/id #uuid "bdf61ccf-2627-5fa3-a051-531ba920ddff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/ece93812d967d1ec58816d96e6d73871693d020c19dc84b6c8dd4b513b275ffc" "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/0a45858a305cf09d88b27c471e82d061648635fb6f2c04290610fda5f5a0ad2e" "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/dff6684862eb71c7b1b3e3b98f09294701a43d9ad50fc4a2dcac9d83238357bd" "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/e8e8c01b4c5259494051f2189be4b864c55e93e2b4aa9483952a548d0413e010" "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/4cda7cd783e807714ba39243be65ad5faf7b14b0d6fc1549301bd76f413138ad"] :answer-field/correct "q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824/e8e8c01b4c5259494051f2189be4b864c55e93e2b4aa9483952a548d0413e010" :db/ensure [:answer-field/validate]} {:db/id "q-13912" :question/id #uuid "4c54e973-6e64-50b6-b096-4b16776e42ab" :question/math-academy-id "q-13912" :question/problem "Find the radius of convergence $R$ and interval of convergence $I$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}}\\,.\n$$" :question/worked-solution "To apply the ratio test we define ${a}_{n}=\\frac{(x-1)^{3n}}{{n}^{3}}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-1)^{3(n+1)}}{(n+1)^{3}}\\cdot \\frac{{n}^{3}}{(x-1)^{3n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{{n}^{3}(x-1)^{3}}{(n+1)^{3}}| \\\\  & =|x-1{|}^{3}{lim}_{n\\to \\infty }{(\\frac{n}{n+1})}^{3} \\\\  & =|x-1{|}^{3}\\cdot 1 \\\\  & =|x-1{|}^{3}\\end{aligned}\n$$\n\nThe series converges if $L<1.$ Therefore,\n\n$$\n\\begin{aligned}|x-1{|}^{3} & <1 \\\\ |x-1| & <1 \\\\ -1<x-1 & <1 \\\\ 0<x & <2.\\end{aligned}\n$$\n\nSo, the radius of convergence is $R=1,$ and the series converges for any $x$ that lies in the open interval $(0,2).$\n\nThe ratio test gives no conclusion about the convergence of the series when $L=1.$ So, when $|x-1|=1,$ we do not know if the series converges. This means that the endpoints $x=0$ and $x=2$ need to be investigated separately using another test for convergence.\n\n- When $x=0$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{3}} \\\\  & =-1+\\frac{1}{{2}^{3}}-\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the alternating series test.\n\n- When $x=2$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(2-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}} \\\\  & =1+\\frac{1}{{2}^{3}}+\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the $p$-series test.\n\nConsequently, the interval of convergence is $I=[0,2].$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-13912/ma-source-field/c0aa44f7059b30acd1f66b0a80a3a5293582021a5cc1d9c2ac04624e3f21a824"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bfc0d9e1-bce1-5d62-b3c8-f7d7bb226497"] :knowledge-point/questions ["q-13912"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/8661436cfd746f4b60cd5691f6ee5f8a7b3f9f18a1f8541065c1a58346bad80d" :answer/id #uuid "ae0d6ea0-c5ed-5e7f-9687-ab98aef0c28b" :answer/type :answer.type/text :answer/value "$7$ and $-1$" :db/ensure [:answer/validate]} {:db/id "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/f05e363b4806ff9170bffb969ac17a278512549bf0f5a380a1917fe4214fff42" :answer/id #uuid "950ec668-d2b7-5d89-8e4f-1d349b1209a4" :answer/type :answer.type/text :answer/value "$7$ and $-2$" :db/ensure [:answer/validate]} {:db/id "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/4836b28dd052c2d7da63abac5ad842fb7a92dc6fee04b4c2c148f88419b7c81a" :answer/id #uuid "fbcf88a3-1e20-5a4c-bb86-1fe1bdaa1963" :answer/type :answer.type/text :answer/value "$8$ and $-1$" :db/ensure [:answer/validate]} {:db/id "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/faec1baa4968c88a7613e14a58575a631b79203d9aee2bbfdbbd42fbdd23d23b" :answer/id #uuid "2789771c-579f-5375-8680-854defcdf4d4" :answer/type :answer.type/text :answer/value "$8$ and $-3$" :db/ensure [:answer/validate]} {:db/id "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/c5564736bf65a0aea6d4e1707a2d0a41d80abe542754349572e910163901aa31" :answer/id #uuid "c4dc7a4e-aacb-5122-89ac-d5eb5d04a7da" :answer/type :answer.type/text :answer/value "$9$ and $-2$" :db/ensure [:answer/validate]} {:db/id "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d" :answer-field/id #uuid "1984d219-413d-5333-ac39-1acd7d9d0ec5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/8661436cfd746f4b60cd5691f6ee5f8a7b3f9f18a1f8541065c1a58346bad80d" "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/f05e363b4806ff9170bffb969ac17a278512549bf0f5a380a1917fe4214fff42" "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/4836b28dd052c2d7da63abac5ad842fb7a92dc6fee04b4c2c148f88419b7c81a" "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/faec1baa4968c88a7613e14a58575a631b79203d9aee2bbfdbbd42fbdd23d23b" "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/c5564736bf65a0aea6d4e1707a2d0a41d80abe542754349572e910163901aa31"] :answer-field/correct "q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d/8661436cfd746f4b60cd5691f6ee5f8a7b3f9f18a1f8541065c1a58346bad80d" :db/ensure [:answer-field/validate]} {:db/id "q-14050" :question/id #uuid "1270303e-0109-58be-ac65-6aecbfb8540f" :question/math-academy-id "q-14050" :question/problem "![](images/04/0470661491c0d9d44ecbbc3c87af70d4ff334f1ffd2ca56b68bd4c126f3d88de.png)\n\nWhat are the $x$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(3,-4)$ and passes through the point $(0,-\\frac{7}{4}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(3,-4)$ into the above gives\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+4).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,-\\frac{7}{4}),$ we substitute $x=0$ and $y=-\\frac{7}{4}$ into the equation and get\n\n$$\n\\begin{aligned}(0-3)^{2} & =4p(-\\frac{7}{4}+4) \\\\ 9 & =4p(\\frac{9}{4}) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(y+4).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(0+4) \\\\ (x-3)^{2} & =16 \\\\ x-3 & =\\pm 4 \\\\ x & =\\pm 4+3\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $7$ and $-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-14050/ma-source-field/5148a59791bd699980ea639858cd0bffa3600b3f1172732047cc5d892635725d"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8c990d69-54da-5541-948f-0d5eff96feb5"] :knowledge-point/questions ["q-14050"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/aab1ad9ce321e6a6425295ccc726ed413e7f7f2637636c7d12fc5a2d89502fb5" :answer/id #uuid "bef389b0-e3ae-5a1a-8b87-cc5f8f7fe4f4" :answer/type :answer.type/text :answer/value "$1$ and $6$" :db/ensure [:answer/validate]} {:db/id "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/eb5a589b8fd8c810abfb0163c31d726a4360dee898585e447ee275649d40105e" :answer/id #uuid "f30933e4-e411-5b64-94cc-db4bc0952b99" :answer/type :answer.type/text :answer/value "$1$ and $7$" :db/ensure [:answer/validate]} {:db/id "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/7a8a4a2a5bacf349af12b1dfa4cdf0eff32871c3c2fab8b03119314869f88d1d" :answer/id #uuid "327b2ad5-797c-54cc-89ed-97281f8970bc" :answer/type :answer.type/text :answer/value "$2$ and $6$" :db/ensure [:answer/validate]} {:db/id "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/36a80e34ea956915fe307f304767a10300947e44666f1b86d04fb9e41ad06177" :answer/id #uuid "9aad8bda-3338-5a30-9437-cc3702c58311" :answer/type :answer.type/text :answer/value "$2$ and $7$" :db/ensure [:answer/validate]} {:db/id "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/cecc18c19de4b1bd11a599ed59a34f3e239ca5d95fbfc5b1cc03befe0ee83f0d" :answer/id #uuid "16f5c998-e55d-56ad-a2e1-414b9c779c8d" :answer/type :answer.type/text :answer/value "$3$ and $5$" :db/ensure [:answer/validate]} {:db/id "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b" :answer-field/id #uuid "402f8b77-e682-57ca-9212-0a3e5c1ad08a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/aab1ad9ce321e6a6425295ccc726ed413e7f7f2637636c7d12fc5a2d89502fb5" "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/eb5a589b8fd8c810abfb0163c31d726a4360dee898585e447ee275649d40105e" "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/7a8a4a2a5bacf349af12b1dfa4cdf0eff32871c3c2fab8b03119314869f88d1d" "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/36a80e34ea956915fe307f304767a10300947e44666f1b86d04fb9e41ad06177" "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/cecc18c19de4b1bd11a599ed59a34f3e239ca5d95fbfc5b1cc03befe0ee83f0d"] :answer-field/correct "q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b/7a8a4a2a5bacf349af12b1dfa4cdf0eff32871c3c2fab8b03119314869f88d1d" :db/ensure [:answer-field/validate]} {:db/id "q-14241" :question/id #uuid "0ecc876e-1e30-5d04-b02b-e0d45341e6f7" :question/math-academy-id "q-14241" :question/problem "![](images/9b/9b7acbd4f24b6bbd20dd00fc042405324c069d28db0102c2cd7dd49e6b3bbccd.png)\n\nWhat are the $y$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(2,4)$ and passes through the point $(-6,8).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(2,4)$ into the above gives\n\n$$\n(y-4)^{2}=4p(x-2).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-6,8),$ we substitute $x=-6$ and $y=8$ into the equation and get\n\n$$\n\\begin{aligned}(8-4)^{2} & =4p(-6-2) \\\\ 16 & =4p(-8) \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-4)^{2} & =-2(x-2).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =-2(0-2) \\\\ (y-4)^{2} & =4 \\\\ y-4 & =\\pm 2 \\\\ y & =\\pm 2+4 \\\\ y & =2,6\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $2$ and  $6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-14241/ma-source-field/8af9dbb754481b9f3422b0b7b575130b79bcfeb68748fad4598e9c211645ce4b"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8"] :knowledge-point/questions ["q-14241"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/1ba85811e5b4e050216c0b99b2ae2731e957a6a9a066fbef01dc7b1402227539" :answer/id #uuid "e2fe06dc-0609-5053-9367-73d7ebf2fcb3" :answer/type :answer.type/text :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/46061bd04bf456df37808afdf7886153bbe607701266ae847b70835caf1e39dc" :answer/id #uuid "3f353887-7ced-5107-882a-0276e72dd462" :answer/type :answer.type/text :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/fad0557b96a306da4fddf20b98ae1fd6d926dcda25808e2bf4899503d630643d" :answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type :answer.type/text :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/ensure [:answer/validate]} {:db/id "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/54beee3030306d84a0ced8aa47140b1bd1638c8232475094333c6fc09378baeb" :answer/id #uuid "d0c03ddb-5aef-510c-adf3-fa2a8970e245" :answer/type :answer.type/text :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/ensure [:answer/validate]} {:db/id "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/8e4d6e1fdb76c00dc4ee2e08f8450be8d2de379e6162d57af6b42295c23c6faf" :answer/id #uuid "ef5518f9-14b3-5d56-ae49-14acc285d236" :answer/type :answer.type/text :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/ensure [:answer/validate]} {:db/id "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8" :answer-field/id #uuid "8bd2771d-4f88-578f-9fd3-675729a93312" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/1ba85811e5b4e050216c0b99b2ae2731e957a6a9a066fbef01dc7b1402227539" "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/46061bd04bf456df37808afdf7886153bbe607701266ae847b70835caf1e39dc" "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/fad0557b96a306da4fddf20b98ae1fd6d926dcda25808e2bf4899503d630643d" "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/54beee3030306d84a0ced8aa47140b1bd1638c8232475094333c6fc09378baeb" "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/8e4d6e1fdb76c00dc4ee2e08f8450be8d2de379e6162d57af6b42295c23c6faf"] :answer-field/correct "q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8/fad0557b96a306da4fddf20b98ae1fd6d926dcda25808e2bf4899503d630643d" :db/ensure [:answer-field/validate]} {:db/id "q-14619" :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-14619/ma-source-field/33ea20d922b0d025ff84fe0ec263a1954ebef5c5eeb3f53bb5df0b5de2f38aa8"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144"] :knowledge-point/questions ["q-14619"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/f9507c77d3b89740666add201203a04a2b382249dc5fee4349a326286f06f3a9" :answer/id #uuid "91bca4ac-a533-50cd-b79b-78e54b58a746" :answer/type :answer.type/text :answer/value "center: $(-1,-5)$, radius: $9$" :db/ensure [:answer/validate]} {:db/id "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/a9b5295ade38351ff60589c098d34f64f383ba57155aa4884d551b3fa0ae89d8" :answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type :answer.type/text :answer/value "center: $(-1,5)$, radius: $9$" :db/ensure [:answer/validate]} {:db/id "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/f1b2ae1c2e59346d71944c01973e601aecdbb63c427c24a136939330e29d1cf7" :answer/id #uuid "ecbea558-c9ab-5f89-80f4-8cdcb2e0f681" :answer/type :answer.type/text :answer/value "center: $(-5,1)$, radius: $4$" :db/ensure [:answer/validate]} {:db/id "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/4f8fa71b5410381ecc50e69058ba8881cb92fb4f8f2b9a4ee31f59d3deaee09d" :answer/id #uuid "74e6273a-f318-5c34-a052-af10236b8229" :answer/type :answer.type/text :answer/value "center: $(1,5)$, radius: $3$" :db/ensure [:answer/validate]} {:db/id "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/d4e6d995e03548a2d215bafba27f272952f2eecfb6d898241a2a81b8b1112741" :answer/id #uuid "c6be1a14-c6c9-582a-8aa6-d933eeef50a8" :answer/type :answer.type/text :answer/value "center: $(5,-1)$, radius: $7$" :db/ensure [:answer/validate]} {:db/id "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6" :answer-field/id #uuid "de4e6f08-aad0-5add-9bc8-7a4631ad1e27" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/f9507c77d3b89740666add201203a04a2b382249dc5fee4349a326286f06f3a9" "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/a9b5295ade38351ff60589c098d34f64f383ba57155aa4884d551b3fa0ae89d8" "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/f1b2ae1c2e59346d71944c01973e601aecdbb63c427c24a136939330e29d1cf7" "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/4f8fa71b5410381ecc50e69058ba8881cb92fb4f8f2b9a4ee31f59d3deaee09d" "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/d4e6d995e03548a2d215bafba27f272952f2eecfb6d898241a2a81b8b1112741"] :answer-field/correct "q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6/a9b5295ade38351ff60589c098d34f64f383ba57155aa4884d551b3fa0ae89d8" :db/ensure [:answer-field/validate]} {:db/id "q-15460" :question/id #uuid "bf1d8b4a-8091-5076-a3c1-f3d77fa5e29a" :question/math-academy-id "q-15460" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}=55+10y.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2} & =55+10y \\\\ ({x}^{2}+2x)+({y}^{2}-10y) & =55 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =55+{1}^{2}+{5}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-5)^{2} & ={9}^{2} \\\\ (x-(-1))^{2}+(y-5)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,5)$ and its radius is $9.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15460/ma-source-field/84a1c76a691f8c71b6aac935c671fb771263a89ba4939e8ba1162e891f1d72d6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c"] :knowledge-point/questions ["q-15460"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15681/ma-source-field/8ceaf668802de3835dd3b0de48a66b094a3645b0e2de0fb1778ef4666359b3be/9e8e4f7852bd1ae2e3bc7028576c4cdf363cf8e8609674ce8a132d528858fc3c" :answer/id #uuid "4a4a908f-0a56-517f-bdb8-64d7225e46c2" :answer/type :answer.type/text :answer/value "$(-10,0)$ and $(1,0)$" :db/ensure [:answer/validate]} {:db/id "q-15681/ma-source-field/8ceaf668802de3835dd3b0de48a66b094a3645b0e2de0fb1778ef4666359b3be/30ea6ad1dc21d96cfc28263fcf49fc9fb7d86c312fc08dc8dafb5517f6215152" :answer/id #uuid "066ae657-b48f-5dee-bdbe-90b25f7241eb" :answer/type :answer.type/text :answer/value "$(-8,0)$ and $(1,0)$" :db/ensure [:answer/validate]} {:db/id "q-15681/ma-source-field/8ceaf668802de3835dd3b0de48a66b094a3645b0e2de0fb1778ef4666359b3be/a9ae184b336a02f235dda4ed89d444bcf891d97cdaf7af4e2d91cd1544f613cb" :answer/id #uuid "d3ca94c7-3047-533b-8a37-cf3312b8643d" :answer/type :answer.type/text :answer/value "$(-9,0)$ and $(0.8,0)$" :db/ensure [:answer/validate]} {:db/id "q-15681/ma-so