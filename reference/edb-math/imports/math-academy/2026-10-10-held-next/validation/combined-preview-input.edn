7538088e4dd03/252ef472451ceb2262afe5f6a53ef64b4bc07f6a9749b4ae9b8c027fac861eba"] :answer-field/correct "q-7835/ma-source-field/011b526e15bdf369bde87c19aadf022cc6911fd550dd805d73d7538088e4dd03/30de48f7cbc7302a90e91ea81eb8bc6cef0a8b41cbfd441e5821e2c6185067c5" :db/ensure [:answer-field/validate]} {:db/id "q-7835" :question/id #uuid "7ba95bcc-83a0-57ed-9254-81c22af4a048" :question/math-academy-id "q-7835" :question/problem "Which of the following are square matrices?\n\n$$\nK=[\\begin{aligned}3 & 1 & 1 \\\\ 0 & 0 & 0\\end{aligned}],\\,L=[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}],\\,M=[\\begin{aligned}2 & 3 & 0 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 7 & 1 & 1 & 4 \\\\ 0 & 0 & 0 & 8\\end{aligned}]\n$$" :question/worked-solution "- $K$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $2$ rows and $3$ columns, so it's a $2\\times 3$ matrix.\n\n- $L$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $M$ is a square matrix since it has the same number of rows and columns. It has $4$ rows and $4$ columns, so it is a $4\\times 4$ matrix.\n\nTherefore, only $L$ and $M$ are square matrices." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7835/ma-source-field/011b526e15bdf369bde87c19aadf022cc6911fd550dd805d73d7538088e4dd03"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ca13445-0218-5950-967e-a68bcfec32c7"] :knowledge-point/questions ["q-7835"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7915/ma-source-field/f7b7d0cd7d49af33309e2375604ae82586dd7813e587181cb24666ba4e7c89d6/f6ed8c3e8ac11c4c476e856e67261d9addd41c460d2f0404e6d3f3a72ad0633a" :answer/id #uuid "94c1155a-b3ff-59dd-b24f-e9f04aac265d" :answer/type :answer.type/text :answer/value "$P$ and $Q$ only" :db/ensure [:answer/validate]} {:db/id "q-7915/ma-source-field/f7b7d0cd7d49af33309e2375604ae82586dd7813e587181cb24666ba4e7c89d6/2e147b9bf74fe5a9fe1cc