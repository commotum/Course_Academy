a721a/1797aac5cc92aa954a4633639892e4b3c6235d680a7a46f71f8096ea8b9cad64" :db/ensure [:answer-field/validate]} {:db/id "q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d/34072c330c1ddc31e1283826e1f63061acb37fc99b4c3bad85fac5f4064d536d" :answer/id #uuid "8cc0f169-e729-5947-84b4-6f07c528a50a" :answer/type :answer.type/text :answer/value "almost linear" :db/ensure [:answer/validate]} {:db/id "q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d/ffd3fd1ca243376069911a691e58f6223828faabc24fa921dc3d5f5adf98a658" :answer/id #uuid "cb165ac4-0779-5002-85a2-b9755f87c486" :answer/type :answer.type/text :answer/value "not almost linear" :db/ensure [:answer/validate]} {:db/id "q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d" :answer-field/id #uuid "c2ba4f30-23bd-5905-838d-76fd7661d248" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/choices ["q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d/34072c330c1ddc31e1283826e1f63061acb37fc99b4c3bad85fac5f4064d536d" "q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d/ffd3fd1ca243376069911a691e58f6223828faabc24fa921dc3d5f5adf98a658"] :answer-field/correct "q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d/34072c330c1ddc31e1283826e1f63061acb37fc99b4c3bad85fac5f4064d536d" :db/ensure [:answer-field/validate]} {:db/id "q-334942" :question/id #uuid "5dcedf1a-f3f7-5345-8ad7-4690098e1077" :question/math-academy-id "q-334942" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)={y}^{2}(t)+\\operatorname{cos}⁡(\\pi x(t)) \\\\ {y}^{′}(t)={x}^{2}(t)+\\operatorname{cos}⁡(\\pi y(t))\\end{aligned}\n$$\n\nGiven the system of differential equations, select the correct options below.The Jacobian determinant of the system at the equilibrium point ${x}^{∗}=[1,\\text{ }1]^{T}$ is given as\n\n$$\nJ(1,1)={{field-1}}.\n$$\n\nAt this point, the system is \n{{field-2}}\nat ${x}^{∗}.$" :question/worked-solution "The system can be rewritten in matrix form as \n\n$$\n{x}^{′}=\\text{\\boldsymbol}f(x)\n$$\n\nwhere $x=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]$ and \n$\\text{\\boldsymbol}f(x)=[\\begin{aligned}{y}^{2}+\\operatorname{cos}⁡(\\pi x) \\\\ {x}^{2}+\\operatorname{cos}⁡(\\pi y)\\end{aligned}].$\n\nWe need to compute the Jacobian determinant of $\\text{\\boldsymbol}f(x).$ \n\nIn our case, we have the following:\n\n$$\nJ=|\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}|\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}({y}^{2}+\\operatorname{cos}⁡(\\pi x))=-\\pi \\operatorname{sin}⁡(\\pi x),\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}({y}^{2}+\\operatorname{cos}⁡(\\pi x))=2y \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}({x}^{2}+\\operatorname{cos}⁡(\\pi y))=2x,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}({x}^{2}+\\operatorname{cos}⁡(\\pi y))=-\\pi \\operatorname{sin}⁡(\\pi y)\\end{aligned}\n$$\n\nThus, we have\n\n$$\nJ=|\\begin{aligned}-\\pi \\operatorname{sin}⁡(\\pi x) & 2y \\\\ 2x & -\\pi \\operatorname{sin}⁡(\\pi y)\\end{aligned}|.\n$$\n\nNext, we evaluate the Jacobian at the equilibrium ${x}^{∗}=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ to get\n\n$$\n\\begin{aligned}J(1,1) & =|\\begin{aligned}-\\pi \\operatorname{sin}⁡(\\pi (1)) & 2(1) \\\\ 2(1) & -\\pi \\operatorname{sin}⁡(\\pi (1))\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}| \\\\  & =0\\cdot 0-2\\cdot 2 \\\\  & =-4 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nFinally, since the Jacobian determinant is not zero, our system is $\\text{almost linear}$ at ${x}^{∗}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334942/ma-source-field/3adeee9b055be9627e083e3b4f6bbfb12a239c6e56a1757a446660b8319a721a" "q-334942/ma-source-field/060a8d901c222854a199dd937fac0ff53421cb9bed4a5f6e46f0e9825ad8a29d"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9680fc-dfa9-5411-aeca-81659b7dec8a"] :knowledge-point/questions ["q-334942"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7/7cbbbf05500fd826b84766ad6c4d7268b13c609311bf395ae80768d02fd7ddc1" :answer/id #uuid "707ed04f-5cf8-578a-8d26-c6b4f7655729" :answer/type :answer.type/text :answer/value "amount" :db/ensure [:answer/validate]} {:db/id "q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7/3d1cd865a66a27d40623419c8ae799ab86f9678b0f58bad7b30b6b918aeb7a02" :answer/id #uuid "75e05438-3ae9-58ec-903e-82743e42d013" :answer/type :answer.type/text :answer/value "rate of change" :db/ensure [:answer/validate]} {:db/id "q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7" :answer-field/id #uuid "ee6a8c10-9c97-5d0e-a7ca-88d3123f21e6" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices ["q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7/7cbbbf05500fd826b84766ad6c4d7268b13c609311bf395ae80768d02fd7ddc1" "q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7/3d1cd865a66a27d40623419c8ae799ab86f9678b0f58bad7b30b6b918aeb7a02"] :answer-field/correct "q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7/3d1cd865a66a27d40623419c8ae799ab86f9678b0f58bad7b30b6b918aeb7a02" :db/ensure [:answer-field/validate]} {:db/id "q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67/0ff6ca6e4f0a0d5da1ae3279f38b829334e4ca4319678b2cfdba61fee43515ae" :answer/id #uuid "c53b9aee-4b74-5b15-9c02-23b4c28311c1" :answer/type :answer.type/text :answer/value "predator" :db/ensure [:answer/validate]} {:db/id "q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67/f067b0487a1512305b2d7044250a67f39a9e400f62cd6af269d7f5c309f9aaf5" :answer/id #uuid "b1ecbe30-532a-5642-ac26-0feb1ebd151e" :answer/type :answer.type/text :answer/value "prey" :db/ensure [:answer/validate]} {:db/id "q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67" :answer-field/id #uuid "e00831ee-a120-529f-9a49-7553956b9af8" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/choices ["q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67/0ff6ca6e4f0a0d5da1ae3279f38b829334e4ca4319678b2cfdba61fee43515ae" "q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67/f067b0487a1512305b2d7044250a67f39a9e400f62cd6af269d7f5c309f9aaf5"] :answer-field/correct "q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67/0ff6ca6e4f0a0d5da1ae3279f38b829334e4ca4319678b2cfdba61fee43515ae" :db/ensure [:answer-field/validate]} {:db/id "q-334988" :question/id #uuid "1189d035-9d29-5b3d-9e34-9bcf6834053f" :question/math-academy-id "q-334988" :question/problem "$$\n{\\begin{aligned}{x}^{′}=-1.5x+2.5xy \\\\ {y}^{′}=5y-1.2xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above for the functions $x(t)$ and $y(t).$ Select the correct options in the following statement.$\\,$\nTerm ${x}^{′}$ in the first equation represents the \n{{field-1}} \nof the \n{{field-2}}." :question/worked-solution "The Lotka-Volterra predator-prey model is given by\n\n$$\n{\\begin{aligned}{x}^{′}=ax-bxy \\\\ {y}^{′}=-cy+dxy\\end{aligned}\n$$\n\nwhere $a,b,c,d$ are positive real constants. \n\nFirst, recall that a derivative represents a $\\text{rate of change}.$\n\nFor the ${x}^{′}$ equation, we have\n\n$$\n{x}^{′}=-1.5x+2.5xy.\n$$\n\nTherefore, $x$ must represent the $\\text{predator}.$ Indeed,\n\n- it decays exponentially in the absence of prey (the $-1.5x$ term), and\n\n- increases when interacting with prey (the $2.5xy$ term)." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334988/ma-source-field/2f2c8ddc20b7deba8128e9245597124915ebed31427e79ac0bc49c412e5bdfc7" "q-334988/ma-source-field/4244ba02c7914f951799cbbea78696e6d70027adbc787b7a62e21804a14d2b67"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16481b80-9744-5c8d-843a-14af30fd8cf4"] :knowledge-point/questions ["q-334988"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186167263 :question/answer-fields 17592186164706] {:db/id "q-335040/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9/ca5d67c850982ef213b55d1f05c1982c01758138b8779ef65a4059c3a38ed0c8" :answer/id #uuid "db34f585-7424-54b4-824a-385921f24a40" :answer/type :answer.type/text :answer/value "approaches" :db/ensure [:answer/validate]} {:db/id "q-335040/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9/a4f36f295ffdcc94188a6fa54e6a58e804da1e24f5661638790f18badaa10aa2" :answer/id #uuid "1f2218ff-6591-53f7-bbb3-3a4fefeb7720" :answer/type :answer.type/text :answer/value "circles around" :db/ensure [:answer/validate]} {:db/id "q-335040/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9" :answer-field/id #uuid "a014f4d5-5a11-52db-b0bc-b00c033de4bd" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices ["q-335040/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9/ca5d67c850982ef213b55d1f05c1982c01758138b8779ef65a4059c3a38ed0c8" "q-335040/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9/a4f36f295ffdcc94188a6fa54e6a58e804da1e24f5661638790f18badaa10aa2"] :answer-field/correct "q-335040/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9/a4f36f295ffdcc94188a6fa54e6a58e804da1e24f5661638790f18badaa10aa2" :db/ensure [:answer-field/validate]} [: