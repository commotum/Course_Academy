cb312f8c6f9c2cf/cd6b710817a48c601664106b7516a489a4c933cffc4cd97675b5249df0b14759"] :answer-field/correct "q-1203/ma-source-field/168f9ea4d7b2307401be3a966a1819e33ab83664c2a7074d3cb312f8c6f9c2cf/26ce680cf6e053429588b84978a715170084c2ec926a7c87eb87f93682aeacfa" :db/ensure [:answer-field/validate]} {:db/id "q-1203" :question/id #uuid "350a2acf-787e-5ee2-949f-2438ca3d2b8a" :question/math-academy-id "q-1203" :question/problem "If $X={2,4,8}$, then $P(X)=$" :question/worked-solution "The power set of $X,$ denoted $P(X),$ is the set that contains every possible subset of $X,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $X$ using a tree diagram. \n\n![](images/58/580d7c32378a2af641fb1066cec4ec24cc6c5b140ccf9475f9a3e3a68367d30d.png)\n\nAccording to our diagram, the subsets of $X$ are\n\n$$\n∅={},\\,{2},\\,{4},\\,{8},\\,{2,4},\\,{2,8},\\,{4,8},\\,{2,4,8}.\n$$\n\nTherefore, we have\n\n$$\nP(X)={∅,{2},{4},{8},{2,4},{2,8},{4,8},{2,4,8}}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-1203/ma-source-field/168f9ea4d7b2307401be3a966a1819e33ab83664c2a7074d3cb312f8c6f9c2cf"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f1f99d3-ebcb-50c6-a162-bd58f7d5ec92"] :knowledge-point/questions ["q-1203"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1208/ma-source-field/82f763aaa0e8334dedf0f46da0f551bc4c351b6a39578c71cf8f37ab01f78ef4/c5779127aae119392a5a9971807e90a16aa987b0c7f51c2068092c398b224535" :answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type :answer.type/math :answer/value "C⊆Z" :db/ensure [:answer/validate]} {:db/id "q-1208/ma-source-field/82f763aaa0e8334dedf0f46da0f551bc4c351b6a39578c71cf8f37ab01f78ef4/608aa8eee889cc9ba516a8468964f58babe8f298be2aea159122552581473af6" :answer/id #uuid "ef9e9860-9681-5612-8906-739b929d5dd1" :answer/type :answer.type/math :answer/value "Q⊆R" :db/ensure [:answer/validate]} {:db/id "q-1208/ma-source-field/82f763aaa0e8334dedf0f46da0f551bc4c351b6a39578c