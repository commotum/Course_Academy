4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-32531/ma-source-field/cff88df0a0e62b0ae4132dd30db0d5a707cf7586cff5ce9ddf0c53ef7918958d/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" "q-32531/ma-source-field/cff88df0a0e62b0ae4132dd30db0d5a707cf7586cff5ce9ddf0c53ef7918958d/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856"] :answer-field/correct "q-32531/ma-source-field/cff88df0a0e62b0ae4132dd30db0d5a707cf7586cff5ce9ddf0c53ef7918958d/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :db/ensure [:answer-field/validate]} {:db/id "q-32531" :question/id #uuid "98334c69-2d0e-5223-82ea-d968a6c359cb" :question/math-academy-id "q-32531" :question/problem "Given that \n$A=[\\begin{aligned}2 & 4 \\\\ 5 & 10\\end{aligned}]$ has the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 4 \\\\ 5 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{5}{2}){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -\\frac{5}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 4 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -\\frac{5}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ \\frac{5}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 4 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=\\frac{5}{2},{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=\\frac{5}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32531/ma-source-field/cff88df0a0e62b0ae4132dd30db0d5a707cf7586cff5ce9ddf0c53ef7918958d"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2"] :knowledge-point/questions ["q-32531"] :db/ensure [:knowledge-point/validate]} {:db/id "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/eddc584b31d4a80179e9498da1aeab49ea2c84f0426c04a753bb5632fe5ce44f" :answer/id #uuid "b21e78e2-0491-596e-bd15-82fb1e997dcd" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/28b4bae639790da58210f04cd074f081ca0602cd8cac01fc317c1b731615c933" :answer/id #uuid "f7d068a8-8c16-5895-a8a0-6d5c967450ba" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/e5402976e3454c3d42a7c892015d52b6504db08e26b9754c64ebeccd6f821bf7" :answer/id #uuid "4f9a7859-76ff-5f7c-b9ba-abb5dc1b6768" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/df8719ac67769c06bc5471cbdd033e807b93a828dc1b6cc6509a271d1fca798f" :answer/id #uuid "6cdaec59-e1c5-5eb0-a903-7aa07bfa40a8" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/f639f150287a95bee3e517379c75de510a4cd9e3bc359eed9d03a9e594f824fc" :answer/id #uuid "c6628db1-d645-5914-9bc3-a35c7a222729" :answer/type :answer.type/math :answer/value "B={[\\begin{aligned}1 \\\\ -1 \\\\ 0\\end{aligned}]}" :db/ensure [:answer/validate]} {:db/id "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f" :answer-field/id #uuid "eb2dd0d4-9bed-58b4-940b-d9ecf1e1866c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/eddc584b31d4a80179e9498da1aeab49ea2c84f0426c04a753bb5632fe5ce44f" "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/28b4bae639790da58210f04cd074f081ca0602cd8cac01fc317c1b731615c933" "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/e5402976e3454c3d42a7c892015d52b6504db08e26b9754c64ebeccd6f821bf7" "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/df8719ac67769c06bc5471cbdd033e807b93a828dc1b6cc6509a271d1fca798f" "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/f639f150287a95bee3e517379c75de510a4cd9e3bc359eed9d03a9e594f824fc"] :answer-field/correct "q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f/eddc584b31d4a80179e9498da1aeab49ea2c84f0426c04a753bb5632fe5ce44f" :db/ensure [:answer-field/validate]} {:db/id "q-34422" :question/id #uuid "4b9db0d1-0644-55bd-9fa5-174e2a1643f2" :question/math-academy-id "q-34422" :question/problem "Given the matrix $A=[\\begin{aligned}1 & 2 & 1 \\\\ 4 & 9 & 4 \\\\ 3 & 6 & 3\\end{aligned}]$, find a basis of $\\text{Null}(A).$" :question/worked-solution "First, we reduce the matrix $A$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 2 & 1 \\\\ 4 & 9 & 4 \\\\ 3 & 6 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 0 & 1 & 0 \\\\ 3 & 6 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the equation $Ax=0$ is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}+{x}_{3}=0 \\\\ {x}_{2}=0.\\end{aligned}\n$$\n\nThe general solution is ${x}_{1}=-{x}_{3}$ and ${x}_{2}=0,$ where ${x}_{3}$ is a free variable. Therefore, if $x\\in \\text{Null}(A),$ then\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]=[\\begin{aligned}-{x}_{3} \\\\ 0 \\\\ {x}_{3}\\end{aligned}]={x}_{3}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nThis implies that \n\n$$\nB={[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}\n$$\n\nis a basis of $\\text{Null}(A)$ since it is a linearly independent set and its vectors generate $\\text{Null}(A).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-34422/ma-source-field/2afb61033b808f6f20c3e938a4c902e2617107dcb73dc02e3db8ed5b0c9b418f"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fd5a675-c692-505e-900b-d7500fb7c653"] :knowledge-point/questions ["q-34422"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124900 :question/answer-fields 17592186121970] {:db/id "q-35620/ma-source-field/dccd123cd571ec167209c90932bb96eda86925a1d2af6edcf4f84292e4170a7d/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "bd24e831-d137-57fd-a292-6b2a20eb4818" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-35620/ma-source-field/dccd123cd571ec167209c90932bb96eda86925a1d2af6edcf4f84292e4170a7d/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "35f49549-32d6-5426-8139-bf824bd1fff4" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-35620/ma-source-field/dccd123cd571ec167209c90932bb96eda86925a1d2af6edcf4f84292e4170a7d/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd4