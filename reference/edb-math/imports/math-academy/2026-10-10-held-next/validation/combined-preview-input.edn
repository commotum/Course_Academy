d901b4a732d7e038d7/629032895e7605a24a4afd3b568def84344a64cb3574ce45730653a0d305d70b" "q-7644/ma-source-field/f85a39f03d8631c53b7e3deab775b19f413b56f33065d0d901b4a732d7e038d7/33bc0462919d6e5a6e0723636b0950692f62da2c66c3ad7d192107d51b511c74" "q-7644/ma-source-field/f85a39f03d8631c53b7e3deab775b19f413b56f33065d0d901b4a732d7e038d7/4bc8f47874351dad0bf704d35e02c67a2f98a6be49c7acf232f37c3117e6e7bc" "q-7644/ma-source-field/f85a39f03d8631c53b7e3deab775b19f413b56f33065d0d901b4a732d7e038d7/312ea466adb292063ea5a2765cf2b4103e29241e352f1ec42d33c9e41681b0cc"] :answer-field/correct "q-7644/ma-source-field/f85a39f03d8631c53b7e3deab775b19f413b56f33065d0d901b4a732d7e038d7/629032895e7605a24a4afd3b568def84344a64cb3574ce45730653a0d305d70b" :db/ensure [:answer-field/validate]} {:db/id "q-7644" :question/id #uuid "86de3c58-7ec8-5280-8df9-9b9e42af2697" :question/math-academy-id "q-7644" :question/problem "Calculate the points where the ellipse \n$\\frac{(x-2)^{2}}{16}+\\frac{(y+3)^{2}}{12}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{16}+\\frac{(y+3)^{2}}{12} & =1 \\\\ \\frac{(0-2)^{2}}{16}+\\frac{(y+3)^{2}}{12} & =1 \\\\ \\frac{4}{16}+\\frac{(y+3)^{2}}{12} & =1 \\\\ \\frac{1}{4}+\\frac{(y+3)^{2}}{12} & =1 \\\\ 3+(y+3)^{2} & =12 \\\\ (y+3)^{2} & =9 \\\\ y+3 & =\\pm 3 \\\\ y & =-3\\pm 3 \\\\ y & =-6\\,,0.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,-6)$ and $(0,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7644/ma-source-field/f85a39f03d8631c53b7e3deab775b19f413b56f33065d0d901b4a732d7e038d7"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-7644"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7830/ma-source-field/76739f888