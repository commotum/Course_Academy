e-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f/b94d1ebc00da720d42398a3406c1a29d24e4fc83fd40696c4fac4f23295242df" "q-12997/ma-source-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f/d5884914ddc768729c8c26c6ee8f9198a6504b34be3e623e34a56c37c1f0364b" "q-12997/ma-source-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f/512a399024f830263a7b3f06cef2ef350b01998a227331ade956dca466e0827a" "q-12997/ma-source-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f/cd17b3ea41be71b3ae2da5ff1785245ce9f7bfefc5477c5980a3e8a81c6b209e" "q-12997/ma-source-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f/55fb5678344bc9094256b5e84a2f924b6830912dfbe921c634ec57822a5bb3f0"] :answer-field/correct "q-12997/ma-source-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f/cd17b3ea41be71b3ae2da5ff1785245ce9f7bfefc5477c5980a3e8a81c6b209e" :db/ensure [:answer-field/validate]} {:db/id "q-12997" :question/id #uuid "4870cb8f-66f0-5759-83b5-334830749092" :question/math-academy-id "q-12997" :question/problem "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12997/ma-source-field/e970bb842a259916d75d141a06867c90f7238cc05b133df66da1ffa1aad71f7f"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7"] :knowledge-point/questions ["q-12997"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/5d47e2c0bfa8d26c12aaa713a3302eb1af40754fa1fe12422f7dff3fc633348a" :answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/e478f94b923f3a55d0e4690849c99ebd5ab5add5e47003eaae98b870873a5bd1" :answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/70c60cbcc383d7b4f4fc55615f7eded54e37a5f2f0977b3acf534d10f39e1628" :answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/6012f3ab9252f09fe8577ae6fc619f0288e2fb83215db3f6567902f07520e82c" :answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type :answer.type/text :answer/value "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/ensure [:answer/validate]} {:db/id "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/d6f27b7c7939a102723fed67409856455f84c69bf3e5c2599003ca6bf26244df" :answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type :answer.type/text :answer/value "Undefined" :db/ensure [:answer/validate]} {:db/id "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a" :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/5d47e2c0bfa8d26c12aaa713a3302eb1af40754fa1fe12422f7dff3fc633348a" "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/e478f94b923f3a55d0e4690849c99ebd5ab5add5e47003eaae98b870873a5bd1" "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/70c60cbcc383d7b4f4fc55615f7eded54e37a5f2f0977b3acf534d10f39e1628" "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/6012f3ab9252f09fe8577ae6fc619f0288e2fb83215db3f6567902f07520e82c" "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/d6f27b7c7939a102723fed67409856455f84c69bf3e5c2599003ca6bf26244df"] :answer-field/correct "q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a/5d47e2c0bfa8d26c12aaa713a3302eb1af40754fa1fe12422f7dff3fc633348a" :db/ensure [:answer-field/validate]} {:db/id "q-13635" :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13635/ma-source-field/3160429b3be2a367988476806808665b09625aaa793391ed25ea3231f455621a"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd"] :knowledge-point/questions ["q-13635"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186120126 :question/answer-fields 17592186116932] {:db/id "q-13759/ma-source-field/1d168f635b32e79b9aff435244ae0722254b7edf513db268b8988b493a9a9d37/737ed29dfe85abe89843c2e0e81c86e7e8aabd9ae79ced44e8547ea03ce61f3c" :answer/id #uuid "a128b52e-7259-5003-b476-9857977d9aa6" :answer/type :answer.type/text :answer/value "Diagonal matrix" :db/ensure [:answer/validate]} {:db/id "q-13759/ma-source-field/1d168f635b32e79b9aff435244ae0722254b7edf513db268b8988b493a9a9d37/352d1e24a0f96d0add7ff8ef85b8091dd32657db3f850818163c37429339140d" :answer/id #uuid "9b6f508a-4794-5f61-a64e-b20147d225cf" :answer/type :answer.type/text :answer/value "Identity matrix" :db/ensure [:answer/validate]} {:db/id "q-13759/ma-source-field/1d168f635b32e79b9aff435244ae0722254b7edf513db268b8988b493a9a9d37/72c8da463af6b15a1f1b54b5381af76812080197a244de6fb4f98091599fabbf" :answer/id #uuid "82b889e9-c745-5d62-97b1-40fc31c6e4bb" :answer/type :answer.type/text :answer/value "Lower triangular matrix" :db/ensure [:answer/validate]} {:db/id "q-13759/ma-source-field/1d168f635b32e79b9aff435244ae0722254b7edf513db268b8988b493a9a9d37/06285049f72ef30fee6ef6292e1826eabf19578fd3f3da4353e2d47878d19d9f" :answer/id #uuid "76cc8a4b-832c-56c2-8cf5-70501cfbad40" :answer/type :answer.type/text :answer/value "Other" :db/ensure [:answer/validate]} {:db/id "q-13759/ma-source-field/1d168f635b32e79b9aff435244ae0722254b7edf513