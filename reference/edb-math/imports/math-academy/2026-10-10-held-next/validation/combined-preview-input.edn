b3a21053094aa1b5435b779db363b3719fe90717f62b96e03325831f" "q-105123/ma-source-field/d892506ed61f3017cf6e12eba7463250e83a39505b0cd8759a733908a112d30e/2e75d9ca28bdc41281d0cf6eae0238444af1a3855e505df100be5c3ce810ddfc" "q-105123/ma-source-field/d892506ed61f3017cf6e12eba7463250e83a39505b0cd8759a733908a112d30e/ecefed584d72aa589a468dd1772f03ffd53fb52ffb7996addf941341120090dd" "q-105123/ma-source-field/d892506ed61f3017cf6e12eba7463250e83a39505b0cd8759a733908a112d30e/61e6e2683db51890165c309cd3fbd4e3e722e4d15ee92fab3bc2c9bb4ad55e4d" "q-105123/ma-source-field/d892506ed61f3017cf6e12eba7463250e83a39505b0cd8759a733908a112d30e/5ed8b5c9b50e732351ad69c8d83adac8aa93849ce8e6663034cb967b70226e49"] :answer-field/correct "q-105123/ma-source-field/d892506ed61f3017cf6e12eba7463250e83a39505b0cd8759a733908a112d30e/61e6e2683db51890165c309cd3fbd4e3e722e4d15ee92fab3bc2c9bb4ad55e4d" :db/ensure [:answer-field/validate]} {:db/id "q-105123" :question/id #uuid "2a851309-6577-5c09-b5b9-0e83f2309404" :question/math-academy-id "q-105123" :question/problem "If $T={k,m,o},$ then $P(T)=$" :question/worked-solution "The power set of $T,$ denoted $P(T),$ is the set that contains every possible subset of $T,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $T$ using a tree diagram.\n\n![](images/1e/1ef8e646081305399cddbf6908bd8415d908dab3e9bb0e371d68b33e62084774.png)\n\nAccording to our diagram, the subsets of $T$ are\n\n$$\n∅={},\\,{k},\\,{m},\\,{o},\\,{k,m},\\,{k,o},\\,{m,o},\\,{k,m,o}.\n$$\n\nTherefore, we have\n\n$$\nP(T)={∅,{k},{m},{o},{k,m},{k,o},{m,o},{k,m,o}}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105123/ma-source-field/d892506ed61f3017cf6e12eba7463250e83a39505b0cd8759a733908a112d30e"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f1f99d3-ebcb-50c6-a162-bd58f7d5ec92"] :knowledge-point/questions ["q-105123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-1187/ma-source-field/9248669f8d2225fc0f8dfe8b751d4764c96