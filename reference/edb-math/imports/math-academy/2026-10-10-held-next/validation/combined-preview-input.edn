470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "717cb1ad-26fb-5d39-b775-f38b2206a689" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-183328/ma-source-field/faabd3470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9" :answer-field/id #uuid "95707686-21cc-5e61-98a8-5364df18a6b6" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/choices ["q-183328/ma-source-field/faabd3470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9/203f88d94a38bb859e78e84aea518cf34952815758cf391887040455367d62ef" "q-183328/ma-source-field/faabd3470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" "q-183328/ma-source-field/faabd3470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b"] :answer-field/correct "q-183328/ma-source-field/faabd3470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "4a35af51-a0e2-50d0-bbd3-1c0dc3bc52aa"] :question/problem "Describe the set $S={…,3,6,12,24,48,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=6$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n\\in {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,3,\\,6,\\,12,\\,24,\\,48,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=2:$\n\n$$\n\\begin{aligned}r & =2 \\\\  & =\\frac{6}{3} \\\\  & =\\frac{12}{6} \\\\  & =\\frac{24}{12} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=6,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =6\\cdot {2}^{n-1} \\\\  & =6\\cdot {2}^{n}\\cdot {2}^{-1} \\\\  & =\\frac{6}{2}\\cdot {2}^{n} \\\\  & =3\\cdot {2}^{n}\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={3\\cdot {2}^{n}\\,:\\,n\\in Z}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-183328/ma-source-field/53feebe03691bdc25cb00a0352b31c838f293d2ee947851c110c5f0895c0d3cb" "q-183328/ma-source-field/faabd3470ff71ed1594d0cf6cc92e28e3617579580b1740601e335bf33a54ce9"] :db/ensure [:question/validate]} {:db/id "q-183690/ma-source-field/21dbfeff2bd8c624d4126a70861c21d9321ea35f55c0a8ad5476eb6c8c8582bb/5fc5100246d98d57a3a3e1d40181b00e6e8dff5d4a097ce2d7b7f6ae0b08578e" :answer/id #uuid "cc29d216-b4b5-5d05-aee8-fa1d64f964da" :answer/type :answer.type/math :answer/value "C" :db/ensure [:answer/validate]} {:db/id "q-183690/ma-source-field/21dbfeff2bd8c624d4126a70861c21d9321ea35f55c0a8ad5476eb6c8c8582bb/4d0c358832890f4f0221d2542d1721c57f92cd229eaf0a284d49f62ed4f133e3" :answer/id #uuid "1b665804-beaa-5388-ac25-9397d16709cc" :answer/type :answer.type/math :answer/value "Q" :db/ensure [:answer/validate]} {:db/id "q-183690/ma-source-field/21dbfeff2bd8c624d4126a70861c21d9321ea35f55c0a8ad5476eb6c8c8582bb/a1f44d584f3d5c0539cb338e6289ad49d176231f52c1da87f334282351fe2472" :answer/id #uuid "20f47bfb-da3d-5440-aa25-5e8189b5f62d" :answer/type :answer.type/math :answer/value "R" :db/ensure [:answer/validate]} {:db/id "q-183690/ma-source-field/21dbfeff2bd8c624d4126a70861c21d9321ea35f55c0a8ad5476eb6c8c8582bb/7d512723ec7933fc53d818fe067378407b0cca1985b020babe9fcffa79cfd32b" :answer/id #uuid "80b0d143-f228-52ab-ad57-54619241a5e2" :answer/type :answer.type/math :answer/value "Z" :db/ensure [:answer/validate]} {:db/id "q-183690/ma-source-field/21dbfeff2bd8c624d4126a70861c21d9321ea35f55c0a8ad5476eb6c8c8582bb" :answer-field/id #uuid "474b1fda-a88a-5ba4-9077-194e8d8272f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/choices