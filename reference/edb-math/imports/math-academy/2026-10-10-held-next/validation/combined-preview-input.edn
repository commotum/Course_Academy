1475be2a2b38b955cb26b6a286ec7404e1dde3b1121891bea7fa1cc3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-13497/ma-source-field/18e512fc1475be2a2b38b955cb26b6a286ec7404e1dde3b1121891bea7fa1cc3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-13497/ma-source-field/18e512fc1475be2a2b38b955cb26b6a286ec7404e1dde3b1121891bea7fa1cc3/90cf15e4f959828e7ed88adb4b2192b470c0fca2747e8fa231254a5f2a3b0df1"] :answer-field/correct "q-13497/ma-source-field/18e512fc1475be2a2b38b955cb26b6a286ec7404e1dde3b1121891bea7fa1cc3/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :db/ensure [:answer-field/validate]} {:db/id "q-13497" :question/id #uuid "d09f8217-b119-5565-bb4f-2ae4305acd87" :question/math-academy-id "q-13497" :question/problem "Find the entry ${c}_{24}$ of the matrix $C$, where \n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${c}_{24}$ should lie at the intersection of the $2$nd row and $4$th column. Therefore, ${c}_{24}=5.$\n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}]\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13497/ma-source-field/18e512fc1475be2a2b38b955cb26b6a286ec7404e1dde3b1121891bea7fa1cc3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8"] :knowledge-point/questions ["q-13497"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14191/ma-source-field/1444459bd1c216dfe49d32e008dbeb3a5ca034bed3b2d4a34e7c7f12286dab0a/274572aa022ec595e3efae3dfad432d20b9e306a59d2439b2fe52e70d167a9f5" :answer/id #uuid "932f6c0b-7bfc-5138-a5fc-88d5849899ad" :answer/type :answer.type/math :answer/value "(-\\frac{13}{2},0)" :db/ensure [:answer/validate]} {:db/id "q-14191/ma-source-field/1444459bd1c216dfe49d32e008dbeb3a5ca034bed3b2d4a34e7c7f12286dab0a/f8305ebbf3700648beaeb534db27d1dec72f6277ad941ca5f53a552342