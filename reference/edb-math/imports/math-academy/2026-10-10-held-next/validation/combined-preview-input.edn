2011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347/30e11553a14c4b724190c38b898a039988015e55be021b10f0364e3d70ce3b98" :answer/id #uuid "3106cae2-aa39-50e5-a759-99c5161fc219" :answer/type :answer.type/text :answer/value "the definition of the Laplace transform" :db/ensure [:answer/validate]} {:db/id "q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347/90d0135f4c41887ba2a3b5b493e3b493c377d20daa69e5bdaabe55b63d4f90b0" :answer/id #uuid "fa4df89d-8fd7-5702-a951-30eefa0bde62" :answer/type :answer.type/text :answer/value "the product rule" :db/ensure [:answer/validate]} {:db/id "q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347" :answer-field/id #uuid "1936914d-83ba-5f97-8535-9faf43b5be4e" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/choices ["q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347/189a1bc3918431f8acd240b0382354cbb34f876b1bb143121ec10168178d54ea" "q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347/30e11553a14c4b724190c38b898a039988015e55be021b10f0364e3d70ce3b98" "q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347/90d0135f4c41887ba2a3b5b493e3b493c377d20daa69e5bdaabe55b63d4f90b0"] :answer-field/correct "q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347/30e11553a14c4b724190c38b898a039988015e55be021b10f0364e3d70ce3b98" :db/ensure [:answer-field/validate]} {:db/id "q-334829" :question/id #uuid "70e96342-9f6f-5f4d-885c-91889dc5a387" :question/math-academy-id "q-334829" :question/problem "Suppose that $f(t)$ is piecewise continuous on $[0,\\infty )$ and its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for $s>a.$ Then, $F(s)$ is differentiable at every point $s>a,$ and we have\n\n$$\n{F}^{′}(s)=-\\,L{t\\cdot f(t)}.\n$$\n\nA proof of this statement is given below. \n\n$\\text{L1}:\\,$ $F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,\\text{d}t$ exists for $s>a.$\n\n$\\text{L2}:\\,$ ${F}^{′}(s)=\\frac{\\text{d}}{\\text{d}s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,\\text{d}t$\n\n$\\text{L3}:\\,$ ${F}^{′}(s)={\\int }_{0}^{\\infty }\\frac{∂}{∂s}({e}^{-st}f(t))\\,\\text{d}t$\n\n$\\text{L4}:\\,$ $\\frac{∂}{∂s}({e}^{-st}f(t))=-t{e}^{-st}f(t)$\n\n$\\text{L5}:\\,$ ${F}^{′}(s)=-{\\int }_{0}^{\\infty }t{e}^{-st}f(t)\\,\\text{d}t$\n\n$\\text{L6}:\\,$ ${F}^{′}(s)=-L{t\\cdot f(t)}$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from line $\\text{L1}$ and\n{{field-1}}.\n\n$\\,$ Line $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by\n{{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L5}$ and\n{{field-3}}." :question/worked-solution "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. \n\nThe smoothness property states that, for each integer $n\\ge 0$ and $s>a,$ we have\n\n$$\n{F}^{(n)}(s)=(-1)^{n}\\,L{{t}^{n}f(t)}.\n$$\n\nWe're asked to prove the smoothness property in the case $n=1.$\n\nWith that in mind, let's examine each statement in turn.\n\n- We first consider line $\\text{L2}.$ From line $\\text{L1}$ we know that\n\n$$\nF(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt.\n$$\n\nBy $\\text{the definition of the derivative with respect to }s$, we get\n\n$$\n{F}^{′}(s)=\\frac{d}{ds}F(s)=\\frac{d}{ds}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt,\n$$\n\nwhich is exactly the statement in line $\\text{L2}.$\n\n- Next we consider line $\\text{L5}.$ From line $\\text{L3}$ we have\n\n$$\n{F}^{′}(s)={\\int }_{0}^{\\infty }\\frac{∂}{∂s}({e}^{-st}f(t))\\,dt.\n$$\n\nLine $\\text{L4}$ tells us that\n\n$$\n\\frac{∂}{∂s}({e}^{-st}f(t))=-t{e}^{-st}f(t).\n$$\n\nSubstituting this expression into the integrand in line $\\text{L3}$ gives\n\n$$\n{F}^{′}(s)={\\int }_{0}^{\\infty }(-t{e}^{-st}f(t))\\,dt=-{\\int }_{0}^{\\infty }t{e}^{-st}f(t)\\,dt.\n$$\n\nTherefore, line $\\text{L5}$ follows from lines $\\text{L3}$ and $\\text{L4}$ by $\\text{substitution}.$\n\n- Finally, we consider line $\\text{L6}.$ By $\\text{the definition of the Laplace transform},$\n\n$$\nL{t\\cdot f(t)}={\\int }_{0}^{\\infty }{e}^{-st}(tf(t))\\,dt.\n$$\n\nComparing this with the integral in line $\\text{L5}$, we see that\n\n$$\n{F}^{′}(s)=-{\\int }_{0}^{\\infty }t{e}^{-st}f(t)\\,dt=-{\\int }_{0}^{\\infty }{e}^{-st}(tf(t))\\,dt=-\\,L{t\\cdot f(t)},\n$$\n\nwhich is exactly the expression in line $\\text{L6}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334829/ma-source-field/4a5309f4aa170f9fa794109d91ba4c7ef77abccbe766f572e7a0a22267e72b77" "q-334829/ma-source-field/636f1b26a9ee8ba91cb18e96de35034f58a52a63ea648d86bedc79b4addf6772" "q-334829/ma-source-field/e0e81f62011949c564fe8ecc1cac5d5734490373e9094ca736e2de0884fa2347"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "32e63c33-8820-542f-afab-f27a1f6a847a"] :knowledge-point/questions ["q-334829"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186222010 :question/answer-fields 17592186220701] {:db/id "q-334874/ma-source-field/74e1e11f6b59c6d2bce7a3f36592db58cfe1aad1c727cc449679030d685a901e/53d82fe9de28f0ed63fb1ded8f44402dee96fce0effb12b68e34d31a340d63a7" :answer/id #uuid "851c36f7-f486-5c90-9b67-e065924120c8" :answer/type :answer.type/text :answer/value "differentiating under the integral sign" :db/ensure [:answer/validate]} {:db/id "q-334874/ma-source-field/74e1e11f6b59c6d2bce7a3f36592db58cfe1aad1c727cc449679030d685a901e/9c65e771a257723f199dd36fcb93f8c4cd41ba850ff9c3d2716b7642d6951fbb" :answer/id #uuid "b02e7b04-a39b-5681-8e01-11a62924acca" :answer/type :answer.type/text :answer/value "integration by parts" :db/ensure [:answer/validate]} {:db/id "q-334874/ma-source-field/74e1e11f6b59c6d2bce7a3f36592db58cf