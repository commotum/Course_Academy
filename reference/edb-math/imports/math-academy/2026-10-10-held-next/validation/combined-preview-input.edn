x or a diagonal matrix since there is a non-zero element below the diagonal: ${a}_{21}=3\\ne 0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13759/ma-source-field/1d168f635b32e79b9aff435244ae0722254b7edf513db268b8988b493a9a9d37"] :db/ensure [:question/validate]} {:db/id "q-13781/ma-source-field/e026f89690e4a0c5be8ca89a3af0f624736a683e5a6961026ca63773446255dd/737ed29dfe85abe89843c2e0e81c86e7e8aabd9ae79ced44e8547ea03ce61f3c" :answer/id #uuid "7bc5b9ce-5da0-55fe-8e2a-df8eb4ecfc52" :answer/type :answer.type/text :answer/value "Diagonal matrix" :db/ensure [:answer/validate]} {:db/id "q-13781/ma-source-field/e026f89690e4a0c5be8ca89a3af0f624736a683e5a6961026ca63773446255dd/352d1e24a0f96d0add7ff8ef85b8091dd32657db3f850818163c37429339140d" :answer/id #uuid "d4aa5d0b-3502-5db7-982d-257ca9d0ebb8" :answer/type :answer.type/text :answer/value "Identity matrix" :db/ensure [:answer/validate]} {:db/id "q-13781/ma-source-field/e026f89690e4a0c5be8ca89a3af0f624736a683e5a6961026ca63773446255dd/72c8da463af6b15a1f1b54b5381af76812080197a244de6fb4f98091599fabbf" :answer/id #uuid "9c6da7fb-8eba-5ffa-9bde-d1144a8dbb47" :answer/type :answer.type/text :answer/value "Lower triangular matrix" :db/ensure [:answer/validate]} {:db/id "q-13781/ma-source-field/e026f89690e4a0c5be8ca89a3af0f624736a683e5a6961026ca63773446255dd/06285049f72ef30fee6ef6292e1826eabf19578fd3f3da4353e2d47878d19d9f" :answer/id #uuid "b3993775-0f8e-5c7e-b158-1a52fe75de99" :answer/type :answer.type/text :answer/value "Other" :db/ensure [:answer/validate]} {:db/id "q-13781/ma-source-field/e026f89690e4a0c5be8ca89a3af0f624736a683e5a6961026ca63773446255dd/fe5bf6e3da901181af18fe85bccf25025e422c6fa9ec00ec5e9610c8843fdbd7" :answer/id #uuid "6657fbe8-1958-5cc4-b147-eb6c679992c6" :answer/type :answer.type/text :answer/value "Upper triangular matrix" :db/ensure [:answer/validate]} {:db/id "q-13781/ma-source-field/e026f89690e4a0c5be8ca89a3af0f624736a683e5a6961026ca63773446255dd" :answer-field/id #uuid "2332d8