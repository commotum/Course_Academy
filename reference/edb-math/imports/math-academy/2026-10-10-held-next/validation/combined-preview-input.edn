cfcb9f0f9e926bb1f1a6aba8ba5/349b5e74e9c4e10760a76b9d32e42f4bfc15459d46e647ef0a728c0a0f85924d" :db/ensure [:answer-field/validate]} [:db/retract 17592186167254 :question/answer-fields 17592186164611] {:db/id "q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310/349b5e74e9c4e10760a76b9d32e42f4bfc15459d46e647ef0a728c0a0f85924d" :answer/id #uuid "0b6bc298-819c-5e72-8a93-83f08ec194c2" :answer/type :answer.type/text :answer/value "decreases" :db/ensure [:answer/validate]} {:db/id "q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310/3ed515d894ca9eab0c4ba27f94e6d07f7ea399773bb6725db5f3ea80887fb921" :answer/id #uuid "8c621ff2-0784-5f4a-9f17-554f017a4290" :answer/type :answer.type/text :answer/value "increases" :db/ensure [:answer/validate]} {:db/id "q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310" :answer-field/id #uuid "a630ba98-1096-5e16-a8ba-c72404307d8b" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/choices ["q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310/349b5e74e9c4e10760a76b9d32e42f4bfc15459d46e647ef0a728c0a0f85924d" "q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310/3ed515d894ca9eab0c4ba27f94e6d07f7ea399773bb6725db5f3ea80887fb921"] :answer-field/correct "q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310/3ed515d894ca9eab0c4ba27f94e6d07f7ea399773bb6725db5f3ea80887fb921" :db/ensure [:answer-field/validate]} {:db/id [:question/id #uuid "fc687ab5-118b-5439-986b-20786139182f"] :question/problem "![](images/71/718df02f2d0c2f01cc4a02a40da120178afe0f436bbf38cd5a8d249d87b5d1c9.png)\n\nConsider the phase portrait above showing a solution of a Lotka-Volterra predator-prey model\n\n$$\n{\\begin{aligned}{x}^{′}=2x-xy \\\\ {y}^{′}=-6y+2xy\\end{aligned}\n$$\n\nwhere $x=x(t),y=y(t),$ and $a,b,c,$ and $d$ are positive constants.\n\nSelect the options below that best describe the dynamics of the system from point $A$ to point $B$ on the solution.\n\n$\\,$\nThe trajectory \n{{field-1}}{{field-2}}.\n\n$\\,$\nThe number of prey {{field-3}} and the number of predators {{field-4}}." :question/worked-solution "The Lotka-Volterra predator-prey model is given by\n\n$$\n{\\begin{aligned}{x}^{′}=ax-bxy \\\\ {y}^{′}=-cy+dxy\\end{aligned}\n$$\n\nwhere $a,b,c,d$ are positive real constants. Here, $x=x(t)$ represents the prey and $y=y(t)$ represents the predators.\n\nWith that in mind, let's examine the statements:\n\n- The trajectory $\\text{circles around}$ $\\text{the nonzero equilibrium}.$\n\n- From $A$ to $B,$ the number of prey $\\text{decreases}$ and the number of predators $\\text{increases}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334754/ma-source-field/1954c5a9e180875845c7923ed4d8e82ab452802753fd1e493997117a469351b9" "q-334754/ma-source-field/51e1245cdbc9aba2961c796fb316bb4ab7eeea8abada7aaadb90912b6889e6cb" "q-334754/ma-source-field/417b69673af4a2919ebcf6797291a1c663464cfcb9f0f9e926bb1f1a6aba8ba5" "q-334754/ma-source-field/0f07305a99488efa6339fee3569adca0eb64b77900a03278765ca03616023310"] :db/ensure [:question/validate]} {:db/id "q-334829/ma-source-field/4a5309f4aa170f9fa794109d91ba4c7ef77abccbe766f572e7a0a22267e72b77/53d82fe9de28f0ed63fb1ded8f44402dee96fce0effb12b68e34d31a340d63a7" :answer/id #uuid "f5085233-b908-5501-a0c5-0dcd0ec2f11c" :answer/type :answer.type/text :answer/value "differentiating under the integral sign" :db/ensure [:answer/validate]} {:db/id "q-334829/ma-source-field/4a5309f4aa170f9fa794109d91ba4c7ef77abccbe766f572e7a0a22267e72b77/9c65e771a257723f199dd36fcb93f8c4cd41ba850ff9c3d2716b7642d6951fbb" :answer/id #uuid "24a0f0c5-225e-579b-ac73-6b945a917dbb" :answer/type :answer.type/text :answer/value "integration by parts" :db/ensure [:answer/validate]} {:db/id "q-334829/ma-source-field/4a5309f4aa170f9fa794109d91ba4c7ef77abc