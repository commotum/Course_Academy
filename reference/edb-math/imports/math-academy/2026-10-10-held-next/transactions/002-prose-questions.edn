 {:db/id [:question/id #uuid "6ec67f6b-b339-5863-9fd2-be6322d61819"] :question/problem "What linear transformation is represented by the following matrix\n$[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}]?$" :question/worked-solution "We can find the images of the standard basis vectors $i$ and $j$ under the action of  $T,$ as follows:\n\n$$\n\\begin{aligned}T(i) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ T(j) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}10 \\\\ 1\\end{aligned}]=10i+j\\end{aligned}\n$$\n\nTherefore, the matrix represents a *horizontal* shear with a shear factor of $10.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12044/ma-source-field/73ff97e0544d296dd22c63ae40c8e96e5659a4628da3f05b99b27102f4d56255"] :db/ensure [:question/validate]}
 {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/72fd1f0079d054315a89de1a806511a99edf60de21f2577cbc2dfa13c97964c5" :answer/id #uuid "229bdc3a-27fc-56da-aa6a-896f13040c5d" :answer/type :answer.type/text :answer/value "$A$ and $B$ are mutually exclusive events, since $P(A\\cap B)=0$" :db/ensure [:answer/validate]}
 {:db/id "q-12549/ma-source-field/99d6d0ee8edba10392f436a3c5df138e10a745314cb4e9beb70459ef8320378d/9fb5c612ee365ea61ce6f134c95ae853f67289ad9f707d5c163f9eafe471bb65" :answer/id #uuid "5fb8d3e3-cdce-512d-ad4f-36dcf03d5780" :answer/type :answer.type/text :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)<P(A\\cup B)$" :db/ensure [:answer/validate]}
