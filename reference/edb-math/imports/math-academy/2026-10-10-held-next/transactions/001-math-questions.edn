 {:db/id "q-1187" :question/id #uuid "2e1f8f9b-8364-5550-a922-c34dacc07366" :question/math-academy-id "q-1187" :question/problem "Which set is a subset of $A={a,c,e}?$" :question/worked-solution "A set is a subset of $A$ if all its elements are elements of $A.$\n\nOf the given sets, only ${a}$ has all of its elements in $A.$\n\nTherefore, ${a}$ is a subset of $A.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1187/ma-source-field/9248669f8d2225fc0f8dfe8b751d4764c960f906dfe131b08baf6680cb617967"] :db/ensure [:question/validate]}
