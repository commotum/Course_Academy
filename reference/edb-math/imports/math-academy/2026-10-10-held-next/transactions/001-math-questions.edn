 {:db/id "q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f" :answer-field/id #uuid "aedcf9db-ed57-5dd9-8b52-eb742bee0864" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f/6ad07af0457fe965772f75854675049c88ddf4f0d74046124b969a43c76b0fa9" "q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f/62d16cbc11fc3f331992e0fa2dcd4fc77397b11a7322a01369670623a145c604" "q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f/f4b0bde7e622028251a6c2ea276463a2b42cd9d9046540957de2b709a4c74920" "q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f/3760ca40e03299ea9a0636e2b997169f0c9cd80c67acea57b5a54f16344e8bf4" "q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f/935aa158fd2c399ea2cda88ceb19dd30c987a40c650abf8e1a4e9380b623f35e"] :answer-field/correct "q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f/6ad07af0457fe965772f75854675049c88ddf4f0d74046124b969a43c76b0fa9" :db/ensure [:answer-field/validate]}
 {:db/id "q-7945" :question/id #uuid "e922303e-f1e5-5b8d-b2da-04cdac58e3ea" :question/math-academy-id "q-7945" :question/problem "Calculate ${Q}^{-1}$, where\n$Q=[\\begin{aligned}-3 & 1 \\\\ 5 & -2\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nQ=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $Q$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Q)=(-3)\\cdot (-2)-5\\cdot 1=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Q}^{-1} & =\\frac{1}{det(Q)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{1}[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Q{Q}^{-1} & =[\\begin{aligned}-3 & 1 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {Q}^{-1}Q & =[\\begin{aligned}-2 & -1 \\\\ -5 & -3\\end{aligned}][\\begin{aligned}-3 & 1 \\\\ 5 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7945/ma-source-field/cc1bf3d8c5a402bd5a37453db5da3ca9e356af22982aebed03c7f3cfae65a57f"] :db/ensure [:question/validate]}
