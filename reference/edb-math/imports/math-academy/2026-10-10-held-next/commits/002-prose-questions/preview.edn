86045585 true] [17592186396040 1084 #uuid "9b6f508a-4794-5f61-a64e-b20147d225cf" 13194139533467 17592186045585 true] [17592186396041 1081 "Lower triangular matrix" 13194139533467 17592186045585 true] [17592186396041 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396041 1084 #uuid "82b889e9-c745-5d62-97b1-40fc31c6e4bb" 13194139533467 17592186045585 true] [17592186396042 1081 "Diagonal matrix" 13194139533467 17592186045585 true] [17592186396042 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396042 1084 #uuid "a128b52e-7259-5003-b476-9857977d9aa6" 13194139533467 17592186045585 true] [17592186396043 1081 "Upper triangular matrix" 13194139533467 17592186045585 true] [17592186396043 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396043 1084 #uuid "530ba56a-9b9f-5e98-981e-3ca0aa7acb9b" 13194139533467 17592186045585 true] [17592186396044 1068 #edb/ref 17592186396045 13194139533467 17592186045585 true] [17592186396044 1069 "q-13781" 13194139533467 17592186045585 true] [17592186396044 1070 #edb/ref 17592186045485 13194139533467 17592186045585 true] [17592186396044 1071 "How can we best describe the following matrix? \n\n$$\nA=[\\begin{aligned}2 & 4 & 7 \\\\ 0 & 2 & 6 \\\\ 0 & 0 & 3\\end{aligned}]\n$$" 13194139533467 17592186045585 true] [17592186396044 1072 #uuid "ce57af24-7688-5285-99c2-a982d174d89c" 13194139533467 17592186045585 true] [17592186396044 1074 "Notice that $A$ is a matrix for which all entries below the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}2 & 4 & 7 \\\\ 0 & 2 & 6 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nTherefore, it is an upper triangular matrix.\n\nIt is not a lower triangular matrix or a diagonal matrix since there is a non-zero element above the diagonal: ${a}_{12}=4\\ne 0.$" 13194139533467 17592186045585 true] [17592186396045 1075 #edb/ref 17592186396046 13194139533467 17592186045585 true] [17592186396045 1075 #edb/ref 17592186396047 13194139533467 17592186045585 true] [17592186396045 1075 #edb/ref 17592186396048 13194139533467 17592186045585 true] [17592186396045 1075 #edb/ref 17592186396049 13194139533467 17592186045585 true] [17592186396045 1075 #edb/ref 17592186396050 13194139533467 17592186045585 true] [17592186396045 1076 #edb/ref 17592186045493 13194139533467 17592186045585 true] [17592186396045 1077 "selection" 13194139533467 17592186045585 true] [17592186396045 1079 #edb/ref 17592186396050 13194139533467 17592186045585 true] [17592186396045 1080 #uuid "2332d85e-5e88-505c-b823-5f0ae7f57fb3" 13194139533467 17592186045585 true] [17592186396046 1081 "Other" 13194139533467 17592186045585 true] [17592186396046 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396046 1084 #uuid "b3993775-0f8e-5c7e-b158-1a52fe75de99" 13194139533467 17592186045585 true] [17592186396047 1081 "Identity matrix" 13194139533467 17592186045585 true] [17592186396047 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396047 1084 #uuid "d4aa5d0b-3502-5db7-982d-257ca9d0ebb8" 13194139533467 17592186045585 true] [17592186396048 1081 "Lower triangular matrix" 13194139533467 17592186045585 true] [17592186396048 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396048 1084 #uuid "9c6da7fb-8eba-5ffa-9bde-d1144a8dbb47" 13194139533467 17592186045585 true] [17592186396049 1081 "Diagonal matrix" 13194139533467 17592186045585 true] [17592186396049 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396049 1084 #uuid "7bc5b9ce-5da0-55fe-8e2a-df8eb4ecfc52" 13194139533467 17592186045585 true] [17592186396050 1081 "Upper triangular matrix" 13194139533467 17592186045585 true] [17592186396050 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396050 1084 #uuid "6657fbe8-1958-5cc4-b147-eb6c679992c6" 13194139533467 17592186045585 true] [17592186396051 1068 #edb/ref 17592186396052 13194139533467 17592186045585 true] [17592186396051 1069 "q-13912" 13194139533467 17592186045585 true] [17592186396051 1070 #edb/ref 17592186045487 13194139533467 17592186045585 true] [17592186396051 1071 "Find the radius of convergence $R$ and interval of convergence $I$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}}\\,.\n$$" 13194139533467 17592186045585 true] [17592186396051 1072 #uuid "4c54e973-6e64-50b6-b096-4b16776e42ab" 13194139533467 17592186045585 true] [17592186396051 1074 "To apply the ratio test we define ${a}_{n}=\\frac{(x-1)^{3n}}{{n}^{3}}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-1)^{3(n+1)}}{(n+1)^{3}}\\cdot \\frac{{n}^{3}}{(x-1)^{3n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{{n}^{3}(x-1)^{3}}{(n+1)^{3}}| \\\\  & =|x-1{|}^{3}{lim}_{n\\to \\infty }{(\\frac{n}{n+1})}^{3} \\\\  & =|x-1{|}^{3}\\cdot 1 \\\\  & =|x-1{|}^{3}\\end{aligned}\n$$\n\nThe series converges if $L<1.$ Therefore,\n\n$$\n\\begin{aligned}|x-1{|}^{3} & <1 \\\\ |x-1| & <1 \\\\ -1<x-1 & <1 \\\\ 0<x & <2.\\end{aligned}\n$$\n\nSo, the radius of convergence is $R=1,$ and the series converges for any $x$ that lies in the open interval $(0,2).$\n\nThe ratio test gives no conclusion about the convergence of the series when $L=1.$ So, when $|x-1|=1,$ we do not know if the series converges. This means that the endpoints $x=0$ and $x=2$ need to be investigated separately using another test for convergence.\n\n- When $x=0$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{3}} \\\\  & =-1+\\frac{1}{{2}^{3}}-\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the alternating series test.\n\n- When $x=2$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(2-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}} \\\\  & =1+\\frac{1}{{2}^{3}}+\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the $p$-series test.\n\nConsequently, the interval of convergence is $I=[0,2].$" 13194139533467 17592186045585 true] [17592186396052 1075 #edb/ref 17592186396053 13194139533467 17592186045585 true] [17592186396052 1075 #edb/ref 17592186396054 13194139533467 17592186045585 true] [17592186396052 1075 #edb/ref 17592186396055 13194139533467 17592186045585 true] [17592186396052 1075 #edb/ref 17592186396056 13194139533467 17592186045585 true] [17592186396052 1075 #edb/ref 17592186396057 13194139533467 17592186045585 true] [17592186396052 1076 #edb/ref 17592186045493 13194139533467 17592186045585 true] [17592186396052 1077 "selection" 13194139533467 17592186045585 true] [17592186396052 1079 #edb/ref 17592186396056 13194139533467 17592186045585 true] [17592186396052 1080 #uuid "bdf61ccf-2627-5fa3-a051-531ba920ddff" 13194139533467 17592186045585 true] [17592186396053 1081 "$R=1$ and  $I=(0,2]$" 13194139533467 17592186045585 true] [17592186396053 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396053 1084 #uuid "71cb4bda-fc1e-5f5c-a387-81bc7f680311" 13194139533467 17592186045585 true] [17592186396054 1081 "$R=\\infty $ and  $I=(-\\infty ,\\infty )$" 13194139533467 17592186045585 true] [17592186396054 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396054 1084 #uuid "c5872ac5-73b0-58bc-a4ce-df051df3c8ad" 13194139533467 17592186045585 true] [17592186396055 1081 "$R=1$ and  $I=[0,2)$" 13194139533467 17592186045585 true] [17592186396055 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396055 1084 #uuid "de6804fa-3d4a-5001-8f45-18bc86c68bd6" 13194139533467 17592186045585 true] [17592186396056 1081 "$R=1$ and  $I=[0,2]$" 13194139533467 17592186045585 true] [17592186396056 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396056 1084 #uuid "a52347ba-5949-5d61-b02a-567dd46a130d" 13194139533467 17592186045585 true] [17592186396057 1081 "$R=1$ and  $I=(0,2)$" 13194139533467 17592186045585 true] [17592186396057 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396057 1084 #uuid "f635175f-1efc-5299-8c7e-5584974b36e7" 13194139533467 17592186045585 true] [17592186396058 1068 #edb/ref 17592186396059 13194139533467 17592186045585 true] [17592186396058 1069 "q-14050" 13194139533467 17592186045585 true] [17592186396058 1070 #edb/ref 17592186045487 13194139533467 17592186045585 true] [17592186396058 1071 "![](images/04/0470661491c0d9d44ecbbc3c87af70d4ff334f1ffd2ca56b68bd4c126f3d88de.png)\n\nWhat are the $x$-intercepts of the parabola shown above?" 13194139533467 17592186045585 true] [17592186396058 1072 #uuid "1270303e-0109-58be-ac65-6aecbfb8540f" 13194139533467 17592186045585 true] [17592186396058 1074 "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(3,-4)$ and passes through the point $(0,-\\frac{7}{4}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(3,-4)$ into the above gives\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+4).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,-\\frac{7}{4}),$ we substitute $x=0$ and $y=-\\frac{7}{4}$ into the equation and get\n\n$$\n\\begin{aligned}(0-3)^{2} & =4p(-\\frac{7}{4}+4) \\\\ 9 & =4p(\\frac{9}{4}) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(y+4).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(0+4) \\\\ (x-3)^{2} & =16 \\\\ x-3 & =\\pm 4 \\\\ x & =\\pm 4+3\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $7$ and $-1.$" 13194139533467 17592186045585 true] [17592186396059 1075 #edb/ref 17592186396060 13194139533467 17592186045585 true] [17592186396059 1075 #edb/ref 17592186396061 13194139533467 17592186045585 true] [17592186396059 1075 #edb/ref 17592186396062 13194139533467 17592186045585 true] [17592186396059 1075 #edb/ref 17592186396063 13194139533467 17592186045585 true] [17592186396059 1075 #edb/ref 17592186396064 13194139533467 17592186045585 true] [17592186396059 1076 #edb/ref 17592186045493 13194139533467 17592186045585 true] [17592186396059 1077 "selection" 13194139533467 17592186045585 true] [17592186396059 1079 #edb/ref 17592186396061 13194139533467 17592186045585 true] [17592186396059 1080 #uuid "1984d219-413d-5333-ac39-1acd7d9d0ec5" 13194139533467 17592186045585 true] [17592186396060 1081 "$8$ and $-1$" 13194139533467 17592186045585 true] [17592186396060 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396060 1084 #uuid "fbcf88a3-1e20-5a4c-bb86-1fe1bdaa1963" 13194139533467 17592186045585 true] [17592186396061 1081 "$7$ and $-1$" 13194139533467 17592186045585 true] [17592186396061 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396061 1084 #uuid "ae0d6ea0-c5ed-5e7f-9687-ab98aef0c28b" 13194139533467 17592186045585 true] [17592186396062 1081 "$9$ and $-2$" 13194139533467 17592186045585 true] [17592186396062 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396062 1084 #uuid "c4dc7a4e-aacb-5122-89ac-d5eb5d04a7da" 13194139533467 17592186045585 true] [17592186396063 1081 "$7$ and $-2$" 13194139533467 17592186045585 true] [17592186396063 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396063 1084 #uuid "950ec668-d2b7-5d89-8e4f-1d349b1209a4" 13194139533467 17592186045585 true] [17592186396064 1081 "$8$ and $-3$" 13194139533467 17592186045585 true] [17592186396064 1083 #edb/ref 17592186045500 1319413953