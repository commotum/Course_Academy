084 #uuid "4c73addd-4987-575f-af08-f65362be8bdf" 13194139533467 17592186045585 true] [17592186396024 1068 #edb/ref 17592186396025 13194139533467 17592186045585 true] [17592186396024 1069 "q-12997" 13194139533467 17592186045585 true] [17592186396024 1070 #edb/ref 17592186045487 13194139533467 17592186045585 true] [17592186396024 1071 "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." 13194139533467 17592186045585 true] [17592186396024 1072 #uuid "4870cb8f-66f0-5759-83b5-334830749092" 13194139533467 17592186045585 true] [17592186396024 1074 "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$" 13194139533467 17592186045585 true] [17592186396025 1075 #edb/ref 17592186396026 13194139533467 17592186045585 true] [17592186396025 1075 #edb/ref 17592186396027 13194139533467 17592186045585 true] [17592186396025 1075 #edb/ref 17592186396028 13194139533467 17592186045585 true] [17592186396025 1075 #edb/ref 17592186396029 13194139533467 17592186045585 true] [17592186396025 1075 #edb/ref 17592186396030 13194139533467 17592186045585 true] [17592186396025 1076 #edb/ref 17592186045493 13194139533467 17592186045585 true] [17592186396025 1077 "selection" 13194139533467 17592186045585 true] [17592186396025 1079 #edb/ref 17592186396029 13194139533467 17592186045585 true] [17592186396025 1080 #uuid "950ac440-c42e-5efd-8288-46527f1353b2" 13194139533467 17592186045585 true] [17592186396026 1081 "$p+q=64,\\,a=-12$ and $a=4$" 13194139533467 17592186045585 true] [17592186396026 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396026 1084 #uuid "596d615e-5286-5202-8b68-e459a1ad6de4" 13194139533467 17592186045585 true] [17592186396027 1081 "$p+q=68,\\,a=12$ and $a=-4$" 13194139533467 17592186045585 true] [17592186396027 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396027 1084 #uuid "ab85b611-a835-5c9b-b93a-92affdbe8c81" 13194139533467 17592186045585 true] [17592186396028 1081 "$p+q=60,\\,a=12$ and $a=-8$" 13194139533467 17592186045585 true] [17592186396028 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396028 1084 #uuid "cb49ee04-f343-57a4-b655-73c807196dc3" 13194139533467 17592186045585 true] [17592186396029 1081 "$p+q=68,\\,a=-12$ and $a=4$" 13194139533467 17592186045585 true] [17592186396029 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396029 1084 #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" 13194139533467 17592186045585 true] [17592186396030 1081 "$p+q=64,\\,a=-12$ and $a=-4$" 13194139533467 17592186045585 true] [17592186396030 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396030 1084 #uuid "1c7592ca-f49a-5a60-b8d5-154388f0691b" 13194139533467 17592186045585 true] [17592186396031 1068 #edb/ref 17592186396032 13194139533467 17592186045585 true] [17592186396031 1069 "q-13635" 13194139533467 17592186045585 true] [17592186396031 1070 #edb/ref 17592186045485 13194139533467 17592186045585 true] [17592186396031 1071 "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" 13194139533467 17592186045585 true] [17592186396031 1072 #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" 13194139533467 17592186045585 true] [17592186396031 1074 "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$" 13194139533467 17592186045585 true] [17592186396032 1075 #edb/ref 17592186396033 13194139533467 17592186045585 true] [17592186396032 1075 #edb/ref 17592186396034 13194139533467 17592186045585 true] [17592186396032 1075 #edb/ref 17592186396035 13194139533467 17592186045585 true] [17592186396032 1075 #edb/ref 17592186396036 13194139533467 17592186045585 true] [17592186396032 1075 #edb/ref 17592186396037 13194139533467 17592186045585 true] [17592186396032 1076 #edb/ref 17592186045493 13194139533467 17592186045585 true] [17592186396032 1077 "selection" 13194139533467 17592186045585 true] [17592186396032 1079 #edb/ref 17592186396033 13194139533467 17592186045585 true] [17592186396032 1080 #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" 13194139533467 17592186045585 true] [17592186396033 1081 "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" 13194139533467 17592186045585 true] [17592186396033 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396033 1084 #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" 13194139533467 17592186045585 true] [17592186396034 1081 "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" 13194139533467 17592186045585 true] [17592186396034 1083 #edb/ref 17592186045500 13194139533467 17592186045585 true] [17592186396034 1084 #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" 13194139533467 17592186045585 true] [17592