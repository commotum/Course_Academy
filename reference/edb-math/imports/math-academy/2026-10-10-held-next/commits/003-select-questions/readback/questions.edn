#{[{:db/id #edb/ref 17592186198850 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756d5e9-8c2b-5648-9cef-d57cf02e8e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\cdot {2}^{n}" :db/id #edb/ref 17592186396251} {:answer/id #uuid "de50addf-3149-5f58-b066-97f2f40179d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot {2}^{n}" :db/id #edb/ref 17592186396252} {:answer/id #uuid "cf715dcc-e03e-5ea8-aeed-f7ac4fdc33cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\cdot {3}^{n}" :db/id #edb/ref 17592186396253} {:answer/id #uuid "7855bcc5-306f-5477-83df-730bda1dbba3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\cdot {3}^{n}" :db/id #edb/ref 17592186396254} {:answer/id #uuid "9b1a1661-077d-5469-a87e-386432d18ff0" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{n}" :db/id #edb/ref 17592186396255}] :answer-field/correct {:answer/id #uuid "de50addf-3149-5f58-b066-97f2f40179d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot {2}^{n}" :db/id #edb/ref 17592186396252} :answer-field/id #uuid "3da75658-493e-5414-9ef4-07db0edd9ac6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396250} {:answer-field/choices [{:answer/id #uuid "02e44344-d16a-5d1d-af75-d63577743717" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186396257} {:answer/id #uuid "717cb1ad-26fb-5d39-b775-f38b2206a689" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396258} {:answer/id #uuid "5a2860f0-b7f1-553d-a57e-50270b5ec131" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396259}] :answer-field/correct {:answer/id #uuid "717cb1ad-26fb-5d39-b775-f38b2206a689" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396258} :answer-field/id #uuid "95707686-21cc-5e61-98a8-5364df18a6b6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a35af51-a0e2-50d0-bbd3-1c0dc3bc52aa" :question/math-academy-id "q-183328" :question/problem "Describe the set $S={…,3,6,12,24,48,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=6$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n\\in {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,3,\\,6,\\,12,\\,24,\\,48,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=2:$\n\n$$\n\\begin{aligned}r & =2 \\\\  & =\\frac{6}{3} \\\\  & =\\frac{12}{6} \\\\  & =\\frac{24}{12} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=6,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =6\\cdot {2}^{n-1} \\\\  & =6\\cdot {2}^{n}\\cdot {2}^{-1} \\\\  & =\\frac{6}{2}\\cdot {2}^{n} \\\\  & =3\\cdot {2}^{n}\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={3\\cdot {2}^{n}\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396260 :knowledge-point/_questions [{:knowledge-point/id #uuid "f49ef1c2-06de-597c-bf4d-6d613989987e" :knowledge-point/title "Expressing a Set Using a Conditional Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b665804-beaa-5388-ac25-9397d16709cc" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186396262} {:answer/id #uuid "cc29d216-b4b5-5d05-aee8-fa1d64f964da" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186