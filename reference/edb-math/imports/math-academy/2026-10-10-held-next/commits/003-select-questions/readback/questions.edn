7592186396280} {:answer/id #uuid "4b01f46e-a6d8-5d85-8294-dd04cf1ec431" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186396281} {:answer/id #uuid "9af95e75-b547-5b9a-b7ee-b27c4632da32" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396282} {:answer/id #uuid "72567fb8-bb36-5d69-9f9f-77f8bf171a59" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396283}] :answer-field/correct {:answer/id #uuid "9af95e75-b547-5b9a-b7ee-b27c4632da32" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396282} :answer-field/id #uuid "6a84e706-f8a4-5257-b5e4-288cbb329337" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396279} {:answer-field/choices [{:answer/id #uuid "2befce7e-6bda-56f4-85c6-151df854ad1a" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186396285} {:answer/id #uuid "742689fb-929e-5feb-906c-fbfb621bb2b4" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186396286} {:answer/id #uuid "31e1d7c2-ae20-5225-b711-5734fede4221" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186396287}] :answer-field/correct {:answer/id #uuid "742689fb-929e-5feb-906c-fbfb621bb2b4" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186396286} :answer-field/id #uuid "3bddb846-86d1-5aab-af04-f126a3e0241d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396284}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7d216bb-dfa7-5628-bdfc-1e83e087d571" :question/math-academy-id "q-183691" :question/problem "Describe the set $S={-25,-24,-23,…}$ using a conditional definition.\n\n$$\nS={x\\in {{field-1}}\\,:\\,x\\ge {{field-2}}}\n$$" :question/worked-solution "The set $S$ contains all integers greater than or equal to $-25.$\n\nTherefore, the set can be written as\n\n$$\nS={x\\in Z\\,:\\,x\\ge -25}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $x>-26.$ This gives\n\n$$\nS={x\\in Z\\,:\\,x>-26}.\n$$"}] [{:db/id #edb/ref 17592186396288 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "868594c4-bb93-514c-ac51-c1c9e6bfcb88" :answer/type {:db/ident :answer.type/math} :answer/value "2n-1" :db/id #edb/ref 17592186396290} {:answer/id #uuid "44fdec78-debe-581c-bba1-42fc35ac4a60" :answer/type {:db/ident :answer.type/math} :answer/value "3n-1" :db/id #edb/ref 17592186396291} {:answer/id #uuid "621d9706-b783-5b07-ba14-823fc7b80c40" :answer/type {:db/ident :answer.type/math} :answer/value "3n+2" :db/id #edb/ref 17592186396292} {:answer/id #uuid "4a9b70f3-1724-5f8c-bed1-b0e33e076e00" :answer/type {:db/ident :answer.type/math} :answer/value "n+2" :db/id #edb/ref 17592186396293} {:answer/id #uuid "0e25f793-a364-5722-ac5b-c3fa6dbfe857" :answer/type {:db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186396294}] :answer-field/correct {:answer/id #uuid "0e25f793-a364-5722-ac5b-c3fa6dbfe857" :answer/type {:db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186396294} :answer-field/id #uuid "7276c096-7c91-5c64-86eb-a307d21f6404" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396289} {:answer-field/choices [{:answer/id #uuid "04ee3e41-783e-5133-b3d1-e05d03af2794" :answer/type {:db/ident :answer.type/math} :answer/value "\\in R" :db/id #edb/ref 17592186396296} {:answer/id #uuid "27f930c0-e938-5469-bfc7-735aea18070a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186396297} {:answer/id #uuid "66dff9cb-bf42-57d5-883c-94392707c46e" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186396298} {:answer/id #uuid "e63aaee2-6c84-5ac0-978c-26fd52342809" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186396299} {:answer/id #uuid "8b3e5104-6400-55d6-9958-534c229e6346" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396300}] :answer-field/correct {:answer/id #uuid "8b3e5104-6400-55d6-9958-534c229e6346" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396300} :answer-field/id #uuid "d6887cac-fd2a-5aca-b3d7-a80a851334f5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1d88cc5-5f34-51c6-bb45-73abd209e524" :question/math-academy-id "q-183765" :question/problem "Describe the set $S={...,3,6,9,12,15,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=3$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,3,\\,6,\\,9,\\,12,\\,15,\\,…\n$$\n\nform a two-way infinite arithmetic sequence with common difference $d=3:$\n\n$$\n\\begin{aligned}d & =3 \\\\  & =6-3 \\\\  & =9-6 \\\\  & =12-9 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=3,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =3+(n-1)\\cdot 3 \\\\  & =3+3n-3 \\\\  & =3n.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={3n\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396301 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9bae499-f34b-5016-9461-368af2cdb041" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186396303} {:answer/id #uuid "4bff9b25-c305-524e-bcfc-903c51f12d8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186396304} {:answer/id #uuid "9b94e92e-1568-5b4e-bda8-31144db89020" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186396305} {:answer/id #uuid "bc8dec5b-0116-5957-b5fa-17562ad4dedd" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396306} {:answer/id #uuid "7057538c-ea56-567c-bd8b-58c32e89c076" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Q" :db/id #edb/ref 17592186396307}] :answer-field/correct {:answer/id #uuid "bc8dec5b-0116-5957-b5fa-17562ad4dedd" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396306} :answer-field/id #uuid "7e336390-93f8-593c-a530-18de4565cfde" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396302} {:answer-field/choices [{:answer/id #uuid "4bd5cf80-3e0e-5fd7-9676-437495032f16" :answer/type {:db/ident :answer.type/math} :answer/value "2n-1" :db/id #edb/ref 17592186396309} {:answer/id #uuid "d5776c2c-cddc-5739-beee-d840972a786d" :answer/type {:db/ident :answer.type/math} :answer/value "n+4" :db/id #edb/ref 17592186396310} {:answer/id #uuid "7cd95755-dca6-5b08-98d0-e1f3bc66a997" :answer/type {:db/ident :answer.type/math} :answer/value "7n" :db/id #edb/ref 17592186396311} {:answer/id #uuid "25654cbf-bd5b-5439-b1b9-1906aed8924a" :answer/type {:db/ident :answer.type/math} :answer/value "4n+21" :db/id #edb/ref 17592186396312} {:answer/id #uuid "acb513d2-bb61-560d-b7ae-ae91a2b9a5c1" :answer/type {:db/ident :answer.type/math} :answer/value "4n-9" :db/id #edb/ref 17592186396313}] :answer-field/correct {:answer/id #uuid "acb513d2-bb61-560d-b7ae-ae91a2b9a5c1" :answer/type {:db/ident :answer.type/math} :answer/value "4n-9" :db/id #edb/ref 17592186396313} :answer-field/id #uuid "6a7e0a5f-4cf1-59db-9367-f78b99f89e32" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c89879b-39a9-51be-ab30-8cb400364aca" :question/math-academy-id "q-183770" :question/problem "Describe the set $S={...,-21,-17,-13,-9,-5,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=-5$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,-21,\\,-17,\\,-13,\\,-9,\\,-5,\\,…\n$$\n\nform a two-way infinite arithmetic sequence with common difference $d=4:$\n\n$$\n\\begin{aligned}d & =4 \\\\  & =-17-(-21) \\\\  & =-13-(-17) \\\\  & =-9-(-13) \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=-5,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =-5+(n-1)\\cdot 4 \\\\  & =-5+4n-4 \\\\  & =4n-9.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={4n-9\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396314 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04884edb-26ab-5691-9276-5a39738b7de0" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\cdot {2}^{n}" :db/id #edb/ref 17592186396316} {:answer/id #uuid "8f61797a-9b84-55c2-bfde-709089f59a51" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186396317} {:answer/id #uuid "732edcb4-4e31-5d86-b075-68edffdf6963" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)^{n}" :db/id #edb/ref 17592186396318} {:answer/id #uuid "d360ed39-2b76-51e2-859d-ae7636a79a4a" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{n}" :db/id #edb/ref 17592186396319}] :answer-field/correct {:answer/id #uuid "732edcb4-4e31-5d86-b075-68edffdf6963" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)^{n}" :db/id #edb/ref 17592186396318} :answer-field/id #uuid "c64fd775-19c5-5b37-86f3-813ff79fb5b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396315} {:answer-field/choices [{:answer/id #uuid "e84aa15b-0075-53b2-b2ee-5252c71d7011" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186396321} {:answer/id #uuid "a60ac30c-7330-5393-9ba5-55b438cda2bc" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396322} {:answer/id #uuid "e0c270a0-906e-5613-bfea-1079300a2d5f" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396323}] :answer-field/correct {:answer/id #uuid "a60ac30c-7330-5393-9ba5-55b438cda2bc" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396322} :answer-field/id #uuid "36af3b8d-7ebd-56b9-a4c0-8231f0ff2499" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40643ae6-fe96-508d-ba25-a4e8d94924cc" :question/math-academy-id "q-183771" :question/problem "Describe the set $S={…,-2,4,-8,16,-32,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=-2$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n\\in {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,-2,\\,4,\\,-8,\\,16,\\,-32,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=-2:$\n\n$$\n\\begin{aligned}r & =-2 \\\\  & =(\\frac{4}{-2}) \\\\  & =(\\frac{-8}{4}) \\\\  & =(\\frac{16}{-8}) \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=-2,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =-2\\cdot (-2)^{n-1} \\\\  & =-2\\cdot (-2)^{n}\\cdot (-2)^{-1} \\\\  & =\\frac{-2}{-2}\\cdot (-2)^{n} \\\\  & =(-2)^{n}.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={(-2)^{n}\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396324 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd" :knowledge-point/title "Proving the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "565d4699-585c-59ff-8946-cbdc268b0c14" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-1)t}" :db/id #edb/ref 17592186396326} {:answer/id #uuid "2f34b198-133c-5315-a86b-d31d8a6f1738" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s-1)t}" :db/id #edb/ref 17592186396327} {:answer/id #uuid "dfc0db2c-91be-581b-800f-9ebf7f1c9be0" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s+1)t}" :db/id #edb/ref 17592186396328} {:answer/id #uuid "cc5232e1-5fa0-5561-93b3-1946ca031a8a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s+1)t}" :db/id #edb/ref 17592186396329}] :answer-field/correct {:answer/id #uuid "565d4699-585c-59ff-8946-cbdc268b0c14" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-1)t}" :db/id #edb/ref 17592186396326} :answer-field/id #uuid "d858d9ef-a7c9-5447-928a-43ac88428e2c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/re