39533466 17592186045585 true] [17592186395764 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395764 1084 #uuid "932f6c0b-7bfc-5138-a5fc-88d5849899ad" 13194139533466 17592186045585 true] [17592186395765 1081 "(2,0)" 13194139533466 17592186045585 true] [17592186395765 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395765 1084 #uuid "62a3c355-7a46-5e69-a9b4-100e157d8443" 13194139533466 17592186045585 true] [17592186395766 1081 "(\\frac{13}{2},0)" 13194139533466 17592186045585 true] [17592186395766 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395766 1084 #uuid "1acd5f2b-ea97-5c92-bd3f-4c0fa0954dc3" 13194139533466 17592186045585 true] [17592186395767 1081 "(-\\frac{2}{13},0)" 13194139533466 17592186045585 true] [17592186395767 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395767 1084 #uuid "de725257-e555-5095-bd67-53b03fd19c7d" 13194139533466 17592186045585 true] [17592186395768 1068 #edb/ref 17592186395769 13194139533466 17592186045585 true] [17592186395768 1069 "q-15589" 13194139533466 17592186045585 true] [17592186395768 1070 #edb/ref 17592186045487 13194139533466 17592186045585 true] [17592186395768 1071 "The water boils in a pan at a temperature of ${100}^{∘}C.$ The pan with water is then placed to a room with a temperature of ${25}^{∘}C,$ and the temperature of water decreases. After $5$ minutes, it cools to ${90}^{∘}C.$ To the nearest minute, how long does it take for the water to have a temperature of ${30}^{∘}C?$ \n\n*Hint: You may assume that the temperature reading $T(t)$ of the water in the pan decreases at a rate that obeys Newton's law of cooling, where $T$ is measured in degrees Celsius and $t>0$ is the time, in minutes, since the water starts cooling.*" 13194139533466 17592186045585 true] [17592186395768 1072 #uuid "02ce9872-8986-5e67-bea1-b49d589c24ac" 13194139533466 17592186045585 true] [17592186395768 1074 "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the inhibited decay equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={25}^{∘}\\text{C},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-25).\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-25} & =-k\\,dt \\\\ \\int \\frac{dT}{T-25} & =-k\\int dt \\\\ \\operatorname{ln}⁡|T-25| & =-kt+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-25>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-25 & ={e}^{-kt+C} \\\\ T-25 & ={e}^{C}{e}^{-kt} \\\\ T-25 & =K{e}^{-kt} \\\\ T & =25+K{e}^{-kt}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nWe're told that the initial temperature was ${100}^{∘}C.$ So, we apply the initial condition $T(0)=100,$ and solve for $K:$\n\n$$\n\\begin{aligned}100 & =25+K{e}^{0} \\\\ 100 & =25+K \\\\ K & =75\\end{aligned}\n$$\n\nTherefore, we have the following expression for $T(t):$\n\n$$\nT(t)=25+75{e}^{-kt}\n$$\n\nWe're also told that, after $5$ minutes, it cools to ${90}^{∘}C.$ So, applying the condition $T(5)=90,$ we can solve for $k:$\n\n$$\n\\begin{aligned}90 & =25+75{e}^{-5k} \\\\ 65 & =75{e}^{-5k} \\\\ \\frac{13}{15} & ={e}^{-5k} \\\\ \\operatorname{ln}⁡(\\frac{13}{15}) & =-5k \\\\ k & =-\\frac{1}{5}\\operatorname{ln}⁡(\\frac{13}{15})\\end{aligned}\n$$\n\nFinally, let ${t}_{1}$ be the time when the water has a temperature of ${30}^{∘}C.$ Then, we have\n\n$$\n\\begin{aligned}T({t}_{1}) & =30 \\\\ 25+75{e}^{-k{t}_{1}} & =30 \\\\ 75{e}^{-k{t}_{1}} & =5 \\\\ {e}^{-k{t}_{1}} & =\\frac{1}{15} \\\\ -k{t}_{1} & =\\operatorname{ln}⁡(\\frac{1}{15}) \\\\ {t}_{1} & =-\\frac{1}{k}\\operatorname{ln}⁡(\\frac{1}{15}).\\end{aligned}\n$$\n\nSubstituting in our value for $k,$ we conclude that the temperature of water will be ${30}^{∘}C$ after\n\n$$\n{t}_{1}=\\frac{-\\operatorname{ln}⁡(\\frac{1}{15})}{-\\frac{1}{5}\\operatorname{ln}⁡(\\frac{13}{15})}≈95\\,\\text{min},\n$$\n\nrounded to the nearest minute." 13194139533466 17592186045585 true] [17592186395769 1075 #edb/ref 17592186395770 13194139533466 17592186045585 true] [17592186395769 1075 #edb/ref 17592186395771 13194139533466 17592186045585 true] [17592186395769 1075 #edb/ref 17592186395772 13194139533466 17592186045585 true] [17592186395769 1075 #edb/ref 17592186395773 13194139533466 17592186045585 true] [17592186395769 1075 #edb/ref 17592186395774 13194139533466 17592186045585 true] [17592186395769 1076 #edb/ref 17592186045493 13194139533466 17592186045585 true] [17592186395769 1077 "selection" 13194139533466 17592186045585 true] [17592186395769 1079 #edb/ref 17592186395771 13194139533466 17592186045585 true] [17592186395769 1080 #uuid "fca47f9c-32af-5d7e-92a5-e9a1ab61bc65" 13194139533466 17592186045585 true] [17592186395770 1081 "87\\,\\text{min}" 13194139533466 17592186045585 true] [17592186395770 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395770 1084 #uuid "893f4780-2c8b-522b-8087-2fc24822ebd4" 13194139533466 17592186045585 true] [17592186395771 1081 "95\\,\\text{min}" 13194139533466 17592186045585 true] [17592186395771 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395771 1084 #uuid "93cd5cdd-b047-544f-b7e7-fee685cf62f6" 13194139533466 17592186045585 true] [17592186395772 1081 "98\\,\\text{min}" 13194139533466 17592186045585 true] [17592186395772 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395772 1084 #uuid "ef24ffa0-3d6e-5335-9009-9906ff059c99" 13194139533466 17592186045585 true] [17592186395773 1081 "89\\,\\text{min}" 13194139533466 17592186045585 true] [17592186395773 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395773 1084 #uuid "d38f97ca-3e74-5b74-90a6-ef1513732aca" 13194139533466 17592186045585 true] [17592186395774 1081 "67\\,\\text{min}" 13194139533466 17592186045585 true] [17592186395774 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395774 1084 #uuid "96517c6b-bae9-503f-9f98-d3f004b861a0" 13194139533466 17592186045585 true] [17592186395775 1068 #edb/ref 17592186395776 13194139533466 17592186045585 true] [17592186395775 1069 "q-20512" 13194139533466 17592186045585 true] [17592186395775 1070 #edb/ref 17592186045487 13194139533466 17592186045585 true] [17592186395775 1071 "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+y+2z=1 \\\\  & 2x+3y+4z=6 \\\\  & 3x+3y+4z=11\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and hence solve the linear system." 13194139533466 17592186045585 true] [17592186395775 1072 #uuid "3437106d-95df-5058-942b-4f64c5179bc5" 13194139533466 17592186045585 true] [17592186395775 1074 "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 2 & 3 & 4 & 6 \\\\ 3 & 3 & 4 & 11\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 2 & 3 & 4 & 6 \\\\ 3 & 3 & 4 & 11\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 3 & 3 & 4 & 11\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & -2 & 8\\end{aligned}] & {R}_{3} & :=-\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -4\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n{\\begin{aligned} & x+y+2z=1 \\\\  & y=4 \\\\  & z=-4\\end{aligned}\n$$\n\nand we can apply back substitution. Substituting both $y=4$ and $z=-4$ into the first equation, we get\n\n$$\nx+(4)+2(-4)=1\\,⟹\\,x=5.\n$$\n\nTherefore, the solution is $x=5,y=4$, and $z=-4.$ Or, in vector form, $⟨5,4,-4⟩.$" 13194139533466 17592186045585 true] [17592186395776 1075 #edb/ref 17592186395777 13194139533466 17592186045585 true] [17592186395776 1075 #edb/ref 17592186395778 13194139533466 17592186045585 true] [17592186395776 1075 #edb/ref 17592186395779 13194139533466 17592186045585 true] [17592186395776 1075 #edb/ref 17592186395780 13194139533466 17592186045585 true] [17592186395776 1075 #edb/ref 17592186395781 13194139533466 17592186045585 true] [17592186395776 1076 #edb/ref 17592186045493 13194139533466 17592186045585 true] [17592186395776 1077 "selection" 13194139533466 17592186045585 true] [17592186395776 1079 #edb/ref 17592186395779 13194139533466 17592186045585 true] [17592186395776 1080 #uuid "2a758e48-dc27-560b-a0af-fd01b7ea572b" 13194139533466 17592186045585 true] [17592186395777 1081 "⟨1,4,-2⟩" 13194139533466 17592186045585 true] [17592186395777 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395777 1084 #uuid "23b6f110-fbc4-5322-8a05-6366ff4c13c0" 13194139533466 17592186045585 true] [17592186395778 1081 "⟨3,2,-2⟩" 13194139533466 17592186045585 true] [17592186395778 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395778 1084 #uuid "e6302263-6554-5d2f-bdfe-094ceb26b042" 13194139533466 17592186045585 true] [17592186395779 1081 "⟨5,4,-4⟩" 13194139533466 17592186045585 true] [17592186395779 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395779 1084 #uuid "337c9891-a990-5356-ae53-39e28e060932" 13194139533466 17592186045585 true] [17592186395780 1081 "⟨13,-4,-4⟩" 13194139533466 17592186045585 true] [17592186395780 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395780 1084 #uuid "12ab6864-c814-589e-8f72-328eeae44af0" 13194139533466 17592186045585 true] [17592186395781 1081 "⟨-11,4,4⟩" 13194139533466 17592186045585 true] [17592186395781 1083 #edb/ref 