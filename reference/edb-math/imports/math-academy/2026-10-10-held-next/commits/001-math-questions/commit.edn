ince it is a linearly independent set and its vectors generate $\\text{Null}(A).$" 13194139533466 17592186045585 true] [17592186395832 1075 #edb/ref 17592186395833 13194139533466 17592186045585 true] [17592186395832 1075 #edb/ref 17592186395834 13194139533466 17592186045585 true] [17592186395832 1075 #edb/ref 17592186395835 13194139533466 17592186045585 true] [17592186395832 1075 #edb/ref 17592186395836 13194139533466 17592186045585 true] [17592186395832 1075 #edb/ref 17592186395837 13194139533466 17592186045585 true] [17592186395832 1076 #edb/ref 17592186045493 13194139533466 17592186045585 true] [17592186395832 1077 "selection" 13194139533466 17592186045585 true] [17592186395832 1079 #edb/ref 17592186395836 13194139533466 17592186045585 true] [17592186395832 1080 #uuid "eb2dd0d4-9bed-58b4-940b-d9ecf1e1866c" 13194139533466 17592186045585 true] [17592186395833 1081 "B={[\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}]}" 13194139533466 17592186045585 true] [17592186395833 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395833 1084 #uuid "f7d068a8-8c16-5895-a8a0-6d5c967450ba" 13194139533466 17592186045585 true] [17592186395834 1081 "B={[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]}" 13194139533466 17592186045585 true] [17592186395834 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395834 1084 #uuid "6cdaec59-e1c5-5eb0-a903-7aa07bfa40a8" 13194139533466 17592186045585 true] [17592186395835 1081 "B={[\\begin{aligned}-2 \\\\ 0 \\\\ 1\\end{aligned}]}" 13194139533466 17592186045585 true] [17592186395835 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395835 1084 #uuid "4f9a7859-76ff-5f7c-b9ba-abb5dc1b6768" 13194139533466 17592186045585 true] [17592186395836 1081 "B={[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]}" 13194139533466 17592186045585 true] [17592186395836 1083 #edb/ref 17592186045499 13194139533466 17592186045585 true] [17592186395836 1084 #uuid "b21e78e2-0491-596e-bd15-82fb1e997dcd"