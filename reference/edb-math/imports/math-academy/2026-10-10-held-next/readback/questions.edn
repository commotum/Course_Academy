#{[{:db/id #edb/ref 17592186395977 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5420a5d8-e27c-54cd-8d4a-8807ed506a3f" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186395979} {:answer/id #uuid "b3896d35-3d39-5b8b-8500-59d135ad3570" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186395980} {:answer/id #uuid "6a6fdac5-53dc-5a87-9dff-5c99baea1ce1" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186395981} {:answer/id #uuid "54e5febe-e5c5-53fd-b8eb-4a5c7c0dad20" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 9" :db/id #edb/ref 17592186395982} {:answer/id #uuid "7aae46ab-d345-5f44-b157-efc8fa3bed1b" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186395983}] :answer-field/correct {:answer/id #uuid "6a6fdac5-53dc-5a87-9dff-5c99baea1ce1" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186395981} :answer-field/id #uuid "703485af-d39d-5b69-a26a-bac078d2ad7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395978}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "296c1691-3fdb-50aa-926f-7c3fb307cb51" :question/math-academy-id "q-10485" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4}=1$ intersects the line $y=x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{9}-\\frac{{x}^{2}}{4} & =1 \\\\ \\frac{4{x}^{2}}{36}-\\frac{9{x}^{2}}{36} & =1 \\\\ -\\frac{5{x}^{2}}{36} & =1 \\\\ 5{x}^{2} & =-36\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, the hyperbola does not intersect the line $y=x.$"}] [{:db/id #edb/ref 17592186395706 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f1f99d3-ebcb-50c6-a162-bd58f7d5ec92" :knowledge-point/title "Listing the Elements in a Power Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c68f1dd2-03d2-5740-94ed-dd626d46f6b3" :answer/type {:db/ident :answer.type/math} :answer/value "{{k},{m},{o},{k,m,o}}" :db/id #edb/ref 17592186395708} {:answer/id #uuid "4847a07c-27ac-5d41-8e04-74016b71055d" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,k,m,o,{k,m},{k,o},{m,o},{k,m,o}}" :db/id #edb/ref 17592186395709} {:answer/id #uuid "892a1a7e-6740-5566-9d93-02c8f061a176" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{k},{m},{o},{k,m},{k,o},{m,o}}" :db/id #edb/ref 17592186395710} {:answer/id #uuid "1c642559-c07c-5b96-9b10-c8fd4b786536" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{k},{m},{o},{k,m},{k,o},{m,o},{k,m,o}}" :db/id #edb/ref 17592186395711} {:answer/id #uuid "5bdd6101-a4a3-518a-be2d-154894e274e0" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{k,m,o}}" :db/id #edb/ref 17592186395712}] :answer-field/correct {:answer/id #uuid "1c642559-c07c-5b96-9b10-c8fd4b786536" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{k},{m},{o},{k,m},{k,o},{m,o},{k,m,o}}" :db/id #edb/ref 17592186395711} :answer-field/id #uuid "6ae388ac-af79-5c93-8a5c-40f556580b1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395707}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a851309-6577-5c09-b5b9-0e83f2309404" :question/math-academy-id "q-105123" :question/problem "If $T={k,m,o},$ then $P(T)=$" :question/worked-solution "The power set of $T,$ denoted $P(T),$ is the set that contains every possible subset of $T,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $T$ using a tree diagram.\n\n![](images/1e/1ef8e646081305399cddbf6908bd8415d908dab3e9bb0e371d68b33e62084774.png)\n\nAccording to our diagram, the subsets of $T$ are\n\n$$\n∅={},\\,{k},\\,{m},\\,{o},\\,{k,m},\\,{k,o},\\,{m,o},\\,{k,m,o}.\n$$\n\nTherefore, we have\n\n$$\nP(T)={∅,{k},{m},{o},{k,m},{k,o},{m,o},{k,m,o}}.\n$$"}] [{:db/id #edb/ref 17592186395984 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2f6a868-46fe-5529-a464-b6f3e0243d30" :knowledge-point/title "Identifying a Singular 3x3 System of Equations That Has No Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ffe24a8-fe0e-5039-81c0-fb9631f878a1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-y-z \\\\ 4-z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395986} {:answer/id #uuid "30c4ec68-4b39-55b5-8e7c-bbe84a2b4057" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3y \\\\ y \\\\ 4y-1\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395987} {:answer/id #uuid "bc323d4c-6ab9-5df2-881f-281eabd5b981" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186395988} {:answer/id #uuid "3bac1b8f-a5a2-5c6f-9f74-53d3dc54a0d1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1-3y \\\\ y \\\\ 2+y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395989} {:answer/id #uuid "ca74fa9e-2937-5e51-b664-ed9cfa05d409" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2-y-z \\\\ 1+z \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186395990}] :answer-field/correct {:answer/id #uuid "bc323d4c-6ab9-5df2-881f-281eabd5b981" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186395988} :answer-field/id #uuid "2f5eaa46-bf95-53b6-ace1-3bd33b1c4991" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395985}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "06de5100-449e-5af5-b65a-4e9e27bdf01a" :question/math-academy-id "q-10662" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 2 & 1 & 5 & 0\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 2 & 1 & 5 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 0 & -1 & 3 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 2 \\\\ 0 & 1 & -3 & 1 \\\\ 0 & 0 & 0 & -3\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+y+z=2 \\\\ 0x+y-3z=1 \\\\ 0x+0y+0z=-3\\end{aligned}\n$$\n\nSince there are no such numbers $x,y,z$ that form a solution of the final equation $0x+0y+0z=-3,$ we can conclude that our system has no solution."}] [{:db/id #edb/ref 17592186395713 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaf6ad71-0776-59f5-ae8e-e23508ea8571" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,e}" :db/id #edb/ref 17592186395715} {:answer/id #uuid "3a78632c-31c5-5799-a13e-27dbef4403c2" :answer/type {:db/ident :answer.type/math} :answer/value "{a,c,d}" :db/id #edb/ref 17592186395716} {:answer/id #uuid "fea08b19-d9ad-5b00-a63a-5ea91baecabf" :answer/type {:db/ident :answer.type/math} :answer/value "{a}" :db/id #edb/ref 17592186395717} {:answer/id #uuid "7f76d84d-edad-5055-8363-012ec4913321" :answer/type {:db/ident :answer.type/math} :answer/value "{a,c,d,e}" :db/id #edb/ref 17592186395718} {:answer/id #uuid "be2b96b7-cd00-5667-8def-bf8968e7432a" :answer/type {:db/ident :answer.type/math} :answer/value "{a,b,c}" :db/id #edb/ref 17592186395719}] :answer-field/correct {:answer/id #uuid "fea08b19-d9ad-5b00-a63a-5ea91baecabf" :answer/type {:db/ident :answer.type/math} :answer/value "{a}" :db/id #edb/ref 17592186395717} :answer-field/id #uuid "92c286e3-8c6f-5f48-bdb9-fe1f78df792e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e1f8f9b-8364-5550-a922-c34dacc07366" :question/math-academy-id "q-1187" :question/problem "Which set is a subset of $A={a,c,e}?$" :question/worked-solution "A set is a subset of $A$ if all its elements are elements of $A.$\n\nOf the given sets, only ${a}$ has all of its elements in $A.$\n\nTherefore, ${a}$ is a subset of $A.$"}] [{:db/id #edb/ref 17592186092522 :knowledge-point/_questions [{:knowledge-point/id #uuid "6cd4158d-6baf-5a61-96a2-74c66231d082" :knowledge-point/title "Calculating the Eigenvalues of a Triangular/Diagonal Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403a1993-2eb3-586b-abbd-dfbb80940fae" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =4$ (double root)" :db/id #edb/ref 17592186395992} {:answer/id #uuid "b8a6ca2d-3dc9-5356-a637-77388249f113" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =-\\sqrt{3}$" :db/id #edb/ref 17592186395993} {:answer/id #uuid "21c5c9ca-97c8-5152-9b6c-25a5632a907d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{3}$ and $\\lambda =2$" :db/id #edb/ref 17592186395994} {:answer/id #uuid "87da898e-ea6a-541f-9651-68144afb0f0f" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\lambda =\\sqrt{3}$" :db/id #edb/ref 17592186395995} {:answer/id #uuid "46e8370f-0146-536e-a75f-2dc4592b1276" :answer/type {:db/ident :answer.type/text} :answer/value "There are no real eigenvalues" :db/id #edb/ref 17592186395996}] :answer-field/correct {:answer/id #uuid "21c5c9ca-97c8-5152-9b6c-25a5632a907d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\lambda =\\sqrt{3}$ and $\\lambda =2$" :db/id #edb/ref 17592186395994} :answer-field/id #uuid "b1ec3bb9-10bd-5719-b579-dd5c85d65b96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395991}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1fb4b20-223a-5224-b15e-06a76416065c" :question/math-academy-id "q-11983" :question/problem "Find all real eigenvalues of the matrix\n$A=[\\begin{aligned}\\sqrt{3} & 0 \\\\ 4 & 2\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}\\sqrt{3}-\\lambda  & 0 \\\\ 4 & 2-\\lambda \\end{aligned}]\n$$\n\nNow, let's find and solve the characteristic equation $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}\\sqrt{3}-\\lambda  & 0 \\\\ 4 & 2-\\lambda \\end{aligned}| & =0 \\\\ (\\sqrt{3}-\\lambda )(2-\\lambda )-0\\cdot 4 & =0 \\\\ (\\lambda -\\sqrt{3})(\\lambda -2) & =0\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\sqrt{3}$ and $\\lambda =2.$\n\n**Note:** The eigenvalues of a triangular (or diagonal) matrix are the entries on the main diagonal."}] [{:db/id #edb/ref 17592186395997 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395999} {:answer/id #uuid "55344227-ef64-559d-b72e-d67580b900d1" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186396000} {:answer/id #uuid "8c8d3009-744a-5594-85d0-81623acfa040" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186396001} {:answer/id #uuid "1acecbea-2330-5d66-8f7e-c711b7d73ea2" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186396002} {:answer/id #uuid "cabd1c0f-3241-5f02-a31b-66428bbc54cc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186396003}] :answer-field/correct {:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395999} :answer-field/id #uuid "e3af571d-ad32-5475-bbe0-4ca42f82e8b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395998}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3861b-a381-5b7c-bc56-9232209a631c" :question/math-academy-id "q-12008" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}].$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 4kx+3ky\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 4({x}_{1}+{x}_{2})+3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 4{x}_{1}+3{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 4{x}_{2}+3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186395720 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f1f99d3-ebcb-50c6-a162-bd58f7d5ec92" :knowledge-point/title "Listing the Elements in a Power Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7eaa022-12cf-592a-ab07-2eeadefc2793" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,2,4,8,{2,4},{2,8},{4,8},{2,4,8}}" :db/id #edb/ref 17592186395722} {:answer/id #uuid "9a08b3e3-eb17-5ee2-bea5-1b56ef752421" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{2},{4},{8},{2,4},{2,8},{4,8},{2,4,8}}" :db/id #edb/ref 17592186395723} {:answer/id #uuid "f2402890-c172-5742-b423-263e71997747" :answer/type {:db/ident :answer.type/math} :answer/value "{{2},{4},{8},{2,4,8}}" :db/id #edb/ref 17592186395724} {:answer/id #uuid "e2daa154-1445-566e-ae93-ed4fffaad295" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{2,4,8}}" :db/id #edb/ref 17592186395725} {:answer/id #uuid "6f836ae3-47dc-5686-af54-b563d298bfd9" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{2},{4},{8},{2,4},{2,8},{4,8}}" :db/id #edb/ref 17592186395726}] :answer-field/correct {:answer/id #uuid "9a08b3e3-eb17-5ee2-bea5-1b56ef752421" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{2},{4},{8},{2,4},{2,8},{4,8},{2,4,8}}" :db/id #edb/ref 17592186395723} :answer-field/id #uuid "595f6f8e-2567-512e-a222-db6ad6900a59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395721}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "350a2acf-787e-5ee2-949f-2438ca3d2b8a" :question/math-academy-id "q-1203" :question/problem "If $X={2,4,8}$, then $P(X)=$" :question/worked-solution "The power set of $X,$ denoted $P(X),$ is the set that contains every possible subset of $X,$ including the empty set $∅.$\n\nSo, let's list all possible subsets of $X$ using a tree diagram. \n\n![](images/58/580d7c32378a2af641fb1066cec4ec24cc6c5b140ccf9475f9a3e3a68367d30d.png)\n\nAccording to our diagram, the subsets of $X$ are\n\n$$\n∅={},\\,{2},\\,{4},\\,{8},\\,{2,4},\\,{2,8},\\,{4,8},\\,{2,4,8}.\n$$\n\nTherefore, we have\n\n$$\nP(X)={∅,{2},{4},{8},{2,4},{2,8},{4,8},{2,4,8}}.\n$$"}] [{:db/id #edb/ref 17592186396004 :knowledge-point/_questions [{:knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015f808a-c2bc-507e-8f20-bbd2cb4811ff" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186396006} {:answer/id #uuid "63d77cc9-bcd1-5fdf-b729-52e06ccab36b" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $12$" :db/id #edb/ref 17592186396007} {:answer/id #uuid "2b02233e-2dae-5a79-9684-11c096b79aaf" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $y=12$" :db/id #edb/ref 17592186396008} {:answer/id #uuid "90b07ab8-256d-5a91-b9cc-79d3fb993b83" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{1}{12}$" :db/id #edb/ref 17592186396009} {:answer/id #uuid "c91805f4-1cf7-5369-8fb0-b501bd5870f1" :answer/type {:db/ident :answer.type/text} :answer/value "Reflection in the line $x=12$" :db/id #edb/ref 17592186396010}] :answer-field/correct {:answer/id #uuid "63d77cc9-bcd1-5fdf-b729-52e06ccab36b" :answer/type {:db/ident :answer.type/text} :answer/value "Dilation with scale factor $12$" :db/id #edb/ref 17592186396007} :answer-field/id #uuid "853df19f-413a-5dcd-bd31-575962ee5db9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0591c45f-50ff-5065-b712-d7946fc4e140" :question/math-academy-id "q-12043" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}12 & 0 \\\\ 0 & 12\\end{aligned}]?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=12.$ Therefore, the matrix represents a dilation with a scale factor of $12.$"}] [{:db/id #edb/ref 17592186106041 :knowledge-point/_questions [{:knowledge-point/id #uuid "c36ce626-1562-51f8-b3fd-d7dc7ce8659c" :knowledge-point/title "Identifying a Shear or Stretch Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0d6486-d718-528b-bd33-68b4cd544cdb" :answer/type {:db/ident :answer.type/text} :answer/value "A stretch of scale factor $10$ in the $y$-direction" :db/id #edb/ref 17592186396012} {:answer/id #uuid "2ec8852b-bfa4-53a1-8fe2-e8c75b78fa64" :answer/type {:db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $1$" :db/id #edb/ref 17592186396013} {:answer/id #uuid "8c271403-1e23-550b-9359-7ec7a8d9dd0b" :answer/type {:db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $10$" :db/id #edb/ref 17592186396014} {:answer/id #uuid "1e78af7e-059a-524f-9ce9-77e30b3e4934" :answer/type {:db/ident :answer.type/text} :answer/value "A stretch of scale factor $10$ in the $x$-direction" :db/id #edb/ref 17592186396015} {:answer/id #uuid "db26a554-6026-5b02-9aa7-d6f9e0ad3b18" :answer/type {:db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $10$" :db/id #edb/ref 17592186396016}] :answer-field/correct {:answer/id #uuid "8c271403-1e23-550b-9359-7ec7a8d9dd0b" :answer/type {:db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $10$" :db/id #edb/ref 17592186396014} :answer-field/id #uuid "e17cbcad-7731-506c-bd2a-44566af3416a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396011}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ec67f6b-b339-5863-9fd2-be6322d61819" :question/math-academy-id "q-12044" :question/problem "What linear transformation is represented by the following matrix\n$[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}]?$" :question/worked-solution "We can find the images of the standard basis vectors $i$ and $j$ under the action of  $T,$ as follows:\n\n$$\n\\begin{aligned}T(i) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ T(j) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}10 \\\\ 1\\end{aligned}]=10i+j\\end{aligned}\n$$\n\nTherefore, the matrix represents a *horizontal* shear with a shear factor of $10.$"}] [{:db/id #edb/ref 17592186395727 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bd69dee-1a90-5731-909e-bf193606c3f1" :answer/type {:db/ident :answer.type/math} :answer/value "R⊆R" :db/id #edb/ref 17592186395729} {:answer/id #uuid "ef9e9860-9681-5612-8906-739b929d5dd1" :answer/type {:db/ident :answer.type/math} :answer/value "Q⊆R" :db/id #edb/ref 17592186395730} {:answer/id #uuid "326b432e-d3d4-56b8-9641-51af48c34b1e" :answer/type {:db/ident :answer.type/math} :answer/value "{Z}^{+}⊆Z" :db/id #edb/ref 17592186395731} {:answer/id #uuid "1d8512ed-f553-5147-af6d-509a075c0b1e" :answer/type {:db/ident :answer.type/math} :answer/value "Z⊆R" :db/id #edb/ref 17592186395732} {:answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type {:db/ident :answer.type/math} :answer/value "C⊆Z" :db/id #edb/ref 17592186395733}] :answer-field/correct {:answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type {:db/ident :answer.type/math} :answer/value "C⊆Z" :db/id #edb/ref 17592186395733} :answer-field/id #uuid "2de47cf9-4ba6-564d-8b13-dc2ae4c1b836" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395728}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23e8510c-99c3-539c-9c30-63245db2572b" :question/math-academy-id "q-1208" :question/problem "Which statement is **not** true?" :question/worked-solution "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $C⊆Z$ is not true. This statement is not true because not every complex is an integer number. For example, we have $2\\text{i}\\in C$ but $2\\text{i}\\notin Z.$"}] [{:db/id #edb/ref 17592186395734 :knowledge-point/_questions [{:knowledge-point/id #uuid "0ae5760b-9277-596c-8546-dca4fd985bd7" :knowledge-point/title "Integrating an Algebraic Function With Fractional Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c00a40ba-01e3-5ee1-8e78-5ca100de2c2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395736} {:answer/id #uuid "b95804dd-01ed-5465-b1ec-454869fcea4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{5x+1}+C" :db/id #edb/ref 17592186395737} {:answer/id #uuid "957bc594-a52d-54c5-8fe2-348b94cdf190" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\sqrt{5x+1}+C" :db/id #edb/ref 17592186395738} {:answer/id #uuid "40a36a09-4403-51a9-8c9b-14cdbfe2aa41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395739} {:answer/id #uuid "2458c64b-d709-5fd5-a6bf-7d12e7bb36e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395740}] :answer-field/correct {:answer/id #uuid "40a36a09-4403-51a9-8c9b-14cdbfe2aa41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C" :db/id #edb/ref 17592186395739} :answer-field/id #uuid "0bf9bf65-124a-5233-aedc-81c57617266f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395735}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "457b9ae0-36a8-577c-85ad-8057dc66fc9a" :question/math-academy-id "q-12498" :question/problem "$\\int \\sqrt{5x+1}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (5x+1)^{1/2}\\,\\text{d}x.\n$$\n\nNow, we let $u=5x+1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $u$ at the very end:\n\n$$\n\\begin{aligned}\\int (5x+1)^{1/2}\\,\\text{d}x & =\\int {u}^{1/2}\\cdot (\\frac{1}{5})\\,\\text{d}u \\\\  & =\\frac{1}{5}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\cdot \\frac{2}{3}{u}^{3/2}+C \\\\  & =\\frac{2}{15}{u}^{3/2}+C \\\\  & =\\frac{2}{15}(5x+1)^{3/2}+C \\\\  & =\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{2}{15}\\sqrt{(5x+1)^{3}}+C] & =\\frac{2}{15}\\cdot \\frac{\\text{d}}{\\text{d}x}[\\sqrt{(5x+1)^{3}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{2}{15}\\cdot \\frac{\\text{d}}{\\text{d}x}[(5x+1)^{3/2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{2}{15}\\cdot \\frac{3}{2}(5x+1)^{1/2}\\cdot \\frac{\\text{d}}{\\text{d}x}(5x+1)+0 \\\\  & =\\frac{1}{5}(5x+1)^{1/2}\\cdot 5 \\\\  & =(5x+1)^{1/2} \\\\  & =\\sqrt{5x+1}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396017 :knowledge-point/_questions [{:knowledge-point/id #uuid "65bec174-0235-5a32-a0d2-2892af4ddaf9" :knowledge-point/title "Determining Whether Two Events are Mutually Exclusive"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6482f0f2-1c1d-5fea-a1fb-3579ff2c32b4" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)\\ne P(A\\cup B)$" :db/id #edb/ref 17592186396019} {:answer/id #uuid "229bdc3a-27fc-56da-aa6a-896f13040c5d" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ are mutually exclusive events, since $P(A\\cap B)=0$" :db/id #edb/ref 17592186396020} {:answer/id #uuid "5fb8d3e3-cdce-512d-ad4f-36dcf03d5780" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\cdot P(B)<P(A\\cup B)$" :db/id #edb/ref 17592186396021} {:answer/id #uuid "909efe4d-2b15-56ed-93cf-072fb3e590e0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A\\cap B)\\ne 0$" :db/id #edb/ref 17592186396022} {:answer/id #uuid "4c73addd-4987-575f-af08-f65362be8bdf" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A)\\ne P(B)$" :db/id #edb/ref 17592186396023}] :answer-field/correct {:answer/id #uuid "909efe4d-2b15-56ed-93cf-072fb3e590e0" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ are not mutually exclusive events, since $P(A\\cap B)\\ne 0$" :db/id #edb/ref 17592186396022} :answer-field/id #uuid "50eb031e-ead1-553b-9ace-42643ea8d178" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5829032-59a0-5111-b1d8-47c7a5a05911" :question/math-academy-id "q-12549" :question/problem "Given $P(A)=0.25$, $P(B)=0.75$, $P(A\\cup B)=0.8$, determine whether  $A$ and $B$ are mutually exclusive events." :question/worked-solution "To check if $A$ and $B$ are mutually exclusive, we must check that $P(A\\cap B)=0.$\n\nWe can calculate $P(A\\cap B)$ using the addition law:\n\n$$\n\\begin{aligned}P(A\\cup B) & =P(A)+P(B)-P(A\\cap B) \\\\ 0.8 & =0.25+0.75-P(A\\cap B) \\\\ P(A\\cap B) & =0.25+0.75-0.8 \\\\  & =0.2\\ne 0.\\,\\times \\end{aligned}\n$$\n\nTherefore, $A$ and $B$ are not mutually exclusive events."}] [{:db/id #edb/ref 17592186395741 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b082a95-4d6e-512f-a6ed-9100498d17c8" :knowledge-point/title "Identifying Partitions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c62bfae-23aa-5f52-b0bc-0424b9578342" :answer/type {:db/ident :answer.type/math} :answer/value "{{2},{4},{6,8}}" :db/id #edb/ref 17592186395743} {:answer/id #uuid "e79a6322-44b7-5a94-b196-9b746019ff59" :answer/type {:db/ident :answer.type/math} :answer/value "{{2},{2,4},{6,8,10}}" :db/id #edb/ref 17592186395744} {:answer/id #uuid "d3365228-8ebc-5740-8fa8-73b9ae0a6b14" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{2,4},{6,8},{10}}" :db/id #edb/ref 17592186395745} {:answer/id #uuid "1db91ae0-8216-5bd3-82ee-556d650a4b32" :answer/type {:db/ident :answer.type/math} :answer/value "{∅,{2,4},{6,8},{8,10}}" :db/id #edb/ref 17592186395746} {:answer/id #uuid "059cf625-a3dd-5a3d-8a2c-3d1bdcfed336" :answer/type {:db/ident :answer.type/math} :answer/value "{{2,4,6},{8},{10}}" :db/id #edb/ref 17592186395747}] :answer-field/correct {:answer/id #uuid "059cf625-a3dd-5a3d-8a2c-3d1bdcfed336" :answer/type {:db/ident :answer.type/math} :answer/value "{{2,4,6},{8},{10}}" :db/id #edb/ref 17592186395747} :answer-field/id #uuid "2bbea4c4-defc-5b74-9d20-54587edce7a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fe130ed-ce3d-5283-a70b-402fc6b51c7c" :question/math-academy-id "q-1270" :question/problem "If $T={2,4,6,8,10}$, which collection of subsets of $T$ is a partition of $T?$" :question/worked-solution "A partition of a set $T$ is a collection of non-empty subsets of $T$ where every element of $T$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{2,4,6},{8},{10}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${∅,{2,4},{6,8},{10}}$ is not a partition because the subset $∅$ is empty.\n\n- ${∅,{2,4},{6,8},{8,10}}$ is not a partition because the subset $∅$ is empty.\n\n- ${{2},{4},{6,8}}$ is not a partition because the element $10\\in T$ does not appear in any subset.\n\n- ${{2},{2,4},{6,8,10}}$ is not a partition because the element $2$ appears in two subsets."}] [{:db/id #edb/ref 17592186060025 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" :knowledge-point/title "Identifying Partitions of Large Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9deb231b-1668-5acf-aa27-d4f09e4e18c0" :answer/type {:db/ident :answer.type/math} :answer/value "{{1,2,3,…,100}}" :db/id #edb/ref 17592186395749} {:answer/id #uuid "e42f62b9-16b9-540a-b37c-9e34df98915a" :answer/type {:db/ident :answer.type/math} :answer/value "{{2,4,6,…,40},{80,82,84,…,100}}" :db/id #edb/ref 17592186395750} {:answer/id #uuid "ee5204f8-4e4a-5bfb-9e6d-e326273014e4" :answer/type {:db/ident :answer.type/math} :answer/value "{{4,6,8,10},{10,11,12,…,100}}" :db/id #edb/ref 17592186395751} {:answer/id #uuid "fa457256-1d86-5c77-8f40-ca7a85884c06" :answer/type {:db/ident :answer.type/math} :answer/value "{{2,4,6,…,40},{20,22,24,…,100}}" :db/id #edb/ref 17592186395752} {:answer/id #uuid "cfb1684e-7d04-57bc-aa28-0cefcf575bb7" :answer/type {:db/ident :answer.type/math} :answer/value "{{2,4,6,…,40},{42,44,46,…,60},{62,64,66,…,100}}" :db/id #edb/ref 17592186395753}] :answer-field/correct {:answer/id #uuid "cfb1684e-7d04-57bc-aa28-0cefcf575bb7" :answer/type {:db/ident :answer.type/math} :answer/value "{{2,4,6,…,40},{42,44,46,…,60},{62,64,66,…,100}}" :db/id #edb/ref 17592186395753} :answer-field/id #uuid "6126d0ad-c8aa-565d-b641-031a1a0379cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395748}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e7b9d16-36b0-577e-a63c-c84d780d74e5" :question/math-academy-id "q-1275" :question/problem "If $Y={2,4,6,…,100},$ which collection of subsets of $Y$ is a partition of $Y?$" :question/worked-solution "A partition of a set $Y$ is a collection of non-empty subsets of $Y$ where every element of $Y$ is contained in *exactly* one subset. \n\nOf the given collections, only ${{2,4,6,…,40},{42,44,46,…,60},{62,64,66,…,100}}$ is a partition.\n\nThe rest of the collections are not partitions:\n\n- ${{2,4,6,…,40},{80,82,84,…,100}}$ is not a partition because many elements of $Y$ (such as $42$) do not appear in any subsets.\n\n- ${{2,4,6,…,40},{20,22,24,…,100}}$ is not a partition because many elements (such as $20$) appear in both subsets.\n\n- ${{1,2,3,…,100}}$ is not a partition because it contains many elements (such as $1$) that do not appear in $Y.$\n\n- ${{4,6,8,10},{10,11,12,…,100}}$ is not a partition because it contains many elements (such as $11$) that do not appear in $Y.$"}] [{:db/id #edb/ref 17592186396024 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596d615e-5286-5202-8b68-e459a1ad6de4" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396026} {:answer/id #uuid "ab85b611-a835-5c9b-b93a-92affdbe8c81" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=12$ and $a=-4$" :db/id #edb/ref 17592186396027} {:answer/id #uuid "cb49ee04-f343-57a4-b655-73c807196dc3" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=60,\\,a=12$ and $a=-8$" :db/id #edb/ref 17592186396028} {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396029} {:answer/id #uuid "1c7592ca-f49a-5a60-b8d5-154388f0691b" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=-4$" :db/id #edb/ref 17592186396030}] :answer-field/correct {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396029} :answer-field/id #uuid "950ac440-c42e-5efd-8288-46527f1353b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4870cb8f-66f0-5759-83b5-334830749092" :question/math-academy-id "q-12997" :question/problem "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$"}] [{:db/id #edb/ref 17592186395754 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8" :knowledge-point/title "Finding an Entry of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13c60e5-0749-5b32-b12e-a8ade2bfafa4" :answer/type {:db/ident :answer.type/text} :answer/value "No such entry" :db/id #edb/ref 17592186395756} {:answer/id #uuid "934f3147-a632-5a7a-90a4-6abb01c749b5" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186395757} {:answer/id #uuid "75f10e54-f429-5034-a07c-5f3a477a96f5" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395758} {:answer/id #uuid "fc409e78-b2db-5c05-a2e5-b9108d710f88" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395759} {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395760}] :answer-field/correct {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395760} :answer-field/id #uuid "009a80b9-eba7-5f26-9519-cf720d746fee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395755}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d09f8217-b119-5565-bb4f-2ae4305acd87" :question/math-academy-id "q-13497" :question/problem "Find the entry ${c}_{24}$ of the matrix $C$, where \n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${c}_{24}$ should lie at the intersection of the $2$nd row and $4$th column. Therefore, ${c}_{24}=5.$\n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186396031 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396033} {:answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396034} {:answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396035} {:answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186396036} {:answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396037}] :answer-field/correct {:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396033} :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396032}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120126 :knowledge-point/_questions [{:knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff" :knowledge-point/title "Describing a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76cc8a4b-832c-56c2-8cf5-70501cfbad40" :answer/type {:db/ident :answer.type/text} :answer/value "Other" :db/id #edb/ref 17592186396039} {:answer/id #uuid "9b6f508a-4794-5f61-a64e-b20147d225cf" :answer/type {:db/ident :answer.type/text} :answer/value "Identity matrix" :db/id #edb/ref 17592186396040} {:answer/id #uuid "82b889e9-c745-5d62-97b1-40fc31c6e4bb" :answer/type {:db/ident :answer.type/text} :answer/value "Lower triangular matrix" :db/id #edb/ref 17592186396041} {:answer/id #uuid "a128b52e-7259-5003-b476-9857977d9aa6" :answer/type {:db/ident :answer.type/text} :answer/value "Diagonal matrix" :db/id #edb/ref 17592186396042} {:answer/id #uuid "530ba56a-9b9f-5e98-981e-3ca0aa7acb9b" :answer/type {:db/ident :answer.type/text} :answer/value "Upper triangular matrix" :db/id #edb/ref 17592186396043}] :answer-field/correct {:answer/id #uuid "82b889e9-c745-5d62-97b1-40fc31c6e4bb" :answer/type {:db/ident :answer.type/text} :answer/value "Lower triangular matrix" :db/id #edb/ref 17592186396041} :answer-field/id #uuid "bc095a3a-82a7-5c30-b624-4fd7e0ceae34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6f9badf-44cd-56b4-946a-abae3220a5b7" :question/math-academy-id "q-13759" :question/problem "How can we best describe the following matrix? \n\n$$\nA=[\\begin{aligned}7 & 0 & 0 \\\\ 3 & -1 & 0 \\\\ 0 & 5 & 0\\end{aligned}]\n$$" :question/worked-solution "Notice that $A$ is a matrix for which all entries above the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}7 & 0 & 0 \\\\ 3 & -1 & 0 \\\\ 0 & 5 & 0\\end{aligned}]\n$$\n\nTherefore, it is a lower triangular matrix.\n\nIt is not an upper triangular matrix or a diagonal matrix since there is a non-zero element below the diagonal: ${a}_{21}=3\\ne 0.$"}] [{:db/id #edb/ref 17592186396044 :knowledge-point/_questions [{:knowledge-point/id #uuid "1cca9b7c-358a-5f62-9a53-a696df0dd0ff" :knowledge-point/title "Describing a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3993775-0f8e-5c7e-b158-1a52fe75de99" :answer/type {:db/ident :answer.type/text} :answer/value "Other" :db/id #edb/ref 17592186396046} {:answer/id #uuid "d4aa5d0b-3502-5db7-982d-257ca9d0ebb8" :answer/type {:db/ident :answer.type/text} :answer/value "Identity matrix" :db/id #edb/ref 17592186396047} {:answer/id #uuid "9c6da7fb-8eba-5ffa-9bde-d1144a8dbb47" :answer/type {:db/ident :answer.type/text} :answer/value "Lower triangular matrix" :db/id #edb/ref 17592186396048} {:answer/id #uuid "7bc5b9ce-5da0-55fe-8e2a-df8eb4ecfc52" :answer/type {:db/ident :answer.type/text} :answer/value "Diagonal matrix" :db/id #edb/ref 17592186396049} {:answer/id #uuid "6657fbe8-1958-5cc4-b147-eb6c679992c6" :answer/type {:db/ident :answer.type/text} :answer/value "Upper triangular matrix" :db/id #edb/ref 17592186396050}] :answer-field/correct {:answer/id #uuid "6657fbe8-1958-5cc4-b147-eb6c679992c6" :answer/type {:db/ident :answer.type/text} :answer/value "Upper triangular matrix" :db/id #edb/ref 17592186396050} :answer-field/id #uuid "2332d85e-5e88-505c-b823-5f0ae7f57fb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce57af24-7688-5285-99c2-a982d174d89c" :question/math-academy-id "q-13781" :question/problem "How can we best describe the following matrix? \n\n$$\nA=[\\begin{aligned}2 & 4 & 7 \\\\ 0 & 2 & 6 \\\\ 0 & 0 & 3\\end{aligned}]\n$$" :question/worked-solution "Notice that $A$ is a matrix for which all entries below the diagonal are $0$'s:\n\n$$\nA=[\\begin{aligned}2 & 4 & 7 \\\\ 0 & 2 & 6 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nTherefore, it is an upper triangular matrix.\n\nIt is not a lower triangular matrix or a diagonal matrix since there is a non-zero element above the diagonal: ${a}_{12}=4\\ne 0.$"}] [{:db/id #edb/ref 17592186396051 :knowledge-point/_questions [{:knowledge-point/id #uuid "bfc0d9e1-bce1-5d62-b3c8-f7d7bb226497" :knowledge-point/title "Finding the Radius and Interval of Convergence of a Power Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71cb4bda-fc1e-5f5c-a387-81bc7f680311" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and  $I=(0,2]$" :db/id #edb/ref 17592186396053} {:answer/id #uuid "c5872ac5-73b0-58bc-a4ce-df051df3c8ad" :answer/type {:db/ident :answer.type/text} :answer/value "$R=\\infty $ and  $I=(-\\infty ,\\infty )$" :db/id #edb/ref 17592186396054} {:answer/id #uuid "de6804fa-3d4a-5001-8f45-18bc86c68bd6" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and  $I=[0,2)$" :db/id #edb/ref 17592186396055} {:answer/id #uuid "a52347ba-5949-5d61-b02a-567dd46a130d" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and  $I=[0,2]$" :db/id #edb/ref 17592186396056} {:answer/id #uuid "f635175f-1efc-5299-8c7e-5584974b36e7" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and  $I=(0,2)$" :db/id #edb/ref 17592186396057}] :answer-field/correct {:answer/id #uuid "a52347ba-5949-5d61-b02a-567dd46a130d" :answer/type {:db/ident :answer.type/text} :answer/value "$R=1$ and  $I=[0,2]$" :db/id #edb/ref 17592186396056} :answer-field/id #uuid "bdf61ccf-2627-5fa3-a051-531ba920ddff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c54e973-6e64-50b6-b096-4b16776e42ab" :question/math-academy-id "q-13912" :question/problem "Find the radius of convergence $R$ and interval of convergence $I$ for the series\n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}}\\,.\n$$" :question/worked-solution "To apply the ratio test we define ${a}_{n}=\\frac{(x-1)^{3n}}{{n}^{3}}.$ Then, we calculate the ratio of two successive terms and take the limit as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }|\\frac{{a}_{n+1}}{{a}_{n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{(x-1)^{3(n+1)}}{(n+1)^{3}}\\cdot \\frac{{n}^{3}}{(x-1)^{3n}}| \\\\  & ={lim}_{n\\to \\infty }|\\frac{{n}^{3}(x-1)^{3}}{(n+1)^{3}}| \\\\  & =|x-1{|}^{3}{lim}_{n\\to \\infty }{(\\frac{n}{n+1})}^{3} \\\\  & =|x-1{|}^{3}\\cdot 1 \\\\  & =|x-1{|}^{3}\\end{aligned}\n$$\n\nThe series converges if $L<1.$ Therefore,\n\n$$\n\\begin{aligned}|x-1{|}^{3} & <1 \\\\ |x-1| & <1 \\\\ -1<x-1 & <1 \\\\ 0<x & <2.\\end{aligned}\n$$\n\nSo, the radius of convergence is $R=1,$ and the series converges for any $x$ that lies in the open interval $(0,2).$\n\nThe ratio test gives no conclusion about the convergence of the series when $L=1.$ So, when $|x-1|=1,$ we do not know if the series converges. This means that the endpoints $x=0$ and $x=2$ need to be investigated separately using another test for convergence.\n\n- When $x=0$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{{n}^{3}} \\\\  & =-1+\\frac{1}{{2}^{3}}-\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the alternating series test.\n\n- When $x=2$ we have\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{(x-1)^{3n}}{{n}^{3}} & ={\\sum }_{n=1}^{\\infty }\\frac{(2-1)^{3n}}{{n}^{3}} \\\\  & ={\\sum }_{n=1}^{\\infty }\\frac{1}{{n}^{3}} \\\\  & =1+\\frac{1}{{2}^{3}}+\\frac{1}{{3}^{3}}+\\frac{1}{{4}^{3}}+⋯\\,.\\end{aligned}\n$$\n\nThis series is convergent by the $p$-series test.\n\nConsequently, the interval of convergence is $I=[0,2].$"}] [{:db/id #edb/ref 17592186396058 :knowledge-point/_questions [{:knowledge-point/id #uuid "8c990d69-54da-5541-948f-0d5eff96feb5" :knowledge-point/title "Calculating the X-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fbcf88a3-1e20-5a4c-bb86-1fe1bdaa1963" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $-1$" :db/id #edb/ref 17592186396060} {:answer/id #uuid "ae0d6ea0-c5ed-5e7f-9687-ab98aef0c28b" :answer/type {:db/ident :answer.type/text} :answer/value "$7$ and $-1$" :db/id #edb/ref 17592186396061} {:answer/id #uuid "c4dc7a4e-aacb-5122-89ac-d5eb5d04a7da" :answer/type {:db/ident :answer.type/text} :answer/value "$9$ and $-2$" :db/id #edb/ref 17592186396062} {:answer/id #uuid "950ec668-d2b7-5d89-8e4f-1d349b1209a4" :answer/type {:db/ident :answer.type/text} :answer/value "$7$ and $-2$" :db/id #edb/ref 17592186396063} {:answer/id #uuid "2789771c-579f-5375-8680-854defcdf4d4" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ and $-3$" :db/id #edb/ref 17592186396064}] :answer-field/correct {:answer/id #uuid "ae0d6ea0-c5ed-5e7f-9687-ab98aef0c28b" :answer/type {:db/ident :answer.type/text} :answer/value "$7$ and $-1$" :db/id #edb/ref 17592186396061} :answer-field/id #uuid "1984d219-413d-5333-ac39-1acd7d9d0ec5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1270303e-0109-58be-ac65-6aecbfb8540f" :question/math-academy-id "q-14050" :question/problem "![](images/04/0470661491c0d9d44ecbbc3c87af70d4ff334f1ffd2ca56b68bd4c126f3d88de.png)\n\nWhat are the $x$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(3,-4)$ and passes through the point $(0,-\\frac{7}{4}).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(3,-4)$ into the above gives\n\n$$\n\\begin{aligned}(x-3)^{2} & =4p(y+4).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(0,-\\frac{7}{4}),$ we substitute $x=0$ and $y=-\\frac{7}{4}$ into the equation and get\n\n$$\n\\begin{aligned}(0-3)^{2} & =4p(-\\frac{7}{4}+4) \\\\ 9 & =4p(\\frac{9}{4}) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(y+4).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-3)^{2} & =4(0+4) \\\\ (x-3)^{2} & =16 \\\\ x-3 & =\\pm 4 \\\\ x & =\\pm 4+3\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $7$ and $-1.$"}] [{:db/id #edb/ref 17592186272286 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e35ad90-2f1b-5a63-97f8-d0ee68eca5d1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269398} {:answer/id #uuid "2fde21b2-4071-56ca-975f-426d92a1cb17" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269704} {:answer/id #uuid "752357c7-c757-545e-b673-5e6aef138895" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270310} {:answer/id #uuid "9758a9f8-4285-59af-9944-c703f3e02a1f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270604} {:answer/id #uuid "c828b14e-ea43-5244-865e-f22017cdf7a1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186271038}] :answer-field/correct {:answer/id #uuid "2fde21b2-4071-56ca-975f-426d92a1cb17" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269704} :answer-field/id #uuid "bbc92cb1-fc14-5bd0-a868-45afb00eeb79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271857}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34dfcc70-f55e-5b7a-a24a-4dbf1116a030" :question/math-academy-id "q-14144" :question/problem "For the polynomial $f(x)=3{x}^{8}-18{x}^{2}-33x-18,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-18,$ and its factors are $\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6,\\,\\pm 9$ and  $\\pm 18.$\n\n- The leading coefficient is $3,$ and its factors are $\\pm 1$ and $\\pm 3.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{3}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{3}, \\\\ \\pm \\frac{3}{1}, & \\pm \\frac{3}{3}, \\\\ \\pm \\frac{6}{1}, & \\pm \\frac{6}{3}, \\\\ \\pm \\frac{9}{1}, & \\pm \\frac{9}{3}, \\\\ \\pm \\frac{18}{1}, & \\pm \\frac{18}{3}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{3}, \\\\ \\pm 2, & \\pm \\frac{2}{3}, \\\\ \\pm 3, & \\pm 1, \\\\ \\pm 6, & \\pm 2, \\\\ \\pm 9, & \\pm 3, \\\\ \\pm 18, & \\pm 6.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{3},\\,\\pm \\frac{2}{3}\\,\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6,\\,\\pm 9,\\,\\pm 18.\n$$\n\nThis makes a total of $16$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 8=16.$)"}] [{:db/id #edb/ref 17592186395761 :knowledge-point/_questions [{:knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1cd77c1-d94a-50e2-a2d2-310f30af1efd" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{13},0)" :db/id #edb/ref 17592186395763} {:answer/id #uuid "932f6c0b-7bfc-5138-a5fc-88d5849899ad" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{13}{2},0)" :db/id #edb/ref 17592186395764} {:answer/id #uuid "62a3c355-7a46-5e69-a9b4-100e157d8443" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186395765} {:answer/id #uuid "1acd5f2b-ea97-5c92-bd3f-4c0fa0954dc3" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{13}{2},0)" :db/id #edb/ref 17592186395766} {:answer/id #uuid "de725257-e555-5095-bd67-53b03fd19c7d" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{2}{13},0)" :db/id #edb/ref 17592186395767}] :answer-field/correct {:answer/id #uuid "a1cd77c1-d94a-50e2-a2d2-310f30af1efd" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{2}{13},0)" :db/id #edb/ref 17592186395763} :answer-field/id #uuid "fcb45a2c-578d-5e71-917a-16d23dca9a5c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395762}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a1f70ec-1a84-5f86-99bd-fdd4752087f5" :question/math-academy-id "q-14191" :question/problem "Find the point of intersection of the parabola ${y}^{2}+13x-15y-2=0$ with the $x$-axis." :question/worked-solution "When the parabola intersects the $x$-axis, we must have $y=0.$ So, we set $y=0$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}(0)^{2}+13x-15(0)-2 & =0 \\\\ 13x-2 & =0 \\\\ x & =\\frac{2}{13}\\end{aligned}\n$$\n\nTherefore, the parabola intersects the $x$-axis at $(\\frac{2}{13},0).$"}] [{:db/id #edb/ref 17592186396065 :knowledge-point/_questions [{:knowledge-point/id #uuid "5e182f71-db24-5c29-9c8b-2fc4b5ab5dd8" :knowledge-point/title "Calculating the Y-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aad8bda-3338-5a30-9437-cc3702c58311" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $7$" :db/id #edb/ref 17592186396067} {:answer/id #uuid "327b2ad5-797c-54cc-89ed-97281f8970bc" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186396068} {:answer/id #uuid "bef389b0-e3ae-5a1a-8b87-cc5f8f7fe4f4" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ and $6$" :db/id #edb/ref 17592186396069} {:answer/id #uuid "16f5c998-e55d-56ad-a2e1-414b9c779c8d" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $5$" :db/id #edb/ref 17592186396070} {:answer/id #uuid "f30933e4-e411-5b64-94cc-db4bc0952b99" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ and $7$" :db/id #edb/ref 17592186396071}] :answer-field/correct {:answer/id #uuid "327b2ad5-797c-54cc-89ed-97281f8970bc" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $6$" :db/id #edb/ref 17592186396068} :answer-field/id #uuid "402f8b77-e682-57ca-9212-0a3e5c1ad08a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396066}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ecc876e-1e30-5d04-b02b-e0d45341e6f7" :question/math-academy-id "q-14241" :question/problem "![](images/9b/9b7acbd4f24b6bbd20dd00fc042405324c069d28db0102c2cd7dd49e6b3bbccd.png)\n\nWhat are the $y$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(2,4)$ and passes through the point $(-6,8).$\n\nThe general standard equation of a left- or right-opening parabola with vertex at $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h),\n$$\n\nand substituting $(h,k)=(2,4)$ into the above gives\n\n$$\n(y-4)^{2}=4p(x-2).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-6,8),$ we substitute $x=-6$ and $y=8$ into the equation and get\n\n$$\n\\begin{aligned}(8-4)^{2} & =4p(-6-2) \\\\ 16 & =4p(-8) \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y-4)^{2} & =-2(x-2).\\end{aligned}\n$$\n\nWhen the parabola intersects the $y$-axis, we must have $x=0.$ So, we substitute $x=0$ into the equation of the parabola and solve for $y:$\n\n$$\n\\begin{aligned}(y-4)^{2} & =-2(0-2) \\\\ (y-4)^{2} & =4 \\\\ y-4 & =\\pm 2 \\\\ y & =\\pm 2+4 \\\\ y & =2,6\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $2$ and  $6.$"}] [{:db/id #edb/ref 17592186396072 :knowledge-point/_questions [{:knowledge-point/id #uuid "98e3f3b4-8dfa-515c-90b1-09fb19d68144" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square with Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2fe06dc-0609-5053-9367-73d7ebf2fcb3" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396074} {:answer/id #uuid "3f353887-7ced-5107-882a-0276e72dd462" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-2,2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396075} {:answer/id #uuid "d0c03ddb-5aef-510c-adf3-fa2a8970e245" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,2)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396076} {:answer/id #uuid "ef5518f9-14b3-5d56-ae49-14acc285d236" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,4)$, radius: $\\frac{13}{2}$" :db/id #edb/ref 17592186396077} {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396078}] :answer-field/correct {:answer/id #uuid "0ddf99ec-bda7-505b-b4fe-67ffc75b34aa" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(2,-2)$, radius: $\\sqrt{\\frac{13}{2}}$" :db/id #edb/ref 17592186396078} :answer-field/id #uuid "8bd2771d-4f88-578f-9fd3-675729a93312" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396073}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0485f61e-5d32-5461-91b2-4119de37bba9" :question/math-academy-id "q-14619" :question/problem "Find the radius and center of the circle whose equation is\n$2{x}^{2}+2{y}^{2}-8x+8y+3=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}2{x}^{2}+2{y}^{2}-8x+8y+3 & =0 \\\\ {x}^{2}+{y}^{2}-4x+4y & =-\\frac{3}{2} \\\\ ({x}^{2}-4x)+({y}^{2}+4y) & =-\\frac{3}{2} \\\\ ({x}^{2}-2\\cdot 2x+{2}^{2})+({y}^{2}+2\\cdot 2y+{2}^{2}) & =-\\frac{3}{2}+{2}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot 2x+4)+({y}^{2}+2\\cdot 2x+4) & =\\frac{13}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}(x-2)^{2}+{(y+2)}^{2} & =\\frac{13}{2} \\\\ (x-2)^{2}+{(y-(-2))}^{2} & ={(\\sqrt{\\frac{13}{2}})}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(2,-2)$ and its radius is $\\sqrt{\\frac{13}{2}}.$"}] [{:db/id #edb/ref 17592186396079 :knowledge-point/_questions [{:knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74e6273a-f318-5c34-a052-af10236b8229" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(1,5)$, radius: $3$" :db/id #edb/ref 17592186396081} {:answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186396082} {:answer/id #uuid "c6be1a14-c6c9-582a-8aa6-d933eeef50a8" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(5,-1)$, radius: $7$" :db/id #edb/ref 17592186396083} {:answer/id #uuid "ecbea558-c9ab-5f89-80f4-8cdcb2e0f681" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-5,1)$, radius: $4$" :db/id #edb/ref 17592186396084} {:answer/id #uuid "91bca4ac-a533-50cd-b79b-78e54b58a746" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,-5)$, radius: $9$" :db/id #edb/ref 17592186396085}] :answer-field/correct {:answer/id #uuid "6ef4fb82-ea8e-583d-9771-d8277b4a76da" :answer/type {:db/ident :answer.type/text} :answer/value "center: $(-1,5)$, radius: $9$" :db/id #edb/ref 17592186396082} :answer-field/id #uuid "de4e6f08-aad0-5add-9bc8-7a4631ad1e27" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf1d8b4a-8091-5076-a3c1-f3d77fa5e29a" :question/math-academy-id "q-15460" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+2x+{y}^{2}=55+10y.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+2x+{y}^{2} & =55+10y \\\\ ({x}^{2}+2x)+({y}^{2}-10y) & =55 \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =55+{1}^{2}+{5}^{2} \\\\ ({x}^{2}+2\\cdot x+{1}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =81\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-5)^{2} & ={9}^{2} \\\\ (x-(-1))^{2}+(y-5)^{2} & ={9}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-1,5)$ and its radius is $9.$"}] [{:db/id #edb/ref 17592186395768 :knowledge-point/_questions [{:knowledge-point/id #uuid "bfe4679b-9724-5502-89d4-05e7661a1b5f" :knowledge-point/title "Solving an Inhibited Decay Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "893f4780-2c8b-522b-8087-2fc24822ebd4" :answer/type {:db/ident :answer.type/math} :answer/value "87\\,\\text{min}" :db/id #edb/ref 17592186395770} {:answer/id #uuid "93cd5cdd-b047-544f-b7e7-fee685cf62f6" :answer/type {:db/ident :answer.type/math} :answer/value "95\\,\\text{min}" :db/id #edb/ref 17592186395771} {:answer/id #uuid "ef24ffa0-3d6e-5335-9009-9906ff059c99" :answer/type {:db/ident :answer.type/math} :answer/value "98\\,\\text{min}" :db/id #edb/ref 17592186395772} {:answer/id #uuid "d38f97ca-3e74-5b74-90a6-ef1513732aca" :answer/type {:db/ident :answer.type/math} :answer/value "89\\,\\text{min}" :db/id #edb/ref 17592186395773} {:answer/id #uuid "96517c6b-bae9-503f-9f98-d3f004b861a0" :answer/type {:db/ident :answer.type/math} :answer/value "67\\,\\text{min}" :db/id #edb/ref 17592186395774}] :answer-field/correct {:answer/id #uuid "93cd5cdd-b047-544f-b7e7-fee685cf62f6" :answer/type {:db/ident :answer.type/math} :answer/value "95\\,\\text{min}" :db/id #edb/ref 17592186395771} :answer-field/id #uuid "fca47f9c-32af-5d7e-92a5-e9a1ab61bc65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395769}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02ce9872-8986-5e67-bea1-b49d589c24ac" :question/math-academy-id "q-15589" :question/problem "The water boils in a pan at a temperature of ${100}^{∘}C.$ The pan with water is then placed to a room with a temperature of ${25}^{∘}C,$ and the temperature of water decreases. After $5$ minutes, it cools to ${90}^{∘}C.$ To the nearest minute, how long does it take for the water to have a temperature of ${30}^{∘}C?$ \n\n*Hint: You may assume that the temperature reading $T(t)$ of the water in the pan decreases at a rate that obeys Newton's law of cooling, where $T$ is measured in degrees Celsius and $t>0$ is the time, in minutes, since the water starts cooling.*" :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the inhibited decay equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={25}^{∘}\\text{C},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-25).\n$$\n\nFirst, we integrate our differential equation by separating the variables:\n\n$$\n\\begin{aligned}\\frac{dT}{T-25} & =-k\\,dt \\\\ \\int \\frac{dT}{T-25} & =-k\\int dt \\\\ \\operatorname{ln}⁡|T-25| & =-kt+C\\end{aligned}\n$$\n\nSince this is the solution to an inhibited decay equation, we have $T-25>0$ for all $t>0.$\nNext, we solve for $T(t),$ as follows:\n\n$$\n\\begin{aligned}T-25 & ={e}^{-kt+C} \\\\ T-25 & ={e}^{C}{e}^{-kt} \\\\ T-25 & =K{e}^{-kt} \\\\ T & =25+K{e}^{-kt}\\end{aligned}\n$$\n\nNote that $K={e}^{C}$ is a constant of integration. \n\nWe're told that the initial temperature was ${100}^{∘}C.$ So, we apply the initial condition $T(0)=100,$ and solve for $K:$\n\n$$\n\\begin{aligned}100 & =25+K{e}^{0} \\\\ 100 & =25+K \\\\ K & =75\\end{aligned}\n$$\n\nTherefore, we have the following expression for $T(t):$\n\n$$\nT(t)=25+75{e}^{-kt}\n$$\n\nWe're also told that, after $5$ minutes, it cools to ${90}^{∘}C.$ So, applying the condition $T(5)=90,$ we can solve for $k:$\n\n$$\n\\begin{aligned}90 & =25+75{e}^{-5k} \\\\ 65 & =75{e}^{-5k} \\\\ \\frac{13}{15} & ={e}^{-5k} \\\\ \\operatorname{ln}⁡(\\frac{13}{15}) & =-5k \\\\ k & =-\\frac{1}{5}\\operatorname{ln}⁡(\\frac{13}{15})\\end{aligned}\n$$\n\nFinally, let ${t}_{1}$ be the time when the water has a temperature of ${30}^{∘}C.$ Then, we have\n\n$$\n\\begin{aligned}T({t}_{1}) & =30 \\\\ 25+75{e}^{-k{t}_{1}} & =30 \\\\ 75{e}^{-k{t}_{1}} & =5 \\\\ {e}^{-k{t}_{1}} & =\\frac{1}{15} \\\\ -k{t}_{1} & =\\operatorname{ln}⁡(\\frac{1}{15}) \\\\ {t}_{1} & =-\\frac{1}{k}\\operatorname{ln}⁡(\\frac{1}{15}).\\end{aligned}\n$$\n\nSubstituting in our value for $k,$ we conclude that the temperature of water will be ${30}^{∘}C$ after\n\n$$\n{t}_{1}=\\frac{-\\operatorname{ln}⁡(\\frac{1}{15})}{-\\frac{1}{5}\\operatorname{ln}⁡(\\frac{13}{15})}≈95\\,\\text{min},\n$$\n\nrounded to the nearest minute."}] [{:db/id #edb/ref 17592186396086 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c" :knowledge-point/title "Calculating the Intersection of a Circle With the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5e115e-6cbc-5411-ae18-a29ea605510e" :answer/type {:db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(1.5,0)$" :db/id #edb/ref 17592186396088} {:answer/id #uuid "066ae657-b48f-5dee-bdbe-90b25f7241eb" :answer/type {:db/ident :answer.type/text} :answer/value "$(-8,0)$ and $(1,0)$" :db/id #edb/ref 17592186396089} {:answer/id #uuid "49c35dab-c634-555f-891f-064bee97693f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(1,0)$" :db/id #edb/ref 17592186396090} {:answer/id #uuid "4a4a908f-0a56-517f-bdb8-64d7225e46c2" :answer/type {:db/ident :answer.type/text} :answer/value "$(-10,0)$ and $(1,0)$" :db/id #edb/ref 17592186396091} {:answer/id #uuid "d3ca94c7-3047-533b-8a37-cf3312b8643d" :answer/type {:db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(0.8,0)$" :db/id #edb/ref 17592186396092}] :answer-field/correct {:answer/id #uuid "49c35dab-c634-555f-891f-064bee97693f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(1,0)$" :db/id #edb/ref 17592186396090} :answer-field/id #uuid "0f0feeb3-b4ef-50dc-a4d4-f6cc9bb23002" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396087}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "128b9cef-763e-5aac-a6f0-9eae06355cd4" :question/math-academy-id "q-15681" :question/problem "![](images/13/13b9598c77cd522d0d3aeee4f5abd2390822431aa49ed787b73a110113ab821c.png)\n\nFind the $x$-intercepts of the circle $(x+4)^{2}+{y}^{2}=25,$ shown above." :question/worked-solution "We must have $y=0$ at the $x$-intercepts. \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x+4)^{2}+{y}^{2} & =25 \\\\ (x+4)^{2}+{0}^{2} & =25 \\\\ (x+4)^{2} & =25 \\\\ x+4 & =\\pm \\sqrt{25} \\\\ x+4 & =\\pm 5 \\\\ x & =-4\\pm 5\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts occur at the points $(-9,0)$ and $(1,0).$"}] [{:db/id #edb/ref 17592186396093 :knowledge-point/_questions [{:knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c" :knowledge-point/title "Calculating the Intersection of a Circle With the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6302339-3d66-5e7b-88a3-48ff6e08f3e0" :answer/type {:db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(8,0)$" :db/id #edb/ref 17592186396095} {:answer/id #uuid "bd167719-ad84-5223-8f5d-835bbaa95ad2" :answer/type {:db/ident :answer.type/text} :answer/value "$(-5.5,0)$ and $(7.5,0)$" :db/id #edb/ref 17592186396096} {:answer/id #uuid "30ea2584-387d-5bad-8718-caaee9f8c176" :answer/type {:db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(8,0)$" :db/id #edb/ref 17592186396097} {:answer/id #uuid "0bca8a34-0b3e-5171-929c-8b379129db00" :answer/type {:db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(7,0)$" :db/id #edb/ref 17592186396098} {:answer/id #uuid "2d1c78a6-2f99-5181-bd25-00d1a3010a31" :answer/type {:db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(7,0)$" :db/id #edb/ref 17592186396099}] :answer-field/correct {:answer/id #uuid "0bca8a34-0b3e-5171-929c-8b379129db00" :answer/type {:db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(7,0)$" :db/id #edb/ref 17592186396098} :answer-field/id #uuid "d7f39783-8476-55ac-a74e-97c264bb6280" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396094}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d50f11f-d6f2-5605-88f1-8c45f7404cb9" :question/math-academy-id "q-15684" :question/problem "![](images/c6/c6d356b443128da569a6b60065769cdb56e2e0059db7b146a3c4035d18a32228.png)\n\nFind the $x$-intercepts of the circle $(x-1)^{2}+(y-3)^{2}=45,$ shown above." :question/worked-solution "We must have $y=0$ at the $x$-intercepts. \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-3)^{2} & =45 \\\\ (x-1)^{2}+(0-3)^{2} & =45 \\\\ (x-1)^{2}+9 & =45 \\\\ (x-1)^{2} & =36 \\\\ x-1 & =\\pm \\sqrt{36} \\\\ x & =1\\pm 6\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts occur at the points $(-5,0)$ and $(7,0).$"}] [{:db/id #edb/ref 17592186198850 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756d5e9-8c2b-5648-9cef-d57cf02e8e50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\cdot {2}^{n}" :db/id #edb/ref 17592186396251} {:answer/id #uuid "de50addf-3149-5f58-b066-97f2f40179d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot {2}^{n}" :db/id #edb/ref 17592186396252} {:answer/id #uuid "cf715dcc-e03e-5ea8-aeed-f7ac4fdc33cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\cdot {3}^{n}" :db/id #edb/ref 17592186396253} {:answer/id #uuid "7855bcc5-306f-5477-83df-730bda1dbba3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\cdot {3}^{n}" :db/id #edb/ref 17592186396254} {:answer/id #uuid "9b1a1661-077d-5469-a87e-386432d18ff0" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{n}" :db/id #edb/ref 17592186396255}] :answer-field/correct {:answer/id #uuid "de50addf-3149-5f58-b066-97f2f40179d2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot {2}^{n}" :db/id #edb/ref 17592186396252} :answer-field/id #uuid "3da75658-493e-5414-9ef4-07db0edd9ac6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396250} {:answer-field/choices [{:answer/id #uuid "02e44344-d16a-5d1d-af75-d63577743717" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186396257} {:answer/id #uuid "717cb1ad-26fb-5d39-b775-f38b2206a689" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396258} {:answer/id #uuid "5a2860f0-b7f1-553d-a57e-50270b5ec131" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396259}] :answer-field/correct {:answer/id #uuid "717cb1ad-26fb-5d39-b775-f38b2206a689" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396258} :answer-field/id #uuid "95707686-21cc-5e61-98a8-5364df18a6b6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a35af51-a0e2-50d0-bbd3-1c0dc3bc52aa" :question/math-academy-id "q-183328" :question/problem "Describe the set $S={…,3,6,12,24,48,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=6$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n\\in {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,3,\\,6,\\,12,\\,24,\\,48,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=2:$\n\n$$\n\\begin{aligned}r & =2 \\\\  & =\\frac{6}{3} \\\\  & =\\frac{12}{6} \\\\  & =\\frac{24}{12} \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=6,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =6\\cdot {2}^{n-1} \\\\  & =6\\cdot {2}^{n}\\cdot {2}^{-1} \\\\  & =\\frac{6}{2}\\cdot {2}^{n} \\\\  & =3\\cdot {2}^{n}\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={3\\cdot {2}^{n}\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396260 :knowledge-point/_questions [{:knowledge-point/id #uuid "f49ef1c2-06de-597c-bf4d-6d613989987e" :knowledge-point/title "Expressing a Set Using a Conditional Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b665804-beaa-5388-ac25-9397d16709cc" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186396262} {:answer/id #uuid "cc29d216-b4b5-5d05-aee8-fa1d64f964da" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186396263} {:answer/id #uuid "80b0d143-f228-52ab-ad57-54619241a5e2" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396264} {:answer/id #uuid "20f47bfb-da3d-5440-aa25-5e8189b5f62d" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396265}] :answer-field/correct {:answer/id 