ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186396276} {:answer/id #uuid "7b193b70-b7dd-528f-9a26-4b12b9443110" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186396277}] :answer-field/correct {:answer/id #uuid "7b193b70-b7dd-528f-9a26-4b12b9443110" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186396277} :answer-field/id #uuid "eeb38b07-317a-5585-bbd5-00bb4a2d0f14" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396272}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fba6edb9-01af-5021-9e0a-2f72adbf1e50" :question/math-academy-id "q-183690" :question/problem "Describe the set $S={-6,-5,-4,...,12}$ using a conditional definition.\n\n$$\nS={x\\in {{field-1}}\\,:\\,{{field-2}}\\le x\\le {{field-3}}}\n$$" :question/worked-solution "The set $S$ contains all integer numbers between $-6$ and $12$ (including $-6$ and $12$).\n\nTherefore, the set can be written as\n\n$$\nS={x\\in Z\\,:\\,-6\\le x\\le 12}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $-7<x<13.$ This gives\n\n$$\nS={x\\in Z\\,:\\,-7<x<13}.\n$$"}] [{:db/id #edb/ref 17592186396278 :knowledge-point/_questions [{:knowledge-point/id #uuid "f49ef1c2-06de-597c-bf4d-6d613989987e" :knowledge-point/title "Expressing a Set Using a Conditional Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68c3a835-67f3-5f35-b2c1-7df96f15f695" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186396280} {:answer/id #uuid "4b01f46e-a6d8-5d85-8294-dd04cf1ec431" :answer/type {:db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186396281} {:answer/id #uuid "9af95e75-b547-5b9a-b7ee-b27c4632da32" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396282} {:answer/id #uuid "72567fb8-bb36-5d69-9f9f-77f8bf171a59" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396283}] :answer-field/correct {:answer/id #uuid "9af95e75-b547-5b9a-b7ee-b27c4632da32" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396282} :answer-field/id #uuid "6a84e706-f8a4-5257-b5e4-288cbb329337" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396279} {:answer-field/choices [{:answer/id #uuid "2befce7e-6bda-56f4-85c6-151df854ad1a" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186396285} {:answer/id #uuid "742689fb-929e-5feb-906c-fbfb621bb2b4" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186396286} {:answer/id #uuid "31e1d7c2-ae20-5225-b711-5734fede4221" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186396287}] :answer-field/correct {:answer/id #uuid "742689fb-929e-5feb-906c-fbfb621bb2b4" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186396286} :answer-field/id #uuid "3bddb846-86d1-5aab-af04-f126a3e0241d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396284}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7d216bb-dfa7-5628-bdfc-1e83e087d571" :question/math-academy-id "q-183691" :question/problem "Describe the set $S={-25,-24,-23,…}$ using a conditional definition.\n\n$$\nS={x\\in {{field-1}}\\,:\\,x\\ge {{field-2}}}\n$$" :question/worked-solution "The set $S$ contains all integers greater than or equal to $-25.$\n\nTherefore, the set can be written as\n\n$$\nS={x\\in Z\\,:\\,x\\ge -25}.\n$$\n\n**Note**: This definition is not unique. For example:\n\n- We can write $x>-26.$ This gives\n\n$$\nS={x\\in Z\\,:\\,x>-26}.\n$$"}] [{:db/id #edb/ref 17592186396288 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "868594c4-bb93-514c-ac51-c1c9e6bfcb88" :answer/type {:db/ident :answer.type/math} :answer/value "2n-1" :db/id #edb/ref 17592186396290} {:answer/id #uuid "44fdec78-debe-581c-bba1-42fc35ac4a60" :answer/type {:db/ident :answer.type/math} :answer/value "3n-1" :db/id #edb/ref 17592186396291} {:answer/id #uuid "621d9706-b783-5b07-ba14-823fc7b80c40" :answer/type {:db/ident :answer.type/math} :answer/value "3n+2" :db/id #edb/ref 17592186396292} {:answer/id #uuid "4a9b70f3-1724-5f8c-bed1-b0e33e076e00" :answer/type {:db/ident :answer.type/math} :answer/value "n+2" :db/id #edb/ref 17592186396293} {:answer/id #uuid "0e25f793-a364-5722-ac5b-c3fa6dbfe857" :answer/type {:db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186396294}] :answer-field/correct {:answer/id #uuid "0e25f793-a364-5722-ac5b-c3fa6dbfe857" :answer/type {:db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186396294} :answer-field/id #uuid "7276c096-7c91-5c64-86eb-a307d21f6404" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396289} {:answer-field/choices [{:answer/id #uuid "04ee3e41-783e-5133-b3d1-e05d03af2794" :answer/type {:db/ident :answer.type/math} :answer/value "\\in R" :db/id #edb/ref 17592186396296} {:answer/id #uuid "27f930c0-e938-5469-bfc7-735aea18070a" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186396297} {:answer/id #uuid "66dff9cb-bf42-57d5-883c-94392707c46e" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186396298} {:answer/id #uuid "e63aaee2-6c84-5ac0-978c-26fd52342809" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186396299} {:answer/id #uuid "8b3e5104-6400-55d6-9958-534c229e6346" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396300}] :answer-field/correct {:answer/id #uuid "8b3e5104-6400-55d6-9958-534c229e6346" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396300} :answer-field/id #uuid "d6887cac-fd2a-5aca-b3d7-a80a851334f5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1d88cc5-5f34-51c6-bb45-73abd209e524" :question/math-academy-id "q-183765" :question/problem "Describe the set $S={...,3,6,9,12,15,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=3$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,3,\\,6,\\,9,\\,12,\\,15,\\,…\n$$\n\nform a two-way infinite arithmetic sequence with common difference $d=3:$\n\n$$\n\\begin{aligned}d & =3 \\\\  & =6-3 \\\\  & =9-6 \\\\  & =12-9 \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=3,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =3+(n-1)\\cdot 3 \\\\  & =3+3n-3 \\\\  & =3n.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={3n\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396301 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c5b3eb6-187f-5f16-a32e-66b0842adfe9" :knowledge-point/title "Expressing a Given Set Using an Arithmetic Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9bae499-f34b-5016-9461-368af2cdb041" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is even}" :db/id #edb/ref 17592186396303} {:answer/id #uuid "4bff9b25-c305-524e-bcfc-903c51f12d8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\in N" :db/id #edb/ref 17592186396304} {:answer/id #uuid "9b94e92e-1568-5b4e-bda8-31144db89020" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{is odd}" :db/id #edb/ref 17592186396305} {:answer/id #uuid "bc8dec5b-0116-5957-b5fa-17562ad4dedd" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396306} {:answer/id #uuid "7057538c-ea56-567c-bd8b-58c32e89c076" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Q" :db/id #edb/ref 17592186396307}] :answer-field/correct {:answer/id #uuid "bc8dec5b-0116-5957-b5fa-17562ad4dedd" :answer/type {:db/ident :answer.type/math} :answer/value "\\in Z" :db/id #edb/ref 17592186396306} :answer-field/id #uuid "7e336390-93f8-593c-a530-18de4565cfde" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396302} {:answer-field/choices [{:answer/id #uuid "4bd5cf80-3e0e-5fd7-9676-437495032f16" :answer/type {:db/ident :answer.type/math} :answer/value "2n-1" :db/id #edb/ref 17592186396309} {:answer/id #uuid "d5776c2c-cddc-5739-beee-d840972a786d" :answer/type {:db/ident :answer.type/math} :answer/value "n+4" :db/id #edb/ref 17592186396310} {:answer/id #uuid "7cd95755-dca6-5b08-98d0-e1f3bc66a997" :answer/type {:db/ident :answer.type/math} :answer/value "7n" :db/id #edb/ref 17592186396311} {:answer/id #uuid "25654cbf-bd5b-5439-b1b9-1906aed8924a" :answer/type {:db/ident :answer.type/math} :answer/value "4n+21" :db/id #edb/ref 17592186396312} {:answer/id #uuid "acb513d2-bb61-560d-b7ae-ae91a2b9a5c1" :answer/type {:db/ident :answer.type/math} :answer/value "4n-9" :db/id #edb/ref 17592186396313}] :answer-field/correct {:answer/id #uuid "acb513d2-bb61-560d-b7ae-ae91a2b9a5c1" :answer/type {:db/ident :answer.type/math} :answer/value "4n-9" :db/id #edb/ref 17592186396313} :answer-field/id #uuid "6a7e0a5f-4cf1-59db-9367-f78b99f89e32" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c89879b-39a9-51be-ab30-8cb400364aca" :question/math-academy-id "q-183770" :question/problem "Describe the set $S={...,-21,-17,-13,-9,-5,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=-5$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,-21,\\,-17,\\,-13,\\,-9,\\,-5,\\,…\n$$\n\nform a two-way infinite arithmetic sequence with common difference $d=4:$\n\n$$\n\\begin{aligned}d & =4 \\\\  & =-17-(-21) \\\\  & =-13-(-17) \\\\  & =-9-(-13) \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=-5,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}+(n-1)\\cdot d \\\\  & =-5+(n-1)\\cdot 4 \\\\  & =-5+4n-4 \\\\  & =4n-9.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={4n-9\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186396314 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04884edb-26ab-5691-9276-5a39738b7de0" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\cdot {2}^{n}" :db/id #edb/ref 17592186396316} {:answer/id #uuid "8f61797a-9b84-55c2-bfde-709089f59a51" :answer/type {:db/ident :answer.type/math} :answer/value "{(\\frac{1}{2})}^{n}" :db/id #edb/ref 17592186396317} {:answer/id #uuid "732edcb4-4e31-5d86-b075-68edffdf6963" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)^{n}" :db/id #edb/ref 17592186396318} {:answer/id #uuid "d360ed39-2b76-51e2-859d-ae7636a79a4a" :answer/type {:db/ident :answer.type/math} :answer/value "{2}^{n}" :db/id #edb/ref 17592186396319}] :answer-field/correct {:answer/id #uuid "732edcb4-4e31-5d86-b075-68edffdf6963" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)^{n}" :db/id #edb/ref 17592186396318} :answer-field/id #uuid "c64fd775-19c5-5b37-86f3-813ff79fb5b9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396315} {:answer-field/choices [{:answer/id #uuid "e84aa15b-0075-53b2-b2ee-5252c71d7011" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186396321} {:answer/id #uuid "a60ac30c-7330-5393-9ba5-55b438cda2bc" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396322} {:answer/id #uuid "e0c270a0-906e-5613-bfea-1079300a2d5f" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186396323}] :answer-field/correct {:answer/id #uuid "a60ac30c-7330-5393-9ba5-55b438cda2bc" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186396322} :answer-field/id #uuid "36af3b8d-7ebd-56b9-a4c0-8231f0ff2499" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396320}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40643ae6-fe96-508d-ba25-a4e8d94924cc" :question/math-academy-id "q-183771" :question/problem "Describe the set $S={…,-2,4,-8,16,-32,...}$ using a constructive definition.\n\n*Hint: Take ${a}_{1}=-2$ in the sequence that generates the elements of $S.$*\n\n$$\nS={ {{field-1}}\\,:\\,n\\in {{field-2}} }\n$$" :question/worked-solution "Notice that the elements of our set\n\n$$\n…,\\,-2,\\,4,\\,-8,\\,16,\\,-32,\\,…\n$$\n\nform a two-way infinite geometric sequence with a common ratio $r=-2:$\n\n$$\n\\begin{aligned}r & =-2 \\\\  & =(\\frac{4}{-2}) \\\\  & =(\\frac{-8}{4}) \\\\  & =(\\frac{16}{-8}) \\\\  & =⋯\\end{aligned}\n$$\n\nTherefore, setting  ${a}_{1}=-2,$ the $n$th term ${a}_{n}$ of our sequence for $n\\in Z$ is given by\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}\\cdot {r}^{n-1} \\\\  & =-2\\cdot (-2)^{n-1} \\\\  & =-2\\cdot (-2)^{n}\\cdot (-2)^{-1} \\\\  & =\\frac{-2}{-2}\\cdot (-2)^{n} \\\\  & =(-2)^{n}.\\end{aligned}\n$$\n\nTherefore, we can define our set using a constructive definition as follows:\n\n$$\nS={(-2)^{n}\\,:\\,n\\in Z}\n$$"}] [{:db/id #edb/ref 17592186395775 :knowledge-point/_questions [{:knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b6f110-fbc4-5322-8a05-6366ff4c13c0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,4,-2⟩" :db/id #edb/ref 17592186395777} {:answer/id #uuid "e6302263-6554-5d2f-bdfe-094ceb26b042" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,2,-2⟩" :db/id #edb/ref 17592186395778} {:answer/id #uuid "337c9891-a990-5356-ae53-39e28e060932" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,4,-4⟩" :db/id #edb/ref 17592186395779} {:answer/id #uuid "12ab6864-c814-589e-8f72-328eeae44af0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨13,-4,-4⟩" :db/id #edb/ref 17592186395780} {:answer/id #uuid "fa67123d-ee59-563d-90e5-5d86c85b1243" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-11,4,4⟩" :db/id #edb/ref 17592186395781}] :answer-field/correct {:answer/id #uuid "337c9891-a990-5356-ae53-39e28e060932" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,4,-4⟩" :db/id #edb/ref 17592186395779} :answer-field/id #uuid "2a758e48-dc27-560b-a0af-fd01b7ea572b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395776}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3437106d-95df-5058-942b-4f64c5179bc5" :question/math-academy-id "q-20512" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+y+2z=1 \\\\  & 2x+3y+4z=6 \\\\  & 3x+3y+4z=11\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and hence solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 2 & 3 & 4 & 6 \\\\ 3 & 3 & 4 & 11\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 2 & 3 & 4 & 6 \\\\ 3 & 3 & 4 & 11\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 3 & 3 & 4 & 11\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & -2 & 8\\end{aligned}] & {R}_{3} & :=-\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -4\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n{\\begin{aligned} & x+y+2z=1 \\\\  & y=4 \\\\  & z=-4\\end{aligned}\n$$\n\nand we can apply back substitution. Substituting both $y=4$ and $z=-4$ into the first equation, we get\n\n$$\nx+(4)+2(-4)=1\\,⟹\\,x=5.\n$$\n\nTherefore, the solution is $x=5,y=4$, and $z=-4.$ Or, in vector form, $⟨5,4,-4⟩.$"}] [{:db/id #edb/ref 17592186395782 :knowledge-point/_questions [{:knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fd7882-e12b-5d1e-bda2-674211a5aad1" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186395784} {:answer/id #uuid "61e0f80f-69b1-578c-857a-82bc0682835a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186395785} {:answer/id #uuid "26a77c96-4bef-5e82-8889-1c4a9ce7d523" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186395786} {:answer/id #uuid "9c9b090b-3cbc-511c-95ab-35fc8c1fc057" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395787} {:answer/id #uuid "d1c50146-0d7c-501d-bf37-4d8d838c3cef" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395788}] :answer-field/correct {:answer/id #uuid "9c9b090b-3cbc-511c-95ab-35fc8c1fc057" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395787} :answer-field/id #uuid "56d7a736-a513-51fb-b585-d99caa2d0531" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395783}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45b1f64f-9248-57a2-a310-050eb4c80ee5" :question/math-academy-id "q-20849" :question/problem "![](images/c9/c9371d5e2bb921b4f5e58423bbce492f2b555122ee42bd861040b57d01070353.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=2(t+1),\\,y=4{t}^{2},\\,-1\\le t<1,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=0.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2,\\,{y}^{′}(t)=8t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{8t}{2}=4t.\n$$\n\nAt the point where $t=0$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =4(0) \\\\  & =0\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395789 :knowledge-point/_questions [{:knowledge-point/id #uuid "dbad38a0-e6cb-563a-8e9c-1cee08397083" :knowledge-point/title "Finding Local Minima and Local Maxima of Other Types of Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "220c4644-028c-5dcb-955d-3b2d5604dc62" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186395791} {:answer/id #uuid "13e59b84-50f4-570b-b93f-907264edf062" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186395792} {:answer/id #uuid "23b5a4de-82e3-5600-a5e2-8553e265a482" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186395793} {:answer/id #uuid "075ca13a-66f5-514e-be5e-b8fce546f7e1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186395794} {:answer/id #uuid "0135acbf-05a9-5225-8572-13c90063bbc7" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395795}] :answer-field/correct {:answer/id #uuid "13e59b84-50f4-570b-b93f-907264edf062" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186395792} :answer-field/id #uuid "5e6ea143-756a-5eb6-a6ed-9e3449dbdb6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395790}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6bb098c4-0b9d-56fe-8eb4-70ba83a986f8" :question/math-academy-id "q-21496" :question/problem "For which value of $x$ does the function $f(x)={x}^{3}+\\frac{48}{x}$ defined for $x\\in (0,\\infty )$ have a local minimum?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}-\\frac{48}{{x}^{2}}.\\end{aligned}\n$$\n\nSolving for ${f}^{′}(x)=0$ on $(0,\\infty )$ gives\n\n$$\n\\begin{aligned}3{x}^{2}-\\frac{48}{{x}^{2}} & =0 \\\\ 3{x}^{4}-48 & =0 \\\\ 3({x}^{4}-16) & =0 \\\\ 3({x}^{2}+4)({x}^{2}-4) & =0 \\\\ 3({x}^{2}+4)(x+2)(x-2) & =0 \\\\ x & =\\pm 2.\\end{aligned}\n$$\n\nSo $x=2$ is a stationary point on $(0,\\infty ).$ Next, to determine whether this point is a local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=1,3$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(1) & =3(1)^{2}-\\frac{48}{{1}^{2}}=-45<0 \\\\ {f}^{′}(3) & =3(3)^{2}-\\frac{48}{{3}^{2}}=27-\\frac{16}{3}=\\frac{65}{3}>0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(0,2)$ | $2$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $1$ |  | $3$ |\n| ${f}^{′}$ | $-$ | $0$ | $+$ |\n| $f$ | $↘$ | min | $↗$ |\n\nFinally, let's use the table above to classify the critical point.\n\n- At $x=2,$ the first derivative changes sign from negative to positive. Therefore, $x=2$ is a local minimum.\n\nWe conclude that $f(x)$ has a local minimum at $x=2.$"}] [{:db/id #edb/ref 17592186395796 :knowledge-point/_questions [{:knowledge-point/id #uuid "dabb3127-172e-5a68-8e27-d22057f8ea8e" :knowledge-point/title "Calculating a Related Rate With a Sphere: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1ea5dbf-e0e0-5b87-9716-69e18e732d25" :answer/type {:db/ident :answer.type/math} :answer/value "8\\pi \\,{\\text{cm}}^{3}\\text{/s}" :db/id #edb/ref 17592186395798} {:answer/id #uuid "967e7ed0-7817-52a2-8722-d7d6b2028465" :answer/type {:db/ident :answer.type/math} :answer/value "16\\pi \\,{\\text{cm}}^{3}\\text{/s}" :db/id #edb/ref 17592186395799} {:answer/id #uuid "ffad3220-17fd-5911-9971-a3e690e83416" :answer/type {:db/ident :answer.type/math} :answer/value "24\\pi \\,{\\text{cm}}^{3}\\text{/s}" :db/id #edb/ref 17592186395800} {:answer/id #uuid "b99d6896-ed6a-55b6-8e15-065a39717d54" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi \\,{\\text{cm}}^{3}\\text{/s}" :db/id #edb/ref 17592186395801} {:answer/id #uuid "350623d5-cf3b-562c-adbc-4f53ac07cc99" :answer/type {:db/ident :answer.type/math} :answer/value "12\\pi \\,{\\text{cm}}^{3}\\text{/s}" :db/id #edb/ref 17592186395802}] :answer-field/correct {:answer/id #uuid "967e7ed0-7817-52a2-8722-d7d6b2028465" :answer/type {:db/ident :answer.type/math} :answer/value "16\\pi \\,{\\text{cm}}^{3}\\text{/s}" :db/id #edb/ref 17592186395799} :answer-field/id #uuid "86b9d34d-27a9-54ed-b870-554479215d16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395797}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "236c5a80-1a72-598b-b891-11878898b571" :question/math-academy-id "q-2549" :question/problem "![](images/27/2771f90d4200f292afe8108a26b8a2e83e6f3a46194c89a18d1688943984b5af.png)\n\nA spherical balloon is inflated so that its radius increases at a rate of $1\\,\\text{cm/s}.$ How fast is the volume of the balloon increasing at the moment when the radius is $2\\,\\text{cm}?$" :question/worked-solution "Let $r$ be the radius of the balloon and $V$ its volume. Both $r$ and $V$ change with time. In particular, we are given\n\n$$\n\\frac{\\text{d}r}{\\text{d}t}=1\\,\\text{cm/s},\n$$\n\nand we want to find $\\frac{\\text{d}V}{\\text{d}t}$ when $r=2\\,\\text{cm}.$\n\nTo start, let's write down the volume formula for the sphere and then differentiate it using implicit differentiation. We get\n\n$$\n\\begin{aligned}V & =\\frac{4}{3}\\pi {r}^{3} \\\\ \\frac{\\text{d}}{\\text{d}t}(V) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}r}(\\frac{4}{3}\\pi {r}^{3}) \\\\ \\frac{\\text{d}V}{\\text{d}t} & =\\frac{\\text{d}r}{\\text{d}t}\\cdot 4\\pi {r}^{2}.\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=1$ and $r=2,$ and solve for $\\frac{\\text{d}V}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}V}{\\text{d}t} & =1\\cdot 4\\pi (2)^{2} \\\\ \\frac{\\text{d}V}{\\text{d}t} & =16\\pi .\\end{aligned}\n$$\n\nTherefore, the volume of the balloon is increasing at a rate of $16\\pi {\\text{ cm}}^{3}\\text{/s}$\n when the radius is $2\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186395803 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2dbfe46-55f0-5d6a-b410-164f0aa2345f" :knowledge-point/title "Calculating a Related Rate With a Circle: Word Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0402c49a-95bf-5a4c-8db7-76e1232ae67c" :answer/type {:db/ident :answer.type/math} :answer/value "\\,8\\pi \\,\\text{cm}\\text{/s}" :db/id #edb/ref 17592186395805} {:answer/id #uuid "c0e22878-a171-5db7-ae1d-822a413a7af0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{5}\\,\\text{cm/s}" :db/id #edb/ref 17592186395806} {:answer/id #uuid "112e9965-7e8a-5453-8d21-40a47cdfca08" :answer/type {:db/ident :answer.type/math} :answer/value "5\\pi \\,\\text{cm}\\text{/s}" :db/id #edb/ref 17592186395807} {:answer/id #uuid "5fad6157-8ec0-522c-a83c-2d09b502068f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{8}\\,\\text{cm/s}" :db/id #edb/ref 17592186395808} {:answer/id #uuid "6152d76a-2613-532a-801b-10af2c97cb7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{5}\\,\\text{cm/s}" :db/id #edb/ref 17592186395809}] :answer-field/correct {:answer/id #uuid "c0e22878-a171-5db7-ae1d-822a413a7af0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{5}\\,\\text{cm/s}" :db/id #edb/ref 17592186395806} :answer-field/id #uuid "ec61e892-1bbe-5a6b-9b14-17fd1b7ef765" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a45a10dd-0c29-5839-ade5-5e0193cac871" :question/math-academy-id "q-2870" :question/problem "![](images/59/598fa373c0312c910c1a13b435a35e6745d3c912884b36b208b7c2d4fca42f75.png)\n\nA circle is decreasing in area at a rate of $8\\pi \\,{\\text{cm}}^{2}\\text{/s}.$ Calculate the rate at which the circumference of the circle is decreasing at the moment when the radius is  $5\\,\\text{cm}.$" :question/worked-solution "In this situation, we want to find $\\frac{\\text{d}C}{\\text{d}t}$ at the moment when $r=5,$ and we are also told that  $\\frac{\\text{d}A}{\\text{d}t}=-8\\pi .$\n\nTo start, let's set up an equation relating the area $A$ and the circumference $C$ of the circle. Since $C=2\\pi r$ and $A=\\pi {r}^{2},$ the relationship between $A$ and $C$ is\n\n$$\nA=\\pi {r}^{2}=\\pi {(\\frac{C}{2\\pi })}^{2}=\\frac{{C}^{2}}{4\\pi }.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{C}^{2}}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}C}(\\frac{{C}^{2}}{4\\pi }) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{C}{2\\pi }.\\end{aligned}\n$$\n\nWhen $r=5\\,\\text{cm},$ $C=2\\pi (5)=10\\pi \\text{ cm}.$ Hence, substituting $\\frac{\\text{d}A}{\\text{d}t}=-8\\pi $ and $C=10\\pi $, and solving for $\\frac{\\text{d}C}{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}-8\\pi  & =\\frac{\\text{d}C}{\\text{d}t}\\cdot \\frac{10\\pi }{2\\pi } \\\\ -8\\pi  & =\\frac{\\text{d}C}{\\text{d}t}\\cdot 5 \\\\ \\frac{\\text{d}C}{\\text{d}t} & =-\\frac{8\\pi }{5}.\\end{aligned}\n$$\n\nWe conclude that the circumference is decreasing at a rate of $\\frac{8\\pi }{5}\\text{ cm/s}.$"}] [{:db/id #edb/ref 17592186395810 :knowledge-point/_questions [{:knowledge-point/id #uuid "74c9c0f6-034c-5d9c-935a-ca27dec1a648" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35051668-a56c-5024-9510-5bb50d0360fc" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186395812} {:answer/id #uuid "9c07c6a6-5b40-55a4-9250-674b5ab51617" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,731" :db/id #edb/ref 17592186395813} {:answer/id #uuid "0d4cbb58-b903-5380-9c08-172acb79c3a7" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,631" :db/id #edb/ref 17592186395814} {:answer/id #uuid "6fbfb4e9-a306-5d6f-a040-1f5b9ed69042" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,851" :db/id #edb/ref 17592186395815} {:answer/id #uuid "8c3be72d-8de9-5e24-a778-ee5537402bbc" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,561" :db/id #edb/ref 17592186395816}] :answer-field/correct {:answer/id #uuid "35051668-a56c-5024-9510-5bb50d0360fc" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186395812} :answer-field/id #uuid "4440a234-4417-5c7c-aab8-361ac22515f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395811}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fa4866c-44a3-53be-9ea4-1b3c073da31b" :question/math-academy-id "q-29664" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=-\\frac{3}{4}$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=-\\frac{4}{3}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{4}{3})=(-53.130\\,1…)^{∘}≈-{53.130}^{∘}\\end{aligned}\n$$\n\nSince $-{53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}=-{53.130}^{∘}.$\n\nTo generate more solutions, we add and subtract integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+x={180}^{∘}-{53.130}^{∘}={126.870}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-{53.130}^{∘},{126.870}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n-53.130\\cdot 126.870≈-6\\,741\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186395817 :knowledge-point/_questions [{:knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab6f005d-5267-58e5-84bf-a80272331a4e" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,176" :db/id #edb/ref 17592186395819} {:answer/id #uuid "7e3a07e3-abf9-52a3-90a9-53487e034b7f" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,641" :db/id #edb/ref 17592186395820} {:answer/id #uuid "ce65e29e-1b9d-54dc-94af-379795c62563" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,741" :db/id #edb/ref 17592186395821} {:answer/id #uuid "198aafc0-07ef-5e53-9034-41f2a9658b0c" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,746" :db/id #edb/ref 17592186395822} {:answer/id #uuid "21c0594d-dee0-5fde-9687-2438c3bda33b" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,764" :db/id #edb/ref 17592186395823}] :answer-field/correct {:answer/id #uuid "ce65e29e-1b9d-54dc-94af-379795c62563" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,741" :db/id #edb/ref 17592186395821} :answer-field/id #uuid "d68ef59f-9eeb-59d5-b977-da3a30f3eafc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395818}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa37b599-4ad5-59f0-a1aa-7677947192cf" :question/math-academy-id "q-29938" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{5}{4}$ for $-{180}^{∘}\\le x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{4}{5}.\n$$\n\nNow, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{4}{5})=(53.130\\,1…)^{∘}≈{53.130}^{∘}\n$$\n\nSince ${53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={53.130}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={53.130}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={53.130}^{∘}.$\n\n![](images/60/605af77803fb027c09833b50801fe4b8e6a42a2b623af94a732d0f2f222f9f4a.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{53.130}^{∘} \\\\  & ={126.870}^{∘}\\end{aligned}\n$$\n\nTherefore, the solutions are $x={53.130}^{∘},{126.870}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈53.130\\cdot 126.870≈6\\,741.\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186395824 :knowledge-point/_questions [{:knowledge-point/id #uuid "6093e24d-14bb-5e3b-a0b4-7a562a12f6a2" :knowledge-point/title "Finding the LU Factorization of a Singular 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81cd41bb-3b8b-523d-bba4-663fea053bca" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186395826} {:answer/id #uuid "a5409d58-44db-5807-910e-62ab3782a6c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186395827} {:answer/id #uuid "82102128-542e-579d-9940-db382f219285" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186395828} {:answer/id #uuid "dde7cc49-7da0-570d-8620-a8c63e1c4ed1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186395829} {:answer/id #uuid "36be2875-3181-5ac3-8618-36c648d5918d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186395830}] :answer-field/correct {:answer/id #uuid "82102128-542e-579d-9940-db382f219285" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186395828} :answer-field/id #uuid "9431c4a2-40f0-53be-95c1-e0f65f36ff4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "98334c69-2d0e-5223-82ea-d968a6c359cb" :question/math-academy-id "q-32531" :question/problem "Given that \n$A=[\\begin{aligned}2 & 4 \\\\ 5 & 10\\end{aligned}]$ has the LU decomposition $A=LU$, then ${l}_{21}+{u}_{22}=$" :question/worked-solution "To find the matrices $L$ and $U,$ we reduce the matrix $A$ to row echelon form. Whilst doing this, we simultaneously write down the row operations applied to $A$ in terms of matrix multiplication using elementary matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 4 \\\\ 5 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}+(-\\frac{5}{2}){R}_{1}\\,⟺\\,\\overset{{E}_{1}}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ -\\frac{5}{2} & 1\\end{aligned}]}}\\cdot A \\\\  & ∼[\\begin{aligned}2 & 4 \\\\ 0 & 0\\end{aligned}] \\\\  & =U\\end{aligned}\n$$\n\nThe reduced matrix is upper triangular, so it is our matrix $U.$ Now, since ${E}_{1}A=U,$ we can invert ${E}_{1}$ to arrive at the desired LU factorization:\n\n$$\n\\begin{aligned}{E}_{1}A & =U \\\\ A & ={E}_{1}^{-1}U \\\\ A & ={[\\begin{aligned}1 & 0 \\\\ -\\frac{5}{2} & 1\\end{aligned}]}^{-1}U \\\\ A & ={{[\\begin{aligned}1 & 0 \\\\ \\frac{5}{2} & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}2 & 4 \\\\ 0 & 0\\end{aligned}]}_{⏟}}_{U}\\end{aligned}\n$$\n\nTherefore, ${l}_{21}=\\frac{5}{2},{u}_{22}=0,$ and ${l}_{21}+{u}_{22}=\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186396324 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd" :knowledge-point/title "Proving the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "565d4699-585c-59ff-8946-cbdc268b0c14" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-1)t}" :db/id #edb/ref 17592186396326} {:answer/id #uuid "2f34b198-133c-5315-a86b-d31d8a6f1738" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s-1)t}" :db/id #edb/ref 17592186396327} {:answer/id #uuid "dfc0db2c-91be-581b-800f-9ebf7f1c9be0" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s+1)t}" :db/id #edb/ref 17592186396328} {:answer/id #uuid "cc5232e1-5fa0-5561-93b3-1946ca031a8a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s+1)t}" :db/id #edb/ref 17592186396329}] :answer-field/correct {:answer/id #uuid "565d4699-585c-59ff-8946-cbdc268b0c14" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-1)t}" :db/id #edb/ref 17592186396326} :answer-field/id #uuid "d858d9ef-a7c9-5447-928a-43ac88428e2c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186396325} {:answer-field/choices [{:answer/id #uuid "9c728158-4fc3-5a33-a133-bedfea151d4a" :answer/type {:db/ident :answer.type/math} :answer/value "B(s)" :db/id #edb/ref 17592186396331} {:answer/id #uuid "6e3038c2-2b2b-5735-8b31-0aa80e1714b5" :answer/type {:db/ident :answer.type/math} :answer/value "B(s-1)" :db/id #edb/ref 17592186396332} {:answer/id #uuid "382169fb-8250-5631-aec7-bba4ab524482" :answer/type {:db/ident :answer.type/math} :answer/value "B(s+1)" :db/id #edb/ref 17592186396333}] :answer-field/correct {:answer/id #uuid "6e3038c2-2b2b-5735-8b31-0aa80e1714b5" :answer/type {:db/ident :answer.type/math} :answer/value "B(s-1)" :db/id #edb/ref 17592186396332} :answer-field/id #uuid "0527367f-7772-596