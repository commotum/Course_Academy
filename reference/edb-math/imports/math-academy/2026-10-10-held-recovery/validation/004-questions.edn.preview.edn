 true] [17592186386153 1072 #uuid "f92da47c-e719-5f4d-aa7e-be4e5edae187" 13194139533462 17592186045585 true] [17592186386153 1074 "First, we compute ${Z}^{2}$ as follows:\n\n$$\n\\begin{aligned}{Z}^{2} & =Z\\cdot Z \\\\  & =[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}]\\cdot [\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}] \\\\  & =Z\\end{aligned}\n$$\n\nNotice that ${Z}^{2}=Z,$ so $Z$ is an idempotent matrix. \n\nWe can use this fact to compute ${Z}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{Z}^{5} & ={Z}^{2}\\cdot {Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z\\cdot Z \\\\  & ={Z}^{2}\\cdot Z \\\\  & =Z\\cdot Z \\\\  & ={Z}^{2} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{Z}^{5}=[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}].\n$$" 13194139533462 17592186045585 true] [17592186386154 1075 #edb/ref 17592186386155 13194139533462 17592186045585 true] [17592186386154 1075 #edb/ref 17592186386156 13194139533462 17592186045585 true] [17592186386154 1075 #edb/ref 17592186386157 13194139533462 17592186045585 true] [17592186386154 1075 #edb/ref 17592186386158 13194139533462 17592186045585 true] [17592186386154 1075 #edb/ref 17592186386159 13194139533462 17592186045585 true] [17592186386154 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386154 1077 "selection" 13194139533462 17592186045585 true] [17592186386154 1079 #edb/ref 17592186386157 13194139533462 17592186045585 true] [17592186386154 1080 #uuid "12ef64bb-d65e-5cfd-b87f-976d076e6e82" 13194139533462 17592186045585 true] [17592186386155 1081 "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386155 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386155 1084 #uuid "d0b2a5a8-67e7-5639-9d41-6b6082af0189" 13194139533462 17592186045585 true] [17592186386156 1081 "[\\begin{aligned}1 & -6 \\\\ 0 & 1\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386156 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386156 1084 #uuid "6cf33cc7-55a2-56b0-9243-826fe4617b79" 13194139533462 17592186045585 true] [17592186386157 1081 "[\\begin{aligned}1 & 0 \\\\ -6 & 0\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386157 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386157 1084 #uuid "b56078f5-e9a2-54d5-b4dc-d6536dec2e4a" 13194139533462 17592186045585 true] [17592186386158 1081 "[\\begin{aligned}1 & 1 \\\\ -6 & 0\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386158 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386158 1084 #uuid "6198d7ae-e34d-53ed-983e-2b4492d3825c" 13194139533462 17592186045585 true] [17592186386159 1081 "[\\begin{aligned}1 & -6 \\\\ 0 & -1\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386159 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386159 1084 #uuid "90b66a89-a532-5756-b976-d72f2602a6b2" 13194139533462 17592186045585 true] [17592186386160 1068 #edb/ref 17592186386161 13194139533462 17592186045585 true] [17592186386160 1069 "q-78866" 13194139533462 17592186045585 true] [17592186386160 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186386160 1071 "What is the center of the hyperbola $\\frac{(y+4)^{2}}{3}-\\frac{(x+1)^{2}}{2}=1?$" 13194139533462 17592186045585 true] [17592186386160 1072 #uuid "de6c6396-07c7-5951-af5e-8977842d4648" 13194139533462 17592186045585 true] [17592186386160 1074 "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-(-4))^{2}}{3}-\\frac{(x-(-1))^{2}}{2}=1\n$$\n\nIn this case, we have $h=-1$ and $k=-4.$\n\nTherefore, the center of the hyperbola is $(-1,-4).$" 13194139533462 17592186045585 true] [17592186386161 1075 #edb/ref 17592186386162 13194139533462 1759