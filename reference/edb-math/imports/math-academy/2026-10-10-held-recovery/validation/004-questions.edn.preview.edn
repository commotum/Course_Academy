}^{2}}{4}=1.$" 13194139533462 17592186045585 true] [17592186386812 1072 #uuid "649c6af8-efb9-5066-82d7-b9fe88bc6cab" 13194139533462 17592186045585 true] [17592186386812 1074 "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{64}=8,\\,b=\\sqrt{4}=2.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{8}{2}x \\\\  & =\\pm 4x.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386813 1075 #edb/ref 17592186386814 13194139533462 17592186045585 true] [17592186386813 1075 #edb/ref 17592186386815 13194139533462 17592186045585 true] [17592186386813 1075 #edb/ref 17592186386816 13194139533462 17592186045585 true] [17592186386813 1075 #edb/ref 17592186386817 13194139533462 17592186045585 true] [17592186386813 1075 #edb/ref 17592186386818 13194139533462 17592186045585 true] [17592186386813 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386813 1077 "selection" 13194139533462 17592186045585 true] [17592186386813 1079 #edb/ref 17592186386817 13194139533462 17592186045585 true] [17592186386813 1080 #uuid "e80dbdc0-2ad0-5eea-861f-4ded9178f54c" 13194139533462 17592186045585 true] [17592186386814 1081 "y=\\pm 2x" 13194139533462 17592186045585 true] [17592186386814 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386814 1084 #uuid "8228dbac-db19-51bf-aac6-23a94ad79387" 13194139533462 17592186045585 true] [17592186386815 1081 "y=\\pm \\frac{1}{2}x" 13194139533462 17592186045585 true] [17592186386815 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386815 1084 #uuid "a5a2f9b3-aae2-5809-a1fe-f434f65b581b" 13194139533462 17592186045585 true] [17592186386816 1081 "y=\\pm 8x" 13194139533462 17592186045585 true] [175921