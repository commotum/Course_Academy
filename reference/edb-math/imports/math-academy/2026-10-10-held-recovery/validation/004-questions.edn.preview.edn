2186386299 13194139533462 17592186045585 true] [17592186386298 1069 "q-80757" 13194139533462 17592186045585 true] [17592186386298 1070 #edb/ref 17592186045487 13194139533462 17592186045585 true] [17592186386298 1071 "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)=x+3y$ and ${f}_{y}(x,y)=2{e}^{y}+3x$\n- ${f}_{x}(x,y)={x}^{2}+{e}^{x}+y$ and ${f}_{y}(x,y)=2x+{y}^{2}+{e}^{y}$\n- ${f}_{x}(x,y)=2y\\operatorname{sin}⁡x\\operatorname{cos}⁡x+xy+5$ and ${f}_{y}(x,y)={sin}^{2}⁡x+xy-2$" 13194139533462 17592186045585 true] [17592186386298 1072 #uuid "0ea0748a-6bf5-5641-b2b0-ad6357ffcd5f" 13194139533462 17592186045585 true] [17592186386298 1074 "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(x+3y)=3 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2{e}^{y}+3x)=3.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the first pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({x}^{2}+{e}^{x}+y)=1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2x+{y}^{2}+{e}^{y})=2.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the second pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2y\\operatorname{sin}⁡x\\operatorname{cos}⁡x+xy+5)=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x+x \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({sin}^{2}⁡x+xy-2)=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x+y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$,  the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'I only'." 13194139533462 17592186045585 true] [17592186386299 1075 #edb/ref 17592186386300 13194139533462 17592186045585 true] [17592186386299 1075 #edb/ref 17592186386301 13194139533462 17592186045585 true] [17592186386299 1075 #edb/ref 17592186386302 13194139533462 17592186045585 true] [17592186386299 1075 #edb/ref 17592186386303 13194139533462 17592186045585 true] [17592186386299 1075 #edb/ref 17592186386304 13194139533462 17592186045585 true] [17592186386299 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386299 1077 "selection" 13194139533462 17592186045585 true] [17592186386299 1079 #edb/ref 17592186386302 13194139533462 17592186045585 true] [17592186386299 1080 #uuid "7e1a5aa2-c82d-5ff4-92c3-41a98241ecca" 13194139533462 17592186045585 true] [17592186386300 1081 "II and III only" 13194139533462 17592186045585 true] [17592186386300 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386300 1084 #uuid "28e2e18a-5596-5de6-bbca-4a696f6fe37b" 13194139533462 17592186045585 true] [17592186386301 1081 "I and III only" 13194139533462 17592186045585 true] [17592186386301 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386301 1084 #uuid "09df3dd0-d105-5273-9da9-f927bd858604" 13194139533462 17592186045585 true] [17592186386302 1081 "I only" 13194139533462 17592186045585 true] [17592186386302 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386302 1084 #uuid "31ca151e-3d85-538f-9503-8357954047b6" 13194139533462 17592186045585 true] [17592186386303 1081 "I and II only" 13194139533462 17592186045585 true] [17592186386303 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386303 1084 #uuid "bbe4bfb9-4acb-5346-98fc-89085a4ab2ee" 13194139533462 17592186045585 true] [17592186386304 1081 "II only" 13194139533462 17592186045585 true] [17592186386304 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386304 1084 #uuid "3a8ec263-0942-5538-bcf0-7ac5209d5ab8" 13194139533462 17592186045585 true] [17592186386305 1068 #edb/ref 17592186386306 13194139533462 17592186045585 true] [17592186386305 1069 "q-80762" 13194139533462 17592186045585 true] [17592186386305 1070 #edb/ref 17592186045487 13194139533462 17592186045585 true] [17592186386305 1071 "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)=2x-2{y}^{2}$ and ${f}_{y}(x,y)=2y-2xy$\n- ${f}_{x}(x,y)=\\operatorname{sin}⁡({e}^{x})$ and ${f}_{y}(x,y)={e}^{y}\\operatorname{cos}⁡y$\n- ${f}_{x}(x,y)=3{x}^{2}{y}^{2}$ and ${f}_{y}(x,y)=2{x}^{3}y-\\sqrt{y}$" 13194139533462 17592186045585 true] [17592186386305 1072 #uuid "813fc330-f1d0-5e6c-9e4f-df4f6cf7d2b1" 13194139533462 17592186045585 true] [17592186386305 1074 "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2x-2{y}^{2})=-4y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2y-2xy)=-2y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡({e}^{x}))=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({e}^{y}\\operatorname{cos}⁡y)=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(3{x}^{2}{y}^{2})=6{x}^{2}y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(2{x}^{3}y-\\sqrt{y})=6{x}^{2}y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is 'II and III only'." 13194139533462 17592186045585 true] [17592186386306 1075 #edb/ref 17592186386307 13194139533462 17592186045585 true] [17592186386306 1075 #edb/ref 17592186386308 13194139533462 17592186045585 true] [17592186386306 1075 #edb/ref 17592186386309 13194139533462 17592186045585 true] [17592186386306 1075 #edb/ref 17592186386310 13194139533462 17592186045585 true] [17592186386306 1075 #edb/ref 17592186386311 13194139533462 17592186045585 true] [17592186386306 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386306 1077 "selection" 13194139533462 17592186045585 true] [17592186386306 1079 #edb/ref 17592186386307 13194139533462 17592186045585 true] [17592186386306 1080 #uuid "a353388b-c694-5c01-8605-b66eb1aeea2a" 13194139533462 17592186045585 true] [17592186386307 1081 "II and III only" 13194139533462 17592186045585 true] [17592186386307 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386307 1084 #uuid "9b9df995-ca8a-553b-a6ed-3dd5aef9c75d" 13194139533462 17592186045585 true] [17592186386308 1081 "I and III only" 13194139533462 17592186045585 true] [17592186386308 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386308 1084 #uuid "274ca2ba-50aa-5d5c-af4b-9697f3a361d0" 13194139533462 17592186045585 true] [17592186386309 1081 "I only" 13194139533462 17592186045585 true] [17592186386309 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386309 1084 #uuid "c5b60381-0856-5f13-bfd3-196e04b71673" 13194139533462 17592186045585 true] [17592186386310 1081 "III only" 13194139533462 17592186045585 true] [17592186386310 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386310 1084 #uuid "6820c28e-c4b3-57ee-827e-0db27a7363cf" 13194139533462 17592186045585 true] [17592186386311 1081 "II only" 13194139533462 17592186045585 true] [17592186386311 1083 #edb/ref 17592186045500 13194139533462 17592186045585 true] [17592186386311 1084 #uuid "c02968a7-a32e-5cbd-9bd2-d22d97951dc5" 13194139533462 17592186045585 true] [17592186386312 1068 #edb/ref 17592186386313 13194139533462 17592186045585 true] [17592186386312 1069 "q-80768" 13194139533462 17592186045585 true] [17592186386312 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186386312 1071 "Given the function $f(x,y,z)={x}^{2}y+{y}^{2}-xz$,  find the equation of the tangent plane to the level surface that passes through the point where $(x,y,z)=(2,-1,-1).$" 13194139533462 17592186045585 true] [17592186386312 1072 #uuid "6f18a33a-3190-5d7a-b7c8-c7f2c7cbfe22" 13194139533462 17592186045585 true] [17592186386312 1074 "The equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y,z)$ and evaluate it at $({x}_{0},{y}_{0},{z}_{0})=(2,-1,-1):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}({x}^{2}y+{y}^{2}-xz)\\text{ }i+\\frac{∂}{∂y}({x}^{2}y+{y}^{2}-xz)\\text{ }j+\\frac{∂}{∂z}({x}^{2}y+{y}^{2}-xz)\\text{ }k \\\\  & =(2xy-z)\\text{ }i+({x}^{2}+2y)\\text{ }j-xk \\\\ ∇\\,f(2,-1,-1) & =(\\,2(2)(-1)-(-1)\\,)\\text{ }i+(\\,{2}^{2}+2(-1)\\,)\\text{ }j-2k \\\\  & =-3\\,i+2\\,j-2\\,k \\\\  & =⟨-3,2,-2⟩\\end{aligned}\n$$\n\nWe can now write down the Cartesian equation of the tangent plane to the level surface, as follows: \n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(2,-1,-1)\\cdot ⟨x-2,\\,y+1,\\,z+1⟩ & =0 \\\\ ⟨-3,2,-2⟩\\cdot ⟨x-2,\\,y+1,\\,z+1⟩ & =0\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386313 1075 #edb/ref 17592186386314 13194139533462 17592186045585 true] [17592186386313 1075 #edb/ref 17592186386315 13194139533462 17592186045585 true] [17592186386313 1075 #edb/ref 17592186386316 13194139533462 17592186045585 true] [17592186386313 1075 #edb/ref 17592186386317 13194139533462 17592186045585 true] [17592186386313 1075 #edb/ref 17592186386318 13194139533462 17592186045585 true] [17592186386313 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386313 1077 "selection" 13194139533462 17592186045585 true] [17592186386313 1079 #edb/ref 17592186386314 13194139533462 17592186045585 true] [17592186386313 1080 #uuid "1883a36c-4cc8-545f-9348-6c077cb4b1e9" 13194139533462 17592186045585 true] [17592186386314 1081 "⟨-3,2,-2⟩\\cdot ⟨x-2,\\,y+1,\\,z+1⟩=0" 13194139533462 17592186045585 true] [17592186386314 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386314 1084 #uuid "55726bdf-bd92-5f7e-a7bc-7a1d0597e754" 13194139533462 17592186045585 true] [17592186386315 1081 "⟨2,-3,-2⟩\\cdot ⟨x-2,\\,y+1,\\,z+1⟩=0" 13194139533462 17592186045585 true] [17592186386315 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386315 1084 #uuid "9575e423-448b-5b5c-91fc-c2a7c6afcec3" 13194139533462 17592186045585 true] [17592186386316 1081 "⟨-3,2,-2⟩\\cdot ⟨x-3,\\,y+2,\\,z-2⟩=0" 13194139533462 17592186045585 true] [17592186386316 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386316 1084 #uuid "21a4639b-6da9-5a98-9ba9-dde732cd477b" 13194139533462 17592186045585 true] [17592186386317 1081 "⟨2,-3,2⟩\\cdot ⟨x+2,\\,y+1,\\,z+1⟩=0" 13194139533462 17592186045585 true] [17592186386317 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386317 1084 #uuid "14d65a68-8209-56ec-85e3-86c5087733e8" 13194139533462 17592186045585 true] [17592186386318 1081 "⟨3,2,2⟩\\cdot