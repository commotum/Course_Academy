33462 17592186045585 true] [17592186387678 1071 "Calculate ${\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t$ given that ${\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩$ and ${\\int }_{1}^{3}g(t)\\,\\text{d}t=⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩.$" 13194139533462 17592186045585 true] [17592186387678 1072 #uuid "4c2ff90f-3df2-5a7a-ae8c-1f49f03b53d3" 13194139533462 17592186045585 true] [17592186387678 1074 "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t & ={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+4⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩ \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+⟨3,\\,2,\\,-10⟩ \\\\  & =⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387679 1075 #edb/ref 17592186387680 13194139533462 17592186045585 true] [17592186387679 1075 #edb/ref 17592186387681 13194139533462 17592186045585 true] [17592186387679 1075 #edb/ref 17592186387682 13194139533462 17592186045585 true] [17592186387679 1075 #edb/ref 17592186387683 13194139533462 17592186045585 true] [17592186387679 1075 #edb/ref 17592186387684 13194139533462 17592186045585 true] [17592186387679 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387679 1077 "selection" 13194139533462 17592186045585 true] [17592186387679 1079 #edb/ref 17592186387684 13194139533462 17592186045585 true] [17592186387679 1080 #uuid "e5f819ae-49fc-5c26-94b2-5e3cdd0e1a0f" 13194139533462 17592186045585 true] [17592186387680 1081 "⟨3-\\operatorname{ln}⁡3,\\,\\sqrt{3}-3,\\,8⟩" 13194139533462 17592186045585 true] [17592186387680 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387680 1084 #uuid "9fa697c9-4d76-5898-8fb5-ac84a77debdb" 13194139533462 17592186045585 true] [17592186387681 1081 "⟨8+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-12⟩" 13194139533462 17592186045585 true] [17592186387681 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387681 1084 #uuid "ae8a89ab-8c73-517f-8e47-53ad9f4c06fe" 13194139533462 17592186045585 true] [17592186387682 1081 "⟨-8+\\operatorname{ln}⁡3,\\,1,\\,0⟩" 13194139533462 17592186045585 true] [17592186387682 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387682 1084 #uuid "b9fcf75b-c1d0-5f39-9056-7c5640eb928e" 13194139533462 17592186045585 true] [17592186387683 1081 "⟨\\operatorname{ln}⁡3,\\,\\sqrt{3},\\,1⟩" 13194139533462 17592186045585 true] [17592186387683 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387683 1084 #uuid "1423503f-a4b1-5ae9-ba3b-0e1efa315d59" 13194139533462 17592186045585 true] [17592186387684 1081 "⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩" 13194139533462 17592186045585 true] [17592186387684 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387684 1084 #uuid "ab0fdc34-4ee8-516c-b880-42f9c2fcec55" 13194139533462 17592186045585 true] [17592186387685 1068 #edb/ref 17592186387686 13194139533462 17592186045585 true] [17592186387685 1069 "q-98172" 13194139533462 17592186045585 true] [17592186387685 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186387685 1071 "Calculate \n${\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨4,\\,-10,\\,-14⟩.$" 13194139533462 17592186045585 true] [17592186387685 1072 #uuid "e0a8f71d-793f-5891-8d8f-395df7dbd166" 13194139533462 17592186045585 true] [17592186387685 1074 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨4,\\,-10,\\,-14⟩ \\\\  & =⟨-4,\\,10,\\,14⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{2}\\cdot ⟨-4,\\,10,\\,14⟩ \\\\  & =⟨-2,\\,5,\\,7⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387686 1075 #edb/ref 17592186387687 13194139533462 17592186045585 true] [17592186387686 1075 #edb/ref 17592186387688 13194139533462 17592186045585 true] [17592186387686 1075 #edb/ref 17592186387689 13194139533462 17592186045585 true] [17592186387686 1075 #edb/ref 17592186387690 13194139533462 17592186045585 true] [17592186387686 1075 #edb/ref 17592186387691 13194139533462 17592186045585 true] [17592186387686 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387686 1077 "selection" 13194139533462 17592186045585 true] [17592186387686 1079 #edb/ref 17592186387688 13194139533462 17592186045585 true] [17592186387686 1080 #uuid "e1aae533-8d8a-5285-b8ff-9cc79c87f698" 13194139533462 17592186045585 true] [17592186387687 1081 "⟨4,\\,10,\\,14⟩" 13194139533462 17592186045585 true] [17592186387687 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387687 1084 #uuid "de2ac76c-9113-5a47-9157-727b5201bce3" 13194139533462 17592186045585 true] [17592186387688 1081 "⟨-2,\\,5,\\,7⟩" 13194139533462 17592186045585 true] [17592186387688 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387688 1084 #uuid "47e5a16a-fd42-59c9-8c7f-aefb666ddc96" 13194139533462 17592186045585 true] [17592186387689 1081 "⟨-4,\\,10,\\,14⟩" 13194139533462 17592186045585 true] [17592186387689 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387689 1084 #uuid "723d9e2a-b13f-5333-9e82-034a6fe25fc2" 13194139533462 17592186045585 true] [17592186387690 1081 "⟨-8,\\,15,\\,-7⟩" 13194139533462 17592186045585 true] [17592186387690 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387690 1084 #uuid "47f5751b-90f0-5f7b-8be3-eb434daf135c" 13194139533462 17592186045585 true] [17592186387691 1081 "⟨2,\\,-5,\\,-7⟩" 13194139533462 17592186045585 true] [17592186387691 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387691 1084 #uuid "45704cad-5ba2-5545-9012-731551bd8d93" 13194139533462 17592186045585 true] [17592186387692 1068 #edb/ref 17592186387693 13194139533462 17592186045585 true] [17592186387692 1069 "q-98184" 13194139533462 17592186045585 true] [17592186387692 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186387692 1071 "Calculate \n${\\int }_{3}^{0}\\frac{2}{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨-6,\\,12,\\,-15⟩.$" 13194139533462 17592186045585 true] [17592186387692 1072 #uuid "099705ff-e717-5adc-afb2-82279d484326" 13194139533462 17592186045585 true] [17592186387692 1074 "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{3}^{0}f(t)\\,\\text{d}t & =-{\\int }_{0}^{3}f(t)\\,\\text{d}t \\\\  & =-⟨-6,\\,12,\\,-15⟩ \\\\  & =⟨6,\\,-12,\\,15⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{3}^{0}\\frac{2}{3}f(t)\\,\\text{d}t & =\\frac{2}{3}{\\int }_{3}^{0}f(t)\\,\\text{d}t \\\\  & =\\frac{2}{3}\\cdot ⟨6,\\,-12,\\,15⟩ \\\\  & =⟨4,\\,-8,\\,10⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387693 1075 #edb/ref 17592186387694 13194139533462 17592186045585 true] [17592186387693 1075 #edb/ref 17592186387695 13194139533462 17592186045585 true] [17592186387693 1075 #edb/ref 17592186387696 13194139533462 17592186045585 true] [17592186387693 1075 #edb/ref 17592186387697 13194139533462 17592186045585 true] [17592186387693 1075 #edb/ref 17592186387698 13194139533462 17592186045585 true] [17592186387693 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387693 1077 "selection" 13194139533462 17592186045585 true] [17592186387693 1079 #edb/ref 17592186387698 13194139