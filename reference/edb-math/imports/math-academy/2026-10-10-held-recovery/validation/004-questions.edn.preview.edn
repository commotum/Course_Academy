139533462 17592186045585 true] [17592186386607 1068 #edb/ref 17592186386608 13194139533462 17592186045585 true] [17592186386607 1069 "q-82358" 13194139533462 17592186045585 true] [17592186386607 1070 #edb/ref 17592186045486 13194139533462 17592186045585 true] [17592186386607 1071 "Consider the finite region $D$ in the $xy$-plane enclosed by the curve $y=\\sqrt{x-2}+1,$ and the lines $y=2-\\frac{1}{2}x$ and $y=8-2x.$ Express ${∬}_{D}f(x,y)\\,dA$ as a sum of repeated integrals over type II regions." 13194139533462 17592186045585 true] [17592186386607 1072 #uuid "9fc12f5e-e89a-5d92-929e-151cd796ef36" 13194139533462 17592186045585 true] [17592186386607 1074 "First, let's write our equations in terms of $y,$ as follows:\n\n$$\n\\begin{aligned}y=\\sqrt{x-2}+1 & \\,⟹\\,x=(y-1)^{2}+2 \\\\ y=2-\\frac{1}{2}x & \\,⟹\\,x=4-2y \\\\ y=8-2x & \\,⟹\\,x=4-\\frac{1}{2}y\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/3f/3f8e3ccfeac236d7fe9a502f599c61c404607a55ae809ec142019a3f881e1568.png)\n\n  \n\nThe region $D$ can be partitioned into two type II regions ${D}_{1}$ and ${D}_{2},$ as shown below. \n\n![](images/31/3148cb0f499564db9cbfd6b635fef81dc47298789241af4a243c32dbf4dc8247.png)\n\n  \n\nAs a result, we get\n\n$$\n{D}_{1}={(x,y)\\,:\\,0\\le y\\le 1,\\,4-2y\\le x\\le 4-\\frac{1}{2}y}\n$$\n\nand \n\n$$\n{D}_{2}={(x,y)\\,:\\,1\\le y\\le 2,\\,(y-1)^{2}+2\\le x\\le 4-\\frac{1}{2}y}.\n$$\n\nTherefore, using the additivity property of double integrals, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={∬}_{{D}_{1}}f(x,y)\\,dA+{∬}_{{D}_{2}}f(x,y)\\,dA \\\\  & ={\\int }_{0}^{1}{\\int }_{4-2y}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{2}{\\int }_{(y-1)^{2}+2}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386608 1075 #edb/ref 17592186386609 13194139533462 17592186045585 true] [17592186386608 1075 #edb/ref 17592186386610 13194139533462 17592186045585 true] [17592186386608 1075 #edb/ref 17592186386611 13194139533462 17592186045585 true] [17592186386608 1075 #edb/ref 17592186386612 13194139533462 17592186045585 true] [17592186386608 1075 #edb/ref 17592186386613 13194139533462 17592186045585 true] [17592186386608 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386608 1077 "selection" 13194139533462 17592186045585 true] [17592186386608 1079 #edb/ref 17592186386612 13194139533462 17592186045585 true] [17592186386608 1080 #uuid "04797421-9350-5d4c-9079-ec7a41aeb866" 13194139533462 17592186045585 true] [17592186386609 1081 "{\\int }_{0}^{1}{\\int }_{4-2y}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{2}{\\int }_{4-2y}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y" 13194139533462 17592186045585 true] [17592186386609 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386609 1084 #uuid "edf7f184-6600-513c-98a9-e621ee225359" 13194139533462 17592186045585 true] [17592186386610 1081 "{\\int }_{0}^{1}{\\int }_{0}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{2}{\\int }_{(y-1)^{2}+2}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y" 13194139533462 17592186045585 true] [17592186386610 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386610 1084 #uuid "edc084ee-d037-55c9-8d5f-1af0f8274d8f" 13194139533462 17592186045585 true] [17592186386611 1081 "{\\int }_{0}^{1}{\\int }_{4-2y}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{2}{\\int }_{(y-1)^{2}+2}^{4-2y}f(x,y)\\,\\text{d}x\\,\\text{d}y" 13194139533462 17592186045585 true] [17592186386611 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386611 1084 #uuid "1512ad11-94d7-52a8-bd1c-4b27cbfbadbd" 13194139533462 17592186045585 true] [17592186386612 1081 "{\\int }_{0}^{1}{\\int }_{4-2y}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{2}{\\int }_{(y-1)^{2}+2}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y" 13194139533462 17592186045585 true] [17592186386612 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386612 1084 #uuid "9c2cd832-a593-5944-9882-b3d631c451c5" 13194139533462 17592186045585 true] [17592186386613 1081 "{\\int }_{0}^{1}{\\int }_{(y-1)^{2}+2}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y+{\\int }_{1}^{2}{\\int }_{(y-1)^{2}+2}^{4-y/2}f(x,y)\\,\\text{d}x\\,\\text{d}y" 13194139533462 17592186045585 true] [17592186386613 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386613 1084 #uuid "5274f529-64a1-5518-ae40-8caee629efa0" 13194139533462 17592186045585 true] [17592186386614 1068 #edb/ref 17592186386615 13194139533462 17592186045585 true] [17592186386614 1069 "q-82373" 13194139533462 17592186045585 true] [17592186386614 1070 #edb/ref 17592186045486 13194139533462 17592186045585 true] [17592186386614 1071 "Consider the equation $\\sqrt{3}\\operatorname{tan}⁡(2x-{45}^{∘})-\\sqrt{3}=0$ for ${0}^{∘}\\le x<{360}^{∘}.$ If the exact solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ are written in ascending order, what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533462 17592186045585 true] [17592186386614 1072 #uuid "ca5d3a4d-d32a-5591-b61b-0726227bd885" 13194139533462 17592186045585 true] [17592186386614 1074 "First, we rearrange the equation as follows:\n\n$$\n\\begin{aligned}\\sqrt{3}\\operatorname{tan}⁡(2x-{45}^{∘})-\\sqrt{3} & =0 \\\\ \\sqrt{3}\\operatorname{tan}⁡(2x-{45}^{∘}) & =\\sqrt{3} \\\\ \\operatorname{tan}⁡(2x-{45}^{∘}) & =\\frac{\\sqrt{3}}{\\sqrt{3}} \\\\ \\operatorname{tan}⁡(2x-{45}^{∘}) & =1\\end{aligned}\n$$\n\nWe will find the general solution to the equation, and then generate all of the solutions in the required domain.\n\nThe general solution to our equation is given by\n\n$$\n\\begin{aligned}2x-{45}^{∘} & ={45}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nSolving our equation for $x,$ we get\n\n$$\n\\begin{aligned}2x & ={45}^{∘}+{45}^{∘}+n\\cdot {180}^{∘} \\\\ 2x & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x & ={45}^{∘}+n\\cdot {90}^{∘}.\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain ${0}^{∘}\\le x<{360}^{∘}.$\n\n- Setting $n=0$ gives $x={45}^{∘}$\n\n- Setting $n=1$ gives $x={135}^{∘}$\n\n- Setting $n=2$ gives $x={225}^{∘}$\n\n- Setting $n=3$ gives $x={315}^{∘}$\n\nAll other values of $n$ generate solutions outside the domain ${0}^{∘}\\le x<{360}^{∘}.$ So, the solutions ${x}_{1},{x}_{2},{x}_{3}$ and ${x}_{4}$ (written in ascending order) are\n\n$$\nx={45}^{∘},{135}^{∘},{225}^{∘},{315}^{∘}.\n$$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is $45\\cdot 135=6\\,075.$" 13194139533462 17592186045585 true] [17592186386615 1075 #edb/ref 17592186386616 13194139533462 17592186045585 true] [17592186386615 1075 #edb/ref 17592186386617 13194139533462 17592186045585 true] [17592186386615 1075 #edb/ref 17592186386618 13194139533462 17592186045585 true] [17592186386615 1075 #edb/ref 17592186386619 13194139533462 17592186045585 true] [17592186386615 1075 #edb/ref 17592186386620 13194139533462 17592186045585 true] [17592186386615 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386615 1077 "selection" 13194139533462 17592186045585 true] [17592186386615 1079 #edb/ref 17592186386620 13194139533462 17592186045585 true] [17592186386615 1080 #uuid "5183bc9d-b086-50a7-83db-b220f51dfbe5" 13194139533462 17592186045585 true] [17592186386616 1081 "3\\,265" 13194139533462 17592186045585 true] [17592186386616 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386616 1084 #uuid "c265081a-0295-58cb-bf10-e292b5d2c6ff" 13194139533462 17592186045585 true] [17592186386617 1081 "6\\,750" 13194139533462 17592186045585 true] [17592186386617 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386617 1084 #uuid "ff0e61f2-30b4-54fc-848d-badc863ca908" 13194139533462 17592186045585 true] [17592186386618 1081 "3\\,005" 13194139533462 17592186045585 true] [17592186386618 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386618 1084 #uuid "8acb12b5-85c1-5c52-b26a-