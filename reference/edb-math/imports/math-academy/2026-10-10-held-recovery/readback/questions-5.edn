knowledge-point/title "Inverting a Permutation Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b44952f5-62c3-54e0-971a-c074a603e5e4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186388356} {:answer/id #uuid "76a55830-f573-557a-86b4-f7fd6c91b784" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 & 0 \\\\ 0 & 0 & -1 \\\\ -1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388357} {:answer/id #uuid "75c59d61-cce9-5c55-9a48-18a878b74fbf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & -1 \\\\ -1 & 0 & 0 \\\\ 0 & -1 & 0\\end{aligned}]" :db/id #edb/ref 17592186388358} {:answer/id #uuid "1396f24a-f1a9-5cce-a6d9-1e5353ea4dde" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186388359} {:answer/id #uuid "9db32bd0-c3fb-56b8-bf6e-15f86755369c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388360}] :answer-field/correct {:answer/id #uuid "9db32bd0-c3fb-56b8-bf6e-15f86755369c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388360} :answer-field/id #uuid "27c5440f-07dc-5142-bcfe-40c7293a7902" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40f40cda-7847-5c65-80b1-4137ece3b7f8" :question/math-academy-id "q-135366" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]\n$$" :question/worked-solution "The given matrix can be obtained from the identity matrix by permuting its columns. Therefore, $A$ is a permutation matrix.\n\nThe inverse of a permutation matrix can be found as follows: \n\n$$\n{P}^{-1}={P}^{T}\n$$\n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]}^{T}=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388361 :knowledge-point/_questions [{:knowledge-point/id #uuid "6affd858-749d-5a94-854e-ddadd790ae45" :knowledge-point/title "Inverting a Permutation Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c586833d-f519-5db2-986f-97a6e2667402" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186388363} {:answer/id #uuid "ee43d0e8-4c86-502d-abfd-84b12cc35959" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388364} {:answer/id #uuid "2271aec9-a2b4-5a0a-a941-63ed32717332" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ -1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388365} {:answer/id #uuid "3ebb0741-3775-5ad3-9a33-06de8b3bb023" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186388366} {:answer/id #uuid "14150974-642c-58c2-9a04-41aa467ace14" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388367}] :answer-field/correct {:answer/id #uuid "ee43d0e8-4c86-502d-abfd-84b12cc35959" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388364} :answer-field/id #uuid "d12a4dde-d3e7-5f26-82ea-8ff8d75d25e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388362}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab7ab5ac-cf9c-5408-a789-f3b32435589c" :question/math-academy-id "q-135373" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "The given matrix can be obtained from the identity matrix by permuting its columns. Therefore, $A$ is a permutation matrix.\n\nThe inverse of a permutation matrix can be found as follows: \n\n$$\n{P}^{-1}={P}^{T}\n$$\n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]}^{-1}={[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]}^{T}=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055007 :knowledge-point/_questions [{:knowledge-point/id #uuid "77673d0c-9f03-5915-b2ab-4a5d6cb2d94d" :knowledge-point/title "Inverting a Frobenius Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f767430-2d0c-5029-9e31-1ba719c24d5a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388369} {:answer/id #uuid "a4f895bb-cb16-559b-8ebf-c06f0a503056" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -\\frac{1}{2} & 1 & 0 \\\\ \\frac{1}{4} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388370} {:answer/id #uuid "8b9c7195-0057-5f52-b802-73468ffff46f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388371} {:answer/id #uuid "1308802d-f4ee-5836-8241-c2b84b6f00c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ \\frac{1}{2} & 1 & 0 \\\\ -\\frac{1}{4} & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388372} {:answer/id #uuid "d4c3d1d4-2fa5-5de1-9d28-0433b0304796" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388373}] :answer-field/correct {:answer/id #uuid "2f767430-2d0c-5029-9e31-1ba719c24d5a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388369} :answer-field/id #uuid "e13047b7-1988-5639-bfb8-176b84ec5b9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388368}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b3018840-35c3-52b0-95cf-15fabeb2cbe7" :question/math-academy-id "q-135387" :question/problem "Find the inverse of the following matrix:\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that we're given a Frobenius matrix:\n\n- all entries on the main diagonal are ones\n\n- the matrix has only one column (the $1$st column) where some entries below the main diagonal are not zeros\n\n- all the other entries outside the main diagonal are zeros\n\nTo find the inverse of a Frobenius matrix, we simply take the non-zero entries outside the main diagonal with opposite signs. \n\nIn our case, we obtain\n\n$$\n\\begin{aligned}{A}^{-1}={[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}1 & 0 & 0 \\\\ -2 & 1 & 0 \\\\ 4 & 0 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 175921863