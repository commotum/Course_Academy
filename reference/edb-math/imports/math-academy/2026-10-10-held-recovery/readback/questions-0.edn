#{[{:db/id #edb/ref 17592186385978 :knowledge-point/_questions [{:knowledge-point/id #uuid "1916efa2-6a98-59a5-858c-c4fe64d8e8bc" :knowledge-point/title "Calculating the Magnitude of a Vector Given the Coordinates of its Endpoints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b601022-bed0-54ac-a0ea-07f24a77faf4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\frac{2}{3\\sqrt{2}},-\\frac{4}{3\\sqrt{2}}⟩" :db/id #edb/ref 17592186385980} {:answer/id #uuid "546cddcd-703a-51e2-ae7c-710a0e005f8c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-\\frac{1}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}⟩" :db/id #edb/ref 17592186385981} {:answer/id #uuid "801c33bb-cdfd-5340-b425-5170e77c620b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}}⟩" :db/id #edb/ref 17592186385982} {:answer/id #uuid "6a51dd52-35ba-5dd1-aa4e-4c8716b383fb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-\\frac{1}{\\sqrt{3}},-\\frac{2}{\\sqrt{3}}⟩" :db/id #edb/ref 17592186385983} {:answer/id #uuid "b548fb08-e66f-596b-942e-9c42b4f54409" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\frac{2}{\\sqrt{5}},\\frac{4}{\\sqrt{5}}⟩" :db/id #edb/ref 17592186385984}] :answer-field/correct {:answer/id #uuid "801c33bb-cdfd-5340-b425-5170e77c620b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}}⟩" :db/id #edb/ref 17592186385982} :answer-field/id #uuid "1cb9bc3b-ff9a-5d0a-9466-e15a7ff5d1cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385979}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ed7c86d6-fb53-53c2-abe3-3eb800a8608d" :question/math-academy-id "q-101022" :question/problem "Let $A(2,7,0)$ and $B(2,5,4).$ Find a unit vector that is parallel to $\\overset{\\to }{AB}.$" :question/worked-solution "First, we have \n\n$$\n\\begin{aligned} & \\overset{\\to }{OA}=a=2i+7j, \\\\  & \\overset{\\to }{OB}=b=2i+5j+4k.\\end{aligned}\n$$\n\nExpressing $\\overset{\\to }{AB}$ as the difference of position vectors, we obtain:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =\\overset{\\to }{OB}-\\overset{\\to }{OA} \\\\  & =b-a \\\\  & =2i+5j+4k-(2i+7j) \\\\  & =-2j+4k \\\\  & =⟨0,-2,4⟩\\end{aligned}\n$$\n\nNow, remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\nu=\\frac{\\overset{\\to }{AB}}{|\\,\\overset{\\to }{AB}\\,|}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,\\overset{\\to }{AB}\\,| & =\\sqrt{{0}^{2}+(-2)^{2}+{4}^{2}} \\\\  & =\\sqrt{0+4+16} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$\n\nFinally, we divide $\\overset{\\to }{AB}$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{\\overset{\\to }{AB}}{|\\,\\overset{\\to }{AB}\\,|} \\\\  & =\\frac{1}{2\\sqrt{5}}\\overset{\\to }{AB} \\\\  & =\\frac{1}{2\\sqrt{5}}\\cdot ⟨0,-2,4⟩ \\\\  & =⟨0,-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385985 :knowledge-point/_questions [{:knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3" :knowledge-point/title "Multiplying 2x2 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bf3e44c-7abd-51d5-8adc-273c85ba9203" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 & -29 \\\\ 2 & -15\\end{aligned}]" :db/id #edb/ref 17592186385987} {:answer/id #uuid "82ade07d-3745-5ad5-ab85-3b0ab4fc0190" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & -30 \\\\ 2 & -15\\end{aligned}]" :db/id #edb/ref 17592186385988} {:answer/id #uuid "356853b7-b317-5f55-8a16-e1c32baf2929" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 & -30 \\\\ -14 & 15\\end{aligned}]" :db/id #edb/ref 17592186385989} {:answer/id #uuid "20bbd810-d067-5aad-b023-f7e4d96e2280" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & -30 \\\\ -14 & -15\\end{aligned}]" :db/id #edb/ref 17592186385990} {:answer/id #uuid "f0115b46-642c-56c4-bdce-687e5f294ac8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 & -30 \\\\ 2 & 15\\end{aligned}]" :db/id #edb/ref 17592186385991}] :answer-field/correct {:answer/id #uuid "f0115b46-642c-56c4-bdce-687e5f294ac8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}13 & -30 \\\\ 2 & 15\\end{aligned}]" :db/id #edb/ref 17592186385991} :answer-field/id #uuid "ef0c715e-938f-553a-a102-50abcd5037f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385986}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f835056-4322-50c4-bab8-f063cd1f2c25" :question/math-academy-id "q-1018" :question/problem "$[\\begin{aligned}1 & 6 \\\\ 8 & -3\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 2 & -5\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 6 \\\\ 8 & -3\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 2 & -5\\end{aligned}] & =[\\begin{aligned}1\\cdot 1+6\\cdot 2 & 1\\cdot 0+6\\cdot (-5) \\\\ 8\\cdot 1+(-3)\\cdot 2 & 8\\cdot 0+(-3)\\cdot (-5)\\end{aligned}] \\\\  & =[\\begin{aligned}1+12 & 0+(-30) \\\\ 8+(-6) & 0+15\\end{aligned}] \\\\  & =[\\begin{aligned}13 & -30 \\\\ 2 & 15\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385992 :knowledge-point/_questions [{:knowledge-point/id #uuid "5dbfd5f3-553b-5276-8716-bbceddefc4d3" :knowledge-point/title "Multiplying 2x2 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b32d627c-5798-5ce4-aa1d-bdc30223b3c5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}19 & 12 \\\\ -20 & -6\\end{aligned}]" :db/id #edb/ref 17592186385994} {:answer/id #uuid "717307bb-59fe-545e-9a91-23b750fb8131" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 12 \\\\ 20 & -6\\end{aligned}]" :db/id #edb/ref 17592186385995} {:answer/id #uuid "380fb730-0393-5e52-995e-a464ffd3e725" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 19 \\\\ -20 & -6\\end{aligned}]" :db/id #edb/ref 17592186385996} {:answer/id #uuid "0adfadd9-3940-51df-8128-22b3445dc8a0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}]" :db/id #edb/ref 17592186385997} {:answer/id #uuid "e106e878-96ca-5444-8390-bf35e4e26521" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 12 \\\\ -20 & -26\\end{aligned}]" :db/id #edb/ref 17592186385998}] :answer-field/correct {:answer/id #uuid "0adfadd9-3940-51df-8128-22b3445dc8a0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}]" :db/id #edb/ref 17592186385997} :answer-field/id #uuid "4bda1424-1378-58a0-b4aa-ac92c9249124" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385993}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14ad891b-2f9b-55f0-9bac-80073c489918" :question/math-academy-id "q-1021" :question/problem "$[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] & =[\\begin{aligned}7\\cdot 1+12\\cdot 0 & 7\\cdot 0+12\\cdot 1 \\\\ -20\\cdot 1+(-6)\\cdot 0 & -20\\cdot 0+(-6)\\cdot 1\\end{aligned}] \\\\  & =[\\begin{aligned}7+0 & 0+12 \\\\ -20+0 & 0+(-6)\\end{aligned}] \\\\  & =[\\begin{aligned}7 & 12 \\\\ -20 & -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385999 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb1cb64-749e-5c74-b9e2-dfca460cca49" :answer/type {:db/ident :answer.type/image} :answer/value "images/f8/f86ae3c5bc792bee8d0e798c0af7e81b24f156572c02b10773e19258e9913134.png" :db/id #edb/ref 17592186386001} {:answer/id #uuid "21c8aa15-2561-538b-adce-0e02db4b4536" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b6ebfd08f792396eaa6d1018690b7685616c26ec8ca2824f754da7ca19069108.png" :db/id #edb/ref 17592186386002} {:answer/id #uuid "5e7c36df-a012-5449-8268-78c1a6036563" :answer/type {:db/ident :answer.type/image} :answer/value "images/12/120c8bbf904e4df194f0c4e614d5a1090ba0121ee7718571683c0c9ac9bb6b15.png" :db/id #edb/ref 17592186386003} {:answer/id #uuid "679a6329-c800-5602-9eac-fcd84ed71642" :answer/type {:db/ident :answer.type/image} :answer/value "images/f3/f3d5c539ab5ce8d1820dc8627ddd981e6871ded73f10648bf02f8a03c3eb5185.png" :db/id #edb/ref 17592186386004} {:answer/id #uuid "affc140a-fce6-5c87-ae9e-69c582e2cba8" :answer/type {:db/ident :answer.type/image} :answer/value "images/75/7547d4fa001c7bd0db9e6cd7751ba0da3cd4b65ef2fa4af6ea3c3fb80da55d8c.png" :db/id #edb/ref 17592186386005}] :answer-field/correct {:answer/id #uuid "affc140a-fce6-5c87-ae9e-69c582e2cba8" :answer/type {:db/ident :answer.type/image} :answer/value "images/75/7547d4fa001c7bd0db9e6cd7751ba0da3cd4b65ef2fa4af6ea3c3fb80da55d8c.png" :db/id #edb/ref 17592186386005} :answer-field/id #uuid "fed8e35e-747c-5bcf-bd41-34f49d6c1998" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d786a9f1-6d9d-573d-9964-69c5e58662eb" :question/math-academy-id "q-102107" :question/problem "Which of the following number lines gives the solution to $-9<6-5x<1?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual. \n\nFirst, we apply the addition principle:\n\n$$\n\\begin{aligned}-9 & <6-5x<1 \\\\ -9-6 & <6-5x-6<1-6 \\\\ -15 & <-5x<-5\\end{aligned}\n$$\n\nThen, we divide by $-5.$ Note that since we are dividing by a negative number, we need to flip the inequality signs. \n\n$$\n\\begin{aligned}-15 & <-5x<-5 \\\\ \\frac{-15}{-5} & >\\frac{-5x}{-5}>\\frac{-5}{-5} \\\\ 3 & >x>1\\end{aligned}\n$$\n\nThe solution can be written as $3>x>1$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n1<x<3\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](images/75/7547d4fa001c7bd0db9e6cd7751ba0da3cd4b65ef2fa4af6ea3c3fb80da55d8c.png)"}] [{:db/id #edb/ref 17592186386006 :knowledge-point/_questions [{:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f" :knowledge-point/title "Calculating the Components of a Vector With Respect to a Given Orthonormal Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79734ad1-3964-5f5e-9278-275bd9033da0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ \\frac{2}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186386008} {:answer/id #uuid "ac89f61f-800f-5761-b7e6-5031550febb2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{6}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186386009} {:answer/id #uuid "2e4613e8-6af0-5396-abab-11c25aa4f010" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{2}{\\sqrt{2}} \\\\ \\frac{2}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186386010} {:answer/id #uuid "c4482992-608d-5931-8a49-e73ef737ee25" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186386011} {:answer/id #uuid "1e2076d2-dca0-5956-b3ba-ca1c44c69dcf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{4}{\\sqrt{2}} \\\\ -\\frac{2}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186386012}] :answer-field/correct {:answer/id #uuid "c4482992-608d-5931-8a49-e73ef737ee25" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186386011} :answer-field/id #uuid "f4bec8a8-7bc7-5d93-87c4-53f78de8a9e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1c635af5-ba45-5ad9-a96d-e17304471ae7" :question/math-academy-id "q-102320" :question/problem "Given the **orthonormal** basis $B={[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}4 \\\\ 2\\end{aligned}].$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}4 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{4}{\\sqrt{2}}-\\frac{2}{\\sqrt{2}}=\\frac{2}{\\sqrt{2}} \\\\ {x}_{2} & =[\\begin{aligned}4 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{4}{\\sqrt{2}}+\\frac{2}{\\sqrt{2}}=\\frac{6}{\\sqrt{2}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=[\\begin{aligned}\\frac{2}{\\sqrt{2}} \\\\ \\frac{6}{\\sqrt{2}}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386013 :knowledge-point/_questions [{:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0" :knowledge-point/title "Solving an Initial Value Problem Involving a Cauchy-Euler Equation with a Repeated Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "380571d6-ad52-5c32-9ec7-dfff8cf3080b" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{1-6\\operatorname{ln}⁡x}{{x}^{7}}" :db/id #edb/ref 17592186386015} {:answer/id #uuid "e21e0f1d-fc76-5b8e-802f-cf0520147a52" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2-8\\operatorname{ln}⁡x}{{x}^{7}}" :db/id #edb/ref 17592186386016} {:answer/id #uuid "e2253b63-3223-5268-8ccd-867c548e6701" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2-12\\operatorname{ln}⁡x}{{x}^{7}}" :db/id #edb/ref 17592186386017} {:answer/id #uuid "22fc0b9a-6729-55c7-8806-3db09893929a" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{1+8\\operatorname{ln}⁡x}{{x}^{7}}" :db/id #edb/ref 17592186386018} {:answer/id #uuid "7870f20c-2346-588a-b19f-7f5eb3e72c57" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{1+6\\operatorname{ln}⁡x}{{x}^{7}}" :db/id #edb/ref 17592186386019}] :answer-field/correct {:answer/id #uuid "22fc0b9a-6729-55c7-8806-3db09893929a" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{1+8\\operatorname{ln}⁡x}{{x}^{7}}" :db/id #edb/ref 17592186386018} :answer-field/id #uuid "46f0be38-8313-521b-b53a-affa294b3539" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2f1e33b-97ff-5879-aa46-ccc76aa7159d" :question/math-academy-id "q-102365" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}+15x{y}^{′}+49y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{-7}+{c}_{2}{x}^{-7}\\operatorname{ln}⁡x,\n$$\n\nsolve the initial value problem\n\n$$\n{x}^{2}{y}^{″}+15x{y}^{′}+49y=0,\\,y(1)=1,\\,{y}^{′}(1)=1,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=1.$ Substituting $y(1)=1$ into the general solution gives\n\n$$\n1={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=1.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =-7{c}_{1}{x}^{-8}+{c}_{2}{x}^{-8}-7{c}_{2}{x}^{-8}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=1$ and ${c}_{1}=1$ into the above gives\n\n$$\n\\begin{aligned}1 & =-7(1)+{c}_{2} \\\\ {c}_{2} & =8.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(x) & ={x}^{-7}+8{x}^{-7}\\operatorname{ln}⁡x \\\\  & =\\frac{1+8\\operatorname{ln}⁡x}{{x}^{7}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386020 :knowledge-point/_questions [{:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2" :knowledge-point/title "Applying Row Operations To a Coefficients Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d6b6ba-73af-5b0e-aadb-df2b92946446" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 1 & 5 & 10\\end{aligned}]" :db/id #edb/ref 17592186386022} {:answer/id #uuid "fd96430f-7419-56b6-99da-8a526bba22e3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 21 & 27 \\\\ 0 & 5 & 10\\end{aligned}]" :db/id #edb/ref 17592186386023} {:answer/id #uuid "83bf736c-a7af-587e-9671-a0755c99d45c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{aligned}]" :db/id #edb/ref 17592186386024} {:answer/id #uuid "be7cd770-89d2-5f9f-b60e-e8df5d9ff51c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & -5 & 10\\end{aligned}]" :db/id #edb/ref 17592186386025} {:answer/id #uuid "f19e8491-c92c-5661-8c92-a31904c65e32" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 25 \\\\ 0 & 5 & 10\\end{aligned}]" :db/id #edb/ref 17592186386026}] :answer-field/correct {:answer/id #uuid "83bf736c-a7af-587e-9671-a0755c99d45c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{aligned}]" :db/id #edb/ref 17592186386024} :answer-field/id #uuid "5f488fbc-4f0a-58a9-aca2-89c02a7e41b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386021}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d89fad28-1b46-55f3-b90e-6ed4c3f194da" :question/math-academy-id "q-10245" :question/problem "Consider the matrix $B,$ given by\n\n$$\nB=[\\begin{aligned}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $B?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+4{R}_{1} \\\\ {R}_{3} & :={R}_{3}+{R}_{1}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+4{R}_{1}$ means that we need to add $4$ times the first row to the second row.\n\n- The operation ${R}_{3}:={R}_{3}+{R}_{1}$ means that we need to add $1$ times the first row to the third row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}B & =[\\begin{aligned}1 & 3 & 6 \\\\ -4 & 12 & 3 \\\\ -1 & 2 & 4\\end{aligned}]\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ -4+(4)(1) & 12+(4)(3) & 3+(4)(6) \\\\ -1 & 2 & 4\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1 & 2 & 4\\end{aligned}]\\,{R}_{3}:={R}_{3}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ -1+1 & 2+3 & 4+6\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 6 \\\\ 0 & 24 & 27 \\\\ 0 & 5 & 10\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059967 :knowledge-point/_questions [{:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2" :knowledge-point/title "Applying Row Operations To a Coefficients Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e95e2e5-f4c7-556f-9d3b-6806aa203aac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{aligned}]" :db/id #edb/ref 17592186386028} {:answer/id #uuid "93d2127b-e5d6-5f6a-b77b-e49e6b3917a4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{aligned}]" :db/id #edb/ref 17592186386029} {:answer/id #uuid "dfcd1624-4c95-5d1d-b7c3-eadfb5affb1a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 1 & -9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186386030} {:answer/id #uuid "84d65aa0-7f3f-56d8-8813-60439890bf5a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & -1 & 9\\end{aligned}]" :db/id #edb/ref 17592186386031} {:answer/id #uuid "f47ccd2f-8569-5e0e-ae2f-f78a4ee09a4d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -1 & 9 \\\\ 8 & 3 & 1 \\\\ -1 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186386032}] :answer-field/correct {:answer/id #uuid "3e95e2e5-f4c7-556f-9d3b-6806aa203aac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{aligned}]" :db/id #edb/ref 17592186386028} :answer-field/id #uuid "6265e561-15e0-5e23-846a-8eab1f2ab8dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386027}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73199f2e-4821-5c88-b3d1-fc53d8677008" :question/math-academy-id "q-10248" :question/problem "Consider the matrix $M,$ given by\n\n$$\nM=[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:={R}_{3}+3{R}_{1}$ on $M?$" :question/worked-solution "The operation ${R}_{3}:={R}_{3}+3{R}_{1}$ means that we need to add $3$ times the first row to the third row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 3 & -1 & 9\\end{aligned}]\\,{R}_{3}:={R}_{3}+3\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & -4 \\\\ 8 & 3 & 1 \\\\ 3+(3)(-1) & -1+(3)(2) & 9+(3)(4)\\end{aligned}] \\\\  & ∼[\\begin{aligned}-1 & 2 & 4 \\\\ 8 & 3 & 1 \\\\ 0 & 5 & 21\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186237924 :knowledge-point/_questions [{:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a" :knowledge-point/title "Finding the Cartesian Equation of a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77633f7b-a4f6-5605-b197-300dedbccde8" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x(x+5)(2x+1)" :db/id #edb/ref 17592186236573} {:answer/id #uuid "7b957847-885e-58d3-87c4-376c6913a3f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(2x+1)^{3}" :db/id #edb/ref 17592186236593} {:answer/id #uuid "878bf002-299b-523a-93bd-80e7642d9000" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x(2x+1)(2x-5)" :db/id #edb/ref 17592186236669} {:answer/id #uuid "8b44f564-28f4-5786-9cf7-4b0382705e60" :answer/type {:db/ident :answer.type/math} :answer/value "y=(2x+1)^{3}" :db/id #edb/ref 17592186236696} {:answer/id #uuid "abe07822-f677-59f4-b923-e8aa2238417d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x(x-5)(2x+1)" :db/id #edb/ref 17592186236910}] :answer-field/correct {:answer/id #uuid "77633f7b-a4f6-5605-b197-300dedbccde8" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x(x+5)(2x+1)" :db/id #edb/ref 17592186236573} :answer-field/id #uuid "b2e38393-de71-5a6b-b9b5-971eae7190b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44f36d19-593e-54ad-8307-e8844e507156" :question/math-academy-id "q-102668" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{t-5}{2},\\,\\,\\,y=({t}^{2}-25)(t-4),\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{t-5}{2}\\,⇒\\,t=2x+5\\end{aligned}\n$$\n\nNow, substituting $t=2x+5$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((2x+5)^{2}-25)(2x+5-4) \\\\  & =(4{x}^{2}+20x+25-25)(2x+1) \\\\  & =(4{x}^{2}+20x)(2x+1) \\\\  & =4x(x+5)(2x+1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=4x(x+5)(2x+1).$"}] [{:db/id #edb/ref 17592186386033 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c69c8d69-0439-5d5a-a957-1dfdd9f0cfca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\,\\text{m/s}" :db/id #edb/ref 17592186386035} {:answer/id #uuid "0aecb925-4a96-5e0c-a775-0b9d74d29747" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,\\text{m/s}" :db/id #edb/ref 17592186386036} {:answer/id #uuid "3d0811b9-7498-5416-8a40-b868c470d9ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{3}\\,\\text{m/s}" :db/id #edb/ref 17592186386037} {:answer/id #uuid "c673f8e3-e0eb-5489-a602-8a03f381e8ce" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\text{m/s}" :db/id #edb/ref 17592186386038} {:answer/id #uuid "a7e5bacd-99ca-5a49-bcab-2b2b24d129d5" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{m/s}" :db/id #edb/ref 17592186386039}] :answer-field/correct {:answer/id #uuid "0aecb925-4a96-5e0c-a775-0b9d74d29747" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,\\text{m/s}" :db/id #edb/ref 17592186386036} :answer-field/id #uuid "b25f167c-c01b-520b-a4d8-ffd21238416b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386034}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b207322-8b81-50ed-8b36-b439725ea8bf" :question/math-academy-id "q-102695" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=2t+{t}^{2}$, where $t$ is the time in seconds. If the particle has velocity $v=\\frac{8}{3}\\,\\text{m}/\\text{s}$ when $t=1\\,\\text{s}$, calculate the velocity of the particle at the moment $t=2\\,\\text{s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (2t+{t}^{2})\\text{d}t \\\\  & ={t}^{2}+\\frac{{t}^{3}}{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=\\frac{8}{3}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{8}{3} & =(1)^{2}+\\frac{(1)^{3}}{3}+C \\\\ \\frac{8}{3} & =1+\\frac{1}{3}+C \\\\ C & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=\\frac{4}{3}+{t}^{2}+\\frac{{t}^{3}}{3}.$\n\nWe evaluate the velocity at time $t=2\\,\\text{s}$:\n\n$$\n\\begin{aligned}v(2) & =\\frac{4}{3}+(2)^{2}+\\frac{(2)^{3}}{3} \\\\  & =\\frac{4}{3}+4+\\frac{8}{3} \\\\  & =8\\,\\text{m/s}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386040 :knowledge-point/_questions [{:knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df3bb962-f2d1-5ee7-a113-b857fba5cef8" :answer/type {:db/ident :answer.type/math} :answer/value "X⇒Y" :db/id #edb/ref 17592186386042} {:answer/id #uuid "73685603-fc45-5a7b-ae0b-f79c6a725ab6" :answer/type {:db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186386043} {:answer/id #uuid "025fb47c-d3b8-5b43-bbc9-da0a019c987e" :answer/type {:db/ident :answer.type/math} :answer/value "X∧Y" :db/id #edb/ref 17592186386044} {:answer/id #uuid "20639ad4-5e0d-5759-9f30-7c348980aae9" :answer/type {:db/ident :answer.type/math} :answer/value "¬X∨Y" :db/id #edb/ref 17592186386045} {:answer/id #uuid "5d445084-5adf-5e8c-ba3f-39f72da70cd1" :answer/type {:db/ident :answer.type/math} :answer/value "Y" :db/id #edb/ref 17592186386046}] :answer-field/correct {:answer/id #uuid "73685603-fc45-5a7b-ae0b-f79c6a725ab6" :answer/type {:db/ident :answer.type/math} :answer/value "X∨Y" :db/id #edb/ref 17592186386043} :answer-field/id #uuid "30b8ea65-fa59-5640-ad1e-d38a5f9bd046" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386041}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ca2063fd-762f-571b-86ef-906797fcc58c" :question/math-academy-id "q-102730" :question/problem "Simplify the statement $¬(X∨Y)⇒Y.$" :question/worked-solution "First, note that\n\n$$\n¬(X∨Y)⇒Y≡¬(¬(X∨Y))∨Y.\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬(X∨Y))∨Y≡(X∨Y)∨Y.\n$$\n\nFinally, by the associative and idempotent law, we have\n\n$$\n(X∨Y)∨Y≡X∨Y.\n$$\n\nSo the given statement is equivalent to $X∨Y.$"}] [{:db/id #edb/ref 17592186386047 :knowledge-point/_questions [{:knowledge-point/id #uuid "eec6cf11-74cc-5b3a-b2fe-bd4285fe4a88" :knowledge-point/title "Rewriting Conditional Statement Using the Associative, Commutative, and Absorption Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "598a18e6-a7e1-5198-85c8-cd85ff5e8356" :answer/type {:db/ident :answer.type/math} :answer/value "Q" :db/id #edb/ref 17592186386049} {:answer/id #uuid "911f6309-746b-5ff8-84bb-2e4ba995dfe5" :answer/type {:db/ident :answer.type/math} :answer/value "P" :db/id #edb/ref 17592186386050} {:answer/id #uuid "363eeec8-972d-506f-9054-9bb9d2d6a13d" :answer/type {:db/ident :answer.type/math} :answer/value "¬P∨Q" :db/id #edb/ref 17592186386051} {:answer/id #uuid "abda69df-8ef3-5465-b050-742379020027" :answer/type {:db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186386052} {:answer/id #uuid "de236ff7-8d36-54e6-bce4-c965e0d96754" :answer/type {:db/ident :answer.type/math} :answer/value "P∨¬Q" :db/id #edb/ref 17592186386053}] :answer-field/correct {:answer/id #uuid "911f6309-746b-5ff8-84bb-2e4ba995dfe5" :answer/type {:db/ident :answer.type/math} :answer/value "P" :db/id #edb/ref 17592186386050} :answer-field/id #uuid "7e8c4ca2-b4ee-5544-b0ba-f01f0093c925" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386048}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a2aac01-1463-56cc-bce5-1c99c13e924c" :question/math-academy-id "q-102736" :question/problem "Simplify the statement $¬P⇒(P∧Q).$" :question/worked-solution "First, note that\n\n$$\n¬P⇒(P∧Q)≡¬(¬P)∨(P∧Q).\n$$\n\nCanceling out double negations, we reach\n\n$$\n¬(¬P)∨(P∧Q)≡P∨(P∧Q).\n$$\n\nFinally, by the absorption law, we have\n\n$$\nP∨(P∧Q)≡P.\n$$\n\nSo the given statement is equivalent to $P.$"}] [{:db/id #edb/ref 17592186386054 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc295251-8992-58af-99ad-555c55679954" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{6}[\\begin{aligned}2 & 3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386056} {:answer/id #uuid "fa3e33dc-c2fa-5ce8-a74b-cafe4387cbba" :answer/type {:db/ident :answer.type/math} :answer/value "x=2[\\begin{aligned}1 & -3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386057} {:answer/id #uuid "afb508cc-f7c7-553c-b844-811d03f18621" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}-2 & -3 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386058} {:answer/id #uuid "38618689-5610-50ab-b2fe-e981dfe08e67" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386059} {:answer/id #uuid "e35c6576-aa93-5aa2-bc00-3b5fc1b8c2d3" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386060}] :answer-field/correct {:answer/id #uuid "38618689-5610-50ab-b2fe-e981dfe08e67" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386059} :answer-field/id #uuid "a482c228-62c7-528d-a980-052fac0d225f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386055}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f36e193-cfb7-556d-862d-7ca0f147ebca" :question/math-academy-id "q-102799" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}3y=-x \\\\ 2y=1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}x+3y=0 \\\\ 2y=1.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 2-0\\cdot 3}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176185 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eb6340b-14ef-52dd-8c81-f42abe1f7db3" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186173339} {:answer/id #uuid "d70c7e60-9413-5397-ad7d-cc813be7a7de" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186173340} {:answer/id #uuid "d8172f30-0032-57c6-b711-70b10ccc26d3" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186173341} {:answer/id #uuid "e5ab7837-d47d-5cb0-bc14-595dc1cfabaa" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186173342} {:answer/id #uuid "4779d64a-2cc5-54b4-8a38-4f3be274cddc" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186173343}] :answer-field/id #uuid "60c6ad40-5828-5d36-97ba-df0f631c5a76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173338}] :question/id #uuid "d5012f64-5f75-5c60-9687-8fa0fb8ccd67" :question/math-academy-id "q-102908" :question/problem "What surface is defined by the equation $r = 3$ in cylindrical polar coordinates?"}] [{:db/id #edb/ref 17592186386061 :knowledge-point/_questions [{:knowledge-point/id #uuid "50c01507-99a7-5328-8d74-c9e9bda51330" :knowledge-point/title "Calculating the Inverse of a 3x3 Matrix Using the Matrix of Cofactors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e5a90ce-5f43-5f35-b7b8-583244a42439" :answer/type {:db/ident :answer.type/math} :answer/value "4[\\begin{aligned}-3 & 1 & 2 \\\\ 1 & -1 & 1 \\\\ 1 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386063} {:answer/id #uuid "8602540d-4801-5042-9916-98e607f58c64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}-2 & 1 & 3 \\\\ 2 & -3 & -1 \\\\ 2 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386064} {:answer/id #uuid "c57393fc-dedc-5a9b-9994-032d00d28eef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}-2 & 1 & 2 \\\\ 1 & -1 & 1 \\\\ 2 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386065} {:answer/id #uuid "8bc9fb87-d9dc-5a6b-ab93-485448959e7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386066} {:answer/id #uuid "66812ddb-563d-5415-bd8f-27772bb7e151" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}1 & 0 & 2 \\\\ 1 & -1 & 1 \\\\ 2 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386067}] :answer-field/correct {:answer/id #uuid "8bc9fb87-d9dc-5a6b-ab93-485448959e7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}[\\begin{aligned}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386066} :answer-field/id #uuid "e416161a-9bd1-5b5b-810d-ebf9a09026af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386062}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "852dcdfe-ad8b-55fc-ab02-b3cb773c55c0" :question/math-academy-id "q-103533" :question/problem "Find the inverse of the matrix $A=[\\begin{aligned}1 & 0 & 2 \\\\ 1 & -1 & 1 \\\\ 2 & 1 & 1\\end{aligned}]$\ngiven that $det(A)=4.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=4\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 1 \\\\ 2 & 1\\end{aligned}| & |\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}| \\\\ |\\begin{aligned}0 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 2 & 1\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}| \\\\ |\\begin{aligned}0 & 2 \\\\ -1 & 1\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -1 & 3 \\\\ -2 & -3 & 1 \\\\ 2 & -1 & -1\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=[\\begin{aligned}-2 & 1 & 3 \\\\ 2 & -3 & -1 \\\\ 2 & 1 & -1\\end{aligned}].\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=[\\begin{aligned}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{aligned}].\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{4}[\\begin{aligned}-2 & 2 & 2 \\\\ 1 & -3 & 1 \\\\ 3 & -1 & -1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386068 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a8be4bb-bbfe-5a5d-872c-91b4d67edc2f" :knowledge-point/title "Applications of Accumulation Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1b44937-3524-51f6-b54f-cb72b7faa593" :answer/type {:db/ident :answer.type/math} :answer/value "73\\,225" :db/id #edb/ref 17592186386070} {:answer/id #uuid "27a3c6a8-8fe3-5d1d-9431-72eb62f7e94d" :answer/type {:db/ident :answer.type/math} :answer/value "69\\,270" :db/id #edb/ref 17592186386071} {:answer/id #uuid "73249a96-619c-5011-899b-b8a21371af1a" :answer/type {:db/ident :answer.type/math} :answer/value "89\\,850" :db/id #edb/ref 17592186386072} {:answer/id #uuid "e2779f22-c993-5b31-99da-5e3a9b978e2e" :answer/type {:db/ident :answer.type/math} :answer/value "78\\,250" :db/id #edb/ref 17592186386073} {:answer/id #uuid "c893e5ed-8ab0-5582-af5e-98445a500b48" :answer/type {:db/ident :answer.type/math} :answer/value "83\\,350" :db/id #edb/ref 17592186386074}] :answer-field/correct {:answer/id #uuid "c893e5ed-8ab0-5582-af5e-98445a500b48" :answer/type {:db/ident :answer.type/math} :answer/value "83\\,350" :db/id #edb/ref 17592186386074} :answer-field/id #uuid "8f0e1e01-fa6f-5497-84cb-d8e451a632af" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386069}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8de63944-9034-5911-a181-23fee9b4f403" :question/math-academy-id "q-103776" :question/problem "The bacteria culture in a lab increases at a rate of ${e}^{2t}$ per hour. If, after $2$ hours, there are $2\\,000$ bacteria in the population, approximately how many bacteria are in the population after $6$ hours?" :question/worked-solution "Let $s(t)={e}^{2t}$ be the rate at which the number of bacteria is changing and let $S(T)$ be the total number of bacteria and in the population after $T$ hours.\n\nUsing our formula for the accumulation of change, we have\n\n$$\nS(T)=S(2)+{\\int }_{2}^{T}s(t)\\,\\text{d}t.\n$$\n\nSubstituting the known information and carrying out the necessary integration gives\n\n$$\n\\begin{aligned}S(T) & =S(2)+{\\int }_{2}^{T}s(t)\\,\\text{d}t \\\\  & =2\\,000+{\\int }_{2}^{T}{e}^{2t}\\,\\text{d}t \\\\  & =2\\,000+\\frac{1}{2}{e}^{2t}{|}_{2}^{T} \\\\  & =2\\,000+\\frac{1}{2}{e}^{2T}-\\frac{1}{2}{e}^{2\\cdot 2} \\\\  & =2\\,000+\\frac{1}{2}{e}^{2T}-\\frac{1}{2}{e}^{4}.\\end{aligned}\n$$\n\nFinally, to find the number of bacteria in the culture after $T=6$ hours, we substitute in the above:\n\n$$\nS(6)=2\\,000+\\frac{1}{2}{e}^{2\\cdot 6}-\\frac{1}{2}{e}^{4}=2\\,000+\\frac{1}{2}{e}^{12}-\\frac{1}{2}{e}^{4}≈83\\,350.\n$$"}] [{:db/id #edb/ref 17592186386075 :knowledge-point/_questions [{:knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb0ffe3c-9e81-5e70-aa4f-ff33f65dd6ae" :answer/type {:db/ident :answer.type/image} :answer/value "images/ca/caa67175ab6237629bfb168e98f4399103e03ce603004aed8f23d2d14b01d7a8.png" :db/id #edb/ref 17592186386077} {:answer/id #uuid "90c1ccbb-6009-55a2-a3b8-59131553a690" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3e494ced6afa7e2c2601ef76c21da08480227d9cbc6305838c004edcc56e431c.png" :db/id #edb/ref 17592186386078} {:answer/id #uuid "70af6131-cf94-5394-958e-0d30e4708cb7" :answer/type {:db/ident :answer.type/image} :answer/value "images/69/69ad36f502222c0dbed981658b601816ddf40449021a06cb84d03eba82ccf864.png" :db/id #edb/ref 17592186386079} {:answer/id #uuid "07988f29-81ee-5eb5-b00a-b14fd159131a" :answer/type {:db/ident :answer.type/image} :answer/value "images/21/21e0c66adc999bb5c3837b1d3754695bc77cd00ba48b951f5020a7a43517cac4.png" :db/id #edb/ref 17592186386080} {:answer/id #uuid "11b5dd6d-87cf-51e2-bd14-d62067d5e0f0" :answer/type {:db/ident :answer.type/image} :answer/value "images/88/88b379da88c9c00be0aa64557dfdccef6bd503a894d56f5a89a13b081db2ab14.png" :db/id #edb/ref 17592186386081}] :answer-field/correct {:answer/id #uuid "eb0ffe3c-9e81-5e70-aa4f-ff33f65dd6ae" :answer/type {:db/ident :answer.type/image} :answer/value "images/ca/caa67175ab6237629bfb168e98f4399103e03ce603004aed8f23d2d14b01d7a8.png" :db/id #edb/ref 17592186386077} :answer-field/id #uuid "15e2b32d-9412-5ac7-b376-0999751b01d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386076}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcbb935c-0e69-53bf-8029-fbd172319da8" :question/math-academy-id "q-104036" :question/problem "Select the function that has a discontinuity at $x=-2.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a jump exactly at $x=-2$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\n![](images/05/05ad378968e143e83dab8d50608e6db7ccaf97f5e1a8f2ee83d2f893e3d820c3.png)\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186167055 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd281121-21d3-5dc4-8537-af248d0fdf46" :knowledge-point/title "Identifying the Vector Field Corresponding to a Given Potential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad573080-12c0-5795-bd57-186bf4ef86e9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}{e}^{xy}\\,i+(xy+1){e}^{xy}\\,j" :db/id #edb/ref 17592186386083} {:answer/id #uuid "6637e684-fc51-5e28-9ef7-e989f843fa89" :answer/type {:db/ident :answer.type/math} :answer/value "xy{e}^{xy}\\,i+(x+1){e}^{xy}\\,j" :db/id #edb/ref 17592186386084} {:answer/id #uuid "bde9cf33-16b6-581e-a442-aa5532c2cea3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}{e}^{xy}\\,i+{x}^{2}{e}^{xy}\\,j" :db/id #edb/ref 17592186386085} {:answer/id #uuid "c7adf677-b962-5e7e-8a2d-2c8fa74b77c1" :answer/type {:db/ident :answer.type/math} :answer/value "(y+1){e}^{xy}\\,i+x{e}^{xy}\\,j" :db/id #edb/ref 17592186386086} {:answer/id #uuid "8933c795-8d32-5777-bb3b-9769cea078c0" :answer/type {:db/ident :answer.type/math} :answer/value "y{e}^{xy}\\,i+xy{e}^{xy}\\,j" :db/id #edb/ref 17592186386087}] :answer-field/correct {:answer/id #uuid "ad573080-12c0-5795-bd57-186bf4ef86e9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}{e}^{xy}\\,i+(xy+1){e}^{xy}\\,j" :db/id #edb/ref 17592186386083} :answer-field/id #uuid "65e92d39-741b-5c6a-8be4-edf3e06fa576" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386082}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce34f68f-f91f-5032-a961-dafacf6d59a3" :question/math-academy-id "q-104399" :question/problem "For which of the following vector fields is $f(x,y)=y{e}^{xy}$ a potential function?" :question/worked-solution "A vector field $F$ is conservative if it is the gradient of a scalar function $f.$ That is, there exists a function $f$ such that $F=∇f.$ The function $f$ is called a potential function for $F.$\n\nTo compute the vector field associated with a potential function $f,$ we compute its gradient:\n\n$$\n\\begin{aligned}∇f & =\\frac{∂f}{∂x}\\,i+\\frac{∂f}{∂y}\\,j \\\\  & =\\frac{∂}{∂x}(y{e}^{xy})\\,i+\\frac{∂}{∂y}(y{e}^{xy})\\,j \\\\  & ={y}^{2}{e}^{xy}\\,i+(xy+1){e}^{xy}\\,j \\\\  & =F\\end{aligned}\n$$\n\nTherefore, the vector field that has $f$ as a potential function is\n\n$$\nF={y}^{2}{e}^{xy}\\,i+(xy+1){e}^{xy}\\,j.\n$$"}] [{:db/id #edb/ref 17592186386088 :knowledge-point/_questions [{:knowledge-point/id #uuid "000408ba-6fbd-51da-9002-82fdde167a1f" :knowledge-point/title "Identifying Point Discontinuities on a Graph when Multiple Types of Discontinuities Exist"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5efd41f4-a5c6-51c6-84dd-2ab8b7942847" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-1$ and $x=2$ only" :db/id #edb/ref 17592186386090} {:answer/id #uuid "3ef11900-c821-5f52-be08-71eef4de99e8" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186386091} {:answer/id #uuid "66765b2b-71e8-5148-bfcd-f89e5ec0351f" :answer/type {:db/ident :answer.type/text} :answer/value "$x=5$ only" :db/id #edb/ref 17592186386092} {:answer/id #uuid "51b315c5-c232-5008-aea6-49c099709e15" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-1$ and $x=5$ only" :db/id #edb/ref 17592186386093} {:answer/id #uuid "b5414160-2462-5d52-b50a-b952a1d44d97" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=5$ only" :db/id #edb/ref 17592186386094}] :answer-field/correct {:answer/id #uuid "b5414160-2462-5d52-b50a-b952a1d44d97" :answer/type {:db/ident :answer.type/text} :answer/value "$x=2$ and $x=5$ only" :db/id #edb/ref 17592186386094} :answer-field/id #uuid "2a91c606-abe7-5f5b-93f0-c007a89005ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12cf0cf4-20ea-574d-b3f6-b08a331df572" :question/math-academy-id "q-104425" :question/problem "![](images/d8/d869c61426504b7b24c2feebd60f68bca6f7dc8a2b40036bf5821e0208e1e197.png)\n\nConsider the function $y=f(x)$ plotted above. For what values of $x$ does the function $y=f(x)$ have a removable discontinuity?" :question/worked-solution "The function has a discontinuity at $x=2.$ Checking our continuity conditions, we have:\n\n- $f(2)=3$ exists $\\,✓$\n\n- ${lim}_{x\\to 2}f(x)=0$ exists $\\,✓$\n\n- ${lim}_{x\\to 2}f(x)\\ne f(2)\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=2$ is a removable discontinuity.\n\nThe function also has a discontinuity at $x=5.$ Checking our continuity conditions, we have:\n\n- $f(5)=-1$ exists $\\,✓$\n\n- ${lim}_{x\\to 5}f(x)=2$ exists $\\,✓$\n\n- ${lim}_{x\\to 5}f(x)\\ne f(5)\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=5$ is a removable discontinuity.\n\nFinally,  the function has a discontinuity at $x=-1.$ Checking our continuity conditions, we have:\n\n- $f(-1)=3$ exists $\\,✓$\n\n- ${lim}_{x\\to (-1)}f(x)$ does not exists $\\,\\times $\n\nSo it's the second condition that failed, which tells us that $x=-1$ is not a removable discontinuity.\n\nConsequently, the correct answer is $x=2$ and $x=5$ only."}] [{:db/id #edb/ref 17592186059972 :knowledge-point/_questions [{:knowledge-point/id #uuid "4cf627a0-6921-58ee-91c0-2f225d425711" :knowledge-point/title "Finding the Transpose of a Row Vector or Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28b40ab3-2e2d-5b11-8aee-c2a90901f88a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 5 \\\\ 4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186386096} {:answer/id #uuid "b462dd7b-c55c-5859-ab4a-5ce80868e897" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -5 & 4 & -4\\end{aligned}]" :db/id #edb/ref 17592186386097} {:answer/id #uuid "23804c66-ee95-50c0-84c0-7909c68a7143" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -4 \\\\ -5 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186386098} {:answer/id #uuid "c298e082-bb98-5541-8236-4d81c70f22ca" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386099} {:answer/id #uuid "343a923e-fc18-5408-a231-6bdb1ea178da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 5 & 4 & -4\\end{aligned}]" :db/id #edb/ref 17592186386100}] :answer-field/correct {:answer/id #uuid "c298e082-bb98-5541-8236-4d81c70f22ca" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386099} :answer-field/id #uuid "7f1df5bc-2c6e-5f27-92f8-344c9f3c4bb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386095}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f200fb1-1ac4-518a-a135-3b50068ae3b9" :question/math-academy-id "q-1045" :question/problem "Find ${Z}^{T}$ given that \n$Z=[\\begin{aligned}-4 & 4 & 5 & 1\\end{aligned}].$" :question/worked-solution "To find the transpose, we interchange the rows and columns. \n\nHere, there is just a single row, so it becomes a single column:\n\n$$\n{Z}^{T}=[\\begin{aligned}-4 \\\\ 4 \\\\ 5 \\\\ 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186176214 :knowledge-point/_questions [{:knowledge-point/id #uuid "7cf4318c-a323-5224-92df-879ebc2bf3b0" :knowledge-point/title "Integrals Representing Surface Areas Generated by Functions of X"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd7cbc0c-1ac9-5d2c-8c1e-c90064a0020d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\sqrt{1+{cos}^{2}⁡x}\\,\\text{d}x" :db/id #edb/ref 17592186386102} {:answer/id #uuid "ce12d4d4-d1f3-5db5-a2e1-487a2dbee039" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+{cos}^{2}⁡x}\\,\\text{d}x" :db/id #edb/ref 17592186386103} {:answer/id #uuid "ad2323ab-4264-53da-ac17-09aa02263099" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{\\pi /2}x{sin}^{2}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186386104} {:answer/id #uuid "4e3b5d27-917f-51f1-9569-ad74dbcaf182" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{\\pi /2}x{cos}^{2}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186386105} {:answer/id #uuid "6c3afdc6-7909-5577-8288-788734f3eb0c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡x\\sqrt{1+{sin}^{2}⁡x}\\,\\text{d}x" :db/id #edb/ref 17592186386106}] :answer-field/correct {:answer/id #uuid "ce12d4d4-d1f3-5db5-a2e1-487a2dbee039" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+{cos}^{2}⁡x}\\,\\text{d}x" :db/id #edb/ref 17592186386103} :answer-field/id #uuid "036154be-8ded-5df0-8368-91d401b8a252" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386101}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ddd5046-3b26-5239-932f-f9bb69f6472e" :question/math-academy-id "q-104518" :question/problem "Consider the arc of the curve $y=\\operatorname{sin}⁡x$ that lies between the lines $x=0$ and $x=\\frac{\\pi }{2}.$ What integral gives the area of the surface generated when this arc is rotated $2\\pi $ radians about the $y$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $y$-axis using the formula\n\n$$\nS=\\int 2\\pi x\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $y=f(x),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x.\n$$\n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{x}_{1}}^{{x}_{2}}x\\sqrt{1+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+(\\operatorname{cos}⁡x)^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{0}^{\\pi /2}x\\sqrt{1+{cos}^{2}⁡x}\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129418 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e70c003-febf-5ec6-bc57-224282eb5bbc" :knowledge-point/title "Integrals Representing Surface Areas Generated by Functions of Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0ba94d7-362e-54af-a4dc-5650b2efcf4d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /4}y\\sqrt{1+{csc}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186386108} {:answer/id #uuid "0100602d-f98b-513d-9cb0-94a20d3703e7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /4}\\operatorname{tan}⁡y\\sqrt{1+{sec}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186386109} {:answer/id #uuid "ea707e80-3f6b-5ca4-a2d4-29097932496c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /4}y\\sqrt{1+{tan}^{4}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186386110} {:answer/id #uuid "4278f499-f5e5-5ac4-b8e0-fc854a2288e6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /4}\\sqrt{1+{sec}^{2}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186386111} {:answer/id #uuid "028fc07b-3f60-56d1-8edb-1fb1620551ca" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /4}y\\sqrt{1+{sec}^{4}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186386112}] :answer-field/correct {:answer/id #uuid "028fc07b-3f60-56d1-8edb-1fb1620551ca" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{0}^{\\pi /4}y\\sqrt{1+{sec}^{4}⁡y}\\,\\text{d}y" :db/id #edb/ref 17592186386112} :answer-field/id #uuid "66b18467-8af9-5ad0-97da-81cd55579f69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c12e390-7cac-5d15-8cb3-07a2b192a6de" :question/math-academy-id "q-104533" :question/problem "Consider the arc of the curve $x=\\operatorname{tan}⁡y$ that lies between $y=0$ and $y=\\frac{\\pi }{4}.$ What integral gives the surface area generated when this arc is rotated $2\\pi $ radians about the $x$-axis?" :question/worked-solution "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince we're given a curve in the form $x=f(y),$ we have \n\n$$\n\\text{d}s=\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}y\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y.\n$$\n\nWe are told that the limits of integration are from ${y}_{1}=0$ to ${y}_{2}=\\frac{\\pi }{4}.$ \n\nComputing the derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\operatorname{tan}⁡y)={sec}^{2}⁡y.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{{y}_{1}}^{{y}_{2}}y\\sqrt{1+{(\\frac{\\text{d}x}{\\text{d}y})}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{\\pi /4}y\\sqrt{1+{({sec}^{2}⁡y)}^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{0}^{\\pi /4}y\\sqrt{1+{sec}^{4}⁡y}\\,\\text{d}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186059973 :knowledge-point/_questions [{:knowledge-point/id #uuid "57187716-c00b-5428-a83a-18836d6b3d04" :knowledge-point/title "Finding the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90cfa806-a408-5584-9b2f-7a716390b345" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 & -8 \\\\ 7 & 0 & 1 \\\\ 9 & 6 & 2\\end{aligned}]" :db/id #edb/ref 17592186386114} {:answer/id #uuid "359afeae-210f-5a6f-b484-5d506a51f63e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 & 8 \\\\ 9 & 6 & 2 \\\\ 7 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386115} {:answer/id #uuid "fe6e17b7-9d03-5ed6-a56b-24c9ac9fdce9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -1 & 8 \\\\ 9 & 6 & 2 \\\\ 7 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386116} {:answer/id #uuid "2db9ae92-2b7c-5f26-9065-12b896d1bae2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 & -8 \\\\ 9 & 6 & 2 \\\\ 7 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386117} {:answer/id #uuid "6a537e4b-bd62-5d2d-b922-3e1370f54320" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 & 2 & 1 \\\\ 1 & 6 & 0 \\\\ -2 & 9 & 7\\end{aligned}]" :db/id #edb/ref 17592186386118}] :answer-field/correct {:answer/id #uuid "2db9ae92-2b7c-5f26-9065-12b896d1bae2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 & -8 \\\\ 9 & 6 & 2 \\\\ 7 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386117} :answer-field/id #uuid "b8114b1f-0b45-5ad6-b1a3-efb1298d6c50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386113}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa4d0129-a960-5457-860b-a15400c40c1a" :question/math-academy-id "q-1046" :question/problem "If\n    $Y=[\\begin{aligned}-2 & 9 & 7 \\\\ 1 & 6 & 0 \\\\ -8 & 2 & 1\\end{aligned}],$\nthen ${Y}^{T}=$" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n\n$$\n{Y}^{T}=[\\begin{aligned}-2 & 1 & -8 \\\\ 9 & 6 & 2 \\\\ 7 & 0 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186386119 :knowledge-point/_questions [{:knowledge-point/id #uuid "57187716-c00b-5428-a83a-18836d6b3d04" :knowledge-point/title "Finding the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86b41226-e408-58fa-979b-cc8b45e98ea0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & -1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186386121} {:answer/id #uuid "7d5fd916-088a-5166-a538-72ebe72e4bdb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186386122} {:answer/id #uuid "01bcfd1e-33a3-5426-bd02-020463692e15" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386123} {:answer/id #uuid "022a1834-fda3-5d40-bde2-1fd310284924" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186386124} {:answer/id #uuid "f86b76d5-d01e-510d-96f5-f8a51a52467b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386125}] :answer-field/correct {:answer/id #uuid "f86b76d5-d01e-510d-96f5-f8a51a52467b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386125} :answer-field/id #uuid "6652d0ba-d453-5e9e-b621-000a54f9c592" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63467001-d681-5463-af29-def2aaee49d5" :question/math-academy-id "q-1047" :question/problem "If\n    $A=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]$,\nthen ${A}^{T}=$" :question/worked-solution "To find the transpose, we interchange the rows and columns:\n\n$$\n{A}^{T}=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186386126 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab0d2c2f-e7a4-51bb-a20a-f28c2f7ded8b" :knowledge-point/title "Adding Multiples of Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5107457c-138b-51a7-92ae-a6758039472a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 24 \\\\ 0 \\\\ -8 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186386128} {:answer/id #uuid "ff169898-02e2-5209-864c-d14da00b29d2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 \\\\ 12 \\\\ 4 \\\\ 2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186386129} {:answer/id #uuid "532d0a4e-4a89-57b6-99e6-afc159ce6d1b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186386130} {:answer/id #uuid "87d8f2f7-2901-5f83-8b3e-f48100e7a7d0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 12 \\\\ 0 \\\\ -4 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186386131} {:answer/id #uuid "655d0d3d-495e-5ce2-a46b-ad3d1938e299" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 6 \\\\ 0 \\\\ -2 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186386132}] :answer-field/correct {:answer/id #uuid "532d0a4e-4a89-57b6-99e6-afc159ce6d1b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186386130} :answer-field/id #uuid "0c9fbf95-eeae-5173-ac51-079d67124b2a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386127}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3e014c9-7e0f-5613-9d77-d53b9ab4992b" :question/math-academy-id "q-105102" :question/problem "Let $v=[\\begin{aligned}5 \\\\ -3 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}]$ and $w=[\\begin{aligned}-1 \\\\ 9 \\\\ -2 \\\\ 3 \\\\ -1\\end{aligned}].$ Find $4v+2w.$" :question/worked-solution "First, we multiply each component of $v$ by $4$ and each component of $w$ by $2.$ Then, we add the vectors:\n\n$$\n\\begin{aligned}4v+2w & =4\\cdot [\\begin{aligned}5 \\\\ -3 \\\\ 2 \\\\ -1 \\\\ 0\\end{aligned}]+2\\cdot [\\begin{aligned}-1 \\\\ 9 \\\\ -2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}20 \\\\ -12 \\\\ 8 \\\\ -4 \\\\ 0\\end{aligned}]+[\\begin{aligned}-2 \\\\ 18 \\\\ -4 \\\\ 6 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}20+(-2) \\\\ -12+18 \\\\ 8+(-4) \\\\ -4+6 \\\\ 0+(-2)\\end{aligned}] \\\\  & =[\\begin{aligned}18 \\\\ 6 \\\\ 4 \\\\ 2 \\\\ -2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386133 :knowledge-point/_questions [{:knowledge-point/id #uuid "a10cafc6-9da7-5ffc-a0c7-686a7638fbd9" :knowledge-point/title "Reducing a 2x2 Augmented Matrix to REF Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d07c9974-5e26-5ea1-90a8-dffd38fc2401" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186386135} {:answer/id #uuid "d212caa5-8f57-5805-96ab-3c0315ae6bed" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186386136} {:answer/id #uuid "a33c81ec-3df4-5242-9e92-e26a5c03aaad" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186386137} {:answer/id #uuid "ab3b0c81-7199-5b1d-8356-cda4803a78e3" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{4}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186386138} {:answer/id #uuid "b8bedb9d-48b2-5e0f-9d78-13d36b7ee868" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{4}{3} & \\frac{4}{3} \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386139}] :answer-field/correct {:answer/id #uuid "d07c9974-5e26-5ea1-90a8-dffd38fc2401" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186386135} :answer-field/id #uuid "43e6d8d3-b012-5436-a03c-f55f188923ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386134}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97656c8d-f73c-5b5a-a5d7-69f60766b5eb" :question/math-academy-id "q-10512" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form using the standard algorithm for Gaussian elimination, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -2 & 4 \\\\ 6 & 4 & -8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 6 & 4 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}-6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 8 & -16\\end{aligned}] & {R}_{2} & :=\\frac{1}{8}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386140 :knowledge-point/_questions [{:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/title "Solving for a Vector in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc92ac47-4627-58c3-a337-9804fd3c85cf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 2 \\\\ 1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186386142} {:answer/id #uuid "08ca37cb-d3b6-53e5-bdfa-41a6f5544e2a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 0 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186386143} {:answer/id #uuid "bbae1fb7-89ca-5229-b719-b2c249fd8c2d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ -1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186386144} {:answer/id #uuid "6e9053ec-d943-5648-be8d-e9cc0c0fa69d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186386145} {:answer/id #uuid "130e27a8-0043-5a84-8507-122ce01fb961" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 3 \\\\ 1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386146}] :answer-field/correct {:answer/id #uuid "6e9053ec-d943-5648-be8d-e9cc0c0fa69d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186386145} :answer-field/id #uuid "d890fa03-b1e8-5871-8a57-59bb4cbc42ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386141}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ebd8d026-a8f0-5c49-8cd6-0d2ba4d731b2" :question/math-academy-id "q-105157" :question/problem "Find $x$, if $2a+4x=b$ and\n\n$$\na=[\\begin{aligned}5 \\\\ -3 \\\\ 1 \\\\ 6\\end{aligned}],\\,b=[\\begin{aligned}14 \\\\ 2 \\\\ -2 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}2a+4x & =b \\\\ 4x & =b-2a \\\\ x & =\\frac{1}{4}(b-2a) \\\\ x & =\\frac{1}{4}([\\begin{aligned}14 \\\\ 2 \\\\ -2 \\\\ 0\\end{aligned}]-2[\\begin{aligned}5 \\\\ -3 \\\\ 1 \\\\ 6\\end{aligned}]) \\\\ x & =\\frac{1}{4}[\\begin{aligned}4 \\\\ 8 \\\\ -4 \\\\ -12\\end{aligned}] \\\\ x & =[\\begin{aligned}1 \\\\ 2 \\\\ -1 \\\\ -3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386147 :knowledge-point/_questions [{:knowledge-point/id #uuid "36524faf-ac61-5756-89e3-c83a947ac61b" :knowledge-point/title "Determining Closed Intervals of Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b055651-f48a-530d-8839-a9fa6a507120" :answer/type {:db/ident :answer.type/image} :answer/value "images/d5/d5cfd29b266bee94ed812edb71ac9804e385c9523341816be98ac278c088ef3b.png" :db/id #edb/ref 17592186386149} {:answer/id #uuid "a8f9476b-4797-542f-9fde-051e67ff10dd" :answer/type {:db/ident :answer.type/image} :answer/value "images/f0/f0f65307224a5fea45530fd542be70d91039bc55aa2cd8b9f17537874c5170ae.png" :db/id #edb/ref 17592186386150} {:answer/id #uuid "da2a0717-9579-538a-8bd6-b64145d8464f" :answer/type {:db/ident :answer.type/image} :answer/value "images/5b/5b2ca56f8c5c41015e6b0dc42311892becbb9f99233f5f9ddee951b993af95d4.png" :db/id #edb/ref 17592186386151} {:answer/id #uuid "e4e135a4-1181-5606-acd5-846a34eda456" :answer/type {:db/ident :answer.type/image} :answer/value "images/f1/f13573a5bfe5661e1b9853ea559c88f48a887b3fa0618605b7f3a4c933645af3.png" :db/id #edb/ref 17592186386152} {:answer/id #uuid "9e6cfa89-3814-51ff-86b5-d443219fa5be" :answer/type {:db/ident :answer.type/image} :answer/value "images/03/03d8fa6c421deebb49b3746425f799a2eea7fc22f07175bb1cf80d270f896555.png" :db/id #edb/ref 17592186386153}] :answer-field/correct {:answer/id #uuid "9e6cfa89-3814-51ff-86b5-d443219fa5be" :answer/type {:db/ident :answer.type/image} :answer/value "images/03/03d8fa6c421deebb49b3746425f799a2eea7fc22f07175bb1cf80d270f896555.png" :db/id #edb/ref 17592186386153} :answer-field/id #uuid "5d6e79ef-5309-5809-b54b-e5b877f96e8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386148}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f10cb2f1-287e-54d9-a68e-50d79d0f8000" :question/math-academy-id "q-105181" :question/problem "Which of the following functions is continuous on the interval $[1,4]?$" :question/worked-solution "The correct answer is the following. \n\n![](images/03/03d8fa6c421deebb49b3746425f799a2eea7fc22f07175bb1cf80d270f896555.png)\n\n  \n\nIndeed, this function is continuous on the open intervals $(-\\infty ,1)$ and $(1,5).$\n\nAdditionally, the function is right-continuous at $x=1.$ Hence, it is continuous on the interval $[1,5).$\n\nSo, we can say that the function is continuous on the intervals $(-\\infty ,1)$ and $[1,5).$ It is also continuous on any subinterval of these intervals.\n\nTherefore, this function is continuous on $[1,4]$ because $[1,4]$ is contained inside the interval $[1,5).$\n\nNotice that\n\n- $q(x)$ is not right-continuous at $x=1,$ so it is not continuous on the interval $[1,4].$\n\n- $f(x)$ is not defined at $x=2,$ and so it is not continuous on the interval $[1,4].$\n\n- $g(x)$ has a removable discontinuity at $x=3.$ So it is not continuous on the interval $[1,4].$\n\n- $p(x)$ is not defined at $x=4,$ and so it is not continuous on the interval $[1,4].$"}] [{:db/id #edb/ref 17592186386154 :knowledge-point/_questions [{:knowledge-point/id #uuid "bbfddefc-d68b-5b1e-9ec5-fd18be204d92" :knowledge-point/title "Identifying Semi-Open Intervals of Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95be621a-8e1d-55d0-bedd-886439401e76" :answer/type {:db/ident :answer.type/image} :answer/value "images/24/24551c0a0d905070625c0d1ef76fa942dab6764c1540f7ed317eda533dca06d5.png" :db/id #edb/ref 17592186386156} {:answer/id #uuid "c9dd3ecc-32ea-517a-80ba-77de5c86fe90" :answer/type {:db/ident :answer.type/image} :answer/value "images/99/99e22a7485ab6e5b2a086418678d90160644814965aac3a3d1aede04e7cc6f2c.png" :db/id #edb/ref 17592186386157} {:answer/id #uuid "04869119-329b-5c6a-a260-8d54ed401acc" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e6f54ad54f5b89f674469c29781d416f0d498855c6d788104d47a8119fa197e8.png" :db/id #edb/ref 17592186386158} {:answer/id #uuid "47a534a2-65c8-5bd1-bf59-bed04c129751" :answer/type {:db/ident :answer.type/image} :answer/value "images/7a/7afb04e0197b44ffadeee53bc365910f7c578eb8a3f2e2971a83f4f51947a3af.png" :db/id #edb/ref 17592186386159} {:answer/id #uuid "65f7a984-1ea5-572a-962d-aa8344cc2b35" :answer/type {:db/ident :answer.type/image} :answer/value "images/95/95587cfce50fd6e9c448bf3485dd98f7dd5bb401778b7a9fac939d356a112677.png" :db/id #edb/ref 17592186386160}] :answer-field/correct {:answer/id #uuid "47a534a2-65c8-5bd1-bf59-bed04c129751" :answer/type {:db/ident :answer.type/image} :answer/value "images/7a/7afb04e0197b44ffadeee53bc365910f7c578eb8a3f2e2971a83f4f51947a3af.png" :db/id #edb/ref 17592186386159} :answer-field/id #uuid "712fe9c6-4384-5603-a640-00082f69502a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19bb2540-93a4-5094-9d6e-6f7514d17932" :question/math-academy-id "q-105413" :question/problem "Which of the following functions is continuous on the interval $(-\\infty ,2]?$  You may assume that all points of discontinuity for each function are shown." :question/worked-solution "The correct answer is the following.\n\n![](images/7a/7afb04e0197b44ffadeee53bc365910f7c578eb8a3f2e2971a83f4f51947a3af.png)\n\nWe see that $q(x)$ is continuous on the interval $(-\\infty ,3],$ and since $(-\\infty ,2]$ lies completely inside $(-\\infty ,3],$ it is also continuous on $(-\\infty ,2].$\n\nNotice that\n\n- $f(x)$ and $g(x)$ are not continuous at $x=-1$, and so are not continuous on $(-\\infty ,2].$\n\n- $p(x)$ and $h(x)$ are not continuous at $x=0$, and so are not continuous on $(-\\infty ,2].$"}] [{:db/id #edb/ref 17592186120077 :knowledge-point/_questions [{:knowledge-point/id #uuid "df6cef5e-c4e3-5f5d-aa68-cfda38cab971" :knowledge-point/title "Calculating the Fundamental Vector Product of a Parametric Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "669c4a14-f117-5445-b5bc-ddb0e9ee19d3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,4{cos}^{2}⁡u,\\,v\\operatorname{cos}⁡u⟩" :db/id #edb/ref 17592186386162} {:answer/id #uuid "eef920f4-e456-5f91-861d-e610778fc9f1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8{v}^{2}\\operatorname{sin}⁡u,\\,4{cos}^{2}⁡u,\\,2v\\operatorname{cos}⁡u⟩" :db/id #edb/ref 17592186386163} {:answer/id #uuid "f3f56c70-5d40-5441-8d68-4c329568c111" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,-4{cos}^{2}⁡u,\\,v\\operatorname{cos}⁡u⟩" :db/id #edb/ref 17592186386164} {:answer/id #uuid "f2243c43-9e9a-5017-9fb8-6ac7cf899ac8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{cos}⁡u,\\,0,\\,-4v\\operatorname{sin}⁡u⟩" :db/id #edb/ref 17592186386165} {:answer/id #uuid "9ff4ca66-39af-5179-9dd1-8d5dfc378981" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8{v}^{2}\\operatorname{sin}⁡u,\\,-4{cos}^{2}⁡u,\\,2v\\operatorname{cos}⁡u⟩" :db/id #edb/ref 17592186386166}] :answer-field/correct {:answer/id #uuid "9ff4ca66-39af-5179-9dd1-8d5dfc378981" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8{v}^{2}\\operatorname{sin}⁡u,\\,-4{cos}^{2}⁡u,\\,2v\\operatorname{cos}⁡u⟩" :db/id #edb/ref 17592186386166} :answer-field/id #uuid "a72c3135-50a8-5b65-947b-d6cde382e4fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386161}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cf9a45d8-93e4-5a5c-8ad1-796e86ba6570" :question/math-academy-id "q-105606" :question/problem "Find the fundamental vector product of the surface generated by the vector-valued function $r(u,v)=⟨\\operatorname{sin}⁡u,\\,{v}^{2},\\,4v\\operatorname{cos}⁡u⟩.$" :question/worked-solution "For a surface with parametrization $r(u,v),$ the fundamental vector product is defined as ${r}_{u}^{′}\\times {r}_{v}^{′}.$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(\\operatorname{sin}⁡u),\\,\\frac{∂}{∂u}({v}^{2}),\\,\\frac{∂}{∂u}(4v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨\\operatorname{cos}⁡u,\\,0,\\,-4v\\operatorname{sin}⁡u⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(\\operatorname{sin}⁡u),\\,\\frac{∂}{∂v}({v}^{2}),\\,\\frac{∂}{∂v}(4v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨0,\\,2v,\\,4\\operatorname{cos}⁡u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ \\operatorname{cos}⁡u & 0 & -4v\\operatorname{sin}⁡u \\\\ 0 & 2v & 4\\operatorname{cos}⁡u\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & -4v\\operatorname{sin}⁡u \\\\ 2v & 4\\operatorname{cos}⁡u\\end{aligned}|,\\,-|\\begin{aligned}\\operatorname{cos}⁡u & -4v\\operatorname{sin}⁡u \\\\ 0 & 4\\operatorname{cos}⁡u\\end{aligned}|,\\,|\\begin{aligned}\\operatorname{cos}⁡u & 0 \\\\ 0 & 2v\\end{aligned}|⟩ \\\\  & =⟨8{v}^{2}\\operatorname{sin}⁡u,\\,-4{cos}^{2}⁡u,\\,2v\\operatorname{cos}⁡u⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386167 :knowledge-point/_questions [{:knowledge-point/id #uuid "8c1d9899-21e8-5ab1-9bc5-10e4a8100ed9" :knowledge-point/title "Identifying the Missing Set to Form a Partition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc6f69b-f6d2-52b5-8c5e-9b19f618ebe6" :answer/type {:db/ident :answer.type/math} :answer/value "{2,6,10}" :db/id #edb/ref 17592186386169} {:answer/id #uuid "664d4ffd-480c-5f22-8979-8452bf37b1ea" :answer/type {:db/ident :answer.type/math} :answer/value "{6,14}" :db/id #edb/ref 17592186386170} {:answer/id #uuid "0b3a3ab6-1188-541b-a7df-c1ae670d8a41" :answer/type {:db/ident :answer.type/math} :answer/value "{10,14}" :db/id #edb/ref 17592186386171} {:answer/id #uuid "1705d56f-cd06-57b9-b296-71fa6a5b00d5" :answer/type {:db/ident :answer.type/math} :answer/value "{6,10,14}" :db/id #edb/ref 17592186386172} {:answer/id #uuid "78f323c8-b0e7-531d-a28a-8f16987a3121" :answer/type {:db/ident :answer.type/math} :answer/value "{14}" :db/id #edb/ref 17592186386173}] :answer-field/correct {:answer/id #uuid "78f323c8-b0e7-531d-a28a-8f16987a3121" :answer/type {:db/ident :answer.type/math} :answer/value "{14}" :db/id #edb/ref 17592186386173} :answer-field/id #uuid "9763950a-9d31-5794-bcc0-4622ea09bfb3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "29332e57-5723-57e4-a031-105647b85293" :question/math-academy-id "q-105877" :question/problem "Consider the set $X={2,4,6,8,10,12,14}.$ Which subset must be placed into the blank in the set below so that it represents a partition of $X?$\n\n$$\n{{2,4,8},{6,12},\\,{10},\\,____\\,}\n$$" :question/worked-solution "A partition of a set $X$ is a collection of non-empty subsets of $X$ where every element of $X$ is contained in *exactly* one subset. \n\nTo find the subset that goes in the blank, we must identify which elements of $X$ are not yet contained within any of the given subsets.\n\nLet's go through each element of $X$ and check:\n\n- $2\\in {2,4,8}\\,✓$\n\n- $4\\in {2,4,8}\\,✓$\n\n- $6\\in {6,12}\\,✓$\n\n- $8\\in {2,4,8}\\,✓$\n\n- $10\\in {10}\\,✓$\n\n- $12\\in {6,12}\\,✓$\n\n- $14$ does not belong to any of the given subsets $\\,\\times $\n\nThe element $14$ is not yet contained within any of the given subsets. Therefore, the subset that must go in the blank is ${14}.$"}] [{:db/id #edb/ref 17592186386174 :knowledge-point/_questions [{:knowledge-point/id #uuid "8c1d9899-21e8-5ab1-9bc5-10e4a8100ed9" :knowledge-point/title "Identifying the Missing Set to Form a Partition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74cbbdde-cbc3-54cb-af2a-a0732e5ca787" :answer/type {:db/ident :answer.type/math} :answer/value "{-1,1}" :db/id #edb/ref 17592186386176} {:answer/id #uuid "caf43eb3-0594-58fb-935d-d62889ffee69" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186386177} {:answer/id #uuid "1077f90b-a70d-5b5d-988d-1a3679ada0db" :answer/type {:db/ident :answer.type/math} :answer/value "{-2,0,2}" :db/id #edb/ref 17592186386178} {:answer/id #uuid "030ddb3b-a0f8-5aea-91b9-58899df224d5" :answer/type {:db/ident :answer.type/math} :answer/value "{-3,3}" :db/id #edb/ref 17592186386179} {:answer/id #uuid "fe887676-8b5e-5dc0-8feb-61b34152b45b" :answer/type {:db/ident :answer.type/math} :answer/value "{-1,0,1}" :db/id #edb/ref 17592186386180}] :answer-field/correct {:answer/id #uuid "caf43eb3-0594-58fb-935d-d62889ffee69" :answer/type {:db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186386177} :answer-field/id #uuid "da0cd51d-9e41-508e-b9ca-54411ba7c134" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d02c796b-dd83-5bc9-b516-9c37688041a0" :question/math-academy-id "q-105878" :question/problem "Consider the set $A={-3,-2,-1,0,1,2,3}.$ Which subset must be placed into the blank in the set below so that it represents a partition of $A?$\n\n$$\n{{-3,-2,-1},{1,2,3},\\,____\\,}\n$$" :question/worked-solution "A partition of a set $A$ is a collection of non-empty subsets of $A$ where every element of $A$ is contained in *exactly* one subset. \n\nTo find the subset that goes in the blank, we must identify which elements of $A$ are not yet contained within any of the given subsets.\n\nLet's go through each element of $X$ and check:\n\n- $-3\\in {-3,-2,-1}\\,✓$\n\n- $-2\\in {-3,-2,-1}\\,✓$\n\n- $-3\\in {-3,-2,-1}\\,✓$\n\n- $0$ does not belong to any of the given subsets $\\,\\times $\n\n- $1\\in {1,2,3}\\,✓$\n\n- $2\\in {1,2,3}\\,✓$\n\n- $3\\in {1,2,3}\\,✓$\n\nThe element  $0$ is not yet contained within any of the given subsets. Therefore, the subset that must go in the blank is ${0}.$"}] [{:db/id #edb/ref 17592186386181 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffe539af-1253-5ce3-a65b-eb50ed639c52" :knowledge-point/title "Finding the Curl of a Vector Field Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9805af05-6995-560f-9ff6-9b1ba67e1079" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-2,1⟩" :db/id #edb/ref 17592186386183} {:answer/id #uuid "25b195d5-5b19-56ce-9e4f-331ecfee26bc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4,0,0⟩" :db/id #edb/ref 17592186386184} {:answer/id #uuid "4aac2764-d294-5be0-96e8-2863cecc4fd3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,0,1⟩" :db/id #edb/ref 17592186386185} {:answer/id #uuid "874c0947-9dbf-5d2e-a014-9b6a1f4f347b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,0,0⟩" :db/id #edb/ref 17592186386186} {:answer/id #uuid "ab7deeef-28b2-5522-bde1-14604fa0ce86" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,0,-1⟩" :db/id #edb/ref 17592186386187}] :answer-field/correct {:answer/id #uuid "25b195d5-5b19-56ce-9e4f-331ecfee26bc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4,0,0⟩" :db/id #edb/ref 17592186386184} :answer-field/id #uuid "2be98543-5eeb-59fa-92e7-b476092e5ae2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af5d832d-bffb-56c4-8e12-6440a08b81a3" :question/math-academy-id "q-105962" :question/problem "Consider the vector field $F(x,y,z)=⟨x,0,yz⟩$ and the scalar field $f(x,y,z)=y-{x}^{2}.$ Given that\n\n$$\n∇\\times F=⟨z,0,0⟩,\\,∇f=⟨-2x,1,0⟩,\n$$\n\ncalculate $∇\\times (f\\,F)$ at the point $(0,2,-1).$" :question/worked-solution "We shall use the following identity:\n\n$$\n∇\\times (f\\,F)=f∇\\times F+∇f\\times F\n$$\n\nFirst, we compute $∇f\\times F.$ We get\n\n$$\n\\begin{aligned}∇f\\times F & =|\\begin{aligned}i & j & k \\\\ -2x & 1 & 0 \\\\ x & 0 & yz\\end{aligned}| \\\\  & =[1(yz)-0(0)]i-[-2x(yz)-0(x)]j+[-2x(0)-1(x)]k \\\\  & =yz\\,i+2xyz\\,j-x\\,k \\\\  & =⟨yz,2xyz,-x⟩.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\times (f\\,F) & =f∇\\times F+∇f\\times F \\\\  & =(y-{x}^{2})⟨z,0,0⟩+⟨yz,2xyz,-x⟩ \\\\  & =⟨z(y-{x}^{2}),0,0⟩+⟨yz,2xyz,-x⟩ \\\\  & =⟨z(2y-{x}^{2}),2xyz,-x⟩.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}∇\\times (f\\,F)(0,2,-1) & =⟨(-1)(2(2)-(0)^{2}),2(0)(2)(-1),-0⟩ \\\\  & =⟨-4,0,0⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386188 :knowledge-point/_questions [{:knowledge-point/id #uuid "95627f8c-4151-5565-8803-7558bd674acb" :knowledge-point/title "Adding Non-Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55932ce-3f50-5b73-858f-cb76f12c3587" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ -1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386190} {:answer/id #uuid "15d52a5c-027a-512d-9f40-5eed9dc914ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386191} {:answer/id #uuid "c534b1fe-2ec4-554b-8341-0c38ee03d056" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & 12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386192} {:answer/id #uuid "49ccf434-d5d9-541f-a931-72a94a342247" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & -17\\end{aligned}]" :db/id #edb/ref 17592186386193} {:answer/id #uuid "9143ce0c-958c-5996-b37e-3c51ef20ca74" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & 12 & 1 \\\\ 1 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386194}] :answer-field/correct {:answer/id #uuid "15d52a5c-027a-512d-9f40-5eed9dc914ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386191} :answer-field/id #uuid "b026c447-2f5b-5963-aace-757189b51481" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386189}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c2549bb3-62b2-5d71-b2ff-f2d99c30a636" :question/math-academy-id "q-106" :question/problem "Calculate $M+N,$ where\n\n$$\nM=[\\begin{aligned}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{aligned}],\\,N=[\\begin{aligned}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{aligned}].\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}M+N & =[\\begin{aligned}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{aligned}]+[\\begin{aligned}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{aligned}] \\\\  & =[\\begin{aligned}3+(-15) & -6+(-6) & 14+(-13) \\\\ 2+(-1) & 9+(-8) & -13+14\\end{aligned}] \\\\  & =[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172238 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d7d1683-4735-5c93-9ad1-542e987aed1d" :knowledge-point/title "Calculating a Surface of Revolution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bb9acef-e5be-5b06-abee-5c08fa99b877" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+{y}^{2}}\\,\\text{d}y" :db/id #edb/ref 17592186386196} {:answer/id #uuid "d6756399-d36a-5b4b-96d5-b5ff1380e012" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+{y}^{2}}\\,\\text{d}y" :db/id #edb/ref 17592186386197} {:answer/id #uuid "cf38efd4-12be-53ea-8790-5991f3174816" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}\\sqrt{1+4{y}^{2}}\\,\\text{d}y" :db/id #edb/ref 17592186386198} {:answer/id #uuid "fcc87696-0f7f-5357-9620-dd2e02cbb9a9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+4{y}^{2}}\\,\\text{d}y" :db/id #edb/ref 17592186386199} {:answer/id #uuid "7bf9de78-7ed1-584c-bc4f-51bca014dd3f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+4{y}^{2}}\\,\\text{d}y" :db/id #edb/ref 17592186386200}] :answer-field/correct {:answer/id #uuid "fcc87696-0f7f-5357-9620-dd2e02cbb9a9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+4{y}^{2}}\\,\\text{d}y" :db/id #edb/ref 17592186386199} :answer-field/id #uuid "3d86a85b-b70e-51ce-aacd-6ac51a7a9220" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386195}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bba1677a-6311-54bf-bad0-6a9e581cdd7d" :question/math-academy-id "q-106058" :question/problem "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $x=1+{y}^{2}$ is rotated by $2\\pi $ radians about the $y$-axis for $y\\in [-1,1].$" :question/worked-solution "Notice that $x=1+{y}^{2}\\ge 0$ for all $y\\in [-1,1].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨f(y)\\operatorname{cos}⁡\\theta ,\\,y,\\,f(y)\\operatorname{sin}⁡\\theta ⟩,\\,(y,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(y)=1+{y}^{2},$ and\n\n$$\nD={(y,\\theta )\\,:\\,-1\\le y\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂x}{∂y},\\,\\frac{∂y}{∂y}\\,\\frac{∂z}{∂y}⟩=⟨{f}^{′}\\operatorname{cos}⁡\\theta ,\\,1,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨-f\\operatorname{sin}⁡\\theta ,\\,0,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ {f}^{′}\\operatorname{cos}⁡\\theta  & 1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}| \\\\  & =⟨|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,-|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & 1 \\\\ -f\\operatorname{sin}⁡\\theta  & 0\\end{aligned}|⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′}{cos}^{2}⁡\\theta -f{f}^{′}{sin}^{2}⁡\\theta ,\\,f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f\\operatorname{cos}⁡\\theta ,\\,-f{f}^{′},\\,f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f\\operatorname{cos}⁡\\theta )^{2}+(-f{f}^{′})^{2}+(f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+{f}^{2}({f}^{′})^{2}} \\\\  & =\\sqrt{{f}^{2}+{f}^{2}({f}^{′})^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{y}^{′}\\times {r}_{\\theta }^{′}‖\\text{d}y\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y\\,\\text{d}\\theta  \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y.\\end{aligned}\n$$\n\nSince $f=1+{y}^{2},$ we obtain ${f}^{′}=2y.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-1}^{1}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}y & =2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+(2y)^{2}}\\,\\text{d}y \\\\  & =2\\pi {\\int }_{-1}^{1}(1+{y}^{2})\\sqrt{1+4{y}^{2}}\\,\\text{d}y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386201 :knowledge-point/_questions [{:knowledge-point/id #uuid "ebec626a-be3d-5920-9588-48f3df108944" :knowledge-point/title "Finding Points That Satisfy the Mean Value Theorem for Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47c33e38-477d-5600-84ed-9554c6dbfe3f" :answer/type {:db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186386203} {:answer/id #uuid "3529973c-7da6-532f-b855-6b5dafe941fc" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186386204} {:answer/id #uuid "b9546d49-13bb-5f93-926d-b0d31adb08ef" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{2},\\frac{3}{2})" :db/id #edb/ref 17592186386205} {:answer/id #uuid "44ab66b4-6131-5912-b014-a5849bfecd02" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{5},\\sqrt{5})" :db/id #edb/ref 17592186386206} {:answer/id #uuid "863293ef-931d-5b1c-90cc-61204e60ef84" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{10}}{2},\\frac{\\sqrt{10}}{2})" :db/id #edb/ref 17592186386207}] :answer-field/correct {:answer/id #uuid "863293ef-931d-5b1c-90cc-61204e60ef84" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{10}}{2},\\frac{\\sqrt{10}}{2})" :db/id #edb/ref 17592186386207} :answer-field/id #uuid "c584f1ba-f942-56f1-8593-1d5aaefa70d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386202}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "20d6d567-2d4c-5711-a61a-965584379b0f" :question/math-academy-id "q-106082" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y)=\\sqrt{25-{x}^{2}}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨0,0⟩$ and $b=⟨3,3⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that the function $f(x,y)=\\sqrt{25-{x}^{2}}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨0,0⟩$ and $b=⟨3,3⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(3,3)-f(0,0) & =∇f(c)\\cdot (⟨3,3⟩-⟨0,0⟩) \\\\ \\sqrt{25-{3}^{2}}-\\sqrt{25-{0}^{2}} & =∇f(c)\\cdot ⟨3,3⟩ \\\\ 4-5 & =∇f(c)\\cdot ⟨3,3⟩ \\\\ -1 & =∇f(c)\\cdot ⟨3,3⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨-\\frac{x}{\\sqrt{25-{x}^{2}}},0⟩, \\\\ ∇f(c) & =⟨-\\frac{{c}_{1}}{\\sqrt{25-{c}_{1}^{2}}},0⟩.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}-1 & =∇f⟨c⟩\\cdot ⟨3,3⟩ \\\\ -1 & =⟨-\\frac{{c}_{1}}{\\sqrt{25-{c}_{1}^{2}}},0⟩\\cdot ⟨3,3⟩ \\\\ -1 & =-\\frac{3{c}_{1}}{\\sqrt{25-{c}_{1}^{2}}} \\\\ \\sqrt{25-{c}_{1}^{2}} & =3{c}_{1}.\\end{aligned}\n$$\n\nNow we solve this radical equation:\n\n$$\n\\begin{aligned}\\sqrt{25-{c}_{1}^{2}} & =3{c}_{1} \\\\ 25-{c}_{1}^{2} & =9{c}_{1}^{2} \\\\ 10{c}_{1}^{2} & =25 \\\\ {c}_{1}^{2} & =\\frac{5}{2} \\\\ {c}_{1} & =\\pm \\frac{\\sqrt{10}}{2}.\\end{aligned}\n$$\n\nSubstituting back into the radical equation, we notice that ${c}_{1}=-\\frac{\\sqrt{10}}{2}$ does not satisfy the equation. Therefore, the only solution is ${c}_{1}=\\frac{\\sqrt{10}}{2}.$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}$ to find ${c}_{2}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{y-{y}_{a}}{{y}_{b}-{y}_{a}} & =\\frac{x-{x}_{a}}{{x}_{b}-{x}_{a}} \\\\ \\frac{y-0}{3-0} & =\\frac{x-0}{3-0} \\\\ \\frac{y}{3} & =\\frac{x}{3} \\\\ y & =x.\\end{aligned}\n$$\n\nSince $c=⟨{c}_{1},{c}_{2}⟩$ satisfies the equation of the line, we have\n\n$$\n\\begin{aligned}{c}_{2} & ={c}_{1}.\\end{aligned}\n$$\n\nFinally, taking into account that ${c}_{1}=\\frac{\\sqrt{10}}{2},$ we obtain that ${c}_{2}={c}_{1}=\\frac{\\sqrt{10}}{2}.$ So, the point $C$ that satisfies the mean value theorem is $(\\frac{\\sqrt{10}}{2},\\frac{\\sqrt{10}}{2}).$"}] [{:db/id #edb/ref 17592186386208 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f9ea905-6eb5-55fe-b487-b115406bbc46" :knowledge-point/title "Finding Points That Satisfy the Mean Value Theorem for Three-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f6e20cf-a207-53df-a8b0-0518026259b1" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},\\frac{3}{2},\\frac{5}{2})" :db/id #edb/ref 17592186386210} {:answer/id #uuid "267dcb4d-4597-58c2-9753-09ed05db9bc0" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},3,2)" :db/id #edb/ref 17592186386211} {:answer/id #uuid "9938fa9e-9166-5389-9bf5-614d47432dfb" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},3,1)" :db/id #edb/ref 17592186386212} {:answer/id #uuid "77e62bec-0cf5-551e-b383-1259ac4b7608" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},2,\\frac{3}{2})" :db/id #edb/ref 17592186386213} {:answer/id #uuid "9c4cba98-e6c0-555c-bc7b-6913f3a30edc" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},1,2)" :db/id #edb/ref 17592186386214}] :answer-field/correct {:answer/id #uuid "77e62bec-0cf5-551e-b383-1259ac4b7608" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},2,\\frac{3}{2})" :db/id #edb/ref 17592186386213} :answer-field/id #uuid "91ddfbd1-841e-51b1-877e-8ac9707a99bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386209}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07fb4921-40f8-5824-a33d-670a56b983f3" :question/math-academy-id "q-106129" :question/problem "Find a point that satisfies the mean value theorem for $f(x,y,z)={x}^{2}-{y}^{2}$ on the line segment $\\overset{―}{AB},$ where the position vectors of $A$ and $B$ are $a=⟨-1,0,3⟩$ and $b=⟨0,4,0⟩,$ respectively." :question/worked-solution "The mean value theorem states that if $f(x,y,z)$ is differentiable at each point on the line segment $\\overset{―}{AB},$ then there exists a point $C\\in \\overset{―}{AB}$ with position vector $c$ such that\n\n$$\nf(b)-f(a)=∇f(c)·(b-a).\n$$\n\nNotice that $f(x,y,z)={x}^{2}-{y}^{2}$ is differentiable at each point on the line segment $\\overset{―}{AB}.$ So, we can apply the mean value theorem.\n\nSubstituting $a=⟨-1,0,3⟩$ and $b=⟨0,4,0⟩$ into the above expression, we get\n\n$$\n\\begin{aligned}f(0,4,0)-f(-1,0,3) & =∇f(c)\\cdot (⟨0,4,0⟩-⟨-1,0,3⟩) \\\\ -16-1 & =∇f(c)\\cdot ⟨1,4,-3⟩ \\\\ -17 & =∇f(c)\\cdot ⟨1,4,-3⟩.\\end{aligned}\n$$\n\nComputing $∇f$ and evaluating at $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩,$ we get \n\n$$\n\\begin{aligned}∇f & =⟨2x,-2y,0⟩ \\\\ ∇f(c) & =⟨2{c}_{1},-2{c}_{2},0⟩.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}-17 & =∇f(c)\\cdot ⟨1,4,-3⟩ \\\\ -17 & =⟨2{c}_{1},-2{c}_{2},0⟩\\cdot ⟨1,4,-3⟩ \\\\ -17 & =2{c}_{1}-8{c}_{2}.\\end{aligned}\n$$\n\nNow, we use the fact that $C$ lies on $\\overset{―}{AB}.$ So, let's first find the equation of the line.\n\n$$\n\\begin{aligned}\\frac{x-(-1)}{1} & =\\frac{y-0}{4}=\\frac{z-3}{(-3)} \\\\ x+1 & =\\frac{y}{4}=\\frac{3-z}{3}\\end{aligned}\n$$\n\nParametrizing the line, we get\n\n$$\nx=t-1,\\,y=4t,\\,z=3-3t,\\,0\\le t\\le 1.\n$$\n\nSince $c=⟨{c}_{1},{c}_{2},{c}_{3}⟩$ satisfies the equation of the line, we have\n\n$$\n{c}_{1}=t-1,\\,{c}_{2}=4t,\\,{c}_{3}=3-3t.\n$$\n\nSubstituting the above in the equation $2{c}_{1}-8{c}_{2}=-17,$ we get\n\n$$\n\\begin{aligned}2(t-1)-8(4t) & =-17 \\\\ 2t-2-32t & =-17 \\\\ -30t & =-15 \\\\ t & =\\frac{1}{2}.\\end{aligned}\n$$\n\nWe can now find the values of ${c}_{1},$ ${c}_{2},$ and ${c}_{3}.$ This gives\n\n$$\n\\begin{aligned}{c}_{1} & =\\frac{1}{2}-1=-\\frac{1}{2}, \\\\ {c}_{2} & =4(\\frac{1}{2})=2, \\\\ {c}_{3} & =3-3(\\frac{1}{2})=\\frac{3}{2}.\\end{aligned}\n$$\n\nFinally, the coordinates of $C$ are $(-\\frac{1}{2},2,\\frac{3}{2}).$"}] [{:db/id #edb/ref 17592186386215 :knowledge-point/_questions [{:knowledge-point/id #uuid "95a32907-8304-5dfd-8759-9e91503445bf" :knowledge-point/title "Finding the Reduced Row Echelon Form of a 3x3 System That Is Not in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b3b2c8-1875-5ab9-aaa3-fcacf79355a2" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & -10 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & -5\\end{aligned}]" :db/id #edb/ref 17592186386217} {:answer/id #uuid "31a36f8a-24f9-582e-8d05-6f19609049aa" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 7 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & -10\\end{aligned}]" :db/id #edb/ref 17592186386218} {:answer/id #uuid "30e06f22-4dfc-5c35-9ab3-22b4a788b152" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 7 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & -\\frac{5}{2}\\end{aligned}]" :db/id #edb/ref 17592186386219} {:answer/id #uuid "8d23b3a2-51f3-559c-8780-cb5f165b7c3a" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 7 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & -10\\end{aligned}]" :db/id #edb/ref 17592186386220} {:answer/id #uuid "d0e49134-842d-5699-a7fd-880063b5cbea" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 7 \\\\ 0 & 1 & 0 & -\\frac{5}{2} \\\\ 0 & 0 & 1 & -5\\end{aligned}]" :db/id #edb/ref 17592186386221}] :answer-field/correct {:answer/id #uuid "31a36f8a-24f9-582e-8d05-6f19609049aa" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 7 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & -10\\end{aligned}]" :db/id #edb/ref 17592186386218} :answer-field/id #uuid "68117413-b3bb-5cbf-ae42-370c91b38eeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386216}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "50cdfa2b-7bac-52db-b6f8-8c3fe56ed9ab" :question/math-academy-id "q-10644" :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & 3x+4y-z=11 \\\\  & x+y=2 \\\\  & 2x+2y+z=-6\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & 4 & -1 & 11 \\\\ 1 & 1 & 0 & 2 \\\\ 2 & 2 & 1 & -6\\end{aligned}].\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & 4 & -1 & 11 \\\\ 1 & 1 & 0 & 2 \\\\ 2 & 2 & 1 & -6\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & 2 \\\\ 3 & 4 & -1 & 11 \\\\ 2 & 2 & 1 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & 2 \\\\ 0 & 1 & -1 & 5 \\\\ 2 & 2 & 1 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & 2 \\\\ 0 & 1 & -1 & 5 \\\\ 0 & 0 & 1 & -10\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & 2 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & -10\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 7 \\\\ 0 & 1 & 0 & -5 \\\\ 0 & 0 & 1 & -10\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124769 :knowledge-point/_questions [{:knowledge-point/id #uuid "ade69467-c229-509d-9bdc-b28935b2d1d8" :knowledge-point/title "Identifying Inhibited Growth Equations and Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd57bce4-bf4d-5488-ada6-93439471fb78" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dt} = 5y^{2} - 400" :db/id #edb/ref 17592186121182} {:answer/id #uuid "1f00b80a-9440-52ad-bb3e-9a6954010114" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dt} = 5 - 400y" :db/id #edb/ref 17592186121183} {:answer/id #uuid "34a003e9-7090-500a-bcd5-5a07bde1c2a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dt} = 400 - 5y" :db/id #edb/ref 17592186121184} {:answer/id #uuid "35a91da3-7b8e-54e8-8314-4340d804eddd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dt} = 5y - 400" :db/id #edb/ref 17592186121185} {:answer/id #uuid "6623a9f2-ffe7-561f-9984-2a59cbb33aa2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dt} = 400 - 5y^{2}" :db/id #edb/ref 17592186121186}] :answer-field/id #uuid "b4164cc7-8b43-5b53-b800-89f7a6270478" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121181}] :question/id #uuid "092a8c01-7fc1-532c-ba20-9cb4c823a717" :question/math-academy-id "q-106662" :question/problem "Given that $y < 80$ and $t \\ge 0$, which of the following is an inhibited growth equation?"}] [{:db/id #edb/ref 17592186243924 :knowledge-point/_questions [{:knowledge-point/id #uuid "0dfdda62-1838-540f-bf4d-960353fc3706" :knowledge-point/title "Parametrizing Part of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fa6f538-5b7a-5042-9858-1605e37b9f1a" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in [-\\pi ,-\\frac{\\pi }{2})\\cup (\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186241759} {:answer/id #uuid "5799da70-e5d8-5f02-95c5-12e519a9749f" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in [-\\pi ,\\pi ],\\,t\\ne \\pm \\frac{\\pi }{2}" :db/id #edb/ref 17592186241981} {:answer/id #uuid "e95eacb8-60d5-53b1-b97e-9f45c6a5c553" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in [-\\pi ,\\pi ],\\,t\\ne 0" :db/id #edb/ref 17592186243247} {:answer/id #uuid "f5e1df50-cabb-582e-9632-1703ac13e8d1" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})" :db/id #edb/ref 17592186243360} {:answer/id #uuid "f66dc61f-60f6-57e2-87af-77dc8002f9a4" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in [0,\\pi ],\\,t\\ne \\frac{\\pi }{2}" :db/id #edb/ref 17592186243366}] :answer-field/correct {:answer/id #uuid "f5e1df50-cabb-582e-9632-1703ac13e8d1" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})" :db/id #edb/ref 17592186243360} :answer-field/id #uuid "91ea0bb9-13a3-5bf4-a5e4-cc755e003f6f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9421f991-1b84-5607-8912-60b61e3c03d4" :question/math-academy-id "q-106685" :question/problem "![](images/32/32375f839dd0f51a8624bebda732d7413130c940045db7e5a1a9fce3576e91b6.png)\n\nOne branch of a hyperbola (shown above) is defined by the parametric equations\n\n$$\nx=3\\operatorname{tan}⁡t,\\,y=6\\operatorname{sec}⁡t.\n$$\n\nWhat is the domain of the parameter $t?$" :question/worked-solution "The parametric equations of the full hyperbola are\n\n$$\nx=3\\operatorname{tan}⁡t,\\,y=6\\operatorname{sec}⁡t,\\,t\\in [-\\pi ,\\pi ],\\,t\\ne \\pm \\frac{\\pi }{2}.\n$$\n\nTo restrict the parameterization to a single branch, we refer to the diagram below.\n\n![](images/d4/d44195c764b2943c3d5b5e0d91ee770011c951d7a825f0c5cc4d1f38cedbb709.png)\n\nWe can see that if we restrict $t$ to $(-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ we get only the upper branch.\n\nTherefore, the parametric equations that describe only the upper branch are\n\n$$\nx=3\\operatorname{tan}⁡t,\\,y=6\\operatorname{sec}⁡t,\\,t\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).\n$$"}] [{:db/id #edb/ref 17592186386222 :knowledge-point/_questions [{:knowledge-point/id #uuid "7f58ec96-53b3-5317-9801-c730728f32c6" :knowledge-point/title "Finding the Contrapositive of a Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9f082e4-7f1c-5131-99cb-e8b90e7676e0" :answer/type {:db/ident :answer.type/text} :answer/value "If the sky is clear, then you need an umbrella." :db/id #edb/ref 17592186386224} {:answer/id #uuid "812aada8-fffc-5236-a598-da60ab4fcfbe" :answer/type {:db/ident :answer.type/text} :answer/value "If the sky is not clear, then you do not need an umbrella." :db/id #edb/ref 17592186386225} {:answer/id #uuid "daa344f6-a62f-5078-a601-6e2eaa7e97f6" :answer/type {:db/ident :answer.type/text} :answer/value "If you do not need an umbrella, then the sky is clear." :db/id #edb/ref 17592186386226} {:answer/id #uuid "ff4d6449-557e-56ab-974a-c4c69d02f6df" :answer/type {:db/ident :answer.type/text} :answer/value "If the sky is not clear, then you need an umbrella." :db/id #edb/ref 17592186386227} {:answer/id #uuid "b0a0da35-8169-5e6f-999a-2b4ab03884e1" :answer/type {:db/ident :answer.type/text} :answer/value "If the sky is clear, then you do not need an umbrella." :db/id #edb/ref 17592186386228}] :answer-field/correct {:answer/id #uuid "b0a0da35-8169-5e6f-999a-2b4ab03884e1" :answer/type {:db/ident :answer.type/text} :answer/value "If the sky is clear, then you do not need an umbrella." :db/id #edb/ref 17592186386228} :answer-field/id #uuid "fccc8e9c-fc14-5acc-9147-28bedf97e236" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "182be56c-2979-5dc4-be23-87137c8dac9b" :question/math-academy-id "q-106794" :question/problem "Find the contrapositive of the following statement:\n\n$\\,$ **If** you need an umbrella, **then** the sky is not clear." :question/worked-solution "In our conditional statement: \n\n- The antecedent is $A:$ You need an umbrella.\n\n- The consequent is $B:$ The sky is not clear.\n\nThe contrapositive of a conditional statement $A⇒B$ is given by \n\n$$\n¬B⇒¬A.\n$$\n\nFirst, we write down the negations of $A$ and $B:$\n\n- $¬A:$ You do not need an umbrella.\n\n- $¬B:$ The sky is clear.\n\nTherefore, the contrapositive is the following: \n\n$\\,$ If the sky is clear, then you do not need an umbrella."}] [{:db/id #edb/ref 17592186106033 :knowledge-point/_questions [{:knowledge-point/id #uuid "f2f6a868-46fe-5529-a464-b6f3e0243d30" :knowledge-point/title "Identifying a Singular 3x3 System of Equations That Has No Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e34055ef-725e-5c56-88d0-ca98ee1bd845" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & 2 & 2 \\\\ 0 & 0 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186386230} {:answer/id #uuid "8ef2d450-ab51-525c-aa55-da0a6f9ac6ba" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 0 & -25\\end{aligned}]" :db/id #edb/ref 17592186386231} {:answer/id #uuid "f09c0cc7-72c0-5239-9e43-40b952099e41" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & 4 & 5 \\\\ 0 & 0 & 0 & -3\\end{aligned}]" :db/id #edb/ref 17592186386232} {:answer/id #uuid "e74e7e5c-cf0d-59bc-add5-40647a04b0e9" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 4 & 3 \\\\ 0 & 1 & 2 & 1 \\\\ 0 & 0 & 0 & 13\\end{aligned}]" :db/id #edb/ref 17592186386233} {:answer/id #uuid "c4564ce1-09d3-5508-b26b-115ede26d625" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 0 & -5\\end{aligned}]" :db/id #edb/ref 17592186386234}] :answer-field/correct {:answer/id #uuid "8ef2d450-ab51-525c-aa55-da0a6f9ac6ba" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 0 & -25\\end{aligned}]" :db/id #edb/ref 17592186386231} :answer-field/id #uuid "10720b33-9805-5006-abc5-e3c7f00cc14a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "112f0f25-38f3-5ec1-a0f6-3a87947c53d9" :question/math-academy-id "q-10680" :question/problem "Consider the system\n\n$$\n{\\begin{aligned}2x+6y+8z=12 \\\\ y-z=-1 \\\\ 4x+4y+24z=7.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for the system is\n\n$$\nM=[\\begin{aligned}2 & 6 & 8 & 12 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 4 & 24 & 7\\end{aligned}].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & 6 & 8 & 12 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 4 & 24 & 7\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 4 & 4 & 24 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & -8 & 8 & -17\\end{aligned}] & {R}_{3} & :={R}_{3}+8{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & 6 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 0 & -25\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386235 :knowledge-point/_questions [{:knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd35dae-4b0c-5adc-8bc4-a22cb37c512c" :answer/type {:db/ident :answer.type/image} :answer/value "images/a3/a3abd0ff1603a63a670252580ba7edb900b61e669aa12691ca912183c28899ea.png" :db/id #edb/ref 17592186386237} {:answer/id #uuid "8e249e6a-38e6-53b3-a3c0-63a0fa0ffcee" :answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e38721ff6fe7b75bef46079d0c877333a0113cbc782a12f61e09b832200943a.png" :db/id #edb/ref 17592186386238} {:answer/id #uuid "e5496c89-7d79-50b2-a456-45ec2257e5ff" :answer/type {:db/ident :answer.type/image} :answer/value "images/e4/e4ec74d60e6fdec5dec663ec4fe8f80ad9408817aa34afad916672a5221cdfad.png" :db/id #edb/ref 17592186386239} {:answer/id #uuid "a69b8d1f-f466-5e97-aedb-fe58ec99359b" :answer/type {:db/ident :answer.type/image} :answer/value "images/c5/c59aa1f83fb6808cb6ea5ea2905c120b4b6c2af3a4e3850dc20d7f550f0259eb.png" :db/id #edb/ref 17592186386240} {:answer/id #uuid "0f0fd56c-77d4-5a5e-81bc-85e9e915b29a" :answer/type {:db/ident :answer.type/image} :answer/value "images/ae/aeb84eb023dcc22cc0a7b7713c5a78f76ba5469cd147471c99af6197d7806c30.png" :db/id #edb/ref 17592186386241}] :answer-field/correct {:answer/id #uuid "8e249e6a-38e6-53b3-a3c0-63a0fa0ffcee" :answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e38721ff6fe7b75bef46079d0c877333a0113cbc782a12f61e09b832200943a.png" :db/id #edb/ref 17592186386238} :answer-field/id #uuid "a20634f9-ffc3-50e6-810c-2409763e9ea9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386236}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f38fa3e-b402-5304-8378-88160f430aba" :question/math-academy-id "q-106886" :question/problem "![](images/59/59bb15a433f4f9299a240fd0c4d03797425994a0aa17d69fa81cf92e6f99cabc.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $B$ corresponding to the eigenvalue $\\frac{1}{2}.$ Find the vector $Bu.$" :question/worked-solution "The eigenvector $u=[\\begin{aligned}4 \\\\ 4\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =\\frac{1}{2}.$ So, \n\n$$\n\\begin{aligned}Bu & =\\frac{1}{2}u.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/0e/0e38721ff6fe7b75bef46079d0c877333a0113cbc782a12f61e09b832200943a.png)"}] [{:db/id #edb/ref 17592186386242 :knowledge-point/_questions [{:knowledge-point/id #uuid "8946f811-40c4-5a19-a867-576c42364f15" :knowledge-point/title "Writing Biconditionals as Conditionals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ccbd211-37f6-5588-be49-c9e6a5031747" :answer/type {:db/ident :answer.type/math} :answer/value "(Y∧X)⇒X" :db/id #edb/ref 17592186386244} {:answer/id #uuid "9a0c790e-5138-5350-8530-9f64b2b10d84" :answer/type {:db/ident :answer.type/math} :answer/value "(Y∧X)⇒¬X" :db/id #edb/ref 17592186386245} {:answer/id #uuid "3a965b62-601e-504b-b13a-33899cd8dcb6" :answer/type {:db/ident :answer.type/math} :answer/value "X⇒(Y∧X)" :db/id #edb/ref 17592186386246} {:answer/id #uuid "d0553cb0-ae4a-5751-895c-c22bd8bbac88" :answer/type {:db/ident :answer.type/math} :answer/value "¬X⇒¬(Y∧X)" :db/id #edb/ref 17592186386247} {:answer/id #uuid "44f3dc52-dd9b-54d3-ad2b-d8147943ff3f" :answer/type {:db/ident :answer.type/math} :answer/value "¬(Y∧X)⇒X" :db/id #edb/ref 17592186386248}] :answer-field/correct {:answer/id #uuid "3a965b62-601e-504b-b13a-33899cd8dcb6" :answer/type {:db/ident :answer.type/math} :answer/value "X⇒(Y∧X)" :db/id #edb/ref 17592186386246} :answer-field/id #uuid "ce2c47b3-4b13-5c76-8281-129d53bb3449" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6c38706-4f46-5161-b20e-9e3f5bc9521e" :question/math-academy-id "q-107160" :question/problem "$$\nX⇔(Y∧X)≡∧[(Y∧X)⇒X]\n$$\n\nWhat expression should be inserted into the blank space above to give logically equivalent statements?" :question/worked-solution "According to the definition of the biconditional, \n\n- $A⇔B$ is true if $A⇒B$ **and** $B⇒A.$ Otherwise, it is false.\n\n- In other words, $A⇔B$ is true if $A$ and $B$ have the same truth values. Otherwise, it is false.\n\nSo, in this case, we have\n\n$$\nX⇔(Y∧X)≡[\\,X⇒(Y∧X)]∧[(Y∧X)⇒X].\n$$\n\nTherefore, the missing part is $X⇒(Y∧X).$"}] [{:db/id #edb/ref 17592186386249 :knowledge-point/_questions [{:knowledge-point/id #uuid "d491b223-3526-5db0-93d1-6b08c1f7b7b5" :knowledge-point/title "Calculating an Eigenvector Corresponding to an Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7b5a780-a9e5-50cc-9005-b16227f04495" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 40\\end{aligned}]" :db/id #edb/ref 17592186386251} {:answer/id #uuid "fbed1d49-76eb-5edb-b963-b6db5cccb4a3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ -5\\end{aligned}]" :db/id #edb/ref 17592186386252} {:answer/id #uuid "be7040c1-8942-5754-b32f-af9f21ad5f4e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186386253} {:answer/id #uuid "c2e8402e-8e93-56a7-b73d-fa831f43d89d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186386254} {:answer/id #uuid "5bf8af6a-c26a-5543-95a8-998fa875785b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 25\\end{aligned}]" :db/id #edb/ref 17592186386255}] :answer-field/correct {:answer/id #uuid "c2e8402e-8e93-56a7-b73d-fa831f43d89d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186386254} :answer-field/id #uuid "e8004795-4ea2-52b9-a76e-527c374e5954" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5d9e801-eca8-5d4b-8b13-1bb066d0bb23" :question/math-academy-id "q-107273" :question/problem "Find an eigenvector of $A=[\\begin{aligned}22 & -40 \\\\ -5 & 5\\end{aligned}]$ that corresponds to the eigenvalue $\\lambda =-3.$" :question/worked-solution "To compute the eigenvectors of a matrix, we need to find non-zero solutions of the matrix equation \n\n$$\n(A-\\lambda I)\\text{x}=0.\n$$\n\n \n\nIn our case, we have $\\,\\lambda =-3.$ So, we get \n\n$$\n\\begin{aligned}A-\\lambda I & =[\\begin{aligned}22 & -40 \\\\ -5 & 5\\end{aligned}]-(-3)[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}25 & -40 \\\\ -5 & 8\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the homogeneous system of linear equations\n\n$$\n{\\begin{aligned}25{x}_{1}-40{x}_{2}=0 \\\\ -5{x}_{1}+8{x}_{2}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}25 & -40 \\\\ -5 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}25 & -40 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, there is one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. \n\nFrom the first equation, we obtain \n\n$$\n25{x}_{1}-40{x}_{2}=0\\,⟹\\,{x}_{1}=\\frac{8}{5}{x}_{2}.\n$$\n\nHence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{8}{5}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nFinally, setting ${x}_{2}=5,$ we get the eigenvector \n\n$$\nv=[\\begin{aligned}8 \\\\ 5\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386256 :knowledge-point/_questions [{:knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "769304c9-536f-5bee-ad3f-bfee22337ef1" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\sqrt{2}+\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186386258} {:answer/id #uuid "9d261cb9-dabf-53f3-b9e1-0752b9983369" :answer/type {:db/ident :answer.type/math} :answer/value "z=-1+\\text{i}" :db/id #edb/ref 17592186386259} {:answer/id #uuid "1ab818a5-54de-587e-b8d4-5ad252d7561d" :answer/type {:db/ident :answer.type/math} :answer/value "z=1+\\text{i}" :db/id #edb/ref 17592186386260} {:answer/id #uuid "713083e0-6e29-5103-b88f-240c9a29bb2e" :answer/type {:db/ident :answer.type/math} :answer/value "z=-1-\\sqrt{2}\\,\\text{i}" :db/id #edb/ref 17592186386261} {:answer/id #uuid "80290119-b3e9-5290-a6fd-17312d831faa" :answer/type {:db/ident :answer.type/math} :answer/value "z=1-\\text{i}" :db/id #edb/ref 17592186386262}] :answer-field/correct {:answer/id #uuid "9d261cb9-dabf-53f3-b9e1-0752b9983369" :answer/type {:db/ident :answer.type/math} :answer/value "z=-1+\\text{i}" :db/id #edb/ref 17592186386259} :answer-field/id #uuid "95ae8fbb-49b5-5680-9cdb-3e54b97c6d37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386257}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02d6fd52-a861-5d95-bf24-0c758b7ad072" :question/math-academy-id "q-107551" :question/problem "Express $z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nFirst, we find $\\operatorname{cos}⁡(\\frac{3\\pi }{4})$ and $\\operatorname{sin}⁡(\\frac{3\\pi }{4}):$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =-\\frac{\\sqrt{2}}{2}\\,,\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\frac{3\\pi }{4}) & =\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\frac{\\sqrt{2}}{2}\\,.\\end{aligned}\n$$\n\nNow, we substitute the values and expand the parentheses:\n\n$$\n\\begin{aligned}z & =\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4})) \\\\  & =\\sqrt{2}(-\\frac{\\sqrt{2}}{2}+\\text{i}\\frac{\\sqrt{2}}{2}) \\\\  & =-1+\\text{i}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386263 :knowledge-point/_questions [{:knowledge-point/id #uuid "519551d3-7e3a-567f-a06e-b74bcf04316e" :knowledge-point/title "Simplifying Expressions Involving Tautologies and Contradictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ed4ecea-15f5-579d-898c-c643418469a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{c}" :db/id #edb/ref 17592186386265} {:answer/id #uuid "94142911-1105-539e-b373-1c6d5d7bbdbb" :answer/type {:db/ident :answer.type/math} :answer/value "A∨B" :db/id #edb/ref 17592186386266} {:answer/id #uuid "0629a77c-2e23-5960-b291-0d389d3171ae" :answer/type {:db/ident :answer.type/math} :answer/value "¬B" :db/id #edb/ref 17592186386267} {:answer/id #uuid "9cd1e9f0-e85f-5dee-a780-1811ee4e004e" :answer/type {:db/ident :answer.type/math} :answer/value "A∧B" :db/id #edb/ref 17592186386268} {:answer/id #uuid "875e6ed0-6a58-554c-afaf-cba07d0ca15b" :answer/type {:db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186386269}] :answer-field/correct {:answer/id #uuid "9cd1e9f0-e85f-5dee-a780-1811ee4e004e" :answer/type {:db/ident :answer.type/math} :answer/value "A∧B" :db/id #edb/ref 17592186386268} :answer-field/id #uuid "514b2551-99d3-5459-b5ba-442ac38efc07" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7e3f464-08a5-53a9-a5e4-bec01f1a2517" :question/math-academy-id "q-107594" :question/problem "Simplify the expression $A∧(A⇒B).$" :question/worked-solution "Let's simplify the expression using the properties of logical operation\n\n- First, we use that $X⇒Y≡¬X∨Y:$\n\n$$\nA∧(A⇒B)≡A∧(¬A∨B)\n$$\n\n- Then, we use the distributive law (disjunction over conjunction):\n\n$$\nA∧(¬A∨B)≡(A∧¬A)∨(A∧B)\n$$\n\n- Next,  we use the fact that the conjunction of a statement and its negation is a contradiction:\n\n$$\n(A∧¬A)∨(A∧B)≡c∨(A∧B)\n$$\n\n- Finally, we use the fact that the disjunction of a statement and a contradiction equals the original statement:\n\n$$\nc∨(A∧B)≡(A∧B)\n$$\n\nTherefore, we conclude that\n\n$$\nA∧(A⇒B)≡A∧B\n$$"}] [{:db/id #edb/ref 17592186176228 :knowledge-point/_questions [{:knowledge-point/id #uuid "d600416b-05f5-593f-a2ad-bb3a08d60b45" :knowledge-point/title "Reducing an Inhomogeneous ODE to First-Order System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dd1acb3-3017-58b0-aedf-2b524efc95c8" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}+\\sqrt{t}\\,{x}_{3}+{t}^{2}" :db/id #edb/ref 17592186386271} {:answer/id #uuid "bb743002-0796-5bcd-80b9-1c26a0cf9332" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}_{1}-\\sqrt{t}\\,{x}_{3}-{t}^{2}" :db/id #edb/ref 17592186386272} {:answer/id #uuid "2225e3a5-0cea-50f6-8f8c-dedc996557ac" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{t}\\,{x}_{2}-{x}_{3}+{t}^{2}" :db/id #edb/ref 17592186386273} {:answer/id #uuid "9345a4ac-b5f7-5511-b5ee-13755697b904" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}-\\sqrt{t}\\,{x}_{2}+{t}^{2}" :db/id #edb/ref 17592186386274} {:answer/id #uuid "704291a6-d753-589f-8115-9dd2a4e43b01" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{t}\\,{x}_{2}+{x}_{3}+{t}^{2}" :db/id #edb/ref 17592186386275}] :answer-field/correct {:answer/id #uuid "3dd1acb3-3017-58b0-aedf-2b524efc95c8" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}+\\sqrt{t}\\,{x}_{3}+{t}^{2}" :db/id #edb/ref 17592186386271} :answer-field/id #uuid "d0fea43f-c61c-5cb8-bac4-dc445bc9f623" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd48b46d-ec29-5080-9e57-ded7b691472a" :question/math-academy-id "q-107932" :question/problem "The third-order differential equation \n\n$$\n{y}^{‴}-\\sqrt{t}\\,{y}^{″}-y={t}^{2}\n$$\n\ncan be written as a system of first-order differential equations, as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}={x}_{3} \\\\ {x}_{3}^{′}=f(t)\\end{aligned}\n$$\n\nwhere ${x}_{1}(t)=y(t),$ ${x}_{2}(t)={y}^{′}(t)$ and ${x}_{3}(t)={y}^{″}(t).$ Find the function $f(t).$" :question/worked-solution "First, we make the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1}(t) & =y \\\\ {x}_{2}(t) & ={y}^{′} \\\\ {x}_{3}(t) & ={y}^{″}\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′}(t) & ={y}^{′} \\\\ {x}_{2}^{′}(t) & ={y}^{″} \\\\ {x}_{3}^{′}(t) & ={y}^{‴}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={x}_{3}, \\\\ {x}_{3}^{′}={y}^{‴}.\\end{aligned}\n$$\n\nAt this point, we're almost done. We just need to write the right-hand side of the last equation in terms of ${x}_{1},$ ${x}_{2},$ and ${x}_{3}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{‴}),$ we obtain\n\n$$\n{y}^{‴}=\\sqrt{t}\\,{y}^{″}+y+{t}^{2}.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{‴}=\\sqrt{t}\\,{x}_{3}+{x}_{1}+{t}^{2}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={x}_{3}, \\\\ {x}_{3}^{′}={x}_{1}+\\sqrt{t}\\,{x}_{3}+{t}^{2}.\\end{aligned}\n$$\n\nFinally,\n\n$$\nf(t)={x}_{1}+\\sqrt{t}\\,{x}_{3}+{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186167071 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7657ff9-3918-5080-b9a2-8f6a6d8b4fd9" :knowledge-point/title "Writing a Homogeneous ODE as a Matrix Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e5a1678-5a7d-5725-8973-e3c1d232b084" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186386277} {:answer/id #uuid "1034a93f-727b-5578-8183-8c9c135aa0f3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 2 & 0\\end{aligned}]" :db/id #edb/ref 17592186386278} {:answer/id #uuid "1c361cdb-da53-5fdf-a4ab-0587cb076ab8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186386279} {:answer/id #uuid "8f6ac929-775e-56f7-903b-d6377ad33c5c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186386280} {:answer/id #uuid "82fae9f5-b859-59d7-9548-00d3ace9b734" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186386281}] :answer-field/correct {:answer/id #uuid "3e5a1678-5a7d-5725-8973-e3c1d232b084" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}]" :db/id #edb/ref 17592186386277} :answer-field/id #uuid "a046f176-fef1-5124-a21d-94e381aeefd8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386276}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6028a3d5-97f7-5eca-bdb0-193599d89649" :question/math-academy-id "q-107937" :question/problem "The second-order differential equation ${y}^{″}-2{y}^{′}+y=0$\ncan be expressed as the matrix equation ${x}^{′}(t)=Ax(t),$ where \n\n$$\nx(t)=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\\,A=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\\,y(t)={x}_{1}(t),\\,{y}^{′}(t)={x}_{2}(t).\n$$\n\nFind the matrix $A.$" :question/worked-solution "We first need to express the given differential equation as a system of first-order differential equations. Then, we write the system as a matrix equation.\n\nWe start by making the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1} & =y \\\\ {x}_{2} & ={y}^{′}\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′} & ={y}^{′} \\\\ {x}_{2}^{′} & ={y}^{″}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={y}^{″}.\\end{aligned}\n$$\n\nWe must now write the right-hand side of the last equation in terms of ${x}_{1}$ and ${x}_{2}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{″}),$ we obtain\n\n$$\n{y}^{″}=2{y}^{′}-y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{″}=2{x}_{2}-{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}=-{x}_{1}+2{x}_{2}\\end{aligned}\n$$\n\nWe can represent this system as the matrix differential equation ${x}^{′}(t)=Ax(t)$ as follows:\n\n$$\n[\\begin{aligned}{x}_{1}^{′} \\\\ {x}_{2}^{′}\\end{aligned}]=[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nHence, $A=[\\begin{aligned}0 & 1 \\\\ -1 & 2\\end{aligned}].$"}] [{:db/id #edb/ref 17592186167072 :knowledge-point/_questions [{:knowledge-point/id #uuid "82820104-bd75-549b-84e9-d225a7f4616b" :knowledge-point/title "Reducing a Homogeneous ODE to a First-Order System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac8265a0-2733-5899-a3ef-cae93083b1b8" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}-4{x}_{2}" :db/id #edb/ref 17592186386283} {:answer/id #uuid "405c2ec4-28b4-5b3a-8f69-452f5ab613ed" :answer/type {:db/ident :answer.type/math} :answer/value "-4{x}_{1}+{x}_{2}" :db/id #edb/ref 17592186386284} {:answer/id #uuid "8ad477e7-35ec-52ad-a643-b9e71aa00488" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}_{1}+4{x}_{2}" :db/id #edb/ref 17592186386285} {:answer/id #uuid "794b1bb5-7a5c-52c5-917b-fa571d856cd7" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}_{1}+{x}_{2}" :db/id #edb/ref 17592186386286} {:answer/id #uuid "360e1588-c735-51a9-b830-3e215a478e75" :answer/type {:db/ident :answer.type/math} :answer/value "{x}_{1}+4{x}_{2}" :db/id #edb/ref 17592186386287}] :answer-field/correct {:answer/id #uuid "794b1bb5-7a5c-52c5-917b-fa571d856cd7" :answer/type {:db/ident :answer.type/math} :answer/value "4{x}_{1}+{x}_{2}" :db/id #edb/ref 17592186386286} :answer-field/id #uuid "05ce6a8d-004c-5493-be53-6d073ce73e36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386282}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eb13409-d286-58a4-ad16-4bf917750564" :question/math-academy-id "q-107950" :question/problem "The second-order differential equation \n\n$$\n{y}^{″}-{y}^{′}-4y=0\n$$\n\ncan be written as a system of first-order differential equations, as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}=f(t)\\end{aligned}\n$$\n\nwhere ${x}_{1}(t)=y(t)$ and ${x}_{2}(t)={y}^{′}(t).$ Find the function $f(t).$" :question/worked-solution "First, we make the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1} & =y \\\\ {x}_{2} & ={y}^{′}\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′} & ={y}^{′} \\\\ {x}_{2}^{′} & ={y}^{″}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={y}^{″}.\\end{aligned}\n$$\n\nAt this point, we're almost done. We just need to write the right-hand side of the last equation in terms of ${x}_{1}$ and ${x}_{2}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{″}),$ we obtain\n\n$$\n{y}^{″}={y}^{′}+4y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{″}={x}_{2}+4{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}=4{x}_{1}+{x}_{2}\\end{aligned}\n$$\n\nFinally, $f(t)=4{x}_{1}+{x}_{2}.$"}] [{:db/id #edb/ref 17592186386288 :knowledge-point/_questions [{:knowledge-point/id #uuid "88580aff-e043-58ea-a8ca-1ce32026428f" :knowledge-point/title "Constructing the Speed-Time Graph for a Real-Life Scenario"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085fe59d-4891-5783-a3dc-e512a6c66398" :answer/type {:db/ident :answer.type/image} :answer/value "images/17/170dea566e8c74e1c3df3c087c6565c85dd03c0703c4dbec1be594ca653c6aa1.png" :db/id #edb/ref 17592186386290} {:answer/id #uuid "39a73eee-b69a-5a6a-a85b-7c1d22da0949" :answer/type {:db/ident :answer.type/image} :answer/value "images/0c/0c89f7f469830ff7c505d22677f6ea612f1fff396c73aba325b4e87f6f61ae42.png" :db/id #edb/ref 17592186386291} {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386292} {:answer/id #uuid "d191d1ef-4285-5a17-92b3-a9aefa6e1e2c" :answer/type {:db/ident :answer.type/image} :answer/value "images/12/1280bba15fdb6ada20f6d6f2ea4cfeeb39e9366939d72a06059062cc2abedc8d.png" :db/id #edb/ref 17592186386293} {:answer/id #uuid "3cdbb3a8-0531-5672-b68a-760d458dd965" :answer/type {:db/ident :answer.type/image} :answer/value "images/8d/8dd2eefb2c2397f10d4c07853ef819b8682e448824bf6e26302d4a16bc02183c.png" :db/id #edb/ref 17592186386294}] :answer-field/correct {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386292} :answer-field/id #uuid "c342a9a6-0c8f-53d9-8bfc-52d1954443be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386289}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e2fe401-8d6a-539f-989f-5022eb0fe1eb" :question/math-academy-id "q-108567" :question/problem "A particle accelerates from rest with a constant acceleration of $1\\,{\\text{km/h}}^{2}$ for the first $3$ hours of its motion. It then travels at a constant speed for the next $3$ hours before accelerating with a constant acceleration of $0.5\\,{\\text{km/h}}^{2}$ for other $3$ hours. Which graph represents the described motion?" :question/worked-solution "We start the first line from the point $(0,0),$ since the particle starts from rest. Then, because the acceleration is $1\\,{\\text{km/h}}^{2},$ we draw a line with slope $1.$ \n\nHowever, because the particle is only accelerating for the first $3$ hours, we stop the line at $t=3.$ At this time, the particle's speed has increased by $1\\cdot 3=3\\,\\text{km/h}.$ So, the first line segment goes from $(0,0)$ to $(3,3).$\n\n![](images/7a/7a9fd32e5705860064e597fcf9308fee457063e060d3adede260f109ca488201.png)\n\nThe particle then travels at a constant speed for the next $3$ hours. So, the speed remains at $3\\,\\text{km/h}$ for the next $3$ hours, until $t=3+3=6.$\n\n![](images/e4/e4c7e47150bf1c205c243c6fa1d0f0e24b7a69f27a8461791d495eb7487cf4f3.png)\n\nAfter $t=3,$ the particle has an acceleration of $0.5\\,{\\text{km/h}}^{2},$ so the slope of the third line segment is $0.5.$ The third line segment stops after $3$ hours. To figure out the velocity at this moment, we need to find the equation for the third line segment.\n\nSince the third line segment passes through the point $(6,3)$ and has a slope of $0.5,$ we can use point-slope form to write the equation of the line:\n\n$$\n\\begin{aligned}v-{v}_{1} & =m(t-{t}_{1}) \\\\ v-3 & =0.5(t-6) \\\\ v-3 & =0.5t-3 \\\\ v & =0.5t\\end{aligned}\n$$\n\nThe third line segment stops when $t=6+3=9$ hours, and the velocity at this moment is\n\n$$\n\\begin{aligned}v & =0.5t \\\\ v & =0.5(9) \\\\ v & =4.5\\end{aligned}\n$$\n\nSo, the third line segment stops at the point $(9,4.5).$ The final graph is\n\n![](images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png)"}] [{:db/id #edb/ref 17592186162261 :knowledge-point/_questions [{:knowledge-point/id #uuid "5371da4f-89c4-530d-8ae7-dd20279b53ba" :knowledge-point/title "Constructing Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c051c9-1983-543b-bedb-dac6c1fe7e82" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386296} {:answer/id #uuid "963e52b0-b4f9-5359-9c81-dbe8c9bd4990" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186386297} {:answer/id #uuid "4921e5a1-be99-5f04-9941-0df31b0b8add" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186386298} {:answer/id #uuid "4aa54289-df38-53db-b295-3a7809476d1e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186386299} {:answer/id #uuid "d1a08320-c51f-5dd7-9d53-6740b2686f18" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 2 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186386300}] :answer-field/correct {:answer/id #uuid "4aa54289-df38-53db-b295-3a7809476d1e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186386299} :answer-field/id #uuid "3c87cef5-4fb2-5ed4-858a-b78c19a01a25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386295}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d37d1388-ba63-5e87-8ec5-3e0a469003ee" :question/math-academy-id "q-108570" :question/problem "${J}_{2}(7)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $2$ in ${J}_{2}(7)$ means that we have a $2\\times 2$ matrix.\n\n- The value $7$ in ${J}_{2}(7)$ means that we have $7$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{2}(1)=[\\begin{aligned}7 & 1 \\\\ 0 & 7\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186176231 :knowledge-point/_questions [{:knowledge-point/id #uuid "65f20482-73ea-5f1c-bb2b-1d7472fbfd4e" :knowledge-point/title "Finding a Jordan Canonical Form of a 2x2 Matrix With Two Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9deac94-910d-5b63-9e57-f2b87ce35388" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 0 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386302} {:answer/id #uuid "1ed1599f-3aad-5db6-88b0-67ffb6cefac0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -4 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386303} {:answer/id #uuid "a98ce391-9389-52eb-9e86-0f61cb9645c9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & 1 \\\\ 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186386304} {:answer/id #uuid "c1239255-deea-5186-b902-2c62a0e4f9b5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186386305} {:answer/id #uuid "77e95aa7-899b-565b-8665-45a05cc48157" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186386306}] :answer-field/correct {:answer/id #uuid "77e95aa7-899b-565b-8665-45a05cc48157" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}]" :db/id #edb/ref 17592186386306} :answer-field/id #uuid "1868ed6f-a38d-5a16-93a8-ed4612cf63a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386301}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7a50741c-c4f5-5a02-bb86-14c9da06d5cf" :question/math-academy-id "q-108719" :question/problem "Find a Jordan canonical form of the matrix \n$A=[\\begin{aligned}6 & 5 \\\\ -10 & -9\\end{aligned}].$" :question/worked-solution "Every $n\\times n$ matrix $A$ can be written in the form\n\n$$\nA=PJ{P}^{-1},\n$$\n\nwhere $J$ is a Jordan canonical form (or Jordan normal form) of $A,$ and $P$ is an invertible matrix. \n\nTo find the matrix $J,$ we first find the eigenvalues of the matrix $A$ by solving $det(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}|\\begin{aligned}6-\\lambda  & 5 \\\\ -10 & -9-\\lambda \\end{aligned}| & =0 \\\\ (6-\\lambda )(-9-\\lambda )-(5)(-10) & =0 \\\\ {\\lambda }^{2}+3\\lambda -4 & =0 \\\\ (\\lambda -1)(\\lambda +4) & =0\\end{aligned}\n$$\n\n \n\nSo, the eigenvalues are ${\\lambda }_{1}=1$ and ${\\lambda }_{2}=-4.$ Since we get two distinct eigenvalues, the matrix $A$ is diagonalizable, and a Jordan canonical form is\n\n$$\nJ={J}_{1}(1)\\,⊕\\,{J}_{1}(-4)=[\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386307 :knowledge-point/_questions [{:knowledge-point/id #uuid "a35df900-489d-5f8e-9d9e-075352035790" :knowledge-point/title "Solving a First-Order ODE Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5958906a-be77-58ea-8770-0123acbc38c6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3y-x-2}" :db/id #edb/ref 17592186386309} {:answer/id #uuid "3f43ecd0-213c-57e5-a5cf-4aef08495b8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{x-3y+2}}{6}" :db/id #edb/ref 17592186386310} {:answer/id #uuid "df466563-da71-5aa3-817c-70f77b71d914" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{3y-x-2}}{3}" :db/id #edb/ref 17592186386311} {:answer/id #uuid "599c105a-3b32-5a45-8ae9-8e36019ec753" :answer/type {:db/ident :answer.type/math} :answer/value "6{e}^{3y-x-2}" :db/id #edb/ref 17592186386312} {:answer/id #uuid "1c5e79ec-9b0f-57c5-b61c-eed685e72c0e" :answer/type {:db/ident :answer.type/math} :answer/value "-3{e}^{x-3y+2}" :db/id #edb/ref 17592186386313}] :answer-field/correct {:answer/id #uuid "5958906a-be77-58ea-8770-0123acbc38c6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3y-x-2}" :db/id #edb/ref 17592186386309} :answer-field/id #uuid "c88fc26c-bcfc-5217-a8b4-a14ca4f272a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be785dc0-3306-5ce6-93b4-08a0ff4dd41d" :question/math-academy-id "q-108839" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{3}+{e}^{x-3y+2}.\n$$\n\n \nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=3x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x-3y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1-3\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{3}-\\frac{1}{3}\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}-\\frac{1}{3}\\,\\frac{\\text{d}z}{\\text{d}x} & =\\frac{1}{3}+{e}^{z+2}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=-3{e}^{z+2}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}-\\frac{1}{3{e}^{z+2}}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ -\\frac{1}{3}\\int {e}^{-(z+2)}\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ \\frac{{e}^{-(z+2)}}{3} & =x+K \\\\ {e}^{-(z+2)} & =3x+C,\\end{aligned}\n$$\n\nwhere $C=3K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n{e}^{-(x-3y+2)}=3x+C\n$$\n\nTherefore, $g(x,y)={e}^{3y-x-2}.$"}] [{:db/id #edb/ref 17592186134079 :knowledge-point/_questions [{:knowledge-point/id #uuid "75e1da77-a5dc-5f78-977e-0d6dae99c97e" :knowledge-point/title "Identifying the Images of the Four Fundamental Subspaces of the Matrix Under Its Action"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbd7451-74c6-566c-a867-fcf356a99a4b" :answer/type {:db/ident :answer.type/math} :answer/value "R^{m}" :db/id #edb/ref 17592186130601} {:answer/id #uuid "b6da7862-8b4f-5be2-8b9b-be84e5946e90" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186130602} {:answer/id #uuid "c38260cd-73ff-5df7-ab80-c6758fb6a49d" :answer/type {:db/ident :answer.type/math} :answer/value "R^{n}" :db/id #edb/ref 17592186130603} {:answer/id #uuid "c7e729bc-2ee2-5d03-86f6-f61d84ed58ff" :answer/type {:db/ident :answer.type/math} :answer/value "Null(A)" :db/id #edb/ref 17592186130604} {:answer/id #uuid "3affadd2-5331-51ec-a5a8-4662d62cc494" :answer/type {:db/ident :answer.type/math} :answer/value "Col(A)" :db/id #edb/ref 17592186130605}] :answer-field/id #uuid "fc290a71-acb0-5b8d-990a-a0372d1ad9dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130600}] :question/id #uuid "ba1ee846-cfe9-595c-9803-25afded75ec1" :question/math-academy-id "q-108921" :question/problem "Let $A$ be a $m \\cdot n$ matrix. What is the image of $R^{n}$ under the action of $A$?"}] [{:db/id #edb/ref 17592186386314 :knowledge-point/_questions [{:knowledge-point/id #uuid "5371da4f-89c4-530d-8ae7-dd20279b53ba" :knowledge-point/title "Constructing Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "480c72d6-ed27-5158-a3da-e4270d83afe2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386316} {:answer/id #uuid "67698380-1e94-52f1-84b4-1cd412082171" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}e & 1 \\\\ 0 & e\\end{aligned}]" :db/id #edb/ref 17592186386317} {:answer/id #uuid "8efe434f-dd8a-5345-ba8b-24ef5d807076" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}e & 0 \\\\ 0 & e\\end{aligned}]" :db/id #edb/ref 17592186386318} {:answer/id #uuid "66e9a144-3c68-5cd5-a19a-f60b80d33f54" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}e & 2 \\\\ 0 & e\\end{aligned}]" :db/id #edb/ref 17592186386319} {:answer/id #uuid "11144c73-7c6c-52f9-985d-79fb865c5716" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186386320}] :answer-field/correct {:answer/id #uuid "67698380-1e94-52f1-84b4-1cd412082171" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}e & 1 \\\\ 0 & e\\end{aligned}]" :db/id #edb/ref 17592186386317} :answer-field/id #uuid "ce19b130-b8f1-58fa-b344-ede80783f08c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91d09580-332b-5e97-8ed7-30db20869d55" :question/math-academy-id "q-108971" :question/problem "${J}_{2}(e)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $2$ in ${J}_{2}(e)$ means that we have a $2\\times 2$ matrix.\n\n- The value $e$ in ${J}_{2}(e)$ means that we have $e$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{2}(e)=[\\begin{aligned}e & 1 \\\\ 0 & e\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386321 :knowledge-point/_questions [{:knowledge-point/id #uuid "5371da4f-89c4-530d-8ae7-dd20279b53ba" :knowledge-point/title "Constructing Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90044dbf-060b-5680-9c2e-93a966b4922c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386323} {:answer/id #uuid "39d54c77-acd2-572a-8101-c0580ebd121a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 2 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186386324} {:answer/id #uuid "e481d9e5-7116-5090-8268-bfb84eb4c017" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186386325} {:answer/id #uuid "dd8ef64a-1ae9-5626-ad6c-6d7ad8adf2c1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186386326} {:answer/id #uuid "7a9fca9a-a6ba-50f6-ab7f-bf103a2eedd0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186386327}] :answer-field/correct {:answer/id #uuid "e481d9e5-7116-5090-8268-bfb84eb4c017" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186386325} :answer-field/id #uuid "07c9423d-1233-5e95-aefc-4dc943b895d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0365f80-7f47-57b5-87a3-62e34ed1a052" :question/math-academy-id "q-108977" :question/problem "${J}_{2}(2)=$" :question/worked-solution "Let's construct our matrix:\n\n- The index $2$ in ${J}_{2}(2)$ means that we have a $2\\times 2$ matrix.\n\n- The value $2$ in ${J}_{2}(2)$ means that we have $2$'s on the main diagonal.\n\n- Also, we must have $1$'s on the superdiagonal (the diagonal above the main one).\n\nGiven that all the other entries must be zero, our Jordan block is\n\n$$\n{J}_{2}(2)=[\\begin{aligned}2 & 1 \\\\ 0 & 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386328 :knowledge-point/_questions [{:knowledge-point/id #uuid "4f7ad55b-efda-5622-8bdf-e660be24d0c4" :knowledge-point/title "Identifying Matrices Corresponding to a Composition of Jordan Blocks"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12cf06df-43ae-5444-8d78-08e441761270" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186386330} {:answer/id #uuid "424abcd4-5b9c-5841-936a-5cafd403eecc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186386331} {:answer/id #uuid "a82c2f2d-a722-5e45-a531-2884045ae7fa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186386332} {:answer/id #uuid "cecf0a91-3dce-582e-b2a3-cf0b7077bd15" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & 7\\end{aligned}]" :db/id #edb/ref 17592186386333} {:answer/id #uuid "cc522e73-f656-5576-8eaf-944797ca1682" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186386334}] :answer-field/correct {:answer/id #uuid "424abcd4-5b9c-5841-936a-5cafd403eecc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186386331} :answer-field/id #uuid "ad09c0d0-ad02-5db0-a8bf-d83534ff2d1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "90d77503-0508-58ca-9f96-9ade71955fc1" :question/math-academy-id "q-108984" :question/problem "${J}_{1}(7)\\,⊕\\,{J}_{1}(-1)=$" :question/worked-solution "First, recall the following:\n\n- ${J}_{1}(7)$ represents a $1\\times 1$ Jordan block with $7$'s on the leading diagonal,\n\n- ${J}_{1}(-1)$ represents a $1\\times 1$ Jordan block with $-1$'s on the leading diagonal.\n\nTherefore, our Jordan blocks are given by\n\n$$\n{J}_{1}(7)=[\\begin{aligned}7\\end{aligned}],\\,{J}_{1}(-1)=[\\begin{aligned}-1\\end{aligned}].\n$$\n\nThe composition of our Jordan blocks gives the following block diagonal matrix:\n\n$$\n{J}_{1}(7)\\,⊕\\,{J}_{1}(-1)=[\\begin{aligned}7 & 0 \\\\ 0 & -1\\end{aligned}]\n$$"}]}
