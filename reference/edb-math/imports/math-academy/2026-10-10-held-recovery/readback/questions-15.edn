#{[{:db/id #edb/ref 17592186392993 :knowledge-point/_questions [{:knowledge-point/id #uuid "a8d3a4ec-7531-5a58-8454-d19869fb21eb" :knowledge-point/title "Determining the Continuity of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dabbfb7e-f5ca-51f6-863e-6fff88876a7b" :answer/type {:db/ident :answer.type/math} :answer/value "[-1,\\infty )" :db/id #edb/ref 17592186392995} {:answer/id #uuid "551bb9b1-4a05-5415-b90c-3f13e42f5b7e" :answer/type {:db/ident :answer.type/math} :answer/value "[1,\\infty )" :db/id #edb/ref 17592186392996} {:answer/id #uuid "8854fcfd-e608-5907-b8a2-c88f499bd2b2" :answer/type {:db/ident :answer.type/math} :answer/value "[-1,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186392997} {:answer/id #uuid "3ac531b8-9c6d-5fb5-9ba1-4a69b514cc59" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186392998} {:answer/id #uuid "136fd3f5-98df-5610-ab77-16416cfb8f30" :answer/type {:db/ident :answer.type/math} :answer/value "(0,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186392999}] :answer-field/correct {:answer/id #uuid "3ac531b8-9c6d-5fb5-9ba1-4a69b514cc59" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186392998} :answer-field/id #uuid "cc2aef2c-fe0f-543f-9a99-a49a24bd9d40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73aa3e65-37d9-5275-9baf-48adf90d01bd" :question/math-academy-id "q-70559" :question/problem "Determine the interval on which the function $f(t)=\\operatorname{ln}⁡t\\,i+\\sqrt{t+1}\\,j+({t}^{3}-8)\\,k$ is continuous." :question/worked-solution "The interval of continuity of the vector-valued function is the intersection of the continuity intervals of all its components.\n\nLet's now consider the components of $f(t)$ one-by-one.\n\n- Function $\\operatorname{ln}⁡t$ is continuous for $t>0.$\n\n- Function $\\sqrt{t+1}$ is continuous for $t\\ge -1.$\n\n- Function ${t}^{3}-8$ is continuous for all real numbers.\n\nSo the interval of continuity for the vector-valued function $f(t)$ is the intersection of intervals $(0,\\infty )$  and $[-1,\\infty ).$ Therefore, the interval of continuity is $(0,\\infty ).$"}] [{:db/id #edb/ref 17592186393000 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161" :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "679c7dcb-5145-5780-81d8-87024bb1bd27" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}]=[\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186393002} {:answer/id #uuid "b5515e80-84a8-5eb8-a2be-ba588012a168" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]=[\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186393003} {:answer/id #uuid "f3d8dd1b-1865-5a25-92a3-6c3b04aadb53" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot [\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]=9" :db/id #edb/ref 17592186393004} {:answer/id #uuid "88367f38-9b3d-5d8d-9f17-294ee6119dfb" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}]=-20" :db/id #edb/ref 17592186393005} {:answer/id #uuid "e1992dff-615f-5a0d-8cc8-9fbb461f55a5" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}]=-11" :db/id #edb/ref 17592186393006}] :answer-field/correct {:answer/id #uuid "e1992dff-615f-5a0d-8cc8-9fbb461f55a5" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}]=-11" :db/id #edb/ref 17592186393006} :answer-field/id #uuid "9228779e-fa16-5c42-9940-9025c4863d96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393001}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "559832c2-15b2-5b81-bb2b-4adab3a391f2" :question/math-academy-id "q-70647" :question/problem "Find an equation of the plane that passes through the point $P(1,-4,5)$ and is perpendicular to the vector $n=[\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}].$" :question/worked-solution "First, notice that the position vector of $P$ is $p=[\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]$ and $n=[\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}]$ is normal to the plane. \n\nThe equation of the plane that passes though the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}] & =[\\begin{aligned}1 \\\\ -4 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}] \\\\ r\\cdot [\\begin{aligned}3 \\\\ 6 \\\\ 2\\end{aligned}] & =-11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393007 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc" :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7eb18dc-1cd0-5f11-9766-9b39ce8627d4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 1 \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393009} {:answer/id #uuid "c3e290d0-94dc-5b31-a2bd-857a223edcdb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡2t \\\\ 1 \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393010} {:answer/id #uuid "79b7fc04-e9d4-5de3-8865-cddcf5f7acfe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393011} {:answer/id #uuid "eecd81c6-e868-58ae-b147-24437027c490" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡4t \\\\ {cos}^{2}⁡t-{sin}^{2}⁡t \\\\ {e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393012} {:answer/id #uuid "01d87a17-578a-5627-9784-0c36eaa1beb0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ {cos}^{2}⁡t-{sin}^{2}⁡t \\\\ {e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393013}] :answer-field/correct {:answer/id #uuid "79b7fc04-e9d4-5de3-8865-cddcf5f7acfe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]" :db/id #edb/ref 17592186393011} :answer-field/id #uuid "5bffeefe-923c-5235-a516-2e71c745f54b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393008}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d92bf36-e24a-53bf-b359-cf412f728c8a" :question/math-academy-id "q-70688" :question/problem "Find $(u(t)f(t))^{′}$ where $f(t)=[\\begin{aligned}2\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t \\\\ {e}^{t}\\end{aligned}]$ and $u(t)=\\operatorname{sin}⁡t.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n(u(t)f(t))^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{t})\\end{aligned}]=[\\begin{aligned}2\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t \\\\ {e}^{t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(u(t)f(t))^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =\\operatorname{cos}⁡t[\\begin{aligned}2\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t \\\\ {e}^{t}\\end{aligned}]+\\operatorname{sin}⁡t[\\begin{aligned}2\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t \\\\ {e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\ \\operatorname{cos}⁡t\\operatorname{cos}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t\\end{aligned}]+[\\begin{aligned}2\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t\\operatorname{sin}⁡t \\\\ {e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡2t \\\\ {cos}^{2}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t\\end{aligned}]+[\\begin{aligned}\\operatorname{sin}⁡2t \\\\ -{sin}^{2}⁡t \\\\ {e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ {cos}^{2}⁡t-{sin}^{2}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t+{e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡2t \\\\ {e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393014 :knowledge-point/_questions [{:knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282" :knowledge-point/title "Using the Chain Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc0818f3-6660-5a5e-b58d-a575762526c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393016} {:answer/id #uuid "ab98f763-293f-5909-a542-20bf9e265d33" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393017} {:answer/id #uuid "fb1b744a-fd28-5436-8fa1-dc99d58a58de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]" :db/id #edb/ref 17592186393018} {:answer/id #uuid "0df38d96-3c28-5876-bdec-12fe8a88731c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡({e}^{2t}) \\\\ {e}^{3t} \\\\ \\frac{1}{{e}^{2t}}\\end{aligned}]" :db/id #edb/ref 17592186393019} {:answer/id #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393020}] :answer-field/correct {:answer/id #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393020} :answer-field/id #uuid "198253e9-b22c-548e-8e45-872ef7aaca94" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c43762c8-310f-5f86-a903-48bba629edc4" :question/math-academy-id "q-70695" :question/problem "If $f(u)=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ {u}^{3} \\\\ \\operatorname{ln}⁡u\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393021 :knowledge-point/_questions [{:knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d75490e5-1509-58bb-9763-c438183b853c" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨1,0,-1⟩=0" :db/id #edb/ref 17592186393023} {:answer/id #uuid "aeda2ffa-42b4-52c6-88ee-ca624f7cbd32" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,0,-2⟩=0" :db/id #edb/ref 17592186393024} {:answer/id #uuid "e668ab95-81b2-5487-a8db-a7ad8d3973d8" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,2⟩)\\cdot ⟨2,1,-2⟩=0" :db/id #edb/ref 17592186393025} {:answer/id #uuid "9538cda3-e06b-5fe5-b129-c566cce61ce5" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩=0" :db/id #edb/ref 17592186393026} {:answer/id #uuid "937f4290-2d11-5090-a4a2-afbc778336d1" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,-2,-4⟩=0" :db/id #edb/ref 17592186393027}] :answer-field/correct {:answer/id #uuid "9538cda3-e06b-5fe5-b129-c566cce61ce5" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩=0" :db/id #edb/ref 17592186393026} :answer-field/id #uuid "ca2ac9ba-0e12-54e9-981f-caf50c21ada3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73c1d5d9-6a23-5438-8d9f-6779511254e9" :question/math-academy-id "q-70818" :question/problem "Given the Cartesian equation $2x+y-2z-4=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨2,1,-2⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}2x+y-2z-4 & =0 \\\\ -2z & =-2x-y+4 \\\\ z & =x+\\frac{1}{2}y-2.\\end{aligned}\n$$\n\nIf we put, say, $x=0$ and $y=0$, we get $z=-2.$ Hence, the point $P(0,0,-2)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-2⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-2⟩)\\cdot ⟨2,1,-2⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393028 :knowledge-point/_questions [{:knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f840eb8f-ab9a-5f24-8c61-1495e09eec29" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨7,-1,-13⟩=0" :db/id #edb/ref 17592186393030} {:answer/id #uuid "91ee1039-c30b-5d26-b83c-09088d137cb6" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨0,7,-1⟩=0" :db/id #edb/ref 17592186393031} {:answer/id #uuid "23c5e4b7-8bec-5100-9926-e941a39c382d" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,13⟩)\\cdot ⟨7,-1,-13⟩=0" :db/id #edb/ref 17592186393032} {:answer/id #uuid "4d0de0e0-0dc6-5fa0-9f0d-4286598f473e" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨1,7,-1⟩=0" :db/id #edb/ref 17592186393033} {:answer/id #uuid "4781d9fd-c985-5f91-b6b3-1be2153657f7" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩=0" :db/id #edb/ref 17592186393034}] :answer-field/correct {:answer/id #uuid "4781d9fd-c985-5f91-b6b3-1be2153657f7" :answer/type {:db/ident :answer.type/math} :answer/value "(r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩=0" :db/id #edb/ref 17592186393034} :answer-field/id #uuid "dd843a19-122b-52dc-97b2-1085325976eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393029}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7d906b68-2682-5ae7-a3b1-5cdc64fb4dd3" :question/math-academy-id "q-70824" :question/problem "Given the Cartesian equation $7y-z-13=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨0,7,-1⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $z$:\n\n$$\n\\begin{aligned}7y-z-13 & =0 \\\\ z & =7y-13.\\end{aligned}\n$$\n\nIf we put, say, $y=0$, we get $z=-13.$ Hence, the point $P(0,0,-13)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,0,-13⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,0,-13⟩)\\cdot ⟨0,7,-1⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393035 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee" :knowledge-point/title "Finding a Vector That Is Parallel To a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4fb71df-948c-5126-86b0-9d79cb4c0fee" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186393037} {:answer/id #uuid "75ed4713-5dc0-5929-8f1a-ae29368dccf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186393038} {:answer/id #uuid "14d6c7a2-54c1-5ce2-9906-4d55cf87f498" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393039} {:answer/id #uuid "32938842-cdd7-5118-b60e-0c5d24a27836" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393040} {:answer/id #uuid "ea4da8ff-198b-50e0-8319-7a9af39b8918" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186393041}] :answer-field/correct {:answer/id #uuid "75ed4713-5dc0-5929-8f1a-ae29368dccf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186393038} :answer-field/id #uuid "b14d7746-5f36-5ef0-9936-be22c8877f39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393036}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee04e6aa-94ba-5e6d-a904-4a34aac7a757" :question/math-academy-id "q-70827" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨1,2,-1⟩=7.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨1,2,-1⟩=7$ of the plane, we get the normal vector $n=⟨1,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨1,2,-1⟩ & =0 \\\\ {t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & ={t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186393042 :knowledge-point/_questions [{:knowledge-point/id #uuid "45cdbb0d-2986-5c05-8d23-dce29363051b" :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Straight Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a5ad7cf-e4ff-58ff-83bd-f3f78d2bf29c" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,1,1⟩=2" :db/id #edb/ref 17592186393044} {:answer/id #uuid "7f5c0679-e0fe-53ca-b25e-60be64c06d0c" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,1,-1⟩=⟨1,1,1⟩" :db/id #edb/ref 17592186393045} {:answer/id #uuid "178672b3-37b3-5655-842f-d4da500e1495" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,1,1⟩=⟨2,1,-1⟩" :db/id #edb/ref 17592186393046} {:answer/id #uuid "a0a20d75-694b-5bf5-8c25-578546bfef99" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,1,-1⟩=2" :db/id #edb/ref 17592186393047} {:answer/id #uuid "e3c1542c-9778-5777-a91d-fc1ba92f6b5b" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,1,1⟩=0" :db/id #edb/ref 17592186393048}] :answer-field/correct {:answer/id #uuid "1a5ad7cf-e4ff-58ff-83bd-f3f78d2bf29c" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,1,1⟩=2" :db/id #edb/ref 17592186393044} :answer-field/id #uuid "eb32e226-7bfb-5486-b6de-65722871d5f4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be607052-6286-5c45-a7b0-2a7d8e65a24b" :question/math-academy-id "q-70892" :question/problem "Find an equation of the plane that passes through the point $Q(2,1,-1)$ and is perpendicular to the line that goes through the points \n$A(2,1,0)$ and $B(3,2,1).$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨2,1,-1⟩.$\n\nSince the line  passes through the points $A(2,1,0)$ and $B(3,2,1)$ we can find a vector parallel to the line:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨3,2,1⟩-⟨2,1,0⟩ \\\\  & =⟨1,1,1⟩.\\end{aligned}\n$$\n\n \n\nSo, a normal vector to the plane is $n=⟨1,1,1⟩.$ \n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨1,1,1⟩ & =⟨2,1,-1⟩\\cdot ⟨1,1,1⟩ \\\\ r\\cdot ⟨1,1,1⟩ & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393049 :knowledge-point/_questions [{:knowledge-point/id #uuid "45cdbb0d-2986-5c05-8d23-dce29363051b" :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Straight Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "493da2a3-c2b1-5d90-946c-32226dc19e64" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,-5,-2⟩=⟨-3,4,-1⟩" :db/id #edb/ref 17592186393051} {:answer/id #uuid "dc7fa3af-d391-569e-bc17-106f3e9396bf" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-3,4,-1⟩=⟨3,-5,-2⟩" :db/id #edb/ref 17592186393052} {:answer/id #uuid "8fe2b282-7f73-5949-a7f3-cc5ddf1e2530" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-3,4,-1⟩=0" :db/id #edb/ref 17592186393053} {:answer/id #uuid "949e581b-c362-5470-828e-687788c962cb" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,-5,-2⟩=-27" :db/id #edb/ref 17592186393054} {:answer/id #uuid "1521f0fb-a511-5bc0-893e-2c6a06cceff9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-3,4,-1⟩=-27" :db/id #edb/ref 17592186393055}] :answer-field/correct {:answer/id #uuid "1521f0fb-a511-5bc0-893e-2c6a06cceff9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-3,4,-1⟩=-27" :db/id #edb/ref 17592186393055} :answer-field/id #uuid "31ef96c8-9198-5e30-8832-aa55a71dc6d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393050}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ca2b2271-1ec0-5a3e-b5ac-687d91668797" :question/math-academy-id "q-70895" :question/problem "Find an equation of the plane that passes through the point $P(3,-5,-2)$ and is perpendicular to the line \n\n$$\n{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t.\\end{aligned}\n$$" :question/worked-solution "Note that the position vector of $P$ is $p=⟨3,-5,-2⟩.$ Converting the parametric equations of the line to vector form, we get\n\n$$\n{\\begin{aligned}x=2-3t \\\\ y=3+4t \\\\ z=4-t\\end{aligned}\\,⟹\\,⟨x,y,z⟩=⟨2,3,4⟩+t\\text{ }{{⟨-3,4,-1⟩}_{⏟}}_{v}.\n$$\n\n \n\nThe direction vector of the line is $v=⟨-3,4,-1⟩,$ so a normal vector to the plane is \n\n$$\nn=v=⟨-3,4,-1⟩.\n$$\n\nTherefore, the equation of the plane is given by\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-3,4,-1⟩ & =⟨3,-5,-2⟩\\cdot ⟨-3,4,-1⟩ \\\\ r\\cdot ⟨-3,4,-1⟩ & =-27.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393056 :knowledge-point/_questions [{:knowledge-point/id #uuid "89462485-2e28-5727-82c7-7afd0cac6d77" :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393058} {:answer/id #uuid "b904b162-87b0-576b-9c8a-3c647aa88565" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $16$" :db/id #edb/ref 17592186393059} {:answer/id #uuid "e0376e6b-94e1-5393-8f70-58f85be3025d" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $4$" :db/id #edb/ref 17592186393060} {:answer/id #uuid "a1fe974f-7739-5447-8c15-65e11281c360" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393061} {:answer/id #uuid "1a4bb814-df36-50ef-990c-594eb222e321" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $16$" :db/id #edb/ref 17592186393062}] :answer-field/correct {:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393058} :answer-field/id #uuid "85727bd6-7f77-5807-aa8a-f0686b43c486" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393057}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fed78696-d1d3-57b4-8aa2-ab1ef29e5f93" :question/math-academy-id "q-70933" :question/problem "What is the center and radius of the circle with equation $(x+1)^{2}+(y+6)^{2}=16?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+1)^{2}+(y+6)^{2} & =16 \\\\ (x-(-1))^{2}+(y-(-6))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nWe see that $a=-1,$ $b=-6,$ and $r=4.$ \n\nTherefore, the circle is centered at $(-1,-6)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186393063 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "840901d2-388a-56b4-b2ed-4aa835792fb2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨2,1,-\\frac{1}{5}⟩+s⟨-3,0,1⟩+t⟨-3,2,7⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393065} {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393066} {:answer/id #uuid "a9567360-7eeb-5790-a68a-54789a38c8f2" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393067} {:answer/id #uuid "0abc7499-ef02-5049-b4d5-92446ade1dde" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨3,-1,20⟩+t⟨0,3,-4⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393068} {:answer/id #uuid "d56ba868-cc5e-5eb8-8190-756b44636c16" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,0,1⟩+s⟨-3,2,7⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393069}] :answer-field/correct {:answer/id #uuid "3a999e63-69bc-5b5b-ba4a-b3d5b35bdaf5" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty )." :db/id #edb/ref 17592186393066} :answer-field/id #uuid "74bd7e12-82f3-5b83-88f9-1acb2c12ad74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1e3ae2d-0bf0-5679-8209-36898e366f4e" :question/math-academy-id "q-70981" :question/problem "Find a parametric equation of the plane that passes through the point $H(-3,2,7)$ and is parallel to the lines $r=⟨3,-1,20⟩+s⟨-3,0,1⟩$ and $r=⟨0,3,-4⟩+t⟨2,1,-\\frac{1}{5}⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨-3,0,1⟩$ and ${v}_{2}=⟨2,1,-\\frac{1}{5}⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $H(-3,2,7)$ lies on the plane and its position vector is $h=⟨-3,2,7⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =h+s{v}_{1}+t{v}_{2} \\\\ r & =⟨-3,2,7⟩+s⟨-3,0,1⟩+t⟨2,1,-\\frac{1}{5}⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393070 :knowledge-point/_questions [{:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11fe6c60-77f7-596d-b73e-0a2b1a46b507" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨2,-9,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393072} {:answer/id #uuid "18c27f61-10ac-5e9a-9262-ba682e6d266e" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393073} {:answer/id #uuid "a673c983-c8f1-5b15-8abb-116913587299" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393074} {:answer/id #uuid "f377602b-aa7b-52c3-8d62-a25cd478c050" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨0,-6,-1⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393075} {:answer/id #uuid "37a16cbe-c7b9-5d98-99c1-895ad8adbfef" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨2,-9,0⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393076}] :answer-field/correct {:answer/id #uuid "a673c983-c8f1-5b15-8abb-116913587299" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393074} :answer-field/id #uuid "141932d6-a6f5-58b4-ba12-7fe47a40ab43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393071}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "901f1360-df93-5e5e-ac60-c5607de4f628" :question/math-academy-id "q-71036" :question/problem "Find a parametric equation of the plane that passes through the points $P(3,6,2),\\,Q(2,-9,0)$, and $R(3,0,1).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,-9,0⟩-⟨3,6,2⟩ \\\\  & =⟨-1,-15,-2⟩ \\\\ \\overset{\\to }{PR} & =⟨3,0,1⟩-⟨3,6,2⟩ \\\\  & =⟨0,-6,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨3,6,2⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393077 :knowledge-point/_questions [{:knowledge-point/id #uuid "000408ba-6fbd-51da-9002-82fdde167a1f" :knowledge-point/title "Identifying Point Discontinuities on a Graph when Multiple Types of Discontinuities Exist"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2e40aa3-9884-5698-9138-4c376a7b0300" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-3$ and $x=3$ only" :db/id #edb/ref 17592186393079} {:answer/id #uuid "c08c3849-15cd-5d0f-9d78-dba6a137a092" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-3$ only" :db/id #edb/ref 17592186393080} {:answer/id #uuid "01dc6ca1-2f53-5dee-ab41-d46880f5e145" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186393081} {:answer/id #uuid "56a76ae4-bdda-58c2-a65d-ba7f5c1a3c2f" :answer/type {:db/ident :answer.type/text} :answer/value "$x=3$ only" :db/id #edb/ref 17592186393082} {:answer/id #uuid "c5ec1cd9-9e0a-5f6f-a53a-17994dd0e514" :answer/type {:db/ident :answer.type/text} :answer/value "$x=0$ and $x=3$ only" :db/id #edb/ref 17592186393083}] :answer-field/correct {:answer/id #uuid "f2e40aa3-9884-5698-9138-4c376a7b0300" :answer/type {:db/ident :answer.type/text} :answer/value "$x=-3$ and $x=3$ only" :db/id #edb/ref 17592186393079} :answer-field/id #uuid "e680d54c-fe49-54eb-992a-d5d8384c550d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393078}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ad5208d-6613-538b-805c-388d7abb0069" :question/math-academy-id "q-71067" :question/problem "![](images/d0/d036e94f6a07c526c9609ca2030cc785927562b0771335bbe12aa5fe27c3e369.png)\n\nConsider the function $y=f(x)$ plotted above. For what values of $x$ does the function $y=f(x)$ have a removable discontinuity?" :question/worked-solution "The function has a discontinuity at $x=-3.$ Checking our continuity conditions, we have:\n\n- $f(-3)=3$ exists $\\,✓$\n\n- ${lim}_{x\\to (-3)}f(x)=-3$ exists $\\,✓$\n\n- ${lim}_{x\\to (-3)}f(x)\\ne f(-3)\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=-3$ is a removable discontinuity.\n\nA similar argument applies for $x=3,$ which is also a removable discontinuity. \n\nConsequently, the correct answer is $x=-3$ and $x=3$ only."}] [{:db/id #edb/ref 17592186393084 :knowledge-point/_questions [{:knowledge-point/id #uuid "74401a99-8151-5848-bfcc-1eef2569c204" :knowledge-point/title "Finding the Interval on Which a Product of Functions is Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3292f7dd-9f40-564b-8ec0-c859a28fa3e1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186393086} {:answer/id #uuid "9e960559-d91e-5aac-a15e-1af9bc62c6be" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186393087} {:answer/id #uuid "2d807ee0-39b1-5d49-997d-98feb4dcf0ac" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186393088} {:answer/id #uuid "f6de57c8-9d1f-58f8-bccf-6eeea8e051b4" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,1)" :db/id #edb/ref 17592186393089} {:answer/id #uuid "56c3d3fa-e258-5a91-b93a-547df597f0d0" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186393090}] :answer-field/correct {:answer/id #uuid "2d807ee0-39b1-5d49-997d-98feb4dcf0ac" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186393088} :answer-field/id #uuid "690c4be0-8a71-5707-98c7-17039c45d319" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393085}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "773e3359-ad9e-5f62-8a81-3cff38812a67" :question/math-academy-id "q-71092" :question/problem "Find the intervals where the function $F(t)=f(t)\\cdot g(t)$ is differentiable, given that\n \n\n$$\n\\begin{aligned}f(t) & =\\operatorname{cos}⁡{t}^{2}\\,i+\\operatorname{ln}⁡(-t)\\,j+{3}^{t}\\,k \\\\ g(t) & =\\sqrt{1-{t}^{2}}\\,i+(t+7)\\,j+\\operatorname{sin}⁡t\\,k\\end{aligned}\n$$" :question/worked-solution "The function $F(t)=f(t)\\cdot g(t)$ is differentiable over the common domain where both $f(t)$ and $g(t)$ are differentiable. A vector function is differentiable if and only if each component is differentiable.\n\nLet's now find the intervals where each of the functions $f(t)$ and $g(t)$ are differentiable.\n\nFor the function $f(t):$ \n\n- The first  and third components, $\\operatorname{cos}⁡{t}^{2}$ and ${3}^{t},$ are differentiable for all values of $t.$\n\n- The second component $\\operatorname{ln}⁡(-t)$ is differentiable on $(-\\infty ,0).$\n\nSo,  the intersection of the domains of all three components of $f(t)$ is $(-\\infty ,0).$  \n\nFor the function $g(t):$ \n\n- The first component $\\sqrt{1-{t}^{2}}$ is differentiable on $(-1,1)$, as its derivative is not defined at $t=\\pm 1$ and the function is not defined for $|t|>1.$\n\n- The second and third components, component $t+7$  and $\\operatorname{sin}⁡t,$ are differentiable for all values of $t.$\n\nHence,  the intersection of the domains of all three components of $g(t)$ is  $(-1,1).$    \n\nFinally, the common domain of differentiability for $f(t)$ and $g(t)$ is $(-\\infty ,0)\\cap (-1,1)=(-1,0).$"}] [{:db/id #edb/ref 17592186134505 :knowledge-point/_questions [{:knowledge-point/id #uuid "9aa43961-5b6a-5c8b-adea-809d0a693cd1" :knowledge-point/title "Calculating the Components of a Vector Orthogonal to a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ae2689b-03da-5b4a-8bd9-e03a7a3d536c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186393092} {:answer/id #uuid "2c523036-0297-53fb-8cf4-0a2347f12c7d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186393093} {:answer/id #uuid "e5ddb235-9955-5a27-87c5-3f2c81216912" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393094} {:answer/id #uuid "56996c07-885b-5b0d-8973-e1ca5a8ac3fe" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186393095} {:answer/id #uuid "81374ca6-2fbe-5ee7-a0ba-75942ffe6258" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186393096}] :answer-field/correct {:answer/id #uuid "e5ddb235-9955-5a27-87c5-3f2c81216912" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186393094} :answer-field/id #uuid "98103ba7-7941-593f-8c55-fa6f21186d7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393091}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e055065d-3cdf-5f06-8b7f-a22a1c681c38" :question/math-academy-id "q-71102" :question/problem "Given that $u=[\\begin{aligned}a \\\\ b \\\\ c\\end{aligned}]$ is a non-zero  vector that is orthogonal to the set $W={[\\begin{aligned}1 \\\\ -3 \\\\ 1\\end{aligned}],[\\begin{aligned}3 \\\\ 1 \\\\ -2\\end{aligned}]},$ find the value of $\\frac{c}{a+b}.$" :question/worked-solution "The vector $u$ is orthogonal to the set $W$ if $u\\cdot {w}_{1}=0$ and $u\\cdot {w}_{2}=0.$ So, we need to solve the following system:\n\n$$\n{\\begin{aligned}u\\cdot {w}_{1}=0 \\\\ u\\cdot {w}_{2}=0\\end{aligned}\\,⟹\\,{\\begin{aligned}{x}_{1}-3{x}_{2}+{x}_{3}=0 \\\\ 3{x}_{1}+{x}_{2}-2{x}_{3}=0\\end{aligned}\n$$\n\nwith the augmented matrix $M,$ which we reduce to row echelon form, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 1 & 0 \\\\ 3 & 1 & -2 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 1 & 0 \\\\ 0 & 10 & -5 & 0\\end{aligned}]\\end{aligned}\n$$\n\nIn the reduced matrix above, we have $2$ pivot columns (the $1$st and $2$nd), so ${x}_{3}$ is a free variable. From the second equation, we get ${x}_{2}=\\frac{1}{2}{x}_{3}.$ Substituting this into the first equation, we obtain ${x}_{1}=\\frac{1}{2}{x}_{3}.$ So, the general solution is\n\n$$\n[\\begin{aligned}\\frac{1}{2}{x}_{3} \\\\ \\frac{1}{2}{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in R.\n$$\n\nSetting ${x}_{3}=2,$ we get the vector \n$[\\begin{aligned}1 \\\\ 1 \\\\ 2\\end{aligned}].$\n\nTherefore, we obtain $a=1,$ $b=1,$ and $c=2.$\n\nFinally, $\\frac{c}{a+b}=\\frac{2}{1+1}=1.$"}] [{:db/id #edb/ref 17592186393097 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdecdb2a-be1a-535a-bee9-9659ab7d1d37" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393099} {:answer/id #uuid "81a8a04c-db9c-57ca-b056-75bc4bda4bb7" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 0 & \\,1 \\\\ 10 & -1 & \\,0 \\\\ -2 & 0 & \\,2\\end{aligned}|" :db/id #edb/ref 17592186393100} {:answer/id #uuid "07c43492-f6dd-5136-82a3-13dad2882b0c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 0 & \\,1 \\\\ 10 & -1 & \\,0 \\\\ 11 & 0 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393101} {:answer/id #uuid "01e785ae-c084-571e-93e7-3cc45466fd54" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 0 & \\,1 \\\\ 1 & -1 & \\,0 \\\\ 0 & 3 & \\,2\\end{aligned}|" :db/id #edb/ref 17592186393102} {:answer/id #uuid "435c0dce-546b-54b9-bdab-d4baeb3c9ec3" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}10 & 1 & \\,0 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393103}] :answer-field/correct {:answer/id #uuid "fdecdb2a-be1a-535a-bee9-9659ab7d1d37" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393099} :answer-field/id #uuid "b15b527c-7c8f-54df-aefc-bcdbdc70d5ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393098}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "caf1e0fb-eb87-5e71-a542-0c1755eff5ab" :question/math-academy-id "q-71189" :question/problem "What is the minor of ${p}_{23}$ in  $P=[\\begin{aligned}-7 & 3 & 0 & \\,1 \\\\ 10 & 1 & -1 & \\,0 \\\\ -2 & 0 & 3 & \\,2 \\\\ 11 & 3 & 0 & \\,-3\\end{aligned}]?$" :question/worked-solution "To get the minor of ${p}_{23}$, we remove the  $2$nd row and the $3$rd column:\n\n$$\nP=[\\begin{aligned}-7 & 3 & ∗ & 1 \\\\ ∗ & ∗ & -1 & ∗ \\\\ -2 & 0 & ∗ & 2 \\\\ 11 & 3 & ∗ & -3\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{23}=|\\begin{aligned}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|.\n$$"}] [{:db/id #edb/ref 17592186393104 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf02146-e1b0-5539-b4e5-5e4db585f712" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{aligned}|" :db/id #edb/ref 17592186393106} {:answer/id #uuid "639ab66c-d0ba-5e67-b27c-fee7c12393fd" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 0 \\\\ 5 & -1 & 1 \\\\ 7 & 10 & 8\\end{aligned}|" :db/id #edb/ref 17592186393107} {:answer/id #uuid "e0e8b3c9-465c-55d4-b781-46d61c898c4b" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 1 & 0 \\\\ 5 & 0 & 1 \\\\ 7 & 2 & 8\\end{aligned}|" :db/id #edb/ref 17592186393108} {:answer/id #uuid "e9c7b7b0-99e1-5530-8565-49e93df10d3b" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 7 & 10 & 8\\end{aligned}|" :db/id #edb/ref 17592186393109} {:answer/id #uuid "923bf90c-f200-5ae2-850a-6b9cff1e3bf2" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-1 & 0 & 1 \\\\ 10 & 2 & 8 \\\\ -3 & 0 & 3\\end{aligned}|" :db/id #edb/ref 17592186393110}] :answer-field/correct {:answer/id #uuid "ecf02146-e1b0-5539-b4e5-5e4db585f712" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{aligned}|" :db/id #edb/ref 17592186393106} :answer-field/id #uuid "dd952f15-a2c4-53c4-ab18-fdcc2715d46f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393105}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5a3f02c-617a-514d-b9f7-86ea907e6206" :question/math-academy-id "q-71190" :question/problem "What is the minor of ${u}_{34}$ in  $U=[\\begin{aligned}2 & -1 & 1 & 0 \\\\ 5 & -1 & 0 & 1 \\\\ 7 & 10 & 2 & 8 \\\\ 9 & -3 & 0 & 3\\end{aligned}]?$" :question/worked-solution "To get the minor of ${u}_{34}$, we remove the  $3$rd row and the $4$th column:\n\n$$\nU=[\\begin{aligned}2 & -1 & 1 & ∗ \\\\ 5 & -1 & 0 & ∗ \\\\ ∗ & ∗ & ∗ & 8 \\\\ 9 & -3 & 0 & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{aligned}|.\n$$"}] [{:db/id #edb/ref 17592186393111 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc" :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3d10de5-e9c5-5c37-aa64-fa06b54ead11" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3{e}^{3t} \\\\ 4{e}^{4t} \\\\ 5{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393113} {:answer/id #uuid "6cba95e3-79b8-5287-a813-d9e41cf5e8b3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(t+3){e}^{3t} \\\\ (t+4){e}^{4t} \\\\ (t+5){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393114} {:answer/id #uuid "a3a250be-c0e9-5cab-92c9-3d602707d998" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3t{e}^{3t} \\\\ 4t{e}^{4t} \\\\ 5t{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393115} {:answer/id #uuid "6b7efc35-c9c9-54ba-9171-12ada5fa9705" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}({t}^{2}+1){e}^{3t} \\\\ ({t}^{2}+2){e}^{4t} \\\\ ({t}^{2}+3){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393116} {:answer/id #uuid "d86e8688-766e-519c-8b4e-8b4b1b2281ad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(3t+1){e}^{3t} \\\\ (4t+1){e}^{4t} \\\\ (5t+1){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393117}] :answer-field/correct {:answer/id #uuid "d86e8688-766e-519c-8b4e-8b4b1b2281ad" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(3t+1){e}^{3t} \\\\ (4t+1){e}^{4t} \\\\ (5t+1){e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186393117} :answer-field/id #uuid "34376f88-2d0f-51e5-9b5f-462c8596e4f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a49de4c-5d1f-5ca3-aa1a-4ebaca430818" :question/math-academy-id "q-71227" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}{e}^{3t} \\\\ {e}^{4t} \\\\ {e}^{5t}\\end{aligned}]$ and $u(t)=t.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{3t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{4t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{5t})\\end{aligned}]=[\\begin{aligned}3{e}^{3t} \\\\ 4{e}^{4t} \\\\ 5{e}^{5t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =1\\cdot [\\begin{aligned}{e}^{3t} \\\\ {e}^{4t} \\\\ {e}^{5t}\\end{aligned}]+t[\\begin{aligned}3{e}^{3t} \\\\ 4{e}^{4t} \\\\ 5{e}^{5t}\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{3t} \\\\ {e}^{4t} \\\\ {e}^{5t}\\end{aligned}]+[\\begin{aligned}3t{e}^{3t} \\\\ 4t{e}^{4t} \\\\ 5t{e}^{5t}\\end{aligned}] \\\\  & =[\\begin{aligned}(3t+1){e}^{3t} \\\\ (4t+1){e}^{4t} \\\\ (5t+1){e}^{5t}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393118 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc" :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9538c922-626d-57e3-875e-1c3a6b6e5675" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(4{t}^{2}+t){e}^{t} \\\\ ({t}^{2}-1){e}^{t} \\\\ {e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393120} {:answer/id #uuid "8c39359a-bdf1-5f7a-abe2-7ec39aa9faf5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393121} {:answer/id #uuid "cd118cf1-a60f-5278-b6b0-774581fb4af6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(-5{t}^{3}-3{t}^{2}+1){e}^{t} \\\\ (3{t}^{2}-t-1){e}^{t} \\\\ (t+2){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393122} {:answer/id #uuid "0231d3d9-379e-569f-8987-f29126252cf1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}({t}^{2}-4t+4) \\\\ ({t}^{2}-1) \\\\ (2t+3)\\end{aligned}]" :db/id #edb/ref 17592186393123} {:answer/id #uuid "52e3e13a-2c9a-5dea-92ad-1d1be14d9577" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7{t}^{3}{e}^{t} \\\\ {t}^{2}{e}^{t} \\\\ 4t{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393124}] :answer-field/correct {:answer/id #uuid "8c39359a-bdf1-5f7a-abe2-7ec39aa9faf5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393121} :answer-field/id #uuid "c5faccf8-2ac3-56c6-9185-9f48d31adb8d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393119}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c08c320-55ed-59e1-87a0-c92a722748de" :question/math-academy-id "q-71233" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}2{t}^{3}-3 \\\\ {t}^{2}+1 \\\\ 4t-7\\end{aligned}]$ and $u(t)={e}^{t}.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3) \\\\ \\frac{\\text{d}}{\\text{d}t}({t}^{2}+1) \\\\ \\frac{\\text{d}}{\\text{d}t}(4t-7)\\end{aligned}]=[\\begin{aligned}6{t}^{2} \\\\ 2t \\\\ 4\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & ={e}^{t}[\\begin{aligned}2{t}^{3}-3 \\\\ {t}^{2}+1 \\\\ 4t-7\\end{aligned}]+{e}^{t}[\\begin{aligned}6{t}^{2} \\\\ 2t \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}(2{t}^{3}-3){e}^{t} \\\\ ({t}^{2}+1){e}^{t} \\\\ (4t-7){e}^{t}\\end{aligned}]+[\\begin{aligned}6{t}^{2}{e}^{t} \\\\ 2t{e}^{t} \\\\ 4{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393125 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b5f51ee-5bde-5e39-8d2a-e5e482be4916" :knowledge-point/title "Finding the Direction Vector of a Line Given as the Intersection of Two Planes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fc33413-8200-5afe-93e6-6458c7c8e9bb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1,0⟩" :db/id #edb/ref 17592186393127} {:answer/id #uuid "a249b7e6-f321-572b-95e1-9881de3b676d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,1⟩" :db/id #edb/ref 17592186393128} {:answer/id #uuid "7a095b8f-ee85-53aa-bcff-2bfe68c67e76" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,1,0⟩" :db/id #edb/ref 17592186393129} {:answer/id #uuid "02a083d9-ebb3-54c7-86b9-863f7bd3eb31" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0,0⟩" :db/id #edb/ref 17592186393130} {:answer/id #uuid "0401bdc3-5a0a-5673-95e9-ba3ea18f4008" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1,-1⟩" :db/id #edb/ref 17592186393131}] :answer-field/correct {:answer/id #uuid "7a095b8f-ee85-53aa-bcff-2bfe68c67e76" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,1,0⟩" :db/id #edb/ref 17592186393129} :answer-field/id #uuid "faddb070-9799-589d-b442-8793b0a574ea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393126}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce5171f6-22a8-5be0-9547-0d96404368c9" :question/math-academy-id "q-71268" :question/problem "Find a direction vector of the line that is given as the intersection of the planes $z=1$ and $x=y.$" :question/worked-solution "First, notice that: \n\n- For the plane $z=1$, a normal vector to the plane is ${n}_{1}=⟨0,0,1⟩.$\n\n- For the plane $x=y$ (or $x-y=0$), a normal vector to the plane is ${n}_{2}=⟨1,-1,0⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨0,0,1⟩\\times ⟨1,-1,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 0 & 1 \\\\ 1 & -1 & 0\\end{aligned}\\right| \\\\  & =i+j \\\\  & =⟨1,1,0⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393132 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b5f51ee-5bde-5e39-8d2a-e5e482be4916" :knowledge-point/title "Finding the Direction Vector of a Line Given as the Intersection of Two Planes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa0ac3f8-438f-54c7-b4f9-c594d79dd1ae" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,1,-1⟩" :db/id #edb/ref 17592186393134} {:answer/id #uuid "ee9dfc58-5aea-568f-92c8-b3bb1b22b61f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0,-1⟩" :db/id #edb/ref 17592186393135} {:answer/id #uuid "cd752dc0-22e1-56c0-97bc-d5c3b6653ad5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0,1⟩" :db/id #edb/ref 17592186393136} {:answer/id #uuid "a270c1dd-469b-558e-bafe-8ab31f4627af" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,1,0⟩" :db/id #edb/ref 17592186393137} {:answer/id #uuid "a3354cd6-67f4-5aec-82d5-d960556c9346" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,0,-1⟩" :db/id #edb/ref 17592186393138}] :answer-field/correct {:answer/id #uuid "ee9dfc58-5aea-568f-92c8-b3bb1b22b61f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0,-1⟩" :db/id #edb/ref 17592186393135} :answer-field/id #uuid "0dbac2a6-bbc5-5083-88c8-9b304da962d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393133}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07f0b1a9-ab3f-550e-aed9-fa24adcc5d73" :question/math-academy-id "q-71270" :question/problem "Find a direction vector of the line that is given as the intersection of the planes $y=-2$ and $x=z-1.$" :question/worked-solution "First, notice that: \n\n- For the plane $y=-2$, a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $x=z-1$ (or $x-z+1=0$), a normal vector to the plane is ${n}_{2}=⟨1,0,-1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:    \n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨0,1,0⟩\\times ⟨1,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 1 & 0 \\\\ 1 & 0 & -1\\end{aligned}\\right| \\\\  & =-i-k \\\\  & =⟨-1,0,-1⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393139 :knowledge-point/_questions [{:knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c33198-cc5c-5160-81c8-f47faca10bd5" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186393141} {:answer/id #uuid "c4b91d53-b9bb-5ccd-8284-07162ce795a3" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186393142} {:answer/id #uuid "cbf41b51-bd8b-557e-b601-007569be086e" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186393143} {:answer/id #uuid "1f00e675-dab1-5590-88bb-52f5380183c9" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186393144} {:answer/id #uuid "290fdd35-0379-5b6c-ae69-55ff1d34cf7b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186393145}] :answer-field/correct {:answer/id #uuid "290fdd35-0379-5b6c-ae69-55ff1d34cf7b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186393145} :answer-field/id #uuid "fd0197e2-e874-569c-8e06-ebf5b465b2c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393140}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89b4a109-08c5-568a-830b-41c72ba008a5" :question/math-academy-id "q-71401" :question/problem "The level curves of the function $f(x,y)=\\frac{2{y}^{2}+1}{{x}^{2}+{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=1$ gives an ellipse\n- $c=2$ gives two lines\n- $c=3$ gives a hyperbola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{2{y}^{2}+1}{{x}^{2}+{y}^{2}} & =c \\\\ 2{y}^{2}+1 & =c({x}^{2}+{y}^{2}) \\\\ c{x}^{2}+(c-2){y}^{2} & =1\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=1$ then the level curve is ${x}^{2}-{y}^{2}=1,$ which is a hyperbola.\n\n- If $c=2$ then the level curves are $x=\\pm \\frac{\\sqrt{2}}{2},$ which consists of two vertical lines.\n\n- If $c=3$ then the level curve is $3{x}^{2}+{y}^{2}=1,$ which is an ellipse.\n\nSo, only statement II is true."}] [{:db/id #edb/ref 17592186393146 :knowledge-point/_questions [{:knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822" :knowledge-point/title "Sketching Level Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdd6b5d4-ea23-5caf-8777-7138860af8ce" :answer/type {:db/ident :answer.type/image} :answer/value "images/98/98d449048718ab75fc54a659bc74314f26b6059c5e7a7ed4af28b7edfeb69a69.png" :db/id #edb/ref 17592186393148} {:answer/id #uuid "7487cd45-f801-550a-a1b4-5e2864c83b4b" :answer/type {:db/ident :answer.type/image} :answer/value "images/a8/a8c4e910e3884ee68518752ab814f491edb14d422b4c25926b7d3ad34720592d.png" :db/id #edb/ref 17592186393149} {:answer/id #uuid "2bc74059-a769-52e2-bcbf-ddccb68efbb2" :answer/type {:db/ident :answer.type/image} :answer/value "images/c5/c5ea7e325483eeb3572c90b78a5cf72040d84b98dee51a1ca2bdf4dcab5b8d2f.png" :db/id #edb/ref 17592186393150} {:answer/id #uuid "7fd43447-80cf-50a5-8942-6f1234cad571" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7569d1df433554420caf9b30c06a3baf6fc73c150bf41e898e7c66333946553.png" :db/id #edb/ref 17592186393151} {:answer/id #uuid "4cbca4ce-0d9a-5eff-be43-6a0f899caae9" :answer/type {:db/ident :answer.type/image} :answer/value "images/f3/f33a74f9c61703628cd53576dc12b8a02d67944dccd70e3ea6d1be88ba3fa5d8.png" :db/id #edb/ref 17592186393152}] :answer-field/correct {:answer/id #uuid "2bc74059-a769-52e2-bcbf-ddccb68efbb2" :answer/type {:db/ident :answer.type/image} :answer/value "images/c5/c5ea7e325483eeb3572c90b78a5cf72040d84b98dee51a1ca2bdf4dcab5b8d2f.png" :db/id #edb/ref 17592186393150} :answer-field/id #uuid "077949f5-62c8-59b7-9b63-c9e8b3537b15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393147}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d3f898f6-b08f-5687-adf4-0ea719bca50f" :question/math-academy-id "q-71413" :question/problem "![](images/29/29253192bb8863030c3464dd2c42be40922db96f3de6f3e57674f2a59f862e09.png)\n\nWhich of the following could represent the level curves of the surface $z=\\operatorname{cos}⁡x$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c\n$$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\operatorname{cos}⁡x & =c \\\\ x & =\\pm \\operatorname{arccos}⁡c+2\\pi n\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that in the equations $x=\\pm \\operatorname{arccos}⁡c+2\\pi n$ do not depend on $y.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of vertical lines, as shown below.\n\n$$\n\n$$\n\n![](images/c5/c5ea7e325483eeb3572c90b78a5cf72040d84b98dee51a1ca2bdf4dcab5b8d2f.png)"}] [{:db/id #edb/ref 17592186088290 :knowledge-point/_questions [{:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed876eb-e8b1-58fc-a7c7-49ce58aab2a1" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨-8,\\,4⟩" :db/id #edb/ref 17592186393154} {:answer/id #uuid "6c9432b2-20cf-5e0d-b627-365bf8bb517b" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨5t,\\,2{t}^{2}⟩" :db/id #edb/ref 17592186393155} {:answer/id #uuid "5aeefe63-a288-5b47-85c7-d2a2775613d9" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨5,\\,2t⟩" :db/id #edb/ref 17592186393156} {:answer/id #uuid "ee5fa715-a949-54b8-a77a-babd9c98996a" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨5,\\,4t⟩" :db/id #edb/ref 17592186393157} {:answer/id #uuid "5f894125-91dc-5e2c-bd9f-0d467b5542d7" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨5,\\,2⟩" :db/id #edb/ref 17592186393158}] :answer-field/correct {:answer/id #uuid "ee5fa715-a949-54b8-a77a-babd9c98996a" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨5,\\,4t⟩" :db/id #edb/ref 17592186393157} :answer-field/id #uuid "78dfd377-d2e6-5c1a-8aa3-e854870d70f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393153}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fca59699-e72b-5149-821a-1daf54baaef5" :question/math-academy-id "q-7156" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨5t-8,\\,2{t}^{2}+4⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5t-8),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+4)⟩ \\\\  & =⟨5,\\,4t⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393159 :knowledge-point/_questions [{:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e308dc50-8d1a-5be8-8bbc-ac3c0f36ba24" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨18t-12,\\,4⟩" :db/id #edb/ref 17592186393161} {:answer/id #uuid "09d66d5c-4d57-5f45-b863-d859d6731c3c" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨18,\\,0⟩" :db/id #edb/ref 17592186393162} {:answer/id #uuid "21f4858f-79e0-56bc-b9f1-8a92538ca3c5" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨9,\\,4⟩" :db/id #edb/ref 17592186393163} {:answer/id #uuid "6e19d831-00d7-51e2-a2c5-b5965a41872f" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨9,\\,0⟩" :db/id #edb/ref 17592186393164} {:answer/id #uuid "de3d11e8-96e8-5e70-9677-d7323e70e0d9" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨9t,\\,4⟩" :db/id #edb/ref 17592186393165}] :answer-field/correct {:answer/id #uuid "09d66d5c-4d57-5f45-b863-d859d6731c3c" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨18,\\,0⟩" :db/id #edb/ref 17592186393162} :answer-field/id #uuid "5e1a18c0-8ad6-5833-ac15-05410c96661f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393160}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31054e53-d905-5451-9de9-677fd754227a" :question/math-academy-id "q-7161" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨9{t}^{2}-12t,4t+17⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{2}-12t),\\,\\frac{\\text{d}}{\\text{d}t}(4t+17)⟩ \\\\  & =⟨18t-12,\\,4⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(18t-12),\\,\\frac{\\text{d}}{\\text{d}t}(4)⟩ \\\\  & =⟨18,\\,0⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393166 :knowledge-point/_questions [{:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb87f44-9e54-547c-bf05-ae2ff892adc9" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/id #edb/ref 17592186393168} {:answer/id #uuid "9e4c5bec-76b9-51aa-955d-d6d64eddf07d" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨6{t}^{3},\\,4⟩" :db/id #edb/ref 17592186393169} {:answer/id #uuid "783f3cce-1dea-53dc-8a90-43631ed18539" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨{t}^{4},\\,3t⟩" :db/id #edb/ref 17592186393170} {:answer/id #uuid "08c13741-b540-5324-ade7-9e8d1017f6ed" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨{t}^{3},\\,3⟩" :db/id #edb/ref 17592186393171} {:answer/id #uuid "beb86fd9-f93a-555f-a0ac-cfee71d85783" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6t⟩" :db/id #edb/ref 17592186393172}] :answer-field/correct {:answer/id #uuid "5bb87f44-9e54-547c-bf05-ae2ff892adc9" :answer/type {:db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/id #edb/ref 17592186393168} :answer-field/id #uuid "f76bc762-0563-53c1-a43e-9693c4d41279" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393167}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "018374cc-40c9-5d0d-a1b9-641708c13290" :question/math-academy-id "q-7165" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{t}^{5}}{5},\\,3{t}^{2}-1⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{5}}{5}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-1)⟩ \\\\  & =⟨{t}^{4},\\,6t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{4}),\\,\\frac{\\text{d}}{\\text{d}t}(6t)⟩ \\\\  & =⟨4{t}^{3},\\,6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393173 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3a993e-29b5-59cb-99e5-ded901d8bd0a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186393175} {:answer/id #uuid "c7002ec2-9546-5f0e-821c-ebe64ba0bd6c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186393176} {:answer/id #uuid "7366fd93-b330-5afb-bffc-fc0a9d70dc12" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{5},\\frac{2}{5},-\\frac{1}{5}⟩" :db/id #edb/ref 17592186393177} {:answer/id #uuid "3da3af95-6571-5bb0-ac07-5accef6e0a78" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186393178} {:answer/id #uuid "736a78cf-613a-5d25-a09d-d0901781721f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{17},\\frac{1}{17},\\frac{1}{17}⟩" :db/id #edb/ref 17592186393179}] :answer-field/correct {:answer/id #uuid "c7002ec2-9546-5f0e-821c-ebe64ba0bd6c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186393176} :answer-field/id #uuid "81ed75df-1ce1-5ebc-81a9-b722c6382e6e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393174}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a5f805d-9915-543e-b3c6-5d61cd49da57" :question/math-academy-id "q-71662" :question/problem "Let $c=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]$ and $d=[\\begin{aligned}1 \\\\ 3 \\\\ -3\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{1\\cdot 1+2\\cdot 3+1\\cdot (-3)}{{1}^{2}+{3}^{2}+(-3)^{2}}d \\\\  & =\\frac{4}{19}⟨1,3,-3⟩ \\\\  & =⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060401 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1003d7e-42ef-59a2-9038-178e1c676be1" :answer/type {:db/ident :answer.type/math} :answer/value "{x - 2y = 10; - x + y =-2" :db/id #edb/ref 17592186058999} {:answer/id #uuid "c4ded7fa-c1f6-5aad-8a94-f332f052ff6c" :answer/type {:db/ident :answer.type/math} :answer/value "{x - 2y = 0; - x + y = 2" :db/id #edb/ref 17592186059000} {:answer/id #uuid "e51ccf34-2862-5dcc-bb64-f8f734bc2e82" :answer/type {:db/ident :answer.type/math} :answer/value "{x + 2y = 10; x + y =-2" :db/id #edb/ref 17592186059001} {:answer/id #uuid "eac00324-c2df-502b-b5dd-ba0a44acfb6b" :answer/type {:db/ident :answer.type/math} :answer/value "{x + 2y = 1; - x + y =-2" :db/id #edb/ref 17592186059002} {:answer/id #uuid "038c96de-d924-5dda-835b-036092e680cc" :answer/type {:db/ident :answer.type/math} :answer/value "{x - 2y = 10; x + y = 2" :db/id #edb/ref 17592186059003}] :answer-field/id #uuid "f473abb5-e351-5444-b66f-186a774f8f2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058998}] :question/id #uuid "611f1d4a-3c30-50c6-9215-73810a99de02" :question/math-academy-id "q-71724" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$\\begin{bmatrix}1 & -2 & 10 \\\\ -1 & 1 & -2\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186064952 :knowledge-point/_questions [{:knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "309fb741-f2ee-5d42-a410-6d3722af473d" :answer/type {:db/ident :answer.type/math} :answer/value "1.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393181} {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393182} {:answer/id #uuid "827e042d-b06c-59c7-b91a-f5e840050abb" :answer/type {:db/ident :answer.type/math} :answer/value "2.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393183} {:answer/id #uuid "dafb3fc0-f6a1-5617-964a-36080cd6f04c" :answer/type {:db/ident :answer.type/math} :answer/value "3.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393184} {:answer/id #uuid "577baa3c-ff60-5e2e-9451-c051fd6e20b6" :answer/type {:db/ident :answer.type/math} :answer/value "4.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393185}] :answer-field/correct {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393182} :answer-field/id #uuid "89bc4a65-3fa0-525a-8a5b-ebdeb649b1a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393180}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c20eb755-854c-51a7-aed2-16e438744a82" :question/math-academy-id "q-7175" :question/problem "The position $s(t)$ of a particle (in centimeters) at time $t$ seconds is given by \n\n$$\ns(t)=\\frac{5t-10}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=2\\,\\text{s}.$" :question/requires-calculator true :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{5t-10}{t}) \\\\  & =\\frac{10}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=2,$ the velocity is\n\n$$\nv(2)=\\frac{10}{(2)^{2}}=\\frac{10}{4}=2.5.\n$$\n\nTherefore, the speed is $|2.5|=2.5\\,\\text{cm/s}.$"}] [{:db/id #edb/ref 17592186393186 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393188} {:answer/id #uuid "ce91f5ac-68b0-5d12-b408-5805719d5633" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=1-\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393189} {:answer/id #uuid "9153eb0d-2401-550a-8773-be6e4eb8e8c8" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393190} {:answer/id #uuid "adae588b-ff36-562f-b371-73f948870d37" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=t+\\frac{1}{t}" :db/id #edb/ref 17592186393191} {:answer/id #uuid "d5256482-56c1-5d4e-a0c1-dc867d2591d7" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=t-\\frac{1}{t}" :db/id #edb/ref 17592186393192}] :answer-field/correct {:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393188} :answer-field/id #uuid "0524bc50-6e64-5c83-9e81-cb4394c0bfc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e5248e4-d160-51d4-9bba-1d38c3c5aabb" :question/math-academy-id "q-7186" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=\\frac{{t}^{2}-1}{t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}-1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-{t}^{-1}) \\\\  & =1-(-{t}^{-2}) \\\\  & =1+\\frac{1}{{t}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393193 :knowledge-point/_questions [{:knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/title "Identifying Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2ddc4b0-74ef-5d8b-9bdf-ce18a05a7898" :answer/type {:db/ident :answer.type/image} :answer/value "images/fa/fa55dd7b6de34bb33f43d59978eb211a1c2f78bfcf2f9e726f5a9e5c967fef1f.png" :db/id #edb/ref 17592186393195} {:answer/id #uuid "67b7dda0-a5cf-50c4-972e-b6cfbf49f53a" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b23dac6004f438e6705187b5fda2cb4034eeac5d70bcfb95a31ac8f1ca41c700.png" :db/id #edb/ref 17592186393196} {:answer/id #uuid "1997a5ab-e4a8-5279-85db-659d59bc9902" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186393197} {:answer/id #uuid "23dc4607-d3fe-5ae5-825e-486ea309f487" :answer/type {:db/ident :answer.type/image} :answer/value "images/22/225e79155fe769efb2273d5063fce38ce305ae25a11a0276e505b08420da790a.png" :db/id #edb/ref 17592186393198} {:answer/id #uuid "bacb1889-6272-5be5-98cb-ea6bda35386a" :answer/type {:db/ident :answer.type/image} :answer/value "images/4d/4d92f7a616ce7908ecbcf2b8c32104aa348067014923377c1b692f9deaf9302f.png" :db/id #edb/ref 17592186393199}] :answer-field/correct {:answer/id #uuid "23dc4607-d3fe-5ae5-825e-486ea309f487" :answer/type {:db/ident :answer.type/image} :answer/value "images/22/225e79155fe769efb2273d5063fce38ce305ae25a11a0276e505b08420da790a.png" :db/id #edb/ref 17592186393198} :answer-field/id #uuid "e8f92f31-fa93-53be-abd0-258a50093ab8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393194}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8a8de6a-3043-5d0c-ae35-56392ae16ec8" :question/math-academy-id "q-72038" :question/problem "Which of the following is a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type I region has the property that a vertical line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type I region is the following.\n\n![](images/af/af08994008c1df01d052fbc345e6892fed33b7d82ad2de5eb55089e9a879e602.png)"}] [{:db/id #edb/ref 17592186393200 :knowledge-point/_questions [{:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5bce626-d9bb-5dbb-905a-7daed41e086c" :answer/type {:db/ident :answer.type/image} :answer/value "images/a2/a216b288b70301fb14b8f1219b909edb69ab77b08c29460b5522abc2025ab494.png" :db/id #edb/ref 17592186393202} {:answer/id #uuid "c9d47ae6-371d-5f7f-a924-edcd6ec62dd3" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186393203} {:answer/id #uuid "693ea9c7-f1ff-5a1c-b288-3ea683ff953d" :answer/type {:db/ident :answer.type/image} :answer/value "images/20/205fdc7a29c94d36b5bd8847a2600c41d7e3fd2ac0fd92947dddcb241bdae012.png" :db/id #edb/ref 17592186393204} {:answer/id #uuid "349c2643-543b-501a-b8d3-7af986d4a0af" :answer/type {:db/ident :answer.type/image} :answer/value "images/25/254691f56d0586b2cbfd75a3fce34ecc1062b0f0fde538d3885860ed1b71555c.png" :db/id #edb/ref 17592186393205} {:answer/id #uuid "d7836927-19a4-54a2-aabf-fc9fd48ada96" :answer/type {:db/ident :answer.type/image} :answer/value "images/ed/edbcc3bcef921ef736f9bd31bec56f69736c632bf835cf4c9c1c46026fda8083.png" :db/id #edb/ref 17592186393206}] :answer-field/correct {:answer/id #uuid "b5bce626-d9bb-5dbb-905a-7daed41e086c" :answer/type {:db/ident :answer.type/image} :answer/value "images/a2/a216b288b70301fb14b8f1219b909edb69ab77b08c29460b5522abc2025ab494.png" :db/id #edb/ref 17592186393202} :answer-field/id #uuid "7683d677-08f6-57b3-b924-04b4d1ba5f5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393201}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13be6924-14b7-5b8e-8469-18a97723bd20" :question/math-academy-id "q-72120" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/e4/e472070f17c47e78024217ed750690b88de87f3849818368dda1dde5d91d90d4.png)"}] [{:db/id #edb/ref 17592186079202 :knowledge-point/_questions [{:knowledge-point/id #uuid "279c5e4e-db19-584b-becb-10864fcba188" :knowledge-point/title "Finding a Position Vector Given an Acceleration Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cab57635-f418-5983-befd-a20ffd9eccbf" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨t^{3} - t^{2}, 2t^{2} - 2⟩" :db/id #edb/ref 17592186077961} {:answer/id #uuid "07395ddc-381a-5351-aed1-72fc51cba8f3" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨t^{3} - t, 2t^{2} - 2t + 6⟩" :db/id #edb/ref 17592186077962} {:answer/id #uuid "07bdef2f-8f89-5da7-a451-659a422289ec" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨2t^{3} - 2t^{2}, t^{2} - t⟩" :db/id #edb/ref 17592186077963} {:answer/id #uuid "5813ad31-b965-5f02-8647-c303e979a41a" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨t^{3} - 2t^{2} + 4t, t^{2} - 2t + 6⟩" :db/id #edb/ref 17592186077964} {:answer/id #uuid "6a559519-ac1d-518c-aa1f-2d4402a2ad96" :answer/type {:db/ident :answer.type/math} :answer/value "r = ⟨t^{3} + 4t, t^{2} - t⟩" :db/id #edb/ref 17592186077965}] :answer-field/id #uuid "ce4a844e-d0ea-58aa-9301-81a7518883c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077960}] :question/id #uuid "83a0e0a1-0c0d-5f48-8e86-38cbeffbfb71" :question/math-academy-id "q-7221" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n$a(t) = ⟨6t - 2, 4⟩$.\nGiven that the particle is at the position $(0, 0)$ and has velocity $⟨1, 4⟩$ when $t = 1$, calculate the position vector of $P$ at time $t$."}] [{:db/id #edb/ref 17592186393207 :knowledge-point/_questions [{:knowledge-point/id #uuid "0b47a8b7-722d-564e-8e7a-ad07577d6f6b" :knowledge-point/title "Determining the Rate of Change of an XY-Coordinate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21689172-4d3c-58f4-ab05-b3ede303077e" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393209} {:answer/id #uuid "f697959f-44b8-5210-9f7e-1979d2a5ae7a" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393210} {:answer/id #uuid "586238f7-2f99-5a8a-9664-756d8fb42861" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393211} {:answer/id #uuid "21422ed5-2d8c-51a5-ac65-50e7a6c83355" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393212} {:answer/id #uuid "454121d4-7104-549f-b640-3e2b0c443a68" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393213}] :answer-field/correct {:answer/id #uuid "454121d4-7104-549f-b640-3e2b0c443a68" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393213} :answer-field/id #uuid "db06fc53-130e-5887-91ac-6c046aa2906d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393208}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4c40fff-4d18-5542-8848-571c276df41d" :question/math-academy-id "q-72231" :question/problem "A particle $P$ is moving along the curve $y={x}^{2}-6x$ such that the $x$-coordinate of $P$ is changing at the rate of $3\\,\\text{cm}/\\text{s}.$ Find the rate of change of the $y$-coordinate when $x=2\\,\\text{cm}.$" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x \\\\ \\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}({x}^{2}-6x) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}-6x) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}x}{\\text{d}t}\\cdot (2x-6).\\end{aligned}\n$$\n\nNow, we can substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=3\\,\\text{cm}/\\text{s}$ and $x=2$ and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =3\\cdot (2\\cdot 2-6)\\,\\text{cm}/\\text{s} \\\\  & =-6\\,\\text{cm}/\\text{s}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339093 :knowledge-point/_questions [{:knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41853b1b-f128-539e-ab88-ca5d59dc0e05" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-4,5)" :db/id #edb/ref 17592186336656} {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337038} {:answer/id #uuid "c2e1c5a4-62d6-5436-af43-17c9bfc5613e" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,1,5)" :db/id #edb/ref 17592186337768} {:answer/id #uuid "c6b771d8-baa4-5b37-b891-b67f5cd45988" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,-5)" :db/id #edb/ref 17592186337799} {:answer/id #uuid "cd2de5c5-4809-5d29-8d83-1b351dad1988" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4,-5)" :db/id #edb/ref 17592186337836}] :answer-field/correct {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337038} :answer-field/id #uuid "d289b150-0a1d-5b56-9cb1-7dfd34466e9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14b3d36d-0d61-5644-876e-58f0a854730d" :question/math-academy-id "q-72303" :question/problem "Find the saddle point of the hyperbolic paraboloid $z-5=5(x-1)^{2}-3(y+4)^{2}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z-5 & =5(x-1)^{2}-3(y+4)^{2} \\\\ z-5 & =\\frac{(x-1)^{2}}{1/5}-\\frac{(y+4)^{2}}{1/3} \\\\ z-5 & =\\frac{(x-1)^{2}}{1/5}-\\frac{(y-(-4))^{2}}{1/3}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(1,-4,5).$"}] [{:db/id #edb/ref 17592186393214 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f817dec0-31ee-5a90-a6ae-2391b9cf9403" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,2⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393216} {:answer/id #uuid "d27aae8e-1b41-5a3d-9baf-285744999d7e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393217} {:answer/id #uuid "1898f2e5-1406-5cc8-82d7-46e5635ddabe" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393218} {:answer/id #uuid "4d956027-e0b5-5ae7-a8b7-35ca7afa539e" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,3⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393219} {:answer/id #uuid "9b764f7f-086e-5989-aeae-04810e887220" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393220}] :answer-field/correct {:answer/id #uuid "9b764f7f-086e-5989-aeae-04810e887220" :answer/type {:db/ident :answer.type/math} :answer/value "⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩=0" :db/id #edb/ref 17592186393220} :answer-field/id #uuid "d2b7a822-706f-59e1-aaeb-ea5e1255d429" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85c3a288-e595-578f-a534-db75ed9d872f" :question/math-academy-id "q-72377" :question/problem "Given the function $f(x,y)=2x{y}^{2}+xy+2x$, find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,1):$\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2x{y}^{2}+xy+2x)\\,i+\\frac{∂}{∂y}(2x{y}^{2}+xy+2x)\\,j \\\\  & =(2{y}^{2}+y+2)\\,i+(4xy+x)\\,j \\\\ ∇\\,f(1,1) & =(2(1)^{2}+(1)+2)\\,i+(4(1)(1)+(1))\\,j \\\\  & =5\\,i+5\\,j \\\\  & =⟨5,5⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,1)\\cdot ⟨x-1,\\,y-1⟩ & =0 \\\\ ⟨5,5⟩\\cdot ⟨x-1,\\,y-1⟩ & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393221 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40c24857-06a2-5e0b-85d2-5f2b717c9839" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{7}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393223} {:answer/id #uuid "54b091df-4df8-574b-ab7b-0a3fde77dee4" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393224} {:answer/id #uuid "30420fca-ad93-57fd-ba3b-06ad555ade16" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393225} {:answer/id #uuid "e0dddfb6-deca-5831-988a-cc662b273194" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393226} {:answer/id #uuid "4d2b60cb-753e-5c81-be84-11c5779434a8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}1 & 2 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393227}] :answer-field/correct {:answer/id #uuid "30420fca-ad93-57fd-ba3b-06ad555ade16" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393225} :answer-field/id #uuid "b977679f-6256-57c2-8887-0c386f7a473b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393222}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cf30e2dd-fc54-551b-b230-ad61e11fe0db" :question/math-academy-id "q-72726" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}3x-y=4 \\\\ x=-2y-1\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n{\\begin{aligned}3x-y=4 \\\\ x+2y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393228 :knowledge-point/_questions [{:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756ed00-330f-5c8c-8a4d-fbb86cdc2c8e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 5 & 4\\end{aligned}]" :db/id #edb/ref 17592186393230} {:answer/id #uuid "8dfcb35e-95c9-5403-a320-dcd7face84d5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & -5 & -4\\end{aligned}]" :db/id #edb/ref 17592186393231} {:answer/id #uuid "d3557d97-0c1d-5853-b9fd-91ee81522e54" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & -5\\end{aligned}]" :db/id #edb/ref 17592186393232} {:answer/id #uuid "7936a577-d3bd-55bd-b9c4-bfcbd8d64f15" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & -4 & 5\\end{aligned}]" :db/id #edb/ref 17592186393233} {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186393234}] :answer-field/correct {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186393234} :answer-field/id #uuid "43860d4a-16fb-54d3-8d76-5164ce10d9b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e529998-60b8-53c0-bae5-50351fb55c46" :question/math-academy-id "q-72757" :question/problem "Consider the augmented matrix $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ on $T?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+2{R}_{1}$ means that we need to add $2$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:  \n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ -2+(2)(1) & -2+(2)(3) & 1+(2)(2)\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393235 :knowledge-point/_questions [{:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76e35e5d-3d96-5355-b632-9dcb08a7d598" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 2 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186393237} {:answer/id #uuid "37c197ca-a8a9-536c-8b89-25989a9a892c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186393238} {:answer/id #uuid "3f1549bb-38c0-5786-af6b-6a9b6ef9bf0a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186393239} {:answer/id #uuid "c179bedb-d3a8-5e87-84d3-747a29243083" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 3 & 4 & -2 & 3 \\\\ 0 & 2 & -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393240} {:answer/id #uuid "eaff7f31-1a3f-5265-bb26-9a65dd39c96f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 1 & 2 \\\\ 1 & 5 & 2 & -1 \\\\ 3 & 4 & 3 & -2\\end{aligned}]" :db/id #edb/ref 17592186393241}] :answer-field/correct {:answer/id #uuid "37c197ca-a8a9-536c-8b89-25989a9a892c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]" :db/id #edb/ref 17592186393238} :answer-field/id #uuid "af067c4c-af32-5a6c-b8af-bc4ef4997af6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393236}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f1ba7f0-e4f6-511d-875d-abce33676c37" :question/math-academy-id "q-72760" :question/problem "Consider the augmented matrix $X,$ given by\n\n$$\nX=[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ on $X?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1}$ means that we need to add $-1$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1 & 5 & -1 & 2 \\\\ 3 & 4 & -2 & 3\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 1+(-1)(1) & 5+(-1)(3) & -1+(-1)(2) & 2+(-1)(1) \\\\ 3 & 4 & -2 & 3\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 2 & 1 \\\\ 0 & 2 & -3 & 1 \\\\ 3 & 4 & -2 & 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393242 :knowledge-point/_questions [{:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756e234a-8217-5c8b-abaa-69ea121a0c6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393244} {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393245} {:answer/id #uuid "1a9cf17b-a149-5bc6-9345-792b1cc2a3c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & -5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393246} {:answer/id #uuid "1d4576b0-5970-52fb-8377-b193cb931a98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393247} {:answer/id #uuid "4cfa023b-7905-5d00-83b5-528df496267c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393248}] :answer-field/correct {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393245} :answer-field/id #uuid "bdfc7f8f-fcd9-55fe-82a8-5f2ff5b50086" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2facacda-0611-5507-a35e-091ce7069bfa" :question/math-academy-id "q-72781" :question/problem "Consider the augmented matrix $N,$ given by\n\n$$\nN=[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ on $N?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ means that we need to add $-2$ times the first row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}N & =[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 2+(-2)(1) & 1+(-2)(-2) & 2+(-2)(1) & 3+(-2)(-1) \\\\ 7 & -1 & 3 & 1\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393249 :knowledge-point/_questions [{:knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb230c0d-ae6c-5b91-bc69-b46c43b715a5" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{t}{{t}^{2}+1}" :db/id #edb/ref 17592186393251} {:answer/id #uuid "6bdfcb55-fac4-5a73-87fa-24281ab750d8" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{1}{\\operatorname{ln}⁡({t}^{2}+1)}" :db/id #edb/ref 17592186393252} {:answer/id #uuid "68292ac4-6ee0-5e6f-91bd-ec10d542dd55" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{\\operatorname{ln}⁡({t}^{2}+1)}" :db/id #edb/ref 17592186393253} {:answer/id #uuid "66957c8b-c836-5083-b60f-a4cfaf5cea07" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{{t}^{2}+1}" :db/id #edb/ref 17592186393254} {:answer/id #uuid "5bf45832-46e1-5812-a6e9-ef6cb9915057" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{1}{{t}^{2}+1}" :db/id #edb/ref 17592186393255}] :answer-field/correct {:answer/id #uuid "66957c8b-c836-5083-b60f-a4cfaf5cea07" :answer/type {:db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{{t}^{2}+1}" :db/id #edb/ref 17592186393254} :answer-field/id #uuid "cc7bca80-d5b9-56af-82b2-e4c24799c712" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393250}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c45107f-9360-503e-9bf0-50d3816b1ed2" :question/math-academy-id "q-73136" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\operatorname{ln}⁡({t}^{2}+1).$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+1)) \\\\  & =\\frac{1}{{t}^{2}+1}\\cdot 2t \\\\  & =\\frac{2t}{{t}^{2}+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393256 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce3626c4-68fc-5111-92bb-c6a72ef04b3f" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186393258} {:answer/id #uuid "51976397-23e1-57d8-a039-644bf6317f62" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393259} {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393260} {:answer/id #uuid "680c2096-a3a6-56c7-af41-ad8e3a2a9b3e" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393261} {:answer/id #uuid "7e48b7d1-54ea-5e38-b291-212dbf407565" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186393262}] :answer-field/correct {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393260} :answer-field/id #uuid "ae6ae5ee-b93f-55d8-b530-ad34a29b014a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393257}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393263 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0da1a72-6c89-5d11-98ae-9debf71703d5" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[\\frac{1}{16}{(\\frac{3l}{n})}^{-3}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393265} {:answer/id #uuid "e5dd2ac8-0379-5c8c-b3a4-1deacc410ff9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[{(1+\\frac{4l}{n})}^{4}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393266} {:answer/id #uuid "ba7c5ffa-67fe-56e9-9d29-ff7f0890b0ba" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[2{(4+\\frac{l}{n})}^{-4}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186393267} {:answer/id #uuid "3fca9fa6-779a-5b52-a6cc-f0a00200679e" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[16{(\\frac{7l}{n})}^{-4}\\cdot \\frac{7}{n}]" :db/id #edb/ref 17592186393268} {:answer/id #uuid "b07e2234-565b-58f6-91ce-16a262f0a97b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[2{(1+\\frac{3l}{n})}^{-4}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186393269}] :answer-field/correct {:answer/id #uuid "b07e2234-565b-58f6-91ce-16a262f0a97b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[2{(1+\\frac{3l}{n})}^{-4}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186393269} :answer-field/id #uuid "8a1c3fa1-f1f9-597a-ac64-c7016a783d83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393264}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28b01a23-9ced-5e00-9c4d-68c57434b2da" :question/math-academy-id "q-73159" :question/problem "What is ${\\int }_{1}^{4}2{x}^{-4}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{l}=a+lΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{4}2{x}^{-4}\\text{d}x,\n$$\n\nthe function is $f(x)=2{x}^{-4},$ the lower bound is $a=1,$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-(1)}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}2{x}^{-4}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+l\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+\\frac{3l}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[2{(1+\\frac{3l}{n})}^{-4}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393270 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516433a3-ddcf-5286-911f-d1661221641b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393272} {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393273} {:answer/id #uuid "6006a006-5f33-5ef4-b609-573993a53f00" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393274} {:answer/id #uuid "8ff05667-12f6-5f44-9206-bc6cf51be751" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393275} {:answer/id #uuid "af9dfa31-4950-5539-b718-f5c060dd0d43" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393276}] :answer-field/correct {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393273} :answer-field/id #uuid "97365ecd-a18f-5653-861f-4053aa6db95b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393271}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/math-academy-id "q-73180" :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393277 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ed10303-abcb-5fbd-b21a-2926d9f054e5" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393279} {:answer/id #uuid "1488f4e3-74cc-56ab-a421-5e3963b43562" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2+\\frac{4j}{n}}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393280} {:answer/id #uuid "843176f0-4241-552c-83d3-361908acf549" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[2\\sqrt{6+\\frac{4j}{n}}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393281} {:answer/id #uuid "6fa1ac2f-9932-5ea5-85a6-30bb5bb1fe33" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(6+\\frac{4j}{n})\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393282} {:answer/id #uuid "217ee124-d8cd-5de9-a836-21a2d6d072fe" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186393283}] :answer-field/correct {:answer/id #uuid "9ed10303-abcb-5fbd-b21a-2926d9f054e5" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186393279} :answer-field/id #uuid "e168e9f1-0828-5482-b9ff-c3095fc465cb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393278}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d76772d8-d5b1-522d-b84a-c52ac6da6060" :question/math-academy-id "q-73182" :question/problem "What is ${\\int }_{2}^{6}\\sqrt{2}\\operatorname{ln}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}f({x}_{j})\\cdot Δx,\n$$\n\nwhere ${x}_{j}=a+jΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{6}\\sqrt{2}\\operatorname{ln}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\sqrt{2}\\operatorname{ln}⁡x,$ the lower bound is $a=2$ and the upper bound is $b=6.$ So, we have\n\n$$\nΔx=\\frac{6-2}{n}=\\frac{4}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{6}\\sqrt{2}\\operatorname{ln}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[f(2+j\\cdot \\frac{4}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[f(2+\\frac{4j}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{4}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393284 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df5097ab-aeed-5dd2-a4ac-84a7912ba470" :answer/type {:db/ident :answer.type/text} :answer/value "$A=1$ and $B=4$" :db/id #edb/ref 17592186393286} {:answer/id #uuid "e7c9cc94-3908-54a8-9499-857e6df7b5d2" :answer/type {:db/ident :answer.type/text} :answer/value "$A=4$ and $B=2$" :db/id #edb/ref 17592186393287} {:answer/id #uuid "a5117579-9f3d-5b5b-bd73-6a66279018b8" :answer/type {:db/ident :answer.type/text} :answer/value "$A=2$ and $B=1$" :db/id #edb/ref 17592186393288} {:answer/id #uuid "d57fb7dd-ef0f-5819-8fc5-009e2372e7ae" :answer/type {:db/ident :answer.type/text} :answer/value "$A=2$ and $B=-1$" :db/id #edb/ref 17592186393289} {:answer/id #uuid "fdc0b9fc-a2e6-5d8a-9c55-1ce7d90a1edf" :answer/type {:db/ident :answer.type/text} :answer/value "$A=-2$ and $B=-1$" :db/id #edb/ref 17592186393290}] :answer-field/correct {:answer/id #uuid "d57fb7dd-ef0f-5819-8fc5-009e2372e7ae" :answer/type {:db/ident :answer.type/text} :answer/value "$A=2$ and $B=-1$" :db/id #edb/ref 17592186393289} :answer-field/id #uuid "9e286ea8-8e5b-5a6b-a9dc-7462355f83f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e5d3142-b826-521f-9a5c-2fb700156ee4" :question/math-academy-id "q-73189" :question/problem "Given that \n\n$$\n\\frac{2x+1}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}},\n$$\n\nfind the real constants $A$ and $B.$" :question/worked-solution "Multiplying both sides of the given equality by $(x+1)^{2}$ gives\n\n$$\n\\begin{aligned}2x+1 & =A(x+1)+B.\\end{aligned}\n$$\n\nLetting $x=-1$  gives\n\n$$\n\\begin{aligned}2(-1)+1 & =A(-1+1)+B \\\\ -1 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}2(0)+1 & =A(0+1)-1 \\\\ 2 & =A\\end{aligned}\n$$\n\nTherefore, $A=2$ and $B=-1.$"}] [{:db/id #edb/ref 17592186393291 :knowledge-point/_questions [{:knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92574954-56db-5e22-8577-4044312d87ef" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,\\frac{5}{2})$" :db/id #edb/ref 17592186393293} {:answer/id #uuid "d26ac35c-3433-55c1-aba9-04ac4fb4be37" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2})$" :db/id #edb/ref 17592186393294} {:answer/id #uuid "da7d850c-c7da-5536-9a3e-8dfd4dedca68" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,2)$" :db/id #edb/ref 17592186393295} {:answer/id #uuid "9f21d78c-dfb5-5f80-8f9d-1894eb115cb5" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,\\frac{9}{4})$ and $(0,0,\\frac{7}{4})$" :db/id #edb/ref 17592186393296} {:answer/id #uuid "1d2f6bf3-3c38-5c3a-982b-11d71b8fcc1d" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,\\frac{5}{2})$ only" :db/id #edb/ref 17592186393297}] :answer-field/correct {:answer/id #uuid "d26ac35c-3433-55c1-aba9-04ac4fb4be37" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2})$" :db/id #edb/ref 17592186393294} :answer-field/id #uuid "4865ffc5-356e-5dc2-8e39-a104fadf276d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393292}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "968294df-641c-514f-b1fc-74e1ba659362" :question/math-academy-id "q-73215" :question/problem "Given the ellipsoid $\\frac{(x-3)^{2}}{12}+\\frac{(y-1)^{2}}{8}+\\frac{(z-2)^{2}}{2}=1$, find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0-3)^{2}}{12}+\\frac{(0-1)^{2}}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{3}{4}+\\frac{1}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{7}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{(z-2)^{2}}{2} & =\\frac{1}{8} \\\\ (z-2)^{2} & =\\frac{1}{4} \\\\ z-2 & =\\pm \\frac{1}{2} \\\\ z & =2\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nHence, we get the solutions $z=\\frac{3}{2}$ and $z=\\frac{5}{2}.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2}).$"}] [{:db/id #edb/ref 17592186097356 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination with Row Exchanges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be1e7bb8-9a1e-5458-a964-4b0a507198e1" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{3} & \\frac{7}{3} \\\\ 0 & 0 & 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186096031} {:answer/id #uuid "f02adf80-ad51-5b77-9de2-17a4ecf16d77" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & -\\frac{1}{2} & \\frac{1}{2} \\\\ 0 & 0 & 1 & -5\\end{bmatrix}" :db/id #edb/ref 17592186096032} {:answer/id #uuid "055acce7-97cc-5db6-81ee-578ba34b19f3" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & 2 & 7 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186096033} {:answer/id #uuid "27935cd7-d828-53cd-bfc0-5f4b23f2869f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186096034} {:answer/id #uuid "719ae79d-13da-5b25-8d45-65e4a648f56b" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 0 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186096035}] :answer-field/id #uuid "e780d91d-a5fd-57ae-9a3e-87dfda8e42d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096030}] :question/id #uuid "e85abf79-3b58-57ed-b3d6-9f31cc3b2817" :question/math-academy-id "q-73397" :question/problem "Consider the augmented matrix $M$ given by\n$M = \\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 1 & 2 & 5 & 3 \\\\ 2 & 1 & 4 & 9\\end{bmatrix}$.\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."}] [{:db/id #edb/ref 17592186393298 :knowledge-point/_questions [{:knowledge-point/id #uuid "50c01507-99a7-5328-8d74-c9e9bda51330" :knowledge-point/title "Calculating the Inverse of a 3x3 Matrix Using the Matrix of Cofactors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f6f82c2-90c5-5b86-9116-e45789f5346b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 18 \\\\ -12 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393300} {:answer/id #uuid "48104ce2-f01f-520d-9994-ff0f604fb955" :answer/type {:db/ident :answer.type/math} :answer/value "12[\\begin{aligned}0 & 0 & 12 \\\\ 1 & -4 & -18 \\\\ -3 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186393301} {:answer/id #uuid "e267455a-8414-553e-ad9e-957e9a3d2a98" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{12}[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393302} {:answer/id #uuid "792ada25-1920-5890-a2c7-80e2010138b0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & -1 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393303} {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393304}] :answer-field/correct {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393304} :answer-field/id #uuid "14ebbec9-43d1-5641-a2c2-12f7a04b7202" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393299}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d1042ad-eb6e-59f8-9dab-abab5265f662" :question/math-academy-id "q-73485" :question/problem "Find the inverse of the matrix $A=[\\begin{aligned}-2 & 0 & 4 \\\\ 4 & 3 & 1 \\\\ -1 & 0 & 0\\end{aligned}]$\ngiven that $det(A)=12.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=12\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}3 & 1 \\\\ 0 & 0\\end{aligned}| & |\\begin{aligned}4 & 1 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}4 & 3 \\\\ -1 & 0\\end{aligned}| \\\\ |\\begin{aligned}0 & 4 \\\\ 0 & 0\\end{aligned}| & |\\begin{aligned}-2 & 4 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}-2 & 0 \\\\ -1 & 0\\end{aligned}| \\\\ |\\begin{aligned}0 & 4 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}-2 & 4 \\\\ 4 & 1\\end{aligned}| & |\\begin{aligned}-2 & 0 \\\\ 4 & 3\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & -18 & -6\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 18 & -6\\end{aligned}].\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}].\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393305 :knowledge-point/_questions [{:knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84dcd969-8fc8-57ef-9240-0a47ae01dcdc" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186393307} {:answer/id #uuid "eeb19591-ba15-5e0e-8983-784d1d68d59d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186393308} {:answer/id #uuid "e2f102ba-ebea-5b42-ae75-3e35aaa4dcb9" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186393309} {:answer/id #uuid "0716f4f7-16c9-5c13-b702-47eba0dfd09b" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & \\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186393310} {:answer/id #uuid "d6ec307f-5f81-58e7-8c8e-0f70f0701a1d" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186393311}] :answer-field/correct {:answer/id #uuid "84dcd969-8fc8-57ef-9240-0a47ae01dcdc" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186393307} :answer-field/id #uuid "f86bf6ae-95b6-5b45-9f58-e55f64d234d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393306}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26bbee69-6c8f-5073-bf18-e5b7229f3605" :question/math-academy-id "q-73538" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 3x-2y=4 \\\\  & 2x-y=2.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 2 & -1 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3}\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393312 :knowledge-point/_questions [{:knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7b08e6-d085-5aaa-8d73-b963955cfc39" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{aligned}],$\n$\\,x=1$ and $y=-1$" :db/id #edb/ref 17592186393314} {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393315} {:answer/id #uuid "af523f5a-739c-5f31-b5eb-464880f8d7fb" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -4\\end{aligned}],$\n$\\,x=-5$ and $y=-4$" :db/id #edb/ref 17592186393316} {:answer/id #uuid "1b343ef7-3ddf-5c6c-94e7-03e5be9701c9" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=7$ and $y=2$" :db/id #edb/ref 17592186393317} {:answer/id #uuid "374d0aef-c48a-512b-ba16-2324cb201e02" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4\\end{aligned}],$\n$\\,x=11$ and $y=4$" :db/id #edb/ref 17592186393318}] :answer-field/correct {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393315} :answer-field/id #uuid "de9973d7-7169-5172-bb3d-d4ad9a2d6a14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393313}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e51e1e1-f4ea-594e-af90-cfd7caef02c6" :question/math-academy-id "q-73544" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 2x-4y=6 \\\\  & 4x-7y=10.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned} & x-2y=3 \\\\  & y=-2,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$"}] [{:db/id #edb/ref 17592186393319 :knowledge-point/_questions [{:knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "784ffc66-edc8-51a6-ac2b-356c0e08dea7" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393321} {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186393322} {:answer/id #uuid "12a340da-e725-5a88-a527-27d71e519f66" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393323} {:answer/id #uuid "335c8f2c-6e1a-56c3-b0b9-94d13c9ad70f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186393324} {:answer/id #uuid "0e6a6bdb-d757-58d4-980e-64a7fa142831" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & -2 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186393325}] :answer-field/correct {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186393322} :answer-field/id #uuid "240d40bc-cf1d-5886-b54c-59f3d0b765cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393320}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08ec22c2-8cd9-5dca-af3f-944499fe851c" :question/math-academy-id "q-73551" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & 5x-15y=10 \\\\  & 2x-4y=4.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 2 & -4 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 2 & 0\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393326 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c70aaa5a-5e55-5cac-9a6f-6318d6836204" :answer/type {:db/ident :answer.type/image} :answer/value "images/d0/d06dfa9b8f6e87944014aa3eb03b6f83bd43e90624ba84d5d93d1d7f4e3beea6.png" :db/id #edb/ref 17592186393328} {:answer/id #uuid "ac220e89-32ea-508e-929a-c803d138ccfe" :answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e7f02989d53152d1f2d5247f7f42d579956e49743694229d409cd266ec33e46.png" :db/id #edb/ref 17592186393329} {:answer/id #uuid "9ee90a69-8fe7-5272-8b17-1772dc5a0e90" :answer/type {:db/ident :answer.type/image} :answer/value "images/9c/9c8ed7ce4ee431e67b923ce3028819eb9f6f6b0a52cb892c93e582c31ba9d8af.png" :db/id #edb/ref 17592186393330} {:answer/id #uuid "e95ca3e9-ccf0-585e-a54f-3195d2e34519" :answer/type {:db/ident :answer.type/image} :answer/value "images/89/89b88f56878aeb33afe775e083c3775aaa701b6d293ca62e0bd3f2a78923159a.png" :db/id #edb/ref 17592186393331} {:answer/id #uuid "1d979614-76c4-5da3-9edd-dc0cf04890c3" :answer/type {:db/ident :answer.type/image} :answer/value "images/1a/1a7c98897aa0c13daff168b3804ac292c7662ee21f313ddd9e631019bcfbb814.png" :db/id #edb/ref 17592186393332}] :answer-field/correct {:answer/id #uuid "ac220e89-32ea-508e-929a-c803d138ccfe" :answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e7f02989d53152d1f2d5247f7f42d579956e49743694229d409cd266ec33e46.png" :db/id #edb/ref 17592186393329} :answer-field/id #uuid "8985fe72-57b1-51f4-bcff-4b1407775690" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393327}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3e6469c-9ac4-59c2-95ba-5849e3955d1f" :question/math-academy-id "q-73602" :question/problem "Determine the graph of the following parametrically defined curve:\n\n$$\nx=2t-1,\\,\\,\\,y=2-{t}^{2},\\,-3\\le t\\le 3.\n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=2t-1.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-7$ | $-5$ | $-3$ | $-1$ | $1$ | $3$ | $5$ |\n| $y$ | $$ | $$ | $$ | $$ | $$ | $$ | $$ |\n\n$$\n\n$$\n\nNow, we work out the $y$ values using $y=2-{t}^{2}.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-7$ | $-5$ | $-3$ | $-1$ | $1$ | $3$ | $5$ |\n| $y$ | $-7$ | $-2$ | $1$ | $2$ | $1$ | $-2$ | $-7$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](images/5c/5cd074670c05cea0c68db75c7e1a57309c017c97556e976f2db4c3bf1b358a85.png)"}] [{:db/id #edb/ref 17592186393333 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf036a0d-5682-596f-8f07-3199b4d776a1" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186393335} {:answer/id #uuid "eeb9c48f-0b61-5bdc-8a2a-e96df88d5c14" :answer/type {:db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186393336} {:answer/id #uuid "60f7b35e-f308-5048-828b-42bd129a850a" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186393337} {:answer/id #uuid "aa466513-f31a-5498-9b9e-30176cd680cd" :answer/type {:db/ident :answer.type/text} :answer/value "All the columns are non-pivot" :db/id #edb/ref 17592186393338} {:answer/id #uuid "00672e34-1cd7-5dbf-a849-6c48ad3fbe88" :answer/type {:db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186393339}] :answer-field/correct {:answer/id #uuid "bf036a0d-5682-596f-8f07-3199b4d776a1" :answer/type {:db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186393335} :answer-field/id #uuid "026b9f0e-b07b-577d-b82e-aa9c9be6839b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393334}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "882ebb4d-35c9-5b5b-8139-3566e490f853" :question/math-academy-id "q-73616" :question/problem "The row echelon form matrix $P$ is given below. What are its **non**-pivot columns?\n\n$$\nP=[\\begin{aligned}-3 & 1 & -1 \\\\ 0 & 1 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $2$ pivots in the $1$st and $2$nd columns:\n\n$$\nP=[\\begin{aligned}-3 & 1 & -1 \\\\ 0 & 1 & 6 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."}] [{:db/id #edb/ref 17592186393340 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/title "Computing a Product Involving the Inverse of an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd8e97f8-62db-59df-a835-2809adb5e257" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -6 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186393342} {:answer/id #uuid "e1f3711d-8e3f-5c0d-a6bb-bbd6d27addc4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ -9 & 1\\end{aligned}]" :db/id #edb/ref 17592186393343} {:answer/id #uuid "164bdc4b-a7d3-5f5f-a7c5-a7306117cef5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 9 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186393344} {:answer/id #uuid "e56e83a6-e9d3-5d94-bcd2-7fba1ec33e6d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 3 & -9\\end{aligned}]" :db/id #edb/ref 17592186393345} {:answer/id #uuid "09fe462f-59ae-5f04-b0f3-8af36fa3770f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 3 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186393346}] :answer-field/correct {:answer/id #uuid "bd8e97f8-62db-59df-a835-2809adb5e257" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -6 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186393342} :answer-field/id #uuid "3854ffe7-363e-5eb6-88e6-d70a996900b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393341}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd74f139-452a-58af-a7f9-3d3621835dfc" :question/math-academy-id "q-73647" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 2 \\\\ 0 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 2 & 1 & 0 \\\\ 0 & 1 & 0 & 1\\end{aligned}] &  & {R}_{1}:={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & -2 \\\\ 0 & 1 & 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{E}_{2}^{-1}=[\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}].\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -2 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}3 & -6 \\\\ 0 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186393347 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd12bc7b-1b5d-5af2-bcef-c9d0fda7d8fc" :knowledge-point/title "Computing a Product Involving the Inverse of an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7deb948-54b4-534d-b47c-0134061b79e4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 & 0 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186393349} {:answer/id #uuid "5602e756-3d3f-58a5-a71c-b94b98cc37d6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -7 & 1\\end{aligned}]" :db/id #edb/ref 17592186393350} {:answer/id #uuid "050c62ef-19a7-5c40-8ed8-e1cf8c901019" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]" :db/id #edb/ref 17592186393351} {:answer/id #uuid "cdb462c0-fff1-5ddb-a364-dbbabb1a80a7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -5 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186393352} {:answer/id #uuid "a06b094a-2282-5956-8452-5a39168baff3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 7 & 1\\end{aligned}]" :db/id #edb/ref 17592186393353}] :answer-field/correct {:answer/id #uuid "5602e756-3d3f-58a5-a71c-b94b98cc37d6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ -7 & 1\\end{aligned}]" :db/id #edb/ref 17592186393350} :answer-field/id #uuid "318e9990-85bf-5ed4-9cb7-11fc5bfe695b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393348}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71966071-c211-51cd-afce-1e8a23d5fd0a" :question/math-academy-id "q-73680" :question/problem "Find the product ${E}_{1}{E}_{2}^{-1}$, where\n\n$$\n\\begin{aligned}{E}_{1} & =[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}],\\,{E}_{2}=[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}].\\end{aligned}\n$$" :question/worked-solution "Notice that ${E}_{1}$ and ${E}_{2}$ are both elementary matrices.\n\nFirst, we need to find ${E}_{2}^{-1}.$ We write down ${E}_{2}$ and the identity matrix $I$ side-by-side (as shown below) and apply an elementary row operation that transforms the left matrix into the identity matrix:\n\n$$\n\\begin{aligned}[{E}_{2}\\,|\\,I\\,] & =[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 1 & 1 & 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 0 \\\\ 0 & 1 & -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{E}_{2}^{-1} & =[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nNow, we can find the product ${E}_{1}{E}_{2}^{-1}:$\n\n$$\n{E}_{1}{E}_{2}^{-1}=[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ -7 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186393354 :knowledge-point/_questions [{:knowledge-point/id #uuid "b9c2dc67-95ca-52f2-a292-32891000b76a" :knowledge-point/title "Identifying Parts of Cramer's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "337e147a-5271-5218-8aed-55c3c54ec560" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 6 & 0 \\\\ 7 & 0 & 0 \\\\ 3 & 5 & 0\\end{aligned}|" :db/id #edb/ref 17592186393356} {:answer/id #uuid "704944b0-e49e-562f-bad8-7861be3c2b8c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 0 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 0 & 0\\end{aligned}|" :db/id #edb/ref 17592186393357} {:answer/id #uuid "abf5d62f-18fd-51f2-b872-c68663df7dbb" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 2 & -1 \\\\ 7 & 12 & -8 \\\\ 3 & 0 & 1\\end{aligned}|" :db/id #edb/ref 17592186393358} {:answer/id #uuid "58fb2d2f-6812-5874-bc8e-04fae44f77db" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|" :db/id #edb/ref 17592186393359} {:answer/id #uuid "8778d945-5a6f-5aae-9d13-3aed9578ba3c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 6 & -1 \\\\ 12 & 0 & -8 \\\\ 0 & 5 & 1\\end{aligned}|" :db/id #edb/ref 17592186393360}] :answer-field/correct {:answer/id #uuid "58fb2d2f-6812-5874-bc8e-04fae44f77db" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|" :db/id #edb/ref 17592186393359} :answer-field/id #uuid "3e727d75-3ac2-5002-b782-a034a3d420e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dfde2756-df99-506c-8f8b-640eb254c853" :question/math-academy-id "q-73688" :question/problem "Consider the system of equations \n\n$$\n{\\begin{aligned}-4x+6y-z=2 \\\\ 7x-8z=12 \\\\ 3x+5y+z=0.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $z=\\frac{{D}_{z}}{D}$, where $D$ is the determinant of the coefficient matrix and ${D}_{z}=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}(-4)x+6y+(-1)z=2 \\\\ 7x+0y+(-8)z=12 \\\\ 3x+5y+1z=0.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\nD=|\\begin{aligned}-4 & 6 & -1 \\\\ 7 & 0 & -8 \\\\ 3 & 5 & 1\\end{aligned}|.\n$$\n\nNow, to construct ${D}_{z}$, we replace the third column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n{D}_{z}=|\\begin{aligned}-4 & 6 & 2 \\\\ 7 & 0 & 12 \\\\ 3 & 5 & 0\\end{aligned}|.\n$$"}] [{:db/id #edb/ref 17592186393361 :knowledge-point/_questions [{:knowledge-point/id #uuid "07f2ae4c-ff07-5b99-a7b0-90f460081eef" :knowledge-point/title "Solving a Singular 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61158912-48df-568f-b8c6-401043de3356" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393363} {:answer/id #uuid "b67e4f3e-f87e-52c3-931c-19e41ea8804e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393364} {:answer/id #uuid "daca8fd6-ddfa-58d2-b860-3aa870c088ee" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186393365} {:answer/id #uuid "fd3e4855-2511-5dd7-a436-6356b9877af3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2+4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393366} {:answer/id #uuid "38bce7da-e628-523d-8d9f-797bcb20aca4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393367}] :answer-field/correct {:answer/id #uuid "61158912-48df-568f-b8c6-401043de3356" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393363} :answer-field/id #uuid "6afd3c5a-4cfe-5522-860c-2a976e4f7487" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393362}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79d64547-fc54-5cd3-a6ec-b00c0e085729" :question/math-academy-id "q-73750" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x-2y=4 \\\\ -3x+6y=-12.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." :question/worked-solution "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}1 & -2 & 4 \\\\ -3 & 6 & -12\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 4 \\\\ -3 & 6 & -12\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 4 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x-2y=4 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx-2y=4.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=4+2y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=4+2y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393368 :knowledge-point/_questions [{:knowledge-point/id #uuid "655f4b04-4eec-5386-b349-7c26d6c6c586" :knowledge-point/title "Writing a Geometric Series Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18023da7-0f5f-54e5-a32b-b23c327c3d05" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}{5}^{n}" :db/id #edb/ref 17592186393370} {:answer/id #uuid "1e3a963c-dbe5-56d8-87f8-3662ed2789e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot {9}^{n-1}" :db/id #edb/ref 17592186393371} {:answer/id #uuid "d5e7820e-8646-5e07-b143-53d24ce56413" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}3\\cdot {5}^{n-1}" :db/id #edb/ref 17592186393372} {:answer/id #uuid "9748eb78-3007-5388-9263-75d72b6a9202" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot {3}^{n-1}" :db/id #edb/ref 17592186393373} {:answer/id #uuid "8314b1bb-ce08-534f-aade-1871a80a9cb1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}3\\cdot {5}^{n}" :db/id #edb/ref 17592186393374}] :answer-field/correct {:answer/id #uuid "9748eb78-3007-5388-9263-75d72b6a9202" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot {3}^{n-1}" :db/id #edb/ref 17592186393373} :answer-field/id #uuid "d53569e1-b87a-564d-a407-03c2ff0d33f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393369}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f87316fb-a6ce-5d68-823b-7e8c77e430b6" :question/math-academy-id "q-73812" :question/problem "The geometric series $5+15+45+135+405$ can be expressed using sigma notation as" :question/worked-solution "We must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=5$ and $N=5.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15}{5}=3\n$$\n\nTherefore, expressing the given geometric series in sigma notation, we obtain:\n\n$$\n\\begin{aligned}5+15+45+135+405 & ={\\sum }_{n=1}^{5}5\\cdot {3}^{n-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393375 :knowledge-point/_questions [{:knowledge-point/id #uuid "57e44759-4db8-57e3-bfb4-ce026d4d73b2" :knowledge-point/title "Writing a Geometric Series Using Sigma Notation by Calculating the Number of Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe457126-c661-5d43-942a-b8879250d937" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}6\\cdot {5}^{n-1}" :db/id #edb/ref 17592186393377} {:answer/id #uuid "d6b74bcb-03ff-5a3d-9f1a-74e91d2280bb" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}3\\cdot {5}^{n-1}" :db/id #edb/ref 17592186393378} {:answer/id #uuid "ab7f04c8-12ef-56df-89ef-b56f8ebd5c05" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot {3}^{n-1}" :db/id #edb/ref 17592186393379} {:answer/id #uuid "0b82dd5d-ba31-5515-9315-9f53afba5c91" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{6}5\\cdot {3}^{n-1}" :db/id #edb/ref 17592186393380} {:answer/id #uuid "f05be3c9-11e0-5987-af43-2ec12fd6385c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{6}3\\cdot {5}^{n-1}" :db/id #edb/ref 17592186393381}] :answer-field/correct {:answer/id #uuid "ab7f04c8-12ef-56df-89ef-b56f8ebd5c05" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot {3}^{n-1}" :db/id #edb/ref 17592186393379} :answer-field/id #uuid "5ce11faa-ff00-52f4-a531-f9769f17e8fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393376}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43253aa1-f1c3-56a5-8cb5-8d516f81788c" :question/math-academy-id "q-73817" :question/problem "The geometric series $5+15+⋯+405$ can be expressed using sigma notation as" :question/worked-solution "We must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=5.$\n\nTo find $r,$ we find the ratio of the consecutive terms ${a}_{1}$ and ${a}_{2}:$\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{15}{5}=3\n$$\n\nNow we must determine $N$ (the index of the last term). To do this, we use the fact that\n\n$$\n{a}_{N}={a}_{1}\\cdot {r}^{N-1}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{a}_{N} & ={a}_{1}\\cdot {r}^{N-1} \\\\ 405 & =5\\cdot {3}^{N-1} \\\\ 81 & ={3}^{N-1} \\\\ {3}^{4} & ={3}^{N-1} \\\\ 4 & =N-1 \\\\ N & =5.\\end{aligned}\n$$\n\nExpressing the geometric series in sigma notation, we obtain:\n\n$$\n\\begin{aligned}5+15+⋯+405 & ={\\sum }_{n=1}^{5}5\\cdot {3}^{n-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393382 :knowledge-point/_questions [{:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/title "Solving for a Vector in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70f4e517-836c-5c50-977e-ad1416e94c03" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ -3 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186393384} {:answer/id #uuid "ca13c47e-67cf-5d77-8541-fd0214e43fea" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 15 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393385} {:answer/id #uuid "3e6d5bf3-b9e8-5b63-9120-600dc92fcf16" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ -6 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186393386} {:answer/id #uuid "00253e0b-d3bd-580f-a09c-d8e1132260ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ 4 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186393387} {:answer/id #uuid "dd936bbe-f994-551d-92c8-7ca23c711e28" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 9 \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186393388}] :answer-field/correct {:answer/id #uuid "ca13c47e-67cf-5d77-8541-fd0214e43fea" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 15 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393385} :answer-field/id #uuid "ec878615-25a3-5f8c-b92d-39a683197675" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "348f7a1d-d1ce-5a20-a4c3-2efbac29746f" :question/math-academy-id "q-73936" :question/problem "Find $x$, if $4a-2x=b$ and\n\n$$\na=[\\begin{aligned}2 \\\\ 6 \\\\ -4\\end{aligned}],\\,b=[\\begin{aligned}12 \\\\ -6 \\\\ -10\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get  \n\n$$\n\\begin{aligned}4a-2x & =b \\\\ 2x & =4a-b \\\\ x & =\\frac{1}{2}(4a-b) \\\\ x & =\\frac{1}{2}(4[\\begin{aligned}2 \\\\ 6 \\\\ -4\\end{aligned}]-[\\begin{aligned}12 \\\\ -6 \\\\ -10\\end{aligned}]) \\\\ x & =\\frac{1}{2}[\\begin{aligned}-4 \\\\ 30 \\\\ -6\\end{aligned}] \\\\ x & =[\\begin{aligned}-2 \\\\ 15 \\\\ -3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393389 :knowledge-point/_questions [{:knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/title "Solving for a Vector in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f8fc0c-783c-58e6-ad4c-cbc95902e73e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186393391} {:answer/id #uuid "3ac7e760-a9db-503a-8c03-c99d6be4fb99" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186393392} {:answer/id #uuid "d1a65265-55b9-5dc9-b2b5-1df67d797575" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186393393} {:answer/id #uuid "14827b16-8c6a-52cf-b4e1-fb506542b666" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -5 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186393394} {:answer/id #uuid "6020b7ac-6b6e-5d6e-a8a5-73d59de80558" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 10 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186393395}] :answer-field/correct {:answer/id #uuid "3ac7e760-a9db-503a-8c03-c99d6be4fb99" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186393392} :answer-field/id #uuid "f22a77b1-54b3-5415-b968-606e2c4d0cd7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2567000b-57ae-5d7c-b37b-917f1f640392" :question/math-academy-id "q-73937" :question/problem "Find $x$, if $2a+5x=b$ and\n\n$$\na=[\\begin{aligned}5 \\\\ -5 \\\\ -10\\end{aligned}],\\,b=[\\begin{aligned}15 \\\\ -30 \\\\ 20\\end{aligned}].\n$$" :question/worked-solution "Using the properties of addition/subtraction and scalar multiplication of vectors to isolate $x,$ we get\n\n$$\n\\begin{aligned}2a+5x & =b \\\\ 5x & =b-2a \\\\ x & =\\frac{1}{5}(b-2a) \\\\ x & =\\frac{1}{5}([\\begin{aligned}15 \\\\ -30 \\\\ 20\\end{aligned}]-2[\\begin{aligned}5 \\\\ -5 \\\\ -10\\end{aligned}]) \\\\ x & =\\frac{1}{5}[\\begin{aligned}5 \\\\ -20 \\\\ 40\\end{aligned}] \\\\ x & =[\\begin{aligned}1 \\\\ -4 \\\\ 8\\end{aligned}].\\end{aligned}\n$$"}]}
