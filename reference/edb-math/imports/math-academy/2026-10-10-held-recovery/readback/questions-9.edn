821-5198-b8e1-e9c369ecc289" :answer/type {:db/ident :answer.type/math} :answer/value "R_{2}↔R_{2}, R_{2}:=R_{2} - \\frac{1}{2}R_{1}" :db/id #edb/ref 17592186113363}] :answer-field/id #uuid "b8815ffc-8b67-57f0-b4b6-b4aa56c9a27e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113358}] :question/id #uuid "5202eb69-24ce-5ca6-bebd-52036979fd02" :question/math-academy-id "q-31862" :question/problem "The inverse of the matrix $A$ is found using row operations, as shown below. What are the row operations corresponding to each step?\n\n$\\begin{bmatrix}A & I\\end{bmatrix}|= \\begin{bmatrix}1 & -\\left.2 & 1 & 0 \\\\ 0 & 2 & 0 & 1\\end{bmatrix}\\right|___________; ∼\\begin{bmatrix}1 & -\\left.2 & 1 & 0 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{bmatrix}\\right|___________; ∼\\begin{bmatrix}1 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & \\frac{1}{2}\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186390700 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad3e10c2-e2f1-58e8-b2f9-00f2c4c2df6f" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{31}[\\begin{aligned}3 & -2 \\\\ 8 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390702} {:answer/id #uuid "30e4ebf6-13b6-590d-9607-b5715eb73e24" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}-3 & -2 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390703} {:answer/id #uuid "7aac971d-5512-509f-afcf-e37b9c5bd0a8" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{31}[\\begin{aligned}5 & 2 \\\\ -8 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390704} {:answer/id #uuid "de4d0df2-2d46-543e-b9bd-33d2e628c41a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{31}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390705} {:answer/id #uuid "496d8420-4ee1-5bb7-a84d-0f998d3229fc" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}5 & 2 \\\\ -8 & 3\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390706}] :answer-field/correct {:answer/id #uuid "de4d0df2-2d46-543e-b9bd-33d2e628c41a" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{31}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390705} :answer-field/id #uuid "23bd791b-3244-5621-8d76-a43da7beeff2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c60618eb-8102-5d29-9fef-37f3fce33d0e" :question/math-academy-id "q-32026" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}5x-2y=1 \\\\ 8x+3y=0\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}5 & -2 \\\\ 8 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}5 & -2 \\\\ 8 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 3-(-2)\\cdot 8}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}] \\\\  & =\\frac{1}{31}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{31}[\\begin{aligned}3 & 2 \\\\ -8 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390707 :knowledge-point/_questions [{:knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf" :knowledge-point/title "Writing the Result of Dividing a Polynomial by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e3a9ca6-813b-557e-996b-e8ce90425501" :answer/type {:db/ident :answer.type/math} :answer/value "3x+4" :db/id #edb/ref 17592186390709}] :answer-field/correct {:answer/id #uuid "3e3a9ca6-813b-557e-996b-e8ce90425501" :answer/type {:db/ident :answer.type/math} :answer/value "3x+4" :db/id #edb/ref 17592186390709} :answer-field/id #uuid "f7c64c3a-1793-54e7-90a3-1036dd1e1444" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186390708} {:answer-field/choices [{:answer/id #uuid "55663d09-9928-50de-8ec4-4e6bc38a287d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186390711}] :answer-field/correct {:answer/id #uuid "55663d09-9928-50de-8ec4-4e6bc38a287d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186390711} :answer-field/id #uuid "ffe2f90d-0f12-5edf-b0f6-b57aca84d3b8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186390710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dd8a252-fb1f-53b3-92e6-39fb1930bb1d" :question/math-academy-id "q-320860" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x+4 \\\\  & x-3\\,\\enclose{longdiv}{\\,\\,3{x}^{2}-5x-10\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4x-10 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{4x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\nFrom the above, we conclude the following:\n\n| $3{x}^{2}-5x-10$ | $=$ | {{field-1}} | $+\\,\\,$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $x-3$ |  | $x-3$ |  |  |  |" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3x+4 \\\\  & x-3\\,\\enclose{longdiv}{\\,\\,3{x}^{2}-5x-10\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{2}-9x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,4x-10 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,{4x-12}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,2\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial $3{x}^{2}-5x-10$ by the linear binomial $x-3$ gives\n\n- the quotient $3x+4,$ and\n\n- the remainder $2.$\n\nTherefore, we obtain\n\n$$\n\\frac{3{x}^{2}-5x-10}{x-3}=3x+4+\\frac{2}{x-3}.\n$$"}] [{:db/id #edb/ref 17592186390712 :knowledge-point/_questions [{:knowledge-point/id #uuid "3bdfd8fc-ce8d-5950-870d-c0570ef755bf" :knowledge-point/title "Writing the Result of Dividing a Polynomial by a Linear Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbdb781-a89c-56f7-a12d-653b3869016c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186390714}] :answer-field/correct {:answer/id #uuid "afbdb781-a89c-56f7-a12d-653b3869016c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186390714} :answer-field/id #uuid "501c1e8e-3762-5b9d-be2c-6834622fc07d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186390713} {:answer-field/choices [{:answer/id #uuid "4ffd2f49-f887-5c4e-8dbd-2a8d4cd78191" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}-x+4" :db/id #edb/ref 17592186390716}] :answer-field/correct {:answer/id #uuid "4ffd2f49-f887-5c4e-8dbd-2a8d4cd78191" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}-x+4" :db/id #edb/ref 17592186390716} :answer-field/id #uuid "c7f8fa23-152c-5507-9131-2fc4aa5450f6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186390715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ae68684-3d32-56dc-9978-f459734a53fd" :question/math-academy-id "q-320865" :question/problem "Consider the following polynomial division:\n\n$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}-x+4 \\\\  & x+2\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+5{x}^{2}+2x+2\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}+2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,4x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{4x+8}_{―} \\\\  & \\,\\,\\,\\,\\,-6\\end{aligned}\n$$\n\nFrom the above, we conclude the following:\n\n| $3{x}^{3}+5{x}^{2}+2x+2$ | $=$ | {{field-1}} | $-\\,\\,$ | {{field-2}} |  |\n| --- | --- | --- | --- | --- | --- |\n| $x+2$ |  | $x+2$ |  |  |  |" :question/worked-solution "$$\n\\begin{aligned} & \\,\\,\\,\\,\\,3{x}^{2}-x+4 \\\\  & x+2\\,\\enclose{longdiv}{\\,\\,3{x}^{3}+5{x}^{2}+2x+2\\,\\,\\,} \\\\  & \\,\\,\\,\\,\\,{3{x}^{3}+6{x}^{2}}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,\\,-{x}^{2}+2x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,{-{x}^{2}-2x}_{―} \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,4x+2 \\\\  & \\,\\,\\,\\,\\,\\,\\,\\,{4x+8}_{―} \\\\  & \\,\\,\\,\\,\\,-6\\end{aligned}\n$$\n\nFrom the given polynomial division, we deduce that dividing the polynomial $3{x}^{3}+5{x}^{2}+2x+2$ by the linear binomial $x+2$ gives\n\n- the quotient $3{x}^{2}-x+4,$ and\n\n- the remainder $-6.$\n\nTherefore, we obtain\n\n$$\n\\frac{3{x}^{3}+5{x}^{2}+2x+2}{x+2}=3{x}^{2}-x+4-\\frac{6}{x+2}.\n$$"}] [{:db/id #edb/ref 17592186390717 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2cf0dd5-0db7-57a2-9870-1611db6da665" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390719} {:answer/id #uuid "be6ce68f-4c42-58da-863b-b22d6376ce30" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}-3 & -1 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390720} {:answer/id #uuid "333a570b-447e-5d5d-9439-65c7fcbb64c1" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{5}[\\begin{aligned}3 & -1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390721} {:answer/id #uuid "ae5e534f-499c-5a4d-9bd0-1ecbfeee8157" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390722} {:answer/id #uuid "f518abcf-bf8c-56aa-bf15-d5e00e0d770d" :answer/type {:db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & 1 \\\\ -2 & 3\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390723}] :answer-field/correct {:answer/id #uuid "ae5e534f-499c-5a4d-9bd0-1ecbfeee8157" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186390722} :answer-field/id #uuid "89bea882-0921-5708-a9f9-9d676afb881e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffd8425a-ff52-5722-b741-7d19394751e5" :question/math-academy-id "q-32136" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}x-y=-1 \\\\ 2x+3y=0\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}1 & -1 \\\\ 2 & 3\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{1\\cdot 3-(-1)\\cdot 2}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390724 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af53f340-3e36-5545-937e-11e307962671" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{50}[\\begin{aligned}2 & -6 \\\\ -8 & 1\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186390726} {:answer/id #uuid "f3ec4ea9-2509-5c2c-a216-2db5287d79fb" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{46}[\\begin{aligned}1 & -8 \\\\ -6 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186390727} {:answer/id #uuid "99392c81-e8f0-5fb5-ae4c-99f2a069feb9" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{50}[\\begin{aligned}1 & 6 \\\\ 8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186390728} {:answer/id #uuid "bff6331c-295a-540c-a6d8-28d96895301d" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{46}[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186390729} {:answer/id #uuid "4d16e9a1-1407-53d0-b940-8956dc7a7aa2" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186390730}] :answer-field/correct {:answer/id #uuid "4d16e9a1-1407-53d0-b940-8956dc7a7aa2" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]" :db/id #edb/ref 17592186390730} :answer-field/id #uuid "94a86967-5a41-5f2d-8c19-38b625daba3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390725}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34c426c5-7657-5020-93fd-26e20c441212" :question/math-academy-id "q-32139" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}2x+6y=46 \\\\ 8x+y=-23\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}46 \\\\ -23\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}2 & 6 \\\\ 8 & 1\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 1-6\\cdot 8}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}] \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =-\\frac{1}{46}[\\begin{aligned}1 & -6 \\\\ -8 & 2\\end{aligned}][\\begin{aligned}46 \\\\ -23\\end{aligned}]\\end{aligned}\n$$"}]}
