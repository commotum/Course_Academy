r/id #uuid "f12c77ec-9cb6-5bae-a7a4-e6c90735d0ae" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c653557a459c6fd4989737d418e22e642aeed4e03193ea08c8d55dd43ca9ede8.png" :db/id #edb/ref 17592186390675} {:answer/id #uuid "492d6d67-62e0-56d1-8a29-7869d43f0e28" :answer/type {:db/ident :answer.type/image} :answer/value "images/ef/efbb630d38c907b1ce053bd5fa9a14b305d4392b4b573cd294348f7360d2d327.png" :db/id #edb/ref 17592186390676} {:answer/id #uuid "5d556352-d259-5a3a-b309-08f3051bd6ea" :answer/type {:db/ident :answer.type/image} :answer/value "images/56/56ed5bc3bf1dd167086f6057a7c39b070055c375b9d8c9e316ac987fca404a98.png" :db/id #edb/ref 17592186390677} {:answer/id #uuid "ee06efd6-1e71-5a6b-9560-a51a9c6f979f" :answer/type {:db/ident :answer.type/image} :answer/value "images/11/11b9c82d9bc0503ea3d17d8acbe9d50f3d6a8648dd2405dcaa42bf8667b121ca.png" :db/id #edb/ref 17592186390678}] :answer-field/correct {:answer/id #uuid "5d556352-d259-5a3a-b309-08f3051bd6ea" :answer/type {:db/ident :answer.type/image} :answer/value "images/56/56ed5bc3bf1dd167086f6057a7c39b070055c375b9d8c9e316ac987fca404a98.png" :db/id #edb/ref 17592186390677} :answer-field/id #uuid "9f412805-45f5-5bfb-b60d-78aecc7af701" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390673}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8208cfa-7eb3-58e5-ba4e-3c6c7623b96c" :question/math-academy-id "q-317355" :question/problem "Which of the following is the graph of $y=-4{(\\frac{1}{4})}^{x}-3?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y=4{(\\frac{1}{4})}^{x}.$\n\n![](images/c9/c925aea9381d9ecb008b7ab609ef72817a7c8bc51a5e3ab5abf4fb33f9055730.png)\n\n- Reflect it on the $x$-axis to give $y=-4{(\\frac{1}{4})}^{x}.$ The $y$-intercept moves from $(0,4)$ to $(0,-4)$ but the horizontal asymptote stays at $y=0.$\n\n![](i