e "images/77/77ddeefbcbd24c80f6ed0bb7a29d2a43e3151436b0a60b56686b1c67ca31c738.png" :db/id #edb/ref 17592186390546} {:answer/id #uuid "f32fd0b0-49ce-539d-9672-8d020e261fbb" :answer/type {:db/ident :answer.type/image} :answer/value "images/f7/f73be44a90c4a240b316bcf7ac5586b54ed1ca4cdedfac42f055cd39086ffe2d.png" :db/id #edb/ref 17592186390547} {:answer/id #uuid "407fad6c-67c3-5a63-bb5b-a49d0b7c8b56" :answer/type {:db/ident :answer.type/image} :answer/value "images/f4/f405cfe76e1d69d7ecad35e96ced1c76c1b64130a118d881d331bcb0b119068c.png" :db/id #edb/ref 17592186390548} {:answer/id #uuid "a9519e6c-79f2-5f62-a983-2670eb2a7aba" :answer/type {:db/ident :answer.type/image} :answer/value "images/33/33f78e0590a7039f0e2e17d5bc871e0503dd3526d282b5fb76e4ef0f3b78cc28.png" :db/id #edb/ref 17592186390549} {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390550}] :answer-field/correct {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390550} :answer-field/id #uuid "49a74683-a726-5cb6-b2c2-b253e72cf78d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5e7ffcf-d49d-5dfe-9c73-ca9c0369ba7d" :question/math-academy-id "q-27538" :question/problem "Which of the following is the graph of  $y=3{(\\frac{1}{6})}^{x}-1?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](images/4c/4cdc9e4fa78513bca01fa10242ba6c3f12b31c262448a8edf350c76e84b188b8.png)\n\nNext, we plot the graph of $y=3{(\\frac{1}{6})}^{x}.$ To do this, we scale the graph above by a factor of $3.$ The $y$-intercept moves from $(0,1)$ to $(0,3)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/8e/8e7d6c5eb931f55a9f94ac33382c0e1ec9e9e49f50b3ab538d9848d6a77be665.png)\n\nFinally, we plot the graph of $y=3{(\\frac{1}{6})}^{x}-1.$ To do this, we shift the above graph $1$ unit down. The $y$-intercept moves from $(0,3)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png)"}] [{:db/id #edb/ref 17592186390551 :knowledge-point/_questions [{:knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390553} {:answer/id #uuid "3dd43261-0c67-5dec-abd5-e030f8c694d1" :answer/type {:db/ident :answer.type/image} :answer/value "images/f6/f63e49a2e8f4a0702841eb132093bf6f69b8405af25719ea8f5abbf2bd691122.png" :db/id #edb/ref 17592186390554} {:answer/id #uuid "c08648ea-dc6d-5578-89fa-a0be944fb62c" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c64e79b7c0069aaf7d4393a6879612f58f48103247b1ba7efef3531dc3986b93.png" :db/id #edb/ref 17592186390555} {:answer/id #uuid "84311dad-8f82-5f9c-ab3a-b304e0b27aae" :answer/type {:db/ident :answer.type/image} :answer/value "images/57/571e2268e6b7f41e80b71c8764d321c298fe58232e5b4c5a84ce309fa0dd3530.png" :db/id #edb/ref 17592186390556} {:answer/id #uuid "8b546f29-cf64-542e-8f37-af2b900bcda8" :answer/type {:db/ident :answer.type/image} :answer/value "images/3d/3d7af2718ba7c30956218a00da51e77db950183bd2a85dbe74107e493fd5f03b.png" :db/id #edb/ref 17592186390557}] :answer-field/correct {:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390553} :answer-field/id #uuid "b29207c3-5e76-521f-8c52-fed97e9cf151" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390552}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab17c05b-3a04-5ac4-9de0-6246c2badd83" :question/math-academy-id "q-27540" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{4})}^{x}:$\n\n![](images/e6/e648e3a5f0c844d6596d4848629c3e6749647228116bcc5da6fce250895141d5.png)\n\nNext, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}.$ To do this, we scale the graph above by a factor of $\\frac{1}{2}.$ The $y$-intercept moves from $(0,1)$ to $(0,\\frac{1}{2})$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/378016bbd17371e3dfee1e80934e76b1357139d405cb320ac5befa252da82b28.png)\n\nFinally, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3.$ To do this, we shift the above graph $3$ units down. The $y$-intercept moves from $(0,\\frac{1}{2})$ to $(0,-\\frac{5}{2})$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png)"}] [{:db/id #edb/ref 17592186390558 :knowledge-point/_questions [{:knowledge-point/id #uuid "7266d5c7-67b9-59db-b994-07dcb143af1f" :knowledge-point/title "Finding the Inverse of a Simple Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f55e55c0-cf66-509a-9583-baf6c0228213" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7x+8}{2x+1}" :db/id #edb/ref 17592186390560}] :answer-field/correct {:answer/id #uuid "f55e55c0-cf66-509a-9583-baf6c0228213" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7x+8}{2x+1}" :db/id #edb/ref 17592186390560} :answer-field/id #uuid "5a777dc6-b24f-5e76-b2c6-6cf6f51d1959" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186390559}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "212d9c4b-4962-5204-87c1-b501c43df724" :question/math-academy-id "q-276773" :question/problem "Find the inverse of the function $f(x)=\\frac{x-8}{7-2x}.$\n\n${f}^{-1}(x)=$  \n{{field-1}}" :question/worked-solution "To find ${f}^{-1}(x),$ we start by replacing $f(x)$ with $y:$\n\n$$\ny=\\frac{x-8}{7-2x}\n$$\n\nNow, interchanging $x$ and $y$ gives\n\n$$\nx=\\frac{y-8}{7-2y}.\n$$\n\nThen, we make $y$ the subject of the equation, as follows:\n\n$$\n\\begin{aligned}x & =\\frac{y-8}{7-2y} \\\\ x(7-2y) & =y-8 \\\\ 7x-2xy & =y-8 \\\\ 7x+8 & =y+2xy \\\\ 7x+8 & =y(2x+1) \\\\ y & =\\frac{7x+8}{2x+1}\\end{aligned}\n$$\n\nTherefore, the inverse function is \n\n$$\n{f}^{-1}(x)=\\frac{7x+8}{2x+1}.\n$$"}] [{:db/id #edb/ref 17592186390561 :knowledge-point/_questions [{:knowledge-point/id #uuid "f3a53bf2-3144-5da3-8ee7-54d1e6c8fd7d" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using Synthetic Division"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f617f4-9e85-5721-805a-de7db4f879fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186390563}] :answer-field/correct {:answer/id #uuid "47f617f4-9e85-5721-805a-de7db4f879fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186390563} :answer-field/id #uuid "e5657504-e53c-5b3b-93ca-e3c99a9797ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186390562}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1be43615-7dc6-54e4-af72-5f8d6df002b4" :question/math-academy-id "q-276812" :question/problem "The multiplicity of the root $x=5$ in the polynomial $p(x)={x}^{3}-8{x}^{2}+5x+50$ is{{field-1}}." :question/worked-solution "Since $x=5$ is a root of $p(x),$ the factor theorem tells us that $(x-5)$ is a factor of $p(x).$\n\nBecause $(x-5)$ is a factor of $p(x),$ we know that $(x-5)$ divides $p(x)$ with no remainder. So, to begin factoring $p(x),$ we can divide it by $(x-5)$ using synthetic division:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $5$ | $1$ | $-8$ | $5$ | $-50$ |\n|  | $↓$ | $5$ | $-15$ | $-50$ |\n|  | $1$ | $-3$ | $-10$ | $0$ |\n\nTherefore,\n\n$$\n\\frac{p(x)}{x-5}={x}^{2}-3x-10,\n$$\n\nwhich means that\n\n$$\np(x)=(x-5)({x}^{2}-3x-10).\n$$\n\nWe can factor the quadratic factor even further, and get\n\n$$\n\\begin{aligned}p(x) & =(x-5)(x+2)(x-5) \\\\  & =(x+2)(x-5)^{2}.\\end{aligned}\n$$\n\nThe factor $(x-5)$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=5$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186390564 :knowledge-point/_questions [{:knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c08254-bcec-5457-b88b-bb1b31577752" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{6}r+\\frac{1}{6}s" :db/id #edb/ref 17592186390566} {:answer/id #uuid "86737275-5bda-5fe0-92b5-103129881f25" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{6}{11}r+\\frac{5}{11}s" :db/id #edb/ref 17592186390567} {:answer/id #uuid "361d2b59-2e0b-5aa1-b524-15d353a4c2a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=r+\\frac{5}{6}s" :db/id #edb/ref 17592186390568} {:answer/id #uuid "b20f5119-753b-5441-bf91-ce6580448a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" :db/id #edb/ref 17592186390569} {:answer/id #uuid "04d1bf75-797e-5041-b68d-706cd3bf0bc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{1}{11}r+s" :db/id #edb/ref 17592186390570}] :answer-field/correct {:answer/id #uuid "b20f5119-753b-5441-bf91-ce6580448a69" :answer/type {:db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" :db/id #edb/ref 17592186390569} :answer-field/id #uuid "48dac603-f4ce-5e8e-b8da-9de99fd610ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390565}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c822bdd5-b239-5109-a43e-980b6e32d798" :question/math-academy-id "q-278288" :question/problem "![](images/ba/ba82c6b68026b0f4339c1e4fa01c4b1aa1b7aee74b74176f81bba1c0e1de259f.png)\n\nConsider the diagram above, where $\\overset{\\to }{OR}=r,$ $\\overset{\\to }{OS}=s$ and $V$ divides $\\overset{―}{RS}$ in the ratio $RV:VS=6:5.$ Find $\\overset{\\to }{OV}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OV}=\\overset{\\to }{OR}+\\overset{\\to }{RV}.\n$$\n\nWe're told that $\\overset{\\to }{OR}=r,$ so we just need to work out $\\overset{\\to }{RV}.$\n\nFirst, from $△ORS,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\overset{\\to }{RO}+\\overset{\\to }{OS} \\\\  & =-\\overset{\\to }{OR}+\\overset{\\to }{OS} \\\\  & =-r+s \\\\  & =s-r.\\end{aligned}\n$$\n\nSince $RV:VS=6:5,$ we have\n\n$$\n\\overset{\\to }{RV}=\\frac{6}{11}\\overset{\\to }{RS}=\\frac{6}{11}(s-r).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OV} & =\\overset{\\to }{OR}+\\overset{\\to }{RV} \\\\  & =r+\\frac{6}{11}(s-r) \\\\  & =\\frac{5}{11}r+\\frac{6}{11}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390571 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4654041-212f-58fc-a04c-d501e2de17cc" :answer/type {:db/ident :answer.type/image} :answer/value "images/01/01cc790392c233d00b4ab30e939230a0e7ac31708a0f568557a3e36e2cf04d67.png" :db/id #edb/ref 17592186390573} {:answer/id #uuid "7f249571-f46d-5f5e-8ba5-21a7346da5bf" :answer/type {:db/ident :answer.type/image} :answer/value "images/b8/b83ad0f69e6d4a61227c77b3dede3632accdceaa59c1bf63da8ca8bc3fe5a7f9.png" :db/id #edb/ref 17592186390574} {:answer/id #uuid "27020075-3047-50b4-b5b4-e09fd55e5be8" :answer/type {:db/ident :answer.type/image} :answer/value "images/be/be39498e5ad2c3148b254844722af707d721d7447a393a2341c6c0f6690c603e.png" :db/id #edb/ref 17592186390575} {:answer/id #uuid "ba442e50-a7b9-57fb-81af-102c16ff13ef" :answer/type {:db/ident :answer.type/image} :answer/value "images/2e/2ebda1ba75caec9c62a9758696d2c4c45b452c29088e3811edfacd03acf3cd70.png" :db/id #edb/ref 17592186390576} {:answer/id #uuid "0daced82-677b-5026-9394-ec442ba5f4f7" :answer/type {:db/ident :answer.type/image} :answer/value "images/28/28e24035715baa30e89392408359033dc402264c0fdcdc5968addaa615aedf81.png" :db/id #edb/ref 17592186390577}] :answer-field/correct {:answer/id #uuid "7f249571-f46d-5f5e-8ba5-21a7346da5bf" :answer/type {:db/ident :answer.type/image} :answer/value "images/b8/b83ad0f69e6d4a61227c77b3dede3632accdceaa59c1bf63da8ca8bc3fe5a7f9.png" :db/id #edb/ref 17592186390574} :answer-field/id #uuid "72c70cfb-3f20-5e8d-948c-ddc2a3a7f35d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efff02b-520d-5e70-beb3-91f843801d1a" :question/math-academy-id "q-28595" :question/problem "Which of the following is the graph of $y=-{e}^{x}+5?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={e}^{x}.$\n\n![](images/f5/f5983db4731c3fde0899ffc7afd602c7c82502f581742b62e69e8e6cf2d99e93.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{e}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/84/844a32e9d3640f9244b867c7411241171902c848defa0bf653b3820c3850238d.png)\n\n \n\n- Then, vertically shift it by $5$ units up to give $y=-{e}^{x}+5.$ The point $(0,-1)$ moves to $(0,4)$ and the horizontal asymptote moves from from $y=0$ to $y=5.$\n\n![](images/c4/c4cd8597702179629617890fce31272aa447a3227b74231e787a61eb4e770589.png)"}] [{:db/id #edb/ref 17592186390578 :knowledge-point/_questions [{:knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1d95b8-6f28-5ebe-ae92-d043359fa511" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,395" :db/id #edb/ref 17592186390580} {:answer/id #uuid "eed1e1d6-f081-50ba-9a0f-960b330272be" :answer/type {:db/ident :answer.type/math} :answer/value "(-2)\\cdot 8\\,395" :db/id #edb/ref 17592186390581} {:answer/id #uuid "28190f64-9c46-5f7f-af80-807614a00568" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{146}{2}" :db/id #edb/ref 17592186390582} {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390583} {:answer/id #uuid "9b4ae3e2-672a-57a7-8dcb-1c4b9825daed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-8\\,395}{146}" :db/id #edb/ref 17592186390584}] :answer-field/correct {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390583} :answer-field/id #uuid "e368a500-4f4d-5598-bf19-014504f88343" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a60a042a-0631-504b-9c2c-28fdb04eadac" :question/math-academy-id "q-288819" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+146x-8\\,395=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=146,\\,c=-8\\,395.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-8\\,395)}{1}=-8\\,395.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115711 :knowledge-point/_questions [{:knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6d89388-dd26-59c2-b62c-aef3350e1be1" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186113203} {:answer/id #uuid "11d216c9-6d94-57de-b115-a304334c27d7" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186113204} {:answer/id #uuid "2dfd62a7-b472-54ac-a2ee-4b72cf5d625f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186113205} {:answer/id #uuid "3d0a8a4e-9945-5e0d-aa15-36e66b5ab94e" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186113206} {:answer/id #uuid "5bf0683d-0d8a-5267-b81d-502d2a83be7a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186113207}] :answer-field/id #uuid "4977aa86-5719-5551-a348-c70c6f677e2a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113202}] :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0 \\le x < 2π$?\n\n1. $\\sec x = 1$\n2. $\\sec x = 2$\n3. $\\sec x = \\frac{1}{2}$"}] [{:db/id #edb/ref 17592186115713 :knowledge-point/_questions [{:knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0c131ae-15e2-51d9-b981-699dd3822a8e" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,000" :db/id #edb/ref 17592186390586} {:answer/id #uuid "4abb149a-acd5-5b9b-b236-51b85d318980" :answer/type {:db/ident :answer.type/math} :answer/value "-18\\,000" :db/id #edb/ref 17592186390587} {:answer/id #uuid "ea956b89-f42b-52b5-a970-4a7cbdfbbbcd" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\,000" :db/id #edb/ref 17592186390588} {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390589} {:answer/id #uuid "ea082471-0a98-54a0-9c3f-4a9fcbd75fcd" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,000" :db/id #edb/ref 17592186390590}] :answer-field/correct {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390589} :answer-field/id #uuid "974b5aa7-9854-5922-a33e-647715b7b09b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390585}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20eb540b-84ee-5a09-81e9-e0f110dad1d7" :question/math-academy-id "q-29179" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=2$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}\n$$\n\nNote that $x={60}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={60}^{∘}-{360}^{∘}=-{300}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](images/9c/9c8adbb0a1594ae5bacfab7f1f92993c67659839599e10ab46d5cf98896e3ec7.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nNote that $X={300}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{3} & ={300}^{∘}-{360}^{∘}=-{60}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{60}^{∘},-{300}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-60\\cdot (-300)=18\\,000\n$$"}] [{:db/id #edb/ref 17592186390591 :knowledge-point/_questions [{:knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b21c9bca-5889-5378-95f5-dc19174253a3" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,600" :db/id #edb/ref 17592186390593} {:answer/id #uuid "5637088d-2110-5861-a9e4-5418d97814d6" :answer/type {:db/ident :answer.type/math} :answer/value "14\\,175" :db/id #edb/ref 17592186390594} {:answer/id #uuid "98625043-9024-52ca-9b27-4d102460e169" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,900" :db/id #edb/ref 17592186390595} {:answer/id #uuid "a3127733-14dd-544e-9920-fd0e17095202" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,150" :db/id #edb/ref 17592186390596} {:answer/id #uuid "510c63c8-8440-585e-ac63-db0b2b6359b8" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390597}] :answer-field/correct {:answer/id #uuid "98625043-9024-52ca-9b27-4d102460e169" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,900" :db/id #edb/ref 17592186390595} :answer-field/id #uuid "c557a89c-b4c6-5e67-988d-6c588aefa937" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390592}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23dbd8da-da31-5df7-bb91-fad8d1a7bceb" :question/math-academy-id "q-29182" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})={30}^{∘}\n$$\n\nNote that $x={30}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={30}^{∘}-{360}^{∘}=-{330}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/8c/8c6e3ae6bdbfb1c66aee719f77225453992fffe6f3c6e3dfdc3f1ff92c59863a.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{30}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nNote that $X={330}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required dommain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{2} & ={330}^{∘}-{360}^{∘}=-{30}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{30}^{∘},-{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-30\\cdot (-330)=9\\,900\n$$"}] [{:db/id #edb/ref 17592186064711 :knowledge-point/_questions [{:knowledge-point/id #uuid "3497c02b-4c62-58d9-8c73-ee1a1142c429" :knowledge-point/title "Calculating the Rate of Change of a Leg Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dc9e1e5-11ce-551d-97de-0eca949cc8ac" :answer/type {:db/ident :answer.type/math} :answer/value "1350km/h" :db/id #edb/ref 17592186062294} {:answer/id #uuid "c6cc7f50-9e41-5b9f-864d-0e28be15a521" :answer/type {:db/ident :answer.type/math} :answer/value "1000km/h" :db/id #edb/ref 17592186062295} {:answer/id #uuid "cd8734e2-d020-5c3d-a702-dca63ef20d08" :answer/type {:db/ident :answer.type/math} :answer/value "975km/h" :db/id #edb/ref 17592186062296} {:answer/id #uuid "e7ff4680-bdaf-5954-b