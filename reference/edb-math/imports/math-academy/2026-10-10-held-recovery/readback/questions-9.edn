e-bb9d853a4e78" :answer/type {:db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390601} :answer-field/id #uuid "a5e7cf18-216c-59ac-8255-427849d7152c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390599}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6a50d86-9c2e-59fc-b26e-b4043bba0c39" :question/math-academy-id "q-31146" :question/problem "Which of the following is the graph of  $y={(\\frac{1}{12})}^{x}-4?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{12})}^{x}:$\n\n![](images/e2/e2f13711ca62a8a4a698e23bdfe78caca6df44d88ded27b88c517219dffbb866.png)\n\nNext, we shift this graph $4$ units down. \nThe horizontal asymptote under such a transformation becomes $y=-4,$ the $y$-intercept becomes $(0,-3).$\nThe resulting graph of $y={(\\frac{1}{12})}^{x}-4$ is shown below.\n\n![](images/dc/dc7f93220ac18ac5671b7b41de141940ca5296139b836d56755fdccf6164ed26.png)"}] [{:db/id #edb/ref 17592186390605 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee633017-5c17-575f-bdab-5f12b7319355" :knowledge-point/title "Expressing the Area Between Two Curves as an Integral Given the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1c39ec3-887e-50dc-8edd-3cdaf54b45c5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x-1+2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390607} {:answer/id #uuid "37a1fcc8-9234-5641-b7e1-5e7f084efe44" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x+1-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390608} {:answer/id #uuid "2654cacd-7b30-583d-bda0-799991c8b3bc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(2{x}^{2}-x-1)\\,\\text{d}x" :db/id #edb/ref 17592186390609} {:answer/id #uuid "9c69b59d-0c96-50b5-ba49-1c3d2aa4e633" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(2{x}^{2}+x-1)\\,\\text{d}x" :db/id #edb/ref 17592186390610} {:answer/id #uuid "ab719555-3b8a-5291-ac4c-1377d5597894" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x-1-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390611}] :answer-field/correct {:answer/id #uuid "37a1fcc8-9234-5641-b7e1-5e7f084efe44" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-1/2}^{1}(x+1-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186390608} :answer-field/id #uuid "199eb7c0-d99d-5255-b218-c8c2cfb6234c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c69be2ea-7b70-598d-bb9a-251384a82770" :question/math-academy-id "q-3121" :question/problem "![](images/9a/9a87ae2b230e66b685051ee7d13987f5f68690a07a67ade9e7af0eb870f6224f.png)\n\nWhich integral gives the area of the finite region bounded by $y=2{x}^{2}$ and $y=x+1,$ as shown above?\n\n*(Note: Figure not drawn to scale)*" :question/worked-solution "The diagram shows that the intersection points between the two graphs occur when $x=-\\frac{1}{2}$ and $x=1.$ So these will be our limits of integration.\n\nTo determine which is the lower function and which is the upper, let's draw our vertical arrow.\n\n![](images/e7/e77170aac6d81b1cfd0e93804b0c59802f28089d24aeaff065da04cabc44c172.png)\n\nThe vertical line \n\n- *enters* the region through the lower function $y=2{x}^{2},$ and\n\n- *leaves* through the upper function $y=x+1.$\n\nTherefore, the integral that gives our area is\n\n$$\n\\begin{aligned}A & ={\\int }_{-1/2}^{1}[\\,(\\text{upper function})-(\\text{lower function})\\,]\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1}[\\,(x+1)-(2{x}^{2})\\,]\\,\\text{d}x \\\\  & ={\\int }_{-1/2}^{1}(x+1-2{x}^{2})\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097224 :knowledge-point/_questions [{:knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a59a296c-f26b-57d2-9f66-3089d690018b" :answer/type {:db/ident :answer.type/text} :answer/value "$x =-6$ and $x =-2$" :db/id #edb/ref 17592186095244} {:answer/id #uuid "448169d1-793a-5de6-ab93-2ab928cd2db5" :answer/type {:db/ident :answer.type/text} :answer/value "$x =-4$ and $x = 4$" :db/id #edb/ref 17592186095245} {:answer/id #uuid "4959333a-5e8c-57af-a996-2eb528af419a" :answer/type {:db/ident :answer.type/math} :answer/value "x = 0" :db/id #edb/ref 17592186095246} {:answer/id #uuid "645b2ac0-0d2d-51c4-983b-5d9739a24c18" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 0$ and $x = 4$" :db/id #edb/ref 17592186095247} {:answer/id #uuid "7efb67cf-1659-5361-bf87-0b82d0524c62" :answer/type {:db/ident :answer.type/text} :answer/value "$x =-4$, $x = 0$, and $x = 4$" :db/id #edb/ref 17592186095248}] :answer-field/id #uuid "d1936dc6-d067-5933-92a7-774acfe3f044" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095243}] :question/id #uuid "05af1cea-c88c-5fcc-8838-0055bd7f29aa" :question/math-academy-id "q-31213" :question/problem "![](images/19/19e9763d62ca7818024bf49522a127a48dd04f76d1175c93e060a1043b6a5795.png)\n\nThe function $f(x)$ is continuous and twice-differentiable for all $x$. The graph $y = f^{″}(x)$ is shown above. At what value(s) of $x$ does $f(x)$ have a point of inflection?"}] [{:db/id #edb/ref 17592186069241 :knowledge-point/_questions [{:knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f871c9fe-ce5c-57e0-b3ab-1c1c8b065a12" :answer/type {:db/ident :answer.type/image} :answer/value "images/b5/b53396e5736d8e09a11acef07594950ee50a0c027e190f0c8eb85880cf721494.png" :db/id #edb/ref 17592186390613} {:answer/id #uuid "3dfaa41c-4be2-5d25-a838-46703edf0110" :answer/type {:db/ident :answer.type/image} :answer/value "images/a8/a84109a9d68fe4b185ede5ab47c8ea2c07acd609367b629b594ab0b8e415bc82.png" :db/id #edb/ref 17592186390614} {:answer/id #uuid "857c287c-8899-5fbc-b5f9-5a9ea6523a2e" :answer/type {:db/ident :answer.type/image} :answer/value "images/7e/7e457f65868b58c9246d17744317ad6f76a96c8bd3b024f4fe2d37523a6490fa.png" :db/id #edb/ref 17592186390615} {:answer/id #uuid "b422f31c-7ac6-593f-9a66-3623920a036a" :answer/type {:db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7aeb8d208217ee3d4.png" :db/id #edb/ref 17592186390616} {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390617}] :answer-field/correct {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390617} :answer-field/id #uuid "3f6f078f-4b80-5f34-98d4-3100f6b4d2cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390612}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3af553bc-4342-536e-bf61-1a65d8389d56" :question/math-academy-id "q-31424" :question/problem "Which of the following is the graph of $y=4{(\\frac{1}{2})}^{x}-2?$" :question/worked-solution "First, we plot the graph of $y={(\\frac{1}{2})}^{x}:$\n\n![](images/41/4100e1298857ca36288dc390501fc69dfa68fd13303101d21691d3b056f3365e.png)\n\nNext, we plot the graph of $y=4{(\\frac{1}{2})}^{x}.$ To do this, we scale the graph above by a factor of $4.$ The $y$-intercept moves from $(0,1)$ to $(0,4)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/37bb36e82a659fc52e02f2fe2aa3bdfdc11737af467db62b4694c9b63ee4ae6e.png)\n\nFinally, we plot the graph of $y=4{(\\frac{1}{2})}^{x}-2.$ To do this, we shift the above graph $2$ units down. The $y$-intercept moves from $(0,4)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-2.$\n\n![](images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png)"}] [{:db/id #edb/ref 17592186390618 :knowledge-point/_questions [{:knowledge-point/id #uuid "5fa86dd3-3bb3-54d5-8940-5dc07ae4c99f" :knowledge-point/title "Exponential Growth Functions With Horizontal and Vertical Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a493a343-cedc-5d8f-9bbe-1e7273fa7dfd" :answer/type {:db/ident :answer.type/image} :answer/value "images/bc/bc5062f2d2417f9be862cf10e152080370413daa34b28965a8f5ac597e3608a1.png" :db/id #edb/ref 17592186390620} {:answer/id #uuid "07209a50-0363-5ab2-a02e-e6fe06b321ca" :answer/type {:db/ident :answer.type/image} :answer/value "images/11/1127119b14566e32135f9e36f0d5835f7413a6643fb2c2732df8dde8a0d23155.png" :db/id #edb/ref 17592186390621} {:answer/id #uuid "26ff6fbb-9297-546a-a4e0-d5027677f3a1" :answer/type {:db/ident :answer.type/image} :answer/value "images/b6/b669aa5f756a95886182ef6d71c06fc3322192d52f18755603ef3dead48ee309.png" :db/id #edb/ref 17592186390622} {:answer/id #uuid "0438fb29-1028-5793-87c0-c7136ac83426" :answer/type {:db/ident :answer.type/image} :answer/value "images/4c/4c65c1b20467750125f3e25eb598544d4134d353c72e8bd60b48556d995fa2c7.png" :db/id #edb/ref 17592186390623} {:answer/id #uuid "7931e126-f2fe-5703-b148-0ffbf0470e2b" :answer/type {:db/ident :answer.type/image} :answer/value "images/55/559d2a03eeafc73b1ed1c8e98cb7380ea4ed0e956addfee31ed7412632133e80.png" :db/id #edb/ref 17592186390624}] :answer-field/correct {:answer/id #uuid "a493a343-cedc-5d8f-9bbe-1e7273fa7dfd" :answer/type {:db/ident :answer.type/image} :answer/value "images/bc/bc5062f2d2417f9be862cf10e152080370413daa34b28965a8f5ac597e3608a1.png" :db/id #edb/ref 17592186390620} :answer-field/id #uuid "03c22286-7565-5727-9f06-a11ad4db1ba3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390619}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3271be04-4d4e-529b-98e8-aeb7a846817c" :question/math-academy-id "q-31468" :question/problem "Which of the following is the graph of $y={3}^{x+5}-4?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- First, we plot the graph of $y={3}^{x}.$\n\n![](images/56/56f4446a00c12419f722dfd008e3cde785e759aa037fedd47911f0a783f4dfed.png)\n\n- To plot $y={3}^{x+5},$ we shift the graph of $y={3}^{x}$ horizontally by $5$ units to the left. The $y$-intercept moves from $(0,1)$ to $(-5,1),$ but the horizontal asymptote stays at $y=0.$\n\n![](images/87/871fe4053ba868f475ded7f0722ab7df20636a4db743f10c7631dede279715f1.png)\n\n- To plot $y={3}^{x+5}-4,$ we shift the graph of $y={3}^{x+5}$ vertically by $4$ units down. The point $(-5,1)$ moves to $(-5,-3)$ and the horizontal asymptote moves from $y=0$ to $y=-4.$\n\n![](images/32/3278d9e3e73ffee57ece6d0abf3343f8315c729e694f111dacef0e759dbe4ab4.png)"}] [{:db/id #edb/ref 17592186088136 :knowledge-point/_questions [{:knowledge-point/id #uuid "e9a12b49-8f77-5480-a3c7-c291e9549af1" :knowledge-point/title "Calculating the Velocity Vector at a Point in Time Given the Acceleration Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d802366-8c74-530e-bca4-0a7897af9591" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨162,\\,-3⟩" :db/id #edb/ref 17592186390626} {:answer/id #uuid "9b2b9281-2486-508a-a086-5791a4da1ad4" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨-3,\\,4⟩" :db/id #edb/ref 17592186390627} {:answer/id #uuid "51135115-c8f6-5cb8-9caa-6ed0f415e864" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨159,\\,1⟩" :db/id #edb/ref 17592186390628} {:answer/id #uuid "3f22d450-0a0d-5d31-a431-6242452be5e2" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨6,\\,-3⟩" :db/id #edb/ref 17592186390629} {:answer/id #uuid "cf9c67ed-d74b-5bfd-8830-80bbf2fd8b9a" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨162,\\,1⟩" :db/id #edb/ref 17592186390630}] :answer-field/correct {:answer/id #uuid "51135115-c8f6-5cb8-9caa-6ed0f415e864" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨159,\\,1⟩" :db/id #edb/ref 17592186390628} :answer-field/id #uuid "ea72c7cf-4601-57a4-9209-a10d3c1d61c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390625}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6b9395e-ca26-5410-b05e-eb2ce11d7f5d" :question/math-academy-id "q-31628" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨8{t}^{3},-1⟩.\n$$\n\nGiven that the particle has velocity $v=⟨-1,\\,3⟩$ when $t=1,$ calculate the velocity vector of $P$ at time $t=3.$" :question/worked-solution "To compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨8{t}^{3},-1⟩\\,\\text{d}t \\\\  & =⟨\\int 8{t}^{3}\\,\\text{d}t,\\,\\int -1\\,\\text{d}t⟩ \\\\  & =⟨2{t}^{4}+{C}_{1},\\,-t+{C}_{2}⟩.\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(1)=⟨-1,3⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}v(1) & =⟨2(1)^{4}+{C}_{1},\\,-(1)+{C}_{2}⟩ \\\\ ⟨-1,3⟩ & =⟨2+{C}_{1},\\,-1+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=-3$ and ${C}_{2}=4.$ Therefore, the velocity is given by\n\n$$\n\\begin{aligned}v(t) & =⟨2{t}^{4}-3,\\,-t+4⟩.\\end{aligned}\n$$\n\nFinally, the velocity at time $t=3$ is\n\n$$\n\\begin{aligned}v(3) & =⟨2(3)^{4}-3,\\,-(3)+4⟩ \\\\  & =⟨159,\\,1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390631 :knowledge-point/_questions [{:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89" :knowledge-point/title "Computing the Acceleration of a Particle at a Given Moment Given Its Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32546fdd-a7bc-5f44-adbe-7fccc7018419" :answer/type {:db/ident :answer.type/math} :answer/value "a(2)=⟨0,-7⟩" :db/id #edb/ref 17592186390633} {:answer/id #uuid "c5f3fe1e-8647-5528-ac28-841fd6aedf1f" :answer/type {:db/ident :answer.type/math} :answer/value "a(2)=⟨4,2⟩" :db/id #edb/ref 17592186390634} {:answer/id #uuid "39f3b276-d0dd-5beb-82b3-d44aa2913281" :answer/type {:db/ident :answer.type/math} :answer/value "a(2)=⟨4,-7⟩" :db/id #edb/ref 17592186390635} {:answer/id #uuid "daeef572-aa5f-5d41-992c-39db5f0e5628" :answer/type {:db/ident :answer.type/math} :answer/value "a(2)=⟨0,2⟩" :db/id #edb/ref 17592186390636} {:answer/id #uuid "5a6a9565-9322-5c6d-abc6-275ae9d27224" :answer/type {:db/ident :answer.type/math} :answer/value "a(2)=⟨4,-3⟩" :db/id #edb/ref 17592186390637}] :answer-field/correct {:answer/id #uuid "39f3b276-d0dd-5beb-82b3-d44aa2913281" :answer/type {:db/ident :answer.type/math} :answer/value "a(2)=⟨4,-7⟩" :db/id #edb/ref 17592186390635} :answer-field/id #uuid "ce3fed73-d6f3-5702-8279-92ba9653d466" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8e194cc-a3ff-5b1a-9395-33367dd7b040" :question/math-academy-id "q-31676" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨2{t}^{2}-4t,5t-{t}^{3}⟩.\n$$\n\nCalculate the acceleration vector $a$ at time $t=2.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}-4t),\\,\\frac{\\text{d}}{\\text{d}t}(5t-{t}^{3})⟩ \\\\  & =⟨4t-4,\\,5-3{t}^{2}⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨4(2)-4,\\,5-3(2)^{2}⟩ \\\\  & =⟨8-4,\\,5-12⟩ \\\\  & =⟨4,\\,-7⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390638 :knowledge-point/_questions [{:knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5" :knowledge-point/title "Identifying Quadrants Where a Function Is Positive or Negative Using a Sign Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9182a711-51cf-5310-bbf4-9cbe0a46a666" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390640} {:answer/id #uuid "d9f189a3-37d9-5f7b-aa21-52160e9dd0fa" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390641}] :answer-field/correct {:answer/id #uuid "9182a711-51cf-5310-bbf4-9cbe0a46a666" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390640} :answer-field/id #uuid "0b6bf6f3-b28f-52a9-806c-d0b8cedb752a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390639} {:answer-field/choices [{:answer/id #uuid "a30adbe1-cdd5-59f5-8eff-7c4058bf0143" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390643} {:answer/id #uuid "79a8e18e-8aaf-5800-a6dc-c9a7f0807e38" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390644}] :answer-field/correct {:answer/id #uuid "a30adbe1-cdd5-59f5-8eff-7c4058bf0143" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390643} :answer-field/id #uuid "eb95cfb8-9456-54bd-8bee-90f757988400" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390642} {:answer-field/choices [{:answer/id #uuid "9312c0ce-75c7-5ab1-b382-58c7a059d01c" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390646} {:answer/id #uuid "cd6c5a3b-d456-5531-9a58-97bd12b32bc4" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390647}] :answer-field/correct {:answer/id #uuid "cd6c5a3b-d456-5531-9a58-97bd12b32bc4" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390647} :answer-field/id #uuid "04208eb7-b196-513b-97d2-44b28ff0717b" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390645} {:answer-field/choices [{:answer/id #uuid "49b051d2-a870-54d8-b0d0-bc062f6639ae" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390649} {:answer/id #uuid "37807bee-a3e2-5e2b-8818-a45a3dd0dd6d" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390650}] :answer-field/correct {:answer/id #uuid "37807bee-a3e2-5e2b-8818-a45a3dd0dd6d" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390650} :answer-field/id #uuid "5e7f583d-2860-5e37-8901-180f3f0e774b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5518c6eb-7003-5091-9fd8-e6bce291454f" :question/math-academy-id "q-317169" :question/problem "Consider the expression $f(x,y)=2{x}^{3}{y}^{5}.$ Fill the table with appropriate sign of $f(x,y)$ as shown below.\n\n| $y>0$ | {{field-1}} | {{field-2}} |\n| --- | --- | --- |\n| $y<0$ | {{field-3}} | {{field-4}} |\n|  | $x<0$ | $x>0$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=0$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](images/5f/5fd85410238231152b6f905921f594af15293d6efc54b0b1ce558131a05bf6ee.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](images/e9/e95107f16eb80a06cd172c30ec78992838f974a91f9f2fa17b7c8ac77125c438.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | ${x}^{3}$ | ${y}^{5}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-1,1)$ | $-$ | $+$ | $-$ |\n| Top-Right | $(1,1)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(-1,-1)$ | $-$ | $-$ | $+$ |\n| Bottom-Right | $(1,-1)$ | $+$ | $-$ | $-$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](images/36/36e292eea1cf0be1527b2a357f1939e4c95f0202aa0ce5b91e9079da493f2155.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<0$ | $x>0$ |"}] [{:db/id #edb/ref 17592186390651 :knowledge-point/_questions [{:knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542" :knowledge-point/title "Vertical Reflections of Exponential Growth Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a771d975-2aaa-513d-bcb8-8905d9edc2ca" :answer/type {:db/ident :answer.type/image} :answer/value "images/55/5559cd21367ed24058d7f0a3f1f646feb6cbdc269cbd4128788b17cbd331a01e.png" :db/id #edb/ref 17592186390653} {:answer/id #uuid "41d7c55e-75b0-54d8-907f-70f90a5594aa" :answer/type {:db/ident :answer.type/image} :answer/value "images/b0/b05cb7e1d42380d1a1ac76139b39bbed49f429dbc43fddbae79b47e61d5659fd.png" :db/id #edb/ref 17592186390654} {:answer/id #uuid "1dd1f9e6-af1e-5909-94b9-5f25d90a06ae" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/30b885e19455654b28e87aba56427a82bfb9abe98d28dc5b542214a7fd55315f.png" :db/id #edb/ref 17592186390655} {:answer/id #uuid "bb4ddff0-6b9c-5567-88cf-552367429984" :answer/type {:db/ident :answer.type/image} :answer/value "images/7f/7fbb4a84bc3fa077711d003c7b05fa8bccfb84b31a112736363fa4de00315e54.png" :db/id #edb/ref 17592186390656} {:answer/id #uuid "b0ef6180-669c-546a-a8a2-ed7f728e356b" :answer/type {:db/ident :answer.type/image} :answer/value "images/78/7868ed246bfad0cbcb848098c39443616acf8554620537ad5cf53fa46fdaf9e0.png" :db/id #edb/ref 17592186390657}] :answer-field/correct {:answer/id #uuid "1dd1f9e6-af1e-5909-94b9-5f25d90a06ae" :answer/type {:db/ident :answer.type/image} :answer/value "images/30/30b885e19455654b28e87aba56427a82bfb9abe98d28dc5b542214a7fd55315f.png" :db/id #edb/ref 17592186390655} :answer-field/id #uuid "b9df4524-7dfb-5370-9bcc-d5a8bffd76f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390652}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6b5ac66-3c43-5e20-bd0d-692b07d708ca" :question/math-academy-id "q-317281" :question/problem "Which of the following is the graph of $y=-{3}^{x}+1?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={3}^{x}.$\n\n![](images/17/17a76468bd4f446f420d784ae479724135b2af3369a7d69f87c67507e74a8901.png)\n\n- Reflect it on the $x$-axis to give $y=-{3}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/ac/ac5e769c069b753bbf3f6a9a276b69881a3d2699afc4f62498233ecc526f5a2b.png)\n\n- Then, vertically shift it by $1$ unit up to give $y=-{3}^{x}+1.$ The point $(0,-1)$ moves to $(0,0)$ and the horizontal asymptote moves from $y=0$ to $y=1.$\n\n![](images/c6/c69c8be5828709cef483cba56d5842b973cf718e7592a8fba9e825be08204f5b.png)"}] [{:db/id #edb/ref 17592186390658 :knowledge-point/_