#{[{:db/id #edb/ref 17592186198850 :knowledge-point/_questions [{:knowledge-point/id #uuid "9df722a8-2db6-5bb8-a69c-b81b33037ab2" :knowledge-point/title "Expressing a Given Set Using a Geometric Sequence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab9b0b3f-b15e-5055-8391-6a00a8a6ab80" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3} \\cdot 2^{n}" :db/id #edb/ref 17592186196112} {:answer/id #uuid "cbfa0d86-cf70-5f60-9429-04161e6de2e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3} \\cdot 3^{n}" :db/id #edb/ref 17592186196113} {:answer/id #uuid "efe290b7-6353-5af9-b4bf-685865ed0034" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2} \\cdot 3^{n}" :db/id #edb/ref 17592186196114} {:answer/id #uuid "2c33a4ce-b38e-5507-b4b4-59c57b0f378d" :answer/type {:db/ident :answer.type/math} :answer/value "3 \\cdot 2^{n}" :db/id #edb/ref 17592186196115} {:answer/id #uuid "6547d7f2-2d9b-5294-8559-a3673ef200d8" :answer/type {:db/ident :answer.type/math} :answer/value "2^{n}" :db/id #edb/ref 17592186196116}] :answer-field/id #uuid "df590f96-bdbc-5cea-924f-b7889883e3c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186196111} {:answer-field/choices [{:answer/id #uuid "1d01f687-8a0c-58a4-9d67-1d16caba6c6e" :answer/type {:db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186196118} {:answer/id #uuid "3aeb5059-9e9d-5377-ba3f-e238cb0bd3af" :answer/type {:db/ident :answer.type/math} :answer/value "R" :db/id #edb/ref 17592186196119} {:answer/id #uuid "665b400c-0bbe-5234-8b41-b385f197622c" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186196120}] :answer-field/id #uuid "a837f807-51e1-5d8a-a302-8e17816924de" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186196117}] :question/id #uuid "4a35af51-a0e2-50d0-bbd3-1c0dc3bc52aa" :question/math-academy-id "q-183328" :question/problem "Describe the set $S = {…, 3, 6, 12, 24, 48,...}$ using a constructive definition.\n\n*Hint: Take $a_{1} = 6$ in the sequence that generates the elements of $S$.*\n\n$2^{n}$ {{field-1}} {{field-2}}"}] [{:db/id #edb/ref 17592186390183 :knowledge-point/_questions [{:knowledge-point/id #uuid "8c5f2a86-209a-5bb3-a3f2-77d679adb0a4" :knowledge-point/title "Finding the Truth Set of an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "841113e5-c450-59ac-8bc7-428da812b97a" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,4)" :db/id #edb/ref 17592186390185} {:answer/id #uuid "363dbef4-2cb5-55b3-ada6-9f3bcd340c9f" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,5)" :db/id #edb/ref 17592186390186} {:answer/id #uuid "741cd058-59eb-5e0f-860b-99e896389c5e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0]\\cup [4,5)" :db/id #edb/ref 17592186390187} {:answer/id #uuid "97dd7bff-d511-560f-b23f-ffe623aab9ba" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0]" :db/id #edb/ref 17592186390188} {:answer/id #uuid "843cf661-79b7-5be7-99ac-5624b829abad" :answer/type {:db/ident :answer.type/math} :answer/value "[4,5)" :db/id #edb/ref 17592186390189}] :answer-field/correct {:answer/id #uuid "741cd058-59eb-5e0f-860b-99e896389c5e" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0]\\cup [4,5)" :db/id #edb/ref 17592186390187} :answer-field/id #uuid "615dbf68-338e-5fff-88cf-1c09aa58eeb9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390184}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea7c3e28-1d56-569a-9351-524a75784e57" :question/math-academy-id "q-183379" :question/problem "Find the truth set of $P(x)⇔Q(x)$ given the following predicates defined over the universal set $R:$\n\n- $P(x):$ $4x-7\\ge 9$\n\n- $Q(x):$ $0<x<5$" :question/worked-solution "Since we have that\n\n$$\nP(x)⇔Q(x)≡(P(x)∧Q(x))∨(¬P(x)∧¬Q(x)),\n$$\n\n \n\nthe corresponding truth set can be found as follows:\n\n$$\n\\begin{aligned}{T}_{P⇔Q}=({T}_{P}\\cap {T}_{Q})\\cup ({\\overset{―}{T}}_{P}\\cap {\\overset{―}{T}}_{Q})\\end{aligned}\n$$\n\nNow, we note the following:\n\n- To find the the truth set of $P(x),$ we solve the inequality:\n\n$$\n\\begin{aligned}4x-7 & \\ge 9 \\\\ 4x & \\ge 16 \\\\ x & \\ge 4\\end{aligned}\n$$\n\nSo, the truth set of $P(x)$ is\n${T}_{P}=[4,\\infty ).$\nAs a result, the complement is\n${\\overset{―}{T}}_{P}=(-\\infty ,4).$\n\n- The truth set of $Q(x)$ is \n${T}_{Q}=(0,5)$ \nand its complement is\n${\\overset{―}{T}}_{Q}=(-\\infty ,0]\\cup [5,\\infty ).$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{T}_{P}\\cap {T}_{Q} & =[4,\\infty )\\cap (0,5) \\\\  & =[4,5) \\\\ {\\overset{―}{T}}_{P}\\cap {\\overset{―}{T}}_{Q} & =(-\\infty ,4)\\cap ((-\\infty ,0]\\cup [5,\\infty )) \\\\  & =(-\\infty ,0] \\\\ {T}_{P⇔Q} & =({T}_{P}\\cap {T}_{Q})\\cup ({\\overset{―}{T}}_{P}\\cap {\\overset{―}{T}}_{Q}) \\\\  & =[4,5)\\cup (-\\infty ,0] \\\\  & =(-\\infty ,0]\\cup [4,5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390190 :knowledge-point/_questions [{:knowledge-point/id #uuid "8c5f2a86-209a-5bb3-a3f2-77d679adb0a4" :knowledge-point/title "Finding the Truth Set of an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d753a55c-d8d0-5731-a1a8-f9ffa2445839" :answer/type {:db/ident :answer.type/image} :answer/value "images/fd/fd9de70b000b0e00e8a799ad8f0814cdc95ea35aa3e5e32f85a94ceabc6dd074.png" :db/id #edb/ref 17592186390192} {:answer/id #uuid "72b8ea46-0e7e-5df5-a15e-b6a3c6ac05ca" :answer/type {:db/ident :answer.type/image} :answer/value "images/ca/cabd391f691b5017dff012e9b777f82f0a1f9ce0b4c4afd0ba69bf426a00d90e.png" :db/id #edb/ref 17592186390193} {:answer/id #uuid "f7ea8b0a-b2c5-5604-a428-f7cfe010e169" :answer/type {:db/ident :answer.type/image} :answer/value "images/16/16350cd516d6707e6e4fbba819a97d97f8594590fe91a68e8024785cb52edfd5.png" :db/id #edb/ref 17592186390194} {:answer/id #uuid "97a12ce2-ec25-58ab-a8f4-d779170d2481" :answer/type {:db/ident :answer.type/image} :answer/value "images/4a/4a76d61d342fcf1503f00970b29da3d30c309f9f47b2276f3fe4d80a777cb85d.png" :db/id #edb/ref 17592186390195} {:answer/id #uuid "be266f09-d528-52fe-8dd4-049ebe7981eb" :answer/type {:db/ident :answer.type/image} :answer/value "images/78/787284a02a119aa2a2135623ad6e50ad6e82295917866d0f137ed26a14a160aa.png" :db/id #edb/ref 17592186390196}] :answer-field/correct {:answer/id #uuid "d753a55c-d8d0-5731-a1a8-f9ffa2445839" :answer/type {:db/ident :answer.type/image} :answer/value "images/fd/fd9de70b000b0e00e8a799ad8f0814cdc95ea35aa3e5e32f85a94ceabc6dd074.png" :db/id #edb/ref 17592186390192} :answer-field/id #uuid "1c6163c2-3719-5918-b769-981cb8ff76dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390191}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "413ce96a-5ec8-5c19-a317-8e0248cda7da" :question/math-academy-id "q-183380" :question/problem "![](images/20/20783ac512f10184d50d2069792fdf42e701667125b07179236a8b0524b684b2.png)\n\nThe shaded regions above represent the truth sets of predicates $P(x)$ and $Q(x),$ defined over the universal set ${R}^{2}.$ Which of the following is the truth set of $P(x)⇔Q(x)?$" :question/worked-solution "Since we have that \n\n$$\nP(x)⇔Q(x)≡(P(x)∧Q(x))∨(¬P(x)∧¬Q(x)),\n$$\n\n \n\nthe corresponding truth set can be found as follows:\n\n![](images/01/0188e215f62afde3fa730642703fb6e2b213f8864f912ac0688d35fa29bb4db2.png)\n\nThen, we sketch the set ${\\overset{―}{T}}_{P}$ and ${\\overset{―}{T}}_{Q}:$\n\n![](images/f4/f4df9eb071e2deb4c79c8928a7b9e60f3341bba827a5fbb328e864d2de9a5803.png)\n\nAs a result, ${\\overset{―}{T}}_{P}\\cap {\\overset{―}{T}}_{Q}$ is the following: \n\n![](images/f1/f17a4b0599a2dcc3d83d455c9be4e8a5033b7175c1859bfa634d2a3367553e0a.png)\n\nFinally, to get the truth set of $P(x)⇔Q(x),$ we take all the points that belong to ${T}_{P}\\cap {T}_{Q}$ or ${\\overset{―}{T}}_{P}\\cap {\\overset{―}{T}}_{Q}:$\n\n![](images/46/4683bc52b9d18e7710b593d36ca191adeee6ecbc93428e1f40dd7161794090d8.png)"}] [{:db/id #edb/ref 17592186390197 :knowledge-point/_questions [{:knowledge-point/id #uuid "dc2780ae-9b3a-5b4e-8bb6-54182f2f861b" :knowledge-point/title "Identifying Implicit Quantification"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d363f728-aa66-5b19-a97c-d48e48742201" :answer/type {:db/ident :answer.type/math} :answer/value "∃\\,m\\in N,\\,∀\\,k\\in Z,\\,4m={2}^{k}" :db/id #edb/ref 17592186390199} {:answer/id #uuid "f0310a72-8156-543b-960c-49303c278e4a" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,m\\in N,\\,∃\\,k\\in Z,\\,4m={2}^{k}" :db/id #edb/ref 17592186390200} {:answer/id #uuid "81f959eb-9f6e-5ad8-80e5-b84ef9c85004" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,m\\in N,\\,∃\\,k\\in Z,\\,{4}^{m}=2k" :db/id #edb/ref 17592186390201} {:answer/id #uuid "e72e101e-f207-57db-b003-9646cf20d58d" :answer/type {:db/ident :answer.type/math} :answer/value "∃\\,m\\in N,\\,∀\\,k\\in Z,\\,{4}^{m}=2k" :db/id #edb/ref 17592186390202} {:answer/id #uuid "084409f7-4231-5344-9334-90d31cc01da7" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,m\\in N,\\,∃\\,k\\in Z,\\,{2}^{m}=4k" :db/id #edb/ref 17592186390203}] :answer-field/correct {:answer/id #uuid "81f959eb-9f6e-5ad8-80e5-b84ef9c85004" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,m\\in N,\\,∃\\,k\\in Z,\\,{4}^{m}=2k" :db/id #edb/ref 17592186390201} :answer-field/id #uuid "bd9195b8-cb69-55a7-b387-092be2980fac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390198}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34f3f1ac-e55b-57c1-91eb-bd13e42f862d" :question/math-academy-id "q-183562" :question/problem "The natural powers of $4$ are multiples of $2.$\n\nExpress the above in formal language." :question/worked-solution "Notice that our sentence can be re-phrased as \n\nFor any natural number $m,$ we have that ${4}^{m}$ is a multiple of $2.$\n\nNow, \"${4}^{m}$ is a multiple of $2$\" means that\n\nThere exists an integer number $k$ such that ${4}^{m}=2k.$\n\nTherefore, we get the following statement:\n\nFor any natural number $m,$ there exists an integer number $k$ such that ${4}^{m}=2k.$\n\nMore formally, this reads as\n\n$∀\\,m\\in N,\\,∃\\,k\\in Z,\\,{4}^{m}=2k.$"}] [{:db/id #edb/ref 17592186390204 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1e872ac-ef9b-50d5-b74f-3f861cdda8f6" :knowledge-point/title "Identifying Equivalent Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8993d02-05c1-5755-bdfa-a2fb2c44c507" :answer/type {:db/ident :answer.type/math} :answer/value "{1,2,4,8,16,…}" :db/id #edb/ref 17592186390206} {:answer/id #uuid "87b1810e-b4b4-554f-b419-fb902787f2fd" :answer/type {:db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186390207} {:answer/id #uuid "ab3b5270-202d-5627-ace7-0db7bc5d9560" :answer/type {:db/ident :answer.type/math} :answer/value "{Z}^{+}" :db/id #edb/ref 17592186390208} {:answer/id #uuid "8ee28446-b8cd-57f2-907d-fd9a8ddaec6d" :answer/type {:db/ident :answer.type/math} :answer/value "{N}_{0}" :db/id #edb/ref 17592186390209} {:answer/id #uuid "185af2f0-e23d-5869-83a7-cba4ec18dec4" :answer/type {:db/ident :answer.type/math} :answer/value "{Q}^{+}" :db/id #edb/ref 17592186390210}] :answer-field/correct {:answer/id #uuid "ab3b5270-202d-5627-ace7-0db7bc5d9560" :answer/type {:db/ident :answer.type/math} :answer/value "{Z}^{+}" :db/id #edb/ref 17592186390208} :answer-field/id #uuid "73d241c2-c821-5ff8-abed-c9e6da232ce5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390205}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d5aed40-425c-5f52-a260-d6bf4761a77c" :question/math-academy-id "q-183591" :question/problem "Which of the following sets is equivalent to $N?$" :question/worked-solution "The set $N$ denotes the set of all natural numbers. It is equivalent to the following:\n\n$$\nN={1,2,3,…}={Z}^{+}\n$$\n\nTherefore, the correct answer is ${Z}^{+}.$\n\nThe other options are *not* equivalent to $N:$\n\n- The set ${N}_{0}$ includes the element zero, and $0\\notin N.$\n\n- The set $Z$ includes all the negative integers, and $-1\\notin N,-2\\notin N,…\\,.$\n\n- ${Q}^{+}$ is the set of positive rational numbers, and ${Q}^{+}\\ne N.$\n\n- The set ${1,2,4,8,16,…}$ does not include the elements $3,5…$ and $3\\in N,$ $5\\in N,…\\,.$"}] [{:db/id #edb/ref 17592186390211 :knowledge-point/_questions [{:knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f9d353d-65eb-5da3-aee7-94de17e15ccd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186390213} {:answer/id #uuid "2f86a433-c584-57f5-bc5b-0e6c2efc7647" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186390214} {:answer/id #uuid "1de27e93-c301-51e9-9d79-e1cda27fe190" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186390215} {:answer/id #uuid "eb9aca34-01b7-5a12-bf90-f2948eaa27d5" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186390216} {:answer/id #uuid "fe7252e8-288b-5997-838c-178333ef8643" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186390217}] :answer-field/correct {:answer/id #uuid "1de27e93-c301-51e9-9d79-e1cda27fe190" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186390215} :answer-field/id #uuid "5c76159e-4765-5e78-b848-edf1963706a1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390212}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5cba8b56-135d-52f2-8f27-ede5f8ef30f6" :question/math-academy-id "q-183619" :question/problem "$$\n∃{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in R,\\,2-{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}={w}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?" :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $x$ is *bound* since it's placed right next to the quantifier $∃:$\n\n$$\n∃\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,2-x=w\n$$\n\n- Occurrence II of the variable $x$ is *bound* since it lies within the scope of the quantifier $∃x$ that uses $x:$\n\n$$\n∃\\,x\\in R,\\,\\overset{\\text{scope of }∃x}{\\overset{⏞}{2-{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}=w}}\n$$\n\n- Occurrence III of the variable $w$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $w.$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∃{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,2-{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}={w}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\n$$\n\nTherefore, the free occurrence is \"III only.\""}] [{:db/id #edb/ref 17592186390218 :knowledge-point/_questions [{:knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eb42914-8086-5294-8034-099af7e76c6a" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186390220} {:answer/id #uuid "db29159c-b2eb-5123-82b3-4bed028db7e5" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186390221} {:answer/id #uuid "0c70261c-5553-516e-bab7-fda36d9236d1" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186390222} {:answer/id #uuid "a81762f2-7d2d-5776-86ac-47e142c084eb" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186390223} {:answer/id #uuid "a38367c0-0768-51e8-9758-f6b145bcb172" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186390224}] :answer-field/correct {:answer/id #uuid "a38367c0-0768-51e8-9758-f6b145bcb172" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186390224} :answer-field/id #uuid "d971224e-33f2-5800-afc5-8c6a88c45853" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390219}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55254c80-6a13-5f2c-a4bb-f9bcddde8c2a" :question/math-academy-id "q-183649" :question/problem "$$\n∃\\,\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in Z,\\,{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}\\,|\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?" :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $m$ is *bound* since it's placed right next to the quantifier $∃:$\n\n$$\n∃\\,\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,n\\,|\\,m\n$$\n\n- Occurrence II of the variable $n$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $n.$\n\n- Occurrence III of the variable $m$ is *bound* since it lies within the scope of the quantifier $∃m$ that uses $m:$\n\n$$\n∃\\,\\,m\\in Z,\\,\\,\\overset{\\text{scope of }∃m}{\\overset{⏞}{n\\,|\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}}}\n$$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∃\\,\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\\,|\\,{m}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\n$$\n\nTherefore, the free occurrence is \"II only.\""}] [{:db/id #edb/ref 17592186390225 :knowledge-point/_questions [{:knowledge-point/id #uuid "2c5ab572-f91e-503a-9ece-7b3c890d41c4" :knowledge-point/title "Expressing a Plain English Sentence as a Formal Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7841ea-4859-5797-92a4-9cfeb21e81b6" :answer/type {:db/ident :answer.type/math} :answer/value "x\\in Q,\\,∀\\,{x}^{3}\\in Q" :db/id #edb/ref 17592186390227} {:answer/id #uuid "69fcb4ab-c708-504d-b983-efdb53b59d4a" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,x\\in Q,\\,{x}^{3}\\in Q" :db/id #edb/ref 17592186390228} {:answer/id #uuid "b973ae29-9348-5aa6-b9a8-b78764f7e6a2" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,{x}^{3}\\in Q,\\,x\\in Q" :db/id #edb/ref 17592186390229} {:answer/id #uuid "1a6d6b77-1ece-5790-b81a-c8536ad5a560" :answer/type {:db/ident :answer.type/math} :answer/value "∃\\,x\\in Q,\\,{x}^{3}\\in Q" :db/id #edb/ref 17592186390230} {:answer/id #uuid "25e2a346-f03b-5c5d-a8c1-dd33966b5966" :answer/type {:db/ident :answer.type/math} :answer/value "∃\\,{x}^{3}\\in Q,\\,x\\in Q" :db/id #edb/ref 17592186390231}] :answer-field/correct {:answer/id #uuid "69fcb4ab-c708-504d-b983-efdb53b59d4a" :answer/type {:db/ident :answer.type/math} :answer/value "∀\\,x\\in Q,\\,{x}^{3}\\in Q" :db/id #edb/ref 17592186390228} :answer-field/id #uuid "13f19dc7-c890-557b-95d4-9719b8788616" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390226}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b10655f-7935-5b9e-9a92-9ed7fd17c1bc" :question/math-academy-id "q-183658" :question/problem "The cube of every rational number is rational.\n\nExpress the statement above in formal language." :question/worked-solution "Let's examine our statement:\n\n- The word \"every\" indicates we should use a universal quantifier, $∀.$\n\n- The sentence refers to rational numbers. So, by denoting a rational number as $x,$ we have that \n\n$$\n∀\\,x\\in Q.\n$$\n\n- Finally, the condition in the statement can be written as \n\n$$\n{x}^{3}\\in Q.\n$$\n\nTherefore, we write the statement as follows: \n\n$∀\\,x\\in Q,\\,{x}^{3}\\in Q.$"}] [{:db/id #edb/ref 17592186390232 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac5337bb-d568-5b4b-97df-c5b4595aa852" :knowledge-point/title "Completing a Proof Template"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f72d7fad-e122-5bb2-bc3b-a19ac6da0038" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{k-1}(3k-5)" :db/id #edb/ref 17592186390234} {:answer/id #uuid "5d7e85b5-56e3-5644-af6b-667da35b0383" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{k}(3k-2)" :db/id #edb/ref 17592186390235} {:answer/id #uuid "c0252b99-c056-5d83-814a-e962e87d2c8f" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{k}" :db/id #edb/ref 17592186390236} {:answer/id #uuid "32f1b565-7cec-5e7e-97b3-9b37134af661" :answer/type {:db/ident :answer.type/math} :answer/value "{3}^{k+1}(3k+1)" :db/id #edb/ref 17592186390237}] 