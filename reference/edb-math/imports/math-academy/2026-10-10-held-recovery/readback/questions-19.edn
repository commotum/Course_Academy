0ae-2527-51e9-960b-f170f93df96e" :answer/type {:db/ident :answer.type/image} :answer/value "images/27/27ba3ad2783e64a6b29d5ea488d63fc634d2a43ee01d6a77c4802da8bc06b641.png" :db/id #edb/ref 17592186394836} {:answer/id #uuid "a6ca9e1d-7076-5b73-a120-7f365e92f4c4" :answer/type {:db/ident :answer.type/image} :answer/value "images/e5/e5428cead5e96d930e52a833942a1c4452c43f3e2f6ba7c6fc39758ee83e8d81.png" :db/id #edb/ref 17592186394837} {:answer/id #uuid "55b6c46d-d1d1-5590-9b0c-83f0e901feca" :answer/type {:db/ident :answer.type/image} :answer/value "images/19/197ae7933ece17a22bdf17c2397053541891a789892813599930de273496cd78.png" :db/id #edb/ref 17592186394838} {:answer/id #uuid "547435a9-62b0-54fe-88c5-c2df65965648" :answer/type {:db/ident :answer.type/image} :answer/value "images/43/438928da5e9de5e9ba3d2abbe06b6f1f8b6b0598a0b82bec1f51824b9ef72a71.png" :db/id #edb/ref 17592186394839}] :answer-field/correct {:answer/id #uuid "547435a9-62b0-54fe-88c5-c2df65965648" :answer/type {:db/ident :answer.type/image} :answer/value "images/43/438928da5e9de5e9ba3d2abbe06b6f1f8b6b0598a0b82bec1f51824b9ef72a71.png" :db/id #edb/ref 17592186394839} :answer-field/id #uuid "7c907422-6a43-51a3-a689-8ba380b4f66e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394834}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12b718de-1f28-5ec6-b73e-0c704e48e717" :question/math-academy-id "q-90174" :question/problem "Which of the diagrams shows the solution of the following system?\n\n$$\n{\\begin{aligned}y\\le 2x \\\\ y\\le -2x\\end{aligned}\n$$" :question/worked-solution "To graph the first inequality $y\\le 2x,$ we draw the corresponding straight line $y=2x.$\n\n- Since we have an \"or equal to\" inequality, the line itself is included in the solution, so the line is solid.\n\n- The inequality refers to the $y$-values that are *less than* or equal to those on the line, so we shade *below* the line.\n\nTo graph the second inequality $y\\le -2x,$ we draw the corresponding straight line $y=-2x.$ \n\n- Since we have an \"or equal to\" inequality, the line itself is included in the solution, so the line is solid.\n\n- The inequality refers to the $y$-values that are *less than* or equal to those on the line, so we shade *below* the line.\n\nThe intersection of the solutions is the following:\n\n![](images/43/438928da5e9de5e9ba3d2abbe06b6f1f8b6b0598a0b82bec1f51824b9ef72a71.png)"}] [{:db/id #edb/ref 17592186120551 :knowledge-point/_questions [{:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66" :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fec93138-cf0b-5d3f-8a5c-8882046ae062" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|" :db/id #edb/ref 17592186394841} {:answer/id #uuid "090d23f3-9df7-5a18-ad1c-3041ca3b0b88" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}1 & -7 & 10 \\\\ -9 & -6 & 9 \\\\ 2 & 4 & -7\\end{aligned}|" :db/id #edb/ref 17592186394842} {:answer/id #uuid "c4475098-4c19-544f-a8c8-75b11b40afce" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -4 & 6 \\\\ 5 & 3 & -4\\end{aligned}|" :db/id #edb/ref 17592186394843} {:answer/id #uuid "0720eaf4-1dba-52f4-98df-0fc8cc7f0d92" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}1 & -2 & 10 \\\\ -2 & 2 & -6 \\\\ 2 & 1 & -7\\end{aligned}|" :db/id #edb/ref 17592186394844} {:answer/id #uuid "c47f2fc0-2674-5e12-89b3-daeb57faaf22" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-3 & -6 & 9 \\\\ 2 & 2 & -6 \\\\ 1 & 4 & -7\\end{aligned}|" :db/id #edb/ref 17592186394845}] :answer-field/correct {:answer/id #uuid "fec93138-cf0b-5d3f-8a5c-8882046ae062" :answer/type {:db/ident :answer.type/math} :answer/value "-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|" :db/id #edb/ref 17592186394841} :answer-field/id #uuid "294d6d11-4a04-5aed-b0e6-84671260549e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ea53fce-52af-53d1-b17c-6cd66b5ff019" :question/math-academy-id "q-91092" :question/problem "$$\n|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{32}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{32}=2$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}1 & -2 & -7 & 10 \\\\ -9 & -1 & -6 & 9 \\\\ -2 & 2 & 2 & -6 \\\\ 2 & 1 & 4 & -7\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-1){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-1 & -2 & -5 & 4 \\\\ -10 & -1 & -5 & 6 \\\\ 0 & 2 & 0 & 0 \\\\ 3 & 1 & 3 & -4\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+2}|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}| \\\\  & =-2|\\begin{aligned}-1 & -5 & 4 \\\\ -10 & -5 & 6 \\\\ 3 & 3 & -4\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162576 :knowledge-point/_questions [{:knowledge-point/id #uuid "908b96db-9463-50b5-89a3-056072c930ba" :knowledge-point/title "Using Row Operations to Create a Column of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1a477f1-10fc-50a1-981c-aae4b3c5dea0" :answer/type {:db/ident :answer.type/text} :answer/value "$R_{1}:=R_{1} - 2R_{2}$ and $R_{3}:=R_{3} - 3R_{2}$" :db/id #edb/ref 17592186160719} {:answer/id #uuid "c0333c66-4f35-5f3c-9968-610aa5423fcf" :answer/type {:db/ident :answer.type/text} :answer/value "$R_{1}:=R_{1} + 3R_{2}$ and $R_{3}:=R_{3} - 2R_{2}$" :db/id #edb/ref 17592186160720} {:answer/id #uuid "f2355978-048f-57b5-8eee-c677498630a1" :answer/type {:db/ident :answer.type/text} :answer/value "$R_{1}:=R_{1} + 2R_{2}$ and $R_{3}:=R_{3} + 3R_{2}$" :db/id #edb/ref 17592186160721} {:answer/id #uuid "175e8e59-45a0-515a-829f-30c1a15ea357" :answer/type {:db/ident :answer.type/text} :answer/value "$R_{1}:=R_{1} - 2R_{2}$ and $R_{3}:=R_{3} + 3R_{2}$" :db/id #edb/ref 17592186160722} {:answer/id #uuid "1ea804c1-eba2-5894-a0db-ce41e6af71d1" :answer/type {:db/ident :answer.type/text} :answer/value "$R_{1}:=R_{1} + 2R_{2}$ and $R_{3}:=R_{3} - 3R_{2}$" :db/id #edb/ref 17592186160723}] :answer-field/id #uuid "8c3e10ff-3c11-531e-9e12-9a991205d1f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160718}] :question/id #uuid "200a95d9-6cef-55b2-a6a6-5c194d5765aa" :question/math-academy-id "q-91163" :question/problem "$A = \\begin{bmatrix}-1 & 1 & 6 \\\\ 2 & -5 & -3 \\\\ -3 & -6 & -9\\end{bmatrix}, B = \\begin{bmatrix}3 & -9 & 0 \\\\ 2 & -5 & -3 \\\\ -9 & 9 & 0\\end{bmatrix}$\n\nBy applying elementary row operations of the form $R_{i}:=R_{i} + kR_{2}$, the matrix $A$ can be transformed into the matrix $B$. What are the elementary row operations?"}] [{:db/id #edb/ref 17592186394846 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b0edd60-2801-59d3-b9df-18bfbf8763bb" :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1de9bc2-0f30-517a-9782-a9ca1f325ab2" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{aligned}|" :db/id #edb/ref 17592186394848} {:answer/id #uuid "5ac6aa15-7074-542e-a631-82d70b92d723" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 5 & 2 \\\\ -1 & 3 & 2 \\\\ 2 & -1 & 1\\end{aligned}|" :db/id #edb/ref 17592186394849} {:answer/id #uuid "e527a465-6e77-5e69-9d55-173ec29fa087" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}11 & 17 & 11 \\\\ -6 & -1 & 11 \\\\ -1 & 1 & 10\\end{aligned}|" :db/id #edb/ref 17592186394850} {:answer/id #uuid "d8dfdaca-5484-51f8-8589-1f59e7f19eb7" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 4 & 3 \\\\ -3 & 3 & 2 \\\\ 5 & -1 & 1\\end{aligned}|" :db/id #edb/ref 17592186394851} {:answer/id #uuid "cf9d2e43-fa8b-5321-9df5-097671ef682a" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 3 & 5 \\\\ -3 & -1 & 3 \\\\ 5 & 2 & -1\\end{aligned}|" :db/id #edb/ref 17592186394852}] :answer-field/correct {:answer/id #uuid "a1de9bc2-0f30-517a-9782-a9ca1f325ab2" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{aligned}|" :db/id #edb/ref 17592186394848} :answer-field/id #uuid "be649d92-73f0-5810-94c6-ee526da83145" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5692854a-1edd-56c8-8906-b5a68a5133f6" :question/math-academy-id "q-91170" :question/problem "$$\n|\\begin{aligned}3 & -1 & 4 & 3 \\\\ 2 & 3 & 5 & 2 \\\\ -3 & -1 & 3 & 2 \\\\ 5 & 2 & -1 & 1\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary row operations to make the entries below ${a}_{12}$ equal to zero.*" :question/worked-solution "Let's make entries below ${a}_{12}=-1$ equal to zero using elementary row operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & -1 & 4 & 3 \\\\ 2 & 3 & 5 & 2 \\\\ -3 & -1 & 3 & 2 \\\\ 5 & 2 & -1 & 1\\end{aligned}| &  & \\,\\begin{aligned}{R}_{2}:={R}_{2}+3{R}_{1} \\\\ {R}_{3}:={R}_{3}+(-1){R}_{1} \\\\ {R}_{4}:={R}_{4}+2{R}_{1}\\end{aligned} \\\\  & =|\\begin{aligned}3 & -1 & 4 & 3 \\\\ 11 & 0 & 17 & 11 \\\\ -6 & 0 & -1 & -1 \\\\ 11 & 0 & 7 & 7\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $2$nd column, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & -1 & 4 & 3 \\\\ 11 & 0 & 17 & 11 \\\\ -6 & 0 & -1 & -1 \\\\ 11 & 0 & 7 & 7\\end{aligned}| \\\\  & =(-1)\\cdot (-1)^{1+2}|\\begin{aligned}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{aligned}| \\\\  & =|\\begin{aligned}11 & 17 & 11 \\\\ -6 & -1 & -1 \\\\ 11 & 7 & 7\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394853 :knowledge-point/_questions [{:knowledge-point/id #uuid "85e1fe3f-e85e-5ab4-a594-c55b84bb789a" :knowledge-point/title "Using Column Operations to Create a Row of Zeros in a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7a49d49-b987-592d-a5ab-ef5a39e415ec" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}+{C}_{3}$" :db/id #edb/ref 17592186394855} {:answer/id #uuid "a725ab5c-38ec-5280-8e6d-bf99ac6248fe" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394856} {:answer/id #uuid "c1c70665-108e-5278-aafc-0ea3f14976f7" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-2{C}_{3}$" :db/id #edb/ref 17592186394857} {:answer/id #uuid "4b2a901c-98ec-57e7-a35c-861ca187014e" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}+2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394858} {:answer/id #uuid "81d4b256-f048-5f14-a7ac-3d309b8b6fe4" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-6{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394859}] :answer-field/correct {:answer/id #uuid "a725ab5c-38ec-5280-8e6d-bf99ac6248fe" :answer/type {:db/ident :answer.type/text} :answer/value "${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}$" :db/id #edb/ref 17592186394856} :answer-field/id #uuid "788cdc09-4fc8-540a-b4a5-c69fdf43bd48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50d09abe-1ccb-5c67-80df-655b78fbf493" :question/math-academy-id "q-91192" :question/problem "$$\nA=[\\begin{aligned}4 & 2 & 2 \\\\ -6 & 7 & 1 \\\\ -7 & -5 & 2\\end{aligned}],\\,B=[\\begin{aligned}0 & 0 & 2 \\\\ -8 & 6 & 1 \\\\ -11 & -7 & 2\\end{aligned}]\n$$\n\nBy applying elementary column operations of the form ${C}_{i}:={C}_{i}+k{C}_{3},$ the matrix $A$ can be transformed into the matrix $B.$ What are the elementary column operations?" :question/worked-solution "To transform $A$ into $B,$ we need to make entries to the left of ${a}_{13}=2$ equal to $0.$\n\nTo do this, we can apply the following elementary column operations:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 2 & 2 \\\\ -6 & 7 & 1 \\\\ -7 & -5 & 2\\end{aligned}] &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}-2{C}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 2 & 2 \\\\ -8 & 7 & 1 \\\\ -11 & -5 & 2\\end{aligned}] &  & \\,\\begin{aligned}{C}_{2}:={C}_{2}-{C}_{3}\\end{aligned} \\\\  & ∼[\\begin{aligned}0 & 0 & 2 \\\\ -8 & 6 & 1 \\\\ -11 & -7 & 2\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\nTherefore, the elementary column operations are\n\n$\\,$ ${C}_{1}:={C}_{1}-2{C}_{3}\\,$ and $\\,{C}_{2}:={C}_{2}-{C}_{3}.$"}] [{:db/id #edb/ref 17592186394860 :knowledge-point/_questions [{:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66" :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "609d4aa3-2241-5f9d-b6f4-1a30887ca390" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 1 & 1 \\\\ 1 & 2 & -1 \\\\ -1 & 3 & -2\\end{aligned}|" :db/id #edb/ref 17592186394862} {:answer/id #uuid "30f3764a-811a-5eab-869c-ec0be3239d51" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 5 \\\\ -5 & 2 & 1\\end{aligned}|" :db/id #edb/ref 17592186394863} {:answer/id #uuid "5044ffe8-6af3-542a-b299-73a548e1de0f" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 1 & 1 \\\\ -1 & 2 & -1 \\\\ 2 & 3 & -2\\end{aligned}|" :db/id #edb/ref 17592186394864} {:answer/id #uuid "0d21572b-0d8b-5bbe-ae1d-2219314d5b82" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 2 & 1 \\\\ 2 & -1 & 3 \\\\ -1 & 1 & 2\\end{aligned}|" :db/id #edb/ref 17592186394865} {:answer/id #uuid "470fd86e-b0d9-5a17-a025-3164e11aa781" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}|" :db/id #edb/ref 17592186394866}] :answer-field/correct {:answer/id #uuid "470fd86e-b0d9-5a17-a025-3164e11aa781" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}|" :db/id #edb/ref 17592186394866} :answer-field/id #uuid "c480dcb0-6f15-525e-b469-6c0d8ba55637" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394861}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ff3ecd8-fc32-55c0-acc0-bdc23d568e06" :question/math-academy-id "q-91217" :question/problem "$$\n|\\begin{aligned}3 & 2 & 1 & 1 \\\\ -1 & 1 & 2 & -1 \\\\ 2 & -1 & 3 & -2 \\\\ -1 & 1 & 2 & -3\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{42}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{42}=1$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}3 & 2 & 1 & 1 \\\\ -1 & 1 & 2 & -1 \\\\ 2 & -1 & 3 & -2 \\\\ -1 & 1 & 2 & -3\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+{C}_{2} \\\\ {C}_{3}:={C}_{3}+(-2){C}_{2} \\\\ {C}_{4}:={C}_{4}+3{C}_{2}\\end{aligned} \\\\  & =|\\begin{aligned}5 & 2 & -3 & 7 \\\\ 0 & 1 & 0 & 2 \\\\ 1 & -1 & 5 & -5 \\\\ 0 & 1 & 0 & 0\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $4$th row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}5 & 2 & -3 & 7 \\\\ 0 & 1 & 0 & 2 \\\\ 1 & -1 & 5 & -5 \\\\ 0 & 1 & 0 & 0\\end{aligned}| \\\\  & =1\\cdot (-1)^{4+2}|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}5 & -3 & 7 \\\\ 0 & 0 & 2 \\\\ 1 & 5 & -5\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120553 :knowledge-point/_questions [{:knowledge-point/id #uuid "01ff3b37-83e6-506a-a6e8-07858a2bcb66" :knowledge-point/title "Reducing a 4x4 Determinant to a 3x3 Determinant Using Column Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46cd8000-1e23-5199-b2db-301eb99e864d" :answer/type {:db/ident :answer.type/math} :answer/value "2|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 8 \\\\ 1 & -1 & -7\\end{aligned}|" :db/id #edb/ref 17592186394868} {:answer/id #uuid "1289a79f-f03a-57c5-80ce-7fd42973e8bb" :answer/type {:db/ident :answer.type/math} :answer/value "2|\\begin{aligned}-4 & 2 & 1 \\\\ 2 & 1 & 2 \\\\ -3 & -2 & -3\\end{aligned}|" :db/id #edb/ref 17592186394869} {:answer/id #uuid "7a2989e5-bdd3-537a-85ba-5abd1555a897" :answer/type {:db/ident :answer.type/math} :answer/value "2|\\begin{aligned}-2 & -4 & 1 \\\\ 3 & 2 & 2 \\\\ 2 & -3 & -3\\end{aligned}|" :db/id #edb/ref 17592186394870} {:answer/id #uuid "6dd0f37a-c44f-5c54-9e1a-bd783a206783" :answer/type {:db/ident :answer.type/math} :answer/value "2|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 1 \\\\ 8 & -7 & -1\\end{aligned}|" :db/id #edb/ref 17592186394871} {:answer/id #uuid "c2ae3856-08c7-541a-9fe1-12f594788fa5" :answer/type {:db/ident :answer.type/math} :answer/value "2|\\begin{aligned}-2 & 2 & 1 \\\\ 3 & 1 & 2 \\\\ 6 & 2 & 2\\end{aligned}|" :db/id #edb/ref 17592186394872}] :answer-field/correct {:answer/id #uuid "6dd0f37a-c44f-5c54-9e1a-bd783a206783" :answer/type {:db/ident :answer.type/math} :answer/value "2|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 1 \\\\ 8 & -7 & -1\\end{aligned}|" :db/id #edb/ref 17592186394871} :answer-field/id #uuid "4b8b159e-b89f-5a64-b5d5-e5aa63c40762" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2a2b160-a569-5696-8596-179bbcebb9ee" :question/math-academy-id "q-91220" :question/problem "$$\n|\\begin{aligned}-2 & -4 & 2 & 1 \\\\ 3 & 2 & 1 & 2 \\\\ 6 & -4 & 2 & 2 \\\\ 2 & -3 & -2 & -3\\end{aligned}|\n$$\n\nConsider the above $4\\times 4$ determinant. Which of the following $3\\times 3$ determinants has the same value?\n\n*Hint: Use elementary column operations to make the entries to the left and to the right of ${a}_{33}$ equal to zero.*" :question/worked-solution "Let's make entries to the left and to the right of ${a}_{33}=2$ equal to zero using elementary column operations.\n\nSince adding a multiple of one row (or column) to another row (column) in a matrix does not change the value of its determinant, we obtain\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-2 & -4 & 2 & 1 \\\\ 3 & 2 & 1 & 2 \\\\ 6 & -4 & 2 & 2 \\\\ 2 & -3 & -2 & -3\\end{aligned}| &  & \\,\\begin{aligned}{C}_{1}:={C}_{1}+(-3){C}_{3} \\\\ {C}_{2}:={C}_{2}+2{C}_{3} \\\\ {C}_{4}:={C}_{4}+(-1){C}_{3}\\end{aligned} \\\\  & =|\\begin{aligned}-8 & 0 & 2 & -1 \\\\ 0 & 4 & 1 & 1 \\\\ 0 & 0 & 2 & 0 \\\\ 8 & -7 & -2 & -1\\end{aligned}|.\\end{aligned}\n$$\n\nExpanding the result along the $3$rd row, we get\n\n$$\n\\begin{aligned} & \\,\\,|\\begin{aligned}-8 & 0 & 2 & -1 \\\\ 0 & 4 & 1 & 1 \\\\ 0 & 0 & 2 & 0 \\\\ 8 & -7 & -2 & -1\\end{aligned}| \\\\  & =2\\cdot (-1)^{3+3}|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 1 \\\\ 8 & -7 & -1\\end{aligned}| \\\\  & =2|\\begin{aligned}-8 & 0 & -1 \\\\ 0 & 4 & 1 \\\\ 8 & -7 & -1\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394873 :knowledge-point/_questions [{:knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b40c4dd3-1d79-54b0-823b-dbcec9da032f" :answer/type {:db/ident :answer.type/math} :answer/value "52\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186394875} {:answer/id #uuid "56beaf5c-1cdd-555a-929d-05414265748d" :answer/type {:db/ident :answer.type/math} :answer/value "46\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186394876} {:answer/id #uuid "cec913c6-692b-55f2-a18c-269be0d2cbc0" :answer/type {:db/ident :answer.type/math} :answer/value "48\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186394877} {:answer/id #uuid "242e6691-583b-5dcd-9ea4-1ea760a5e7e4" :answer/type {:db/ident :answer.type/math} :answer/value "44\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186394878} {:answer/id #uuid "ea3041e7-9b3f-53a2-9125-16a47ceb3ef5" :answer/type {:db/ident :answer.type/math} :answer/value "42\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186394879}] :answer-field/correct {:answer/id #uuid "242e6691-583b-5dcd-9ea4-1ea760a5e7e4" :answer/type {:db/ident :answer.type/math} :answer/value "44\\,{\\text{in}}^{2}" :db/id #edb/ref 17592186394878} :answer-field/id #uuid "a5dd29b7-7c45-5120-8f4f-b750b0c0e6da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394874}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d119284d-a155-58d7-994e-d134bc9c1879" :question/math-academy-id "q-93343" :question/problem "![](images/3d/3d0b6b63883b58ecce92e395380b140b32946a4bb037e1829544539749412af9.png)\n\nLiz deconstructs a lantern and gets the net shown above. In the figure, the areas of two of its faces are shown. What is the total surface area of the lantern?" :question/worked-solution "The net shown corresponds to a triangular pyramid. The surface area of our pyramid consists of $1$ triangle (base) and $3$ triangles (side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =1\\times (\\text{Area of the base})+3\\times (\\text{Area of the side}) \\\\  & =1\\times 5+3\\times 13 \\\\  & =5+39 \\\\  & =44\\,{\\text{in}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162609 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a287e1-30cf-5179-8970-afcf49d2f5cf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 13 \\\\ 13 & 14\\end{aligned}]" :db/id #edb/ref 17592186394881} {:answer/id #uuid "87d59086-7fec-5d3e-af93-3090d245ddc2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & -2 \\\\ -2 & 4\\end{aligned}]" :db/id #edb/ref 17592186394882} {:answer/id #uuid "f54938d5-0c62-555d-8cc1-ab094bc352d6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186394883} {:answer/id #uuid "e24069dc-e91b-55a8-8298-875171f474a8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 1 \\\\ 1 & 17\\end{aligned}]" :db/id #edb/ref 17592186394884} {:answer/id #uuid "65ce5b0c-4582-517a-abb7-afa64972ba57" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 3 & 4\\end{aligned}]" :db/id #edb/ref 17592186394885}] :answer-field/correct {:answer/id #uuid "14a287e1-30cf-5179-8970-afcf49d2f5cf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 13 \\\\ 13 & 14\\end{aligned}]" :db/id #edb/ref 17592186394881} :answer-field/id #uuid "9e354856-dfba-5b4c-b973-04f47aaf9d4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1981982e-98dc-5f26-a882-3a23d659ddac" :question/math-academy-id "q-93738" :question/problem "$$\nA=[\\begin{aligned}-2 & 1 \\\\ 1 & 5\\end{aligned}],\\,P=[\\begin{aligned}1 & -1 \\\\ 1 & 2\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}1 & -1 \\\\ 1 & 2\\end{aligned}]}^{T}[\\begin{aligned}-2 & 1 \\\\ 1 & 5\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}-2 & 1 \\\\ 1 & 5\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 6 \\\\ 4 & 9\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 13 \\\\ 13 & 14\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162613 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c4037e5-607d-5cc4-9ce8-f7f1cd2c5aae" :knowledge-point/title "Reducing a Quadratic Form to Canonical Form Using Lagrange's Method: 2D-Case"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f46c58e-63d2-51eb-97a1-bc02006a4284" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} - x_{2}$" :db/id #edb/ref 17592186160941} {:answer/id #uuid "b738e8c2-02bc-5e2b-93e4-6e8fd638c205" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $x_{1} + 2x_{2}$" :db/id #edb/ref 17592186160942} {:answer/id #uuid "bb54de60-e5c1-5356-b28e-3110f44ca0a0" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ and $x_{1} - 2x_{2}$" :db/id #edb/ref 17592186160943} {:answer/id #uuid "44a507af-390e-540c-a968-f14b13f1f83b" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} + x_{2}$" :db/id #edb/ref 17592186160944} {:answer/id #uuid "466be8ad-cfa1-52ee-ac6d-362b60d15abb" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} + 2x_{2}$" :db/id #edb/ref 17592186160945}] :answer-field/id #uuid "8ba7d30b-f7e8-562f-a571-a275da00a2bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186160940}] :question/id #uuid "ca11e17a-4464-5c54-bbb1-cb2d8dc175df" :question/math-academy-id "q-93838" :question/problem "Lagrange's method can be used to reduce the quadratic form $Q(x) = 2x_{1}^{2} - 4x_{1}x_{2} - x_{2}^{2}$ to the canonical form given below.\n\n$2y_{1}^{2} - 3y_{2}^{2}, {y_{1} = x_{1} - x_{2}; y_{2} = x_{2}$\n\nFrom left to right, what is missing from the blank spaces?"}] [{:db/id #edb/ref 17592186152878 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8de06ca6-8f00-5b6f-912b-eb57f6ed18c2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186151746} {:answer/id #uuid "9aa9e613-8613-5512-a847-02218cdbbfb7" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186151747} {:answer/id #uuid "aaa970b7-b02f-5076-8f36-1ed0b084a913" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186151748} {:answer/id #uuid "602c09fd-f9f6-5adc-83bb-fc0bb70218a2" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186151749} {:answer/id #uuid "6c8602ec-8060-5761-b4bb-e8d0b17ea0cc" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186151750}] :answer-field/id #uuid "cd90e6db-ef54-5dca-a2a0-2fe10b67ce91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151745}] :question/id #uuid "b755a996-db20-51e4-9f08-2f14dd2e4212" :question/math-academy-id "q-93952" :question/problem "Which of the following systems is an initial value problem?\n\n1. $(x - 1)^{2}y^{″} + (x - 1)y^{′} + y = 0$\n2. $8y^{″} + y^{′} + y = 0, y(1) = 0, y^{′}(2) = 10$\n3. $x^{2}y^{″} + xy^{′} = x^{2} + 1, y(1) = 0, y^{′}(1) = 5$"}] [{:db/id #edb/ref 17592186394886 :knowledge-point/_questions [{:knowledge-point/id #uuid "31ae5cdc-ae3f-5497-88d8-f02a7263340d" :knowledge-point/title "Orthogonally Diagonalizing a 2x2 Symmetric Matrix Given Part of the Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d49197c-8ea0-5037-8658-b8800ba11d98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186394888} {:answer/id #uuid "ccb14de4-81a2-5a22-9b22-a9c795e5d80a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{17}}{17} \\\\ -\\frac{4\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394889} {:answer/id #uuid "2d287e51-ff4c-5d64-aaf3-306e594af48b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{17}}{17} \\\\ -\\frac{4\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394890} {:answer/id #uuid "298cf117-73a5-5dba-8a49-4651e4dc4bbe" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4\\sqrt{17}}{17} \\\\ \\frac{\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394891} {:answer/id #uuid "d3a2c500-01a4-5141-91a3-878c1f2e4f4d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4\\frac{\\sqrt{17}}{17} \\\\ -\\frac{\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394892}] :answer-field/correct {:answer/id #uuid "2d287e51-ff4c-5d64-aaf3-306e594af48b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{17}}{17} \\\\ -\\frac{4\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394890} :answer-field/id #uuid "fa1f9db6-ad26-5de3-b141-6cab0e8d74e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc9e75e4-89e6-5c5c-b897-fce34f0588db" :question/math-academy-id "q-94026" :question/problem "$$\nA=[\\begin{aligned}9 & 4 \\\\ 4 & -6\\end{aligned}],\\,D=[\\begin{aligned}-7 & 0 \\\\ 0 & 10\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first column of the matrix $P.$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=-7$ and ${\\lambda }_{2}=10.$ So, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=-7.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{1}=-7.$ Computing $A-(-7)I,$ we get\n\n$$\n\\begin{aligned}A+7I & =[\\begin{aligned}9 & 4 \\\\ 4 & -6\\end{aligned}]+7[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}16 & 4 \\\\ 4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}16 & 4 & 0 \\\\ 4 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}16 & 4 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain $-4{x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ -4{x}_{1}\\end{aligned}],\\,{x}_{1}\\in R.\n$$\n\nTherefore, setting ${x}_{1}=1,$ we get the eigenvector \n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ -4\\end{aligned}],\n$$\n\nwhere $‖{v}_{1}‖=\\sqrt{17}.$ Dividing ${v}_{1}$ by its norm, we obtain the first column of $P:$ \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ -4\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{17}}{17} \\\\ -\\frac{4\\sqrt{17}}{17}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186394893 :knowledge-point/_questions [{:knowledge-point/id #uuid "31ae5cdc-ae3f-5497-88d8-f02a7263340d" :knowledge-point/title "Orthogonally Diagonalizing a 2x2 Symmetric Matrix Given Part of the Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "262152dc-d095-58ad-b8fd-54192e4a8aa1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2\\sqrt{13}}{13} \\\\ \\frac{3\\sqrt{13}}{13}\\end{aligned}]" :db/id #edb/ref 17592186394895} {:answer/id #uuid "8249bee5-05ff-5f60-bc29-4262dfab7c83" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186394896} {:answer/id #uuid "f0637a74-e581-54c5-ba07-1d64511750e4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{3\\sqrt{13}}{13} \\\\ \\frac{2\\sqrt{13}}{13}\\end{aligned}]" :db/id #edb/ref 17592186394897} {:answer/id #uuid "495e9dc8-57a2-539e-ba4f-277d6dcd3829" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394898} {:answer/id #uuid "e0694bd3-785b-543e-9d91-a341c5a4399e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2\\sqrt{13}}{13} \\\\ -\\frac{3\\sqrt{13}}{13}\\end{aligned}]" :db/id #edb/ref 17592186394899}] :answer-field/correct {:answer/id #uuid "262152dc-d095-58ad-b8fd-54192e4a8aa1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2\\sqrt{13}}{13} \\\\ \\frac{3\\sqrt{13}}{13}\\end{aligned}]" :db/id #edb/ref 17592186394895} :answer-field/id #uuid "ca689d19-127e-5288-a0b5-11c9bff01ef0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394894}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e266e00f-9fa3-5a93-849a-c0c7dd5a8f68" :question/math-academy-id "q-94032" :question/problem "$$\nA=[\\begin{aligned}-6 & 6 \\\\ 6 & -1\\end{aligned}],\\,D=[\\begin{aligned}3 & 0 \\\\ 0 & -10\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first column of the matrix $P.$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=-10.$ So, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=3.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{1}=3.$ Computing $A-3I,$ we get\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}-6 & 6 \\\\ 6 & -1\\end{aligned}]-3[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-9 & 6 \\\\ 6 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-9 & 6 & 0 \\\\ 6 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{2}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}-9 & 6 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain ${x}_{1}=\\frac{2}{3}{x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}\\frac{2}{3}{x}_{2} \\\\ {x}_{2}\\end{aligned}],\\,{x}_{2}\\in R.\n$$\n\nTherefore, setting ${x}_{2}=3,$ we get the eigenvector \n\n$$\n{v}_{1}=[\\begin{aligned}2 \\\\ 3\\end{aligned}],\n$$\n\nwhere $‖{v}_{1}‖=\\sqrt{13}.$ Dividing ${v}_{1}$ by its norm, we obtain the first column of $P:$ \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{13}}[\\begin{aligned}2 \\\\ 3\\end{aligned}]=[\\begin{aligned}\\frac{2\\sqrt{13}}{13} \\\\ \\frac{3\\sqrt{13}}{13}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186394900 :knowledge-point/_questions [{:knowledge-point/id #uuid "31ae5cdc-ae3f-5497-88d8-f02a7263340d" :knowledge-point/title "Orthogonally Diagonalizing a 2x2 Symmetric Matrix Given Part of the Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4661f467-2570-50d1-8ea7-764925bd6483" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{17}}{17} \\\\ \\frac{4\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394902} {:answer/id #uuid "e507e2a2-00b8-50ad-bb5f-c430ff99f487" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{4\\sqrt{17}}{17} \\\\ \\frac{\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394903} {:answer/id #uuid "6b92abc9-a55a-50fc-ab02-ea6cb5653f3d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186394904} {:answer/id #uuid "fbc656d3-5ba8-5298-bf61-43af779427a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{17}}{17} \\\\ \\frac{4\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394905} {:answer/id #uuid "13967d9f-3611-5bfe-bb71-32016afcadc0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186394906}] :answer-field/correct {:answer/id #uuid "4661f467-2570-50d1-8ea7-764925bd6483" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{17}}{17} \\\\ \\frac{4\\sqrt{17}}{17}\\end{aligned}]" :db/id #edb/ref 17592186394902} :answer-field/id #uuid "7113dc5c-6527-51ab-8e9c-b39f83dfb5dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394901}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5923242-1a47-5487-a3a8-4c37dcb336a1" :question/math-academy-id "q-94037" :question/problem "$$\nA=[\\begin{aligned}7 & -4 \\\\ -4 & -8\\end{aligned}],\\,D=[\\begin{aligned}8 & 0 \\\\ 0 & -9\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the second column of the matrix $P.$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=8$ and ${\\lambda }_{2}=-9.$ So, the second column of $P$ corresponds to the eigenvalue ${\\lambda }_{2}=-9.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{2}=-9.$ Computing $A-(-9)I,$ we get\n\n$$\n\\begin{aligned}A+9I & =[\\begin{aligned}7 & -4 \\\\ -4 & -8\\end{aligned}]+9[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}16 & -4 \\\\ -4 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations with the augmented matrix $M$ which we reduce to row echelon form using Gaussian elimination, as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}16 & -4 & 0 \\\\ -4 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}16 & -4 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe reduced matrix above has one pivot column (the $1$st one). Thus, ${x}_{2}$ is a free variable. From the first equation, we obtain $4{x}_{1}={x}_{2}.$ Hence, the general solution is\n\n$$\n[\\begin{aligned}{x}_{1} \\\\ 4{x}_{1}\\end{aligned}],\\,{x}_{1}\\in R.\n$$\n\nTherefore, setting ${x}_{1}=1,$ we get the eigenvector \n\n$$\n{v}_{2}=[\\begin{aligned}1 \\\\ 4\\end{aligned}],\n$$\n\nwhere $‖{v}_{2}‖=\\sqrt{17}.$ Dividing ${v}_{2}$ by its norm, we obtain the second column of $P:$ \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{17}}[\\begin{aligned}1 \\\\ 4\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{17}}{17} \\\\ \\frac{4\\sqrt{17}}{17}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186172622 :knowledge-point/_questions [{:knowledge-point/id #uuid "4754d4e6-b2d0-5efb-ac92-c004c70004df" :knowledge-point/title "Orthogonally Diagonalizing a 2x2 Symmetric Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d219f0f-39c4-5862-af5d-12791bde950c" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}4 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{\\sqrt{5}}{5} & -\\frac{2\\sqrt{5}}{5} \\\\ \\frac{2\\sqrt{5}}{5} & \\frac{\\sqrt{5}}{5}\\end{bmatrix}$" :db/id #edb/ref 17592186171328} {:answer/id #uuid "b45cb8f7-107e-57d7-bcce-5f7edddf8eba" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}4 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P = \\begin{bmatrix}3 & -1 \\\\ 1 & 3\\end{bmatrix}$" :db/id #edb/ref 17592186171329} {:answer/id #uuid "e4450e4a-a83d-5d96-a4c2-72571169f71f" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}4 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2}\\end{bmatrix}$" :db/id #edb/ref 17592186171330} {:answer/id #uuid "31964a19-89f9-5567-b61a-aeb0b9c5d51e" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}7 & 0 \\\\ 0 & -2\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2}\\end{bmatrix}$" :db/id #edb/ref 17592186171331} {:answer/id #uuid "56a62c21-c273-5af3-b6a7-6447609edb48" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}4 & 0 \\\\ 0 & -1\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2}\\end{bmatrix}$" :db/id #edb/ref 17592186171332}] :answer-field/id #uuid "4ddc9ab7-6d81-5c34-adce-3d51172ec885" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171327}] :question/id #uuid "f738fa7a-a5ce-518d-9ada-841b441fb202" :question/math-academy-id "q-94056" :question/problem "$A = \\begin{bmatrix}1 & 3 \\\\ 3 & 1\\end{bmatrix}$\nThe matrix $A$ above has eigenvalues $λ_{1} = 4$ and $λ_{2} =-2$. Find a diagonal matrix $D$ and an orthogonal matrix $P$ such that $D = P^{T}AP$."}] [{:db/id #edb/ref 17592186125244 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a02df854-fc59-5fba-8a52-144b94384b56" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186124035} {:answer/id #uuid "ce466903-815f-5873-994e-128882147f2f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ and $(6, 0, 0)$" :db/id #edb/ref 17592186124036} {:answer/id #uuid "fd91ae19-b3aa-5385-9f2e-dfe8fb30ef88" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ only" :db/id #edb/ref 17592186124037} {:answer/id #uuid "00a1c3eb-d50c-5296-87bf-096e51d97a52" :answer/type {:db/ident :answer.type/text} :answer/value "$(2, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186124038} {:answer/id #uuid "582d341e-1df5-53ba-8c62-c08c6ca82f11" :answer/type {:db/ident :answer.type/text} :answer/value "$(4, 0, 0)$ only" :db/id #edb/ref 17592186124039}] :answer-field/id #uuid "3f841aee-e933-5deb-b8ec-8ddd8cafedf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124034}] :question/id #uuid "f0cabaaa-77b2-5df5-b276-82aad1e2675a" :question/math-academy-id "q-94081" :question/problem "Given the elliptic cone $((x - 2)^{2})/(2) + ((y + 2)^{2})/(4) = (z + 3)^{2}$, find its intercepts with the $x$-axis."}] [{:db/id #edb/ref 17592186162626 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c4037e5-607d-5cc4-9ce8-f7f1cd2c5aae" :knowledge-point/title "Reducing a Quadratic Form to Canonical Form Using Lagrange's Method: 2D-Case"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b707a638-f8ba-5379-80ae-80d18efc4ac7" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} + 3x_{2}$" :db/id #edb/ref 17592186161019} {:answer/id #uuid "d316df5f-eb56-540a-90b2-a38e88608f3a" :answer/type {:db/ident :answer.type/text} :answer/value "$1$ and $x_{1} + x_{2}$" :db/id #edb/ref 17592186161020} {:answer/id #uuid "33338ce3-eac4-5358-ac52-9630cd86cd9e" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $x_{1} + 2x_{2}$" :db/id #edb/ref 17592186161021} {:answer/id #uuid "527b2681-2d12-58c6-a1a8-faebae067e03" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ and $x_{1} - 3x_{2}$" :db/id #edb/ref 17592186161022} {:answer/id #uuid "7e4ba19c-3574-561f-9b4c-19b852cb529a" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ and $x_{1} - 2x_{2}$" :db/id #edb/ref 17592186161023}] :answer-field/id #uuid "1bcfe45b-dbad-5a1c-86a5-77078d6e137b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161018}] :question/id #uuid "ca81ca2d-2a11-5281-bdfb-66b5a7ca3f2d" :question/math-academy-id "q-94142" :question/problem "Lagrange's method can be used to reduce the quadratic form $Q(x) = 3x_{1}^{2} + 29x_{2}^{2} + 18x_{1}x_{2}$ to the canonical form given below.\n\n$3y_{1}^{2} + 2y_{2}^{2}, {y_{1} = x_{1} + 3x_{2}; y_{2} = x_{2}$\n\nFrom left to right, what is missing from the blank spaces?"}] [{:db/id #edb/ref 17592186394907 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff16b5e7-d25d-58f1-83d3-e8d4a92d7064" :knowledge-point/title "Solving a Cauchy-Euler Equation With Forcing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a61f2888-4a04-577a-b602-1419968bce94" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)={c}_{1}t+\\frac{{c}_{2}}{{t}^{5}}-\\frac{8{t}^{2}}{9}" :db/id #edb/ref 17592186394909} {:answer/id #uuid "8ddb19ec-2112-5acc-a338-ad31deed6ed1" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=\\frac{{c}_{1}}{t}+{c}_{2}{t}^{5}-\\frac{8{t}^{2}}{9}" :db/id #edb/ref 17592186394910} {:answer/id #uuid "6310e41b-7f40-5af7-9ecb-2c0fba8a9b5d" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=\\frac{{c}_{1}}{t}+{c}_{2}{t}^{5}+\\frac{{t}^{2}}{9}" :db/id #edb/ref 17592186394911} {:answer/id #uuid "9bef4efb-b5ce-5df4-a1e0-21fe5e89fae3" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=\\frac{{c}_{1}}{t}+{c}_{2}{t}^{5}-8{t}^{2}" :db/id #edb/ref 17592186394912} {:answer/id #uuid "1c9f8723-81b7-5b22-84e5-cecc02d5176d" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=\\frac{{c}_{1}}{t}+\\frac{8{t}^{2}}{9}" :db/id #edb/ref 17592186394913}] :answer-field/correct {:answer/id #uuid "8ddb19ec-2112-5acc-a338-ad31deed6ed1" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=\\frac{{c}_{1}}{t}+{c}_{2}{t}^{5}-\\frac{8{t}^{2}}{9}" :db/id #edb/ref 17592186394910} :answer-field/id #uuid "75271cdd-b421-5359-80f4-24f4f216c3ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394908}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cf01ae1c-fdd1-5411-bb0e-3e2065f6bccf" :question/math-academy-id "q-94165" :question/problem "Find the general solution to the equation \n\n$$\n{t}^{2}{y}^{″}-3t{y}^{′}-5y=8{t}^{2},\\,t>0.\n$$" :question/worked-solution "First, we need to find the complimentary function ${y}_{c}(t)$ which is the solution to the homogeneous equation\n\n$$\n{t}^{2}{y}^{″}-3t{y}^{′}-5y=0.\n$$\n\nLet $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}-3t\\cdot \\lambda {t}^{\\lambda -1}-5{t}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){t}^{\\lambda }-3\\lambda {t}^{\\lambda }-5{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[\\lambda (\\lambda -1)-3\\lambda -5] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-3\\lambda -5 & =0 \\\\ {\\lambda }^{2}-4\\lambda -5 & =0 \\\\ (\\lambda -5)(\\lambda +1) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =-1$ and $\\lambda =5.$ Thus, the complimentary function ${y}_{c}(t)$ is\n\n$$\n{y}_{c}(t)=\\frac{{c}_{1}}{t}+{c}_{2}{t}^{5}.\n$$\n\nThe right-hand side of the inhomogeneous equation is proportional to ${t}^{2}.$ Therefore, we assume that the particular solution is of the form \n\n$$\n{y}_{p}(t)=\\alpha {t}^{2}\n$$\n\nwhere $\\alpha $ is the constant that is to be determined. \n\nCalculating the first and second derivatives of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}t}=2\\alpha t,\\,\\frac{{\\text{d}}^{2}{y}_{p}}{\\text{d}{t}^{2}}=2\\alpha .\n$$\n\nTo find the value of $\\alpha ,$ we substitute the derivatives into the differential equation and group the terms on the left-hand side:\n\n$$\n\\begin{aligned}{t}^{2}(2\\alpha )-3t(2\\alpha t)-5(\\alpha {t}^{2}) & =8{t}^{2} \\\\ (2\\alpha -6\\alpha -5\\alpha ){t}^{2} & =8{t}^{2} \\\\ -9\\alpha {t}^{2} & =8{t}^{2}\\end{aligned}\n$$\n\nEquating the coefficients, we get $\\alpha =-\\frac{8}{9}.$\n\nHence, the particular integral ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=-\\frac{8{t}^{2}}{9}.\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}y(t) & ={y}_{c}(t)+{y}_{p}(t) \\\\  & =\\frac{{c}_{1}}{t}+{c}_{2}{t}^{5}-\\frac{8{t}^{2}}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394914 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e5803d7-3865-53e1-bf00-3e5bf36e75bc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 25 \\\\ 25 & 6\\end{aligned}]" :db/id #edb/ref 17592186394916} {:answer/id #uuid "ad81e169-4414-5dde-a7cb-21e9db566481" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & 16 \\\\ 16 & 12\\end{aligned}]" :db/id #edb/ref 17592186394917} {:answer/id #uuid "d9aa6749-16e8-53e9-9f4d-5fc08b90dff3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & 4 \\\\ 4 & 12\\end{aligned}]" :db/id #edb/ref 17592186394918} {:answer/id #uuid "7d82608d-ef1f-5a4c-b3bb-8db0996e0580" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}21 & 26 \\\\ 26 & 32\\end{aligned}]" :db/id #edb/ref 17592186394919} {:answer/id #uuid "1a50d0ca-b153-52be-ac9a-a57fbf617c54" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & 15 \\\\ 15 & 2\\end{aligned}]" :db/id #edb/ref 17592186394920}] :answer-field/correct {:answer/id #uuid "7d82608d-ef1f-5a4c-b3bb-8db0996e0580" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}21 & 26 \\\\ 26 & 32\\end{aligned}]" :db/id #edb/ref 17592186394919} :answer-field/id #uuid "ab676067-659d-578e-80a2-9e8029ce33ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394915}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89a8b501-1e1d-5651-8ffd-47612aef6ccf" :question/math-academy-id "q-94182" :question/problem "$$\nA=[\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}],\\,P=[\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}]}^{T}[\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 2 & 2\\end{aligned}][\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 5 \\\\ 10 & 6\\end{aligned}][\\begin{aligned}2 & 2 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}21 & 26 \\\\ 26 & 32\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394921 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c98ff09-427a-5eb1-a200-d23ed4191cea" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186394923} {:answer/id #uuid "9348f60d-beec-50bd-adf0-24bfc6cb780e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394924} {:answer/id #uuid "cc5670d6-74a3-5137-b88e-c8ccd60a7bac" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394925} {:answer/id #uuid "2bc8e19b-3088-56cf-9a10-9aa2d5b034de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394926} {:answer/id #uuid "a66b36c9-3e25-5639-a868-08d8ac845797" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394927}] :answer-field/correct {:answer/id #uuid "9348f60d-beec-50bd-adf0-24bfc6cb780e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394924} :answer-field/id #uuid "7a6d844e-734f-5b7d-8c23-1672424ae4ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "765a6f68-9c89-5828-8b01-5ec72f2b19e0" :question/math-academy-id "q-94184" :question/problem "$$\nA=[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}],\\,P=[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}]}^{T}[\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ 2 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394928 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afce0815-3fdb-541c-af4a-7a81892b6478" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 & 5 \\\\ 5 & 3\\end{aligned}]" :db/id #edb/ref 17592186394930} {:answer/id #uuid "4be5c75d-ed62-549d-9e8b-c40bfafeb8e8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 10 \\\\ 10 & 12\\end{aligned}]" :db/id #edb/ref 17592186394931} {:answer/id #uuid "76c175b0-d666-515c-aede-09f4d2538170" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 \\\\ 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394932} {:answer/id #uuid "2bb06ed8-7de4-5632-9215-fa8f2a15056c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}24 & 10 \\\\ 10 & 4\\end{aligned}]" :db/id #edb/ref 17592186394933} {:answer/id #uuid "266a1583-4dae-5d93-95df-9422b6888a8b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186394934}] :answer-field/correct {:answer/id #uuid "2bb06ed8-7de4-5632-9215-fa8f2a15056c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}24 & 10 \\\\ 10 & 4\\end{aligned}]" :db/id #edb/ref 17592186394933} :answer-field/id #uuid "4fe6a4fb-e363-52df-aa4f-730c09927f67" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40dd4a85-940b-524b-8326-b2ed09b83bd7" :question/math-academy-id "q-94188" :question/problem "$$\nA=[\\begin{aligned}2 & \\,-1 \\\\ \\,\\,-1 & 0\\end{aligned}],\\,P=[\\begin{aligned}4 & 2 \\\\ 1 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}4 & 2 \\\\ 1 & 1\\end{aligned}]}^{T}[\\begin{aligned}2 & \\,-1 \\\\ \\,\\,-1 & 0\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}2 & \\,-1 \\\\ \\,\\,-1 & 0\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -4 \\\\ 3 & -2\\end{aligned}][\\begin{aligned}\\,4 & 2 \\\\ 1 & \\,\\,1\\end{aligned}] \\\\  & =[\\begin{aligned}24 & 10 \\\\ 10 & 4\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394935 :knowledge-point/_questions [{:knowledge-point/id #uuid "331cb610-6168-5161-b821-237c713dedaa" :knowledge-point/title "Finding the Matrix of a Quadratic Form Given a Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "518caac6-5f94-5629-8c49-e321f3ca90c5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 \\\\ 6 & 5\\end{aligned}]" :db/id #edb/ref 17592186394937} {:answer/id #uuid "289cf341-e782-5577-bac6-1481950f83da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & 5 \\\\ 5 & -1\\end{aligned}]" :db/id #edb/ref 17592186394938} {:answer/id #uuid "693be657-40f0-58ae-b839-9f07f8cfad44" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}20 & 8 \\\\ 8 & -2\\end{aligned}]" :db/id #edb/ref 17592186394939} {:answer/id #uuid "c5734f03-8315-53e0-9988-3386bd6bcdb5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}19 & 9 \\\\ 9 & -1\\end{aligned}]" :db/id #edb/ref 17592186394940} {:answer/id #uuid "171a0c9b-a2d4-5294-9995-675f47bd951d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 & 2 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186394941}] :answer-field/correct {:answer/id #uuid "c5734f03-8315-53e0-9988-3386bd6bcdb5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}19 & 9 \\\\ 9 & -1\\end{aligned}]" :db/id #edb/ref 17592186394940} :answer-field/id #uuid "06fd09b0-e43b-5e2f-a66b-efe6afead7e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394936}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40c684b5-94c1-5b6d-81fc-7b03ac291b23" :question/math-academy-id "q-94189" :question/problem "$$\nA=[\\begin{aligned}0 & 5 \\\\ 5 & -1\\end{aligned}],\\,P=[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $P$ above. Find the matrix of the quadratic form ${x}^{T}\\,Ax$ in the basis that consists of the columns of $P.$" :question/worked-solution "Recall that if $x=[{x}_{1},{x}_{2}]^{T}$ is a vector given by its coordinates in the standard basis and $y=[{y}_{1},{y}_{2}]^{T}$ is the same vector but given in the coordinates relative to the basis that consists of the columns of $P,$ then \n\n$$\nx=Py.\n$$\n\nAs a result, we have \n\n$$\n\\begin{aligned}{x}^{T}\\,Ax & =(Py)^{T}\\,A\\,(Py) \\\\  & =({y}^{T}{P}^{T})\\,A\\,(Py) \\\\  & ={y}^{T}({P}^{T}\\,AP)\\,y,\\end{aligned}\n$$\n\nwhich means that the matrix of our form in the new basis is\n\n$$\n\\begin{aligned}{P}^{T}\\,AP & ={[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}]}^{T}[\\begin{aligned}0 & 5 \\\\ 5 & -1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 5 \\\\ 5 & -1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}5 & 9 \\\\ 5 & -1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}19 & 9 \\\\ 9 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394942 :knowledge-point/_questions [{:knowledge-point/id #uuid "85d71b68-d4d4-53c9-8ff7-135389e85edc" :knowledge-point/title "Calculating a Particular Solution For a Cauchy-Euler Equation Using Variation of Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e583a002-70fe-56cb-970c-6ecf4707b90f" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=2{x}^{2}\\operatorname{cos}⁡x-(3-x)\\operatorname{sin}⁡x" :db/id #edb/ref 17592186394944} {:answer/id #uuid "fb4ddc40-d054-5df0-98ae-97135292007a" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{6}{x}-x)\\operatorname{cos}⁡x+(3-\\frac{6}{{x}^{2}})\\operatorname{sin}⁡x" :db/id #edb/ref 17592186394945} {:answer/id #uuid "d5c927ca-6db7-5bda-8854-a4c3997acd27" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=\\frac{6}{x}\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186394946} {:answer/id #uuid "23524752-4ff0-543f-875d-cc1e4346d1ea" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{1}{x}-x)\\operatorname{cos}⁡x+2x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186394947} {:answer/id #uuid "20bfb43c-eb37-5a4d-9164-7d5d054c1f86" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(6-{x}^{2})\\operatorname{cos}⁡x+({x}^{2}-3)\\operatorname{sin}⁡x" :db/id #edb/ref 17592186394948}] :answer-field/correct {:answer/id #uuid "fb4ddc40-d054-5df0-98ae-97135292007a" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{6}{x}-x)\\operatorname{cos}⁡x+(3-\\frac{6}{{x}^{2}})\\operatorname{sin}⁡x" :db/id #edb/ref 17592186394945} :answer-field/id #uuid "817d71d9-2b7f-5b80-b0c4-ed70b708eece" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394943}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2524797a-65ac-5664-a2f2-3a154d0cd5f2" :question/math-academy-id "q-94191" :question/problem "Given that the differential equation \n\n$$\n{x}^{2}{y}^{″}+x{y}^{′}-4y={x}^{3}\\operatorname{cos}⁡x,\\,x>0\n$$\n\nhas the complimentary function ${y}_{c}(x)=\\frac{A}{{x}^{2}}+B{x}^{2}$, find the particular solution ${y}_{p}(x)$ to this equation. \n\n*Hint: You may wish to make use of the following result:* \n\n$$\n\\int {x}^{4}\\operatorname{cos}⁡x\\,\\text{d}x=4x({x}^{2}-6)\\operatorname{cos}⁡x+({x}^{4}-12{x}^{2}+24)\\operatorname{sin}⁡x+C\n$$" :question/worked-solution "First, we reduce the differential equation to the form\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=f(x).\n$$\n\nSo, we divide both sides of the given equation by ${x}^{2}.$ We get\n\n$$\n{y}^{″}+\\frac{1}{x}{y}^{′}-\\frac{4}{{x}^{2}}y=x\\operatorname{cos}⁡x.\n$$\n\nWe notice that the forcing term $f(x)=x\\operatorname{cos}⁡x.$ Additionally, we're given the fundamental solutions:\n\n$$\n{y}_{1}(x)=\\frac{1}{{x}^{2}},\\,{y}_{2}(x)={x}^{2}\n$$\n\nFirst, let's compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =\\frac{1}{{x}^{2}}({x}^{2})^{′}-{(\\frac{1}{{x}^{2}})}^{′}{x}^{2} \\\\  & =2x(\\frac{1}{{x}^{2}})-(-\\frac{2}{{x}^{3}}){x}^{2} \\\\  & =\\frac{2}{x}+\\frac{2}{x} \\\\  & =\\frac{4}{x}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nAccording to the method of variation of parameters, the particular solution of the differential equation is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={y}_{1}(x)u(x)+{y}_{2}(x)v(x),\\end{aligned}\n$$\n\nwhere\n\n$$\n\\begin{aligned}u(x) & =-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x=-\\frac{1}{4}\\int {x}^{4}\\operatorname{cos}⁡x\\,\\text{d}x=-\\frac{1}{4}(4x({x}^{2}-6)\\operatorname{cos}⁡x+({x}^{4}-12{x}^{2}+24)\\operatorname{sin}⁡x), \\\\ v(x) & =\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x=\\frac{1}{4}\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\frac{1}{4}\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nThus,\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={y}_{1}(x)u(x)+{y}_{2}(x)v(x) \\\\  & =(\\frac{1}{{x}^{2}})(-\\frac{1}{4}(4x({x}^{2}-6)\\operatorname{cos}⁡x+({x}^{4}-12{x}^{2}+24)\\operatorname{sin}⁡x))+({x}^{2})(\\frac{1}{4}\\operatorname{sin}⁡x) \\\\  & =(-x+\\frac{6}{x})\\operatorname{cos}⁡x+(-\\frac{{x}^{2}}{4}+3-\\frac{6}{{x}^{2}})\\operatorname{sin}⁡x+\\frac{{x}^{2}}{4}\\operatorname{sin}⁡x \\\\  & =(\\frac{6}{x}-x)\\operatorname{cos}⁡x+(3-\\frac{6}{{x}^{2}})\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394949 :knowledge-point/_questions [{:knowledge-point/id #uuid "85d71b68-d4d4-53c9-8ff7-135389e85edc" :knowledge-point/title "Calculating a Particular Solution For a Cauchy-Euler Equation Using Variation of Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb155aa0-4397-5e09-819c-177cf354209d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{1}{x}+\\frac{1}{{x}^{2}}-\\frac{3}{{x}^{3}}){e}^{x}" :db/id #edb/ref 17592186394951} {:answer/id #uuid "3a60be13-f954-54e0-8a80-78c79f0e908e" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{3}{x}-\\frac{1}{{x}^{2}}-\\frac{3}{{x}^{3}}){e}^{x}" :db/id #edb/ref 17592186394952} {:answer/id #uuid "5fcea938-3524-5ff6-82a3-95314a4e82b9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{1}{x}-\\frac{3}{{x}^{2}}+\\frac{3}{{x}^{3}}){e}^{x}" :db/id #edb/ref 17592186394953} {:answer/id #uuid "fd2a3fc9-195a-5fea-9901-9cb1d649dade" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{3}{x}-\\frac{1}{{x}^{2}}+\\frac{1}{{x}^{3}}){e}^{x}" :db/id #edb/ref 17592186394954} {:answer/id #uuid "9196c699-6cbf-59be-ad95-ea91912b2959" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{1}{x}+\\frac{3}{{x}^{2}}-\\frac{3}{{x}^{3}}){e}^{x}" :db/id #edb/ref 17592186394955}] :answer-field/correct {:answer/id #uuid "5fcea938-3524-5ff6-82a3-95314a4e82b9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}_{p}(x)=(\\frac{1}{x}-\\frac{3}{{x}^{2}}+\\frac{3}{{x}^{3}}){e}^{x}" :db/id #edb/ref 17592186394953} :answer-field/id #uuid "3f9af7bf-8e4b-52c1-9def-7c956fc990ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a237827c-e559-5ab9-ade9-5d51e7b60d0a" :question/math-academy-id "q-94226" :question/problem "Given that the differential equation \n\n$$\n{x}^{2}{y}^{″}+5x{y}^{′}+3y=x{e}^{x},\\,x>0\n$$\n\nhas the complimentary function ${y}_{c}(x)=\\frac{A}{{x}^{3}}+\\frac{B}{x}$, find the particular solution ${y}_{p}(x)$ to this equation. \n\n*Hint: You may wish to make use of the following results:* \n\n$$\n\\int {x}^{3}{e}^{x}\\text{d}x=({x}^{3}-3{x}^{2}+6x-6){e}^{x}+C\n$$\n\nand\n\n$$\n\\int x{e}^{x}\\text{d}x=(x-1){e}^{x}+C\n$$" :question/worked-solution "First, we reduce the differential equation to the form\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=f(x).\n$$\n\nSo, we divide both sides of the given equation by ${x}^{2}.$ We get\n\n$$\n{y}^{″}+\\frac{5}{x}{y}^{′}+\\frac{3}{{x}^{2}}y=\\frac{{e}^{x}}{x}.\n$$\n\nWe notice that the forcing term $f(x)=\\frac{{e}^{x}}{x}.$ Additionally, we're given the fundamental solutions:\n\n$$\n{y}_{1}(x)=\\frac{1}{{x}^{3}},\\,{y}_{2}(x)=\\frac{1}{x}\n$$\n\nFirst, let's compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & ={y}_{1}{y}_{2}^{′}-{y}_{1}^{′}{y}_{2} \\\\  & =\\frac{1}{{x}^{3}}{(\\frac{1}{x})}^{′}-{(\\frac{1}{{x}^{3}})}^{′}\\frac{1}{x} \\\\  & =\\frac{1}{{x}^{3}}(-\\frac{1}{{x}^{2}})-(-\\frac{3}{{x}^{4}})\\frac{1}{x} \\\\  & =-\\frac{1}{{x}^{5}}+\\frac{3}{{x}^{5}} \\\\  & =\\frac{2}{{x}^{5}}\\ne 0\\end{aligned}\n$$\n\nSince the Wronskian is not equal to zero, this confirms that the functions  ${y}_{1}(x)$ and ${y}_{2}(x)$ are independent. \n\nAccording to the method of variation of parameters, the particular solution of the differential equation is\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={y}_{1}(x)u(x)+{y}_{2}(x)v(x),\\end{aligned}\n$$\n\nwhere\n\n$$\n\\begin{aligned}u(x) & =-\\int \\frac{f(x){y}_{2}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x=-\\frac{1}{2}\\int {x}^{3}{e}^{x}\\,\\text{d}x=-\\frac{1}{2}({x}^{3}-3{x}^{2}+6x-6){e}^{x}, \\\\ v(x) & =\\int \\frac{f(x){y}_{1}(x)}{W({y}_{1},{y}_{2})}\\,\\text{d}x=\\frac{1}{2}\\int x{e}^{x}\\,\\text{d}x=\\frac{1}{2}(x-1){e}^{x}.\\end{aligned}\n$$\n\nThus,\n\n$$\n\\begin{aligned}{y}_{p}(x) & ={y}_{1}(x)u(x)+{y}_{2}(x)v(x) \\\\  & =(\\frac{1}{{x}^{3}})(-\\frac{1}{2}({x}^{3}-3{x}^{2}+6x-6){e}^{x})+(\\frac{1}{x})(\\frac{1}{2}(x-1){e}^{x}) \\\\  & =(-\\frac{1}{2}+\\frac{3}{2x}-\\frac{3}{{x}^{2}}+\\frac{3}{{x}^{3}}+\\frac{1}{2}-\\frac{1}{2x}){e}^{x} \\\\  & =(\\frac{1}{x}-\\frac{3}{{x}^{2}}+\\frac{3}{{x}^{3}}){e}^{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186162630 :knowledge-point/_questions [{:knowledge-point/id #uuid "611af093-6621-5224-af2a-f769c7c0e691" :knowledge-point/title "Orthogonally Diagonalizing a 3x3 Matrix With Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6632f3d7-06ae-5c79-b1d4-500c6c3802ff" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{2}}{2} \\\\ 0 \\\\ \\frac{\\sqrt{2}}{2}\\end{aligned}]" :db/id #edb/ref 17592186394957} {:answer/id #uuid "e1867d9b-476d-5a5d-89d7-ed8c8216d1ed" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]" :db/id #edb/ref 17592186394958} {:answer/id #uuid "8c35dc64-6998-53e6-b3da-d3899a48d48e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186394959} {:answer/id #uuid "c19d5511-a039-5139-93ab-c5895b1de46d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{3} \\\\ \\frac{2}{3} \\\\ \\frac{1}{6}\\end{aligned}]" :db/id #edb/ref 17592186394960} {:answer/id #uuid "451d28cf-25fa-5618-a349-86bebd5f1545" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]" :db/id #edb/ref 17592186394961}] :answer-field/correct {:answer/id #uuid "451d28cf-25fa-5618-a349-86bebd5f1545" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]" :db/id #edb/ref 17592186394961} :answer-field/id #uuid "ff6651f3-29f1-57b9-8b08-9d44f2e66d1a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394956}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dec4c6f4-86dd-50ba-b4f8-5dac075a34ca" :question/math-academy-id "q-94260" :question/problem "$$\nA=[\\begin{aligned}1 & -1 & 0 \\\\ -1 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}],\\,D=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the third column of the matrix $P?$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=0,$ ${\\lambda }_{2}=1,$ and ${\\lambda }_{3}=3.$ So, the third column of $P$ corresponds to the eigenvalue ${\\lambda }_{3}=3.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{3}=3.$ Computing $A-3I,$ we get\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}1 & -1 & 0 \\\\ -1 & 2 & 1 \\\\ 0 & 1 & 1\\end{aligned}]-3[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-2 & -1 & 0 \\\\ -1 & -1 & 1 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives the eigenvector \n\n$$\n{v}_{3}=[\\begin{aligned}-1 \\\\ 2 \\\\ 1\\end{aligned}],\n$$\n\nwhere $‖{v}_{3}‖=\\sqrt{6}.$ Dividing ${v}_{3}$ by its norm, we obtain the third column of $P:$ \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{6}}[\\begin{aligned}-1 \\\\ 2 \\\\ 1\\end{aligned}]=[\\begin{aligned}-\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186394962 :knowledge-point/_questions [{:knowledge-point/id #uuid "611af093-6621-5224-af2a-f769c7c0e691" :knowledge-point/title "Orthogonally Diagonalizing a 3x3 Matrix With Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97b892c9-66af-5f63-9cd5-08d6cd151877" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{3}}{6} \\\\ \\frac{\\sqrt{2}}{3} \\\\ \\frac{\\sqrt{3}}{6}\\end{aligned}]" :db/id #edb/ref 17592186394964} {:answer/id #uuid "976b0d9a-3e2a-5906-bea8-f65fa78ff984" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ \\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]" :db/id #edb/ref 17592186394965} {:answer/id #uuid "afa81b49-a62b-5b06-85f4-00c25c2caf2f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]" :db/id #edb/ref 17592186394966} {:answer/id #uuid "498c4572-93e7-5f84-afed-6a70d366ce31" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{6} \\\\ -\\frac{2}{3} \\\\ \\frac{1}{6}\\end{aligned}]" :db/id #edb/ref 17592186394967} {:answer/id #uuid "03d7d1cc-f2ca-5cb0-aeef-81f728bc88ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]" :db/id #edb/ref 17592186394968}] :answer-field/correct {:answer/id #uuid "afa81b49-a62b-5b06-85f4-00c25c2caf2f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]" :db/id #edb/ref 17592186394966} :answer-field/id #uuid "4e6916fa-9833-5f3f-887c-af297c3cc3e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f075746-4483-5586-942c-8cf99fac769f" :question/math-academy-id "q-94262" :question/problem "$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}],\\,D=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the first column of the matrix $P?$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=0,$ ${\\lambda }_{2}=-2,$ and ${\\lambda }_{3}=6.$ So, the first column of $P$ corresponds to the eigenvalue ${\\lambda }_{1}=0.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{1}=0.$ Computing $A-0I,$ we get\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}]-0[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector \n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}],\n$$\n\nwhere $‖{v}_{1}‖=\\sqrt{6}.$ Dividing ${v}_{1}$ by its norm, we obtain the first column of $P:$ \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{6}}[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{6}}{6} \\\\ -\\frac{\\sqrt{6}}{3} \\\\ \\frac{\\sqrt{6}}{6}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186394969 :knowledge-point/_questions [{:knowledge-point/id #uuid "611af093-6621-5224-af2a-f769c7c0e691" :knowledge-point/title "Orthogonally Diagonalizing a 3x3 Matrix With Distinct Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "515e7963-43a8-5d4c-b890-b12012ce6c51" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186394971} {:answer/id #uuid "28470fa3-1d40-50b2-a80d-1ee99e65ae81" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186394972} {:answer/id #uuid "d5588f7e-3d7a-589f-9e27-01f3829fb78d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]" :db/id #edb/ref 17592186394973} {:answer/id #uuid "fa276602-eaa8-58fe-8046-b32c896de75b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ -\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]" :db/id #edb/ref 17592186394974} {:answer/id #uuid "0092226f-56fc-51da-a4bb-a95cb3699695" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2} \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186394975}] :answer-field/correct {:answer/id #uuid "d5588f7e-3d7a-589f-9e27-01f3829fb78d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]" :db/id #edb/ref 17592186394973} :answer-field/id #uuid "a2d3ea6d-180a-530e-a554-9eaf5810635a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394970}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bac7e35-18fd-5d08-a4e1-72c5d7aa78ae" :question/math-academy-id "q-94266" :question/problem "$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}],\\,D=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]\n$$\n\nConsider the matrices shown above. \nGiven that $D={P}^{T}\\,AP,$ where $P$ is an orthogonal matrix, which of the following could be the third column of the matrix $P?$" :question/worked-solution "Recall that a matrix $A$ is orthogonally diagonalizable if there exists an orthogonal matrix $P$ such that\n\n$$\nA=PD{P}^{T},\n$$\n\nwhere $D$ is a diagonal matrix. Equivalently,\n\n$$\nD={P}^{T}AP.\n$$\n\nMoreover, a matrix $A$ is orthogonally diagonalizable if and only if it is symmetric.\n\nFirst, note that $A$ is symmetric and $D$ is diagonal. Therefore, $D={P}^{T}\\,AP$ gives an orthogonal diagonalization of $A.$\n\nFrom the diagonal matrix $D$ we deduce that the eigenvalues of the matrix $A$ are ${\\lambda }_{1}=0,$ ${\\lambda }_{2}=-2,$ and ${\\lambda }_{3}=6.$ So, the third column of $P$ corresponds to the eigenvalue ${\\lambda }_{3}=6.$ \n\nNow, we need to find an eigenvector that corresponds to ${\\lambda }_{3}=6.$ Computing $A-6I,$ we get\n\n$$\n\\begin{aligned}A-6I & =[\\begin{aligned}1 & 2 & 3 \\\\ 2 & 2 & 2 \\\\ 3 & 2 & 1\\end{aligned}]-6[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-5 & 2 & 3 \\\\ 2 & -4 & 2 \\\\ 3 & 2 & -5\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-6I)x=0$ gives the eigenvector \n\n$$\n{v}_{3}=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\n$$\n\nwhere $‖{v}_{3}‖=\\sqrt{3}.$ Dividing ${v}_{3}$ by its norm, we obtain the third column of $P:$ \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{3}}[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}\\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3} \\\\ \\frac{\\sqrt{3}}{3}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186394976 :knowledge-point/_questions [{:knowledge-point/id #uuid "ef654722-031d-51cc-86fc-a0cbc498b350" :knowledge-point/title "Calculating the Period of a Simple Harmonic Oscillation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fca25542-f23c-589a-a5dc-6123e88b0013" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}\\,\\text{s}" :db/id #edb/ref 17592186394978} {:answer/id #uuid "9b339dd2-12ba-5982-a340-48035cfccbfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}\\,\\text{s}" :db/id #edb/ref 17592186394979} {:answer/id #uuid "5362cf40-1431-547a-b9d6-c5c711bd3d9d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{144}\\,\\text{s}" :db/id #edb/ref 17592186394980} {:answer/id #uuid "3cb7bb2d-1e07-50d5-9fce-e333ad3d4d6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}\\,\\text{s}" :db/id #edb/ref 17592186394981} {:answer/id #uuid "acff6b9d-3485-5b9e-ad96-66592c8b7049" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}\\,\\text{s}" :db/id #edb/ref 17592186394982}] :answer-field/correct {:answer/id #uuid "3cb7bb2d-1e07-50d5-9fce-e333ad3d4d6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}\\,\\text{s}" :db/id #edb/ref 17592186394981} :answer-field/id #uuid "46290546-4ff2-5d39-8b98-b300425eb07b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394977}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d55619d9-04e6-5e22-adf5-2ab8249416dc" :question/math-academy-id "q-94274" :question/problem "The position $y(t)$ of a particle oscillating with simple harmonic motion is governed by the equation\n\n$$\n{y}^{″}+144y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the oscillation?" :question/worked-solution "The simple harmonic motion (SHM) equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nIn our case\n\n$$\n{\\omega }^{2}=144\\,⟹\\,\\omega =12.\n$$\n\nThe period $T$ is given by:\n\n$$\nT=\\frac{2\\pi }{\\omega }\n$$\n\nTherefore, in our case, the period (in seconds) is\n\n$$\nT=\\frac{2\\pi }{12}=\\frac{\\pi }{6}\\,\\text{s}.\n$$"}] [{:db/id #edb/ref 17592186162638 :knowledge-point/_questions [{:knowledge-point/id #uuid "a1bee282-2775-59f5-a929-9dc5327703bc" :knowledge-point/title "Reducing a Quadratic Function Over the 2D-Space to the Canonical Form Using Orthogonal Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c95d292b-b5d0-5097-a485-bcbedcb99071" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186161091} {:answer/id #uuid "cf435087-776e-5b47-9397-a41eb7fdb830" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186161092} {:answer/id #uuid "ecf02d81-6e1e-572d-a106-67f4f6532836" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}$ and $P = \\begin{bmatrix}\\frac{2}{\\sqrt{13}} & -\\frac{3}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186161093} {:answer/id #uuid "040f1313-e21c-514f-9c2e-75dfb47837fa" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P = \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186161094} {:answer/id #uuid "39e03b5b-87da-5c0f-a60a-40325e38f947" :answer/type {:db/ident :answer.type/text} :answer/value "$D = \\begin{bmatrix}-1 & 0 \\\\ 0 & -3\\end{bmatrix}$ and $P = \\begin{bmatrix}-\\frac{3}{\\sqrt{13}} & \\frac{2}{\\sqrt{13}} \\\\ \\frac{2}{\\sqrt{13}} & \\frac{3}{\\sqrt{13}}\\end{bmatrix}$" :db/id #edb/ref 17592186161095}] :answer-field/id #uuid "ed668d09-a90d-5725-a6ce-1892307a482f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161090}] :question/id #uuid "1587eada-a2ce-573f-9e77-1eddebc42115" :question/math-academy-id "q-94454" :question/problem "Given the quadratic form $Q(x) =-x_{1}^{2} - 4x_{1}x_{2} - x_{2}^{2}$, find its canonical (diagonal) form $y^{T}Dy$ and an orthogonal matrix $P$ such that $x = Py$ defines the corresponding change of variables."}] [{:db/id #edb/ref 17592186162639 :knowledge-point/_questions [{:knowledge-point/id #uuid "a07cbbfc-0f61-55e8-afe9-b675dc74f24e" :knowledge-point/title "Reducing a Quadratic Function Over the 3D-Space to the Canonical Form Using Orthogonal Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a042fc8f-539f-5bdb-bddf-c5fe30041a80" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0 \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186394984} {:answer/id #uuid "6dc77117-300e-5b56-8c2f-140816b1741a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186394985} {:answer/id #uuid "1b8d7eed-8c68-5288-bf38-d8900425c601" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & 1\\end{aligned}]" :db/id #edb/ref 17592186394986} {:answer/id #uuid "e217cdf1-3dc8-57d9-9626-db83e92641ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{aligned}]" :db/id #edb/ref 17592186394987} {:answer/id #uuid "97cc3ca7-68d4-575c-b995-c7ff1f31637d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & -1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186394988}] :answer-field/correct {:answer/id #uuid "e217cdf1-3dc8-57d9-9626-db83e92641ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{aligned}]" :db/id #edb/ref 17592186394987} :answer-field/id #uuid "d94e720f-93b6-56f5-a9cd-79db4928f0b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394983}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7f0148f4-83df-5e99-8325-e264016c452b" :question/math-academy-id "q-94461" :question/problem "$$\nA=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{aligned}],\\,D=[\\begin{aligned}10 & 0 & 0 \\\\ 0 & 5 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=10,\\,$ ${\\lambda }_{2}=5,\\,$ and $\\,{\\lambda }_{3}=3.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=10,$ we have\n\n$$\n\\begin{aligned}A-10I & =[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{aligned}]-10[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-7 & 0 & 0 \\\\ 0 & -1 & 2 \\\\ 0 & 2 & -4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-10I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=5,$ we have\n\n$$\n\\begin{aligned}A-5I & =[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{aligned}]-5[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-2 & 0 & 0 \\\\ 0 & 4 & 2 \\\\ 0 & 2 & 1\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-5I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{5},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{5}}[\\begin{aligned}0 \\\\ -1 \\\\ 2\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=3,$ we have\n\n$$\n\\begin{aligned}A-3I & =[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 9 & 2 \\\\ 0 & 2 & 6\\end{aligned}]-3[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 6 & 2 \\\\ 0 & 2 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-3I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=1,$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}0 & 0 & 1 \\\\ \\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} & 0 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} & 0\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186088464 :knowledge-point/_questions [{:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6" :knowledge-point/title "Calculating the y-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2f967d2-885e-51ca-b0a2-754d2b775328" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 2 ± \\sqrt{2})" :db/id #edb/ref 17592186087408} {:answer/id #uuid "daba3d80-0c91-58e6-a635-fc0bd67387d5" :answer/type {:db/ident :answer.type/math} :answer/value "(0, ± \\sqrt{3})" :db/id #edb/ref 17592186087409} {:answer/id #uuid "f140d64a-5e81-51c0-b702-ab29d6678905" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 5 ± \\sqrt{3})" :db/id #edb/ref 17592186087410} {:answer/id #uuid "fe1f58ad-0a40-5f0e-bb19-f858d2ccdecf" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 3 ± \\sqrt{5})" :db/id #edb/ref 17592186087411} {:answer/id #uuid "6e2f299d-9055-599f-a92a-f21a2f66b72c" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 3 ± \\sqrt{3})" 