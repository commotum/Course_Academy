b8ef-e2cdb51e48b6" :answer/type {:db/ident :answer.type/math} :answer/value "p(t)=6-2t+4{t}^{3}" :db/id #edb/ref 17592186394993} {:answer/id #uuid "31058618-d899-5b3d-bb20-955078dd0168" :answer/type {:db/ident :answer.type/math} :answer/value "p(t)=6+2t-4{t}^{3}" :db/id #edb/ref 17592186394994} {:answer/id #uuid "10c3738f-e015-5e98-9181-9d82b115c4b5" :answer/type {:db/ident :answer.type/math} :answer/value "p(t)=6+t-2{t}^{3}" :db/id #edb/ref 17592186394995}] :answer-field/correct {:answer/id #uuid "31058618-d899-5b3d-bb20-955078dd0168" :answer/type {:db/ident :answer.type/math} :answer/value "p(t)=6+2t-4{t}^{3}" :db/id #edb/ref 17592186394994} :answer-field/id #uuid "537b9234-7288-5762-81f8-d3815f1f4aeb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394990}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84116a53-1342-5c6b-abeb-dda206837ef9" :question/math-academy-id "q-95004" :question/problem "Consider the polynomials ${p}_{1}(t)$ and ${p}_{2}(t),$ given by\n\n$$\n{p}_{1}(t)=2t+{t}^{3},\\,{p}_{2}(t)=3-t-3{t}^{3}.\n$$\n\nFind $p(t)$ given that $B={{p}_{1}(t),{p}_{2}(t)}$ is a basis of $\\text{Span}{{p}_{1},{p}_{2}},$ and the coordinates of $p(t)$ relative to $B$ are $[p(t)]_{B}=[\\begin{aligned}2 \\\\ 2\\end{aligned}].$" :question/worked-solution "Any vector in  $\\text{Span}{{p}_{1},{p}_{2}}$ can be written as\n\n$$\n\\begin{aligned}{x}_{1}{p}_{1}(t)+{x}_{2}{p}_{2}(t).\\end{aligned}\n$$\n\nIn our case, we have \n\n$$\n[p(t)]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=[\\begin{aligned}2 \\\\ 2\\end{aligned}].\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}p(t) & =2\\cdot (2t+{t}^{3})+2\\cdot (3-t-3{t}^{3}) \\\\  & =4t+2{t}^{3}+6-2t-6{t}^{3} \\\\  & =6+2t-4{t}^{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394996 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0a6b6e1-fb99-5ebe-9f3f-000878f79f0d" :knowledge-point/title "Finding the Coordinates of a Vector With Respect to a Given Basis in a Matrix Vector Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5226adcf-c64d-5855-bb34-33692d805606" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186394998} {:answer/id #uuid "1218ec16-27de-5244-b46a-3719907959bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186394999} {:answer/id #uuid "b2ba6bfb-aefb-5459-b3fb-9e2227499ed8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186395000} {:answer/id #uuid "ff86cb35-663a-5979-afcf-39f451ff20d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186395001} {:answer/id #uuid "d34c1e79-ae0a-5950-aeae-9c06b0734d12" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395002}] :answer-field/correct {:answer/id #uuid "1218ec16-27de-5244-b46a-3719907959bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186394999} :answer-field/id #uuid "06578788-3100-5d6d-9df0-7305e2069e6d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394997}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afea1de7-9432-5f54-8eea-c94a31190309" :question/math-academy-id "q-95019" :question/problem "Consider the following matrices:\n\n$$\n{B}_{1}=[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}],\\,{B}_{2}=[\\begin{aligned}5 & -3 \\\\ 0 & 4\\end{aligned}],\\,A=[\\begin{aligned}4 & -3 \\\\ 0 & 5\\end{aligned}]\n$$\n\nIf $B={{B}_{1},{B}_{2}}$ is a basis of $\\text{Span}{{B}_{1},{B}_{2}},$ and $[A]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],$ then ${x}_{1}+{x}_{2}=$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n{x}_{1}{B}_{1}+{x}_{2}{B}_{2}=A.\n$$\n\nSubstituting the given information into the above equation, we get\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]+{x}_{2}[\\begin{aligned}5 & -3 \\\\ 0 & 4\\end{aligned}] & =[\\begin{aligned}4 & -3 \\\\ 0 & 5\\end{aligned}] \\\\ [\\begin{aligned}2{x}_{1}+5{x}_{2} & -3{x}_{2} \\\\ 0 & -2{x}_{1}+4{x}_{2}\\end{aligned}] & =[\\begin{aligned}4 & -3 \\\\ 0 & 5\\end{aligned}].\\end{aligned}\n$$\n\nEquating the corresponding entries, we obtain\n\n$$\n{\\begin{aligned}2{x}_{1}+5{x}_{2}=4 \\\\ -3{x}_{2}=-3 \\\\ -2{x}_{1}+4{x}_{2}=5.\\end{aligned}\n$$\n\n \n\nThe equations above give a linear system with the augmented matrix\n\n$$\nM=[\\begin{aligned}2 & 5 & 4 \\\\ 0 & -3 & -3 \\\\ -2 & 4 & 5\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M= & [\\begin{aligned}2 & 5 & 4 \\\\ 0 & -3 & -3 \\\\ -2 & 4 & 5\\end{aligned}] &  & \\begin{aligned}{R}_{3}:={R}_{3}+{R}_{1}\\end{aligned} \\\\ ∼ & [\\begin{aligned}2 & 5 & 4 \\\\ 0 & -3 & -3 \\\\ 0 & 9 & 9\\end{aligned}]\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned}2{x}_{1}+5{x}_{2}=4 \\\\ -3{x}_{2}=-3 \\\\ 9{x}_{2}=9.\\end{aligned}\n$$\n\nFrom the second and third equations, we get ${x}_{2}=1.$ From the first equation, we get \n\n$$\n\\begin{aligned}2{x}_{1}+5\\cdot 1 & =4 \\\\ 2{x}_{1} & =-1 \\\\ {x}_{1} & =-\\frac{1}{2}.\\end{aligned}\n$$\n\n \n\nTherefore, $[A]_{B}=[\\begin{aligned}-\\frac{1}{2} \\\\ 1\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=-\\frac{1}{2}+1=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186162660 :knowledge-point/_questions [{:knowledge-point/id #uuid "a07cbbfc-0f61-55e8-afe9-b675dc74f24e" :knowledge-point/title "Reducing a Quadratic Function Over the 3D-Space to the Canonical Form Using Orthogonal Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "927834b7-3d18-5db5-abab-f666bc5af8f9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395004} {:answer/id #uuid "26af6070-1f6f-51b7-9850-35fb204fd9fc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 & 0 \\\\ 0 & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395005} {:answer/id #uuid "64bcd310-100e-5d4a-9083-894659694caa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{2}{\\sqrt{5}} & 0 & \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/id #edb/ref 17592186395006} {:answer/id #uuid "79ebf064-b4d2-5fc0-acb8-3c83ecd66e17" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{2}} & 0 \\\\ 0 & 0 & 1 \\\\ \\frac{1}{\\sqrt{5}} & \\frac{1}{\\sqrt{2}} & 0\\end{aligned}]" :db/id #edb/ref 17592186395007} {:answer/id #uuid "fd8de7cc-e082-5310-94db-9f5a79a7e15a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 & 0 \\\\ -\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395008}] :answer-field/correct {:answer/id #uuid "927834b7-3d18-5db5-abab-f666bc5af8f9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395004} :answer-field/id #uuid "bbd2f1c2-56b9-525a-98ce-2d7df8ee2c78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395003}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00c817da-6580-5c3d-a2f1-9c059dd42da6" :question/math-academy-id "q-95095" :question/problem "$$\nA=[\\begin{aligned}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}],\\,D=[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=4,\\,$ ${\\lambda }_{2}=1,\\,$ and $\\,{\\lambda }_{3}=-2.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=4,$ we have\n\n$$\n\\begin{aligned}A-4I & =[\\begin{aligned}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]-4[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-3 & 0 & -3 \\\\ 0 & -3 & 0 \\\\ -3 & 0 & -3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-4I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=1,$ we have\n\n$$\n\\begin{aligned}A-I & =[\\begin{aligned}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]-[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}0 & 0 & -3 \\\\ 0 & 0 & 0 \\\\ -3 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=1,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{1}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}3 & 0 & -3 \\\\ 0 & 3 & 0 \\\\ -3 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186395009 :knowledge-point/_questions [{:knowledge-point/id #uuid "a07cbbfc-0f61-55e8-afe9-b675dc74f24e" :knowledge-point/title "Reducing a Quadratic Function Over the 3D-Space to the Canonical Form Using Orthogonal Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74508bdf-f140-5808-9753-25533e49826f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{2}} & 0 & -\\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395011} {:answer/id #uuid "fda3000f-f50a-5453-b611-d8cc82671b33" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{2}{\\sqrt{5}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{5}} \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186395012} {:answer/id #uuid "b2cb2171-7767-503d-acc5-5ef3cf65216f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395013} {:answer/id #uuid "34171141-8b0b-51c6-a150-b276b6fadb51" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0 \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]" :db/id #edb/ref 17592186395014} {:answer/id #uuid "c401f7c6-a855-53e8-a6f2-2c4c412ac54e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186395015}] :answer-field/correct {:answer/id #uuid "c401f7c6-a855-53e8-a6f2-2c4c412ac54e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186395015} :answer-field/id #uuid "ab3a3316-bf9a-5cf4-b520-c0a23f6216d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395010}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3b5dfdd-d519-5388-b5ca-0b0271c9801c" :question/math-academy-id "q-95100" :question/problem "$$\nA=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}],\\,D=[\\begin{aligned}2 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\nConsider the matrices given above.\nFind an orthogonal matrix $P$ such that $x=Py$ defines the corresponding change of variables that reduces the quadratic form $Q(x)={x}^{T}\\,Ax$ to the canonical (diagonal) form ${y}^{T}\\,Dy.$" :question/worked-solution "Every quadratic form can be reduced to its canonical (diagonal) form using orthogonal transformations.\n\nFrom the diagonal matrix $D,$ we deduce that the eigenvalues of the matrix $A$ are \n\n$\\,$ ${\\lambda }_{1}=2,\\,$ ${\\lambda }_{2}=0,\\,$ and $\\,{\\lambda }_{3}=-2.$\n\nNow, we need to find an eigenvector basis of $A.$ \n\n- For ${\\lambda }_{1}=2,$ we have\n\n$$\n\\begin{aligned}A-2I & =[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]-2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-3 & 1 & 0 \\\\ 1 & -3 & 0 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-2I)x=0$ gives the eigenvector ${v}_{1}=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{1}$ by its norm $‖{v}_{1}‖=1,$ we get \n\n$$\n\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{1}[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\n- For ${\\lambda }_{2}=0,$ we have\n\n$$\n\\begin{aligned}A-0I & =[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]-0[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-0I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}-1 & 1 & 0 \\\\ 1 & -1 & 0 \\\\ 0 & 0 & 2\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}1 & 1 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 4\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}0 & \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ 0 & \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ 1 & 0 & 0\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186395016 :knowledge-point/_questions [{:knowledge-point/id #uuid "9316ee08-13ad-57cf-87cf-2c7a86645aca" :knowledge-point/title "Finding a Matrix that Defines an Orthogonal Projection Onto the Subspace Spanned by a Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1285cc7e-6557-517f-8e27-4eb07d6626b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}[\\begin{aligned}4 & 1 & 2 \\\\ 1 & 2 & 4 \\\\ 2 & 4 & 8\\end{aligned}]" :db/id #edb/ref 17592186395018} {:answer/id #uuid "7875ed04-8923-5b45-b4b1-a0171df50ad4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}[\\begin{aligned}4 & 1 & 2 \\\\ 1 & 2 & 4 \\\\ 2 & 4 & 4\\end{aligned}]" :db/id #edb/ref 17592186395019} {:answer/id #uuid "8950bfec-9e37-5179-8f26-2500b4d6ff4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}[\\begin{aligned}8 & 2 & 4 \\\\ 2 & 1 & 2 \\\\ 4 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186395020} {:answer/id #uuid "1e7055b0-7310-5bd3-a23e-a9ef9bf2d8fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}[\\begin{aligned}16 & 4 & 8 \\\\ 4 & 1 & 2 \\\\ 8 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186395021} {:answer/id #uuid "6697e194-dcc5-5fe7-97f6-d06a04ff5686" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}[\\begin{aligned}4 & 1 & 2 \\\\ 8 & 2 & 4 \\\\ 4 & 2 & 8\\end{aligned}]" :db/id #edb/ref 17592186395022}] :answer-field/correct {:answer/id #uuid "1e7055b0-7310-5bd3-a23e-a9ef9bf2d8fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{21}[\\begin{aligned}16 & 4 & 8 \\\\ 4 & 1 & 2 \\\\ 8 & 2 & 4\\end{aligned}]" :db/id #edb/ref 17592186395021} :answer-field/id #uuid "f4f801fb-87b2-5250-bfef-4d0912cd15d5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57299fa6-a7d9-5d12-9ff7-3ad9559d19e4" :question/math-academy-id "q-95188" :question/problem "Find a matrix that defines the orthogonal projection of ${R}^{3}$ onto the subspace spanned by $a=[\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}].$" :question/worked-solution "Recall that the matrix ${P}_{S}=A({A}^{T}\\,A)^{-1}\\,{A}^{T}$ maps any vector $x\\in {R}^{n}$ onto its orthogonal projection in the subspace $S$ spanned by the columns of the matrix $A.$ \n\nIn our case, $A=[\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}].$ Therefore,\n\n$$\n\\begin{aligned}{P}_{S} & =A({A}^{T}\\,A)^{-1}\\,{A}^{T} \\\\  & =[\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}]{([\\begin{aligned}4 & 1 & 2\\end{aligned}][\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}])}^{-1}[\\begin{aligned}4 & 1 & 2\\end{aligned}] \\\\  & =(21)^{-1}[\\begin{aligned}4 \\\\ 1 \\\\ 2\\end{aligned}][\\begin{aligned}4 & 1 & 2\\end{aligned}] \\\\  & =\\frac{1}{21}[\\begin{aligned}16 & 4 & 8 \\\\ 4 & 1 & 2 \\\\ 8 & 2 & 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395023 :knowledge-point/_questions [{:knowledge-point/id #uuid "d9fd0121-5ce9-5a7b-a706-59ba73a71f7a" :knowledge-point/title "Finding a Matrix That Defines an Orthogonal Projection Onto the Subspace Spanned by a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3762f0b-456b-583d-9ae5-ecdf99185742" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{35}[\\begin{aligned}13 & 11 & -3 \\\\ 11 & 2 & -1 \\\\ -3 & -1 & -8\\end{aligned}]" :db/id #edb/ref 17592186395025} {:answer/id #uuid "e9bf8a05-dd37-5285-a753-8858b8139dcc" :answer/type {:db/ident :answer.type/math} :answer/val