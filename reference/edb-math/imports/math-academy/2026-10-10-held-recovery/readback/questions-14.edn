 :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}2\\cdot {5}^{n-1}" :db/id #edb/ref 17592186392948} {:answer/id #uuid "91f1f27b-9af7-553c-b295-1671e8997521" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}3\\cdot {5}^{n-1}" :db/id #edb/ref 17592186392949} {:answer/id #uuid "5cf73b67-0962-5b65-8964-f7777638a1bf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}{5}^{n-1}" :db/id #edb/ref 17592186392950}] :answer-field/correct {:answer/id #uuid "4a605415-fb8b-5421-814b-729680936fc6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{4}2\\cdot {5}^{n-1}" :db/id #edb/ref 17592186392948} :answer-field/id #uuid "dba73746-6853-5dad-ac99-3bb42df8b2dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392945}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e64d67e6-1bc3-5539-af8b-728c62f5e3ba" :question/math-academy-id "q-67004" :question/problem "The geometric series $2+10+50+250$ can be written using sigma notation as" :question/worked-solution "We must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=2$ and $N=4.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{10}{2}=5\n$$\n\nTherefore, expressing the geometric series given in sigma notation, we obtain:\n\n$$\n\\begin{aligned}2+10+50+250 & ={\\sum }_{n=1}^{4}2\\cdot {5}^{n-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392951 :knowledge-point/_questions [{:knowledge-point/id #uuid "6532d0fb-1a24-5177-bd20-2efcb3e13f3d" :knowledge-point/title "Writing a Geometric Series With a Negative Common Ratio Using Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db8c3132-b12f-5307-9585-c8c34a52694b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}5\\cdot {(-\\frac{1}{2})}^{n-1}" :db/id #edb/ref 17592186392953} {:answer/id #uuid "f556a39f-31f9-5e28-b901-253f9c2f3fe3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}3\\cdot {(-\\frac{1}{2})}^{n-1}" :db/id #edb/ref 17592186392954} {:answer/id #uuid "5529ab02-0429-5134-a01c-4ca64f34ff30" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}\\frac{1}{2}\\cdot {(-\\frac{1}{5})}^{n-1}" :db/id #edb/ref 17592186392955} {:answer/id #uuid "1d711393-6990-5780-937a-8f31120177bf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}2\\cdot {(-\\frac{1}{5})}^{n-1}" :db/id #edb/ref 17592186392956} {:answer/id #uuid "862101f0-bd47-53df-918b-272f26019f1f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}{(-\\frac{1}{5})}^{n-1}" :db/id #edb/ref 17592186392957}] :answer-field/correct {:answer/id #uuid "862101f0-bd47-53df-918b-272f26019f1f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{5}{(-\\frac{1}{5})}^{n-1}" :db/id #edb/ref 17592186392957} :answer-field/id #uuid "b2dcc755-7b8b-52bc-8e9b-fc3ca27fab24" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392952}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "de5820d4-26f7-5cf8-b386-1e337fe65ff8" :question/math-academy-id "q-67284" :question/problem "The geometric series $1-\\frac{1}{5}+\\frac{1}{25}-\\frac{1}{125}+\\frac{1}{625}$ can be expressed using sigma notation as" :question/worked-solution "We must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=1$ and $N=5.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{(-\\frac{1}{5})}{1}=-\\frac{1}{5}\n$$\n\nTherefore, expressing the given geometric series in sigma notation, we obtain:\n\n$$\n\\begin{aligned}1-\\frac{1}{5}+\\frac{1}{25}-\\frac{1}{125}+\\frac{1}{625} & ={\\sum }_{n=1}^{5}1\\cdot {(-\\frac{1}{5})}^{n-1} \\\\  & ={\\sum }_{n=1}^{5}{(-\\frac{1}{5})}^{n-1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392958 :knowledge-point/_questions [{:knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/title "Finding a Height Corresponding to an Extended Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f70c953-efc1-574d-8fb8-f485df44a32b" :answer/type {:db/ident :answer.type/image} :answer/value "images/10/109606d69a47d93c20b57ba740c8fec43164f0b71137e805a11cf8fd78cc3e5d.png" :db/id #edb/ref 17592186392960} {:answer/id #uuid "0e0a8ba2-53f6-517e-9751-d2499c8bbd45" :answer/type {:db/ident :answer.type/image} :answer/value "images/cf/cf634d9c8c1a307a3fdc892ca5e21745dc58d073a2b6f57b62146eaeca4697e3.png" :db/id #edb/ref 17592186392961} {:answer/id #uuid "784b392f-7bf7-5c31-b3ae-c517fa954657" :answer/type {:db/ident :answer.type/image} :answer/value "images/de/decfd00e92564ee5b585db65f9c0e7939c870f25d6abe8127caf68744a9bab71.png" :db/id #edb/ref 17592186392962} {:answer/id #uuid "7c36a4eb-a024-58d0-8ed7-0ada2ed0db01" :answer/type {:db/ident :answer.type/image} :answer/value "images/d2/d2dd7694f1a3270b8828c6d70c54aae70fa4278080d51e221bd381118fdc6bea.png" :db/id #edb/ref 17592186392963} {:answer/id #uuid "37876aac-ef37-5759-be77-ff362d5911b2" :answer/type {:db/ident :answer.type/image} :answer/value "images/c0/c0bb0bbb65f7cf40eae632f4a31f9970b5001914c5d7ef10f862fdfb5fde70a7.png" :db/id #edb/ref 17592186392964}] :answer-field/correct {:answer/id #uuid "784b392f-7bf7-5c31-b3ae-c517fa954657" :answer/type {:db/ident :answer.type/image} :answer/value "images/de/decfd00e92564ee5b585db65f9c0e7939c870f25d6abe8127caf68744a9bab71.png" :db/id #edb/ref 17592186392962} :answer-field/id #uuid "5ebf1608-aea4-5b5f-a8a3-ef0c2effd002" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392959}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e894a678-9e81-5873-b4d1-dfdcd0757479" :question/math-academy-id "q-67742" :question/problem "![](images/32/32696442e640d051939cc70094bac54bc8540665f5386b8bd0288531a327a9b5.png)\n\nGiven $△ABC$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{BC}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{BC}$ is a line segment that \n\n- runs from the opposite vertex $A$ to the line $\\overset{⟷}{BC},$ and\n\n- is perpendicular to $\\overset{⟷}{BC}.$\n\nTo draw the height, we proceed as follows:\n\n- Extend the line segment $\\overset{―}{BC}.$\n\n![](images/26/26bb0e4cf177eec77164b76cb3b72986977ebe439fe39220ac820d7d3cc2a03b.png)\n\n- Draw the perpendicular from $A$ to $\\overset{⟷}{BC}.$\n\n![](images/de/decfd00e92564ee5b585db65f9c0e7939c870f25d6abe8127caf68744a9bab71.png)"}] [{:db/id #edb/ref 17592186392965 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6727fdd-a614-5ead-9273-08c0a7fec997" :knowledge-point/title "Calculating a Linear Combination of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43f31230-0191-5a33-9bb6-0fa7b614f351" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 15 & 6 \\\\ 2 & 14 & 11\\end{aligned}]" :db/id #edb/ref 17592186392967} {:answer/id #uuid "dbcc9309-5767-5a6f-9aa6-d329adc4d01c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 & 15 \\\\ 2 & 11 & 14\\end{aligned}]" :db/id #edb/ref 17592186392968} {:answer/id #uuid "4cf8254f-ba83-5a63-900a-3e1c1e498e5e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 & 14 \\\\ 2 & 11 & 15\\end{aligned}]" :db/id #edb/ref 17592186392969} {:answer/id #uuid "8d6b4403-a5b1-58bb-a750-3f579f43ba12" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 & 5 \\\\ 2 & 11 & 10\\end{aligned}]" :db/id #edb/ref 17592186392970} {:answer/id #uuid "fb62ffb5-df7e-583b-a72f-d8637500006d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 & 15 \\\\ -2 & 11 & 14\\end{aligned}]" :db/id #edb/ref 17592186392971}] :answer-field/correct {:answer/id #uuid "dbcc9309-5767-5a6f-9aa6-d329adc4d01c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 6 & 15 \\\\ 2 & 11 & 14\\end{aligned}]" :db/id #edb/ref 17592186392968} :answer-field/id #uuid "18f4324f-d0d0-557c-90a1-7c9edabe233c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392966}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6a24360c-add3-5cc0-aec3-f47a46ccf0fe" :question/math-academy-id "q-69642" :question/problem "Calculate $\\frac{1}{3}G+2H$, where\n$G=[\\begin{aligned}3 & 6 & 15 \\\\ -12 & 9 & 6\\end{aligned}]$\nand\n$H=[\\begin{aligned}1 & 2 & 5 \\\\ 3 & 4 & 6\\end{aligned}].$" :question/worked-solution "We multiply each entry of $G$ by $\\frac{1}{3}$ and each entry of $H$ by $2,$ and then add the resulting matrices, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}G+2H & =\\frac{1}{3}[\\begin{aligned}3 & 6 & 15 \\\\ -12 & 9 & 6\\end{aligned}]+2[\\begin{aligned}1 & 2 & 5 \\\\ 3 & 4 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3}\\cdot 3 & \\frac{1}{3}\\cdot 6 & \\frac{1}{3}\\cdot 15 \\\\ \\frac{1}{3}\\cdot (-12) & \\frac{1}{3}\\cdot 9 & \\frac{1}{3}\\cdot 6\\end{aligned}]+[\\begin{aligned}2\\cdot 1 & 2\\cdot 2 & 2\\cdot 5 \\\\ 2\\cdot 3 & 2\\cdot 4 & 2\\cdot 6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2 & 5 \\\\ -4 & 3 & 2\\end{aligned}]+[\\begin{aligned}2 & 4 & 10 \\\\ 6 & 8 & 12\\end{aligned}] \\\\  & =[\\begin{aligned}1+2 & 2+4 & 5+10 \\\\ -4+6 & 3+8 & 2+12\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 6 & 15 \\\\ 2 & 11 & 14\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392972 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b687fc9-53f7-5853-9360-306c0311973d" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -3 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392974} {:answer/id #uuid "71ea72fb-ac89-5df1-8d6f-fe9e6002557a" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392975} {:answer/id #uuid "3df46268-d9d2-5f5e-aa79-f84e369b811f" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ 4 \\\\ 5\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 3 \\\\ -3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392976} {:answer/id #uuid "f245945b-3bb8-5ef1-8860-a8816cdec44b" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}]+t[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392977} {:answer/id #uuid "ff4ddbdb-8ad7-5d62-9244-8e16616c8774" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}2 \\\\ 5 \\\\ 0\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392978}] :answer-field/correct {:answer/id #uuid "71ea72fb-ac89-5df1-8d6f-fe9e6002557a" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392975} :answer-field/id #uuid "fea882e0-2bec-5686-a8ea-8994427553fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392973}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de330e5d-d3af-5611-ac93-1e08d17f5215" :question/math-academy-id "q-69773" :question/problem "Find a vector equation of the line that passes through the points $H(5,7,2)$ and $S(3,4,5).$" :question/worked-solution "The vector equation of the straight line passing through $H$ and parallel to $v$ is given by\n\n$$\nr=h+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $h$ is the position vector of $H.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $H(5,7,2)$ and $S(3,4,5),$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{HS} \\\\  & =⟨3,4,5⟩-⟨5,7,2⟩ \\\\  & =⟨-2,-3,3⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}5 \\\\ 7 \\\\ 2\\end{aligned}]+t[\\begin{aligned}-2 \\\\ -3 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088283 :knowledge-point/_questions [{:knowledge-point/id #uuid "653503b2-4631-561e-af5e-847bcbdfe8e2" :knowledge-point/title "Finding a Horizontal Asymptote When the Degree of the Numerator is Greater"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cd3e90b-21d4-5c39-a74f-a8b3dc60ad75" :answer/type {:db/ident :answer.type/math} :answer/value "y = 0" :db/id #edb/ref 17592186086323} {:answer/id #uuid "91352696-c929-59f2-8b70-c45491cf1e8f" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{1}{4}" :db/id #edb/ref 17592186086324} {:answer/id #uuid "a74c08c2-9793-54d0-941b-4da5dd3f49bc" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{3}{4}" :db/id #edb/ref 17592186086325} {:answer/id #uuid "ad6056e4-f995-52ac-87a7-70ea33cd15d4" :answer/type {:db/ident :answer.type/math} :answer/value "y =-1" :db/id #edb/ref 17592186086326} {:answer/id #uuid "da384d83-dedc-5559-bac4-9ec73e540903" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptotes" :db/id #edb/ref 17592186086327}] :answer-field/id #uuid "80769bb5-2099-5b9f-ac7f-e2bd07c98605" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086322}] :question/id #uuid "0e542b04-fff9-5d2f-9fc8-db21225d104b" :question/math-academy-id "q-6993" :question/problem "Determine the horizontal asymptote of $f(x) = \\frac{x^{3} + 3}{4x^{2} - 6x}$."}] [{:db/id #edb/ref 17592186392979 :knowledge-point/_questions [{:knowledge-point/id #uuid "a88f6712-2115-55ce-abe4-b3c27e2e105f" :knowledge-point/title "Applying a Laplace Expansion Across a Row"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "deea6f11-2212-5136-986d-eb2c6c9161fb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392981} {:answer/id #uuid "dc83f30f-7301-5d68-b5c4-bf0d0381be6c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392982} {:answer/id #uuid "c71fbff2-d8c7-5f96-969d-6b1c6b5f9789" :answer/type {:db/ident :answer.type/math} :answer/value "-|\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392983} {:answer/id #uuid "d75f538e-88e2-521b-8696-849c4f3b1cf8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392984} {:answer/id #uuid "745346ec-61c9-599a-be09-b23f7093ed5a" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392985}] :answer-field/correct {:answer/id #uuid "dc83f30f-7301-5d68-b5c4-bf0d0381be6c" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|" :db/id #edb/ref 17592186392982} :answer-field/id #uuid "83d6a691-7c53-5720-81d6-4ff94ceac019" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392980}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77b8f120-b46e-5255-b315-458b6b755462" :question/math-academy-id "q-69950" :question/problem "$|\\begin{aligned}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 5 & -1 & -2 & 2\\end{aligned}|=$" :question/worked-solution "The $3$rd row of the matrix contains three zeros, more than any other row. So using a Laplace expansion along the $3$rd row, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -2 & 1 & 2 \\\\ 4 & 2 & -3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 5 & -1 & -2 & 2\\end{aligned}| & =0\\cdot {C}_{31}+0\\cdot {C}_{32}+0\\cdot {C}_{33}+2\\cdot {C}_{34} \\\\  & =2\\cdot (-1)^{3+4}\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}| \\\\  & =-2\\cdot |\\begin{aligned}1 & -2 & 1 \\\\ 4 & 2 & -3 \\\\ 5 & -1 & -2\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392986 :knowledge-point/_questions [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8178ab3-c9f7-5d8c-8117-4f1f74b1ab49" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392988} {:answer/id #uuid "410ab9be-7cc7-54f3-a784-da1b9a30bfde" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 17 \\\\ 16\\end{aligned}]" :db/id #edb/ref 17592186392989} {:answer/id #uuid "40de1131-c500-5140-8c7e-271d3572a65b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ -17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392990} {:answer/id #uuid "2a7cd954-5b67-5cac-8093-3f7017db6934" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ 17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392991} {:answer/id #uuid "75a2f729-1c8d-5690-ae16-63c6281a2c59" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 \\\\ -17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392992}] :answer-field/correct {:answer/id #uuid "e8178ab3-c9f7-5d8c-8117-4f1f74b1ab49" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 17 \\\\ -16\\end{aligned}]" :db/id #edb/ref 17592186392988} :answer-field/id #uuid "288f911c-4b7f-5104-b845-ad8fb1649020" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392987}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91918c10-0bb0-5694-a610-fb8455554519" :question/math-academy-id "q-70190" :question/problem "Find $Lz$ if \n$L=[\\begin{aligned}1 & 0 & 4 \\\\ 1 & 3 & -2 \\\\ 2 & 0 & -5\\end{aligned}]$\nand\n$z=[\\begin{aligned}-3 \\\\ 8 \\\\ 2\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Lz & =[\\begin{aligned}1 & 0 & 4 \\\\ 1 & 3 & -2 \\\\ 2 & 0 & -5\\end{aligned}][\\begin{aligned}-3 \\\\ 8 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1\\cdot (-3)+0\\cdot 8+4\\cdot 2 \\\\ 1\\cdot (-3)+3\\cdot 8+(-2)\\cdot 2 \\\\ 2\\cdot (-3)+0\\cdot 8+(-5)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}-3+0+8 \\\\ -3+24-4 \\\\ -6+0-10\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 17 \\\\ -16\\end{aligned}]\\end{aligned}\n$$"}]}
