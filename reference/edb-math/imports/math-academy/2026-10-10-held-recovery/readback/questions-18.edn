x)\\,\\text{d}x" :db/id #edb/ref 17592186394773} {:answer/id #uuid "cfc2ceff-0cf2-5285-a027-d57e020bb89c" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186394774} {:answer/id #uuid "f91b87f6-7751-5ae0-82fb-3bf1cec07cbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186394775} {:answer/id #uuid "9c2684b2-bcb0-5f63-8490-f97890bfc88f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186394776} {:answer/id #uuid "6071726a-10de-5a3c-a866-c13a54ca8fdf" :answer/type {:db/ident :answer.type/math} :answer/value "-{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186394777}] :answer-field/correct {:answer/id #uuid "cfc2ceff-0cf2-5285-a027-d57e020bb89c" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" :db/id #edb/ref 17592186394774} :answer-field/id #uuid "4d46a420-90bd-531e-be78-00e7e79b2c2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394772}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8d33409-c623-5f70-8121-08ea4427ad09" :question/math-academy-id "q-88206" :question/problem "${\\int }_{-3}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x=$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)={x}^{2}\\operatorname{cos}⁡(5x)$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{2}\\operatorname{cos}⁡(5(-x)) \\\\  & ={x}^{2}\\operatorname{cos}⁡(-5x) \\\\  & ={x}^{2}\\operatorname{cos}⁡(5x) \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)={x}^{2}\\operatorname{cos}⁡(5x)$ is an even function, we have\n\n$$\n{\\int }_{-3}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x=2{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x.\n$$"}] [{:db/id #edb/ref 17592186394778 :knowledge-point/_questions [{:knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a34bd077-9be1-5cd3-be13-0e0181077e9b" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186394780} {:answer/id #uuid "3a5c3e71-7f6d-594f-a826-d9fafbec86ef" :answer/type {:db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186394781} {:answer/id #uuid "cdd7941b-aaf2-5165-bdc1-54cb7f6a2561" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186394782} {:answer/id #uuid "6ffcbe70-bf08-5ff6-83d7-c6b4c28a448a" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186394783} {:answer/id #uuid "b5f535b7-4732-53ed-9c80-3f234b68b109" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394784}] :answer-field/correct {:answer/id #uuid "6ffcbe70-bf08-5ff6-83d7-c6b4c28a448a" :answer/type {:db/ident :answer.type/math} :answer/value "-25" :db/id #edb/ref 17592186394783} :answer-field/id #uuid "4a33ee9e-e01b-57c4-b697-df179407774b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4d2284d9-59bd-591b-a5ed-82b600cb5dc8" :question/math-academy-id "q-88454" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x} & =0 \\\\ ({x}^{2}-25)\\cdot {4}^{3x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-25=0\\,\\text{and}\\,{4}^{3x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-25=0$ can be factored as\n\n$$\n(x+5)(x-5)=0,\n$$\n\nwhich leads to the solutions $x=-5,5.$\n\n- The equation ${4}^{3x}=0$ has no solutions because ${4}^{3x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,5,$ and their product is $(-5)\\cdot 5=-25.$"}] [{:db/id #edb/ref 17592186394785 :knowledge-point/_questions [{:knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef56dae1-235e-58a4-9d49-dac58019c11c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186394787} {:answer/id #uuid "5d542604-cc75-5fe8-a314-152f5e0d0baf" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186394788} {:answer/id #uuid "98750137-8ecd-58a9-830f-28a32bdedfa5" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186394789} {:answer/id #uuid "d7e12eec-8e62-581b-b20f-14c8b66d8602" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186394790} {:answer/id #uuid "57fa678f-41a4-5b0a-9cfb-0034cbdf2533" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394791}] :answer-field/correct {:answer/id #uuid "57fa678f-41a4-5b0a-9cfb-0034cbdf2533" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394791} :answer-field/id #uuid "e16451bc-a0a9-548c-ba07-f9abe1416b11" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394786}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3d7afbe-c052-55bc-910e-6663c48abfcd" :question/math-academy-id "q-88459" :question/problem "What is the product of solutions of the equation $2{x}^{2}\\cdot {2}^{x-1}+12x\\cdot {2}^{x-1}+10\\cdot {2}^{x-1}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {2}^{x-1}+12x\\cdot {2}^{x-1}+10\\cdot {2}^{x-1} & =0 \\\\ (2{x}^{2}+12x+10){2}^{x-1} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}+12x+10=0\\,\\text{and}\\,{2}^{x-1}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}+12x+10=0$ can be factored as\n\n$$\n2(x+1)(x+5)=0,\n$$\n\nwhich leads to the solutions $x=-5,-1.$\n\n- The equation ${2}^{x-1}=0$ has no solutions because ${2}^{x-1}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,-1,$ and their product is $(-5)\\cdot (-1)=5.$"}] [{:db/id #edb/ref 17592186394792 :knowledge-point/_questions [{:knowledge-point/id #uuid "c89778fa-3c8d-5f0a-a0f8-c9b3d9193ffd" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5b8c41-9275-5085-abef-6a1812aa469f" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & 8 \\\\ -5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186394794} {:answer/id #uuid "ba181d58-8ebc-580b-bb59-d040b7302269" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & -5 \\\\ 8 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186394795} {:answer/id #uuid "c10a9d61-198c-505f-b96f-83ca77a5a247" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186394796} {:answer/id #uuid "dcd23087-1a21-5756-9a57-94c2eb1f694a" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186394797} {:answer/id #uuid "a28c94e5-2455-5339-81d6-ba859dc3ddf5" :answer/type {:db/ident :answer.type/math} :answer/value "x=-\\frac{1}{40}[\\begin{aligned}6 & 5 \\\\ -8 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186394798}] :answer-field/correct {:answer/id #uuid "c10a9d61-198c-505f-b96f-83ca77a5a247" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186394796} :answer-field/id #uuid "97cd5c37-7a5a-599e-b258-49eb4d18806c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394793}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba637199-2f92-58f3-86a2-b0752019d746" :question/math-academy-id "q-8856" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n{\\begin{aligned}8y=6 \\\\ -5x+6y=7\\end{aligned}\n$$" :question/worked-solution "This system can be written as\n\n$$\n[\\begin{aligned}0 & 8 \\\\ -5 & 6\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}6 \\\\ 7\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=[\\begin{aligned}0 & 8 \\\\ -5 & 6\\end{aligned}].$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 0-(-5)\\cdot 8}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}] \\\\  & =\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{40}[\\begin{aligned}6 & -8 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}6 \\\\ 7\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092890 :knowledge-point/_questions [{:knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae4964c-f640-51d6-b9c7-f318fd111484" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}0 & -5 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394800} {:answer/id #uuid "17c85b88-207b-522e-a8c6-8f0876a467b0" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394801} {:answer/id #uuid "7f2499d2-9266-5a26-a0ba-05f6dec3dc83" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}2 & -5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394802} {:answer/id #uuid "b9d702b1-ea00-5873-b240-8fda112f30b3" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}2 & -5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394803} {:answer/id #uuid "54dc7049-9dbc-5720-9a0e-cef337a14f34" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394804}] :answer-field/correct {:answer/id #uuid "17c85b88-207b-522e-a8c6-8f0876a467b0" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186394801} :answer-field/id #uuid "b0c09813-9278-5368-bde8-427b6b2c6b32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394799}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a7ea58d8-c912-5e16-b0bd-a3c96b9a8c0b" :question/math-academy-id "q-8857" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}{\\begin{aligned}2x=5y \\\\ x=-2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x-5y=0 \\\\ x=-2.\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ -2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -5 \\\\ 1 & 0\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 0-(-5)\\cdot 1}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}[\\begin{aligned}0 & 5 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}0 \\\\ -2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394805 :knowledge-point/_questions [{:knowledge-point/id #uuid "2688742c-1655-557a-888d-af7e2179a89c" :knowledge-point/title "Simplifying Definite Integrals of Even Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cba8b544-597a-5095-b2d3-fee328cf054b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{9}({x}^{2}-3)\\,\\text{d}x" :db/id #edb/ref 17592186394807} {:answer/id #uuid "72d843b1-1260-550a-941e-9facee3551ee" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{9}({x}^{2}-3)\\,\\text{d}x" :db/id #edb/ref 17592186394808} {:answer/id #uuid "54d2d1f2-fd54-5c28-adf4-5637ef29a702" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{9}({x}^{2}-3)\\,\\text{d}x" :db/id #edb/ref 17592186394809} {:answer/id #uuid "b8fc21be-f6ff-5814-8bdd-35aed11eece5" :answer/type {:db/ident :answer.type/math} :answer/value "-{\\int }_{0}^{9}({x}^{2}-3)\\,\\text{d}x" :db/id #edb/ref 17592186394810} {:answer/id #uuid "9794ce51-44f6-595f-a9bb-00f2535c883c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186394811}] :answer-field/correct {:answer/id #uuid "72d843b1-1260-550a-941e-9facee3551ee" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{9}({x}^{2}-3)\\,\\text{d}x" :db/id #edb/ref 17592186394808} :answer-field/id #uuid "b669fc82-10c0-54cf-8a23-dcd9695e7270" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44ef4d16-5b7c-5c1c-ae5e-3f46913cf425" :question/math-academy-id "q-88582" :question/problem "Simplify the integral ${\\int }_{-9}^{9}({x}^{2}-3)\\,\\text{d}x$ using symmetry." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)={x}^{2}-3$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =((-x)^{2}-3) \\\\  & =({x}^{2}-3) \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=({x}^{2}-3)$ is an even function, we have\n\n$$\n{\\int }_{-9}^{9}({x}^{2}-3)\\,\\text{d}x=2{\\int }_{0}^{9}({x}^{2}-3)\\,\\text{d}x.\n$$"}] [{:db/id #edb/ref 17592186394812 :knowledge-point/_questions [{:knowledge-point/id #uuid "2688742c-1655-557a-888d-af7e2179a89c" :knowledge-point/title "Simplifying Definite Integrals of Even Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4569a67-9a9a-5c93-9c04-8f027738fd58" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{5}(-2{x}^{4})\\,\\text{d}x" :db/id #edb/ref 17592186394814} {:answer/id #uuid "7518e113-ee93-520f-9d16-a7a3197e232a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{10}(-2{x}^{4})\\,\\text{d}x" :db/id #edb/ref 17592186394815} {:answer/id #uuid "04d202da-31ae-5d19-92c6-d8c377c75140" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186394816} {:answer/id #uuid "3b8bc65c-d59e-55f5-acc5-682fbaaa986c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{5}(-2{x}^{4})\\,\\text{d}x" :db/id #edb/ref 17592186394817} {:answer/id #uuid "d154893b-dc63-5039-944d-f4b02772b5ad" :answer/type {:db/ident :answer.type/math} :answer/value "-{\\int }_{0}^{5}(-2{x}^{4})\\,\\text{d}x" :db/id #edb/ref 17592186394818}] :answer-field/correct {:answer/id #uuid "f4569a67-9a9a-5c93-9c04-8f027738fd58" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{5}(-2{x}^{4})\\,\\text{d}x" :db/id #edb/ref 17592186394814} :answer-field/id #uuid "0119927c-a01d-5b78-a103-50404f248e3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394813}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08d1c857-ad7f-54d3-8cc2-8674402a4da7" :question/math-academy-id "q-88587" :question/problem "${\\int }_{-5}^{5}(-2{x}^{4})\\,\\text{d}x=$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)=-2{x}^{4}$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =-2(-x)^{4} \\\\  & =-2{x}^{4} \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=-2{x}^{4}$ is an even function, we have\n\n$$\n{\\int }_{-5}^{5}(-2{x}^{4})\\,\\text{d}x=2{\\int }_{0}^{5}(-2{x}^{4})\\,\\text{d}x.\n$$"}] [{:db/id #edb/ref 17592186394819 :knowledge-point/_questions [{:knowledge-point/id #uuid "2688742c-1655-557a-888d-af7e2179a89c" :knowledge-point/title "Simplifying Definite Integrals of Even Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17c2ecf4-99f4-5dad-ab4f-910329c94dfe" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /4}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186394821} {:answer/id #uuid "b7fef5ff-24d7-5327-a103-82c357613c13" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186394822} {:answer/id #uuid "758abcaf-63e6-5073-89e4-0e3884143544" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186394823} {:answer/id #uuid "31097718-5ae5-59aa-bd91-30f505bad699" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{\\pi /2}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186394824} {:answer/id #uuid "7735ad99-af34-539c-b750-3bf5a3df7d82" :answer/type {:db/ident :answer.type/math} :answer/value "-{\\int }_{0}^{\\pi /4}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186394825}] :answer-field/correct {:answer/id #uuid "17c2ecf4-99f4-5dad-ab4f-910329c94dfe" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /4}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x" :db/id #edb/ref 17592186394821} :answer-field/id #uuid "7abae3bf-d10f-5c55-80f7-9c49ccf34f4a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64adcc49-a78d-5de5-9601-bc19735c1f25" :question/math-academy-id "q-88591" :question/problem "Simplify the integral ${\\int }_{-\\pi /4}^{\\pi /4}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x$ using symmetry." :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any even function $f(x),$ the graph of $y=f(x)$ is symmetric across the $y$-axis, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=2{\\int }_{0}^{a}f(x)\\,\\text{d}x.\n$$\n\nNotice that $f(x)={x}^{3}\\operatorname{tan}⁡x$ is an even function. Indeed, we have\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{3}\\operatorname{tan}⁡(-x) \\\\  & =-{x}^{3}(-\\operatorname{tan}⁡x) \\\\  & ={x}^{3}\\operatorname{tan}⁡x \\\\  & =f(x).\\end{aligned}\n$$\n\nSo, because $f(x)={x}^{3}\\operatorname{tan}⁡x$ is an even function, we have\n\n$$\n{\\int }_{-\\pi /4}^{\\pi /4}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x=2{\\int }_{0}^{\\pi /4}{x}^{3}\\operatorname{tan}⁡x\\,\\text{d}x.\n$$"}] [{:db/id #edb/ref 17592186394826 :knowledge-point/_questions [{:knowledge-point/id #uuid "331fa12f-a113-5aba-bd6e-5bd5bf62298f" :knowledge-point/title "Simplifying Symbolic Statements Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41602012-bb04-5534-99d3-1c336df87d22" :answer/type {:db/ident :answer.type/math} :answer/value "Q∨(P∧Q)" :db/id #edb/ref 17592186394828} {:answer/id #uuid "d42d1bd4-4961-5827-8390-3da0a398ab43" :answer/type {:db/ident :answer.type/math} :answer/value "P" :db/id #edb/ref 17592186394829} {:answer/id #uuid "02b88ca0-c86b-513b-804e-f3b44341424b" :answer/type {:db/ident :answer.type/math} :answer/value "P∧Q" :db/id #edb/ref 17592186394830} {:answer/id #uuid "e43ee3bb-80df-5c31-80d1-c1a57e26a965" :answer/type {:db/ident :answer.type/math} :answer/value "P∧(Q∨P)" :db/id #edb/ref 17592186394831} {:answer/id #uuid "662d7345-9f00-55a6-9a0c-dea7cf22c9c4" :answer/type {:db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186394832}] :answer-field/correct {:answer/id #uuid "662d7345-9f00-55a6-9a0c-dea7cf22c9c4" :answer/type {:db/ident :answer.type/math} :answer/value "P∨Q" :db/id #edb/ref 17592186394832} :answer-field/id #uuid "5bd8780b-5e12-55d9-bb80-be017170c855" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8088540-0f2b-5602-b820-b1ed9dad2fb7" :question/math-academy-id "q-89266" :question/problem "Simplify $(P∨Q)∨(Q∧Q).$" :question/worked-solution "Using the associative and idempotent laws, we get\n\n$$\n\\begin{aligned}(P∨Q)∨(Q∧Q) & ≡(P∨Q)∨Q \\\\  & ≡P∨(Q∨Q) \\\\  & ≡P∨Q.\\end{aligned}\n$$"}]}
