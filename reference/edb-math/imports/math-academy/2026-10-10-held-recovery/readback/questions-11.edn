#{[{:db/id #edb/ref 17592186229675 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5bc609b-dc5b-52e9-9f0e-206f32bb829b" :knowledge-point/title "Finding the General Solution of a Homogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e3c6cf5-b1b3-57df-abab-56efb96d89f8" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}\\cos (4t) \\\\ \\sin (4t)\\end{bmatrix} + c_{2}\\begin{bmatrix}-\\sin (4t) \\\\ \\cos (4t)\\end{bmatrix}e^{-4t}" :db/id #edb/ref 17592186228215} {:answer/id #uuid "a0710c2c-0243-5683-af7c-dd5379117712" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}\\cos (4t) \\\\ \\sin (4t)\\end{bmatrix} + c_{2}\\begin{bmatrix}-\\sin (4t) \\\\ \\cos (4t)\\end{bmatrix}" :db/id #edb/ref 17592186228216} {:answer/id #uuid "e8fa826d-432e-567c-b648-b350c15d4141" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}\\cos (4t) \\\\ \\sin (4t)\\end{bmatrix}e^{4t} + c_{2}\\begin{bmatrix}-\\sin (4t) \\\\ \\cos (4t)\\end{bmatrix}" :db/id #edb/ref 17592186228217} {:answer/id #uuid "02570066-a4ba-5ed7-9532-5cfdb98488c8" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}\\cos (4t) \\\\ \\sin (4t)\\end{bmatrix} + c_{2}\\begin{bmatrix}-\\sin (4t) \\\\ \\cos (4t)\\end{bmatrix}e^{4t}" :db/id #edb/ref 17592186228218} {:answer/id #uuid "310ab06b-a4b2-54bf-bfab-dcc138d0d2d7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}\\cos (4t) \\\\ \\sin (4t)\\end{bmatrix} + c_{2}\\begin{bmatrix}\\sin (4t) \\\\ \\cos (4t)\\end{bmatrix}" :db/id #edb/ref 17592186228219}] :answer-field/id #uuid "6e4f9160-e954-5fed-b512-345d3c9abd75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228214}] :question/id #uuid "783e954f-0aef-53d9-a6ee-3a8685affb71" :question/math-academy-id "q-334772" :question/problem "${x^{′}(t) =-4y(t); y^{′}(t) = 4x(t)$\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: $e^{At} = \\begin{bmatrix}\\cos (4t) & -\\sin (4t) \\\\ \\sin (4t) & \\cos (4t)\\end{bmatrix}$, where $A = \\begin{bmatrix}0 & -4 \\\\ 4 & 0\\end{bmatrix}$.*"}] [{:db/id #edb/ref 17592186222010 :knowledge-point/_questions [{:knowledge-point/id #uuid "32e63c33-8820-542f-afab-f27a1f6a847a" :knowledge-point/title "Proving the Smoothness Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a43dda4f-aa46-525c-b03f-485d6458d443" :answer/type {:db/ident :answer.type/text} :answer/value "integration by parts" :db/id #edb/ref 17592186220698} {:answer/id #uuid "c30b7646-897f-5455-9161-e26a9046e747" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating under the integral sign" :db/id #edb/ref 17592186220699} {:answer/id #uuid "5663368c-3b85-50ef-b92b-96274f65ec12" :answer/type {:db/ident :answer.type/text} :answer/value "the continuity of partial derivatives" :db/id #edb/ref 17592186220700}] :answer-field/id #uuid "ecf1f1b4-b06a-507a-84e7-80c87f923bf4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220697} {:answer-field/choices [{:answer/id #uuid "b5040251-30be-5821-a978-d2e574fdaf0f" :answer/type {:db/ident :answer.type/text} :answer/value "the definition of the second derivative with respect to $s$" :db/id #edb/ref 17592186220702} {:answer/id #uuid "d0f7b1af-3202-5deb-8e00-1615f8d0248c" :answer/type {:db/ident :answer.type/text} :answer/value "differentiating under the integral sign" :db/id #edb/ref 17592186220703} {:answer/id #uuid "f0b74fa7-7702-58a0-b129-e576c8b260e2" :answer/type {:db/ident :answer.type/text} :answer/value "the definition of the Laplace transform" :db/id #edb/ref 17592186220704} {:answer/id #uuid "464506da-d861-55af-89de-cab00b1f4dd8" :answer/type {:db/ident :answer.type/text} :answer/value "integration by parts" :db/id #edb/ref 17592186220705}] :answer-field/id #uuid "6999a3d8-470e-55c6-bb84-2e9b47b0ae4d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220701} {:answer-field/choices [{:answer/id #uuid "d3170702-c578-5f56-a779-195f44568d79" :answer/type {:db/ident :answer.type/text} :answer/value "the linearity of the Laplace transform" :db/id #edb/ref 17592186220707} {:answer/id #uuid "3c5b52eb-40f6-530f-8f3e-cf6fee8e8d8f" :answer/type {:db/ident :answer.type/text} :answer/value "the product rule" :db/id #edb/ref 17592186220708} {:answer/id #uuid "53dbbbf4-d538-5315-98b3-bf70b7ce09ea" :answer/type {:db/ident :answer.type/text} :answer/value "the chain rule" :db/id #edb/ref 17592186220709}] :answer-field/id #uuid "133ad3e3-e7f1-5a96-a348-9e104655f6a7" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220706}] :question/id #uuid "40ff4752-2fb6-5924-9814-2ff991abb48a" :question/math-academy-id "q-334874" :question/problem "Suppose that $f(t)$ is piecewise continuous on $[0, ∞)$ and its Laplace transform\n$F(s) = L{f(t)}$\nexists for $s > a$. Then, $F(s)$ is twice differentiable at every point $s > a$, and we have\n$F^{″}(s) = L{t^{2} \\cdot f(t)}$.\n\nA proof of this statement is given below.\n\n> $L1$: $F(s) = \\displaystyle \\int_{0}^{∞}e^{-st}f(t)dt$ exists for $s > a$.\n> $L2$: $F^{″}(s) = \\frac{d^{2}}{ds^{2}}\\displaystyle \\int_{0}^{∞}e^{-st}f(t)dt$\n> $L3$: $F^{″}(s) = \\displaystyle \\int_{0}^{∞}\\frac{∂^{2}}{∂s^{2}}(e^{-st}f(t))dt$\n> $L4$: $\\frac{∂^{2}}{∂s^{2}}(e^{-st}f(t)) = t^{2}e^{-st}f(t)$\n> $L5$: $F^{″}(s) = \\displaystyle \\int_{0}^{∞}t^{2}e^{-st}f(t)dt$\n> $L6$: $F^{″}(s) = L{t^{2} \\cdot f(t)}$\n\nSelect the correct options in the following reasoning.\n\nLine $L2$ follows from line $L1$ and\n{{field-1}}.\n\nLine $L3$ follows from $L2$ and {{field-2}}.\n\nLine $L4$ follows from {{field-3}}."}] [{:db/id #edb/ref 17592186391525 :knowledge-point/_questions [{:knowledge-point/id #uuid "16481b80-9744-5c8d-843a-14af30fd8cf4" :knowledge-point/title "Identifying and Interpreting the Lotka-Volterra Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdb4ed4e-5982-595b-8411-719af1fc8daa" :answer/type {:db/ident :answer.type/text} :answer/value "rate of change" :db/id #edb/ref 17592186391527} {:answer/id #uuid "930e955f-f486-5b79-ac37-e2bb7d995b1c" :answer/type {:db/ident :answer.type/text} :answer/value "amount" :db/id #edb/ref 17592186391528}] :answer-field/correct {:answer/id #uuid "cdb4ed4e-5982-595b-8411-719af1fc8daa" :answer/type {:db/ident :answer.type/text} :answer/value "rate of change" :db/id #edb/ref 17592186391527} :answer-field/id #uuid "a3d29eb0-e081-5535-a8d8-d24758a7c44b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391526} {:answer-field/choices [{:answer/id #uuid "eefd88b6-5ed8-5e56-97a5-84f5e5b9ced2" :answer/type {:db/ident :answer.type/text} :answer/value "predator" :db/id #edb/ref 17592186391530} {:answer/id #uuid "0160babf-a013-59e1-b565-159549cd8ce3" :answer/type {:db/ident :answer.type/text} :answer/value "prey" :db/id #edb/ref 17592186391531}] :answer-field/correct {:answer/id #uuid "0160babf-a013-59e1-b565-159549cd8ce3" :answer/type {:db/ident :answer.type/text} :answer/value "prey" :db/id #edb/ref 17592186391531} :answer-field/id #uuid "49e11686-e80d-596d-a5fd-7116689372d8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391529}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e000d57d-98f9-55aa-b3de-818fe5192c62" :question/math-academy-id "q-334981" :question/problem "$$\n{\\begin{aligned}{x}^{′}=-3x+4xy \\\\ {y}^{′}=2y-xy\\end{aligned}\n$$\n\nConsider the Lotka-Volterra model above for the functions $x(t)$ and $y(t).$ Select the correct options in the following statement.$\\,$\nTerm ${y}^{′}$ in the second equation represents the \n{{field-1}} \nof the \n{{field-2}}." :question/worked-solution "The Lotka-Volterra predator-prey model is given by\n\n$$\n{\\begin{aligned}{x}^{′}=ax-bxy \\\\ {y}^{′}=-cy+dxy\\end{aligned}\n$$\n\nwhere $a,b,c,d$ are positive real constants. \n\nFirst, recall that a derivative represents a $\\text{rate of change}.$\n\nFor the ${y}^{′}$ equation, we have\n\n$$\n{y}^{′}=2y-xy.\n$$\n\nTherefore, $y$ must represent the $\\text{prey}.$ Indeed, \n\n- it grows exponentially in the absence of predators (the $2y$ term), and\n\n- decreases when interacting with predators (the $-xy$ term)."}] [{:db/id #edb/ref 17592186167263 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c9c2220-030e-5418-915c-e34d7962c077" :knowledge-point/title "Analyzing a Solution of the Lotka-Volterra Model Given the Phase Portrait"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83b8c881-9cf3-52da-94cc-ba917a13eb94" :answer/type {:db/ident :answer.type/text} :answer/value "decreases" :db/id #edb/ref 17592186164704} {:answer/id #uuid "e56c30cd-b484-5412-8f30-c798be88b0a2" :answer/type {:db/ident :answer.type/text} :answer/value "increases" :db/id #edb/ref 17592186164705}] :answer-field/id #uuid "f072fdc4-26a5-5cbe-9f69-8868c4c8466c" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164703} {:answer-field/choices [{:answer/id #uuid "b31989b8-2fe7-5f9b-89c1-f7fdb4f663fa" :answer/type {:db/ident :answer.type/text} :answer/value "circles around" :db/id #edb/ref 17592186164707} {:answer/id #uuid "2a325ba0-0ae0-55df-a2e5-f76ba4f5e745" :answer/type {:db/ident :answer.type/text} :answer/value "approaches" :db/id #edb/ref 17592186164708}] :answer-field/id #uuid "16c4af27-b8bf-5e8d-8aac-d75524197c4b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164706} {:answer-field/choices [{:answer/id #uui