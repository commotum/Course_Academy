#{[{:db/id #edb/ref 17592186115760 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ac33006-2d6d-5ee2-9749-a1f3dea17869" :knowledge-point/title "Finding the Limit of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c66f48f-384c-5e45-9d01-dc0929ceca64" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,i-j+\\frac{1}{2}\\,k" :db/id #edb/ref 17592186390732} {:answer/id #uuid "190562a0-9cc5-5ec6-8561-dec97830cb94" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,i+j+\\frac{1}{2}\\,k" :db/id #edb/ref 17592186390733} {:answer/id #uuid "c101822e-5294-5ceb-a69b-aa49cab19465" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,i-2\\,j+\\frac{1}{2}\\,k" :db/id #edb/ref 17592186390734} {:answer/id #uuid "eef3e56c-b04e-5a45-9789-c5c8d3de8ceb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,i+2\\,j+\\frac{1}{2}\\,k" :db/id #edb/ref 17592186390735} {:answer/id #uuid "29218873-2383-585f-9daa-213826254507" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i-4j+\\frac{1}{2}\\,k" :db/id #edb/ref 17592186390736}] :answer-field/correct {:answer/id #uuid "6c66f48f-384c-5e45-9d01-dc0929ceca64" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,i-j+\\frac{1}{2}\\,k" :db/id #edb/ref 17592186390732} :answer-field/id #uuid "7ca27e13-f441-52b9-bc74-cd7c2d4c3788" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390731}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7eaba5fe-9c1d-54f3-af81-ae1b43d46797" :question/math-academy-id "q-32267" :question/problem "Find the limit  $\\,{lim}_{t\\to 2}f(t)$, if $f(t)={t}^{2}\\,i+\\frac{t-4}{2}\\,j+\\frac{1}{t}\\,k.$" :question/worked-solution "First, recall that:\n\n$$\n{lim}_{t\\to 2}f(t)=({lim}_{t\\to 2}{t}^{2})\\,i+({lim}_{t\\to 2}\\frac{t-4}{2})\\,j+({lim}_{t\\to 2}\\frac{1}{t})\\,k\n$$\n\nNow, we find the limits one-by-one.\n\n- For the first component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}{t}^{2} & ={2}^{2}=4\\end{aligned}\n$$\n\n- For the second component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\frac{t-4}{2} & =\\frac{2-4}{2} \\\\  & =\\frac{-2}{2} \\\\  & =-1\\end{aligned}\n$$\n\n- For the third component, we have:\n\n$$\n\\begin{aligned}{lim}_{t\\to 2}\\frac{1}{t} & =\\frac{1}{2}\\end{aligned}\n$$\n\nHence, ${lim}_{t\\to 2}f(t)=4\\,i-j+\\frac{1}{2}\\,k.$"}] [{:db/id #edb/ref 17592186184755 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc8dc1a1-9606-5b67-942e-219ab2ddfc1c" :knowledge-point/title "Finding a Power of a Nilpotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60befaec-36ec-5bcc-9008-ed35714da6da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186390738} {:answer/id #uuid "b9e1cbf6-bcee-5647-9c18-035106ecccb1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -9 \\\\ 4 & -6\\end{aligned}]" :db/id #edb/ref 17592186390739} {:answer/id #uuid "f8bc671c-e1db-57b1-898c-d81ac0904685" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186390740} {:answer/id #uuid "7ca15efe-dcb6-5128-9996-8b2ce0db2597" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & -6 \\\\ 4 & -9\\end{aligned}]" :db/id #edb/ref 17592186390741} {:answer/id #uuid "a2bcb91d-1c62-5830-889e-d2d622d846ff" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 9 \\\\ -4 & 6\\end{aligned}]" :db/id #edb/ref 17592186390742}] :answer-field/correct {:answer/id #uuid "f8bc671c-e1db-57b1-898c-d81ac0904685" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186390740} :answer-field/id #uuid "b467dda5-da42-5b7b-b028-d10f4cde0503" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dafad545-0385-51d6-9233-37b97e1f8f85" :question/math-academy-id "q-32323" :question/problem "If $B=[\\begin{aligned}6 & -9 \\\\ 4 & -6\\end{aligned}]$, then ${B}^{5}=$" :question/worked-solution "Computing ${B}^{2},$ we have\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}6 & -9 \\\\ 4 & -6\\end{aligned}]\\cdot [\\begin{aligned}6 & -9 \\\\ 4 & -6\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}] \\\\  & =O.\\end{aligned}\n$$\n\nNotice that, since ${B}^{2}=O,$ the matrix $B$ is a nilpotent matrix of index $2.$ \n\nWe can use this fact to compute ${B}^{5}$ quickly, as follows:\n\n$$\n\\begin{aligned}{B}^{5} & ={B}^{2}\\cdot {B}^{3} \\\\  & =O\\cdot {B}^{3} \\\\  & =O\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{B}^{5}=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186390743 :knowledge-point/_questions [{:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" :knowledge-point/title "Using the Product Rules for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f86cd3-7815-52c3-a642-88091b5dca5c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨20t-2,\\,36{t}^{2}+12t,\\,72{t}^{3}⟩" :db/id #edb/ref 17592186390745} {:answer/id #uuid "3f10ad58-86c7-5488-87e8-2405ac572b35" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8t-2,\\,-48{t}^{2}+12t,\\,36{t}^{3}-6⟩" :db/id #edb/ref 17592186390746} {:answer/id #uuid "b218608b-b05e-57e2-a7b7-ae74abf570fe" :answer/type {:db/ident :answer.type/math} :answer/value "⟨48t-2,\\,-362{t}^{2}+12t,\\,6⟩" :db/id #edb/ref 17592186390747} {:answer/id #uuid "a3285904-7a37-5bb0-9e4b-ea28118d456b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩" :db/id #edb/ref 17592186390748} {:answer/id #uuid "df14411c-6285-5ce6-9d91-f5503ce280c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩" :db/id #edb/ref 17592186390749}] :answer-field/correct {:answer/id #uuid "df14411c-6285-5ce6-9d91-f5503ce280c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩" :db/id #edb/ref 17592186390749} :answer-field/id #uuid "be6adfc3-be4a-5dfa-b9ef-e4320cc373e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390744}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5c0ab63c-e0ff-5937-9e2f-94c308127204" :question/math-academy-id "q-32347" :question/problem "Find $(f\\times g)^{′}(t)$ given that\n\n$$\n\\begin{aligned}f(t) & =⟨6{t}^{2},\\,2t,\\,6⟩ \\\\ g(t) & =⟨3,\\,3{t}^{2},\\,4t-1⟩\\end{aligned}\n$$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(6)⟩ \\\\  & =⟨12t,\\,2,\\,0⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(4t-1)⟩ \\\\  & =⟨0,\\,6t,\\,4⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 12t & 2 & 0 \\\\ 3 & 3{t}^{2} & (4t-1)\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 0 \\\\ 3{t}^{2} & (4t-1)\\end{aligned}|i-|\\begin{aligned}12t & 0 \\\\ 3 & (4t-1)\\end{aligned}|j+|\\begin{aligned}12t & 2 \\\\ 3 & 3{t}^{2}\\end{aligned}|k \\\\  & =⟨8t-2,\\,12t-48{t}^{2},\\,36{t}^{3}-6⟩ \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ 6{t}^{2} & 2t & 6 \\\\ 0 & 6t & 4\\end{aligned}| \\\\  & =|\\begin{aligned}2t & 6 \\\\ 6t & 4\\end{aligned}|i-|\\begin{aligned}6{t}^{2} & 6 \\\\ 0 & 4\\end{aligned}|j+|\\begin{aligned}6{t}^{2} & 2t \\\\ 0 & 6t\\end{aligned}|k \\\\  & =⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =⟨8t-2,\\,12t-48{t}^{2},\\,36{t}^{3}-6⟩+⟨-28t,\\,-24{t}^{2},\\,36{t}^{3}⟩ \\\\  & =⟨-20t-2,\\,-72{t}^{2}+12t,\\,72{t}^{3}-6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115770 :knowledge-point/_questions [{:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" :knowledge-point/title "Using the Product Rules for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564ab4d2-73e6-558b-9af0-6f5fdd10eee5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}21t+10 \\\\ 45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390751} {:answer/id #uuid "08d9d97e-52f1-593e-bf6d-177ead5a4e63" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8-45{t}^{2} \\\\ 42t+20 \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390752} {:answer/id #uuid "20623cb8-9b6d-552a-a5b9-c2b26e55fa4e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-42t-20 \\\\ 8-45{t}^{2} \\\\ 24{t}^{3}+2t+6\\end{aligned}]" :db/id #edb/ref 17592186390753} {:answer/id #uuid "e3a88e03-753f-57ff-a632-12697f009654" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-24{t}^{3}-2t-6 \\\\ 8-45{t}^{2} \\\\ 42t+20\\end{aligned}]" :db/id #edb/ref 17592186390754} {:answer/id #uuid "31d0af8e-650c-555d-ad59-94751914d534" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390755}] :answer-field/correct {:answer/id #uuid "31d0af8e-650c-555d-ad59-94751914d534" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]" :db/id #edb/ref 17592186390755} :answer-field/id #uuid "e189a085-a70a-5dfd-9709-316634fc8cbc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390750}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54437c76-a800-5517-9d6f-6a2f64f033aa" :question/math-academy-id "q-32353" :question/problem "Find $(f\\times g)^{′}(t)$ where\n\n$$\nf(t)=[\\begin{aligned}3{t}^{2} \\\\ t+4 \\\\ 8\\end{aligned}],\\,g(t)=[\\begin{aligned}t+2 \\\\ -2{t}^{2} \\\\ 5t\\end{aligned}]\n$$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(t+4) \\\\ \\frac{\\text{d}}{\\text{d}t}(8)\\end{aligned}]=[\\begin{aligned}6t \\\\ 1 \\\\ 0\\end{aligned}] \\\\ {g}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(t+2) \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(5t)\\end{aligned}]=[\\begin{aligned}1 \\\\ -4t \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 6t & 1 & 0 \\\\ t+2 & -2{t}^{2} & 5t\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 0 \\\\ -2{t}^{2} & 5t\\end{aligned}|i-|\\begin{aligned}6t & 0 \\\\ t+2 & 5t\\end{aligned}|j+|\\begin{aligned}6t & 1 \\\\ t+2 & -2{t}^{2}\\end{aligned}|k \\\\  & =[\\begin{aligned}5t \\\\ -30{t}^{2} \\\\ -12{t}^{3}-t-2\\end{aligned}] \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ 3{t}^{2} & t+4 & 8 \\\\ 1 & -4t & 5\\end{aligned}| \\\\  & =|\\begin{aligned}t+4 & 8 \\\\ -4t & 5\\end{aligned}|i-|\\begin{aligned}3{t}^{2} & 8 \\\\ 1 & 5\\end{aligned}|j+|\\begin{aligned}3{t}^{2} & t+4 \\\\ 1 & -4t\\end{aligned}|k \\\\  & =[\\begin{aligned}37t+20 \\\\ 8-15{t}^{2} \\\\ -12{t}^{3}-t-4\\end{aligned}]\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =[\\begin{aligned}5t \\\\ -30{t}^{2} \\\\ -12{t}^{3}-t-2\\end{aligned}]+[\\begin{aligned}37t+20 \\\\ 8-15{t}^{2} \\\\ -12{t}^{3}-t-4\\end{aligned}]=[\\begin{aligned}42t+20 \\\\ 8-45{t}^{2} \\\\ -24{t}^{3}-2t-6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167172 :knowledge-point/_questions [{:knowledge-point/id #uuid "6defc05f-0323-58b2-906c-c926cb3a64a5" :knowledge-point/title "Completing the First Row of a Table Using the Modified Euler Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b65bdb4-c7a4-5097-adc9-08fd0af5cd0f" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186164040} {:answer/id #uuid "b39dec20-bffd-5357-8529-fbda1ee976d1" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186164041} {:answer/id #uuid "0ee6f031-bbed-5552-888c-f5ed1b744150" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186164042} {:answer/id #uuid "0f1743fa-a78c-5711-afe4-60c7922b8edc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186164043} {:answer/id #uuid "4e087b7a-ebc3-5313-8bfd-cb632c5ede4f" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186164044}] :answer-field/id #uuid "24466b64-d56c-58a3-a382-a88cb5fe891f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186164039}] :question/id #uuid "4e0eb5a0-8dd3-54db-baaf-7d7b326d8b0a" :question/math-academy-id "q-324062" :question/problem "Consider the following initial value problem:\n$y^{′} = 2xy, y(1) = 1$\nWe wish to approximate the solution using the modified Euler method. What entry should be placed in the cell indicated in the table below, if the step size is $Δx = 1$?\n\n| $x$ | $y$ | $y^{′}$ | $Δy_{p}$ | $y_{p}$ | $y_{p}^{′}$ | $Δy$ |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n| $1$ | $1$ |  |  |  |  |  |\n| $2$ | $$? |  |  |  |  |  |"}] [{:db/id #edb/ref 17592186390756 :knowledge-point/_questions [{:knowledge-point/id #uuid "b51e8ff1-247b-5efd-a684-8fca6c064e1e" :knowledge-point/title "Finding a Power of an Idempotent Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51ba5d1d-917f-578b-b236-84c5ce425052" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ \\frac{1}{2} & \\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186390758} {:answer/id #uuid "9dbe959f-5587-55cc-8bae-e699339e8f4a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{8} \\\\ 1 & \\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186390759} {:answer/id #uuid "ca7a779e-0566-5402-a151-8dcb0f8c03e2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{8} \\\\ \\frac{1}{4} & \\frac{1}{4}\\end{aligned}]" :db/id #edb/ref 17592186390760} {:answer/id #uuid "4ea01b22-3015-5978-9cd8-0f6cd3a74b94" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186390761} {:answer/id #uuid "ded05c43-29b2-5aa4-ac03-348898ec9d4c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{8} \\\\ 1 & \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186390762}] :answer-field/correct {:answer/id #uuid "4ea01b22-3015-5978-9cd8-0f6cd3a74b94" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186390761} :answer-field/id #uuid "ec20b706-5b72-5579-8d68-048b9d6753ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a7c08cd8-33d8-5be3-943c-1859738a0181" :question/math-academy-id "q-32436" :question/problem "If \n$D=[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}]$, then ${D}^{3}=$" :question/worked-solution "First, we compute ${D}^{2}$ as follows:\n\n$$\n\\begin{aligned}{D}^{2} & =D\\cdot D \\\\  & =[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}] \\\\  & =D\\end{aligned}\n$$\n\nNotice that ${D}^{2}=D,$ so $D$ is an idempotent matrix.\n\nWe can use this fact to compute ${D}^{3}$ quickly, as follows:\n\n$$\n\\begin{aligned}{D}^{3} & ={D}^{2}\\cdot D \\\\  & =D\\cdot D \\\\  & ={D}^{2} \\\\  & =D\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{D}^{3}=[\\begin{aligned}\\frac{1}{2} & \\frac{1}{4} \\\\ 1 & \\frac{1}{2}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186129586 :knowledge-point/_questions [{:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39" :knowledge-point/title "Finding the General Solution to a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8a2dcc4-18cc-521a-b8d3-d669cb946726" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}e^{-2t} + c_{2}\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}e^{2t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126970} {:answer/id #uuid "2a25db02-e58c-542a-956a-c2a73e36f7c4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = c_{1}\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}e^{2t} + c_{2}\\begin{bmatrix}3 \\\\ 1\\end{bmatrix}e^{-2t}, c_{1}, c_{2} ∈ R" :db/id #edb/ref 17592186126971} {:answer/id #uuid "47596c87-09f0-5b01-9a14-87