{1}(t) = 2u_{1}(t) - u_{2}(t); x_{2}(t) = 2u_{2}(t)" :db/id #edb/ref 17592186126978} {:answer/id #uuid "1c0ba606-48a9-527b-9766-dd4a1dcdf258" :answer/type {:db/ident :answer.type/math} :answer/value "{x_{1}(t) = u_{1}(t) + u_{2}(t); x_{2}(t) = u_{2}(t)" :db/id #edb/ref 17592186126979} {:answer/id #uuid "48ead97a-9c3b-5e1f-bfd6-75b3c8f05a03" :answer/type {:db/ident :answer.type/math} :answer/value "{x_{1}(t) = u_{1}(t) - u_{2}(t); x_{2}(t) = u_{2}(t)" :db/id #edb/ref 17592186126980}] :answer-field/id #uuid "c9d06948-4bb7-5905-96ef-9064d7847ed4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126975}] :question/id #uuid "5c347aa2-fe8e-5437-94e5-a44fd44640d6" :question/math-academy-id "q-324455" :question/problem "Find the substitution that will decouple the following system of differential equations:\n\n${x_{1}^{′}(t) = 3x_{1}(t) + 2x_{2}(t); x_{2}^{′}(t) = x_{2}(t)$"}] [{:db/id #edb/ref 17592186390763 :knowledge-point/_questions [{:knowledge-point/id #uuid "7634b3ac-f9e6-514e-87ba-e78590c9fa53" :knowledge-point/title "Solving a 2x2 Linear System Using LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "032457e9-02bf-5ad6-9987-99a0689c6243" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186390765} {:answer/id #uuid "ad2b9196-139c-5abe-8bf3-f21b13bb615e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186390766} {:answer/id #uuid "d6722917-7648-59db-8da1-966d52f9d9ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186390767} {:answer/id #uuid "9541c84f-6c02-5508-afe7-624da511dbdc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186390768} {:answer/id #uuid "749e40df-d35d-5ad6-9d4a-9737f8552554" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186390769}] :answer-field/correct {:answer/id #uuid "ad2b9196-139c-5abe-8bf3-f21b13bb615e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9}{2}" :db/id #edb/ref 17592186390766} :answer-field/id #uuid "5e79de7e-b384-5ea6-bb81-dfd5832cccb2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390764}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b44ae0d1-f2bc-52f5-a02c-1e4fb0c1d4e5" :question/math-academy-id "q-32561" :question/problem "Consider the LU decomposition of the matrix $A$ and the vector $b,$ given by\n\n$$\nA={{[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]}_{⏟}}_{L}{{[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}]}_{⏟}}_{U},\\,b=[\\begin{aligned}3 \\\\ -3\\end{aligned}].\n$$\n\nIf $⟨{x}_{1},{x}_{2}⟩$ and $⟨{y}_{1},{y}_{2}⟩$ are the solutions to the systems $Ax=b$ and $Ly=b$ respectively, what is the value of ${x}_{1}\\cdot {y}_{1}?$" :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax=b\\,⟹\\,{{(LU)}_{⏟}}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL{{(Ux)}_{⏟}}_{y}=b\\,⟹\\,{\\begin{aligned}Ly=b \\\\ Ux=y.\\end{aligned}\n$$\n\nNow, we solve the two systems in turn.\n\n- First, we solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}{y}_{1} \\\\ {y}_{2}\\end{aligned}]=b=[\\begin{aligned}3 \\\\ -3\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{y}_{1}=3 \\\\ -2{y}_{1}+{y}_{2}=-3.\\end{aligned}\n$$\n\nThe solution to this system is ${y}_{1}=3$ and ${y}_{2}=3.$ Therefore, \n\n$$\ny=[\\begin{aligned}3 \\\\ 3\\end{aligned}].\n$$\n\n- Next, we solve $Ux=y.$ Writing this equation in matrix form, we get\n\n$$\n[\\begin{aligned}1 & 3 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]=y=[\\begin{aligned}3 \\\\ 3\\end{aligned}].\n$$\n\nThis gives the system of equations\n\n$$\n{\\begin{aligned}{x}_{1}+3{x}_{2}=3 \\\\ 2{x}_{2}=3.\\end{aligned}\n$$\n\nThe solution to this system is ${x}_{2}=\\frac{3}{2}$ and ${x}_{1}=-\\frac{3}{2}.$ Therefore, \n\n$$\nx=[\\begin{aligned}-\\frac{3}{2} \\\\ \\frac{3}{2}\\end{aligned}].\n$$\n\nFinally, ${x}_{1}\\cdot {y}_{1}=-\\frac{3}{2}\\cdot 3=-\\frac{9}{2}.$"}] [{:db/id #edb/ref 17592186115776 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b06f36c-5690-5392-a40a-f670e7419923" :knowledge-point/title "Determining the Differentiability of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87085dfc-1eb2-55e6-b058-c8193dc6ee4e" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $h(t)$ only" :db/id #edb/ref 17592186113593} {:answer/id #uuid "8e7f84df-d3ea-5f0e-a2d1-76f61b5e2aa1" :answer/type {:db/ident :answer.type/text} :answer/value "All of them are differentiable on $(0, π)$" :db/id #edb/ref 17592186113594} {:answer/id #uuid "266f78fe-cf62-5647-baf7-ce8ad9c1ac76" :answer/type {:db/ident :answer.type/text} :answer/value "$f(t)$ and $g(t)$ only" :db/id #edb/ref 17592186113595} {:answer/id #uuid "3f59ab61-4be9-50d5-bc50-b73332e351ba" :answer/type {:db/ident :answer.type/text} :answer/value "$g(t)$ and $h(t)$ only" :db/id #edb/ref 17592186113596} {:answer/id #uuid "570fdc35-3402-51d4-aa0b-09d5b5171559" :answer/type {:db/ident :answer.type/text} :answer/value "None of them are differentiable on $(0, π)$" :db/id #edb/ref 17592186113597}] :answer-field/id #uuid "bae67170-5ab3-54b4-87a6-bfa00d56fca7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113592}] :question/id #uuid "11a6774d-821b-5df3-83c4-601fbb258758" :question/math-academy-id "q-32568" :question/problem "Which of the following vector-valued functions are differentiable with respect to $t$ on $t ∈ (0, π)$?\n\n$f(t)|= ⟨\\sin (2t), \\cos t, 2 - \\cos (2t)⟩; g(t)|= ⟨1 + t^{2},-t + 2, \\sqrt{t}⟩; h(t)|= ⟨\\frac{1}{t}, \\tan t, \\cos t⟩$"}] [{:db/id #edb/ref 17592186120196 :knowledge-point/_questions [{:knowledge-point/id #uuid "a4d10f94-98d4-53d8-a35c-e65a06dd2c55" :knowledge-point/title "Finding the LU Factorization Using a Single Elementary Row Operation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82aab95b-303c-53e6-8ab2-84f6327c5ee5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -1 & 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117308} {:answer/id #uuid "bcb99789-0a50-51fa-bdd2-8edcdb147b3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117309} {:answer/id #uuid "c1646219-17da-5382-a70c-29be623f2a43" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 5 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117310} {:answer/id #uuid "6fa6c065-8e80-5891-9d48-f1f2b1d88af2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117311} {:answer/id #uuid "7d799ac4-cfd7-50f4-84fe-96c72faba44f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}" :db/id #edb/ref 17592186117312}] :answer-field/id #uuid "eb09a7a1-1cf1-5147-b432-0481d5365f80" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117307}] :question/id #uuid "10430503-ea48-51a6-b4f8-6c1fb5c683b2" :question/math-academy-id "q-32569" :question/problem "Given that\n$A = \\begin{bmatrix}2 & 3 & -4 \\\\ 0 & 5 & 1 \\\\ 6 & 9 & -8\\end{bmatrix}$\nhas the LU decomposition $A = LU$, then $L =$"}] [{:db/id #edb/ref 17592186390770 :knowledge-point/_questions [{:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d" :knowledge-point/title "Identifying Regions Where a Function Is Positive or Negative Using a Sign Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dae056ab-7845-5fc5-8a65-cdde9b2cbb30" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390772} {:answer/id #uuid "27cd30f8-4c67-5b18-ae74-5d01e606d486" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390773}] :answer-field/correct {:answer/id #uuid "dae056ab-7845-5fc5-8a65-cdde9b2cbb30" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390772} :answer-field/id #uuid "8a74112e-0c08-5638-a489-048657b454f6" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390771} {:answer-field/choices [{:answer/id #uuid "452c8b52-3ea3-5cb6-9b20-63200080fa73" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390775} {:answer/id #uuid "172538d6-798f-5d52-aaa4-e930af45cbbd" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390776}] :answer-field/correct {:answer/id #uuid "172538d6-798f-5d52-aaa4-e930af45cbbd" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390776} :answer-field/id #uuid "46fa5dec-49b3-5b2d-90a3-ac28dc1634bb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390774} {:answer-field/choices [{:answer/id #uuid "60efd871-1e1b-599a-b039-2a402c71c9a2" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390778} {:answer/id #uuid "7528b55c-f6ca-5670-a6c9-c97bbcc6a15a" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390779}] :answer-field/correct {:answer/id #uuid "60efd871-1e1b-599a-b039-2a402c71c9a2" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390778} :answer-field/id #uuid "487b2d06-4c10-5d8f-aa1c-2f69c5ea9f44" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390777} {:answer-field/choices [{:answer/id #uuid "27855f1e-bf2f-509d-8106-266bf2bf92a0" :answer/type {:db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186390781} {:answer/id #uuid "c67b32f5-a6af-586c-b222-e36503cdaf3d" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390782}] :answer-field/correct {:answer/id #uuid "c67b32f5-a6af-586c-b222-e36503cdaf3d" :answer/type {:db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186390782} :answer-field/id #uuid "982a0b2e-2dc8-5f75-ad31-7f4aebc78fdb" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390780}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ff4ec42-4593-525e-b2e1-f274a6430ad8" :question/math-academy-id "q-326436" :question/problem "Consider the function $f(x,y)=-{x}^{3}(y+1).$ Fill in the missing signs in the sign table of $f(x,y)$ shown below.\n\n| $y>-1$ | {{field-1}} | {{field-2}} |\n| --- | --- | --- |\n| $y<-1$ | {{field-3}} | {{field-4}} |\n|  | $x<0$ | $x>0$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=0$ and $y=-1.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](images/ec/ecbba4555023bdc89892cd902b30039e3a76a919b68c5a2bec670213dfc78c34.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](images/9c/9ca3f95ecca25c73eadd7cbd3840cbc1f8336ff7a1a1598876c11bd4af16805b.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $-{x}^{3}$ | $(y+1)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-1,0)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(1,0)$ | $-$ | $+$ | $-$ |\n| Bottom-Left | $(-1,-2)$ | $+$ | $-$ | $-$ |\n| Bottom-Right | $(1,-2)$ | $-$ | $-$ | $+$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](images/e0/e02c333ffb3063ebf0f214cf88cb9a6d486cff0db958de6d47943f3ca0739e45.png)\n\nFinally, we fill in the required sign table.\n\n| $y>-1$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |"}] [{:db/id #edb/ref 17592186390783 :knowledge-point/_questions [{:knowledge-point/id #uuid "833d0ec0-d895-5d66-b2ad-d058858caf9e" :knowledge-point/title "Solving an Initial Value Problem for a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8b0460a-d0ad-5d76-b63d-e1be79a2bf53" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=-\\frac{3}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+\\frac{9}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}" :db/id #edb/ref 17592186390785} {:answer/id #uuid "d3a14dfc-50da-56c0-9bcf-ac663a34125d" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=-\\frac{7}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+\\frac{1}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}" :db/id #edb/ref 17592186390786} {:answer/id #uuid "1dbcec44-0f8c-57c6-8f12-e880f0d06cfc" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{3}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{3t}-\\frac{9}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t}" :db/id #edb/ref 17592186390787} {:answer/id #uuid "9b1d5dc2-3635-56a3-a363-0ad6d716256c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}-\\frac{7}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}" :db/id #edb/ref 17592186390788} {:answer/id #uuid "a1dd86f6-75a2-50a1-af44-6ffa5adbb75f" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{7}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{3t}-\\frac{1}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t}" :db/id #edb/ref 17592186390789}] :answer-field/correct {:answer/id #uuid "9b1d5dc2-3635-56a3-a363-0ad6d716256c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}-\\frac{7}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}" :db/id #edb/ref 17592186390788} :answer-field/id #uuid "bb599c70-6dbd-5227-961a-371c124bc72d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45696d2e-86e2-52d9-b755-e4c9e51775a3" :question/math-academy-id "q-326437" :question/problem "Find the solution to the initial value problem\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ -3\\end{aligned}].\n$$" :question/worked-solution "First, we write down the matrix differential equation ${x}^{′}(t)=Ax(t)$ for the given system:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}1 & 0 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nWe need to find the eigenvalues and the eigenvectors of the matrix $A.$\n\n- Since $A$ is lower-triangular, the eigenvalues are \n\n$$\n{\\lambda }_{1}=1\\,\\text{and}\\,{\\lambda }_{2}=3.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=1,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}0 & 0 \\\\ -1 & 2\\end{aligned}]∼[\\begin{aligned}1 & -2 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=3,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-2 & 0 \\\\ -1 & 0\\end{aligned}]∼[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations:\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$\n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}1 \\\\ -3\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{0} & =[\\begin{aligned}1 \\\\ -3\\end{aligned}] \\\\ [\\begin{aligned}2{c}_{1} \\\\ {c}_{1}+{c}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ -3\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}2{c}_{1}=1 \\\\ {c}_{1}+{c}_{2}=-3.\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=\\frac{1}{2}.$ Substituting into the second equation, we obtain ${c}_{2}=-\\frac{7}{2}.$ \n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =\\frac{1}{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}-\\frac{7}{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390790 :knowledge-point/_questions [{:knowledge-point/id #uuid "833d0ec0-d895-5d66-b2ad-d058858caf9e" :knowledge-point/title "Solving an Initial Value Problem for a Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "971c1d65-aaf4-500f-a61d-355388de2711" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=-2{e}^{2}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}-3e[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186390792} {:answer/id #uuid "ab6e854a-8251-5b7c-8ffb-c2fe3f1f90de" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=2e[\\begin{aligned}1 \\\\ -2\\end{aligned}]{e}^{2t}-3{e}^{4}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186390793} {:answer/id #uuid "27844e44-0698-5974-86e3-6f6e91726390" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=e[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}-{e}^{4}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186390794} {:answer/id #uuid "1e134e6e-1876-55b1-9672-280feac3c84c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=2e[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}+{e}^{3}[\\begin{aligned}1 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186390795} {:answer/id #uuid "ef560015-a283-5021-bfec-40aa27603ec4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=2[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{-3t}-3[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186390796}] :answer-field/correct {:answer/id #uuid "27844e44-0698-5974-86e3-6f6e91726390" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=e[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}-{e}^{4}[\\begin{aligned}1 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186390794} :answer-field/id #uuid "1d865f6a-782f-5f83-935d-229a82b05fea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390791}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96d25510-4b02-51b1-a16b-31f7b1aede10" :question/math-academy-id "q-327147" :question/problem "Find the solution to the initial value problem\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+2{x}_{2}(t)\\end{aligned},\\,x(1)=[\\begin{aligned}-2{e}^{4} \\\\ {e}^{4}\\end{aligned}].\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=0.$*" :question/worked-solution "First, we write down the matrix differential equation ${x}^{′}(t)=Ax(t)$ for the given system:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nWe need to find the eigenvalues and the eigenvectors of the matrix $A.$\n\n- We are given that the eigenvalues are\n\n$$\n{\\lambda }_{1}=3\\,\\text{and}\\,{\\lambda }_{2}=0.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=3,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-2 & -1 \\\\ -2 & -1\\end{aligned}]∼[\\begin{aligned}1 & 1/2 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].$\n\n- For ${\\lambda }_{2}=0,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}1 & -1 \\\\ -2 & 2\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations:\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{0} \\\\  & ={c}_{1}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=1$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(1) & =[\\begin{aligned}{e}^{4} \\\\ {e}^{4}\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}] & =[\\begin{aligned}-2{e}^{4} \\\\ {e}^{4}\\end{aligned}] \\\\ [\\begin{aligned}-{e}^{3}{c}_{1}+{c}_{2} \\\\ 2{e}^{3}{c}_{1}+{c}_{2}\\end{aligned}] & =[\\begin{aligned}-2{e}^{4} \\\\ {e}^{4}\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}-{e}^{3}{c}_{1}+{c}_{2}=-2{e}^{4} \\\\ 2{e}^{3}{c}_{1}+{c}_{2}={e}^{4}.\\end{aligned}\n$$\n\nSubtracting the first equation from the second one, we get \n\n$$\n\\begin{aligned}3{e}^{3}{c}_{1}=3{e}^{4}\\,⟹\\,{c}_{1}=e.\\end{aligned}\n$$\n\nSubstituting ${c}_{1}=e$ into the second equation, we obtain \n\n$$\n\\begin{aligned}2{e}^{3}(e)+{c}_{2}={e}^{4}\\,⟹\\,{c}_{2}=-{e}^{4}.\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =e[\\begin{aligned}-1 \\\\ 2\\end{aligned}]{e}^{3t}-{e}^{4}[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120212 :knowledge-point/_questions [{:knowledge-point/id #uuid "c159d750-ab1f-538b-b8cc-ae66ef1ae414" :knowledge-point/title "Finding Missing Numbers in the Matrix U of an LU Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90331b12-f792-5375-a8bd-4055b39115e5" :answer/type {:db/ident :answer.type/math} :answer/value "0,-2, 4" :db/id #edb/ref 17592186117404} {:answer/id #uuid "c97e5324-7d77-5c99-b631-a1812c3b83c2" :answer/type {:db/ident :answer.type/math} :answer/value "0,-2, 3" :db/id #edb/ref 17592186117405} {:answer/id #uuid "2215dc05-369a-53a7-975a-e14172283bb4" :answer/type {:db/ident :answer.type/math} :answer/value "0,-5, 4" :db/id #edb/ref 17592186117406} {:answer/id #uuid "27448014-a6a9-5e81-b5d5-5eeb2ae6c9f1" :answer/type {:db/ident :answer.type/math} :answer/value "0,-5, 3" :db/id #edb/ref 17592186117407} {:answer/id #uuid "4b8419fc-06a2-52fa-a173-3f42a8cae713" :answer/type {:db/ident :answer.type/math} :answer/value "0,-5, 1" :db/id #edb/ref 17592186117408}] :answer-field/id #uuid "f62048a0-2cdb-52fe-9039-54e3ecaa6332" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117403}] :question/id #uuid "ce5c7307-c449-5fe7-8928-1317176c796c" :question/math-academy-id "q-32772" :question/problem "$\\begin{bmatrix}2 & 3 & -1 \\\\ 6 & 4 & 1 \\\\ 4 & 6 & -4\\end{bmatrix}_(⏟)_(A) = \\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 2 & 0 & 1\\end{bmatrix}_(⏟)_(L) \\cdot \\begin{bmatrix}2 & 3 & -1 \\\\ N & N & N \\\\ 0 & 0 & -2\\end{bmatrix}_(⏟)_(U)$.\n\nConsider the LU factorization of the matrix $A$ above. From left to right, what are the missing elements from the second row of the matrix $U$?"}] [{:db/id #edb/ref 17592186390797 :knowledge-point/_questions [{:knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f17fc7e8-0774-59d5-a669-3e615ebed902" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 2 & 0 & 3 \\\\ 1 & 8 & 4 & -1 \\\\ 5 & 2 & 1 & 0 \\\\ -1 & 3 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390799} {:answer/id #uuid "7d69e951-e796-50a9-a627-4fb7fb34ee61" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & -1 & 5 & 2 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390800} {:answer/id #uuid "a45cf9ed-3b1e-55c6-ba3a-363e374ea92c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390801} {:answer/id #uuid "61e4c71a-7cef-57c7-9149-cd6ab16e2522" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}-1 & 5 & -2 & 2 \\\\ 7 & 2 & 0 & 3 \\\\ -5 & 2 & 1 & 0 \\\\ 4 & 3 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390802} {:answer/id #uuid "746c7662-4e89-51c6-9606-f2a483de8fdc" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}7 & 2 & 0 & 3 \\\\ 2 & 8 & 4 & -1 \\\\ -5 & 2 & 1 & 0 \\\\ 4 & 3 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390803}] :answer-field/correct {:answer/id #uuid "a45cf9ed-3b1e-55c6-ba3a-363e374ea92c" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|" :db/id #edb/ref 17592186390801} :answer-field/id #uuid "6021bbc8-aef4-542e-be1f-f2189f2911eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390798}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c52202b7-1fa1-5c69-a358-e874710d6248" :question/math-academy-id "q-32798" :question/problem "What is the minor of ${f}_{13}$ in  $F=[\\begin{aligned}0 & -1 & 5 & -2 & 2 \\\\ 0 & 7 & 2 & 0 & 3 \\\\ 1 & 2 & 8 & 4 & -1 \\\\ 5 & -5 & 2 & 1 & 0 \\\\ -1 & 4 & 3 & 11 & 2\\end{aligned}]?$" :question/worked-solution "To get the minor of ${f}_{13}$, we remove the $1$st row and $3$rd column:\n\n$$\nF=[\\begin{aligned}∗ & ∗ & 5 & ∗ & ∗ \\\\ 0 & 7 & ∗ & 0 & 3 \\\\ 1 & 2 & ∗ & 4 & -1 \\\\ 5 & -5 & ∗ & 1 & 0 \\\\ -1 & 4 & ∗ & 11 & 2\\end{aligned}]\n$$\n\n   \n\nSo, the minor is\n\n$$\n{M}_{13}=|\\begin{aligned}0 & 7 & 0 & 3 \\\\ 1 & 2 & 4 & -1 \\\\ 5 & -5 & 1 & 0 \\\\ -1 & 4 & 11 & 2\\end{aligned}|.\n$$"}] [{:db/id #edb/ref 17592186390804 :knowledge-point/_questions [{:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45" :knowledge-point/title "Using the Product Rules for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5e5d9ac-8a14-5201-9516-829a7b45050d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+8{t}^{3}⟩" :db/id #edb/ref 17592186390806} {:answer/id #uuid "6ea13000-9bcb-54fe-a381-f6223d0bb92f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0\\,,\\,0\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390807} {:answer/id #uuid "37229cb1-9b3d-541c-ad4c-f9ff6d2bee90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390808} {:answer/id #uuid "b7f3c695-f3a3-58d0-9e05-5aa5b210d1ad" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,-2+2t\\,,\\,-6t+8{t}^{3}⟩" :db/id #edb/ref 17592186390809} {:answer/id #uuid "2452df56-9f06-5ed0-821f-9ea53a5fecf0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6+6{t}^{2}\\,,\\,-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390810}] :answer-field/correct {:answer/id #uuid "37229cb1-9b3d-541c-ad4c-f9ff6d2bee90" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/id #edb/ref 17592186390808} :answer-field/id #uuid "b00615b6-9721-5844-9bad-568a5f743f33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390805}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d806e973-4767-5c33-a683-2e2483aec09e" :question/math-academy-id "q-32836" :question/problem "Given $f(t)=⟨1-{t}^{2}\\,,\\,1-{t}^{3}\\,,\\,1-t⟩$, find $({f}^{′}\\times f)^{′}(t).$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n({f}^{′}\\times f)^{′}(t)={f}^{″}(t)\\times f(t)+{f}^{′}(t)\\times {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(1-{t}^{3})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(1-t)⟩ \\\\  & =⟨-2t\\,,\\,-3{t}^{2}\\,,\\,-1⟩ \\\\ {f}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(-3{t}^{2})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(-1)⟩ \\\\  & =⟨-2\\,,\\,-6t\\,,\\,0⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{″}(t)\\times f(t) & =|\\begin{aligned}i & j & k \\\\ -2 & -6t & 0 \\\\ 1-{t}^{2} & 1-{t}^{3} & 1-t\\end{aligned}| \\\\  & =|\\begin{aligned}-6t & 0 \\\\ 1-{t}^{3} & 1-t\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ 1-{t}^{2} & 1-t\\end{aligned}|j+|\\begin{aligned}-2 & -6t \\\\ 1-{t}^{2} & 1-{t}^{3}\\end{aligned}|k \\\\  & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩ \\\\ {f}^{′}(t)\\times {f}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ -2t & -3{t}^{2} & -1 \\\\ -2t & -3{t}^{2} & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-3{t}^{2} & -1 \\\\ -3{t}^{2} & -1\\end{aligned}|i-|\\begin{aligned}-2t & -1 \\\\ -2t & -1\\end{aligned}|j+|\\begin{aligned}-2t & -3{t}^{2} \\\\ -2t & -3{t}^{2}\\end{aligned}|k \\\\  & =⟨0\\,,\\,0\\,,\\,0⟩\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}({f}^{′}\\times f)^{′}(t) & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩+⟨0\\,,\\,0\\,,\\,0⟩ \\\\  & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186157748 :knowledge-point/_questions [{:knowledge-point/id #uuid "ec2743cd-4e26-59d5-9368-7a77fa4d0527" :knowledge-point/title "Solving an Initial Value Problem: Purely Imaginary Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4777c8cc-32f9-5990-a586-542488fe0c9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{x}(t)=[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" :db/id #edb/ref 17592186390812} {:answer/id #uuid "0a85b2a0-6bd9-5830-a4eb-8625750ef041" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{x}(t)=[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" :db/id #edb/ref 17592186390813} {:answer/id #uuid "1e8eb4b2-b64f-5669-b200-663db79825b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t\\end{aligned}]" :db/id #edb/ref 17592186390814} {:answer/id #uuid "05e4a4ea-7b03-5e95-8cd2-8a040841abd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" :db/id #edb/ref 17592186390815} {:answer/id #uuid "a449c519-39d9-5440-a74f-baf2eaca3c54" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t+\\operatorname{sin}⁡t\\end{aligned}]" :db/id #edb/ref 17592186390816}] :answer-field/correct {:answer/id #uuid "05e4a4ea-7b03-5e95-8cd2-8a040841abd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" :db/id #edb/ref 17592186390815} :answer-field/id #uuid "56d8e4b6-3562-55f9-a0a0-89ceb9085ef4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d223592-2920-513b-a14a-16d21224ccf7" :question/math-academy-id "q-328593" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}].\n$$\n\n*Hint: One of the eigenvalues of the matrix is ${\\lambda }_{1}=\\text{i}.$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].$\n\nWe are given that the eigenvalue is ${\\lambda }_{1}=\\text{i}.$ \n\nLet's go through the process of finding the eigenvectors. For ${\\lambda }_{1}=\\text{i},$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-\\text{i} & -1 \\\\ 1 & -\\text{i}\\end{aligned}]∼[\\begin{aligned}1 & -\\text{i} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{\\text{i}t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{\\text{i}t} \\\\  & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}](\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡t+\\text{i}\\operatorname{cos}⁡t \\\\ \\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}] \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}{c}_{2} \\\\ {c}_{1}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =-[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186221937 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd" :knowledge-point/title "Proving the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f08c7bbb-c2d0-5cc0-bc38-5213764f4024" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-2t}f(t)" :db/id #edb/ref 17592186390818} {:answer/id #uuid "3d94bd8e-1095-5dca-a3f8-9aaf610978e3" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{2}f(t)" :db/id #edb/ref 17592186390819} {:answer/id #uuid "28bb7e5b-3455-5522-9000-aba6a7f1eb41" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{2t}f(t)" :db/id #edb/ref 17592186390820} {:answer/id #uuid "3a6f9bc4-f8e2-5df6-ba18-334846863668" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{2t}f(t)" :db/id #edb/ref 17592186390821}] :answer-field/correct {:answer/id #uuid "28bb7e5b-3455-5522-9000-aba6a7f1eb41" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{2t}f(t)" :db/id #edb/ref 17592186390820} :answer-field/id #uuid "70e2f98a-16ab-5ff0-97ea-4bd74b0c49aa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390817} {:answer-field/choices [{:answer/id #uuid "65e2db0c-613e-5799-bbf1-d1fd16890715" :answer/type {:db/ident :answer.type/math} :answer/value "F(s)" :db/id #edb/ref 17592186390823} {:answer/id #uuid "0de35569-0f52-5e9a-9e72-6a51d6ee0586" :answer/type {:db/ident :answer.type/math} :answer/value "F(s-2)" :db/id #edb/ref 17592186390824} {:answer/id #uuid "4389475f-b93b-5c1b-b101-b0afcf3c492c" :answer/type {:db/ident :answer.type/math} :answer/value "F(s+2)" :db/id #edb/ref 17592186390825}] :answer-field/correct {:answer/id #uuid "0de35569-0f52-5e9a-9e72-6a51d6ee0586" :answer/type {:db/ident :answer.type/math} :answer/value "F(s-2)" :db/id #edb/ref 17592186390824} :answer-field/id #uuid "e6bfa42b-b843-5d7d-9658-950091ed7693" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390822} {:answer-field/choices [{:answer/id #uuid "918e65b1-37a4-57c9-91f8-31e6cedfd3d1" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s+2)t}" :db/id #edb/ref 17592186390827} {:answer/id #uuid "0bc84124-f50e-5d24-b3dd-36e70598d6cd" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s-2)t}" :db/id #edb/ref 17592186390828} {:answer/id #uuid "563f5f3b-f94c-5c9e-9225-6b76c3213e92" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s+2)t}" :db/id #edb/ref 17592186390829} {:answer/id #uuid "8caaf550-00be-527a-9b74-16e9740ed790" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-2)t}" :db/id #edb/ref 17592186390830}] :answer-field/correct {:answer/id #uuid "8caaf550-00be-527a-9b74-16e9740ed790" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-2)t}" :db/id #edb/ref 17592186390830} :answer-field/id #uuid "20869d57-2780-5f3e-8816-87767b181302" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390826} {:answer-field/choices [{:answer/id #uuid "fcb831e6-ab7e-56db-8853-cf8c7142bb92" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186390832} {:answer/id #uuid "9a50ffe3-b486-5fce-9a67-a9c4583d6c5c" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}+2" :db/id #edb/ref 17592186390833} {:answer/id #uuid "3ef90db9-1b5a-5b95-9214-0ce85e84b3f7" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}-2" :db/id #edb/ref 17592186390834}] :answer-field/correct {:answer/id #uuid "9a50ffe3-b486-5fce-9a67-a9c4583d6c5c" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}+2" :db/id #edb/ref 17592186390833} :answer-field/id #uuid "88721178-9ecd-58e0-9a04-bd9972d88e44" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390831}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c13572d-a427-531e-bc5a-c3129ec5167c" :question/math-academy-id "q-328705" :question/problem "Consider a function $f(t)$ such that its Laplace transform is $L{f(t)}=F(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{2t}f(t)}.$ Select the correct options in the reasoning below. By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{2t}f(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,f(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{2t}f(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{2t}\\,f(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $F(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,f(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t=F(s-2),\n$$\n\nwhere \n\n$$\ns-2>{s}_{0}\\,⇒\\,s>{s}_{0}+2.\n$$"}] [{:db/id #edb/ref 17592186120222 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4636870-89db-5bf9-8a04-777407957e33" :knowledge-point/title "Finding Points Where a Tangent Vector is Parallel to Another Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b73b04b7-7f81-5da6-b3eb-9ceb86cb6994" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1, 2)$ and $(8, e, 2e)$" :db/id #edb/ref 17592186117464} {:answer/id #uuid "cc024178-9448-5f3b-8037-94e2b89c36c3" :answer/type {:db/ident :answer.type/text} :answer/value "$(1, 1, 2)$ and $(8, e^{2}, 2e^{2})$" :db/id #edb/ref 17592186117465} {:answer/id #uuid "05378c03-7088-58e5-8833-839871a0f537" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1, 1)$ and $(4, e, 2e)$" :db/id #edb/ref 17592186117466} {:answer/id #uuid "34c8f45b-2edd-5e5b-9567-319bcce99dc3" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1, 2)$ and $(8, e^{2}, 2e^{2})$" :db/id #edb/ref 17592186117467} {:answer/id #uuid "47f31d44-dbcf-5cb3-8b68-b2659ef75f57" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1, 1)$ and $(8, e^{2}, 2e^{2})$" :db/id #edb/ref 17592186117468}] :answer-field/id #uuid "18987b7e-5379-5dd3-a051-c78ae8fbfe35" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117463}] :question/id #uuid "5e918f3b-d930-5ea5-9b21-8651bb576465" :question/math-academy-id "q-32918" :question/problem "Given the curve $r(t) = ⟨2t^{2}, e^{t}, 2e^{t}⟩$, find all of the points at which $r^{′}(t)$ and $r(t)$ are parallel."}] [{:db/id #edb/ref 17592186120223 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161" :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e448815-b2bb-5846-915b-7d9c23884bb9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=-21" :db/id #edb/ref 17592186390836} {:answer/id #uuid "de65980c-0a80-5e6f-bf87-e8afefe3f527" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=⟨-2,5,-3⟩" :db/id #edb/ref 17592186390837} {:answer/id #uuid "2f57365b-0f99-52f4-983d-60b6ccab865c" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-5,3⟩=⟨-1,2,-3⟩" :db/id #edb/ref 17592186390838} {:answer/id #uuid "687ca452-cc51-531c-b86f-23343784df77" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=-3" :db/id #edb/ref 17592186390839} {:answer/id #uuid "3cdfb2c3-82ee-5d77-b2ad-4381c658ae0e" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨2,-5,3⟩=21" :db/id #edb/ref 17592186390840}] :answer-field/correct {:answer/id #uuid "0e448815-b2bb-5846-915b-7d9c23884bb9" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,-3⟩=-21" :db/id #edb/ref 17592186390836} :answer-field/id #uuid "178ed90e-697e-5682-a979-46b601de175d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390835}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "965706e8-86b7-56ea-92d3-d6b5a93e54f6" :question/math-academy-id "q-32971" :question/problem "Find an equation of the plane that contains the point $P(2,-5,3)$ and is perpendicular to the vector $n=⟨-1,2,-3⟩.$" :question/worked-solution "First, we note that the position vector of $P$ is $p=⟨2,-5,3⟩,$ and $n=⟨-1,2,-3⟩$ is normal to the plane.\n\nThe equation of the plane that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-p)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $p$ is the position vector of $P.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ r\\cdot n-p\\cdot n & =0 \\\\ r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-1,2,-3⟩ & =⟨2,-5,3⟩\\cdot ⟨-1,2,-3⟩ \\\\ r\\cdot ⟨-1,2,-3⟩ & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120224 :knowledge-point/_questions [{:knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a00e2b8e-5c43-5f1e-861a-b8621cd03fb7" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186390842} {:answer/id #uuid "d0576584-3750-547a-9169-cba885383592" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,1,5⟩+s⟨3,-9,-5⟩+t⟨-2,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390843} {:answer/id #uuid "cc58ca2d-f965-5a26-a6a7-4b5c5d9d1c6d" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,1,5⟩+s⟨6,-8,0⟩+t⟨-5,0,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390844} {:answer/id #uuid "448cf521-8dea-57c9-a228-ac326b781ae6" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,1,5⟩+s⟨3,-9,-5⟩+t⟨-5,0,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390845} {:answer/id #uuid "e6fdd784-d294-5584-81fc-4a5e521dbe8b" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,1,5⟩+s⟨6,-8,0⟩+t⟨-2,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390846}] :answer-field/correct {:answer/id #uuid "448cf521-8dea-57c9-a228-ac326b781ae6" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨3,1,5⟩+s⟨3,-9,-5⟩+t⟨-5,0,-2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390845} :answer-field/id #uuid "2f59cecd-7538-5379-bf6c-ff75d0435b9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390841}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "26d7019c-08c2-5f92-a7e5-2893b8366abc" :question/math-academy-id "q-32988" :question/problem "Find a parametric equation of the plane that passes through the points $A(3,1,5),\\,B(6,-8,0)$, and $C(-2,1,3).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨6,-8,0⟩-⟨3,1,5⟩ \\\\  & =⟨3,-9,-5⟩ \\\\ \\overset{\\to }{AC} & =⟨-2,1,3⟩-⟨3,1,5⟩ \\\\  & =⟨-5,0,-2⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $a=⟨3,1,5⟩$ of the point $A,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s\\overset{\\to }{AB}+t\\overset{\\to }{AC} \\\\ r & =⟨3,1,5⟩+s⟨3,-9,-5⟩+t⟨-5,0,-2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390847 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ac33006-2d6d-5ee2-9749-a1f3dea17869" :knowledge-point/title "Finding the Limit of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2495517-9ce9-5cf0-9d38-3082e8134e87" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,1,2⟩" :db/id #edb/ref 17592186390849} {:answer/id #uuid "cec81748-839f-50da-92d0-6f2496f544f3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨e,1,2⟩" :db/id #edb/ref 17592186390850} {:answer/id #uuid "9808d9e4-d207-5982-a7e2-d157cde01307" :answer/type {:db/ident :answer.type/math} :answer/value "⟨e,0,1⟩" :db/id #edb/ref 17592186390851} {:answer/id #uuid "c4e0e309-4655-579d-a341-1fc958b84504" :answer/type {:db/ident :answer.type/math} :answer/value "⟨e,1,\\frac{1}{2}⟩" :db/id #edb/ref 17592186390852} {:answer/id #uuid "ec3e56db-9161-5c55-aaf5-039c47ab1140" :answer/type {:db/ident :answer.type/math} :answer/value "⟨e,0,2⟩" :db/id #edb/ref 17592186390853}] :answer-field/correct {:answer/id #uuid "cec81748-839f-50da-92d0-6f2496f544f3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨e,1,2⟩" :db/id #edb/ref 17592186390850} :answer-field/id #uuid "ece2c50a-437c-5b26-8a89-5d4b4164aef5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390848}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a0c1e7e-622c-5888-8e84-1dc3506584ba" :question/math-academy-id "q-32990" :question/problem "Calculate ${lim}_{s\\to -2}f(s)$, if $f(s)=⟨(s+3)^{1/(s+2)},\\,\\frac{\\operatorname{tan}⁡(s+2)}{(s+2)},\\,\\frac{{s}^{2}+2s}{{s}^{2}+3s+2}⟩.$" :question/worked-solution "First, recall that:\n\n$$\n{lim}_{s\\to -2}f(s)=⟨{lim}_{s\\to -2}(s+3)^{1/(s+2)},\\,{lim}_{s\\to -2}\\frac{\\operatorname{tan}⁡(s+2)}{s+2},\\,{lim}_{s\\to -2}\\frac{{s}^{2}+2s}{{s}^{2}+3s+2}⟩\n$$\n\nNow, we find the limits one-by-one.\n\n- The first component can be found using a special limit:\n\n$$\n\\begin{aligned}{lim}_{s\\to -2}(s+3)^{1/(s+2)} & ={lim}_{s\\to -2}(1+(s+2))^{1/(s+2)} \\\\  & ={lim}_{u\\to 0}(1+u)^{1/u} \\\\  & =e\\end{aligned}\n$$\n\n- The second component can be found using a special limit:\n\n$$\n\\begin{aligned}{lim}_{s\\to -2}\\frac{\\operatorname{tan}⁡(s+2)}{s+2} & ={lim}_{u\\to 0}\\frac{\\operatorname{tan}⁡u}{u}=1\\end{aligned}\n$$\n\n- The third component can be found using factorization:\n\n$$\n\\begin{aligned}{lim}_{s\\to -2}\\frac{{s}^{2}+2s}{{s}^{2}+3s+2} & ={lim}_{s\\to -2}\\frac{s(s+2)}{(s+1)(s+2)} \\\\  & ={lim}_{s\\to -2}\\frac{s}{s+1} \\\\  & =\\frac{-2}{-2+1} \\\\  & =2\\end{aligned}\n$$\n\nHence, ${lim}_{s\\to -2}f(s)=⟨e,1,2⟩.$"}] [{:db/id #edb/ref 17592186390854 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f5c9c30-1745-5986-b116-e9e70a7c6161" :knowledge-point/title "Finding the Vector Equation of the Plane Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c59e6db-4da7-5225-a15a-a3a8cb35b39b" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,2,0⟩=-4" :db/id #edb/ref 17592186390856} {:answer/id #uuid "bd098e59-549e-5866-8e21-9d7e91238120" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,5⟩=⟨3,2,0⟩" :db/id #edb/ref 17592186390857} {:answer/id #uuid "98de472d-01a5-57b0-ae88-2854366aa900" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,5⟩=-1" :db/id #edb/ref 17592186390858} {:answer/id #uuid "ecd5498c-0b9a-5a68-b60e-60a0077ea6de" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨-1,2,5⟩=7" :db/id #edb/ref 17592186390859} {:answer/id #uuid "ab0c9d73-79d9-533b-b84a-27c343b14c13" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨3,2,0⟩=⟨-1,2,-5⟩" :db/id #edb/ref 17592186390860}] :answer-field/correct {:answer/id #uuid "98de472d-01a5-57b0-ae88-2854366aa900" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cdot ⟨1,-2,5⟩=-1" :db/id #edb/ref 17592186390858} :answer-field/id #uuid "d0db56fe-4519-5626-a551-2a57e0daa778" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390855}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8d650e6-dfa8-594c-8c20-f63e265d1d5b" :question/math-academy-id "q-33026" :question/problem "Find an equation of the plane that contains the point  $Q(3,2,0)$ and is  perpendicular to the vector $n=⟨1,-2,5⟩.$" :question/worked-solution "First, we note that the position vector of $Q$ is $q=⟨3,2,0⟩,$ and $n=⟨1,-2,5⟩$ is normal to the plane.\n\nThe equation of the plane that passes though the point $Q({x}_{0},{y}_{0},{z}_{0})$ and is perpendicular to the vector $n$ can be given as\n\n$$\n(r-q)\\cdot n=0,\n$$\n\nwhere $r$ is the position vector of any point on the plane, and $q$ is the position vector of $Q.$\n\nSo, we have\n\n$$\n\\begin{aligned}(r-q)\\cdot n & =0 \\\\ r\\cdot n-q\\cdot n & =0 \\\\ r\\cdot n & =q\\cdot n \\\\ r\\cdot ⟨1,-2,5⟩ & =⟨3,2,0⟩\\cdot ⟨1,-2,5⟩ \\\\ r\\cdot ⟨1,-2,5⟩ & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390861 :knowledge-point/_questions [{:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449" :knowledge-point/title "Identifying the Runge-Kutta Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a69f0af6-54e7-54bd-8d32-01cf06c0f1a4" :answer/type {:db/ident :answer.type/math} :answer/value "Δx" :db/id #edb/ref 17592186390863} {:answer/id #uuid "e9096c59-4344-5a39-b335-24a1a06acaa3" :answer/type {:db/ident :answer.type/math} :answer/value "(y+Δy)" :db/id #edb/ref 17592186390864} {:answer/id #uuid "a49788aa-e789-5966-949a-c48a622d572f" :answer/type {:db/ident :answer.type/math} :answer/value "(x+Δx)" :db/id #edb/ref 17592186390865}] :answer-field/correct {:answer/id #uuid "a69f0af6-54e7-54bd-8d32-01cf06c0f1a4" :answer/type {:db/ident :answer.type/math} :answer/value "Δx" :db/id #edb/ref 17592186390863} :answer-field/id #uuid "e2d293a2-0441-5139-99ea-a6d64849c767" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390862} {:answer-field/choices [{:answer/id #uuid "e3a3aaaf-6b7a-5e7f-9e8e-9f17386a3380" :answer/type {:db/ident :answer.type/math} :answer/value "Δy" :db/id #edb/ref 17592186390867} {:answer/id #uuid "a44c9505-0713-5add-aa7f-4bf3ad407f63" :answer/type {:db/ident :answer.type/math} :answer/value "Δx" :db/id #edb/ref 17592186390868} {:answer/id #uuid "76b45f93-6510-52e1-8858-e2b5c99acc18" :answer/type {:db/ident :answer.type/math} :answer/value "y+Δy" :db/id #edb/ref 17592186390869} {:answer/id #uuid "c5fe868f-ff16-5197-9cb6-9e434ad916e0" :answer/type {:db/ident :answer.type/math} :answer/value "x+Δx" :db/id #edb/ref 17592186390870}] :answer-field/correct {:answer/id #uuid "c5fe868f-ff16-5197-9cb6-9e434ad916e0" :answer/type {:db/ident :answer.type/math} :answer/value "x+Δx" :db/id #edb/ref 17592186390870} :answer-field/id #uuid "9542b88c-885a-56ae-870e-a38f1b7619f0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390866} {:answer-field/choices [{:answer/id #uuid "fa6d0d7d-af17-513d-8e0a-2c5b0ed6531a" :answer/type {:db/ident :answer.type/math} :answer/value "Δx" :db/id #edb/ref 17592186390872} {:answer/id #uuid "590899e8-bdaf-5058-b228-c58817297235" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{1}{2}Δx" :db/id #edb/ref 17592186390873} {:answer/id #uuid "0afc6672-4832-598b-810d-706a02b44bd1" :answer/type {:db/ident :answer.type/math} :answer/value "y+\\frac{1}{2}Δy" :db/id #edb/ref 17592186390874} {:answer/id #uuid "5a219498-c662-588c-b52f-03a2203ebab2" :answer/type {:db/ident :answer.type/math} :answer/value "x+Δx" :db/id #edb/ref 17592186390875}] :answer-field/correct {:answer/id #uuid "590899e8-bdaf-5058-b228-c58817297235" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{1}{2}Δx" :db/id #edb/ref 17592186390873} :answer-field/id #uuid "f900a972-12eb-51d5-9177-0ef72e5c2e37" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390871} {:answer-field/choices [{:answer/id #uuid "cbffda29-6279-5061-97a2-8c9ad0fed97c" :answer/type {:db/ident :answer.type/math} :answer/value "Δy" :db/id #edb/ref 17592186390877} {:answer/id #uuid "5bf69b58-d193-5952-a77f-9f42dfb96288" :answer/type {:db/ident :answer.type/math} :answer/value "Δx" :db/id #edb/ref 17592186390878} {:answer/id #uuid "fe862799-827e-5fe7-9208-3373c481f68a" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186390879} {:answer/id #uuid "1c8b7a6e-90c9-5b0e-b389-9c4d66a9fa4b" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186390880}] :answer-field/correct {:answer/id #uuid "fe862799-827e-5fe7-9208-3373c481f68a" :answer/type {:db/ident :answer.type/math} :answer/value "y" :db/id #edb/ref 17592186390879} :answer-field/id #uuid "fec8f945-312f-57d4-946a-065f136e3956" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390876}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7f0fee2-a9a3-5fee-b4d9-2be1474a2a30" :question/math-academy-id "q-330277" :question/problem "Suppose we wish to solve the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nand we take a single step of size $Δx$ using the Runge-Kutta (RK4) method. Fill in the blanks to complete the weighted-average formula for the increment and the stage definitions, starting at the point $(x,y).$\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot {{field-1}} \\\\ {y}^{′} & =f(x,y) \\\\ {y}_{1}^{′} & =f({{field-2}},\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\ {y}_{2}^{′} & =f(x+\\frac{1}{2}Δx,\\,{{field-3}}+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\ {y}_{3}^{′} & =f({{field-4}},\\,y+{y}_{2}^{′}\\cdot Δx)\\end{aligned}\n$$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$"}] [{:db/id #edb/ref 17592186120231 :knowledge-point/_questions [{:knowledge-point/id #uuid "3061cb06-f57f-57c8-8821-dbd962b1e78e" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd010f61-f497-566f-ac0f-c50c695f2870" :answer/type {:db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186390882} {:answer/id #uuid "e4fe09e5-ac83-5e62-97ff-7cc91f6b67c5" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨0,6,2⟩+s⟨3,2,5⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390883} {:answer/id #uuid "5b991d71-53b1-55cf-8e90-ebe111f71f38" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390884} {:answer/id #uuid "c86fee90-6ade-5c0b-9714-4278894c742b" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨8,1,0⟩+t⟨6,-5,10⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390885} {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390886}] :answer-field/correct {:answer/id #uuid "db01346f-8d56-5827-aa82-3725170f51a2" :answer/type {:db/ident :answer.type/math} :answer/value "r=⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390886} :answer-field/id #uuid "cf886e4d-3534-5b42-92f4-88d2e9d1dbe7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0602f3f6-acc2-53ef-a72e-b71caa5d5289" :question/math-academy-id "q-33066" :question/problem "Find a parametric equation of the plane that passes through the point $A(5,-3,1)$ and is parallel to the lines $r=⟨8,1,0⟩+s⟨3,2,5⟩$ and $r=⟨6,-5,10⟩+t⟨0,6,2⟩.$" :question/worked-solution "The direction vectors of the lines are ${v}_{1}=⟨3,2,5⟩$ and ${v}_{2}=⟨0,6,2⟩$, respectively. These vectors are parallel to the plane but not to each other.\n\nWe also know that the point $A(5,-3,1)$ lies on the plane and its position vector is $a=⟨5,-3,1⟩.$  \n\nSo, the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =a+s{v}_{1}+t{v}_{2} \\\\ r & =⟨5,-3,1⟩+s⟨3,2,5⟩+t⟨0,6,2⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390887 :knowledge-point/_questions [{:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449" :knowledge-point/title "Identifying the Runge-Kutta Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9b38ddd-4150-5f03-b0ba-76495c0baa3e" :answer/type {:db/ident :answer.type/math} :answer/value "y+{y}_{2}^{′}\\cdot Δx" :db/id #edb/ref 17592186390889} {:answer/id #uuid "f58f92d7-e0aa-54d6-8333-a9d4b86db042" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }\\frac{1}{2}{y}_{2}^{′}\\cdot Δx" :db/id #edb/ref 17592186390890} {:answer/id #uuid "b4baf918-0dbb-5482-b303-5a20fe9f26ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }y+\\frac{1}{2}{y}_{2}^{′}\\cdot Δx" :db/id #edb/ref 17592186390891} {:answer/id #uuid "2587fec3-cae6-5043-9114-381aac989f55" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }{y}_{2}^{′}\\cdot Δx" :db/id #edb/ref 17592186390892}] :answer-field/correct {:answer/id #uuid "e9b38ddd-4150-5f03-b0ba-76495c0baa3e" :answer/type {:db/ident :answer.type/math} :answer/value "y+{y}_{2}^{′}\\cdot Δx" :db/id #edb/ref 17592186390889} :answer-field/id #uuid "2cb47c48-d67e-5d51-bcb1-4bdbf3b9ce28" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390888} {:answer-field/choices [{:answer/id #uuid "4b69fbf1-3507-5e38-a9db-d81a16c215b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }y+{y}^{′}\\cdot Δx" :db/id #edb/ref 17592186390894} {:answer/id #uuid "ab84e91a-dcd7-532f-b85c-8429b98e68fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }y+{y}_{1}^{′}\\cdot Δx" :db/id #edb/ref 17592186390895} {:answer/id #uuid "8ee5afc7-e801-5d88-bb03-63b32fb091ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }y+\\frac{1}{2}{y}^{′}\\cdot Δx" :db/id #edb/ref 17592186390896} {:answer/id #uuid "c8dbaceb-1f71-5507-9a13-6e6bd3c72d48" :answer/type {:db/ident :answer.type/math} :answer/value "y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx" :db/id #edb/ref 17592186390897}] :answer-field/correct {:answer/id #uuid "c8dbaceb-1f71-5507-9a13-6e6bd3c72d48" :answer/type {:db/ident :answer.type/math} :answer/value "y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx" :db/id #edb/ref 17592186390897} :answer-field/id #uuid "a6394bc9-88ab-5efd-a79a-92891110373e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390893} {:answer-field/choices [{:answer/id #uuid "b28fcd2b-b08e-58fe-9eca-cd2acae7f6f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }x+Δx" :db/id #edb/ref 17592186390899} {:answer/id #uuid "97c5e7b5-6381-5da3-81eb-b3690402bdae" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }x" :db/id #edb/ref 17592186390900} {:answer/id #uuid "2678dbd6-d358-5036-8720-e508747f5bc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{ }x+{y}^{′}\\cdot Δx" :db/id #edb/ref 17592186390901} {:answer/id #uuid "fc3475e0-6282-5e56-8f77-e3c05e200b26" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{1}{2}Δx" :db/id #edb/ref 17592186390902}] :answer-field/correct {:answer/id #uuid "fc3475e0-6282-5e56-8f77-e3c05e200b26" :answer/type {:db/ident :answer.type/math} :answer/value "x+\\frac{1}{2}Δx" :db/id #edb/ref 17592186390902} :answer-field/id #uuid "f2ad209b-5ce9-5225-b095-42a6acde311e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a86ccb7-b48d-5d3c-a367-87e75ba45fad" :question/math-academy-id "q-331162" :question/problem "Suppose we wish to solve the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nand we take a step of size $Δx$ using the Runge-Kutta (RK4) method. Fill in the blanks to complete the weighted-average formula for the increment and the stage definitions, starting at the point $(x,y).$\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\ {y}^{′} & =f(x,y) \\\\ {y}_{1}^{′} & =f({{field-1}},\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\ {y}_{2}^{′} & =f(x+\\frac{1}{2}Δx,\\,{{field-2}}) \\\\ {y}_{3}^{′} & =f(x+Δx,\\,{{field-3}})\\end{aligned}\n$$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$"}] [{:db/id #edb/ref 17592186152568 :knowledge-point/_questions [{:knowledge-point/id #uuid "6f7a33f8-b0f6-5265-9d3e-c1ca34c07161" :knowledge-point/title "Graphs of Transformed Step Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1cb84a3-549d-594a-82ff-2a06cecb2df0" :answer/type {:db/ident :answer.type/math} :answer/value "u(t)" :db/id #edb/ref 17592186149816} {:answer/id #uuid "ca5146be-d10f-5232-8c82-42df43979d39" :answer/type {:db/ident :answer.type/math} :answer/value "-2u(t)" :db/id #edb/ref 17592186149817} {:answer/id #uuid "197e0a11-e23f-518f-9db4-c9f4a7cbd614" :answer/type {:db/ident :answer.type/math} :answer/value "2u(t - 1)" :db/id #edb/ref 17592186149818} {:answer/id #uuid "2ffc47f5-1192-5d9c-ae20-15f8d828db63" :answer/type {:db/ident :answer.type/math} :answer/value "2u(t)" :db/id #edb/ref 17592186149819} {:answer/id #uuid "666b50d8-b1c9-57d0-a1be-a32919cd4de2" :answer/type {:db/ident :answer.type/math} :answer/value "2u(t) + 1" :db/id #edb/ref 17592186149820}] :answer-field/id #uuid "bc7ca6ff-c9f5-5e7a-9cae-ff55643497ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149815}] :question/id #uuid "93d8abe5-b394-5689-9e86-76b2052077e7" :question/math-academy-id "q-331249" :question/problem "![](images/bc/bcf4076849dd96858c586f8696414789b3f68074b87652601245407142f2b8fc.png)\n\nThe graph of $y = f(t)$ is shown above. Which of the following could be $f(t)$, where $u$ denotes the unit step function?"}] [{:db/id #edb/ref 17592186167201 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d219270-5202-54e6-8cba-dc816155bd7b" :knowledge-point/title "Finding Nullclines of a System of Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c443583c-7e54-5f59-9ab1-89aee41bd3fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}x" :db/id #edb/ref 17592186390904} {:answer/id #uuid "8c4372c8-4a7c-57de-bb0e-0d0c81f647d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}x" :db/id #edb/ref 17592186390905} {:answer/id #uuid "6f050c47-2efc-56c6-8db5-55a4a6a7be6c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}x" :db/id #edb/ref 17592186390906} {:answer/id #uuid "0af23e83-bdec-5481-933e-04324f2a459b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}x" :db/id #edb/ref 17592186390907}] :answer-field/correct {:answer/id #uuid "8c4372c8-4a7c-57de-bb0e-0d0c81f647d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}x" :db/id #edb/ref 17592186390905} :answer-field/id #uuid "db6adcc9-e832-5c5c-a3b9-b8a6c52643f8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390903} {:answer-field/choices [{:answer/id #uuid "17b432c2-0e0d-5009-8470-4e3571054d88" :answer/type {:db/ident :answer.type/math} :answer/value "-3x" :db/id #edb/ref 17592186390909} {:answer/id #uuid "a2d6625e-4e34-5b96-9274-5a9d7dfd284f" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186390910} {:answer/id #uuid "18035581-6355-53bd-aaff-403fe9c0130e" :answer/type {:db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186390911} {:answer/id #uuid "bb02896b-984a-534e-9478-eb60968c1e47" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186390912}] :answer-field/correct {:answer/id #uuid "a2d6625e-4e34-5b96-9274-5a9d7dfd284f" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186390910} :answer-field/id #uuid "cc3c9fa7-0d6e-5df1-9ab3-f0035bf250e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390908}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c96b74a-d34e-5ce3-b63d-86dac5a4ffc7" :question/math-academy-id "q-331282" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t)-2y(t) \\\\ {y}^{′}(t)=2x(t)+3y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." :question/worked-solution "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n2x-2y=0\\,⇒\\,y=x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n2x+3y=0\\,⇒\\,y=-\\frac{2}{3}x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](images/6b/6ba5066fd4ddc43491c3d007355e0b64c84d449d6462812aa4c8ca0450887a8b.png)"}] [{:db/id #edb/ref 17592186390913 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ff1822c-afad-54f8-aa36-7e0de79d9d04" :knowledge-point/title "Finding the Unit Tangent Vector at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e6eed83-83ce-545e-bdb5-d5c028a8d37d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186390915} {:answer/id #uuid "0569c095-e03a-53ae-8b2c-2a081af44aea" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{\\sqrt{3}}{3},\\,\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186390916} {:answer/id #uuid "d8c54676-3491-5208-a1db-82bc598123c2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186390917} {:answer/id #uuid "4d852899-6223-5333-a301-6f9971200048" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3},\\,\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186390918} {:answer/id #uuid "daef89c6-3cb1-55f9-8684-52f37c7bc5be" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{\\sqrt{3}}{3},\\,\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186390919}] :answer-field/correct {:answer/id #uuid "7e6eed83-83ce-545e-bdb5-d5c028a8d37d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3}⟩" :db/id #edb/ref 17592186390915} :answer-field/id #uuid "2420d840-3b85-5ad8-9b12-4c80cfd6bb59" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390914}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "927bdcac-2749-5a1c-8331-70b709fa149b" :question/math-academy-id "q-33132" :question/problem "Find the unit tangent vector to the curve $r(t)=⟨{e}^{-t}\\operatorname{sin}⁡t,\\,{e}^{-t}\\operatorname{cos}⁡t,\\,{e}^{-t}⟩$ at the point where $t=0.$" :question/worked-solution "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=0:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t})⟩ \\\\  & =⟨-{e}^{-t}\\operatorname{sin}⁡t+{e}^{-t}\\operatorname{cos}⁡t,\\,-{e}^{-t}\\operatorname{cos}⁡t-{e}^{-t}\\operatorname{sin}⁡t,\\,-{e}^{-t}⟩ \\\\ {r}^{′}(0) & =⟨-{e}^{-(0)}\\operatorname{sin}⁡(0)+{e}^{-(0)}\\operatorname{cos}⁡(0),\\,-{e}^{-(0)}\\operatorname{cos}⁡(0)-{e}^{-(0)}\\operatorname{sin}⁡(0),\\,-{e}^{-(0)}⟩ \\\\  & =⟨-0+1,\\,-1-0,\\,-1⟩ \\\\  & =⟨1,\\,-1,\\,-1⟩\\end{aligned}\n$$\n\n \n\nNow, we calculate the magnitude of ${r}^{′}(0):$\n\n$$\n\\begin{aligned}‖{r}^{′}(0)‖ & =\\sqrt{(1)^{2}+(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{3}\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(0)$ and obtain the unit tangent vector to the given curve at the point where $t=0:$\n\n$$\n\\begin{aligned}T(0) & =\\frac{{r}^{′}(0)}{‖{r}^{′}(0)‖} \\\\  & =\\frac{1}{\\sqrt{3}}⟨1,\\,-1,\\,-1⟩ \\\\  & =⟨\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3},\\,-\\frac{\\sqrt{3}}{3}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167203 :knowledge-point/_questions [{:knowledge-point/id #uuid "d5802583-df2c-5f08-bf9f-8b36247e34d4" :knowledge-point/title "Identifying the Phase Portrait of a System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d406422-7551-5f9b-a314-50e44b62ba94" :answer/type {:db/ident :answer.type/image} :answer/value "images/05/05717229526b02cb74f1b1e7fbdd78fc84b0079057c9548699231583f32ac2ec.png" :db/id #edb/ref 17592186390921} {:answer/id #uuid "c8436be9-d3bc-551a-b71a-e3fcbdea10a1" :answer/type {:db/ident :answer.type/image} :answer/value "images/09/0948dac4f8a192018baee1339d7334d573592d7b7bf4383c1297cc2431e51201.png" :db/id #edb/ref 17592186390922} {:answer/id #uuid "82c9cdb3-c78c-5ec3-bedd-9b5c11a2df9a" :answer/type {:db/ident :answer.type/image} :answer/value "images/eb/eba955015a4b919c65dc24facb0baa6e745df134feac32feeae07c99d40ff4ec.png" :db/id #edb/ref 17592186390923} {:answer/id #uuid "84b66dc9-e7b8-5096-9903-98c87f69b2a6" :answer/type {:db/ident :answer.type/image} :answer/value "images/87/8715fffa8fec9468edef2194b75842cb79de3bc9a7db6c0d8d23f44c6eb5368b.png" :db/id #edb/ref 17592186390924} {:answer/id #uuid "02ebaa7b-8ee4-51b9-8b35-580dee270bc1" :answer/type {:db/ident :answer.type/image} :answer/value "images/7e/7e48266d30ae7c204b25e6eddca968d1b4ce9cd8e1c7b19cd20247fa66070f0b.png" :db/id #edb/ref 17592186390925}] :answer-field/correct {:answer/id #uuid "82c9cdb3-c78c-5ec3-bedd-9b5c11a2df9a" :answer/type {:db/ident :answer.type/image} :answer/value "images/eb/eba955015a4b919c65dc24facb0baa6e745df134feac32feeae07c99d40ff4ec.png" :db/id #edb/ref 17592186390923} :answer-field/id #uuid "bf541324-f9fa-59ef-b87f-525e5b194586" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e5bc024-e1c3-5b73-b155-51e51d92843a" :question/math-academy-id "q-331400" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=3y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?" :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=2$ with the corresponding eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- Eigenvalue ${\\lambda }_{2}=3$ with the corresponding eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nThe general solution of the system is\n\n$$\nx(t)={c}_{1}{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}{e}^{3t}[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nNow, notice that:\n\n- The straight-line solutions of the form\n${c}_{1}{e}^{2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis. Since ${e}^{2t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\n- The straight-line solutions of the form\n${c}_{2}{e}^{3t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis. Since ${e}^{3t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach infinity as $t\\to \\infty .$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](images/eb/eba955015a4b919c65dc24facb0baa6e745df134feac32feeae07c99d40ff4ec.png)"}] [{:db/id #edb/ref 17592186390926 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd" :knowledge-point/title "Proving the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aafd302f-6a35-5d36-98f2-cf4624e295be" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{4t}y(t)" :db/id #edb/ref 17592186390928} {:answer/id #uuid "66bf87d7-e6c2-5282-850d-eb9aebd5c3b6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{4t}y(t)" :db/id #edb/ref 17592186390929} {:answer/id #uuid "840ad45b-0f89-5529-9777-ad485cc3f205" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{-4t}y(t)" :db/id #edb/ref 17592186390930} {:answer/id #uuid "6c39a5b1-75b5-5645-8167-41e89b9c7ea3" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-4t}y(t)" :db/id #edb/ref 17592186390931}] :answer-field/correct {:answer/id #uuid "66bf87d7-e6c2-5282-850d-eb9aebd5c3b6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{4t}y(t)" :db/id #edb/ref 17592186390929} :answer-field/id #uuid "8c96bb67-379b-58f3-8bd6-2a12ba02c55d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390927} {:answer-field/choices [{:answer/id #uuid "79a696e3-36c6-5dbb-8054-3e3055fd30c5" :answer/type {:db/ident :answer.type/math} :answer/value "Y(s+4)" :db/id #edb/ref 17592186390933} {:answer/id #uuid "4467ec07-702f-5b21-92b8-2f18a52b2594" :answer/type {:db/ident :answer.type/math} :answer/value "Y(s)" :db/id #edb/ref 17592186390934} {:answer/id #uuid "16ae78ce-84c8-5d90-adf4-b4488bc9bc1c" :answer/type {:db/ident :answer.type/math} :answer/value "Y(s-4)" :db/id #edb/ref 17592186390935}] :answer-field/correct {:answer/id #uuid "16ae78ce-84c8-5d90-adf4-b4488bc9bc1c" :answer/type {:db/ident :answer.type/math} :answer/value "Y(s-4)" :db/id #edb/ref 17592186390935} :answer-field/id #uuid "8a4081f2-e006-5adb-9730-18555c18e386" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390932} {:answer-field/choices [{:answer/id #uuid "1b0aa3b2-a353-5fad-9f2c-86f80f64a596" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}-4" :db/id #edb/ref 17592186390937} {:answer/id #uuid "70ea0f4e-0f27-54bd-b214-293164546b85" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}" :db/id #edb/ref 17592186390938} {:answer/id #uuid "efc8c087-1a40-5a9a-b0e7-6e9a0cfd6c03" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}+4" :db/id #edb/ref 17592186390939}] :answer-field/correct {:answer/id #uuid "efc8c087-1a40-5a9a-b0e7-6e9a0cfd6c03" :answer/type {:db/ident :answer.type/math} :answer/value "s>{s}_{0}+4" :db/id #edb/ref 17592186390939} :answer-field/id #uuid "3edea668-8171-5b4a-ac6b-95fcbb4e0bc6" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390936} {:answer-field/choices [{:answer/id #uuid "518c7bd4-e0da-52d8-997d-673ca75771ef" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s+4)t}" :db/id #edb/ref 17592186390941} {:answer/id #uuid "2ff97a43-f336-5953-ad0f-7734328a6b47" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-4)t}" :db/id #edb/ref 17592186390942} {:answer/id #uuid "16f58656-d9ad-55d9-bfbd-701b206d4ef9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{(s-4)t}" :db/id #edb/ref 17592186390943} {:answer/id #uuid "91cc341f-4e42-5a66-9854-8c99a495219a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s+4)t}" :db/id #edb/ref 17592186390944}] :answer-field/correct {:answer/id #uuid "2ff97a43-f336-5953-ad0f-7734328a6b47" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-4)t}" :db/id #edb/ref 17592186390942} :answer-field/id #uuid "89e9f6b0-7444-50e6-83bb-1ea02dd6ef57" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390940}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65e33f37-ed72-5eab-bd4d-b7d3ad4f22b8" :question/math-academy-id "q-331791" :question/problem "Consider a function $y(t)$ such that its Laplace transform is $L{y(t)}=Y(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{4t}y(t)}.$ Select the correct options in the reasoning below.By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{4t}y(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,y(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{4t}y(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{4t}\\,y(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-4)t}\\,y(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $Y(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,y(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-4)t}\\,y(t)\\,\\text{d}t=Y(s-4),\n$$\n\nwhere \n\n$$\ns-4>{s}_{0}\\,⇒\\,s>{s}_{0}+4.\n$$"}] [{:db/id #edb/ref 17592186390945 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd7b8fc8-26d3-5551-9a46-45725bd863a6" :knowledge-point/title "Applying the Laplace Transform to a System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2949629-e073-5313-a633-f67654199c97" :answer/type {:db/ident :answer.type/math} :answer/value "-4{X}_{1}(s)-5{X}_{2}(s)" :db/id #edb/ref 17592186390947} {:answer/id #uuid "cc1091c8-d03a-5294-81ac-d27b584d6f60" :answer/type {:db/ident :answer.type/math} :answer/value "4{X}_{1}(s)+5{X}_{2}(s)" :db/id #edb/ref 17592186390948} {:answer/id #uuid "c2992896-e2ed-5d39-bebd-25e37953e4a9" :answer/type {:db/ident :answer.type/math} :answer/value "4{X}_{1}(s)-5{X}_{2}(s)" :db/id #edb/ref 17592186390949} {:answer/id #uuid "5e2bf06e-6d4d-5c40-838b-cdd5f26b132c" :answer/type {:db/ident :answer.type/math} :answer/value "-4{X}_{1}(s)+5{X}_{2}(s)" :db/id #edb/ref 17592186390950}] :answer-field/correct {:answer/id #uuid "e2949629-e073-5313-a633-f67654199c97" :answer/type {:db/ident :answer.type/math} :answer/value "-4{X}_{1}(s)-5{X}_{2}(s)" :db/id #edb/ref 17592186390947} :answer-field/id #uuid "d18f6107-e4a7-511f-aa2a-ba86c261bcc9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186390946} {:answer-field/choices [{:answer/id #uuid "198deb78-1731-5017-805a-04c6e0d8f235" :answer/type {:db/ident :answer.type/math} :answer/value "s{X}_{1}(s)+1" :db/id #edb/ref 17592186390952} {:answer/id #uuid "429786f3-46f0-5c6f-8189-94b622b72485" :answer/type {:db/ident :answer.type/math} :answer/value "{X}_{1}(s)-1" :db/id #edb/ref 17592186390953} {:answer/id #uuid "4f00e024-b01e-563a-bd70-b56b2a540932" :answer/type {:db/ident :answer.type/math} :answer/value "s{X}_{1}(s)-1" :db/id #edb/ref 17592186390954} {:answer/id #uuid "a211c326-2d4b-59b1-9b38-e99dc7b