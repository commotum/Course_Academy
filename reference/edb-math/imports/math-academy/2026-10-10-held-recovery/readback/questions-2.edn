oint/id #uuid "00a8fb88-4b07-57be-94c5-a6b499c9df5b" :knowledge-point/title "Graphing the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e789a15-0f6c-5c6c-88ae-c3ebce2478cd" :answer/type {:db/ident :answer.type/image} :answer/value "images/7f/7f3982453612117ab6837967905b341040d3ecdda60733b259e749aa2ab28a75.png" :db/id #edb/ref 17592186386863} {:answer/id #uuid "1e395ea6-d157-54a7-8c92-fbc0a15c7181" :answer/type {:db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186386864} {:answer/id #uuid "2c6be4be-71f2-5a3e-9a40-6589e5a70583" :answer/type {:db/ident :answer.type/image} :answer/value "images/4e/4edede1c41fed040afa30a608b70d1631101020172593b57611d3a38e457cfe2.png" :db/id #edb/ref 17592186386865} {:answer/id #uuid "9c5c303b-5da6-56d6-9a0e-3817ff000f74" :answer/type {:db/ident :answer.type/image} :answer/value "images/b2/b24637d9e613b6f9649658c620406a687faac19153bd37b671a078e9530ee1bd.png" :db/id #edb/ref 17592186386866} {:answer/id #uuid "39d3b40a-6f53-5ea6-a900-eb0b5df73621" :answer/type {:db/ident :answer.type/image} :answer/value "images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png" :db/id #edb/ref 17592186386867}] :answer-field/correct {:answer/id #uuid "39d3b40a-6f53-5ea6-a900-eb0b5df73621" :answer/type {:db/ident :answer.type/image} :answer/value "images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png" :db/id #edb/ref 17592186386867} :answer-field/id #uuid "7d0d9645-b4ee-51dd-bd9f-a79061fa442c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386862}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09fe6ea5-caba-5eab-b3bb-4b7e28bffdb4" :question/math-academy-id "q-117141" :question/problem "What is the graph of $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arccos}⁡x:$\n\n- The domain of the function is $x\\in [-1,1].$\n\n- The range of the function is $y\\in [0,\\pi ].$\n\n- Its minimum value occurs at $x=1.$\n\n- Its maximum value occurs at $x=-1.$\n\n- Its $y$-intercept is $y=\\frac{\\pi }{2}.$\n\n- The function is strictly decreasing on its entire domain.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/9d/9dcc5a116c2a564547283783a7df7b1cd3a9ab3b76ac24dc2695c4cb367796d5.png)"}] [{:db/id #edb/ref 17592186386868 :knowledge-point/_questions [{:knowledge-point/id #uuid "46e1513d-0944-5c09-8a7e-e1d9ae81bae5" :knowledge-point/title "Graphing the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186386870} {:answer/id #uuid "f1e55806-d3c8-548e-80c6-b1e30766315a" :answer/type {:db/ident :answer.type/image} :answer/value "images/39/395d29ade9c150fc9f6eb4674bfb650004c3379524c321851cc4d2dd32bf7bc1.png" :db/id #edb/ref 17592186386871} {:answer/id #uuid "6e736289-c884-532d-8c00-be2ea9bbb9f9" :answer/type {:db/ident :answer.type/image} :answer/value "images/03/0328f3c8c1866f2103857cd9769a01a0d5cd7ec24b7a3585a394f6e9590dd107.png" :db/id #edb/ref 17592186386872} {:answer/id #uuid "2f8a703e-82ef-5233-a9c5-a0fdd0b287fd" :answer/type {:db/ident :answer.type/image} :answer/value "images/f8/f850e9468f4ea2e02625ff0d729a9222e8744e5b5fc8e38621b9465255bb2266.png" :db/id #edb/ref 17592186386873} {:answer/id #uuid "bed70265-c376-5aeb-8052-6193b067a494" :answer/type {:db/ident :answer.type/image} :answer/value "images/4b/4bef0bf8fd764126db5583ac90ea96fb02db567f2f75c4fa787440ab94adf901.png" :db/id #edb/ref 17592186386874}] :answer-field/correct {:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186386870} :answer-field/id #uuid "70ec79cf-e993-5024-9997-bd354c43672a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "869b4f2f-e699-55cc-9df6-f84ca27a773c" :question/math-academy-id "q-117265" :question/problem "What is the graph of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arctan}⁡x:$\n\n- The domain is all real numbers.\n\n- There is a zero at $x=0.$\n\n- The function is negative over $(-\\infty ,0)$ and positive over $(0,\\infty ).$\n\n- The function is strictly increasing in its entire domain.\n\n- $y\\to -\\frac{\\pi }{2}$ (from above) as $x\\to -\\infty .$\n\n- $y\\to \\frac{\\pi }{2}$ (from below) as $x\\to \\infty .$\n\n- The lines $y=\\pm \\frac{\\pi }{2}$ are horizontal asymptotes of the function.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)"}] [{:db/id #edb/ref 17592186386875 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7656d23-06c9-5d22-b62a-3636bca66ab6" :knowledge-point/title "Finding the Base or the Height of a Triangle Given Its Area"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85c1f01f-96af-5f7c-96aa-279c3ec7396b" :answer/type {:db/ident :answer.type/math} :answer/value "11\\,\\text{m}" :db/id #edb/ref 17592186386877} {:answer/id #uuid "2997f072-b449-5713-9807-6a5f2600c14b" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{m}" :db/id #edb/ref 17592186386878} {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386879} {:answer/id #uuid "1fee1997-ce6c-5947-a48e-604fe553cb79" :answer/type {:db/ident :answer.type/math} :answer/value "7\\,\\text{m}" :db/id #edb/ref 17592186386880} {:answer/id #uuid "f0514960-ea4a-54b8-90e9-aaff6e94282c" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,\\text{m}" :db/id #edb/ref 17592186386881}] :answer-field/correct {:answer/id #uuid "8fb6c5c4-f4a0-508f-836c-123e77528fc9" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{m}" :db/id #edb/ref 17592186386879} :answer-field/id #uuid "a7d95cca-e9e0-5148-9e42-b90b4a803ca8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386876}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4303d1bd-0440-58eb-a5d5-e6551f7a6e46" :question/math-academy-id "q-117356" :question/problem "![](images/10/10b6f63df56c789d0d28cd14caad0a2588e247ba4a60239f4cb0dd5a32777daf.png)\n\nFind $AM$ given that the area of $△ABC$ is $64\\,{m}^{2},$ $MC=11\\,m,$ and $BM=8\\,m.$}\n\n(Figure not drawn to scale)" :question/worked-solution "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is a base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the base is $b=AC,$ and the corresponding height is \n\n$$\nh=BM=8\\,m.\n$$\n\nTherefore, using the formula for the area, we can solve for the base as follows:\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\ 64 & =\\frac{b\\cdot 8}{2} \\\\ 128 & =b\\cdot 8 \\\\ b & =\\frac{128}{8} \\\\ b & =16\\,m\\end{aligned}\n$$\n\nAs a result, $AC=16\\,m$ and hence, we have\n\n$$\nAM=AC-MC=16-11=5\\,\\text{m}.\n$$"}] [{:db/id #edb/ref 17592186097019 :knowledge-point/_questions [{:knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86993d2d-50bf-5dff-9967-dc3897b186ac" :answer/type {:db/ident :answer.type/math} :answer/value "(8,6)" :db/id #edb/ref 17592186386883} {:answer/id #uuid "847a514e-ed4d-5ab9-9b42-da968819ca5b" :answer/type {:db/ident :answer.type/math} :answer/value "(6,6)" :db/id #edb/ref 17592186386884} {:answer/id #uuid "71a2b3ad-6b2a-5de5-b052-f25d736480f0" :answer/type {:db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186386885} {:answer/id #uuid "f8a63424-7ca7-5ab9-b588-f4b8e06f836e" :answer/type {:db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186386886} {:answer/id #uuid "3f20f38a-98c7-5e51-86e9-1958a8ecab18" :answer/type {:db/ident :answer.type/math} :answer/value "(6,8)" :db/id #edb/ref 17592186386887}] :answer-field/correct {:answer/id #uuid "f8a63424-7ca7-5ab9-b588-f4b8e06f836e" :answer/type {:db/ident :answer.type/math} :answer/value "(6,4)" :db/id #edb/ref 17592186386886} :answer-field/id #uuid "15bf4a4d-fe97-5b21-94a9-19c7806ee1e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386882}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "781d9979-bbb4-5c2f-b5a4-4d9ed9d2fd48" :question/math-academy-id "q-11856" :question/problem "![](images/91/91d23b43c3d6ddd08b90efd5d3576ec509b5e0dd4a8e5c1745b21ec2119aad77.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a left-opening parabola is the right-most point of the parabola.\n\n![](images/94/94d33dcb92ddb84479c1ea7b01d5619268a10786a19f318fba61f3107ba9b551.png)\n\nTherefore, the coordinates of the vertex are $(6,4).$"}] [{:db/id #edb/ref 17592186386888 :knowledge-point/_questions [{:knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :questi