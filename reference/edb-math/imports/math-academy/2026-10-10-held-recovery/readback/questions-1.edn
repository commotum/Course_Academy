mages/65/65e24bd4cadacd7510d9dc529d13d02a40445abba54129a7f5801c75dd0e2da9.png" :db/id #edb/ref 17592186386677} {:answer/id #uuid "46d1074a-2a76-523e-ac49-c7030b1d984d" :answer/type {:db/ident :answer.type/image} :answer/value "images/6c/6c4c728e59e416a589b85318988a3a87e2a3c9445b669c4091301b21254c87fa.png" :db/id #edb/ref 17592186386678} {:answer/id #uuid "50a3028f-ed6c-5718-a36a-947dbee62ad0" :answer/type {:db/ident :answer.type/image} :answer/value "images/46/4612933db2d25ce80b7e7258d3e381fd03f951246b515c3c34c69b71c537c7fc.png" :db/id #edb/ref 17592186386679} {:answer/id #uuid "71df20dc-d7fc-5b41-be17-a6983196a882" :answer/type {:db/ident :answer.type/image} :answer/value "images/d1/d14d6a75f24afea6dfe31aed9dc752b470c6d672b6a3c0f97820738b6140e629.png" :db/id #edb/ref 17592186386680}] :answer-field/correct {:answer/id #uuid "92c55780-5247-5ab6-a621-d40a0527133d" :answer/type {:db/ident :answer.type/image} :answer/value "images/ed/edb61b0239e926ae983d0cb67ffb05c7ff0b452564e6972dfa15cf0f2472a727.png" :db/id #edb/ref 17592186386676} :answer-field/id #uuid "e6b93c17-1338-56db-a802-9f519be35fc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d34b2496-a69c-5cea-b687-ebc80f8f584a" :question/math-academy-id "q-113369" :question/problem "Which of the following is the graph of $y=-\\frac{5}{x}+2?$" :question/worked-solution "To plot $y=-\\frac{5}{x}+1,$ we apply the following steps:\n\n- Take the curve $y=-\\frac{1}{x}.$\n\n![](images/9d/9da0db2e6c97e507e82b7ca801e46802fabf91ad31ff53ad3cc9ae580151370a.png)\n\n- Then, stretch the result by a scale factor of $5$ parallel to the $y$-axis to get the graph of $y=-\\frac{5}{x}.$\n\n![](images/46/4612933db2d25ce80b7e7258d3e381fd03f951246b515c3c34c69b71c537c7fc.png)\n\n- Translate it by $2$ unit up to get the graph of $y=-\\frac{5}{x}+2.$\n\n![](images/ed/edb61b0239e926ae983d0cb67ffb05c7ff0b452564e6972dfa15cf0f2472a727.png)"}] [{:db/id #edb/ref 17592186386681 :knowledge-point/_questions [{:knowledge-point/id #uuid "23b6a85e-e1de-590c-84d2-379052b1b9f3" :knowledge-point/title "Using the Invertibility Property of the Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "919eb1e9-2f4b-56b6-88e5-3859874737bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -2 \\\\ 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186386683} {:answer/id #uuid "90eeb8b6-e3b5-53db-a5fe-f9746d4ccb88" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -3 \\\\ 4 & 2\\end{aligned}]" :db/id #edb/ref 17592186386684} {:answer/id #uuid "b872cd7b-0659-5c54-8111-e27c28adc0d3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & -2 \\\\ 2 & 3\\end{aligned}]" :db/id #edb/ref 17592186386685} {:answer/id #uuid "bbdc24c8-890c-5fc5-a78e-92d48b19a269" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 & -3 \\\\ 2 & 2\\end{aligned}]" :db/id #edb/ref 17592186386686} {:answer/id #uuid "e9bec6ef-0b83-555d-8bfe-9ff77d315986" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 2 \\\\ 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186386687}] :answer-field/correct {:answer/id #uuid "919eb1e9-2f4b-56b6-88e5-3859874737bb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -2 \\\\ 4 & 3\\end{aligned}]" :db/id #edb/ref 17592186386683} :answer-field/id #uuid "9f7670fd-c5bc-51f7-98ba-bd3ac9cdc072" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e492abb-150e-5b29-ab40-6db339f73d6b" :question/math-academy-id "q-113415" :question/problem "The change-of-coordinates matrix from the basis $B$ to the basis $C$ is given by \n${P}_{B\\to C}=[\\begin{aligned}\\frac{3}{2} & 1 \\\\ -2 & -1\\end{aligned}].$\nFind the change-of-coordinates matrix from $C$ to $B$  ." :question/worked-solution "The change-of-coordinates matrix from $C$ to $B$ is the inverse of the change-of-coordinates matrix from $B$ to $C.$ Therefore, we simply need to find the inverse of the given matrix.\n\nComputing the inverse of ${P}_{B\\to C}$, we get\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}\\frac{3}{2} & 1 \\\\ -2 & -1\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{\\frac{3}{2}\\cdot (-1)-1\\cdot (-2)}[\\begin{aligned}-1 & -1 \\\\ 2 & \\frac{3}{2}\\end{aligned}] \\\\  & =2\\cdot [\\begin{aligned}-1 & -1 \\\\ 2 & \\frac{3}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -2 \\\\ 4 & 3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386688 :knowledge-point/_questions [{:knowledge-point/id #uuid "4640f978-9caa-5960-bec4-f153a1b4cc5d" :knowledge-point/title "Graphing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc22b6a-72c5-57b6-baee-4019cb290f42" :answer/type {:db/ident :answer.type/image} :answer/value "images/47/47a63204ef63a80905e5e6d2df5635a02d06694153cb67bc15eededf63c87b90.png" :db/id #edb/ref 17592186386690} {:answer/id #uuid "765955f5-0542-50bc-9667-86b09f0b4e4d" :answer/type {:db/ident :answer.type/image} :answer/value "images/3a/3a8f77e96f836eadfdb1a0c73f35bad5e245b66df0f21daec6ac008fb69a4815.png" :db/id #edb/ref 17592186386691} {:answer/id #uuid "f85feca0-357a-5c74-8fde-4d7fdaa2cd0b" :answer/type {:db/ident :answer.type/image} :answer/value "images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png" :db/id #edb/ref 17592186386692} {:answer/id #uuid "dba9cafa-0a6c-53c7-80a2-61fb5e35090a" :answer/type {:db/ident :answer.type/image} :answer/value "images/8f/8f2a42430ac31a559e5f85c961579aa482280bd9b69ed5d948250f5fafce21a5.png" :db/id #edb/ref 17592186386693} {:answer/id #uuid "b0a9dbae-7498-55b8-b00b-07a41ab70457" :answer/type {:db/ident :answer.type/image} :answer/value "images/0b/0bb082b243d961b45b63d352f84359d7022492df93e781f93114206e9924b5c2.png" :db/id #edb/ref 17592186386694}] :answer-field/correct {:answer/id #uuid "f85feca0-357a-5c74-8fde-4d7fdaa2cd0b" :answer/type {:db/ident :answer.type/image} :answer/value "images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png" :db/id #edb/ref 17592186386692} :answer-field/id #uuid "1a9d5ff1-d590-522a-bcb5-31d743a32102" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386689}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "110d0b81-fd68-5dac-ba01-18cdf7c4cb65" :question/math-academy-id "q-113463" :question/problem "Which of the following is the graph of $y=\\frac{3}{4(x-1)}?$" :question/worked-solution "To plot $y=\\frac{3}{4(x-1)},$ we apply the following steps:\n\n- Take the curve $y=\\frac{1}{x}.$\n\n![](images/e8/e80865b0f32a5473da27b39537034bcdabee0a6c24032f41413e20518642d3f4.png)\n\n- Translate it by $1$ unit to the right to get the graph of $y=\\frac{1}{x-1}.$\n\n![](images/8f/8f2a42430ac31a559e5f85c961579aa482280bd9b69ed5d948250f5fafce21a5.png)\n\n- Then, stretch the result by a scale factor of $\\frac{3}{4}$ parallel to the $y$-axis to get the graph of $y=\\frac{3}{4(x-1)}.$\n\n![](images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png)"}] [{:db/id #edb/ref 17592186386695 :knowledge-point/_questions [{:knowledge-point/id #uuid "f989cbaf-2d99-5267-8864-48a48db2d535" :knowledge-point/title "Finding the Change-of-Coordinates Matrix Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8825f14c-9a42-524d-9c28-29837aebedb6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ -1 & -\\frac{1}{2}\\end{aligned}]" :db/id #edb/ref 17592186386697} {:answer/id #uuid "98835778-342b-5c02-8d88-888de609e677" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186386698} {:answer/id #uuid "d94196f9-3ecd-5be0-83e8-bcc999375295" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 1 \\\\ \\frac{1}{2} & -1\\end{aligned}]" :db/id #edb/ref 17592186386699} {:answer/id #uuid "a5ee547c-4202-5153-9e7d-5620efcc2bf7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186386700} {:answer/id #uuid "fd9a6ec6-14f6-58f7-bc3c-2ea967387600" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186386701}] :answer-field/correct {:answer/id #uuid "98835778-342b-5c02-8d88-888de609e677" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}]" :db/id #edb/ref 17592186386698} :answer-field/id #uuid "24689871-0c4d-593c-87fd-274e73d396ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4593a4d9-b03b-5c1f-ad85-95d87fe0ce9e" :question/math-academy-id "q-113513" :question/problem "Let $B={[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}1 \\\\ 1\\end{aligned}]}$  be a basis of ${R}^{2}$ and $S$ is the standard basis of ${R}^{2}.$ Find the change-of-coordinates matrix from $S$ to $B.$" :question/worked-solution "Let's denote the vectors of $B$ and $S$ as ${{b}_{1},{b}_{2}}$ and ${{e}_{1},{e}_{2}}$, respectively. Recall that the standard basis of ${R}^{2}$ consists of the vectors\n\n$$\n{e}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{e}_{2}=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\nThe change-of-coordinates matrix from $S$ to $B$ is a matrix whose columns are the coordinates of the vectors of $S$ relative to the basis $B.$\n\nHence, we need to find the coordinates of ${e}_{1}$ and ${e}_{2}$ relative to the basis $B.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & {e}_{1} & {e}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination: \n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 2 & 1 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & -1 & -2 & 1\\end{aligned}] & {R}_{2} & :=(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 1 & 0 \\\\ 0 & 1 & 2 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -1 & 1 \\\\ 0 & 1 & 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nOn the right-hand side, we obtain the change-of-coordinates matrix from $S$ to $B.$ Therefore, we have\n\n$$\n{P}_{S\\to B}=[\\begin{aligned}-1 & 1 \\\\ 2 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186386702 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ee52fd3-6c79-5016-ade5-46e7bfbb557a" :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given the Inverse Change-of-Coordinates Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef569771-c4e7-5291-a02a-eccb98516f64" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186386704} {:answer/id #uuid "19f40148-c027-5e57-83ca-f9ce5e2e487f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 13\\end{aligned}]" :db/id #edb/ref 17592186386705} {:answer/id #uuid "f2dbac90-d79d-5e74-a3e8-3e28846fd99d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386706} {:answer/id #uuid "8aadec7c-66e6-5275-836d-0b2d825fbd7b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}28 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186386707} {:answer/id #uuid "54154bb7-e3f6-55f0-b690-aed92908791b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 \\\\ 26\\end{aligned}]" :db/id #edb/ref 17592186386708}] :answer-field/correct {:answer/id #uuid "8aadec7c-66e6-5275-836d-0b2d825fbd7b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}28 \\\\ 18\\end{aligned}]" :db/id #edb/ref 17592186386707} :answer-field/id #uuid "30675a92-d5d0-5d0c-a77d-9c525c8b8db4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386703}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ed39867-0f3e-5f3d-ab65-536828c9ba67" :question/math-academy-id "q-113573" :question/problem "The change-of-coordinates matrix from $B={{b}_{1},{b}_{2}}$ to $C={{c}_{1},{c}_{2}}$ is given below. Find $[x]_{B}$ given that $x=2{c}_{1}-4{c}_{2}.$\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}2 & -3 \\\\ 5 & -8\\end{aligned}]\n$$" :question/worked-solution "We will use the change-of-coordinates formula in the form\n\n$$\n[\\,x\\,]_{B}={P}_{C\\to B}[\\,x\\,]_{C}.\n$$\n\nFirst, we need to find the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B.$ To do that, we compute the inverse of ${P}_{B\\to C}:$\n\n$$\n\\begin{aligned}{P}_{C\\to B} & ={P}_{B\\to C}^{-1} \\\\  & ={[\\begin{aligned}2 & -3 \\\\ 5 & -8\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot (-8)-(-3)\\cdot 5}[\\begin{aligned}-8 & 3 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & -3 \\\\ 5 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNotice that since $x=2{c}_{1}-4{c}_{2},$ we obtain\n\n$$\n[x]_{C}=[\\begin{aligned}2 \\\\ -4\\end{aligned}].\n$$\n\nNow, we compute $[\\,x\\,]_{B}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{B} & ={P}_{C\\to B}[\\,x\\,]_{C} \\\\  & =[\\begin{aligned}8 & -3 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}28 \\\\ 18\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386709 :knowledge-point/_questions [{:knowledge-point/id #uuid "36f8f02f-acbd-5930-bd0c-8675ac868577" :knowledge-point/title "Finding the Coordinates of a Vector in a New Basis Given Its Coordinates in Another Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b21ecb7-ce65-5e1c-88f8-49cf0f4f160b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386711} {:answer/id #uuid "897bfaa9-9628-5f28-badb-b747acdbdf1c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186386712} {:answer/id #uuid "8ede5e11-d7f3-54ac-841f-ae72ee3947e7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186386713} {:answer/id #uuid "69e58d8b-d9e1-5eda-86bf-6ecbe390e01f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186386714} {:answer/id #uuid "40be1f67-db2c-5689-b51a-1a8b001bcac8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386715}] :answer-field/correct {:answer/id #uuid "2b21ecb7-ce65-5e1c-88f8-49cf0f4f160b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186386711} :answer-field/id #uuid "99d4ef7c-c89c-5840-b177-510543ba8c00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386710}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "858d9af2-f7a3-5372-8435-4e3c1f733534" :question/math-academy-id "q-113708" :question/problem "$$\nB={[\\begin{aligned}2 \\\\ 3\\end{aligned}],[\\begin{aligned}1 \\\\ 1\\end{aligned}]},\\,C={[\\begin{aligned}1 \\\\ 2\\end{aligned}],[\\begin{aligned}2 \\\\ 5\\end{aligned}]},\\,[x]_{B}=[\\begin{aligned}5 \\\\ -7\\end{aligned}].\n$$\n\n \n\nThe bases $B$ and $C$ of ${R}^{2}$ and the coordinates of the vector $x$ relative to the basis $B$ are given above. Find $[x]_{C}.$" :question/worked-solution "Let's denote the vectors of $B$ and $C$ as ${{b}_{1},{b}_{2}}$ and ${{c}_{1},{c}_{2}}$, respectively.\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose columns are the vectors of $B$ relative to the basis $C.$\n\nHence, we need to find the coordinates of ${b}_{1}$ and ${b}_{2}$ relative to the basis $C.$ We can do this simultaneously by considering the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {c}_{1} & {c}_{2} & {b}_{1} & {b}_{2} \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we simply reduce the left-hand side to reduced row-echelon form using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & 2 & 1 \\\\ 2 & 5 & 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 2 & 1 \\\\ 0 & 1 & -1 & -1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 & 3 \\\\ 0 & 1 & -1 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the change-of-coordinates matrix ${P}_{B\\to C}$ is\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}4 & 3 \\\\ -1 & -1\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{C}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =[\\begin{aligned}4 & 3 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}5 \\\\ -7\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386716 :knowledge-point/_questions [{:knowledge-point/id #uuid "ff7c597d-d4a4-5567-add6-eac77475b0d6" :knowledge-point/title "Identifying Points That Are Neither Local Minima nor Local Maxima"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee62ed2b-3ad0-5e38-ae61-4bbccc602e50" :answer/type {:db/ident :answer.type/text} :answer/value "There is a local maximum at $x=11$" :db/id #edb/ref 17592186386718} {:answer/id #uuid "779191ca-00c8-5693-910a-831c70bd7d46" :answer/type {:db/ident :answer.type/text} :answer/value "There is a local minimum at $x=11$" :db/id #edb/ref 17592186386719} {:answer/id #uuid "61d766f1-e6b1-5341-a4d4-d213eed1d08d" :answer/type {:db/ident :answer.type/text} :answer/value "There is a local minimum at $x=0$" :db/id #edb/ref 17592186386720} {:answer/id #uuid "2e3d0ac1-d81a-5c65-9ab8-009b29188630" :answer/type {:db/ident :answer.type/text} :answer/value "The function $f(x)$ has no local extrema" :db/id #edb/ref 17592186386721} {:answer/id #uuid "19216037-df7a-53f0-9c94-0f1297c06adc" :answer/type {:db/ident :answer.type/text} :answer/value "There is a local maximum at $x=0$" :db/id #edb/ref 17592186386722}] :answer-field/correct {:answer/id #uuid "2e3d0ac1-d81a-5c65-9ab8-009b29188630" :answer/type {:db/ident :answer.type/text} :answer/value "The function $f(x)$ has no local extrema" :db/id #edb/ref 17592186386721} :answer-field/id #uuid "1017debf-dce0-50cd-9947-574ee59f46fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386717}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b349904b-6249-5c3c-b3c7-bf9319607046" :question/math-academy-id "q-113766" :question/problem "Given the function $f(x)={x}^{11},$ which of the following statements are true?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n{f}^{′}(x)=11{x}^{10}.\n$$\n\nSolving ${f}^{′}(x)=0$ gives\n\n$$\n11{x}^{10}=0\\,⟹\\,x=0.\n$$\n\nSo $x=0$ is the only stationary point of $f(x).$ Next, to determine whether this point is local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=-1,1$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =11(-1)^{10}=11>0 \\\\ {f}^{′}(1) & =11(1)^{10}=11>0\\end{aligned}\n$$\n\nWe summarize the information in a table shown below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $-1$ |  | $1$ |\n| ${f}^{′}$ | $+$ | $0$ | $+$ |\n| $f$ | $↗$ |  | $↗$ |\n\nThe first derivative does not change sign at $x=0.$ Therefore, we conclude that $x=0$ is neither a minimum nor a maximum.\n\nHence, the first derivative test shows that the function has no local extrema."}] [{:db/id #edb/ref 17592186386723 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d1a6ba2-db64-573f-8e5b-b88ea8981842" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186386725} {:answer/id #uuid "beae40ea-5a16-56be-94c0-5c319be8f0a9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386726} {:answer/id #uuid "d70342b7-9d3b-5244-a755-c5e40ee84a60" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386727} {:answer/id #uuid "7758f4a7-e843-5572-bd52-fd33dee0bce2" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386728} {:answer/id #uuid "8503faec-27f0-534a-a1ff-592a3f1183d0" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386729}] :answer-field/correct {:answer/id #uuid "beae40ea-5a16-56be-94c0-5c319be8f0a9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386726} :answer-field/id #uuid "81eaba12-1887-5376-9908-1a56c2da3284" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0fbe66e-c44a-5c47-b716-80288ecee20d" :question/math-academy-id "q-113880" :question/problem "What is ${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0,$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{3}{n})\\,\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233202 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9848c8b6-63aa-585c-9c3f-f09cf6a49bc9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{k/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186386731} {:answer/id #uuid "4af5c4a2-1d06-5974-840c-84a0c9369afb" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{4k/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386732} {:answer/id #uuid "0436ef1f-f984-5be7-bbed-df86ab8e327f" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{1}{2n}]" :db/id #edb/ref 17592186386733} {:answer/id #uuid "e02ec00a-498c-51f8-80b1-0c65fcdd05c3" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386734} {:answer/id #uuid "092157f2-38d5-50ad-be92-7e9d8c56698d" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386735}] :answer-field/correct {:answer/id #uuid "e02ec00a-498c-51f8-80b1-0c65fcdd05c3" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186386734} :answer-field/id #uuid "a11b3b07-1feb-5e0e-9468-621e3b27f6c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4385816f-7b9c-5f55-bc1f-96c9f8bc0f20" :question/math-academy-id "q-113927" :question/problem "What is ${\\int }_{0}^{2}{e}^{x}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-0}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{2k}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386736 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e817c90-73b6-5e40-a4cb-de6f65f4e504" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386738} {:answer/id #uuid "eec77c43-6c27-5f35-9de9-91342da5f4f9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386739} {:answer/id #uuid "f138b282-2b50-5da5-af3e-9f5891074c43" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{3n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386740} {:answer/id #uuid "69e645c6-0c73-5a1c-a257-403a41a6eca2" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386741} {:answer/id #uuid "dce1be34-b20a-5bb8-891d-5f521a6ed79b" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186386742}] :answer-field/correct {:answer/id #uuid "eec77c43-6c27-5f35-9de9-91342da5f4f9" :answer/type {:db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386739} :answer-field/id #uuid "1438f8f6-1b0c-5edd-937f-a796652639f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0af12d5f-0f9a-59ff-b6c2-207d86cde81b" :question/math-academy-id "q-113929" :question/problem "What is ${\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{3k}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054973 :knowledge-point/_questions 