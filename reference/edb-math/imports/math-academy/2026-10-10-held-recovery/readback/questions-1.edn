ligned}2 & 5 \\\\ 3 & 1\\end{aligned}]+[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2+4 & 5+1 \\\\ 3+(-2) & 1+2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096980 :knowledge-point/_questions [{:knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9506c823-cef4-5d91-9257-e951da7e14b8" :answer/type {:db/ident :answer.type/text} :answer/value "$x =-1$ only" :db/id #edb/ref 17592186093825} {:answer/id #uuid "96f522bf-2e6b-5264-b5d1-c9aec4b72f15" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 1$ only" :db/id #edb/ref 17592186093826} {:answer/id #uuid "ab3d74cb-4051-57ed-87b3-5aa7fa3e3d1c" :answer/type {:db/ident :answer.type/text} :answer/value "$g(x)$ has no inflection points" :db/id #edb/ref 17592186093827} {:answer/id #uuid "bf78219d-1db5-5974-98fa-1e76ec4c3d18" :answer/type {:db/ident :answer.type/text} :answer/value "$x = ± 1$ only" :db/id #edb/ref 17592186093828} {:answer/id #uuid "ce8be3f5-76b3-577c-96fa-dd6e0441f402" :answer/type {:db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186093829}] :answer-field/id #uuid "c9d5cd05-b8b3-5204-84c4-7e0767455567" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093824}] :question/id #uuid "47a20fe2-66d7-5e4d-88bc-ebcb0a87e290" :question/math-academy-id "q-114418" :question/problem "![](images/27/27f92e7288aa52ef67a6346fc5101173f51993be77cdd8face0517f2e6e790d3.png)\n\nThe function $g(x)$ is continuous and twice-differentiable for all $x$. The graph $y = g^{″}(x)$ is shown above. At what value(s) of $x$ does $g(x)$ have a point of inflection?"}] [{:db/id #edb/ref 17592186386749 :knowledge-point/_questions [{:knowledge-point/id 