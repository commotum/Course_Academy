{x}_{2} & =P{x}_{1} \\\\  & =[\\begin{aligned}0.2 & 0.5 \\\\ 0.8 & 0.5\\end{aligned}][\\begin{aligned}0.29 \\\\ 0.71\\end{aligned}] \\\\  & =[\\begin{aligned}0.413 \\\\ 0.587\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124955 :knowledge-point/_questions [{:knowledge-point/id #uuid "f232aed9-1584-5e57-a881-226a6876384a" :knowledge-point/title "Finding the Vector Equation of a Straight Line Given Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd44e118-b9d7-5b0d-aa4b-86097c349fbd" :answer/type {:db/ident :answer.type/math} :answer/value "r = t\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122301} {:answer/id #uuid "fec2dc66-d085-5885-85e3-c479c95c35af" :answer/type {:db/ident :answer.type/math} :answer/value "r = t\\begin{bmatrix}5 \\\\ 0 \\\\ 7\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122302} {:answer/id #uuid "3c1d6d85-1bf2-5b2b-b379-482881497974" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}5 \\\\ 0 \\\\ 7\\end{bmatrix} + t\\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122303} {:answer/id #uuid "495b676e-68f2-5a5d-b117-9facba95be57" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\begin{bmatrix}0 \\\\ 4 \\\\ 0\\end{bmatrix} + t\\begin{bmatrix}5 \\\\ 0 \\\\ 7\\end{bmatrix}, t ∈ (- ∞, ∞)" :db/id #edb/ref 17592186122304} {:answer/id #uuid "625b81d0-5afd-5e1c-8b1f-4ee3e71c9ba2" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186122305}] :answer-field/id #uuid "c93be85d-73be-531c-b8ee-7a50a954698d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122300}] :question/id #uuid "9efb0092-3045-58e2-bed4-ca88fc8fe6c0" :question/math-academy-id "q-36023" :question/problem "Consider the straight line given by the following parametric equations:\n${x = 5; y = 4t; z = 7$\nWhat wou