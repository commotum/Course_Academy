1c6a-5d27-8ba8-dcfd917d5f26" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x)" :db/id #edb/ref 17592186391889}] :answer-field/correct {:answer/id #uuid "21391e85-1c6a-5d27-8ba8-dcfd917d5f26" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x)" :db/id #edb/ref 17592186391889} :answer-field/id #uuid "145ecaa5-9e5b-51d0-b614-a47f6e8aa702" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391885}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7564f089-ba0c-513c-9df8-4c3c797d04cb" :question/math-academy-id "q-344266" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+2y=f(x)\n$$\n\non $[-1,1]$, where $f$ is $2$-periodic and odd. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $2$-periodic on $[-1,1]$, we have $L=1$, so Fourier series on this interval use the basis \n\n$$\ncos\\,(\\frac{n\\pi x}{1})\\,\\text{and}\\,sin\\,(\\frac{n\\pi x}{1}).\n$$\n\nNext, since $f$ is odd, its Fourier series contains only sine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an odd function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a sine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(n\\pi x)\n$$"}] [{:db/id #edb/ref 17592186391890 :knowledge-point/_questions [{:knowledge-point/id #uuid "3b3a1dcb-3788-58c3-9bf2-b0f681060ffd" :knowledge-point/title "Identifying the Form of the Fourier Series For the Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c02dac-dc9a-58f5-ac61-be40e997ed00" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186391892} {:answer/id #uuid "a756987e-8fb9-5f04-9834-f95885d2ee05" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{4})" :db/id #edb/ref 17592186391893} {:answer/id #uuid "2d3e1e17-92c5-52da-b301-a2ebd8bda2b5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186391894} {:answer/id #uuid "50a798b3-b743-56ed-9b8e-f33b96e9fcb5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=0}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{4})" :db/id #edb/ref 17592186391895}] :answer-field/correct {:answer/id #uuid "2d3e1e17-92c5-52da-b301-a2ebd8bda2b5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})" :db/id #edb/ref 17592186391894} :answer-field/id #uuid "9885c458-8f5d-5130-8d86-c8da5b1b3800" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186391891}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1231bd2-0ea0-512f-a509-a32953caed3d" :question/math-academy-id "q-344280" :question/problem "Consider the boundary value problem\n\n$$\n{y}^{″}+\\frac{1}{2}\\,y=f(x)\n$$\n\non $[-2,2]$, where $f$ is $4$-periodic and even. Which Fourier-series form is appropriate for a particular solution ${y}_{p}?$$\\,$\n${y}_{p}(x)=$\n{{field-1}}" :question/worked-solution "Because $f$ is $4$-periodic on $[-2,2]$, we have $L=2$, so Fourier series on this interval use the basis\n\n$$\n\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\\,\\text{and}\\,\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNext, since $f$ is even, its Fourier series contains only cosine terms. For a second-order equation with no ${y}^{′}$ (damping) term, the particular solution inherits this property and is also an even function.\n\nTherefore, the appropriate form for ${y}_{p}$ is a cosine series:\n\n$$\n{y}_{p}(x)={\\sum }_{n=0}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2})\n$$"}] [{:db/id #edb/ref 17592186391896 :knowledge-point/_questions [{:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee" :knowledge-point/title "The Derivative of a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d8f4b31-7cd4-567a-b1ab-e1908f4c5bd0" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-2{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391898} {:answer/id #uuid "770c4032-8926-5b49-96b8-17c721eb3eeb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }\\,i-{e}^{\\pi }\\,j+{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391899} {:answer/id #uuid "d767d08e-9f3d-5075-804a-e32b3b238995" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }\\,j" :db/id #edb/ref 17592186391900} {:answer/id #uuid "53ba9a50-f890-5647-8a42-ad787ec3b6e8" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391901} {:answer/id #uuid "fadb0885-54d3-518c-85c6-6d456aea62cc" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }\\,i-{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391902}] :answer-field/correct {:answer/id #uuid "53ba9a50-f890-5647-8a42-ad787ec3b6e8" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391901} :answer-field/id #uuid "1620165b-3bcb-5548-8049-48ba8d5cc382" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391897}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e579ce0-d5f9-57b8-931d-2fc18fc335d1" :question/math-academy-id "q-34724" :question/problem "Find the derivative of  $f(t)={e}^{t}\\operatorname{sin}⁡t\\,i+{e}^{t}\\,j+{e}^{t}\\operatorname{cos}⁡t\\,k$ at $t=\\pi .$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{cos}⁡t)\\,k \\\\  & =({e}^{t}\\operatorname{sin}⁡t+{e}^{t}\\operatorname{cos}⁡t)\\,i+{e}^{t}\\,j+({e}^{t}\\operatorname{cos}⁡t-{e}^{t}\\operatorname{sin}⁡t)\\,k\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(\\pi )$ we substitute $t=\\pi $ into the expression for ${f}^{′}(t)$:\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =({e}^{\\pi }\\operatorname{sin}⁡\\pi +{e}^{\\pi }\\operatorname{cos}⁡\\pi )\\,i+{e}^{\\pi }\\,j+({e}^{\\pi }\\operatorname{cos}⁡\\pi -{e}^{\\pi }\\operatorname{sin}⁡\\pi )\\,k \\\\  & =({e}^{\\pi }\\cdot 0+{e}^{\\pi }\\cdot (-1))\\,i+{e}^{\\pi }\\,j+({e}^{\\pi }\\cdot (-1)-{e}^{\\pi }\\cdot 0)\\,k \\\\  & =-{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-{e}^{\\pi }\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120374 :knowledge-point/_questions [{:knowledge-point/id #uuid "9171c6fb-ad0b-538f-b982-a2502a20e253" :knowledge-point/title "Solve a Variable in a Vector Lying in the Null Space of a Given Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb1cf5c1-9f30-52ce-a89c-7f1fce6e3095" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186391904} {:answer/id #uuid "8d2f68fa-3b71-5d07-b733-af46cee12558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186391905} {:answer/id #uuid "719f24a8-1729-514f-af15-f14817d50ed5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186391906} {:answer/id #uuid "5672bc95-b989-5b42-ab25-90a505f1a990" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186391907} {:answer/id #uuid "59999bbe-377e-57a6-9fe8-d1408d4cd819" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186391908}] :answer-field/correct {:answer/id #uuid "59999bbe-377e-57a6-9fe8-d1408d4cd819" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186391908} :answer-field/id #uuid "3115fd0f-c5be-5272-b0e8-d4a970bf1344" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5e07b6e6-db6e-581c-8777-d093455ecec5" :question/math-academy-id "q-34948" :question/problem "Consider the matrix $A=[\\begin{aligned}0 & 3 & -15 \\\\ -1 & 1 & -3\\end{aligned}]$ and the vector $b=[\\begin{aligned}2 \\\\ k \\\\ 1\\end{aligned}].$ Find the value of $k$ such that $b\\in \\text{Null}(A).$" :question/worked-solution "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ [\\begin{aligned}0 & 3 & -15 \\\\ -1 & 1 & -3\\end{aligned}][\\begin{aligned}2 \\\\ k \\\\ 1\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}3k-15 \\\\ -2+k-3\\end{aligned}] & =[\\begin{aligned}0 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n{\\begin{aligned}3k-15=0 \\\\ k-5=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=5.$"}] [{:db/id #edb/ref 17592186391909 :knowledge-point/_questions [{:knowledge-point/id #uuid "841f498b-f737-5086-8f79-44f1a143bebb" :knowledge-point/title "Finding the Coordinates of a Vector Relative To a Given Basis Containing Two Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c2b8825-d0f3-5cf3-8772-66a5bebe2a74" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186391911} {:answer/id #uuid "2a76e81c-9f5c-58e3-92b5-2eb7e44c3e8e" :answer/type {:db/ident :answer.type/math} :answer/value "x\\notin \\text{span}{{b}_{1},{b}_{2}}" :db/id #edb/ref 17592186391912} {:answer/id #uuid "61a90cd4-b7c0-5ccc-b6a1-7d72d7048fd7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186391913} {:answer/id #uuid "3b85a6f7-eafc-5b67-9e8d-a43f841a9bba" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186391914} {:answer/id #uuid "aabd78f7-b086-5589-a005-8319378aba32" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186391915}] :answer-field/correct {:answer/id #uuid "0c2b8825-d0f3-5cf3-8772-66a5bebe2a74" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186391911} :answer-field/id #uuid "be439d06-f9b7-505b-a37e-5f2a910df93d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6262ea2d-1b8c-5ef7-8314-13d0b021a42e" :question/math-academy-id "q-35218" :question/problem "Find the coordinates of the vector $x$ relative to the basis $B={{b}_{1},{b}_{2}},$ where\n\n$$\n{b}_{1}=[\\begin{aligned}4 \\\\ 0 \\\\ -8\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}],\\,x=[\\begin{aligned}10 \\\\ -4 \\\\ -4\\end{aligned}].\n$$\n\nIf $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$ then what is the value of ${x}_{1}+{x}_{2}?$" :question/worked-solution "We need to find ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{b}_{1}+{x}_{2}{b}_{2} & =x \\\\ {x}_{1}[\\begin{aligned}4 \\\\ 0 \\\\ -8\\end{aligned}]+{x}_{2}[\\begin{aligned}3 \\\\ -2 \\\\ 2\\end{aligned}] & =[\\begin{aligned}10 \\\\ -4 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nThe equation above gives the system with the augmented matrix \n\n$$\nM=[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ -8 & 2 & -4\\end{aligned}].\n$$\n\nRow-reducing the matrix using Gaussian elimination, we obtain the following:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ -8 & 2 & -4\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ 0 & 8 & 16\\end{aligned}] & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼[\\begin{aligned}4 & 3 & 10 \\\\ 0 & -2 & -4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nThe system is now \n\n$$\n{\\begin{aligned}4{x}_{1}+3{x}_{2}=10 \\\\ -2{x}_{2}=-4.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=2.$ Substituting this into the first equation, we obtain\n\n$$\n4{x}_{1}+3\\cdot 2=10\\,⟹\\,{x}_{1}=1.\n$$\n\nTherefore, $[x]_{B}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nFinally, ${x}_{1}+{x}_{2}=1+2=3.$"}] [{:db/id #edb/ref 17592186391916 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99" :knowledge-point/title "Finding a Vector Given Its Coordinates Relative To a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73075c87-a5af-52f3-b076-c875aaab0c30" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 14 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186391918} {:answer/id #uuid "0e580b3b-adfa-5089-8b27-15ec64aa2c13" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 10 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186391919} {:answer/id #uuid "78a930b0-c160-5728-affc-03b010a0487d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 14 \\\\ 10\\end{aligned}]" :db/id #edb/ref 17592186391920} {:answer/id #uuid "6c00bc93-a0bc-5e78-a6f5-a439d8886428" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ -14 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186391921} {:answer/id #uuid "b244039e-8ee3-5310-81ed-00f245a19495" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 12 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186391922}] :answer-field/correct {:answer/id #uuid "73075c87-a5af-52f3-b076-c875aaab0c30" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 14 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186391918} :answer-field/id #uuid "d26786d0-0f60-51cd-bdac-ab51c2bf2375" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391917}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b0a8e78-ed4c-5943-9301-5611951f6d20" :question/math-academy-id "q-35237" :question/problem "Find the vector  $x,$ If  $B={{b}_{1},{b}_{2}}$ is a basis of $\\text{Span}{{b}_{1},{b}_{2}},$ and\n\n$$\n{b}_{1}=[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}],\\,[x]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}{{b}_{1},{b}_{2}}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=[\\begin{aligned}-2 \\\\ 2\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}x & ={{(\\,-2\\,)}_{⏟}}_{{x}_{1}}[\\begin{aligned}1 \\\\ -3 \\\\ 2\\end{aligned}]+{{(\\,2\\,)}_{⏟}}_{{x}_{2}}[\\begin{aligned}2 \\\\ 4 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 \\\\ 6 \\\\ -4\\end{aligned}]+[\\begin{aligned}4 \\\\ 8 \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 14 \\\\ 2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124885 :knowledge-point/_questions [{:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field