ed}0.484 \\\\ 0.516\\end{aligned}]" :db/id #edb/ref 17592186391928} {:answer/id #uuid "e0c78f45-ea8e-5998-ac5d-b29decb14e02" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.844 \\\\ 0.156\\end{aligned}]" :db/id #edb/ref 17592186391929}] :answer-field/correct {:answer/id #uuid "cfd8efc0-924f-5b81-ac50-aecb46fdfe49" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.484 \\\\ 0.516\\end{aligned}]" :db/id #edb/ref 17592186391928} :answer-field/id #uuid "317c9011-9bc9-5c33-a4df-4f7ca53eee4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391924}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b15112f4-7893-524a-8de9-46c29499aff4" :question/math-academy-id "q-35789" :question/problem "$$\nP=[\\begin{aligned}0.25 & 0.85 \\\\ 0.75 & 0.15\\end{aligned}],\\,{x}_{0}=[\\begin{aligned}0.4 \\\\ 0.6\\end{aligned}]\n$$\n\n \nConsider a Markov chain with the stochastic matrix $P$ and the initial state vector ${x}_{0}$ given above. Calculate the state vector ${x}_{2}.$" :question/worked-solution "To find the state vector ${x}_{2},$ we apply two steps of the Markov chain:\n\n$$\n{x}_{1}=P{x}_{0},\\,{x}_{2}=P{x}_{1}\n$$\n\nAfter the first step, we have\n\n$$\n\\begin{aligned}{x}_{1} & =P{x}_{0} \\\\  & =[\\begin{aligned}0.25 & 0.85 \\\\ 0.75 & 0.15\\end{aligned}][\\begin{aligned}0.4 \\\\ 0.6\\end{aligned}] \\\\  & =[\\begin{aligned}0.61 \\\\ 0.39\\end{aligned}].\\end{aligned}\n$$\n\nFinally, after the second step, we obtain \n\n$$\n\\begin{aligned}{x}_{2} & =P{x}_{1} \\\\  & =[\\begin{aligned}0.25 & 0.85 \\\\ 0.75 & 0.15\\end{aligned}][\\begin{aligned}0.61 \\\\ 0.39\\end{aligned}] \\\\  & =[\\begin{aligned}0.484 \\\\ 0.516\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186391930 :knowledge-point/_questions [{:knowledge-point/id #uuid "595fd527-e8fd-5360-87f1-acbeab511566" :knowledge-point/title "Finding the Change-of-Coordinates Matrix Given a Linear Connection Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c152ad31-9541-5659-8f58-289792ab3115" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 \\\\ -3 & -7\\end{aligned}]" :db/id #edb/ref 17592186391932} {:answer/id #uuid "30ae742d-1fb0-5d27-aa98-7f3d79778e2b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & 2 \\\\ -7 & -3\\end{aligned}]" :db/id #edb/ref 17592186391933} {:answer/id #uuid "3ee232ba-51e5-53d9-999c-395cc0c83bae" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 2 \\\\ 4 & -7\\end{aligned}]" :db/id #edb/ref 17592186391934} {:answer/id #uuid "d505792c-b7a2-563b-9f1d-8b0555bc6d01" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ -7 & 4\\end{aligned}]" :db/id #edb/ref 17592186391935} {:answer/id #uuid "b9730990-879b-556c-b97b-adf0ef8e0f59" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 4 \\\\ -7 & -3\\end{aligned}]" :db/id #edb/ref 17592186391936}] :answer-field/correct {:answer/id #uuid "d505792c-b7a2-563b-9f1d-8b0555bc6d01" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ -7 & 4\\end{aligned}]" :db/id #edb/ref 17592186391935} :answer-field/id #uuid "48c3186d-8a01-5b31-8ad7-a5c52ca18291" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "908bbb6f-b2af-5300-a3b8-64f2ea850255" :question/math-academy-id "q-35792" :question/problem "Let $B={{b}_{1},{b}_{2}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{2}.$ If ${b}_{1}=2{c}_{1}-7{c}_{2}$ and ${b}_{2}=4{c}_{2}-3{c}_{1},$ find the change-of-coordinates matrix ${P}_{B\\to C}$ from $B$ to $C.$" :question/worked-solution "The coordinates of the vectors in $B$ relative to the basis $C$ are\n\n$$\n[{b}_{1}]_{C}=[\\begin{aligned}2 \\\\ -7\\end{aligned}],\\,[{b}_{2}]_{C}=[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\n$$\n\nThe change-of-coordinates matrix from $B$ to $C$ is a matrix whose respective columns are the coordinates of the vectors of $B$ relative to the basis $C.$ \n\nTherefore, we obtain\n\n$$\n{P}_{B\\to C}=[\\begin{aligned}2 & -3 \\\\ -7 & 4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186391937 :knowledge-point/_questions [{:knowledge-point/id #uuid "595fd527-e8fd-5360-87f1-acbeab511566" :knowledge-point/title "Finding the Change-of-Coordinates Matrix Given a Linear Connection Between Two Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a87aed5b-b697-5edb-ac03-a70218fa01de" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186391939} {:answer/id #uuid "1866b6f4-8742-5ad2-a465-70accbd1e015" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -3 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186391940} {:answer/id #uuid "b1bf0efa-74c2-5426-b665-065661f8384b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 4 \\\\ 2 & -3\\end{aligned}]" :db/id #edb/ref 17592186391941} {:answer/id #uuid "ae7ca485-3748-512a-8c19-b4346ea635cb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186391942} {:answer/id #uuid "b51e6c19-9a83-509d-a40d-dbf2f0de2e7b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & -2 \\\\ -4 & 3\\end{aligned}]" :db/id #edb/ref 17592186391943}] :answer-field/correct {:answer/id #uuid "ae7ca485-3748-512a-8c19-b4346ea635cb" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ -3 & 4\\end{aligned}]" :db/id #edb/ref 17592186391942} :answer-field/id #uuid "eabb2acb-a068-5e37-8a97-acbe8151ed83" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186391938}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ee07384-0d2d-5d34-baac-3296201157fd" :question/math-academy-id "q-35795" :question/problem "Let $B={{b}_{1},{b}_{2}}$ and $C={{c}_{1},{c}_{2}}$ be bases of ${R}^{2}.$ \nFind the change-of-coordinates matrix ${P}_{C\\to B}$ from $C$ to $B$ given that\n\n$$\n[{c}_{1}]_{B}=[\\begin{aligned}2 \\\\ -3\\end{aligned}],\\,[{c}_{2}]_{B}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].\n$$" :question/worked-solution "The change-of-coordinates matrix from $C$ to $B$ is a matrix whose respective columns are the coordinates of the vectors of $C$ relative to the basis $B.$ \n\nTherefore, we obtain\n\n$$\n{P}_{C\\to B}=[\\begin{aligned}2 & 1 \\\\ -3 & 4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186323727 :knowledge-point/_questions [{:knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2842cc73-0f01-58d5-b5f8-0139583e8db8" :answer/type {:db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186321467} {:answer/id #uuid "2de3d6aa-490c-5cae-a784-6e667b895471" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186321512} {:answer/id #uuid "a00a0949-433b-5624-94b0-a6603a842920" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186322418} {:answer/id #uuid "a251689c-7067-57e5-bcb5-7bc51fb827e3" :answer/type {:db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186322434} {:answer/id #uuid "b425d295-6b7a-560e-97ee-8069726e7fc1" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322561}] :answer-field/correct {:answer/id #uuid "b425d295-6b7a-560e-97ee-8069726e7fc1" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322561} :answer-field/id #uuid "bad8f0e9-eadc-541a-b41e-da64a5a6afcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed660c39-3116-519a-a531-99463ad097b8" :question/math-academy-id "q-35833" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{4{x}^{2}-9x+1}{x+4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{2}-9x+1}{x+4} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{2}}{x}-\\frac{9x}{x}+\\frac{1}{x})}{(\\frac{x}{x}+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+\\frac{1}{x})}{(1+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+0)}{(1+0)} \\\\  & ={lim}_{x\\to \\infty }(4x)-9 \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186124931 :knowledge-point/_questions [{:knowledge-point/id #uuid "4821de45-1b6b-5b4f-be0e-96cf5395bc8d" :knowledge-point/title "Calculating a State Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da359ad7-2c5e-5f15-a2e5-6728987ffc41" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.393 \\\\ 0.607\\end{aligned}]" :db/id #edb/ref 17592186391945} {:answer/id #uuid "a65dbb5f-4e7c-55d0-9006-3317ba92c5a3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0.442 \\\\ 0.558\\end{aligned}]" :db/id #edb/ref 1759