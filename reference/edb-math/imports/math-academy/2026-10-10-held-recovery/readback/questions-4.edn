ds [{:answer-field/choices [{:answer/id #uuid "f2c148b3-19df-5c1b-899c-9451b550ec4f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}]" :db/id #edb/ref 17592186388063} {:answer/id #uuid "b9da86f6-33b2-563f-87c0-d573b7e2ae6f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & -10 \\\\ 1 & 0 & -1 \\\\ 4 & 1 & 9\\end{aligned}]" :db/id #edb/ref 17592186388064} {:answer/id #uuid "a1928a58-bfd8-5e15-89ec-d24b7a72b4a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -5 \\\\ 1 & 4 & -1 \\\\ -4 & -1 & 9\\end{aligned}]" :db/id #edb/ref 17592186388065} {:answer/id #uuid "77a9500f-436a-5625-baf8-4174157792fa" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -10 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186388066} {:answer/id #uuid "5f13e6d3-88c5-55f3-9427-37d09604d929" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & -11 \\\\ 1 & 4 & -1 \\\\ -2 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186388067}] :answer-field/correct {:answer/id #uuid "f2c148b3-19df-5c1b-899c-9451b550ec4f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}]" :db/id #edb/ref 17592186388063} :answer-field/id #uuid "6f2e5b03-ca6f-513b-9a50-b8c4c6e6786e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388062}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44e77bb3-4ca9-5711-b379-be95b2be4f2f" :question/math-academy-id "q-129425" :question/problem "Find $BC$, if \n$B=[\\begin{aligned}1 & 3 & 6 \\\\ -1 & 0 & 2 \\\\ 0 & 1 & -2\\end{aligned}]$\nand\n$C=[\\begin{aligned}1 & -4 & -5 \\\\ -2 & 1 & 4 \\\\ 1 & 0 & -3\\end{aligned}].$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n \n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}1 & 3 & 6 \\\\ -1 & 0 & 2 \\\\ 0 & 1 & -2\\end{aligned}][\\begin{aligned}1 & -4 & -5 \\\\ -2 & 1 & 4 \\\\ 1 & 0 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1-6+6 & -4+3+0 & -5+12-18 \\\\ -1+0+2 & 4+0+0 & 5+0-6 \\\\ 0-2-2 & 0+1+0 & 0+4+6\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 & -11 \\\\ 1 & 4 & -1 \\\\ -4 & 1 & 10\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388068 :knowledge-point/_questions [{:knowledge-point/id #uuid "eb1afe82-86ba-5a15-9037-74717692ecb2" :knowledge-point/title "Applying Row Operations To a Coefficients Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3918bbf4-16cc-5c1f-a802-36adb86390c4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ -14 & 3 & -4 \\\\ -2 & 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186388070} {:answer/id #uuid "e62342b5-074d-5e24-9642-83584f678838" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186388071} {:answer/id #uuid "b6849f47-5bf1-537e-9558-fee095da4647" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186388072} {:answer/id #uuid "7c6fc884-3dee-5e5f-9162-e9d9a9e34a9d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ -5 & 9 & -11 \\\\ -2 & 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186388073} {:answer/id #uuid "22917917-c3d7-5ada-b4ca-d45cebf96675" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 26 & 19 & -26 \\\\ -2 & 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186388074}] :answer-field/correct {:answer/id #uuid "e62342b5-074d-5e24-9642-83584f678838" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{aligned}]" :db/id #edb/ref 17592186388071} :answer-field/id #uuid "f9ef02a3-2e92-5a2e-a56c-df3ea22f0bc2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388069}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1a5db75-1b21-5cae-946a-8cdf4a8b6bd6" :question/math-academy-id "q-130010" :question/problem "Consider the matrix $C,$ given by\n\n$$\nC=[\\begin{aligned}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the following row operations on $C?$\n\n$$\n\\begin{aligned}{R}_{2} & :={R}_{2}+3{R}_{1} \\\\ {R}_{2} & :={R}_{2}-{R}_{3}\\end{aligned}\n$$" :question/worked-solution "Let's list the required operations:\n\n- The operation ${R}_{2}:={R}_{2}+3{R}_{1}$ means that we need to add $3$ times the first row to the second row.\n\n- The operation ${R}_{2}:={R}_{2}-{R}_{3}$ means that we need to add $-1$ times the third row to the second row.\n\nApplying the operations, we obtain the following:\n\n$$\n\\begin{aligned}C & =[\\begin{aligned}9 & 6 & -7 \\\\ 1 & -3 & -2 \\\\ -2 & 4 & -3\\end{aligned}]\\,{R}_{2}:={R}_{2}+3\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 1+(3)(9) & -3+(3)(6) & -2+(3)(-7) \\\\ -2 & 4 & -3\\end{aligned}] \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 28 & 15 & -23 \\\\ -2 & 4 & -3\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-1)\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 28+(-1)(-2) & 15+(-1)(4) & -23+(-1)(-3) \\\\ -2 & 4 & -3\\end{aligned}] \\\\  & ∼[\\begin{aligned}9 & 6 & -7 \\\\ 30 & 11 & -20 \\\\ -2 & 4 & -3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388075 :knowledge-point/_questions [{:knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5228249-42b4-5b6c-a34b-688628cf3c23" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & -\\frac{8}{3} & -1 \\\\ 7 & 1 & 3 & 4 \\\\ 6 & -3 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186388077} {:answer/id #uuid "0df908b7-b9cf-5d37-aca8-7f00b46a2051" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186388078} {:answer/id #uuid "afd3402b-d0f0-5d8e-92cd-42bc4ac1d793" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186388079} {:answer/id #uuid "269dae98-aadc-597a-82e7-371420d4533a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186388080} {:answer/id #uuid "1ee9af5a-41eb-5f3b-a278-9fcb76973748" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & -3 & 9 & 0\\end{aligned}]" :db/id #edb/ref 17592186388081}] :answer-field/correct {:answer/id #uuid "afd3402b-d0f0-5d8e-92cd-42bc4ac1d793" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]" :db/id #edb/ref 17592186388079} :answer-field/id #uuid "95465894-f1f7-5a8d-84b8-f2ad025aafe5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388076}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0f08a2c2-eb16-5d85-a714-beb36e4a0c94" :question/math-academy-id "q-130071" :question/problem "Consider the augmented matrix $A,$ given by\n\n$$\nA=[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ on $A?$" :question/worked-solution "The operation ${R}_{3}:=-\\frac{1}{3}{R}_{3}$ means that we need to multiply the third row of the matrix by $-\\frac{1}{3}.$\n\nMultiplying the $3$rd row by $-\\frac{1}{3}$, we obtain the following:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ 6 & -3 & 9 & 0\\end{aligned}]\\,{R}_{3}:=(-\\frac{1}{3})\\cdot {R}_{3} \\\\  & ∼[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ (-\\frac{1}{3})\\cdot 6 & (-\\frac{1}{3})\\cdot (-3) & (-\\frac{1}{3})\\cdot 9 & (-\\frac{1}{3})\\cdot 0\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 8 & -1 \\\\ 7 & 1 & -9 & 4 \\\\ -2 & 1 & -3 & 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388082 :knowledge-point/_questions [{:knowledge-point/id #uuid "5ae7e9c8-60e9-5f5e-afbf-1de6bb01bf07" :knowledge-point/title "Finding the Tangent Line to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8440b232-2d79-53cd-bad6-36fe06f0e97a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,0⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388084} {:answer/id #uuid "fec3679d-d002-508a-b44e-896ae847115f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,0⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388085} {:answer/id #uuid "d41769d3-a85e-5a1d-b0d2-621fb6f6adf3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388086} {:answer/id #uuid "8d510eb4-4bca-58e9-bca7-c33fc8cc7f6f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388087} {:answer/id #uuid "112648f6-f22c-57a0-8ebb-0ebd53decbdd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388088}] :answer-field/correct {:answer/id #uuid "112648f6-f22c-57a0-8ebb-0ebd53decbdd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1⟩\\cdot ⟨x-1,\\,y+1⟩=0" :db/id #edb/ref 17592186388088} :answer-field/id #uuid "b68b09e4-9252-5d68-ab26-fe3cc2a6e217" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388083}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c1bed00-c1da-539a-bd7b-b11b7bf684ae" :question/math-academy-id "q-130094" :question/problem "Given the function $f(x,y)=x{y}^{2}-x+y,$ find the equation of the tangent line to the level curve that passes through the point where $(x,y)=(1,-1).$" :question/worked-solution "The equation of the tangent line to the level curve $f(x,y)=k$ at the point $({x}_{0},{y}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩=0.\n$$\n\nFirst, we find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(1,-1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(x{y}^{2}-x+y)\\,i+\\frac{∂}{∂y}(x{y}^{2}-x+y)\\,j \\\\  & =({y}^{2}-1)\\text{ }i+(2xy+1)\\text{ }j \\\\ ∇f(1,-1) & =((-1)^{2}-1)\\,i+(2(1)(-1)+1)\\,j \\\\  & =0\\,i-j \\\\  & =⟨0,-1⟩\\end{aligned}\n$$\n\nNow, the Cartesian equation of the tangent line to the level curve that passes through the point $({x}_{0},{y}_{0})$ can be written as\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0}⟩ & =0 \\\\ ∇f(1,-1)\\cdot ⟨x-1,\\,y-(-1)⟩ & =0 \\\\ ⟨0,-1⟩\\cdot ⟨x-1,\\,y+1⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388089 :knowledge-point/_questions [{:knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59f4e581-a00c-5132-927c-1585f2f16335" :answer/type {:db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186388091} {:answer/id #uuid "a25cb316-03e0-5b80-b36c-bf23e9ecd400" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-\\frac{7}{8})" :db/id #edb/ref 17592186388092} {:answer/id #uuid "7ce509f6-676c-5142-b2e8-6b75044a4ae3" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-1)" :db/id #edb/ref 17592186388093} {:answer/id #uuid "56675fa5-8d6f-5214-9ce9-5265d8d72af6" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186388094} {:answer/id #uuid "5bff0bff-8fcd-5363-b279-0ef233e06a17" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{1}{2},-\\frac{1}{2})" :db/id #edb/ref 17592186388095}] :answer-field/correct {:answer/id #uuid "a25cb316-03e0-5b80-b36c-bf23e9ecd400" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\frac{1}{4},-\\frac{7}{8})" :db/id #edb/ref 17592186388092} :answer-field/id #uuid "368f7e81-de7f-51a5-98fc-f718da4aa1b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388090}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f930a915-2d68-50d6-9185-efb4889fde3f" :question/math-academy-id "q-130209" :question/problem "At which point on the curve $2{x}^{2}=y+1$ is the tangent vector to the curve perpendicular to the vector $i+j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2} & =y+1 \\\\ 2{x}^{2}-y & =1\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-y,$ our curve can be viewed as the level curve $f(x,y)=1.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-y)\\,j \\\\  & =-i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $i+j,$ we must have $t\\cdot (i+j)=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot (i+j) & =0 \\\\ (-i-4x\\,j)\\cdot (i+j) & =0 \\\\ -1-4x & =0 \\\\ x & =-\\frac{1}{4}\\end{aligned}\n$$\n\nSubstituting $x=-\\frac{1}{4}$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2} & =y+1 \\\\ 2{(-\\frac{1}{4})}^{2} & =y+1 \\\\ \\frac{1}{8} & =y+1 \\\\ y & =-\\frac{7}{8}.\\end{aligned}\n$$\n\nFinally, the corresponding point is $(-\\frac{1}{4},-\\frac{7}{8}).$"}] [{:db/id #edb/ref 17592186388096 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7ad52ce-d408-5390-b91f-c855274f39ea" :knowledge-point/title "Calculating a Matrix Product Using the Distributive Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94eaedeb-d14a-5b50-9cc7-4ad0b2f03f7b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ \\sqrt{2} & -\\sqrt{2} & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388098} {:answer/id #uuid "a956827c-a23e-56c4-9e5f-8c8e21ce2a36" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388099} {:answer/id #uuid "3bdf7634-79ef-565d-858f-11943c4d903e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & \\sqrt{2} & 0 \\\\ 0 & -\\sqrt{2} & 0 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388100} {:answer/id #uuid "ffa6a60f-415f-5b14-8f97-93d351d78b98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388101} {:answer/id #uuid "ae69e124-6446-5af0-9833-757e17efe5cc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ 1 & -\\sqrt{2} & 2 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388102}] :answer-field/correct {:answer/id #uuid "ffa6a60f-415f-5b14-8f97-93d351d78b98" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388101} :answer-field/id #uuid "737de3a2-dc25-52ae-ba23-56212b940498" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388097}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c8441f0a-579a-53ac-9a6d-fa812952db44" :question/math-academy-id "q-130259" :question/problem "Calculate $AC+BC$, where\n\n$$\nA=[\\begin{aligned}1 & 2 & 3 \\\\ 3 & 2 & -3 \\\\ -3 & -4 & 2\\end{aligned}],\\,B=[\\begin{aligned}-1 & -2 & -3 \\\\ -2 & -2 & 3 \\\\ 3 & 4 & -2\\end{aligned}],\\,C=[\\begin{aligned}-2 & \\sqrt{2} & 1 \\\\ 1 & -\\sqrt{2} & 2 \\\\ -2 & 0 & 2\\end{aligned}].\n$$" :question/worked-solution "We can apply the distributive law\n\n$$\nAC+BC=(A+B)C.\n$$\n\nSo, we calculate $A+B$ first:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}1 & 2 & 3 \\\\ 3 & 2 & -3 \\\\ -3 & -4 & 2\\end{aligned}]+[\\begin{aligned}-1 & -2 & -3 \\\\ -2 & -2 & 3 \\\\ 3 & 4 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}AC+BC & =(A+B)C \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}].[\\begin{aligned}-2 & \\sqrt{2} & 1 \\\\ 1 & -\\sqrt{2} & 2 \\\\ -2 & 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 & 0 \\\\ -2 & \\sqrt{2} & 1 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388103 :knowledge-point/_questions [{:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee" :knowledge-point/title "The Derivative of a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cf3b3e9-5525-5663-9cf2-a10207731431" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{20}{{t}^{5}} \\\\ 2t\\operatorname{sin}⁡t+{t}^{2}\\operatorname{cos}⁡t \\\\ {2}^{t}\\operatorname{ln}⁡2\\end{aligned}]" :db/id #edb/ref 17592186388105} {:answer/id #uuid "6134b075-d637-5d00-8b92-595e8552ffba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{20}{{t}^{5}} \\\\ 2t\\operatorname{sin}⁡t+{t}^{2}\\operatorname{cos}⁡t \\\\ {2}^{t}\\end{aligned}]" :db/id #edb/ref 17592186388106} {:answer/id #uuid "5411e8cb-d9f4-526b-a3ba-970deb3f15d0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{5}{4{t}^{5}} \\\\ 2t\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t \\\\ {2}^{t}\\operatorname{ln}⁡2\\end{aligned}]" :db/id #edb/ref 17592186388107} {:answer/id #uuid "7825d2bf-aec1-5ba7-93a0-a00aa2285434" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{20}{{t}^{5}} \\\\ {t}^{2}\\operatorname{sin}⁡t+2t\\operatorname{cos}⁡t \\\\ {2}^{t}\\operatorname{ln}⁡2\\end{aligned}]" :db/id #edb/ref 17592186388108} {:answer/id #uuid "67b2892e-c95d-51f8-9994-b6d68c2ec8a6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{5}{4{t}^{5}} \\\\ {t}^{2}\\operatorname{cos}⁡t+2t\\operatorname{sin}⁡t \\\\ \\operatorname{ln}⁡2\\end{aligned}]" :db/id #edb/ref 17592186388109}] :answer-field/correct {:answer/id #uuid "3cf3b3e9-5525-5663-9cf2-a10207731431" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\frac{20}{{t}^{5}} \\\\ 2t\\operatorname{sin}⁡t+{t}^{2}\\operatorname{cos}⁡t \\\\ {2}^{t}\\operatorname{ln}⁡2\\end{aligned}]" :db/id #edb/ref 17592186388105} :answer-field/id #uuid "b1b9e495-4e85-5dcd-86df-bc543e98d356" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388104}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "422634d2-16ff-5174-a2f8-b71facc9ec9f" :question/math-academy-id "q-130400" :question/problem "Calculate ${f}^{′}(t)$ given that $f(t)=[\\begin{aligned}\\frac{5}{{t}^{4}} \\\\ {t}^{2}\\operatorname{sin}⁡t \\\\ {2}^{t}\\end{aligned}].$" :question/worked-solution "We find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\frac{5}{{t}^{4}}) \\\\ \\frac{\\text{d}}{\\text{d}t}({t}^{2}\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}({2}^{t})\\end{aligned}]=[\\begin{aligned}-\\frac{20}{{t}^{5}} \\\\ 2t\\operatorname{sin}⁡t+{t}^{2}\\operatorname{cos}⁡t \\\\ {2}^{t}\\operatorname{ln}⁡2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388110 :knowledge-point/_questions [{:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee" :knowledge-point/title "The Derivative of a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1fe797-2919-5ad5-93f4-36e98939c7be" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,\\frac{1}{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩" :db/id #edb/ref 17592186388112} {:answer/id #uuid "e466e53d-149c-525e-ba62-5068da1d66a9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩" :db/id #edb/ref 17592186388113} {:answer/id #uuid "698b7584-db59-5635-8441-8bada94b325a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\pi ,\\,\\sqrt{{\\pi }^{2}+1},\\,2(2\\pi +1)⟩" :db/id #edb/ref 17592186388114} {:answer/id #uuid "f3dc9d67-7e06-5b29-a02d-e5f0b4cf4be7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\pi ,\\,\\frac{2}{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi -2)⟩" :db/id #edb/ref 17592186388115} {:answer/id #uuid "0f95bba9-b5f0-5dff-8ca4-f870c2f23413" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2\\pi ⟩" :db/id #edb/ref 17592186388116}] :answer-field/correct {:answer/id #uuid "e466e53d-149c-525e-ba62-5068da1d66a9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩" :db/id #edb/ref 17592186388113} :answer-field/id #uuid "c2be193b-5173-592e-b997-b1966e08ed0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d3b1235-338f-544b-9e5f-ca61081e2c9e" :question/math-academy-id "q-130408" :question/problem "Find the derivative of  $f(t)=⟨\\operatorname{cos}⁡2t,\\,\\sqrt{{t}^{2}+1},\\,(t+2)^{2}⟩$ at $t=\\pi .$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{{t}^{2}+1}),\\,\\frac{\\text{d}}{\\text{d}t}((t+2)^{2})⟩ \\\\  & =⟨-2\\operatorname{sin}⁡2t,\\,\\frac{t}{\\sqrt{{t}^{2}+1}},\\,2(t+2)⟩\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(\\pi )$ we substitute $t=\\pi $ into the expression for ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =⟨-2\\operatorname{sin}⁡2\\pi ,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩ \\\\  & =⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388117 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e970fe-cff8-50e3-9b94-67ad97b03da7" :knowledge-point/title "Finding a Power of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7404f17f-430a-52fc-ad31-5483dd3d422f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186388119} {:answer/id #uuid "6f785005-ba15-55aa-b2c1-49679b83ded2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 24 \\\\ -24 & -8\\end{aligned}]" :db/id #edb/ref 17592186388120} {:answer/id #uuid "44f9cc8e-2832-5d4d-bde3-6190366eb16a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & -3 \\\\ 3 & 