ices [{:answer/id #uuid "55564f42-9122-50c8-bc85-7b867e39832a" :answer/type {:db/ident :answer.type/image} :answer/value "images/ec/ecf914db233f7b1775f49b060470af6a244f8ea8d101fdcced746144b0284552.png" :db/id #edb/ref 17592186389251} {:answer/id #uuid "7ce864de-6e2a-5ab7-bcef-4e9face373f7" :answer/type {:db/ident :answer.type/image} :answer/value "images/f3/f3cd046f58b44ee916b85df91382a16360895b12c8d47a4a25deffe09f7d7c05.png" :db/id #edb/ref 17592186389252} {:answer/id #uuid "97f59338-f537-5bbb-8998-6e13760f227e" :answer/type {:db/ident :answer.type/image} :answer/value "images/e3/e3f30779c39c3800ed3a8f090df581bc9d1b7007e299fd4504180e7be1ec52e9.png" :db/id #edb/ref 17592186389253} {:answer/id #uuid "3e2793cd-65cc-58f3-b7c3-b03cb6422420" :answer/type {:db/ident :answer.type/image} :answer/value "images/9e/9e5fb2564eb1f5adb380d70e1a86925fa377f10cc653d98d73ba64bfb03de197.png" :db/id #edb/ref 17592186389254} {:answer/id #uuid "8c4672ba-d70d-5d79-ba28-25b3937fb8e4" :answer/type {:db/ident :answer.type/image} :answer/value "images/27/2733af9666ca54ca578eea56a5f05d5d8245df01f7aa1312e70610ae8a7beee7.png" :db/id #edb/ref 17592186389255}] :answer-field/correct {:answer/id #uuid "97f59338-f537-5bbb-8998-6e13760f227e" :answer/type {:db/ident :answer.type/image} :answer/value "images/e3/e3f30779c39c3800ed3a8f090df581bc9d1b7007e299fd4504180e7be1ec52e9.png" :db/id #edb/ref 17592186389253} :answer-field/id #uuid "0654bdfd-e646-5833-bff5-a82fbd058d96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389250}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3c6ddb24-c52e-5856-abf5-27a3d99136c7" :question/math-academy-id "q-16196" :question/problem "Determine the graph of the following parametrically defined curve:\n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,\\,\\,y=2\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le 2\\pi \n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=2\\operatorname{cos}⁡\\theta .$ This gives\n\n| **$\\theta $** | $0$ | $\\frac{\\pi }{6}$ | $\\frac{\\pi }{3}$ | $\\frac{2\\pi }{3}$ | $\\pi $ | $\\frac{4\\pi }{3}$ | $\\frac{5\\pi }{3}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $2$ | $\\sqrt{3}$ | $1$ | $-1$ | $-2$ | $-1$ | $1$ |\n| $y$ | $$ | $$ | $$ | $$ | $$ | $$ | $$ |\n\n$$\n\n$$\n\nNow, we work out the $y$ values using $y=2\\operatorname{sin}⁡\\theta .$ This gives\n\n| **$\\theta $** | $0$ | $\\frac{\\pi }{6}$ | $\\frac{\\pi }{3}$ | $\\frac{2\\pi }{3}$ | $\\pi $ | $\\frac{4\\pi }{3}$ | $\\frac{5\\pi }{3}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $2$ | $\\sqrt{3}$ | $1$ | $-1$ | $-2$ | $-1$ | $1$ |\n| $y$ | $0$ | $1$ | $\\sqrt{3}$ | $\\sqrt{3}$ | $0$ | $-\\sqrt{3}$ | $-\\sqrt{3}$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](images/47/47615688bf550384de29a5e7e480bdab699b8eee994e5e28052e4d043e2db503.png)"}] [{:db/id #edb/ref 17592186106074 :knowledge-point/_questions [{:knowledge-point/id #uuid "3fea43b6-fd7b-5edc-b6b7-7f8b2cbab502" :knowledge-point/title "Identifying the Type of Image Formed by a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bb34d14-4e6b-5921-bbae-0804ad06b4f2" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186102301} {:answer/id #uuid "b2b33753-c1ca-54f2-b9c6-98ba27f6fa8e" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186102302} {:answer/id #uuid "cb1ac350-98a0-5f6c-8490-7f08a97c5de0" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186102303} {:answer/id #uuid "1338e2d6-476a-5cc4-a9f7-69b9fb7f0f6c" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186102304} {:answer/id #uuid "39e1c3d2-cf9c-5c0f-ac61-180359ad5ac6" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186102305}] :answer-field/id #uuid "98d6bd43-1322-57b8-8f87-0e031cdaba61" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102300}] :question/id #uuid "ba678a53-c013-5d44-b391-2d5cc0a9cc96" :question/math-academy-id "q-162150" :question/problem "![](images/e2/e2ab6906100a96a123b4b1520613f1e38fe2c7e77af390a8efe0596a2861727d.png)\n\nConsider the linear transformation $T$ with matrix representation $T$, given by\n$T = \\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}$.\nWhat would be the image of the triangle shown above under the action of $T$?"}] [{:db/id #edb/ref 17592186389256 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e551b65-4116-58bc-b2bc-e536930c69b4" :knowledge-point/title "Identifying the Types of Images Formed by an Affine Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df95a0cf-0d57-5a93-ac2f-e7e698ff77a1" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186389258} {:answer/id #uuid "b92ebcbf-f068-555d-863e-04c41a13ff18" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186389259} {:answer/id #uuid "1f7c5c2f-8c10-5091-a460-a5b671bf8c82" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186389260} {:answer/id #uuid "5ef4fb02-e604-5dc5-8e46-a8a75eadac14" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186389261} {:answer/id #uuid "955f1935-0944-5d9f-9475-dcae022a4eeb" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186389262}] :answer-field/correct {:answer/id #uuid "df95a0cf-0d57-5a93-ac2f-e7e698ff77a1" :answer/type {:db/ident :answer.type/text} :answer/value "A parallelogram" :db/id #edb/ref 17592186389258} :answer-field/id #uuid "e581555a-cb1e-51f4-adbf-43ba3b75f28d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11c11bf3-c97a-56d9-961f-42e1efebf284" :question/math-academy-id "q-162197" :question/problem "![](images/c3/c36f3eb07b45eebf7f4de2a26cb366ca4ab785b5c7e8e6d25eb7bbad2c418838.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=3u-v-1,\\,y=2u+5v.\n$$\n\nWhat would be the image of the rectangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}3u-v-1 \\\\ 2u+5v\\end{aligned}] \\\\  & =[\\begin{aligned}3u-v \\\\ 2u+5v\\end{aligned}]+[\\begin{aligned}-1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -1 \\\\ 2 & 5\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}3 & -1 \\\\ 2 & 5\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}3 & -1 \\\\ 2 & 5\\end{aligned}| \\\\  & =3\\cdot 5-2\\cdot (-1) \\\\  & =17 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible, and the image of the rectangle under the action of $T$ is a parallelogram."}] [{:db/id #edb/ref 17592186389263 :knowledge-point/_questions [{:knowledge-point/id #uuid "4e551b65-4116-58bc-b2bc-e536930c69b4" :knowledge-point/title "Identifying the Types of Images Formed by an Affine Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e04b870d-e25b-5d96-b606-28a110148002" :answer/type {:db/ident :answer.type/text} :answer/value "A square" :db/id #edb/ref 17592186389265} {:answer/id #uuid "062427a9-0f48-53fc-94f1-c6c3d5e866d8" :answer/type {:db/ident :answer.type/text} :answer/value "A point" :db/id #edb/ref 17592186389266} {:answer/id #uuid "b7b5ad5a-830d-59fb-be20-4b48087915f5" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186389267} {:answer/id #uuid "4003098a-783e-5e93-bb25-5f94f36652a5" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186389268} {:answer/id #uuid "1f7e5e40-3f3f-5c2d-abac-4a9137d31956" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186389269}] :answer-field/correct {:answer/id #uuid "4003098a-783e-5e93-bb25-5f94f36652a5" :answer/type {:db/ident :answer.type/text} :answer/value "A pentagon" :db/id #edb/ref 17592186389268} :answer-field/id #uuid "d1250926-eea3-55ee-b530-0094a4347a99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b31d6cdc-6f82-507f-838b-9eddf7b3f11a" :question/math-academy-id "q-162215" :question/problem "![](images/1f/1f550963f047a3860566564abc2cb1e9f3939125895912762ff751767ca55c57.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=2u-v,\\,y=4u-v+2.\n$$\n\nWhat would be the image of the pentagon shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-v \\\\ 4u-v+2\\end{aligned}] \\\\  & =[\\begin{aligned}2u-v \\\\ 4u-v\\end{aligned}]+[\\begin{aligned}0 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 4 & -1\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}2 & -1 \\\\ 4 & -1\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}2 & -1 \\\\ 4 & -1\\end{aligned}| \\\\  & =2\\cdot (-1)-4\\cdot (-1) \\\\  & =2 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible, and the image of the pentagon under the action of $T$ is a pentagon."}] [{:db/id #edb/ref 17592186129534 :knowledge-point/_questions [{:knowledge-point/id #uuid "3337f1e5-3b55-5e56-8003-d80e2a1293c2" :knowledge-point/title "Swapping the Order of Integration by Changing the Projection Type"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2d703e6-4743-5763-af25-20bf0c6a5dd3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{{y}^{2}}^{\\sqrt{y}}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186389271} {:answer/id #uuid "6899558c-7e4c-5da5-a914-cf18f2f7181e" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{y}}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186389272} {:answer/id #uuid "30f7302b-d1a7-5760-a118-699f680c9108" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{1}{\\int }_{0}^{\\sqrt{{x}^{2}+y}}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186389273} {:answer/id #uuid "c2677da7-49ce-541f-9b50-f661e63780a5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{y}}{\\int }_{0}^{\\sqrt{{x}^{2}+y}}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186389274} {:answer/id #uuid "7a3e861e-41d1-5867-9af6-c49dba5bb8d3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{1}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186389275}] :answer-field/correct {:answer/id #uuid "7a3e861e-41d1-5867-9af6-c49dba5bb8d3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{1}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y" :db/id #edb/ref 17592186389275} :answer-field/id #uuid "e5e881a1-cf29-5a9e-9fbe-33a59f952017" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "318d728a-5f9a-5d33-846c-76ae520cec78" :question/math-academy-id "q-162226" :question/problem "![](images/c4/c420d45ca9418fd29889d91a49cce4ae80bb71bdfd4e4aa701b495cc8d87335f.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nRewrite this repeated integral by integrating first with respect to $z,$ then $x,$ and then $y.$" :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le {x}^{2},\\,\\,0\\le z\\le {x}^{2}+y}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nSince both repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(y)}^{{v}_{2}(y)}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/8b/8b7cfa72ed3dbfb121039c6e64b843d83489878a9f457fb1386e455e7d9649ec.png)\n\nThe region $D$ is a type I region in the $xy$-plane:\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le {x}^{2}}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}y\\,\\text{d}x$ to $\\text{d}z\\,\\text{d}x\\,\\text{d}y,$ we write $D$ as a type II region.\n\nNotice that the left boundary of the region, written in the form $x=x(y),$ is \n\n$$\ny={x}^{2}\\,⟹\\,x=\\sqrt{y}\n$$\n\nand the right boundary of the region is\n\n$$\nx=1.\n$$\n\nThen, the type II representation of the region $D$ is\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,\\,\\sqrt{y}\\le x\\le 1},\n$$\n\nas shown below.\n\n![](images/f4/f49af5da2e4f1f281700e16c4659fabfcd0b15661947ca985d38f208f8563877.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{1}{\\int }_{0}^{{x}^{2}+y}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y.\n$$"}] [{:db/id #edb/ref 17592186389276 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25fb5ca3-d3d8-556c-bfbd-18a27abab0d0" :answer/type {:db/ident :answer.type/image} :answer/value "images/c7/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png" :db/id #edb/ref 17592186389278} {:answer/id #uuid "ddc77107-0356-5a3b-87bc-0fc7ca635b61" :answer/type {:db/ident :answer.type/image} :answer/value "images/91/9111f21143412d791b0195722da4f6d461444f386efd9baf609c70a4fe709fd8.png" :db/id #edb/ref 17592186389279} {:answer/id #uuid "34e1b08c-8354-55c3-a97a-4c32cfaf6d5e" :answer/type {:db/ident :answer.type/image} :answer/value "images/ba/bae536e1ec12168c413a6387f3106512173a34d92daae9ad6218040e7336c7ad.png" :db/id #edb/ref 17592186389280} {:answer/id #uuid "fa39b0ed-b99c-5c6b-b5b4-628e084b1f3b" :answer/type {:db/ident :answer.type/image} :answer/value "images/92/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png" :db/id #edb/ref 17592186389281} {:answer/id #uuid "213fcb6f-5b6e-56c4-9475-6d78a1c3d554" :answer/type {:db/ident :answer.type/image} :answer/value "images/e1/e11d63b3127cf3a162223ae7fca5e875e02622ec21480edd3fbc6cdddb039eae.png" :db/id #edb/ref 17592186389282}] :answer-field/correct {:answer/id #uuid "25fb5ca3-d3d8-556c-bfbd-18a27abab0d0" :answer/type {:db/ident :answer.type/image} :answer/value "images/c7/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png" :db/id #edb/ref 17592186389278} :answer-field/id #uuid "ce62dc5a-db8c-574f-9cb2-3491413a4d60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389277}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d172d3ec-37f8-5fb9-8ea7-85c7f30ed514" :question/math-academy-id "q-162239" :question/problem "Which of the following diagrams shows all the $3$rd roots of unity?" :question/worked-solution "Geometrically, the $3$rd roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form an equilateral triangle (regular $3$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](images/c7/c70d25ac3a5ddb2d6765ef8a22f5e9774c9be06dd909d7079c3a361157881bb5.png)"}] [{:db/id #edb/ref 17592186389283 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d450233-f778-5146-bb61-500a2a3edb67" :answer/type {:db/ident :answer.type/image} :answer/value "images/82/82682434de1fe7e9c7f086334f0ef7e0a7b2fde3d64efd7234ea10f1fb6c3b4f.png" :db/id #edb/ref 17592186389285} {:answer/id #uuid "ab2665ec-9150-5288-8394-5f9c6a6cd1c6" :answer/type {:db/ident :answer.type/image} :answer/value "images/92/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png" :db/id #edb/ref 17592186389286} {:answer/id #uuid "0820dca7-deb5-5697-9159-8f0f4f3fcbc1" :answer/type {:db/ident :answer.type/image} :answer/value "images/81/812c019fe97965e1757b9cf76c18439b69f3d8548b3be1b04530ee0b0e1ad4f4.png" :db/id #edb/ref 17592186389287} {:answer/id #uuid "5fbc07a1-e889-568b-82e7-6e63688d1848" :answer/type {:db/ident :answer.type/image} :answer/value "images/bf/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png" :db/id #edb/ref 17592186389288} {:answer/id #uuid "ffe48311-c82e-59ca-9751-9099ff7e1583" :answer/type {:db/ident :answer.type/image} :answer/value "images/0e/0e766db6832d6c8d2ad052f57ffc4f112ec995bd1462fb6a0998abf72c5d2059.png" :db/id #edb/ref 17592186389289}] :answer-field/correct {:answer/id #uuid "5fbc07a1-e889-568b-82e7-6e63688d1848" :answer/type {:db/ident :answer.type/image} :answer/value "images/bf/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png" :db/id #edb/ref 17592186389288} :answer-field/id #uuid "34b0aa03-9887-507d-915d-6585c4342069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389284}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0feb5e9-8cc6-5750-8eab-e0b55e158194" :question/math-academy-id "q-162241" :question/problem "Which of the following diagrams shows all the $5$th roots of unity?" :question/worked-solution "Geometrically, the $5$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular pentagon (regular $5$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](images/bf/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png)"}] [{:db/id #edb/ref 17592186389290 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffddeaa7-a247-54b0-af4b-a29d9bbeee6a" :knowledge-point/title "Finding the Maclaurin Expansion of a Sum of Functions Using Standard Maclaurin Expansions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124f214f-d111-5270-8f5a-99d12cd7c085" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-2{x}^{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389292} {:answer/id #uuid "a3f8991a-ae24-560d-aaad-e0f0da3a2a44" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-\\frac{{x}^{2}}{2}-\\frac{8{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389293} {:answer/id #uuid "a3ffedca-2ff3-52db-bf69-7683ee3d3b9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+4x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389294} {:answer/id #uuid "2557177c-b9c2-5021-9849-d0b2d282ff54" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-2{x}^{2}-\\frac{8{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389295} {:answer/id #uuid "ab5f74b7-8408-5d07-a163-73944c92bf19" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389296}] :answer-field/correct {:answer/id #uuid "ab5f74b7-8408-5d07-a163-73944c92bf19" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯" :db/id #edb/ref 17592186389296} :answer-field/id #uuid "9eadffca-ae05-5f18-bf56-b5c8a1797f1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389291}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a566bf55-85d0-5a70-9fbb-f45650b09aa0" :question/math-academy-id "q-16230" :question/problem "Find the first four non-zero terms of the Maclaurin expansion of $\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x).$" :question/worked-solution "The Maclaurin expansion of $\\operatorname{sin}⁡(x)$ is\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x) & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯.\\end{aligned}\n$$\n\nReplacing $x$ with $2x$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x) & =(2x)-\\frac{(2x)^{3}}{3!}+\\frac{(2x)^{5}}{5!}-⋯ \\\\  & =2x-\\frac{{2}^{3}{x}^{3}}{6}+\\frac{{2}^{5}{x}^{5}}{120}-⋯ \\\\  & =2x-\\frac{4{x}^{3}}{3}+\\frac{4{x}^{5}}{15}-⋯.\\end{aligned}\n$$\n\nThe Maclaurin expansion of $\\operatorname{cos}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =1-\\frac{{x}^{2}}{2!}+\\frac{{x}^{4}}{4!}-⋯.\\end{aligned}\n$$\n\nAdding the expansions for $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(x),$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x) & =(2x-\\frac{4{x}^{3}}{3}+\\frac{4{x}^{5}}{15}-⋯)+(1-\\frac{{x}^{2}}{2!}+\\frac{{x}^{4}}{4!}-⋯) \\\\  & =1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389297 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36267af7-3b1c-53e8-8254-4652eb19b61b" :answer/type {:db/ident :answer.type/image} :answer/value "images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png" :db/id #edb/ref 17592186389299} {:answer/id #uuid "ae188fc3-ca39-5ffc-ab80-585fcf2025f0" :answer/type {:db/ident :answer.type/image} :answer/value "images/73/73ac4fabf63cec9e0639bd2213bf2c4df4030ae0c143e0747ebde469418459d6.png" :db/id #edb/ref 17592186389300} {:answer/id #uuid "c2b96a31-29a9-5690-9d1f-f4a0e63422a3" :answer/type {:db/ident :answer.type/image} :answer/value "images/71/717710d10e5f9919aa44a9e499509e19790e630027693f3dd72d8b2fd7caee2f.png" :db/id #edb/ref 17592186389301} {:answer/id #uuid "a562f990-eae4-516e-aae9-54b81af106e2" :answer/type {:db/ident :answer.type/image} :answer/value "images/40/40af68e4d6e32b333a539fe33dc51ab52a77de3b8db12f930986e468cb033378.png" :db/id #edb/ref 17592186389302} {:answer/id #uuid "b2fc1dee-e469-53cf-9212-2e5f92188e36" :answer/type {:db/ident :answer.type/image} :answer/value "images/ea/ea44776f2632c23a4f52f50282d69492d2948722590ca5dbcaff619ae5079f7e.png" :db/id #edb/ref 17592186389303}] :answer-field/correct {:answer/id #uuid "36267af7-3b1c-53e8-8254-4652eb19b61b" :answer/type {:db/ident :answer.type/image} :answer/value "images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png" :db/id #edb/ref 17592186389299} :answer-field/id #uuid "cb58a3f9-1543-53b6-8d35-b52ef0687fb6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389298}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07999dfb-3631-5698-9dcf-dad1b47402f1" :question/math-academy-id "q-162310" :question/problem "Which of the following diagrams shows all the $8$th roots of unity?" :question/worked-solution "Geometrically, the $8$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular octagon (regular $8$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png)"}] [{:db/id #edb/ref 17592186389304 :knowledge-point/_questions [{:knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8698d81c-07f1-58ee-9dd6-e41a3eaa29dc" :answer/type {:db/ident :answer.type/image} :answer/value "images/59/59cc6771efc546ca0b6ff4fe7b9fd7a1e7794c20240052c3d8e4e29ad114ec8d.png" :db/id #edb/ref 17592186389306} {:answer/id #uuid "07eaee6d-65d6-5afc-9448-c3466e6e1563" :answer/type {:db/ident :answer.type/image} :answer/value "images/d8/d8a917138beb862f6816fc059847659b1ba11e17d6a7a4906309b021baf1d3e5.png" :db/id #edb/ref 17592186389307} {:answer/id #uuid "b0cc1df6-2564-53f0-b5cb-5a4e1d5c3a28" :answer/type {:db/ident :answer.type/image} :answer/value "images/f1/f15f43e3663cfee8328135cb30894c4f268004f4bb74c838cb1bbf2c654c19f9.png" :db/id #edb/ref 17592186389308} {:answer/id #uuid "5834d494-4bff-53e7-8745-4b2b513b127b" :answer/type {:db/ident :answer.type/image} :answer/value "images/b4/b4510002c6e424de6ea16f3037237ea9628b0ddd61f7fa4643d412b66b4fd749.png" :db/id #edb/ref 17592186389309} {:answer/id #uuid "1bf18620-f54f-5e1e-8a0a-daf6f078a0ca" :answer/type {:db/ident :answer.type/image} :answer/value "images/05/0525436f0f1ea9283c783bf590ae6dd58408ba5d5e2e6f69fc83af86e470864d.png" :db/id #edb/ref 17592186389310}] :answer-field/correct {:answer/id #uuid "07eaee6d-65d6-5afc-9448-c3466e6e1563" :answer/type {:db/ident :answer.type/image} :answer/value "images/d8/d8a917138beb862f6816fc059847659b1ba11e17d6a7a4906309b021baf1d3e5.png" :db/id #edb/ref 17592186389307} :answer-field/id #uuid "e17095f8-ba86-50e5-a8b1-f267ffaff592" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389305}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f64f7f30-ad11-543c-8e4a-74267cbdc5a1" :question/math-academy-id "q-162311" :question/problem "Which of the following diagrams shows all the $9$th roots of unity?" :question/worked-solution "Geometrically, the $9$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular nonagon (regular $9$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](images/d8/d8a917138beb862f6816fc059847659b1ba11e17d6a7a4906309b021baf1d3e5.png)"}] [{:db/id #edb/ref 17592186389311 :knowledge-point/_questions [{:knowledge-point/id #uuid "3337f1e5-3b55-5e56-8003-d80e2a1293c2" :knowledge-point/title "Swapping the Order of Integration by Changing the Projection Type"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf649ac9-021b-5cf3-967e-e46b117c455d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{1}^{{x}^{2}}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}+1}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186389313} {:answer/id #uuid "6bbdd1df-810b-58c4-b00e-bc577ae72048" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{1-{x}^{2}}}^{1}{\\int }_{0}^{{x}^{2}+{y}^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186389314} {:answer/id #uuid "80ecd76b-3461-5500-a4b2-54da3c8e1276" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}+1}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186389315} {:answer/id #uuid "15e01ab3-5b29-5e6a-ae77-6fdde2616fc7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186389316} {:answer/id #uuid "6d245728-ca8c-5d14-b882-317505c037bc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{\\int }_{0}^{{x}^{2}+{y}^{2}}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186389317}] :answer-field/correct {:answer/id #uuid "80ecd76b-3461-5500-a4b2-54da3c8e1276" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}+1}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x" :db/id #edb/ref 17592186389315} :answer-field/id #uuid "0507eef8-6716-508b-a842-3c8bdf5c1848" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389312}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b94d854-420e-5d57-988d-2367c6e7514b" :question/math-academy-id "q-162376" :question/problem "![](images/c7/c72489a2d33a181fe7bc07d5cc017b93daccac51889cbb61edd64d4ee34429df.png)\n\nThe triple integral of $f(x,y,z)$ over the region $R$ (shown above) can be expressed as the following repeated integral:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{y}^{2}}}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}+1}f(x,y,z)\\,\\text{d}z\\,\\text{d}x\\,\\text{d}y\n$$\n\nRewrite this repeated integral by integrating first with respect to $z,$ then $y,$ and then $x.$" :question/worked-solution "From the given repeated integral, we see that $R$ can be written as a type I region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le \\sqrt{1-{y}^{2}},\\,\\,0\\le z\\le \\sqrt{1-{x}^{2}-{y}^{2}}+1}\n$$\n\nWe wish to rewrite our triple integral as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nSince both repeated integrals first integrate with respect to $z,$ the $z$-limits remain the same as before:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{{v}_{1}(x)}^{{v}_{2}(x)}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}+1}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x\n$$\n\nNow, we consider the projection $D$ of $R$ onto the $xy$-plane shown below.\n\n![](images/98/98aa4c0a436e4649ccd3d48a53fbf94b0341bf30b95745c4d052381680d223cf.png)\n\nThe region $D$ is a type II region in the $xy$-plane:\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,\\,0\\le x\\le \\sqrt{1-{y}^{2}}}\n$$\n\nTo change the order of integration from $\\text{d}z\\,\\text{d}x\\,\\text{d}y$ to $\\text{d}z\\,\\text{d}y\\,\\text{d}x,$ we write $D$ as a type I region.\n\nNotice that the top boundary of the region, written in the form $y=y(x),$ is \n\n$$\nx=\\sqrt{1-{y}^{2}}\\,⟹\\,y=\\sqrt{1-{x}^{2}}\n$$\n\nand the bottom boundary of the region is\n\n$$\ny=0.\n$$\n\nThen, the type I representation of the region $D$ is\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le \\sqrt{1-{x}^{2}}},\n$$\n\nas shown below.\n\n![](images/47/47380c108c5b271761de2a027399bbd5981f2a9bdff21e498d73d0b430d070c7.png)\n\nTherefore, by swapping the order of integration, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-{x}^{2}}}{\\int }_{0}^{\\sqrt{1-{x}^{2}-{y}^{2}}+1}f(x,y,z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x.\n$$"}] [{:db/id #edb/ref 17592186389318 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e87509d-95fe-5804-a94b-d42ada81e4f7" :knowledge-point/title "Swapping the Order of Integration in a Triple Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c5e2e70-5ffa-5c48-a5cf-9bd5f4ffb5b4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{x}}{\\int }_{x}^{\\sqrt{2}}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/id #edb/ref 17592186389320} {:answer/id #uuid "e136e6ca-8d75-50a6-9664-a3d5830c5e29" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{\\sqrt{x}}^{\\sqrt{2}}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/id #edb/ref 17592186389321} {:answer/id #uuid "0837eb35-ebdb-50c1-9d92-be1ddf3921a7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{x}^{2x}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/id #edb/ref 17592186389322} {:answer/id #uuid "d90b8422-367f-5c2d-b6fb-5dc1070a4abf" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{x}{\\int }_{\\sqrt{x}}^{2}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/id #edb/ref 17592186389323} {:answer/id #uuid "da9edb52-0e0d-543b-9acd-c645e0bc8406" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{\\sqrt{x}}^{2}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/id #edb/ref 17592186389324}] :answer-field/correct {:answer/id #uuid "e136e6ca-8d75-50a6-9664-a3d5830c5e29" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{\\sqrt{x}}^{\\sqrt{2}}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/id #edb/ref 17592186389321} :answer-field/id #uuid "3e206289-9f04-516a-8774-93cf7cecd07e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389319}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51e3e7e7-44a6-54ed-a3c2-de6f58c215e2" :question/math-academy-id "q-162489" :question/problem "![](images/7c/7c959b9c517b17d9427de450def510b9673d91fd951e28696d4d56d8a768b74d.png)\n\nChange the order of integration in the integral\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{2}}{\\int }_{0}^{{y}^{2}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z.\n$$\n\nso that it is integrated first with respect to $y,$ then $x,$ and then $z.$ The integration region $R$ is shown above." :question/worked-solution "We wish to find limits of integration ${u}_{1}(x,z),$ ${u}_{2}(x,z),$ ${v}_{1}(z),$ ${v}_{2}(z),$ $a,$ and $b$ such that\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{2}}{\\int }_{0}^{{y}^{2}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z={\\int }_{a}^{b}{\\int }_{{v}_{1}(z)}^{{v}_{2}(z)}{\\int }_{{u}_{1}(x,z)}^{{u}_{2}(x,z)}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z.\n$$\n\nFrom the repeated integral, we see that the region of integration $R$ can be written as a type II region as follows:\n\n$$\nR={(x,y,z)\\,:\\,0\\le z\\le 1,\\,\\,0\\le y\\le \\sqrt{2},\\,\\,0\\le x\\le {y}^{2}}\n$$\n\nTo change the order of integration from $\\text{d}x\\,\\text{d}y\\,\\text{d}z$ to $\\text{d}y\\,\\text{d}x\\,\\text{d}z,$ we write $R$ as a type III region and its projection $D$ onto the $xz$-plane as a type II *plane* region.\n\nTo visualize this, imagine firing an arrow through the region parallel to the $y$-axis and in the direction of increasing $y,$ as shown below.\n\n![](images/c3/c3837a3551b35a5146fd2c8e2441e4a9d6d947e8c52e44254d48eb854e54e605.png)\n\nThe arrow enters the region through the left boundary and leaves through the right boundary:\n\n- The left boundary of the region, written in the form $y=y(x,z),$ is\n\n$$\nx={y}^{2}\\,⟹\\,y=\\sqrt{x}.\n$$\n\n- The right boundary of the region is\n\n$$\ny=\\sqrt{2}.\n$$\n\nTherefore, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,\\sqrt{x}\\le y\\le \\sqrt{2}},\n$$\n\nas shown in the diagram below.\n\n![](images/22/22581a56f4d9cb611bd9a58b06b1036cd47b500217570ae6890d0f38dba6742c.png)\n\nWe now consider the projection $D$ as a type II plane region in the $xz$-plane with the right curve given by \n\n$$\n{\\begin{aligned}y=\\sqrt{x} \\\\ y=\\sqrt{2}\\end{aligned}\\,⟹\\,\\sqrt{x}=\\sqrt{2}\\,⟹\\,x=2.\n$$\n\n![](images/e2/e2305d3da63886703666fd58a2adfe8f15f2eceb7261922f46ba4949b0fc0cde.png)\n\nHence, we have that\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1}.\n$$\n\nTherefore, by swapping the order of integration so that it is integrated first with respect to $y,$ then $x,$ then $z,$ we obtain\n\n$$\n{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{2}}{\\int }_{0}^{{y}^{2}}f(x,y,z)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{\\sqrt{x}}^{\\sqrt{2}}f(x,y,z)\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z.\n$$"}] [{:db/id #edb/ref 17592186389325 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7abceeb-620d-5e95-93ca-30bc557cf007" :knowledge-point/title "Constructing a Vector Field From Its Stream Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b30b0f5f-97bd-583a-a307-e3397fb59a93" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(-2y+2)\\,i-2x\\,j" :db/id #edb/ref 17592186389327} {:answer/id #uuid "329fb401-7f68-5ec6-8f25-98f6ed849d0c" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(2y-2)\\,i-4x\\,j" :db/id #edb/ref 17592186389328} {:answer/id #uuid "8f39913b-20f7-5b49-bfad-b41649dde17e" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=2xy\\,i-2x\\,j" :db/id #edb/ref 17592186389329} {:answer/id #uuid "0a193adf-d260-5b1e-b6a6-38f14c829c51" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=y\\,i+2x\\,j" :db/id #edb/ref 17592186389330} {:answer/id #uuid "3ce39ff5-c2b6-5f45-bc52-6fcb1efcfc46" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=-2y\\,i-(2x-2)\\,j" :db/id #edb/ref 17592186389331}] :answer-field/correct {:answer/id #uuid "3ce39ff5-c2b6-5f45-bc52-6fcb1efcfc46" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=-2y\\,i-(2x-2)\\,j" :db/id #edb/ref 17592186389331} :answer-field/id #uuid "db983459-2780-56ca-9561-aa9eaaa313f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389326}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44bb9bca-3844-5057-9f71-7974dba4c933" :question/math-academy-id "q-162504" :question/problem "Construct the vector field that has the stream function $ψ(x,y)={x}^{2}-2x-{y}^{2}+1.$" :question/worked-solution "A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if the following equations hold:\n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}\n$$\n\nComputing the partial derivatives of the function $ψ(x,y),$ we have\n\n$$\n\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\  & =\\frac{∂}{∂y}({x}^{2}-2x-{y}^{2}+1) \\\\  & =-2y, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\  & =-\\frac{∂}{∂x}({x}^{2}-2x-{y}^{2}+1) \\\\  & =-2x+2.\\end{aligned}\n$$\n\nTherefore, the vector field with the stream function $ψ(x,y)={x}^{2}-2x-{y}^{2}+1$ is\n\n$$\n\\begin{aligned}F(x,y) & =P\\,i+Q\\,j \\\\  & =-2y\\,i-(2x-2)\\,j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389332 :knowledge-point/_questions [{:knowledge-point/id #uuid "b7abceeb-620d-5e95-93ca-30bc557cf007" :knowledge-point/title "Constructing a Vector Field From Its Stream Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "650f7b08-bfd6-5c2c-bec5-476c49332af1" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(5x{y}^{2}-xy)\\,i-(5{x}^{3}+3{y}^{2}-y)\\,j" :db/id #edb/ref 17592186389334} {:answer/id #uuid "914cb7f4-06c3-5620-8b1f-a5e8ed515d2b" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(15x{y}^{2}-x)\\,i-(5{y}^{3}-3{x}^{2}-y)\\,j" :db/id #edb/ref 17592186389335} {:answer/id #uuid "c1f8a410-e48f-5314-b3a2-9ef6d48ff12e" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(15{y}^{2}-x)\\,i-(5{y}^{3}+3{x}^{2})\\,j" :db/id #edb/ref 17592186389336} {:answer/id #uuid "70c29385-9850-5254-9ec6-162ae3af2506" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=5x{y}^{2}\\,i-(5{y}^{3}+3{x}^{2}-y)\\,j" :db/id #edb/ref 17592186389337} {:answer/id #uuid "e7fe5b53-4ca1-54d7-9895-0e3672329dbe" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(5x{y}^{2}-x)\\,i-(5{y}^{3}-y)\\,j" :db/id #edb/ref 17592186389338}] :answer-field/correct {:answer/id #uuid "914cb7f4-06c3-5620-8b1f-a5e8ed515d2b" :answer/type {:db/ident :answer.type/math} :answer/value "F(x,y)=(15x{y}^{2}-x)\\,i-(5{y}^{3}-3{x}^{2}-y)\\,j" :db/id #edb/ref 17592186389335} :answer-field/id #uuid "9692a0d2-3cc0-58cd-84e1-4dba68de9887" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389333}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "acd27a04-e10f-58dd-b26e-c84cd03b0423" :question/math-academy-id "q-162512" :question/problem "Construct the vector field that has the stream function $ψ(x,y)=5{y}^{3}x-{x}^{3}-xy.$" :question/worked-solution "A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if the following equations hold:\n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}\n$$\n\nComputing the partial derivatives of the function $ψ(x,y),$ we have\n\n$$\n\\begin{aligned}P & =\\frac{∂ψ}{∂y} \\\\  & =\\frac{∂}{∂y}(5{y}^{3}x-{x}^{3}-xy) \\\\  & =15x{y}^{2}-x, \\\\ Q & =-\\frac{∂ψ}{∂x} \\\\  & =-\\frac{∂}{∂x}(5{y}^{3}x-{x}^{3}-xy) \\\\  & =-(5{y}^{3}-3{x}^{2}-y).\\end{aligned}\n$$\n\nTherefore, the vector field with the stream function $ψ(x,y)=5{y}^{3}x-{x}^{3}-xy$ is\n\n$$\n\\begin{aligned}F(x,y) & =P\\,i+Q\\,j \\\\  & =(15x{y}^{2}-x)\\,i-(5{y}^{3}-3{x}^{2}-y)\\,j.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115521 :knowledge-point/_questions [{:knowledge-point/id #uuid "74a1499c-080d-5008-bcc3-492ef469d3dc" :knowledge-point/title "Domains of Functions With Exponential and Logarithmic Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed24ecfc-29fd-5287-8375-b97afb7a1ad9" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (1,\\infty )" :db/id #edb/ref 17592186389340} {:answer/id #uuid "7e9431db-9aa7-5e0a-8e08-1ab991e0068f" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186389341} {:answer/id #uuid "c9c05318-56c4-5ed1-bd19-90eb05aa5fd9" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,1)" :db/id #edb/ref 17592186389342} {:answer/id #uuid "593851d7-7a77-51d3-a640-4a7a63ee05cb" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,-1)" :db/id #edb/ref 17592186389343} {:answer/id #uuid "7bab972e-0930-5dc4-b4ee-926d2ac18fbc" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186389344}] :answer-field/correct {:answer/id #uuid "7e9431db-9aa7-5e0a-8e08-1ab991e0068f" :answer/type {:db/ident :answer.type/math} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186389341} :answer-field/id #uuid "2e8d4565-bdfe-5e4a-bfbd-afe9b3d061b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389339}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcba3294-52b7-5583-82be-6a59e3e8bdd4" :question/math-academy-id "q-162523" :question/problem "Find the domain of the vector-valued function $f(t)=2\\,i+{t}^{2}\\,j+\\operatorname{ln}⁡(t+1)\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $2$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component ${t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{ln}⁡(t+1)$ is $t\\in (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/44/44e047a975ee3b2ad7966b95bbba3a6270925f451c8cb8c6dac6dbef532f2b7a.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-1,\\infty ).$"}] [{:db/id #edb/ref 17592186389345 :knowledge-point/_questions [{:knowledge-point/id #uuid "f30cae81-5bda-52dc-8de4-9ad5fd587e48" :knowledge-point/title "Finding Streamlines of Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc9bdb8d-ad2b-5d91-86ca-825ec11037fa" :answer/type {:db/ident :answer.type/image} :answer/value "images/6a/6a1ce9b96f0bca4ec14e7ce60e5cebd72efc4421acfd4a65ba55e9c8a7d1d352.png" :db/id #edb/ref 17592186389347} {:answer/id #uuid "678a4e30-3832-553e-8ea1-b4ab930f1cd6" :answer/type {:db/ident :answer.type/image} :answer/value "images/07/0799c425e6b33f2be8f115d7d0de9e5607bdef9f094a02381fc5197839d80d75.png" :db/id #edb/ref 17592186389348} {:answer/id #uuid "6db4de8e-dbc7-51ee-8ae9-5b089f44fbf6" :answer/type {:db/ident :answer.type/image} :answer/value "images/95/95fee99b51dc07130717569fcb90ab5e210bf2cc64811f536dc493e9c3e1588e.png" :db/id #edb/ref 17592186389349} {:answer/id #uuid "92bd4bba-9b1d-550f-a3d8-850c5ca8fd4d" :answer/type {:db/ident :answer.type/image} :answer/value "images/3a/3a3ef451c7e25ff33fb1820d5b8c98e10038c4ee058f627d93acf72989b7b794.png" :db/id #edb/ref 17592186389350} {:answer/id #uuid "1bc3c2dd-f56c-5123-bcfe-941b923629fb" :answer/type {:db/ident :answer.type/image} :answer/value "images/fb/fb7119466ac4f884fca55cfb3fc0b487703249050211ff922549a702a047bb39.png" :db/id #edb/ref 17592186389351}] :answer-field/correct {:answer/id #uuid "92bd4bba-9b1d-550f-a3d8-850c5ca8fd4d" :answer/type {:db/ident :answer.type/image} :answer/value "images/3a/3a3ef451c7e25ff33fb1820d5b8c98e10038c4ee058f627d93acf72989b7b794.png" :db/id #edb/ref 17592186389350} :answer-field/id #uuid "ce55e1ed-b422-5201-909f-65fba9887b50" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389346}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6b93df85-0b3c-5ded-8201-a97d95285f56" :question/math-academy-id "q-162629" :question/problem "Which of the following represents the streamlines of the vector field $F(x,y)=2xi-2y\\,j$ over the domain $D={R}^{2}.$" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that \n\n$$\nF(x,y)=2xi-2y\\,j\n$$\n\n is a vector field with simply connected domain $D,$ where $P(x,y)=2x$ and $Q(x,y)=-2y.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2,\\,\\frac{∂Q}{∂y} & =-2.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=2-2=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}=2x,\\,\\frac{∂ψ}{∂x}=2y.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)=2xy+f(x),\\,ψ(x,y)=2xy+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f=g=0,$ we have\n\n$$\nψ(x,y)=2xy.\n$$\n\nFinally, we find the level curves of the stream function $ψ(x,y)=2xy$ given by the equations $ψ(x,y)=c.$\n\nNotice that the range of $ψ(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$ So, we have:\n\n$$\n\\begin{aligned}ψ(x,y) & =c \\\\ 2xy & =c \\\\ y & =\\frac{c}{x}\\end{aligned}\n$$\n\nThe equation above gives us a family of hyperbolas with asymptotes $y=0$ and $x=0$ and, for $c=0,$ the lines $y=0$ and $x=0.$ Therefore, the correct graph (along with the vector field $F$) is as follows:\n\n![](images/24/24c6dadd4f980121a36929a9cdb800f7da8fac8eb84af40d595af89aa77b11ea.png)"}] [{:db/id #edb/ref 17592186389352 :knowledge-point/_questions [{:knowledge-point/id #uuid "f30cae81-5bda-52dc-8de4-9ad5fd587e48" :knowledge-point/title "Finding Streamlines of Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9a4a14-a956-5391-ac3a-4943156bef2b" :answer/type {:db/ident :answer.type/image} :answer/value "images/32/3296bdd0ae6e92949ee3728e01592f1758917cf03446e75317af341ef669f606.png" :db/id #edb/ref 17592186389354} {:answer/id #uuid "abbaeebd-0469-5172-b7c3-8cb76cac7c91" :answer/type {:db/ident :answer.type/image} :answer/value "images/c9/c9ba45e905fc98c5011727c483ba444088c81a0423cc85912af24e1e8c19f1cc.png" :db/id #edb/ref 17592186389355} {:answer/id #uuid "e67f9b71-0c0d-5761-ba3f-d60318d3579b" :answer/type {:db/ident :answer.type/image} :answer/value "images/75/7585305cff504d86c4b910455acb21036503bdc0073989ca8351a751f1fea9b8.png" :db/id #edb/ref 17592186389356} {:answer/id #uuid "a8aac5dd-ff50-5af5-a307-0a9ee9b5c0d6" :answer/type {:db/ident :answer.type/image} :answer/value "images/ff/ff6709c054d8c1e3cd21bbe87e7326f802471fa321a90346e3f173f72b443896.png" :db/id #edb/ref 17592186389357} {:answer/id #uuid "9ff7114c-d67e-5f98-a63a-d5f5e37f4d12" :answer/type {:db/ident :answer.type/image} :answer/value "images/f6/f6926d3f6d26fe712b53e53c06af440575dbe858e373cfae5d7d4b5017f44b93.png" :db/id #edb/ref 17592186389358}] :answer-field/correct {:answer/id #uuid "abbaeebd-0469-5172-b7c3-8cb76cac7c91" :answer/type {:db/ident :answer.type/image} :answer/value "images/c9/c9ba45e905fc98c5011727c483ba444088c81a0423cc85912af24e1e8c19f1cc.png" :db/id #edb/ref 17592186389355} :answer-field/id #uuid "f9db8e2f-b628-5684-b658-6125f7acf877" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389353}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bc28542a-a43a-5f01-b243-0063900eefa8" :question/math-academy-id "q-162630" :question/problem "Which of the following represents the streamlines of the vector field $F(x,y)=2y\\,i+2x\\,j$ over the domain $D={R}^{2}.$" :question/worked-solution "The streamlines of a vector field are the level curves of its stream function and are tangential to the vector field at every point. \n\nIf $F$ represents the velocity field of a fluid flow, then they show the path traced out by a massless particle as it moves with the flow.\n\nA vector field $F=P\\,i+Q\\,j$ with a simply connected domain $D⊆{R}^{2}$ has a stream function $ψ(x,y)$ if and only if\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNote that \n\n$$\nF(x,y)=2y\\,i+2x\\,j\n$$\n\n is a vector field with simply connected domain $D,$ where $P(x,y)=0$ and $Q(x,y)=0.$ Computing the partial derivatives, we have\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=0,\\,\\frac{∂Q}{∂y} & =0.\\end{aligned}\n$$\n\nHence, $F$ has a stream function, since\n\n$$\n\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}=0.\n$$\n\nNext, we find a stream function. A function $ψ(x,y)$ is a stream function of the vector field $F=P\\,i+Q\\,j$ if \n\n$$\nP=\\frac{∂ψ}{∂y},\\,Q=-\\frac{∂ψ}{∂x}.\n$$\n\nIn our case, we have\n\n$$\n\\frac{∂ψ}{∂y}=2y,\\,\\frac{∂ψ}{∂x}=-2x.\n$$\n\nIntegrating these equations, we obtain the following:\n\n$$\nψ(x,y)={y}^{2}+f(x),\\,ψ(x,y)=-{x}^{2}+g(y)\n$$\n\nwhere $f$ and $g$ are arbitrary functions. Finally, setting $f(x)=-{x}^{2}$ or $g(y)={y}^{2},$ we have\n\n$$\nψ(x,y)={y}^{2}-{x}^{2}.\n$$\n\nFinally, we find the level curves of the stream function $ψ(x,y)={y}^{2}-{x}^{2}$ given by the equations $ψ(x,y)=c.$\n\nNotice that the range of $ψ(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider level curves for any value of $c.$ So, we have:\n\n$$\n\\begin{aligned}ψ(x,y) & =c \\\\ {y}^{2}-{x}^{2} & =c\\end{aligned}\n$$\n\nThe equation above gives us a family of hyperbolas with asymptotes $y=x$ and $x=-x$ and, for $c=0,$ the lines $y=x$ and $y=-x.$ Therefore, the correct graph (along with the vector field $F$) is as follows:\n\n![](images/9b/9b0d2f98a0b71beb773b802908f01691924492a5f3abff3db75be4a0ae458e7d.png)"}] [{:db/id #edb/ref 17592186124820 :knowledge-point/_questions [{:knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d08bb1b-22c1-5994-86ce-697355d9d5b8" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $D$ only" :db/id #edb/ref 17592186121488} {:answer/id #uuid "176e41a7-608c-52b7-a36d-29ecd3857c43" :answer/type {:db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186121489} {:answer/id #uuid "1b849bf1-aca3-5500-815a-f40453b5ee74" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186121490} {:answer/id #uuid "433c083a-6dc5-5054-a669-603ea27d72af" :answer/type {:db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186121491} {:answer/id #uuid "67771eb8-4b20-550f-a702-ea3bc2c1b29f" :answer/type {:db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186121492}] :answer-field/id #uuid "51d1f568-ebd7-5909-9b1b-31baaaef0c6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121487}] :question/id #uuid "0151a70d-ce12-5172-8abb-638426f2b102" :question/math-academy-id "q-162747" :question/problem "![](images/b6/b698fe735caaf3bc260c1e921bb95596df8869eba67ec9ce72484b4d86cc8c69.png)\n\nThe graph of the function $z = f(x, y)$ is shown above. Which of the points shown are local minimum points?"}] [{:db/id #edb/ref 17592186389359 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5328ab3-440f-5cc8-9b8f-e7f86a4dd740" :knowledge-point/title "Finding the Extreme Values of a Constrained Three-Variable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1eb3c8c-d331-5a72-ac1b-7be6eb81ce1a" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186389361} {:answer/id #uuid "14255645-0275-58dc-b28d-c47144e1e6bb" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186389362} {:answer/id #uuid "e56147aa-3e0a-5715-aa08-ae2704dbb3e4" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186389363} {:answer/id #uuid "049de862-9659-53e6-b16b-42ecea6c8633" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186389364} {:answer/id #uuid "58398273-c005-523c-9531-fdb7a1bfa71e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186389365}] :answer-field/correct {:answer/id #uuid "58398273-c005-523c-9531-fdb7a1bfa71e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186389365} :answer-field/id #uuid "00bcd47c-8000-5740-a445-976aea96246e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8333348a-cac7-59f1-bb18-cd3fc05b1968" :question/math-academy-id "q-162771" :question/problem "Use the method of Lagrange multipliers to find the minimum value of the function $f(x,y,z)=(x-2)^{2}+(y-1)^{2}+(z-2)^{2}$ on the sphere ${x}^{2}+{y}^{2}+{z}^{2}=9.$" :question/worked-solution "We need to find the minimum value of $f$ subject to the constraint $g(x,y,z)={x}^{2}+{y}^{2}+{z}^{2}=9.$ \n\nSince $f(x,y,z)$ is continuous and the constraint is closed and bounded, $f(x,y,z)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y,z)=\\lambda ∇g(x,y,z),\\,g(x,y,z)=9\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z) \\\\ ⟨{f}_{x}(x,y,z),{f}_{y}(x,y,z),{f}_{z}(x,y,z)⟩ & =\\lambda ⟨{g}_{x}(x,y,z),{g}_{y}(x,y,z),{g}_{z}(x,y,z)⟩ \\\\ ⟨2(x-2),2(y-1),2(z-2)⟩ & =\\lambda ⟨2x,2y,2z⟩ \\\\ ⟨x-2,y-1,z-2⟩ & =\\lambda ⟨x,y,z⟩\\end{aligned}\n$$\n\nNotice that we cannot have $\\lambda =1$ since this leads to a contradiction in the above equation. Therefore, assuming $\\lambda \\ne 1,$ we have the following:\n\n$$\n{\\begin{aligned}x-2=\\lambda x \\\\ y-1=\\lambda y \\\\ z-2=\\lambda z\\end{aligned}\\,⇒\\,{\\begin{aligned}x=\\frac{2}{1-\\lambda } \\\\ y=\\frac{1}{1-\\lambda } \\\\ z=\\frac{2}{1-\\lambda }\\end{aligned}\n$$\n\nNext, we substitute our expressions for $x,\\,y$ and $z$ into the condition $g(x,y,z)=9$ and solve for $\\lambda ,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2} & =9 \\\\ \\frac{4}{(1-\\lambda )^{2}}+\\frac{1}{(1-\\lambda )^{2}}+\\frac{4}{(1-\\lambda )^{2}} & =9 \\\\ \\frac{9}{(1-\\lambda )^{2}} & =9 \\\\ (1-\\lambda )^{2} & =1 \\\\ 1-\\lambda  & =\\pm 1 \\\\ \\lambda  & =1\\pm 1 \\\\ \\lambda  & =0,\\,2\\end{aligned}\n$$\n\n- For $\\lambda =0,$ we get the critical point $(2,1,2).$\n\n- For $\\lambda =2,$ we get the critical point $(-2,-1,-2).$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $\\,(x,y,z)\\,$ | $\\,(-2,-1,-2)\\,$ | $\\,(2,1,2)\\,$ |\n| --- | --- | --- |\n| $\\,f(x,y,z)\\,$ | $\\,36\\,$ | $\\,0\\,$ |\n\n$$\n\n$$\n\nTherefore, the function reaches a minimum value at the points $(2,1,2),$ and its minimum value is $0.$"}] [{:db/id #edb/ref 17592186389366 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffdd4f56-003d-5eed-a60d-ba51c4c86b51" :knowledge-point/title "Finding Extreme Values: Cases With Inner Critical Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4733a3dd-e23c-5c44-a89f-742c3f778029" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186389368} {:answer/id #uuid "88e50d0f-e873-5eb6-8df9-c6576dfee96e" :answer/type {:db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186389369} {:answer/id #uuid "af614f6a-7d1a-5c02-b853-cbc404a8abf1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186389370} {:answer/id #uuid "ab93d64e-a39e-5c1d-a6e2-ae62934b68a1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{23}{3}" :db/id #edb/ref 17592186389371} {:answer/id #uuid "d5db156c-c947-5d50-8157-91edc1a6189c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186389372}] :answer-field/correct {:answer/id #uuid "d5db156c-c947-5d50-8157-91edc1a6189c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186389372} :answer-field/id #uuid "99385998-af51-5830-b0cc-4d03c327bc9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389367}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0ad6e6a-85b2-5b87-87b2-edb5a819eb6e" :question/math-academy-id "q-162789" :question/problem "Use the method of Lagrange multipliers to find the minimum value of the function $f(x,y)={x}^{2}+{y}^{2}-2y$ given that ${x}^{2}-{y}^{2}\\le 9.$" :question/worked-solution "First, we need to find the critical values of the function in the region's interior. We compute the critical points by solving $∇f=0,$ as follows:\n\n$$\n\\begin{aligned}⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =⟨0,0⟩ \\\\ ⟨2x,2y-2⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nThe above equation has the solution $(x,y)=(0,1).$ This point belongs to our region.\n\nNext, we need to find the minimum value of $f(x,y)$ subject to the constraint $g(x,y)={x}^{2}-{y}^{2}=9.$ Therefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n∇f(x,y)=\\lambda ∇g(x,y),\\,g(x,y)=9\n$$\n\nWe start by solving the first equation:\n\n$$\n\\begin{aligned}∇f(x,y) & =\\lambda ∇g(x,y,) \\\\ ⟨{f}_{x}(x,y),{f}_{y}(x,y)⟩ & =\\lambda ⟨{g}_{x}(x,y),{g}_{y}(x,y)⟩ \\\\ ⟨2x,2y-2⟩ & =\\lambda ⟨2x,-2y⟩\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}{\\begin{aligned}2x=2\\lambda x \\\\ 2y-2=-2\\lambda y\\end{aligned}\\,⇒\\,{\\begin{aligned}x(\\lambda -1)=0 \\\\ y(\\lambda +1)=1\\end{aligned}\\end{aligned}\n$$\n\nTo solve this system, we break it up into several cases:\n\n- Assuming $x=0$ in the first equation of the system, the constraint condition $g(x,y)=9$ implies\n\n$$\n\\begin{aligned}-{y}^{2} & =9.\\end{aligned}\n$$\n\nSo, this doesn't give any critical point.\n\n- Assuming $\\lambda =1$ in the first equation of the system, the second equation gives $y=\\frac{1}{2},$ and the constraint condition $g(x,y)=9$ implies\n\n$$\n\\begin{aligned}{x}^{2}-\\frac{1}{4} & =9\\,⇒\\,x=\\pm \\frac{\\sqrt{37}}{2},\\end{aligned}\n$$\n\nThis gives the critical points $(\\pm \\frac{\\sqrt{37}}{2},\\frac{1}{2}).$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(0,1),\\,(\\pm \\frac{\\sqrt{37}}{2},\\frac{1}{2}).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y)$ | $(0,1)$ | $(\\frac{\\pm \\sqrt{37}}{2},\\frac{1}{2})$ |\n| --- | --- | --- |\n| $f(x,y)$ | $-1$ | $\\frac{17}{2}$ |\n\nTherefore, the function reaches a minimum value at $(0,1),$ and its minimum value is $-1.$"}] [{:db/id #edb/ref 17592186389373 :knowledge-point/_questions [{:knowledge-point/id #uuid "496fa617-6592-57af-89ac-b77d68df0bb3" :knowledge-point/title "Solving a Lagrange System With Two Constraints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee41277-7935-51f1-85bc-15927e8fe4f8" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186389375} {:answer/id #uuid "174eadcd-7d74-5372-a6ec-7880566d72a8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186389376} {:answer/id #uuid "6962c134-0174-5b89-8601-d57405b065ab" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186389377} {:answer/id #uuid "ef9dabf2-ce85-58ec-937f-7e2a0a8245d2" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186389378} {:answer/id #uuid "9ed5aec2-6866-596e-9035-82e42640cccb" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186389379}] :answer-field/correct {:answer/id #uuid "174eadcd-7d74-5372-a6ec-7880566d72a8" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186389376} :answer-field/id #uuid "9c3e28af-f22d-50e3-abe7-b3442baab90b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389374}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "27d6b0fc-4f5c-5b3d-9ebf-da8e41d423eb" :question/math-academy-id "q-162820" :question/problem "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y,z)=4x+y-z$ on the intersection of the plane $y-z=1$ and the cylinder ${x}^{2}+{z}^{2}=4.$" :question/worked-solution "We need to find the maximum value of \n\n$$\nf(x,y,z)=4x+y-z\n$$\n\nsubject to the constraints \n\n$$\ng(x,y,z)=y-z=1,\\,h(x,y,z)={x}^{2}+{z}^{2}=4.\n$$\n\nSince $f(x,y,z)$ is continuous and the constraint is closed and bounded, $f(x,y,z)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=1 \\\\ h(x,y,z)=4\\end{aligned}\n$$\n\nWe start by expanding the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨4,1,-1⟩ & =\\lambda ⟨0,1,-1⟩+\\mu ⟨2x,0,2z⟩\\end{aligned}\n$$\n\nTherefore, we have the following system:\n\n$$\n\\begin{aligned}{\\begin{aligned}4=2\\mu x \\\\ 1=\\lambda  \\\\ -1=-\\lambda +2\\mu z\\end{aligned}\\,⇒\\,{\\begin{aligned}x=\\frac{2}{\\mu } \\\\ \\lambda =1 \\\\ \\mu z=0\\end{aligned}\\end{aligned}\n$$\n\nNotice that $\\mu $ can't be zero since this leads to a contradiction. So, from the third equation above, we must have $z=0.$\n\nNext, we substitute $z=0$ into the first constraint:\n\n$$\n\\begin{aligned}y-z & =1 \\\\ y-0 & =1 \\\\ y & =1.\\end{aligned}\n$$\n\nFinally, we substitute  $z=0$ into the second constraint:\n\n$$\n\\begin{aligned}{x}^{2}+{z}^{2} & =4 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\n \n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(2,1,0),\\,(-2,1,0).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y,z)$ | $(2,1,0)$ | $(-2,1,0)$ |\n| --- | --- | --- |\n| $f(x,y,z)$ | $9$ | $-7$ |\n\nTherefore, the function reaches a maximum value at $(2,1,0),$ and its maximum value is $9.$"}] [{:db/id #edb/ref 17592186389380 :knowledge-point/_questions [{:knowledge-point/id #uuid "496fa617-6592-57af-89ac-b77d68df0bb3" :knowledge-point/title "Solving a Lagrange System With Two Constraints"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c913e3-a5b7-538a-afbd-1307a15a3578" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186389382} {:answer/id #uuid "81a4450b-87b0-59da-a1ef-6435ca5d90ae" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186389383} {:answer/id #uuid "e149b12c-7b25-524b-8729-94f1850ecae0" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186389384} {:answer/id #uuid "eca24669-e860-58d9-b281-a8dfd9fad322" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186389385} {:answer/id #uuid "523a518d-0d02-5bce-83db-dc2c0add9e99" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186389386}] :answer-field/correct {:answer/id #uuid "eca24669-e860-58d9-b281-a8dfd9fad322" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186389385} :answer-field/id #uuid "b6f75c73-bd47-59c3-b998-8d2856225676" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389381}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b173a456-6d61-587a-a9bf-4d48c28e2049" :question/math-academy-id "q-162831" :question/problem "Use the method of Lagrange multipliers to find the maximum value of the function $f(x,y,z)=2x+3y+2z$ on the intersection of the plane $2x-y-z=-1$ and the cylinder ${y}^{2}+{z}^{2}=1.$" :question/worked-solution "We need to find the maximum value of \n\n$$\nf(x,y,z)=2x+3y+2z\n$$\n\nsubject to the constraints  \n\n$$\ng(x,y,z)=2x-y-z=-1,\\,h(x,y,z)={y}^{2}+{z}^{2}=1.\n$$\n\nSince $f(x,y,z)$ is continuous and the constraint is closed and bounded, $f(x,y,z)$ reaches a global maximum and a global minimum on the constraint. \n\nTherefore, by the method of Lagrange multipliers, we must solve the following system:\n\n$$\n{\\begin{aligned}∇f(x,y,z)=\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ g(x,y,z)=-1 \\\\ h(x,y,z)=1\\end{aligned}\n$$\n\nWe start by expanding the first equation:\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\lambda ∇g(x,y,z)+\\mu ∇h(x,y,z) \\\\ ⟨{f}_{x},{f}_{y},{f}_{z}⟩ & =\\lambda ⟨{g}_{x},{g}_{y},{g}_{z}⟩+\\mu ⟨{h}_{x},{h}_{y},{h}_{z}⟩ \\\\ ⟨2,3,2⟩ & =\\lambda ⟨2,-1,-1⟩+\\mu ⟨0,2y,2z⟩\\end{aligned}\n$$\n\n \n\nTherefore, we have the following system:\n\n$$\n\\begin{aligned}{\\begin{aligned}2=2\\lambda  \\\\ 3=-\\lambda +2\\mu y \\\\ 2=-\\lambda +2\\mu z\\end{aligned}\\,⇒\\,{\\begin{aligned}\\lambda =1 \\\\ y=\\frac{2}{\\mu } \\\\ z=\\frac{3}{2\\mu }\\end{aligned}\\end{aligned}\n$$\n\nNotice that $\\mu $ can't be zero since this leads to a contradiction.\n\nNext, we substitute our expressions for $y$ and $z$ into the second constraint:\n\n$$\n\\begin{aligned}{y}^{2}+{z}^{2} & =1 \\\\ \\frac{4}{{\\mu }^{2}}+\\frac{9}{4{\\mu }^{2}} & =1 \\\\ \\frac{25}{4{\\mu }^{2}} & =1 \\\\ {\\mu }^{2} & =\\frac{25}{4} \\\\ \\mu  & =\\pm \\frac{5}{2}\\end{aligned}\n$$\n\nAs a result, \n\n$$\ny=\\pm \\frac{4}{5},\\,z=\\pm \\frac{3}{5}.\n$$\n\nFinally, we substitute $y$ and $z$ into the first constraint:\n\n- If $y=\\frac{4}{5}$ and $z=\\frac{3}{5},$ we have\n\n$$\n\\begin{aligned}2x-y-z & =-1 \\\\ 2x-\\frac{4}{5}-\\frac{3}{5} & =-1 \\\\ x & =\\frac{1}{5}. \\\\  & \\end{aligned}\n$$\n\n- If $y=-\\frac{4}{5}$ and $z=-\\frac{3}{5},$ we have\n\n$$\n\\begin{aligned}2x-y-z & =-1 \\\\ 2x-(-\\frac{4}{5})-(-\\frac{3}{5}) & =-1 \\\\ 2x & =-\\frac{12}{5} \\\\ x & =-\\frac{6}{5}.\\end{aligned}\n$$\n\nTherefore, $f$ has possible extreme values at the points\n\n$$\n(\\frac{1}{5},\\frac{4}{5},\\frac{3}{5}),\\,(-\\frac{6}{5},-\\frac{4}{5},-\\frac{3}{5}).\n$$\n\nWe evaluate $f$ at each of these points. These are given in the following table:\n\n| $(x,y,z)$ | $(\\frac{1}{5},\\frac{4}{5},\\frac{3}{5})$ | $(-\\frac{6}{5},-\\frac{4}{5},-\\frac{3}{5})$ |\n| --- | --- | --- |\n| $f(x,y,z)$ | $4$ | $-6$ |\n\nTherefore, the function reaches a maximum value at $(\\frac{1}{5},\\frac{4}{5},\\frac{3}{5}),$ and its maximum value is $4.$"}] [{:db/id #edb/ref 17592186389387 :knowledge-point/_questions [{:knowledge-point/id #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756" :knowledge-point/title "Finding the Derivative of a Scalar Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042959d0-5542-5e33-9ffd-54db09e2c186" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}{x}^{2} & -{y}^{2}\\end{aligned}]" :db/id #edb/ref 17592186389389} {:answer/id #uuid "e9d118d2-a11a-59cd-b2db-257903c51287" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2x \\\\ -3y\\end{aligned}]" :db/id #edb/ref 17592186389390} {:answer/id #uuid "078443fc-0066-5782-928d-27965f15389f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6y \\\\ -4x\\end{aligned}]" :db/id #edb/ref 17592186389391} {:answer/id #uuid "09f8fcf4-bd1d-5c79-b774-95459ddf3e67" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4x & -6y\\end{aligned}]" :db/id #edb/ref 17592186389392} {:answer/id #uuid "b4b7eb05-6cfd-5ca6-ab01-7fbec319fd0f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -6\\end{aligned}]" :db/id #edb/ref 17592186389393}] :answer-field/correct {:answer/id #uuid "09f8fcf4-bd1d-5c79-b774-95459ddf3e67" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4x & -6y\\end{aligned}]" :db/id #edb/ref 17592186389392} :answer-field/id #uuid "ea062640-cdcd-5c97-9875-6bc98321ba00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389388}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "64d550f1-8d2f-5aa7-8e7b-a4c907c4afdf" :question/math-academy-id "q-163032" :question/problem "For the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=2{x}^{2}-3{y}^{2},\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2})=4x, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2})=-6y\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}4x & -6y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186389394 :knowledge-point/_questions [{:knowledge-point/id #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756" :knowledge-point/title "Finding the Derivative of a Scalar Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "837de383-8a59-5e3e-b44b-4a83acba37f5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡y \\\\ \\operatorname{sin}⁡y\\end{aligned}]" :db/id #edb/ref 17592186389396} {:answer/id #uuid "1476b37b-ce46-5ab0-aecb-36dc6b67bf4e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}x\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186389397} {:answer/id #uuid "9267d816-5255-57ea-9f4e-ac44e66b36b9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{cos}⁡y & x\\operatorname{sin}⁡y\\end{aligned}]" :db/id #edb/ref 17592186389398} {:answer/id #uuid "cb2c5eb2-ed70-5a83-8ae7-1ccc3e1b1655" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186389399} {:answer/id #uuid "c6dfc81d-0308-5b8f-a138-4ee9b7abef58" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-x\\operatorname{cos}⁡y \\\\ \\operatorname{sin}⁡y\\end{aligned}]" :db/id #edb/ref 17592186389400}] :answer-field/correct {:answer/id #uuid "cb2c5eb2-ed70-5a83-8ae7-1ccc3e1b1655" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{aligned}]" :db/id #edb/ref 17592186389399} :answer-field/id #uuid "1904f0bd-e59f-53c2-902e-e5c624a33494" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "481039ec-e171-5d00-9cb6-0349111018af" :question/math-academy-id "q-163033" :question/problem "For the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=x\\operatorname{sin}⁡y,\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡y)=\\operatorname{sin}⁡y, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x\\operatorname{sin}⁡y)=x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186389401 :knowledge-point/_questions [{:knowledge-point/id #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756" :knowledge-point/title "Finding the Derivative of a Scalar Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e6f16f-649b-591e-b673-90ad31ba43f9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2x-1 & 2y-1\\end{aligned}]" :db/id #edb/ref 17592186389403} {:answer/id #uuid "1fd56ca0-c1f2-5315-bae2-c1b65e603520" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2y-x \\\\ -y+2x\\end{aligned}]" :db/id #edb/ref 17592186389404} {:answer/id #uuid "b0307f8f-3ec4-5340-a42b-c3ea77d7cca6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2y-x & 2x-y\\end{aligned}]" :db/id #edb/ref 17592186389405} {:answer/id #uuid "8dbbeb62-d885-54fa-92eb-28df54a4c4cc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2x-1 \\\\ 2y-1\\end{aligned}]" :db/id #edb/ref 17592186389406} {:answer/id #uuid "1d9aa3ac-a3f3-5e28-b0a0-4cb94b05fb0f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2x-y & -x+2y\\end{aligned}]" :db/id #edb/ref 17592186389407}] :answer-field/correct {:answer/id #uuid "1d9aa3ac-a3f3-5e28-b0a0-4cb94b05fb0f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2x-y & -x+2y\\end{aligned}]" :db/id #edb/ref 17592186389407} :answer-field/id #uuid "9f5c60e8-8aeb-55da-b9fb-b42572387a77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0b9f2ee-cdae-57ba-b37e-8477c052d116" :question/math-academy-id "q-163045" :question/problem "For the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={x}^{2}-xy+{y}^{2},\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}-xy+{y}^{2})=2x-y, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}-xy+{y}^{2})=-x+2y\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}2x-y & -x+2y\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186389408 :knowledge-point/_questions [{:knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64" :knowledge-point/title "Finding the Derivative of a Vector Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df3378a4-f098-5dd2-8ca5-d33c2875b948" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{y} & \\frac{y}{{x}^{2}} \\\\ \\frac{1}{y} & \\frac{1}{y}\\end{aligned}]" :db/id #edb/ref 17592186389410} {:answer/id #uuid "ba36a6bb-461b-576b-a8b0-07e2ea3c3d49" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{y} & \\frac{1}{x} \\\\ \\frac{y}{{x}^{2}} & \\frac{1}{y}\\end{aligned}]" :db/id #edb/ref 17592186389411} {:answer/id #uuid "a27b4618-4b71-59b7-bacf-d0230094bfab" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{x} & \\frac{1}{y} \\\\ \\frac{y}{{x}^{2}} & -\\frac{1}{{x}^{2}}\\end{aligned}]" :db/id #edb/ref 17592186389412} {:answer/id #uuid "d29cf603-32b4-509c-97ca-bbaca8f5bc45" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{x} & \\frac{y}{{x}^{2}} \\\\ \\frac{1}{y} & \\frac{1}{x}\\end{aligned}]" :db/id #edb/ref 17592186389413} {:answer/id #uuid "aa56a467-d2f5-5753-b23e-6ee51008dcc4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{aligned}]" :db/id #edb/ref 17592186389414}] :answer-field/correct {:answer/id #uuid "aa56a467-d2f5-5753-b23e-6ee51008dcc4" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{aligned}]" :db/id #edb/ref 17592186389414} :answer-field/id #uuid "090b72a8-f15b-5bfd-adae-9afc07d8a51e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389409}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6490b2e2-ebe2-52cf-9741-542b7f4cc483" :question/math-academy-id "q-163110" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}\\operatorname{ln}⁡(xy) \\\\ \\frac{y}{x}\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}(x).$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))=\\frac{1}{x},\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))=\\frac{1}{y} \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(\\frac{y}{x})=-\\frac{y}{{x}^{2}},\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(\\frac{y}{x})=\\frac{1}{x}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{1}{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186129555 :knowledge-point/_questions [{:knowledge-point/id #uuid "850f196a-9607-56c2-b0a7-a00d4d5a4741" :knowledge-point/title "Calculating a Moment of Inertia About a Perpendicular Axis Using Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ca09fe-52fd-57a5-a895-b0d719568b46" :answer/type {:db/ident :answer.type/math} :answer/value "32\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389416} {:answer/id #uuid "44d2dbd7-165e-56c9-9f78-e0db5563b858" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389417} {:answer/id #uuid "fe8aa4a6-834d-5970-abc5-1a953a77a47d" :answer/type {:db/ident :answer.type/math} :answer/value "28\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389418} {:answer/id #uuid "cb98dba2-7629-56a8-9b7a-674bd817e6d5" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389419} {:answer/id #uuid "a5dac0ba-ba5f-5d70-9c21-eafb728af77f" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389420}] :answer-field/correct {:answer/id #uuid "44d2dbd7-165e-56c9-9f78-e0db5563b858" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389417} :answer-field/id #uuid "6bd1c478-3e9d-5d5c-a95a-e889e6058dda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389415}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c746d262-efcf-5fbe-a185-059c81fe24fa" :question/math-academy-id "q-163213" :question/problem "A circular plate of mass $2\\,\\text{kg}$ and uniform mass density occupies the region of a disk $D$ of radius $2\\,\\text{m}$ centered at the origin.\nFind the moment of inertia of the plate about a line perpendicular to $D$ at a distance of $4\\,\\text{m}$ from a parallel line passing through its center of mass." :question/worked-solution "For a plane lamina of mass $M$ and a line ${l}_{M}$ perpendicular to the lamina passing through its center of mass, the parallel axis theorem states that the moment of inertia of the lamina about a line $l$ parallel to ${l}_{M}$ is given by\n\n$$\n{I}_{l}={I}_{M}+{d}^{2}M,\n$$\n\nwhere $d$ is the distance between the lines, and ${I}_{M}$ and ${I}_{l}$ are the moments of inertia about the lines ${l}_{M}$ and $l,$ respectively.\n\nFirst, notice that the region $D$ can be expressed in polar coordinates as\n\n$$\nD={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta <2\\pi }.\n$$\n\nThe area of the circular plate $D$ is $A=\\pi \\cdot {2}^{2}=4\\pi \\,{\\text{m}}^{2}.$\nSince the plate has a uniform density, the mass density function is given by\n\n$$\n\\lambda (r,\\theta )=\\frac{M}{A}=\\frac{2}{4\\pi }=\\frac{1}{2\\pi }\\,\\text{kg}/{\\text{m}}^{2},\n$$\n\nand its center of mass is its centroid $(0,0).$\n\nThen, the moment of inertia about the perpendicular line through the center of mass is\n\n$$\n\\begin{aligned}{I}_{M} & ={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2\\pi }{\\int }_{0}^{2}{r}^{3}\\,\\text{d}r{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2\\pi }\\cdot \\frac{1}{4}{r}^{4}{|}_{0}^{2}\\cdot \\theta {|}_{0}^{2\\pi } \\\\  & =\\frac{1}{2\\pi }\\cdot 4\\cdot 2\\pi  \\\\  & =4\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$\n\nFinally, applying the parallel axis theorem, the moment of inertia about a line $4\\,\\text{m}$ from the center of mass is\n\n$$\n\\begin{aligned}I & ={I}_{M}+{d}^{2}M \\\\  & =4+{4}^{2}\\cdot 2 \\\\  & =4+32 \\\\  & =36\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180105 :knowledge-point/_questions [{:knowledge-point/id #uuid "9696b3f4-42c8-5796-be3a-6c59c9600c95" :knowledge-point/title "Calculating the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffd503b7-1fb0-5b6b-947d-f67bedec77bb" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,J" :db/id #edb/ref 17592186389422} {:answer/id #uuid "923d3387-ad05-5dc6-b74d-db9f370d7b81" :answer/type {:db/ident :answer.type/math} :answer/value "1\\,J" :db/id #edb/ref 17592186389423} {:answer/id #uuid "5f2c785c-6a82-544b-9b53-c3267202ca39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\,J" :db/id #edb/ref 17592186389424} {:answer/id #uuid "49129e10-9a8b-5b14-b52c-0e2c956cf3ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,J" :db/id #edb/ref 17592186389425} {:answer/id #uuid "8129efb7-faee-5026-8faa-31e10d79448b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,J" :db/id #edb/ref 17592186389426}] :answer-field/correct {:answer/id #uuid "49129e10-9a8b-5b14-b52c-0e2c956cf3ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,J" :db/id #edb/ref 17592186389425} :answer-field/id #uuid "851383c4-adde-5677-a6f8-277d19fcdb87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389421}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cf39bb1-9c63-5747-9e30-28aba079140a" :question/math-academy-id "q-163596" :question/problem "A particle $P$ moves along the $x$-axis under the action of a force of magnitude $2{x}^{2}\\,\\text{N}$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, calculate the work done by the force in moving the particle from $x=0$ to $x=1.$" :question/worked-solution "The work done by a force $F=F(x)$ in moving a particle from $x={x}_{1}$ to $x={x}_{2}$ is given by\n\n$$\nW={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x.\n$$\n\nWhen the force and distance are measured in Newtons and meters, respectively, the work done by the force is measured in Joules ($J$).\n\nSubstituting the given values into our integral, we obtain\n\n$$\n\\begin{aligned}W & ={\\int }_{0}^{1}2{x}^{2}\\,\\text{d}x \\\\  & =\\frac{2}{3}{x}^{3}{|}_{0}^{1} \\\\  & =\\frac{2}{3}(1-0) \\\\  & =\\frac{2}{3}\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389427 :knowledge-point/_questions [{:knowledge-point/id #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb" :knowledge-point/title "Finding the Second Derivative of a Function Given Its First Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33bfe849-177a-595a-a0ab-0f31871be845" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}20 & -5 \\\\ -5 & -2\\end{aligned}]" :db/id #edb/ref 17592186389429} {:answer/id #uuid "506fbdd5-6f95-50b7-bf79-a8e6f12af0dc" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 20 \\\\ 20 & -2\\end{aligned}]" :db/id #edb/ref 17592186389430} {:answer/id #uuid "22530ff9-8ee1-5653-9189-7257b61c3df9" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 10 \\\\ 10 & -2\\end{aligned}]" :db/id #edb/ref 17592186389431} {:answer/id #uuid "7e72de7a-05de-51d7-9a04-70e16f91e383" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10 & 5 \\\\ 5 & -2\\end{aligned}]" :db/id #edb/ref 17592186389432} {:answer/id #uuid "4c4b43e7-24cc-5566-83a4-12233460ad1c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 5 \\\\ 5 & -2\\end{aligned}]" :db/id #edb/ref 17592186389433}] :answer-field/correct {:answer/id #uuid "4c4b43e7-24cc-5566-83a4-12233460ad1c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 5 \\\\ 5 & -2\\end{aligned}]" :db/id #edb/ref 17592186389433} :answer-field/id #uuid "edf7a152-c075-537f-98b6-31165d39d652" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389428}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80f3f97d-e5ae-5fea-a537-3ca9f7c75a2e" :question/math-academy-id "q-163637" :question/problem "Find ${f}^{″}(\\frac{1}{2},\\frac{1}{2})$ for the function $f(x,y)$ given that\n${f}^{′}(x,y)=[\\begin{aligned}10xy & 5{x}^{2}-2y\\end{aligned}]$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}10xy & 5{x}^{2}-2y\\end{aligned}],$ \n we must have\n\n$$\n\\frac{∂f}{∂x}=10xy,\\,\\frac{∂f}{∂y}=5{x}^{2}-2y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(10xy)=10y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(5{x}^{2}-2y)=10x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(10xy)=10x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(5{x}^{2}-2y)=-2\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}10y & 10x \\\\ 10x & -2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(\\frac{1}{2},\\frac{1}{2}).$ This gives\n\n$$\n{f}^{″}(\\frac{1}{2},\\frac{1}{2})=[\\begin{aligned}5 & 5 \\\\ 5 & -2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186389434 :knowledge-point/_questions [{:knowledge-point/id #uuid "94904fa2-bf02-5486-950c-979a4d12998e" :knowledge-point/title "Applying the Work-Energy Principle To Find the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0882e3f7-f97e-5d5b-ab30-55393a6df5f5" :answer/type {:db/ident :answer.type/math} :answer/value "246\\,J" :db/id #edb/ref 17592186389436} {:answer/id #uuid "7ce75a48-a50b-51ed-9b2e-3bd4b6c7cf4a" :answer/type {:db/ident :answer.type/math} :answer/value "266\\,J" :db/id #edb/ref 17592186389437} {:answer/id #uuid "5f93d06c-8297-5f19-a7a9-1e8d58499e54" :answer/type {:db/ident :answer.type/math} :answer/value "236\\,J" :db/id #edb/ref 17592186389438} {:answer/id #uuid "11eaead2-18c3-507d-ad5c-e81f26231b38" :answer/type {:db/ident :answer.type/math} :answer/value "226\\,J" :db/id #edb/ref 17592186389439} {:answer/id #uuid "3c90e325-3192-5d5b-985f-014dab1a5254" :answer/type {:db/ident :answer.type/math} :answer/value "256\\,J" :db/id #edb/ref 17592186389440}] :answer-field/correct {:answer/id #uuid "7ce75a48-a50b-51ed-9b2e-3bd4b6c7cf4a" :answer/type {:db/ident :answer.type/math} :answer/value "266\\,J" :db/id #edb/ref 17592186389437} :answer-field/id #uuid "b16601f4-df28-5d36-9cea-33a8a93f0535" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389435}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e3727b71-f77c-52d3-b736-d8fbf4a3880a" :question/math-academy-id "q-163659" :question/problem "A particle $P$ of mass $4\\,kg$ moves along the $x$-axis under the action of a resultant force. The particle's acceleration is $(4t+1)\\,{m/s}^{2},$ where $t\\ge 0$ is the time in seconds. If the particle has velocity $v=3\\,m/s$ when $t=0\\,s,$ calculate the work done by the force between the times $t=1\\,s$ and $t=2\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe acceleration of the particle is given by $a(t)=4t+1,$ where $t$ is time in seconds.\nWe find the velocity $v(t)$ of the particle by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (4t+1)\\,\\text{d}t \\\\  & =2{t}^{2}+t+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=3.$ Substituting this into the above gives\n\n$$\n3=2(0)^{2}+0+C\\,⟹\\,C=3.\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=2{t}^{2}+t+3.$\nIn particular, the particle's initial velocity, at $t=1$, is\n\n$$\n{v}_{0}=v(1)=2(1)^{2}+1+3=6\\,m/s,\n$$\n\nand final velocity, at $t=2$, is\n\n$$\n{v}_{1}=v(2)=2(2)^{2}+2+3=13\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 4\\cdot {13}^{2}-\\frac{1}{2}\\cdot 4\\cdot {6}^{2} \\\\  & =338-72 \\\\  & =266\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389441 :knowledge-point/_questions [{:knowledge-point/id #uuid "94904fa2-bf02-5486-950c-979a4d12998e" :knowledge-point/title "Applying the Work-Energy Principle To Find the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70f35aeb-2053-5b37-abce-48d3972b397c" :answer/type {:db/ident :answer.type/math} :answer/value "25\\,J" :db/id #edb/ref 17592186389443} {:answer/id #uuid "24f06dbe-e866-519e-8599-01c0ead2742e" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,J" :db/id #edb/ref 17592186389444} {:answer/id #uuid "7a155385-200c-550f-96bf-08d5a75d20fa" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,J" :db/id #edb/ref 17592186389445} {:answer/id #uuid "318dfa74-61f2-571e-8498-0ef0bc26ce59" :answer/type {:db/ident :answer.type/math} :answer/value "17\\,J" :db/id #edb/ref 17592186389446} {:answer/id #uuid "156b8685-b780-52be-a010-0b4b0806771e" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,J" :db/id #edb/ref 17592186389447}] :answer-field/correct {:answer/id #uuid "156b8685-b780-52be-a010-0b4b0806771e" :answer/type {:db/ident :answer.type/math} :answer/value "8\\,J" :db/id #edb/ref 17592186389447} :answer-field/id #uuid "c13537c9-cba9-528c-81df-ec823b958306" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389442}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8305d2ef-8fb9-5f80-b2fe-3b5b2380f4bf" :question/math-academy-id "q-163671" :question/problem "A particle $P$ of mass $1\\,kg$ moves along the $x$-axis under the action of a resultant force. The particle's velocity is $(t+1)\\,m/s,$ where $t\\ge 0$ is the time in seconds. Calculate the work done by the force between the times $t=2\\,s$ and $t=4\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe particle's velocity is given by $v(t)=t+1,$ where $t$ is time in seconds. So, the particle's initial velocity, at $t=2$, is\n\n$$\n{v}_{0}=v(2)=2+1=3\\,m/s,\n$$\n\nand final velocity, at $t=4$, is\n\n$$\n{v}_{1}=v(4)=4+1=5\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 1\\cdot (5)^{2}-\\frac{1}{2}\\cdot 1\\cdot (3)^{2} \\\\  & =\\frac{25}{2}-\\frac{9}{2} \\\\  & =8\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389448 :knowledge-point/_questions [{:knowledge-point/id #uuid "94904fa2-bf02-5486-950c-979a4d12998e" :knowledge-point/title "Applying the Work-Energy Principle To Find the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56559d07-36b9-5fba-b51e-1f8e5cba51e5" :answer/type {:db/ident :answer.type/math} :answer/value "253\\,J" :db/id #edb/ref 17592186389450} {:answer/id #uuid "c613f699-7516-5c10-a37c-3efc4c225fe9" :answer/type {:db/ident :answer.type/math} :answer/value "275\\,J" :db/id #edb/ref 17592186389451} {:answer/id #uuid "796b1a5b-ed2a-5e7a-b39a-e70d3438bf86" :answer/type {:db/ident :answer.type/math} :answer/value "242\\,J" :db/id #edb/ref 17592186389452} {:answer/id #uuid "9f89a0c0-4a4c-5eeb-833d-bfc360dbff90" :answer/type {:db/ident :answer.type/math} :answer/value "264\\,J" :db/id #edb/ref 17592186389453} {:answer/id #uuid "66326f34-27cb-58c3-9945-4137e4710b64" :answer/type {:db/ident :answer.type/math} :answer/value "280\\,J" :db/id #edb/ref 17592186389454}] :answer-field/correct {:answer/id #uuid "56559d07-36b9-5fba-b51e-1f8e5cba51e5" :answer/type {:db/ident :answer.type/math} :answer/value "253\\,J" :db/id #edb/ref 17592186389450} :answer-field/id #uuid "3b3b8e1e-c87a-5182-99ea-c5567dd2e35b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389449}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f249579b-a99f-5b51-b0c7-e7f72d9a4512" :question/math-academy-id "q-163678" :question/problem "A particle $P$ of mass $2\\,kg$ moves along the $x$-axis under the action of a resultant force. The particle's acceleration is $(3{t}^{2}+4)\\,{m/s}^{2},$ where $t\\ge 0$ is the time in seconds. If the particle has velocity $v=1\\,m/s$ when $t=0\\,s,$ calculate the work done by the force between the times $t=1\\,s$ and $t=2\\,s.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nThe acceleration of the particle is given by $a(t)=3{t}^{2}+4,$ where $t$ is time in seconds.\nWe find the velocity $v(t)$ of the particle by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (3{t}^{2}+4)\\,\\text{d}t \\\\  & ={t}^{3}+4t+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=1.$ Substituting this into the above gives\n\n$$\n1=(0)^{3}+4(0)+C\\,⟹\\,C=1.\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)={t}^{3}+4t+1.$\nIn particular, the particle's initial velocity, at $t=1,$ is\n\n$$\n{v}_{0}=v(1)=(1)^{3}+4(1)+1=6\\,m/s,\n$$\n\nand final velocity, at $t=2,$ is\n\n$$\n{v}_{1}=v(2)=(2)^{3}+4(2)+1=17\\,m/s.\n$$\n\nTherefore, by the work-energy principle, the work done by the force between these times is\n\n$$\n\\begin{aligned}W & =Δ\\,\\text{KE} \\\\  & =\\frac{1}{2}\\cdot 2\\cdot {17}^{2}-\\frac{1}{2}\\cdot 2\\cdot {6}^{2} \\\\  & =289-36 \\\\  & =253\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389455 :knowledge-point/_questions [{:knowledge-point/id #uuid "9696b3f4-42c8-5796-be3a-6c59c9600c95" :knowledge-point/title "Calculating the Work Done by a Force"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb4d826c-14ba-585c-aebd-1facb3368012" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,J" :db/id #edb/ref 17592186389457} {:answer/id #uuid "8ab762ed-0112-5d52-b62f-05b3b484b0b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\,J" :db/id #edb/ref 17592186389458} {:answer/id #uuid "6aa053a0-465d-5f0b-8742-c3a588a86e3e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,J" :db/id #edb/ref 17592186389459} {:answer/id #uuid "ee6add72-368a-56d1-a701-8e8fbe0ceee5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,J" :db/id #edb/ref 17592186389460} {:answer/id #uuid "04400f5c-b01f-5a74-aa41-074c903d6463" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,J" :db/id #edb/ref 17592186389461}] :answer-field/correct {:answer/id #uuid "eb4d826c-14ba-585c-aebd-1facb3368012" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\,J" :db/id #edb/ref 17592186389457} :answer-field/id #uuid "7fc72668-2f1d-508f-943f-15caead3623c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389456}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d31a00a5-c404-50d8-b7f2-fda34cf2cc53" :question/math-academy-id "q-163685" :question/problem "A particle $P$ moves along the $x$-axis under the action of a force of magnitude $\\frac{1}{{x}^{2}}\\,\\text{N}$ acting in the direction of increasing $x.$ Given that $x$ is measured in meters, calculate the work done by the force in moving the particle from $x=1$ to $x=4.$" :question/worked-solution "The work done by a force $F=F(x)$ in moving a particle from $x={x}_{1}$ to $x={x}_{2}$ is given by\n\n$$\nW={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x.\n$$\n\nWhen the force and distance are measured in Newtons and meters, respectively, the work done by the force is measured in Joules ($J$).\n\nSubstituting the given values into our integral, we obtain\n\n$$\n\\begin{aligned}W & ={\\int }_{1}^{4}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =-\\frac{1}{x}\\,{|}_{1}^{4} \\\\  & =-(\\frac{1}{4}-1) \\\\  & =-(-\\frac{3}{4}) \\\\  & =\\frac{3}{4}\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389462 :knowledge-point/_questions [{:knowledge-point/id #uuid "793154ca-29f0-5552-97cd-57acbc915966" :knowledge-point/title "Applying the Work-Energy Principle to Find a Particle's Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c199cc2a-f7f6-59a6-a5fc-4846aee05fdc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,m/s" :db/id #edb/ref 17592186389464} {:answer/id #uuid "442ec423-11ee-5f69-93dc-a03ed507c7da" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,m/s" :db/id #edb/ref 17592186389465} {:answer/id #uuid "68180a5e-f1ad-55a4-b5d8-b911509b32e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}\\,m/s" :db/id #edb/ref 17592186389466} {:answer/id #uuid "7d542d69-ec75-5271-91be-39c1464d14a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\,m/s" :db/id #edb/ref 17592186389467} {:answer/id #uuid "6fde94bd-e7bd-5cbc-a4de-8543a3385c56" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,m/s" :db/id #edb/ref 17592186389468}] :answer-field/correct {:answer/id #uuid "c199cc2a-f7f6-59a6-a5fc-4846aee05fdc" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,m/s" :db/id #edb/ref 17592186389464} :answer-field/id #uuid "a040d79b-c119-5a8f-9a95-eb5d0defe231" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389463}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "89e50146-b1c6-571f-ad82-cc9a4f7f02cf" :question/math-academy-id "q-163702" :question/problem "A particle $P$ of mass $1\\,kg$ moves along the $x$-axis under the action of the force of magnitude $(3{x}^{2}+2)\\,N$ acting in the direction of increasing $x.$ Given that distances along the $x$-axis are measured in meters, the particle is initially at the origin, and the particle has velocity $v=7\\,m/s$ at $x=2,$ find the particle's change in velocity in moving from $x=0$ to $x=2.$" :question/worked-solution "The work-energy principle states that the work done by a resultant force on a particle equals the change in the particle's kinetic energy. That is,\n\n$$\nW=Δ\\,\\text{KE}\n$$\n\nwhere the change in kinetic energy of a particle is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}\n$$\n\nand $m$ is the particle's mass, ${v}_{0}$ is its initial velocity, and ${v}_{1}$ is its final velocity.\n\nFirst, we calculate the work done by the force in moving the particle from $x=0$ to $x=2:$\n\n$$\n\\begin{aligned}W & ={\\int }_{{x}_{1}}^{{x}_{2}}F(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(3{x}^{2}+2)\\,\\text{d}x \\\\  & ={[{x}^{3}+2x]}_{0}^{2} \\\\  & =8+4-0 \\\\  & =12\\,J\\end{aligned}\n$$\n\nThe particle has velocity $v=7\\,m/s$ at $x=2.$ So, we can find the velocity ${v}_{0}$ at $x=0$ using the work-energy principle:\n\n$$\n\\begin{aligned}W & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\ 12 & =\\frac{1}{2}\\cdot 1\\cdot {7}^{2}-\\frac{1}{2}\\cdot 1\\cdot {v}_{0}^{2} \\\\ 12 & =\\frac{49}{2}-\\frac{1}{2}{v}_{0}^{2} \\\\ \\frac{1}{2}{v}_{0}^{2} & =\\frac{25}{2} \\\\ {v}_{0}^{2} & =25 \\\\ {v}_{0} & =\\pm 5.\\end{aligned}\n$$\n\nWe can disregard the negative solution since the velocity and acceleration of the particle are positive in the regions under consideration. \n\nTherefore, the velocity of the particle at $x=0$ is $5\\,m/s.$\n\nFinally, the particle's change in velocity from $x=0$ to $x=2$ is\n\n$$\n{v}_{1}-{v}_{0}=7-5=2\\,m/s.\n$$"}] [{:db/id #edb/ref 17592186389469 :knowledge-point/_questions [{:knowledge-point/id #uuid "ec390427-7510-57ea-aedf-a930284f93b5" :knowledge-point/title "Calculating the Kinetic Energy of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "226918d0-485c-57fb-b37f-551c971f4927" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,J" :db/id #edb/ref 17592186389471} {:answer/id #uuid "49371fc0-7c0a-5176-b84d-8fdac3f9bd9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{6}\\,J" :db/id #edb/ref 17592186389472} {:answer/id #uuid "4e01aaf7-2644-59d0-beea-cbe8e4f810f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{8}\\,J" :db/id #edb/ref 17592186389473} {:answer/id #uuid "6ec4407e-4e50-5120-b041-d1dbb0df353d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{4}\\,J" :db/id #edb/ref 17592186389474} {:answer/id #uuid "13bff32a-258c-58a1-a056-0f3af9f9b3f7" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,J" :db/id #edb/ref 17592186389475}] :answer-field/correct {:answer/id #uuid "4e01aaf7-2644-59d0-beea-cbe8e4f810f1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{8}\\,J" :db/id #edb/ref 17592186389473} :answer-field/id #uuid "5b2247e4-31f8-5907-8437-cf47cd59d1d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f633b7bf-41b1-55e5-94fa-734d0d539fd4" :question/math-academy-id "q-163711" :question/problem "A particle $P$ of mass $3\\,kg$ moves along the $x$-axis from rest at the origin with an acceleration of magnitude $\\frac{1}{2}{t}^{2}\\,{m/s}^{2},$ where the acceleration acts in the direction of increasing $x,$ and $t\\ge 0$ is the time in seconds. Calculate the change in kinetic energy of the particle between the times $t=1\\,s$ and $t=2\\,s.$" :question/worked-solution "The change in kinetic energy of a particle with mass $m,$ initial velocity ${v}_{0},$ and final velocity ${v}_{1}$ is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}.\n$$\n\nWhen the mass and velocity are measured in kilograms and meters per second, respectively, the particle's kinetic energy is measured in Joules ($J$).\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\ v(t) & =\\int \\frac{1}{2}{t}^{2}\\,\\text{d}t \\\\ v(t) & =\\frac{1}{6}{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n0=\\frac{1}{6}({0}^{3})+C\\,⟹\\,C=0.\n$$\n\nHence, the velocity of the particle at time $t$ is $v(t)=\\frac{1}{6}{t}^{3}.$ In particular, its inital velocity at time $t=1\\,s$ and final velocity at time $t=2\\,s$ are\n\n$$\n\\begin{aligned}{v}_{0} & =v(1)=\\frac{1}{6}({1}^{3})=\\frac{1}{6}\\,m/s, \\\\ {v}_{1} & =v(2)=\\frac{1}{6}({2}^{3})=\\frac{4}{3}\\,m/s.\\end{aligned}\n$$\n\nTherefore, the change in kinetic energy of the particle between these times is\n\n$$\n\\begin{aligned}Δ\\,\\text{KE} & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\  & =\\frac{1}{2}\\cdot 3\\cdot {(\\frac{4}{3})}^{2}-\\frac{1}{2}\\cdot 3\\cdot {(\\frac{1}{6})}^{2} \\\\  & =\\frac{8}{3}-\\frac{1}{24} \\\\  & =\\frac{21}{8}\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389476 :knowledge-point/_questions [{:knowledge-point/id #uuid "ec390427-7510-57ea-aedf-a930284f93b5" :knowledge-point/title "Calculating the Kinetic Energy of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90ca48dc-9ebd-5ddb-b0fd-4e9e4bf3e523" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,J" :db/id #edb/ref 17592186389478} {:answer/id #uuid "bb17431a-f15d-57b4-8155-d193fd52d02a" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,J" :db/id #edb/ref 17592186389479} {:answer/id #uuid "1341ffcc-a761-51c7-8882-f9f94717f134" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,J" :db/id #edb/ref 17592186389480} {:answer/id #uuid "760e497b-11bf-5399-b595-62bbffc2cba4" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,J" :db/id #edb/ref 17592186389481} {:answer/id #uuid "4f138711-dd5f-59c8-bf2b-72bb46435286" :answer/type {:db/ident :answer.type/math} :answer/value "27\\,J" :db/id #edb/ref 17592186389482}] :answer-field/correct {:answer/id #uuid "4f138711-dd5f-59c8-bf2b-72bb46435286" :answer/type {:db/ident :answer.type/math} :answer/value "27\\,J" :db/id #edb/ref 17592186389482} :answer-field/id #uuid "5f0ec5fc-0f7c-5acb-8a13-4ea7ffbac1a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c495a30-23c5-530b-9d91-e188ad9ee72e" :question/math-academy-id "q-163714" :question/problem "A particle $P$ of mass $\\frac{8}{5}\\,kg$ moves along the $x$-axis from rest at the origin with an acceleration of magnitude $3t\\,{m/s}^{2},$ where the acceleration acts in the direction of increasing $x,$ and $t\\ge 0$ is the time in seconds. Calculate the change in kinetic energy of the particle between the times $t=1\\,s$ and $t=2\\,s.$" :question/worked-solution "The change in kinetic energy of a particle with mass $m,$ initial velocity ${v}_{0},$ and final velocity ${v}_{1}$ is given by\n\n$$\nΔ\\,\\text{KE}=\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2}.\n$$\n\nWhen the mass and velocity are measured in kilograms and meters per second, respectively, the particle's kinetic energy is measured in Joules ($J$).\n\nFirst, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\ v(t) & =\\int 3t\\,\\text{d}t \\\\ v(t) & =\\frac{3}{2}{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n0=\\frac{3}{2}({0}^{2})+C\\,⟹\\,C=0.\n$$\n\nHence, the velocity of the particle at time $t$ is $v(t)=\\frac{3}{2}{t}^{2}.$ In particular, its inital velocity at time $t=1\\,s$ and final velocity at time $t=2\\,s$ are\n\n$$\n\\begin{aligned}{v}_{0} & =v(1)=\\frac{3}{2}({1}^{2})=\\frac{3}{2}\\,m/s, \\\\ {v}_{1} & =v(2)=\\frac{3}{2}({2}^{2})=6\\,m/s.\\end{aligned}\n$$\n\nTherefore, the change in kinetic energy of the particle between these times is\n\n$$\n\\begin{aligned}Δ\\,\\text{KE} & =\\frac{1}{2}m{v}_{1}^{2}-\\frac{1}{2}m{v}_{0}^{2} \\\\  & =\\frac{1}{2}\\cdot \\frac{8}{5}\\cdot {6}^{2}-\\frac{1}{2}\\cdot \\frac{8}{5}\\cdot {(\\frac{3}{2})}^{2} \\\\  & =\\frac{144}{5}-\\frac{9}{5} \\\\  & =27\\,J.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129558 :knowledge-point/_questions [{:knowledge-point/id #uuid "c97f4331-e2cf-5ec7-a3ea-3f03a4c60d2d" :knowledge-point/title "Applying the Principle of Moments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cada217c-83e4-54a9-b3f0-f07738145f6f" :answer/type {:db/ident :answer.type/math} :answer/value "2.5\\,kg" :db/id #edb/ref 17592186389484} {:answer/id #uuid "2a45f4cf-7d56-5894-a953-408b6f7f2b3b" :answer/type {:db/ident :answer.type/math} :answer/value "1.8\\,kg" :db/id #edb/ref 17592186389485} {:answer/id #uuid "264f5451-d6db-5f97-a412-9a1713315aee" :answer/type {:db/ident :answer.type/math} :answer/value "2.2\\,kg" :db/id #edb/ref 17592186389486} {:answer/id #uuid "6e6c8aa1-8ac8-514b-a6ae-f3519092bb29" :answer/type {:db/ident :answer.type/math} :answer/value "1.4\\,kg" :db/id #edb/ref 17592186389487} {:answer/id #uuid "3a4b03de-9175-597e-91f6-44ecdc9b71b3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,kg" :db/id #edb/ref 17592186389488}] :answer-field/correct {:answer/id #uuid "3a4b03de-9175-597e-91f6-44ecdc9b71b3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,kg" :db/id #edb/ref 17592186389488} :answer-field/id #uuid "910f3350-af1c-50d0-bcfb-9e6b7c1ff4a5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389483}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0d6fe0c-2d8e-592e-808b-507c87fc4991" :question/math-academy-id "q-163797" :question/problem "![](images/f0/f0ca128a0755c0419d03d119501210b4be8036ccc0148f21b0e3a3665def30d5.png)\n\nTwo point masses $A$ and $B$ are connected by a rigid, massless rod of length $10\\,m$ that is perfectly balanced on a fulcrum, as shown above. If $B$ has mass $3\\,kg$ and is $4\\,m$ from the fulcrum, find the mass of $A.$" :question/worked-solution "Let $m$ be the mass of $A.$\nThe length of the rod is $10\\,m$ and the distance between the fulcrum and $B$ is $4\\,m.$ So, the distance between the fulcrum and $A$ is\n\n$$\n10-4=6\\,m,\n$$\n\nas shown below.\n\n![](images/a6/a68789963345d21ca403d22a5f97ee440b0c3baa36345b0161bc7f80a8e0d1e0.png)\n\nLet's write down the moment of each mass about the fulcrum:\n\n- The moment of mass $A$ equals $-m\\cdot 6=-6m\\,\\text{kg}\\cdot \\text{m}$ (negative since the motion induced by this mass would be counterclockwise).\n\n- The moment of mass $B$ equals $3\\cdot 4=12\\,\\text{kg}\\cdot \\text{m}$ (positive since the motion induced by this mass would be clockwise).\n\nThe *principle of moments* tells us that for the two masses to balance perfectly, the sum of the moments must equal zero.\n\nTherefore, in this case, we have\n\n$$\n\\begin{aligned}12-6m & =0 \\\\ 6m & =12 \\\\ m & =2\\,kg.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389489 :knowledge-point/_questions [{:knowledge-point/id #uuid "c97f4331-e2cf-5ec7-a3ea-3f03a4c60d2d" :knowledge-point/title "Applying the Principle of Moments"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1678ea5-3f39-5230-ae54-0bbf27fd3fbd" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,kg" :db/id #edb/ref 17592186389491} {:answer/id #uuid "1548281f-d1e6-55a9-8b23-de268d9935cf" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,kg" :db/id #edb/ref 17592186389492} {:answer/id #uuid "e014f709-94b9-5725-a8d0-b3a4b2cdf1d6" :answer/type {:db/ident :answer.type/math} :answer/value "6.5\\,kg" :db/id #edb/ref 17592186389493} {:answer/id #uuid "ed9e261c-e483-58af-a72a-7980db2ec3d6" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,kg" :db/id #edb/ref 17592186389494} {:answer/id #uuid "6a81c531-1434-58bd-a9ce-eb159462790b" :answer/type {:db/ident :answer.type/math} :answer/value "4.5\\,kg" :db/id #edb/ref 17592186389495}] :answer-field/correct {:answer/id #uuid "1548281f-d1e6-55a9-8b23-de268d9935cf" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,kg" :db/id #edb/ref 17592186389492} :answer-field/id #uuid "874fa571-fa9e-5c03-9e4b-2b0c82616705" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389490}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bfbc2cfa-782c-593d-b6ed-7e319d5ccc9f" :question/math-academy-id "q-163802" :question/problem "![](images/97/97045288ee8cefe694fe6e30d7153d2cc78eb2c73a254f366f443f7230312148.png)\n\nTwo point masses $A$ and $B$ are connected by a rigid, massless rod of length $10\\,m$ that is perfectly balanced on a fulcrum, as shown above. If $B$ has mass $4\\,kg$ and is $6\\,m$ from the fulcrum, find the mass of $A.$" :question/worked-solution "Let $m$ be the mass of $A.$\nThe length of the rod is $10\\,m$ and the distance between the fulcrum and $B$ is $6\\,m.$ So, the distance between the fulcrum and $A$ is\n\n$$\n10-6=4\\,m,\n$$\n\nas shown below.\n\n![](images/ec/ec39adee65bb0219053a8802470534cf8b2588f95cc8338c5c4a392adac6d516.png)\n\nLet's write down the moment of each mass about the fulcrum:\n\n- The moment of mass $A$ equals $-m\\cdot 4=-4m\\,\\text{kg}\\cdot \\text{m}$ (negative since the motion induced by this mass would be counterclockwise).\n\n- The moment of mass $B$ equals $4\\cdot 6=24\\,\\text{kg}\\cdot \\text{m}$ (positive since the motion induced by this mass would be clockwise).\n\nThe *principle of moments* tells us that for the two masses to balance perfectly, the sum of the moments must equal zero.\n\nTherefore, in this case, we have\n\n$$\n\\begin{aligned}24-4m & =0 \\\\ 4m & =24 \\\\ m & =6\\,kg.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088038 :knowledge-point/_questions [{:knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab721a7c-ebb0-5452-b247-5d3816198bf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (4\\sin x)y = 1 + 3\\cos x" :db/id #edb/ref 17592186084933} {:answer/id #uuid "b319152d-c291-5494-a461-4791daa6c062" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (4\\cos x)y = 1 + 3\\sin x" :db/id #edb/ref 17592186084934} {:answer/id #uuid "c17d0099-f48a-51bc-b6bf-feeec39e8bdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (2\\sin x)y = \\frac{1 + 3\\cos x}{2}" :db/id #edb/ref 17592186084935} {:answer/id #uuid "2a507547-4026-5e0f-ae6c-972cd79efc1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + \\frac{1 + 3\\cos x}{2} = (2\\sin x)y" :db/id #edb/ref 17592186084936} {:answer/id #uuid "606289fa-36e0-57ab-b7c2-57b9dbbb4540" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (2\\sin x)y = 1 + \\frac{3}{2}\\cos x" :db/id #edb/ref 17592186084937}] :answer-field/id #uuid "2e534d32-a3b5-5b67-a30a-d8fb0702e472" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084932}] :question/id #uuid "e5c269fd-ead8-50e4-b16e-9d9e9b4a244c" :question/math-academy-id "q-16400" :question/problem "Write the following first-order linear ODE in standard form.\n$2\\frac{dy}{dx} - 3\\cos x = 1 - 4y\\sin x$"}] [{:db/id #edb/ref 17592186389496 :knowledge-point/_questions [{:knowledge-point/id #uuid "21f203c5-4866-5077-9ef9-0d2122581c4f" :knowledge-point/title "Calculating a Moment of Inertia of a Rectangular Plate About a Perpendicular Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f162c583-fe62-5fba-9c96-68bf896663bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{21}{2}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389498} {:answer/id #uuid "64cf8fe1-66d9-5ab3-8251-577ddc7a7669" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{2}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389499} {:answer/id #uuid "9d91dbe3-c6c4-5402-85f2-5aebe1228361" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389500} {:answer/id #uuid "0a2b9d9e-a55d-5269-90e7-268bfa853936" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389501} {:answer/id #uuid "c2ba81b1-55ae-50e5-9a14-d540f92d66ea" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389502}] :answer-field/correct {:answer/id #uuid "9d91dbe3-c6c4-5402-85f2-5aebe1228361" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389500} :answer-field/id #uuid "525e80e6-2970-531f-b670-bb348fa022c2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389497}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "677a6071-7ce4-5abc-a513-660a8ad8e603" :question/math-academy-id "q-164142" :question/problem "A rectangular plate of mass $\\frac{3}{2}\\,\\text{kg}$ and uniform mass density occupies the region\n$D={(x,y)\\,:\\,-1\\le x\\le 1,\\,0\\le y\\le 2},$\nwhere $x$ and $y$ are measured in meters.\nFind the moment of inertia of the plate about a line perpendicular to $D$ at a distance of $\\sqrt{6}\\,\\text{m}$ from a parallel line passing through its center of mass." :question/worked-solution "For a plane lamina of mass $M$ and a line ${l}_{M}$ perpendicular to the lamina passing through its center of mass, the parallel axis theorem states that the moment of inertia of the lamina about a line $l$ parallel to ${l}_{M}$ is given by\n\n$$\n{I}_{l}={I}_{M}+{d}^{2}M,\n$$\n\nwhere $d$ is the distance between the lines, and ${I}_{M}$ and ${I}_{l}$ are the moments of inertia about the lines ${l}_{M}$ and $l,$ respectively.\n\nThe area of the rectangular plate $D$ is $A=2\\cdot 2=4\\,{\\text{m}}^{2}.$\nSince the plate has a uniform density, the mass density function is given by\n\n$$\n\\lambda (x,y)=\\frac{M}{A}=\\frac{(\\frac{3}{2})}{4}=\\frac{3}{8}\\,\\text{kg}/{\\text{m}}^{2},\n$$\n\nand its center of mass is its centroid:\n\n$$\n(\\overset{¯}{x},\\overset{¯}{y})=(\\frac{-1+1}{2},\\frac{0+2}{2})=(0,1)\n$$\n\nThen, the moment of inertia about the perpendicular line through the center of mass is\n\n$$\n\\begin{aligned}{I}_{M} & ={∬}_{D}((x-\\overset{¯}{x})^{2}+(y-\\overset{¯}{y})^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & =\\frac{1}{8}{\\int }_{-1}^{1}{\\int }_{0}^{2}3{x}^{2}+3(y-1)^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{1}{8}{\\int }_{-1}^{1}{[3{x}^{2}y+(y-1)^{3}]}_{y=0}^{y=2}\\,\\text{d}x \\\\  & =\\frac{1}{8}{\\int }_{-1}^{1}6{x}^{2}+2\\,\\text{d}x \\\\  & =\\frac{1}{8}{[2{x}^{3}+2x]}_{-1}^{1} \\\\  & =\\frac{1}{8}(2+2-(-2-2)) \\\\  & =1\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$\n\nFinally, applying the parallel axis theorem, the moment of inertia about a line $\\sqrt{6}\\,\\text{m}$ from the center of mass is\n\n$$\n\\begin{aligned}I & ={I}_{M}+{d}^{2}M \\\\  & =1+{(\\sqrt{6})}^{2}\\cdot \\frac{3}{2} \\\\  & =1+9 \\\\  & =10\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186389503 :knowledge-point/_questions [{:knowledge-point/id #uuid "21f203c5-4866-5077-9ef9-0d2122581c4f" :knowledge-point/title "Calculating a Moment of Inertia of a Rectangular Plate About a Perpendicular Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c30d2a3-e06b-50c4-99ad-bf1c23c38c3b" :answer/type {:db/ident :answer.type/math} :answer/value "19\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389505} {:answer/id #uuid "da5e3918-bbb8-54d5-8d14-12ed1ce8da12" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389506} {:answer/id #uuid "d978a27c-4cb5-55a0-92a9-74eda2d5f58f" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389507} {:answer/id #uuid "d6e5818b-5846-5d89-a311-73ed695522ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389508} {:answer/id #uuid "44ad420e-5cbd-5f25-8e01-134e784e36c2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{3}\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389509}] :answer-field/correct {:answer/id #uuid "8c30d2a3-e06b-50c4-99ad-bf1c23c38c3b" :answer/type {:db/ident :answer.type/math} :answer/value "19\\,\\text{kg}\\cdot {\\text{m}}^{2}" :db/id #edb/ref 17592186389505} :answer-field/id #uuid "647cfa17-f0ad-5abd-9877-f316086b5810" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389504}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb6e2375-c7b1-5f37-b50b-167a66de4a06" :question/math-academy-id "q-164147" :question/problem "A rectangular plate occupies the region\n$D={(x,y)\\,:\\,0\\le x\\le 3,\\,0\\le y\\le 2}$\nand has mass density function $\\lambda (x,y)=2x,$ where $x$ and $y$ are measured in meters.\nGiven that the center of mass is at $(2,1),$ find the moment of inertia about a line perpendicular to $D$ at a distance of $\\frac{\\sqrt{2}}{3}\\,\\text{m}$ from a parallel line passing through its center of mass." :question/worked-solution "For a plane lamina of mass $M$ and a line ${l}_{M}$ perpendicular to the lamina passing through its center of mass, the parallel axis theorem states that the moment of inertia of the lamina about a line $l$ parallel to ${l}_{M}$ is given by\n\n$$\n{I}_{l}={I}_{M}+{d}^{2}M,\n$$\n\nwhere $d$ is the distance between the lines, and ${I}_{M}$ and ${I}_{l}$ are the moments of inertia about the lines ${l}_{M}$ and $l,$ respectively.\n\nFirst, we find the mass of the plate as follows:\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2x\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}2x\\,\\text{d}x{\\int }_{0}^{2}\\,\\text{d}y \\\\  & ={x}^{2}{|}_{0}^{3}\\cdot y{|}_{0}^{2} \\\\  & =9\\cdot 2 \\\\  & =18\\end{aligned}\n$$\n\nNext, the moment of inertia about the perpendicular line through the center of mass $(2,1)$ is\n\n$$\n\\begin{aligned}{I}_{M} & ={∬}_{D}((x-\\overset{¯}{x})^{2}+(y-\\overset{¯}{y})^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & ={∬}_{D}((x-2)^{2}+(y-1)^{2})\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}((x-2)^{2}+(y-1)^{2})2x\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2x(x-2)^{2}+2x(y-1)^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}{[2x(x-2)^{2}y+\\frac{2}{3}x(y-1)^{3}]}_{y=0}^{y=2}\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}4x(x-2)^{2}+\\frac{4}{3}x\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}4{x}^{3}-16{x}^{2}+16x+\\frac{4}{3}x\\,\\text{d}x \\\\  & ={\\int }_{0}^{3}4{x}^{3}-16{x}^{2}+\\frac{52}{3}x\\,\\text{d}x \\\\  & ={[{x}^{4}-\\frac{16}{3}{x}^{3}+\\frac{26}{3}{x}^{2}]}_{0}^{3} \\\\  & =81-144+78-0 \\\\  & =15\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$\n\nFinally, applying the parallel axis theorem, the moment of inertia about a line $\\frac{\\sqrt{2}}{3}\\,\\text{m}$ from the center of mass is\n\n$$\n\\begin{aligned}I & ={I}_{M}+{d}^{2}M \\\\  & =15+{(\\frac{\\sqrt{2}}{3})}^{2}\\cdot 18 \\\\  & =15+4 \\\\  & =19\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284463 :knowledge-point/_questions [{:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e" :knowledge-point/title "Identifying Properties of an Elliptic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "390f4661-5a0f-5b3f-b25c-eaa8c3ef06ce" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3 \\\\ y=1\\end{aligned}" :db/id #edb/ref 17592186282197} {:answer/id #uuid "6e27f0c3-12ef-5c96-a5ea-3ba6977f8de9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}" :db/id #edb/ref 17592186282640} {:answer/id #uuid "ac7a600c-728d-58b5-a4ed-d9bf939a6bd0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=3 \\\\ z=1\\end{aligned}" :db/id #edb/ref 17592186283187} {:answer/id #uuid "b04ade40-7746-536a-a6b3-6bb9700c6ec5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=0 \\\\ y=3\\end{aligned}" :db/id #edb/ref 17592186283219} {:answer/id #uuid "c0ce0e84-2eab-5071-9566-0c4afa412297" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=0 \\\\ z=3\\end{aligned}" :db/id #edb/ref 17592186283370}] :answer-field/correct {:answer/id #uuid "6e27f0c3-12ef-5c96-a5ea-3ba6977f8de9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}" :db/id #edb/ref 17592186282640} :answer-field/id #uuid "5bbe4e29-00c0-5dd6-8a3d-4a02a12fec6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284092}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03b953d0-f6a1-54cc-956c-27178aec298e" :question/math-academy-id "q-164269" :question/problem "Consider the elliptic paraboloid $x=\\frac{(y-3)^{2}}{2}+\\frac{(z+1)^{2}}{6}.$ Which of the following gives its axis of symmetry, written as an intersection of two planes?" :question/worked-solution "First, we write our equation as \n\n$$\nx-0=\\frac{(y-3)^{2}}{2}+\\frac{(z-(-1))^{2}}{6}.\n$$\n\nThis gives us the equation of an elliptic paraboloid oriented along the $x$-axis that has its vertex at $(0,3,-1).$\n Since it is oriented along the $x$-axis, we conclude that its axis of symmetry is parallel to the $x$-axis.\n\nThe axis of symmetry should pass through the vertex of the paraboloid. Therefore, the equation of the axis of symmetry can be written as an intersection of two planes:\n\n$$\n{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}\n$$"}]}
