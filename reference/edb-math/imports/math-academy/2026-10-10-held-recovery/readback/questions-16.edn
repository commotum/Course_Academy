owing picture:\n\n![](images/c0/c0bffb825fa5610288e3c88555a41c8124cf3538b2f75ebe627543a678ca3fba.png)"}] [{:db/id #edb/ref 17592186393569 :knowledge-point/_questions [{:knowledge-point/id #uuid "6e4f1675-9146-5279-9b64-07a63a9bed99" :knowledge-point/title "Finding a Vector Given Its Coordinates Relative To a Given Basis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f97709bf-462a-5864-8dd2-f66c76b54b4b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 \\\\ -11 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393571} {:answer/id #uuid "4c7a709b-66f3-500b-82c4-1d3593f99da3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 \\\\ -14 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393572} {:answer/id #uuid "cd985322-a0da-5d7c-9bb9-6891c94f4584" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 \\\\ 11 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393573} {:answer/id #uuid "fc54cf72-4225-5c22-ae45-c71d6e145a21" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 \\\\ 1 \\\\ 14\\end{aligned}]" :db/id #edb/ref 17592186393574} {:answer/id #uuid "2fe6a6e1-adb1-55bf-984d-d17353496e85" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 \\\\ 14 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393575}] :answer-field/correct {:answer/id #uuid "4c7a709b-66f3-500b-82c4-1d3593f99da3" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}11 \\\\ -14 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393572} :answer-field/id #uuid "eb4860ca-7e78-50db-8059-803d02e57c39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393570}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "caf9f205-8208-5fa1-98c3-950f88c7e14f" :question/math-academy-id "q-75958" :question/problem "Find the vector $x$, if $B={{b}_{1},{b}_{2}}$ is a basis of $\\text{Span}{{b}_{1},{b}_{2}},$ and \n\n$$\n{b}_{1}=[\\begin{aligned}-1 \\\\ 0 \\\\ -5\\end{aligned}],\\,{b}_{2}=[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,[x]_{B}=[\\begin{aligned}3 \\\\ 7\\end{aligned}].\n$$" :question/worked-solution "We know that any vector in  $\\text{Span}{{b}_{1},{b}_{2}}$ has the form\n\n$$\n\\begin{aligned}{x}_{1}[\\begin{aligned}-1 \\\\ 0 \\\\ -5\\end{aligned}]+{x}_{2}[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nwhere ${x}_{1}$ and ${x}_{2}$ are the coordinates relative to the basis $\\,B.$ Since we are told that $[x]_{B}=[\\begin{aligned}3 \\\\ 7\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}x & ={{(\\,3\\,)}_{⏟}}_{{x}_{1}}[\\begin{aligned}-1 \\\\ 0 \\\\ -5\\end{aligned}]+{{(\\,7\\,)}_{⏟}}_{{x}_{2}}[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}]= \\\\  & =[\\begin{aligned}-3 \\\\ 0 \\\\ -15\\end{aligned}]+[\\begin{aligned}14 \\\\ -14 \\\\ 14\\end{aligned}] \\\\  & =[\\begin{aligned}11 \\\\ -14 \\\\ -1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393576 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b105609a-626e-5869-b128-d197a399d5d8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9+6\\text{i} \\\\ -9+3\\text{i} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186393578} {:answer/id #uuid "3de2a71d-db0b-5939-8da1-7ca8be090ca6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6+9\\text{i} \\\\ 3+9\\text{i} \\\\ -3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393579} {:answer/id #uuid "9b6cbc9a-09ac-5215-8c7d-54852633b7ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6-9\\text{i} \\\\ 3-9\\text{i} \\\\ -3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393580} {:answer/id #uuid "93b794e4-166e-521c-b5c2-17eea946b685" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393581} {:answer/id #uuid "90238b0d-fa91-54f4-a553-5d13bdfba4ee" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9-6\\text{i} \\\\ -9-3\\text{i} \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186393582}] :answer-field/correct {:answer/id #uuid "93b794e4-166e-521c-b5c2-17eea946b685" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393581} :answer-field/id #uuid "271612bf-2589-524c-8953-53d9f15d0df7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4302a7c6-021d-538a-9010-38418efea819" :question/math-academy-id "q-76039" :question/problem "If $\\,x=[\\begin{aligned}9-6\\text{i} \\\\ 9-3\\text{i} \\\\ -3\\end{aligned}]\\,$ then $\\,\\overset{―}{x}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}9-6\\text{i} \\\\ 9-3\\text{i} \\\\ -3\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{9-6\\text{i}} \\\\ \\overset{―}{9-3\\text{i}} \\\\ \\overset{―}{-3}\\end{aligned}] \\\\  & =[\\begin{aligned}9+6\\text{i} \\\\ 9+3\\text{i} \\\\ -3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393583 :knowledge-point/_questions [{:knowledge-point/id #uuid "3e806aac-62fc-5c53-a15e-a2ce175dad25" :knowledge-point/title "Determining Open Intervals of Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "506667f4-1745-5e4d-85a9-7600caf82729" :answer/type {:db/ident :answer.type/image} :answer/value "images/27/27cc3b76baa60c48f103f7d016bb78716330dbb03be791458489e5458bf326bd.png" :db/id #edb/ref 17592186393585} {:answer/id #uuid "0ba3e508-a2c3-510a-a873-37949da99395" :answer/type {:db/ident :answer.type/image} :answer/value "images/c5/c56ea94b0d5102c276d7cd4a196517a41611e3f7da82b3ab13c6b404c31cf430.png" :db/id #edb/ref 17592186393586} {:answer/id #uuid "8cfe7aac-2e56-5220-a210-68874685d980" :answer/type {:db/ident :answer.type/image} :answer/value "images/59/59bc174fabd3f93321505a54f05832fda46914c8f8f8ad5e88690f53bef3e845.png" :db/id #edb/ref 17592186393587} {:answer/id #uuid "dde21ed5-68b8-5e4d-8274-2b62e50ca71a" :answer/type {:db/ident :answer.type/image} :answer/value "images/47/47dca98b1ac1c7d3310418c3d5eaf58416827aaa5d97d118aa5f3b4a6d59d9f8.png" :db/id #edb/ref 17592186393588} {:answer/id #uuid "daafc43e-468c-51ed-8556-5bcac5a8828f" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c6cfdc41036d1dc319054c0cf397276f40faa2c749ea59820b45875cb31b3d9f.png" :db/id #edb/ref 17592186393589}] :answer-field/correct {:answer/id #uuid "daafc43e-468c-51ed-8556-5bcac5a8828f" :answer/type {:db/ident :answer.type/image} :answer/value "images/c6/c6cfdc41036d1dc319054c0cf397276f40faa2c749ea59820b45875cb31b3d9f.png" :db/id #edb/ref 17592186393589} :answer-field/id #uuid "9d67e4e9-9e71-5de1-b090-03f1f092f56a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393584}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8055c33-18c1-54b4-a55d-b97e3d2f96f4" :question/math-academy-id "q-76091" :question/problem "Which of the following functions is continuous on the interval $(-2,\\infty )?$ You may assume that all points of discontinuity for each function are shown." :question/worked-solution "The correct answer is the following.\n\n  \n\n![](images/c6/c6cfdc41036d1dc319054c0cf397276f40faa2c749ea59820b45875cb31b3d9f.png)\n\n    \n\nIndeed, we have that $h(x)$ is continuous on the open interval $(-2,\\infty ).$\n\nNotice that:\n\n- $f(x)$ is not continuous at $x=0,$ but this point lies within the interval $(-2,\\infty ),$\n\n- $q(x)$ and $p(x)$ are not continuous at $x=1,$ but this point lies within the interval $(-2,\\infty ),$\n\n- $g(x)$is not continuous at $x=2,$ but this point lies within the interval $(-2,\\infty ).$"}] [{:db/id #edb/ref 17592186393590 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e5c72b2-290f-5867-aff1-f44b222e372d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393592} {:answer/id #uuid "92b33271-0fa4-553d-a1ab-66985b701f62" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 6 \\\\ -1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393593} {:answer/id #uuid "01d9e892-9ecc-5b10-9511-71135ba52589" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186393594} {:answer/id #uuid "48bb8ceb-d5f2-5ad5-bd55-119d025e8ba6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -6 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186393595} {:answer/id #uuid "466efbf9-c64b-5ebc-b990-de2ab1f13120" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393596}] :answer-field/correct {:answer/id #uuid "01d9e892-9ecc-5b10-9511-71135ba52589" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]" :db/id #edb/ref 17592186393594} :answer-field/id #uuid "5daf3dd3-3305-5d23-9005-c484c6593e98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58793c96-ddf8-519d-986f-39d6955284e1" :question/math-academy-id "q-76204" :question/problem "Find the real part of the matrix $A=[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ -\\text{i} & 4\\end{aligned}] \\\\  & =[\\begin{aligned}1+2\\text{i} & 7-6\\text{i} \\\\ 0-\\text{i} & 4+0\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}2 & -6 \\\\ -1 & 0\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=[\\begin{aligned}1 & 7 \\\\ 0 & 4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186393597 :knowledge-point/_questions [{:knowledge-point/id #uuid "3c28b8ae-71ef-5d26-895a-5d949fc5b164" :knowledge-point/title "Computing Components of the Real and Imaginary Parts of a Complex Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f91efe47-c414-52f8-bc86-8a189c40c2e5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 2 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186393599} {:answer/id #uuid "30a56c3f-d31b-563d-b9c7-ee2b290b61e7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 7 & 9\\end{aligned}]" :db/id #edb/ref 17592186393600} {:answer/id #uuid "12b20b64-6e3a-5104-bf3e-4f927cf2f0ae" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 7 & 9\\end{aligned}]" :db/id #edb/ref 17592186393601} {:answer/id #uuid "06ec699a-1e91-54af-a017-f35c024e321f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186393602} {:answer/id #uuid "5986f990-a25f-5cd6-86fe-190f4da1ab31" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186393603}] :answer-field/correct {:answer/id #uuid "06ec699a-1e91-54af-a017-f35c024e321f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}]" :db/id #edb/ref 17592186393602} :answer-field/id #uuid "da90fce8-ef02-562a-85b1-9e69bcade1cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393598}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a77c2c81-cff7-529c-9b2c-c83e582864a2" :question/math-academy-id "q-76205" :question/problem "Find the real part of the matrix $A=[\\begin{aligned}2-3\\text{i} & 2\\text{i} \\\\ 7 & -9+4\\text{i}\\end{aligned}].$" :question/worked-solution "For the given matrix $A,$ we have that\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2-3\\text{i} & 2\\text{i} \\\\ 7 & -9+4\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}2-3\\text{i} & 0+2\\text{i} \\\\ 7+0\\text{i} & -9+4\\text{i}\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}]}_{⏟}}_{\\text{Re}(A)}+\\text{i}{{[\\begin{aligned}-3 & 2 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{\\text{Im}(A)}.\\end{aligned}\n$$\n\nTherefore, $\\text{Re}(A)=[\\begin{aligned}2 & 0 \\\\ 7 & -9\\end{aligned}].$"}] [{:db/id #edb/ref 17592186393604 :knowledge-point/_questions [{:knowledge-point/id #uuid "83fad21d-6b36-5198-a13f-362d34342475" :knowledge-point/title "Multiplying Complex Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ddfb309-03f1-5086-b134-9a300a1e4991" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5+9\\text{i} & 9-13\\text{i} \\\\ 10+5\\text{i} & 14-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393606} {:answer/id #uuid "fde0ddb4-cac3-5fbb-b0e8-ee77e56d4d13" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10+5\\text{i} & 14-3\\text{i} \\\\ -5+9\\text{i} & 9-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393607} {:answer/id #uuid "565144e9-65e3-5c8e-b095-b218ef949235" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5+9\\text{i} & 14-3\\text{i} \\\\ 10+5\\text{i} & 9-13\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393608} {:answer/id #uuid "d3ca5b76-d9a3-5bd3-96bd-948909e64409" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}14-3\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 10+5\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393609} {:answer/id #uuid "73837f27-75b0-552d-920f-58cabd54c6a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393610}] :answer-field/correct {:answer/id #uuid "73837f27-75b0-552d-920f-58cabd54c6a5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393610} :answer-field/id #uuid "416179a7-3219-5ce9-9303-152f6654f152" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eaa32e2e-c807-5da3-b10a-a7704147713e" :question/math-academy-id "q-76217" :question/problem "If $\\,A=[\\begin{aligned}2-3\\text{i} & \\text{i} \\\\ 3 & -1-\\text{i}\\end{aligned}]\\,$ and $\\,B=[\\begin{aligned}2\\text{i} & 5 \\\\ 1-4\\text{i} & 2+\\text{i}\\end{aligned}]\\,$, then $AB=$" :question/worked-solution "Multiplying the matrices using the usual method, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}2-3\\text{i} & \\text{i} \\\\ 3 & -1-\\text{i}\\end{aligned}]\\cdot [\\begin{aligned}2\\text{i} & 5 \\\\ 1-4\\text{i} & 2+\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}(2-3\\text{i})\\cdot 2\\text{i}+\\text{i}\\cdot (1-4\\text{i}) & (2-3\\text{i})\\cdot 5+\\text{i}\\cdot (2+\\text{i}) \\\\ 3\\cdot 2\\text{i}+(-1-\\text{i})(1-4\\text{i}) & 3\\cdot 5+(-1-\\text{i})(2+\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(4\\text{i}+6)+(\\text{i}+4) & (10-15\\text{i})+(2\\text{i}-1) \\\\ 6\\text{i}+(-5+3\\text{i}) & 15+(-1-3\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}10+5\\text{i} & 9-13\\text{i} \\\\ -5+9\\text{i} & 14-3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393611 :knowledge-point/_questions [{:knowledge-point/id #uuid "b72ed196-a73b-59ab-a7c3-5173249cf7e5" :knowledge-point/title "Determining Whether a Given Set Is a Basis of a Span"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055847cf-222d-5b6d-b530-7df87e4ed599" :answer/type {:db/ident :answer.type/text} :answer/value "${{a}_{1},{a}_{2},{a}_{3}}$ is not a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}$" :db/id #edb/ref 17592186393613} {:answer/id #uuid "35810efb-a510-5aed-937c-48fb65cdb63e" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186393614} {:answer/id #uuid "e322a79b-f110-5075-b2f5-62a7d1641fb3" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186393615} {:answer/id #uuid "2bceb186-ae57-57a0-930b-57a4ec336dbd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186393616} {:answer/id #uuid "544c3cc2-09c7-5d78-af3a-b25e0a7e31e3" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186393617}] :answer-field/correct {:answer/id #uuid "544c3cc2-09c7-5d78-af3a-b25e0a7e31e3" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186393617} :answer-field/id #uuid "316a16bb-3355-560b-8385-5e18d3057595" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393612}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ef511b09-5e7a-518d-9267-82fcd4cf2031" :question/math-academy-id "q-76331" :question/problem "The vectors ${a}_{1},$ ${a}_{2},$ ${a}_{3},$ and ${a}_{4}$ are given below. Determine whether $B={{a}_{1},{a}_{2},{a}_{3}}$ is a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$ If that is the case, find ${x}_{1}+{x}_{2}+{x}_{3},$ where ${a}_{4}={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 6\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 2 \\\\ -6\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}1 \\\\ -1 \\\\ 7\\end{aligned}],\\,{a}_{4}=[\\begin{aligned}-3 \\\\ 3 \\\\ -16\\end{aligned}]\n$$" :question/worked-solution "We want to determine if $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$ So, we want to find ${x}_{1},{x}_{2},{x}_{3}\\in R$ such that \n\n$$\n{x}_{1}{{[\\begin{aligned}1 \\\\ -1 \\\\ 6\\end{aligned}]}_{⏟}}_{{a}_{1}}+{x}_{2}{{[\\begin{aligned}-1 \\\\ 2 \\\\ -6\\end{aligned}]}_{⏟}}_{{a}_{2}}+{x}_{3}{{[\\begin{aligned}1 \\\\ -1 \\\\ 7\\end{aligned}]}_{⏟}}_{{a}_{3}}={{[\\begin{aligned}-3 \\\\ 3 \\\\ -16\\end{aligned}]}_{⏟}}_{{a}_{4}}.\n$$\n\nThis equation is equivalent to the system\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+{x}_{3}=-3 \\\\ -{x}_{1}+2{x}_{2}-{x}_{3}=3 \\\\ 6{x}_{1}-6{x}_{2}+7{x}_{3}=-16\\end{aligned}\n$$\n\nNow, we reduce the augmented matrix of the system to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned} & \\,\\,[\\begin{aligned}1 & -1 & 1 & -3 \\\\ -1 & 2 & -1 & 3 \\\\ 6 & -6 & 7 & -16\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & -3 \\\\ 0 & 1 & 0 & 0 \\\\ 6 & -6 & 7 & -16\\end{aligned}] & {R}_{3} & :={R}_{3}+(-6){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & -3 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 2\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & -5 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 2\\end{aligned}] & {R}_{1} & :={R}_{1}+{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & -5 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nFrom the reduced matrix above, we see that the pivot columns are the $1$st, $2$nd, and $3$rd columns. So,  $B$ is indeed a basis of $\\text{Span}{{a}_{1},{a}_{2},{a}_{3},{a}_{4}}.$\nAlso, the matrix tells us that ${x}_{1}=-5,$ ${x}_{2}=0,$ and ${x}_{3}=2,$ meaning that\n\n$$\n(-5)\\cdot {{[\\begin{aligned}1 \\\\ -1 \\\\ 6\\end{aligned}]}_{⏟}}_{{a}_{1}}+0\\cdot {{[\\begin{aligned}-1 \\\\ 2 \\\\ -6\\end{aligned}]}_{⏟}}_{{a}_{2}}+2\\cdot {{[\\begin{aligned}1 \\\\ -1 \\\\ 7\\end{aligned}]}_{⏟}}_{{a}_{3}}={{[\\begin{aligned}-3 \\\\ 3 \\\\ -16\\end{aligned}]}_{⏟}}_{{a}_{4}}.\n$$\n\nTherefore, ${x}_{1}+{x}_{2}+{x}_{3}=(-5)+0+2=-3.$"}] [{:db/id #edb/ref 17592186152749 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e68ae67-2175-55a3-ac4a-117a340a32a4" :knowledge-point/title "Reducing the Line Integral of a Scalar Function Along a Curve to a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c31779c1-61a9-5ddf-9ce4-388acac151e1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393619} {:answer/id #uuid "b35b8c73-b6e1-55f6-a3a8-1f84f618409d" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393620} {:answer/id #uuid "d14288db-cd96-5f69-9f29-fa682d61a4a3" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{-\\pi /4}^{\\pi /4}{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393621} {:answer/id #uuid "f83c51d2-6855-5059-8910-c179f8d7f6c5" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393622} {:answer/id #uuid "865a2778-efa4-5860-8c94-4fab14e1e597" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393623}] :answer-field/correct {:answer/id #uuid "b35b8c73-b6e1-55f6-a3a8-1f84f618409d" :answer/type {:db/ident :answer.type/math} :answer/value "4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta " :db/id #edb/ref 17592186393620} :answer-field/id #uuid "8116cea9-3c1b-5e81-a58c-b2147c4e208d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fda4f6af-c917-5961-9062-323f1cdf3aeb" :question/math-academy-id "q-76355" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}{x}^{2}y\\,\\text{d}s,$ where $C$ is the section of the polar curve $r=\\sqrt{2}$ for $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}?$" :question/worked-solution "In polar coordinates, the formula for the line integral is given by\n\n$$\n{\\int }_{C}f(x,y)\\,\\text{d}s={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta \\,.\n$$\n\n \n\nThe connection between polar and Cartesian coordinates gives\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =\\sqrt{2}\\operatorname{cos}⁡\\theta , \\\\ y & =r\\operatorname{sin}⁡\\theta =\\sqrt{2}\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSo, along our curve, we have $x=\\sqrt{2}\\operatorname{cos}⁡\\theta $ and $y=\\sqrt{2}\\operatorname{sin}⁡\\theta $, where $-\\frac{\\pi }{4}\\le \\theta \\le \\frac{\\pi }{4}.$\n\nNow, if $f(x,y)={x}^{2}y$, we obtain\n\n$$\n\\begin{aligned}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ) & =(\\sqrt{2}\\operatorname{cos}⁡\\theta )^{2}\\cdot \\sqrt{2}\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(\\sqrt{2})=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{(\\sqrt{2})^{2}+{0}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}y\\,\\text{d}s & ={\\int }_{-\\pi /4}^{\\pi /4}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}2\\sqrt{2}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\cdot \\sqrt{2}\\cdot \\text{d}\\theta  \\\\  & =4{\\int }_{-\\pi /4}^{\\pi /4}\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393624 :knowledge-point/_questions [{:knowledge-point/id #uuid "28f7479a-a84c-59fa-a7ea-9377c7e65b19" :knowledge-point/title "Writing the Line Integral of a Scalar Function as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f72ef384-5e6e-52c5-839e-3beee185405e" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2}{t}^{2}\\sqrt{t+1}\\,\\text{d}t" :db/id #edb/ref 17592186393626} {:answer/id #uuid "42147aee-d1b6-54a9-a34c-6883f2cfc5ab" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}{\\int }_{0}^{2}{t}^{3}\\,\\text{d}t" :db/id #edb/ref 17592186393627} {:answer/id #uuid "38308454-7a76-5601-988c-cc81a2d49d69" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{2}({t}^{2}-t)\\sqrt{t+1}\\,\\text{d}t" :db/id #edb/ref 17592186393628} {:answer/id #uuid "9d940168-caf2-55dc-abc9-6478a8eb7fed" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{2}{t}^{2}\\sqrt{{t}^{2}-t}\\,\\text{d}t" :db/id #edb/ref 17592186393629} {:answer/id #uuid "89f9a881-2016-5d9d-b0c2-417ca0dbf7d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}{\\int }_{0}^{2}{t}^{2}\\sqrt{{t}^{2}+1}\\,\\text{d}t" :db/id #edb/ref 17592186393630}] :answer-field/correct {:answer/id #uuid "42147aee-d1b6-54a9-a34c-6883f2cfc5ab" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}{\\int }_{0}^{2}{t}^{3}\\,\\text{d}t" :db/id #edb/ref 17592186393627} :answer-field/id #uuid "dc0d4305-f486-5b23-8a23-7975fef766e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9dd51c2a-c921-500f-b456-d9efa51cbc02" :question/math-academy-id "q-76356" :question/problem "Which of the following is equivalent to ${\\int }_{C}f(x,y,z)\\,\\text{d}s,$ where $f(x,y,z)=x+y-z$ and the curve $C$ is parametrized by $r(t)=⟨{t}^{2}+1,\\,{t}^{2}-1,\\,{t}^{2}⟩$ for $t\\in [0,2]?$" :question/worked-solution "Since $r(t)=⟨{t}^{2}+1,\\,{t}^{2}-1,\\,{t}^{2}⟩,$ then along the curve we have $x={t}^{2}+1,$ $y={t}^{2}-1,$ and $z={t}^{2}.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+1)i+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})k \\\\  & =2t\\,i+2t\\,j+2t\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(2t)^{2}+(2t)^{2}+(2t)^{2}} \\\\  & =\\sqrt{4{t}^{2}+4{t}^{2}+4{t}^{2}} \\\\  & =\\sqrt{12{t}^{2}} \\\\  & =2\\sqrt{3}|t| \\\\  & =2\\sqrt{3}t\\end{aligned}\n$$\n\nNotice that $|t|=t$ since $t>0$ along the path of $C.$\n\nNow, since $f(x,y,z)=x+y-z$, we obtain \n\n$$\n\\begin{aligned}f(r(t)) & =({t}^{2}+1)+({t}^{2}-1)-{t}^{2} \\\\  & =2{t}^{2}-{t}^{2} \\\\  & ={t}^{2}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y,z)\\,\\text{d}s & ={\\int }_{0}^{2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}{t}^{2}\\cdot 2\\sqrt{3}t\\cdot \\text{d}t \\\\  & =2\\sqrt{3}{\\int }_{0}^{2}{t}^{3}\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393631 :knowledge-point/_questions [{:knowledge-point/id #uuid "28f7479a-a84c-59fa-a7ea-9377c7e65b19" :knowledge-point/title "Writing the Line Integral of a Scalar Function as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa31ddbb-d2dc-5e24-b119-3e57906a0e43" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡t\\sqrt{2{cos}^{2}⁡t+1}\\,\\text{d}t" :db/id #edb/ref 17592186393633} {:answer/id #uuid "6e191add-76d4-52b0-a4d0-b55782dad06f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡2t\\,\\text{d}t" :db/id #edb/ref 17592186393634} {:answer/id #uuid "e78b94bc-a9b3-5508-8e70-1864ef024d69" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}{\\int }_{0}^{\\pi /2}t\\operatorname{sin}⁡t\\sqrt{2{cos}^{2}⁡t+3}\\,\\text{d}t" :db/id #edb/ref 17592186393635} {:answer/id #uuid "0c7e2485-49a8-54d2-9942-acfa1e262b9a" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}t(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\,\\text{d}t" :db/id #edb/ref 17592186393636} {:answer/id #uuid "1e167558-c450-5d8c-885f-dd7f2edd9925" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{0}^{\\pi /2}t(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}\\,\\text{d}t" :db/id #edb/ref 17592186393637}] :answer-field/correct {:answer/id #uuid "6e191add-76d4-52b0-a4d0-b55782dad06f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}{\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡2t\\,\\text{d}t" :db/id #edb/ref 17592186393634} :answer-field/id #uuid "80947165-9047-5b9a-b812-2946d21a42e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfad2296-6fbf-598f-a4ed-63e51e9c1622" :question/math-academy-id "q-76379" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}z({x}^{2}-{y}^{2})\\,\\text{d}s,$ where the curve $C$ is parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k$ for $\\,0\\le t\\le \\frac{\\pi }{2}?$" :question/worked-solution "Since $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j\\,+t\\,k,$ then along the curve we have $x=\\operatorname{cos}⁡t,$ $y=\\operatorname{sin}⁡t,$ and $z=t.$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)j+\\frac{\\text{d}}{\\text{d}t}(t)k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}+{(\\frac{\\text{d}z}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+{1}^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\n  \n\nNow, if $f(x,y,z)=z({x}^{2}-{y}^{2})$, then we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =t((\\operatorname{cos}⁡t)^{2}-(\\operatorname{sin}⁡t)^{2}) \\\\  & =t({cos}^{2}⁡t-{sin}^{2}⁡t) \\\\  & =t\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as  \n\n$$\n\\begin{aligned}{\\int }_{C}z({x}^{2}-{y}^{2})\\,\\text{d}s & ={\\int }_{0}^{\\pi /2}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡2t\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{\\pi /2}t\\operatorname{cos}⁡2t\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393638 :knowledge-point/_questions [{:knowledge-point/id #uuid "e381c74c-43ed-5588-ba9a-4c7d4fb2caf3" :knowledge-point/title "Reducing the Line Integral of a Scalar Function Along a Curve to a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2e9fe12-5a49-5cf9-b012-fcba654bd637" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{3}{t}^{2}\\operatorname{sin}⁡t\\,\\sqrt{1+16{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393640} {:answer/id #uuid "c7f9e28f-b116-5dc9-bfc1-d22e6a40e66d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{3}\\operatorname{sin}⁡t\\,\\sqrt{1+16{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393641} {:answer/id #uuid "cb9a5fda-9fc2-5b75-88d6-5bd14514645d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{1}^{3}{t}^{2}\\operatorname{sin}⁡t\\,\\sqrt{1+4{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393642} {:answer/id #uuid "292fcdb3-4498-583c-a418-678575e5fc2b" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{3}{t}^{2}\\,\\sqrt{1+16{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393643} {:answer/id #uuid "a1ed3151-e00c-5729-999b-09315df7e63a" :answer/type {:db/ident :answer.type/math} :answer/value "8{\\int }_{1}^{3}t\\operatorname{sin}⁡{t}^{2}\\,\\sqrt{\\frac{1}{16}+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393644}] :answer-field/correct {:answer/id #uuid "b2e9fe12-5a49-5cf9-b012-fcba654bd637" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{3}{t}^{2}\\operatorname{sin}⁡t\\,\\sqrt{1+16{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393640} :answer-field/id #uuid "29355480-d561-5402-87be-6ad89cacf22a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393639}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05201083-bb4f-5259-a034-25bea0f3366d" :question/math-academy-id "q-76415" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}y\\operatorname{sin}⁡x\\,\\text{d}s,$ where $C$ is the section of the curve $y=2{x}^{2}$ between the points $(1,2)$ and $(3,18)?$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=2{t}^{2}.$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,2{t}^{2}⟩,\\,1\\le t\\le 3\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})j \\\\  & =i+4t\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+(4t)^{2}} \\\\  & =\\sqrt{1+16{t}^{2}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=y\\operatorname{sin}⁡x$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2{t}^{2}\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{1}^{3}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{3}2{t}^{2}\\operatorname{sin}⁡t\\cdot \\sqrt{1+16{t}^{2}}\\cdot \\text{d}t \\\\  & =2{\\int }_{1}^{3}{t}^{2}\\operatorname{sin}⁡t\\,\\sqrt{1+16{t}^{2}}\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393645 :knowledge-point/_questions [{:knowledge-point/id #uuid "e381c74c-43ed-5588-ba9a-4c7d4fb2caf3" :knowledge-point/title "Reducing the Line Integral of a Scalar Function Along a Curve to a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78a790d8-2140-59aa-86ff-52166be0d010" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2e}{t}^{2}\\sqrt{1+\\frac{1}{{t}^{3}}}\\,\\text{d}t" :db/id #edb/ref 17592186393647} {:answer/id #uuid "452151d4-b05a-5d00-99ac-20d73276935d" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2e}{t}^{2}\\sqrt{1+\\frac{1}{{t}^{2}}}\\,\\text{d}t" :db/id #edb/ref 17592186393648} {:answer/id #uuid "d4046c06-2a9c-5bbc-a134-0a1426134bb4" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2e}{t}^{3}\\sqrt{1+\\frac{1}{{t}^{2}}}\\,\\text{d}t" :db/id #edb/ref 17592186393649} {:answer/id #uuid "29b1e305-c19d-55f1-931a-27886d406f4f" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2e}{t}^{3}\\sqrt{1+{t}^{2}}\\,\\text{d}t" :db/id #edb/ref 17592186393650} {:answer/id #uuid "3bcca11d-81b0-5384-bef0-3c0f81491037" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2e}{t}^{3}\\sqrt{1+\\frac{1}{t}}\\,\\text{d}t" :db/id #edb/ref 17592186393651}] :answer-field/correct {:answer/id #uuid "d4046c06-2a9c-5bbc-a134-0a1426134bb4" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\int }_{1}^{2e}{t}^{3}\\sqrt{1+\\frac{1}{{t}^{2}}}\\,\\text{d}t" :db/id #edb/ref 17592186393649} :answer-field/id #uuid "c3f4c7fa-4002-5f8d-ab91-0f4b56e599c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99fdd141-25ed-55d8-bec8-14b1e001a397" :question/math-academy-id "q-76416" :question/problem "Which of the following is equivalent to the integral ${\\int }_{C}2{x}^{2}{e}^{y}\\,\\text{d}s,$ where $C$ is the section of the curve $y=\\operatorname{ln}⁡(x)$ for $\\,1\\le x\\le 2e?$" :question/worked-solution "Notice that the given curve is of the form $y=y(x).$ Therefore, by setting $x=t,$ we have $y=y(t)=\\operatorname{ln}⁡(t).$ This gives the following parametrization of the curve:\n\n$$\nr(t)=⟨t,\\operatorname{ln}⁡(t)⟩,\\,1\\le t\\le 2e\n$$\n\nComputing ${r}^{′}(t)$ and $‖{r}^{′}(t)‖,$ we get the following:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t))j \\\\  & =i+\\frac{1}{t}\\,j \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{(\\frac{1}{t})}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{{t}^{2}}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=2{x}^{2}{e}^{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =2{t}^{2}\\cdot {e}^{\\operatorname{ln}⁡t}=2{t}^{3}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as \n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{1}^{2e}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{2e}2{t}^{3}\\cdot \\sqrt{1+\\frac{1}{{t}^{2}}}\\cdot \\text{d}t \\\\  & =2{\\int }_{1}^{2e}{t}^{3}\\sqrt{1+\\frac{1}{{t}^{2}}}\\,\\text{d}t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393652 :knowledge-point/_questions [{:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93" :knowledge-point/title "Finding the Image of a Vector Under a Matrix Given Solutions to a Matrix ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb15603a-9694-5d49-8fa3-c155eb6d23cb" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}7{e}^{t} \\\\ -8{e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186393654} {:answer/id #uuid "e98c4df4-0a36-5e7d-993d-b26f66a0bd00" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-8{e}^{-t} \\\\ 7{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393655} {:answer/id #uuid "42eeb5ab-46a3-54f3-8b8e-cf24ae089513" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-8{e}^{t} \\\\ 7{e}^{-t}\\end{aligned}]" :db/id #edb/ref 17592186393656} {:answer/id #uuid "18c34730-d79a-5d95-a154-db1a6d24dbb6" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-7{e}^{-t} \\\\ 8{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393657} {:answer/id #uuid "6c157b59-b8cb-5f3f-b3c4-d1b126989916" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}8{e}^{-t} \\\\ -7{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393658}] :answer-field/correct {:answer/id #uuid "e98c4df4-0a36-5e7d-993d-b26f66a0bd00" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-8{e}^{-t} \\\\ 7{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393655} :answer-field/id #uuid "b712bb2a-7c8b-502a-856d-f5665ee3d522" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393653}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7660a51c-5da6-5b8b-a119-8b11e908a01d" :question/math-academy-id "q-76598" :question/problem "If $\\,u(t)=[\\begin{aligned}{e}^{-t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find $Aw(t)$ where $w(t)=[\\begin{aligned}8{e}^{-t} \\\\ 7{e}^{t}\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that \n\n$$\nw(t)=8u(t)+7v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(8{e}^{-t})^{′} \\\\ (7{e}^{t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}-8{e}^{-t} \\\\ 7{e}^{t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393659 :knowledge-point/_questions [{:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93" :knowledge-point/title "Finding the Image of a Vector Under a Matrix Given Solutions to a Matrix ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e404c47e-65c5-521e-8153-e065a1003378" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-5{e}^{2t} \\\\ 3{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393661} {:answer/id #uuid "6065e5ee-c01d-506a-a340-bce9a2dc4ef9" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-10{e}^{2t} \\\\ -9{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393662} {:answer/id #uuid "4b3a4455-1695-5a0b-9025-7f2ece9884a7" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-9{e}^{-3t} \\\\ -10{e}^{2t}\\end{aligned}]" :db/id #edb/ref 17592186393663} {:answer/id #uuid "56960d8a-32cb-55f3-a9bd-ce136dba37ea" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}15{e}^{-3t} \\\\ 6{e}^{2t}\\end{aligned}]" :db/id #edb/ref 17592186393664} {:answer/id #uuid "2507b323-ad23-54c6-b4d8-76520d1a7145" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}15{e}^{2t} \\\\ 6{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393665}] :answer-field/correct {:answer/id #uuid "6065e5ee-c01d-506a-a340-bce9a2dc4ef9" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-10{e}^{2t} \\\\ -9{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393662} :answer-field/id #uuid "6334399e-bf39-5741-b762-306133e6e815" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393660}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2421cf2f-56d3-50d4-8cad-77b6f9e85ce2" :question/math-academy-id "q-76599" :question/problem "If $\\,u(t)=[\\begin{aligned}{e}^{2t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{-3t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find $Aw(t)$ where $w(t)=[\\begin{aligned}-5{e}^{2t} \\\\ 3{e}^{-3t}\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that \n\n$$\nw(t)=-5u(t)+3v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(-5{e}^{2t})^{′} \\\\ (3{e}^{-3t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}-10{e}^{2t} \\\\ -9{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393666 :knowledge-point/_questions [{:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93" :knowledge-point/title "Finding the Image of a Vector Under a Matrix Given Solutions to a Matrix ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46984b47-2c2e-5d5e-8853-8d21152030c8" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}20{e}^{-5t} \\\\ 18{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393668} {:answer/id #uuid "2796b883-2354-5261-8fe3-d13f5316591d" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}20{e}^{-3t} \\\\ 18{e}^{-5t}\\end{aligned}]" :db/id #edb/ref 17592186393669} {:answer/id #uuid "3692dee3-45b9-5922-9e52-0a000ffdd1e4" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}30{e}^{-5t} \\\\ 12{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393670} {:answer/id #uuid "aa019a90-c433-550f-bc4a-49f7196227df" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}30{e}^{-3t} \\\\ 12{e}^{-5t}\\end{aligned}]" :db/id #edb/ref 17592186393671} {:answer/id #uuid "43e8d618-a672-5f29-b672-6cf6d04c2833" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-4{e}^{-5t} \\\\ -6{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393672}] :answer-field/correct {:answer/id #uuid "46984b47-2c2e-5d5e-8853-8d21152030c8" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}20{e}^{-5t} \\\\ 18{e}^{-3t}\\end{aligned}]" :db/id #edb/ref 17592186393668} :answer-field/id #uuid "61e343c4-069d-53a1-b0f9-8f120b5523a6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393667}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f6678b6-2c25-5e0a-b02d-0f73823bf62a" :question/math-academy-id "q-76602" :question/problem "If $\\,u(t)=[\\begin{aligned}{e}^{-5t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{-3t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find $Aw(t)$ where $w(t)=[\\begin{aligned}-4{e}^{-5t} \\\\ -6{e}^{-3t}\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that \n\n$$\nw(t)=-4u(t)-6v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(-4{e}^{-5t})^{′} \\\\ (-6{e}^{-3t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}20{e}^{-5t} \\\\ 18{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393673 :knowledge-point/_questions [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07526999-b2d7-5770-8641-243a50492c86" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 7 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186393675} {:answer/id #uuid "816b8577-b3aa-5d41-9837-c957436c891e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ -8 \\\\ -7\\end{aligned}]" :db/id #edb/ref 17592186393676} {:answer/id #uuid "4e9d0181-073d-5754-b165-50d89c9d2aa6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ 7 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186393677} {:answer/id #uuid "04acf1e1-cb01-585a-8d71-c37579f8b46c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-8 \\\\ -7 \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186393678} {:answer/id #uuid "5dd7bd41-3377-55c1-a2a4-f628887c060f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ -7 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186393679}] :answer-field/correct {:answer/id #uuid "5dd7bd41-3377-55c1-a2a4-f628887c060f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 \\\\ -7 \\\\ -8\\end{aligned}]" :db/id #edb/ref 17592186393679} :answer-field/id #uuid "4cb65eed-12b2-52c9-b5fe-b2abb4d404e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "829544bf-b531-5d37-b685-96d18a050590" :question/math-academy-id "q-77350" :question/problem "Find $Pv$ if \n$P=[\\begin{aligned}1 & -1 & 2 \\\\ 1 & -1 & 3 \\\\ 1 & -1 & 4\\end{aligned}]$\nand\n$v=[\\begin{aligned}0 \\\\ 4 \\\\ -1\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}Pv & =[\\begin{aligned}1 & -1 & 2 \\\\ 1 & -1 & 3 \\\\ 1 & -1 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 4 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1\\cdot 0+(-1)\\cdot 4+2\\cdot (-1) \\\\ 1\\cdot 0+(-1)\\cdot 4+3\\cdot (-1) \\\\ 1\\cdot 0+(-1)\\cdot 4+4\\cdot (-1)\\end{aligned}] \\\\  & =[\\begin{aligned}0-4-2 \\\\ 0-4-3 \\\\ 0-4-4\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ -7 \\\\ -8\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393680 :knowledge-point/_questions [{:knowledge-point/id #uuid "3beceaa9-f8b5-5b98-a4a3-2ececba067e0" :knowledge-point/title "Multiplying a 3x3 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3fb0327-b150-5729-940f-5391684f3230" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186393682} {:answer/id #uuid "db50c616-6618-519e-b9e2-ad00a61544d6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 12 \\\\ 7\\end{aligned}]" :db/id #edb/ref 17592186393683} {:answer/id #uuid "aa1b46ce-13b1-5115-ae1d-5536c534e8c0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393684} {:answer/id #uuid "7a04bdac-f5c3-568a-91fb-32085c41ce80" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ -4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186393685} {:answer/id #uuid "2f4d565c-c11d-5c54-9793-6c08a26b4bf6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 12 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186393686}] :answer-field/correct {:answer/id #uuid "e3fb0327-b150-5729-940f-5391684f3230" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186393682} :answer-field/id #uuid "9a1f9064-b841-51f8-b501-666994d55e22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393681}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e8dce8d9-dad7-5dc4-8d6b-722e29db01c2" :question/math-academy-id "q-77351" :question/problem "$[\\begin{aligned}1 & -2 & 1 \\\\ -2 & 2 & -2 \\\\ 1 & -2 & 1\\end{aligned}][\\begin{aligned}-2 \\\\ -1 \\\\ 3\\end{aligned}]=$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product:\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & -2 & 1 \\\\ -2 & 2 & -2 \\\\ 1 & -2 & 1\\end{aligned}][\\begin{aligned}-2 \\\\ -1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}1\\cdot (-2)+(-2)\\cdot (-1)+1\\cdot 3 \\\\ (-2)\\cdot (-2)+2\\cdot (-1)+(-2)\\cdot 3 \\\\ 1\\cdot (-2)+(-2)\\cdot (-1)+1\\cdot 3\\end{aligned}] \\\\  & =[\\begin{aligned}-2+2+3 \\\\ 4-2-6 \\\\ -2+2+3\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ -4 \\\\ 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393687 :knowledge-point/_questions [{:knowledge-point/id #uuid "4fcf3704-4856-5095-a6f4-7ec20d81f3c4" :knowledge-point/title "Expressing an Unknown in Terms of 2x2 Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447eaab9-6da2-5044-99db-4a1a4223532f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}4 & 1 \\\\ 2 & 3\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/id #edb/ref 17592186393689} {:answer/id #uuid "78a86f8d-aae4-5a4d-95e4-fab946aebfd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}5 & 2 \\\\ 2 & -3\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/id #edb/ref 17592186393690} {:answer/id #uuid "38a07045-f8ae-5e87-9321-f64593af7a55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/id #edb/ref 17592186393691} {:answer/id #uuid "e48114b7-c325-58ff-8779-f2b138d44c14" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}" :db/id #edb/ref 17592186393692} {:answer/id #uuid "19c2ae1c-bf55-56a8-9095-d30b83511f64" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}{|\\begin{aligned}5 & 2 \\\\ 2 & -3\\end{aligned}|}" :db/id #edb/ref 17592186393693}] :answer-field/correct {:answer/id #uuid "38a07045-f8ae-5e87-9321-f64593af7a55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}" :db/id #edb/ref 17592186393691} :answer-field/id #uuid "87423d6e-0ff7-5bbe-8eda-f375b8d4efa0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94153e84-a333-5aec-b75c-49c1a118f48c" :question/math-academy-id "q-77398" :question/problem "Consider the system of equations \n\n$$\n{\\begin{aligned}4x+2y=5 \\\\ x-3y=2.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}4x+2y=5 \\\\ x-3y=2.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, to construct ${D}_{y}$ we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{|\\begin{aligned}4 & 5 \\\\ 1 & 2\\end{aligned}|}{|\\begin{aligned}4 & 2 \\\\ 1 & -3\\end{aligned}|}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393694 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dabd2cd-e323-5103-b1ab-dd6de852acfc" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}]+t[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393696} {:answer/id #uuid "3fbeffbc-a98d-56e3-a819-4d71d19c1260" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393697} {:answer/id #uuid "270c04c6-7ed5-5a17-9a85-ba8df2eaa132" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393698} {:answer/id #uuid "1bb321c2-64e7-5bb6-9fd0-371d482d1d6a" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}]+t[\\begin{aligned}4 \\\\ 0 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393699} {:answer/id #uuid "58796e97-300e-5e5a-9b65-29e119ff59f9" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-1 \\\\ 0 \\\\ 1\\end{aligned}]+t[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393700}] :answer-field/correct {:answer/id #uuid "3fbeffbc-a98d-56e3-a819-4d71d19c1260" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393697} :answer-field/id #uuid "0f0788af-fd78-553e-8567-a457572ce6fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393695}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e77266e3-e110-5646-9023-0f09c4f4c827" :question/math-academy-id "q-77433" :question/problem "Find a vector equation of the line that passes through the points $A(1,1,0)$ and $B(3,-1,2).$" :question/worked-solution "The vector equation of the straight line passing through $A$ and parallel to $v$ is given by\n\n$$\nr=a+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $a$ is the position vector of $A.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $A(1,1,0)$ and $B(3,-1,2)$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{AB} \\\\  & =⟨3,-1,2⟩-⟨1,1,0⟩ \\\\  & =⟨2,-2,2⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393701 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c417871b-e55c-54f4-955a-351dea595708" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ 4 \\\\ 6\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393703} {:answer/id #uuid "3fe0b971-e2f4-5fec-ba29-b2a0ce76e314" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}4 \\\\ -6 \\\\ -2\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 5 \\\\ 4\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393704} {:answer/id #uuid "f6ea49db-0144-5653-9d66-d87fedc3dbd2" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-1 \\\\ 5 \\\\ 4\\end{aligned}]+t[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393705} {:answer/id #uuid "8542aee1-d7d5-5596-999e-c2595dc89ea7" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -1 \\\\ 2\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ 4\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393706} {:answer/id #uuid "50e63360-c7af-5589-a643-2e93a467ee43" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-1 \\\\ 5 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ -6 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393707}] :answer-field/correct {:answer/id #uuid "50e63360-c7af-5589-a643-2e93a467ee43" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-1 \\\\ 5 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ -6 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393707} :answer-field/id #uuid "a2ee66b8-feea-5d50-b26f-6c54cc94e2e3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393702}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "51cde5d3-a898-58ba-977d-965c7a803752" :question/math-academy-id "q-77434" :question/problem "Find a vector equation of the line that passes through the points $P(-1,5,4)$ and $Q(3,-1,2).$" :question/worked-solution "The vector equation of the straight line passing through $P$ and parallel to $v$ is given by\n\n$$\nr=p+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $p$ is the position vector of $P.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $P(-1,5,4)$ and $Q(3,-1,2)$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =⟨3,-1,2⟩-⟨-1,5,4⟩ \\\\  & =⟨4,-6,-2⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}-1 \\\\ 5 \\\\ 4\\end{aligned}]+t[\\begin{aligned}4 \\\\ -6 \\\\ -2\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393708 :knowledge-point/_questions [{:knowledge-point/id #uuid "a6dee200-f517-5645-87ec-ccf36012e55e" :knowledge-point/title "Finding a Vector Equation of the Line Passing Through Two Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db17cd8-237c-59d2-ad08-5777324e047d" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}3 \\\\ 3 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393710} {:answer/id #uuid "0e0ea2e4-a1c5-5c0f-bec6-0492d31e9147" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}3 \\\\ 4 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393711} {:answer/id #uuid "ae083659-217f-5797-bde8-8fd5713ad91c" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ 4 \\\\ -1\\end{aligned}]+t[\\begin{aligned}2 \\\\ -2 \\\\ -3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393712} {:answer/id #uuid "90817835-10d1-56cb-abc3-88f05a19a4d9" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ 3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}3 \\\\ 5 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393713} {:answer/id #uuid "f119f61c-5a94-5dcd-be4e-7d9cd9aae876" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ 4 \\\\ -1\\end{aligned}]+t[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393714}] :answer-field/correct {:answer/id #uuid "0db17cd8-237c-59d2-ad08-5777324e047d" :answer/type {:db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}3 \\\\ 3 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393710} :answer-field/id #uuid "cc3fcd16-d073-5631-a5c7-303cd5dd703e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e23f630-f4c4-5539-9c2d-179afdf462ba" :question/math-academy-id "q-77435" :question/problem "Find a vector equation of the line that passes through the points $M(0,1,0)$ and $N(3,4,-1).$" :question/worked-solution "The vector equation of the straight line passing through $M$ and parallel to $v$ is given by\n\n$$\nr=m+tv,\n$$\n\nwhere $t\\in (-\\infty ,\\infty )$ and $m$ is the position vector of $M.$ \n\nWe can find a direction vector by computing the displacement vector between the given points $M(0,1,0)$ and $N(3,4,-1)$, as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{MN} \\\\  & =⟨3,4,-1⟩-⟨0,1,0⟩ \\\\  & =⟨3,3,-1⟩\\end{aligned}\n$$\n\nTherefore, the vector equation of the line is given by\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}3 \\\\ 3 \\\\ -1\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393715 :knowledge-point/_questions [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f529956a-04b4-5981-a298-2a32bb012c7e" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 5 & 0 \\\\ 1 & 5 & 4\\end{aligned}|" :db/id #edb/ref 17592186393717} {:answer/id #uuid "62518129-799d-5a5c-b66d-65a30b86adfb" :answer/type {:db/ident :answer.type/math} :answer/value "8\\cdot |\\begin{aligned}3 & -1 & 0 \\\\ 1 & 2 & 5 \\\\ -1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393718} {:answer/id #uuid "1da5bf0f-3c66-58e0-8dfe-d519a5ec870b" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 0\\end{aligned}|" :db/id #edb/ref 17592186393719} {:answer/id #uuid "175bfded-3331-5f45-9d21-f820921396c0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393720} {:answer/id #uuid "6fafed7d-7bf8-576f-9c99-c605263173fa" :answer/type {:db/ident :answer.type/math} :answer/value "2\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 2 & 0 & 2 \\\\ 1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393721}] :answer-field/correct {:answer/id #uuid "175bfded-3331-5f45-9d21-f820921396c0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}|" :db/id #edb/ref 17592186393720} :answer-field/id #uuid "bed429e7-7e1a-5af7-8bd6-8ff0cb1edcc5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393716}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23708dd8-2d47-5f1e-8545-2d6c9ad9cd69" :question/math-academy-id "q-77500" :question/problem "$|\\begin{aligned}3 & -1 & 4 & 0 \\\\ 2 & 0 & 2 & 5 \\\\ 1 & 2 & 0 & 0 \\\\ 1 & 2 & 4 & 0\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $4$th column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & -1 & 4 & 0 \\\\ 2 & 0 & 2 & 5 \\\\ 1 & 2 & 0 & 0 \\\\ 1 & 2 & 4 & 0\\end{aligned}| & =0\\cdot {C}_{14}+5\\cdot {C}_{24}+0\\cdot {C}_{34}+0\\cdot {C}_{44} \\\\  & =5\\cdot (-1)^{2+4}\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}| \\\\  & =5\\cdot |\\begin{aligned}3 & -1 & 4 \\\\ 1 & 2 & 0 \\\\ 1 & 2 & 4\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393722 :knowledge-point/_questions [{:knowledge-point/id #uuid "db6f57f3-d9f0-5ea7-a557-e729a8c0777f" :knowledge-point/title "Calculating a Determinant Using a Laplace Expansion Across a Column"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56aa1b0a-d3ba-5e9d-bf2f-3fee54a0aeb2" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}2 & \\sqrt{3} & -1 \\\\ -1 & 0 & 1 \\\\ 1 & 0 & -1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186393724} {:answer/id #uuid "7fb2414b-474d-5931-bc91-ef0c7c308a57" :answer/type {:db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186393725} {:answer/id #uuid "0a75555d-2651-5755-856d-2004ab1df45f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186393726} {:answer/id #uuid "0b28dfa1-9b13-5267-a03d-29a3b7303759" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|+\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & \\sqrt{3} \\\\ -1 & -1 & 0 \\\\ -2 & 1 & 0\\end{aligned}|" :db/id #edb/ref 17592186393727} {:answer/id #uuid "4d361d0a-4eaf-51ec-b617-bbfea97f6c1b" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cdot |\\begin{aligned}1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}-1 & 0 & 1 \\\\ 1 & 0 & -1 \\\\ 5 & \\sqrt{5} & 1\\end{aligned}|" :db/id #edb/ref 17592186393728}] :answer-field/correct {:answer/id #uuid "0a75555d-2651-5755-856d-2004ab1df45f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|" :db/id #edb/ref 17592186393726} :answer-field/id #uuid "b752084c-ea22-57eb-b56c-359cc3f7787d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393723}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3ec0fb73-379b-5a1f-918f-29c718e49441" :question/math-academy-id "q-77501" :question/problem "$|\\begin{aligned}3 & 2 & \\sqrt{3} & -1 \\\\ -1 & -1 & 0 & 1 \\\\ -2 & 1 & 0 & -1 \\\\ -1 & 5 & \\sqrt{5} & 1\\end{aligned}|=$" :question/worked-solution "Using a cofactor expansion along the $3$rd column, we have\n\n$$\n\\begin{aligned}|\\begin{aligned}3 & 2 & \\sqrt{3} & -1 \\\\ -1 & -1 & 0 & 1 \\\\ -2 & 1 & 0 & -1 \\\\ -1 & 5 & \\sqrt{5} & 1\\end{aligned}| & =\\sqrt{3}\\cdot {C}_{13}+0\\cdot {C}_{23}+0\\cdot {C}_{33}+\\sqrt{5}\\cdot {C}_{43} \\\\  & =\\sqrt{3}\\cdot (-1)^{1+3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|+\\sqrt{5}\\cdot (-1)^{4+3}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}| \\\\  & =\\sqrt{3}\\cdot |\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 1 & -1 \\\\ -1 & 5 & 1\\end{aligned}|-\\sqrt{5}\\cdot |\\begin{aligned}3 & 2 & -1 \\\\ -1 & -1 & 1 \\\\ -2 & 1 & -1\\end{aligned}|.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393729 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2087c139-c34e-5140-8fec-9ea7cda84ab7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7+8\\text{i} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186393731} {:answer/id #uuid "eb4f8ce4-0bf8-5f55-90a8-45ff28154d28" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7-8\\text{i} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186393732} {:answer/id #uuid "bb6a8815-54e3-5ecc-a5c5-dfb5595c24c7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7+8\\text{i} \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186393733} {:answer/id #uuid "c67f38f5-5c76-5821-aaff-0840ef3daac0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7+8\\text{i} \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186393734} {:answer/id #uuid "c3ffe168-9639-5836-891f-14ccd85a37ae" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7-8\\text{i} \\\\ -6\\end{aligned}]" :db/id #edb/ref 17592186393735}] :answer-field/correct {:answer/id #uuid "2087c139-c34e-5140-8fec-9ea7cda84ab7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7+8\\text{i} \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186393731} :answer-field/id #uuid "2429669f-fc3e-5bfb-a485-eae67f691b9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393730}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a34ce566-d765-59b4-b453-cb1921569c8b" :question/math-academy-id "q-77546" :question/problem "If $\\,x=[\\begin{aligned}7-8\\text{i} \\\\ 6\\end{aligned}]\\,$ then $\\,\\overset{―}{x}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\overset{―}{[\\begin{aligned}7-8\\text{i} \\\\ 6\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{7-8\\text{i}} \\\\ \\overset{―}{6}\\end{aligned}] \\\\  & =[\\begin{aligned}7+8\\text{i} \\\\ 6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393736 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b677c92-5390-5cd1-b1d3-b84d180c2b3e" :knowledge-point/title "Calculating the Complex Conjugate of a Complex Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0779ca8-5fe1-5794-8623-b5f1b1d948db" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3+8\\text{i} \\\\ -2-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393738} {:answer/id #uuid "b151c713-25dd-54c9-8ed1-2e18bc3490e8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3+8\\text{i} \\\\ 2-3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393739} {:answer/id #uuid "36b65616-c0a0-5b7b-b060-9b3c2387880c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3-8\\text{i} \\\\ 2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393740} {:answer/id #uuid "a11cb66a-4f2f-57d3-89e5-a6bf45c90fd0" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3+8\\text{i} \\\\ 2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393741} {:answer/id #uuid "577953b3-72bf-57d8-ab26-324d137ae17c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3-8\\text{i} \\\\ -2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393742}] :answer-field/correct {:answer/id #uuid "577953b3-72bf-57d8-ab26-324d137ae17c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3-8\\text{i} \\\\ -2+3\\text{i}\\end{aligned}]" :db/id #edb/ref 17592186393742} :answer-field/id #uuid "28dc495a-a187-507f-a135-8dc96fead918" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "711300c3-0b93-5c10-812e-3a69e9246478" :question/math-academy-id "q-77547" :question/problem "Given the vectors ${x}_{1}=[\\begin{aligned}3-8\\text{i} \\\\ -4+2\\text{i}\\end{aligned}]$ and ${x}_{2}=[\\begin{aligned}-6\\text{i} \\\\ 1+2\\text{i}\\end{aligned}]$, then ${x}_{1}+\\text{i}\\cdot {\\overset{―}{x}}_{2}=$" :question/worked-solution "To find the complex conjugate of a vector, we take the complex conjugate of the entries of the vector. So, we have\n\n$$\n\\begin{aligned}{\\overset{―}{x}}_{2} & =\\overset{―}{[\\begin{aligned}-6\\text{i} \\\\ 1+2\\text{i}\\end{aligned}]} \\\\  & =[\\begin{aligned}\\overset{―}{-6\\text{i}} \\\\ \\overset{―}{1+2\\text{i}}\\end{aligned}] \\\\  & =[\\begin{aligned}6\\text{i} \\\\ 1-2\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second vector, we get\n\n$$\n\\begin{aligned}\\text{i}\\cdot {\\overset{―}{x}}_{2} & =\\text{i}\\cdot [\\begin{aligned}6\\text{i} \\\\ 1-2\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}6{\\text{i}}^{2} \\\\ \\text{i}-2{\\text{i}}^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-6 \\\\ 2+\\text{i}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{x}_{1}+\\text{i}\\cdot {\\overset{―}{x}}_{2} & =[\\begin{aligned}3-8\\text{i} \\\\ -4+2\\text{i}\\end{aligned}]+[\\begin{aligned}-6 \\\\ 2+\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}-3-8\\text{i} \\\\ -2+3\\text{i}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393743 :knowledge-point/_questions [{:knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5975ee7c-248f-52aa-92e6-7307c035348b" :answer/type {:db/ident :answer.type/image} :answer/value "images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png" :db/id #edb/ref 17592186393745} {:answer/id #uuid "69276a71-4933-599e-b951-26b490c52cbe" :answer/type {:db/ident :answer.type/image} :answer/value "images/3e/3e2b6cde516dc1737124576ffdc212331e3ad74f728f47aece5911ed04cf7f5a.png" :db/id #edb/ref 17592186393746} {:answer/id #uuid "df0291cf-6864-5a2c-a3de-e53242dc7ff8" :answer/type {:db/ident :answer.type/image} :answer/value "images/77/7720d00d73ea3d4b4cf4905cf57ec12a3953caeb135272ec2d5283dad1479efe.png" :db/id #edb/ref 17592186393747} {:answer/id #uuid "5358c8ed-0c53-52b2-9dde-eca396e3f641" :answer/type {:db/ident :answer.type/image} :answer/value "images/c1/c1ecb1d567916c708cc6bbbd394517835e86b4105ae045cf5ef9490b181900fa.png" :db/id #edb/ref 17592186393748} {:answer/id #uuid "3896dd03-da28-567c-b00f-2916b9f8afe3" :answer/type {:db/ident :answer.type/image} :answer/value "images/5f/5f4e50dfc88fdb9109961e2cef0dc0b1f7968d7b588e2f944450ac2969075bd7.png" :db/id #edb/ref 17592186393749}] :answer-field/correct {:answer/id #uuid "5975ee7c-248f-52aa-92e6-7307c035348b" :answer/type {:db/ident :answer.type/image} :answer/value "images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png" :db/id #edb/ref 17592186393745} :answer-field/id #uuid "8715746d-70c4-5d7d-a61a-15d532009b48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393744}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "813db841-ac50-5fa6-a6b6-270cab223353" :question/math-academy-id "q-77606" :question/problem "![](images/35/3507450dd4d81fb14269ec651cc3f93ef52d615797ac3e6f4f779a0df98debe2.png)\n\nGiven the triangle $△ABC$ shown above, which of the following diagrams represents the altitude  corresponding to $\\overset{―}{AB}?$" :question/worked-solution "The height (or altitude)  corresponding to $\\overset{―}{AB}$ is a line segment that \n\n- runs from the opposite vertex $C$ to the line $\\overset{⟷}{AB},$ and\n\n- is perpendicular to $\\overset{⟷}{AB}.$\n\nThe correct diagram is shown below:\n\n![](images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png)"}] [{:db/id #edb/ref 17592186393750 :knowledge-point/_questions [{:knowledge-point/id #uuid "95f2e191-0760-5cb8-b55a-cd2955150e82" :knowledge-point/title "Finding the Parametric Equation of an Osculating Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ec9aa97-f0f7-5a10-8249-361b901e466a" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=⟨\\frac{s}{\\sqrt{3}},\\,\\frac{s}{\\sqrt{3}}+\\frac{u}{\\sqrt{2}},\\,\\frac{u}{\\sqrt{2}}⟩" :db/id #edb/ref 17592186393752} {:answer/id #uuid "de4add72-0cd4-537b-80b7-0002434bbdf4" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=⟨1+\\frac{s}{\\sqrt{3}}-\\frac{u}{\\sqrt{2}},\\,1-\\frac{s}{\\sqrt{3}},\\,1-\\frac{u}{\\sqrt{2}}⟩" :db/id #edb/ref 17592186393753} {:answer/id #uuid "250743fd-4960-51b1-885b-3ed93deac3de" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=⟨1+3s,\\,2s+3u,\\,2s-3u⟩" :db/id #edb/ref 17592186393754} {:answer/id #uuid "07171637-65de-5c83-8235-9dc05a85624e" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=⟨1+\\frac{s}{\\sqrt{3}},\\,\\frac{s}{\\sqrt{3}}+\\frac{u}{\\sqrt{2}},\\,1+\\frac{s}{\\sqrt{3}}-\\frac{u}{\\sqrt{2}}⟩" :db/id #edb/ref 17592186393755} {:answer/id #uuid "28f201ce-0d59-5c71-83a0-18e65a037a4c" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=⟨2+\\frac{s}{\\sqrt{3}},\\,1-\\frac{u}{\\sqrt{2}},\\,3+\\frac{s}{\\sqrt{3}}-\\frac{u}{\\sqrt{2}}⟩" :db/id #edb/ref 17592186393756}] :answer-field/correct {:answer/id #uuid "07171637-65de-5c83-8235-9dc05a85624e" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=⟨1+\\frac{s}{\\sqrt{3}},\\,\\frac{s}{\\sqrt{3}}+\\frac{u}{\\sqrt{2}},\\,1+\\frac{s}{\\sqrt{3}}-\\frac{u}{\\sqrt{2}}⟩" :db/id #edb/ref 17592186393755} :answer-field/id #uuid "78aa28f8-2396-55a6-bbc4-e9955564a261" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393751}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cf74894d-e339-586f-8261-369741108e3a" :question/math-academy-id "q-77651" :question/problem "Find a parametric equation of the osculating plane for the curve  $r(t)$ at the point where $t=0$, given that\n\n$$\nr(t)=⟨{e}^{t},\\,{e}^{t}\\operatorname{sin}⁡t,\\,{e}^{t}\\operatorname{cos}⁡t⟩,\\,T(0)=\\frac{1}{\\sqrt{3}}⟨1,\\,1,\\,1⟩,\\,N(0)=\\frac{1}{\\sqrt{2}}⟨0,\\,1,\\,-1⟩\n$$\n\nwhere $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The osculating plane passes through the point that is at the tip of the vector $r(0).$ The unit tangent vector $T(0)$ and the principal normal vector $N(0)$ are parallel to this plane. Therefore, a parametric equation for the plane can be written as \n\n$$\nR(s,u)=r(0)+sT(0)+uN(0),\\,s,\\,u\\in (-\\infty ,\\infty ).\n$$\n\n \n\nWe have that\n\n$$\n\\begin{aligned}r(0) & =⟨{e}^{0},\\,{e}^{0}\\operatorname{sin}⁡0,\\,{e}^{0}\\operatorname{cos}⁡0⟩=⟨1,\\,0,\\,1⟩.\\end{aligned}\n$$\n\nHence, a parametric equation for the osculating plane at the point $(1,\\,0,\\,1)$ is given by\n\n$$\n\\begin{aligned}R(s,u) & =r(0)+sT(0)+uN(0) \\\\  & =⟨1,\\,0,\\,1⟩+s\\cdot \\frac{1}{\\sqrt{3}}⟨1,\\,1,\\,1⟩+u\\cdot \\frac{1}{\\sqrt{2}}⟨0,\\,1,\\,-1⟩ \\\\  & =⟨1+\\frac{s}{\\sqrt{3}},\\,\\frac{s}{\\sqrt{3}}+\\frac{u}{\\sqrt{2}},\\,1+\\frac{s}{\\sqrt{3}}-\\frac{u}{\\sqrt{2}}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393757 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8" :knowledge-point/title "The Second Derivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86cea4ef-71ce-511e-9d8b-a1f718158b3e" :answer/type {:db/ident :answer.type/math} :answer/value "(t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\,i-(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393759} {:answer/id #uuid "3673b7a2-f1d8-5266-9125-906d7dbc0f9e" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i-(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(t+1)\\,k" :db/id #edb/ref 17592186393760} {:answer/id #uuid "8003fc75-b7ed-5c00-8921-9a01cf27a9f6" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i-(2\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(t+1)\\,k" :db/id #edb/ref 17592186393761} {:answer/id #uuid "43982434-8c3d-5fcd-a8cb-9c0931e39dd8" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393762} {:answer/id #uuid "48238325-c06e-58dc-a7bf-c70f8fc3d3db" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393763}] :answer-field/correct {:answer/id #uuid "43982434-8c3d-5fcd-a8cb-9c0931e39dd8" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393762} :answer-field/id #uuid "1e182f36-1f51-5195-9065-734439498a28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19d44fb9-0b26-5bc1-af60-efeec2020695" :question/math-academy-id "q-77683" :question/problem "Find the second derivative of $f(t)=t\\operatorname{cos}⁡t\\,i+t\\operatorname{sin}⁡t\\,j+(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+(3\\cdot \\frac{1}{3}{t}^{2}-2\\cdot \\frac{1}{2}t)\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+({t}^{2}-t)\\,k\\end{aligned}\n$$\n\n \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,k \\\\  & =(-\\operatorname{sin}⁡t-\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k \\\\  & =-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393764 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8b95b62-9eac-5c79-b618-0298e1652616" :answer/type {:db/ident :answer.type/image} :answer/value "images/15/15134cfea5a58d0351be842c28d087a50591d60fb6a9f8ee36bcf4b35fb950ed.png" :db/id #edb/ref 17592186393766} {:answer/id #uuid "810f1d21-088a-52c7-8b34-c361d3749bb5" :answer/type {:db/ident :answer.type/image} :answer/value "images/e0/e055c227957074b5b8bb321cbc43f9c0f2796f7f7040616fe291098e9fd2dfb0.png" :db/id #edb/ref 17592186393767} {:answer/id #uuid "c597b2fb-5e49-5cfd-96c5-71b7925a4a9e" :answer/type {:db/ident :answer.type/image} :answer/value "images/d6/d6e72adfafe111e75253f355d80d7d27c1a89bd2483c0db5618bee62c79f87ad.png" :db/id #edb/ref 17592186393768} {:answer/id #uuid "988f9b48-24b5-5ff5-8b0b-4a4252631376" :answer/type {:db/ident :answer.type/image} :answer/value "images/19/19dc7b72e149547ff51758dadf84f94be080a68227239e07239ce0659ade5a5a.png" :db/id #edb/ref 17592186393769} {:answer/id #uuid "2ecd37a8-72a0-57e0-80f3-347934775efa" :answer/type {:db/ident :answer.type/image} :answer/value "images/17/177ca7f40ef24cf2f45a15b78487700d1f0efd094c975079cf4704b46debefb1.png" :db/id #edb/ref 17592186393770}] :answer-field/correct {:answer/id #uuid "2ecd37a8-72a0-57e0-80f3-347934775efa" :answer/type {:db/ident :answer.type/image} :answer/value "images/17/177ca7f40ef24cf2f45a15b78487700d1f0efd094c975079cf4704b46debefb1.png" :db/id #edb/ref 17592186393770} :answer-field/id #uuid "34779380-003f-5fa8-8d6a-ad93873e4a0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393765}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9161e73-0db0-599d-b045-fa10e5d3039c" :question/math-academy-id "q-77717" :question/problem "![](images/fc/fc7bebddc280debd4bde32393cabfa4a6a91a782d38e5406f374cc4eaa4ac68f.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 4 & 1\\end{aligned}].\n$$\n\nThe line segment $\\overset{―}{AB}$ is shown above. Which of the following is $\\overset{―}{{A}^{′}{B}^{′}},$ the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}2 & -2 \\\\ -1 & 5\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -1 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ -1 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -9 \\\\ 7 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(5,7)$ and ${B}^{′}(-9,-3),$ as shown below.\n\n![](images/17/177ca7f40ef24cf2f45a15b78487700d1f0efd094c975079cf4704b46debefb1.png)"}] [{:db/id #edb/ref 17592186152781 :knowledge-point/_questions [{:knowledge-point/id #uuid "f63580eb-b476-51fa-a005-560f6e57d911" :knowledge-point/title "Computing the Image of a Point Under a Linear Transformation of a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85ea63c1-961d-5e8b-ad73-483438e075ee" :answer/type {:db/ident :answer.type/math} :answer/value "(15,-7)" :db/id #edb/ref 17592186151164} {:answer/id #uuid "c82b09f5-0d76-5162-921a-a1f7d1753c83" :answer/type {:db/ident :answer.type/math} :answer/value "(15,-4\\sqrt{3})" :db/id #edb/ref 17592186151165} {:answer/id #uuid "20a73b0b-446f-5b6a-b173-5a3c3268686d" :answer/type {:db/ident :answer.type/math} :answer/value "(12\\sqrt{3},-1)" :db/id #edb/ref 17592186151166} {:answer/id #uuid "3be82429-3ddc-50da-8446-4fd2ca25e1cb" :answer/type {:db/ident :answer.type/math} :answer/value "(15,-1)" :db/id #edb/ref 17592186151167} {:answer/id #uuid "6094d342-2f84-5b15-975d-87ea4858c089" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-15)" :db/id #edb/ref 17592186151168}] :answer-field/id #uuid "6f14b144-2ce7-509f-8cc7-b03a61d2dced" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151163}] :question/id #uuid "bb2dd55a-4969-5401-b5e0-478786fa3f74" :question/math-academy-id "q-77726" :question/problem "Consider the linear transformation $T$ with matrix representation $T$, given by\n\n$T = \\begin{bmatrix}-3 & \\sqrt{3} \\\\ 1 & \\sqrt{3}\\end{bmatrix}$.\n\nWhat are the coordinates of the point $S^{′}$, the image of $S(-4, \\sqrt{3})$ under the action of $T$?"}] [{:db/id #edb/ref 17592186393771 :knowledge-point/_questions [{:knowledge-point/id #uuid "84e87d0d-806d-5587-849e-17d6999dbbd1" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeaa8919-6cd1-523d-89da-7ef2030fd077" :answer/type {:db/ident :answer.type/math} :answer/value "y=11{e}^{4x-4}-9x{e}^{4x-4}" :db/id #edb/ref 17592186393773} {:answer/id #uuid "31ad293a-a2de-5b04-a010-75b1e574916b" :answer/type {:db/ident :answer.type/math} :answer/value "y=-7{e}^{4x-4}+9x{e}^{4x-4}" :db/id #edb/ref 17592186393774} {:answer/id #uuid "0a7466a7-5e6b-57ce-b40f-1d86f392fa6e" :answer/type {:db/ident :answer.type/math} :answer/value "y=5{e}^{4x-4}-3x{e}^{4x-4}" :db/id #edb/ref 17592186393775} {:answer/id #uuid "2731b0a9-3ca5-56a5-b3d2-8efcf3d3f0af" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{2x-2}-6x{e}^{2x-2}" :db/id #edb/ref 17592186393776} {:answer/id #uuid "738f5cba-3a2c-5ec8-92f7-05586e62d819" :answer/type {:db/ident :answer.type/math} :answer/value "y=3{e}^{2x-2}-x{e}^{2x-2}" :db/id #edb/ref 17592186393777}] :answer-field/correct {:answer/id #uuid "eeaa8919-6cd1-523d-89da-7ef2030fd077" :answer/type {:db/ident :answer.type/math} :answer/value "y=11{e}^{4x-4}-9x{e}^{4x-4}" :db/id #edb/ref 17592186393773} :answer-field/id #uuid "656ffe0f-9fb3-55a1-98b5-b13db8a4f14b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393772}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0ccd8f3-5c55-5b1e-8569-1f7045c0f609" :question/math-academy-id "q-7798" :question/problem "Solve the initial value problem\n\n$$\n{y}^{″}-8{y}^{′}+16y=0,\\,y(1)=2,\\text{ }\\text{ }{y}^{′}(1)=-1.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-8\\lambda {e}^{\\lambda x}+16{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-8\\lambda +16) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-8\\lambda +16 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda -4)(\\lambda -4) & =0 \\\\ (\\lambda -4)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =4$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{4x}+Bx{e}^{4x}.\n$$\n\nLet us find constants $A$ and $B.$ \n\nSubstituting $y(1)=2$ into the general solution gives\n\n$$\nA{e}^{4}+B{e}^{4}=2.\n$$\n\nWe now need to apply the condition ${y}^{′}(1)=-1.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n{y}^{′}=4A{e}^{4x}+B{e}^{4x}+4Bx{e}^{4x}\n$$\n\nSubstituting ${y}^{′}(1)=1$ into the above gives\n\n$$\n4A{e}^{4}+5B{e}^{4}=-1.\n$$\n\nTherefore, we have the following system of equations for $A$ and $B$:\n\n$$\n{\\begin{aligned}A{e}^{4}+B{e}^{4}=2 \\\\ 4A{e}^{4}+5B{e}^{4}=-1\\end{aligned}\n$$\n\nSolving this system gives $A=11{e}^{-4},B=-9{e}^{-4}.$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y & =11{e}^{-4}\\cdot {e}^{4x}-9{e}^{-4}\\cdot x{e}^{4x} \\\\  & =11{e}^{4x-4}-9x{e}^{4x-4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393778 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2845913-5c76-57f5-a4d3-139a6513225b" :knowledge-point/title "Determining the Standard Matrix of a Linear Transformation Given a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ef12c0-81b8-5e47-a65d-7cb7211c8786" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 \\\\ 2 & -3\\end{aligned}]" :db/id #edb/ref 17592186393780} {:answer/id #uuid "001eef82-7933-51bb-851e-9e5adbffd169" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 2 \\\\ 3 & -3\\end{aligned}]" :db/id #edb/ref 17592186393781} {:answer/id #uuid "4220e4a4-2722-5a7e-ae00-ada68527f83b" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ 2 & -3\\end{aligned}]" :db/id #edb/ref 17592186393782} {:answer/id #uuid "b8383c7f-44a0-535e-b0ed-e0603eefcbbf" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -3 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186393783} {:answer/id #uuid "f8cdd350-9f6c-5b7e-9afa-c379f3ed1172" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ -3 & 2\\end{aligned}]" :db/id #edb/ref 17592186393784}] :answer-field/correct {:answer/id #uuid "f8cdd350-9f6c-5b7e-9afa-c379f3ed1172" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 1 \\\\ -3 & 2\\end{aligned}]" :db/id #edb/ref 17592186393784} :answer-field/id #uuid "747395f6-1977-5865-86f0-421323640a45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cfd1494-c300-5b47-97b2-4d30115ce6f6" :question/math-academy-id "q-77996" :question/problem "![](images/2f/2f0c94bc3100b4fd9754ee822f55e2edbae8475bece3b18ac34f63e6c92267a2.png)\n\nIn the diagram above, $i$ and $j$ are the vectors of the standard basis of ${R}^{2}$, while ${i}^{′}$ and ${j}^{′}$ are their images under the linear transformation $T.$\nWhat is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}3 \\\\ -3\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}3 & 1 \\\\ -3 & 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186393785 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2845913-5c76-57f5-a4d3-139a6513225b" :knowledge-point/title "Determining the Standard Matrix of a Linear Transformation Given a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2224cf00-9c61-5f7e-a20e-4ab49991b1e5" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 \\\\ 3 & -3\\end{aligned}]" :db/id #edb/ref 17592186393787} {:answer/id #uuid "2b556ff2-c047-5a8d-b5df-fba08c731fff" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 \\\\ -3 & 3\\end{aligned}]" :db/id #edb/ref 17592186393788} {:answer/id #uuid "cbe4d06b-075d-5500-939c-2f85de0b2408" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 \\\\ -2 & -3\\end{aligned}]" :db/id #edb/ref 17592186393789} {:answer/id #uuid "45511535-805a-572f-815c-c4e9c6822f6d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -3 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186393790} {:answer/id #uuid "c4ab4fcc-b4a1-51c6-ab50-8695e294ec6c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 \\\\ -3 & 3\\end{aligned}]" :db/id #edb/ref 17592186393791}] :answer-field/correct {:answer/id #uuid "2b556ff2-c047-5a8d-b5df-fba08c731fff" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 1 \\\\ -3 & 3\\end{aligned}]" :db/id #edb/ref 17592186393788} :answer-field/id #uuid "9ea2f22b-54cb-5f9a-9611-f131357399a7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393786}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5ff535c-ef1d-5a3b-a208-109a9dfed530" :question/math-academy-id "q-77999" :question/problem "![](images/09/09423b097ab02b339f15af831e0e35f59ff88cb00c0ef72d3693ce9f24e6b9dc.png)\n\nIn the diagram above, $i$ and $j$ are the vectors of the standard basis of ${R}^{2}$, while ${i}^{′}$ and ${j}^{′}$ are their images under the linear transformation $T.$\nWhat is the standard matrix of $T?$" :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=[\\begin{aligned}-2 \\\\ -3\\end{aligned}]$ \nand \n${j}^{′}=[\\begin{aligned}1 \\\\ 3\\end{aligned}].$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=[\\begin{aligned}-2 & 1 \\\\ -3 & 3\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186393792 :knowledge-point/_questions [{:knowledge-point/id #uuid "95f2e191-0760-5cb8-b55a-cd2955150e82" :knowledge-point/title "Finding the Parametric Equation of an Osculating Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "734a6a1e-e685-50e7-b883-a6ebf4635869" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=(-1+\\frac{3}{5}s)\\,i-u\\,j+(1-\\frac{4}{5}s)\\,k" :db/id #edb/ref 17592186393794} {:answer/id #uuid "2ab3dae2-3103-59c9-b9f5-5cbd28d86cc1" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=(5+3s)\\,i-5(u-1)\\,j+(5-4s)\\,k" :db/id #edb/ref 17592186393795} {:answer/id #uuid "f7703ddf-fee7-58ad-92ad-45013706727d" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=(\\frac{3}{5}-s)\\,i-u\\,j+(\\frac{4}{5}+s)\\,k" :db/id #edb/ref 17592186393796} {:answer/id #uuid "3f9dae4c-d726-549b-acce-d5842fd2d48f" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=(1+\\frac{3}{5}s)\\,i-(1+u)\\,j+(1-\\frac{4}{5}s)\\,k" :db/id #edb/ref 17592186393797} {:answer/id #uuid "7ae919b6-296b-5d05-a059-8fab72f07ffb" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=(-1+3s)\\,i-\\,j+(1-4s)\\,k" :db/id #edb/ref 17592186393798}] :answer-field/correct {:answer/id #uuid "734a6a1e-e685-50e7-b883-a6ebf4635869" :answer/type {:db/ident :answer.type/math} :answer/value "R(s,u)=(-1+\\frac{3}{5}s)\\,i-u\\,j+(1-\\frac{4}{5}s)\\,k" :db/id #edb/ref 17592186393794} :answer-field/id #uuid "1aefb939-f80c-517f-8459-04195e8fbb29" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393793}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0afd69e0-1da5-5a6a-895c-0f0f5cbf2711" :question/math-academy-id "q-78206" :question/problem "Find the equation of the osculating plane (in parametric form) for a curve $r(t)$ at the point $P(-1,0,1)$ where $t=\\pi $, given that\n\n$$\n\\begin{aligned}T(\\pi )=\\frac{3}{5}\\,i-\\frac{4}{5}k,\\,N(\\pi )=-j.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "First, notice that the position vector of the point $P(-1,0,1)$ is $r(\\pi )=-i+\\,k.$\n\nThe osculating plane passes through the point that is at the tip of the vector $r(1).$ The vectors $T(1)$ and $N(1)$ are parallel to this plane. Therefore, the equation of the plane (in parametric form) can be written as\n\n$$\nR(s,u)=r(\\pi )+s\\,T(\\pi )+u\\,N(\\pi ),\\,s,u\\in (-\\infty ,\\infty ).\n$$\n\n \n\nHence, the equation of the osculating plane at the point $(-1,0,1)$ is given by\n\n$$\n\\begin{aligned}R(s,u) & =r(\\pi )+s\\,T(\\pi )+u\\,N(\\pi ) \\\\  & =(-i+\\,k)+s(\\frac{3}{5}\\,i-\\frac{4}{5}k)+u(-\\,j) \\\\  & =(-1+\\frac{3}{5}s)\\,i-u\\,j+(1-\\frac{4}{5}s)\\,k.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393799 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80803840-34b8-5134-98b1-f302762ad086" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 & 1 \\\\ 1 & 16\\end{aligned}]" :db/id #edb/ref 17592186393801} {:answer/id #uuid "d0f1ed27-08b7-59a4-bf54-c04cd4a88e2c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 & 0 \\\\ 0 & 16\\end{aligned}]" :db/id #edb/ref 17592186393802} {:answer/id #uuid "cae45784-b15f-533f-a52d-19b799df9612" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 16 \\\\ 16 & 0\\end{aligned}]" :db/id #edb/ref 17592186393803} {:answer/id #uuid "41c743e8-735e-5775-8e1b-6d8e22e0933d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 0 \\\\ 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186393804} {:answer/id #uuid "c2e4f34c-5f75-5cf3-8beb-09247d8fb86f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-16 & 0 \\\\ 0 & -16\\end{aligned}]" :db/id #edb/ref 17592186393805}] :answer-field/correct {:answer/id #uuid "d0f1ed27-08b7-59a4-bf54-c04cd4a88e2c" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 & 0 \\\\ 0 & 16\\end{aligned}]" :db/id #edb/ref 17592186393802} :answer-field/id #uuid "4f137406-87eb-59c2-9372-84d355135a99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393800}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31ee87d6-9881-5423-8d44-047e84cf58fc" :question/math-academy-id "q-78242" :question/problem "A linear transformation $T$ represents a dilation.  Given that $v=[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $T(v)=[\\begin{aligned}48 \\\\ -32\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}48 \\\\ -32\\end{aligned}] \\\\  & =16\\cdot [\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =16v\\end{aligned}\n$$\n\nSo we have $T(v)=16v,$ and so the linear transformation $T$ is a dilation with scale factor $k=16.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}16 & 0 \\\\ 0 & 16\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186393806 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72df9c21-4a34-551d-aefd-c82b33abe1db" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & 1 \\\\ 1 & 7\\end{aligned}]" :db/id #edb/ref 17592186393808} {:answer/id #uuid "11b09af3-bf01-5f76-be3c-cac851e42252" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 7 \\\\ 7 & 0\\end{aligned}]" :db/id #edb/ref 17592186393809} {:answer/id #uuid "44643b13-7925-5428-acff-a59795d9d063" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 1 \\\\ -7 & 17\\end{aligned}]" :db/id #edb/ref 17592186393810} {:answer/id #uuid "666982f5-becf-5549-809e-5f894f39f774" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 17 \\\\ 17 & 17\\end{aligned}]" :db/id #edb/ref 17592186393811} {:answer/id #uuid "e41487c3-f873-564c-8ad5-c8615fe4ef00" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 0 \\\\ 0 & 17\\end{aligned}]" :db/id #edb/ref 17592186393812}] :answer-field/correct {:answer/id #uuid "e41487c3-f873-564c-8ad5-c8615fe4ef00" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}17 & 0 \\\\ 0 & 17\\end{aligned}]" :db/id #edb/ref 17592186393812} :answer-field/id #uuid "5e9f81cb-019b-58fa-83ca-d0e2731b05b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393807}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ce9fd52a-eff4-5470-8dd1-42e7a1e8d09d" :question/math-academy-id "q-78246" :question/problem "A linear transformation $T$ represents a dilation.  Given that $v=[\\begin{aligned}-5 \\\\ -7\\end{aligned}]$ and $T(v)=[\\begin{aligned}-85 \\\\ -119\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}-85 \\\\ -119\\end{aligned}] \\\\  & =17\\cdot [\\begin{aligned}-5 \\\\ -7\\end{aligned}] \\\\  & =17v\\end{aligned}\n$$\n\nSo we have $T(v)=17v,$ and so the linear transformation $T$ is a dilation with scale factor $k=17.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}17 & 0 \\\\ 0 & 17\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186393813 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4bbb5a4-2456-5ff0-bd0f-af27574de30e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 0 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186393815} {:answer/id #uuid "11101e18-4b9e-5ebf-ab54-3114baff29ba" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & -5 \\\\ 9 & 8\\end{aligned}]" :db/id #edb/ref 17592186393816} {:answer/id #uuid "55cd5723-9691-5dea-900a-fe10b269ba7e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 8 \\\\ 8 & 1\\end{aligned}]" :db/id #edb/ref 17592186393817} {:answer/id #uuid "59f24a87-61cb-5592-9bc9-f00e1a1145d1" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}]" :db/id #edb/ref 17592186393818} {:answer/id #uuid "5654b311-ed32-560e-83c2-c04c87f66cf2" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 1 \\\\ 1 & 8\\end{aligned}]" :db/id #edb/ref 17592186393819}] :answer-field/correct {:answer/id #uuid "a4bbb5a4-2456-5ff0-bd0f-af27574de30e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 & 0 \\\\ 0 & 8\\end{aligned}]" :db/id #edb/ref 17592186393815} :answer-field/id #uuid "44c09b8d-c1b7-58ed-8b88-168cf09ba6ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393814}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "954d7834-0128-5286-a434-cb6d547ab390" :question/math-academy-id "q-78247" :question/problem "A  linear transformation $T$ represents a dilation. Given that $v=[\\begin{aligned}9 \\\\ -5\\end{aligned}]$ and $T(v)=[\\begin{aligned}72 \\\\ -40\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "We can write $T(v)$ as follows:\n\n$$\n\\begin{aligned}T(v) & =[\\begin{aligned}72 \\\\ -40\\end{aligned}] \\\\  & =8\\cdot [\\begin{aligned}9 \\\\ -5\\end{aligned}] \\\\  & =8v\\end{aligned}\n$$\n\nSo we have $T(v)=8v,$ and so the linear transformation $T$ is a dilation with scale factor $k=8.$\n\nThe matrix that represents a dilation of scale factor $k$ is given by\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}8 & 0 \\\\ 0 & 8\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186083938 :knowledge-point/_questions [{:knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77469a26-a869-5617-be2f-65026d46c340" :answer/type {:db/ident :answer.type/math} :answer/value "(7,6)" :db/id #edb/ref 17592186346404} {:answer/id #uuid "a2172fa6-22de-576c-8e8f-e147688e6580" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-2)" :db/id #edb/ref 17592186346765} {:answer/id #uuid "c11c3988-f8a3-56ec-8943-23a862fbf5b2" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,2)" :db/id #edb/ref 17592186347026} {:answer/id #uuid "c662193b-81b8-5941-88f2-11255487dc3d" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-6)" :db/id #edb/ref 17592186347082} {:answer/id #uuid "e9c98a73-808f-58eb-bda8-b408c871ee46" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186347421}] :answer-field/correct {:answer/id #uuid "c11c3988-f8a3-56ec-8943-23a862fbf5b2" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,2)" :db/id #edb/ref 17592186347026} :answer-field/id #uuid "5d6a0760-455a-5b10-bb0e-56804999c3f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347772}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecad8073-32a5-5bcd-a4f6-4e37160bc7af" :question/math-academy-id "q-78254" :question/problem "What is the center of the hyperbola $\\frac{(x+4)^{2}}{7}-\\frac{(y-2)^{2}}{6}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-(-4))^{2}}{7}-\\frac{(y-2)^{2}}{6}=1\n$$\n\nIn this case, $h=-4$ and $k=2.$\n\nTherefore, the center of the hyperbola is $(-4,2).$"}] [{:db/id #edb/ref 17592186393820 :knowledge-point/_questions [{:knowledge-point/id #uuid "166cd7e4-5568-5769-8bc6-4ffc4ed8b508" :knowledge-point/title "Finding the Standard Matrix of a Dilation Given a Vector and its Image"}] :question/answer-fields [{:answer-f