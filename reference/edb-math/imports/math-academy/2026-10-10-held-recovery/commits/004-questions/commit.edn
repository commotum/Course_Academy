e9c96dcc8784e8c460e7.png" 13194139533465 17592186045585 true] [17592186395225 1083 #edb/ref 17592186045498 13194139533465 17592186045585 true] [17592186395225 1084 #uuid "d00e7780-1fb6-5e01-9c13-82668818b98e" 13194139533465 17592186045585 true] [17592186395226 1081 "images/aa/aa4ec8c9bbf65797904b60a87f950113b4d720dcce16fc7ace3f349169df83ea.png" 13194139533465 17592186045585 true] [17592186395226 1083 #edb/ref 17592186045498 13194139533465 17592186045585 true] [17592186395226 1084 #uuid "1df1cd66-5d0e-5d8e-bbde-39a748aadefc" 13194139533465 17592186045585 true] [17592186395227 1081 "images/70/70d88ffc1ab7dfe2813e73d0106e913d3a1a14975d2d765ebfbd27ff3079eae1.png" 13194139533465 17592186045585 true] [17592186395227 1083 #edb/ref 17592186045498 13194139533465 17592186045585 true] [17592186395227 1084 #uuid "ae2ccf81-6413-5424-8960-c80f0c98ac13" 13194139533465 17592186045585 true] [17592186395228 1068 #edb/ref 17592186395229 13194139533465 17592186045585 true] [17592186395228 1069 "q-97114" 13194139533465 17592186045585 true] [17592186395228 1070 #edb/ref 17592186045485 13194139533465 17592186045585 true] [17592186395228 1071 "$$\n[T]_{C}=[\\begin{aligned}2 & -4 \\\\ -2 & 3\\end{aligned}],\\,{P}_{C\\to B}=[\\begin{aligned}3 & 4 \\\\ 2 & 3\\end{aligned}]\n$$\n\nConsider the matrix $[T]_{C}$ of a linear transformation $T$ with respect to the basis $C$ and the change-of-coordinates matrix ${P}_{C\\to B}$ shown above. Find the matrix of $T$ relative to the basis $B.$" 13194139533465 17592186045585 true] [17592186395228 1072 #uuid "c8232ae8-3dbc-5fa7-a890-a6276b10aff3" 13194139533465 17592186045585 true] [17592186395228 1074 "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/2e/2e82c232614bec8a98f079ea56d7913ee13e7b457e33e418198278d2e369fc5c.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}=