1}}A{v}_{1} \\\\  & =\\frac{1}{10}[\\begin{aligned}4 & 6 \\\\ -9 & 4\\end{aligned}][\\begin{aligned}-\\frac{4}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}-\\frac{10}{\\sqrt{17}} \\\\ \\frac{40}{\\sqrt{17}}\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{17}} \\\\ \\frac{4}{\\sqrt{17}}\\end{aligned}].\\end{aligned}\n$$" 13194139533465 17592186045585 true] [17592186395128 1075 #edb/ref 17592186395129 13194139533465 17592186045585 true] [17592186395128 1075 #edb/ref 17592186395130 13194139533465 17592186045585 true] [17592186395128 1075 #edb/ref 17592186395131 13194139533465 17592186045585 true] [17592186395128 1075 #edb/ref 17592186395132 13194139533465 17592186045585 true] [17592186395128 1075 #edb/ref 17592186395133 13194139533465 17592186045585 true] [17592186395128 1076 #edb/ref 17592186045493 13194139533465 17592186045585 true] [17592186395128 1077 "selection" 13194139533465 17592186045585 true] [17592186395128 1079 #edb/ref 17592186395132 13194139533465 17592186045585 true] [17592186395128 1080 #uuid "af024373-62e6-5fa0-a940-575a299d6f21" 13194139533465 17592186045585 true] [17592186395129 1081 "[\\begin{aligned}\\frac{4}{\\sqrt{17}} \\\\ \\frac{1}{\\sqrt{17}}\\end{aligned}]" 13194139533465 17592186045585 true] [17592186395129 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395129 1084 #uuid "5dd82220-ad9a-5d23-9059-b9e91a7e8ddf" 13194139533465 17592186045585 true] [17592186395130 1081 "[\\begin{aligned}-\\frac{1}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}}\\end{aligned}]" 13194139533465 17592186045585 true] [17592186395130 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395130 1084 #uuid "c425653f-089a-5c30-8706-e4cbc10d613d" 13194139533465 17592186045585 true] [17592186395131 1081 "[\\begin{aligned}-\\frac{2}{\\sqrt{13}} \\\\ \\frac{3}{\\sqrt{13}}\\end{aligned}]" 13194139533465 17592186045585 true] [17592186395131 1083 #edb/ref 17592186045499 13194139533