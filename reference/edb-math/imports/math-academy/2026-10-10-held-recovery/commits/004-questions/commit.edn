d}0 & 0 & -3 \\\\ 0 & 0 & 0 \\\\ -3 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-I)x=0$ gives the eigenvector ${v}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].$ Dividing ${v}_{2}$ by its norm $‖{v}_{2}‖=1,$ we get \n\n$$\n\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{1}[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$\n\n- For ${\\lambda }_{3}=-2,$ we have\n\n$$\n\\begin{aligned}A-(-2)I & =[\\begin{aligned}1 & 0 & -3 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]-(-2)[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}3 & 0 & -3 \\\\ 0 & 3 & 0 \\\\ -3 & 0 & 3\\end{aligned}].\\end{aligned}\n$$\n\nSeeking a non-zero solution of $(A-(-2)I)x=0$ gives the eigenvector ${v}_{3}=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].$ Dividing ${v}_{3}$ by its norm $‖{v}_{3}‖=\\sqrt{2},$ we get \n\n$$\n\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}].\n$$\n\nFinally, we construct the orthogonal matrix $P$ in the usual way, and this gives us the following:\n\n$$\nP=[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}} \\\\ 0 & 1 & 0 \\\\ \\frac{1}{\\sqrt{2}} & 0 & \\frac{1}{\\sqrt{2}}\\end{aligned}]\n$$" 13194139533465 17592186045585 true] [17592186162717 1068 #edb/ref 17592186161564 13194139533465 17592186045585 false] [17592186162717 1068 #edb/ref 17592186395276 13194139533465 17592186045585 true] [17592186162717 1070 #edb/ref 17592186045485 13194139533465 17592186045585 true] [17592186162717 1071 "$$\nA=[\\begin{aligned}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{aligned}],\\,Σ=[\\begin{aligned}3 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{aligned}]\n$$\n\nConsider the matrices $A$ and $Σ$ shown above. Given that $A=UΣ{V}^{T}$ is a singular value decomposition of $A,$ which of the following could be the matrix $V?$" 13194139533465 17592186045585 true] [17592186162717 1071 "$A = \\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1