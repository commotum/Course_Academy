6045585 true] [17592186394393 1068 #edb/ref 17592186394394 13194139533465 17592186045585 true] [17592186394393 1069 "q-82474" 13194139533465 17592186045585 true] [17592186394393 1070 #edb/ref 17592186045487 13194139533465 17592186045585 true] [17592186394393 1071 "Let $B$ be a basis of ${R}^{2}$ and let $T:{R}^{2}\\to {R}^{2}$ be a linear transformation. Find $[\\,T\\,]_{B}$, given that\n\n$\\,$ $T({b}_{1})=[\\begin{aligned}3 \\\\ -1\\end{aligned}],\\,$ $T({b}_{2})=[\\begin{aligned}5 \\\\ 2\\end{aligned}],\\,$ and $\\,B={[\\begin{aligned}1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]}.$" 13194139533465 17592186045585 true] [17592186394393 1072 #uuid "f9e52e1a-2cfc-5e9d-954d-1a0bc9675bab" 13194139533465 17592186045585 true] [17592186394393 1074 "Let's denote the vectors of $B$ as ${{b}_{1},{b}_{2}}.$ The $B$-matrix for $T$ is a matrix whose columns are the coordinates of the vectors $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B.$\n\nTo find the coordinates of $T({b}_{1})$ and $T({b}_{2})$ relative to the basis $B$, we consider the matrix\n\n$$\nM=[\\begin{aligned}| & | & | & | \\\\ {b}_{1} & {b}_{2} & T({b}_{1}) & T({b}_{2}) \\\\ | & | & | & |\\end{aligned}].\n$$\n\nNow, we reduce the left-hand side to reduced row echelon form using Gaussian elimination. Then, on the right-hand side, we will obtain the $B$-matrix for $T:$\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 1 & 2 & -1 & 2\\end{aligned}] &  & \\begin{aligned}{R}_{2}:={R}_{2}-{R}_{1}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 1 & 3 & 5 \\\\ 0 & 1 & -4 & -3\\end{aligned}] &  & \\begin{aligned}{R}_{1}:={R}_{1}-{R}_{2}\\end{aligned} \\\\  & ∼[\\begin{aligned}1 & 0 & 7 & 8 \\\\ 0 & 1 & -4 & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n[\\,T\\,]_{B}=[\\begin{aligned}7 & 8 \\\\ -4 & -3\\end{aligned}].\n$$" 13194139533465 17592186045585 true] [17592186394394 1075 #edb/ref 17592186394395 13194139533465 17592186045585 true] [17592186394394 1075 #edb/r