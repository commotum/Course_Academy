186045585 true] [17592186395443 1069 "q-98170" 13194139533465 17592186045585 true] [17592186395443 1070 #edb/ref 17592186045485 13194139533465 17592186045585 true] [17592186395443 1071 "Calculate ${\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t$ given that ${\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩$ and ${\\int }_{1}^{3}g(t)\\,\\text{d}t=⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩.$" 13194139533465 17592186045585 true] [17592186395443 1072 #uuid "4c2ff90f-3df2-5a7a-ae8c-1f49f03b53d3" 13194139533465 17592186045585 true] [17592186395443 1074 "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t & ={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+4⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩ \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+⟨3,\\,2,\\,-10⟩ \\\\  & =⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩.\\end{aligned}\n$$" 13194139533465 17592186045585 true] [17592186395444 1075 #edb/ref 17592186395445 13194139533465 17592186045585 true] [17592186395444 1075 #edb/ref 17592186395446 13194139533465 17592186045585 true] [17592186395444 1075 #edb/ref 17592186395447 13194139533465 17592186045585 true] [17592186395444 1075 #edb/ref 17592186395448 13194139533465 17592186045585 true] [17592186395444 1075 #edb/ref 17592186395449 13194139533465 17592186045585 true] [17592186395444 1076 #edb/ref 17592186045493 13194139533465 17592186045585 true] [17592186395444 1077 "selection" 13194139533465 17592186045585 true] [17592186395444 1079 #edb/ref 17592186395449 13194139533465 17592186045585 true] [17592186395444 1080 #uuid "e5f819ae-49fc-5c26-94b2-5e3cdd0e1a0f" 13194139533465 17592186045585 true] [17592186395445 1081 "⟨3-\\operatorname{ln}⁡3,\\,\\sqrt{3}-3,\