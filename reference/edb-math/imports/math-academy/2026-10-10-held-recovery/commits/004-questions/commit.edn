9533465 17592186045585 true] [17592186394684 1084 #uuid "7923ff02-537a-5c46-9034-26ed6657df17" 13194139533465 17592186045585 true] [17592186394685 1081 "a=⟨\\frac{t}{2},\\,\\frac{{e}^{2t}}{4}⟩" 13194139533465 17592186045585 true] [17592186394685 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394685 1084 #uuid "c449ee8e-b0e5-5fff-8c3d-384f4cf10aeb" 13194139533465 17592186045585 true] [17592186394686 1081 "a=⟨2t,\\,2{e}^{2t}⟩" 13194139533465 17592186045585 true] [17592186394686 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394686 1084 #uuid "72759446-2ed5-55d7-ad38-e3108b39c53a" 13194139533465 17592186045585 true] [17592186394687 1081 "a=⟨t,\\,{e}^{2t}⟩" 13194139533465 17592186045585 true] [17592186394687 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394687 1084 #uuid "c55320d0-6670-59d6-8213-9d8ccd909743" 13194139533465 17592186045585 true] [17592186394688 1068 #edb/ref 17592186394689 13194139533465 17592186045585 true] [17592186394688 1069 "q-85606" 13194139533465 17592186045585 true] [17592186394688 1070 #edb/ref 17592186045487 13194139533465 17592186045585 true] [17592186394688 1071 "The position vector $r(t)$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr(t)=⟨3{t}^{3}+t,\\,\\operatorname{ln}⁡t⟩,\\,t>0.\n$$\n\nCalculate the acceleration vector $a.$" 13194139533465 17592186045585 true] [17592186394688 1072 #uuid "fd766578-35eb-5e9e-b4c9-c03b5909e8a3" 13194139533465 17592186045585 true] [17592186394688 1074 "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)⟩ \\\\  & =⟨9{t}^{2}+1,\\,\\frac{1}{t}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{2}+1),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})⟩ \\\\  & =⟨18t,\\,-\\frac{1}{{t}^{2}}⟩\\end{aligned}\n$$" 13194139533465 17592186045585 true] [17592186394689 1075 #edb/ref 17592186394690 13194139533465 17592186045585 true] [17592186394689 1075 #edb/ref 17592186394691 13194139533465 17592186045585 true] [17592186394689 1075 #edb/ref 17592186394692 13194139533465 17592186045585 true] [17592186394689 1075 #edb/ref 17592186394693 13194139533465 17592186045585 true] [17592186394689 1075 #edb/ref 17592186394694 13194139533465 17592186045585 true] [17592186394689 1076 #edb/ref 17592186045493 13194139533465 17592186045585 true] [17592186394689 1077 "selection" 13194139533465 17592186045585 true] [17592186394689 1079 #edb/ref 17592186394693 13194139533465 17592186045585 true] [17592186394689 1080 #uuid "a517e4e9-c7f1-5c48-b08e-bfc1ef17b5e5" 13194139533465 17592186045585 true] [17592186394690 1081 "a=⟨18,\\,\\frac{1}{{t}^{2}}⟩" 13194139533465 17592186045585 true] [17592186394690 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394690 1084 #uuid "ab87df10-dd7f-5124-963d-bf4c394614d6" 13194139533465 17592186045585 true] [17592186394691 1081 "a=⟨18t,\\,-\\frac{2}{t}⟩" 13194139533465 17592186045585 true] [17592186394691 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394691 1084 #uuid "c63d9c83-e34e-558e-8ae3-fc836736d6c3" 13194139533465 17592186045585 true] [17592186394692 1081 "a=⟨9{t}^{2}+1,\\,\\frac{1}{t}⟩" 13194139533465 17592186045585 true] [17592186394692 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394692 1084 #uuid "38b37a91-571a-5339-b19f-1605a1381473" 13194139533465 17592186045585 true] [17592186394693 1081 "a=⟨18t,\\,-\\frac{1}{{t}^{2}}⟩" 13194139533465 17592186045585 true] [17592186394693 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394693 1084 #uuid "3db78a2c-6537-5296-80b7-167fd4035b5f" 13194139533465 17592186045585 true] [17592186394694 1081 "a=⟨9{t}^{2}+1,\\,-\\frac{1}{{t}^{2}}⟩" 13194139533465 17592186045585 true] [17592186394694 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394694 1084 #uuid "66b578b5-b668-5062-b023-bcdcd606cfaa" 13194139533465 17592186045585 true] [17592186394695 1068 #edb/ref 17592186394696 13194139533465 17592186045585 true] [17592186394695 1069 "q-85609" 13194139533465 17592186045585 true] [17592186394695 1070 #edb/ref 17592186045487 13194139533465 17592186045585 true] [17592186394695 1071 "The position vector $r$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr=⟨{e}^{2-t},\\,3+{t}^{4}⟩.\n$$\n\nCalculate the acceleration vector $a$ at time $t=2.$" 13194139533465 17592186045585 true] [17592186394695 1072 #uuid "7c35299e-e7ea-52d7-8411-4ed07a1c0894" 13194139533465 17592186045585 true] [17592186394695 1074 "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{2-t}),\\,\\frac{\\text{d}}{\\text{d}t}(3+{t}^{4})⟩ \\\\  & =⟨-{e}^{2-t},\\,4{t}^{3}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-{e}^{2-t}),\\,\\frac{\\text{d}}{\\text{d}t}(4{t}^{3})⟩ \\\\  & =⟨{e}^{2-t},\\,12{t}^{2}⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨{e}^{2-2},12(2)^{2}⟩ \\\\  & =⟨1,48⟩\\end{aligned}\n$$" 13194139533465 17592186045585 true] [17592186394696 1075 #edb/ref 17592186394697 13194139533465 17592186045585 true] [17592186394696 1075 #edb/ref 17592186394698 13194139533465 17592186045585 true] [17592186394696 1075 #edb/ref 17592186394699 13194139533465 17592186045585 true] [17592186394696 1075 #edb/ref 17592186394700 13194139533465 17592186045585 true] [17592186394696 1075 #edb/ref 17592186394701 13194139533465 17592186045585 true] [17592186394696 1076 #edb/ref 17592186045493 13194139533465 17592186045585 true] [17592186394696 1077 "selection" 13194139533465 17592186045585 true] [17592186394696 1079 #edb/ref 17592186394701 13194139533465 17592186045585 true] [17592186394696 1080 #uuid "66aac930-2d92-52fb-a347-e888b276edb6" 13194139533465 17592186045585 true] [17592186394697 1081 "a(2)=⟨-1,24⟩" 13194139533465 17592186045585 true] [17592186394697 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394697 1084 #uuid "d3eb1023-8fe9-5f8a-9ed6-e733f9b55470" 13194139533465 17592186045585 true] [17592186394698 1081 "a(2)=⟨0,48⟩" 13194139533465 17592186045585 true] [17592186394698 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394698 1084 #uuid "255a3bd0-0ade-5cd9-be87-ddbf8293d7c9" 13194139533465 17592186045585 true] [17592186394699 1081 "a(2)=⟨1,96⟩" 13194139533465 17592186045585 true] [17592186394699 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394699 1084 #uuid "bffa36e6-c392-5dbf-94e3-7f1a95af1a72" 13194139533465 17592186045585 true] [17592186394700 1081 "a(2)=⟨0,24⟩" 13194139533465 17592186045585 true] [17592186394700 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394700 1084 #uuid "865d7135-3b82-57df-a140-3dd131381f5c" 13194139533465 17592186045585 true] [17592186394701 1081 "a(2)=⟨1,48⟩"