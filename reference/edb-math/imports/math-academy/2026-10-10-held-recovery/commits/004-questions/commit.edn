d-531e-be78-00e7e79b2c2c" 13194139533465 17592186045585 true] [17592186394773 1081 "{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" 13194139533465 17592186045585 true] [17592186394773 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394773 1084 #uuid "62384223-dfca-50c8-877c-337a26a0358a" 13194139533465 17592186045585 true] [17592186394774 1081 "2{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" 13194139533465 17592186045585 true] [17592186394774 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394774 1084 #uuid "cfc2ceff-0cf2-5285-a027-d57e020bb89c" 13194139533465 17592186045585 true] [17592186394775 1081 "\\frac{1}{2}{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" 13194139533465 17592186045585 true] [17592186394775 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394775 1084 #uuid "f91b87f6-7751-5ae0-82fb-3bf1cec07cbf" 13194139533465 17592186045585 true] [17592186394776 1081 "0" 13194139533465 17592186045585 true] [17592186394776 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394776 1084 #uuid "9c2684b2-bcb0-5f63-8490-f97890bfc88f" 13194139533465 17592186045585 true] [17592186394777 1081 "-{\\int }_{0}^{3}{x}^{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x" 13194139533465 17592186045585 true] [17592186394777 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394777 1084 #uuid "6071726a-10de-5a3c-a866-c13a54ca8fdf" 13194139533465 17592186045585 true] [17592186394778 1068 #edb/ref 17592186394779 13194139533465 17592186045585 true] [17592186394778 1069 "q-88454" 13194139533465 17592186045585 true] [17592186394778 1070 #edb/ref 17592186045485 13194139533465 17592186045585 true] [17592186394778 1071 "What is the product of solutions of the equation ${x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x}=0?$" 13194139533465 17592186045585 true] [17592186394778 1072 #uuid "4d2284d9-59bd-591b-a5ed-82b600cb5dc8" 13194139533465 17592186045585 true] [17592186394778 1074 "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {4}^{3x}-25\\cdot {4}^{3x} & =0 \\\\ ({x}^{2}-25)\\cdot {4}^{3x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-25=0\\,\\text{and}\\,{4}^{3x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-25=0$ can be factored as\n\n$$\n(x+5)(x-5)=0,\n$$\n\nwhich leads to the solutions $x=-5,5.$\n\n- The equation ${4}^{3x}=0$ has no solutions because ${4}^{3x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,5,$ and their product is $(-5)\\cdot 5=-25.$" 13194139533465 17592186045585 true] [17592186394779 1075 #edb/ref 17592186394780 13194139533465 17592186045585 true] [17592186394779 1075 #edb/ref 17592186394781 13194139533465 17592186045585 true] [17592186394779 1075 #edb/ref 17592186394782 13194139533465 17592186045585 true] [17592186394779 1075 #edb/ref 17592186394783 13194139533465 17592186045585 true] [17592186394779 1075 #edb/ref 17592186394784 13194139533465 17592186045585 true] [17592186394779 1076 #edb/ref 17592186045493 13194139533465 17592186045585 true] [17592186394779 1077 "selection" 13194139533465 17592186045585 true] [17592186394779 1079 #edb/ref 17592186394783 13194139533465 17592186045585 true] [17592186394779 1080 #uuid "4a33ee9e-e01b-57c4-b697-df179407774b" 13194139533465 17592186045585 true] [17592186394780 1081 "-5" 13194139533465 17592186045585 true] [17592186394780 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394780 1084 #uuid "a34bd077-9be1-5cd3-be13-0e0181077e9b" 13194139533465 17592186045585 true] [17592186394781 1081 "25" 13194139533465 17592186045585 true] [17592186394781 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186394781 1084 #uuid "3a5c3e71-7f6d-594f-a826-d9fafbec86ef" 1319413953