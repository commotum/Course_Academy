423 1080 #uuid "5c625c76-a044-5d00-8e7b-aae0bedd3be2" 13194139533465 17592186045585 true] [17592186395424 1081 "⟨-2,\\,6,\\,-4⟩" 13194139533465 17592186045585 true] [17592186395424 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395424 1084 #uuid "29a4ca46-2d86-5674-925d-0fca36cce902" 13194139533465 17592186045585 true] [17592186395425 1081 "⟨2,\\,-6,\\,4⟩" 13194139533465 17592186045585 true] [17592186395425 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395425 1084 #uuid "73270a0c-faaa-5059-903b-a2dbfd94f784" 13194139533465 17592186045585 true] [17592186395426 1081 "⟨-1,\\,3,\\,-2⟩" 13194139533465 17592186045585 true] [17592186395426 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395426 1084 #uuid "cbd5832f-7dce-5750-ba86-e382d26ba47d" 13194139533465 17592186045585 true] [17592186395427 1081 "⟨3,\\,-2,\\,-1⟩" 13194139533465 17592186045585 true] [17592186395427 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395427 1084 #uuid "292d6f26-5842-5490-9a69-e3d9649895fb" 13194139533465 17592186045585 true] [17592186395428 1081 "⟨-3,\\,2,\\,1⟩" 13194139533465 17592186045585 true] [17592186395428 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395428 1084 #uuid "2312de20-e709-5b80-a27b-d10d7e0e5430" 13194139533465 17592186045585 true] [17592186395429 1068 #edb/ref 17592186395430 13194139533465 17592186045585 true] [17592186395429 1069 "q-98142" 13194139533465 17592186045585 true] [17592186395429 1070 #edb/ref 17592186045485 13194139533465 17592186045585 true] [17592186395429 1071 "Calculate the distance between the points $(3w,2w,7w)$ and $(-w,6w,3w),$ given that $w$ is positive." 13194139533465 17592186045585 true] [17592186395429 1072 #uuid "fb9ffaa1-a202-507f-aa7e-4d95a973e5e2" 13194139533465 17592186045585 true] [17592186395429 1074 "The distance $d$ between two points $({x}_{1},{y}_{1},{z}_{1})$ and $({x}_{2},{y}_{2},{z}_{2})$ is given by\n\n$$\nd=\\sqrt{({x}_{2}-{x}_{1}{)}^{2}+({y}_{2}-{y}_{1}{)}^{2}+({z}_{2}-{z}_{1}{)}^{2}}.\n$$\n\nIn this case, we have ${{(3w,2w,7w)}_{⏟}}_{\\text{(}{x}_{1}\\text{, }{y}_{1}\\text{, }{z}_{1}\\text{)}}$ and ${{(-w,6w,3w)}_{⏟}}_{\\text{(}{x}_{2}\\text{, }{y}_{2}\\text{, }{z}_{2}\\text{)}}.$ Applying the distance formula, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{(-w-3w{)}^{2}+(6w-2w{)}^{2}+(3w-7w{)}^{2}} \\\\  & =\\sqrt{(-4w{)}^{2}+(4w{)}^{2}+(-4w{)}^{2}} \\\\  & =\\sqrt{16{w}^{2}+16{w}^{2}+16{w}^{2}} \\\\  & =\\sqrt{48{w}^{2}} \\\\  & =\\sqrt{48}\\,\\sqrt{{w}^{2}} \\\\  & =4\\sqrt{3}\\,|w|.\\end{aligned}\n$$\n\nFinally, since $w$ is positive, we have $|w|=w.$ Therefore,\n\n$$\nd=4\\sqrt{3}\\,w.\n$$" 13194139533465 17592186045585 true] [17592186395430 1075 #edb/ref 17592186395431 13194139533465 17592186045585 true] [17592186395430 1075 #edb/ref 17592186395432 13194139533465 17592186045585 true] [17592186395430 1075 #edb/ref 17592186395433 13194139533465 17592186045585 true] [17592186395430 1075 #edb/ref 17592186395434 13194139533465 17592186045585 true] [17592186395430 1075 #edb/ref 17592186395435 13194139533465 17592186045585 true] [17592186395430 1076 #edb/ref 17592186045493 13194139533465 17592186045585 true] [17592186395430 1077 "selection" 13194139533465 17592186045585 true] [17592186395430 1079 #edb/ref 17592186395435 13194139533465 17592186045585 true] [17592186395430 1080 #uuid "ea09eb90-beeb-5d00-94ad-88249fe8aeca" 13194139533465 17592186045585 true] [17592186395431 1081 "4\\sqrt{2}\\,w" 13194139533465 17592186045585 true] [17592186395431 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395431 1084 #uuid "81b1c11b-b4b1-536c-8889-3a3eb09882dd" 13194139533465 17592186045585 true] [17592186395432 1081 "7w" 13194139533465 17592186045585 true] [17592186395432 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395432 1084 #uuid "c96ad5b8-0210-5052-9081-f410de18a5e7" 13194139533465 17592186045585 true] [17592186395433 1081 "6w" 13194139533465 17592186045585 true] [17592186395433 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395433 1084 #uuid "398a8fd3-2eed-529b-9541-d6be85bc82d2" 13194139533465 17592186045585 true] [17592186395434 1081 "2\\sqrt{3}\\,w" 13194139533465 17592186045585 true] [17592186395434 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395434 1084 #uuid "04663b1a-f275-5578-853a-d2e34a0425ba" 13194139533465 17592186045585 true] [17592186395435 1081 "4\\sqrt{3}\\,w" 13194139533465 17592186045585 true] [17592186395435 1083 #edb/ref 17592186045499 13194139533465 17592186045585 true] [17592186395435 1084 #uuid "16d6cb4d-d2f4-501f-8ae8-ed5949dd56c5" 13194139533465 17592186045585 true] [17592186395436 1068 #edb/ref 17592186395437 13194139533465 17592186045585 true] [17592186395436 1069 "q-98158" 13194139533465 17592186045585 true] [17592186395436 1070 #edb/ref 17592186045485 13194139533465 17592186045585 true] [17592186395436 1071 "Calculate \n${\\int }_{0}^{3}[\\frac{1}{2}f(t)-g(t)]\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨-6,\\,-2,\\,8⟩$\nand \n${\\int }_{0}^{3}g(t)\\,\\text{d}t=⟨4,\\,3,\\,-1⟩.$" 13194139533465 17592186045585 true] [17592186395436 1072 #uuid "8f54ef51-56ed-57bf-ac96-48cf9f9bc402" 13194139533465 17592186045585 true] [17592186395436 1074 "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{3}[\\frac{1}{2}f(t)-g(t)]\\,\\text{d}t=\\frac{1}{2}{\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{3}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}[\\frac{1}{2}f(t)-g(t)]\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{3}g(t)\\,\\text{d}t \\\\  & =\\frac{1}{2}⟨-6,\\,-2,\\,8⟩-⟨4,\\,3,\\,-1⟩ \\\\  & =⟨-3,\\,-1,\\,4⟩-⟨4,\\,3,\\,-1⟩ \\\\  & =⟨-7,\\,-4,\\,5⟩.\\end{aligned}\n$$" 13194139533465 17592186045585 true] [17592186395437 1075 #edb/ref 17592186395438 13194139533465 17592186045585 true] [175921863