 true] [17592186386952 1075 #edb/ref 17592186386956 13194139533462 17592186045585 true] [17592186386952 1075 #edb/ref 17592186386957 13194139533462 17592186045585 true] [17592186386952 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386952 1077 "selection" 13194139533462 17592186045585 true] [17592186386952 1079 #edb/ref 17592186386954 13194139533462 17592186045585 true] [17592186386952 1080 #uuid "b0551f94-457b-5c49-a222-37da906e023c" 13194139533462 17592186045585 true] [17592186386953 1081 "images/28/28cea5c0c95e4693ea10aedebf1f361737dff629bc961efb085c0a5f726b2d17.png" 13194139533462 17592186045585 true] [17592186386953 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186386953 1084 #uuid "8676a75f-0b27-5454-9e68-fb96005d3b42" 13194139533462 17592186045585 true] [17592186386954 1081 "images/a1/a161b298270d5483561400697453451cdb2ed41e4e1390fb41f63780b908d5ef.png" 13194139533462 17592186045585 true] [17592186386954 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186386954 1084 #uuid "135f7456-cda5-5ee1-b9ce-ac880059fdf1" 13194139533462 17592186045585 true] [17592186386955 1081 "images/b5/b51e287d7e6d20932c70c6a81e565b647230416aa54e25f35546d181e4767689.png" 13194139533462 17592186045585 true] [17592186386955 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186386955 1084 #uuid "117e207d-3e92-5dbc-97ae-4930af25295b" 13194139533462 17592186045585 true] [17592186386956 1081 "images/eb/eb596c47096ee36672f95a67be1b736c1478dce6f61ac5d7f950f922bc4a6dae.png" 13194139533462 17592186045585 true] [17592186386956 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186386956 1084 #uuid "316da0f4-ac19-53f8-bd1f-d5b24c5db74e" 13194139533462 17592186045585 true] [17592186386957 1081 "images/70/70a2d28e1c9e5fc7905c999d40151dc32d6cb36a129009a2d869f4f78e4cd73c.png" 13194139533462 17592186045585 true] [17592186386957 1083 #edb/ref 17592186045498 13194139533462 17592186045585 t