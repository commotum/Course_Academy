5 true] [17592186387973 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387973 1084 #uuid "8d5a335a-8c39-5296-9221-80718d983791" 13194139533462 17592186045585 true] [17592186387974 1081 "r=⟨3,2,-1⟩+s⟨0,-1,0⟩+t⟨2,-3,1⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139533462 17592186045585 true] [17592186387974 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387974 1084 #uuid "a1feedd1-adb2-5c03-b2da-3a56801de734" 13194139533462 17592186045585 true] [17592186387975 1081 "r=⟨3,2,-1⟩+s⟨1,0,-1⟩+t⟨-1,3,2⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139533462 17592186045585 true] [17592186387975 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387975 1084 #uuid "9a555223-84bf-5c63-a527-b176aedbb599" 13194139533462 17592186045585 true] [17592186387976 1081 "r=⟨3,2,-1⟩+s⟨1,-1,1⟩+t⟨3,-1,2⟩,\\,s,t\\in (-\\infty ,\\infty )" 13194139533462 17592186045585 true] [17592186387976 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387976 1084 #uuid "0604c24b-d46b-5997-bc46-46a6a514d076" 13194139533462 17592186045585 true] [17592186387977 1068 #edb/ref 17592186387978 13194139533462 17592186045585 true] [17592186387977 1069 "q-128896" 13194139533462 17592186045585 true] [17592186387977 1070 #edb/ref 17592186045486 13194139533462 17592186045585 true] [17592186387977 1071 "Find $(f\\times g)^{′}(t)$ given that\n\n$$\n\\begin{aligned}f(t) & =⟨t,\\,5,\\,{t}^{4}⟩, \\\\ g(t) & =⟨{t}^{2},\\,{t}^{3},\\,t⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387977 1072 #uuid "c21f1368-688b-50ed-bde8-7422d801bdbd" 13194139533462 17592186045585 true] [17592186387977 1074 "Using the cross product rule, we can write:\n\n$$\n(f\\times g)^{′}(t)={f}^{′}(t)\\times g(t)+f(t)\\times {g}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(5),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{4})⟩ \\\\  & =⟨1,\\,0,\\,4{t}^{3}⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨2t,\\,3{t}^{2},\\,1⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(t)\\times g(t) & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 4{t}^{3} \\\\ {t}^{2} & {t}^{3} & t\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 4{t}^{3} \\\\ {t}^{3} & t\\end{aligned}|i-|\\begin{aligned}1 & 4{t}^{3} \\\\ {t}^{2} & t\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ {t}^{2} & {t}^{3}\\end{aligned}|k \\\\  & =⟨-4{t}^{6},\\,4{t}^{5}-t,\\,{t}^{3}⟩, \\\\ f(t)\\times {g}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ t & 5 & {t}^{4} \\\\ 2t & 3{t}^{2} & 1\\end{aligned}| \\\\  & =|\\begin{aligned}5 & {t}^{4} \\\\ 3{t}^{2} & 1\\end{aligned}|i-|\\begin{aligned}t & {t}^{4} \\\\ 2t & 1\\end{aligned}|j+|\\begin{aligned}t & 5 \\\\ 2t & 3{t}^{2}\\end{aligned}|k \\\\  & =⟨5-3{t}^{6},\\,2{t}^{5}-t,\\,3{t}^{3}-10t⟩.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}(f\\times g)^{′}(t) & =⟨-4{t}^{6},\\,4{t}^{5}-t,\\,{t}^{3}⟩+⟨5-3{t}^{6},\\,2{t}^{5}-t,\\,3{t}^{3}-10t⟩ \\\\  & =⟨-7{t}^{6}+5,\\,6{t}^{5}-2t,\\,4{t}^{3}-10t⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387978 1075 #edb/ref 17592186387979 13194139533462 17592186045585 true] [17592186387978 1075 #edb/ref 17592186387980 13194139533462 17592186045585 true] [17592186387978 1075 #edb/ref 17592186387981 13194139533462 17592186045585 true] [17592186387978 1075 #edb/ref 17592186387982 13194139533462 17592186045585 true] [17592186387978 1075 #edb/ref 17592186387983 13194139533462 17592186045585 true] [17592186387978 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387978 1077 "selection" 13194139533462 17592186045585 true] [17592186387978 1079 #edb/ref 17592186387982 13194139533462 17592186045585 true] [17592186387978 1080 #uuid "658bfb28-3b3a-5fa6-937f-fc8138b0b72f" 13194139533462 17592186045585 true] [17592186387979 1081 "⟨5{t}^{6},\\,{t}^{5}+4{t}^{2},\\,4{t}^{3}⟩" 13194139533462 17592186045585 true] [17592186387979 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387979 1084 #uuid "10ec8602-0288-50f5-9393-d24f3e9978eb" 13194139533462 17592186045585 true] [17592186387980 1081 "⟨{t}^{6}-5,\\,4{t}^{5}+2t,\\,4{t}^{3}-10t⟩" 13194139533462 17592186045585 true] [17592186387980 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387980 1084 #uuid "059c4a79-58ba-5ab8-812b-f1ffa1abcd8b" 13194139533462 17592186045585 true] [17592186387981 1081 "⟨2{t}^{6}+1,\\,4{t}^{5},\\,{t}^{3}-5t⟩" 13194139533462 17592186045585 true] [17592186387981 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387981 1084 #uuid "22face6d-6d51-591d-a1b9-744a0e476e64" 13194139533462 17592186045585 true] [17592186387982 1081 "⟨-7{t}^{6}+5,\\,6{t}^{5}-2t,\\,4{t}^{3}-10t⟩" 13194139533462 17592186045585 true] [17592186387982 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387982 1084 #uuid "8428706c-8f90-591b-9287-63282825708a" 13194139533462 17592186045585 true] [17592186387983 1081 "⟨7{t}^{6},\\,6{t}^{5}-5,\\,4{t}^{3}+2t⟩" 13194139533462 17592186045585 true] [17592186387983 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387983 1084 #uuid "5eb7b979-4cab-5af0-b6ed-092b5e887c5a" 13194139533462 17592186045585 true] [17592186387984 1068 #edb/ref 17592186387985 13194139533462 17592186045585 true] [17592186387984 1069 "q-129112" 13194139533462 17592186045585 true] [17592186387984 1070 #edb/ref 17592186045487 13194139533462 17592186045585 true] [17592186387984 1071 "Which of the following represents the level curves of $f(x,y)=y-x?$" 13194139533462 17592186045585 true] [17592186387984 1072 #uuid "e75a1d08-2fa1-51fa-b251-a3f4ae4ef9d8" 13194139533462 17592186045585 true] [17592186387984 1074 "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(