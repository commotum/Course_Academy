e2f12bff3061ef64182b12c1ace178.png" 13194139533462 17592186045585 true] [17592186387997 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186387997 1084 #uuid "6684aa31-9bf2-51dd-b7a2-03fe9aa6f02f" 13194139533462 17592186045585 true] [17592186387998 1068 #edb/ref 17592186387999 13194139533462 17592186045585 true] [17592186387998 1069 "q-129117" 13194139533462 17592186045585 true] [17592186387998 1070 #edb/ref 17592186045486 13194139533462 17592186045585 true] [17592186387998 1071 "![](images/03/037422e7b1ce3b3d9067aba39c4fa85c6311770e63e70758c34aa61629c7f58e.png)\n\nWhich of the following could represent the level curves of the surface $z=-\\operatorname{sin}⁡y$ shown above?" 13194139533462 17592186045585 true] [17592186387998 1072 #uuid "9ec437fa-7d05-53d2-8259-19727f28f519" 13194139533462 17592186045585 true] [17592186387998 1074 "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -\\operatorname{sin}⁡y & =c \\\\ y & =-\\operatorname{arcsin}⁡c+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $y=-\\operatorname{arcsin}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n![](images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png)" 13194139533462 17592186045585 true] [17592186387999 1075 #edb/ref 17592186388000 13194139533462 17592186045585 true] [17592186387999 1075 #edb/ref 17592186388001 13194139533462 17592186045585 true] [17592186387999 1075 #edb/ref 17592186388002 13194139533462 17592186045585 true] [17592186387999 1075 #edb/ref 17592186388003 13194139533462 17592186045585 true] [17592186387999 1075 #edb/ref 17592186388004 13194139533462 17592186045585 true] [17592186387999 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387999 1077 "selection" 13194139533462 17592186045585 true] [17592186387999 1079 #edb/ref 17592186388002 13194139533462 17592186045585 true] [17592186387999 1080 #uuid "5053c438-eb23-5e9c-bd54-db15189721dc" 13194139533462 17592186045585 true] [17592186388000 1081 "images/56/56e923e4c1e2603c9bd3c621df0a5a4043fcc6a37ac73427be14541407fc19d8.png" 13194139533462 17592186045585 true] [17592186388000 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186388000 1084 #uuid "69ffca37-cace-5fde-98f2-279fdf4f3975" 13194139533462 17592186045585 true] [17592186388001 1081 "images/09/09f1a18e1a6fdcd29a40026cbffd8e8bdec23511bb692a1e920c18f942042470.png" 13194139533462 17592186045585 true] [17592186388001 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186388001 1084 #uuid "9ef1d420-a12a-56ca-a25f-8624b9640b47" 13194139533462 17592186045585 true] [17592186388002 1081 "images/67/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" 13194139533462 17592186045585 true] [17592186388002 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186388002 1084 #uuid "6719fa96-fc32-59ff-ad37-8586f87f620f" 13194139533462 17592186045585 true] [17592186388003 1081 "images/aa/aa4d0cd189808c717648640c5543a632c099970a19d38d44298d409054f2627c.png" 13194139533462 17592186045585 true] [17592186388003 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186388003 1084 #uuid "2c7de16e-8fae-51b2-b167-c594ccf39873" 13194139533462 17592186045585 true] [17592186388004 1081 "images/bf/bf0f4b592cde648f63b21523aba1a49aeeb3b4dcaf909ba72c4629e088ca372a.png" 13194139533462 17592186045585 true] [17592186388004 1083 #edb/ref 17592186045498 13194139533462 17592186045585 true] [17592186388004 1084 #uuid "3995e781-cbde-5cfd-b61f-9c376d6d3f49" 13194139533462 17592186045585 true] [17592186388005 1068 #edb/ref 17592186388006 13194139533462 17592186045585 true] [17592186388005 1069 "q-129149" 13194139533462 17592186045585 true] [17592186388005 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186388005 1071 "Calculate ${\\int }_{0}^{3}[2f(t)+4g(t)]\\,\\text{d}t$ given that ${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨-3,\\,\\sqrt{2},\\,2⟩$ and ${\\int }_{0}^{3}g(t)\\,\\text{d}t=⟨-\\frac{3}{2},\\,-\\frac{1}{4},\\,1⟩.$" 13194139533462 17592186045585 true] [17592186388005 1072 #uuid "57f0244e-104a-5517-a9c5-a53620a2a15d" 13194139533462 17592186045585 true] [17592186388005 1074 "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{3}[2f(t)+4g(t)]\\,\\text{d}t=2{\\int }_{0}^{3}f(t)\\,\\text{d}t+4{\\int }_{0}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}[2f(t)+4g(t)]\\,\\text{d}t & =2{\\int }_{0}^{3}f(t)\\,\\text{d}t+4{\\int }_{0}^{3}g(t)\\,\\text{d}t \\\\  & =2⟨-3,\\,\\sqrt{2},\\,2⟩+4⟨-\\frac{3}{2},\\,-\\frac{1}{4},\\,1⟩ \\\\  & =⟨-6,\\,2\\sqrt{2},\\,4⟩+⟨-6,\\,-1,\\,4⟩ \\\\  & =⟨-12,\\,2\\sqrt{2}-1,\\,8⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186388006 1075 #edb/ref 17592186388007 13194139533462 17592186045585 true] [17592186388006 1075 #edb/ref 17592186388008 13194139533462 17592186045585 true] [17592186388006 1075 #edb/ref 17592186388009 13194139533462 17592186045585 true] [17592186388006 1075 #edb/ref 17592186388010 13194139533462 17592186045585 true] [17592186388006 1075 #edb/ref 17592186388011 13194139533462 17592186045585 true] [17592186388006 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186388006 1077 "selection" 13194139533462 17592186045585 true] [17592186388006 1079 #edb/ref 17592186388011 13194139533462 17592186045585 true] [17592186388006 1080 #uuid "08002127-d475-5849-b316-13394942fb74" 13194139533462 17592186045585 true] [17592186388007 1081 "⟨-12,\\,2\\sqrt{2}+1,\\,0⟩" 13194139533462 17592186045585 true] [17592186388007 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388007 1084 #uuid "afc8add8-a972-543e-ba5d-502649377eed" 13194139533462 17592186045585 true] [17592186388008 1081 "⟨-5,\\,\\sqrt{2}-2,\\,4⟩" 13194139533462 17592186045585 true] [17592186388008 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388008 1084 #uuid "88d76c60-f635-5b53-b9a2-21eb7b22c38d" 13194139533462 17592186045585 true] [17592186388009 1081 "⟨-10,\\,2\\sqrt{2}-6,\\,4⟩" 13194139533462 17592186045585 true] [17592186388009 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388009 1084 #uuid "c6d13bc7-8fd9-5c74-85e1-35ca1c16399f" 13194139533462 17592186045585 true] [17592186388010 1081 "⟨-6,\\,5\\sqrt{2}+1,\\,6⟩" 13194139533462 17592186045585 true] [17592186388010 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388010 1084 #uuid "b3f9b0d5-b1ef-500e-9a9a-1756568b9eee" 13194139533462 17592186045585 true] [17592186388011 1081 "⟨-12,\\,2\\sqrt{2}-1,\\,8⟩" 13194139533462 17592186045585 true] [17592186388011 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388011 1084 #uuid "a27359af-1ebf-57f7-a5f2-e6e3c036c4a9" 13194139533462 17592186045585 true] [17592186388012 1068 #edb/ref 17592186388013 13194139533462 17592186045585 true] [17592186388012 1069 "q-129169" 13194139533462 17592186045585 true] [17592186388012 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186388012 1071 "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n{\\begin{aligned}2x+3z-11=0 \\\\ 2x-2y-5=0\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186388012 1072 #uuid "d0aedac8-4550-5f55-b4ac-09ba9ac8ed13" 13194139533462 17592186045585 true] [17592186388012 1074 "First, we notice:\n\n- For the plane $2x+3z-11=0,$ a normal vector to the plane is ${n}_{1}=⟨2,0,3⟩.$\n\n- For the plane $2x-2y-5=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-2,0⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,0,3⟩\\times ⟨2,-2,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & 0 & 3 \\\\ 2 & -2 & 0\\end{aligned}\\right| \\\\  & =6i+6j-4k \\\\  & =⟨6,6,-4⟩\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186388013 1075 #edb/ref 17592186388014 13194139533462 17592186045585 true] [17592186388013 1075 #edb/ref 17592186388015 13194139533462 17592186045585 true] [17592186388013 1075 #edb/ref 17592186388016 13194139533462 17592186045585 true] [17592186388013 1075 #edb/ref 17592186388017 13194139533462 17592186045585 true] [17592186388013 1075 #edb/ref 17592186388018 13194139533462 17592186045585 true] [17592186388013 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186388013 1077 "selection" 13194139533462 17592186045585 true] [17592186388013 1079 #edb/ref 17592186388016 13194139533462 17592186045585 true] [17592186388013 1080 #uuid "38007ff1-e837-5245-a985-db1b0cc61194" 13194139533462 17592186045585 true] [17592186388014 1081 "⟨-4,6,6⟩" 13194139533462 17592186045585 true] [17592186388014 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388014 1084 #uuid "3d469811-ad49-51b7-ba98-f36dda7fa8bb" 13194139533462 17592186045585 true] [17592186388015 1081 "⟨6,-4,6⟩" 13194139533462 17592186045585 true] [17592186388015 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388015 1084 #uuid "55c95756-c3ad-51e7-bfd2-ff829b2645f8" 13194139533462 17592186045585 true] [17592186388016 1081 "⟨6,6,-4⟩" 13194139533462 17592186045585 true] [17592186388016 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388016 1084 #uuid "7db145f2-bd3e-56ff-83a7-ec3ad48ffafe" 13194139533462 17592186045585 true] [17592186388017 1081 "⟨4,-6,6⟩" 13194139533462 17592186045585 true] [17592186388017 1083 #edb/ref 17592186045499 13194139533462 1759