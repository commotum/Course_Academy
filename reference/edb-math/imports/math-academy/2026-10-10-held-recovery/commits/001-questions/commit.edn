533462 17592186045585 true] [17592186387794 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387794 1084 #uuid "4bc8ff65-683e-5598-9183-38c4f3865f52" 13194139533462 17592186045585 true] [17592186387795 1068 #edb/ref 17592186387796 13194139533462 17592186045585 true] [17592186387795 1069 "q-127217" 13194139533462 17592186045585 true] [17592186387795 1070 #edb/ref 17592186045487 13194139533462 17592186045585 true] [17592186387795 1071 "Which of the following gives the unit tangent vector to the curve\n $r(t)=⟨2t,\\,4\\operatorname{sin}⁡2t,\\,4\\operatorname{cos}⁡2t⟩$ at an arbitrary point where $t\\in (-\\infty ,\\infty )?$" 13194139533462 17592186045585 true] [17592186387795 1072 #uuid "cfd26752-53ee-5373-a6ae-af80bab0a577" 13194139533462 17592186045585 true] [17592186387795 1074 "For a curve $r(t)=⟨x(t),\\,y(t),\\,z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}\n$$\n\nFirst, we find the derivative of $r(t):$  \n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t),\\,\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡2t)⟩ \\\\  & =⟨2,\\,8\\operatorname{cos}⁡2t,\\,-8\\operatorname{sin}⁡2t⟩\\end{aligned}\n$$\n\nNext, we calculate the magnitude of ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{r}^{′}(t)‖ & =\\sqrt{{(2)}^{2}+(8\\operatorname{cos}⁡2t)^{2}+{(-8\\operatorname{sin}⁡2t)}^{2}} \\\\  & =\\sqrt{4+64{cos}^{2}⁡2t+64{sin}^{2}⁡2t} \\\\  & =2\\sqrt{1+16({cos}^{2}⁡2t+{sin}^{2}⁡2t)} \\\\  & =2\\sqrt{1+16} \\\\  & =2\\sqrt{17}\\end{aligned}\n$$\n\n Finally, we normalize ${r}^{′}(t)$ and obtain the unit tangent vector to the curve:\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{2\\sqrt{17}}⟨2,\\,8\\operatorname{cos}⁡2t,\\,-8\\operatorname{sin}⁡2t⟩ \\\\  & =\\frac{1}{\\sqrt{17}}⟨1,\\,4\\operatorname{cos}⁡2t,\\,-4\\operatorname{sin}⁡2t⟩\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387796 1075 #edb/ref 17592186387797 13194139533462 17592186045585 true] [17592186387796 1075 #edb/ref 17592186387798 13194139533462 17592186045585 true] [17592186387796 1075 #edb/ref 17592186387799 13194139533462 17592186045585 true] [17592186387796 1075 #edb/ref 17592186387800 13194139533462 17592186045585 true] [17592186387796 1075 #edb/ref 17592186387801 13194139533462 17592186045585 true] [17592186387796 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387796 1077 "selection" 13194139533462 17592186045585 true] [17592186387796 1079 #edb/ref 17592186387799 13194139533462 17592186045585 true] [17592186387796 1080 #uuid "199f3d52-77f3-5d4a-a683-3eb8e1bfd53d" 13194139533462 17592186045585 true] [17592186387797 1081 "\\frac{1}{\\sqrt{17}}⟨t,\\,\\operatorname{cos}⁡2t,\\,-\\operatorname{sin}⁡2t⟩" 13194139533462 17592186045585 true] [17592186387797 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387797 1084 #uuid "28df22e1-dd03-5947-b0ac-b9a1f7c2c1e6" 13194139533462 17592186045585 true] [17592186387798 1081 "\\frac{2}{17}⟨t,\\,2\\operatorname{cos}⁡2t,\\,-2\\operatorname{sin}⁡2t⟩" 13194139533462 17592186045585 true] [17592186387798 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387798 1084 #uuid "c8c9481c-8fb4-5f53-acbc-cdca05453868" 13194139533462 17592186045585 true] [17592186387799 1081 "\\frac{1}{\\sqrt{17}}⟨1,\\,4\\operatorname{cos}⁡2t,\\,-4\\operatorname{sin}⁡2t⟩" 13194139533462 17592186045585 true] [17592186387799 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387799 1084 #uuid "9d65ed45-2ec2-51f2-9a7e-ba5c68d47742" 13194139533462 17592186045585 true] [17592186387800 1081 "\\frac{1}{17}⟨1,\\,4\\operatorname{cos}⁡2t,\\,-4\\operatorname{sin}⁡2t⟩" 13194139533462 17592186045585 true] [17592186387800 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387800 1084 #uuid "f559334c-f8c3-5f1d-a130-8cbdd402370b" 13194139533462 17592186045585 true] [17592186387801 1081 "\\frac{1}{\\sqrt{17}}⟨{t}^{2},\\,2\\operatorname{cos}⁡2t,\\,-2\\operatorname{sin}⁡2t⟩" 13194139533462 17592186045585 true] [17592186387801 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387801 1084 #uuid "fd4e9326-f664-59ef-be01-6624b9f86439" 13194139533462 17592186045585 true] [17592186387802 1068 #edb/ref 17592186387803 13194139533462 17592186045585 true] [17592186387802 1069 "q-127221" 13194139533462 17592186045585 true] [17592186387802 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186387802 1071 "Find the unit tangent vector to the curve $r(t)=⟨-\\sqrt{3}\\operatorname{cos}⁡t,\\,-\\operatorname{cos}⁡t,\\,2\\operatorname{sin}⁡t⟩$ at the point where $t=\\frac{\\pi }{3}.$" 13194139533462 17592186045585 true] [17592186387802 1072 #uuid "3540ef43-cb67-51c1-8423-cebf06f99cf4" 13194139533462 17592186045585 true] [17592186387802 1074 "For a curve $r(t)=⟨x(t),y(t),z(t)⟩$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{3}:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\sqrt{3}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)⟩ \\\\  & =⟨\\sqrt{3}\\operatorname{sin}⁡t,\\,\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t⟩ \\\\ {r}^{′}(\\frac{\\pi }{3}) & =⟨\\sqrt{3}\\operatorname{sin}⁡(\\frac{\\pi }{3}),\\,\\operatorname{sin}⁡(\\frac{\\pi }{3}),\\,2\\operatorname{cos}⁡(\\frac{\\pi }{3})⟩ \\\\  & =⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},1⟩\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}(\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}‖{r}^{′}(\\frac{\\pi }{3})‖ & =\\sqrt{{(\\frac{3}{2})}^{2}+{(\\frac{\\sqrt{3}}{2})}^{2}+(1)^{2}} \\\\  & =\\sqrt{\\frac{9}{4}+\\frac{3}{4}+1} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(\\frac{\\pi }{3})$ and obtain the unit tangent vector to the given curve at the point where $t=\\frac{\\pi }{3}:$\n\n$$\n\\begin{aligned}T(\\frac{\\pi }{3}) & =\\frac{{r}^{′}(\\frac{\\pi }{3})}{‖{r}^{′}(\\frac{\\pi }{3})‖} \\\\  & =\\frac{1}{2}⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},1⟩ \\\\  & =⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387803 1075 #edb/ref 17592186387804 13194139533462 17592186045585 true] [17592186387803 1075 #edb/ref 17592186387805 13194139533462 17592186045585 true] [17592186387803 1075 #edb/ref 17592186387806 13194139533462 17592186045585 true] [17592186387803 1075 #edb/ref 17592186387807 13194139533462 17592186045585 true] [17592186387803 1075 #edb/ref 17592186387808 13194139533462 17592186045585 true] [17592186387803 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387803 1077 "selection" 13194139533462 17592186045585 true] [17592186387803 1079 #edb/ref 17592186387805 13194139533462 17592186045585 true] [17592186387803 1080 #uuid "f7f87249-b6b1-5efb-aa0a-6f8127d0855d" 13194139533462 17592186045585 true] [17592186387804 1081 "⟨2,\\frac{\\sqrt{3}}{4},-1⟩" 13194139533462 17592186045585 true] [17592186387804 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387804 1084 #uuid "193b4900-4d07-53e2-be4e-48d5ec8d43ca" 13194139533462 17592186045585 true] [17592186387805 1081 "⟨\\frac{3}{4},\\frac{\\sqrt{3}}{4},\\frac{1}{2}⟩" 13194139533462 17592186045585 true] [17592186387805 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387805 1084 #uuid "1f8b69e0-aa2b-5483-90dc-48d46fb9dab2" 13194139533462 17592186045585 true] [17592186387806 1081 "⟨-\\frac{3}{4},\\frac{\\sqrt{3}}{2},2⟩" 13194139533462 17592186045585 true] [17592186387806 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387806 1084 #uuid "f829b1b0-0a47-5ec0-9116-1383df3f1616" 13194139533462 17592186045585 true] [17592186387807 1081 "⟨\\frac{3}{2},\\frac{\\sqrt{3}}{2},\\frac{1}{4}⟩" 13194139533462 17592186045585 true] [17592186387807 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387807 1084 #uuid "74a4e07c-290d-5499-a014-7387d054ab73" 13194139533462 17592186045585 true] [17592186387808 1081 "⟨3,\\frac{\\sqrt{3}}{2},4⟩" 13194139533462 17592186045585 true] [17592186387808 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387808 1084 #uuid "83f0b0aa-1ec1-5f8f-9713-262b37261532" 13194139533462 17592186045585 true] [17592186387809 1068 #edb/ref 17592186387810 13194139533462 17592186045585 true] [17592186387809 1069 "q-127228" 13194139533462 17592186045585 true] [17592186387809 1070 #edb/ref 17592186045487 13194139533462 17592186045585 true] [17592186387809 1071 "Consider the rectangle $C$ with vertices $(0,0),(3,0),(3,2),$ and $(0,2),$  traversed counterclockwise. Using the flux form of Green's theorem, express the flux of the vector field\n$F(x,y)={x}^{2}{y}^{2}\\,i+12xy\\,j$\nthrough $C$ as a repeated integral." 13194139533462 17592186045585 true] [17592186387809 1072 #uuid "6b4bd86f-3707-5569-a669-abddd19a5594" 13194139533462 17592186045585 true] [17592186387809 1074 "Let $C$ be a positively oriented, piecewise-smooth, simple closed curve in the plane, and let $D$ be the region bounded by $C.$ If $F=P\\,i+Q\\,j,$ and $P$ and $Q$ have continuous first derivatives on an open region containing $D,$ then the flux form of Green's theorem states that\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∬}_{D}\\text{div}\\,F\\,\\text{d}A,\n$$\n\nwhich is equivalent to\n\n$$\n{∮}_{C}P\\,dy-Q\\,dx={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A.\n$$\n\nThe region $D$ and the curve $C$ for this case are shown below.\n\n \n\n![](images/23/23066b23aebf332921c22a0439a414ade8dffd2a270641d186da0ed0e9488821.png)\n\nWe have that $P(x,y)={x}^{2}{y}^{2}$ and $Q(x,y)=12xy.$ So,\n\n$$\n\\begin{aligned}\\frac{∂P}{∂x}=2x{y}^{2},\\,\\frac{∂Q}{∂y} & =12x.\\end{aligned}\n$$\n\nWe can express the region $D$ as a type I region as follows:\n\n$$\nD={(x,y):0\\le x\\le 3,\\,0\\le y\\le 2}\n$$\n\nTherefore, applying Green's theorem in flux form, we get\n\n$$\n\\begin{aligned}{∮}_{C}P\\,dy-Q\\,dx & ={∬}_{D}(\\frac{∂P}{∂x}+\\frac{∂Q}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x{y}^{2}+12x)\\,\\text{d}A \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387810 1075 #edb/ref 17592186387811 13194139533462 17592186045585 true] [17592186387810 1075 #edb/ref 17592186387812 13194139533462 17592186045585 true] [17592186387810 1075 #edb/ref 17592186387813 13194139533462 17592186045585 true] [17592186387810 1075 #edb/ref 17592186387814 13194139533462 17592186045585 true] [17592186387810 1075 #edb/ref 17592186387815 13194139533462 17592186045585 true] [17592186387810 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387810 1077 "selection" 13194139533462 17592186045585 true] [17592186387810 1079 #edb/ref 17592186387813 13194139533462 17592186045585 true] [17592186387810 1080 #uuid "a7357b1f-7672-551e-bf04-066c16895432" 13194139533462 17592186045585 true] [17592186387811 1081 "{\\int }_{0}^{2}{\\int }_{0}^{3}(2{y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" 13194139533462 17592186045585 true] [17592186387811 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387811 1084 #uuid "4a2f6f5b-f063-50fd-a445-e5206861484d" 13194139533462 17592186045585 true] [17592186387812 1081 "{\\int }_{0}^{2}{\\int }_{0}^{3}2{y}^{2}(x+6)\\,\\text{d}y\\,\\text{d}x" 13194139533462 17592186045585 true] [17592186387812 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387812 1084 #uuid "ca3a5b14-e539-50ca-b764-e8483d96d0a5" 13194139533462 17592186045585 true] [17592186387813 1081 "{\\int }_{0}^{3}{\\int }_{0}^{2}2x({y}^{2}+6)\\,\\text{d}y\\,\\text{d}x" 13194139533462 17592186045585 true] [17592186387813 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387813 1084 #uuid "ff2802b1-16eb-55bd-a33e-9c02fc8a176a" 13194139533462 17592186045585 true] [17592186387814 1081 "{\\int }_{0}^{2}{\\int }_{0}^{3}({x}^{2}+12y)\\,\\text{d}y\\,\\text{d}x" 13194139533462 17592186045585 true] [17592186387814 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387814 1084 #uuid "8051d521-18c9-5506-8dd8-4404b731cd23" 13194139533462 17592186045585 true] [17592186387815 1081 "{\\int }_{0}^{3}{\\int }_{0}^{2}(2{x}^{2}+y)\\,\\text{d}y\\,\\text{d}x" 13194139533462 17592186045585 true] [17592186387815 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387815 1084 #uuid "2d6e2d0e-132f-5112-af04-61afe3543d74" 13194139533462 17592186045585 true] [17592186387816 1068 #edb/ref 17592186387817 13194139533462 17592186045585 true] [17592186387816 1069 "q-127613" 13194139533462 17592186045585 true] [17592186387816 1070 #edb/ref 17592186045485 13194139533462 17592186045585 true] [17592186387816 1071 "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{3}}⟨-\\sqrt{t},0,\\sqrt{3-t}⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{3}}⟨-\\sqrt{3-t},0,-\\sqrt{t}⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." 13194139533462 17592186045585 true] [17592186387816 1072 #uuid "126d7092-f259-50a6-8d9e-e771713a98c4" 13194139533462 17592186045585 true] [17592186387816 1074 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{3}}⟨-\\sqrt{t},0,\\sqrt{3-t}⟩\\times \\frac{1}{\\sqrt{3}}⟨-\\sqrt{3-t},0,-\\sqrt{t}⟩ \\\\  & =\\frac{1}{3}\\left|\\begin{aligned}i & j & k \\\\ -\\sqrt{t} & 0 & \\sqrt{3-t} \\\\ -\\sqrt{3-t} & 0 & -\\sqrt{t}\\end{aligned}\\right| \\\\  & =\\frac{1}{3}\\left|\\begin{aligned}0 & \\sqrt{3-t} \\\\ 0 & -\\sqrt{t}\\end