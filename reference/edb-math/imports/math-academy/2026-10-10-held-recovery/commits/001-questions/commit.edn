1 & 0 & 0 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 4\\end{aligned}]\n$$" 13194139533462 17592186045585 true] [17592186388327 1072 #uuid "df59a1aa-1439-516c-b162-bd4f36cbb04a" 13194139533462 17592186045585 true] [17592186388327 1074 "Notice that the given matrix is diagonal.\n\nThe inverse of a diagonal matrix can be found as follows: \n\n$$\n{[\\begin{aligned}{a}_{11} & 0 & ⋯ & 0 \\\\ 0 & {a}_{22} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & {a}_{nn}\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{{a}_{11}} & 0 & ⋯ & 0 \\\\ 0 & \\frac{1}{{a}_{22}} & ⋯ & 0 \\\\ ⋮ & ⋮ & ⋱ & ⋮ \\\\ 0 & 0 & ⋯ & \\frac{1}{{a}_{nn}}\\end{aligned}]\n$$\n\nIn our case, we obtain\n\n$$\n{A}^{-1}={[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 0 & 0 & 4\\end{aligned}]}^{-1}=[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & \\frac{1}{4}\\end{aligned}].\n$$" 13194139533462 17592186045585 true] [17592186388328 1075 #edb/ref 17592186388329 13194139533462 17592186045585 true] [17592186388328 1075 #edb/ref 17592186388330 13194139533462 17592186045585 true] [17592186388328 1075 #edb/ref 17592186388331 13194139533462 17592186045585 true] [17592186388328 1075 #edb/ref 17592186388332 13194139533462 17592186045585 true] [17592186388328 1075 #edb/ref 17592186388333 13194139533462 17592186045585 true] [17592186388328 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186388328 1077 "selection" 13194139533462 17592186045585 true] [17592186388328 1079 #edb/ref 17592186388329 13194139533462 17592186045585 true] [17592186388328 1080 #uuid "f09b45e9-dd8e-565d-ab33-a73e99322450" 13194139533462 17592186045585 true] [17592186388329 1081 "[\\begin{aligned}-1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & \\frac{1}{4}\\end{aligned}]" 13194139533462 17592186045585 true] [17592186388329 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186388329 1084 #uuid "40964cdf-1fba-5397-b650-220685d4b822" 13194139533462 17592186045585 true] [17592186388330 1081 "[\\begin{aligned}-1 &