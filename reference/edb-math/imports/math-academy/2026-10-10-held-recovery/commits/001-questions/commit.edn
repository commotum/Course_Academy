ligned}4 & 3 \\\\ -1 & -1\\end{aligned}].\n$$\n\nFinally, we compute $[\\,x\\,]_{C}:$\n\n$$\n\\begin{aligned}[\\,x\\,]_{C} & ={P}_{B\\to C}[\\,x\\,]_{B} \\\\  & =[\\begin{aligned}4 & 3 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}5 \\\\ -7\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386710 1075 #edb/ref 17592186386711 13194139533462 17592186045585 true] [17592186386710 1075 #edb/ref 17592186386712 13194139533462 17592186045585 true] [17592186386710 1075 #edb/ref 17592186386713 13194139533462 17592186045585 true] [17592186386710 1075 #edb/ref 17592186386714 13194139533462 17592186045585 true] [17592186386710 1075 #edb/ref 17592186386715 13194139533462 17592186045585 true] [17592186386710 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386710 1077 "selection" 13194139533462 17592186045585 true] [17592186386710 1079 #edb/ref 17592186386711 13194139533462 17592186045585 true] [17592186386710 1080 #uuid "99d4ef7c-c89c-5840-b177-510543ba8c00" 13194139533462 17592186045585 true] [17592186386711 1081 "[\\begin{aligned}-1 \\\\ 2\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386711 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386711 1084 #uuid "2b21ecb7-ce65-5e1c-88f8-49cf0f4f160b" 13194139533462 17592186045585 true] [17592186386712 1081 "[\\begin{aligned}2 \\\\ -3\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386712 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386712 1084 #uuid "897bfaa9-9628-5f28-badb-b747acdbdf1c" 13194139533462 17592186045585 true] [17592186386713 1081 "[\\begin{aligned}1 \\\\ 3\\end{aligned}]" 13194139533462 17592186045585 true] [17592186386713 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386713 1084 #uuid "8ede5e11-d7f3-54ac-841f-ae72ee3947e7" 13194139533462 17592186045585 true] [17592186386714 1081 "[\\begin{aligned}-2 \\\\ 1\\e