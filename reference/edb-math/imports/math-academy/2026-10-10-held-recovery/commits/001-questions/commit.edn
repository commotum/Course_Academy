{2},\\,0⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f(1)-2g(1))^{′} & ={f}^{′}(1)-2{g}^{′}(1) \\\\  & =⟨2(1),\\,\\frac{1}{1},\\,{e}^{1-1}⟩-2⟨\\frac{1}{\\sqrt{1}},\\,3(1)^{2},\\,0⟩ \\\\  & =⟨2,1,1⟩-2⟨1,3,0⟩ \\\\  & =⟨2,1,1⟩-⟨2,6,0⟩ \\\\  & =⟨0,-5,1⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387873 1075 #edb/ref 17592186387874 13194139533462 17592186045585 true] [17592186387873 1075 #edb/ref 17592186387875 13194139533462 17592186045585 true] [17592186387873 1075 #edb/ref 17592186387876 13194139533462 17592186045585 true] [17592186387873 1075 #edb/ref 17592186387877 13194139533462 17592186045585 true] [17592186387873 1075 #edb/ref 17592186387878 13194139533462 17592186045585 true] [17592186387873 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387873 1077 "selection" 13194139533462 17592186045585 true] [17592186387873 1079 #edb/ref 17592186387878 13194139533462 17592186045585 true] [17592186387873 1080 #uuid "f682f616-b62a-5bba-8f73-0577cd6f697d" 13194139533462 17592186045585 true] [17592186387874 1081 "⟨0,-7,0⟩" 13194139533462 17592186045585 true] [17592186387874 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387874 1084 #uuid "a16c9dc1-0124-53fd-9b82-d496e53dbcff" 13194139533462 17592186045585 true] [17592186387875 1081 "⟨-2,-5,0⟩" 13194139533462 17592186045585 true] [17592186387875 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387875 1084 #uuid "f616ca61-be0f-5144-b6c8-08476269dd60" 13194139533462 17592186045585 true] [17592186387876 1081 "⟨2,7,0⟩" 13194139533462 17592186045585 true] [17592186387876 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387876 1084 #uuid "309785b0-a118-5c93-829d-4b1bec8533d7" 13194139533462 17592186045585 true] [17592186387877 1081 "⟨4,7,9⟩" 13194139533462 17592186045585 true] [17592186387877 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387877 1084 #uuid "a99725fb-c5ed-5e02-9f65-da1970e78632" 13194139533462 17592186045585 true] [17592186387878 1081 "⟨0,-5,1⟩" 13194139533462 17592186045585 true] [17592186387878 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186387878 1084 #uuid "69eaec62-e0f1-50fe-ae12-fb1a693cb8d5" 13194139533462 17592186045585 true] [17592186387879 1068 #edb/ref 17592186387880 13194139533462 17592186045585 true] [17592186387879 1069 "q-128400" 13194139533462 17592186045585 true] [17592186387879 1070 #edb/ref 17592186045486 13194139533462 17592186045585 true] [17592186387879 1071 "Given the Cartesian equation $7x+y-3=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" 13194139533462 17592186045585 true] [17592186387879 1072 #uuid "a275fd86-a21a-5ef1-ae5c-9df806e069b0" 13194139533462 17592186045585 true] [17592186387879 1074 "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨7,1,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}7x+y-3 & =0 \\\\ y & =3-7x.\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=3.$ Hence, the point $P(0,3,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,3,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩ & =0.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186387880 1075 #edb/ref 17592186387881 13194139533462 17592186045585 true] [17592186387880 1075 #edb/ref 17592186387882 13194139533462 17592186045585 true] [17592186387880 1075 #edb/ref 17592186387883 13194139533462 17592186045585 true] [17592186387880 1075 #edb/ref 17592186387884 13194139533462 17592186045585 true] [17592186387880 1075 #edb/ref 17592186387885 13194139533462 17592186045585 true] [17592186387880 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186387880 1077 "selection" 13194139533462 17592186045585 true] [17592186387880 1079 #edb/ref 17592186387884 13194139533462 17592186045585 true] [1759218638