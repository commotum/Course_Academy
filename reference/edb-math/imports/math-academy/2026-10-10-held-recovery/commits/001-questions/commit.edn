186045585 true] [17592186386735 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386735 1084 #uuid "092157f2-38d5-50ad-be92-7e9d8c56698d" 13194139533462 17592186045585 true] [17592186386736 1068 #edb/ref 17592186386737 13194139533462 17592186045585 true] [17592186386736 1069 "q-113929" 13194139533462 17592186045585 true] [17592186386736 1070 #edb/ref 17592186045487 13194139533462 17592186045585 true] [17592186386736 1071 "What is ${\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" 13194139533462 17592186045585 true] [17592186386736 1072 #uuid "0af12d5f-0f9a-59ff-b6c2-207d86cde81b" 13194139533462 17592186045585 true] [17592186386736 1074 "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{3k}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}].\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386737 1075 #edb/ref 17592186386738 13194139533462 17592186045585 true] [17592186386737 1075 #edb/ref 17592186386739 13194139533462 17592186045585 true] [17592186386737 1075 #edb/ref 17592186386740 13194139533462 17592186045585 true] [17592186386737 1075 #edb/ref 17592