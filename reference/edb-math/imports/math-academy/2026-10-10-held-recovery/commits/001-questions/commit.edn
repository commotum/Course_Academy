v & -v\\operatorname{sin}⁡u \\\\ u\\operatorname{cos}⁡v & \\operatorname{cos}⁡u\\end{aligned}|,\\,-|\\begin{aligned}1 & -v\\operatorname{sin}⁡u \\\\ 0 & \\operatorname{cos}⁡u\\end{aligned}|,\\,|\\begin{aligned}1 & \\operatorname{sin}⁡v \\\\ 0 & u\\operatorname{cos}⁡v\\end{aligned}|⟩ \\\\  & =⟨\\operatorname{cos}⁡u\\operatorname{sin}⁡v+uv\\operatorname{sin}⁡u\\operatorname{cos}⁡v,\\,-\\operatorname{cos}⁡u,\\,u\\operatorname{cos}⁡v⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386487 1075 #edb/ref 17592186386488 13194139533462 17592186045585 true] [17592186386487 1075 #edb/ref 17592186386489 13194139533462 17592186045585 true] [17592186386487 1075 #edb/ref 17592186386490 13194139533462 17592186045585 true] [17592186386487 1075 #edb/ref 17592186386491 13194139533462 17592186045585 true] [17592186386487 1075 #edb/ref 17592186386492 13194139533462 17592186045585 true] [17592186386487 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386487 1077 "selection" 13194139533462 17592186045585 true] [17592186386487 1079 #edb/ref 17592186386492 13194139533462 17592186045585 true] [17592186386487 1080 #uuid "e4014425-a793-5c90-8901-fc3e45dbe1ef" 13194139533462 17592186045585 true] [17592186386488 1081 "⟨\\operatorname{sin}⁡u\\operatorname{cos}⁡v-uv\\operatorname{cos}⁡u\\operatorname{sin}⁡v,\\,\\operatorname{cos}⁡u,\\,-u\\operatorname{cos}⁡u⟩" 13194139533462 17592186045585 true] [17592186386488 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386488 1084 #uuid "2eb0d66e-3112-5fe9-9738-ced5916fa2ad" 13194139533462 17592186045585 true] [17592186386489 1081 "⟨uv\\operatorname{cos}⁡u\\operatorname{sin}⁡v,\\,-\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v⟩" 13194139533462 17592186045585 true] [17592186386489 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386489 1084 #uuid "6b6ca289-8138-5fe4-8821-842eff514232" 13194139533462 17592186045585 true] [17592186386490 1081 "⟨\\operatorname{sin}⁡u\\