}^{′}(1,\\frac{1}{2}) \\\\  & =|\\begin{aligned}i & j & k \\\\ 2 & 2 & 0 \\\\ 1 & 0 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}|,\\,-|\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}|,\\,|\\begin{aligned}2 & 2 \\\\ 1 & 0\\end{aligned}|⟩ \\\\  & =⟨2,\\,-2,\\,-2⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386473 1075 #edb/ref 17592186386474 13194139533462 17592186045585 true] [17592186386473 1075 #edb/ref 17592186386475 13194139533462 17592186045585 true] [17592186386473 1075 #edb/ref 17592186386476 13194139533462 17592186045585 true] [17592186386473 1075 #edb/ref 17592186386477 13194139533462 17592186045585 true] [17592186386473 1075 #edb/ref 17592186386478 13194139533462 17592186045585 true] [17592186386473 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386473 1077 "selection" 13194139533462 17592186045585 true] [17592186386473 1079 #edb/ref 17592186386477 13194139533462 17592186045585 true] [17592186386473 1080 #uuid "cca6620a-a827-5f1d-bf89-e162d1d87d1c" 13194139533462 17592186045585 true] [17592186386474 1081 "⟨2,\\,1,\\,3⟩" 13194139533462 17592186045585 true] [17592186386474 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386474 1084 #uuid "b1de710b-6463-5ef2-9960-e326f2c42372" 13194139533462 17592186045585 true] [17592186386475 1081 "⟨2,\\,2,\\,-1⟩" 13194139533462 17592186045585 true] [17592186386475 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386475 1084 #uuid "44406c90-b25b-5de9-849f-8d15c721873e" 13194139533462 17592186045585 true] [17592186386476 1081 "⟨1,\\,2,\\,-2⟩" 13194139533462 17592186045585 true] [17592186386476 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386476 1084 #uuid "8325a92a-cd1f-5548-b896-ba6bf758a443" 13194139533462 17592186045585 true] [17592186386477 1081 "⟨2,\\,-2,\\,-2⟩" 13194139533462 17592186045585 true] [17592186386477 1083 #edb/ref 17592186045499 13194139533462 17592186