begin{aligned}i & j & k \\\\ e & 0 & -e \\\\ 0 & -{e}^{-1} & -{e}^{-1}\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & -e \\\\ -{e}^{-1} & -{e}^{-1}\\end{aligned}|,\\,-|\\begin{aligned}e & -e \\\\ 0 & -{e}^{-1}\\end{aligned}|,\\,|\\begin{aligned}e & 0 \\\\ 0 & -{e}^{-1}\\end{aligned}|⟩ \\\\  & =⟨-1,\\,1,\\,-1⟩.\\end{aligned}\n$$" 13194139533462 17592186045585 true] [17592186386480 1075 #edb/ref 17592186386481 13194139533462 17592186045585 true] [17592186386480 1075 #edb/ref 17592186386482 13194139533462 17592186045585 true] [17592186386480 1075 #edb/ref 17592186386483 13194139533462 17592186045585 true] [17592186386480 1075 #edb/ref 17592186386484 13194139533462 17592186045585 true] [17592186386480 1075 #edb/ref 17592186386485 13194139533462 17592186045585 true] [17592186386480 1076 #edb/ref 17592186045493 13194139533462 17592186045585 true] [17592186386480 1077 "selection" 13194139533462 17592186045585 true] [17592186386480 1079 #edb/ref 17592186386481 13194139533462 17592186045585 true] [17592186386480 1080 #uuid "30ca1fbb-debf-523d-9749-4b55497fe8dd" 13194139533462 17592186045585 true] [17592186386481 1081 "⟨-1,\\,1,\\,-1⟩" 13194139533462 17592186045585 true] [17592186386481 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386481 1084 #uuid "b5d28da5-ced5-5767-b7e4-28ec536cd26e" 13194139533462 17592186045585 true] [17592186386482 1081 "⟨-2,\\,2e,\\,-1⟩" 13194139533462 17592186045585 true] [17592186386482 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386482 1084 #uuid "a90a215d-d1ef-5f2d-8a13-bc4c50cc19dd" 13194139533462 17592186045585 true] [17592186386483 1081 "⟨-1,\\,e,\\,-e⟩" 13194139533462 17592186045585 true] [17592186386483 1083 #edb/ref 17592186045499 13194139533462 17592186045585 true] [17592186386483 1084 #uuid "f6ddedf6-6e04-5ed4-8310-593f14fada4d" 13194139533462 17592186045585 true] [17592186386484 1081 "⟨-{e}^{2},\\,{e}^{-1},\\,-1⟩" 13194139533462 17592186045585 true] [17592186386484 1083 #edb/ref 175