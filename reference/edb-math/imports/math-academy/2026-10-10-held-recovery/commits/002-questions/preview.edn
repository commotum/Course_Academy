285 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389285 1084 #uuid "7d450233-f778-5146-bb61-500a2a3edb67" 13194139533463 17592186045585 true] [17592186389286 1081 "images/92/923d1a1b87833551ae6c451f15a6b5d8bdd75623e8d5c20e86357894bc24683d.png" 13194139533463 17592186045585 true] [17592186389286 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389286 1084 #uuid "ab2665ec-9150-5288-8394-5f9c6a6cd1c6" 13194139533463 17592186045585 true] [17592186389287 1081 "images/81/812c019fe97965e1757b9cf76c18439b69f3d8548b3be1b04530ee0b0e1ad4f4.png" 13194139533463 17592186045585 true] [17592186389287 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389287 1084 #uuid "0820dca7-deb5-5697-9159-8f0f4f3fcbc1" 13194139533463 17592186045585 true] [17592186389288 1081 "images/bf/bf2edb811442fc770f6f3c119c06bca3c17d30537f1941448ddb6ab0afa3eb8a.png" 13194139533463 17592186045585 true] [17592186389288 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389288 1084 #uuid "5fbc07a1-e889-568b-82e7-6e63688d1848" 13194139533463 17592186045585 true] [17592186389289 1081 "images/0e/0e766db6832d6c8d2ad052f57ffc4f112ec995bd1462fb6a0998abf72c5d2059.png" 13194139533463 17592186045585 true] [17592186389289 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389289 1084 #uuid "ffe48311-c82e-59ca-9751-9099ff7e1583" 13194139533463 17592186045585 true] [17592186389290 1068 #edb/ref 17592186389291 13194139533463 17592186045585 true] [17592186389290 1069 "q-16230" 13194139533463 17592186045585 true] [17592186389290 1070 #edb/ref 17592186045486 13194139533463 17592186045585 true] [17592186389290 1071 "Find the first four non-zero terms of the Maclaurin expansion of $\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x).$" 13194139533463 17592186045585 true] [17592186389290 1072 #uuid "a566bf55-85d0-5a70-9fbb-f45650b09aa0" 13194139533463 17592186045585 true] [17592186389290 1074 "The Maclaurin expansion of $\\operatorname{sin}⁡(x)$ is\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x) & =x-\\frac{{x}^{3}}{3!}+\\frac{{x}^{5}}{5!}-⋯.\\end{aligned}\n$$\n\nReplacing $x$ with $2x$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x) & =(2x)-\\frac{(2x)^{3}}{3!}+\\frac{(2x)^{5}}{5!}-⋯ \\\\  & =2x-\\frac{{2}^{3}{x}^{3}}{6}+\\frac{{2}^{5}{x}^{5}}{120}-⋯ \\\\  & =2x-\\frac{4{x}^{3}}{3}+\\frac{4{x}^{5}}{15}-⋯.\\end{aligned}\n$$\n\nThe Maclaurin expansion of $\\operatorname{cos}⁡x$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =1-\\frac{{x}^{2}}{2!}+\\frac{{x}^{4}}{4!}-⋯.\\end{aligned}\n$$\n\nAdding the expansions for $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(x),$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x) & =(2x-\\frac{4{x}^{3}}{3}+\\frac{4{x}^{5}}{15}-⋯)+(1-\\frac{{x}^{2}}{2!}+\\frac{{x}^{4}}{4!}-⋯) \\\\  & =1+2x-\\frac{{x}^{2}}{2}-\\frac{4{x}^{3}}{3}+⋯.\\end{aligned}\n$$" 13194139533463 17592186045585 true] [17592186389291 1075 #edb/ref 17592186389292 13194139533463 17592186045585 true] [17592186389291 1075 #edb/ref 17592186389293 13194139533463 17592186045585 true] [17592186389291 1075 #edb/ref 17592186389294 13194139533463 17592186045585 true] [17592186389291 1075 #edb/ref 17592186389295 13194139533463 17592186045585 true] [17592186389291 1075 #edb/ref 17592186389296 13194139533463 17592186045585 true] [17592186389291 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389291 1077 "selection" 13194139533463 17592186045585 true] [17592186389291 1079 #edb/ref 17592186389296 13194139533463 17592186045585 true] [17592186389291 1080 #uuid "9eadffca-ae05-5f18-bf56-b5c8a1797f1e" 13194139533463 17592186045585 true] [17592186389292 1081 "\\operatorname{sin}⁡(2x)+\\operatorname{cos}⁡(x)=1+2x-2{x}^{2}-\\frac{4{x}^{3}}{3}+⋯" 13194139533463 17592186045585 true] [17592186389292 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186389292 1084 #uuid "124f214f-d111-5270-8f5a-99d12cd7c085" 