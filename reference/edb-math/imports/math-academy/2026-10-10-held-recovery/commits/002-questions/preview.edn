5585 true] [17592186390588 1084 #uuid "ea956b89-f42b-52b5-a970-4a7cbdfbbbcd" 13194139533463 17592186045585 true] [17592186390589 1081 "18\\,000" 13194139533463 17592186045585 true] [17592186390589 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186390589 1084 #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" 13194139533463 17592186045585 true] [17592186390590 1081 "12\\,000" 13194139533463 17592186045585 true] [17592186390590 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186390590 1084 #uuid "ea082471-0a98-54a0-9c3f-4a9fcbd75fcd" 13194139533463 17592186045585 true] [17592186390591 1068 #edb/ref 17592186390592 13194139533463 17592186045585 true] [17592186390591 1069 "q-29182" 13194139533463 17592186045585 true] [17592186390591 1070 #edb/ref 17592186045487 13194139533463 17592186045585 true] [17592186390591 1071 "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" 13194139533463 17592186045585 true] [17592186390591 1072 #uuid "23dbd8da-da31-5df7-bb91-fad8d1a7bceb" 13194139533463 17592186045585 true] [17592186390591 1074 "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})={30}^{∘}\n$$\n\nNote that $x={30}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={30}^{∘}-{360}^{∘}=-{330}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/8c/8c6e3ae6bdbfb1c66aee719f77225453992fffe6f3c6e3dfdc3f1ff92c59863a.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{30}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nNote that $X={330}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required dommain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{2} & ={330}^{∘}-{360}^{∘}=-{30}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{30}^{∘},-{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-30\\cdot (-330)=9\\,900\n$$" 13194139533463 17592186045585 true] [17592186390592 1075 #edb/ref 17592186390593 13194139533463 17592186045585 true] [17592186390592 1075 #edb/ref 17592186390594 13194139533463 17592186045585 true] [17592186390592 1075 #edb/ref 17592186390595 13194139533463 17592186045585 true] [17592186390592 1075 #edb/ref 17592186390596 13194139533463 17592186045585 true] [17592186390592 1075 #edb/ref 17592186390597 13194139533463 17592186045585 true] [17592186390592 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186390592 1077 "selection" 13194139533463 17592186045585 true] [17592186390592 1079 #edb/ref 17592186390595 13194139533463 17592186045585 true] [17592186390592 1080 #uuid "c557a89c-b4c6-5e67-988d-6c588aefa937" 13194139533463 17592186045585 true] [17592186390593 1081 "7\\,600" 13194139533463 17592186045585 true] [17592186390593 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186390593 1084 #uuid "b21c9bca-5889-5378-95f5-dc19174253a3" 13194139533463 17592186045585 true] [17592186390594 1081 "14\\,175" 13194139533463 17592186045585 true] [17592186390594 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186390594 1084 #uuid "5637088d-2110-5861-a9e4-5418d97814d6" 13194139533463 17592186045585 true] [17592186390595 1081 "9\\,900" 13194139533463 17592186