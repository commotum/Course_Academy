v}\\end{aligned}| \\\\  & =|\\begin{aligned}2u & -1 \\\\ v & u\\end{aligned}| \\\\  & =2u\\cdot u-v\\cdot (-1) \\\\  & =2{u}^{2}+v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2{u}^{2}+v & >0 \\\\ v & >-2{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=-2{u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](images/8b/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png)" 13194139533463 17592186045585 true] [17592186389195 1075 #edb/ref 17592186389196 13194139533463 17592186045585 true] [17592186389195 1075 #edb/ref 17592186389197 13194139533463 17592186045585 true] [17592186389195 1075 #edb/ref 17592186389198 13194139533463 17592186045585 true] [17592186389195 1075 #edb/ref 17592186389199 13194139533463 17592186045585 true] [17592186389195 1075 #edb/ref 17592186389200 13194139533463 17592186045585 true] [17592186389195 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389195 1077 "selection" 13194139533463 17592186045585 true] [17592186389195 1079 #edb/ref 17592186389197 13194139533463 17592186045585 true] [17592186389195 1080 #uuid "2bd81eba-4d1a-5e26-b6d5-47144737edcc" 13194139533463 17592186045585 true] [17592186389196 1081 "images/d4/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" 13194139533463 17592186045585 true] [17592186389196 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389196 1084 #uuid "773f7224-683a-5657-93fd-0b49bba9ddc6" 13194139533463 17592186045585 true] [17592186389197 1081 "images/8b/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png" 13194139533463 17592186045585 true] [17592186389197 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389197 1084 #uuid "3223453f-3db3-5cf7-9170-