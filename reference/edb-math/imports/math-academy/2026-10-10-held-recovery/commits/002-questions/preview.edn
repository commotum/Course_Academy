e to the bases $B$ and $C:$\n\n$$\n[T]_{B|C}=[\\begin{aligned}-4 & -8 \\\\ 3 & 6\\end{aligned}]\n$$" 13194139533463 17592186045585 true] [17592186388695 1075 #edb/ref 17592186388696 13194139533463 17592186045585 true] [17592186388695 1075 #edb/ref 17592186388697 13194139533463 17592186045585 true] [17592186388695 1075 #edb/ref 17592186388698 13194139533463 17592186045585 true] [17592186388695 1075 #edb/ref 17592186388699 13194139533463 17592186045585 true] [17592186388695 1075 #edb/ref 17592186388700 13194139533463 17592186045585 true] [17592186388695 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186388695 1077 "selection" 13194139533463 17592186045585 true] [17592186388695 1079 #edb/ref 17592186388698 13194139533463 17592186045585 true] [17592186388695 1080 #uuid "6d8dbb4a-8123-5815-85e7-0b6642b71201" 13194139533463 17592186045585 true] [17592186388696 1081 "[\\begin{aligned}6 & -8 \\\\ 3 & -4\\end{aligned}]" 13194139533463 17592186045585 true] [17592186388696 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186388696 1084 #uuid "088d91a0-3eaf-51f2-8ffe-b7c678ccdbc9" 13194139533463 17592186045585 true] [17592186388697 1081 "[\\begin{aligned}-2 & -8 \\\\ 6 & 3\\end{aligned}]" 13194139533463 17592186045585 true] [17592186388697 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186388697 1084 #uuid "a023134e-086b-501d-b434-5e8d31a4adbf" 13194139533463 17592186045585 true] [17592186388698 1081 "[\\begin{aligned}-4 & -8 \\\\ 3 & 6\\end{aligned}]" 13194139533463 17592186045585 true] [17592186388698 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186388698 1084 #uuid "ab0e6d22-1976-5811-872d-d23e457baf1b" 13194139533463 17592186045585 true] [17592186388699 1081 "[\\begin{aligned}2 & -8 \\\\ 3 & -6\\end{aligned}]" 13194139533463 17592186045585 true] [17592186388699 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186388699 1084 #uuid "ad10460a-fb61-5b63-8b5e-277