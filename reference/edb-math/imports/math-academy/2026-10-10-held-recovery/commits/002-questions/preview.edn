46de25e1d.png" 13194139533463 17592186045585 true] [17592186389896 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389896 1084 #uuid "eaa5394f-664d-516c-a7ca-0034c1aac434" 13194139533463 17592186045585 true] [17592186389897 1081 "images/89/89ac9e71d8152097657f0c01daecf2b894dc142db4ba27fbfadcb8ded6e9cb19.png" 13194139533463 17592186045585 true] [17592186389897 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389897 1084 #uuid "cc7583ed-df6d-5be7-bfdd-4f5596ff6fe8" 13194139533463 17592186045585 true] [17592186389898 1081 "images/b8/b8a268a69a978e7f9a14afd83c7c14735d797d4359826ae86f84873e53635363.png" 13194139533463 17592186045585 true] [17592186389898 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389898 1084 #uuid "eb3bbeb0-b786-56a0-af4c-ce843e2f2a0d" 13194139533463 17592186045585 true] [17592186389899 1081 "images/ac/acccce074e5dee93bbca149c16c5f7794dce17d1cd16432d25b0132382d877f8.png" 13194139533463 17592186045585 true] [17592186389899 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389899 1084 #uuid "df54159c-0862-5afe-bf76-a3155b444d65" 13194139533463 17592186045585 true] [17592186389900 1081 "images/0a/0a03f883f977e67b9299d52e1572e484ed6010dc4f2555c7cbc2048f193dbc7f.png" 13194139533463 17592186045585 true] [17592186389900 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389900 1084 #uuid "a8c9bb19-93d6-5bb3-b166-5ed944544ba3" 13194139533463 17592186045585 true] [17592186389901 1068 #edb/ref 17592186389902 13194139533463 17592186045585 true] [17592186389901 1069 "q-181306" 13194139533463 17592186045585 true] [17592186389901 1070 #edb/ref 17592186045487 13194139533463 17592186045585 true] [17592186389901 1071 "Which of the following is a representation of the set $S=[-1,1]\\times {-1,1}$ in the Cartesian plane?" 13194139533463 17592186045585 true] [17592186389901 1072 #uuid "734eb671-4f30-5ac2-952a-94e297467ed9" 13194139533463 17592186045585 true] [17592186389901 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS=[-1,1]\\times {-1,1}\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate is either $-1$ or $1.$\n\n$$\nS={(x,y)\\,:\\,x\\in [-1,1],\\,y\\in {-1,1}}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate equals $-1$\n\n$$\n{S}_{1}={(x,-1)\\,:\\,x\\in [-1,1]}\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/3e/3ed05ffc58aad1a6c75e7862c1175f497fb14870e6650cc6c4ce01c3df091d8b.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate is any real number in the interval $[-1,1]$ and whose $y$-coordinate equals $1$\n\n$$\n{S}_{2}={(x,1)\\,:\\,x\\in [-1,1]}.\n$$\n\nThis set is represented by the line segment shown below.\n\n![](images/0f/0f57920b2532177b0d64ac3dc95feb6a476bb385112d736d702895862e7de2b2.png)\n\nOur Cartesian product is the *union* of these subsets:\n\n$$\nS={S}_{1}\\cup {S}_{2}\n$$\n\nTherefore, $S$ can be represented by the two line segments shown below.\n\n![](images/07/075454dae9ed36967a70537cdf3a3f59931cdd81671ff4059658d2e0df438898.png)" 13194139533463 17592186045585 true] [17592186389902 1075 #edb/ref 17592186389903 13194139533463 17592186045585 true] [17592186389902 1075 #edb/ref 17592186389904 13194139533463 17592186045585 true] [17592186389902 1075 #edb/ref 17592186389905 13194139533463 17592186045585 true] [17592186389902 1075 #edb/ref 17592186389906 13194139533463 17592186045585 true] [17592186389902 1075 #edb/ref 17592186389907 13194139533463 17592186045585 true] [17592186389902 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389902 1077 "selection" 13194139533463 17592186045585 true] [17592186389902 1079 #edb/ref 17592186389906 13194139533463 17592186045585 true] [17592186389902 1080 #uuid "9f377c8c-6598-5676-856c-726dc4aca072" 13194139533463 17592186045585 true] [17592186389903 1081 "images/82/82f9ecf98b8b2b4e5f75b3130e8483354c93922dc3a942e271562ac1ad17438e.png" 13194139533463 17592186045585 true] [17592186389903 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389903 1084 #uuid "63212b76-4dd2-5413-b5ba-4e9195ab76e3" 13194139533463 17592186045585 true] [17592186389904 1081 "images/e0/e0fa3e717af02a353db77ae8b357dc338c975166fb5fbe6c5c1309d1c1f511f2.png" 13194139533463 17592186045585 true] [17592186389904 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389904 1084 #uuid "4a858bfb-ee22-5b56-9050-fa66d28f0274" 13194139533463 17592186045585 true] [17592186389905 1081 "images/c2/c28ba6b0da8364f4e7f157b58827384f9e138a2c0fc53558ce7ab2df2f646747.png" 13194139533463 17592186045585 true] [17592186389905 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389905 1084 #uuid "7442f1d4-b621-53b9-a885-39076816c0b2" 13194139533463 17592186045585 true] [17592186389906 1081 "images/07/075454dae9ed36967a70537cdf3a3f59931cdd81671ff4059658d2e0df438898.png" 13194139533463 17592186045585 true] [17592186389906 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389906 1084 #uuid "281cc561-5401-5252-9068-734db096e5bd" 13194139533463 17592186045585 true] [17592186389907 1081 "images/29/2922ff5e3a32e01fbc292898c88c1d8eca8d933897d4b9d3c1694b6f5cbeb2a2.png" 13194139533463 17592186045585 true] [17592186389907 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389907 1084 #uuid "b42501d9-b115-5c79-8921-c1756b26a1c9" 13194139533463 17592186045585 true] [17592186389908 1068 #edb/ref 17592186389909 13194139533463 17592186045585 true] [17592186389908 1069 "q-181958" 13194139533463 17592186045585 true] [17592186389908 1070 #edb/ref 17592186045485 13194139533463 17592186045585 true] [17592186389908 1071 "Which of the following is a schematic of the Cartesian product $A\\times B$ for $A={p,q}$ and $B={w,z}?$" 13194139533463 17592186045585 true] [17592186389908 1072 #uuid "393bef1a-778c-53b8-a73e-75ffc95e3405" 13194139533463 17592186045585 true] [17592186389908 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo create a schematic of the Cartesian product, we create a table and list the elements of the first set $A$ in a row across the top and the elements of the second set $B$ in a column down the left side.\n\n![](images/6b/6baae52e45d00d31eac732a23be655b648765c27cfcdc667c511b176d5bbbc88.png)\n\nThen, at each intersection, we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B.$\n\nOur completed $A\\times B$ schematic is shown below.\n\n![](images/38/38e9d12b0c09ae066149d95235a6918712214edc147c57775da2d880b584cb9e.png)" 13194139533463 17592186045585 true] [17592186389909 1075 #edb/ref 17592186389910 13194139533463 17592186045585 true] [17592186389909 1075 #edb/ref 17592186389911 13194139533463 17592186045585 true] [17592186389909 1075 #edb/ref 17592186389912 13194139533463 17592186045585 true] [17592186389909 1075 #edb/ref 17592186389913 13194139533463 17592186045585 true] [17592186389909 1075 #edb/ref 17592186389914 13194139533463 17592186045585 true] [17592186389909 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389909 1077 "selection" 13194139533463 17592186045585 true] [17592186389909 1079 #edb/ref 17592186389912 13194139533463 17592186045585 true] [17592186389909 1080 #uuid "202c18dc-b67f-5564-b56a-fe0084384a70" 13194139533463 17592186045585 true] [17592186389910 1081 "images/6c/6cceec57dbf53e768fc290d864fa770c70a6642bdc9df1309119e113241b0f34.png" 13194139533463 17592186045585 true] [17592186389910 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389910 1084 #uuid "bc1e2521-377a-583c-ae3c-a594986136a1" 13194139533463 17592186045585 true] [17592186389911 1081 "images/a5/a52e05a3884e5d62ffaacc73104a4f2e61fb8013fb353c850cdb974e66224a40.png" 13194139533463 17592186045585 true] [17592186389911 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389911 1084 #uuid "6100ffa9-8836-588a-ad6d-756450d570c1" 13194139533463 17592186045585 true] [17592186389912 1081 "images/51/518415814ddb5483e4649c95e58aa41adc68ad8722279dbf99ac4c10bca206e9.png" 13194139533463 17592186045585 true] [17592186389912 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389912 1084 #uuid "1d1f178a-1f6f-5167-8e63-1743c6413ab4" 13194139533463 17592186045585 true] [17592186389913 1081 "images/b7/b7497f60cccce44a008c6550f356d32564c2a15e23d88f9c3764415598dc493b.png" 13194139533463 17592186045585 true] [17592186389913 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389913 1084 #uuid "d789365b-3b14-591a-b824-5e4aa2089860" 13194139533463 17592186045585 true] [17592186389914 1081 "images/d3/d366ec9f363cf38d84c6d741491f7e218e0bedad335f6fc1f1f954f95516f196.png" 13194139533463 17592186045585 true] [17592186389914 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186389914 1084 #uuid "9b455fb2-a223-572c-adf0-f70bc35f621e" 13194139533463 17592186045585 true] [17592186389915 1068 #edb/ref 17592186389916 13194139533463 17592186045585 true] [17592186389915 1069 "q-181959" 13194139533463 17592186045585 true] [17592186389915 1070 #edb/ref 17592186045485 13194139533463 17592186045585 true] [17592186389915 1071 "Which of the following is a representation of the set $S=N\\times Z$ in the Cartesian plane?" 13194139533463 17592186045585 true] [17592186389915 1072 #uuid "9854e016-8489-5582-ad5c-ffa3a5b6e5ec" 13194139533463 17592186045585 true] [17592186389915 1074 "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B={(a,b)\\,:\\,a\\in A,\\,b\\in B}\n$$\n\nIn this case, the set \n\n$$\nS=N\\times Z\n$$\n\ncontains every point in ${R}^{2}$ whose $x$-coordinate is a natural number and whose $y$-coordinate is an integer number.\n\n$$\nS={(x,y)\\,:\\,x\\in N,\\,y\\in Z}.\n$$\n\nTo visualize $S$, consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate equals $1$ and whose $y$-coordinate is any integer number.\n\n$$\n{S}_{1}={(1,y)\\,:\\,y\\in Z}.\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/17/179fdaa3921cb29f2d25ff97bce262fd13fb2ff591c12e97a33953e95967f6fc.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate equals $2$ and whose $y$-coordinate is any natural number.\n\n$$\n{S}_{2}={(2,y)\\,:\\,y\\in Z}.\n$$\n\nWe can represent ${S}_{2}$ in the plane as follows:\n\n![](images/73/7399e42988df8a809013393d8873b6a6e5f60b64c0419eadd7bb3c334eb410d6.png)\n\nWe can create the subsets ${S}_{3},{S}_{4},{S}_{5},…$ similarly. Our Cartesian product $S$ is the *union* of these subsets:\n\n$$\n\\begin{aligned}S & ={S}_{1}\\cup {S}_{2}\\cup {S}_{3}\\cup … \\\\  & ={⋃}_{i\\in N}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $N\\times Z$ as the set of points in the diagram below.\n\n![](images/16/16ff13c793d3c3f57eefee638fbc1ff83569ef6d084d9d053f8585f72c8812d7.png)" 13194139533463 17592186045585 true] [17592186389916 1075 #edb/ref 17592186389917 13194139533463 17592186045585 true] [17592186389916 1075 #edb/ref 17592186389918 13194139533463 17592186045585 true] [17592186389916 1075 #edb/ref 17592186389919 13194139533463 17592186045585 true] [17592186389916 1075 #edb/ref 17592186389920 13194139533463 17592186045585 true] [17592186389916 1075 #edb/ref 17592186389921 13194139533463 17592186045585 true] [17592186389916 1076 #edb/ref 17592186045493 13194139533463 17