 system, we obtain the tangent vector to the trajectory.\n\n$$\n\\begin{aligned}{x}^{′}(\\operatorname{ln}⁡3) & =[\\begin{aligned}-2 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}\\frac{1}{3} \\\\ 6\\end{aligned}] \\\\  & =[\\begin{aligned}-2(\\frac{1}{3})+0(6) \\\\ 0(\\frac{1}{3})+1(6)\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{2}{3} \\\\ 6\\end{aligned}]\\end{aligned}\n$$" 13194139533463 17592186045585 true] [17592186390999 1075 #edb/ref 17592186391000 13194139533463 17592186045585 true] [17592186390999 1075 #edb/ref 17592186391001 13194139533463 17592186045585 true] [17592186390999 1075 #edb/ref 17592186391002 13194139533463 17592186045585 true] [17592186390999 1075 #edb/ref 17592186391003 13194139533463 17592186045585 true] [17592186390999 1075 #edb/ref 17592186391004 13194139533463 17592186045585 true] [17592186390999 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186390999 1077 "selection" 13194139533463 17592186045585 true] [17592186390999 1079 #edb/ref 17592186391001 13194139533463 17592186045585 true] [17592186390999 1080 #uuid "491749e3-5dfc-5a6a-8c20-a36eb891b6a0" 13194139533463 17592186045585 true] [17592186391000 1081 "[\\begin{aligned}-\\frac{2}{3} \\\\ -6\\end{aligned}]" 13194139533463 17592186045585 true] [17592186391000 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186391000 1084 #uuid "9c1207d6-660a-5878-9696-b2a6f678e57f" 13194139533463 17592186045585 true] [17592186391001 1081 "[\\begin{aligned}-\\frac{2}{3} \\\\ 6\\end{aligned}]" 13194139533463 17592186045585 true] [17592186391001 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186391001 1084 #uuid "c326cefc-3d33-51f6-b6f0-7a69d00ee5f6" 13194139533463 17592186045585 true] [17592186391002 1081 "[\\begin{aligned}6 \\\\ -\\frac{2}{3}\\end{aligned}]" 13194139533463 17592186045585 true] [17592186391002 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186391002 1084 #uuid "bb18a87c-c989-5a99-a62f-c5acf7