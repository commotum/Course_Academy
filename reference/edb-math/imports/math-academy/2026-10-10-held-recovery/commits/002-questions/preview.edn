d29498aa4d3b0269d79ebd237fd9ed2a713b70b6a.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(x{y}^{2})={y}^{2}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(x{y}^{2})=2xy,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{({y}^{2})}^{2}+(2xy)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{y}^{4}+4{x}^{2}{y}^{2}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}\\sqrt{1+{y}^{4}+4{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" 13194139533463 17592186045585 true] [17592186389167 1075 #edb/ref 17592186389168 13194139533463 17592186045585 true] [17592186389167 1075 #edb/ref 17592186389169 13194139533463 17592186045585 true] [17592186389167 1075 #edb/ref 17592186389170 13194139533463 17592186045585 true] [17592186389167 1075 #edb/ref 17592186389171 13194139533463 17592186045585 true] [17592186389167 1075 #edb/ref 17592186389172 13194139533463 17592186045585 true] [17592186389167 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389167 1077 "selection" 13194139533463 17592186045585 true] [17592186389167 1079 #edb/ref 17592186389170 13194139533463 17592186045585 true] [17592186389167 1080 #uuid "43daddd4-5f4f-51e5-ba06-33b9f5b182c4" 13194139533463 17592186045585 true] [17592186389168 1081 "{\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}\\sqrt{1+2{y}^{4}+2{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x" 13194139533463 17592186045585 true] [17592186389168 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186389168 1084 #uuid "86459122-4bdd-512e-9e34-298272859e5f" 13194139533463 17592186045585 true] [17592186389169 1081 "{\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}\\sqrt{1+y+xy}\\,\\text{d}y\\,\\text{d}x" 13194139533463 17592186045585 true] [17592186389169 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186389169 1084 #uuid "20db1bb1-9d9a-5010-b5a7