ned}]{e}^{2t} \\\\  & =[\\begin{aligned}2 \\\\ 10\\end{aligned}]{e}^{-t}+[\\begin{aligned}2 \\\\ -2\\end{aligned}]{e}^{2t}.\\end{aligned}\n$$" 13194139533463 17592186045585 true] [17592186389615 1075 #edb/ref 17592186389616 13194139533463 17592186045585 true] [17592186389615 1075 #edb/ref 17592186389617 13194139533463 17592186045585 true] [17592186389615 1075 #edb/ref 17592186389618 13194139533463 17592186045585 true] [17592186389615 1075 #edb/ref 17592186389619 13194139533463 17592186045585 true] [17592186389615 1075 #edb/ref 17592186389620 13194139533463 17592186045585 true] [17592186389615 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389615 1077 "selection" 13194139533463 17592186045585 true] [17592186389615 1079 #edb/ref 17592186389618 13194139533463 17592186045585 true] [17592186389615 1080 #uuid "36a4ed42-4ec3-5cae-83cc-1a4e796d7a8d" 13194139533463 17592186045585 true] [17592186389616 1081 "x(t)=[\\begin{aligned}1 \\\\ 8\\end{aligned}]{e}^{-t}+[\\begin{aligned}3 \\\\ 0\\end{aligned}]{e}^{2t}" 13194139533463 17592186045585 true] [17592186389616 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186389616 1084 #uuid "031fcf4c-44d6-5f96-acb1-353d67b1fad7" 13194139533463 17592186045585 true] [17592186389617 1081 "x(t)=[\\begin{aligned}1 \\\\ 5\\end{aligned}]{e}^{-t}+[\\begin{aligned}3 \\\\ 3\\end{aligned}]{e}^{2t}" 13194139533463 17592186045585 true] [17592186389617 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186389617 1084 #uuid "8a74ffc8-d62f-510a-82cc-c909e16d7fcc" 13194139533463 17592186045585 true] [17592186389618 1081 "x(t)=[\\begin{aligned}2 \\\\ 10\\end{aligned}]{e}^{-t}+[\\begin{aligned}2 \\\\ -2\\end{aligned}]{e}^{2t}" 13194139533463 17592186045585 true] [17592186389618 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186389618 1084 #uuid "8513d342-7c71-558c-bb5b-2d0b8669c8c0" 13194139533463 17592186045585 true] [17592186389619 1081 "x(t)=[\\begin{aligned}6 