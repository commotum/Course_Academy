ue] [17592186390194 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186390194 1084 #uuid "f7ea8b0a-b2c5-5604-a428-f7cfe010e169" 13194139533463 17592186045585 true] [17592186390195 1081 "images/4a/4a76d61d342fcf1503f00970b29da3d30c309f9f47b2276f3fe4d80a777cb85d.png" 13194139533463 17592186045585 true] [17592186390195 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186390195 1084 #uuid "97a12ce2-ec25-58ab-a8f4-d779170d2481" 13194139533463 17592186045585 true] [17592186390196 1081 "images/78/787284a02a119aa2a2135623ad6e50ad6e82295917866d0f137ed26a14a160aa.png" 13194139533463 17592186045585 true] [17592186390196 1083 #edb/ref 17592186045498 13194139533463 17592186045585 true] [17592186390196 1084 #uuid "be266f09-d528-52fe-8dd4-049ebe7981eb" 13194139533463 17592186045585 true] [17592186390197 1068 #edb/ref 17592186390198 13194139533463 17592186045585 true] [17592186390197 1069 "q-183562" 13194139533463 17592186045585 true] [17592186390197 1070 #edb/ref 17592186045486 13194139533463 17592186045585 true] [17592186390197 1071 "The natural powers of $4$ are multiples of $2.$\n\nExpress the above in formal language." 13194139533463 17592186045585 true] [17592186390197 1072 #uuid "34f3f1ac-e55b-57c1-91eb-bd13e42f862d" 13194139533463 17592186045585 true] [17592186390197 1074 "Notice that our sentence can be re-phrased as \n\nFor any natural number $m,$ we have that ${4}^{m}$ is a multiple of $2.$\n\nNow, \"${4}^{m}$ is a multiple of $2$\" means that\n\nThere exists an integer number $k$ such that ${4}^{m}=2k.$\n\nTherefore, we get the following statement:\n\nFor any natural number $m,$ there exists an integer number $k$ such that ${4}^{m}=2k.$\n\nMore formally, this reads as\n\n$∀\\,m\\in N,\\,∃\\,k\\in Z,\\,{4}^{m}=2k.$" 13194139533463 17592186045585 true] [17592186390198 1075 #edb/ref 17592186390199 13194139533463 17592186045585 true] [17592186390198 1075 #edb/ref 17592186390200 13194139533463 17592186045585 true] [17592186390198 