 0 & 0 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 1 & 1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 0 & 0 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 4 & 4 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}1 & 1 & 3 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ [\\begin{aligned}14 & 9 \\\\ 9 & 9\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & =[\\begin{aligned}5 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nFinally, since the matrix on the left-hand side is invertible, we obtain\n\n$$\n\\begin{aligned}[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}] & ={[\\begin{aligned}14 & 9 \\\\ 9 & 9\\end{aligned}]}^{-1}[\\begin{aligned}5 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{14\\cdot 9-9\\cdot 9}[\\begin{aligned}9 & -9 \\\\ -9 & 14\\end{aligned}][\\begin{aligned}5 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{45}[\\begin{aligned}45 \\\\ -45\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" 13194139533463 17592186045585 true] [17592186389016 1075 #edb/ref 17592186389017 13194139533463 17592186045585 true] [17592186389016 1075 #edb/ref 17592186389018 13194139533463 17592186045585 true] [17592186389016 1075 #edb/ref 17592186389019 13194139533463 17592186045585 true] [17592186389016 1075 #edb/ref 17592186389020 13194139533463 17592186045585 true] [17592186389016 1075 #edb/ref 17592186389021 13194139533463 17592186045585 true] [17592186389016 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186389016 1077 "selection" 13194139533463 17592186045585 true] [17592186389016 1079 #edb/ref 17592186389019 13194139533463 17592186045585 true] [17592186389016 1080 #uuid "68cf1131-7e03