}\\,A)^{-1}{A}^{T}b \\\\  & ={([\\begin{aligned}1 & 1 & 1 & 1 \\\\ -1 & 0 & 3 & -2 \\\\ -2 & 1 & 0 & 1\\end{aligned}][\\begin{aligned}1 & -1 & -2 \\\\ 1 & 0 & 1 \\\\ 1 & 3 & 0 \\\\ 1 & -2 & 1\\end{aligned}])}^{-1}\\,\\,[\\begin{aligned}1 & 1 & 1 & 1 \\\\ -1 & 0 & 3 & -2 \\\\ -2 & 1 & 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 7 \\\\ -4\\end{aligned}] \\\\  & ={[\\begin{aligned}4 & 0 & 0 \\\\ 0 & 14 & 0 \\\\ 0 & 0 & 6\\end{aligned}]}^{-1}[\\begin{aligned}4 \\\\ 28 \\\\ -6\\end{aligned}] \\\\  & =\\frac{1}{84}[\\begin{aligned}21 & 0 & 0 \\\\ 0 & 6 & 0 \\\\ 0 & 0 & 14\\end{aligned}][\\begin{aligned}4 \\\\ 28 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$" 13194139533463 17592186045585 true] [17592186388806 1075 #edb/ref 17592186388807 13194139533463 17592186045585 true] [17592186388806 1075 #edb/ref 17592186388808 13194139533463 17592186045585 true] [17592186388806 1075 #edb/ref 17592186388809 13194139533463 17592186045585 true] [17592186388806 1075 #edb/ref 17592186388810 13194139533463 17592186045585 true] [17592186388806 1075 #edb/ref 17592186388811 13194139533463 17592186045585 true] [17592186388806 1076 #edb/ref 17592186045493 13194139533463 17592186045585 true] [17592186388806 1077 "selection" 13194139533463 17592186045585 true] [17592186388806 1079 #edb/ref 17592186388808 13194139533463 17592186045585 true] [17592186388806 1080 #uuid "b6b5b70a-3bed-57f5-b549-2c7675473fbd" 13194139533463 17592186045585 true] [17592186388807 1081 "[\\begin{aligned}0 \\\\ 1 \\\\ 4\\end{aligned}]" 13194139533463 17592186045585 true] [17592186388807 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186388807 1084 #uuid "97a0e9a5-b999-5a3a-b3b4-0dbb1edcf165" 13194139533463 17592186045585 true] [17592186388808 1081 "[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}]" 13194139533463 17592186045585 true] [17592186388808 1083 #edb/ref 17592186045499 13194139533463 17592186045585 true] [17592186388808 1084 #uui