86391752 13194139533464 17592186045585 true] [17592186391748 1075 #edb/ref 17592186391753 13194139533464 17592186045585 true] [17592186391748 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186391748 1077 "selection" 13194139533464 17592186045585 true] [17592186391748 1079 #edb/ref 17592186391750 13194139533464 17592186045585 true] [17592186391748 1080 #uuid "5f0ed6f5-6be8-59e5-9f66-3f6c05ef700b" 13194139533464 17592186045585 true] [17592186391749 1081 "(r-⟨0,0,1⟩)\\cdot ⟨-1,-1,16⟩=0" 13194139533464 17592186045585 true] [17592186391749 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391749 1084 #uuid "7132a908-b9cb-56e3-80b1-38fb5d14b3a5" 13194139533464 17592186045585 true] [17592186391750 1081 "(r-⟨0,0,-4⟩)\\cdot ⟨1,-1,4⟩=0" 13194139533464 17592186045585 true] [17592186391750 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391750 1084 #uuid "02494726-37b0-5e7b-ad3c-0180bececdfc" 13194139533464 17592186045585 true] [17592186391751 1081 "(r-⟨0,0,-1⟩)\\cdot ⟨1,0,4⟩=0" 13194139533464 17592186045585 true] [17592186391751 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391751 1084 #uuid "a7ff3e24-bbb2-547d-9f0d-bbf347c313df" 13194139533464 17592186045585 true] [17592186391752 1081 "(r-⟨0,0,4⟩)\\cdot ⟨1,-1,4⟩=0" 13194139533464 17592186045585 true] [17592186391752 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391752 1084 #uuid "ef59ef21-d4e1-5b2a-82ab-a424aa93aa72" 13194139533464 17592186045585 true] [17592186391753 1081 "(r-⟨0,0,1⟩)\\cdot ⟨1,-1,4⟩=0" 13194139533464 17592186045585 true] [17592186391753 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391753 1084 #uuid "875a9589-3b53-5b62-afd7-0ad0dc57bbe2" 13194139533464 17592186045585 true] [17592186391754 1068 #edb/ref 17592186391755 13194139533464 17592186045585 true] [17592186391754 1069 "q-339368" 13194139533464 17592186045585 true] [17592186391754 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186391754 1071 "If the following system of differential equations is written in the form ${x}^{′}(t)=Ax(t),$ then what is the matrix $A?$\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)+7{x}_{1}(t)+2{x}_{2}(t)=0 \\\\ {x}_{2}^{′}(t)+4{x}_{1}(t)-8{x}_{2}(t)=0\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186391754 1072 #uuid "55e611bb-e159-5679-8a20-82ebbfb84458" 13194139533464 17592186045585 true] [17592186391754 1074 "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- ${x}_{1}(t)$ and ${x}_{2}(t)$ are unknown functions (dependent variables).\n\nSuch a system can always be written in the form\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nwhere\n\n$$\nx(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\\,A=[\\begin{aligned}a(t) & b(t) \\\\ c(t) & d(t)\\end{aligned}],\\,f(t)=[\\begin{aligned}f(t) \\\\ g(t)\\end{aligned}].\n$$\n\nWe have the following system.\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)+7{x}_{1}(t)+2{x}_{2}(t)=0 \\\\ {x}_{2}^{′}(t)+4{x}_{1}(t)-8{x}_{2}(t)=0\\end{aligned}\n$$\n\nWriting our system in standard form, we get the following:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-7{x}_{1}(t)-2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-4{x}_{1}(t)+8{x}_{2}(t).\\end{aligned}\n$$\n\nSo, we can rewrite our system in matrix form as follows:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-7 & -2 \\\\ -4 & 8\\end{aligned}]x(t)\n$$\n\nTherefore, we have\n\n$$\nA=[\\begin{aligned}-7 & -2 \\\\ -4 & 8\\end{aligned}].\n$$" 13194139533464 17592186045585 true] [17592186391755 1075 #edb/ref 17592186391756 13194139533464 17592186045585 true] [17592186391755 1075 #edb/ref 17592186391757 13194139533464 17592186045585 true] [17592186391755 1075 #edb/ref 17592186391758 13194139533464 17592186045585 true] [17592186391755 1075 #edb/ref 17592186391759 13194139533464 17592186045585 true] [17592186391755 1075 #edb/ref 17592186391760 13194139533464 17592186045585 true] [17592186391755 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186391755 1077 "selection" 13194139533464 17592186045585 true] [17592186391755 1079 #edb/ref 17592186391759 13194139533464 17592186045585 true] [17592186391755 1080 #uuid "4ff9e82e-407b-5703-8567-eba193135c21" 13194139533464 17592186045585 true] [17592186391756 1081 "A=[\\begin{aligned}8 & -2 \\\\ -4 & -7\\end{aligned}]" 13194139533464 17592186045585 true] [17592186391756 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391756 1084 #uuid "0835bce8-cf59-5379-9f90-423f30051fa0" 13194139533464 17592186045585 true] [17592186391757 1081 "A=[\\begin{aligned}-7 & -4 \\\\ -2 & 8\\end{aligned}]" 13194139533464 17592186045585 true] [17592186391757 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391757 1084 #uuid "ef3ac905-af6b-502c-8155-adc0cb0b600f" 13194139533464 17592186045585 true] [17592186391758 1081 "A=[\\begin{aligned}-2 & -7 \\\\ -4 & 8\\end{aligned}]" 13194139533464 17592186045585 true] [17592186391758 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391758 1084 #uuid "a58ec671-2cae-516a-aa76-7a23dc0a8a5d" 13194139533464 17592186045585 true] [17592186391759 1081 "A=[\\begin{aligned}-7 & -2 \\\\ -4 & 8\\end{aligned}]" 13194139533464 17592186045585 true] [17592186391759 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391759 1084 #uuid "98c7b93e-b65a-5f55-b235-d06a74563bf2" 13194139533464 17592186045585 true] [17592186391760 1081 "A=[\\begin{aligned}-7 & -2 \\\\ 8 & -4\\end{aligned}]" 13194139533464 17592186045585 true] [17592186391760 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391760 1084 #uuid "dc6b6f59-1519-59c8-89a5-c6439694e171" 13194139533464 17592186045585 true] [17592186391761 1068 #edb/ref 17592186391762 13194139533464 17592186045585 true] [17592186391761 1069 "q-340358" 13194139533464 17592186045585 true] [17592186391761 1070 #edb/ref 17592186045486 13194139533464 17592186045585 true] [17592186391761 1071 "A particular autonomous differential equation has the following properties:\n\n- $y=-3$ is a node\n\n- $y=1$ is a source\n\n- $y=4$ is a sink\n\nWhich of the following could be the slope field of the differential equation?" 13194139533464 17592186045585 true] [17592186391761 1072 #uuid "293e0208-526f-5eaf-bcc8-3bedd1343359" 13194139533464 17592186045585 true] [17592186391761 1074 "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $3$ equilibrium points, $y=-3,$ $y=1,$ and $y=4.$\n\n- We're given that $y=4$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=4$ and an upward-pointing arrow just below it.\n\n- We're given that $y=1$ is a source. We represent this on the phase line by drawing an upward-pointing arrow just above $y=1$ (already drawn by the above property) and a downward-pointing arrow just below it.\n\n- We're given that $y=-3$ is a node. This means that the arrows on either side of $y=-3$ point in the same direction. Since the arrow just above $y=-3$ points downward, the arrow just below it points downward too.\n\n![](images/e4/e428cf67a486e9eb17764727ab042bb44e07dfe4f13c125112fb56799d5aadea.png)\n\nOf the given options, the only slope field that corresponds with this phase line is the following:\n\n![](images/26/26f65c17a5b108cc0c739bbfa5d7971841bfe71dc8886fb801e2ca5b5d2a32ae.png)\n\nNote that:\n\n- The slope field is horizontal at $y=-3,$ $y=1,$ and $y=4.$\n\n- The slopes near $y=-3$ appear to diverge away from this line when we're looking below the line and appear to converge toward the line when we're looking above the line.\n\n- The slopes near $y=1$ appear to diverge away from this line.\n\n- The slopes near $y=4$ appear to converge toward this line." 13194139533464 17592186045585 true] [17592186391762 1075 #edb/ref 17592186391763 13194139533464 17592186045585 true] [17592186391762 1075 #edb/ref 17592186391764 13194139533464 17592186045585 true] [17592186391762 1075 #edb/ref 17592186391765 13194139533464 17592186045585 true] [17592186391762 1075 #edb/ref 17592186391766 13194139533464 17592186045585 true] [17592186391762 1075 #edb/ref 17592186391767 13194139533464 17592186045585 true] [17592186391762 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186391762 1077 "selection" 13194139533464 17592186045585 true] [17592186391762 1079 #edb/ref 17592186391766 13194139533464 17592186045585 true] [17592186391762 1080 #uuid "b113387d-78c1-5771-a337-db1596e8b663" 13194139533464 17592186045585 true] [17592186391763 1081 "images/92/9295a422a3f393012ebeb664e1b5867483b34e7f35260994364add19a1e99b48.png" 13194139533464 17592186045585 true] [17592186391763 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186391763 1084 #uuid "398b93a7-fe9b-53e5-a5b0-41feadd2a366" 13194139533464 17592186045585 true] [17592186391764 1081 "images/0b/0b8561b868005f359ec3a9d023ada261053fe04e8b3c970fc787a93faff91a5f.png" 13194139533464 17592186045585 true] [17592186391764 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186391764 1084 #uuid "52e7d237-73ac-56b2-9