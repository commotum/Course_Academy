ue] [17592186392814 1084 #uuid "fbadcc5d-ef99-5cdf-90c9-7093b52691c6" 13194139533464 17592186045585 true] [17592186392815 1081 "32\\,{\\text{ft}}^{2}" 13194139533464 17592186045585 true] [17592186392815 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392815 1084 #uuid "276a0529-d987-5db6-83be-2028c8e08e75" 13194139533464 17592186045585 true] [17592186392816 1081 "25\\,{\\text{ft}}^{2}" 13194139533464 17592186045585 true] [17592186392816 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392816 1084 #uuid "36fd2e7a-ea93-51ed-a558-c240ada5c964" 13194139533464 17592186045585 true] [17592186392817 1068 #edb/ref 17592186392818 13194139533464 17592186045585 true] [17592186392817 1069 "q-62069" 13194139533464 17592186045585 true] [17592186392817 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186392817 1071 "![](images/b9/b9668f2d9988488c64e2bb7edb55ae94b1b84b947e249fbc96c506b1c5095d4d.png)\n\nA manufacturer produces a triangular prism-shaped box to hold chocolate candies. In the figure, the areas of some of the faces are displayed in a net of the prism. What is the total surface area of the box?" 13194139533464 17592186045585 true] [17592186392817 1072 #uuid "7ddd59ad-58ff-5804-a895-8e6dabf22244" 13194139533464 17592186045585 true] [17592186392817 1073 true 13194139533464 17592186045585 true] [17592186392817 1074 "The surface area of our prism consists of $2$ triangles (base and top) and $3$ rectangles (central and side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+2\\times (\\text{Area of the side faces}) \\\\  & +1\\times (\\text{Area of the central face}) \\\\  & =2\\times 24+2\\times 45+54 \\\\  & =48+90+54 \\\\  & =192\\,{\\text{cm}}^{2}.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186392818 1075 #edb/ref 17592186392819 13194139533464 17592186045585 true] [17592186392818 1075 #edb/ref 17592186392820 13194139533464