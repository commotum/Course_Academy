533464 17592186045585 true] [17592186392889 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392889 1084 #uuid "73047cd2-2772-59bd-ba1e-8f58e56dc0d8" 13194139533464 17592186045585 true] [17592186392890 1068 #edb/ref 17592186392891 13194139533464 17592186045585 true] [17592186392890 1069 "q-64723" 13194139533464 17592186045585 true] [17592186392890 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186392890 1071 "![](images/d4/d42e9c6ed71f06c2dec273a91d3a4cfbdf5c58095be9370285d7987d38f7b5a6.png)\n\nWhich integral  expression gives the arc length of the curve $h(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j+t\\,k$ from  $t=0$ to $t=2\\pi ?$" 13194139533464 17592186045585 true] [17592186392890 1072 #uuid "719d5fba-71fa-5184-acdb-743568f97311" 13194139533464 17592186045585 true] [17592186392890 1074 "First, we find ${h}^{′}(t)$ and $‖{h}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{h}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+1\\,k \\\\ ‖{h}^{′}(t)‖ & =\\sqrt{(-\\operatorname{sin}⁡t)^{2}+(\\operatorname{cos}⁡t)^{2}+(1)^{2}} \\\\  & =\\sqrt{{sin}^{2}⁡t+{cos}^{2}⁡t+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is:\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{2\\pi }‖{h}^{′}(t)‖\\,\\text{d}t={\\int }_{0}^{2\\pi }\\sqrt{2}\\,\\text{d}t\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186392891 1075 #edb/ref 17592186392892 13194139533464 17592186045585 true] [17592186392891 1075 #edb/ref 17592186392893 13194139533464 17592186045585 true] [17592186392891 1075 #edb/ref 17592186392894 13194139533464 17592186045585 true] [17592186392891 1075 #edb/ref 17592186392895 13194139533464 17592186045585 true] [17592186392891 1075 #edb/ref 17592186392896 13194139533464 17592186045585 true] [17592186392891 1076 #edb/ref 1759