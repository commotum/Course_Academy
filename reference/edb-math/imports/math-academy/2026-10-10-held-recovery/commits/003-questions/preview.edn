92186045585 true] [17592186393014 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186393014 1071 "If $f(u)=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ {u}^{3} \\\\ \\operatorname{ln}⁡u\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" 13194139533464 17592186045585 true] [17592186393014 1072 #uuid "c43762c8-310f-5f86-a903-48bba629edc4" 13194139533464 17592186045585 true] [17592186393014 1074 "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186393015 1075 #edb/ref 17592186393016 13194139533464 17592186045585 true] [17592186393015 1075 #edb/ref 17592186393017 13194139533464 17592186045585 true] [17592186393015 1075 #edb/ref 17592186393018 13194139533464 17592186045585 true] [17592186393015 1075 #edb/ref 17592186393019 13194139533464 17592186045585 true] [17592186393015 1075 #edb/ref 17592186393020 13194139533464 17592186045585 true] [17592186393015 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186393015 1077 "selection" 13194139533464 17592186045585 true] [17592186393015 1079 #edb/ref 17592186393020 13194139533464 17592186045585 true] [17592186393015 1080 #uuid "198253e9-b22c-548e-8e45-872ef7aaca94" 13194139533464 17592186045585 true] [17592186393016 1081 "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393016 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393016 1084 #uuid "cc0818f3-6660-5a5e-b58d-a575762526c4" 13194139533464 17592186045585 true] [17592186393017 1081 "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393017 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393017 1084 #uuid "ab98f763-293f-5909-a542-20bf9e265d33" 13194139533464 17592186045585 true] [17592186393018 1081 "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393018 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393018 1084 #uuid "fb1b744a-fd28-5436-8fa1-dc99d58a58de" 13194139533464 17592186045585 true] [17592186393019 1081 "[\\begin{aligned}\\operatorname{sin}⁡({e}^{2t}) \\\\ {e}^{3t} \\\\ \\frac{1}{{e}^{2t}}\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393019 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393019 1084 #uuid "0df38d96-3c28-5876-bdec-12fe8a88731c" 13194139533464 17592186045585 true] [17592186393020 1081 "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393020 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393020 1084 #uuid "978ffbca-fc6b-57e5-ac7d-a192ceaaf68c" 13194139533464 17592186045585 true] [