\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨-3,4,-1⟩ & =⟨3,-5,-2⟩\\cdot ⟨-3,4,-1⟩ \\\\ r\\cdot ⟨-3,4,-1⟩ & =-27.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186393050 1075 #edb/ref 17592186393051 13194139533464 17592186045585 true] [17592186393050 1075 #edb/ref 17592186393052 13194139533464 17592186045585 true] [17592186393050 1075 #edb/ref 17592186393053 13194139533464 17592186045585 true] [17592186393050 1075 #edb/ref 17592186393054 13194139533464 17592186045585 true] [17592186393050 1075 #edb/ref 17592186393055 13194139533464 17592186045585 true] [17592186393050 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186393050 1077 "selection" 13194139533464 17592186045585 true] [17592186393050 1079 #edb/ref 17592186393055 13194139533464 17592186045585 true] [17592186393050 1080 #uuid "31ef96c8-9198-5e30-8832-aa55a71dc6d0" 13194139533464 17592186045585 true] [17592186393051 1081 "r\\cdot ⟨3,-5,-2⟩=⟨-3,4,-1⟩" 13194139533464 17592186045585 true] [17592186393051 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393051 1084 #uuid "493da2a3-c2b1-5d90-946c-32226dc19e64" 13194139533464 17592186045585 true] [17592186393052 1081 "r\\cdot ⟨-3,4,-1⟩=⟨3,-5,-2⟩" 13194139533464 17592186045585 true] [17592186393052 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393052 1084 #uuid "dc7fa3af-d391-569e-bc17-106f3e9396bf" 13194139533464 17592186045585 true] [17592186393053 1081 "r\\cdot ⟨-3,4,-1⟩=0" 13194139533464 17592186045585 true] [17592186393053 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393053 1084 #uuid "8fe2b282-7f73-5949-a7f3-cc5ddf1e2530" 13194139533464 17592186045585 true] [17592186393054 1081 "r\\cdot ⟨3,-5,-2⟩=-27" 13194139533464 17592186045585 true] [17592186393054 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393054 1084 #uuid "949e581b-c362-5470-828e-687788c962cb" 13194139533464 17592186045585 true] [17592186393055 1081 "r\\cdot ⟨-3,4,