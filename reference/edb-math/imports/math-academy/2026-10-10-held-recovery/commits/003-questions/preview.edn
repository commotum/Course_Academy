585 true] [17592186391982 1081 "[\\begin{aligned}7 & -1 \\\\ \\frac{1}{2} & -5\\end{aligned}]" 13194139533464 17592186045585 true] [17592186391982 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391982 1084 #uuid "a97992e7-99d1-5b0d-bf18-21127d13f345" 13194139533464 17592186045585 true] [17592186391983 1068 #edb/ref 17592186391984 13194139533464 17592186045585 true] [17592186391983 1069 "q-36372" 13194139533464 17592186045585 true] [17592186391983 1070 #edb/ref 17592186045487 13194139533464 17592186045585 true] [17592186391983 1071 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=0.$ Given that the point $P(2,0,4)$ lies on $C$, and that ${f}_{x}={e}^{y}+2x\\operatorname{cos}⁡y$, find the equations of the tangent line to $C$ at $P.$" 13194139533464 17592186045585 true] [17592186391983 1072 #uuid "376329be-a379-553e-b714-516f831f127f" 13194139533464 17592186045585 true] [17592186391983 1074 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=0.$ Hence, the slope of the tangent to the curve at the point $P(2,0,4)$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(2,0)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(2,0):$\n\n$$\n\\begin{aligned}{f}_{x}(2,0) & ={e}^{(0)}+2(2)\\operatorname{cos}⁡(0) \\\\  & =1+4 \\\\  & =5\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(2,0)} & =\\frac{∂z}{∂x}{|}_{(2,0)}(x-2) \\\\ z-4 & =5(x-2) \\\\ z & =5x-6\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(2,0,4)$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}y=0 \\\\ z=5x-6\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186391984 1075 #edb/ref 17592186391985 13194139533464 17592186045585 true] [17592186391984 1075 #edb/ref 17592186391986 13194139533464 17592186045585 true] [17592186391984 1075 #edb/ref 1759218639