fe3b5-c8a0-5585-ad53-8215b4504ef0" 13194139533464 17592186045585 true] [17592186393476 1081 "[\\begin{aligned}0 \\\\ -6 \\\\ 2\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393476 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393476 1084 #uuid "279049e3-350a-5049-98a0-13642ae181cf" 13194139533464 17592186045585 true] [17592186393477 1081 "[\\begin{aligned}0 \\\\ 6 \\\\ 2\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393477 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393477 1084 #uuid "e7dde41e-967c-50ab-b0b3-89716868e5dc" 13194139533464 17592186045585 true] [17592186393478 1081 "[\\begin{aligned}6 \\\\ 0 \\\\ 2\\end{aligned}]" 13194139533464 17592186045585 true] [17592186393478 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393478 1084 #uuid "2e0b1238-2717-5fc1-97e2-395e77c57487" 13194139533464 17592186045585 true] [17592186393479 1068 #edb/ref 17592186393480 13194139533464 17592186045585 true] [17592186393479 1069 "q-74992" 13194139533464 17592186045585 true] [17592186393479 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186393479 1071 "Given that $r(t)=⟨\\frac{2}{t-1},\\,3{t}^{2}-5⟩,$ calculate $r(2).$" 13194139533464 17592186045585 true] [17592186393479 1072 #uuid "d4a525e7-fcd4-5ab2-b7bc-d7b5edf64717" 13194139533464 17592186045585 true] [17592186393479 1074 "We  substitute $t=2$ into our function, and we get\n\n$$\n\\begin{aligned}r(2) & =⟨\\frac{2}{2-1},\\,3(2)^{2}-5⟩ \\\\  & =⟨2,\\,7⟩.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186393480 1075 #edb/ref 17592186393481 13194139533464 17592186045585 true] [17592186393480 1075 #edb/ref 17592186393482 13194139533464 17592186045585 true] [17592186393480 1075 #edb/ref 17592186393483 13194139533464 17592186045585 true] [17592186393480 1075 #edb/ref 17592186393484 13194139533464 17592186045585 true] [17592186393480 1075 #edb/ref 17592186393485 13194139533464 17592186045585 true] [17592186393480 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186393480 1077 "selection" 13194139533464 17592186045585 true] [17592186393480 1079 #edb/ref 17592186393484 13194139533464 17592186045585 true] [17592186393480 1080 #uuid "e2b791fb-f14c-5b79-b984-05a256893c06" 13194139533464 17592186045585 true] [17592186393481 1081 "⟨4,\\,9⟩" 13194139533464 17592186045585 true] [17592186393481 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393481 1084 #uuid "d5a3c03f-daa1-588b-bbe7-0bfe8b95a7e6" 13194139533464 17592186045585 true] [17592186393482 1081 "⟨2,\\,9⟩" 13194139533464 17592186045585 true] [17592186393482 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393482 1084 #uuid "ecbb399d-f524-5a1f-9d9a-78596c44731c" 13194139533464 17592186045585 true] [17592186393483 1081 "⟨7,\\,2⟩" 13194139533464 17592186045585 true] [17592186393483 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393483 1084 #uuid "7900986c-b845-59dd-abeb-65f4d881571c" 13194139533464 17592186045585 true] [17592186393484 1081 "⟨2,\\,7⟩" 13194139533464 17592186045585 true] [17592186393484 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393484 1084 #uuid "013efc15-def6-5fc5-abeb-b3d4f4526ecb" 13194139533464 17592186045585 true] [17592186393485 1081 "⟨1,\\,7⟩" 13194139533464 17592186045585 true] [17592186393485 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393485 1084 #uuid "b306a753-52f2-5407-9ef8-05762a1e7b54" 13194139533464 17592186045585 true] [17592186393486 1068 #edb/ref 17592186393487 13194139533464 17592186045585 true] [17592186393486 1069 "q-75059" 13194139533464 17592186045585 true] [17592186393486 1070 #edb/ref 17592186045487 13194139533464 17592186045585 true] [17592186393486 1071 "Let $R=[1,4]\\times [1,2]$ be a region in the $xy$-plane, and let $f(x,y)=4x-2y.$\nFurther, let $P$ be a partition of $R,$ where\n\n$$\n\\begin{aligned}{P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}},\\,{P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}},\\,P={P}_{1}\\times {P}_{2}.\\end{aligned}\n$$\n\nGiven that the lower Riemann sum of $f$ with respect to $P$ is given by\n\n$$\nL(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}\\boxed{}\\,Δ{x}_{i}Δ{y}_{j}\n$$\n\nwhere $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ what is the missing expression in the double summation above?" 13194139533464 17592186045585 true] [17592186393486 1072 #uuid "57912e88-68b0-5d0e-b506-928e5b1e6948" 13194139533464 17592186045585 true] [17592186393486 1074 "The lower Riemann sum is given by\n\n$$\n\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{m}_{ij}Δ{x}_{i}Δ{y}_{j}\\end{aligned}\n$$\n\nwhere ${m}_{ij}$ is the *minimum* value of $f$ in each subregion ${R}_{ij}.$ \n\nWe consider an arbitrary subregion ${R}_{ij}$ of the partition. This subregion lies between ${x}_{i-1}$ and ${x}_{i}$ over the $x$-axis and ${y}_{i-1}$ and ${y}_{i}$ over the $y$-axis, as shown below. \n\n![](images/88/88ffe30ae5401e00502b35d851b216768aad69bf94236561617adf23e1ce058f.png)\n\nNotice that:\n\n- $f(x,y)=4x-2y$ increases as $x$ increases, and\n\n- $f(x,y)=4x-2y$ decreases as $y$ increases.\n\n![](images/01/01b291ca7cd81b88cf6ed06fdcdb2ffcbb1f78255d0f57d496823d347c2fb0b3.png)\n\nAs a result, the *minimum* value of $f$ in each subregion is attained when we have the *smallest* possible $x$ and the *largest* possible $y.$ This is the value at the *top left corner* of each subregion.\n\n![](images/a4/a44c2586978022663635d1f35399166c1ae32963fe0f4bffebd21966ad40bac5.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{m}_{ij} & =f({x}_{i-1},{y}_{j})=4{x}_{i-1}-2{y}_{j}\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the lower Riemann sum is\n\n$$\n\\begin{aligned}{L}_{(}f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(4{x}_{i-1}-2{y}_{j})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $4{x}_{i-1}-2{y}_{j}.$" 13194139533464 17592186045585 true] [17592186393487 1075 #edb/ref 17592186393488 13194139533464 17592186045585 true] [17592186393487 1075 #edb/ref 17592186393489 13194139533464 17592186045585 true] [17592186393487 1075 #edb/ref 17592186393490 13194139533464 17592186045585 true] [17592186393487 1075 #edb/ref 17592186393491 13194139533464 17592186045585 true] [17592186393487 1075 #edb/ref 17592186393492 13194139533464 17592186045585 true] [17592186393487 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186393487 1077 "selection" 13194139533464 17592186045585 true] [17592186393487 1079 #edb/ref 17592186393489 13194139533464 17592186045585 true] [17592186393487 1080 #uuid "27e29a3f-7918-500d-ad1a-89b674056ef8" 13194139533464 17592186045585 true] [17592186393488 1081 "4{x}_{i}-2{y}_{j-1}" 13194139533464 17592186045585 true] [17592186393488 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393488 1084 #uuid "1e012b27-941a-5648-b514-155ce2f723e4" 13194139533464 17592186045585 true] [17592186393489 1081 "4{x}_{i-1}-2{y}_{j}" 13194139533464 17592186045585 true] [17592186393489 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393489 1084 #uuid "2a62eccf-6220-52ed-9821-bdd9d57456c1" 13194139533464 17592186045585 true] [17592186393490 1081 "{x}_{i-1}+4{y}_{j}" 13194139533464 17592186045585 true] [17592186393490 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393490 1084 #uuid "eac21ef6-0924-55b6-af22-e631025a2091" 13194139533464 17592186045585 true] [17592186393491 1081 "4{x}_{i-1}-2{y}_{j-1}" 13194139533464 17592186045585 true] [17592186393491 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393491 1084 #uuid "9246c12a-7f78-553c-837c-e2e79271b8d1" 13194139533464 17592186045585 true] [17592186393492 1081 "{x}_{i}+2{y}_{j-1}" 13194139533464 17592186045585 true] [17592186393492 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186393492 1084 #uuid "863daa61-8e3