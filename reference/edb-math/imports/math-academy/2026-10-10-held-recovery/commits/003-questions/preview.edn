6045585 true] [17592186393291 1072 #uuid "968294df-641c-514f-b1fc-74e1ba659362" 13194139533464 17592186045585 true] [17592186393291 1074 "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0-3)^{2}}{12}+\\frac{(0-1)^{2}}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{3}{4}+\\frac{1}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{7}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{(z-2)^{2}}{2} & =\\frac{1}{8} \\\\ (z-2)^{2} & =\\frac{1}{4} \\\\ z-2 & =\\pm \\frac{1}{2} \\\\ z & =2\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nHence, we get the solutions $z=\\frac{3}{2}$ and $z=\\frac{5}{2}.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2}).$" 13194139533464 17592186045585 true] [17592186393292 1075 #edb/ref 17592186393293 13194139533464 17592186045585 true] [17592186393292 1075 #edb/ref 17592186393294 13194139533464 17592186045585 true] [17592186393292 1075 #edb/ref 17592186393295 13194139533464 17592186045585 true] [17592186393292 1075 #edb/ref 17592186393296 13194139533464 17592186045585 true] [17592186393292 1075 #edb/ref 17592186393297 13194139533464 17592186045585 true] [17592186393292 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186393292 1077 "selection" 13194139533464 17592186045585 true] [17592186393292 1079 #edb/ref 17592186393294 13194139533464 17592186045585 true] [17592186393292 1080 #uuid "4865ffc5-356e-5dc2-8e39-a104fadf276d" 13194139533464 17592186045585 true] [17592186393293 1081 "$(0,0,0)$ and $(0,0,\\frac{5}{2})$" 13194139533464 17592186045585 true] [17592186393293 1083 #edb/ref 17592186045500 13194139533464 17592186045585 true] [17592186393293 1084 #uuid "92574954-56db-5e22-8577-4044312d87ef" 13194139533464 17592186045585 true] [17592186393294 1081 "$(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2})$" 13194139533464 17592186045585 true] [17592186393294 1083 #edb/ref 17592186045500 13194139533464 17592186045585 true] [17592186393294 1084 #uuid "d26ac35c-3433-