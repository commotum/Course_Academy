2186045585 true] [17592186391735 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391735 1084 #uuid "7e019b9a-dbcd-5aaa-9d4a-e9839bb29f61" 13194139533464 17592186045585 true] [17592186391736 1081 "{B}_{n}\\operatorname{cos}⁡(x\\sqrt{{\\lambda }_{n}})" 13194139533464 17592186045585 true] [17592186391736 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391736 1084 #uuid "3ae13067-ee42-5ad2-b168-11769b5a9ed5" 13194139533464 17592186045585 true] [17592186391737 1068 #edb/ref 17592186391738 13194139533464 17592186045585 true] [17592186391737 1068 #edb/ref 17592186391743 13194139533464 17592186045585 true] [17592186391737 1069 "q-339138" 13194139533464 17592186045585 true] [17592186391737 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186391737 1071 "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y=x{e}^{3x}.\n$$\n\nSelect the correct options below.$\\,$ An integrating factor for this equation is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is given by $y(x)=$ {{field-2}}." 13194139533464 17592186045585 true] [17592186391737 1072 #uuid "08d92346-a7e8-58c6-8d60-e4702d743dd1" 13194139533464 17592186045585 true] [17592186391737 1074 "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\n$$\n\nwith $P(x)=-3$ and $Q(x)=x{e}^{3x}.$ We proceed to find an integrating factor $I(x)$ using the definition:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int -3\\,\\text{d}x} \\\\  & ={e}^{-3x}\\end{aligned}\n$$\n\nNow, we multiply our differential equation through by $I(x)={e}^{-3x}$ as follows:\n\n$$\n\\begin{aligned}{e}^{-3x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}-3y) & ={e}^{-3x}\\cdot x{e}^{3x} \\\\ {e}^{-3x}\\cdot \\frac{\\text{d}y}{\\text{d}x}-3{e}^{-3x}\\cdot y & =x\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x))$ and carry out the integration:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y{e}^{-3x}) & =x \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{e}^{-3x})\\text{d}x & =\\int x\\,\\text{d}x \\\\ y{e}^{-3x} & =\\frac{{x}^{2}}{2}+C \\\\ y & =\\frac{{x}^{2}{e}^{3x}}{2}+C{e}^{3x}\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186391738 1075 #edb/ref 17592186391739 13194139533464 17592186045585 true] [17592186391738 1075 #edb/ref 17592186391740 13194139533464 17592186045585 true] [17592186391738 1075 #edb/ref 17592186391741 13194139533464 17592186045585 true] [17592186391738 1075 #edb/ref 17592186391742 13194139533464 17592186045585 true] [17592186391738 1076 #edb/ref 17592186045494 13194139533464 17592186045585 true] [17592186391738 1077 "field-1" 13194139533464 17592186045585 true] [17592186391738 1079 #edb/ref 17592186391742 13194139533464 17592186045585 true] [17592186391738 1080 #uuid "b52979ca-88b2-53be-b424-0a20f99bf0c6" 13194139533464 17592186045585 true] [17592186391739 1081 "3\\operatorname{ln}⁡x" 13194139533464 17592186045585 true] [17592186391739 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391739 1084 #uuid "7d5e5efa-0ad9-5cb1-8007-def75d4c0f34" 13194139533464 17592186045585 true] [17592186391740 1081 "{e}^{3x}" 13194139533464 17592186045585 true] [17592186391740 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391740 1084 #uuid "181ce215-60ee-5a98-8d16-1f87a5c66bf8" 13194139533464 17592186045585 true] [17592186391741 1081 "-3" 13194139533464 17592186045585 true] [17592186391741 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391741 1084 #uuid "c201762a-3b3f-52e3-a4c2-6f449ab4bd0e" 13194139533464 17592186045585 true] [17592186391742 1081 "{e}^{-3x}" 13194139533464 17592186045585 true] [17592186391742 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186391742 1084 #uuid "45bdee38-54f6-5e18-9b5f-1f916081c4c8" 13194139533464 17592186045585 true] [17592186391743 1075 #edb/ref 175921863917