 & 10\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n{\\begin{aligned} & x-2y=3 \\\\  & y=-2,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$" 13194139533464 17592186045585 true] [17592186393313 1075 #edb/ref 17592186393314 13194139533464 17592186045585 true] [17592186393313 1075 #edb/ref 17592186393315 13194139533464 17592186045585 true] [17592186393313 1075 #edb/ref 17592186393316 13194139533464 17592186045585 true] [17592186393313 1075 #edb/ref 17592186393317 13194139533464 17592186045585 true] [17592186393313 1075 #edb/ref 17592186393318 13194139533464 17592186045585 true] [17592186393313 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186393313 1077 "selection" 13194139533464 17592186045585 true] [17592186393313 1079 #edb/ref 17592186393315 13194139533464 17592186045585 true] [17592186393313 1080 #uuid "de9973d7-7169-5172-bb3d-d4ad9a2d6a14" 13194139533464 17592186045585 true] [17592186393314 1081 "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{aligned}],$\n$\\,x=1$ and $y=-1$" 13194139533464 17592186045585 true] [17592186393314 1083 #edb/ref 17592186045500 13194139533464 17592186045585 true] [17592186393314 1084 #uuid "5c7b08e6-d085-5aaa-8d73-b963955cfc39" 13194139533464 17592186045585 true] [17592186393315 1081 "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" 13194139533464 17592186045585 true] [17592186393315 1083 #edb/ref 17592186045500 13194139533464 17592186045585 true] [17592186393315 1084 #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" 13194139533464 17592186045585 true] [17592186393316