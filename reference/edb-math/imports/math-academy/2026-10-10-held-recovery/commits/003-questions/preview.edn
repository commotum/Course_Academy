aedfe5c0978e5d6991fcce4bfe6c609aca3fb2.png" 13194139533464 17592186045585 true] [17592186392752 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392752 1084 #uuid "05352607-bc7f-52c9-b024-45731a62e3a4" 13194139533464 17592186045585 true] [17592186392753 1081 "images/ae/ae60cff8e3670c2462ca1cf67179f6534f091c2f8bbbe4e1684141d78516e138.png" 13194139533464 17592186045585 true] [17592186392753 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392753 1084 #uuid "9842c750-4db7-5d95-8ed5-7083875ea3a2" 13194139533464 17592186045585 true] [17592186392754 1081 "images/df/df918f525274479ddf12fd1940408be116c92dbe93ca19e46676ec07dc5121a8.png" 13194139533464 17592186045585 true] [17592186392754 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392754 1084 #uuid "38a9fbb8-74f8-5733-8270-a1e4e8bc058a" 13194139533464 17592186045585 true] [17592186392755 1068 #edb/ref 17592186392756 13194139533464 17592186045585 true] [17592186392755 1069 "q-53154" 13194139533464 17592186045585 true] [17592186392755 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186392755 1071 "![](images/40/40a654166838ab16d5dc300e3c0eab894a6754a47edc68051336f4ea2a5db2e8.png)\n\nWhat is the area of the triangle $△ABC$ shown above?\n\n(Figure not drawn to scale)" 13194139533464 17592186045585 true] [17592186392755 1072 #uuid "823b1b37-db73-5eaa-b884-1ecc4dfb7bdf" 13194139533464 17592186045585 true] [17592186392755 1074 "The area of the triangle is defined as \n\n$$\nA=\\frac{b\\cdot h}{2},\n$$\n\n where $b$ is a base and $h$ is the corresponding height.\n\nFrom the diagram, we see that the base is \n\n$$\nb=AB=5\\,\\text{m}\n$$\n\nand the corresponding height is \n\n$$\nh=12\\,\\text{m}.\n$$\n\nTherefore, the area is\n\n$$\n\\begin{aligned}A & =\\frac{b\\cdot h}{2} \\\\  & =\\frac{5\\cdot 12}{2} \\\\  & =\\frac{60}{2} \\\\  & =30\\,{\\text{m}}^{2}.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186392756 1075 #edb/ref 17592186392757 13194139533464 17592186045585 true] [17592186392756 1075 #edb/ref 17592186392758 13194139533464 17592186045585 true] [17592186392756 1075 #edb/ref 17592186392759 13194139533464 17592186045585 true] [17592186392756 1075 #edb/ref 17592186392760 13194139533464 17592186045585 true] [17592186392756 1075 #edb/ref 17592186392761 13194139533464 17592186045585 true] [17592186392756 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186392756 1077 "selection" 13194139533464 17592186045585 true] [17592186392756 1079 #edb/ref 17592186392760 13194139533464 17592186045585 true] [17592186392756 1080 #uuid "2dd95d01-f696-54ec-8302-29c76fdbdf3c" 13194139533464 17592186045585 true] [17592186392757 1081 "20\\,{\\text{m}}^{2}" 13194139533464 17592186045585 true] [17592186392757 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392757 1084 #uuid "fca47e6f-7077-58c5-9eba-fabbd0424cfa" 13194139533464 17592186045585 true] [17592186392758 1081 "60\\,{\\text{m}}^{2}" 13194139533464 17592186045585 true] [17592186392758 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392758 1084 #uuid "fe94b7cf-d6f0-5d8d-967d-01cf37ded656" 13194139533464 17592186045585 true] [17592186392759 1081 "35\\,{\\text{m}}^{2}" 13194139533464 17592186045585 true] [17592186392759 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392759 1084 #uuid "e86614c0-7a63-506e-b785-467d7b3a9afa" 13194139533464 17592186045585 true] [17592186392760 1081 "30\\,{\\text{m}}^{2}" 13194139533464 17592186045585 true] [17592186392760 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392760 1084 #uuid "b98274de-d364-5518-bde6-2ee6f9eaaa05" 13194139533464 17592186045585 true] [17592186392761 1081 "40\\,{\\text{m}}^{2}" 13194139533464 17592186045585 true] [17592186392761 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392761 1084 #uuid "aa036e36-7f2f-52d3-9e3f-bd2def22e6b1" 13194139533464 17592186045585 true] [17592186392762 1068 #edb/ref 17592186392763 13194139533464 17592186045585 true] [17592186392762 1069 "q-54522" 13194139533464 17592186045585 true] [17592186392762 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186392762 1071 "![](images/7f/7ffd75051b71a3b8665ac68418ff24dac2124a6b7ff50633a0a5843df9cff196.png)\n\nWhich integral expression gives the total area enclosed between the curve $y={x}^{5}-x$ and the $x$-axis, as shown above?" 13194139533464 17592186045585 true] [17592186392762 1072 #uuid "684f1c1d-407b-5f72-a75f-8a2754804ac2" 13194139533464 17592186045585 true] [17592186392762 1074 "First, we the limits of integration. We find the $x$-intercepts of the curve as follows:\n\n$$\n\\begin{aligned}{x}^{5}-x & =0 \\\\ x({x}^{4}-1) & =0 \\\\ x({x}^{2}-1)({x}^{2}+1) & =0 \\\\ x({x}^{2}-1) & =0 \\\\ x(x-1)(x+1) & =0.\\end{aligned}\n$$\n\nSo we have $x=\\pm 1$ or $x=0.$ \nThis gives us two regions: \n\n- The area between the curve and the $x$-axis from $x=-1$ to $x=0.$\n\n- The area between the curve and the $x$-axis from $x=0$ to $x=1.$\n\nFor $x\\in [-1,0]$, we have\n\n$$\n{A}_{1}={\\int }_{-1}^{0}({x}^{5}-x)\\,\\text{d}x.\n$$\n\nNotice that for $x\\in [0,1]$ the region lies completely below the $x$-axis. Hence, the value of\n\n$$\n{\\int }_{a}^{b}y(x)\\,\\text{d}x={\\int }_{0}^{1}({x}^{5}-x)\\,\\text{d}x\n$$\n\nwill be negative. Therefore, the area that we want is given by\n\n$$\n{A}_{2}=-{\\int }_{0}^{1}({x}^{5}-x)\\,\\text{d}x={\\int }_{0}^{1}-({x}^{5}-x)\\,\\text{d}x.\n$$\n\nFinally, the total area is\n\n$$\nA={A}_{1}+{A}_{2}={\\int }_{-1}^{0}({x}^{5}-x)\\,\\text{d}x+{\\int }_{0}^{1}-({x}^{5}-x)\\,\\text{d}x.\n$$" 13194139533464 17592186045585 true] [17592186392763 1075 #edb/ref 17592186392764 13194139533464 17592186045585 true] [17592186392763 1075 #edb/ref 17592186392765 13194139533464 17592186045585 true] [17592186392763 1075 #edb/ref 17592186392766 13194139533464 17592186045585 true] [17592186392763 1075 #edb/ref 17592186392767 13194139533464 17592186045585 true] [17592186392763 1075 #edb/ref 17592186392768 13194139533464 17592186045585 true] [17592186392763 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186392763 1077 "selection" 13194139533464 17592186045585 true] [17592186392763 1079 #edb/ref 17592186392765 13194139533464 17592186045585 true] [17592186392763 1080 #uuid "0392da4a-7c40-5083-8000-8d46e792fc8e" 13194139533464 17592186045585 true] [17592186392764 1081 "{\\int }_{-1}^{0}-({x}^{5}-x)\\,\\text{d}x+{\\int }_{0}^{1}({x}^{5}-x)\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392764 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392764 1084 #uuid "cfb87908-0820-5ed9-9c74-e694fd902ed0" 13194139533464 17592186045585 true] [17592186392765 1081 "{\\int }_{-1}^{0}({x}^{5}-x)\\,\\text{d}x+{\\int }_{0}^{1}-({x}^{5}-x)\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392765 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392765 1084 #uuid "2601aadd-9cbb-5cc4-9558-fb7e3852b604" 13194139533464 17592186045585 true] [17592186392766 1081 "{\\int }_{-1}^{1}({x}^{5}-x)\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392766 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392766 1084 #uuid "42b42b06-1459-571f-85f4-60f215cb6f4d" 13194139533464 17592186045585 true] [17592186392767 1081 "{\\int }_{-2}^{0}({x}^{5}-x)\\,\\text{d}x+{\\int }_{0}^{2}-({x}^{5}-x)\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392767 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392767 1084 #uuid "e10d1563-93c7-515c-ac59-8784534bd860" 13194139533464 17592186045585 true] [17592186392768 1081 "{\\int }_{-2}^{2}({x}^{5}-x)\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392768 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392768 1084 #uuid "fe6c2771-7902-5c0c-83a0-d6defda501dd" 13194139533464 17592186045585 true] [17592186392769 1068 #edb/ref 17592186392770 13194139533464 17592186045585 true] [17592186392769 1069 "q-5570" 13194139533464 17592186045585 true] [17592186392769 1070 #edb/ref 17592186045485 13194139533464 17592186045585 true] [17592186392769 1071 "Cheryl holds a bag of $40$ marbles, each one with a slightly different size or color. If she picks $5$ of them out one at a time and lines up in a row, how many different lines of $5$ marbles are possible?" 13194139533464 17592186045585 true] [17592186392769 1072 #uuid "9b6ce883-6a1c-54f4-85a1-b5c70b81dd2b" 13194139533464 17592186045585 true] [17592186392769 1074 "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $40$ marbles to choose from, so $n=40.$ We want to select $5$ of those marbles for the line, so we have $r=5.$ \n\nTherefore, the number of different ways to line up $5$ marbles is \n\n$$\n\\begin{aligned}{}_{40}{P}_{5} & =\\frac{40!}{(40-5)!} \\\\  & =\\frac{40!}{35!} \\\\  & =\\frac{40\\cdot 39\\cdot 38\\cdot 37\\cdot 36\\cdot \\cancel{35!}}{\\cancel{35!}} \\\\  & =40\\cdot 39\\cdot 38\\cdot 37\\cdot 36 \\\\  & =78\\,960\\,960.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186392770 1075 #edb/ref 17592186392771 13194139533464 17592186045585 true] [17592186392770 1075 #edb/ref 17592186392772 13194139533464 17592186045585 true] [17592186392770 1075 #edb/ref 17592186392773 13194139533464 17592186045585 true] [17592186392770 1075 #edb/ref 17592186392774 13194139533464 17592186045585 true] [17592186392770 1075 #edb/ref 17592186392775 13194139533464 17592186045585 true] [17592186392770 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186392770 1077 "selection" 13194139533464 17592186045585 true] [17592186392770 1079 #edb/ref 17592186392771 13194139533464 17592186045585 true] [17592186392770 1080 #uuid "82710d4a-5d29-5135-9672-3c9a534fb117" 13194139533464 17592186045585 true] [17592186392771 1081 "78\\,960\\,960" 13194139533464 17592186045585 true] [17592186392771 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392771 1084 #uuid "c0f272ea-eaec-5ac0-9b1d-aed0b3b9e6ab" 13194139533464 17592186045585 true] [17592186392772 1081 "780\\,560" 13194139533464 17592186045585 true] [17592186392772 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392772 1084 #uuid "c41d4f0f-8496-5262-aa00-f1d571ba31b1" 13194139533464 17592186045585 true] [17592186392773 1081 "120\\,450" 13194139533464 17592186045585 true] [17592186392773 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392773 1084 #uuid "871096f9-d17a-5038-8600-80bf7c8a9394" 13194139533464 17592186045585 true] [17592186392774 1081 "24\\,670\\,820" 13194139533464 17592186045585 true] [17592186392774 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392774 1084 #uuid "e4e17fa3-d32f-56b3-bdab-0e009c6576c0" 13194139533464 17592186045585 true] [17592186392775 1081 "4\\,320\\,560" 13194139533464 17592186045585 true] [17592186392775 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392775 1084 #uuid "e3e46837-c2dd-594c-b9df-46f81facc364" 13194139533464 17592186045585 true] [17592186392776 1068 #edb/ref 17592186392777 13194139533464 17592186045585 true] [17592186392776 1069 "q-5571" 13194139533464 17592186045585 true] [17592186392776 1070 #edb/ref 17592186045487 13194139533464 17592186045585 true] [17592186392776 1071 "A teacher gives you a test with a set of fifteen questions, out of which you are told to answer ten. How many ways can you answer ten different questions?" 13194139533464 17592186045585 true] [17592186392776 1072 #uuid "0f0b6262-099b-5e2a-971d-80d2d850edfd" 13194139533464 17592186045585 true] [17592186392776 1074 "In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $15$ questions, so $n=15.$ We want to select $10$ of those questions to answer, so we have $r=10.$\n\nTherefore, the number of ways to answer $10$ different questions is\n\n$$\n\\begin{aligned}{}_{15}{C}_{10} & =\\frac{15!}{(15-10)!\\,10!} \\\\  & =\\frac{15!}{5!10!} \\\\  & =\\frac{15\\cdot 14\\cdot 13\\cdot 12\\cdot 11\\cdot \\cancel{10!}}{5!\\cancel{10!}} \\\\  & =\\frac{15\\cdot 14\\cdot 13\\cdot 12\\cdot 11}{5\\cdot 4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{360\\,360}{120} \\\\  & =3\\,003.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186392777 1075 #edb/ref 17592186392778 13194139533464 17592186045585 true] [17592186392777 1075 #edb/ref 17592186392779 13194139533464 17592186045585 true] [17592186392777 1075 #edb/ref 17592186392780 13194139533464 17592186045585 true] [17592186392777 1075 #edb/ref 17592186392781 13194139533464 17592186045585 true] [17592186392777 1075 #edb/ref 17592186392782 13194139533464 17592186045585 true] [17592186392777 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186392777 1077 "selection" 13194139533464 17592186045585 true] [17592186392777 1079 #edb/ref 17592186392778 13194139533464 17592186045585 true] [17592186392777 1080 #uuid "9798efc4-d9be-59d0-aea4-2381274e684a" 13194139533464 17592186045585 true] [17592186392778 1081 "3\\,003" 13194139533464 17592186045585 true] [17592186392778 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392778 1084 #uuid "f089b840-e005-5e7a-9ca8-910c63c69a44" 13194139533464 17592186045585 true] [17592186392779 1081 "920" 13194139533464 17592186045585 true] [17592186392779 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392779 1084 #uuid "4fd33d27-4e9f-5373-9545-90720050f17a" 13194139533464 17592186045585 true] [17592186392780 1081 "545" 13194139533464 17592186045585 true] [17592186392780 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392780 1084 #uuid "15326776-61b2-52db-9fb8-82d245b1e023" 13194139533464 17592186045585 true] [17592186392781 1081 "1\\,747" 13194139533464 17592186045585 true] [17592186392781 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392781 1084 #uuid "21f6aac5-0325-5ba0-86e1-61b997bc4914" 13194139533464 17592186045585 true] [17592186392782 1081 "36\\,045" 13194139533464 17592186045585 true] [17592186392782 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392782 1084 #uuid "469416b3-6dc5-5ab8-a00f-8cc01934b7c6" 13194139533464 17592186045585 true] [17592186392783 1068 #edb/ref 17592186392784 13194139533464 17592186045585 true] [17592186392783 1069 "q-59760" 13194139533464 17592186045585 true] [17592186392783 1070 #edb/ref 17592186045486 13194139533464 17592186045585 true] [17592186392783 1071 "A particle accelerates from rest with a constant acceleration of $5\\,{\\text{km/h}}^{2}$ for the first $4$ hours of its motion. It then travels at a constant speed for the next $6$ hours. Which graph represents the described motion?" 13194139533464 17592186045585 true] [17592186392783 1072 #uuid "3482860b-89cd-5fe9-aa14-3b6ba9d6957f" 13194139533464 17592186045585 true] [17592186392783 1074 "We start the first line from the point $(0,0),$ since the particle starts from rest. Then, because the acceleration is $5\\,{\\text{km/h}}^{2},$ we draw a line with slope $5.$ \n\nHowever, because the particle is only accelerating for the first $4$ hours, we stop the line at $t=4.$ At this time, the particle's speed has increased by $4\\cdot 5=20\\text{ km/h}.$ So, the first line segment goes from $(0,0)$ to $(4,20).$\n\n![](images/cf/cf0471f38486963f4237b4fab7c1cd109d02cc2d7ac3e30990831654f04c5b11.png)\n\nThe particle then travels at a constant speed for the next $6$ hours. So, the speed remains at $20\\,\\text{km/h}$ for the next $6$ hours, until $t=4+6=10.$\n\nSo, the second line segment stops at the point $(10,20).$ The final graph is\n\n![](images/fa/fae4c7d8cfc79dd70041ebd697226408a5cdd0676ad2ddfaad1500ea1ba0a76e.png)" 13194139533464 17592186045585 true] [17592186392784 1075 #edb/ref 17592186392785 13194139533464 17592186045585 true] [17592186392784 1075 #edb/ref 17592186392786 13194139533464 17592186045585 true] [17592186392784 1075 #edb/ref 17592186392787 13194139533464 17592186045585 true] [17592186392784 1075 #edb/ref 17592186392788 13194139533464 17592186045585 true] [17592186392784 1075 #edb/ref 17592186392789 13194139533464 17592186045585 true] [17592186392784 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186392784 1077 "selection" 13194139533464 17592186045585 true] [17592186392784 1079 #edb/ref 17592186392789 13194139533464 17592186045585 true] [17592186392784 1080 #uuid "238dbbfc-eaba-5eb7-9c11-94c48e0f1e4d" 13194139533464 17592186045585 true] [17592186392785 1081 "images/7c/7c3e6680c0a158181e11b473a94fa43b1a2afb3ea5c6206244801f4830bafff8.png" 13194139533464 17592186045585 true] [17592186392785 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392785 1084 #uuid "f8831562-bcba-5d5e-86bd-bd2156c1e48a" 13194139533464 17592186045585 true] [17592186392786 1081 "images/11/11691073c02c80a9c4400623a8ee648d8a9405faab89ac8ce4fdbb7dbdd61baa.png" 13194139533464 17592186045585 true] [17592186392786 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392786 1084 #uuid "8e0a8238-9f58-50ad-9590-85298b9c467a" 13194139533464 17592186045585 true] [17592186392787 1081 "images/d1/d1123b8a9a86288380e084f8001ef5ebcc160d5647c83f3878a3d7b357087a9a.png" 13194139533464 17592186045585 true] [17592186392787 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392787 1084 #uuid "76325543-0212-5f9d-8b9d-4de0bdfd65f6" 13194139533464 17592186045585 true] [17592186392788 1081 "images/ec/ec8ff99395b5f33f531303acd91c58ada3b7f71213a5af5c76c86dae62d277e9.png" 13194139533464 17592186045585 true] [17592186392788 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392788 1084 #uuid "6258ba45-43e7-5c96-b19f-b0486d5d81c2" 13194139533464 17592186045585 true] [17592186392789 1081 "images/fa/fae4c7d8cfc79dd70041ebd697226408a5cdd0676ad2ddfaad1500ea1ba0a76e.png" 13194139533464 17592186045585 true] [17592186392789 1083 #edb/ref 17592186045498 13194139533464 17592186045585 true] [17592186392789 1084 #uuid "19c2e144-25c8-5914-9f81-2dab848d8fc1" 13194139533464 17592186045585 true] [17592186392790 1068 #edb/ref 17592186392791 13194139533464 17592186045585 true] [17592186392790 1069 "q-6001" 13194139533464 17592186045585 true] [17592186392790 1070 #edb/ref 17592186045487 13194139533464 17592186045585 true] [17592186392790 1071 "The length of the curve $y=x\\operatorname{ln}⁡x$ on $[1,e]$ is given by" 13194139533464 17592186045585 true] [17592186392790 1072 #uuid "1018367e-83ad-5af3-99ec-2abf57016cee" 13194139533464 17592186045585 true] [17592186392790 1074 "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=x\\operatorname{ln}⁡x,$ $a=1,$ and $b=e.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\operatorname{ln}⁡x+x\\cdot \\frac{1}{x}=\\operatorname{ln}⁡x+1\n$$\n\nSubstituting ${f}^{′}(x)=\\operatorname{ln}⁡x+1$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{e}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}\\sqrt{1+{(\\operatorname{ln}⁡x+1)}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{e}\\sqrt{{ln}^{2}⁡x+2\\operatorname{ln}⁡x+2}\\,\\text{d}x.\\end{aligned}\n$$" 13194139533464 17592186045585 true] [17592186392791 1075 #edb/ref 17592186392792 13194139533464 17592186045585 true] [17592186392791 1075 #edb/ref 17592186392793 13194139533464 17592186045585 true] [17592186392791 1075 #edb/ref 17592186392794 13194139533464 17592186045585 true] [17592186392791 1075 #edb/ref 17592186392795 13194139533464 17592186045585 true] [17592186392791 1075 #edb/ref 17592186392796 13194139533464 17592186045585 true] [17592186392791 1076 #edb/ref 17592186045493 13194139533464 17592186045585 true] [17592186392791 1077 "selection" 13194139533464 17592186045585 true] [17592186392791 1079 #edb/ref 17592186392792 13194139533464 17592186045585 true] [17592186392791 1080 #uuid "e8ab54e5-e3ae-5c28-96df-43d45b975ac9" 13194139533464 17592186045585 true] [17592186392792 1081 "{\\int }_{1}^{e}\\sqrt{{ln}^{2}⁡x+2\\operatorname{ln}⁡x+2}\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392792 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392792 1084 #uuid "130902b7-518f-5bff-b4c6-70ec10669ed6" 13194139533464 17592186045585 true] [17592186392793 1081 "{\\int }_{1}^{e}\\sqrt{2{ln}^{2}⁡x+\\operatorname{ln}⁡x+2}\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392793 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392793 1084 #uuid "2e9dc4bc-d4d3-5b8e-abbf-e99a3aff279c" 13194139533464 17592186045585 true] [17592186392794 1081 "{\\int }_{1}^{e}\\sqrt{\\operatorname{ln}⁡x+2}\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392794 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392794 1084 #uuid "c337a131-ba2b-58de-bb8a-9bc3f5b91c72" 13194139533464 17592186045585 true] [17592186392795 1081 "{\\int }_{1}^{e}\\sqrt{2{ln}^{2}⁡x+\\operatorname{ln}⁡x+1}\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392795 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392795 1084 #uuid "104a11b9-60b8-543e-98fa-97a1a9ca9dd4" 13194139533464 17592186045585 true] [17592186392796 1081 "{\\int }_{1}^{e}\\operatorname{ln}⁡x+1\\,\\text{d}x" 13194139533464 17592186045585 true] [17592186392796 1083 #edb/ref 17592186045499 13194139533464 17592186045585 true] [17592186392796 1084 #uuid "c97ec70f-712d-5261-a2ad-b13ddf434c3f" 13194139533464 17592186045585 true] [17592186392797 1068 #edb/ref 17592186392798 13194139533464 17592186045585 true] [1759