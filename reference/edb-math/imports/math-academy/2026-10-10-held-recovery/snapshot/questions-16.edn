estion/id #uuid "bb2dd55a-4969-5401-b5e0-478786fa3f74" :question/math-academy-id "q-77726" :question/problem "Consider the linear transformation $T$ with matrix representation $T$, given by\n\n$T = \\begin{bmatrix}-3 & \\sqrt{3} \\\\ 1 & \\sqrt{3}\\end{bmatrix}$.\n\nWhat are the coordinates of the point $S^{′}$, the image of $S(-4, \\sqrt{3})$ under the action of $T$?"}] [{:db/id #edb/ref 17592186083938 :knowledge-point/_questions [{:knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77469a26-a869-5617-be2f-65026d46c340" :answer/type {:db/ident :answer.type/math} :answer/value "(7,6)" :db/id #edb/ref 17592186346404} {:answer/id #uuid "a2172fa6-22de-576c-8e8f-e147688e6580" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-2)" :db/id #edb/ref 17592186346765} {:answer/id #uuid "c11c3988-f8a3-56ec-8943-23a862fbf5b2" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,2)" :db/id #edb/ref 17592186347026} {:answer/id #uuid "c662193b-81b8-5941-88f2-11255487dc3d" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-6)" :db/id #edb/ref 17592186347082} {:answer/id #uuid "e9c98a73-808f-58eb-bda8-b408c871ee46" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186347421}] :answer-field/correct {:answer/id #uuid "c11c3988-f8a3-56ec-8943-23a862fbf5b2" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,2)" :db/id #edb/ref 17592186347026} :answer-field/id #uuid "5d6a0760-455a-5b10-bb0e-56804999c3f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347772}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecad8073-32a5-5bcd-a4f6-4e37160bc7af" :question/math-academy-id "q-78254" :question/problem "What is the center of the hyperbola $\\frac{(x+4)^{2}}{7}-\\frac{(y-2)^{2}}{6}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-(-4))^{2}}{7}-\\frac{(y-2)^{2}}{6}=1\n$$\n\nIn this case, $h=-4$ and $k=2.$\n\nTherefore, the center of the hyperbola is $(-4,2).$"}] [{:db/id #edb/ref 17592186176576 :knowledge-point/_questions [{:knowledge-point/id #uuid "de97ba5b-7e05-5f3d-b11d-bf8e10c3bc54" :knowledge-point/title "Computing a Generalized Eigenvector of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2bbdd76-6c28-529e-93aa-9c2d32cfcca2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186175565} {:answer/id #uuid "fb6c3bdd-0c01-51b5-ab08-24122bea76d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186175566} {:answer/id #uuid "06b6607a-5d73-5017-8a01-9b4dc5457949" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 0 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186175567} {:answer/id #uuid "4c87c5e8-8384-57d9-918b-e9f1dd1c836b" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186175568} {:answer/id #uuid "5e2bcb8b-1587-5fae-b789-cef3d9a309c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186175569}] :answer-field/id #uuid "749e8cda-014b-5ec3-b57d-ede6636600d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175564}] :question/id #uuid "22e82ef5-ade9-5251-8d75-4be1c8a1c5f9" :question/math-academy-id "q-78501" :question/problem "Which of the following is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $λ = 2$ for the matrix $A$, given by\n\n$A = \\begin{bmatrix}2 & 1 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 2\\end{bmatrix}$?\n\n*Hint: You may wish to make use of the following result:*\n\n$(A - 2I)^{2} = \\begin{bmatrix}0 & 0 & 0 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}$."}]}
