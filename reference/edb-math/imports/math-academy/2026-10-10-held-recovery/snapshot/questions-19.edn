-point/_questions [{:knowledge-point/id #uuid "1fdf7e44-a092-5990-a10e-d48b175dcef0" :knowledge-point/title "Writing a Function Using Arrow Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12756fea-d511-5413-ba42-e73f9ba0c031" :answer/type {:db/ident :answer.type/math} :answer/value "f: Q → X" :db/id #edb/ref 17592186171400} {:answer/id #uuid "2a18c8bc-4ef6-50fd-a7fb-41e818cc22c3" :answer/type {:db/ident :answer.type/math} :answer/value "g: X → R" :db/id #edb/ref 17592186171401} {:answer/id #uuid "3809dc43-4135-5464-91b6-25b44f1ab772" :answer/type {:db/ident :answer.type/math} :answer/value "g: R → R" :db/id #edb/ref 17592186171402} {:answer/id #uuid "43760b88-aeaa-5fdb-b186-992ef13e2b65" :answer/type {:db/ident :answer.type/math} :answer/value "f: X → Q" :db/id #edb/ref 17592186171403} {:answer/id #uuid "59cf8c2b-0ce0-5a3c-a0a7-b3fdd9e769b0" :answer/type {:db/ident :answer.type/math} :answer/value "g: R → X" :db/id #edb/ref 17592186171404}] :answer-field/id #uuid "920e367e-2ddb-534f-b346-fd7c372957ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171399}] :question/id #uuid "25726fd8-78e9-529e-acdf-5c4c5a237b40" :question/math-academy-id "q-96040" :question/problem "Which of the following is the correct symbolic notation for the sentence given below?\n\n> *\"The function $g$ maps the set $X$ to the set of real numbers.\"*"}] [{:db/id #edb/ref 17592186167472 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f0dc37d-a22e-572c-933d-f3490ad356de" :knowledge-point/title "The Singular Value Decomposition of a 2x2 Matrix With a Zero Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ca91e9e-e238-5213-ab51-7b27677efb76" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$\nand\n$V = \\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$" :db/id #edb/ref 17592186166011} {:answer/id #uuid "a568f08a-e8f9-50b4-bda6-969ce6cedea0" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{3}{5} & \\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}$\nand\n$V = \\begin{bmatrix}\\frac{3}{5} & -\\frac{4}{5} \\\\ \\frac{4}{5} & \\frac{3}{5}\\end{bmatrix}$" :db/id #edb/ref 17592186166012} {:answer/id #uuid "d6d9910f-59fb-51a5-98b9-e14efb05ea1a" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}\\frac{1}{\\sqrt{3}} & -\\frac{\\sqrt{2}}{\\sqrt{3}} \\\\ \\frac{\\sqrt{2}}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}}\\end{bmatrix}$ and $V = \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}$" :db/id #edb/ref 17592186166013} {:answer/id #uuid "f978b995-377e-5670-9d14-29acb3107c18" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{1}{\\sqrt{10}} & \\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}$\nand\n$V = \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186166014} {:answer/id #uuid "28b56754-724b-57af-a4bb-44fd395efa42" :answer/type {:db/ident :answer.type/text} :answer/value "$U = \\begin{bmatrix}-\\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}$\nand\n$V = \\begin{bmatrix}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}$" :db/id #edb/ref 17592186166015}] :answer-field/id #uuid "a6091cef-0dc2-5c6e-8ecd-d1cf1c9133cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166010}] :question/id #uuid "b0a7a3b6-717f-5db5-9c33-ba5621dfa097" :question/math-academy-id "q-96351" :question/problem "$A = \\begin{bmatrix}0 & \\sqrt{2} \\\\