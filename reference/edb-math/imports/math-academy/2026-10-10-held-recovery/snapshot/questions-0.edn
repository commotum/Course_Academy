t/title "Finding the Cartesian Equation of a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77633f7b-a4f6-5605-b197-300dedbccde8" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x(x+5)(2x+1)" :db/id #edb/ref 17592186236573} {:answer/id #uuid "7b957847-885e-58d3-87c4-376c6913a3f1" :answer/type {:db/ident :answer.type/math} :answer/value "y=2(2x+1)^{3}" :db/id #edb/ref 17592186236593} {:answer/id #uuid "878bf002-299b-523a-93bd-80e7642d9000" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x(2x+1)(2x-5)" :db/id #edb/ref 17592186236669} {:answer/id #uuid "8b44f564-28f4-5786-9cf7-4b0382705e60" :answer/type {:db/ident :answer.type/math} :answer/value "y=(2x+1)^{3}" :db/id #edb/ref 17592186236696} {:answer/id #uuid "abe07822-f677-59f4-b923-e8aa2238417d" :answer/type {:db/ident :answer.type/math} :answer/value "y=2x(x-5)(2x+1)" :db/id #edb/ref 17592186236910}] :answer-field/correct {:answer/id #uuid "77633f7b-a4f6-5605-b197-300dedbccde8" :answer/type {:db/ident :answer.type/math} :answer/value "y=4x(x+5)(2x+1)" :db/id #edb/ref 17592186236573} :answer-field/id #uuid "b2e38393-de71-5a6b-b9b5-971eae7190b7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44f36d19-593e-54ad-8307-e8844e507156" :question/math-academy-id "q-102668" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{t-5}{2},\\,\\,\\,y=({t}^{2}-25)(t-4),\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{t-5}{2}\\,⇒\\,t=2x+5\\end{aligned}\n$$\n\nNow, substituting $t=2x+5$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((2x+5)^{2}-25)(2x+5-4) \\\\  & =(4{x}^{2}+20x+25-25)(2x+1) \\\\  & =(4{x}^{2}+20x)(2x+1) \\\\  & =4x(x+5)(2x+1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=4x(x+5)(2x+1).$"}] [{:db/id #edb/ref 17592186176185 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9eb6340b-14ef-52dd-8c81-f42abe1f7db3" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186173339} {:answer/id #uuid "d70c7e60-9413-5397-ad7d-cc813be7a7de" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186173340} {:answer/id #uuid "d8172f30-0032-57c6-b711-70b10ccc26d3" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186173341} {:answer/id #uuid "e5ab7837-d47d-5cb0-bc14-595dc1cfabaa" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186173342} {:answer/id #uuid "4779d64a-2cc5-54b4-8a38-4f3be274cddc" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186173343}] :answer-field/id #uuid "60c6ad40-5828-5d36-97ba-df0f631c5a76" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173338}] :question/id #uuid "d5012f64-5f75-5c60-9687-8fa0fb8ccd67" :question/math-academy-id "q-102908" :question/problem "What surface is defined by the equation $r = 3$ in cylindrical polar coordinates?"}] [{:db/id #edb/ref 17592186167055 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd281121-21d3-5dc4-8537-af248d0fdf46" :knowledge-point/title "Identifying the Vector Field Corresponding to a Given Potential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b69b16c0-aa13-5778-b2ef-bc583efe6b95" :a