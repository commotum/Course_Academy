pe/radio} :db/id #edb/ref 17592186124166}] :question/id #uuid "2033ad74-5082-5dec-974c-c157b392c0a6" :question/math-academy-id "q-98116" :question/problem "Let $f(x, y)$ be a function that is differentiable at each point on the line segment $AB^(―)$, where $a = ⟨1, 2⟩$ and $b = ⟨2, 3⟩$ are the position vectors of $A$ and $B$, respectively. If $f(a) = 1$ and $f(b) = 6$, then according to the mean value theorem, which of the following must be true for some point $C ∈ AB^(―)$ with position vector $c$?"}] [{:db/id #edb/ref 17592186125267 :knowledge-point/_questions [{:knowledge-point/id #uuid "45abb029-42f5-5297-b793-f893178e0c29" :knowledge-point/title "Finding an Equation Implied by the Mean Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af87d733-b24c-595b-ba0b-7d57e772c1ed" :answer/type {:db/ident :answer.type/math} :answer/value "2f_{x}(c) - 2f_{y}(c) + 4f_{z}(c) =-1" :db/id #edb/ref 17592186124173} {:answer/id #uuid "cc23f700-9955-51e6-ba04-3eaa05da92ed" :answer/type {:db/ident :answer.type/math} :answer/value "4f_{x}(c) - 2f_{y}(c) + 2f_{z}(c) = 3" :db/id #edb/ref 17592186124174} {:answer/id #uuid "dd44cfa5-3c08-5503-b7dc-12660244fdaf" :answer/type {:db/ident :answer.type/math} :answer/value "f_{x}(c) + f_{y}(c) + f_{z}(c) = 4" :db/id #edb/ref 17592186124175} {:answer/id #uuid "07224349-475f-58bb-906d-ed63609f175a" :answer/type {:db/ident :answer.type/math} :answer/value "2f_{x}(c) + 2f_{y}(c) - f_{z}(c) = 1" :db/id #edb/ref 17592186124176} {:answer/id #uuid "2a867112-f49c-5f67-8053-bd17a4338659" :answer/type {:db/ident :answer.type/math} :answer/value "f_{x}(c) - f_{y}(c) + 2f_{z}(c) = 0" :db/id #edb/ref 17592186124177}] :answer-field/id #uuid "5f3e2d09-32b0-582e-9622-85ce2c2ed9ca" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124172}] :question/id #uuid "9a668edb-9a8d-5acd-b6b7-2627f5a72df0" :question/math-academy-id "q-98117" :question/problem "Let $f(x, y, z)$ be a function that is differentiable at each point on the line segment $AB^(―)$, where $a = ⟨3, 2, 5⟩$ and $b = ⟨1, 4, 1⟩$ are the position vectors of $A$ and $B$, respectively. If $f(a) = 2$ and $f(b) = 3$, then what is missing from the statement below?\n\n*The mean value theorem states that there exists a point $C ∈ AB^(―)$ with position vector $c$ such that $\\left.\\right|_______________$.*"}] [{:db/id #edb/ref 17592186167547 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd281121-21d3-5dc4-8537-af248d0fdf46" :knowledge-point/title "Identifying the Vector Field Corresponding to a Given Potential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f81d2d-d5c5-56a4-9386-45b306a54421" :answer/type {:db/ident :answer.type/math} :answer/value "2xyzi + x^{2}zj + (x^{2}y + 2z)k" :db/id #edb/ref 17592186166461} {:answer/id #uuid "114c77c1-eeaa-5774-b9a8-841df8fb3176" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2}yzi + x^{2}yj - (2xy + 2y)k" :db/id #edb/ref 17592186166462} {:answer/id #uuid "2ce24d24-00cc-5dfa-ae57-7b576ed54e17" :answer/type {:db/ident :answer.type/math} :answer/value "-xyzi - y^{2}zj + (y^{2}x + 2y)k" :db/id #edb/ref 17592186166463} {:answer/id #uuid "3375422a-0420-5431-9e77-b5991e7f6f6c" :answer/type {:db/ident :answer.type/math} :answer/value "2xyzi - x^{2}yj + (xz^{2} + 2y)k" :db/id #edb/ref 17592186166464} {:answer/id #uuid "3658104d-2b4f-5a06-af82-d41092238392" :answer/type {:db/ident :answer.type/math} :answer/value "xyzi - x^{2}j + 4z^{2}k" :db/id #edb/ref 17592186166465}] :answer-field/id #uuid "f4ee6962-d399-5885-8c69-5ff1918c56ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186166460}] :question/id #uuid "9e4d7c82-2e83-562b-b6bc-3ec6c276e93c" :question/math-academy-id "q-98947" :question/problem "For which of the following vector fields is $f(x, y, z) = x^{2}yz + z^{2}$ a potential function?"}] [{:db/id #edb/ref 17592186125