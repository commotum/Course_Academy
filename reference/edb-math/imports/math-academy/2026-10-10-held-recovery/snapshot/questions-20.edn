wer/id #uuid "f03ef271-5ed2-5a58-9af1-2d69d2cb63c4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186091836} {:answer/id #uuid "f5356043-8417-5811-bdd2-2886569f1a26" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186091837} {:answer/id #uuid "fd417f29-66e8-54e4-9574-e16db3f0021d" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186091838} {:answer/id #uuid "7b83784f-346b-51de-a2cf-71d31e2e1bd6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186091839}] :answer-field/id #uuid "96f3c57a-2f6a-5dd3-ae5e-640569225420" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091834}] :question/id #uuid "affca6e7-63d8-5fdc-9d0c-dfade651ea18" :question/math-academy-id "q-9725" :question/problem "If $k(1 - 3^{6})$ is the sum of the first $6$ terms of the geometric series $1 + 3 + 9 + ⋯$, then $k =$\n\n> A scientific calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186162717 :knowledge-point/_questions [{:knowledge-point/id #uuid "44c68619-9cf3-5dd8-b3db-00c9730d3308" :knowledge-point/title "Finding the Third Factor in the SVD of a Rectangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88817c4f-c3b9-56bc-adcd-03c60a03192d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{5}} & -\\frac{2}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}} & \\frac{1}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161565} {:answer/id #uuid "ab726398-a6bf-5ccb-8b76-7638be326bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161566} {:answer/id #uuid "b6527ce3-e389-5aaa-b56f-28b8e5cb3b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{10}} & -\\frac{3}{\\sqrt{10}} \\\\ \\frac{3}{\\sqrt{10}} & \\frac{1}{\\sqrt{10}}\\end{bmatrix}" :db/id #edb/ref 17592186161567} {:answer/id #uuid "192d7516-f9d8-5c3c-923d-9aea265083e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{bmatrix}" :db/id #edb/ref 17592186161568} {:answer/id #uuid "70c54196-2e1b-509b-a193-ae9743cdbb59" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\frac{2}{\\sqrt{5}} & -\\frac{1}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}} & \\frac{2}{\\sqrt{5}}\\end{bmatrix}" :db/id #edb/ref 17592186161569}] :answer-field/id #uuid "7b64cb77-d8a8-5314-8588-5996a0ed2a99" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186161564}] :question/id #uuid "e4c01100-25ba-535e-8cf2-008c4f230608" :question/math-academy-id "q-97364" :question/problem "$A = \\begin{bmatrix}0 & 2 \\\\ -2 & 0 \\\\ -2 & -1\\end{bmatrix}, Σ = \\begin{bmatrix}3 & 0 \\\\ 0 & 2 \\\\ 0 & 0\\end{bmatrix}$\nConsider the matrices $A$ and $Σ$ shown above. Given that $A = UΣV^{T}$ is a singular value decomposition of $A$, which of the following could be the matrix $V$?"}] [{:db/id #edb/ref 17592186234504 :knowledge-point/_questions [{:knowledge-point/id #uuid "6532d0fb-1a24-5177-bd20-2efcb3e13f3d" :knowledge-point/title "Writing a Geometric Series With a Negative Common Ratio Using Sigma Notation"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "170bd810-875c-5df1-8392-2b06cc744ef3" :question/math-academy-id "q-9755" :question/problem "The geometric series $-1+2-4+8-16+32\\,$ can be expressed using sigma notation as" :question/worked-solution "First, we must express the given series in the form\n\n$$\n{\\sum }_{n=1}^{N}{a}_{1}{r}^{n-1},\n$$\n\nwhere ${a}_{1}$ denotes the first term of the series, $r$ denotes the common ratio, and $N$ denotes the number of terms in the series. In this case, ${a}_{1}=-1$ and $N=6.$\n\nTo find $r,$ we calculate the ratio of the first two terms in the series:\n\n$$\nr=\\frac{{a}_{2}}{{a}_{1}}=\\frac{2}{-1}=-2\n$$\n\nHence, expressing the geometric series given in sigma notation, we obtain:\n\n$$\n-1+2-4+8-16+32={\\sum }_{n=1}^{6}(-1)\\cdot (-2)^{n-1}\\,\\,\n$$\n\nFinally, we can simplify the above using the laws of exponents, as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{6}(-1)\\cdot (-2)^{n-1} & ={\\sum }_{n=1}^{6}(-1)\\cdot (-2)^{n}\\cdot (-2)^{-1} \\\\  & ={\\sum }_{n=1}^{6}{2}^{-1}\\cdot (-2)^{n} \\\\  & ={\\sum }_{n=1}^{6}\\frac{1}{2}(-2)^{n}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172660 :knowledge-point/_questions [{:knowledge-point/id #uuid "17787055-19de-5dca-b1f9-e97a3a7c2aff" :knowledge-point/title "Finding the Acceleration of a Particle Moving With Circular Motion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87e74c10-6010-5050-b7c0-c210e0b4ea3e" :answer/type {:db/ident :answer.type/math} :answer/value "-6i - 6j" :db/id #edb/ref 17592186171556} {:answer/id #uuid "8824dff0-6218-523e-89ff-b9077023524b" :answer/type {:db/ident :answer.type/math} :answer/value "-12\\sqrt{3}i - 12j" :db/id #edb/ref 17592186171557} {:answer/id #uuid "9e9b3d2f-dc72-58e6-8e97-ac067586b54e" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\sqrt{3}i + \\sqrt{3}j" :db/id #edb/ref 17592186171558} {:answer/id #uuid "3b650509-030d-5225-9e1c-80dea26a5af7" :answer/type {:db/ident :answer.type/math} :answer/value "-6i" :db/id #edb/ref 17592186171559} {:answer/id #uuid "42b5db76-f8bd-593a-bb98-2597e94188ed" :answer/type {:db/ident :answer.type/math} :answer/value "-6i - 6\\sqrt{3}j" :db/id #edb/ref 17592186171560}] :answer-field/id #uuid "496df0ec-9beb-508c-969d-793cb6918805" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #ed