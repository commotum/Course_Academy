$."}] [{:db/id #edb/ref 17592186339093 :knowledge-point/_questions [{:knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41853b1b-f128-539e-ab88-ca5d59dc0e05" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,-4,5)" :db/id #edb/ref 17592186336656} {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337038} {:answer/id #uuid "c2e1c5a4-62d6-5436-af43-17c9bfc5613e" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,1,5)" :db/id #edb/ref 17592186337768} {:answer/id #uuid "c6b771d8-baa4-5b37-b891-b67f5cd45988" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,-5)" :db/id #edb/ref 17592186337799} {:answer/id #uuid "cd2de5c5-4809-5d29-8d83-1b351dad1988" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,4,-5)" :db/id #edb/ref 17592186337836}] :answer-field/correct {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337038} :answer-field/id #uuid "d289b150-0a1d-5b56-9cb1-7dfd34466e9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14b3d36d-0d61-5644-876e-58f0a854730d" :question/math-academy-id "q-72303" :question/problem "Find the saddle point of the hyperbolic paraboloid $z-5=5(x-1)^{2}-3(y+4)^{2}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z-5 & =5(x-1)^{2}-3(y+4)^{2} \\\\ z-5 & =\\frac{(x-1)^{2}}{1/5}-\\frac{(y+4)^{2}}{1/3} \\\\ z-5 & =\\frac{(x-1)^{2}}{1/5}-\\frac{(y-(-4))^{2}}{1/3}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(1,-4,5).$"}] [{:db/id #edb/ref 17592186097356 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination with Row Exchanges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be1e7bb8-9a1e-5458-a964-4b0a507198e1" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{3} & \\frac{7}{3} \\\\ 0 & 0 & 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186096031} {:answer/id #uuid "f02adf80-ad51-5b77-9de2-17a4ecf16d77" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & -\\frac{1}{2} & \\frac{1}{2} \\\\ 0 & 0 & 1 & -5\\end{bmatrix}" :db/id #edb/ref 17592186096032} {:answer/id #uuid "055acce7-97cc-5db6-81ee-578ba34b19f3" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & 2 & 7 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186096033} {:answer/id #uuid "27935cd7-d828-53cd-bfc0-5f4b23f2869f" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186096034} {:answer/id #uuid "719ae79d-13da-5b25-8d45-65e4a648f56b" :answer/type {:db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 0 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186096035}] :answer-field/id #uuid "e780d91d-a5fd-57ae-9a3e-87dfda8e42d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096030}] :question/id