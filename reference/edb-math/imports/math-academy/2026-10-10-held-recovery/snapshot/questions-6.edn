3842} {:answer/id #uuid "dcf7721d-433b-562f-8b02-6dc0eaf18ebf" :answer/type {:db/ident :answer.type/math} :answer/value "2xy - yz + 2xz" :db/id #edb/ref 17592186163843} {:answer/id #uuid "f8a59231-39be-5bd9-b000-7fd5bea7b50b" :answer/type {:db/ident :answer.type/math} :answer/value "2xy + yz + xz" :db/id #edb/ref 17592186163844} {:answer/id #uuid "0cfc1e63-d79d-5c0a-a85e-bb0f5321e73a" :answer/type {:db/ident :answer.type/math} :answer/value "2x^{2} + 3yz" :db/id #edb/ref 17592186163845}] :answer-field/id #uuid "800fbb75-73ff-5c83-b570-3144244101d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186163840}] :question/id #uuid "7492e5fe-6cc9-5d4b-8d1f-20d212147cee" :question/math-academy-id "q-160838" :question/problem "Consider the vector field $F$ and the surface $S$ with normal vector $n^(~)$, where\n\n$F(x, y, z) = ⟨z, y, x⟩, n^(~)(x, y, z) = ⟨2y,-z, 2x⟩, n = (n^(~))/(‖n^(~)‖)$.\n\nIf the flux of $F$ across $S$ with respect to $n$ is given by\n\n$∬_(S)F \\cdot dS = ∬_(S)\\frac{AAAAAAA}{\\sqrt{4x^{2} + 4y^{2} + z^{2}}}dS$\n\nwhat is the missing expression?"}]}
