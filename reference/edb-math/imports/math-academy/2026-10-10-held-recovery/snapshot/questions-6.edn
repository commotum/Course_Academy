#{[{:db/id #edb/ref 17592186060052 :knowledge-point/_questions [{:knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aac8c206-b291-573d-ae2a-74259dfb0e6b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 28,-19,-61⟩" :db/id #edb/ref 17592186056641} {:answer/id #uuid "ca53652c-eb08-5737-b6e1-44c670d816d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 18, 19,-61⟩" :db/id #edb/ref 17592186056642} {:answer/id #uuid "f956129b-c0d4-5106-85ef-d4cae79b9a85" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 28, 19,-19⟩" :db/id #edb/ref 17592186056643} {:answer/id #uuid "5c983fbc-29f4-567c-af19-bcd23d5769f0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨28,-19,-19⟩" :db/id #edb/ref 17592186056644} {:answer/id #uuid "69487641-8222-5353-80f9-06c01524c50c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨18, 19, 61⟩" :db/id #edb/ref 17592186056645}] :answer-field/id #uuid "55babe7a-df9e-5246-9069-b8e548bbfc62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056640}] :question/id #uuid "7427d773-9726-5cf6-8261-06dbd4949f9e" :question/math-academy-id "q-1405" :question/problem "Let $u = ⟨ - 3, 10, 4⟩$ and $v = ⟨4, 7, 1⟩$. Find $u \\cdot v$."}] [{:db/id #edb/ref 17592186272286 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e35ad90-2f1b-5a63-97f8-d0ee68eca5d1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269398} {:answer/id #uuid "2fde21b2-4071-56ca-975f-426d92a1cb17" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269704} {:answer/id #uuid "752357c7-c757-545e-b673-5e6aef138895" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270310} {:answer/id #uuid "9758a9f8-4285-59af-9944-c703f3e02a1f" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270604} {:answer/id #uuid "c828b14e-ea43-5244-865e-f22017cdf7a1" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186271038}] :answer-field/correct {:answer/id #uuid "2fde21b2-4071-56ca-975f-426d92a1cb17" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186269704} :answer-field/id #uuid "bbc92cb1-fc14-5bd0-a868-45afb00eeb79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271857}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34dfcc70-f55e-5b7a-a24a-4dbf1116a030" :question/math-academy-id "q-14144" :question/problem "For the polynomial $f(x)=3{x}^{8}-18{x}^{2}-33x-18,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-18,$ and its factors are $\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6,\\,\\pm 9$ and  $\\pm 18.$\n\n- The leading coefficient is $3,$ and its factors are $\\pm 1$ and $\\pm 3.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{3}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{3}, \\\\ \\pm \\frac{3}{1}, & \\pm \\frac{3}{3}, \\\\ \\pm \\frac{6}{1}, & \\pm \\frac{6}{3}, \\\\ \\pm \\frac{9}{1}, & \\pm \\frac{9}{3}, \\\\ \\pm \\frac{18}{1}, & \\pm \\frac{18}{3}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{3}, \\\\ \\pm 2, & \\pm \\frac{2}{3}, \\\\ \\pm 3, & \\pm 1, \\\\ \\pm 6, & \\pm 2, \\\\ \\pm 9, & \\pm 3, \\\\ \\pm 18, & \\pm 6.\\end{aligned}\n$$\n\nNotice that some potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{3},\\,\\pm \\frac{2}{3}\\,\\pm 1,\\,\\pm 2,\\,\\pm 3,\\,\\pm 6,\\,\\pm 9,\\,\\pm 18.\n$$\n\nThis makes a total of $16$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 8=16.$)"}] [{:db/id #edb/ref 17592186092577 :knowledge-point/_questions [{:knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b" :knowledge-point/title "Creating an Integral Expression For the Arc Length of a Polar Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9841d5a0-2d6c-5f87-a27a-f94eefabc095" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π/2}e^{θ}\\sqrt{2θ^{2} + 4θ + 1}dθ" :db/id #edb/ref 17592186089604} {:answer/id #uuid "29dd10e3-97bd-56a6-b470-31427419f7fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π/2}e^{θ}\\sqrt{4θ^{2} + 2θ + 1}dθ" :db/id #edb/ref 17592186089605} {:answer/id #uuid "33a3e6d0-52bd-58d1-a159-6de1f2c26ef9" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π/2}e^{θ}\\sqrt{θ^{2} + θ + 1}dθ" :db/id #edb/ref 17592186089606} {:answer/id #uuid "5fbdd8df-eace-5463-a068-bbed35d03037" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π/2}e^{θ}\\sqrt{2θ^{2} + 2θ + 1}dθ" :db/id #edb/ref 17592186089607} {:answer/id #uuid "64f79122-83f5-593c-b841-41de68986368" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{π/2}e^{θ}\\sqrt{2θ^{2} + 2θ + 2}dθ" :db/id #edb/ref 1759218608960