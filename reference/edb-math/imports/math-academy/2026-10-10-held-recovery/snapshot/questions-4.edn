#{[{:db/id #edb/ref 17592186060025 :knowledge-point/_questions [{:knowledge-point/id #uuid "2b2a9a1d-2d20-58cf-a1ee-bee2f4cf120d" :knowledge-point/title "Identifying Partitions of Large Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b329a959-25f6-594c-a659-8470f0f5903f" :answer/type {:db/ident :answer.type/math} :answer/value "{{2, 4, 6, …, 40}, {80, 82, 84, …, 100}}" :db/id #edb/ref 17592186056479} {:answer/id #uuid "05a12c9b-19c0-58c3-83ac-07f42792c8dc" :answer/type {:db/ident :answer.type/math} :answer/value "{{2, 4, 6, …, 40}, {20, 22, 24, …, 100}}" :db/id #edb/ref 17592186056480} {:answer/id #uuid "20c2cd8c-801d-5198-91fa-9fe0e595df2c" :answer/type {:db/ident :answer.type/math} :answer/value "{{1, 2, 3, …, 100}}" :db/id #edb/ref 17592186056481} {:answer/id #uuid "31e1b1de-9a85-5b7c-8a9b-28d6b984012e" :answer/type {:db/ident :answer.type/math} :answer/value "{{4, 6, 8, 10}, {10, 11, 12, …, 100}}" :db/id #edb/ref 17592186056482} {:answer/id #uuid "68d03eb0-1fb0-5e52-b292-125bdaf9e18b" :answer/type {:db/ident :answer.type/math} :answer/value "{{2, 4, 6, …, 40}, {42, 44, 46, …, 60}, {62, 64, 66, …, 100}}" :db/id #edb/ref 17592186056483}] :answer-field/id #uuid "098a3924-da5d-5df5-8ff6-eecd2cf23e81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056478}] :question/id #uuid "7e7b9d16-36b0-577e-a63c-c84d780d74e5" :question/math-academy-id "q-1275" :question/problem "If $Y = {2, 4, 6, …, 100}$, which collection of subsets of $Y$ is a partition of $Y$?"}] [{:db/id #edb/ref 17592186262844 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee" :knowledge-point/title "Finding a Vector That Is Parallel To a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28523b60-9c94-5e08-8811-eeb6c2c8385b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260235} {:answer/id #uuid "4f6f925d-2385-5203-beed-2ae656f27e99" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260560} {:answer/id #uuid "71ffe7bc-2035-50b5-afb6-f098f001c957" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186260878} {:answer/id #uuid "c1024317-bb4d-5e9d-b670-c092e80227c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186261584} {:answer/id #uuid "fbc3f903-0607-5523-bb23-e9a27fc580dd" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186262083}] :answer-field/correct {:answer/id #uuid "28523b60-9c94-5e08-8811-eeb6c2c8385b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260235} :answer-field/id #uuid "9e71e846-7ac8-5f2e-bf8c-340173700a84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262412}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1298261d-fd1d-57fd-8c0d-689d1739fab9" :question/math-academy-id "q-127888" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}$ of the plane, we get the normal vector $n=⟨3,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,2,-1⟩ & =0 \\\\ 3{t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & =3{t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,3{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186266031 :knowledge-point/_questions [{:knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0898b8fd-da2e-500f-8ce3-c34ca6923572" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186263088} {:answer/id #uuid "429fab3f-17cb-58c0-b3c9-7ee1d1933c38" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263595} {:answer/id #uuid "9743376c-117a-5960-8b97-417407a76d55" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264303} {:answer/id #uuid "c805007e-df66-532b-8669-753fda913301" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186264758} {:answer/id #uuid "f68881ba-3548-57a2-bbc3-5ddba686addb" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186265163}] :answer-field/correct {:answer/id #uuid "0898b8fd-da2e-500f-8ce3-c34ca6923572" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186263088} :answer-field/id #uuid "474e1ba1-97bb-58e9-8fe6-22b2427b1014" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265386}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aa034af-993c-5e1e-820e-381374e69de3" :question/math-academy-id "q-130962" :question/problem "Determine the number of pivot columns of the matrix $Q,$ given by\n\n$$\nQ=[\\begin{aligned}0 & 2 & -3 & 0 & -1 & 0 \\\\ 0 & 2 & -1 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & 0\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $Q$ to row echelon form:\n\n$$\n\\begin{aligned}Q & =[\\begin{aligned}0 & 2 & -3 & 0 & -1 & 0 \\\\ 0 & 2 & -1 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}-{R}_{1} \\\\  & ∼[\\begin{aligned}0 & 2 & -3 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & 0\\end{aligned}] & {R}_{4} & :={R}_{4}+2{R}_{3} \\\\  & ∼[\\begin{aligned}0 & 2 & -3 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $Q$ has $4$ pivots, and therefore the number of pivot columns is $4.$"}]}
