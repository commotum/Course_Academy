eld.type/radio} :db/id #edb/ref 17592186126815}] :question/id #uuid "a0d6fe0c-2d8e-592e-808b-507c87fc4991" :question/math-academy-id "q-163797" :question/problem "![](images/f0/f0ca128a0755c0419d03d119501210b4be8036ccc0148f21b0e3a3665def30d5.png)\n\nTwo point masses $A$ and $B$ are connected by a rigid, massless rod of length $10m$ that is perfectly balanced on a fulcrum, as shown above. If $B$ has mass $3kg$ and is $4m$ from the fulcrum, find the mass of $A$."}] [{:db/id #edb/ref 17592186088038 :knowledge-point/_questions [{:knowledge-point/id #uuid "7de671ee-7bba-54ce-bec2-d2d6f5569f4a" :knowledge-point/title "Writing First-Order Linear ODEs in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab721a7c-ebb0-5452-b247-5d3816198bf4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (4\\sin x)y = 1 + 3\\cos x" :db/id #edb/ref 17592186084933} {:answer/id #uuid "b319152d-c291-5494-a461-4791daa6c062" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (4\\cos x)y = 1 + 3\\sin x" :db/id #edb/ref 17592186084934} {:answer/id #uuid "c17d0099-f48a-51bc-b6bf-feeec39e8bdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (2\\sin x)y = \\frac{1 + 3\\cos x}{2}" :db/id #edb/ref 17592186084935} {:answer/id #uuid "2a507547-4026-5e0f-ae6c-972cd79efc1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + \\frac{1 + 3\\cos x}{2} = (2\\sin x)y" :db/id #edb/ref 17592186084936} {:answer/id #uuid "606289fa-36e0-57ab-b7c2-57b9dbbb4540" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + (2\\sin x)y = 1 + \\frac{3}{2}\\cos x" :db/id #edb/ref 17592186084937}] :answer-field/id #uuid "2e534d32-a3b5-5b67-a30a-d8fb0702e472" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084932}] :question/id #uuid "e5c269fd-ead8-50e4-b16e-9d9e9b4a244c" :question/math-academy-id "q-16400" :question/problem "Write the following first-order linear ODE in standard form.\n$2\\frac{dy}{dx} - 3\\cos x = 1 - 4y\\sin x$"}] [{:db/id #edb/ref 17592186284463 :knowledge-point/_questions [{:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e" :knowledge-point/title "Identifying Properties of an Elliptic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "390f4661-5a0f-5b3f-b25c-eaa8c3ef06ce" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3 \\\\ y=1\\end{aligned}" :db/id #edb/ref 17592186282197} {:answer/id #uuid "6e27f0c3-12ef-5c96-a5ea-3ba6977f8de9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}" :db/id #edb/ref 17592186282640} {:answer/id #uuid "ac7a600c-728d-58b5-a4ed-d9bf939a6bd0" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=3 \\\\ z=1\\end{aligned}" :db/id #edb/ref 17592186283187} {:answer/id #uuid "b04ade40-7746-536a-a6b3-6bb9700c6ec5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=0 \\\\ y=3\\end{aligned}" :db/id #edb/ref 17592186283219} {:answer/id #uuid "c0ce0e84-2eab-5071-9566-0c4afa412297" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=0 \\\\ z=3\\end{aligned}" :db/id #edb/ref 17592186283370}] :answer-field/correct {:answer/id #uuid "6e27f0c3-12ef-5c96-a5ea-3ba6977f8de9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}" :db/id #edb/ref 17592186282640} :answer-field/id #uuid "5bbe4e29-00c0-5dd6-8a3d-4a02a12fec6c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284092}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03b953d0-f6a1-54cc-956c-27178aec298e" :question/math-academy-id "q-164269" :question/problem "Consider the elliptic paraboloid $x=\\frac{(y-3)^{2}}{2}+\\frac{(z+1)^{2}}{6}.$ Which of the following gives its axis of symmetry, written as an intersection of two planes?" :question/worked-solution "First, we write our equation as \n\n$$\nx-0=\\frac{(y-3)^{2}}{2}+\\frac{(z-(-1))^{2}}{6}.\n$$\n\nThis gives us the equation of an elliptic paraboloid oriented along the $x$-axis that has its vertex at $(0,3,-1).$\n Since it is oriented along the $x$-axis, we conclude that its axis of symmetry is parallel to the $x$-axis.\n\nThe axis of symmetry should pass through the vertex of the paraboloid. Therefore, the equation of the axis of symmetry can be written as an intersection of two planes:\n\n$$\n{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}\n$$"}]}
