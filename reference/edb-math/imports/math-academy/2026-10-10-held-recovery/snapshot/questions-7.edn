#{[{:db/id #edb/ref 17592186172386 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d7d1683-4735-5c93-9ad1-542e987aed1d" :knowledge-point/title "Calculating a Surface of Revolution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae28bc2-f9a0-5d59-bace-6845445f5266" :answer/type {:db/ident :answer.type/math} :answer/value "2π\\displaystyle \\int_{-2}^{2}x^{4}\\sqrt{1 + 4x^{3}}dx" :db/id #edb/ref 17592186169150} {:answer/id #uuid "e84bd21c-42f3-570e-9500-c24f14ce38e2" :answer/type {:db/ident :answer.type/math} :answer/value "π\\displaystyle \\int_{-2}^{2}x^{4}\\sqrt{1 + 4x^{3}}dx" :db/id #edb/ref 17592186169151} {:answer/id #uuid "ea344160-f2e6-5a60-b449-05b530fdcad0" :answer/type {:db/ident :answer.type/math} :answer/value "2π\\displaystyle \\int_{-2}^{2}x^{4}\\sqrt{1 + 16x^{6}}dx" :db/id #edb/ref 17592186169152} {:answer/id #uuid "00df6180-a1be-57fa-83f1-d9db68dffca3" :answer/type {:db/ident :answer.type/math} :answer/value "π\\displaystyle \\int_{-2}^{2}x^{4}\\sqrt{1 + 16x^{6}}dx" :db/id #edb/ref 17592186169153} {:answer/id #uuid "297c0a53-60c2-545d-a4e9-631696e3a55e" :answer/type {:db/ident :answer.type/math} :answer/value "2π\\displaystyle \\int_{-2}^{2}x^{4}\\sqrt{1 + 4x^{6}}dx" :db/id #edb/ref 17592186169154}] :answer-field/id #uuid "dd1a3809-886e-5fc6-b6f6-9ef2ef43a75a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186169149}] :question/id #uuid "929a0232-4773-59cb-9c62-800f13322539" :question/math-academy-id "q-161095" :question/problem "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $y = x^{4}$ is rotated by $2π$ radians about the $x$-axis for $x ∈ [- 2, 2]$."}] [{:db/id #edb/ref 17592186198616 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3486150-b3c2-5faf-99d5-b42ced350996" :knowledge-point/title "Expressing Flux Over a Surface as a Repeated Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9d8774c-14c0-5481-9a1f-1c3acd63867a" :answer/type {:db/ident :answer.type/math} :answer/value "u^{2} + v^{2}" :db/id #edb/ref 17592186194298} {:answer/id #uuid "e5ce5f03-88a7-5102-bfd3-b0e4a75a4aed" :answer/type {:db/ident :answer.type/math} :answer/value "u^{2} - v^{2}" :db/id #edb/ref 17592186194299} {:answer/id #uuid "31b2be0c-93a0-5cd7-8143-0596b46129e1" :answer/type {:db/ident :answer.type/math} :answer/value "u^{2} + uv + v^{2}" :db/id #edb/ref 17592186194300} {:answer/id #uuid "6ce44ca0-320e-5c90-a723-d02a6010576d" :answer/type {:db/ident :answer.type/math} :answer/value "2uv" :db/id #edb/ref 17592186194301} {:answer/id #uuid "7423bf6e-47f3-548e-afbe-feee4e861dd1" :answer/type {:db/ident :answer.type/math} :answer/value "2(u + v)^{2}" :db/id #edb/ref 17592186194302}] :answer-field/id #uuid "5503c223-e87a-5159-abb7-434053fd7b58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194297}] :question/id #uuid "a3bcb9d3-050c-5ab9-bd2a-436465223147" :question/math-academy-id "q-161360" :question/problem "Consider the vector field $F(x, y, z) = ⟨x^{2}, y^{2}, z^{2}⟩$ and the surface $S$ defined by $z = x + y$ for $0 \\le x \\le 2$ and $0 \\le y \\le 2$. Using the parametrization $x = u$ and $y = v$, the flux of $F$ through $S$ can be expressed as\n$∬_(S)F \\cdot dS = \\displaystyle \\int_{0}^{2}\\displaystyle \\int_{0}^{2}AAAAAAAdvdu$.\nWhat is the missing expression?"}] [{:db/id #edb/ref 17592186129532 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b4a31c6-01be-5b15-88f5-9150f350e944" :knowledge-point/title "Determining the Critical Points of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9ef2524-c316-5f5c-bb17-9410d6df7855" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the plane $u = 2v$." :db/id #edb/ref 17592186126662} {:answer/id #uuid "af21f9b2-947b-5b4b-9b83-b2324aabe6c2" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the parabolic cylinder $u =-w^{2}$." :db/id #edb/ref 17592186126663} {:answer/id #uuid "b8ef1406-0abe-5cfe-bc04-7ae04a77ecf5" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the plane $u = w$." :db/id #edb/ref 17592186126664} {:answer/id #uuid "e90dd075-4fb2-51bb-9367-44b42c15619d" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the $vw -$plane." :db/id #edb/ref 17592186126665} {:answer/id #uuid "0cffeeef-f100-51b5-ac9e-aa76adbf7807" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the parabolic cylinder $u = 2w^{2}$." :db/id #edb/ref 17592186126666}] :answer-field/id #uuid "4d271abc-b1d9-5284-9062-68834149c800" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126661}] :question/id #uuid "685e989d-8721-5a8c-a4d8-0e44efe4bc9b" :question/math-academy-id "q-161819" :question/problem "Find the locations of all of the critical points of the transformation $T$, where $T$ is defined as\n\n$T: \\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}u^{2} - w^{2} \\\\ we^{u} \\\\ u - v\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186198625 :knowledge-point/_questions [{:knowledge-point/id #uuid "5a116e0d-3309-5148-a0ba-16993bc0deb7" :knowledge-point/title "Expressing Flux as a Double Integral Given a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bb4018d-fb62-5078-abdb-144bf1cffc4b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{xy}{\\sqrt{x^{2} + y^{2}}}" :db/id #edb/ref 17592186194352} {:answer/id #uuid "9d7beeef-e8c3-518a-9fc7-d7f1ca7fafa1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{\\sqrt{x^{2} + y^{2}}} - 2x" :db/id #edb/ref 17592186194353} {:answer/id #uuid "c6a78bcc-7ce0-59ce-9080-35c91fd63b10" :answer/type {:db/ident :answer.type/math} :answer/value "4x - \\frac{xy}{\\sqrt{x^{2} + y^{2}}}" :db/id #edb/ref 17592186194354} {:answer/id #uuid "51a7dbed-2bc4-5f6e-bb63-cee5076198c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{\\sqrt{x^{2} + y^{2}}}" :db/id #edb/ref 17592186194355} {:answer/id #uuid "53bf65aa-e583-54ae-a143-7475684d2d43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{xy}{\\sqrt{x^{2} + y^{2}}} - 4x" :db/id #edb/ref 17592186194356}] :answer-field/id #uuid "3e2731c8-e10c-5eb5-803a-a055c8238d8e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194351}] :question/id #uuid "74d7a79e-d57c-5768-84fc-b3ae4dae67d9" :question/math-academy-id "q-161862" :question/problem "![](images/e6/e61f3d7c23ef7876bec2f11c93974551058bcd32f28745898604926d84dbcfee.png)\n\nConsider the vector field $F = ⟨y, 0, 2x⟩$ and the closed surface $S$ that represents the boundary of the solid shown above. Let $D$ be the projection of the solid onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as\n$∬_(S)F \\cdot dS = ∬_(D)A A A A A A AdA$.\nWhich of the following could be the missing expression?"}] [{:db/id #edb/ref 17592186198626 :knowledge-point/_questions [{:knowledge-point/id #uuid "d4d69d3c-3bb7-5e99-b606-1bbd538fa1c4" :knowledge-point/title "Expressing Flux as a Double Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b44dd2e0-e203-5458-aeb5-7c6d77dc7445" :answer/type {:db/ident :answer.type/math} :answer/value "16y - 4y^{3} + 4x^{3}" :db/id #edb/ref 17592186194358} {:answer/id #uuid "e0cbba24-32e5-501a-a0de-c0837b31188d" :answer/type {:db/ident :answer.type/math} :answer/value "32y^{2} + 32x^{2} - 16y" :db/id #edb/ref 17592186194359} {:answer/id #uuid "2d717721-cdfe-56e2-92f3-b1b09144561e" :answer/type {:db/ident :answer.type/math} :answer/value "4y^{3} + 4x^{3} - 16y" :db/id #edb/ref 17592186194360} {:answer/id #uuid "3c250982-77f4-5a12-8db9-fbe353a6ab44" :answer/type {:db/ident :answer.type/math} :answer/value "128y - 32y^{3} + 8x" :db/id #edb/ref 17592186194361} {:answer/id #uuid "492022cf-56fd-555a-9f07-39416e947012" :answer/type {:db/ident :answer.type/math} :answer/value "128y - 32y^{3} - 8x" :db/id #edb/ref 17592186194362}] :answer-field/id #uuid "53b41d22-617b-5e32-a579-ee8eb82b603d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186194357}] :question/id #uuid "87ce70cc-a7a3-5bf0-ac23-45c7dbb8a56d" :question/math-academy-id "q-161863" :question/problem "Consider the vector field $F = ⟨1, z, 0⟩$ and the closed surface $S$ that encloses the finite region between the parabolic cylinders $z = 4x^{2}$ and $z = 16 - 4y^{2}$. Let $D$ be the projection of $S$ onto the $xy$-plane. The flux of $F$ across $S$ can be expressed in terms of a double integral as\n$∬_(S)F \\cdot dS = ∬_(D)A A A A A A AdA$.\nWhich of the following could be the missing expression?"}] [{:db/id #edb/ref 17592186134137 :knowledge-point/_questions [{:knowledge-point/id #uuid "8f0629bb-3a37-5ab8-8449-50789b295c7a" :knowledge-point/title "Evaluating a Line Integral Using Stokes' Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89def526-2f68-5214-92a5-30cfa9986621" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{1}4 x 3 + 4 x y 2 - 40 xdydx" :db/id #edb/ref 17592186130949} {:answer/id #uuid "b93aa029-cebb-504c-9cf0-03532112bd4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{1 - x}4 x 3 + 4 x y 2 - 40 xdydx" :db/id #edb/ref 17592186130950} {:answer/id #uuid "eeea64cd-f2a9-50a4-92af-3714133868f5" :answer/type {:db/ident :answer.type/math} :answer/value "\\displaystyle \\int_{0}^{1}\\displaystyle \\int_{0}^{x}20 - 4 x 2 + 4 y 2dydx" :db/id #edb/ref 17592186130951} {:answer/id #uuid "2b0fd797-ddad-5d2d-8cb6-6b915ac