\\ 0 & 5\\end{bmatrix}" :db/id #edb/ref 17592186173954} {:answer/id #uuid "630640de-9b44-58f4-8e25-0e4846352175" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186173955}] :answer-field/id #uuid "4d2bdeed-ef33-5ca7-99f5-44a7957a7472" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173950}] :question/id #uuid "7f458812-6145-5d6d-87ea-ffca6f06ff2c" :question/math-academy-id "q-112448" :question/problem "Find the Jordan canonical form of the matrix\n$A = \\begin{bmatrix}-5 & 0 \\\\ 0 & -5\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186233202 :knowledge-point/_questions [{:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4385816f-7b9c-5f55-bc1f-96c9f8bc0f20" :question/math-academy-id "q-113927" :question/problem "What is ${\\int }_{0}^{2}{e}^{x}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-0}{n}=\\frac{2}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{2k}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{e}^{2k/n}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186054973 :knowledge-point/_questions [{:knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051339} {:answer/id #uuid "df503ec5-393a-5e2d-b982-c56e35aaa181" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051340} {:answer/id #uuid "03de6fb6-f81c-5d37-a647-7b5873b78089" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186051341} {:answer/id #uuid "423881fd-5f5f-52b5-95c3-bdb632772bba" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186051342} {:answer/id #uuid "4cb4b1ee-1844-5475-bfe1-7abebf91b3b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186051343}] :answer-field/id #uuid "8876c980-9b7f-5aa5-b5a7-7c5722252f32" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051338}] :question/id #uuid "06528850-f3e1-5360-9392-bba2a3bf7deb" :question/math-academy-id "q-11440" :question/problem "Calculate $A + B$, where\n$A = \\begin{bmatrix}2 & 5 \\\\ 3 & 1\\end{bmatrix}, B = \\begin{bmatrix}4 & 1 \\\\ -2 & 2\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186096980 :knowledge-point/_questions [{:knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answe