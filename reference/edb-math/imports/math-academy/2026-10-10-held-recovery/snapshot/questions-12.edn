nt/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2842cc73-0f01-58d5-b5f8-0139583e8db8" :answer/type {:db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186321467} {:answer/id #uuid "2de3d6aa-490c-5cae-a784-6e667b895471" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186321512} {:answer/id #uuid "a00a0949-433b-5624-94b0-a6603a842920" :answer/type {:db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186322418} {:answer/id #uuid "a251689c-7067-57e5-bcb5-7bc51fb827e3" :answer/type {:db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186322434} {:answer/id #uuid "b425d295-6b7a-560e-97ee-8069726e7fc1" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322561}] :answer-field/correct {:answer/id #uuid "b425d295-6b7a-560e-97ee-8069726e7fc1" :answer/type {:db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322561} :answer-field/id #uuid "bad8f0e9-eadc-541a-b41e-da64a5a6afcc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ed660c39-3116-519a-a531-99463ad097b8" :question/math-academy-id "q-35833" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{4{x}^{2}-9x+1}{x+4}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{4{x}^{2}-9x+1}{x+4} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{4{x}^{2}}{x}-\\frac{9x}{x}+\\frac{1}{x})}{(\\frac{x}{x}+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+\\frac{1}{x})}{(1+\\frac{4}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(4x-9+0)}{(1+0)} \\\\  & ={lim}_{x\\to \\infty }(4x)-9 \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186124931 :knowledge-point/_questions [{:knowledge-point/id #uuid "4821de45-1b6b-5b4f-be0e-96cf5395bc8d" :knowledge-point/title "Calculating a State Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5825d08-86a3-50d7-8984-8f2cd8d0faf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.393 \\\\ 0.607\\end{bmatrix}" :db/id #edb/ref 17592186122157} {:answer/id #uuid "f9ad3b9e-20a5-5b74-9a37-9df7886cff6f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.413 \\\\ 0.587\\end{bmatrix}" :db/id #edb/ref 17592186122158} {:answer/id #uuid "2f7fb7ea-e2b3-5992-9bf6-e41c09e0cbb2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.611 \\\\ 0.389\\end{bmatrix}" :db/id #edb/ref 17592186122159} {:answer/id #uuid "491996ac-bf8d-5eee-a987-0588261d1f8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.442 \\\\ 0.558\\end{bmatrix}" :db/id #edb/ref 17592186122160} {:answer/id #uuid "7b9686e5-79d6-5616-8acb-0e5b13b9ae3f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0.526 \\\\ 0.474\\end{bmatrix}" :db/id #edb/ref 17592186122161}] :answer-field/id #uuid "98df5681-9ccd-5b69-82eb-39e17040c2c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122156}] :question/id #uuid "f3da8136-058f-5b0b-abbd-f2c6d4a902e8" :question/math-academy-id "q-35846" :question/problem "$P = \\begin{bmatrix}0.2 & 0.5 \\\\ 0.8 & 0.5\\end{bmatrix}, x_{0} = \\begin{bmatrix}0.7 \\\\ 0.3\\end{bmatrix}$\n\nConsider a Markov chain with t