#{[{:db/id #edb/ref 17592186268892 :knowledge-point/_questions [{:knowledge-point/id #uuid "4c5685f7-71b2-58ae-8c61-f555b355d92f" :knowledge-point/title "Finding the Equation of the Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b49c0a3-842a-5e4f-8c9f-bcdacd6482db" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=2 \\\\ z=x+2\\pi \\end{aligned}" :db/id #edb/ref 17592186266531} {:answer/id #uuid "3fa233f4-64d9-5e7c-9bf4-5d6de3431a95" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=2 \\\\ z=2x-2\\pi \\end{aligned}" :db/id #edb/ref 17592186266724} {:answer/id #uuid "5722d450-4de6-5584-a7a4-4c5a28d785ea" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=2 \\\\ z=-2x+\\pi \\end{aligned}" :db/id #edb/ref 17592186266924} {:answer/id #uuid "8af7c44c-aec2-5a26-b0b4-846d06ad93e5" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=2 \\\\ z=x-\\pi \\end{aligned}" :db/id #edb/ref 17592186267395} {:answer/id #uuid "c8f58a5e-b636-567f-a4e0-4e5efca66f70" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=2 \\\\ z=-2x-\\frac{\\pi }{2}\\end{aligned}" :db/id #edb/ref 17592186267951}] :answer-field/correct {:answer/id #uuid "5722d450-4de6-5584-a7a4-4c5a28d785ea" :answer/type {:db/ident :answer.type/math} :answer/value "{\\begin{aligned}y=2 \\\\ z=-2x+\\pi \\end{aligned}" :db/id #edb/ref 17592186266924} :answer-field/id #uuid "2a7709cb-f264-5087-8141-9df67bddfa9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268481}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "90718d28-70a4-5587-a36e-fa57ec8d26d4" :question/math-academy-id "q-132590" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=2.$ Given that the point $P(-\\frac{\\pi }{2},2,2\\pi )$ lies on $C$, and that ${f}_{x}=\\operatorname{sin}⁡x+\\frac{xy}{\\pi }$, find the equations of the tangent line to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=2.$ Hence, the slope of the tangent to the curve at the point $P(-\\frac{\\pi }{2},2,2\\pi )$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(-\\pi /2,2)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(-\\frac{\\pi }{2},2):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x}{|}_{(-\\pi /2,2)} & =\\operatorname{sin}⁡(-\\frac{\\pi }{2})+\\frac{(-\\frac{\\pi }{2})(2)}{\\pi } \\\\  & =-1-1 \\\\  & =-2\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(-\\pi /2,2)} & =\\frac{∂z}{∂x}{|}_{(-\\pi /2,2)}(x-(-\\frac{\\pi }{2})) \\\\ z-2\\pi  & =-2(x+\\frac{\\pi }{2}) \\\\ z & =-2x+\\pi \\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(-\\frac{\\pi }{2},2,2\\pi )$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}y=2 \\\\ z=-2x+\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101137 :knowledge-point/_questions [{:knowledge-point/id #uuid "16e62b0e-adda-5d35-aeb9-961057dce8f0" :knowledge-point/title "Calculating the Sum or Difference of Three or More Matrices Using Distributivity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d0d5b8b-4428-5073-8c81-ebd4d03f5e11" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 2 \\\\ 2 & 3\\end{bmatrix}" :db/id #edb/ref 17592186098128} {:answer/id #uuid "04d70404-4b26-53f0-9c5c-5e44fe5b9647" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098129} {:answer/id #uuid "39e8426c-e203-5fdf-a93f-111238c8159f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bma