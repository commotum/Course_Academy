594c2-8b13-5743-9418-00ca234bb530" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & -5 & -1 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186130799} {:answer/id #uuid "c5c59f9d-b512-54e7-9cb1-7c7e2fe4dae6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -1 & 0 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186130800} {:answer/id #uuid "d83d477f-73fa-5372-b7a8-321ce9811cd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 \\\\ -5 \\\\ -1 \\\\ 1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186130801} {:answer/id #uuid "f1374cf2-7b4c-577f-9f53-fda2e786227d" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 \\\\ -1 \\\\ 0 \\\\ 1 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186130802} {:answer/id #uuid "19f0bcaf-a2eb-5f63-bfcc-39ae986682d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 1 & 1 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186130803}] :answer-field/id #uuid "47431566-66ec-59a7-a8b0-d58094c893d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130798}] :question/id #uuid "07c1a1e5-eac4-585d-8460-669cc1e39819" :question/math-academy-id "q-139517" :question/problem "| $x$ | **$-2$** | **$-1$** | **$0$** | **$1$** | **$2$** |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| $y$ | $-6$ | $-5$ | $-1$ | $1$ | $1$ |\n\nThe vector of coefficients of the line $y = β_{0} + β_{1}x$ that best fits the data above can be found using linear regression as\n\n$\\begin{bmatrix}β_{0} \\\\ β_{1}\\end{bmatrix} = (X^{T}X)^{-1}X^{T}y$,\n\nwhere $X$ is the corresponding design matrix and $y$ is the observation vector. Which of the following is the observation vector $y$ in this context?"}] [{:db/id #edb/ref 17592186134117 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd286741-bf82-5723-a9c1-acf7a8b238c2" :knowledge-point/title "Finding a Least-Squares Regression Line in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "979c5af4-9964-538b-b144-532063ca3f7b" :answer/type {:db/ident :answer.type/text} :answer/value "$8$ feet" :db/id #edb/ref 17592186130829} {:answer/id #uuid "d9d790f1-d20b-5c8a-bbc1-23c707806914" :answer/type {:db/ident :answer.type/text} :answer/value "$9$ feet" :db/id #edb/ref 17592186130830} {:answer/id #uuid "2cf336cd-ac26-5998-9be3-a638605f8e3f" :answer/type {:db/ident :answer.type/text} :answer/value "$8.5$ feet" :db/id #edb/ref 17592186130831} {:answer/id #uuid "64aa2687-8d50-568b-9155-b17f093ad1c8" :answer/type {:db/ident :answer.type/text} :answer/value "$9.5$ feet" :db/id #edb/ref 17592186130832} {:answer/id #uuid "7d17029a-45a5-5838-89f1-19c40f3f3fb9" :answer/type {:db/ident :answer.type/text} :answer/value "$7.5$ feet" :db/id #edb/ref 17592186130833}] :answer-field/id #uuid "bb67d2ca-15d7-5506-b1d1-9f75b40c28f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130828}] :question/id #uuid "8f426df0-1f38-5a2e-b701-5e427a0357ac" :question/math-academy-id "q-139750" :question/problem "A biologist has recorded data on a pine tree's age (in years) and height (in feet). This data is shown below.\n\n| Age $(x)$ | **$1$** | **$2$** | **$3$** | **$4$** |\n| --- | ---: | ---: | ---: | ---: |\n| Height $(y)$ | $1.2$ | $2.5$ | $3.6$ | $4.5$ |\n\nFind the line of the form $y = β_{0} + β_{1}x$ that best fits the data above. According to the model, what will be the tree's height after $8$ years, assuming the trend continues?\n\n*Hint: You can use the fact that*\n$(X^{T}X)^{-1} = \\frac{1}{10}\\begin{bmatrix}15 & -5 \\\\ -5 & 2\\end{bmatrix}, X^{T}y = \\begin{bmatrix}11.8 \\\\ 35\\end{bmatrix}$,\n*where $X$ is the corresponding design matrix and $y$ is the observation vector.*\n\n> A calculator is required to answer this question." :question/requires-calculator true}]}
