#{[{:db/id #edb/ref 17592186176505 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "808c8f3d-93e7-599a-a6d0-425650200bc2" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{3}{2}, ∞)" :db/id #edb/ref 17592186175139} {:answer/id #uuid "db1dd33b-e016-5116-aec2-6632f88be070" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 2)$ and $(3, ∞)$" :db/id #edb/ref 17592186175140} {:answer/id #uuid "f6938bc7-5ce8-53a8-aa58-ed003e23859e" :answer/type {:db/ident :answer.type/math} :answer/value "(0, \\frac{7}{2})" :db/id #edb/ref 17592186175141} {:answer/id #uuid "fd749b77-a715-5978-94b8-7eb25671717b" :answer/type {:db/ident :answer.type/math} :answer/value "(0, \\frac{5}{3})" :db/id #edb/ref 17592186175142} {:answer/id #uuid "239e3522-01f2-5fe1-8fad-d3d7d96ff819" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 1)$ and $(5, ∞)$" :db/id #edb/ref 17592186175143}] :answer-field/id #uuid "5d0e2f1f-4609-5672-adf9-8aef0c1741d8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175138}] :question/id #uuid "2e226491-3c89-5e59-9e2d-888677b66097" :question/math-academy-id "q-48909" :question/problem "The displacement $s$, in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t) = (3t - 5)^{2}$, where $t > 0$ is the time measured in seconds. Determine the time intervals in which the particle is moving in the direction of decreasing $x$."}] [{:db/id #edb/ref 17592186097270 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3914744-78d7-5f81-a7cc-6b7dad39b652" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(n → ∞)∑_(i = 0)^(n - 1)[2(3 + \\frac{3i}{n})^{2} \\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186095515} {:answer/id #uuid "db0455f0-0eef-55f0-8e1e-d8b2f4284e6d" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(n → ∞)∑_(i = 0)^(n - 1)[2(3 + \\frac{i}{n})^{2} \\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186095516} {:answer/id #uuid "fbd52476-8e44-517e-a4f9-38bbca19b38b" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(n → ∞)∑_(i = 0)^(n - 1)[2(1 + \\frac{i}{n})^{2} \\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186095517} {:answer/id #uuid "122047d6-85a2-5dd3-b101-d8f8f899fdaf" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(n → ∞)∑_(i = 0)^(n - 1)[2(1 + \\frac{4i}{n})^{2} \\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186095518} {:answer/id #uuid "6fe104ef-06dc-527d-a6e9-6f2051ab188c" :answer/type {:db/ident :answer.type/math} :answer/value "lim_(n → ∞)∑_(i = 0)^(n - 1)[2(3 + \\frac{i}{n})^{2} \\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186095519}] :answer-field/id #uuid "b60039da-5294-5a58-a26c-daeb347b0fe7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186095514}] :question/id #uuid "9b0d7120-9669-5715-9447-51eb9dde3961" :question/math-academy-id "q-49179" :question/problem "What is $\\displaystyle \\int_{3}^{4}2x^{2}dx$ expressed as the limit of a left Riemann sum?"}] [{:db/id #edb/ref 17592186234113 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70db0eed-102a-5697-8d3f-891b9c2d06b3" :question/math-academy-id "q-49189" :question/problem "What is ${\\int }_{1}^{2}{x}^{2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx,\n$$\n\n \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{l}=a+lΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{2}{x}^{2}\\text{d}x,\n$$\n\nthe function is $f(x)={x}^{2},$ the lower bound is $a=1,$ and the upper bound is $b=2.$ So, we have\n\n$$\nΔx=\\frac{2-1}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}f({x}_{l})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+l\\cdot \\frac{1}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[f(1+\\frac{l}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[{(1+\\frac{l}{n})}^{2}\\cdot \\frac{1}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069405 :knowledge-point/_questions [{:knowledge-point/id #uuid "d2a41ede-381e-55f6-99e5-1baf1ea348a1" :knowledge-point/title "Computing the Integral of a Trigonometric Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e43000d-d261-55a5-a180-481002f03d85" :answer/type {:db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + 2\\intx\\cos (2x)dx" :db/id #edb/ref 17592186067571} {:answer/id #uuid "90d63a70-4815-58be-9c3d-baa0abafe498" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos (2x) - 2\\intx\\sin (2x)dx" :db/id #edb/ref 17592186067572} {:answer/id #uuid "9cd2a0e1-16c6-58ee-8c30-0ba6e9a6fce2" :answer/type {:db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + \\intx\\sin (2x)dx" :db/id #edb/ref 17592186067573} {:answer/id #uuid "59d49b1a-803b-53d8-83fa-db70c7789e5c" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos (2x) + \\intx\\cos (2x)dx" :db/id #edb/ref 17592186067574} {:answer/id #uuid "7f31ebb