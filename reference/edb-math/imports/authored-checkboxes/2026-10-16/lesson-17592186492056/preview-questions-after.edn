99 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573987} {:answer/id #uuid "a1710105-4951-5d1f-b992-6c3f9c479587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186573988}] :answer-field/correct {:answer/id #uuid "353bc1c0-2f53-5a5a-b94b-3857873ea7ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573987} :answer-field/id #uuid "1ac18f23-f1b4-53a4-97f4-4e3f6c111735" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186573997}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d18683e-9cdc-5535-b6a1-ea077ac9eff1" :question/math-academy-id "q-288426" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $4x+2=4x+2$\n\n- **II.** $-2x-1=-2x-1$\n\n- **III.** $3x+5=3x+9$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}4x+2 & =4x+2 \\\\ 4x+2-4x & =4x+2-4x \\\\ 2 & =2.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $4x+2=4x+2$ has infinitely many solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}-2x-1 & =-2x-1 \\\\ -2x-1+2x & =-2x-1+2x \\\\ -1 & =-1.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $-2x-1=-2x-1$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}3x+5 & =3x+9 \\\\ 3x+5-3x & =3x+9-3x \\\\ 5 & =9.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"I and II only.\""} {:db/id #edb/ref 17592186492056 :knowledge-point/_questions [{:db/id #edb/ref 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1790b83e-7780-5313-99ea-bb10de434617" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573989} {:answer/id #uuid "82dbfad8-bf35-55fb-ad22-e76e4b8b9a02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186573990}] :answer-field/correct {:answer/id #uuid "82dbfad8-bf35-55fb-ad22-e76e4b8b9a02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186573990} :answer-field/id #uuid "b55fd536-3e0e-59f4-8009-976c5f1cf687" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186573998} {:answer-field/choices [{:answer/id #uuid "1dbf8499-dbd8-5276-8885-6ffc17db9e0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573991} {:answer/id #uuid "9391c5a4-49f5-5ee7-b2da-d0bcc995e755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186573992}] :answer-field/correct {:answer/id #uuid "1dbf8499-dbd8-5276-8885-6ffc17db9e0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573991} :answer-field/id #uuid "dc5ce64c-31e3-5628-893b-4fd625aaba14" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186573999} {:answer-field/choices [{:answer/id #uuid "5108105d-89e2-5b5d-b37e-96caf1ff54ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573993} {:answer/id #uuid "5b4e9391-098c-5fb1-b6c3-acfba8e404d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186573994}] :answer-field/correct {:answer/id #uuid "5108105d-89e2-5b5d-b37e-96caf1ff54ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186573993} :answer-field/id #uuid "df8ab297-c513-5d93-9250-0c73f1d09739" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cc8f5f5a-7e03-528b-a06c-bf3c3858a8c1" :question/math-academy-id "q-288431" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $3x+4=3x+4$\n\n- **II.** $x-5=x-2$\n\n- **III.** $2x+3=x+3$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x+4 & =3x+4 \\\\ 3x+4-3x & =3x+4-3x \\\\ 4 & =4.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $3x+4=3x+4$ has infinitely many solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}x-5 & =x-2 \\\\ x-5-x & =x-2-x \\\\ -5 & =-2.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}2x+3 & =x+3 \\\\ 2x+3-x & =x+3-x \\\\ x+3 & =3 \\\\ x+3-3 & =3-3 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation $2x+3=x+3$ has the unique solution $x=0.$\n\nTherefore, the correct answer is \"I only.\""}]
