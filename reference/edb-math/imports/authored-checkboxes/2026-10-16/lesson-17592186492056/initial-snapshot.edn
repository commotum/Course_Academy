{"database" "math" "lineage" "01a12a15-3e0a-75a1-9dac-f8b8c5d5c3f1" "basis" 3146 "seed" [[{:db/id 17592186492056 :knowledge-point/_questions [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "122da567-888b-521d-ab93-2bdadd7b97a5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186491491} {:answer/id #uuid "2c757179-64e0-523b-afeb-d5bc0ad04d2e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186491543} {:answer/id #uuid "93ecc79a-c63b-50da-a503-9b6d8ce7074b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186491705} {:answer/id #uuid "ab75275b-5761-5361-ae34-c628459ca7b2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186491752} {:answer/id #uuid "cfb65399-285a-555c-b2e6-5f5e24676387" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186491807}] :answer-field/correct {:answer/id #uuid "2c757179-64e0-523b-afeb-d5bc0ad04d2e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186491543} :answer-field/id #uuid "884fd6c3-8303-53d8-9178-3d82c6fc0a29" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186491937}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cc8f5f5a-7e03-528b-a06c-bf3c3858a8c1" :question/math-academy-id "q-288431" :question/problem "Which of the following equations has infinitely many solutions?\n\nI. $3x+4=3x+4$\n\nII. $x-5=x-2$\n\nIII. $2x+3=x+3$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x+4 & =3x+4 \\\\ 3x+4-3x & =3x+4-3x \\\\ 4 & =4.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $3x+4=3x+4$ has infinitely many solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}x-5 & =x-2 \\\\ x-5-x & =x-2-x \\\\ -5 & =-2.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}2x+3 & =x+3 \\\\ 2x+3-x & =x+3-x \\\\ x+3 & =3 \\\\ x+3-3 & =3-3 \\\\ x & =0.\\end{aligned}\n$$\n\nTherefore, the equation $2x+3=x+3$ has the unique solution $x=0.$\n\nTherefore, the correct answer is \"I only.\""}]] "scope" [[{:db/id 17592186049310 :topic/difficulty 0.7310479111284743 :topic/id #uuid "eb6655db-68e9-5ef3-bf7a-81223e92dac0" :topic/knowledge-points [{:db/id 17592186110719 :knowledge-point/canonical-example {:db/id 17592186110372} :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/key-prerequisites [{:db/id 17592186048213}] :knowledge-point/question-generator {:db/id 17592186476103} :knowledge-point/questions [{:db/id 17592186111133} {:db/id 17592186111138} {:db/id 17592186297181} {:db/id 17592186297182} {:db/id 17592186297196} {:db/id 17592186492000} {:db/id 17592186492056}] :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"} {:db/id 17592186110720 :knowledge-point/canonical-example {:db/id 17592186110368} :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/question-generator {:db/id 17592186476197} :knowledge-point/questions [{:db/id 17592186111134} {:db/id 17592186111135} {:db/id 17592186297170} {:db/id 17592186297183} {:db/id 17592186297184} {:db/id 17592186476179} {:db/id 17592186476183} {:db/id 17592186476185} {:db/id 17592186476189} {:db/id 17592186476193} {:db/id 17592186491998} {:db/id 17592186549009} {:db/id 17592186549054} {:db/id 17592186553489} {:db/id 17592186555761}] :knowledge-point/title "Solving For an Unknown Parameter"} {:db/id 17592186110721 :knowledge-point/canonical-example {:db/id 17592186110371} :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/question-generator {:db/id 17592186477026} :knowledge-point/questions [{:db/id 17592186111136} {:db/id 17592186111137} {:db/id 17592186297194} {:db/id 17592186297195} {:db/id 17592186297198} {:db/id 17592186297199} {:db/id 17592186297200} {:db/id 17592186477006} {:db/id 17592186477007} {:db/id 17592186477016} {:db/id 17592186477018} {:db/id 17592186477021} {:db/id 17592186492013}] :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :topic/math-academy-id 1414 :topic/next [{:db/id 17592186048134} {:db/id 17592186048576} {:db/id 17592186050055} {:db/id 17592186050240} {:db/id 17592186050981}] :topic/title "Linear Equations With Infinitely Many Solutions"}]] "questions" [[{:db/id 17592186110368 :knowledge-point/_canonical-example [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/id #uuid "4a8f8deb-2ff1-56d2-888a-3e51eb805bc4" :question/math-academy-id "e-17212" :question/problem "Consider the equation\n\n$$\n(5s + 4)x = 9x\n$$\n\nwhere $s$ is a constant. Given that this equation has infinitely many solutions, what is the value of $s?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax = bx\n$$\n\nwhere $a$ and $b$ are constants. If $a = b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax = bx.$ In this case, \n\n$$\na = 5s + 4, \\qquad b = 9.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n5s + 4 = 9.\n$$\n\nSolving this for $s,$ we get\n\n$$\n\\begin{aligned}5s & =5 \\\\ s & =1.\\end{aligned}\n$$"}] [{:db/id 17592186110371 :knowledge-point/_canonical-example [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/id #uuid "6eeec12a-5da8-5113-916a-58f4ca807207" :question/math-academy-id "e-18852" :question/problem "Consider the equation\n\n$$\n(k+4)x + 3r = 6x + 12\n$$\n\nwhere $k$ and $r$ are constants. Given that this equation has infinitely many solutions, what is the value of $k+r?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax + b = cx + d\n$$\n\nwhere $a, b, c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na = c\\quad \\text{and}\\quad b = d.\n$$\n\nTo determine the values of $k$ and $r$ such that the equation\n\n$$\n(k+4)x + 3r = 6x + 12\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nk + 4 = 6.\n$$\n\nSolving this equation for $k,$ we get\n\n$$\n\\begin{aligned}k & =2.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n3r = 12.\n$$\n\nSolving this equation for $r,$ we get\n\n$$\n\\begin{aligned}r & =4.\\end{aligned}\n$$\n\nFinally, since $k = 2$ and $r = 4,$ we have\n\n$$\nk + r = 2+4 = 6.\n$$"}] [{:db/id 17592186110372 :knowledge-point/_canonical-example [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/id #uuid "6355ac1e-bb4d-5133-9917-04dfb2bc5a0d" :question/math-academy-id "e-18854" :question/problem "Which of the following equations has infinitely many solutions?\n\nI. $4x + 1 = 4x + 1$\n\nII. $-3x = -4x + 6$\n\nIII. $2x + 7 = 2x - 1$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}4x+1 & =4x+1 \\\\ 4x+1-4x & =4x+1-4x \\\\ 1 & =1.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $4x + 1 = 4x + 1$ has infinitely many solutions.\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}-3x & =-4x+6 \\\\ -3x+4x & =-4x+6+4x \\\\ x & =6.\\end{aligned}\n$$\n\nTherefore, the equation $-3x = -4x + 6$ has the unique solution $x = 6.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}2x+7 & =2x-1 \\\\ 2x+7-2x & =2x-1-2x \\\\ 7 & =-1.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186111133 :knowledge-point/_questions [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ec6698b-966d-5e31-b760-5faeba4367be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438040} {:answer/id #uuid "ce68107b-c73c-5910-8bb8-b2dd40c29da8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438041}] :answer-field/correct {:answer/id #uuid "5ec6698b-966d-5e31-b760-5faeba4367be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438040} :answer-field/id #uuid "15760992-2dd2-5d43-b2a8-1b987c48791a" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439049} {:answer-field/choices [{:answer/id #uuid "c5f4a2b7-9944-5e1c-9ff0-88248a565319" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438042} {:answer/id #uuid "46c6e30e-5409-5621-86de-fccef2076faa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438043}] :answer-field/correct {:answer/id #uuid "46c6e30e-5409-5621-86de-fccef2076faa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438043} :answer-field/id #uuid "73a78852-4a44-54f0-a170-8df3bd3710e3" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439050} {:answer-field/choices [{:answer/id #uuid "95fb5bb7-a16c-591d-9bc5-3cc80a4f1c75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438044} {:answer/id #uuid "40143427-1f60-591b-865b-52bd73399fa8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438045}] :answer-field/correct {:answer/id #uuid "95fb5bb7-a16c-591d-9bc5-3cc80a4f1c75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438044} :answer-field/id #uuid "f7b0dbf4-aa8c-5f41-bd3d-257a796c46ed" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439051}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71c3d793-6b55-5392-ac94-1149b022497f" :question/math-academy-id "q-287966" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $2x=x+1$\n- **II.** $2x+1=2x+1$\n- **III.** $2x+1=2x+3$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}2x & =x+1 \\\\ 2x-x & =x+1-x \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the equation $2x=x+1$ has the unique solution $x=1.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}2x+1 & =2x+1 \\\\ 2x+1-2x & =2x+1-2x \\\\ 1 & =1.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $2x+1=2x+1$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}2x+1 & =2x+3 \\\\ 2x+1-2x & =2x+3-2x \\\\ 1 & =3.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186111134 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id 17592186295403} {:answer/id #uuid "5f7c70a7-d1b8-56a0-9961-6101a0fea82a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id 17592186295813} {:answer/id #uuid "89099718-058c-53aa-ac2e-3dc7b59c4b5b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id 17592186296004} {:answer/id #uuid "a1cb3a02-6977-565b-8c6f-64a04e91a8d4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186296129} {:answer/id #uuid "fcf45a98-a317-5ebe-a0ee-d58863e54e01" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186296613}] :answer-field/correct {:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id 17592186295403} :answer-field/id #uuid "78f9540e-726b-5906-87cd-68bbcee4ccc9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296880}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "573bc8f1-012d-5d7e-834a-c6ec17bb0b63" :question/math-academy-id "q-287970" :question/problem "Consider the equation\n\n$$\n2px=3x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=2p,\\,b=3.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n2p=3.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=\\frac{3}{2}.\n$$"}] [{:db/id 17592186111135 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14a449b2-0875-581b-a2ec-8813a227c1de" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186295383} {:answer/id #uuid "2d6f283f-3592-5248-baf7-ca782b7d8c9d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id 17592186295530} {:answer/id #uuid "4009ef03-e229-5324-9dbd-214305b60cd3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id 17592186295633} {:answer/id #uuid "4dfca85a-c698-5e36-ba67-02a55f783f85" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186295715} {:answer/id #uuid "d199324f-9733-59f2-82cf-8e4f45ae01ff" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186296371}] :answer-field/correct {:answer/id #uuid "14a449b2-0875-581b-a2ec-8813a227c1de" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186295383} :answer-field/id #uuid "1739b830-13d4-586f-9761-4372557e83e6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296679}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "435ae769-5577-5924-a2b3-9f23f7e0ccc8" :question/math-academy-id "q-287971" :question/problem "Consider the equation\n\n$$\n(p-3)x=4x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=p-3,\\,b=4.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\np-3=4.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=7.\n$$"}] [{:db/id 17592186111136 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2918787-6369-5281-b839-56303be60818" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186108557} {:answer/id #uuid "d22c7204-b52f-5b6a-ad06-733bfdfad3e0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186108558} {:answer/id #uuid "e529c4c3-c68a-5582-8d90-3a6410fd1ff0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id 17592186108559} {:answer/id #uuid "074e8b23-4661-5096-bb58-43d425517222" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186108560} {:answer/id #uuid "558a10b7-3a92-55d7-9829-746619fff524" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186108561}] :answer-field/id #uuid "c9db9fdf-89d7-5da6-8efa-fb1d0de77d4e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186108556}] :question/id #uuid "46a7b671-3423-5c64-a7e7-5db3d2823ec3" :question/math-academy-id "q-287978" :question/problem "Consider the equation\n$(p - 3)x + q = 4x + 1$\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p + q$?"}] [{:db/id 17592186111137 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/id #uuid "e1aa3a94-3d74-527f-9f2b-4344ff0ea098" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186108562}] :question/id #uuid "680bddd9-26ae-52c5-946c-8e72aafff50a" :question/math-academy-id "q-287985" :question/problem "Consider the equation\n$(p - 5)x + 2q = 2x + 6$\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p + q$?$p + q =$\n{{field-1}}"}] [{:db/id 17592186111138 :knowledge-point/_questions [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "801c1341-5837-5b3c-bdca-f820a9ee8871" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438076} {:answer/id #uuid "48e9078a-e6f9-59fb-af05-9029d3a48e04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438077}] :answer-field/correct {:answer/id #uuid "801c1341-5837-5b3c-bdca-f820a9ee8871" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438076} :answer-field/id #uuid "e865206f-261e-52b1-ae6e-68e8b33c31b3" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439067} {:answer-field/choices [{:answer/id #uuid "1d05df7f-dec5-59ce-b63b-c00fa9f8a672" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438078} {:answer/id #uuid "36e2ee78-8b01-5053-aa94-5d0e687cddc5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438079}] :answer-field/correct {:answer/id #uuid "36e2ee78-8b01-5053-aa94-5d0e687cddc5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438079} :answer-field/id #uuid "e502be4e-9bbd-5dbb-bb41-0769be49d17b" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439068} {:answer-field/choices [{:answer/id #uuid "a8ec9a73-6fbc-5213-bad0-073cc49fb549" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438080} {:answer/id #uuid "29a60663-a01a-5898-a8b1-97b46dadd573" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438081}] :answer-field/correct {:answer/id #uuid "a8ec9a73-6fbc-5213-bad0-073cc49fb549" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438080} :answer-field/id #uuid "5bcded34-504d-5f90-a10a-87a266602706" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439069}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b24019f-f592-514c-8874-109e97014d8f" :question/math-academy-id "q-288419" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $3x=2x+5$\n- **II.** $4x-2=4x-2$\n- **III.** $5x+3=5x+1$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x & =2x+5 \\\\ 3x-2x & =2x+5-2x \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the equation $3x=2x+5$ has the unique solution $x=5.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}4x-2 & =4x-2 \\\\ 4x-2-4x & =4x-2-4x \\\\ -2 & =-2.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $4x-2=4x-2$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}5x+3 & =5x+1 \\\\ 5x+3-5x & =5x+1-5x \\\\ 3 & =1.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186297170 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b30a8cc-6928-5b29-8e9d-969094b2881b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186295513}] :answer-field/correct {:answer/id #uuid "2b30a8cc-6928-5b29-8e9d-969094b2881b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186295513} :answer-field/id #uuid "f87dd3f0-9ada-5f78-bd01-d45ae62ce046" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297144}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e508284d-0585-5c0f-a542-d91d66f78ddf" :question/math-academy-id "q-287975" :question/problem "Consider the equation\n\n$$\n(2p-3)x=5x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=2p-3,\\,b=5.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n2p-3=5.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}2p & =8 \\\\ p & =4.\\end{aligned}\n$$"}] [{:db/id 17592186297181 :knowledge-point/_questions [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51b73290-8884-52b0-bea9-586ed1106191" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438082} {:answer/id #uuid "84594a5c-0472-579f-8c56-3c27f2aa0b2f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438083}] :answer-field/correct {:answer/id #uuid "51b73290-8884-52b0-bea9-586ed1106191" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438082} :answer-field/id #uuid "d237ec26-3cf6-575e-bb01-acccb260545f" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439070} {:answer-field/choices [{:answer/id #uuid "6aa4deae-76c0-5bf7-a4af-1158715b25d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438084} {:answer/id #uuid "e6ba602a-8c17-5e28-b8db-32b4e57396a8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438085}] :answer-field/correct {:answer/id #uuid "6aa4deae-76c0-5bf7-a4af-1158715b25d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438084} :answer-field/id #uuid "e0236bbe-ed0c-5681-b717-8d06a5afcad6" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439071} {:answer-field/choices [{:answer/id #uuid "18b5cb76-d351-5058-a991-9afc4efc993e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438086} {:answer/id #uuid "b1790360-3d45-5107-959e-c1c762336309" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438087}] :answer-field/correct {:answer/id #uuid "18b5cb76-d351-5058-a991-9afc4efc993e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438086} :answer-field/id #uuid "ae99ebca-b507-5034-9f94-d990616ca1d6" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439072}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5426119-4ea0-5c84-bb6c-cf460c622db0" :question/math-academy-id "q-288425" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $-3x+2=-3x+7$\n- **II.** $6x+1=6x+5$\n- **III.** $7x-4=6x-6$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}-3x+2 & =-3x+7 \\\\ -3x+2+3x & =-3x+7+3x \\\\ 2 & =7.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}6x+1 & =6x+5 \\\\ 6x+1-6x & =6x+5-6x \\\\ 1 & =5.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}7x-4 & =6x-6 \\\\ 7x-4-6x & =6x-6-6x \\\\ x-4 & =-6 \\\\ x-4+4 & =-6+4 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the equation $7x-4=6x-6$ has the unique solution $x=-2.$\n\nTherefore, the correct answer is \"None.\""}] [{:db/id 17592186297182 :knowledge-point/_questions [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86bc7e66-5bdd-5da7-b6ee-6b1a37c5ae9c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438088} {:answer/id #uuid "1dc3c549-6f72-5c75-9824-c4564938c74a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438089}] :answer-field/correct {:answer/id #uuid "86bc7e66-5bdd-5da7-b6ee-6b1a37c5ae9c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438088} :answer-field/id #uuid "01d95513-0985-54ed-85b5-aee1f0de0676" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439073} {:answer-field/choices [{:answer/id #uuid "93091e42-4e1d-50af-874b-052e5b4ccf7b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438090} {:answer/id #uuid "831cc9b8-0274-570c-a213-da0beeeda4c0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438091}] :answer-field/correct {:answer/id #uuid "93091e42-4e1d-50af-874b-052e5b4ccf7b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438090} :answer-field/id #uuid "9ccfd62c-12fc-5d4f-a40e-e4d63caedad3" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439074} {:answer-field/choices [{:answer/id #uuid "1844e447-1273-5f4a-9121-461fc7343eef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438092} {:answer/id #uuid "fbfbb123-d421-50c5-bb94-58c01fc307f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438093}] :answer-field/correct {:answer/id #uuid "fbfbb123-d421-50c5-bb94-58c01fc307f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438093} :answer-field/id #uuid "a73ad185-931c-5fc2-9419-95cfddabcee6" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439075}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "31ef6d07-7ebc-5067-b0a5-3f361bec8d1c" :question/math-academy-id "q-288427" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $2x-5=x-2$\n- **II.** $6x+1=6x+9$\n- **III.** $-4x+3=-4x+3$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}2x-5 & =x-2 \\\\ 2x-5-x & =x-2-x \\\\ x-5 & =-2 \\\\ x-5+5 & =-2+5 \\\\ x & =3.\\end{aligned}\n$$\n\nTherefore, the equation $2x-5=x-2$ has the unique solution $x=3.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}6x+1 & =6x+9 \\\\ 6x+1-6x & =6x+9-6x \\\\ 1 & =9.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}-4x+3 & =-4x+3 \\\\ -4x+3+4x & =-4x+3+4x \\\\ 3 & =3.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $-4x+3=-4x+3$ has infinitely many solutions.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186297183 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45491d55-84a5-5641-85ee-02ca1a1e90b2" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186295660} {:answer/id #uuid "7b982f8e-1429-5175-9e47-06c33c917451" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id 17592186295944} {:answer/id #uuid "9130ffb1-ff3d-56f6-b44a-a46263f888e3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186296047} {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186296063} {:answer/id #uuid "f61f19b9-1bc9-5327-81ed-c1e60a23106f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id 17592186296576}] :answer-field/correct {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186296063} :answer-field/id #uuid "057a3936-10b0-5e7b-83aa-558ff78363fc" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296650}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "556d6e5b-c151-55e9-9606-63f27cad6bd7" :question/math-academy-id "q-288436" :question/problem "Consider the equation\n\n$$\n5px=10x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=5p,\\,b=10.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n5p=10.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=2.\n$$"}] [{:db/id 17592186297184 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26fe00c2-ff7d-5b62-96ab-0af209fd24e1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id 17592186295480} {:answer/id #uuid "389f9ac4-b9fe-5bf6-9689-5a77751235bb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id 17592186295586} {:answer/id #uuid "7cd45365-694b-59a1-9c75-444ba21c1ac8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186295949} {:answer/id #uuid "bc73343c-08ba-5843-8a40-f11269cd8d67" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186296258} {:answer/id #uuid "ff514a4f-a0d5-5889-8487-a38b01139445" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id 17592186296630}] :answer-field/correct {:answer/id #uuid "7cd45365-694b-59a1-9c75-444ba21c1ac8" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id 17592186295949} :answer-field/id #uuid "632eea42-d449-505d-9c6f-a3dc34d529ba" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296837}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e80edf76-d1e3-576c-b5c7-753b9159f67b" :question/math-academy-id "q-288440" :question/problem "Consider the equation\n\n$$\n-4kx=8x\n$$\n\nwhere $k$ is a constant. Given that this equation has infinitely many solutions, what is the value of $k?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=-4k,\\,b=8.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n-4k=8.\n$$\n\nSolving this for $k,$ we get\n\n$$\nk=-2.\n$$"}] [{:db/id 17592186297194 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11383c9f-6bca-51a0-bf87-839bec637ba1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186295365}] :answer-field/correct {:answer/id #uuid "11383c9f-6bca-51a0-bf87-839bec637ba1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186295365} :answer-field/id #uuid "b78bfb02-4c20-5a75-811c-305086ea1983" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186297016}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73256cc5-b18c-5ffc-bb1b-9018e84f6eb6" :question/math-academy-id "q-288583" :question/problem "Consider the equation\n\n$$\n2tx+(1-m)=6x+4\n$$\n\nwhere $t$ and $m$ are constants. Given that this equation has infinitely many solutions, what is the value of $t+m?$\n\n$t+m=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $t$ and $m$ such that the equation\n\n$$\n2tx+(1-m)=6x+4\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n2t=6.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=3.\n$$\n\n- Equating the constants, we get\n\n$$\n1-m=4.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\nm=-3.\n$$\n\nFinally, since $t=3$ and $m=-3,$ we have\n\n$$\nt+m=3+(-3)=0.\n$$"}] [{:db/id 17592186297195 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186296621}] :answer-field/correct {:answer/id #uuid "fe4c39bf-4560-5825-a22a-76a5df230cbf" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186296621} :answer-field/id #uuid "58355121-2d5d-5aa8-91c2-79f41befa005" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186296811}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1e37e75-7d0c-5923-8a40-5f706dc21da1" :question/math-academy-id "q-288584" :question/problem "Consider the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nwhere $s$ and $t$ are constants. Given that this equation has infinitely many solutions, what is the value of $s+t?$\n\n$s+t=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $s$ and $t$ such that the equation\n\n$$\n(-s+3)x+2t=x+6\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n-s+3=1.\n$$\n\nSolving this equation for $s,$ we get\n\n$$\ns=2.\n$$\n\n- Equating the constants, we have\n\n$$\n2t=6.\n$$\n\nSolving this equation for $t,$ we get\n\n$$\nt=3.\n$$\n\nFinally, since $s=2$ and $t=3,$ we have\n\n$$\ns+t=2+3=5.\n$$"}] [{:db/id 17592186297196 :knowledge-point/_questions [{:db/id 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f505619a-0f8f-5b06-bcd1-9ed29f3a46e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438094} {:answer/id #uuid "800b7f50-dd11-50d4-910a-43bdf1c22e22" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438095}] :answer-field/correct {:answer/id #uuid "f505619a-0f8f-5b06-bcd1-9ed29f3a46e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438094} :answer-field/id #uuid "5d40aab5-2a51-5f28-9398-9e1f95aef724" :answer-field/key "I" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439076} {:answer-field/choices [{:answer/id #uuid "35bdc9da-af4c-51a3-977a-aab317bf1688" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438096} {:answer/id #uuid "b473c870-043e-51e2-b1e7-8129f88a2f5f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438097}] :answer-field/correct {:answer/id #uuid "35bdc9da-af4c-51a3-977a-aab317bf1688" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438096} :answer-field/id #uuid "f63c5f3b-e9f0-5d44-b9b5-69d5b9503e16" :answer-field/key "II" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439077} {:answer-field/choices [{:answer/id #uuid "ca3aa2f5-1e64-5717-a73e-d38a34cd3c61" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id 17592186438098} {:answer/id #uuid "14f6741b-26e8-5eea-b15d-fa64a12ad311" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438099}] :answer-field/correct {:answer/id #uuid "14f6741b-26e8-5eea-b15d-fa64a12ad311" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id 17592186438099} :answer-field/id #uuid "6515f165-1d78-588e-8621-8c95e0aa4812" :answer-field/key "III" :answer-field/type {:db/id 17592186408166 :db/ident :answer-field.type/checkbox} :db/id 17592186439078}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43eccfac-bd80-5f7b-abff-3250eee5dc70" :question/math-academy-id "q-288591" :question/problem "Which of the following equations has infinitely many solutions?\n\nSelect all that apply.\n\n- **I.** $3x+2=4x+1$\n- **II.** $2x-5=3x-3$\n- **III.** $5x-4=5x-4$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x+2 & =4x+1 \\\\ 3x+2-3x & =4x+1-3x \\\\ 2 & =x+1 \\\\ 2-1 & =x+1-1 \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the equation $3x+2=4x+1$ has the unique solution $x=1.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}2x-5 & =3x-3 \\\\ 2x-5-2x & =3x-3-2x \\\\ -5 & =x-3 \\\\ -5+3 & =x-3+3 \\\\ x & =-2.\\end{aligned}\n$$\n\nTherefore, the equation $2x-5=3x-3$ has the unique solution $x=-2.$\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}5x-4 & =5x-4 \\\\ 5x-4-5x & =5x-4-5x \\\\ -4 & =-4.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $5x-4=5x-4$ has infinitely many solutions.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186297198 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26dea449-5daa-571d-bc24-21b16885571b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id 17592186295478} {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186295672} {:answer/id #uuid "7f368c30-e2fd-5534-8546-adacd3bdc62c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id 17592186295955} {:answer/id #uuid "bb0e5e07-5208-59c1-8031-79b63eb57a08" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186296248} {:answer/id #uuid "e8efa7fd-e32d-5724-96bb-c481dd8ea2c4" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186296507}] :answer-field/correct {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186295672} :answer-field/id #uuid "049c5b1b-3107-5777-ad7f-5a1a5ac925c9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296646}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afc322c5-285c-5560-a114-d1da26bf18af" :question/math-academy-id "q-288622" :question/problem "Consider the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+2=7.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =5.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n5n=15.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =3.\\end{aligned}\n$$\n\nFinally, since $m=5$ and $n=3,$ we have\n\n$$\nm+n=5+3=8.\n$$"}] [{:db/id 17592186297199 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16a9032f-3b49-520d-8dd2-f9561ab549a5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id 17592186295402} {:answer/id #uuid "408f08fe-9474-5041-b518-50e39558bff0" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id 17592186295635} {:answer/id #uuid "40aa1a16-e6d9-5660-9646-91aa012afb7d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{2}" :db/id 17592186295636} {:answer/id #uuid "4376d57c-3e21-5f7a-9e08-da1e663ee90a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id 17592186295647} {:answer/id #uuid "f4e2b538-9abc-5649-871f-12082724e81b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id 17592186296563}] :answer-field/correct {:answer/id #uuid "f4e2b538-9abc-5649-871f-12082724e81b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{2}" :db/id 17592186296563} :answer-field/id #uuid "a7f50aa1-8f5f-55b0-9f35-0014c59522a5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296988}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48147a3d-8103-52a6-b2f5-5907d423b5d5" :question/math-academy-id "q-288623" :question/problem "Consider the equation\n\n$$\n2kx+r=9x+6\n$$\n\nwhere $k$ and $r$ are constants. Given that this equation has infinitely many solutions, what is the value of $k+r?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $k$ and $r$ such that the equation\n\n$$\n2kx+r=9x+6\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n2k=9.\n$$\n\nSolving this equation for $k,$ we get\n\n$$\n\\begin{aligned}k & =\\frac{9}{2}.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\nr=6.\n$$\n\nFinally, since $k=\\frac{9}{2}$ and $r=6,$ we have\n\n$$\nk+r=\\frac{9}{2}+6=\\frac{21}{2}.\n$$"}] [{:db/id 17592186297200 :knowledge-point/_questions [{:db/id 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28da790f-20c9-5875-b417-1be764fa2aeb" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id 17592186295496} {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id 17592186296020} {:answer/id #uuid "c24c121c-9aae-5ae4-989f-173c011f7cdc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id 17592186296294} {:answer/id #uuid "c7c8cfa6-04bf-59ad-b50b-09698209ddbc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id 17592186296316} {:answer/id #uuid "e7994d65-33f9-5bec-9e19-0969a17a2b2b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id 17592186296497}] :answer-field/correct {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id 17592186296020} :answer-field/id #uuid "a71ebbc6-abec-50c8-b8f1-d671ed8c0cf9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186296986}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f55693d-3dd0-5310-a538-5dcb7f69af97" :question/math-academy-id "q-288627" :question/problem "Consider the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p+q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $p$ and $q$ such that the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n\\frac{p}{2}=4.\n$$\n\nSolving this equation for $p,$ we get\n\n$$\n\\begin{aligned}p & =8.\\end{aligned}\n$$\n\n- Equating the constants, we get\n\n$$\nq=20.\n$$\n\nFinally, since $p=8$ and $q=20,$ we have\n\n$$\np+q=8+20=28.\n$$"}] [{:db/id 17592186476179 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0aef56a-9783-5d17-9031-bab5a68a349a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186476188}] :answer-field/correct {:answer/id #uuid "c0aef56a-9783-5d17-9031-bab5a68a349a" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186476188} :answer-field/id #uuid "bbc5f675-2afa-5060-b80c-f84895052e62" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186476187}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c6ffd8f-aed0-5462-a678-623c3eb10c91" :question/problem "Consider the equation\n\n$$\n(6p-6)x=36x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=6p-6,\\,b=36.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n6p-6=36.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}6p & =42 \\\\ p & =7.\\end{aligned}\n$$"}] [{:db/id 17592186476183 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c43f225d-c7fc-52aa-b515-2cae7955625c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186476190}] :answer-field/correct {:answer/id #uuid "c43f225d-c7fc-52aa-b515-2cae7955625c" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id 17592186476190} :answer-field/id #uuid "e8023800-07d9-51cc-a72e-06d399d2f3a0" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186476194}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8af6ded4-48a3-5261-b74f-acd5512ac6e3" :question/problem "Consider the equation\n\n$$\n(5p-3)x=37x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=5p-3,\\,b=37.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n5p-3=37.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}5p & =40 \\\\ p & =8.\\end{aligned}\n$$"}] [{:db/id 17592186476185 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b22cba07-0bc4-5800-81fe-2be13fe3a58b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186476186}] :answer-field/correct {:answer/id #uuid "b22cba07-0bc4-5800-81fe-2be13fe3a58b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id 17592186476186} :answer-field/id #uuid "81d03035-2a65-5a2d-8446-1f0fcb459162" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186476181}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0e66191-a3c9-5572-8227-0f5cb2926471" :question/problem "Consider the equation\n\n$$\n(3p-1)x=17x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=3p-1,\\,b=17.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n3p-1=17.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}3p & =18 \\\\ p & =6.\\end{aligned}\n$$"}] [{:db/id 17592186476189 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce549a5e-11a0-5494-87aa-29777e280cf3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186476192}] :answer-field/correct {:answer/id #uuid "ce549a5e-11a0-5494-87aa-29777e280cf3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id 17592186476192} :answer-field/id #uuid "127f3283-4330-5bc1-ae69-19de1c8c9f76" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186476178}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2e51c73-6455-54ee-866f-56127d07e55b" :question/problem "Consider the equation\n\n$$\n(7p-1)x=20x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=7p-1,\\,b=20.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n7p-1=20.\n$$\n\nSolving this for $p,$ we get\n\n$$\n\\begin{aligned}7p & =21 \\\\ p & =3.\\end{aligned}\n$$"}] [{:db/id 17592186476193 :knowledge-point/_questions [{:db/id 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a63ee0f-09e0-5d67-bf7b-6c6205d50d30" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id 17592186476180} {:answer/id #uuid "83fd7c44-dbb6-5a68-92eb-ccaed9e31428" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186476182} {:answer/id #uuid "9014217b-66f1-54ef-a298-df27f02ad1bd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{2}" :db/id 17592186476184} {:answer/id #uuid "c5a26fc8-6112-50b6-a5