-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284ded16-4e2b-58c5-a9b3-3bc9411901be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339480} {:answer/id #uuid "790fe37d-c34e-5966-9eaf-9d268a97cd85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340207} {:answer/id #uuid "932e6098-7ea1-500c-a775-216015f34edc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340451} {:answer/id #uuid "99f98270-ecaf-5d2c-8a85-811cc5dd4758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340515} {:answer/id #uuid "f8f3f51e-ce59-5013-95f2-552286e3b628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341331}] :answer-field/correct {:answer/id #uuid "932e6098-7ea1-500c-a775-216015f34edc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340451} :answer-field/id #uuid "362a3e08-f85f-51f6-a3a7-d6f4324787e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "949042b7-80c8-5584-b86a-21848d3ca6ef" :question/math-academy-id "q-73625" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=\\begin{bmatrix}0 & -2 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}0 & -2 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -2 & 1 & 0 & 0 \\\\ 0 & 0 & 2 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}0 & -2 & 1 & 0 & 0 \\\\ 0 & 0 & 2 & -1 & 2 \\\\ 0 & 0 & 0 & 8 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186342040 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c6719d4-8ae8-5e75-9238-9d06796f45e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339372} {:answer/id #uuid "8d95f092-36bd-5290-9f94-de1b9541f124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340400} {:answer/id #uuid "a09d0421-f482-5519-a333-aef22f6874a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186340584} {:answer/id #uuid "bf7d0107-3df2-557f-adc1-4c6b0c11cf26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340834} {:answer/id #uuid "cfb7ff38-9563-586d-bffb-05e9abf08eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340977}] :answer-field/correct {:answer/id #uuid "cfb7ff38-9563-586d-bffb-05e9abf08eb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340977} :answer-field/id #uuid "9ffc366a-bd4e-5c19-870e-392f4fcf5367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 1759218604549