x} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & -3 & 1 & -1\\end{bmatrix} & {R}_{4} & :={R}_{4}+\\frac{1}{2}{R}_{3} \\\\  & ∼\\begin{bmatrix}-2 & 0 & 0 & 0 & 0 \\\\ 0 & 1 & 4 & -2 & 0 \\\\ 0 & 0 & 6 & -2 & 2 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186323715 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e64682-e33b-5167-b977-f5b3b286bbd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574405} {:answer/id #uuid "dda07581-f82c-574b-bf17-ca5951e59677" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574406}] :answer-field/correct {:answer/id #uuid "dda07581-f82c-574b-bf17-ca5951e59677" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574406} :answer-field/id #uuid "51b2f328-31ef-55a5-b264-5c10264ce867" :answer-field/key "Column 1" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574685} {:answer-field/choices [{:answer/id #uuid "469b7bab-6d41-5934-add1-7287dbae6b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574407} {:answer/id #uuid "e40a9d1d-74c7-5b60-b10d-76487a38d116" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574408}] :answer-field/correct {:answer/id #uuid "e40a9d1d-74c7-5b60-b10d-7648