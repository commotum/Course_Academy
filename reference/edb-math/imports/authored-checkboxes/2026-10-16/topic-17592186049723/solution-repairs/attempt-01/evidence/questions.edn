 #edb/ref 17592186414470} {:answer/id #uuid "4fbea88a-54a4-589b-953c-572e039364e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186414471} {:answer/id #uuid "4fd90c1d-53e5-5f45-8848-752538c1d508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186414472} {:answer/id #uuid "c5092969-970d-5cce-acd5-6e2221c79fa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186414480}] :answer-field/correct {:answer/id #uuid "4fd90c1d-53e5-5f45-8848-752538c1d508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186414472} :answer-field/id #uuid "6f646bf1-b053-51af-98e8-66196b742893" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1ae8763-ab2d-5aee-9b53-3f6da8520aee" :question/math-academy-id "q-35457" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}3 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 0 & -3 \\\\ 0 & 0 & 10 & 3 & -9 \\\\ 0 & 0 & 0 & 1 & 2\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}3 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 0 & -3 \\\\ 0 & 0 & 10 & 3 & -9 \\\\ 0 & 0 & 0 & 1 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-5){R}_{2} \\\\  & ∼\\begin{bmatrix}3 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 0 & -3 \\\\ 0 & 0 & 0 & 3 & 6 \\\\ 0 & 0 & 0 & 1 & 2\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-\\frac{1}{3}){R}_{3} \\\\  & ∼\\begin{bmatrix}3 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 2 & 0 & -3 \\\\ 0 & 0 & 0 & 3 & 6 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}] [{:db/id #edb/ref 17592186124885 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8394053e-1dfd-5bb2-b4f9-81664e19df78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186121911} {:answer/id #uuid "f6384bfd-02e6-5535-8d51-062cffa80106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186121912} {:answer/id #uuid "0bb191f9-71b5-5740-93c2-a4d76bb498a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186121913} {:answer/id #uuid "0ff1ae3e-6659-5834-92f8-db52d38bb2be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186121914} {:answer/id #uuid "5c78fd13-39a0-526f-ab60-dc28debe3aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186121915}] :answer-field/correct {:answer/id #uuid "8394053e-1dfd-5bb2-b4f9-81664e19df78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186121911} :answer-field/id #uuid "4332c4ac-d5dc-5086-844f-b1c234bed282" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a6c1395-93b3-574c-b784-2d33009b00c0" :question/math-academy-id "q-35459" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{bmatrix} & {R}_{4} & :={R}_{4}+(\\frac{1}{2}){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{bmatrix} & {R}_{4} & :={R}_{4}+(\\frac{2}{7}){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $5$ pivots, and therefore the number of pivot columns is $5.$"}] [{:db/id #edb/ref 17592186124903 :knowledge-point/_questions [{:db/id #edb/ref 17592186124477 :knowledge-point/id #uuid "488c9762-554b-5ea6-b414-ce6cbde9bbd1" :knowledge-point/title "Finding the Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9ab99e2-da39-53de-8dfb-e2e72019e10c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186574369} {:answer/id #uuid "f30354b0-6271-5155-9b61-8f3b1035e448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574370}] :answer-field/correct {:answer/id #uuid "f30354b0-6271-5155-9b61-8f3b1035e448" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186574370} :answer-field/id #uuid "4a49436b-b89a-563f-999f-4f54aa4e5849" :answer-field/key "Column 1" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186574667} {:answer-f