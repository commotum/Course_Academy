 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $5$ pivots, and therefore the number of pivot columns is $5.$" "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & -2 & -8 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{bmatrix} & {R}_{4} & :={R}_{4}+(\\frac{1}{2}){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 2 & -1\\end{bmatrix} & {R}_{5} & :={R}_{5}+(\\frac{2}{7}){R}_{4} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 0 & 0 \\\\ 0 & -3 & 0 & 0 & 0 \\\\ 0 & 0 & 4 & 2 & 0 \\\\ 0 & 0 & 0 & -7 & 7 \\\\ 0 & 0 & 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $5$ pivots, and therefore the number of pivot columns is $5.$"] [:db/ensure 17592186124885 :question/validate] [:db/cas 17592186124906 :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 4 & 9 & -6 \\\\ 0 & 0 & 2 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 2 & -4\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-2){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $3$rd columns." "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 4 & 9 & -6 \\\\ 0 & 0 & 2 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 2 & -4\\end{bmatrix} & {R}_{4} & :={R}_{4}+(-2){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 4 & 0 & 2 \\\\ 0 & -2 & -4 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $2$nd, and $3$rd columns."] [:db/ensure 17592186124906 :question/validate] [:db/cas 17592186266022 :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & 0 & 4 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots, and therefore the number of pivot columns is $3.$" "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & 0 & 4 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $3$ pivots, and therefore the number of pivot columns is $3.$"] [:db/ensure 17592186266022 :question/validate] [:db/cas 17592186266026 :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & -4 & 0 & 0 & -1 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix} & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $4$ pivots, and therefore the number of pivot columns is $4.$" "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & -4 & 0 & 0 & -1 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix} & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $B$ has $4$ pivots, and therefore the number of pivot columns is $4.$"] [:db/ensure 17592186266026 :question/validate] [:db/cas 17592186364337 :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $R$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nR=\\begin{bmatrix}1 & -1 & 2 & 0 \\\\ 0 & -4 & 3 & 1 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot column is the $3$rd columns." "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $R$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nR=\\begin{bmatrix}1 & -1 & 2 & 0 \\\\ 0 & -4 & 3 & 1 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."] [:db/ensure 17592186364337 :question/validate] [:db/cas 17592186342033 :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nP=\\begin{bmatrix}0 & 6 & -1 & 1 & 8 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd column." "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $P$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nP=\\begin{bmatrix}0 & 6 & -1 & 1 & 8 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd columns."] [:db/ensure 17592186342033 :question/validate]]
