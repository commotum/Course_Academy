columns."} {:db/id #edb/ref 17592186323676 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86b2b610-2568-5a70-a9ac-0a786d64966f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322216} {:answer/id #uuid "8b030490-db78-5a34-9dab-c5485b7b838c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186322255} {:answer/id #uuid "9374d4ac-d072-5d44-9d61-df26eab527c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322317} {:answer/id #uuid "ce1d065a-071d-5eb6-80b0-34914e786bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322754} {:answer/id #uuid "fa442286-bd9b-5952-a217-38ca68568243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186323118}] :answer-field/correct {:answer/id #uuid "fa442286-bd9b-5952-a217-38ca68568243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186323118} :answer-field/id #uuid "b52bff6c-f6dd-55c8-8d8e-18b733c5bcb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323525}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0d60236-44f8-5ff8-95cf-eb01e33fc186" :question/math-academy-id "q-35452" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=\\begin{bmatrix}1 & 0 & 0 & 4 & -7 & 5 \\\\ 0 & 0 & 2 & 3 & 1 & 0 \\\\ 5 & 0 & 0 & 20 & -35 & 24\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =\\begin{bmatrix}1 & 0 & 0 & 4 & -7 & 5 \\\\ 0 & 0 & 2 & 3 & 1 & 0 \\\\ 5 & 0 & 0 & 20 & -35 & 24\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & 4 & -7 & 5 \\\\ 0 & 0 & 2 & 3 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 0 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} {:db/id #edb/ref 17592186323677 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f6819e4-8455-5b92-950f-ef80d03e3a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186321384} {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321411} {:answer/id #uuid "3c1f36d6-2f31-5193-baa9-352cb4ec2d30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186321613} {:answer/id #uuid "e42fdf84-b6d0-5da0-bf66-8b251052d501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186322934} {:answer/id #uuid "e52ea9bd-c2ff-5f62-8bce-c9950d05029d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186322941}] :answer-field/correct {:answer/id #uuid "22d20878-4616-551d-9c51-c3ab339f7c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321411} :answer-field/id #uuid "0d8d06a1-5f1a-5dd9-a91d-202d54fedda4" :answer-field/key "selection