edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b45315b-a5c2-53a7-b6d0-069454aca98b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186565696} {:answer/id #uuid "384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186565770} {:answer/id #uuid "4ed2e27a-0bf7-5dd2-b5c6-be0e98115df1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $4$th only" :db/id #edb/ref 17592186565803} {:answer/id #uuid "68cc9e55-2409-512a-ac2e-c70b873bffd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186565841} {:answer/id #uuid "e0608257-5e3b-5666-af66-4b0ccd77c69a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $3$rd only" :db/id #edb/ref 17592186566043}] :answer-field/correct {:answer/id #uuid "384525a8-6bc7-511c-89ba-ed88a8ddda66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186565770} :answer-field/id #uuid "9e5f4d81-f91b-55ef-9252-1ab82323e853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186566167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "75f69126-c110-5545-9efd-4ceeba235a0c" :question/math-academy-id "q-73615" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=\\begin{bmatrix}1 & 3 & 5 & 0 \\\\ 0 & 2 & 1 & -2 \\\\ 0 & 0 & 0 & -1\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot column is the $3$rd column."} {:db/id #edb/ref 17592186573261 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023cc2f5-0dc4-57b8-83da-cab850c0da1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186572829} {:answer/id #uuid "294e94d5-45b0-5fea-8eb3-7cbc5ccb9acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $4$th only" :db/id #edb/ref 17592186572873} {:answer/id #uuid "43f5998d-2db6-5652-b314-092fcba29772" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186572908} {:answer/id #uuid "8a19af7a-70b9-503e-80be-9feeab7ec744" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd and $4$th" :db/id #edb/ref 17592186573002} {:answer/id #uuid "9c64bb76-0eee-5a58-8335-3ca14cce1cc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186573026}] :answer-field/correct {:answer/id #uuid "9c64bb76-0eee-5a58-8335-3ca14cce1cc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186573026} :answer-field/id #uuid "06426327-a841-5962-9ad3-ae8e7d73820a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186573150}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0dd8f23a-a284-5af7-a370-b6877f8aea89" :question/math-academy-id "q-73637" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 1 & -2\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 5 \\\\ 0 & 0 & 1 & -2\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}2 & 0 & -1 & 0 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 0 & 0 & 5\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots. In particular, the pivot columns are the $1$st, $3$rd, and $4$th columns."}]
