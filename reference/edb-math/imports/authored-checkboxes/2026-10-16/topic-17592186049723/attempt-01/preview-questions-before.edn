ent :question.difficulty/moderate} :question/id #uuid "7ddee6b4-1b01-50b9-84af-b697c22f2675" :question/math-academy-id "q-73633" :question/problem "Determine the number of pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & -6 & -4 & 9 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}0 & 3 & 2 & -1 & 0 \\\\ 0 & 0 & 6 & 1 & 3 \\\\ 0 & 0 & 0 & 7 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} {:db/id #edb/ref 17592186342044 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "483f76a2-c658-590b-b0c8-339dbf488e67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339772} {:answer/id #uuid "7d96a1fc-c32f-5705-9c33-3f7b775fcf9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340261} {:answer/id #uuid "89525704-89b5-5924-ae95-b2e4e00cc538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340353} {:answer/id #uuid "bacd7256-ac8c-5b32-ae2e-12bfdd5f2539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340803} {:answer/id #uuid "d2029d2d-b485-57b3-8a1c-d2297c1d7152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340991}] :answer-field/correct {:answer/id #uuid "d2029d2d-b485-57b3-8a1c-d2297c1d7152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340991} :answer-field/id #uuid "324fb24a-0b34-5d44-8ba7-82c48df3b212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b8524b-7ecd-587d-9654-16754c1816e2" :question/math-academy-id "q-73635" :question/problem "Determine the number of pivot columns of the matrix $Q,$ given by\n\n$$\nQ=\\begin{bmatrix}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $Q$ to row echelon form:\n\n$$\n\\begin{aligned}Q & =\\begin{bmatrix}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & -2 & 1 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+\\frac{1}{4}{R}_{3} \\\\  & ∼\\begin{bmatrix}-2 & 1 & 1 & 0 & 3 \\\\ 0 & 2 & -1 & 1 & 4 \\\\ 0 & 0 & 0 & 8 & -12 \\\\ 0 & 0 & 0 & 0 & -2 \\\\ 0 & 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $Q$ has $4$ pivots, and therefore the number of pivot columns is $4.$"} {:db/id #edb/ref 17592186342045 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1ee36a-4db5-53af-aad2-6e0f7d75bf06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd only" :db/id #edb/ref 17592186339233} {:answer/id #uuid "31c1489a-e505-5968-a