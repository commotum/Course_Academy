6022 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68a8607f-a7ae-55fc-9873-e64beeb45e80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263901} {:answer/id #uuid "7e1d3e3e-0f30-5d5f-8356-38994faa850b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264088} {:answer/id #uuid "920e5f30-7863-597b-82f8-b218ad7f5cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264252} {:answer/id #uuid "956da90f-8237-5a6d-86c7-6cf9b7cbe9f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264280} {:answer/id #uuid "ea21d030-591e-58f4-a69f-12dc84781a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186265038}] :answer-field/correct {:answer/id #uuid "68a8607f-a7ae-55fc-9873-e64beeb45e80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263901} :answer-field/id #uuid "ae86f020-8247-5b49-bcda-4b4122ee71c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265556}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02683bf4-c015-5b9c-845b-c5f836ec3faf" :question/math-academy-id "q-130957" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 3 & 0 & 2 & -1 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & -4 & 0 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 2 & 1 \\\\ 0 & 0 & 0 & 4 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $3$ pivots, and therefore the number of pivot columns is $3.$"} {:db/id #edb/ref 17592186266023 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13016ec0-8156-589e-b39b-942c97ca1edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263181} {:answer/id #uuid "4ace33b3-69d8-5761-a1dd-efead09fb2d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263642} {:answer/id #uuid "60dec4b1-c098-5349-b8d9-90a530ef64b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186263835} {:answer/id #uuid "9087593d-b85f-524d-b8a4-0f0def706f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264242} {:answer/id #uuid "b50e48ba-06d3-5a6a-927a-0e46fa9eaae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186264560}] :answer-field/correct {:answer/id #uuid "4ace33b3-69d8-5761-a1dd-efead09fb2d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186263642} :answer-field/id #uuid "d9aa03e6