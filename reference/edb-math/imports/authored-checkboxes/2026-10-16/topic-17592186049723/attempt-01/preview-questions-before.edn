bmatrix}0 & 2 & -3 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & -6 & 0\\end{bmatrix} & {R}_{4} & :={R}_{4}+2{R}_{3} \\\\  & ∼\\begin{bmatrix}0 & 2 & -3 & 0 & -1 & 0 \\\\ 0 & 0 & 2 & 0 & 1 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 0 & 0 & 2\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $Q$ has $4$ pivots, and therefore the number of pivot columns is $4.$"} {:db/id #edb/ref 17592186266026 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c423f32-6ae0-5d69-9e82-133ca26c00b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186263117} {:answer/id #uuid "43b9eb4b-0812-5b76-96ad-0b9419cce423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186263597} {:answer/id #uuid "7eb8faa9-f2e7-58be-99b6-ad614517b8a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186264095} {:answer/id #uuid "b7daf584-dd5c-544f-916e-add25cf29fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186264592} {:answer/id #uuid "c49ba9a5-4fb9-53cb-b896-6585eb979d0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186264724}] :answer-field/correct {:answer/id #uuid "43b9eb4b-0812-5b76-96ad-0b9419cce423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186263597} :answer-field/id #uuid "e43594fd-fd39-5526-a89e-674d8a357bc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265648}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1da223e-cf33-5119-871d-5d62bfe3b1a0" :question/math-academy-id "q-130963" :question/problem "Determine the number of pivot columns of the matrix $B,$ given by\n\n$$\nB=\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & -4 & 0 & 0 & -1 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix}.\n$$" :question/worked-solution "First, we need to convert $B$ to row echelon form:\n\n$$\n\\begin{aligned}B & =\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & -4 & 0 & 0 & -1 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+4{R}_{2} \\\\  & ∼\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 4 & 0 & 7\\end{bmatrix} & {R}_{4} & :={R}_{4}+{R}_{3} \\\\  & ∼\\begin{bmatrix}3 & -1 & 5 & 0 & 7 & 1 \\\\ 0 & 1 & 0 & -1 & 1 & 0 \\\\ 0 & 0 & 0 & -4 & 3 & 2 \\\\ 0 & 0 & 0 & 0 & 3 & 9\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $A$ has $4$ pivots, and therefore the number of pivot columns is $4.$"} {:db/id #edb/ref 17592186266069 :knowledge-point/_questions [{:db/id #edb/ref 17592186124480 :knowledge-point/id #uuid "b1a557d6-52f3-5df3-8088-5b875296e72e" :knowledge-point/title "Finding the Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28eb5400-8304-5aee-8f9a-e756081b09e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186263352} {:answer/id #uuid "8ced3247-7bb3-566e-afb4-7a83ddad83bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186264206} {:answer/id #uuid "aa5ea70a-6c3f-5229-892d-e6a85a113025" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "