 #edb/ref 17592186403685} {:answer/id #uuid "508efe11-c663-52c3-84b8-ac714fe99937" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $3$rd, and $4$th only" :db/id #edb/ref 17592186403686} {:answer/id #uuid "8054e257-e2ab-5aa6-b464-152bde3bafb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186403687} {:answer/id #uuid "56527d12-3319-58cd-8ff8-f8efdf4d8acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, and $4$th only" :db/id #edb/ref 17592186403688}] :answer-field/correct {:answer/id #uuid "8054e257-e2ab-5aa6-b464-152bde3bafb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st, $2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186403687} :answer-field/id #uuid "6197e392-74ff-5689-be7c-741e44610b04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403683}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8bbb774c-4bbb-58f8-84cb-fd20b0029b02" :question/math-academy-id "q-73638" :question/problem "What are the pivot columns of the matrix $P,$ given by\n\n$$\nP=\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{bmatrix}?\n$$" :question/worked-solution "First, we need to convert $P$ to row echelon form:\n\n$$\n\\begin{aligned}P & =\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{bmatrix} & {R}_{2} & ↔{R}_{3} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 0 & 1 & 0 \\\\ 0 & 0 & 4 & 0 & 2\\end{bmatrix} & {R}_{3} & ↔{R}_{4} \\\\  & ∼\\begin{bmatrix}-3 & 2 & 1 & 0 & 4 \\\\ 0 & -4 & 5 & -1 & 0 \\\\ 0 & 0 & 4 & 0 & 2 \\\\ 0 & 0 & 0 & 1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $P$ has $4$ pivots. In particular, the pivot columns are the $1$st, $2$nd, $3$rd, and $4$th columns."} {:db/id #edb/ref 17592186410771 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3d7552-73fd-5a30-adca-213fce95daf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186410765} {:answer/id #uuid "2c231bf1-1c62-5bb0-a5af-80fd235dc05d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st only" :db/id #edb/ref 17592186410766} {:answer/id #uuid "88eecdfd-f245-5138-93d4-a347d38063c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186410767} {:answer/id #uuid "a582f1d6-9082-5ca9-8a15-8892198e09a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $2$nd only" :db/id #edb/ref 17592186410768} {:answer/id #uuid "ab2f5437-3869-5765-88a5-9a58e75de19b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $4$th, and $5$th only" :db/id #edb/ref 17592186410769}] :answer-field/correct {:answer/id #uuid "1d3d7552-73fd-5a30-adca-213fce95daf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$st and $3$rd only" :db/id #edb/ref 17592186410765} :answer-field/id #uuid "0ec2a6fc-f001-5e94-83d4-c400fba8593b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186410770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcd1cb26-1c44-5d74-aa8e-2093ab435f98" :question/math-academy-id "q-130950" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=\\begin{bmatrix}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{bmatrix}\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $2$nd, $4$th and $5$th columns:\n\n$$\nA=\\begin{bmatrix}0 & -4 & 3 & -3 & 5 \\\\ 0 & 0 & 0 & 2 & -6 \\\\ 0 & 0 & 0 & 0 & -3\\end{bmatrix}\n$$\n\nTherefore, the only non-pivot columns are the $1$st and $3$rd columns."} {:db/id #edb/ref 17592186414494 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c25b5ef-b912-5c71-9670-944d65285749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186414467} {:answer/id #uuid "ad1a92a6-f6d8-5aa2-9a4c-0f2edb4ce9bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186414479} {:answer/id #uuid "e884e7e6-8f56-5bfb-a2ca-b9c4594a1a4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186414486} {:answer/id #uuid "f3c840b3-dbab-5742-a2b1-8a2edee0b393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186414487} {:answer/id #uuid "fa159688-f836-5d57-8c3c-4060d2af4504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186414488}] :answer-field/correct {:answer/id #uuid "e884e7e6-8f56-5bfb-a2ca-b9c4594a1a4b" :answer/type 