1\\end{aligned}],\\,L=[\\begin{aligned}2 & 7 \\\\ 7 & 0\\end{aligned}],\\,M=[\\begin{aligned}5 & 3 \\\\ 6 & 6\\end{aligned}]\n$$" :question/worked-solution "Recall that every quadratic form defined on ${R}^{2}$ has an associated $2\\times 2$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $K$ could be a matrix of a quadratic form defined on ${R}^{2}$ since it is a $2\\times 2$ symmetric matrix.\n\n- $L$ could also be a matrix of a quadratic form defined on ${R}^{2}$ since it is a $2\\times 2$ symmetric matrix.\n\n- $M$ *cannot* be a matrix of a quadratic form defined on ${R}^{2}.$ Although it's a $2\\times 2$ matrix, $M$ is not symmetric since ${m}_{12}\\ne {m}_{21}.$\n\nTherefore, the correct answer is \"$K$ and $L$ only.\""}] [{:db/id #edb/ref 17592186357640 :knowledge-point/_questions [{:db/id #edb/ref 17592186161984 :knowledge-point/id #uuid "e62e458d-0724-5dbe-b448-b79404f279f9" :knowledge-point/title "Identifying Matrices of Quadratic Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e99577a-0495-5805-ae75-73567c392385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id #edb/ref 17592186354801} {:answer/id #uuid "23050ebe-fa9b-5c46-b08c-336621c0e9a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ only" :db/id #edb/ref 17592186354962} {:answer/id #uuid "9ca267f3-0039-5f1e-be2b-16684827ea91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ and $U$ only" :db/id #edb/ref 17592186356058} {:answer/id #uuid "cffdd6fa-19d0-5433-a1c9-8294d86f15dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ and $V$ only" :db/id #edb/ref 17592186356481} {:answer/id #uuid "e0f01e3a-cc98-509d-9a98-0acef54b587b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186356631}] :answer-field/correct {:answer/id #uuid "9ca267f3-0039-5f1e-be2b-16684827ea91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ and $U$ only" :db/id #edb/ref 17592186356058} :answer-field/id #uuid "6b1032e9-c794-58c0-8cda-b33f0b56e724" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d6f7f1-c1fb-5ae2-b8f7-98ecf5b306a1" :question/math-academy-id "q-94062" :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{3}?$\n\n$$\nT=[\\begin{aligned}4 & 5 & -3 \\\\ 5 & 1 & -8 \\\\ -3 & -8 & 7\\end{aligned}],\\,U=[\\begin{aligned}7 & 1 & -2 \\\\ 1 & 4 & 5 \\\\ -2 & 5 & 7\\end{aligned}],\\,V=[\\begin{aligned}1 & -3 \\\\ -3 & 1\\end{aligned}]\n$$" :question/worked-solution "Recall that every quadratic form defined on ${R}^{3}$ has an associated $3\\times 3$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $T$ could be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $U$ could also be a matrix of a quadratic form defined on ${R}^{3}$ since it is a $3\\times 3$ symmetric matrix.\n\n- $V$ *cannot* be a matrix of a quadratic form defined on ${R}^{3}$ since it's a $2\\times 2$ matrix (not $3\\times 3$).\n\nTherefore, the correct answer is \"$T$ and $U$ only.\""}] [{:db/id #edb/ref 17592186357641 :knowledge-point/_questions [{:db/id #edb/ref 17592186161984 :knowledge-point/id #uuid "e62e458d-0724-5dbe-b448-b79404f279f9" :knowledge-point/title "Identifying Matrices of Quadratic Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045899f4-0265-529a-b1bf-c97ae74f8f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186354691} {:answer/id #uuid "06f47c75-3a6b-5eda-9070-00ecbce1a6d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$E$ and $F$ only" :db/id #edb/ref 17592186354721} {:answer/id #uuid "1b85b833-ebd2-5180-863b-80c4f7aef2d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $F$ only" :db/id #edb/ref 17592186354904} {:answer/id #uuid "1e09da54-089e-5bf2-9653-6d2d5423272a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$E$ only" :db/id #edb/ref 17592186354921} {:answer/id #uuid "973c589f-7e06-56a1-980d-1a5836e3bdc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186355993}] :answer-field/correct {:answer/id #uuid "045899f4-0265-529a-b1bf-c97ae74f8f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186354691} :answer-field/id #uuid "856cee2b-6bfa-5802-a288-b8a30743e419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61630213-687e-509d-b369-4384ce08371c" :question/math-academy-id "q-94063" :question/problem "Which of the following could be matrices of quadratic forms defined on ${R}^{4}?$\n\n$$\nD=[\\begin{aligned}3 & 1 & 3 & 0 \\\\ 1 & 5 & 1 & -2 \\\\ 3 & 1 & -2 & 2 \\\\ 0 & -4 & 2 & 7\\end{aligned}],\\,E=[\\begin{aligned}7 & 1 \\\\ 1 & 4\\end{aligned}],\\,F=[\\begin{aligned}1 & 2 & 3 & 6 \\\\ 2 & 5 & 4 & -1 \\\\ 3 & 4 & -2 & 2 \\\\ 6 & -1 & 2 & 7\\end{aligned}]\n$$" :question/worked-solution "Recall that every quadratic form defined on ${R}^{4}$ has an associated $4\\times 4$ symmetric matrix.\n\nWith that in mind, let's examine each matrix in turn.\n\n- $D$ *cannot* be a matrix of a quadratic form defined on ${R}^{4}.$ Although it's a $4\\times 4$ matrix, $D$ is not symmetric since ${d}_{24}\\ne {d}_{42}.$\n\n- $E$ *cannot* be a matrix of a quadratic form defined on ${R}^{4}$ since it's a $2\\times 2$ matrix (not $4\\times 4$).\n\n- $F$ could be a matrix of a quadratic form defined on ${R}^{4}$ since it is a $4\\times 4$ symmetric matrix.\n\nTherefore, the correct answer is \"$F$ only.\""}] [{:db/id #edb/ref 17592186357712 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "040b3a63-19be-5022-9658-3014fb50b885" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186354689} {:answer/id #uuid "84455952-9fa7-5e94-aa0f-d7d5bfb8e11d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186355830} {:answer/id #uuid "b15c462d-1b5e-57a3-adf5-fc61bd9e16cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186356226} {:answer/id #uuid "ea5fd280-3e1b-5029-8757-e4ee17ca35c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186356711} {:answer/id #uuid "fe4c80ad-01b9-599e-8626-a6256b045b4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186356895}] :answer-field/correct {:answer/id #uuid "b15c462d-1b5e-57a3-adf5-fc61bd9e16cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186356226} :answer-field/id #uuid "cfbf2f3b-088a-5dda-9944-62e1f201bf5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b779ea2-64c9-5921-9b3e-0c6d8313380f" :question/math-academy-id "q-94275" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+4y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$\n\nII. $y=R\\operatorname{tan}⁡(2t+{ϕ}_{2})$\n\nIII. $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n1\\. $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n2\\. $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n3\\. $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=4\\,⟹\\,\\omega =2.\n$$\n\nThus, we have:\n\n1\\. $y=R\\operatorname{cos}⁡(2t+{ϕ}_{1})$\n\n2\\. $y=R\\operatorname{sin}⁡(2t+{ϕ}_{2})$\n\n3\\. $y=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$\n\nTherefore, only function III could be used to represent $y(t).$"}] [{:db/id #edb/ref 17592186357713 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ebe2c9-20b0-526d-b03f-886e5998a3cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186354672} {:answer/id #uuid "30dc7bcb-7a0f-537f-ba30-09d2e3c4f233" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186355090} {:answer/id #uuid "373749a5-0a5c-571a-bbea-0dafb35136b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186355160} {:answer/id #uuid "6c0ca1f7-7c2d-50cc-931b-dcc6b7af5b84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186355619} {:answer/id #uuid "8be4f329-9b59-53d8-9b18-b76bd6467a10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186355902}] :answer-field/correct {:answer/id #uuid "373749a5-0a5c-571a-bbea-0dafb35136b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186355160} :answer-field/id #uuid "303256b6-8ac9-531c-a421-78bede8dc5e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "784be4fd-7d61-5b65-af33-15597c14ae36" :question/math-academy-id "q-94276" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+16y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$\n- $y=R\\operatorname{sin}⁡(4t+{ϕ}_{2})$\n- $y=A\\operatorname{cos}⁡16t+B\\operatorname{sin}⁡16t$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=16\\,⟹\\,\\omega =4.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(4t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t$\n\nTherefore, only functions I and II could be used to represent $y(t).$"}] [{:db/id #edb/ref 17592186357736 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1506779c-da1e-5258-a746-aa1010e48366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186354853} {:answer/id #uuid "3415739f-1d61-518e-b0c7-ca0711994b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186355124} {:answer/id #uuid "51a36235-9f5c-5e34-8851-c810469b4f2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186355394} {:answer/id #uuid "8512d7aa-7410-539e-a90f-0f1559ad9bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186355840} {:answer/id #uuid "e91b7db7-efed-5209-b616-1a48649ae3e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186356703}] :answer-field/correct {:answer/id #uuid "1506779c-da1e-5258-a746-aa1010e48366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186354853} :answer-field/id #uuid "329eea82-d594-58e7-969e-bc96d3f41554" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356998}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feaf4026-120d-5dc5-a147-ce0975029f64" :question/math-academy-id "q-94376" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+y=2\\operatorname{sin}⁡t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n- $y=R\\operatorname{sin}⁡(t+ϕ)+2t\\operatorname{sin}⁡t$\n- $y=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t-2t\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution to this equation is the sum of the complementary function and a particular solution.\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$\nIt can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=1\\,⟹\\,\\omega =1.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=t(\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t).\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =-1$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=-t\\operatorname{cos}⁡t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n\n- ${y}_{c}=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t$\n\nOnly I matches the forms above. Therefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186357737 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1bc7b6-4de7-5eac-8417-854e3e18c590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186354757} {:answer/id #uuid "7da5b856-80e8-5cfd-bd82-d217ab37885e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186355774} {:answer/id #uuid "8626180b-9f54-5542-bbda-3b519ffbbcb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186355847} {:answer/id #uuid "a00f8753-5db0-5f2a-a18d-d3faa6c8c488" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186356085} {:answer/id #uuid "c4d3dc9e-cb4f-5ec5-920b-00a0a9195ba2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186356384}] :answer-field/correct {:answer/id #uuid "0a1bc7b6-4de7-5eac-8417-854e3e18c590" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186354757} :answer-field/id #uuid "7ee1fe3e-224e-55a4-98f8-d5e86ba6333e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357144}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "91ea3a27-d7dd-5526-bebd-b64e4b8069b6" :question/math-academy-id "q-94377" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+16y=32t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(2t+ϕ)+16t$\n\nII. $y=R\\operatorname{sin}⁡(4t+ϕ)+2t$\n\nIII. $y=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡2t+8t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$ It can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=16\\,⟹\\,\\omega =4.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(4t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(4t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a linear function, we assume that the particular solution is also a linear function,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =2$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=2t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & =R\\operatorname{cos}⁡(4t+ϕ)+2t, \\\\ y(t) & =R\\operatorname{sin}⁡(4t+ϕ)+2t, \\\\ y(t) & =A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t+2t.\\end{aligned}\n$$\n\nOnly II matches the forms above. Therefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186357739 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3922d0-9e98-50fc-badf-c5493ce5c08a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186354795} {:answer/id #uuid "66a11be1-b8f6-5bf3-865a-32797a40b01d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186355576} {:answer/id #uuid "81aec1db-2243-5668-a3b3-f7f2049fd7a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186355803} {:answer/id #uuid "9e22c7d3-b846-5397-9fb1-05bb1733229d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186356074} {:answer/id #uuid "b95128ac-6579-590f-8e02-4fa489a727c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186356287}] :answer-field/correct {:answer/id #uuid "b95128ac-6579-590f-8e02-4fa489a727c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186356287} :answer-field/id #uuid "03b4326e-a9f7-5be8-a7ee-fabfc0ce13c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356917}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cbe86c7f-4360-5aea-8ad0-c457c70df4e7" :question/math-academy-id "q-94382" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+25y=24\\operatorname{cos}⁡t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(25t+ϕ)+12\\operatorname{sin}⁡t$\n\nII. $y=R\\operatorname{sin}⁡(5t+ϕ)+6\\operatorname{cos}⁡t$\n\nIII. $y=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t+\\operatorname{cos}⁡t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution to this equation is the sum of the complementary function and a particular solution.\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$ It can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=25\\,⟹\\,\\omega =5.\n$$\n\nThus, we have:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(5t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(5t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =1$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\operatorname{cos}⁡t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(5t+ϕ)+\\operatorname{cos}⁡t$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(5t+ϕ)+\\operatorname{cos}⁡t$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t+\\operatorname{cos}⁡t$\n\nOnly III matches the forms above. Therefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186357740 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28786836-a9e1-53dc-9562-2281024f6d19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186355004} {:answer/id #uuid "8df5d5a1-0e16-5f9e-8fc4-5a02550067f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186355917} {:answer/id #uuid "e9aca9c0-5eb9-57cf-8642-0bbd549233b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186356708} {:answer/id #uuid "edfad9d8-8a31-5267-8053-334b53172752" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186356738} {:answer/id #uuid "ef6aef9c-ee3a-5af8-9168-9d60a704c091" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186356753}] :answer-field/correct {:answer/id #uuid "edfad9d8-8a31-5267-8053-334b53172752" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186356738} :answer-field/id #uuid "851183af-a230-57df-8945-3d3a755a2ec0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357154}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0cf314c8-ddb9-53cd-832f-d87f0d4562fa" :question/math-academy-id "q-94383" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+8{y}^{′}+41y=10{e}^{t}.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}$\n- $y=R\\operatorname{sin}⁡(9t+ϕ)+\\frac{{e}^{t}}{5}$\n- $y=R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+10{e}^{t}$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+8{y}^{′}+41y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+8\\lambda +41 & =0 \\\\ ({\\lambda }^{2}+8\\lambda +16)-16+41 & =0 \\\\ (\\lambda +4)^{2}+25 & =0 \\\\ (\\lambda +4)^{2} & =-25 \\\\ \\lambda +4 & =\\pm 5\\text{i} \\\\ \\lambda  & =-4\\pm 5\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha {e}^{t}.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =\\frac{1}{5}.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{{e}^{t}}{5}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}.\\end{aligned}\n$$\n\nOnly I matches the forms above. Therefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186360479 :knowledge-point/_questions [{:db/id #edb/ref 17592186162008 :knowledge-point/id #uuid "6289ad34-2393-5f5f-b7f0-a1ab1a3916f4" :knowledge-point/title "Identifying Possible Quadratic Form Types Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e9ffc2c-f7e9-51f5-ba89-e08fb8f3432c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358994} {:answer/id #uuid "be01d135-70e6-5207-99f2-9da737bd038e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359408} {:answer/id #uuid "cb65c933-0ae4-5e0b-ad3a-d5ac3265df55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186359539} {:answer/id #uuid "ce0974db-219c-5c9a-91e4-4eb32811b299" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359565} {:answer/id #uuid "dea888bd-01f3-5ef6-97fd-015ad1524c8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359708}] :answer-field/correct {:answer/id #uuid "8e9ffc2c-f7e9-51f5-ba89-e08fb8f3432c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358994} :answer-field/id #uuid "c098feba-a034-5912-a2d6-6f3e33aec00e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360328}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96ce050e-6292-5b2a-b7c7-0c1f7f51192d" :question/math-academy-id "q-94731" :question/problem "$$\n\n$$\n\nConsider the vector $x=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$ By evaluating the following quadratic forms at $x$ **only,** determine which of them **cannot** be negative-definite.\n\n- $R(x)={x}_{1}^{2}-{x}_{2}^{2}$\n- $S(x)={x}^{T}\\,[\\begin{aligned}3 & -2 \\\\ -2 & 2\\end{aligned}]x$\n- $T(x)={x}_{1}^{2}+3{x}_{2}^{2}$" :question/worked-solution "A quadratic form $Q(x)$ is negative-definite if $Q(x)<0$ for all $x\\in {R}^{n}∖{0}.$\n\nWith that in mind, let's examine each of the quadratic forms by substituting $x=[\\begin{aligned}-1 \\\\ 3\\end{aligned}]:$\n\n- Quadratic form I *might* be negative-definite. Indeed, \n\n$$\n\\begin{aligned}R(x) & =(-1)^{2}-{3}^{2} \\\\  & =1-9 \\\\  & =-8<0.\\end{aligned}\n$$\n\n- Quadratic form II *cannot* be negative-definite since\n\n$$\n\\begin{aligned}S(x) & =[\\begin{aligned}-1 & 3\\end{aligned}][\\begin{aligned}3 & -2 \\\\ -2 & 2\\end{aligned}][\\begin{aligned}-1 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}-9 & 8\\end{aligned}][\\begin{aligned}-1 \\\\ 3\\end{aligned}] \\\\  & =33>0.\\end{aligned}\n$$\n\n- Quadratic form III *cannot* be negative-definite since\n\n$$\n\\begin{aligned}T(x) & =(-1)^{2}+3(3)^{2} \\\\  & =1+27 \\\\  & =28>0.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186360480 :knowledge-point/_questions [{:db/id #edb/ref 17592186162008 :knowledge-point/id #uuid "6289ad34-2393-5f5f-b7f0-a1ab1a3916f4" :knowledge-point/title "Identifying Possible Quadratic Form Types Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0315cd7d-1301-5b67-a549-7cd0a5e92892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186357785} {:answer/id #uuid "1cc1f5e7-b89a-5b03-a3a0-4ebb7eb1e543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358000} {:answer/id #uuid "97b1f7db-3346-53a7-b0aa-9bb2c8853533" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359080} {:answer/id #uuid "e01cae1e-f0d7-5a0a-a7ba-1d2522aa07ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186359720} {:answer/id #uuid "fafd1fa4-cb58-5f3d-ae7d-cb6d37785672" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359971}] :answer-field/correct {:answer/id #uuid "1cc1f5e7-b89a-5b03-a3a0-4ebb7eb1e543" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358000} :answer-field/id #uuid "9f652820-724c-504a-923b-f8719a50d22b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360270}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c28bdf3-28d7-5fd9-bd3d-116dde5b3b96" :question/math-academy-id "q-94734" :question/problem "$$\n\n$$\n\nConsider the vector $x=[\\begin{aligned}0 \\\\ -6\\end{aligned}].$ By evaluating the following quadratic forms at $x$ **only,** determine which of them **cannot** be positive-definite.\n\n- $R(x)={x}_{2}^{2}+7{x}_{1}{x}_{2}$\n- $S(x)={x}^{T}\\,[\\begin{aligned}7 & -9 \\\\ -9 & -2\\end{aligned}]x$\n- $T(x)={x}_{1}^{2}-{x}_{2}^{2}-3{x}_{1}{x}_{2}$" :question/worked-solution "A quadratic form $Q(x)$ is positive-definite if $Q(x)>0$ for all $x\\in {R}^{n}∖{0}.$\n\nWith that in mind, let's examine each of the quadratic forms by substituting $x=[\\begin{aligned}0 \\\\ -6\\end{aligned}]:$\n\n- Quadratic form I *might* be positive-definite. Indeed, \n\n$$\n\\begin{aligned}R(x) & =(-6)^{2}+7\\cdot 0\\cdot (-6) \\\\  & =36+0 \\\\  & =36>0.\\end{aligned}\n$$\n\n- Quadratic form II *cannot* be positive-definite since\n\n$$\n\\begin{aligned}S(x) & =[\\begin{aligned}0 & -6\\end{aligned}][\\begin{aligned}7 & -9 \\\\ -9 & -2\\end{aligned}][\\begin{aligned}0 \\\\ -6\\end{aligned}] \\\\  & =[\\begin{aligned}54 & 12\\end{aligned}][\\begin{aligned}0 \\\\ -6\\end{aligned}] \\\\  & =-72<0.\\end{aligned}\n$$\n\n- Quadratic form III *cannot* be positive-definite since\n\n$$\n\\begin{aligned}T(x) & ={0}^{2}-(-6)^{2}-3\\cdot 0\\cdot (-6) \\\\  & =-36-0 \\\\  & =-36<0.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186360498 :knowledge-point/_questions [{:db/id #edb/ref 17592186162009 :knowledge-point/id #uuid "4105f1cb-eb48-5946-92f7-cd5e67689912" :knowledge-point/title "Identifying a Quadratic Form Type by Calculating the Corresponding Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "053ca7da-7b0f-516d-90f3-ea1ad4dde605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186357800} {:answer/id #uuid "4b9528b3-15e4-5d49-b9ae-73624ee40bca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358402} {:answer/id #uuid "5528cc18-c4f1-5b4a-891c-ee4d12a325c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358489} {:answer/id #uuid "63190094-7bc6-5937-b357-030d4ded5420" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358612} {:answer/id #uuid "82450b3c-9077-5e80-b738-97185b2aa980" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358892}] :answer-field/correct {:answer/id #uuid "63190094-7bc6-5937-b357-030d4ded5420" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358612} :answer-field/id #uuid "a68c4ad9-6422-5b6c-b7c9-942294d8b4a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360288}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a997acb-de91-5ebd-a6cc-103226757603" :question/math-academy-id "q-94787" :question/problem "Which of the following quadratic forms over ${R}^{2}$ are positive-definite?\n\n- ${x}^{T}\\,Qx,$ where the eigenvalues of $Q$ are ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=3$\n- ${x}^{T}\\,Rx,$ where the eigenvalues of $R$ are ${\\lambda }_{1}=-6$ and ${\\lambda }_{2}=10$\n- ${x}^{T}\\,Sx,$ where the eigenvalues of $S$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=8$" :question/worked-solution "Given a quadratic form $Q(x)={x}^{T}Ax,$ we have the following theorem:\n\n- $Q$ is positive-definite if and only if all the eigenvalues of $A$ are positive,\n\n- $Q$ is positive semi-definite if and only if all the eigenvalues of $A$ are non-negative (note that positive semi-definite quadratic forms include all positive-definite quadratic forms),\n\n- $Q$ is negative-definite if and only if all the eigenvalues of $A$ are negative,\n\n- $Q$ is negative semi-definite if and only if all the eigenvalues of $A$ are non-positive (note that negative semi-definite quadratic forms include all negative-definite quadratic forms), and\n\n- $Q$ is indefinite if and only if $A$ has both positive and negative eigenvalues.\n\nWith that in mind, let's examine our quadratic forms in turn.\n\n- Quadratic form I is *not* positive-definite since not all of the eigenvalues of $Q$ are positive (for example, ${\\lambda }_{1}=0$ is not positive).\n\n- Quadratic form II is *not* positive-definite since not all of the eigenvalues of $R$ are positive (${\\lambda }_{1}=-6$ is not positive).\n\n- Quadratic form III is positive-definite. Indeed, all of the eigenvalues of $S$ are positive.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186360587 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d91390d-e129-574c-8025-eb442175606b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358568} {:answer/id #uuid "6af6b0bb-3aa5-5199-b22b-55fa4fc040fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358686} {:answer/id #uuid "798e3f95-4ebf-516f-9cf8-440944be828a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358806} {:answer/id #uuid "d7471c0a-4287-516f-b58a-35d59032d564" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359636} {:answer/id #uuid "e081d124-5188-54ce-ba26-07a4e0e681f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359724}] :answer-field/correct {:answer/id #uuid "798e3f95-4ebf-516f-9cf8-440944be828a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358806} :answer-field/id #uuid "915f13e3-8f22-524f-aa30-8a9afc0d880c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360242}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc2e74a2-6b3b-5817-8831-ae21a9740417" :question/math-academy-id "q-95226" :question/problem "Which of the following vector spaces has a dimension of $15?$\n\n- ${\\text{M}}_{3\\times 5}(R),$ the vector space of all $3\\times 5$ matrices over $R$\n- ${R}_{15}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $15$\n- ${R}^{15}$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{3\\times 5}(R))=3\\cdot 5=15.\\,✓\n$$\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{15}[t])=15+1=16\\ne 15.\\,\\times \n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{15})=15.\\,✓\n$$\n\nHence, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186360588 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30205bba-9707-558b-ae3a-011b094ec85c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358179} {:answer/id #uuid "7c643ae4-6503-5da6-9de4-eaa19063bd09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358828} {:answer/id #uuid "9cb12880-c754-55a2-97c9-e7a3f26b897a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359121} {:answer/id #uuid "ea7edbe0-58af-5fa1-a071-9e73530a7002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359837} {:answer/id #uuid "f6d359c8-e1d7-5362-a631-266c3df13187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359935}] :answer-field/correct {:answer/id #uuid "f6d359c8-e1d7-5362-a631-266c3df13187" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359935} :answer-field/id #uuid "84c0380a-49a3-528a-8a3a-084892c84720" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360218}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16544b73-f58b-552e-b996-d814ec3fa819" :question/math-academy-id "q-95230" :question/problem "Which of the following vector spaces has a dimension of $36?$\n\n- ${R}_{6}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $6$\n- ${\\text{M}}_{12\\times 3}(R),$ the vector space of all $12\\times 3$ matrices over $R$\n- ${R}^{36}$" :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{6}[t])=6+1=7\\ne 36.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n\\times m}(R))=n\\cdot m.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{12\\times 3}(R))=12\\cdot 3=36.\\,✓\n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{36})=36.\\,✓\n$$\n\nHence, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186360589 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019408d5-ebcf-5838-ade2-24207e4bf627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186357771} {:answer/id #uuid "94fcfda4-8cbd-57b1-a034-49e28c9750b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359057} {:answer/id #uuid "9fe39671-344a-5354-8083-e6905cc67d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359146} {:answer/id #uuid "aa5476bc-f704-5486-a5ec-137806b551a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359216} {:answer/id #uuid "e7b83596-4bdb-568d-b857-66bfb0358fe8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186359806}] :answer-field/correct {:answer/id #uuid "9fe39671-344a-5354-8083-e6905cc67d8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359146} :answer-field/id #uuid "88d573c6-562e-58c9-ba7b-a687cc2dda3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360227}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ccb2591-5640-5714-9681-7f41d3b4bf27" :question/math-academy-id "q-95239" :question/problem "Which of the following vector spaces are finite-dimensional?\n\n- ${R}^{200}$\n- $R[t],$ the vector space of all polynomial functions in the variable $t$\n- ${\\text{M}}_{200}(R),$ the vector space of all $200\\times 200$ matrices over $R$" :question/worked-solution "Let's examine our vector spaces.\n\n- $R[t]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{a}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in R$ if and only if ${a}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $R[t]$ of size $n,$ which imples that $R[t]$ cannot have finite dimension.\n\n- ${\\text{M}}_{200}(R)$ and ${R}^{200}$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{200}(R))={200}^{2}=40\\,000,\n$$\n\n \nand\n\n$$\n\\text{dim}({R}^{200})=200\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186360590 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "203c5c86-d7f4-53b4-9d0c-cf6a89ea1e40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358033} {:answer/id #uuid "4edf9f43-dd2d-5314-96ac-c15522cb0688" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358432} {:answer/id #uuid "78c6339a-6117-529d-8e33-ac63cd5797c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358796} {:answer/id #uuid "9a6b398e-71d6-561f-b24a-bfd52510eb1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359104} {:answer/id #uuid "c11cfdb8-529c-5d49-9bd7-6922b086de69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186359447}] :answer-field/correct {:answer/id #uuid "c11cfdb8-529c-5d49-9bd7-6922b086de69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186359447} :answer-field/id #uuid "17f6df42-8f1e-56c0-bd75-01534e2ec398" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360034}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e94aa3d-a675-513e-b4ce-d62e1028540d" :question/math-academy-id "q-95240" :question/problem "Which of the following vector spaces are finite-dimensional?\n\n- ${R}_{1000}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $1\\,000$\n- ${\\text{M}}_{200\\times 500}(R),$ the vector space of all $200\\times 500$ matrices over $R$\n- $C,$ as a vector space over $R$" :question/worked-solution "Let's examine our vector spaces.\n\n- ${R}_{1000}[t]$ and ${\\text{M}}_{200\\times 500}(R)$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}_{1000}[t])=1\\,000+1=1\\,001,\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{200\\times 500}(R))=200\\cdot 500=100\\,000\n$$\n\n \nare both finite numbers.\n\n- $C$ is also finite-dimensional. To understand why, we first note that the following set of complex numbers is linearly independent:\n\n$$\n{1,i}\n$$\n\nIndeed, we have that \n\n$$\na\\cdot 1+b\\cdot i=0\n$$\n\nif and only if $a=0$ and $b=0.$ Since our vector space is also spanned by this linearly independent subset, we have that $\\text{dim}(C)=2.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186360591 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "437b88da-10dc-59d5-b3f5-6935476971f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186358328} {:answer/id #uuid "79966ec9-5ed7-58ec-bfaa-9d7a19fda993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358807} {:answer/id #uuid "82a2cae3-c5ae-5386-9545-a1faac07b732" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358899} {:answer/id #uuid "86f22162-90db-5f1b-85e4-0dc1aba1eff1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358932} {:answer/id #uuid "9bbc2161-a2a2-511a-b83f-475e2f601514" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359115}] :answer-field/correct {:answer/id #uuid "79966ec9-5ed7-58ec-bfaa-9d7a19fda993" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358807} :answer-field/id #uuid "f838768d-4ab2-5aa6-a31a-081be9f129a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360434}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a943335-01cc-5c39-a96e-fdeaef543401" :question/math-academy-id "q-95251" :question/problem "Which of the following vector spaces are finite-dimensional?\n\n- ${\\text{M}}_{250\\times 100}(R),$ the vector space of all $250\\times 100$ matrices over $R$\n- $R[t],$ the vector space of all polynomial functions in the variable $t$\n- ${R}_{10}[t],$ the vector space of all polynomials in the variable $t$ of degree at most $10$" :question/worked-solution "Let's examine our vector spaces.\n\n- $R[t]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{a}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in R$ if and only if ${a}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $R[t]$ of size $n,$ which imples that $R[t]$ cannot have finite dimension.\n\n- ${\\text{M}}_{250\\times 100}(R)$ and ${R}_{10}[t]$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({\\text{M}}_{250\\times 100}(R))=250\\cdot 100=25\\,000\n$$\n\n \nand\n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11,\n$$\n\nare both finite numbers.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186360596 :knowledge-point/_questions [{:db/id #edb/ref 17592186133791 :knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e1c0122-a2fd-5d2a-bd13-f2b05659e0fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186357868} {:answer/id #uuid "30b848d1-483d-5399-8cbf-c0444ff79c01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186358185} {:answer/id #uuid "53bb2a31-c296-5799-a86b-d45a4d5409c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186358477} {:answer/id #uuid "6b1cb0de-ba5f-51a9-8906-e2052cd725f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186358687} {:answer/id #uuid "91d00707-c5a4-5cbf-968f-467b7ebcb247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186359033}] :answer-field/correct {:answer/id #uuid "91d00707-c5a4-5cbf-968f-467b7ebcb247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186359033} :answer-field/id #uuid "4b07bd19-fb63-595b-bb26-bc06eff01306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360112}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea1f03fd-61df-5261-a45a-0d8c938b6ee9" :question/math-academy-id "q-95346" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}],\\,B=[\\begin{aligned}\\frac{2}{5} & -\\frac{3}{5} \\\\ \\frac{3}{5} & \\frac{1}{5}\\end{aligned}],\\,C=[\\begin{aligned}\\frac{1}{2} & \\frac{2}{3} \\\\ \\frac{3}{4} & \\frac{1}{2}\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is an orthogonal projection matrix. Indeed,\n${A}^{T}=A$\nand\n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}][\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}] \\\\  & =\\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}]\\cdot \\frac{1}{5}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}][\\begin{aligned}1 & -2 \\\\ -2 & 4\\end{aligned}] \\\\  & =\\frac{1}{25}[\\begin{aligned}5 & -10 \\\\ -10 & 20\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{5} & -\\frac{2}{5} \\\\ -\\frac{2}{5} & \\frac{4}{5}\\end{aligned}] \\\\  & =A.\\end{aligned}\n$$\n\n- $B$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{B}^{T}\\ne B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only.\""}] [{:db/id #edb/ref 17592186360597 :knowledge-point/_questions [{:db/id #edb/ref 17592186133791 :knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b72a280-684c-504f-bc72-0927e5648168" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186358142} {:answer/id #uuid "42716147-afe9-53da-a1e1-dfa55e203af2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$  only" :db/id #edb/ref 17592186358318} {:answer/id #uuid "9f3eeda0-49a7-528b-a161-b1e2419a752d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186359140} {:answer/id #uuid "c1fdd864-1f4b-54c9-8760-bf12443ef842" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186359454} {:answer/id #uuid "fdda1058-4ef5-51ec-8b73-5b4c567f2581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186359987}] :answer-field/correct {:answer/id #uuid "c1fdd864-1f4b-54c9-8760-bf12443ef842" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186359454} :answer-field/id #uuid "a6526046-f70d-5bbb-931a-d54d3ced1d87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360287}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3f5c5d3-e02d-5016-8de5-5fb09c5bfb03" :question/math-academy-id "q-95351" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}],\\,B=[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}],\\,C=[\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n${A}^{T}=A$\nbut \n\n$$\n\\begin{aligned}{A}^{2} & =A\\cdot A \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -1 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -5 \\\\ -5 & 10\\end{aligned}] \\\\  & \\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. Indeed,\n${B}^{T}=B$\nand\n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}][\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}] \\\\  & =\\frac{1}{10}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}]\\cdot \\frac{1}{10}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{100}[\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}9 & -3 \\\\ -3 & 1\\end{aligned}] \\\\  & =\\frac{1}{100}[\\begin{aligned}90 & -30 \\\\ -30 & 10\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{9}{10} & -\\frac{3}{10} \\\\ -\\frac{3}{10} & \\frac{1}{10}\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n${C}^{T}=C$\nbut \n\n$$\n\\begin{aligned}{C}^{2} & =C\\cdot C \\\\  & =[\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}3 & 2 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}13 & 4 \\\\ 4 & 5\\end{aligned}] \\\\  & \\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\""}] [{:db/id #edb/ref 17592186360598 :knowledge-point/_questions [{:db/id #edb/ref 17592186133791 :knowledge-point/id #uuid "9e81030a-0151-5dea-b9bc-74aae2499482" :knowledge-point/title "Identifying an Orthogonal Projection Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3434a7ca-b102-5f1c-bed1-05801ea9a4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186358216} {:answer/id #uuid "5735b633-8a5c-5cc5-bfee-5397a02c2cb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186358508} {:answer/id #uuid "623d44b3-21a5-5c4a-8645-0cc4ec048eb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186358607} {:answer/id #uuid "ad2fe885-63f4-5222-8cc8-c0855a5b9005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186359251} {:answer/id #uuid "dc720351-0e19-58e5-a761-10105b6b1221" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186359687}] :answer-field/correct {:answer/id #uuid "623d44b3-21a5-5c4a-8645-0cc4ec048eb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186358607} :answer-field/id #uuid "27fcf44b-f96f-524f-bbc0-c9fdc67cedc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ed3b258-fab2-58a0-b1d7-42245fa9a9bf" :question/math-academy-id "q-95353" :question/problem "Which of the following are orthogonal projection matrices?\n\n$$\nA=[\\begin{aligned}\\frac{4}{13} & \\frac{6}{13} \\\\ -\\frac{6}{13} & \\frac{4}{13}\\end{aligned}],\\,B=[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}],\\,C=[\\begin{aligned}\\frac{3}{4} & \\frac{1}{2} \\\\ \\frac{1}{3} & \\frac{3}{4}\\end{aligned}].\n$$" :question/worked-solution "Recall that $Q$ is an orthogonal projection matrix if and only if ${Q}^{2}=Q$ and ${Q}^{T}=Q.$ \n\nWith that in mind, let's examine our matrices.\n\n- $A$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{A}^{T}\\ne A.\\end{aligned}\n$$\n\n- $B$ is an orthogonal projection matrix. We have\n${B}^{T}=B$\nand \n\n$$\n\\begin{aligned}{B}^{2} & =B\\cdot B \\\\  & =[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}][\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}] \\\\  & =\\frac{1}{26}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}]\\cdot \\frac{1}{26}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}] \\\\  & =\\frac{1}{676}[\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}][\\begin{aligned}1 & 5 \\\\ 5 & 25\\end{aligned}] \\\\  & =\\frac{1}{676}[\\begin{aligned}26 & 130 \\\\ 130 & 650\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{26} & \\frac{5}{26} \\\\ \\frac{5}{26} & \\frac{25}{26}\\end{aligned}] \\\\  & =B.\\end{aligned}\n$$\n\n- $C$ is *not* an orthogonal projection matrix. We have\n\n$$\n\\begin{aligned}{C}^{T}\\ne C.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only.\""}] [{:db/id #edb/ref 17592186360600 :knowledge-point/_questions [{:db/id #edb/ref 17592186152221 :knowledge-point/id #uuid "e609aabf-7e7e-5997-b8dc-c66e7a14a36f" :knowledge-point/title "Identifying Finite and Infinite-Dimensional Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b03865e-89d3-5f4e-b34a-174e1c828692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358267} {:answer/id #uuid "444dd975-31db-513c-b633-878416665e5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358336} {:answer/id #uuid "52c91435-4363-5abc-96bf-e8fffa352d80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358462} {:answer/id #uuid "7762e2b9-7a1f-5284-b452-2830b35e1180" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186358780} {:answer/id #uuid "d3b6205f-762b-53e5-a81a-62777101fd95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359601}] :answer-field/correct {:answer/id #uuid "3b03865e-89d3-5f4e-b34a-174e1c828692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358267} :answer-field/id #uuid "aecf63a2-918f-5dc1-a21b-f4114e4ed680" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e531c342-c218-5c9e-86de-28e412cdeaaa" :question/math-academy-id "q-95386" :question/problem "Which of the following vector spaces are finite-dimensional?\n\n- ${R}^{150}$\n- ${\\text{M}}_{150}(R),$ the vector space of all $150\\times 150$ matrices over $R$\n- $R[t],$ the vector space of all polynomial functions in the variable $t$" :question/worked-solution "Let's examine our vector spaces.\n\n- ${R}^{150}$ and ${\\text{M}}_{150}(R)$ are finite-dimensional. Indeed, \n\n$$\n\\text{dim}({R}^{150})=150\n$$\n\nand\n\n$$\n\\text{dim}({\\text{M}}_{150}(R))={150}^{2}=22\\,500,\n$$\n\n \nare both finite numbers.\n\n- $R[t]$ is *not* finite-dimensional. To understand why, we first note that the following set of (polynomial) functions is linearly independent:\n\n$$\n{1,\\,t,\\,{t}^{2},\\,…,{t}^{n}},\\,n\\in N.\n$$\n\nIndeed, we have that \n\n$$\n{\\sum }_{i=0}^{n}{a}_{i}{t}^{i}=0\n$$\n\nfor all $t\\in R$ if and only if ${a}_{i}=0$ for all $i=0,1,2,…,n.$ Therefore,  for any  $n\\in N,$  there exists a linearly independent subset of $R[t]$ of size $n,$ which imples that $R[t]$ cannot have finite dimension.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186360671 :knowledge-point/_questions [{:db/id #edb/ref 17592186166788 :knowledge-point/id #uuid "6a6ca425-0e94-5b83-8729-fda13fbf3d7d" :knowledge-point/title "Identifying Equilibrium Solutions of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "134ed4b0-1be7-592b-8d3e-f732a0296d30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186357916} {:answer/id #uuid "1ea8f58c-2ef2-548f-a348-b6486650bb89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358019} {:answer/id #uuid "287a63ca-5e18-5c1b-b8ff-486944f66741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186358116} {:answer/id #uuid "802d42c6-5393-58d0-b775-5ebf4293125e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358871} {:answer/id #uuid "88832317-d53d-5b20-9217-832af3249f26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358946}] :answer-field/correct {:answer/id #uuid "802d42c6-5393-58d0-b775-5ebf4293125e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186358871} :answer-field/id #uuid "bcc96136-f547-5abc-972a-22111e8ffc6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bdcd03c-4e33-5af2-a43a-72ec614b803e" :question/math-academy-id "q-96070" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}t}+y={y}^{2}-2.$ Which of the following is an equilibrium solution of this equation?\n\n- $y=2$\n- $y=1$\n- $y=4$" :question/worked-solution "Given an autonomous differential equation ${y}^{′}(t)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nFirst, we write the given equation as\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}={y}^{2}-y-2,\n$$\n\nand we get that $f(y)={y}^{2}-y-2.$\n\nNow, let's check each proposed solution by substituting them into $f(y).$\n\n- $y=2$ is an equilibrium point. We have $f(2)={2}^{2}-2-2=0.$$\\,✓$\n\n- $y=1$ is *not* an equilibrium point. We have $f(1)={1}^{2}-1-2=-2\\ne 0.$ $\\,\\times $\n\n- $y=4$ is *not* an equilibrium point. We have $f(4)={4}^{2}-4-2=10\\ne 0.$  $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186360672 :knowledge-point/_questions [{:db/id #edb/ref 17592186166788 :knowledge-point/id #uuid "6a6ca425-0e94-5b83-8729-fda13fbf3d7d" :knowledge-point/title "Identifying Equilibrium Solutions of a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf1b259-0d5c-5440-b57c-9ebbdd82385d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186357858} {:answer/id #uuid "3802b50d-b7f3-5d37-b552-ae119cdfaa2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358245} {:answer/id #uuid "4789a951-884d-5bc6-872a-b3b122f8ec3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358367} {:answer/id #uuid "c407e0ea-31eb-544e-8760-a12e598ca774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359472} {:answer/id #uuid "e92b2da9-58e7-5e5b-b0c6-d309830a8fc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359821}] :answer-field/correct {:answer/id #uuid "3802b50d-b7f3-5d37-b552-ae119cdfaa2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358245} :answer-field/id #uuid "8e3c6d01-d7f6-5cdd-92b1-25f32debbd40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360236}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7617131b-e756-503f-ac7c-f76ae1870fab" :question/math-academy-id "q-96072" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}+{e}^{2}={y}^{2}\\operatorname{ln}⁡y.$ Which of the following is an equilibrium solution of this equation?\n\n- $y=1$\n- $y=e$\n- $y=2$" :question/worked-solution "Given an autonomous differential equation ${y}^{′}(x)=f(y),$ if there exists a constant $c$ such that $f(c)=0,$ then $y=c$ is an equilibrium solution of the equation.\n\nFirst, we write the given equation as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={y}^{2}\\operatorname{ln}⁡y-{e}^{2},\n$$\n\nand we get that $f(y)={y}^{2}\\operatorname{ln}⁡y-{e}^{2}.$\n\nNow, let's check each proposed solution by substituting them into $f(y).$\n\n- $y=1$ is *not* an equilibrium point. We have $f(1)=(1)^{2}\\cdot \\operatorname{ln}⁡1-{e}^{2}=-{e}^{2}\\ne 0.$ $\\,\\times $\n\n- $y=e$ is an equilibrium point. We have $f(e)={e}^{2}\\operatorname{ln}⁡e-{e}^{2}={e}^{2}-{e}^{2}=0.$$\\,✓$\n\n- $y=2$ is *not* an equilibrium point. We have $f(2)={2}^{2}\\operatorname{ln}⁡2-{e}^{2}\\ne 0.$  $\\,\\times $\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186360703 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a01a7a95-64aa-54ba-895d-04bf347492f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186359148} {:answer/id #uuid "a138fab6-fff6-59e1-a52c-d137db1d6f5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186359155} {:answer/id #uuid "c006e53a-af82-52f5-8d9e-f3c7f37a6a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186359434} {:answer/id #uuid "e371c444-2d42-58ac-9d4a-b9c3c71357b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359766} {:answer/id #uuid "efc2b1e9-ad97-5182-8244-3f0527ad7b8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359889}] :answer-field/correct {:answer/id #uuid "efc2b1e9-ad97-5182-8244-3f0527ad7b8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186359889} :answer-field/id #uuid "2f4ce4b5-bee6-597c-ae41-7ac750a4e54b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360068}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8834e73f-e91c-5d8c-8257-a000ef7a9e06" :question/math-academy-id "q-96741" :question/problem "Which of the following functions has the codomain ${-1,1}?$\n\n- $p:{-1,1}\\to R$\n- $q:R\\to [-1,1)$\n- $r:[-1,1)\\to {-1,1}$" :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The codomain of $p$ is $R,$ the set of real numbers.\n\n- The codomain of $q$ is $[-1,1),$ the interval from $-1$ to $1$ (including $-1$ but not including $1$).\n\n- The codomain of $r$ is ${-1,1},$ the set containing the two numbers $-1$ and $1$ only.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186360704 :knowledge-point/_questions [{:db/id #edb/ref 17592186172031 :knowledge-point/id #uuid "bbac348b-629f-52a1-9bb3-0d3f8483ff44" :knowledge-point/title "Interpreting the Arrow Function Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df69665-7511-5fa4-8447-087651287029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186358010} {:answer/id #uuid "2921d3a6-a683-5e01-be99-259182ba1812" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186358128} {:answer/id #uuid "5f96f17c-e33b-52ae-b85b-8736433c8ba3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186358585} {:answer/id #uuid "93e37c5d-6b3d-573c-ae91-2d74545a85eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186359048} {:answer/id #uuid "c69e92b7-0f2c-5bee-9939-c3c02c2d5a1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186359498}] :answer-field/correct {:answer/id #uuid "93e37c5d-6b3d-573c-ae91-