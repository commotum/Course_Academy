 \\\\ -1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id #edb/ref 17592186345106 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18956b73-de0f-5274-ad02-5066c0d2657b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186342456} {:answer/id #uuid "2d821b77-91b8-542f-b59c-7b5c3ebcd4ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186342620} {:answer/id #uuid "4b54bdc7-fb8f-5924-947c-0a287faf9bbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186342858} {:answer/id #uuid "6348b2b2-8ae7-537e-909c-bb22df4127b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186343078} {:answer/id #uuid "8bce61b5-2b6e-5b57-a1a3-1eef97b998b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343459}] :answer-field/correct {:answer/id #uuid "8bce61b5-2b6e-5b57-a1a3-1eef97b998b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343459} :answer-field/id #uuid "40b7d972-25a9-5d09-b9bb-575a2e8ee618" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd25b025-461f-556b-97f3-6071c19d59d7" :question/math-academy-id "q-75595" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=4{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=[\\begin{aligned}4 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}],\\,B=[\\begin{aligned}2 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 1 \\\\ \\frac{3}{4} & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}\\frac{1}{4} & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :=4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}2 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}\\frac{1}{4} & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{1} & :=4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}1 & 1 \\\\ \\frac{3}{4} & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}\\frac{3}{4} & 0 \\\\ 1 & 1\\end{aligned}] & {R}_{1} & :=4{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 \\\\ 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 \\\\ -5 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186345107 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59d338f8-b49b-5145-a7ef-1ae582d559cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186342991} {:answer/id #uuid "92dcfa7a-f257-5a95-9893-29619578a1b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186343522} {:answer/id #uuid "ea5a63f9-bd01-5a20-a2a4-c0a864ce4a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186344291} {:answer/id #uuid "f0b90c65-9660-55b2-9d45-57ee11b4570d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186344351} {:answer/id #uuid "f3f172f0-b5cc-56f2-9005-34aef17200e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186344385}] :answer-field/correct {:answer/id #uuid "ea5a63f9-bd01-5a20-a2a4-c0a864ce4a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186344291} :answer-field/id #uuid "d16727b3-99b0-547b-8c45-25b008d782b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344853}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a52696c-f90c-56a7-94f5-6062f59efbae" :question/math-academy-id "q-75599" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=\\frac{1}{2}{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=[\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}],\\,B=[\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}],\\,C=[\\begin{aligned}4 & 1 \\\\ 2 & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ B & =[\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ C & =[\\begin{aligned}4 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id #edb/ref 17592186345112 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c30cee0-847d-5f40-ae43-134afe788817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186343010} {:answer/id #uuid "5e4716f8-1d1a-5bf6-a69d-02354cf35afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343030} {:answer/id #uuid "6557bb3a-d669-5757-bc6e-f43fb74887f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343098} {:answer/id #uuid "7375a3b9-bff4-58a6-82e9-4245781699f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343237} {:answer/id #uuid "bdf19162-0472-5764-b148-da9e42eaf104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186343910}] :answer-field/correct {:answer/id #uuid "5e4716f8-1d1a-5bf6-a69d-02354cf35afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343030} :answer-field/id #uuid "736c3de5-9a79-5920-82d2-3cbc3976ab40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344700}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f25df3d-4b0c-5b67-901d-8d878d2769ac" :question/math-academy-id "q-75655" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ -6 \\\\ 12\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 3 \\\\ -4\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n{\\begin{aligned}3{x}_{1}-{x}_{2}+{x}_{3}=0 \\\\ -6{x}_{1}+3{x}_{2}+{x}_{3}=0 \\\\ 12{x}_{1}-4{x}_{2}+4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -1 & 1 & 0 \\\\ -6 & 3 & 1 & 0 \\\\ 12 & -4 & 4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}3 & -1 & 1 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 12 & -4 & 4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼[\\begin{aligned}3 & -1 & 1 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements II and III are false, while statement I is true."}] [{:db/id #edb/ref 17592186345113 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3da42d2a-fc8c-5560-a05e-8ebb08251ab7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186342746} {:answer/id #uuid "428056c7-8c15-5083-b495-0a5d2db7568d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186342788} {:answer/id #uuid "b05bd9d9-23cf-5926-8e64-3aa606f0b446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343789} {:answer/id #uuid "f974dbb8-fa3b-57e5-b4a2-cbf533523461" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186344432} {:answer/id #uuid "ff6841f4-2ac2-55ac-8a6c-00752966eb25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344488}] :answer-field/correct {:answer/id #uuid "b05bd9d9-23cf-5926-8e64-3aa606f0b446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343789} :answer-field/id #uuid "6c97eb9a-a992-5953-a80c-a71608c9beca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344686}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d48ab70-ab46-5142-a432-382f1feb7bb9" :question/math-academy-id "q-75659" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 2 \\\\ -2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$\n\nIII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}=0 \\\\ -{x}_{1}+2{x}_{2}-2{x}_{3}=0 \\\\ 2{x}_{1}-2{x}_{2}+{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 0 & 0 \\\\ -1 & 2 & -2 & 0 \\\\ 2 & -2 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 2 & -2 & 1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 0 & 0 & 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}=0 \\\\ {x}_{2}-2{x}_{3}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-2(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements II and III are true, while statement I is false."}] [{:db/id #edb/ref 17592186345114 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11972855-80a9-5cac-9e70-8a4fcbdccf24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186342393} {:answer/id #uuid "2bfeba34-6da2-5961-afdc-9d9564e3b098" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342608} {:answer/id #uuid "ac5b646e-db57-5a8d-9e82-9eb0862b3d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343756} {:answer/id #uuid "acba01cf-19c6-57a0-8cf2-d050702ea3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343758} {:answer/id #uuid "f9874691-41fb-52a1-b9c0-d3eb10d101ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344433}] :answer-field/correct {:answer/id #uuid "ac5b646e-db57-5a8d-9e82-9eb0862b3d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343756} :answer-field/id #uuid "d156fe28-1c7f-5127-9119-2df01429f973" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344852}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8d177800-f6a6-59b3-bf6e-5adc772e358a" :question/math-academy-id "q-75660" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -4 \\\\ -3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ 13 \\\\ 9\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ -7 \\\\ -4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nIII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=0 \\\\ -4{x}_{1}+13{x}_{2}-7{x}_{3}=0 \\\\ -3{x}_{1}+9{x}_{2}-4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 2 & 0 \\\\ -4 & 13 & -7 & 0 \\\\ -3 & 9 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ -3 & 9 & -4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=0 \\\\ {x}_{2}+{x}_{3}=0 \\\\ 2{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-3(0)+2(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements II and III are false, while statement I is true."}] [{:db/id #edb/ref 17592186345121 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1299352e-d2ef-5e23-a6a9-e3484a823eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342402} {:answer/id #uuid "6945182e-95b7-5e01-ab43-e486bfa69c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343137} {:answer/id #uuid "cab42dea-25c4-565b-904b-b7e77ae2c127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344021} {:answer/id #uuid "e402b43c-fdcf-51ca-9fd7-ca29f619233d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186344240} {:answer/id #uuid "ea45b5bf-09d1-5fd5-a6ce-b44ab9b5150c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186344290}] :answer-field/correct {:answer/id #uuid "cab42dea-25c4-565b-904b-b7e77ae2c127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344021} :answer-field/id #uuid "200fb1e1-dd6d-5c55-afee-57f8fc7300f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344549}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a5c031b-68ff-5d30-80f0-79dec42f9067" :question/math-academy-id "q-75729" :question/problem "Which of the following statements are true?\n\n- If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =-2.$\n- An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =1.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $7v$ is also an eigenvector of $A$ corresponding to $\\lambda =\\frac{1}{2}.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement is false. By the definition of an eigenvector, we have \n\n$$\nAv=2v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=2{A}^{-1}v.\n$$\n\nDividing both sides by $2$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{2}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{2}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is true. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =1$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{1}=1.$\n\n- Statement III is false. We have\n\n$$\n\\begin{aligned}A(7v)=7Av=7(2v)=2(7v).\\end{aligned}\n$$\n\nSince, $A(7v)=2(7v),$ and $7v\\ne 0,$ this implies that $7v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186345193 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5900b2ad-c394-58a3-8661-86744ec49f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186342986} {:answer/id #uuid "71ec907a-fb23-50c4-8b1c-c42f54b462fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343223} {:answer/id #uuid "80e38216-9a2e-56cf-9bab-79d5b46a98fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343349} {:answer/id #uuid "b1ee4e70-3d9b-51db-b23d-bc1a59a3bace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343800} {:answer/id #uuid "f0ea78ef-a8ff-5431-b650-ef064402d8dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344358}] :answer-field/correct {:answer/id #uuid "5900b2ad-c394-58a3-8661-86744ec49f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186342986} :answer-field/id #uuid "4cf7e708-707f-5e09-821c-37a874528e08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344623}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca01d454-a476-5d37-9896-aa972462aa23" :question/math-academy-id "q-76208" :question/problem "![](images/ab/abfd15c8ed134a30ad719f6a857268427511e7f1f15ecfe0d27e5026b5401a83.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-2)$\n- $x\\in [-2,3)$\n- $x\\in [3,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is continuous on the open interval $(-\\infty ,-2).$\n\n- The function is continuous on $[-2,3).$ It is continuous on $(-2,3)$ and also right continuous at $x=-2.$\n\n- The function is continuous on $[3,\\infty ).$ It is continuous on $(3,\\infty )$ and also right continuous at $x=3.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186345195 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26764b32-2c60-587f-b8c5-37fa19d94968" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function is not continuous on any of the given intervals" :db/id #edb/ref 17592186342564} {:answer/id #uuid "2efc0ccc-6f9e-51e2-9559-c2a8b34966df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342632} {:answer/id #uuid "a45ef78d-716e-51d4-a3ff-b11c8025f4f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343688} {:answer/id #uuid "b3675348-452e-5b76-9643-725033643714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343813} {:answer/id #uuid "c24a3e56-f567-5ca6-9f4a-165390ecbf5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343946}] :answer-field/correct {:answer/id #uuid "2efc0ccc-6f9e-51e2-9559-c2a8b34966df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342632} :answer-field/id #uuid "6aaefafc-ce87-53d2-9580-dce1180a6863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d16a77c7-8df1-5b6e-bc46-f6c511c4b268" :question/math-academy-id "q-76210" :question/problem "![](images/5e/5e787dda0cccdafaa6a93176daea5f954b1cd1da0beaff410a6563536459208e.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-1]$\n- $x\\in [-2,0]$\n- $x\\in [-1,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is continuous on $(-\\infty ,-1].$ It is continuous on $(-\\infty ,-1)$ and also left continuous at $x=-1.$\n\n- The function is *not* continuous on $[-2,0]$ because it contains a discontinuity at $x=-1.$\n\n- The function is *not* continuous on $[-1,\\infty ).$ Although the function is continuous on $(-1,\\infty ),$ it is not right-continuous at $x=-1.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186345197 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1075d718-40b0-5742-b4f2-dbdbdf2e06b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342380} {:answer/id #uuid "15769205-ba90-5639-abae-d9422352b485" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function is not continuous on any of the given intervals" :db/id #edb/ref 17592186342429} {:answer/id #uuid "39cc683a-00e8-585f-91ea-14d5c5a1dfa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342715} {:answer/id #uuid "9c5540c3-8c22-5a59-9e92-56b97da12a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343616} {:answer/id #uuid "d40e7fd5-7f34-56f0-93bc-e8e4ed2a8dc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344099}] :answer-field/correct {:answer/id #uuid "1075d718-40b0-5742-b4f2-dbdbdf2e06b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342380} :answer-field/id #uuid "4f8fe9a0-755d-5543-a40d-443c23f5ea83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8275053-44d7-522b-8662-3358231e9c18" :question/math-academy-id "q-76218" :question/problem "![](images/18/186ac941080da34b7c149534a2e255852241b28855c0ef15db2beee2d692007a.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,3]$\n- $x\\in (-\\infty ,5)$\n- $x\\in (4,6)$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is *not* continuous on $(-\\infty ,3].$ Although the function is continuous on $(-\\infty ,3),$ it is not left-continuous at $x=3.$\n\n- The function is *not* continuous on $(-\\infty ,5)$ because it contains a discontinuity at $x=3.$\n\n- The function is continuous on $(4,6).$ It is continuous on $[3,\\infty )$ and this contains the interval $(4,6).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186345292 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12f5e655-d76e-5618-a17f-2483870f80ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342404} {:answer/id #uuid "4a960852-e36e-5de9-accc-56acd04910ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186342852} {:answer/id #uuid "6234df6c-15c7-5877-b0fb-75883f2806a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343071} {:answer/id #uuid "df4e9b9c-c909-5afd-bf7b-e6148fe13a5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344196} {:answer/id #uuid "f6e83d4b-c078-5faf-ac16-d2afb50445ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186344411}] :answer-field/correct {:answer/id #uuid "f6e83d4b-c078-5faf-ac16-d2afb50445ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186344411} :answer-field/id #uuid "467ab3d5-e2b3-5afa-a2e2-f13c2a37966a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43864da8-ac06-5dee-a580-c31c2739a8e7" :question/math-academy-id "q-77389" :question/problem "![](images/e1/e17584d96cb8d83ccb1abfbd16c4117f58639b7cd3462ee50ad3f31e4eabe279.png)\n\nIn figure $ABCDEF$ shown above, which of the following equalities are true?\n\n- $\\overset{\\to }{BC}-\\overset{\\to }{DC}=\\overset{\\to }{BD}$\n- $\\overset{\\to }{BA}+\\overset{\\to }{AE}-\\overset{\\to }{FE}=\\overset{\\to }{BF}$\n- $\\overset{\\to }{CD}-\\overset{\\to }{ED}-\\overset{\\to }{FE}=\\overset{\\to }{FC}$" :question/worked-solution "- Equality I is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{BC}-\\overset{\\to }{DC} & =\\overset{\\to }{BC}+\\overset{\\to }{CD} \\\\  & =\\overset{\\to }{BD}.\\end{aligned}\n$$\n\n- Equality II is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{BA}+\\overset{\\to }{AE}-\\overset{\\to }{FE} & =\\overset{\\to }{BA}+(\\overset{\\to }{AE}+\\overset{\\to }{EF}) \\\\  & =\\overset{\\to }{BA}+\\overset{\\to }{AF} \\\\  & =\\overset{\\to }{BF}.\\end{aligned}\n$$\n\n- Equality III is false. Indeed,\n\n$$\n\\begin{aligned}\\overset{\\to }{CD}-\\overset{\\to }{ED}-\\overset{\\to }{FE} & =(\\overset{\\to }{CD}+\\overset{\\to }{DE})+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{CE}+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{CF} \\\\  & \\ne \\overset{\\to }{FC}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186345293 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f96b37-25e2-57e5-a9bd-ce85f77ef622" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342559} {:answer/id #uuid "6810a70d-fc25-5dc9-9176-1e77c5c64ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343123} {:answer/id #uuid "9b153830-307e-510b-95ec-885456562d1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343605} {:answer/id #uuid "d9f2fb38-44b4-51a3-ae94-6982dfb498bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344152} {:answer/id #uuid "f051a762-fe84-5e5b-a57f-76839faef4a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186344349}] :answer-field/correct {:answer/id #uuid "d9f2fb38-44b4-51a3-ae94-6982dfb498bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344152} :answer-field/id #uuid "6cc90745-e978-5189-b064-c8cfba27da07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344687}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfe3c702-6424-5bb5-8a56-52b5a6e22724" :question/math-academy-id "q-77400" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}x-y=2 \\\\ 2x+y=k\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-6$\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-12$\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=3$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}| \\\\  & =1+2 \\\\  & =3.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|}{3} \\\\ |\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}| & =-6\\end{aligned}\n$$\n\nSo, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186345294 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bb0734-b113-5738-811e-5ed128d214ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342507} {:answer/id #uuid "27742a41-54e2-59b5-b786-db849377783d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342573} {:answer/id #uuid "44122616-845c-5061-9e80-69872573e8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186342803} {:answer/id #uuid "8d84791f-2e4f-5e1a-8d1d-454662569e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343476} {:answer/id #uuid "b6e5462b-343b-5798-95b7-33b70f0f69a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343841}] :answer-field/correct {:answer/id #uuid "8d84791f-2e4f-5e1a-8d1d-454662569e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343476} :answer-field/id #uuid "6c1e02f2-9665-5243-aedc-17c100ebdba4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344684}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a75a54e5-59f0-5536-9005-ac12974e1a69" :question/math-academy-id "q-77401" :question/problem "Let $⟨x,1⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}3x-y=k \\\\ x+4y=3\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=5$\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=-7$\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=13$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}3 & -1 \\\\ 1 & 4\\end{aligned}| \\\\  & =12+1 \\\\  & =13.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}1 & =\\frac{{D}_{y}}{D} \\\\ 1 & =\\frac{|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|}{13} \\\\ |\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}| & =13\\end{aligned}\n$$\n\nSo, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186345308 :knowledge-point/_questions [{:db/id #edb/ref 17592186119931 :knowledge-point/id #uuid "a6a3d254-c96f-5aa0-9db6-a587eb7cb2de" :knowledge-point/title "Calculating an Expression Involving Given Determinants and Matrix Types"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e2d978-2c80-5bfd-8184-7620c86b4d9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342796} {:answer/id #uuid "87caf754-01fe-5135-8e0f-3937db98fe01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343413} {:answer/id #uuid "aaac6d10-cd8e-529d-b81e-8bac65acd12c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186343740} {:answer/id #uuid "df109891-92e9-56d1-95e6-b29b4c4c96cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186344195} {:answer/id #uuid "f39fd878-ef99-5884-b619-883485188f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186344383}] :answer-field/correct {:answer/id #uuid "aaac6d10-cd8e-529d-b81e-8bac65acd12c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186343740} :answer-field/id #uuid "1ae19f3c-dbd3-5456-af19-7dc1239a420f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344540}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49749c9e-4840-5ef3-a87f-c1ce7810b100" :question/math-academy-id "q-77503" :question/problem "Given that $det(A)=2$, which of the following statements are true? \n\n- $-2\\text{det}({A}^{T})-3\\text{det}(I)=7$\n- $4\\text{det}({A}^{T})=2$\n- $\\text{det}({A}^{T})-\\text{det}(I)=-\\frac{1}{2}$" :question/worked-solution "From the properties of determinants, we know that \n\n$$\n\\text{det}({A}^{T})=\\text{det}(A)=2\n$$\n\nand\n\n$$\ndet(I)=1.\n$$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false. We have,\n\n$$\n-2\\text{det}({A}^{T})-3\\text{det}(I)=-2\\cdot 2-3\\cdot 1=-7\\ne 7.\n$$\n\n- Statement II is false. We have\n\n$$\n4\\text{det}({A}^{T})=4\\cdot 2=8\\ne 2.\n$$\n\n- Statement III is false. We have\n\n$$\n\\text{det}({A}^{T})-\\text{det}(I)=2-1=1\\ne -\\frac{1}{2}.\n$$\n\nIn conclusion, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186345345 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c9b65e-8aab-58e4-9ff8-f146c4b1dfb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186342412} {:answer/id #uuid "bc16e6f4-a9a7-5ef2-a3e8-5f2cc8fd2073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343890} {:answer/id #uuid "dcbb9443-92d4-5c38-8324-856eb59d6047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344177} {:answer/id #uuid "e96dfec3-2242-5abf-9843-aa4fbc07fe3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186344281} {:answer/id #uuid "edf0bc6b-95d8-5574-ae34-66cc789aa7f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186344329}] :answer-field/correct {:answer/id #uuid "13c9b65e-8aab-58e4-9ff8-f146c4b1dfb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186342412} :answer-field/id #uuid "35f8c506-59e5-5df7-b6f5-b6b5ef1620ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344587}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0acb71b-a2ed-51d8-8bca-93474ee1c192" :question/math-academy-id "q-77864" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-2,2]?$\n\n- $f(x)=\\frac{1}{{x}^{2}+1}$\n- $g(x)=|{x}^{2}+1|$\n- $h(x)=\\operatorname{ln}⁡({x}^{2}+1)$" :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-2,2],$ the function must be continuous on $[-2,2]$ and differentiable on $(-2,2).$\n\nLet's check each function individually.\n\n- The function $f(x)=\\frac{1}{{x}^{2}+1}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-2,2]$ and differentiable on $(-2,2).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)=|{x}^{2}+1|$ is equivalent to $p(x)={x}^{2}+1,$ so it is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-2,2]$ and differentiable on $(-2,2).$ Therefore, $g(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $h(x)=\\operatorname{ln}⁡({x}^{2}+1)$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-2,2]$ and differentiable on $(-2,2).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, the functions I, II, and III satisfy the conditions for the mean value theorem over the interval $[-2,2].$"}] [{:db/id #edb/ref 17592186348109 :knowledge-point/_questions [{:db/id #edb/ref 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185619d8-1b91-5d2f-af5e-dee1634d5555" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186345565} {:answer/id #uuid "44f107dd-253f-5b2e-bda0-164d1239fdcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186345949} {:answer/id #uuid "515c1c66-f6e4-50c0-b52d-198cd74b8a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186346047} {:answer/id #uuid "8d916295-fa1a-5ff5-ba9b-5d907aac02a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186346582} {:answer/id #uuid "e3b4ad68-2c01-51fc-89a3-6a26083ddcde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186347353}] :answer-field/correct {:answer/id #uuid "e3b4ad68-2c01-51fc-89a3-6a26083ddcde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186347353} :answer-field/id #uuid "d1aaa798-00b3-55fa-9339-75ae07399b92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347971}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad44d2b4-38e0-5faa-8080-32a8feda902f" :question/math-academy-id "q-78772" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{2}:={R}_{2}+{R}_{1}\\,$ and $\\,{R}_{3}:={R}_{3}+(-1){R}_{2}?$\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 0 & 2 & 2\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 0 & 2 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 2 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -2 & -3 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186348154 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1ea255-7dc4-54d4-9172-7acf08d05cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345453} {:answer/id #uuid "b2253313-0064-565d-aab1-ac081b160a04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186346906} {:answer/id #uuid "b4c2d995-4b9c-5b32-8ff4-4cd6a59aa059" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186346926} {:answer/id #uuid "ccb08342-c5da-554a-bb78-0962f941c5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347141} {:answer/id #uuid "da3e0bea-256a-5720-8bd7-3b470182a9c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347270}] :answer-field/correct {:answer/id #uuid "0d1ea255-7dc4-54d4-9172-7acf08d05cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345453} :answer-field/id #uuid "d0666484-0b92-5c23-994f-2dff9365864f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347966}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3b9e269-d2c5-5e09-8e6b-2689345ee964" :question/math-academy-id "q-79039" :question/problem "Consider the function $f(x)={x}^{3}-6{x}^{2}+5x.$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(2,\\infty )$\n- $f(x)$ is concave up on $(2,\\infty )$\n- $f(x)$ is concave up on $(-\\infty ,2)$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}-12x+5 \\\\ {f}^{″}(x) & =6x-12.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}6x-12 & >0\\,⟹\\,x>2.\\end{aligned}\n$$\n\nSo, the function is concave up on $(2,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $6x-12<0,$ which has the solution $(-\\infty ,2).$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186348159 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f70b66-96e9-5aae-93da-647ff3e21f32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186345413} {:answer/id #uuid "1ccbca84-26a7-531b-bc40-848a39c9d145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345601} {:answer/id #uuid "820bdb8d-1b1f-5a23-91ee-e42c0fd7b00c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346488} {:answer/id #uuid "964ca8d1-bc5e-5d1c-a5e6-7d742ff7cbd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346665} {:answer/id #uuid "b684115e-c70b-5e4f-9a6a-91ed32fef39b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346942}] :answer-field/correct {:answer/id #uuid "b684115e-c70b-5e4f-9a6a-91ed32fef39b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346942} :answer-field/id #uuid "f84b80f4-3cda-509e-bb73-3c54426e4477" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348041}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d60b7843-0bd3-5e4e-8b85-becdd36b22ac" :question/math-academy-id "q-79047" :question/problem "Consider the function $f(x)=2+3x-{e}^{-x}.$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(-\\infty ,\\infty )$\n- $f(x)$ is concave up on $(0,\\infty )$\n- $f(x)$ is concave up on $(-\\infty ,0)$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3+{e}^{-x} \\\\ {f}^{″}(x) & =-{e}^{-x}\\end{aligned}\n$$\n\nSince ${e}^{-x}>0$ for every real value of $x,$ it follows that $-{e}^{-x}<0$ for every real value of $x.$ Therefore, ${f}^{″}(x)$ is never positive, so there are no intervals where $f(x)$ is concave up.\n\nSince ${f}^{″}(x)<0$ for every real value of $x,$ the function is concave down on $(-\\infty ,\\infty ).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186348182 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406edcd7-dd0d-553f-94d4-59c097c98af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$G$ only" :db/id #edb/ref 17592186345904} {:answer/id #uuid "465f4a2b-19c0-58df-8ab0-2cc0a8ebc295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186345964} {:answer/id #uuid "47dcbc0e-948f-533c-8be5-738050dd7dae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ and $G$ only" :db/id #edb/ref 17592186345967} {:answer/id #uuid "c7f84565-bd95-5131-8e6d-cd3a127bd0b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $F$ only" :db/id #edb/ref 17592186347089} {:answer/id #uuid "c9ba910b-46fc-5621-8530-c677d52695b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $G$ only" :db/id #edb/ref 17592186347109}] :answer-field/correct {:answer/id #uuid "465f4a2b-19c0-58df-8ab0-2cc0a8ebc295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186345964} :answer-field/id #uuid "723ed971-5225-51a2-a32f-826e5f345808" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347809}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cd97c58-6193-5fe7-8948-41d6f4bfcd71" :question/math-academy-id "q-7923" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nD=[\\begin{aligned}3 & 2 \\\\ 6 & 6\\end{aligned}],\\,F=[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}],\\,G=[\\begin{aligned}-2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $D$, we have\n\n$$\ndet(D)=3\\cdot 6-6\\cdot 2=6.\n$$\n\nBecause $det(D)\\ne 0,$ we conclude that $D$ is invertible.\n\n- For the matrix $F$, we have\n\n$$\ndet(F)=6\\cdot 6-6\\cdot 6=0.\n$$\n\nBecause $det(F)=0,$ we conclude that $F$ is not invertible.\n\n- For the matrix $G$, we have\n\n$$\ndet(G)=(-2)\\cdot 4-4\\cdot 2=-16.\n$$\n\nBecause $det(G)\\ne 0,$ we conclude that $G$ is invertible.\n\nTherefore, only $F$ does not have an inverse."}]}
