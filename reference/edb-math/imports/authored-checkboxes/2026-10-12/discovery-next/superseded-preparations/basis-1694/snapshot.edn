r.type/text} :answer/value "I and II only" :db/id 17592186378215}] :answer-field/correct {:answer/id #uuid "b77fb499-2855-5a82-afd0-39955b00fa54" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186378213} :answer-field/id #uuid "e2d90f38-5cb5-526d-95fd-800671e723e1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378210}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "334aabff-52b9-5329-860d-709ca904da58" :question/math-academy-id "q-103072" :question/problem "Which of the following are logically equivalent to $M?$\n\n- $(L∧M)∨M$\n- $M∧(L∧M)$\n- $M∨(L∧M)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nM∨(M∧L)≡M.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}(L∧M)∨M & ≡M∨(L∧M) \\\\  & ≡M∨(M∧L) \\\\  & ≡M.\\,✓\\end{aligned}\n$$\n\n- Statement II is *not* logically equivalent to $M.$ This statement cannot be simplified using the absorption laws.\n\n- Statement III is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}M∨(L∧M) & ≡M∨(M∧L) \\\\  & ≡M.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186378216 :knowledge-point/_questions [{:db/id 17592186157275 :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3f373f-097e-5973-b701-d5b004c0fd53" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186378218} {:answer/id #uuid "70dc7167-be75-5b59-9080-653b2e08d444" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378219} {:answer/id #uuid "112df888-f091-5999-b6e7-093fb47c02cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378220} {:answer/id #uuid "3e50ea63-ccfd-5b82-a88f-3ec1d14257b6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378221} {:answer/id #uuid "ab633a40-ba15-55a8-8e21-728caf9da3d3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378222}] :answer-field/correct {:answer/id #uuid "3e50ea63-ccfd-5b82-a88f-3ec1d14257b6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378221} :answer-field/id #uuid "13896387-fb89-55ff-9543-c77a05e2ccbd" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378217}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ccdaee72-7ba3-5cab-ba35-f5476892e5d4" :question/math-academy-id "q-103319" :question/problem "Which of the following are logically equivalent to $¬D?$\n\n- $¬D∨(C∧¬D)$\n- $¬D∨(¬D∧C)$\n- $(¬D∧C)∧¬D$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\n¬D∨(¬D∧C)≡¬D.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $¬D.$ We have\n\n$$\n\\begin{aligned}¬D∨(C∧¬D) & ≡¬D∨(¬D∧C) \\\\  & ≡¬D.\\,✓\\end{aligned}\n$$\n\n- Statement II is logically equivalent to $¬D.$ We have\n\n$$\n\\begin{aligned}¬D∨(¬D∧C) & ≡¬D.\\,✓\\end{aligned}\n$$\n\n- Statement III is *not* logically equivalent to $¬D.$ This statement cannot be simplified using the absorption laws.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186378223 :knowledge-point/_questions [{:db/id 17592186157275 :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cf44c45-6264-5067-b969-338239b49b20" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186378225} {:answer/id #uuid "4e49342a-ca7e-5775-9f4a-e41bf83697aa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378226} {:answer/id #uuid "4bd54191-d76e-5439-9a85-e598cd859f6b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186378227} {:answer/id #uuid "3ee6730c-ecaf-5d44-9122-f26e2c8f40eb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378228} {:answer/id #uuid "ae6a1f88-1f4d-5b57-8a93-e48e03a9c29f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378229}] :answer-field/correct {:answer/id #uuid "2cf44c45-6264-5067-b969-338239b49b20" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186378225} :answer-field/id #uuid "b753ef60-f718-50ef-820c-2bf38adabb02" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378224}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3034ba1-2c82-5776-b118-ddbefff303ff" :question/math-academy-id "q-103320" :question/problem "Which of the following are logically equivalent to $L?$\n\n- $L∨(¬M∧L)$\n- $(L∧¬M)∨L$\n- $(¬M∧L)∨L$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nL∨(L∧¬M)≡L.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $L.$ We have\n\n$$\n\\begin{aligned}L∨(¬M∧L) & ≡L∨(L∧¬M) \\\\  & ≡L.\\,✓\\end{aligned}\n$$\n\n- Statement II is logically equivalent to $L.$ We have\n\n$$\n\\begin{aligned}(L∧¬M)∨L & ≡L∨(L∧¬M) \\\\  & ≡L.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $L.$ We have\n\n$$\n\\begin{aligned}(¬M∧L)∨L & ≡L∨(¬M∧L) \\\\  & ≡L∨(L∧¬M) \\\\  & ≡L.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186378230 :knowledge-point/_questions [{:db/id 17592186129087 :knowledge-point/id #uuid "07b63c0c-daaa-5f5b-acb3-58d6f36ee869" :knowledge-point/title "Identifying a Jump Discontinuity on a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b368f458-efb8-544f-9c52-9be536fdf394" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378232} {:answer/id #uuid "c7d4fe7e-3216-55b5-9dfd-bcb24f8e9506" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186378233} {:answer/id #uuid "15efd6a1-4757-5e0a-b81d-6837a9b8f7cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378234} {:answer/id #uuid "bf04cbe6-254f-54ee-83ab-c807b88b5c5d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378235} {:answer/id #uuid "52db4d93-3096-5b70-ba79-90c05387f7b3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378236}] :answer-field/correct {:answer/id #uuid "52db4d93-3096-5b70-ba79-90c05387f7b3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378236} :answer-field/id #uuid "c12ca190-d978-55a0-af55-963098af9ae7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378231}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "957e916a-1a46-5f09-b0b4-71f6f746df0a" :question/math-academy-id "q-104666" :question/problem "![](images/ca/ca165438c64994306acd6031d5f8e5a0e6d4d0d11a5f6fea8097b19f5105438c.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- It has a removable discontinuity at $x=3$\n- It has a jump discontinuity at $x=3$\n- It is continuous at $x=3$" :question/worked-solution "The function has a jump discontinuity at $x=3.$ Checking our conditions, we see that\n\n- $f(3)=-1$ exists, $\\,\\,✓$\n\n- ${lim}_{x\\to 3}f(x)$ does not exist $\\,\\,\\times $\n\nSo the second condition failed. It failed because the left and right-sided limits are not equal:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=-1,\\,\\,{lim}_{x\\to {3}^{+}}f(x)=3.\n$$\n\nThese limits both exist and are finite, yet they are not equal. Therefore, the discontinuity at $x=3$ is a jump discontinuity.\n\nConsequently, II is true, and I and III are false."}] [{:db/id 17592186378271 :knowledge-point/_questions [{:db/id 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52fbd0d4-0de5-5f72-9254-f4e6e749d8bc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378273} {:answer/id #uuid "cd232d85-718b-55dd-b3bd-4959c54b256d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378274} {:answer/id #uuid "8a9c45da-2cca-5062-859c-ef15e5286a9a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378275} {:answer/id #uuid "d0fc7e25-ff19-52ea-a6b5-23084f8b905e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378276} {:answer/id #uuid "f1040cc9-4da3-5149-8fd2-2917139a6e43" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378277}] :answer-field/correct {:answer/id #uuid "f1040cc9-4da3-5149-8fd2-2917139a6e43" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378277} :answer-field/id #uuid "1a3582bb-94c4-57db-bf7b-5789d14fe916" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378272}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c082af6c-4b35-55f0-b925-7876243430ba" :question/math-academy-id "q-105443" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}:\\text{ }3x+y<8,\\,0<x<3\\}$\n\nII. $\\{(x,y)\\in {R}^{2}:\\text{ }0\\le x<6,\\,2<y\\le 4\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}:\\text{ }(x+1)^{2}+(y-1)^{2}<6\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,3).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third set is *open* since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186378278 :knowledge-point/_questions [{:db/id 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf78b597-2e0d-5ac3-a402-98015c0fc8ce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378280} {:answer/id #uuid "95a53f72-241f-505f-b555-9dfaa3cc979e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378281} {:answer/id #uuid "5543a50c-b2ff-5dfd-bade-f2b59c0333f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378282} {:answer/id #uuid "f93fc1aa-6b0e-53ed-bc89-2205e4c596be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378283} {:answer/id #uuid "58915450-0f4d-587c-b49b-a676b7487737" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378284}] :answer-field/correct {:answer/id #uuid "95a53f72-241f-505f-b555-9dfaa3cc979e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378281} :answer-field/id #uuid "983b98b3-1d62-5314-ae8b-eaf7a34ae81a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378279}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f4b0cdf-9fe1-57d6-a009-4edf0331d401" :question/math-academy-id "q-105444" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,6\\le x<9,\\,0<y<2}$\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1}$\n- ${(x,y)\\in {R}^{2}:\\text{ }(x+1)^{2}+(y-1)^{2}<3}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(6,1).$ On the other hand, it does not contain some other boundary points, for example, the point $(8,0).$\n\n- The second set is *open* since it doesn't contain any of its boundary points (the corresponding inequality is strict).\n\n- The third set is also *open* since it doesn't contain any of its boundary points (the corresponding inequality is strict).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186378327 :knowledge-point/_questions [{:db/id 17592186059694 :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24c74eb4-0458-5c07-a1be-ce22a222467f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186378329} {:answer/id #uuid "2bb2e554-2202-5241-b4c2-e51f96043697" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378330} {:answer/id #uuid "0738f027-f1c3-5b6d-92cb-1dc8a383dfd1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378331} {:answer/id #uuid "f985d338-31f6-5c85-a29d-d4f6ffc65f1d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378332} {:answer/id #uuid "aa07e9a6-d7ae-5f85-a82b-6b8c807a6520" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378333}] :answer-field/correct {:answer/id #uuid "0738f027-f1c3-5b6d-92cb-1dc8a383dfd1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378331} :answer-field/id #uuid "1cb46f8f-f33d-57ce-85bf-52b4e690d538" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378328}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4da29991-8f92-54a5-9016-f20e2647e29f" :question/math-academy-id "q-106802" :question/problem "$\\,$ **If** you need an umbrella, **then** the sky is not clear.\n\nWhich of the following statements are equivalent to the conditional statement above?\n\n- If the sky is clear, then you do not need an umbrella.\n- If you do not need an umbrella, then the sky is clear.\n- If the sky is not clear, then you need an umbrella." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive.\n\n- Statement I is the contrapositive. $\\,✓$\n\n- Statement II is the inverse, not the contrapositive. $\\,\\times $\n\n- Statement III is the converse, not the contrapositive. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186378671 :knowledge-point/_questions [{:db/id 17592186124614 :knowledge-point/id #uuid "66b24a98-c641-5e08-8bec-30f221d1bb22" :knowledge-point/title "Identifying Stochastic Vectors and Stochastic Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0240ee35-bf1a-518d-b734-22e7fc2595b8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id 17592186378673} {:answer/id #uuid "c102312d-4f06-5ee7-bfba-19a3e85466e9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id 17592186378674} {:answer/id #uuid "608e0fb6-5eed-5bfe-b2ff-5a12f96ee232" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U,$ $V,$ and $W$" :db/id 17592186378675} {:answer/id #uuid "d00e77ed-9e7d-55d5-8191-e5d0ee50ec26" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id 17592186378676} {:answer/id #uuid "b4fcd242-22e8-5d68-97fe-c0929b9c3ace" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$W$ only" :db/id 17592186378677}] :answer-field/correct {:answer/id #uuid "c102312d-4f06-5ee7-bfba-19a3e85466e9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id 17592186378674} :answer-field/id #uuid "470f887c-a240-5a37-9fd2-2eaded721c71" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378672}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "90365b47-9514-5b9b-bb0b-216780f54607" :question/math-academy-id "q-135487" :question/problem "Which of the following are stochastic matrices?\n\n$$\nU=[\\begin{aligned}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{aligned}],\\,V=[\\begin{aligned}0.1 & 0.2 \\\\ 0.9 & 0.8\\end{aligned}],\\,W=[\\begin{aligned}0.5 & 0 & 0.5 \\\\ 0 & 1 & 0 \\\\ 0.5 & 0 & 0.5\\end{aligned}]\n$$" :question/worked-solution "Recall that a stochastic vector is a vector with nonnegative entries that add up to $1.$ A matrix is stochastic if all its columns are stochastic vectors.\n\nWith that in mind, let's examine our matrices in turn.\n\n- Matrix $U$ is *not* a stochastic matrix since its first column is not a stochastic vector (it contains negative entries): \n\n$$\n[\\begin{aligned}-0.1 & 0.2 \\\\ 1.1 & 0.8\\end{aligned}]\n$$\n\n- Matrix $V$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are nonnegative and add up to one): \n\n$$\n\\begin{aligned}[\\begin{aligned}0.1 & 0.2 \\\\ 0.9 & 0.8\\end{aligned}]\\,\\begin{aligned}0.1+0.9=1 \\\\ 0.2+0.8=1\\end{aligned}\\end{aligned}\n$$\n\n- Matrix $W$ is a stochastic matrix. Indeed, each column is a stochastic vector (the corresponding entries are non-negative and add up to one): \n\n$$\n\\begin{aligned}[\\begin{aligned}0.5 & 0 & 0.5 \\\\ 0 & 1 & 0 \\\\ 0.5 & 0 & 0.5\\end{aligned}]\\,\\begin{aligned}0.5+0+0.5=1 \\\\ 0+1+0=1 \\\\ 0.5+0+0.5=1\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$V$ and $W$ only.\""}] [{:db/id 17592186378857 :knowledge-point/_questions [{:db/id 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb417859-755d-5aba-86aa-b3d5222c2b58" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378859} {:answer/id #uuid "40b7a775-b680-565a-a722-54389de635d8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378860} {:answer/id #uuid "74d00351-7635-5bcc-958e-85d902d007a8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378861} {:answer/id #uuid "4f0e71e2-ad4e-53b3-a2df-6e11f13cda76" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378862} {:answer/id #uuid "e83bf7f2-5a83-5bde-bf2a-1bbec5b4c606" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186378863}] :answer-field/correct {:answer/id #uuid "cb417859-755d-5aba-86aa-b3d5222c2b58" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378859} :answer-field/id #uuid "a5b297f9-60ed-5e8b-8034-bab5354f7b95" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378858}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28c149d9-63e5-5d01-abf9-5e8569624b8a" :question/math-academy-id "q-161639" :question/problem "Which of the following sets are closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,0<x<2,\\,0<y<x}$\n- ${(x,y)\\in {R}^{2}\\,:\\,1\\le x\\le e,\\,0\\le y\\le \\operatorname{ln}⁡x}$\n- ${(x,y)\\in {R}^{2}\\,:\\,0\\le x\\le 1,\\,0\\le y\\le {x}^{3}}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186378864 :knowledge-point/_questions [{:db/id 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce9cac70-f327-5d5a-b159-03990d1597d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186378866} {:answer/id #uuid "7bfeac63-b679-5d58-bf44-9d5e881c362e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186378867} {:answer/id #uuid "bbbd8c42-6354-58f7-acdb-41558eacab16" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378868} {:answer/id #uuid "c0d36bd0-54b6-5fec-868a-f1737080c195" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378869} {:answer/id #uuid "116f96ba-73bd-5ef8-91cb-ca3e555ae3c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378870}] :answer-field/correct {:answer/id #uuid "116f96ba-73bd-5ef8-91cb-ca3e555ae3c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378870} :answer-field/id #uuid "39d81623-879e-5aa1-aff5-e89fdb5f84b8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378865}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be4d8952-950b-5fb0-a574-0337f64e1d84" :question/math-academy-id "q-161648" :question/problem "Which of the following sets are open?\n\n- ${(x,y)\\in {R}^{2}:\\text{ }0<x<3,\\,0<y<6-2x}$\n- ${(x,y)\\in {R}^{2}:\\text{ }1<x<4,\\,x<y<{x}^{2}}$\n- ${(x,y)\\in {R}^{2}:\\text{ }-1\\le x\\le 1,\\,0\\le {y}^{2}\\le 5}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The second set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\n- The third set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186378871 :knowledge-point/_questions [{:db/id 17592186192786 :knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3224235d-c85f-581e-b0a5-fa619bf3e2c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186378873} {:answer/id #uuid "0ec09210-3416-5440-a20c-8e780f2effa7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186378874} {:answer/id #uuid "2180dbea-78a1-57c5-87db-f486a6914b9a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186378875} {:answer/id #uuid "3257f157-5b66-55fe-830a-873790844a65" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186378876} {:answer/id #uuid "7789b753-b1d3-5748-ae54-82d9e789e198" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186378877}] :answer-field/correct {:answer/id #uuid "0ec09210-3416-5440-a20c-8e780f2effa7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186378874} :answer-field/id #uuid "6419e7cc-8024-5bbd-a920-bed8d2a11d14" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378872}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e963f0b-a2c7-5ae0-844a-f3e405d79aa4" :question/math-academy-id "q-161649" :question/problem "Consider the set $A,$ defined by \n\n$$\nA=\\{(x,y)\\in {R}^{2}\\,:\\,-x\\ge {y}^{2}\\}.\n$$\n\nWhich of the following statements are true?\n\nI. $\\text{int}\\,A\\cup ∂A=A$\n\nII. $A⊂\\text{int}A$\n\nIII. $A-\\text{int}A=∂A$" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nIn this case, the set $A$ and its boundary $∂A$ are shown below.\n\n![](images/88/88f35519cf1aa01bcc9e4fb91b24c2bc2a1a823867ec2670563b0b45f2643a0a.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/64/649c33f1738a35f3d298038bd2cf05d3b435424a4efbbb1e6143cf0d56b2bfd6.png)\n\n \n\nWith that in mind, let's examine each statement:\n\n- Statement I is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $\\text{int}\\,A\\cup ∂A=A.$\n\n- Statement II is false. In this case, the set $A$ contains all of its boundary points, so we must have $A⊈\\text{int}A.$\n\n- Statement III is true. Since $\\text{int}\\,A$ contains all points in $A$ except the boundary points, we must have $A-\\text{int}A=∂A.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186378988 :knowledge-point/_questions [{:db/id 17592186054819 :knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406" :knowledge-point/title "Identifying Statements Expressed Using Symbols"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d0884726-4451-5d71-83c1-d9be50d60dae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id 17592186378990} {:answer/id #uuid "21e54d15-7bff-5813-81ad-492fd0ce5723" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id 17592186378991} {:answer/id #uuid "789e15a1-7716-5ac1-9f75-f5213e4da2ed" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id 17592186378992} {:answer/id #uuid "c36afdc8-cbfe-582d-a25a-9b2cd80e52e7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id 17592186378993} {:answer/id #uuid "40a3ccf2-ac93-55df-9628-c028ee8d1eae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id 17592186378994}] :answer-field/correct {:answer/id #uuid "21e54d15-7bff-5813-81ad-492fd0ce5723" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id 17592186378991} :answer-field/id #uuid "07a61c89-518a-5b23-95a0-52cf19d8dd98" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186378989}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66e732f7-06d5-591e-98a5-b6812f6bf5f5" :question/math-academy-id "q-174419" :question/problem "Which of the following are mathematical statements?\n\n- $P:(-2)\\cdot 3$\n\n- $Q:5>3$\n\n- $R:7\\in N$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is *not* a statement because it is neither true nor false.\n\n- $Q$ is a statement. This statement is *true* because $5$ is larger than  $3.$\n\n- $R$ is a statement. This statement is *true* because $7$ is a natural number.\n\nTherefore, the correct answer is \"$Q$ and $R$ only.\""}] [{:db/id 17592186379134 :knowledge-point/_questions [{:db/id 17592186054640 :knowledge-point/id #uuid "d4954fe5-f1fe-590a-9540-280a14606a49" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a20f8869-7a4b-52c9-baef-b0f4212a05de" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379136} {:answer/id #uuid "fba68979-6c10-588e-9822-61d04d45d0ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379137} {:answer/id #uuid "8c5f71cb-00d9-58b2-90d7-99c0332c1d97" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379138} {:answer/id #uuid "fa8fd27e-9cdc-57f0-94c4-1c1df1dc1533" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379139} {:answer/id #uuid "eded1fba-3349-5c34-970c-22f48833ba96" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379140}] :answer-field/correct {:answer/id #uuid "fba68979-6c10-588e-9822-61d04d45d0ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379137} :answer-field/id #uuid "284af02a-4845-5f36-932b-3d57f135e5e8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379135}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c162f27f-023e-512b-91b9-54632834b487" :question/math-academy-id "q-182238" :question/problem "Which of the following sets are finite?\n\n- $P({R,e})$\n- $P({x\\in R∣\\operatorname{cos}⁡x=0})$\n- $P({(-1)^{n}∣n\\in Z})$" :question/worked-solution "The power set of a finite set is finite, while the power set of an infinite set is infinite.\n\nWith that in mind, let's examine our sets.\n\n- Set I is finite since the underlying set is finite. Notice that \n\n$$\nP({R,e})={∅,\\,{R},\\,{e},\\,{R,e}}\n$$\n\nhas cardinality $4.$\n\n- Set II is infinite since the underlying set ${x\\in R∣\\operatorname{cos}⁡x=0}$  is infinite.\n\n- Set III is finite since the underlying set is finite. Notice that \n\n$$\n{(-1)^{n}∣n\\in Z}={-1,1},\n$$\n\nand, as a result, \n\n$$\nP({(-1)^{n}∣n\\in Z})=P({-1,1})={∅,\\,{-1},\\,{1},\\,{-1,1}}\n$$\n\nhas cardinality $4.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186379141 :knowledge-point/_questions [{:db/id 17592186054640 :knowledge-point/id #uuid "d4954fe5-f1fe-590a-9540-280a14606a49" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dd5f945-cd7f-5486-b1c5-ae14eb219277" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379143} {:answer/id #uuid "a501a546-2f3a-5850-a577-41016260c3db" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379144} {:answer/id #uuid "97a7214c-7191-5613-a2bc-8dddea9596d3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379145} {:answer/id #uuid "7388f416-1adf-51b9-9ac1-d49299548e31" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379146} {:answer/id #uuid "77c634f1-f581-52e7-acd9-a57e23e8f9b8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379147}] :answer-field/correct {:answer/id #uuid "a501a546-2f3a-5850-a577-41016260c3db" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379144} :answer-field/id #uuid "6aab6c6d-5ceb-5786-ac10-901f1b223f35" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379142}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d277777-ae06-5b12-9091-65c43e7bf489" :question/math-academy-id "q-182241" :question/problem "Which of the following sets are finite?\n\n- $P({Z,t,n})$\n- $P(Z)$\n- $P({{2}^{n}∣n\\in Z})$" :question/worked-solution "The power set of a finite set is finite, while the power set of an infinite set is infinite.\n\nWith that in mind, let's examine our sets.\n\n- Set I is finite since the underlying set is finite. Notice that \n\n$$\nP({Z,t,n})={∅,\\,{Z},\\,{t},\\,{n},\\,{Z,t},{Z,n},\\,{t,n},\\,{Z,t,n}}\n$$\n\nhas cardinality $8.$\n\n- Set II is infinite since the underlying set $Z$ is infinite.\n\n- Set III is infinite since the underlying set ${{2}^{n}∣n\\in Z}$ is infinite.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186379309 :knowledge-point/_questions [{:db/id 17592186059694 :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "800ab06c-2ece-526e-a123-6e7779005898" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379311} {:answer/id #uuid "304d6701-6994-5dac-a09d-7d00a8a65603" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379312} {:answer/id #uuid "e5ea9514-459e-5aba-aa45-4d9052848394" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379313} {:answer/id #uuid "465df49a-7838-5b37-bdbc-1c7183d158de" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186379314} {:answer/id #uuid "56b7a178-0432-56df-a8b5-e0bfec95706e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379315}] :answer-field/correct {:answer/id #uuid "56b7a178-0432-56df-a8b5-e0bfec95706e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379315} :answer-field/id #uuid "bbfc8154-2a5f-5e44-afde-5561582686a4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379310}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d0274f7-9e96-5c91-af2a-50bf61bf0ba6" :question/math-academy-id "q-183341" :question/problem "$\\,$ **If** $8$ is even **then** $4\\in {2,4,8}.$ \n\nWhich of the following statements are equivalent to the conditional statement above?\n\n- If $4\\in {2,4,8},$ then $8$ is even.\n- If $4\\notin {2,4,8},$ then $8$ is not even.\n- If $8$ is not even, then $4\\notin {2,4,8}.$" :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive of the given statement.\n\n- Statement I is the converse, not the contrapositive. $\\,\\times $\n\n- Statement II is the contrapositive. $\\,✓$\n\n- Statement III is the inverse, not the contrapositive. $\\,\\times $\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186379411 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f20d51-8248-5571-8f98-e7ef675035c8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379413} {:answer/id #uuid "cd02aaba-65be-57fc-b02b-376ab809d02c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379414} {:answer/id #uuid "9a994f4d-6048-5ada-b244-da4a6b872e93" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379415} {:answer/id #uuid "0acbe4f0-2ed3-52c2-8a9e-d3a38412a195" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379416} {:answer/id #uuid "a2dd1279-326a-5987-a55b-decc309c855f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379417}] :answer-field/correct {:answer/id #uuid "0acbe4f0-2ed3-52c2-8a9e-d3a38412a195" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379416} :answer-field/id #uuid "160e5d13-0f83-577a-91ea-265646d1a7fc" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379412}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec98e74e-e68c-5045-a599-d3ec1260eaf6" :question/math-academy-id "q-330299" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\n- ${x}_{1}(t)-4\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- $-7\\cdot {x}_{1}(t)+{x}_{p}(t)$\n- $2\\cdot {x}_{1}(t)+2\\cdot {x}_{p}(t)$" :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=1\\cdot {x}_{1}(t)-4\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{{x}_{1}(t)-4\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-7\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-7\\cdot {x}_{1}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that $2\\cdot {x}_{1}(t)+2\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $2$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186379418 :knowledge-point/_questions [{:db/id 17592186166901 :knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36" :knowledge-point/title "Constructing General Solutions of First-Order Linear Systems of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dce4286-552d-5198-8e60-ae77cf3ff5fc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379420} {:answer/id #uuid "95a5e686-1269-5d81-a1dd-9ff2c45dcc71" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379421} {:answer/id #uuid "2186a39d-4c02-5910-b7fb-1213d1919bbc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379422} {:answer/id #uuid "fdbd7686-2587-593e-9a8d-997b6f64f602" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379423} {:answer/id #uuid "ab32738a-ed25-573a-a522-733662acefce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379424}] :answer-field/correct {:answer/id #uuid "2186a39d-4c02-5910-b7fb-1213d1919bbc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379422} :answer-field/id #uuid "3917585f-6220-5ca1-94fd-e86e8a7709e8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379419}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "028e3468-5c29-5e67-a28b-97b2d534ac0d" :question/math-academy-id "q-330306" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\n- ${x}_{1}(t)-{x}_{2}(t)+2\\cdot {x}_{p}(t)$\n- $-5\\cdot {x}_{1}(t)-{x}_{p}(t)$\n- $-6\\cdot {x}_{1}(t)+9\\cdot {x}_{2}(t)+{x}_{p}(t)$" :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)-{x}_{2}(t)+2\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $2$ next to the particular solution ${x}_{p}(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that $-5\\cdot {x}_{1}(t)-{x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $-1$ next to the particular solution ${x}_{p}(t).$\n\n- Option III is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-6\\cdot {x}_{1}(t)+9\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-6\\cdot {x}_{1}(t)+9\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id 17592186379604 :knowledge-point/_questions [{:db/id 17592186124676 :knowledge-point/id #uuid "12a9f9cf-06f6-51b8-ba41-a8b6300a5c2b" :knowledge-point/title "Identifying Ordinary and Singular Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab933be-d8a6-5168-9229-b4aab6bedb49" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379606} {:answer/id #uuid "d89e1c21-d1dd-5f33-9785-95e68c85465d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379607} {:answer/id #uuid "2d24ec4f-680a-5f70-9d7a-4e483d0a76f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379608} {:answer/id #uuid "557af1e3-b08c-5247-96f6-e932bfb7528f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379609} {:answer/id #uuid "730e8ed3-e6f3-5a4f-8416-43d28c8e6b3d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379610}] :answer-field/correct {:answer/id #uuid "557af1e3-b08c-5247-96f6-e932bfb7528f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379609} :answer-field/id #uuid "08acca3e-bb84-5168-9c50-67de5dec3326" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379605}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff653b13-8b67-5277-ad4c-9f98277f418a" :question/math-academy-id "q-342282" :question/problem "$$\nx(x+3){y}^{″}+(x-2){y}^{′}+4y=0\n$$\n\nWhich of the following is a **singular** point of the differential equation above?\n\n- $x=-3$\n- $x=0$\n- $x=2$" :question/worked-solution "The point $x=a$ is an ordinary point of the differential equation\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=f(x)\n$$\n\nif both coefficients $P(x)$ and $Q(x)$ are analytic about $x=a.$ Otherwise, $x=a$ is a singular point of the differential equation.\n\nFirst, we rewrite the differential equation in standard form by dividing by $x(x+3):$\n\n$$\n\\begin{aligned}x(x+3){y}^{″}+(x-2){y}^{′}+4y & =0 \\\\ {y}^{″}+\\frac{x-2}{x(x+3)}{y}^{′}+\\frac{4}{x(x+3)}y & =0\\end{aligned}\n$$\n\nSo, we have\n\n$$\nP(x)=\\frac{x-2}{x(x+3)}\\,\\text{and}\\,Q(x)=\\frac{4}{x(x+3)}.\n$$\n\nLet's now check the analyticity of these functions at the given points.\n\n- *Neither* function is analytic about $x=-3,$ since both denominators at $x=-3$ equal zero. So, $x=-3$ is a singular point of the differential equation.\n\n- *Neither* function is analytic about $x=0,$ since both denominators at $x=0$ equal zero. So, $x=0$ is a singular point of the differential equation.\n\n- *Both* functions are analytic about $x=2.$ So, $x=2$ is an ordinary point of the differential equation.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186379611 :knowledge-point/_questions [{:db/id 17592186124677 :knowledge-point/id #uuid "9e7d1368-06ee-5135-b9f4-d3d4d2756b32" :knowledge-point/title "Identifying Regular and Irregular Singular Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38b816ba-2958-5c3c-8cd7-2b88d0cc5920" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379613} {:answer/id #uuid "02b1e940-5c01-5474-b7d5-62d2e4fc6518" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379614} {:answer/id #uuid "a9f4937b-aaa8-53f1-a955-cb8c02b1dbd0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186379615} {:answer/id #uuid "363726e9-9c96-50d2-9d88-ee2838c287e3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379616} {:answer/id #uuid "43839927-d2ed-5af2-947f-97ba41db0d16" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379617}] :answer-field/correct {:answer/id #uuid "02b1e940-5c01-5474-b7d5-62d2e4fc6518" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379614} :answer-field/id #uuid "200e14ff-e4d1-57ae-9ea3-19076e82d0d3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379612}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "39331851-2b44-5819-96f4-7d54c8cd9bd8" :question/math-academy-id "q-342366" :question/problem "$$\n(x+3){y}^{″}+\\frac{1}{(x+3)^{2}}{y}^{′}+y=0\n$$\n\nConsider the differential equation given above. Which of the following statements are true?\n\n- The functions $P(x)=\\frac{1}{(x+3)^{3}}$ and $Q(x)=\\frac{1}{x+3}$ are analytic about $x=-3.$\n- The functions $(x+3)P(x)$ and $(x+3)^{2}Q(x)$ are analytic about $x=-3.$\n- The point $x=-3$ is an **irregular** singular point of the differential equation." :question/worked-solution "A singular point $a$ of the differential equation\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=f(x)\n$$\n\nis regular if both $(x-a)P(x)$ and $(x-a)^{2}Q(x)$ are analytic about $x=a.$ Otherwise, the singular point is irregular.\n\nFirst, we rewrite the differential equation in standard form by dividing by $(x+3):$\n\n$$\n\\begin{aligned}(x+3){y}^{″}+\\frac{1}{(x+3)^{2}}{y}^{′}+y & =0 \\\\ {y}^{″}+\\frac{1}{(x+3)^{3}}{y}^{′}+\\frac{1}{x+3}y & =0\\end{aligned}\n$$\n\nSo, we have\n\n$$\nP(x)=\\frac{1}{(x+3)^{3}}\\,\\text{and}\\,Q(x)=\\frac{1}{x+3}.\n$$\n\nLet's now check each statement in turn.\n\n- Since the denominators of both $P(x)$ and $Q(x)$ vanish at $x=-3,$ they are *not* analytic about $x=-3.$ So, statement I is false.\n\n- The function\n\n$$\n(x+3)P(x)=(x+3)\\frac{1}{(x+3)^{3}}=\\frac{1}{(x+3)^{2}}\n$$\n\n is *not* analytic about $x=-3$ since its denominator vanishes at $x=-3.$ Therefore, statement II is false.\n\n- Since statement I is false, $x=-3$ is a singular point. Also, since statement II is false, it follows that $x=-3$ is an **irregular** singular point. Thus, statement III is true.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186379766 :knowledge-point/_questions [{:db/id 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa93218-27b0-5ad5-8222-b7e37e2e20e4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379768} {:answer/id #uuid "870c2e4a-2968-5ad3-9de4-98a3ab8a3888" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379769} {:answer/id #uuid "3e07e993-4d1b-5f3e-bc88-fb33e5cf4d73" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379770} {:answer/id #uuid "fa7d4122-ae51-5da7-9538-4f3a5a4e7279" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379771} {:answer/id #uuid "67511d28-193a-5f98-b1ad-09961ee6f34d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379772}] :answer-field/correct {:answer/id #uuid "3e07e993-4d1b-5f3e-bc88-fb33e5cf4d73" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379770} :answer-field/id #uuid "5e2961e2-c4d5-5918-ab70-c6f6a98c5129" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379767}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "036af2f8-8d3f-5a9f-9714-c21bb558dc15" :question/math-academy-id "q-35538" :question/problem "The level curves of the function $f(x,y)=4x-3y-1$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=-1$ gives a line\n- $c=0$ gives the axes $x=0$ and $y=0$\n- $c=2$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}4x-3y-1 & =c \\\\ 4x-3y-(c+1) & =0 \\\\ y & =\\frac{4}{3}x-\\frac{c+1}{3}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=-1$ then the level curve is $y=\\frac{4}{3}x,$ which is a line.\n\n- If $c=0$ then the level curve is $y=\\frac{4}{3}x-\\frac{1}{3},$ which is a line different to the axes $x=0$ and $y=0.$\n\n- If $c=2$ then the level curve is $y=\\frac{4}{3}x-1,$ which is not a parabola.\n\nSo, only statement I is true."}] [{:db/id 17592186379903 :knowledge-point/_questions [{:db/id 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b971f02-4dda-55b8-a905-b2c02dc4ccd6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186379905} {:answer/id #uuid "666233fa-03e9-5d3f-9041-88cf94599702" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379906} {:answer/id #uuid "40ff7db2-1368-5950-8bc5-efe42e64ccf3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379907} {:answer/id #uuid "2f8e1c50-ad71-5b07-b586-a803f3ecc2ff" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379908} {:answer/id #uuid "5d03f4b2-8f1e-55e5-9224-e865497962c3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379909}] :answer-field/correct {:answer/id #uuid "2f8e1c50-ad71-5b07-b586-a803f3ecc2ff" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379908} :answer-field/id #uuid "7cfafc86-a646-52b6-ac85-752f96950f81" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379904}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3aaf864-2fae-5bdc-a851-6e2a3303364c" :question/math-academy-id "q-71398" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}+2y}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=0$ gives a circle\n- $c=1$ gives a hyperbola\n- $c=2$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+2y} & =c \\\\ {x}^{2}+2y & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ then the level curve is $y=-\\frac{{x}^{2}}{2},$ which is not a circle.\n\n- If $c=1$ then the level curve is $y=\\frac{1}{2}-\\frac{{x}^{2}}{2},$ which is not a hyperbola.\n\n- If $c=2$ then the level curve is $y=2-\\frac{{x}^{2}}{2},$ which is a parabola.\n\nSo, only statement III is true."}] [{:db/id 17592186379945 :knowledge-point/_questions [{:db/id 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9e78cd0-978d-506e-868e-8f83ca2997fd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379947} {:answer/id #uuid "37dec8a5-f8e6-5cc7-8e9a-857e6b978568" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379948} {:answer/id #uuid "043e74e4-44a8-5f9f-a9d4-625b37cab07b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379949} {:answer/id #uuid "f95e0e68-6456-5561-b1dc-7e93d3d74f97" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id 17592186379950} {:answer/id #uuid "d9ce9216-f20f-5028-a7db-a11d12ae2903" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379951}] :answer-field/correct {:answer/id #uuid "043e74e4-44a8-5f9f-a9d4-625b37cab07b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379949} :answer-field/id #uuid "9a2667ff-2890-55a8-93a7-c69f02f7fbdb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379946}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4218ace-9c46-5876-8096-9bc751d57412" :question/math-academy-id "q-71793" :question/problem "Which of the following sets are closed?\n\nI. $[-2,2]$\n\nII. $[3,9]$\n\nIII. $[-1,1)\\cup (3,4]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[-2,2]$ and $[3,9]$ are closed because:\n\n- The boundary points of $[-2,2]$ are $-2$, and $2.$ Both of them lie in the set.\n\n- The boundary points of $[3,9]$ are $3$, and $9.$ Both of them lie in the set.\n\nThe other set is not closed because $[-1,1)\\cup (3,4]$ has a boundary point $1$, which does not lie in the set.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186379952 :knowledge-point/_questions [{:db/id 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a6df2c-1d53-5764-ac8c-3952f99881e5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379954} {:answer/id #uuid "263d6be3-09b1-550c-ba66-f9becdcc13fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379955} {:answer/id #uuid "aaef3ba8-a8a8-50b1-86d1-ccf87710b7e1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379956} {:answer/id #uuid "81d4b7e2-7934-5a13-8dd9-6fdef4f24124" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379957} {:answer/id #uuid "33047e0b-d4b1-5ed8-9908-c4b35a6c199a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379958}] :answer-field/correct {:answer/id #uuid "33047e0b-d4b1-5ed8-9908-c4b35a6c199a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379958} :answer-field/id #uuid "6d20cdf6-6afd-5c88-b3e2-2ec66158dd68" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379953}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6c4a042d-b417-5a76-bd5b-ca2066d08ead" :question/math-academy-id "q-71795" :question/problem "Which of the following sets are closed?\n\n- $(-3,1)$\n- $[0,2]\\cup [6,7]$\n- $(-1,3)\\cup (4,7]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[0,2]\\cup [6,7]$ is closed. It consists of two parts, where the boundary points are $0,2,6,$ and $7.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $(-3,1)$ has a boundary point $1$, which does not lie in the set.\n\n- $(-1,3)\\cup (4,7]$ has a boundary point $3$, which does not lie in the set.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id 17592186379959 :knowledge-point/_questions [{:db/id 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5f1dd57-43e7-5134-89fd-b1f1e3038ace" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379961} {:answer/id #uuid "c4feb077-a267-505c-831a-200f40aea191" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186379962} {:answer/id #uuid "714f89d8-1d11-59c9-ad7e-699414828708" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379963} {:answer/id #uuid "e3d7b5a7-c514-559c-bac4-f3da5f896b7b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379964} {:answer/id #uuid "4033cbd4-eb1f-58a8-b330-03e076419290" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379965}] :answer-field/correct {:answer/id #uuid "e5f1dd57-43e7-5134-89fd-b1f1e3038ace" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379961} :answer-field/id #uuid "e9fc4fee-b20d-58a2-80e0-8f8db607a662" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379960}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9b6f2b8-c18f-5a12-b634-f89ac5f5481f" :question/math-academy-id "q-71796" :question/problem "Which of the following sets are closed?\n\n- $(6,10]$\n- $[2,5]$\n- $[0,1]\\cup [3,4]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[2,5]$ and $[0,1]\\cup [3,4]$ are closed because:\n\n- The boundary points of $[2,5]$ are $2$ and $5.$ Both of them lie in the set.\n\n- The boundary points of $[0,1]\\cup [3,4]$ are $0,1,3,$ and $4.$ All of them lie in the set.\n\nThe other set is not closed because $(6,10]$ has a boundary point $6$, which does not lie in the set.\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id 17592186379966 :knowledge-point/_questions [{:db/id 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d6fc105-4665-5793-840a-d38f2e07c65f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186379968} {:answer/id #uuid "3e75ea62-d875-500e-b00a-ad8139208c21" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186379969} {:answer/id #uuid "f27839c1-6f71-56a5-b057-e5734e69d496" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379970} {:answer/id #uuid "f06b782e-2708-5653-9046-5d9e5df40d3b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186379971} {:answer/id #uuid "e7817c5e-15e4-5414-b3d3-9f16dd15eb81" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186379972}] :answer-field/correct {:answer/id #uuid "f27839c1-6f71-56a5-b057-e5734e69d496" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186379970} :answer-field/id #uuid "531480b0-2b5e-5d39-b602-bae56ec77aeb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186379967}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0cdf362-49b4-5e81-91f4-944c2a137d99" :question/math-academy-id "q-71801" :question/problem "Which of the following sets are open?\n\nI. $(-2,1]\\cup [3,9)$\n\nII. $[4,6)\\cup (9,11)$\n\nIII. $(-1,4)\\cup (6,7)$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-1,4)\\cup (6,7)$ is open. It consists of two parts, where the boundary points are $-1$, $4$, $6$, and $7.$ None of them lie in the set.\n\nThe other sets are not open because:\n\n- $(-2,1]\\cup [3,9)$ has four boundary points $-2$, $1$, $3$, and $9$, and the points $1$ and $3$ lie in the set.\n\n- $[4,6)\\cup (9,11)$ has four boundary points $4$, $6$, $9$, and $11$, and the point $4$ lies in the set.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id 17592186380159 :knowledge-point/_questions [{:db/id 17592186157274 :knowledge-point/id #uuid "4106fe70-b9df-5621-ba64-66703855aaf9" :knowledge-point/title "Simplifying an Expression Using the Law that Conjunction Absorbs Disjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad534fa4-8ecb-5a96-9a22-d961abac53d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380161} {:answer/id #uuid "175fd012-5329-594f-b94a-7957331392c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380162} {:answer/id #uuid "47a273a3-cc46-5403-b048-3acac53389d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380163} {:answer/id #uuid "41295324-c55f-59bc-b94d-194855cfbcf9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id 17592186380164} {:answer/id #uuid "babde9ba-09d7-5111-80d3-515bf6a20def" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380165}] :answer-field/correct {:answer/id #uuid "ad534fa4-8ecb-5a96-9a22-d961abac53d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380161} :answer-field/id #uuid "f90a2622-3760-5f6e-95ef-3cc4e8794630" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380160}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1b738de-914d-5dd9-b0ba-d383cdcec6e2" :question/math-academy-id "q-81718" :question/problem "Which of the following are logically equivalent to $Q?$\n\n- $¬R∧(Q∧¬R)$\n- $Q∧(¬R∨Q)$\n- $(¬R∨Q)∧Q$" :question/worked-solution "The law that conjunction absorbs disjunction is stated as\n\n$$\nQ∧(Q∨¬R)≡Q.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $Q.$ This statement cannot be simplified using the absorption laws.\n\n- Statement II is logically equivalent to $Q.$ We have\n\n$$\n\\begin{aligned}Q∧(¬R∨Q) & ≡Q∧(Q∨¬R) \\\\  & ≡Q.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $Q.$ We have\n\n$$\n\\begin{aligned}(¬R∨Q)∧Q & ≡Q∧(Q∨¬R) \\\\  & ≡Q.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186380166 :knowledge-point/_questions [{:db/id 17592186157275 :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5a03801-6e31-5f12-9230-03a73941cd5d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380168} {:answer/id #uuid "f543ff52-14d3-564d-97fa-276917dadb38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380169} {:answer/id #uuid "1fe548d7-442b-5e51-bc64-b15e8bc2960d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380170} {:answer/id #uuid "e4c7f146-02c7-56f7-b44f-9d7216074c64" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380171} {:answer/id #uuid "3665fcb6-129f-59bf-91af-779ad97764da" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380172}] :answer-field/correct {:answer/id #uuid "3665fcb6-129f-59bf-91af-779ad97764da" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380172} :answer-field/id #uuid "77cbc687-c9f8-5de6-95b7-7080149d026a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380167}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34117327-fd37-5989-b657-502be019389b" :question/math-academy-id "q-81721" :question/problem "Which of the following are logically equivalent to $P?$\n\n- $P∨(Q∧P)$\n- $(Q∧P)∨P$\n- $P∨(Q∨P)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nP∨(P∧Q)≡P.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is logically equivalent to $P.$ We have\n\n$$\n\\begin{aligned}P∨(Q∧P) & ≡P∨(P∧Q) \\\\  & ≡P.\\,✓\\end{aligned}\n$$\n\n- Statement II is logically equivalent to $P.$ We have\n\n$$\n\\begin{aligned}(Q∧P)∨P & ≡P∨(Q∧P) \\\\  & ≡P∨(P∧Q) \\\\  & ≡P.\\,✓\\end{aligned}\n$$\n\n- Statement III is *not* logically equivalent to $P.$ This statement cannot be simplified using the absorption laws.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186380173 :knowledge-point/_questions [{:db/id 17592186157275 :knowledge-point/id #uuid "5d4ea352-2a82-5ff5-8c08-b7f9a09929e6" :knowledge-point/title "Simplifying an Expression Using the Law that Disjunction Absorbs Conjunction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f4ce61-3577-53d7-963d-36460b2e90f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380175} {:answer/id #uuid "4ba38e16-d4fd-5b3f-be09-5278fb466686" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380176} {:answer/id #uuid "73dd5019-d63b-574e-8ab2-ef6118f6019f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380177} {:answer/id #uuid "1bd78e84-32e2-534a-98df-660adfb45fe9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380178} {:answer/id #uuid "406955b2-095c-5f0b-86eb-9d7fd8469fa9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380179}] :answer-field/correct {:answer/id #uuid "29f4ce61-3577-53d7-963d-36460b2e90f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380175} :answer-field/id #uuid "3495e208-31b8-5c35-b62f-cb23f17cccc7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380174}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c524db33-b009-501a-aa7b-2de183456b8d" :question/math-academy-id "q-81722" :question/problem "Which of the following are logically equivalent to $M?$\n\n- $M∨(N∨M)$\n- $(M∧N)∨M$\n- $M∨(N∧M)$" :question/worked-solution "The law that disjunction absorbs conjunction is stated as\n\n$$\nM∨(M∧N)≡M.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is *not* logically equivalent to $M.$ This statement cannot be simplified using the absorption laws.\n\n- Statement II is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}(M∧N)∨M & ≡M∨(M∧N) \\\\  & ≡M.\\,✓\\end{aligned}\n$$\n\n- Statement III is logically equivalent to $M.$ We have\n\n$$\n\\begin{aligned}M∨(N∧M) & ≡M∨(M∧N) \\\\  & ≡M.\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186380214 :knowledge-point/_questions [{:db/id 17592186059694 :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4d18692-acd4-59c1-9e3e-3325f2a1d8bd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380216} {:answer/id #uuid "8bb47751-4190-594d-8962-b1bdeabfd734" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380217} {:answer/id #uuid "2ff976d3-f9fc-5777-a49c-cca37cb97b75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380218} {:answer/id #uuid "700d45aa-06ce-5c29-863a-7b2ad7864c75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380219} {:answer/id #uuid "de279420-643a-5713-8ec6-4038075b3edf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380220}] :answer-field/correct {:answer/id #uuid "2ff976d3-f9fc-5777-a49c-cca37cb97b75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380218} :answer-field/id #uuid "a33330e2-9b6d-5e27-b1a3-9b9123c05f62" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380215}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b3cb87d-282a-5d16-9402-d3db5936c8ba" :question/math-academy-id "q-82660" :question/problem "$\\,$ **If** I am not sleeping, **then** I am awake.\n\nWhich of the following statements are equivalent to the conditional statement above?\n\n- If I am not awake, then I am sleeping.\n- If I am sleeping, then I am not awake.\n- If I am awake, then I am not sleeping." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive.\n\n- Statement I is the contrapositive. $\\,✓$\n\n- Statement II is the inverse, not the contrapositive. $\\,\\times $\n\n- Statement III is the converse, not the contrapositive. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186380221 :knowledge-point/_questions [{:db/id 17592186059694 :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac381034-e631-549e-bad1-e6ad09bfa423" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380223} {:answer/id #uuid "7dc83512-b6ce-5cf4-ae34-46b41380d0f2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380224} {:answer/id #uuid "674ae613-75b3-5494-bfed-ba479c8015be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380225} {:answer/id #uuid "25f6399b-33da-5e56-93c5-770a003aa88d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380226} {:answer/id #uuid "0f7cead4-5bad-5177-b792-cbf3cc8b7481" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380227}] :answer-field/correct {:answer/id #uuid "674ae613-75b3-5494-bfed-ba479c8015be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380225} :answer-field/id #uuid "2efbc5e9-e76e-5fc3-896f-36357157ae30" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380222}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b3c08af-1740-5428-a4c7-1f507e3193d7" :question/math-academy-id "q-82664" :question/problem "$\\,$ **If** we do not go to the cinema, **then** we watch a movie at home.\n\nWhich of the following statements are equivalent to the conditional statement above?\n\n- If we do not watch a movie at home, then we go to the cinema.\n- If we watch a movie at home, then we do not go to the cinema.\n- If we go to the cinema, then we do not watch a movie at home." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive.\n\n- Statement I is the contrapositive. $\\,✓$\n\n- Statement I is the converse, not the contrapositive. $\\,\\times $\n\n- Statement III is the inverse, not the contrapositive. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186380325 :knowledge-point/_questions [{:db/id 17592186124528 :knowledge-point/id #uuid "20a6c0cf-04d4-5908-a03f-1adf491b9282" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem in Terms of Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64521aa0-de87-5b2a-92ea-e716d1ededef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380327} {:answer/id #uuid "8a17211f-f42c-5be4-a84c-f85cf65bbafa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380328} {:answer/id #uuid "8f80af38-2c29-5c8f-9141-359c445e8659" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380329} {:answer/id #uuid "1d64f238-a82f-5e38-a9c1-02e3ec78f8e5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380330} {:answer/id #uuid "dbe51de3-b474-5722-8561-97d3baa24356" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380331}] :answer-field/correct {:answer/id #uuid "64521aa0-de87-5b2a-92ea-e716d1ededef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380327} :answer-field/id #uuid "788bc413-f1ef-5c02-b581-c04dd78a4cbb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380326}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f94c3089-795c-58b5-a020-124bd7b98fb9" :question/math-academy-id "q-97859" :question/problem "If $B$ is a $3\\times 3$ non-invertible matrix, then which of the following could be the characteristic equation of $B?$\n\n- ${\\lambda }^{3}-4\\lambda =0$\n- ${\\lambda }^{3}-3{\\lambda }^{2}-\\lambda +4=0$\n- $\\lambda (\\lambda +4)(\\lambda -1)=0$" :question/worked-solution "Since $B$ is non-invertible, according to the invertible matrix theorem, $0$ must be an eigenvalue of $B.$ As a result, $\\lambda =0$ should be a solution to the corresponding characteristic equation. \n\nWith that in mind, let's examine the given equations in turn.\n\n- Equation I could be the characteristic equation of $B.$ Indeed, $\\lambda =0$ is a root of the equation.\n\n- Equation II **cannot** be the characteristic equation of $B$ since $\\lambda =0$ is not a root of the equation.\n\n- Equation III could be the characteristic equation of $B.$ Indeed, $\\lambda =0$ is a root of the equation.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186380386 :knowledge-point/_questions [{:db/id 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8c03da-a978-575f-8c1b-085775eedfd0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380388} {:answer/id #uuid "d52b304e-f41f-506e-8c46-a26ba751bac3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id 17592186380389} {:answer/id #uuid "2d81a262-18e3-5166-8bdf-031b1be1ba78" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380390} {:answer/id #uuid "512102b8-ad65-5fff-a52e-dd66cd9fdd50" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id 17592186380391} {:answer/id #uuid "e3c67f71-ae2b-5910-924c-2151951d0f1b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380392}] :answer-field/correct {:answer/id #uuid "2d81a262-18e3-5166-8bdf-031b1be1ba78" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380390} :answer-field/id #uuid "3b52052c-ee18-5917-807e-849961b875e7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380387}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f035c68d-f32c-5e67-98cc-62c8475830d3" :question/math-academy-id "q-98341" :question/problem "![](images/05/05e7d61ebc2cc2b3d36915d448f6d9a6498376b858f72294f2ffc9342af38a7a.png)\n\nWhich of the curves above is simple, closed, and negatively oriented?" :question/worked-solution "A simple closed curve is positively oriented if, when traveling along it, one always has the curve interior to the left and the curve exterior to the right. Otherwise, the curve is negatively oriented. \n\nA curve is positively oriented if it is traversed counterclockwise and is negatively oriented if it is traversed clockwise.\n\nWith that in mind, let's examine each of the curves:\n\n- Curve I is not closed.\n\n- Curve II is not simple.\n\n- Curve III is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve IV is a simple and closed curve but it is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186380393 :knowledge-point/_questions [{:db/id 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c83ba197-baf1-5a47-b9ea-ad671205f039" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380395} {:answer/id #uuid "460f8ed1-22bf-558b-8f1d-b4d2c002aa5d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380396} {:answer/id #uuid "c602afc3-785d-515a-b903-b1afc4adfb10" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380397} {:answer/id #uuid "decb6e79-8728-54fc-9a0b-c9dd44e09e1e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements is true" :db/id 17592186380398} {:answer/id #uuid "20946bc2-8448-5c07-b5d7-0292baab0c2f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380399}] :answer-field/correct {:answer/id #uuid "c602afc3-785d-515a-b903-b1afc4adfb10" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380397} :answer-field/id #uuid "cdd30202-889c-59ba-bb4d-be2188ca8246" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380394}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb972e63-3e46-543b-9a40-0120a6183656" :question/math-academy-id "q-100120" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=2t-4,\\,{p}_{2}(t)=2-t,\\,{p}_{3}(t)=1-t.\n$$\n\nGiven that the inner product in the vector space ${R}_{1}[t]$ of polynomials of degree at most $1$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(1)q(1)+p(2)q(2),\n$$\n\nwhich of the following statements are true?\n\nI. ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product\n\nII. ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨2t-4,1-t⟩ \\\\  & =(2t-4){|}_{1}\\cdot (1-t){|}_{1}+(2t-4){|}_{2}\\cdot (1-t){|}_{2} \\\\  & =(2(1)-4)\\cdot (1-1)+(2(2)-4)\\cdot (1-2) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement II is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨2-t,1-t⟩ \\\\  & =(2-t){|}_{1}\\cdot (1-t){|}_{1}+(2-t){|}_{2}\\cdot (1-t){|}_{2} \\\\  & =(2-1)\\cdot (1-1)+(2-2)\\cdot (1-2) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Let's check if ${p}_{1}(t)⊥{p}_{2}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨2t-4,2-t⟩ \\\\  & =(2t-4){|}_{1}\\cdot (2-t){|}_{1}+(2t-4){|}_{2}\\cdot (2-t){|}_{2} \\\\  & =(2(1)-4)\\cdot (2-1)+(2(2)-4)\\cdot (2-2) \\\\  & =-2\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product. So, the set $S$ is *not* an orthogonal set.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186380406 :knowledge-point/_questions [{:db/id 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51c38ba3-947f-5e44-8a81-230ba3328424" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186380408} {:answer/id #uuid "a5bcb700-18f0-56e2-9cae-eb30dc7e16d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380409} {:answer/id #uuid "e1048327-e452-5193-9750-011189b52b8f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380410} {:answer/id #uuid "d056adf6-c365-548e-bc8e-b0eccd6d5134" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380411} {:answer/id #uuid "06234a79-3f8c-59b1-87c1-abec77e9f5a1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380412}] :answer-field/correct {:answer/id #uuid "e1048327-e452-5193-9750-011189b52b8f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380410} :answer-field/id #uuid "f53b0d47-d591-5204-a1db-1c099fe1fb90" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380407}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39aa7418-1a3f-5a9e-9642-6c49cf6dc36a" :question/math-academy-id "q-100129" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=2t+2,\\,{p}_{2}(t)=t-2,\\,{p}_{3}(t)=t+1.\n$$\n\nGiven that the inner product in the vector space ${R}_{1}[t]$ of polynomials of degree at most $1$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(2)q(2),\n$$\n\nwhich of the following statements are true?\n\nI. ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product\n\nII. ${p}_{2}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨2t+2,t-2⟩ \\\\  & =(2t+2){|}_{-1}\\cdot (t-2){|}_{-1}+(2t+2){|}_{2}\\cdot (t-2){|}_{2} \\\\  & =(2(-1)+2)\\cdot ((-1)-2)+(2(2)+2)\\cdot (2-2) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is false since\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{3}(t)⟩ & =⟨t-2,t+1⟩ \\\\  & =(t-2){|}_{-1}\\cdot (t+1){|}_{-1}+(t-2){|}_{2}\\cdot (t+1){|}_{2} \\\\  & =((-1)-2)\\cdot ((-1)+1)+(2-2)\\cdot (2+1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{2}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Let's check if ${p}_{1}(t)⊥{p}_{3}(t).$ Computing the inner product, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨2t+2,t+1⟩ \\\\  & =(2t+2){|}_{-1}\\cdot (t+1){|}_{-1}+(2t+2){|}_{2}\\cdot (t+1){|}_{2} \\\\  & =(2(-1)+2)\\cdot ((-1)+1)+(2(2)+2)\\cdot (2+1) \\\\  & =18\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥̸{p}_{3}(t)$ with respect to the given inner product. So, the set $S$ is *not* an orthogonal set.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186380413 :knowledge-point/_questions [{:db/id 17592186152132 :knowledge-point/id #uuid "2fe686b5-c7f0-58e6-9e46-e769a9193b21" :knowledge-point/title "Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9edddf5-258f-5460-be41-769be7be7493" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380415} {:answer/id #uuid "0cb47ec2-c757-5886-84b4-5cdcfa876408" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380416} {:answer/id #uuid "4e2596b0-d234-56e7-8728-709792caafff" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380417} {:answer/id #uuid "b0557b9b-6a95-5397-8bd1-73204b720540" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380418} {:answer/id #uuid "8ab2a9cd-07b7-53a6-9e95-221c351ccc96" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380419}] :answer-field/correct {:answer/id #uuid "b9edddf5-258f-5460-be41-769be7be7493" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380415} :answer-field/id #uuid "f68eb7eb-0775-5899-889d-14aa509971ab" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380414}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db140378-9b82-5420-9a09-f186b3b4c9b7" :question/math-academy-id "q-104956" :question/problem "![](images/8d/8d5a71c78a8e8aa5c4c17189a7e2fcf739af2b4e6d93819e87aa9f3f7135c8cd.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- There exists some $x$ contained within $X$ such that $f(x)=4$\n- $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. According to the diagram, we have $f(1)=4$ (we have an arrow from $1\\in X$ to $4\\in Y$). So, there exists some $x$ contained within $X$ such that $f(x)=4.$\n\n- Statement II is true. As we can see from the diagram, for all $y$ contained within $Y,$ there exists some $x$ contained within $X$ such that $f(x)=y.$\n\n- Statement III is true. Since statement II is true, $f$ is a surjection.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186380420 :knowledge-point/_questions [{:db/id 17592186152132 :knowledge-point/id #uuid "2fe686b5-c7f0-58e6-9e46-e769a9193b21" :knowledge-point/title "Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f46e921c-8d10-5a86-850d-07aca450b07c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380422} {:answer/id #uuid "6c34f9b1-4b80-511c-aad7-e6080c9270e4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380423} {:answer/id #uuid "fe6e8b91-24c1-5c2a-ac18-b9f2c154c502" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380424} {:answer/id #uuid "da9eedf4-c1a4-5c97-a3f1-9ac23e093e04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186380425} {:answer/id #uuid "35d288ec-e2d8-50c4-ba5f-879ac5859967" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380426}] :answer-field/correct {:answer/id #uuid "da9eedf4-c1a4-5c97-a3f1-9ac23e093e04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186380425} :answer-field/id #uuid "ec2b7b45-79b4-5ca1-8ad1-d6a00cb89e1e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380421}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e7e09caa-cacf-54dd-ae93-0599cdfc3d85" :question/math-academy-id "q-104957" :question/problem "![](images/80/801bb98497bc275acda854447fffee30721bc54b2711ac632c2269f0c1eb64ed.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- There exists some $x$ contained within $X$ such that $f(x)=-1$\n- $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. As we can see from the diagram, there are no elements contained within $X$ that have an arrow to $-1\\in Y.$ Hence, $f(x)\\ne -1$ for all $x\\in X.$\n\n- Statement II is false. Since statement I is false,  it's *not true* that for all $y$ contained within $Y,$ there exists some $x$ contained within $X$ such that $f(x)=y.$\n\n- Statement III is false. Indeed, since statement II is false, $f$ is not a surjection.\n\nTherefore, the correct answer is \"None.\""}] [{:db/id 17592186380427 :knowledge-point/_questions [{:db/id 17592186152132 :knowledge-point/id #uuid "2fe686b5-c7f0-58e6-9e46-e769a9193b21" :knowledge-point/title "Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4567e1b-2d8d-57d3-847c-17a7d6d27a7d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380429} {:answer/id #uuid "b8bb58f2-782e-534c-b1d7-ecece5c0a897" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380430} {:answer/id #uuid "7b04098a-04d9-513d-9435-926d7c7a843a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186380431} {:answer/id #uuid "2e76a177-045a-5eae-a0b6-bbb0f7cca672" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380432} {:answer/id #uuid "6e6114ff-6f94-5845-b624-0a89f8899ed8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380433}] :answer-field/correct {:answer/id #uuid "b8bb58f2-782e-534c-b1d7-ecece5c0a897" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380430} :answer-field/id #uuid "ab975203-0009-5284-9e61-11b2ba863295" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380428}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "65240711-5d62-532c-a650-6596f72fcd4c" :question/math-academy-id "q-104959" :question/problem "![](images/94/94f14d4a1876588cbfb2abc4a1542d5961587745a6e24aeae270d15f75f834db.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- There exists some $x$ contained within $X$ such that $f(x)=7$\n- $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y$\n- $f$ is **onto**" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. According to the diagram, we have $f(1)=7$ (we have an arrow from $2\\in X$ to $7\\in Y$). So, there exists some $x$ contained within $X$ such that $f(x)=7.$\n\n- Statement II is false. Consider $y=5.$ As we can see from the diagram, there are no elements contained within $X$ that have an arrow to $5\\in Y.$ So, it's *not true* that for all $y$ contained within $Y,$ there exists some $x$ contained within $X$ such that $f(x)=y.$\n\n- Statement III is false. Indeed, since statement II is false, $f$ is not a surjection (also known as *onto*).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186380441 :knowledge-point/_questions [{:db/id 17592186152134 :knowledge-point/id #uuid "1324fd0b-5388-5133-ad6a-72d658e3c903" :knowledge-point/title "Functions Whose Codomain Is a Real Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "020bc159-a9f5-505e-bb3b-c01fa9984734" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380443} {:answer/id #uuid "a381baa8-d91d-5926-b7dc-35746f35bf38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380444} {:answer/id #uuid "b2d954bf-5e79-5fe6-9c9e-e6dbd08b6094" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380445} {:answer/id #uuid "609608a1-4ac9-531c-a5d5-8cc2f76ba843" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380446} {:answer/id #uuid "d1cae79b-7afa-5ab6-af23-94c4f116816f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380447}] :answer-field/correct {:answer/id #uuid "609608a1-4ac9-531c-a5d5-8cc2f76ba843" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380446} :answer-field/id #uuid "71b0d4e9-4a30-506c-9105-a0dca9dce546" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380442}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f86e164-e19a-5fdd-bd77-619a454eb721" :question/math-academy-id "q-104973" :question/problem "![](images/94/94c9daf5f16776eef520e40f68a38dc5e05c4ceb5470cdc18880ac288a9ce031.png)\n\nWhich of the following statements are true regarding the function $f:[-1,5]\\to [-1,4]$ whose graph is shown above?\n\n- The range of $f$ is $[-1,3]$\n- $∀\\,y\\in [-1,3],$ $∃\\,x\\in [-1,5]$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. From the graph, the highest $y$-value is $3$ and the lowest $y$-value is $-1.$ The graph covers all $y$-values between $-1$ and $3$, including these numbers, so the range of the function is $[-1,3].$\n\n- Statement II is true. Since the range of $f$ is $[-1,3]$ and $[-1,3]$ is contained in that range, it follows that for all $y$ contained within $[-1,3],$ there exists some $x$ contained within $[-1,5]$ such that $f(x)=y.$\n\n- Statement III is false. As we can see from the range, there is no real number $x$ such that $f(x)=4.$ So, it's *not true* that for all $y$ contained within $[-1,4],$ there exists some $x$ contained within $[-1,5]$ such that $f(x)=y.$ In conclusion, $f$ is not a surjection of $[-1,5]$ onto $[-1,4].$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186380448 :knowledge-point/_questions [{:db/id 17592186152134 :knowledge-point/id #uuid "1324fd0b-5388-5133-ad6a-72d658e3c903" :knowledge-point/title "Functions Whose Codomain Is a Real Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7169a561-b8f0-5fd8-b2cb-07ec134a6809" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380450} {:answer/id #uuid "40bade29-1cbf-562b-8c33-4284af85c23f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380451} {:answer/id #uuid "0660c625-e54f-57ba-963b-bf51d1356163" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380452} {:answer/id #uuid "4e75d7f4-955b-5fdd-8214-5153e94aefa1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380453} {:answer/id #uuid "21e9aee4-8a84-5a8a-a120-f5629772fbf5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380454}] :answer-field/correct {:answer/id #uuid "0660c625-e54f-57ba-963b-bf51d1356163" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380452} :answer-field/id #uuid "f39635f8-50f8-55eb-b399-984c785839dd" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380449}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f729bcf8-f875-5e33-9fc0-12814c32c7be" :question/math-academy-id "q-104981" :question/problem "![](images/91/916c7fa803c4fb2949cfc9a7f1c8fd05dde8cfe004673eb22f313daeb89083be.png)\n\nWhich of the following statements are true regarding the function $f:[-1,4]\\to [-1,4]$ whose graph is shown above?\n\n- The range of $f$ is $[0,4]$\n- $∀\\,y\\in [-1,4],$ $∃\\,x\\in [-1,4]$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. From the graph, the highest $y$-value is $4$ and the lowest $y$-value is $0.$ The graph covers all $y$-values between $0$ and $4$, including these numbers, so the range of the function is $[0,4].$\n\n- Statement II is false. Consider, for example,  $y=-1.$ As we can see from the range, there is no real number $x\\in [-1,4]$ such that $f(x)=-1.$ So, it's *not true* that for all $y$ contained within $[-1,4],$ there exists some $x$ contained within $[-1,4]$ such that $f(x)=y.$\n\n- Statement III is false. Since statement II is false, $f$ is not a surjection of $[-1,4]$ onto $[-1,4].$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186380462 :knowledge-point/_questions [{:db/id 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5541a274-04c4-5faf-aeb1-c991d5425bc2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380464} {:answer/id #uuid "932934dc-d872-5e4f-b3d1-18854f187b9c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380465} {:answer/id #uuid "49d22d10-770d-51ab-9ecf-b3a111c042b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380466} {:answer/id #uuid "fd002e28-352a-5116-860f-f50a2ccff8d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380467} {:answer/id #uuid "0544a742-cd76-59cc-8090-f17e5cb913d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380468}] :answer-field/correct {:answer/id #uuid "0544a742-cd76-59cc-8090-f17e5cb913d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380468} :answer-field/id #uuid "04eacd6c-e1ff-5301-b9fb-365c92fc68d8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380463}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15ff4cc7-7dbb-588f-ad41-efc18bba219b" :question/math-academy-id "q-104997" :question/problem "Which of the following functions are surjections?\n\n- $g:Q\\to R$ defined by $g(x)=\\sqrt{x}$\n- $h:R\\to R$ defined by $h(x)=-{x}^{3}$\n- $f:(0,\\infty )\\to R$ defined by $f(x)={x}^{2}+x$" :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose ${2}^{1/4}\\in R.$ There is no number $x\\in Q$ such that $g(x)={2}^{1/4}.$ The only number $x$ that satisfies $g(x)=\\sqrt{x}={2}^{1/4}$ is $x=\\sqrt{2}\\notin Q.$\n\n- II is a surjection. Given $y\\in R,$ choose $x=-\\sqrt[3]{y}\\in R.$ Then $h(x)=h(-\\sqrt[3]{y})=-{(-\\sqrt[3]{y})}^{3}=y.$\n\n- III is *not* a surjection. As a counterexample, choose $-1\\in R.$ There is no number $x\\in (0,\\infty )$ such that $f(x)=-1.$ In fact ${x}^{2}+x>0$ for all $x\\in (0,\\infty ).$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id 17592186380469 :knowledge-point/_questions [{:db/id 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05a3447a-047f-53a1-a1a7-14d0160e224a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380471} {:answer/id #uuid "295e3c83-1294-5bab-8afc-57ca26687db9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380472} {:answer/id #uuid "990ea436-8870-5993-9e5a-3ba7ac5e05ff" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380473} {:answer/id #uuid "d67a9d77-88b8-5a9d-ba13-abf64c83c4ce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380474} {:answer/id #uuid "01ed7d59-dc74-5781-b41f-6241c43c513b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380475}] :answer-field/correct {:answer/id #uuid "990ea436-8870-5993-9e5a-3ba7ac5e05ff" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380473} :answer-field/id #uuid "6a3f5143-83c3-5718-baa2-eb554713414f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380470}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "170d4c2a-1e31-530e-82ce-91551c575c42" :question/math-academy-id "q-104999" :question/problem "Which of the following functions are surjections?\n\n- $f:{-1,0,1,2}\\to {-1,0,1,2,3}$ defined by $f(x)={x}^{2}-1$\n- $g:(-\\frac{\\pi }{2},\\frac{\\pi }{2})\\to R$ defined by $g(x)=\\operatorname{sin}⁡x$\n- $h:[0,\\infty )\\to [0,\\infty )$ defined by $h(x)=\\sqrt{x}$" :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose $2\\in {-1,0,1,2,3}.$ There is no number $x\\in {-1,0,1,2}$ such that $f(x)=2.$ The only number $x$ that satisfies $f(x)={x}^{2}-1=2$ is $x=\\sqrt{3},$ but $\\sqrt{3}\\notin {-1,0,1,2}.$\n\n- II is *not* a surjection. As a counterexample, choose $2\\in R.$ There is no number $x\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})$ such that $g(x)=2.$ In fact, $-1\\le \\operatorname{sin}⁡x\\le 1$ for all $x\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\n- III is a surjection. Given $y\\in [0,\\infty ),$ choose $x={y}^{2}\\in [0,\\infty ).$ Then $h(x)=h({y}^{2})=\\sqrt{{y}^{2}}=y.$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id 17592186380476 :knowledge-point/_questions [{:db/id 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78bf5df9-2155-5aaf-90d9-2cd85159ec9d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380478} {:answer/id #uuid "3122d473-a840-5c91-9362-bdc5d5e4bb35" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380479} {:answer/id #uuid "8636bde8-51b4-59ab-805e-d878f16182c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380480} {:answer/id #uuid "98bc1a46-8c35-54ea-9e57-4b780508ce5f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380481} {:answer/id #uuid "e1f89fad-3a88-5eed-afb6-77a91c9e2a42" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380482}] :answer-field/correct {:answer/id #uuid "78bf5df9-2155-5aaf-90d9-2cd85159ec9d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380478} :answer-field/id #uuid "527f27db-963b-508b-a409-e2056490114b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380477}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d8dd107-bc43-5af5-9ea8-482dedecfe3d" :question/math-academy-id "q-105006" :question/problem "Which of the following functions are surjections?\n\n- $f:{1,2,4,8}\\to {-1,0,1,2,3}$ defined by $f(x)={log}_{2}⁡x$\n- $g:(0,\\infty )\\to R$ defined by $g(x)=\\operatorname{log}⁡x$\n- $h:{-2,-1,0,1,2}\\to {0,1,2}$ defined by $h(x)=|x|$" :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose $-1$ from the range. The only number $x$ that satisfies $f(x)={log}_{2}⁡x=-1$ is $x=\\frac{1}{2},$ but $\\frac{1}{2}\\notin {1,2,4,8}.$\n\n- II is a surjection. Given $y\\in R,$ choose $x={10}^{y}\\in (0,\\infty ).$ Then $g(x)=g({10}^{y})=\\operatorname{log}⁡{10}^{y}=y.$\n\n- III is a surjection. Indeed, $h(-2)=2,$ $h(-1)=1$ and $h(0)=0.$ So, for every $y\\in {0,1,2},$ there exists an element $x\\in {-2,-1,0,1,2}$ such that $h(x)=y.$\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id 17592186380483 :knowledge-point/_questions [{:db/id 17592186152194 :knowledge-point/id #uuid "c805415f-c87d-50c5-b668-948fc46bcc7e" :knowledge-point/title "Identifying Injections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1a49b3f-0c1b-5bf5-af26-635c4bba54eb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380485} {:answer/id #uuid "89bf2227-54e9-5c00-9047-413e50c4ff7d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380486} {:answer/id #uuid "adfff9aa-358d-53a6-a580-53e56780f751" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380487} {:answer/id #uuid "1481a818-97ac-5252-a440-b3d085b28a3a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380488} {:answer/id #uuid "e073e3db-87a6-56be-bbf2-0031cd0d22c0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380489}] :answer-field/correct {:answer/id #uuid "89bf2227-54e9-5c00-9047-413e50c4ff7d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380486} :answer-field/id #uuid "6b80601b-1df0-56b4-a753-a199b40afe68" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380484}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b06d538-7443-54c1-b503-59c054bf5bb2" :question/math-academy-id "q-105118" :question/problem "![](images/26/26ec4cb2ec851e6a1b6d7f0ad99b0a49bf36f95d3c110d3777ca8e4a92177057.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- $f(1)=f(4)$\n- $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is not an injection" :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. According to the diagram, we have $f(1)=f(4)=4$ (we have arrows from $1\\in X$ and $4\\in X$ to $4\\in Y$).\n\n- Statement II is false. Again, we have $f(1)=f(4)$ but $1\\ne 4.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is false, $f$ is not an injection.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186380490 :knowledge-point/_questions [{:db/id 17592186152194 :knowledge-point/id #uuid "c805415f-c87d-50c5-b668-948fc46bcc7e" :knowledge-point/title "Identifying Injections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23227591-0dbd-51cf-8b68-96d742de06ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380492} {:answer/id #uuid "1d1187ca-2a33-5ef0-8421-7b83ac228ac7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380493} {:answer/id #uuid "48a97d1e-f9d6-5591-86e4-d5e4189f2ecb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380494} {:answer/id #uuid "fc002918-6bc7-5d9f-a7fa-f9b2256fadae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380495} {:answer/id #uuid "647d39d1-87e1-549f-b052-8cd11112b1b0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380496}] :answer-field/correct {:answer/id #uuid "fc002918-6bc7-5d9f-a7fa-f9b2256fadae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380495} :answer-field/id #uuid "77e0d80f-6572-5bbf-8f4d-571b4f8c97b5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380491}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4be96f58-f72b-5ffd-a1b3-6817c52a2536" :question/math-academy-id "q-105122" :question/problem "![](images/80/80b80ea901c031439e50f42b34146401c75c65f9947ecca75ee8afda94540465.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- $f(4)\\ne f(8)$\n- $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is not an injection" :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. According to the diagram, we have $f(4)=1$ (we have an arrow from $4\\in X$ to $1\\in Y$) and $f(8)=1$ (we have an arrow from $8\\in X$ to $1\\in Y$).\n\n- Statement II is false. According to the diagram, $f(4)=f(8)$ but $4\\ne 8.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is false, $f$ is not an injection.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186380497 :knowledge-point/_questions [{:db/id 17592186152194 :knowledge-point/id #uuid "c805415f-c87d-50c5-b668-948fc46bcc7e" :knowledge-point/title "Identifying Injections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c78f295e-dd31-5603-8284-84119a96b8c6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380499} {:answer/id #uuid "8ec7a43d-27ef-57fb-aa9d-886e20643d3f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380500} {:answer/id #uuid "fe1e62f0-7106-5b5a-a5ee-cb8de224060f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380501} {:answer/id #uuid "e4c29f67-b74d-5b3f-ac97-ea0553d0c6e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380502} {:answer/id #uuid "e48756ae-fbcc-50f3-9d13-e9521270ccba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380503}] :answer-field/correct {:answer/id #uuid "c78f295e-dd31-5603-8284-84119a96b8c6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380499} :answer-field/id #uuid "078df945-0251-5351-a4d1-ece62f0f470f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380498}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ef9f00e-29d5-5bdb-ace6-5ec77b1eb401" :question/math-academy-id "q-105126" :question/problem "![](images/3c/3cfee09c9688df45bd12654a1847ab9a2e9a311289e89dc52441abbb239138ed.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- $f(-4)=f(-1)$\n- $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is **one-to-one**" :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. According to the diagram, we have $f(-4)=8$ (we have an arrow from $-4\\in X$ to $8\\in Y$) and $f(-1)=0$ (we have an arrow from $-1\\in X$ to $0\\in Y$).\n\n- Statement II is true. As we can see from the diagram, there are no two distinct elements within $X$ that map to the same element in $Y.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is true, $f$ is an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186380504 :knowledge-point/_questions [{:db/id 17592186152196 :knowledge-point/id #uuid "a347133c-5e5a-5dd2-89ef-bdd14245ee6b" :knowledge-point/title "Identifying Injections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa93f529-50eb-54a0-8c81-2c8bd1c1b7e6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380506} {:answer/id #uuid "8b205019-1f5a-5aa4-a4ef-2119da75236f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380507} {:answer/id #uuid "747dc62c-6a2c-55c6-a1f7-d7e1e10d696c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380508} {:answer/id #uuid "4b1dcb41-e629-5798-bf64-7569082cca12" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380509} {:answer/id #uuid "9fe8a4b8-c750-536a-bf0e-42dc1e166f1e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380510}] :answer-field/correct {:answer/id #uuid "8b205019-1f5a-5aa4-a4ef-2119da75236f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380507} :answer-field/id #uuid "08268410-05b0-5ac4-986e-7a4efd0c99d1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380505}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a95fdab7-b3ba-5047-982f-ba6ecacd47b0" :question/math-academy-id "q-105129" :question/problem "![](images/2a/2a60bc27e7227cfe55c03611608e5210ad147d07058028e4ea78b10a96280797.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\n- $f(-1)=f(1)$\n- $∀\\,{x}_{1},{x}_{2}\\in R,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is an injection" :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. According to the graph, we have $f(-1)=1$ and $f(1)=3.$\n\n- Statement II is true. As we can see from the graph, it passes the horizontal line test, meaning that there are no two distinct elements within $R$ that map to the same element in $R.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $R,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is true, $f$ is an injection.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186380566 :knowledge-point/_questions [{:db/id 17592186133885 :knowledge-point/id #uuid "5ada5d20-89d8-5bc9-9b10-172356be0eb4" :knowledge-point/title "Identifying an Orthogonal Fundamental Subspaces of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aef522dc-c92a-50a1-9a9e-2b100b865ed8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380568} {:answer/id #uuid "ba70e4ec-1e50-51e3-804f-62a2ab327c75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380569} {:answer/id #uuid "546f5ba8-635f-509c-a718-5d331a77cf43" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380570} {:answer/id #uuid "a608c25c-ba30-5892-aeca-656907ef2a3d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380571} {:answer/id #uuid "e9eab9bd-1c17-5cf0-9670-52fcc5c9c416" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380572}] :answer-field/correct {:answer/id #uuid "e9eab9bd-1c17-5cf0-9670-52fcc5c9c416" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380572} :answer-field/id #uuid "e0c9a254-9720-5f7d-9149-5824dded661a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380567}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd0235ca-04db-545b-b3a6-a1ff38871984" :question/math-academy-id "q-109853" :question/problem "Which of the following subspaces must be orthogonal to $\\text{Null}({B}^{T})$ for every matrix $B?$\n\n- $\\text{Null}(B)$\n- $\\text{Col}(B)$\n- $\\text{Col}({B}^{T})$" :question/worked-solution "Recall that $\\text{Null}({B}^{T})$ is the left null space of $B.$ This consists of vectors that, when pre-multiplied by ${B}^{T},$ result in the zero-vector $0.$\n\nWhen pre-multiplying a vector by ${B}^{T},$ we actually multiply each row of ${B}^{T}$, that is, each column of $B$, by that vector. So, $\\text{Null}({B}^{T})$ must be orthogonal to the column space of $B,$ which is $\\text{Col}(B).$\n\nTherefore, the correct answer is \"II only.\"\n\n**Note:** In general, the four fundamental subspaces of a matrix $B$ can be schematically visualized, as shown below.\n\n![](images/18/18713ed3d103ca0a02d74cede1e6448012e0aa28a2df804d41cfb277589a0158.png)"}] [{:db/id 17592186380740 :knowledge-point/_questions [{:db/id 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82213b75-a5ae-5da4-9897-32dd48e61df7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186380742} {:answer/id #uuid "8c14d478-1d38-5431-905c-fc5810a27fa3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380743} {:answer/id #uuid "cdb49c3c-6f34-5c69-bd2f-99edd12b5d16" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380744} {:answer/id #uuid "daf8aca0-cf96-5262-acc3-32c815cb2206" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380745} {:answer/id #uuid "105339bb-6a5f-5f2e-b085-338665cd1a5a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186380746}] :answer-field/correct {:answer/id #uuid "8c14d478-1d38-5431-905c-fc5810a27fa3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380743} :answer-field/id #uuid "4deded69-ab37-54db-926d-bebc06210e8e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380741}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bbe1542-19d1-529e-93b1-09c0d710a430" :question/math-academy-id "q-127960" :question/problem "Which of the following statements are logically equivalent?\n\n- $A∨B$\n- $¬(¬A∧B)$\n- $A∨¬B$" :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,A∨B\\,$ | $\\,¬(¬A∧B)\\,$ | $\\,A∨¬B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ | $\\text{T}$ |\n\nWe see that only the statements $¬(¬A∧B)$ and $A∨¬B$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id 17592186380824 :knowledge-point/_questions [{:db/id 17592186152199 :knowledge-point/id #uuid "624215ff-efdc-5b12-8d61-9d66371672d9" :knowledge-point/title "Determining a Valid Region to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f55ac35-0429-5f53-9c82-8a1dc5de7647" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380826} {:answer/id #uuid "9b9afac2-8adc-55bb-aa15-253c9092e751" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380827} {:answer/id #uuid "3f36b5a3-f0dd-5bbb-a57f-d1eb09881d58" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380828} {:answer/id #uuid "86cbd8f9-532d-5e3b-b7f0-ebb4a2d9371d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380829} {:answer/id #uuid "96e3027d-f252-527f-aa78-82d026bf2265" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380830}] :answer-field/correct {:answer/id #uuid "9b9afac2-8adc-55bb-aa15-253c9092e751" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380827} :answer-field/id #uuid "2b8a2a47-8dea-5c8c-b603-8b38ec11a4f6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380825}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a85798d-b6a4-58e9-9e7d-5ef7eeb355cb" :question/math-academy-id "q-129664" :question/problem "Let $D$ be a finite region enclosed by the curves $y=-{x}^{2}+2$ and $y=x.$ If \n\n$$\nf(x,y)={\\begin{aligned}{x}^{3}-xy, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}({x}^{3}-xy)\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\n- $R=[-2,1]\\times [-2,2]$\n- $R=[-2,2]\\times [-2,1]$\n- $R=[-2,2]\\times [-2,2]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/3f/3f071c27bfa281abcaabe63d4d67797ea7b051b931ee7658d2a32a58f80a0bac.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}{x}^{3}-xy, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nthen we obtain\n\n$$\n{∬}_{D}({x}^{3}-xy)\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangle II does not cover the region $D.$\n\n- Rectangles I and III cover the region $D$ completely.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186380831 :knowledge-point/_questions [{:db/id 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2cb98b9-07e9-5adf-9ed5-d8b22002b55b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380833} {:answer/id #uuid "a7e49d4a-779c-51c8-953f-eb542f8be617" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380834} {:answer/id #uuid "5f81f7a9-b58a-5b71-9ad7-73bed790eac5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380835} {:answer/id #uuid "d1376ad0-7a8b-5e52-b8e6-f60d7630fb80" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380836} {:answer/id #uuid "79cde0a5-394f-5336-a8d6-a4d19d941d13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380837}] :answer-field/correct {:answer/id #uuid "a7e49d4a-779c-51c8-953f-eb542f8be617" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186380834} :answer-field/id #uuid "1d00e358-f7cd-57b0-8aa1-e4fe6d25e944" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380832}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07cce28a-e3b6-5366-babf-23b7cf23e641" :question/math-academy-id "q-129784" :question/problem "![](images/c5/c54c756568a5f20d1d82a228c333dc4253a82236060ab2a7aea6260b10612140.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)={\\begin{aligned}x{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\n- ${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-4,3]\\times [-2,3]$\n- ${∬}_{R}x{y}^{3}\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,3]\\times [-2,2]$\n- ${∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-2,4]$" :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)={\\begin{aligned}x{y}^{3}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}x{y}^{3}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement II is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement III is true. The rectangle $R$ covers the region $D$ completely.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186380838 :knowledge-point/_questions [{:db/id 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4b2bc5c-f10b-5b15-9c53-5b71c501c0fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380840} {:answer/id #uuid "550e22a7-8d98-5669-a03f-2617ea80ed7a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380841} {:answer/id #uuid "082de418-b4f7-599c-972c-ae9a1fee0643" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380842} {:answer/id #uuid "d690c9d1-dc38-5277-823b-6228cf42526e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of these listed" :db/id 17592186380843} {:answer/id #uuid "a25a7123-e2cd-58ca-857d-079bc6e0ce4e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380844}] :answer-field/correct {:answer/id #uuid "550e22a7-8d98-5669-a03f-2617ea80ed7a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380841} :answer-field/id #uuid "afa4a9d2-1409-5e7a-9148-465b1c07f58d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380839}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d32f310d-7c80-57bd-8ae7-821e89abc170" :question/math-academy-id "q-129901" :question/problem "![](images/e2/e2ded513c72c8029b7d2909d2e3b37cbd659c4ba60a7be72c81379626a7a1234.png)\n\nConsider the region $D$ shown above. If $R=[-1,2]\\times [-1,3],$ and\n\n$$\n{∬}_{D}{e}^{x}\\operatorname{cos}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nII. $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}{e}^{x}\\operatorname{cos}⁡y, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/77/77c8e1b1aacd29c6d69aa3c641c1641f43ff2aa1467dc713d417641f8b76b066.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${e}^{x}\\operatorname{cos}⁡y$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}{e}^{x}\\operatorname{cos}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions II and III. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,3)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function I equals ${e}^{x}\\operatorname{cos}⁡y$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186380845 :knowledge-point/_questions [{:db/id 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb4515cd-9e47-5ff7-b9db-80d4caff3722" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186380847} {:answer/id #uuid "9fd2179a-393c-5d9d-935b-1e1aabd85a88" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186380848} {:answer/id #uuid "294b19d4-4da4-5a2d-964c-fb0115fffed6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186380849} {:answer/id #uuid "5d683d66-22db-5f8a-9a0c-c12b9c67e331" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380850} {:answer/id #uuid "fc2be26d-1186-5a98-9d33-d6449a993930" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186380851}] :answer-field/correct {:answer/id #uuid "5d683d66-22db-5f8a-9a0c-c12b9c67e331" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186380850} :answer-field/id #uuid "e22d5e18-f2d7-5ad6-beaf-4cf2d9f87028" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186380846}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a021db95-99b8-59d4-be5a-36dd8114ebe0" :question/math-academy-id "q-129907" :question/problem "Let $D$ be a finite region enclosed by the curve $\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{4}=1.$ If $R=[-3,3]\\times [-2,2],$ and\n\n$$\n{∬}_{D}y{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n\nII. $\\{\\begin{aligned}y{e}^{x+y}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}0, & (x,y)\\in D \\\\ y{e}^{x+y}, & (x,y)\\in R∖D\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](images/38/38c44f897999039f88df2c3e549a1229ec9f9a979bbc83dfe1a5d7279701450d.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $y{e}^{x+y}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}y{e}^{x+y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal $y{e}^{x+y}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(3,2)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186381672 :knowledge-point/_questions [{:db/id 17592186198261 :knowledge-point/id #uuid "0d6db336-845a-506a-b020-cced1b38e23a" :knowledge-point/title "Using Laws Involving Implications and Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "209d2bd5-6761-5c94-ba92-88b5074ca51b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186381674} {:answer/id #uuid "199c8724-565e-5dce-ad7e-bfa2f74b7250" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381675} {:answer/id #uuid "e4cd27b5-8f1c-59bc-ba84-fd4c32304501" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381676} {:answer/id #uuid "c2374090-35ce-576f-8a84-1f7140d89d0e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186381677} {:answer/id #uuid "7c6cbc35-ea42-58a4-bbec-262e4e83fef7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381678}] :answer-field/correct {:answer/id #uuid "7c6cbc35-ea42-58a4-bbec-262e4e83fef7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381678} :answer-field/id #uuid "fdc97073-4b1c-5916-9f40-170a84490dd3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381673}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf3548ae-a137-5c57-8262-82ca0ade3b9d" :question/math-academy-id "q-183356" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $x\\in \\{-1,0,3,7\\}\\cap N.$ $\\,$ $B(x):$ $x\\in \\{3,7\\}.$ \n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\nI. $x\\in \\{-1,0,3,7\\}\\cap N$ is equivalent to  $x\\in N.$\n\nII. $x\\in \\{-1,0,3,7\\}\\cap N$ if and only if $x\\in \\{3,7\\}.$\n\nIII. If $x\\in \\{-1,0,3,7\\}\\cap N$ then $x\\in \\{3,7\\},$ or if $x\\in \\{3,7\\}$ then $x\\in \\{-1,0,3,7\\}\\cap N.$" :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $x\\in \\{-1,0,3,7\\}\\cap N$ if and only if $x\\in \\{3,7\\}.$\n\n- $x\\in \\{-1,0,3,7\\}\\cap N$ is equivalent to $x\\in \\{3,7\\}.$\n\n- If $x\\in \\{-1,0,3,7\\}\\cap N$ then $x\\in \\{3,7\\},$ and if $x\\in \\{3,7\\}$ then $x\\in \\{-1,0,3,7\\}\\cap N.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186381679 :knowledge-point/_questions [{:db/id 17592186198261 :knowledge-point/id #uuid "0d6db336-845a-506a-b020-cced1b38e23a" :knowledge-point/title "Using Laws Involving Implications and Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24f5e0da-6ff9-54f8-9899-0fcb4faf174b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186381681} {:answer/id #uuid "6ba148f2-8aed-5afe-b8f6-2d6df1077df1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186381682} {:answer/id #uuid "2514634f-1c9a-516d-9f01-6fcf8e8bb2ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381683} {:answer/id #uuid "eb6bb8e3-7838-5de4-b233-6ca16778703e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186381684} {:answer/id #uuid "d12b87f7-5b3d-5c51-b825-9978e6d5f710" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381685}] :answer-field/correct {:answer/id #uuid "2514634f-1c9a-516d-9f01-6fcf8e8bb2ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381683} :answer-field/id #uuid "c8661f64-c8fd-5a5e-8d68-13ad71e9e23d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381680}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9aa776da-0143-5b4b-9d08-2751ea2726a2" :question/math-academy-id "q-183357" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $3\\,|\\,x.$ $\\,$ $B(x):$ $3\\,|\\,(x+15).$\n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\nI. $3\\,|\\,x$ if and only if $5\\,|x.$\n\nII. If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ or if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$\n\nIII. If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ and if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$" :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $3\\,|\\,x$ if and only if $3\\,|\\,(x+15).$\n\n- $3\\,|\\,x$ is equivalent to $3\\,|\\,(x+15).$\n\n- If $3\\,|\\,x$ then $3\\,|\\,(x+15),$ and if $3\\,|\\,(x+15)$ then $3\\,|\\,x.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186381714 :knowledge-point/_questions [{:db/id 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8ae1369-b7ee-5c00-a777-3fe6f0aa3a0d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381716} {:answer/id #uuid "6b391104-ba09-582c-a764-3db08a687474" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381717} {:answer/id #uuid "0b8606e8-2d30-5d6c-bbb3-aa8426a3b2c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381718} {:answer/id #uuid "fe3e489a-837d-5d9c-8b82-1575c46709a5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381719} {:answer/id #uuid "50ed8ad0-0200-5320-9567-1a74e669e541" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381720}] :answer-field/correct {:answer/id #uuid "6b391104-ba09-582c-a764-3db08a687474" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381717} :answer-field/id #uuid "3aacbb1a-6cc8-56de-a3cf-e8097ea08557" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381715}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1dd2623-6f10-56c3-88a0-4d1c15254f6e" :question/math-academy-id "q-183501" :question/problem "$\\,$ $P(y):$ ${y}^{3}\\ge 0$ and ${y}^{2}<0.$\n\nGiven that the above predicate is defined over the universal set ${R}_{0}^{+},$ which of the following statements are true?\n\n- The truth set of $P(y)$ is $∅.$\n- The truth set of $P(y)$ is ${R}_{0}^{+}.$\n- $∀y\\in {R}_{0}^{+},\\,P(y).$" :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"${y}^{3}\\ge 0$\" is ${R}_{0}^{+},$ and\n\n- the truth set of \"${y}^{2}<0$\" is $∅.$\n\nSo, the truth set of our predicate is \n\n$$\n{T}_{P}={R}_{0}^{+}\\cap ∅=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is true. The truth set is empty.\n\n- Statement II is false. Indeed, ${T}_{P}\\ne {R}_{0}^{+}.$\n\n- Statement III is false. Since ${T}_{P}$ does *not* coincide with the universal set, the statement $∀y\\in R,\\,P(y)$ is false.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186381721 :knowledge-point/_questions [{:db/id 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cc087c2-923a-5910-a9ef-14c65af62588" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381723} {:answer/id #uuid "a82bf02c-c138-52ea-bedf-aa6d9acfc4bd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381724} {:answer/id #uuid "55d75bb9-2dcc-5444-8dd9-16a2e123e059" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381725} {:answer/id #uuid "460a515f-8e30-53e1-b2a3-9c9ed3d0dcba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381726} {:answer/id #uuid "d79c1d50-f77c-5ac2-9649-da9e99566897" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381727}] :answer-field/correct {:answer/id #uuid "9cc087c2-923a-5910-a9ef-14c65af62588" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381723} :answer-field/id #uuid "513be37b-b67b-5495-aa2e-ed37027d1b39" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381722}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "df50f5a8-2783-58fd-a4cd-90489ec7d8e6" :question/math-academy-id "q-183505" :question/problem "$\\,$ $P(x):$ $x>0$ or $x\\le 0.$\n\nGiven that the above predicate is defined over the universal set $Z,$ which of the following statements are true?\n\n- The truth set of $P(x)$ is $∅.$\n- The truth set of $P(x)$ is $Z.$\n- $∀x\\in Z,\\,P(x).$" :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"$x>0$\" is ${Z}^{+},$ and\n\n- the truth set of \"$x\\le 0$\" is ${Z}_{0}^{-}.$\n\nSo, the truth set of our predicate is \n\n$$\n{T}_{P}={Z}^{+}\\cup {Z}_{0}^{-}=Z.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is false. The truth set is *not* empty.\n\n- Statement II is true. Indeed, ${T}_{P}=Z.$\n\n- Statement III is true. Since ${T}_{P}$ coincides with the universal set, the statement $∀x\\in Z,\\,P(x)$ is true.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186381728 :knowledge-point/_questions [{:db/id 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e559b713-e0dc-5119-9e81-6afae77d2e13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186381730} {:answer/id #uuid "758e76ec-b605-5ae0-b77f-95c41878a815" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381731} {:answer/id #uuid "0a1a2f46-9029-5c04-8b12-dc4bfb605f13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381732} {:answer/id #uuid "513a5cc1-c39d-50fa-a204-e97f550b4c10" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381733} {:answer/id #uuid "7affa7f5-9f6c-568e-883a-be6cabd4d82d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381734}] :answer-field/correct {:answer/id #uuid "0a1a2f46-9029-5c04-8b12-dc4bfb605f13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381732} :answer-field/id #uuid "6d507c6c-26e9-534f-84d7-d4a455d7ca6a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381729}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9947189b-8991-5f0c-ad01-e90d4c094369" :question/math-academy-id "q-183507" :question/problem "$\\,$ $P(z):$ ${e}^{z}<0$ or ${z}^{4}\\le -1.$\n\nGiven that the above predicate is defined over the universal set $R,$ which of the following statements are true?\n\n- The truth set of $P(z)$ is $∅.$\n- The truth set of $P(z)$ is $R.$\n- $∀z\\in R,\\,P(z).$" :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"${e}^{z}<0$\" is $∅,$ and\n\n- the truth set of \"${z}^{4}\\le -1$\" is $∅.$\n\nSo, the truth set of our predicate is \n\n$$\n{T}_{P}=∅\\cup ∅=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is true. The truth set is empty.\n\n- Statement II is false. Indeed, ${T}_{P}\\ne R.$\n\n- Statement III is false. Since ${T}_{P}$ does *not* coincide with the universal set, the statement $∀z\\in R,\\,P(z)$ is false.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186381735 :knowledge-point/_questions [{:db/id 17592186152081 :knowledge-point/id #uuid "114dedd9-ed3d-5d25-8616-030ea4bd84c9" :knowledge-point/title "Identifying True Statements Involving Universal Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60816447-8e01-558a-98c7-c7d2ea05adac" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381737} {:answer/id #uuid "8916a66d-c643-5c2f-bd17-ce73d117d3b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381738} {:answer/id #uuid "2203b41c-ae30-5a22-86e3-3f23ea03e531" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381739} {:answer/id #uuid "ab15b8c9-5c02-528d-bc7c-1c3e1595107c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381740} {:answer/id #uuid "050255d5-55c3-5434-b1fb-5676d408b9b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381741}] :answer-field/correct {:answer/id #uuid "60816447-8e01-558a-98c7-c7d2ea05adac" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381737} :answer-field/id #uuid "4bdca389-545f-586b-905f-d9f4acda2d50" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381736}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "53e303c8-88d9-51db-bc34-ac5638b42f29" :question/math-academy-id "q-183511" :question/problem "$\\,$ $P(z):$ $\\frac{z}{2}\\in Q⇒(z+1)^{2}\\ge 0.$\n\nGiven that the above predicate is defined over the universal set $Q,$ which of the following statements are true?\n\n- The truth set of $P(z)$ is $∅.$\n- The truth set of $P(z)$ is $Q.$\n- $∀z\\in Q,\\,P(z).$" :question/worked-solution "The *universal quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∀x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true on the entire universal set $U,$ i.e. if the truth set ${T}_{P}$ of the predicate coincides with the universal set $U:$\n\n$$\n{T}_{P}=U\n$$\n\nFirst, notice that:\n\n- the truth set of \"$\\frac{z}{2}\\in Q$\" is $Q,$ and\n\n- the truth set of \"$(z+1)^{2}\\ge 0$\" is $Q.$\n\nSince $A⇒B≡¬A∨B,$ the truth set of our predicate is \n\n$$\n{T}_{P}=\\overset{―}{Q}\\cup Q=∅\\cup Q=Q.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is false. The truth set is not empty.\n\n- Statement II is true. Indeed, ${T}_{P}=Q.$\n\n- Statement III is true. Since ${T}_{P}$ coincides with the universal set, the statement $∀z\\in Q,\\,P(z)$ is true.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186381749 :knowledge-point/_questions [{:db/id 17592186152083 :knowledge-point/id #uuid "320c4694-1904-5fc7-a324-a4c89f0e3257" :knowledge-point/title "Identifying True Statements Involving Existential Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1a68cd3-a209-55d3-a3d8-25a77ff1f9b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381751} {:answer/id #uuid "82ca3bb3-266a-5eb8-8810-df05717789a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186381752} {:answer/id #uuid "65ae5aff-2f74-53fe-b4a3-84427d4067fc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381753} {:answer/id #uuid "055c76e7-59ee-5b3b-bf61-9c2f432cc842" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381754} {:answer/id #uuid "97582ec3-dc87-5beb-8eb8-161a6bef315e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381755}] :answer-field/correct {:answer/id #uuid "65ae5aff-2f74-53fe-b4a3-84427d4067fc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381753} :answer-field/id #uuid "0477c06d-a387-55dd-a1ab-ae56b8769dcd" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381750}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79851a4f-18e1-5d49-91ff-0a7efb6d90a3" :question/math-academy-id "q-183549" :question/problem "$\\,$ $P(z):$ $\\sqrt{z}<1$\n\nGiven that the above predicate is defined over the universal set $N,$ which of the following statements are true?\n\n- The truth set of $P(z)$ is $∅.$\n- The truth set of $P(z)$ is $N.$\n- $∃z\\in N,\\,P(z).$" :question/worked-solution "The *existential quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∃x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true for a single element $x\\in U,$ i.e. if the truth set ${T}_{P}$ of the predicate is not empty:\n\n$$\n{T}_{P}\\ne ∅\n$$\n\nFirst, notice that the truth set of our predicate is \n\n$$\n{T}_{P}=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is true. The truth set is empty.\n\n- Statement II is false. Indeed, ${T}_{P}\\ne N.$\n\n- Statement III is false. Since ${T}_{P}$ is empty, the statement $∃z\\in N,\\,P(z)$ is false.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186381763 :knowledge-point/_questions [{:db/id 17592186152083 :knowledge-point/id #uuid "320c4694-1904-5fc7-a324-a4c89f0e3257" :knowledge-point/title "Identifying True Statements Involving Existential Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1c3e13d-dfe9-54ce-bd49-3ad00ea62271" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381765} {:answer/id #uuid "720869ce-9907-570c-9524-4464449e67ab" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381766} {:answer/id #uuid "5894d3c3-41da-538b-8764-e57f7b818aa3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381767} {:answer/id #uuid "9c11803d-8e21-563f-aa8b-aaa591182679" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381768} {:answer/id #uuid "9308c0b8-8805-5989-9517-e7ed3dd40f2d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381769}] :answer-field/correct {:answer/id #uuid "e1c3e13d-dfe9-54ce-bd49-3ad00ea62271" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381765} :answer-field/id #uuid "3fa1dcb4-d3c8-577d-b54e-e234305eda3b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381764}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1f36cab2-ae5b-5390-a225-e9d92c28352a" :question/math-academy-id "q-183554" :question/problem "$\\,$ $P(x):$ ${x}^{3}<0$ or ${x}^{2}=0$\n\nGiven that the above predicate is defined over the universal set ${Z}^{-},$ which of the following statements are true?\n\n- The truth set of $P(x)$ is $∅.$\n- The truth set of $P(x)$ is ${Z}^{-}.$\n- $∃x\\in {Z}^{-},\\,P(x).$" :question/worked-solution "The *existential quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∃x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true for a single element $x\\in U,$ i.e. if the truth set ${T}_{P}$ of the predicate is not empty:\n\n$$\n{T}_{P}\\ne ∅\n$$\n\nFirst, notice that:\n\n- the truth set of \"${x}^{3}<0$\" is the set ${Z}^{-},$ and\n\n- the truth set of \"${x}^{2}=0$\" is $∅.$\n\nSo, the truth set of our predicate is\n\n$$\n{T}_{P}={Z}^{-}\\cup ∅={Z}^{-}.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is false. The truth set is *not* empty.\n\n- Statement II is true. Indeed, ${T}_{P}={Z}^{-}.$\n\n- Statement III is true. Since ${T}_{P}$ is *not* empty, the statement $∃x\\in {Z}^{-},\\,P(x)$ is true.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186381770 :knowledge-point/_questions [{:db/id 17592186152083 :knowledge-point/id #uuid "320c4694-1904-5fc7-a324-a4c89f0e3257" :knowledge-point/title "Identifying True Statements Involving Existential Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "662c24e6-7d42-57e1-8eb0-87256dabb5f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381772} {:answer/id #uuid "856bbb2f-1280-5e6c-b3f4-140c644a21b5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381773} {:answer/id #uuid "60d8cc35-c88b-5733-9f8f-48b69b6a7ede" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381774} {:answer/id #uuid "7c3c1b6c-d3b0-57fb-b1c4-558ac6d76d14" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381775} {:answer/id #uuid "334de6a5-1f4c-514e-acc5-e0737160100c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381776}] :answer-field/correct {:answer/id #uuid "662c24e6-7d42-57e1-8eb0-87256dabb5f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381772} :answer-field/id #uuid "0fa19dbf-ef0b-5a19-95f6-1cf27ea12075" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381771}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "79e978ef-4c7c-5a72-a1cc-3c8d675edfbc" :question/math-academy-id "q-183559" :question/problem "$\\,$ $P(x):$ $\\sqrt{x}-2=0⇒{x}^{2}\\in N$\n\nGiven that the above predicate is defined over the universal set $Z,$ which of the following statements are true?\n\n- The truth set of $P(x)$ is $∅.$\n- The truth set of $P(x)$ is $Z.$\n- $∃x\\in Z,\\,P(x).$" :question/worked-solution "The *existential quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∃x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true for a single element $x\\in U,$ i.e. if the truth set ${T}_{P}$ of the predicate is not empty:\n\n$$\n{T}_{P}\\ne ∅\n$$\n\nFirst, notice that:\n\n- the truth set of \"$\\sqrt{x}-2=0$\" is the set ${4},$ and\n\n- the truth set of \"${x}^{2}\\in N$\" is $Z∖{0}.$\n\nSince $A⇒B≡¬A∨B,$ the truth set of our predicate is \n\n$$\n{T}_{P}=\\overset{―}{{4}}\\cup (Z∖{0})=(Z∖{4})\\cup (Z∖{0})=Z.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is false. The truth set is *not* empty.\n\n- Statement II is true. Indeed, ${T}_{P}=Z.$\n\n- Statement III is true. Since ${T}_{P}$ is *not* empty, the statement $∃x\\in Z,\\,P(x)$ is true.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186381791 :knowledge-point/_questions [{:db/id 17592186152089 :knowledge-point/id #uuid "6927f03c-aa7a-56ac-8cd0-c036a11aadc9" :knowledge-point/title "Finding the Truth Value of a Statement Involving Nested Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd4fafd1-106f-58fd-9bdd-0fd2d8c1e5d1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186381793} {:answer/id #uuid "f04189f1-140d-5299-8a72-b1c861922d5e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186381794} {:answer/id #uuid "073f4563-85a6-5f88-b0fd-e19794205bba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186381795} {:answer/id #uuid "76a90421-5301-5012-9f90-599aed75523f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381796} {:answer/id #uuid "47355b8a-8fe2-5619-b9df-2617c195eb71" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381797}] :answer-field/correct {:answer/id #uuid "fd4fafd1-106f-58fd-9bdd-0fd2d8c1e5d1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186381793} :answer-field/id #uuid "75bd0470-0384-5aff-b357-d583645bbff8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381792}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44159662-1bf3-5bee-9ce6-75e394e9c1e7" :question/math-academy-id "q-183586" :question/problem "Let $x\\in R$ and $y\\in R.$ Which of the following statements are true?\n\n- $∀\\,y\\in R,\\,\\sqrt{2y}\\in R.$\n- The truth set of the predicate $(\\,∀\\,y\\in R,\\,\\sqrt{xy}\\in R\\,)$ is $R.$\n- $∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R.$" :question/worked-solution "First, notice that the statement \n\n$$\n∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R\n$$\n\nfrom option III reads as follows:\n\n$\\,$ For all reals $x$ and $y,$ we have $\\sqrt{xy}\\in R.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false since $\\sqrt{2y}\\in R$ is not true for some real $y.$ Say, for $y=-1.$\n\n- Statement II is false. For the predicate\n\n$$\nP(x):\\,∀\\,y\\in R,\\,\\sqrt{xy}\\in R\n$$\n\nwe note that $P(x)$ is false for all values $x\\in R.$ For example, \n\n$$\nP(1):\\,∀\\,y\\in R,\\,\\sqrt{y}\\in R\n$$\n\nis false, since we can take $y=-1.$ Similarly,\n\n$$\nP(2):\\,∀\\,y\\in R,\\,\\sqrt{2y}\\in R\n$$\n\nis false, since we can take $y=-2.$ In general, it's sufficient to take $y=-x$ for any value of $x.$\n\n- Statement III is false. The sentence \n\n$$\n(\\,∀\\,x,y\\in R,\\,\\sqrt{xy}\\in R\\,)\n$$\n\n \ncan be written as\n\n$$\n∀x\\in R\\,(\\,{{∀y\\in R,\\,\\sqrt{xy}\\in R}_{⏟}}_{P(x)}\\,)\n$$\n\nwhich is true whenever the inner predicate $P(x)$ is true over the universal set $R.$ But, according to statement II, this is not the case.\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id 17592186381812 :knowledge-point/_questions [{:db/id 17592186152089 :knowledge-point/id #uuid "6927f03c-aa7a-56ac-8cd0-c036a11aadc9" :knowledge-point/title "Finding the Truth Value of a Statement Involving Nested Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb0b4120-d978-50c6-a341-00c99a12de11" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186381814} {:answer/id #uuid "1d52a529-8fe0-5291-b7a1-8c48cd40ae15" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186381815} {:answer/id #uuid "99d55616-d943-5257-8db9-3a1ca97f5337" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381816} {:answer/id #uuid "b019fb33-3101-5338-a698-0bc4edab00e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381817} {:answer/id #uuid "a66a288e-45ca-53f9-83ae-6b8ccc13cf12" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381818}] :answer-field/correct {:answer/id #uuid "b019fb33-3101-5338-a698-0bc4edab00e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381817} :answer-field/id #uuid "53dcc3cd-8f67-542e-9c1e-3951ba07c232" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381813}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "391922f6-f189-52a8-9bf4-83a4fbad32e9" :question/math-academy-id "q-183598" :question/problem "Let $x\\in R$ and $y\\in R.$ Which of the following statements are true?\n\n- $∀\\,y\\in R,\\,2y=0.$\n- The truth set of the predicate $(\\,∀y\\in R,\\,xy=0\\,)$ is $∅.$\n- $∃\\,x\\in R,\\,∀y\\in R,\\,xy=0.$" :question/worked-solution "First, notice that the statement \n\n$$\n∃\\,x\\in R,\\,∀y\\in R,\\,xy=0\n$$\n\nfrom option III reads as follows:\n\n$\\,$ There exists a real $x$ such that, for every real $y,$ we have $xy=0.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false since $2y=0$ is not true for some real $y.$ Say, for $y=1.$\n\n- Statement II is false.  The predicate\n\n$$\nP(x):\\,∀\\,y\\in R,\\,xy=0\n$$\n\nis true for some $x\\in R.$ For example, \n\n$$\nP(0):\\,∀\\,y\\in R,\\,0\\cdot y=0\n$$\n\nis true. Therefore, its truth set is not empty.\n\n- Statement III is true. The sentence \n\n$$\n(\\,∃\\,x\\in R,\\,∀y\\in R,\\,xy=0\\,)\n$$\n\ncan be written as\n\n$$\n∃\\,x\\in R\\,(\\,{{∀y\\in R,\\,xy=0}_{⏟}}_{P(x)}\\,)\n$$\n\nwhich is true whenever the inner predicate $P(x)$ has a nonempty truth set. And according to statement II, this is the case.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186381826 :knowledge-point/_questions [{:db/id 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ea5100c-a64f-53fe-8a32-7f0c9edf9359" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381828} {:answer/id #uuid "dc71ecf3-7dc5-5acd-a148-7adeea3c24dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381829} {:answer/id #uuid "2d0678ee-3b61-5b17-bac8-a3122d2e3755" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381830} {:answer/id #uuid "481e5510-d720-5cc0-809b-69c0e5b6fa92" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186381831} {:answer/id #uuid "e11f9f07-afbf-58f3-929d-f6acb70fb54a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381832}] :answer-field/correct {:answer/id #uuid "dc71ecf3-7dc5-5acd-a148-7adeea3c24dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381829} :answer-field/id #uuid "d8ab54ab-c195-536b-a3d2-47150a0c3493" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381827}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e3ef236-7e81-55bf-8f08-564fa1c1ae50" :question/math-academy-id "q-183669" :question/problem "$$\n(\\,∃y\\in (0,1),\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}y=1\\,)⇒(\\,∀{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}\\in (1,2),\\,x{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}>3\\,)\n$$\n\nWhich occurrences of the variables in the expression above are free?" :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $x$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $x.$\n\n- Occurrence II of the variable $z$ is *bound* since it is placed right next to the quantifier $∀:$\n\n$$\n(\\,∃y\\in (0,1),\\,xy=1\\,)⇒(\\,∀{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (1,2),\\,xz>3\\,)\n$$\n\n- Occurrence III of the variable $z$ is *bound* since it lies within the scope of the quantifier $∀$ that uses $z:$\n\n$$\n(\\,∃y\\in (0,1),\\,xy=1\\,)⇒(\\,∀z\\in (1,2),\\,\\overset{\\text{scope of }∀z}{\\overset{⏞}{x{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}>3}})\n$$\n\n \n\nThe occurrences of variables in the expression are as follows:\n\n$$\n(\\,∃{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (0,1),\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}=1\\,)⇒(\\,∀{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in (1,2),\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}>3\\,)\n$$\n\nTherefore, the free occurrence is \"I only.\""}] [{:db/id 17592186381853 :knowledge-point/_questions [{:db/id 17592186152083 :knowledge-point/id #uuid "320c4694-1904-5fc7-a324-a4c89f0e3257" :knowledge-point/title "Identifying True Statements Involving Existential Quantifiers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9170f417-3243-5e47-afc3-cb7625e69ced" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381855} {:answer/id #uuid "780c2a19-38fd-51db-8977-e14b43049e9f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381856} {:answer/id #uuid "566a406d-61f6-5ded-87f0-5351bdc56203" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381857} {:answer/id #uuid "dd8655cd-b11a-5ceb-aa68-03293daf3557" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id 17592186381858} {:answer/id #uuid "39a7b5b2-e69b-5724-95ec-fa51562eb370" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381859}] :answer-field/correct {:answer/id #uuid "780c2a19-38fd-51db-8977-e14b43049e9f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381856} :answer-field/id #uuid "d5a147db-56a8-50cd-983c-49933ef4cc27" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381854}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a35352a2-6307-508d-9bf3-f6a84812f3f7" :question/math-academy-id "q-216492" :question/problem "$\\,$ $P(x):$ $2x+1=0$\n\nGiven that the above predicate is defined over the universal set $Z,$ which of the following statements are true?\n\n- The truth set of $P(x)$ is $∅.$\n- The truth set of $P(x)$ is $Z.$\n- $∃x\\in Z,\\,P(x).$" :question/worked-solution "The *existential quantification* of a predicate $P(x),$ defined over the universal set $U,$ transforms this predicate into a statement that we write as\n\n$$\n∃x\\in U,\\,P(x).\n$$\n\nThis statement is true if the predicate $P(x)$ is true for a single element $x\\in U,$ i.e. if the truth set ${T}_{P}$ of the predicate is not empty:\n\n$$\n{T}_{P}\\ne ∅\n$$\n\nFirst, notice that the solution of the equation $2x+1=0$ is $x=-\\frac{1}{2},$ but this solution doesn't belong to the universal set. Therefore, the truth set of our predicate is \n\n$$\n{T}_{P}=∅.\n$$\n\nWith that in mind, let's inspect each of the given statements.\n\n- Statement I is true. The truth set is empty.\n\n- Statement II is false.\n\n- Statement III is false. Since ${T}_{P}$ is empty, the statement $∃x\\in Z,\\,P(x)$ is false.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186381867 :knowledge-point/_questions [{:db/id 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a881413f-5700-555d-b08e-499cb6cfc5ed" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381869} {:answer/id #uuid "f8558f2d-6300-52d5-81c0-08a4492e57cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186381870} {:answer/id #uuid "f1624576-02d5-5db6-8821-cda6cce13f9e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381871} {:answer/id #uuid "c0fa2f4a-92d9-5b7f-8a55-85dc61f1eab5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381872} {:answer/id #uuid "cad70498-9d45-50f1-ad3c-63de7250c7f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381873}] :answer-field/correct {:answer/id #uuid "a881413f-5700-555d-b08e-499cb6cfc5ed" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381869} :answer-field/id #uuid "c9135513-22a7-5dde-ba99-6e9ab8b4c2f6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381868}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "390e8909-b67e-5f3a-bb33-1726ba1d68d6" :question/math-academy-id "q-216530" :question/problem "$$\n∀{\\,y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}\\in Z,\\,y+{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}\\le {\\,z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\n$$\n\nWhich occurrences of the variables in the expression above are free?" :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $y$ is *bound* since it's placed right next to the quantifier $∀:$\n\n$$\n∀{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,y+x\\le z\n$$\n\n- Occurrence II of the variable $x$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $x.$\n\n- Occurrence III of the variable $z$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $z.$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n∀{y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in Z,\\,y+{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\\le {z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\n$$\n\nTherefore, the free occurrences are \"II and III only.\""}] [{:db/id 17592186381874 :knowledge-point/_questions [{:db/id 17592186152088 :knowledge-point/id #uuid "051e28ef-ac7f-5b29-bd93-c1e24a4bc699" :knowledge-point/title "Identifying Free and Bound Occurrences of Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7506ca50-23e1-57f0-a876-4875dbe4c164" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186381876} {:answer/id #uuid "a12ded00-5b05-5637-8936-e652dd104ca3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186381877} {:answer/id #uuid "e7b03b7a-7e7e-5209-aa94-bd4a7b035124" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186381878} {:answer/id #uuid "b377445f-810a-5a54-91f4-e5178f116361" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186381879} {:answer/id #uuid "d67c5c14-a6b9-5e32-b677-79fc9fc77806" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186381880}] :answer-field/correct {:answer/id #uuid "a12ded00-5b05-5637-8936-e652dd104ca3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186381877} :answer-field/id #uuid "62bd7925-5366-55b2-b078-6022475585e7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186381875}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0d9a12d6-16ca-57db-975d-02505a889530" :question/math-academy-id "q-216618" :question/problem "$$\n(\\,∀x\\in N,\\,x>{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{I}\\end{aligned}}+1\\,)⇒(\\,∃z\\in R,\\,{{z}^{3}}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{II}\\end{aligned}}-1={y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{III}\\end{aligned}}\\,)\n$$\n\nWhich occurrences of the variables in the expression above are free?" :question/worked-solution "Let's examine our expression and mark the occurrences of the variables as bound $(\\text{b})$ or free $(\\text{f}).$\n\n- Occurrence I of the variable $n$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $n.$\n\n- Occurrence II of the variable $z$ is *bound* since it lies within the scope of the quantifier $∃z$ that uses $z:$ \n\n$$\n(\\,∀x\\in N,\\,x>n+1\\,)⇒(\\,∃z\\in R,\\,\\overset{\\text{scope of }∃z}{\\overset{⏞}{{z}^{3}-1={y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}}}\\,)\n$$\n\n- Occurrence III of the variable $y$ is *free* since it isn't placed right next to a quantifier and it doesn't lie within the scope of a quantifier that uses $y.$\n\nThe occurrences of variables in the expression are as follows:\n\n$$\n(\\,∀{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in N,\\,{x}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}>{n}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}+1\\,)⇒(\\,∃{z}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}\\in R,\\,{{z}^{3}}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{b}\\end{aligned}}-1={y}_{\\begin{aligned} \\\\ ↑ \\\\ \\text{f}\\end{aligned}}\\,)\n$$\n\nTherefore, the free occurrence is \"I and III only.\""}] [{:db/id 17592186382235 :knowledge-point/_questions [{:db/id 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36eb381d-984c-5c7c-8695-13a228ebc66f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382237} {:answer/id #uuid "9cdf14fd-bd62-5b79-bb80-c6d71e222e01" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382238} {:answer/id #uuid "5107a618-1189-5062-bf19-d3bedfbafccd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382239} {:answer/id #uuid "cf0c9dae-9f5c-577b-bb7d-c1e0c1afe94b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382240} {:answer/id #uuid "7dfc5c71-215b-5076-a792-d29b149f8786" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382241}] :answer-field/correct {:answer/id #uuid "36eb381d-984c-5c7c-8695-13a228ebc66f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382237} :answer-field/id #uuid "0622cd69-4c51-5518-8cd5-e19cc8bb61df" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382236}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d63a269e-ef04-5d49-b4b0-245cf68e9dfb" :question/math-academy-id "q-72167" :question/problem "Which of the following equalities are true given that\n$D={(x,y)\\,:\\,-2\\le x\\le 2,\\,-1\\le y\\le 1}.$\n\n- ${∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A={\\int }_{-1}^{1}{\\int }_{-2}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}y\\,\\text{d}x$\n- ${∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A={\\int }_{-1}^{1}{\\int }_{-2}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}x\\,\\text{d}y$\n- ${∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A={\\int }_{-2}^{2}{\\int }_{-1}^{1}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that: \n\n- the limits for the variable $x$ are from $-2$ to $2$, and\n\n- the limits for the variable $y$ are from $-1$ to $-1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={\\int }_{-1}^{1}[{\\int }_{-2}^{2}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A={\\int }_{-2}^{2}[{\\int }_{-1}^{1}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"II and III only\"."}] [{:db/id 17592186382303 :knowledge-point/_questions [{:db/id 17592186152133 :knowledge-point/id #uuid "63a2b195-d0b3-580c-9230-58533d86afd5" :knowledge-point/title "Functions Whose Domain and Codomain Is the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e368e3d-df6c-5430-aa33-91580dba6ec1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382305} {:answer/id #uuid "883fed5f-ff20-51e9-ab98-60240ed2267f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382306} {:answer/id #uuid "2a3b137c-fb96-5d08-8dbb-f9a4381ec0dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186382307} {:answer/id #uuid "6a635631-9c5b-5b57-9aa4-2592f9bb8037" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382308} {:answer/id #uuid "5375dae2-9c0b-5296-924a-ff650bd5310d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382309}] :answer-field/correct {:answer/id #uuid "3e368e3d-df6c-5430-aa33-91580dba6ec1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382305} :answer-field/id #uuid "15d3aee5-3411-5e5b-a9b3-ddf811b3fb50" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382304}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8bf28a0-bd57-55ca-8858-3f8b81db61da" :question/math-academy-id "q-80019" :question/problem "Which of the following statements are true regarding the function $f:R\\to R$ which is given by $f(x)=(x-2)^{2}+1?$\n\n- The range of $f$ is $[1,\\infty )$\n- $∀\\,y\\in R,$ $∃\\,x\\in R$ such that $f(x)=y$\n- $f$ is **onto**" :question/worked-solution "First, we graph the function.\n\n![](images/be/bed7b280998fe987276ca5820b987f672404d52d00f532db819db1166118ed70.png)\n\nA function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$  in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. From the graph, the lowest $y$-value is $1,$ and it occurs at the point $(2,1).$ The graph will cover all $y$-values from $y=1$ and greater, including the number $1,$ so the range of the function is $[1,\\infty ).$\n\n- Statement II is false. Consider $y=0.$ As we can see from the range, there is no real number $x$ such that $f(x)=0.$ So, it's *not true* that for all $y$ contained within $R,$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement III is false. Since statement II is false, $f$ is not a surjection of $R$ onto $R.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186382310 :knowledge-point/_questions [{:db/id 17592186152132 :knowledge-point/id #uuid "2fe686b5-c7f0-58e6-9e46-e769a9193b21" :knowledge-point/title "Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166eb07b-f88c-5d59-ae72-f36b0baa8b38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382312} {:answer/id #uuid "442f9979-e484-54f4-a569-7e0028624299" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186382313} {:answer/id #uuid "9646f849-2792-5081-be14-553af89f5f76" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382314} {:answer/id #uuid "78e7d565-b10d-5226-9b01-b4f78b1a2c6f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382315} {:answer/id #uuid "9c615116-9aed-5788-86b8-1d002afd89e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382316}] :answer-field/correct {:answer/id #uuid "166eb07b-f88c-5d59-ae72-f36b0baa8b38" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382312} :answer-field/id #uuid "b110f087-c6fc-5580-8bbc-e59ddc7222c2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382311}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ab13059-2894-50dc-959d-d70d8ebc3fee" :question/math-academy-id "q-80202" :question/problem "![](images/6f/6f445040526c9b72e66dd29b15b32a89ec8b47a4cd2ae17bed009948dbce655d.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- There exists some $x$ contained within $X$ such that $f(x)=3$\n- $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$  in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. According to the diagram, we have $f(4)=3$ (we have an arrow from $4\\in X$ to $3\\in Y$). So, there exists some $x$ contained within $X$ such that $f(x)=3.$\n\n- Statement II is true. As we can see from the diagram, for all $y$ contained within $Y,$ there exists some $x$ contained within $X$ such that $f(x)=y.$\n\n- Statement III is true. Since statement II is true, $f$ is a surjection.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186382317 :knowledge-point/_questions [{:db/id 17592186152132 :knowledge-point/id #uuid "2fe686b5-c7f0-58e6-9e46-e769a9193b21" :knowledge-point/title "Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3d6af9b-8507-58b6-b14c-227bb46eaf70" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382319} {:answer/id #uuid "353701d4-4705-56e4-9d52-5ea9024e4442" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382320} {:answer/id #uuid "5ca80880-a64d-5e9e-8b1b-53d51bff9c13" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382321} {:answer/id #uuid "75a84d86-5ae5-5ed0-abbc-743b55d00536" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382322} {:answer/id #uuid "ea9a4f30-cc49-5b9e-b976-d707d1ce2441" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382323}] :answer-field/correct {:answer/id #uuid "353701d4-4705-56e4-9d52-5ea9024e4442" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382320} :answer-field/id #uuid "f7f5fb05-48bc-5d3e-9141-49818c7858bb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382318}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd4aa8c6-1cff-54d1-b1c7-27592615a44f" :question/math-academy-id "q-80224" :question/problem "![](images/86/86568c2024cfeb7f6605cd43a92f29492e24a1366216f51aa238c8c339bcff59.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\n- The range of $f$ is $[2,\\infty )$\n- $∀\\,y\\in R,$ $∃\\,x\\in R$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. From the graph, we see that the lowest $y$-value is $y=2,$ and it occurs at the point $(-2,2).$ The graph covers all $y$-values greater than $y=2,$ including $2$ itself.  So, the range of the function is $[2,\\infty ).$\n\n- Statement II is false. Consider $y=0.$ As we can see from the range, there is no real number $x$ such that $f(x)=0.$ So, it's *not true* that for all $y$ contained within $R,$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement III is false. Since statement II is false, $f$ is not a surjection of $R$ onto $R.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186382331 :knowledge-point/_questions [{:db/id 17592186152133 :knowledge-point/id #uuid "63a2b195-d0b3-580c-9230-58533d86afd5" :knowledge-point/title "Functions Whose Domain and Codomain Is the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17ccf8d9-fa3d-5291-99c0-353972861ae9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382333} {:answer/id #uuid "8ee64cb1-d44c-5a25-857d-97b23049c3b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186382334} {:answer/id #uuid "57c4a41d-8def-5fce-87a7-f367c23bd6ff" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382335} {:answer/id #uuid "f6b0ff84-6549-5995-a24b-b4987dca7e40" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382336} {:answer/id #uuid "e83483f3-fc68-5407-8523-a6a3e7c707c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382337}] :answer-field/correct {:answer/id #uuid "17ccf8d9-fa3d-5291-99c0-353972861ae9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382333} :answer-field/id #uuid "dd4c1518-895f-5a29-ba68-d4b7348641e8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382332}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12ed8ad0-48d9-538c-959c-ba969b6bfa2c" :question/math-academy-id "q-80262" :question/problem "![](images/e4/e4dd0466c7c98d5cb6dfd0f73cd107636a2df258149778af444f58f36306b326.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R$ whose graph is shown above?\n\n- The range of $f$ is $(-\\infty ,1]$\n- $∀\\,y\\in R,$ $∃\\,x\\in R$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. In fact, as the arrows indicate, the graph covers all $y$-values, so the range of the function is $(-\\infty ,\\infty ).$\n\n- Statement II is true. Since the range of the function is $(-\\infty ,\\infty )$, then for all $y$ contained within $R,$ there exists some $x$ contained within $R$ such that $f(x)=y.$\n\n- Statement III is true. Since statement II is true, $f$ is a surjection of $R$ onto $R.$\n\nTherefore, the correct answer is \" II and III only.\""}] [{:db/id 17592186382344 :knowledge-point/_questions [{:db/id 17592186152134 :knowledge-point/id #uuid "1324fd0b-5388-5133-ad6a-72d658e3c903" :knowledge-point/title "Functions Whose Codomain Is a Real Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "beed1dde-64a9-5a2f-85c7-a4aa0a67c371" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186382346} {:answer/id #uuid "f685a086-fb56-54be-97b6-f97431d956fa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382347} {:answer/id #uuid "de31e724-cf27-5b01-b706-dc5338e8267b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382348} {:answer/id #uuid "7e8ff76c-b7f5-5cfb-b433-00e86f59b9ab" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382349} {:answer/id #uuid "295605fc-2c98-5de1-86a7-95744cbf3452" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382350}] :answer-field/correct {:answer/id #uuid "295605fc-2c98-5de1-86a7-95744cbf3452" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382350} :answer-field/id #uuid "7ab73909-29d3-5746-8a6f-11534ef95f8f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382345}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d072f9fe-6a97-527b-a8fc-6dbaa90f64fa" :question/math-academy-id "q-80296" :question/problem "![](images/a4/a4ae29c6d6a446a302f4104e339a067a5e43fd82088e773fac7e8e9b70b342f3.png)\n\nWhich of the following statements are true regarding the function $f:[-1,4]\\to [0,5]$ whose graph is shown above?\n\n- The range of $f$ is $[0,5]$\n- $∀\\,y\\in [0,4],$ $∃\\,x\\in [-1,4]$ such that $f(x)=y$\n- $f$ is a surjection" :question/worked-solution "A function $f:X\\to Y$ is a surjection (also known as *onto*) if, for *every* element $y$ in $Y,$ there is *at least one* element in $X$ that maps to $y:$ \n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. From the graph, the highest $y$-value is $4$ and the lowest $y$-value is $0.$ The graph covers all $y$-values between $0$ and $4$, including these numbers, so the range of the function is $[0,4].$\n\n- Statement II is true. Since the range of the function is $[0,4]$, it follows that for all $y$ contained within $[0,4],$ there exists some $x$ contained within $[-1,4]$ such that $f(x)=y.$\n\n- Statement III is false. Since the range of $f$ is not $[0,5],$ then it's *not true*  that for all $y$ contained within $[0,5],$ there exists some $x$ contained within $[-1,4]$ such that $f(x)=y.$ In conclusion, $f$ is not a surjection of $[-1,4]$ onto $[0,5].$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186382497 :knowledge-point/_questions [{:db/id 17592186157231 :knowledge-point/id #uuid "bc5b8688-3838-5e9e-9304-9a4c787034ee" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b830baf1-32ee-5e03-b7b6-706c4dc3258d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382499} {:answer/id #uuid "c922ec38-0229-5bc6-b63e-22d65beca225" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382500} {:answer/id #uuid "ddcea21c-6e8e-5cea-bc99-c9ba77039500" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186382501} {:answer/id #uuid "36253859-32bd-5be9-b223-a9690bba087e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382502} {:answer/id #uuid "ab23d36c-9139-5b37-ad6e-c1feb89304d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186382503}] :answer-field/correct {:answer/id #uuid "36253859-32bd-5be9-b223-a9690bba087e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382502} :answer-field/id #uuid "97d451a1-7d4e-59f6-acf7-433de45eca5d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382498}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1094e86-e368-5edf-a0b9-d55c19636e6a" :question/math-academy-id "q-81485" :question/problem "Which of the following statements are logically equivalent?\n\n- $¬(¬A∨¬B)$\n- $A∧B$\n- $A∨B$" :question/worked-solution "Two statements are logically equivalent if they have the same truth table. So, we construct a truth table for the three given statements:\n\n| $\\,A\\,$ | $\\,B\\,$ | $\\,¬(¬A∨¬B)\\,$ | $\\,A∧B\\,$ | $\\,A∨B\\,$ |\n| --- | --- | --- | --- | --- |\n| $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ | $\\text{T}$ |\n| $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{T}$ | $\\text{F}$ | $\\text{F}$ | $\\text{T}$ |\n| $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ | $\\text{F}$ |\n\nWe see that only the statements $¬(¬A∨¬B)$ and $A∧B$ have the same truth table, so they are logically equivalent.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186382587 :knowledge-point/_questions [{:db/id 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5f4672d-609d-59d3-a71d-75dd91adda6a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382589} {:answer/id #uuid "25073dcd-b946-53a0-911a-0a173ac1ec1d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186382590} {:answer/id #uuid "5da805df-01ed-5ef1-b851-b8f81e65b003" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382591} {:answer/id #uuid "4d1af657-2cb6-5b0b-9c3a-3ab790f5e641" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382592} {:answer/id #uuid "5cbb53f5-8c26-510c-9179-16628ebd61e5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382593}] :answer-field/correct {:answer/id #uuid "5cbb53f5-8c26-510c-9179-16628ebd61e5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382593} :answer-field/id #uuid "ef6621e0-c427-56b2-83eb-63369faf21de" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382588}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4956b231-c3b6-599c-b16a-8affdf879701" :question/math-academy-id "q-88690" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-5}^{5}2{x}^{4}\\,\\text{d}x$\n- ${\\int }_{-4}^{4}\\operatorname{sin}⁡(6x)\\,\\text{d}x$\n- ${\\int }_{-1}^{1}3{e}^{-x}\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=2{x}^{4}$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & =2(-x)^{4} \\\\  & =2{x}^{4} \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)=\\operatorname{sin}⁡(6x)$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =\\operatorname{sin}⁡(6(-x)) \\\\  & =\\operatorname{sin}⁡(-6x) \\\\  & =-\\operatorname{sin}⁡(6x) \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nHence, by symmetry, we can conclude that\n\n$$\n{\\int }_{-4}^{4}\\operatorname{sin}⁡(6x)\\,\\text{d}x=0.\n$$\n\n- The function $f(x)=3{e}^{-x}$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & =3{e}^{-(-x)} \\\\  & =3{e}^{x} \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\nHence, the correct answer is \"II only.\""}] [{:db/id 17592186382668 :knowledge-point/_questions [{:db/id 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bac9a951-8302-5f23-bf49-b9764766cca8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186382670} {:answer/id #uuid "af1e9bff-bbd1-5662-a55b-5ccf7c4dcbed" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382671} {:answer/id #uuid "cfcfe8ec-3136-58ee-a80c-916985be79f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382672} {:answer/id #uuid "d3a893cb-f579-5b0b-8d95-f25911567f1f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382673} {:answer/id #uuid "5613f9d0-354c-51f9-aab8-a02350ed2b3a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382674}] :answer-field/correct {:answer/id #uuid "cfcfe8ec-3136-58ee-a80c-916985be79f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382672} :answer-field/id #uuid "7ae35f27-629d-5486-b089-c32b9e81f7a5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382669}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d0457d3f-7a7d-578e-b127-39bac9e28900" :question/math-academy-id "q-99863" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)=\\operatorname{cos}⁡(2t),\\,{f}_{3}(t)=\\operatorname{sin}⁡t\n$$\n\nGiven that the inner product in the vector space $C[-\\pi /2,\\pi /2]$ of continuous functions over $[-\\pi /2,\\pi /2]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-\\pi /2}^{\\pi /2}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\nI. ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product\n\nII. ${f}_{1}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩=⟨t,\\operatorname{cos}⁡(2t)⟩={\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{cos}⁡(2t)\\,\\text{d}t.\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{cos}⁡(2t) & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{cos}⁡(2t)\\,\\text{d}t=\\frac{\\operatorname{sin}⁡(2t)}{2}.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{cos}⁡(2t)\\,\\text{d}t & =uv{|}_{-\\pi /2}^{\\pi /2}-{\\int }_{-\\pi /2}^{\\pi /2}{u}^{′}v\\,\\text{d}t \\\\  & =(t\\frac{\\operatorname{sin}⁡(2t)}{2}){|}_{-\\pi /2}^{\\pi /2}-\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =(\\frac{\\pi }{2}\\cdot \\frac{\\operatorname{sin}⁡(\\pi )}{2}-(-\\frac{\\pi }{2})\\cdot \\frac{\\operatorname{sin}⁡(-\\pi )}{2})+\\frac{\\operatorname{cos}⁡(2t)}{4}{|}_{-\\pi /2}^{\\pi /2} \\\\  & =0+(\\frac{\\operatorname{cos}⁡(\\pi )}{4}-\\frac{\\operatorname{cos}⁡(-\\pi )}{4}) \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{3}(t)⟩=⟨t,\\operatorname{sin}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{sin}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=t & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{sin}⁡t & ⟹ & v=\\int {v}^{′}\\,\\text{d}t=\\int \\operatorname{sin}⁡t\\,\\text{d}t=-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nNow, applying the integration by parts formula, we obtain \n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}t\\operatorname{sin}⁡t\\,\\text{d}t & =uv{|}_{-\\pi /2}^{\\pi /2}-{\\int }_{-\\pi /2}^{\\pi /2}{u}^{′}v\\,\\text{d}t \\\\  & =(-t\\operatorname{cos}⁡t){|}_{-\\pi /2}^{\\pi /2}+{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =(-\\frac{\\pi }{2}\\cdot \\operatorname{cos}⁡(\\frac{\\pi }{2})-(-(-\\frac{\\pi }{2})\\cdot \\operatorname{cos}⁡(-\\frac{\\pi }{2})))+\\operatorname{sin}⁡t{|}_{-\\pi /2}^{\\pi /2} \\\\  & =0+(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =1-(-1) \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Since ${f}_{1}(t)⊥̸{f}_{3}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186382675 :knowledge-point/_questions [{:db/id 17592186133872 :knowledge-point/id #uuid "382a6db7-2708-5711-885e-6f3f3037e8df" :knowledge-point/title "Determining Whether a Set of Functions is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5928cb0-0804-50b0-bb37-632e6f6c8aa0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186382677} {:answer/id #uuid "87255850-4e57-5447-9045-42b3b82466cf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382678} {:answer/id #uuid "e66a627d-2264-5cb0-93c7-5b9a95b90304" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382679} {:answer/id #uuid "d38e1c98-51fa-526d-ac95-3ac384b35aae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382680} {:answer/id #uuid "a608a51c-4b0b-57ca-b343-e5cbd12db3b1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382681}] :answer-field/correct {:answer/id #uuid "a608a51c-4b0b-57ca-b343-e5cbd12db3b1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382681} :answer-field/id #uuid "e026abb8-5084-50ac-8a69-bf6908267de3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382676}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "866dfd7d-0156-5915-b7a2-48bb304694df" :question/math-academy-id "q-99949" :question/problem "Consider the following set of functions:\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡(2t),\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,{f}_{3}(t)=\\operatorname{cos}⁡t\n$$\n\nGiven that the inner product in the vector space $C[-\\pi /2,\\pi /2]$ of continuous functions over $[-\\pi /2,\\pi /2]$ is defined as \n\n$$\n⟨f(t),g(t)⟩={\\int }_{-\\pi /2}^{\\pi /2}f(t)g(t)\\,\\text{d}t,\n$$\n\nwhich of the following statements are true?\n\n- ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the given inner product\n- ${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product\n- $S={{f}_{1}(t),{f}_{2}(t),{f}_{3}(t)}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is called orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. We have\n\n$$\n\\begin{aligned}⟨{f}_{1}(t),{f}_{2}(t)⟩=⟨\\operatorname{sin}⁡(2t),\\operatorname{sin}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡(2t)\\operatorname{sin}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the identity $\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\operatorname{sin}⁡t\\,\\text{d}t & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡(2t-t)-\\operatorname{cos}⁡(2t+t))\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{cos}⁡t+\\operatorname{cos}⁡(3t))\\,\\text{d}t \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡t+\\frac{1}{3}\\operatorname{sin}⁡(3t)){|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{1}{3}\\operatorname{sin}⁡(\\frac{\\pi }{2}))-\\frac{1}{2}(\\operatorname{sin}⁡(-\\frac{\\pi }{2})+\\frac{1}{3}\\operatorname{sin}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{1}{2}\\cdot \\frac{4}{3}-\\frac{1}{2}\\cdot (-\\frac{4}{3}) \\\\  & =\\frac{4}{3}\\ne 0.\\end{aligned}\n$$\n\nThis means that ${f}_{1}(t)⊥̸{f}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is true. We have\n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{3}(t)⟩=⟨\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩={\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can evaluate this integral using the substitution $u=\\operatorname{sin}⁡t,$ differentiating we have $\\text{d}u=\\operatorname{cos}⁡t.$ Hence:\n\n$$\n\\begin{aligned}{\\int }_{-\\pi /2}^{\\pi /2}\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t\\,\\text{d}t & =\\frac{1}{2}{sin}^{2}⁡t{|}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{1}{2}({sin}^{2}⁡(\\frac{\\pi }{2})-{sin}^{2}⁡(-\\frac{\\pi }{2})) \\\\  & =\\frac{1}{2}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nThis means that ${f}_{2}(t)⊥{f}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Since ${f}_{1}(t)⊥̸{f}_{2}(t),$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186382743 :knowledge-point/_questions [{:db/id 17592186152197 :knowledge-point/id #uuid "99c2db8c-670b-521b-8942-3b89f1e95d3f" :knowledge-point/title "Identifying Injections For Functions Whose Domain or Codomain Are Real Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09dad471-78e7-5303-8d3e-b5c62d916c04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382745} {:answer/id #uuid "9c75d22f-d1b1-5db9-aeed-b7802a638031" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382746} {:answer/id #uuid "6a8cc643-c863-598b-8fa8-ce8b23a5f1cf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382747} {:answer/id #uuid "71b249a3-168a-5eca-a175-17c1926fd240" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382748} {:answer/id #uuid "f967f749-85d7-5bba-a212-c924055105f0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382749}] :answer-field/correct {:answer/id #uuid "09dad471-78e7-5303-8d3e-b5c62d916c04" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382745} :answer-field/id #uuid "fd0e1627-92aa-512c-8a2a-28ce80390700" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382744}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "212414c0-44d6-50de-aa8e-6b4bd0efa627" :question/math-academy-id "q-105202" :question/problem "![](images/8f/8f4d72bd431d4f06daa3ea2be20d0ebb21fd736b944be77331c72c2e47e3144f.png)\n\nWhich of the following statements are true regarding the function $f:[0,\\infty ]\\to (-\\infty ,5]$ whose graph is shown above?\n\n- $f(0)=f(2)$\n- $∀\\,{x}_{1},{x}_{2}\\in [0,\\infty ),$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is **one-to-one**" :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. According to the graph, we have $f(0)=5$ and $f(2)<5.$\n\n- Statement II is true. As we can see from the graph, it passes the horizontal line test, meaning that there are no two distinct elements within $[0,\\infty )$ that map to the same element in $(-\\infty ,5].$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $[0,\\infty ),$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is true, $f$ is an injection (also known as *one-to-one*).\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186382750 :knowledge-point/_questions [{:db/id 17592186152197 :knowledge-point/id #uuid "99c2db8c-670b-521b-8942-3b89f1e95d3f" :knowledge-point/title "Identifying Injections For Functions Whose Domain or Codomain Are Real Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "503ddc68-3af5-5213-9fd8-6a2cb4ba32d0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186382752} {:answer/id #uuid "76db3fd3-a4bd-553b-b654-f4a62a908a7b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382753} {:answer/id #uuid "27d3053a-df29-513e-adea-1bd148282afd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382754} {:answer/id #uuid "30c9ef19-213c-51a2-8c69-ae396f12ec41" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382755} {:answer/id #uuid "ef2ae372-8142-5317-9926-83c4534bf4ee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382756}] :answer-field/correct {:answer/id #uuid "27d3053a-df29-513e-adea-1bd148282afd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382754} :answer-field/id #uuid "d3d15300-9f8b-5320-b4ce-46211fcaabfc" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382751}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41a4e16b-532b-5af9-a855-bdbc2ac881f2" :question/math-academy-id "q-105203" :question/problem "![](images/64/64b81ef8b99a70ae69b607b9c9440e9588576f8ea2243a8aa82f52d92bde8630.png)\n\nWhich of the following statements are true regarding the function $f:[-2,2]\\to [-1,5]$ whose graph is shown above?\n\n- $f(-2)\\ne f(2)$\n- $∀\\,{x}_{1},{x}_{2}\\in [-2,2],$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is not an injection" :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is false. According to the graph, we have $f(-2)=f(2)=5.$\n\n- Statement II is false. Again, we have $f(-2)=f(2)$ but $-2\\ne 2.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $[-2,2],$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is false, $f$ is not an injection.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186382764 :knowledge-point/_questions [{:db/id 17592186152195 :knowledge-point/id #uuid "f45ad8ed-5b6d-5e46-b337-02ab271013b3" :knowledge-point/title "Identifying Injections From Functions Given Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33fd11e0-02ac-54f2-bf8e-fd86f65bf26f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382766} {:answer/id #uuid "907807b7-8592-5a51-8f87-cdfaf42f9303" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382767} {:answer/id #uuid "522f005e-6b19-51a7-aabc-8a2ad6b8f2e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382768} {:answer/id #uuid "ef273738-5da3-5881-882b-995b8bbb892e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382769} {:answer/id #uuid "9cf75fd8-5e38-5898-8705-e42afabf9d42" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382770}] :answer-field/correct {:answer/id #uuid "ef273738-5da3-5881-882b-995b8bbb892e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382769} :answer-field/id #uuid "8b429c17-5b26-5fdc-a4e7-7825832bf15f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382765}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a4c4299-1d16-58a6-b63b-ffcefd188616" :question/math-academy-id "q-105218" :question/problem "Which of the following functions are injections?\n\n- $f:R\\to R$ defined by $f(x)={2}^{x}$\n- $g:(0,\\infty )\\to R$ defined by $g(x)=\\operatorname{ln}⁡x$\n- $h:R\\to R$ defined by $h(x)=(x+1)^{2}$" :question/worked-solution "A function $f:X\\to Y$ is a **injection** (also known as **one-to-one**) if *every* element in $x$ in $X$ is mapped to a *distinct* element in $Y.$\n\nSymbolically, we can write:\n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\n- I is an injection: \n\n$$\n\\begin{aligned}f({x}_{1}) & =f({x}_{2}) \\\\ {2}^{{x}_{1}} & ={2}^{{x}_{2}} \\\\ {log}_{2}⁡{2}^{{x}_{1}} & ={log}_{2}⁡{2}^{{x}_{2}} \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\n- II is an injection: \n\n$$\n\\begin{aligned}g({x}_{1}) & =g({x}_{2}) \\\\ \\operatorname{ln}⁡{x}_{1} & =\\operatorname{ln}⁡{x}_{2} \\\\ {e}^{\\operatorname{ln}⁡{x}_{1}} & ={e}^{\\operatorname{ln}⁡{x}_{2}} \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\n- III is *not* an injection. For example, $h(0)=1=h(-2),$ but $0\\ne -2.$\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186382771 :knowledge-point/_questions [{:db/id 17592186152262 :knowledge-point/id #uuid "22bcdfb2-485a-5242-a5b5-dd9ef8cee027" :knowledge-point/title "Identifying Bijections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b70deaa-282c-5afd-adea-810a6ceee3dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186382773} {:answer/id #uuid "59aaabbf-93df-5fad-99ef-390a87fba93e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382774} {:answer/id #uuid "466efc04-68cc-5cb3-bcc9-8c69d6dd4f2d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382775} {:answer/id #uuid "c81e5b67-70e8-598c-8964-0be344c1631b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382776} {:answer/id #uuid "413ae4ae-71d1-51be-beb0-c902620af91e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382777}] :answer-field/correct {:answer/id #uuid "59aaabbf-93df-5fad-99ef-390a87fba93e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382774} :answer-field/id #uuid "24cac576-6eca-541f-90a0-57b5aa4e3431" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382772}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db660bb9-e18a-5aa6-8b12-2d9637cff073" :question/math-academy-id "q-105224" :question/problem "![](images/32/32957c5f0b4eeb76253f9fe812e2025b93a2cd5c65870f5a0b3608ce545dd4c5.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- $f$ is a surjection\n- $f$ is an injection\n- $f$ is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a bijection if it is both a surjection and an injection.\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. Indeed, according to the diagram, for every element $y\\in Y,$ we have an arrow from some element $x\\in X$ to it, which means that $f(x)=y.$ So, $f$ is a surjection.\n\n- Statement II is true. As we can see from the diagram, there are no two distinct elements within $X$ that map to the same element in $Y.$ So, for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$ As a result, $f$ is an injection.\n\n- Statement III is true. Indeed, since both statements I and II are true, $f$ is a bijection.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186382778 :knowledge-point/_questions [{:db/id 17592186152265 :knowledge-point/id #uuid "f237343d-2f8a-5a9f-9e5f-c9f22784547a" :knowledge-point/title "Identifying Bijections For Functions Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021ac9fc-3901-5013-8701-fe49611b7fa3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382780} {:answer/id #uuid "8271a9d3-f266-583e-8853-e4d0dc353b0f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382781} {:answer/id #uuid "e9fce4bf-99ed-59ab-ba33-e5c29728e2ce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382782} {:answer/id #uuid "fac141e5-d22c-55b7-843a-1f7302aabb0a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382783} {:answer/id #uuid "9b4a05fe-1a06-5574-8f6f-9f770858b85c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382784}] :answer-field/correct {:answer/id #uuid "9b4a05fe-1a06-5574-8f6f-9f770858b85c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382784} :answer-field/id #uuid "10c83d8c-4b2f-54f0-82e6-8967db18f9e1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382779}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aad509f8-bb58-5f68-8c6d-48ccc6e72f00" :question/math-academy-id "q-105283" :question/problem "Which of the following functions are bijections?\n\n- $f:{R}^{+}\\to R$ defined by $f(x)=\\frac{1}{x}$\n- $g:R\\to R$ defined by $g(x)={x}^{3}$\n- $h:Q\\to Q$ defined by $h(x)=|x|$" :question/worked-solution "Recall that a function $f:X\\to Y$ is a bijection if it is both a surjection and an injection.\n\n- I is *not* a bijection because it is not surjective. Remember that the range of $f(x)=\\frac{1}{x}$ is $f(x)\\in (0,\\infty )$ for $x\\in {R}^{+}.$ So, for example, there is no value $x\\in R$ such that $f(x)=-1.$\n\n- II is a bijection. First of all, it is a surjection because $∀\\,y\\in R,$ we can choose an $x\\in R$ such that $g(x)=y:$\n\n$$\n\\begin{aligned}g(x) & =y \\\\ {x}^{3} & =y \\\\ x & =\\sqrt[3]{y}\\in R\\end{aligned}\n$$\n\nWe verify that\n\n$$\ng(x)=g(\\sqrt[3]{y})={(\\sqrt[3]{y})}^{3}=y.\n$$\n\nSecond, it is an injection:\n\n$$\n\\begin{aligned}g({x}_{1}) & =g({x}_{2}) \\\\ {x}_{1}^{3} & ={x}_{2}^{3} \\\\ {x}_{1} & ={x}_{2}\\end{aligned}\n$$\n\nBecause $g$ is both surjective and injective, $g$ is bijective.\n\n- III is *not* a bijection because it is not injective. Notice that $h(-1)=1=h(1),$ while $-1\\ne 1.$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id 17592186382785 :knowledge-point/_questions [{:db/id 17592186152264 :knowledge-point/id #uuid "f12e21e5-0a96-5f87-9642-d63d23e0038a" :knowledge-point/title "Identifying Bijections For Functions Whose Domains or Codomains Are Real Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3db9d440-3565-5c8d-ad16-7c1e2b109165" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382787} {:answer/id #uuid "31890df1-4e05-5dc3-908e-486377d453fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382788} {:answer/id #uuid "a6f83a73-6962-582a-b5da-8c4939fcd5d1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382789} {:answer/id #uuid "51817279-25c9-50e6-9b73-a36fc89f71f2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382790} {:answer/id #uuid "72369168-1464-5f45-b3ec-e8f99c72efd9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382791}] :answer-field/correct {:answer/id #uuid "31890df1-4e05-5dc3-908e-486377d453fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382788} :answer-field/id #uuid "9b3d72a7-ee2a-5698-b2af-ab3c218c5f7d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382786}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab6d4262-72da-5293-84a5-c795900dbdb0" :question/math-academy-id "q-105302" :question/problem "![](images/70/707aad3ee7b52647cdc565aee76a4276aee01c8369236f24908f1c89d234e588.png)\n\nFor the function $f:R∖{-1}\\to R$ defined by $f(x)=1-\\frac{1}{x+1}$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/86/8605d88b3187d6e8444e5cb7a8c591ab4e67b781cfba79c119fa11e5696c13a1.png)\n\n- Statement II is false. There is no value $x$ for which $f(x)=1.$\n\n- Statement III is false because the function is not a surjection.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186382792 :knowledge-point/_questions [{:db/id 17592186152264 :knowledge-point/id #uuid "f12e21e5-0a96-5f87-9642-d63d23e0038a" :knowledge-point/title "Identifying Bijections For Functions Whose Domains or Codomains Are Real Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52d9827e-263d-559d-94fe-73a0931817b5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382794} {:answer/id #uuid "9621d6fc-6311-543e-8011-f78eea1fb384" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186382795} {:answer/id #uuid "57e34dcc-b643-5442-817b-816294e1c4a3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382796} {:answer/id #uuid "115215fc-8bb8-5205-8e7d-dcd4d92ed45a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382797} {:answer/id #uuid "3d94bdc3-4061-58cf-a1e3-62ac018705e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382798}] :answer-field/correct {:answer/id #uuid "3d94bdc3-4061-58cf-a1e3-62ac018705e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382798} :answer-field/id #uuid "7629f1d9-75bf-5445-a19f-785a6320ce22" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382793}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8df77440-bcac-5064-a5e6-fdeeaf2cd8d0" :question/math-academy-id "q-105305" :question/problem "![](images/5f/5f7c319a0648cdefc0c6a7ba40e6df62a88df92c8bc87fdaadf2afdca46ae0d6.png)\n\nWhich of the following statements are true regarding the function $f:R\\to R,$ whose graph is shown above?\n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is false. There are horizontal lines (like the one depicted below) that cross the graph of $f(x)$ more than once. So, $∃\\,{x}_{1},{x}_{2}\\in R$ such that ${x}_{1}\\ne {x}_{2}$ but $f({x}_{1})=f({x}_{2}).$\n\n![](images/bd/bdd421bdd147eb8d0dc9fc593a1205b9a4665bc6d3a3cb76ec7f2e3bf518ecb6.png)\n\n \n\n- Statement II is true. According to the graph, the range of $f(x)$ will cover the entire interval $(-\\infty ,\\infty ).$\n\n- Statement III is false. Indeed, since statement I is false, $f$ is not a bijection.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186382799 :knowledge-point/_questions [{:db/id 17592186152264 :knowledge-point/id #uuid "f12e21e5-0a96-5f87-9642-d63d23e0038a" :knowledge-point/title "Identifying Bijections For Functions Whose Domains or Codomains Are Real Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c85bb50-bdaf-5091-9733-78b8d0cc3c00" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382801} {:answer/id #uuid "58014a96-aca5-507b-8dca-b86791e36d6e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382802} {:answer/id #uuid "88a22b18-81e0-5a22-985b-b39eef084cfc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382803} {:answer/id #uuid "a41945a0-c813-579c-9ae8-05d09c7bf1b8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382804} {:answer/id #uuid "dab94050-b829-52d4-b669-d11c62f03d11" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382805}] :answer-field/correct {:answer/id #uuid "58014a96-aca5-507b-8dca-b86791e36d6e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382802} :answer-field/id #uuid "85ca730f-a4db-5204-9c0d-18a3b8f1f749" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382800}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09bf6284-af1f-5fbe-9b83-9ea47f00c38a" :question/math-academy-id "q-105307" :question/problem "![](images/84/84755249e491fd44868098e8edccfd32cffda23a5859f0a9df293b57b4353040.png)\n\nFor the function $f:R\\to [0,\\infty )$ defined by $f(x)={2}^{-x}$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/01/016b83dcbb2f2008d428fb52ba26336b35fa0af0d67e435d06122845f3492b2e.png)\n\n- Statement II is false. Indeed, ${2}^{-x}>0$ for all $x\\in R.$ So, there is no value $x$ such that $f(x)=0\\in [0,\\infty ).$\n\n- Statement III is false because the function is not a surjection.\n\n Therefore, the correct answer is \"I only.\""}] [{:db/id 17592186382806 :knowledge-point/_questions [{:db/id 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1d2e9e6-0f95-5e2b-a7f9-be8e24c3a2e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382808} {:answer/id #uuid "efbcc7a3-9a2a-5cba-8bb6-e2e4b70655c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382809} {:answer/id #uuid "c9086cb3-e2d1-5812-907b-7b68891d69e1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382810} {:answer/id #uuid "673c43ce-6e5c-5026-9960-a2ba6d69b9df" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382811} {:answer/id #uuid "16d79a23-b8a4-5066-8adc-8969c5a8a7c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382812}] :answer-field/correct {:answer/id #uuid "d1d2e9e6-0f95-5e2b-a7f9-be8e24c3a2e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186382808} :answer-field/id #uuid "46c89f5e-ad50-5a3b-a251-010507ab6160" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382807}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09033cd1-e3bd-58ad-8df5-2396d7439d27" :question/math-academy-id "q-105329" :question/problem "![](images/5c/5c50beff59a4bc2ae8cf3da8c9fed849c73cbf828ad0f875675520fc33589365.png)\n\nFor the function $f:R\\to R$ defined by $f(x)=\\sqrt[3]{x-1}$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/66/66d558a2118721b2793311fb0f4687d91aefa125e74a73379c793a9fdbedf46d.png)\n\n        \n\n- Statement II is true. According to the graph, the range of $f(x)$ will cover the entire interval $(-\\infty ,\\infty ).$\n\n- Statement III is true because the function is both surjective and injective.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186382813 :knowledge-point/_questions [{:db/id 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cba537ec-0d5d-53e5-a6b5-02728ec7e4d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186382815} {:answer/id #uuid "ca197b2e-1379-509a-96c3-6a080d6a8691" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382816} {:answer/id #uuid "829a1b33-8158-51f7-aa91-1c51e45755ab" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382817} {:answer/id #uuid "d05b1f1b-8649-5856-a137-98ef845d0498" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382818} {:answer/id #uuid "525ec2ce-0e65-5d67-9e29-e22a23e4c318" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382819}] :answer-field/correct {:answer/id #uuid "cba537ec-0d5d-53e5-a6b5-02728ec7e4d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186382815} :answer-field/id #uuid "4815cad2-b21f-5e02-9137-7fdb006f12b2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382814}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea34001e-7666-5760-9335-3a797f196771" :question/math-academy-id "q-105330" :question/problem "![](images/88/8845d8cc2664c92637e06961f1d5c17b98afcb72470d1463fbd58aaf5691ca4c.png)\n\nFor the function $f:R\\to R$ defined by $f(x)=(x+1)^{2}-2$, which of the following statements are true?  \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection" :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is false. There are horizontal lines (such as the one depicted below) that cross the graph of $f(x)$ more than once.\n\n![](images/d6/d6b2a99811341aa07bc3e91df973504fad57ac4a71a38406707b5d311247d61d.png)\n\n        \n\n- Statement II is false. For example, there is not $x\\in R$ such that $f(x)=-4.$ So, $f$ is not a surjection.\n\n- Statement III is false, because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id 17592186382964 :knowledge-point/_questions [{:db/id 17592186172016 :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac24f167-d1fb-51c2-96be-55a963094a93" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186382966} {:answer/id #uuid "08cf8bff-ee6f-5715-a45b-2446718dbdaa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382967} {:answer/id #uuid "77277b4f-7027-5398-8d12-8736d64d3c08" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382968} {:answer/id #uuid "ccb41ef7-716d-51f0-81ad-dec9659c5758" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186382969} {:answer/id #uuid "04d833a6-156b-56c6-94c6-0f83ed3952ea" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382970}] :answer-field/correct {:answer/id #uuid "08cf8bff-ee6f-5715-a45b-2446718dbdaa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382967} :answer-field/id #uuid "ee0b4682-4ffa-5c47-85d5-66823d3a6bff" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382965}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9198e7bb-f6e2-569d-9a58-c321fc238e98" :question/math-academy-id "q-120290" :question/problem "![](images/32/32fefe70890d179803a847fc597349948703176d1561a8c840e845fa7a06a872.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=\\frac{y+2}{x-1}$\n- ${y}^{′}=(x-1)(y-2)$\n- ${y}^{′}=\\frac{y-2}{x}$" :question/worked-solution "![](images/a1/a18f69bf5b2cb6b2984722f851e1eda017e48863517da7ee65597d7c25c46379.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- For $x\\ne 1,$ the slopes of the slope field become horizontal at $y=-2.$\n\n- For $y\\ne -2,$ the slopes of the slope field become vertical as $x\\to 1.$\n\nWith that in mind, let's consider each equation.\n\n- Equation I gives the required behavior. For $x\\ne 1,$ the right-hand side of ${y}^{′}=\\frac{y+2}{x-1}$ evaluates to zero on $y=-2,$ and for $y\\ne -2,$\n\n$$\n|{y}^{′}|=|\\frac{y+2}{x-1}|\\to \\infty \\,\\text{as}\\,x\\to 1.\n$$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=(x-1)(y-2)$ does not evaluate to zero on $y=-2$ (the value depends on $x$).\n\n- Equation III does *not* give the required behavior. The right-hand side of ${y}^{′}=\\frac{y-2}{x}$ evaluates to zero on $y=-2,$ but \n\n$$\n|{y}^{′}|=|\\frac{y-2}{x}|\\to |y-2|\\,\\text{as}\\,x\\to 1.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186383328 :knowledge-point/_questions [{:db/id 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c3cfb23c-9212-59cc-8e3c-e44c7fa768a0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186383330} {:answer/id #uuid "921e654f-a2ad-5c4e-8d2d-d706eaebfbc5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383331} {:answer/id #uuid "2d6ce4d8-ae9b-5b7f-938a-824e4882d4b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383332} {:answer/id #uuid "a5f3ef44-dcec-5ac6-ab67-8eda65c5ade0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383333} {:answer/id #uuid "03ba78c0-18e4-5410-826a-3123a938453d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186383334}] :answer-field/correct {:answer/id #uuid "921e654f-a2ad-5c4e-8d2d-d706eaebfbc5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383331} :answer-field/id #uuid "442f3539-b6f6-5fe8-8fd0-179a10ee248c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383329}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "017164c5-337a-58b5-8e66-674d944a6841" :question/math-academy-id "q-133262" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)=6{x}^{2}+3{y}^{2}$ and ${f}_{y}(x,y)=6xy$\n- ${f}_{x}(x,y)=15{x}^{2}-y$ and ${f}_{y}(x,y)=8y+x$\n- ${f}_{x}(x,y)=\\operatorname{ln}⁡x+1$ and ${f}_{y}(x,y)=-3{y}^{2}$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(6{x}^{2}+3{y}^{2})=6y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(6xy)=6y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the first pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(15{x}^{2}-y)=-1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(8y+x)=1.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the second pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡x+1)=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3{y}^{2})=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186383335 :knowledge-point/_questions [{:db/id 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b472e442-9445-5258-a932-d37b350c4862" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186383337} {:answer/id #uuid "d0ea5006-594f-551c-88dd-9d499a0f8ef7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383338} {:answer/id #uuid "2ab22615-9143-598a-bdab-cff845919999" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383339} {:answer/id #uuid "1e5b6004-b6b9-5a73-9b00-447dbc05e7a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186383340} {:answer/id #uuid "a46336b5-0aa7-5752-9714-739cc1b49b41" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186383341}] :answer-field/correct {:answer/id #uuid "a46336b5-0aa7-5752-9714-739cc1b49b41" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186383341} :answer-field/id #uuid "fe8e2d76-00aa-52ec-ae9d-7456cd1f49e4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383336}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "004baeb6-1fe8-58d6-b484-d81ddf229838" :question/math-academy-id "q-133295" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)={e}^{x}\\operatorname{cos}⁡({e}^{x})$ and ${f}_{y}(x,y)=\\operatorname{sin}⁡({e}^{x})$\n- ${f}_{x}(x,y)=\\sqrt{1-{x}^{2}}$ and ${f}_{y}(x,y)=\\sqrt{1-y}$\n- ${f}_{x}(x,y)=\\operatorname{ln}⁡({x}^{2}+1)$ and ${f}_{y}(x,y)=x\\operatorname{ln}⁡({y}^{2}+1)$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡({e}^{x}))=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡({e}^{x}))={e}^{x}\\operatorname{cos}⁡({e}^{x}).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\sqrt{1-{x}^{2}})=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\sqrt{1-y})=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+1))=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡({y}^{2}+1))=\\operatorname{ln}⁡({y}^{2}+1).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186383342 :knowledge-point/_questions [{:db/id 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "884d0021-241f-59ee-ac20-35d8dc83812d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383344} {:answer/id #uuid "307a8a24-1c7b-5a9b-9984-fe97db53d476" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383345} {:answer/id #uuid "53614062-42da-5993-a88a-ef98686557fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383346} {:answer/id #uuid "73c81600-9ccb-5055-90c7-5c358c405cda" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186383347} {:answer/id #uuid "aa18bb00-52dd-5f02-8e04-cdb69157970d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186383348}] :answer-field/correct {:answer/id #uuid "307a8a24-1c7b-5a9b-9984-fe97db53d476" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383345} :answer-field/id #uuid "e3b17f5c-b92c-5712-ad37-ec88c97f8a52" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383343}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d4e7c93-f352-516f-9253-b49a36a438e0" :question/math-academy-id "q-133297" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\nI. ${f}_{x}(x,y)=2{e}^{2x-{y}^{2}}$ and ${f}_{y}(x,y)=-2y{e}^{2x-{y}^{2}}$\n\nII. ${f}_{x}(x,y)=2\\operatorname{cos}⁡(2x-{y}^{2})$ and ${f}_{y}(x,y)=-2x\\operatorname{cos}⁡(2x-{y}^{2})$\n\nIII. ${f}_{x}(x,y)=\\sqrt{x}$ and ${f}_{y}(x,y)=x\\operatorname{ln}⁡y$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2{e}^{2x-{y}^{2}})=-4y{e}^{2x-{y}^{2}} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(-2y{e}^{2x+{y}^{2}})=-4y{e}^{2x-{y}^{2}}.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the first pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2\\operatorname{cos}⁡(2x-{y}^{2}))=4y\\operatorname{sin}⁡(2x-{y}^{2}) \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(-2x\\operatorname{cos}⁡(2x-{y}^{2}))=-2\\operatorname{cos}⁡(2x-{y}^{2})+4x\\operatorname{sin}⁡(2x-{y}^{2}).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the second pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\sqrt{x})=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y)=\\operatorname{ln}⁡y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186383349 :knowledge-point/_questions [{:db/id 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e70d7ac-ff81-563c-8d3a-1abe9a1ed73b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186383351} {:answer/id #uuid "711adf09-90f8-5bee-96d4-3ce91f7b61ec" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383352} {:answer/id #uuid "f5c34f84-8cfa-5634-9335-fa74a7d9cb65" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383353} {:answer/id #uuid "f435ccd5-c4ed-5adb-9db5-41978e7a32be" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186383354} {:answer/id #uuid "680a65a8-dd68-5105-86cd-428c7eb13879" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186383355}] :answer-field/correct {:answer/id #uuid "1e70d7ac-ff81-563c-8d3a-1abe9a1ed73b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186383351} :answer-field/id #uuid "6c462acb-7523-5724-bbf4-7e5e9633b864" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383350}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffcfd211-dc96-5e56-a933-77ab3f803324" :question/math-academy-id "q-133332" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\n- ${f}_{x}(x,y)={x}^{2}+5y$ and ${f}_{y}(x,y)=3{x}^{2}-3y$\n- ${f}_{x}(x,y)=-2x{e}^{{y}^{3}-{x}^{2}}$ and ${f}_{y}(x,y)=3{y}^{2}{e}^{{y}^{3}-{x}^{2}}$\n- ${f}_{x}(x,y)=3{x}^{2}y-y{e}^{xy}$ and ${f}_{y}(x,y)={x}^{3}-x{e}^{xy}$" :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({x}^{2}+5y)=5 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3{x}^{2}-3y)=6x.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(-2x{e}^{{y}^{3}-{x}^{2}})=-6x{y}^{2}{e}^{{y}^{3}-{x}^{2}} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3{y}^{2}{e}^{{y}^{3}-{x}^{2}})=-6x{y}^{2}{e}^{{y}^{3}-{x}^{2}}.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(3{x}^{2}y-y{e}^{xy}) \\\\  & =3{x}^{2}-({e}^{xy}+xy{e}^{xy}), \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({x}^{3}-x{e}^{xy}) \\\\  & =3{x}^{2}-({e}^{xy}+xy{e}^{xy}).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186383473 :knowledge-point/_questions [{:db/id 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "936d7b13-5b71-5194-81ae-8a9e2c5fcd9e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186383475} {:answer/id #uuid "cc5f7475-2ed6-5573-b9b1-a2c1bd23141d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383476} {:answer/id #uuid "a05138df-6a85-57ac-9c44-1dc3b1b8852b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383477} {:answer/id #uuid "2f04460e-7451-5cf0-840f-c946386744b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186383478} {:answer/id #uuid "058683e1-87ae-5e36-a51e-3c5f0a504465" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186383479}] :answer-field/correct {:answer/id #uuid "cc5f7475-2ed6-5573-b9b1-a2c1bd23141d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383476} :answer-field/id #uuid "c8ffa765-eacc-563c-a188-53bbd93fccbe" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383474}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5449cbef-825d-5bac-be24-822940400b4f" :question/math-academy-id "q-143335" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.1$ |\n| $X=2$ | $0.3$ | $0.2$ |\n| $X=3$ | $0.2$ | $0.1$ |\n\nWhich of the following statements are true?\n\n- $P(X=2,Y=2)=P(X=2)\\cdot P(Y=2)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.1$ | $0.2$ |\n| $X=2$ | $0.3$ | $0.2$ | $0.5$ |\n| $X=3$ | $0.2$ | $0.1$ | $0.3$ |\n| ${f}_{Y}$ | $0.6$ | $0.4$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=2,Y=2)=f(2,2)=0.2.$ On the other hand, \n\n$$\nP(X=2)\\cdot P(Y=2)={f}_{X}(2)\\cdot {f}_{Y}(2)=0.5\\cdot 0.4=0.2.\\,✓\n$$\n\n- Statement II is false. Taking $x=1$ and $y=1,$ we obtain the following:\n\n$$\n\\begin{aligned}f(1,1) & =0.1\\ne 0.2\\cdot 0.6={f}_{X}(1)\\cdot {f}_{Y}(1) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186383554 :knowledge-point/_questions [{:db/id 17592186198400 :knowledge-point/id #uuid "4179839d-85c4-5325-9293-e332bd209597" :knowledge-point/title "Identifying True Statements Regarding the Inverse Function Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08591c50-d2f8-549a-ba10-75d857743ef1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186383556} {:answer/id #uuid "7ac94a93-62ef-553e-89c8-9d25b60013c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186383557} {:answer/id #uuid "f1287fe6-db30-5067-b4bc-a59e28ea1181" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383558} {:answer/id #uuid "619920e2-3b93-58e3-bda9-575d1e101c63" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383559} {:answer/id #uuid "32f8f703-39ef-57df-bb97-5b1e661fb221" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186383560}] :answer-field/correct {:answer/id #uuid "619920e2-3b93-58e3-bda9-575d1e101c63" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186383559} :answer-field/id #uuid "d2936b7a-671b-55a9-bb7e-ae5b488e2a37" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383555}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dcab08e-c33d-5c73-a45a-265b0e425858" :question/math-academy-id "q-161847" :question/problem "Let $f:U\\to R$ be continuously differentiable on an open set $U⊆R$ such that $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U.$ Which of the following statements **must** be true?\n\n- The function $f$ is invertible on $U.$\n- The inverse ${f}^{-1}$ is continuously differentiable on $U.$\n- The derivative of ${f}^{-1}$ is given by ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$" :question/worked-solution "The inverse function theorem for single-variable functions states the following:\n\n*If $f:U\\to R$ is continuously differentiable on an open set $U⊆R,$ $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *${f}^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of ${f}^{-1}$ is given by* \n\n$$\n{({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}=\\frac{1}{{f}^{′}({f}^{-1}(b))}\\,.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the theorem, the function $f$ must be invertible in some neighborhood of $a,$ which could be smaller than $U.$ \n\nFor example, the function $f(x)=2{x}^{4}$ satisfies the conditions of the inverse function theorem for $U=(-2,2)$ and $a=-1.$ However, $f(x)$ is not invertible on the entire set $U,$ only on a subset of $U.$\n\n- Statement II is false. According to the theorem, the function${f}^{-1}$ must be continuously differentiable in a neighborhood of $b,$ which could be smaller than $U.$\n\n- Statement III is true. According to the theorem, we must have ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186383694 :knowledge-point/_questions [{:db/id 17592186054640 :knowledge-point/id #uuid "d4954fe5-f1fe-590a-9540-280a14606a49" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2452efe-7a0d-55b1-b8ee-8b83b0ff6623" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186383696} {:answer/id #uuid "0ece61de-c687-5f54-9057-3139db410b0f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383697} {:answer/id #uuid "25976cf8-d5d4-5c2a-8533-dd3ded0d30b8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186383698} {:answer/id #uuid "7066be29-ca8b-5262-9bb0-33adcf975e01" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186383699} {:answer/id #uuid "7b444d15-0fa3-5286-9366-c2b32530808c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186383700}] :answer-field/correct {:answer/id #uuid "0ece61de-c687-5f54-9057-3139db410b0f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186383697} :answer-field/id #uuid "65323383-102f-5524-89a8-d6b6199fe8ce" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186383695}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d0c05d7-b425-5e33-a2de-62cbcada849e" :question/math-academy-id "q-182247" :question/problem "Which of the following statements are true?\n\n- $P(P({x}))={∅,{∅},{{x}},{∅,{x}}}$\n- $P({{x}})={∅,{x}}$\n- $P({x,∅})={∅,{x},{∅},{x,∅}}$" :question/worked-solution "The power set of $T,$ denoted $P(T),$ is the set that contains every possible subset of $T,$ including the empty set $∅.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, the power set of the set ${x}$ is ${∅,{x}}.$ Therefore, $P(P({x}))={∅,{∅},{{x}},{∅,{x}}}.$\n\n- Statement II is false. Notice that we are given the set ${{x}}.$ Then, the power set of the set ${{x}}$ is ${∅,{{x}}}.$ Therefore, $P({{x}})={∅,{{x}}}.$\n\n- Statement III is true. Notice that we are given the set ${x,∅}.$ So, its power set must be ${∅,{x},{∅},{x,∅}}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186384684 :knowledge-point/_questions [{:db/id 17592186157232 :knowledge-point/id #uuid "fb4d348b-1703-51a1-be05-2e66295cacaa" :knowledge-point/title "Completing Trivial Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3cdb594-408d-55db-b08b-8165e9c7817b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186384686} {:answer/id #uuid "aa91a215-d4d2-5d56-b7e9-6df44cba8e67" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 175921