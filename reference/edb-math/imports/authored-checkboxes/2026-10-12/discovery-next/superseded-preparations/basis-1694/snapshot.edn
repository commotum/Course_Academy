1a-b49d1b1aa9f0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432724} {:answer/id #uuid "69d77dac-58f7-5252-9e21-125e39d4033b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432727} {:answer/id #uuid "a5d0a1e6-9bc7-54e5-adb0-ec9f8743d848" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432740} {:answer/id #uuid "b11e3ef3-de26-5e2b-a700-7f2ecb279329" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432744} {:answer/id #uuid "d8eb41db-fc65-5243-aa64-63b69ecf8947" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432756}] :answer-field/correct {:answer/id #uuid "a5d0a1e6-9bc7-54e5-adb0-ec9f8743d848" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432740} :answer-field/id #uuid "cd4c20e9-b428-5717-aa65-b028512ceffa" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432781}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "951452dc-b5fb-50d7-8d4f-8b1233b43cf0" :question/math-academy-id "q-223369" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $447$\n\nII. $406$\n\nIII. $847$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $447,$ we have that \n\n$$\n44-2(7)=44-14=30\n$$\n\nwhich is not divisible by $7.$ Therefore, $447$ is not divisible by $7.$\n\n- For the number $406,$ we have that \n\n$$\n40-2(6)=40-12=28\n$$\n\nwhich is divisible by $7.$ Therefore, $406$ is divisible by $7.$\n\n- For the number $847,$ we have that \n\n$$\n84-2(7)=84-14=70\n$$\n\nwhich is divisible by $7.$ Therefore, $847$ is divisible by $7.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186432791 :knowledge-point/_questions [{:db/id 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03716efb-8dd0-5692-a7ad-ddc54290f97c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432702} {:answer/id #uuid "c7079a82-b92a-5d2b-9c94-e0b3d56ba29d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432750} {:answer/id #uuid "d53103cc-e21c-5a43-a029-4914bb36a519" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432753} {:answer/id #uuid "d86b4192-f97c-51d0-8a92-2939d373fe1c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432755} {:answer/id #uuid "ecf7965c-4e93-5f39-a663-6a32dce50c9e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432761}] :answer-field/correct {:answer/id #uuid "03716efb-8dd0-5692-a7ad-ddc54290f97c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432702} :answer-field/id #uuid "008ba33f-0dbe-5e5d-81fc-18953e1cddb8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432769}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a49592c2-4649-5980-ab80-d5418f7e763f" :question/math-academy-id "q-85422" :question/problem "Which digits, when inserted into the blank, make the number $114\\,040\\,32◻$ divisible by $6?$\n\nI. $0$\n\nII. $5$\n\nIII. $6$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n1+1+4+0+4+0+3+2+◻=15+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $0$ into the blank, we get $114\\,040\\,320,$ which is divisible by $2.$ The sum of the digits is $15+0=15,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\n- If we substitute $5$ into the blank, we get $114\\,040\\,325,$ which is not divisible by $2.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $6$ into the blank, we get $114\\,040\\,326,$ which is divisible by $2.$ The sum of the digits is $15+6=21,$ which is divisible by $3,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186432793 :knowledge-point/_questions [{:db/id 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17fae707-234b-5507-93c9-8b38a5d9f1bf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432707} {:answer/id #uuid "19e13b1c-16f5-5fc8-a671-833b5709b8d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432708} {:answer/id #uuid "af45d2a1-5a3b-5c3e-9120-03abfd5ec846" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432743} {:answer/id #uuid "bad2a1ab-31c5-5027-a0be-787091378f58" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432745} {:answer/id #uuid "d6394eaa-ebbb-50b8-bf10-523ea6eac961" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432754}] :answer-field/correct {:answer/id #uuid "d6394eaa-ebbb-50b8-bf10-523ea6eac961" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432754} :answer-field/id #uuid "3dcd5f48-4894-5201-9b6d-2e2eb2a453bf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432776}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9669189-f542-5fc7-9dce-62db6de9555d" :question/math-academy-id "q-132386" :question/problem "Which of the following numbers are divisible by $3?$\n\nI. $935\\,784$\n\nII. $7\\,391\\,123$\n\nIII. $12\\,144\\,801$" :question/worked-solution "A number is divisible by $3$ if the sum of its digits is divisible by $3.$\n\n- The sum of the digits of $935\\,784$ is\n\n$$\n9+3+5+7+8+4=36,\n$$\n\nwhich is divisible by $3.$ So, $935\\,784$ is divisible by $3.$\n\n- The sum of the digits of $7\\,391\\,123$ is\n\n$$\n7+3+9+1+1+2+3=26,\n$$\n\nwhich is *not* divisible by $3.$ So, $7\\,391\\,123$ is *not* divisible by $3.$\n\n- The sum of the digits of $12\\,144\\,801$ is\n\n$$\n1+2+1+4+4+8+0+1=21,\n$$\n\nwhich is divisible by $3.$ So,  $12\\,144\\,801$ is divisible by $3.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186432794 :knowledge-point/_questions [{:db/id 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121e7df8-8657-5dcb-a92f-506287be02dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432705} {:answer/id #uuid "6999ccbb-0da9-56ee-9ed1-618bb6718054" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432726} {:answer/id #uuid "89c0a663-188b-568b-84c7-12a167670681" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432731} {:answer/id #uuid "c423a550-f52a-5b4e-b53b-5d4f5453fe48" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432749} {:answer/id #uuid "f1d8ff3d-ef9d-5ac4-8135-04c1399c5e26" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432764}] :answer-field/correct {:answer/id #uuid "c423a550-f52a-5b4e-b53b-5d4f5453fe48" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432749} :answer-field/id #uuid "bd1116a6-2d8a-5e7c-bbb8-69191fa04e08" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432780}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2757e05-6aab-58ae-aed8-77516507381e" :question/math-academy-id "q-132392" :question/problem "Which of the following numbers are divisible by $9?$\n\nI. $34\\,154\\,119$\n\nII. $9\\,173\\,589$\n\nIII. $733\\,123$" :question/worked-solution "A number is divisible by $9$ if the sum of its digits is divisible by $9.$\n\n- The sum of the digits of $34\\,154\\,119$ is\n\n$$\n3+4+1+5+4+1+1+9=28,\n$$\n\nwhich is *not* divisible by $9.$ So, $34\\,154\\,119$ is *not* divisible by $9.$\n\n- The sum of the digits of $9\\,173\\,589$ is\n\n$$\n9+1+7+3+5+8+9=42,\n$$\n\nwhich is *not* divisible by $9.$ So, $9\\,173\\,589$ is *not* divisible by $9.$\n\n- The sum of the digits of $733\\,123$ is\n\n$$\n7+3+3+1+2+3=19,\n$$\n\nwhich is *not* divisible by $9.$ So, $733\\,123$ is *not* divisible by $9.$\n\nTherefore, the correct answer is \"None.\""}] [{:db/id 17592186432795 :knowledge-point/_questions [{:db/id 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d82c8ca-e2a0-5442-acfc-6cf1aba5809b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432704} {:answer/id #uuid "2a0c050b-dbdf-51df-b498-80916aea50b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432712} {:answer/id #uuid "32d2feef-0a50-5be6-8be0-cc007b6c7465" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432715} {:answer/id #uuid "50fc2e21-2e60-5152-8ded-84b094c83b34" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432722} {:answer/id #uuid "aec18c88-4572-5f31-bf18-6f1c2e43c5c7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432742}] :answer-field/correct {:answer/id #uuid "aec18c88-4572-5f31-bf18-6f1c2e43c5c7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432742} :answer-field/id #uuid "d41a4fb2-3b50-5439-ab7b-d9726d39fc08" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432782}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0e5ee54-f96c-54ab-8de5-f272c76ac6c8" :question/math-academy-id "q-223365" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $448$\n\nII. $352$\n\nIII. $217$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $448,$ we have that \n\n$$\n44-2(8)=44-16=28\n$$\n\nwhich is divisible by $7.$ Therefore, $448$ is divisible by $7.$\n\n- For the number $352,$ we have that \n\n$$\n35-2(2)=35-4=31\n$$\n\nwhich is not divisible by $7.$ Therefore, $352$ is not divisible by $7.$\n\n- For the number $217,$ we have that \n\n$$\n21-2(7)=21-14=7\n$$\n\nwhich is divisible by $7.$ Therefore, $217$ is divisible by $7.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186432796 :knowledge-point/_questions [{:db/id 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031e87af-b7df-5caa-98ff-dd4bdf5b2596" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432701} {:answer/id #uuid "4a0625b5-89d4-5e5f-9799-0edb2744330c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432719} {:answer/id #uuid "a1c3fe5c-f2c3-50ce-8bd4-e2d9ace1ee05" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432737} {:answer/id #uuid "a4cbcf82-d526-53da-9a10-140590b0bd4e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432739} {:answer/id #uuid "ed58acbc-01e1-5d2e-8ccf-549196fdfa60" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432762}] :answer-field/correct {:answer/id #uuid "ed58acbc-01e1-5d2e-8ccf-549196fdfa60" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432762} :answer-field/id #uuid "3188a9e7-7b59-59ac-8edf-b18ab2c46193" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432773}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fdf659d7-2ff6-5274-9913-97ffa0cf4e09" :question/math-academy-id "q-223456" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $476$\n\nII. $732$\n\nIII. $423$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $476,$ we have that \n\n$$\n47-2(6)=47-12=35\n$$\n\nwhich is divisible by $7.$ Therefore, $476$ is divisible by $7.$\n\n- For the number $732,$ we have that \n\n$$\n73-2(2)=73-4=69\n$$\n\nwhich is not divisible by $7.$ Therefore, $732$ is not divisible by $7.$\n\n- For the number $423,$ we have that \n\n$$\n42-2(3)=42-6=36\n$$\n\nwhich is not divisible by $7.$ Therefore, $423$ is not divisible by $7.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186433150 :knowledge-point/_questions [{:db/id 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5594b522-b05d-56b3-b912-961b140aeac9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id 17592186433126} {:answer/id #uuid "8ea03761-fa6e-5cb3-aed6-0f335e32102b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id 17592186433130} {:answer/id #uuid "8f442901-c3b7-5866-82d6-1cf54562946a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id 17592186433131} {:answer/id #uuid "902457a9-b694-5355-8804-d4836495776f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ only" :db/id 17592186433132} {:answer/id #uuid "b4b5b8f0-d7c4-56e8-91b3-1eb6a0e8b98a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "All the listed" :db/id 17592186433139}] :answer-field/correct {:answer/id #uuid "8ea03761-fa6e-5cb3-aed6-0f335e32102b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id 17592186433130} :answer-field/id #uuid "88d26e7d-7cf7-53de-a739-9d6548330c1e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433144}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9cc85c8f-2fc1-51b5-90b3-b4c40aaa9ac5" :question/math-academy-id "q-40288" :question/problem "Which of the following sets are orthogonal?\n\nI. $U=\\{[\\begin{aligned}-2 \\\\ -1\\end{aligned}],[\\begin{aligned}3 \\\\ 2\\end{aligned}],[\\begin{aligned}15 \\\\ -20\\end{aligned}]\\}$\n\nII. $V=\\{[\\begin{aligned}0 \\\\ 5\\end{aligned}],[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\}$\n\nIII. $W=\\{[\\begin{aligned}6 \\\\ 1 \\\\ -1\\end{aligned}],[\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ -1 \\\\ 0\\end{aligned}]\\}$" :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2},{u}_{3}\\},$ \n$\\{{v}_{1},{v}_{2}\\},$ and \n$\\{{w}_{1},{w}_{2},{w}_{3}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0,\\,{u}_{1}\\cdot {u}_{3}=0,\\,{u}_{2}\\cdot {u}_{3}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0,\\,{w}_{1}\\cdot {w}_{3}=0,\\,{w}_{2}\\cdot {w}_{3}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- The set $U$ cannot be orthogonal since it contains  $3$ vectors from ${R}^{2}$ (in which we can have an orthogonal set with at most 2 non-zero vectors). Therefore, $U$ is not an orthogonal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}0 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 2\\end{aligned}]=0+10=10\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthogonal set.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}6 \\\\ 1 \\\\ -1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 3 \\\\ 1\\end{aligned}]=12+3-1=14\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"None of the listed\"."}] [{:db/id 17592186433152 :knowledge-point/_questions [{:db/id 17592186133843 :knowledge-point/id #uuid "ee1838df-f1d6-5bc4-908c-b96e2ad577c9" :knowledge-point/title "Determining Whether Sets are Orthogonal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e486175-d93e-59a1-beee-b5e17fb3fe9f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id 17592186433123} {:answer/id #uuid "7d1dfe6a-46a2-5b7b-b9a2-2e4f0b6a6290" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ only" :db/id 17592186433128} {:answer/id #uuid "99a6a3de-f047-5ffa-a17f-a1fea25b4278" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$W$ only" :db/id 17592186433134} {:answer/id #uuid "b440af9e-0d7a-5e18-bcec-b34eee928e3f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ only" :db/id 17592186433138} {:answer/id #uuid "c833776b-5d21-59ee-8ccb-29989a9b9e8a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id 17592186433142}] :answer-field/correct {:answer/id #uuid "b440af9e-0d7a-5e18-bcec-b34eee928e3f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ only" :db/id 17592186433138} :answer-field/id #uuid "c1c41282-b496-53fd-b601-ecca0a4b4a0c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433146}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f013658-0e98-56e3-b0df-e2d26e152fca" :question/math-academy-id "q-140479" :question/problem "Which of the following sets are orthogonal?\n\nI. $U=\\{[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}],[\\begin{aligned}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]\\}$\n\nII. $V=\\{[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}],[\\begin{aligned}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{aligned}],[\\begin{aligned}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{aligned}]\\}$\n\nIII. $W=\\{[\\begin{aligned}1 \\\\ -1 \\\\ 4\\end{aligned}],[\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]\\}$" :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2}\\},$ \n$\\{{v}_{1},{v}_{2},{v}_{3}\\},$ and \n$\\{{w}_{1},{w}_{2}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthogonal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0.$\n\n- ${v}_{1}\\cdot {v}_{2}=0,\\,{v}_{1}\\cdot {v}_{3}=0,\\,{v}_{2}\\cdot {v}_{3}=0.$\n\n- ${w}_{1}\\cdot {w}_{2}=0.$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}-3 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]=-3+0-2+2=-3\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthogonal set.\n\n- For the set $V,$ we get the following:\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{aligned}]=4-4=0 & ✓ \\\\ {v}_{1}\\cdot {v}_{3} & =[\\begin{aligned}1 \\\\ 0 \\\\ -2 \\\\ 2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{aligned}]=2+0-4+2=0 & ✓ \\\\ {v}_{2}\\cdot {v}_{3} & =[\\begin{aligned}0 \\\\ 3 \\\\ -2 \\\\ -2\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 2 \\\\ 1\\end{aligned}]=0+6-4-2=0 & ✓\\end{aligned}\n$$\n\nSo, the set $V$ is orthogonal.\n\n- For the set $W,$ notice that \n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}1 \\\\ -1 \\\\ 4\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ -2 \\\\ 1\\end{aligned}]=2+2+4=8\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $W$ is not an orthogonal set.\n\nTherefore, we conclude that the correct answer is \"$V$ only\"."}] [{:db/id 17592186433153 :knowledge-point/_questions [{:db/id 17592186133781 :knowledge-point/id #uuid "ed5c8af7-e617-5e8c-be01-45a26eb17d4d" :knowledge-point/title "Determining Whether Sets are Orthonormal"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1973b4e5-3021-5f0e-84fb-21f789bd603c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ only" :db/id 17592186433120} {:answer/id #uuid "2454dddf-8213-5a02-af2b-3a48c11de7c7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $V$ only" :db/id 17592186433121} {:answer/id #uuid "625d32a2-e015-5a3c-a155-566556b8fd99" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$W$ only" :db/id 17592186433127} {:answer/id #uuid "a054e702-a15a-5f24-9814-706df32db073" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id 17592186433135} {:answer/id #uuid "a2e77911-f7b1-5d0a-99ba-fbc6c3057279" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$V$ and $W$ only" :db/id 17592186433136}] :answer-field/correct {:answer/id #uuid "a054e702-a15a-5f24-9814-706df32db073" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$U$ and $W$ only" :db/id 17592186433135} :answer-field/id #uuid "e09f4fd9-728c-5fad-860e-671199dd6464" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433147}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bccef2e2-efdc-5751-b184-d287795e3e5f" :question/math-academy-id "q-82399" :question/problem "Which of the following sets are orthonormal?\n\nI. $U=\\{[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\}$\n\nII. $V=\\{[\\begin{aligned}1 \\\\ 4 \\\\ -3\\end{aligned}],[\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}],[\\begin{aligned}8 \\\\ -1 \\\\ -9\\end{aligned}]\\}$\n\nIII. $W=\\{[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}],[\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]\\}$" :question/worked-solution "Let's denote the vectors of the given sets as \n$\\{{u}_{1},{u}_{2}\\},$ \n$\\{{v}_{1},{v}_{2},{v}_{3}\\},$ and \n$\\{{w}_{1},{w}_{2}\\},$ respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,\\{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- $\\{\\begin{aligned}{v}_{1}\\cdot {v}_{2}=0 \\\\ {v}_{1}\\cdot {v}_{3}=0 \\\\ {v}_{2}\\cdot {v}_{3}=0\\end{aligned}\\,\\text{and}\\,\\{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1 \\\\ {v}_{3}\\cdot {v}_{3}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,\\{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ we get the following:\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{1}{2}-\\frac{1}{2}=0 & ✓ \\\\ {u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ \\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{1}{2}+\\frac{1}{2}=1 & ✓ \\\\ {u}_{2}\\cdot {u}_{2} & =[\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}}\\end{aligned}]=\\frac{1}{2}+\\frac{1}{2}=1 & ✓\\end{aligned}\n$$\n\nSo, the set $U$ is orthonormal.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}1 \\\\ 4 \\\\ -3\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 3 \\\\ -2\\end{aligned}]=0+12+6=18\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]=\\frac{12}{25}-\\frac{12}{25}=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{4}{5} \\\\ \\frac{3}{5}\\end{aligned}]=\\frac{16}{25}+\\frac{9}{25}=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]\\cdot [\\begin{aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]=\\frac{9}{25}+\\frac{16}{25}=1 & ✓\\end{aligned}\n$$\n\nSo, $W$ is an orthonormal set.\n\nTherefore, we conclude that the correct answer is \"$U$ and $W$ only\"."}] [{:db/id 17592186433173 :knowledge-point/_questions [{:db/id 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008275fa-715e-57ea-bc82-5a6102db2a5d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433155} {:answer/id #uuid "59f9131e-98fe-5931-bf40-b384cfc12aca" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186433159} {:answer/id #uuid "75750201-9871-5333-9d36-628baad463f0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186433162} {:answer/id #uuid "75b5793f-7a42-5e9f-b867-97cb0a94ee05" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433163} {:answer/id #uuid "856794aa-f420-58cc-9b35-d295a27c06b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186433165}] :answer-field/correct {:answer/id #uuid "75b5793f-7a42-5e9f-b867-97cb0a94ee05" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433163} :answer-field/id #uuid "375de494-0474-59f2-a5cb-d4f2d3d924b6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433170}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46f6694f-8103-554b-a6d3-9a98e8c2973d" :question/math-academy-id "q-34711" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 0 \\\\ -5\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 0\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-3 \\\\ -2 \\\\ 5\\end{aligned}].\n$$\n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$  has an infinite number of nonzero solutions.\n\nIII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}2{x}_{1}+{x}_{2}-3{x}_{3}=0 \\\\ 2{x}_{2}-2{x}_{3}=0 \\\\ -5{x}_{1}+5{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & 1 & -3 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ -5 & 0 & 5 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 2 & 1 & -3 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+\\frac{2}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 1 & -1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼[\\begin{aligned}-5 & 0 & 5 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statement III is false, while statements I and II are true."}] [{:db/id 17592186433343 :knowledge-point/_questions [{:db/id 17592186229138 :knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397" :knowledge-point/title "Identifying Linear Differential Operators Using the General Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16f1d4a5-53db-5cf6-bc1b-078445acab5c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186433324} {:answer/id #uuid "1df3fa27-db87-5d4f-a0be-23a81125c98c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433326} {:answer/id #uuid "567e86ad-0a32-55a9-8b19-931ce53e8d20" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433327} {:answer/id #uuid "d7ac5fcd-d0e0-5666-8e83-23100e4bb34a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186433334} {:answer/id #uuid "fedca91d-70a4-5b6b-a4d0-9dd643119950" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186433338}] :answer-field/correct {:answer/id #uuid "d7ac5fcd-d0e0-5666-8e83-23100e4bb34a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186433334} :answer-field/id #uuid "f3856639-8cc5-5769-ab2a-9f53121ca700" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433341}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d7d4653-1949-5012-bba8-de86196b5589" :question/math-academy-id "q-337766" :question/problem "Which of the following are linear differential operators?\n\nI. ${D}_{1}(y)={y}^{2}\\frac{\\text{d}y}{\\text{d}x}+xy$\n\nII. ${D}_{2}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-2x\\frac{\\text{d}y}{\\text{d}x}+3y$\n\nIII. ${D}_{3}(y)=\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+y\\frac{\\text{d}y}{\\text{d}x}$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the first term is ${y}^{2},$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{2}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=x,{f}_{1}(x)=-2x,$ and ${f}_{0}(x)=3.$\n\n- Operator ${D}_{3}$ is *not* linear. The coefficient of the second term is $y,$ which depends on $y$ and therefore fails linearity.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186433344 :knowledge-point/_questions [{:db/id 17592186229138 :knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397" :knowledge-point/title "Identifying Linear Differential Operators Using the General Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58989a8c-0f59-5641-920d-959052362e5e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186433328} {:answer/id #uuid "884f87d0-cc4b-5052-8f16-9f1691264cfa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433331} {:answer/id #uuid "a7e61d62-cdc4-5531-aa2f-3ea820faba0a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186433332} {:answer/id #uuid "d944eb4d-0a4c-5e50-915a-2fdd108bb5a2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186433335} {:answer/id #uuid "f97048dc-d665-5674-a86a-01f4a85a0cdc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186433337}] :answer-field/correct {:answer/id #uuid "d944eb4d-0a4c-5e50-915a-2fdd108bb5a2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186433335} :answer-field/id #uuid "1ea9415e-b935-5b01-a9af-fa81c603a9ef" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433339}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d74a3e3c-e2b0-50fc-9e27-1744209e35b1" :question/math-academy-id "q-337767" :question/problem "Which of the following are linear differential operators?\n\nI. ${D}_{1}(y)=3\\frac{\\text{d}y}{\\text{d}x}+{x}^{2}y$\n\nII. ${D}_{2}(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y\\frac{\\text{d}y}{\\text{d}x}$\n\nIII. ${D}_{3}(y)={x}^{2}\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}-\\frac{\\text{d}y}{\\text{d}x}+2y$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is linear. It is a first-order linear differential operator of the form\n\n$$\n{D}_{1}(y)={f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{1}(x)=3$ and ${f}_{0}(x)={x}^{2}.$\n\n- Operator ${D}_{2}$ is *not* linear. The coefficient of the second term is $y,$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{3}$ is linear. It is a third-order linear differential operator of the form\n\n$$\n{D}_{3}(y)={f}_{3}(x)\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+{f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{3}(x)={x}^{2},{f}_{2}(x)=0,{f}_{1}(x)=-1,$ and ${f}_{0}(x)=2.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186433609 :knowledge-point/_questions [{:db/id 17592186152125 :knowledge-point/id #uuid "ebf3f930-2768-5399-8470-48ac430065a3" :knowledge-point/title "Classifying Numbers as Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57a6471b-bd77-5aee-aeff-e9d5f4387baf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186433590} {:answer/id #uuid "66d9b2ee-4fe7-59c8-9132-d913e4e61062" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186433592} {:answer/id #uuid "75c7099d-8ae5-5ce9-8677-484e3279c83b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433594} {:answer/id #uuid "77a50393-7099-5a74-b6fa-5abc6300ec01" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186433595} {:answer/id #uuid "b3c8f7ea-0cb0-5b68-9325-dd9c3a2362cd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433600}] :answer-field/correct {:answer/id #uuid "77a50393-7099-5a74-b6fa-5abc6300ec01" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186433595} :answer-field/id #uuid "2e18ef21-c07b-584b-a353-bc2e107acf2e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433604}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de7db80c-f818-55cb-b186-c1d21190ea48" :question/math-academy-id "q-98369" :question/problem "Which of the following numbers are integers?\n\nI. $\\frac{3}{2}$\n\nII. $-3$\n\nIII. $5$" :question/worked-solution "The integers consist of all positive and negative whole numbers and zero.\n\n$$\n…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…\n$$\n\n \n\nOf the given numbers, $-3$ and $5$ are integers, but $\\frac{3}{2}$ is not.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186433610 :knowledge-point/_questions [{:db/id 17592186152125 :knowledge-point/id #uuid "ebf3f930-2768-5399-8470-48ac430065a3" :knowledge-point/title "Classifying Numbers as Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e712e82-fa0f-5c35-8341-987cad89094f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433584} {:answer/id #uuid "5a5526aa-d152-5495-bbcb-6f1e1ee497c1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186433591} {:answer/id #uuid "96e7edb9-c054-584a-a80a-d979fedb4496" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186433597} {:answer/id #uuid "99522998-d655-5aee-9ba1-5f3e13bc3006" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433598} {:answer/id #uuid "b0b741c4-7edd-5fb2-9681-7f1843d11f19" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186433599}] :answer-field/correct {:answer/id #uuid "99522998-d655-5aee-9ba1-5f3e13bc3006" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433598} :answer-field/id #uuid "189f8c27-4698-52fa-b757-7d2b24c8aa2a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433603}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb2e9e07-c134-569e-a208-041621377fa3" :question/math-academy-id "q-99311" :question/problem "Which of the following numbers are integers?\n\nI. $100$\n\nII. $-5$\n\nIII. $-\\frac{9}{2}$" :question/worked-solution "The integers consist of all positive and negative whole numbers and zero.\n\n$$\n…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…\n$$\n\n \n\nOf the given numbers, $100$ and $-5$ are integers, but $-\\frac{9}{2}$ is not.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186433715 :knowledge-point/_questions [{:db/id 17592186152226 :knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da" :knowledge-point/title "Identifying Generalized Eigenvectors of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0898420b-4c54-5e1d-97e3-5cc4bfdd8109" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186433685} {:answer/id #uuid "68d2143e-ca23-5a4c-95d7-62217b46497f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186433694} {:answer/id #uuid "6a0f6d67-6d78-567d-a365-5c0702b884e3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186433696} {:answer/id #uuid "adc06e2a-797f-5b5b-b125-a1b83e296a09" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186433701} {:answer/id #uuid "dbcccae4-29dd-5752-98f9-f75c35190636" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433705}] :answer-field/correct {:answer/id #uuid "dbcccae4-29dd-5752-98f9-f75c35190636" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186433705} :answer-field/id #uuid "287f4509-af62-597e-a469-54e8dc29ab13" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186433713}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "72a34fdf-b3e5-500c-96f3-76e3e66d1191" :question/math-academy-id "q-109572" :question/problem "$$\nA=[\\begin{aligned}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=[\\begin{aligned}1 & 1 & -1 \\\\ 2 & 4 & -2 \\\\ 3 & 1 & 1\\end{aligned}]-2[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]={{[\\begin{aligned}-2 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}][\\begin{aligned}-2 \\\\ 0 \\\\ 2\\end{aligned}]={{[\\begin{aligned}0 \\\\ -8 \\\\ -8\\end{aligned}]}_{⏟}}_{x}\\ne 0\n$$\n\n- Again, since we got a nonzero vector in the last step, we now compute the image of $x$ under the action of $A-2I:$\n\n$$\n(A-2I)x=[\\begin{aligned}-1 & 1 & -1 \\\\ 2 & 2 & -2 \\\\ 3 & 1 & -1\\end{aligned}][\\begin{aligned}0 \\\\ -8 \\\\ -8\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A-2I\\,}{\\to }{{[\\begin{aligned}-2 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\overset{A-2I\\,}{\\to }{{[\\begin{aligned}0 \\\\ -8 \\\\ -8\\end{aligned}]}_{⏟}}_{x}\\overset{A-2I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $3$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\""}] [{:db/id 17592186434367 :knowledge-point/_questions [{:db/id 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10d59970-014a-5390-ad87-b6c264b278a7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434323} {:answer/id #uuid "66babac9-7d04-5021-9b7c-f7e425d4dffe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434335} {:answer/id #uuid "c54d927c-6507-5c2b-ae0d-0a803a216556" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434347} {:answer/id #uuid "e4a992aa-e636-51ca-9022-36c97ccfa8a2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434352} {:answer/id #uuid "efa0ae2a-7f08-5952-b7c0-5f4c014cd9c5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434356}] :answer-field/correct {:answer/id #uuid "e4a992aa-e636-51ca-9022-36c97ccfa8a2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434352} :answer-field/id #uuid "73366abb-1505-5c62-a125-9d0726a1fb41" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434360}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44316634-3540-5552-a378-8f950333c8f6" :question/math-academy-id "q-94384" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+6{y}^{′}+18y=45\\operatorname{cos}⁡3t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ)+4\\operatorname{sin}⁡3t$\n\nII. $y=A{e}^{-3t}+B{e}^{3t}+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t$\n\nIII. $y={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+6{y}^{′}+18y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+6\\lambda +18 & =0 \\\\ ({\\lambda }^{2}+6\\lambda +9)-9+18 & =0 \\\\ (\\lambda +3)^{2}+9 & =0 \\\\ (\\lambda +3)^{2} & =-9 \\\\ \\lambda +3 & =\\pm 3\\text{i} \\\\ \\lambda  & =-3\\pm 3\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & =R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-3t}\\operatorname{cos}⁡(3t+ϕ), \\\\ {y}_{c}(t) & ={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡3t+\\beta \\operatorname{sin}⁡3t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =1$ and $\\beta =2.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & =R{e}^{-3t}\\operatorname{sin}⁡(3t+ϕ)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t, \\\\ y(t) & =R{e}^{-3t}\\operatorname{cos}⁡(3t+ϕ)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t, \\\\ y(t) & ={e}^{-3t}(A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t)+\\operatorname{cos}⁡3t+2\\operatorname{sin}⁡3t.\\end{aligned}\n$$\n\nOnly III matches the forms above. Therefore, the correct answer is \"III only\"."}] [{:db/id 17592186434368 :knowledge-point/_questions [{:db/id 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e435eba-7562-5fb0-810c-8dac762b4077" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434328} {:answer/id #uuid "74a3f2b4-0ca6-5951-a6dd-e2cbdba2de6f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434338} {:answer/id #uuid "897e1658-e2d8-558a-a228-a8db420f366d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434339} {:answer/id #uuid "a16996e7-7d46-5977-a350-af7a4818e178" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434343} {:answer/id #uuid "eaea2c9d-00cd-54df-872a-126be49382dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I  only" :db/id 17592186434355}] :answer-field/correct {:answer/id #uuid "eaea2c9d-00cd-54df-872a-126be49382dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I  only" :db/id 17592186434355} :answer-field/id #uuid "00d4fed9-b01e-5182-8093-0bdf0828e1f0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434359}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f73fcd2-bb5e-5500-9c9a-4e8cac71bdbd" :question/math-academy-id "q-79579" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+2{y}^{′}+5y=25t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2$\n\nII. $y=R{e}^{-2t}\\operatorname{sin}⁡(t+ϕ)+5t-2$\n\nIII. $y={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+t-5$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+2{y}^{′}+5y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +5 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+5 & =0 \\\\ (\\lambda +1)^{2}+4 & =0 \\\\ (\\lambda +1)^{2} & =-4 \\\\ \\lambda +1 & =\\pm 2\\text{i} \\\\ \\lambda  & =-1\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore the complimentary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a linear function, we assume that the particular solution is also a linear function,\n\n$$\n{y}_{p}(t)=\\alpha t+\\beta .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =5$ and $\\beta =-2.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=5t-2.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+5t-2, \\\\ y(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+5t-2, \\\\ y(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ)+5t-2.\\end{aligned}\n$$\n\nOnly I matches the forms above. Therefore, the correct answer is \"I only\"."}] [{:db/id 17592186434466 :knowledge-point/_questions [{:db/id 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1916b91d-3dd2-5b7d-8065-6c9e62cb7944" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434451} {:answer/id #uuid "48c12e76-6dfc-5fcc-8a40-a983537294e7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434453} {:answer/id #uuid "4a18a4a3-0167-535b-9b6b-71a22c559836" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434454} {:answer/id #uuid "67e34ad7-4389-5131-b10c-f7c33576ead6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434456} {:answer/id #uuid "a468f832-3368-5771-bc32-4531a9f82886" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434459}] :answer-field/correct {:answer/id #uuid "a468f832-3368-5771-bc32-4531a9f82886" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434459} :answer-field/id #uuid "3a92619f-b432-58af-81b2-c7de5e2f81be" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434464}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3deca36d-f2e0-579a-9131-b3cacf95a814" :question/math-academy-id "q-132448" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nI. The time until a laser fails, in hours, in a specific type of machine\n\nII. The number obtained when launching a fair roulette wheel\n\nIII. The number of children in a daycare center" :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I could be modeled using an exponential distribution. Laser failure in a particular machine can be modeled as independent events with a constant average rate, and we wish to know the time it takes for the laser to fail.\n\n- Random variable II does *not* follow an exponential distribution. There are no events that occur at a constant average rate, and there is no interval of continuous time or space. Moreover, the number obtained when launching a roulette wheel is discrete, not continuous.\n\n- Random variable III does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of children is discrete, not continuous.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186434467 :knowledge-point/_questions [{:db/id 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "112ab786-9dc2-56b1-ad95-98851cd1d5fc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434449} {:answer/id #uuid "154c2087-4f7e-5899-993c-d47ac1fb33e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434450} {:answer/id #uuid "8cfc39d2-61a4-56e6-90bf-ad85f0cc4e4c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434457} {:answer/id #uuid "bf065d18-e87f-5a12-9d23-987422ac4b16" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434460} {:answer/id #uuid "c6bac048-db5d-5859-b7b9-077b9d9c962c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434461}] :answer-field/correct {:answer/id #uuid "c6bac048-db5d-5859-b7b9-077b9d9c962c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434461} :answer-field/id #uuid "24bbf2f1-e6cf-53b2-8967-353915ff3d65" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434463}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a0569d9-4bfc-5b49-a516-f990725fdc02" :question/math-academy-id "q-96681" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nI. The time it takes for a taxi to reach any address in a city, starting from the same point\n\nII. The time it takes for a taxi to reach a particular address in a city, starting from the same point\n\nIII. The number of defective electronic components produced in a factory every week" :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I does *not* follow an exponential distribution. The times needed to reach different destinations will likely have different average rates.\n\n- Random variable II could be modeled using an exponential distribution. Journeys along a particular route can be modeled as independent events with a constant average rate, and we wish to know the amount of time needed to reach the destination.\n\n- Random variable III does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of defective components is discrete, not continuous.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186434468 :knowledge-point/_questions [{:db/id 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00635c76-6a2d-5359-9c79-cf68e4a537ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434448} {:answer/id #uuid "2923f92c-f047-52fe-9354-4e133888c105" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434452} {:answer/id #uuid "4c961182-ebbc-558a-a08d-aab935e1f068" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434455} {:answer/id #uuid "9866233c-de4a-59cc-a272-02e41e15cca9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434458} {:answer/id #uuid "d7b37614-ee7a-57bb-bc29-7f3a85ddcc73" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434462}] :answer-field/correct {:answer/id #uuid "9866233c-de4a-59cc-a272-02e41e15cca9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434458} :answer-field/id #uuid "8327a55a-2e34-5803-8492-faffa49567e7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434465}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c8480fc0-38a5-50e6-ac81-ff79f47d27a2" :question/math-academy-id "q-132463" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nI. The time between customer calls, in minutes, for a particular business\n\nII. The number of winning lottery tickets in a set of $10$ tickets\n\nIII. The number obtained when picking an integer number between $0$ and $15$ at random" :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I can be modeled using an exponential distribution. Calls can be modeled as independent events with a constant average rate, and we wish to know the amount of time until the next call occurs.\n\n- Random variable II does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of winning lottery tickets is discrete, not continuous.\n\n- Random variable III does *not* follow an exponential distribution. There is no interval of continuous time or space. The number obtained is discrete, not continuous.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186434505 :knowledge-point/_questions [{:db/id 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06448ce2-0e18-514f-b68e-1203b53623bf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434470} {:answer/id #uuid "09c7d387-d49f-536a-b195-0974f7eff35f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186434471} {:answer/id #uuid "5ba67d51-ba43-50e4-9513-6d222e3e8af9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186434486} {:answer/id #uuid "73623fce-c5b8-5155-ae34-d860b81c911a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434488} {:answer/id #uuid "bdd4ce4b-dbef-52fd-bba0-53352940d2eb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434496}] :answer-field/correct {:answer/id #uuid "bdd4ce4b-dbef-52fd-bba0-53352940d2eb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434496} :answer-field/id #uuid "d8fe19c0-cb1a-5326-b79f-39ab45804633" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434504}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "673ddc27-8133-50ba-9995-aed461126acc" :question/math-academy-id "q-143551" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{11}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ is unknown and $\\sigma $ is known, which of the following are statistics?\n\nI. $max({X}_{1},{X}_{3},…,{X}_{11},\\mu )$\n\nII. $min({X}_{2},{X}_{4},…,{X}_{10},\\sigma )$\n\nIII. $\\frac{{X}_{1}+{X}_{11}}{{\\mu }^{2}+{\\sigma }^{2}+1}$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression.\n\n- Expression I is *not* a statistic. It is a function that contains the unknown population mean $\\mu .$\n\n- Expression II is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{11}$ and the *known* population standard deviation $\\sigma $ only. Note that a statistic doesn't need to include every sample element.\n\n- Expression III is *not* a statistic. It is a function that contains the unknown population mean $\\mu .$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186434508 :knowledge-point/_questions [{:db/id 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f80261e-f3fc-5e23-8e3f-a6acba9abcf8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186434477} {:answer/id #uuid "3d10fc58-31b9-561f-8371-ffbba6ce6263" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186434481} {:answer/id #uuid "568b0d55-78f4-5d7c-b63a-bcab6a620e80" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434485} {:answer/id #uuid "97752404-ed02-56de-92db-254ae5e1b56b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434492} {:answer/id #uuid "9e8ef953-c0a1-5782-8534-95a941c3407d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434494}] :answer-field/correct {:answer/id #uuid "9e8ef953-c0a1-5782-8534-95a941c3407d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434494} :answer-field/id #uuid "5f4f0f31-85b3-59bd-8498-64976de6e8b3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434499}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d216f49f-dbd6-5da5-81b2-ff39a5445339" :question/math-academy-id "q-139833" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{10}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ and $\\sigma $ are both unknown, which of the following are statistics?\n\nI. ${\\sum }_{i=1}^{5}{X}_{i}-{\\sum }_{i=6}^{10}{X}_{i}$\n\nII. ${\\sum }_{i=1}^{10}\\sqrt{{X}_{i}^{2}-{\\sigma }^{2}}$\n\nIII. $\\frac{{X}_{1}+{X}_{10}}{2}+\\mu $" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression. \n\n- Expression I is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{10}$ only.\n\n- Expression II is *not* a statistic. It is a function that contains the unknown population variance ${\\sigma }^{2}.$\n\n- Expression III is *not* a statistic. It is a function that contains the unknown population mean $\\mu .$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186434510 :knowledge-point/_questions [{:db/id 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29453521-97e6-5150-a7bc-602fae176d59" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434476} {:answer/id #uuid "3cdaafcf-a37f-58e8-84d1-3d0c20ba5cfd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434480} {:answer/id #uuid "471b22b4-5280-5ef4-b6a9-086940207f69" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434482} {:answer/id #uuid "9aee564c-68f0-5f6d-b1c6-b37ef059a00a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434493} {:answer/id #uuid "f209a605-cfa0-5945-86f1-b2935fd1a5a0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186434498}] :answer-field/correct {:answer/id #uuid "f209a605-cfa0-5945-86f1-b2935fd1a5a0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186434498} :answer-field/id #uuid "b128b2f5-8e87-5b1c-8970-0c5544ce4df2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434502}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd7fa324-de44-5c60-a60e-ad08ed2ad90d" :question/math-academy-id "q-143554" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{12}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ and $\\sigma $ are both  known, which of the following are statistics?\n\nI. ${\\sum }_{i=1}^{12}|{X}_{i}-\\mu |$\n\nII. ${\\sum }_{i=1}^{12}({X}_{i}+\\sigma )$\n\nIII. $min({X}_{1},{X}_{2},…,{X}_{12})$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression.\n\n- Expression I is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{12}$ and the *known* population mean $\\mu $ only.\n\n- Expression II is also a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{12}$ and the *known* population standard deviation $\\sigma $ only.\n\n- Expression III is also a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{12}$ only.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186434595 :knowledge-point/_questions [{:db/id 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1382095a-ce36-5649-9176-e51b8a45eecf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434589} {:answer/id #uuid "1b5c0bb0-6a86-5a6c-bcaf-1f0fea305db4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434590} {:answer/id #uuid "d03236d8-6be8-5408-b90d-1fcabe487cf1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434591} {:answer/id #uuid "e18c382f-1d1e-5fc7-a402-581360ddc5de" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434592} {:answer/id #uuid "e3d0d900-1221-5e04-8384-9a017c7b2878" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434593}] :answer-field/correct {:answer/id #uuid "1382095a-ce36-5649-9176-e51b8a45eecf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434589} :answer-field/id #uuid "b99629cf-233b-5877-9205-658da974228d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434594}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8f1ed82d-67ec-55b7-826d-30733bc2c88f" :question/math-academy-id "q-35575" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\nI. $A=\\{⟨x,y⟩\\in {R}^{2}:y=0\\}$\n\nII. $B=\\{⟨x,y⟩\\in {R}^{2}:y=3x\\}$\n\nIII. $C=\\{⟨x,y⟩\\in {R}^{2}:y=2\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $y=0$ since $0=0.$ So, $0$ lies in $A.$\n\n- The set $B$ is a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $y=3x$ since $0=3\\cdot 0.$ So, $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0⟩$ does not satisfy the condition $y=2$ since $0\\ne 2.$\n\nSo, the correct answer is \"I and II only.\""}] [{:db/id 17592186434754 :knowledge-point/_questions [{:db/id 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1344f994-c7f3-5ec5-8bc3-dd5fb9f3b026" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434660} {:answer/id #uuid "9bd164ff-c783-54c1-a435-26f55abca16c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186434700} {:answer/id #uuid "9be9a2ae-0d17-5397-99d7-af0f171bb5f2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434701} {:answer/id #uuid "a028efe8-76c4-5c04-82bd-e900a7c72295" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434704} {:answer/id #uuid "f49e2cba-f810-5365-a372-e6f45bdb78dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434731}] :answer-field/correct {:answer/id #uuid "1344f994-c7f3-5ec5-8bc3-dd5fb9f3b026" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186434660} :answer-field/id #uuid "aabf5329-c030-5348-b4b6-66587320416f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434746}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ec0f059-837e-5e3d-9bb4-8d292f2af4e9" :question/math-academy-id "q-163781" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈5+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=[\\begin{aligned}-3 & -1 \\\\ -1 & -3\\end{aligned}].\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=-3$ and $det(A)=8$\n\nII. $A$ is neither positive-definite nor negative-definite\n\nIII. $a$ is a local maximum of $f$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, ${a}_{11}=-3$ and\n\n$$\ndet(A)=|\\begin{aligned}-3 & -1 \\\\ -1 & -3\\end{aligned}|=8.\n$$\n\n- Statement II is false. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-3<0, \\\\ {Δ}_{2} & =|\\begin{aligned}-3 & -1 \\\\ -1 & -3\\end{aligned}|=8>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is negative-definite.\n\n- Statement III is true. Since the matrix $A$ is negative-definite, the critical point $a$ is a local maximum of $f.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186434755 :knowledge-point/_questions [{:db/id 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d723f1a-3e00-5451-9a8e-3979cfbee414" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434667} {:answer/id #uuid "439fd18d-a45e-5a4a-9276-7284619940e3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434673} {:answer/id #uuid "65b7c2cb-305e-5629-b5ca-a76ce120a41c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186434682} {:answer/id #uuid "b4871234-59ca-5a03-86ce-df6b280edd92" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186434710} {:answer/id #uuid "cb29e13c-7941-5abb-8dab-e750fa074891" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434718}] :answer-field/correct {:answer/id #uuid "2d723f1a-3e00-5451-9a8e-3979cfbee414" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434667} :answer-field/id #uuid "547254ce-982e-5bb1-87b7-5c56ae4ce713" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434740}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "65b2f5b4-89e0-551f-a08f-1b697ac55d76" :question/math-academy-id "q-163786" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈-2+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=[\\begin{aligned}2 & 0 & -1 \\\\ 0 & 1 & 1 \\\\ -1 & 1 & 3\\end{aligned}].\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=2$ and $det(A)=3$\n\nII. $A$ is neither positive-definite nor negative-definite\n\nIII. $a$ is a saddle point of $f$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, we recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, ${a}_{11}=2$ and\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & 0 & -1 \\\\ 0 & 1 & 1 \\\\ -1 & 1 & 3\\end{aligned}| \\\\  & =2\\cdot |\\begin{aligned}1 & 1 \\\\ 1 & 3\\end{aligned}|+(-1)\\cdot |\\begin{aligned}0 & 1 \\\\ -1 & 1\\end{aligned}| \\\\  & =2(2)-1(1) \\\\  & =3.\\end{aligned}\n$$\n\n- Statement II is false. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=2>0 \\\\ {Δ}_{2} & =|\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}|=2>0 \\\\ {Δ}_{3} & =|A|=3>0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is positive-definite.\n\n- Statement III is false. Since the matrix $A$ is positive-definite, the critical point $a$ is a local minimum of $f.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186434757 :knowledge-point/_questions [{:db/id 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a2ce01-d899-5e97-a2f6-d48bd4f3ca01" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id 17592186434657} {:answer/id #uuid "0f25997d-4b61-53ec-9106-4119ee276f82" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186434658} {:answer/id #uuid "1d15721b-98b5-5633-b7d7-1d495541a3bb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ only" :db/id 17592186434662} {:answer/id #uuid "be45631c-d2cc-5229-b439-7b9b97ac9ee8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id 17592186434713} {:answer/id #uuid "fc9794fd-5fc3-53d2-9e31-d96573402693" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id 17592186434734}] :answer-field/correct {:answer/id #uuid "04a2ce01-d899-5e97-a2f6-d48bd4f3ca01" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id 17592186434657} :answer-field/id #uuid "dd8d1baf-33b0-5256-8cc7-c9e816543e66" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434749}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f6e52f3-8502-516e-a6ab-c65771746796" :question/math-academy-id "q-164168" :question/problem "![](images/f3/f3852805b0ae44433828113396fa63d0688ec06ae57886428815515e521baa49.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?" :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch regions exist for the points $B$ and $D.$ Hence, $B$ and $D$ are local minimum points.\n\n**Note**: For the point $D({x}_{D},{y}_{D},{z}_{D}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{D},{y}_{D})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\ge f(a,b)$, the point $D$ does satisfy the conditions for a local minimum.\n\n![](images/f1/f10742ca92d2429c35b36cf77ae2d857774faba848a74291bbfa8e5ac71eeada.png)"}] [{:db/id 17592186434759 :knowledge-point/_questions [{:db/id 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "460f604f-6eba-581b-8aa6-3280b9015d1c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434674} {:answer/id #uuid "7f0c4c69-837b-5418-a6bb-d90c5580a6ec" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186434690} {:answer/id #uuid "9816a77e-1d49-560e-9a4c-556c4c10f9ce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186434698} {:answer/id #uuid "bfc20f8e-f720-5b88-9095-6a5461738176" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434714} {:answer/id #uuid "f97cb8b8-e7b8-52f5-8999-c6136c919582" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434732}] :answer-field/correct {:answer/id #uuid "bfc20f8e-f720-5b88-9095-6a5461738176" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434714} :answer-field/id #uuid "873bc5fc-9412-54c7-80ae-349f7825de0a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434743}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a6771fc8-6834-5ff6-940e-46f1464b61f6" :question/math-academy-id "q-163778" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{2}$ is given by\n\n$$\nf(x)≈-1+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=[\\begin{aligned}1 & -1 \\\\ -1 & 5\\end{aligned}].\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=1$ and $det(A)=4$\n\nII. $A$ is positive-definite\n\nIII. $a$ is a local maximum of $f$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, let's recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, ${a}_{11}=1$ and\n\n$$\ndet(A)=|\\begin{aligned}1 & -1 \\\\ -1 & 5\\end{aligned}|=4.\n$$\n\n- Statement II is true. Notice that\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=1>0, \\\\ {Δ}_{2} & =|\\begin{aligned}1 & -1 \\\\ -1 & 5\\end{aligned}|=4>0.\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is positive-definite.\n\n- Statement III is false. Since the matrix $A$ is positive-definite, the critical point $a$ is a local minimum of $f.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186434763 :knowledge-point/_questions [{:db/id 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "479b6949-d768-5a91-943c-b362a5bb5ece" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186434675} {:answer/id #uuid "8c979729-0c50-52fc-93ef-b13c63005c88" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186434695} {:answer/id #uuid "9e9c4318-1e04-56fd-b1b0-d959a8de76d3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$ only" :db/id 17592186434702} {:answer/id #uuid "9f9af5d3-d4aa-5e2f-8e3a-f1745f0df43d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $C,$ and $D$ only" :db/id 17592186434703} {:answer/id #uuid "b5f6e322-f58a-582d-ac9a-02e88741ca94" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186434711}] :answer-field/correct {:answer/id #uuid "479b6949-d768-5a91-943c-b362a5bb5ece" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186434675} :answer-field/id #uuid "ddd2fb64-7d5d-5d61-9a82-d15eb97782df" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434750}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e433d738-c2a7-5a16-852b-741bb762e1fe" :question/math-academy-id "q-164101" :question/problem "![](images/f4/f4ca398cfb365346962fc66ffecd7fb85390a9a98c49cb1926f6d8093a01c8bc.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local minimum points?" :question/worked-solution "A function $f(x,y)$ has a local minimum point at $(a,b)$ if $f(x,y)\\ge f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the lowest point on the graph in the neighborhood.\n\nSuch neighborhoods exist for the points $A$ and $C.$ Hence, $A$ and $C$ are local minima.\n\n![](images/02/0262a775dad79697ea888b6047e607c12ec804dbb734b72b2ca8fda54d6c130f.png)"}] [{:db/id 17592186434764 :knowledge-point/_questions [{:db/id 17592186124570 :knowledge-point/id #uuid "40d58ee6-1121-5ddc-a96f-1a7fa7a193dd" :knowledge-point/title "Classifying Local Extrema Using Sylvester's Criterion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b15bd6b-53d9-5f2c-a622-474fbfa83e12" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186434661} {:answer/id #uuid "a7339b2b-0cd2-58b2-bb3e-d169ebbe1f97" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186434706} {:answer/id #uuid "b6d79cac-7978-5207-995a-d295dee5e728" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186434712} {:answer/id #uuid "c1745eb2-62cc-52f0-8eb2-e37d4282fc2d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186434715} {:answer/id #uuid "f3ed4b64-e1dd-5cfc-b0b1-4c2ef452329a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186434730}] :answer-field/correct {:answer/id #uuid "f3ed4b64-e1dd-5cfc-b0b1-4c2ef452329a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186434730} :answer-field/id #uuid "87f2c732-43a9-5f28-96fb-2493dab452dc" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434744}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e5518b1c-8ee2-55b4-900e-3e5d5d3b8c0e" :question/math-academy-id "q-163788" :question/problem "The quadratic Taylor approximation of the function $f(x)$ about $x=a\\in {R}^{3}$ is given by\n\n$$\nf(x)≈1+\\frac{1}{2}(x-a)^{T}A(x-a),\n$$\n\nwhere \n\n$$\nA=[\\begin{aligned}-1 & 4 & 2 \\\\ 4 & 3 & 0 \\\\ 2 & 0 & 1\\end{aligned}].\n$$\n\n \n\nWhich of the following statements are true?\n\nI. ${a}_{11}=-1$ and $det(A)=-15$\n\nII. $A$ is negative-definite\n\nIII. $a$ is a local minimum of $f$" :question/worked-solution "The point $a\\in {R}^{n}$ is a critical point of the function $f:{R}^{n}\\to R$ if ${f}^{′}(a)={0}^{T}.$ In such cases, we can classify $a$ as follows:\n\n- if ${f}^{″}(a)$ is positive definite, then $a$ is a local minimum\n\n- if ${f}^{″}(a)$ is negative definite, then $a$ is a local maximum\n\n- if ${f}^{″}(a)$ is neither positive-definite nor negative-definite, then $a$ is a saddle point\n\nIn this case, we have $A={f}^{″}(a).$ Now, before we examine the statements, we recall how to categorize quadratic forms.\n\nLet ${Δ}_{i}$ for $i=1,2,…,n$  denote the leading principal minors of an $n\\times n$ matrix $A.$ Then, according to Sylvester's criterion, the quadratic form ${x}^{T}\\,A\\,x$ (as well as the matrix $A$) is \n\n- positive-definite if and only if ${Δ}_{i}>0$ for all $i=1,2,…,n,$\n\n- negative-definite if and only if, for all $i=1,2,…,n,$ we have ${Δ}_{i}<0$ when $i$ is odd, and ${Δ}_{i}>0$ when $i$ is even.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Indeed, ${a}_{11}=-1,$ but\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}-1 & 4 & 2 \\\\ 4 & 3 & 0 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =-1\\cdot |\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}|-4\\cdot |\\begin{aligned}4 & 0 \\\\ 2 & 1\\end{aligned}|+2\\cdot |\\begin{aligned}4 & 3 \\\\ 2 & 0\\end{aligned}| \\\\  & =-1(3)-4(4)+2(-6) \\\\  & =-31.\\end{aligned}\n$$\n\n- Statement II is false. Notice the following:\n\n$$\n\\begin{aligned}{Δ}_{1} & ={a}_{11}=-1<0 \\\\ {Δ}_{2} & =|\\begin{aligned}-1 & 4 \\\\ 4 & 3\\end{aligned}|=-19<0 \\\\ {Δ}_{3} & =|A|=-31<0\\end{aligned}\n$$\n\nSo, by Sylvester's criterion, the matrix $A$ is neither positive-definite nor negative-definite.\n\n- Statement III is false. Since the matrix $A$ is neither positive-definite nor negative-definite, the critical point $a$ is a saddle point of $f.$\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id 17592186434765 :knowledge-point/_questions [{:db/id 17592186124647 :knowledge-point/id #uuid "f0fb118f-c1cc-51fd-a8cc-c29cf705acfe" :knowledge-point/title "Identifying the Local Extrema of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1effde-74f3-572c-895a-c689fd4d6886" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186434663} {:answer/id #uuid "8e775825-6245-5d2d-930c-aa1a6446fcc5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186434696} {:answer/id #uuid "d3fc7d81-3c2e-547e-b4b6-9d3a5644b96e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id 17592186434722} {:answer/id #uuid "e27f6f79-0b4c-502b-ae85-1bf343f859a8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id 17592186434724} {:answer/id #uuid "e36fc252-161e-5249-b04c-21f5ae164898" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186434725}] :answer-field/correct {:answer/id #uuid "e36fc252-161e-5249-b04c-21f5ae164898" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186434725} :answer-field/id #uuid "4706282d-9a32-5f14-a57a-fcb85720d9bf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186434738}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e9cc186b-22af-55d8-bf89-1dd19ae7b90f" :question/math-academy-id "q-164154" :question/problem "![](images/81/81604581fae8b25776727eca4450caa7d48c42a781706455ed585d5cfc4a25fa.png)\n\nThe graph of the function $z=f(x,y)$ is shown above. Which of the points shown are local maximum points?" :question/worked-solution "A function $f(x,y)$ has a local maximum point at $(a,b)$ if $f(x,y)\\le f(a,b)$ for all points $(x,y)$ in a neighborhood of $(a,b).$ \n\nIn other words, we can take a neighborhood of $(x,y)$-values such that the point $(x,y,f(x,y))$ is the highest point on the graph in the neighborhood.\n\nSuch regions exist for the points $A$ and $C.$ Hence $A$ and $C$ are local maximum points.\n\n**Note**: For the point $A({x}_{A},{y}_{A},{z}_{A}),$ there are points $(x,y)$ in the surrounding regions such that $f({x}_{A},{y}_{A})=f(x,y).$ However, since the definition of local extrema is non-strict, $f(x,y)\\le f(a,b)$, the point $A$ does satisfy the conditions for a local maximum.\n\n![](images/36/3651b43178819666002775a26071a0bd2c9cb48b58a3c5516c38e085d50fc4a6.png)"}] [{:db/id 17592186435053 :knowledge-point/_questions [{:db/id 17592186092327 :knowledge-point/id #uuid "4eab94cb-5a5a-5915-ab95-963cb4c63817" :knowledge-point/title "Identifying Closure Properties of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22efd206-8495-5c5b-82c3-8b22f6169935" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435028} {:answer/id #uuid "5f573ec0-e420-5d5a-bf15-12b9f19228c1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186435033} {:answer/id #uuid "972d63cb-deb1-504d-983c-3afd89efb163" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435037} {:answer/id #uuid "db22347e-ef69-54bb-bdf3-e3c186808327" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435041} {:answer/id #uuid "e1cafff7-1db2-590c-918b-31d40bb1ec62" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435043}] :answer-field/correct {:answer/id #uuid "22efd206-8495-5c5b-82c3-8b22f6169935" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435028} :answer-field/id #uuid "3642f741-bfcb-537b-8055-8377c2f4a23c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435047}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "17b4b8a5-2a1a-5b8f-9d66-afed9881e7a3" :question/math-academy-id "q-141235" :question/problem "Which of the following expressions are polynomials?\n\nI. $(6-{x}^{3})-({x}^{2}+4)$\n\nII. $(3{x}^{3}+x)\\cdot (2{x}^{4}+4)$\n\nIII. $(1-3{x}^{3})÷(3x)$" :question/worked-solution "Recall that polynomials have the following closure properties:\n\n- Polynomials are closed under addition, subtraction, and multiplication. This means that the sum, difference, and product of two polynomials is *always* a polynomial.\n\n- Polynomials are *not* closed under division. This means that the quotient of two polynomials is *not* always a polynomial.\n\nWith that in mind, let's examine our expressions in turn.\n\n- Expression I is a polynomial. It's a difference between two polynomials, and polynomials are closed under subtraction.\n\n- Expression II gives a polynomial. It's a product of two polynomials, and polynomials are closed under multiplication.\n\n- Expression III is *not* a polynomial. Carrying out the division, we get\n\n$$\n\\begin{aligned}\\frac{1-3{x}^{3}}{3x} & =\\frac{1}{3x}-\\frac{3{x}^{3}}{3x} \\\\  & =\\frac{1}{3x}-{x}^{2}\\end{aligned}\n$$\n\nwhich is *not* a polynomial.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186435504 :knowledge-point/_questions [{:db/id 17592186172005 :knowledge-point/id #uuid "747b25be-ff4e-5b1e-abcc-5edd1edd9790" :knowledge-point/title "Identifying Situations That Can Be Modeled Using an Exponential Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c836109-2926-5149-86de-cfbf47a6956c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435483} {:answer/id #uuid "30f9ac07-0f6b-5c34-a6ab-9f12e00a0258" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186435484} {:answer/id #uuid "34ee353c-18cb-58d7-b73d-63478f3748f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435485} {:answer/id #uuid "8214dd72-d6d8-590d-81b7-fddc4ba96e98" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435489} {:answer/id #uuid "fa30ad19-820a-5c33-a201-b90a4102fe1c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186435493}] :answer-field/correct {:answer/id #uuid "8214dd72-d6d8-590d-81b7-fddc4ba96e98" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435489} :answer-field/id #uuid "4f620f94-aa7b-56b8-b107-dbbda4003603" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435497}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e53ee3ed-f667-5b74-b94f-f7c404a83247" :question/math-academy-id "q-96677" :question/problem "Which of the following random variables could be modeled by an exponential distribution?\n\nI. The execution time, in seconds, of a computer program\n\nII. The number of students in a class with blood type $A$\n\nIII. The number of books read by a student in a month" :question/worked-solution "The exponential distribution can be thought of as the continuous analog of the geometric distribution. It models the amount of continuous time or space until a particular event occurs, where the events should occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I could be modeled using an exponential distribution. Executions of a computer program can be modeled as independent events with a constant average rate, and we wish to know the amount of time it takes to complete a single execution.\n\n- Random variable II does *not* follow an exponential distribution. There are no events that occur at a constant average rate, and there is no interval of continuous time or space. The number of students is discrete, not continuous.\n\n- Random variable III does *not* follow an exponential distribution. There is no interval of continuous time or space. The number of books is discrete, not continuous.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186435511 :knowledge-point/_questions [{:db/id 17592186124635 :knowledge-point/id #uuid "b34c9c06-e884-5758-a184-39330a07d8cd" :knowledge-point/title "Identifying Interior and Boundary Points of Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d294d7-e90d-595c-8fa7-6170debebbf7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186435505} {:answer/id #uuid "519adb21-ac16-5108-9bc4-9df2a4611d46" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435506} {:answer/id #uuid "5629f73f-1165-5287-a036-29dde44376aa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186435507} {:answer/id #uuid "a0ee6fb8-0275-543e-9a03-ba5f9eb26748" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435508} {:answer/id #uuid "af171406-b374-5cc4-8490-0e1a9e1865ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435509}] :answer-field/correct {:answer/id #uuid "18d294d7-e90d-595c-8fa7-6170debebbf7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186435505} :answer-field/id #uuid "e0d75057-311d-52aa-8f97-e8208efd3230" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435510}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4212543c-3dc3-579d-b570-8f3b6f775fcc" :question/math-academy-id "q-159276" :question/problem "![](images/7c/7cb1268b1007611ba22364c23439e329f33d806a585bffb497b40a0c1e5f316e.png)\n\nConsider the set $M=(-2,1)\\cup (1,3)$ and the points $A,$ $B,$ and $C,$ shown above. Which of the following statements are true?\n\nI. $A$ is a boundary point of the set $M$\n\nII. $B$ is a boundary point of the set $M$\n\nIII. $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}\\in R$ is the set of points whose distance from ${x}_{0}$ is *smaller than* $\\delta :$ \n\n$$\n\\{x:|x-{x}_{0}|<\\delta \\}\n$$\n\nA neighborhood of ${x}_{0}$ is given by the open interval $({x}_{0}-\\delta ,{x}_{0}+\\delta ),$ shown below.\n\n![](images/f8/f889352f25e7936d0e5ea76585a979efbb301da61f7e99a937e979af93ee0664.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. The point $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n![](images/bb/bb77fe9590ad2dfd4ff0259da48765eb3539e58590f585f4530d121aea1553ee.png)\n\n- Statement II is true. The point $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$ Notice that $B$ does not belong to $M$ and $B$ belongs to any open neighborhood of $B.$\n\n![](images/1d/1dc73455fa8f3a82dded795ccb1e375fe32765f2279a654f1694e8b4cb5aed7f.png)\n\n- Statement III is true. The point $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\n![](images/4f/4f9ed1e3fa6b3232cb8f37d756e11034563722080e769b351d0e4ebeb0c4ecc3.png)\n\nTherefore, the correct answer is 'I, II, and III.'"}] [{:db/id 17592186435718 :knowledge-point/_questions [{:db/id 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0155fefb-60d8-5dc5-9cb9-bfd9b44bc962" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435687} {:answer/id #uuid "04294cfb-cb8e-5e85-95b0-be9065b6019e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435688} {:answer/id #uuid "09521a1d-0037-59a4-b1e8-2b8b60a1d4de" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435689} {:answer/id #uuid "23ab143c-f45b-5e8a-9480-58f173ceacfb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435691} {:answer/id #uuid "99560652-fff1-54b3-ba9f-a43662eb6810" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435698}] :answer-field/correct {:answer/id #uuid "99560652-fff1-54b3-ba9f-a43662eb6810" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435698} :answer-field/id #uuid "c7ff387b-156b-5349-95c8-a5ca6f287ec2" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435713}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d091e55-28a6-57e1-bec5-20aeba4179e3" :question/math-academy-id "q-343770" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\nII. $y=R\\operatorname{sin}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\nIII. $y=A\\operatorname{cos}⁡(5t)+B\\operatorname{sin}⁡(5t)+\\frac{1}{5}t\\operatorname{cos}⁡(5t)$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t),$ which is sinusoidal with frequency $5.$ Therefore,\n$\\omega =5.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(5t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(5t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(5t)+B\\operatorname{sin}⁡(5t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(5t)+D\\operatorname{sin}⁡(5t)).\n$$\n\nBy substituting the particular solution and $\\omega =5$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(10D-25Ct)\\operatorname{cos}⁡(5t)-(10C+25Dt)\\operatorname{sin}⁡(5t)]+25t(C\\operatorname{cos}⁡(5t)+D\\operatorname{sin}⁡(5t)) & =2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t) \\\\ 10D\\operatorname{cos}⁡(5t)-10C\\operatorname{sin}⁡(5t) & =2\\operatorname{cos}⁡(5t)-8\\operatorname{sin}⁡(5t)\\end{aligned}\n$$\n\nEquating coefficients, $C=\\frac{4}{5}$ and $D=\\frac{1}{5}.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\n2\\. $y=R\\operatorname{sin}⁡(5t+ϕ)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\n3\\. $y=A\\operatorname{cos}⁡(5t)+B\\operatorname{sin}⁡(5t)+\\frac{4}{5}t\\operatorname{cos}⁡(5t)+\\frac{1}{5}t\\operatorname{sin}⁡(5t)$\n\nOnly solutions I and II match the forms above.\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186435720 :knowledge-point/_questions [{:db/id 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10aed726-550b-5773-a3d2-e5a9aa903d37" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435690} {:answer/id #uuid "4d110980-6336-5008-851d-def1533281f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435693} {:answer/id #uuid "a5e9b00f-40af-5825-adee-8c54397db1e6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435701} {:answer/id #uuid "db35a078-4935-5f77-a6a9-0351366c7e6c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435706} {:answer/id #uuid "de6388db-1542-562e-add4-ec8a83242db4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435707}] :answer-field/correct {:answer/id #uuid "4d110980-6336-5008-851d-def1533281f1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435693} :answer-field/id #uuid "4c3d996d-7bb1-5375-bb04-132c705fc32a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435709}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5e9f5eb-87cf-56db-acd3-a7af3f0549dd" :question/math-academy-id "q-343755" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=-7\\operatorname{sin}⁡(2t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\nII. $y=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{sin}⁡(2t)$\n\nIII. $y=A\\operatorname{cos}⁡(2t)+B\\operatorname{sin}⁡(2t)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=-7\\operatorname{sin}⁡(2t),$ which is sinusoidal with frequency $2.$ Therefore,\n$\\omega =2.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(2t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(2t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(2t)+B\\operatorname{sin}⁡(2t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(2t)+D\\operatorname{sin}⁡(2t)).\n$$\n\nBy substituting the particular solution and $\\omega =2$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[4(D-Ct)\\operatorname{cos}⁡(2t)-4(C+Dt)\\operatorname{sin}⁡(2t)]+4t(C\\operatorname{cos}⁡(2t)+D\\operatorname{sin}⁡(2t)) & =-7\\operatorname{sin}⁡(2t) \\\\ 4D\\operatorname{cos}⁡(2t)-4C\\operatorname{sin}⁡(2t) & =-7\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nEquating coefficients, $C=\\frac{7}{4}$ and $D=0.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{7}{4}t\\operatorname{cos}⁡(2t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\n2\\. $y=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\n3\\. $y=A\\operatorname{cos}⁡(2t)+B\\operatorname{sin}⁡(2t)+\\frac{7}{4}t\\operatorname{cos}⁡(2t)$\n\nOnly solutions I and III match the forms above.\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id 17592186435739 :knowledge-point/_questions [{:db/id 17592186192767 :knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf" :knowledge-point/title "Identifying Open and Closed Sets in the Plane in Set Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d38a336-527b-57b5-984e-edfc2714a948" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435723} {:answer/id #uuid "596ac92d-b0b2-508d-8d21-57fdf30094ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435725} {:answer/id #uuid "7a873c8b-abd6-5688-a8dc-2234e4f321c4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435729} {:answer/id #uuid "b92f330b-d989-5fa6-a357-1f8fb2911ce0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435733} {:answer/id #uuid "d390df63-e312-58d7-be1f-9359c50c2171" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435734}] :answer-field/correct {:answer/id #uuid "7a873c8b-abd6-5688-a8dc-2234e4f321c4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435729} :answer-field/id #uuid "31c038cd-735d-510d-a7a3-1258bc6d67c1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435737}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c87d140-5d2b-5665-af2c-c72dc631274f" :question/math-academy-id "q-161645" :question/problem "Which of the following sets are open?\n\nI. $\\{(x,y)\\in {R}^{2}:\\text{ }2\\le x\\le 3,\\,1\\le y\\le x\\}$\n\nII. $\\{(x,y)\\in {R}^{2}:\\text{ }1\\le {x}^{2}\\le 4,\\,1\\le y\\le 2\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}:\\text{ }5{x}^{2}+{y}^{2}<2\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The second set is *closed* since it contains all of its boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186435740 :knowledge-point/_questions [{:db/id 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b3a28a7-db62-54d0-8848-7f19acce1e74" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435722} {:answer/id #uuid "65704a7a-2030-535c-bb94-40e558216784" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435726} {:answer/id #uuid "6ad327fa-a1c7-5cf8-8a45-dc4ef99e7f5d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186435727} {:answer/id #uuid "8c6c9ea9-0ab4-54a4-a639-0e3b08b6f854" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435732} {:answer/id #uuid "fc598b98-f11a-5076-b086-fccdf3310acb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435735}] :answer-field/correct {:answer/id #uuid "8c6c9ea9-0ab4-54a4-a639-0e3b08b6f854" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186435732} :answer-field/id #uuid "c0de52cf-b0a6-5bc0-8988-4eb1810865de" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435738}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f5bd7aa-b6dd-5eb5-9622-6b7733243884" :question/math-academy-id "q-71822" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,x<y<{x}^{2},\\,1<x<3\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,0<x<1,\\,0<y<1\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,2\\le x\\le 4,\\,0<y\\le \\sqrt{x}\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is also *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(4,2).$ On the other hand, it does not contain some other boundary points, for example, the point $(4,0).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186435741 :knowledge-point/_questions [{:db/id 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02a4abbd-7358-56af-9fd9-2f9cd7177997" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435721} {:answer/id #uuid "3f9d4873-5e5e-5f8d-9aa2-3e6342f8b70c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435724} {:answer/id #uuid "7697f98c-b2dc-5cc3-b6f7-6715f2aa98cf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186435728} {:answer/id #uuid "84ba645f-39b6-5c19-9858-4883847b6c4b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435730} {:answer/id #uuid "8c35f484-32c4-565e-9dd0-3440a9a8a6fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id 17592186435731}] :answer-field/correct {:answer/id #uuid "84ba645f-39b6-5c19-9858-4883847b6c4b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435730} :answer-field/id #uuid "2e00d1b5-2e37-555b-b335-0db69595c37f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435736}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70cc1cfd-d67c-5b9a-8b8d-7544becf0a25" :question/math-academy-id "q-105193" :question/problem "Which of the following sets are closed?\n\nI. $[3,6]$\n\nII. $[-5,0]$\n\nIII. $[-1,1)\\cup (3,4]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[3,6]$ and $[-5,0]$ are closed because:\n\n- The boundary points of $[3,6]$ are $3$, and $6.$ Both of them lie in the set.\n\n- The boundary points of $[-5,0]$ are $-5$, and $0.$ Both of them lie in the set.\n\nThe other set is not closed because $[-1,1)\\cup (3,4]$ has the boundary points $1$  and $3,$ which don't lie in the set.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186435929 :knowledge-point/_questions [{:db/id 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ecaf329-877a-5184-b3cf-13e81c99934a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186435905} {:answer/id #uuid "6bdcc3ed-d3b8-5907-ba40-01803c02c9cb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186435907} {:answer/id #uuid "73df3086-3d04-5a6a-abd1-f9c01e475b78" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186435908} {:answer/id #uuid "c250bb51-b7ca-503c-842d-002259888993" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186435912} {:answer/id #uuid "ccc703f5-adf8-5933-89b8-12fe5ea4b4ee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186435914}] :answer-field/correct {:answer/id #uuid "5ecaf329-877a-5184-b3cf-13e81c99934a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186435905} :answer-field/id #uuid "eb49e450-3c82-56fd-b065-47510e61dd32" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186435927}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "751ef612-b871-5a13-b5db-9f9345197dd4" :question/math-academy-id "q-80813" :question/problem "Which of the following are subsets of ${Q}_{0}^{+}$ (the set of non-negative rational numbers)?\n\nI. ${Z}^{-}$ (the set of negative integers)\n\nII. $N$\n\nIII. ${Z}_{0}^{+}$ (the set of non-negative integers)" :question/worked-solution "$A$ is a subset of $B$ if every element of $A$ is an element of $B.$\n\nWith that in mind, let's inspect the given choices.\n\n- ${Z}^{-}$ is not a subset of ${Q}_{0}^{+}.$ For example, $-1\\in {Z}^{-}$ but $-1\\notin {Q}_{0}^{+}.$\n\n- $N$ is a subset of ${Q}^{+}.$ Indeed, every natural number is also a positive rational number.\n\n- ${Z}_{0}^{+}$ is a subset of ${Q}_{0}^{+}.$ Indeed, every positive integer is also a positive rational number. Notice also that  $0$ is in both  ${Z}_{0}^{+}$ and ${Q}_{0}^{+}.$\n\nTherefore, the correct answer is \"II and III  only\"."}] [{:db/id 17592186436042 :knowledge-point/_questions [{:db/id 17592186152199 :knowledge-point/id #uuid "624215ff-efdc-5b12-8d61-9d66371672d9" :knowledge-point/title "Determining a Valid Region to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "396e3f27-e24a-553a-9d76-87b06e254ca7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186436030} {:answer/id #uuid "4facf5d2-11cf-5ead-aac1-8f2480139664" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186436031} {:answer/id #uuid "ae28b501-c23e-599b-8e7e-1db8502ac7b0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186436034} {:answer/id #uuid "cf5cd3c6-1bfc-586c-9f3c-4788cef42fad" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186436035} {:answer/id #uuid "d970f7e7-4967-5568-882e-bad44890c0c5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186436037}] :answer-field/correct {:answer/id #uuid "ae28b501-c23e-599b-8e7e-1db8502ac7b0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186436034} :answer-field/id #uuid "ee7f980b-3738-5f95-89d8-bd69eb485ba5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186436041}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34094a62-379f-5750-81e2-774654924818" :question/math-academy-id "q-80505" :question/problem "Let $D$ be a finite region enclosed by the curve ${x}^{2}+{y}^{2}=1.$ If \n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\\,\\text{and}\\,{∬}_{D}\\operatorname{sin}⁡(x+y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of the rectangular domain $R?$\n\nI. $R=[-1,1]\\times [-1,1]$\n\nII. $R=[-1,1]\\times [0,1]$\n\nIII. $R=[-2,2]\\times [-2,2]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/c5/c50e0e01d432b1db736fad09dd5f5b82286e981d88586e848d9b57c8a9910eb0.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}\\operatorname{sin}⁡(x+y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}\\operatorname{sin}⁡(x+y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given rectangles.\n\n- Rectangle II does not cover the region $D.$\n\n- Rectangles I and III covers the region $D$ completely.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186436043 :knowledge-point/_questions [{:db/id 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5932c78c-b217-563b-a6a6-20d7e590fa51" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186436032} {:answer/id #uuid "6b2be67b-0fbe-5c0e-9a6c-695744bdced7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186436033} {:answer/id #uuid "d22715d7-9b30-5b4e-992d-a26755e9bfa5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186436036} {:answer/id #uuid "f20bd2cc-e250-5b0f-8550-2d109881dffa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186436038} {:answer/id #uuid "f4c01149-e6b5-5a05-a88f-4203104561a0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186436039}] :answer-field/correct {:answer/id #uuid "5932c78c-b217-563b-a6a6-20d7e590fa51" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186436032} :answer-field/id #uuid "3db2d41e-f30d-5228-a8d5-a3f179326943" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186436040}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7e910b3-a1a9-5ea8-8009-6cb31a154137" :question/math-academy-id "q-86864" :question/problem "![](images/bb/bbc1bc7b3bb910ffbd13571283bbfa305404d13eb2cb3b5ab423a1c02e46ab86.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}y({x}^{2}-{y}^{2}) & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true? \n\nI. ${∬}_{R}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [0,2]$\n\nII. ${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,2]$\n\nIII. ${∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,2]\\times [-2,2]$" :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}y({x}^{2}-{y}^{2}), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}y({x}^{2}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186436527 :knowledge-point/_questions [{:db/id 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3156da43-688a-5c56-bb8a-3fd05e02f8ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id 17592186436482} {:answer/id #uuid "5ca02a73-7d89-56f2-b95b-c2a98081117a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$E$ only" :db/id 17592186436486} {:answer/id #uuid "781bf9fc-c8ed-589b-bc49-9fe5c4bb51ee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $E$ only" :db/id 17592186436492} {:answer/id #uuid "c42dc014-434e-5a33-be09-1ba19122dbc9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ only" :db/id 17592186436507} {:answer/id #uuid "c82ee549-4efd-554c-bd79-6314d62f5a3e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$E$ and $F$ only" :db/id 17592186436509}] :answer-field/correct {:answer/id #uuid "5ca02a73-7d89-56f2-b95b-c2a98081117a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$E$ only" :db/id 17592186436486} :answer-field/id #uuid "2a39083d-7da8-5ae0-912f-f708e52fb22e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186436520}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "73b54284-6d5f-5b76-a388-21fc0778bb8a" :question/math-academy-id "q-31889" :question/problem "Which of the following are elementary matrices?\n\n$$\nD=[\\begin{aligned}1 & 0 \\\\ 2 & 2\\end{aligned}],\\,E=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}],\\,F=[\\begin{aligned}1 & 1 \\\\ 1 & 1\\end{aligned}]\n$$" :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrix $D$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\n- The matrix $E$ is an elementary matrix because it can be obtained from ${I}_{2}$ by applying the elementary row operation ${R}_{2}:={R}_{2}+2{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}{I}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] &  & {R}_{2}:={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & =E\\end{aligned}\n$$\n\n- The matrix $F$ is not an elementary matrix because it can't be obtained from ${I}_{2}$ by applying only one elementary row operation.\n\nTherefore, only $E$ is an elementary matrix."}] [{:db/id 17592186436529 :knowledge-point/_questions [{:db/id 17592186115243 :knowledge-point/id #uuid "853a04b2-591a-51c2-b80f-73f559355d9f" :knowledge-point/title "Identifying an Elementary 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081decf6-8b8b-5b4e-bc55-884af37deef0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186436474} {:answer/id #uuid "58355426-69d0-55ca-a705-4a9d72d17bb3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$N$ only" :db/id 17592186436485} {:answer/id #uuid "609661d9-134c-5281-8a45-969f241f92a3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id 17592186436487} {:answer/id #uuid "7863b914-5ce1-519d-8bdf-4c54739802f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$N$ and $P$ only" :db/id 17592186436493} {:answer/id #uuid "ac101c56-0025-5f6a-8d22-f432ce4b5ce6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$M$ and $N$ only" :db/id 17592186436501}] :answer-field/correct {:answer/id #uuid "081decf6-8b8b-5b4e-bc55-884af37deef0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186436474} :answer-field/id #uuid "264fcad2-6268-5a65-8231-2261fb99ed94" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186436519}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb398bcb-fa77-5232-9d5f-318cb8cb3320" :question/math-academy-id "q-42704" :question/problem "Which of the following are elementary matrices?\n\n$$\nM=[\\begin{aligned}1 & 1 \\\\ 0 & -1\\end{aligned}],\\,N=[\\begin{aligned}0 & 5 \\\\ 1 & 0\\end{aligned}],\\,P=[\\begin{aligned}0 & -2 \\\\ 4 & 0\\end{aligned}]\n$$" :question/worked-solution "An elementary matrix is a matrix obtained from the identity matrix by applying exactly one elementary row operation. \n\nWith that in mind, let's examine our matrices.\n\n- The matrices $M$, $N$ and $P$ are not elementary matrices because they can't be obtained from ${I}_{2}$ by applying only one elementary row operation."}] [{:db/id 17592186437047 :knowledge-point/_questions [{:db/id 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0981e6ac-4ea9-5b5f-9a0c-37357f6571a1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186437023} {:answer/id #uuid "2c8ce4d4-7bed-5361-8e9a-9415fd68b129" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id 17592186437027} {:answer/id #uuid "775d6ef0-228c-5113-ab3f-a4e3a0681394" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id 17592186437033} {:answer/id #uuid "84858ef9-39d6-5806-bd8a-8c7c290606c6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186437034} {:answer/id #uuid "eb7870a7-fdad-5952-b348-cfbd9d0bd867" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186437041}] :answer-field/correct {:answer/id #uuid "2c8ce4d4-7bed-5361-8e9a-9415fd68b129" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id 17592186437027} :answer-field/id #uuid "5d65f4ea-621a-59f2-9afa-11317c961e8d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186437043}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f239bc7-130a-57fa-a436-9569195dcc53" :question/math-academy-id "q-43500" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 3 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{3}:={R}_{3}+(-4){R}_{1},$ as follows: \n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -4 & 0 & 1\\end{aligned}] \\\\  & =A\\end{aligned}\n$$\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}:={R}_{1}+6{R}_{3},$ as follows: \n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+6{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 6 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\nTherefore, only $A$ and $B$ are elementary matrices."}] [{:db/id 17592186437202 :knowledge-point/_questions [{:db/id 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "081dbeb3-4d4a-5422-ba94-6aef4f52ff6e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id 17592186437152} {:answer/id #uuid "08e9c5a7-f253-5641-b722-3d928077ea02" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186437153} {:answer/id #uuid "b87d115b-57ad-5812-b19a-156e2c951336" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id 17592186437180} {:answer/id #uuid "cb4424b9-b917-5691-9eb7-6dd1a0ede451" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186437183} {:answer/id #uuid "f3fb3e95-4ceb-54a6-bb4d-5443be5d5cc3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186437190}] :answer-field/correct {:answer/id #uuid "cb4424b9-b917-5691-9eb7-6dd1a0ede451" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186437183} :answer-field/id #uuid "53e599bf-ab7b-5151-8d3d-51954f058d22" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186437194}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "67c5f653-7d0a-53ab-94d3-ce3b203a88ad" :question/math-academy-id "q-78776" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{1}:=\\frac{1}{3}{R}_{1}\\,$ and $\\,{R}_{2}:={R}_{2}+3{R}_{1}?$\n\n$$\nA=[\\begin{aligned}3 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}3 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}3 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ -3 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ B & =[\\begin{aligned}3 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ C & =[\\begin{aligned}3 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ -3 & 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id 17592186440655 :knowledge-point/_questions [{:db/id 17592186124628 :knowledge-point/id #uuid "cb02b67c-90d9-5baf-b00e-590e9271d89e" :knowledge-point/title "Identifying Sets Closed Under Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25b7f412-8325-5a8d-8ec0-efdd1fcf99b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186440638} {:answer/id #uuid "54c85eef-42f1-5a34-b835-c200174ad259" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186440639} {:answer/id #uuid "957c96fc-b399-5084-82f0-23bab95940c6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186440642} {:answer/id #uuid "9f8780bf-4b01-52e4-a8c3-5d2fd02f1d5f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186440643} {:answer/id #uuid "ae42fca6-e22f-5cdd-ab0e-b0f6c6d5db30" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186440645}] :answer-field/correct {:answer/id #uuid "54c85eef-42f1-5a34-b835-c200174ad259" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186440639} :answer-field/id #uuid "c5e550c1-c444-5056-9fdd-7c27dc6bda79" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186440652}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3d7a176-49a0-5f40-a976-fffa17513013" :question/math-academy-id "q-141158" :question/problem "Let $T$ be the set of all $2\\times 2$ real matrices $A=({a}_{ij})$ such that ${a}_{11}{a}_{21}+{a}_{12}{a}_{22}>0.$ Which of the following statements are true? \n\nI. The identity matrix ${I}_{2}$ belongs to $T.$\n\nII. For every $A\\in T$ and $\\alpha \\in R,$ we have $\\alpha \\cdot A\\in T.$\n\nIII. The set is closed under scalar multiplication." :question/worked-solution "Let's verify the statements one at a time.\n\n- Statement I is false. The set $T$ contains only matrices $A=({a}_{ij})$ such that ${a}_{11}{a}_{21}+{a}_{12}{a}_{22}>0.$ However, for the identity matrix ${I}_{2}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}],$ we have ${a}_{11}{a}_{21}+{a}_{12}{a}_{22}=1\\cdot 0+0\\cdot 1=0≯0.$ So, ${I}_{2}\\notin T.$\n\n- Statement II is false. For example, let $\\alpha =0\\in R$ and $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]\\in T.$ Then, \n\n$$\n\\alpha \\cdot A=0\\cdot A=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}],\n$$\n\nwhere the sum of the products of columns' entries is $0\\cdot 0+0\\cdot 0=0≯0.$ Hence, $0\\cdot A\\notin T.$\n\n- Statement III is false. Since statement II is false, the set is not closed under scalar multiplication.\n\nTherefore, the correct answer is \"None of the statements are true.\""}]] "items" [] "response_users" [] "field_owners" [[17592186053577 17592186055390] [17592186113971 17592186115839] [17592186114667 17592186115955] [17592186121451 17592186124809] [17592186121778 17592186124863] [17592186122684 17592186125014] [17592186133392 17592186134559] [17592186133446 17592186134568] [17592186144560 17592186147801] [17592186146978 17592186148204] [17592186149249 17592186152453] [17592186149261 17592186152455] [17592186149556 17592186152500] [17592186151031 17592186152754] [17592186160970 17592186162613] [17592186166286 17592186167513] [17592186166304 17592186167516] [17592186171237 17592186172602] [17592186171327 17592186172617] [17592186171477 17592186172642] [17592186177855 17592186180031] [17592186191859 17592186193322] [17592186194892 17592186198711] [17592186194952 17592186198721] [17592186196290 17592186198859] [17592186230296 17592186231571] [17592186237474 17592186237923] [17592186237498 17592186238006] [17592186237500 17592186237859] [17592186237501 17592186237921] [17592186237508 17592186237975] [17592186237511 17592186237977] [17592186237531 17592186237782] [17592186237543 17592186237976] [17592186237544 17592186237778] [17592186237549 17592186237978] [17592186237555 17592186237780] [17592