int/id #uuid "a25bce44-98ca-54c6-a59f-b7508880d5ba" :knowledge-point/title "Determining Whether a Number is Divisible by 4"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "482c5dae-4d41-560e-9cce-646d022e2981" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186424670} {:answer/id #uuid "819e1052-6513-50b0-bd5c-5e10197a5eaa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186424708} {:answer/id #uuid "83bf1713-3353-59a3-b698-75b1396a3acb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186424711} {:answer/id #uuid "a7e28211-0c01-504c-9700-eb6226c25b1d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186424730} {:answer/id #uuid "d8585b9e-3cc0-56bc-af72-b6f310e2d8f8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186424750}] :answer-field/correct {:answer/id #uuid "d8585b9e-3cc0-56bc-af72-b6f310e2d8f8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186424750} :answer-field/id #uuid "7c05dc84-ff51-5384-9b95-c62170ff697c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186424793}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef2c41de-4b26-57f5-bd27-cd0dbe211bfd" :question/math-academy-id "q-131860" :question/problem "Which digits, when inserted into the blank, make the number $123\\,321\\,87◻$ divisible by $4?$\n\nI. $2$\n\nII. $4$\n\nIII. $8$" :question/worked-solution "A number is divisible by $4$ if the last two digits form a number that is divisible by $4.$\n\nThe last two digits of the number $123\\,321\\,87◻$ are $7◻.$\n\n- If $2$ is substituted into the blank, then the last two digits are $72,$ which is indeed divisible by $4.$\n\n- If $4$ is substituted into the blank, then the last two digits are $74,$ which is *not* divisible by $4.$\n\n- If $8$ is substituted into the blank, then the last two digits are $78,$ which is *not* divisible by $4.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186424970 :knowledge-point/_questions [{:db/id 17592186054799 :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/title "Identifying Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "289c50a0-ecfe-528e-8457-52cef5a9eea4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186424911} {:answer/id #uuid "7272d0c8-fe13-518b-af81-9a1e813b6be8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186424932} {:answer/id #uuid "8f1f5ec0-d9fa-5898-9b3f-1ebb2130be4c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186424937} {:answer/id #uuid "955ea776-bc16-5188-8524-157fb43af2d2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186424942} {:answer/id #uuid "b1f9e24e-dfc8-5a77-9b26-fbd6711e1c48" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186424950}] :answer-field/correct {:answer/id #uuid "289c50a0-ecfe-528e-8457-52cef5a9eea4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186424911} :answer-field/id #uuid "50bb28dc-006d-5ba3-98e1-c12fc06a1219" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186424961}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "147ae71e-52b0-59f3-8a2a-188807117e2c" :question/math-academy-id "q-108357" :question/problem "Which of the following is a variable?\n\nI. $\\sqrt{z}-1$\n\nII. $z$\n\nIII. $z+y$" :question/worked-solution "Let's look at each one in turn.\n\nI. $\\sqrt{z}$ is an algebraic expression, not a variable.\n\nII. $z$ is a variable because it's a single letter by itself.\n\nIII. $z+y$ is an algebraic expression, not a variable.\n\nSo, only choice II represents a variable."}] [{:db/id 17592186424974 :knowledge-point/_questions [{:db/id 17592186054799 :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/title "Identifying Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "505ece9e-a5ef-578a-be92-4f69f32b6cfe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186424918} {:answer/id #uuid "64f332be-f274-514b-8d1f-83f313295249" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186424925} {:answer/id #uuid "9f70c11f-f8bd-536c-a5d9-da27cda9bb2a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186424943} {:answer/id #uuid "a1141eab-e9d2-5548-a6c0-249dc8245d68" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186424944} {:answer/id #uuid "e23e6fe6-4de8-542f-afe6-52ce57386dc8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186424954}] :answer-field/correct {:answer/id #uuid "64f332be-f274-514b-8d1f-83f313295249" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186424925} :answer-field/id #uuid "1afb55bb-836c-52b0-ba04-fd3682fee8e0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186424958}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bbee0aa-5b29-5213-8656-a4a447aaa279" :question/math-academy-id "q-75552" :question/problem "Which of the following is a variable?\n\nI. $3$\n\nII. $1-x$\n\nIII. $y$" :question/worked-solution "Let's look at each one in turn.\n\nI. $3$ is a number, not a variable.\n\nII. $1-x$ is an algebraic expression, not a variable.\n\nIII. $y$ is a variable because it's a single letter by itself.\n\nSo, only choice III represents a variable."}] [{:db/id 17592186424982 :knowledge-point/_questions [{:db/id 17592186054799 :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/title "Identifying Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3622b09b-43c3-5d05-9184-f46f70477b5e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186424913} {:answer/id #uuid "7a7c3416-56fb-5d34-b481-1dd537767d8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186424934} {:answer/id #uuid "921d1635-175b-5c66-8faa-a1e9dbacb3c3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186424941} {:answer/id #uuid "d77326ca-117e-5c7d-b4a1-2cb9be0a8dd4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186424953} {:answer/id #uuid "e368230c-168d-570d-baf9-74863f36f92e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186424955}] :answer-field/correct {:answer/id #uuid "7a7c3416-56fb-5d34-b481-1dd537767d8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186424934} :answer-field/id #uuid "0887f65c-0dd5-55aa-bf78-6b0ddabfdff0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186424957}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fab7b2b9-4fb5-56fc-9278-9df96447599b" :question/math-academy-id "q-75553" :question/problem "Which of the following is a variable?\n\nI. $b$\n\nII. $b+c$\n\nIII. $c$" :question/worked-solution "Let's look at each one in turn.\n\nI. $b$ is a variable because it's a single letter by itself.\n\nII. $b+c$ is an algebraic expression, not a variable.\n\nIII. $c$ is a variable because it's a single letter by itself.\n\nSo, only choices I and III represent a variable."}] [{:db/id 17592186425728 :knowledge-point/_questions [{:db/id 17592186119927 :knowledge-point/id #uuid "83796fe8-f045-5dbc-94d1-6d6e031f3ed8" :knowledge-point/title "Determining Whether a Line Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c070d7-93fe-5bba-a874-0f03d400b970" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "All the statements are true" :db/id 17592186425722} {:answer/id #uuid "525f7819-dd00-5e00-a52d-1b2aea5486bd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id 17592186425723} {:answer/id #uuid "6c2fcb20-55c1-502d-87bf-a84af1affda6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id 17592186425724} {:answer/id #uuid "6dd9382b-2ca0-59aa-a584-c0b212c9c30e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186425725} {:answer/id #uuid "6f28cf69-6f55-526e-9f18-ac9d9a874611" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186425726}] :answer-field/correct {:answer/id #uuid "10c070d7-93fe-5bba-a874-0f03d400b970" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "All the statements are true" :db/id 17592186425722} :answer-field/id #uuid "32b315b1-b85d-5621-9821-b0256f44b55f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186425727}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ea10c69-304c-5ad4-bd04-4affc2cf325b" :question/math-academy-id "q-157376" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,0,0)$ and $(-1,3,1).$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is a subspace of ${R}^{3}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nFirst, note that the direction vector of the line $L$ is \n\n$$\nd=[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}]-[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}].\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}]=[\\begin{aligned}-t \\\\ 3t \\\\ t\\end{aligned}]\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n-x=\\frac{y}{3}=z.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. Indeed, from the definition of $L$ we have that the point $(0,0,0)$ is in $L.$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]\\in L$ and $b=[\\begin{aligned}-b \\\\ 3b \\\\ b\\end{aligned}]\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]+[\\begin{aligned}-b \\\\ 3b \\\\ b\\end{aligned}]=[\\begin{aligned}(-a)+(-b) \\\\ 3a+3b \\\\ a+b\\end{aligned}]=[\\begin{aligned}-(a+b) \\\\ 3(a+b) \\\\ a+b\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the conditions $-x=\\frac{y}{3}=z.$ Therefore, $a+b\\in L.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]=[\\begin{aligned}k(-a) \\\\ k(3a) \\\\ ka\\end{aligned}]=[\\begin{aligned}-(ka) \\\\ 3(ka) \\\\ ka\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the conditions $-x=\\frac{y}{3}=z.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement IV is true. Since statements II and III are true, $L$ is a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id 17592186425875 :knowledge-point/_questions [{:db/id 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eedb5eb-4a53-52bf-bb91-736a768c01a5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186425859} {:answer/id #uuid "5796bd74-a234-55f5-a5f9-bee4c20f2c37" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186425861} {:answer/id #uuid "6e08cddb-71c7-54e2-99d5-5e60caa26d2f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186425862} {:answer/id #uuid "c53010b8-a034-5aca-8828-82b8098d48fa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186425865} {:answer/id #uuid "ec8ef8d9-7011-5f21-8ec2-2534d66acfdf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186425870}] :answer-field/correct {:answer/id #uuid "5796bd74-a234-55f5-a5f9-bee4c20f2c37" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186425861} :answer-field/id #uuid "375ee444-4376-5150-bb9c-79b09c44be67" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186425872}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2365a6d7-b820-5041-9972-25df8cfa8866" :question/math-academy-id "q-86922" :question/problem "Which of the following are continuous random variables?\n\nI. The outcome of rolling a $10$-sided die\n\nII. The number of aces in a standard deck of playing cards\n\nIII. The weight of a randomly selected person, measured in kilograms" :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I does *not* describe a continuous random variable. Its value is determined by the result of an experiment, but its possible values are the integers $1,2,3,…,10,$ which do not correspond to an interval of real numbers.\n\n- Statement II does *not* describe a continuous random variable. The number of aces in a standard deck of playing cards is not the outcome of a trial or experiment. (By definition, there are $4$ aces in a standard deck of playing cards.)\n\n- Statement III describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real numbers in the interval $(0,\\infty ).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186425929 :knowledge-point/_questions [{:db/id 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e995b4f-80df-5a44-ac52-ef3e8528fb3d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186425916} {:answer/id #uuid "7ea449c7-e858-51b4-bdf2-6beadec281c8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186425918} {:answer/id #uuid "c738fcf4-81ab-523b-a4a3-3c52b0e51091" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186425920} {:answer/id #uuid "e52b4a76-97bf-58a6-8111-6703e511f2da" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186425922} {:answer/id #uuid "fdb50184-5f7d-5a30-8c1d-9227e10a07fa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186425925}] :answer-field/correct {:answer/id #uuid "6e995b4f-80df-5a44-ac52-ef3e8528fb3d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186425916} :answer-field/id #uuid "30306495-7925-535a-81a1-49a15747abcb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186425926}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1654ded7-c0bc-579c-a9e9-6daa6a1243e7" :question/math-academy-id "q-86894" :question/problem "![](images/5d/5d8f57afa16e99c13e6e36c5544a7c7594da13321bd3d01692a5a296a20953d7.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$\n\nII. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nIII. $\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ x{e}^{y}, & (x,y)\\in D\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and the rectangle $R:$\n\n![](images/ce/ce9b9f3435a94b3f9f87b195e5b1591c80281b23cfb76ceb8e79cdeec3ae66b0.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $x{e}^{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions I and II. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,2)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function III equals $x{e}^{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186425930 :knowledge-point/_questions [{:db/id 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30dc624a-6195-52a9-9917-f3684e4a574f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186425913} {:answer/id #uuid "4a78a72b-b4d7-5293-8aba-7c35212132ae" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186425914} {:answer/id #uuid "5f3e8aa2-20ed-5607-9c37-0e3dceaf9028" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186425915} {:answer/id #uuid "9f70c45e-aafb-568b-ad0e-18cd0c73be10" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186425919} {:answer/id #uuid "f078a363-807c-53b3-b111-d4c6e7e91d19" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186425923}] :answer-field/correct {:answer/id #uuid "5f3e8aa2-20ed-5607-9c37-0e3dceaf9028" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186425915} :answer-field/id #uuid "e2a9dd81-ee99-5b34-b7e2-398216f26e54" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186425928}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19ad1761-3136-5be8-b038-5aa62265f48b" :question/math-academy-id "q-80526" :question/problem "![](images/88/8866056ce5c7c80ed8452246cc3a40074b6841615ed6ef472e7a1612709e51fa.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}x\\operatorname{sin}⁡y & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. ${∬}_{R}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,1]\\times [-3,2]$\n\nII. ${∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$\n\nIII. ${∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [-2,2]$" :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}x\\operatorname{sin}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186425980 :knowledge-point/_questions [{:db/id 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3663dea6-8f8d-54bc-864f-6cdf19f19c88" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186425955} {:answer/id #uuid "89c42d97-1ffe-532c-88ad-c4354d4cacc9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186425962} {:answer/id #uuid "8aae07b3-7050-585d-9ab2-29e7b26a079e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186425963} {:answer/id #uuid "9267effc-1c42-535d-b1dc-8a9d238e9d00" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186425964} {:answer/id #uuid "dd2f7abc-c440-5908-9420-fb38212f6415" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186425969}] :answer-field/correct {:answer/id #uuid "89c42d97-1ffe-532c-88ad-c4354d4cacc9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186425962} :answer-field/id #uuid "36434b4b-dfd9-5274-923b-5cb5af1c5fbf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186425973}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86866e7c-73c9-5409-8743-b71ad4d3cbe4" :question/math-academy-id "q-175366" :question/problem "Which of the following are mathematical predicates?\n\nI. $P(y):$ ${y}^{2}-1=8$\n\nII. $Q(a,b):$ ${a}^{2}+{b}^{2}$\n\nIII. $R(x,y):$ $\\frac{x}{y}\\in N\\cap Q$" :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate of one variable. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete pair of values $(a,b)$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186426030 :knowledge-point/_questions [{:db/id 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e5ad509-f222-57cf-aad1-961225cbf678" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426014} {:answer/id #uuid "b3aa464a-8540-50ee-b183-67dfed5bc276" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426019} {:answer/id #uuid "b8c39168-7bf4-5d81-8f3c-f185d6fd3184" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186426021} {:answer/id #uuid "cd685fc2-72f4-505e-8029-94e112daad97" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186426023} {:answer/id #uuid "ef75c0fc-986f-53cf-8094-ba198441cb7d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426026}] :answer-field/correct {:answer/id #uuid "b3aa464a-8540-50ee-b183-67dfed5bc276" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426019} :answer-field/id #uuid "2733d11c-ea48-531a-9530-4eab521f3e93" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426027}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ce1827c-c98c-5481-b210-2bd31e84c14f" :question/math-academy-id "q-143337" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ |\n\nWhich of the following statements are true?\n\nI. $P(X=1,Y=1)=P(X=1)\\cdot P(Y=1)$\n\nII. $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ | $0.35$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ | $0.65$ |\n| ${f}_{Y}$ | $0.4$ | $0.5$ | $0.1$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.26.$ On the other hand, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.65\\cdot 0.4=0.26.\\,✓\n$$\n\n- Statement II is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,1) & =0.14=0.35\\cdot 0.4={f}_{X}(0)\\cdot {f}_{Y}(1) & ✓ \\\\ f(0,2) & =0.16\\ne 0.35\\cdot 0.5={f}_{X}(0)\\cdot {f}_{Y}(2) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186426072 :knowledge-point/_questions [{:db/id 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d6fe511-51db-512e-9712-3fce9ffdbf74" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186426034} {:answer/id #uuid "114ef65a-d282-56b9-8b1c-7327abc02824" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426035} {:answer/id #uuid "255616ee-ba3a-54d9-8723-c63b4106178b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426039} {:answer/id #uuid "4db9632d-653a-5eaf-8753-6f387cc348fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426043} {:answer/id #uuid "53cb8d5a-9998-5bf4-b2cf-fea2ed0d5668" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426046}] :answer-field/correct {:answer/id #uuid "255616ee-ba3a-54d9-8723-c63b4106178b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426039} :answer-field/id #uuid "3b96ac14-685d-5526-ba37-eae6e8cc0fd7" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426066}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "251cfe7e-474d-59b2-8ccf-101401daf068" :question/math-academy-id "q-139978" :question/problem "Consider the following sentence:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ has no inverse\n\nII. $\\text{Null}(A)$ has dimension zero\n\nIII. $A$ has less than $5$ pivot columns" :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$ \n\nIndeed, since $det(A)=0,$ the matrix $A$ can't be invertible.\n\n- The following statement is false:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{Null}(A)$ has dimension zero.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn,  means that $\\text{Null}(A)$ must have a basis so the dimension must be greater than zero.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has less than $5$ pivot columns.* $\\,✓$\n\nIndeed, since $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))\\ne 5,$ which means that $A$ has less than $5$ pivot columns.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186426531 :knowledge-point/_questions [{:db/id 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0767be10-b80e-5b7a-9933-3ba3fb4c44e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426495} {:answer/id #uuid "5d6b65ab-8807-5d54-926e-ee314453bf97" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426503} {:answer/id #uuid "8dcc7e06-175d-5d1b-a601-c0adc25aeb03" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426507} {:answer/id #uuid "a7a01f3a-a811-5cfd-9def-5a3a838e631f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426509} {:answer/id #uuid "c55dee9a-9cbf-579c-a16e-bc04fcd4e0d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186426519}] :answer-field/correct {:answer/id #uuid "8dcc7e06-175d-5d1b-a601-c0adc25aeb03" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426507} :answer-field/id #uuid "fba70771-0732-5f16-8aad-3cbb450dac29" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426529}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24da091b-82da-56f5-873d-6d9cc1e779e2" :question/math-academy-id "q-158072" :question/problem "![](images/8f/8f3c0e576491c4fd3897e30931ca7ed86d03c557ed37de86a3bcdc748f2263ea.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram III represents a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id 17592186426532 :knowledge-point/_questions [{:db/id 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbb2cff-4624-5923-8685-e5a548d8977d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426497} {:answer/id #uuid "454f98bf-3629-5a58-9552-960add2da6f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186426500} {:answer/id #uuid "7a1b4867-eb6a-5521-bcad-61fa3407334a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426504} {:answer/id #uuid "b4bc555d-4c0a-5189-8ed7-e64a95c92fbe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426514} {:answer/id #uuid "f5dd10dc-46c8-5e11-9117-cbcf71fba3aa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186426521}] :answer-field/correct {:answer/id #uuid "454f98bf-3629-5a58-9552-960add2da6f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186426500} :answer-field/id #uuid "fe451965-9c74-57be-8dbe-36a5fd0d6066" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426530}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61609b84-fa99-5574-b117-b0c4a018b4cb" :question/math-academy-id "q-110456" :question/problem "![](images/5a/5ac6c0c6dc06d6e9b3970f2d6e5c5ce01a56c781143999d744a9b3914c37a49d.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=[\\begin{aligned}-1 \\\\ -1\\end{aligned}]$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nlies outside the subset.\n\n- Diagram II represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III represents the whole plane ${R}^{2}$ without the origin. But every subspace must contain the origin, so Diagram III is not a subspace of ${R}^{2}.$\n\nSo, the correct answer is \"None.\""}] [{:db/id 17592186426533 :knowledge-point/_questions [{:db/id 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a386ac-92e4-5de2-b25a-a233d3727e10" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426499} {:answer/id #uuid "8cf25f88-fff3-55ab-bc62-d7f0f4626567" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426506} {:answer/id #uuid "ac955eaa-6ad8-5245-bdc3-f9b1b5a756a1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186426512} {:answer/id #uuid "cdb8646c-5884-5c39-bedb-ba79ac30411d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426520} {:answer/id #uuid "fea4f0b9-381b-5720-8ec6-11a187e7c372" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426524}] :answer-field/correct {:answer/id #uuid "8cf25f88-fff3-55ab-bc62-d7f0f4626567" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426506} :answer-field/id #uuid "9c8d6b0d-91c0-5042-9591-44d5f308c893" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426528}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "784a3447-3ec5-5b3c-aa05-c4909c41863a" :question/math-academy-id "q-110763" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\nI. $A=\\{⟨1+t,t-1⟩\\,:\\,t\\in R\\}$\n\nII. $B=\\{⟨x,y⟩\\in {R}^{2}:xy=0\\}$\n\nIII. $C=\\{⟨x,y⟩\\in {R}^{2}:x=0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. If the origin belongs to this subset, we would have\n\n$$\n[\\begin{aligned}1+t \\\\ t-1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}],\n$$\n\nwhich gives us\n\n$$\n\\{\\begin{aligned}t+1=0 \\\\ t-1=0.\\end{aligned}\n$$\n\nWe see that the system has no solution. So, $0$ is not in $A.$\n\n- The set $B$ is not a subspace. Indeed, both $a=⟨1,0⟩$ and $b=⟨0,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0⟩+⟨0,1⟩=⟨1,1⟩\n$$\n\n \ndoes not satisfy the condition $xy=0$ since $1\\cdot 1\\ne 0.$\n\n- The set $C$ is a subspace. It represents a line (the $y$-axis), and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $x=0$ since $0=0.$ So, $0$ lies in $C.$\n\nIn conclusion, the correct answer is \"III only.\""}] [{:db/id 17592186426534 :knowledge-point/_questions [{:db/id 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d497d71-015c-5091-8ed9-1e92e99927de" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186426496} {:answer/id #uuid "3785fa9c-48ca-585d-98ad-b79c1eb2860b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426498} {:answer/id #uuid "87caa511-9031-5f67-b7b1-5bebef022d31" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426505} {:answer/id #uuid "963d4f9f-58da-588d-9b63-7579100345e3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426508} {:answer/id #uuid "ae8b5893-8336-52d6-9374-ab8aa55e5655" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426513}] :answer-field/correct {:answer/id #uuid "3785fa9c-48ca-585d-98ad-b79c1eb2860b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426498} :answer-field/id #uuid "32d5a140-6abb-5e9f-bd19-77d2f7c496f6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426526}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d538e48-6d40-5139-9e4a-4a2045c240b7" :question/math-academy-id "q-158073" :question/problem "![](images/f6/f6695911ed29ccf88240660e45ce6527c0a10e3cf8d6a299ac9eef2be3ff53cb.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a plane that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\n- Diagram II represents a line that does not pass through the origin. But every subspace must contain the origin, so the line in Diagram II is not a subspace of ${R}^{3}.$\n\n- Diagram III represents a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\nSo, the correct answer is \"I and III only.\""}] [{:db/id 17592186426535 :knowledge-point/_questions [{:db/id 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "554e7d19-0e14-5830-b0fd-7d5b3f83ee7f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426501} {:answer/id #uuid "a8ae60eb-fe33-51ae-8844-4f984b797389" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426510} {:answer/id #uuid "b5f99f31-23ce-57b2-a47b-0e3dfda5c91a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426516} {:answer/id #uuid "bcb5e878-1dd3-5cc3-a04a-226eaf163c85" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426517} {:answer/id #uuid "fe20b5d4-90f9-54c8-9931-1ec170ceeb0e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426523}] :answer-field/correct {:answer/id #uuid "554e7d19-0e14-5830-b0fd-7d5b3f83ee7f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426501} :answer-field/id #uuid "1275155b-aac2-554a-8a20-c373814f14d8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426525}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c109cc3b-b729-5d92-be15-5107dfc714ce" :question/math-academy-id "q-110759" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:x-y+z=0\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}=0\\}$\n\nIII. $C=\\{⟨0,0,1⟩\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $x-y+z=0$ since $0-0+0=0.$ So $0$ lies in $A.$\n\n- The set $B$ is a subspace. This subset has only one element, the zero vector $0=⟨0,0,0⟩,$ which is a special (trivial) subspace of ${R}^{3}.$\n\n- The set $C$ is not a subspace. This subset has only one element, the vector $⟨0,0,1⟩,$ so it does not contain the zero vector.\n\nIn conclusion, the correct answer is \"I and II only.\""}] [{:db/id 17592186426536 :knowledge-point/_questions [{:db/id 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5caf0a31-9e0c-5a1c-ad65-9b44460cbe33" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186426502} {:answer/id #uuid "abdf6d49-ea74-5c07-a09b-16cb093c715a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426511} {:answer/id #uuid "b5069048-3871-5ac2-9c3f-95c0913fd49a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186426515} {:answer/id #uuid "c12258e1-34ad-53a0-a3d9-9235459976ea" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426518} {:answer/id #uuid "fc8e878f-5e6c-568c-8370-d1b742bed8da" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426522}] :answer-field/correct {:answer/id #uuid "c12258e1-34ad-53a0-a3d9-9235459976ea" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426518} :answer-field/id #uuid "913f9620-3143-5eb0-bde3-3581baeee85f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426527}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4fcfc53-7279-50f5-90f1-bd8c9662d8f3" :question/math-academy-id "q-110599" :question/problem "![](images/c3/c36c34462f2ba7f129ba3370d4e67c5ac450b4188be629a256caf7807d4cb2d6.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$  clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. There are vectors  $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2}\\end{aligned}]$  in the subset for which ${a}_{1}>0$ and ${a}_{2}>0.$   But then\n\n$$\n(-1)\\cdot a=[\\begin{aligned}-{a}_{1} \\\\ -{a}_{2}\\end{aligned}]\n$$\n\nlies outside the subset.\n\n- Diagram III is a line that passes through the origin. Therefore, it is a subspace of ${R}^{2}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id 17592186426975 :knowledge-point/_questions [{:db/id 17592186054809 :knowledge-point/id #uuid "7fcec0d8-ca03-5446-a42f-65d0ccddd584" :knowledge-point/title "Identifying the Quadrant of a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2783bd40-3420-50d6-aca2-a036799a1989" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186426881} {:answer/id #uuid "6fd7f4c1-76d8-526f-9246-9518fbcd5a65" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186426904} {:answer/id #uuid "9a6bb31c-d014-567f-ba52-e3afe3919115" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186426914} {:answer/id #uuid "a59951d6-4b9c-5418-b347-b1c451db5a4c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426916} {:answer/id #uuid "dfd571c3-4c79-5b1e-a642-61dd8d70ab4a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and  III only" :db/id 17592186426937}] :answer-field/correct {:answer/id #uuid "a59951d6-4b9c-5418-b347-b1c451db5a4c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186426916} :answer-field/id #uuid "682709b3-961f-5951-9e4b-89301f1f85e3" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186426955}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9298397c-357d-5783-87f8-a9a66297312a" :question/math-academy-id "q-169184" :question/problem "![](images/92/928b00ea1ac59e758c4bc9e224d2d27e1c2149e31d0c5c3ab7673ee9abeae208.png)\n\nWhich of the following is true regarding the point $S?$\n\nI. It is in the fourth quadrant\n\nII. Its $x$-coordinate is $1$\n\nIII. Its $y$-coordinate is $-3$" :question/worked-solution "The point $S$ is in the third quadrant, so statement I is false.\n\nTo find the coordinates of the point $S,$ we start at the origin, move $1$ units *left*, and then $3$ units *down*. \n\n![](images/f1/f150eac73755dc5f39b499b6ca0ba12624e4c27dd79e7207e11f6c88d04b596d.png)\n\nThe coordinates of $P$ are $(-1,-3).$ Hence, statement II is false and statement III is true."}] [{:db/id 17592186427272 :knowledge-point/_questions [{:db/id 17592186231429 :knowledge-point/id #uuid "cac41120-247d-5821-b7f6-b342dbcf8f18" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7998eb-7eaf-5245-8c62-e37c7ec23280" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186427247} {:answer/id #uuid "25a494c8-57d1-53c2-87ed-c49b33af7999" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186427248} {:answer/id #uuid "59b394d0-eddc-5f9f-8b4a-e200803eeb81" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186427255} {:answer/id #uuid "85e3b9f0-cb0f-56b7-9950-1757837f3c93" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186427257} {:answer/id #uuid "95e627ca-5870-5885-9e85-231290fb62f9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186427259}] :answer-field/correct {:answer/id #uuid "85e3b9f0-cb0f-56b7-9950-1757837f3c93" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186427257} :answer-field/id #uuid "381db720-afce-51ba-af73-b0e9b580a593" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186427264}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "528870e0-56ba-55b5-a9bc-4fec3b9615fa" :question/math-academy-id "q-343753" :question/problem "A particle is moving with forced harmonic motion without damping. The particle is acted on by an external periodic force\n$f(t)=-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t).$\nAssuming the system experiences resonance, which of the following could be used to represent the general solution for the position $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(3t+ϕ)-\\operatorname{cos}⁡(3t)-\\frac{1}{2}\\operatorname{sin}⁡(3t)$\n\nII. $y=R\\operatorname{sin}⁡(3t+ϕ)-t\\operatorname{sin}⁡(3t)-\\frac{1}{2}t\\operatorname{cos}⁡(3t)$\n\nIII. $y=A\\operatorname{cos}⁡(3t)+B\\operatorname{sin}⁡(3t)-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\nNote that $A,$ $B,$ $R,$ and $ϕ$ are constants." :question/worked-solution "Because the motion is undamped and the system experiences resonance, the forcing frequency equals the natural frequency $\\omega .$\n\nThe external force is $f(t)=-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t),$ which is sinusoidal with frequency $3.$ Therefore,\n$\\omega =3.$\n\nThe complementary solution for the associated simple harmonic motion equation can be written in three different forms:\n\n1\\. ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)=R\\operatorname{cos}⁡(3t+ϕ)$\n\n2\\. ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)=R\\operatorname{sin}⁡(3t+ϕ)$\n\n3\\. ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t=A\\operatorname{cos}⁡(3t)+B\\operatorname{sin}⁡(3t)$\n\nAt resonance, a sinusoidal trial at frequency $\\omega $ duplicates the complementary solution, so we multiply by $t$ and take a resonant particular solution of the form\n\n$$\n{y}_{p}(t)=t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)).\n$$\n\nBy substituting the particular solution and $\\omega =3$ into the differential equation, ${y}^{″}+{\\omega }^{2}y=f(t),$ we get \n\n$$\n\\begin{aligned}[(6D-9Ct)\\operatorname{cos}⁡(3t)-(6C+9Dt)\\operatorname{sin}⁡(3t)]+9t(C\\operatorname{cos}⁡(3t)+D\\operatorname{sin}⁡(3t)) & =-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t) \\\\ 6D\\operatorname{cos}⁡(3t)-6C\\operatorname{sin}⁡(3t) & =-3\\operatorname{cos}⁡(3t)+6\\operatorname{sin}⁡(3t)\\end{aligned}\n$$\n\nEquating coefficients, $C=-1$ and $D=-\\frac{1}{2}.$ \n\nSo, the particular solution is\n\n$$\n{y}_{p}(t)=-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t).\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n1\\. $y=R\\operatorname{cos}⁡(3t+ϕ)-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\n2\\. $y=R\\operatorname{sin}⁡(3t+ϕ)-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\n3\\. $y=A\\operatorname{cos}⁡(3t)+B\\operatorname{sin}⁡(3t)-t\\operatorname{cos}⁡(3t)-\\frac{1}{2}t\\operatorname{sin}⁡(3t)$\n\nOnly solution III matches the forms above.\nTherefore, the correct answer is \"III only\"."}] [{:db/id 17592186430806 :knowledge-point/_questions [{:db/id 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5292133c-58a4-54a4-a601-35a908997fea" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186430787} {:answer/id #uuid "821647ea-8e8f-5c03-ba00-206492b1131a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186430789} {:answer/id #uuid "c2ae49b3-2b1a-5769-a32d-2fa88e84403a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186430794} {:answer/id #uuid "db41afa9-b02c-5090-94ff-3130841b1e75" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186430796} {:answer/id #uuid "f74c6690-ce28-580c-9560-4db51296ad3f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186430799}] :answer-field/correct {:answer/id #uuid "c2ae49b3-2b1a-5769-a32d-2fa88e84403a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186430794} :answer-field/id #uuid "be0c4698-714b-5480-a266-83cfdfc1738d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186430804}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f21c5fc-f92d-5b81-95e0-bb89748670fa" :question/math-academy-id "q-140497" :question/problem "$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-1 \\\\ 7 \\\\ -1\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}2 \\\\ 0 \\\\ -5\\end{aligned}]\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩=5{x}_{1}{y}_{1}+{x}_{2}{y}_{2}+2{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nI. ${v}_{1}⊥{v}_{2}$ with respect to the given inner product\n\nII. ${v}_{2}⊥̸{v}_{3}$ with respect to the given inner product\n\nIII. $S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =5(1)(-1)+(1)(7)+2(1)(-1) \\\\  & =-5+7-2 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement II is false since \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =5(-1)(2)+(7)(0)+2(-1)(-5) \\\\  & =-10+0+10 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement III is true. Indeed, computing the inner product $⟨{v}_{1},{v}_{3}⟩$, we have \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =5(1)(2)+(1)(0)+2(1)(-5) \\\\  & =10+0-10 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\nAs a result, the set $S$ is orthogonal.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186430807 :knowledge-point/_questions [{:db/id 17592186133870 :knowledge-point/id #uuid "c2bcfcb6-8f8b-5aa9-8346-05db880fa5bb" :knowledge-point/title "Determining Whether a Set of Polynomials is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10969bc4-2424-5ec5-beef-b6411d54b752" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186430781} {:answer/id #uuid "408f846a-8671-5e12-91e0-cae716143fe1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186430784} {:answer/id #uuid "414e8c9c-a038-5f39-a50b-325ec8694b78" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186430785} {:answer/id #uuid "832aafe5-b074-5f94-991a-4348f32647a8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186430790} {:answer/id #uuid "a2d51e26-f297-5ec3-b8fc-38cafe658656" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186430792}] :answer-field/correct {:answer/id #uuid "10969bc4-2424-5ec5-beef-b6411d54b752" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186430781} :answer-field/id #uuid "468787f7-c1b4-5473-9896-1544ea0279e9" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186430801}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c3a213f9-9ffe-56d7-a8aa-efb68c3978ef" :question/math-academy-id "q-104735" :question/problem "Consider the following set of polynomials:\n\n$$\n{p}_{1}(t)=3t,\\,{p}_{2}(t)=t+1,\\,{p}_{3}(t)={t}^{2}-1.\n$$\n\nGiven that the inner product in the vector space ${R}_{2}[t]$ of polynomials of degree at most $2$ in the variable $t$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(0)q(0)+p(1)q(1),\n$$\n\nwhich of the following statements are true?\n\nI. ${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product\n\nII. ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product\n\nIII. $S=\\{{p}_{1}(t),{p}_{2}(t),{p}_{3}(t)\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{2}(t)⟩ & =⟨3t,t+1⟩ \\\\  & =(3t){|}_{-1}\\cdot (t+1){|}_{-1}+(3t){|}_{0}\\cdot (t+1){|}_{0}+(3t){|}_{1}\\cdot (t+1){|}_{1} \\\\  & =(3(-1))\\cdot ((-1)+1)+(3(0))\\cdot (0+1)+(3(1))\\cdot (1+1) \\\\  & =6\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥̸{p}_{2}(t)$ with respect to the given inner product.\n\n- Statement II is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{3}(t)⟩ & =⟨3t,{t}^{2}-1⟩ \\\\  & =(3t){|}_{-1}\\cdot ({t}^{2}-1){|}_{-1}+(3t){|}_{0}\\cdot ({t}^{2}-1){|}_{0}+(3t){|}_{1}\\cdot ({t}^{2}-1){|}_{1} \\\\  & =(3(-1))\\cdot ((-1)^{2}-1)+(3(0))\\cdot ({0}^{2}-1)+(3(1))\\cdot ({1}^{2}-1) \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${p}_{1}(t)⊥{p}_{3}(t)$ with respect to the given inner product.\n\n- Statement III is false. Since ${p}_{1}(t)⊥̸{p}_{2}(t),$ the set $S$ is *not* an orthogonal set.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186430808 :knowledge-point/_questions [{:db/id 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c15540-3c41-5ca2-a7d9-dc8baf6f1008" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186430782} {:answer/id #uuid "518b0bf4-0290-5996-ba11-0aede8ea3071" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186430786} {:answer/id #uuid "680ba569-6fa1-5174-a88b-6fec3325f8fd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186430788} {:answer/id #uuid "c8647e45-9ab4-56a3-93bb-8a30b093366b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186430795} {:answer/id #uuid "eeedd419-cbf7-5753-9977-4da6fe0c9b81" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186430798}] :answer-field/correct {:answer/id #uuid "518b0bf4-0290-5996-ba11-0aede8ea3071" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186430786} :answer-field/id #uuid "715169d2-6248-5c13-8e14-43b51e80908b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186430803}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1da803c-87de-5156-b3a7-d636001e9616" :question/math-academy-id "q-99637" :question/problem "$$\n{v}_{1}=[\\begin{aligned}2 \\\\ -1 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}0 \\\\ 1 \\\\ 3\\end{aligned}]\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩=2{x}_{1}{y}_{1}+3{x}_{2}{y}_{2}+{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nI. ${v}_{1}⊥̸{v}_{2}$ with respect to the given inner product\n\nII. ${v}_{2}⊥{v}_{3}$ with respect to the given inner product\n\nIII. $S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false since\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =2(2)(1)+3(-1)(1)+(1)(-1) \\\\  & =4-3-1 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement II is true. Indeed, we have \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =2(1)(0)+3(1)(1)+(-1)(3) \\\\  & =0+3-3 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement III is true. Indeed, computing the inner product $⟨{v}_{1},{v}_{3}⟩$, we have \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =2(2)(0)+3(-1)(1)+(1)(3) \\\\  & =0-3+3 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\nAs a result, the set $S$ is orthogonal.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186431144 :knowledge-point/_questions [{:db/id 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cf31f8d-0b9b-54c4-9952-e5cce2f4eb4d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186431128} {:answer/id #uuid "8411bef0-d8a8-527d-a004-2dd2d0cf6447" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186431129} {:answer/id #uuid "d83fc18f-3328-5871-b2d1-03511b17539e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186431136} {:answer/id #uuid "ec54620d-42a6-5d21-824a-bb0be4ebb61d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186431138} {:answer/id #uuid "ffa1a9f9-35e4-54a6-80a6-ff1b93c42bad" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186431140}] :answer-field/correct {:answer/id #uuid "4cf31f8d-0b9b-54c4-9952-e5cce2f4eb4d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186431128} :answer-field/id #uuid "cf16abc1-c544-5419-8b7c-43b624566e09" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186431143}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3951f87d-bb0f-5303-830e-d70693674542" :question/math-academy-id "q-94279" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+8y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y=R\\operatorname{cos}⁡(4t+{ϕ}_{1})$\n\nII. $y=R\\operatorname{cot}⁡(2\\sqrt{2}t+{ϕ}_{2})$\n\nIII. $y=A\\operatorname{cos}⁡(2\\sqrt{2}t)+B\\operatorname{sin}⁡(2\\sqrt{2}t)$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n1\\. $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n2\\. $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n3\\. $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=8\\,⟹\\,\\omega =2\\sqrt{2}.\n$$\n\nThus, we have:\n\n1\\. $y=R\\operatorname{cos}⁡(2\\sqrt{2}t+{ϕ}_{1})$\n\n2\\. $y=R\\operatorname{sin}⁡(2\\sqrt{2}t+{ϕ}_{2})$\n\n3\\. $y=A\\operatorname{cos}⁡(2\\sqrt{2}t)+B\\operatorname{sin}⁡(2\\sqrt{2}t)$\n\nTherefore, only statement III could be used to represent  $y(t).$"}] [{:db/id 17592186431924 :knowledge-point/_questions [{:db/id 17592186198261 :knowledge-point/id #uuid "0d6db336-845a-506a-b020-cced1b38e23a" :knowledge-point/title "Using Laws Involving Implications and Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172c866e-61d5-5acd-a888-4900172f90ee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186431895} {:answer/id #uuid "3171c0d3-b6e0-5731-b749-9f6d2eb044fb" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186431898} {:answer/id #uuid "59a9825b-78e1-597e-9ae8-b1be3edf28e4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186431900} {:answer/id #uuid "5bf6434d-2d00-5137-9f92-022547235944" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186431901} {:answer/id #uuid "63bac827-f548-588b-9cd2-6ca1551b28ad" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186431903}] :answer-field/correct {:answer/id #uuid "172c866e-61d5-5acd-a888-4900172f90ee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186431895} :answer-field/id #uuid "1a1aa3e9-08d2-5954-b646-fa2fc7df8436" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186431921}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0af36684-2b78-59f1-bddf-9a1297846d8d" :question/math-academy-id "q-183358" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $x\\in Z∖{N}_{0}.$ $\\,$ $B(x):$ $x\\in {Z}^{-}.$ \n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\nI. $x\\in Z∖{N}_{0}$ if and only if $x\\in {Z}^{-}.$\n\nII. If $x\\in Z∖{N}_{0}$ then $x\\in {Z}^{-},$ or if $x\\in {Z}^{-}$ then $x\\in Z∖{N}_{0}.$\n\nIII. $x\\in Z∖{N}_{0}$ is equivalent to  $x\\in {Z}^{-}.$" :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $x\\in Z∖{N}_{0}$ if and only if $x\\in {Z}^{-}.$\n\n- $x\\in Z∖{N}_{0}$ is equivalent to  $x\\in {Z}^{-}.$\n\n- If $x\\in Z∖{N}_{0}$ then $x\\in {Z}^{-},$ and if $x\\in {Z}^{-}$ then $x\\in Z∖{N}_{0}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186432579 :knowledge-point/_questions [{:db/id 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ca4b98-0fe7-5c0e-bc3e-5d2f9d7b445d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432555} {:answer/id #uuid "61b68282-4cc9-5b93-be49-86af47b4a3b7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432563} {:answer/id #uuid "b3726556-58cf-54f7-a94e-a01800ba1dfe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432567} {:answer/id #uuid "da777daa-3338-5846-a305-378dd1e86eef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432568} {:answer/id #uuid "f3a6e302-ea43-50f3-855f-a828c356ceab" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432572}] :answer-field/correct {:answer/id #uuid "b3726556-58cf-54f7-a94e-a01800ba1dfe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432567} :answer-field/id #uuid "4c538444-4b53-5d79-a4f2-bda9a48b5d41" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432574}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "248767b0-4e8f-59a2-a18a-6d7a3f7d1129" :question/math-academy-id "q-334262" :question/problem "$$\n4{x}^{2}{y}^{″}+6x{y}^{′}-2y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nI. ${y}_{1}(x)=\\frac{1}{x}$ is a solution to the equation for $x>0.$\n\nII. ${y}_{2}(x)=\\sqrt{x}$ is a solution to the equation for $x>0.$\n\nIII. The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$" :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x).$ Notice that $\\frac{1}{x}={x}^{-1},$ so we have:\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-\\frac{1}{{x}^{2}} \\\\ {y}_{1}^{″}(x) & =\\frac{2}{{x}^{3}}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{x}^{2}(\\frac{2}{{x}^{3}})+6x(-\\frac{1}{{x}^{2}})-2(\\frac{1}{x}) & =0 \\\\ (\\frac{8}{x}-\\frac{6}{x}-\\frac{2}{x}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x).$ Notice that $\\sqrt{x}={x}^{\\frac{1}{2}},$ so we have:\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {y}_{2}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{x}^{2}(-\\frac{1}{4}{x}^{-3/2})+6x(\\frac{1}{2}{x}^{-1/2})-2\\sqrt{x} & =0 \\\\ (-{x}^{1/2}+3{x}^{1/2}-2{x}^{1/2}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is true. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{-1} & {x}^{1/2} \\\\ -{x}^{-2} & \\frac{1}{2}{x}^{-1/2}\\end{aligned}| \\\\  & ={x}^{-1}\\cdot \\frac{1}{2}{x}^{-1/2}-{x}^{1/2}\\cdot (-{x}^{-2}) \\\\  & =\\frac{1}{2}{x}^{-3/2}+{x}^{-3/2} \\\\  & =\\frac{3}{2}{x}^{-3/2}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0,\\infty ),$ the functions are linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id 17592186432580 :knowledge-point/_questions [{:db/id 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12840b9d-f4f7-5e1e-9319-49c92b0a1514" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432556} {:answer/id #uuid "75105097-da69-5af8-857c-8da170024488" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432564} {:answer/id #uuid "7a565dca-df39-5e2d-b63f-4adbd2a8ea39" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432565} {:answer/id #uuid "8a5318c9-c7a7-51b8-9b4d-6688604aeba7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432566} {:answer/id #uuid "e87d37de-a054-5273-bb9c-f325114b3de0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432571}] :answer-field/correct {:answer/id #uuid "7a565dca-df39-5e2d-b63f-4adbd2a8ea39" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432565} :answer-field/id #uuid "750328c3-c578-5e21-8518-8f7c29a90ca6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432576}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8005871f-5013-58a1-b9ee-7ef831d491ac" :question/math-academy-id "q-334257" :question/problem "$$\n{x}^{2}{y}^{″}+2x{y}^{′}-12y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nI. ${y}_{1}(x)=\\frac{1}{{x}^{3}}$ is a solution to the equation.\n\nII. ${y}_{2}(x)={x}^{3}$ is a solution to the equation.\n\nIII. The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-\\frac{3}{{x}^{4}} \\\\ {y}_{1}^{″}(x) & =\\frac{12}{{x}^{5}}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(\\frac{12}{{x}^{5}})+2x(-\\frac{3}{{x}^{4}})-12(\\frac{1}{{x}^{3}}) & =0 \\\\ -\\frac{6}{{x}^{3}} & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{x}^{2} \\\\ {y}_{2}^{″}(x) & =6x\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(6x)+2x(3{x}^{2})-12({x}^{3}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id 17592186432686 :knowledge-point/_questions [{:db/id 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1365d528-3559-5e8c-aab0-a5fb4cd1c0ed" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432601} {:answer/id #uuid "461bf02a-0b0d-5764-8758-d03d9e57079c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432615} {:answer/id #uuid "939b0a23-be39-5e33-a7e0-ca57fb9a21db" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432639} {:answer/id #uuid "a3251647-5a25-5014-86dc-0d1aa75cf482" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432643} {:answer/id #uuid "eb1e7480-42fe-5890-a5bb-345d5a5e89d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432665}] :answer-field/correct {:answer/id #uuid "1365d528-3559-5e8c-aab0-a5fb4cd1c0ed" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432601} :answer-field/id #uuid "cc13ac3c-08d2-5ebd-90fb-f6bd2706df71" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432684}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d9f5142-140d-5b22-b957-299741979b12" :question/math-academy-id "q-107888" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. ${\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$\n\nII. ${\\int }_{0}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}\\,\\text{d}t$\n\nIII. ${\\int }_{1}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$" :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\n- Integral II matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\n- Integral III does *not* match the definition. The lower bound of integration does not match that given in the definition.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186432688 :knowledge-point/_questions [{:db/id 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1856db13-851f-5360-910f-bf03676b767e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432605} {:answer/id #uuid "84881f19-e080-51af-af16-c6329de4fc2b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432633} {:answer/id #uuid "b379c0cc-13d0-5691-88bb-9751f4bddd0c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432646} {:answer/id #uuid "d2b3b242-9319-53aa-a973-839696610da3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432657} {:answer/id #uuid "fc84e2ce-01a3-5748-b7d2-641711b82cc4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432671}] :answer-field/correct {:answer/id #uuid "fc84e2ce-01a3-5748-b7d2-641711b82cc4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432671} :answer-field/id #uuid "b6d3a595-3c97-56e6-b4e9-37484ca30241" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432681}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2346f7c5-c1ac-509c-ac43-d1a23908e3df" :question/math-academy-id "q-107833" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. ${\\int }_{0}^{\\infty }\\frac{{e}^{-t}}{{t}^{z-1}}\\,\\text{d}t$\n\nII. ${\\int }_{1}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}\\,\\text{d}t$\n\nIII. ${\\int }_{0}^{\\infty }\\frac{\\text{d}t}{{t}^{1-z}{e}^{t}}$" :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I does *not* match the definition. The integrand $\\frac{{e}^{t}}{{t}^{z-1}}$ is not equivalent to that shown in the definition.\n\n- Integral II does *not* match the definition.  The lower bound of integration does not match that given in the definition.\n\n- Integral III matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }\\frac{\\text{d}t}{{t}^{1-z}{e}^{t}}={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186432690 :knowledge-point/_questions [{:db/id 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "509a5a08-2a17-53d6-bfc0-859e810cfe28" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432617} {:answer/id #uuid "c2e73fb0-5e26-5b77-80d8-96d4ac256043" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432653} {:answer/id #uuid "c892a373-7ca8-579b-9d31-e6a6a98294b8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432654} {:answer/id #uuid "d21e8d2c-6a2c-503f-b857-9d2fb05ebfc0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432656} {:answer/id #uuid "dc3851a5-2ba9-5c44-a866-bd435cfdc216" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432662}] :answer-field/correct {:answer/id #uuid "dc3851a5-2ba9-5c44-a866-bd435cfdc216" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432662} :answer-field/id #uuid "259c3d61-272b-5770-a437-91dfc25962d6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432674}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43b66f9d-fca5-54ae-b724-0bc204fa830b" :question/math-academy-id "q-107829" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. ${\\int }_{0}^{\\infty }\\frac{{e}^{-t}}{{t}^{1-z}}\\,\\text{d}t$\n\nII. ${\\int }_{-1}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$\n\nIII. ${\\int }_{0}^{\\infty }{t}^{z-1}{e}^{t}\\,\\text{d}t$" :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I matches the definition:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-t}}{{t}^{1-z}}={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\\end{aligned}\n$$\n\n- Integral II does *not* match the definition. The lower bound of integration does not match that given in the definition.\n\n- Integral III does *not* match the definition. The integrand ${t}^{z-1}{e}^{t}$ is not equivalent to that shown in the definition.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186432693 :knowledge-point/_questions [{:db/id 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d9f6e2a-09b6-5d76-a955-98ec83b942b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432608} {:answer/id #uuid "3517e5b4-f44f-5fdf-86dc-8c2764fac2fa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432611} {:answer/id #uuid "a20ca137-1425-5eff-b510-77f79db5e4cd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432642} {:answer/id #uuid "b47c0721-18a4-54a8-9623-8b427d44e5c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432647} {:answer/id #uuid "cc2337a1-6657-5fe8-b450-b5748ff50406" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432655}] :answer-field/correct {:answer/id #uuid "3517e5b4-f44f-5fdf-86dc-8c2764fac2fa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432611} :answer-field/id #uuid "827e9169-511c-5ab4-8026-8070fee5eb71" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432677}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8aae46a7-7405-5484-9202-26c3555ea95d" :question/math-academy-id "q-107832" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. ${\\int }_{0}^{\\infty }\\frac{{e}^{t}}{{t}^{z-1}}\\,\\text{d}t$\n\nII. ${\\int }_{0}^{\\infty }\\frac{{t}^{z}}{t{e}^{t}}\\,\\text{d}t$\n\nIII. ${\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$" :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I does *not* match the definition. The integrand $\\frac{{e}^{t}}{{t}^{z-1}}$ is not equivalent to that shown in the definition.\n\n- Integral II matches the definition:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{t}^{z}}{t{e}^{t}}\\,\\text{d}t={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\\end{aligned}\n$$\n\n- Integral III matches the definition:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186432698 :knowledge-point/_questions [{:db/id 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14bc919f-37b1-5bfd-9092-4f4fec1c9b34" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432602} {:answer/id #uuid "45349eef-8d3d-5379-9b8b-6f793b4003b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432613} {:answer/id #uuid "7c6629d0-7785-58c3-802f-ce326ee02b82" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432629} {:answer/id #uuid "9db4a047-e2d4-57ce-acfe-2fdba69d4b5f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432641} {:answer/id #uuid "f33dd163-2dc5-5312-88c8-a108bb20e78c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432667}] :answer-field/correct {:answer/id #uuid "45349eef-8d3d-5379-9b8b-6f793b4003b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432613} :answer-field/id #uuid "9a6b14e4-15be-5db4-bf56-15f3f68a2ded" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432679}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef7933ca-459a-5897-8c5b-5b08b877b68b" :question/math-academy-id "q-107838" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. $3{\\int }_{0}^{\\infty }\\frac{{t}^{3z-1}}{{e}^{{t}^{3}}}\\,\\text{d}t$\n\nII. $3{\\int }_{0}^{\\infty }{t}^{3z-3}{e}^{-{t}^{3}}\\,\\text{d}t$\n\nIII. $3{\\int }_{1}^{\\infty }{t}^{3z-1}{e}^{-t}\\,\\text{d}t$" :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I matches the definition. We use a substitution $s={t}^{3},$ then $3{t}^{2}\\,\\text{d}t=\\text{d}s.$ We get\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\infty }{t}^{3z-1}{e}^{-{t}^{3}}\\,\\text{d}t & =3{\\int }_{0}^{\\infty }{t}^{3(z-1)+2}{e}^{-{t}^{3}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{t}^{3(z-1)}{e}^{-{t}^{3}}(3{t}^{2})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{s}^{z-1}{e}^{-s}\\,\\text{d}s=Γ(z).\\end{aligned}\n$$\n\n- Integral II does *not* match the definition. The integrand ${t}^{3z-3}{e}^{-{t}^{3}}$ is not equivalent to that shown in the definition.\n\n- Integral III does *not* match the definition. The lower bound of integration does not match that given in the definition.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186432784 :knowledge-point/_questions [{:db/id 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0824af39-0a58-5fec-8302-2b373df3fa24" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432703} {:answer/id #uuid "26a8e07f-ee0c-58eb-acee-0d8cb6326d6d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432711} {:answer/id #uuid "74ecb98c-2302-52b1-84cb-fe92e0a75c2e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432729} {:answer/id #uuid "a021fc0f-eddd-5f0b-a490-7a7f0b22625a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432735} {:answer/id #uuid "a0b29be8-0567-54d4-bc06-142c25c9b300" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432736}] :answer-field/correct {:answer/id #uuid "a0b29be8-0567-54d4-bc06-142c25c9b300" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432736} :answer-field/id #uuid "29867889-7002-50db-af77-0b557c31bf47" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432772}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d92850b-bd66-52a9-a628-fb23ae6c0162" :question/math-academy-id "q-223458" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $276$\n\nII. $647$\n\nIII. $805$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $276,$ we have that \n\n$$\n27-2(6)=27-12=15\n$$\n\nwhich is not divisible by $7.$ Therefore, $276$ is not divisible by $7.$\n\n- For the number $647,$ we have that \n\n$$\n64-2(7)=64-14=50\n$$\n\nwhich is not divisible by $7.$ Therefore, $647$ is not divisible by $7.$\n\n- For the number $805,$ we have that \n\n$$\n80-2(5)=80-10=70\n$$\n\nwhich is divisible by $7.$ Therefore, $805$ is divisible by $7.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186432785 :knowledge-point/_questions [{:db/id 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "395f542f-a2cc-5548-a43d-640b9cf58085" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432717} {:answer/id #uuid "507fa32c-4749-5d72-9fa6-d23768d5f02e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432721} {:answer/id #uuid "995d4239-9221-5924-87b4-04783d3524d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186432733} {:answer/id #uuid "a4c84267-e3ef-5e7d-a900-0c207f03e3dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432738} {:answer/id #uuid "e5414113-8a82-5922-b990-18a21eb0033e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186432759}] :answer-field/correct {:answer/id #uuid "a4c84267-e3ef-5e7d-a900-0c207f03e3dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432738} :answer-field/id #uuid "118061fa-f4fb-5c4a-8157-a3d01d37bb53" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432770}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "245a9f1f-3fc0-594c-a273-205b94f4bf02" :question/math-academy-id "q-132405" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $185\\,346$\n\nII. $2\\,525\\,934$\n\nIII. $15\\,070\\,962$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $185\\,346$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+8+5+3+4+6=27\n$$\n\nSo, $185\\,346$ is divisible by $6.$\n\n- The number $2\\,525\\,934$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n2+5+2+5+9+3+4=30\n$$\n\nSo, $2\\,525\\,934$ is divisible by $6.$\n\n- The number $15\\,070\\,962$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+5+0+7+0+9+6+2=30\n$$\n\nSo, $15\\,070\\,962$ is divisible by $6.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186432786 :knowledge-point/_questions [{:db/id 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149ea1cb-e01d-5802-a028-00d7e8a540c1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186432706} {:answer/id #uuid "36d91072-cbcb-50c7-a7c3-d3eb2bc27ed2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432716} {:answer/id #uuid "e33d63b8-9632-5974-8d28-9b8bceb357a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432758} {:answer/id #uuid "f44b8d56-143e-5cc7-b349-09ed4c123545" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432765} {:answer/id #uuid "fd87e2f0-0eb6-506b-a7f5-68956058c004" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432768}] :answer-field/correct {:answer/id #uuid "fd87e2f0-0eb6-506b-a7f5-68956058c004" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432768} :answer-field/id #uuid "345c84c1-3b26-5e71-9c91-d17afe953859" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432775}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66ca27c6-8cac-5ac3-b80e-6fd1dcb7b6a5" :question/math-academy-id "q-85424" :question/problem "Which digits, when inserted into the blank, make the number $591\\,030\\,47◻$ divisible by $6?$\n\nI. $2$\n\nII. $5$\n\nIII. $4$" :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n5+9+1+0+3+0+4+7+◻=29+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $2$ into the blank, we get $591\\,030\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $29+2=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $5$ into the blank, we get $591\\,030\\,475,$ which is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- If we substitute $4$ into the blank, we get $591\\,030\\,474,$ which is divisible by $2.$ The sum of the digits is $29+4=33,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186432787 :knowledge-point/_questions [{:db/id 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023e8ca5-d704-5d99-b064-aeb77c93d254" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432700} {:answer/id #uuid "2022291e-1db1-5780-8ab9-edc149d22ea2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id 17592186432709} {:answer/id #uuid "2e82d512-84f1-533e-a037-9f343f12a528" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432714} {:answer/id #uuid "dc070f7d-66ad-5425-aa52-08341f6869d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432757} {:answer/id #uuid "f8032825-bbee-58b1-b581-15121282664c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I  and II only" :db/id 17592186432766}] :answer-field/correct {:answer/id #uuid "dc070f7d-66ad-5425-aa52-08341f6869d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432757} :answer-field/id #uuid "ad4a570e-3aef-54f0-a307-e26d4ea86c53" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432778}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6daa78eb-7b75-5f11-9d14-72a95f4ad0c2" :question/math-academy-id "q-223454" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $434$\n\nII. $785$\n\nIII. $587$" :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $434,$ we have that \n\n$$\n43-2(4)=43-8=35\n$$\n\nwhich is divisible by $7.$ Therefore, $434$ is divisible by $7.$\n\n- For the number $785,$ we have that \n\n$$\n78-2(5)=78-10=68\n$$\n\nwhich is not divisible by $7.$ Therefore, $785$ is not divisible by $7.$\n\n- For the number $587,$ we have that \n\n$$\n58-2(7)=58-14=44\n$$\n\nwhich is not divisible by $7.$ Therefore, $587$ is not divisible by $7.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186432788 :knowledge-point/_questions [{:db/id 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0120a1f8-aa48-5ed0-8305-31cbb2b1f611" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186432699} {:answer/id #uuid "444908dd-fb48-51a9-b264-374c7d885080" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432718} {:answer/id #uuid "53497952-583e-5109-a21b-c6bd9897e804" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432723} {:answer/id #uuid "aebf6a52-e58b-5a25-b8d3-5595904827e5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186432741} {:answer/id #uuid "cd965191-d33a-5755-b2e3-4b0b273f31d1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432752}] :answer-field/correct {:answer/id #uuid "53497952-583e-5109-a21b-c6bd9897e804" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432723} :answer-field/id #uuid "6a9354ff-3d30-5d4e-a8f1-a17d95295904" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186432777}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7d8254ce-5d00-53a5-a718-295062329804" :question/math-academy-id "q-85144" :question/problem "Which digits, when inserted into the blank, make the number $173\\,◻32\\,338$ divisible by $9?$\n\nI. $4$\n\nII. $6$\n\nIII. $9$" :question/worked-solution "A number is divisible by $9$ if the sum of its digits is divisible by $9.$\n\nFor the number $173\\,◻32\\,338\\,$ the sum of the digits is\n\n$$\n1+7+3+◻+3+2+3+3+8=30+◻.\n$$\n\nNow, let's consider each of the given digits that could be inserted into the blank.\n\n- If we insert $4$ into the blank, then the sum of the digits is $30+4=34,$ which is *not* divisible by $9.$\n\n- If we insert $6$ into the blank, then the sum of the digits is $30+6=36,$ which is divisible by $9.$\n\n- If we insert $9$ into the blank, then the sum of the digits is $30+9=39,$ which is *not* divisible by $9.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186432789 :knowledge-point/_questions [{:db/id 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a2752c1-636c-52a6-a6d4-6d9b59cbf421" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186432713} {:answer/id #uuid "4d83589b-d420-59c9-bbed-964e663c6b6d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186432720} {:answer/id #uuid "8dac666f-2957-5b5a-bf69-321c0d67de2a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186432732} {:answer/id #uuid "cd42dba0-3bec-5cb3-9