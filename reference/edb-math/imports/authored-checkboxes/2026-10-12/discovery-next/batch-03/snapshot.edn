oint/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095136cd-9ec4-5eec-aeb6-a32639e6e116" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186259959} {:answer/id #uuid "1233ad99-23d2-50a1-a689-497a507fba00" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186260034} {:answer/id #uuid "6bcb23da-cf0c-5c1b-9aa8-fb84076adc1a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id 17592186260819} {:answer/id #uuid "6e6a57d2-3c49-5140-ae33-ef305a735817" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id 17592186260848} {:answer/id #uuid "a2957704-b03a-583f-aec2-987651307313" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186261293}] :answer-field/correct {:answer/id #uuid "a2957704-b03a-583f-aec2-987651307313" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186261293} :answer-field/id #uuid "66694a5c-91e2-54d1-9e97-e65ed2587544" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186262298}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e494fc8-9bc5-580b-afe6-c6a2f464663f" :question/math-academy-id "q-129220" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 & 0 \\\\ 0 & 3 & 0 & 2 & 2 \\\\ 0 & 0 & 0 & -1 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 7 & 4 \\\\ 0 & 0 & -3 \\\\ 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}-1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the first row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=[\\begin{aligned}0 & 0 & 0 & 0 & 0 \\\\ 0 & 3 & 0 & 2 & 2 \\\\ 0 & 0 & 0 & -1 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 7 & 4 \\\\ 0 & 0 & -3 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}-1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, only $A$ is **not** in row echelon form."}] [{:db/id 17592186262991 :knowledge-point/_questions [{:db/id 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c9cce7-67c6-5587-b5f1-1937c6a5584c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186259925} {:answer/id #uuid "431bb6a4-74b4-522c-9581-507da4f380ea" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186260460} {:answer/id #uuid "7e75713f-63fe-54bf-8a29-ed4fd221bdb3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186260973} {:answer/id #uuid "aa4a89ac-dbcf-5361-b9aa-d20e5d4f3516" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186261366} {:answer/id #uuid "f674bdc3-e3c8-5560-bec3-a269e6763d18" :answer/type {:db/id 175