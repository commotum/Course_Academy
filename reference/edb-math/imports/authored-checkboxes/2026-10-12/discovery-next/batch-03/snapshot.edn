n S}f(x,y) & =0.42+0.18+0.33+0.07=1\\,✓\\end{aligned}\n$$\n\n- Condition III is true. Because $f(x,y)$ satisfies conditions I and II, it is a valid probability mass function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id 17592186275143 :knowledge-point/_questions [{:db/id 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2efea082-cab5-5e22-8416-01dc28335241" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186272805} {:answer/id #uuid "88cad6df-9085-5a12-a539-d9298bb39155" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186273566} {:answer/id #uuid "ace63423-b92d-5676-8f7c-bc3fcf46a191" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186273879} {:answer/id #uuid "da5d52a7-5005-5522-b1f0-e88e9eef53fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186274295} {:answer/id #uuid "f777332d-8e8e-5c42-bb13-ee910d07f37d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186274557}] :answer-field/correct {:answer/id #uuid "2efea082-cab5-5e22-8416-01dc28335241" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186272805} :answer-field/id #uuid "36cac13d-8d7d-510d-954b-a77def71bf38" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186274729}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "288fc25f-ba27-5768-8154-a7887a11bc8e" :question/math-academy-id "q-143867" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=2$ | $0.5$ | $0.1$ |\n| $X=3$ | $0.1$ | $0.2$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is false. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.5+0.1+0.1+0.2=0.9\\ne 1\\,\\times \\end{aligned}\n$$\n\n- Condition III is false. Because $f(x,y)$ does not satisfy condition II, it is *not* a valid probability mass function.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186275144 :knowledge-point/_questions [{:db/id 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31f1d221-2dd7-560d-82a2-7d46ae6b176e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186272836} {:answer/id #uuid "4213bce1-76c9-5136-a7d9-04e6c02e40b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186272951} {:answer/id #uuid "8c6589c3-e359-5255-ba4f-727d02078464" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186273598} {:answer/id #uuid "a3c65048-82c6-5cb4-9299-4b16e2ea1a4f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186273798} {:answer/id #uuid "c94e4287-a09e-5eb1-b4c8-3b6e1df00892" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186274133}] :answer-fie