nswer/value "II only" :db/id #edb/ref 17592186412842} {:answer/id #uuid "c2eeae29-6589-5372-9208-8579d86384ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412898} {:answer/id #uuid "c8b963dd-bb5a-5a02-9158-70da5aa07a71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412903} {:answer/id #uuid "fc4562a3-8e24-54b7-820d-6e3b72017105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412928}] :answer-field/correct {:answer/id #uuid "c2eeae29-6589-5372-9208-8579d86384ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412898} :answer-field/id #uuid "99eba53e-9c7a-538e-95be-f63aec7390ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412943}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abd84654-ac2d-58a6-9574-529f2b4aa6f5" :question/math-academy-id "q-78597" :question/problem "Which of the following integers belong to the residue class $[-7]_{11}?$\n\nI. $15$\n\nII. $-4$\n\nIII. $7$" :question/worked-solution "The residue class $[-7]_{11}$ consists of the elements that are congruent to $-7$ modulo $11.$ So, we have\n\n$$\n\\begin{aligned}[-7]_{11} & =\\{x\\in Z\\,|\\,x≡-7\\,(\\text{mod}\\,11)\\} \\\\  & =\\{x\\in Z\\,|\\,x=-7+11k,\\,k\\in Z\\} \\\\  & =\\{-7+11k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,-7-2\\cdot 11,\\,-7-11,\\,-7,\\,-7+11,\\,-7+2\\cdot 11,\\,…\\} \\\\  & =\\{…,-29,-18,-7,4,15,…\\}.\\end{aligned}\n$$\n\nWe see that $15$ belongs to $[-7]_{11},$ while $-4$ and $7$ do not.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186412975 :knowledge-point/_questions [{:db/id #edb/ref 17592186152098 :knowledge-point/id #uuid "9c1fe7ea-d91e-5440-b756-37a460a18f19" :knowledge-point/title "Identifying Residue Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412813} {:answer/id #uuid "5a19bf7b-22db-564c-aa73-f6a7de2af57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412847} {:answer/id #uuid "82922433-61e5-5a62-9698-a3b819a7b545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186412867} {:answer/id #uuid "d3d30caf-3e16-5777-b064-513d0c56a4fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412911} {:answer/id #uuid "d4ca8877-62b9-5e77-9a0b-f311eb33c385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412912}] :answer-field/correct {:answer/id #uuid "0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412813} :answer-field/id #uuid "abdf5568-4325-50d1-b367-2f8fd167e6e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412946}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1a9f6cf-cd8d-55d6-a82c-4176e7807557" :question/math-academy-id "q-86027" :question/problem "Which of the following residue classes modulo $10$ contain the integer $-4?$\n\nI. $[4]_{10}$\n\nII. $[-14]_{10}$\n\nIII. $[6]_{10}$" :question/worked-solution "We have $-4\\in [a]_{10}$ if \n\n$$\n-4≡a\\,(\\text{mod}\\,10).\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $-4\\notin [4]_{10}$ because $-4≢4\\,(\\text{mod}\\,10)$ $\\,\\times $\n\n- $-4\\in [-14]_{10}$ because $-4≡-14\\,(\\text{mod}\\,10)$ $\\,✓$\n\n- $-4\\in [6]_{10}$ because $-4≡6\\,(\\text{mod}\\,10)$ $\\,✓$\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186412976 :knowledge-point/_questions [{:db/id #edb/ref 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16580a0c-365e-59a9-9828-bb02a47e8573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412819} {:answer/id #uuid "7e33db2a-1dbd-5414-9540-709392a7913f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412863} {:answer/id #uuid "abb17be0-afe8-5a6d-8ef7-96917a6efd85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186412889} {:answer/id #uuid "b9bdbd57-ea56-5ecb-8fe2-07753e9011a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412893} {:answer/id #uuid "c638689c-94e7-5af8-b84c-75a738f6395e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412902}] :answer-field/correct {:answer/id #uuid "16580a0c-365e-59a9-9828-bb02a47e8573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412819} :answer-field/id #uuid "f2e9f81c-9578-565c-8322-3231a43ad273" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412956}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e91f8fe9-c6f2-558a-bf39-b0389019d5ff" :question/math-academy-id "q-86021" :question/problem "Which of the following integers belong to the residue class $[7]_{11}?$\n\nI. $18$\n\nII. $-4$\n\nIII. $15$" :question/worked-solution "The residue class $[7]_{11}$ consists of the elements that are congruent to $7$ modulo $11.$ So, we have\n\n$$\n\\begin{aligned}[7]_{11} & =\\{x\\in Z\\,|\\,x≡7\\,(\\text{mod}\\,11)\\} \\\\  & =\\{x\\in Z\\,|\\,x=7+11k,\\,k\\in Z\\} \\\\  & =\\{7+11k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,7-2\\cdot 11,\\,7-11,\\,7,\\,7+11,\\,7+2\\cdot 11,…\\} \\\\  & =\\{…,-15,-4,7,18,29,…\\}.\\end{aligned}\n$$\n\nWe see that $-4$ and $18$ belong to $[7]_{11},$ while $15$ does not.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186412999 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3927cd36-e744-5c4b-b518-90f4314da95c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186412980} {:answer/id #uuid "3e0f7a4e-e2de-5221-a243-87d47db94856" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186412981} {:answer/id #uuid "be644adc-7532-5ed2-b8e4-b29d16f2b2a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412989} {:answer/id #uuid "c05a3db1-b2e4-555c-b799-5b9528462b9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412990} {:answer/id #uuid "e77d1188-387d-5333-b099-521dba1d6c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412992}] :answer-field/correct {:answer/id #uuid "e77d1188-387d-5333-b099-521dba1d6c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412992} :answer-field/id #uuid "d49a1696-245b-5c6e-b7fe-d2569b597279" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412996}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e5966d3-ce4d-5835-ab91-1f478e587602" :question/math-academy-id "q-109510" :question/problem "$$\nA=[\\begin{aligned}1 & -1 \\\\ 1 & 3\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\n- $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n- $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n- $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=[\\begin{aligned}1 & -1 \\\\ 1 & 3\\end{aligned}]-2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=[\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}]={{[\\begin{aligned}-5 \\\\ 5\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=[\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-5 \\\\ 5\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}1 \\\\ 4\\end{aligned}]}_{⏟}}_{v}\\overset{\\,A-2I\\,\\,}{\\to }{{[\\begin{aligned}-5 \\\\ 5\\end{aligned}]}_{⏟}}_{w}\\overset{\\,A-2I\\,\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186413341 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47aae119-de52-5a6f-b7a1-ed5cfb5a10e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186413327} {:answer/id #uuid "7c9326e8-8412-5f0f-be79-a57ba80e957f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186413330} {:answer/id #uuid "a3cfc328-4fc1-5747-b490-dfadf05a9a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413332} {:answer/id #uuid "a66e2889-63d9-58f5-b599-fac84f95bb5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413333} {:answer/id #uuid "df465832-9958-51d8-a73c-05aadf6adf21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413335}] :answer-field/correct {:answer/id #uuid "a3cfc328-4fc1-5747-b490-dfadf05a9a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413332} :answer-field/id #uuid "3e7444ba-e9b0-5dc3-868c-f11ef347b50d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413337}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c87590b-cc07-5050-b79f-9ad013757661" :question/math-academy-id "q-88693" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-6}^{6}x\\operatorname{sin}⁡x\\,\\text{d}x$\n- ${\\int }_{-2}^{2}{x}^{3}\\operatorname{cos}⁡x\\,\\text{d}x$\n- ${\\int }_{-1}^{1}{x}^{2}\\operatorname{tan}⁡x\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=x\\operatorname{sin}⁡x$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)\\operatorname{sin}⁡(-x) \\\\  & =-x(-\\operatorname{sin}⁡x) \\\\  & =x\\operatorname{sin}⁡x \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)={x}^{3}\\operatorname{cos}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)^{3}\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}\\operatorname{cos}⁡x \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nHence, by symmetry, we can conclude that\n\n$$\n{\\int }_{-2}^{2}{x}^{3}\\operatorname{cos}⁡x\\,\\text{d}x=0.\n$$\n\n- The function $h(x)={x}^{2}\\operatorname{tan}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{2}\\operatorname{tan}⁡(-x) \\\\  & ={x}^{2}(-\\operatorname{tan}⁡x) \\\\  & =-{x}^{2}\\operatorname{tan}⁡x \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-1}^{1}{x}^{2}\\operatorname{tan}⁡x\\,\\text{d}x=0.\n$$\n\nHence, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186413343 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "130e6afa-dce0-5b08-819c-ef94704234fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413325} {:answer/id #uuid "376dd84b-186c-5a4f-8a0a-85f3f4cc251e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413326} {:answer/id #uuid "5a0f7606-ed30-5617-8e4d-36a130ebe24b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413328} {:answer/id #uuid "761e54dd-814f-565c-bb2b-669fb57d2836" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413329} {:answer/id #uuid "f5c2246d-16ff-5312-93dd-63dfdff73262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186413336}] :answer-field/correct {:answer/id #uuid "5a0f7606-ed30-5617-8e4d-36a130ebe24b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413328} :answer-field/id #uuid "93e076d5-a5ae-573d-9e84-8303573a1f36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413339}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93763c90-6504-59a6-ad5e-8ed17cc5ac6d" :question/math-academy-id "q-115272" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-1}^{1}{e}^{2x}\\,\\text{d}x$\n- ${\\int }_{0}^{\\pi }\\sqrt[3]{x}\\operatorname{cos}⁡x\\,\\text{d}x$\n- ${\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={e}^{2x}$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & ={e}^{2(-x)} \\\\  & ={e}^{-2x} \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)=\\sqrt[3]{x}\\operatorname{cos}⁡x$ is an odd function, but integral II is not of the form ${\\int }_{-a}^{a}g(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\n- The function $h(x)=x{e}^{{x}^{2}}$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x){e}^{(-x)^{2}} \\\\  & =-x{e}^{{x}^{2}} \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186413605 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ef9340-52d9-5cb4-999f-d1140490bfc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413590} {:answer/id #uuid "7ad62917-fe79-54d5-9e2a-eb52a863023e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186413593} {:answer/id #uuid "a5551b66-4909-5792-8d3d-3a30ec491dc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413596} {:answer/id #uuid "b09a08e9-f214-5a5c-b110-f1010c4b03ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413598} {:answer/id #uuid "c068b9da-8858-56ed-90bd-f563b1b66009" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413599}] :answer-field/correct {:answer/id #uuid "59ef9340-52d9-5cb4-999f-d1140490bfc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413590} :answer-field/id #uuid "a22c5a1e-381b-53d5-9e61-1f0e13b8d114" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413604}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96f65a49-2a61-5981-a404-aa212d4de13c" :question/math-academy-id "q-331097" :question/problem "Which of the following systems of linear ODEs are decoupled?\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+2{x}_{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)=-7{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=9{x}_{2}(t)\\end{aligned}$" :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently. \n\nWith this in mind, let's examine our systems.\n\n- System I is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{1}^{′}(t)=4{x}_{1}(t)+5{x}_{2}(t)$ depends on ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- System II is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)$ depends on ${x}_{2}(t)$ and ${x}_{1}(t).$\n\n- System III is decoupled since its equations depend on only one variable each. Indeed, ${x}_{1}^{′}(t)=-7{x}_{1}(t)$ depends on only ${x}_{1}(t)$ and ${x}_{2}^{′}(t)=9{x}_{2}(t)$ depends on only ${x}_{2}(t).$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186413606 :knowledge-point/_questions [{:db/id #edb/ref 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4677b7a7-7f61-5a88-a5ee-a34ee62c287d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413589} {:answer/id #uuid "91bf1bed-82dd-5957-bd20-b0c4787407e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413594} {:answer/id #uuid "96da30d2-eb7e-540b-b235-30c2de13031a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413595} {:answer/id #uuid "ad2050e5-3099-5de8-9248-cf99c56b8941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413597} {:answer/id #uuid "c90c80ee-ce2e-5334-9b0a-1654558fcf8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186413600}] :answer-field/correct {:answer/id #uuid "c90c80ee-ce2e-5334-9b0a-1654558fcf8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186413600} :answer-field/id #uuid "3adf9e22-bc52-5ded-9787-739dfa3cf328" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413602}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac9ae842-1c73-58e9-9ed3-756e4fa56ec1" :question/math-academy-id "q-331980" :question/problem "Which of the following systems of linear ODEs are decoupled?\n\n- ${x}^{′}(t)=[\\begin{aligned}8 & 0 \\\\ 0 & -1\\end{aligned}]x(t)$\n- ${x}^{′}(t)=[\\begin{aligned}0 & 7 \\\\ -4 & 3\\end{aligned}]x(t)$\n- ${x}^{′}(t)=[\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}]x(t)$" :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently.  \n\nIn matrix form, a linear system ${x}^{′}(t)=Ax(t)$ is decoupled if $A$ is a diagonal matrix.\n\nWith this in mind, let's examine our systems.\n\n- Systems I and III are decoupled since their corresponding matrices are diagonal.\n\n- System II is *not* decoupled because its matrix is not diagonal.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186413694 :knowledge-point/_questions [{:db/id #edb/ref 17592186203903 :knowledge-point/id #uuid "0184c705-00dd-54b0-ba83-2f467167a185" :knowledge-point/title "Interpreting an Adjacency Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277d0727-838a-539b-819b-da8d7ad8d022" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413637} {:answer/id #uuid "2d5c613d-ce6f-5d2f-9d0d-b0d5c7bb9753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413640} {:answer/id #uuid "4593208d-f293-53fc-9281-392ec9c6d5d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186413643} {:answer/id #uuid "d4f8bb88-c52f-5544-9279-0cef54cf414b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413665} {:answer/id #uuid "fa660a92-6489-598b-aa9f-da0f6f998972" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413670}] :answer-field/correct {:answer/id #uuid "d4f8bb88-c52f-5544-9279-0cef54cf414b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413665} :answer-field/id #uuid "c5270f76-2521-5654-804b-ae6bd4a100ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d6ac86-9246-53ae-8020-58de7dcc7070" :question/math-academy-id "q-213094" :question/problem "|  | $✠$ | $♣$ | $♠$ |\n| --- | --- | --- | --- |\n| $✠$ | $0$ | $1$ | $0$ |\n| $♣$ | $1$ | $1$ | $0$ |\n| $♠$ | $0$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{✠,♣,♠\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(✠,♣)$\n\nII. $(♣,♠)$\n\nIII. $(♠,✠)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(✠,♣)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $✠$-row and the $♣$-column.\n\n- The pair $(♣,♠)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $♣$-row and the $♠$-column.\n\n- The pair $(♠,✠)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $♠$-row and the $✠$-column.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186413696 :knowledge-point/_questions [{:db/id #edb/ref 17592186203903 :knowledge-point/id #uuid "0184c705-00dd-54b0-ba83-2f467167a185" :knowledge-point/title "Interpreting an Adjacency Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce382e1-19d7-5210-abc5-29008e719eaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413639} {:answer/id #uuid "7cf02d47-944c-5078-b040-436ef4d1dd79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413649} {:answer/id #uuid "9316338e-177e-596d-813f-c2b271e78ea4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413654} {:answer/id #uuid "d0194c58-f1d2-5a9f-83ca-8ef30dfdeae5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413664} {:answer/id #uuid "e90085ef-ae69-595f-9edc-e65d95950ed1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413667}] :answer-field/correct {:answer/id #uuid "d0194c58-f1d2-5a9f-83ca-8ef30dfdeae5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186413664} :answer-field/id #uuid "90a2eff9-7291-52e7-a8a6-32507eaf07e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e24d1221-5380-50fb-b4e2-6e139d57675a" :question/math-academy-id "q-213100" :question/problem "|  | $3$ | $6$ |\n| --- | --- | --- |\n| $2$ | $1$ | $0$ |\n| $4$ | $0$ | $1$ |\n| $8$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined over the sets $\\{2,4,8\\}$ and $\\{3,6\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(4,3)$\n\nII. $(8,6)$\n\nIII. $(2,3)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(4,3)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $4$-row and the $3$-column.\n\n- The pair $(8,6)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $8$-row and the $6$-column.\n\n- The pair $(2,3)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $2$-row and the $3$-column.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186413824 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18db0a49-6e70-5b48-904f-fb9b5f8f1167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186413801} {:answer/id #uuid "1d8d25d8-fe04-53ff-b342-7ebac143d4d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186413802} {:answer/id #uuid "1dc8f4a4-b6d6-5c99-bf78-b1f7a4d93a23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186413803} {:answer/id #uuid "521a920f-2f8c-531a-965b-1cdb14e91dd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186413807} {:answer/id #uuid "bf0253c3-f269-5021-82aa-caf40ced2760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186413812}] :answer-field/correct {:answer/id #uuid "521a920f-2f8c-531a-965b-1cdb14e91dd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186413807} :answer-field/id #uuid "0f91971d-c20c-5a76-a12b-2827ef0652b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413818}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72e836b6-2968-5b2e-8666-6c15080ad3e0" :question/math-academy-id "q-42005" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{32}\\ne 0$ (condition  II is violated). \n\n$$\nA=[\\begin{aligned}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{21}\\ne 0$ (condition II is violated). \n\n$$\nB=[\\begin{aligned}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\nTherefore, only $C$ is in row echelon form."}] [{:db/id #edb/ref 17592186413825 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bcbaf3a-7d79-5c34-9970-8e30a0164f3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186413798} {:answer/id #uuid "12f4ffe3-c54b-5dec-af7e-f3eb29c5efac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186413800} {:answer/id #uuid "3fd4fdcb-52a1-577b-9cee-a9fa9d18334b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186413805} {:answer/id #uuid "42122353-59f4-5dee-9867-47f69bf794e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186413806} {:answer/id #uuid "e9c227b1-80fa-5ed1-8fcb-7bbadbc92d9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186413817}] :answer-field/correct {:answer/id #uuid "3fd4fdcb-52a1-577b-9cee-a9fa9d18334b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186413805} :answer-field/id #uuid "848d2bf5-7181-5403-afac-d10425ef5d8c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413819}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0f43991-a609-584a-a820-e263b283da38" :question/math-academy-id "q-129230" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}],\\,B=[\\begin{aligned}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{aligned}],\\,C=[\\begin{aligned}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{33}\\ne 0$ (condition II is violated).\n\n$$\nA=[\\begin{aligned}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."}] [{:db/id #edb/ref 17592186414080 :knowledge-point/_questions [{:db/id #edb/ref 17592186161972 :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb51416-f701-5ee9-b8ba-890cb4fc290c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414042} {:answer/id #uuid "41acb45f-a093-5fc2-ab40-01131398008b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414049} {:answer/id #uuid "65247087-2b2c-5c14-9dbe-ed7ca6e9451b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414054} {:answer/id #uuid "87ed7622-25d5-5050-a518-3bf70496d27a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414058} {:answer/id #uuid "e43f6e8e-2053-5481-a5ab-80957e4905bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414070}] :answer-field/correct {:answer/id #uuid "65247087-2b2c-5c14-9dbe-ed7ca6e9451b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414054} :answer-field/id #uuid "27a54542-1615-5cf2-b688-855028ab2529" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414074}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34033db1-99ab-5af1-b893-026e522543dd" :question/math-academy-id "q-93742" :question/problem "Which of the following pairs $(x,y)$ are solutions of the Diophantine equation $2x+5y=200?$\n\n- $(20,32)$\n- $(10,20)$\n- $(15,35)$" :question/worked-solution "Let's check each pair in turn.\n\n- $(20,32)$ is a solution of our equation. Indeed, substituting $x=20$ and $y=32,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 20+5\\cdot 32 & =200 \\\\ 40+160 & =200 \\\\ 200 & =200\\,✓\\end{aligned}\n$$\n\n- $(10,20)$ is *not* a solution of our equation. Substituting $x=10$ and $y=20,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 10+5\\cdot 20 & =200 \\\\ 20+100 & =200 \\\\ 120 & \\ne 200\\,\\times \\end{aligned}\n$$\n\n- $(15,35)$ is *not* a solution of our equation. Substituting $x=15$ and $y=35,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 15+5\\cdot 35 & =200 \\\\ 30+175 & =200 \\\\ 205 & \\ne 200\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186414082 :knowledge-point/_questions [{:db/id #edb/ref 17592186161972 :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07abc408-ee18-502b-a90f-e521c92d5444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414032} {:answer/id #uuid "2e84d745-b17e-5f23-8c44-e7089e4d17bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414041} {:answer/id #uuid "2ecb567a-fcb6-526c-9b17-838593d46ffd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414043} {:answer/id #uuid "85dc5b85-bf5d-505f-956c-d202e6c5d13c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414056} {:answer/id #uuid "d8a09bfe-6607-5557-a5c2-06953c88c2fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414067}] :answer-field/correct {:answer/id #uuid "07abc408-ee18-502b-a90f-e521c92d5444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414032} :answer-field/id #uuid "bf0b86e1-db82-5c78-85bb-75796ef36d8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414079}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "689613bd-55bf-5236-b19b-6e6b928e5d1e" :question/math-academy-id "q-93737" :question/problem "Which of the following pairs $(x,y)$ are solutions of the Diophantine equation $5x+6y=8?$\n\n- $(-2,2)$\n- $(-8,8)$\n- $(4,-4)$" :question/worked-solution "Let's check each pair in turn.\n\n- $(4,-4)$ is *not* a solution of our equation. Substituting $x=4$ and $y=-4,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot (-2)+6\\cdot 2 & =8 \\\\ -10+12 & =8 \\\\ 2 & \\ne 8\\,\\times \\end{aligned}\n$$\n\n- $(-8,8)$ is a solution of our equation. Indeed, substituting $x=-8$ and $y=8,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot (-8)+6\\cdot 8 & =8 \\\\ -40+48 & =8 \\\\ 8 & =8\\,✓\\end{aligned}\n$$\n\n- $(4,-4)$ is *not* a solution of our equation. Substituting $x=4$ and $y=-4,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot 4+6\\cdot (-4) & =8 \\\\ 20-24 & =8 \\\\ -4 & \\ne 8\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186414084 :knowledge-point/_questions [{:db/id #edb/ref 17592186161973 :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c8e6c9-5823-57e7-8ad2-0d7ac46b2c00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414052} {:answer/id #uuid "9f23f971-84cb-5faa-bf04-60cc62e01518" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414060} {:answer/id #uuid "ab08ae5d-b81b-5b7f-b1e4-9f36ba4fc633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414061} {:answer/id #uuid "b9898d7c-59fd-5844-a876-adc80cd213d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414064} {:answer/id #uuid "c4b165e3-3c82-579e-ad3e-21b5708e8e22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414066}] :answer-field/correct {:answer/id #uuid "b9898d7c-59fd-5844-a876-adc80cd213d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414064} :answer-field/id #uuid "04b66cf6-b8c7-535c-9714-7a3946dba362" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414073}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8955bc35-57b9-5c55-b8c0-47deb511cca7" :question/math-academy-id "q-93798" :question/problem "Which of the following Diophantine equations have solutions?\n\n- $15x-20y=5$\n- $11x+9y=13$\n- $-8x+2y=5$" :question/worked-solution "Recall that a linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d\\,|\\,c,$ where $d=\\text{gcd}(a,b).$  \n\nWith that in mind, let's examine each equation in turn.\n\n- Equation I has solutions. We have $a=15,$ $b=-20,$ and $c=5.$ Since\n\n$$\nd=\\text{gcd}(15,-20)=5\n$$\n\nand $5\\,|\\,5,$ our equation has solutions.\n\n- Equation II has solutions. We have $a=11,$ $b=9,$ and $c=13.$ Since\n\n$$\nd=\\text{gcd}(11,9)=1\n$$\n\nand $1\\,|\\,13,$ our equation has solutions.\n\n- Equation III has no solution. We have $a=-8,$ $b=2,$ and $c=5.$ Since\n\n$$\nd=\\text{gcd}(-8,2)=2\n$$\n\nand $2\\,\\text{⧸}|\\,5,$ our equation has no solution.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186414086 :knowledge-point/_questions [{:db/id #edb/ref 17592186161973 :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92dff5ed-0d2c-5156-a7ca-7703fc0fab34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414059} {:answer/id #uuid "b5f6c676-3fd9-5b33-83a6-e0dcdebbe09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414063} {:answer/id #uuid "bcb1e6e3-02dc-5bea-b18b-2336e2272aa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414065} {:answer/id #uuid "e1ed957f-886a-57c2-ba08-09950665c10e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414069} {:answer/id #uuid "e57da4e8-7a71-56f7-a258-a56df2090f60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414071}] :answer-field/correct {:answer/id #uuid "e1ed957f-886a-57c2-ba08-09950665c10e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414069} :answer-field/id #uuid "bc69eb91-457d-5ddb-86de-21120a732fea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414078}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccf1e2c5-efff-5b3d-ba7c-30f178649720" :question/math-academy-id "q-93795" :question/problem "Which of the following Diophantine equations have solutions?\n\n- $3x+7y=11$\n- $-3x-9y=2$\n- $-12x+15y=21$" :question/worked-solution "Recall that a linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d\\,|\\,c,$ where $d=\\text{gcd}(a,b).$  \n\nWith that in mind, let's examine each equation in turn.\n\n- Equation I has solutions. We have $a=3,$ $b=7,$ and $c=11.$ Since\n\n$$\nd=\\text{gcd}(3,7)=1\n$$\n\nand $1\\,|\\,11,$ our equation has solutions.\n\n- Equation II has no solution. We have $a=-3,$ $b=-9,$ and $c=2.$ Since\n\n$$\nd=\\text{gcd}(-3,-9)=3\n$$\n\nand $3\\,\\text{⧸}|\\,2,$ our equation has no solution.\n\n- Equation III has solutions. We have $a=-12,$ $b=15,$ and $c=21.$ Since\n\n$$\nd=\\text{gcd}(-12,15)=3\n$$\n\nand $3\\,|\\,21,$ our equation has solutions.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186414783 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bc8b4d-f0f8-5fac-bc3c-b53d54ae5ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414761} {:answer/id #uuid "3c0520e3-100c-511f-93d0-03184b36355c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414763} {:answer/id #uuid "8144e151-6edf-5a1d-8dd9-4ccdae692873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414769} {:answer/id #uuid "bcc5db05-604b-529c-8451-c58c3b5d86ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414774} {:answer/id #uuid "f6a3761a-c3e7-5d2a-bf18-a0bf7771e015" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414776}] :answer-field/correct {:answer/id #uuid "bcc5db05-604b-529c-8451-c58c3b5d86ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414774} :answer-field/id #uuid "67e57e20-93cb-5386-9ed7-6c9b4b0bdca5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414781}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b65bfe0-6178-564e-825d-19d4ac9443d8" :question/math-academy-id "q-150012" :question/problem "![](images/5a/5a3961346a4bcb0d94e46caf6d6ed1253dc56fb4761db07b11829e329bc2fa8d.png)\n\nConsider the part of parabola and constant vector field $F$ shown above. Let $C$ be the path where the part of parabola is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{C}F\\cdot \\text{d}r=0$\n- ${\\int }_{-C}F\\cdot \\text{d}r<0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I is false, while statement II is true. As the particle moves from $A$ to $B,$ the force $F$ works against the particle for $x>0,$ while $F$  works with the particle for $x<0.$ \n\n![](images/af/af80eab6427f376084301c03715fd098cfe4a1c816dcd72d3e1129cfa35ff29d.png)\n\n \n\nBy symmetry, the contribution to ${\\int }_{C}F\\cdot \\text{d}r$ for $x<0$ is canceled out by the contribution for $x>0.$ So,\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/a2/a26ca79400bf30aa891543d30a052a6e8ec071ccb48fcd8c418fe0a713dad212.png)\n\n \n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186414784 :knowledge-point/_questions [{:db/id #edb/ref 17592186179742 :knowledge-point/id #uuid "3d72127a-90d6-5f7e-bd87-75d03285a918" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Non-Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4db111dc-7fb9-5c06-a206-7d58841220c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414765} {:answer/id #uuid "82abd5c1-cc03-5998-9437-7d38d9e12857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414770} {:answer/id #uuid "976abf9b-c560-5ddc-b4bb-7ea781964fe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414772} {:answer/id #uuid "af7374c1-bbc9-5667-8fae-9fa461dd705e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414773} {:answer/id #uuid "fe95e432-23b7-59d4-a759-3918bb1469c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414778}] :answer-field/correct {:answer/id #uuid "fe95e432-23b7-59d4-a759-3918bb1469c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414778} :answer-field/id #uuid "5e2527fd-1520-5814-b1fe-d6567b06be4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414780}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "277ca4a2-1c02-58e4-b62f-d0e1176e96df" :question/math-academy-id "q-125499" :question/problem "![](images/8f/8ffc97d4fc442503eb5b59e01f317cc7a77cf57d041e16807aa0645f962a5aeb.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the three-quarter circle is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r>0$\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true while statement II is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/c9/c9805268d9f4984983c3cc5e2200a0c22d804bc67076a3505ad35471693c037b.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- Statement III is false. It's clear from the picture below that $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/da/dafb4d468e7711a804a5141301a02331bb5c7900f018a8ecdb6fd382bc05b799.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186414785 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0647548c-ab35-55bf-8337-73e7e06109dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414759} {:answer/id #uuid "3a3dd4f2-011a-5611-b73e-e1b9ef1410fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414762} {:answer/id #uuid "4ac9c12e-cbbb-514a-b111-e9429b33ce3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414764} {:answer/id #uuid "6380a10c-e9d4-5ea5-a9f8-8c37bb4a89e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414766} {:answer/id #uuid "689a0458-ab87-58e4-b08d-14a6818e5b9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414768}] :answer-field/correct {:answer/id #uuid "6380a10c-e9d4-5ea5-a9f8-8c37bb4a89e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414766} :answer-field/id #uuid "07d2442a-7c11-598e-bd53-633db4a8551d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "429525c1-21c9-588e-9357-69745fab8529" :question/math-academy-id "q-125488" :question/problem "![](images/f7/f712612e5cf628e2cf6f2aac5195bf98b620edee4cab1791829a4ade13bcee15.png)\n\nConsider the vector field $F$ shown above, and let $C$ be the path along the segment $\\overset{―}{AB}$ traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r>0$\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement II is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/87/8726ab8c3d764016e1bfa5206769674b6809ab3ea047b03734ae5141f0b553b9.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- Statement III is false. It's clear from the picture below that if we reverse the orientation of $C,$ then $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/56/56e77c37324ca2f28c0a09d762d1e5e1f4a29f5f00695e5cbadca748d92b1c6f.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186414786 :knowledge-point/_questions [{:db/id #edb/ref 17592186179742 :knowledge-point/id #uuid "3d72127a-90d6-5f7e-bd87-75d03285a918" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Non-Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1643f0dc-f7e7-5dad-a5b8-aae4b765e7d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414760} {:answer/id #uuid "68101330-8a2c-5b91-a587-3cdb07c9e267" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414767} {:answer/id #uuid "945c7fb5-ffad-5ef7-8bdb-b1a3bf71f097" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414771} {:answer/id #uuid "c1849629-2bb6-5ec1-9c2e-547f226eb5e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414775} {:answer/id #uuid "fdbf4f19-642b-5af3-8c6c-71292db7385f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414777}] :answer-field/correct {:answer/id #uuid "1643f0dc-f7e7-5dad-a5b8-aae4b765e7d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414760} :answer-field/id #uuid "ff707b18-5e56-5002-82ef-862a25939ae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7554a362-8a42-5a06-a982-68a08488fe59" :question/math-academy-id "q-125687" :question/problem "![](images/1b/1ba55883d76b7e48148febcf6203a987575e78179c2fcde1963ab9db34a37738.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the сurve is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r>0$\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false while statement II is true. It's clear from the picture below that $F$  works against the motion of the particle as it moves from $A$ to $B.$\n\n![](images/e7/e783fb958f01da9552ef4258adf4bed1f7b083520ad9a59082b5479dc2fc7d40.png)\n\nSo, ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\n- Statement III is true. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $B$ to $A.$\n\n![](images/20/20798c6992f536d4f280243746f8599bd4589bd69e253caeed65150b8a9944b7.png)\n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186415050 :knowledge-point/_questions [{:db/id #edb/ref 17592186152095 :knowledge-point/id #uuid "4f567e86-63a5-512d-b830-be97bedcf0c8" :knowledge-point/title "Using the Second Division Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab1a91d-d33a-5e51-b220-e0e4da05d420" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414931} {:answer/id #uuid "a0f6d41d-dc0c-54e9-864e-febae8295631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414985} {:answer/id #uuid "a3d03008-076d-5979-8ec2-d15997b802f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414986} {:answer/id #uuid "ee51c39b-f541-5db9-9b1d-bc0125830007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415009} {:answer/id #uuid "f95294ea-d39c-5f5e-8043-8a30f497210f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415014}] :answer-field/correct {:answer/id #uuid "a0f6d41d-dc0c-54e9-864e-febae8295631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414985} :answer-field/id #uuid "185bfed6-c6e9-5751-adee-92e27148dc54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415021}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cdd37720-ffc4-552d-8b81-f3aa2f866efb" :question/math-academy-id "q-103026" :question/problem "If \n$ka≡kb\\,(\\text{mod}\\,8)$\nis equivalent to\n$a≡b\\,(\\text{mod}\\,8),$\nwhich of the following could be the value of $k?$\n\nI. $k=8$\n\nII. $k=-12$\n\nIII. $k=-15$" :question/worked-solution "The division property of modular arithmetic states that\n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n)\n$$\n\nprovided that $k$ and $n$ are coprime. In other words, we require $\\text{gcd}(k,n)=1.$\n\nIn this case, the modulus $n=8.$ Let's consider each value of $k$ in turn.\n\n- If $k=8,$ then $\\text{gcd}(k,n)=\\text{gcd}(8,8)=8\\ne 1.$ Therefore, our equivalence is *not* valid for $k=8.$\n\n- If $k=-12,$ then $\\text{gcd}(k,n)=\\text{gcd}(-12,8)=4\\ne 1.$ Therefore, our equivalence is *not* valid for $k=-12.$\n\n- If $k=-15,$ then $\\text{gcd}(k,n)=\\text{gcd}(-15,8)=1.$ Therefore, our equivalence is valid for $k=-15.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186415053 :knowledge-point/_questions [{:db/id #edb/ref 17592186152095 :knowledge-point/id #uuid "4f567e86-63a5-512d-b830-be97bedcf0c8" :knowledge-point/title "Using the Second Division Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d32cab0-a947-5df3-b52a-1e20d4a89706" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414933} {:answer/id #uuid "19a4b986-70e3-5216-b16f-03a5fda6657d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414939} {:answer/id #uuid "5a04721a-ae8a-5b6e-8878-aabea63fdaaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414956} {:answer/id #uuid "636fa707-191d-5267-8fee-440385919afb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414961} {:answer/id #uuid "a4b3e191-4f8f-5513-9308-e68abbfe8bcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414987}] :answer-field/correct {:answer/id #uuid "a4b3e191-4f8f-5513-9308-e68abbfe8bcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414987} :answer-field/id #uuid "68b518f5-1d9e-5140-a83d-d1e076453bbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415029}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eaf9f361-8af6-5a67-abf5-86a0bbac7a1d" :question/math-academy-id "q-103018" :question/problem "If \n$ka≡kb\\,(\\text{mod}\\,10)$\nis equivalent to\n$a≡b\\,(\\text{mod}\\,10),$\nwhich of the following could be the value of $k?$\n\nI. $k=12$\n\nII. $k=3$\n\nIII. $k=-5$" :question/worked-solution "The division property of modular arithmetic states that\n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n)\n$$\n\nprovided that $k$ and $n$ are coprime. In other words, we require $\\text{gcd}(k,n)=1.$\n\nIn this case, the modulus $n=10.$ Let's consider each value of $k$ in turn.\n\n- If $k=12,$ then $\\text{gcd}(k,n)=\\text{gcd}(12,10)=2\\ne 1.$ Therefore, our equivalence is *not* valid for $k=12.$\n\n- If $k=3,$ then $\\text{gcd}(k,n)=\\text{gcd}(3,10)=1.$ Therefore, our equivalence is valid for $k=3.$\n\n- If $k=-5,$ then $\\text{gcd}(k,n)=\\text{gcd}(-5,10)=5\\ne 1.$ Therefore, our equivalence is *not* valid for $k=-5.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186415156 :knowledge-point/_questions [{:db/id #edb/ref 17592186198449 :knowledge-point/id #uuid "b4a5d6b1-e76a-5b33-8973-04d1d9062dc6" :knowledge-point/title "Identifying the Orthogonality of a Two-Vector Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fce5c53-c88f-5213-9b57-f76cc256d9ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415150} {:answer/id #uuid "75a2a860-9b99-512b-901f-14c2d162a694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186415151} {:answer/id #uuid "87e451be-c0a6-5f4f-8367-e5f2bd3d8579" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186415152} {:answer/id #uuid "a91a4b12-8794-5dbc-b111-cafaa0420df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415153} {:answer/id #uuid "ac673688-1d30-5b45-8f99-0b4b41a43e4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415154}] :answer-field/correct {:answer/id #uuid "ac673688-1d30-5b45-8f99-0b4b41a43e4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415154} :answer-field/id #uuid "288b1ab6-6f15-58b3-8714-e1582f968b3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a7fbace-2464-5d79-be05-e6f28745c3de" :question/math-academy-id "q-178014" :question/problem "$$\n{u}_{1}=[\\begin{aligned}3 \\\\ -6\\end{aligned}],\\,{u}_{2}=[\\begin{aligned}4 \\\\ 2\\end{aligned}]\n$$\n\nConsider the vectors above, and let $Q$ be an orthogonal linear transformation. Which of the following statements are true?\n\n- ${u}_{1}\\cdot {u}_{2}=0$\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthogonal\n- ${Q({u}_{1}),Q({u}_{2})}$ is orthonormal" :question/worked-solution "Since $Q$ is orthogonal, we have that $Q(x)\\cdot Q(y)=x\\cdot y$ for any vectors $x$ and $y.$\n\nThe linear transformation $Q$ being orthogonal is equivalent to the following:\n\n- The matrix $Q$ of transformation $Q$ relative to any orthonormal basis (including the standard basis) of ${R}^{n}$ is orthogonal.\n\n- $||Q(x)||=||x||.$\n\n- If $x⊥y$ then $Q(x)⊥Q(y)$ for any $x,y\\in {R}^{n}.$ In general, $Q$ preserves the angle between any two vectors.\n\n- $Q$ maps any orthogonal (orthonormal) set into an orthogonal (orthonormal) set.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,\n\n$$\n{u}_{1}\\cdot {u}_{2}=[\\begin{aligned}3 \\\\ -6\\end{aligned}]\\cdot [\\begin{aligned}4 \\\\ 2\\end{aligned}]=12-12=0.\n$$\n\n- Statement II is true. Indeed, $Q({u}_{1})⊥Q({u}_{2})$ since\n\n$$\nQ({u}_{1})\\cdot Q({u}_{2})={u}_{1}\\cdot {u}_{2}=0.\n$$\n\n- Statement III is false. Notice that, for example, $Q({u}_{1})$ is not a unit vector since\n\n$$\n‖Q({u}_{1})‖=‖{u}_{1}‖=\\sqrt{{3}^{2}+(-6)^{2}}\\ne 1.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415187 :knowledge-point/_questions [{:db/id #edb/ref 17592186198261 :knowledge-point/id #uuid "0d6db336-845a-506a-b020-cced1b38e23a" :knowledge-point/title "Using Laws Involving Implications and Equivalences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5642c9-3238-501d-b001-abe804dbf74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415164} {:answer/id #uuid "42236876-92a9-57f6-83c9-30fca5f7268d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415169} {:answer/id #uuid "49d6bd5f-dc44-5b25-a899-60660d018a65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415170} {:answer/id #uuid "c9063210-0eaf-5f51-9f26-d06d56f1944e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415178} {:answer/id #uuid "ead9dfa3-e4dc-59d6-a1e9-1696a9df2aa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415179}] :answer-field/correct {:answer/id #uuid "1f5642c9-3238-501d-b001-abe804dbf74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415164} :answer-field/id #uuid "27e45ba6-a42f-5129-95cb-6948d10b75e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415184}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d6a13d3-ad69-5578-b6a3-a3b3842749f5" :question/math-academy-id "q-183354" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $x\\ge 2.$ $\\,$ $B(x):$ $-x\\le -2.$\n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\n- If $x\\ge 2$ then $-x\\le -2,$ and if $-x\\le -2$ then $x\\ge 2.$\n- $x\\ge 2$ is equivalent to $-x\\le -2.$\n- If $x\\ge 2$ then $-x\\le -2,$ or if $-x\\le -2$ then $x\\ge 2.$" :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $x\\ge 2$ if and only if $-x\\le -2.$\n\n- $x\\ge 2$ is equivalent to $-x\\le -2.$\n\n- If $x\\ge 2$ then $-x\\le -2,$ and if $-x\\le -2$ then $x\\ge 2.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415312 :knowledge-point/_questions [{:db/id #edb/ref 17592186179740 :knowledge-point/id #uuid "6f30993e-b5c7-5d8a-9b27-2aed2c9223e1" :knowledge-point/title "Determining the Sign of a Circulation From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d3f253-290b-54bb-babf-a6a6ff8978c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415283} {:answer/id #uuid "587cc8ba-51a2-5f70-b7ab-e29504848366" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415289} {:answer/id #uuid "a2f13577-89cf-5b55-b7e4-ab887172e61d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415296} {:answer/id #uuid "dad516a1-d6d5-51c7-9929-12667a17dd33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415300} {:answer/id #uuid "fe81a0b5-f0a2-514d-9d40-4d11839b169e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415305}] :answer-field/correct {:answer/id #uuid "11d3f253-290b-54bb-babf-a6a6ff8978c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415283} :answer-field/id #uuid "01518b07-f415-5bbf-8b57-bf0d859e6135" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415307}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e8f010b-1d85-5f55-981d-5803f1cc03c7" :question/math-academy-id "q-125645" :question/problem "![](images/98/981d966645eec322afbfe28a5a1f519eeab8b3557692dcce368a87fe748dddd6.png)\n\nConsider the ellipse $E$ and the vector field $F,$ shown above. Let $C$ be any path where $E$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\n- ${∮}_{C}F\\cdot \\text{d}r>0$\n- ${∮}_{-C}F\\cdot \\text{d}r<0$\n- ${∮}_{C}F\\cdot \\text{d}r<0$" :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true, while statement III is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves clockwise along $C.$ \n\n![](images/b2/b2473eb0c505d75d2c448c1a0d714d05d42737ce8d601401e925834a25ae9e14.png)\n\nSo, $Γ={∮}_{C}F\\cdot \\text{d}r>0.$\n\n- Statement II is true. It's clear from the picture below that $F$ works against the motion of the particle as it moves counterclockwise along $C.$\n\n![](images/85/8513d9d15d204b6f63f310a37465d6b8dfb21239ca412bac7d3b9936f2bf5ebf.png)\n\nSo, $Γ={∮}_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415314 :knowledge-point/_questions [{:db/id #edb/ref 17592186179743 :knowledge-point/id #uuid "1da220a9-2afc-5b63-a423-a4d2b3de9567" :knowledge-point/title "Circulation in Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6bbb37-e5ee-59d8-9780-e4f18b4fd703" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186415286} {:answer/id #uuid "3daf5c5a-bb1b-59ca-aa2f-2855f76bd340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415287} {:answer/id #uuid "5d659d54-987d-5ce7-9597-87369b068528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415290} {:answer/id #uuid "68eb45d8-b286-53dc-b61c-d25ed72ae9e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415293} {:answer/id #uuid "e36e6492-906e-584d-9d76-b86aee6f54cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415301}] :answer-field/correct {:answer/id #uuid "68eb45d8-b286-53dc-b61c-d25ed72ae9e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415293} :answer-field/id #uuid "340ffb7b-df1a-5614-b77d-8024725af8e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415309}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "77e87c43-f6db-5082-9277-93ef32960dff" :question/math-academy-id "q-125659" :question/problem "Consider the vector field $F(x,y)=2x\\operatorname{arctan}⁡2y\\,i+\\frac{2{x}^{2}}{1+4{y}^{2}}\\,j.$ Which of the following statements are true?\n\n- $F$ is **not** conservative\n- ${\\int }_{C}F\\cdot \\text{d}r=0$ for any smooth path $C\\in {R}^{2}$\n- ${∮}_{C}F\\cdot \\text{d}r=0$ for any ellipse $C\\in {R}^{2}$" :question/worked-solution "If $F$ is a conservative vector field on ${R}^{2},$ then the circulation $Γ=0$ for any *closed* path $C\\in {R}^{2},$ that is \n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r=0.\n$$\n\nWe notice that $F=P\\,i+Q\\,j$ is a vector field with domain $D={R}^{2}.$ Computing the partial derivatives, we have\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=\\frac{4x}{1+4{y}^{2}}.\n$$\n\nWith that in mind, let's consider each statement in turn:\n\n- Statement I is false. The vector field $F$ is conservative since the partial derivatives are equal and continuous everywhere on ${R}^{2}.$\n\n- Statement II is false, while statement III is true. The result $Γ=0$ applies to closed curves only.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186415476 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143f48c0-a939-5a4c-b987-afdbbefec79a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415447} {:answer/id #uuid "22066df8-6293-5194-a873-db4b694c6674" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415450} {:answer/id #uuid "8e60b08a-cd17-575f-8815-735e23870208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415460} {:answer/id #uuid "b446fc5b-8c89-5d67-acf5-bbcf1be8249d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415462} {:answer/id #uuid "fe594f39-ea49-5697-a493-c1ebeaf625b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415468}] :answer-field/correct {:answer/id #uuid "22066df8-6293-5194-a873-db4b694c6674" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415450} :answer-field/id #uuid "44a7cadd-9704-50b9-80ee-df6bc66a727b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415471}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d883981-f066-5218-a1bf-dd76574de46e" :question/math-academy-id "q-42469" :question/problem "$$\nA=[\\begin{aligned}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{aligned}]\n$$\n\nConsider the matrix given above. Identify **all** of the reasons why one can conclude that $|A|=0?$\n\n- $A$ has proportional columns\n- $A$ has identical rows\n- $A$ has a zero row" :question/worked-solution "Let's examine each of the statements in turn.\n\n- $A$ has proportional columns: \n\n$$\nA=[\\begin{aligned}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{aligned}]\\,✓\n$$\n\n- $A$ does *not* have identical rows.\n\n- $A$ has a zero row: \n\n$$\nA=[\\begin{aligned}3 & -2.05 & 1 \\\\ 0 & 0 & 0 \\\\ 6 & \\sqrt{7} & 2\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186415620 :knowledge-point/_questions [{:db/id #edb/ref 17592186203912 :knowledge-point/id #uuid "04206f72-e018-5925-a58f-179e897595dc" :knowledge-point/title "Determining the Existence of a Multiplicative Inverse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a41fc355-034f-5ded-bdfb-ebfb582a1bda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415595} {:answer/id #uuid "b03c9ec0-7f75-5d97-abbd-94b2869f47ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415596} {:answer/id #uuid "b0c4fbb0-762c-5b67-afd1-1fb5e5110f8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415597} {:answer/id #uuid "d07425cc-ed1f-5b0a-8751-4e3973904462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415600} {:answer/id #uuid "d66363e6-df16-5391-b2d0-6a090267e3a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415601}] :answer-field/correct {:answer/id #uuid "d07425cc-ed1f-5b0a-8751-4e3973904462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415600} :answer-field/id #uuid "d0aef841-96f7-59bb-8f67-62f78c7ca5b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415612}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d34f2bd-1406-50c4-9338-867f1ecca34e" :question/math-academy-id "q-213405" :question/problem "Which of the following integers has a multiplicative inverse modulo $36?$\n\n- $5$\n- $13$\n- $24$" :question/worked-solution "An integer $a$ has a multiplicative inverse modulo $n$ if and only if $a$ and $n$ are coprime, i.e., $\\text{gcd}(a,n)=1.$\n\nWith this in mind, let's examine the given options.\n\n- $5$ has a multiplicative inverse modulo $36$ since $\\text{gcd}(5,36)=1.\\,\\,✓$\n\n- $13$ has a multiplicative inverse modulo $36$ since $\\text{gcd}(13,36)=1.\\,\\,✓$\n\n- $24$ does *not* have a multiplicative inverse modulo $36$ since $\\text{gcd}(24,36)=12\\ne 1.\\,\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415621 :knowledge-point/_questions [{:db/id #edb/ref 17592186203912 :knowledge-point/id #uuid "04206f72-e018-5925-a58f-179e897595dc" :knowledge-point/title "Determining the Existence of a Multiplicative Inverse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161735ec-56d4-5072-8a75-665310f43f19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415586} {:answer/id #uuid "4c5e7ff7-af02-5c83-9cc7-4a20cdd2b462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415587} {:answer/id #uuid "7aad8420-3c48-5474-98cb-d9e00f367a26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186415592} {:answer/id #uuid "b51e64bf-376c-52bb-ac74-2778610f3e9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415598} {:answer/id #uuid "f3f743a1-b3bd-5c44-85bc-086b14acdf8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415603}] :answer-field/correct {:answer/id #uuid "7aad8420-3c48-5474-98cb-d9e00f367a26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186415592} :answer-field/id #uuid "a9802078-fa7f-52a5-a1e5-14125231ee58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af0eb712-6f36-542d-b37c-e07c5fedf4a8" :question/math-academy-id "q-213407" :question/problem "Which of the following integers has a multiplicative inverse modulo $27?$\n\n- $11$\n- $16$\n- $23$" :question/worked-solution "An integer $a$ has a multiplicative inverse modulo $n$ if and only if $a$ and $n$ are coprime, i.e., $\\text{gcd}(a,n)=1.$\n\nWith this in mind, let's examine the given options.\n\n- $11$ has a multiplicative inverse modulo $27$ since $\\text{gcd}(11,27)=1.\\,\\,✓$\n\n- $16$ has a multiplicative inverse modulo $27$ since $\\text{gcd}(16,27)=1.\\,\\,✓$\n\n- $23$ has a multiplicative inverse modulo $27$ since $\\text{gcd}(23,27)=1.\\,\\,✓$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186416064 :knowledge-point/_questions [{:db/id #edb/ref 17592186203920 :knowledge-point/id #uuid "65e9c4fd-dae7-5858-b008-ca0e144fa64a" :knowledge-point/title "Representing Binary Relations Using Digraphs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "229aefd2-11b3-5163-b906-bbd86d424316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415996} {:answer/id #uuid "6bce8261-f995-5f77-9c0b-b77b795f8640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416014} {:answer/id #uuid "781adc97-4ef9-50db-8150-4fb68c77d192" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416015} {:answer/id #uuid "e8456360-6cf3-5dbc-9b03-efff334fe8ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416036} {:answer/id #uuid "fd84b5df-a423-5a5d-ad6d-2ba9d4d34b30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416043}] :answer-field/correct {:answer/id #uuid "229aefd2-11b3-5163-b906-bbd86d424316" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415996} :answer-field/id #uuid "16e4a9b9-ed3e-5143-9ca1-42dbee28c3b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "538c45af-5de6-56ca-85b6-7f902af26d1f" :question/math-academy-id "q-213261" :question/problem "![](images/de/ded4e8a94730585809c5534fee8d401481c919d529a67cd088e96b8797f2b237.png)\n\nThe directed graph of a relation defined on the set $\\{2,5,8\\}$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(2,2)$\n\nII. $(2,8)$\n\nIII. $(8,5)$" :question/worked-solution "A binary relation can be visualized using a directed graph (digraph), where \n\n- the nodes (vertices) of the graph are elements of the underlying set,\n\n- each pair $(x,y)$ from the relation defines an arrow from node $x$ to node $y$,\n\n- each pair $(x,x)$ from the relation defines a loop from node $x$ to itself.\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(2,2)$ belongs to the relation. Indeed, the directed graph has a loop from the node $2$ to itself.\n\n- The pair $(2,8)$ does not belong to the relation since the directed graph does not have an arrow that starts at the node $2$ and ends at the node $8.$\n\n- The pair $(8,5)$ belongs to the relation. Indeed, the directed graph has an arrow that starts at the node $8$ and ends at the node $5.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186416067 :knowledge-point/_questions [{:db/id #edb/ref 17592186203920 :knowledge-point/id #uuid "65e9c4fd-dae7-5858-b008-ca0e144fa64a" :knowledge-point/title "Representing Binary Relations Using Digraphs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1997f0c1-dbf6-5676-9a65-8a59d13b359b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415994} {:answer/id #uuid "4f900224-55b2-5719-9556-cfc3c22bf31d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416006} {:answer/id #uuid "cc702308-7c8f-52c1-8bba-64531db6e716" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416030} {:answer/id #uuid "e38ff878-929d-5ee9-9b71-f303cbb883cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416034} {:answer/id #uuid "e84d09a8-9f4e-5918-a25a-eab0fa6840b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416037}] :answer-field/correct {:answer/id #uuid "1997f0c1-dbf6-5676-9a65-8a59d13b359b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415994} :answer-field/id #uuid "0bc10d4e-de6c-5af8-9374-56bcd531b20c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416047}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ba430a9-b9f3-5dc8-a610-c4d7d7129920" :question/math-academy-id "q-213262" :question/problem "![](images/4b/4b23d63f453246fb606969ba651104097fca785324d5d0fd2203e176dda19fa5.png)\n\nThe directed graph of a relation defined on the set $\\{\\alpha ,\\beta ,\\gamma \\}$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(\\beta ,\\gamma )$\n\nII. $(\\gamma ,\\alpha )$\n\nIII. $(\\alpha ,\\beta )$" :question/worked-solution "A binary relation can be visualized using a directed graph (digraph), where \n\n- the nodes (vertices) of the graph are elements of the underlying set,\n\n- each pair $(x,y)$ from the relation defines an arrow from node $x$ to node $y$,\n\n- each pair $(x,x)$ from the relation defines a loop from node $x$ to itself.\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair  $(\\beta ,\\gamma )$ does not belong to the relation since the directed graph does not have an arrow that starts at the node $\\beta $ and ends at the node $\\gamma .$\n\n- The pair $(\\gamma ,\\alpha )$ does not belong to the relation since the directed graph does not have an arrow that starts at the node $\\gamma $ and ends at the node $\\alpha .$\n\n- The pair $(\\alpha ,\\beta )$ belongs to the relation. Indeed, the directed graph has a an arrow that starts at the node $\\alpha $ and ends at the node $\\beta .$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186416072 :knowledge-point/_questions [{:db/id #edb/ref 17592186203919 :knowledge-point/id #uuid "220647d1-71b8-5d0a-b497-e5d3ad7b6da2" :knowledge-point/title "Representing Binary Relations Using Graphs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13272a5b-2de1-5012-9d4c-d0b6e9760b36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415992} {:answer/id #uuid "26c9b0be-0411-58d9-acc8-3ddc5b99d9ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186415997} {:answer/id #uuid "38c8fc2e-e74c-5869-91a3-f1b2979621f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416002} {:answer/id #uuid "6905a4c0-8040-5b6a-87f7-803e19676be0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416011} {:answer/id #uuid "edbf0707-8642-500c-bb4f-336aa28e52ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416039}] :answer-field/correct {:answer/id #uuid "38c8fc2e-e74c-5869-91a3-f1b2979621f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416002} :answer-field/id #uuid "ca8636af-9023-557c-9e61-5c98ec22e1da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416059}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e27df10f-2205-5c33-84a9-013636e28935" :question/math-academy-id "q-213167" :question/problem "![](images/35/35756183a7b4bf08baffb00d1f35dcc370b0e58831554daafa58d8f3d4359ab6.png)\n\nThe plot of the binary relation $S,$ defined over the set $X=\\{2,4,6\\}$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(2,2)$\n\nII. $(4,4)$\n\nIII. $(6,2)$" :question/worked-solution "A binary relation can be visualized using a plot (or graph), where \n\n- the first set is plotted along the horizontal axis,\n\n- the second set is plotted along the vertical axis, and\n\n- each pair $(x,y)$ from the relation defines a point with coordinates $(x,y)$ on the plot.\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(2,2)$ belongs to the relation. Indeed, the plot contains a point with these coordinates.\n\n- The pair $(4,4)$ does not belong to the relation since the plot does not contain a point with such coordinates.\n\n- The pair $(6,2)$ belongs to the relation. Indeed, the plot contains a point with these coordinates.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186416857 :knowledge-point/_questions [{:db/id #edb/ref 17592186203923 :knowledge-point/id #uuid "306be17f-f950-57e2-9cb7-2b33c8a4929e" :knowledge-point/title "Identifying Reflexive and Irreflexive Relations Over Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab03ed4-fb9b-5074-9880-fe1c53b1877b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186416708} {:answer/id #uuid "2e52c3bd-2b7a-5a24-95b6-a56a7a15447c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186416713} {:answer/id #uuid "b4de6a26-5382-5b6d-bf0e-07b0e5da5b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186416780} {:answer/id #uuid "d6c5b715-7c1c-5058-8ab1-617e85ee6cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186416795} {:answer/id #uuid "f7295677-3fca-59ea-b647-9db4f20d343a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186416808}] :answer-field/correct {:answer/id #uuid "b4de6a26-5382-5b6d-bf0e-07b0e5da5b96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186416780} :answer-field/id #uuid "f7897328-67d4-5121-9241-5f901a3d93b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416847}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "653fba49-a6b9-5e57-b514-cf99f2424cd1" :question/math-academy-id "q-213246" :question/problem "Which of the following relations are reflexive? \n\n- $x\\,R\\,y$ if and only if $x≡2y\\,(\\text{mod}\\,7),$ defined on $Z$\n\n- $x\\,S\\,y$ if and only if $x≡y\\,(\\text{mod}\\,9),$ defined on $Z$\n\n- $x\\,T\\,y$ if and only if $y≡x+2\\,(\\text{mod}\\,6),$ defined on $Z$" :question/worked-solution "A binary relation $R,$ defined on a set $A,$ is \n\n- *reflexive* if $(x,x)\\in R$ for all $x\\in A,$\n\n- *irreflexive* if $(x,x)\\notin R$ for all $x\\in A.$\n\nIf some pairs of the form $(x,x)$ belong to a relation and others do not, then the relation is neither reflexive nor irreflexive.\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is neither reflexive nor irreflexive. Notice that \n\n- $(1,1)\\notin R$ since $1≢2(1)\\,(\\text{mod}\\,7),$ while\n\n- $(7,7)\\in R$ since $7≡2(7)\\,(\\text{mod}\\,7).$\n\n- Relation $S$ is reflexive. Indeed, $(x,x)\\in S$ for all $x\\in Z.$ Notice that \n\n$$\nx≡x\\,(\\text{mod}\\,9)\n$$\n\nfor any $x\\in Z.$\n\n- Relation $T$ is irreflexive. Indeed, $(x,x)\\notin T$ for all $x\\in Z.$ Notice that \n\n$$\nx≢x+2\\,(\\text{mod}\\,6)\n$$\n\nfor any $x\\in Z.$\n\nTherefore, the correct answer is \"$S$ only.\""}] [{:db/id #edb/ref 17592186416858 :knowledge-point/_questions [{:db/id #edb/ref 17592186203923 :knowledge-point/id #uuid "306be17f-f950-57e2-9cb7-2b33c8a4929e" :knowledge-point/title "Identifying Reflexive and Irreflexive Relations Over Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bdce35-1a6d-5b3f-a49e-4f39f1e7cd62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186416711} {:answer/id #uuid "58ae1950-b540-541c-bb35-734835ed6837" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186416731} {:answer/id #uuid "7c2cab9d-46e7-5fca-9e2e-839c1847e800" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186416750} {:answer/id #uuid "a67c2cc7-31d2-5884-b5e7-bd42e8198442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186416774} {:answer/id #uuid "e7d8d161-c088-50a0-8cdb-b2dfab2b3cd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $R$ only" :db/id #edb/ref 17592186416801}] :answer-field/correct {:answer/id #uuid "21bdce35-1a6d-5b3f-a49e-4f39f1e7cd62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186416711} :answer-field/id #uuid "a904c1ac-f48c-541f-87b2-64440b6f4699" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416838}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7095468b-6aec-5ce6-83d1-ea12403a6b5a" :question/math-academy-id "q-213240" :question/problem "Which of the following relations are reflexive? \n\n- $x\\,R\\,y$ if and only if $(x+y)∣10,$ defined on $Z$\n\n- $x\\,S\\,y$ if and only if $4∣({x}^{2}-{y}^{2}),$ defined on $Z$\n\n- $x\\,T\\,y$ if and only if $x∣(y+1),$ defined on $Z$" :question/worked-solution "A binary relation $R,$ defined on a set $A,$ is \n\n- *reflexive* if $(x,x)\\in R$ for all $x\\in A,$\n\n- *irreflexive* if $(x,x)\\notin R$ for all $x\\in A.$\n\nIf some pairs of the form $(x,x)$ belong to a relation and others do not, then the relation is neither reflexive nor irreflexive.\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is neither reflexive nor irreflexive. Notice that \n\n- $(2,2)\\notin R$ since $2+2=4$ and $4∤10,$ while\n\n- $(1,1)\\in R$ since $1+1=2$ and $2∣10.$\n\n- Relation $S$ is reflexive. Indeed, $(x,x)\\in S$ for all $x\\in Z.$ Notice that \n\n$$\n4∣({x}^{2}-{x}^{2})\n$$\n\nfor any $x\\in Z.$\n\n- Relation $T$ is neither reflexive nor irreflexive. Notice that \n\n- $(2,2)\\notin T$ since $2∤(2+1),$ while\n\n- $(1,1)\\in T$ since $1∣(1+1).$\n\nTherefore, the correct answer is \"$S$ only.\""}] [{:db/id #edb/ref 17592186416863 :knowledge-point/_questions [{:db/id #edb/ref 17592186203922 :knowledge-point/id #uuid "d4b47a31-7bda-5366-bac4-1d070776e776" :knowledge-point/title "Identifying Reflexive and Irreflexive Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "003f486a-2600-584c-92ff-478adde52a81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416691} {:answer/id #uuid "4c56e2bb-43ed-5906-85e4-b291c9d37ae8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416727} {:answer/id #uuid "9d2585bc-b01e-5f72-8bd0-21e0708314ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416764} {:answer/id #uuid "a753fcea-864c-5d1d-9515-36b40da1b3f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416775} {:answer/id #uuid "bcc8cdb8-d4be-5768-99b5-0263aa670d03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416785}] :answer-field/correct {:answer/id #uuid "a753fcea-864c-5d1d-9515-36b40da1b3f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416775} :answer-field/id #uuid "50c36a75-cd57-5a00-815a-7d34757ac50b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e1a27c07-b36b-5525-ba6b-847b13ebf516" :question/math-academy-id "q-213228" :question/problem "![](images/03/03ddf06402ad38708d232cf28783c817bf881965d54650eb158e7ffca4ea76a2.png)\n\nWhich of the plots above represent irreflexive relations defined on the set $A=\\{1,2,3\\}?$" :question/worked-solution "A binary relation $R,$ defined on a set $A,$ is \n\n- *reflexive* if $(x,x)\\in R$ for all $x\\in A,$\n\n- *irreflexive* if $(x,x)\\notin R$ for all $x\\in A.$\n\nIf some pairs of the form $(x,x)$ belong to a relation and others do not, then the relation is neither reflexive nor irreflexive.\n\nSince $R$ must be irreflexive, we require \n\n$$\n(1,1)\\notin R,\\,(2,2)\\notin R,\\,(3,3)\\notin R.\n$$\n\nThese ordered pairs correspond to the diagonal points on the plots, as shown below:\n\n![](images/b6/b63d99459e8271e70ec36fd417d67565f3d5e77316815d49c235468e174aa1e9.png)\n\n \n\nA plot corresponding to an irreflexive relation must not contain diagonal points. Therefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186416924 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a14e359-8fcd-5956-94b7-cc4fc5609525" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416874} {:answer/id #uuid "7e200172-34ca-5ab5-a0aa-e59cf6e4d94a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186416884} {:answer/id #uuid "8162f83a-7db2-5f3b-82a9-fd24f5cd3429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416886} {:answer/id #uuid "9432a7e4-d864-5909-96fb-bc5b42aaf049" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416891} {:answer/id #uuid "d1f74fae-3121-59b5-8358-f435d8ddb989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416904}] :answer-field/correct {:answer/id #uuid "4a14e359-8fcd-5956-94b7-cc4fc5609525" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416874} :answer-field/id #uuid "ec0a627f-c1f6-5d47-8f41-058df8fd51e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "062c6773-1c0f-5106-b2b7-7c444f43389f" :question/math-academy-id "q-139820" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{15}$ is drawn from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ If $\\mu $ and $\\sigma $ are both unknown, which of the following are statistics?\n\nI. ${\\sum }_{i=1}^{15}|{X}_{i}|$\n\nII. $min({X}_{1},{X}_{3},…,{X}_{13},{X}_{15})$\n\nIII. $max({X}_{1},{X}_{2},…,{X}_{15},\\sigma )$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression. \n\n- Expression I is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{15}$ only.\n\n- Expression II is also a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{15}$ only. Note that a statistic doesn't need to include every sample element.\n\n- Expression III is *not* a statistic. It is a function that contains the unknown population standard deviation $\\sigma .$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186416927 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80e7de96-4120-5130-bf63-a0d6c2259820" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186416885} {:answer/id #uuid "85f1e085-215f-55f0-b047-8e1844995119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416889} {:answer/id #uuid "ba0857c3-5c1b-52e2-a099-8d64c550ebdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186416900} {:answer/id #uuid "daab6621-7a59-5df9-94ae-46892b25c2d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416905} {:answer/id #uuid "f2f31955-0b4d-58d4-8a01-1883943c46ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416911}] :answer-field/correct {:answer/id #uuid "85f1e085-215f-55f0-b047-8e1844995119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416889} :answer-field/id #uuid "3688953c-5564-5430-b587-22b1cb1cae35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4893e2e1-c5c0-525e-90bd-45f0ee89d95b" :question/math-academy-id "q-143552" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{16}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ is unknown and $\\sigma $ is known, which of the following are statistics?\n\n- $\\mu \\cdot \\sigma -\\text{min}({X}_{1},{X}_{2},…,{X}_{16})$\n- $\\mu -\\text{median}({X}_{2},{X}_{4},…,{X}_{16})$\n- $\\sigma -max({X}_{1},{X}_{3},…,{X}_{15})$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression.\n\n- Expressions I and II are *not* statistics. They are functions that contain the unknown population mean $\\mu .$\n\n- Expression III is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{16}$ and the *known* population standard deviation $\\sigma $ only. Note that a statistic doesn't need to include every sample element.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186416928 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24978810-ea9d-557b-a6e4-ec60314cdf3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416867} {:answer/id #uuid "312870f5-b5f4-5f45-a06d-0ca470866f05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186416870} {:answer/id #uuid "363a8247-f9e4-5fde-b5a0-221b67b24dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416871} {:answer/id #uuid "e5fa121b-5ca3-59a5-9ca2-3cfda696c7f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416907} {:answer/id #uuid "ea421d4e-7720-57f3-94e7-9b66a798936e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416909}] :answer-field/correct {:answer/id #uuid "24978810-ea9d-557b-a6e4-ec60314cdf3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416867} :answer-field/id #uuid "d48c9bdb-925a-55e9-8810-2371ff4500d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ccfb8c1-3a4b-5435-8003-dc3e546488df" :question/math-academy-id "q-139813" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{9}$ is drawn from a population with population mean $\\mu $ and population standard deviation $\\sigma .$ If $\\mu $ and $\\sigma $ are both unknown, which of the following are statistics?\n\n- $max({X}_{1},{X}_{2},…,{X}_{9})$\n- $\\text{median}({X}_{1},{X}_{2},…,{X}_{9})$\n- ${\\sum }_{i=1}^{9}{(\\frac{{X}_{i}-\\sigma }{\\mu })}^{2}$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression. \n\n- Expressions I and II are statistics. They are functions of the sample ${X}_{1},{X}_{2},…,{X}_{9}$ only.\n\n- Expression III is *not* a statistic. It is a function that contains the unknown population mean $\\mu $ and the unknown population standard deviation $\\sigma .$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186416929 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111f2a1e-49a4-5425-9c30-77e8f10a7813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186416866} {:answer/id #uuid "4e0c5de3-7c79-5b7e-a720-d262f7cd52f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416875} {:answer/id #uuid "4e974b83-28b6-5e89-995d-50a977968dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416877} {:answer/id #uuid "4fbcabc8-67e3-58c7-ada3-e4560b3ebf7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416878} {:answer/id #uuid "7a32c857-a580-5328-90f1-f1b03c19902c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416883}] :answer-field/correct {:answer/id #uuid "4e974b83-28b6-5e89-995d-50a977968dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416877} :answer-field/id #uuid "0717ebb9-5fd9-5b4c-acc5-d9a8ab6e92d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b59e493b-eefe-51a6-8a6a-b1643795634d" :question/math-academy-id "q-139806" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{6}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ and $\\sigma $ are both unknown, which of the following are statistics?\n\n- ${\\sum }_{i=1}^{6}({X}_{i}-\\mu )^{2}$\n- $\\text{mode}({X}_{1},{X}_{2},…,{X}_{6})$\n- $\\frac{1}{3}({X}_{2}+{X}_{4}+{X}_{6})$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression. \n\n- Expression I is *not* a statistic. It is a function that contains the unknown population mean $\\mu .$\n\n- Expression II is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{6}$ only.\n\n- Expression III is also a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{6}$ only. Note that a statistic doesn't need to include every sample element.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186416931 :knowledge-point/_questions [{:db/id #edb/ref 17592186188280 :knowledge-point/id #uuid "fd3fd748-f238-59b2-badf-54b6e762836c" :knowledge-point/title "Identifying Statistics"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f9b79d-3f80-5c8a-b293-cdd677cfaac1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416864} {:answer/id #uuid "2f2aad8e-6939-56e2-9378-82654311c3d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416869} {:answer/id #uuid "be046d3d-00a0-5830-98b9-f8f3de43c605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416901} {:answer/id #uuid "c2e714c6-de29-55f1-9b71-cb080706ced6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416902} {:answer/id #uuid "e85f5d4a-6136-5a58-a7ce-9cb33d65e0e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416908}] :answer-field/correct {:answer/id #uuid "be046d3d-00a0-5830-98b9-f8f3de43c605" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416901} :answer-field/id #uuid "b1b91263-f5d8-543a-8a8c-c6fd7db5717b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e079f787-5375-55b9-9502-e85783c5d546" :question/math-academy-id "q-139814" :question/problem "A sample ${X}_{1},{X}_{2},…,{X}_{7}$ is drawn from a population with population mean $\\mu $ and population variance ${\\sigma }^{2}.$ If $\\mu $ and $\\sigma $ are both unknown, which of the following are statistics?\n\nI. $({X}_{1}+{X}_{4}+{X}_{7})^{3}$\n\nII. ${\\sum }_{i=1}^{7}\\frac{({X}_{i}-\\mu )^{2}}{2}$\n\nIII. ${\\sum }_{i=1}^{7}\\frac{{X}_{i}^{2}+{\\sigma }^{2}}{n}$" :question/worked-solution "Suppose ${X}_{1},{X}_{2},…,{X}_{n}$ is a sequence of random variables representing a random sample of size $n$ drawn from a population. A statistic is a random variable expressed as a function of ${X}_{i}.$\n\nStatistics cannot involve unknown population parameters.\n\nWith that in mind, let's examine each expression. \n\n- Expression I is a statistic. It is a function of the sample ${X}_{1},{X}_{2},…,{X}_{7}$ only. Note that a statistic doesn't need to include every sample element.\n\n- Expressions II is *not* statistics. It is a function that contains the unknown population mean $\\mu .$\n\n- Expressions III is *not* statistics. It is a function that contains the unknown population variance ${\\sigma }^{2}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186416982 :knowledge-point/_questions [{:db/id #edb/ref 17592186208843 :knowledge-point/id #uuid "352a7d2c-4aba-5246-8a20-ed79de007b95" :knowledge-point/title "Determining Whether a Matrix Expression Involving the Hadamard Product is Well-Defined"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "368e5c38-687c-5476-a766-53fe59679efb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416956} {:answer/id #uuid "a2de33de-7c02-5cb9-b000-8fd4ffa0668b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416962} {:answer/id #uuid "a81f915c-2e4f-5036-ade2-5fb2255941e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416963} {:answer/id #uuid "a859c734-1278-56c3-b313-37ad8c178a6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416964} {:answer/id #uuid "cee12af1-4ad7-5e93-a79a-1c4026db489e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416969}] :answer-field/correct {:answer/id #uuid "368e5c38-687c-5476-a766-53fe59679efb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416956} :answer-field/id #uuid "f680b101-94a2-558f-9708-756d2ba22da2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416978}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6deba07-cdc0-5243-9183-e0064a49692b" :question/math-academy-id "q-274938" :question/problem "Given the matrices\n\n$$\nX=[\\begin{aligned}4 & 5 \\\\ 0 & 2 \\\\ 7 & 6\\end{aligned}]\\,Y=[\\begin{aligned}1 & 3 & 4 \\\\ 2 & 1 & 5\\end{aligned}]\\,u=[\\begin{aligned}1 \\\\ 0 \\\\ 8\\end{aligned}]\n$$\n\n in which of the following expressions is the Hadamard product well-defined?\n\n- $YX⊙Y\\,\\text{diag}(u)$\n- $X⊙Yu$\n- $Y\\,\\text{diag}(u)⊙YX{X}^{T}$\n\n*Hint: Here, $\\text{diag}(v)$ is a diagonal matrix with the entries of $v$ on the diagonal.*" :question/worked-solution "The Hadamard product of two matrices (or vectors) is only defined if they have the same dimensions.\n\nFirst, notice that $X$ is a $3\\times 2$ matrix, $Y$ is a $2\\times 3$ matrix, and $u$ is a $3\\times 1$ column vector.\n\nNow, let's consider each expression in turn:\n\n- The dimensions of $YX$ are $2\\times 2,$ and the dimensions of $Y\\,\\text{diag}(u)$ are $2\\times 3.$ Hence, the Hadamard product in expression I is *not* well-defined.\n\n- The dimensions of $X$ are $3\\times 2,$ and the dimensions of $Yu$ are $2\\times 1.$ Hence, the Hadamard product in expression II is *not* well-defined.\n\n- The dimensions of $Y\\,\\text{diag}(u)$ are $2\\times 3,$ and the dimensions of $YX{X}^{T}$ are $2\\times 3.$ Hence, the Hadamard product in expression III is well-defined.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186417378 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05827898-9cd0-5481-9f4f-2795de94047f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186417360} {:answer/id #uuid "0fb31cbb-95b7-5502-b5a4-6f06608e01c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186417361} {:answer/id #uuid "41d70487-8623-57c9-b21d-be91769cf161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186417366} {:answer/id #uuid "5daf2709-08dc-5216-87eb-2c674ea61e85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186417368} {:answer/id #uuid "932f9073-db7f-59db-843a-495c4d7ae846" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186417372}] :answer-field/correct {:answer/id #uuid "05827898-9cd0-5481-9f4f-2795de94047f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186417360} :answer-field/id #uuid "f7d95426-738e-5629-870c-65da360e7800" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417377}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b47d0cc7-71aa-58ba-a792-0650346f33fc" :question/math-academy-id "q-75505" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:=\\frac{1}{5}{R}_{1}\\,$ and $\\,{R}_{2}:={R}_{2}+(-1){R}_{1}?$\n\n$$\nA=[\\begin{aligned}10 & 0 \\\\ 2 & 1\\end{aligned}],\\,B=[\\begin{aligned}5 & 0 \\\\ 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}5 & 0 \\\\ 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}10 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}5 & 0 \\\\ 1 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}5 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186417602 :knowledge-point/_questions [{:db/id #edb/ref 17592186203927 :knowledge-point/id #uuid "c70d6a7a-298e-54bb-8a5d-dff2213b17bf" :knowledge-point/title "Symmetric and Antisymmetric Over Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23dee3e5-8fb2-530f-bfa9-3599d563e0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186417398} {:answer/id #uuid "2e24d934-08c4-58e3-be52-ce9f5121ebde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186417408} {:answer/id #uuid "653569ac-ed4a-561b-b9be-9d858125d297" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186417436} {:answer/id #uuid "ead62325-324d-5dce-b93f-38dca6a0bf33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186417531} {:answer/id #uuid "faab2d61-d391-5d78-81d3-04b266228963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$, $S,$ and $T$" :db/id #edb/ref 17592186417541}] :answer-field/correct {:answer/id #uuid "faab2d61-d391-5d78-81d3-04b266228963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$, $S,$ and $T$" :db/id #edb/ref 17592186417541} :answer-field/id #uuid "cb7a1b4f-e571-5ec0-a3c9-9dbfbbd624fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417590}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16c25cec-ba90-5814-9c8d-34f1bb30c2b1" :question/math-academy-id "q-213599" :question/problem "Which of the following relations are symmetric? \n\n- $x\\,R\\,y$ if and only if $x≡y\\,(\\text{mod}\\,3),$ defined on $Z$\n\n- $x\\,S\\,y$ if and only if $x+y=0,$ defined on $R$\n\n- $X\\,T\\,Y$ if and only if $|X|=|Y|,$ defined on $P(N)$" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is symmetric. Indeed, if $(x,y)\\in R$ then $(y,x)\\in R.$ Notice that \n\n$$\nx≡y\\,(\\text{mod}\\,3)\\,⟹\\,y≡x\\,(\\text{mod}\\,3)\n$$\n\nfor all $x,y\\in Z.$\n\n- Relation $S$ is symmetric. Indeed, if $(x,y)\\in S$ then $(y,x)\\in S.$ Notice that \n\n$$\nx+y=0\\,⟹\\,y+x=0\n$$\n\nfor all $x,y\\in R.$\n\n- Relation $T$ is symmetric. Indeed, if $(X,Y)\\in T$ then $(Y,X)\\in T.$ Notice that \n\n$$\n|X|=|Y|\\,⟹\\,|Y|=|X|\n$$\n\nfor all $X,Y\\in P(N).$\n\nTherefore, the correct answer is \"$R$, $S,$ and $T.$\""}] [{:db/id #edb/ref 17592186417608 :knowledge-point/_questions [{:db/id #edb/ref 17592186203926 :knowledge-point/id #uuid "c4dee31d-47c2-5b56-8cea-22d42f7b9de2" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12c5373d-0629-56d7-901e-7af879dd9ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417386} {:answer/id #uuid "1dc38fe7-4cc0-5b89-838a-99b8f54f414a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417392} {:answer/id #uuid "32e8c8fd-be74-587d-a3b4-8214f956aaa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417412} {:answer/id #uuid "8281f135-368b-5bd3-8ea5-ebad2352c486" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417463} {:answer/id #uuid "ae7470ff-d87b-54d1-8fb8-68a8dbdf78fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417488}] :answer-field/correct {:answer/id #uuid "1dc38fe7-4cc0-5b89-838a-99b8f54f414a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417392} :answer-field/id #uuid "5a672eb5-09d4-52a3-990d-6a002fb2c6dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84454995-d49e-5edd-80f6-dfbaab2558d5" :question/math-academy-id "q-213318" :question/problem "![](images/a8/a8ebf81e13d905d36997abf2f16c3732714b4feb56334f5e0c56443aa07732c6.png)\n\nWhich of the above digraphs represents an antisymmetric relation defined on the set $A={1,2,3}?$" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn terms of a digraph, if we have an arrow $x\\to y,$ then the arrow $y\\to x$ must be in the digraph too.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nSo, only one of the arrows, either $x\\to y$ or $y\\to x,$ can be in the digraph of an antisymmetric relation. Note that this condition allows loops.\n\nWith that in mind, let's examine our digraphs.\n\n- Digraph I represents an antisymmetric relation since for all possible $x$ and $y$ with $x\\ne y,$ *at most one* of the arrows (either $x\\to y$ or $y\\to x,$ but not both) belongs to the digraph.\n\n- Digraph II represents neither a symmetric nor an antisymmetric relation. It's not symmetric since the arrow $3\\to 2$ belongs to the digraph while the arrow $2\\to 3$ does not. It is not antisymmetric since, for example, arrows $1\\to 2$ and $2\\to 1$ belong to the digraph.\n\n- Digraph III represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186417609 :knowledge-point/_questions [{:db/id #edb/ref 17592186203926 :knowledge-point/id #uuid "c4dee31d-47c2-5b56-8cea-22d42f7b9de2" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d90713-bab4-5982-9789-c8022a2a41da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417380} {:answer/id #uuid "20bd4423-75c9-5c3e-b7e3-27c624187a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417396} {:answer/id #uuid "353df1a9-635f-5637-a998-3ec12de5fb5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417414} {:answer/id #uuid "563b2cb6-9661-5e33-b3af-530622715f23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417430} {:answer/id #uuid "96510da6-be83-5df5-9b88-5179df3edb1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417474}] :answer-field/correct {:answer/id #uuid "353df1a9-635f-5637-a998-3ec12de5fb5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417414} :answer-field/id #uuid "51bc889b-d302-50fa-aa28-ad159b53a97d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417565}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92e553e5-9efc-54d5-9f9a-59a998ba0a7b" :question/math-academy-id "q-213492" :question/problem "![](images/88/88e4ad0704f54f33241180593dc1ce4fe384710d5a680717f7c0449d5f85ec2c.png)\n\nWhich of the plots above represents a relation that is neither symmetric nor antisymmetric defined on the set $A={a,b,c}?$" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn terms of a plot, if a point $(x,y)$ belongs to the plot, then $(y,x),$ the point symmetric to $(x,y)$ over the diagonal line $y=x,$ should also be on the plot.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nSo, only one of the points, either $(x,y)$ or $(y,x),$ can be on the plot of an antisymmetric relation. Note that this condition allows points on the diagonal line $y=x.$\n\nWith that in mind, let's draw the diagonal line $y=x$ and examine our plots.\n\n![](images/cd/cd4c4ac0b0b4c00e8cb29e8c95738d5c9c4404113c5370791e2277ca66cdbda2.png)\n\n \n\n- Plot I represents an antisymmetric relation since the plot contains at most one point from each pair of the points symmetric over the line $y=x.$\n\n- Plot II represents neither a symmetric nor an antisymmetric relation. It's not symmetric since, for example, the pair $(a,b)$ belongs to the plot while the point $(b,a)$ does not. And it's not antisymmetric since it contains the pairs $(a,c)$ and $(c,a).$\n\n- Plot III represents a symmetric relation since the plot is symmetric over the line $y=x.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186417612 :knowledge-point/_questions [{:db/id #edb/ref 17592186203926 :knowledge-point/id #uuid "c4dee31d-47c2-5b56-8cea-22d42f7b9de2" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26015440-1e7f-5a41-a515-cdb226ffde44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417401} {:answer/id #uuid "71e3b3fd-c2f3-5398-bd50-93961d57fa71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417447} {:answer/id #uuid "88da9920-b611-5173-8083-4d93b60bb921" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417466} {:answer/id #uuid "d873a68d-5dbd-5f44-ba5e-d5e3260cbab1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417518} {:answer/id #uuid "e701ebf7-eb6f-578b-a734-909bfb567074" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417528}] :answer-field/correct {:answer/id #uuid "71e3b3fd-c2f3-5398-bd50-93961d57fa71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417447} :answer-field/id #uuid "e73c30be-aa49-512c-9991-68a5517212a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd780cfc-a5dd-5c8f-a2c7-e44b9d2a3075" :question/math-academy-id "q-213543" :question/problem "![](images/da/dac9030db59b2b51b2b95c8bc9b5988106be8d198b7f947d33c8678d1cfa3b7b.png)\n\nWhich of the above digraphs represents a symmetric relation defined on the set $A={1,2,3}?$" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn terms of a digraph, if we have an arrow $x\\to y,$ then the arrow $y\\to x$ must be in the digraph too.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nSo, only one of the arrows, either $x\\to y$ or $y\\to x,$ can be in the digraph of an antisymmetric relation. Note that this condition allows loops.\n\nWith that in mind, let's examine our digraphs.\n\n- Digraph I represents an antisymmetric relation since for all possible $x$ and $y$ with $x\\ne y,$ *at most one* of the arrows (either $x\\to y$ or $y\\to x,$ but not both) belongs to the digraph.\n\n- Digraph II represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\n- Digraph III represents neither a symmetric nor an antisymmetric relation. It's not symmetric since the arrow $1\\to 2$ belongs to the digraph while the arrow $2\\to 1$ does not. It is not antisymmetric since, for example, arrows $1\\to 3$ and $3\\to 1$ belong to the digraph.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186417615 :knowledge-point/_questions [{:db/id #edb/ref 17592186203926 :knowledge-point/id #uuid "c4dee31d-47c2-5b56-8cea-22d42f7b9de2" :knowledge-point/title "Identifying Symmetric and Antisymmetric Relations From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34cfbb87-25ee-57d3-9593-65b9056166c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417413} {:answer/id #uuid "681eaafc-b181-55c0-a5c1-50fc24ec41d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417438} {:answer/id #uuid "b65b6025-f874-5bd7-abde-81594d01d6e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417491} {:answer/id #uuid "d0a402d1-6d3b-5a39-88ac-48a25a79c7ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417509} {:answer/id #uuid "f66b2634-5d28-5976-9c01-6e76341a26f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417540}] :answer-field/correct {:answer/id #uuid "b65b6025-f874-5bd7-abde-81594d01d6e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417491} :answer-field/id #uuid "c65f5ba4-1fea-57cb-bbe2-73b81c041018" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417587}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ee6fe66d-09a5-518d-9a32-a533c9b3cc75" :question/math-academy-id "q-213540" :question/problem "![](images/70/70743ac83b876995835703b35fc133af2133960ea916f589d60c8ac5636ee4ef.png)\n\nWhich of the above digraphs represents a symmetric relation defined on the set $A={a,b,c}?$" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn terms of a digraph, if we have an arrow $x\\to y,$ then the arrow $y\\to x$ must be in the digraph too.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nSo, only one of the arrows, either $x\\to y$ or $y\\to x,$ can be in the digraph of an antisymmetric relation. Note that this condition allows loops.\n\nWith that in mind, let's examine our digraphs.\n\n- Digraph I represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\n- Digraph II represents an antisymmetric relation since for all possible $x$ and $y$ with $x\\ne y,$ *at most one* of the arrows (either $x\\to y$ or $y\\to x,$ but not both) belongs to the digraph.\n\n- Digraph III represents a symmetric relation since for every arrow $x\\to y$ belonging to the graph, the corresponding inverse arrow $y\\to x$ also belongs to the graph.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186417616 :knowledge-point/_questions [{:db/id #edb/ref 17592186203927 :knowledge-point/id #uuid "c70d6a7a-298e-54bb-8a5d-dff2213b17bf" :knowledge-point/title "Symmetric and Antisymmetric Over Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19eae037-9bb3-53cd-9405-bcdcf90085f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186417390} {:answer/id #uuid "1fc5dc30-0af1-522a-98a7-9dc7cae28dc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186417393} {:answer/id #uuid "30083d0d-2315-5a99-8f56-85fda87401af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186417409} {:answer/id #uuid "82cc221d-48ae-5487-9285-67993b828548" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186417464} {:answer/id #uuid "c5013afa-3560-51a7-8ce8-80f8c3522c62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186417504}] :answer-field/correct {:answer/id #uuid "30083d0d-2315-5a99-8f56-85fda87401af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186417409} :answer-field/id #uuid "b27f213d-f5cd-55a6-989e-1054aab40f4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417580}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe8a5755-a006-512f-a829-ac55db45a0f7" :question/math-academy-id "q-213600" :question/problem "Which of the following relations are symmetric? \n\n- $x\\,R\\,y$ if and only if $y={x}^{2},$ defined on $R$\n\n- $X\\,S\\,Y$ if and only if $X⊂Y,$ defined on $P(R)$\n\n- $x\\,T\\,y$ if and only if $4∣(x+y),$ defined on $N$" :question/worked-solution "First, recall the following definitions:\n\n- A binary relation $R,$ defined on a set $A,$ is *symmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,⟹\\,(y,x)\\in R.\n$$\n\nIn other words, if a pair $(x,y)$ belongs to a symmetric relation, then the pair $(y,x)$ should also be in the relation.\n\n- A binary relation $R,$ defined on a set $A,$ is *antisymmetric* if for all $x,y\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,x)\\in R\\,⟹\\,x=y.\n$$\n\nIn other words, only one of the pairs, either $(x,y)$ or $(y,x),$ can be in an antisymmetric relation. Note that this condition allows pairs of the form $(x,x).$\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is not symmetric. Notice that \n\n- $(-1,1)\\in R$ since $1=(-1)^{2},$ while\n\n- $(1,-1)\\notin R$ since $-1\\ne {1}^{2}.$\n\n- Relation $S$ is not symmetric. Notice that \n\n- $({1},Z)\\in S$ since ${1}⊂Z,$ while\n\n- $(Z,{1})\\notin S$ since $Z⊄{1}.$\n\n- Relation $T$ is symmetric. Indeed, if $(x,y)\\in T$ then $(y,x)\\in T.$ Notice that \n\n$$\n4∣(x+y)\\,⟹\\,4∣(y+x)\n$$\n\nfor all $x,y\\in N.$\n\nTherefore, the correct answer is \"$T$ only.\""}] [{:db/id #edb/ref 17592186417704 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f10238c-7d05-58b9-96e8-9c69a8801161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417685} {:answer/id #uuid "b1eb1104-92b0-5dcf-bd12-07d9a0132bf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417691} {:answer/id #uuid "d5329d0a-dafa-5056-a8ca-478564ecacb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417693} {:answer/id #uuid "eeaaa408-6e32-550a-b040-2adb608fe8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417696} {:answer/id #uuid "fb5e2579-8b62-5595-a1e0-8ecfe4516933" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417698}] :answer-field/correct {:answer/id #uuid "eeaaa408-6e32-550a-b040-2adb608fe8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417696} :answer-field/id #uuid "4b17b4e5-ae42-5c71-8493-ac975ab35b5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417702}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c77aeb41-578d-533f-87d1-e33216f35c1e" :question/math-academy-id "q-84053" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T$ and ${u}_{1},{u}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If ${u}_{1}-{u}_{2}\\ne 0$ and $T({u}_{1})-T({u}_{2})=0,$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)={0}$\n- $\\text{rank}(T)\\ne 3$\n- $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T$ is a linear transformation and $T({u}_{1})-T({u}_{2})=0,$ we have $T({u}_{1}-{u}_{2})=0.$ So ${u}_{1}-{u}_{2}\\in \\text{Ker}(T)$ and ${u}_{1}-{u}_{2}\\ne 0.$ Therefore, we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is true. Since $\\text{Ker}(T)\\ne {0}$, then $\\text{rank}(T)=\\text{rank}(T)\\ne 3.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 3,$ the transformation $T$ can't be invertible.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186417815 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0972b4fe-a6de-5b28-91e1-b8f15d278acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417785} {:answer/id #uuid "26c9aa3e-4575-55fe-bef6-0e504f1fb60e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417789} {:answer/id #uuid "3fd3bade-13d7-5747-b1e8-adac5e633beb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417792} {:answer/id #uuid "505ee955-4b02-50a3-9047-a855589dfea1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417796} {:answer/id #uuid "b7801bcd-fba9-5c75-b2ca-bfd94012877d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417803}] :answer-field/correct {:answer/id #uuid "26c9aa3e-4575-55fe-bef6-0e504f1fb60e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417789} :answer-field/id #uuid "b71b8e04-6ae9-5c68-998d-3aaf22c66038" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417813}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4db015a0-682b-5ff4-909b-ad19f05ab168" :question/math-academy-id "q-71826" :question/problem "![](images/b8/b838b945d0b4002d8ae2238af5992c83dcf23b2985c448c716a5caf8de31b369.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is a boundary point of the set $M$\n- $B$ is an interior point of the set $M$\n- $C$ is a boundary point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/be/be1ece00243777f3f6b6973319e15ea1e5c8556b2452b61a451713f9dcb86595.png)\n\n- Statement I is true. Indeed, $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement II is false. The point $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement III is false. The point $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is 'I only'."}] [{:db/id #edb/ref 17592186417818 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e33f924-4eb3-55c2-bd43-bfeaf2283adf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186417790} {:answer/id #uuid "9d0ca9a9-7bc2-5a65-be19-0f409201b0c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417799} {:answer/id #uuid "c1b376f2-838b-5270-8108-30de4fdb1fcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417804} {:answer/id #uuid "f9e22708-5653-5d53-b84a-eb8c3f50f2b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417807} {:answer/id #uuid "fc4df2d7-22d1-55de-8deb-c49dbe88df60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417808}] :answer-field/correct {:answer/id #uuid "c1b376f2-838b-5270-8108-30de4fdb1fcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417804} :answer-field/id #uuid "24ed1e3e-e1e8-525a-96ba-0dbe6634885b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417810}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f7105850-e717-5535-8a28-db3aaf9f3031" :question/math-academy-id "q-159495" :question/problem "![](images/19/19174ec33e43c900773031043d5de200e892f5e3ee51704d0800b6a944147155.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is an interior point of the set $M$\n- $B$ is a boundary point of the set $M$\n- $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/43/43362800e91cbb57c22fc6851c10f00927a030a790dea9284e69a5c7c3d4ae25.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is an interior point since there exists an open neighborhood of $A$ that is fully contained inside the set $M.$\n\n- Statement II is true. Indeed, $B$ is a boundary point because every open neighborhood of $B$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement III is true. Indeed, $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is 'I, II, and III'."}] [{:db/id #edb/ref 17592186418065 :knowledge-point/_questions [{:db/id #edb/ref 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b798def-9f4c-5c78-939d-4d3fa7b155b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186418054} {:answer/id #uuid "36a1e53d-4736-58e7-9183-e39dca9e0ce1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186418055} {:answer/id #uuid "4305aa10-6b9d-5a8d-b5e0-73d08076c6a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186418056} {:answer/id #uuid "64b20a39-4422-555e-853c-addaea9024df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186418058} {:answer/id #uuid "6db79444-4f16-52ba-8432-cedcce75ea2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II, III, and IV only" :db/id #edb/ref 17592186418059}] :answer-field/correct {:answer/id #uuid "2b798def-9f4c-5c78-939d-4d3fa7b155b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186418054} :answer-field/id #uuid "8230f704-b679-555a-b3ea-6455f032cf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418063}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6641b4f-e396-5ff5-8410-bd9f53c4e8d6" :question/math-academy-id "q-98339" :question/problem "![](images/98/9836234d763ccb3da6b9ac0360dcb3662cacc5fc90d5ecc2dee20bf29ce0c77d.png)\n\nWhich of the curves above is simple, closed, and negatively oriented?" :question/worked-solution "A simple closed curve is positively oriented if, when traveling along it, one always has the curve interior to the left and the curve exterior to the right. Otherwise, the curve is negatively oriented. \n\nA curve is positively oriented if it is traversed counterclockwise and is negatively oriented if it is traversed clockwise.\n\nWith that in mind, let's examine each of the curves:\n\n- Curve I is neither simple nor closed.\n\n- Curve II is a simple and closed curve but it is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\n- Curve III is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve IV is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\nTherefore, the correct answer is \"III and IV only.\""}] [{:db/id #edb/ref 17592186418243 :knowledge-point/_questions [{:db/id #edb/ref 17592186203886 :knowledge-point/id #uuid "630cd12d-1141-51ae-8f2e-a881622868e8" :knowledge-point/title "Identifying Transitive Relations in Special Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2571c089-3c52-59d7-b473-6f9e0305f21e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186418167} {:answer/id #uuid "2f967206-082f-5b15-9867-3bb8d435bad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186418170} {:answer/id #uuid "ac9e3534-044f-5762-90a9-b43cb8e6b482" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418201} {:answer/id #uuid "cf9cc960-4433-54c6-935f-f6a98ffc3777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186418213} {:answer/id #uuid "db2ad807-5ae0-5e39-8f4e-ad108c836dcd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186418215}] :answer-field/correct {:answer/id #uuid "2f967206-082f-5b15-9867-3bb8d435bad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186418170} :answer-field/id #uuid "c8488c7a-8619-58cd-a22e-a5aa6766ebf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "202c6abf-dfb5-522a-9256-456835ce12bd" :question/math-academy-id "q-214430" :question/problem "Which of the following relations on the set $A={1,3,5,7}$ are transitive?\n\n- ${R}_{1}=∅$\n- ${R}_{2}={A}^{2}$\n- ${R}_{3}={(5,5)}$\n- ${R}_{4}={(5,1),(7,3)}$" :question/worked-solution "A binary relation $R$ defined on a set $A$ is *transitive* if, for all $x,y,z\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,z)\\in R\\,⟹\\,(x,z)\\in R.\n$$\n\nIn other words, if the pairs $(x,y)$ and $(y,z)$ belong to a transitive relation, then the pair $(x,z)$ should also be in the relation.\n\nIt's sufficient to check all the \"linked\" pairs of the form $(x,y)$ with $x\\ne y$ and $(y,z)$ with $y\\ne z:$\n\nMoreover, we recall the following:\n\n- The universal relation $R={A}^{2}$ is transitive since it includes all possible ordered pairs.\n\n- The empty relation $R=∅$ is vacuously transitive since the antecedent in the implication is always false, and therefore the implication is always true.\n\n- A relation containing no \"linked\" pairs is always transitive.\n\n- A relation containing only reflexive pairs is always transitive.\n\nWith that in mind, let's examine our relations:\n\n- ${R}_{1}$ is transitive since it's the empty relation. $\\,\\,✓$\n\n- ${R}_{2}$ is transitive since it's the universal relation. $\\,\\,✓$\n\n- ${R}_{3}$ is transitive since it contains only reflexive pairs.  $\\,\\,✓$\n\n- ${R}_{4}$ is transitive since it contains no \"linked\" pairs.  $\\,\\,✓$\n\nTherefore, the correct answer is \"I, II, III, and IV.\""}] [{:db/id #edb/ref 17592186418244 :knowledge-point/_questions [{:db/id #edb/ref 17592186203886 :knowledge-point/id #uuid "630cd12d-1141-51ae-8f2e-a881622868e8" :knowledge-point/title "Identifying Transitive Relations in Special Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "344c8bff-5d19-596d-a2bf-472abe96d0ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186418172} {:answer/id #uuid "5b9a150a-cc66-599e-963e-2b2c4bed2295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186418181} {:answer/id #uuid "62c920c8-4114-5cee-ab28-e34c74683438" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186418184} {:answer/id #uuid "b26882ef-7ad2-53e9-a273-98e2183e198c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186418203} {:answer/id #uuid "bf74cb06-4c45-5759-8ad8-f5a6d7a6e7f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186418206}] :answer-field/correct {:answer/id #uuid "bf74cb06-4c45-5759-8ad8-f5a6d7a6e7f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186418206} :answer-field/id #uuid "0ba6de5b-5a73-5a97-aff3-85fcde63e486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44cd3428-3b1c-5e19-9525-5e86c3ca616a" :question/math-academy-id "q-214431" :question/problem "Which of the following relations on the set $A={♢,♡,♠,♣}$ are transitive?\n\n- ${R}_{1}={(♢,♢),(♣,♣)}$\n- ${R}_{2}={(♠,♠)}$\n- ${R}_{3}={(♢,♠),(♡,♣)}$\n- ${R}_{4}=∅$" :question/worked-solution "A binary relation $R$ defined on a set $A$ is *transitive* if, for all $x,y,z\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,z)\\in R\\,⟹\\,(x,z)\\in R.\n$$\n\nIn other words, if the pairs $(x,y)$ and $(y,z)$ belong to a transitive relation, then the pair $(x,z)$ should also be in the relation.\n\nIt's sufficient to check all the \"linked\" pairs of the form $(x,y)$ with $x\\ne y$ and $(y,z)$ with $y\\ne z:$\n\nMoreover, we recall the following:\n\n- The universal relation $R={A}^{2}$ is transitive since it includes all possible ordered pairs.\n\n- The empty relation $R=∅$ is vacuously transitive since the antecedent in the implication is always false, and therefore the implication is always true.\n\n- A relation containing no \"linked\" pairs is always transitive.\n\n- A relation containing only reflexive pairs is always transitive.\n\nWith that in mind, let's examine our relations:\n\n- ${R}_{1}$ is transitive since it contains only reflexive pairs.  $\\,\\,✓$\n\n- ${R}_{2}$ is transitive since it contains only reflexive pairs.  $\\,\\,✓$\n\n- ${R}_{3}$ is transitive since it contains no \"linked\" pairs.  $\\,\\,✓$\n\n- ${R}_{4}$ is transitive since it's the empty relation. $\\,\\,✓$\n\nTherefore, the correct answer is \"I, II, III, and IV.\""}] [{:db/id #edb/ref 17592186418246 :knowledge-point/_questions [{:db/id #edb/ref 17592186203887 :knowledge-point/id #uuid "f65dc026-1ec7-51f3-abc2-4a8ce95f9c2c" :knowledge-point/title "Identifying Transitive Relations From a Digraph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e69dd30-577b-5eb0-8abc-73d0336ecd72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186418179} {:answer/id #uuid "81acb1cb-213f-53e4-b5af-c60b8dbbec53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186418188} {:answer/id #uuid "9bc6d790-c4ad-5910-942b-7e8326e0da7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418194} {:answer/id #uuid "a9c59538-8b1e-5b20-9482-690ba54c57e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186418199} {:answer/id #uuid "c5c12167-746e-5442-b291-b883d8a00d11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186418210}] :answer-field/correct {:answer/id #uuid "9bc6d790-c4ad-5910-942b-7e8326e0da7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418194} :answer-field/id #uuid "18915ff6-afcd-56a1-8b11-45e467d4f091" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418226}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "64ea6724-f6be-5851-a399-860e0e1924d8" :question/math-academy-id "q-214065" :question/problem "![](images/1f/1fa323b54736f62bb334ae491d8d41deeba4a4e325f6e56f9651da147d50c349.png)\n\nWhich of the above digraphs represents a transitive relation defined on the set $A={p,q,r}?$" :question/worked-solution "A binary relation $R$ defined on a set $A$ is *transitive* if, for all $x,y,z\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,z)\\in R\\,⟹\\,(x,z)\\in R.\n$$\n\nIn other words, if the pairs $(x,y)$ and $(y,z)$ belong to a transitive relation, then the pair $(x,z)$ should also be in the relation.\n\nIt's sufficient to check all the \"linked\" pairs of the form $(x,y)$ with $x\\ne y$ and $(y,z)$ with $y\\ne z.$\n\nIn terms of a digraph, if we have \"linked\" arrows $x\\to y$ and $y\\to z,$ then the arrow $x\\to z$ must be in the digraph too.\n\nWith that in mind, let's examine our digraphs.\n\n- Digraph I does not represent a transitive relation. It has arrows $q\\to r$ and $r\\to p,$ but has no arrow $q\\to p.$\n\n- Digraph II represents a transitive relation. For any pair of arrows $x\\to y$ and $y\\to z,$ the arrow  $x\\to z$ also belongs to the digraph.\n\n- Digraph III does not represent a transitive relation. It has arrows $p\\to q$ and $q\\to r,$ but has no arrow $p\\to r.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186418247 :knowledge-point/_questions [{:db/id #edb/ref 17592186203888 :knowledge-point/id #uuid "947f058c-4c47-52df-8c28-aed016d2b148" :knowledge-point/title "Transitive Relations Defined On Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c5a523e-87ad-564c-a53c-0f5976b548cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186418195} {:answer/id #uuid "c19f5713-624c-5de7-b871-ec4d7fff4f4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186418207} {:answer/id #uuid "c9cc9a32-4374-5c62-b18b-114a993cc029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186418211} {:answer/id #uuid "e44c0d0e-d054-5dd5-8926-ef5982032103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186418217} {:answer/id #uuid "e564fc12-fb2c-519f-9637-195e019015f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186418218}] :answer-field/correct {:answer/id #uuid "e44c0d0e-d054-5dd5-8926-ef5982032103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186418217} :answer-field/id #uuid "edb2118f-fc60-559a-b8bd-52ea337c03d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418240}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70eb9024-0964-59ad-a103-f6948d25a78c" :question/math-academy-id "q-214002" :question/problem "Which of the following relations are transitive? \n\n- $x\\,R\\,y$ if and only if $x∣y,$ defined on $Z$\n\n- $x\\,S\\,y$ if and only if $x+y<4,$ defined on $R$\n\n- $x\\,T\\,y$ if and only if $x≡y\\,(\\text{mod}\\,4),$ defined on $Z$" :question/worked-solution "A binary relation $R$ defined on a set $A$ is *transitive* if, for all $x,y,z\\in A,$ we have\n\n$$\n(x,y)\\in R\\,\\text{and}\\,(y,z)\\in R\\,⟹\\,(x,z)\\in R.\n$$\n\nIn other words, if the pairs $(x,y)$ and $(y,z)$ belong to a transitive relation, then the pair $(x,z)$ should also be in the relation.\n\nIt's sufficient to check all the \"linked\" pairs of the form $(x,y)$ with $x\\ne y$ and $(y,z)$ with $y\\ne z.$\n\nWith that in mind, let's examine our relations.\n\n- Relation $R$ is transitive. Indeed, if $(x,y)\\in R$ and $(y,x)\\in R,$ then $(x,z)\\in R.$ Notice that \n\n$$\nx∣y\\,\\text{and}\\,y∣z\\,⟹\\,x∣z\n$$\n\nfor all $x,y,z\\in Z.$\n\n- Relation $S$ is not transitive. Notice that \n\n- $(1,-4)\\in S$ since $1+(-4)=-3<4,$ and\n\n- $(-4,5)\\in S$ since $-4+5=1<4,$ but\n\n- $(1,5)\\notin S$ since $1+5=6≮4.$\n\n- Relation $T$ is transitive. Indeed, if $(x,y)\\in T$ and $(y,x)\\in T,$ then $(x,z)\\in T.$ Notice that \n\n$$\nx≡y\\,(\\text{mod}\\,4)\\,\\text{and}\\,y≡z\\,(\\text{mod}\\,4)\\,⟹\\,x≡z\\,(\\text{mod}\\,4)\n$$\n\nfor all $x,y,z\\in Z.$\n\nTherefore, the correct answer is \"$R$ and $T$ only.\""}] [{:db/id #edb/ref 17592186419533 :knowledge-point/_questions [{:db/id #edb/ref 17592186157308 :knowledge-point/id #uuid "4f0a57c2-bbad-5225-976b-385c7f117738" :knowledge-point/title "Identifying Random Variables that Follow a Poisson Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15725fb5-a87c-5f38-b289-86f0d29427bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419436} {:answer/id #uuid "1c6398d0-50af-5610-9bee-df1bd0a9db26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419438} {:answer/id #uuid "8b67915e-f629-5f65-a339-cb1785e1012d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419469} {:answer/id #uuid "9f745b3a-8022-5a3b-be01-5e2c7e0f5ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419478} {:answer/id #uuid "bcbe5d78-91aa-5b37-8eb4-0ae8d7b2f02f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419486}] :answer-field/correct {:answer/id #uuid "8b67915e-f629-5f65-a339-cb1785e1012d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419469} :answer-field/id #uuid "11088ee4-ce12-5820-98c9-e84060e47cf8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419516}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2963275e-8991-5613-bcc4-d15bd0b82d44" :question/math-academy-id "q-85317" :question/problem "Which of the following random variables could be modeled using a Poisson distribution?\n\n- The number of defective televisions manufactured by a company in a month\n- The grade point average of a college class\n- The average speed of a car during a trip" :question/worked-solution "A Poisson distribution models the number of events that occur in an interval of time or space if events occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I follows a Poisson distribution. The number of defective televisions can be modeled as independent events with a constant average rate, and we wish to know how many events occur in an interval of time (a month).\n\n- Random variable II does *not* follow a Poisson distribution. The grade point average of a college class is not an event that occurs at a constant average rate.\n\n- Random variable III does *not* follow a Poisson distribution. The average speed of a car is not an event that occurs at a constant average rate.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186419535 :knowledge-point/_questions [{:db/id #edb/ref 17592186157308 :knowledge-point/id #uuid "4f0a57c2-bbad-5225-976b-385c7f117738" :knowledge-point/title "Identifying Random Variables that Follow a Poisson Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6cd3e57c-b365-5106-8e57-f1bf4d52d60f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419459} {:answer/id #uuid "95e5938e-1f9f-5017-8e26-2fa55c8515fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419472} {:answer/id #uuid "af510a37-6a4b-5f1f-86bb-85f87f12de1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419482} {:answer/id #uuid "bb7eb87a-e66e-5486-8307-f6d72c9b0d10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186419485} {:answer/id #uuid "fc526f4b-7ce4-57af-8ba3-f8e218dab5b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419511}] :answer-field/correct {:answer/id #uuid "6cd3e57c-b365-5106-8e57-f1bf4d52d60f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419459} :answer-field/id #uuid "d89223e5-0c7d-5154-95e1-d5f1014440e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419529}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a75eec7-e20c-53a7-afe2-6cf4faf6becf" :question/math-academy-id "q-131311" :question/problem "Which of the following random variables could be modeled using a Poisson distribution?\n\n- The number of network failures per week\n- The number of emergency calls received by a hospital every minute\n- The number of members of a band" :question/worked-solution "A Poisson distribution models the number of events that occur in an interval of time or space if events occur independently and at a constant average rate.\n\nWith that in mind, let's consider each of the given random variables.\n\n- Random variable I follows a Poisson distribution. The number of network failures can be modeled as independent events with a constant average rate, and we wish to know how many events occur in an interval of time (a week).\n\n- Random variable II follows a Poisson distribution.  The number of emergency calls received can be modeled as independent events with a constant average rate, and we wish to know how many events occur in an interval of time (a minute).\n\n- Random variable III does *not* follow a Poisson distribution. There are no events that occur at a constant average rate, and there is no interval of time or space.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186419538 :knowledge-point/_questions [{:db/id #edb/ref 17592186157308 :knowledge-point/id #uuid "4f0a57c2-bbad-5225-976b-385c7f117738" :knowledge-point/title "Identifying Random Variables that Follow a Poisson Distribution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4df288-3de3-5913-80c1-82e310e1702f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419433} {:answer/id #uuid "46289e15-5ed5-53d3-bfb5-9ed125b4b357" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419451} {:answer/id #uuid "6a3664a7-7754-5c55-8474-a12a38720c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419457} {:answer/id #uuid "a3aceabe-b268-5af7-9a02-b0e18dbda4bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419479} {:answer/id #uuid "ba905bc7-fb9a-5aee-98c6-60c46a28c15a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186419483}] :answer-field/correct {:answer/id #uuid "a3aceabe-b268-5af7-9a02-b0e18dbda4bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419479} :answer-field/id #uuid "be7fedf2-2106-5faf-a3ef-836ba7bad8ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419528}] :question/difficulty {:db/id #edb/ref 175921860