s [{:db/id 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14030e88-6395-56f9-82ae-0053228a0a90" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186412817} {:answer/id #uuid "8ed69294-b796-5762-a670-e84ffa5fce8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186412874} {:answer/id #uuid "a892cb8e-e16a-5a18-b277-91ca8afd57cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186412885} {:answer/id #uuid "d22c7286-cdcb-5191-9d60-a9974ca672d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186412909} {:answer/id #uuid "d73fae85-da65-51ae-ad7a-ae836d3b1e11" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186412914}] :answer-field/correct {:answer/id #uuid "d22c7286-cdcb-5191-9d60-a9974ca672d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186412909} :answer-field/id #uuid "f4475c97-7935-5890-8ef0-c7a0d0f183f4" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186412957}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a55de8de-5dbf-5007-a3cb-517652d485f3" :question/math-academy-id "q-78599" :question/problem "Which of the following integers belong to the residue class $[9]_{13}?$\n\nI. $4$\n\nII. $-17$\n\nIII. $35$" :question/worked-solution "The residue class $[9]_{13}$ consists of the elements that are congruent to $9$ modulo $13.$ So, we have\n\n$$\n\\begin{aligned}[9]_{13} & =\\{x\\in Z\\,|\\,x≡9\\,(\\text{mod}\\,13)\\} \\\\  & =\\{x\\in Z\\,|\\,x=9+13k,\\,k\\in Z\\} \\\\  & =\\{9+13k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,9-2\\cdot 13,\\,9-13,\\,9,\\,9+13,\\,9+2\\cdot 13,\\,…\\} \\\\  & =\\{…,-17,-4,9,22,35,…\\}.\\end{aligned}\n$$\n\nWe see that $-17$ and $35$ belong to $[9]_{13},$ while $4$ does not.\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id 17592186412972 :knowledge-point/_questions [{:db/id 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6e5a94-ee4d-53e1-8683-a2c6015c7c95" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186412827} {:answer/id #uuid "5479ed01-e1d6-5e5a-b01f-9abefb2c6a10" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186412842} {:answer/id #uuid "c2eeae29-6589-5372-9208-8579d86384ca" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186412898} {:answer/id #uuid "c8b963dd-bb5a-5a02-9158-70da5aa07a71" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186412903} {:answer/id #uuid "fc4562a3-8e24-54b7-820d-6e3b72017105" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186412928}] :answer-field/correct {:answer/id #uuid "c2eeae29-6589-5372-9208-8579d86384ca" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186412898} :answer-field/id #uuid "99eba53e-9c7a-538e-95be-f63aec7390ee" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186412943}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abd84654-ac2d-58a6-9574-529f2b4aa6f5" :question/math-academy-id "q-78597" :question/problem "Which of the following integers belong to the residue class $[-7]_{11}?$\n\nI. $15$\n\nII. $-4$\n\nIII. $7$" :question/worked-solution "The residue class $[-7]_{11}$ consists of the elements that are congruent to $-7$ modulo $11.$ So, we have\n\n$$\n\\begin{aligned}[-7]_{11} & =\\{x\\in Z\\,|\\,x≡-7\\,(\\text{mod}\\,11)\\} \\\\  & =\\{x\\in Z\\,|\\,x=-7+11k,\\,k\\in Z\\} \\\\  & =\\{-7+11k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,-7-2\\cdot 11,\\,-7-11,\\,-7,\\,-7+11,\\,-7+2\\cdot 11,\\,…\\} \\\\  & =\\{…,-29,-18,-7,4,15,…\\}.\\end{aligned}\n$$\n\nWe see that $15$ belongs to $[-7]_{11},$ while $-4$ and $7$ do not.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id 17592186412975 :knowledge-point/_questions [{:db/id 17592186152098 :knowledge-point/id #uuid "9c1fe7ea-d91e-5440-b756-37a460a18f19" :knowledge-point/title "Identifying Residue Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186412813} {:answer/id #uuid "5a19bf7b-22db-564c-aa73-f6a7de2af57f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186412847} {:answer/id #uuid "82922433-61e5-5a62-9698-a3b819a7b545" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186412867} {:answer/id #uuid "d3d30caf-3e16-5777-b064-513d0c56a4fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186412911} {:answer/id #uuid "d4ca8877-62b9-5e77-9a0b-f311eb33c385" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186412912}] :answer-field/correct {:answer/id #uuid "0c1d27f5-2dd8-5ee0-9c85-fa2aafc19456" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186412813} :answer-field/id #uuid "abdf5568-4325-50d1-b367-2f8fd167e6e1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186412946}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1a9f6cf-cd8d-55d6-a82c-4176e7807557" :question/math-academy-id "q-86027" :question/problem "Which of the following residue classes modulo $10$ contain the integer $-4?$\n\nI. $[4]_{10}$\n\nII. $[-14]_{10}$\n\nIII. $[6]_{10}$" :question/worked-solution "We have $-4\\in [a]_{10}$ if \n\n$$\n-4≡a\\,(\\text{mod}\\,10).\n$$\n\nLet's now consider each of the given equivalence classes.\n\n- $-4\\notin [4]_{10}$ because $-4≢4\\,(\\text{mod}\\,10)$ $\\,\\times $\n\n- $-4\\in [-14]_{10}$ because $-4≡-14\\,(\\text{mod}\\,10)$ $\\,✓$\n\n- $-4\\in [6]_{10}$ because $-4≡6\\,(\\text{mod}\\,10)$ $\\,✓$\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id 17592186412976 :knowledge-point/_questions [{:db/id 17592186152097 :knowledge-point/id #uuid "3d2f207a-8e99-5520-ab9f-266c8f54465b" :knowledge-point/title "Identifying Elements Belonging to a Residue Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16580a0c-365e-59a9-9828-bb02a47e8573" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186412819} {:answer/id #uuid "7e33db2a-1dbd-5414-9540-709392a7913f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186412863} {:answer/id #uuid "abb17be0-afe8-5a6d-8ef7-96917a6efd85" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186412889} {:answer/id #uuid "b9bdbd57-ea56-5ecb-8fe2-07753e9011a5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186412893} {:answer/id #uuid "c638689c-94e7-5af8-b84c-75a738f6395e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186412902}] :answer-field/correct {:answer/id #uuid "16580a0c-365e-59a9-9828-bb02a47e8573" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186412819} :answer-field/id #uuid "f2e9f81c-9578-565c-8322-3231a43ad273" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186412956}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e91f8fe9-c6f2-558a-bf39-b0389019d5ff" :question/math-academy-id "q-86021" :question/problem "Which of the following integers belong to the residue class $[7]_{11}?$\n\nI. $18$\n\nII. $-4$\n\nIII. $15$" :question/worked-solution "The residue class $[7]_{11}$ consists of the elements that are congruent to $7$ modulo $11.$ So, we have\n\n$$\n\\begin{aligned}[7]_{11} & =\\{x\\in Z\\,|\\,x≡7\\,(\\text{mod}\\,11)\\} \\\\  & =\\{x\\in Z\\,|\\,x=7+11k,\\,k\\in Z\\} \\\\  & =\\{7+11k\\,|\\,k\\in Z\\} \\\\  & =\\{…,\\,7-2\\cdot 11,\\,7-11,\\,7,\\,7+11,\\,7+2\\cdot 11,…\\} \\\\  & =\\{…,-15,-4,7,18,29,…\\}.\\end{aligned}\n$$\n\nWe see that $-4$ and $18$ belong to $[7]_{11},$ while $15$ does not.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id 17592186412999 :knowledge-point/_questions [{:db/id 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3927cd36-e744-5c4b-b518-90f4314da95c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id 17592186412980} {:answer/id #uuid "3e0f7a4e-e2de-5221-a243-87d47db94856" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186412981} {:answer/id #uuid "be644adc-7532-5ed2-b8e4-b29d16f2b2a7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186412989} {:answer/id #uuid "c05a3db1-b2e4-555c-b799-5b9528462b9d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186412990} {:answer/id #uuid "e77d1188-387d-5333-b099-521dba1d6c92" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186412992}] :answer-field/correct {:answer/id #uuid "e77d1188-387d-5333-b099-521dba1d6c92" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186412992} :answer-field/id #uuid "d49a1696-245b-5c6e-b7fe-d2569b597279" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186412996}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5e5966d3-ce4d-5835-ab91-1f478e587602" :question/math-academy-id "q-109510" :question/problem "$$\nA=[\\begin{aligned}1 & -1 \\\\ 1 & 3\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 4\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\n- $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =2$ of $A$\n- $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =2$ of $A$\n- $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-2I:$\n\n$$\nA-2I=[\\begin{aligned}1 & -1 \\\\ 1 & 3\\end{aligned}]-2[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-2I:$\n\n$$\n(A-2I)v=[\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 4\\end{aligned}]={{[\\begin{aligned}-5 \\\\ 5\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-2I:$\n\n$$\n(A-2I)w=[\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}-5 \\\\ 5\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}1 \\\\ 4\\end{aligned}]}_{⏟}}_{v}\\overset{\\,A-2I\\,\\,}{\\to }{{[\\begin{aligned}-5 \\\\ 5\\end{aligned}]}_{⏟}}_{w}\\overset{\\,A-2I\\,\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-2I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =2$ of $A.$*\n\nSo, the correct answer is \"III only.\""}] [{:db/id 17592186413341 :knowledge-point/_questions [{:db/id 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47aae119-de52-5a6f-b7a1-ed5cfb5a10e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186413327} {:answer/id #uuid "7c9326e8-8412-5f0f-be79-a57ba80e957f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id 17592186413330} {:answer/id #uuid "a3cfc328-4fc1-5747-b490-dfadf05a9a5b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413332} {:answer/id #uuid "a66e2889-63d9-58f5-b599-fac84f95bb5f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413333} {:answer/id #uuid "df465832-9958-51d8-a73c-05aadf6adf21" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186413335}] :answer-field/correct {:answer/id #uuid "a3cfc328-4fc1-5747-b490-dfadf05a9a5b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413332} :answer-field/id #uuid "3e7444ba-e9b0-5dc3-868c-f11ef347b50d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413337}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c87590b-cc07-5050-b79f-9ad013757661" :question/math-academy-id "q-88693" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-6}^{6}x\\operatorname{sin}⁡x\\,\\text{d}x$\n- ${\\int }_{-2}^{2}{x}^{3}\\operatorname{cos}⁡x\\,\\text{d}x$\n- ${\\int }_{-1}^{1}{x}^{2}\\operatorname{tan}⁡x\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=x\\operatorname{sin}⁡x$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)\\operatorname{sin}⁡(-x) \\\\  & =-x(-\\operatorname{sin}⁡x) \\\\  & =x\\operatorname{sin}⁡x \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)={x}^{3}\\operatorname{cos}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)^{3}\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}\\operatorname{cos}⁡x \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nHence, by symmetry, we can conclude that\n\n$$\n{\\int }_{-2}^{2}{x}^{3}\\operatorname{cos}⁡x\\,\\text{d}x=0.\n$$\n\n- The function $h(x)={x}^{2}\\operatorname{tan}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{2}\\operatorname{tan}⁡(-x) \\\\  & ={x}^{2}(-\\operatorname{tan}⁡x) \\\\  & =-{x}^{2}\\operatorname{tan}⁡x \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-1}^{1}{x}^{2}\\operatorname{tan}⁡x\\,\\text{d}x=0.\n$$\n\nHence, the correct answer is \"II and III only.\""}] [{:db/id 17592186413343 :knowledge-point/_questions [{:db/id 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "130e6afa-dce0-5b08-819c-ef94704234fd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186413325} {:answer/id #uuid "376dd84b-186c-5a4f-8a0a-85f3f4cc251e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413326} {:answer/id #uuid "5a0f7606-ed30-5617-8e4d-36a130ebe24b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413328} {:answer/id #uuid "761e54dd-814f-565c-bb2b-669fb57d2836" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413329} {:answer/id #uuid "f5c2246d-16ff-5312-93dd-63dfdff73262" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id 17592186413336}] :answer-field/correct {:answer/id #uuid "5a0f7606-ed30-5617-8e4d-36a130ebe24b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413328} :answer-field/id #uuid "93e076d5-a5ae-573d-9e84-8303573a1f36" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413339}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93763c90-6504-59a6-ad5e-8ed17cc5ac6d" :question/math-academy-id "q-115272" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-1}^{1}{e}^{2x}\\,\\text{d}x$\n- ${\\int }_{0}^{\\pi }\\sqrt[3]{x}\\operatorname{cos}⁡x\\,\\text{d}x$\n- ${\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={e}^{2x}$ is *not* an odd function:\n\n$$\n\\begin{aligned}f(-x) & ={e}^{2(-x)} \\\\  & ={e}^{-2x} \\\\  & \\ne -f(x)\\,\\times \\end{aligned}\n$$\n\n- The function $g(x)=\\sqrt[3]{x}\\operatorname{cos}⁡x$ is an odd function, but integral II is not of the form ${\\int }_{-a}^{a}g(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\n- The function $h(x)=x{e}^{{x}^{2}}$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x){e}^{(-x)^{2}} \\\\  & =-x{e}^{{x}^{2}} \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-4}^{4}x{e}^{{x}^{2}}\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186413605 :knowledge-point/_questions [{:db/id 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59ef9340-52d9-5cb4-999f-d1140490bfc4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413590} {:answer/id #uuid "7ad62917-fe79-54d5-9e2a-eb52a863023e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186413593} {:answer/id #uuid "a5551b66-4909-5792-8d3d-3a30ec491dc1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186413596} {:answer/id #uuid "b09a08e9-f214-5a5c-b110-f1010c4b03ee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413598} {:answer/id #uuid "c068b9da-8858-56ed-90bd-f563b1b66009" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186413599}] :answer-field/correct {:answer/id #uuid "59ef9340-52d9-5cb4-999f-d1140490bfc4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413590} :answer-field/id #uuid "a22c5a1e-381b-53d5-9e61-1f0e13b8d114" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413604}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96f65a49-2a61-5981-a404-aa212d4de13c" :question/math-academy-id "q-331097" :question/problem "Which of the following systems of linear ODEs are decoupled?\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+2{x}_{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)=-7{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=9{x}_{2}(t)\\end{aligned}$" :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently. \n\nWith this in mind, let's examine our systems.\n\n- System I is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{1}^{′}(t)=4{x}_{1}(t)+5{x}_{2}(t)$ depends on ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- System II is *not* decoupled because some of its equations depend on more than one variable. For example, ${x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)$ depends on ${x}_{2}(t)$ and ${x}_{1}(t).$\n\n- System III is decoupled since its equations depend on only one variable each. Indeed, ${x}_{1}^{′}(t)=-7{x}_{1}(t)$ depends on only ${x}_{1}(t)$ and ${x}_{2}^{′}(t)=9{x}_{2}(t)$ depends on only ${x}_{2}(t).$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id 17592186413606 :knowledge-point/_questions [{:db/id 17592186166896 :knowledge-point/id #uuid "276898e7-57a4-5ca6-8df7-99fd318a2702" :knowledge-point/title "Identifying a Decoupled System of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4677b7a7-7f61-5a88-a5ee-a34ee62c287d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413589} {:answer/id #uuid "91bf1bed-82dd-5957-bd20-b0c4787407e0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413594} {:answer/id #uuid "96da30d2-eb7e-540b-b235-30c2de13031a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186413595} {:answer/id #uuid "ad2050e5-3099-5de8-9248-cf99c56b8941" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413597} {:answer/id #uuid "c90c80ee-ce2e-5334-9b0a-1654558fcf8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186413600}] :answer-field/correct {:answer/id #uuid "c90c80ee-ce2e-5334-9b0a-1654558fcf8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186413600} :answer-field/id #uuid "3adf9e22-bc52-5ded-9787-739dfa3cf328" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413602}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac9ae842-1c73-58e9-9ed3-756e4fa56ec1" :question/math-academy-id "q-331980" :question/problem "Which of the following systems of linear ODEs are decoupled?\n\n- ${x}^{′}(t)=[\\begin{aligned}8 & 0 \\\\ 0 & -1\\end{aligned}]x(t)$\n- ${x}^{′}(t)=[\\begin{aligned}0 & 7 \\\\ -4 & 3\\end{aligned}]x(t)$\n- ${x}^{′}(t)=[\\begin{aligned}2 & 0 \\\\ 0 & 5\\end{aligned}]x(t)$" :question/worked-solution "A *decoupled system* consists of equations depending on only one variable, such as\n\n$$\n{x}_{i}^{′}(t)={\\lambda }_{i}{x}_{i}(t),\n$$\n\nwhere ${\\lambda }_{i}$ is a constant. This means that we can solve each equation independently.  \n\nIn matrix form, a linear system ${x}^{′}(t)=Ax(t)$ is decoupled if $A$ is a diagonal matrix.\n\nWith this in mind, let's examine our systems.\n\n- Systems I and III are decoupled since their corresponding matrices are diagonal.\n\n- System II is *not* decoupled because its matrix is not diagonal.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id 17592186413694 :knowledge-point/_questions [{:db/id 17592186203903 :knowledge-point/id #uuid "0184c705-00dd-54b0-ba83-2f467167a185" :knowledge-point/title "Interpreting an Adjacency Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277d0727-838a-539b-819b-da8d7ad8d022" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413637} {:answer/id #uuid "2d5c613d-ce6f-5d2f-9d0d-b0d5c7bb9753" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186413640} {:answer/id #uuid "4593208d-f293-53fc-9281-392ec9c6d5d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186413643} {:answer/id #uuid "d4f8bb88-c52f-5544-9279-0cef54cf414b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413665} {:answer/id #uuid "fa660a92-6489-598b-aa9f-da0f6f998972" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413670}] :answer-field/correct {:answer/id #uuid "d4f8bb88-c52f-5544-9279-0cef54cf414b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413665} :answer-field/id #uuid "c5270f76-2521-5654-804b-ae6bd4a100ed" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413685}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93d6ac86-9246-53ae-8020-58de7dcc7070" :question/math-academy-id "q-213094" :question/problem "|  | $✠$ | $♣$ | $♠$ |\n| --- | --- | --- | --- |\n| $✠$ | $0$ | $1$ | $0$ |\n| $♣$ | $1$ | $1$ | $0$ |\n| $♠$ | $0$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined on the set $\\{✠,♣,♠\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(✠,♣)$\n\nII. $(♣,♠)$\n\nIII. $(♠,✠)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(✠,♣)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $✠$-row and the $♣$-column.\n\n- The pair $(♣,♠)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $♣$-row and the $♠$-column.\n\n- The pair $(♠,✠)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $♠$-row and the $✠$-column.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186413696 :knowledge-point/_questions [{:db/id 17592186203903 :knowledge-point/id #uuid "0184c705-00dd-54b0-ba83-2f467167a185" :knowledge-point/title "Interpreting an Adjacency Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ce382e1-19d7-5210-abc5-29008e719eaf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186413639} {:answer/id #uuid "7cf02d47-944c-5078-b040-436ef4d1dd79" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186413649} {:answer/id #uuid "9316338e-177e-596d-813f-c2b271e78ea4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186413654} {:answer/id #uuid "d0194c58-f1d2-5a9f-83ca-8ef30dfdeae5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413664} {:answer/id #uuid "e90085ef-ae69-595f-9edc-e65d95950ed1" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186413667}] :answer-field/correct {:answer/id #uuid "d0194c58-f1d2-5a9f-83ca-8ef30dfdeae5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186413664} :answer-field/id #uuid "90a2eff9-7291-52e7-a8a6-32507eaf07e1" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413681}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e24d1221-5380-50fb-b4e2-6e139d57675a" :question/math-academy-id "q-213100" :question/problem "|  | $3$ | $6$ |\n| --- | --- | --- |\n| $2$ | $1$ | $0$ |\n| $4$ | $0$ | $1$ |\n| $8$ | $1$ | $1$ |\n\nThe adjacency matrix of the relation $R,$ defined over the sets $\\{2,4,8\\}$ and $\\{3,6\\},$ is given above. Which of the following ordered pairs belong to the relation?\n\nI. $(4,3)$\n\nII. $(8,6)$\n\nIII. $(2,3)$" :question/worked-solution "If a relation $R$ is defined over $A=\\{{a}_{1},{a}_{2},…,{a}_{m}\\}$ and $B=\\{{b}_{1},{b}_{2},…{b}_{n}\\}$ of cardinalities $m$ and $n,$ respectively, the *adjacency matrix* of $R$ is a $m\\times n$-matrix (or table), where the element ${r}_{ij}$ at the intersection of the $i$th row and the $j$th column is given by\n\n$$\n{r}_{ij}=\\{\\begin{aligned}1,\\,\\text{if }{a}_{i}\\,R\\,{b}_{j}, \\\\ 0,\\,\\text{otherwise}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the given ordered pairs.\n\n- The pair $(4,3)$ does not belong to the relation since the adjacency matrix has $0$ on the intersection of the $4$-row and the $3$-column.\n\n- The pair $(8,6)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $8$-row and the $6$-column.\n\n- The pair $(2,3)$ belongs to the relation. Indeed, the adjacency matrix has $1$ on the intersection of the $2$-row and the $3$-column.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186413824 :knowledge-point/_questions [{:db/id 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18db0a49-6e70-5b48-904f-fb9b5f8f1167" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id 17592186413801} {:answer/id #uuid "1d8d25d8-fe04-53ff-b342-7ebac143d4d5" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id 17592186413802} {:answer/id #uuid "1dc8f4a4-b6d6-5c99-bf78-b1f7a4d93a23" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id 17592186413803} {:answer/id #uuid "521a920f-2f8c-531a-965b-1cdb14e91dd0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186413807} {:answer/id #uuid "bf0253c3-f269-5021-82aa-caf40ced2760" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186413812}] :answer-field/correct {:answer/id #uuid "521a920f-2f8c-531a-965b-1cdb14e91dd0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id 17592186413807} :answer-field/id #uuid "0f91971d-c20c-5a76-a12b-2827ef0652b8" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413818}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72e836b6-2968-5b2e-8666-6c15080ad3e0" :question/math-academy-id "q-42005" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{32}\\ne 0$ (condition  II is violated). \n\n$$\nA=[\\begin{aligned}3 & 5 & 3 & 6 \\\\ 0 & 4 & 5 & 4 \\\\ 0 & 3 & 2 & 7 \\\\ 0 & 0 & -2 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ is not in row echelon form since ${b}_{21}\\ne 0$ (condition II is violated). \n\n$$\nB=[\\begin{aligned}-1 & 3 & 1 & 0 \\\\ 1 & -2 & 4 & 1 \\\\ 0 & 4 & -2 & 5 \\\\ 0 & 0 & 1 & 3 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}4 & 9 & 3 & 9 \\\\ 0 & 2 & 2 & 7 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\nTherefore, only $C$ is in row echelon form."}] [{:db/id 17592186413825 :knowledge-point/_questions [{:db/id 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bcbaf3a-7d79-5c34-9970-8e30a0164f3d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id 17592186413798} {:answer/id #uuid "12f4ffe3-c54b-5dec-af7e-f3eb29c5efac" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id 17592186413800} {:answer/id #uuid "3fd4fdcb-52a1-577b-9cee-a9fa9d18334b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id 17592186413805} {:answer/id #uuid "42122353-59f4-5dee-9867-47f69bf794e2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id 17592186413806} {:answer/id #uuid "e9c227b1-80fa-5ed1-8fcb-7bbadbc92d9f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id 17592186413817}] :answer-field/correct {:answer/id #uuid "3fd4fdcb-52a1-577b-9cee-a9fa9d18334b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id 17592186413805} :answer-field/id #uuid "848d2bf5-7181-5403-afac-d10425ef5d8c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186413819}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0f43991-a609-584a-a820-e263b283da38" :question/math-academy-id "q-129230" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}],\\,B=[\\begin{aligned}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{aligned}],\\,C=[\\begin{aligned}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since ${a}_{33}\\ne 0$ (condition II is violated).\n\n$$\nA=[\\begin{aligned}-5 & 0 & 8 & 4 & 2 \\\\ 0 & 0 & 3 & -5 & 0 \\\\ 0 & 0 & -2 & 0 & 1 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}4 & 0 & 6 & 8 \\\\ 0 & 0 & 3 & -1 \\\\ 0 & 0 & 0 & 2\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}0 & -9 & 0 & -6 \\\\ 0 & 0 & 1 & -7 \\\\ 0 & 0 & 0 & 1 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."}] [{:db/id 17592186414080 :knowledge-point/_questions [{:db/id 17592186161972 :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eb51416-f701-5ee9-b8ba-890cb4fc290c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186414042} {:answer/id #uuid "41acb45f-a093-5fc2-ab40-01131398008b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414049} {:answer/id #uuid "65247087-2b2c-5c14-9dbe-ed7ca6e9451b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414054} {:answer/id #uuid "87ed7622-25d5-5050-a518-3bf70496d27a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186414058} {:answer/id #uuid "e43f6e8e-2053-5481-a5ab-80957e4905bf" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414070}] :answer-field/correct {:answer/id #uuid "65247087-2b2c-5c14-9dbe-ed7ca6e9451b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414054} :answer-field/id #uuid "27a54542-1615-5cf2-b688-855028ab2529" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186414074}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34033db1-99ab-5af1-b893-026e522543dd" :question/math-academy-id "q-93742" :question/problem "Which of the following pairs $(x,y)$ are solutions of the Diophantine equation $2x+5y=200?$\n\n- $(20,32)$\n- $(10,20)$\n- $(15,35)$" :question/worked-solution "Let's check each pair in turn.\n\n- $(20,32)$ is a solution of our equation. Indeed, substituting $x=20$ and $y=32,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 20+5\\cdot 32 & =200 \\\\ 40+160 & =200 \\\\ 200 & =200\\,✓\\end{aligned}\n$$\n\n- $(10,20)$ is *not* a solution of our equation. Substituting $x=10$ and $y=20,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 10+5\\cdot 20 & =200 \\\\ 20+100 & =200 \\\\ 120 & \\ne 200\\,\\times \\end{aligned}\n$$\n\n- $(15,35)$ is *not* a solution of our equation. Substituting $x=15$ and $y=35,$ we obtain\n\n$$\n\\begin{aligned}2x+5y & =200 \\\\ 2\\cdot 15+5\\cdot 35 & =200 \\\\ 30+175 & =200 \\\\ 205 & \\ne 200\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186414082 :knowledge-point/_questions [{:db/id 17592186161972 :knowledge-point/id #uuid "8919d471-0e4c-55c1-b39e-2b46a86540d2" :knowledge-point/title "Identifying a Solution of a Linear Diophantine Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07abc408-ee18-502b-a90f-e521c92d5444" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414032} {:answer/id #uuid "2e84d745-b17e-5f23-8c44-e7089e4d17bc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414041} {:answer/id #uuid "2ecb567a-fcb6-526c-9b17-838593d46ffd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186414043} {:answer/id #uuid "85dc5b85-bf5d-505f-956c-d202e6c5d13c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414056} {:answer/id #uuid "d8a09bfe-6607-5557-a5c2-06953c88c2fe" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186414067}] :answer-field/correct {:answer/id #uuid "07abc408-ee18-502b-a90f-e521c92d5444" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414032} :answer-field/id #uuid "bf0b86e1-db82-5c78-85bb-75796ef36d8d" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186414079}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "689613bd-55bf-5236-b19b-6e6b928e5d1e" :question/math-academy-id "q-93737" :question/problem "Which of the following pairs $(x,y)$ are solutions of the Diophantine equation $5x+6y=8?$\n\n- $(-2,2)$\n- $(-8,8)$\n- $(4,-4)$" :question/worked-solution "Let's check each pair in turn.\n\n- $(4,-4)$ is *not* a solution of our equation. Substituting $x=4$ and $y=-4,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot (-2)+6\\cdot 2 & =8 \\\\ -10+12 & =8 \\\\ 2 & \\ne 8\\,\\times \\end{aligned}\n$$\n\n- $(-8,8)$ is a solution of our equation. Indeed, substituting $x=-8$ and $y=8,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot (-8)+6\\cdot 8 & =8 \\\\ -40+48 & =8 \\\\ 8 & =8\\,✓\\end{aligned}\n$$\n\n- $(4,-4)$ is *not* a solution of our equation. Substituting $x=4$ and $y=-4,$ we obtain\n\n$$\n\\begin{aligned}5x+6y & =8 \\\\ 5\\cdot 4+6\\cdot (-4) & =8 \\\\ 20-24 & =8 \\\\ -4 & \\ne 8\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186414084 :knowledge-point/_questions [{:db/id 17592186161973 :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54c8e6c9-5823-57e7-8ad2-0d7ac46b2c00" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186414052} {:answer/id #uuid "9f23f971-84cb-5faa-bf04-60cc62e01518" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414060} {:answer/id #uuid "ab08ae5d-b81b-5b7f-b1e4-9f36ba4fc633" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414061} {:answer/id #uuid "b9898d7c-59fd-5844-a876-adc80cd213d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186414064} {:answer/id #uuid "c4b165e3-3c82-579e-ad3e-21b5708e8e22" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414066}] :answer-field/correct {:answer/id #uuid "b9898d7c-59fd-5844-a876-adc80cd213d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186414064} :answer-field/id #uuid "04b66cf6-b8c7-535c-9714-7a3946dba362" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186414073}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8955bc35-57b9-5c55-b8c0-47deb511cca7" :question/math-academy-id "q-93798" :question/problem "Which of the following Diophantine equations have solutions?\n\n- $15x-20y=5$\n- $11x+9y=13$\n- $-8x+2y=5$" :question/worked-solution "Recall that a linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d\\,|\\,c,$ where $d=\\text{gcd}(a,b).$  \n\nWith that in mind, let's examine each equation in turn.\n\n- Equation I has solutions. We have $a=15,$ $b=-20,$ and $c=5.$ Since\n\n$$\nd=\\text{gcd}(15,-20)=5\n$$\n\nand $5\\,|\\,5,$ our equation has solutions.\n\n- Equation II has solutions. We have $a=11,$ $b=9,$ and $c=13.$ Since\n\n$$\nd=\\text{gcd}(11,9)=1\n$$\n\nand $1\\,|\\,13,$ our equation has solutions.\n\n- Equation III has no solution. We have $a=-8,$ $b=2,$ and $c=5.$ Since\n\n$$\nd=\\text{gcd}(-8,2)=2\n$$\n\nand $2\\,\\text{⧸}|\\,5,$ our equation has no solution.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id 17592186414086 :knowledge-point/_questions [{:db/id 17592186161973 :knowledge-point/id #uuid "607df418-165b-5d37-aae1-d49ce8e9d3e5" :knowledge-point/title "Identifying Whether a Linear Diophantine Equation Has a Solution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92dff5ed-0d2c-5156-a7ca-7703fc0fab34" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414059} {:answer/id #uuid "b5f6c676-3fd9-5b33-83a6-e0dcdebbe09e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186414063} {:answer/id #uuid "bcb1e6e3-02dc-5bea-b18b-2336e2272aa2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186414065} {:answer/id #uuid "e1ed957f-886a-57c2-ba08-09950665c10e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414069} {:answer/id #uuid "e57da4e8-7a71-56f7-a258-a56df2090f60" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186414071}] :answer-field/correct {:answer/id #uuid "e1ed957f-886a-57c2-ba08-09950665c10e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414069} :answer-field/id #uuid "bc69eb91-457d-5ddb-86de-21120a732fea" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186414078}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccf1e2c5-efff-5b3d-ba7c-30f178649720" :question/math-academy-id "q-93795" :question/problem "Which of the following Diophantine equations have solutions?\n\n- $3x+7y=11$\n- $-3x-9y=2$\n- $-12x+15y=21$" :question/worked-solution "Recall that a linear Diophantine equation\n\n$$\nax+by=c\n$$\n\nhas a solution if and only if $d\\,|\\,c,$ where $d=\\text{gcd}(a,b).$  \n\nWith that in mind, let's examine each equation in turn.\n\n- Equation I has solutions. We have $a=3,$ $b=7,$ and $c=11.$ Since\n\n$$\nd=\\text{gcd}(3,7)=1\n$$\n\nand $1\\,|\\,11,$ our equation has solutions.\n\n- Equation II has no solution. We have $a=-3,$ $b=-9,$ and $c=2.$ Since\n\n$$\nd=\\text{gcd}(-3,-9)=3\n$$\n\nand $3\\,\\text{⧸}|\\,2,$ our equation has no solution.\n\n- Equation III has solutions. We have $a=-12,$ $b=15,$ and $c=21.$ Since\n\n$$\nd=\\text{gcd}(-12,15)=3\n$$\n\nand $3\\,|\\,21,$ our equation has solutions.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id 17592186414783 :knowledge-point/_questions [{:db/id 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bc8b4d-f0f8-5fac-bc3c-b53d54ae5ddd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414761} {:answer/id #uuid "3c0520e3-100c-511f-93d0-03184b36355c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186414763} {:answer/id #uuid "8144e151-6edf-5a1d-8dd9-4ccdae692873" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414769} {:answer/id #uuid "bcc5db05-604b-529c-8451-c58c3b5d86ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414774} {:answer/id #uuid "f6a3761a-c3e7-5d2a-bf18-a0bf7771e015" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186414776}] :answer-field/correct {:answer/id #uuid "bcc5db05-604b-529c-8451-c58c3b5d86ef" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414774} :answer-field/id #uuid "67e57e20-93cb-5386-9ed7-6c9b4b0bdca5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186414781}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0b65bfe0-6178-564e-825d-19d4ac9443d8" :question/math-academy-id "q-150012" :question/problem "![](images/5a/5a3961346a4bcb0d94e46caf6d6ed1253dc56fb4761db07b11829e329bc2fa8d.png)\n\nConsider the part of parabola and constant vector field $F$ shown above. Let $C$ be the path where the part of parabola is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{C}F\\cdot \\text{d}r=0$\n- ${\\int }_{-C}F\\cdot \\text{d}r<0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I is false, while statement II is true. As the particle moves from $A$ to $B,$ the force $F$ works against the particle for $x>0,$ while $F$  works with the particle for $x<0.$ \n\n![](images/af/af80eab6427f376084301c03715fd098cfe4a1c816dcd72d3e1129cfa35ff29d.png)\n\n \n\nBy symmetry, the contribution to ${\\int }_{C}F\\cdot \\text{d}r$ for $x<0$ is canceled out by the contribution for $x>0.$ So,\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/a2/a26ca79400bf30aa891543d30a052a6e8ec071ccb48fcd8c418fe0a713dad212.png)\n\n \n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id 17592186414784 :knowledge-point/_questions [{:db/id 17592186179742 :knowledge-point/id #uuid "3d72127a-90d6-5f7e-bd87-75d03285a918" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Non-Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4db111dc-7fb9-5c06-a206-7d58841220c2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186414765} {:answer/id #uuid "82abd5c1-cc03-5998-9437-7d38d9e12857" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186414770} {:answer/id #uuid "976abf9b-c560-5ddc-b4bb-7ea781964fe6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186414772} {:answer/id #uuid "af7374c1-bbc9-5667-8fae-9fa461dd705e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414773} {:answer/id #uuid "fe95e432-23b7-59d4-a759-3918bb1469c0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414778}] :answer-field/correct {:answer/id #uuid "fe95e432-23b7-59d4-a759-3918bb1469c0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186414778} :answer-field/id #uuid "5e2527fd-1520-5814-b1fe-d6567b06be4b" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186414780}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "277ca4a2-1c02-58e4-b62f-d0e1176e96df" :question/math-academy-id "q-125499" :question/problem "![](images/8f/8ffc97d4fc442503eb5b59e01f317cc7a77cf57d041e16807aa0645f962a5aeb.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the three-quarter circle is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r>0$\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$" :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is true while statement II is false. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $A$ to $B.$\n\n![](images/c9/c9805268d9f4984983c3cc5e2200a0c22d804bc67076a3505ad35471693c037b.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- Statement III is false. It's clear from the picture below that $F$ works against the motion of the particle as it moves from $B$ to $A.$\n\n![](images/da/dafb4d468e7711a804a5141301a02331bb5c7900f018a8ecdb6fd382bc05b799.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r<0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 17592186414785 :knowledge-point/_questions [{:db/id 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0647548c-ab35-55bf-8337-73e7e06109dc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186414759} {:answer/id #uuid "3a3dd4f2-011a-5611-b73e-e1b9ef1410fc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186414762} {:answer/id #uuid "4ac9c12e-cbbb-514a-b111-e9429b33ce3f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id