#{[{:db/id #edb/ref 17592186064639 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519418f0-46ce-521e-aee8-2766f235966a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459749} {:answer/id #uuid "29ca73ed-4234-585f-857f-7ae978a7567d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459750}] :answer-field/correct {:answer/id #uuid "29ca73ed-4234-585f-857f-7ae978a7567d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459750} :answer-field/id #uuid "a6b545ee-1b2a-5dc1-9905-d03bf303ff57" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460741} {:answer-field/choices [{:answer/id #uuid "8c50e701-687b-51f1-8681-7be01069f396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459751} {:answer/id #uuid "6e1799eb-53fb-5412-a04b-864186317d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459752}] :answer-field/correct {:answer/id #uuid "6e1799eb-53fb-5412-a04b-864186317d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459752} :answer-field/id #uuid "a2620135-5dcb-5b48-bf58-acc76258f4be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460742} {:answer-field/choices [{:answer/id #uuid "ac754a7f-3579-5d29-b3ee-0bd77fce0bbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459753} {:answer/id #uuid "f81c2cab-8400-55bc-9a00-84d2c23ef49d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459754}] :answer-field/correct {:answer/id #uuid "f81c2cab-8400-55bc-9a00-84d2c23ef49d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459754} :answer-field/id #uuid "466537a0-143b-51e1-958c-fad736eaa013" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460743} {:answer-field/choices [{:answer/id #uuid "490ccb89-606a-573a-bbc2-b7121b826479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459755} {:answer/id #uuid "7fbef945-532b-532a-b6b5-f5e58c104502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459756}] :answer-field/correct {:answer/id #uuid "7fbef945-532b-532a-b6b5-f5e58c104502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459756} :answer-field/id #uuid "3bb5f918-94a1-5adb-b260-d3ec1040aea7" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460744}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a4e43127-8c70-53b8-9c7f-f4ea673dfe39" :question/math-academy-id "q-2459" :question/problem "For the function $f(x)=6{x}^{2}-4{x}^{3},$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{″}(0)>0$\n- **II.** $x=0$ is a relative minimum of $f(x)$\n- **III.** ${f}^{″}(1)<0$\n- **IV.** $x=1$ is a relative maximum of $f(x)$" :question/requires-calculator true :question/worked-solution "We need to identify the critical points. Then, we then need to classify them using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=6{x}^{2}-4{x}^{3},$ we get\n\n$$\n{f}^{′}(x)=12x-12{x}^{2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}12x-12{x}^{2} & =0 \\\\ 12x(1-x) & =0 \\\\ x & =0,1.\\end{aligned}\n$$\n\nSo we have critical points at $x=0,1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at the critical points. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=12-24x,\n$$\n\nand evaluating ${f}^{″}(x)$ at each critical point, we get\n\n$$\n\\begin{aligned}{f}^{″}(0) & =12>0 \\\\ {f}^{″}(1) & =-12<0.\\end{aligned}\n$$\n\nWe conclude that:\n\n- Statements I and II are true. The second derivative is positive at $x=0,$ so this is a relative minimum of $f(x).$\n\n- Statements III and VI are true. The second derivative is negative at $x=1,$ so this is a relative maximum of $f(x).$\n\nTherefore, the correct answer is, \"I, II, III, and IV.\""}] [{:db/id #edb/ref 17592186129841 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd96f985-646a-5351-b253-f0f95e8d6cc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460167} {:answer/id #uuid "fec5ba87-c419-560c-b2ba-bfc88d02a82e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460168}] :answer-field/correct {:answer/id #uuid "fec5ba87-c419-560c-b2ba-bfc88d02a82e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460168} :answer-field/id #uuid "0ebca1f5-c590-5037-9705-2d669297c270" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460950} {:answer-field/choices [{:answer/id #uuid "1a3ff502-9a19-5d3d-b530-9a9bf3e410d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460169} {:answer/id #uuid "45de598b-3b91-5235-928b-a27046c1368a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460170}] :answer-field/correct {:answer/id #uuid "45de598b-3b91-5235-928b-a27046c1368a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460170} :answer-field/id #uuid "d4a62c74-c650-5a78-92c1-6052f0293257" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460951} {:answer-field/choices [{:answer/id #uuid "4406943e-20a0-5c47-9f3b-12422d2366ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460171} {:answer/id #uuid "a14b7932-a9aa-55ab-87a0-b0dcf56024dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460172}] :answer-field/correct {:answer/id #uuid "4406943e-20a0-5c47-9f3b-12422d2366ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460171} :answer-field/id #uuid "a353e8b3-884f-5bc4-bb00-c6d7f9c98968" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460952}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b84b6274-fa65-5873-af84-3d0475556d93" :question/math-academy-id "q-71892" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=1-{x}^{2}$ and the line $y=-3?$\n\nSelect all that apply.\n\n- **I.** It is a type I region\n- **II.** It is a type II region\n- **III.** It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\ny=1-{x}^{2}\\,⟹\\,x=\\pm \\sqrt{1-y}.\n$$\n\nNow, let's sketch our region.\n\n![](images/72/726ad8599b89029d3dba8e79ca947af99c17bd8712e551e49fc33d3e597a5cb7.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 2,\\,-3\\le y\\le 1-{x}^{2}\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-3\\le y\\le 1,\\,-\\sqrt{1-y}\\le y\\le \\sqrt{1-y}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186180023 :knowledge-point/_questions [{:db/id #edb/ref 17592186179740 :knowledge-point/id #uuid "6f30993e-b5c7-5d8a-9b27-2aed2c9223e1" :knowledge-point/title "Determining the Sign of a Circulation From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a8b6878-85b8-58eb-a242-cf54f14a0ed6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459491} {:answer/id #uuid "31fb75c7-a022-54df-a901-a9869c56eff3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459492}] :answer-field/correct {:answer/id #uuid "0a8b6878-85b8-58eb-a242-cf54f14a0ed6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459491} :answer-field/id #uuid "3e67b26d-312f-5124-b515-45ca803fdb86" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460612} {:answer-field/choices [{:answer/id #uuid "310240c9-bca3-503f-87c1-b88b9a790c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459493} {:answer/id #uuid "8acc9467-c049-5e2f-91a7-f70e0c1b40fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459494}] :answer-field/correct {:answer/id #uuid "310240c9-bca3-503f-87c1-b88b9a790c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459493} :answer-field/id #uuid "4a84f387-e198-5acc-ae65-f1896114917e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460613} {:answer-field/choices [{:answer/id #uuid "c9fa6a11-4b01-5ec8-98ee-ef928f01c5a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459495} {:answer/id #uuid "aefb95da-9bcd-543a-8c79-cce66b4132ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459496}] :answer-field/correct {:answer/id #uuid "aefb95da-9bcd-543a-8c79-cce66b4132ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186459496} :answer-field/id #uuid "c520ba73-5e23-574e-b441-acfbad776311" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "889fbef5-9dc3-5991-a476-ffe3c0711611" :question/math-academy-id "q-125395" :question/problem "![](images/0a/0ae64bf57444ac42ec5efed392471cbbac7b1e317bc1fb06b33bcd2038a2e3c1.png)\n\nConsider the ellipse $E$ and the vector field $F,$ shown above. Let $C$ be any path where $E$ is traversed once in the counterclockwise direction. Which of the following statements are true?\n\n- ${∮}_{C}F\\cdot \\text{d}r>0$\n- ${∮}_{C}F\\cdot \\text{d}r=0$\n- ${∮}_{-C}F\\cdot \\text{d}r>0$\n\nSelect all that apply." :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I and II are false. It's clear from the picture below that $F$ works against the motion of the particle as it moves clockwise along $C.$ \n\n![](images/bc/bc0121782b16d513d7d17d3741bd07ef1716e096bb2459fbda0cb841c7fd8b43.png)\n\nSo, ${∮}_{C}F\\cdot \\text{d}r<0.$\n\n- Statement III is true. It's clear from the picture below that $F$ assists the motion of the particle as it moves **clockwise** along $C.$\n\n![](images/1a/1a6b109bc1da3aa7905b05f7f7902523b45fd51a65b97bec1328037bd6c0cfe7.png)\n\nSo, ${∮}_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186278226 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f30f8006-242d-5815-b4e6-55180636d13f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464624} {:answer/id #uuid "ef125b16-49f4-57ed-a235-602a4af9bf7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464625}] :answer-field/correct {:answer/id #uuid "ef125b16-49f4-57ed-a235-602a4af9bf7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464625} :answer-field/id #uuid "614ca28a-51fa-5e6b-824d-0455718a1caf" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465246} {:answer-field/choices [{:answer/id #uuid "743ea134-bede-5e5d-85c1-b8959c98fb2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464626} {:answer/id #uuid "eee1c213-a5e6-5182-adec-568d9d22a6c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464627}] :answer-field/correct {:answer/id #uuid "eee1c213-a5e6-5182-adec-568d9d22a6c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464627} :answer-field/id #uuid "fe6e976a-ce43-535a-834b-e62cc2342a63" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465247} {:answer-field/choices [{:answer/id #uuid "ddd57b68-0ced-5792-aded-4f16279eb1ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464628} {:answer/id #uuid "8d462a0f-93c1-5775-84c1-96d61ea828a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464629}] :answer-field/correct {:answer/id #uuid "ddd57b68-0ced-5792-aded-4f16279eb1ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464628} :answer-field/id #uuid "d83acde9-9dda-58e0-a072-e702efca6af3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465248}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "951baf6c-974c-552a-a084-e87ba6cba5d6" :question/math-academy-id "q-159485" :question/problem "![](images/f4/f4ad8b759d3f2781b1dc6adf64e58a230218655249f21fdd8f6a852568554ead.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is a boundary point of the set $M$\n- $B$ is an interior point of the set $M$\n- $C$ is a boundary point of the set $M$\n\nSelect all that apply." :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/56/56a640baf27e1acb5c3428e1bef25a87b3ff965dff71762b94fb1eff94aaf24d.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement II is true. Indeed, $B$ is an interior point since there exists an open neighborhood of $B$ that is fully contained inside the set $M.$\n\n- Statement III is false. The point $C$ is an interior point since there exists an open neighborhood of $B$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is 'I and II only'."}] [{:db/id #edb/ref 17592186290566 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c29fd2a-ae48-52ee-ba67-7067dea380f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465899} {:answer/id #uuid "14c90ded-4dbd-5cc9-b578-8bbcf18e2466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465900}] :answer-field/correct {:answer/id #uuid "5c29fd2a-ae48-52ee-ba67-7067dea380f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465899} :answer-field/id #uuid "06a90856-9f38-5923-8454-f545e75c55a3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466793} {:answer-field/choices [{:answer/id #uuid "c64831ae-fe38-5483-9592-34c5ba078eb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465901} {:answer/id #uuid "ee9bc399-e38e-51c9-a24b-0515e5e03aa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465902}] :answer-field/correct {:answer/id #uuid "ee9bc399-e38e-51c9-a24b-0515e5e03aa6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465902} :answer-field/id #uuid "3d4d7c55-71d2-50d5-95fe-51e81764dd1c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466794} {:answer-field/choices [{:answer/id #uuid "83cdc54b-214f-5986-8b82-254b42883bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465903} {:answer/id #uuid "acac67e3-2f8e-55cd-b42c-649006d58792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465904}] :answer-field/correct {:answer/id #uuid "83cdc54b-214f-5986-8b82-254b42883bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465903} :answer-field/id #uuid "954c2c17-de3e-55b9-acbc-5eb1abb3d144" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466795} {:answer-field/choices [{:answer/id #uuid "468616b9-692e-5d47-8126-953037fcb574" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465905} {:answer/id #uuid "ca3be01e-97a7-508b-b3c9-0ecc4baeb375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465906}] :answer-field/correct {:answer/id #uuid "ca3be01e-97a7-508b-b3c9-0ecc4baeb375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465906} :answer-field/id #uuid "a55e8f74-90ed-54c3-aa6c-dbaf15781e10" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54523433-2b3d-5350-9453-344ec229fc6f" :question/math-academy-id "q-2469" :question/problem "For the function $f(x)=6{x}^{2}-4{x}^{3},$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{″}(0)<0$\n- **II.** $x=0$ is a relative minimum of $f(x)$\n- **III.** ${f}^{″}(1)>0$\n- **IV.** $x=1$ is a relative maximum of $f(x)$" :question/worked-solution "We need to identify the critical points. Then, we then need to classify them using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=6{x}^{2}-4{x}^{3},$ we get\n\n$$\n{f}^{′}(x)=12x-12{x}^{2},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}12x-12{x}^{2} & =0 \\\\ 12x(1-x) & =0 \\\\ x & =0,1.\\end{aligned}\n$$\n\nSo we have critical points at $x=0,1.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at the critical points. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=12-24x,\n$$\n\nand evaluating ${f}^{″}(x)$ at each critical point, we get\n\n$$\n\\begin{aligned}{f}^{″}(0) & =12>0 \\\\ {f}^{″}(1) & =-12<0.\\end{aligned}\n$$\n\nWe conclude that:\n\n- Statement I is false while statement II is true. The second derivative is positive at $x=0,$ so this is a relative minimum of $f(x).$\n\n- Statement III is false while statement VI is true. The second derivative is negative at $x=1,$ so this is a relative maximum of $f(x).$\n\nTherefore, the correct answer is \"II and IV only\"."}] [{:db/id #edb/ref 17592186290567 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0816a5ca-d233-5de3-b278-dbb902670115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465907} {:answer/id #uuid "f96b1b20-d897-5062-93f6-064bcde23260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465908}] :answer-field/correct {:answer/id #uuid "f96b1b20-d897-5062-93f6-064bcde23260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465908} :answer-field/id #uuid "b7b45853-6985-5b1c-a81d-b66dab8d14e0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466797} {:answer-field/choices [{:answer/id #uuid "99387c6c-3ddf-5e6c-999e-d41fdd79f070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465909} {:answer/id #uuid "1d219022-9306-536f-949c-6d874ce26dbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465910}] :answer-field/correct {:answer/id #uuid "99387c6c-3ddf-5e6c-999e-d41fdd79f070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465909} :answer-field/id #uuid "ccc10a60-f3da-5766-9a59-91d8841ae5e6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466798} {:answer-field/choices [{:answer/id #uuid "039db766-6a2b-5ff0-9a62-f0e43addb0ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465911} {:answer/id #uuid "39662058-7b0d-5dc9-907a-8c4194cce15f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465912}] :answer-field/correct {:answer/id #uuid "39662058-7b0d-5dc9-907a-8c4194cce15f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465912} :answer-field/id #uuid "878ea395-503e-5466-87e1-15fafb7cda6c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466799} {:answer-field/choices [{:answer/id #uuid "0baea45a-e521-55e5-a85e-0c96f76c085a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465913} {:answer/id #uuid "eef39c75-0496-5cd9-98db-a11876ef340b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465914}] :answer-field/correct {:answer/id #uuid "0baea45a-e521-55e5-a85e-0c96f76c085a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465913} :answer-field/id #uuid "beccd9e8-da77-5e9d-bc60-9f35d6fbabba" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466800}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "19694b62-f531-5e43-9d81-ba1b9a788be0" :question/math-academy-id "q-2471" :question/problem "For the function $f(x)=5{x}^{3}+15{x}^{2}-10,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{″}(0)>0$\n- **II.** $x=0$ is a relative maximum of $f(x)$\n- **III.** ${f}^{″}(-2)<0$\n- **IV.** $x=-2$ is a relative minimum of $f(x)$" :question/worked-solution "We need to identify the critical points. Then, we then need to classify them using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=5{x}^{3}+15{x}^{2}-10,$ we get\n\n$$\n{f}^{′}(x)=15{x}^{2}+30x,\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}15{x}^{2}+30x & =0 \\\\ 15x(x+2) & =0 \\\\ x & =0,-2.\\end{aligned}\n$$\n\nSo we have critical points at $x=0,-2.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at the critical points. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=30x+30,\n$$\n\nand evaluating ${f}^{″}(x)$ at each critical point, we get\n\n$$\n\\begin{aligned}{f}^{″}(0) & =30>0 \\\\ {f}^{″}(-2) & =-30<0.\\end{aligned}\n$$\n\nWe conclude that:\n\n- Statements I is true while statement II is false. The second derivative is positive at $x=0,$ so this is a relative minimum of $f(x).$\n\n- Statements III is true while statement VI is false. The second derivative is negative at $x=-2,$ so this is a relative maximum of $f(x).$\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186308693 :knowledge-point/_questions [{:db/id #edb/ref 17592186157453 :knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dfee73e7-0112-5b10-9471-39a9a18f611b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466279} {:answer/id #uuid "f2522a59-62fc-5f5a-b7eb-96387dca5f76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466280}] :answer-field/correct {:answer/id #uuid "f2522a59-62fc-5f5a-b7eb-96387dca5f76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466280} :answer-field/id #uuid "c38575ec-7d37-5f69-888c-de6fa827bcaa" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466983} {:answer-field/choices [{:answer/id #uuid "8b993091-02a1-5ea4-b695-173f1843de57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466281} {:answer/id #uuid "26c00063-63de-57f4-a9e4-1ac6e46eda75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466282}] :answer-field/correct {:answer/id #uuid "8b993091-02a1-5ea4-b695-173f1843de57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466281} :answer-field/id #uuid "4d737a1f-7f59-55e7-985d-ab977e42c4cc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466984} {:answer-field/choices [{:answer/id #uuid "9846bdec-c728-5080-91e0-da12b46ab5e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466283} {:answer/id #uuid "54ae4d8c-42e7-5689-850a-2615c9fb1102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466284}] :answer-field/correct {:answer/id #uuid "9846bdec-c728-5080-91e0-da12b46ab5e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466283} :answer-field/id #uuid "96efe50c-03ce-5f7d-8d01-83d2857f6dfc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466985}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05b85b1b-94cc-5955-8bdf-0e035f03c881" :question/math-academy-id "q-334851" :question/problem "Suppose $f(x)=3{x}^{5}-2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f=O(1)$ as $x\\to 0$\n- **II.** $f=O({x}^{2})$ as $x\\to 0$\n- **III.** $f=O({x}^{3})$ as $x\\to 0$" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nTo do this, we can examine the following limit:\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}.\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the polynomial\n\n$$\nf(x)=3{x}^{5}-2x+1.\n$$\n\nNow, let's consider each statement in turn.\n\n- Statement I is true. Let $g(x)=1.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{3{x}^{5}-2x}{1} \\\\  & ={lim}_{x\\to 0}(3{x}^{5}-2x) \\\\  & =0.\\end{aligned}\n$$\n\nHence, $f=O(1)$ as $x\\to 0.$\n\n- Statement II is true. Let $g(x)={x}^{2}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{3{x}^{5}-2x}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}(3{x}^{3}-\\frac{2}{x}) \\\\  & =\\infty .\\end{aligned}\n$$\n\nHence, $f\\ne O({x}^{2})$ as $x\\to 0.$\n\n- Statement III is false. Let $g(x)={x}^{3}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{3{x}^{5}-2x}{{x}^{3}} \\\\  & ={lim}_{x\\to 0}(3{x}^{2}-\\frac{2}{{x}^{2}}) \\\\  & =\\infty .\\end{aligned}\n$$\n\nHence, $f\\ne O({x}^{3})$ as $x\\to 0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186308716 :knowledge-point/_questions [{:db/id #edb/ref 17592186157453 :knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c75eac-0251-58fc-9409-e3c4fbb0db53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466285} {:answer/id #uuid "679d0c57-b841-573a-a685-4a8622782fb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466286}] :answer-field/correct {:answer/id #uuid "679d0c57-b841-573a-a685-4a8622782fb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466286} :answer-field/id #uuid "68da005c-225d-5113-8d8b-13cea0f5abd0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466986} {:answer-field/choices [{:answer/id #uuid "83972ef9-8c66-548b-beca-5689ea6208b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466287} {:answer/id #uuid "1c51d4c0-55aa-5641-9e5b-281e3384a135" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466288}] :answer-field/correct {:answer/id #uuid "83972ef9-8c66-548b-beca-5689ea6208b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466287} :answer-field/id #uuid "dc0a24d0-4e27-5bdf-becf-739116d3d53d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466987} {:answer-field/choices [{:answer/id #uuid "ecadbcf1-48ad-521b-9da0-d951f5ab919a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466289} {:answer/id #uuid "1803bd10-5f24-5896-8105-fbd58c0288ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466290}] :answer-field/correct {:answer/id #uuid "ecadbcf1-48ad-521b-9da0-d951f5ab919a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466289} :answer-field/id #uuid "3273f403-4f50-5518-ab19-640d36d78393" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466988}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e125563-3523-5218-87f9-08cecc055fc9" :question/math-academy-id "q-335020" :question/problem "Suppose $f(x)=2{x}^{4}+5{x}^{2}+10.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $f=O({x}^{5})$ as $x\\to \\infty $\n- **II.** $f=O({x}^{2})$ as $x\\to \\infty $\n- **III.** $f=O(1)$ as $x\\to \\infty $" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a.\n$$\n\nTo do this, we can examine the limit\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}.\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the polynomial\n\n$$\nf(x)=2{x}^{4}+5{x}^{2}+10.\n$$\n\nNow, let us analyze each statement in turn.\n\n- Statement I is true. Let $g(x)={x}^{5}.$ Then,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{2{x}^{4}+5{x}^{2}+10}{{x}^{5}} \\\\  & ={lim}_{x\\to \\infty }(\\frac{2}{x}+\\frac{5}{{x}^{3}}+\\frac{10}{{x}^{5}}) \\\\  & =0.\\end{aligned}\n$$\n\nHence, $f=O({x}^{5})$ as $x\\to \\infty .$\n\n- Statement II is false. Let $g(x)={x}^{2}.$ Then,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{2{x}^{4}+5{x}^{2}+10}{{x}^{2}} \\\\  & ={lim}_{x\\to \\infty }(2{x}^{2}+5+\\frac{10}{{x}^{2}}) \\\\  & =\\infty .\\end{aligned}\n$$\n\nHence, $f\\ne O({x}^{2})$ as $x\\to \\infty .$\n\n- Statement III is true. Let $g(x)=1.$ Then,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{2{x}^{4}+5{x}^{2}+10}{1} \\\\  & ={lim}_{x\\to \\infty }(2{x}^{4}+5{x}^{2}+10) \\\\  & =\\infty .\\end{aligned}\n$$\n\nHence, $f\\ne O(1)$ as $x\\to \\infty .$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186362976 :knowledge-point/_questions [{:db/id #edb/ref 17592186166859 :knowledge-point/id #uuid "fba5f68e-15da-5804-b6d9-d72ce6acae59" :knowledge-point/title "Identifying an Equation That Generates a Slope Field by Identifying Asymptotic Behavior"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c69f5100-ae5e-5d0b-a4e2-2b4e296f1692" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468912} {:answer/id #uuid "1d9a4e18-e2aa-5215-8483-ad1503727431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468913}] :answer-field/correct {:answer/id #uuid "1d9a4e18-e2aa-5215-8483-ad1503727431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468913} :answer-field/id #uuid "a407c0f1-4ac9-5951-acec-5ce5128ad46d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470068} {:answer-field/choices [{:answer/id #uuid "67c39275-0d40-5339-aeb1-f2563bb4e87f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468914} {:answer/id #uuid "4b05d876-a276-5668-a2de-f0cbeb627d6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468915}] :answer-field/correct {:answer/id #uuid "67c39275-0d40-5339-aeb1-f2563bb4e87f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468914} :answer-field/id #uuid "80ec1d2c-9883-500d-a634-079999b4e224" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470069} {:answer-field/choices [{:answer/id #uuid "6713e510-0e8d-5620-ac28-f28b687c4f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468916} {:answer/id #uuid "8e8c48b0-f144-5f90-912f-56f40874ae90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468917}] :answer-field/correct {:answer/id #uuid "6713e510-0e8d-5620-ac28-f28b687c4f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468916} :answer-field/id #uuid "b7c04d0d-05ca-5591-b260-dd6ea338584a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1bc4fffb-9fca-5d90-ae58-a105216385f3" :question/math-academy-id "q-120187" :question/problem "![](images/da/da8d6b73685dbd2db82ad6bdaa528f316fb7819ba3f99f226f0ad9127d3a5609.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-\\frac{1}{y}$\n- ${y}^{′}=\\frac{2}{{y}^{2}}$\n- ${y}^{′}=\\frac{1}{y+1}$\n\nSelect all that apply." :question/worked-solution "![](images/9b/9b6c8c113f59cc006f26e336b85abde6337a3af2a9f5d6dccc001eee636991ac.png)\n\nNotice the following properties of the given slope field:\n\n- The slopes of the slope field become vertical as $y\\to 0.$\n\n- The slopes of the slope field become horizontal as $y\\to \\pm \\infty .$\n\n- The slopes of the slope field are positive for $y<0$ and negative for $y>0.$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=-\\frac{1}{y}$ gives the required behavior. Notice that ${y}^{′}\\to 0$ as $y\\to \\pm \\infty ,$ and ${y}^{′}\\to \\infty $ as $y\\to 0.$ Also, the right-hand side of this equation is positive for $y<0$ and negative for $y>0.$\n\n- The equation ${y}^{′}=\\frac{2}{{y}^{2}}$ does *not* give the required behavior. The slopes of the slope field for this differential equation are positive for $y>0.$\n\n- The equation ${y}^{′}=\\frac{1}{y+1}$ does *not* give the required behavior. Notice that\n\n$$\n\\frac{y}{y+1}\\to 0\\,\\text{as}\\,y\\to 0.\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become vertical as $y\\to 0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186373132 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de1b2908-d140-5d0a-8262-c958d76bfa4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471471} {:answer/id #uuid "f456143a-b430-5e18-95eb-88219103f545" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471472}] :answer-field/correct {:answer/id #uuid "de1b2908-d140-5d0a-8262-c958d76bfa4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471471} :answer-field/id #uuid "06e697f7-446e-5fcc-ae8a-db378503de70" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472241} {:answer-field/choices [{:answer/id #uuid "55e41eb5-2115-5b1f-9bbb-e67f510d8e1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471473} {:answer/id #uuid "bf770033-4a57-5465-a9ee-d6d68d54b733" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471474}] :answer-field/correct {:answer/id #uuid "bf770033-4a57-5465-a9ee-d6d68d54b733" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471474} :answer-field/id #uuid "83576e31-5a8a-5315-8054-127553d4c6a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472242} {:answer-field/choices [{:answer/id #uuid "ad5d90de-a61d-5e9f-a889-d499427c60be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471475} {:answer/id #uuid "9f5c3a1e-f107-5159-ae8f-6ce7a0d2da41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471476}] :answer-field/correct {:answer/id #uuid "ad5d90de-a61d-5e9f-a889-d499427c60be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471475} :answer-field/id #uuid "5771a531-83c1-5b90-a459-0ec86b28bfd9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472243}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c853fbcf-5be0-5101-8f2a-558cbd4a782f" :question/math-academy-id "q-71402" :question/problem "The level curves of the function $f(x,y)=9x+3y-4$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=0$ gives an ellipse\n- **II.** $c=-4$ gives a line\n- **III.** $c=5$ gives a hyperbola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}9x+3y-4 & =c \\\\ 3y & =-9x+c+4 \\\\ y & =-3x+\\frac{c+4}{9}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ then the level curve is $y=-3x+\\frac{4}{9},$ which is not an ellipse.\n\n- If $c=-4$ then the level curve is $y=-3x,$ which is a line.\n\n- If $c=5$ then the level curve is $y=-3x+3,$ which is not a hyperbola.\n\nSo, only statement II is true."}] [{:db/id #edb/ref 17592186382964 :knowledge-point/_questions [{:db/id #edb/ref 17592186172016 :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59c2108e-96b3-5d6e-b962-726f73a1c21a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470907} {:answer/id #uuid "29a4d37b-cc9d-5abd-be6e-cfa2b43602c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470908}] :answer-field/correct {:answer/id #uuid "29a4d37b-cc9d-5abd-be6e-cfa2b43602c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470908} :answer-field/id #uuid "abd7be65-6a56-5d33-8320-4a5183336838" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471959} {:answer-field/choices [{:answer/id #uuid "abb4d5de-82bb-5735-b761-cfde599aa37d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470909} {:answer/id #uuid "3ed146ce-9654-5b05-8813-205e6efe5487" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470910}] :answer-field/correct {:answer/id #uuid "abb4d5de-82bb-5735-b761-cfde599aa37d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470909} :answer-field/id #uuid "1c7baf85-0e15-56af-8e13-67a4b94d7bb9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471960} {:answer-field/choices [{:answer/id #uuid "f62e0438-6fb4-597d-b819-130688cdb78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470911} {:answer/id #uuid "634a9e82-263e-5ffd-abd8-8a03e7ee5d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470912}] :answer-field/correct {:answer/id #uuid "f62e0438-6fb4-597d-b819-130688cdb78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470911} :answer-field/id #uuid "0aa2ffea-ff43-5b1d-90a1-15f52b173f02" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471961}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9198e7bb-f6e2-569d-9a58-c321fc238e98" :question/math-academy-id "q-120290" :question/problem "![](images/32/32fefe70890d179803a847fc597349948703176d1561a8c840e845fa7a06a872.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=\\frac{y+2}{x-1}$\n- ${y}^{′}=(x-1)(y-2)$\n- ${y}^{′}=\\frac{y-2}{x}$\n\nSelect all that apply." :question/worked-solution "![](images/a1/a18f69bf5b2cb6b2984722f851e1eda017e48863517da7ee65597d7c25c46379.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- For $x\\ne 1,$ the slopes of the slope field become horizontal at $y=-2.$\n\n- For $y\\ne -2,$ the slopes of the slope field become vertical as $x\\to 1.$\n\nWith that in mind, let's consider each equation.\n\n- Equation I gives the required behavior. For $x\\ne 1,$ the right-hand side of ${y}^{′}=\\frac{y+2}{x-1}$ evaluates to zero on $y=-2,$ and for $y\\ne -2,$\n\n$$\n|{y}^{′}|=|\\frac{y+2}{x-1}|\\to \\infty \\,\\text{as}\\,x\\to 1.\n$$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=(x-1)(y-2)$ does not evaluate to zero on $y=-2$ (the value depends on $x$).\n\n- Equation III does *not* give the required behavior. The right-hand side of ${y}^{′}=\\frac{y-2}{x}$ evaluates to zero on $y=-2,$ but \n\n$$\n|{y}^{′}|=|\\frac{y-2}{x}|\\to |y-2|\\,\\text{as}\\,x\\to 1.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186400331 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef111d9f-980c-5b03-9930-80f18435b245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472580} {:answer/id #uuid "a6862f2d-2762-5b0e-8f3a-1253e37655d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472581}] :answer-field/correct {:answer/id #uuid "a6862f2d-2762-5b0e-8f3a-1253e37655d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472581} :answer-field/id #uuid "5faeea23-e6b1-5b91-87f6-7b0a4fef3dcc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473685} {:answer-field/choices [{:answer/id #uuid "6aefd83a-6b4c-56c7-b747-345c373d9b14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472582} {:answer/id #uuid "24c81c04-8905-5c94-ac90-a70db567f3a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472583}] :answer-field/correct {:answer/id #uuid "24c81c04-8905-5c94-ac90-a70db567f3a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472583} :answer-field/id #uuid "e2bd5816-6d9d-5da2-8f3f-64ef8acdb893" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473686} {:answer-field/choices [{:answer/id #uuid "e6738bb8-1870-5396-9a90-bba160d497e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472584} {:answer/id #uuid "e7fc74ba-8f62-5436-9d2e-3c858d0578e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472585}] :answer-field/correct {:answer/id #uuid "e6738bb8-1870-5396-9a90-bba160d497e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472584} :answer-field/id #uuid "7584f499-906d-554c-842b-3985b246d9ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2d9404d-2d42-56c6-b91b-5351ccec57cf" :question/math-academy-id "q-128139" :question/problem "Which of the following completes the statement so that it is true:\n\n*If a $2\\times 2$-matrix $A$ is invertible, then $\\text{__________}$ . *\n\nI. $det(A)\\ne 0$\nII. $Ax=b$ has exactly one solution\nIII. $Ax=0$ has infinitely many solutions\n\nSelect all that apply." :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nNow, since the first part of the invertible matrix theorem is true ($A$ is invertible), all the other parts of the theorem are true too. Therefore, according to the theorem, only options I and III give us true statements:\n\n- *If $A$ is invertible, then $det(A)\\ne 0.$* $\\,✓$\n\n- *If $A$ is invertible, then $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$* $\\,✓$"}] [{:db/id #edb/ref 17592186412805 :knowledge-point/_questions [{:db/id #edb/ref 17592186166899 :knowledge-point/id #uuid "95de2c3e-5810-5aa0-a1d0-b98b012572d4" :knowledge-point/title "Applying the Linearity Principle to the Solutions of a Homogeneous System of ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c1c0b90-23e9-5b83-a708-3ea2a44a1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473040} {:answer/id #uuid "d96841dd-b0ce-57d2-8366-ed50689beb53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473041}] :answer-field/correct {:answer/id #uuid "2c1c0b90-23e9-5b83-a708-3ea2a44a1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473040} :answer-field/id #uuid "334c6ac2-2b02-5e0f-a88a-b19789c7086c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473915} {:answer-field/choices [{:answer/id #uuid "43066d0d-a047-5a30-8822-f5d690da8c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473042} {:answer/id #uuid "12848657-20bc-5e4e-8323-c54bfc0aa80a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473043}] :answer-field/correct {:answer/id #uuid "43066d0d-a047-5a30-8822-f5d690da8c86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473042} :answer-field/id #uuid "34af04fe-4273-5909-afb6-13e9d8b36c79" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473916} {:answer-field/choices [{:answer/id #uuid "216b9e19-7285-56cb-8603-99b3f8d13d7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186473044} {:answer/id #uuid "a0db2386-3a66-5f9c-a3fd-5640d25f6a54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473045}] :answer-field/correct {:answer/id #uuid "a0db2386-3a66-5f9c-a3fd-5640d25f6a54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186473045} :answer-field/id #uuid "381905b6-4e83-545a-8560-cb908ea74f55" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473917}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71a6807f-51a3-5e94-a65a-0087aa5dc119" :question/math-academy-id "q-330333" :question/problem "Suppose ${x}_{1}(t)$ and ${x}_{2}(t)$ are both solutions of the homogeneous system\n${x}^{′}(t)=A\\text{ }x(t).$\nWhich of the following is **always** a solution of the same system?\n\nSelect all that apply.\n\n- **I.** $x(t)={x}_{1}(t)\\times {x}_{2}(t)$\n\n- **II.** $x(t)=\\operatorname{sin}⁡(t)\\cdot {x}_{2}(t)$\n\n- **III.** $x(t)=-3\\cdot {x}_{2}(t)$" :question/worked-solution "The *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t)$ and ${x}_{2}(t)$ are solutions to a homogeneous linear system, then for any constants ${c}_{1}$ and ${c}_{2},$ the linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)\n$$\n\nis also a solution of the system. \n\nWith that in mind, let's examine the given expressions.\n\n- Option I might be *not* a solution to the system since it's not a scalar multiple of any of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$\n\n- Option II might be *not* a solution to the system since it's not a scalar multiple of any of the solutions ${x}_{1}(t)$ and ${x}_{2}(t).$ Notice that the multiplier is not a constant.\n\n- Option III is a solution to the system. Indeed, notice that\n\n$$\n-3\\cdot {x}_{2}(t)\n$$\n\nis a linear combination of the solutions ${x}_{1}(t)$ and ${x}_{2}(t)$ with constant multiplies ${c}_{1}=0$ and ${c}_{2}=-3,$ respectively.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186426975 :knowledge-point/_questions [{:db/id #edb/ref 17592186054809 :knowledge-point/id #uuid "7fcec0d8-ca03-5446-a42f-65d0ccddd584" :knowledge-point/title "Identifying the Quadrant of a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a8e17a0-daa3-5ce7-9699-c81f32093d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474502} {:answer/id #uuid "dcdf29b7-66c8-593e-b845-6514eb9e9b6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474503}] :answer-field/correct {:answer/id #uuid "6a8e17a0-daa3-5ce7-9699-c81f32093d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474502} :answer-field/id #uuid "7fffa765-2a81-5787-b94f-54d3ea9dd2fd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475177} {:answer-field/choices [{:answer/id #uuid "e5ee7af1-568a-504f-a7b5-3dc1b7f3487c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474504} {:answer/id #uuid "1aa59f6c-a796-5468-b924-eb34bdd4593e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474505}] :answer-field/correct {:answer/id #uuid "e5ee7af1-568a-504f-a7b5-3dc1b7f3487c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474504} :answer-field/id #uuid "115d02b4-a68c-542d-a036-9f4eff58e7c2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475178} {:answer-field/choices [{:answer/id #uuid "14c90982-a31c-5706-b5d8-903cc7b07e8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474506} {:answer/id #uuid "db66a6db-2f22-5d97-81b6-da2ae8fa5104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474507}] :answer-field/correct {:answer/id #uuid "db66a6db-2f22-5d97-81b6-da2ae8fa5104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474507} :answer-field/id #uuid "34975eac-6fea-5e8a-8221-0a3c35d408d7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475179}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9298397c-357d-5783-87f8-a9a66297312a" :question/math-academy-id "q-169184" :question/problem "![](images/92/928b00ea1ac59e758c4bc9e224d2d27e1c2149e31d0c5c3ab7673ee9abeae208.png)\n\nWhich of the following is true regarding the point $S?$\n\nI. It is in the fourth quadrant\n\nII. Its $x$-coordinate is $1$\n\nIII. Its $y$-coordinate is $-3$\n\nSelect all that apply." :question/worked-solution "The point $S$ is in the third quadrant, so statement I is false.\n\nTo find the coordinates of the point $S,$ we start at the origin, move $1$ units *left*, and then $3$ units *down*. \n\n![](images/f1/f150eac73755dc5f39b499b6ca0ba12624e4c27dd79e7207e11f6c88d04b596d.png)\n\nThe coordinates of $P$ are $(-1,-3).$ Hence, statement II is false and statement III is true."}]}
