/ident :question.difficulty/moderate} :question/id #uuid "8dcf1b32-9570-5d48-ae75-da4a4e24441c" :question/math-academy-id "q-42437" :question/problem "Which of the following values lies in the domain of $y=\\operatorname{arctan}⁡x?$\n- **I.** $\\pi $\n- **II.** $-\\pi $\n- **III.** $\\frac{\\pi }{2}$\n\nSelect all that apply." :question/worked-solution "Let's recall the graph of $y=\\operatorname{arctan}⁡x.$\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)\n\nNote that:\n\n- The function is defined for all real numbers.\n\nTherefore, all the given values are in the domain of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186111362 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08aa76b4-af00-5cf5-86f0-d9111d90209b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460137} {:answer/id #uuid "48152d24-ed22-5738-bb6f-a224e33b9cb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460138}] :answer-field/correct {:answer/id #uuid "08aa76b4-af00-5cf5-86f0-d9111d90209b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460137} :answer-field/id #uuid "ceee4737-1a31-555e-a291-33a7162e80e9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460935} {:answer-field/choices [{:answer/id #uuid "e2def92a-e98b-544b-8a7e-81a30a765f6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460139} {:answer/id #uuid "3cae6124-4500-57bb-8c62-a8be4a3fe484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460140}] :answer-field/correct {:answer/id #uuid "3cae6124-4500-57bb-8c62-a8be4a3fe484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460140} :answer-field/id #uuid "d9ad9f45-e5cf-50e8-b7c8-fa2cf2043205" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460936} {:answer-field/choices [{:answer/id #uuid "63bbc76f-c0c6-5b17-a51d-501f38311609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460141} {:answer/id #uuid "76297125-be34-545f-a9ff-ebed6caa4894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460142}] :answer-field/correct {:answer/id #uuid "63bbc76f-c0c6-5b17-a51d-501f38311609" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460141} :answer-field/id #uuid "749729d4-1969-57b1-9375-a3cfffb6e59e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460937}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00b3cd73-63d0-506c-b47a-e48c2b7ba801" :question/math-academy-id "q-65830" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n- **I.** $(\\frac{\\pi }{4},1)$\n- **II.** $(1,\\frac{\\pi }{4})$\n- **III.** $(\\sqrt{3},\\frac{4\\pi }{3})$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\pi }{4},1).$ We note the following:\n\n- The point $(1,\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},1)$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(1,\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(1,\\frac{\\pi }{4})$ does lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(\\sqrt{3},\\frac{4\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{4\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{4\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(\\sqrt{3},\\frac{4\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186115704 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8608721d-bb96-5e7c-b558-dd2b50af6f28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186459763} {:answer/id #uuid "662ba243-e0ac-5f30-99c4-5d5a0e71086d" :answer/t