/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460148} :answer-field/id #uuid "a6bcfd7d-9311-5cec-a044-975a0cf459e8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460940}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c319e35c-f6f5-5224-8a19-cffd75e260ac" :question/math-academy-id "q-66002" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n- **I.** $\\operatorname{csc}⁡x=3$\n- **II.** $\\operatorname{csc}⁡x=1$\n- **III.** $\\operatorname{csc}⁡x=\\frac{1}{5}$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186115955 :knowledge-point/_questions [{:db/id #edb/ref 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38974865-c7f9-5ffe-94d5-91b4e04ff444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460203} {:answer/id #uuid "c331e806-f9c0-5251-9556-a1753a1a204a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460204}] :answer-field/correct {:answer/id #uuid "38974865-c7f9-5ffe-94d5-91b4e04ff444" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460203} :answer-field/id #uuid "b09480df-6302-5589-833b-bf1d13779ebe" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460968} {:answer-field/choices [{:answer/id #uuid "737acf5f-5cf1-5011-a7e5-0023a1a48528" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460205} {:answer/id #uuid "6a401068-ebc7-5c00-9082-012e97f6e1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460206}] :answer-field/correct {:answer/id #uuid "6a401068-ebc7-5c00-9082-012e97f6e1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460206} :answer-field/id #uuid "263429d0-3ddb-5c95-8edf-09fb879b803a" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460969} {:answer-field/choices [{:answer/id #uuid "4512e449-e6ed-52cc-b346-7238689f5f07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460207} {:answer/id #uuid "6d4a0baf-e0b9-5748-8c91-d7dd4ff84c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460208}] :answer-field/correct {:answer/id #uuid "4512e449-e6ed-52cc-b346-7238689f5f07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460207} :answer-field/id #uuid "154db06d-99a7-548d-9b02-b144426bc535" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460970}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf16f494-c482-58f3-9d08-1de06dd3fe97" :question/math-academy-id "q-78426" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{1}:={R}_{1}+(-1){R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=[\\begin{aligned}1 & 1 & 0 \\\\ 4 & 1 & 1 \\\\ 1 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}3 & 1 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}3 & 1 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\nSelect all that apply." :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 1 & 0 \\\\ 4 & 1 & 1 \\\\ 1 & 0 & 0\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}-3 & 0 & -1 \\\\ 4 & 1 & 1 \\\\ 1 & 0 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 0 & -1 \\\\ 10 & 1 & 3 \\\\ 1 & 0 & 0\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}3 & 1 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}3 & 1 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 & 1 \\\\ 1 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 & 1 \\\\ -3 & 1 & -2 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186120146 :knowledge-point/_questions [{:db/id #edb/ref 17592186119927 :knowledge-point/id #uuid "83796fe8-f045-5dbc-94d1-6d6e031f3ed8" :knowledge-point/title "Determining Whether a Line Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24252954-787b-5287-ada3-c3c084627cbc" :answer/