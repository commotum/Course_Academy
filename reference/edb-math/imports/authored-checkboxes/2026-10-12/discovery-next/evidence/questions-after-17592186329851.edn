r/value "false" :db/id #edb/ref 17592186467754} :answer-field/id #uuid "3426a684-b024-5baa-8526-3322ba99d6fd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468598} {:answer-field/choices [{:answer/id #uuid "d73755a9-64c2-5f37-ae61-9ec0e51a1fdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467756} {:answer/id #uuid "4243e1e1-006d-51f1-85b7-ab436fce1d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467757}] :answer-field/correct {:answer/id #uuid "4243e1e1-006d-51f1-85b7-ab436fce1d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467757} :answer-field/id #uuid "53e70ba6-6ea7-557f-b8f1-3d7ee5384d35" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "170337cb-28d4-5a79-b92e-2d074da465f2" :question/math-academy-id "q-66007" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n- **I.** $\\operatorname{csc}⁡x-1=2\\operatorname{csc}⁡x$\n- **II.** $\\operatorname{csc}⁡x=11\\operatorname{csc}⁡x-10$\n- **III.** $3\\operatorname{csc}⁡x=1-\\operatorname{csc}⁡x$\n\nSelect all that apply." :question/worked-solution "We first simplify the given equations, and get\n\n- $\\operatorname{csc}⁡x=-1$\n- $\\operatorname{csc}⁡x=1$\n- $\\operatorname{csc}⁡x=\\frac{1}{4}$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186335872 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a46e8fd0-fbcf-5b4c-b8ad-8bcc69ff682f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467758} {:answer/id #uuid "26096586-1eea-5b2c-9e57-d881326f474b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467759}] :answer-field/correct {:answer/id #uuid "a46e8fd0-fbcf-5b4c-b8ad-8bcc69ff682f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467758} :answer-field/id #uuid "7600bd10-f522-5ed3-a8d4-26dad56f5550" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468600} {:answer-field/choices [{:answer/id #uuid "124e498e-cec0-5fce-b26d-be553da17ab1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467760} {:answer/id #uuid "b8200937-bf46-533f-b494-362f51356ef5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467761}] :answer-field/correct {:answer/id #uuid "124e498e-cec0-5fce-b26d-be553da17ab1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467760} :answer-field/id #uuid "da864c5f-e9e4-56ce-bced-1eb63271a8b7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468601} {:answer-field/choices [{:answer/id #uuid "f9cafb59-0b24-588f-9bcb-424a9f69dc54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467762} {:answer/id #uuid "6c0fc1a7-5a2a-527a-85ed-2cc301299690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467763}] :answer-field/correct {:answer/id #uuid "6c0fc1a7-5a2a-527a-85ed-2cc301299690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467763} :answer-field/id #uuid "ce948b10-c87c-53ef-a62d-acb627747432" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "02825ca8-1217-5576-a207-9808ead9dee4" :question/math-academy-id "q-66012" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n- **I.** $\\operatorname{sec}⁡x=1$\n- **II.** $\\operatorname{sec}⁡x=5$\n- **III.** $\\operatorname{sec}⁡x=-\\frac{1}{4}$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186335966 :knowledge-point/_questions [{:db/id #edb/ref 17592186087695 :knowledge-point/id #uuid "ddb59990-7419-585f-aa1b-901d59c8cfc1" :knowledge-point/title "Identifying a Zero Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092e6e39-62e1-5a0d-a93c-5ac81888a407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467764} {:answer/id #uuid "5e95dcb3-8237-54f7-a277-58c6618eb31c" :an