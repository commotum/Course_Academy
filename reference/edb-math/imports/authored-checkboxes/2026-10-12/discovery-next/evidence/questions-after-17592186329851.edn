 Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a79f3f27-1797-58a4-9baf-70ceb8867988" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467992} {:answer/id #uuid "931c2a7e-5632-5619-ad35-e28dd59f405b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467993}] :answer-field/correct {:answer/id #uuid "931c2a7e-5632-5619-ad35-e28dd59f405b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467993} :answer-field/id #uuid "b443bc49-a1f1-5807-be6d-60f1ec69821c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468717} {:answer-field/choices [{:answer/id #uuid "5665e446-c146-550d-b65b-06a07f978863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467994} {:answer/id #uuid "2bf8e4c0-4435-5458-9ed5-3fa7fab96e98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467995}] :answer-field/correct {:answer/id #uuid "5665e446-c146-550d-b65b-06a07f978863" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467994} :answer-field/id #uuid "db4528d9-b6df-5a35-aa36-c23f2aa60e3f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468718} {:answer-field/choices [{:answer/id #uuid "d5fccd59-f84e-5cea-ac1d-9616e270d1a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467996} {:answer/id #uuid "eab7a7c3-30eb-5cd9-ba7c-0bcf3740bbb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467997}] :answer-field/correct {:answer/id #uuid "eab7a7c3-30eb-5cd9-ba7c-0bcf3740bbb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467997} :answer-field/id #uuid "a3561402-4086-52ee-8262-e4d7f3ab1c5d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7ec702-6570-50d7-8199-a59c190c3e40" :question/math-academy-id "q-73252" :question/problem "![](images/1f/1f2d8b9faac6c300b41902cea5065bf8bafb02c137232ee79779a4dc3ff67f33.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=-1$\n\nII. The function is differentiable at $x=1$\n\nIII. The function is continuous at $x=2$\n\nSelect all that apply." :question/worked-solution "- Statement I is true. The graph can be drawn in a neighborhood of $x=-1$ without taking the pencil off the paper.\n\n- Statement II is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$ So, it can't be differentiable there.\n\n- Statement III is true. The graph can be drawn in a neighborhood of $x=2$ without taking the pencil off the paper.\n\nTherefore, only statements I and III  are true."}] [{:db/id #edb/ref 17592186341975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee362845-daee-5897-bb75-a961373d980a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467998} {:answer/id #uuid "c22a