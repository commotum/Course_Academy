usp at this point and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341928 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5c37c5-570d-5441-8e4b-5c969f7aae16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467986} {:answer/id #uuid "3f44968a-7e7f-5529-bb8e-055b55185a66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467987}] :answer-field/correct {:answer/id #uuid "2f5c37c5-570d-5441-8e4b-5c969f7aae16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467986} :answer-field/id #uuid "aa688bb3-f88c-504d-b8e2-9e62938244b9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468714} {:answer-field/choices [{:answer/id #uuid "cd45cad1-5bbc-5a54-813a-2150c50e608c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467988} {:answer/id #uuid "3626cf57-a93b-5d4f-b2f3-f442b51235b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467989}] :answer-field/correct {:answer/id #uuid "3626cf57-a93b-5d4f-b2f3-f442b51235b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467989} :answer-field/id #uuid "bedec394-1b8f-5161-b4fe-464bf879a7cc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468715} 