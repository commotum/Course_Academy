ref 17592186468117}] :answer-field/correct {:answer/id #uuid "e6d9a215-990f-586e-ad1c-3e2aebcf2b97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468116} :answer-field/id #uuid "a971bb90-3bc7-54d6-93ec-562b99c29957" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34143660-ecfa-5585-b65e-76b215171706" :question/math-academy-id "q-75123" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n- **I.** $C=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$\n- **II.** $C=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]$\n- **III.** $C=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$\n\nSelect all that apply." :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]\\,✓\n$$\n\n- The second product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has a non-zero entry above the main diagonal. \n\n$$\nC=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]\\,\\times \n$$\n\n- The third product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$ on the main diagonal.\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186345092 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85e64603-bb6e-5b0f-a72d-80a8ccc3450d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468118} {:answer/id #uuid "bb5f4f63-4be8-5a5b-b8cd-fa7559af4fa1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468119}] :answer-field/correct {:answer/id #uuid "85e64603-bb6e-5b0f-a72d-80a8ccc3450d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468118} :answer-field/id #uuid "c1db1d1e-60e6-5396-8aa1-ee91b508535f" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468780} {:answer-field/choices [{:answer/id #uuid "e2a0153d-23de-5108-888f-f2b222f9131f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468120} {:answer/id #uuid "9cd47bee-3079-5cc3-a48e-29d195deb027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468121}] :answer-field/correct {:answer/id #uu