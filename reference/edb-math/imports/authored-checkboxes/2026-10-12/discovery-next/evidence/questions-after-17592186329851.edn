c-8eda-f01b3b4a0dcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467841}] :answer-field/correct {:answer/id #uuid "9c5a5569-d89a-528c-8eda-f01b3b4a0dcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467841} :answer-field/id #uuid "e8f8893a-0805-523d-a0fc-3f3104e0d117" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468641}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d44ff842-4620-550a-bab6-87cb0a1ac002" :question/math-academy-id "q-71179" :question/problem "Given that \n\n$$\n\\begin{aligned}g(x) & ={\\begin{aligned}3x, & x\\ne 4 \\\\ 13, & x=4,\\end{aligned}\\end{aligned}\n$$\n\nwhich of the following statements are true?\n- **I.** ${lim}_{x\\to {4}^{+}}g(x)={lim}_{x\\to {4}^{-}}g(x)$\n- **II.** ${lim}_{x\\to 4}g(x)=g(4)$\n- **III.** $g(x)$ has a removable discontinuity at $x=4$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's check our continuity conditions:\n\n- $g(4)=13$ exists$\\,\\,✓$\n\n- The left and right-sided limits are\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{4}^{-}}g(x) & ={lim}_{x\\to \\,{4}^{-}}3x=12, \\\\ {lim}_{x\\to \\,{4}^{+}}g(x) & ={lim}_{x\\to \\,{4}^{+}}3x=12.\\end{aligned}\n$$\n\nSince the left and right-sided limits are equal, we conclude that statement I is true and\n\n$$\n{lim}_{x\\to 4}g(x)=12.\\,\\,✓\n$$\n\n- The value of the limit is ${lim}_{x\\to 4}g(x)=12,$ while the value of the function is $g(4)=13.$ So, statement II is false and\n\n$$\n{lim}_{x\\to 4}g(x)\\ne g(4)\\,\\,\\times \n$$\n\nSince the third condition failed, the function has a removable discontinuity at $x=4,$ and statement III is true.\n\nIn conclusion, only statements I and III are true."}] [{:db/id #edb/ref 17592186338935 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97b5337a-3e06-5fca-8dee-9ccb9bb3e791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467842} {:answer/id #uuid "ca10f725-532e-52f8-b216-80660df1aff0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467843}] :answer-field/correct {:answer/id #uuid "97b5337a-3e06-5fca-8dee-9ccb9bb3e791" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467842} :answer-field/id #uuid "6f26b394-09a9-58cd-8127-d23fbca6af8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468642} {:answer-field/choices [{:answer/id #uuid "572c0f09-8cda-57e4-84ee-e9bf11b0969a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467844} {:answer/id #uuid "3debfd10-6252-58a8-80d0-0fe4ad6b3d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467845}] :answer-field/correct {:answer/id #uuid "3debfd10-6252-58a8-80d0-0fe4ad6b3d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467845} :answer-field/id #uuid "a4b044d1-ec5c-5118-ba8c-99f2a5e9c147" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468643} {:answer-field/choices [{:answer/id #uuid "d92d5ae0-bdbf-5aac-a192-d4634abd4820" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467846} {:answer/id #uuid "80aced54-71e3-53cc-8d38-ae55e211374c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467847}] :answer-field/correct {:answer/id #uuid "80aced54-71e3-53cc-8d38-ae55e211374c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467847} :answer-field/id #uuid "7551102b-2721-527c-a9e6-1c6948d2bf34" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468644}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e04ff7ee-ed94-5861-b7e8-a3f79254490c" :question/math-academy-id "q-71391" :question/problem "For the function $f(x,y)=\\frac{2{x}^{2}+3{y}^{2}-4}{{y}^{2}}$, clear the denominator in $f(x,y)=c$ and classify the resulting conic equation in the entire $xy$-plane, including points excluded from the function's domain. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $c=3$ gives a hyperbola\n- **II.** $c=0$ gives an ellipse\n- **III.** $c=1$ gives a circle" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}+3{y}^{2}-4}{{y}^{2}} & =c \\\\ 2{x}^{2}+3{y}^{2}-4 & =c{y}^{2} \\\\ 2{x}^{2}+(3-c){y}^{2} & =4\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=3$ then the level curves are $x=\\pm \\sqrt{2},$ which consists of two vertical lines.\n\n- If $c=0$ then the level curve is $2{x}^{2}+3{y}^{2}=4,$ which is an ellipse.\n\n- If $c=1$ then the level curve is ${x}^{2}+{y}^{2}=2,$ which is a circle.\n\nSo, only statements II and III are true."}] [{:db/id #edb/ref 17592186338937 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] 