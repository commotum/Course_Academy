6-ff2d28af2e62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463950} :answer-field/id #uuid "9301f225-85e3-5553-ba4b-22535d83581f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464909}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d36ff0c1-6dbb-5187-9838-81e30505ca16" :question/math-academy-id "q-131020" :question/problem "Given that ${y}_{1}(x)=\\operatorname{sin}⁡3x$ is a solution to the equation ${y}^{″}+9y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)=-3\\operatorname{sin}⁡3x$\n- **II.** $y(x)=\\frac{1}{3}\\operatorname{sin}⁡3x$\n- **III.** $y(x)={x}^{2}\\operatorname{sin}⁡3x$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=-3\\operatorname{sin}⁡3x$ is a solution of the equation by the superposition principle. In this case, $c=-3.$\n\n- The function $y(x)=\\frac{1}{3}\\operatorname{sin}⁡3x$ is a solution of the equation by the superposition principle. In this case, $c=\\frac{1}{3}.$\n\n- The function $y(x)={x}^{2}\\operatorname{sin}⁡3x$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186266039 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d468c753-db8b-58e4-87c3-df3ac00a8458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463952} {:answer/id #uuid "f95137a9-927e-5b87-8152-5572d7b72ed3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463953}] :answer-field/correct {:answer/id #uuid "f95137a9-927e-5b87-8152-5572d7b72ed3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463953} :answer-field/id #uuid "f174bfe1-f553-5267-bcd8-ba2baea7f21b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464910} {:answer-field/choices [{:answer/id #uuid "17459f1a-8c7e-5300-a88d-ab46293a02f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463954} {:answer/id #uuid "30ca409d-f9ad-5813-a9e3-c7cc11b108a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463955}] :answer-field/correct {:answer/id #uuid "17459f1a-8c7e-5300-a88d-ab46293a02f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463954} :answer-field/id #uuid "239cb443-f2fd-5fe0-bf08-925411d1f0db" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464911} {:answer-field/choices [{:answer/id #uuid "7202512b-f3b0-5c77-bd36-c9e8422bba02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463956} {:answer/id #uuid "25557e74-5aaf-5782-8d90-734f868585fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463957}] :answer-field/correct {:answer/id #uuid "7202512b-f3b0-5c77-bd36-c9e8422bba02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463956} :answer-field/id #uuid "3d77270c-5036-597e-844c-148993fff4a1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464912}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dfa49172-fd9a-5f39-9f7a-58af40e909ce" :question/math-academy-id "q-131022" :question/problem "Given that ${y}_{1}(x)={x}^{4}$ is a solution to the equation ${x}^{2}{y}^{″}-7x{y}^{′}+16y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)=-2{x}^{4}$\n- **II.** $y(x)={x}^{4}\\sqrt{x}$\n- **III.** $y(x)=\\frac{{x}^{4}}{{e}^{x}}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=-2{x}^{4}$ is a solution of the equation by the superposition principle. In this case, $c=-2.$\n\n- The function $y(x)={x}^{4}\\sqrt{x}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\n- The function $y(x)=\\frac{{x}^{4}}{{e}^{x}}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the quotient of a known solution and a non-constant function.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186266041 :knowledge-point/_questions [{:db/id #edb/ref 17592186152169 :knowledge-point/id #uuid "101e0c22-fbb4-5865-af5f-d669e2488d09" :knowledge-point/title "Identifying Solutions to Linear ODEs Using the Superposition Principle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f14b3700-b849-579c-8237-42f5738ae818" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463958} {:answer/id #uuid "4cd72fca-5ab9-5351-8970-be26fa6994f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463959}] :answer-field/correct {:answer/id #uuid "4cd72fca-5ab9-5351-8970-be26fa6994f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463959} :answer-field/id #uuid "4eaf6d1d-76e4-5aa5-9a3c-e8fe5c692963" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464913} {:answer-field/choices [{:answer/id #uuid "92b4a50d-43e1-5e28-9457-a4e61f16d918" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463960} {:answer/id #uuid "5e5762e5-dbcd-5e74-93f6-4a794c5ce077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463961}] :answer-field/correct {:answer/id #uuid "5e5762e5-dbcd-5e74-93f6-4a794c5ce077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463961} :answer-field/id #uuid "36cd8da3-3a96-5875-98a4-8d7339547ad3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464914} {:answer-field/choices [{:answer/id #uuid "7bfea326-4a9a-5f86-bd7d-d79f16288b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463962} {:answer/id #uuid "8dd86b8f-58db-594c-b0aa-a89dd46e4ab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463963}] :answer-field/correct {:answer/id #uuid "7bfea326-4a9a-5f86-bd7d-d79f16288b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463962} :answer-field/id #uuid "7fb16613-6593-5ae6-ac15-64bcf45109ac" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464915}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "55d7974d-e6ac-57d3-85a4-a96c054848c6" :question/math-academy-id "q-131036" :question/problem "Given that ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{-x}$ are solutions to the equation ${y}^{″}-y=0,$ which of the following must also be a solution to the equation?\n- **I.** $y(x)={e}^{x}+4{e}^{-x}$\n- **II.** $y(x)=5{e}^{-x}$\n- **III.** $y(x)=({e}^{-x}+1){e}^{x}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, and ${c}_{1}$ and ${c}_{2}$ are constants, then $y(x)={c}_{1}{y}_{1}(x)+{c}_{2}{y}_{2}(x)$ is also a solution to the equation.\n\nWe're given that ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)={e}^{-x}.$ Therefore, the following function is also a solution:\n\n$$\ny(x)={c}_{1}{e}^{x}+{c}_{2}{e}^{-x}\n$$\n\nLet's consider each option:\n\n- The function $y(x)={e}^{x}+4{e}^{-x}$ is a solution of the given equation. Here, ${c}_{1}=1,{c}_{2}=4.$\n\n- The function $y(x)=5{e}^{-x}$ is a solution of the given equation. Here, ${c}_{1}=0,{c}_{2}=5.$\n\n- The function $({e}^{-x}+1){e}^{x}=1+{e}^{x}$ is **not** a solution of the given equation because $1$ is not a solution."}] [{:db/id #edb/ref 17592186266042 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53a22dd3-a12d-5858-8abe-50ea411d89b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463964} {:answer/id #uuid "36046449-1599-5cbe-a388-6f9f7a5cb79c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463965}] :answer-field/correct {:answer/id #uuid "53a22dd3-a12d-5858-8abe-50ea411d89b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463964} :answer-field/id #uuid "d07414d7-38bb-5a41-a70a-cab1a7c6266e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464916} {:answer-field/choices [{:answer/id #uuid "6ef93042-d8eb-5786-ae85-d1a2674d5ca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463966} {:answer/id #uuid "7809c3f4-194e-508e-aa57-63f005ea71e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463967}] :answer-field/correct {:answer/id #uuid "7809c3f4-194e-508e-aa57-63f005ea71e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463967} :answer-field/id #uuid "b0621149-4a49-5264-943b-8b19e5114ba8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464917} {:answer-field/choices [{:answer/id #uuid "cead2490-5a8f-5617-b718-96a31861ea17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463968} {:answer/id #uuid "44cc7066-d7c7-5444-8303-dac86b7c407b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463969}] :answer-field/correct {:answer/id #uuid "cead2490-5a8f-5617-b718-96a31861ea17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463968} :answer-field/id #uuid "372a4dc1-c392-5350-a730-58b07fa01c7e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464918}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d91387a3-da34-5d28-af8d-36338cffabf0" :question/math-academy-id "q-131066" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}2, & x<0 \\\\ \\operatorname{tan}⁡x, & x\\ge 0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-\\frac{\\pi }{3},\\frac{\\pi }{3}]$\n\nII. $[\\frac{\\pi }{6},\\frac{\\pi }{3}]$\n\nIII. $[\\frac{\\pi }{3},\\frac{2\\pi }{3}]$\n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-\\frac{\\pi }{3},\\frac{\\pi }{3}].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}2=2, \\\\ {lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}\\operatorname{tan}⁡x=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-\\frac{\\pi }{3},\\frac{\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\n- Consider $[\\frac{\\pi }{6},\\frac{\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function $f(x)$ is continuous on the interval $[\\frac{\\pi }{6},\\frac{\\pi }{3}],$ and the extreme value theorem is applicable on this interval.\n\n- Consider $[\\frac{\\pi }{3},\\frac{2\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function is not defined at $x=\\frac{\\pi }{2}.$ Therefore, $f(x)$ is not continuous on the interval $[\\frac{\\pi }{3},\\frac{2\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186266043 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ead1ab53-2f38-562e-b56e-9a29a4a4568d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463970} {:answer/id #uuid "3665607f-b7d9-5123-b9f7-32fbfd2a28e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463971}] :answer-field/correct {:answer/id #uuid "ead1ab53-2f38-562e-b56e-9a29a4a4568d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463970} :answer-field/id #uuid "c5b9e58b-7eab-5359-b29e-a7937b659878" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464919} {:answer-field/choices [{:answer/id #uuid "5b0a6304-df8f-57bc-a2be-8e3c2fe89bdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463972} {:answer/id #uuid "818dbaff-1ecd-5434-8737-c9a