281750c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463516} :answer-field/id #uuid "ed491364-2b4d-5a4d-90e5-37c9242e76e2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfd2b36c-080f-5929-a5a6-dd070c8ce235" :question/math-academy-id "q-125652" :question/problem "Consider the scalar field $f(x,y)={5}^{-x-y}+\\sqrt{2}.$ Which of the following statements are true?\n- **I.** $∇f$ is conservative\n- **II.** ${∮}_{C}∇f\\cdot \\text{d}r\\ne 0$ for any closed path $C\\in {R}^{2}$\n- **III.** ${\\int }_{C}∇f\\cdot \\text{d}r=0$ for any piecewise linear path $C\\in {R}^{2}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "If $F$ is a conservative vector field on ${R}^{2},$ then the circulation $Γ=0$ for any *closed* path $C\\in {R}^{2},$ that is \n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r=0.\n$$\n\nWith that in mind, let's consider each statement in turn:\n\n- Statement I is true. The vector field $∇f$ is conservative by definition.\n\n- Statement II is false. The circulation $Γ=0$ for any closed path $C\\in {R}^{2}.$\n\n- Statement III is false. The result $Γ=0$ applies to closed curves only.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186259842 :knowledge-point/_questions [{:db/id #edb/ref 17592186179743 :knowledge-point/id #uuid "1da220a9-2afc-5b63-a423-a4d2b3de9567" :knowledge-point/title "Circulation in Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09c4ca32-01d3-5738-bf72-b8352d5c52bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463518} {:answer/id #uuid "da99aeb6-90d2-5e8f-b5d8-7b05292fda87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463519}] :answer-field/correct {:answer/id #uuid "da99aeb6-90d2-5e8f-b5d8-7b05292fda87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463519} :answer-field/id #uuid "919615d2-0f76-58af-8761-3a14fe46d18f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464693} {:answer-field/choices [{:answer/id #uuid "34d9db93-5a15-5b46-8273-d519f8d86e43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463520} {:answer/id #uuid "2539dad8-dc80-5397-b9a8-c578eeb0666a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463521}] :answer-field/correct {:answer/id #uuid "2539dad8-dc80-5397-b9a8-c578eeb0666a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463521} :answer-field/id #uuid "60cccf49-fa44-52b6-860d-b7a17aa98cbe" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464694} {:answer-field/choices [{:answer/id #uuid "9e642cf7-9d5f-5e17-8e6f-08394c3a7be9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463522} {:answer/id #uuid "f50da4f3-efa9-5c80-b985-c77c0571181a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463523}] :answer-field/correct {:answer/id #uuid "f50da4f3-efa9-5c80-b985-c77c0571181a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463523} :answer-field/id #uuid "1fa9dff9-ff4d-597d-8ef9-69284d5d1e3f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464695}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2353653c-eb1d-5d31-b3c0-eed1015199de" :question/math-academy-id "q-125664" :question/problem "Consider the vector field $F(x,y)=({y}^{2}+3x)\\,i+(2xy+3)\\,j.$ Which of the following statements are true?\n- **I.** $F$ is conservative\n- **II.** ${∮}_{C}F\\cdot \\text{d}r=0$ for any circle $C\\in {R}^{2}$\n- **III.** ${∮}_{C}F\\cdot \\text{d}r=0$ for any closed path $C\\in {R}^{2}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "If $F$ is a conservative vector field on ${R}^{2},$ then the circulation $Γ=0$ for any *closed* path $C\\in {R}^{2},$ that is \n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r=0.\n$$\n\nWe notice that $F=P\\,i+Q\\,j$ is a vector field with domain $D={R}^{2}.$ Computing the partial derivatives, we have\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=2y.\n$$\n\nWith that in mind, let's consider each statement in turn:\n\n- Statement I is true. The vector field $F$ is conservative since the partial derivatives are equal and continuous everywhere on ${R}^{2}.$\n\n- Statement II and III are true. The circulation $Γ=0$ for any closed path $C\\in {R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186259843 :knowledge-point/_questions [{:db/id #edb/ref 17592186179740 :knowledge-point/id #uuid "6f30993e-b5c7-5d8a-9b27-2aed2c9223e1" :knowledge-point/title "Determining the Sign of a Circulation From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06dbf44c-a97d-5504-aaf1-6c264e0b1a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463524} {:answer/id #uuid "8e129735-2b0e-5398-b43e-eba53f0bd641" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463525}] :answer-field/correct {:answer/id #uuid "06dbf44c-a97d-5504-aaf1-6c264e0b1a0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463524} :answer-field/id #uuid "c82c86ec-d6d5-5ab6-aee9-a9658eb3f2ee" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464696} {:answer-field/choices [{:answer/id #uuid "16ec4d98-ca2c-51aa-a554-0a0261babe64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463526} {:answer/id #uuid "924c827f-ee30-5f0f-9c24-3aa92a243a2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463527}] :answer-field/correct {:answer/id #uuid "16ec4d98-ca2c-51aa-a554-0a0261babe64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463526} :answer-field/id #uuid "936072da-8823-5ffd-a2dc-d329a5e7d650" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464697} {:answer-field/choices [{:answer/id #uuid "aacbbfa5-1cb5-59f3-8092-856333260916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463528} {:answer/id #uuid "e0541a8e-593e-5a77-bbb2-a56dc7ba00d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463529}] :answer-field/correct {:answer/id #uuid "e0541a8e-593e-5a77-bbb2-a56dc7ba00d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463529} :answer-field/id #uuid "b0761348-b2bc-5d51-a4a4-3ecdf8745d6a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464698}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bb28647b-13b7-5f23-9064-5edced19689d" :question/math-academy-id "q-125668" :question/problem "![](images/6e/6ed50407066da9fc213202ccff8c8be06c89d2dce0f5dfe07877cab77c98b3ec.png)\n\nConsider the ellipse $E$ and vector field $F$ shown above. Let $C$ be any path where $E$ is traversed once in the **clockwise** direction. Which of the following statements are true?\n\n- ${∮}_{C}F\\cdot \\text{d}r<0$\n- ${∮}_{C}F\\cdot \\text{d}r>0$\n- ${∮}_{-C}F\\cdot \\text{d}r=0$\n\nSelect all that apply." :question/worked-solution "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nWe now recall the following:\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${∮}_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${∮}_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I and II are false. Since the force $F$ acts perpendicular to the motion of the particle as it moves around $C,$ it neither helps nor hinders its motion. \n\n![](images/04/045f6867a50dff0c162376015cc4651de796d0a637643b4b5ba402ef55dde4fa.png)\n\nSo, ${∮}_{C}F\\cdot \\text{d}r=0.$\n\n- Statement III is true. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ remains unchanged.\n\n![](images/69/698f68b9539e6ef5c4b07dbe6cf3859449e2687db19406f6c2b0072fa5eb697e.png)\n\nSo, ${∮}_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186259844 :knowledge-point/_questions [{:db/id #edb/ref 17592186179742 :knowledge-point/id #uuid "3d72127a-90d6-5f7e-bd87-75d03285a918" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Non-Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b9c996c-5a73-566e-bbb7-6b0823547575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463530} {:answer/id #uuid "30a2656e-d4ea-5f17-9193-df6e7c38a132" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463531}] :answer-field/correct {:answer/id #uuid "9b9c996c-5a73-566e-bbb7-6b0823547575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463530} :answer-field/id #uuid "d493a8c4-7d2e-51cc-ac4a-a63d54af6e3d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464699} {:answer-field/choices [{:answer/id #uuid "4919df2b-1781-51fe-810e-b5fcd6350e48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463532} {:answer/id #uuid "ae069756-d16c-5e63-af48-f69f18b462c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463533}] :answer-field/correct {:answer/id #uuid "ae069756-d16c-5e63-af48-f69f18b462c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463533} :answer-field/id #uuid "d91f3df4-dbea-5df3-a3ae-7785cf6bf841" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464700} {:answer-field/choices [{:answer/id #uuid "98296909-a163-589b-af22-9510086818fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463534} {:answer/id #uuid "5c79980a-5b04-5a68-ac76-67ef430a4d6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463535}] :answer-field/correct {:answer/id #uuid "5c79980a-5b04-5a68-ac76-67ef430a4d6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463535} :answer-field/id #uuid "592f6dad-8033-5ef7-8c01-64650a21f312" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464701}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc38a3d9-696c-596f-b353-c55f7e71f2d3" :question/math-academy-id "q-125688" :question/problem "![](images/b9/b9dd2fb4478ac443020e9cbebd64a2c9e4cdf5c7b6d5ce5cede854e0d7a3d804.png)\n\nConsider the vector field $F(x,y)$ shown above. Let $C$ be the path where the curve is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r>0$\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$\n\nSelect all that apply." :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statement I is false while statement II is true. It's clear from the picture below that $F$  works against the motion of the particle as it moves from $A$ to $B.$\n\n![](images/51/51fafa71ff31592d9692348087cf0a20f6bbaa3b05e8519b4109d44207899a39.png)\n\n \nSo, ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\n- Statement III is true. It's clear from the picture below that $F$ assists the motion of the particle as it moves from $B$ to $A.$\n\n![](images/22/2287c33ff81973bcaef70917452c97282e0d0dd9ef06141d5beee8b53dec5836.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186259845 :knowledge-point/_questions [{:db/id #edb/ref 17592186179739 :knowledge-point/id #uuid "dab6bfb9-608d-5ff8-88e7-5aa9612acda4" :knowledge-point/title "Interpreting the Sign of a Line Integral Over a Constant Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77d82670-955d-5fbd-bc9e-ff9b5595ca19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463536} {:answer/id #uuid "70953006-86df-56ba-885e-a59756ac68a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463537}] :answer-field/correct {:answer/id #uuid "77d82670-955d-5fbd-bc9e-ff9b5595ca19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463536} :answer-field/id #uuid "4bbc6ae6-a433-51b7-9bcc-4234a55196ba" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464702} {:answer-field/choices [{:answer/id #uuid "e3413fb0-066c-5f24-a376-7d72fef132fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463538} {:answer/id #uuid "090b215e-b754-554a-8109-db90d4abfb27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463539}] :answer-field/correct {:answer/id #uuid "090b215e-b754-554a-8109-db90d4abfb27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463539} :answer-field/id #uuid "79b6f686-1017-5c39-b085-1d1f73f3ac2e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464703} {:answer-field/choices [{:answer/id #uuid "f3c62597-d021-5cbd-8c81-864877afd3e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463540} {:answer/id #uuid "9d291d8d-f31c-5932-8efc-6cd6f690f503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463541}] :answer-field/correct {:answer/id #uuid "f3c62597-d021-5cbd-8c81-864877afd3e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463540} :answer-field/id #uuid "162bbeb9-8561-5809-b4fd-17fcbbfe7d72" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464704}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9d575c8-adec-5386-bb2f-10bc638decac" :question/math-academy-id "q-125706" :question/problem "![](images/a4/a423ab56220e438fb849d2025ab53b99bb74ef598e16110c911d691680130527.png)\n\nConsider the semicircle and constant vector field $F$ shown above. Let $C$ be the path where the semicircle is traversed from $A$ to $B.$ Which of the following statements are true?\n\n- ${\\int }_{C}F\\cdot \\text{d}r<0$\n- ${\\int }_{C}F\\cdot \\text{d}r=0$\n- ${\\int }_{-C}F\\cdot \\text{d}r>0$\n\nSelect all that apply." :question/worked-solution "Remember that ${\\int }_{C}F\\cdot \\text{d}r$ gives the total work done by a force $F$ in moving a particle along $C:$\n\n- If the force works *with* the motion of the particle (i.e., the force helps to push the particle along the path), then ${\\int }_{C}F\\cdot \\text{d}r>0.$\n\n- If the force works *against* the motion of the particle (i.e., the force impedes the motion of the particle as it moves along the path), then ${\\int }_{C}F\\cdot \\text{d}r<0.$\n\nWith that in mind, let's check each statement.\n\n- Statements I is false, while statement II is true. As the particle moves from $A$ to $B,$ the force $F$ works  against the particle for $x<0,$ while $F$  works with the particle for $x>0.$ \n\n![](images/cd/cd52e91c72d481980c9a48575da7ca3eaebd2ed27f96b1054cf5c1c5da1aa3d9.png)\n\n \nBy symmetry, the contribution to ${\\int }_{C}F\\cdot \\text{d}r$ for $x<0$ is canceled out by the contribution for $x>0.$ So, \n\n$$\n{\\int }_{C}F\\cdot \\text{d}r=0.\n$$\n\n- Statement III is false. If we reverse the orientation of $C,$ then the situation with regards to the work done by $F$ is similar to the previous case.\n\n![](images/a1/a1e8fa5262fc787b691b3753fc57ab39aceee7c57dbbe166c6da6f6effaf42dc.png)\n\n \nSo, ${\\int }_{-C}F\\cdot \\text{d}r=0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186259863 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc80e04-300d-575e-befb-8d927f5a1393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463542} {:answer/id #uuid "11a2cad8-574b-5542-b2bb-a30e735d1d50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463543}] :answer-field/correct {:answer/id #uuid "11a2cad8-574b-5542-b2bb-a30e735d1d50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463543} :answer-field/id #uuid "c6de86d3-8240-540a-9b53-90a7214df88d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464705} {:answer-field/choices [{:answer/id #uuid "7dc0b456-6310-5ad5-b10c-eb2af4c2fc70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463544} {:answer/id #uuid "84cbd523-8193-5a7a-b8cd-96a8abf8e332" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463545}] :answer-field/correct {:answer/id #uuid "7dc0b456-6310-5ad5-b10c-eb2af4c2fc70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463544} :answer-field/id #uuid "2c1caf6b-e6da-5368-a8d4-722507ce7684" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464706} {:answer-field/choices [{:answer/id #uuid "be16c156-3162-5023-ad80-da11f2f6bcc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463546} {:answer/id #uuid "3e8d6bcb-9ee4-5850-8817-08b222a8bfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463547}] :answer-field/correct {:answer/id #uuid "be16c156-3162-5023-ad80-da11f2f6bcc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463546} :answer-field/id #uuid "50cc552f-f6da-53d0-8115-14a52ecbc6c5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464707} {:answer-field/choices [{:answer/id #uuid "4af2b663-f664-5687-8b3d-4cb7ed3e89ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463548} {:answer/id #uuid "12a3b8bc-c982-5ad8-998b-0a6fb0036f63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463549}] :answer-field/correct {:answer/id #uuid "4af2b663-f664-5687-8b3d-4cb7ed3e89ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463548} :answer-field/id #uuid "53b4e1b4-58bf-5e0a-bc9c-2b1223fdcc3c" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464708}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "528091bc-3b41-5908-b5b6-b20261706098" :question/math-academy-id "q-125792" :question/problem "Consider the vector field $F(x,y)=⟨1,\\,x⟩$ and the points $A(1,0)$ and $B(e,1)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2(e-1),$ where ${C}_{1}$ is the path along the curve $y=\\operatorname{ln}⁡x,$ traversed from $A$ to $B.$\n\n- **II.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2(e-1),$ where ${C}_{2}$ is the path along the segment line $\\overset{―}{AB},$ traversed from $A$ to $B.$\n\n- **III.** ${\\int }_{C}F\\cdot \\text{d}r$ is independent of path.\n\n- **IV.** $F$ is conservative." :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Parameterizing the curve, we have\n\n$$\n{r}_{1}(t)=⟨t,\\,\\operatorname{ln}⁡t⟩,\\,t\\in [1,e].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{e}⟨1,\\,t⟩\\cdot ⟨1,\\,\\frac{1}{t}⟩\\text{d}t \\\\  & ={\\int }_{1}^{e}1+1\\,\\text{d}t \\\\  & ={\\int }_{1}^{e}2\\,\\text{d}t \\\\  & =2t\\,{|}_{1}^{e} \\\\  & =2(e-1).\\end{aligned}\n$$\n\n- Statement II is false. Parameterizing the line segment, we have\n\n$$\n{r}_{2}(t)=⟨t(e-1)+1,\\,t⟩,\\,t\\in [0,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}⟨1,\\,t(e-1)+1⟩\\cdot ⟨e-1,\\,1⟩\\text{d}t \\\\  & ={\\int }_{0}^{1}e-1+t(e-1)+1\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}t(e-1)+e\\,\\text{d}t \\\\  & ={[\\frac{{t}^{2}(e-1)}{2}+et]}_{0}^{1} \\\\  & =\\frac{e-1}{2}+e \\\\  & =\\frac{3e-1}{2}.\\end{aligned}\n$$\n\n- Statement III is false. Since ${C}_{1}$ and ${C}_{2}$ have the same initial and terminal points, yet\n\n$$\n{\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne {\\int }_{{C}_{2}}F\\cdot \\text{d}r,\n$$\n\nwe conclude that ${\\int }_{C}F\\cdot \\text{d}r$ is path-dependent.\n\n- Statement IV is false. If a vector field is conservative then it is path-independent. Since $F$ is path-dependent, it is not conservative."}] [{:db/id #edb/ref 17592186262582 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "542c9807-1c7a-504c-b2af-30d109bc497d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463550} {:answer/id #uuid "e24e7478-85a9-58fd-886d-f256b5b6a5d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463551}] :answer-field/correct {:answer/id #uuid "e24e7478-85a9-58fd-886d-f256b5b6a5d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463551} :answer-field/id #uuid "2f501661-5639-5bbb-9d73-8d6bdb1d937c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464709} {:answer-field/choices [{:answer/id #uuid "c02e551d-7319-5874-a20c-61f3a4cb1b39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463552} {:answer/id #uuid "9cd96405-cc44-592b-8cc3-004cdee43cf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463553}] :answer-field/correct {:answer/id #uuid "9cd96405-cc44-592b-8cc3-004cdee43cf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463553} :answer-field/id #uuid "0e0db100-e925-599d-9775-025f5f653126" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464710} {:answer-field/choices [{:answer/id #uuid "c52ba72e-853f-5aa6-9531-3f9e22453e19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463554} {:answer/id #uuid "9604f066-c44a-51dc-907b-feb472493840" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463555}] :answer-field/correct {:answer/id #uuid "c52ba72e-853f-5aa6-9531-3f9e22453e19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463554} :answer-field/id #uuid "0b1108d4-d957-56ee-8c81-5c3f192e66c7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2fe31cd-d230-5631-896a-30445b121eb6" :question/math-academy-id "q-126053" :question/problem "Which of the following are continuous random variables?\n- **I.** The volume, measured in cubic centimeters, of water in a cup of coffee\n- **II.** The average length, measured in millimeters, of hairs on a horse\n- **III.** The number of hairs on a cat\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $(0,\\infty ).$\n\n- Statement II describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $(0,\\infty ).$\n\n- Statement III does *not* describe a continuous random variable. Its value is determined by the result of an experiment, but its possible values are the integers $0,1,2,3,…,$ which do not correspond to an interval of real numbers.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186262583 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9998d275-1a60-5cc8-9c0c-e66b50be3b79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463556} {:answer/id #uuid "99f630c9-f750-56d2-be5b-c9bdda39830f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463557}] :answer-field/correct {:answer/id #uuid "9998d275-1a60-5cc8-9c0c-e66b50be3b79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463556} :answer-field/id #uuid "42dd6c7f-de94-5ed4-8dd4-a9f8ff497b1d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464712} {:answer-field/choices [{:answer/id #uuid "827afbc3-e49b-52eb-af05-8e6025c0c052" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463558} {:answer/id #uuid "4cea056f-abd8-513c-872e-67b48b0a8dbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463559}] :answer-field/correct {:answer/id #uuid "4cea056f-abd8-513c-872e-67b48b0a8dbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463559} :answer-field/id #uuid "659223c8-00e8-5799-b386-c86ece280926" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464713} {:answer-field/choices [{:answer/id #uuid "6814be3c-c572-5fa7-a9a6-77ebddcd560c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463560} {:answer/id #uuid "5a014c8f-7029-5d79-aab9-3b661c6052f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463561}] :answer-field/correct {:answer/id #uuid "6814be3c-c572-5fa7-a9a6-77ebddcd560c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463560} :answer-field/id #uuid "d7faf699-0bb3-5e0d-b1ef-9f6f6286f3cb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "724bbcc0-f7b8-5dfa-b545-2c13cb88e263" :question/math-academy-id "q-126057" :question/problem "Which of the following are continuous random variables?\n- **I.** The number obtained when throwing a die\n- **II.** The weight, measured in grams, of sugar in a bowl\n- **III.** The speed limit on a certain road\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I does *not* describe a continuous random variable. Its value is determined by the result of an experiment, but its possible values are the integers $1,2,3,4,5,6,$ which do not correspond to an interval of real numbers.\n\n- Statement II describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the interval $[0,\\infty ).$\n\n- Statement III does *not* describe a continuous random variable. The speed limit on a certain road is not the outcome of a trial or experiment.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186262584 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b50dba-8694-51ea-a35e-b4bd86bec3d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463562} {:answer/id #uuid "900c7459-17eb-5177-a271-c7469575a0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463563}] :answer-field/correct {:answer/id #uuid "900c7459-17eb-5177-a271-c7469575a0f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463563} :answer-field/id #uuid "6731853f-5334-5c22-a346-9409f0a2a22e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464715} {:answer-field/choices [{:answer/id #uuid "00fc378b-457d-547f-8b99-28a3ad28bcbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463564} {:answer/id #uuid "13962be2-385c-5e4a-bc9f-42b3b58c82c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463565}] :answer-field/correct {:answer/id #uuid "00fc378b-457d-547f-8b99-28a3ad28bcbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463564} :answer-field/id #uuid "177bd183-0ce9-5f65-af93-708eccfacd23" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464716} {:answer-field/choices [{:answer/id #uuid "4f330944-206b-5ef2-ad02-310197bb5eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463566} {:answer/id #uuid "0e9ccba2-8e0b-5551-afcb-5e2c8f4fcf16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463567}] :answer-field/correct {:answer/id #uuid "0e9ccba2-8e0b-5551-afcb-5e2c8f4fcf16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463567} :answer-field/id #uuid "5890b149-b511-5044-bed9-09b94810af9d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464717}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ec51dd0-d568-5d90-9c62-e7294f84d1e8" :question/math-academy-id "q-126061" :question/problem "Which of the following are continuous random variables?\n- **I.** The percentage of impurity in a batch of chemicals\n- **II.** The area of an equilateral triangle with a side of $2$\n- **III.** The amount of snowfall, in centimeters, in a randomly selected city in January 2022\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I  describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $[0,100]$ (since the percentage can be anywhere between $0%$ and $100%$).\n\n- Statement II does *not* describe a continuous random variable. The area of an equilateral triangle with a given side length is not the outcome of a trial or experiment.\n\n- Statement III describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real interval $[0,\\infty ).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186262598 :knowledge-point/_questions [{:db/id #edb/ref 17592186087695 :knowledge-point/id #uuid "ddb59990-7419-585f-aa1b-901d59c8cfc1" :knowledge-point/title "Identifying a Zero Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37604281-9d43-5bbd-bda5-53144e675aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463568} {:answer/id #uuid "9631a4fc-dd62-5cec-9261-ebdb8f30131a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463569}] :answer-field/correct {:answer/id #uuid "9631a4fc-dd62-5cec-9261-ebdb8f30131a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463569} :answer-field/id #uuid "60c94232-ba43-57ee-a962-32f5418c59f9" :answer-field/key "G" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464718} {:answer-field/choices [{:answer/id #uuid "d4fc44cc-9ea3-56fa-afd1-2986f952f5d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463570} {:answer/id #uuid "84aebdca-8e86-57df-a9d8-dd128cc562f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463571}] :answer-field/correct {:answer/id #uuid "84aebdca-8e86-57df-a9d8-dd128cc562f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463571} :answer-field/id #uuid "31fbf221-5947-5900-ab87-93dc8e512bb4" :answer-field/key "H" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464719} {:answer-field/choices [{:answer/id #uuid "3d8aa1bc-0476-5551-82bd-c2ebbfd58427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463572} {:answer/id #uuid "02c0c0d2-9197-51bc-b430-d8a9162d54fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463573}] :answer-field/correct {:answer/id #uuid "3d8aa1bc-0476-5551-82bd-c2ebbfd58427" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463572} :answer-field/id #uuid "ce047a3c-78b0-5323-969d-f4c772f47580" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1106adcf-574f-500e-b7d8-8e6442faa20a" :question/math-academy-id "q-126201" :question/problem "Which of the following are zero matrices?\n\n$$\nH=[\\begin{aligned}0 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{aligned}],\\,I=[\\begin{aligned}0 & 0 \\\\ 0.1 & 0.1 \\\\ 0 & 0\\end{aligned}],\\,G=[\\begin{aligned}0\\end{aligned}]\n$$\n\nSelect all that apply." :question/worked-solution "- $H$ is a zero matrix since *all* its entries are zeros.\n\n- $I$ is *not* a zero matrix since some of its entries are not zeros (for instance, ${i}_{12}=0.1\\ne 0$).\n\n- $G$ is a zero matrix since *all* its entries are zeros.\n\nTherefore, only $H$ and $G$ are zero matrices."}] [{:db/id #edb/ref 17592186262599 :knowledge-point/_questions [{:db/id #edb/ref 17592186087695 :knowledge-point/id #uuid "ddb59990-7419-585f-aa1b-901d59c8cfc1" :knowledge-point/title "Ide