b/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "114cf182-dccf-5764-a411-6c6c3328247d" :question/math-academy-id "q-130670" :question/problem "Which of the following second-order differential equations are linear?\n- **I.** $2{y}^{″}+(\\operatorname{sin}⁡x){y}^{′}-y=1$\n- **II.** ${y}^{″}+y{y}^{′}+{e}^{x}y=0$\n- **III.** $x{y}^{″}+{x}^{2}y={e}^{x}$\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n2{y}^{″}+(\\operatorname{sin}⁡x){y}^{′}-y=1\n$$\n\nis a second-order linear ODE with $a(x)=2,b(x)=\\operatorname{sin}⁡x,c(x)=-1,$ and $f(x)=1.$\n\n- The equation\n\n$$\n{y}^{″}+y{y}^{′}+{e}^{x}y=0\n$$\n\nis **NOT** linear because it contains the nonlinear term $y{y}^{′}.$\n\n- The equation\n\n$$\nx{y}^{″}+{x}^{2}y={e}^{x}\n$$\n\nis a second-order linear ODE with $a(x)=x,b(x)=0,c(x)={x}^{2},$ and $f(x)={e}^{x}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186265954 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "579c4389-1f02-5274-8ef3-8ddb9e4c467e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463880} {:answer/id #uuid "e663fafa-9f14-55d5-96ad-2c10d31e9978" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463881}] :answer-field/correct {:answer/id #uuid "e663fafa-9f14-55d5-96ad-2c10d31e9978" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463881} :answer-field/id #uuid "ebbcca07-c4cf-5d12-95bd-1a28dfe3407d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464874} {:answer-field/choices [{:answer/id #uuid "4de69a75-9c0f-52d9-9354-fc0f795fdd9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463882} {:answer/id #uuid "fa25ee79-e03c-544e-a40d-6452f7a7cd34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463883}] :answer-field/correct {:answer/id #uuid "4de69a75-9c0f-52d9-9354-fc0f795fdd9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463882} :answer-field/id #uuid "6ee4df8d-ba88-55d3-b4f4-b9365c7e3811" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464875} {:answer-field/choices [{:answer/id #uuid "aef3aa88-07ae-5c22-b0e4-3dcd060e653f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463884} {:answer/id #uuid "f1b6dc71-fa1f-5546-a7a1-52cd8f76be5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463885}] :answer-field/correct {:answer/id #uuid "aef3aa88-07ae-5c22-b0e4-3dcd060e653f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463884} :answer-field/id #uuid "920346ba-105f-56c1-baa3-ede3853ae5b9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7e46e30-10b0-546e-b7af-e3d72616cbd7" :question/math-academy-id "q-130671" :question/problem "Which of the following second-order differential equations are linear?\n- **I.** $(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2$\n- **II.** ${y}^{3}{y}^{″}+x{y}^{′}-xy=0$\n- **III.** $\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}$\n\nSelect all that apply." :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2\n$$\n\nis a second-order linear ODE with $a(x)=\\operatorname{ln}⁡x,b(x)=-x,c(x)=1,$ and $f(x)=2.$\n\n- The equation\n\n$$\n{y}^{3}{y}^{″}+x{y}^{′}-xy=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${y}^{3}{y}^{″}.$\n\n- The equation\n\n$$\n\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}\n$$\n\nis **NOT** linear because it contains the nonlinear term $xy{y}^{′}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186265955 :knowledge-point/_questions [{:db/id #edb/ref 17592186152273 :knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4" :knowledge-point/title "Identifying Second-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d90b07b-3b2f-5dd7-ae06-6bd4d25eaaaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463886} {:answer/id #uuid "41052ad9-08e4-5109-873f-da03122a643d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186463887}] :answer-field/correct {:answer/id #uuid "3d90b07b-3b2f-5dd7-ae06-6bd4d25eaaaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186463886} :answer-field/id #uuid "b0b765e3-1d1e-5789-ba6d-dddb94ca8a11" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186464877} {:answer-field/choices [{:answer/id #uuid "d0be1a6c-64d1-5b97-