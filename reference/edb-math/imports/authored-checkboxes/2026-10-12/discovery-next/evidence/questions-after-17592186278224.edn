6045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465362} :answer-field/id #uuid "03ab94df-f36b-504b-a946-93365d5695c3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466524}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "507c7b5b-1f55-5451-94d5-1770ddfeea4a" :question/math-academy-id "q-161031" :question/problem "![](images/09/0963fc3c56b5baac68e2d587896bf4655950640ecce5b924edc2d8e26a3e64e2.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ={(u,v)\\,:\\,0\\le u\\le \\sqrt{3},\\,\\,0\\le v\\le \\frac{\\pi }{4}},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the bottom side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\n- The image makes the angle of $0$ with the positive $x$-axis.\n- The image makes the angle of $\\frac{\\pi }{4}$ with the positive $x$-axis.\n- One endpoint of the image is the origin $O$ of the $xy$-plane, and the other endpoint lies on the circle of radius $\\sqrt{3}$ centered at $O.$\n\nSelect all that apply." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the bottom side.\n\nFor the bottom side, we have $v=0$ and $0\\le u\\le \\sqrt{3}.$ \n\nSubstituting $v=0$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡0,\\,u\\operatorname{sin}⁡0) \\\\  & =(u,\\,0),\\,0\\le u\\le \\sqrt{3}.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/92/92bd315a07a5d76e77c249c12ea4544ee1555b0c214c68cf1f92fc3f07a71ddf.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true, while statement II is false. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡0}{\\operatorname{cos}⁡0}=\\operatorname{tan}⁡0.\n$$\n\nAs a result, our line makes an angle of $0$ radians with the positive $x$-axis.\n\n- Statement III is true.\n\n- When $u=0,$ we obtain the point \n$(0,\\,0),$\nwhich is the origin $O$ of the $xy$-plane.\n\n- When $u=\\sqrt{3},$ we obtain the point \n$(\\sqrt{3}\\operatorname{cos}⁡0,\\,\\sqrt{3}\\operatorname{sin}⁡0),$\nwhose distance to $O$ is $\\sqrt{3}.$\n\nSo, one endpoint of the segment is the origin $O$ of the $xy$-plane, while the other endpoint lies on the circle with radius $\\sqrt{3}$ centered at $O.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186278355 :knowledge-point/_questions [{:db/id #edb/ref 17592186198384 :knowledge-point/id #uuid "58fbdce5-60b9-5682-a84e-1c8a5077c762" :knowledge-point/title "Finding the Image of a Horizontal Segment Under a Polar Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3096bf79-13cb-5594-8ff3-0aacf795dbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465363} {:answer/id #uuid "393ffa03-6956-52c3-9c56-83c0666a5be8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465364}] :answer-field/correct {:answer/id #uuid "3096bf79-13cb-5594-8ff3-0aacf795dbf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465363} :answer-field/id #uuid "d865425f-0ed5-5b50-8ef9-b8868f1ed1a5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466525} {:answer-field/choices [{:answer/id #uuid "313850ab-cf0e-5be1-adef-f98bf156970b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465365} {:answer/id #uuid "13a93521-b1c0-56cd-89e3-b6c1a0c7b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465366}] :answer-field/correct {:answer/id #uuid "13a93521-b1c0-56cd-89e3-b6c1a0c7b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465366} :answer-field/id #uuid "fd71148f-4e73-5e2a-8879-b803cc673e59" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466526} {:answer-field/choices [{:answer/id #uuid "8d8d6a03-31ff-5539-a052-c4af98a1c661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465367} {:answer/id #uuid "c1b94c56-f71d-5f8c-82f5-974795670e84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465368}] :answer-field/correct {:answer/id #uuid "8d8d6a03-31ff-5539-a052-c4af98a1c661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465367} :answer-field/id #uuid "f410ff3f-f43f-507a-8637-7fcae02b4d22" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466527}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b7f9af3-cd62-5b44-9828-72b23454ff87" :question/math-academy-id "q-161032" :question/problem "![](images/16/16d74107dbbf12749766cd9cea7e38d16e28a59efb997bd224aed73c7830324e.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,2\\le u\\le 4,\\,\\,\\frac{10\\pi }{9}\\le v\\le \\frac{4\\pi }{3}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the top side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nI. The image makes the angle of $\\frac{10\\pi }{9}$ with the positive $x$-axis.\n\nII. The image makes the angle of $\\frac{4\\pi }{3}$ with the positive $x$-axis.\n\nIII. The endpoints of the image lie on the circles of radii $\\sqrt{2}$ and $2$ centered at $O.$\n\nSelect all that apply." :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{4\\pi }{3}$ and $2\\le u\\le 4.$ \n\nSubstituting $v=\\frac{4\\pi }{3}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,u\\operatorname{sin}⁡(\\frac{4\\pi }{3})),\\,2\\le u\\le 4.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/bf/bfe75ef6b4ea9ddd72be6501f95fd89dd1e80fb2aed691c3c22b158514141cc1.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false, while statement II is true. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡(\\frac{4\\pi }{3})}{\\operatorname{cos}⁡(\\frac{4\\pi }{3})}=\\operatorname{tan}⁡(\\frac{4\\pi }{3}).\n$$\n\nAs a result, our line makes an angle of $\\frac{4\\pi }{3}$ radians with the positive $x$-axis.\n\n- Statement III is false.\n\n- When $u=2,$ we obtain the point \n$(2\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,2\\operatorname{sin}⁡(\\frac{4\\pi }{3})),$\nwhose distance to the origin is $2.$\n\n- When $u=4,$ we obtain the point \n$(4\\operatorname{cos}⁡(\\frac{4\\pi }{3}),\\,4\\operatorname{sin}⁡(\\frac{4\\pi }{3})),$\nwhose distance to the origin is $4.$\n\nSo, the endpoints of the line segment lie on the circles of radii $2$ and $4.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186278356 :knowledge-point/_questions [{:db/id #edb/ref 17592186198384 :knowledge-point/id #uuid "58fbdce5-60b9-5682-a84e-1c8a5077c762" :knowledge-point/title "Finding the Image of a Horizontal Segment Under a Polar Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e9d7f9d-83aa-5312-b9f9-936431142ca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465369} {:answer/id #uuid "0ac8bfb2-2b9e-55b8-bb40-8f8acd30ba03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465370}] :answer-field/correct {:answer/id #uuid "3e9d7f9d-83aa-5312-b9f9-936431142ca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465369} :answer-field/id #uuid "3c3a02a3-a8fc-5d7d-a6a6-ce9f21391422" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466528} {:answer-field/choices [{:answer/id #uuid "a7781f3c-7002-5af8-8927-9ec981d328c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465371} {:answer/id #uuid "a99cc1de-6948-5f01-b0c0-9f08fcb47a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465372}] :answer-field/correct {:answer/id #uuid "a99cc1de-6948-5f01-b0c0-9f08fcb47a6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465372} :answer-field/id #uuid "bcb1bd5d-92e5-55ab-98