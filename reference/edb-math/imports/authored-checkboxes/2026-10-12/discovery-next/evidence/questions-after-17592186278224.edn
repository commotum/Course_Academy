8166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e51e86f2-eaf4-5f67-aebb-f55a23118243" :question/math-academy-id "q-181544" :question/problem "To which of the following sets does the number $-\\pi $ belong?\n- **I.** ${Q}^{-}$\n- **II.** $R$\n- **III.** $Q$\n- **IV.** $C$\n\nSelect all that apply." :question/worked-solution "The number $-\\pi $ is not a rational number. Consequently, $-\\pi $ does not belong to any of the sets  ${Q}^{-}$ nor $Q.$\n\nHowever, $-\\pi $ is a real number, so it belongs to $R.$\n\nFinally, since every real number is also a complex number, $-\\pi $ also belongs to $C.$\n\nTherefore, the correct answer is \"II and IV only.\""}] [{:db/id #edb/ref 17592186287686 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "685c4875-0108-59c6-9508-738d2348c3e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465699} {:answer/id #uuid "698f58d3-89f8-511b-a2fe-ce9047c4508a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465700}] :answer-field/correct {:answer/id #uuid "685c4875-0108-59c6-9508-738d2348c3e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465699} :answer-field/id #uuid "ab5bdb9f-88cc-5658-ad7e-534f38ea2454" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466693} {:answer-field/choices [{:answer/id #uuid "c43451b8-a06e-5760-9ffd-8c873f495a33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :