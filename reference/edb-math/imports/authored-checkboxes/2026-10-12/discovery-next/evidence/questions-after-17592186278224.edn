17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465614} :answer-field/id #uuid "6ab65278-7429-50c5-a06d-a27843fc3660" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5c7018c-43c9-5b98-9ebb-afb43a98b63e" :question/math-academy-id "q-174414" :question/problem "Which of the following are mathematical statements?\n- **P.** $P:0.5\\in Z$\n- **Q.** $Q:4÷2$\n- **R.** $R:4\\,|\\,9$\n\nSelect all that apply." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false. \n\nWith that in mind, let's examine the given options: \n\n- $P$ is a statement. This statement is *false* because $0.5$ is not an integer.\n\n- $Q$  is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *false* because $4$ does not divide $9.$\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""}] [{:db/id #edb/ref 17592186284708 :knowledge-point/_questions [{:db/id #edb/ref 17592186054819 :knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406" :knowledge-point/title "Identifying Statements Expressed Using Symbols"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd4e62ea-3970-56df-af4d-fbc37449a669" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465615} {:answer/id #uuid "a6a2f75c-bff6-5a95-8f29-1725eb55e9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465616}] :answer-field/correct {:answer/id #uuid "a6a2f75c-bff6-5a95-8f29-1725eb55e9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465616} :answer