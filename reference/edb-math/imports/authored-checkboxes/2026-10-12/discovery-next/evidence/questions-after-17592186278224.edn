465784} :answer-field/id #uuid "3082fdb7-2d3c-5ad6-8f45-54d8562f9917" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466735}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68270c3d-bf20-5dbc-8e60-99dca2522513" :question/math-academy-id "q-181947" :question/problem "If $A={p,q}$ and $B={2,4,6},$ which of the following elements belong to $A\\times A\\times B?$\n- **I.** $(p,q,2)$\n- **II.** $((p,p),4)$\n- **III.** $(q,q,6)$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times A\\times B$ consists of every combination of ${p,q}$ with ${p,q}$ and ${2,4,6},$ which results in\n\n$$\n\\begin{aligned}A\\times A\\times B={ & (p,p,2),(p,p,4),(p,p,6),(p,q,2),(p,q,4),(p,q,6), \\\\  & (q,p,2),(q,p,4),(q,p,6),(q,q,2),(q,q,4),(q,q,6)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times A\\times B|=|A|\\cdot |A|\\cdot |B|=2\\cdot 2\\cdot 3=12.\n$$\n\nFrom the given options, we see that both $(p,q,2)$ and $(q,q,6)$ are in $A\\times A\\times B.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186287776 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68a7771f-8fb1-5088-8a3a-d21f3672b989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465785} {:answer/id #uuid "de235a2a-b9cb-53e1-9a70-f02fbe2bdda4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465786}] :answer-field/correct {:answer/id #uuid "68a7771f-8fb1-5088-8a3a-d21f3672b989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465785} :answer-field/id #uuid "a1bd8f23-a1a9-5a5c-a9e7-71b76c3c3bb9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466736} {:answer-field/choices [{:answer/id #uuid "61e6fbf4-51c5-5022-8e50-8b871f318ee0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465787} {:answer/id #uuid "dabe9835-ce84-5ba1-a7c4-4940a27c1d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465788}] :answer-field/correct {:answer/id #uuid "dabe9835-ce84-5ba1-a7c4-4940a27c1d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465788} :answer-field/id #uuid "9381889e-e0aa-59ae-9ec3-53c0fd303581" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466737} {:answer-field/choices [{:answer/id #uuid "e76f445f-22d0-56db-9f2a-14d4c3ac8104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465789} {:answer/id #uuid "606cff30-23e5-508f-8263-993ad0451b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465790}] :answer-field/correct {:answer/id #uuid "606cff30-23e5-508f-8263-993ad0451b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465790} :answer-field/id #uuid "584dba5f-36d3-538a-9620-0a137f5fcb75" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acf6f0a0-0064-5b71-8b07-5e0f0eb96bda" :question/math-academy-id "q-181963" :question/problem "![](images/cb/cb3e6ef6a832f2adbbc5e096bddf2c4f6a0445fbd77a71df5617298f8dad2e51.png)\n\nBy finding the missing entries in the schematic shown above for $A\\times B,$ where $A=\\{a,b,c\\}$ and $B=\\{2,4,6\\},$ determine which of the following statements are true.\n\nI. $(4,b)\\in A\\times B$\n\nII. $(c,6)\\in A\\times B$\n\nIII. $(a,2)\\in A\\times B$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times B,$ we write an ordered pair whose first coordinate is the corresponding element of $A$ and the second coordinate is the corresponding element of $B$ at each intersection.\n\n![](images/57/57d053cca53046f02201540e655030a37ba8f7a2811e7dc724cf30ca9fd3c072.png)\n\nAccording to our diagram:\n\n- $(4,b)\\notin A\\times B\\,\\times $\n\n- $(c,6)\\in A\\times B\\,✓$\n\n- $(a,2)\\in A\\times B\\,✓$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186287778 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ff2d158-b72e-5569-86c7-85fc65a9a7ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465791} {:answer/id #uuid "a3b90b4c-8e62-5aa7-8f8e-cb62a571d3f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465792}] :answer-field/correct {:answer/id #uuid "a3b90b4c-8e62-5aa7-8f8e-cb62a571d3f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465792} :answer-field/id #uuid "bd280a3c-c906-5fe3-8f4c-0d6440e54a52" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466739} {:answer-field/choices [{:answer/id #uuid "5cf618fb-f1d9-5157-869e-44c19617b53b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465793} {:answer/id #uuid "348072d9-0979-5205-ac87-42ed0966ab1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465794}] :answer-field/correct {:answer/id #uuid "5cf618fb-f1d9-5157-869e-44c19617b53b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465793} :answer-field/id #uuid "0d6a0833-9802-5a22-9828-c3db6be203fe" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466740} {:answer-field/choices [{:answer/id #uuid "4ba3e4bf-4d18-5a8a-84a1-20723bf1e792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465795} {:answer/id #uuid "0601d2a9-f68f-5933-b12f-254bdda37ac3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465796}] :answer-field/correct {:answer/id #uuid "4ba3e4bf-4d18-5a8a-84a1-20723bf1e792" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465795} :answer-field/id #uuid "dcf6a75b-6257-59f5-b617-d2f9962213bf" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466741}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1ec96a4e-9e05-5335-919b-b747e9d81df8" :question/math-academy-id "q-181969" :question/problem "If $A=\\{p,q,r\\}$ and $B=\\{3,5\\},$ which of the following elements belong to $B\\times (A\\times A)?$\n\nI. $(5,(r,p))$\n\nII. $(q,(5,3))$\n\nIII. $(3,q,p)$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times A$ consists of every combination of ${p,q,r}$ with ${p,q,r},$ as shown in the schematic below.\n\n![](images/aa/aad91ef7655fa8a5bf0c9852ee4e5e2166289087a56ac18e932ee3cce17164a0.png)\n\nHence, the set $A\\times A$ is given by\n\n$$\nA\\times A={(p,p),(p,q),(p,r),(q,p),(q,q),(q,r),(r,p),(r,q),(r,r)}.\n$$\n\nNote that \n\n$$\n|A\\times A|=|A|\\cdot |A|=3\\cdot 3=9.\n$$\n\nNow, the Cartesian product\n\n$$\nB\\times (A\\times A)\n$$\n\nconsists of every combination of $B$ and $A\\times A,$ as shown in the schematic below.\n\n![](images/e5/e573cecaa9333e071d980b1b03d65dafadd027506d2c2b9b6e8acfbe15d3be52.png)\n\nNote that \n\n$$\n|B\\times (A\\times A)|=|B|\\cdot |A\\times A|=2\\cdot 9=18.\n$$\n\nFrom the given options, we see that only $(5,(r,p))\\in B\\times (A\\times A).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186287780 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d870ac05-aa32-543b-896b-d5e5e242a31d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465797} {:answer/id #uuid "4cb18d13-5d67-536d-881f-b7a1f61912da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465798}] :answer-field/correct {:answer/id #uuid "4cb18d13-5d67-536d-881f-b7a1f61912da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465798} :answer-field/id #uuid "60c5fad1-a10a-5ff0-8129-22378f8c7c32" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466742} {:answer-field/choices [{:answer/id #uuid "b95ce0e3-89a4-5a3b-ac08-c99919b8d07b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465799} {:answer/id #uuid "e536a5e9-8e07-5617-acd0-7ac4ae844c78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465800}] :answer-field/correct {:answer/id #uuid "e536a5e9-8e07-5617-acd0-7ac4ae844c78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465800} :answer-field/id #uuid "21fec834-65d6-5b83-b9e4-46f7a120a351" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466743} {:answer-field/choices [{:answer/id #uuid "80d1ae47-c8b9-5fb0-becf-fa45bf191737" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465801} {:answer/id #uuid "08565eeb-44f5-5fa8-8e13-13b2a761af2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465802}] :answer-field/correct {:answer/id #uuid "80d1ae47-c8b9-5fb0-becf-fa45bf191737" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465801} :answer-field/id #uuid "1caa5482-3fb1-5560-8b4d-7f2ff4ac7696" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466744}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb21c72-0872-5ee1-9c14-274c6c7f743e" :question/math-academy-id "q-181975" :question/problem "![](images/bf/bf1c37a92b184cb3e6c81bbd2d653008f5eff0e3b2131f2f297a336881661c22.png)\n\nUsing the visual schematic above for the Cartesian product ${A}^{2}$ for $A={p,q,r},$ determine which of the following statements are true.\n\n- $(q,q)\\in {A}^{2}$\n- $(p,r)\\in {A}^{2}$\n- ${q}^{2}\\in {A}^{2}$\n\nSelect all that apply." :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product $A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times A,$ we write an ordered pair whose first coordinate is the corresponding element of the first set $(A)$ and the second coordinate is the corresponding element of the second set $(A)$ at each intersection.\n\n![](images/91/919ad6e16dcd1d8f02e8c15c7bd1dfa15f67232c99706dfbc1239e1f9a0f99e5.png)\n\nAccording to our diagram:\n\n- $(q,q)\\in {A}^{2}\\,✓$\n\n- $(p,r)\\in {A}^{2}\\,✓$\n\n- ${q}^{2}\\in {A}^{2}\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""}]}
