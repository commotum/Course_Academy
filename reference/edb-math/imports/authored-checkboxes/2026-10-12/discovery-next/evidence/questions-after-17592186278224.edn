b/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465706} :answer-field/id #uuid "8cf450dd-4897-5b1e-9657-893a77353610" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e2347db-9785-54d2-a2a4-893dc1f56ec9" :question/math-academy-id "q-181545" :question/problem "To which of the following sets does the number $\\frac{1}{\\pi }$ belong?\n- **I.** $Z$\n- **II.** ${Q}^{+}$\n- **III.** $Q$\n- **IV.** $R$\n\nSelect all that apply." :question/worked-solution "The number $\\frac{1}{\\pi }$ is not an integer nor a rational number. Consequently, $\\frac{1}{\\pi }$ does not belong to any of the sets $Z,$ ${Q}^{+},$ nor $Q.$\n\nHowever, $\\frac{1}{\\pi }$ is a real number, so it belongs to $R.$\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186287711 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e66879a4-1b75-5a88-a6ed-8fd6b85adfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465707} {:answer/id #uuid "b124f68f-e11a-5d13-98fd-6cd7c6495d66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465708}] :answer-field/correct {:answer/id #uuid "e66879a4-1b75-5a88-a6ed-8fd6b85adfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465707} :answer-field/id #uuid "c58505ee-a2eb-5ef9-a59f-889021a87c1f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466697} {:answer-field/choices [{:answer/id #uuid "2fb3f744-7da3-5c78-b89d-4d9935948f84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465709} {:answer/id #uuid "79d4d4fb-d69d-5e32-879f-114865bffeea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465710}] :answer-field/correct {:answer/id #uuid "79d4d4fb-d69d-5e32-879f-114865bffeea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465710} :answer-field/id #uuid "53a9bd3e-fc5a-5844-96ef-c1f2e66eb639" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466698} {:answer-field/choices [{:answer/id #uuid "0681701b-55c9-5869-9306-a71407cc8926" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465711} {:answer/id #uuid "8fd43f80-91a0-5407-9c1f-e8915729ef6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465712}] :answer-field/correct {:answer/id #uuid "8fd43f80-91a0-5407-9c1f-e8915729ef6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465712} :answer-field/id #uuid "f74b3081-1eb9-565f-8bd6-2009091835f1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b09e4d7d-54df-5b2a-b13d-108c786b3198" :question/math-academy-id "q-181643" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{x-1})\\,:\\,n\\in {N}_{0}}$\n\n- **II.** $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{-2x})\\,:\\,n\\in {N}_{0}}$\n\n- **III.** $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({e}^{x/2})\\,:\\,n\\in {N}_{0}}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & ={e}^{x-1} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x-1})={e}^{x-1} \\\\ ⋮\\end{aligned}\n$$\n\nThus, $A$ contains only one element:\n\n$$\nA={{e}^{x-1}}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & ={e}^{-2x} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{-2x})=-2{e}^{-2x} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2{e}^{-2x})=4{e}^{-2x} \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4{e}^{-2x})=-8{e}^{-2x} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={{e}^{-2x},-2{e}^{-2x},4{e}^{-2x},-8{e}^{-2x},…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & ={e}^{x/2} \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({e}^{x/2})=\\frac{1}{2}{e}^{x/2} \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{e}^{x/2})=\\frac{1}{4}{e}^{x/2} \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{4}{e}^{x/2})=\\frac{1}{8}{e}^{x/2} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC={{e}^{x/2},\\frac{1}{2}{e}^{x/2},\\frac{1}{4}{e}^{x/2},\\frac{1}{8}{e}^{x/2},…}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287712 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0608f7d5-cb5d-5c12-9904-be67e454cb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465713} {:answer/id #uuid "b5e2376b-22de-5207-8959-882360f31747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465714}] :answer-field/correct {:answer/id #uuid "b5e2376b-22de-5207-8959-882360f31747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465714} :answer-field/id #uuid "9a9244d4-ca29-5b09-ad60-1f882ad66970" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466700} {:answer-field/choices [{:answer/id #uuid "0c75b4b6-2e79-52bd-a819-8ed4e83fe956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465715} {:answer/id #uuid "e095a3ae-0bbe-5338-98a3-f4b4bf7e6dc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465716}] :answer-field/correct {:answer/id #uuid "0c75b4b6-2e79-52bd-a819-8ed4e83fe956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465715} :answer-field/id #uuid "b765a2fa-7d98-5023-a0f1-a961bd05dc4d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466701} {:answer-field/choices [{:answer/id #uuid "666b4d37-5ccf-50da-8f1a-4bedddc9892b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465717} {:answer/id #uuid "576fb5f4-86dc-5c68-9abb-6fb175b7ba2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465718}] :answer-field/correct {:answer/id #uuid "576fb5f4-86dc-5c68-9abb-6fb175b7ba2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465718} :answer-field/id #uuid "fec2b8b6-edfa-5cfb-9457-1478e9b90ba5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466702}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "614d2565-08b2-5cdc-9df9-02ccb7032ebd" :question/math-academy-id "q-181650" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A=\\{{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{cos}⁡2x)\\,:\\,n\\in {N}_{0}\\}$\n\n- **II.** $B=\\{{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(-\\operatorname{sin}⁡x)\\,:\\,n\\in {N}_{0}\\}$\n\n- **III.** $C=\\{{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{sec}⁡x)\\,:\\,n\\in {N}_{0}\\}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\operatorname{cos}⁡2x \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡2x)=-2\\operatorname{sin}⁡2x \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-2\\operatorname{sin}⁡2x)=-4\\operatorname{cos}⁡2x \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-4\\operatorname{cos}⁡2x)=8\\operatorname{sin}⁡2x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA=\\{\\operatorname{cos}⁡2x,-2\\operatorname{sin}⁡2x,-4\\operatorname{cos}⁡2x,8\\operatorname{sin}⁡2x,…\\}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =-\\operatorname{sin}⁡x \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{sin}⁡x)=-\\operatorname{cos}⁡x \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{cos}⁡x)=\\operatorname{sin}⁡x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x)=\\operatorname{cos}⁡x \\\\ {g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)=-\\operatorname{sin}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, $B$ contains four elements:\n\n$$\nB=\\{-\\operatorname{sin}⁡x,-\\operatorname{cos}⁡x,\\operatorname{sin}⁡x,\\operatorname{cos}⁡x\\}\n$$\n\nConsequently, $|B|=4,$ which is finite.\n\n- The set $C$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =\\operatorname{sec}⁡x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x)=\\operatorname{sec}⁡x\\operatorname{tan}⁡x \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)=2{sec}^{3}⁡x-\\operatorname{sec}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nC=\\{\\operatorname{sec}⁡x,\\operatorname{sec}⁡x\\operatorname{tan}⁡x,2{sec}^{3}⁡x-\\operatorname{sec}⁡x,…\\}\n$$\n\nConsequently, $C$ is infinite.\n\nTherefore, the correct answer is \"$A$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287713 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf41930a-e02a-5bf1-999e-558be53fd1b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465719} {:answer/id #uuid "a0fb9b89-a596-5bd6-95f2-b8f58bc9a715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465720}] :answer-field/correct {:answer/id #uuid "a0fb9b89-a596-5bd6-95f2-b8f58bc9a715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465720} :answer-field/id #uuid "5db97015-4657-5b3a-8988-5a1cda4af5a1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466703} {:answer-field/choices [{:answer/id #uuid "24ab02f8-3072-57d1-91ef-e9494c550f1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465721} {:answer/id #uuid "ec147f98-965d-5f68-a749-c182da54c5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465722}] :answer-field/correct {:answer/id #uuid "ec147f98-965d-5f68-a749-c182da54c5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465722} :answer-field/id #uuid "fc5c70be-94f5-5cab-b793-286375bde231" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466704} {:answer-field/choices [{:answer/id #uuid "2ef7ac6b-6eac-5c02-937f-1eec66fbc7bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465723} {:answer/id #uuid "39a94884-0c74-5050-932d-8ceb38c13403" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465724}] :answer-field/correct {:answer/id #uuid "2ef7ac6b-6eac-5c02-937f-1eec66fbc7bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465723} :answer-field/id #uuid "58e26f0a-758a-5de5-99e7-f577b7dad806" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466705}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "135e3cdb-fb83-5539-93de-65d28076eb80" :question/math-academy-id "q-181652" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{tan}⁡x)\\,:\\,n\\in {N}_{0}}$\n\n- **II.** $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\operatorname{sin}⁡3x)\\,:\\,n\\in {N}_{0}}$\n\n- **III.** $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(3\\operatorname{sin}⁡x)\\,:\\,n\\in {N}_{0}}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\operatorname{tan}⁡x \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tan}⁡x)={sec}^{2}⁡x \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}({sec}^{2}⁡x)=2{sec}^{2}⁡x\\operatorname{tan}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\operatorname{tan}⁡x,{sec}^{2}⁡x,2{sec}^{2}⁡x\\operatorname{tan}⁡x,…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is also infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & =\\operatorname{sin}⁡3x \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡3x)=3\\operatorname{cos}⁡3x \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{cos}⁡3x)=-9\\operatorname{sin}⁡3x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-9\\operatorname{sin}⁡3x)=-27\\operatorname{cos}⁡3x \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nB={\\operatorname{sin}⁡3x,3\\operatorname{cos}⁡3x,-9\\operatorname{sin}⁡3x,-27\\operatorname{cos}⁡3x,…}\n$$\n\nConsequently, $B$ is infinite.\n\n- The set $C$ is finite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =3\\operatorname{sin}⁡x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{sin}⁡x)=3\\operatorname{cos}⁡x \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{cos}⁡x)=-3\\operatorname{sin}⁡x \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{sin}⁡x)=-3\\operatorname{cos}⁡x \\\\ {h}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-3\\operatorname{cos}⁡x)=3\\operatorname{sin}⁡x \\\\ ⋮\\end{aligned}\n$$\n\nThus, $C$ contains four elements:\n\n$$\nC={3\\operatorname{sin}⁡x,3\\operatorname{cos}⁡x,-3\\operatorname{sin}⁡x,-3\\operatorname{cos}⁡x}\n$$\n\nConsequently, $|C|=4,$ which is finite.\n\nTherefore, the correct answer is \"$A$ and $B$ only.\""}] [{:db/id #edb/ref 17592186287717 :knowledge-point/_questions [{:db/id #edb/ref 17592186198270 :knowledge-point/id #uuid "f98332fd-e902-5390-a4d3-4e181ce97219" :knowledge-point/title "Sets Defined Using Trigonometric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b94f21d0-5e54-5edd-baec-d9f48bcdab86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465725} {:answer/id #uuid "ae7bf46a-7534-57ed-aceb-0f77531a6457" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465726}] :answer-field/correct {:answer/id #uuid "ae7bf46a-7534-57ed-aceb-0f77531a6457" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465726} :answer-field/id #uuid "99e37b7b-818e-5974-801b-fd031d7cbb83" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466706} {:answer-field/choices [{:answer/id #uuid "44a5efb7-1fa9-58d1-9069-bc4d65f3a8bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465727} {:answer/id #uuid "f1013003-73cb-5fa3-874b-09ec14a45627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465728}] :answer-field/correct {:answer/id #uuid "f1013003-73cb-5fa3-874b-09ec14a45627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465728} :answer-field/id #uuid "c6e5f9d6-52f1-52e7-8319-ee534992b5b5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466707} {:answer-field/choices [{:answer/id #uuid "3ba4ff08-65ed-5768-8f3f-8677696b54ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465729} {:answer/id #uuid "59ae32af-e995-5ede-8b65-1ba1024870be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465730}] :answer-field/correct {:answer/id #uuid "59ae32af-e995-5ede-8b65-1ba1024870be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465730} :answer-field/id #uuid "5c50bf96-efa0-547e-93df-8bc9bcbb722e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f218f2c-c350-5f75-a74b-659b486077d2" :question/math-academy-id "q-181674" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A={n\\in Z\\,:\\,\\operatorname{tan}⁡(\\frac{n\\pi }{2})=0}$\n\n- **II.** $B={q\\in Q\\,:\\,\\operatorname{tan}⁡(\\frac{q\\pi }{2})=0}$\n\n- **III.** $C={x\\in R\\,:\\,\\operatorname{tan}⁡(\\frac{x\\pi }{2})=0}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by finding the solutions to the equation $\\operatorname{tan}⁡(\\frac{x\\pi }{2})=0$ for $x\\in R:$\n\n$$\n\\begin{aligned}\\frac{x\\pi }{2} & =m\\pi  \\\\ x & =2m,\\,m\\in Z\\end{aligned}\n$$\n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is infinite. Listing the elements of $B$ for different values of $m,$ we have\n\n$$\nA={…,-2,0,2,4,…}.\n$$\n\n- The set $B$ is infinite. Since $A$ is infinite, and $A⊆B,$ it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊆C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$A,$ $B,$ and $C.$\""}] [{:db/id #edb/ref 17592186287731 :knowledge-point/_questions [{:db/id #edb/ref 17592186198271 :knowledge-point/id #uuid "26758016-ed47-562a-9338-85c71ffbeaa9" :knowledge-point/title "Sets Defined Using Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e96d9ecf-7714-57a9-822a-673f4c37e00b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465731} {:answer/id #uuid "d06c5adc-b6e6-5661-aa46-fe0af05aca05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465732}] :answer-field/correct {:answer/id #uuid "d06c5adc-b6e6-5661-aa46-fe0af05aca05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465732} :answer-field/id #uuid "8d1f3fcf-a637-52be-a4cc-f4d0d0495ce9" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466709} {:answer-field/choices [{:answer/id #uuid "86b58cb3-b8af-5ab4-a0b2-cd7710728247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465733} {:answer/id #uuid "87fba519-d6d9-503f-9d6d-bb77aaa0872a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465734}] :answer-field/correct {:answer/id #uuid "86b58cb3-b8af-5ab4-a0b2-cd7710728247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465733} :answer-field/id #uuid "69a01e8f-100d-5baa-929b-6c8ad68c2833" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466710} {:answer-field/choices [{:answer/id #uuid "4c4d0d40-f6f1-57b6-851c-5449892b4591" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465735} {:answer/id #uuid "e198b1e1-2401-5091-8cd1-9ee577cd7313" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465736}] :answer-field/correct {:answer/id #uuid "4c4d0d40-f6f1-57b6-851c-5449892b4591" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465735} :answer-field/id #uuid "57b3697b-3114-5d98-939c-b7a32b8a561a" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c54f5b27-abdd-5f0e-891e-7fb28f946241" :question/math-academy-id "q-181702" :question/problem "Which of the following sets are infinite?\n- **A.** $A={{f}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(\\frac{1}{x})\\,:\\,n\\in {N}_{0}}$\n- **B.** $B={{g}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}({x}^{3})\\,:\\,n\\in {N}_{0}}$\n- **C.** $C={{h}^{(n)}(x)=\\frac{{\\text{d}}^{n}}{\\text{d}{x}^{n}}(4x)\\,:\\,n\\in {N}_{0}}$\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\n- The set $A$ is infinite. Listing the first few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{f}^{(0)}(x) & =\\frac{1}{x} \\\\ {f}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x})=-\\frac{1}{{x}^{2}} \\\\ {f}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(-\\frac{1}{{x}^{2}})=\\frac{2}{{x}^{3}} \\\\ {f}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{3}})=-\\frac{6}{{x}^{4}} \\\\ ⋮\\end{aligned}\n$$\n\nThus, we can write our set as follows:\n\n$$\nA={\\frac{1}{x},-\\frac{1}{{x}^{2}},\\frac{2}{{x}^{3}},-\\frac{6}{{x}^{4}},…}\n$$\n\nConsequently, $A$ is infinite.\n\n- The set $B$ is finite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{g}^{(0)}(x) & ={x}^{3} \\\\ {g}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{3})=3{x}^{2} \\\\ {g}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2})=6x \\\\ {g}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(6x)=6 \\\\ {g}^{(4)}(x) & =\\frac{\\text{d}}{\\text{d}x}(6)=0 \\\\ {g}^{(5)}(x) & =\\frac{\\text{d}}{\\text{d}x}(0)=0 \\\\  & ⋮\\end{aligned}\n$$\n\nThus, for $n>4,$ we have ${g}^{(n)}(x)=0.$ Listing a few elements of our set, we have the following:\n\n$$\nB={{x}^{3},3{x}^{2},6x,6,0}.\n$$\n\nConsequently, $|B|=5,$ which is finite.\n\n- The set $C$ is also finite. Listing a few elements of our set, we have the following:\n\n$$\n\\begin{aligned}{h}^{(0)}(x) & =4x \\\\ {h}^{(1)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4x)=4 \\\\ {h}^{(2)}(x) & =\\frac{\\text{d}}{\\text{d}x}(4)=0 \\\\ {h}^{(3)}(x) & =\\frac{\\text{d}}{\\text{d}x}(0)=0 \\\\  & ⋮\\end{aligned}\n$$\n\nThus, for $n>2,$ we have ${h}^{(n)}(x)=0.$ Listing a few elements of our set, we have the following:\n\n$$\nC={4x,4,0}.\n$$\n\nConsequently, $|C|=3,$ which is finite.\n\nTherefore, the correct answer is \"$A$ only.\""}] [{:db/id #edb/ref 17592186287739 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf2d933e-6eb0-5fb1-bf15-67aeefdd4b2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465737} {:answer/id #uuid "9f04a384-f0fa-5c18-a774-4cd27400a481" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465738}] :answer-field/correct {:answer/id #uuid "cf2d933e-6eb0-5fb1-bf15-67aeefdd4b2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465737} :answer-field/id #uuid "ab754d30-b852-5c49-84f3-8445f774b356" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466712} {:answer-field/choices [{:answer/id #uuid "33176e83-624c-56ff-9ba8-9f19dce9730e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465739} {:answer/id #uuid "3b2f5944-ebba-5181-8894-cad0c1f37ecb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465740}] :answer-field/correct {:answer/id #uuid "3b2f5944-ebba-5181-8894-cad0c1f37ecb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465740} :answer-field/id #uuid "d8c56fa1-66f0-51ea-9b21-4a939161db2f" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466713} {:answer-field/choices [{:answer/id #uuid "9a8dee3a-52b1-5a24-a95a-d98bf35b5ed4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465741} {:answer/id #uuid "93d8acd7-5524-5784-82fa-11603191f37f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465742}] :answer-field/correct {:answer/id #uuid "93d8acd7-5524-5784-82fa-11603191f37f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465742} :answer-field/id #uuid "ec1c418d-2c72-5f76-99e8-47f81457b301" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4302dd15-6000-5073-b484-7b81fc84a4c7" :question/math-academy-id "q-181719" :question/problem "Which of the following sets are infinite?\n- **A.** $A={n\\in Z\\,:\\,|3n|<10}$\n- **B.** $B={q\\in Q\\,:\\,|3q|<10}$\n- **C.** $C={x\\in R\\,:\\,|3x|<10}$\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nWe start by solving the following inequality for $x\\in R:$\n\n$$\n\\begin{aligned}|3x|<10 \\\\ 3|x|<10 \\\\ |x|<\\frac{10}{3}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n-\\frac{10}{3}<x<\\frac{10}{3}\n$$\n\nand can be expressed as $x\\in I=(-\\frac{10}{3},\\frac{10}{3}).$ \n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality $|3n|<10$ are all the integers that lie in the interval $I.$ Therefore, \n\n$$\nA={-3,-2,-1,0,1,2,3}.\n$$\n\nConsequently, $|A|=7,$ which is finite.\n\n- The set $B$ is infinite. If $q\\in Q,$ the solutions to $|3q|<10$ are all the rational numbers that lie in the interval $I.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊂C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287740 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93d03e0e-502c-5cf6-8f99-c2b823108eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465743} {:answer/id #uuid "e418077e-7d50-5cb7-b829-c913947cfafe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465744}] :answer-field/correct {:answer/id #uuid "93d03e0e-502c-5cf6-8f99-c2b823108eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465743} :answer-field/id #uuid "a71a4e03-d01c-5e0e-8320-06b9e0e37a1a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466715} {:answer-field/choices [{:answer/id #uuid "1d369ca3-2821-5dfe-9d8c-a2f76efe897f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465745} {:answer/id #uuid "f197ba5d-7995-5b5b-a9dc-aa0de38208e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465746}] :answer-field/correct {:answer/id #uuid "f197ba5d-7995-5b5b-a9dc-aa0de38208e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465746} :answer-field/id #uuid "08a98902-2008-57a3-bcd4-46d667690af2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466716} {:answer-field/choices [{:answer/id #uuid "02388017-fadd-5442-9d9f-e050b3cb4849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465747} {:answer/id #uuid "c596ff24-f2d0-5b0a-a22a-8ef0e12e5766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465748}] :answer-field/correct {:answer/id #uuid "c596ff24-f2d0-5b0a-a22a-8ef0e12e5766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465748} :answer-field/id #uuid "368ba6fb-7e46-5bb9-b314-8ee27d527e12" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466717}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4290422-629b-5741-89bd-a435f41aa909" :question/math-academy-id "q-181721" :question/problem "Which of the following sets are infinite?\n\nSelect all that apply.\n\n- **I.** $A={n\\in Z\\,:\\,|5n|\\le 4}$\n\n- **II.** $B={q\\in Q\\,:\\,|5q|\\le 4}$\n\n- **III.** $C={x\\in R\\,:\\,|5x|\\le 4}$" :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements.\n\nWe start by solving the following inequality for $x\\in R:$\n\n$$\n\\begin{aligned}|5x|\\le 4 \\\\ 5|x|\\le 4 \\\\ |x|\\le \\frac{4}{5}\\end{aligned}\n$$\n\nwhich gives\n\n$$\n-\\frac{4}{5}\\le x\\le \\frac{4}{5}\n$$\n\nand can be expressed as $x\\in I=[-\\frac{4}{5},\\frac{4}{5}].$ \n\nWith that in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality $|5n|\\le 4$ are all the integers that lie in the interval $I.$ Therefore, \n\n$$\nA={0}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. If $q\\in Q,$ the solutions to $|5q|\\le 4$ are all the rational numbers that lie in the interval $I.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $B$ is infinite.\n\n- The set $C$ is infinite. Since $B$ is infinite, and $B⊂C,$ it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287742 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "687006ca-b467-5257-b506-6521a2f3c1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465749} {:answer/id #uuid "025060ed-b0b8-5b05-9be6-f50b5c14cf4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465750}] :answer-field/correct {:answer/id #uuid "687006ca-b467-5257-b506-6521a2f3c1d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465749} :answer-field/id #uuid "8b2d7d0a-51d9-5b11-a273-ffed598e7c00" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466718} {:answer-field/choices [{:answer/id #uuid "e90fd4ed-8544-5c9f-afcd-f1eefd009373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465751} {:answer/id #uuid "a421f7bb-9efe-5882-aeae-5224bbf3feca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465752}] :answer-field/correct {:answer/id #uuid "a421f7bb-9efe-5882-aeae-5224bbf3feca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465752} :answer-field/id #uuid "306868ed-d295-5f05-820e-86fdee835261" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466719} {:answer-field/choices [{:answer/id #uuid "cc403ef8-d256-50ab-a699-aa8aec80aeab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465753} {:answer/id #uuid "30712c67-9f15-5e3a-8d4f-5a0d775bebd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465754}] :answer-field/correct {:answer/id #uuid "30712c67-9f15-5e3a-8d4f-5a0d775bebd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465754} :answer-field/id #uuid "c9fadef4-53b6-502b-8f03-0207bd49061b" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466720}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6d13915-d6fa-5b7a-8103-f1358e92b8fa" :question/math-academy-id "q-181740" :question/problem "Which of the following sets are infinite?\n- **A.** $A={n\\in Z\\,:\\,-{n}^{2}+1>0}$\n- **B.** $B={m\\in Z\\,:\\,-{m}^{2}+1<0}$\n- **C.** $C={q\\in Q\\,:\\,-{q}^{2}+1<0}$\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y=-{x}^{2}+1$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}-{x}^{2}+1 & =0 \\\\ -({x}^{2}-1) & =0 \\\\ -(x-1)(x+1) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=-1$ and $x=1,$ and we can graph the parabola as follows:\n\n![](images/06/0699524ff20f871c9eeca93faa9934832b8e5816fd23b46862e8b01d48e7d86b.png)\n\nTherefore:\n\n- The solution to the inequality $-{x}^{2}+1>0$ for $x\\in R$ is \n\n$$\n-1<x<1\n$$\n\nand can be expressed as $x\\in {I}_{1}=(-1,1).$\n\n- Similarly, the solution to the inequality $-{x}^{2}+1<0$ for $x\\in R$ is \n\n$$\nx<-1\\,\\text{or}\\,x>1\n$$\n\nand can be expressed as $x\\in {I}_{2}=(-\\infty ,-1)\\cup (1,\\infty ).$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality $-{n}^{2}+1>0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={0}.\n$$\n\nConsequently, $|A|=1,$ which is finite.\n\n- The set $B$ is infinite. If $m\\in Z,$ the solutions to the inequality $-{m}^{2}+1<0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={…,-3,-2}\\cup {2,3,…}.\n$$\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to $-{q}^{2}+1<0$ are all the rational numbers that lie in the interval ${I}_{2}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287748 :knowledge-point/_questions [{:db/id #edb/ref 17592186198269 :knowledge-point/id #uuid "efdb77bf-dd8b-5ccc-8265-79bd319afaa3" :knowledge-point/title "Sets Defined Using Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a11e464-5b81-5a5d-ab33-174d180e5676" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465755} {:answer/id #uuid "d5226a43-9438-5852-9604-7b3cb021c1d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465756}] :answer-field/correct {:answer/id #uuid "9a11e464-5b81-5a5d-ab33-174d180e5676" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465755} :answer-field/id #uuid "a3bfe522-6405-5c12-901c-0ba3ee58cc27" :answer-field/key "A" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466721} {:answer-field/choices [{:answer/id #uuid "caea5d4e-662c-5c13-87c9-f36ce9063c63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465757} {:answer/id #uuid "64fb6540-8172-51b0-8f52-e578e8676119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465758}] :answer-field/correct {:answer/id #uuid "64fb6540-8172-51b0-8f52-e578e8676119" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465758} :answer-field/id #uuid "6ca5abb3-3d7d-57fa-a86f-82fd72eb2708" :answer-field/key "B" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466722} {:answer-field/choices [{:answer/id #uuid "2eee014d-caf2-5ad8-b518-99bf2d43504a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465759} {:answer/id #uuid "ab5ab638-7bc0-5178-813c-8e97eb5ee8c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465760}] :answer-field/correct {:answer/id #uuid "ab5ab638-7bc0-5178-813c-8e97eb5ee8c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465760} :answer-field/id #uuid "c0a8bbfb-4146-506f-a0e4-187c3da006bd" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466723}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "29b1f7f7-72db-5315-ae82-b2adaab04321" :question/math-academy-id "q-181768" :question/problem "Which of the following sets are infinite?\n- **A.** $A={n\\in Z\\,:\\,{n}^{2}-2n\\le 0}$\n- **B.** $B={m\\in Z\\,:\\,{m}^{2}-2m\\ge 0}$\n- **C.** $C={q\\in Q\\,:\\,{q}^{2}-2q\\le 0}$\n\nSelect all that apply." :question/worked-solution "The cardinality of a finite set is the number of elements contained within it. A set is infinite if it has infinitely many elements. \n\nLet's start by analyzing the parabola $y={x}^{2}-2x$ for $x\\in R.$\n\nFirst, we find the roots of the parabola:\n\n$$\n\\begin{aligned}{x}^{2}-2x & =0 \\\\ x(x-2) & =0\\end{aligned}\n$$\n\nSo, the roots are $x=0$ and $x=2,$ and we can graph the parabola as follows:\n\n![](images/49/496c6d53993ca6cae499f617bca42dbc42e4c57bffa278da6312a5b1723bdcbc.png)\n\nTherefore:\n\n- The solution to the inequality ${x}^{2}-2x\\le 0$ for $x\\in R$ is \n\n$$\n0\\le x\\le 2\n$$\n\nand can be expressed as $x\\in {I}_{1}=[0,2].$\n\n- Similarly, the solution to the inequality ${x}^{2}-2x\\ge 0$ for $x\\in R$ is \n\n$$\nx\\le 0\\,\\text{or}\\,x\\ge 2\n$$\n\nand can be expressed as $x\\in {I}_{2}=(-\\infty ,0]\\cup [2,\\infty ).$\n\nWith these in mind, let's examine our sets:\n\n- The set $A$ is finite. If $n\\in Z,$ the solutions to the inequality ${n}^{2}-2n\\le 0$ are all the integers that lie in the interval ${I}_{1}.$ Therefore,\n\n$$\nA={0,1,2}.\n$$\n\nConsequently, $|A|=3,$ which is finite.\n\n- The set $B$ is infinite. If $m\\in Z,$ the solutions to the inequality ${m}^{2}-2m\\ge 0$ are all the integers that lie in the interval ${I}_{2}.$ Therefore,\n\n$$\nB={…,-1,0}\\cup {2,3,…}.\n$$\n\n- The set $C$ is infinite. If $q\\in Q,$ the solutions to ${q}^{2}-2q\\le 0$ are all the rational numbers that lie in the interval ${I}_{1}.$ Since any real interval of nonzero length contains infinitely many rational numbers, it follows that $C$ is infinite.\n\nTherefore, the correct answer is \"$B$ and $C$ only.\""}] [{:db/id #edb/ref 17592186287770 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a15d8068-a297-5b27-9571-7349edb98145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465761} {:answer/id #uuid "50699285-bf28-54d7-83ab-33d95b70f1dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465762}] :answer-field/correct {:answer/id #uuid "50699285-bf28-54d7-83ab-33d95b70f1dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465762} :answer-field/id #uuid "f6e4a31d-6892-5f31-9c96-e11ca818307e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466724} {:answer-field/choices [{:answer/id #uuid "857215ce-87c7-5d52-b667-daa2294c53fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465763} {:answer/id #uuid "d620ca5c-7969-5245-beb2-5c9f3507de3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465764}] :answer-field/correct {:answer/id #uuid "d620ca5c-7969-5245-beb2-5c9f3507de3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465764} :answer-field/id #uuid "ed6bc72c-bbdd-5c3c-817f-ec5f93dbd78d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466725} {:answer-field/choices [{:answer/id #uuid "c10f6fae-2c1c-5519-902a-f8a1bbc36128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465765} {:answer/id #uuid "fd632de3-82a9-5dc9-9c61-6bd9d87107fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465766}] :answer-field/correct {:answer/id #uuid "c10f6fae-2c1c-5519-902a-f8a1bbc36128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465765} :answer-field/id #uuid "8212bee8-04d9-5d5d-ad9b-4facf1dc8f94" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466726}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5ba42f9-2582-56fd-9cc1-974b79efc1dd" :question/math-academy-id "q-181941" :question/problem "If $A={a,b}$ and $B={1,2},$ which of the following elements belong to $A\\times A\\times B?$\n- **I.** $(a,a,1)$\n- **II.** $(b,a,2)$\n- **III.** $((a,b),2)$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times A\\times B$ consists of every combination of ${a,b}$ with ${a,b}$ and ${1,2},$ which results in\n\n$$\n\\begin{aligned}A\\times A\\times B={ & (a,a,1),(a,a,2),(a,b,1),(a,b,2), \\\\  & (b,a,1),(b,a,2),(b,b,1),(b,b,2)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times A\\times B|=|A|\\cdot |A|\\cdot |B|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that both $(a,a,1)$ and $(b,a,2)$ are in $A\\times A\\times B.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186287771 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a46bf5c6-d6fe-5e42-af86-ce7600ded59e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465767} {:answer/id #uuid "e32e199d-4753-5a7e-9c53-1be55160b642" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465768}] :answer-field/correct {:answer/id #uuid "a46bf5c6-d6fe-5e42-af86-ce7600ded59e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465767} :answer-field/id #uuid "ca389aa0-4d8b-5422-93e9-74e7c9056c63" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466727} {:answer-field/choices [{:answer/id #uuid "61f781e7-9f4f-5947-9dea-30b3c6a60411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465769} {:answer/id #uuid "92da6a17-19ff-5528-aee1-eb979f83f3c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465770}] :answer-field/correct {:answer/id #uuid "61f781e7-9f4f-5947-9dea-30b3c6a60411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465769} :answer-field/id #uuid "5ed0697c-624f-503f-bf92-0cc49285c227" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466728} {:answer-field/choices [{:answer/id #uuid "5db7bb44-599d-522c-8a9c-70f7761b0faa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465771} {:answer/id #uuid "7925bc94-3461-5a21-a906-5df38787d055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465772}] :answer-field/correct {:answer/id #uuid "7925bc94-3461-5a21-a906-5df38787d055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465772} :answer-field/id #uuid "6a992b8a-876b-5bee-9ebf-93c23fc9cab0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d67a16e-2bb4-53de-83ef-8253a6e9b7e6" :question/math-academy-id "q-181942" :question/problem "If $A={8,9}$ and $B={x,y},$ which of the following elements belong to $A\\times B\\times A?$\n- **I.** $(9,9,y)$\n- **II.** $(8,x,y)$\n- **III.** $(9,y,8)$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times B\\times A$ consists of every combination of ${8,9}$ with ${x,y}$ and ${8,9},$ which results in\n\n$$\n\\begin{aligned}A\\times B\\times A={ & (8,x,8),(8,x,9),(8,y,8),(8,y,9), \\\\  & (9,x,8),(9,x,9),(9,y,8),(9,y,9)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times B\\times A|=|A|\\cdot |B|\\cdot |A|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that only $(9,y,8)\\in A\\times B\\times A.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186287772 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0b9d28-1485-5c9e-a4f1-550d47074461" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465773} {:answer/id #uuid "5190f556-7df5-5fe0-94eb-fe1af949374b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465774}] :answer-field/correct {:answer/id #uuid "2e0b9d28-1485-5c9e-a4f1-550d47074461" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465773} :answer-field/id #uuid "624bbf76-e693-5668-983c-27415f5b5a77" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466730} {:answer-field/choices [{:answer/id #uuid "f1051471-4b31-5629-b9d3-7d004da69bfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465775} {:answer/id #uuid "09bbb16a-73cf-54fd-a524-e56d7c127d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465776}] :answer-field/correct {:answer/id #uuid "09bbb16a-73cf-54fd-a524-e56d7c127d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465776} :answer-field/id #uuid "29bba6fd-8b4d-5083-b3c4-4bf78a71bd42" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466731} {:answer-field/choices [{:answer/id #uuid "65939330-c581-5adf-91aa-d7008716c5f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465777} {:answer/id #uuid "a75c93fc-ce66-55cc-a293-3275a78082d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465778}] :answer-field/correct {:answer/id #uuid "a75c93fc-ce66-55cc-a293-3275a78082d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465778} :answer-field/id #uuid "11e596d7-5bd0-5da8-851e-80e84757e6db" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466732}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3dced42a-f072-5a03-9e98-5ecc099c95d0" :question/math-academy-id "q-181945" :question/problem "If $A={v,w}$ and $B={3,4,5},$ which of the following elements belong to $A\\times B\\times A?$\n- **I.** $(v,4,5)$\n- **II.** $(v,3,w)$\n- **III.** $(w,5,w)$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and the third coordinate belongs to $C.$\n\nIn this case, $A\\times B\\times A$ consists of every combination of ${v,w}$ with ${3,4,5}$ and ${v,w},$ which results in\n\n$$\n\\begin{aligned}A\\times B\\times A={ & (v,3,v),(v,3,w),(v,4,v),(v,4,w),(v,5,v),(v,5,w), \\\\  & (w,3,v),(w,3,w),(w,4,v),(w,4,w),(w,5,v),(w,5,w)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|A\\times B\\times A|=|A|\\cdot |B|\\cdot |A|=2\\cdot 3\\cdot 2=12.\n$$\n\nFrom the given options, we see that both $(v,3,w)$ and $(w,5,w)$ are in $A\\times B\\times A.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186287773 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a80f9fc-05fe-5ace-b2b6-c9c7320d81f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 1759218646577