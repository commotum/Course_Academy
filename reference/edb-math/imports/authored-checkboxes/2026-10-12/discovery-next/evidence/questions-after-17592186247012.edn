ref 17592186461778}] :answer-field/correct {:answer/id #uuid "8e5d6c14-51bd-5018-9283-62587f67196b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461777} :answer-field/id #uuid "6637ca01-1eec-5fbc-b8d7-52e3f75e1383" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462642}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "335e4d6e-44ad-5f4c-9625-f1960ad24196" :question/math-academy-id "q-115880" :question/problem "![](images/bc/bc5b29fca0521e3da39993d0359e857333611c68c35e49c037ca7af031288ba3.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}={y}^{2}(y+4)$\n- ${y}^{′}=(y+1)^{2}(y+4)$\n- ${y}^{′}=-y(y+1)(y+4)$\n\nSelect all that apply." :question/worked-solution "![](images/cd/cd73bc9f35e167537996a3b33b84471dcb8fefe2eccb4afd21ca55a23e6478fd.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $y=-4$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}={y}^{2}(y+4)$ gives the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=-4.$\n\n- The equation ${y}^{′}=(y+1)^{2}(y+4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=-1$ and $y=-4.$\n\n- The equation ${y}^{′}=-y(y+1)(y+4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=-4,$ but it also evaluates to zero when $y=-1,$ which is not behavior exhibited by our slope field.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250501 :knowledge-point/_questions [{:db/id #edb/ref 17592186166857 :knowledge-point/id #uuid "954f8004-35b4-58ec-be26-2beccfd5f8e4" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Equilibrium Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3b28ebd-2da3-54ab-9d77-fc487f69e66b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461779} {:answer/id #uuid "88fb7312-db4e-54ff-92a6-cd4527b5dd20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461780}] :answer-field/correct {:answer/id #uuid "88fb7312-db4e-54ff-92a6-cd4527b5dd20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461780} :answer-field/id #uuid "363e79a8-3fd4-5599-8fe9-4d374c61acaf" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462643} {:answer-field/choices [{:answer/id #uuid "2e853698-7ef8-5248-8f60-ed61f77b54ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461781} {:answer/id #uuid "aa9efb90-7713-5996-a837-d2bba696af8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461782}] :answer-field/correct {:answer/id #uuid "2e853698-7ef8-5248-8f60-ed61f77b54ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461781} :answer-field/id #uuid "0467632c-8d73-5cfc-b4fc-dd1fe9d061a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462644} {:answer-field/choices [{:answer/id #uuid "02a278e1-8a46-57c3-86a0-51641f029c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461783} {:answer/id #uuid "5a66f5b5-c022-5c22-90bc-ab3ce4998343" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461784}] :answer-field/correct {:answer/id #uuid "02a278e1-8a46-57c3-86a0-51641f029c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461783} :answer-field/id #uuid "4d079fd4-b9c4-55e1-881a-039ed58ace65" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5780ba6c-1a2c-5799-b86a-8148f7437eba" :question/math-academy-id "q-115888" :question/problem "![](images/2e/2e2d4b78d8181efc77f65af0c3dc4b3110d0203e650006a0e99d9a8ba933b53f.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-(y-1)(y-4)$\n- ${y}^{′}=y(y-1)(y-4)$\n- ${y}^{′}={y}^{2}(y-1)$\n\nSelect all that apply." :question/worked-solution "![](images/7e/7e207bc990a9dfbafa8474ad13c17482e21c323833be848f4ebbaa580abeb201.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $y=1$ and $y=4,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=-(y-1)(y-4)$ gives the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=4.$\n\n- The equation ${y}^{′}=y(y-1)(y-4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=4,$ but it also evaluates to zero when $y=0,$ which is not behavior exhibited by our slope field.\n\n- The equation ${y}^{′}={y}^{2}(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=1.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id 