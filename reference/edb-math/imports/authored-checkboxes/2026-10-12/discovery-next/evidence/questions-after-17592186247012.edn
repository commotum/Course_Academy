t :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461988} :answer-field/id #uuid "d2cb80f3-bd22-527d-8b69-d6cf9583f235" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462747}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "735542a6-3adb-5150-94ab-7fbabf60bc01" :question/math-academy-id "q-120476" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n- **I.** $\\operatorname{sec}⁡x=\\frac{\\sqrt{2}}{5}$\n- **II.** $\\operatorname{sec}⁡x=\\frac{6}{7}$\n- **III.** $\\operatorname{sec}⁡x=\\frac{1}{3}$\n\nSelect all that apply." :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, equations I, II, and III have no solutions."}] [{:db/id #edb/ref 17592186256411 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "223c445b-9a70-5067-bb3a-73307392586c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461989} {:answer/id #uuid "4aec07be-41ae-55b0-ae3e-0a620cfecd23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461990}] :answer-field/correct {:answer/id #uuid "223c445b-9a70-5067-bb3a-73307392586c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461989} :answer-field/id #uuid "8587961d-9189-5272-9fc9-9e4b89fddda8"