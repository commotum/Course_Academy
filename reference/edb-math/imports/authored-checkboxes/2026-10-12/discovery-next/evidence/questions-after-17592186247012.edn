pe {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462022}] :answer-field/correct {:answer/id #uuid "7e74dce9-fc12-5890-b1ba-090c92c360ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462021} :answer-field/id #uuid "db271adc-484d-5ee6-9806-c7fd21b54d00" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462764} {:answer-field/choices [{:answer/id #uuid "e6228b74-5ee9-5e84-aff0-9ab707e83eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462023} {:answer/id #uuid "6cdb6908-c816-5640-9e06-d159c59a48ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462024}] :answer-field/correct {:answer/id #uuid "6cdb6908-c816-5640-9e06-d159c59a48ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462024} :answer-field/id #uuid "bd923679-cb67-593b-8dca-a5d88dd55567" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462765}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e3e3b1c-0354-523c-88ee-c0560a031e2c" :question/math-academy-id "q-12124" :question/problem "A triangle $S$ has vertices at  $(-2,-1),(1,3),(2,-3).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n- **I.** $(-3,1)$\n- **II.** $(-3,2)$\n- **III.** $(1,-2)$\n\nSelect all that apply." :question/worked-solution "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 & 3 \\\\ -2 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,-2),(-3,1),(3,2).$\n\nSo, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186256537 :knowledge-point/_questions [{:db/id #edb/ref 17592186092223 :knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c5f3b1-bdaf-557c-ac51-ff5fd31112b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462025} {:answer/id #uuid "861319a6-c6db-5433-8213-e3a18c50d19e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462026}] :answer-field/correct {:answer/id #uuid "a7c5f3b1-bdaf-557c-ac51-ff5fd31112b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462025} :answer-field/id #uuid "fbe6f948-2607-53e1-b874-9f8f59ccc40c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462766} {:answer-field/choices [{:answer/id #uuid "4b24f95c-90a3-5a5a-ae57-b4f8a57c59cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462027} {:answer/id #uuid "4229d154-8cb1-504b-8112-ba7ec17b0cc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462028}] :answer-field/correct {:answer/id #uuid "4229d154-8cb1-504b-8112-ba7ec17b0cc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462028} :answer-field/id #uuid "4230d7b5-411d-5c56-9b00-ecef8de6fe1d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462767} {:answer-field/choices [{:answer/id #uuid "769d12c6-3cf7-50a2-8ddf-301bc2d70dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462029} {:answer/id #uuid "eea03a12-a2a2-574c-bea1-9faabb81195f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462030}] :answer-field/correct {:answer/id #uuid "769d12c6-3cf7-50a2-8ddf-301bc2d70dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462029} :answer-field/id #uuid "73bca36e-7821-5911-8789-a8f917b17ccf" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462768}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e2b06a89-3f08-5414-af8f-9530e297c08c" :question/math-academy-id "q-12133" :question/problem "A triangle $S$ has vertices at  $(-2,-4),(1,2),(2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-3\\pi /2}$ by an angle of $\\frac{3\\pi }{2}$ radians about the origin?\n- **I.** $(2,1)$\n- **II.** $(4,-2)$\n- **III.** $(-1,2)$\n\nSelect all that apply." :question/worked-solution "The clockwise rotation ${R}_{-3\\pi /2}$ by an angle of $\\frac{3\\pi }{2}$ radians is the same as counterclockwise rotation by an angle of $\\frac{\\pi }{2}.$ It's given by the matrix\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-3\\pi /2},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 1 & 2 \\\\ -4 & 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-3\\pi /2}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 1 & 2 \\\\ -4 & 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}4 & -2 & 1 \\\\ -2 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(4,-2),(-2,1),(1,2).$\n\nSo, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186256566 :knowledge-point/_questions [{:db/id #edb/ref 17592186092346 :knowledge-point/id #uuid "b2371a64-5e91-5caa-91c0-f6c7ff572c70" :knowledge-point/title "Rotating an Object About the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f8fbca-5f34-5844-9a52-95edb85f8734" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186462031} {:answer/id #uuid "a3ffa875-f647-56a7-9232-10baef0e9478" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462032}] :answer-field/correct {:answer/id #uuid "a3ffa875-f647-56a7-9232-10baef0e9478" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186462032} :answer-field/id #uuid "fae7fe8f-ddd3-552e-8975-6e4558ea14d3" :answer-field/key "I" :answer-field/