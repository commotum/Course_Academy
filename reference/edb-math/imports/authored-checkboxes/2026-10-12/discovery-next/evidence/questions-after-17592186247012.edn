A & =[\\begin{aligned}0 & -5 & 0 \\\\ -5 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}-5 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}-5 & -25 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 5\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 5 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186247261 :knowledge-point/_questions [{:db/id #edb/ref 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f9beaf-0424-5aa2-956d-c07c9eb62b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461677} {:answer/id #uuid "66a00ca0-0b71-5677-9842-8f027893c915" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461678}] :answer-field/correct {:answer/id #uuid "37f9beaf-0424-5aa2-956d-c07c9eb62b20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461677} :answer-field/id #uuid "017cb54c-3b6b-50b1-95d4-f81dad5ee6be" :answer-field/key "A" :