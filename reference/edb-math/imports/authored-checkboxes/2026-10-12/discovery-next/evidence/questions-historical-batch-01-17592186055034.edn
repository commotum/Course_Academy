#{[{:db/id #edb/ref 17592186055034 :knowledge-point/_questions [{:db/id #edb/ref 17592186054819 :knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406" :knowledge-point/title "Identifying Statements Expressed Using Symbols"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28b65e0d-e0ec-5c78-83e7-464d161c710e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186282040} {:answer/id #uuid "981fa0bd-1eab-533b-a3bd-408d47bff141" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186283005} {:answer/id #uuid "bdd70cf2-89b7-5b7d-9e01-1bad692f732d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186283337} {:answer/id #uuid "cdc0aa08-8957-55c6-a911-6a19c3aeab6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186283487} {:answer/id #uuid "d42a75bf-c403-5ab9-a1a6-c356df5be84e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186283540}] :answer-field/correct {:answer/id #uuid "28b65e0d-e0ec-5c78-83e7-464d161c710e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186282040} :answer-field/id #uuid "749096d0-da42-556e-9777-a6ec85e594b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a13c06f-6317-5f54-a60c-2244cd05e4c4" :question/math-academy-id "q-170843" :question/problem "Which of the following are mathematical statements?\n\n- $P:2\\,|\\,4$\n\n- $Q:\\sqrt{2}\\in N$\n\n- $R:2+2$" :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because $2$ divides $4.$\n\n- $Q$ is a statement. This statement is *false* because $\\sqrt{2}$ is not a natural number.\n\n- $R$ is *not* a statement because it is neither true nor false.\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""}] [{:db/id #edb/ref 17592186055035 :knowledge-point/_questions [{:db/id #edb/ref 17592186054819 :knowledge-point/id #uuid "4eda1965-d655-5550-9bb5-13e7a9c1b406" :knowledge-point/title "Identifying Statements Expressed Using Symbols"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b977c97-5651-5521-8e42-8586c819737b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186281942} {:answer/id #uuid "4837ea75-c829-536a-a4b9-0330dad23871" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186282300} {:answer/id #uuid "757a25c4-109e-5e2c-b7d3-4592990f5a43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186282695} {:answer/id #uuid "88befc2b-a69f-5e4c-8302-6401c5b5bd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186282868} {:answer/id #uuid "d980bec9-678b-539f-9be7-a1eec6774c12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186283583}] :answer-field/correct {:answer/id #uuid "88befc2b-a69f-5e4c-8302-6401c5b5bd02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186282868} :answer-field/id #uuid "cb2cb3a4-04dc-56b8-b5b9-48858253e5be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d26247f5-ea0b-58f7-ab8c-9e2873f56e29" :question/math-academy-id "q-170844" :question/problem "Which of the following are mathematical statements?\n\n- $P:{1,2,3}\\cap {4,5,6}=∅$\n\n- $Q:\\sqrt{{3}^{2}-{4}^{2}}$\n\n- $R:4$ is a prime number." :question/worked-solution "A mathematical statement is a sentence or mathematical expression that is either true or false.\n\nWith that in mind, let's examine the given options:\n\n- $P$ is a statement. This statement is *true* because the intersection of the given sets is empty.\n\n- $Q$ is *not* a statement because it is neither true nor false.\n\n- $R$ is a statement. This statement is *false* since $4$ is not prime.\n\nTherefore, the correct answer is \"$P$ and $R$ only.\""}] [{:db/id #edb/ref 17592186055044 :knowledge-point/_questions [{:db/id #edb/ref 17592186054820 :knowledge-point/id #uuid "35eba041-5109-5855-b132-174c0271c168" :knowledge-point/title "Identifying Predicates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b66c561-2d7c-52e3-937c-7c67a5e4c9bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186281795} {:answer/id #uuid "8f92b8fc-c666-5069-b9ed-7cca08c7478a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186282933} {:answer/id #uuid "9168ac28-6e40-58c9-bed3-110b24af01c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186282948} {:answer/id #uuid "ae15b0f1-3036-51bd-baa5-b49cc5514bd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186283194} {:answer/id #uuid "baeeb572-5d5f-5a04-9e96-fb8e01c8b8d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283302}] :answer-field/correct {:answer/id #uuid "ae15b0f1-3036-51bd-baa5-b49cc5514bd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186283194} :answer-field/id #uuid "880dbba7-c9a6-57c2-abf2-7f956c2c632b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284170}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5327827-bdd3-59f2-8ac3-6f2fcb1af21e" :question/math-academy-id "q-171486" :question/problem "Which of the following are mathematical predicates of one variable?\n\n- $P(n):$ $n$ is even.\n- $Q(x):$ ${x}^{2}-x\\ge 1$\n- $R(y):$ Draw a line of width $y\\,\\text{cm}.$" :question/worked-solution "A *predicate* of one variable is a sentence that contains the variable defined on some *universal set* and has the property that when we substitute any concrete value of the variable into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate. Substituting a concrete value for $n$ into the sentence, we get a statement that is either true or false.\n\n- Option II is a predicate. Substituting a concrete value for $x$ into the sentence, we get a statement that is either true or false.\n\n- Option III is *not* a predicate. Substituting a concrete value for $y$ into the sentence, we do not get a statement that is either true or false. Rather, it will give an instruction.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186055071 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2316f533-0e7d-5b77-a8dd-d9c80337923d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186285102} {:answer/id #uuid "2c25e9a3-12f8-5ff9-b8bc-23630a88a7fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186285174} {:answer/id #uuid "5b3b07df-dd5d-5565-a9c1-e98ca207f466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285623} {:answer/id #uuid "97d4e979-a44a-50ce-9b33-412cccd7bc2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186286174} {:answer/id #uuid "d6189dc5-6bc6-5726-a93c-14409fffef6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186286735}] :answer-field/correct {:answer/id #uuid "5b3b07df-dd5d-5565-a9c1-e98ca207f466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285623} :answer-field/id #uuid "864bb7c7-2e83-595f-ad2e-7f0fc29c9ab4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "59457bab-d41c-5c4d-af91-59c9dc67dad9" :question/math-academy-id "q-181294" :question/problem "If $A=\\{0,1,2\\}$ and $B=\\{x,y\\},$ which of the following elements belong to $(A\\times B)\\times A?$\n\nI. $(1,y,2)$\n\nII. $((1,y),2)$\n\nIII. $((y,1),y)$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times B$ consists of every combination of ${0,1,2}$ with ${x,y},$ as shown in the schematic below.\n\n![](images/07/077da578323a686ecf0e07cf0a56030fa4ce128a74d408af95b8a3027ad13f28.png)\n\nHence, the set $A\\times B$ is given by\n\n$$\nA\\times B={(0,x),(0,y),(1,x),(1,y),(2,x),(2,y)}.\n$$\n\nNote that \n\n$$\n|A\\times B|=|A|\\cdot |B|=3\\cdot 2=6.\n$$\n\nNow, the Cartesian product\n\n$$\n(A\\times B)\\times A\n$$\n\nconsists of every combination of $A\\times B$ and $A,$ as shown in the schematic below.\n\n![](images/3a/3a14abffc755dcfccce2d410ea18fbcae42d4afe2fbeffd81e1a291bc9d4968e.png)\n\nNote that \n\n$$\n|(A\\times B)\\times A|=|A\\times B|\\cdot |A|=6\\cdot 3=18.\n$$\n\nFrom the given options, we see that only $((1,y),2)\\in (A\\times B)\\times A.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186055072 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159275ce-4dc9-57f1-827a-d1275c32d42f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186284979} {:answer/id #uuid "2ec53427-0975-56a7-a33f-29f2ec5b5a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186285207} {:answer/id #uuid "377afc5a-c99c-58b1-869c-9949866416fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285308} {:answer/id #uuid "3cb6250f-9c76-5e92-a1ee-5eedcf4fdb74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186285360} {:answer/id #uuid "9abd151c-b575-5dc9-a22a-1b6338ae760c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186286206}] :answer-field/correct {:answer/id #uuid "377afc5a-c99c-58b1-869c-9949866416fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186285308} :answer-field/id #uuid "f2f51709-2790-5816-b247-4202c39421bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eac2d72-9d93-50cd-8b4e-008064a9d365" :question/math-academy-id "q-181295" :question/problem "If $A=\\{-1,1\\}$ and $B=\\{u,v\\},$ which of the following elements belong to $B\\times B\\times A?$\n\nI. $(v,v,1)$\n\nII. $((v,v),1)$\n\nIII. $(1,v,u)$" :question/worked-solution "The Cartesian product $A\\times B\\times C$ consists of all ordered triples whose first coordinate belongs to $A,$ second coordinate belongs to $B,$ and third coordinate belongs to $C.$\n\nIn this case, $B\\times B\\times A$ consists of every combination of ${u,v}$ with ${u,v}$ and ${-1,1},$ which results in\n\n$$\n\\begin{aligned}B\\times B\\times A={ & (u,u,-1),(u,u,1),(u,v,-1),(u,v,1), \\\\  & (v,u,-1),(v,u,1),(v,v,-1),(v,v,1)}.\\end{aligned}\n$$\n\nNote that\n\n$$\n|B\\times B\\times A|=|B|\\cdot |B|\\cdot |A|=2\\cdot 2\\cdot 2=8.\n$$\n\nFrom the given options, we see that only $(v,v,1)\\in B\\times B\\times A.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186055073 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fda93df-ceee-5bdb-bcc8-1d50dfc0498d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$N$ and $C$ only" :db/id #edb/ref 17592186285074} {:answer/id #uuid "2c766e6e-b354-5cb5-9c36-def341ed3a24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186285177} {:answer/id #uuid "73dbea24-3b14-53be-ad68-7aabf8690471" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$N,Z,$ and $C$ only" :db/id #edb/ref 17592186285854} {:answer/id #uuid "bcf79b26-6875-5dda-b273-4bc2013c9321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $C$ only" :db/id #edb/ref 17592186286511} {:answer/id #uuid "d81191ac-5930-5912-8558-b840f6af73bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186286754}] :answer-field/correct {:answer/id #uuid "d81191ac-5930-5912-8558-b840f6af73bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186286754} :answer-field/id #uuid "05e9342c-22e5-53ad-8a49-1010cc6022ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287158}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d88d3c9d-ec93-5bf2-a49b-0b326607c0ea" :question/math-academy-id "q-181441" :question/problem "Consider the following sets:\n\n$$\nN,\\,Z,\\,Q,\\,R,\\,C\n$$\n\nTo which of these sets does the number $\\sqrt{-1}$ belong?" :question/worked-solution "![](images/67/67ef97be4b21a74feaae15f3ff30d5077fc1316874df8de79155316a621e4487.png)\n\nRecall the following:\n\n- $N$ represents the set of **natural numbers**.\n\n- $Z$ represents the set of **integers**.\n\n- $Q$ represents the set of **rational numbers**.\n\n- $R$ represents the set of **real numbers**.\n\n- $C$ represents the set of **complex numbers**\n\nWith that in mind, we note the following:\n\n- First, we note that $\\sqrt{-1}=\\text{i}$ is a complex number. Therefore, we can write\n\n$$\n\\sqrt{-1}\\in C.\n$$\n\n- Since the imaginary part of $\\sqrt{-1}$ is nonzero, it does not belong to $N,Z,Q,$ or $R.$ We can write\n\n$$\n\\sqrt{-1}\\notin N,\\,\\sqrt{-1}\\notin Z,\\,\\sqrt{-1}\\notin Q,\\,\\sqrt{-1}\\notin R.\n$$\n\nTherefore, the correct answer is \"$C$ only.\""}] [{:db/id #edb/ref 17592186055242 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "008b14e2-2eb7-5860-a87e-0160df06982a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186321155} {:answer/id #uuid "37b51cee-e47f-5389-8754-e6cb41bb1d69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186321571} {:answer/id #uuid "5a2afd22-c826-5f07-b793-9425e286c5a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186321859} {:answer/id #uuid "a379458a-8455-599b-b6ee-19fe7a08b429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186322435} {:answer/id #uuid "f9e64f5a-4b71-5bc7-981a-e174acbf1276" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186323114}] :answer-field/correct {:answer/id #uuid "37b51cee-e47f-5389-8754-e6cb41bb1d69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186321571} :answer-field/id #uuid "692fcb01-3089-5ea3-b724-d5b3f46f2b2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323378}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8e8eb5c8-f406-5cdf-99fb-6d6cbbcd6c06" :question/math-academy-id "q-37255" :question/problem "Which of the following sets is a subset of $A={{1},{2,3},{1,3,6}}?$\n\n- ${2,{1}}$\n- ${{2,3}}$\n- ${{-1},{1,3,6}}$" :question/worked-solution "A set is a subset of $A$ if all its elements are elements of $A.$ \n\nWith that in mind, let's inspect each option.\n\n- ${2,{1}}$ is *not* a subset of $A$ because it contains the element $2\\notin A.\\,\\times $\n\n- ${{2,3}}$ is a subset of $A.\\,✓$\n\n- ${{-1},{1,3,6}}$ is *not* a subset of $A$ because it contains the element ${-1}\\notin A.\\,\\times $\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186055244 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52b6fdc7-1ea3-5594-a5a6-9cae3b4ea745" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and IV only" :db/id #edb/ref 17592186321798} {:answer/id #uuid "6d5f6106-957d-5dab-b250-9423ea39f089" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186321996} {:answer/id #uuid "9537bac4-9f3d-5267-92a8-65878ddcc632" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186322337} {:answer/id #uuid "ca66e919-9645-5077-8e46-b4e36f6aec1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186322721} {:answer/id #uuid "daedf312-c6c6-50d4-b8ea-4512d3a7a353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186322861}] :answer-field/correct {:answer/id #uuid "ca66e919-9645-5077-8e46-b4e36f6aec1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186322721} :answer-field/id #uuid "82c6e37e-1633-59f1-8abd-2d2e7bbae939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323431}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9392ab96-5be3-5aab-8c35-808d0b88162a" :question/math-academy-id "q-37384" :question/problem "Which of the numbers below belong to ${Q}^{-}?$\n\n- $1$\n- $-\\sqrt{18}$\n- $\\sqrt{6}$\n- $0$" :question/worked-solution "Remember that ${Q}^{-}$ is the set of all negative rational numbers.\n\n- $1$ is positive, not negative, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\n- $-\\sqrt{18}=-3\\sqrt{2}$ is a not a rational number, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\n- $\\sqrt{6}$ is positive, not negative, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\n- $0$ is not negative, so it does *not* belong to ${Q}^{-}.\\,\\times $\n\nIn conclusion, the correct answer is \"None of those listed\"."}] [{:db/id #edb/ref 17592186055390 :knowledge-point/_questions [{:db/id #edb/ref 17592186054799 :knowledge-point/id #uuid "ef650886-8d46-583e-bad0-1429ba496479" :knowledge-point/title "Identifying Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c40bc936-2cd7-5b7b-a0c1-dcb7b4eafa8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186053578} {:answer/id #uuid "fe2b9cf1-6543-52cd-8999-724edbb37894" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186053579} {:answer/id #uuid "4ab64b1c-d2ad-5ab3-b8f