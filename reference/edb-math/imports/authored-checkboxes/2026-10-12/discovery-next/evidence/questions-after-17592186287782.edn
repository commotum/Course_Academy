#{[{:db/id #edb/ref 17592186287782 :knowledge-point/_questions [{:db/id #edb/ref 17592186054636 :knowledge-point/id #uuid "3fca5176-1359-5ad8-b012-592ffa9b20b5" :knowledge-point/title "Cartesian Products With Three Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "158a2d08-6e35-5e32-bd95-015a1d507ed1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465803} {:answer/id #uuid "73c2a068-90a4-5b17-8b65-6668fdc43fdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465804}] :answer-field/correct {:answer/id #uuid "73c2a068-90a4-5b17-8b65-6668fdc43fdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465804} :answer-field/id #uuid "705ea8cb-7787-5604-a95c-c0037d9529ea" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466745} {:answer-field/choices [{:answer/id #uuid "10438c33-6d13-55f8-be0d-81eb594e2ed4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465805} {:answer/id #uuid "1be3bd42-91e0-5f48-80fa-0782e1cc0500" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465806}] :answer-field/correct {:answer/id #uuid "1be3bd42-91e0-5f48-80fa-0782e1cc0500" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465806} :answer-field/id #uuid "aec6f99e-46fb-5b5f-8258-35d49cd5f8c3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466746} {:answer-field/choices [{:answer/id #uuid "b4ae6b10-3909-58c9-ad25-9c7e2a57005a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465807} {:answer/id #uuid "d0a65fba-63c6-5a3b-b149-ab96fd9f924e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465808}] :answer-field/correct {:answer/id #uuid "b4ae6b10-3909-58c9-ad25-9c7e2a57005a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465807} :answer-field/id #uuid "84eb7871-4c74-53cf-9b44-ffc385343287" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466747}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e14f595-c123-5de8-8c3d-4afeb7095ae5" :question/math-academy-id "q-181977" :question/problem "If $A={4,8}$ and $B={x,y,z},$ which of the following elements belong to $A\\times (A\\times B)?$\n- **I.** $(4,(8,z))$\n- **II.** $(8,(8,x))$\n- **III.** $(8,4,y)$\n\nSelect all that apply." :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, $A\\times B$ consists of every combination of ${4,8}$ with ${x,y,z},$ as shown in the schematic below.\n\n![](images/72/72feee192b949dcce7b0f10f4e1d772c809bcf73de6c66f15c7de75a4a1ff672.png)\n\nHence, the set $A\\times B$ is given by\n\n$$\nA\\times B={(4,x),(4,y),(4,z),(8,x),(8,y),(8,z)}.\n$$\n\nNote that \n\n$$\n|A\\times B|=|A|\\cdot |B|=2\\cdot 3=6.\n$$\n\nNow, the Cartesian product\n\n$$\nA\\times (A\\times B)\n$$\n\nconsists of every combination of $A$ and $A\\times B,$ as shown in the schematic below.\n\n![](images/1a/1ae41857d4aee82a2a4ad838c20bbe72b05a1505a5f4df3aa4a86fda0fff0612.png)\n\nNote that \n\n$$\n|A\\times (A\\times B)|=|A|\\cdot |A\\times B|=2\\cdot 6=12.\n$$\n\nFrom the given options, we see that both $(4,(8,z))$ and $(8,(8,x))$ are in $A\\times \\text{\\(}A\\times B).$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186287783 :knowledge-point/_questions [{:db/id #edb/ref 17592186054633 :knowledge-point/id #uuid "b304527c-5cdc-57df-b118-e555f6f8fa5c" :knowledge-point/title "Creating a Schematic for a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fae88729-57e9-587a-b6a2-d44889d1457e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465809} {:answer/id #uuid "948516ea-f1bb-5859-b92a-e78c515d269d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465810}] :answer-field/correct {:answer/id #uuid "fae88729-57e9-587a-b6a2-d44889d1457e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465809} :answer-field/id #uuid "790c0ca6-a144-5485-8ca1-b96ae2004be6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466748} {:answer-field/choices [{:answer/id #uuid "e43f5d12-98ff-54b4-aaf0-503dce1235fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465811} {:answer/id #uuid "3e637f0a-dbfc-5458-9c1e-c67490980089" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465812}] :answer-field/correct {:answer/id #uuid "3e637f0a-dbfc-5458-9c1e-c67490980089" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465812} :answer-field/id #uuid "925eab31-abea-5607-92e2-6e84d57f0904" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466749} {:answer-field/choices [{:answer/id #uuid "76493f21-564c-51be-a712-2569eb913b55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465813} {:answer/id #uuid "66c5a1de-b6e8-5627-a5bf-611191eaa741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465814}] :answer-field/correct {:answer/id #uuid "66c5a1de-b6e8-5627-a5bf-611191eaa741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465814} :answer-field/id #uuid "abcc1ad3-fdca-5022-9e22-f6c18a6ee080" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16f7d99c-b5b7-5532-9552-dac57833067d" :question/math-academy-id "q-181978" :question/problem "![](images/d6/d6ee87bd861491394c6643679f62cb4b94436bf2777bd2436b3169e779736e2c.png)\n\nUsing the visual schematic above for the Cartesian product ${A}^{2}$ for $A={h,k},$ determine which of the following statements are true.\n\n- ${h}^{2}\\in {A}^{2}$\n- $(h,k)\\in {A}^{2}$\n- $(k,k)\\in {A}^{2}$\n\nSelect all that apply." :question/worked-solution "The set ${A}^{2}$ is equivalent to the Cartesian product $A\\times A.$\n\nThe Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nTo complete our schematic of $A\\times A,$ we write an ordered pair whose first coordinate is the corresponding element of the first set $(A)$ and the second coordinate is the corresponding element of the second set $(A)$ at each intersection.\n\n![](images/50/507f8f6306c309d5e894cfb1dabfc2019f371911f7878b196e1f329f1b37dfa6.png)\n\nAccording to our diagram:\n\n- ${h}^{2}\\in {A}^{2}\\,\\times $\n\n- $(h,k)\\in {A}^{2}\\,✓$\n\n- $(k,k)\\in {A}^{2}\\,✓$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186287789 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f93b4b3-45d3-55bc-83c9-c5f237b38683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465815} {:answer/id #uuid "e948852e-a109-5081-8701-a5fabda5db26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465816}] :answer-field/correct {:answer/id #uuid "9f93b4b3-45d3-55bc-83c9-c5f237b38683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465815} :answer-field/id #uuid "92f664e0-0d84-5e1b-8c56-90f911282aed" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466751} {:answer-field/choices [{:answer/id #uuid "00c07d2a-5301-5cda-afaa-d397be215d7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465817} {:answer/id #uuid "6e08ffdd-8ad6-5fca-9876-1ba9a4cbe9c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465818}] :answer-field/correct {:answer/id #uuid "6e08ffdd-8ad6-5fca-9876-1ba9a4cbe9c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465818} :answer-field/id #uuid "6af28f5e-8c41-5ab3-a225-75d502e0200e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466752} {:answer-field/choices [{:answer/id #uuid "1c74db06-86be-56b7-a5d1-632e8e72c33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465819} {:answer/id #uuid "c195fcc4-36cc-5fe2-a8db-4b10babddc48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465820}] :answer-field/correct {:answer/id #uuid "1c74db06-86be-56b7-a5d1-632e8e72c33c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465819} :answer-field/id #uuid "4e6beae7-8b0d-5294-bdee-52c9c42461ef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b374349-dba8-556c-833d-28419c5d38a1" :question/math-academy-id "q-182011" :question/problem "For the sets $X=\\{x,z\\},$ $Y=\\{a,b\\},$ and $Z=X\\times Y,$ determine which of the following statements are true.\n\nI. $(a,x)\\in Z$\n\nII. $(z,a)\\in Z$\n\nIII. $(z,z)\\in Z$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The Cartesian product $X\\times Y$ consists of all ordered pairs whose first coordinate belongs to $X$ and whose second coordinate belongs to $Y.$\n\nIn this case, the schematic for $X\\times Y$ is shown below.\n\n![](images/b7/b73e7aeb017bd9f7c50f7d110c7933763834eb391ac4a3e97d25f4e587a8a3d4.png)\n\nHence, the set $Z=X\\times Y$ is given by\n\n$$\nZ={(x,a),(x,b),(z,a),(z,b)}.\n$$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186287794 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95846851-9e8b-5ceb-9f37-6ad8c04fb4f4" 