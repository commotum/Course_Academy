7592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466202}] :answer-field/correct {:answer/id #uuid "f9f37f8a-3cb1-5ea2-b0bc-7863d12677f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466202} :answer-field/id #uuid "8e425465-cce5-5152-b300-75d15342331c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466944} {:answer-field/choices [{:answer/id #uuid "351ac62c-28a4-58b8-be80-7507c98d0c62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466203} {:answer/id #uuid "2c9fe460-d425-5bb1-a974-e2e29c303200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466204}] :answer-field/correct {:answer/id #uuid "351ac62c-28a4-58b8-be80-7507c98d0c62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466203} :answer-field/id #uuid "12418649-bb4e-5acc-aaaa-9e9a08a34a65" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466945}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e489da60-4fc4-5e3e-84ad-c60bd1e817ba" :question/math-academy-id "q-334435" :question/problem "For which of the following values is the Runge-Kutta Method (RK4) stable, given that $\\lambda $ is the parameter of the test equation?\n- **I.** $\\lambda Δx=0.2$\n- **II.** $\\lambda Δx=1.8$\n- **III.** $\\lambda Δx=2.7$\n- **IV.** $\\lambda Δx=6.6$\n\n*Hint: The stability function $R$ of the RK4 method is given by*\n\n$$\nR(\\lambda Δ)=1-\\lambda Δx+\\frac{(\\lambda Δx)^{2}}{2}-\\frac{(\\lambda Δx)^{3}}{6}+\\frac{(\\lambda Δx)^{4}}{24}.\n$$\n\nSelect all that apply." :question/worked-solution "A numerical method\n${y}_{n+1}={y}_{n}+Δ{y}_{n}$\nis stable for a given step size $Δx$ if, when applied to the test equation\n\n$$\n{y}^{′}=-\\lambda y,\\,y(0)=1,\\,x\\ge 0,\\,\\lambda >0,\n$$\n\nthe numerical solution satisfies ${y}_{n}\\to 0$ as $n\\to \\infty ,$ just like the exact solution.\n\nWhen a method is applied to the test equation, the update takes the form\n\n$$\n{y}_{n+1}=R(\\lambda Δx){y}_{n},\n$$\n\nwhere $R(\\lambda Δx)$ is referred to as the stability function of the method. The set of values for which the method is stable, given by $|R(\\lambda Δx)|<1,$ is called the stability region of the method.\n\nThe stability function of the RK4 Method is\n\n$$\nR(\\lambda Δx)=1-\\lambda Δx+\\frac{(\\lambda Δx)^{2}}{2}-\\frac{(\\lambda Δx)^{3}}{6}+\\frac{(\\lambda Δx)^{4}}{24}.\n$$\n\nLet's check the stability of the RK4 Method for each of the given values in turn.\n\n- For $\\lambda Δx=0.2,$ we have\n\n$$\n\\begin{aligned}|R(0.2)| & =|1-0.2+\\frac{(0.2)^{2}}{2}-\\frac{(0.2)^{3}}{6}+\\frac{(0.2)^{4}}{24}| \\\\  & =|\\frac{12\\,281}{15\\,000}| \\\\  & =0.818…<1.\\,✓\\end{aligned}\n$$\n\nSince this value falls *within* the stability region, the RK4 Method is stable.\n\n- For $\\lambda Δx=1.8,$ we have\n\n$$\n\\begin{aligned}|R(1.8)| & =|1-1.8+\\frac{(1.8)^{2}}{2}-\\frac{(1.8)^{3}}{6}+\\frac{(1.8)^{4}}{24}| \\\\  & =|\\frac{1427}{5000}| \\\\  & =0.2854<1.\\,✓\\end{aligned}\n$$\n\nSince this value falls *within* the stability region, the RK4 Method is stable.\n\n- For $\\lambda Δx=2.7,$ we have\n\n$$\n\\begin{aligned}|R(2.7)| & =|1-2.7+\\frac{(2.7)^{2}}{2}-\\frac{(2.7)^{3}}{6}+\\frac{(2.7)^{4}}{24}| \\\\  & =|\\frac{70\\,307}{80\\,000}| \\\\  & =0.878…<1.\\,✓\\end{aligned}\n$$\n\nSince this value falls *within* the stability region, the RK4 Method is stable.\n\n- For $\\lambda Δx=6.6,$ we have\n\n$$\n\\begin{aligned}|R(3.2)| & =|1-6.6+\\frac{(6.6)^{2}}{2}-\\frac{(6.6)^{3}}{6}+\\frac{(6.6)^{4}}{24}| \\\\  & =|\\frac{236\\,627}{5000}| \\\\  & =47.3254>1.\\,\\times \\end{aligned}\n$$\n\nSince this value falls *outside* the stability region, the RK4 Method is unstable.\n\nTherefore, the correct answer is \"I, II, and III only\".\n\nNote that the stability region of the RK4 Method is $0<\\lambda Δx<2.785…,$ so it is not absolutely stable."}] [{:db/id #edb/ref 17592186308617 :knowledge-point/_questions [{:db/id #edb/ref 17592186229161 :knowledge-point/id #uuid "151add00-204f-5795-aff9-cceddc26b24b" :knowledge-point/title "Determining Stability in Other Methods"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f389a51-0214-55d4-ad4f-3b7e0b58564c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466205} {:answer/id #uuid "e53370b8-d14d-5d4f-aaa9-0a1221942cff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466206}] :answer-field/correct {:answer/id #uuid "e53370b8-d14d-5d4f-aaa9-0a1221942cff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466206} :answer-field/id #uuid "243db64e-5b37-5d20-adb8-52ae5dc1b2d9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466946} {:answer-field/choices [{:answer/id #uuid "d57217d5-9847-5533-bd5a-4f3c97b5792b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466207} {:answer/id #uuid "6b44008f-dd84-5aed-bd61-5fb06c98c8e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466208}] :answer-field/correct {:answer/id #uuid "6b44008f-dd84-5aed-bd61-5fb06c98c8e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466208} :answer-field/id #uuid "c892d626-