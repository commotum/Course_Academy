1e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465825} :answer-field/id #uuid "c170d58f-1f0e-5221-9b9f-975747bcda7d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466756}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "700eeff1-f170-54bf-ba40-d6fc6885d99f" :question/math-academy-id "q-182020" :question/problem "For the sets $Z={t,u}$ and $Y=Z\\times Z,$ determine which of the following statements are true.\n- **I.** $(u,t)\\in Y$\n- **II.** $(u,t,u)\\in Y$\n- **III.** $({t}^{2},{u}^{2})\\in Y$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The Cartesian product $Z\\times Z$ consists of all ordered pairs whose first coordinate belongs to $Z$ and whose second coordinate belongs to $Z.$\n\nIn this case, the schematic for ${Z}^{2}=Z\\times Z$ is shown below.\n\n![](images/fa/fa14e54c0518f8f5e64d3ccb4f725bd0b3804fb197d7b90320398ebbf09d68d4.png)\n\nHence, the set $Y=Z\\times Z$ is given by\n\n$$\nY={(t,t),(t,u)(u,t),(u,u)}.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186290259 :knowledge-point/_questions [{:db/id #edb/ref 17592186064166 :knowledge-point/id #uuid "fbee870b-4a67-5ccb-b274-45fac627be6e" :knowledge-point/title "Classifying a Given Critical Point Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28647c8d-4e8f-57ff-b684-32be4e568f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186465827} {:answer/id #uuid "34c6fe0b-a8ad-5fd9-aeb4-86f2e50df8aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186465828}] :answer-field/correct {:answer/id #uuid "34c6fe0b-a8ad-5f