45499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466397} :answer-field/id #uuid "00dd682e-53d3-56b8-8067-598af7d82ba2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a7fcf4e-fdda-501c-b765-bd8e87f5aae0" :question/math-academy-id "q-337774" :question/problem "Which of the following are linear differential operators?\n- **I.** ${D}_{1}(y)=\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{tan}⁡(y)\\frac{\\text{d}y}{\\text{d}x}$\n- **II.** ${D}_{2}(y)=\\operatorname{tan}⁡(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{e}^{x}\\frac{\\text{d}y}{\\text{d}x}+\\frac{1}{x}y$\n- **III.** ${D}_{3}(y)=\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+x\\operatorname{cos}⁡(y)\\,y$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the second term is $\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{2}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=\\operatorname{tan}⁡(x),{f}_{1}(x)={e}^{x},$ and ${f}_{0}(x)=\\frac{1}{x}.$\n\n- Operator ${D}_{3}$ is *not* linear. The coefficient of the second term is $x\\operatorname{cos}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186311884 :knowledge-point/_questions [{:db/id #edb/ref 17592186229138 :knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397" :knowledge-point/title "Identifying Linear Differential Operators Using the General Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c2809fc-3f64-562a-a005-f78c451d2a2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466399} {:answer/id #uuid "8d7c266e-1c56-54b2-aaf6-367d55a3327f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466400}] :answer-field/correct {:answer/id #uuid "6c2809fc-3f64-562a-a005-f78c451d2a2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466399} :answer-field/id #uuid "0058b6d7-5961-597c-afb4-bdac6ce6ffa1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467043} {:answer-field/choices [{:answer/id #uuid "5488c63e-26ae-5ad8-aab9-74b5d8d20c80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466401} {:answer/id #uuid "d207ba86-61cb-5bc7-8449-9f29de274726" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466402}] :answer-field/correct {:answer/id #uuid "d207ba86-61cb-5bc7-8449-9f29de274726" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466402} :answer-field/id #uuid "c2c69489-9ae9-5e41-a79b-4b3353ee2f14" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467044} {:answer-field/choices [{:answer/id #uuid "70d4b961-effc-5654-b426-2322d8a2bd14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466403} {:answer/id #uuid "5fb604ea-6a7f-54d2-887c-5edae00dba6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466404}] :answer-field/correct {:answer/id #uuid "70d4b961-effc-5654-b426-2322d8a2bd14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466403} :answer-field/id #uuid "fa5fd7ab-beb9-5ce4-8b2d-e61c300f6b86" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186467045}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47d8bb1c-4d46-5c7b-bec5-01c857be1d48" :question/math-academy-id "q-337777" :question/problem "Which of the following are linear differential operators?\n- **I.** ${D}_{1}(y)=xy\\frac{\\text{d}y}{\\text{d}x}+\\frac{\\text{d}y}{\\text{d}x}$\n- **II.** ${D}_{2}(y)=\\operatorname{cos}⁡(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+{e}^{x}y$\n- **III.** ${D}_{3}(y)=\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+\\operatorname{tan}⁡(y)\\,y$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the first term is $xy,$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{2}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=\\operatorname{cos}⁡(x),{f}_{1}(x)={x}^{2},$ and ${f}_{0}(x)={e}^{x}.$\n\n- Operator ${D}_{3}$ is *not* linear. The coefficient of the last term is $\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\nTherefore, the correct answer is \"II only.\""}]}
