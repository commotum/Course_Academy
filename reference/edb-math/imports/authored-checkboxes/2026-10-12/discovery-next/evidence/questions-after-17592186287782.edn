186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466122}] :answer-field/correct {:answer/id #uuid "e5e69f56-b610-52ae-851b-4d158ab52afb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466121} :answer-field/id #uuid "1540c7cc-2f96-585b-bb1b-eb406b71178c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466904} {:answer-field/choices [{:answer/id #uuid "3c8a5adb-4df8-57eb-b6d0-d7ff26a49607" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186466123} {:answer/id #uuid "d312f937-6578-5108-a7b2-d3fd1aef1c70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466124}] :answer-field/correct {:answer/id #uuid "d312f937-6578-5108-a7b2-d3fd1aef1c70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186466124} :answer-field/id #uuid "59264af1-9ded-5de5-9faa-802b21ed9e90" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186466905}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f21f7e32-ddad-5b51-8839-e9c4ba026875" :question/math-academy-id "q-334009" :question/problem "For which of the following step sizes is Euler's Method **stable**, given that $\\lambda $ is the parameter of the test equation ${y}^{′}=-\\lambda y$ with $y=y(x),y(0)=1,x\\ge 0,\\lambda >0,$ and step size $Δx?$\n\nI. $Δx=\\frac{1.4}{\\lambda }$\n\nII. $Δx=\\frac{1.25}{\\lambda }$\n\nIII. $Δx=\\frac{2.5}{\\lambda }$\n\nIV. $Δx=\\frac{0.75}{\\lambda }$\n\n*Hint: The stability function for Euler's method is given by* $R(\\lambda Δx)=1-\\lambda Δx.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A numerical method  ${y}_{n+1}={y}_{n}+Δ{y}_{n}$  is stable for a given step size $Δx$ if, when applied to the test equation\n\n$$\n{y}^{′}=-\\lambda y,\\,y(0)=1,\\,x\\ge 0,\\,\\lambda >0,\n$$\n\nthe numerical solution satisfies ${y}_{n}\\to 0$ as $n\\to \\infty ,$ just like the exact solution.\n\nFor stability, we require that the following condition holds:\n\n$$\n\\begin{aligned}|R(\\lambda Δx)| & <1 \\\\ |1-\\lambda Δx| & <1\\end{aligned}\n$$\n\nSolving this gives\n\n$$\n0<\\lambda Δx<2.\n$$\n\nThis means that Euler's method is stable when applied to the test equation for values in the region $0<\\lambda Δx<2.$\n\nNow, we consider each step size in turn.\n\n- For $Δx=\\frac{1.4}{\\lambda },$ we have $\\lambda Δx=1.4.$ Since this value falls *within* the given region,\n\n$$\n\\begin{aligned}0<\\lambda Δx & <2 \\\\ 0<1.4 & <2,\\end{aligned}\n$$\n\nEuler's method *must be* stable for this step size.\n\n- For $Δx=\\frac{1.25}{\\lambda },$ we have $\\lambda Δx=1.25.$ Since this value falls *within* the given region,\n \n\n$$\n\\begin{aligned}0<\\lambda Δx & <2 \\\\ 0<1.25 & <2,\\end{aligned}\n$$\n\nEuler's method *must be* stable for this step size.\n\n- For $Δx=\\frac{2.5}{\\lambda },$ we have $\\lambda Δx=2.5\\ge 2.$ Since this value falls *outside* the given region, Euler's method is *not* stable for this step size.\n\n- For $Δx=\\frac{0.75}{\\lambda },$ we have $\\lambda Δx=0.75.$ Since this value falls *within* the given region,\n \n\n$$\n\\begin{aligned}0<\\lambda Δx & <2 \\\\ 0<0.75 & <2,\\end{aligned}\n$$\n\nEuler's method *must be* stable for this step size.\n\nTherefore, the correct answer is \"I, II, and IV only\"."}] [{:db/id #edb/ref 17592186308543 :knowledge-point/_questions [{:db/id #edb/ref 17592186229159 :knowledge-point/id #uuid "d4823cf5-2656-5616-b4af-193f70c3f2bc" :knowledge-point/title "Determining Stability in Euler's Method"}] :question/answer-fields [{:answer-field/choices [{: