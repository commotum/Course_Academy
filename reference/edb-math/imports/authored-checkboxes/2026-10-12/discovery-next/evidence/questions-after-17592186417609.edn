7592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474700} :answer-field/id #uuid "00f52311-7c1c-50b8-8bbd-1dc73e29b203" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475276}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a9e1ee25-17a0-56ec-9f69-bcad0ae7d0cc" :question/math-academy-id "q-221717" :question/problem "Consider the equivalence relation $∼$ on $R,$ defined by $x∼y$ if $\\operatorname{cos}⁡x=\\operatorname{cos}⁡y.$ Which of the following are in the equivalence class $[0]?$\n\nI. $2\\pi $\n\nII. $3\\pi $\n\nIII. $\\frac{\\pi }{2}$\n\nSelect all that apply." :question/worked-solution "The equivalence class $[0]$ consists of the elements that are equivalent to $0$ under the given equivalence relation. So, we have\n\n$$\n\\begin{aligned}[0] & ={x\\in R\\,|\\,x∼0} \\\\  & ={x\\in R\\,|\\,\\operatorname{cos}⁡x=\\operatorname{cos}⁡0} \\\\  & ={x\\in R\\,|\\,\\operatorname{cos}⁡x=1} \\\\  & ={…,-4\\pi ,-2\\pi ,0,2\\pi ,4\\pi ,…}.\\end{aligned}\n$$\n\nWe see that $2\\pi $ is in $[0],$ while $3\\pi $ and $\\frac{\\pi }{2}$ are not.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186421723 :knowledge-point/_questions [{:db/id #edb/ref 17592186152256 :knowledge-point/id #uuid "3601ac83-0800-567a-9a0d-4d5c37cef413" :knowledge-point/title "Identifying Elements Belonging to an Equivalence Class"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "628ea40b-ea3c-5520-b003-e513180caca5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474942} {:answer/id #uuid "827b5c09-b00d-5748-862e-57400f85bc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474943}] :answer-field/correct {:answer/id #uuid "827b5c09-b00d-5748-862e-57400f85bc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474943} :answer-field/id #uuid "1d65f7bf-9220-5736-b706-48277ea961fe" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475397} {:answer-field/choices [{:answer/id #uuid "b8185cbb-4366-5acd-8f39-dcc3625941ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474944} {:answer/id #uuid "ce9abc7a-b119-50d1-947b-a90b799a3d7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474945}] :answer-field/correct {:answer/id #uuid "b8185cbb-4366-5acd-8f39-dcc3625941ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474944} :answer-field/id #uuid "786b07de-9820-5172-9cc7-34e2d9751571" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475398} {:answer-field/choices [{:answer/id #uuid "759e913e-e77e-550f-a1c4-22cc9a13f9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474946} {:answer/id #uuid "9dd54e9f-2b56-582c-bf83-ef6cf659a9ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474947}] :answer-field/correct {:answer/id #uuid "759e913e-e77e-550f-a1c4-22cc9a13f9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474946} :answer-field/id #uuid "246ed5b8-f726-5f26-986d-9fdfc646ba8e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb353c96-604c-5c65-9adf-47096b9ec124" :question/math-academy-id "q-86223" :question/problem "Consider the equivalence relation $∼$ on $R,$ defined by $x∼y$ if $\\sqrt[3]{x}=\\sqrt[3]{y}.$ Which of the following are in the equivalence class $[-8]?$\n\nI. $-8$\n\nII. $8$\n\nIII. $2$\n\nSelect all that apply." :question/worked-solution "The equivalence class $[-8]$ consists of the elements that are equivalent to $-8$ under the given equivalence relation. So, we have\n\n$$\n\\begin{aligned}[-8] & ={x\\in R\\,|\\,x∼-8} \\\\  & ={x\\in R\\,|\\,\\sqrt[3]{x}=\\sqrt[3]{-8}} \\\\  & ={x\\in R\\,|\\,\\sqrt[3]{x}=-2} \\\\  & ={-8}.\\end{aligned}\n$$\n\nWe see that $-8$ is in $[-8],$ while $8$ and $2$ are not.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186421724 :knowledge-point/_questions [{:db/id #edb/ref 17592186152257 :knowledge-point/id #uuid "dacfbca6-6135-5d51-a07e-627fce79dfd1" :knowledge-point/title "Identifying Equivalence Classes Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf3b8092-688e-550d-bb8f-94927287de38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474948} {:answer/id #uuid "b3dd6920-4fc9-5b9f-9195-fcb7501da562" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474949}] :answer-field/correct {:answer/id #uuid "b3dd6920-4fc9-5b9f-9195-fcb7501da562" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474949} :answer-field/id #uuid "ca344c74-0602-5449-8c55-b00b5f9d9cf5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475400} {:answer-field/choices [{:answer/id #uuid "db98694b-b3bb-578e-81f6-9b