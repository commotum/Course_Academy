db/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474420} {:answer/id #uuid "e87c29df-7f86-5b0d-8272-11405cd25962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474421}] :answer-field/correct {:answer/id #uuid "e87c29df-7f86-5b0d-8272-11405cd25962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474421} :answer-field/id #uuid "7790cb62-e714-5a36-87b0-09aa86dc3f4a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475136} {:answer-field/choices [{:answer/id #uuid "2cdd8b16-2df5-5a90-b9b9-15e1e44f9c40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474422} {:answer/id #uuid "96ee3aee-80f2-5eca-80b9-adb92cb652ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474423}] :answer-field/correct {:answer/id #uuid "96ee3aee-80f2-5eca-80b9-adb92cb652ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474423} :answer-field/id #uuid "353fb675-d574-5a12-8c87-8a3853c61877" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ea10c69-304c-5ad4-bd04-4affc2cf325b" :question/math-academy-id "q-157376" :question/problem "Let $L$ be the line in ${R}^{3}$ that passes through the points $(0,0,0)$ and $(-1,3,1).$ Which of the following statements are true?\n\nI. $L$ contains the zero-vector\n\nII. $L$ is closed under vector addition\n\nIII. $L$ is closed under scalar multiplication\n\nIV. $L$ is a subspace of ${R}^{3}$\n\nSelect all that apply." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nFirst, note that the direction vector of the line $L$ is \n\n$$\nd=[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}]-[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}].\n$$\n\nThis means that the vector equation of the line is\n\n$$\n\\begin{aligned}r & =[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]+t[\\begin{aligned}-1 \\\\ 3 \\\\ 1\\end{aligned}]=[\\begin{aligned}-t \\\\ 3t \\\\ t\\end{aligned}]\\end{aligned}\n$$\n\nfor $t\\in R,$ and the corresponding Cartesian equation is \n\n$$\n-x=\\frac{y}{3}=z.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. Indeed, from the definition of $L$ we have that the point $(0,0,0)$ is in $L.$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]\\in L$ and $b=[\\begin{aligned}-b \\\\ 3b \\\\ b\\end{aligned}]\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]+[\\begin{aligned}-b \\\\ 3b \\\\ b\\end{aligned}]=[\\begin{aligned}(-a)+(-b) \\\\ 3a+3b \\\\ a+b\\end{aligned}]=[\\begin{aligned}-(a+b) \\\\ 3(a+b) \\\\ a+b\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the conditions $-x=\\frac{y}{3}=z.$ Therefore, $a+b\\in L.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}-a \\\\ 3a \\\\ a\\end{aligned}]=[\\begin{aligned}k(-a) \\\\ k(3a) \\\\ ka\\end{aligned}]=[\\begin{aligned}-(ka) \\\\ 3(ka) \\\\ ka\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the conditions $-x=\\frac{y}{3}=z.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement IV is true. Since statements II and III are true, $L$ is a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186425875 :knowledge-point/_questions [{:db/id #edb/ref 17592186105860 :knowledge-point/id #uuid "0ee39554-fd77-5e90-baa8-f9320ffc3398" :knowledge-point/title "Identifying Continuous Random Variables Given in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd58f32-7f1c-557f-ae42-5120bfbcb2ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474966} {:answer/id #uuid "fd62a3d9-0c24-5905-966e-65252ccd83d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474967}] :answer-field/correct {:answer/id #uuid "1fd58f32-7f1c-557f-ae42-5120bfbcb2ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474966} :answer-field/id #uuid "436cc2ae-79ed-5267-adeb-2b7068b12807" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475409} {:answer-field/choices [{:answer/id #uuid "8ddde048-6382-55d9-ad53-99efc8944351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474968} {:answer/id #uuid "c616d525-6bf4-56fb-b189-7bf6e8974588" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474969}] :answer-field/correct {:answer/id #uuid "8ddde048-6382-55d9-ad53-99efc8944351" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474968} :answer-field/id #uuid "935ad41a-97b9-56bc-a04c-a116b96c9924" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475410} {:answer-field/choices [{:answer/id #uuid "ad2933b3-b638-5a31-9303-cf86416c9315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474970} {:answer/id #uuid "ccb03621-3f0d-5fb9-a66b-ee2651bd3643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474971}] :answer-field/correct {:answer/id #uuid "ccb03621-3f0d-5fb9-a66b-ee2651bd3643" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474971} :answer-field/id #uuid "e41f053d-a3a7-5269-bbe8-0b2ce3377b46" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475411}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2365a6d7-b820-5041-9972-25df8cfa8866" :question/math-academy-id "q-86922" :question/problem "Which of the following are continuous random variables?\n\nI. The outcome of rolling a $10$-sided die\n\nII. The number of aces in a standard deck of playing cards\n\nIII. The weight of a randomly selected person, measured in kilograms\n\nSelect all that apply." :question/worked-solution "A random variable is a variable whose value is determined by the outcome of a trial or experiment. A *continuous* random variable is a random variable whose possible values are represented by an interval of real numbers.\n\nCommon examples of continuous random variables are shown in the diagram below.\n\n![](images/05/05e3d893f6c069dce5b51dc7d9fa5830b44bca58fa071009548fde20ebe92c19.png)\n\nWith that in mind, let's consider each of the given statements.\n\n- Statement I does *not* describe a continuous random variable. Its value is determined by the result of an experiment, but its possible values are the integers $1,2,3,…,10,$ which do not correspond to an interval of real numbers.\n\n- Statement II does *not* describe a continuous random variable. The number of aces in a standard deck of playing cards is not the outcome of a trial or experiment. (By definition, there are $4$ aces in a standard deck of playing cards.)\n\n- Statement III describes a continuous random variable. Its value is determined by the result of an experiment, and its possible values correspond to the real numbers in the interval $(0,\\infty ).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186425929 :knowledge-point/_questions [{:db/id #edb/ref 17592186152198 :knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3" :knowledge-point/title "Determining a Correct Function Used to Define a Double Integral Over a Non-Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0775b041-2fcc-5161-beb5-80cd60e4af23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474960} {:answer/id #uuid "f695d431-d46b-54df-b510-3aea6bbccfdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474961}] :answer-field/correct {:answer/id #uuid "0775b041-2fcc-5161-beb5-80cd60e4af23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474960} :answer-field/id #uuid "0b9ce56f-633d-52a6-9fe3-5e31c2ec3104" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475406} {:answer-field/choices [{:answer/id #uuid "2e2c39ea-ff23-5ab6-97b2-01c12343ec12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474962} {:answer/id #uuid "7d0dbf92-3cec-57d5-bf09-b54ff477f7e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474963}] :answer-field/correct {:answer/id #uuid "2e2c39ea-ff23-5ab6-97b2-01c12343ec12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474962} :answer-field/id #uuid "1cfbefaa-3aac-5745-9c77-f042b1776296" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475407} {:answer-field/choices [{:answer/id #uuid "787b4942-1ca4-5050-825d-4ac096b82f5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474964} {:answer/id #uuid "b98f4c53-ec17-539a-b8eb-fcaada4b3fa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474965}] :answer-field/correct {:answer/id #uuid "b98f4c53-ec17-539a-b8eb-fcaada4b3fa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474965} :answer-field/id #uuid "2f93c2fb-74eb-51e3-8d97-e03de7254f93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1654ded7-c0bc-579c-a9e9-6daa6a1243e7" :question/math-academy-id "q-86894" :question/problem "![](images/5d/5d8f57afa16e99c13e6e36c5544a7c7594da13321bd3d01692a5a296a20953d7.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$\n\nII. $\\{\\begin{aligned}x{e}^{y}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nIII. $\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ x{e}^{y}, & (x,y)\\in D\\end{aligned}$\n\nSelect all that apply." :question/worked-solution "First, let's draw our region $D$ and the rectangle $R:$\n\n![](images/ce/ce9b9f3435a94b3f9f87b195e5b1591c80281b23cfb76ceb8e79cdeec3ae66b0.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $x{e}^{y}$ on $D$ and to be equal $0$ outside $D,$ we obtain \n\n$$\n{∬}_{D}x{e}^{y}\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions I and II. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,2)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function III equals $x{e}^{y}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186425930 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c96195d-9858-594d-bb72-8ff337d223f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474906} {:answer/id #uuid "ac21b789-f73c-5a27-a558-3259fd8be378" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474907}] :answer-field/correct {:answer/id #uuid "8c96195d-9858-594d-bb72-8ff337d223f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474906} :answer-field/id #uuid "aeb5c3d2-18c2-5791-91fb-de36d351c3f3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475379} {:answer-field/choices [{:answer/id #uuid "6ab7c8fd-5e59-504d-87ca-07f4eaf0b228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474908} {:answer/id #uuid "e456c4ef-ec5d-5bb0-bee8-fd0487478461" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474909}] :answer-field/correct {:answer/id #uuid "e456c4ef-ec5d-5bb0-bee8-fd0487478461" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474909} :answer-field/id #uuid "dc86775b-88dd-5f7c-98f3-98d7a6ccc3be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475380} {:answer-field/choices [{:answer/id #uuid "80b9bb14-06f2-5942-afb1-747bedec4368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474910} {:answer/id #uuid "6c9391cb-f39e-56c2-b392-ee39256bc2c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474911}] :answer-field/correct {:answer/id #uuid "80b9bb14-06f2-5942-afb1-747bedec4368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474910} :answer-field/id #uuid "9a36324a-0315-506f-92d5-cf0da1cac767" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475381}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19ad1761-3136-5be8-b038-5aa62265f48b" :question/math-academy-id "q-80526" :question/problem "![](images/88/8866056ce5c7c80ed8452246cc3a40074b6841615ed6ef472e7a1612709e51fa.png)\n\nConsider the region $D$ shown above. If \n\n$$\nf(x,y)=\\{\\begin{aligned}x\\operatorname{sin}⁡y & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. ${∬}_{R}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,1]\\times [-3,2]$\n\nII. ${∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [-3,3]$\n\nIII. ${∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [-2,2]$\n\nSelect all that apply." :question/worked-solution "Notice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}x\\operatorname{sin}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}x\\operatorname{sin}⁡y\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statement I is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\n- Statement II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The rectangle $R$ does not cover the region $D.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186425980 :knowledge-point/_questions [{:db/id #edb/ref 17592186198280 :knowledge-point/id #uuid "aa2f2ccb-45b0-5d6a-aa94-ac3eb95c745b" :knowledge-point/title "Identifying Predicates of More Than One Variable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f548d9d7-5c43-5510-85e7-89f665103530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474544} {:answer/id #uuid "299c3818-e21a-5d63-9d43-edb435384b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474545}] :answer-field/correct {:answer/id #uuid "299c3818-e21a-5d63-9d43-edb435384b5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474545} :answer-field/id #uuid "33029c5d-a58f-5846-b20f-d30fb9ae1431" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475198} {:answer-field/choices [{:answer/id #uuid "cffbbad6-2ff2-508a-a394-ef1effcca096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474546} {:answer/id #uuid "966aa064-e076-50ec-9fdb-88187a6d9994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474547}] :answer-field/correct {:answer/id #uuid "cffbbad6-2ff2-508a-a394-ef1effcca096" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474546} :answer-field/id #uuid "8eb33668-d751-5e1f-a8f1-d04525bc5ad1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475199} {:answer-field/choices [{:answer/id #uuid "a3099e3c-5a65-5e1b-a4c9-9aceb7935c7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474548} {:answer/id #uuid "517d0ea8-bd34-5d06-9d04-f78f5ae6a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474549}] :answer-field/correct {:answer/id #uuid "517d0ea8-bd34-5d06-9d04-f78f5ae6a208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474549} :answer-field/id #uuid "3bc37e72-ebc3-54f5-abd0-30ce43dacb22" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86866e7c-73c9-5409-8743-b71ad4d3cbe4" :question/math-academy-id "q-175366" :question/problem "Which of the following are mathematical predicates?\n\nI. $P(y):$ ${y}^{2}-1=8$\n\nII. $Q(a,b):$ ${a}^{2}+{b}^{2}$\n\nIII. $R(x,y):$ $\\frac{x}{y}\\in N\\cap Q$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A *predicate* of the variables ${x}_{1},{x}_{2},…,{x}_{n}$ is a sentence that contains the variables defined on some *universal set*, and has the property that when we substitute concrete values for all the variables into the predicate, the result becomes a statement that is either true or false.\n\nWith that in mind, let's examine our options. \n\n- Option I is a predicate of one variable. Substituting a concrete value for $y$ into the sentence, we get a statement that is either true or false.\n\n- Option II is *not* a predicate. Substituting a concrete pair of values $(a,b)$ into the sentence, we do not get a statement that is either true or false.\n\n- Option III is a predicate of two variables. Substituting a concrete pair of values $(x,y)$ into the sentence, we get a statement that is either true or false.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186426030 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eef6c94a-e496-5891-a2ca-b9ac53696b93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474392} {:answer/id #uuid "741b2c42-773e-5ec4-9974-e7e956acbdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474393}] :answer-field/correct {:answer/id #uuid "741b2c42-773e-5ec4-9974-e7e956acbdca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474393} :answer-field/id #uuid "5e8f1f9b-c7ae-59c4-9600-fc6d84220816" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475122} {:answer-field/choices [{:answer/id #uuid "d17410a8-6d51-5fbd-a6e2-afab502e03a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474394} {:answer/id #uuid "af4458a5-0951-5cde-ba22-486fe27e56df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474395}] :answer-field/correct {:answer/id #uuid "d17410a8-6d51-5fbd-a6e2-afab502e03a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474394} :answer-field/id #uuid "6d41f5c7-38fe-52a2-ac70-78a54dd7e7be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475123} {:answer-field/choices [{:answer/id #uuid "45d41db6-c839-5651-be71-5da1d3518353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474396} {:answer/id #uuid "7c8c5f95-5115-5b8c-87c7-c97126e15804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474397}] :answer-field/correct {:answer/id #uuid "45d41db6-c839-5651-be71-5da1d3518353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474396} :answer-field/id #uuid "569f02b4-e8e3-5e5d-a2af-5774202b1895" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475124}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ce1827c-c98c-5481-b210-2bd31e84c14f" :question/math-academy-id "q-143337" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ |\n\nWhich of the following statements are true?\n\nI. $P(X=1,Y=1)=P(X=1)\\cdot P(Y=1)$\n\nII. $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n\nIII. $X$ and $Y$ are independent\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | $Y=3$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=0$ | $0.14$ | $0.16$ | $0.05$ | $0.35$ |\n| $X=1$ | $0.26$ | $0.34$ | $0.05$ | $0.65$ |\n| ${f}_{Y}$ | $0.4$ | $0.5$ | $0.1$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.26.$ On the other hand, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.65\\cdot 0.4=0.26.\\,✓\n$$\n\n- Statement II is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(0,1) & =0.14=0.35\\cdot 0.4={f}_{X}(0)\\cdot {f}_{Y}(1) & ✓ \\\\ f(0,2) & =0.16\\ne 0.35\\cdot 0.5={f}_{X}(0)\\cdot {f}_{Y}(2) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186426072 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d5ed8d-7e60-5db5-b7d1-d96bb65185a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474362} {:answer/id #uuid "10b14067-3f7f-5868-8791-43396e0607b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474363}] :answer-field/correct {:answer/id #uuid "10b14067-3f7f-5868-8791-43396e0607b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474363} :answer-field/id #uuid "bb207fd4-1ade-5c72-8528-ba143a738870" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475107} {:answer-field/choices [{:answer/id #uuid "0948d764-f192-5b49-80f0-17ce4b9bcefb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474364} {:answer/id #uuid "f2aade65-5d3a-520b-86ea-745a85070e15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474365}] :answer-field/correct {:answer/id #uuid "0948d764-f192-5b49-80f0-17ce4b9bcefb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474364} :answer-field/id #uuid "e4b6ddd3-8ce7-5c7f-874e-23d5563021dc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475108} {:answer-field/choices [{:answer/id #uuid "23dc218b-818c-594c-978b-8b69736909ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474366} {:answer/id #uuid "4999264b-817a-578e-85f5-209e47509eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474367}] :answer-field/correct {:answer/id #uuid "4999264b-817a-578e-85f5-209e47509eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474367} :answer-field/id #uuid "25ecf0bb-4395-5d51-99bd-1c0a67d30176" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475109}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "251cfe7e-474d-59b2-8ccf-101401daf068" :question/math-academy-id "q-139978" :question/problem "Consider the following sentence:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ has no inverse\n\nII. $\\text{Null}(A)$ has dimension zero\n\nIII. $A$ has less than $5$ pivot columns\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has no inverse.* $\\,✓$ \n\nIndeed, since $det(A)=0,$ the matrix $A$ can't be invertible.\n\n- The following statement is false:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $\\text{Null}(A)$ has dimension zero.* $\\,\\times $\n\nSince $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{Null}(A)\\ne \\{0\\}$ which, in turn,  means that $\\text{Null}(A)$ must have a basis so the dimension must be greater than zero.\n\n- The following statement is true:\n\n*If $A$ is a $5\\times 5$ matrix and $det(A)=0,$ then $A$ has less than $5$ pivot columns.* $\\,✓$\n\nIndeed, since $A$ is not invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))\\ne 5,$ which means that $A$ has less than $5$ pivot columns.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186426531 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9417891-0e40-540b-991e-c0da826220ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474424} {:answer/id #uuid "72a365a1-c915-5248-8b67-7d67badce3dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474425}] :answer-field/correct {:answer/id #uuid "d9417891-0e40-540b-991e-c0da826220ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474424} :answer-field/id #uuid "d831bd91-03aa-54a1-ab90-e13837639f43" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475138} {:answer-field/choices [{:answer/id #uuid "1fa4f35b-8dc5-579b-8ae5-b2436fabe315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474426} {:answer/id #uuid "bc5da6ed-abf0-570d-9dbc-5092dcb29f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474427}] :answer-field/correct {:answer/id #uuid "1fa4f35b-8dc5-579b-8ae5-b2436fabe315" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474426} :answer-field/id #uuid "5a8470c7-8564-5d8d-930d-822491454942" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475139} {:answer-field/choices [{:answer/id #uuid "23969965-998e-5a2b-8311-d0e8072fab63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474428} {:answer/id #uuid "a835355d-68fc-5aae-9935-bd37c686c7c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474429}] :answer-field/correct {:answer/id #uuid "a835355d-68fc-5aae-9935-bd37c686c7c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474429} :answer-field/id #uuid "81ead088-1b46-50ea-9b30-56b944af1208" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475140}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24da091b-82da-56f5-873d-6d9cc1e779e2" :question/math-academy-id "q-158072" :question/problem "![](images/8f/8f3c0e576491c4fd3897e30931ca7ed86d03c557ed37de86a3bcdc748f2263ea.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram III represents a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186426532 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98e36e60-7f4e-5471-9c79-3de0fa9fb055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474254} {:answer/id #uuid "ecd5cedc-0fa5-539c-83af-8334b94a61b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474255}] :answer-field/correct {:answer/id #uuid "98e36e60-7f4e-5471-9c79-3de0fa9fb055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474254} :answer-field/id #uuid "45f824b7-26f5-51aa-88da-6f8a9190aea6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475053} {:answer-field/choices [{:answer/id #uuid "d05a5c0b-7cf8-5741-abe3-5160cf118536" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474256} {:answer/id #uuid "eb08479f-5f31-5a03-a005-616f28978efb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474257}] :answer-field/correct {:answer/id #uuid "d05a5c0b-7cf8-5741-abe3-5160cf118536" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474256} :answer-field/id #uuid "60c1be91-8261-58d6-be0c-8554e0b3f515" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475054} {:answer-field/choices [{:answer/id #uuid "a2c29e1d-be92-5d99-b462-8c335808a7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474258} {:answer/id #uuid "ca799662-448d-5eb3-89be-6549746e0a79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474259}] :answer-field/correct {:answer/id #uuid "a2c29e1d-be92-5d99-b462-8c335808a7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474258} :answer-field/id #uuid "435b445b-a1d3-5c7e-bda2-9e456fd12252" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475055}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61609b84-fa99-5574-b117-b0c4a018b4cb" :question/math-academy-id "q-110456" :question/problem "![](images/5a/5ac6c0c6dc06d6e9b3970f2d6e5c5ce01a56c781143999d744a9b3914c37a49d.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}?$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=[\\begin{aligned}-1 \\\\ -1\\end{aligned}]$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\nlies outside the subset.\n\n- Diagram II represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III represents the whole plane ${R}^{2}$ without the origin. But every subspace must contain the origin, so Diagram III is not a subspace of ${R}^{2}.$\n\nSo, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186426533 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb17f7e3-269e-5625-a111-f4d4af48c417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474272} {:answer/id #uuid "31d11665-b6a6-55f9-a8b1-68377f92906b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474273}] :answer-field/correct {:answer/id #uuid "fb17f7e3-269e-5625-a111-f4d4af48c417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474272} :answer-field/id #uuid "a1b2942f-e716-57f1-88e3-40e92d8e3656" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475062} {:answer-field/choices [{:answer/id #uuid "9ad710ac-351e-551c-9aa3-eb471c6ba7f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474274} {:answer/id #uuid "ff323ad8-0d05-55f5-9ec9-2dd89adb86b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474275}] :answer-field/correct {:answer/id #uuid "9ad710ac-351e-551c-9aa3-eb471c6ba7f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474274} :answer-field/id #uuid "189d1c47-187f-5ca5-b080-65e61257620b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475063} {:answer-field/choices [{:answer/id #uuid "4b68cef7-62b5-5d0d-8003-74ec4afeca09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474276} {:answer/id #uuid "e73f1446-6ae4-598e-9a58-e6999a487413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474277}] :answer-field/correct {:answer/id #uuid "e73f1446-6ae4-598e-9a58-e6999a487413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474277} :answer-field/id #uuid "58329b77-3f5c-5c03-892f-99af51f6bc0b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475064}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "784a3447-3ec5-5b3c-aa05-c4909c41863a" :question/math-academy-id "q-110763" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\nI. $A=\\{⟨1+t,t-1⟩\\,:\\,t\\in R\\}$\n\nII. $B=\\{⟨x,y⟩\\in {R}^{2}:xy=0\\}$\n\nIII. $C=\\{⟨x,y⟩\\in {R}^{2}:x=0\\}$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. If the origin belongs to this subset, we would have\n\n$$\n[\\begin{aligned}1+t \\\\ t-1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}],\n$$\n\nwhich gives us\n\n$$\n\\{\\begin{aligned}t+1=0 \\\\ t-1=0.\\end{aligned}\n$$\n\nWe see that the system has no solution. So, $0$ is not in $A.$\n\n- The set $B$ is not a subspace. Indeed, both $a=⟨1,0⟩$ and $b=⟨0,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0⟩+⟨0,1⟩=⟨1,1⟩\n$$\n\n \ndoes not satisfy the condition $xy=0$ since $1\\cdot 1\\ne 0.$\n\n- The set $C$ is a subspace. It represents a line (the $y$-axis), and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $x=0$ since $0=0.$ So, $0$ lies in $C.$\n\nIn conclusion, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186426534 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fe8bd27-3332-5e19-ab00-90bec8a7d8bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474430} {:answer/id #uuid "853cd590-6caa-56b3-a59f-0675ccb0e749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474431}] :answer-field/correct {:answer/id #uuid "853cd590-6caa-56b3-a59f-0675ccb0e749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474431} :answer-field/id #uuid "563623e9-779c-5c19-a3d5-42d130d33d79" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475141} {:answer-field/choices [{:answer/id #uuid "2123dbe4-7024-5943-a1bb-063a94890da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474432} {:answer/id #uuid "d93c4474-f728-51c9-9ef3-970a99af9b3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474433}] :answer-field/correct {:answer/id #uuid "2123dbe4-7024-5943-a1bb-063a94890da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474432} :answer-field/id #uuid "725aa56a-3ba3-5d2e-bc80-310e770ce2e5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475142} {:answer-field/choices [{:answer/id #uuid "027fb362-49b2-5c99-954e-f219c00ba6d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474434} {:answer/id #uuid "0dcb4af6-96b5-543a-b142-134acab8924c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474435}] :answer-field/correct {:answer/id #uuid "0dcb4af6-96b5-543a-b142-134acab8924c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474435} :answer-field/id #uuid "3d76cd3a-8ed8-5ff4-ac05-f9a94b840c44" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475143}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d538e48-6d40-5139-9e4a-4a2045c240b7" :question/math-academy-id "q-158073" :question/problem "![](images/f6/f6695911ed29ccf88240660e45ce6527c0a10e3cf8d6a299ac9eef2be3ff53cb.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a plane that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\n- Diagram II represents a line that does not pass through the origin. But every subspace must contain the origin, so the line in Diagram II is not a subspace of ${R}^{3}.$\n\n- Diagram III represents a line that passes through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\nSo, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186426535 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f3871a9-6e60-5fd0-923a-baae81d1dcc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474266} {:answer/id #uuid "08e41dcc-4096-52b0-b648-56bc1c24d9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474267}] :answer-field/correct {:answer/id #uuid "08e41dcc-4096-52b0-b648-56bc1c24d9e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474267} :answer-field/id #uuid "8deb3772-23f8-57f0-9654-27f663eb5b79" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475059} {:answer-field/choices [{:answer/id #uuid "a735ecf6-9831-50b7-9118-50ebb21e7bf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474268} {:answer/id #uuid "7d9a6da5-190a-5a0b-9e24-d7c79706a2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474269}] :answer-field/correct {:answer/id #uuid "7d9a6da5-190a-5a0b-9e24-d7c79706a2e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474269} :answer-field/id #uuid "c0e48cf1-2e8f-594c-98aa-3c8a0ee95a28" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475060} {:answer-field/choices [{:answer/id #uuid "be9edb74-2397-5ca7-b83f-9320c8ba3023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474270} {:answer/id #uuid "72e5d407-78c6-57eb-916b-f720eba7787b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474271}] :answer-field/correct {:answer/id #uuid "be9edb74-2397-5ca7-b83f-9320c8ba3023" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474270} :answer-field/id #uuid "1c506523-20a6-5d70-a10c-c4a2e49bed4c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475061}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c109cc3b-b729-5d92-be15-5107dfc714ce" :question/math-academy-id "q-110759" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:x-y+z=0\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}=0\\}$\n\nIII. $C=\\{⟨0,0,1⟩\\}$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $x-y+z=0$ since $0-0+0=0.$ So $0$ lies in $A.$\n\n- The set $B$ is a subspace. This subset has only one element, the zero vector $0=⟨0,0,0⟩,$ which is a special (trivial) subspace of ${R}^{3}.$\n\n- The set $C$ is not a subspace. This subset has only one element, the vector $⟨0,0,1⟩,$ so it does not contain the zero vector.\n\nIn conclusion, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186426536 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{: