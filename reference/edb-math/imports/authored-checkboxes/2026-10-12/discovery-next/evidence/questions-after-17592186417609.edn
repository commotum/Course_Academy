swer.type/text} :answer/value "false" :db/id #edb/ref 17592186474598} {:answer/id #uuid "f6556b17-607c-5539-b341-8b02d501a75a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474599}] :answer-field/correct {:answer/id #uuid "cce7b4dd-ecf5-5770-bb2b-64d8b861e198" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474598} :answer-field/id #uuid "826f982e-2d81-59a1-b8ed-73e1e4460bd5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475225} {:answer-field/choices [{:answer/id #uuid "a88484f5-b344-5db6-b1d4-105554bbb0f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474600} {:answer/id #uuid "ff97cc03-e2de-5d2a-b9a5-83cfca9f550f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474601}] :answer-field/correct {:answer/id #uuid "a88484f5-b344-5db6-b1d4-105554bbb0f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474600} :answer-field/id #uuid "9a7c415d-face-5047-bf43-5a7f46334342" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475226}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "03f10976-674d-5f7f-9c6a-ec5de8c4e5cb" :question/math-academy-id "q-183510" :question/problem "$\\,$ $P(x):$ $x=-1$ $\\,$ $Q(x):$ $(x-1)(x+1)=0$\n\nConsider the predicates $P(x)$ and $Q(x)$ above. Which of the following expresses the conditional predicate $P(x)⇒Q(x)?$\n- **I.** $x=-1$ is sufficient for $(x-1)(x+1)=0$\n- **II.** $x=-1$ is necessary for $(x-1)(x+1)=0$\n- **III.** For $(x-1)(x+1)=0,$ it is necessary that $x=-1$\n- **IV.** For $x=-1,$ it is sufficient that $(x-1)(x+1)=0$\n\nSelect all that apply." :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ is a *sufficient condition* for $N.$\n\n- $N$ is a *necessary condition* for $S.$\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nWe have the following grammatical constructions for $S⇒N:$\n\n- $S$ is sufficient for $N$\n\n- For $N,$ it is sufficient that $S$\n\n- $N$ is necessary for $S$\n\n- For $S,$ it is necessary that $N$\n\nWith that in mind, let's examine the given options.\n\n- Option I reads\n\n$$\n{{x=-1}_{⏟}}_{P(x)}\\,\\text{is sufficient for}\\,{{(x-1)(x+1)=0}_{⏟}}_{Q(x)}\n$$\n\nwhich corresponds to $P(x)⇒Q(x).$ $\\,✓$\n\n- Option II reads\n\n$$\n{{x=-1}_{⏟}}_{P(x)}\\,\\text{is necessary for}\\,{{(x-1)(x+1)=0}_{⏟}}_{Q(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option III reads\n\n$$\n\\text{for}\\,{{(x-1)(x+1)=0,}_{⏟}}_{Q(x)}\\,\\text{it is necessary that}\\,{{x=-1}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option IV reads\n\n$$\n\\text{for}\\,{{x=-1,}_{⏟}}_{P(x)}\\,\\text{it is sufficient that}\\,{{(x-1)(x+1)=0}_{⏟}}_{Q(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186421142 :knowledge-point/_questions [{:db/id #edb/ref 17592186198282 :knowledge-point/id #uuid "0809c075-e1be-5d49-b1fe-5433114bcf16" :knowledge-point/title "\"If-Then\", \"If\", \"Only If\", and \"Implies\""}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0945ef13-941d-515b-b4ae-e682b2cbe6eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474580} {:answer/id #uuid "d9b76547-30ba-5674-aaf4-f6a21243637d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474581}] :answer-field/correct {:answer/id #uuid "0945ef13-941d-515b-b4ae-e682b2cbe6eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474580} :answer-field/id #uuid "6fb3d849-75e4-5708-89e8-c4fd195fa85d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475216} {:answer-field/choices [{:answer/id #uuid "0b099b78-69e8-5b08-9c8f-7877b9604ed9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474582} {:answer/id #uuid "0570949e-7425-5fb0-95d5-a3cd6859565f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474583}] :answer-field/correct {:answer/id #uuid "0b099b78-69e8-5b08-9c8f-7877b9604ed9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474582} :answer-field/id #uuid "cbb6a5ff-7a9b-5d17-a103-5773db20bbb1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475217} {:answer-field/choices [{:answer/id #uuid "85f5f97c-ac05-5910-a741-ba015942a833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474584} {:answer/id #uuid "e3cf666e-1401-5ea9-a173-e0abeab42ac4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474585}] :answer-field/correct {:answer/id #uuid "85f5f97c-ac05-5910-a741-ba015942a833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474584} :answer-field/id #uuid "8031bcc8-9793-503b-baef-a85091ae70ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475218} {:answer-field/choices [{:answer/id #uuid "8a358e67-66e9-5231-ae52-d2a6a5099375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474586} {:answer/id #uuid "24a68289-9468-5c6a-a2f8-ee91ce1c5a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474587}] :answer-field/correct {:answer/id #uuid "24a68289-9468-5c6a-a2f8-ee91ce1c5a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474587} :answer-field/id #uuid "b21175e6-3a06-52f7-895c-d02b438ccfe3" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475219}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e0b252f-632c-5fb4-955e-f2c2686886d5" :question/math-academy-id "q-183448" :question/problem "$\\,$ $P(x):$ $x=2$ $\\,$ $Q(x):$ ${x}^{2}=4$\n\nConsider the predicates $P(x)$ and $Q(x)$ above. Which of the following expresses the conditional predicate $P(x)⇒Q(x)?$\n- **I.** ${x}^{2}=4$ implies $x=2$\n- **II.** If ${x}^{2}=4,$ then $x=2$\n- **III.** ${x}^{2}=4$ only if $x=2$\n- **IV.** ${x}^{2}=4$ if $x=2$\n\nSelect all that apply." :question/worked-solution "Let's recall the following grammatical constructions for the implication $P⇒Q:$\n\n- If $P,$ then $Q$\n\n- $P$ only if $Q$\n\n- $Q$ if $P$\n\n- $P$ implies $Q$\n\nWith that in mind, let's examine the given options.\n\n- Option I reads\n\n$$\n{{{x}^{2}=4}_{⏟}}_{Q(x)}\\,\\text{implies}\\,{{x=2}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option II reads\n\n$$\n\\text{if}\\,{{{x}^{2}=4}_{⏟}}_{Q(x)},\\,\\text{then}\\,{{x=2}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option III reads\n\n$$\n{{{x}^{2}=4}_{⏟}}_{Q(x)}\\,\\text{only if}\\,{{x=2}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option IV reads\n\n$$\n{{{x}^{2}=4}_{⏟}}_{Q(x)}\\,\\text{if}\\,{{x=2}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $P(x)⇒Q(x).$ $\\,✓$\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186421146 :knowledge-point/_questions [{:db/id #edb/ref 17592186198284 :knowledge-point/id #uuid "b24ae815-5706-5b65-bab8-2d67f8405c9c" :knowledge-point/title "\"Whenever\", and \"Provided That\""}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c97a67bd-0eab-522a-b912-f7d7b1965ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474614} {:answer/id #uuid "9e408c6c-7a9d-5fc8-8352-2e6d614fc5fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474615}] :answer-field/correct {:answer/id #uuid "c97a67bd-0eab-522a-b912-f7d7b1965ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474614} :answer-field/id #uuid "bdba47ab-ad3c-5f97-851d-51e76579632c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475233} {:answer-field/choices [{:answer/id #uuid "327a00dd-4553-507d-8ed6-59817b49dc98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474616} {:answer/id #uuid "668c2ea7-19db-5f8f-a0a1-559b819f0c5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474617}] :answer-field/correct {:answer/id #uuid "327a00dd-4553-507d-8ed6-59817b49dc98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474616} :answer-field/id #uuid "9afb0038-f0d7-57d4-aa49-f5eccca86484" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475234} {:answer-field/choices [{:answer/id #uuid "5272c8a2-901f-5f97-b6c1-9a8da0f2647c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474618} {:answer/id #uuid "5fc7e624-31af-503c-a628-308e4e745a19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474619}] :answer-field/correct {:answer/id #uuid "5fc7e624-31af-503c-a628-308e4e745a19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474619} :answer-field/id #uuid "37b95fe8-12f9-57d5-b19a-d819c349b4a4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475235}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "50849cc0-0b42-5b52-abb5-e0bdf56880ef" :question/math-academy-id "q-183568" :question/problem "$\\,$ $P(x):$ $0\\le x<1$ $\\,$ $Q(x):$ $|x|<1$\n\nConsider the predicates $P(x)$ and $Q(x)$ above. Which of the following expresses the conditional predicate $P(x)⇒Q(x)?$\n- **I.** Whenever $|x|<1,$ then $0\\le x<1$\n- **II.** $0\\le x<1$ whenever $|x|<1$\n- **III.** $|x|<1,$ provided that $0\\le x<1$\n\nSelect all that apply." :question/worked-solution "Given that the implication $P⇒Q$ is true, we have the following:\n\n- Whenever $P,$ then $Q$\n\n- $Q$ whenever $P$\n\n- $Q,$ provided that $P$\n\nWith that in mind, let's examine the given options.\n\n- Option I reads\n\n$$\n\\text{Whenever}\\,{{|x|<1}_{⏟}}_{Q(x)},\\,\\text{then}\\,{{0\\le x<1}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option II reads\n\n$$\n{{0\\le x<1}_{⏟}}_{P(x)}\\,\\text{whenever}\\,{{|x|<1}_{⏟}}_{Q(x)}\n$$\n\nwhich corresponds to $Q(x)⇒P(x).$ $\\,\\times $\n\n- Option III reads\n\n$$\n{{|x|<1\\text{,}}_{⏟}}_{Q(x)}\\,\\text{provided that}\\,{{0\\le x<1}_{⏟}}_{P(x)}\n$$\n\nwhich corresponds to $P(x)⇒Q(x).$ $\\,✓$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186421148 :knowledge-point/_questions [{:db/id #edb/ref 17592186198284 :knowledge-point/id #uuid "b24ae815-5706-5b65-bab8-2d67f8405c9c" :knowledge-point/title "\"Whenever\", and \"Provided That\""}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ec589ad-6e14-5afe-b705-86a37c1f6e8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474602} {:answer/id #uuid "1d21f13a-49f5-5984-995b-6f89f3b94ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474603}] :answer-field/correct {:answer/id #uuid "1d21f13a-49f5-5984-995b-6f89f3b94ef4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474603} :answer-field/id #uuid "3b4b6cfc-23cb-5eb0-8919-b43d591ffb35" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475227} {:answer-field/choices [{:answer/id #uuid "ca9a59df-fa84-52b0-a9af-915827efaab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474604} {:answer/id #uuid "728b0d74-df98-5671-8d8a-5feb2fee7585" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474605}] :answer-field/correct {:answer/id #uuid "ca9a59df-fa84-52b0-a9af-915827efaab3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474604} :answer-field/id #uuid "5b9a7b66-659a-52f4-b09c-d7dfb3a71752" :answer-field/key 