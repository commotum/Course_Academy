#{[{:db/id #edb/ref 17592186272249 :knowledge-point/_questions [{:db/id #edb/ref 17592186092327 :knowledge-point/id #uuid "4eab94cb-5a5a-5915-ab95-963cb4c63817" :knowledge-point/title "Identifying Closure Properties of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "576103fa-ed39-5cc1-b3dd-aa1c41c6e6b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186270040} {:answer/id #uuid "850b62e1-b775-571c-9058-04cc09e464b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186270419} {:answer/id #uuid "b9d1b938-e87f-5462-aecb-d2ec3dd3795d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186270910} {:answer/id #uuid "d48c0194-9812-5494-b598-95ff7ec91143" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186271137} {:answer/id #uuid "d736a809-e9dd-5b1c-8eab-1c5a18819085" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186271161}] :answer-field/correct {:answer/id #uuid "850b62e1-b775-571c-9058-04cc09e464b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186270419} :answer-field/id #uuid "86c7e2f7-2db6-5d5d-9fb1-1b41e12897f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271746}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a3f0c75-73fd-5349-840a-8899dcbd367a" :question/math-academy-id "q-141240" :question/problem "Which of the following expressions are polynomials?\n\n- $(4{x}^{6}-x)+(3{x}^{5})$\n- $({x}^{3}-1)\\cdot (3-{x}^{2})$\n- $({x}^{3}-4{x}^{2})÷(x)$" :question/worked-solution "Recall that polynomials have the following closure properties:\n\n- Polynomials are closed under addition, subtraction, and multiplication. This means that the sum, difference, and product of two polynomials is *always* a polynomial.\n\n- Polynomials are *not* closed under division. This means that the quotient of two polynomials is *not* always a polynomial.\n\nWith that in mind, let's examine our expressions in turn.\n\n- Expression I is a polynomial. It's a sum of two polynomials, and polynomials are closed under addition.\n\n- Expression II is a polynomial. It's a product of two polynomials, and polynomials are closed under multiplication.\n\n- Expression III is a polynomial. Even though polynomials are *not* closed under division, the quotient of these two polynomials results in a polynomial:\n\n$$\n\\begin{aligned}({x}^{3}-4{x}^{2})÷(x) & =\\frac{{x}^{3}-4{x}^{2}}{x} \\\\  & =\\frac{x({x}^{2}-4x)}{x} \\\\  & =\\frac{\\cancel{x}({x}^{2}-4x)}{\\cancel{x}} \\\\  & ={x}^{2}-4x\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186272250 :knowledge-point/_questions [{:db/id #edb/ref 17592186092327 :knowledge-point/id #uuid "4eab94cb-5a5a-5915-ab95-963cb4c63817" :knowledge-point/title "Identifying Closure Properties of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e78141c-5b1b-5383-9436-dd7961708aa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269398} {:answer/id #uuid "377e209c-dca0-560e-b0e9-3dd954d6f5d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186269771} {:answer/id #uuid "b9af0254-5aa7-512b-b479-10e85a3c90b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186270908} {:answer/id #uuid "eba4ea75-16bf-56cf-b877-0a5e9c421d89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of these listed" :db/id #edb/ref 17592186271340} {:answer/id #uuid "f61c3215-545e-5c9e-9d54-4f213478cea5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186271429}] :answer-field/correct {:answer/id #uuid "0e78141c-5b1b-5383-9436-dd7961708aa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269398} :answer-field/id #uuid "26ded575-1ef1-5611-9129-6853eed9845c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271580}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78e46443-6b0b-52be-80af-856b64b460d2" :question/math-academy-id "q-141245" :question/problem "Which of the following expressions are polynomials?\n\n- $(3{x}^{3}-2x)÷({x}^{3})$\n- $(10{x}^{6}-4{x}^{3})÷(2{x}^{3})$\n- $(2x-1)\\cdot ({x}^{3}+6x)$" :question/worked-solution "Recall that polynomials have the following closure properties:\n\n- Polynomials are closed under addition, subtraction, and multiplication. This means that the sum, difference, and product of two polynomials is *always* a polynomial.\n\n- Polynomials are *not* closed under division. This means that the quotient of two polynomials is *not* always a polynomial.\n\nWith that in mind, let's examine our expressions in turn.\n\n- Expression I is *not* a polynomial. Carrying out the division, we get\n\n$$\n\\begin{aligned}\\frac{3{x}^{3}-2x}{{x}^{3}} & =\\frac{3{x}^{3}}{{x}^{3}}-\\frac{2x}{{x}^{3}} \\\\  & =3-\\frac{2}{{x}^{2}}\\end{aligned}\n$$\n\nwhich is *not* a polynomial.\n\n- Expression II is a polynomial. Even though polynomials are *not* closed under division, the quotient of these two polynomials results in a polynomial:\n\n$$\n\\begin{aligned}(10{x}^{6}-4{x}^{3})÷(2{x}^{3}) & =\\frac{10{x}^{6}-4{x}^{3}}{2{x}^{3}} \\\\  & =\\frac{2{x}^{3}(5{x}^{3}-2)}{2{x}^{3}} \\\\  & =\\frac{\\cancel{2{x}^{3}}(5{x}^{3}-2)}{\\cancel{2{x}^{3}}} \\\\  & =5{x}^{3}-2\\end{aligned}\n$$\n\n- Expression III is a polynomial. It's a product of two polynomials, and polynomials are closed under multiplication.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186272291 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429117a3-6e54-516f-90dc-8b3c46852d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186269870} {:answer/id #uuid "540ff262-b6d8-55d6-bdff-7a8f7374caf0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186270017} {:answer/id #uuid "953e5319-0e76-5d91-be9e-97acbe17adc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186270577} {:answer/id #uuid "c637029f-ce11-54ac-92f8-b41a82831cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186271015} {:answer/id #uuid "f27f32f7-f9d9-50bf-b772-90b1d8509143" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186271401}] :answer-field/correct {:answer/id #uuid "f27f32f7-f9d9-50bf-b772-90b1d8509143" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186271401} :answer-field/id #uuid "9f70c062-2c20-514b-a050-6ed7cd19ecf6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271795}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "496f9381-a057-5d31-a929-726bf731d70b" :question/math-academy-id "q-141495" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and ${v}_{1},{v}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If $2T({v}_{1})-3T({v}_{2})=0$ and ${v}_{1}\\ne k{v}_{2}$ for all $k\\in R$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)\\ne {0}$\n- $\\text{Im}(T)={R}^{3}$\n- $T$ is invertible" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $2T({v}_{1})-3T({v}_{2})=0$ and $T$ is a linear transformation, we have $T(2{v}_{1}-3{v}_{2})=0$ which means $2{v}_{1}-3{v}_{2}\\in \\text{Ker}(T).$   Since ${v}_{1}\\ne k{v}_{2}$,  we must have $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is false. Since $\\text{Ker}(T)\\ne {0}$, then according to the invertible matrix theorem, the transformation $T$ is not a bijection. Since $T$ is not a bijection, then by the invertible matrix theorem, $\\text{Im}(T)\\ne {R}^{3}.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{3},$ the corresponding matrix $T$ can't be invertible.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186272301 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09aa63a2-fcd6-59c7-b8d5-c7ae94cea07b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186269357} {:answer/id #uuid "222c1fca-f9be-5ece-b1ab-40086be18680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269563} {:answer/id #uuid "a1454b89-eae8-5cc9-b299-541dbb47ae01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186270698} {:answer/id #uuid "cebbe3cb-717f-56f5-b65c-230ba3342707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186271082} {:answer/id #uuid "f48fdfad-2d33-560f-be43-a5d4c13ef17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186271412}] :answer-field/correct {:answer/id #uuid "222c1fca-f9be-5ece-b1ab-40086be18680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269563} :answer-field/id #uuid "ddf7ad5e-33c5-5362-84f5-c267e5402f28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271899}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c4507db3-2027-5030-88fd-955381171b17" :question/math-academy-id "q-141569" :question/problem "Let $T:{R}^{4}\\to {R}^{4}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $\\text{nullity}(T)=4,$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Im}(T)={R}^{4}$\n- $T$ is not invertible\n- $\\text{rank}(T)\\ne 4$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{4}$ into ${R}^{4},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{4} \\\\  & \\text{rank}(T)=4 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $\\text{nullity}(T)\\ne 0,$ the invertible matrix theorem implies that $\\text{Im}(T)\\ne {R}^{4}.$\n\n- Statement II is true. Indeed, since $\\text{nullity}(T)\\ne 0,$ the invertible matrix theorem implies that $T$ is not invertible.\n\n- Statement III is true. Indeed, since $T$ is not invertible, the invertible matrix theorem implies that $\\text{rank}(T)\\ne 4.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186272302 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30b3cb5a-341a-59e5-a715-d12977c5bed1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269708} {:answer/id #uuid "5fe66b4f-fc34-5672-a3db-4734e66a55a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186270116} {:answer/id #uuid "96a19ab7-cc61-5293-86a8-bafa6581e8e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186270594} {:answer/id #uuid "cb05382b-ecd7-547d-89c0-4aef033b29c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186271053} {:answer/id #uuid "da7eed7b-ee2d-5936-b766-061ccc59fa6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186271181}] :answer-field/correct {:answer/id #uuid "96a19ab7-cc61-5293-86a8-bafa6581e8e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186270594} :answer-field/id #uuid "32ad95d2-baf4-5b0d-81cc-ba23c5a39a70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271601}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2805dfb0-8d9a-5775-8051-a005b74b03a8" :question/math-academy-id "q-141584" :question/problem "Let $T:{R}^{6}\\to {R}^{6}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If ${v}_{1}\\ne {v}_{2}$ vectors such that $T({v}_{1})=T({v}_{2})$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $\\text{Ker}(T)\\ne {0}$\n- $\\text{Im}(T)={R}^{6}$\n- $T$ is not a bijection" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$\n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne {0},$ the transformation $T$ and the matrix $T$ are not invertible. Since $T$ is not invertible, by the invertible matrix theorem, we must have that $\\text{Im}(T)\\ne {R}^{6}.$\n\n- Statement III is true. Since $\\text{Im}(T)\\ne {R}^{6},$ the invertible matrix theorem implies that the transformation $T$ is not a bijection.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186272306 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093de82c-3c10-509e-a115-10c02890e9d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186269353} {:answer/id #uuid "138068fd-1aed-52e6-ac5f-add922c4dca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269443} {:answer/id #uuid "3638d5d5-8aa0-56ce-b0f5-e70107346880" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186269762} {:answer/id #uuid "f79af8a6-d754-5246-a9ad-95b33a49ce2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186271441} {:answer/id #uuid "fdae7495-8e53-5c68-9f1d-812a9ee8c272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186271490}] :answer-field/correct {:answer/id #uuid "fdae7495-8e53-5c68-9f1d-812a9ee8c272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186271490} :answer-field/id #uuid "fd64f202-1cd1-5be2-bcac-f3c8e7039c15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271947}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bb3b4f0-a153-5b1f-93aa-f136a6132e95" :question/math-academy-id "q-141751" :question/problem "![](images/9d/9d5ea7e13fa03ac553893aa78aa7ee32ac7b67f2eb19dff32228d53bf2010aa2.png)\n\nWhich of the curves above are concave down?" :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graphs I and III curve downward (like a \"frown\") among the given graphs."}] [{:db/id #edb/ref 17592186272307 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5177ea3a-9272-590f-8f16-d605b524db47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269998} {:answer/id #uuid "5c3a782a-c7a0-5f39-9b30-7e1f9ae49e1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186270090} {:answer/id #uuid "7cc2623b-ee3b-5cc2-863d-41dcce18a077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186270363} {:answer/id #uuid "a640d8d9-7217-514b-aa3a-b01bab9dbd46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186270757} {:answer/id #uuid "be7733e3-82d9-51c4-9a92-5cf1de7b00b8" :answer/type {:db/id #edb/ref 1759218604