 17592186470918}] :answer-field/correct {:answer/id #uuid "b04a0c5d-b21d-5101-a91e-bc864fce5510" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470918} :answer-field/id #uuid "7408ee2a-0562-5e99-aa8a-b89c948b1863" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471964}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9e6cde4-30d8-5716-a4a4-97a88908653f" :question/math-academy-id "q-120485" :question/problem "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\nI. $\\operatorname{sec}⁡x=7$ $$\n\nII. $\\sqrt{3}\\operatorname{sec}⁡x+2=2\\sqrt{3}\\operatorname{sec}⁡x$ $$\n\nIII. $7\\operatorname{sec}⁡x=-5$\n\nSelect all that apply." :question/worked-solution "We first simplify the given equations, and get\n\nI. $\\operatorname{sec}⁡x=7$ $$\n\nII. $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$\n\nIII. $\\operatorname{sec}⁡x=-\\frac{5}{7}$\n\nNow, recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186400010 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66f296a5-d222-5587-a23d-1967ae632d36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470919} {:answer/id #uuid "a430533a-bbf3-5ad3-8131-64f0a6804873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470920}] :answer-field/correct {:answer/id #uuid "66f296a5-d222-5587-a23d-1967ae632d36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470919} :answer-field/id #uuid "27b89765-7e46-500d-abca-87947d1ed3f6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471965} {:answer-field/choices [{:answer/id #uuid "dadd2217-e49e-5f1e-8af9-32e94905a1b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470921} {:answer/id #uuid "13e8e11d-6a9f-5ab7-881d-a4454249cd73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470922}] :answer-field/correct {:answer/id #uuid "13e8e11d-6a9f-5ab7-881d-a4454249cd73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470922} :answer-field/id #uuid "8bfff45f-b8f2-5694-82a6-ad18fca649dc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471966} {:answer-field/choices [{:answer/id #uuid "6931c32d-d966-579a-b5c5-68ddbdd40f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470923} {:answer/id #uuid "8dfef6ab-2ae2-58e0-8d5c-633b0dda33e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470924}] :answer-field/correct {:answer/id #uuid "8dfef6ab-2ae2-58e0-8d5c-633b0dda33e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470924} :answer-field/id #uuid "53a5e2e5-ccd9-5c96-bb9a-edc9756bc9a4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471967}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93bbf63d-41f5-5cec-8b52-34cf770cf20e" :question/math-academy-id "q-120614" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $5-\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x$\n\nII. $\\sqrt{2}\\operatorname{csc}⁡x=2-\\sqrt{2}\\operatorname{csc}⁡x$\n\nIII. $5\\operatorname{csc}⁡x-3=-2$\n\nSelect all that apply." :question/worked-solution "We first simplify the given equations, and get\n\nI. $\\operatorname{csc}⁡x=1$\n\nII. $\\operatorname{csc}⁡x=\\frac{\\sqrt{2}}{2}$\n\nIII. $\\operatorname{csc}⁡x=\\frac{1}{5}$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equations II and III has no solutions."}] [{:db/id #edb/ref 17592186400093 :knowledge-point/_questions [{:db/id #edb/ref 17592186096740 :knowledge-point/id #uuid "1d14dbef-9a16-537e-a182-87fd6853e543" :knowledge-point/title "Identifying Divergent Sequences"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57570228-8466-52cb-a11f-f04e18706442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470931} {:answer/id #uuid "ef8642b5-04f8-5c37-a14b-aed7ee7a7659" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470932}] :answer-field/correct {:answer/id #uuid "57570228-8466-52cb-a11f-f04e18706442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470931} :answer-field/id #uuid "2ffa6fff-c4b5-5b71-b3d9-ad640d9a3224" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471971} {:answer-field/choices [{:answer/id #uuid "b5d09e71-31ad-54bf-8cea-1a8f785b490a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470933} {:answer/id #uuid "022b26c2-7d25-5b06-a964-476aa350c72c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470934}] :answer-field/correct {:answer/id #uuid "022b26c2-7d25-5b06-a964-476aa350c72c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470934} :answer-field/id #uuid "528c0afa-a7a6-540b-be79-d029b67039c3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471972} {:answer-field/choices [{:answer/id #uuid "0c6fcdbe-5b61-5426-9e91-ddd477fc741b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470935} {:answer/id #uuid "7fe5aeb4-873c-584e-ac06-a0748a68d7f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470936}] :answer-field/correct {:answer/id #uuid "0c6fcdbe-5b61-5426-9e91-ddd477fc741b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470935} :answer-field/id #uuid "e500961e-1c74-5a51-95f4-6ce13652944a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471973}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4187c6ec-17d9-5b83-9a20-6aff01cc94de" :question/math-academy-id "q-123315" :question/problem "Which of the following sequences diverge?\n\nI. ${a}_{n}=\\frac{{n}^{5}}{2{n}^{5}-1}$ for $n\\ge 1$\nII. ${a}_{n}=\\frac{n-{n}^{5}}{2-{n}^{4}}$ for $n\\ge 1$\nIII. ${a}_{n}=\\frac{5}{{n}^{6}}$ for $n\\ge 1$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each sequence in turn. We need to calculate the limit of each sequence as $n$ approaches infinity.\n\n- In sequence I,  the dominant term in the denominator is $2{n}^{5},$ so we divide the numerator and the denominator by ${n}^{5}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{{n}^{5}}{2{n}^{5}-1} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{{n}^{5}}{{n}^{5}})}{(\\frac{2{n}^{5}}{{n}^{5}}-\\frac{1}{{n}^{5}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{1}{(2-\\frac{1}{{n}^{5}})} \\\\  & =\\frac{1}{2-0} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence II, the dominant term in the denominator is $-{n}^{4},$ so we divide the numerator and the denominator by ${n}^{4}$ and get\n\n$$\n\\begin{aligned}{lim}_{n\\to \\infty }{a}_{n} & ={lim}_{n\\to \\infty }\\frac{n-{n}^{5}}{2-{n}^{4}} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{n}{{n}^{4}}-\\frac{{n}^{5}}{{n}^{4}})}{(\\frac{2}{{n}^{4}}-\\frac{{n}^{4}}{{n}^{4}})} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\frac{1}{{n}^{3}}-n)}{(\\frac{2}{{n}^{4}}-1)} \\\\  & ={lim}_{n\\to \\infty }\\frac{0-n}{0-1} \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges.\n\n- In sequence III,  the limit is\n\n$$\n{lim}_{n\\to \\infty }{a}_{n}={lim}_{n\\to \\infty }\\frac{5}{{n}^{6}}=0.\n$$\n\nThe limit exists, so the sequence converges.\n\nIn conclusion, sequence II diverges."}] [{:db/id #edb/ref 17592186400149 :knowledge-point/_questions [{:db/id #edb/ref 17592186078493 :knowledge-point/id #uuid "62736299-f6d6-503f-a5d1-e1091e8b0429" :knowledge-point/title "Identifying Convergent Geometric Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4259c2a-e037-547f-ba6f-c09ebc5c66e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470937} {:answer/id #uuid "93b837fb-dba3-5553-903e-a4ce54621dfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470938}] :answer-field/correct {:answer/id #uuid "d4259c2a-e037-547f-ba6f-c09ebc5c66e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470937} :answer-field/id #uuid "b837ace8-23d9-5324-878d-853d536782fd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471974} {:answer-field/choices [{:answer/id #uuid "b9227e56-d78e-5113-b51b-4b43a7893634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470939} {:answer/id #uuid "76dafe01-8b75-51aa-95ee-e47c3e5b805d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470940}] :answer-field/correct {:answer/id #uuid "76dafe01-8b75-51aa-95ee-e47c3e5b805d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470940} :answer-field/id #uuid "7dcaf81f-0ef1-5a8a-bef8-bc4b434fc677" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471975} {:answer-field/choices [{:answer/id #uuid "c50ac6cc-b478-5878-9ce1-12b1bc9ba137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470941} {:answer/id #uuid "e8414a63-aa61-5abf-b05d-7a72e20164ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470942}] :answer-field/correct {:answer/id #uuid "c50ac6cc-b478-5878-9ce1-12b1bc9ba137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470941} :answer-field/id #uuid "0e23d4f5-0d62-58e8-b892-40daa1d8e271" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471976}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "55c1789a-3f1b-5ebc-a34c-eaab270f436c" :question/math-academy-id "q-124912" :question/problem "Which of the following geometric series converge?\n\nI. $-1+1-1+1-⋯$\nII. $\\frac{4}{3}-1+\\frac{3}{4}-\\frac{9}{16}+⋯$\nIII. $0.1+0.11+0.121+0.133\\,1+⋯$\n\nSelect all that apply." :question/worked-solution "Let's look at each series in turn.\n\n- For the geometric series $-1+1-1+1-⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{1}{-1} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, the series is divergent because $|r|\\ge 1.$\n\n- For the geometric series $\\frac{4}{3}-1+\\frac{3}{4}-\\frac{9}{16}+⋯$ the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{(-1)}{(\\frac{4}{3})} \\\\  & =-\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the series is convergent because $|r|<1.$\n\n- For the geometric series $0.1+0.11+0.121+0.133\\,1+⋯$  the common ratio is\n\n$$\n\\begin{aligned}r=\\frac{{a}_{2}}{{a}_{1}} & =\\frac{0.11}{0.1} \\\\  & =1.1.\\end{aligned}\n$$\n\nTherefore, the series is divergent  because $|r|\\ge 1.$\n\nIn conclusion, only series II converges."}] [{:db/id #edb/ref 17592186400170 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff4b601b-da18-5955-b9d0-8a2b5f9b0a48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470943} {:answer/id #uuid "17c12a83-e42b-50f8-9c85-6115211c2d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470944}] :answer-field/correct {:answer/id #uuid "17c12a83-e42b-50f8-9c85-6115211c2d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470944} :answer-field/id #uuid "6c97f381-c5fa-5008-855a-80efc3b0c6ab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471977} {:answer-field/choices [{:answer/id #uuid "cc2c2114-3190-5b83-8f34-e35a9c4900ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470945} {:answer/id #uuid "1908d9fe-207c-5f08-8b6f-95d5397d8477" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470946}] :answer-field/correct {:answer/id #uuid "cc2c2114-3190-5b83-8f34-e35a9c4900ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470945} :answer-field/id #uuid "35e45063-38e2-5871-b1ed-d2c81b4c50ab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471978} {:answer-field/choices [{:answer/id #uuid "82c73200-1081-50f9-98a4-483fdb53bb9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470947} {:answer/id #uuid "295d3dfa-66aa-5074-877d-d86d2e421a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470948}] :answer-field/correct {:answer/id #uuid "295d3dfa-66aa-5074-877d-d86d2e421a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470948} :answer-field/id #uuid "221f2096-c087-59ea-8dcf-0fd5271e389f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471979}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d26c1fd-9972-5992-b3ee-1cc9fed13d91" :question/math-academy-id "q-125262" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[0,e]?$\n\nI. $f(x)=\\frac{1}{{x}^{2}+1}$\nII. $g(x)=\\operatorname{ln}⁡x$\nIII. $h(x)={e}^{-x/2}$\n\nSelect all that apply." :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[0,e],$ the function must be continuous on $[0,e]$ and differentiable on $(0,e).$\n\nLet's check each function individually.\n\n- The function $f(x)=\\frac{1}{{x}^{2}+1}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it  is continuous on $[0,e]$ and differentiable on $(0,e).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function  $g(x)=\\operatorname{ln}⁡x$ is not defined at $x=0,$ so it is not continuous at $x=0,$ which means it is not continuous on $[0,e].$ Therefore, $g(x)$ does not satisfy the conditions of the mean value theorem.\n\n- The function $h(x)={e}^{-x/2}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it  is continuous on $[0,e]$ and differentiable on $(0,e).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, only functions I and III satisfy the conditions for the mean value theorem over the interval $[0,e].$"}] [{:db/id #edb/ref 17592186400205 :knowledge-point/_questions [{:db/id #edb/ref 17592186087697 :knowledge-point/id #uuid "09fa0899-a3d2-584f-8cdd-a471f8cfd16b" :knowledge-point/title "Identifying a Special Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c4b6f3-a9d9-5370-8991-9303e65c3015" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472550} {:answer/id #uuid "d564422c-47a5-5ab6-8593-71deb3c3cd69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472551}] :answer-field/correct {:answer/id #uuid "e4c4b6f3-a9d9-5370-8991-9303e65c3015" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472550} :answer-field/id #uuid "8b5d220c-18b5-57e7-a90d-58d07571e262" :answer-field/key "P" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473670} {:answer-field/choices [{:answer/id #uuid "8657c195-208d-54ba-8639-f23613e3b183" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472552} {:answer/id #uuid "9a555d27-4f3f-5c78-ba86-d3dbf70f47af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472553}] :answer-field/correct {:answer/id #uuid "8657c195-208d-54ba-8639-f23613e3b183" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472552} :answer-field/id #uuid "3ea2960f-36ab-5c79-bcb0-d8d666e973a1" :answer-field/key "Q" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473671} {:answer-field/choices [{:answer/id #uuid "f0bdef0e-9550-5f87-ab43-3dab5f492509" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472554} {:answer/id #uuid "5ded35e1-51c9-575b-8ae1-105fd098c53b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186472555}] :answer-field/correct {:answer/id #uuid "f0bdef0e-9550-5f87-ab43-3dab5f492509" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472554} :answer-field/id #uuid "55893052-4f9b-5d44-8cc1-a03cc42802a9" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186473672}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8674af78-bd5e-58b6-917b-e86f01702cc2" :question/math-academy-id "q-126222" :question/problem "Which of the following are diagonal matrices?\n\n$$\nP=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0\\text{ }\\end{aligned}],\\,Q=[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 1 & 2 \\\\ 2 & 1\\end{aligned}],\\,R=[\\begin{aligned}1 & 0 & 5 \\\\ 0 & -2 & 0 \\\\ 7 & 0 & -3\\end{aligned}]\n$$\n\nSelect all that apply." :question/worked-solution "- $P$ is *not* a diagonal matrix since it's not a square matrix.\n\n- $Q$ is *not* a diagonal matrix since it's not a square matrix.\n\n- $R$ is *not* a diagonal matrix. It's a square matrix since it has the same number of rows and columns. But some of the entries that do not lie on the main diagonal are not zeros (for instance, ${r}_{31}=7\\ne 0$).\n\nTherefore, none of the given are diagonal matrices."}] [{:db/id #edb/ref 17592186400212 :knowledge-point/_questions [{:db/id #edb/ref 17592186087696 :knowledge-point/id #uuid "3ca13445-0218-5950-967e-a68bcfec32c7" :knowledge-point/title "Identifying a Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe07e794-5c3c-56f1-8396-62bc348bcd57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186472556} {:answer/id #uuid "68410942-ac37-56e