id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471953} {:answer-field/choices [{:answer/id #uuid "9af54704-1eb3-54d7-b7f8-119da98bd623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470897} {:answer/id #uuid "5a18a8d2-8505-50d1-afc4-88dd6cf30f33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470898}] :answer-field/correct {:answer/id #uuid "5a18a8d2-8505-50d1-afc4-88dd6cf30f33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470898} :answer-field/id #uuid "da6b40a6-e64e-5d5f-b1fa-1bb9cc1269a3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471954} {:answer-field/choices [{:answer/id #uuid "f7b7aeec-9d82-5096-b408-2c21e8eebfc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470899} {:answer/id #uuid "7e04d5c1-e106-513e-a70b-70e993921a51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470900}] :answer-field/correct {:answer/id #uuid "f7b7aeec-9d82-5096-b408-2c21e8eebfc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470899} :answer-field/id #uuid "ef80172d-e2dd-5d28-ad7c-7f046bab6e53" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471955}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d42d29a1-7ec6-555e-8ef7-3216eb563375" :question/math-academy-id "q-117369" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\nI. $(-1,-\\frac{\\pi }{4})$\nII. $(\\sqrt{3},\\frac{\\pi }{3})$\nIII. $(\\frac{\\pi }{4},1)$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(-1,-\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{4},-1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-1,-\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(\\frac{\\pi }{4},1).$ We note the following:\n\n- The point $(1,\\frac{\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{tan}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{\\pi }{4},1)$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186400003 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer