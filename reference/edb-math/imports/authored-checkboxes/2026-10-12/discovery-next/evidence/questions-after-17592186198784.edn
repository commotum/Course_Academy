1f3-b2d3-cc1222c5d906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461472} :answer-field/id #uuid "8e4ca1a8-ea04-5785-aaa6-1097c70f54ba" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c2f74bb-ddf4-5d4c-b244-ad5b6a694598" :question/math-academy-id "q-106897" :question/problem "Which of the following vector spaces has a dimension of $10?$\n- **I.** ${R}_{10}[t]$, the vector space of all polynomials in the variable $t$ of degree at most $10$\n- **II.** ${\\text{M}}_{5}(R)$, the vector space of all $5\\times 5$ matrices over $R$\n- **III.** ${R}^{10}$\n\nSelect all that apply." :question/worked-solution "Let's examine each of the vector spaces in turn.\n\n- Recall that $\\text{dim}({R}_{n}[t])=n+1.$ Therefore, \n\n$$\n\\text{dim}({R}_{10}[t])=10+1=11\\ne 10.\\,\\times \n$$\n- Recall that $\\text{dim}({\\text{M}}_{n}(\\text{R}))={n}^{2}.$ Therefore, \n\n$$\n\\text{dim}({\\text{M}}_{5}(R))={5}^{2}=25\\ne 10.\\,\\times \n$$\n- Recall that $\\text{dim}({R}^{n})=n.$ Therefore, \n\n$$\n\\text{dim}({R}^{10})=10.\\,✓\n$$\n\nHence, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186243976 :knowledge-point/_questions [{:db/id #edb/ref 17592186152220 :knowledge-point/id #uuid "aee17e3a-031d-5c0e-9488-17410b3a2372" :knowledge-point/title "Identifying True Statements About Dimensions of Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8961339-1a5c-5154-b431-7f4c1915d7a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461473} {:answer/id #uuid "70ebb621-c996-5bb4-bb6f-d250e25c7d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :d