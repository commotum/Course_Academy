n, the correct answer is \"I, III, and IV only\"."}] [{:db/id #edb/ref 17592186240915 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57c8f80d-5991-5206-a1b2-38caf7aa359d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461319} {:answer/id #uuid "e25e4416-ea07-5eb7-b441-47cd6015ea3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461320}] :answer-field/correct {:answer/id #uuid "e25e4416-ea07-5eb7-b441-47cd6015ea3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461320} :answer-field/id #uuid "22b0ac12-6f4b-57f7-b1c8-21868a244636" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462413} {:answer-field/choices [{:answer/id #uuid "943a9c98-eb49-5c74-ace5-9578cf05df3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186461321} {:answer/id #uuid "5c850f8f-2bac-5652-995c-629b83777058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461322}] :answer-field/correct {:answer/id #uuid "5c850f8f-2bac-5652-995c-629b83777058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186461322} :answer-field/id #uuid "ce737deb-0113-5ad4-a76e-5014bc5cb3e5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186462414} {:answer-field/choices [{:answer/id #uuid "339c2a10-df81-5d77-8a1d-