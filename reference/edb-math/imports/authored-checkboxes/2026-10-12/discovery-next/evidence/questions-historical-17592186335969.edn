92186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336464} {:answer/id #uuid "6ec3338e-5dc8-51db-bfb6-74b55d4efe5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337013} {:answer/id #uuid "715422e7-0f13-5981-b899-ff599464c03e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186337045} {:answer/id #uuid "8648494b-e924-5c2c-9ea0-e87367ae71b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337247} {:answer/id #uuid "a1e52c73-e245-5532-aa9e-cc0fde9e9d97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337498}] :answer-field/correct {:answer/id #uuid "8648494b-e924-5c2c-9ea0-e87367ae71b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337247} :answer-field/id #uuid "f311d111-581f-59e1-8837-7f929a884ad6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d44ff842-4620-550a-bab6-87cb0a1ac002" :question/math-academy-id "q-71179" :question/problem "Given that \n\n$$\n\\begin{aligned}g(x) & ={\\begin{aligned}3x, & x\\ne 4 \\\\ 13, & x=4,\\end{aligned}\\end{aligned}\n$$\n\nwhich of the following statements are true?\n\n- ${lim}_{x\\to {4}^{+}}g(x)={lim}_{x\\to {4}^{-}}g(x)$\n- ${lim}_{x\\to 4}g(x)=g(4)$\n- $g(x)$ has a removable discontinuity at $x=4$" :question/worked-solution "Let's check our continuity conditions:\n\n- $g(4)=13$ exists$\\,\\,✓$\n\n- The left and right-sided limits are\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{4}^{-}}g(x) & ={lim}_{x\\to \\,{4}^{-}}3x=12, \\\\ {lim}_{x\\to \\,{4}^{+}}g(x) & ={lim}_{x\\to \\,{4}^{+}}3x=12.\\end{aligned}\n$$\n\nSince the left and right-sided limits are equal, we conclude that statement I is true and\n\n$$\n{lim}_{x\\to 4}g(x)=12.\\,\\,✓\n$$\n\n- The value of the limit is ${lim}_{x\\to 4}g(x)=12,$ while the value of the function is $g(4)=13.$ So, statement II is false and\n\n$$\n{lim}_{x\\to 4}g(x)\\ne g(4)\\,\\,\\times \n$$\n\nSince the third condition failed, the function has a removable discontinuity at $x=4,$ and statement III is true.\n\nIn conclusion, only statements I and III are true."}] [{:db/id #edb/ref 17592186338935 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03afa3f4-6ea9-5c81-a348-fa186894d2eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186336065} {:answer/id #uuid "2a4d62de-3a97-57b8-be6c-ba2fc6704e58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336427} {:answer/id #uuid "acd31018-2732-5a9d-97a2-4de86a5828c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337585} {:answer/id #uuid "c4f8155b-65ed-551d-a9b8-5cddb95b41cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337783} {:answer/id #uuid "e7a2d819-9cd3-5847-8953-1d7a843d477a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186338057}] :answer-field/correct {:answer/id #uuid "acd31018-2732-5a9d-97a2-4de86a5828c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337585} :answer-field/id #uuid "47214f3b-43c1-54f5-a0d8-4d5bdf8ec580" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e04ff7ee-ed94-5861-b7e8-a3f79254490c" :question/math-academy-id "q-71391" :question/problem "The level curves of the function $f(x,y)=\\frac{2{x}^{2}+3{y}^{2}-4}{{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=3$ gives a hyperbola\n- $c=0$ gives an ellipse\n- $c=1$ gives a circle" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\frac{2{x}^{2}+3{y}^{2}-4}{{y}^{2}} & =c \\\\ 2{x}^{2}+3{y}^{2}-4 & =c{y}^{2} \\\\ 2{x}^{2}+(3-c){y}^{2} & =4\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=3$ then the level curves are $x=\\pm \\sqrt{2},$ which consists of two vertical lines.\n\n- If $c=0$ then the level curve is $2{x}^{2}+3{y}^{2}=4,$ which is an ellipse.\n\n- If $c=1$ then the level curve is ${x}^{2}+{y}^{2}=2,$ which is a circle.\n\nSo, only statements II and III are true."}] [{:db/id #edb/ref 17592186338937 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a905dcc-7062-5ba9-9481-732d5b5264b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336131} {:answer/id #uuid "92663878-d31f-5b9a-82dc-e0531f783d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337363} {:answer/id #uuid "9e18aeef-f61b-5c4d-a0f7-d57397008dc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337462} {:answer/id #uuid "a5ece99e-e9d1-5800-b5d5-2a569fbee7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337538} {:answer/id #uuid "c045c018-7da4-5278-a1f9-dc81aff7cf6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337739}] :answer-field/correct {:answer/id #uuid "92663878-d31f-5b9a-82dc-e0531f783d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337363} :answer-field/id #uuid "c4f5ebcf-28da-59c5-ae3f-90358c258495" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338631}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b94a6f8a-60a9-5806-9e18-4814d39c5835" :question/math-academy-id "q-71395" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}-2{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\nI. $c=1$ gives a line\n\nII. $c=2$ gives a hyperbola\n\nIII. $c=0$ gives two lines" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-2{y}^{2}} & =c \\\\ {x}^{2}-2{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=1$ then the level curve is ${x}^{2}-2{y}^{2}=1,$ which is not a line.\n\n- If $c=2$ then the level curve is ${x}^{2}-2{y}^{2}=4,$ which is a hyperbola.\n\n- If $c=0$ then the level curve is $y=\\pm \\frac{x}{\\sqrt{2}},$ which consists of two lines.\n\nSo, only statements II and III are true."}] [{:db/id #edb/ref 17592186338988 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b674f7a-25d9-5f6b-9857-8fdce265e72a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336284} {:answer/id #uuid "225f0767-63be-518e-a5bf-baea693e346a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336353} {:answer/id #uuid "5ba35cbb-90df-55e2-b446-b761afe65d3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336865} {:answer/id #uuid "742e3dd0-d8b6-5c11-9e94-7709534a2413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337075} {:answer/id #uuid "edf09fa1-30d1-54e1-bbc3-a280e8820fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186338112}] :answer-field/correct {:answer/id #uuid "edf09fa1-30d1-54e1-bbc3-a280e8820fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186338112} :answer-field/id #uuid "817fc8b5-b8fe-5b39-802d-d08801384e9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338507}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1e22680-b6e5-5705-939d-f4a384a3db7e" :question/math-academy-id "q-71791" :question/problem "Which of the following sets are closed?\n\n- $(3,5)\\cup [2,3)$\n- $[-1,1]$\n- $(0,2]\\cup (7,10]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[-1,1]$ is closed. The boundary points are $-1$, and $1.$ All of them lie in the set.\n\nThe other sets are not closed because:\n\n- $(3,5)\\cup [2,3)$ has a boundary point $3$, which does not lie in the set.\n\n- $(0,2]\\cup (7,10]$ has a boundary point $0$, which does not lie in the set.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186338989 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a950bae-a0dc-516e-a6da-d49abd3ddb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336429} {:answer/id #uuid "a4da8b60-1761-5db2-bbc6-23876dc9e1d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337529} {:answer/id #uuid "be6ccf1d-9a89-59b4-bcc1-ec4de6d5b210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337724} {:answer/id #uuid "da0d2b1d-9554-503f-9437-f6bc4dee0644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337931} {:answer/id #uuid "f4708771-0601-5132-9251-09f500e6cb5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186338167}] :answer-field/correct {:answer/id #uuid "a4da8b60-1761-5db2-bbc6-23876dc9e1d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337529} :answer-field/id #uuid "c988a9b1-2f1a-544f-aff6-2e0d71da90c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20e43566-ea3c-59ee-a80b-84f1522c9eea" :question/math-academy-id "q-71798" :question/problem "Which of the following sets are open?\n\nI. $(-\\infty ,-2)$\n\nII. $(0,2]\\cup [7,9]$\n\nIII. $[-5,-1]\\cup (2,4)$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-\\infty ,-2)$ is open. The boundary point of the set is $-2$ and it does not lie in the set.\n\nThe other sets are not open because:\n\n- $(0,2]\\cup [7,9]$ has four boundary points $0$, $2$, $7$, and $9$, and the points $2$, $7$, and $9$ lies in the set.\n\n- $[-5,-1]\\cup (2,4)$ has four boundary points $-5$, $-1$, $2$, and $4$, and the points $-5$ and $-1$ lie in the set.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186338991 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0012e9cc-af21-59ec-a97b-dcb82f9e5ddb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336030} {:answer/id #uuid "1dab3ced-c7f9-566a-9417-2e0b27a6a4c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336308} {:answer/id #uuid "4b26b5b0-3a27-5c4f-a158-69cddf0a1bd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336726} {:answer/id #uuid "7bc0d3b6-9b69-5865-97af-0b453225227a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337151} {:answer/id #uuid "8fe019e4-4f70-504a-a6c3-0a622e10ef27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337332}] :answer-field/correct {:answer/id #uuid "1dab3ced-c7f9-566a-9417-2e0b27a6a4c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336308} :answer-field/id #uuid "91b4065d-5e15-57b6-820e-26f308d7946b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338547}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be4bb9a2-432f-5bf7-aa6c-466035df5777" :question/math-academy-id "q-71802" :question/problem "Which of the following sets are open?\n\n- $[-7,1]$\n- $(-1,3]\\cup [4,5)$\n- $(-5,-1)$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-5,-1)$ is open. The boundary points are $-5$, and $-1.$ None of them lie in the set.\n\nThe other sets are not open because:\n\n- $[-7,1]$ has two boundary points $-7$, and $1$, and both of them lie in the set.\n\n- $(-1,3]\\cup [4,5)$ has four boundary points $-1$, $3$, $4$, and $5$, and the points $3$ and $4$ lie in the set.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186338993 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39cf0de3-8586-5a80-9765-fc15ba42c46e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336576} {:answer/id #uuid "58acf433-8e2d-5202-98f0-948f7ab6f841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336842} {:answer/id #uuid "744377f7-616f-53fe-8956-33395bca738f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337078} {:answer/id #uuid "9faf3b1c-83dd-58e9-94dc-8563f19f9873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337477} {:answer/id #uuid "a15f9904-0853-571b-95c3-d7479f11a3ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337494}] :answer-field/correct {:answer/id #uuid "9faf3b1c-83dd-58e9-94dc-8563f19f9873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337477} :answer-field/id #uuid "7f7b347c-d8ac-5574-a932-e414cda7b1ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1615097-eb1e-5984-b134-50e4277f6126" :question/math-academy-id "q-71814" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}:\\text{ }x<y<{x}^{2},\\,1<x\\le 2\\}$\n\nII. $\\{(x,y)\\in {R}^{2}:\\text{ }2<y<x\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}:\\text{ }4\\le {x}^{2}+{y}^{2}<9\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,3).$ On the other hand, it does not contain some other boundary points, for example, the point $(2,2).$\n\n- The second set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,0).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186338994 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034ee953-8e42-5d4f-9ffd-643223680ded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336061} {:answer/id #uuid "6e2e659c-5d07-52c4-b526-23b3bfb65498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337010} {:answer/id #uuid "a6ee5674-04b9-5043-b281-83cb64765c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337542} {:answer/id #uuid "b5423d8f-866a-57fb-bf8c-161986bd620e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337645} {:answer/id #uuid "ba69c603-d9dc-5d2b-97b6-5045ea9697f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337683}] :answer-field/correct {:answer/id #uuid "6e2e659c-5d07-52c4-b526-23b3bfb65498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337010} :answer-field/id #uuid "81c3396a-b700-5d8b-a2a8-a611018f6a4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8018b9d7-b35d-54ca-b97a-1ac935d3c057" :question/math-academy-id "q-71815" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}:\\text{ }2x+y<6,\\,0<x<3}$\n- ${(x,y)\\in {R}^{2}:\\text{ }1\\le x<3,\\,2<y\\le 4}$\n- ${(x,y)\\in {R}^{2}:\\text{ }2{x}^{2}+3{y}^{2}<6}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,4).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third set is *open *since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186338997 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72e2207b-6055-51e8-b7a7-061a705d6dd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337066} {:answer/id #uuid "c144e221-9cad-536d-88a0-6a790cfd45a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337748} {:answer/id #uuid "ce3e80f8-20a8-5657-8f6a-fe53342b0195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337837} {:answer/id #uuid "d1da01dd-af9e-59c1-b556-cce9316f423b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337869} {:answer/id #uuid "fe1efdb1-2fef-576a-9d2e-70d7b90bcb04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186338260}] :answer-field/correct {:answer/id #uuid "c144e221-9cad-536d-88a0-6a790cfd45a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337748} :answer-field/id #uuid "a372a90e-3a78-5b4d-91cf-9dfd092483e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef298213-bf03-538b-9273-2913d7465266" :question/math-academy-id "q-71819" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,1\\le x\\le 3,\\,0<{y}^{2}\\le 2\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}<9,\\,1<{y}^{2}<4\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,0\\le x<1,\\,{y}^{2}<4\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,\\sqrt{2}).$ On the other hand, it does not contain some boundary points, for example, the point $(1,0).$\n\n- The second set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(0,2).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186338998 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4acd24fd-f5ea-50cf-9dad-9929014c3768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336720} {:answer/id #uuid "78c37609-0b21-50bd-824a-787ead460fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337119} {:answer/id #uuid "7d1050c0-4e22-52bb-bd91-b38c648eab7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337157} {:answer/id #uuid "b528becf-dbd1-5ac8-ba44-16cb5d5d19c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337641} {:answer/id #uuid "dd75987b-7a23-561a-b0f8-99cc85254680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337958}] :answer-field/correct {:answer/id #uuid "b528becf-dbd1-5ac8-ba44-16cb5d5d19c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337641} :answer-field/id #uuid "ad5cf70d-5c88-583b-b888-85260ecff5c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d61f9b2d-e5ea-58f1-be0f-837958c85bd6" :question/math-academy-id "q-71820" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1}$\n- ${(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}<9,\\,1<y\\le 4}$\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 9}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,4).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third is *closed* since it contains all its boundary points (the corresponding inequality is not strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186339016 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25bf70ff-b994-5535-8efe-5e571a827da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186336384} {:answer/id #uuid "3d2c2ef0-4441-556c-91d1-869591ce8b28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186336609} {:answer/id #uuid "974473d9-6217-5b21-b771-e42c139b5bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186337409} {:answer/id #uuid "eccc2950-0821-56f5-a1c8-330d5b81af47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186338097} {:answer/id #uuid "f7124a5c-f1e9-5c26-9aa6-b10cf5197f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186338198}] :answer-field/correct {:answer/id #uuid "25bf70ff-b994-5535-8efe-5e571a827da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186336384} :answer-field/id #uuid "8e04abee-98c1-555b-a5ad-820352237a1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6118feb2-c751-599a-b3b9-c8c760c49b6d" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse."}] [{:db/id #edb/ref 17592186339017 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe7a17e-699b-5815-9a3e-8c195290665d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ only" :db/id #edb/ref 17592186336634} {:answer/id #uuid "4fe808c6-8c78-5b74-b734-4332d2bbc55a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Z$ only" :db/id #edb/ref 17592186336765} {:answer/id #uuid "c4c41241-68f5-537f-a2f4-36ef3a8fa0d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ and $Z$ only" :db/id #edb/ref 17592186337782} {:answer/id #uuid "ea3208fb-30da-50b9-a09e-289044fe0c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Y$ only" :db/id #edb/ref 17592186338075} {:answer/id #uuid "f80e89dd-c652-5265-923f-af822d38aa7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ and $Y$ only" :db/id #edb/ref 17592186338206}] :answer-field/correct {:answer/id #uuid "3fe7a17e-699b-5815-9a3e-8c195290665d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ only" :db/id #edb/ref 17592186336634} :answer-field/id #uuid "975bdda1-4123-5df1-96af-d7afaa2e70d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338556}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f09c20fa-fbe3-5a9f-8218-d2a4dd2af13c" :question/math-academy-id "q-71938" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nX=[\\begin{aligned}2 & 1 \\\\ -4 & 6 \\\\ 10 & 0\\end{aligned}],\\,Y=[\\begin{aligned}6 & 5 \\\\ 7 & 6\\end{aligned}],\\,Z=[\\begin{aligned}-2 & 1 \\\\ 10 & 5\\end{aligned}].\n$$" :question/worked-solution "- The matrix $X$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $Y$, we have\n\n$$\ndet(Y)=6\\cdot 6-7\\cdot 5=1.\n$$\n\nBecause $det(Y)\\ne 0,$ we conclude that $Y$ is invertible.\n\n- For the matrix $Z$, we have\n\n$$\ndet(Z)=(-2)\\cdot 5-10\\cdot 1=-20.\n$$\n\nBecause $det(Z)\\ne 0,$ we conclude that $Z$ is invertible.\n\nTherefore, only $X$ does not have an inverse."}] [{:db/id #edb/ref 17592186339061 :knowledge-point/_questions [{:db/id #edb/ref 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2010236d-47fb-566d-af0c-b027bf90808c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186336331} {:answer/id #uuid "3cad5ca4-81de-5679-b6a5-afb792473624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336604} {:answer/id #uuid "60293a1e-e9b9-5afd-9f24-67ec9dc41d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336902} {:answer/id #uuid "b561e370-ef46-5cc5-bdd6-66e8842c1d9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337647} {:answer/id #uuid "e0b347c1-0e4e-5f8a-b185-d8391cccc11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337993}] :answer-field/correct {:answer/id #uuid "b561e370-ef46-5cc5-bdd6-66e8842c1d9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337647} :answer-field/id #uuid "166535c1-1bd7-5b6b-be78-91bf0ba1824c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2073d8ee-8ecd-594e-9fd2-e836c959a0b9" :question/math-academy-id "q-72130" :question/problem "Which of the following equalities are true given that\n$D={(x,y)\\,:\\,1\\le x\\le 2,\\,\\frac{1}{2}\\le y\\le 1}.$\n\n- ${∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A={\\int }_{1}^{2}{\\int }_{1/2}^{1}y\\operatorname{ln}⁡(x)\\,\\text{d}x\\,\\text{d}y$\n- ${∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A={\\int }_{1/2}^{1}{\\int }_{1}^{2}y\\operatorname{ln}⁡(x)\\,\\text{d}y\\,\\text{d}x$\n- ${∬}_{D}y\\operatorname{ln}⁡(x)\\text{d}A={\\int }_{1}^{2}{\\int }_{1/2}^{1}y\\operatorname{ln}⁡(x)\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that:\n\n- the limits for the variable $x$ are from $1$ to $2$, and\n\n- the limits for the variable $y$ are from $\\frac{1}{2}$ to $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A & ={\\int }_{1/2}^{1}[{\\int }_{1}^{2}y\\operatorname{ln}⁡(x)\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A={\\int }_{1}^{2}[{\\int }_{1/2}^{1}y\\operatorname{ln}⁡(x)\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186339067 :knowledge-point/_questions [{:db/id #edb/ref 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e17575-0ade-5823-9fa0-2fc5cba651ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336564} {:answer/id #uuid "3c61013d-7f45-566e-9c1f-dc853c17ca02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336602} {:answer/id #uuid "4c80e22b-9d6e-5774-90f6-d056de93d371" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336744} {:answer/id #uuid "890f0155-82db-50f6-b377-11c22d644867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337268} {:answer/id #uuid "a966105f-7c64-5390-a6c1-44e721cc4739" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337561}] :answer-field/correct {:answer/id #uuid "4c80e22b-9d6e-5774-90f6-d056de93d371" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336744} :answer-field/id #uuid "e2d07712-dafc-5310-b4ad-bbf99bc2af70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4009c26-3316-54ec-b0bf-1d56ecb8b0b0" :question/math-academy-id "q-72175" :question/problem "Which of the following equalities are true given that\n$D={(x,y)\\,:\\,0\\le x\\le \\sqrt{2},\\,-\\sqrt{3}\\le y\\le 2}.$\n\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{0}^{\\sqrt{2}}{\\int }_{-\\sqrt{3}}^{2}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x$\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{-\\sqrt{3}}^{2}{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}x\\,\\text{d}y$\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{-\\sqrt{3}}^{2}{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that:  \n\n- the limits for the variable $x$ are from $0$ to $\\sqrt{2}$, and\n\n- the limits for the variable $y$ are from $-\\sqrt{3}$ to $2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A & ={\\int }_{-\\sqrt{3}}^{2}[{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{0}^{\\sqrt{2}}[{\\int }_{-\\sqrt{3}}^{2}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186339069 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17be251d-7119-505a-822a-7b4f4a540bc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336254} {:answer/id #uuid "28248254-c521-555f-a8eb-3698fd411628" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186336409} {:answer/id #uuid "54358dc3-968d-51c2-b7a6-0a9e65676557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336809} {:answer/id #uuid "559f9ad0-2178-5631-a30c-df72edf7e3d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336818} {:answer/id #uuid "55dfee5e-aee0-54ba-a2ef-8bb2f5c930f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336821}] :answer-field/correct {:answer/id #uuid "17be251d-7119-505a-822a-7b4f4a540bc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336254} :answer-field/id #uuid "acf0a001-ed03-592c-9465-79a8c55ab0a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338594}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0bcd8034-22f3-5298-b8d3-b69cdcbc84fc" :question/math-academy-id "q-72185" :question/problem "Which of the following statements are true regarding the finite region inside the circumference ${x}^{2}+{y}^{2}=1?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=1\\, & ⟹\\,x=\\pm \\sqrt{1-{y}^{2}} \\\\ {x}^{2}+{y}^{2}=1\\, & ⟹\\,y=\\pm \\sqrt{1-{x}^{2}}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/09/0960063edcce8ccd55dc2f77147c4a4982645c180e8b998d7e520c65131ea045.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le \\sqrt{1-{x}^{2}}\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le y\\le 1,\\,-\\sqrt{1-{y}^{2}}\\le x\\le \\sqrt{1-{y}^{2}}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186339070 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d5dfdf6-e50a-544c-a082-757d6a3cc45e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336750} {:answer/id #uuid "6f3a5eba-d4b1-5a73-b36e-ccfbf5537a92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337017} {:answer/id #uuid "71d9509f-880d-594a-ad0c-8f134a4a17bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337050} {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337256} {:answer/id #uuid "fc897d08-7b5c-5946-a0d6-80162b7a9c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186338252}] :answer-field/correct {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337256} :answer-field/id #uuid "5dc16394-01fd-51be-9be9-07cf0cfe3cbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f581ab20-43e5-59a8-ac58-914378a7361e" :question/math-academy-id "q-72186" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/6f/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}\\}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/76/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186339071 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b81e3f-060b-5845-a303-b88224da1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336078} {:answer/id #uuid "46f070d3-ed05-5034-af82-a9adf57c60b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336690} {:answer/id #uuid "4deab650-a626-55f2-b9af-f7b4ccb3ee34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336755} {:answer/id #uuid "5e1230df-1cda-5e95-8f8f-00f39e16c196" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336882} {:answer/id #uuid "cf98decd-9264-56e3-850f-4cfdc80409db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337849}] :answer-field/correct {:answer/id #uuid "46f070d3-ed05-5034-af82-a9adf57c60b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336690} :answer-field/id #uuid "08cff232-9d15-5600-89b1-e7cd0fac0002" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338291}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b03842bf-e94f-5526-903d-de5a2a3bccca" :question/math-academy-id "q-72187" :question/problem "Which of the following statements are true regarding the finite region bounded between the circles ${x}^{2}+{y}^{2}=2$ and ${x}^{2}+{y}^{2}=1?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/28/28290c5530efd27a979f4284481ca7e0384342d7d426dde0ab36894a0d77a166.png)\n\nWe have the following:\n\n- The vertical line $x=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/30/3007cffb725faee44d2a06ad077eec630791b1a94c373a323f62d0d721c87207.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/38/383f88668435556d3a856cf852caf548b1f1bf3a90d50f9d85d7968188984804.png)\n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186339126 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45d99b9d-5704-58cf-919d-6915dcae3299" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186336680} {:answer/id #uuid "52468b8e-d113-5efc-a093-9eec57bc9b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186336789} {:answer/id #uuid "77b4fe93-508f-553a-8b98-740710c54788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186337110} {:answer/id #uuid "dfcedb6f-7df8-5c52-95d7-61e9b09424a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186337986} {:answer/id #uuid "fbe12b6b-39a0-5ff6-a668-5408621fc8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186338243}] :answer-field/correct {:answer/id #uuid "77b4fe93-508f-553a-8b98-740710c54788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186337110} :answer-field/id #uuid "3d4379a0-d5ee-50fe-b962-654c0a9cb62f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338384}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ddf8ccb-f483-5bbe-8662-ef5250ea89a5" :question/math-academy-id "q-72489" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{aligned}],\\,C=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\n- The matrix $B$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=[\\begin{aligned}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are **not** in row echelon form."}] [{:db/id #edb/ref 17592186339127 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022a93a6-705d-525b-a6ed-eb10665cd446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186336051} {:answer/id #uuid "252169cb-b78a-5e0c-a6be-164c180eae59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186336381} {:answer/id #uuid "2806d007-25ff-5cf7-bbf1-c3e504570ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186336405} {:answer/id #uuid "380294b6-401a-5a3f-a8b6-b3b07de91291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186336553} {:answer/id #uuid "7f80b45e-e58f-5638-a324-065ed3129df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186337188}] :answer-field/correct {:answer/id #uuid "2806d007-25ff-5cf7-bbf1-c3e504570ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186336405} :answer-field/id #uuid "ecf9782f-4e02-54dd-b3fd-efc5b9df2009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "937eaf0d-76e6-56ec-a651-23458856322a" :question/math-academy-id "q-72498" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$  is not in row echelon form since ${a}_{32}\\ne 0$ (condition II is violated). \n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=[\\begin{aligned}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{aligned}]\n$$\n\nTherefore, only $B$ is in row echelon form."}] [{:db/id #edb/ref 17592186341835 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f8be93a-652f-57e0-8d38-bcd230082b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186340274} {:answer/id #uuid "b8f562f0-2895-533d-b1a7-b975b9fe7bb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186340787} {:answer/id #uuid "befdff1d-4580-52ec-be14-2fa18ba303c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186340831} {:answer/id #uuid "cef2d373-08dc-51b2-a572-5824121784fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186340968} {:answer/id #uuid "f84f8da1-987d-5353-91bb-4a28605cc356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186341325}] :answer-field/correct {:answer/id #uuid "b8f562f0-2895-533d-b1a7-b975b9fe7bb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186340787} :answer-field/id #uuid "cbc4fdb1-28ec-53bb-808c-40da78982aca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341739}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f7d9000-6b1e-59bb-84e6-86f972afc228" :question/math-academy-id "q-72570" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{aligned}],\\,\\,B=[\\begin{aligned}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{aligned}],\\,\\,C=[\\begin{aligned}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{aligned}]\n$$\n\n- The matrix $B$  is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."}] [{:db/id #edb/ref 17592186341837 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac7ba1b-b723-5280-92ad-4c9f642b3f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186339954} {:answer/id #uuid "7c6f0a64-f7aa-5222-8fb4-a8d2f3e74b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186340248} {:answer/id #uuid "a43eda66-5103-58ad-a759-656e383e2463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186340618} {:answer/id #uuid "bc9daa56-0bd1-51f3-ba11-66f6510ea1da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186340814} {:answer/id #uuid "e3046a5c-b97e-5253-ad4c-9e218fcb631f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186341137}] :answer-field/correct {:answer/id #uuid "7c6f0a64-f7aa-5222-8fb4-a8d2f3e74b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186340248} :answer-field/id #uuid "25f51ed4-31e6-5d99-abf8-f209f3fd72ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341446}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c409d434-4c7f-59fa-9d55-4c82bc621cc5" :question/math-academy-id "q-72574" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{aligned}],\\,\\,B=[\\begin{aligned}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{aligned}],\\,\\,C=[\\begin{aligned}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied). \n\n$$\nA=[\\begin{aligned}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition  II is violated).\n\n$$\nC=[\\begin{aligned}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}]\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."}] [{:db/id #edb/ref 17592186341838 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05490973-f9e5-5e64-ba65-4e2fea411064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186339167} {:answer/id #uuid "326890e9-4656-517c-8e21-551f43e4b4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186339572} {:answer/id #uuid "3454ef84-206a-5201-9156-5622a49f30dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186339593} {:answer/id #uuid "5fa11633-8afd-5d03-ab16-bb473b613354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186339980} {:answer/id #uuid "e6714207-3005-5ade-af54-df6eaa9a8613" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186341167}] :answer-field/correct {:answer/id #uuid "05490973-f9e5-5e64-ba65-4e2fea411064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186339167} :answer-field/id #uuid "63681ebc-7c8e-5281-86d6-7870a0940d7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d3c090e-cc4f-51d5-a663-f597f7113489" :question/math-academy-id "q-72576" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}2 & 1 & 3 \\\\ 0 & 0 & 5 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & -2\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & 5\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 5 & 8 \\\\ 1 & -4 & 0 & 6 \\\\ 0 & 0 & 2 & 4\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=[\\begin{aligned}2 & 1 & 3 \\\\ 0 & 0 & 5 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & 5\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition II is violated).\n\n$$\nC=[\\begin{aligned}2 & 0 & 5 & 8 \\\\ 1 & -4 & 0 & 6 \\\\ 0 & 0 & 2 & 4\\end{aligned}]\n$$\n\nTherefore, only $B$ is in row echelon form."}] [{:db/id #edb/ref 17592186341908 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ab5c9a-741e-507f-8a99-07a9f7aa451c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339588} {:answer/id #uuid "3bf55990-23dc-5693-8dde-0dd252a432b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186339663} {:answer/id #uuid "48fe273f-13eb-5f78-8272-5b9b3a2db061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186339782} {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} {:answer/id #uuid "ea2ab1df-0cb6-5919-a2be-e9cca71bcc58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341194}] :answer-field/correct {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} :answer-field/id #uuid "bf84d3cb-0dfa-513a-bcdd-3183ad8dee6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79464211-37d1-5cac-b164-284bb9d9308a" :question/math-academy-id "q-73105" :question/problem "![](images/ad/ad3fb8a0cce2a6dac706d7876aca0a2339fe49c05cb7aa6ae54de86735ceafab.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nI. The function is left-continuous at $x=3$\n\nII. The function is right-continuous at $x=3$\n\nIII. The function is continuous at $x=3$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=3,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=3\\ne 1=f(3)\n$$\n\n- Statement II is true. The function is right-continuous at $x=3,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=1=f(3)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=3,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186341909 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44870b19-7de8-568b-9bca-2faf7aacb656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186339734} {:answer/id #uuid "6d08a5ce-252a-5950-9158-72ef68730a92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340088} {:answer/id #uuid "b1f89edf-e35a-52a7-8ca1-d55f110862dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340749} {:answer/id #uuid "c8ddd360-ea1a-5bee-8ba6-6e9b7129a9e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340908} {:answer/id #uuid "e9c70b93-5d4c-58f2-989d-44cba9e4cf22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341192}] :answer-field/correct {:answer/id #uuid "44870b19-7de8-568b-9bca-2faf7aacb656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186339734} :answer-field/id #uuid "dce5165d-a261-5af6-ae8f-5e3cff741926" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341769}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1f47bb47-6168-5cb8-92db-b7a3fc493275" :question/math-academy-id "q-73106" :question/problem "![](images/89/89dca4b059ccbd1fe93d000acabcbd33b5fc10389de48ef3cbae65cb4455f29e.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=1$\n- The function is right-continuous at $x=1$\n- The function is continuous at $x=1$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)=1\\ne 3=f(1)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)=1\\ne 3=f(1)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."}] [{:db/id #edb/ref 17592186341927 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195bda69-5d84-5c1f-93f1-061ff6e7af90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339351} {:answer/id #uuid "1d3d3665-b6a6-5975-9783-9af879c2d659" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339383} {:answer/id #uuid "582777b8-345a-5528-a5bf-6cb7f361b239" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339931} {:answer/id #uuid "ac7998fd-d3d9-5720-bee0-6d1d6f6064f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340701} {:answer/id #uuid "f1bb4be9-df0f-5398-8fd0-b36df3ca0d06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341257}] :answer-field/correct {:answer/id #uuid "ac7998fd-d3d9-5720-bee0-6d1d6f6064f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340701} :answer-field/id #uuid "a43e6b64-3905-50fe-84a0-c65639ebeb11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eb34e90-018e-520a-8053-32b72e25bff0" :question/math-academy-id "q-73249" :question/problem "![](images/ec/ec8101640f2bd84506d1c47b92f088675080d87eafff4000a4f3e0d14ccebb55.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\n- The function is continuous at $x=-2$\n- The function is continuous at $x=1$\n- The function is differentiable at $x=1$" :question/worked-solution "- Statement I is false. From the graph we can see that $f(x)$ has a jump discontinuity at $x=-2.$\n\n- Statement II is true. The graph can be drawn in a neighborhood of $x=1$ without taking the pencil off the paper.\n\n- Statement III is false. The graph of $f(x)$ shows a cusp at this point and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341928 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3115a701-908d-5194-89b5-3934f2aee943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339559} {:answer/id #uuid "3ef63771-16e0-5c66-87bb-9773a47f39ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339696} {:answer/id #uuid "4084d34d-cdd6-5521-90d7-5d09fec010be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339705} {:answer/id #uuid "5f7cee9c-67f1-509a-a047-56e0f6f1ef9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339975} {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567}] :answer-field/correct {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567} :answer-field/id #uuid "941f6918-d68b-5b25-9b9f-c8698c202566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa88d46b-d2ce-5164-bbed-10d691e29ef6" :question/math-academy-id "q-73250" :question/problem "![](images/a8/a8a70a2f28585b63d2a083b42eb6ad54bfb581b5f13c699a3bc3c8d836afaee8.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=1$\n\nII. The function is continuous at $x=0$\n\nIII. The function is differentiable at $x=0$" :question/worked-solution "- Statement I is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$\n\n- Statement II is true. The graph can be drawn in a neighborhood of $x=0$ without taking the pencil off the paper.\n\n- Statement III is false. The function $f(x)$ has a corner point at $x=0$ and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341929 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43206143-d3e7-5558-906d-23db6302ae10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339717} {:answer/id #uuid "5aac758e-2f12-517d-8ce4-fe8a5696f212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339951} {:answer/id #uuid "9c49a7a3-a3b7-5ac2-9f14-8aeb96443d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340536} {:answer/id #uuid "be0a87e6-ce52-5475-84fa-d3314aa5b89d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340822} {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093}] :answer-field/correct {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093} :answer-field/id #uuid "315e5c79-1bab-5a2f-a733-2981ea179e3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7ec702-6570-50d7-8199-a59c190c3e40" :question/math-academy-id "q-73252" :question/problem "![](images/1f/1f2d8b9faac6c300b41902cea5065bf8bafb02c137232ee79779a4dc3ff67f33.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=-1$\n\nII. The function is differentiable at $x=1$\n\nIII. The function is continuous at $x=2$" :question/worked-solution "- Statement I is true. The graph can be drawn in a neighborhood of $x=-1$ without taking the pencil off the paper.\n\n- Statement II is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$ So, it can't be differentiable there.\n\n- Statement III is true. The graph can be drawn in a neighborhood of $x=2$ without taking the pencil off the paper.\n\nTherefore, only statements I and III  are true."}] [{:db/id #edb/ref 17592186341975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9c9d7d-cafe-5ca3-aeda-6ab3a8844c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339402} {:answer/id #uuid "466f898a-a17d-5ef2-9df7-de21d4467270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339753} {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} {:answer/id #uuid "71573f37-88c6-5316-841b-9e7cbf18b8f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340135} {:answer/id #uuid "9acfcc52-3763-5eb4-9f6b-ab6d62822c30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340525}] :answer-field/correct {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} :answer-field/id #uuid "8811fa51-bfe6-5509-90af-f31705a35d36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbdd6305-e297-593d-89f4-fb7ada8ade14" :question/math-academy-id "q-73455" :question/problem "![](images/de/de39663db59e42565c7d69d8a44a4cb95f14af0f4946b77cfc42eac02f7d2786.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\nI. $[-\\pi ,\\pi ]$\n\nII. $[-\\pi ,0)$\n\nIII. $[1,\\pi ]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\pi ]$ is closed,but the function has a removable discontinuity at $x=0.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[-\\pi ,0)$ is not closed, so, the extreme value theorem is not applicable.\n\n- The interval $[1,\\pi ]$ is closed, and the function is continuous on $[1,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341981 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2667e8a9-ad2e-5060-ac38-bc2c70de2517" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339462} {:answer/id #uuid "625380bb-0130-5ea5-a938-fd4c6911619a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340005} {:answer/id #uuid "6e925fcb-aeca-55f4-a2d0-bdc171bc4053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340107} {:answer/id #uuid "91fa11e7-ee32-5b9c-b3e7-3b327d3b922a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340438} {:answer/id #uuid "ff71884c-52b4-575e-b1f2-db8af6ee5dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341380}] :answer-field/correct {:answer/id #uuid "ff71884c-52b4-575e-b1f2-db8af6ee5dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341380} :answer-field/id #uuid "8e8ea3ae-c1eb-57e3-9b69-648b0d966d96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b5c08f3-5fbe-50f0-8681-6cf3ebc354c4" :question/math-academy-id "q-73463" :question/problem "![](images/4d/4de4aa4956b0b70e6e08c9f0188944469270ab19501194ce897e2af9411a0d98.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\n- $[-\\pi ,\\frac{\\pi }{2}]$\n- $[0,\\pi ]$\n- $(-\\frac{\\pi }{2},\\frac{\\pi }{2}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\frac{\\pi }{2}]$  is closed, but the function has a removable discontinuity at $x=-\\frac{\\pi }{2}.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[0,\\pi ]$ is closed, and the function is continuous on $[0,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(-\\frac{\\pi }{2},\\frac{\\pi }{2}]$  is not closed, so, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341984 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85ec74-7261-5a84-b268-2cb5156ec3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339237} {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} {:answer/id #uuid "696a6442-ff9a-551c-9da2-c842f797cf3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340065} {:answer/id #uuid "85e6b77c-a45a-52cf-b8c9-1652a4b8a948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340328} {:answer/id #uuid "facb3de9-0178-54cd-b07c-1c80bbb75fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341346}] :answer-field/correct {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} :answer-field/id #uuid "217a3a4a-e905-59b0-918b-c92be80eb6b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "122f233b-5382-5fef-8fbd-2b8682266e28" :question/math-academy-id "q-73481" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\sqrt[4]{x}}{{x}^{2}+1}?$   \n\nI. $[-1,5]$\n\nII. $[0,2]$\n\nIII. $[2,5]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,5]$ is closed, but the function is not continuous on it because $\\sqrt[4]{x}$ is not defined anywhere in the subinterval $[-1,0).$  Therefore, the extreme value theorem is not applicable.\n\n- The intervals $[0,2]$ and $[2,5]$ are closed, and the function is continuous on each of these intervals Therefore, the extreme value theorem is applicable on each $[0,2]$  and $[2,5].$\n\nIn conclusion, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186341985 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24811889-2c2a-5489-87b6-7ec9fcc9ec5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339445} {:answer/id #uuid "49559a38-7682-51c6-961d-af8f6d4b9c7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339786} {:answer/id #uuid "8e550649-e7ec-521f-b83e-ccfcdfe9298e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340407} {:answer/id #uuid "b182cd8c-78d4-5443-bfc8-d64291dce17e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340743} {:answer/id #uuid "b2f9dc50-f6a9-5e82-a931-a20f17095169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340755}] :answer-field/correct {:answer/id #uuid "b182cd8c-78d4-5443-bfc8-d64291dce17e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340743} :answer-field/id #uuid "1cc71ef4-f030-5214-97b4-d07a1eb70ea5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341431}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe7192f0-0469-5c77-92a1-060194834d30" :question/math-academy-id "q-73482" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{x-1}{\\sqrt{x+1}}?$   \n\n- $[-1,0]$\n- $[1,10]$\n- $(-1,0)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,0]$ is closed, but the function is not continuous on it because it is not defined at $x=-1.$  Therefore, the extreme value theorem is not applicable.\n\n- The interval $[1,10]$ is  closed, and the function is continuous on $[1,10].$ Therefore, the extreme value theorem is applicable.\n\n- The interval  $(-1,0)$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341986 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68717c-3c5f-58a5-9174-e8f45f3e1ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339216} {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} {:answer/id #uuid "43af0409-9e51-5d17-a8fb-98b37bd00bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339722} {:answer/id #uuid "72581646-406e-5e01-9bba-7ad77de94142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340144} {:answer/id #uuid "8e33f721-3fb7-5e44-8644-c40ab2c07185" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340406}] :answer-field/correct {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} :answer-field/id #uuid "9a35e850-44d5-5740-b0b8-70909d0b180d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aba1141-c0a4-54c1-bd64-30eb78786676" :question/math-academy-id "q-73484" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\sqrt{\\operatorname{cos}⁡x}?$    \n\nI. $[\\frac{\\pi }{2},\\pi ]$\n\nII. $[\\frac{\\pi }{4},\\frac{\\pi }{2})$\n\nIII. $[0,\\frac{\\pi }{2}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{\\pi }{2},\\pi ]$  is closed, but the function is not defined on a part of the interval because $\\operatorname{cos}⁡(x)<0$ for all $x\\in (\\frac{\\pi }{2},\\pi ].$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[\\frac{\\pi }{4},\\frac{\\pi }{2})$    is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{2}]$ is  closed, and the function is continuous on $[0,\\frac{\\pi }{2}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341987 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51327576-3dc9-528f-9e13-d755abf55471" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339872} {:answer/id #uuid "7b3f93d2-0ebe-5934-8c91-fce10e0d1450" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340232} {:answer/id #uuid "90e67802-13a1-5947-86e3-d0c565f61870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340428} {:answer/id #uuid "ab6c8074-427b-5dfe-9ad1-218b184fe226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340690} {:answer/id #uuid "ef2a0a0c-7790-530c-89f1-dbee9d7d9e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186341239}] :answer-field/correct {:answer/id #uuid "90e67802-13a1-5947-86e3-d0c565f61870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340428} :answer-field/id #uuid "8b5cc245-bbea-5aaf-8a56-ee9acee3fb23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e05c6d3d-29e1-53ab-9c70-1ad2b27199a4" :question/math-academy-id "q-73486" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\operatorname{sin}⁡(\\frac{\\pi }{x})?$   \n\n- $[\\frac{1}{2},1]$\n- $[0,\\frac{1}{4})$\n- $[0,1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{1}{2},1]$   is closed, and the function is continuous on $[\\frac{1}{2},1].$   Therefore, the extreme value theorem is applicable.\n\n- The interval $[0,\\frac{1}{4})$  is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,1]$ is closed, but the function is not continuous on it because it is not defined at $x=0.$  Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186341988 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a506d32-c549-5247-82e3-f237fa06872d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339215} {:answer/id #uuid "22362652-f0bc-5e3c-afa7-25ce82d78661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339421} {:answer/id #uuid "327c0e31-b1ed-5548-81bc-18ff4bca8bd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339573} {:answer/id #uuid "87824f92-9edf-52ca-9f8c-b3eeb64b58cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340341} {:answer/id #uuid "a19759de-fa06-5d86-925a-320a7299775b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340594}] :answer-field/correct {:answer/id #uuid "a19759de-fa06-5d86-925a-320a7299775b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340594} :answer-field/id #uuid "8a8dae27-98ed-5b9c-b45d-d7007b99d819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341622}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96d14ec6-ae06-5360-8ddd-d401dbb48508" :question/math-academy-id "q-73487" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{x}{{2}^{x}-1}?$    \n\nI. $[0,1]$\n\nII. $[0,1)$\n\nIII. $[-2,-1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,1]$ is closed, but the function is not continuous on it because it is not defined at $x=0$ (it makes zero the denominator).   Therefore, the extreme value theorem is not applicable.\n\n- The interval  $[0,1)$   is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-2,-1]$    is closed, and the function is continuous on $[-2,-1].$   Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341990 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cfa7a4-d6c1-5351-99b2-6635044d85f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339474} {:answer/id #uuid "65459a76-323b-5a88-8a2f-2e108e43ea11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340024} {:answer/id #uuid "88971863-2310-5e3f-ac5d-6e4e1adfb7df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340348} {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} {:answer/id #uuid "be62f3bd-2eeb-5b57-889c-ca65dbe099b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340825}] :answer-field/correct {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} :answer-field/id #uuid "bcb8b636-417c-59ba-b9cc-599917ded547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341706}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7b9b884e-eb8a-59c7-aa31-49f0025fb47f" :question/math-academy-id "q-73495" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}{2}^{-x}, & x\\ge 0 \\\\ -1, & x<0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-1,1]$\n\nII. $[\\frac{1}{2},1]$\n\nIII. $[-1,0)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}({2}^{-x})={2}^{0}=1, \\\\ {lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}(-1)=-1.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[\\frac{1}{2},1].$ In this interval, $f(x)={2}^{-x}$ and so $f(x)$ is continuous on $[\\frac{1}{2},1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, the interval $[-1,0)$, is not closed, so the extreme value theorem is not applicable in this case.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ceb0ce8-da1c-5b99-9182-d772be7cec72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339520} {:answer/id #uuid "7896c996-e406-5136-a44c-25645e86bbc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340203} {:answer/id #uuid "9a19840a-be8c-5757-bad3-4daa8391bbb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340517} {:answer/id #uuid "a718fb5b-1dd8-5664-a8f8-13023ada0bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340646} {:answer/id #uuid "f499afb4-f0c7-5505-912f-71dee8dd2498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341285}] :answer-field/correct {:answer/id #uuid "9a19840a-be8c-5757-bad3-4daa8391bbb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340517} :answer-field/id #uuid "141d901b-70e2-5398-8913-6c50c5c4a073" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341416}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1eaad6e-884d-57bd-a4ae-a690d3d6abe9" :question/math-academy-id "q-73499" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{ln}⁡(x-1), & x>1 \\\\ x-1, & x\\le 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[0,2]$\n\nII. $[-1,0]$\n\nIII. $[-1,2]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[0,2].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\nHence, $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[0,2],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[-1,0].$ In this interval, $f(x)=x-1$ and so $f(x)$ is continuous on $[-1,0].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, in the interval $[-1,2]$, we also have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\n \nHence, $f(x)$ is not continuous on $[-1,2]$ and therefore  the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341993 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235e2186-c516-5a12-99e1-855472aad9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339433} {:answer/id #uuid "7e1ad79a-9054-5adb-8e27-82c74fb0eeee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340265} {:answer/id #uuid "d65d9629-6375-5d3b-9bf7-be4b8ce2e02b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341027} {:answer/id #uuid "de97e50a-3ac0-5909-8788-42a53cdaa913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341105} {:answer/id #uuid "e5a1b048-a2c7-5d2d-99eb-e4c76eea7395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341157}] :answer-field/correct {:answer/id #uuid "7e1ad79a-9054-5adb-8e27-82c74fb0eeee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340265} :answer-field/id #uuid "3883c8f8-56cb-5ac2-9602-b5a9a360bba9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341481}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a761269-f6ea-50eb-8e45-58983c3d9692" :question/math-academy-id "q-73503" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\frac{2-x}{{2}^{x}+1}, & x\\ne 0 \\\\ \\,\\,2, & x=0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-1,1]$\n- $(0,3]$\n- $[-2,-1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- First, let's consider $[-1,1].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}f(x) & ={lim}_{x\\to 0}\\frac{2-x}{{2}^{x}+1}=\\frac{2-0}{{2}^{0}+1}=1\\ne f(0).\\end{aligned}\n$$\n\nHence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(0,3]$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[-2,-1].$ The only discontinuity of the function $f(x)$ is at $x=0,$ which is not in the interval  $[-2,-1].$  Therefore, $f(x)$ is continuous on the interval  $[-2,-1],$  and the extreme value theorem is also applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341994 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8ca629-0927-538d-ab6c-ffef86ed4c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  only" :db/id #edb/ref 17592186339401} {:answer/id #uuid "3cbeae54-1a8e-537b-bcc8-b644943612ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339669} {:answer/id #uuid "4680f954-f4f8-5258-ae55-a7412a19432c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339754} {:answer/id #uuid "bfda1598-8520-5bca-930a-7ba3397c4c03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340839} {:answer/id #uuid "fbb6ae8f-aab7-5bdc-8f7c-dc14885c5a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341353}] :answer-field/correct {:answer/id #uuid "3cbeae54-1a8e-537b-bcc8-b644943612ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339669} :answer-field/id #uuid "9c36c391-b98e-5750-8019-3f694dde0b5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341656}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dcdd6cca-dc15-5e0c-a55e-4d73a59866ce" :question/math-academy-id "q-73504" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\,\\,2{x}^{3}-1, & x<1 \\\\ {sin}^{2}⁡(x-1), & x\\ge 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-1,2]$\n- $(1,3]$\n- $[2,\\pi ]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-1,2].$  We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to 1}(2{x}^{3}-1)=2(1)^{3}-1=1, \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to 1}{sin}^{2}⁡(x-1)={sin}^{2}⁡(1-1)=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=1$ are not the same. Hence, $f(x)$ has a discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,2],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(1,3]$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[2,\\pi ].$ In this interval, $f(x)={sin}^{2}⁡(x-1)$ and so $f(x)$ is continuous on $[2,\\pi ].$  Therefore, the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186342003 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085a372e-3d44-5218-8ffc-7245e73f20e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339197} {:answer/id #uuid "27bfa14d-cc0f-5a6b-9127-444c2c3cbe94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339472} {:answer/id #uuid "5ff1f004-8a24-53f6-8512-8daed863b9af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339982} {:answer/id #uuid "807a16d0-c898-5c5a-aa54-af34b1d71126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340280} {:answer/id #uuid "9ef8375b-1f86-5526-a7e2-474095047082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340564}] :answer-field/correct {:answer/id #uuid "807a16d0-c898-5c5a-aa54-af34b1d71126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340280} :answer-field/id #uuid "1167d122-71e9-5a13-8edb-8b2e825eb1e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341410}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8abc4b9f-caf8-5c94-91da-62ad0ae61b3d" :question/math-academy-id "q-73531" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{x-1}-1}, & x\\ne 1 \\\\ \\,\\,1, & x=1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-2,2]$\n\nII. $[-3,1)$\n\nIII. $[1.5,2]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- Let first consider the interval  $[-2,2].$ This is a  closed interval, but we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\frac{1}{{2}^{x-1}-1}=\\infty \\end{aligned}\n$$\n\nand so $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1]$, and the extreme value theorem is not applicable.\n\n- The interval $[-3,1)$ is not closed, so the extreme value theorem is not applicable in this case.\n\n- Finally consider  $[1.5,2].$ The only discontinuity of the function $f(x)$ is at $x=1,$ which is not in the interval  $[1.5,2].$ Therefore, $f(x)$ is continuous on the interval  $[1.5,2]$, and the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186342012 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f079a8-3eef-5e0c-b508-56b0a28e810a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339187} {:answer/id #uuid "33e2246e-0cb8-5b3d-a663-6ded80537d31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339590} {:answer/id #uuid "36e9f6d3-ade4-54f2-83b8-98b440f7e2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339621} {:answer/id #uuid "9be8a799-d92f-523e-80f4-9f217caeda37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340530} {:answer/id #uuid "a94a7551-868d-5a9d-8d58-61cf61d367d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340670}] :answer-field/correct {:answer/id #uuid "9be8a799-d92f-523e-80f4-9f217caeda37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340530} :answer-field/id #uuid "1c233766-89ba-51e9-91fa-b4ab683f8678" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341429}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "451e02c3-10e2-5101-a83f-538a8be6b03d" :question/math-academy-id "q-73549" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $4{x}^{2}+{y}^{2}=4$ and $4{x}^{2}+{y}^{2}=1?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/62/627e7e102a0f16cb0c4946e42b48ad122299d729c5bc419293e258a3f2e1701e.png)\n\nWe have the following:\n\n- The vertical line $x=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/d7/d7aa48c887d6fb1c3d0420867b7e74010fa93e16d7e24317e2cf214764e56113.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/ec/ec632fa5f86d8d9b34b9ccf661a3219e965f289c28bf69d7d80eeeb46093e7ae.png)\n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186342187 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db4180e-9e56-5615-a261-a06b057afbc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339254} {:answer/id #uuid "44382309-a210-5068-b421-83edd371f540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339728} {:answer/id #uuid "705bf110-f45f-5748-8977-a6e4eaab55d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340124} {:answer/id #uuid "a661de8b-e986-5edb-ae2a-54d4fbff884d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340638} {:answer/id #uuid "ec1d59d6-b1c0-5ab1-b672-2772922e372b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341209}] :answer-field/correct {:answer/id #uuid "705bf110-f45f-5748-8977-a6e4eaab55d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340124} :answer-field/id #uuid "b4646991-5d1f-5339-9e5a-2aa1bae21d22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e93e600-4a01-5ada-842d-9b175b57ee56" :question/math-academy-id "q-74217" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:1-x-y=0\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}\\le 1\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:2x+3y-z=0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $1-x-y=0$ since $1-0-0\\ne 0.$\n\n- The set $B$ is not a subspace. Indeed, the vector $u=⟨1,0,0⟩$ is in $B$, but $2u=⟨2,0,0⟩$ is not in $B$, since ${2}^{2}+{0}^{2}+{0}^{2}≰1.$ So, $B$ is not closed under scalar multiplication.\n\n- The set $C$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $2x+3y-z=0$ since $2\\cdot 0+3\\cdot 0-0=0.$ So $0$ lies in $C.$\n\nIn conclusion, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186342188 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ab7da0-2f07-50d1-831b-c157d66b1de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339721} {:answer/id #uuid "6ffb62c9-06bc-54ed-a237-28e9635fc6fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340121} {:answer/id #uuid "72703321-1679-5b08-aab6-32e985e25b41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340146} {:answer/id #uuid "74517a98-ee70-5879-af22-ee6f1cbffcda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186340165} {:answer/id #uuid "ef265337-e4c5-5117-bd72-923b375019cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341238}] :answer-field/correct {:answer/id #uuid "74517a98-ee70-5879-af22-ee6f1cbffcda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186340165} :answer-field/id #uuid "fa75a06c-11fb-5ef6-a1f6-3f25d8c6ebf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341828}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5037faf6-6f8a-5ea2-800f-2c136a3bb59e" :question/math-academy-id "q-74218" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\n- $A={⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}=1}$\n- $B={⟨x,y,z⟩\\in {R}^{3}:xyz=0}$\n- $C={⟨x,y,z⟩\\in {R}^{3}:y=-1}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition ${x}^{2}+{y}^{2}+{z}^{2}=1$ since ${0}^{2}+{0}^{2}+{0}^{2}\\ne 1.$\n\n- The set $B$ is not a subspace because it is not closed under vector addition. Indeed, both $a=⟨1,0,1⟩$ and $b=⟨0,1,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0,1⟩+⟨0,1,1⟩=⟨1,1,2⟩\n$$\n\n \ndoes not satisfy the condition $xyz=0$ since $1\\cdot 1\\cdot 2\\ne 0.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $y=-1$ since $0\\ne -1.$\n\nSo, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186342191 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3171ea47-31ac-55ef-8e65-7c8cc13d17db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339563} {:answer/id #uuid "4780f3c7-7445-5e20-b679-8d09700f5b1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339761} {:answer/id #uuid "69308677-f0aa-523b-9be3-7371c6dc3d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340063} {:answer/id #uuid "7458caf1-0896-52f4-b93d-16c6705c4441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340166} {:answer/id #uuid "962e504c-ea04-57e3-acb7-34e1af23490d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340484}] :answer-field/correct {:answer/id #uuid "69308677-f0aa-523b-9be3-7371c6dc3d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340063} :answer-field/id #uuid "df4036f4-0b20-53ba-89f9-e6eee6e466b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341774}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb81e4a8-c5a7-59da-b168-b278b747b24a" :question/math-academy-id "q-74255" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}<\\frac{1}{2}\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:5x-y-z=0\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:5-x-z=0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. Indeed, the vector $u=⟨\\frac{1}{4},0,0⟩$ is in $A$, since\n\n$$\n\\sqrt{{(\\frac{1}{4})}^{2}+{0}^{2}+{0}^{2}}=\\frac{1}{4}<\\frac{1}{2},\n$$\n\nbut, $4u=⟨1,0,0⟩$ is not in $B$, since \n\n$$\n\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}}>\\frac{1}{2}.\n$$\n\nSo, $A$ is not closed under scalar multiplication.\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $5x-y-z=0$ since $5\\cdot 0-0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $5-x-z=0$ since $5-0-0\\ne 0.$\n\nIn conclusion, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186345004 :knowledge-point/_questions [{:db/id #edb/ref 17592186124457 :knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed" :knowledge-point/title "Calculating Limits Along Different Paths for Multivariable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74d47c5c-d9b2-5729-b276-f386649b4836" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186343248} {:answer/id #uuid "78689969-fa12-5d79-b86b-75a95aac6c30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343278} {:answer/id #uuid "93f165e9-4fa8-5327-af87-0aecc43a6729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343532} {:answer/id #uuid "b3d03412-f273-52d2-a7f8-85526134a1c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343815} {:answer/id #uuid "f7884f74-457b-566e-ac8e-ae3ebcb6b395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344417}] :answer-field/correct {:answer/id #uuid "93f165e9-4fa8-5327-af87-0aecc43a6729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343532} :answer-field/id #uuid "196a3494-8261-5fa3-924a-5e54ae02aac6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5fe00a2-ab56-5281-b3c2-6fe8dad2417a" :question/math-academy-id "q-74964" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}\n$$\n\nI. The limit evaluates to $0$ along the path $y=x$\n\nII. The limit evaluates to $2$ along the path $y={x}^{2}$\n\nIII. The limit exists and is equal to $2$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-x} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{x(2x-1)} \\\\  & ={lim}_{x\\to 0}\\frac{2x}{2x-1} \\\\  & =\\frac{2\\cdot 0}{2\\cdot 0-1} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is also true. Taking $x\\to (0,0)$ along the path $y={x}^{2},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2\\end{aligned}\n$$\n\n- Statement III is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186345029 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b9ca939-c7a6-5aeb-98c2-585d48ff8c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342604} {:answer/id #uuid "5716cd24-5a2c-5544-92f6-203e6a676437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342963} {:answer/id #uuid "6d2c0063-1ae4-55ca-87d1-b65a1e62305f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  only" :db/id #edb/ref 17592186343173} {:answer/id #uuid "731035c9-6220-52ed-886c-05ae731b34ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343235} {:answer/id #uuid "cf56f8d6-4634-5189-80bd-37357cd208d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186344062}] :answer-field/correct {:answer/id #uuid "2b9ca939-c7a6-5aeb-98c2-585d48ff8c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342604} :answer-field/id #uuid "51ec1b91-00af-5481-ab92-af724f5e618b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89a636cd-a216-5d73-bd3f-7f9cbe4badf4" :question/math-academy-id "q-75116" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\n- $C=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$\n- $C=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]$\n- $C=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form  because  the matrix on the left is not a unit lower triangular matrix, as its main diagonal contains a number not equal to $1.$\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\n- The second product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nC=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186345030 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ada63ec-fa1d-5ff7-b669-92737dcdbd74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342330} {:answer/id #uuid "1752c8df-b894-5390-b173-aa620c63a4ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186342443} {:answer/id #uuid "409dfa57-961d-5f83-aa15-10d15babbe22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342771} {:answer/id #uuid "467b7351-7ecb-539b-ba6e-6ea1995a8925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342818} {:answer/id #uuid "98410b31-6e91-581a-a43b-5311f6c98db0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186343573}] :answer-field/correct {:answer/id #uuid "467b7351-7ecb-539b-ba6e-6ea1995a8925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342818} :answer-field/id #uuid "6c138955-72ce-5ce7-a05a-28705f2a9e68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0305a43d-bf81-5ecb-8a77-49a30ade0147" :question/math-academy-id "q-75117" :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\nI. $A=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 0 & 1\\end{aligned}]$\n\nII. $A=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}]$\n\nIII. $A=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:  \n\n$$\nA=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$  on the main diagonal.\n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\n- The second product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal. \n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}]\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186345033 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454ea782-196e-50f9-b1e2-00d2d1bb0539" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342808} {:answer/id #uuid "4f08aad3-17c0-5aea-a1e3-8bc3cab0aea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342888} {:answer/id #uuid "4f2b2691-bd26-5b75-bf4a-0ab5f6a47c36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342891} {:answer/id #uuid "567c9971-93d6-5157-ae62-fc0890790260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342958} {:answer/id #uuid "9b54534f-b827-5c6c-a649-e71657a1ca05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343609}] :answer-field/correct {:answer/id #uuid "567c9971-93d6-5157-ae62-fc0890790260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342958} :answer-field/id #uuid "bc036018-08d5-5220-9a04-6989a4c32339" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34143660-ecfa-5585-b65e-76b215171706" :question/math-academy-id "q-75123" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\n- $C=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$\n- $C=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]$\n- $C=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]\\,✓\n$$\n\n- The second product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has a non-zero entry above the main diagonal. \n\n$$\nC=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]\\,\\times \n$$\n\n- The third product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$ on the main diagonal.\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186345092 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f2376a1-da00-5911-b146-c5236752448e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186342890} {:answer/id #uuid "58038b76-6478-52e3-88f8-675c4aa414d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186342974} {:answer/id #uuid "59103f60-0dff-5bf6-af9c-6267f890a47e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186342987} {:answer/id #uuid "9ea948d9-d1d3-5312-9f2b-e7b8089e8034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$  only" :db/id #edb/ref 17592186343638} {:answer/id #uuid "ae7d0947-9c9d-5773-b575-44075078af0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186343772}] :answer-field/correct {:answer/id #uuid "9ea948d9-d1d3-5312-9f2b-e7b8089e8034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$  only" :db/id #edb/ref 17592186343638} :answer-field/id #uuid "f466101d-ee92-54d3-b4e2-a9cca8e95913" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21485ec9-747a-5129-ba2c-794c570827bf" :question/math-academy-id "q-75496" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:={R}_{1}+(-2){R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-3){R}_{1}?$\n\n$$\nA=[\\begin{aligned}1 & 5 \\\\ 1 & 4\\end{aligned}],\\,B=[\\begin{aligned}7 & 2 \\\\ 3 & 1\\end{aligned}],\\,C=[\\begin{aligned}9 & 2 \\\\ 4 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 \\\\ 1 & 4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -3 \\\\ 1 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -3 \\\\ 4 & 13\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}7 & 2 \\\\ 3 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}9 & 2 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186345095 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dad3104-8a81-5836-a5a9-4e944d9ea89c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186342747} {:answer/id #uuid "6aa425cd-c3c4-550e-9bf6-9b7007b60940" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186343145} {:answer/id #uuid "7230a1e9-8e89-5267-aa7f-a81a5c6cccc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186343226} {:answer/id #uuid "9b1e7dd8-43cf-517f-b457-c549b0d0e69e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343606} {:answer/id #uuid "ae816524-bdcc-57d3-b1f0-57315f7a80b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186343773}] :answer-field/correct {:answer/id #uuid "7230a1e9-8e89-5267-aa7f-a81a5c6cccc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186343226} :answer-field/id #uuid "5db32577-42b1-5ff0-9984-873d995d7e37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9438fd33-674b-505b-988d-ed78456eace8" :question/math-academy-id "q-75503" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-3){R}_{1}?$\n\n$$\nA=[\\begin{aligned}6 & 1 \\\\ 1 & 0\\end{aligned}],\\,B=[\\begin{aligned}-3 & 1 \\\\ 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}3 & 1 \\\\ 1 & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}6 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 6 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}-3 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -6 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ C & =[\\begin{aligned}3 & 1 \\\\ 1 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"$C$ only\"."}] [{:db/id #edb/ref 17592186345097 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f9218e3-c5a3-504e-a8aa-4c7a7a889102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186343047} {:answer/id #uuid "76c4e5d3-bf62-5530-bdeb-b43a0ad3242b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343269} {:answer/id #uuid "97298d24-d2e5-5c5a-a83a-d3564f5c03e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186343563} {:answer/id #uuid "c98ee987-6e30-5c28-bec6-af41c5351ce3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186344008} {:answer/id #uuid "f8bb85dd-13a5-594c-b825-a8dcdeb42be7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186344427}] :answer-field/correct {:answer/id #uuid "5f9218e3-c5a3-504e-a8aa-4c7a7a889102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186343047} :answer-field/id #uuid "18674c8a-58e7-537d-943e-33b31c03bca5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d8b28abc-ffbd-5f2b-b51a-6be08eb05498" :question/math-academy-id "q-75508" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:=\\frac{1}{4}{R}_{1}\\,$ and $\\,{R}_{2}:={R}_{2}+3{R}_{1}?$\n\n$$\nA=[\\begin{aligned}4 & 0 \\\\ -3 & 1\\end{aligned}],\\,B=[\\begin{aligned}8 & 0 \\\\ -6 & 1\\end{aligned}],\\,C=[\\begin{aligned}4 & 0 \\\\ -4 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 0 \\\\ -3 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ B & =[\\begin{aligned}8 & 0 \\\\ -6 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ -6 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ C & =[\\begin{aligned}4 & 0 \\\\ -4 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{4}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id #edb/ref 17592186345106 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18956b73-de0f-5274-ad02-5066c0d2657b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186342456} {:answer/id #uuid "2d821b77-91b8-542f-b59c-7b5c3ebcd4ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186342620} {:answer/id #uuid "4b54bdc7-fb8f-5924-947c-0a287faf9bbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186342858} {:answer/id #uuid "6348b2b2-8ae7-537e-909c-bb22df4127b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186343078} {:answer/id #uuid "8bce61b5-2b6e-5b57-a1a3-1eef97b998b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343459}] :answer-field/correct {:answer/id #uuid "8bce61b5-2b6e-5b57-a1a3-1eef97b998b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343459} :answer-field/id #uuid "40b7d972-25a9-5d09-b9bb-575a2e8ee618" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd25b025-461f-556b-97f3-6071c19d59d7" :question/math-academy-id "q-75595" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=4{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=[\\begin{aligned}4 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}],\\,B=[\\begin{aligned}2 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 1 \\\\ \\frac{3}{4} & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}4 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}\\frac{1}{4} & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :=4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}2 & 1 \\\\ \\frac{1}{4} & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}\\frac{1}{4} & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{1} & :=4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}1 & 1 \\\\ \\frac{3}{4} & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}\\frac{3}{4} & 0 \\\\ 1 & 1\\end{aligned}] & {R}_{1} & :=4{R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 \\\\ 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}3 & 0 \\\\ -5 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186345107 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59d338f8-b49b-5145-a7ef-1ae582d559cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186342991} {:answer/id #uuid "92dcfa7a-f257-5a95-9893-29619578a1b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186343522} {:answer/id #uuid "ea5a63f9-bd01-5a20-a2a4-c0a864ce4a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186344291} {:answer/id #uuid "f0b90c65-9660-55b2-9d45-57ee11b4570d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186344351} {:answer/id #uuid "f3f172f0-b5cc-56f2-9005-34aef17200e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186344385}] :answer-field/correct {:answer/id #uuid "ea5a63f9-bd01-5a20-a2a4-c0a864ce4a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186344291} :answer-field/id #uuid "d16727b3-99b0-547b-8c45-25b008d782b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344853}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a52696c-f90c-56a7-94f5-6062f59efbae" :question/math-academy-id "q-75599" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2},\\,$ ${R}_{1}:=\\frac{1}{2}{R}_{1},\\,$ and $\\,{R}_{2}:={R}_{2}+(-2){R}_{1}?$\n\n$$\nA=[\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}],\\,B=[\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}],\\,C=[\\begin{aligned}4 & 1 \\\\ 2 & 0\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}2 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ B & =[\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ C & =[\\begin{aligned}4 & 1 \\\\ 2 & 0\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}2 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$A$ only\"."}] [{:db/id #edb/ref 17592186345112 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c30cee0-847d-5f40-ae43-134afe788817" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186343010} {:answer/id #uuid "5e4716f8-1d1a-5bf6-a69d-02354cf35afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343030} {:answer/id #uuid "6557bb3a-d669-5757-bc6e-f43fb74887f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343098} {:answer/id #uuid "7375a3b9-bff4-58a6-82e9-4245781699f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343237} {:answer/id #uuid "bdf19162-0472-5764-b148-da9e42eaf104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186343910}] :answer-field/correct {:answer/id #uuid "5e4716f8-1d1a-5bf6-a69d-02354cf35afa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343030} :answer-field/id #uuid "736c3de5-9a79-5920-82d2-3cbc3976ab40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344700}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2f25df3d-4b0c-5b67-901d-8d878d2769ac" :question/math-academy-id "q-75655" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}3 \\\\ -6 \\\\ 12\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 3 \\\\ -4\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}1 \\\\ 1 \\\\ 4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n{\\begin{aligned}3{x}_{1}-{x}_{2}+{x}_{3}=0 \\\\ -6{x}_{1}+3{x}_{2}+{x}_{3}=0 \\\\ 12{x}_{1}-4{x}_{2}+4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -1 & 1 & 0 \\\\ -6 & 3 & 1 & 0 \\\\ 12 & -4 & 4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}3 & -1 & 1 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 12 & -4 & 4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼[\\begin{aligned}3 & -1 & 1 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements II and III are false, while statement I is true."}] [{:db/id #edb/ref 17592186345113 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3da42d2a-fc8c-5560-a05e-8ebb08251ab7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186342746} {:answer/id #uuid "428056c7-8c15-5083-b495-0a5d2db7568d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186342788} {:answer/id #uuid "b05bd9d9-23cf-5926-8e64-3aa606f0b446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343789} {:answer/id #uuid "f974dbb8-fa3b-57e5-b4a2-cbf533523461" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186344432} {:answer/id #uuid "ff6841f4-2ac2-55ac-8a6c-00752966eb25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344488}] :answer-field/correct {:answer/id #uuid "b05bd9d9-23cf-5926-8e64-3aa606f0b446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343789} :answer-field/id #uuid "6c97eb9a-a992-5953-a80c-a71608c9beca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344686}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0d48ab70-ab46-5142-a432-382f1feb7bb9" :question/math-academy-id "q-75659" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 2 \\\\ -2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$\n\nIII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}=0 \\\\ -{x}_{1}+2{x}_{2}-2{x}_{3}=0 \\\\ 2{x}_{1}-2{x}_{2}+{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 0 & 0 \\\\ -1 & 2 & -2 & 0 \\\\ 2 & -2 & 1 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 2 & -2 & 1 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 0 & 0 \\\\ 0 & 1 & -2 & 0 \\\\ 0 & 0 & 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}=0 \\\\ {x}_{2}-2{x}_{3}=0 \\\\ {x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-2(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements II and III are true, while statement I is false."}] [{:db/id #edb/ref 17592186345114 :knowledge-point/_questions [{:db/id #edb/ref 17592186119925 :knowledge-point/id #uuid "52a45814-d1e2-5948-b7bd-69dcaf6cd0eb" :knowledge-point/title "Identifying Linearly Independent and Dependent Sets Using Row Reduction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11972855-80a9-5cac-9e70-8a4fcbdccf24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186342393} {:answer/id #uuid "2bfeba34-6da2-5961-afdc-9d9564e3b098" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342608} {:answer/id #uuid "ac5b646e-db57-5a8d-9e82-9eb0862b3d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343756} {:answer/id #uuid "acba01cf-19c6-57a0-8cf2-d050702ea3a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343758} {:answer/id #uuid "f9874691-41fb-52a1-b9c0-d3eb10d101ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344433}] :answer-field/correct {:answer/id #uuid "ac5b646e-db57-5a8d-9e82-9eb0862b3d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343756} :answer-field/id #uuid "d156fe28-1c7f-5127-9119-2df01429f973" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344852}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8d177800-f6a6-59b3-bf6e-5adc772e358a" :question/math-academy-id "q-75660" :question/problem "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -4 \\\\ -3\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-3 \\\\ 13 \\\\ 9\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}2 \\\\ -7 \\\\ -4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nIII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions." :question/worked-solution "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=0 \\\\ -4{x}_{1}+13{x}_{2}-7{x}_{3}=0 \\\\ -3{x}_{1}+9{x}_{2}-4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 2 & 0 \\\\ -4 & 13 & -7 & 0 \\\\ -3 & 9 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ -3 & 9 & -4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 & 0 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}{x}_{1}-3{x}_{2}+2{x}_{3}=0 \\\\ {x}_{2}+{x}_{3}=0 \\\\ 2{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n{x}_{1}-3(0)+2(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements II and III are false, while statement I is true."}] [{:db/id #edb/ref 17592186345121 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1299352e-d2ef-5e23-a6a9-e3484a823eab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342402} {:answer/id #uuid "6945182e-95b7-5e01-ab43-e486bfa69c53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343137} {:answer/id #uuid "cab42dea-25c4-565b-904b-b7e77ae2c127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344021} {:answer/id #uuid "e402b43c-fdcf-51ca-9fd7-ca29f619233d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186344240} {:answer/id #uuid "ea45b5bf-09d1-5fd5-a6ce-b44ab9b5150c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186344290}] :answer-field/correct {:answer/id #uuid "cab42dea-25c4-565b-904b-b7e77ae2c127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344021} :answer-field/id #uuid "200fb1e1-dd6d-5c55-afee-57f8fc7300f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344549}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a5c031b-68ff-5d30-80f0-79dec42f9067" :question/math-academy-id "q-75729" :question/problem "Which of the following statements are true?\n\n- If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =-2.$\n- An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =1$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =1.$\n- If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $7v$ is also an eigenvector of $A$ corresponding to $\\lambda =\\frac{1}{2}.$" :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement is false. By the definition of an eigenvector, we have \n\n$$\nAv=2v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=2{A}^{-1}v.\n$$\n\nDividing both sides by $2$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{2}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{2}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is true. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =1$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{1}=1.$\n\n- Statement III is false. We have\n\n$$\n\\begin{aligned}A(7v)=7Av=7(2v)=2(7v).\\end{aligned}\n$$\n\nSince, $A(7v)=2(7v),$ and $7v\\ne 0,$ this implies that $7v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186345193 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5900b2ad-c394-58a3-8661-86744ec49f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186342986} {:answer/id #uuid "71ec907a-fb23-50c4-8b1c-c42f54b462fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343223} {:answer/id #uuid "80e38216-9a2e-56cf-9bab-79d5b46a98fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343349} {:answer/id #uuid "b1ee4e70-3d9b-51db-b23d-bc1a59a3bace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343800} {:answer/id #uuid "f0ea78ef-a8ff-5431-b650-ef064402d8dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344358}] :answer-field/correct {:answer/id #uuid "5900b2ad-c394-58a3-8661-86744ec49f7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186342986} :answer-field/id #uuid "4cf7e708-707f-5e09-821c-37a874528e08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344623}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca01d454-a476-5d37-9896-aa972462aa23" :question/math-academy-id "q-76208" :question/problem "![](images/ab/abfd15c8ed134a30ad719f6a857268427511e7f1f15ecfe0d27e5026b5401a83.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-2)$\n- $x\\in [-2,3)$\n- $x\\in [3,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is continuous on the open interval $(-\\infty ,-2).$\n\n- The function is continuous on $[-2,3).$ It is continuous on $(-2,3)$ and also right continuous at $x=-2.$\n\n- The function is continuous on $[3,\\infty ).$ It is continuous on $(3,\\infty )$ and also right continuous at $x=3.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186345195 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26764b32-2c60-587f-b8c5-37fa19d94968" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function is not continuous on any of the given intervals" :db/id #edb/ref 17592186342564} {:answer/id #uuid "2efc0ccc-6f9e-51e2-9559-c2a8b34966df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342632} {:answer/id #uuid "a45ef78d-716e-51d4-a3ff-b11c8025f4f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343688} {:answer/id #uuid "b3675348-452e-5b76-9643-725033643714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343813} {:answer/id #uuid "c24a3e56-f567-5ca6-9f4a-165390ecbf5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343946}] :answer-field/correct {:answer/id #uuid "2efc0ccc-6f9e-51e2-9559-c2a8b34966df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342632} :answer-field/id #uuid "6aaefafc-ce87-53d2-9580-dce1180a6863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d16a77c7-8df1-5b6e-bc46-f6c511c4b268" :question/math-academy-id "q-76210" :question/problem "![](images/5e/5e787dda0cccdafaa6a93176daea5f954b1cd1da0beaff410a6563536459208e.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,-1]$\n- $x\\in [-2,0]$\n- $x\\in [-1,\\infty )$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is continuous on $(-\\infty ,-1].$ It is continuous on $(-\\infty ,-1)$ and also left continuous at $x=-1.$\n\n- The function is *not* continuous on $[-2,0]$ because it contains a discontinuity at $x=-1.$\n\n- The function is *not* continuous on $[-1,\\infty ).$ Although the function is continuous on $(-1,\\infty ),$ it is not right-continuous at $x=-1.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186345197 :knowledge-point/_questions [{:db/id #edb/ref 17592186078487 :knowledge-point/id #uuid "f00fd821-a5d4-5844-9db5-795b9e321b94" :knowledge-point/title "Identifying the Largest Intervals of Continuity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1075d718-40b0-5742-b4f2-dbdbdf2e06b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342380} {:answer/id #uuid "15769205-ba90-5639-abae-d9422352b485" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function is not continuous on any of the given intervals" :db/id #edb/ref 17592186342429} {:answer/id #uuid "39cc683a-00e8-585f-91ea-14d5c5a1dfa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342715} {:answer/id #uuid "9c5540c3-8c22-5a59-9e92-56b97da12a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343616} {:answer/id #uuid "d40e7fd5-7f34-56f0-93bc-e8e4ed2a8dc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344099}] :answer-field/correct {:answer/id #uuid "1075d718-40b0-5742-b4f2-dbdbdf2e06b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342380} :answer-field/id #uuid "4f8fe9a0-755d-5543-a40d-443c23f5ea83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344629}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8275053-44d7-522b-8662-3358231e9c18" :question/math-academy-id "q-76218" :question/problem "![](images/18/186ac941080da34b7c149534a2e255852241b28855c0ef15db2beee2d692007a.png)\n\nConsider the function $y=f(x)$ above. On which of the following intervals is the function continuous? \n\n- $x\\in (-\\infty ,3]$\n- $x\\in (-\\infty ,5)$\n- $x\\in (4,6)$\n\nYou may assume that all points of discontinuity of $f(x)$ are shown in the diagram." :question/worked-solution "Let's examine each statement.\n\n- The function is *not* continuous on $(-\\infty ,3].$ Although the function is continuous on $(-\\infty ,3),$ it is not left-continuous at $x=3.$\n\n- The function is *not* continuous on $(-\\infty ,5)$ because it contains a discontinuity at $x=3.$\n\n- The function is continuous on $(4,6).$ It is continuous on $[3,\\infty )$ and this contains the interval $(4,6).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186345292 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12f5e655-d76e-5618-a17f-2483870f80ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342404} {:answer/id #uuid "4a960852-e36e-5de9-accc-56acd04910ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186342852} {:answer/id #uuid "6234df6c-15c7-5877-b0fb-75883f2806a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343071} {:answer/id #uuid "df4e9b9c-c909-5afd-bf7b-e6148fe13a5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186344196} {:answer/id #uuid "f6e83d4b-c078-5faf-ac16-d2afb50445ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186344411}] :answer-field/correct {:answer/id #uuid "f6e83d4b-c078-5faf-ac16-d2afb50445ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186344411} :answer-field/id #uuid "467ab3d5-e2b3-5afa-a2e2-f13c2a37966a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43864da8-ac06-5dee-a580-c31c2739a8e7" :question/math-academy-id "q-77389" :question/problem "![](images/e1/e17584d96cb8d83ccb1abfbd16c4117f58639b7cd3462ee50ad3f31e4eabe279.png)\n\nIn figure $ABCDEF$ shown above, which of the following equalities are true?\n\n- $\\overset{\\to }{BC}-\\overset{\\to }{DC}=\\overset{\\to }{BD}$\n- $\\overset{\\to }{BA}+\\overset{\\to }{AE}-\\overset{\\to }{FE}=\\overset{\\to }{BF}$\n- $\\overset{\\to }{CD}-\\overset{\\to }{ED}-\\overset{\\to }{FE}=\\overset{\\to }{FC}$" :question/worked-solution "- Equality I is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{BC}-\\overset{\\to }{DC} & =\\overset{\\to }{BC}+\\overset{\\to }{CD} \\\\  & =\\overset{\\to }{BD}.\\end{aligned}\n$$\n\n- Equality II is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{BA}+\\overset{\\to }{AE}-\\overset{\\to }{FE} & =\\overset{\\to }{BA}+(\\overset{\\to }{AE}+\\overset{\\to }{EF}) \\\\  & =\\overset{\\to }{BA}+\\overset{\\to }{AF} \\\\  & =\\overset{\\to }{BF}.\\end{aligned}\n$$\n\n- Equality III is false. Indeed,\n\n$$\n\\begin{aligned}\\overset{\\to }{CD}-\\overset{\\to }{ED}-\\overset{\\to }{FE} & =(\\overset{\\to }{CD}+\\overset{\\to }{DE})+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{CE}+\\overset{\\to }{EF} \\\\  & =\\overset{\\to }{CF} \\\\  & \\ne \\overset{\\to }{FC}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186345293 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f96b37-25e2-57e5-a9bd-ce85f77ef622" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342559} {:answer/id #uuid "6810a70d-fc25-5dc9-9176-1e77c5c64ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343123} {:answer/id #uuid "9b153830-307e-510b-95ec-885456562d1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343605} {:answer/id #uuid "d9f2fb38-44b4-51a3-ae94-6982dfb498bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344152} {:answer/id #uuid "f051a762-fe84-5e5b-a57f-76839faef4a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186344349}] :answer-field/correct {:answer/id #uuid "d9f2fb38-44b4-51a3-ae94-6982dfb498bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344152} :answer-field/id #uuid "6cc90745-e978-5189-b064-c8cfba27da07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344687}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dfe3c702-6424-5bb5-8a56-52b5a6e22724" :question/math-academy-id "q-77400" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}x-y=2 \\\\ 2x+y=k\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-6$\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=-12$\n- $|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|=3$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}| \\\\  & =1+2 \\\\  & =3.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{|\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}|}{3} \\\\ |\\begin{aligned}1 & 2 \\\\ 2 & k\\end{aligned}| & =-6\\end{aligned}\n$$\n\nSo, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186345294 :knowledge-point/_questions [{:db/id #edb/ref 17592186119790 :knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d" :knowledge-point/title "Solving for a Coefficient in a 2x2 Linear System Using Cramer's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bb0734-b113-5738-811e-5ed128d214ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342507} {:answer/id #uuid "27742a41-54e2-59b5-b786-db849377783d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342573} {:answer/id #uuid "44122616-845c-5061-9e80-69872573e8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186342803} {:answer/id #uuid "8d84791f-2e4f-5e1a-8d1d-454662569e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343476} {:answer/id #uuid "b6e5462b-343b-5798-95b7-33b70f0f69a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343841}] :answer-field/correct {:answer/id #uuid "8d84791f-2e4f-5e1a-8d1d-454662569e37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343476} :answer-field/id #uuid "6c1e02f2-9665-5243-aedc-17c100ebdba4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344684}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a75a54e5-59f0-5536-9005-ac12974e1a69" :question/math-academy-id "q-77401" :question/problem "Let $⟨x,1⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}3x-y=k \\\\ x+4y=3\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=5$\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=-7$\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=13$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}3 & -1 \\\\ 1 & 4\\end{aligned}| \\\\  & =12+1 \\\\  & =13.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}1 & =\\frac{{D}_{y}}{D} \\\\ 1 & =\\frac{|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|}{13} \\\\ |\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}| & =13\\end{aligned}\n$$\n\nSo, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186345308 :knowledge-point/_questions [{:db/id #edb/ref 17592186119931 :knowledge-point/id #uuid "a6a3d254-c96f-5aa0-9db6-a587eb7cb2de" :knowledge-point/title "Calculating an Expression Involving Given Determinants and Matrix Types"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e2d978-2c80-5bfd-8184-7620c86b4d9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342796} {:answer/id #uuid "87caf754-01fe-5135-8e0f-3937db98fe01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186343413} {:answer/id #uuid "aaac6d10-cd8e-529d-b81e-8bac65acd12c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186343740} {:answer/id #uuid "df109891-92e9-56d1-95e6-b29b4c4c96cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186344195} {:answer/id #uuid "f39fd878-ef99-5884-b619-883485188f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186344383}] :answer-field/correct {:answer/id #uuid "aaac6d10-cd8e-529d-b81e-8bac65acd12c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186343740} :answer-field/id #uuid "1ae19f3c-dbd3-5456-af19-7dc1239a420f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344540}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49749c9e-4840-5ef3-a87f-c1ce7810b100" :question/math-academy-id "q-77503" :question/problem "Given that $det(A)=2$, which of the following statements are true? \n\n- $-2\\text{det}({A}^{T})-3\\text{det}(I)=7$\n- $4\\text{det}({A}^{T})=2$\n- $\\text{det}({A}^{T})-\\text{det}(I)=-\\frac{1}{2}$" :question/worked-solution "From the properties of determinants, we know that \n\n$$\n\\text{det}({A}^{T})=\\text{det}(A)=2\n$$\n\nand\n\n$$\ndet(I)=1.\n$$\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false. We have,\n\n$$\n-2\\text{det}({A}^{T})-3\\text{det}(I)=-2\\cdot 2-3\\cdot 1=-7\\ne 7.\n$$\n\n- Statement II is false. We have\n\n$$\n4\\text{det}({A}^{T})=4\\cdot 2=8\\ne 2.\n$$\n\n- Statement III is false. We have\n\n$$\n\\text{det}({A}^{T})-\\text{det}(I)=2-1=1\\ne -\\frac{1}{2}.\n$$\n\nIn conclusion, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186345345 :knowledge-point/_questions [{:db/id #edb/ref 17592186064280 :knowledge-point/id #uuid "5b4b32f9-8362-5c81-a1fe-4457d91ae571" :knowledge-point/title "Identifying Functions That Satisfy the Mean Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c9b65e-8aab-58e4-9ff8-f146c4b1dfb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186342412} {:answer/id #uuid "bc16e6f4-a9a7-5ef2-a3e8-5f2cc8fd2073" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186343890} {:answer/id #uuid "dcbb9443-92d4-5c38-8324-856eb59d6047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344177} {:answer/id #uuid "e96dfec3-2242-5abf-9843-aa4fbc07fe3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186344281} {:answer/id #uuid "edf0bc6b-95d8-5574-ae34-66cc789aa7f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186344329}] :answer-field/correct {:answer/id #uuid "13c9b65e-8aab-58e4-9ff8-f146c4b1dfb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186342412} :answer-field/id #uuid "35f8c506-59e5-5df7-b6f5-b6b5ef1620ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344587}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0acb71b-a2ed-51d8-8bca-93474ee1c192" :question/math-academy-id "q-77864" :question/problem "Which of the following functions satisfies the conditions of the mean value theorem over the interval $[-2,2]?$\n\n- $f(x)=\\frac{1}{{x}^{2}+1}$\n- $g(x)=|{x}^{2}+1|$\n- $h(x)=\\operatorname{ln}⁡({x}^{2}+1)$" :question/worked-solution "For a function to satisfy the conditions of the mean value theorem over the interval $[-2,2],$ the function must be continuous on $[-2,2]$ and differentiable on $(-2,2).$\n\nLet's check each function individually.\n\n- The function $f(x)=\\frac{1}{{x}^{2}+1}$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-2,2]$ and differentiable on $(-2,2).$ Therefore, $f(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $g(x)=|{x}^{2}+1|$ is equivalent to $p(x)={x}^{2}+1,$ so it is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-2,2]$ and differentiable on $(-2,2).$ Therefore, $g(x)$ satisfies the conditions of the mean value theorem.\n\n- The function $h(x)=\\operatorname{ln}⁡({x}^{2}+1)$ is continuous and differentiable on $(-\\infty ,\\infty ).$ In particular, it is continuous on $[-2,2]$ and differentiable on $(-2,2).$ Therefore, $h(x)$ satisfies the conditions of the mean value theorem.\n\nTherefore, the functions I, II, and III satisfy the conditions for the mean value theorem over the interval $[-2,2].$"}] [{:db/id #edb/ref 17592186348109 :knowledge-point/_questions [{:db/id #edb/ref 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185619d8-1b91-5d2f-af5e-dee1634d5555" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186345565} {:answer/id #uuid "44f107dd-253f-5b2e-bda0-164d1239fdcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186345949} {:answer/id #uuid "515c1c66-f6e4-50c0-b52d-198cd74b8a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186346047} {:answer/id #uuid "8d916295-fa1a-5ff5-ba9b-5d907aac02a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186346582} {:answer/id #uuid "e3b4ad68-2c01-51fc-89a3-6a26083ddcde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186347353}] :answer-field/correct {:answer/id #uuid "e3b4ad68-2c01-51fc-89a3-6a26083ddcde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186347353} :answer-field/id #uuid "d1aaa798-00b3-55fa-9339-75ae07399b92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347971}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad44d2b4-38e0-5faa-8080-32a8feda902f" :question/math-academy-id "q-78772" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{2}:={R}_{2}+{R}_{1}\\,$ and $\\,{R}_{3}:={R}_{3}+(-1){R}_{2}?$\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 0 & 2 & 2\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 0 & 1 \\\\ -1 & 1 & 0 \\\\ 0 & 2 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 2 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}1 & 0 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}1 & 0 & 0 \\\\ 1 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ -2 & -3 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186348154 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d1ea255-7dc4-54d4-9172-7acf08d05cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345453} {:answer/id #uuid "b2253313-0064-565d-aab1-ac081b160a04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186346906} {:answer/id #uuid "b4c2d995-4b9c-5b32-8ff4-4cd6a59aa059" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186346926} {:answer/id #uuid "ccb08342-c5da-554a-bb78-0962f941c5a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347141} {:answer/id #uuid "da3e0bea-256a-5720-8bd7-3b470182a9c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347270}] :answer-field/correct {:answer/id #uuid "0d1ea255-7dc4-54d4-9172-7acf08d05cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345453} :answer-field/id #uuid "d0666484-0b92-5c23-994f-2dff9365864f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347966}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3b9e269-d2c5-5e09-8e6b-2689345ee964" :question/math-academy-id "q-79039" :question/problem "Consider the function $f(x)={x}^{3}-6{x}^{2}+5x.$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(2,\\infty )$\n- $f(x)$ is concave up on $(2,\\infty )$\n- $f(x)$ is concave up on $(-\\infty ,2)$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}-12x+5 \\\\ {f}^{″}(x) & =6x-12.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}6x-12 & >0\\,⟹\\,x>2.\\end{aligned}\n$$\n\nSo, the function is concave up on $(2,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $6x-12<0,$ which has the solution $(-\\infty ,2).$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186348159 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f70b66-96e9-5aae-93da-647ff3e21f32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186345413} {:answer/id #uuid "1ccbca84-26a7-531b-bc40-848a39c9d145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345601} {:answer/id #uuid "820bdb8d-1b1f-5a23-91ee-e42c0fd7b00c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346488} {:answer/id #uuid "964ca8d1-bc5e-5d1c-a5e6-7d742ff7cbd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346665} {:answer/id #uuid "b684115e-c70b-5e4f-9a6a-91ed32fef39b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346942}] :answer-field/correct {:answer/id #uuid "b684115e-c70b-5e4f-9a6a-91ed32fef39b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346942} :answer-field/id #uuid "f84b80f4-3cda-509e-bb73-3c54426e4477" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348041}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d60b7843-0bd3-5e4e-8b85-becdd36b22ac" :question/math-academy-id "q-79047" :question/problem "Consider the function $f(x)=2+3x-{e}^{-x}.$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(-\\infty ,\\infty )$\n- $f(x)$ is concave up on $(0,\\infty )$\n- $f(x)$ is concave up on $(-\\infty ,0)$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3+{e}^{-x} \\\\ {f}^{″}(x) & =-{e}^{-x}\\end{aligned}\n$$\n\nSince ${e}^{-x}>0$ for every real value of $x,$ it follows that $-{e}^{-x}<0$ for every real value of $x.$ Therefore, ${f}^{″}(x)$ is never positive, so there are no intervals where $f(x)$ is concave up.\n\nSince ${f}^{″}(x)<0$ for every real value of $x,$ the function is concave down on $(-\\infty ,\\infty ).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186348182 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406edcd7-dd0d-553f-94d4-59c097c98af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$G$ only" :db/id #edb/ref 17592186345904} {:answer/id #uuid "465f4a2b-19c0-58df-8ab0-2cc0a8ebc295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186345964} {:answer/id #uuid "47dcbc0e-948f-533c-8be5-738050dd7dae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ and $G$ only" :db/id #edb/ref 17592186345967} {:answer/id #uuid "c7f84565-bd95-5131-8e6d-cd3a127bd0b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $F$ only" :db/id #edb/ref 17592186347089} {:answer/id #uuid "c9ba910b-46fc-5621-8530-c677d52695b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ and $G$ only" :db/id #edb/ref 17592186347109}] :answer-field/correct {:answer/id #uuid "465f4a2b-19c0-58df-8ab0-2cc0a8ebc295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$F$ only" :db/id #edb/ref 17592186345964} :answer-field/id #uuid "723ed971-5225-51a2-a32f-826e5f345808" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347809}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cd97c58-6193-5fe7-8948-41d6f4bfcd71" :question/math-academy-id "q-7923" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nD=[\\begin{aligned}3 & 2 \\\\ 6 & 6\\end{aligned}],\\,F=[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}],\\,G=[\\begin{aligned}-2 & 2 \\\\ 4 & 4\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $D$, we have\n\n$$\ndet(D)=3\\cdot 6-6\\cdot 2=6.\n$$\n\nBecause $det(D)\\ne 0,$ we conclude that $D$ is invertible.\n\n- For the matrix $F$, we have\n\n$$\ndet(F)=6\\cdot 6-6\\cdot 6=0.\n$$\n\nBecause $det(F)=0,$ we conclude that $F$ is not invertible.\n\n- For the matrix $G$, we have\n\n$$\ndet(G)=(-2)\\cdot 4-4\\cdot 2=-16.\n$$\n\nBecause $det(G)\\ne 0,$ we conclude that $G$ is invertible.\n\nTherefore, only $F$ does not have an inverse."}] [{:db/id #edb/ref 17592186348208 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097b8a1b-b44d-5e76-97c8-b4c1a59a0e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186345426} {:answer/id #uuid "6baff456-609b-5210-afb9-ca38e5adabcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186346284} {:answer/id #uuid "bbc14084-3088-5b8a-ba2d-7b0e0a1aadc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346981} {:answer/id #uuid "cdb60f3a-a601-548c-bc1f-20c9cc148f2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347151} {:answer/id #uuid "ffc15575-a017-565f-8f76-b1cadb4fc7dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347601}] :answer-field/correct {:answer/id #uuid "bbc14084-3088-5b8a-ba2d-7b0e0a1aadc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346981} :answer-field/id #uuid "458244de-522e-5387-a418-9f5ed1cbeef6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347720}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e25ee2d5-6236-5cb7-ae46-36798fde6f33" :question/math-academy-id "q-79334" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then  $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $A$ is **not** invertible\n\nII. $\\text{rank}(A)=n$\n\nIII. $\\text{Col}(A)={R}^{n}$" :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is **not** invertible.* $\\,\\times $\n\nBy the invertible matrix theorem, since $\\text{nullity}(A)=0,$ we must have that $A$ is invertible.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{rank}(A)=n.$* $\\,✓$ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{rank}(A)=\\text{dim(Col}(A))=n.$\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Col}(A)={R}^{n}.$* $\\,✓$\n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)={R}^{n}.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186348227 :knowledge-point/_questions [{:db/id #edb/ref 17592186059789 :knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c1e4021-3396-5bc6-83ea-5a27c6cabe76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345596} {:answer/id #uuid "3dea748a-d0d4-5afc-925f-273d667f091e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345875} {:answer/id #uuid "7243bf19-b992-547d-9233-c657639a06c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346361} {:answer/id #uuid "d13f5329-2ec1-5018-9bce-9ec236dfe908" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347185} {:answer/id #uuid "d7dc2a08-b945-5e4e-9cd1-679eca7a90c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347252}] :answer-field/correct {:answer/id #uuid "d13f5329-2ec1-5018-9bce-9ec236dfe908" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347185} :answer-field/id #uuid "ced0da57-29f7-5224-b3bb-c98987c02847" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347960}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8289966f-f636-5804-9edf-c054d1b5acd5" :question/math-academy-id "q-79457" :question/problem "Which of the following numbers lie in the second quadrant in the corresponding Argand diagram?\n\n- $-2-2\\text{i}$\n- $-2+\\text{i}$\n- $-1+2\\text{i}$" :question/worked-solution "- The complex number $-2-2\\text{i}$ has the real part $x=-2$ and the imaginary part $y=-2.$ So, it corresponds to the point $(-2,-2)$, which lies in the third quadrant.\n\n- The complex number $-2+\\text{i}$ has the real part $x=-2$ and the imaginary part $y=1.$ So, it corresponds to the point $(-2,1)$, which lies in the second quadrant.\n\n- The complex number $-1+2\\text{i}$ has the real part $x=-1$ and the imaginary part $y=2.$ So, it corresponds to the point $(-1,2)$, which lies in the second quadrant.\n\n![](images/9f/9f2e7234ba52d14098e0ecfc9695181b425764c110995b76b4b0efddf206252c.png)\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186348228 :knowledge-point/_questions [{:db/id #edb/ref 17592186059789 :knowledge-point/id #uuid "f4b612ef-ce7f-5783-848d-d8ef210c9f47" :knowledge-point/title "Identifying an Argand Diagram Corresponding to a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d4636db-db02-5863-92b4-8abb34eb2771" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346581} {:answer/id #uuid "a4bb8bff-0b5e-51a9-8760-878220ba9463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346788} {:answer/id #uuid "c1f68a00-1742-54f4-9473-c700f4f12b30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347028} {:answer/id #uuid "ca930a2a-126d-5edd-aa68-a071673eb20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347117} {:answer/id #uuid "e2c0088a-60c2-538f-9ba7-d71e584516e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347346}] :answer-field/correct {:answer/id #uuid "ca930a2a-126d-5edd-aa68-a071673eb20c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347117} :answer-field/id #uuid "fd69c411-1af3-5cc9-9bc9-5772e6c3d56f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348048}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1861228f-d3da-56c4-af5a-dc5d012713d1" :question/math-academy-id "q-79458" :question/problem "Which of the following numbers lie in the fourth quadrant in an Argand diagram?\n\n- $\\frac{3}{2}-\\text{i}$\n- $-\\frac{1}{2}-\\frac{1}{2}\\text{i}$\n- $\\frac{1}{2}+\\frac{3}{2}\\text{i}$" :question/worked-solution "- The complex number $\\frac{3}{2}-\\text{i}$ has the real part $x=\\frac{3}{2}$ and the imaginary part $y=-1.$ So, it corresponds to the point $(\\frac{3}{2},-1)$, which lies in the fourth quadrant.\n\n- The complex number $-\\frac{1}{2}-\\frac{1}{2}\\text{i}$ has the real part $x=-\\frac{1}{2}$ and the imaginary part $y=-\\frac{1}{2}.$ So, it corresponds to the point $(-\\frac{1}{2},-\\frac{1}{2})$, which lies in the third quadrant.\n\n- The complex number $\\frac{1}{2}+\\frac{3}{2}\\text{i}$ has the real part $x=\\frac{1}{2}$ and the imaginary part $y=\\frac{3}{2}.$ So, it corresponds to the point $(\\frac{1}{2},\\frac{3}{2})$, which lies in the first quadrant.\n\n![](images/d7/d7390ddcc8d338d2fd46bc12b0a4c65f8e6bf6e8c4f6c9fa802e2acea159416b.png)\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186348230 :knowledge-point/_questions [{:db/id #edb/ref 17592186147430 :knowledge-point/id #uuid "e17fe7fc-3b85-5f2c-aa69-2336b05b16b2" :knowledge-point/title "Identifying Solutions to Simple Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13447381-8721-54cc-93ad-ec3451ed8c7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345519} {:answer/id #uuid "548a412d-769e-5f37-b287-b5e8a2f3516b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186346069} {:answer/id #uuid "8312aa12-0acb-51e1-b48d-e1dd50ef851e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346492} {:answer/id #uuid "9c74b04c-077f-5abe-93e4-5b311d8196e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346714} {:answer/id #uuid "e110475f-605d-52d6-9b4e-ec752d3c2333" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347329}] :answer-field/correct {:answer/id #uuid "548a412d-769e-5f37-b287-b5e8a2f3516b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186346069} :answer-field/id #uuid "ea32768f-9a8b-5730-aa6f-faea2f793e5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348014}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "38fdf4c6-f5f9-5439-b136-b509926fb43c" :question/math-academy-id "q-79487" :question/problem "A particle is moving with simple harmonic motion. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+2y=0.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(\\sqrt{2}t+{ϕ}_{1})$\n- $y=R\\operatorname{sin}⁡(2t+{ϕ}_{2})$\n- $y=A\\operatorname{cos}⁡\\sqrt{2}t+B\\operatorname{sin}⁡\\sqrt{2}t$\n\nNote that $R,{ϕ}_{1},{ϕ}_{2},A$ and $B$ are constants." :question/worked-solution "The SHM equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nThe general solution to the SHM equation can be written in three different forms:\n\n- $y=R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=2\\,⟹\\,\\omega =\\sqrt{2}.\n$$\n\nThus, we have:\n\n- $y=R\\operatorname{cos}⁡(\\sqrt{2}t+{ϕ}_{1})$\n\n- $y=R\\operatorname{sin}⁡(\\sqrt{2}t+{ϕ}_{2})$\n\n- $y=A\\operatorname{cos}⁡\\sqrt{2}t+B\\operatorname{sin}⁡\\sqrt{2}t$\n\nTherefore, only functions I and III could be used to represent $y(t).$"}] [{:db/id #edb/ref 17592186348239 :knowledge-point/_questions [{:db/id #edb/ref 17592186119848 :knowledge-point/id #uuid "1d847ec9-c379-5013-ab77-a9b92dc8ca27" :knowledge-point/title "Identifying the Matrix With a Given Rank by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fcc3707-5257-56f7-a94a-c16be3c655ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186345482} {:answer/id #uuid "1488839f-b78a-5c71-b12c-fd396aefb4d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186345526} {:answer/id #uuid "79f9061d-b91e-5d06-8205-d8cf49d7a89e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186346419} {:answer/id #uuid "e4865247-2fc7-50f5-8dc6-90b9921dd7ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186347365} {:answer/id #uuid "ebc7ff50-8edf-53da-a902-6aa67ba79a1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186347430}] :answer-field/correct {:answer/id #uuid "1488839f-b78a-5c71-b12c-fd396aefb4d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186345526} :answer-field/id #uuid "cee01bee-957b-5375-bc24-a42dae9c7573" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7de7e9fe-a671-5464-bba9-92a57599131b" :question/math-academy-id "q-79568" :question/problem "Which of the following matrices have a rank of $5?$\n\n$$\nA=[\\begin{aligned}-1 & 1 & 0 & 4 & 0 \\\\ 0 & 2 & 1 & -3 & 1 \\\\ 0 & 0 & 2 & 0 & -2\\end{aligned}],\\,B=[\\begin{aligned}2 & -1 & 3 & 0 & 1 \\\\ 0 & 1 & 0 & 1 & 0 \\\\ 0 & 0 & -2 & 1 & 0 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 2 & 0 \\\\ 0 & 3 & 2 & -1 \\\\ 0 & 0 & 3 & 4 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "First, notice that a matrix of rank $5$ must have at least $5$ columns and at least $5$ rows. \nSo, we disregard the matrix $A$ since it has only $3$ rows and the matrix $C$ since it has only $4$ columns. \n\nAlso, the matrix must have $5$ pivot columns. As we can see, the matrix $B$ has exactly $5$ pivot columns. So, $\\text{rank}(B)=5.$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186348241 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02dd969f-3835-50e2-8bfc-d425532d61e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345375} {:answer/id #uuid "90284f75-7093-5853-a1bf-dfd348956afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186346606} {:answer/id #uuid "a6006a37-315c-535b-84c5-4aae73a3316f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346800} {:answer/id #uuid "c7e5dd56-c7d7-5b38-9d36-b6ef7d0b527a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347087} {:answer/id #uuid "f4150680-d532-528d-904e-713e4f2b8907" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347513}] :answer-field/correct {:answer/id #uuid "c7e5dd56-c7d7-5b38-9d36-b6ef7d0b527a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347087} :answer-field/id #uuid "43f9a281-44ca-5645-8aea-5eda107eeda2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "41288342-236a-5f59-a0ab-b7381746dd7e" :question/math-academy-id "q-79575" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+4{y}^{′}+20y=40\\operatorname{cos}⁡2t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\nI. $y={e}^{-2t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t)+10\\operatorname{cos}⁡2t$\n\nII. $y=R{e}^{-4t}\\operatorname{cos}⁡(t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t$\n\nIII. $y=R{e}^{-2t}\\operatorname{sin}⁡(4t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+4{y}^{′}+20y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +20 & =0 \\\\ ({\\lambda }^{2}+4\\lambda +4)-4+20 & =0 \\\\ (\\lambda +2)^{2}+16 & =0 \\\\ (\\lambda +2)^{2} & =-16 \\\\ \\lambda +2 & =\\pm 4\\text{i} \\\\ \\lambda  & =-2\\pm 4\\text{i}.\\end{aligned}\n$$\n\nTherefore the complimentary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-2t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t), \\\\ {y}_{c}(t) & =R{e}^{-2t}\\operatorname{cos}⁡(4t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-2t}\\operatorname{sin}⁡(4t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡2t+\\beta \\operatorname{sin}⁡2t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =2$ and $\\beta =1.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-2t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t, \\\\ y(t) & =R{e}^{-2t}\\operatorname{cos}⁡(4t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t, \\\\ y(t) & =R{e}^{-2t}\\operatorname{sin}⁡(4t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nOnly III matches the forms above. Therefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186348242 :knowledge-point/_questions [{:db/id #edb/ref 17592186147592 :knowledge-point/id #uuid "fc7eacaa-2cf2-5cae-a40c-737c98124bcf" :knowledge-point/title "Determining the Degree of a Homogeneous Polynomial Using the Fast Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045d95b9-c578-58ae-804d-b1f18050dded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345387} {:answer/id #uuid "1c552b52-c446-5ba7-b15e-630f222699c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345597} {:answer/id #uuid "4e3e8db4-c9a7-54bf-bb89-13376400df6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346020} {:answer/id #uuid "9c4634b0-4c75-5c24-a60d-26d06a0b1dbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346710} {:answer/id #uuid "d32e21c2-215e-513f-b844-3f5720b2a2a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347199}] :answer-field/correct {:answer/id #uuid "d32e21c2-215e-513f-b844-3f5720b2a2a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347199} :answer-field/id #uuid "420c198c-b60f-5531-84a3-03e2cd3be765" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1d20ac9-bf7d-58e9-8fa7-b423eaa3f414" :question/math-academy-id "q-79578" :question/problem "Which of the following polynomials are homogeneous?\n\n- $f(x)=3xy$\n- $g(x,y)={y}^{2}+3{x}^{2}y$\n- $h(x,y)={x}^{3}-4x{y}^{2}+3{y}^{3}$" :question/worked-solution "Let's go through each of the options.\n\n- The function $f(x)$ is homogeneous of degree $2.$  It is a polynomial of degree $2,$ with no linear or constant terms.\n\n- The function $g(x,y)$ is not homogeneous. It is a polynomial of degree $3.$ However, it also contains a term $({y}^{2})$ that is of degree $2.$ Therefore, not all of its terms are of degree $3.$\n\n- The function $g(x,y)$ is homogeneous of degree $3.$ It is a polynomial of degree $3,$ and all of its terms are of degree $3.$"}] [{:db/id #edb/ref 17592186348244 :knowledge-point/_questions [{:db/id #edb/ref 17592186147450 :knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927" :knowledge-point/title "Identifying Solutions to Forced Harmonic Motion Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a7e4d86-e681-55dc-851f-626c243db8a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345989} {:answer/id #uuid "4c0f622d-c941-546a-ad1f-8acfacf65b39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346006} {:answer/id #uuid "ae6f9093-a9f2-5e62-b0ac-2ba309a44af7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346873} {:answer/id #uuid "edc2ccf5-8acb-5ce7-851c-d8e35173456f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347450} {:answer/id #uuid "fe8725d2-f3d6-5d3b-b62d-26c66f72440d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347587}] :answer-field/correct {:answer/id #uuid "4a7e4d86-e681-55dc-851f-626c243db8a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345989} :answer-field/id #uuid "9becafd4-a5f8-56dc-8174-c3f2dd0c9c7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b57b422d-c4f7-5a90-ae50-c581e716c943" :question/math-academy-id "q-79586" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+4y=2.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(2t+ϕ)+2$\n- $y=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{1}{2}$\n- $y={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+\\frac{1}{2}$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$\nIt can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=4\\,⟹\\,\\omega =2.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(2t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(2+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a constant, we assume that the particular solution is also a constant,\n\n$$\n{y}_{p}(t)=\\alpha .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =\\frac{1}{2}.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{1}{2}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{1}{2}$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{1}{2}$\n\n- ${y}_{c}=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t+\\frac{1}{2}$\n\nOnly II match the forms above. Therefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186348278 :knowledge-point/_questions [{:db/id #edb/ref 17592186152192 :knowledge-point/id #uuid "42bc95a3-4e0c-5487-8427-31cee0ecf80b" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Sum Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0923514d-c5f5-5824-9559-5b62433d29c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345422} {:answer/id #uuid "236eae5a-9ad6-5197-8d56-b3601675b294" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345673} {:answer/id #uuid "71bf93d7-35da-5bf1-b1c4-67d62905acf2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346357} {:answer/id #uuid "ad47b4a5-f932-52e5-a826-24224069a452" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346863} {:answer/id #uuid "ae59bf38-16be-58c7-bd1c-828957c06a49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186346872}] :answer-field/correct {:answer/id #uuid "0923514d-c5f5-5824-9559-5b62433d29c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345422} :answer-field/id #uuid "e9b8d684-4b0c-5a9a-8ebf-813cbe7bf7a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3fe9a401-2c33-5db4-91d8-f65cf3a85456" :question/math-academy-id "q-79770" :question/problem "Given that ${y}_{1}(x)={e}^{-2x}$ and ${y}_{2}(x)={e}^{3x}$ are solutions to the equation ${y}^{″}-{y}^{′}-6y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n\n- $y(x)=\\frac{{e}^{-2x}}{{e}^{3x}}$\n- $y(x)={e}^{-2x}+{e}^{3x}$\n- $y(x)={e}^{-2x}\\cdot {e}^{3x}$" :question/worked-solution "According to the superposition principle, if the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are solutions to a homogeneous, linear differential equation, then $y(x)={y}_{1}(x)+{y}_{2}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=\\frac{{e}^{-2x}}{{e}^{3x}}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the quotients of the known solutions.\n\n- The function $y(x)={e}^{-2x}+{e}^{3x}$ is a solution of the equation by the superposition principle.\n\n- The function $y(x)={e}^{-2x}\\cdot {e}^{3x}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the products of the known solutions.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186348279 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7622f2e1-4bc7-5052-8059-cb0739d3adba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186346389} {:answer/id #uuid "8d2f1294-18fe-5249-8216-d3b2478a7f61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186346580} {:answer/id #uuid "b47aa73a-cb38-5bf6-a296-c1eae1ea691a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346924} {:answer/id #uuid "e718ee24-6201-580b-b3d7-2418fe4bb5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186347387} {:answer/id #uuid "ebd7344b-824c-54d9-95ae-9528861755ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347431}] :answer-field/correct {:answer/id #uuid "ebd7344b-824c-54d9-95ae-9528861755ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186347431} :answer-field/id #uuid "b93f0d66-ae9b-56db-8736-14ac1a058bd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc8e08c0-d0ce-557c-9060-08f946a61e52" :question/math-academy-id "q-79774" :question/problem "Given that ${y}_{1}(x)={e}^{4x}$ is a solution to the equation ${y}^{″}-2{y}^{′}-8y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n\n- $y(x)=4x{e}^{4x}$\n- $y(x)=2{e}^{4x}$\n- $y(x)=\\frac{{e}^{4x}}{x}$" :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=4x{e}^{4x}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\n- The function $y(x)=2{e}^{4x}$ is a solution of the equation by the superposition principle. In this case, $c=2.$\n\n- The function $y(x)=\\frac{{e}^{4x}}{x}$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186348280 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d51c4b-d54b-5abd-a602-97d128497895" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186345716} {:answer/id #uuid "2e42bc59-7be3-5fab-8e80-0f3c996bd387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345762} {:answer/id #uuid "5743a26a-1810-52e2-8511-82d7ec3b2ccd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/