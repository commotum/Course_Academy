873c-dfa0f8ceb3b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474573} :answer-field/id #uuid "d8fda271-0a88-58b9-887c-77bd606c8a3b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475212}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0af36684-2b78-59f1-bddf-9a1297846d8d" :question/math-academy-id "q-183358" :question/problem "Consider the following predicates.\n\n$\\,$ $A(x):$ $x\\in Z∖{N}_{0}.$ $\\,$ $B(x):$ $x\\in {Z}^{-}.$ \n\nWhich of the following is equivalent to the biconditional predicate $A(x)⇔B(x)?$\n\nI. $x\\in Z∖{N}_{0}$ if and only if $x\\in {Z}^{-}.$\n\nII. If $x\\in Z∖{N}_{0}$ then $x\\in {Z}^{-},$ or if $x\\in {Z}^{-}$ then $x\\in Z∖{N}_{0}.$\n\nIII. $x\\in Z∖{N}_{0}$ is equivalent to  $x\\in {Z}^{-}.$\n\nSelect all that apply." :question/worked-solution "A biconditional expression $P⇔Q≡(P⇒Q)∧(Q⇒P)$ can be read as shown below:\n\n- $P$ if and only if $Q$\n\n- $P$ is equivalent to $Q$\n\n- If $P$ then $Q,$ and if $Q$ then $P$\n\nSo, $A⇔B$ translates into the following sentences:\n\n- $x\\in Z∖{N}_{0}$ if and only if $x\\in {Z}^{-}.$\n\n- $x\\in Z∖{N}_{0}$ is equivalent to  $x\\in {Z}^{-}.$\n\n- If $x\\in Z∖{N}_{0}$ then $x\\in {Z}^{-},$ and if $x\\in {Z}^{-}$ then $x\\in Z∖{N}_{0}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186432579 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9434ee35-97a1-5285-97bd-642508f58883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474768} {:answer/id #uuid "2e62f471-e501-527c-a2bf-b58c36ed0de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474769}] :answer-field/correct {:answer/id #uuid "2e62f471-e501-527c-a2bf-b58c36ed0de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474769} :answer-field/id #uuid "f52c9065-8b6f-5163-be58-9a1c7fadbe10" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475310} {:answer-field/choices [{:answer/id #uuid "ee5d6baf-53f3-5f60-82f6-8b26db329f95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474770} {:answer/id #uuid "87258704-04de-53fe-86be-3991a51c9d68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474771}] :answer-field/correct {:answer/id #uuid "87258704-04de-53fe-86be-3991a51c9d68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474771} :answer-field/id #uuid "4f5919f8-4a8b-57fc-ba5e-3d0f046a50c8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475311} {:answer-field/choices [{:answer/id #uuid "7a4f9e18-0783-5aa4-ba7f-a403d553756b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474772} {:answer/id #uuid "b9af53cc-7fb3-530b-a444-9b33c32f55d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474773}] :answer-field/correct {:answer/id #uuid "b9af53cc-7fb3-530b-a444-9b33c32f55d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474773} :answer-field/id #uuid "da939024-b939-5a26-a4f7-b9817e50d965" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475312}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "248767b0-4e8f-59a2-a18a-6d7a3f7d1129" :question/math-academy-id "q-334262" :question/problem "$$\n4{x}^{2}{y}^{″}+6x{y}^{′}-2y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nI. ${y}_{1}(x)=\\frac{1}{x}$ is a solution to the equation for $x>0.$\n\nII. ${y}_{2}(x)=\\sqrt{x}$ is a solution to the equation for $x>0.$\n\nIII. The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x).$ Notice that $\\frac{1}{x}={x}^{-1},$ so we have:\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-\\frac{1}{{x}^{2}} \\\\ {y}_{1}^{″}(x) & =\\frac{2}{{x}^{3}}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{x}^{2}(\\frac{2}{{x}^{3}})+6x(-\\frac{1}{{x}^{2}})-2(\\frac{1}{x}) & =0 \\\\ (\\frac{8}{x}-\\frac{6}{x}-\\frac{2}{x}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x).$ Notice that $\\sqrt{x}={x}^{\\frac{1}{2}},$ so we have:\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {y}_{2}^{″}(x) & =-\\frac{1}{4}{x}^{-3/2}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{x}^{2}(-\\frac{1}{4}{x}^{-3/2})+6x(\\frac{1}{2}{x}^{-1/2})-2\\sqrt{x} & =0 \\\\ (-{x}^{1/2}+3{x}^{1/2}-2{x}^{1/2}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is true. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{-1} & {x}^{1/2} \\\\ -{x}^{-2} & \\frac{1}{2}{x}^{-1/2}\\end{aligned}| \\\\  & ={x}^{-1}\\cdot \\frac{1}{2}{x}^{-1/2}-{x}^{1/2}\\cdot (-{x}^{-2}) \\\\  & =\\frac{1}{2}{x}^{-3/2}+{x}^{-3/2} \\\\  & =\\frac{3}{2}{x}^{-3/2}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0,\\infty ),$ the functions are linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186432580 :knowledge-point/_questions [{:db/id #edb/ref 17592186152280 :knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bacd32ae-566a-595f-ae61-c7390064179f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474762} {:answer/id #uuid "af9b7df9-824a-5976-8ef0-0ed97e33de24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474763}] :answer-field/correct {:answer/id #uuid "bacd32ae-566a-595f-ae61-c7390064179f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474762} :answer-field/id #uuid "8b52e612-ea71-5a2e-a81c-18901ac0011f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475307} {:answer-field/choices [{:answer/id #uuid "b9146691-1ccc-57f9-88b9-54805a3f76b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474764} {:answer/id #uuid "5bb64cb4-e2ff-50e2-a176-9905722d9d9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474765}] :answer-field/correct {:answer/id #uuid "5bb64cb4-e2ff-50e2-a176-9905722d9d9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474765} :answer-field/id #uuid "e7f934a8-f5e6-5690-a1d4-2746d5ccf5fa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475308} {:answer-field/choices [{:answer/id #uuid "c25a7c82-ba97-5324-83d9-8843be6f251d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474766} {:answer/id #uuid "97e7e003-0f8d-59ae-a1f3-79ac064de7a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474767}] :answer-field/correct {:answer/id #uuid "c25a7c82-ba97-5324-83d9-8843be6f251d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474766} :answer-field/id #uuid "9fb9f336-1bf0-5e57-b4b7-e8e56b5843aa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475309}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8005871f-5013-58a1-b9ee-7ef831d491ac" :question/math-academy-id "q-334257" :question/problem "$$\n{x}^{2}{y}^{″}+2x{y}^{′}-12y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\nI. ${y}_{1}(x)=\\frac{1}{{x}^{3}}$ is a solution to the equation.\n\nII. ${y}_{2}(x)={x}^{3}$ is a solution to the equation.\n\nIII. The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation.\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-\\frac{3}{{x}^{4}} \\\\ {y}_{1}^{″}(x) & =\\frac{12}{{x}^{5}}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(\\frac{12}{{x}^{5}})+2x(-\\frac{3}{{x}^{4}})-12(\\frac{1}{{x}^{3}}) & =0 \\\\ -\\frac{6}{{x}^{3}} & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{x}^{2} \\\\ {y}_{2}^{″}(x) & =6x\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(6x)+2x(3{x}^{2})-12({x}^{3}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186432686 :knowledge-point/_questions [{:db/id #edb/ref 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3ee888-ad53-54fd-b343-fe6d7467993b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474236} {:answer/id #uuid "13309c56-de8d-541c-a9b9-d64bacc69c2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474237}] :answer-field/correct {:answer/id #uuid "13309c56-de8d-541c-a9b9-d64bacc69c2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474237} :answer-field/id #uuid "55357c0e-8442-539c-a2ac-0b8d9168a5e9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475044} {:answer-field/choices [{:answer/id #uuid "46b17db1-3dae-59e5-90f2-f8086dd367db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474238} {:answer/id #uuid "87817e80-cdc4-5f99-b785-8dc24554f274" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474239}] :answer-field/correct {:answer/id #uuid "87817e80-cdc4-5f99-b785-8dc24554f274" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474239} :answer-field/id #uuid "0c4b8c22-2a7d-5614-bb76-1bdd501394ac" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475045} {:answer-field/choices [{:answer/id #uuid "946ef7c6-6523-56ec-ba6b-6b5367226abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474240} {:answer/id #uuid "38796f5a-37c3-5e26-8904-8a488026bd3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474241}] :answer-field/correct {:answer/id #uuid "946ef7c6-6523-56ec-ba6b-6b5367226abd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474240} :answer-field/id #uuid "c1e1408d-a412-5bd8-99d6-c8b390cde190" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475046}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0d9f5142-140d-5b22-b957-299741979b12" :question/math-academy-id "q-107888" :question/problem "Which of the following integrals are equivalent to $Γ(z)$ for $\\text{Re}(z)>0?$\n\nI. ${\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$\n\nII. ${\\int }_{0}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}\\,\\text{d}t$\n\nIII. ${\\int }_{1}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t$\n\nSelect all that apply." :question/worked-solution "First, let's recall the definition of the gamma function:\n\n$$\nΓ(z)={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t,\\,\\text{Re}(z)>0.\n$$\n\nWith this definition in mind, let's consider each of the given integrals.\n\n- Integral I matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\n- Integral II matches the definition:\n\n$$\n{\\int }_{0}^{\\infty }\\frac{{t}^{z-1}}{{e}^{t}}={\\int }_{0}^{\\infty }{t}^{z-1}{e}^{-t}\\,\\text{d}t=Γ(z)\n$$\n\n- Integral III does *not* match the definition. The lower bound of integration does not match that given in the definition.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186432688 :knowledge-point/_questions [{:db/id #edb/ref 17592186172066 :knowledge-point/id #uuid "7e75041c-d0be-5db2-a0db-7c2c2b57b44e" :knowledge-point/title "Defining the Gamma Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a04469a3-7f07-5d95-b3ed-53d23583c001" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text