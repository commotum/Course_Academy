/id #uuid "e50b94ef-8b70-56f2-a2da-c456b23eb5bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474749} :answer-field/id #uuid "d9f52a68-17c6-56ae-9df0-1ffe6b9d370b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d92850b-bd66-52a9-a628-fb23ae6c0162" :question/math-academy-id "q-223458" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $276$\n\nII. $647$\n\nIII. $805$\n\nSelect all that apply." :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $276,$ we have that \n\n$$\n27-2(6)=27-12=15\n$$\n\nwhich is not divisible by $7.$ Therefore, $276$ is not divisible by $7.$\n\n- For the number $647,$ we have that \n\n$$\n64-2(7)=64-14=50\n$$\n\nwhich is not divisible by $7.$ Therefore, $647$ is not divisible by $7.$\n\n- For the number $805,$ we have that \n\n$$\n80-2(5)=80-10=70\n$$\n\nwhich is divisible by $7.$ Therefore, $805$ is divisible by $7.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186432785 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b3a1c18-402a-5826-bf79-0dba558c64fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474332} {:answer/id #uuid "6c88f31b-1b8f-5242-b277-9bc33fcc1d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474333}] :answer-field/correct {:answer/id #uuid "6c88f31b-1b8f-5242-b277-9bc33fcc1d53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474333} :answer-field/id #uuid "bc5edc77-177d-5283-b4ed-f6d29e6130f3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475092} {:answer-field/choices [{:answer/id #uuid "3717d0fa-e38b-5a2c-bc8b-96a33d55cf5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474334} {:answer/id #uuid "a0899615-a369-5445-bb33-8c945624b783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474335}] :answer-field/correct {:answer/id #uuid "a0899615-a369-5445-bb33-8c945624b783" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474335} :answer-field/id #uuid "c5341e31-a447-5b11-b208-298c154fcdea" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475093} {:answer-field/choices [{:answer/id #uuid "16a85a5c-42ba-5e88-a569-6fb4ddc389eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474336} {:answer/id #uuid "14c3560a-8a2d-5432-9a2c-f7b3ac672b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474337}] :answer-field/correct {:answer/id #uuid "14c3560a-8a2d-5432-9a2c-f7b3ac672b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474337} :answer-field/id #uuid "5d54dde0-4790-50de-af67-f644fa4e8182" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475094}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "245a9f1f-3fc0-594c-a273-205b94f4bf02" :question/math-academy-id "q-132405" :question/problem "Which of the following numbers are divisible by $6?$\n\nI. $185\\,346$\n\nII. $2\\,525\\,934$\n\nIII. $15\\,070\\,962$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$\n\n- The number $185\\,346$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+8+5+3+4+6=27\n$$\n\nSo, $185\\,346$ is divisible by $6.$\n\n- The number $2\\,525\\,934$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n2+5+2+5+9+3+4=30\n$$\n\nSo, $2\\,525\\,934$ is divisible by $6.$\n\n- The number $15\\,070\\,962$ is divisible by $2,$ and it is also divisible by $3$ since the sum of its digits is divisible by $3:$\n\n$$\n1+5+0+7+0+9+6+2=30\n$$\n\nSo, $15\\,070\\,962$ is divisible by $6.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186432786 :knowledge-point/_questions [{:db/id #edb/ref 17592186171933 :knowledge-point/id #uuid "b483f9f7-47a9-5725-b1f1-fe0ea39a7e96" :knowledge-point/title "Determining if a Number Is Divisible by 6"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254557ba-2300-5e8d-8010-4da154a091bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474936} {:answer/id #uuid "b4509af3-bd91-52d8-b845-f39459c6431f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474937}] :answer-field/correct {:answer/id #uuid "254557ba-2300-5e8d-8010-4da154a091bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474936} :answer-field/id #uuid "d5117c5c-0b3d-5681-bea7-e78fbc4dca15" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475394} {:answer-field/choices [{:answer/id #uuid "83c7fcc6-4aae-5e12-9f31-217eee9a9e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474938} {:answer/id #uuid "39be27d3-b564-5d60-a415-cb4613704a4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474939}] :answer-field/correct {:answer/id #uuid "83c7fcc6-4aae-5e12-9f31-217eee9a9e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474938} :answer-field/id #uuid "365355c9-80e8-5ceb-8ced-6abde93e33a3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475395} {:answer-field/choices [{:answer/id #uuid "5f8dfb07-e992-527e-a945-24da6f634257" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474940} {:answer/id #uuid "9c102a97-56e2-599a-84df-d20a3f9f5a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474941}] :answer-field/correct {:answer/id #uuid "9c102a97-56e2-599a-84df-d20a3f9f5a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474941} :answer-field/id #uuid "e609c677-e2a8-5cda-9764-1405b6e85e62" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186475396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66ca27c6-8cac-5ac3-b80e-6fd1dcb7b6a5" :question/math-academy-id "q-85424" :question/problem "Which digits, when inserted into the blank, make the number $591\\,030\\,47◻$ divisible by $6?$\n\nI. $2$\n\nII. $5$\n\nIII. $4$\n\nSelect all that apply." :question/worked-solution "A number is divisible by $6$ if it is divisible by both $2$ and $3.$ Remember that to determine whether a number is divisible by $3,$ we check whether the sum of the digits is divisible by $3.$\n\nFor the given number, the sum of the digits is\n\n$$\n5+9+1+0+3+0+4+7+◻=29+◻.\n$$\n\nNow, let's consider each of the given digits we can substitute into the blank.\n\n- If we substitute $2$ into the blank, we get $591\\,030\\,472,$ which is divisible by $2.$ However, it is not divisible by $3$ because the sum of the digits is $29+2=31,$ which is not divisible by $3.$ So, the number is *not* divisible by $6$ either.\n\n- If we substitute $5$ into the blank, we get $591\\,030\\,475,$ which is not divisible by $2,$ so it is not divisible by $6$ either.\n\n- If we substitute $4$ into the blank, we get $591\\,030\\,474,$ which is divisible by $2.$ The sum of the digits is $29+4=33,$ so the number is also divisible by $3.$ Therefore, the number is divisible by $6.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186432787 :knowledge-point/_questions [{:db/id #edb/ref 17592186171934 :knowledge-point/id #uuid "cb0ae539-5348-5a2c-b226-c009ce6d6094" :knowledge-point/title "Determining if a Number Is Divisible by 7"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297df35f-e065-50a4-a888-680ae0d69b1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474732} {:answer/id #uuid "aa96fa2f-53e6-5a3c-a179-ee3fb5c6cfbf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474733}] :answer-field/correct {:answer/id #uuid "aa96fa2f-5