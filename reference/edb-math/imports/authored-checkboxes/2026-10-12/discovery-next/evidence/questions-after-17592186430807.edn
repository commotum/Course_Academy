{:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6daa78eb-7b75-5f11-9d14-72a95f4ad0c2" :question/math-academy-id "q-223454" :question/problem "Which of the following numbers are divisible by $7?$\n\nI. $434$\n\nII. $785$\n\nIII. $587$\n\nSelect all that apply." :question/worked-solution "To check if a number is divisible by $7,$ double the last digit, subtract the result from the remaining digits, and then check if the difference is divisible by $7.$\n\n- For the number $434,$ we have that \n\n$$\n43-2(4)=43-8=35\n$$\n\nwhich is divisible by $7.$ Therefore, $434$ is divisible by $7.$\n\n- For the number $785,$ we have that \n\n$$\n78-2(5)=78-10=68\n$$\n\nwhich is not divisible by $7.$ Therefore, $785$ is not divisible by $7.$\n\n- For the number $587,$ we have that \n\n$$\n58-2(7)=58-14=44\n$$\n\nwhich is not divisible by $7.$ Therefore, $587$ is not divisible by $7.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186432788 :knowledge-point/_questions [{:db/id #edb/ref 17592186171932 :knowledge-point/id #uuid "fb8fa39c-a982-569a-b2e0-833c51259711" :knowledge-point/title "Determining if a Number Is Divisible by 3 or 9"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1351f483-9f6f-5ca4-b59a-96f2a4ac3b38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474924} {:answer/id #uuid "c8c6b0c8-d254-5938-9bfa-fe702324cad1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186474925}] :answer-field/correct {:answer/id #uuid "1351f483-9f6f-5ca4-b59a-96f2a4ac3b38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186474924} :answer-field/id #uuid "71daca45-fa65-5f59-84d9-6e9b687f8102" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/check