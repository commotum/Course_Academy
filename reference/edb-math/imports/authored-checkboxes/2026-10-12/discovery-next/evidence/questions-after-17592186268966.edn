answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464288} {:answer/id #uuid "b46bc96b-ac7e-5f3f-a9a5-4cdfc8aba11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464289}] :answer-field/correct {:answer/id #uuid "b46bc96b-ac7e-5f3f-a9a5-4cdfc8aba11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464289} :answer-field/id #uuid "ca347041-dadc-56e2-bbf1-f6ebc4c70e09" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465078} {:answer-field/choices [{:answer/id #uuid "3e699ac2-764b-512c-8f0d-5172d00686da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464290} {:answer/id #uuid "006bf10f-88fe-5637-949f-4aa29407bc3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464291}] :answer-field/correct {:answer/id #uuid "3e699ac2-764b-512c-8f0d-5172d00686da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464290} :answer-field/id #uuid "83f7c971-351f-53ff-be7e-c7304f5c86bf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465079} {:answer-field/choices [{:answer/id #uuid "17db8ae0-64d6-5514-9124-5fa3d5e8dba6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464292} {:answer/id #uuid "b1a98f0c-64a9-57fe-b332-0fefcb246690" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464293}] :answer-field/correct {:answer/id #uuid "17db8ae0-64d6-5514-9124-5fa3d5e8dba6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464292} :answer-field/id #uuid "da33b576-bcf0-5c09-83dd-58d6caaeb72b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465080}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "743eb09d-bf29-57ce-b05b-46da6dccd3f5" :question/math-academy-id "q-143338" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=2$ | $Y=4$ | $Y=6$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.16$ | $0.01$ | $0.03$ |\n| $X=3$ | $0.64$ | $0.09$ | $0.07$ |\n\nWhich of the following statements are true?\n- **I.** $P(X=3,Y=2)=P(X=3)\\cdot P(Y=2)$\n- **II.** $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- **III.** $X$ and $Y$ are independent\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=2$ | $Y=4$ | $Y=6$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $0.16$ | $0.01$ | $0.03$ | $0.2$ |\n| $X=3$ | $0.64$ | $0.09$ | $0.07$ | $0.8$ |\n| ${f}_{Y}$ | $0.8$ | $0.1$ | $0.1$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=3,Y=2)=f(3,2)=0.64.$ On the other hand, \n\n$$\nP(X=3)\\cdot P(Y=2)={f}_{X}(3)\\cdot {f}_{Y}(2)=0.8\\cdot 0.8=0.64.\\,✓\n$$\n\n- Statement II is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(1,2) & =0.16=0.2\\cdot 0.8={f}_{X}(1)\\cdot {f}_{Y}(2) & ✓ \\\\ f(1,4) & =0.01\\ne 0.2\\cdot 0.1={f}_{X}(1)\\cdot {f}_{Y}(4) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186275118 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2775cce0-304f-5113-963a-e28a11e24992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464294} {:answer/id #uuid "128d1ceb-39cf-5da3-8419-5a7d8a02044d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464295}] :answer-field/correct {:answer/id #uuid "2775cce0-304f-5113-963a-e28a11e24992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464294} :answer-field/id #uuid "1d189a29-6c25-5569-854b-c13fc0526360" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465081} {:answer-field/choices [{:answer/id #uuid "ad3a30bf-90ea-5614-8226-e124a25c10b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464296} {:answer/id #uuid "b3343df9-8a4a-5259-9ba0-3cd40ddbf9d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464297}] :answer-field/correct {:answer/id #uuid "ad3a30bf-90ea-5614-8226-e124a25c10b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464296} :answer-field/id #uuid "af0ced41-0208-507d-b83f-0b656205df0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465082} {:answer-field/choices [{:answer/id #uuid "cb8af9ea-b637-5ed4-b6ba-f9ad08c1f112" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464298} {:answer/id #uuid "3f0da6fb-3bb6-55a5-a319-72bfe95326c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464299}] :answer-field/correct {:answer/id #uuid "cb8af9ea-b637-5ed4-b6ba-f9ad08c1f112" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464298} :answer-field/id #uuid "ee63d585-1abb-575b-b286-f0fc73957802" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465083}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d571385e-cc3b-5950-8471-24ba60f93b53" :question/math-academy-id "q-143435" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.1$ | $0.6$ |\n| $X=1$ | $0.25$ | $0.05$ |\n\nWhich of the following statements are true?\n- **I.** $P(X=1,Y=1)=P(X=1)\\cdot P(Y=1)$\n- **II.** $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- **III.** $X$ and $Y$ are independent\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=0$ | $Y=1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.6$ | $0.7$ |\n| $X=1$ | $0.25$ | $0.05$ | $0.3$ |\n| ${f}_{Y}$ | $0.35$ | $0.65$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statements I and II are false. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.05.$ However, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.3\\cdot 0.65=0.195.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=1,Y=1)\\ne P(X=1)\\cdot P(Y=1),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of those listed.\""}] [{:db/id #edb/ref 17592186275134 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "691d2386-08e0-5e84-8528-ca09e15fee56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464300} {:answer/id #uuid "40fc8e5d-a7c6-5dee-ad15-ced14c3143c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464301}] :answer-field/correct {:answer/id #uuid "40fc8e5d-a7c6-5dee-ad15-ced14c3143c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464301} :answer-field/id #uuid "fe6f4042-36ad-5790-9b6a-ec08b4a4e1de" :answer-field/key "P" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465084} {:answer-field/choices [{:answer/id #uuid "a166b78e-fbfa-54cb-b123-2bd64adb1d28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464302} {:answer/id #uuid "aaf7898e-f1aa-583f-936b-db61e1a09fba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464303}] :answer-field/correct {:answer/id #uuid "aaf7898e-f1aa-583f-936b-db61e1a09fba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464303} :answer-field/id #uuid "3d8b8c80-ca14-520f-b6c2-4799187a9aeb" :answer-field/key "Q" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465085} {:answer-field/choices [{:answer/id #uuid "1d54f34b-efcc-5076-9803-a07b0f77a6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464304} {:answer/id #uuid "7bf8d2b6-60b1-5f51-852c-b6a4df097275" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464305}] :answer-field/correct {:answer/id #uuid "1d54f34b-efcc-5076-9803-a07b0f77a6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464304} :answer-field/id #uuid "671893c7-dec8-5832-a276-3876dd47a359" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465086}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2475e8ae-4517-52f5-bd41-fe3d91352945" :question/math-academy-id "q-143680" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}1 & 2 & 11 \\\\ 2 & -1 & -9 \\\\ 11 & -9 & 0\\end{aligned}],\\,Q=[\\begin{aligned}0 & 2 \\\\ 2 & -1\\end{aligned}],\\,R=[\\begin{aligned}7 & 3 \\\\ 4 & 7\\end{aligned}]\n$$\n\nSelect all that apply." :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=[\\begin{aligned}7 & 3 \\\\ 4 & 7\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""}] [{:db/id #edb/ref 17592186275141 :knowledge-point/_questions [{:db/id #edb/ref 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6b40e85-685d-5aab-a444-8d6308f092ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464306} {:answer/id #uuid "f496eb60-ea3c-5012-94d5-6a88a7ee132b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464307}] :answer-field/correct {:answer/id #uuid "f496eb60-ea3c-5012-94d5-6a88a7ee132b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464307} :answer-field/id #uuid "62d3db58-a8e1-53d5-9263-64aabffee523" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465087} {:answer-field/choices [{:answer/id #uuid "2ad996b1-ee92-58c1-945e-288e24a1684a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464308} {:answer/id #uuid "8f1b11cb-7840-58b1-9605-17c342ec821e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464309}] :answer-field/correct {:answer/id #uuid "8f1b11cb-7840-58b1-9605-17c342ec821e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464309} :answer-field/id #uuid "09e8be2c-6838-5976-a996-7c966f243d0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465088} {:answer-field/choices [{:answer/id #uuid "7c589b14-4ce2-5a9d-99dd-9f8e826f588a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464310} {:answer/id #uuid "f7b7057b-4aee-5f4a-8fde-1b87c3a33f06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464311}] :answer-field/correct {:answer/id #uuid "f7b7057b-4aee-5f4a-8fde-1b87c3a33f06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464311} :answer-field/id #uuid "2d636b7d-f826-57af-9dce-2dff4230118a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62d0b863-0ebd-5fe2-bf2e-b910931d25fb" :question/math-academy-id "q-143865" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.4$ | $0.3$ |\n| $X=1$ | $0.2$ | $0.1$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\nI. $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n\nII. ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n\nIII. $f(x,y)$ is a valid joint probability mass function\n\nSelect all that apply." :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.4+0.3+0.2+0.1=1\\,✓\\end{aligned}\n$$\n\n- Condition III is true. Because $f(x,y)$ satisfies conditions I and II, it is a valid probability mass function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186275142 :knowledge-point/_questions [{:db/id #edb/ref 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af749281-56f2-5884-a556-cb423dd42d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464312} {:answer/id #uuid "3864aedc-5b81-5741-9865-3d9d09d081c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464313}] :answer-field/correct {:answer/id #uuid "3864aedc-5b81-5741-9865-3d9d09d081c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464313} :answer-field/id #uuid "eadcd78a-db43-5db1-a20d-f87b56d7baa7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465090} {:answer-field/choices [{:answer/id #uuid "60587069-7f76-5224-928e-a8823a285b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464314} {:answer/id #uuid "1491a7f7-9d74-59a4-a1ea-ffea54c8e85e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :