ff653-5f79-56df-815d-652606c37fae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464215}] :answer-field/correct {:answer/id #uuid "26f9634b-041a-572d-8750-407c23f61424" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464214} :answer-field/id #uuid "52b0634f-8af8-5969-84d2-36ca3ab0045a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465041}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "496f9381-a057-5d31-a929-726bf731d70b" :question/math-academy-id "q-141495" :question/problem "Let $T:{R}^{3}\\to {R}^{3}$ be a linear transformation whose standard matrix is $T,$ and ${v}_{1},{v}_{2}\\in {R}^{3}.$  Consider the following statement:\n\n*If $2T({v}_{1})-3T({v}_{2})=0$ and ${v}_{1}\\ne k{v}_{2}$ for all $k\\in R$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Ker}(T)\\ne \\{0\\}$\n- **II.** $\\text{Im}(T)={R}^{3}$\n- **III.** $T$ is invertible\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{3}$ into ${R}^{3},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,\\{\\,\\begin{aligned} & \\text{Im}(T)={R}^{3} \\\\  & \\text{rank}(T)=3 \\\\  & \\text{Ker}(T)=\\{0\\} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $2T({v}_{1})-3T({v}_{2})=0$ and $T$ is a linear transformation, we have $T(2{v}_{1}-3{v}_{2})=0$ which means $2{v}_{1}-3{v}_{2}\\in \\text{Ker}(T).$   Since ${v}_{1}\\ne k{v}_{2}$,  we must have $\\text{Ker}(T)\\ne \\{0\\}.$\n\n- Statement II is false. Since $\\text{Ker}(T)\\ne \\{0\\}$, then according to the invertible matrix theorem, the transformation $T$ is not a bijection. Since $T$ is not a bijection, then by the invertible matrix theorem, $\\text{Im}(T)\\ne {R}^{3}.$\n\n- Statement III is false. According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{3},$ the corresponding matrix $T$ can't be invertible.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186272301 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "defa38e6-4b2a-547a-9785-5f2fca155634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464216} {:answer/id #uuid "8813679f-0971-5e77-ad51-40eb57c572d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464217}] :answer-field/correct {:answer/id #uuid "defa38e6-4b2a-547a-9785-5f2fca155634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464216} :answer-field/id #uuid "52c26432-913d-5735-b0ed-85a46e70c8e8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465042} {:answer-field/choices [{:answer/id #uuid "e92260a8-5b4e-5b4e-9416-0de5fe12aa8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464218} {:answer/id #uuid "dadfcb43-c958-54de-8830-025222c2a86f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464219}] :answer-field/correct {:answer/id #uuid "dadfcb43-c958-54de-8830-025222c2a86f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464219} :answer-field/id #uuid "7ed304dd-c00f-5c24-a7ac-a6a45f1bc15d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465043} {:answer-field/choices [{:answer/id #uuid "e24f08c0-cbc9-5eb8-b862-7b5254467338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464220} {:answer/id #uuid "2f5185ec-576f-5f3f-890e-3d67f76bcb32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464221}] :answer-field/correct {:answer/id #uuid "2f5185ec-576f-5f3f-890e-3d67f76bcb32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464221} :answer-field/id #uuid "fac72699-e49d-525e-92b7-897f36bc8dae" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465044}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c4507db3-2027-5030-88fd-955381171b17" :question/math-academy-id "q-141569" :question/problem "Let $T:{R}^{4}\\to {R}^{4}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If $\\text{nullity}(T)=4,$ then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Im}(T)={R}^{4}$\n- **II.** $T$ is not invertible\n- **III.** $\\text{rank}(T)\\ne 4$\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{4}$ into ${R}^{4},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{4} \\\\  & \\text{rank}(T)=4 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $\\text{nullity}(T)\\ne 0,$ the invertible matrix theorem implies that $\\text{Im}(T)\\ne {R}^{4}.$\n\n- Statement II is true. Indeed, since $\\text{nullity}(T)\\ne 0,$ the invertible matrix theorem implies that $T$ is not invertible.\n\n- Statement III is true. Indeed, since $T$ is not invertible, the invertible matrix theorem implies that $\\text{rank}(T)\\ne 4.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186272302 :knowledge-point/_questions [{:db/id #edb/ref 17592186124631 :knowledge-point/id #uuid "113a601e-220a-54a3-a64b-1e554bc3d79f" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32d41688-d441-5144-8654-a972f8be5b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464222} {:answer/id #uuid "8e89bfdc-e0ea-5cb6-9225-4a56ce59f56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464223}] :answer-field/correct {:answer/id #uuid "8e89bfdc-e0ea-5cb6-9225-4a56ce59f56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464223} :answer-field/id #uuid "72f72fce-9abb-5a6c-9689-b54025b14cfe" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465045} {:answer-field/choices [{:answer/id #uuid "7398f9ee-d9ed-555a-acc0-735e4fdaa78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464224} {:answer/id #uuid "73635a76-1329-52e8-bd4c-7b079d5a02a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464225}] :answer-field/correct {:answer/id #uuid "7398f9ee-d9ed-555a-acc0-735e4fdaa78b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464224} :answer-field/id #uuid "e5214e79-29e2-5009-b0e1-02450bcb5417" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465046} {:answer-field/choices [{:answer/id #uuid "9a9be739-fcf6-5a16-8afe-a003efb9a3a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464226} {:answer/id #uuid "786a548c-28ba-5e22-835f-02191b3b2922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464227}] :answer-field/correct {:answer/id #uuid "786a548c-28ba-5e22-835f-02191b3b2922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464227} :answer-field/id #uuid "53569532-51d7-56fd-b1b2-b9c1761560c6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465047}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2805dfb0-8d9a-5775-8051-a005b74b03a8" :question/math-academy-id "q-141584" :question/problem "Let $T:{R}^{6}\\to {R}^{6}$ be a linear transformation whose standard matrix is $T.$ Consider the following statement:\n\n*If ${v}_{1}\\ne {v}_{2}$ vectors such that $T({v}_{1})=T({v}_{2})$, then $\\text{__________}.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $\\text{Ker}(T)\\ne {0}$\n- **II.** $\\text{Im}(T)={R}^{6}$\n- **III.** $T$ is not a bijection\n\nSelect all that apply." :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$\n\nSince $T$ is a linear transformation, we have that\n\n$$\nT({v}_{1})=T({v}_{2})\\,⟹\\,T({v}_{1}-{v}_{2})=0.\n$$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${v}_{1}-{v}_{2}\\in \\text{Ker}(T)$ and ${v}_{1}\\ne {v}_{2},$ we must have that $\\text{Ker}(T)\\ne {0}.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{Ker}(T)\\ne {0},$ the transformation $T$ and the matrix $T$ are not invertible. Since $T$ is not invertible, by the invertible matrix theorem, we must have that $\\text{Im}(T)\\ne {R}^{6}.$\n\n- Statement III is true. Since $\\text{Im}(T)\\ne {R}^{6},$ the invertible matrix theorem implies that the transformation $T$ is not a bijection.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186272306 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8133feec-c704-54ec-9da4-63ffb304152e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464228} {:answer/id #uuid "e455dfe7-0766-57cd-81ed-207421b1fa25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464229}] :answer-field/correct {:answer/id #uuid "e455dfe7-0766-57cd-81ed-207421b1fa25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464229} :answer-field/id #uuid "fe79cc9d-abb4-57b4-887f-e23d9ef9879a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465048} {:answer-field/choices [{:answer/id #uuid "3608310a-4768-5980-8d43-ed9fb35eb631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464230} {:answer/id #uuid "20e8ee12-ecc7-5ada-beab-4d464d739fac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464231}] :answer-field/correct {:answer/id #uuid "3608310a-4768-5980-8d43-ed9fb35eb631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464230} :answer-field/id #uuid "ef4f8261-a1a4-5b70-b606-4ff859919d63" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465049} {:answer-field/choices [{:answer/id #uuid "589861bf-8943-5f3d-aca0-94e5aa2fcb95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464232} {:answer/id #uuid "35ca9268-0d2b-5e40-a0ad-3ad58a0c043e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464233}] :answer-field/correct {:answer/id #uuid "35ca9268-0d2b-5e40-a0ad-3ad58a0c043e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464233} :answer-field/id #uuid "1242e42f-6c60-532e-9b28-0bc88336c0cd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465050}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bb3b4f0-a153-5b1f-93aa-f136a6132e95" :question/math-academy-id "q-141751" :question/problem "![](images/9d/9d5ea7e13fa03ac553893aa78aa7ee32ac7b67f2eb19dff32228d53bf2010aa2.png)\n\nWhich of the curves above are concave down?\n\nSelect all that apply." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nOnly graphs I and III curve downward (like a \"frown\") among the given graphs."}] [{:db/id #edb/ref 17592186272307 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e345dfe3-6cec-5c47-9653-0c664922f95f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464234} {:answer/id #uuid "88876309-8b8f-5f37-af60-4ca60812f2f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464235}] :answer-field/correct {:answer/id #uuid "88876309-8b8f-5f37-af60-4ca60812f2f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464235} :answer-field/id #uuid "319909c1-87ae-5d91-80c4-c2160a9093b5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465051} {:answer-field/choices [{:answer/id #uuid "6281ebe2-8346-510d-bf3b-dab51d416baf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464236} {:answer/id #uuid "1ab3adf9-b781-529e-97e8-94908f1a31d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464237}] :answer-field/correct {:answer/id #uuid "1ab3adf9-b781-529e-97e8-94908f1a31d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464237} :answer-field/id #uuid "d0948962-4018-593d-8a3d-ae82cd0f15a7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465052} {:answer-field/choices [{:answer/id #uuid "58dcdf48-539e-53e8-89e6-9e92d72ba9b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464238} {:answer/id #uuid "4cde85d8-e509-5dd7-b34c-2e034aa48927" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464239}] :answer-field/correct {:answer/id #uuid "4cde85d8-e509-5dd7-b34c-2e034aa48927" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464239} :answer-field/id #uuid "49dd128b-869d-585a-ae96-a530398e14e5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465053}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13227862-4183-5d5b-b484-99ef3e29fd6b" :question/math-academy-id "q-141754" :question/problem "![](images/b2/b2b904027ec6319fe5857f81089469568322d148e49cdf31bb20c07f1f31daf4.png)\n\nWhich of the curves above are concave down?\n\nSelect all that apply." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nAll graphs I, II, and III curve downward (like a \"frown\") among the given graphs."}] [{:db/id #edb/ref 17592186272338 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f8d9af-560e-5e04-801f-49c3569ea09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464240} {:answer/id #uuid "3683cdbb-cea0-5d3a-88ae-46bbf35523a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464241}] :answer-field/correct {:answer/id #uuid "07f8d9af-560e-5e04-801f-49c3569ea09a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464240} :answer-field/id #uuid "7d8b8cb5-e75e-518a-91a0-160dae2c2bc4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465054} {:answer-field/choices [{:answer/id #uuid "7bba33a3-e841-5573-8abf-90651ed20a6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464242} {:answer/id #uuid "0c34db9f-4df3-5319-9c26-896a5b27e435" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464243}] :answer-field/correct {:answer/id #uuid "7bba33a3-e841-5573-8abf-90651ed20a6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464242} :answer-field/id #uuid "05d917c1-327f-5ee0-8aed-ef99e81a107b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465055} {:answer-field/choices [{:answer/id #uuid "de2f17c6-86e7-560e-b3af-0ab0f7aab9fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464244} {:answer/id #uuid "06de2a3a-d315-52ff-898b-03d434ea28ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464245}] :answer-field/correct {:answer/id #uuid "06de2a3a-d315-52ff-898b-03d434ea28ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464245} :answer-field/id #uuid "4bcd47e5-e550-5069-9017-2362f6f7a623" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c320bbb-0961-56b0-99e4-beaa75aa8f10" :question/math-academy-id "q-142358" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)={[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ 0 \\\\ 2{x}_{2} \\\\ {x}_{1}\\end{aligned}]\\,|\\,{x}_{1},{x}_{2}\\in R}?\n$$\n- **I.** $\\text{dim(Null}(A))=0$\n- **II.** $A$ is  invertible\n- **III.** $\\text{Col}(A)\\ne {R}^{5}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since \n\n$$\n\\text{Null}(A)={{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 2 \\\\ 0\\end{aligned}]\\,|\\,{x}_{1},{x}_{2}\\in R}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=2\\ne 0.\n$$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{5}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186272348 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d248bbb6-50b4-5d61-a95e-58f318131503" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464246} {:answer/id #uuid "7e5d0dfe-318f-5100-ac82-83455377b98c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464247}] :answer-field/correct {:answer/id #uuid "7e5d0dfe-318f-5100-ac82-83455377b98c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464247} :answer-field/id #uuid "2d37791a-a285-5a2f-af41-bcd2d8afc075" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465057} {:answer-field/choices [{:answer/id #uuid "3957e353-c39b-5011-af11-d2c9b6787af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464248} {:answer/id #uuid "8a540690-cbd6-5a7b-8e6a-735ce1ef7a6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464249}] :answer-field/correct {:answer/id #uuid "3957e353-c39b-5011-af11-d2c9b6787af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464248} :answer-field/id #uuid "8cfe4de2-b1c4-55bb-a60d-27c7be7257dc" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465058} {:answer-field/choices [{:answer/id #uuid "4f6788d6-5506-57b7-9972-0d793d0b67f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464250} {:answer/id #uuid "67197e1a-6b46-5a73-9b9e-21d0f7711026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464251}] :answer-field/correct {:answer/id #uuid "67197e1a-6b46-5a73-9b9e-21d0f7711026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464251} :answer-field/id #uuid "41d8c4a3-f095-50cd-bcf7-92ff6b429b75" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465059}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "795129ab-7204-5692-a97c-e32525213e2a" :question/math-academy-id "q-142475" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then  $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n- **I.** $A$ is invertible\n- **II.** $\\text{rank}(A)<n$\n- **III.** $\\text{Col}(A)={R}^{n}$\n\nSelect all that apply." :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is invertible.* $\\,✓$ \n\nIndeed, according to the invertible matrix theorem, \n\n$A$ is invertible $\\,⇔\\,\\text{dim(Null}(A))=0=\\text{nullity}(A).$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{rank}(A)<n.$* $\\,\\times $ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{rank}(A)=n.$\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Col}(A)={R}^{n}.$*  $\\,✓$ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)={R}^{n}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186272349 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a86c9ea-79e9-50fc-bc35-cf2fee7cdfed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464252} {:answer/id #uuid "8712eb23-d6cb-5de9-b4b0-12bf3d790d49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464253}] :answer-field/correct {:answer/id #uuid "1a86c9ea-79e9-50fc-bc35-cf2fee7cdfed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464252} :answer-field/id #uuid "f8ef167d-4bc6-5f6b-9cd2-3492c740a0f5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465060} {:answer-field/choices [{:answer/id #uuid "6eae4da1-dd85-56d5-8efd-a6744dd9efb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464254} {:answer/id #uuid "915b008a-1011-5090-8324-7e9001f057b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464255}] :answer-field/correct {:answer/id #uuid "6eae4da1-dd85-56d5-8efd-a6744dd9efb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464254} :answer-field/id #uuid "b38b7760-7c88-5d50-8e1a-83c437c15443" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465061} {:answer-field/choices [{:answer/id #uuid "952b73be-fa27-5c33-ac51-fe0f11cb7be4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464256} {:answer/id #uuid "3fc948d7-8345-54f5-aac4-3efcd42070c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464257}] :answer-field/correct {:answer/id #uuid "3fc948d7-8345-54f5-aac4-3efcd42070c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464257} :answer-field/id #uuid "cf6398a3-5006-54e1-b7af-c62ec5fc9eea" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465062}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7036dc73-9ca4-59f2-b983-11eaacfb5a4b" :question/math-academy-id "q-142476" :question/problem "Consider the following sentence:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then $\\text{__________}$ .*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $det(A)=0$\n\nII. $\\text{Col}(A)={R}^{16}$\n\nIII. $A$ has $8$ pivot columns\n\nSelect all that apply." :question/worked-solution "If $A$ is an $8\\times 8$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{8} \\\\  & \\text{dim(Col}(A))=8=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is false:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then $det(A)=0$* $\\,\\times $  \n\nSince the matrix $A$ is invertible, it must be  $det(A)\\ne 0.$\n\n- The following statement is false:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then  $\\text{Col}(A)={R}^{16}.$*  $\\,\\times $\n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem,  we have $\\text{Col}(A)={R}^{8}.$\n\n- The following statement is true:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then $A$ has $8$ pivot columns.* $\\,✓$ \n\nSince $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))=8,$ which means that $A$ has exactly $8$ pivot columns.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186275088 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7674d21-f661-53ce-9c89-cda7d267f9a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464258} {:answer/id #uuid "d066aa6a-00c3-5f23-98dd-319579643453" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464259}] :answer-field/correct {:answer/id #uuid "d066aa6a-00c3-5f23-98dd-319579643453" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464259} :answer-field/id #uuid "9c9a6ba0-7305-59d6-bbfa-58571090472e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465063} {:answer-field/choices [{:answer/id #uuid "de9a03d7-7939-515f-8654-2f2de5034c69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464260} {:answer/id #uuid "7f550a9c-d6f4-5c67-9f0d-97820488e12a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464261}] :answer-field/correct {:answer/id #uuid "de9a03d7-7939-515f-8654-2f2de5034c69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464260} :answer-field/id #uuid "c7ce5955-9552-5cc1-8f40-54a9de65a9b1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465064} {:answer-field/choices [{:answer/id #uuid "f3476d2b-a50b-5168-93b9-9c079b1c3e9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464262} {:answer/id #uuid "47cf8085-adf4-5988-ba4e-585371322b7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464263}] :answer-field/correct {:answer/id #uuid "47cf8085-adf4-5988-ba4e-585371322b7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464263} :answer-field/id #uuid "3fdce47d-a87d-56b0-9930-397fb4a161b0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6378e369-5031-5af4-8366-576c75d82fa3" :question/math-academy-id "q-143001" :question/problem "![](images/67/67706db50684aef52269d20065caa21e4301834835e10e1fd3e456646ae2b32e.png)\n\nIn figure $ABCDEF$ shown above, which of the following are equal to the vector $\\overset{\\to }{DF}?$\n\nI. $\\overset{\\to }{DC}+\\overset{\\to }{CB}+\\overset{\\to }{BF}$\n\nII. $\\overset{\\to }{FB}-\\overset{\\to }{DB}$\n\nIII. $\\overset{\\to }{DE}+\\overset{\\to }{EF}$\n\nSelect all that apply." :question/worked-solution "- For the $1$st expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DC}+\\overset{\\to }{CB}+\\overset{\\to }{BF} & =(\\overset{\\to }{DC}+\\overset{\\to }{CB})+\\overset{\\to }{BF} \\\\  & =\\overset{\\to }{DB}+\\overset{\\to }{BF} \\\\  & =\\overset{\\to }{DF}\\,✓\\end{aligned}\n$$\n\n- For the $2$nd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{FB}-\\overset{\\to }{DB} & =\\overset{\\to }{FB}+\\overset{\\to }{BD} \\\\  & =\\overset{\\to }{FD} \\\\  & \\ne \\overset{\\to }{DF}\\,\\times \\end{aligned}\n$$\n\n- For the $3$rd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}+\\overset{\\to }{EF} & =\\overset{\\to }{DF}\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186275089 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cd858e4-c107-59b8-8e32-c58f003a163e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464264} {:answer/id #uuid "82cab609-ba28-56b3-86af-ebf0fe1e4d0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464265}] :answer-field/correct {:answer/id #uuid "1cd858e4-c107-59b8-8e32-c58f003a163e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464264} :answer-field/id #uuid "dc024899-46d7-5349-9838-e39e86f76569" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465066} {:answer-field/choices [{:answer/id #uuid "8fc2e7d3-82e2-531b-bf65-d7814c7dd00d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464266} {:answer/id #uuid "84d7dd87-f0a4-554a-83c1-5e294d1f7592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464267}] :answer-field/correct {:answer/id #uuid "84d7dd87-f0a4-554a-83c1-5e294d1f7592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464267} :answer-field/id #uuid "606ac01f-e466-55e0-acee-aa5b70d8fe3a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465067} {:answer-field/choices [{:answer/id #uuid "e897c19c-be3d-51f0-9c09-3ddea644c0f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464268} {:answer/id #uuid "9dd00f67-28d3-5d1e-9797-5e9edb8eb8a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464269}] :answer-field/correct {:answer/id #uuid "e897c19c-be3d-51f0-9c09-3ddea644c0f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464268} :answer-field/id #uuid "6d8d9975-f6a8-50c8-9aa0-5883d4b25f10" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465068}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32cdac5a-ca17-59c1-8641-8b3b47e09944" :question/math-academy-id "q-143006" :question/problem "![](images/15/15f4bd7f8ecf8f61ce84858e33cdfa468b0de360fac19b0713b6b2dbc4af8d2e.png)\n\nIn figure $ABCDEF$ shown above, which of the following equalities are true?\n\n- $\\overset{\\to }{AB}-\\overset{\\to }{AF}=\\overset{\\to }{BF}$\n- $\\overset{\\to }{DE}+\\overset{\\to }{EA}-\\overset{\\to }{BA}=\\overset{\\to }{DB}$\n- $\\overset{\\to }{BE}-\\overset{\\to }{DE}-\\overset{\\to }{CD}=\\overset{\\to }{CB}$\n\nSelect all that apply." :question/worked-solution "- Equality I is false. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB}-\\overset{\\to }{AF} & =\\overset{\\to }{AB}+\\overset{\\to }{FA} \\\\  & =\\overset{\\to }{FB} \\\\  & \\ne \\overset{\\to }{BF}.\\end{aligned}\n$$\n\n- Equality II is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE}+\\overset{\\to }{EA}-\\overset{\\to }{BA} & =\\overset{\\to }{DE}+(\\overset{\\to }{EA}+\\overset{\\to }{AB}) \\\\  & =\\overset{\\to }{DE}+\\overset{\\to }{EB} \\\\  & =\\overset{\\to }{DB}.\\end{aligned}\n$$\n\n- Equality III is false. Indeed,\n\n$$\n\\begin{aligned}\\overset{\\to }{BE}-\\overset{\\to }{DE}-\\overset{\\to }{CD} & =(\\overset{\\to }{BE}+\\overset{\\to }{ED})+\\overset{\\to }{DC} \\\\  & =\\overset{\\to }{BD}+\\overset{\\to }{DC} \\\\  & =\\overset{\\to }{BC} \\\\  & \\ne \\overset{\\to }{CB}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186275114 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99c0be41-4842-5d84-9243-b20970ca65f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464270} {:answer/id #uuid "ad3a1711-1ce6-584c-8666-fd81316fdd9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464271}] :answer-field/correct {:answer/id #uuid "ad3a1711-1ce6-584c-8666-fd81316fdd9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464271} :answer-field/id #uuid "19e8b9f1-2710-5c4d-97d6-670c3ce72f83" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465069} {:answer-field/choices [{:answer/id #uuid "e6dc7de0-fb70-572e-9395-bf45e4359ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464272} {:answer/id #uuid "3e54788f-563d-5897-822c-4ffcb07e00ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464273}] :answer-field/correct {:answer/id #uuid "3e54788f-563d-5897-822c-4ffcb07e00ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464273} :answer-field/id #uuid "a82999e5-03fb-56c4-8ba2-aa587b618145" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465070} {:answer-field/choices [{:answer/id #uuid "63a65e48-8a48-5658-be41-145c5aab2fa7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464274} {:answer/id #uuid "3d42055b-43bb-5621-bee4-f237edcf65e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464275}] :answer-field/correct {:answer/id #uuid "3d42055b-43bb-5621-bee4-f237edcf65e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464275} :answer-field/id #uuid "2d508279-cf49-5ea0-a9cb-97c308df61f8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465071}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a347e7c2-3db8-5058-926f-eeec20d91744" :question/math-academy-id "q-143331" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.6$ | $0.2$ |\n| $X=2$ | $0.15$ | $0.05$ |\n\nWhich of the following statements are true?\n- **I.** $P(X=2,Y=1)=P(X=2)\\cdot P(Y=1)$\n- **II.** $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- **III.** $X$ and $Y$ are independent\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.6$ | $0.2$ | $0.8$ |\n| $X=2$ | $0.15$ | $0.05$ | $0.2$ |\n| ${f}_{Y}$ | $0.75$ | $0.25$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=2,Y=1)=f(2,1)=0.15.$ On the other hand, \n\n$$\nP(X=2)\\cdot P(Y=1)={f}_{X}(2)\\cdot {f}_{Y}(1)=0.2\\cdot 0.75=0.15.\\,✓\n$$\n\n- Statement II is true. Checking all other possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(1,1) & =0.6=0.8\\cdot 0.75={f}_{X}(1)\\cdot {f}_{Y}(1) & ✓ \\\\ f(1,2) & =0.2=0.8\\cdot 0.25={f}_{X}(1)\\cdot {f}_{Y}(2) & ✓ \\\\ f(2,2) & =0.05=0.2\\cdot 0.25={f}_{X}(2)\\cdot {f}_{Y}(2) & ✓\\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ must be independent.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186275115 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05112f38-a021-5475-adbd-e2dab978dcc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464276} {:answer/id #uuid "f1e27b73-a786-50ad-befd-9af1bceb49a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464277}] :answer-field/correct {:answer/id #uuid "05112f38-a021-5475-adbd-e2dab978dcc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464276} :answer-field/id #uuid "cd056097-b408-58b6-9d07-0013368a4eac" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465072} {:answer-field/choices [{:answer/id #uuid "f2dc0905-947a-5502-afb0-e31f99420f90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464278} {:answer/id #uuid "11f19573-031c-5a4e-92e5-69affffb8f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464279}] :answer-field/correct {:answer/id #uuid "f2dc0905-947a-5502-afb0-e31f99420f90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464278} :answer-field/id #uuid "a1c916fa-571a-52d8-9c46-9dc13d9b2bdd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465073} {:answer-field/choices [{:answer/id #uuid "fd7ef690-8b54-58fe-9a21-0a4293d10ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464280} {:answer/id #uuid "4edd5db2-ceaa-577d-84c0-e2e7014339d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464281}] :answer-field/correct {:answer/id #uuid "fd7ef690-8b54-58fe-9a21-0a4293d10ac9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464280} :answer-field/id #uuid "793fa71c-2507-582d-aece-7b85ad9d5350" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465074}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e48e8cd-fab9-56d8-9673-3c5737feeff5" :question/math-academy-id "q-143333" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.3$ | $0.2$ |\n| $X=2$ | $0.1$ | $0.4$ |\n\nWhich of the following statements are true?\n- **I.** $P(X=2,Y=2)=P(X=2)\\cdot P(Y=2)$\n- **II.** $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- **III.** $X$ and $Y$ are independent\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.3$ | $0.2$ | $0.5$ |\n| $X=2$ | $0.1$ | $0.4$ | $0.5$ |\n| ${f}_{Y}$ | $0.4$ | $0.6$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statements I and II are false. From the table, we obtain that $P(X=2,Y=2)=f(2,2)=0.4.$ However, \n\n$$\nP(X=2)\\cdot P(Y=2)={f}_{X}(2)\\cdot {f}_{Y}(2)=0.5\\cdot 0.6=0.3.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=2,Y=2)\\ne P(X=2)\\cdot P(Y=2),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of those listed.\""}] [{:db/id #edb/ref 17592186275116 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e75e0302-d864-58b2-85e3-94ee824dd2ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464282} {:answer/id #uuid "81aa670d-7b50-5dbc-876a-7211f2efdce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464283}] :answer-field/correct {:answer/id #uuid "e75e0302-d864-58b2-85e3-94ee824dd2ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464282} :answer-field/id #uuid "849d37e5-d949-564c-9ffb-269b4790643f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 1759218640