ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464551} :answer-field/id #uuid "39f02546-0a6c-5523-907e-e1f1ba2cc467" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465209}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7ce01e6e-4d84-5a03-940c-8de7146f3c76" :question/math-academy-id "q-158101" :question/problem "![](images/27/2739a0225640ff20cc9678edf8c41ba45ff637b17a40d0322ca792bef1346f06.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$ clearly lies outside the subset.\n\n- Diagram III represents a line passing through the origin. Therefore, it is a subspace of ${R}^{3}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186275443 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3432bc6c-0030-58ed-b70e-faadde29dc6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464552} {:answer/id #uuid "cd3db031-4021-59fb-a614-e37ec1e7435d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464553}] :answer-field/correct {:answer/id #uuid "cd3db031-4021-59fb-a614-e37ec1e7435d" :answer/type {:db/id #edb/ref 17592186045499 :db/i