5499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464515} :answer-field/id #uuid "c7929bb8-48e8-5ad5-a9f9-a247e206819e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465191} {:answer-field/choices [{:answer/id #uuid "26a5a7e9-ab0e-54c8-8d41-e44b3cc2bfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464516} {:answer/id #uuid "d18b82a3-c24b-5e6a-aa60-1381535b5797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464517}] :answer-field/correct {:answer/id #uuid "26a5a7e9-ab0e-54c8-8d41-e44b3cc2bfc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464516} :answer-field/id #uuid "4bdeead7-751f-5041-8724-a9d669e4d63b" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465192}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42d6a94c-6a33-5351-adc5-bba146953de0" :question/math-academy-id "q-157463" :question/problem "Let $Π$ be the plane with equation $z=2x-y$ in ${R}^{3}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $Π$ contains the zero-vector\n\n- **II.** $Π$ is closed under vector addition\n\n- **III.** $Π$ is closed under scalar multiplication\n\n- **IV.** $Π$ is **not** a subspace of ${R}^{3}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ y \\\\ 2x-y\\end{aligned}],\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The coordinates of the zero-vector satisfy the equation $z=2x-y:$\n\n$$\n\\begin{aligned}z & =2x-y \\\\ (0) & =2(0)-(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-{a}_{2}\\end{aligned}]\\in Π$ and $b=[\\begin{aligned}{b}_{1} \\\\ {b}_{2} \\\\ 2{b}_{1}-{b}_{2}\\end{aligned}]\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-{a}_{2}\\end{aligned}]+[\\begin{aligned}{b}_{1} \\\\ {b}_{2} \\\\ 2{b}_{1}+{b}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ (2{a}_{1}-{a}_{2})+(2{b}_{1}-{b}_{2})\\end{aligned}]=[\\begin{aligned}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ 2({a}_{1}+{b}_{1})-({a}_{2}+{b}_{2})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=2x-y.$ Therefore, $a+b\\in Π.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-{a}_{2}\\end{aligned}]\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ 2{a}_{1}-{a}_{2}\\end{aligned}]=[\\begin{aligned}k{a}_{1} \\\\ k{a}_{2} \\\\ k(2{a}_{1}-{a}_{2})\\end{aligned}]=[\\begin{aligned}k{a}_{1} \\\\ k{a}_{2} \\\\ 2(k{a}_{1})-k{a}_{2}\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=2x-y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement IV is false. Since statements II and III are true, $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186275396 :knowledge-point/_questions [{:db/id #edb/ref 17592186119928 :knowledge-point/id #uuid "4f3018fd-9d16-578f-b050-966890844c9b" :knowledge-point/title "Determining Whether a Plane Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c4e438f-df53-5f70-8e5d-7a169145d53c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464518} {:answer/id #uuid "af822d08-9b9b-57a7-a8c8-33883456d16c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464519}] :answer-field/correct {:answer/id #uuid "af822d08-9b9b-57a7-a8c8-33883456d16c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464519} :answer-field/id #uuid "fb16460b-15cc-5a45-acb1-fc84c3e266eb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465193} {:answer-field/choices [{:answer/id #uuid "c02e032e-2b5a-5921-b21e-d772b83f8b2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464520} {:answer/id #uuid "7b351d6f-31f6-5d4a-b904-75ae0914c6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464521}] :answer-field/correct {:answer/id #uuid "7b351d6f-31f6-5d4a-b904-75ae0914c6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464521} :answer-field/id #uuid "31556c67-692f-5001-8e1d-96f75b44588a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465194} {:answer-field/choices [{:answer/id #uuid "d1287fcc-3fcb-510a-b75c-41ef53051154" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464522} {:answer/id #uuid "b3ab104e-08b0-5836-a2c0-cb9cfa04791d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464523}] :answer-field/correct {:answer/id #uuid "b3ab104e-08b0-5836-a2c0-cb9cfa04791d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464523} :answer-field/id #uuid "f71fabb8-3089-5b76-9692-7fbacfd573c7" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465195} {:answer-field/choices [{:answer/id #uuid "55db86b2-c488-5f67-9c04-0a4b0afc906c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464524} {:answer/id #uuid "de642d2b-0e51-5ff8-9f66-d4e26ea5ccdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464525}] :answer-field/correct {:answer/id #uuid "de642d2b-0e51-5ff8-9f66-d4e26ea5ccdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464525} :answer-field/id #uuid "06fe3143-439a-5767-94b9-14c70cde2a7d" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19a5b6b6-a775-5cf8-81ee-dfec54297bbf" :question/math-academy-id "q-157464" :question/problem "Let $Π$ be the plane with equation $z=x+2y$ in ${R}^{3}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $Π$ contains the zero-vector\n\n- **II.** $Π$ is closed under vector addition\n\n- **III.** $Π$ is closed under scalar multiplication\n\n- **IV.** $Π$ is a subspace of ${R}^{3}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}x \\\\ y \\\\ x+2y\\end{aligned}],\\,x,y\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The coordinates of the zero-vector satisfy the equation $z=x+2y:$\n\n$$\n\\begin{aligned}z & =x+2y \\\\ (0) & =(0)+2(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{aligned}]\\in Π$ and $b=[\\begin{aligned}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}+2{b}_{2}\\end{aligned}]\\in Π.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{aligned}]+[\\begin{aligned}{b}_{1} \\\\ {b}_{2} \\\\ {b}_{1}+2{b}_{2}\\end{aligned}]=[\\begin{aligned}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ ({a}_{1}+2{a}_{2})+({b}_{1}+2{b}_{2})\\end{aligned}]=[\\begin{aligned}{a}_{1}+{b}_{1} \\\\ {a}_{2}+{b}_{2} \\\\ ({a}_{1}+{b}_{1})+2({a}_{2}+{b}_{2})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x+2y.$ Therefore, $a+b\\in Π.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{aligned}]\\in Π$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}{a}_{1} \\\\ {a}_{2} \\\\ {a}_{1}+2{a}_{2}\\end{aligned}]=[\\begin{aligned}k{a}_{1} \\\\ k{a}_{2} \\\\ k({a}_{1}+2{a}_{2})\\end{aligned}]=[\\begin{aligned}k{a}_{1} \\\\ k{a}_{2} \\\\ k{a}_{1}+2(k{a}_{2})\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $z=x+2y.$ Therefore, $k\\cdot a\\in Π.$\n\n- Statement IV is true. Since statements II and III are true, the plane $Π$ must be a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"All the statements are true.\""}] [{:db/id #edb/ref 17592186275399 :knowledge-point/_questions [{:db/id #edb/ref 17592186119928 :knowledge-point/id #uuid "4f3018fd-9d16-578f-b050-966890844c9b" :knowledge-point/title "Determining Whether a Plane Is a Subspace of Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e283f24-c3a1-59cf-9e3c-55ce9bf0a94a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464526} {:answer/id #uuid "62297675-ca20-5ed1-a25c-956c7f98abe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464527}] :answer-field/correct {:answer/id #uuid "7e283f24-c3a1-59cf-9e3c-55ce9bf0a94a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464526} :answer-field/id #uuid "febd412b-208a-57f4-a3e5-07cc980e96ea" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465197} {:answer-field/choices [{:answer/id #uuid "c2929686-a438-5316-b4de-d0b3d0e5e45b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464528} {:answer/id #uuid "f37d4317-a9ec-5c5a-9f0b-ed6e65458994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464529}] :answer-field/correct {:answer/id #uuid "c2929686-a438-5316-b4de-d0b3d0e5e45b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464528} :answer-field/id #uuid "9702f944-1db8-518a-acb2-526219576d0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465198} {:answer-field/choices [{:answer/id #uuid "6be4fdbb-c7e4-5655-b045-b6f33961203b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464530} {:answer/id #uuid "344f3967-9d4d-5472-83ad-054c661bb257" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464531}] :answer-field/correct {:answer/id #uuid "6be4fdbb-c7e4-5655-b045-b6f33961203b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464530} :answer-field/id #uuid "70cbf976-fe8d-5ca6-b921-4a95b4f265e8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465199} {:answer-field/choices [{:answer/id #uuid "3f902f17-2143-5f18-a934-cec9caf9ce4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464532} {:answer/id #uuid "c348bb49-51ad-5388-bcca-dcb41c8a20bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464533}] :answer-field/correct {:answer/id #uuid "3f902f17-2143-5f18-a934-cec9caf9ce4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464532} :answer-field/id #uuid "0e36ef1a-6a50-5ba0-b80b-aa2e41f943fa" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465200}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "99eda82b-48bc-5827-9c44-f2725d46a5d4" :question/math-academy-id "q-157476" :question/problem "Let $Π$ be the plane with equation $x-2y+2z=3$ in ${R}^{3}.$ Which of the following statements are true? \n\nI. $Π$ contains the zero-vector\n\nII. $Π$ is closed under vector addition\n\nIII. $Π$ is closed under scalar multiplication\n\nIV. $Π$ is a subspace of ${R}^{3}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $Π$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}3+2y-2z \\\\ y \\\\ z\\end{aligned}],\\,y,z\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is false. The line does not pass through the origin since\n\n$$\n\\begin{aligned}x-2y+2z & =3 \\\\ (0)-2(0)+2(0) & =3 \\\\ 0 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement II is false. Let's consider $a=[\\begin{aligned}3 \\\\ 0 \\\\ 0\\end{aligned}]\\in Π$ and $b=[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]\\in Π.$ Then \n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}3 \\\\ 0 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]=[\\begin{aligned}3+1 \\\\ 0+0 \\\\ 0+1\\end{aligned}]=[\\begin{aligned}4 \\\\ 0 \\\\ 1\\end{aligned}],\\end{aligned}\n$$\n\nHowever, $[\\begin{aligned}4 \\\\ 0 \\\\ 1\\end{aligned}]$ does not belong to $Π$ since \n\n$$\n\\begin{aligned}x-2y+2z & =3 \\\\ (4)-2(0)+2(1) & =3 \\\\ 6 & =3\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since $0\\notin Π,$ this set is not closed under scalar multiplication.\n\n- Statement IV is false. Since statements II and III are false, $L$ is *not* a subspace of ${R}^{3}.$\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186275420 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352101e0-3c5b-502b-a334-6b1b8070e311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464534} {:answer/id #uuid "b81938d9-ae2d-5288-8081-529643148694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464535}] :answer-field/correct {:answer/id #uuid "352101e0-3c5b-502b-a334-6b1b8070e311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464534} :answer-field/id #uuid "468f4c36-ed35-5785-949b-ff79fcb9eb6f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465201} {:answer-field/choices [{:answer/id #uuid "f0a1dc91-c6a3-54bc-b477-5c7f11f05916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464536} {:answer/id #uuid "33615139-f00b-5e76-9a32-8e9d69940975" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464537}] :answer-field/correct {:answer/id #uuid "f0a1dc91-c6a3-54bc-b477-5c7f11f05916" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464536} :answer-field/id #uuid "7770bc41-73c7-55e4-b7bd-776454e3312b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465202} {:answer-field/choices [{:answer/id #uuid "f22b964c-9152-568c-ba2a-cebc8c366bd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464538} {:answer/id #uuid "1bd8574e-8fd8-5a4e-ad0b-95ed7b7d233d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186464539}] :answer-field/correct {:answer/id #uuid "f22b964c-9152-568c-ba2a-cebc8c366bd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186464538} :answer-field/id #uuid "0a73248c-d4f7-5606-8dd7-59415c7496e2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186465203}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ecd1a30-d61f-5d31-96d2-62fa52545c5c" :question/math-academy-id "q-158029" :question/problem "![](images/73/7359571270dd1ce7df2b68d396e2c87cbf44bd7b18adf94bdb7ade4c02a8bc12.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}?$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram I is not a subspace of ${R}^{2}.$\n\n- Diagram II represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III does not represent a subspace.  In this case, we have that the vector $a=[\\begin{aligned}0 \\\\ -1\\end{aligned}]$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nlies outside the subset.\n\nSo, the correct answer is \"None\"."}] [{:db/id #edb/ref 17592186275441 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f