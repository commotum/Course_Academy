#{[{:db/id #edb/ref 17592186380221 :knowledge-point/_questions [{:db/id #edb/ref 17592186059694 :knowledge-point/id #uuid "93d3501b-96ef-5fbd-9d93-788021156ddb" :knowledge-point/title "Identifying Logically Equivalent Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dda9d468-becb-54e6-9d7c-a36da59bbb0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471753} {:answer/id #uuid "3bc1de6b-6351-548e-b152-50fd8ef8413e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471754}] :answer-field/correct {:answer/id #uuid "3bc1de6b-6351-548e-b152-50fd8ef8413e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471754} :answer-field/id #uuid "a959e3ca-4163-50bd-9b6f-1b49bb7a3efb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472382} {:answer-field/choices [{:answer/id #uuid "714898a2-3141-5053-ab51-02f399c94eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471755} {:answer/id #uuid "a436efc5-6bb5-5944-b3f8-595b5e63604d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471756}] :answer-field/correct {:answer/id #uuid "714898a2-3141-5053-ab51-02f399c94eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471755} :answer-field/id #uuid "18c69588-c464-5cab-89e1-7667dce161c6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472383} {:answer-field/choices [{:answer/id #uuid "39d3c8d9-8286-5656-ad84-dec522575e91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471757} {:answer/id #uuid "c0099cb5-5210-539d-8a9c-36530f395a74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471758}] :answer-field/correct {:answer/id #uuid "39d3c8d9-8286-5656-ad84-dec522575e91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471757} :answer-field/id #uuid "0a7a2082-751e-5b23-942c-7a7417ba6a57" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472384}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4b3c08af-1740-5428-a4c7-1f507e3193d7" :question/math-academy-id "q-82664" :question/problem "$\\,$ **If** we do not go to the cinema, **then** we watch a movie at home.\n\nWhich of the following statements are equivalent to the conditional statement above?\n- **I.** If we do not watch a movie at home, then we go to the cinema.\n- **II.** If we watch a movie at home, then we do not go to the cinema.\n- **III.** If we go to the cinema, then we do not watch a movie at home.\n\nSelect all that apply." :question/worked-solution "Let's recall the following facts:\n\n- The contrapositive is logically equivalent to the original statement.\n\n- The inverse and the converse are logically equivalent to each other, but not to the original statement.\n\n![](images/0d/0deb19675402bf931111bb80cb616682aac08491b5cd3e1ab5812da05b6df8a8.png)\n\nSo, we are looking for the contrapositive.\n\n- Statement I is the contrapositive. $\\,✓$\n\n- Statement I is the converse, not the contrapositive. $\\,\\times $\n\n- Statement III is the inverse, not the contrapositive. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186380325 :knowledge-point/_questions [{:db/id #edb/ref 17592186124528 :knowledge-point/id #uuid "20a6c0cf-04d4-5908-a03f-1adf491b9282" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem in Terms of Eigenvalues"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60987df5-8c3c-54ae-838c-cd701fb442dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471789} {:answer/id #uuid "8f001032-df56-5a30-a156-b43b6ff775fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471790}] :answer-field/correct {:answer/id #uuid "8f001032-df56-5a30-a156-b43b6ff775fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471790} :answer-field/id #uuid "5a388f01-4a46-5643-acde-373829d0e415" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472400} {:answer-field/choices [{:answer/id #uuid "3c598417-054a-57eb-b548-de0798c7d570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471791} {:answer/id #uuid "0b8aaebf-d279-5803-83a3-bd17d7899f6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471792}] :answer-field/correct {:answer/id #uuid "3c598417-054a-57eb-b548-de0798c7d570" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471791} :answer-field/id #uuid "297b34f9-4160-5f88-8408-a21af344a053" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472401} {:answer-field/choices [{:answer/id #uuid "55ae7047-3b7e-51d5-9be1-7e2f66eecf5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471793} {:answer/id #uuid "d9fb77f4-4254-5c73-953b-7f787e0f61d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471794}] :answer-field/correct {:answer/id #uuid "d9fb77f4-4254-5c73-953b-7f787e0f61d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471794} :answer-field/id #uuid "74391771-4e6a-57d2-9134-21c7fb4ea916" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472402}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f94c3089-795c-58b5-a020-124bd7b98fb9" :question/math-academy-id "q-97859" :question/problem "If $B$ is a $3\\times 3$ non-invertible matrix, then which of the following could be the characteristic equation of $B?$\n- **I.** ${\\lambda }^{3}-4\\lambda =0$\n- **II.** ${\\lambda }^{3}-3{\\lambda }^{2}-\\lambda +4=0$\n- **III.** $\\lambda (\\lambda +4)(\\lambda -1)=0$\n\nSelect all that apply." :question/worked-solution "Since $B$ is non-invertible, according to the invertible matrix theorem, $0$ must be an eigenvalue of $B.$ As a result, $\\lambda =0$ should be a solution to the corresponding characteristic equation. \n\nWith that in mind, let's examine the given equations in turn.\n\n- Equation I could be the characteristic equation of $B.$ Indeed, $\\lambda =0$ is a root of the equation.\n\n- Equation II **cannot** be the characteristic equation of $B$ since $\\lambda =0$ is not a root of the equation.\n\n- Equation III could be the characteristic equation of $B.$ Indeed, $\\lambda =0$ is a root of the equation.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186380386 :knowledge-point/_questions [{:db/id #edb/ref 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :kno