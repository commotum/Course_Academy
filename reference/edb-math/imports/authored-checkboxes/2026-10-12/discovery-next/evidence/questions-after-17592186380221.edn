1f6a9-9061-58cf-b556-dd9ee828569c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470822} :answer-field/id #uuid "61e53737-4eb4-54cd-be32-14482ec6f23b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "09033cd1-e3bd-58ad-8df5-2396d7439d27" :question/math-academy-id "q-105329" :question/problem "![](images/5c/5c50beff59a4bc2ae8cf3da8c9fed849c73cbf828ad0f875675520fc33589365.png)\n\nFor the function $f:R\\to R$ defined by $f(x)=\\sqrt[3]{x-1}$, which of the following statements are true? \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection\n\nSelect all that apply." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is true. Any horizontal line (like the one depicted below) crosses the graph of $f(x)$ at most once.\n\n![](images/66/66d558a2118721b2793311fb0f4687d91aefa125e74a73379c793a9fdbedf46d.png)\n\n        \n\n- Statement II is true. According to the graph, the range of $f(x)$ will cover the entire interval $(-\\infty ,\\infty ).$\n\n- Statement III is true because the function is both surjective and injective.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186382813 :knowledge-point/_questions [{:db/id #edb/ref 17592186152263 :knowledge-point/id #uuid "bfbebc20-1b48-5718-a057-b743c8af8de1" :knowledge-point/title "Identifying Bijections For Functions Defined on the Set of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fbd78fe-5ede-5795-9622-962461ceaffd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470823} {:answer/id #uuid "9de6e2bf-f8e9-549b-9aed-e689c26328e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470824}] :answer-field/correct {:answer/id #uuid "4fbd78fe-5ede-5795-9622-962461ceaffd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470823} :answer-field/id #uuid "3837b8ab-5872-5992-97f4-40787670506a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471917} {:answer-field/choices [{:answer/id #uuid "ca534b3e-7b8d-50f0-8361-4fe1356e93d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470825} {:answer/id #uuid "d603d976-e8c8-5eb2-8c88-cea3ab366fdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470826}] :answer-field/correct {:answer/id #uuid "ca534b3e-7b8d-50f0-8361-4fe1356e93d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470825} :answer-field/id #uuid "e4e0316e-a490-5722-a171-17b4936ef2c1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471918} {:answer-field/choices [{:answer/id #uuid "4c5d5dc3-30a6-556f-a142-ba2a5ab13561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470827} {:answer/id #uuid "551313b9-9c31-565f-bd3f-853edba26752" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470828}] :answer-field/correct {:answer/id #uuid "4c5d5dc3-30a6-556f-a142-ba2a5ab13561" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470827} :answer-field/id #uuid "7f1b659c-be5a-5301-b7ea-21955cb2e5fa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ea34001e-7666-5760-9335-3a797f196771" :question/math-academy-id "q-105330" :question/problem "![](images/88/8845d8cc2664c92637e06961f1d5c17b98afcb72470d1463fbd58aaf5691ca4c.png)\n\nFor the function $f:R\\to R$ defined by $f(x)=(x+1)^{2}-2$, which of the following statements are true?  \n\n- The function is an injection\n- The function is a surjection\n- The function is a bijection\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "Recall that a function $f:X\\to Y$ is \n\n- an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ whenever $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2},$\n\n- a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y,$\n\n- a bijection if it is both a surjection and an injection.\n\nWith this in mind, let's check each statement.\n\n- Statement I is false. There are horizontal lines (such as the one depicted below) that cross the graph of $f(x)$ more than once.\n\n![](images/d6/d6b2a99811341aa07bc3e91df973504fad57ac4a71a38406707b5d311247d61d.png)\n\n        \n\n- Statement II is false. For example, there is not $x\\in R$ such that $f(x)=-4.$ So, $f$ is not a surjection.\n\n- Statement III is false, because the function is not both an injection and a surjection.\n\nTherefore, the correct answer is \"None of the statements are true.\""}] [{:db/id #edb/ref 17592186382964 :knowledge-point/_questions [{:db/id #edb/ref 17592186172016 :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59c2108e-96b3-5d6e-b962-726f73a1c21a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470907} {:answer/id #uuid "29a4d37b-cc9d-5abd-be6e-cfa2b43602c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470908}] :answer-field/correct {:answer/id #uuid "29a4d37b-cc9d-5abd-be6e-cfa2b43602c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470908} :answer-field/id #uuid "abd7be65-6a56-5d33-8320-4a5183336838" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471959} {:answer-field/choices [{:answer/id #uuid "abb4d5de-82bb-5735-b761-cfde599aa37d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470909} {:answer/id #uuid "3ed146ce-9654-5b05-8813-205e6efe5487" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470910}] :answer-field/correct {:answer/id #uuid "abb4d5de-82bb-5735-b761-cfde599aa37d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470909} :answer-field/id #uuid "1c7baf85-0e15-56af-8e13-67a4b94d7bb9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471960} {:answer-field/choices [{:answer/id #uuid "f62e0438-6fb4-597d-b819-130688cdb78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470911} {:answer/id #uuid "634a9e82-263e-5ffd-abd8-8a03e7ee5d48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470912}] :answer-field/correct {:answer/id #uuid "f62e0438-6fb4-597d-b819-130688cdb78f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470911} :answer-field/id #uuid "0aa2ffea-ff43-5b1d-90a1-15f52b173f02" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471961}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9198e7bb-f6e2-569d-9a58-c321fc238e98" :question/math-academy-id "q-120290" :question/problem "![](images/32/32fefe70890d179803a847fc597349948703176d1561a8c840e845fa7a06a872.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=\\frac{y+2}{x-1}$\n- ${y}^{′}=(x-1)(y-2)$\n- ${y}^{′}=\\frac{y-2}{x}$\n\nSelect all that apply." :question/worked-solution "![](images/a1/a18f69bf5b2cb6b2984722f851e1eda017e48863517da7ee65597d7c25c46379.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- For $x\\ne 1,$ the slopes of the slope field become horizontal at $y=-2.$\n\n- For $y\\ne -2,$ the slopes of the slope field become vertical as $x\\to 1.$\n\nWith that in mind, let's consider each equation.\n\n- Equation I gives the required behavior. For $x\\ne 1,$ the right-hand side of ${y}^{′}=\\frac{y+2}{x-1}$ evaluates to zero on $y=-2,$ and for $y\\ne -2,$\n\n$$\n|{y}^{′}|=|\\frac{y+2}{x-1}|\\to \\infty \\,\\text{as}\\,x\\to 1.\n$$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=(x-1)(y-2)$ does not evaluate to zero on $y=-2$ (the value depends on $x$).\n\n- Equation III does *not* give the required behavior. The right-hand side of ${y}^{′}=\\frac{y-2}{x}$ evaluates to zero on $y=2,$ but \n\n$$\n|{y}^{′}|=|\\frac{y-2}{x}|\\to |y-2|\\,\\text{as}\\,x\\to 1.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186383328 :knowledge-point/_questions [{:db/id #edb/ref 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56a20be7-6579-511c-ad5d-1ce303fce86a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471009} {:answer/id #uuid "a847bdd2-d7bd-5d0a-b7be-52597a69380f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471010}] :answer-field/correct {:answer/id #uuid "a847bdd2-d7bd-5d0a-b7be-52597a69380f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471010} :answer-field/id #uuid "eb111a44-39df-585c-967b-ae6f35ecc6d6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472010} {:answer-field/choices [{:answer/id #uuid "5bc76465-5b80-50ab-bc52-afc8e762680f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471011} {:answer/id #uuid "5782df2a-d54b-5db6-b27f-35c713430005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471012}] :answer-field/correct {:answer/id #uuid "5bc76465-5b80-50ab-bc52-afc8e762680f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471011} :answer-field/id #uuid "b963fb55-cead-5821-b0dc-816138d8b25a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472011} {:answer-field/choices [{:answer/id #uuid "e5cc124a-3892-5225-a9c7-6e32907d06fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471013} {:answer/id #uuid "5b51995a-55f7-5346-b0ce-8a490c88d9e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471014}] :answer-field/correct {:answer/id #uuid "5b51995a-55f7-5346-b0ce-8a490c88d9e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471014} :answer-field/id #uuid "c2d30c3d-5554-5a5b-a121-14874855257e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472012}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "017164c5-337a-58b5-8e66-674d944a6841" :question/math-academy-id "q-133262" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)=6{x}^{2}+3{y}^{2}$ and ${f}_{y}(x,y)=6xy$\n- **II.** ${f}_{x}(x,y)=15{x}^{2}-y$ and ${f}_{y}(x,y)=8y+x$\n- **III.** ${f}_{x}(x,y)=\\operatorname{ln}⁡x+1$ and ${f}_{y}(x,y)=-3{y}^{2}$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(6{x}^{2}+3{y}^{2})=6y \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(6xy)=6y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the first pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(15{x}^{2}-y)=-1 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(8y+x)=1.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the second pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡x+1)=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3{y}^{2})=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$,  the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186383335 :knowledge-point/_questions [{:db/id #edb/ref 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ba2ae8e-668d-5174-a86d-2cf8dc8cac78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471015} {:answer/id #uuid "0f322749-ca06-58f8-9b9e-c84f76987f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471016}] :answer-field/correct {:answer/id #uuid "4ba2ae8e-668d-5174-a86d-2cf8dc8cac78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471015} :answer-field/id #uuid "414a4e94-a112-586d-b5d5-a8053d338a4b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472013} {:answer-field/choices [{:answer/id #uuid "b088d5b8-a6f1-5b21-9fd5-d1d92b01b633" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471017} {:answer/id #uuid "e6b69fff-cb92-543e-a99b-18e346dc344c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471018}] :answer-field/correct {:answer/id #uuid "e6b69fff-cb92-543e-a99b-18e346dc344c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471018} :answer-field/id #uuid "175f313c-b8a0-5f41-a622-5331199d6a62" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472014} {:answer-field/choices [{:answer/id #uuid "825ef8ce-26f3-5554-add9-7a2866d49ed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471019} {:answer/id #uuid "87b03dd6-e89c-544c-9a74-9b059df6f464" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471020}] :answer-field/correct {:answer/id #uuid "825ef8ce-26f3-5554-add9-7a2866d49ed7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471019} :answer-field/id #uuid "20c03c3b-8284-571c-ba36-765ccd7b8f09" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472015}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "004baeb6-1fe8-58d6-b484-d81ddf229838" :question/math-academy-id "q-133295" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)={e}^{x}\\operatorname{cos}⁡({e}^{x})$ and ${f}_{y}(x,y)=\\operatorname{sin}⁡({e}^{x})$\n- **II.** ${f}_{x}(x,y)=\\sqrt{1-{x}^{2}}$ and ${f}_{y}(x,y)=\\sqrt{1-y}$\n- **III.** ${f}_{x}(x,y)=\\operatorname{ln}⁡({x}^{2}+1)$ and ${f}_{y}(x,y)=x\\operatorname{ln}⁡({y}^{2}+1)$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({e}^{x}\\operatorname{cos}⁡({e}^{x}))=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡({e}^{x}))={e}^{x}\\operatorname{cos}⁡({e}^{x}).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\sqrt{1-{x}^{2}})=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(\\sqrt{1-y})=0.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+1))=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡({y}^{2}+1))=\\operatorname{ln}⁡({y}^{2}+1).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186383342 :knowledge-point/_questions [{:db/id #edb/ref 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b02ff6f-57e0-536c-aca3-2d760268e2c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471021} {:answer/id #uuid "c872f2f6-b7d6-5c29-bbde-7c4b15738fea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471022}] :answer-field/correct {:answer/id #uuid "c872f2f6-b7d6-5c29-bbde-7c4b15738fea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471022} :answer-field/id #uuid "21f381ca-9503-5ca4-b72b-7b29cf5f410e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472016} {:answer-field/choices [{:answer/id #uuid "06d88b8d-cf78-5d26-9ffa-9f547e94dd2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471023} {:answer/id #uuid "95c494e0-4cde-5941-b742-7701608869a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471024}] :answer-field/correct {:answer/id #uuid "06d88b8d-cf78-5d26-9ffa-9f547e94dd2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471023} :answer-field/id #uuid "676c65d2-db56-5535-9e55-00232223631f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472017} {:answer-field/choices [{:answer/id #uuid "e39de23b-aee0-5777-af07-2bf8ce165ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471025} {:answer/id #uuid "8122d886-265c-54ae-9df9-1489be890b9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471026}] :answer-field/correct {:answer/id #uuid "e39de23b-aee0-5777-af07-2bf8ce165ea8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471025} :answer-field/id #uuid "1578bce8-93a1-52a1-8300-d409929c6425" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472018}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d4e7c93-f352-516f-9253-b49a36a438e0" :question/math-academy-id "q-133297" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n\nI. ${f}_{x}(x,y)=2{e}^{2x-{y}^{2}}$ and ${f}_{y}(x,y)=-2y{e}^{2x-{y}^{2}}$\n\nII. ${f}_{x}(x,y)=2\\operatorname{cos}⁡(2x-{y}^{2})$ and ${f}_{y}(x,y)=-2x\\operatorname{cos}⁡(2x-{y}^{2})$\n\nIII. ${f}_{x}(x,y)=\\sqrt{x}$ and ${f}_{y}(x,y)=x\\operatorname{ln}⁡y$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2{e}^{2x-{y}^{2}})=-4y{e}^{2x-{y}^{2}} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(-2y{e}^{2x+{y}^{2}})=-4y{e}^{2x-{y}^{2}}.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the first pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(2\\operatorname{cos}⁡(2x-{y}^{2}))=4y\\operatorname{sin}⁡(2x-{y}^{2}) \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(-2x\\operatorname{cos}⁡(2x-{y}^{2}))=-2\\operatorname{cos}⁡(2x-{y}^{2})+4x\\operatorname{sin}⁡(2x-{y}^{2}).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the second pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(\\sqrt{x})=0 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(x\\operatorname{ln}⁡y)=\\operatorname{ln}⁡y.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the third pair cannot represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186383349 :knowledge-point/_questions [{:db/id #edb/ref 17592186124450 :knowledge-point/id #uuid "0b15f59e-ef74-5fa2-9af9-448fdcbbbd3d" :knowledge-point/title "Identifying Possible Pairs of First-Order Partial Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be14b852-a6af-555c-bbdf-afdaf5cc630a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471027} {:answer/id #uuid "76e6636e-da82-541f-a918-44d3e2909381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471028}] :answer-field/correct {:answer/id #uuid "be14b852-a6af-555c-bbdf-afdaf5cc630a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471027} :answer-field/id #uuid "a4e454b2-9b73-579b-88fd-8f6234445d79" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472019} {:answer-field/choices [{:answer/id #uuid "9a1843c6-0d23-5144-9c62-7cc65106b7fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471029} {:answer/id #uuid "308507af-652e-5dd7-ba73-937e3e345d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471030}] :answer-field/correct {:answer/id #uuid "308507af-652e-5dd7-ba73-937e3e345d35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471030} :answer-field/id #uuid "9359ed1e-6c6c-5066-83f7-d8cc6ede1470" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472020} {:answer-field/choices [{:answer/id #uuid "96a715f9-ee83-5ec5-aeab-43274076ad6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471031} {:answer/id #uuid "464eba41-9a20-5cac-8bd1-fef80526f565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471032}] :answer-field/correct {:answer/id #uuid "464eba41-9a20-5cac-8bd1-fef80526f565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471032} :answer-field/id #uuid "851cbb8b-c023-503e-8cb0-c20dd5104f10" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472021}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffcfd211-dc96-5e56-a933-77ab3f803324" :question/math-academy-id "q-133332" :question/problem "Suppose that the function $f(x,y)$ and all of its first and second-order partial derivatives are continuous on an open set $U.$ Which of the following pairs could represent the first-order partial derivatives of $f(x,y)?$\n- **I.** ${f}_{x}(x,y)={x}^{2}+5y$ and ${f}_{y}(x,y)=3{x}^{2}-3y$\n- **II.** ${f}_{x}(x,y)=-2x{e}^{{y}^{3}-{x}^{2}}$ and ${f}_{y}(x,y)=3{y}^{2}{e}^{{y}^{3}-{x}^{2}}$\n- **III.** ${f}_{x}(x,y)=3{x}^{2}y-y{e}^{xy}$ and ${f}_{y}(x,y)={x}^{3}-x{e}^{xy}$\n\nSelect all that apply." :question/worked-solution "Since the function and its first and second-order partial derivatives are continuous on an open set $U,$ the mixed partial derivatives must be equal, that is, ${f}_{xy}(x,y)={f}_{yx}(x,y).$ Let's check if this condition is true for each of our pairs of first-order partial derivatives.\n\n- For the first pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({x}^{2}+5y)=5 \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3{x}^{2}-3y)=6x.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)\\ne {f}_{yx}(x,y)$, the first pair cannot represent the first-order partial derivatives of $f(x,y).$\n\n- For the second pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(-2x{e}^{{y}^{3}-{x}^{2}})=-6x{y}^{2}{e}^{{y}^{3}-{x}^{2}} \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}(3{y}^{2}{e}^{{y}^{3}-{x}^{2}})=-6x{y}^{2}{e}^{{y}^{3}-{x}^{2}}.\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the second pair could represent the first-order partial derivatives of $f(x,y).$\n\n- For the third pair, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}(3{x}^{2}y-y{e}^{xy}) \\\\  & =3{x}^{2}-({e}^{xy}+xy{e}^{xy}), \\\\ {f}_{yx}(x,y) & =\\frac{∂}{∂x}({x}^{3}-x{e}^{xy}) \\\\  & =3{x}^{2}-({e}^{xy}+xy{e}^{xy}).\\end{aligned}\n$$\n\nAs ${f}_{xy}(x,y)={f}_{yx}(x,y)$, the third pair could represent the first-order partial derivatives of $f(x,y).$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186383473 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98db4bdf-35c0-572f-a8d0-dd5af5d2d797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471045} {:answer/id #uuid "3e5b1cde-3a17-5c26-ae0b-684c07d6c465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471046}] :answer-field/correct {:answer/id #uuid "3e5b1cde-3a17-5c26-ae0b-684c07d6c465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471046} :answer-field/id #uuid "28b9829d-7120-5b5c-92bd-c1ef0c0e2fa6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472028} {:answer-field/choices [{:answer/id #uuid "9127507d-cd00-5560-bb89-a83a30f508fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471047} {:answer/id #uuid "ba4074bd-8e93-5f12-a606-f60e237bc602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471048}] :answer-field/correct {:answer/id #uuid "9127507d-cd00-5560-bb89-a83a30f508fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471047} :answer-field/id #uuid "2bbaf59b-eeb3-51ce-8a01-5dc52517e99d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472029} {:answer-field/choices [{:answer/id #uuid "bf59bd71-a0bd-5b9f-a650-5a3684e0a341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471049} {:answer/id #uuid "ee3117e1-426e-540f-a519-e302a751ae0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471050}] :answer-field/correct {:answer/id #uuid "bf59bd71-a0bd-5b9f-a650-5a3684e0a341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471049} :answer-field/id #uuid "d9d335f5-b08f-5856-be51-b11cb49c2f5f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472030}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5449cbef-825d-5bac-be24-822940400b4f" :question/math-academy-id "q-143335" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.1$ | $0.1$ |\n| $X=2$ | $0.3$ | $0.2$ |\n| $X=3$ | $0.2$ | $0.1$ |\n\nWhich of the following statements are true?\n- **I.** $P(X=2,Y=2)=P(X=2)\\cdot P(Y=2)$\n- **II.** $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- **III.** $X$ and $Y$ are independent\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.1$ | $0.2$ |\n| $X=2$ | $0.3$ | $0.2$ | $0.5$ |\n| $X=3$ | $0.2$ | $0.1$ | $0.3$ |\n| ${f}_{Y}$ | $0.6$ | $0.4$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=2,Y=2)=f(2,2)=0.2.$ On the other hand, \n\n$$\nP(X=2)\\cdot P(Y=2)={f}_{X}(2)\\cdot {f}_{Y}(2)=0.5\\cdot 0.4=0.2.\\,✓\n$$\n\n- Statement II is false. Taking $x=1$ and $y=1,$ we obtain the following:\n\n$$\n\\begin{aligned}f(1,1) & =0.1\\ne 0.2\\cdot 0.6={f}_{X}(1)\\cdot {f}_{Y}(1) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186383554 :knowledge-point/_questions [{:db/id #edb/ref 17592186198400 :knowledge-point/id #uuid "4179839d-85c4-5325-9293-e332bd209597" :knowledge-point/title "Identifying True Statements Regarding the Inverse Function Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dfbfd1f-8c57-5fbe-a046-ceb729aa8a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471131} {:answer/id #uuid "73106404-c5ab-5410-828f-e3512801d032" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471132}] :answer-field/correct {:answer/id #uuid "5dfbfd1f-8c57-5fbe-a046-ceb729aa8a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471131} :answer-field/id #uuid "ff7b3c6d-8c28-54e5-9c3d-44c52e635b0b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472071} {:answer-field/choices [{:answer/id #uuid "f8d21e81-e466-5275-b6d7-e8596ffd6af7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471133} {:answer/id #uuid "2ea8393e-8b7e-5757-8a39-9abbd88090d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471134}] :answer-field/correct {:answer/id #uuid "f8d21e81-e466-5275-b6d7-e8596ffd6af7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471133} :answer-field/id #uuid "8576233d-a2de-53f9-8fb3-a010c3910212" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472072} {:answer-field/choices [{:answer/id #uuid "c413dcb0-496c-5788-83c8-a5743c676e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471135} {:answer/id #uuid "490e1529-0fed-5e20-985c-3761de5fd52f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471136}] :answer-field/correct {:answer/id #uuid "490e1529-0fed-5e20-985c-3761de5fd52f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471136} :answer-field/id #uuid "885433fd-1178-5da3-bd21-57f732fa2bb4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472073}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dcab08e-c33d-5c73-a45a-265b0e425858" :question/math-academy-id "q-161847" :question/problem "Let $f:U\\to R$ be continuously differentiable on an open set $U⊆R$ such that $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U.$ Which of the following statements **must** be true?\n- **I.** The function $f$ is invertible on $U.$\n- **II.** The inverse ${f}^{-1}$ is continuously differentiable on $U.$\n- **III.** The derivative of ${f}^{-1}$ is given by ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The inverse function theorem for single-variable functions states the following:\n\n*If $f:U\\to R$ is continuously differentiable on an open set $U⊆R,$ $f(a)=b$ and ${f}^{′}(a)\\ne 0$ for $a\\in U,$ then*\n\n- *$f$ is invertible in some neighborhood of $a,$*\n\n- *${f}^{-1},$ the inverse of $f,$ is continuously differentiable in a neighborhood of $b,$ and*\n\n- *the derivative of ${f}^{-1}$ is given by* \n\n$$\n{({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}=\\frac{1}{{f}^{′}({f}^{-1}(b))}\\,.\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the theorem, the function $f$ must be invertible in some neighborhood of $a,$ which could be smaller than $U.$ \n\nFor example, the function $f(x)=2{x}^{4}$ satisfies the conditions of the inverse function theorem for $U=(-2,2)$ and $a=-1.$ However, $f(x)$ is not invertible on the entire set $U,$ only on a subset of $U.$\n\n- Statement II is false. According to the theorem, the function${f}^{-1}$ must be continuously differentiable in a neighborhood of $b,$ which could be smaller than $U.$\n\n- Statement III is true. According to the theorem, we must have ${({f}^{-1})}^{′}(b)=\\frac{1}{{f}^{′}(a)}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186383694 :knowledge-point/_questions [{:db/id #edb/ref 17592186054640 :knowledge-point/id #uuid "d4954fe5-f1fe-590a-9540-280a14606a49" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb402d5a-0b37-5e84-8c9e-ca364c7becf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471215} {:answer/id #uuid "9bb577a0-cc5e-55cb-b4e9-fb72f6a4b441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471216}] :answer-field/correct {:answer/id #uuid "9bb577a0-cc5e-55cb-b4e9-fb72f6a4b441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471216} :answer-field/id #uuid "92f35a68-0bb5-5963-b302-95e8635c49e3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472113} {:answer-field/choices [{:answer/id #uuid "bb7d2846-5cae-5909-80f6-634c1e8c1bd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471217} {:answer/id #uuid "451e793e-944e-54e2-b7ce-7dbe24c3c6a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471218}] :answer-field/correct {:answer/id #uuid "bb7d2846-5cae-5909-80f6-634c1e8c1bd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471217} :answer-field/id #uuid "f3697cde-7282-50bb-a234-7ad409f21d0e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472114} {:answer-field/choices [{:answer/id #uuid "0283c931-eaf7-508c-a296-9ede0b8ab47d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471219} {:answer/id #uuid "dd7d6682-a379-5b3d-b0b9-2726d2b7420c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471220}] :answer-field/correct {:answer/id #uuid "dd7d6682-a379-5b3d-b0b9-2726d2b7420c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471220} :answer-field/id #uuid "17cd737d-4caf-54ba-9eeb-0b52a6df76e4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472115}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d0c05d7-b425-5e33-a2de-62cbcada849e" :question/math-academy-id "q-182247" :question/problem "Which of the following statements are true?\n- **I.** $P(P({x}))={∅,{∅},{{x}},{∅,{x}}}$\n- **II.** $P({{x}})={∅,{x}}$\n- **III.** $P({x,∅})={∅,{x},{∅},{x,∅}}$\n\nSelect all that apply." :question/worked-solution "The power set of $T,$ denoted $P(T),$ is the set that contains every possible subset of $T,$ including the empty set $∅.$\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, the power set of the set ${x}$ is ${∅,{x}}.$ Therefore, $P(P({x}))={∅,{∅},{{x}},{∅,{x}}}.$\n\n- Statement II is false. Notice that we are given the set ${{x}}.$ Then, the power set of the set ${{x}}$ is ${∅,{{x}}}.$ Therefore, $P({{x}})={∅,{{x}}}.$\n\n- Statement III is true. Notice that we are given the set ${x,∅}.$ So, its power set must be ${∅,{x},{∅},{x,∅}}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186384684 :knowledge-point/_questions [{:db/id #edb/ref 17592186157232 :knowledge-point/id #uuid "fb4d348b-1703-51a1-be05-2e66295cacaa" :knowledge-point/title "Completing Trivial Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3868de94-f40b-55e1-bdb2-a7150e6b6c40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471311} {:answer/id #uuid "631e930d-695f-5af5-aab9-dd585c953e99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471312}] :answer-field/correct {:answer/id #uuid "631e930d-695f-5af5-aab9-dd585c953e99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471312} :answer-field/id #uuid "66365a99-0b60-58bb-94f2-ccec01ad35dc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472161} {:answer-field/choices [{:answer/id #uuid "b15f1878-c363-590e-a18b-cef0bf952481" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471313} {:answer/id #uuid "e1261589-bf12-56e1-ba17-0ecce5d607fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471314}] :answer-field/correct {:answer/id #uuid "b15f1878-c363-590e-a18b-cef0bf952481" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471313} :answer-field/id #uuid "2578266a-3ab5-5ff5-8e6f-8c792ea992ef" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472162} {:answer-field/choices [{:answer/id #uuid "ed69226c-011b-5b2e-b15f-abdaa112a0e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471315} {:answer/id #uuid "25d82bff-bad4-53b1-a8f4-aac1a9c3dd94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471316}] :answer-field/correct {:answer/id #uuid "ed69226c-011b-5b2e-b15f-abdaa112a0e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471315} :answer-field/id #uuid "c7610904-dd5b-5286-aa99-f44196a2d25e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472163}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "878c8bf5-19ec-5026-9004-ee961047a572" :question/math-academy-id "q-215831" :question/problem "Let $x\\in R.$ Consider the following statement:\n\n$\\,$ If $\\sqrt{3}\\in R$, then $______.$\n\nWhich of the following could be placed into the blank space above to create a statement whose proof is trivial?\n- **I.** $R⊆R$\n- **II.** ${x}^{2}=0$\n- **III.** $\\frac{1}{2}\\in Z$\n\nSelect all that apply." :question/worked-solution "We say that an implication has a *trivial proof* if the consequent is always true:\n\n$$\nP\\,⇒\\overset{\\text{Always true}}{\\overset{⏞}{Q}}\n$$\n\nIt does not matter whether the antecedent is true or false.\n\nWith that in mind, let's examine our consequents in turn.\n\n- Statement I is always true. $\\,✓$\n\n- Predicate II, defined for $x\\in R,$ is *not* always true. $\\,\\times $\n\n- Statement III is always false. $\\,\\times $\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186384691 :knowledge-point/_questions [{:db/id #edb/ref 17592186157232 :knowledge-point/id #uuid "fb4d348b-1703-51a1-be05-2e66295cacaa" :knowledge-point/title "Completing Trivial Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf9e4aa9-8e45-51b3-b3b8-086dc158a25a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471317} {:answer/id #uuid "1dec0be7-4806-59e3-98b0-14968d4a61d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471318}] :answer-field/correct {:answer/id #uuid "bf9e4aa9-8e45-51b3-b3b8-086dc158a25a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471317} :answer-field/id #uuid "848d2e24-735f-5301-9b27-a19033fd2df7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472164} {:answer-field/choices [{:answer/id #uuid "1c955bf8-730b-5d76-a57b-8e87b63787ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471319} {:answer/id #uuid "ae2d9626-802f-5ad4-ba44-11f523f067d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471320}] :answer-field/correct {:answer/id #uuid "ae2d9626-802f-5ad4-ba44-11f523f067d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471320} :answer-field/id #uuid "f74f6912-6c8b-56fe-a2d2-b4e096630c6c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472165} {:answer-field/choices [{:answer/id #uuid "c54f76f8-6e8d-5829-92cc-9f289a4f3310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471321} {:answer/id #uuid "6024c44b-1400-5ac4-821d-8a05f32542f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186471322}] :answer-field/correct {:answer/id #uuid "c54f76f8-6e8d-5829-92cc-9f289a4f3310" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186471321} :answer-field/id #uuid "fa3b09fe-6ba9-5625-9ccb-be0c318bab25" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186472166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e845f2cc-dfb4-5e80-9c1e-ef0b2c43bf19" :question/math-academy-id "q-216029" :question/problem "Let $n\\in Z.$ Consider the following statement:\n\n$\\,$ If $\\frac{n}{2}\\in Z,$ then $______.$\n\nWhich of the following could be placed into the blank space above to create a statement whose proof is trivial?\n- **I.** $n$ is even\n- **II.** $1-{n}^{2}<2$\n- **III.** $1<n<2$\n\nSelect all that apply." :question/worked-solution "We say that an implication has a *trivial proof* if the consequent is always true:\n\n$$\nP\\,⇒\\overset{\\text{Always true}}{\\overset{⏞}{Q}}\n$$\n\nIt does not matter whether the antecedent is true or false.\n\nWith that in mind, let's examine our consequents in turn.\n\n- Predicate I, defined for $n\\in Z,$ is *not* always true. $\\,\\times $\n\n- Predicate II, defined for $n\\in Z,$ is always true. $\\,✓$\n\n- Predicate III, defined for $n\\in Z,$ is always false. $\\,\\times $\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186384698 :knowledge-point/_questions [{:db/id #edb/ref 17592186157232 :knowledge-point/id #uuid "fb4d348b-1703-51