db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470731} :answer-field/id #uuid "89a40edf-a784-5d5e-b7b3-d87244e5ed3f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15ff4cc7-7dbb-588f-ad41-efc18bba219b" :question/math-academy-id "q-104997" :question/problem "Which of the following functions are surjections?\n- **I.** $g:Q\\to R$ defined by $g(x)=\\sqrt{x}$\n- **II.** $h:R\\to R$ defined by $h(x)=-{x}^{3}$\n- **III.** $f:(0,\\infty )\\to R$ defined by $f(x)={x}^{2}+x$\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose ${2}^{1/4}\\in R.$ There is no number $x\\in Q$ such that $g(x)={2}^{1/4}.$ The only number $x$ that satisfies $g(x)=\\sqrt{x}={2}^{1/4}$ is $x=\\sqrt{2}\\notin Q.$\n\n- II is a surjection. Given $y\\in R,$ choose $x=-\\sqrt[3]{y}\\in R.$ Then $h(x)=h(-\\sqrt[3]{y})=-{(-\\sqrt[3]{y})}^{3}=y.$\n\n- III is *not* a surjection. As a counterexample, choose $-1\\in R.$ There is no number $x\\in (0,\\infty )$ such that $f(x)=-1.$ In fact ${x}^{2}+x>0$ for all $x\\in (0,\\infty ).$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186380469 :knowledge-point/_questions [{:db/id #edb/ref 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb7dc971-8401-5ae8-8f9d-8ff26ade4f2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470733} {:answer/id #uuid "ac4b54bc-24f7-5628-bf9d-d2d8066021f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470734}] :answer-field/correct {:answer/id #uuid "eb7dc971-8401-5ae8-8f9d-8ff26ade4f2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470733} :answer-field/id #uuid "c2d7f990-5176-5704-a3ae-0d8c1d46c98e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471872} {:answer-field/choices [{:answer/id #uuid "1a599ab7-32cc-5a74-afab-f09a84f10810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470735} {:answer/id #uuid "9334d483-6c0f-52c7-9c06-d63ad1d7cc3d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470736}] :answer-field/correct {:answer/id #uuid "1a599ab7-32cc-5a74-afab-f09a84f10810" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470735} :answer-field/id #uuid "d5a229e5-041e-548e-9ea1-72a726e5be09" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471873} {:answer-field/choices [{:answer/id #uuid "f32c90c8-80f0-5404-a0c0-a82a4dd1b4b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470737} {:answer/id #uuid "43075b7e-c98d-5aa0-836a-56a183affa6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470738}] :answer-field/correct {:answer/id #uuid "43075b7e-c98d-5aa0-836a-56a183affa6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470738} :answer-field/id #uuid "a410bc65-9e6b-550f-8b14-0dc7cc51baa2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471874}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "170d4c2a-1e31-530e-82ce-91551c575c42" :question/math-academy-id "q-104999" :question/problem "Which of the following functions are surjections?\n- **I.** $f:{-1,0,1,2}\\to {-1,0,1,2,3}$ defined by $f(x)={x}^{2}-1$\n- **II.** $g:(-\\frac{\\pi }{2},\\frac{\\pi }{2})\\to R$ defined by $g(x)=\\operatorname{sin}⁡x$\n- **III.** $h:[0,\\infty )\\to [0,\\infty )$ defined by $h(x)=\\sqrt{x}$\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose $2\\in {-1,0,1,2,3}.$ There is no number $x\\in {-1,0,1,2}$ such that $f(x)=2.$ The only number $x$ that satisfies $f(x)={x}^{2}-1=2$ is $x=\\sqrt{3},$ but $\\sqrt{3}\\notin {-1,0,1,2}.$\n\n- II is *not* a surjection. As a counterexample, choose $2\\in R.$ There is no number $x\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2})$ such that $g(x)=2.$ In fact, $-1\\le \\operatorname{sin}⁡x\\le 1$ for all $x\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\n- III is a surjection. Given $y\\in [0,\\infty ),$ choose $x={y}^{2}\\in [0,\\infty ).$ Then $h(x)=h({y}^{2})=\\sqrt{{y}^{2}}=y.$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186380476 :knowledge-point/_questions [{:db/id #edb/ref 17592186152135 :knowledge-point/id #uuid "6fa67074-d3c8-5000-95a3-7f935936ab7d" :knowledge-point/title "Identifying Surjections For Functions Defined Algebraically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e1bd008e-fd90-5929-a46b-6eb5beefcf10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470739} {:answer/id #uuid "a4302cb4-89bd-5838-82c6-54ec4d904125" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470740}] :answer-field/correct {:answer/id #uuid "e1bd008e-fd90-5929-a46b-6eb5beefcf10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470739} :answer-field/id #uuid "806ec7fd-4808-5b1f-9bc9-aa801152594b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471875} {:answer-field/choices [{:answer/id #uuid "6d947b90-c9f9-5b87-b476-531e2de7c036" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470741} {:answer/id #uuid "e7cbdb42-ea2d-50f7-a2c9-539988ff5afb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470742}] :answer-field/correct {:answer/id #uuid "e7cbdb42-ea2d-50f7-a2c9-539988ff5afb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470742} :answer-field/id #uuid "1afcd50a-823a-56e2-8dcb-713488e671e9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471876} {:answer-field/choices [{:answer/id #uuid "e92bf178-2e1f-5a97-9b3f-4a1be5819ee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470743} {:answer/id #uuid "1923c438-362f-5cba-a242-95e01f945007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470744}] :answer-field/correct {:answer/id #uuid "1923c438-362f-5cba-a242-95e01f945007" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470744} :answer-field/id #uuid "299a7061-4cf4-563c-a7fb-eff7917215c1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471877}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8d8dd107-bc43-5af5-9ea8-482dedecfe3d" :question/math-academy-id "q-105006" :question/problem "Which of the following functions are surjections?\n- **I.** $f:{1,2,4,8}\\to {-1,0,1,2,3}$ defined by $f(x)={log}_{2}⁡x$\n- **II.** $g:(0,\\infty )\\to R$ defined by $g(x)=\\operatorname{log}⁡x$\n- **III.** $h:{-2,-1,0,1,2}\\to {0,1,2}$ defined by $h(x)=|x|$\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is a **surjection** (also known as **onto**) if, for *every* element $y$ in $Y,$ there is at least one element in $X$ that maps to $y.$ \n\nSymbolically, we can write:\n\n$f:X\\to Y$ is a surjection if $∀\\,y\\in Y,$ $∃\\,x\\in X$ such that $f(x)=y.$\n\nWith this in mind, let's check each function.\n\n- I is *not* a surjection. As a counterexample, choose $-1$ from the range. The only number $x$ that satisfies $f(x)={log}_{2}⁡x=-1$ is $x=\\frac{1}{2},$ but $\\frac{1}{2}\\notin {1,2,4,8}.$\n\n- II is a surjection. Given $y\\in R,$ choose $x={10}^{y}\\in (0,\\infty ).$ Then $g(x)=g({10}^{y})=\\operatorname{log}⁡{10}^{y}=y.$\n\n- III is a surjection. Indeed, $h(-2)=2,$ $h(-1)=1$ and $h(0)=0.$ So, for every $y\\in {0,1,2},$ there exists an element $x\\in {-2,-1,0,1,2}$ such that $h(x)=y.$\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186380483 :knowledge-point/_questions [{:db/id #edb/ref 17592186152194 :knowledge-point/id #uuid "c805415f-c87d-50c5-b668-948fc46bcc7e" :knowledge-point/title "Identifying Injections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff3a2451-ad28-5277-b29c-8baa08a2ec35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470745} {:answer/id #uuid "c4d64ba3-bc08-54e1-acfb-68d6bb886ed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470746}] :answer-field/correct {:answer/id #uuid "c4d64ba3-bc08-54e1-acfb-68d6bb886ed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470746} :answer-field/id #uuid "3b455582-24f8-52cd-b248-73e9c3956c5e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471878} {:answer-field/choices [{:answer/id #uuid "9ceb9237-f718-5245-af0b-bb74de28bbde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470747} {:answer/id #uuid "833259ed-49af-520f-8d65-45459eeed7f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470748}] :answer-field/correct {:answer/id #uuid "9ceb9237-f718-5245-af0b-bb74de28bbde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470747} :answer-field/id #uuid "d6154d73-9a14-5abd-a930-2ee86c7146af" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471879} {:answer-field/choices [{:answer/id #uuid "5b4f890e-28e4-570b-90e7-0a6347cba161" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470749} {:answer/id #uuid "90d84539-f9a1-557e-b54a-8913db774a14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470750}] :answer-field/correct {:answer/id #uuid "90d84539-f9a1-557e-b54a-8913db774a14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470750} :answer-field/id #uuid "fa4c9580-fdbb-595b-a6f8-523dead8913d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b06d538-7443-54c1-b503-59c054bf5bb2" :question/math-academy-id "q-105118" :question/problem "![](images/26/26ec4cb2ec851e6a1b6d7f0ad99b0a49bf36f95d3c110d3777ca8e4a92177057.png)\n\nWhich of the following statements are true regarding the function $f:X\\to Y$ represented by the mapping diagram above?\n\n- $f(1)=f(4)$\n- $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}$\n- $f$ is not an injection\n\nSelect all that apply." :question/worked-solution "A function $f:X\\to Y$ is an injection (also known as *one-to-one*) if *every* element in $X$ is mapped to a *distinct* element in $Y:$ \n\n$f:X\\to Y$ is an injection if $∀\\,{x}_{1},{x}_{2}\\in X,$ if $f({x}_{1})=f({x}_{2}),$ we have ${x}_{1}={x}_{2}.$\n\nWith that in mind, let's consider each statement in turn.\n\n- Statement I is true. According to the diagram, we have $f(1)=f(4)=4$ (we have arrows from $1\\in X$ and $4\\in X$ to $4\\in Y$).\n\n- Statement II is false. Again, we have $f(1)=f(4)$ but $1\\ne 4.$ So, it's *not true* that for all ${x}_{1}$ and ${x}_{2}$ contained within the domain $X,$ if $f({x}_{1})$ and $f({x}_{2})$ are equal, then we must have ${x}_{1}={x}_{2}.$\n\n- Statement III is true. Indeed, since statement II is false, $f$ is not an injection.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186380490 :knowledge-point/_questions [{:db/id #edb/ref 17592186152194 :knowledge-point/id #uuid "c805415f-c87d-50c5-b668-948fc46bcc7e" :knowledge-point/title "Identifying Injections For Functions Defined as Mapping Diagrams"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d30373bc-0f58-5aa4-ab02-706201975694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470751} {:answer/id #uuid "074efd01-d836-56af-98d7-2b90bb10e0ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470752}] :answer-field/correct {:answer/id #uuid "d30373bc-0f58-5aa4-ab02-706201975694" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470751} :answer-field/id #uuid "d19ae813-3712-5e18-86c8-caac6c8cf0bc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186471881} {:answer-field/choices [{:answer/id #uuid "44cc1969-0a93-511c-8c1d-4e9c43fe55d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470753} {:answer/id #uuid "cb8c72f9-baff-5b35-9789-03e381c26ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186470754}] :answer-field/correct {:answer/id #uuid "44cc1969-0a93-511c-8c1d-4e9c43fe55d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186470753} :answer-field/id #uuid "6c3ed506-cdfa-5876-9ce2-77809d5158ef" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/