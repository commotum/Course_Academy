d}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(2,-4)$, $(12,-24)$ and $(-8,16).$ \n\nSo, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186275182 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f321f61-74c6-5dff-b09d-2abe37e72619" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186272808} {:answer/id #uuid "4307e2d9-4613-5d6e-b78d-f4fecf5b92be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186272962} {:answer/id #uuid "8cbcd9be-0bf7-5534-90a7-bf6e540c6780" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186273603} {:answer/id #uuid "8fb1720f-8157-51df-b896-24cdcc4ce8a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273635} {:answer/id #uuid "ad2f6384-470d-5fe4-b9bf-d347475094a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273881}] :answer-field/correct {:answer/id #uuid "8fb1720f-8157-51df-b896-24cdcc4ce8a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273635} :answer-field/id #uuid "2997beda-2cd1-5e7a-b7a5-3c7e0c5e99fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274706}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "84f6bd2a-70dc-5d