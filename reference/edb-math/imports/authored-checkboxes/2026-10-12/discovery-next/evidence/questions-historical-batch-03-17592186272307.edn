ref 17592186273405} {:answer/id #uuid "785c15f9-6b2f-588e-be26-6edcbac1c3ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273412} {:answer/id #uuid "882d6e01-b6f1-53ca-8fa3-80e4758780fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273556} {:answer/id #uuid "de796833-caf3-5dc1-9cf6-b2448a158825" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186274346}] :answer-field/correct {:answer/id #uuid "de796833-caf3-5dc1-9cf6-b2448a158825" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186274346} :answer-field/id #uuid "d5947aea-674a-54d3-b514-a907a48356ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275012}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d122f7d-248a-5adb-b7f8-d6731998c545" :question/math-academy-id "q-147666" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,3)$, $(-2,0)$ and $(2,-1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(8,-16)$\n- $(-6,12)$\n- $(8,16)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & -2 & 2 \\\\ 3 & 0 & -1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & -2 \\\\ -6 & 4\\end{aligned}][\\begin{aligned}1 & -2 & 2 \\\\ 3 & 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -6 & 8 \\\\ 6 & 12 & -16\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-3,6)$, $(-6,12)$ and $(8,-16).$ \n\nSo, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186275180 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34cb736e-820b-5e02-a62e-902679d92d0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186272856} {:answer/id #uuid "4da26ecd-6765-5807-9b28-42a06ba51d9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273037} {:answer/id #uuid "8a5d207f-b418-5c11-b6a0-6885305c462d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186273579} {:answer/id #uuid "902e01d1-3857-5bca-8910-96c51cb33de7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273640} {:answer/id #uuid "f66a5755-7ccd-5ea9-b832-c0de6bea6857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186274553}] :answer-field/correct {:answer/id #uuid "902e01d1-3857-5bca-8910-96c51cb33de7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273640} :answer-field/id #uuid "fd32ee0b-f7f2-5fcc-879b-ac176d9d8123" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1bd0a07c-db54-5589-8d88-4cb094a8efc3" :question/math-academy-id "q-147667" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 5 \\\\ 2 & -10\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(1,-1)$, $(1,0)$ and $(-2,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$ \n\n- $(-1,2)$\n- $(-3,12)$\n- $(7,-12)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & 5 \\\\ 2 & -10\\end{aligned}][\\begin{aligned}1 & 1 & -2 \\\\ -1 & 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-6 & -1 & 7 \\\\ 12 & 2 & -14\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-6,12)$, $(-1,2)$ and $(7,-14).$ \n\nSo, the correct answer is \"I  only.\""}] [{:db/id #edb/ref 17592186275181 :knowledge-point/_questions [{:db/id #edb/ref 17592186105893 :knowledge-point/id #uuid "ca93cd65-65e3-521e-a1e3-2721f45fb6a6" :knowledge-point/title "Calculating the Coordinates of an Image Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85a7aee6-c66f-51b4-b82b-65c0708d3229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273536} {:answer/id #uuid "8d3f1a32-56a1-5b37-b12f-885c47e7cd18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186273605} {:answer/id #uuid "a94a88f0-4d47-54fd-a8d2-e301e230c06b" :answer/type {:db