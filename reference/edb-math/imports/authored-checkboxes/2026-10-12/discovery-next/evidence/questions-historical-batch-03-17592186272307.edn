#{[{:db/id #edb/ref 17592186272307 :knowledge-point/_questions [{:db/id #edb/ref 17592186064312 :knowledge-point/id #uuid "3bd5c660-b216-59b4-b2bb-df83ef864b2a" :knowledge-point/title "Determining Concave Up and Concave Down Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5177ea3a-9272-590f-8f16-d605b524db47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186269998} {:answer/id #uuid "5c3a782a-c7a0-5f39-9b30-7e1f9ae49e1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186270090} {:answer/id #uuid "7cc2623b-ee3b-5cc2-863d-41dcce18a077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186270363} {:answer/id #uuid "a640d8d9-7217-514b-aa3a-b01bab9dbd46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186270757} {:answer/id #uuid "be7733e3-82d9-51c4-9a92-5cf1de7b00b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186270951}] :answer-field/correct {:answer/id #uuid "7cc2623b-ee3b-5cc2-863d-41dcce18a077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186270363} :answer-field/id #uuid "6372289f-4413-56d4-a466-f00fa976e952" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "13227862-4183-5d5b-b484-99ef3e29fd6b" :question/math-academy-id "q-141754" :question/problem "![](images/b2/b2b904027ec6319fe5857f81089469568322d148e49cdf31bb20c07f1f31daf4.png)\n\nWhich of the curves above are concave down?" :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nAll graphs I, II, and III curve downward (like a \"frown\") among the given graphs."}] [{:db/id #edb/ref 17592186272338 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21c27800-0300-5249-b4a0-b6e008f8e83d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186269558} {:answer/id #uuid "44d71b0a-4454-5106-ad0c-ed629eabb1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186269900} {:answer/id #uuid "708d14c2-579e-5e65-9cd2-447b05f510fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186270265} {:answer/id #uuid "a29c9c7d-1f79-5b6d-b1d6-1b0537c578cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186270720} {:answer/id #uuid "f7830376-f651-56ea-b56d-c7df40cee1ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186271439}] :answer-field/correct {:answer/id #uuid "44d71b0a-4454-5106-ad0c-ed629eabb1a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186269900} :answer-field/id #uuid "b3f46adb-5d16-505a-be52-2235f2f08ca3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271839}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c320bbb-0961-56b0-99e4-beaa75aa8f10" :question/math-academy-id "q-142358" :question/problem "Which of the following statements are true, given that $A$ is a $5\\times 5$ matrix and \n\n$$\n\\text{Null}(A)={[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ 0 \\\\ 2{x}_{2} \\\\ {x}_{1}\\end{aligned}]\\,|\\,{x}_{1},{x}_{2}\\in R}?\n$$\n\n- $\\text{dim(Null}(A))=0$\n- $A$ is  invertible\n- $\\text{Col}(A)\\ne {R}^{5}$" :question/worked-solution "Since $A$ is a $5\\times 5$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{5} \\\\  & \\text{dim(Col}(A))=5=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since \n\n$$\n\\text{Null}(A)={{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ 0 \\\\ 1\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ 0 \\\\ 2 \\\\ 0\\end{aligned}]\\,|\\,{x}_{1},{x}_{2}\\in R}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=2\\ne 0.\n$$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{Col}(A)\\ne {R}^{5}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186272348 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ccbab42-afa2-5f66-ac0e-c308c66e8202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186269668} {:answer/id #uuid "82c7cc8b-3d11-56b8-a528-bbb1a33f1d5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186270399} {:answer/id #uuid "952d8149-19cf-533c-af96-872b8df55506" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186270576} {:answer/id #uuid "d8826fb6-eeca-5b0d-8d8b-f2147e992c35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186271170} {:answer/id #uuid "e2d12440-aa2a-5690-b9a2-07e79a593ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186271262}] :answer-field/correct {:answer/id #uuid "e2d12440-aa2a-5690-b9a2-07e79a593ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186271262} :answer-field/id #uuid "10bb68a7-51a0-5f0c-b2b1-a21badc3475a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271534}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "795129ab-7204-5692-a97c-e32525213e2a" :question/math-academy-id "q-142475" :question/problem "Consider the following sentence:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then  $\\text{__________}\\,.$*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\n- $A$ is invertible\n- $\\text{rank}(A)<n$\n- $\\text{Col}(A)={R}^{n}$" :question/worked-solution "The invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,{\\,\\begin{aligned} & \\text{Col}(A)={R}^{n} \\\\  & \\text{dim(Col}(A))=n=\\text{rank}(A) \\\\  & \\text{Null}(A)={0} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $A$ is invertible.* $\\,✓$ \n\nIndeed, according to the invertible matrix theorem, \n\n$A$ is invertible $\\,⇔\\,\\text{dim(Null}(A))=0=\\text{nullity}(A).$\n\n- The following statement is false:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{rank}(A)<n.$* $\\,\\times $ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{rank}(A)=n.$\n\n- The following statement is true:\n\n*If $A$ is a $n\\times n$ matrix and $\\text{nullity}(A)=0,$ then $\\text{Col}(A)={R}^{n}.$*  $\\,✓$ \n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{Col}(A)={R}^{n}.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186272349 :knowledge-point/_questions [{:db/id #edb/ref 17592186124629 :knowledge-point/id #uuid "bb90e5b9-03fe-51cf-bc16-a293befacebc" :knowledge-point/title "Сompleting a Sentence Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0895ab25-c3a3-5de5-8c7f-b29240d396fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186269347} {:answer/id #uuid "70dbe989-e5af-54e0-b64e-b2b8f149ec2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186270271} {:answer/id #uuid "8abda789-acc5-5411-8952-794fc73da646" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186270468} {:answer/id #uuid "a4e8d21b-4e62-5248-a3d7-8afaad5786f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186270745} {:answer/id #uuid "be53ddb2-3789-59ea-8a22-87a097d55924" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186270949}] :answer-field/correct {:answer/id #uuid "0895ab25-c3a3-5de5-8c7f-b29240d396fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186269347} :answer-field/id #uuid "afe26b88-241f-530c-8ccf-982cdb7e7d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271828}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7036dc73-9ca4-59f2-b983-11eaacfb5a4b" :question/math-academy-id "q-142476" :question/problem "Consider the following sentence:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then $\\text{__________}$ .*\n\nWhich of the following can be placed into the blank space to make a true statement?\n\nI. $det(A)=0$\n\nII. $\\text{Col}(A)={R}^{16}$\n\nIII. $A$ has $8$ pivot columns" :question/worked-solution "If $A$ is an $8\\times 8$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{8} \\\\  & \\text{dim(Col}(A))=8=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each of the options separately.\n\n- The following statement is false:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then $det(A)=0$* $\\,\\times $  \n\nSince the matrix $A$ is invertible, it must be  $det(A)\\ne 0.$\n\n- The following statement is false:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then  $\\text{Col}(A)={R}^{16}.$*  $\\,\\times $\n\nIndeed, since $A$ is invertible, then according to the invertible matrix theorem,  we have $\\text{Col}(A)={R}^{8}.$\n\n- The following statement is true:\n\n*If $A$ is a $8\\times 8$ matrix and $A$ is invertible,  then $A$ has $8$ pivot columns.* $\\,✓$ \n\nSince $A$ is invertible, then according to the invertible matrix theorem, we have $\\text{dim(Col}(A))=8,$ which means that $A$ has exactly $8$ pivot columns.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186275088 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca6964b-f001-50a6-962e-37568669ccd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186272499} {:answer/id #uuid "38adbd90-9f47-5cfa-b9c1-7dcb290c0580" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186272883} {:answer/id #uuid "759af798-3374-5082-9e33-2c081c92dd51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273389} {:answer/id #uuid "c73c83bf-34b1-563e-83a1-c83796722f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186274119} {:answer/id #uuid "fa69b46f-7365-5071-aefe-c9610d1635b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186274583}] :answer-field/correct {:answer/id #uuid "c73c83bf-34b1-563e-83a1-c83796722f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186274119} :answer-field/id #uuid "6c232438-e4d9-548e-93c1-3bdeab4b5cac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274818}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6378e369-5031-5af4-8366-576c75d82fa3" :question/math-academy-id "q-143001" :question/problem "![](images/67/67706db50684aef52269d20065caa21e4301834835e10e1fd3e456646ae2b32e.png)\n\nIn figure $ABCDEF$ shown above, which of the following are equal to the vector $\\overset{\\to }{DF}?$\n\nI. $\\overset{\\to }{DC}+\\overset{\\to }{CB}+\\overset{\\to }{BF}$\n\nII. $\\overset{\\to }{FB}-\\overset{\\to }{DB}$\n\nIII. $\\overset{\\to }{DE}+\\overset{\\to }{EF}$" :question/worked-solution "- For the $1$st expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DC}+\\overset{\\to }{CB}+\\overset{\\to }{BF} & =(\\overset{\\to }{DC}+\\overset{\\to }{CB})+\\overset{\\to }{BF} \\\\  & =\\overset{\\to }{DB}+\\overset{\\to }{BF} \\\\  & =\\overset{\\to }{DF}\\,✓\\end{aligned}\n$$\n\n- For the $2$nd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{FB}-\\overset{\\to }{DB} & =\\overset{\\to }{FB}+\\overset{\\to }{BD} \\\\  & =\\overset{\\to }{FD} \\\\  & \\ne \\overset{\\to }{DF}\\,\\times \\end{aligned}\n$$\n\n- For the $3$rd expression, we have:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}+\\overset{\\to }{EF} & =\\overset{\\to }{DF}\\,✓\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186275089 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "039f4640-df8c-5f58-8473-a42a9d3b80e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186272417} {:answer/id #uuid "4dffa4f0-5259-5130-adb8-cb6e99c26fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273042} {:answer/id #uuid "5a2716f3-ecca-55e3-979f-f0158825f290" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186273160} {:answer/id #uuid "c042c4d0-435e-5e30-98e5-20c5ed9387ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186274051} {:answer/id #uuid "dcb3ddd5-6976-5815-aaaa-8715e648bc5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186274327}] :answer-field/correct {:answer/id #uuid "c042c4d0-435e-5e30-98e5-20c5ed9387ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186274051} :answer-field/id #uuid "e1ed2a0e-62c9-5160-8b40-423a8e0dfc90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275030}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32cdac5a-ca17-59c1-8641-8b3b47e09944" :question/math-academy-id "q-143006" :question/problem "![](images/15/15f4bd7f8ecf8f61ce84858e33cdfa468b0de360fac19b0713b6b2dbc4af8d2e.png)\n\nIn figure $ABCDEF$ shown above, which of the following equalities are true?\n\n- $\\overset{\\to }{AB}-\\overset{\\to }{AF}=\\overset{\\to }{BF}$\n- $\\overset{\\to }{DE}+\\overset{\\to }{EA}-\\overset{\\to }{BA}=\\overset{\\to }{DB}$\n- $\\overset{\\to }{BE}-\\overset{\\to }{DE}-\\overset{\\to }{CD}=\\overset{\\to }{CB}$" :question/worked-solution "- Equality I is false. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB}-\\overset{\\to }{AF} & =\\overset{\\to }{AB}+\\overset{\\to }{FA} \\\\  & =\\overset{\\to }{FB} \\\\  & \\ne \\overset{\\to }{BF}.\\end{aligned}\n$$\n\n- Equality II is true. Indeed, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE}+\\overset{\\to }{EA}-\\overset{\\to }{BA} & =\\overset{\\to }{DE}+(\\overset{\\to }{EA}+\\overset{\\to }{AB}) \\\\  & =\\overset{\\to }{DE}+\\overset{\\to }{EB} \\\\  & =\\overset{\\to }{DB}.\\end{aligned}\n$$\n\n- Equality III is false. Indeed,\n\n$$\n\\begin{aligned}\\overset{\\to }{BE}-\\overset{\\to }{DE}-\\overset{\\to }{CD} & =(\\overset{\\to }{BE}+\\overset{\\to }{ED})+\\overset{\\to }{DC} \\\\  & =\\overset{\\to }{BD}+\\overset{\\to }{DC} \\\\  & =\\overset{\\to }{BC} \\\\  & \\ne \\overset{\\to }{CB}.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186275114 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "025d6b48-01e5-5f01-8d65-c71247ac2c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186272402} {:answer/id #uuid "33299f41-5d8f-547d-ad5c-48ed2d2cc7f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186272842} {:answer/id #uuid "4db325db-0d80-5c94-8d47-63cd60da22e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186273039} {:answer/id #uuid "b708c468-1a5f-5884-843d-d4de1dfc18a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273974} {:answer/id #uuid "dbc201f5-22fa-5ca2-81f0-aa15cf93f039" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186274314}] :answer-field/correct {:answer/id #uuid "b708c468-1a5f-5884-843d-d4de1dfc18a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273974} :answer-field/id #uuid "3bc06cb9-a10b-5ac4-80d0-be2806f417c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274738}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a347e7c2-3db8-5058-926f-eeec20d91744" :question/math-academy-id "q-143331" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.6$ | $0.2$ |\n| $X=2$ | $0.15$ | $0.05$ |\n\nWhich of the following statements are true?\n\n- $P(X=2,Y=1)=P(X=2)\\cdot P(Y=1)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.6$ | $0.2$ | $0.8$ |\n| $X=2$ | $0.15$ | $0.05$ | $0.2$ |\n| ${f}_{Y}$ | $0.75$ | $0.25$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=2,Y=1)=f(2,1)=0.15.$ On the other hand, \n\n$$\nP(X=2)\\cdot P(Y=1)={f}_{X}(2)\\cdot {f}_{Y}(1)=0.2\\cdot 0.75=0.15.\\,✓\n$$\n\n- Statement II is true. Checking all other possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(1,1) & =0.6=0.8\\cdot 0.75={f}_{X}(1)\\cdot {f}_{Y}(1) & ✓ \\\\ f(1,2) & =0.2=0.8\\cdot 0.25={f}_{X}(1)\\cdot {f}_{Y}(2) & ✓ \\\\ f(2,2) & =0.05=0.2\\cdot 0.25={f}_{X}(2)\\cdot {f}_{Y}(2) & ✓\\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is true. Since statement II is true, our random variables $X$ and $Y$ must be independent.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186275115 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb511a6-9e3f-5fab-80ba-b266dbff4317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186272500} {:answer/id #uuid "0f80c1c4-b8b0-5d20-8f58-ee939af16ade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186272524} {:answer/id #uuid "8e4845ad-be2d-5904-9060-d4ff681ee8d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273616} {:answer/id #uuid "baf4e5bc-43d2-59fe-b996-7b9f861daebb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186274009} {:answer/id #uuid "fda572d8-a7cb-50d0-afbf-d1498df635a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186274618}] :answer-field/correct {:answer/id #uuid "0cb511a6-9e3f-5fab-80ba-b266dbff4317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186272500} :answer-field/id #uuid "a47cbf0e-0dfc-5b44-a81b-f3239de9f23e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274922}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e48e8cd-fab9-56d8-9673-3c5737feeff5" :question/math-academy-id "q-143333" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.3$ | $0.2$ |\n| $X=2$ | $0.1$ | $0.4$ |\n\nWhich of the following statements are true?\n\n- $P(X=2,Y=2)=P(X=2)\\cdot P(Y=2)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=2$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.3$ | $0.2$ | $0.5$ |\n| $X=2$ | $0.1$ | $0.4$ | $0.5$ |\n| ${f}_{Y}$ | $0.4$ | $0.6$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statements I and II are false. From the table, we obtain that $P(X=2,Y=2)=f(2,2)=0.4.$ However, \n\n$$\nP(X=2)\\cdot P(Y=2)={f}_{X}(2)\\cdot {f}_{Y}(2)=0.5\\cdot 0.6=0.3.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=2,Y=2)\\ne P(X=2)\\cdot P(Y=2),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of those listed.\""}] [{:db/id #edb/ref 17592186275116 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0546ac24-d2f1-5953-9176-6d38e1f738e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186272437} {:answer/id #uuid "36567941-4a76-538e-b399-81b828902e4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186272866} {:answer/id #uuid "adcc90b9-7b62-57f4-b547-8bcf79edd9d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273886} {:answer/id #uuid "d1b0d5ca-bc00-5e71-b084-1b238b1ba8f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186274219} {:answer/id #uuid "f2536e7d-d2f7-5f66-9627-aed4d7e02129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186274528}] :answer-field/correct {:answer/id #uuid "36567941-4a76-538e-b399-81b828902e4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186272866} :answer-field/id #uuid "96723ab9-6095-5228-8b7f-012e24dab80f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274896}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "16b71f57-df8c-5727-afc2-cdadae9185c5" :question/math-academy-id "q-143334" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=1$ | $Y=3$ |\n| --- | --- | --- |\n| $X=0$ | $0.1$ | $0.15$ |\n| $X=2$ | $0.6$ | $0.15$ |\n\nWhich of the following statements are true?\n\n- $P(X=0,Y=3)=P(X=0)\\cdot P(Y=3)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=1$ | $Y=3$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.15$ | $0.25$ |\n| $X=2$ | $0.6$ | $0.15$ | $0.75$ |\n| ${f}_{Y}$ | $0.7$ | $0.3$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statements I and II are false. From the table, we obtain that $P(X=0,Y=3)=f(0,3)=0.15.$ However, \n\n$$\nP(X=0)\\cdot P(Y=3)={f}_{X}(0)\\cdot {f}_{Y}(3)=0.25\\cdot 0.3=0.075.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=0,Y=3)\\ne P(X=0)\\cdot P(Y=3),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of those listed.\""}] [{:db/id #edb/ref 17592186275117 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a8f8d7-4d6f-5a08-8231-327845ba4d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186272758} {:answer/id #uuid "610da49c-8865-5852-b87b-a49c0a223ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273227} {:answer/id #uuid "87a51537-6779-5081-93a5-5585b9685064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186273549} {:answer/id #uuid "cef4a47c-100b-5941-af4b-e9103ef31cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186274188} {:answer/id #uuid "f8ec2394-8af4-54b2-b440-029010d2bb5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186274568}] :answer-field/correct {:answer/id #uuid "29a8f8d7-4d6f-5a08-8231-327845ba4d85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186272758} :answer-field/id #uuid "3a58c3f2-6a19-560b-9e61-46106b8cc5d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274737}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "743eb09d-bf29-57ce-b05b-46da6dccd3f5" :question/math-academy-id "q-143338" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ are given below. \n\n| $f$ | $Y=2$ | $Y=4$ | $Y=6$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.16$ | $0.01$ | $0.03$ |\n| $X=3$ | $0.64$ | $0.09$ | $0.07$ |\n\nWhich of the following statements are true?\n\n- $P(X=3,Y=2)=P(X=3)\\cdot P(Y=2)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=2$ | $Y=4$ | $Y=6$ | ${f}_{X}$ |\n| --- | --- | --- | --- | --- |\n| $X=1$ | $0.16$ | $0.01$ | $0.03$ | $0.2$ |\n| $X=3$ | $0.64$ | $0.09$ | $0.07$ | $0.8$ |\n| ${f}_{Y}$ | $0.8$ | $0.1$ | $0.1$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. From the table, we obtain that $P(X=3,Y=2)=f(3,2)=0.64.$ On the other hand, \n\n$$\nP(X=3)\\cdot P(Y=2)={f}_{X}(3)\\cdot {f}_{Y}(2)=0.8\\cdot 0.8=0.64.\\,✓\n$$\n\n- Statement II is false. Checking some possible products, we obtain the following:\n\n$$\n\\begin{aligned}f(1,2) & =0.16=0.2\\cdot 0.8={f}_{X}(1)\\cdot {f}_{Y}(2) & ✓ \\\\ f(1,4) & =0.01\\ne 0.2\\cdot 0.1={f}_{X}(1)\\cdot {f}_{Y}(4) & \\times \\end{aligned}\n$$\n\nSo, $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186275118 :knowledge-point/_questions [{:db/id #edb/ref 17592186162153 :knowledge-point/id #uuid "196e7d31-5af8-5c82-b2bd-0cf1ed7415e2" :knowledge-point/title "Determining Whether Two Random Variables are Independent Given the Joint PMF Only"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bb620a-f093-5caa-b1a9-20fc5f8cfee9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186272687} {:answer/id #uuid "80870de8-5e3b-5b1b-9028-7729c2eaea11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273489} {:answer/id #uuid "8c12813a-38d4-579d-a916-788bd5895610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186273595} {:answer/id #uuid "91d2a50b-e57c-5a57-b276-1c5c736e21b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273655} {:answer/id #uuid "e56b3679-73df-5047-b9c4-e444f35afcad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186274413}] :answer-field/correct {:answer/id #uuid "8c12813a-38d4-579d-a916-788bd5895610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186273595} :answer-field/id #uuid "1956cca5-6b5f-5c1b-a8aa-e051fe415e86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274681}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d571385e-cc3b-5950-8471-24ba60f93b53" :question/math-academy-id "q-143435" :question/problem "The joint probability distribution $f(x,y)$ of the discrete random variables $X$ and $Y$ is given below. \n\n| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.1$ | $0.6$ |\n| $X=1$ | $0.25$ | $0.05$ |\n\nWhich of the following statements are true?\n\n- $P(X=1,Y=1)=P(X=1)\\cdot P(Y=1)$\n- $P(X=x,Y=y)=P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y$\n- $X$ and $Y$ are independent" :question/worked-solution "Two discrete random variables $X$ and $Y$ with a joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nComputing the marginal probability mass functions for  $X$ and $Y,$ we obtain the following:\n\n| $f$ | $Y=0$ | $Y=1$ | ${f}_{X}$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.1$ | $0.6$ | $0.7$ |\n| $X=1$ | $0.25$ | $0.05$ | $0.3$ |\n| ${f}_{Y}$ | $0.35$ | $0.65$ | $1$ |\n\nWith that in mind, let's examine our statements.\n\n- Statements I and II are false. From the table, we obtain that $P(X=1,Y=1)=f(1,1)=0.05.$ However, \n\n$$\nP(X=1)\\cdot P(Y=1)={f}_{X}(1)\\cdot {f}_{Y}(1)=0.3\\cdot 0.65=0.195.\\,\\times \n$$\n\nTherefore, \n\n$$\nP(X=1,Y=1)\\ne P(X=1)\\cdot P(Y=1),\n$$\n\nand $P(X=x,Y=y)\\ne P(X=x)\\cdot P(Y=y)$ for all possible $x$ and $y.$\n\n- Statement III is false. Since statement II is false, our random variables $X$ and $Y$ are *not* independent.\n\nTherefore, the correct answer is \"None of those listed.\""}] [{:db/id #edb/ref 17592186275134 :knowledge-point/_questions [{:db/id #edb/ref 17592186161979 :knowledge-point/id #uuid "5c2da07e-23b5-58d0-aeef-14e21b329368" :knowledge-point/title "Identifying Symmetric Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c4360e-11aa-50a5-8dca-4dea8a8fdd3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186272992} {:answer/id #uuid "892b0517-6002-5679-8747-3e18957a3c43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186273568} {:answer/id #uuid "c1d73e2e-3487-5a60-a79c-f7913c20e904" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186274069} {:answer/id #uuid "ca570e3b-a84a-5db7-a59c-54a705149244" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186274144} {:answer/id #uuid "d1f2b8dc-2166-5acf-96d8-0e209e971eb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ and $R$ only" :db/id #edb/ref 17592186274221}] :answer-field/correct {:answer/id #uuid "892b0517-6002-5679-8747-3e18957a3c43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186273568} :answer-field/id #uuid "f8185736-7186-5fec-abfc-3ab0eb208611" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2475e8ae-4517-52f5-bd41-fe3d91352945" :question/math-academy-id "q-143680" :question/problem "Which of the following matrices are symmetric?\n\n$$\nP=[\\begin{aligned}1 & 2 & 11 \\\\ 2 & -1 & -9 \\\\ 11 & -9 & 0\\end{aligned}],\\,Q=[\\begin{aligned}0 & 2 \\\\ 2 & -1\\end{aligned}],\\,R=[\\begin{aligned}7 & 3 \\\\ 4 & 7\\end{aligned}]\n$$" :question/worked-solution "A square matrix $A$ is symmetric if it is equal to its transpose:\n\n$$\nA={A}^{T}\n$$\n\nEquivalently, ${a}_{ij}={a}_{ji}$ for all $i,j.$ In other words, $A$ is symmetric across its main diagonal. \n\nWith that in mind, let's examine each matrix in turn.\n\n- $P$ is a symmetric matrix. Indeed, $P={P}^{T}.$\n\n- $Q$ is a symmetric matrix. Indeed, $Q={Q}^{T}.$\n\n- $R$ is *not* a symmetric matrix. Since ${r}_{12}\\ne {r}_{21},$ we obtain $R\\ne {R}^{T}.$\n\n$$\nR=[\\begin{aligned}7 & 3 \\\\ 4 & 7\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"$P$ and $Q$ only.\""}] [{:db/id #edb/ref 17592186275141 :knowledge-point/_questions [{:db/id #edb/ref 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89bddea6-bbe2-51b8-adf4-de306f1c6836" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186273576} {:answer/id #uuid "8e52a1ab-35d5-5c3f-8591-929097128649" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186273617} {:answer/id #uuid "94a7a522-7254-5d79-914a-36556eb0b65c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273682} {:answer/id #uuid "b22de866-0abf-5b09-a709-899483e618d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273926} {:answer/id #uuid "ea17a99a-d10e-5140-b7fb-13d127018d64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186274459}] :answer-field/correct {:answer/id #uuid "b22de866-0abf-5b09-a709-899483e618d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186273926} :answer-field/id #uuid "43fbf250-71a6-5396-96bb-258f31270702" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62d0b863-0ebd-5fe2-bf2e-b910931d25fb" :question/math-academy-id "q-143865" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.4$ | $0.3$ |\n| $X=1$ | $0.2$ | $0.1$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\nI. $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n\nII. ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n\nIII. $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.4+0.3+0.2+0.1=1\\,✓\\end{aligned}\n$$\n\n- Condition III is true. Because $f(x,y)$ satisfies conditions I and II, it is a valid probability mass function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186275142 :knowledge-point/_questions [{:db/id #edb/ref 17592186162063 :knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e902443-9355-50ce-8de1-debd70c8598d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186272516} {:answer/id #uuid "52ba22d1-99d1-54d0-9257-31ef1b341758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186273091} {:answer/id #uuid "6af8ca05-f0a1-5735-af6c-6ac5a6c38642" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186273309} {:answer/id #uuid "9355ff7b-7286-587b-9a49-30b401f5cc18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186273668} {:answer/id #uuid "bcfdbafb-392e-5335-9f27-fdf0786d2811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186274021}] :answer-field/correct {:answer/id #uuid "bcfdbafb-392e-5335-9f27-fdf0786d2811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186274021} :answer-field/id #uuid "cda186df-8fcf-599c-9d99-b672e70220eb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "614bf915-93d7-5d