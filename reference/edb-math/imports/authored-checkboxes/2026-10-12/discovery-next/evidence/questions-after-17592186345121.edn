nswer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470185}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac020dea-1486-5e82-bd01-29594c8fbf7a" :question/math-academy-id "q-80300" :question/problem "Which of the numbers below belong to  ${R}_{0}^{+}?$\n- **I.** $0$\n- **II.** $\\sqrt{18}$\n- **III.** $-2\\sqrt{5}$\n- **IV.** $-\\frac{1}{5}$\n\nSelect all that apply." :question/worked-solution "Remember that ${R}_{0}^{+}$ is the set of all positive real numbers and $0.$\n\n- $0$ belongs to ${R}_{0}^{+}.\\,✓$\n\n- $\\sqrt{18}=3\\sqrt{2}$ belongs to ${R}_{0}^{+}.\\,✓$\n\n- $-2\\sqrt{5}$ is a negative number, so it does *not* belong to ${R}_{0}^{+}.\\,\\times $\n\n- $-\\frac{1}{5}$ is a negative number, so it does *not* belong to ${R}_{0}^{+}.\\,\\times $\n\nIn conclusion, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186348364 :knowledge-point/_questions [{:db/id #edb/ref 17592186054814 :knowledge-point/id #uuid "3de9e532-559c-5fc1-a6ad-5fcd1ed77824" :knowledge-point/title "Identifying Special Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fb1cc51-1db2-57b9-baf6-75de2e4cdec8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469148} {:answer/id #uuid "dbccee3c-0547-5c53-8dfb-7fa8ba086442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469149}] :answer-field/correct {:answer/id #uuid "dbccee3c-0547-5c53-8dfb-7fa8ba086442" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469149} :answer-field/id #uuid "1f5e3c87-547e-5a51-a277-73a08a1f920c" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/c