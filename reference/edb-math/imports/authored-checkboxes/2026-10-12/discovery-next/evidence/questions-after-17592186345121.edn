b/ref 17592186469126} {:answer/id #uuid "91bf1394-4391-58fa-bd1a-06047a845664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469127}] :answer-field/correct {:answer/id #uuid "91bf1394-4391-58fa-bd1a-06047a845664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469127} :answer-field/id #uuid "4e543d23-a589-5f66-84cd-c6970901bae1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470175}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2273f6bc-da9e-5824-b9ba-6b0ea3f200d5" :question/math-academy-id "q-79832" :question/problem "Given that ${y}_{1}(x)={x}^{-5}$ is a solution to the equation ${x}^{2}{y}^{″}+5x{y}^{′}-5y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)={x}^{-5}\\operatorname{ln}⁡x$\n- **II.** $y(x)=5{x}^{-4}$\n- **III.** $y(x)=-{x}^{-5}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)={x}^{-5}\\operatorname{ln}⁡x$ is **not** guaranteed to be a solution of the equation by the superposition principle. The superposition principle does not extend to the product of a non-constant function and a known solution.\n\n- The function $y(x)=5{x}^{-4}$ is **not** guaranteed to be a solution of the equation by the superposition principle because $y={x}^{-4}$ is not a solution.\n\n- The function $y(x)=-{x}^{-5}$ is a solution of the equation by the superposition principle. In this case, $c=-1.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186348299 :knowledge-point/_questions [{:db/id #edb/ref 17592186152193 :knowledge-point/id #uuid "b0829d4a-239a-5a8e-9c8e-3cdc76a993bc" :knowledge-point/title "Identifying Solutions of Linear ODEs Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6a361cd-ab6f-5384-81cc-6b0fb3643c85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469128} {:answer/id #uuid "0bafe13e-f37f-51fc-8cb5-4c78b27cbf3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469129}] :answer-field/correct {:answer/id #uuid "0bafe13e-f37f-51fc-8cb5-4c78b27cbf3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469129} :answer-field/id #uuid "93cbeab5-b615-5386-b857-11fb77fddda3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470176} {:answer-field/choices [{:answer/id #uuid "d8830df0-4dbc-57dc-bde3-ebd6e7d721a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469130} {:answer/id #uuid "5a9066c3-cccf-5001-a14a-957a8ae8c755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469131}] :answer-field/correct {:answer/id #uuid "5a9066c3-cccf-5001-a14a-957a8ae8c755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469131} :answer-field/id #uuid "5f73adb4-4499-5195-82f8-ad71528055ca" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470177} {:answer-field/choices [{:answer/id #uuid "14470ea3-f8b2-5e94-a980-c1f2268cfef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469132} {:answer/id #uuid "88bebeba-766e-56d3-af5c-1bb82699777e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469133}] :answer-field/correct {:answer/id #uuid "14470ea3-f8b2-5e94-a980-c1f2268cfef2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469132} :answer-field/id #uuid "db56fad5-3569-5509-8082-acc93b3f2dd9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470178}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "60c58de3-1420-5803-8b3d-664cd468fc15" :question/math-academy-id "q-79833" :question/problem "Given that ${y}_{1}(x)={e}^{-6x}$ is a solution to the equation ${y}^{″}+5{y}^{′}-6y=0,$ then according to the superposition principle which of the following must also be a solution to the equation?\n- **I.** $y(x)=2{e}^{-6x}$\n- **II.** $y(x)={e}^{3-6x}$\n- **III.** $y(x)=-{e}^{6x}$\n\nSelect all that apply." :question/worked-solution "According to the superposition principle, if the function ${y}_{1}(x)$ is a solution to a homogeneous, linear differential equation, and $c$ is a constant, then $y(x)=c{y}_{1}(x)$ is also a solution to the equation.\n\nLet's consider each option:\n\n- The function $y(x)=2{e}^{-6x}$ is a solution of the equation by the superposition principle. In this case, $c=2.$\n\n- The function $y(x)={e}^{3-6x}={e}^{3}\\cdot {e}^{-6x}$ is a solution of the equation by the superposition principle. In this case, $c={e}^{3}.$\n\n- The function $y(x)=-{e}^{6x}$ is **not** guaranteed to be a solution of the equation by the superposition principle because $y={e}^{6x}$ is not a solution.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186348353 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b9bdc7e-42c3-53cc-a18e-22ffa2e86bb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469134} {:answer/id #uuid "361c69af-6a32-5d90-a2fa-6b0197287d40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469135}] :answer-field/correct {:answer/id #uuid "361c69af-6a32-5d90-a2fa-6b0197287d40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469135} :answer-field/id #uuid "cd53690d-e07b-5da6-966c-bd269499edd7" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470179} {:answer-field/choices [{:answer/id #uuid "23c74a53-044d-57cf-83b8-d90c2e0538e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469136} {:answer/id #uuid "13abf251-50ed-5e34-bf36-94c66ecbad57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469137}] :answer-field/correct {:answer/id #uuid "13abf251-50ed-5e34-bf36-94c66ecbad57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469137} :answer-field/id #uuid "f9eab1d5-593a-5a4b-9714-f2225f52eb4d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470180} {:answer-field/choices [{:answer/id #uuid "de2f0777-10bc-5716-b903-2d5397b7afa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469138} {:answer/id #uuid "1803f7d1-0e88-50d0-b801-03a457a85e83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469139}] :answer-field/correct {:answer/id #uuid "1803f7d1-0e88-50d0-b801-03a457a85e83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469139} :answer-field/id #uuid "06caeb1c-f4fa-5b23-9efc-e6e9cf272ed6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470181}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00b02bef-cbb1-520c-b74e-661d82b27e5e" :question/math-academy-id "q-8022" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+y \\\\ 2y\\end{aligned}].$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 2(ky)\\end{aligned}] \\\\  & =[\\begin{aligned}k(x+y) \\\\ k(2y)\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 2y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 2({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 2{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 2{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186348355 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ddf9bcc-1b80-5061-9595-2aa695fdf46e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469140} {:answer/id #uuid "142efaaf-152b-53fd-b91d-f83fe3918936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469141}] :answer-field/correct {:answer/id #uuid "142efaaf-152b-53fd-b91d-f83fe3918936" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469141} :answer-field/id #uuid "177885e0-b15c-5b26-b386-e1b7f6e1f46a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470182} {:answer-field/choices [{:answer/id #uuid "bdf28f65-690c-5749-aa58-cff4ec98cbdc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469142} {:answer/id #uuid "28f497ef-0630-515b-afc3-0fa1c69bfa44" :answer/type {: