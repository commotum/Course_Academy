/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469289} :answer-field/id #uuid "24a51c46-911d-55ae-a9b0-cd6fdec63972" :answer-field/key "W" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c1e164f-769d-52d4-a09c-f8474e7b2368" :question/math-academy-id "q-82401" :question/problem "Which of the following sets are orthonormal?\n- **U.** $U={[\\begin{aligned}1 \\\\ 1\\end{aligned}],[\\begin{aligned}1 \\\\ 1\\end{aligned}]}$\n- **V.** $V={[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}],[\\begin{aligned}0 \\\\ 1\\end{aligned}]}$\n- **W.** $W={[\\begin{aligned}1 \\\\ 0\\end{aligned}],[\\begin{aligned}0 \\\\ 1\\end{aligned}]}$\n\nSelect all that apply." :question/worked-solution "Let's denote the vectors of the given sets as \n${{u}_{1},{u}_{2}},$\n${{v}_{1},{v}_{2}},$ and \n${{w}_{1},{w}_{2}}$, respectively. \n\nThe sets $U,V,$ and $W$ are orthonormal if the following conditions on each set hold:\n\n- ${u}_{1}\\cdot {u}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{u}_{1}\\cdot {u}_{1}=1 \\\\ {u}_{2}\\cdot {u}_{2}=1.\\end{aligned}$\n\n- ${v}_{1}\\cdot {v}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{v}_{1}\\cdot {v}_{1}=1 \\\\ {v}_{2}\\cdot {v}_{2}=1.\\end{aligned}$\n\n- ${w}_{1}\\cdot {w}_{2}=0\\,\\text{and}\\,{\\begin{aligned}{w}_{1}\\cdot {w}_{1}=1 \\\\ {w}_{2}\\cdot {w}_{2}=1.\\end{aligned}$\n\nWith that in mind, let's examine our sets in turn.\n\n- For the set $U,$ notice that\n\n$$\n\\begin{aligned}{u}_{1}\\cdot {u}_{1} & =[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}]=1+1=2\\ne 1 & \\times \\end{aligned}\n$$\n\nSo, $U$ is not an orthonormal set.\n\n- For the set $V,$ notice that\n\n$$\n\\begin{aligned}{v}_{1}\\cdot {v}_{2} & =[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]=0+\\frac{2}{\\sqrt{5}}=\\frac{2}{\\sqrt{5}}\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $V$ is not an orthonormal set.\n\n- For the set $W,$ we get the following:\n\n$$\n\\begin{aligned}{w}_{1}\\cdot {w}_{2} & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]=0+0=0 & ✓ \\\\ {w}_{1}\\cdot {w}_{1} & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 0\\end{aligned}]=1+0=1 & ✓ \\\\ {w}_{2}\\cdot {w}_{2} & =[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]=0+1=1 & ✓\\end{aligned}\n$$\n\nSo, the set $W$ is orthonormal.\n\nTherefore, we conclude that the correct answer is \"$W$ only\"."}] [{:db/id #edb/ref 17592186351471 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae458531-3fea-5d4a-9fef-16784006df96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469290} {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291}] :answer-field/correct {:answer/id #uuid "70a6a5c7-d36a-5ba3-beef-83d4658904d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469291} :answer-field/id #uuid "ab84475d-72cc-534c-be81-a6861c464c13" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470257} {:answer-field/choices [{:answer/id #uuid "3a743681-e458-539f-acc1-e7e101830b51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469292} {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293}] :answer-field/correct {:answer/id #uuid "0d6b3d1d-d8b2-5500-997a-fadb43a18f4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469293} :answer-field/id #uuid "21f12b61-0b8f-58ec-be60-cd2667a6b36b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470258} {:answer-field/choices [{:answer/id #uuid "4fdad23f-a509-5ce9-9efa-82f9ccbc40a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469294} {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295}] :answer-field/correct {:answer/id #uuid "9cb92e59-8505-5e39-a0e2-9326bc50742f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469295} :answer-field/id #uuid "45138a1d-ce8d-542c-875e-b3141969f4d5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470259}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d21c33a8-a8c0-5b77-a079-4c787c111b5f" :question/math-academy-id "q-8296" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}5x+2y \\\\ 3y\\end{aligned}].$\nWhich of the following statements are true?\n- **I.** $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- **II.** $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- **III.** $T$ is a linear transformation\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}5(kx)+2(ky) \\\\ 3(ky)\\end{aligned}] \\\\  & =[\\begin{aligned}k(5x+2y) \\\\ k(3y)\\end{aligned}] \\\\  & =k[\\begin{aligned}5x+2y \\\\ 3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}5({x}_{1}+{x}_{2})+2({y}_{1}+{y}_{2}) \\\\ 3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}5{x}_{1}+2{y}_{1} \\\\ 3{y}_{1}\\end{aligned}]+[\\begin{aligned}5{x}_{2}+2{y}_{2} \\\\ 3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186351472 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f2bbb7-924e-519b-858e-8781702c24be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469296} {:answer/id #uuid "1d466783-f476-5fdd-b2b1-7f9609e90817" :answer/type 