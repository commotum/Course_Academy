7592186468415}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cedbe49b-bcb9-5d4b-9edb-8a333a5510e3" :question/math-academy-id "q-37315" :question/problem "To which of the following sets does the number $-\\sqrt{81}$ belong?\n- **I.** $Z$\n- **II.** ${Z}^{-}$\n- **III.** ${Z}_{0}^{-}$\n- **IV.** $R$\n\nSelect all that apply." :question/worked-solution "Note that $-\\sqrt{81}=-9.$ Therefore $-\\sqrt{81}$ is a negative integer. So it's in the sets $Z,$ ${Z}_{0}^{-},$ and ${Z}^{-}.$ \n\nMoreover, since every integer is also a real number, $-\\sqrt{81}$ also belongs to $R.$\n\nTherefore, the correct answer is \"I, II, III, and IV.\""}] [{:db/id #edb/ref 17592186323908 :knowledge-point/_questions [{:db/id #edb/ref 17592186054815 :knowledge-point/id #uuid "abc6b3ee-0251-5c9c-9358-bd192c434dd1" :knowledge-point/title "Identifying Elements Belonging to Scripted Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c63f8788-4861-50b5-ad8e-1f2b7a843fc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467390} {:answer/id #uuid "bd0459aa-0395-54b3-9ae4-09c6cc63272f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467391}] :answer-field/correct {:answer/id #uuid "bd0459aa-0395-54b3-9ae4-09c6cc63272f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467391} :answer-field/id #uuid "d3092cae-ee3b-500a-abd8-3f84a1556f2f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468416} {:answer-field/choices [{:answer/id #uuid "b2e1992c-6214-55a3-87b5-a04ba4f0dbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467392} {:answer/id #uu