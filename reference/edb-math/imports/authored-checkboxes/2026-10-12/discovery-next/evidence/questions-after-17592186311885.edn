f9e-c2cd-5c5e-b608-37e69bc49a60" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468390} {:answer-field/choices [{:answer/id #uuid "0e083057-d217-55e7-bc22-fb619e13da4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467340} {:answer/id #uuid "fb356de8-7756-5c98-9f14-b75bff8799b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467341}] :answer-field/correct {:answer/id #uuid "0e083057-d217-55e7-bc22-fb619e13da4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467340} :answer-field/id #uuid "576ee637-38c3-5fb3-a0d3-dbe771a24c36" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468391}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f51862bd-578b-533f-86e5-e297bb989e9a" :question/math-academy-id "q-36244" :question/problem "To which of the following sets do all the real numbers belong?\n- **I.** ${Z}^{-}$\n- **II.** $N$\n- **III.** $Q$\n- **IV.** ${Q}^{-}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "- The set ${Z}^{-}$ contains all the negative integer numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to ${Z}^{-},$ so ${Z}^{-}$ does *not* contain the real numbers. $\\,\\times $\n\n- The set $N$ contains all the natural numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to $N,$ so $N$ does *not* contain the real numbers. $\\,\\times $\n\n- The set $Q$ contains all the rational numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to $Q,$ so $Q$ does *not* contain the real numbers. $\\,\\times $\n\n- The set ${Q}^{-}$ contains all the negative rational numbers. However, real numbers as, for instance, $\\sqrt{2}$ don't belong to ${Q}^{-},$ so ${Q}^{-}$ does *not* contain the real numbers. $\\,\\times $\n\nTherefore, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186323772 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec1272ac-b97f-543c-9119-57a28276d1b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467342} {:answer/id #uuid "2a8fbbc2-6cf7-5c87-a48c-b6c83dbbfb36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467343}] :answer-field/correct {:answer/id #uuid "2a8fbbc2-6cf7-5c87-a48c-b6c83dbbfb36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467343} :answer-field/id #uuid "702309aa-314a-5409-a395-8651b083b51a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468392} {:answer-field/choices [{:answer/id #uuid "db28d511-932a-561c-9b14-ada652aa884a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467344} {:answer/id #uuid "9ea79b4d-2728-5d13-851a-a58a1c36edd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467345}] :answer-field/correct {:answer/id #uuid "9ea79b4d-2728-5d13-851a-a58a1c36edd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467345} :answer-field/id #uuid "5ec2eabb-a58f-5bc1-bf97-23d0a4545863" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468393} {:answer-field/choices [{:answer/id #uuid "318f23fd-6e6e-5438-b299-91c5b04affe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467346} {:answer/id #uuid "c6d9b6d1-db0c-5dae-9ea0-9ca2ce06e302" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467347}] :answer-field/correct {:answer/id #uuid "318f23fd-6e6e-5438-b299-91c5b04affe7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467346} :answer-field/id #uuid "2314e92e-ec9c-5ccb-abec-616ce9b04051" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468394} {:answer-field/choices [{:answer/id #uuid "7ad04bcd-ec49-5b4d-9ed2-1a08b50d1686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467348} {:answer/id #uuid "26e60de3-6a9a-57a5-9dff-c4a4e48f2a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467349}] :answer-field/correct {:answer/id #uuid "7ad04bcd-ec49-5b4d-9ed2-1a08b50d1686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467348} :answer-field/id #uuid "7dee68bc-a430-5c4c-bd73-876dd575e220" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468395}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4fc9ff9e-591c-5172-b83a-e2856d63bd94" :question/math-academy-id "q-36248" :question/problem "To which of the following sets do all the positive integers belong?\n- **I.** $N$\n- **II.** ${R}^{+}$\n- **III.** ${Q}^{-}$\n- **IV.** ${Z}^{-}$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "The positive integer numbers are $1,2,3,…$\n\n- Since all positive integer numbers are natural numbers, all the positive integers belong to $N.$ $\\,✓$\n\n- Since all positive integer numbers are positive real numbers, all the positive integer numbers belong to ${R}^{+}.$ $\\,✓$\n\n- The set ${Q}^{-}$ contains all the negative rational numbers. However, positive integer numbers as, for instance, $2$ don't belong to ${Q}^{-},$ so ${Q}^{-}$ does *not* contain the positive integer numbers. $\\,\\times $\n\n- The set ${Z}^{-}$ contains all the negative integer numbers. However, positive integer numbers as, for instance, $2$ don't belong to ${Z}^{-},$ so ${Z}^{-}$ does *not* contain the positive integer numbers. $\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186323843 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ed2777a-34cb-534d-a3c0-f46d98a7f57f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467350} {:answer/id #uuid "382ea96b-f840-5089-97ad-613a3c3ea86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467351}] :answer-field/correct {:answer/id #uuid "382ea96b-f840-5089-97ad-613a3c3ea86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467351} :answer-field/id #uuid "cf044f59-5458-5a3f-9122-e042b2ce2609" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468396} {:answer-field/choices [{:answer/id #uuid "56892055-3446-54d3-b7c7-091f7041424b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467352} {:answer/id #uuid "97140039-2706-5181-86d8-83d99a14c98f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467353}] :answer-field/correct {:answer/id #uuid "56892055-3446-54d3-b7c7-091f7041424b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467352} :answer-field/id #uuid "1b33e161-c9a5-5c82-a2b4-80ffc8368590" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468397} {:answer-field/choices [{:answer/id #uuid "2c95eee0-8ca5-5722-b7c5-52773baa10a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467354} {:answer/id #uuid "af46bc38-7ce0-5c3a-9720-7658d86d8093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467355}] :answer-field/correct {:answer/id #uuid "af46bc38-7ce0-5c3a-9720-7658d86d8093" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467355} :answer-field/id #uuid "d185ed44-db67-5969-a945-aa27c7caa20f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468398}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "187c7a1d-e687-5fd7-b36a-8bd4869c300f" :question/math-academy-id "q-36678" :question/problem "Which of the following statements are true?\n- **I.** $v=[\\begin{aligned}1 \\\\ -2\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}]$ that corresponds to the eigenvalue $2.$\n- **II.** If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =2,$ then $-v$ is an eigenvector of $A$ corresponding to $\\lambda =-2.$\n- **III.** $v=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]$ that corresponds to the eigenvalue $0.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is true. We have \n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & =2[\\begin{aligned}1 \\\\ -2\\end{aligned}] \\\\  & =2v.\\end{aligned}\n$$\n\nSince $Av=2v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2.$\n\n- Statement II is false. We have\n\n$$\n\\begin{aligned}A(-v)=-Av=-(2v)=2(-v).\\end{aligned}\n$$\n\nSince, $A(-v)=2(-v),$ and $-v\\ne 0,$ this implies that $-v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =2$ (but not $-2$).\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement III is true. We have \n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 0\\end{aligned}] \\\\  & =0[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =0v.\\end{aligned}\n$$\n\nSince $Av=0v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =0.$\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186323858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83ea7e4d-2142-5b09-923c-d1732b846aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467356} {:answer/id #uuid "d55181ee-827a-5082-8727-316c1c665376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467357}] :answer-field/correct {:answer/id #uuid "d55181ee-827a-5082-8727-316c1c665376" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467357} :answer-field/id #uuid "80fb52f1-d337-52da-ab2b-f0e26b72af8a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468399} {:answer-field/choices [{:answer/id #uuid "69f8eeec-acb8-50ef-b931-56646b1a48a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467358} {:answer/id #uuid "95027d50-dda7-59a1-90d9-fcb2fc8d7016" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467359}] :answer-field/correct {:answer/id #uuid "69f8eeec-acb8-50ef-b931-56646b1a48a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467358} :answer-field/id #uuid "f91083d4-1dec-5899-9c25-5a1767f35d18" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468400} {:answer-field/choices [{:answer/id #uuid "e8cdfafa-f8c6-57ed-9615-9c048196643d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467360} {:answer/id #uuid "773e58d3-1733-5646-800f-a4d36ca8f057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467361}] :answer-field/correct {:answer/id #uuid "773e58d3-1733-5646-800f-a4d36ca8f057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467361} :answer-field/id #uuid "c66eca36-f5d2-521d-aeda-fb7f80625ed9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468401}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1d99b1dd-fcce-5575-b1d6-40adbcb0e805" :question/math-academy-id "q-36865" :question/problem "Which of the following statements are true?\n- **I.** If $v$ is an eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =3$ then $v$ is also an eigenvector of the matrix ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{3}.$\n- **II.** An eigenvector of an invertible matrix $A$ that corresponds to the eigenvalue $\\lambda =2$ is also an eigenvector of the inverse ${A}^{-1}$ that corresponds to the same eigenvalue $\\lambda =2.$\n- **III.** If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $\\lambda =-3,$ then $5v$ is also an eigenvector of $A$ corresponding to $\\lambda =-3.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is true. By the definition of an eigenvector, we have \n\n$$\nAv=3v.\n$$\n\n \nMultiplying it by ${A}^{-1}$ from the left, we obtain \n\n$$\nv=3{A}^{-1}v.\n$$\n\nDividing both sides by $3$, we get \n\n$$\n{A}^{-1}v=\\frac{1}{3}v.\n$$\n\n \nSo, $v$ is an eigenvector  of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{3}.$\n\n**Note:** In general, an eigenvector of an invertible matrix $A$ that corresponds to an eigenvalue $\\lambda $ is an eigenvector of ${A}^{-1}$ that corresponds to the eigenvalue $\\frac{1}{\\lambda }.$\n\n- Statement II is false. According to the statement above, an eigenvector of $A$ that corresponds to the eigenvalue $\\lambda =2$ is an eigenvector of ${A}^{-1}$ that corresponds to $\\lambda =\\frac{1}{2}.$\n\n- Statement III is true. We have\n\n$$\n\\begin{aligned}A(5v)=5Av=5(-3v)=-3(5v).\\end{aligned}\n$$\n\nSince, $A(5v)=-3(5v),$ and $5v\\ne 0,$ this implies that $5v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =-3.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186323877 :knowledge-point/_questions [{:db/id #edb/ref 17592186105769 :knowledge-point/id #uuid "32467c2c-5605-50e9-b961-a29535a0effb" :knowledge-point/title "Identifying True Statements About Eigenvalues and Eigenvectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33f5d441-8d4b-58c1-8c22-addd3278df62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467362} {:answer/id #uuid "5290a625-f39a-53d8-892c-452c72d705f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467363}] :answer-field/correct {:answer/id #uuid "5290a625-f39a-53d8-892c-452c72d705f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467363} :answer-field/id #uuid "c7fc9d30-3ccb-5565-83ba-123a94e4a7f6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468402} {:answer-field/choices [{:answer/id #uuid "412514e3-a9e7-5613-a307-779d4d58279b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467364} {:answer/id #uuid "ee9e4674-ca29-59e5-8966-974fa679ea90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467365}] :answer-field/correct {:answer/id #uuid "ee9e4674-ca29-59e5-8966-974fa679ea90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467365} :answer-field/id #uuid "32d88f51-d3f8-5b52-a864-157037e8ae37" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468403} {:answer-field/choices [{:answer/id #uuid "f4c67b74-bb04-5491-ad72-7bd19c8d5879" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467366} {:answer/id #uuid "3b128b1a-4960-589c-b9b3-e50d9b123f91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467367}] :answer-field/correct {:answer/id #uuid "3b128b1a-4960-589c-b9b3-e50d9b123f91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467367} :answer-field/id #uuid "102ab22e-5d62-5644-8b69-6d1e5e3127ad" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcdf208-8bdf-5d43-b755-321074d52b2d" :question/math-academy-id "q-37090" :question/problem "Which of the following statements are true?\n- **I.** If $v$ is an eigenvector of a matrix $A$ corresponding to the eigenvalue $5$ then $10v$ is also an eigenvector corresponding to $5.$\n- **II.** $v=[\\begin{aligned}2 \\\\ 3\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}3 & 2 \\\\ 3 & 4\\end{aligned}]$ that corresponds to the eigenvalue $6.$\n- **III.** $v=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ is an eigenvector of $A=[\\begin{aligned}3 & 1 \\\\ 3 & 1\\end{aligned}]$ that corresponds to the eigenvalue $4.$\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Remember that the eigenvectors of $A$ are the non-zero vectors $v$ such that $Av=\\lambda v.$ With that in mind, let's examine the statements one by one.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}A(10v)=10Av=10(5v)=5(10v).\\end{aligned}\n$$\n\nSince, $A(10v)=5(10v),$ and $10v\\ne 0,$ this implies that $10v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =5.$\n\n**Note:** In general, any non-zero multiple of an eigenvector is again an eigenvector, and the corresponding eigenvalue is the same.\n\n- Statement II is true. We have\n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}3 & 2 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}12 \\\\ 18\\end{aligned}] \\\\  & =6[\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =6v.\\end{aligned}\n$$\n\nSince $Av=6v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =6.$\n\n- Statement III is true. We have \n\n$$\n\\begin{aligned}Av & =[\\begin{aligned}3 & 1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 4\\end{aligned}] \\\\  & =4[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\  & =4v.\\end{aligned}\n$$\n\nSince $Av=4v,$ we conclude that $v$ is an eigenvector of $A$ and the corresponding eigenvalue is $\\lambda =4.$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186323897 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f131b8b1-8827-5910-a5ac-d78c1fa32fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467368} {:answer/id #uuid "d7fe3ea3-1ffb-5ce4-a18e-7faebf5b67f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467369}] :answer-field/correct {:answer/id #uuid "d7fe3ea3-1ffb-5ce4-a18e-7faebf5b67f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467369} :answer-field/id #uuid "c2f37772-fd8a-5ee6-811b-4cc121bab3be" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468405} {:answer-field/choices [{:answer/id #uuid "02753f86-4fce-54fb-9c0e-2207db70647c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467370} {:answer/id #uuid "91b8f2c7-6a27-5fb4-8a55-5077501e753b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467371}] :answer-field/correct {:answer/id #uuid "91b8f2c7-6a27-5fb4-8a55-5077501e753b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467371} :answer-field/id #uuid "cded1df7-9c19-5aca-a016-6ac3bfc68f47" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468406} {:answer-field/choices [{:answer/id #uuid "b9ac8087-537f-59ff-8200-7a77fbe85624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467372} {:answer/id #uuid "4f3f1e92-dc35-5eaf-ae91-e7233b4568ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467373}] :answer-field/correct {:answer/id #uuid "b9ac8087-537f-59ff-8200-7a77fbe85624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467372} :answer-field/id #uuid "d07afc69-ca10-5308-a2ef-96a874386ca9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468407}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c42f9a6a-c252-590f-89ec-76e86350914b" :question/math-academy-id "q-37266" :question/problem "Which of the following sets is a subset of $A=\\{3,6,9,12,15,18,21,…\\}?$\n\nI. $B=\\{3n:n\\in N,1\\le n\\le 4\\}$\n\nII. $C=\\{6n:n\\in N,1\\le n\\le 3\\}$\n\nIII. $D=\\{2n:n\\in N,1\\le n\\le 4\\}$\n\nSelect all that apply." :question/worked-solution "First, we must find the elements of the sets $B,C$ and $D.$\n\n- We find the elements of the set $B$ substituting the values $n\\in \\{1,2,3,4\\}$ into the formula $3n,$ and we get the following elements:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,3(1)=3 \\\\ n=2 & \\,⇒\\,3(2)=6 \\\\ n=3 & \\,⇒\\,3(3)=9 \\\\ n=4 & \\,⇒\\,3(4)=12\\end{aligned}\n$$\n\nSo we have, $B=\\{3,6,9,12\\}.$\n\n- On the other hand, the elements of the set $C$ can be found substituting the values $n\\in \\{1,2,3\\}$ into the formula $6n,$ and we get the following:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,6(1)=6 \\\\ n=2 & \\,⇒\\,6(2)=12 \\\\ n=3 & \\,⇒\\,6(3)=18\\end{aligned}\n$$\n\nTherefore, $C=\\{6,12,18\\}.$\n\n- Finally, the elements of the set $D$ can be found substituting the values $n\\in \\{1,2,3,4\\}$ into the formula $2n,$ and we get:\n\n$$\n\\begin{aligned}n=1 & \\,⇒\\,2(1)=2 \\\\ n=2 & \\,⇒\\,2(2)=4 \\\\ n=3 & \\,⇒\\,2(3)=6 \\\\ n=4 & \\,⇒\\,2(4)=8\\end{aligned}\n$$\n\nSo we have, $D=\\{2,4,6,8\\}.$\n\nNow, a set is a subset of $A$ if all of its elements are also elements of $A.$ With that in mind, let's inspect each option.\n\n- $B=\\{3,6,9,12\\}$ is a subset of $A.\\,✓$\n\n- $C=\\{6,12,18\\}$ is a subset of $A.\\,✓$\n\n- $D=\\{2,4,6,8\\}$ is *not* a subset of $A$ because it contains the element $2\\notin A.\\,\\times $\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186323901 :knowledge-point/_questions [{:db/id #edb/ref 17592186054816 :knowledge-point/id #uuid "1d132801-b9cc-5c0c-a8fa-0c8b840c05bd" :knowledge-point/title "Identifying Sets Containing a Given Element"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5eb8220c-b68f-589e-8a2b-40578b765ad5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467374} {:answer/id #uuid "249f1641-add4-5543-992f-0c831364c3ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467375}] :answer-field/correct {:answer/id #uuid "249f1641-add4-5543-992f-0c831364c3ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467375} :answer-field/id #uuid "a4f4754d-90d5-58d5-bee4-c2914dcbe024" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468408} {:answer-field/choices [{:answer/id #uuid "c8da56ec-2879-5bea-86f2-ecd5a0f1f431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186467376} {:answer/id #uuid "218f7977-751a-5526-a0c7-dc72dbc821e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186467377}] :answer-field/correct {:answer/id #uuid "c8da56ec-2879-5bea-86f2-ecd5a0f1f431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 