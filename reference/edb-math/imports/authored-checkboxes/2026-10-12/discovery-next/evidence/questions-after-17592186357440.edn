edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470556}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cae22cc3-a67e-53bb-bb36-eebf3af162ea" :question/math-academy-id "q-97288" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y+1$ and its slope field. Which of the following statements are true?\n- **I.** At every point along the line $y=-2,$ the slope field has a positive slope\n- **II.** At every point along the line $y=-1,$ the slope field is horizontal\n- **III.** At every point along the line $y=1,$ the slope field has a negative slope\n\nSelect all that apply. If none apply, leave all boxes unchecked." :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThis is an autonomous equation because the right-hand side is a function of $y$ only. This means that, for a fixed value of $y,$ the slope does not vary with $x.$ \n\nNow, let's check each statement:\n\n- Statement I is false. Consider a point of the form $(x,-2)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-2)}=-2+1=-1<0,\n$$\n\nand this implies that the slope at the point $(x,-2)$ is negative for any $x.$ Moreover, the slope at the point $(x,-2)$ is equal to $-1$ for any $x.$\n\n- Statement II is true. Consider a point of the form $(x,-1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-1)}=-1+1=0,\n$$\n\nand this implies that the slope at the point $(x,-1)$ is horizontal for any $x.$\n\n- Statement III is false. Consider a point of the form $(x,1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,1)}=1+1=2>0,\n$$\n\nand this implies that the slope at the point $(x,1)$ is positive for any $x.$ Moreover, the slope at the point $(x,1)$ is equal to $2$ for any $x.$\n\nTherefore, the correct answer is \"II only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](images/ca/caa69f6116eba6462c4fe18f2e535d83db350f0797cf1fcd895ac6df9a4d6fd7.png)"}] [{:db/id #edb/ref 17592186362290 :knowledge-point/_questions [{:db/id #edb/ref 17592186172049 :knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b56df147-449a-5ae1-aa90-5d246df31e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469890} {:answer/id #uuid "df4aa174-0436-5464-a847-a5fdf50dec44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469891}] :answer-field/correct {:answer/id #uuid "b56df147-449a-5ae1-aa90-5d246df31e5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469890} :answer-field/id #uuid "04750c82-c645-5c04-95c3-42d1924b2c67" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470557} {:answer-field/choices [{:answer/id #uuid "8cccafca-dfed-599a-aa20-1e6bf9896088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469892} {:answer/id #uuid "0e7165f4-d564-5873-886b-c132deff4b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469893}] :answer-field/correct {:answer/id #uuid "0e7165f4-d564-5873-886b-c132deff4b45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469893} :answer-field/id #uuid "64fabda8-7463-5cb2-99ad-04c9a1633742" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470558} {:answer-field/choices [{:answer/id #uuid "a7c0a549-5c2d-5984-839f-742c8c63c3dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469894} {:answer/id #uuid "632387a2-1400-5d68-95b3-75e67481f71a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469895}] :answer-field/correct {:answer/id #uuid "a7c0a549-5c2d-5984-839f-742c8c63c3dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469894} :answer-field/id #uuid "a3a892cb-020f-5b99-a1b4-9020867438f8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470559} {:answer-field/choices [{:answer/id #uuid "8cf05806-10fd-5532-9e8e-c9e94658c5f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469896} {:answer/id #uuid "efea8fd8-91cd-54d7-b040-e4a3c89c7207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469897}] :answer-field/correct {:answer/id #uuid "8cf05806-10fd-5532-9e8e-c9e94658c5f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469896} :answer-field/id #uuid "07877319-c0c7-581a-ba16-3bf298a39f19" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470560}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e0e004a8-576b-5fb6-94f2-3e66cfd74da8" :question/math-academy-id "q-98338" :question/problem "![](images/d1/d1b6a9fa72404e765796d75fc7ba00a391317ef2670e2f65f7c43db32207e8d2.png)\n\nWhich of the curves above is simple, closed, and negatively oriented?\n\nSelect all that apply." :question/worked-solution "A simple closed curve is positively oriented if, when traveling along it, one always has the curve interior to the left and the curve exterior to the right. Otherwise, the curve is negatively oriented. \n\nA curve is positively oriented if it is traversed counterclockwise and is negatively oriented if it is traversed clockwise.\n\nWith that in mind, let's examine each of the curves:\n\n- Curve I is not closed.\n\n- Curve II is simple, closed, negatively oriented. The arrows indicate that the curve is traversed clockwise.\n\n- Curve III is a simple and closed curve but it is not negatively oriented. The arrows indicate that the curve is traversed counterclockwise, so it is positively oriented.\n\n- Curve IV is not simple.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186362303 :knowledge-point/_questions [{:db/id #edb/ref 17592186147492 :knowledge-point/id #uuid "6e71c0c9-7dd1-5f09-a55c-96b5bed1ee9a" :knowledge-point/title "Identifying a Differential Equation Corresponding to a Phase Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "641505e3-4fec-567c-9c83-85531b7e7c70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469898} {:answer/id #uuid "8c339b98-1358-5e7d-8176-5121ba8d7389" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469899}] :answer-field/correct {:answer/id #uuid "641505e3-4fec-567c-9c83-85531b7e7c70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469898} :answer-field/id #uuid "f8358553-9442-58c8-8202-498365ddb0e4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470561} {:answer-field/choices [{:answer/id #uuid "522e362c-1cf2-5e5e-bf1e-ef974c5457f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469900} {:answer/id #uuid "daaa37b4-08b7-53d2-adb1-dcb759580aef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469901}] :answer-field/correct {:answer/id #uuid "522e362c-1cf2-5e5e-bf1e-ef974c5457f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469900} :answer-field/id #uuid "18be5b77-e262-5137-851e-aadfcd89dc06" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470562} {:answer-field/choices [{:answer/id #uuid "c57acda6-1c6a-5883-9027-7b21a18b0906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469902} {:answer/id #uuid "0a5ae1cb-d891-5e47-9927-87731b1815d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469903}] :answer-field/correct {:answer/id #uuid "0a5ae1cb-d891-5e47-9927-87731b1815d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469903} :answer-field/id #uuid "dcd41de6-cafd-59b8-852b-7d4b0662b46c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470563}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cdb362d-f774-5da6-bc15-c04006a3144a" :question/math-academy-id "q-98632" :question/problem "![](images/ca/ca296c3a8a2989fd5e5ca647ad4f7d0f4890aa3caf8d9e0a1fce98498d2d7d64.png)\n\nConsider the phase line shown above. Which of the following differential equations could have this phase line?\n\n- $\\frac{\\text{d}y}{\\text{d}x}=(y+1)^{2}$\n- $\\frac{\\text{d}y}{\\text{d}x}=(y-2)^{2}(y+1)$\n- $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-y-2$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "First, notice that all three differential equations are of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThe phase line gives us the following information:\n\n- The equilibrium solutions are $y=-1$ and $y=2.$\n\n- $f(y)$ is positive for $y\\in (-\\infty ,-1)\\cup (2,\\infty ).$\n\n- $f(y)$ is negative for $y\\in (-1,2).$\n\nWith this in mind, let's study each of the given equations.\n\n- We start by considering ${y}^{′}=(y+1)^{2}.$\n\nIn this case, $f(y)=(y+1)^{2},$ and the equilibrium solution is $y=-1$ only.\n\nTherefore, equation I does not have the given phase line.\n\n- Next, we consider ${y}^{′}=(y-2)^{2}(y+1).$\n\nFirst, $f(y)=(y-2)^{2}(y+1),$ so $f(y)=0$ if $y=-1,2.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nHowever, we note that $f(y)<0$ for $y\\in (-\\infty ,-1).$ This does *not* correspond to the arrows shown on the phase line.\n\nTherefore, equation II does not have the given phase line.\n\n- Finally, we consider ${y}^{′}={y}^{2}-y-2.$\n\nFirst, we see that $f(y)=(y+1)(y-2),$ so $f(y)=0$ if $y=-1,2.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nNow, we can construct a sign table for $f(y)$ as follows: \n\n|  | $(-\\infty ,-1)$ | $(-1,2)$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| $y+1$ | $-$ | $+$ | $+$ |\n| $y-2$ | $-$ | $-$ | $+$ |\n| $f(y)$ | $+$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is negative for  $y\\in (-1,2),$ and $f(y)$ is positive for $y\\in (-\\infty ,-1)\\cup (2,\\infty ).$ This corresponds to the arrows shown on the phase line.\n\nTherefore, equation III has the given phase line.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186362304 :knowledge-point/_questions [{:db/id #edb/ref 17592186147492 :knowledge-point/id #uuid "6e71c0c9-7dd1-5f09-a55c-96b5bed1ee9a" :knowledge-point/title "Identifying a Differential Equation Corresponding to a Phase Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d8db14d-ee62-5f27-9e1d-94fabe34d298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469904} {:answer/id #uuid "b3fc96b7-4a76-5f62-a63c-72f8b35a31dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469905}] :answer-field/correct {:answer/id #uuid "b3fc96b7-4a76-5f62-a63c-72f8b35a31dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469905} :answer-field/id #uuid "c1c7181d-3159-5eb8-8297-7334eac26868" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470564} {:answer-field/choices [{:answer/id #uuid "ce722e7d-8ced-56bb-8b95-f9228089b504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469906} {:answer/id #uuid "51b5c6a0-f8a9-5df5-96b9-6b8e0cb79e90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469907}] :answer-field/correct {:answer/id #uuid "ce722e7d-8ced-56bb-8b95-f9228089b504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469906} :answer-field/id #uuid "cedc6c80-dac3-5be1-b567-60fe9aa755cd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470565} {:answer-field/choices [{:answer/id #uuid "886dc1a9-31f9-5e08-a537-41e9c2a3e5a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469908} {:answer/id #uuid "ba36d9ea-19f6-5bd9-8316-4a6de407a017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469909}] :answer-field/correct {:answer/id #uuid "886dc1a9-31f9-5e08-a537-41e9c2a3e5a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469908} :answer-field/id #uuid "2fbef377-40b9-5ebf-8afc-8f580c32d99f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "98ee9b06-5212-535a-b3fd-5d1e48bb48f8" :question/math-academy-id "q-98636" :question/problem "![](images/b5/b5afe944331145c5253b2f1100f642b8a91a538295f3c84877eeb86870a04915.png)\n\nConsider the phase line shown above. Which of the following differential equations could have this phase line?\n\n- $\\frac{\\text{d}y}{\\text{d}x}=y({y}^{2}-4)$\n- $\\frac{\\text{d}y}{\\text{d}x}=y(4-{y}^{2})$\n- $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-4$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "First, notice that all three differential equations are of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThe phase line gives us the following information:\n\n- The equilibrium solutions are $y=-2,$ $y=0$ and $y=2.$\n\n- $f(y)$ is positive for $y\\in (-2,0)\\cup (2,\\infty ).$\n\n- $f(y)$ is negative for $y\\in (-\\infty ,-2)\\cup (0,2).$\n\nWith this in mind, let's study each of the given equations.\n\n- We start by considering ${y}^{′}=y({y}^{2}-4).$\n\nFirst, we see that $f(y)=y(y+2)(y-2),$ so $f(y)=0$ if $y=-2,0,2.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nNow, we can construct a sign table for $f(y)$ as follows: \n\n|  | $(-\\infty ,-2)$ | $(-2,0)$ | $(0,2)$ | $(2,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $y+2$ | $-$ | $+$ | $+$ | $+$ |\n| $y$ | $-$ | $-$ | $+$ | $+$ |\n| $y-2$ | $-$ | $-$ | $-$ | $+$ |\n| $f(y)$ | $-$ | $+$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is negative for $y\\in (-\\infty ,-2)\\cup (0,2),$ and $f(y)$ is positive for $y\\in (-2,0)\\cup (2,\\infty ).$ This corresponds to the arrows shown on the phase line.\n\nTherefore, equation I has the given phase line.\n\n- Next, we consider ${y}^{′}=y(4-{y}^{2}).$\n\nFirst, $f(y)=y(4-{y}^{2}),$ so $f(y)=0$ if $y=-2,0,2.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nHowever, we note that $f(y)>0$ for $y\\in (-\\infty ,-2).$ This does *not* correspond to the arrows shown on the phase line.\n\nTherefore, equation II does not have the given phase line.\n\n- Finally, we consider ${y}^{′}={y}^{2}-4.$\n\nIn this case, $f(y)={y}^{2}-4,$ and the equilibrium solutions are $y=\\pm 2$ only.\n\nTherefore, equation III does not have the given phase line.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186362305 :knowledge-point/_questions [{:db/id #edb/ref 17592186147492 :knowledge-point/id #uuid "6e71c0c9-7dd1-5f09-a55c-96b5bed1ee9a" :knowledge-point/title "Identifying a Differential Equation Corresponding to a Phase Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec7790f1-e74c-577a-9fac-f4ad0834e7c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469916} {:answer/id #uuid "544703b8-aee8-5172-a235-fe2dd9d223f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469917}] :answer-field/correct {:answer/id #uuid "ec7790f1-e74c-577a-9fac-f4ad0834e7c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469916} :answer-field/id #uuid "4d06c494-d9ab-58f8-8aa4-790cf3c7e1f5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470570} {:answer-field/choices [{:answer/id #uuid "f8fc17b6-9029-54fe-8151-860ee2a28ef9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469918} {:answer/id #uuid "f60f0f4a-cd20-50b1-86bc-47b454ff1491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469919}] :answer-field/correct {:answer/id #uuid "f60f0f4a-cd20-50b1-86bc-47b454ff1491" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469919} :answer-field/id #uuid "01975edc-764b-5829-a3ff-c04974e897a0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470571} {:answer-field/choices [{:answer/id #uuid "4fc85124-4b3f-5452-8d24-ba7bad684c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469920} {:answer/id #uuid "f0710156-43ac-518c-bd75-c5d772369c4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469921}] :answer-field/correct {:answer/id #uuid "4fc85124-4b3f-5452-8d24-ba7bad684c33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469920} :answer-field/id #uuid "a21e23dc-b213-5dcc-ab9b-58c4fbcd44f2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "77dc20d1-343d-5ade-92ad-7f182610538c" :question/math-academy-id "q-98643" :question/problem "![](images/96/96740fdcc0dc6aa22fa097ba714669fae4ef79543aafad72b3fc3db7722f83d1.png)\n\nConsider the phase line shown above. Which of the following differential equations could have this phase line?\n\n- $\\frac{\\text{d}y}{\\text{d}x}=-y(y-2)$\n- $\\frac{\\text{d}y}{\\text{d}x}=-y(y-2)^{2}$\n- $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}+2y$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "First, notice that all three differential equations are of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThe phase line gives us the following information:\n\n- The equilibrium solutions are $y=0$ and $y=2.$\n\n- $f(y)$ is positive for $y\\in (-\\infty ,0).$\n\n- $f(y)$ is negative for $y\\in (0,2)\\cup (2,\\infty ).$\n\nWith this in mind, let's study each of the given equations.\n\n- We start by considering ${y}^{′}=-y(y-2).$\n\nFirst, $f(y)=-y(y-2),$ so $f(y)=0$ if $y=0,2.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nHowever, we note that $f(y)>0$ for $y\\in (0,2).$ This does *not* correspond to the arrows shown on the phase line.\n\nTherefore, equation I does not have the given phase line.\n\n- Next, we consider ${y}^{′}=-y(y-2)^{2}.$\n\nFirst, we see that $f(y)=-y(y-2)^{2},$ so $f(y)=0$ if $y=0,2.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nNow, we can construct a sign table for $f(y)$ as follows: \n\n|  | $(-\\infty ,0)$ | $(0,2)$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| $-y$ | $+$ | $-$ | $-$ |\n| $(y-2)^{2}$ | $+$ | $+$ | $+$ |\n| $f(y)$ | $+$ | $-$ | $-$ |\n\n \nSo, we have that $f(y)$ is positive for  $y\\in (-\\infty ,0),$ and $f(y)$ is negative for $y\\in (0,2)\\cup (2,\\infty ).$ This corresponds to the arrows shown on the phase line.\n\nTherefore, equation II has the given phase line.\n\n- Finally, we consider ${y}^{′}={y}^{2}+2y.$\n\nIn this case, $f(y)=y(y+2),$ and the equilibrium solution are $y=-2,0.$ \n\nTherefore, equation III does not have the given phase line.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186362306 :knowledge-point/_questions [{:db/id #edb/ref 17592186147492 :knowledge-point/id #uuid "6e71c0c9-7dd1-5f09-a55c-96b5bed1ee9a" :knowledge-point/title "Identifying a Differential Equation Corresponding to a Phase Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df839928-3f6f-55e0-8ce3-ec178f216622" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469922} {:answer/id #uuid "4f6dbeeb-7472-57c7-bccd-8dabac257990" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469923}] :answer-field/correct {:answer/id #uuid "df839928-3f6f-55e0-8ce3-ec178f216622" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469922} :answer-field/id #uuid "8ee4327d-dc7a-5d44-8201-3e5c06fed984" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470573} {:answer-field/choices [{:answer/id #uuid "c1a270f2-6e76-58ad-b29f-a44eb2c0ae8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469924} {:answer/id #uuid "625f9e50-ee73-5f92-a569-3766007bff23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469925}] :answer-field/correct {:answer/id #uuid "c1a270f2-6e76-58ad-b29f-a44eb2c0ae8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469924} :answer-field/id #uuid "44758402-cc1c-5952-aa33-e66b0505929c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470574} {:answer-field/choices [{:answer/id #uuid "67fab95f-3e9a-5af1-a273-39130055d0b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469926} {:answer/id #uuid "4d49f84f-a402-5b92-826f-647f032b17bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469927}] :answer-field/correct {:answer/id #uuid "4d49f84f-a402-5b92-826f-647f032b17bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469927} :answer-field/id #uuid "88057ab1-b1cf-5762-bfd3-e9cb8a2c8d02" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470575}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23af5cf8-2a07-56b8-9952-fd82e54a4b1d" :question/math-academy-id "q-98646" :question/problem "![](images/54/54cfcbaa5ce20c1881f35e83bb0ec28fa1399cc5100ee745941ff7bb52ac7705.png)\n\nConsider the phase line shown above. Which of the following differential equations could have this phase line?\n\n- $\\frac{\\text{d}y}{\\text{d}x}=-(y+2)^{2}(y-1)$\n- $\\frac{\\text{d}y}{\\text{d}x}=(y+2)(y-1)$\n- $\\frac{\\text{d}y}{\\text{d}x}=-(y+2)(y-1)^{2}$\n\nSelect all that apply.\n\nIf none apply, leave all boxes unchecked." :question/worked-solution "First, notice that all three differential equations are of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThe phase line gives us the following information:\n\n- The equilibrium solutions are $y=-2$ and $y=1.$\n\n- $f(y)$ is positive for $y\\in (-\\infty ,-2).$\n\n- $f(y)$ is negative for $y\\in (-2,1)\\cup (1,\\infty ).$\n\nWith this in mind, let's study each of the given equations.\n\n- We start by considering ${y}^{′}=-(y+2)^{2}(y-1).$\n\nFirst, $f(y)=-(y+2)^{2}(y-1),$ so $f(y)=0$ if $y=-2,1.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nHowever, we note that $f(y)>0$ for $y\\in (-\\infty ,-2)\\cup (-2,1).$ This does *not* correspond to the arrows shown on the phase line.\n\nTherefore, equation I does not have the given phase line.\n\n- Next, we consider ${y}^{′}=(y+2)(y-1).$\n\nFirst, $f(y)=(y+2)(y-1),$ so $f(y)=0$ if $y=-2,1.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nHowever, we note that $f(y)>0$ for $y\\in (-\\infty ,-2)\\cup (1,\\infty ).$ This does *not* correspond to the arrows shown on the phase line.\n\nTherefore, equation II does not have the given phase line.\n\n- Finally, we consider ${y}^{′}=-(y+2)(y-1)^{2}.$\n\nFirst, we see that $f(y)=-(y+2)(y-1)^{2},$ so $f(y)=0$ if $y=-2,1.$ So, the equilibrium solutions correspond to those shown in the phase line.\n\nNow, we can construct a sign table for $f(y)$ as follows: \n\n|  | $(-\\infty ,-2)$ | $(-2,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $-(y+2)$ | $+$ | $-$ | $-$ |\n| $(y-1)^{2}$ | $+$ | $+$ | $+$ |\n| $f(y)$ | $+$ | $-$ | $-$ |\n\nSo, we have that $f(y)$ is negative for $y\\in (-2,1)\\cup (1,\\infty ),$ and $f(y)$ is positive for $y\\in (-\\infty ,-2).$ This corresponds to the arrows shown on the phase line.\n\nTherefore, equation III has the given phase line.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186362310 :knowledge-point/_questions [{:db/id #edb/ref 17592186172051 :knowledge-point/id #uuid "d1af47ea-6253-5d58-9b94-31e52de27106" :knowledge-point/title "Identifying Simply-Connected Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fffacc9e-beec-5b87-a6ad-4054725f30a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469934} {:answer/id #uuid "5a491a09-f7b0-54c0-8c16-31aefd05fbc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469935}] :answer-field/correct {:answer/id #uuid "5a491a09-f7b0-54c0-8c16-31aefd05fbc1" :answer/type {:db/id #edb/ref 17592186