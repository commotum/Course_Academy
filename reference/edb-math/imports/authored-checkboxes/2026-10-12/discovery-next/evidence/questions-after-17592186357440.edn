360717 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07996291-228c-5aab-81a0-016cdb17429a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469854} {:answer/id #uuid "471d4573-9e86-5851-abf5-3565bfdced3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469855}] :answer-field/correct {:answer/id #uuid "07996291-228c-5aab-81a0-016cdb17429a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469854} :answer-field/id #uuid "d4ccfdc4-b209-5f63-93bd-8ff123ffd24a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470539} {:answer-field/choices [{:answer/id #uuid "ea33854f-4808-5e1e-9134-54eb68887705" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469856} {:answer/id #uuid "02afc853-5312-5d80-901a-adb57d701879" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469857}] :answer-field/correct {:answer/id #uuid "02afc853-5312-5d80-901a-adb57d701879" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469857} :answer-field/id #uuid "d5088f28-c1ec-5dcd-83e5-a01e07fff832" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470540} {:answer-field/choices [{:answer/id #uuid "644456d3-862f-56f5-8a87-8c8961c80f7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value