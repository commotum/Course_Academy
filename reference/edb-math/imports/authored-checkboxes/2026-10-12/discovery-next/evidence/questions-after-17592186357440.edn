field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470532}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ad6c2ec-7317-5ae7-9abc-02c44c934889" :question/math-academy-id "q-96748" :question/problem "Which of the following functions has the domain $[2,4]?$\n- **I.** $p:{2,4}\\to R$\n- **II.** $r:[2,4]\\to {2,4}$\n- **III.** $q:R\\to [2,4]$\n\nSelect all that apply." :question/worked-solution "The notation $f:X\\to Y$ means that the function $f$ maps the set $X$ to the set $Y.$ In this case,\n\n- the domain of $f$ is $X,$\n\n- the codomain of $f$ is $Y.$\n\nWith that in mind, let's examine our functions.\n\n- The domain of $p$ is ${2,4},$ the set containing the two numbers $2$ and $4$ only.\n\n- The domain of $q$ is $[2,4],$ the interval from $2$ to $4$ (including $2$ and $4$).\n\n- The domain of $r$ is $R,$ the set of real numbers.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186360715 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba21f2b9-dc90-56de-a26f-1a0704d86668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469842} {:answer/id #uuid "4f5def83-3bf9-5c42-8356-ec3c639037cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469843}] :answer-field/correct {:answer/id #uuid "4f5def83-3bf9-5c42-8356-ec3c639037cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469843} :answer-field/id #uuid "5f05251f-c98c-5a2b-a23e-431c5e0785a9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470533} {:answer-field/choices [{:answer/id #uuid "648dd586-c992-5390-a921-470abe4f47cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469844} {:answer/id #uuid "ab0922cb-d0b5-54b5-91f0-e5cf60a965e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469845}] :answer-field/correct {:answer/id #uuid "648dd586-c992-5390-a921-470abe4f47cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469844} :answer-field/id #uuid "827989bc-52f2-586a-81b5-1aef116edcd5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470534} {:answer-field/choices [{:answer/id #uuid "980c515e-caa4-5cf7-bf8e-1de693b1e245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469846} {:answer/id #uuid "5e06a632-dbf3-5537-888e-f355a5f34d4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469847}] :answer-field/correct {:answer/id #uuid "980c515e-caa4-5cf7-bf8e-1de693b1e245" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469846} :answer-field/id #uuid "b04592ba-c3c0-597c-b837-f4cc1106ab2c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470535}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "777628a7-f0f2-562d-ab61-872a852162b2" :question/math-academy-id "q-96825" :question/problem "Which of the following is the correct interpretation of $f:[-1,1]\\to R?$\n- **I.** The domain of $f$ is $[-1,1]$\n- **II.** The codomain of $f$ is $[-1,1]$\n- **III.** The range of $f$ is $R$\n\nSelect all that apply." :question/worked-solution "The notation \n\n$$\nf:[-1,1]\\to R\n$$\n\nmeans that the function $f$ maps the set $[-1,1]$ to the set $R.$ In this case,\n\n- the domain of $f$ is $[-1,1],$ and\n\n- the codomain of $f$ is $R.$ Note that this is *not* necessarily the range.\n\nAs a result, statements II and III are false, while statement I is true.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186360716 :knowledge-point/_questions [{:db/id #edb/ref 17592186172034 :knowledge-point/id #uuid "1240e42a-92a5-51cc-a80e-3fe1ef0b16f7" :knowledge-point/title "Identifying Codomains and Ranges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "962bd8fb-e1fe-5079-9863-836d376cb047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469848} {:answer/id #uuid "abea238c-8f75-57f1-84e9-f2ddc1e820ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469849}] :answer-field/correct {:answer/id #uuid "abea238c-8f75-57f1-84e9-f2ddc1e820ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469849} :answer-field/id #uuid "4a451e5f-bfe8-5c13-99cb-8caeb46be65a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186470536} {:answer-field/choices [{:answer/id #uuid "3b2ec325-874c-5a72-a581-45f824d66019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186469850} {:answer/id #uuid "1a1cd304-c064-567d-b359-c747a157f612" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186469851}] :answer-field/correct {:answer/id #uuid "1a1cd304-