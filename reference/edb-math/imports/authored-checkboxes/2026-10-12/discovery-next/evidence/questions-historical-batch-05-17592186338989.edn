#{[{:db/id #edb/ref 17592186338989 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a950bae-a0dc-516e-a6da-d49abd3ddb51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336429} {:answer/id #uuid "a4da8b60-1761-5db2-bbc6-23876dc9e1d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337529} {:answer/id #uuid "be6ccf1d-9a89-59b4-bcc1-ec4de6d5b210" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337724} {:answer/id #uuid "da0d2b1d-9554-503f-9437-f6bc4dee0644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337931} {:answer/id #uuid "f4708771-0601-5132-9251-09f500e6cb5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186338167}] :answer-field/correct {:answer/id #uuid "a4da8b60-1761-5db2-bbc6-23876dc9e1d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337529} :answer-field/id #uuid "c988a9b1-2f1a-544f-aff6-2e0d71da90c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20e43566-ea3c-59ee-a80b-84f1522c9eea" :question/math-academy-id "q-71798" :question/problem "Which of the following sets are open?\n\nI. $(-\\infty ,-2)$\n\nII. $(0,2]\\cup [7,9]$\n\nIII. $[-5,-1]\\cup (2,4)$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-\\infty ,-2)$ is open. The boundary point of the set is $-2$ and it does not lie in the set.\n\nThe other sets are not open because:\n\n- $(0,2]\\cup [7,9]$ has four boundary points $0$, $2$, $7$, and $9$, and the points $2$, $7$, and $9$ lies in the set.\n\n- $[-5,-1]\\cup (2,4)$ has four boundary points $-5$, $-1$, $2$, and $4$, and the points $-5$ and $-1$ lie in the set.\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186338991 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0012e9cc-af21-59ec-a97b-dcb82f9e5ddb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336030} {:answer/id #uuid "1dab3ced-c7f9-566a-9417-2e0b27a6a4c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336308} {:answer/id #uuid "4b26b5b0-3a27-5c4f-a158-69cddf0a1bd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336726} {:answer/id #uuid "7bc0d3b6-9b69-5865-97af-0b453225227a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337151} {:answer/id #uuid "8fe019e4-4f70-504a-a6c3-0a622e10ef27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337332}] :answer-field/correct {:answer/id #uuid "1dab3ced-c7f9-566a-9417-2e0b27a6a4c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336308} :answer-field/id #uuid "91b4065d-5e15-57b6-820e-26f308d7946b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338547}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be4bb9a2-432f-5bf7-aa6c-466035df5777" :question/math-academy-id "q-71802" :question/problem "Which of the following sets are open?\n\n- $[-7,1]$\n- $(-1,3]\\cup [4,5)$\n- $(-5,-1)$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $(-5,-1)$ is open. The boundary points are $-5$, and $-1.$ None of them lie in the set.\n\nThe other sets are not open because:\n\n- $[-7,1]$ has two boundary points $-7$, and $1$, and both of them lie in the set.\n\n- $(-1,3]\\cup [4,5)$ has four boundary points $-1$, $3$, $4$, and $5$, and the points $3$ and $4$ lie in the set.\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186338993 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39cf0de3-8586-5a80-9765-fc15ba42c46e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336576} {:answer/id #uuid "58acf433-8e2d-5202-98f0-948f7ab6f841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336842} {:answer/id #uuid "744377f7-616f-53fe-8956-33395bca738f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337078} {:answer/id #uuid "9faf3b1c-83dd-58e9-94dc-8563f19f9873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337477} {:answer/id #uuid "a15f9904-0853-571b-95c3-d7479f11a3ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337494}] :answer-field/correct {:answer/id #uuid "9faf3b1c-83dd-58e9-94dc-8563f19f9873" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337477} :answer-field/id #uuid "7f7b347c-d8ac-5574-a932-e414cda7b1ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338503}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1615097-eb1e-5984-b134-50e4277f6126" :question/math-academy-id "q-71814" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}:\\text{ }x<y<{x}^{2},\\,1<x\\le 2\\}$\n\nII. $\\{(x,y)\\in {R}^{2}:\\text{ }2<y<x\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}:\\text{ }4\\le {x}^{2}+{y}^{2}<9\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,3).$ On the other hand, it does not contain some other boundary points, for example, the point $(2,2).$\n\n- The second set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,0).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186338994 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034ee953-8e42-5d4f-9ffd-643223680ded" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186336061} {:answer/id #uuid "6e2e659c-5d07-52c4-b526-23b3bfb65498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337010} {:answer/id #uuid "a6ee5674-04b9-5043-b281-83cb64765c0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337542} {:answer/id #uuid "b5423d8f-866a-57fb-bf8c-161986bd620e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337645} {:answer/id #uuid "ba69c603-d9dc-5d2b-97b6-5045ea9697f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337683}] :answer-field/correct {:answer/id #uuid "6e2e659c-5d07-52c4-b526-23b3bfb65498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337010} :answer-field/id #uuid "81c3396a-b700-5d8b-a2a8-a611018f6a4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8018b9d7-b35d-54ca-b97a-1ac935d3c057" :question/math-academy-id "q-71815" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}:\\text{ }2x+y<6,\\,0<x<3}$\n- ${(x,y)\\in {R}^{2}:\\text{ }1\\le x<3,\\,2<y\\le 4}$\n- ${(x,y)\\in {R}^{2}:\\text{ }2{x}^{2}+3{y}^{2}<6}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,4).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third set is *open *since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186338997 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72e2207b-6055-51e8-b7a7-061a705d6dd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337066} {:answer/id #uuid "c144e221-9cad-536d-88a0-6a790cfd45a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337748} {:answer/id #uuid "ce3e80f8-20a8-5657-8f6a-fe53342b0195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337837} {:answer/id #uuid "d1da01dd-af9e-59c1-b556-cce9316f423b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337869} {:answer/id #uuid "fe1efdb1-2fef-576a-9d2e-70d7b90bcb04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186338260}] :answer-field/correct {:answer/id #uuid "c144e221-9cad-536d-88a0-6a790cfd45a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337748} :answer-field/id #uuid "a372a90e-3a78-5b4d-91cf-9dfd092483e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef298213-bf03-538b-9273-2913d7465266" :question/math-academy-id "q-71819" :question/problem "Which of the following sets are neither open nor closed?\n\nI. $\\{(x,y)\\in {R}^{2}\\,:\\,1\\le x\\le 3,\\,0<{y}^{2}\\le 2\\}$\n\nII. $\\{(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}<9,\\,1<{y}^{2}<4\\}$\n\nIII. $\\{(x,y)\\in {R}^{2}\\,:\\,0\\le x<1,\\,{y}^{2}<4\\}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(1,\\sqrt{2}).$ On the other hand, it does not contain some boundary points, for example, the point $(1,0).$\n\n- The second set is *open* since it doesn't contain any point of its boundary (all the corresponding inequalities are strict).\n\n- The third set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(0,0).$ On the other hand, it does not contain some other boundary points, for example, the point $(0,2).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186338998 :knowledge-point/_questions [{:db/id #edb/ref 17592186192765 :knowledge-point/id #uuid "5c6044dc-d4a7-5662-a825-3c13e49d198a" :knowledge-point/title "Identifying Sets That are Neither Open Nor Closed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4acd24fd-f5ea-50cf-9dad-9929014c3768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336720} {:answer/id #uuid "78c37609-0b21-50bd-824a-787ead460fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337119} {:answer/id #uuid "7d1050c0-4e22-52bb-bd91-b38c648eab7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337157} {:answer/id #uuid "b528becf-dbd1-5ac8-ba44-16cb5d5d19c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337641} {:answer/id #uuid "dd75987b-7a23-561a-b0f8-99cc85254680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337958}] :answer-field/correct {:answer/id #uuid "b528becf-dbd1-5ac8-ba44-16cb5d5d19c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337641} :answer-field/id #uuid "ad5cf70d-5c88-583b-b888-85260ecff5c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d61f9b2d-e5ea-58f1-be0f-837958c85bd6" :question/math-academy-id "q-71820" :question/problem "Which of the following sets are neither open nor closed?\n\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}<1}$\n- ${(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}<9,\\,1<y\\le 4}$\n- ${(x,y)\\in {R}^{2}\\,:\\,{x}^{2}+{y}^{2}\\le 9}$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nLet's examine our sets in turn.\n\n- The first set is *open* since it doesn't contain any point of its boundary (the corresponding inequality is strict).\n\n- The second set is *neither open nor closed*. It contains some of its boundary points, for example, the point $(2,4).$ On the other hand, it does not contain some other boundary points, for example, the point $(3,2).$\n\n- The third is *closed* since it contains all its boundary points (the corresponding inequality is not strict).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186339016 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25bf70ff-b994-5535-8efe-5e571a827da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186336384} {:answer/id #uuid "3d2c2ef0-4441-556c-91d1-869591ce8b28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $T$ only" :db/id #edb/ref 17592186336609} {:answer/id #uuid "974473d9-6217-5b21-b771-e42c139b5bb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186337409} {:answer/id #uuid "eccc2950-0821-56f5-a1c8-330d5b81af47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186338097} {:answer/id #uuid "f7124a5c-f1e9-5c26-9aa6-b10cf5197f80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186338198}] :answer-field/correct {:answer/id #uuid "25bf70ff-b994-5535-8efe-5e571a827da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ and $S$ only" :db/id #edb/ref 17592186336384} :answer-field/id #uuid "8e04abee-98c1-555b-a5ad-820352237a1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6118feb2-c751-599a-b3b9-c8c760c49b6d" :question/math-academy-id "q-71934" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nR=[\\begin{aligned}5 & 2 \\\\ 10 & 4\\end{aligned}],\\,S=[\\begin{aligned}15 & 0 \\\\ 1 & -1 \\\\ 10 & 0\\end{aligned}],\\,T=[\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $R$, we have\n\n$$\ndet(R)=5\\cdot 4-10\\cdot 2=0.\n$$\n\nBecause $det(R)=0,$ we conclude that $R$ is not invertible.\n\n- The matrix $S$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $T$, we have\n\n$$\ndet(T)=2\\cdot 2-(-2)\\cdot 2=8.\n$$\n\nBecause $det(T)\\ne 0,$ we conclude that $T$ is invertible.\n\nTherefore, only $R$ and $S$ do not have an inverse."}] [{:db/id #edb/ref 17592186339017 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe7a17e-699b-5815-9a3e-8c195290665d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ only" :db/id #edb/ref 17592186336634} {:answer/id #uuid "4fe808c6-8c78-5b74-b734-4332d2bbc55a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Z$ only" :db/id #edb/ref 17592186336765} {:answer/id #uuid "c4c41241-68f5-537f-a2f4-36ef3a8fa0d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ and $Z$ only" :db/id #edb/ref 17592186337782} {:answer/id #uuid "ea3208fb-30da-50b9-a09e-289044fe0c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Y$ only" :db/id #edb/ref 17592186338075} {:answer/id #uuid "f80e89dd-c652-5265-923f-af822d38aa7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ and $Y$ only" :db/id #edb/ref 17592186338206}] :answer-field/correct {:answer/id #uuid "3fe7a17e-699b-5815-9a3e-8c195290665d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$X$ only" :db/id #edb/ref 17592186336634} :answer-field/id #uuid "975bdda1-4123-5df1-96af-d7afaa2e70d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338556}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f09c20fa-fbe3-5a9f-8218-d2a4dd2af13c" :question/math-academy-id "q-71938" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nX=[\\begin{aligned}2 & 1 \\\\ -4 & 6 \\\\ 10 & 0\\end{aligned}],\\,Y=[\\begin{aligned}6 & 5 \\\\ 7 & 6\\end{aligned}],\\,Z=[\\begin{aligned}-2 & 1 \\\\ 10 & 5\\end{aligned}].\n$$" :question/worked-solution "- The matrix $X$ is a $3\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $Y$, we have\n\n$$\ndet(Y)=6\\cdot 6-7\\cdot 5=1.\n$$\n\nBecause $det(Y)\\ne 0,$ we conclude that $Y$ is invertible.\n\n- For the matrix $Z$, we have\n\n$$\ndet(Z)=(-2)\\cdot 5-10\\cdot 1=-20.\n$$\n\nBecause $det(Z)\\ne 0,$ we conclude that $Z$ is invertible.\n\nTherefore, only $X$ does not have an inverse."}] [{:db/id #edb/ref 17592186339061 :knowledge-point/_questions [{:db/id #edb/ref 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2010236d-47fb-566d-af0c-b027bf90808c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186336331} {:answer/id #uuid "3cad5ca4-81de-5679-b6a5-afb792473624" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336604} {:answer/id #uuid "60293a1e-e9b9-5afd-9f24-67ec9dc41d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336902} {:answer/id #uuid "b561e370-ef46-5cc5-bdd6-66e8842c1d9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337647} {:answer/id #uuid "e0b347c1-0e4e-5f8a-b185-d8391cccc11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337993}] :answer-field/correct {:answer/id #uuid "b561e370-ef46-5cc5-bdd6-66e8842c1d9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186337647} :answer-field/id #uuid "166535c1-1bd7-5b6b-be78-91bf0ba1824c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2073d8ee-8ecd-594e-9fd2-e836c959a0b9" :question/math-academy-id "q-72130" :question/problem "Which of the following equalities are true given that\n$D={(x,y)\\,:\\,1\\le x\\le 2,\\,\\frac{1}{2}\\le y\\le 1}.$\n\n- ${∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A={\\int }_{1}^{2}{\\int }_{1/2}^{1}y\\operatorname{ln}⁡(x)\\,\\text{d}x\\,\\text{d}y$\n- ${∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A={\\int }_{1/2}^{1}{\\int }_{1}^{2}y\\operatorname{ln}⁡(x)\\,\\text{d}y\\,\\text{d}x$\n- ${∬}_{D}y\\operatorname{ln}⁡(x)\\text{d}A={\\int }_{1}^{2}{\\int }_{1/2}^{1}y\\operatorname{ln}⁡(x)\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that:\n\n- the limits for the variable $x$ are from $1$ to $2$, and\n\n- the limits for the variable $y$ are from $\\frac{1}{2}$ to $1.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A & ={\\int }_{1/2}^{1}[{\\int }_{1}^{2}y\\operatorname{ln}⁡(x)\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}y\\operatorname{ln}⁡(x)\\,\\text{d}A={\\int }_{1}^{2}[{\\int }_{1/2}^{1}y\\operatorname{ln}⁡(x)\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186339067 :knowledge-point/_questions [{:db/id #edb/ref 17592186129166 :knowledge-point/id #uuid "d8f012d0-444a-5035-8a72-a053de312d63" :knowledge-point/title "Changing the Order of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e17575-0ade-5823-9fa0-2fc5cba651ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336564} {:answer/id #uuid "3c61013d-7f45-566e-9c1f-dc853c17ca02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336602} {:answer/id #uuid "4c80e22b-9d6e-5774-90f6-d056de93d371" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336744} {:answer/id #uuid "890f0155-82db-50f6-b377-11c22d644867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337268} {:answer/id #uuid "a966105f-7c64-5390-a6c1-44e721cc4739" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337561}] :answer-field/correct {:answer/id #uuid "4c80e22b-9d6e-5774-90f6-d056de93d371" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336744} :answer-field/id #uuid "e2d07712-dafc-5310-b4ad-bbf99bc2af70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4009c26-3316-54ec-b0bf-1d56ecb8b0b0" :question/math-academy-id "q-72175" :question/problem "Which of the following equalities are true given that\n$D={(x,y)\\,:\\,0\\le x\\le \\sqrt{2},\\,-\\sqrt{3}\\le y\\le 2}.$\n\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{0}^{\\sqrt{2}}{\\int }_{-\\sqrt{3}}^{2}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x$\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{-\\sqrt{3}}^{2}{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}x\\,\\text{d}y$\n- ${∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{-\\sqrt{3}}^{2}{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y\\,\\text{d}x$" :question/worked-solution "We notice that:  \n\n- the limits for the variable $x$ are from $0$ to $\\sqrt{2}$, and\n\n- the limits for the variable $y$ are from $-\\sqrt{3}$ to $2.$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A & ={\\int }_{-\\sqrt{3}}^{2}[{\\int }_{0}^{\\sqrt{2}}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}x]\\text{d}y.\\end{aligned}\n$$\n\nNow, since the region of integration is rectangular, we can simply swap the order of integration. This gives\n\n$$\n{∬}_{D}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}A={\\int }_{0}^{\\sqrt{2}}[{\\int }_{-\\sqrt{3}}^{2}\\sqrt{1+{x}^{2}{y}^{2}}\\,\\text{d}y]\\text{d}x.\n$$\n\nSo, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186339069 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17be251d-7119-505a-822a-7b4f4a540bc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336254} {:answer/id #uuid "28248254-c521-555f-a8eb-3698fd411628" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186336409} {:answer/id #uuid "54358dc3-968d-51c2-b7a6-0a9e65676557" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336809} {:answer/id #uuid "559f9ad0-2178-5631-a30c-df72edf7e3d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336818} {:answer/id #uuid "55dfee5e-aee0-54ba-a2ef-8bb2f5c930f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336821}] :answer-field/correct {:answer/id #uuid "17be251d-7119-505a-822a-7b4f4a540bc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336254} :answer-field/id #uuid "acf0a001-ed03-592c-9465-79a8c55ab0a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338594}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0bcd8034-22f3-5298-b8d3-b69cdcbc84fc" :question/math-academy-id "q-72185" :question/problem "Which of the following statements are true regarding the finite region inside the circumference ${x}^{2}+{y}^{2}=1?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=1\\, & ⟹\\,x=\\pm \\sqrt{1-{y}^{2}} \\\\ {x}^{2}+{y}^{2}=1\\, & ⟹\\,y=\\pm \\sqrt{1-{x}^{2}}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](images/09/0960063edcce8ccd55dc2f77147c4a4982645c180e8b998d7e520c65131ea045.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le \\sqrt{1-{x}^{2}}\\}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-1\\le y\\le 1,\\,-\\sqrt{1-{y}^{2}}\\le x\\le \\sqrt{1-{y}^{2}}\\}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186339070 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d5dfdf6-e50a-544c-a082-757d6a3cc45e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336750} {:answer/id #uuid "6f3a5eba-d4b1-5a73-b36e-ccfbf5537a92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337017} {:answer/id #uuid "71d9509f-880d-594a-ad0c-8f134a4a17bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337050} {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337256} {:answer/id #uuid "fc897d08-7b5c-5946-a0d6-80162b7a9c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186338252}] :answer-field/correct {:answer/id #uuid "87c90cf0-1d0a-5ecb-9f7d-4e9022a09814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337256} :answer-field/id #uuid "5dc16394-01fd-51be-9be9-07cf0cfe3cbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f581ab20-43e5-59a8-ac58-914378a7361e" :question/math-academy-id "q-72186" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/6f/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD=\\{(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}\\}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/76/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186339071 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05b81e3f-060b-5845-a303-b88224da1581" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336078} {:answer/id #uuid "46f070d3-ed05-5034-af82-a9adf57c60b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336690} {:answer/id #uuid "4deab650-a626-55f2-b9af-f7b4ccb3ee34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186336755} {:answer/id #uuid "5e1230df-1cda-5e95-8f8f-00f39e16c196" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186336882} {:answer/id #uuid "cf98decd-9264-56e3-850f-4cfdc80409db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337849}] :answer-field/correct {:answer/id #uuid "46f070d3-ed05-5034-af82-a9adf57c60b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336690} :answer-field/id #uuid "08cff232-9d15-5600-89b1-e7cd0fac0002" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338291}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b03842bf-e94f-5526-903d-de5a2a3bccca" :question/math-academy-id "q-72187" :question/problem "Which of the following statements are true regarding the finite region bounded between the circles ${x}^{2}+{y}^{2}=2$ and ${x}^{2}+{y}^{2}=1?$\n\nI. It is a type I region\n\nII. It is a type II region\n\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/28/28290c5530efd27a979f4284481ca7e0384342d7d426dde0ab36894a0d77a166.png)\n\nWe have the following:\n\n- The vertical line $x=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/30/3007cffb725faee44d2a06ad077eec630791b1a94c373a323f62d0d721c87207.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/38/383f88668435556d3a856cf852caf548b1f1bf3a90d50f9d85d7968188984804.png)\n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186339126 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45d99b9d-5704-58cf-919d-6915dcae3299" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186336680} {:answer/id #uuid "52468b8e-d113-5efc-a093-9eec57bc9b1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186336789} {:answer/id #uuid "77b4fe93-508f-553a-8b98-740710c54788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186337110} {:answer/id #uuid "dfcedb6f-7df8-5c52-95d7-61e9b09424a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186337986} {:answer/id #uuid "fbe12b6b-39a0-5ff6-a668-5408621fc8b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186338243}] :answer-field/correct {:answer/id #uuid "77b4fe93-508f-553a-8b98-740710c54788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186337110} :answer-field/id #uuid "3d4379a0-d5ee-50fe-b962-654c0a9cb62f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338384}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ddf8ccb-f483-5bbe-8662-ef5250ea89a5" :question/math-academy-id "q-72489" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{aligned}],\\,C=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 5 & 1 \\\\ 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\n- The matrix $B$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nB=[\\begin{aligned}1 & 0 & 3 & 4 & -2 \\\\ 0 & 0 & 0 & 0 & 0 \\\\ 0 & 0 & 1 & 4 & 4\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}0 & 0 & 0 \\\\ 0 & 0 & -1 \\\\ 0 & -1 & 0 \\\\ 4 & 0 & 7 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are **not** in row echelon form."}] [{:db/id #edb/ref 17592186339127 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "022a93a6-705d-525b-a6ed-eb10665cd446" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186336051} {:answer/id #uuid "252169cb-b78a-5e0c-a6be-164c180eae59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186336381} {:answer/id #uuid "2806d007-25ff-5cf7-bbf1-c3e504570ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186336405} {:answer/id #uuid "380294b6-401a-5a3f-a8b6-b3b07de91291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186336553} {:answer/id #uuid "7f80b45e-e58f-5638-a324-065ed3129df7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186337188}] :answer-field/correct {:answer/id #uuid "2806d007-25ff-5cf7-bbf1-c3e504570ea6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186336405} :answer-field/id #uuid "ecf9782f-4e02-54dd-b3fd-efc5b9df2009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "937eaf0d-76e6-56ec-a651-23458856322a" :question/math-academy-id "q-72498" :question/problem "Which of the following matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$  is not in row echelon form since ${a}_{32}\\ne 0$ (condition II is violated). \n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 2 & 0 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 1\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}0 & 4 & 6 & 10 \\\\ 0 & 0 & 6 & 7 \\\\ 0 & 0 & 0 & 1\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nC=[\\begin{aligned}3 & 5 & 0 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 3 & 4 & 1\\end{aligned}]\n$$\n\nTherefore, only $B$ is in row echelon form."}] [{:db/id #edb/ref 17592186341835 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f8be93a-652f-57e0-8d38-bcd230082b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186340274} {:answer/id #uuid "b8f562f0-2895-533d-b1a7-b975b9fe7bb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186340787} {:answer/id #uuid "befdff1d-4580-52ec-be14-2fa18ba303c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186340831} {:answer/id #uuid "cef2d373-08dc-51b2-a572-5824121784fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186340968} {:answer/id #uuid "f84f8da1-987d-5353-91bb-4a28605cc356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186341325}] :answer-field/correct {:answer/id #uuid "b8f562f0-2895-533d-b1a7-b975b9fe7bb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186340787} :answer-field/id #uuid "cbc4fdb1-28ec-53bb-808c-40da78982aca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341739}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4f7d9000-6b1e-59bb-84e6-86f972afc228" :question/math-academy-id "q-72570" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{aligned}],\\,\\,B=[\\begin{aligned}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{aligned}],\\,\\,C=[\\begin{aligned}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & -4 & 9 & 7 \\\\ 0 & 0 & 5 & 3\\end{aligned}]\n$$\n\n- The matrix $B$  is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}0 & 2 & 0 & 2 & 5 \\\\ 0 & 0 & 1 & 0 & 3 \\\\ 0 & 0 & 0 & 11 & 1\\end{aligned}]\n$$\n\n- The matrix $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}7 & 6 & 6 & 8 & 2 \\\\ 0 & 1 & 3 & 6 & 3 \\\\ 0 & 0 & 0 & 4 & 6\\end{aligned}]\n$$\n\nTherefore, only $B$ and $C$ are in row echelon form."}] [{:db/id #edb/ref 17592186341837 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac7ba1b-b723-5280-92ad-4c9f642b3f93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186339954} {:answer/id #uuid "7c6f0a64-f7aa-5222-8fb4-a8d2f3e74b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186340248} {:answer/id #uuid "a43eda66-5103-58ad-a759-656e383e2463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186340618} {:answer/id #uuid "bc9daa56-0bd1-51f3-ba11-66f6510ea1da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186340814} {:answer/id #uuid "e3046a5c-b97e-5253-ad4c-9e218fcb631f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186341137}] :answer-field/correct {:answer/id #uuid "7c6f0a64-f7aa-5222-8fb4-a8d2f3e74b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186340248} :answer-field/id #uuid "25f51ed4-31e6-5d99-abf8-f209f3fd72ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341446}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c409d434-4c7f-59fa-9d55-4c82bc621cc5" :question/math-academy-id "q-72574" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{aligned}],\\,\\,B=[\\begin{aligned}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{aligned}],\\,\\,C=[\\begin{aligned}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied). \n\n$$\nA=[\\begin{aligned}6 & 0 & 0 & 8 & 2 \\\\ 0 & 4 & 0 & 2 & 3 \\\\ 0 & 0 & 0 & 1 & 5\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}8 & 7 & 5 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 9\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition  II is violated).\n\n$$\nC=[\\begin{aligned}0 & 1 & 0 & 7 \\\\ 3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 5\\end{aligned}]\n$$\n\nTherefore, only $A$ and $B$ are in row echelon form."}] [{:db/id #edb/ref 17592186341838 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05490973-f9e5-5e64-ba65-4e2fea411064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186339167} {:answer/id #uuid "326890e9-4656-517c-8e21-551f43e4b4b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186339572} {:answer/id #uuid "3454ef84-206a-5201-9156-5622a49f30dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186339593} {:answer/id #uuid "5fa11633-8afd-5d03-ab16-bb473b613354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186339980} {:answer/id #uuid "e6714207-3005-5ade-af54-df6eaa9a8613" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186341167}] :answer-field/correct {:answer/id #uuid "05490973-f9e5-5e64-ba65-4e2fea411064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186339167} :answer-field/id #uuid "63681ebc-7c8e-5281-86d6-7870a0940d7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d3c090e-cc4f-51d5-a663-f597f7113489" :question/math-academy-id "q-72576" :question/problem "Which of the following augmented matrices are in row echelon form?\n\n$$\nA=[\\begin{aligned}2 & 1 & 3 \\\\ 0 & 0 & 5 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & -2\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & 5\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 5 & 8 \\\\ 1 & -4 & 0 & 6 \\\\ 0 & 0 & 2 & 4\\end{aligned}].\n$$" :question/worked-solution "Remember that an augmented matrix is in row echelon form if its coefficient matrix satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the bottom of the matrix.\n- Each leading entry of a row is in a column to the right of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the second row contains only zeros and it is not at the bottom of the matrix (condition I is violated).\n\n$$\nA=[\\begin{aligned}2 & 1 & 3 \\\\ 0 & 0 & 5 \\\\ 0 & 2 & -1 \\\\ 0 & 0 & -2\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & -2 & 1 & 2 \\\\ 0 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & 5\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since ${c}_{21}\\ne 0$ (condition II is violated).\n\n$$\nC=[\\begin{aligned}2 & 0 & 5 & 8 \\\\ 1 & -4 & 0 & 6 \\\\ 0 & 0 & 2 & 4\\end{aligned}]\n$$\n\nTherefore, only $B$ is in row echelon form."}] [{:db/id #edb/ref 17592186341908 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ab5c9a-741e-507f-8a99-07a9f7aa451c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339588} {:answer/id #uuid "3bf55990-23dc-5693-8dde-0dd252a432b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186339663} {:answer/id #uuid "48fe273f-13eb-5f78-8272-5b9b3a2db061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186339782} {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} {:answer/id #uuid "ea2ab1df-0cb6-5919-a2be-e9cca71bcc58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341194}] :answer-field/correct {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} :answer-field/id #uuid "bf84d3cb-0dfa-513a-bcdd-3183ad8dee6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79464211-37d1-5cac-b164-284bb9d9308a" :question/math-academy-id "q-73105" :question/problem "![](images/ad/ad3fb8a0cce2a6dac706d7876aca0a2339fe49c05cb7aa6ae54de86735ceafab.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nI. The function is left-continuous at $x=3$\n\nII. The function is right-continuous at $x=3$\n\nIII. The function is continuous at $x=3$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=3,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=3\\ne 1=f(3)\n$$\n\n- Statement II is true. The function is right-continuous at $x=3,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=1=f(3)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=3,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186341909 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44870b19-7de8-568b-9bca-2faf7aacb656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186339734} {:answer/id #uuid "6d08a5ce-252a-5950-9158-72ef68730a92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340088} {:answer/id #uuid "b1f89edf-e35a-52a7-8ca1-d55f110862dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340749} {:answer/id #uuid "c8ddd360-ea1a-5bee-8ba6-6e9b7129a9e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340908} {:answer/id #uuid "e9c70b93-5d4c-58f2-989d-44cba9e4cf22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341192}] :answer-field/correct {:answer/id #uuid "44870b19-7de8-568b-9bca-2faf7aacb656" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186339734} :answer-field/id #uuid "dce5165d-a261-5af6-ae8f-5e3cff741926" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341769}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1f47bb47-6168-5cb8-92db-b7a3fc493275" :question/math-academy-id "q-73106" :question/problem "![](images/89/89dca4b059ccbd1fe93d000acabcbd33b5fc10389de48ef3cbae65cb4455f29e.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=1$\n- The function is right-continuous at $x=1$\n- The function is continuous at $x=1$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)=1\\ne 3=f(1)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)=1\\ne 3=f(1)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."}] [{:db/id #edb/ref 17592186341927 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "195bda69-5d84-5c1f-93f1-061ff6e7af90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339351} {:answer/id #uuid "1d3d3665-b6a6-5975-9783-9af879c2d659" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339383} {:answer/id #uuid "582777b8-345a-5528-a5bf-6cb7f361b239" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339931} {:answer/id #uuid "ac7998fd-d3d9-5720-bee0-6d1d6f6064f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340701} {:answer/id #uuid "f1bb4be9-df0f-5398-8fd0-b36df3ca0d06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341257}] :answer-field/correct {:answer/id #uuid "ac7998fd-d3d9-5720-bee0-6d1d6f6064f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340701} :answer-field/id #uuid "a43e6b64-3905-50fe-84a0-c65639ebeb11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9eb34e90-018e-520a-8053-32b72e25bff0" :question/math-academy-id "q-73249" :question/problem "![](images/ec/ec8101640f2bd84506d1c47b92f088675080d87eafff4000a4f3e0d14ccebb55.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\n- The function is continuous at $x=-2$\n- The function is continuous at $x=1$\n- The function is differentiable at $x=1$" :question/worked-solution "- Statement I is false. From the graph we can see that $f(x)$ has a jump discontinuity at $x=-2.$\n\n- Statement II is true. The graph can be drawn in a neighborhood of $x=1$ without taking the pencil off the paper.\n\n- Statement III is false. The graph of $f(x)$ shows a cusp at this point and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341928 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3115a701-908d-5194-89b5-3934f2aee943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339559} {:answer/id #uuid "3ef63771-16e0-5c66-87bb-9773a47f39ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339696} {:answer/id #uuid "4084d34d-cdd6-5521-90d7-5d09fec010be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339705} {:answer/id #uuid "5f7cee9c-67f1-509a-a047-56e0f6f1ef9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339975} {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567}] :answer-field/correct {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567} :answer-field/id #uuid "941f6918-d68b-5b25-9b9f-c8698c202566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa88d46b-d2ce-5164-bbed-10d691e29ef6" :question/math-academy-id "q-73250" :question/problem "![](images/a8/a8a70a2f28585b63d2a083b42eb6ad54bfb581b5f13c699a3bc3c8d836afaee8.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=1$\n\nII. The function is continuous at $x=0$\n\nIII. The function is differentiable at $x=0$" :question/worked-solution "- Statement I is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$\n\n- Statement II is true. The graph can be drawn in a neighborhood of $x=0$ without taking the pencil off the paper.\n\n- Statement III is false. The function $f(x)$ has a corner point at $x=0$ and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341929 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43206143-d3e7-5558-906d-23db6302ae10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339717} {:answer/id #uuid "5aac758e-2f12-517d-8ce4-fe8a5696f212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339951} {:answer/id #uuid "9c49a7a3-a3b7-5ac2-9f14-8aeb96443d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340536} {:answer/id #uuid "be0a87e6-ce52-5475-84fa-d3314aa5b89d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340822} {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093}] :answer-field/correct {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093} :answer-field/id #uuid "315e5c79-1bab-5a2f-a733-2981ea179e3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7ec702-6570-50d7-8199-a59c190c3e40" :question/math-academy-id "q-73252" :question/problem "![](images/1f/1f2d8b9faac6c300b41902cea5065bf8bafb02c137232ee79779a4dc3ff67f33.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=-1$\n\nII. The function is differentiable at $x=1$\n\nIII. The function is continuous at $x=2$" :question/worked-solution "- Statement I is true. The graph can be drawn in a neighborhood of $x=-1$ without taking the pencil off the paper.\n\n- Statement II is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$ So, it can't be differentiable there.\n\n- Statement III is true. The graph can be drawn in a neighborhood of $x=2$ without taking the pencil off the paper.\n\nTherefore, only statements I and III  are true."}] [{:db/id #edb/ref 17592186341975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9c9d7d-cafe-5ca3-aeda-6ab3a8844c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339402} {:answer/id #uuid "466f898a-a17d-5ef2-9df7-de21d4467270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339753} {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} {:answer/id #uuid "71573f37-88c6-5316-841b-9e7cbf18b8f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340135} {:answer/id #uuid "9acfcc52-3763-5eb4-9f6b-ab6d62822c30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340525}] :answer-field/correct {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} :answer-field/id #uuid "8811fa51-bfe6-5509-90af-f31705a35d36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbdd6305-e297-593d-89f4-fb7ada8ade14" :question/math-academy-id "q-73455" :question/problem "![](images/de/de39663db59e42565c7d69d8a44a4cb95f14af0f4946b77cfc42eac02f7d2786.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\nI. $[-\\pi ,\\pi ]$\n\nII. $[-\\pi ,0)$\n\nIII. $[1,\\pi ]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\pi ]$ is closed,but the function has a removable discontinuity at $x=0.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[-\\pi ,0)$ is not closed, so, the extreme value theorem is not applicable.\n\n- The interval $[1,\\pi ]$ is closed, and the function is continuous on $[1,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341981 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2667e8a9-ad2e-5060-ac38-bc2c70de2517" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339462} {:answer/id #uuid "625380bb-0130-5ea5-a938-fd4c6911619a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340005} {:answer/id #uuid "6e925fcb-aeca-55f4-a2d0-bdc171bc4053" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340107} {:answer/id #uuid "91fa11e7-ee32-5b9c-b3e7-3b327d3b922a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340438} {:answer/id #uuid "ff71884c-52b4-575e-b1f2-db8af6ee5dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341380}] :answer-field/correct {:answer/id #uuid "ff71884c-52b4-575e-b1f2-db8af6ee5dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341380} :answer-field/id #uuid "8e8ea3ae-c1eb-57e3-9b69-648b0d966d96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b5c08f3-5fbe-50f0-8681-6cf3ebc354c4" :question/math-academy-id "q-73463" :question/problem "![](images/4d/4de4aa4956b0b70e6e08c9f0188944469270ab19501194ce897e2af9411a0d98.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\n- $[-\\pi ,\\frac{\\pi }{2}]$\n- $[0,\\pi ]$\n- $(-\\frac{\\pi }{2},\\frac{\\pi }{2}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\frac{\\pi }{2}]$  is closed, but the function has a removable discontinuity at $x=-\\frac{\\pi }{2}.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[0,\\pi ]$ is closed, and the function is continuous on $[0,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(-\\frac{\\pi }{2},\\frac{\\pi }{2}]$  is not closed, so, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341984 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85ec74-7261-5a84-b268-2cb5156ec3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339237} {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} {:answer/id #uuid "696a6442-ff9a-551c-9da2-c842f797cf3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340065} {:answer/id #uuid "85e6b77c-a45a-52cf-b8c9-1652a4b8a948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340328} {:answer/id #uuid "facb3de9-0178-54cd-b07c-1c80bbb75fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341346}] :answer-field/correct {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} :answer-field/id #uuid "217a3a4a-e905-59b0-918b-c92be80eb6b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "122f233b-5382-5fef-8fbd-2b8682266e28" :question/math-academy-id "q-73481" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\sqrt[4]{x}}{{x}^{2}+1}?$   \n\nI. $[-1,5]$\n\nII. $[0,2]$\n\nIII. $[2,5]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,5]$ is closed, but the function is not continuous on it because $\\sqrt[4]{x}$ is not defined anywhere in the subinterval $[-1,0).$  Therefore, the extreme value theorem is not applicable.\n\n- The intervals $[0,2]$ and $[2,5]$ are closed, and the function is continuous on each of these intervals Therefore, the extreme value theorem is applicable on each $[0,2]$  and $[2,5].$\n\nIn conclusion, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186341985 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24811889-2c2a-5489-87b6-7ec9fcc9ec5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339445} {:answer/id #uuid "49559a38-7682-51c6-961d-af8f6d4b9c7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339786} {:answer/id #uuid "8e550649-e7ec-521f-b83e-ccfcdfe9298e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340407} {:answer/id #uuid "b182cd8c-78d4-5443-bfc8-d64291dce17e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340743} {:answer/id #uuid "b2f9dc50-f6a9-5e82-a931-a20f17095169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340755}] :answer-field/correct {:answer/id #uuid "b182cd8c-78d4-5443-bfc8-d64291dce17e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340743} :answer-field/id #uuid "1cc71ef4-f030-5214-97b4-d07a1eb70ea5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341431}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fe7192f0-0469-5c77-92a1-060194834d30" :question/math-academy-id "q-73482" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{x-1}{\\sqrt{x+1}}?$   \n\n- $[-1,0]$\n- $[1,10]$\n- $(-1,0)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,0]$ is closed, but the function is not continuous on it because it is not defined at $x=-1.$  Therefore, the extreme value theorem is not applicable.\n\n- The interval $[1,10]$ is  closed, and the function is continuous on $[1,10].$ Therefore, the extreme value theorem is applicable.\n\n- The interval  $(-1,0)$ is not closed, so the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341986 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68717c-3c5f-58a5-9174-e8f45f3e1ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339216} {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} {:answer/id #uuid "43af0409-9e51-5d17-a8fb-98b37bd00bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339722} {:answer/id #uuid "72581646-406e-5e01-9bba-7ad77de94142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340144} {:answer/id #uuid "8e33f721-3fb7-5e44-8644-c40ab2c07185" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340406}] :answer-field/correct {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} :answer-field/id #uuid "9a35e850-44d5-5740-b0b8-70909d0b180d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aba1141-c0a4-54c1-bd64-30eb78786676" :question/math-academy-id "q-73484" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\sqrt{\\operatorname{cos}⁡x}?$    \n\nI. $[\\frac{\\pi }{2},\\pi ]$\n\nII. $[\\frac{\\pi }{4},\\frac{\\pi }{2})$\n\nIII. $[0,\\frac{\\pi }{2}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{\\pi }{2},\\pi ]$  is closed, but the function is not defined on a part of the interval because $\\operatorname{cos}⁡(x)<0$ for all $x\\in (\\frac{\\pi }{2},\\pi ].$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[\\frac{\\pi }{4},\\frac{\\pi }{2})$    is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{2}]$ is  closed, and the function is continuous on $[0,\\frac{\\pi }{2}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341987 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51327576-3dc9-528f-9e13-d755abf55471" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339872} {:answer/id #uuid "7b3f93d2-0ebe-5934-8c91-fce10e0d1450" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340232} {:answer/id #uuid "90e67802-13a1-5947-86e3-d0c565f61870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340428} {:answer/id #uuid "ab6c8074-427b-5dfe-9ad1-218b184fe226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340690} {:answer/id #uuid "ef2a0a0c-7790-530c-89f1-dbee9d7d9e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186341239}] :answer-field/correct {:answer/id #uuid "90e67802-13a1-5947-86e3-d0c565f61870" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340428} :answer-field/id #uuid "8b5cc245-bbea-5aaf-8a56-ee9acee3fb23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341625}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e05c6d3d-29e1-53ab-9c70-1ad2b27199a4" :question/math-academy-id "q-73486" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\operatorname{sin}⁡(\\frac{\\pi }{x})?$   \n\n- $[\\frac{1}{2},1]$\n- $[0,\\frac{1}{4})$\n- $[0,1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{1}{2},1]$   is closed, and the function is continuous on $[\\frac{1}{2},1].$   Therefore, the extreme value theorem is applicable.\n\n- The interval $[0,\\frac{1}{4})$  is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,1]$ is closed, but the function is not continuous on it because it is not defined at $x=0.$  Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186341988 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a506d32-c549-5247-82e3-f237fa06872d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339215} {:answer/id #uuid "22362652-f0bc-5e3c-afa7-25ce82d78661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339421} {:answer/id #uuid "327c0e31-b1ed-5548-81bc-18ff4bca8bd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339573} {:answer/id #uuid "87824f92-9edf-52ca-9f8c-b3eeb64b58cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340341} {:answer/id #uuid "a19759de-fa06-5d86-925a-320a7299775b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340594}] :answer-field/correct {:answer/id #uuid "a19759de-fa06-5d86-925a-320a7299775b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340594} :answer-field/id #uuid "8a8dae27-98ed-5b9c-b45d-d7007b99d819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341622}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96d14ec6-ae06-5360-8ddd-d401dbb48508" :question/math-academy-id "q-73487" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{x}{{2}^{x}-1}?$    \n\nI. $[0,1]$\n\nII. $[0,1)$\n\nIII. $[-2,-1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,1]$ is closed, but the function is not continuous on it because it is not defined at $x=0$ (it makes zero the denominator).   Therefore, the extreme value theorem is not applicable.\n\n- The interval  $[0,1)$   is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-2,-1]$    is closed, and the function is continuous on $[-2,-1].$   Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341990 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cfa7a4-d6c1-5351-99b2-6635044d85f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339474} {:answer/id #uuid "65459a76-323b-5a88-8a2f-2e108e43ea11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340024} {:answer/id #uuid "88971863-2310-5e3f-ac5d-6e4e1adfb7df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340348} {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} {:answer/id #uuid "be62f3bd-2eeb-5b57-889c-ca65dbe099b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340825}] :answer-field/correct {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} :answer-field/id #uuid "bcb8b636-417c-59ba-b9cc-599917ded547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341706}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7b9b884e-eb8a-59c7-aa31-49f0025fb47f" :question/math-academy-id "q-73495" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}{2}^{-x}, & x\\ge 0 \\\\ -1, & x<0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-1,1]$\n\nII. $[\\frac{1}{2},1]$\n\nIII. $[-1,0)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}({2}^{-x})={2}^{0}=1, \\\\ {lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}(-1)=-1.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[\\frac{1}{2},1].$ In this interval, $f(x)={2}^{-x}$ and so $f(x)$ is continuous on $[\\frac{1}{2},1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, the interval $[-1,0)$, is not closed, so the extreme value theorem is not applicable in this case.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ceb0ce8-da1c-5b99-9182-d772be7cec72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339520} {:answer/id #uuid "7896c996-e406-5136-a44c-25645e86bbc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340203} {:answer/id #uuid "9a19840a-be8c-5757-bad3-4daa8391bbb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340517} {:answer/id #uuid "a718fb5b-1dd8-5664-a8f8-13023ada0bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340646} {:answer/id #uuid "f499afb4-f0c7-5505-912f-71dee8dd2498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341285}] :answer-field/correct {:answer/id #uuid "9a19840a-be8c-5757-bad3-4daa8391bbb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340517} :answer-field/id #uuid "141d901b-70e2-5398-8913-6c50c5c4a073" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341416}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1eaad6e-884d-57bd-a4ae-a690d3d6abe9" :question/math-academy-id "q-73499" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{ln}⁡(x-1), & x>1 \\\\ x-1, & x\\le 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[0,2]$\n\nII. $[-1,0]$\n\nIII. $[-1,2]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[0,2].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\nHence, $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[0,2],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[-1,0].$ In this interval, $f(x)=x-1$ and so $f(x)$ is continuous on $[-1,0].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, in the interval $[-1,2]$, we also have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\n \nHence, $f(x)$ is not continuous on $[-1,2]$ and therefore  the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341993 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "235e2186-c516-5a12-99e1-855472aad9f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339433} {:answer/id #uuid "7e1ad79a-9054-5adb-8e27-82c74fb0eeee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340265} {:answer/id #uuid "d65d9629-6375-5d3b-9bf7-be4b8ce2e02b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341027} {:answer/id #uuid "de97e50a-3ac0-5909-8788-42a53cdaa913" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341105} {:answer/id #uuid "e5a1b048-a2c7-5d2d-99eb-e4c76eea7395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341157}] :answer-field/correct {:answer/id #uuid "7e1ad79a-9054-5adb-8e27-82c74fb0eeee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340265} :answer-field/id #uuid "3883c8f8-56cb-5ac2-9602-b5a9a360bba9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341481}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a761269-f6ea-50eb-8e45-58983c3d9692" :question/math-academy-id "q-73503" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\frac{2-x}{{2}^{x}+1}, & x\\ne 0 \\\\ \\,\\,2, & x=0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-1,1]$\n- $(0,3]$\n- $[-2,-1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- First, let's consider $[-1,1].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}f(x) & ={lim}_{x\\to 0}\\frac{2-x}{{2}^{x}+1}=\\frac{2-0}{{2}^{0}+1}=1\\ne f(0).\\end{aligned}\n$$\n\nHence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(0,3]$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[-2,-1].$ The only discontinuity of the function $f(x)$ is at $x=0,$ which is not in the interval  $[-2,-1].$  Therefore, $f(x)$ is continuous on the interval  $[-2,-1],$  and the extreme value theorem is also applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341994 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f8ca629-0927-538d-ab6c-ffef86ed4c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  only" :db/id #edb/ref 17592186339401} {:answer/id #uuid "3cbeae54-1a8e-537b-bcc8-b644943612ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339669} {:answer/id #uuid "4680f954-f4f8-5258-ae55-a7412a19432c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339754} {:answer/id #uuid "bfda1598-8520-5bca-930a-7ba3397c4c03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340839} {:answer/id #uuid "fbb6ae8f-aab7-5bdc-8f7c-dc14885c5a5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341353}] :answer-field/correct {:answer/id #uuid "3cbeae54-1a8e-537b-bcc8-b644943612ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339669} :answer-field/id #uuid "9c36c391-b98e-5750-8019-3f694dde0b5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341656}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dcdd6cca-dc15-5e0c-a55e-4d73a59866ce" :question/math-academy-id "q-73504" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}\\,\\,2{x}^{3}-1, & x<1 \\\\ {sin}^{2}⁡(x-1), & x\\ge 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-1,2]$\n- $(1,3]$\n- $[2,\\pi ]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-1,2].$  We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to 1}(2{x}^{3}-1)=2(1)^{3}-1=1, \\\\ {lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to 1}{sin}^{2}⁡(x-1)={sin}^{2}⁡(1-1)=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=1$ are not the same. Hence, $f(x)$ has a discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,2],$ and the extreme value theorem is not applicable on this interval.\n\n- The interval $(1,3]$ is not closed, so the extreme value theorem is not applicable.\n\n- Finally, consider $[2,\\pi ].$ In this interval, $f(x)={sin}^{2}⁡(x-1)$ and so $f(x)$ is continuous on $[2,\\pi ].$  Therefore, the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186342003 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085a372e-3d44-5218-8ffc-7245e73f20e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339197} {:answer/id #uuid "27bfa14d-cc0f-5a6b-9127-444c2c3cbe94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339472} {:answer/id #uuid "5ff1f004-8a24-53f6-8512-8daed863b9af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339982} {:answer/id #uuid "807a16d0-c898-5c5a-aa54-af34b1d71126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340280} {:answer/id #uuid "9ef8375b-1f86-5526-a7e2-474095047082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340564}] :answer-field/correct {:answer/id #uuid "807a16d0-c898-5c5a-aa54-af34b1d71126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340280} :answer-field/id #uuid "1167d122-71e9-5a13-8edb-8b2e825eb1e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341410}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8abc4b9f-caf8-5c94-91da-62ad0ae61b3d" :question/math-academy-id "q-73531" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{x-1}-1}, & x\\ne 1 \\\\ \\,\\,1, & x=1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-2,2]$\n\nII. $[-3,1)$\n\nIII. $[1.5,2]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- Let first consider the interval  $[-2,2].$ This is a  closed interval, but we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\frac{1}{{2}^{x-1}-1}=\\infty \\end{aligned}\n$$\n\nand so $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1]$, and the extreme value theorem is not applicable.\n\n- The interval $[-3,1)$ is not closed, so the extreme value theorem is not applicable in this case.\n\n- Finally consider  $[1.5,2].$ The only discontinuity of the function $f(x)$ is at $x=1,$ which is not in the interval  $[1.5,2].$ Therefore, $f(x)$ is continuous on the interval  $[1.5,2]$, and the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186342012 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f079a8-3eef-5e0c-b508-56b0a28e810a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339187} {:answer/id #uuid "33e2246e-0cb8-5b3d-a663-6ded80537d31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339590} {:answer/id #uuid "36e9f6d3-ade4-54f2-83b8-98b440f7e2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339621} {:answer/id #uuid "9be8a799-d92f-523e-80f4-9f217caeda37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340530} {:answer/id #uuid "a94a7551-868d-5a9d-8d58-61cf61d367d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340670}] :answer-field/correct {:answer/id #uuid "9be8a799-d92f-523e-80f4-9f217caeda37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340530} :answer-field/id #uuid "1c233766-89ba-51e9-91fa-b4ab683f8678" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341429}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "451e02c3-10e2-5101-a83f-538a8be6b03d" :question/math-academy-id "q-73549" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $4{x}^{2}+{y}^{2}=4$ and $4{x}^{2}+{y}^{2}=1?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](images/62/627e7e102a0f16cb0c4946e42b48ad122299d729c5bc419293e258a3f2e1701e.png)\n\nWe have the following:\n\n- The vertical line $x=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](images/d7/d7aa48c887d6fb1c3d0420867b7e74010fa93e16d7e24317e2cf214764e56113.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](images/ec/ec632fa5f86d8d9b34b9ccf661a3219e965f289c28bf69d7d80eeeb46093e7ae.png)\n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186342187 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db4180e-9e56-5615-a261-a06b057afbc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339254} {:answer/id #uuid "44382309-a210-5068-b421-83edd371f540" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339728} {:answer/id #uuid "705bf110-f45f-5748-8977-a6e4eaab55d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340124} {:answer/id #uuid "a661de8b-e986-5edb-ae2a-54d4fbff884d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340638} {:answer/id #uuid "ec1d59d6-b1c0-5ab1-b672-2772922e372b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341209}] :answer-field/correct {:answer/id #uuid "705bf110-f45f-5748-8977-a6e4eaab55d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340124} :answer-field/id #uuid "b4646991-5d1f-5339-9e5a-2aa1bae21d22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5e93e600-4a01-5ada-842d-9b175b57ee56" :question/math-academy-id "q-74217" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:1-x-y=0\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}\\le 1\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:2x+3y-z=0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $1-x-y=0$ since $1-0-0\\ne 0.$\n\n- The set $B$ is not a subspace. Indeed, the vector $u=⟨1,0,0⟩$ is in $B$, but $2u=⟨2,0,0⟩$ is not in $B$, since ${2}^{2}+{0}^{2}+{0}^{2}≰1.$ So, $B$ is not closed under scalar multiplication.\n\n- The set $C$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $2x+3y-z=0$ since $2\\cdot 0+3\\cdot 0-0=0.$ So $0$ lies in $C.$\n\nIn conclusion, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186342188 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43ab7da0-2f07-50d1-831b-c157d66b1de8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339721} {:answer/id #uuid "6ffb62c9-06bc-54ed-a237-28e9635fc6fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340121} {:answer/id #uuid "72703321-1679-5b08-aab6-32e985e25b41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340146} {:answer/id #uuid "74517a98-ee70-5879-af22-ee6f1cbffcda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186340165} {:answer/id #uuid "ef265337-e4c5-5117-bd72-923b375019cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341238}] :answer-field/correct {:answer/id #uuid "74517a98-ee70-5879-af22-ee6f1cbffcda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186340165} :answer-field/id #uuid "fa75a06c-11fb-5ef6-a1f6-3f25d8c6ebf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341828}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5037faf6-6f8a-5ea2-800f-2c136a3bb59e" :question/math-academy-id "q-74218" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\n- $A={⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}=1}$\n- $B={⟨x,y,z⟩\\in {R}^{3}:xyz=0}$\n- $C={⟨x,y,z⟩\\in {R}^{3}:y=-1}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition ${x}^{2}+{y}^{2}+{z}^{2}=1$ since ${0}^{2}+{0}^{2}+{0}^{2}\\ne 1.$\n\n- The set $B$ is not a subspace because it is not closed under vector addition. Indeed, both $a=⟨1,0,1⟩$ and $b=⟨0,1,1⟩$ belong to $B$ but \n\n$$\na+b=⟨1,0,1⟩+⟨0,1,1⟩=⟨1,1,2⟩\n$$\n\n \ndoes not satisfy the condition $xyz=0$ since $1\\cdot 1\\cdot 2\\ne 0.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $y=-1$ since $0\\ne -1.$\n\nSo, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186342191 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3171ea47-31ac-55ef-8e65-7c8cc13d17db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339563} {:answer/id #uuid "4780f3c7-7445-5e20-b679-8d09700f5b1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339761} {:answer/id #uuid "69308677-f0aa-523b-9be3-7371c6dc3d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340063} {:answer/id #uuid "7458caf1-0896-52f4-b93d-16c6705c4441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340166} {:answer/id #uuid "962e504c-ea04-57e3-acb7-34e1af23490d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340484}] :answer-field/correct {:answer/id #uuid "69308677-f0aa-523b-9be3-7371c6dc3d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340063} :answer-field/id #uuid "df4036f4-0b20-53ba-89f9-e6eee6e466b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341774}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb81e4a8-c5a7-59da-b168-b278b747b24a" :question/math-academy-id "q-74255" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}<\\frac{1}{2}\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:5x-y-z=0\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:5-x-z=0\\}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. Indeed, the vector $u=⟨\\frac{1}{4},0,0⟩$ is in $A$, since\n\n$$\n\\sqrt{{(\\frac{1}{4})}^{2}+{0}^{2}+{0}^{2}}=\\frac{1}{4}<\\frac{1}{2},\n$$\n\nbut, $4u=⟨1,0,0⟩$ is not in $B$, since \n\n$$\n\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}}>\\frac{1}{2}.\n$$\n\nSo, $A$ is not closed under scalar multiplication.\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $5x-y-z=0$ since $5\\cdot 0-0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $5-x-z=0$ since $5-0-0\\ne 0.$\n\nIn conclusion, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186345004 :knowledge-point/_questions [{:db/id #edb/ref 17592186124457 :knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed" :knowledge-point/title "Calculating Limits Along Different Paths for Multivariable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74d47c5c-d9b2-5729-b276-f386649b4836" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186343248} {:answer/id #uuid "78689969-fa12-5d79-b86b-75a95aac6c30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343278} {:answer/id #uuid "93f165e9-4fa8-5327-af87-0aecc43a6729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343532} {:answer/id #uuid "b3d03412-f273-52d2-a7f8-85526134a1c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186343815} {:answer/id #uuid "f7884f74-457b-566e-ac8e-ae3ebcb6b395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186344417}] :answer-field/correct {:answer/id #uuid "93f165e9-4fa8-5327-af87-0aecc43a6729" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343532} :answer-field/id #uuid "196a3494-8261-5fa3-924a-5e54ae02aac6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d5fe00a2-ab56-5281-b3c2-6fe8dad2417a" :question/math-academy-id "q-74964" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}\n$$\n\nI. The limit evaluates to $0$ along the path $y=x$\n\nII. The limit evaluates to $2$ along the path $y={x}^{2}$\n\nIII. The limit exists and is equal to $2$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-x} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{x(2x-1)} \\\\  & ={lim}_{x\\to 0}\\frac{2x}{2x-1} \\\\  & =\\frac{2\\cdot 0}{2\\cdot 0-1} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is also true. Taking $x\\to (0,0)$ along the path $y={x}^{2},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2\\end{aligned}\n$$\n\n- Statement III is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186345029 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b9ca939-c7a6-5aeb-98c2-585d48ff8c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342604} {:answer/id #uuid "5716cd24-5a2c-5544-92f6-203e6a676437" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342963} {:answer/id #uuid "6d2c0063-1ae4-55ca-87d1-b65a1e62305f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  only" :db/id #edb/ref 17592186343173} {:answer/id #uuid "731035c9-6220-52ed-886c-05ae731b34ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186343235} {:answer/id #uuid "cf56f8d6-4634-5189-80bd-37357cd208d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II  and III only" :db/id #edb/ref 17592186344062}] :answer-field/correct {:answer/id #uuid "2b9ca939-c7a6-5aeb-98c2-585d48ff8c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342604} :answer-field/id #uuid "51ec1b91-00af-5481-ab92-af724f5e618b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344632}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89a636cd-a216-5d73-bd3f-7f9cbe4badf4" :question/math-academy-id "q-75116" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\n- $C=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$\n- $C=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]$\n- $C=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form  because  the matrix on the left is not a unit lower triangular matrix, as its main diagonal contains a number not equal to $1.$\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\n- The second product is *not* in $LU$ form. Although we have a product of an upper triangular matrix on the left and a unit lower triangular matrix on the right, the order of multiplication is not correct (instead, we need a unit lower triangular matrix on the left and an upper triangular matrix on the right).\n\n$$\nC=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}]\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 0 & 4\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186345030 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ada63ec-fa1d-5ff7-b669-92737dcdbd74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342330} {:answer/id #uuid "1752c8df-b894-5390-b173-aa620c63a4ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186342443} {:answer/id #uuid "409dfa57-961d-5f83-aa15-10d15babbe22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342771} {:answer/id #uuid "467b7351-7ecb-539b-ba6e-6ea1995a8925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342818} {:answer/id #uuid "98410b31-6e91-581a-a43b-5311f6c98db0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186343573}] :answer-field/correct {:answer/id #uuid "467b7351-7ecb-539b-ba6e-6ea1995a8925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342818} :answer-field/id #uuid "6c138955-72ce-5ce7-a05a-28705f2a9e68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0305a43d-bf81-5ecb-8a77-49a30ade0147" :question/math-academy-id "q-75117" :question/problem "Which of the following products is the LU factorization of a matrix $A?$\n\nI. $A=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 0 & 1\\end{aligned}]$\n\nII. $A=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}]$\n\nIII. $A=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $A,$ we write $A=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:  \n\n$$\nA=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$  on the main diagonal.\n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}4 & 2 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\n- The second product is *not* in $LU$ form because the matrix on the right is not an upper triangular matrix, as it has a non-zero entry below the diagonal. \n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ -4 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ -1 & 2\\end{aligned}]\\,\\times \n$$\n\n- The third product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix.\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}]\\,✓\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186345033 :knowledge-point/_questions [{:db/id #edb/ref 17592186119853 :knowledge-point/id #uuid "c2c1a562-1b3d-5180-9fef-e20ea916b17a" :knowledge-point/title "Identifying LU Factorizations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454ea782-196e-50f9-b1e2-00d2d1bb0539" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186342808} {:answer/id #uuid "4f08aad3-17c0-5aea-a1e3-8bc3cab0aea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186342888} {:answer/id #uuid "4f2b2691-bd26-5b75-bf4a-0ab5f6a47c36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186342891} {:answer/id #uuid "567c9971-93d6-5157-ae62-fc0890790260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342958} {:answer/id #uuid "9b54534f-b827-5c6c-a649-e71657a1ca05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186343609}] :answer-field/correct {:answer/id #uuid "567c9971-93d6-5157-ae62-fc0890790260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186342958} :answer-field/id #uuid "bc036018-08d5-5220-9a04-6989a4c32339" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "34143660-ecfa-5585-b65e-76b215171706" :question/math-academy-id "q-75123" :question/problem "Which of the following products is the LU factorization of a matrix $C?$\n\n- $C=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$\n- $C=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]$\n- $C=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]$" :question/worked-solution "Remember that in the LU factorization of a matrix $C,$ we write $C=LU$ where the matrix $L$ is a unit lower triangular matrix (a lower triangular matrix that has only $1$'s on the main diagonal) and the matrix $U$ is an upper triangular matrix:\n\n$$\nC=\\overset{L}{\\overset{⏞}{[\\begin{aligned}1 & 0 \\\\ ∗ & 1\\end{aligned}]}}\\cdot \\overset{U}{\\overset{⏞}{[\\begin{aligned}∗ & ∗ \\\\ 0 & ∗\\end{aligned}]}}\n$$\n\nWith that in mind, let's inspect each product in turn.\n\n- The first product is in $LU$ form because the left matrix is a unit lower triangular matrix, and the right matrix is an upper triangular matrix. \n\n$$\nC=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]\\,✓\n$$\n\n- The second product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has a non-zero entry above the main diagonal. \n\n$$\nC=[\\begin{aligned}1 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}]\\,\\times \n$$\n\n- The third product is *not* in $LU$ form because the matrix on the left is not a unit lower triangular matrix, as it has an entry not equal to $1$ on the main diagonal.\n\n$$\nC=[\\begin{aligned}0 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 0 & 1\\end{aligned}]\\,\\times \n$$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186345092 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f2376a1-da00-5911-b146-c5236752448e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186342890} {:answer/id #uuid "58038b76-6478-52e3-88f8-675c4aa414d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186342974} {:answer/id #uuid "59103f60-0dff-5bf6-af9c-6267f890a47e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186342987} {:answer/id #uuid "9ea948d9-d1d3-5312-9f2b-e7b8089e8034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$  only" :db/id #edb/ref 17592186343638} {:answer/id #uuid "ae7d0947-9c9d-5773-b575-44075078af0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186343772}] :answer-field/correct {:answer/id #uuid "9ea948d9-d1d3-5312-9f2b-e7b8089e8034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$  only" :db/id #edb/ref 17592186343638} :answer-field/id #uuid "f466101d-ee92-54d3-b4e2-a9cca8e95913" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344920}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "21485ec9-747a-5129-ba2c-794c570827bf" :question/math-academy-id "q-75496" :question/problem "Which of the following matrices are transformed into the $2\\times 2$ identity matrix after applying the row operations ${R}_{1}:={R}_{1}+(-2){R}_{2}\\,$ and $\\,{R}_{2}:={R}_{2}+(-3){R}_{1}?$\n\n$$\nA=[\\begin{aligned}1 & 5 \\\\ 1 & 4\\end{aligned}],\\,B=[\\begin{aligned}7 & 2 \\\\ 3 & 1\\end{aligned}],\\,C=[\\begin{aligned}9 & 2 \\\\ 4 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 5 \\\\ 1 & 4\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}-1 & -3 \\\\ 1 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}-1 & -3 \\\\ 4 & 13\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}7 & 2 \\\\ 3 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}9 & 2 \\\\ 4 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 4 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186345095 :knowledge-point/_questions [{:db/id #edb/ref 17592186115251 :knowledge-point/id #uuid "77d78574-a17c-5fc3-8c14-3aaec7753b3c" :knowledge-point/title "Transforming a 2x2 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dad3104-8a81-5836-a5a9-4e944d9ea89c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186342747} {:answer/id #uuid "6aa425cd-c3c4-550e-9bf6-9b7007b60940" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186343145} {:answer/id #uuid "7230a1e9-8e89-5267-aa7f-a81a5c6cccc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186343226} {:answer/id #uuid "9b1e7dd8-43cf-517f-b457-c549b0d0e69e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186343606} {:answer/id #uuid "ae816524-bdcc-57d3-b1f0-57315f7a80b1" :answer/type {:db/id #edb/