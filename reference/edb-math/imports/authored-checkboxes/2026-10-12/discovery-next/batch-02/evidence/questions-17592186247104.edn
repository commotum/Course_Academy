#{[{:db/id #edb/ref 17592186247104 :knowledge-point/_questions [{:db/id #edb/ref 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f090002-f297-5675-b982-60c3f76c8ab5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186244735} {:answer/id #uuid "6dc61457-1345-563a-9622-a08af411f78a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186245284} {:answer/id #uuid "98010170-af55-5199-ad63-1db887e5810a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186245658} {:answer/id #uuid "c835eed1-4520-5d91-992c-2a3da00a4388" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186246088} {:answer/id #uuid "e02613f0-feb1-5d52-8114-cc41c0b1d62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186246306}] :answer-field/correct {:answer/id #uuid "e02613f0-feb1-5d52-8114-cc41c0b1d62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186246306} :answer-field/id #uuid "047a36b0-3d12-59b9-b56a-f5ab184555fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11f8af48-def1-5000-8ab6-3793fdd8fd3a" :question/math-academy-id "q-110291" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{3}:={R}_{3}+3{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 3 & 0 & 1\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\nTherefore, only $B$ is an elementary matrix."}] [{:db/id #edb/ref 17592186247105 :knowledge-point/_questions [{:db/id #edb/ref 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e88fbb6-5102-5aa7-970b-9af5657b3fd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186244580} {:answer/id #uuid "3e027b67-31a5-582d-8691-db094d23ad72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186244859} {:answer/id #uuid "b9eea2fc-c5f5-538f-b7bf-12badce4b53a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186245974} {:answer/id #uuid "c9eeaafe-a50d-5224-b481-837c1ce81c7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186246102} {:answer/id #uuid "dc71dbb1-c189-5b69-9847-37cca51403b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186246272}] :answer-field/correct {:answer/id #uuid "c9eeaafe-a50d-5224-b481-837c1ce81c7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186246102} :answer-field/id #uuid "bffd0db3-75e4-5216-8424-601c1e867e30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6d84ae8-2da9-539e-89fc-1e2b037b4578" :question/math-academy-id "q-110296" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 3 & 2 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is not an elementary matrix because it can't be obtained from $I$ by applying only one elementary row operation.\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}↔{R}_{2},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1}↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 1 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}:=(-5){R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :=(-5){R}_{1} \\\\  & ∼[\\begin{aligned}-5 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =C\\end{aligned}\n$$\n\nTherefore, only $B$ and $C$ are elementary matrices."}] [{:db/id #edb/ref 17592186247106 :knowledge-point/_questions [{:db/id #edb/ref 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3661459f-bffd-5a02-ad9d-a45850445460" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186244795} {:answer/id #uuid "5a357e18-e341-5719-bcfc-2aff563aad58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186245105} {:answer/id #uuid "6f8bb6d4-e707-5633-b90e-41e7bab2323b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186245306} {:answer/id #uuid "b8381cb8-d39f-52fe-a621-ba1e4e39fb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186245962} {:answer/id #uuid "e9797cf9-77c4-556d-a81d-d43f5386801c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186246385}] :answer-field/correct {:answer/id #uuid "b8381cb8-d39f-52fe-a621-ba1e4e39fb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A,$ $B,$ and $C$" :db/id #edb/ref 17592186245962} :answer-field/id #uuid "d5979102-9097-5d98-87e8-20eef242d41d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a29a5217-fb22-5ba1-a37e-09a1f7203c3e" :question/math-academy-id "q-110297" :question/problem "Which of the following are elementary matrices?\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that an elementary matrix is obtained by performing exactly one elementary row operation on the identity matrix $I.$\n\nWith that in mind, let's examine our matrices.\n\n- The matrix $A$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{3}:={R}_{3}+9{R}_{1},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+9{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 9 & 0 & 1\\end{aligned}] \\\\  & =A\\end{aligned}\n$$\n\n- The matrix $B$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{2}↔{R}_{3},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{2}↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 1 & 0\\end{aligned}] \\\\  & =B\\end{aligned}\n$$\n\n- The matrix $C$ is an elementary matrix because it can be obtained from $I$ by applying the elementary row operation ${R}_{1}:={R}_{1}+4{R}_{3},$ as follows:\n\n$$\n\\begin{aligned}I & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+4{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 0 & 4 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =C\\end{aligned}\n$$\n\nTherefore, $A,$ $B,$ and $C$ are elementary matrices."}] [{:db/id #edb/ref 17592186247121 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bb32cf3-9c85-57a8-a8cb-26f0de6811dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186244838} {:answer/id #uuid "85ff17a9-97bb-5773-a046-61bcce74f5dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186245494} {:answer/id #uuid "93c603da-5e1c-5def-9f28-12abfb78bd9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186245603} {:answer/id #uuid "d31c4eca-1d9a-50fb-a551-1cd3a34abc63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186246193} {:answer/id #uuid "dff8ad34-7b4c-5d18-9ae6-82ed4b42f750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186246304}] :answer-field/correct {:answer/id #uuid "dff8ad34-7b4c-5d18-9ae6-82ed4b42f750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186246304} :answer-field/id #uuid "6d05ec29-3077-5254-aeac-651efa918e73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a60d4465-319d-5ba9-93b8-d257af2c79a6" :question/math-academy-id "q-110449" :question/problem "![](images/8c/8c695ea0cb09807c22fa655182945e838a7c5e454680176add27748945d143e5.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$  clearly lies outside the subset.\n\n- Diagram II does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$  clearly lies outside the subset.\n\n- Diagram III represents a line passing through the origin. Therefore, it is a subspace of  ${R}^{3}.$\n\nSo, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186247148 :knowledge-point/_questions [{:db/id #edb/ref 17592186192782 :knowledge-point/id #uuid "4a8dbbab-2dea-5fff-86f0-3411f5405ee9" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Three-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a17701-a75c-5425-975f-38124488430a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186244355} {:answer/id #uuid "0ead492b-30b4-5e39-b026-2464b7bc5404" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186244448} {:answer/id #uuid "26bc2a9f-6a37-519b-bc19-79b84620034e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186244657} {:answer/id #uuid "56fe5526-4b6a-5dd2-b74b-f1d155401d41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186245079} {:answer/id #uuid "72c3f3af-f3ad-5719-9deb-5b3265307948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186245338}] :answer-field/correct {:answer/id #uuid "72c3f3af-f3ad-5719-9deb-5b3265307948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186245338} :answer-field/id #uuid "310db152-e538-5b4c-8f08-e03ee2244708" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246627}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d94dadb2-4fe3-5787-929d-74b940cbadc4" :question/math-academy-id "q-110597" :question/problem "![](images/f2/f2ed737550ddf5502d2a066cdc279285b624000a6c2ad8464496c122ad31a3ab.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}$ or ${R}^{3}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I is a line that passes through the origin. Therefore, it is a subspace of ${R}^{2}.$\n\n- Diagram II does not represent a subspace. The vector $a=[\\begin{aligned}3 \\\\ 0\\end{aligned}]$ lies inside the given subset. But, \n\n$$\n(-1)\\cdot a=[\\begin{aligned}\\,\\,-3 \\\\ 0\\end{aligned}]\n$$\n\nlies outside the subset.\n\n- Diagram III does not represent a subspace. The origin $0=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]$  clearly lies outside the subset.\n\nSo, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186247149 :knowledge-point/_questions [{:db/id #edb/ref 17592186192780 :knowledge-point/id #uuid "e3fe3596-340e-5155-bed3-cf25f5843d70" :knowledge-point/title "Identifying Whether Sets Represented Graphically Are Subspaces in Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b813ff-0285-5315-8faa-c1c7e05786a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186244312} {:answer/id #uuid "5f477521-7db1-58de-bb71-e8792ebb84d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186245151} {:answer/id #uuid "a4e54d6e-e47e-52da-abdc-98b6f66e76be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186245792} {:answer/id #uuid "ad482350-e2cd-52ac-853b-747958e195d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186245860} {:answer/id #uuid "f20be3ca-371a-581c-8344-ba72706a6136" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186246450}] :answer-field/correct {:answer/id #uuid "5f477521-7db1-58de-bb71-e8792ebb84d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186245151} :answer-field/id #uuid "85984eba-7c96-50f1-b011-92e8b1639189" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246778}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3f37be5a-fb02-59a0-9bc3-1e609a53d6d6" :question/math-academy-id "q-110600" :question/problem "![](images/81/815f5ce1dd5bf3bc30b7853b53cd97736ffeb8224f30bc864cc7e43e07bedb5a.png)\n\nWhich of the diagrams shown above represent subspaces of ${R}^{2}?$" :question/worked-solution "Let's analyze each diagram in turn.\n\n- Diagram I does not represent a subspace. The vector $a=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ lies inside the given subset. But \n\n$$\n(-1)\\cdot a=[\\begin{aligned}-1 \\\\ -1\\end{aligned}]\n$$\n\nlies outside the subset.\n\n- Diagram II represents a set that does not contain the origin. But every subspace must contain the origin, so Diagram II is not a subspace of ${R}^{2}.$\n\n- Diagram III represents the whole plane ${R}^{2}$ without the origin. But every subspace must contain the origin, so Diagram III is not a subspace of ${R}^{2}.$\n\nSo, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186247150 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c930cca-832f-54ec-9a43-d0528178ddeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186244427} {:answer/id #uuid "1ca32221-ff95-543b-bc2c-90e0f13eb9f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186244567} {:answer/id #uuid "4fc2135d-af50-5fbf-93cd-7f5b8b019f28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186245024} {:answer/id #uuid "5ee0d694-8072-5237-83cb-74378b391f2b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186245149} {:answer/id #uuid "d3e2f0b7-e365-5a2d-8813-834a7f6d8c51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186246201}] :answer-field/correct {:answer/id #uuid "1ca32221-ff95-543b-bc2c-90e0f13eb9f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186244567} :answer-field/id #uuid "4ea98ac4-3d5c-5ddb-9efa-57298a592d36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246680}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d55fbe8-7170-5840-8a9a-b1f2a55c58fd" :question/math-academy-id "q-110611" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\n- $A={⟨x,y,z⟩\\in {R}^{3}:xyz=1}$\n- $B={⟨x,y,z⟩\\in {R}^{3}:x+y-z=0}$\n- $C={⟨x,y,z⟩\\in {R}^{3}:y=-1}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $xyz=1$ since $0\\cdot 0\\cdot 0\\ne 1.$\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $x+y-z=0$ since $0+0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the condition $y=-1$ since $0\\ne -1.$\n\nSo, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186247159 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d3026ef-0c9f-56f6-9c82-deeb31d5c484" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186244850} {:answer/id #uuid "9497acc2-e957-5d08-b023-f36e5c982edf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186245613} {:answer/id #uuid "b34b7ad9-ca5d-5d2e-8c18-a98455f051ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186245911} {:answer/id #uuid "b9e6cab8-baf8-54e3-aa8d-7bdaa5531b01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186245973} {:answer/id #uuid "def3c3d6-726e-5345-9da6-7f08cc46817e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186246290}] :answer-field/correct {:answer/id #uuid "def3c3d6-726e-5345-9da6-7f08cc46817e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186246290} :answer-field/id #uuid "4c72e079-6317-5a21-9e66-00a4c7adfda0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246673}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "49bd226a-4547-5889-a62c-e6c2912a1520" :question/math-academy-id "q-110760" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nI. $A=\\{⟨x,y,z⟩\\in {R}^{3}:x-4y=1\\}$\n\nII. $B=\\{⟨x,y,z⟩\\in {R}^{3}:x=-2y\\}$\n\nIII. $C=\\{⟨x,y,z⟩\\in {R}^{3}:{x}^{2}+{y}^{2}+{z}^{2}<0\\}$" :question/worked-solution "Let's analyze each subset.\n\n- The set $A$ is not a subspace because it does not contain the zero vector. For instance, $0=⟨0,0,0⟩$ does not satisfy the equation $x-4y=1$ since $0-4\\cdot 0=0\\ne 1.$\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $x=-2y$ since $0=-2\\cdot 0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace. No point in ${R}^{3}$ satisfies the equation ${x}^{2}+{y}^{2}+{z}^{2}<0.$ Hence, $C=∅.$ The empty set is not a subspace since it does not contain the zero vector.\n\nIn conclusion, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186247160 :knowledge-point/_questions [{:db/id #edb/ref 17592186192781 :knowledge-point/id #uuid "1094661c-8c7c-5f85-b731-4dadb0aec310" :knowledge-point/title "Identifying Whether Sets Represented Using Set Notation Are Subspaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275f531e-d1aa-52c8-b7bd-eb69270b75c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186244660} {:answer/id #uuid "2ac08711-add3-535d-b29f-763e3fc8ae4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186244693} {:answer/id #uuid "6bb828b4-a98e-5f21-92c9-ccc1e8034feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186245267} {:answer/id #uuid "9f640b05-3af2-55c2-8e21-d87abb59b0bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186245733} {:answer/id #uuid "f017b885-1c0f-55c4-818c-66cee81ff6e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186246436}] :answer-field/correct {:answer/id #uuid "f017b885-1c0f-55c4-818c-66cee81ff6e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186246436} :answer-field/id #uuid "5bc1df4c-48e1-5b6e-81a3-7d624915ee7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc11ea3b-3ee9-5cb9-a26d-3aab9cb82498" :question/math-academy-id "q-110761" :question/problem "Which of the following sets is a subspace of ${R}^{2}?$\n\n- $A={⟨2t,2+t⟩\\,:\\,t\\in R}$\n- $B={⟨x,y⟩\\in {R}^{2}:x-y=0}$\n- $C={⟨x,y⟩\\in {R}^{2}:y=1}$" :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. If the origin belongs to this subset, we would have, for some $t$:\n\n$$\n[\\begin{aligned}2t \\\\ 2+t\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}],\n$$\n\nwhich gives us\n\n$$\n{\\begin{aligned}2t=0 \\\\ 2+t=0.\\end{aligned}\n$$\n\nWe see that the system has no solution. So, $0$ is not in $A.$\n\n- The set $B$ is a subspace.  It represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ satisfy the equation $x-y=0$ since $0-0=0.$ So, $0$ lies in $B.$\n\n- The set $C$ is not a subspace. It represents a line, and a line is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0⟩$ does not satisfy the equation $y=1$ since $0\\ne 1.$ So, $0$ is not in $C.$\n\nIn conclusion, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186247243 :knowledge-point/_questions [{:db/id #edb/ref 17592186129148 :knowledge-point/id #uuid "34aa8f4e-20f1-5dda-ac53-6eb411543897" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24560d1a-1f8a-5091-ba23-67d53fde63ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186244635} {:answer/id #uuid "510c1cbe-4dc3-5433-9a1b-8ab3944fb2b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186245032} {:answer/id #uuid "74b6a69b-09df-5889-9fd8-afea5136fa73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186245353} {:answer/id #uuid "838d8b90-ba8b-513c-ad08-ad101898af1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186245469} {:answer/id #uuid "f5857375-72b6-5385-a6fc-5846e60abce2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186246482}] :answer-field/correct {:answer/id #uuid "838d8b90-ba8b-513c-ad08-ad101898af1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186245469} :answer-field/id #uuid "fbc3714a-944d-5084-88bf-416cc2eb37e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246995}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57caf7d5-ab2c-51c1-a72f-c7af8b4259a1" :question/math-academy-id "q-112114" :question/problem "![](images/b4/b46093feaf5d7138e30c6d6fc673a2d915cac74a23ae76e0841e9bb5b135fa60.png)\n\nThe graph of the polynomial $y=P(x)$ is shown above. Which of the following statements are true?\n\n- The degree of $P(x)$ is even.\n- The coefficient of the leading term is positive.\n- The constant term is positive." :question/worked-solution "The end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is even, and\n\n- the leading coefficient of $P(x)$ is negative.\n\nSo, statement I is true, while statement II is false.\n\nLastly, note that the $y$-intercept is positive, and therefore the constant term must be positive. So, III is true.\n\nTherefore, the correct answer is \"I and III only\"."}] [{:db/id #edb/ref 17592186247253 :knowledge-point/_questions [{:db/id #edb/ref 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae1ce01-f633-5cf4-9819-3e46563161da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186244411} {:answer/id #uuid "2c8bf5df-f219-582e-baa2-83dd9b3e5018" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186244709} {:answer/id #uuid "71ef7ee0-1fa6-51c0-b425-f13d35180e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186245329} {:answer/id #uuid "97a28058-176b-58a9-a8a5-e5d8e0f36a7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186245650} {:answer/id #uuid "e33d4537-74c6-501d-93e1-dec705d0dc4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186246333}] :answer-field/correct {:answer/id #uuid "0ae1ce01-f633-5cf4-9819-3e46563161da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186244411} :answer-field/id #uuid "bbbfc476-1f93-5d3c-b9e6-bf89b6b87392" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8563367f-0e91-5d7d-a84d-c182442533d2" :question/math-academy-id "q-112249" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{1}↔{R}_{2}\\,$ and $\\,{R}_{1}:={R}_{1}+5{R}_{2}?$\n\n$$\nA=[\\begin{aligned}0 & -5 & 0 \\\\ -5 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}],\\,C=[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 5\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}0 & -5 & 0 \\\\ -5 & 0 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}-5 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}-5 & -25 & 0 \\\\ 0 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}0 & 1 & 0 \\\\ 1 & -5 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -5 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}0 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 1 & 0 & 5\\end{aligned}] & {R}_{1} & ↔{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{aligned}] & {R}_{1} & :={R}_{1}+5{R}_{2} \\\\  & ∼[\\begin{aligned}0 & 1 & 5 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 5\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186247261 :knowledge-point/_questions [{:db/id #edb/ref 17592186115300 :knowledge-point/id #uuid "68350e0d-84ca-5b50-b05a-1bca3ceea40f" :knowledge-point/title "Transforming a 3x3 Matrix Into the Identity Matrix Using Row Operations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b3b94a5-79c1-57d0-9be8-251e815104cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186244418} {:answer/id #uuid "877623b1-fcd2-5f42-8bc9-ec56a179f270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186245507} {:answer/id #uuid "966c12e2-c322-54f1-b623-fa658ca15651" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186245638} {:answer/id #uuid "a1558d3d-8c9c-566b-ab4f-f816ba66fd45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186245750} {:answer/id #uuid "a279112c-8ebb-5dbd-9a70-10e67a6af869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186245766}] :answer-field/correct {:answer/id #uuid "a279112c-8ebb-5dbd-9a70-10e67a6af869" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186245766} :answer-field/id #uuid "02da2040-a390-5ba2-ba59-52350df4c34d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246553}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28f1bc51-adb8-5a90-9cf3-77945badfc4b" :question/math-academy-id "q-112379" :question/problem "Which of the following matrices are transformed into the $3\\times 3$ identity matrix after applying the row operations ${R}_{2}:={R}_{2}+7{R}_{1}\\,$ and $\\,{R}_{3}:={R}_{3}+(-2){R}_{2}?$\n\n$$\nA=[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 \\\\ -7 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}],\\,C=[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 7 & 1\\end{aligned}]\n$$" :question/worked-solution "Let's apply the operations to each of the matrices:\n\n$$\n\\begin{aligned}A & =[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 14 & 1 & 0 \\\\ 0 & -2 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 14 & 1 & 0 \\\\ -28 & -4 & 1\\end{aligned}] \\\\  & \\ne I\\,\\times  \\\\ B & =[\\begin{aligned}1 & 0 & 0 \\\\ -7 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 2 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & =I\\,✓ \\\\ C & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & -2 \\\\ 0 & 7 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+7{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & -2 \\\\ 0 & 7 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 \\\\ 7 & 1 & -2 \\\\ -14 & 5 & 5\\end{aligned}] \\\\  & \\ne I\\,\\times \\end{aligned}\n$$\n\nTherefore, the correct answer is \"$B$ only\"."}] [{:db/id #edb/ref 17592186250218 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e413e70-36d8-53b8-8b6a-09160ee9f475" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186248127} {:answer/id #uuid "8bbaa891-8a58-55f2-ba56-470aa42751de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248675} {:answer/id #uuid "a4cf62b4-002a-5c67-9eb3-f71c1b81e4bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186248895} {:answer/id #uuid "ccd8cb0e-3c36-5a2a-91ca-d2c93d02ff12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249244} {:answer/id #uuid "ce8b6daf-58a4-5c25-aabf-651ee6fcc2a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186249255}] :answer-field/correct {:answer/id #uuid "ccd8cb0e-3c36-5a2a-91ca-d2c93d02ff12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249244} :answer-field/id #uuid "a9ec3092-81ff-5e9a-b12c-8a442eeb2ae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249971}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3a2a1a5b-82e0-576b-9a2b-9cca3c9ca19e" :question/math-academy-id "q-114271" :question/problem "Consider the function $f(x)=3{x}^{5}-5{x}^{4}.$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(1,\\infty )$\n- $f(x)$ is concave up on $(-\\infty ,0)$\n- $f(x)$ is concave up on $(1,\\infty )$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =15{x}^{4}-20{x}^{3} \\\\ {f}^{″}(x) & =60{x}^{3}-60{x}^{2} \\\\  & =60{x}^{2}(x-1)\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}60{x}^{2}(x-1) & >0 \\\\ x-1 & >0 \\\\ x & >1\\end{aligned}\n$$\n\nSo $f(x)$ is concave up on the interval   $(1,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning, this leads to the inequality $x-1<0$ with $x\\ne 0,$ which has the solution $(-\\infty ,0)\\cup (0,1).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186250219 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1266909e-bb0c-5cd6-b909-382aba868ade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247591} {:answer/id #uuid "1abd255f-230a-5675-9afe-900b7d607de0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186247667} {:answer/id #uuid "2716b966-bb35-5b3b-87fa-a63554ec0899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186247770} {:answer/id #uuid "73658170-202b-52f8-b2ec-b9a9fdf5fc41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186248434} {:answer/id #uuid "95af3261-a586-5381-87fa-6001c288e4ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248756}] :answer-field/correct {:answer/id #uuid "1266909e-bb0c-5cd6-b909-382aba868ade" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247591} :answer-field/id #uuid "16ceb16a-1b63-56a0-9a69-07e0216ba9e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "136bbef5-7f5b-5272-816c-ea16bb2ceed2" :question/math-academy-id "q-114272" :question/problem "Consider the function $f(x)=({x}^{2}-4x+6){e}^{x}.$ Which of the following statements are true?\n\n- $f(x)$ is concave up on $(-\\infty ,0)\\cup (0,\\infty )$\n- $f(x)$ is concave down on $(0,\\infty )$\n- $f(x)$ is concave down on $(-\\infty ,0)$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{2}-4x+6){e}^{x}+(2x-4){e}^{x} \\\\  & =({x}^{2}-2x+2){e}^{x} \\\\ {f}^{″}(x) & =({x}^{2}-2x+2){e}^{x}+(2x-2){e}^{x} \\\\  & ={x}^{2}{e}^{x}\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}{x}^{2}{e}^{x} & >0.\\end{aligned}\n$$\n\nSince ${e}^{x}>0$ and ${x}^{2}>0$ for all real values $x\\ne 0,$ the inequality ${f}^{″}(x)>0$ has the solution $(-\\infty ,0)\\cup (0,\\infty ).$ So $f(x)$ is concave up on the interval $(-\\infty ,0)\\cup (0,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality ${x}^{2}{e}^{x}<0,$ which does not have solutions. So $f(x)$ is concave down nowhere.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250221 :knowledge-point/_questions [{:db/id #edb/ref 17592186184151 :knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019828a0-fbdc-537a-8fe9-5b80de591075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186247431} {:answer/id #uuid "217417c4-65b0-52cc-8f48-e79baf86e1e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186247721} {:answer/id #uuid "6b487ab3-1849-52cf-8132-e98f991e768e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248377} {:answer/id #uuid "6beea59f-abc8-583f-ba8e-22c69aa83b78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186248380} {:answer/id #uuid "cd41faeb-9c7a-544e-81b9-2f4df6f32fc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249246}] :answer-field/correct {:answer/id #uuid "cd41faeb-9c7a-544e-81b9-2f4df6f32fc9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249246} :answer-field/id #uuid "ed420674-00dc-5f69-865d-6a24ba592fc7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250084}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1339af8-7ec4-512f-92c7-059b9ab8ffee" :question/math-academy-id "q-114277" :question/problem "Consider the function $f(x)={x}^{3}+6\\operatorname{ln}⁡x$ defined on $x\\in (0,\\infty ).$ Which of the following statements are true?\n\n- $f(x)$ is concave up on $(0,1)$\n- $f(x)$ is concave down on $(0,1)$\n- $f(x)$ is concave down on $(1,\\infty )$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}+\\frac{6}{x} \\\\ {f}^{″}(x) & =6x-\\frac{6}{{x}^{2}} \\\\  & =\\frac{6({x}^{3}-1)}{{x}^{2}}.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}\\frac{6({x}^{3}-1)}{{x}^{2}} & >0 \\\\ {x}^{3}-1 & >0 \\\\ {x}^{3} & >1 \\\\ x & >1\\end{aligned}\n$$\n\nNote that we used the fact that ${x}^{2}>0.$\n\nHence, ${f}^{″}(x)>0$ when $x>1.$ So the graph is concave up on the interval $(1,\\infty ).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality ${x}^{3}-1<0,$ which has the solution $(0,1).$\n\nTherefore, the correct answer is \" II only.\""}] [{:db/id #edb/ref 17592186250260 :knowledge-point/_questions [{:db/id #edb/ref 17592186064165 :knowledge-point/id #uuid "ae256269-0bec-5d57-ac4a-eb0b07926f6f" :knowledge-point/title "Finding Critical Points and Then Classifying Them Using the Second Derivative Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41ba6f08-ffa4-5df8-8917-ff9643681793" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248010} {:answer/id #uuid "4b0b498d-d046-5823-b82d-3cc37f588338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186248096} {:answer/id #uuid "ab0c90f2-3c21-5466-82fe-5a7688ed1260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248945} {:answer/id #uuid "c06fb9fc-fb6a-5fe2-8221-bcd05bcdaabe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249135} {:answer/id #uuid "e0985838-f731-558d-b745-23e842859fbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249412}] :answer-field/correct {:answer/id #uuid "ab0c90f2-3c21-5466-82fe-5a7688ed1260" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248945} :answer-field/id #uuid "98404aba-858d-5765-bcf5-3bc5026d99a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a75ae1b4-9111-5369-af8d-34d27de2f589" :question/math-academy-id "q-114414" :question/problem "For the function $f(x)=x-{e}^{x},$ which of the following statements are true?\n\n- $x=0$ is a critical point of $f(x)$\n- ${f}^{″}(0)<0$\n- $f(x)$ has a relative minimum at $x=0$" :question/worked-solution "We need to identify whether $x=0$ is a critical point. If it is, we then need to classify it using the second derivative test.\n\nFirst, we need to identify the critical points. Differentiating $f(x)=x-{e}^{x},$ we get\n\n$$\n{f}^{′}(x)=1-{e}^{x},\n$$\n\nand solving ${f}^{′}(x)=0,$ we get\n\n$$\n\\begin{aligned}1-{e}^{x} & =0 \\\\ {e}^{x} & =1 \\\\ x & =0.\\end{aligned}\n$$\n\nSo we have a critical point at $x=0.$\n\nNext, we need to determine the sign of ${f}^{″}(x)$ at this critical point. Computing ${f}^{″}(x),$ we get\n\n$$\n{f}^{″}(x)=-{e}^{x},\n$$\n\nand evaluating ${f}^{″}(x)$ at $x=0$, we get\n\n$$\n{f}^{″}(0)=-1<0.\n$$\n\nThe second derivative is negative at $x=0,$ so this critical point is a relative *maximum*. \n\nTherefore, comparing our results with the given statements, we conclude that:\n\n- $x=0$ is a critical point of $f(x)\\,✓$\n\n- ${f}^{″}(0)<0\\,✓$\n\n- $f(0)$ has a relative *maximum* at $x=0\\,\\times $\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186250353 :knowledge-point/_questions [{:db/id #edb/ref 17592186083303 :knowledge-point/id #uuid "1894719c-d398-515d-9a7b-6af74727106c" :knowledge-point/title "Identifying Improper Integrals of the Second Kind"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1331863b-a302-58b4-9558-bc6c0b781ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247597} {:answer/id #uuid "36fe5dcf-5d70-5ccd-8b3b-8661bcaea147" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186247921} {:answer/id #uuid "92955910-edae-5a7a-b65c-edd5d27d9121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248725} {:answer/id #uuid "dcb4ad55-4197-5c67-b00c-1c2e28d99060" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249378} {:answer/id #uuid "fd61f6bd-4d20-5f39-9c6d-c8955e640d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249640}] :answer-field/correct {:answer/id #uuid "fd61f6bd-4d20-5f39-9c6d-c8955e640d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249640} :answer-field/id #uuid "94eeb897-d52c-516d-8260-943991a2821b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249937}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a47dc9e-71f1-5fb5-bcb1-b46747ed60f1" :question/math-academy-id "q-115206" :question/problem "Which of the following is an improper integral of the second kind?\n\nI. ${\\int }_{-1}^{1}\\frac{\\text{d}x}{{x}^{2}-4}\\,$  II. ${\\int }_{-\\infty }^{-3}\\frac{\\text{d}x}{{x}^{2}-4}\\,$  III. ${\\int }_{-2}^{1}\\frac{\\text{d}x}{{x}^{2}-4}$" :question/worked-solution "Let's examine each of the given integrals.\n\n- Integral I is not an improper integral since it has finite limits and the function under the integral is finite at every point $x\\in [-1,1].$\n\n- Integral II is an improper integral over an *infinite* domain since its lower limit is infinite.\n\n- Integral III is an improper integral of the second kind since it has finite limits, and \n\n$$\nf(x)=\\frac{1}{{x}^{2}-4}\\to -\\infty \\,\\text{as}\\,x\\to (-2)^{+}.\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186250375 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a68257a-86b4-5908-80eb-285edfc194db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248243} {:answer/id #uuid "694cd0ef-fee1-5c79-8281-fe247d09ead9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186248366} {:answer/id #uuid "c2f875cf-455d-5a8c-acee-6c3146b94e78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186249158} {:answer/id #uuid "d34cf6af-2c00-57ec-8304-4847345995db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186249299} {:answer/id #uuid "fcdcb298-7b79-568d-897a-b4a2ff1b56d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249635}] :answer-field/correct {:answer/id #uuid "c2f875cf-455d-5a8c-acee-6c3146b94e78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186249158} :answer-field/id #uuid "ea87d7d0-bddf-530a-b8bb-1f957f1ebc52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250078}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "05da4bb4-efa5-5a74-9032-2827a097e82b" :question/math-academy-id "q-115263" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-5}^{5}\\frac{x}{1+{x}^{2}}\\,\\text{d}x$\n- ${\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{sin}⁡x\\,\\text{d}x$\n- ${\\int }_{0}^{2}x\\operatorname{ln}⁡({x}^{2}+1)\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=\\frac{x}{1+{x}^{2}}$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =\\frac{(-x)}{1+(-x)^{2}} \\\\  & =-\\frac{x}{1+{x}^{2}} \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-5}^{5}\\frac{x}{1+{x}^{2}}\\,\\text{d}x=0.\n$$\n\n- The function $g(x)={x}^{2}\\operatorname{sin}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)^{2}\\operatorname{sin}⁡(-x) \\\\  & ={x}^{2}(-\\operatorname{sin}⁡x) \\\\  & =-{x}^{2}\\operatorname{sin}⁡x \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{sin}⁡x\\,\\text{d}x=0.\n$$\n\n- The function $h(x)=x\\operatorname{ln}⁡({x}^{2}+1)$ is an odd function, but integral III is not of the form ${\\int }_{-a}^{a}h(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186250379 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "238d6586-bab9-5bdb-8187-8147468e1985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186247736} {:answer/id #uuid "6262d449-b11b-5844-afb7-68ef87dba74f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248311} {:answer/id #uuid "a7c05775-6691-5070-947f-05ed96725a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248916} {:answer/id #uuid "fde42087-a0ff-5899-b7cb-0caad30c2eb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249645} {:answer/id #uuid "feabfa24-c8c1-5e6a-b9b9-449704c5547f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249652}] :answer-field/correct {:answer/id #uuid "fde42087-a0ff-5899-b7cb-0caad30c2eb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249645} :answer-field/id #uuid "472fa573-ccfb-5f90-a920-ccb63c4e1c18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249801}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c52ca68f-33c1-5cf6-9bde-bf78ae92f92f" :question/math-academy-id "q-115275" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-\\pi /2}^{\\pi /4}{sin}^{5}⁡x\\,\\text{d}x$\n- ${\\int }_{-2}^{2}({x}^{3}+{x}^{5})\\,\\text{d}x$\n- ${\\int }_{-\\pi /2}^{\\pi /2}{x}^{7}\\operatorname{cos}⁡(5x)\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={sin}^{5}⁡x$ is an odd function, but integral I is not of the form ${\\int }_{-a}^{a}f(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\n- The function $g(x)={x}^{3}+{x}^{5}$ is an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)^{3}+(-x)^{5} \\\\  & =-{x}^{3}+(-{x}^{5}) \\\\  & =-{x}^{3}-{x}^{5} \\\\  & =-({x}^{3}+{x}^{5}) \\\\  & =-g(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-2}^{2}({x}^{3}+{x}^{5})\\,\\text{d}x=0.\n$$\n\n- The function $h(x)={x}^{7}\\operatorname{cos}⁡(5x)$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{7}\\operatorname{cos}⁡(5(-x)) \\\\  & =-{x}^{7}\\operatorname{cos}⁡(-5x) \\\\  & =-{x}^{7}\\operatorname{cos}⁡(5x) \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-\\pi /2}^{\\pi /2}{x}^{7}\\operatorname{cos}⁡(5x)\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186250380 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "459accf0-23a6-5cd5-be5d-f06c689a80a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186248049} {:answer/id #uuid "6043e767-baed-5615-9697-55202301ef32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248295} {:answer/id #uuid "69bebc52-5fa9-59d8-8d55-df5e6b5d9d67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186248368} {:answer/id #uuid "7406a7f2-484b-51a7-8e94-40198c565077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248446} {:answer/id #uuid "956a99a4-a783-5805-9d28-e35e03330413" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186248755}] :answer-field/correct {:answer/id #uuid "7406a7f2-484b-51a7-8e94-40198c565077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248446} :answer-field/id #uuid "8d35f6e1-614d-5ded-90f4-bb0466a154b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249919}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "502954f5-6773-593e-9d60-d2c07c09bac0" :question/math-academy-id "q-115276" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-1/2}^{1/2}{x}^{2}\\operatorname{sin}⁡x\\,\\text{d}x$\n- ${\\int }_{-\\pi /8}^{\\pi /8}\\frac{{x}^{4}+2}{3}\\,\\text{d}x$\n- ${\\int }_{-3}^{3}({e}^{x}-{e}^{-x})\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)={x}^{2}\\operatorname{sin}⁡x$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)^{2}\\operatorname{sin}⁡(-x) \\\\  & ={x}^{2}(-\\operatorname{sin}⁡x) \\\\  & =-{x}^{2}\\operatorname{sin}⁡x \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-1/2}^{1/2}{x}^{2}\\operatorname{sin}⁡x\\,\\text{d}x=0.\n$$\n\n- The function $g(x)=\\frac{{x}^{4}+2}{3}$ is *not* an odd function:\n\n$$\n\\begin{aligned}g(-x) & =\\frac{(-x)^{4}+2}{3} \\\\  & =\\frac{{x}^{4}+2}{3} \\\\  & \\ne -g(x)\\,\\times \\end{aligned}\n$$\n\n- The function $h(x)={e}^{x}-{e}^{-x}$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & ={e}^{-x}-{e}^{-(-x)} \\\\  & ={e}^{-x}-{e}^{x} \\\\  & =-({e}^{x}-{e}^{-x}) \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-3}^{3}({e}^{x}-{e}^{-x})\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186250381 :knowledge-point/_questions [{:db/id #edb/ref 17592186157397 :knowledge-point/id #uuid "3a247336-9bc8-5799-9956-e3de188ce2d2" :knowledge-point/title "Identifying Integrals That Evaluate to Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09fabada-9b65-590b-b3ca-0788afb7286c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186247512} {:answer/id #uuid "0e85cea9-245a-5a0f-a45d-7f3bc6c47806" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186247559} {:answer/id #uuid "2a7baa3e-6099-53e4-81b7-162ea3b9a956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186247802} {:answer/id #uuid "a2e3f9a1-5352-5f98-8f32-42f3e4a90c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248879} {:answer/id #uuid "be541bbd-dec0-5943-8cc1-afbdcc6ea1eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249114}] :answer-field/correct {:answer/id #uuid "be541bbd-dec0-5943-8cc1-afbdcc6ea1eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249114} :answer-field/id #uuid "283c2091-2295-57ea-8c90-d9879bef6efd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249748}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fd35b4dd-cb0b-59b9-9a08-35fd436a6a59" :question/math-academy-id "q-115278" :question/problem "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-1}^{1}\\sqrt[3]{x}\\,\\text{d}x$\n- ${\\int }_{-\\pi }^{\\pi }(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)\\,\\text{d}x$\n- ${\\int }_{-2}^{4}\\frac{7{x}^{3}}{1+2{x}^{4}}\\,\\text{d}x$" :question/worked-solution "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to $0$ due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=\\sqrt[3]{x}$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =\\sqrt[3]{-x} \\\\  & =-\\sqrt[3]{x} \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-1}^{1}\\sqrt[3]{x}\\,\\text{d}x=0.\n$$\n\n- The function $g(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x$ is *not* an odd function:\n\n$$\n\\begin{aligned}g(-x) & =\\operatorname{sin}⁡(-x)+\\operatorname{cos}⁡(-x) \\\\  & =-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x \\\\  & \\ne -g(x)\\,\\times \\end{aligned}\n$$\n\n- The function $h(x)=\\frac{7{x}^{3}}{1+2{x}^{4}}$ is an odd function, but integral III is not of the form ${\\int }_{-a}^{a}h(x)\\,\\text{d}x$ since the upper and lower limits are not opposites. Therefore, we cannot use symmetry to simplify the integral.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250432 :knowledge-point/_questions [{:db/id #edb/ref 17592186087696 :knowledge-point/id #uuid "3ca13445-0218-5950-967e-a68bcfec32c7" :knowledge-point/title "Identifying a Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd1844a-a2f1-529d-863c-8fe536c9e932" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $T$ only" :db/id #edb/ref 17592186247529} {:answer/id #uuid "664a3523-0bf9-55cf-bea4-0dda02423683" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186248345} {:answer/id #uuid "72790dff-66d2-56e1-aea1-76beff02b328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$T$ only" :db/id #edb/ref 17592186248424} {:answer/id #uuid "a2a083d5-cf0e-57e4-ac8a-12961fd1f0d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $S$ only" :db/id #edb/ref 17592186248877} {:answer/id #uuid "c9ff768e-8517-55a3-9d8a-bddaa9b97956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186249221}] :answer-field/correct {:answer/id #uuid "c9ff768e-8517-55a3-9d8a-bddaa9b97956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ and $T$ only" :db/id #edb/ref 17592186249221} :answer-field/id #uuid "0d1f18a6-9271-5b79-8e31-606d8ed0f49f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4dac05e-84dd-5a26-905f-fb4d126dc4c6" :question/math-academy-id "q-11556" :question/problem "Which of the following are square matrices?\n\n$$\nP=[\\begin{aligned}0 & 0 \\\\ -10 & 0.5 \\\\ -2 & 0\\end{aligned}],\\,S=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}],\\,T=[\\begin{aligned}1.5 & -3 & 0 & 1 & 9 \\\\ 0 & 0.2 & 1 & 0 & 0 \\\\ 0 & \\sqrt{3} & 0 & 0 & 1 \\\\ -2 & 0 & 0 & 6 & 0 \\\\ 2 & 1 & 0 & 5 & 8\\end{aligned}]\\,\n$$" :question/worked-solution "- $P$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $3$ rows and $2$ columns, so it's a $3\\times 2$ matrix.\n\n- $S$ is a square matrix since it has the same number of rows and columns. It has $2$ rows and $2$ columns, so it is a $2\\times 2$ matrix.\n\n- $T$ is a square matrix since it has the same number of rows and columns. It has $5$ rows and $5$ columns, so it is a $5\\times 5$ matrix.\n\nTherefore, only $S$ and $T$ are square matrices."}] [{:db/id #edb/ref 17592186250472 :knowledge-point/_questions [{:db/id #edb/ref 17592186166820 :knowledge-point/id #uuid "ede6800b-ecfd-5ef8-a386-4aec94ddd89c" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Stationary Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e5e928-4c9f-5b5f-81dc-a3066bf06149" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186247451} {:answer/id #uuid "63eb8b9f-7e16-5bef-9bbe-7f3b0d7706a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248326} {:answer/id #uuid "97c97642-e881-5d28-9e81-8b224dd449fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186248777} {:answer/id #uuid "9d61ae3c-a5c8-5f8a-a518-11a2cdb54153" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248825} {:answer/id #uuid "de18626d-65e1-5139-8624-7e9272e93b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249391}] :answer-field/correct {:answer/id #uuid "de18626d-65e1-5139-8624-7e9272e93b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249391} :answer-field/id #uuid "9ff5eff9-0e92-5d4d-87cf-ba4812b880ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249952}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1598c957-f6d6-5194-a4fb-4b15b46e8010" :question/math-academy-id "q-115716" :question/problem "![](images/a0/a0b39135b78cefe8471c7d120850dde9b53786342679b5ed7f25af9110350607.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-x(x-3)$\n- ${y}^{′}=9-{x}^{2}$\n- ${y}^{′}=x(x-2)(x-3)$" :question/worked-solution "![](images/a4/a43217f2af81c1bbacbebd8800b7ebcd4076a32d6ff61782e1fdab4cd182d5ee.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $x=0$ and $x=3,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=-x(x-3)$ gives the required behavior. The right-hand side evaluates to zero at $x=0$ and $x=3.$\n\n- The equation ${y}^{′}=9-{x}^{2}$ does *not* give the required behavior. The right-hand side does not evaluate to zero at both $x=0$ and $x=3.$\n\n- The equation ${y}^{′}=x(x-2)(x-3)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=0$ and $x=3,$ but it also evaluates to zero when $x=2,$ which is not a behavior exhibited by our slope field.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250473 :knowledge-point/_questions [{:db/id #edb/ref 17592186166820 :knowledge-point/id #uuid "ede6800b-ecfd-5ef8-a386-4aec94ddd89c" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Stationary Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f5c157-455d-563f-bcfd-0b8b1c728af1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247453} {:answer/id #uuid "774f1c82-da5d-5e3c-be54-5f5c9ed701ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248476} {:answer/id #uuid "b884adc9-6a7a-5ecf-a780-525d647c5f8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249073} {:answer/id #uuid "beb8c7fe-4ae0-5395-8a26-32f2cbe53bcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249120} {:answer/id #uuid "d97bc5ea-19c5-57ce-9ef6-faf26b7867a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249343}] :answer-field/correct {:answer/id #uuid "03f5c157-455d-563f-bcfd-0b8b1c728af1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247453} :answer-field/id #uuid "10bb6fc0-92a3-5dcb-bd65-28de87e6ce38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249699}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c861b6c2-4257-5ae6-8d33-89c2fd430076" :question/math-academy-id "q-115719" :question/problem "![](images/17/170ddea2148f369d4feedd14540f234d7946bb6670d1ca6eb4c4ebbbb086a760.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=(x+3)(x+7)$\n- ${y}^{′}=x(x+3)$\n- ${y}^{′}=(x+3)(x+5)$" :question/worked-solution "![](images/cf/cf77e09457cd6b53da801a6eb876a79712935eba623c851a5b6dafa58887a076.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $x=-3$ and $x=-7,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=(x+3)(x+7)$ gives the required behavior. The right-hand side evaluates to zero at $x=-7$ and $x=-3.$\n\n- The equation ${y}^{′}=x(x+3)$ does *not* give the required behavior. The right-hand side does not evaluate to zero at $x=-7,$ and also evaluates to zero when $x=0,$ which is not a behavior exhibited by our slope field.\n\n- The equation ${y}^{′}=(x+3)(x+5)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=-3$ but it also evaluates to zero when $x=-5,$ which is not a behavior exhibited by our slope field.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250477 :knowledge-point/_questions [{:db/id #edb/ref 17592186166822 :knowledge-point/id #uuid "32b9a92b-880b-50de-b8e9-648fa219b83f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "036e5781-0c2d-511c-b306-03ce5578506d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186247448} {:answer/id #uuid "11bca821-fe32-5fbb-b01e-669a9d8bfda3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186247582} {:answer/id #uuid "80dbd128-d53f-54d7-96fa-2ce3841e95ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186248560} {:answer/id #uuid "8cc52de5-eb32-56e3-a072-be05cf785eb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248681} {:answer/id #uuid "dbb94267-22cd-58c8-9ab6-ccbc5e5996ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249365}] :answer-field/correct {:answer/id #uuid "8cc52de5-eb32-56e3-a072-be05cf785eb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248681} :answer-field/id #uuid "eb84752c-6f8d-5419-aca9-96650e68de77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "988f2d4b-1d26-5c62-baed-2061d6f81ef4" :question/math-academy-id "q-115751" :question/problem "![](images/25/2552222c6a0be1b1bf1e67a66b4906bb735c2d974d724d3e25e988d15388c696.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=\\frac{1}{1-{x}^{2}}$\n- ${y}^{′}=-\\frac{8}{x+1}$\n- ${y}^{′}=-\\frac{{x}^{2}}{x+1}$" :question/worked-solution "![](images/eb/eb1303132a4fe6a26c85b4733a3039a52109b4c49408e1c82038d71885d27f70.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The solution curves have the vertical asymptote $x=-1.$\n\n- The slopes of the slope field become horizontal as $x\\to \\pm \\infty .$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=\\frac{1}{1-{x}^{2}}$ does *not* give the required behavior. The right-hand side approaches $\\pm \\infty $ as $x\\to -1,$ but it also approaches $\\pm \\infty $ as $x\\to 1,$ which is not a behavior exhibited by our slope field.\n\n- The equation ${y}^{′}=-\\frac{8}{x+1}$ gives the required behavior. Notice that\n\n$$\n-\\frac{8}{x+1}\\to 0\\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation become horizontal as $x\\to \\pm \\infty .$\n\n- The equation ${y}^{′}=-\\frac{{x}^{2}}{x+1}$ does *not* give the required behavior. Notice that\n\n$$\n-\\frac{{x}^{2}}{x+1}=-\\frac{x}{(1+\\frac{1}{x})}\\to ∓\\infty \\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become horizontal as $x\\to \\pm \\infty .$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186250478 :knowledge-point/_questions [{:db/id #edb/ref 17592186166822 :knowledge-point/id #uuid "32b9a92b-880b-50de-b8e9-648fa219b83f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cb25af3-759f-5845-9d0a-5c64e9a1d753" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186247540} {:answer/id #uuid "9d566ffc-6d24-574d-9dcb-b816b33a4e51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248824} {:answer/id #uuid "ba0d04b3-79b2-5869-803c-1f2baebef8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249086} {:answer/id #uuid "e5506458-7627-548b-99c2-61982caaa776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249444} {:answer/id #uuid "f64e71d1-f4e0-5839-9d5d-061c101be48d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249572}] :answer-field/correct {:answer/id #uuid "f64e71d1-f4e0-5839-9d5d-061c101be48d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249572} :answer-field/id #uuid "cddfe8a2-6665-58ee-9a60-27f02f690654" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3be4e44a-f534-5d30-81ef-fc22fbf18076" :question/math-academy-id "q-115754" :question/problem "![](images/34/34af8d1078100aea331c300ea529d2fdefbdd31e99ee8a7946325d58a8abf680.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=7-{x}^{2}$\n- ${y}^{′}=-\\frac{{x}^{3}}{x+7}$\n- ${y}^{′}=-\\frac{3}{x+7}$" :question/worked-solution "![](images/d0/d02883b776dbcd55c5c96347ed1a7bb0e51ef8c26e62786049b6585b878d04fb.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The solution curves have the vertical asymptote $x=-7.$\n\n- The slopes of the slope field become horizontal as $x\\to \\pm \\infty .$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=7-{x}^{2}$ does *not* give the required behavior. The right-hand side does not approach $\\pm \\infty $ as $x\\to -7.$\n\n- The equation ${y}^{′}=-\\frac{{x}^{3}}{x+7}$ does *not* give the required behavior. Notice that\n\n$$\n-\\frac{{x}^{3}}{x+7}=-\\frac{{x}^{2}}{(1+\\frac{7}{x})}\\to -\\infty \\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become horizontal as $x\\to \\pm \\infty .$\n\n- The equation ${y}^{′}=-\\frac{3}{x+7}$ gives the required behavior. Notice that\n\n$$\n-\\frac{3}{x+7}\\to 0\\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation become horizontal as $x\\to \\pm \\infty .$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186250486 :knowledge-point/_questions [{:db/id #edb/ref 17592186166860 :knowledge-point/id #uuid "762c5225-00bd-5d2f-9859-394f886482cb" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a70b7a1-f7d2-545b-ad3d-cb106c380650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247801} {:answer/id #uuid "706bd00b-5df5-5ce8-b170-c21c47f7a81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186248410} {:answer/id #uuid "798c0ebe-8d9f-54a7-9062-b74c82148d6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186248493} {:answer/id #uuid "e708a976-255f-51b5-8839-709878f94acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186249459} {:answer/id #uuid "f1735b0a-a31a-5ef9-83af-f1fa53045d63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249544}] :answer-field/correct {:answer/id #uuid "f1735b0a-a31a-5ef9-83af-f1fa53045d63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249544} :answer-field/id #uuid "d514e73f-f9b1-511a-9972-246142757c78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250040}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ef86548-9209-58c6-a39c-c5582ffe1c99" :question/math-academy-id "q-115813" :question/problem "![](images/5a/5a2a2b4b141f4f0c250e4865b174b9eb32b1ed4ab94cc6ebd074131673d5712c.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-2{x}^{2}-4x-2$\n- ${y}^{′}={x}^{2}+2x+1$\n- ${y}^{′}={x}^{2}-1$" :question/worked-solution "![](images/69/69465ce0573d7b6deac631663766a5dd1c90afa29eeb0c5286cb5ef1f7ee1153.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slope field is zero along the line $x=-1.$ Therefore, the right-hand side of the differential equation should evaluate to zero on this line.\n\n- Second, the line $x=-1$ divides the plane into $2$ regions. The sign of the slopes in each of the $2$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $x<-1$ | $x>-1$ |\n| --- | --- | --- |\n| Slope | $↗$ | $↗$ |\n| Sign | $+$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation \n\n$$\n{y}^{′}=-2{x}^{2}-4x-2=-2(x+1)^{2}\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $x<-1$ | $x>-1$ |\n| --- | --- | --- |\n| Slope | $↘$ | $↘$ |\n| Sign | $-$ | $-$ |\n\n- The equation \n\n$$\n{y}^{′}={x}^{2}+2x+1=(x+1)^{2}\n$$\n\ngives the required behavior.\n\n- The equation\n\n$$\n{y}^{′}={x}^{2}-1=(x+1)(x-1)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1$ and $x=1.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186250498 :knowledge-point/_questions [{:db/id #edb/ref 17592186166857 :knowledge-point/id #uuid "954f8004-35b4-58ec-be26-2beccfd5f8e4" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Equilibrium Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f635314-7bbe-543d-9330-e4dd4cfd259c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247703} {:answer/id #uuid "303d687a-571d-5dab-8c6d-2f8cb1f6b314" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186247860} {:answer/id #uuid "9319d07d-24b2-56a5-bd9b-eb8b844c584f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248728} {:answer/id #uuid "b2f6ba84-fc5c-5bce-8e0a-d1ba8a6aa5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249027} {:answer/id #uuid "f7eb232f-2134-58db-95b4-d534d0ae0b04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186249585}] :answer-field/correct {:answer/id #uuid "1f635314-7bbe-543d-9330-e4dd4cfd259c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247703} :answer-field/id #uuid "cf87951c-66fe-5a6c-a014-42535b4ed7bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250029}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "335e4d6e-44ad-5f4c-9625-f1960ad24196" :question/math-academy-id "q-115880" :question/problem "![](images/bc/bc5b29fca0521e3da39993d0359e857333611c68c35e49c037ca7af031288ba3.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}={y}^{2}(y+4)$\n- ${y}^{′}=(y+1)^{2}(y+4)$\n- ${y}^{′}=-y(y+1)(y+4)$" :question/worked-solution "![](images/cd/cd73bc9f35e167537996a3b33b84471dcb8fefe2eccb4afd21ca55a23e6478fd.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $y=-4$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}={y}^{2}(y+4)$ gives the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=-4.$\n\n- The equation ${y}^{′}=(y+1)^{2}(y+4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=-1$ and $y=-4.$\n\n- The equation ${y}^{′}=-y(y+1)(y+4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=-4,$ but it also evaluates to zero when $y=-1,$ which is not behavior exhibited by our slope field.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250501 :knowledge-point/_questions [{:db/id #edb/ref 17592186166857 :knowledge-point/id #uuid "954f8004-35b4-58ec-be26-2beccfd5f8e4" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Equilibrium Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1310c0e8-599f-5637-a700-cfa30eab08b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186247596} {:answer/id #uuid "3be174b3-acd6-5e12-b494-e3feb929e79b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247955} {:answer/id #uuid "63156a36-40c3-5141-b0c8-38fea07101f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186248323} {:answer/id #uuid "9bf3e7d2-00de-56ff-816e-b8f6dc1615f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248812} {:answer/id #uuid "c2c4b8ba-1b74-5d32-abca-c4977090e169" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249156}] :answer-field/correct {:answer/id #uuid "3be174b3-acd6-5e12-b494-e3feb929e79b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247955} :answer-field/id #uuid "4749b0d7-4663-5dac-93ce-0f1731e2734c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249802}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5780ba6c-1a2c-5799-b86a-8148f7437eba" :question/math-academy-id "q-115888" :question/problem "![](images/2e/2e2d4b78d8181efc77f65af0c3dc4b3110d0203e650006a0e99d9a8ba933b53f.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-(y-1)(y-4)$\n- ${y}^{′}=y(y-1)(y-4)$\n- ${y}^{′}={y}^{2}(y-1)$" :question/worked-solution "![](images/7e/7e207bc990a9dfbafa8474ad13c17482e21c323833be848f4ebbaa580abeb201.png)\n\n \n\nNotice that the slopes of the slope field are horizontal along the lines $y=1$ and $y=4,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=-(y-1)(y-4)$ gives the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=4.$\n\n- The equation ${y}^{′}=y(y-1)(y-4)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=4,$ but it also evaluates to zero when $y=0,$ which is not behavior exhibited by our slope field.\n\n- The equation ${y}^{′}={y}^{2}(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=1.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250511 :knowledge-point/_questions [{:db/id #edb/ref 17592186166858 :knowledge-point/id #uuid "0ca086fd-9732-5c4b-9cb0-168433d79203" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16e2af61-aafd-5445-8a31-5f4614d1819b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186247630} {:answer/id #uuid "18b58e5f-ae6c-5009-8842-600acf86ba66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186247647} {:answer/id #uuid "4d84cf32-0566-560d-bf2c-7cceae3a6f19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186248118} {:answer/id #uuid "758f1310-70a8-587a-b487-3353c125039e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186248458} {:answer/id #uuid "c3e199fe-ab25-54d7-a08b-720be73763c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249163}] :answer-field/correct {:answer/id #uuid "18b58e5f-ae6c-5009-8842-600acf86ba66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186247647} :answer-field/id #uuid "cce821a0-c17f-5e50-a522-b0096a1242ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250024}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d530f455-01e1-528c-b25a-48e2a9adee74" :question/math-academy-id "q-115935" :question/problem "![](images/57/57ecd122ba41b296b3884ecd4f748f6b4ac4bd1d26f14d7b5166c5fe6e33674b.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=(y+1)^{2}(y-1)$\n- ${y}^{′}=(y+1)(1-y)$\n- ${y}^{′}=(y-1)^{2}$" :question/worked-solution "![](images/e1/e109d237419aaba5efcc0c65c2d97c8f8ded17d18f98bb0a95eba3336d224590.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $y=\\pm 1.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=\\pm 1$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<-1$ | $-1<y<1$ | $y>1$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↘$ |\n| Sign | $-$ | $+$ | $-$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=(y+1)^{2}(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=\\pm 1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<-1$ | $-1<y<1$ | $y>1$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↘$ | $↗$ |\n| Sign | $-$ | $-$ | $+$ |\n\n- The equation ${y}^{′}=(y+1)(1-y)$ gives the required behavior.\n\n- The equation ${y}^{′}=(y-1)^{2}$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ only.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186250512 :knowledge-point/_questions [{:db/id #edb/ref 17592186166858 :knowledge-point/id #uuid "0ca086fd-9732-5c4b-9cb0-168433d79203" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5337bb53-8bd7-5ca5-9f50-97964816e87e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248175} {:answer/id #uuid "8a040f52-0d3d-5a86-9097-9d01caa5a699" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186248652} {:answer/id #uuid "b42439aa-8285-5201-bb4e-edfd58cd4549" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249036} {:answer/id #uuid "c4ff27dd-00be-5fbe-91de-03595953c338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186249173} {:answer/id #uuid "c905a62e-9140-506f-b08d-c74b4beaa2ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249211}] :answer-field/correct {:answer/id #uuid "b42439aa-8285-5201-bb4e-edfd58cd4549" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186249036} :answer-field/id #uuid "e7f5ff79-a6b6-57ab-b88b-3aa4be508d4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250071}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe403345-e284-5ce7-b15f-086966b32179" :question/math-academy-id "q-115940" :question/problem "![](images/92/92c557774a625d93c34fea181f435c1e6e544daa606a76c512bd96a7b9c047e7.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}={y}^{2}(3-y)$\n- ${y}^{′}=y(y-3)^{2}$\n- ${y}^{′}=y(y-1)$" :question/worked-solution "![](images/58/583fe0e13218462bdb4286ce456b0bcc4d43dd3772033e62a53242107a0a69db.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $y=0$ and $y=3.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=0$ and $y=3$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<0$ | $0<y<3$ | $y>3$ |\n| --- | --- | --- | --- |\n| Slope | $↗$ | $↗$ | $↘$ |\n| Sign | $+$ | $+$ | $-$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}={y}^{2}(3-y)$ gives the required behavior.\n\n- The equation ${y}^{′}=y(y-3)^{2}$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=3,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<0$ | $0<y<3$ | $y>3$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↗$ |\n| Sign | $-$ | $+$ | $+$ |\n\n- The equation ${y}^{′}=y(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=1$ and $y=0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186250518 :knowledge-point/_questions [{:db/id #edb/ref 17592186166859 :knowledge-point/id #uuid "fba5f68e-15da-5804-b6d9-d72ce6acae59" :knowledge-point/title "Identifying an Equation That Generates a Slope Field by Identifying Asymptotic Behavior"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10efb501-486f-5570-8ff5-2b3a0b6f5c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247574} {:answer/id #uuid "7efb7bba-d779-5965-a5d4-2b0dc8643426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186248540} {:answer/id #uuid "843783d8-122b-5940-b62f-08949a459530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186248594} {:answer/id #uuid "89bc18eb-f39a-59e9-a62b-8a3c1bfffc14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186248648} {:answer/id #uuid "f289a0b9-8110-5c23-bc3e-9b36db97005d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249550}] :answer-field/correct {:answer/id #uuid "10efb501-486f-5570-8ff5-2b3a0b6f5c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247574} :answer-field/id #uuid "ae681555-5ba8-5a0e-ba65-791ccbb47afe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249979}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "df71ed63-f106-5382-97b4-fb9c0eee25d2" :question/math-academy-id "q-116040" :question/problem "![](images/dd/ddb340a99b8ab92d60e17184274854ce3d1b1bfa4972a79e74b8bfe9b0a81ce7.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-\\frac{1}{y+3}$\n- ${y}^{′}=\\frac{1}{(y+3)^{2}}$\n- ${y}^{′}=-\\frac{y}{y+3}$" :question/worked-solution "![](images/73/73ba54766cd08a0b596e43cd8da93209e2548c68821e70a44418a24dfdf27a38.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- The slopes of the slope field become vertical as $y\\to -3.$\n\n- The slopes of the slope field become horizontal as $y\\to \\infty .$\n\n- The slopes of the slope field are positive for $y<-3$ and negative for $y>-3.$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=-\\frac{1}{y+3}$ gives the required behavior. Notice that ${y}^{′}\\to 0$ as $y\\to \\infty ,$ and ${y}^{′}\\to \\infty $ as $y\\to -3.$ Also, the right-hand side of this equation is positive for $y<-3$ and negative for $y>-3.$\n\n- The equation ${y}^{′}=-\\frac{1}{(y+3)^{2}}$ does *not* give the required behavior. The slopes of the slope field for this differential equation are positive for all $y\\ne -3.$\n\n- The equation ${y}^{′}=-\\frac{y}{y+3}$ does *not* give the required behavior. Notice that\n\n$$\n-\\frac{y}{y+3}=-\\frac{1}{(1+\\frac{3}{y})}\\to -1\\,\\text{as}\\,y\\to \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not become horizontal as $y\\to \\infty .$"}] [{:db/id #edb/ref 17592186250536 :knowledge-point/_questions [{:db/id #edb/ref 17592186166861 :knowledge-point/id #uuid "800080f9-db79-5218-acaf-04040ab28a5d" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40469f21-5aab-555d-b3d4-012f553ccb96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247992} {:answer/id #uuid "49e28137-a931-5829-9539-fd4c436ddaf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186248081} {:answer/id #uuid "6053375b-9584-59d9-a586-7745e7096538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186248297} {:answer/id #uuid "b1a04d3c-4abf-59b4-8ce3-dbba205c8194" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186249015} {:answer/id #uuid "da2b211b-fd7c-5395-ad0b-88e138372393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186249351}] :answer-field/correct {:answer/id #uuid "40469f21-5aab-555d-b3d4-012f553ccb96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186247992} :answer-field/id #uuid "f5e0fbbe-77a2-52fe-8ef4-2cf5f452ea11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250103}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5fe91b2-7a65-5a6c-99ca-fdba41d5ec25" :question/math-academy-id "q-116150" :question/problem "![](images/15/158e4f6067ce12d5a31cc6ee0b217a8d11a459db5883fdd0b28ffdc2bd969a5e.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-{y}^{3}-2{y}^{2}$\n- ${y}^{′}={y}^{3}+4{y}^{2}+4y$\n- ${y}^{′}=2y-{y}^{2}$" :question/worked-solution "![](images/41/41b6dc7fd4e9a7dba6e14fe2d9fb87e7c07736ec0fc3cc111dd347b61c1075bb.png)\n\n \n\nNotice the following properties of the given slope field:\n\n- First, the slope field is zero along the lines $y=-2$ and $y=0.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=-2$ and $y=0$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<-2$ | $-2<y<0$ | $y>0$ |\n| --- | --- | --- | --- |\n| Slope | $↗$ | $↘$ | $↘$ |\n| Sign | $+$ | $-$ | $-$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation \n\n$$\n{y}^{′}=-{y}^{3}-2{y}^{2}=-{y}^{2}(y+2)\n$$\n\ngives the required behavior.\n\n- The equation \n\n$$\n{y}^{′}={y}^{3}+4{y}^{2}+4y=y({y}^{2}+4y+4)=y(y+2)^{2}\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $y=-2$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<-2$ | $-2<y<0$ | $y>0$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↘$ | $↗$ |\n| Sign | $-$ | $-$ | $+$ |\n\n- The equation\n\n$$\n{y}^{′}=2y-{y}^{2}=y(2-y)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=2.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186253300 :knowledge-point/_questions [{:db/id #edb/ref 17592186110571 :knowledge-point/id #uuid "67692569-e3a4-51e8-99ac-79d8b3081363" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8678af-9e9b-5e23-b9a2-eb68c9a9bb80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250781} {:answer/id #uuid "39ec9f6f-f551-5591-a55c-a594d6e4d844" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251031} {:answer/id #uuid "711dad1c-7a02-50e4-a1b2-49a969aeb7c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251476} {:answer/id #uuid "7eefdb9f-22af-59b5-9db6-c28f4606fe87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186251619} {:answer/id #uuid "f189fa27-ee12-51b1-a7a1-9572bd1b0edd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186252664}] :answer-field/correct {:answer/id #uuid "7eefdb9f-22af-59b5-9db6-c28f4606fe87" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186251619} :answer-field/id #uuid "874eb15c-48d5-57a1-bcc2-f3368127040b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253036}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9ed09ea-d30a-5142-9dec-aca74736564e" :question/math-academy-id "q-117025" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\n- $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$\n- $(\\frac{1}{4},-\\frac{\\pi }{2})$\n- $(1,\\pi )$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{3\\pi }{4},\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ and $y=\\frac{3\\pi }{4}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},\\frac{3\\pi }{4})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $(\\frac{1}{4},-\\frac{\\pi }{2}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{2},\\frac{1}{4})$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $(\\frac{1}{4},-\\frac{\\pi }{2})$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(1,\\pi ).$ We note the following:\n\n- The point $(\\pi ,1)$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $(1,\\pi )$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$"}] [{:db/id #edb/ref 17592186253311 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53f8a513-396e-5b6c-82fd-3f387d99a288" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$J$ and $K$ only" :db/id #edb/ref 17592186251240} {:answer/id #uuid "67d6f37c-f53b-5088-b8ba-cda179ec4a84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$J$ only" :db/id #edb/ref 17592186251405} {:answer/id #uuid "ad327d0b-f51d-532c-9b46-1f672c600289" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$H$ and $J$ only" :db/id #edb/ref 17592186252060} {:answer/id #uuid "adc74c57-05a9-522b-94af-44b5b4cd87c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$H$ only" :db/id #edb/ref 17592186252068} {:answer/id #uuid "ecc06fd0-7f08-5648-95fc-5db5f0d8b54e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$H$ and $K$ only" :db/id #edb/ref 17592186252627}] :answer-field/correct {:answer/id #uuid "ad327d0b-f51d-532c-9b46-1f672c600289" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$H$ and $J$ only" :db/id #edb/ref 17592186252060} :answer-field/id #uuid "e65b060c-8abe-51d4-80dd-024c1bdb2a34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253206}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87ca815d-8c8d-5ffa-9415-2a57d9bd87a2" :question/math-academy-id "q-11717" :question/problem "Which of the matrices below are singular?\n\n$$\nH=[\\begin{aligned}5 & 0 \\\\ 3 & 0\\end{aligned}],\\,J=[\\begin{aligned}2 & 4 \\\\ 3 & 6\\end{aligned}],\\,K=[\\begin{aligned}1 & 4 \\\\ 0 & 5 \\\\ -3 & 0\\end{aligned}].\n$$" :question/worked-solution "- For the matrix $H$, we have\n\n$$\ndet(H)=5\\cdot 0-3\\cdot 0=0.\n$$\n\nBecause $det(H)=0,$ we conclude that $H$ is not invertible. Since $H$ is a square matrix that is not invertible, we also say that $H$ is singular.\n\n- For the matrix $J$, we have\n\n$$\ndet(J)=2\\cdot 6-3\\cdot 4=0.\n$$\n\nBecause $det(J)=0,$ we conclude that $J$ is not invertible. Since $J$ is a square matrix that is not invertible, we also say that $J$ is singular.\n\n- The matrix $K$ is a $3\\times 2$ matrix. So, it is not invertible. Since the matrix is not square, we can't say that it's singular.\n\nTherefore, only $H$ and $J$ is singular."}] [{:db/id #edb/ref 17592186253319 :knowledge-point/_questions [{:db/id #edb/ref 17592186110575 :knowledge-point/id #uuid "af0b18ca-54a2-5a24-a670-faa311096abc" :knowledge-point/title "Determining Points that Lie on the Curve of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8b3b4b-523b-50d9-9620-d0dcd6ee0426" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186250942} {:answer/id #uuid "6a12bc1d-346d-5865-a3ef-74c868161cb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251424} {:answer/id #uuid "6a64ee6e-abb8-5e98-a9ad-fedac4c15462" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251426} {:answer/id #uuid "82a5d500-181e-526d-a989-adea8750b2e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186251656} {:answer/id #uuid "baf2cb65-7c88-5c78-bd47-ed0e56b75d60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252198}] :answer-field/correct {:answer/id #uuid "82a5d500-181e-526d-a989-adea8750b2e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186251656} :answer-field/id #uuid "0bad97e9-7902-5795-87f4-25913dad9dee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252831}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "90a74c1f-7bff-59cd-a30f-99c5f38ea504" :question/math-academy-id "q-117250" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arccos}⁡x?$\n\n- $(1,0)$\n- $(0,\\pi )$\n- $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arccos}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{cos}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arccos}⁡x,$ which is $y\\in [0,\\pi ].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $(1,0).$ We note the following:\n\n- The point $(0,1)$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=0$ lies within this range. $\\,✓$\n\nTherefore, the point $(1,0)$ lies on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Next, we consider the point $(0,\\pi ).$ We note the following:\n\n- The point $(\\pi ,0)$ does **not** lie on the graph of $y=\\operatorname{cos}⁡x.\\,\\times $\n\nTherefore, the point $(0,\\pi )$ does **not** lie on the graph of $y=\\operatorname{arccos}⁡x.$\n\n- Finally, we consider the point $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},\\frac{\\sqrt{2}}{2})$ lies on the graph of $y=\\operatorname{cos}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arccos}⁡x$ is $y\\in [0,\\pi ],$ and $y=\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{2}}{2},\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arccos}⁡x.$"}] [{:db/id #edb/ref 17592186253327 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cf6236b-b145-5813-8b34-2129de6e5b8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251321} {:answer/id #uuid "8bdfb6e3-02b1-5adb-aa5f-f5e87ec31397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251733} {:answer/id #uuid "b437b3f5-1889-5066-a9a3-bc866efa9030" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186252135} {:answer/id #uuid "b7790e9f-c57f-518e-b756-faf03846ce7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252169} {:answer/id #uuid "bbad8a3c-3b9a-54d1-bc1a-25346d970642" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186252205}] :answer-field/correct {:answer/id #uuid "bbad8a3c-3b9a-54d1-bc1a-25346d970642" :answer/type {:db/id #edb/r