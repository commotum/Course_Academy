{:answer-field/choices [{:answer/id #uuid "29ed49e8-aa20-57b8-b976-39fafdd2efbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186250912} {:answer/id #uuid "53671adf-1865-5851-a82c-dae65890db42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251234} {:answer/id #uuid "6e48dfa6-efdd-5ef3-9155-12fa014d2764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251455} {:answer/id #uuid "b3a1e8ce-434e-57eb-9237-3bd53e4aa65a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186252128} {:answer/id #uuid "d382ed98-70ad-5611-9eb3-69d637a76575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252425}] :answer-field/correct {:answer/id #uuid "b3a1e8ce-434e-57eb-9237-3bd53e4aa65a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186252128} :answer-field/id #uuid "96c901ce-76aa-52f3-923a-e1e306156549" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253069}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bfbb710f-9bcf-5482-b898-5f45cf7ceff2" :question/math-academy-id "q-117366" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\n- $(1,\\frac{\\pi }{4})$\n- $(\\sqrt{3},\\frac{\\pi }{3})$\n- $(-\\frac{\\sqrt{3}}{3},-\\frac{\\pi }{6})$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(1,\\frac{\\pi }{4}).$ We note the following:\n\n- The point $(\\frac{\\pi }{4},1)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{4}$ lies within this range. $\\,✓$\n\nTherefore, the point $(1,\\frac{\\pi }{4})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\sqrt{3},\\frac{\\pi }{3})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(-\\frac{\\sqrt{3}}{3},-\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(-\\frac{\\pi }{6},-\\frac{\\sqrt{3}}{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=-\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(-\\frac{\\sqrt{3}}{3},-\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186253337 :knowledge-point/_questions [{:db/id #edb/ref 17592186110588 :knowledge-point/id #uuid "7f045b43-4785-5989-8b5a-dcb8401d1bb3" :knowledge-point/title "Determining Points that Lie on the Graph of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86218bc0-259c-5e57-a9f7-9e7223bddb4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251677} {:answer/id #uuid "9719f56a-da12-5022-af55-75bf10400eb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251849} {:answer/id #uuid "b57cb08e-ad7e-5089-a3c3-b81c5c3be925" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252148} {:answer/id #uuid "dcdc45c3-beea-51df-a813-7a1c4fef0538" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252497} {:answer/id #uuid "ef36c6bf-881c-5081-9535-d756f3a835cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186252647}] :answer-field/correct {:answer/id #uuid "ef36c6bf-881c-5081-9535-d756f3a835cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186252647} :answer-field/id #uuid "b7a12545-b523-55c2-8224-7fdcb91b24af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253122}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d01f8dbc-d72d-57bf-bd1d-25c6d02854e4" :question/math-academy-id "q-117371" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arctan}⁡x?$\n\n- $(\\frac{\\sqrt{3}}{3},\\frac{\\pi }{6})$\n- $(\\sqrt{3},\\frac{7\\pi }{3})$\n- $(0,0)$" :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arctan}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{tan}⁡x.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arctan}⁡x,$ which is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}).$\n\nWith this in mind, let's check each of the points. \n\n- First,  we consider the point $(\\frac{\\sqrt{3}}{3},\\frac{\\pi }{6}).$ We note the following:\n\n- The point $(\\frac{\\pi }{6},\\frac{\\sqrt{3}}{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{\\pi }{6}$ lies within this range. $\\,✓$\n\nTherefore, the point $(\\frac{\\sqrt{3}}{3},\\frac{\\pi }{6})$ lies on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Next, we consider the point $(\\sqrt{3},\\frac{7\\pi }{3}).$ We note the following:\n\n- The point $(\\frac{7\\pi }{3},\\sqrt{3})$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=\\frac{7\\pi }{3}$ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(\\sqrt{3},\\frac{7\\pi }{3})$ does **not** lie on the graph of $y=\\operatorname{arctan}⁡x.$\n\n- Finally, we consider the point $(0,0).$ We note the following:\n\n- The point $(0,0)$ lies on the graph of $y=\\operatorname{tan}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arctan}⁡x$ is $y\\in (-\\frac{\\pi }{2},\\frac{\\pi }{2}),$ and $y=0$ lies within this range. $\\,✓$\n\nTherefore, the point $(0,0)$ does lie on the graph of $y=\\operatorname{arctan}⁡x.$"}] [{:db/id #edb/ref 17592186253444 :knowledge-point/_questions [{:db/id #edb/ref 17592186172017 :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a756b5-7eeb-54aa-9c61-af657974b321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186250589} {:answer/id #uuid "14168a25-afea-5fd7-a63f-be0b85ffec69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250726} {:answer/id #uuid "1db9bcf7-ac2b-5e11-9920-076c94f21a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186250806} {:answer/id #uuid "2fb5be26-6c24-584b-bbc8-95a1afca896c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186250958} {:answer/id #uuid "4d91da69-8c26-5f36-899d-a55420519710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186251197}] :answer-field/correct {:answer/id #uuid "1db9bcf7-ac2b-5e11-9920-076c94f21a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186250806} :answer-field/id #uuid "c72a13c0-2505-5129-9dad-e44544ac13fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253148}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f47e52f5-b113-5140-ac0d-d3912c7ac7a7" :question/math-academy-id "q-118025" :question/problem "![](images/50/5077a94fe8b5d5435b5bf50d0ea687f5bc87ae95011e22800ccfe473f8af78dd.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?\n\n- ${y}^{′}={x}^{2}y+{x}^{2}$\n- ${y}^{′}=xy-x$\n- ${y}^{′}=x{y}^{2}+2xy+x$" :question/worked-solution "![](images/2f/2f7075161363dee2817aeb8aff9e85781a10bd30c926bfff73724992eee699ac.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=-1,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=0$ and $y=-1$ divide the plane into $4$ quarters. The sign of the slopes in each of the $4$ quarters are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>-1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<-1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}={x}^{2}y+{x}^{2}={x}^{2}(y+1)\n$$\n\nevaluates to zero at $x=0$ and $y=-1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>-1$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $-$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation II does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=xy-x=x(y-1)\n$$\n\nevaluates to zero at $x=0$ and $y=1.$\n\n- Equation III gives the required behavior. The right-hand side of\n\n$$\n{y}^{′}=x{y}^{2}+2xy+x=x(y+1)^{2}\n$$\n\nevaluates to zero at $x=0$ and $y=-1,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>-1$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<-1$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186253528 :knowledge-point/_questions [{:db/id #edb/ref 17592186096691 :knowledge-point/id #uuid "c015dcaa-2155-5d80-985b-21924de92b28" :knowledge-point/title "Identifying Vector Equalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7725a5ac-f12f-5a08-9999-bfd41e6696a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251536} {:answer/id #uuid "818adf55-7f8c-555c-9930-b023b5be963f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251644} {:answer/id #uuid "86d89318-8468-53cc-95ab-a4b946c29961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251688} {:answer/id #uuid "8dbca207-78b1-58b0-9bec-e769cd2a732a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251753} {:answer/id #uuid "f97c7e07-12fe-54ca-a7e8-7b7eba160e36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252738}] :answer-field/correct {:answer/id #uuid "818adf55-7f8c-555c-9930-b023b5be963f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251644} :answer-field/id #uuid "1d67c074-de3d-5624-a3d0-a52f941600ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252859}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41da8ad0-e0fc-5f39-8eb7-c4706c551e5a" :question/math-academy-id "q-118976" :question/problem "![](images/dc/dcd36221e7ad293f0aac1ab99ece80641cb077efd05adc168a552e97d86100c8.png)\n\nIn parallelogram $ABCD$ shown above, which of the following equalities are true?\n\nI. $\\overset{\\to }{AD}=\\overset{\\to }{CB}$\n\nII. $\\overset{\\to }{DC}+\\overset{\\to }{CB}=\\overset{\\to }{DB}$\n\nIII. $\\overset{\\to }{AD}+\\overset{\\to }{DF}=\\overset{\\to }{FA}$" :question/worked-solution "- Equality I is false. Indeed, $\\overset{\\to }{AD}\\ne \\overset{\\to }{CB}$ since they have the opposite directions.\n\n- Equality II is true. Indeed, $\\overset{\\to }{DC}+\\overset{\\to }{CB}=\\overset{\\to }{DB}.$\n\n- Equality III is false. Indeed, $\\overset{\\to }{AD}+\\overset{\\to }{DF}=\\overset{\\to }{AF}\\ne \\overset{\\to }{FA}$ since they have the opposite directions.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186253586 :knowledge-point/_questions [{:db/id #edb/ref 17592186092223 :knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bba64f-3cd1-565f-a2f2-f4bfd510d867" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186250769} {:answer/id #uuid "9c099f76-cf14-5c6e-9750-5d6ec1b78680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186251899} {:answer/id #uuid "a5964e37-fa3b-5547-baee-6cc19bdde2f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251980} {:answer/id #uuid "c73cd5c1-5f44-5164-ac3a-eec61f246114" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252313} {:answer/id #uuid "dd3fd09a-873d-5ff1-bbf7-83ced153dd45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252502}] :answer-field/correct {:answer/id #uuid "9c099f76-cf14-5c6e-9750-5d6ec1b78680" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186251899} :answer-field/id #uuid "0fdba877-1f9a-57cc-adb3-88bcbb9cddde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252838}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3510664b-2f53-5d5d-9a15-f28784a8e0c6" :question/math-academy-id "q-11961" :question/problem "A triangle $S$ has vertices at $(-2,-3),(0,5),(2,-5).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians about the origin?\n\n- $(3,-2)$\n- $(-5,0)$\n- $(5,2)$" :question/worked-solution "The counterclockwise rotation ${R}_{\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{\\pi /2},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 0 & 2 \\\\ -3 & 5 & -5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{\\pi /2}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 0 & 2 \\\\ -3 & 5 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -5 & 5 \\\\ -2 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(3,-2),(-5,0),(5,2).$\n\nSo, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186253588 :knowledge-point/_questions [{:db/id #edb/ref 17592186092346 :knowledge-point/id #uuid "b2371a64-5e91-5caa-91c0-f6c7ff572c70" :knowledge-point/title "Rotating an Object About the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63155846-ae7f-5696-85f3-e15d7328d40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251362} {:answer/id #uuid "aaf8005f-2102-574e-87d2-8a33d641cc21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252034} {:answer/id #uuid "dae2e09e-c0c9-5398-985d-4cd86a1ccad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252479} {:answer/id #uuid "dcd3c6d3-ad51-5560-a08a-f45c8a4f4a49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186252496} {:answer/id #uuid "e78bc9ea-c9f4-5ab6-b802-e3edc9e2de0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252576}] :answer-field/correct {:answer/id #uuid "dae2e09e-c0c9-5398-985d-4cd86a1ccad0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252479} :answer-field/id #uuid "caeb48c1-a74a-526a-861b-11f22bee8e37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253153}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34508741-6c7f-54ff-a124-34cef40dd55c" :question/math-academy-id "q-11967" :question/problem "A triangle $S$ has vertices at $(-1,-1),(-1,2),(2,-3).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under a **clockwise** rotation of $\\frac{3\\pi }{4}$ radians about the origin?\n\n- $(0,\\sqrt{2})$\n- $(3,-1)$\n- $(-5,1)$" :question/worked-solution "The rotation matrix ${R}_{\\theta }$ represents a rotation of angle $\\theta $ counterclockwise about the origin and is given by\n\n$$\nR=[\\begin{aligned}\\operatorname{cos}⁡\\theta  & -\\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & \\operatorname{cos}⁡\\theta \\end{aligned}].\n$$\n\nSubstituting $\\theta =-\\frac{3\\pi }{4}$ into the above, we have\n\n$$\n\\begin{aligned}R & =[\\begin{aligned}\\operatorname{cos}⁡(-\\frac{3\\pi }{4}) & -\\operatorname{sin}⁡(-\\frac{3\\pi }{4}) \\\\ \\operatorname{sin}⁡(-\\frac{3\\pi }{4}) & \\operatorname{cos}⁡(-\\frac{3\\pi }{4})\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}} \\\\ -\\frac{1}{\\sqrt{2}} & -\\frac{1}{\\sqrt{2}}\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ -1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTo find the image of $S$ under the transformation, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-1 & -1 & 2 \\\\ -1 & 2 & -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under the rotation $R$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}-1 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}-1 & -1 & 2 \\\\ -1 & 2 & -3\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{2}}\\text{ }[\\begin{aligned}0 & 3 & -5 \\\\ 2 & -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & \\frac{3}{\\sqrt{2}} & -\\frac{5}{\\sqrt{2}} \\\\ \\sqrt{2} & -\\frac{1}{\\sqrt{2}} & \\frac{1}{\\sqrt{2}}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are \n\n$$\n(0,\\sqrt{2}),\\,(\\frac{3}{\\sqrt{2}},-\\frac{1}{\\sqrt{2}}),\\,(-\\frac{5}{\\sqrt{2}},\\frac{1}{\\sqrt{2}}).\n$$\n\nSo, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186253592 :knowledge-point/_questions [{:db/id #edb/ref 17592186092226 :knowledge-point/id #uuid "b0cbb889-0fe1-5347-94a3-53db3ff9a95c" :knowledge-point/title "Calculating the Vertices of a Polygon Given Its Image Under a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c382190-249a-5414-abac-3707b316584c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251184} {:answer/id #uuid "88704f85-1473-59d0-9894-116c0f972d8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251704} {:answer/id #uuid "9e22b0b4-63ac-5c95-b7d6-9a9b9d9dc167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251917} {:answer/id #uuid "ca695f5c-eb7d-52c2-915f-e7250a5040e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186252345} {:answer/id #uuid "dd97f4ec-ebea-539f-8d65-a1cde89258bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252505}] :answer-field/correct {:answer/id #uuid "88704f85-1473-59d0-9894-116c0f972d8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251704} :answer-field/id #uuid "a626d211-f128-53e1-a6b7-62f1ee86f97e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253095}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d13de60-db83-5fa3-ae76-e5805b3d5848" :question/math-academy-id "q-11974" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 1 \\\\ -2 & 1\\end{aligned}].\n$$\n\nThe quadrilateral $Q$ is mapped to the quadrilateral ${Q}^{′}$ under the action of $T.$ The quadrilateral ${Q}^{′}$ has vertices $(-2,-2),(-3,2),(2,2),$ and $(-1,-1).$ Which of the following are vertices of $Q?$\n\n- $(2,2)$\n- $(0,1)$\n- $(-5,-8)$" :question/worked-solution "First, we create a matrix $Y$ containing all of the vertices of ${Q}^{′}:$ \n\n$$\nY=[\\begin{aligned}-2 & -3 & 2 & -1 \\\\ -2 & 2 & 2 & -1\\end{aligned}].\n$$\n\nNow, if $X$ denotes the matrix that contains the corresponding vertices of $Q$, we have\n\n$$\n\\begin{aligned}T\\cdot X & =Y \\\\ T\\cdot X & =[\\begin{aligned}-2 & -3 & 2 & -1 \\\\ -2 & 2 & 2 & -1\\end{aligned}].\\end{aligned}\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot X & ={T}^{-1}\\cdot [\\begin{aligned}-2 & -3 & 2 & -1 \\\\ -2 & 2 & 2 & -1\\end{aligned}] \\\\ X & ={T}^{-1}\\cdot [\\begin{aligned}-2 & -3 & 2 & -1 \\\\ -2 & 2 & 2 & -1\\end{aligned}].\\end{aligned}\n$$\n\nThe inverse of $T$ is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{-1-(-2)}[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}X & ={T}^{-1}\\cdot [\\begin{aligned}-2 & -3 & 2 & -1 \\\\ -2 & 2 & 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}-2 & -3 & 2 & -1 \\\\ -2 & 2 & 2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -5 & 0 & 0 \\\\ -2 & -8 & 2 & -1\\end{aligned}].\\end{aligned}\n$$\n\nAs a result, the coordinates of $Q$ are $(0,-2),(-5,-8),(0,2),(0,-1).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186253631 :knowledge-point/_questions [{:db/id #edb/ref 17592186166820 :knowledge-point/id #uuid "ede6800b-ecfd-5ef8-a386-4aec94ddd89c" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Stationary Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3487df8b-ea56-57a2-bb69-47f34a47b666" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186250990} {:answer/id #uuid "548be625-ed5d-52ac-913d-2cc11df9cf5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186251246} {:answer/id #uuid "83b86315-d3d4-5084-8dc4-4fe7a2c9fcdd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251661} {:answer/id #uuid "c308b6c6-2fd0-5a59-bace-7923c08a4034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252279} {:answer/id #uuid "d0c4be51-5615-54b5-a48b-f325063e7f11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252399}] :answer-field/correct {:answer/id #uuid "c308b6c6-2fd0-5a59-bace-7923c08a4034" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252279} :answer-field/id #uuid "415b0ef3-d0d2-5c08-b612-f6f98ebd25c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252917}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf3614e8-6b2e-5b66-a1c3-8c10682d44be" :question/math-academy-id "q-120025" :question/problem "![](images/17/17cd72acbe8dd412d37c51ff992278d9664f6c5b1141a8604278fda76e57700f.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=x-2$\n- ${y}^{′}={x}^{2}(x-2)$\n- ${y}^{′}=x(x+1)(x-2)$" :question/worked-solution "![](images/5d/5d6165488c8e41c16cf31b1b000a924344399c2b94a8fe5e7138c55adf97602b.png)\n\nNotice that the slopes of the slope field are horizontal along the lines $x=0$ and $x=2,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=x-2$ does *not* give the required behavior. The right-hand side does not evaluate to zero at both $x=0$ and $x=2.$\n\n- The equation ${y}^{′}={x}^{2}(x-2)$ gives the required behavior. The right-hand side evaluates to zero at $x=0$ and $x=2.$\n\n- The equation ${y}^{′}=x(x+1)(x-2)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=0$ and $x=2,$ but it also evaluates to zero when $x=-1,$ which is not a behavior exhibited by our slope field.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186253635 :knowledge-point/_questions [{:db/id #edb/ref 17592186166821 :knowledge-point/id #uuid "5277f56d-3f2d-505c-bf73-48207a2310a3" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e4013d-5955-514c-93f7-2724db1cb9ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250619} {:answer/id #uuid "4fdb288b-26f4-5a69-86a5-947c270df2c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251207} {:answer/id #uuid "8b64c39e-05b5-5877-b1be-17115ae0363e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186251730} {:answer/id #uuid "b9ff8295-c8c1-5c09-ab70-fca140112128" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252190} {:answer/id #uuid "e8e28cf6-25e5-5c98-8acc-71fb493bd7a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252589}] :answer-field/correct {:answer/id #uuid "07e4013d-5955-514c-93f7-2724db1cb9ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250619} :answer-field/id #uuid "02f81072-4459-5644-a1de-527468c8e6a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a07799d5-cf00-5be4-9950-028a4e658d3e" :question/math-academy-id "q-120038" :question/problem "![](images/f8/f855062048a7d38b2fa6c843701a182661b2235b2042ad83fbedd600b1dd770c.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=\\frac{1}{10}(x+3)(x-2)^{2}$\n- ${y}^{′}=\\frac{1}{5}(x+3)(2-x)$\n- ${y}^{′}=(x+2)(x-3)$" :question/worked-solution "![](images/8f/8fdec9bda9e2bcc514e56a14a6608b2f0cb74fd0943a51c944b29cc047e02cd9.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=-3$ and $x=2.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=-3$ and $x=2$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $x<-3$ | $-3<x<2$ | $x>2$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↗$ |\n| Sign | $-$ | $+$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}=\\frac{1}{10}(x+3)(x-2)^{2}$ gives the required behavior.\n\n- The equation ${y}^{′}=\\frac{1}{5}(x+3)(2-x)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=-3$ and $x=2,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $x<-3$ | $-3<x<2$ | $x>2$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↘$ |\n| Sign | $-$ | $+$ | $-$ |\n\n- The equation ${y}^{′}=(x+2)(x-3)$ does *not* give the required behavior. The right-hand side evaluates to zero at $x=-2$ and $x=3.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186253637 :knowledge-point/_questions [{:db/id #edb/ref 17592186166860 :knowledge-point/id #uuid "762c5225-00bd-5d2f-9859-394f886482cb" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "451c1349-09c0-5213-af67-e74e68b78767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251126} {:answer/id #uuid "86d0a011-8e27-5dfe-97f7-2686e8073286" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251686} {:answer/id #uuid "a385033f-7622-5e0f-a442-c9faebd7e474" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251964} {:answer/id #uuid "c2dfecb9-1571-5ed2-ab72-fd3120a586f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186252274} {:answer/id #uuid "d4ecf42e-2044-50a7-8601-2a8169930cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252435}] :answer-field/correct {:answer/id #uuid "451c1349-09c0-5213-af67-e74e68b78767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251126} :answer-field/id #uuid "e4a18446-e360-5427-b22e-f275eb8af10f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253201}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b69e6ff7-5b7e-5a36-bad5-97913bd7c4d8" :question/math-academy-id "q-120070" :question/problem "![](images/51/51273365c4a282dc3dedd9d7cd5ac7d805e1526aaeee1915e8bd95d8223c26d3.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}={x}^{2}+3x$\n- ${y}^{′}={x}^{2}+x$\n- ${y}^{′}={x}^{3}+3{x}^{2}$" :question/worked-solution "![](images/a1/a14651ffc883a8c24ad17bdd031658c3d4ae21db2cfded213f2ba911fdb9a765.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slope field is zero along the lines $x=-3$ and $x=0.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=-3$ and $x=0$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $x<-3$ | $-3<x<0$ | $x>0$ |\n| --- | --- | --- | --- |\n| Slope | $↗$ | $↘$ | $↗$ |\n| Sign | $+$ | $-$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation\n\n$$\n{y}^{′}={x}^{2}+3x=x(x+3)\n$$\n\ngives the required behavior.\n\n- The equation \n\n$$\n{y}^{′}={x}^{2}+x=x(x+1)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-1$ and $x=0.$\n\n- The equation \n\n$$\n{y}^{′}={x}^{3}+3{x}^{2}={x}^{2}(x+3)\n$$\n\ndoes *not* give the required behavior. The right-hand side evaluates to zero at $x=-3$ and $x=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $x<-3$ | $-3<x<0$ | $x>0$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↗$ |\n| Sign | $-$ | $+$ | $+$ |\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186253640 :knowledge-point/_questions [{:db/id #edb/ref 17592186166822 :knowledge-point/id #uuid "32b9a92b-880b-50de-b8e9-648fa219b83f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fd9eab2-3394-5770-9e47-16d0acd7e360" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186250959} {:answer/id #uuid "7683c48d-a8f9-57af-a811-a21e83de291b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251530} {:answer/id #uuid "8aaae3b5-a709-5beb-be83-def9ee6ef118" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251724} {:answer/id #uuid "91c27fcc-48ed-5837-a849-620a0b90fb3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251799} {:answer/id #uuid "e86f8522-6e4c-5fc4-aca1-8a57257cbdf5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252585}] :answer-field/correct {:answer/id #uuid "8aaae3b5-a709-5beb-be83-def9ee6ef118" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251724} :answer-field/id #uuid "ac87b411-8034-5fbb-9617-d1169b6caa12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253105}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c84723b8-0d5e-5a26-bf52-a830d4f235da" :question/math-academy-id "q-120076" :question/problem "![](images/5f/5fdb2ddd3d07537c1e3d0d22d435928f7cd11dc7a71c67f1bf45292c82a61ef7.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}={x}^{2}(x+1)$\n- ${y}^{′}=\\frac{1}{x+1}$\n- ${y}^{′}=\\frac{{x}^{2}}{x+1}$" :question/worked-solution "![](images/cf/cf2ba44d8cc21ade2204a3784af7d09b492843339a8b98c4cde741b30dfa54db.png)\n\nNotice the following properties of the given slope field:\n\n- The solution curves have the vertical asymptote $x=-1.$\n\n- The slopes of the slope field become vertical as $x\\to \\pm \\infty .$\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}={x}^{2}(x+1)$ does *not* give the required behavior. The right-hand side does not approach $\\pm \\infty $ as $x\\to -1.$\n\n- The equation ${y}^{′}=\\frac{1}{x+1}$ does *not* give the required behavior. Notice that\n\n$$\n\\frac{1}{x+1}\\to 0\\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation do not approach $\\infty $ as $x\\to \\pm \\infty .$\n\n- The equation ${y}^{′}=\\frac{{x}^{2}}{x+1}$ gives the required behavior. Notice that\n\n$$\n\\frac{{x}^{2}}{x+1}=\\frac{x}{(1+\\frac{1}{x})}\\to \\pm \\infty \\,\\text{as}\\,x\\to \\pm \\infty .\n$$\n\nTherefore, the slopes of the slope field for this differential equation become vertical as $x\\to \\pm \\infty .$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186253646 :knowledge-point/_questions [{:db/id #edb/ref 17592186166857 :knowledge-point/id #uuid "954f8004-35b4-58ec-be26-2beccfd5f8e4" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Equilibrium Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5f03fb-d985-53f2-87f7-defaffc38c1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250658} {:answer/id #uuid "4f8a7834-df0d-59b4-bc03-dd88c12d7d09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251205} {:answer/id #uuid "91551a3b-c0fd-5b68-a361-62e2fb7f95c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251793} {:answer/id #uuid "9b42708d-80b7-5deb-92ad-f778b4698b9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251889} {:answer/id #uuid "a8440b23-9caa-50e1-893e-0d2a37820613" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252009}] :answer-field/correct {:answer/id #uuid "91551a3b-c0fd-5b68-a361-62e2fb7f95c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251793} :answer-field/id #uuid "2429b4e0-c7a7-585a-973f-fabf8d4bc4a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0faaaf1-6fed-5e12-af7b-9fca9c443b1e" :question/math-academy-id "q-120109" :question/problem "![](images/3d/3d24906da8cd181d40dbaec0095b8d51481babc152609fc378b03c61187220c3.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=(y+1)(y-1)(y-2)$\n- ${y}^{′}=(y+1)(y-1)$\n- ${y}^{′}=(y+1)^{2}(2-y)$" :question/worked-solution "![](images/7f/7f8a042b9944b2cdf0e864b7dca760f094f4413f197befa05d6e5cbefb3841ba.png)\n\nNotice that the slopes of the slope field are horizontal along the lines $y=-1$ and $y=2,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\nWith that in mind, let's check each equation:\n\n- The equation ${y}^{′}=(y+1)(y-1)(y-2)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=-1$ and $y=2,$ but it also evaluates to zero when $y=1,$ which is not behavior exhibited by our slope field.\n\n- The equation ${y}^{′}=(y+1)(y-1)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=\\pm 1.$\n\n- The equation ${y}^{′}=(y+1)^{2}(2-y)$ gives the required behavior. The right-hand side evaluates to zero at $y=-1$ and $y=2.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186253648 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57ceef6b-df9c-58f2-8452-71536a402fe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251268} {:answer/id #uuid "8dd9eceb-e8e3-5c33-8027-d98c6e31b42f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186251755} {:answer/id #uuid "a44bf3a6-d6bf-5e2e-8098-60e2a9889156" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251972} {:answer/id #uuid "d1910e55-a22e-5aa1-9492-a617317b56cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186252403} {:answer/id #uuid "e936376d-cf41-587c-b914-08a97e80da0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186252593}] :answer-field/correct {:answer/id #uuid "57ceef6b-df9c-58f2-8452-71536a402fe9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251268} :answer-field/id #uuid "f842e636-63b6-5764-b2fa-fd9486647db7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253244}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a3a19c98-b506-54b2-aa6b-86aada819468" :question/math-academy-id "q-12012" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}{x}^{2} \\\\ 7y\\end{aligned}].$\nWhich of the following statements are true?\n\n- $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\n- $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\n- $T$ is **NOT** a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}(kx)^{2} \\\\ 7(ky)\\end{aligned}] \\\\  & =[\\begin{aligned}{k}^{2}({x}^{2}) \\\\ k(7y)\\end{aligned}] \\\\  & =k[\\begin{aligned}k({x}^{2}) \\\\ 7y\\end{aligned}] \\\\  & \\ne kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is not a linear transformation.\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}({x}_{1}+{x}_{2})^{2} \\\\ 7({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}^{2}+{x}_{2}^{2}+2{x}_{1}{x}_{2} \\\\ 7{y}_{1}+7{y}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}^{2} \\\\ 7{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}^{2} \\\\ 7{y}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{1}{x}_{2} \\\\ 0\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}]+[\\begin{aligned}2{x}_{1}{x}_{2} \\\\ 0\\end{aligned}] \\\\  & \\ne T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nAs a result, only statement III is true."}] [{:db/id #edb/ref 17592186253649 :knowledge-point/_questions [{:db/id #edb/ref 17592186166858 :knowledge-point/id #uuid "0ca086fd-9732-5c4b-9cb0-168433d79203" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea5cc8d-27c7-52a6-88b8-3dddc81fe228" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186250680} {:answer/id #uuid "2c592db9-4d08-517f-8600-ab2f1d22699c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186250931} {:answer/id #uuid "cc4a519e-ae27-56b0-9acf-8fe689d0d814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252357} {:answer/id #uuid "e59f444e-e0e9-5ff2-a562-d69d09f38e1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252563} {:answer/id #uuid "f3de5c80-c092-58fb-98be-f19c50109268" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186252692}] :answer-field/correct {:answer/id #uuid "cc4a519e-ae27-56b0-9acf-8fe689d0d814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252357} :answer-field/id #uuid "b8efc8b8-cebf-5064-bc0c-a311662ab1ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253126}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "efa92615-fa1f-50ea-a45f-eb618f2a603d" :question/math-academy-id "q-120147" :question/problem "![](images/d2/d27af23ca398eba62c2ab1fe2ee2cf9bfdf736c16fdd8408d2a13e0d34dae32c.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}={y}^{2}(2-y)$\n- ${y}^{′}=y(y-2)^{2}$\n- ${y}^{′}=y(y+2)$" :question/worked-solution "![](images/ab/ab076b61b443e031455f07c1e976467cc3b74651bfb5fc2fb39f89a74e156681.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $y=0$ and $y=2.$ Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $y=0$ and $y=2$ divide the plane into $3$ regions. The sign of the slopes in each of the $3$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| Region | $y<0$ | $0<y<2$ | $y>2$ |\n| --- | --- | --- | --- |\n| Slope | $↘$ | $↗$ | $↗$ |\n| Sign | $-$ | $+$ | $+$ |\n\nWith that in mind, let's consider each equation.\n\n- The equation ${y}^{′}={y}^{2}(2-y)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=0$ and $y=2,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| Region | $y<0$ | $0<y<2$ | $y>2$ |\n| --- | --- | --- | --- |\n| Slope | $↗$ | $↗$ | $↘$ |\n| Sign | $+$ | $+$ | $-$ |\n\n- The equation ${y}^{′}=y(y-2)^{2}$ gives the required behavior.\n\n- The equation ${y}^{′}=y(y+2)$ does *not* give the required behavior. The right-hand side evaluates to zero at $y=-2$ and $y=0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186253664 :knowledge-point/_questions [{:db/id #edb/ref 17592186172082 :knowledge-point/id #uuid "cd82d96b-34d5-5d20-b810-7ea88b0b5797" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Stationary Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "174ea27c-5b87-518e-9ac7-a1894fe2b974" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186250759} {:answer/id #uuid "3b9797e2-4aed-54e4-9d20-9a97e323ac21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251050} {:answer/id #uuid "403a2fc1-251e-5646-8e79-4f9077afa211" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186251085} {:answer/id #uuid "6b1f150d-b758-5d47-99f5-d7bbfb058e56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251430} {:answer/id #uuid "b3286b52-f095-5030-ac44-ea8d613aaa6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186252119}] :answer-field/correct {:answer/id #uuid "3b9797e2-4aed-54e4-9d20-9a97e323ac21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186251050} :answer-field/id #uuid "f1dab444-fe98-5459-8d0e-a519d422510d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253228}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f78fc747-0bca-532e-9197-bd4cfa23233a" :question/math-academy-id "q-120228" :question/problem "![](images/20/204be6af825ef678e06526bff1fdac14ca5f09a2a7bee939620f3f2be1496985.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=x(3-y)$\n- ${y}^{′}=(x+3)y$\n- ${y}^{′}=(3-x)y$" :question/worked-solution "![](images/90/9051213882bcb506ddae46e0a6a79c8cd03a10eadd89e0007f895f68b00c33de.png)\n\nNotice that the slopes of the slope field are horizontal along the lines $x=3$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on these lines. \n\nWith that in mind, let's check each equation:\n\n- Equation I does *not* give the required behavior. The right-hand side of ${y}^{′}=x(3-y)$ evaluates to zero at $x=0$ and $y=3.$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=(x+3)y$ evaluates to zero at $x=-3$ and $y=0.$\n\n- Equation III gives the required behavior. The right-hand side of ${y}^{′}=(3-x)y$ evaluates to zero at $x=3$ and $y=0.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186253665 :knowledge-point/_questions [{:db/id #edb/ref 17592186172018 :knowledge-point/id #uuid "244419de-9b13-5923-b0a5-1bdc6f9b03b2" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017d857d-34a2-5469-89a4-ecde427bf8ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186250566} {:answer/id #uuid "1ef3384d-0294-5331-b50f-452b5938d1bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250815} {:answer/id #uuid "a5ec0437-ff36-5136-b2ff-1cf361d9fb37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186251985} {:answer/id #uuid "d0bac0b8-8897-55ea-9447-e44ade32f90b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186252398} {:answer/id #uuid "df65e3b5-7225-5331-86e8-b85ee820a4f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252523}] :answer-field/correct {:answer/id #uuid "1ef3384d-0294-5331-b50f-452b5938d1bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250815} :answer-field/id #uuid "e512d34c-3d88-5c81-84a8-1fa055a5caf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253202}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9d55cc1b-b5c1-5142-aa9a-80b5b9474cd7" :question/math-academy-id "q-120232" :question/problem "![](images/be/be758c93cb1e04380de9b57103c302623400342946996030b22ae12046488172.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=x(3-y)$\n- ${y}^{′}={x}^{2}(y-3)$\n- ${y}^{′}=x(y-3)^{2}$" :question/worked-solution "![](images/3a/3afe29e9dd507cd9aae4035ef3bde2f3f2c1865cd258c4d218ec1934d8626a6e.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=0$ and $y=3,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=0$ and $y=3$ divide the plane into $4$ regions. The sign of the slopes in each of the $4$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>3$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n| --- | --- | --- |\n| $y<3$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<0$ | $x>0$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation I gives the required behavior. The right-hand side of ${y}^{′}=x(3-y)$ evaluates to zero at $x=0$ and $y=3,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>3$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<3$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}={x}^{2}(y-3)$ evaluates to zero at $x=0$ and $y=3,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>3$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<3$ | $-$ | $-$ |\n|  | $x<0$ | $x>0$ |\n\n- Equation III does *not* give the required behavior. The right-hand side of ${y}^{′}=x(y-3)^{2}$ evaluates to zero at $x=0$ and $y=3,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>3$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<3$ | $-$ | $+$ |\n|  | $x<0$ | $x>0$ |\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186253667 :knowledge-point/_questions [{:db/id #edb/ref 17592186172018 :knowledge-point/id #uuid "244419de-9b13-5923-b0a5-1bdc6f9b03b2" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010c8f6f-c1f1-5099-a0d4-6203e867bdb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186250560} {:answer/id #uuid "0a915eaa-b080-533b-911e-3a17a85d4759" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186250648} {:answer/id #uuid "46404340-621a-58da-a576-a54e936dbc7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186251135} {:answer/id #uuid "65e533cd-9130-5ad2-90df-c10dc4b7553c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186251390} {:answer/id #uuid "f7bb917e-86c6-5d9c-ab3b-3849685cddc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252721}] :answer-field/correct {:answer/id #uuid "f7bb917e-86c6-5d9c-ab3b-3849685cddc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186252721} :answer-field/id #uuid "1462c674-017c-5ba4-90a5-9b9d9895891a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252845}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5c81757-4f06-5306-9513-674ada3bee66" :question/math-academy-id "q-120235" :question/problem "![](images/19/19f3d391ff30338ae70f59f1cf1ad40922eb8146c2be0993253a99173db2925a.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=x(y-2)^{2}$\n- ${y}^{′}=(x-2)^{2}y$\n- ${y}^{′}=(x-2)y$" :question/worked-solution "![](images/e3/e337a67c316dbee9e9c73849f363a7b2c3e3cb485bfef8eb49e87c3e33b98cf1.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=2$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=2$ and $y=0$ divide the plane into $4$ regions. The sign of the slopes in each of the $4$ regions are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>0$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<0$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n|  | $x<2$ | $x>2$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of ${y}^{′}=x(y-2)^{2}$ evaluates to zero at $x=0$ and $y=2.$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=(x-2)^{2}y$ evaluates to zero at $x=2$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>0$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $-$ |\n|  | $x<2$ | $x>2$ |\n\n- Equation III gives the required behavior. The right-hand side of ${y}^{′}=(x-2)y$ evaluates to zero at $x=2$ and $y=0,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>0$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<2$ | $x>2$ |\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186256373 :knowledge-point/_questions [{:db/id #edb/ref 17592186172017 :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d7564b-1f27-53ad-af7c-147bf870355f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254025} {:answer/id #uuid "3942c020-5a4c-53cc-999f-383b448a1092" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186254170} {:answer/id #uuid "67d2d01f-66b7-569a-99e4-302f68fc05f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186254609} {:answer/id #uuid "75323aca-3757-5f7d-97f2-b02994fb57b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254708} {:answer/id #uuid "fac82e8a-720b-5ef5-abf0-4453d3b9a26f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186255870}] :answer-field/correct {:answer/id #uuid "3942c020-5a4c-53cc-999f-383b448a1092" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186254170} :answer-field/id #uuid "97c5de46-f4a8-5887-917e-120ef34827a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256200}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b482f1cd-a6f6-5695-b088-921969df414d" :question/math-academy-id "q-120264" :question/problem "![](images/f4/f4a6aa53604ce4381a6627097ba4ebc5853a67ff9fa1675b98e5114775cefdc6.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=4-y$\n- ${y}^{′}=8y-2xy$\n- ${y}^{′}={x}^{2}y-8xy+16y$" :question/worked-solution "![](images/7d/7d0d7ff6fa9c7cd074fcc2321f125ac5da8142e55578459f44903555e2797204.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=4$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=4$ and $y=0$ divide the plane into $4$ quarters. The sign of the slopes in each of the $4$ quarters are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>0$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n| --- | --- | --- |\n| $y<0$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<4$ | $x>4$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=4-y\n$$\n\nevaluates to zero at $y=4$ only.\n\n- Equation II gives the required behavior. The right-hand side of\n\n$$\n{y}^{′}=8y-2xy=2y(4-x)\n$$\n\nevaluates to zero at $x=4$ and $y=0,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $+$ |\n|  | $x<4$ | $x>4$ |\n\n- Equation III does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}={x}^{2}y-8xy+16y=(x-4)^{2}y\n$$\n\nevaluates to zero at $x=4$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>0$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $-$ |\n|  | $x<4$ | $x>4$ |\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186256374 :knowledge-point/_questions [{:db/id #edb/ref 17592186172017 :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65cbce12-d3df-5a08-9b34-b25b996e8932" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254581} {:answer/id #uuid "7190f9d3-3282-5708-9915-0295c0de5892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186254678} {:answer/id #uuid "7c70b34c-6a00-5db7-80c1-8ab740e6b59e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186254774} {:answer/id #uuid "900bf655-7568-5f40-ae57-ff28c94f1dd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254936} {:answer/id #uuid "edbf8d5e-db47-576f-b8b1-eb9b0c9f282a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186255749}] :answer-field/correct {:answer/id #uuid "7190f9d3-3282-5708-9915-0295c0de5892" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186254678} :answer-field/id #uuid "64982020-4a50-50bd-a0ce-227ca9162f17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256110}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3c9d7302-1f93-5f85-9a08-01c47b45f471" :question/math-academy-id "q-120266" :question/problem "![](images/26/26a0a41cc50b6d5cb586c52e6a4e6bd5bd324f3e13ad7eef4ee0d9eed18340ea.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=2y-xy$\n- ${y}^{′}={x}^{2}{y}^{2}+4x{y}^{2}+4{y}^{2}$\n- ${y}^{′}=x{y}^{2}-2{y}^{2}$" :question/worked-solution "![](images/24/249aba327a8103645963ce95e7935019a279b4cf0d9306111c41172ae22f792b.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=2$ and $y=0,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=2$ and $y=0$ divide the plane into $4$ quarters. The sign of the slopes in each of the $4$ quarters are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>0$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<0$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n|  | $x<2$ | $x>2$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=2y-xy=(2-x)y\n$$\n\nevaluates to zero at $x=2$ and $y=0,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $+$ |\n|  | $x<2$ | $x>2$ |\n\n- Equation II does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}={x}^{2}{y}^{2}+4x{y}^{2}+4{y}^{2}=(x+2)^{2}{y}^{2}\n$$\n\nevaluates to zero at $x=-2$ and $y=0.$\n\n- Equation III gives the required behavior. The right-hand side of\n\n$$\n{y}^{′}=x{y}^{2}-2{y}^{2}=(x-2){y}^{2}\n$$\n\nevaluates to zero at $x=2$ and $y=0,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>0$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $+$ |\n|  | $x<2$ | $x>2$ |\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186256376 :knowledge-point/_questions [{:db/id #edb/ref 17592186172017 :knowledge-point/id #uuid "1616167b-5679-5ff6-b385-3e1b59352c64" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes and Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "200f97ca-9f78-5830-81f6-2d8f25474a63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186253949} {:answer/id #uuid "28208f81-f241-5c96-a29a-6f6f953f7453" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254028} {:answer/id #uuid "4733ee03-c0b8-55da-beb8-f63b7f2d69b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186254274} {:answer/id #uuid "c3cb7445-c797-568d-be5e-693059d41c96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186255420} {:answer/id #uuid "cc5648d7-5e6c-5560-9a5a-c09051374da2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186255485}] :answer-field/correct {:answer/id #uuid "4733ee03-c0b8-55da-beb8-f63b7f2d69b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186254274} :answer-field/id #uuid "a70d851b-9946-5bfa-a0ec-93e1f509143a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "01d08d57-0bae-5647-8907-efecd1b71deb" :question/math-academy-id "q-120271" :question/problem "![](images/85/85fcea0ad26f7da26189c7611a851bfe228d3ad5d428dcba6c8299c8304540d1.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=(x-1){y}^{2}-x+1$\n- ${y}^{′}=xy-y-(x-1)$\n- ${y}^{′}=y-1-x(y-1)$" :question/worked-solution "![](images/dc/dc75845932358d060d5878a30f00fa01e2b7b54408bca308110a53ea654ae18c.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes of the slope field are horizontal along the lines $x=1$ and $y=1,$ as shown above. Therefore, the right-hand side of the differential equation should evaluate to zero on both of these lines.\n\n- Second, the lines $x=1$ and $y=1$ divide the plane into $4$ quarters. The sign of the slopes in each of the $4$ quarters are easily deduced by considering the behavior of the solution curves in these regions. This information is summarized in the following table:\n\n| $y>1$ | $↘$\n\n$(-)$ | $↗$\n\n$(+)$ |\n| --- | --- | --- |\n| $y<1$ | $↗$\n\n$(+)$ | $↘$\n\n$(-)$ |\n|  | $x<1$ | $x>1$ |\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=(x-1){y}^{2}-x+1=(x-1)(y+1)(y-1)\n$$\n\nevaluates to zero at $x=1$ and $y=\\pm 1.$\n\n- Equation II gives the required behavior. The right-hand side of\n\n$$\n{y}^{′}=xy-y-(x-1)=(x-1)(y-1)\n$$\n\nevaluates to zero at $x=1$ and $y=1,$ and the sign of the slopes in the required regions (summarized below) correspond to the given slope field.\n\n| $y>1$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<1$ | $+$ | $-$ |\n|  | $x<1$ | $x>1$ |\n\n- Equation III does *not* give the required behavior. The right-hand side of\n\n$$\n{y}^{′}=y-1-x(y-1)=(1-x)(y-1)\n$$\n\nevaluates to zero at $x=1$ and $y=1,$ but the sign of the slopes in the required regions (summarized below) do not correspond to the given slope field.\n\n| $y>1$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<1$ | $-$ | $+$ |\n|  | $x<1$ | $x>1$ |\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186256380 :knowledge-point/_questions [{:db/id #edb/ref 17592186172016 :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11c0ac68-c2c8-5766-b0c3-6c525e9faa19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186253824} {:answer/id #uuid "6cfd904e-4eaf-51ec-a369-139e88dbb198" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254637} {:answer/id #uuid "70c8a5e6-064d-5090-a031-84d11b095e4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186254669} {:answer/id #uuid "b1723bd5-c287-5c61-afbb-9d8c85b1c262" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186255230} {:answer/id #uuid "c0f5b9cf-cb3a-53b6-a52d-c70a7885ec07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186255390}] :answer-field/correct {:answer/id #uuid "11c0ac68-c2c8-5766-b0c3-6c525e9faa19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186253824} :answer-field/id #uuid "8994beeb-2c3f-53c5-81d1-9e9b673266a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256178}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69c58940-535c-5bff-aff2-b382e99c5568" :question/math-academy-id "q-120282" :question/problem "![](images/e9/e90d9a160db2c75091253eaa8a8c815e92c45f988841683f5a4d18ca6a6ea7db.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-x{y}^{2}$\n- ${y}^{′}=-\\frac{y}{x}$\n- ${y}^{′}=\\frac{x}{y}$" :question/worked-solution "![](images/54/54932bcffbbe793d6e1f730e65570b19cfc3603ddb62eaf0a63ef2e5b0705979.png)\n\nNotice the following properties of the given slope field:\n\n- For $y\\ne 0,$ the slopes of the slope field become horizontal at $x=0$ only.\n\n- For $x\\ne 0,$ the slopes of the slope field become vertical as $y\\to 0.$\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of ${y}^{′}=-x{y}^{2}$ evaluates to zero both on $x=0$ and $y=0.$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=-\\frac{y}{x}$ does not evaluate to zero on $x=0.$\n\n- Equation III gives the required behavior. For $y\\ne 0,$ the right-hand side of ${y}^{′}=\\frac{x}{y}$ evaluates to zero on $x=0$ only, and for $x\\ne 0,$ we have \n\n$$\n|{y}^{′}|=|\\frac{x}{y}|\\to \\infty \\,\\text{as}\\,y\\to 0.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186256382 :knowledge-point/_questions [{:db/id #edb/ref 17592186172016 :knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d2e661-d903-501c-a426-b35992d3d8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186253687} {:answer/id #uuid "08fa6fea-c5dd-5848-8caa-3199fcd9a78a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186253736} {:answer/id #uuid "481deecd-2432-5359-bdf7-783c161ea51b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186254282} {:answer/id #uuid "4bf3defa-3ce4-5597-a167-445bd8caf89d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254320} {:answer/id #uuid "949356ce-15d7-5f38-be72-6cc4861555e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254974}] :answer-field/correct {:answer/id #uuid "4bf3defa-3ce4-5597-a167-445bd8caf89d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254320} :answer-field/id #uuid "6229d104-56a1-54ac-8f51-58e99ad54a13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256105}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a8520070-e078-5b91-88f5-b7a922021b9b" :question/math-academy-id "q-120286" :question/problem "![](images/e8/e8b573c6c2c59123de46346ccfc717fa89a98f7838e643a5e82972d753383588.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-\\frac{{y}^{2}}{x}$\n- ${y}^{′}=\\frac{x}{{y}^{2}}$\n- ${y}^{′}=\\frac{y+1}{x}$" :question/worked-solution "![](images/2f/2f654bc96d27ac53dd501b10c5beb0d1c7d04ff4f643c5044692afac26ca2ba8.png)\n\nNotice the following properties of the given slope field:\n\n- For $x\\ne 0,$ the slopes of the slope field become horizontal at $y=0$ only.\n\n- For $y\\ne 0,$ the slopes of the slope field become vertical as $x\\to 0.$\n\nWith that in mind, let's consider each equation.\n\n- Equation I gives the required behavior. For $x\\ne 0,$ the right-hand side of ${y}^{′}=-\\frac{{y}^{2}}{x}$ evaluates to zero on $y=0$ only, and for $y\\ne 0,$ we have \n\n$$\n|{y}^{′}|=|-\\frac{{y}^{2}}{x}|\\to \\infty \\,\\text{as}\\,x\\to 0.\n$$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=\\frac{x}{{y}^{2}}$ does not evaluate to zero on $y=0.$\n\n- Equation III does *not* give the required behavior. For $x\\ne 0,$ the right-hand side of ${y}^{′}=\\frac{y+1}{x}$ does not evaluate to zero on $y=0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186256390 :knowledge-point/_questions [{:db/id #edb/ref 17592186087750 :knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cce215f-9d6e-5e4c-91e8-5e347b640764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186253775} {:answer/id #uuid "0e6f11e3-9683-5eb0-b81c-73965585fac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186253795} {:answer/id #uuid "368d1fee-29d5-5d84-a405-9d508e7d7a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186254138} {:answer/id #uuid "73d21c02-92e6-5c38-9d35-1eec49a5843d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254695} {:answer/id #uuid "bca97423-aa51-562c-bb77-0071decfb772" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186255357}] :answer-field/correct {:answer/id #uuid "73d21c02-92e6-5c38-9d35-1eec49a5843d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254695} :answer-field/id #uuid "7df36b82-0ba3-52ec-9716-f7451f3e0e21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7fe1aa4a-edf0-5fec-a75f-5eaee41d4322" :question/math-academy-id "q-12033" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(-2,1),(3,3),$ and $(5,-2).$ Which of the following are coordinates of a vertex of ${S}^{′}$, the image of $S$ under the action of $T?$\n\n- $(5,-2)$\n- $(-2,-5)$\n- $(3,12)$" :question/worked-solution "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}-2 & 3 & 5 \\\\ 1 & 3 & -2\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 0 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}-2 & 3 & 5 \\\\ 1 & 3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 & 5 \\\\ -5 & 12 & 13\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-2,-5),(3,12),(5,13).$ \n\nSo, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186256410 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b6d648d-a2c8-5f86-8dfa-c57253347069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254057} {:answer/id #uuid "3354ad40-fb68-5ef4-93de-bc028696a94d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254113} {:answer/id #uuid "4c001539-4275-512c-ac1a-3544ef78e9a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186254321} {:answer/id #uuid "92e9a894-3ecb-5ae9-a116-cc0899deab66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186254958} {:answer/id #uuid "e40631cc-55eb-54dd-869d-813181376572" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186255688}] :answer-field/correct {:answer/id #uuid "4c001539-4275-512c-ac1a-3544ef78e9a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186254321} :answer-field/id #uuid "eab87b48-bb23-5b2a-8da7-bfbe7b0b10ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256335}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "735542a6-3adb-5150-94ab-7fbabf60bc01" :question/math-academy-id "q-120476" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\n- $\\operatorname{sec}⁡x=\\frac{\\sqrt{2}}{5}$\n- $\\operatorname{sec}⁡x=\\frac{6}{7}$\n- $\\operatorname{sec}⁡x=\\frac{1}{3}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, equations I, II, and III have no solutions."}] [{:db/id #edb/ref 17592186256411 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4252b5-449b-5882-a105-37cd9d163e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186254780} {:answer/id #uuid "bbfeea2a-5ecc-5f32-afd3-9598ebf46ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/