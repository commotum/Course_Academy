2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186256698 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "197b292e-1ccc-5a2a-bbd3-69631cf5cdfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186253886} {:answer/id #uuid "4282ef58-c196-533e-a6c5-65a78e4167e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186254237} {:answer/id #uuid "72371778-9fa6-55d9-a8c5-e39c0c1c76f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186254682} {:answer/id #uuid "81960d80-10de-550c-8912-2cf1586a9e49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186254816} {:answer/id #uuid "eed3a33f-1dad-5c80-bfdb-c8efe6f43c69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186255760}] :answer-field/correct {:answer/id #uuid "eed3a33f-1dad-5c80-bfdb-c8efe6f43c69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186255760} :answer-field/id #uuid "74382c67-5fd5-5692-9423-b4141bf3106f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256135}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "659f4527-cc88-5c6b-8485-f595eee1689f" :question/math-academy-id "q-122694" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\n- $N(x,y)=⟨x{e}^{y},\\sqrt{x+y}⟩$\n- $P(x,y,z)=⟨{e}^{x-2y},\\sqrt{3-x},3{z}^{3}⟩$\n- $Q(x,y,z)=⟨-1,2,\\operatorname{ln}⁡(2x-y+z)⟩$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,3-x\\ge 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,2x-y+z>0}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186256699 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32dc221c-9d3c-5ba5-b8f8-5f66cc98c204" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186254109} {:answer/id #uuid "83efb2f1-1659-564d-b42b-e819c7758c66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186254843} {:answer/id #uuid "9493d975-f804-58ac-949a-37a70ebd19d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186254975} {:answer/id #uuid "9e63abe1-bc16-5e58-8947-238f06b6a38a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186255064} {:answer/id #uuid "db43c005-6e48-5fe7-a0a7-8355e9b574ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186255615}] :answer-field/correct {:answer/id #uuid "83efb2f1-1659-564d-b42b-e819c7758c66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186254843} :answer-field/id #uuid "61039999-72de-5aa0-b04f-7ff4d69d025f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256102}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89ed8a40-4bb8-5a40-9a2c-1bf03637a8bf" :question/math-academy-id "q-122696" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\n- $C(x,y,z)=\\frac{z}{x+y}$\n- $D(x,y)=⟨{y}^{3}-3,\\operatorname{cos}⁡(2x-y),7{x}^{3}⟩$\n- $E(x,y,z)=⟨\\operatorname{sin}⁡(x+z),\\operatorname{tan}⁡z,\\frac{1}{x-y}⟩$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $C(x,y,z)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{3}$ to functions in $R$ (not ${R}^{3}$).\n\n- The function $D(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $E(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne y,\\,z\\ne \\frac{\\pi }{2}+n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186259500 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "336f3f9e-6053-5a86-b639-96673bb8f672" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186257234} {:answer/id #uuid "39162a94-0d90-5b25-b209-24876a170a11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257285} {:answer/id #uuid "5a8b15ca-d52d-531a-9f40-45fe63da8575" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186257571} {:answer/id #uuid "5c64bab9-76fe-5d95-8daf-e8e1b620127c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186257585} {:answer/id #uuid "a0382c8f-1bdd-5f43-bb7f-8f4cbd016ed4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186258188}] :answer-field/correct {:answer/id #uuid "39162a94-0d90-5b25-b209-24876a170a11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257285} :answer-field/id #uuid "fe0c79f3-5071-5ae2-996b-25bb19951a62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259478}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d890a9be-d244-5a2b-a434-390b31123a28" :question/math-academy-id "q-123245" :question/problem "![](images/b3/b315be9ba524ab538388fdaad31161c280d7d6e5ab71261345063ac6ffe819d5.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $∇\\cdot F=0$\n- $∇\\cdot F>0$\n- $∇\\cdot F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the lengths of the vectors increase as we move vertically and horizontally away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186259580 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21d9852e-69fd-5f78-b596-3c06c036a10f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186257058} {:answer/id #uuid "49de7af0-f078-503e-95c7-8697a62eeaee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257427} {:answer/id #uuid "5ed252e8-5b71-548f-b94e-185b4ee28acf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186257615} {:answer/id #uuid "b6ce090d-299a-51d2-8010-91cd86e763aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186258372} {:answer/id #uuid "fe21bd30-6e40-5d24-8d08-9bd937dd0001" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186259009}] :answer-field/correct {:answer/id #uuid "49de7af0-f078-503e-95c7-8697a62eeaee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186257427} :answer-field/id #uuid "449d9eb0-dd44-5a20-acf3-6f28a9047d75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259156}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc1786af-49ed-5f49-98af-90852a6f6e8b" :question/math-academy-id "q-123984" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=x\\operatorname{sin}⁡y\\,i+y\\operatorname{cos}⁡x\\,j$\n- $G=3{e}^{3x+2y}\\,i+2{e}^{3x+2y}\\,j$\n- $H=2xy\\,i+({x}^{2}+{y}^{2})\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x\\operatorname{sin}⁡y$ and $Q=y\\operatorname{cos}⁡x.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=x\\operatorname{cos}⁡y,\\,\\frac{∂Q}{∂x}=-y\\operatorname{sin}⁡x.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=3{e}^{3x+2y}$ and $Q=2{e}^{3x+2y}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=6{e}^{3x+2y},\\,\\frac{∂Q}{∂x}=6{e}^{3x+2y}.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=2xy$ and $Q={x}^{2}+{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=2x,\\,\\frac{∂Q}{∂x}=2x.\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186259827 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14fa9dcc-375a-59d8-b789-5a5039a415eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186256972} {:answer/id #uuid "25b06e8e-bc01-5148-9159-2701dbad34e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186257102} {:answer/id #uuid "6043748e-9c37-55eb-a43a-6eb6f4779dce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ and $D$ only" :db/id #edb/ref 17592186257627} {:answer/id #uuid "93c56015-467e-5756-8941-ad6c23b1b181" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186258083} {:answer/id #uuid "e5a54ccd-dfd0-5b42-ae20-f329a38c7843" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$D$ only" :db/id #edb/ref 17592186258772}] :answer-field/correct {:answer/id #uuid "25b06e8e-bc01-5148-9159-2701dbad34e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186257102} :answer-field/id #uuid "feebf6c1-bac7-58aa-8738-31fffdb1b4a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259481}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0cf927e3-7417-58b7-b060-c44ad3d85430" :question/math-academy-id "q-125552" :question/problem "Which of the following is a $2\\times 1$ matrix?\n\n$$\nB=[\\begin{aligned}-1 & 1 \\\\ 0 & 2\\end{aligned}],\\,C=[\\begin{aligned}-1 \\\\ 0\\end{aligned}],\\,D=[\\begin{aligned}0 & \\sqrt{2}\\end{aligned}]\n$$" :question/worked-solution "- The matrix $B$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,\\times $\n\n- The matrix $C$ has $2$ rows and $1$ column. So, its dimensions are $2\\times 1.$ $\\,✓$\n\n- The matrix $D$ has $1$ row and $2$ columns. So, its dimensions are $1\\times 2.$ $\\,\\times $\n\nTherefore, only $C$ is a $2\\times 1$ matrix."}] [{:db/id #edb/ref 17592186262604 :knowledge-point/_questions [{:db/id #edb/ref 17592186119772 :knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc" :knowledge-point/title "Identifying a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c6b28e8-0add-5ad0-82cf-ac7e0be91ff4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186260527} {:answer/id #uuid "5d2c71d6-034e-5d67-8d45-e9d7d4b82207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186260675} {:answer/id #uuid "9dff86a0-c614-587b-9031-05a86e29c620" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186261243} {:answer/id #uuid "b8cdf86c-5203-5bdc-8872-f4b898982bb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$, $B$, and $C$" :db/id #edb/ref 17592186261496} {:answer/id #uuid "f3f33792-3b3e-5eb9-97d4-2a7df4ab6dfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186262007}] :answer-field/correct {:answer/id #uuid "f3f33792-3b3e-5eb9-97d4-2a7df4ab6dfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186262007} :answer-field/id #uuid "b3503072-c089-5678-a094-b467dddd61b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262447}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "addfb264-5013-5ace-a74a-d9286a8c951b" :question/math-academy-id "q-126351" :question/problem "Which of the following matrices are lower triangular matrices?\n\n$A=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}5 & 0 \\\\ -1 & 2\\end{aligned}],\\,C=[\\begin{aligned}1 & -2 \\\\ 0 & 5\\end{aligned}].$" :question/worked-solution "The matrices $A$ and $B$ are lower triangular matrices since all the entries above the main diagonal are zeros.\n\nThe matrix $C$ is *not* a lower triangular matrix since it has a non-zero element above the main diagonal: \n\n$$\n\\begin{aligned}{c}_{12} & =-2\\ne 0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262616 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16278a61-9875-59c1-81b4-263defc4ef28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186260069} {:answer/id #uuid "69c2515c-723d-5e1e-a869-bd9b085f59b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260800} {:answer/id #uuid "6fd7d5f2-90a4-5eca-9042-d301cd904bcb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260857} {:answer/id #uuid "92cd9da2-ef9d-596f-bc10-92a5c4144358" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261151} {:answer/id #uuid "ba29aa7e-88bb-5b6f-97ad-3007774ded44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186261508}] :answer-field/correct {:answer/id #uuid "69c2515c-723d-5e1e-a869-bd9b085f59b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260800} :answer-field/id #uuid "c8a69c67-6d26-59c0-ad15-1532bce18ecc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262480}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d3df39a1-3dce-5051-9bb1-2a36ee3c62ca" :question/math-academy-id "q-126477" :question/problem "Consider the matrix \n$B=[\\begin{aligned}2 & 0 & 0 & 0 \\\\ 0 & -3 & -1 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2\\end{aligned}].$\nWhich of the following statements are true?\n\n- $B$ is upper triangular\n- $B$ is lower triangular\n- $B-{B}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true, since all the entries below the main diagonal equal to zero:\n\n$$\nB=[\\begin{aligned}2 & 0 & 0 & 0 \\\\ 0 & -3 & -1 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2\\end{aligned}]\n$$\n\n- Statement II is false, since $A$ has non-zero entries above the main diagonal:\n\n$$\nB=[\\begin{aligned}2 & 0 & 0 & 0 \\\\ 0 & -3 & -1 & 1 \\\\ 0 & 0 & 4 & 5 \\\\ 0 & 0 & 0 & 2\\end{aligned}]\n$$\n\n- Statement III is false, since the result of $B-{B}^{T}$ has non-zero entries below the main diagonal:\n\n$$\nB-{B}^{T}=[\\begin{aligned}0 & 0 & 0 & 0 \\\\ 0 & 0 & -1 & 1 \\\\ 0 & 1 & 0 & 5 \\\\ 0 & -1 & -5 & 0\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186262617 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1d2a35-75de-531a-afc6-ee0466ce76a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186260018} {:answer/id #uuid "93cc1d25-eaa9-5fa8-a0c2-363186e0bfc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186261159} {:answer/id #uuid "bda955fa-4906-51a8-bbac-2912e8022dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261550} {:answer/id #uuid "d6a897df-4aa3-5e4b-aa2a-0e82a6043069" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261764} {:answer/id #uuid "ff35400f-1bd2-549b-b182-cb1f0a9054d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186262113}] :answer-field/correct {:answer/id #uuid "bda955fa-4906-51a8-bbac-2912e8022dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186261550} :answer-field/id #uuid "5e2cb3cf-da81-556c-9fd6-277089a3b449" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262284}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f41ff7d0-b754-5033-a620-53eef8a376e3" :question/math-academy-id "q-126479" :question/problem "Consider the matrix \n$C=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{aligned}].$\nWhich of the following statements are true?\n\n- $C$ is upper triangular\n- $C$ is lower triangular\n- ${C}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. All the entries below the main diagonal of $C$ are zeros:\n\n$$\nC=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{aligned}]\n$$\n\n- Statement II is true. All the entries above the main diagonal of $C$ are zeros:\n\n$$\nC=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{aligned}]\n$$\n\n- Statement III is true. All the entries below the main diagonal of ${C}^{T}$ are zeros:\n\n$$\n{C}^{T}=[\\begin{aligned}5 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 0 & -5\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."}]}
