edge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a764f49-9edb-5020-9a41-bf5dac3e103e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186130523} {:answer/id #uuid "9d6d6769-d8ff-5808-9fdc-2c6a3c27f2ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186130524} {:answer/id #uuid "e1924edf-bb90-519c-ad15-dc5c4909ac55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186130525} {:answer/id #uuid "080a320c-3361-5001-ab96-5c073de14d26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186130526} {:answer/id #uuid "1145c273-7eaa-577b-8a14-75a420c86885" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186130527}] :answer-field/id #uuid "39063289-e948-5c53-bc32-a9e7fa1b008c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130522} {:answer-field/choices [{:answer/id #uuid "4af00ead-cb31-51e6-9f21-869070b74a3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186382717} {:answer/id #uuid "5e82f46c-d873-514d-bfa9-fcd50b8798f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382718} {:answer/id #uuid "57566773-e704-586b-bc5c-d48eca074e5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186382719} {:answer/id #uuid "b43f392a-de66-542d-85c1-a5e456a297d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382720} {:answer/id #uuid "a163be0a-2b14-51bd-a9a8-1d4a4207b41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382721}] :answer-field/correct {:answer/id #uuid "b43f392a-de66-542d-85c1-a5e456a297d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382720} :answer-field/id #uuid "2bcce67f-0a6c-5ff1-abd8-5204a040f9e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382716}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d82a128a-970f-55e8-b4ad-4c3c16a14935" :question/math-academy-id "q-105075" :question/problem "![](images/34/3411e11060b06a11c82ad677f50731faa31c6bc2e83ccb0d0d10931cf3d76592.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $∇\\cdot F>0$ at $P,$ then $F$ acts like a source at $P.$\n\n- If $∇\\cdot F<0$ at $P,$ then $F$ acts like a sink at $P.$\n\n- If $∇\\cdot F=0$ at $P,$ then $F$ acts like neither a source nor a sink at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement III is true, whereas statements I and II are false. Notice that the lengths of the vectors decrease as we move in the $y$-direction. Therefore, the vector field $F$ acts like a sink at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186134062 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64adfa84-016b-5b75-bfaa-1a8a86ec6cff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437398} {:answer/id #uuid "74db0023-87ca-59a4-a5bd-f3ec8e8116b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437399}] :answer-field/correct {:answer/id #uuid "74db0023-87ca-59a4-a5bd-f3ec8e8116b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437399} :answer-field/id #uuid "e8d82e25-5382-533b-84b7-01e9f7a1d6d9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438728} {:answer-field/choices [{:answer/id #uuid "8567ee77-d4f1-5260-9f23-476c33065db6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437400} {:answer/id #uuid "a70669e9-818c-5056-9e48-6b53420d42e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437401}] :answer-field/correct {:answer/id #uuid "8567ee77-d4f1-5260-9f23-476c33065db6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437400} :answer-field/id #uuid "a4ff09e7-c874-5a69-a376-7cc151c1b301" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438729} {:answer-field/choices [{:answer/id #uuid "bdbd1a0c-db83-58a6-82a4-5124aff61305" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437402} {:answer/id #uuid "66a86276-9dec-5106-ae18-146b9a8a0341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437403}] :answer-field/correct {:answer/id #uuid "66a86276-9dec-5106-ae18-146b9a8a0341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437403} :answer-field/id #uuid "76eb44c2-5da3-5456-a3ae-c27f914fb121" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438730} {:answer-field/choices [{:answer/id #uuid "6c36d028-9a19-523f-8a50-c043c1583d10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437404} {:answer/id #uuid "f9c4fd28-7364-51cd-9702-c77f2ad2fba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437405}] :answer-field/correct {:answer/id #uuid "6c36d028-9a19-523f-8a50-c043c1583d10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437404} :answer-field/id #uuid "455d8cf9-d20d-599d-bbf0-180199060744" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438731}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7a72f589-a1bb-57d0-9bf2-23704868e98f" :question/math-academy-id "q-105092" :question/problem "![](images/38/38a7ae83a66a2c1ff6a012b9405c6621b0c0a162018065549e75a1d08bc04d44.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is irrotational\n- **IV.** $\\text{curl}\\,F$ points in the negative $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/59/594106633e422d24b9fea113d24fb6367fdef5ac52724931860e4163e33ce992.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statements III is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statement IV is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186134063 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "984afe37-2fa9-58b4-8e69-c02e0263af15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186130535} {:answer/id #uuid "a6e142d6-154b-55cc-8a86-91ca44984e86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186130536} {:answer/id #uuid "c0149d09-0041-507b-9723-b5bde29dd903" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186130537} {:answer/id #uuid "d9c124d7-8cc0-57ff-98f6-d85fe98a935e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186130538} {:answer/id #uuid "22ab8d9e-65f2-5914-bcca-b8904b2ff74e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186130539}] :answer-field/id #uuid "8058c5ae-a794-5103-96a5-0833641fcaa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130534}] :question/id #uuid "4556fe88-939e-5892-9221-116e661c0c0b" :question/math-academy-id "q-105103" :question/problem "![](images/04/04c6eb44298b639520994f01ef505ff40eba58307a1a40e7a48dfb0ebaae5d7e.png)\n\nConsider the vector field $F(x, y, z)$, shown above. Given that $F(x, y, z)$ is independent of $z$, which of the following statements are true?\n\n1. $curlF = 0$\n2. $curlF \\ne 0$\n3. $curlF$ points in the negative $z$-direction.\n4. $F$ is irrotational"}] [{:db/id #edb/ref 17592186134067 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869bd612-bbbc-56b2-9d4d-f34bcb0e9062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186130559} {:answer/id #uuid "ef2bd30f-e9a9-5da5-b0ba-7117ab7d4fec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186130560} {:answer/id #uuid "1f5a8846-da94-5536-9acc-ee78e8bdaa34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186130561} {:answer/id #uuid "38261aa3-82a9-5fb1-abe8-0ecc0b4a52c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186130562} {:answer/id #uuid "4fddf9c2-de5d-54e2-a6b1-6f255aed1e2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186130563}] :answer-field/id #uuid "2e9d4ee0-42ea-53df-aa07-9fe9b51468fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130558} {:answer-field/choices [{:answer/id #uuid "5f861ee0-c10a-55b7-b421-ea16180f7604" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186382821} {:answer/id #uuid "1a3efe9f-6494-50ee-b7d8-97bd8f0b08a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186382822} {:answer/id #uuid "d4611053-0c8f-5196-8404-73c9022f341f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382823} {:answer/id #uuid "abcf06ba-2db2-5bee-b66a-0d860f76e3ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382824} {:answer/id #uuid "44e3ce89-0fb0-5271-8574-d381668934c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382825}] :answer-field/correct {:answer/id #uuid "5f861ee0-c10a-55b7-b421-ea16180f7604" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186382821} :answer-field/id #uuid "221ebaf4-de8e-55b9-8386-ea7500ef7627" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382820}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0a7d3d7-12b8-5fcb-bcca-49538501dfd6" :question/math-academy-id "q-105571" :question/problem "![](images/86/864ce19530f022e52b7c9513c0cebc64e898f6e71ecf1066ab6aad92d6df40bf.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186134092 :knowledge-point/_questions [{:db/id #edb/ref 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99862250-7069-52b8-961c-43b2d6c3e458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186130709} {:answer/id #uuid "f68109da-5447-5289-9116-b22d249e0b40" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186130710} {:answer/id #uuid "5b193744-a5b0-5a56-a6c4-959a94a39569" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186130711} {:answer/id #uuid "6b57aff0-91a2-5924-b717-b77009c0d3d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186130712} {:answer/id #uuid "7be44107-414a-5573-bb82-9924ad37ebda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186130713}] :answer-field/id #uuid "5d17d2d8-9928-5246-af09-a8de679c2edf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130708} {:answer-field/choices [{:answer/id #uuid "4bbde3ea-51a4-5bb9-b415-15b081645f8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186369320} {:answer/id #uuid "7503552f-1a3f-5846-a2bb-20c103b29664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186369321} {:answer/id #uuid "8bb7ee7a-6e0f-5758-a561-9b3915b9f2e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186369322} {:answer/id #uuid "17bae066-3d20-59d8-b46d-cf1882d28b09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186369323} {:answer/id #uuid "902e9dbe-6cff-5089-8658-727ffe921b4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186369324}] :answer-field/correct {:answer/id #uuid "8bb7ee7a-6e0f-5758-a561-9b3915b9f2e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186369322} :answer-field/id #uuid "633e4ab2-3db4-5baf-9514-75709128a17a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369319}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d72f3f4-6ff1-53f9-94a6-72b405d3f343" :question/math-academy-id "q-125852" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\n- $P(x,y)=y$ and $Q(x,y)=-x$\n- $P(x,y)=\\frac{x}{2}+\\operatorname{cos}⁡{y}^{2}$ and $Q(x,y)=\\frac{y}{2}$\n- $P(x,y)=0$ and $Q(x,y)=x$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=-1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-2\\ne 1.\n$$\n\n- Pair II does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-2y\\operatorname{sin}⁡{y}^{2}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2y\\operatorname{sin}⁡{y}^{2}\\ne 1.\n$$\n\n- Pair III gives the required area. Notice that\n$\\frac{∂P}{∂y}=0$\nand\n$\\frac{∂Q}{∂x}=1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186134093 :knowledge-point/_questions [{:db/id #edb/ref 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acef05c6-00e1-5592-a1a0-889b8fae112b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186130715} {:answer/id #uuid "b7bd9e64-696c-51f2-9326-b4dd35e8d309" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186130716} {:answer/id #uuid "033fba2e-49ef-5a43-86ee-97280d5189b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186130717} {:answer/id #uuid "06170a0b-5016-5c98-abd7-afe22178d627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186130718} {:answer/id #uuid "4abc258a-2852-54fd-89be-f1ca43962d66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186130719}] :answer-field/id #uuid "097d24ae-bf47-5570-8b59-107607077491" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130714} {:answer-field/choices [{:answer/id #uuid "51032152-ac1c-5645-b519-4d9f91f449cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186369326} {:answer/id #uuid "d548dfcc-afb7-5f57-ad90-cfdfdb29a3ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186369327} {:answer/id #uuid "0cc64ba0-9932-5ec8-a8c1-902a58b2e272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186369328} {:answer/id #uuid "8c7ad01a-0f7e-5e8c-8299-0aee289f43aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186369329} {:answer/id #uuid "9cfcd43c-0ace-5687-91b7-d1a23321bac2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186369330}] :answer-field/correct {:answer/id #uuid "51032152-ac1c-5645-b519-4d9f91f449cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186369326} :answer-field/id #uuid "07c5c5c2-3396-52cb-9fba-4aead4b7e49a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369325}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0916e138-1ac3-5dc1-b5d3-86d819d37c90" :question/math-academy-id "q-125853" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}F\\cdot \\text{d}r\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the vector field $F(x,y)?$\n\n- $F(x,y)=⟨-y,\\,{x}^{2}+x⟩$\n- $F(x,y)=⟨-\\frac{y}{4}+x,\\,\\frac{3x}{4}⟩$\n- $F(x,y)=⟨-y,\\,0⟩$" :question/worked-solution "According to Green's theorem, if $F(x,y)=⟨P(x,y),\\,Q(x,y)⟩,$ where\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y \\\\  & ={∮}_{C}F\\cdot \\text{d}r\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Vector field I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=2x+1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2x+2\\ne 1.\n$$\n\n- Vector field II gives the required area. Notice that\n$\\frac{∂P}{∂y}=-\\frac{1}{4}$\nand\n$\\frac{∂Q}{∂x}=\\frac{3}{4},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Vector field III gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186167051 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a34e9e6f-2888-5f5e-8d46-214f1d392b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437366} {:answer/id #uuid "cb59301c-abc9-51ad-b0e3-c4ff391b8b74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437367}] :answer-field/correct {:answer/id #uuid "a34e9e6f-2888-5f5e-8d46-214f1d392b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437366} :answer-field/id #uuid "5d0a4f31-7a33-5fef-82ec-37c61f532a12" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438712} {:answer-field/choices [{:answer/id #uuid "45ad8b6d-306b-5c2f-9bc1-af6874eaf7dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437368} {:answer/id #uuid "5afdf89b-d566-5135-9459-4a771ed47ff5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437369}] :answer-field/correct {:answer/id #uuid "45ad8b6d-306b-5c2f-9bc1-af6874eaf7dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437368} :answer-field/id #uuid "c4bc42d9-4ade-5ab1-a4a6-2546001b1cbb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438713} {:answer-field/choices [{:answer/id #uuid "970d8e6b-fc38-53e4-90d8-b02eee99b29d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437370} {:answer/id #uuid "790f5db3-f1d6-5dcd-bbeb-89e1313e0a83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437371}] :answer-field/correct {:answer/id #uuid "790f5db3-f1d6-5dcd-bbeb-89e1313e0a83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437371} :answer-field/id #uuid "fabc5da5-1944-5cda-a505-51d0b2452429" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef2b9923-252b-570f-aaa0-557007eb97e9" :question/math-academy-id "q-104570" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F=x{e}^{xy}\\,i+y{e}^{xy}\\,j$\n- **II.** $G=(xy+{y}^{2})\\,i+(xy+{x}^{2})\\,j$\n- **III.** $H=\\operatorname{cos}⁡(x-y)\\,i-\\operatorname{cos}⁡(x-y)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P=x{e}^{xy}$ and $Q=y{e}^{xy}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}={x}^{2}{e}^{xy},\\,\\frac{∂Q}{∂x}={y}^{2}{e}^{xy}.\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=xy+{y}^{2}$ and $Q=xy+{x}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=x+2y,\\,\\frac{∂Q}{∂x}=y+2x.\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\operatorname{cos}⁡(x-y)$ and $Q=-\\operatorname{cos}⁡(x-y).$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\operatorname{sin}⁡(x-y),\\,\\frac{∂Q}{∂x}=\\operatorname{sin}⁡(x-y).\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186167319 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5093965-6880-52c1-99d1-4b3fe1a5c833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438610} {:answer/id #uuid "46db8ede-df07-52d4-b08f-30a129c581d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438611}] :answer-field/correct {:answer/id #uuid "c5093965-6880-52c1-99d1-4b3fe1a5c833" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438610} :answer-field/id #uuid "f8bbb111-e968-59e9-b2db-a637a9f734cc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439334} {:answer-field/choices [{:answer/id #uuid "f8dccafb-21ba-532f-b09e-f2674009d0a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438612} {:answer/id #uuid "5d6e66f0-53f1-5ecc-87b5-35c6b5302f63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438613}] :answer-field/correct {:answer/id #uuid "5d6e66f0-53f1-5ecc-87b5-35c6b5302f63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438613} :answer-field/id #uuid "1e852986-873b-5b33-96a5-b8861bc18ec2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439335} {:answer-field/choices [{:answer/id #uuid "de7ca771-fa92-5536-aebc-7cee5f961670" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438614} {:answer/id #uuid "86c635ce-a4a6-5c29-a72f-7b9a4ef3b7af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438615}] :answer-field/correct {:answer/id #uuid "86c635ce-a4a6-5c29-a72f-7b9a4ef3b7af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438615} :answer-field/id #uuid "144d2103-4cd4-5e83-9245-447662f5adf6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439336}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "321a61eb-7345-5f73-a2c6-72200c42218f" :question/math-academy-id "q-81745" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F=({x}^{2}+2y)\\,i+({x}^{2}+2y)\\,j$\n- **II.** $G=(y{e}^{x}+2)\\,i+({e}^{x}+4y)\\,j$\n- **III.** $H=y\\,i+x\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ \n\nWith this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P={x}^{2}+2y$ and $Q={x}^{2}+2y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2,\\,\\frac{∂Q}{∂x}=2x.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $F$ is not conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=y{e}^{x}+2$ and $Q={e}^{x}+4y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{x},\\,\\frac{∂Q}{∂x}={e}^{x}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=y$ and $Q=x.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=1,\\,\\frac{∂Q}{∂x}=1.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186172278 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0472bb5e-4a90-5cd6-9de5-ebef5117beaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437594} {:answer/id #uuid "f88ae56c-e114-5adc-b201-c66477067085" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437595}] :answer-field/correct {:answer/id #uuid "f88ae56c-e114-5adc-b201-c66477067085" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437595} :answer-field/id #uuid "dbb3b38e-ed8e-5a59-9388-07674b092db3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438826} {:answer-field/choices [{:answer/id #uuid "aad1daee-f461-5f33-a5be-9837ee051c92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437596} {:answer/id #uuid "e0211d47-e1df-5da8-8b13-855c00b96273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437597}] :answer-field/correct {:answer/id #uuid "e0211d47-e1df-5da8-8b13-855c00b96273" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437597} :answer-field/id #uuid "090cb07d-b3c5-5c39-80ad-a9d21b5b0936" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438827} {:answer-field/choices [{:answer/id #uuid "f8655475-7a8d-5a44-bdb9-605e4fe17d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437598} {:answer/id #uuid "28b18abe-37d6-5c8a-b396-b1abcba8e763" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437599}] :answer-field/correct {:answer/id #uuid "f8655475-7a8d-5a44-bdb9-605e4fe17d4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437598} :answer-field/id #uuid "19bef9f2-14bf-5988-884b-2c3e717c03e5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438828}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2d1a20d-340e-5980-ad18-92b97e0270ba" :question/math-academy-id "q-122465" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $G(x,y)={x}^{2}\\,i-{y}^{2}\\,j$\n- **II.** $H(x,y)=\\operatorname{ln}⁡y\\,i-{e}^{xy}\\,j$\n- **III.** $K(x,y,z)=x\\,i-y\\,j+z\\,k$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(x,y)$ is a vector field on ${R}^{2}.$ It maps every point $(x,y)\\in {R}^{2}$ to a vector in ${R}^{2}.$\n\n- The function $H(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,y>0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $K(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186172279 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257efe5e-2614-5ac2-bf85-79ecbfa90a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437600} {:answer/id #uuid "9b6b7630-7b4f-55f1-bc9a-d761bb022686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437601}] :answer-field/correct {:answer/id #uuid "257efe5e-2614-5ac2-bf85-79ecbfa90a56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437600} :answer-field/id #uuid "cb7b4231-7e44-5469-8d42-537ade15949a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438829} {:answer-field/choices [{:answer/id #uuid "c2a1f4d6-a1e4-52e9-8825-2408433db854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437602} {:answer/id #uuid "d3b41f11-8dd8-570a-b746-ce040d0c6094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437603}] :answer-field/correct {:answer/id #uuid "c2a1f4d6-a1e4-52e9-8825-2408433db854" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437602} :answer-field/id #uuid "666ed197-24fa-5d30-ae83-a374aabe3407" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438830} {:answer-field/choices [{:answer/id #uuid "0b2abe03-84b2-5689-9957-2c5ddaaeaf0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437604} {:answer/id #uuid "4235aad1-8567-5a5f-b358-a0eadb4ecae7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437605}] :answer-field/correct {:answer/id #uuid "4235aad1-8567-5a5f-b358-a0eadb4ecae7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437605} :answer-field/id #uuid "3a3877a7-32e1-5f78-bf7a-c67ae72c6830" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438831}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "060c20fc-1491-5624-9b50-89ab0dfe4d22" :question/math-academy-id "q-122467" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply.\n\n- **I.** $G(t)={e}^{t}\\,i-t\\,j+\\operatorname{sin}⁡t\\,k$\n- **II.** $H(x,y)={x}^{2}\\,i-{y}^{2}\\,j$\n- **III.** $K(x,y,z)=\\operatorname{cot}⁡x\\,i-y\\,j+z\\,k$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $G(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\n- The function $H(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $K(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ne n\\pi ,\\,n\\in Z}\n$$\n\nto a vector in ${R}^{3}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186172283 :knowledge-point/_questions [{:db/id #edb/ref 17592186172085 :knowledge-point/id #uuid "019e5a17-1aab-565b-8881-447c86a9a7ec" :knowledge-point/title "Identifying Vector Fields on Two-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9db2c395-ec42-5ded-b118-40b7f641733e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437612} {:answer/id #uuid "416808ed-a781-5b4b-95e5-19a652e061b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437613}] :answer-field/correct {:answer/id #uuid "416808ed-a781-5b4b-95e5-19a652e061b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437613} :answer-field/id #uuid "c3b88c55-88f1-525f-b310-4ec0ae74fb86" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438835} {:answer-field/choices [{:answer/id #uuid "b870f025-7855-54e1-ba52-ff6dc5d12029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437614} {:answer/id #uuid "272a82e6-92c9-5b61-b5b0-91bb28d461e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437615}] :answer-field/correct {:answer/id #uuid "b870f025-7855-54e1-ba52-ff6dc5d12029" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437614} :answer-field/id #uuid "cd800195-cb3a-5cb6-83d8-4a289879ed7b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438836} {:answer-field/choices [{:answer/id #uuid "d35aa822-dcce-5b60-823d-bc8fd4d47fd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437616} {:answer/id #uuid "57ad27bc-d96f-5039-a317-bdadedc1b542" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437617}] :answer-field/correct {:answer/id #uuid "d35aa822-dcce-5b60-823d-bc8fd4d47fd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437616} :answer-field/id #uuid "91b9cc2d-8a9d-5c85-8be1-4e96ec3dbdef" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b23ed53-bb63-5272-af53-a6429d08e4c0" :question/math-academy-id "q-122643" :question/problem "Which of the following are vector fields on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$\n- **II.** $Q(x,y,z)=y\\,i-xy\\,j+(z+1)\\,k$\n- **III.** $R(t)=(t+1)\\,i-(3t-1)\\,j$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{2}.$ A vector field on ${R}^{2}$ is a function $F$ that maps every point $(x,y)$ in $S$ to a vector $F(x,y)\\in {R}^{2}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is a vector field on ${R}^{2}.$ It maps every point in the set $S,$ given by\n\n$$\nS={(x,y)\\in {R}^{2}\\,|\\,x\\ne 0}\n$$\n\nto a vector in ${R}^{2}.$\n\n- The function $Q(x,y,z)$ is *not* a vector field on ${R}^{2}.$ It is a vector field on ${R}^{3}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{2}.$ It assigns points in  $R$ (not ${R}^{2}$) to vectors in ${R}^{2}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186172285 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "662120df-b64d-54ef-9755-4c19a2619b08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437690} {:answer/id #uuid "5f979ab0-c9f1-5a39-8279-36823d8a4b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437691}] :answer-field/correct {:answer/id #uuid "5f979ab0-c9f1-5a39-8279-36823d8a4b6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437691} :answer-field/id #uuid "f9a1bfb0-97af-571d-8fa7-cabca9f81b58" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438874} {:answer-field/choices [{:answer/id #uuid "68c998f6-9652-545f-9f75-a13c62365a3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437692} {:answer/id #uuid "b439a47b-3c58-5ada-b83b-cb0d5f96aba3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437693}] :answer-field/correct {:answer/id #uuid "68c998f6-9652-545f-9f75-a13c62365a3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437692} :answer-field/id #uuid "50e0a766-53e1-58da-b795-ea4aa130a9a2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438875} {:answer-field/choices [{:answer/id #uuid "a15fd7a1-495c-5a1f-9e2c-3e2cf8f73c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437694} {:answer/id #uuid "c163aff7-0957-5238-8912-1448c3c67129" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437695}] :answer-field/correct {:answer/id #uuid "a15fd7a1-495c-5a1f-9e2c-3e2cf8f73c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437694} :answer-field/id #uuid "ec68c1f1-2b47-5081-9d50-db69af906f2a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4052d0d0-adca-5eb3-9bef-49295b1e5651" :question/math-academy-id "q-122697" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply.\n\n- **I.** $U(x,y,z)=⟨x+2,\\sqrt{x-y},\\operatorname{ln}⁡z⟩$\n- **II.** $V(x,y)=⟨x{e}^{y},1-y⟩$\n- **III.** $W(t)=⟨{t}^{2},2t,2-3t⟩$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $U(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x\\ge y,\\,z>0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $V(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $W(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186172639 :knowledge-point/_questions [{:db/id #edb/ref 17592186172041 :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c71a8e11-3808-53b6-bd23-65fd7fcd5550" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186171460} {:answer/id #uuid "12866de9-3edc-59a3-b95a-2ccf73d9c19a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186171461} {:answer/id #uuid "1da14450-0ccc-58cb-baa9-09a9454b2a88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186171462} {:answer/id #uuid "2e5c8c2c-9c11-54a7-bc83-0f636d4ad4a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186171463} {:answer/id #uuid "4f282a0e-df35-5fae-b43f-b6d35465926f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171464}] :answer-field/id #uuid "8897d65d-b234-5eff-84b6-9ed7672f819a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171459}] :question/id #uuid "4026efcc-47dd-5838-ae2e-6298d2d740c1" :question/math-academy-id "q-96475" :question/problem "Consider the differential equation $\\frac{dy}{dx} = (x - 1)(y + 2)$ and its slope field. Which of the following statements are true?\n\n1. At every point $(x, y)$ where $x > 1$ and $y > - 2$, the slope of the slope field is positive\n2. At every point $(x, y)$ where $x < 1$ and $y > - 2$, the slope of the slope field is positive\n3. At every point $(x, y)$ where $x > 1$ and $y < - 2$, the slope of the slope field is positive"}] [{:db/id #edb/ref 17592186172645 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "817b7d0e-081e-5f65-8394-7b2aa4d4b020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438622} {:answer/id #uuid "51e53bdb-ad9b-5fde-96ad-6776ae72ee75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438623}] :answer-field/correct {:answer/id #uuid "51e53bdb-ad9b-5fde-96ad-6776ae72ee75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438623} :answer-field/id #uuid "87784eaa-7f37-5cfd-bf94-f676298d7eb1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439340} {:answer-field/choices [{:answer/id #uuid "434b294c-ea0b-5331-849a-fa7706de7c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438624} {:answer/id #uuid "a7afa29d-56b9-57cf-9491-c30536a33167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438625}] :answer-field/correct {:answer/id #uuid "434b294c-ea0b-5331-849a-fa7706de7c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438624} :answer-field/id #uuid "c8a8760c-7b07-5de6-8cb4-15b2d479532a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439341} {:answer-field/choices [{:answer/id #uuid "005ad32f-fad3-5e4b-9876-1dea386fda92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438626} {:answer/id #uuid "da8dc176-0ecf-5a7b-9dd5-659d6a397554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438627}] :answer-field/correct {:answer/id #uuid "da8dc176-0ecf-5a7b-9dd5-659d6a397554" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438627} :answer-field/id #uuid "83dc6e63-ac75-598d-8eb8-29e5e8e60f37" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd7005de-da4a-5aae-a0ea-f0c01c178438" :question/math-academy-id "q-96767" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2xy$ and its slope field. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** At every point in the first quadrant, the slope of the slope field is positive\n- **II.** At every point in the second quadrant, the slope of the slope field is positive\n- **III.** At every point in the third quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=2xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](images/6e/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\\,\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement II is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\\,\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement III is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\\,\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant."}] [{:db/id #edb/ref 17592186172648 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81224000-258e-53da-b7de-824e60d2147f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186171514} {:answer/id #uuid "92deaf85-2e4a-58c8-afbc-75826f08c7cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186171515} {:answer/id #uuid "1797e5b1-06a1-56c3-9a5b-a773ed4f0f43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186171516} {:answer/id #uuid "336428ca-3225-589d-b53c-4fb2f58b8b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186171517} {:answer/id #uuid "4690854a-c2f9-5351-b9d0-5d2ecc7078c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171518}] :answer-field/id #uuid "21d16917-92f0-50df-8d88-ad6deaea620a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171513}] :question/id #uuid "1142a38e-b72d-5615-beec-20a68972aab2" :question/math-academy-id "q-97483" :question/problem "Consider the differential equation $\\frac{dy}{dx} = xy^{2}$ and its slope field. Which of the following statements are true?\n\n1. At every point in the first quadrant, the slope of the slope field is negative\n2. At every point in the second quadrant, the slope of the slope field is negative\n3. At every point in the third quadrant, the slope of the slope field is negative"}]}
