592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438990} {:answer-field/choices [{:answer/id #uuid "8f72c83c-eb8c-5631-b3a6-b174e90aab92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437924} {:answer/id #uuid "589c074c-f210-5e65-911b-aa087fdb7ec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437925}] :answer-field/correct {:answer/id #uuid "589c074c-f210-5e65-911b-aa087fdb7ec5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437925} :answer-field/id #uuid "0e1d7437-eee9-54ee-a6bc-2720730fc72d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438991}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b2e480d-7f17-59ba-a02c-a786007bf39b" :question/math-academy-id "q-140631" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{4y}{x},\\,x\\ne 0\n$$\n\n \n\nLet $f(x)={x}^{4}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{′}(x)=5{x}^{5}.$\n- **II.** Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement.\n- **III.** The function $y=f(x)$ is a solution of the differential equation." :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is false. Differentiating $f(x)={x}^{4},$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{4})^{′} \\\\  & =4{x}^{3} \\\\  & \\ne 5{x}^{5}.\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y={x}^{4}$ and ${y}^{′}=4{x}^{3}$ into the original equation, we get a true statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{4y}{x} \\\\ (4{x}^{3}) & \\overset{?}{=}\\frac{4({x}^{4})}{x} \\\\ 4{x}^{3} & =4{x}^{3}\\,✓\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y={x}^{4}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186101157 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df433686-7b08-5422-9159-68e30b1dd3b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437926} {:answer/id #uuid "be8d3f83-dbd7-5512-8e52-cbb77918ee9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437927}] :answer-field/correct {:answer/id #uuid "be8d3f83-dbd7-5512-8e52-cbb77918ee9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437927} :answer-field/id #uuid "3da2476a-cd94-5d52-b20c-ba45588a2e94" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438992} {:answer-field/choices [{:answer/id #uuid "697f7e93-3daf-5d09-aaa0-33a0a696b34b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437928} {:answer/id #uuid "66aac766-51f7-5829-b96d-8fdbe93a04eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437929}] :answer-field/correct {:answer/id #uuid "66aac766-51f7-5829-b96d-8fdbe93a04eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437929} :answer-field/id #uuid "13228480-d8e3-59b9-a952-c0a713529199" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438993} {:answer-field/choices [{:answer/id #uuid "9bbf35f7-eca9-5cd8-a4bb-3916780464ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437930} {:answer/id #uuid "e90e9605-ee1b-56aa-a246-8f89f26d5c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437931}] :answer-field/correct {:answer/id #uuid "e90e9605-ee1b-56aa-a246-8f89f26d5c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437931} :answer-field/id #uuid "9a4b74fc-fbff-523b-9711-9570469a2063" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438994}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47b66471-b70f-5509-8368-6a6674b74447" :question/math-academy-id "q-141078" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=2y\n$$\n\n \n\nLet $f(x)={e}^{2x}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{′}(x)=2{e}^{2x}$\n- **II.** Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement\n- **III.** The function $y=f(x)$ is a solution of the differential equation" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)={e}^{2x},$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({e}^{2x})}^{′} \\\\  & =2{e}^{2x}.\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y={e}^{2x}$ and ${y}^{′}=2{e}^{2x}$ into the original equation, we get a true statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}2y \\\\ 2{e}^{2x} & =2{e}^{2x}\\,✓\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y={e}^{2x}$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"I, II, and III.\""}]}
