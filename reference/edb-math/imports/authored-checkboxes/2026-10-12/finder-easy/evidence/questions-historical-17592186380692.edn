#{[{:db/id #edb/ref 17592186380692 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1241cb-e0b2-5b46-8f65-a3c4c3647e6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186380694} {:answer/id #uuid "81271eb6-6f13-53c5-8aa9-8681bb11bee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186380695} {:answer/id #uuid "cd3f72cb-d68f-5920-a038-03163c1fef91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186380696} {:answer/id #uuid "2e773405-32c0-5805-81d2-1ac74b422fb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186380697} {:answer/id #uuid "2ce4f059-c075-5696-ac0c-73923ae49957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186380698}] :answer-field/correct {:answer/id #uuid "2ce4f059-c075-5696-ac0c-73923ae49957" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186380698} :answer-field/id #uuid "26e476e2-9bb5-503b-95c4-0d2fc7849f6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380693}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b17979a9-57b7-5c2d-8065-c277267e307e" :question/math-academy-id "q-122686" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\n- $P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$\n- $Q(x,y,z)=\\operatorname{sin}⁡y\\,i-\\frac{x}{y}\\,j+\\frac{1}{z+1}\\,k$\n- $R(t)=\\frac{1}{t+1}\\,i-(3t-1)\\,j+\\frac{1}{{t}^{2}}\\,k$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,z\\ne -1,\\,y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186380699 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7ef600e-3fa7-5dd9-a9fc-2b417fe03e74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186380701} {:answer/id #uuid "5e6ec70d-19a0-5b3e-bfe1-e05b2b422ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186380702} {:answer/id #uuid "75de271f-3b44-5352-b40a-86d6328346d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186380703} {:answer/id #uuid "49cd7923-2c07-57ef-bd86-d4b6461a7cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186380704} {:answer/id #uuid "f5e3f847-6c34-58ac-ab31-4ffb21d98290" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186380705}] :answer-field/correct {:answer/id #uuid "5e6ec70d-19a0-5b3e-bfe1-e05b2b422ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186380702} :answer-field/id #uuid "7fa44fa7-67a0-5e32-9d16-0c65707b3d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380700}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "438dc864-2346-5ec7-8b61-791bfb4d3c82" :question/math-academy-id "q-122695" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\n- $M(x,y,z)=⟨z-{x}^{2},3x+{z}^{2},\\frac{1}{x+y}⟩$\n- $N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$\n- $P(t)=⟨{t}^{3},\\sqrt{1-t}\\,⟩$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $M(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x+y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186382826 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c43dc89-d798-5ee6-a608-13a523da7c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186382828} {:answer/id #uuid "a046a076-8d56-592d-9d5e-dee188ac0368" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186382829} {:answer/id #uuid "555d19b4-befb-5407-abf5-0647b07dd343" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382830} {:answer/id #uuid "19363938-2339-5a8d-9c88-ef7e16322d9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382831} {:answer/id #uuid "90dc64e8-45a9-5cb0-a0b9-7a2fc6081166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186382832}] :answer-field/correct {:answer/id #uuid "8c43dc89-d798-5ee6-a608-13a523da7c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186382828} :answer-field/id #uuid "5d9f3218-acdd-54b1-9241-2a69def3fc05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382827}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2ed7472-9bdb-5c0c-a495-7db6294676ad" :question/math-academy-id "q-105577" :question/problem "![](images/13/13b252e1f9a66836cbd72fbea9bb4c143a71344c923e2215a7718d75c9c42e26.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186382833 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb9ffee0-1c14-5d56-a130-16c686e072e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II,  III, and IV only" :db/id #edb/ref 17592186382835} {:answer/id #uuid "f6e2b688-dc4a-51df-b31f-74da402d876d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382836} {:answer/id #uuid "6381a206-d5fa-5c9b-8720-ec49b61ff117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186382837} {:answer/id #uuid "588732a1-fc6e-5c4a-9436-1d13cd58e9bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and IV only" :db/id #edb/ref 17592186382838} {:answer/id #uuid "00779e67-ad05-535b-b943-40c3609f48db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382839}] :answer-field/correct {:answer/id #uuid "f6e2b688-dc4a-51df-b31f-74da402d876d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382836} :answer-field/id #uuid "02c6328b-2940-51d9-8cf9-3b5e06746101" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382834}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b44da0aa-9add-572b-86e2-310e134b6864" :question/math-academy-id "q-105664" :question/problem "![](images/56/5643e87bfb5dfb5c29750f48abffe2443bf656901d74a47a0aa39bddfd0c1590.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\n- $\\text{curl}\\,F=0$\n- $\\text{curl}\\,F\\ne 0$\n- $\\text{curl}\\,F$ points in the positive $z$-direction.\n- $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has a curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/86/86aee33cdfa96ac0a61468cc9657e791e399f31c024cdbc3a932193dc897d534.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (counterclockwise), our thumb will point away from the screen. Therefore, $\\text{curl}\\,F$ also points away from the screen, in the direction of increasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186382840 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4aa1e0b-9e7d-59ae-9899-d11044920abc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186382842} {:answer/id #uuid "d6df9fc5-1104-52ed-a184-4d2bd32896ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382843} {:answer/id #uuid "9759f40e-1f08-5303-89ee-4ca26be85dea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186382844} {:answer/id #uuid "fcd8b4f3-d0c1-52aa-842b-692f07bfed4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382845} {:answer/id #uuid "8103b8e5-449a-53a9-b201-653ba1001eac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II, III, and IV only" :db/id #edb/ref 17592186382846}] :answer-field/correct {:answer/id #uuid "fcd8b4f3-d0c1-52aa-842b-692f07bfed4f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382845} :answer-field/id #uuid "4300c88e-843e-54be-b2b4-1d2f12e7f48a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382841}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73b73866-28ec-57e7-b02e-d1bd053c3918" :question/math-academy-id "q-105693" :question/problem "![](images/10/10a9960200e87e1b7b8a38789d5f70f29e48ad1f0a6e2913713da90c532eca6e.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\n- $\\text{curl}\\,F=0$\n- $\\text{curl}\\,F\\ne 0$\n- $F$ is not irrotational\n- $\\text{curl}\\,F$ points in the negative $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/59/594106633e422d24b9fea113d24fb6367fdef5ac52724931860e4163e33ce992.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statements III and IV are false. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational. And, since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186383048 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b75a3d7-2c68-5045-939c-b96536eefabd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186383050} {:answer/id #uuid "f5875d4b-1aef-538a-bf55-036d2dbe25e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186383051} {:answer/id #uuid "64767d53-1d74-51af-ad19-60acded6a893" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186383052} {:answer/id #uuid "dd5e03b1-190d-56fe-ba76-1f1148be498c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186383053} {:answer/id #uuid "aeb3f32d-6563-5ea5-b046-5c00b38ede14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186383054}] :answer-field/correct {:answer/id #uuid "f5875d4b-1aef-538a-bf55-036d2dbe25e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186383051} :answer-field/id #uuid "d45c8874-e962-5ad8-a6b1-35fe34dae948" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f81692c-bc38-55e0-9228-b9c2fd15506d" :question/math-academy-id "q-123866" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\n- $F=x{y}^{2}\\,i+{x}^{2}y\\,j$\n- $G=2x\\,i-3(x+y)\\,j$\n- $H={e}^{x-y}\\,i+{e}^{y-x}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=x{y}^{2}$ and $Q={x}^{2}y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2xy,\\,\\frac{∂Q}{∂x}=2xy.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=2x$ and $Q=-3(x+y).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=-3.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={e}^{x-y}$ and $Q={e}^{y-x}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-{e}^{x-y},\\,\\frac{∂Q}{∂x}=-{e}^{y-x}.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186396687 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d49c863-bcca-5003-b60b-2402ac1bbc16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186396689} {:answer/id #uuid "372a1527-fcb7-5e97-9214-ceab892980ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186396690} {:answer/id #uuid "89d11ef2-0ebb-56ef-85f5-eff24a1c20ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186396691} {:answer/id #uuid "6e8bd46d-8040-58fd-9418-5e14e16fd9fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186396692} {:answer/id #uuid "3ecd9f23-0f52-529d-9d3d-4b581fbbb61a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186396693}] :answer-field/correct {:answer/id #uuid "6e8bd46d-8040-58fd-9418-5e14e16fd9fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186396692} :answer-field/id #uuid "fb55a4d3-ef9d-5ba1-bc8d-64b5b8502eb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8061fba9-94fb-59ab-bb67-c981e34d25e7" :question/math-academy-id "q-66724" :question/problem "Given that $f(x)=2x+4,$ on which of the following intervals is $f(x)$ invertible?\n\nI. $x\\in (-\\infty ,\\infty )$\nII. $x\\in (10,\\infty )$\nIII. $x\\in [-5,5)$" :question/worked-solution "The function $f(x)$ is a linear function with slope $2$ and $y$-intercept $4,$ as shown below. \n\n![](images/d3/d33314230419ec762bc4ad8603b2e6c3436461cd6b4b6fe4783d12a23d01b660.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (10,\\infty )$ and $x\\in [-5,5).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186399398 :knowledge-point/_questions [{:db/id #edb/ref 17592186176053 :knowledge-point/id #uuid "92d6129b-a5c5-597a-86ee-3f19af20f326" :knowledge-point/title "Describing the General Properties of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fb60cb3-357c-5e48-b8d1-0086b493c7eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186399400} {:answer/id #uuid "19ccc92a-6243-5f86-923a-b5c24bd00fd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186399401} {:answer/id #uuid "ce053c47-98cc-5de1-940a-50290e3cb268" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186399402} {:answer/id #uuid "db658c44-2180-5d2a-b3df-00809159cb77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186399403} {:answer/id #uuid "fc8ab29b-c5b0-5fbd-9665-137b0c595045" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186399404}] :answer-field/correct {:answer/id #uuid "1fb60cb3-357c-5e48-b8d1-0086b493c7eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186399400} :answer-field/id #uuid "df865d93-f1c0-5ed8-a22e-b99b64edd838" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399399}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4383ecaa-1c57-5705-8853-cba2341fc9fa" :question/math-academy-id "q-103812" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nI. The range of the function is $(-\\infty ,-1].$\nII. $y=-1$ is the maximum value of the function.\nIII. $x=15\\pi $ is in the domain." :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ therefore the function doesn't have a maximum value. Hence, statements I and II are both false.\n\n- The function's domain is all real numbers except the integer multiples of $\\pi $, such as $0,\\pm \\pi ,\\pm 2\\pi ,….$ Hence, statement III is false."}] [{:db/id #edb/ref 17592186400184 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3912714-af31-5641-8bff-9b46c1aa3234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186400186} {:answer/id #uuid "4ceb3c00-a293-5837-a92d-52eeb50f0ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$R$ only" :db/id #edb/ref 17592186400187} {:answer/id #uuid "e1eca2de-1a70-5b67-a36e-991a07dbc939" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186400188} {:answer/id #uuid "9f38d46b-1ede-55d8-a14d-a43663a75ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186400189} {:answer/id #uuid "6ab42314-64ed-5e2f-b8e6-3a69d859b6fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186400190}] :answer-field/correct {:answer/id #uuid "d3912714-af31-5641-8bff-9b46c1aa3234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186400186} :answer-field/id #uuid "441fdc82-6754-52e3-ae25-4987eecf3c9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400185}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b30b956-8f97-5e5a-bc88-28b6d6148226" :question/math-academy-id "q-125549" :question/problem "Which of the following is a $2\\times 2$ matrix?\n\n$$\nP=[\\begin{aligned}3 & 3 \\\\ 3 & 3\\end{aligned}],\\,Q=[\\begin{aligned}4 & -2 \\\\ 0 & 0 \\\\ 1 & 3 \\\\ 0 & 5\\end{aligned}],\\,R=[\\begin{aligned}4 & -2 \\\\ -1 & -2\\end{aligned}]\n$$" :question/worked-solution "- The matrix $P$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\n- The matrix $Q$ has $4$ rows and $2$ columns. So, its dimensions are $4\\times 2.$ $\\,\\times $\n\n- The matrix $R$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\nTherefore, only $P$ and $R$ are $2\\times 2$ matrices."}] [{:db/id #edb/ref 17592186400345 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb84a0af-37c3-5e79-8fbe-6fd632ddb2cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400347} {:answer/id #uuid "b60f5982-25f6-5113-a631-31fd99ad2f88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given statements are true" :db/id #edb/ref 17592186400348} {:answer/id #uuid "fb9065e0-e068-5eb5-b990-475fc14cbafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400349} {:answer/id #uuid "bd0c4e4c-9e20-52e5-834a-7448ac684aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400350} {:answer/id #uuid "1cba16a2-864c-5c7f-8ff6-84d5ef21e54e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400351}] :answer-field/correct {:answer/id #uuid "1cba16a2-864c-5c7f-8ff6-84d5ef21e54e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400351} :answer-field/id #uuid "2b0b1a47-2ce3-5fbf-9d46-ef1b2e6548de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400346}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af5c321a-ef93-52c0-aab1-818de4211e7b" :question/math-academy-id "q-128478" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nI. $det(F)=-7$\nII. $F$ is **not** a singular matrix\nIII. $det(F)=-2$\n\n$$\nF=[\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}|-8|\\begin{aligned}-1 & 1 \\\\ 5 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =2(2-3)-8(-1-5)+3(-3-10) \\\\  & =2\\cdot (-1)-8\\cdot (-6)+3\\cdot (-13) \\\\  & =-2+48-39 \\\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186400352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} {:answer/id #uuid "6c4b7403-5eeb-50d7-a4bd-09fe3acc71a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400355} {:answer/id #uuid "21613f83-4258-54f4-a9b2-387b0255c0f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400356} {:answer/id #uuid "1db912cd-3357-5080-a6af-3948ea9b0a17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400357} {:answer/id #uuid "ee547a84-a761-5ce9-84b8-e2abf25059e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400358}] :answer-field/correct {:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} :answer-field/id #uuid "2c8cea4c-0392-5f09-b624-e7c6aa7142b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nI. $D$ is a singular matrix\nII. $det(D)=1$\nIII. $det(D)=0$\n\n$$\nD=[\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186400359 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0d86b56-15a8-5ce5-87a3-79892a8fcb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400361} {:answer/id #uuid "72d6cc07-52e5-5150-a7c0-2f37168a2e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400362} {:answer/id #uuid "c359f024-e80b-583a-9ec0-eb3841869630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400363} {:answer/id #uuid "ad585491-6925-5efe-a231-7cc8caa22373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400364} {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365}] :answer-field/correct {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365} :answer-field/id #uuid "f4cb87f6-39a9-56d2-9818-a6028ef6c858" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400360}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nI. $S$ is a singular matrix\nII. $S$ is **not** a singular matrix\nIII. $det(S)=5+2\\sqrt{7}$\n\n$$\nS=[\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186400632 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "461eef6c-aefb-5663-8d03-db54f697d105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400634} {:answer/id #uuid "b3d3c662-b67b-5b81-a307-d2b8efde6388" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400635} {:answer/id #uuid "fbcd7fd9-5df8-5756-a9f3-48cc31c9e67e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400636} {:answer/id #uuid "ec9dcc22-2e73-56c0-825d-9e630c431eb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400637} {:answer/id #uuid "56e99c2d-29cc-5ded-a5f5-80ae572f982d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400638}] :answer-field/correct {:answer/id #uuid "fbcd7fd9-5df8-5756-a9f3-48cc31c9e67e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400636} :answer-field/id #uuid "97478289-921c-5024-949c-f21308c68969" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400633}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n{\\begin{aligned} & 2x-6y-2z=4 \\\\  & 3x-9y-3z=6\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent independent\nII. The system has no solution\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."}] [{:db/id #edb/ref 17592186400639 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baed0cbf-38ec-5d81-9809-43dafa9379a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400641} {:answer/id #uuid "586150d0-53a3-501e-a821-68c180a394cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400642} {:answer/id #uuid "a39c1a3e-21c9-5508-8921-b8a05957b672" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400643} {:answer/id #uuid "2247b748-8cef-53eb-82f9-2487685f5057" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400644} {:answer/id #uuid "77d955a7-8c55-5d69-9764-f442198cee4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400645}] :answer-field/correct {:answer/id #uuid "586150d0-53a3-501e-a821-68c180a394cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400642} :answer-field/id #uuid "62ec4d2b-adce-53b9-bdc4-0b08d9bbcf9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400640}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n{\\begin{aligned} & x+2y=-1 \\\\  & 3x+7y=1 \\\\  & -2x-4y=2.\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent independent\nII. The system has no solution\nIII. The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ y=4.\\end{aligned}\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."}] [{:db/id #edb/ref 17592186400646 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c927d7e-5c4b-5882-8721-adc2b5fd92e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400648} {:answer/id #uuid "64d69900-4157-5d22-aa0e-f4d914c8f721" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400649} {:answer/id #uuid "2aba7c87-fdf8-526c-bf60-804628ebce56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400650} {:answer/id #uuid "fea224bb-b24d-5ae7-9e7c-a1698eef7494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400651} {:answer/id #uuid "a62e5405-e20d-5e9c-833b-ebb37c50b5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400652}] :answer-field/correct {:answer/id #uuid "a62e5405-e20d-5e9c-833b-ebb37c50b5ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400652} :answer-field/id #uuid "cb13c3f2-95da-5f1e-8dd8-8f023abfea3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400647}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n{\\begin{aligned} & 3x-3y=6 \\\\  & -2x+y=-3 \\\\  & 4x-4y=8.\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent dependent\nII. The system is consistent independent\nIII. The system has no solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n{\\begin{aligned}x-y=2 \\\\ y=-1.\\end{aligned}\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."}] [{:db/id #edb/ref 17592186402516 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d016a6-ae62-56e2-94ca-cf268596c630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186402518} {:answer/id #uuid "07a9ea11-bf6b-5bd3-bc0f-8446bc1bf4cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186402519} {:answer/id #uuid "89edd0ab-89db-5aea-aa06-1774d0033938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402520} {:answer/id #uuid "bf173099-427d-522f-a04c-39870e96d661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186402521} {:answer/id #uuid "5e473cc0-e97e-5768-bad0-fa0e92282062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402522}] :answer-field/correct {:answer/id #uuid "89edd0ab-89db-5aea-aa06-1774d0033938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402520} :answer-field/id #uuid "5ab0fae8-fb4f-560c-b176-a3a930105d51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cbc83e7-bc89-5609-b94a-0fe1dfb1bde0" :question/math-academy-id "q-36905" :question/problem "![](images/91/91f073fa77aab423ee33902451e61ad9f033b61b2a875b66ff69708d4361e24f.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that in each of the four given graphs, some horizontal lines intersect the curve more than once. Therefore, these are not one-to-one functions. As a result, none of them correspond to an invertible function."}]}
