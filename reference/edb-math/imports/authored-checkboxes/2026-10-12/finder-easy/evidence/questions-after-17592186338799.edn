b/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438494} {:answer/id #uuid "a91fa62b-3e27-5516-b774-e6cf906a51d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438495}] :answer-field/correct {:answer/id #uuid "550bb9f1-5049-57d7-84d3-41f3f2ac8184" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438494} :answer-field/id #uuid "a5214bf9-b022-5d37-a8e8-c3abbfca85a8" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439276}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5773d37-2017-53ae-a0d1-64c772d0dcaf" :question/math-academy-id "q-70666" :question/problem "Which of the following statements are true regarding the function $y=cos⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The function has maximum values at $x=\\frac{\\pi }{2}+2n\\pi .$\n- **II.** The function is zero at $x=-\\frac{\\pi }{2}.$\n- **III.** The range of the function is $[-\\pi ,\\pi ].$" :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/88/88378ece5b1721cdc533d07d69c004901539c7f8fda9a5a3e5c5648ed32905c5.png)\n\nLet's go through each statement.\n\n- Statement I is false. The function has a maximum at $x=0,\\pm 2\\pi ,…,$ which can be written as $x=2n\\pi .$\n\n- Statement II is true. At $x=-\\frac{\\pi }{2}$, the function intersects the $x$-axis.\n\n- Statement III is false. The minimum value is $-1$, the maximum value is $1$, and so the range is $[-1,1].$"}] [{:db/id #edb/ref 17592186338800 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choic