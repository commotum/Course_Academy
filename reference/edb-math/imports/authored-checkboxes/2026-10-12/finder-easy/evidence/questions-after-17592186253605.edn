#uuid "7a7a55f2-8f01-5f1a-af2e-f30eed260d15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437738} :answer-field/id #uuid "fc9f1a6e-ca69-519f-bba4-6e7006ac48ac" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438898}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "addfb264-5013-5ace-a74a-d9286a8c951b" :question/math-academy-id "q-126351" :question/problem "Which of the following matrices are lower triangular matrices?\n\nSelect all that apply.\n\n$A=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}5 & 0 \\\\ -1 & 2\\end{aligned}],\\,C=[\\begin{aligned}1 & -2 \\\\ 0 & 5\\end{aligned}].$" :question/worked-solution "The matrices $A$ and $B$ are lower triangular matrices since all the entries above the main diagonal are zeros.\n\nThe matrix $C$ is *not* a lower triangular matrix since it has a non-zero element above the main diagonal: \n\n$$\n\\begin{aligned}{c}_{12} & =-2\\ne 0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262616 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12919bee-30a9-5706-b50b-8d68bb9ec18f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437740} {:answer/id #uuid "bf178365-d264-5e92-b9fa-13b65028e647" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437741}] :answer-field/correct {:answer/id #uuid "bf178365-d264-5e92-b9fa-13b65028e647" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref