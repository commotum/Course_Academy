75a-5f15-96eb-a2deea0b5e3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437828} :answer-field/id #uuid "0c5ab0f1-4f67-5325-afe4-5abf634a244d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438943} {:answer-field/choices [{:answer/id #uuid "2879eacd-db77-5b78-ab2f-2988249602a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437830} {:answer/id #uuid "57da22cf-0696-5ee6-bc8a-520cb3a68dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437831}] :answer-field/correct {:answer/id #uuid "2879eacd-db77-5b78-ab2f-2988249602a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437830} :answer-field/id #uuid "4ae32b58-4231-556f-87c0-2f75598b5de0" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438944}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48d2c508-8f65-5677-91ea-4bbc2f84d34b" :question/math-academy-id "q-131192" :question/problem "![](images/e3/e30919dc7cc107bdda9872079b4dc0e59fe8e3e5767aa2d407b9d0af392803e0.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the lengths of the vector's $y$-components increase as we move vertically away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186266063 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e94a2c2-3c82-5231-8b63-336e1f39ed5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437832} {:answer/id #uuid "73f8ff38-9d88-5841-a511-f2acede95070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437833}] :answer-field/correct {:answer/id #uuid "73f8ff38-9d88-5841-a511-f2acede95070" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437833} :answer-field/id #uuid "e61f3a78-17b9-5dc8-8814-0cc4b4a2ccae" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438945} {:answer-field/choices [{:answer/id #uuid "c0116b48-f34e-5dd2-be8e-b3934161f541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437834} {:answer/id #uuid "d4bdeb0c-7d25-5346-865a-0cafac7b14d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437835}] :answer-field/correct {:answer/id #uuid "c0116b48-f34e-5dd2-be8e-b3934161f541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437834} :answer-field/id #uuid "7e71969a-fcaa-5b92-84fb-70734def355c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438946} {:answer-field/choices [{:answer/id #uuid "2f5fd46a-bab0-5a7c-95ba-10cde097fd6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437836} {:answer/id #uuid "95b4696f-fe0f-5b45-b776-8bdb7c506f5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437837}] :answer-field/correct {:answer/id #uuid "2f5fd46a-bab0-5a7c-95ba-10cde097fd6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437836} :answer-field/id #uuid "f5b8857e-16ee-534a-b0eb-3453864a2830" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438947} {:answer-field/choices [{:answer/id #uuid "f1e09cb5-c71f-5894-835a-eeacd8a45f51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437838} {:answer/id #uuid "df4757fd-166f-51c8-80cd-31f6ea0ad7ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437839}] :answer-field/correct {:answer/id #uuid "df4757fd-166f-51c8-80cd-31f6ea0ad7ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437839} :answer-field/id #uuid "67877ced-a15f-552a-9465-0ca79ff4d321" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438948}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4805821b-99fd-5b9d-aaa1-3579778dee2c" :question/math-academy-id "q-131193" :question/problem "![](images/24/243496443c3878c90fb67888add6c6ad6d3e69aa20ba24f42ee89d58a2742534.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186266079 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437856} {:answer/id #uuid "7a46d360-0b63-59bd-8d4c-b0aa9e72d4a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437857}] :answer-field/correct {:answer/id #uuid "77742b04-e958-51e3-885d-c186ce960ad8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437856} :answer-field/id #uuid "24781376-5a9f-5184-b064-24b3c476bb79" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438957} {:answer-field/choices [{:answer/id #uuid "d33cbee7-fc8b-5c3d-bfba-41b228bb82bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437858} {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437859}] :answer-field/correct {:answer/id #uuid "923f7469-7fef-5157-a155-0ff72c5145be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437859} :answer-field/id #uuid "dfb64428-9f16-5737-8c74-c42a032a0297" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438958} {:answer-field/choices [{:answer/id #uuid "058fa0b3-ef79-5a7a-afc6-113a760e3e70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437860} {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437861}] :answer-field/correct {:answer/id #uuid "5292bd0e-9d53-564c-bffc-65c61607f30c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437861} :answer-field/id #uuid "52c67e92-c96c-5d8b-b9f6-cc9263317637" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438959} {:answer-field/choices [{:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437862} {:answer/id #uuid "e701c30a-31e0-5846-a5ac-4931665193d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437863}] :answer-field/correct {:answer/id #uuid "b6613a08-4056-5a9f-9ca6-c3c5e4078896" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437862} :answer-field/id #uuid "387cbfbf-b068-513c-93c4-71cb2f6085f2" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a88235e-0bbc-5c38-af1d-92f6a6eda26f" :question/math-academy-id "q-131361" :question/problem "![](images/17/1709a94b7361a1e8764d94199f9e84802ae925a09e6481250d0846b83bb6549f.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the negative $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/7c/7c831425eae7afd709d546a8e05100f495adc04bba6450cfa56d370b415a28f5.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (clockwise), our thumb will point into the screen. Therefore, $\\text{curl}\\,F$ also points into from the screen, in the direction of decreasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186266080 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "759144aa-479f-5d85-898a-3020b5e809ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437864} {:answer/id #uuid "d58a9696-938d-5e6c-99bf-4b58b6d7d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437865}] :answer-field/correct {:answer/id #uuid "d58a9696-938d-5e6c-99bf-4b58b6d7d42a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437865} :answer-field/id #uuid "0241eaa0-bc57-5fa6-a00a-6329bb64d727" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438961} {:answer-field/choices [{:answer/id #uuid "708e20e7-d995-5c69-a88e-e75297d83f41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437866} {:answer/id #uuid "ecf7c82f-2cd4-5a1e-86ce-817f325c1c88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437867}] :answer-field/correct {:answer/id #uuid "708e20e7-d995-5c69-a88e-e75297d83f41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437866} :answer-field/id #uuid "58062d8a-4502-5ada-ad29-4c19534062ae" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438962} {:answer-field/choices [{:answer/id #uuid "28338c89-d67a-5e71-b91f-8d1aa4c5632c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437868} {:answer/id #uuid "35b99a55-bd57-5584-83e7-24b20dcf426d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437869}] :answer-field/correct {:answer/id #uuid "35b99a55-bd57-5584-83e7-24b20dcf426d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437869} :answer-field/id #uuid "0a2d3df4-555b-5933-9b1d-284221d034cd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438963} {:answer-field/choices [{:answer/id #uuid "46189e0a-937f-5303-a19e-e8e9671daedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437870} {:answer/id #uuid "a33bbeb3-b68d-5ea0-b9c4-a6bc64ed2f6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437871}] :answer-field/correct {:answer/id #uuid "46189e0a-937f-5303-a19e-e8e9671daedc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437870} :answer-field/id #uuid "36112e37-bcb8-5a8d-a232-63977d54a9c7" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438964}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f317d036-e0ac-5288-a673-4543ead19ce4" :question/math-academy-id "q-131366" :question/problem "![](images/78/781a4e33b8b55762b2dcb7575d08315b5842f83d6d78a5136a1c353eefd3069d.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is irrotational\n- **IV.** $\\text{curl}\\,F$ points in the negative $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/97/979b63f21e56924bd7880f9487cf829089e38cf14d287e70196c7a661e41f97f.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statement III is true. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational.\n\n- Statement IV is false. Since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186266113 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b502811a-4c5f-5724-8251-868a9480b1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437878} {:answer/id #uuid "186cb15a-6c0f-5792-ab70-d713ad9b8faf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437879}] :answer-field/correct {:answer/id #uuid "b502811a-4c5f-5724-8251-868a9480b1c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437878} :answer-field/id #uuid "6923725d-7900-549a-b06a-031593c2ab18" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438968} {:answer-field/choices [{:answer/id #uuid "c85fcf8a-4336-5666-8410-cf5fbbf94767" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437880} {:answer/id #uuid "df5f6c33-1e84-5f01-826a-31cd583e3cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437881}] :answer-field/correct {:answer/id #uuid "df5f6c33-1e84-5f01-826a-31cd583e3cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437881} :answer-field/id #uuid "b513b48d-527b-559e-ab81-1586620cce1c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438969} {:answer-field/choices [{:answer/id #uuid "b5dc7bbd-657b-572d-b363-90d7302303fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437882} {:answer/id #uuid "50ff0389-893c-5201-a509-7c08e6f042f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437883}] :answer-field/correct {:answer/id #uuid "b5dc7bbd-657b-572d-b363-90d7302303fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437882} :answer-field/id #uuid "3cdaf77b-d135-55af-862e-3a96aaf3f51e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438970}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e7e2bc11-b1bf-5938-9267-7923a80ec463" :question/math-academy-id "q-131719" :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned} & x+4y=-1 \\\\  & 2x+8y=-2 \\\\  & -3x-12y=3\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n\n- **II.** The system is consistent dependent\n\n- **III.** The system has a unique solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 4 & -1 \\\\ 2 & 8 & -2 \\\\ -3 & -12 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ -3 & -12 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 4 & -1 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have one free variable, $y.$ That means we can find $x$ in terms of $y.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement II is true."}] [{:db/id #edb/ref 17592186266114 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ee5d0a5-5b6e-5e3a-bb66-236cc33d9fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437902} {:answer/id #uuid "cf7df624-9f74-5695-9b6d-fb27e4a094f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437903}] :answer-field/correct {:answer/id #uuid "cf7df624-9f74-5695-9b6d-fb27e4a094f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437903} :answer-field/id #uuid "db4757d3-9a84-5289-8aea-f7dd1a0eb7d1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438980} {:answer-field/choices [{:answer/id #uuid "3e0c899b-5aaf-5d75-b95e-4d89e3c89c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437904} {:answer/id #uuid "c3bf7724-4756-5a58-8783-ffddc955e5ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437905}] :answer-field/correct {:answer/id #uuid "3e0c899b-5aaf-5d75-b95e-4d89e3c89c6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437904} :answer-field/id #uuid "cecffd33-a545-559e-827c-1ba60cf5059c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438981} {:answer-field/choices [{:answer/id #uuid "c37efec2-77d1-5d31-9f9f-b29a46d81229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437906} {:answer/id #uuid "606ba1d3-bcb9-5739-b0cd-4e6ddfbaf77d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437907}] :answer-field/correct {:answer/id #uuid "c37efec2-77d1-5d31-9f9f-b29a46d81229" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437906} :answer-field/id #uuid "0f404ad7-7486-5271-8eb0-8c1a59d275b4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438982}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a61d7528-3ce2-5d0a-af23-11395074997a" :question/math-academy-id "q-131723" :question/problem "Consider the following system of equations.\n\n$$\n{\\begin{aligned} & x-y+z=3 \\\\  & -3x+3y-3z=10\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is inconsistent\n- **II.** The system has a unique solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -1 & 1 & 3 \\\\ -3 & 3 & -3 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 & 3 \\\\ 0 & 0 & 0 & 19\\end{aligned}]\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y+0z=19,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement I is true."}] [{:db/id #edb/ref 17592186266115 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2950aad8-79f5-5899-8a58-73ef75011ac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437908} {:answer/id #uuid "e5392af0-e88c-54d2-80ee-57cd98c53027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437909}] :answer-field/correct {:answer/id #uuid "2950aad8-79f5-5899-8a58-73ef75011ac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437908} :answer-field/id #uuid "6c277d28-497a-56d5-a22a-96f890c9bcb2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438983} {:answer-field/choices [{:answer/id #uuid "f6df39b7-5e62-56b8-9a40-278abbcd76e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437910} {:answer/id #uuid "bca4b43d-938c-5727-96c4-77957ed09741" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437911}] :answer-field/correct {:answer/id #uuid "f6df39b7-5e62-56b8-9a40-278abbcd76e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437910} :answer-field/id #uuid "08f93447-1292-5c0a-bb93-f3816eee426f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438984} {:answer-field/choices [{:answer/id #uuid "6f2755c5-437d-57df-9454-eef1a48617ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437912} {:answer/id #uuid "c54df87b-4111-522f-b91f-f1d60f8ca696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437913}] :answer-field/correct {:answer/id #uuid "c54df87b-4111-522f-b91f-f1d60f8ca696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437913} :answer-field/id #uuid "89e1b2ad-cfef-519b-be03-81a8b9fde67c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438985}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09e95d08-30a6-5777-a8a8-348db8bfab42" :question/math-academy-id "q-131724" :question/problem "Consider the following system of equations.\n\n$$\n{\\begin{aligned} & x-2y=2 \\\\  & -3x-4y=3 \\\\  & 2x-4y=-1\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system has a unique solution\n- **III.** The system is inconsistent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -2 & 2 \\\\ -3 & -4 & 3 \\\\ 2 & -4 & -1\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 2 & -4 & -1\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 2 \\\\ 0 & -10 & 9 \\\\ 0 & 0 & -5\\end{aligned}]\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-5,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement III is true."}] [{:db/id #edb/ref 17592186269146 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "625bfb45-fbfc-5c45-8a45-c019c11a0ebf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437914} {:answer/id #uuid "24d952bc-2191-54a7-991a-b406bdb29aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437915}] :answer-field/correct {:answer/id #uuid "24d952bc-2191-54a7-991a-b406bdb29aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437915} :answer-field/id #uuid "045121f2-bd39-5c05-8c52-53047cd108bc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438986} {:answer-field/choices [{:answer/id #uuid "f7c070b1-6d63-5f49-bfdb-cbd527525bb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437916} {:answer/id #uuid "f81712fc-ad06-5cc5-b788-916434b10d7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437917}] :answer-field/correct {:answer/id #uuid "f81712fc-ad06-5cc5-b788-916434b10d7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437917} :answer-field/id #uuid "067ee218-e6b2-559e-99ed-d1d5f0c090a8" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438987} {:answer-field/choices [{:answer/id #uuid "da9876c3-99e9-5ed7-90b5-f31bdbecfc9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437918} {:answer/id #uuid "f370e4d0-30cc-52ff-ba53-d96669250c93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437919}] :answer-field/correct {:answer/id #uuid "f370e4d0-30cc-52ff-ba53-d96669250c93" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437919} :answer-field/id #uuid "50b35816-7d87-509e-9051-cf11a392ea93" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438988}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ccdf19a6-45a3-5b56-b00e-b00d25e501ba" :question/math-academy-id "q-13771" :question/problem "Consider the matrix \n$A=[\\begin{aligned}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}].$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is upper triangular\n\n- **II.** $A$ is lower triangular\n\n- **III.** ${A}^{T}+A$ is lower triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true, since all the entries below the main diagonal are zeros:\n\n$$\nA=[\\begin{aligned}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\n- Statement II is true, since all the entries above the main diagonal are zeros:\n\n$$\nA=[\\begin{aligned}8 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\n- Statement III is true, since the result of $A+{A}^{T}$ has all the entries above the main diagonal equal to zero: \n\n$$\n{A}^{T}+A=[\\begin{aligned}16 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 0 & 0 & 6\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186272196 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58cf84e4-bf37-53ee-9c4e-c48312865eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437932} {:answer/id #uuid "7c777b71-5609-57b6-98cd-5de6ad97f13e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437933}] :answer-field/correct {:answer/id #uuid "58cf84e4-bf37-53ee-9c4e-c48312865eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437932} :answer-field/id #uuid "1754ff84-62e2-5fa6-b4ab-1a4ed225ccf5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438995} {:answer-field/choices [{:answer/id #uuid "fd869c55-39da-53e6-ae83-c00f9f75727e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437934} {:answer/id #uuid "3ebf7563-afa0-50f3-97cb-0e17f76f6a4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437935}] :answer-field/correct {:answer/id #uuid "fd869c55-39da-53e6-ae83-c00f9f75727e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437934} :answer-field/id #uuid "94674f44-214d-51de-8806-6b7b3a2c49aa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438996} {:answer-field/choices [{:answer/id #uuid "68878cd7-dc72-5e55-800f-d9aceba0d493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437936} {:answer/id #uuid "5695c90a-25d5-5c15-8845-780cd00f9341" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437937}] :answer-field/correct {:answer/id #uuid "68878cd7-dc72-5e55-800f-d9aceba0d493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437936} :answer-field/id #uuid "b41c643e-8038-5852-a780-537545979885" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438997}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c28aa3d-73cf-552e-9e05-dfc5bcb67151" :question/math-academy-id "q-141080" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=2y\n$$\n\n \n\nLet $f(x)=\\frac{1}{2}\\operatorname{sin}⁡2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{′}(x)=2\\operatorname{cos}⁡2x$\n- **II.** Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement\n- **III.** The function $y=f(x)$ is a solution of the differential equation" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is false. Differentiating $f(x)=\\frac{1}{2}\\operatorname{sin}⁡2x,$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\frac{1}{2}\\operatorname{sin}⁡2x)}^{′} \\\\  & =\\frac{1}{2}\\cdot 2\\operatorname{cos}⁡2x \\\\  & =\\operatorname{cos}⁡2x \\\\  & \\ne 2\\operatorname{cos}⁡2x.\\end{aligned}\n$$\n\n- Statement II is false. Substituting $y=\\frac{1}{2}\\operatorname{sin}⁡2x$ and ${y}^{′}=\\operatorname{cos}⁡2x$ into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}2y \\\\ \\operatorname{cos}⁡2x & \\overset{?}{=}2(\\frac{1}{2}\\operatorname{sin}⁡2x) \\\\ \\operatorname{cos}⁡2x & \\ne \\operatorname{sin}⁡2x\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, the function $y=\\frac{1}{2}\\operatorname{sin}⁡2x$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""}] [{:db/id #edb/ref 17592186272197 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc440dfb-329e-5cce-98e2-d61a73c6573b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437938} {:answer/id #uuid "eb3e6505-7161-5f6a-be56-c236d5b1a400" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437939}] :answer-field/correct {:answer/id #uuid "eb3e6505-7161-5f6a-be56-c236d5b1a400" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437939} :answer-field/id #uuid "062dd2dc-b6ff-50a1-9e87-20f44d397210" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438998} {:answer-field/choices [{:answer/id #uuid "97fcaffe-490b-50d3-bd81-11d7998b6387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437940} {:answer/id #uuid "bfde07d3-eb9e-55be-b75d-2f6e35461ba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437941}] :answer-field/correct {:answer/id #uuid "97fcaffe-490b-50d3-bd81-11d7998b6387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437940} :answer-field/id #uuid "6e330e7c-b25a-5b7f-9f95-b68a2feb22aa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438999} {:answer-field/choices [{:answer/id #uuid "60c19038-4ad6-599a-bc53-f97ce9ff756a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437942} {:answer/id #uuid "22a53b8b-e4ab-51f5-a137-7c3a442b5a2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437943}] :answer-field/correct {:answer/id #uuid "60c19038-4ad6-599a-bc53-f97ce9ff756a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437942} :answer-field/id #uuid "ad20673a-9803-59bc-b2e5-d66a0d3efe10" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439000}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82065c87-2fb6-51b8-8d32-9c57d0719fb4" :question/math-academy-id "q-141081" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=y\\operatorname{cos}⁡2x\n$$\n\n \n\nLet $f(x)=\\operatorname{cos}⁡2x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{′}(x)=-2\\operatorname{sin}⁡2x$\n- **II.** Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement\n- **III.** The function $y=f(x)$ is a solution of the differential equation" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=\\operatorname{cos}⁡2x,$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{cos}⁡2x)}^{′} \\\\  & =-2\\operatorname{sin}⁡2x.\\end{aligned}\n$$\n\n- Statement II is false. Substituting $y=\\operatorname{cos}⁡2x$ and ${y}^{′}=-2\\operatorname{sin}⁡2x$ into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}y\\operatorname{cos}⁡2x \\\\ -2\\operatorname{sin}⁡2x & \\overset{?}{=}\\operatorname{cos}⁡2x\\cdot \\operatorname{cos}⁡2x \\\\ -2\\operatorname{sin}⁡2x & \\ne {cos}^{2}⁡2x\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, the function $y=\\operatorname{cos}⁡2x$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186272198 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76321bcd-1dfe-54f5-8624-a1897a3eb02d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437944} {:answer/id #uuid "74e24dca-87ac-5021-88ea-6d2cad76cfe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437945}] :answer-field/correct {:answer/id #uuid "74e24dca-87ac-5021-88ea-6d2cad76cfe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437945} :answer-field/id #uuid "96ed6203-45be-5de5-bbe2-94c88e917af6" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439001} {:answer-field/choices [{:answer/id #uuid "83ec8f2a-644e-5350-a178-f851274405b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437946} {:answer/id #uuid "f48e3736-83c7-5b2f-8b2a-b7622b40ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437947}] :answer-field/correct {:answer/id #uuid "f48e3736-83c7-5b2f-8b2a-b7622b40ed4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437947} :answer-field/id #uuid "9225aa09-89ea-55c4-8ca6-de93ab83d375" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439002} {:answer-field/choices [{:answer/id #uuid "67767ab0-4e77-5125-a2ab-a6302dab16e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437948} {:answer/id #uuid "adffa49b-1f3c-5361-8969-94df35c322c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437949}] :answer-field/correct {:answer/id #uuid "adffa49b-1f3c-5361-8969-94df35c322c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437949} :answer-field/id #uuid "ecd1164d-c8c5-54ab-8801-2a7ea56a251e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439003}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b7a88f7-a074-5f69-9224-f1585f849cc4" :question/math-academy-id "q-141082" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{1}{{e}^{y}}\n$$\n\n \n\nLet $f(x)=\\operatorname{ln}⁡x.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{′}(x)=\\frac{1}{x}$\n- **II.** Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement\n- **III.** The function $y=f(x)$ is a solution of the differential equation" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is true. Differentiating $f(x)=\\operatorname{ln}⁡x,$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(\\operatorname{ln}⁡x)}^{′} \\\\  & =\\frac{1}{x}.\\end{aligned}\n$$\n\n- Statement II is true. Substituting $y=\\operatorname{ln}⁡x$ and ${y}^{′}=\\frac{1}{x}$ into the original equation, we get a true statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{1}{{e}^{y}} \\\\ \\frac{1}{x} & \\overset{?}{=}\\frac{1}{{e}^{\\operatorname{ln}⁡x}} \\\\ \\frac{1}{x} & =\\frac{1}{x}\\,✓\\end{aligned}\n$$\n\n- Statement III is true. Since statement II is true, the function $y=\\operatorname{ln}⁡x$ is a solution to our differential equation.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186272199 :knowledge-point/_questions [{:db/id #edb/ref 17592186100888 :knowledge-point/id #uuid "201edc93-37b4-556a-aaea-4fcf9a01077a" :knowledge-point/title "Identifying a Solution to a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9eb1ace-da7e-5399-a3fe-3eca3341dc04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437950} {:answer/id #uuid "8294de83-bfe6-5d3e-907f-46fca51b308f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437951}] :answer-field/correct {:answer/id #uuid "a9eb1ace-da7e-5399-a3fe-3eca3341dc04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437950} :answer-field/id #uuid "9f826ec9-1240-515d-9e72-2dd14068a0b0" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439004} {:answer-field/choices [{:answer/id #uuid "307652cb-8dec-5139-b1b9-8b42d2c243ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437952} {:answer/id #uuid "d0fc6fa1-75d1-54ae-a895-4bd473e2976a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437953}] :answer-field/correct {:answer/id #uuid "307652cb-8dec-5139-b1b9-8b42d2c243ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437952} :answer-field/id #uuid "93d26810-7687-5dab-8301-97c0074dc993" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439005} {:answer-field/choices [{:answer/id #uuid "430fce2c-320b-5e26-93df-7d20527603a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437954} {:answer/id #uuid "4dee6609-1868-55be-9c34-9e4174a83b33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437955}] :answer-field/correct {:answer/id #uuid "430fce2c-320b-5e26-93df-7d20527603a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437954} :answer-field/id #uuid "81855480-1021-5030-8cb7-a5a2db6e6e14" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4402732-29b4-541b-a6e6-a372fd33bf97" :question/math-academy-id "q-141084" :question/problem "Consider the following differential equation.\n\n$$\n{y}^{′}=\\frac{y}{{x}^{2}},\\,x\\ne 0\n$$\n\n \n\nLet $f(x)=-\\frac{1}{{x}^{2}}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${f}^{′}(x)=-\\frac{2}{{x}^{3}}$\n- **II.** Substituting $y=f(x)$ and ${y}^{′}={f}^{′}(x)$ into the differential equation gives a true statement\n- **III.** The function $y=f(x)$ is a solution of the differential equation" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWith that in mind, let's check each statement in turn.\n\n- Statement I is false. Differentiating $f(x)=-\\frac{1}{{x}^{2}},$ we get \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(-\\frac{1}{{x}^{2}})}^{′} \\\\  & =\\frac{2}{{x}^{3}} \\\\  & \\ne -\\frac{2}{{x}^{3}}.\\end{aligned}\n$$\n\n- Statement II is false. Substituting $y=-\\frac{1}{{x}^{2}}$ and ${y}^{′}=\\frac{2}{{x}^{3}}$ into the original equation, we get a false statement:\n\n$$\n\\begin{aligned}{y}^{′} & \\overset{?}{=}\\frac{y}{{x}^{2}} \\\\ \\frac{2}{{x}^{3}} & \\overset{?}{=}\\frac{(-\\frac{1}{{x}^{2}})}{{x}^{2}} \\\\ \\frac{2}{{x}^{3}} & \\ne -\\frac{1}{{x}^{4}}\\,\\times \\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, the function $y=-\\frac{1}{{x}^{2}}$ is not a solution to our differential equation.\n\nTherefore, the correct answer is \"None.\""}]}
