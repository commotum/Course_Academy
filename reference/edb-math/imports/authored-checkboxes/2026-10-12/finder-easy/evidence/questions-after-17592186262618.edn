db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437756} {:answer/id #uuid "a1accfd8-f860-523b-b6c2-17f3e9aa8cf7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437757}] :answer-field/correct {:answer/id #uuid "8fb1ade4-2d9c-553f-b227-e71d2d355d0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437756} :answer-field/id #uuid "0a592820-3f24-5c9e-bdb8-cd5757ee23e0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a03e6ad4-897b-5475-96e7-f211a321e037" :question/math-academy-id "q-126484" :question/problem "Consider the matrix \n$B=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 4 & 5\\end{aligned}].$\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B$ is upper triangular\n- **II.** $B$ is lower triangular\n- **III.** ${B}^{T}$ is lower triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false, since $B$ has non-zero entries below the main diagonal:\n\n$$\nB=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 4 & 5\\end{aligned}]\n$$\n\n- Statement II is true. All the entries above the main diagonal of $B$ are zeros:\n\n$$\nB=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 0 \\\\ 0 & 4 & 5\\end{aligned}]\n$$\n\n- Statement III is false, since $B$ has non-zero entries below the main diagonal:\n\n$$\n{B}^{T}=[\\begin{aligned}3 & 0 & 0 \\\\ 0 & -2 & 4 \\\\ 0 & 0 & 5\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186262906 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "938435d8-69e4-5177-83be-c2661b220df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437788} {:answer/id #uuid "b0acf52f-1926-563b-90fe-5bd5c838a2cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437789}] :answer-field/correct {:answer/id #uuid "938435d8-69e4-5177-83be-c2661b220df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437788} :answer-field/id #uuid "ef069a99-e51d-5c41-b3dd-fbe618b3ae29" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438923} {:answer-field/choices [{:answer/id #uuid "fda1810e-40d9-5b5a-8ed9-7de0e91b6696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437790} {:answer/id #uuid "ae8badb5-ccf3-54b7-bf14-15f19c3c783e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437791}] :answer-field/correct {:answer/id #uuid "fda1810e-40d9-5b5a-8ed9-7de0e91b6696" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437790} :answer-field/id #uuid "3a6baa2c-bfa2-5841-829c-446168fc4d31" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438924} {:answer-field/choices [{:answer/id #uuid "bd3030ea-f56b-54f2-b19e-0fe96063ba8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437792} {:answer/id #uuid "13768b60-6037-5979-87a7-85e46aa637f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437793}] :answer-field/correct {:answer/id #uuid "bd3030ea-f56b-54f2-b19e-0fe96063ba8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437792} :answer-field/id #uuid "10609156-1bc3-5176-82f7-7da72d8cac5c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f86fe2f1-042a-5183-8a18-518a658cc1a0" :question/math-academy-id "q-128474" :question/problem "Which of the following statements are true regarding the matrix $Q$ given below?\n\nSelect all that apply.\n\n- **I.** $det(Q)=-5$\n- **II.** $det(Q)=1$\n- **III.** $Q$ is **not** a singular matrix\n\n$$\nQ=[\\begin{aligned}1 & 1 & -1 \\\\ 2 & 3 & 1 \\\\ 3 & 5 & 3\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(Q) & =|\\begin{aligned}1 & 1 & -1 \\\\ 2 & 3 & 1 \\\\ 3 & 5 & 3\\end{aligned}| \\\\  & =1|\\begin{aligned}3 & 1 \\\\ 5 & 3\\end{aligned}|-1|\\begin{aligned}2 & 1 \\\\ 3 & 3\\end{aligned}|-1|\\begin{aligned}2 & 3 \\\\ 3 & 5\\end{aligned}| \\\\  & =1(9-5)-1(6-3)-1(10-9) \\\\  & =1\\cdot 4-1\\cdot 3-1\\cdot 1 \\\\  & =4-3-1 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(Q)=0$, the matrix is singular. \n\nTherefore, none of the statements are true."}] [{:db/id #edb/ref 17592186262908 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9c8a655-dc30-5747-b5e0-e