2} {:answer/id #uuid "69dceb08-43f5-565b-bd2a-0344b15ee7aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186056483}] :answer-field/id #uuid "3834be7c-3d92-5a42-ba11-b5873d0a2001" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056478} {:answer-field/choices [{:answer/id #uuid "b0e16856-fe81-51dc-ba71-d4bb0b707df3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given statements are true" :db/id #edb/ref 17592186364956} {:answer/id #uuid "2a2581fc-f5d1-56c8-ab61-5d417f0d30e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186364957} {:answer/id #uuid "14d9082f-208d-5d34-9c63-524f45f1904f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186364958} {:answer/id #uuid "f9c099fe-52bc-5e28-83a9-4aad7f968450" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186364959} {:answer/id #uuid "df4cf5da-869a-50b7-a8cd-35b980cbe9eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186364960}] :answer-field/correct {:answer/id #uuid "f9c099fe-52bc-5e28-83a9-4aad7f968450" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186364959} :answer-field/id #uuid "b43375d0-11ca-5e43-8be7-2100aee7f584" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0d9bc49-c94e-5174-9068-2abf75c42684" :question/math-academy-id "q-128490" :question/problem "Which of the following statements are true regarding the matrix $M$ given below?\n\n- $det(M)=10$\n- $det(M)=-5$\n- $M$ is a singular matrix\n\n \n\n$$\nM=[\\begin{aligned}\\sqrt{5} & 0 & \\frac{1}{3} \\\\ 0 & 3 & 5 \\\\ -3\\sqrt{5} & 3 & 4\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}\\sqrt{5} & 0 & \\frac{1}{3} \\\\ 0 & 3 & 5 \\\\ -3\\sqrt{5} & 3 & 4\\end{aligned}| \\\\  & =\\sqrt{5}|\\begin{aligned}3 & 5 \\\\ 3 & 4\\end{aligned}|-0|\\begin{aligned}0 & 5 \\\\ -3\\sqrt{5} & 4\\end{aligned}|+\\frac{1}{3}|\\begin{aligned}0 & 3 \\\\ -3\\sqrt{5} & 3\\end{aligned}| \\\\  & =\\sqrt{5}(12-15)-0+\\frac{1}{3}(0+9\\sqrt{5}) \\\\  & =\\sqrt{5}\\cdot (-3)+\\frac{1}{3}\\cdot 9\\sqrt{5} \\\\  & =-3\\sqrt{5}+3\\sqrt{5} \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(M)=0$, the matrix is singular. \n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186060454 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f09ed10-b680-5e9c-99e7-04c22b6a5202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186361046} {:answer/id #uuid "4a66f65a-11a7-5f42-83a1-b14b35b1c089" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186361158} {:answer/id #uuid "51594ef1-0fed-5155-b685-7f55eca2a956" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186361194} {:answer/id #uuid "86cefcfa-29d4-56e3-b026-a13b84142878" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186361439} {:answer/id #uuid "be424c64-a1cc-5c27-9b4e-5599f2b8e337" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186361690}] :answer-field/correct {:answer/id #uuid "4a66f65a-11a7-5f42-83a1-b14b35b1c089" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186361158} :answer-field/id #uuid "6c65d0d4-2f35-53f8-943b-a9a971d3e887" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4279505-241a-54e3-b9b3-ff9b46d09cfd" :question/math-academy-id "q-9838" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\n- $det(F)=0$\n- $F$ is a singular matrix\n- $det(F)=-2$\n\n$$\nF=[\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}0 & 1 & 2 \\\\ 3 & 4 & 5 \\\\ 6 & 7 & 8\\end{aligned}| \\\\  & =0|\\begin{aligned}4 & 5 \\\\ 7 & 8\\end{aligned}|-1|\\begin{aligned}3 & 5 \\\\ 6 & 8\\end{aligned}|+2|\\begin{aligned}3 & 4 \\\\ 6 & 7\\end{aligned}| \\\\  & =0-1(24-30)+2(21-24) \\\\  & =0-1\\cdot (-6)+2\\cdot (-3) \\\\  & =6-6 \\\\  & =0\\end{aligned}\n$$\n\nSince $det(F)=0$, the matrix is singular. \n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186069366 :knowledge-point/_questi