#{[{:db/id #edb/ref 17592186101158 :knowledge-point/_questions [{:db/id #edb/ref 17592186100959 :knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc" :knowledge-point/title "Identifying Solutions to First-Order Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a10cc07-3e1c-5a71-bd0e-71421dba782d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186270071} {:answer/id #uuid "6e370130-2378-5cca-9684-975908b5877b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186270249} {:answer/id #uuid "99f82b0b-4304-51f8-928d-49d4c5dc2668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186270622} {:answer/id #uuid "9c311079-8a77-5514-87ce-fc3c5ef3f0b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186270646} {:answer/id #uuid "f70dbee7-936f-5d25-9f4c-eeba5332fed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186271437}] :answer-field/correct {:answer/id #uuid "9c311079-8a77-5514-87ce-fc3c5ef3f0b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186270646} :answer-field/id #uuid "365c75b6-595b-5005-a9c8-57ce7634fca8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e22d897d-f7ce-5b4f-b6d4-aa4c45c66b5a" :question/math-academy-id "q-141096" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-2y.\n$$\n\n Which of the following is a solution to this equation?\n\n- $y=-2{e}^{-2x}$\n- $y=-2{e}^{x}$\n- $y=2{e}^{-x}+1$" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=-2{e}^{-2x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=4{e}^{-2x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-2y \\\\ 4{e}^{-2x} & \\overset{?}{=}-2(-2{e}^{-2x}) \\\\ 4{e}^{-2x} & =4{e}^{-2x}.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=-2{e}^{-2x}$ *is* a solution to our differential equation.\n\n- Differentiating $y=-2{e}^{x},$ we get $\\frac{\\text{d}y}{\\text{d}x}=-2{e}^{x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-2y \\\\ -2{e}^{x} & \\overset{?}{=}-2(-2{e}^{x}) \\\\ -2{e}^{x} & \\overset{?}{=}4{e}^{x} \\\\ 0 & \\ne 6{e}^{x}.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=-2{e}^{x}$ is *not* a solution to our differential equation.\n\n- Differentiating $y=2{e}^{-x}+1,$ we get $\\frac{\\text{d}y}{\\text{d}x}=-2{e}^{-x}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-2y \\\\ -2{e}^{-x} & \\overset{?}{=}-2(2{e}^{-x}+1) \\\\ -2{e}^{-x} & \\overset{?}{=}-4{e}^{-x}-2 \\\\ 2{e}^{-x} & \\ne -2.\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y=2{e}^{-x}+1$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186101538 :knowledge-point/_questions [{:db/id #edb/ref 17592186100959 :knowledge-point/id #uuid "80ed79a9-8e39-5c84-9c87-dec266060afc" :knowledge-point/title "Identifying Solutions to First-Order Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6d38a0-2a35-516f-a1d9-77c57ce00963" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186345438} {:answer/id #uuid "404e89ee-49ff-5b0f-abcd-7d5e0d85fb92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186345903} {:answer/id #uuid "947521d6-d028-5c2b-980f-753bc6040fca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186346649} {:answer/id #uuid "b081be03-28c5-5fbd-9579-cb5742e049af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346892} {:answer/id #uuid "c7348c4a-0df4-5f20-93b7-2580a8f6a31f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347083}] :answer-field/correct {:answer/id #uuid "b081be03-28c5-5fbd-9579-cb5742e049af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186346892} :answer-field/id #uuid "3e56ae48-c581-52d9-a963-7da4ef4a6b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347709}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a773fc2b-812d-5f5c-8cbb-9b1672c48928" :question/math-academy-id "q-79335" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2y}{x}-2,\\,x\\ne 0.\n$$\n\n Which of the following is a solution to this equation?\n\n- $y=2x$\n- $y={x}^{2}$\n- $y={x}^{3}$" :question/worked-solution "For a function $f(x)$ to be a solution to a differential equation, it must satisfy the equation for all values of $x$ in the equation's domain.\n\nWe check each proposed solution by differentiating and substituting it into the original equation. \n\n- Differentiating $y=2x,$ we get $\\frac{\\text{d}y}{\\text{d}x}=2.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2y}{x}-2 \\\\ 2 & \\overset{?}{=}\\frac{2\\cdot 2x}{x}-2 \\\\ 2 & \\overset{?}{=}\\frac{4x}{x}-2 \\\\ 2 & \\overset{?}{=}4-2 \\\\ 2 & =2.\\,✓\\end{aligned}\n$$\n\nThis statement is *true*. Therefore, the function $y=2x$ *is* a solution to our differential equation.\n\n- Differentiating $y={x}^{2},$ we get $\\frac{\\text{d}y}{\\text{d}x}=2x.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2y}{x}-2 \\\\ 2x & \\overset{?}{=}\\frac{2\\cdot {x}^{2}}{x}-2 \\\\ 2x & \\overset{?}{=}\\frac{2{x}^{2}}{x}-2 \\\\ 2x & \\overset{?}{=}2x-2 \\\\ 0 & \\ne -2.\\,\\times \\end{aligned}\n$$\n\nThis statement is *false*. Therefore, the function $y={x}^{2}$ is *not* a solution to our differential equation.\n\n- Differentiating $y={x}^{3},$ we get $\\frac{\\text{d}y}{\\text{d}x}=3{x}^{2}.$ Substituting into the original equation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2y}{x}-2 \\\\ 3{x}^{2} & \\overset{?}{=}\\frac{2\\cdot {x}^{3}}{x}-2 \\\\ 3{x}^{2} & \\overset{?}{=}\\frac{2{x}^{3}}{x}-2 \\\\ 3{x}^{2} & \\overset{?}{=}2{x}^{2}-2 \\\\ {x}^{2} & \\ne -2\\,\\times \\end{aligned}\n$$\n\nThis statement is *not true* for all $x.$ Therefore, the function $y={x}^{3}$ is *not* a solution to our differential equation.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186111133 :knowledge-point/_questions [{:db/id #edb/ref 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2ddfed-e12b-5737-9067-c75298c26d62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186295538} {:answer/id #uuid "319f007b-2777-5802-a5f3-be9d57acd10e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186295547} {:answer/id #uuid "7511c6ff-fcd8-5956-97ad-15896c224ffe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295905} {:answer/id #uuid "9d7fb40a-bcf8-56b5-ba17-de4d716ae6e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186296108} {:answer/id #uuid "c98b46de-a866-5e57-8204-c176ef5cf504" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186296322}] :answer-field/correct {:answer/id #uuid "2f2ddfed-e12b-5737-9067-c75298c26d62" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186295538} :answer-field/id #uuid "6993e9c7-57b5-5671-8f39-f711bb76c56b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71c3d793-6b55-5392-ac94-1149b022497f" :question/math-academy-id "q-287966" :question/problem "Which of the following equations has infinitely many solutions?\n\n- $2x=x+1$\n- $2x+1=2x+1$\n- $2x+1=2x+3$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}2x & =x+1 \\\\ 2x-x & =x+1-x \\\\ x & =1.\\end{aligned}\n$$\n\nTherefore, the equation $2x=x+1$ has the unique solution $x=1.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}2x+1 & =2x+1 \\\\ 2x+1-2x & =2x+1-2x \\\\ 1 & =1.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $2x+1=2x+1$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}2x+1 & =2x+3 \\\\ 2x+1-2x & =2x+3-2x \\\\ 1 & =3.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186111138 :knowledge-point/_questions [{:db/id #edb/ref 17592186110719 :knowledge-point/id #uuid "ff4e9141-5743-55f1-a8be-3e28cb047eca" :knowledge-point/title "Identifying Equations With Infinitely Many Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d518381-826d-5b5a-9143-c3384f54726d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295343} {:answer/id #uuid "25bcd93e-20ab-5b9d-bad7-604d1797c45a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295474} {:answer/id #uuid "9d301123-07d0-56ec-a5c4-7f7c478e79f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296106} {:answer/id #uuid "cebb4fa4-d8f2-535b-ba82-cf8af4934ae3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186296350} {:answer/id #uuid "fb0e031d-7889-5551-b460-079399aa3aa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296599}] :answer-field/correct {:answer/id #uuid "9d301123-07d0-56ec-a5c4-7f7c478e79f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296106} :answer-field/id #uuid "3d2a9183-8ac0-595e-a28c-d41eacaa0077" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296753}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b24019f-f592-514c-8874-109e97014d8f" :question/math-academy-id "q-288419" :question/problem "Which of the following equations has infinitely many solutions?\n\n- $3x=2x+5$\n- $4x-2=4x-2$\n- $5x+3=5x+1$" :question/worked-solution "Let's attempt to solve each equation in turn:\n\n- For the first equation, we have\n\n$$\n\\begin{aligned}3x & =2x+5 \\\\ 3x-2x & =2x+5-2x \\\\ x & =5.\\end{aligned}\n$$\n\nTherefore, the equation $3x=2x+5$ has the unique solution $x=5.$\n\n- For the second equation, we have\n\n$$\n\\begin{aligned}4x-2 & =4x-2 \\\\ 4x-2-4x & =4x-2-4x \\\\ -2 & =-2.\\end{aligned}\n$$\n\nThis equation is true for all values of $x.$ Therefore, the equation $4x-2=4x-2$ has infinitely many solutions.\n\n- For the third equation, we have\n\n$$\n\\begin{aligned}5x+3 & =5x+1 \\\\ 5x+3-5x & =5x+1-5x \\\\ 3 & =1.\\end{aligned}\n$$\n\nThis equation is false for all values of $x.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186115752 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8ae27a-136e-5076-9ed6-6bf54a2fc555" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186300191} {:answer/id #uuid "54c660e7-e22a-5936-aedc-8d1501ef6251" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186300399} {:answer/id #uuid "78c68ded-4a4c-55f8-9c3a-af0dfcb92412" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186300555} {:answer/id #uuid "7ee5558c-7494-5c81-a3c3-c047093a1f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186300590} {:answer/id #uuid "d300d0ee-b9ac-5fd6-a739-ac93cb542fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186301011}] :answer-field/correct {:answer/id #uuid "7ee5558c-7494-5c81-a3c3-c047093a1f9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186300590} :answer-field/id #uuid "c4cd364f-a7b0-5f37-96dd-39259066615e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "402ab26a-a0df-5fc5-a264-b91a4c6d7d02" :question/math-academy-id "q-32242" :question/problem "Consider the following system of equations.\n\n$$\n{\\begin{aligned} & -x+2y=6 \\\\  & 2x-3y=13 \\\\  & 5x-y=45\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\n- The system is consistent dependent\n- The system is inconsistent\n- The system has a unique solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}-1 & 2 & 6 \\\\ 2 & -3 & 13 \\\\ 5 & -1 & 45\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-1 & 2 & 6 \\\\ 2 & -3 & 13 \\\\ 5 & -1 & 45\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 2 & 6 \\\\ 0 & 1 & 25 \\\\ 5 & -1 & 45\\end{aligned}] & {R}_{3} & :={R}_{3}+5{R}_{1} \\\\  & ∼[\\begin{aligned}-1 & 2 & 6 \\\\ 0 & 1 & 25 \\\\ 0 & 9 & 75\\end{aligned}] & {R}_{3} & :={R}_{3}+(-9){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & -6 \\\\ 0 & 1 & 25 \\\\ 0 & 0 & -150\\end{aligned}]\\end{aligned}\n$$\n\nThe final row corresponds to the equation $0x+0y=-150,$ and this has no solution. Therefore, our system has no solution, and we conclude that the system is inconsistent.\n\nAs a result, only statement II is true."}] [{:db/id #edb/ref 17592186115832 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12f9fc63-1e5b-58f3-9165-48ecf337098a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324140} {:answer/id #uuid "6531f6ef-7836-5c36-8ad2-b64340ef2dd5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324806} {:answer/id #uuid "716e8f1f-3359-5b9c-a2b5-8043eda079e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186324907} {:answer/id #uuid "942d2637-f186-5cc3-808c-b7d930c541bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186325234} {:answer/id #uuid "a0ddd36b-c315-54de-90f4-9ca1832ae646" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186325335}] :answer-field/correct {:answer/id #uuid "942d2637-f186-5cc3-808c-b7d930c541bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186325234} :answer-field/id #uuid "715194d1-fad4-5aa4-83e8-d5906bffa1a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326421}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e80c83a9-9107-528b-af57-73287d15e8e2" :question/math-academy-id "q-42061" :question/problem "Consider the following system of equations.\n\n$$\n\\{\\begin{aligned} & x-3y+z=0 \\\\  & -4x+6y=2\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nI. The system is consistent dependent\n\nII. The system has no solution\n\nIII. The system is consistent independent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & -3 & 1 & 0 \\\\ -4 & 6 & 0 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 1 & 0 \\\\ 0 & -6 & 4 & 2\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we can to find $x$ and $y$ in terms of $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement I is true."}] [{:db/id #edb/ref 17592186120421 :knowledge-point/_questions [{:db/id #edb/ref 17592186119772 :knowledge-point/id #uuid "b55b50a0-034f-57c0-8a61-883cfb0412dc" :knowledge-point/title "Identifying a Triangular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c348ec0d-ec14-5ab3-b31b-62c45b43c86b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186118641} {:answer/id #uuid "f799ec7b-3561-5729-a81c-88e3d3e97416" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186118642} {:answer/id #uuid "2953424a-c761-5832-bf1c-5ad1e817b628" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186118643} {:answer/id #uuid "6838e181-7f7b-53d2-beaa-db8004fec2fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186118644} {:answer/id #uuid "7d7c341f-ecc1-5d20-bddd-1103016b4f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186118645}] :answer-field/id #uuid "2c9c79ad-5239-5ddd-bf74-1e3f8db763bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118640} {:answer-field/choices [{:answer/id #uuid "0babb588-cb94-586c-9b9b-239ddf850608" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186402777} {:answer/id #uuid "56b0c175-3bca-5e71-b0bd-6ea1ec15fb38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186402778} {:answer/id #uuid "97735f63-e217-562f-8ab3-d21dfe4643a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186402779} {:answer/id #uuid "188af51f-738d-54fb-a2fd-9eb0c1f48912" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186402780} {:answer/id #uuid "341ee6bc-c870-5be4-a9af-153355b7a5a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186402781}] :answer-field/correct {:answer/id #uuid "0babb588-cb94-586c-9b9b-239ddf850608" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186402777} :answer-field/id #uuid "eba24bc4-353b-563d-b970-3c4e99c8ae95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402776}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a1fe1df-e314-527e-a884-f0c092b97472" :question/math-academy-id "q-42090" :question/problem "Which of the following matrices are upper triangular matrices?\n\n$A=[\\begin{aligned}8 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & -4 & 5 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 6 \\\\ 0 & -1 & 3 \\\\ 5 & 7 & 11\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 0\\end{aligned}].$" :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =5\\ne 0 \\\\ {c}_{32} & =3\\ne 0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120422 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09889ed6-d2de-5fbb-bdd2-918d22217e2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324055} {:answer/id #uuid "53c62c9a-fbb1-59ec-9d4f-11753c880606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324661} {:answer/id #uuid "a3d8acf6-f67c-5e6c-8b18-c9f678f10367" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186325363} {:answer/id #uuid "b97c66bc-77e9-5cd7-a655-cec51dd0fe8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186325564} {:answer/id #uuid "c954a2d8-e51e-5a97-b015-2719a69133fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186325717}] :answer-field/correct {:answer/id #uuid "53c62c9a-fbb1-59ec-9d4f-11753c880606" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324661} :answer-field/id #uuid "51131de5-d8f6-5f46-855d-f45d006464c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326356}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39d12d09-6555-5993-ad4c-5e191be1b0c7" :question/math-academy-id "q-42091" :question/problem "Consider the matrix \n$A=[\\begin{aligned}4 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 5 & 3\\end{aligned}].$\nWhich of the following statements are true?\n\n- $A$ is upper triangular\n- $A$ is lower triangular\n- ${A}^{T}$ is upper triangular" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false, since $A$ has non-zero entries below the main diagonal:\n\n$$\nA=[\\begin{aligned}4 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 5 & 3\\end{aligned}]\n$$\n\n- Statement II is true. All the entries above the main diagonal of $A$ are zeros:\n\n$$\nA=[\\begin{aligned}4 & 0 & 0 \\\\ 2 & 1 & 0 \\\\ 0 & 5 & 3\\end{aligned}]\n$$\n\n- Statement III is true. All the entries below the main diagonal of ${A}^{T}$ are zeros:\n\n$$\n{A}^{T}=[\\begin{aligned}4 & 2 & 0 \\\\ 0 & 1 & 5 \\\\ 0 & 0 & 3\\end{aligned}]\n$$\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186120426 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d079b31f-7956-5842-ae4d-4c8d5f7fd66a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186118671} {:answer/id #uuid "f87e294e-b53d-5a2d-b4f7-424740def6dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186118672} {:answer/id #uuid "63749c01-ff67-552d-a7aa-7aad33f51dbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186118673} {:answer/id #uuid "67bea13b-8464-5256-a5c0-dbeb4526aa1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186118674} {:answer/id #uuid "733d62f5-d316-5a16-ac69-e6a364d9dfa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186118675}] :answer-field/id #uuid "30ea3363-8c78-5532-90ff-3589cc8c23d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186118670}] :question/id #uuid "64e75667-2ca8-5517-b38f-4bfa5cf4e995" :question/math-academy-id "q-42115" :question/problem "Consider the matrix\n$A = \\begin{bmatrix}-3 & 1 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$.\nWhich of the following statements are true?\n\n1. $A$ is upper triangular\n2. $A^{T} + A$ is upper triangular\n3. $A$ is lower triangular"}] [{:db/id #edb/ref 17592186124945 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83c50bb0-5a30-5c78-855b-5564f93313de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186122271} {:answer/id #uuid "cbf4ee8c-9ce5-5bf8-af60-bd5cfaf86725" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186122272} {:answer/id #uuid "3b2ce312-bc20-567f-bb2b-7d9b8d521463" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122273} {:answer/id #uuid "3b9ff3b6-a753-53c5-900e-035bfdafd68a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122274} {:answer/id #uuid "6d6a7f41-4acb-5aea-a511-2fe007ec9908" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186122275}] :answer-field/id #uuid "a4df7bfe-5317-532e-8a25-874444539327" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122270}] :question/id #uuid "75c89dd8-c054-57a5-9bbd-fa9eff000193" :question/math-academy-id "q-36000" :question/problem "![](images/8e/8e62c3485aed6c52001cc7ad8eda5c1eb09cd4873d6b740eb7595413dafa15e0.png)\n\nWhich of the graphs above correspond to an invertible function?"}] [{:db/id #edb/ref 17592186124951 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07090fc8-c92c-5618-9012-cf0f1646450c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186321202} {:answer/id #uuid "0fe1e716-191b-5261-a643-11dccd52c0cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186321272} {:answer/id #uuid "7058d824-9a65-5aad-a618-ec1279c82cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186322025} {:answer/id #uuid "8b8f2599-68f2-5e06-b402-e4e77d2f9558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186322263} {:answer/id #uuid "c5538761-3933-52cf-bf3a-e8775a2d4878" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322679}] :answer-field/correct {:answer/id #uuid "7058d824-9a65-5aad-a618-ec1279c82cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186322025} :answer-field/id #uuid "2700a4d9-d130-5eeb-a944-7092bfe21365" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8099f21-9137-5121-a075-a61a4c5ae84b" :question/math-academy-id "q-36039" :question/problem "![](images/93/936cea1e20ef7bbc1eb66acf9dd564c61476f5bb68ee05e553b00aaf3f970dc3.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible? \n\nI. $x\\in [-4,0]$\n\nII. $x\\in (-4,-2]$\n\nIII. $x\\in (-3,1)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.  \n\n- The given function is invertible on each of the intervals $x\\in [-4,0]$ and $x\\in (-4,-2].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/a4/a4499c2d4995c09b9ab6f8852cc2982f415f1650d65429c86df83800344106f4.png)\n\n- The given function is **not** invertible on the interval $x\\in (-3,1]$  because some lines will intersect the curve at more than one point.\n\n![](images/cb/cb0a462b3af10d15bb586f127baac45a74eecd5dc19848bda23664e75de968a4.png)\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186125018 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5ab6900-c8da-56de-b62a-bf3a1d4d10d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186122709} {:answer/id #uuid "e2d89c4b-603f-53ac-a7b7-b89c17fd5c61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186122710} {:answer/id #uuid "4693a105-893c-5ac9-9b6c-e651dc075271" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186122711} {:answer/id #uuid "5e948606-25c1-55c6-9bde-c9158bb85ef6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186122712} {:answer/id #uuid "766b5449-7ecc-5a19-ba23-f9f7d5c3156f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186122713}] :answer-field/id #uuid "db10059c-5b0b-55c3-9bcf-b1a6071ce31f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122708}] :question/id #uuid "4763915f-8f50-5b34-9b27-a90ea817e8a2" :question/math-academy-id "q-36897" :question/problem "![](images/ca/caeed93f57e554d6bf79b8915935261abb39c6fe54cc6d7d349ff60502a96053.png)\n\nWhich of the graphs above correspond to an invertible function?"}] [{:db/id #edb/ref 17592186125021 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4caea11f-484f-50a4-a520-52df284329ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186321753} {:answer/id #uuid "54e75cb9-e5b0-5ea8-9eaf-304e5de715df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186321816} {:answer/id #uuid "888f7548-fc8c-5732-aae9-9e3aa70555ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322236} {:answer/id #uuid "c304d552-6f05-5067-a107-0c7b855a1c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186322661} {:answer/id #uuid "f99f1c2f-bc18-5796-a3e2-28f9f9b5b60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186323112}] :answer-field/correct {:answer/id #uuid "888f7548-fc8c-5732-aae9-9e3aa70555ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322236} :answer-field/id #uuid "9392c5de-5972-51d1-8356-6d7fe3ba1f53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323456}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e891cfb3-f978-5b44-b8bf-4d4f9f71b503" :question/math-academy-id "q-36941" :question/problem "![](images/3c/3cbdac583a4cdf1b5eb761892934516a0b4edd1487bd402ae0014859c4a0ad53.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nI. $x\\in (-2,0]$\n\nII. $x\\in (-2,2]$\n\nIII. $x\\in [-4,-2]\\cup [2,4]$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-2,0].$ Indeed, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/d7/d7c6e8d314483ad67e89ce5d4675b7af27fa08c88a4ed9d95eed9ad2a4da51cc.png)\n\n- The given function is **not** invertible on the intervals $x\\in (-2,2]$ and $x\\in [-4,-2]\\cup [2,4]$ because some horizontal lines will intersect the curve more than once.\n\n![](images/ce/cee829f7e3d5f32b0acb54cb5c40406d8391d2a2967c68df0c1f5e1cae87d729.png)\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186125195 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b27a71-8627-553d-b3b7-736e498a4b2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186333054} {:answer/id #uuid "094b9895-e6b6-5c84-904b-7748f61b2bd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186333075} {:answer/id #uuid "292d8888-725c-5063-9b6e-8a489b08f92b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186333369} {:answer/id #uuid "6e8d7775-ce84-5e09-b7f9-dc721abba388" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186333994} {:answer/id #uuid "8496717f-5bba-5751-8934-d2a8aeb6efb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186334168}] :answer-field/correct {:answer/id #uuid "292d8888-725c-5063-9b6e-8a489b08f92b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186333369} :answer-field/id #uuid "257150c1-6d20-56ba-86c5-f7814a686dee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335309}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ea11e93-5fca-5cd0-afe6-c972b9a2cce3" :question/math-academy-id "q-66482" :question/problem "Given that $f(x)={x}^{2}+2,$ on which of the following intervals is $f(x)$ invertible?\n\n- $x\\in (-2,2)$\n- $x\\in [0,\\infty )$\n- $x\\in (-\\infty ,0]$" :question/worked-solution "The graph of the function $f(x)={x}^{2}+2$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Translate it by $2$ units up to get $f(x)={x}^{2}+2.$\n\n![](images/ff/ff3d1ac7500d83574b8671b23e99d4a0f1dbd6ab9cebc906aa06ff2c21f95345.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-2,2).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/a7/a71ce036adc5dc0b15fce9e367a0c8512699dc6a7814f4e9a1886696d2abad6e.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in [0,\\infty )$ and  $x\\in (-\\infty ,0].$ On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/68/6858bd1fab8d9659c84fa941cd63ee9f509c8364dce0e753706c640ecfe6e9ec.png)\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186125196 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23d0843d-f9d9-53fc-af2f-70a86972fbce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186333318} {:answer/id #uuid "412a7385-2c06-5d4c-ac37-0f84026f3a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186333603} {:answer/id #uuid "6fb699d0-cd94-5a03-a574-8917a2ac4e97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186334007} {:answer/id #uuid "e5d97bcc-489c-515d-98cd-9ee8a1c3da76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186334990} {:answer/id #uuid "f4c9284a-dd6b-5244-871b-d2e03d20fb5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186335133}] :answer-field/correct {:answer/id #uuid "6fb699d0-cd94-5a03-a574-8917a2ac4e97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186334007} :answer-field/id #uuid "0040f0de-6a5e-51de-b8b9-d2321e25e753" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335238}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c08528cd-5efd-5572-9af4-e4dc31c682da" :question/math-academy-id "q-66723" :question/problem "Given that $f(x)=x+1,$ on which of the following intervals is $f(x)$ invertible?\n\n- $x\\in (-\\infty ,\\infty )$\n- $x\\in (-1,\\infty )$\n- $x\\in (-10,5)$" :question/worked-solution "The function $f(x)$ is a linear function with slope $1$ and $y$-intercept $1,$ as shown below.\n\n![](images/00/00d6394343d441ee10fa20ee029b8f89b52ff1e6ded8e7fdbe0756118212f1a8.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (-1,\\infty )$ and $x\\in (-10,5).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186129698 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ec7d09-8bfa-5f1b-9f5b-87427654f0a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186127670} {:answer/id #uuid "9a37ad05-69e2-5ecd-a7a6-3755791139ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186127671} {:answer/id #uuid "fe99d6e7-e527-59ca-bd28-1d6682864a61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186127672} {:answer/id #uuid "4adb3ede-6d8c-5d6d-8697-c125203da4ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186127673} {:answer/id #uuid "75d4d3d4-7bc6-542b-9bad-71255e648aaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186127674}] :answer-field/id #uuid "924d0a10-90b2-5b31-b97f-40dfa29b80bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127669}] :question/id #uuid "01c0cb00-762a-57c6-9d3d-dec1ec64cc03" :question/math-academy-id "q-38762" :question/problem "![](images/dc/dc2079e479351c8d0193961138aeb4dabd4689426c3e621668f314eb8445258f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n1. $x = 2$ is a root of even multiplicity.\n2. $x = ± 1$ are roots of odd multiplicity.\n3. $p(0) = 2$."}]}
