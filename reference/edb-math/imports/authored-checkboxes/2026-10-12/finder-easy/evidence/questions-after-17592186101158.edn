45499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438251}] :answer-field/correct {:answer/id #uuid "3dae7370-d996-56fe-936b-343de836684b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438250} :answer-field/id #uuid "565ecd30-91cd-5296-867d-ca7a470f2b8a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439154} {:answer-field/choices [{:answer/id #uuid "0404cc11-e4d5-5e27-b15b-f2c82d4a30c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438252} {:answer/id #uuid "8fdb23e5-d163-5ce9-8bf0-091f9dbf30d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438253}] :answer-field/correct {:answer/id #uuid "0404cc11-e4d5-5e27-b15b-f2c82d4a30c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438252} :answer-field/id #uuid "3b827e24-6b4c-5696-943d-0313a9d735b6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439155}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e891cfb3-f978-5b44-b8bf-4d4f9f71b503" :question/math-academy-id "q-36941" :question/problem "![](images/3c/3cbdac583a4cdf1b5eb761892934516a0b4edd1487bd402ae0014859c4a0ad53.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-2,0]$\n\n- **II.** $x\\in (-2,2]$\n\n- **III.** $x\\in [-4,-2]\\cup [2,4]$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-2,0].$ Indeed, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/d7/d7c6e8d314483ad67e89ce5d4675b7af27fa08c88a4ed9d95eed9ad2a4da51cc.png)\n\n- The given function is **not** invertible on the intervals $x\\in (-2,2]$ and $x\\in [-4,-2]\\cup [2,4]$ because some horizontal lines will intersect the curve more than once.\n\n![](images/ce/cee829f7e3d5f32b0acb54cb5c40406d8391d2a2967c68df0c1f5e1cae87d729.png)\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186125195 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a40ae285-433a-5246-af0a-c88929a17e44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438362} {:answer/id #uuid "e15901cc-60b2-5acb-8bde-29e449df57e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438363}] :answer-field/correct {:answer/id #uuid "a40ae285-433a-5246-af0a-c88929a17e44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438362} :answer-field/id #uuid "31c00eba-5f85-593e-a961-4f82d5b230c4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439210} {:answer-field/choices [{:answer/id #uuid "0e9d17c6-21e1-5f62-96ed-ad5565cf2dd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438364} {:answer/id #uuid "dffc387b-695d-57a9-8327-5b7f95278dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438365}] :answer-field/correct {:answer/id #uuid "dffc387b-695d-57a9-8327-5b7f95278dec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438365} :answer-field/id #uuid "d8399770-7bd0-5bd4-871d-487953742e13" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439211} {:answer-field/choices [{:answer/id #uuid "1e0e5c91-0cdc-57c0-b0a0-e40824bbc4e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438366} {:answer/id #uuid "0fd86b3d-4e5d-5a86-912e-c80f82634797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438367}] :answer-field/correct {:answer/id #uuid "0fd86b3d-4e5d-5a86-912e-c80f82634797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438367} :answer-field/id #uuid "4fca4c40-e85f-5c68-8f26-936d0e0fe80e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439212}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ea11e93-5fca-5cd0-afe6-c972b9a2cce3" :question/math-academy-id "q-66482" :question/problem "Given that $f(x)={x}^{2}+2,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-2,2)$\n- **II.** $x\\in [0,\\infty )$\n- **III.** $x\\in (-\\infty ,0]$" :question/worked-solution "The graph of the function $f(x)={x}^{2}+2$ can be obtained in the following way:\n\n- Take the curve $y={x}^{2}.$\n\n- Translate it by $2$ units up to get $f(x)={x}^{2}+2.$\n\n![](images/ff/ff3d1ac7500d83574b8671b23e99d4a0f1dbd6ab9cebc906aa06ff2c21f95345.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The function $f(x)$ is not invertible on the interval $x\\in (-2,2).$ On this interval, some horizontal lines will intersect the curve more than once.\n\n![](images/a7/a71ce036adc5dc0b15fce9e367a0c8512699dc6a7814f4e9a1886696d2abad6e.png)\n\n- The function $f(x)$ is invertible on the intervals $x\\in [0,\\infty )$ and  $x\\in (-\\infty ,0].$ On these intervals, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/68/6858bd1fab8d9659c84fa941cd63ee9f509c8364dce0e753706c640ecfe6e9ec.png)\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186125196 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a0484c-3bf3-547a-ac9e-662c11c6407f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438424} {:answer/id #uuid "6ab65fa6-d3bc-5f7c-91bd-73caca0fcd95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438425}] :answer-field/correct {:answer/id #uuid "6ab65fa6-d3bc-5f7c-91bd-73caca0fcd95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438425} :answer-field/id #uuid "30028ca6-c29b-51ed-af09-6b88025b44c3" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439241} {:answer-field/choices [{:answer/id #uuid "a9b93f81-81c6-593b-a3d8-7d442e66fafb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438426} {:answer/id #uuid "2c402c3a-58a6-59c8-a229-20d0ef1effb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438427}] :answer-field/correct {:answer/id #uuid "2c402c3a-58a6-59c8-a229-20d0ef1effb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438427} :answer-field/id #uuid "0f6bf338-1e4e-5783-b25f-385d42279cae" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439242} {:answer-field/choices [{:answer/id #uuid "fd1cef17-f883-5968-9f40-6254da05ef78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438428} {:answer/id #uuid "019d68a4-3d69-5257-8671-f80deae89182" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438429}] :answer-field/correct {:answer/id #uuid "019d68a4-3d69-5257-8671-f80deae89182" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438429} :answer-field/id #uuid "637c2a4f-d4ef-5b97-ae47-4358c0bec58d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439243}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c08528cd-5efd-5572-9af4-e4dc31c682da" :question/math-academy-id "q-66723" :question/problem "Given that $f(x)=x+1,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,\\infty )$\n- **II.** $x\\in (-1,\\infty )$\n- **III.** $x\\in (-10,5)$" :question/worked-solution "The function $f(x)$ is a linear function with slope $1$ and $y$-intercept $1,$ as shown below.\n\n![](images/00/00d6394343d441ee10fa20ee029b8f89b52ff1e6ded8e7fdbe0756118212f1a8.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (-1,\\infty )$ and $x\\in (-10,5).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186129698 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ec7d09-8bfa-5f1b-9f5b-87427654f0a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186127670} {:answer/id #uuid "9a37ad05-69e2-5ecd-a7a6-3755791139ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186127671} {:answer/id #uuid "fe99d6e7-e527-59ca-bd28-1d6682864a61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186127672} {:answer/id #uuid "4adb3ede-6d8c-5d6d-8697-c125203da4ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186127673} {:answer/id #uuid "75d4d3d4-7bc6-542b-9bad-71255e648aaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186127674}] :answer-field/id #uuid "924d0a10-90b2-5b31-b97f-40dfa29b80bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127669}] :question/id #uuid "01c0cb00-762a-57c6-9d3d-dec1ec64cc03" :question/math-academy-id "q-38762" :question/problem "![](images/dc/dc2079e479351c8d0193961138aeb4dabd4689426c3e621668f314eb8445258f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n1. $x = 2$ is a root of even multiplicity.\n2. $x = ± 1$ are roots of odd multiplicity.\n3. $p(0) = 2$."}]}
