#{[{:db/id #edb/ref 17592186380692 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa463bcd-c692-5b2e-81fb-6edd382301d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437654} {:answer/id #uuid "0f0c189c-4360-5311-8733-688846ac83f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437655}] :answer-field/correct {:answer/id #uuid "fa463bcd-c692-5b2e-81fb-6edd382301d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437654} :answer-field/id #uuid "eec2a251-816b-560e-984e-218cc993a24b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438856} {:answer-field/choices [{:answer/id #uuid "4e7e53ee-c545-556b-8c01-71673e0ac9c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437656} {:answer/id #uuid "133f3ccd-0846-5c2f-8e29-aac997ab0c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437657}] :answer-field/correct {:answer/id #uuid "133f3ccd-0846-5c2f-8e29-aac997ab0c45" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437657} :answer-field/id #uuid "1e2fd0e0-3c93-53a1-8f8a-f97251928fc1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438857} {:answer-field/choices [{:answer/id #uuid "22acadb3-7ca8-5abe-ad3c-4d0f8a82b17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437658} {:answer/id #uuid "bafa02fd-27b6-50a3-b21c-bc14c4e05eaa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437659}] :answer-field/correct {:answer/id #uuid "22acadb3-7ca8-5abe-ad3c-4d0f8a82b17b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437658} :answer-field/id #uuid "a898dd6a-8e9a-579f-bcba-72e40817966d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438858}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b17979a9-57b7-5c2d-8065-c277267e307e" :question/math-academy-id "q-122686" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply.\n\n- **I.** $P(x,y)=\\frac{1}{{x}^{2}}\\,i+(x+y)^{2}\\,j$\n- **II.** $Q(x,y,z)=\\operatorname{sin}⁡y\\,i-\\frac{x}{y}\\,j+\\frac{1}{z+1}\\,k$\n- **III.** $R(t)=\\frac{1}{t+1}\\,i-(3t-1)\\,j+\\frac{1}{{t}^{2}}\\,k$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $P(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $Q(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,z\\ne -1,\\,y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $R(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{3}.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186380699 :knowledge-point/_questions [{:db/id #edb/ref 17592186172087 :knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91acbdcb-0819-512d-8f3a-8f5b18843d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437678} {:answer/id #uuid "c042a6b6-5fe6-5670-9ac7-c7152c415d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437679}] :answer-field/correct {:answer/id #uuid "c042a6b6-5fe6-5670-9ac7-c7152c415d96" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437679} :answer-field/id #uuid "78ff1394-a615-59ad-bb26-46d4946b7591" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438868} {:answer-field/choices [{:answer/id #uuid "77a73f89-d276-53da-ba0d-e39074166f8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437680} {:answer/id #uuid "83b30725-25b3-5535-9453-a881c12cb3ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437681}] :answer-field/correct {:answer/id #uuid "77a73f89-d276-53da-ba0d-e39074166f8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437680} :answer-field/id #uuid "2a11b4f3-6da8-5671-9b65-64280b7f35aa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438869} {:answer-field/choices [{:answer/id #uuid "2c27113d-a2f3-54dd-a0fe-40e814f8066c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437682} {:answer/id #uuid "88e9a9b2-4f69-57eb-9973-f4cc63d15d74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437683}] :answer-field/correct {:answer/id #uuid "2c27113d-a2f3-54dd-a0fe-40e814f8066c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437682} :answer-field/id #uuid "e6f83e16-f061-5b3d-ae8a-955bb9e63305" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438870}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "438dc864-2346-5ec7-8b61-791bfb4d3c82" :question/math-academy-id "q-122695" :question/problem "Which of the following are vector fields on ${R}^{3}?$\n\nSelect all that apply.\n\n- **I.** $M(x,y,z)=⟨z-{x}^{2},3x+{z}^{2},\\frac{1}{x+y}⟩$\n- **II.** $N(x,y)=⟨\\operatorname{cos}⁡y+1,1-\\operatorname{sin}⁡x⟩$\n- **III.** $P(t)=⟨{t}^{3},\\sqrt{1-t}\\,⟩$" :question/worked-solution "Suppose that $S$ is a subset of ${R}^{3}.$ A vector field on ${R}^{3}$ is a function $F$ that maps every point $(x,y,z)\\in S$ to a vector $F(x,y,z)\\in {R}^{3}.$\n\nWith that in mind, let's examine each function.\n\n- The function $M(x,y,z)$ is a vector field on ${R}^{3}.$ It assigns every point in the set $S,$ given by\n\n$$\nS={(x,y,z)\\in {R}^{3}\\,|\\,x+y\\ne 0}\n$$\n\nto a vector in ${R}^{3}.$\n\n- The function $N(x,y)$ is *not* a vector field on ${R}^{3}.$ It assigns points in ${R}^{2}$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\n- The function $P(t)$ is *not* a vector field on ${R}^{3}.$ It assigns points in $R$ (not ${R}^{3}$) to vectors in ${R}^{2}$ (not ${R}^{3}$).\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186382826 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67a23b89-2744-50f5-80ee-0e41d4401774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437438} {:answer/id #uuid "1e5e0906-c5a6-5260-a5c9-800e874c6cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437439}] :answer-field/correct {:answer/id #uuid "1e5e0906-c5a6-5260-a5c9-800e874c6cc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437439} :answer-field/id #uuid "1ef5597b-7d44-55ff-944c-918cec802871" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438748} {:answer-field/choices [{:answer/id #uuid "cadfff51-416c-52a1-9b9d-aa9d8266ea73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437440} {:answer/id #uuid "118cf593-0894-584e-986e-b0ede741bec3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437441}] :answer-field/correct {:answer/id #uuid "cadfff51-416c-52a1-9b9d-aa9d8266ea73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437440} :answer-field/id #uuid "b1ff3919-7299-53ed-b07e-1da167e1b01d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438749} {:answer-field/choices [{:answer/id #uuid "d16b1a8b-6a8d-5700-920b-072cfc4fe106" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437442} {:answer/id #uuid "98622a4d-b944-5087-89c2-2495f60f347d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437443}] :answer-field/correct {:answer/id #uuid "d16b1a8b-6a8d-5700-920b-072cfc4fe106" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437442} :answer-field/id #uuid "5448d02c-650e-516b-a781-6d0ace7f3f1f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438750} {:answer-field/choices [{:answer/id #uuid "17d2f285-2227-527f-b977-6ae8cb61cf69" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437444} {:answer/id #uuid "d0d1b2e7-aa8a-576b-a9e4-c806af278c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437445}] :answer-field/correct {:answer/id #uuid "d0d1b2e7-aa8a-576b-a9e4-c806af278c4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437445} :answer-field/id #uuid "5a53885c-bf18-56a8-a814-76839979dcab" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438751}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a2ed7472-9bdb-5c0c-a495-7db6294676ad" :question/math-academy-id "q-105577" :question/problem "![](images/13/13b252e1f9a66836cbd72fbea9bb4c143a71344c923e2215a7718d75c9c42e26.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186382833 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d228b638-d4d7-5016-bf8d-0f56d5c4fadc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437454} {:answer/id #uuid "95914e2c-927b-55a2-922e-4d9800a2f38d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437455}] :answer-field/correct {:answer/id #uuid "d228b638-d4d7-5016-bf8d-0f56d5c4fadc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437454} :answer-field/id #uuid "4b934add-e755-50b4-b067-100e72fc3b58" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438756} {:answer-field/choices [{:answer/id #uuid "0bd1d98c-7ae9-55ca-9482-d88b90b0af24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437456} {:answer/id #uuid "e43b1943-3654-567b-9fed-68e4254f3b7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437457}] :answer-field/correct {:answer/id #uuid "e43b1943-3654-567b-9fed-68e4254f3b7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437457} :answer-field/id #uuid "c6ddf4cd-c05f-5097-8310-bbb48f377de3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438757} {:answer-field/choices [{:answer/id #uuid "3e686502-6511-5a87-9141-3f040b14bb72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437458} {:answer/id #uuid "d0bb29aa-53cb-587d-8e87-04375c2d7a7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437459}] :answer-field/correct {:answer/id #uuid "d0bb29aa-53cb-587d-8e87-04375c2d7a7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437459} :answer-field/id #uuid "b8779a01-b29f-51f0-ab0b-183634a90544" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438758} {:answer-field/choices [{:answer/id #uuid "f0077624-dbc3-55a6-9c6d-142323470d70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437460} {:answer/id #uuid "3165d50d-3b7d-5943-9785-4266dd0bd54a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437461}] :answer-field/correct {:answer/id #uuid "f0077624-dbc3-55a6-9c6d-142323470d70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437460} :answer-field/id #uuid "1bdf6bee-a19c-5f09-acb1-0c8cf50d5033" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b44da0aa-9add-572b-86e2-310e134b6864" :question/math-academy-id "q-105664" :question/problem "![](images/56/5643e87bfb5dfb5c29750f48abffe2443bf656901d74a47a0aa39bddfd0c1590.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $\\text{curl}\\,F$ points in the positive $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has a curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n![](images/86/86aee33cdfa96ac0a61468cc9657e791e399f31c024cdbc3a932193dc897d534.png)\n\nIf $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement II is true, whereas statement I is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would rotate clockwise. Therefore, $\\text{curl}\\,F\\ne 0.$\n\n- Statement III is true. Using our right hand, if we wrap our fingers in the direction of rotation (counterclockwise), our thumb will point away from the screen. Therefore, $\\text{curl}\\,F$ also points away from the screen, in the direction of increasing $z.$\n\n- Statement IV is false. Since $\\text{curl}\\,F\\ne 0,$ the vector field $F$ is not irrotational.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186382840 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dbe322f2-3c81-5a3f-8384-a79b47c4192c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437494} {:answer/id #uuid "cd9d57fd-6acd-56c1-9f2e-b83a1aa501a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437495}] :answer-field/correct {:answer/id #uuid "cd9d57fd-6acd-56c1-9f2e-b83a1aa501a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437495} :answer-field/id #uuid "3898a42c-a0be-50b6-8124-860e6bfc10bd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438776} {:answer-field/choices [{:answer/id #uuid "7ebb3d1f-b473-5ff0-99dc-159e666e7930" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437496} {:answer/id #uuid "f0f04e94-0931-5901-b36f-4cf0aefffcb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437497}] :answer-field/correct {:answer/id #uuid "7ebb3d1f-b473-5ff0-99dc-159e666e7930" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437496} :answer-field/id #uuid "8f5874c9-61e8-5f41-9f79-2b146b618ffd" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438777} {:answer-field/choices [{:answer/id #uuid "0d37dd19-280c-5e67-ae16-cb2d1a8d8768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437498} {:answer/id #uuid "82315627-af21-5603-83df-7fa71a175af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437499}] :answer-field/correct {:answer/id #uuid "0d37dd19-280c-5e67-ae16-cb2d1a8d8768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437498} :answer-field/id #uuid "87749995-78bc-517b-80a4-3ef44008acb3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438778} {:answer-field/choices [{:answer/id #uuid "3e6a54cb-d3b8-527e-8166-9d17d4c66cfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437500} {:answer/id #uuid "f7668637-64a8-52ae-aa22-7ac35611bf2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437501}] :answer-field/correct {:answer/id #uuid "3e6a54cb-d3b8-527e-8166-9d17d4c66cfb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437500} :answer-field/id #uuid "b01a01c4-08c1-5b79-8565-85e0e916e53a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438779}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73b73866-28ec-57e7-b02e-d1bd053c3918" :question/math-academy-id "q-105693" :question/problem "![](images/10/10a9960200e87e1b7b8a38789d5f70f29e48ad1f0a6e2913713da90c532eca6e.png)\n\nConsider the vector field $F(x,y,z),$ shown above. Given that $F(x,y,z)$ is independent of $z,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $\\text{curl}\\,F=0$\n- **II.** $\\text{curl}\\,F\\ne 0$\n- **III.** $F$ is not irrotational\n- **IV.** $\\text{curl}\\,F$ points in the negative $z$-direction." :question/worked-solution "Recall that $\\text{curl}\\,F$ denotes the curl of the vector field $F.$\n\nTo understand intuitively whether a vector field has curl at a point $P$, imagine that our vector field $F$ represents the velocity field of a stream of flowing water. We place a paddlewheel at $P$ with the axis of rotation pointing in the $z$-direction, and we note whether the paddlewheel rotates or not.\n\n- If the paddlewheel does not rotate due to the action of the water, then the velocity field has zero curl, i.e., $\\text{curl}\\,F=0.$\n\n- If the paddlewheel is forced to rotate due to the action of the water, then the vector field has curl, i.e., $\\text{curl}\\,F\\ne 0.$\n\n![](images/59/594106633e422d24b9fea113d24fb6367fdef5ac52724931860e4163e33ce992.png)\n\nMoreover, if $\\text{curl}\\,F=0$ everywhere in ${R}^{3}$, we say that $F$ is irrotational.\n\nWith that in mind, let's check each statement:\n\n- Statement I is true, whereas statement II is false. If a paddlewheel were placed at any point $P$ in the manner described above, it would not rotate. Therefore, $\\text{curl}\\,F=0.$\n\n- Statements III and IV are false. Since $\\text{curl}\\,F=0,$ the vector field $F$ is irrotational. And, since $\\text{curl}\\,F=0,$ it points in neither the positive nor the negative $z$-direction.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186383048 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e78342e-7073-5996-b8d2-29a251917883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437704} {:answer/id #uuid "1d04d934-dcdb-526f-b570-2dbcc6fce5a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437705}] :answer-field/correct {:answer/id #uuid "1d04d934-dcdb-526f-b570-2dbcc6fce5a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437705} :answer-field/id #uuid "b474b307-7652-5024-93ce-3d6d184d1386" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438881} {:answer-field/choices [{:answer/id #uuid "65dc72a9-ac06-5f1a-bf28-b0607daf1e58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437706} {:answer/id #uuid "a136b1c8-384b-51aa-80e4-6450fc364d0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437707}] :answer-field/correct {:answer/id #uuid "65dc72a9-ac06-5f1a-bf28-b0607daf1e58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437706} :answer-field/id #uuid "70c7e673-aa45-56c5-83bc-18fb8c69889f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438882} {:answer-field/choices [{:answer/id #uuid "0467504c-f5ba-5c65-b935-abce7630a7ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437708} {:answer/id #uuid "fab9a31b-ee2c-52cf-8167-c9659890b4a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437709}] :answer-field/correct {:answer/id #uuid "0467504c-f5ba-5c65-b935-abce7630a7ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437708} :answer-field/id #uuid "8654b8c1-2a6a-54eb-b934-803e7b9c7856" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438883}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7f81692c-bc38-55e0-9228-b9c2fd15506d" :question/math-academy-id "q-123866" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F=x{y}^{2}\\,i+{x}^{2}y\\,j$\n- **II.** $G=2x\\,i-3(x+y)\\,j$\n- **III.** $H={e}^{x-y}\\,i+{e}^{y-x}\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields.\n\n- For the vector field $F,$ we have $P=x{y}^{2}$ and $Q={x}^{2}y.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2xy,\\,\\frac{∂Q}{∂x}=2xy.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P=2x$ and $Q=-3(x+y).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=0,\\,\\frac{∂Q}{∂x}=-3.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $G$ is not conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P={e}^{x-y}$ and $Q={e}^{y-x}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-{e}^{x-y},\\,\\frac{∂Q}{∂x}=-{e}^{y-x}.\\end{aligned}\n$$\n\nSince the partial derivatives are not equal, we conclude that $H$ is not conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186396687 :knowledge-point/_questions [{:db/id #edb/ref 17592186124474 :knowledge-point/id #uuid "149fa184-850f-52d8-a309-4b79a371a74d" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76dd5d19-bff7-5270-8dec-36984c572a42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438430} {:answer/id #uuid "82576145-5d09-54e1-b8ab-117f2f475ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438431}] :answer-field/correct {:answer/id #uuid "82576145-5d09-54e1-b8ab-117f2f475ddd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438431} :answer-field/id #uuid "12cd27e7-f491-592d-bc1c-bffcd308ed10" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439244} {:answer-field/choices [{:answer/id #uuid "f15d1f4c-40fe-57bc-b297-88961d557422" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438432} {:answer/id #uuid "e8d21173-1383-59eb-8cfe-f2c8b7016e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438433}] :answer-field/correct {:answer/id #uuid "e8d21173-1383-59eb-8cfe-f2c8b7016e60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438433} :answer-field/id #uuid "edd44f0e-e428-5211-9041-ee63c8f7fcd9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439245} {:answer-field/choices [{:answer/id #uuid "9fdc3a0d-226e-5b29-bf47-7e99b81a72d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438434} {:answer/id #uuid "4cd56e5c-f931-59ed-ae20-782cc1018117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438435}] :answer-field/correct {:answer/id #uuid "4cd56e5c-f931-59ed-ae20-782cc1018117" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438435} :answer-field/id #uuid "786df526-ba10-57de-ad81-45417b5eaddb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439246}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8061fba9-94fb-59ab-bb67-c981e34d25e7" :question/math-academy-id "q-66724" :question/problem "Given that $f(x)=2x+4,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty ,\\infty )$\n- **II.** $x\\in (10,\\infty )$\n- **III.** $x\\in [-5,5)$" :question/worked-solution "The function $f(x)$ is a linear function with slope $2$ and $y$-intercept $4,$ as shown below. \n\n![](images/d3/d33314230419ec762bc4ad8603b2e6c3436461cd6b4b6fe4783d12a23d01b660.png)\n\nA function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-\\infty ,\\infty ).$ On this interval, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n- Since the function is invertible on $x\\in (-\\infty ,\\infty ),$ it is also invertible on  $x\\in (10,\\infty )$ and $x\\in [-5,5).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186399398 :knowledge-point/_questions [{:db/id #edb/ref 17592186176053 :knowledge-point/id #uuid "92d6129b-a5c5-597a-86ee-3f19af20f326" :knowledge-point/title "Describing the General Properties of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59486814-0d8e-599a-bf0f-57dc550e7b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437330} {:answer/id #uuid "a1dce793-5565-5d7f-905d-7cd04e4d56ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437331}] :answer-field/correct {:answer/id #uuid "59486814-0d8e-599a-bf0f-57dc550e7b15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437330} :answer-field/id #uuid "a341d84b-92d9-5335-b0b9-fd13587dacad" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438694} {:answer-field/choices [{:answer/id #uuid "74c41ab1-5221-54d6-bfb2-b2d2b1a66a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437332} {:answer/id #uuid "79a66b2d-395b-5d7a-972b-1551475dda80" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437333}] :answer-field/correct {:answer/id #uuid "74c41ab1-5221-54d6-bfb2-b2d2b1a66a85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437332} :answer-field/id #uuid "1d83191a-11eb-57de-8d9a-63c9eb52fa02" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438695} {:answer-field/choices [{:answer/id #uuid "6e7478e7-5c82-57c4-9e23-eb0f7d938047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437334} {:answer/id #uuid "c4654fa4-c8d7-53b9-af56-adb9aeac3408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437335}] :answer-field/correct {:answer/id #uuid "6e7478e7-5c82-57c4-9e23-eb0f7d938047" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437334} :answer-field/id #uuid "548cb375-8481-538b-9ce6-63f0f2d26906" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4383ecaa-1c57-5705-8853-cba2341fc9fa" :question/math-academy-id "q-103812" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The range of the function is $(-\\infty ,-1].$\n- **II.** $y=-1$ is the maximum value of the function.\n- **III.** $x=15\\pi $ is in the domain." :question/worked-solution "Let's plot the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ therefore the function doesn't have a maximum value. Hence, statements I and II are both false.\n\n- The function's domain is all real numbers except the integer multiples of $\\pi $, such as $0,\\pm \\pi ,\\pm 2\\pi ,….$ Hence, statement III is false."}] [{:db/id #edb/ref 17592186400184 :knowledge-point/_questions [{:db/id #edb/ref 17592186087713 :knowledge-point/id #uuid "ed7286fe-b6e2-5544-8bc6-86afc6cdb813" :knowledge-point/title "Identifying a Matrix by Its Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb55c86-23d0-5b5f-bc72-2354b5b466d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437716} {:answer/id #uuid "e219318e-64d1-5797-b2d2-ca1d034e1e8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437717}] :answer-field/correct {:answer/id #uuid "e219318e-64d1-5797-b2d2-ca1d034e1e8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437717} :answer-field/id #uuid "2f0d0639-6df6-5059-a9b6-602ffcaf92ee" :answer-field/key "P" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438887} {:answer-field/choices [{:answer/id #uuid "1076712e-377c-500b-9ddf-97efd26f14dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437718} {:answer/id #uuid "26f72127-1b4b-5d42-baae-694969537c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437719}] :answer-field/correct {:answer/id #uuid "1076712e-377c-500b-9ddf-97efd26f14dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437718} :answer-field/id #uuid "8fe36a3a-5855-57d2-a9a2-a2370c7ad018" :answer-field/key "Q" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438888} {:answer-field/choices [{:answer/id #uuid "2b8c165f-63d1-5f56-938f-3bc82b7db8dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437720} {:answer/id #uuid "e7e7d5e9-1ef7-579a-be60-2a56b64474d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437721}] :answer-field/correct {:answer/id #uuid "e7e7d5e9-1ef7-579a-be60-2a56b64474d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437721} :answer-field/id #uuid "5cc5cd5a-e327-528b-a1d8-dac279833a17" :answer-field/key "R" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b30b956-8f97-5e5a-bc88-28b6d6148226" :question/math-academy-id "q-125549" :question/problem "Which of the following is a $2\\times 2$ matrix?\n\nSelect all that apply.\n\n$$\nP=[\\begin{aligned}3 & 3 \\\\ 3 & 3\\end{aligned}],\\,Q=[\\begin{aligned}4 & -2 \\\\ 0 & 0 \\\\ 1 & 3 \\\\ 0 & 5\\end{aligned}],\\,R=[\\begin{aligned}4 & -2 \\\\ -1 & -2\\end{aligned}]\n$$" :question/worked-solution "- The matrix $P$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\n- The matrix $Q$ has $4$ rows and $2$ columns. So, its dimensions are $4\\times 2.$ $\\,\\times $\n\n- The matrix $R$ has $2$ rows and $2$ columns. So, its dimensions are $2\\times 2.$ $\\,✓$\n\nTherefore, only $P$ and $R$ are $2\\times 2$ matrices."}] [{:db/id #edb/ref 17592186400345 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869e00c6-a4ba-5e49-adbb-6c7b2dfda6d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437800} {:answer/id #uuid "cc3eef7f-38ce-53c9-b7d7-5ad7331d9db5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437801}] :answer-field/correct {:answer/id #uuid "869e00c6-a4ba-5e49-adbb-6c7b2dfda6d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437800} :answer-field/id #uuid "ee1ffe9f-6a37-5717-a79c-006e1e279e9f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438929} {:answer-field/choices [{:answer/id #uuid "73f233cd-a07f-56cc-b019-5bf1a281c9e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437802} {:answer/id #uuid "0370b8e5-fbed-53fa-bba4-73a7be7e3de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437803}] :answer-field/correct {:answer/id #uuid "0370b8e5-fbed-53fa-bba4-73a7be7e3de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437803} :answer-field/id #uuid "91e6ecc2-f970-55e9-9644-03d1a8d33b21" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438930} {:answer-field/choices [{:answer/id #uuid "ecabd635-8703-591e-8d3a-ae23bbdf9467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437804} {:answer/id #uuid "a6071a93-94cd-5aa5-98a0-dee30b1fa3cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437805}] :answer-field/correct {:answer/id #uuid "ecabd635-8703-591e-8d3a-ae23bbdf9467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437804} :answer-field/id #uuid "d1b2f581-bf3c-5b63-a3e5-a1336a490a06" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af5c321a-ef93-52c0-aab1-818de4211e7b" :question/math-academy-id "q-128478" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nSelect all that apply.\n\n- **I.** $det(F)=-7$\n- **II.** $F$ is **not** a singular matrix\n- **III.** $det(F)=-2$\n\n$$\nF=[\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}|-8|\\begin{aligned}-1 & 1 \\\\ 5 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =2(2-3)-8(-1-5)+3(-3-10) \\\\  & =2\\cdot (-1)-8\\cdot (-6)+3\\cdot (-13) \\\\  & =-2+48-39 \\\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186400352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a30e54a5-5549-54be-a77d-0271a747f483" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437806} {:answer/id #uuid "1678c617-1408-5d9c-b2b6-f33cb2bcbc97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437807}] :answer-field/correct {:answer/id #uuid "1678c617-1408-5d9c-b2b6-f33cb2bcbc97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437807} :answer-field/id #uuid "8934c094-53e8-5252-811d-16f83b72799e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438932} {:answer-field/choices [{:answer/id #uuid "cdeb7450-ec19-5575-89aa-66f56497533b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437808} {:answer/id #uuid "cd4c6b03-6a3d-5e71-8ee1-bd76a8e47d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437809}] :answer-field/correct {:answer/id #uuid "cdeb7450-ec19-5575-89aa-66f56497533b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437808} :answer-field/id #uuid "f7edd53d-df96-5e60-b073-b95bd4d92abf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438933} {:answer-field/choices [{:answer/id #uuid "0668d434-29bc-5c22-ae50-ede25ab3fb55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437810} {:answer/id #uuid "a8d7c2a7-df8c-5627-999f-6d43c26ca389" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437811}] :answer-field/correct {:answer/id #uuid "a8d7c2a7-df8c-5627-999f-6d43c26ca389" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437811} :answer-field/id #uuid "b7f7e987-6e7f-5d92-a6ad-a4d71c321aa2" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438934}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nSelect all that apply.\n\n- **I.** $D$ is a singular matrix\n- **II.** $det(D)=1$\n- **III.** $det(D)=0$\n\n$$\nD=[\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186400359 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5b8b793-b0e3-5e04-8a37-a42568d9a5f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437818} {:answer/id #uuid "20bd5256-a3ef-5a48-b762-66cfb4a56832" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437819}] :answer-field/correct {:answer/id #uuid "d5b8b793-b0e3-5e04-8a37-a42568d9a5f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437818} :answer-field/id #uuid "f79065b5-83e0-5c45-91ca-02a92fe83586" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438938} {:answer-field/choices [{:answer/id #uuid "51e1d911-6963-56d2-a197-b7ef0fd454a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437820} {:answer/id #uuid "cee5556a-e5f1-5649-8414-f96934145291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437821}] :answer-field/correct {:answer/id #uuid "cee5556a-e5f1-5649-8414-f96934145291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437821} :answer-field/id #uuid "6d2d1bc7-850d-5cc3-a700-a5297c1412e2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438939} {:answer-field/choices [{:answer/id #uuid "c31c4506-e579-5c13-bf9e-df8c0b4217ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437822} {:answer/id #uuid "f7553a7c-6618-5039-9f2e-70225d0f69b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437823}] :answer-field/correct {:answer/id #uuid "c31c4506-e579-5c13-bf9e-df8c0b4217ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437822} :answer-field/id #uuid "bd92868f-3a2b-5764-95b0-634de408c963" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438940}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nSelect all that apply.\n\n- **I.** $S$ is a singular matrix\n- **II.** $S$ is **not** a singular matrix\n- **III.** $det(S)=5+2\\sqrt{7}$\n\n$$\nS=[\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186400632 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} {:answer/id #uuid "d6aa4878-727c-5081-a2f3-b05cc3779d8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437885}] :answer-field/correct {:answer/id #uuid "042c39af-05d4-5916-90ed-b2140841c0e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437884} :answer-field/id #uuid "819cb8bf-d475-5f1d-b674-12ded903565c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438971} {:answer-field/choices [{:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} {:answer/id #uuid "97937812-2266-5255-828e-cf5b3f4f3d5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437887}] :answer-field/correct {:answer/id #uuid "2b9fab9a-732e-557e-89af-5c725e033f13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437886} :answer-field/id #uuid "0eda7076-17f5-56be-93f9-786bf1b9618f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438972} {:answer-field/choices [{:answer/id #uuid "87384631-af80-5ad6-9a5c-bcc246f5f41d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437888} {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889}] :answer-field/correct {:answer/id #uuid "46fcba46-2ddb-5e23-8878-f4e28acdd62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437889} :answer-field/id #uuid "fa55c229-a084-546e-87ad-83ef1343ba34" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438973}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd791ebf-f827-5528-ae25-d3ac1f74c5cc" :question/math-academy-id "q-131720" :question/problem "Consider the following system of equations.\n\n$$\n{\\begin{aligned} & 2x-6y-2z=4 \\\\  & 3x-9y-3z=6\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}2 & -6 & -2 & 4 \\\\ 3 & -9 & -3 & 6\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -1 & 2 \\\\ 3 & -9 & -3 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}-3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & -1 & 2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x,$ and we have two free variables, $y$ and $z.$ That means we can find $x$ in terms of $y$ and $z.$ \n\nTherefore, since there are infinitely many solutions, we conclude that the system is *consistent dependent*. \n\nAs a result, only statement III is true."}] [{:db/id #edb/ref 17592186400639 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf929f6a-e145-57f9-9489-b8af5e174866" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437890} {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891}] :answer-field/correct {:answer/id #uuid "7f26eb37-aeba-52b6-8b95-caafc52f3431" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437891} :answer-field/id #uuid "2fbdbbd8-b352-5675-a10c-aa7c8880cb1e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438974} {:answer-field/choices [{:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} {:answer/id #uuid "6cec419e-f6b4-51c0-ae9e-deed2e858fc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437893}] :answer-field/correct {:answer/id #uuid "70be4c05-8842-5d93-9933-6a01768e4c37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437892} :answer-field/id #uuid "51c120d2-aebb-5e91-8e2f-ef0869ec4dd4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438975} {:answer-field/choices [{:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} {:answer/id #uuid "262383e4-8fe8-5d1c-ad11-c487ac71bc1f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437895}] :answer-field/correct {:answer/id #uuid "43f8ee53-d356-528d-9a82-f385997b6c3b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437894} :answer-field/id #uuid "07a2a3d4-474a-5d37-b1a5-05837e60f654" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438976}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b9b47374-5548-52b6-9b51-17d923fcd37b" :question/math-academy-id "q-131721" :question/problem "Consider the following system of equations\n\n$$\n{\\begin{aligned} & x+2y=-1 \\\\  & 3x+7y=1 \\\\  & -2x-4y=2.\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent independent\n- **II.** The system has no solution\n- **III.** The system is consistent dependent" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 2 & -1 \\\\ 3 & 7 & 1 \\\\ -2 & -4 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ -2 & -4 & 2\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 1 & 4 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ y=4.\\end{aligned}\n$$\n\nFrom the second equation we have $y=4$ and substituting this into the first equation yields $x=-9.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement I is true."}] [{:db/id #edb/ref 17592186400646 :knowledge-point/_questions [{:db/id #edb/ref 17592186115299 :knowledge-point/id #uuid "f9469d5c-e097-590c-8ddb-2c7fda353fac" :knowledge-point/title "Classifying a System as Consistent Dependent, Consistent Independent, or Inconsistent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} {:answer/id #uuid "422e0298-fb2d-5c6d-a4af-8cba072754ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437897}] :answer-field/correct {:answer/id #uuid "b14622e0-0a8b-52f6-8bf8-44a04ea90e2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437896} :answer-field/id #uuid "2ddef766-7f45-5b44-b48d-737353d4be25" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438977} {:answer-field/choices [{:answer/id #uuid "522be474-9268-5719-9b67-fa3c52635318" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437898} {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899}] :answer-field/correct {:answer/id #uuid "37b81bb5-685b-583b-8db4-0245d173fc7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437899} :answer-field/id #uuid "a0b79b55-bd9c-5274-8736-1fa18bb4e7d7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438978} {:answer-field/choices [{:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} {:answer/id #uuid "715c6b27-3b25-5248-a7ad-aceb0fe78ca6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186437901}] :answer-field/correct {:answer/id #uuid "63da7652-c50c-579a-9313-44ed8eac188b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186437900} :answer-field/id #uuid "a893b756-f994-5e2f-ab56-a98d5a543109" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186438979}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4890e1ff-ed9a-5558-acd1-bcef01439e04" :question/math-academy-id "q-131722" :question/problem "Consider the following system of equations\n\n$$\n{\\begin{aligned} & 3x-3y=6 \\\\  & -2x+y=-3 \\\\  & 4x-4y=8.\\end{aligned}\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The system is consistent dependent\n- **II.** The system is consistent independent\n- **III.** The system has no solution" :question/worked-solution "To classify the system, we first need to find its solution. The augmented matrix for this system is \n\n$$\nM=[\\begin{aligned}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{aligned}].\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}3 & -3 & 6 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ -2 & 1 & -3 \\\\ 4 & -4 & 8\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 4 & -4 & 8\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & -1 & 1 \\\\ 0 & 0 & 0\\end{aligned}] & {R}_{2} & :=-{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 \\\\ 0 & 1 & -1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n{\\begin{aligned}x-y=2 \\\\ y=-1.\\end{aligned}\n$$\n\nFrom the second equation we have $y=-1$ and substituting this into the first equation yields $x=1.$ So,  we conclude that the system is consistent independent. \n\nAs a result, only statement II is true."}] [{:db/id #edb/ref 17592186402516 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ee908e5-b0e1-5821-9642-419d9c1cdefe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438234} {:answer/id #uuid "f1b60777-4ac5-5644-a3f4-ed9efade6cee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438235}] :answer-field/correct {:answer/id #uuid "5ee908e5-b0e1-5821-9642-419d9c1cdefe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438234} :answer-field/id #uuid "4fc7aa1a-a2b0-5aaa-a0b5-53b2bd9d0ac1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439146} {:answer-field/choices [{:answer/id 