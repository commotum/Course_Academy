ea1-82cb-052da618d68b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477138} :answer-field/id #uuid "ba267e9d-e2a0-5385-8f0c-ecd8fd2c153b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477538}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5df118a-6629-591e-bac9-243a7536e271" :question/math-academy-id "q-13445" :question/problem "![](images/36/36ea34524b2ca277e8061441492711d36c8065e765d519d85d4008da97c3f8b3.png)\n\nConsider the figure shown above. Which of the following triplets of points are collinear?\n\nI. $M,N,R$\n\nII. $P,S,T$\n\nIII. $O,P,S$\n\nSelect all that apply." :question/worked-solution "- $M,N,R$ are collinear since there is a straight line that passes through all of them.\n\n![](images/b8/b8fae613772422b14fce2e2db0762f659599f0b17409223ec291802b5d760d9c.png)\n\n- $P,S,T$ are **not** collinear since we can't draw a straight line that passes through all of them.\n\n![](images/85/85638c1466360f3e5285c34e84903824140b9e2fc72a0f029ab1ded170b64eb2.png)\n\n- $O,P,S$ are collinear since there is a straight line that passes through all of them.\n\n![](images/4b/4b7ef30e306e3c7e70dadb1524e1f60a9ea01832215009ef2ea8344cb07e7297.png)\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186110929 :knowledge-point/_questions [{:db/id #edb/ref 17592186110675 :knowledge-point/id #uuid "9ef4e321-841e-5933-b5e4-ff7dab6c5275" :knowledge-point/title "Identifying Collinear Points on a Grid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7afd290-acc0-55c6-998c-768cd7580391" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477145} {:answer/id #uuid "6bfad2eb-0602-548b-9e77-506210b3bc85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477146}] :answer-field/correct {:answer/id #uuid "6bfad2eb-0602-548b-9e77-506210b3bc85" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477146} :answer-field/id #uuid "8e823520-ee6e-57c6-8866-ce7228855732" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477542} {:answer-field/choices [{:answer/id #uuid "230de8f6-d07e-5dba-8bcc-a3b9c8b2125d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477147} {:answer/id #uuid "8e5146f6-0447-5fc5-bd68-f40aecec77f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477148}] :answer-field/correct {:answer/id #uuid "230de8f6-d07e-5dba-8bcc-a3b9c8b2125d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477147} :answer-field/id #uuid "a3bcafbf-d3e7-5c54-9da4-95aaae9dbd92" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477543} {:answer-field/choices [{:answer/id #uuid "d20b0e0d-f3a1-50f1-9b8e-686d5326c162" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477149} {:answer/id #uuid "c6bfc265-5ff0-51aa-b51f-40156f7ba1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477150}] :answer-field/correct {:answer/id #uuid "c6bfc265-5ff0-51aa-b51f-40156f7ba1cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477150} :answer-field/id #uuid "d716b6f3-8e54-5ea0-9948-1e07367c1482" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477544}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ea9e0d7-7c8f-5224-8f6f-e5c31c36ab4a" :question/math-academy-id "q-155503" :question/problem "![](images/bb/bb96a7692787ca6e055b41d4f1599b87baa1ea331544ea42235a7131343c76e3.png)\n\nWhich of the diagrams above shows three collinear points?\n\nSelect all that apply." :question/worked-solution "Three (or more) points are collinear if a straight line passes through all points.\n\nWith that in mind, let's examine our diagrams in turn.\n\n- Diagram I shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/54/54735541d4dfc424fe186ddabe0c3f9d3cbd45a0dc7a1b8f4551cf8c5e5bc14f.png)\n\n- Diagram II shows three points that are *not* collinear. We can't draw a straight line that passes through all three points.\n\n![](images/f0/f00f882c97fd201178e54f29151a48a4f41d4108cf375104cc338e968c55761b.png)\n\n- Diagram III shows three collinear points. There is a straight line that passes through all three of these points.\n\n![](images/6e/6e0c0320775d93364e32655d1e09081382078fa7e96fbe621a8c558f63dfcabb.png)\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186111171 :knowledge-point/_questions [{:db/id #edb/ref 17592186110587 :knowledge-point/id #uuid "5b834b64-9679-56c2-b5e9-ee26a54b5e13" :knowledge-point/title "Identifying Values in the Domain of the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e068923-3d10-550d-8421-14bddad9a0e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477313} {:answer/id #uuid "7317a4d6-2129-5d1e-8fab-a3b1303db8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 1759