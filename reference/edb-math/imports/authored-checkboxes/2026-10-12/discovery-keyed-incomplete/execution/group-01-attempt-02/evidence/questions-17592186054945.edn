b/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} :answer-field/id #uuid "ae9fdfce-f210-5819-a39f-6d6ef14bee25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{sec}⁡x=1$\nII. $\\operatorname{sec}⁡x=2$\nIII. $\\operatorname{sec}⁡x=\\frac{1}{2}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186115861 :knowledge-point/_questions [{:db/id #edb/ref 17592186115252 :knowledge-point/id #uuid "0303bd06-294e-5f7a-bbd2-b12abdeb93c5" :knowledge-point/title "Identifying an Elementary 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97f56fb8-5b1f-5ed7-83f3-fbf896435946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186114104} {:answer/id #uuid "d17770a7-feeb-56b6-be71-3bab26de9ebc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$, $Q$, and $S$" :db/id #edb/ref 17592186114105} {:answer/id #uuid "05a8814d-ed8e-586d-a75f-4da95c11270f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$S$ only" :db/id #edb/ref 17592186114106} {:answer/id #uuid "174e89b2-30c6-504f-80ed-6a3456715a2f" :answer/type {:db/id #edb/ref 17592186045499 :db