d #uuid "4fe97905-b3a8-5ea0-8781-359d19f14788" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452826} {:answer-field/choices [{:answer/id #uuid "b135c823-a7f2-5267-92f0-2062c99ce9db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451959} {:answer/id #uuid "770810e2-9b98-501c-b7d6-38738d90eb12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451960}] :answer-field/correct {:answer/id #uuid "b135c823-a7f2-5267-92f0-2062c99ce9db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451959} :answer-field/id #uuid "a5a8139b-28d0-5f8e-be9a-7298bbcbb11c" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452827}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ffc0d2e-16d3-51e9-8958-0f5807298d55" :question/math-academy-id "q-94624" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R,$ and its subset $E$ containing all diagonal $2\\times 2$ matrices.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $E$ is closed under matrix addition\n- **II.** $E$ is closed under scalar multiplication\n- **III.** $E$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $E$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If ${A}_{1}$ and ${A}_{2}$ are two matrices from $E,$ then \n\n$$\n{A}_{1}+{A}_{2}\n$$\n\n is a diagonal matrix. This matrix belongs to $E.$ So, $E$ is closed under addition.\n\n- Statement II is true. If $A$ is an element of $E,$ and $k\\in R,$ then \n\n$$\nkA\n$$\n\n is a diagonal matrix. This matrix belongs to $E.$ So, $E$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $E$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186360462 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "795fc022-fb5b-5f27-a5d8-aa4c2ad9dca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451961} {:answer/id #uuid "566a3a56-16f1-5b90-bea1-2f3ee57bb51e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451962}] :answer-field/correct {:answer/id #uuid "795fc022-fb5b-5f27-a5d8-aa4c2ad9dca7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451961} :answer-field/id #uuid "b0f4fd63-51fe-513d-929c-04e865c20a46" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452828} {:answer-field/choices [{:answer/id #uuid "39e01aaf-2818-586e-bb60-43cf7bd3de14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451963} {:answer/id #uuid "e083d6c2-56a6-577a-92e4-6ba01e342ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451964}] :answer-field/correct {:answer/id #uuid "39e01aaf-2818-586e-bb60-43cf7bd3de14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451963} :answer-field/id #uuid "5913234f-6a30-58d7-aabd-166bad7da71b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452829} {:answer-field/choices [{:answer/id #uuid "82e2ad3e-07c9-5fb2-9b3d-fe00002b1fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451965} {:answer/id #uuid "40263c7a-0627-5200-bf3d-c2777958353f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451966}] :answer-field/correct {:answer/id #uuid "82e2ad3e-07c9-5fb2-9b3d-fe00002b1fb8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451965} :answer-field/id #uuid "963e43d6-331a-56e1-be82-da9c3690ac1f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452830} {:answer-field/choices [{:answer/id #uuid "18189e21-c99c-5d19-a3a8-4e8060b0797b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186451967} {:answer/id #uuid "e6eb60f2-98a4-5b24-a94e-92f9324e2a78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451968}] :answer-field/correct {:answer/id #uuid "e6eb60f2-98a4-5b24-a94e-92f9324e2a78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186451968} :answer-field/id #uuid "3bfdc7e3-3ad3-5cba-9513-6068b167a525" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186452831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "32515201-cdee-5802-875e-aaeaf04119b1" :question/math-academy-id "q-94625" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $B={[\\begin{aligned}0 & a \\\\ 1-a & 0\\end{aligned}]\\,|\\,a\\in R}.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $B$ is closed under matrix addition\n- **II.** $B$ is closed under scalar multiplication\n- **III.** $B$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $B$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if ${A}_{1}={A}_{2}=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}],$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]+[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is not a matrix from $B.$ So, $B$ is *not* closed under addition.\n\n- Statement II is false. For example, if $A=[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}]$ and $k=2,$ then \n\n$$\n\\begin{aligned}kA & =2[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is not a matrix from $B.$ So, $B$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $B$ is a *not* subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186360463 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"}] :question/