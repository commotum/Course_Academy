t{mod}\\,2\\cdot 4) \\\\ \\cancel{2}\\cdot a & ≡\\cancel{2}\\cdot b &  & (\\text{mod}\\,\\cancel{2}\\cdot 4) \\\\ a & ≡b &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186415049 :knowledge-point/_questions [{:db/id #edb/ref 17592186152096 :knowledge-point/id #uuid "3822141e-3cea-5c34-b925-a522c2273335" :knowledge-point/title "Combining the Division Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411fcf4c-0dfe-5eb4-b277-2957160dccc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414950} {:answer/id #uuid "74b71bad-1c7b-5ec7-82dd-47d6ce2c7ca6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414967} {:answer/id #uuid "81d02ebf-0e9e-55cb-a573-4ae072ffecb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414972} {:answer/id #uuid "dfb5e76a-e012-5b9d-add1-ff7fc168f39c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415005} {:answer/id #uuid "ffca300c-7c35-5dd6-9629-dda4cf9c21da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415016}] :answer-field/correct {:answer/id #uuid "dfb5e76a-e012-5b9d-add1-ff7fc168f39c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415005} :answer-field/id #uuid "c26a95a5-c027-5bfd-8dc6-5ac33606e4cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415037}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca808cf3-f807-5d95-a81f-b5460b52df5b" :question/math-academy-id "q-213392" :question/problem "Given that $3a≡3b\\,(\\text{mod}\\,9),$ which of the following statements **must** be true?\n\nI. $a≡b\\,(\\text{mod}\\,3)$\n\nII. $a≡b\\,(\\text{mod}\\,9)$\n\nIII. $4a≡4b\\,(\\text{mod}\\,3)$" :question/worked-solution "The division properties of modular arithmetic state the following:\n\n- For $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\n- For $\\text{gcd}(k,n)=1,$ we have \n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWith that in mind, let's consider each statement.\n\n- Statement I is true, while statement II is false. Applying the first property, we have the following:\n\n$$\n\\begin{aligned}3a & ≡3b &  & (\\text{mod}\\,9) \\\\ 3\\cdot a & ≡3\\cdot b &  & (\\text{mod}\\,3\\cdot 3) \\\\ \\cancel{3}\\cdot a & ≡\\cancel{3}\\cdot b &  & (\\text{mod}\\,\\cancel{3}\\cdot 3) \\\\ a & ≡b &  & (\\text{mod}\\,3)\\end{aligned}\n$$\n\n- Statement III is true. By statement I and the second property, we have:\n\n$$\n\\begin{aligned}a≡b\\,(\\text{mod}\\,3)\\,⟺\\,4a≡4b\\,(\\text{mod}\\,3)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186415051 :knowledge-point/_questions [{:db/id #edb/ref 17592186152094 :knowledge-point/id #uuid "bca70f6c-d087-5b8e-aff2-581adca9ed1f" :knowledge-point/title "Using the First Division Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ad3b1aa-93e7-5b73-a4b4-ec7fb6b5d2f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414948} {:answer/id #uuid "9b4bf61e-6b83-5157-b763-8513937c1774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414983} {:answer/id #uuid "be01c4c9-9b6c-5fb4-b2ec-7c85edac2cfd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414996} {:answer/id #uuid "e0a31f1f-fd54-58eb-b1f3-5e9c47ac9da1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415006} {:answer/id #uuid "e7f12825-c2b7-5186-8218-7c940c5283cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415007}] :answer-field/correct {:answer/id #uuid "e7f12825-c2b7-5186-8218-7c940c5283cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415007} :answer-field/id #uuid "5139e167-eff8-5fb2-95ba-ff706a30c921" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d23e3ed0-5575-5880-b9bf-7ff1adfe9936" :question/math-academy-id "q-103168" :question/problem "Given that $3a≡3b\\,(\\text{mod}\\,12),$ which of the following statements **must** be true?\n\nI. $a≡b\\,(\\text{mod}\\,3)$\n\nII. $a≡b\\,(\\text{mod}\\,4)$\n\nIII. $a≡b\\,(\\text{mod}\\,6)$" :question/worked-solution "The division property of modular arithmetic states that for $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWe're asked to consider the following statement:\n\n$$\n3a≡3b\\,(\\text{mod}\\,12)\n$$\n\nNotice that $\\text{gcd}(3,12)=3.$\n\nApplying the division property, we have the following:\n\n$$\n\\begin{aligned}3a & ≡3b &  & (\\text{mod}\\,12) \\\\ 3\\cdot a & ≡3\\cdot b &  & (\\text{mod}\\,3\\cdot 4) \\\\ \\cancel{3}\\cdot a & ≡\\cancel{3}\\cdot b &  & (\\text{mod}\\,\\cancel{3}\\cdot 4) \\\\ a & ≡b &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186415061 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1688faeb-85ba-5d68-81e7-78a4a337f227" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415055} {:answer/id #uuid "7b430210-150a-5113-bb9e-9ceedc527951" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415056} {:answer/id #uuid "888ec5b1-c2ea-5a99-8c7a-f1ea5fd2dbc6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186415057} {:answer/id #uuid "a66c38ea-8581-5edc-9742-8946b8e3e270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415058} {:answer/id #uuid "f381c62f-1e63-5006-ba9d-a84a80c6800c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415059}] :answer-field/correct {:answer/id #uuid "7b430210-150a-5113-bb9e-9ceedc527951" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415056} :answer-field/id #uuid "f0e50222-5322-5dc6-95c0-87aed25c41a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415060}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c07b7ca-2c8b-5a74-a857-c6a369e5fb28" :question/math-academy-id "q-35580" :question/problem "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3},{v}_{4}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly dependent and ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent, which of the following statements are true?\n\n- ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has only zero solution ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0$\n- ${v}_{2}$ is a linear combination of ${v}_{1}$, ${v}_{3}$ and ${v}_{4}$\n- ${v}_{4}$ is a linear combination of ${v}_{1}$ and ${v}_{3}$" :question/worked-solution "Let's examine each of the given options in turn.\n\n- Statement I is false. Since ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly dependent set, we obtain that\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nhas a non-zero solution.\n\n- Statement II is true. Indeed, solving equation ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ for ${v}_{2},$ we obtain\n\n$$\n{v}_{2}=-\\frac{{x}_{1}}{{x}_{2}}{v}_{1}-\\frac{{x}_{3}}{{x}_{2}}{v}_{3}-\\frac{{x}_{4}}{{x}_{2}}{v}_{4}.\n$$\n\nMoreover, ${x}_{2}$ can't be zero because then\n\n$$\n{x}_{1}{v}_{1}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nwill have a non-zero solution and that's a contradiction as ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent.\nHence, ${v}_{2}$ is a linear combination of ${v}_{1}$, ${v}_{3}$ and ${v}_{4}.$\n\n- Statement III is false. Since the set ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent set, the equation \n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{3}+{x}_{3}{v}_{4}=0\n$$\n\nhas no non-zero solution. Hence, ${v}_{4}$ is not a linear combination of ${v}_{1}$ and ${v}_{3}$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186415272 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a9cbc7-f277-56ad-a34d-b1e67b9ccb79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415200} {:answer/id #uuid "4199a3f5-5c75-59ad-ae31-6dbe20749db3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415211} {:answer/id #uuid "7254ab02-972a-5fc3-af1e-ece583b386ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415224} {:answer/id #uuid "95a9fd1b-4296-5d3a-ad4e-a9e88dba336a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415235} {:answer/id #uuid "bed907e5-7397-570c-82dd-cbe5f3babe74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415243}] :answer-field/correct {:answer/id #uuid "7254ab02-972a-5fc3-af1e-ece583b386ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415224} :answer-field/id #uuid "65c1d218-3b72-5245-bad5-dd08cb553d78" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415261}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0027cfb5-d932-549f-8cc6-973642895e8d" :question/math-academy-id "q-125743" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{x}\\operatorname{sin}⁡y,\\,{e}^{x}\\operatorname{cos}⁡y⟩$ and the points $O(0,0)$ and $A(1,\\frac{\\pi }{2})$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nI. $F$ is conservative.\n\nII. ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=e,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$\n\nIII. ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{2}$ is the path along the curve $y=\\frac{\\pi }{2}\\sqrt{x},$ traversed from $O$ to $A.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{x}\\operatorname{cos}⁡y.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf={e}^{x}\\operatorname{sin}⁡y.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(1,\\frac{\\pi }{2})-f(0,0) \\\\  & ={e}^{1}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-{e}^{0}\\cdot \\operatorname{sin}⁡0 \\\\  & =e\\cdot 1-0 \\\\  & =e.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=e.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415275 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8bc88c-65ec-5ed0-861b-da4a28dd2e6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415207} {:answer/id #uuid "5d32c371-2553-5a69-82d8-90b81f6734fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415218} {:answer/id #uuid "6b142c8d-3eea-55c4-9289-bbf7b0018f9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415221} {:answer/id #uuid "878097e9-8b52-5d48-a250-9feb84ddeb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415227} {:answer/id #uuid "8d3bdd36-68bf-5e48-b9c0-a73c00b3435d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415232}] :answer-field/correct {:answer/id #uuid "878097e9-8b52-5d48-a250-9feb84ddeb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415227} :answer-field/id #uuid "d6f00848-516a-51d1-8994-e5331367e330" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415270}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41c787c2-8fe3-51ae-aef3-bfbcd04677ea" :question/math-academy-id "q-125720" :question/problem "Consider the vector field $F(x,y)=⟨y,\\,x⟩$ and the points $O(0,0)$ and $A(\\sqrt{2},2)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nI. $F$ is conservative.\n\nII. ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2\\sqrt{2},$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$\n\nIII. ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=-\\sqrt{2},$ where ${C}_{2}$ is the path along the curve $y={x}^{2},$ traversed from $O$ to $A.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=1.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf=xy.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(\\sqrt{2},2)-f(0,0) \\\\  & =\\sqrt{2}\\cdot 2-0\\cdot 0 \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=2\\sqrt{2}.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415281 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "036e6f03-ee36-5c5f-b814-7fbdad1c16c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415195} {:answer/id #uuid "789ac7c1-845d-586f-9c96-a1af50adc74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415225} {:answer/id #uuid "b090af4c-99bd-5025-98a2-d50859d47fe1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415240} {:answer/id #uuid "deac1bbc-f701-5baa-b26c-08f5a0fcebf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415253} {:answer/id #uuid "f1e8d299-71bd-546e-9566-9e1178edccba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186415257}] :answer-field/correct {:answer/id #uuid "789ac7c1-845d-586f-9c96-a1af50adc74b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415225} :answer-field/id #uuid "b08ccadb-6ec6-59d9-86d6-45aa650a0703" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef46b0f0-6f4c-53dd-b0f1-5e1b301fe037" :question/math-academy-id "q-125736" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{y},\\,x{e}^{y}⟩$ and the points $A(1,0)$ and $B(3,\\operatorname{ln}⁡3)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nI. $F$ is conservative.\n\nII. ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=8,$ where ${C}_{1}$ is the path along the curve $y=\\operatorname{ln}⁡(x),$ traversed from $A$ to $B.$\n\nIII. ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=3,$ where ${C}_{2}$ is the path along the line segment $\\overset{―}{AB},$ traversed from $A$ to $B.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{y}.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf=x{e}^{y}.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(3,\\operatorname{ln}⁡3)-f(1,0) \\\\  & =3\\cdot {e}^{\\operatorname{ln}⁡3}-1\\cdot {e}^{0} \\\\  & =3\\cdot 3-1 \\\\  & =8.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{2},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{2}}F\\cdot \\text{d}r=8.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415479 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d00532a-c12b-50b9-ad0b-b9f1fa474794" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186415449} {:answer/id #uuid "44173bde-0fab-57de-b1b3-22d94262de8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415452} {:answer/id #uuid "6b9c1118-9a19-54c3-9683-cf1248dd342b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186415456} {:answer/id #uuid "7e862f84-0fe3-5f4e-8829-b54fb65649ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415457} {:answer/id #uuid "e9cd19d7-7290-5199-aa60-b1bc0b2d73b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415464}] :answer-field/correct {:answer/id #uuid "e9cd19d7-7290-5199-aa60-b1bc0b2d73b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415464} :answer-field/id #uuid "e80361a1-690f-54bf-a979-055f8bec64f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415473}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8a11ae3-b740-5975-a251-a4796d69b742" :question/math-academy-id "q-43307" :question/problem "Let $A$ be a $3\\times 3$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\n- $A$ has a zero column\n- $A$ has two proportional rows\n- One of the rows/columns of $A$ is a linear combination of other rows/columns of $A$" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and II are false. For example, consider the matrix \n\n$$\nA=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 3\\end{aligned}].\n$$\n\nExpending across the $1$st column, we have that \n\n$$\n\\begin{aligned}|A| & =1\\cdot |\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}|+1|\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| \\\\  & =(3-2)+(1-2) \\\\  & =0\\end{aligned}\n$$\n\nbut $A$ has neither a zero column nor two proportional rows.\n\n- Statement III is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186416481 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c278b14-28c2-57de-b60a-2a720876d406" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416447} {:answer/id #uuid "5b060c6a-de3b-54b0-bfda-579bbdcbb6d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416451} {:answer/id #uuid "5ec6c063-a755-58f5-8636-29649c9e3395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416452} {:answer/id #uuid "7c2cf85b-73a0-5874-97a9-cfa33e64d6b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416455} {:answer/id #uuid "e71d59cc-b53d-52ee-9d28-5a2450433b8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416469}] :answer-field/correct {:answer/id #uuid "5ec6c063-a755-58f5-8636-29649c9e3395" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416452} :answer-field/id #uuid "389a199b-2132-5200-92d1-2261a44348a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5650e0d2-585c-5516-892d-5eacef061cb2" :question/math-academy-id "q-95266" :question/problem "Which of the following statements are true?\n\n- Any $2\\times 3$ matrix $A$ has at most $2$ distinct singular values.\n- The matrix $A=[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]$ has one negative singular value.\n- Any $5\\times 3$ matrix $A$ has at most $3$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $2\\times 3$ matrix and ${A}^{T}$ is a $3\\times 2$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 2}\\times {A}_{2\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is true. Since $A$ is a $5\\times 3$ matrix and ${A}^{T}$ is a $3\\times 5$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 5}\\times {A}_{5\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186416485 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d306b2f-e020-5c0b-8b36-318a141afa1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416448} {:answer/id #uuid "884aa6f5-9cee-5d6c-a6d2-1e3e9fda993d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416458} {:answer/id #uuid "c41c10ba-d192-5a1a-9031-b8c0dab1e30f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416465} {:answer/id #uuid "d11ab6aa-4e8f-5b94-8bb5-66fd5a8105bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186416467} {:answer/id #uuid "f351ce40-cb01-5b7d-a5fb-a7f513b6a235" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416473}] :answer-field/correct {:answer/id #uuid "4d306b2f-e020-5c0b-8b36-318a141afa1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416448} :answer-field/id #uuid "f8cda2f1-5552-5357-82cc-f1ab61cac36e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416480}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e69dd032-aa5c-5891-a7fc-97b84703e88a" :question/math-academy-id "q-95261" :question/problem "Which of the following statements are true?\n\n- Any $4\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n- The singular values of the matrix $A=[\\begin{aligned}2 & 1 \\\\ -2 & -3\\end{aligned}]$ are non-negative.\n- Any $3\\times 4$ matrix $A$ has at most $3$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since $A$ is a $4\\times 3$ matrix and ${A}^{T}$ is a $3\\times 4$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 4}\\times {A}_{4\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is true. All singular values of any matrix are non-negative.\n\n- Statement III is false. Since $A$ is a $3\\times 4$ matrix and ${A}^{T}$ is a $4\\times 3$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 3}\\times {A}_{3\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186416486 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4727adce-5afb-5a6e-baec-86299311d447" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186416444} {:answer/id #uuid "4ab592cf-fe9a-5d31-b42c-37ad02aab55a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186416446} {:answer/id #uuid "862c188a-6765-5375-b045-c13862731467" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186416456} {:answer/id #uuid "9d9dee5f-cd09-5188-9a3c-cde7f4e68a37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186416461} {:answer/id #uuid "f25d7873-4bce-5acd-bc01-3466707919a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416472}] :answer-field/correct {:answer/id #uuid "f25d7873-4bce-5acd-bc01-3466707919a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186416472} :answer-field/id #uuid "d97b8052-bb1d-524c-878a-c0e3b532b8c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186416479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fef86daf-091a-52fa-bcf0-1d2b609bb348" :question/math-academy-id "q-95281" :question/problem "Which of the following statements are true?\n\n- Any $6\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n- The matrix $A=[\\begin{aligned}-1 & -1 \\\\ -1 & -2\\end{aligned}]$ has one negative singular value.\n- Any $4\\times 5$ matrix $A$ has at most $4$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is false. Since $A$ is a $4\\times 5$ matrix and ${A}^{T}$ is a $5\\times 4$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 4}\\times {A}_{4\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186417219 :knowledge-point/_questions [{:db/id #edb/ref 17592186119926 :knowledge-point/id #uuid "19c33c51-bf11-5a81-a0fd-8381d8e0b9d7" :knowledge-point/title "Determining Whether a Line Is a Subspace of Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44a4e1dc-a2d7-5163-8db3-bd5e766783de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417213} {:answer/id #uuid "5175130c-a0e7-5993-877f-e784135b6082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186417214} {:answer/id #uuid "7d69583b-f76a-5611-8cb8-4022da72fc78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186417215} {:answer/id #uuid "99e8273a-2cc4-5606-ade8-2988cc10652d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417216} {:answer/id #uuid "a149c6f5-ef3c-51ad-997e-db08bfab777c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186417217}] :answer-field/correct {:answer/id #uuid "5175130c-a0e7-5993-877f-e784135b6082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III only" :db/id #edb/ref 17592186417214} :answer-field/id #uuid "7336d919-b96c-5024-ae89-e9caaf4e41d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feee3179-e7d1-55ab-bcac-f334cca10495" :question/math-academy-id "q-156620" :question/problem "Let $L$ be the line with equation $4x=2y$ in ${R}^{2}.$ Which of the following statements are true?\n\n- $L$ contains the zero-vector\n- $L$ is closed under vector addition\n- $L$ is closed under scalar multiplication\n- $L$ is **not** a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x \\\\ 2x\\end{aligned}],\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The coordinates of the zero-vector satisfy the equation $4x=2y:$\n\n$$\n\\begin{aligned}4x & =2y \\\\ 4(0) & =2(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}a \\\\ 2a\\end{aligned}]\\in L$ and $b=[\\begin{aligned}b \\\\ 2b\\end{aligned}]\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}a \\\\ 2a\\end{aligned}]+[\\begin{aligned}b \\\\ 2b\\end{aligned}]=[\\begin{aligned}a+b \\\\ 2a+2b\\end{aligned}]=[\\begin{aligned}a+b \\\\ 2(a+b)\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $4x=2y.$ Therefore, $a+b\\in L.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}a \\\\ 2a\\end{aligned}]\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}a \\\\ 2a\\end{aligned}]=[\\begin{aligned}ka \\\\ k(2a)\\end{aligned}]=[\\begin{aligned}ka \\\\ 2(ka)\\end{aligned}],\\end{aligned}\n$$\n\n \nwhich satisfies the condition $4x=2y.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement IV is false. Since statements II and III are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186417703 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64373e5d-5dd7-5b8c-997e-b1a1d51821a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417686} {:answer/id #uuid "7ed9e009-1eed-587e-99c2-a5c90a12f34a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417688} {:answer/id #uuid "bd086813-aae0-5b88-80fb-38d4e70fa634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417692} {:answer/id #uuid "f5946256-8005-5d78-9fdf-0e9f112f6155" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417697} {:answer/id #uuid "fd2228ec-39b9-5ba7-96a0-e30dc0202e32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417699}] :answer-field/correct {:answer/id #uuid "bd086813-aae0-5b88-80fb-38d4e70fa634" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417692} :answer-field/id #uuid "2afbf87d-1c06-55f7-9a1b-f8b6764e8f1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417701}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0464e7a7-ce22-55cd-90ec-4b6a71a12079" :question/math-academy-id "q-38893" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T(x)=v$ has no solution? \n\n- $T$ is invertible\n- $\\text{Ker}(T)\\ne {0}$\n- $\\text{nullity}(T)=0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T(x)=v$ has no solution, we have that $v\\notin \\text{Im}(T),$ hence $\\text{Im}(T)\\ne {R}^{5}.$ According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{5},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement II is true. Since $T$ is not invertible, the invertible matrix theorem implies that  $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186417816 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18dc53b3-03ab-5649-8fb0-de461024a5e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417787} {:answer/id #uuid "1b2bf559-c6e4-56a2-a728-3d0c5adf819f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417788} {:answer/id #uuid "3f689a2a-f4e1-53c0-8a22-5936c1c9857a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186417791} {:answer/id #uuid "a71b86c9-6729-5559-b5d7-43ee35ceae47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417800} {:answer/id #uuid "a91a4cd9-65c4-5d08-a8a1-36ab03b7d971" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417801}] :answer-field/correct {:answer/id #uuid "1b2bf559-c6e4-56a2-a728-3d0c5adf819f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417788} :answer-field/id #uuid "a5bc6201-b1a5-5eb7-b325-cd8c3c42ef38" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e4c0564-b5b1-55bc-bc17-3dffa3a951a9" :question/math-academy-id "q-158601" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y<-1},\\,∂A={(x,y)\\in {R}^{2}:y=-1}.\n$$\n\nWhich of the following statements are true?\n\n- The point $P(1,-1)$ lies on the boundary of $A$\n- The point $P(1,-1)$ belongs to $A$\n- The point $Q(2,0)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie below the line $y=-1.$ A sketch of this region is shown below:\n\n![](images/75/75d5d199d12cc2f3170822a40c52762fcc8368caac26a8134661f9ac72ab462b.png)\n\nLet's add the points $P(1,-1)$ and $Q(2,0)$ and some neighborhoods of these points to our diagram.\n\n![](images/81/818da293be040897d3a536b396d6fe7ff992f3d91f976301e14a6253356b5bde.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(1,-1)$ satisfy $y=-1.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is false. The coordinates of $P(-1,1)$ do not satisfy the inequality $y<-1.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement III is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I only.'"}] [{:db/id #edb/ref 17592186417817 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16604d5a-129d-54c3-83f1-2dbdb9c13b77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186417786} {:answer/id #uuid "40d9eb9a-aabc-5cf9-8235-dc55fba04a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417793} {:answer/id #uuid "472664cf-4eed-5797-99be-1d353c048466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186417794} {:answer/id #uuid "70e7043b-4a4b-5f86-9660-b7c6a4edac74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186417797} {:answer/id #uuid "ff04d84b-3945-56d8-abdb-c06778ca1398" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186417809}] :answer-field/correct {:answer/id #uuid "40d9eb9a-aabc-5cf9-8235-dc55fba04a52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186417793} :answer-field/id #uuid "e9aa40d2-6ab6-5496-ab09-1db4a0c06d75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186417814}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dbe53a96-4c4c-5897-ba48-d4861ec6cb49" :question/math-academy-id "q-158547" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y>2x-3},\\,∂A={(x,y)\\in {R}^{2}:y=2x-3}.\n$$\n\nWhich of the following statements are true?\n\n- The point $P(1,-1)$ lies on the boundary of $A$\n- The point $Q(0,0)$ belongs to $A$\n- The point $Q(0,0)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie above the line $y=2x-3.$ A sketch of this region is shown below:\n\n![](images/5a/5af40a400e5ea4942a1cf89b09184a277df96d252e4a7fee41bd2df7024a631f.png)\n\nLet's add the points $P(1,-1)$ and $Q(0,0)$ and some neighborhoods of these points to our diagram.\n\n![](images/27/27b978864eac65c93c7886b2d54dfede7130f0f93a16ef96421cd0e5741a6940.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(1,-1)$ satisfy $y=2x-3.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. Indeed, the coordinates of $Q(0,0)$ satisfy the inequality $y>2x-3.$ Hence, $Q$ lies in the set $A.$\n\n- Statement III is true. Indeed, there exists an open neighborhood of $Q$ that is entirely contained inside the set $A.$\n\nTherefore, the correct answer is 'I, II, and III.'"}] [{:db/id #edb/ref 17592186418155 :knowledge-point/_questions [{:db/id #edb/ref 17592186162016 :knowledge-point/id #uuid "c94ec9c4-650f-5d39-9294-651b03b172bf" :knowledge-point/title "Identifying True Statements Regarding Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "766d0c5a-5abc-5b7d-9ced-05213b2666d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186418110} {:answer/id #uuid "7718b520-dda1-5f3a-bc7b-0d6b3cb9898b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186418111} {:answer/id #uuid "99ad27ff-65f7-5f3d-abde-578637efa421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418123} {:answer/id #uuid "ad41e705-b0fd-57cc-9d10-850ea2d27a07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186418125} {:answer/id #uuid "edad4670-ba38-528d-afdc-042641739a6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186418138}] :answer-field/correct {:answer/id #uuid "99ad27ff-65f7-5f3d-abde-578637efa421" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418123} :answer-field/id #uuid "deb04f7a-e9c5-545a-b755-ad9c8bf9de09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418150}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d3ee109-94d4-53ed-8971-ac2ef97dce27" :question/math-academy-id "q-95901" :question/problem "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $3\\times 4$ matrix, which of the following statements are true?\n\n- $Σ$ is a $4\\times 4$ matrix\n- $V$ is an orthogonal $4\\times 4$ matrix\n- $U$ is a diagonal matrix" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $3\\times 4$ matrix, $Σ$ must be a $3\\times 4$ matrix.\n\n- Statement II is true. Indeed, since $A$ is a $3\\times 4$ matrix,the matrix $V$ in the singular value decomposition $UΣ{V}^{T}$ must be orthogonal $4\\times 4$ matrix.\n\n- Statement III is false. The matrix $U$ must be orthogonal but not necessarily diagonal.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186418768 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2c0c306-a99a-558a-be4a-efd202ff8369" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186418751} {:answer/id #uuid "a60eb3ab-afb3-5fa3-81f8-2c88c661879b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186418752} {:answer/id #uuid "b53d73b5-cdbe-5038-ac9f-f388bc73961d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186418753} {:answer/id #uuid "bc85a2f4-6927-58bb-a2be-eaa0257991e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186418754} {:answer/id #uuid "d7996a02-da25-5836-9723-3f3bd4f67f7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418759}] :answer-field/correct {:answer/id #uuid "d7996a02-da25-5836-9723-3f3bd4f67f7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186418759} :answer-field/id #uuid "e0664c98-aa8f-5458-ad72-e93d50a1082f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186418763}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac83e377-f632-58f6-8bed-4004335968a6" :question/math-academy-id "q-80514" :question/problem "For the vector $u=[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}]$ which of the following statements are true?\n\n- $u⊥H,\\,$ where $H={[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}],[\\begin{aligned}-1 \\\\ -2 \\\\ 1\\end{aligned}]}$\n- $u⊥V,\\,$ where $V={[\\begin{aligned}3 \\\\ 2 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 3 \\\\ \\frac{5}{4}\\end{aligned}]}$\n- $u⊥W,\\,$ where $W={[\\begin{aligned}0 \\\\ 4 \\\\ 3\\end{aligned}],[\\begin{aligned}4 \\\\ 0 \\\\ -2\\end{aligned}],[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}]}$" :question/worked-solution "Let's denote the vectors of $H,V$ and $W$ as ${{h}_{1},{h}_{2}},{{v}_{1},{v}_{2}}$ and ${{w}_{1},{w}_{2},{w}_{3}}$, respectively.  \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $H:$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =(-2)\\cdot 2+3\\cdot 0+(-4)\\cdot (-1)=0 & ✓ \\\\ u\\cdot {h}_{2} & =(-2)\\cdot (-1)+3\\cdot (-2)+(-4)\\cdot 1=-8\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸H.$\n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =(-2)\\cdot 3+3\\cdot 2+(-4)\\cdot 0=0 & ✓ \\\\ u\\cdot {v}_{2} & =(-2)\\cdot 2+3\\cdot 3+(-4)\\cdot \\frac{5}{4}=0 & ✓\\end{aligned}\n$$\n\nSo, $u⊥V.$\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =(-2)\\cdot 0+3\\cdot 4+(-4)\\cdot 3=0 & ✓ \\\\ u\\cdot {w}_{2} & =(-2)\\cdot 4+3\\cdot 0+(-4)\\cdot (-2)=0 & ✓ \\\\ u\\cdot {w}_{3} & =(-2)\\cdot 1+3\\cdot (-1)+(-4)\\cdot (-2)=3\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸W.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186419017 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d16442d-19e4-582c-8e49-f56bc5ac7989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419011} {:answer/id #uuid "8c4765c6-63f6-569c-bd76-1517cf62b38c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II, III and IV only" :db/id #edb/ref 17592186419012} {:answer/id #uuid "91c67dbf-ae46-5cea-83af-1664e56a1941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419013} {:answer/id #uuid "eb70dc47-8da4-592d-92b1-cbf8738afc59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419014} {:answer/id #uuid "fea9db8f-ed00-5f80-923f-1ea3dcb8fe89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186419015}] :answer-field/correct {:answer/id #uuid "6d16442d-19e4-582c-8e49-f56bc5ac7989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419011} :answer-field/id #uuid "e6809d48-fda2-518b-8b59-a579c69de413" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419016}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b47df0de-b5ee-5562-b36a-a659cbe48d85" :question/math-academy-id "q-125796" :question/problem "Consider the vector field $F(x,y)=⟨-y,\\,x⟩$ and the points $A(0,1)$ and $B(0,-1)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nI. ${\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne 0,$ where ${C}_{1}$ is the path along the circle ${x}^{2}+{y}^{2}=1,$ traversed from $A$ to $B$ in counterclockwise direction.\n\nII. ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=0,$ where ${C}_{2}$ is the path along the segment line $\\overset{―}{AB},$ traversed from $A$ to $B.$\n\nIII. ${\\int }_{C}F\\cdot \\text{d}r$ is independent of path.\n\nIV. $F$ is conservative." :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Parameterizing the curve, we have\n\n$$\n{r}_{1}(t)=⟨\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,t\\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}⟨-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩\\cdot ⟨-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}{sin}^{2}⁡t+{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}1\\,\\text{d}t \\\\  & =t{|}_{\\pi /2}^{3\\pi /2} \\\\  & =\\frac{3\\pi }{2}-\\frac{\\pi }{2} \\\\  & =\\pi  \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement II is true. Parameterizing the line segment, we have\n\n$$\n{r}_{2}(t)=⟨0,\\,1-2t⟩,\\,t\\in [0,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}⟨2t-1,\\,0⟩\\cdot ⟨0,\\,-2⟩\\text{d}t \\\\  & ={\\int }_{0}^{1}0\\,\\text{d}t \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is false. Since ${C}_{1}$ and ${C}_{2}$ have the same initial and terminal points, yet\n\n$$\n{\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne {\\int }_{{C}_{2}}F\\cdot \\text{d}r,\n$$\n\nwe conclude that ${\\int }_{C}F\\cdot \\text{d}r$ is path-dependent.\n\n- Statement IV is false. If a vector field is conservative then it is path-independent. Since $F$ is path-dependent, it is not conservative."}] [{:db/id #edb/ref 17592186419635 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51ed1169-4dcb-5651-bbbd-c7b884f63478" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419610} {:answer/id #uuid "5eef336e-d43f-594c-8c6c-e0250235815a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419612} {:answer/id #uuid "85e9b13d-72c1-546a-b6fc-eafc300cdb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419617} {:answer/id #uuid "965cecae-b949-5417-b3cc-5e430c2f2b6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419619} {:answer/id #uuid "e5f886d7-3b46-5e40-b8ea-797128add774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419624}] :answer-field/correct {:answer/id #uuid "85e9b13d-72c1-546a-b6fc-eafc300cdb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419617} :answer-field/id #uuid "5b9776a6-3e68-58ea-b6e5-5ee338447367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419630}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c37fbba7-25b2-5279-9899-188d8dedca8a" :question/math-academy-id "q-103380" :question/problem "Which of the following statements are true?\n\n- $-7≡27\\,(\\text{mod}\\,5)$\n- $-5≡15\\,(\\text{mod}\\,6)$\n- $11≡18\\,(\\text{mod}\\,7)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $5∤(-7-27).$ Notice that $-7-27=-34,$ which is not divisible by $5.$\n\n- Statement II is false because $6∤(-5-15).$ Notice that $-5-15=-20,$ which is not divisible by $6.$\n\n- Statement III is true because $7\\,|\\,(11-18).$ There is no remainder:\n\n$$\n(11-18)÷7=-7÷7=-1\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186419636 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bc1a27e-8427-57e6-ac2e-b947a4b1556a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419603} {:answer/id #uuid "7a197d0d-9913-5fb2-bf3c-4835cbe300af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419614} {:answer/id #uuid "7d9d3ee8-5a6d-521f-b277-71c7303fe530" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186419615} {:answer/id #uuid "8a94c9aa-c1e4-5350-85e8-39c118369fb4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419618} {:answer/id #uuid "c959a564-e622-5a0d-8e5b-fc810aa60b43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186419622}] :answer-field/correct {:answer/id #uuid "0bc1a27e-8427-57e6-ac2e-b947a4b1556a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419603} :answer-field/id #uuid "3da5eb72-bc77-5ebc-a47a-3006549126c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419629}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9350880-d00e-5d41-adb3-52fc6c8e0846" :question/math-academy-id "q-113664" :question/problem "Which of the following statements are true?\n\n- $-5≡8\\,(\\text{mod}\\,7)$\n- $-23≡-5\\,(\\text{mod}\\,6)$\n- $-7≡-1\\,(\\text{mod}\\,2)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-5-8).$ Notice that $-5-8=-13,$ which is not divisible by $7.$\n\n- Statement II is true because $6∣(-23-(-5)).$ There is no remainder:\n\n$$\n(-23-(-5))÷6=-18÷6=-3\n$$\n\n- Statement III is true because $2\\,|\\,(-7-(-1)).$ There is no remainder:\n\n$$\n(-7-(-1))÷2=-6÷2=-3\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186419637 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14749e55-fcd9-5cab-b71b-ab77bde17dca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186419604} {:answer/id #uuid "31c492b8-531d-5421-96e8-37acf0421d51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419607} {:answer/id #uuid "436c60b7-f2a7-5cc5-ada7-157322f4a843" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419608} {:answer/id #uuid "98edc3ec-d794-589b-8439-5ef103206375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419620} {:answer/id #uuid "fe6cf5ba-4043-5780-8f58-4c07333d4125" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419627}] :answer-field/correct {:answer/id #uuid "98edc3ec-d794-589b-8439-5ef103206375" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419620} :answer-field/id #uuid "7adb391f-ba37-5aef-9e23-79d9c1428c63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419632}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee3460a5-a9ce-5793-8247-ccd3db242273" :question/math-academy-id "q-113675" :question/problem "Which of the following statements are true?\n\n- $-36≡-19\\,(\\text{mod}\\,7)$\n- $15≡-26\\,(\\text{mod}\\,10)$\n- $-27≡9\\,(\\text{mod}\\,4)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-36-(-19)).$ Notice that $-36-(-19)=-17,$ which is not divisible by $7.$\n\n- Statement II is false because $10∤(15-(-26)).$ Notice that $15-(-26)=41,$ which is not divisible by $10.$\n\n- Statement III is true because $4\\,|\\,(-27-9).$ There is no remainder:\n\n$$\n(-27-9)÷4=-36÷4=-9\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186419686 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12910645-377d-54ef-bc0b-422296caf8f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186419661} {:answer/id #uuid "2090546c-8891-5b10-af98-9204905ac08a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186419662} {:answer/id #uuid "27f9e9c7-23c3-5ee6-82bd-1ed602f60cb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186419664} {:answer/id #uuid "39e6d5c4-ef80-5978-98b7-b10c7c9e811a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186419665} {:answer/id #uuid "da77cae2-0a6d-576c-9bbf-669849034a2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186419677}] :answer-field/correct {:answer/id #uuid "2090546c-8891-5b10-af98-9204905ac08a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186419662} :answer-field/id #uuid "14b5fd09-d567-55da-9493-1ac629b8d62a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186419679}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e737a421-d643-51f0-9d67-b9556fcc15c6" :question/math-academy-id "q-97060" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\n- $[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$\n- $[T]_{C}={P}_{B\\to C}^{-1}\\cdot [T]_{B}\\cdot {P}_{B\\to C}$\n- $[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420071 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17d5b6db-f2d7-57e8-a2a5-1d92b46e0512" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186420031} {:answer/id #uuid "60887104-df4a-53c7-a034-7138745e6c35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420036} {:answer/id #uuid "75e38757-7df1-5cf4-b8a8-25b31d2f0338" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420038} {:answer/id #uuid "afaa078f-f8ba-5d53-96fa-429e2e0695f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420048} {:answer/id #uuid "e34f1333-ff13-539f-98a3-6487bacbdcd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420056}] :answer-field/correct {:answer/id #uuid "e34f1333-ff13-539f-98a3-6487bacbdcd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420056} :answer-field/id #uuid "96a743b7-fda2-51fe-bfdd-1a87d90bbfe6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420066}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48fbd1ea-16f2-572a-98a1-c1983af51b24" :question/math-academy-id "q-221923" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\n- $3∣(14x+21y)$\n- $7∣(14x+21y)$\n- $4∣(14x+21y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \n\nWith that in mind, let's examine our statement in turn.\n\n- Statement I is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $3.$\n\n- Statement II is true. Notice that \n\n$$\n14x+21y=7(2x+3y).\n$$\n\nSince $x$ and $y$ are integers, $2x+3y$ must be an integer, too. So, $7∣(14x+21y).$\n\n- Statement III is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186420072 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1da65dc0-01b4-5b68-9fb5-2b24392ab3e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420032} {:answer/id #uuid "7d0c5418-7d81-5d69-80db-f47bba1fe715" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420040} {:answer/id #uuid "81fb3c0b-8063-5f9d-b742-0b572de22bc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186420042} {:answer/id #uuid "8e5ebb79-57bf-59e0-84ab-0b8b6661babd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420044} {:answer/id #uuid "cfef5e04-f733-5d5c-8a6b-71ad9b16f171" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420054}] :answer-field/correct {:answer/id #uuid "cfef5e04-f733-5d5c-8a6b-71ad9b16f171" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420054} :answer-field/id #uuid "39c81008-53e2-57d5-9021-9e6bc5fda77a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420060}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63936aa1-e722-5014-a82a-6fe76f4b851d" :question/math-academy-id "q-221929" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\n- $2$ divides $(6x-18y)$\n- $3$ divides $(6x-18y)$\n- $5$ divides $(6x-18y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \nWith that in mind, let's examine our statement in turn.\n\n- Statement I is true. Notice that \n\n$$\n6x-18y=2(3x-9y).\n$$\n\nSince $x$ and $y$ are integers, $3x-9y$ must be an integer, too. So, $2$ divides $(6x-18y).$\n\n- Statement II is true. Notice that \n\n$$\n6x-18y=3(2x-6y).\n$$\n\nSince $x$ and $y$ are integers, $2x-6y$ must be an integer, too. So, $3$ divides $(6x-18y).$\n\n- Statement III is false. For example, if $x=2$ and $y=1,$ we have $6(2)-18(1)=-6,$ which is not divisible by $5.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420258 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37d1ed1f-2a27-5962-9f76-7e68504f6b25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420198} {:answer/id #uuid "92f86242-b5e9-5e13-99b0-1f387aeb933c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420220} {:answer/id #uuid "a873a377-31d6-5d14-bc3d-af2b01b12bb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186420223} {:answer/id #uuid "d6e70fa3-3d87-548c-a566-669bf0527f26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186420232} {:answer/id #uuid "f5c3abe4-7795-5469-8fa0-9b120fc335e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420242}] :answer-field/correct {:answer/id #uuid "37d1ed1f-2a27-5962-9f76-7e68504f6b25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420198} :answer-field/id #uuid "a4feefa3-f467-563c-b592-67d4467afe30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24815c66-50ab-5aab-ac7b-25ddc673e132" :question/math-academy-id "q-221381" :question/problem "Which of the following statements are true?\n\nI. If $11∣k$ then $33∣k$\n\nII. If $33∣k$ then $11∣k$\n\nIII. If $33∣k$ then $3∣k$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is false. As a counterexample, let $k=11.$ Then, $11∣11$ but $33∤11.$\n\n- Statement II is true. First, note that $11∣33.$ Therefore, we have\n$11∣33$ and $33∣k,$ which implies that $11∣k.$\n\n- Statement III is true. First, note that $3∣33.$ Therefore, we have\n$3∣33$ and $33∣k,$ which implies that $3∣k.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420260 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25938baa-529b-5f86-828c-2801671fe4d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186420192} {:answer/id #uuid "3cabb55e-40d7-5b81-a1ac-1144923f9b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420200} {:answer/id #uuid "550ce662-95ae-5c42-94f7-d6898e204e74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420205} {:answer/id #uuid "7760ef9f-a800-540a-87c6-3414de29afe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420216} {:answer/id #uuid "df951e81-7965-5468-a3e1-c106088a53a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420238}] :answer-field/correct {:answer/id #uuid "df951e81-7965-5468-a3e1-c106088a53a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420238} :answer-field/id #uuid "dfb4bbf3-86cf-55ec-89a8-e2c06957f446" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420254}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42a248b1-4b2a-5a7f-b673-589ac28da9a8" :question/math-academy-id "q-93649" :question/problem "Which of the following statements are true?\n\nI. If $10\\,|\\,21b$ then $10\\,|\\,b$\n\nII. If $21\\,|\\,25b$ then $21\\,|\\,b$\n\nIII. If $15\\,|\\,9b$ then $15\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(10,21)=1.$ Therefore, we have $10\\,|\\,21b$ and $\\text{gcd}(10,21)=1,$ which implies $10\\,|\\,b.$\n\n- Statement II is true. First, note that $\\text{gcd}(21,25)=1.$ Therefore, we have $21\\,|\\,25b$ and $\\text{gcd}(21,25)=1,$ which implies $21\\,|\\,b.$\n\n- Statement III is false. As a counterexample, let $b=5.$ Then, $15∣9\\cdot 5$ but $15∤5.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420261 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06c38ff4-4134-5851-a52f-d46fca4ccc12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420186} {:answer/id #uuid "142f0a78-ef1b-5c40-b87c-2e4e6e998e29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420190} {:answer/id #uuid "28a1ea30-a1c0-5800-8caf-4ea2604323dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420193} {:answer/id #uuid "5bd1e956-1cac-5094-a64b-65c5d077b526" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420207} {:answer/id #uuid "afdca230-1900-5d05-8b30-94bc667faa97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186420227}] :answer-field/correct {:answer/id #uuid "06c38ff4-4134-5851-a52f-d46fca4ccc12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420186} :answer-field/id #uuid "25f31e32-b105-56ba-945b-18f1eba552b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420245}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "553ed68f-8e74-5dda-a8b3-cdd3e89c31cb" :question/math-academy-id "q-93650" :question/problem "Which of the following statements are true?\n\nI. If ${19}^{2}\\,|\\,19b$ then ${19}^{2}\\,|\\,b$\n\nII. If $12\\,|\\,35b$ then $12\\,|\\,b$\n\nIII. If $22\\,|\\,{7}^{2}b$ then $22\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is false. As a counterexample, let $b=19.$ Then, ${19}^{2}∣19\\cdot 19$ but ${19}^{2}∤19.$\n\n- Statement II is true. First, note that $\\text{gcd}(12,35)=1.$ Therefore, we have $12\\,|\\,35b$ and $\\text{gcd}(12,35)=1,$ which implies $12\\,|\\,b.$\n\n- Statement III is true. First, note that $\\text{gcd}(22,{7}^{2})=1.$ Therefore, we have $22\\,|\\,{7}^{2}b$ and $\\text{gcd}(22,{7}^{2})=1,$ which implies $22\\,|\\,b.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420262 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144822ca-c64b-5d44-988e-8d3f58310385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420191} {:answer/id #uuid "6b662c83-9382-549d-b78f-d6ae45b36298" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420214} {:answer/id #uuid "ae35d862-ca5e-5f85-a3fd-da77890fb2a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186420225} {:answer/id #uuid "afc58b19-6e0c-5559-867b-c0befae68830" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420226} {:answer/id #uuid "da7300a2-932d-5ccd-b80e-d390c021dccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420234}] :answer-field/correct {:answer/id #uuid "da7300a2-932d-5ccd-b80e-d390c021dccf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420234} :answer-field/id #uuid "f237d89a-f9be-5d52-a1df-add8fdc50be1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420255}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ddd359d-678b-53c8-9991-000fcf922944" :question/math-academy-id "q-93657" :question/problem "Which of the following statements are true?\n\nI. If $3\\,|\\,a$ and $2\\,|\\,a$ then $6\\,|\\,a$\n\nII. If $7\\,|\\,b$ and $14\\,|\\,b$ then $98\\,|\\,b$\n\nIII. If ${2}^{3}\\,|\\,c$ and $3\\,|\\,c$ then $24\\,|\\,c$" :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(2,3)=1$ and $2\\cdot 3=6.$ Therefore, we have $(2\\,|\\,a),(3\\,|\\,a),$ and $\\text{gcd}(2,3)=1,$ which implies $(6\\,|\\,a).$\n\n- Statement II is false. As a counterexample, let $b=14.$ Then, $(7∣14)$ and $(14∣14),$ but $(98∤14).$\n\n- Statement III is true. First, note that $\\text{gcd}({2}^{3},3)=1$ and ${2}^{3}\\cdot 3=24.$ Therefore, we have $({2}^{3}\\,|\\,c),(3\\,|\\,c),$ and $\\text{gcd}({2}^{3},3)=1,$ which implies $(24\\,|\\,c).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420264 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cbae4e4-2423-5869-9afa-da82e1b33b03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420188} {:answer/id #uuid "63d2cb0f-4fa8-5c73-8c7f-8dfd3f5884fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186420211} {:answer/id #uuid "9f28d17f-a614-54b1-8f45-4295cb2a9f09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186420221} {:answer/id #uuid "c915309d-8abd-5446-a1f9-f241c7dc3116" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420228} {:answer/id #uuid "ec1d996a-1c8d-5142-913e-181d70bfe766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420240}] :answer-field/correct {:answer/id #uuid "0cbae4e4-2423-5869-9afa-da82e1b33b03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420188} :answer-field/id #uuid "9800a386-864d-5b89-9fa0-d8050a82fd2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420248}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d7153a0-178f-57d1-b332-d3ea8e076028" :question/math-academy-id "q-93658" :question/problem "Which of the following statements are true?\n\nI. If $4\\,|\\,a$ and $9\\,|\\,a$ then $36\\,|\\,a$\n\nII. If $5\\,|\\,b$ and $7\\,|\\,b$ then $35\\,|\\,b$\n\nIII. If ${6}^{2}\\,|\\,c$ and $2\\,|\\,c$ then $72\\,|\\,c$" :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(4,9)=1$ and $4\\cdot 9=36.$ Therefore, we have $(4\\,|\\,a),(9\\,|\\,a),$ and $\\text{gcd}(4,9)=1,$ which implies $(36\\,|\\,a).$\n\n- Statement II is true. First, note that $\\text{gcd}(5,7)=1$ and $5\\cdot 7=35.$ Therefore, we have $(5\\,|\\,b),(7\\,|\\,b),$ and $\\text{gcd}(5,7)=1,$ which implies $(35\\,|\\,b).$\n\n- Statement III is false. As a counterexample, let $c=36.$ Then, $({6}^{2}∣36)$ and $(2∣36),$ but $(72∤36).$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420265 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e1582c6-f975-57a2-bb84-29de70274193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420196} {:answer/id #uuid "5d34d488-7731-54e1-adee-10ba7466acca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420208} {:answer/id #uuid "6b4b7a2b-3e52-5afd-8b75-c581575d9429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420213} {:answer/id #uuid "86a84e34-cc31-5936-aa5b-9bcfb65473f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420218} {:answer/id #uuid "a39f6118-e6af-5c4f-b439-8c10db5598d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420222}] :answer-field/correct {:answer/id #uuid "6b4b7a2b-3e52-5afd-8b75-c581575d9429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420213} :answer-field/id #uuid "185758a4-16ad-57b8-bf67-872651eda925" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73c135de-ad71-58aa-a780-c01d04341240" :question/math-academy-id "q-221379" :question/problem "Which of the following statements are true?\n\nI. If $12∣h$ then $4∣h$\n\nII. If $4∣h$ then $2∣h$\n\nIII. If $3∣h$ then $12∣h$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $4∣12.$ Therefore, we have\n$4∣12$ and $12∣h,$ which implies that $4∣h.$\n\n- Statement II is true. First, note that $2∣4.$ Therefore, we have\n$2∣4$ and $4∣h,$ which implies that $2∣h.$\n\n- Statement III is false. As a counterexample, let $h=3.$ Then, $3∣3$ but $12∤3.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420269 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47123b5a-4d9e-5980-b7e8-1b9b31e1fa9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420201} {:answer/id #uuid "8d1afd65-b437-5472-b418-2dc1d6ebe865" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420219} {:answer/id #uuid "a964c9b7-bccb-5c9b-b3c7-48de44c00f07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I,II, and III" :db/id #edb/ref 17592186420224} {:answer/id #uuid "dcb9bd8f-1205-50c0-a72f-14df58d7f13a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420235} {:answer/id #uuid "e26579ec-ded1-5c35-9155-e69045a20a37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420239}] :answer-field/correct {:answer/id #uuid "dcb9bd8f-1205-50c0-a72f-14df58d7f13a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420235} :answer-field/id #uuid "b5e3230f-cb4f-51e8-a721-e24f62b0c3ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420252}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3b9fb7f-2262-5e34-bb97-3a915acfa755" :question/math-academy-id "q-93648" :question/problem "Which of the following statements are true?\n\nI. If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$\n\nII. If ${17}^{2}\\,|\\,17b$ then ${17}^{2}\\,|\\,b$\n\nIII. If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}({3}^{2},10)=1.$ Therefore, we have ${3}^{2}\\,|\\,10b$ and $\\text{gcd}({3}^{2},10)=1,$ which implies ${3}^{2}\\,|\\,b.$\n\n- Statement II is false. As a counterexample, let $b=17.$ Then, ${17}^{2}∣17\\cdot 17$ but ${17}^{2}∤17.$\n\n- Statement III is true. First, note that $\\text{gcd}(20,{3}^{3})=1.$ Therefore, we have $20\\,|\\,{3}^{3}b$ and $\\text{gcd}(20,{3}^{3})=1,$ which implies $20\\,|\\,b.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420695 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3513eb3f-f65e-5b39-ab1c-2e0b58c67dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420601} {:answer/id #uuid "665a3479-12d8-51d1-9eed-7d84f94d646e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420615} {:answer/id #uuid "aacccf24-6858-563c-a368-02680318f958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420640} {:answer/id #uuid "ab81e2eb-223d-52f9-b5de-9d8dd67a5c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420641} {:answer/id #uuid "f7d67e91-d0dd-56ab-88bd-f085b622e666" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420667}] :answer-field/correct {:answer/id #uuid "aacccf24-6858-563c-a368-02680318f958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420640} :answer-field/id #uuid "109f3df2-8001-5a75-986f-5286bb95d15e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5116bec0-cc13-5aa6-83e8-d90bc6884457" :question/math-academy-id "q-183415" :question/problem "$\\,$ $(m>0\\,∧n>0)⇒(m\\cdot n>0)$\n\nWhich of the following statements are true regarding the true implication above?\n\n- $m>0\\,∧n>0$ is a **necessary** condition for $m\\cdot n>0$\n- $m>0\\,∧n>0$ is a **sufficient** condition for $m\\cdot n>0$\n- $m\\cdot n>0$ is a **necessary** condition for $m>0\\,∧n>0$\n- $m\\cdot n>0$ is a **sufficient** condition for $m>0\\,∧n>0$" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case,\n\n$$\n{{(\\,m>0\\,∧n>0\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,m\\cdot n>0\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement II is true. $m>0\\,∧n>0$ is a **sufficient** condition for $m\\cdot n>0.$\n\n- Statement III is true. $m\\cdot n>0$ is a **necessary** condition for $m>0\\,∧n>0.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420697 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466de1f8-413a-58e0-83b2-57258605ef5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186420607} {:answer/id #uuid "670334a2-3e2f-5183-94b3-36d66edcbb09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420617} {:answer/id #uuid "89bf88fa-6413-59a1-9725-dd8030421b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420632} {:answer/id #uuid "bcb39f58-4569-5a76-967b-4523f30abcba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420649} {:answer/id #uuid "d3dc5f69-7dfb-5a28-bec4-84c487c5398a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420655}] :answer-field/correct {:answer/id #uuid "d3dc5f69-7dfb-5a28-bec4-84c487c5398a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420655} :answer-field/id #uuid "263ae040-cfff-57c0-86ac-4eb2766a4038" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bbf3a4e-b9b9-5f74-9d97-2501c2b02398" :question/math-academy-id "q-183393" :question/problem "$\\,$ If $l$ and $m$ are coplanar and perpendicular lines, then $l\\cap m\\ne ∅.$\n\nWhich of the following statements are true regarding the implication above?\n\n- $l$ and $m$ being coplanar and perpendicular lines is a **necessary** condition for $l\\cap m\\ne ∅$\n- $l\\cap m\\ne ∅$ is a **necessary** condition for $l$ and $m$ being coplanar and perpendicular lines\n- $l$ and $m$ being coplanar and perpendicular lines is a **sufficient** condition for $l\\cap m\\ne ∅$\n- $l\\cap m\\ne ∅$ is a **sufficient** condition for $l$ and $m$ being coplanar and perpendicular lines" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, \n\n$$\n{{(\\,l,m\\text{ are coplanar and perpendicular lines}\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,l\\cap m\\ne ∅\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement II is true. $l\\cap m\\ne ∅$ is a **necessary** condition for $l$ and $m$ being coplanar and perpendicular lines\n\n- Statement III is true. $l$ and $m$ being coplanar and perpendicular lines is a **sufficient** condition for $l\\cap m\\ne ∅$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420701 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ffdc366-69cf-5944-b0cd-2f7732814b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420600} {:answer/id #uuid "76687a4d-5975-5d07-81a2-0eb09b75fee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420622} {:answer/id #uuid "a8d7266e-b546-58f6-b4ee-21beeed5e5d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186420637} {:answer/id #uuid "e33ff8b5-a92f-57e5-8a74-3a68707fbea9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420656} {:answer/id #uuid "f92a005c-a42e-5839-95ae-334f90548200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420669}] :answer-field/correct {:answer/id #uuid "f92a005c-a42e-5839-95ae-334f90548200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420669} :answer-field/id #uuid "344fa06c-13bf-58d0-ac53-1e5a4e31e4b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd31a8b1-49f0-5bbe-9bfb-4daa99eb8e90" :question/math-academy-id "q-216328" :question/problem "$\\,$ If $P$ and $Q$ are congruent triangles, then $P$ and $Q$ have the same area.\n\nWhich of the following statements are true regarding the implication above?\n\n- $P$ and $Q$ being congruent triangles is a **necessary** condition for $P$ and $Q$ having the same area\n- $P$ and $Q$ having the same area is a **necessary** condition for $P$ and $Q$ being congruent triangles\n- $P$ and $Q$ being congruent triangles is a **sufficient** condition for $P$ and $Q$ having the same area\n- $P$ and $Q$ having the same area is a **sufficient** condition for $P$ and $Q$ being congruent triangles" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, \n\n$$\n{{(\\,P\\text{ and }Q\\text{ are congruent triangles}\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,P\\text{ and }Q\\text{ have the same area}\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement II is true. $P$ and $Q$ having the same area is a **necessary** condition for $P$ and $Q$ being congruent triangles.\n\n- Statement III is true. $P$ and $Q$ being congruent triangles is a **sufficient** condition for $P$ and $Q$ having the same area.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420705 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a20978-052e-5ad7-9f1d-9b0b7ee114ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420616} {:answer/id #uuid "ac9207f2-28a9-50c4-93b1-f0bbca2c7354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420642} {:answer/id #uuid "b2bc00bc-102f-56a7-ae97-c99fdc494631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420645} {:answer/id #uuid "f456c94d-ebd4-5f0b-b470-ffd45783554a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420662} {:answer/id #uuid "f63ab2d4-d54d-595f-9f13-411bad3bf356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420664}] :answer-field/correct {:answer/id #uuid "f456c94d-ebd4-5f0b-b470-ffd45783554a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420662} :answer-field/id #uuid "c6698986-949b-5e23-a1b3-d50a3d4acb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb9b0e1b-3e64-5482-b003-6352af7b5cae" :question/math-academy-id "q-183396" :question/problem "$\\,$ If $A⊂B,$ then $A\\cap \\overset{―}{B}=∅.$\n\nWhich of the following statements are true regarding the implication above?\n\n- $A\\cap \\overset{―}{B}=∅$ is a **necessary** condition for $A⊂B$\n- $A⊂B$ is a **necessary** condition for $A\\cap \\overset{―}{B}=∅$\n- $A\\cap \\overset{―}{B}=∅$ is a **sufficient** condition for $A⊂B$\n- $A⊂B$ is a **sufficient** condition for $A\\cap \\overset{―}{B}=∅$" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, \n\n$$\n{{(\\,A⊂B\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,A\\cap \\overset{―}{B}=∅\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement I is true. $A\\cap \\overset{―}{B}=∅$ is a **necessary** condition for $A⊂B.$\n\n- Statement IV is true. $A⊂B$ is a **sufficient** condition for $A\\cap \\overset{―}{B}=∅.$\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186420986 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117c917b-7d62-5b51-804f-8f0f908de52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420961} {:answer/id #uuid "24030462-28a2-5ff6-ab9c-6ac8a212b6d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420962} {:answer/id #uuid "8a3b603c-2196-5e99-b012-5950a3d2c4b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186420972} {:answer/id #uuid "c5a110c3-4357-5dd4-8b2e-d63c84712e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420976} {:answer/id #uuid "f94df467-1917-54c6-9462-f00a0bb4ad5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420980}] :answer-field/correct {:answer/id #uuid "c5a110c3-4357-5dd4-8b2e-d63c84712e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420976} :answer-field/id #uuid "e6a82ca7-01c6-5a96-826e-af1700b4e1e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420983}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f4365e0-4fb2-5b82-b78f-2c814bc881e5" :question/math-academy-id "q-182014" :question/problem "For the sets $A=\\{0,1,2\\},$ $B=\\{4,6,8\\},$ and $C=A\\times B,$ determine which of the following statements are true.\n\nI. $(0,2)\\in C$\n\nII. $(1,8)\\in C$\n\nIII. $(0,6)\\in C$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, the schematic for $A\\times B$ is shown below.\n\n![](images/12/12d1b94cc6d53954a9c164bd069f77fcddc7a46de2c1701c1f4cdfc608eef185.png)\n\nHence, the set $C=A\\times B$ is given by\n\n$$\nC={(0,4),(0,6),(0,8),(1,4),(1,6),(1,8),(2,4),(2,6),(2,8)}.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186421406 :knowledge-point/_questions [{:db/id #edb/ref 17592186152066 :knowledge-point/id #uuid "b70dd396-b01a-51e6-a52c-8ff729f48c45" :knowledge-point/title "Determining Whether a Standard Relation Is an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39fee494-92f8-5270-a473-d2107e7e8874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421324} {:answer/id #uuid "3fa9caf0-df86-5322-b028-e17f40231f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421326} {:answer/id #uuid "6f67c691-2dcd-52d8-87bc-d5e99dedc4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421347} {:answer/id #uuid "a05287c6-dfca-5030-894f-a2656886976e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421359} {:answer/id #uuid "bffd83c6-f97d-535a-871d-3201a645b707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421368}] :answer-field/correct {:answer/id #uuid "3fa9caf0-df86-5322-b028-e17f40231f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421326} :answer-field/id #uuid "52a03d34-71d7-5d2a-9d61-7aebbc62d675" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b086cc6-e229-5377-bb89-5a8ff879bb27" :question/math-academy-id "q-214271" :question/problem "Consider the following relation defined on the set $P(A),$ where $A={1,2,3,…,10}.$ \n\n$$\nX\\,R\\,Y\\,⇔\\,|X|=|Y|\n$$\n\n Which of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive. For all $X\\in P(A),$ $|X|\\,=\\,|X|.$\n\n- The relation $R$ is symmetric. For all $X,Y\\in P(A),$ if $|X|\\,=\\,|Y|,$ then $|Y|=|X|.$\n\n- The relation $R$ is transitive. For all $X,Y,Z\\in P(A),$ if $|X|=|Y|$ and $|Y|=|Z|,$ then $|X|=|Z|.$\n\n- The relation $R$ is an equivalence relation since it's reflexive, symmetric, and transitive.\n\nTherefore, the correct answer is \"I, II, III, and IV only.\""}] [{:db/id #edb/ref 17592186421409 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6549b369-142b-53da-b553-4facda5dbfe5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421342} {:answer/id #uuid "b40d20c9-3655-52ec-b8aa-91f39c99b226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421364} {:answer/id #uuid "b81f025c-684f-5d52-9d18-235fa3336997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421367} {:answer/id #uuid "c3273c40-cfce-55eb-8615-3692dd6d5895" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186421369} {:answer/id #uuid "ce88d57b-0226-5ecc-89db-39d37dd6f50e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421373}] :answer-field/correct {:answer/id #uuid "b40d20c9-3655-52ec-b8aa-91f39c99b226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421364} :answer-field/id #uuid "aa93e163-1d01-58a1-bdb6-eb95656804a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ee391cd-217d-5ff1-a899-24ea6980b5eb" :question/math-academy-id "q-214279" :question/problem "Consider the relation $R$ on the set $A={∗,⋆,∘,⋄}$ defined as \n\n$$\nR={(∗,∗),(⋆,⋆),(∘,∘),(⋄,⋄),(∗,⋆),(⋆,∗)}.\n$$\n\nWhich of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive because $(∗,∗),(⋆,⋆),(∘,∘),(⋄,⋄)\\in R.$$\\,\\,✓$\n\n- The relation $R$ is symmetric because $(y,x)\\in R$ whenever $(x,y)\\in R.$$\\,\\,✓$\n\n- The relation $R$ is transitive because for all $x,y,z\\in {∗,⋆,∘,⋄},$ if  $(x,y)\\in R$ and $(y,z)\\in R,$  then $(x,z)\\in R.$ Recall that it's sufficient to check only the cases when both pairs have different components: \n\n- $(∗,⋆)\\in R$ and $(⋆,∗)\\in R,$ and also $(∗,∗)\\in R$ $\\,\\,✓$\n\n- $(⋆,∗)\\in R$ and $(∗,⋆)\\in R,$ and also $(⋆,⋆)\\in R$$\\,\\,✓$\n\n- Since $R$ is reflexive, symmetric, and transitive, it is an equivalence relation.$\\,\\,✓$\n\nTherefore, the correct answer is \"I, II, III, and IV.\""}] [{:db/id #edb/ref 17592186421412 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0327b892-d3d1-5fb3-b2f0-3b4c1f296dde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421314} {:answer/id #uuid "3aa8f00c-f005-593e-8e78-a866a0839afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186421325} {:answer/id #uuid "6ff811d1-d506-5b23-8e83-bc217090e57c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421348} {:answer/id #uuid "9161f808-0aca-580f-99a3-789451a1123e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421356} {:answer/id #uuid "9dfb0cac-6b03-5126-9a12-63bea663b5bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421358}] :answer-field/correct {:answer/id #uuid "9dfb0cac-6b03-5126-9a12-63bea663b5bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421358} :answer-field/id #uuid "e2bbacab-cf91-5eed-be7e-c39a7e7d8711" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421401}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73719e8c-e17e-53b6-804a-0ade3bbbaa7f" :question/math-academy-id "q-214273" :question/problem "Consider the relation $R$ on the set $A={a,b,c}$ defined as \n\n$$\nR={(a,a),(b,b),(c,c),(a,b),(b,a),(b,c),(c,b)}.\n$$\n\nWhich of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive because $(a,a),\\,(b,b),\\,(c,c)\\in R.$ $\\,\\,✓$\n\n- The relation $R$ is symmetric because $(y,x)\\in R$ whenever $(x,y)\\in R.$ $\\,\\,✓$\n\n- The relation $R$ is *not* transitive because $(a,b)\\in R$ and $(b,c)\\in R,$ but $(a,c)\\notin R$\n\n- The relation is *not* an equivalence relation since it's not transitive.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186421415 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9f9465-cf5d-580a-9ff3-750b6c28f614" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421320} {:answer/id #uuid "51f10fd9-b7c9-54fc-a041-a40a299e4aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421331} {:answer/id #uuid "9a50ef14-e242-54e6-8842-59f1b35210fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186421357} {:answer/id #uuid "b7315505-3d31-5c27-bce8-fce3301ee94f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421365} {:answer/id #uuid "dc8d78e5-cb92-5ee7-9999-50c90b8b56ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186421379}] :answer-field/correct {:answer/id #uuid "b7315505-3d31-5c27-bce8-fce3301ee94f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421365} :answer-field/id #uuid "175e3445-e959-5d80-ae1e-e6de0e0b369c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae54ed26-0094-5420-99d1-1b8455c5d0e3" :question/math-academy-id "q-214280" :question/problem "Consider the relation $R$ on the set $A={\\alpha ,\\beta }$ defined as \n\n$$\nR={(\\alpha ,\\alpha ),(\\alpha ,\\beta ),(\\beta ,\\beta )}.\n$$\n\nWhich of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive because $(\\alpha ,\\alpha ),(\\beta ,\\beta )\\in R.$$\\,\\,✓$\n\n- The relation $R$ is *not* symmetric because $(\\alpha ,\\beta )\\in R$ but $(\\beta ,\\alpha )\\notin R.$\n\n- The relation $R$ is transitive because it contains no \"linked\" pairs such that $(x,y)\\in R$ and $(y,z)\\in R.\\,✓$\n\n- The relation is *not* an equivalence relation since it's not symmetric.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186421886 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09065806-b133-53e7-a415-f60daab53b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421874} {:answer/id #uuid "201f2230-7957-57ee-9f4c-64a64340bee2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186421877} {:answer/id #uuid "650f79ed-8cca-54b7-b878-11eaac10aaa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421878} {:answer/id #uuid "71b3b29c-1c8b-59df-b6b7-57376201da06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186421879} {:answer/id #uuid "8aef25aa-ccf6-5e00-8e61-47a0af94462a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421881}] :answer-field/correct {:answer/id #uuid "09065806-b133-53e7-a415-f60daab53b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421874} :answer-field/id #uuid "612fca8f-e7e8-5291-ad03-38fa3749ba41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421884}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34e8f50c-adbf-51d4-b0d4-a2150385ab67" :question/math-academy-id "q-39207" :question/problem "Suppose $(4a+2b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nI. $a\\cdot a<0$\n\nII. $b\\cdot a=\\frac{1}{2}$\n\nIII. $b\\cdot a=-2(a\\cdot a)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. Since $a\\ne 0,$ we must have $a\\cdot a>0.$\n\n- Statement II is false since it leads to a contradiction. If $b\\cdot a=\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}(4a+2b)\\cdot a & =0 \\\\ 4(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 4(a\\cdot a)+2(\\frac{1}{2}) & =0 \\\\ a\\cdot a & =-\\frac{1}{4},\\end{aligned}\n$$\n\nbut this is a contradiction since $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement III is true. Simplifying the expression $(4a+2b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(4a+2b)\\cdot a & =0 \\\\ (4a)\\cdot a+(2b)\\cdot a & =0 \\\\ 4(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 2(b\\cdot a) & =-4(a\\cdot a) \\\\ b\\cdot a & =-2(a\\cdot a)\\end{aligned}\n$$\n\nTherefore, we conclude that the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186423083 :knowledge-point/_questions [{:db/id #edb/ref 17592186192801 :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0019d257-76eb-58eb-993a-0411c1c8ea5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186423057} {:answer/id #uuid "0345689f-fc2f-5460-9f38-e059246fb16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186423058} {:answer/id #uuid "4c86aada-f7d7-57c4-bae2-63a127ef9b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186423063} {:answer/id #uuid "56eca2a0-0c43-50ef-b63f-0ce7a632d9be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186423064} {:answer/id #uuid "76159088-6817-5983-996b-f9485affcb33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186423067}] :answer-field/correct {:answer/id #uuid "76159088-6817-5983-996b-f9485affcb33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186423067} :answer-field/id #uuid "857db1a9-5baa-547f-ad7c-ffed08bafef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d743af0-a7a6-59cf-8a8b-38734a18e7f0" :question/math-academy-id "q-160458" :question/problem "$$\nf(x)=\\{\\begin{aligned}3{e}^{3x-1},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\le 0$\n\nII. ${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x=1$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\le 0,$ we have $f(x)=3{e}^{3x-1}\\ge 0.$\n\n- Statement II is false. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x & ={\\int }_{-\\infty }^{0}3{e}^{3x-1}\\,\\text{d}x \\\\  & ={e}^{3x-1}\\,{|}_{-\\infty }^{0} \\\\  & ={e}^{-1}-0 \\\\  & ={e}^{-1}\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, $f(x)$ is not a valid probability density function.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186423084 :knowledge-point/_questions [{:db/id #edb/ref 17592186192801 :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a4da9c-5ad8-5dda-8ba1-be02f0af04f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186423060} {:answer/id #uuid "5d964b39-2482-5346-8612-8ce043b95788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186423066} {:answer/id #uuid "793d1056-34ae-50be-bbb1-25d45ceebdd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186423068} {:answer/id #uuid "80eb078c-af7c-5800-a93c-6a0513121c1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186423070} {:answer/id #uuid "84482c4e-d104-578b-9bca-d5349bf9e6b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186423072}] :answer-field/correct {:answer/id #uuid "5d964b39-2482-5346-8612-8ce043b95788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186423066} :answer-field/id #uuid "35e8275a-bb12-5f98-ba18-184bdee245ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7af6cdaa-d1ff-562c-9d47-7e9a37adf5ba" :question/math-academy-id "q-160446" :question/problem "$$\nf(x)=\\{\\begin{aligned}{e}^{-x},\\, & x\\ge 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\ge 0$\n\nII. ${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x=1$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\ge 0,$ we have $f(x)={e}^{-x}\\ge 0.$\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x & ={\\int }_{0}^{\\infty }{e}^{-x}\\,\\text{d}x \\\\  & =-{e}^{-x}\\,{|}_{0}^{\\infty } \\\\  & =-(0-{e}^{0}) \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is true. Since statements I and II are true, the first and second conditions are satisfied. So, $f(x)$ is a valid probability density function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186424829 :knowledge-point/_questions [{:db/id #edb/ref 17592186152126 :knowledge-point/id #uuid "f7063140-eebe-598c-b530-3c13509d359b" :knowledge-point/title "Classifying Numbers as Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65467c55-4012-565e-9f4c-86f2450043e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186424689} {:answer/id #uuid "957bcbbb-38da-5714-9fd9-7d21a88cb06e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186424718} {:answer/id #uuid "c9553ae8-cd77-5fb6-81e8-25583030b458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186424745} {:answer/id #uuid "cf4041ac-449a-56ee-bec7-41438a2640f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186424748} {:answer/id #uuid "f6b336e0-5ad1-5621-824c-34d90d2ca6f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186424771}] :answer-field/correct {:answer/id #uuid "65467c55-4012-565e-9f4c-86f2450043e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186424689} :answer-field/id #uuid "8b791c26-12be-57d7-a745-4c7665ba6d9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d38c8439-616e-58d4-9fa5-c5876ae08e79" :question/math-academy-id "q-99327" :question/problem "Which of the following statements are true?\n\nI. $-\\frac{1}{9}$ is a natural number\n\nII. $-\\frac{1}{9}$ is an integer\n\nIII. $-\\frac{1}{9}$ is a rational number" :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-\\frac{1}{9}$ is not a natural number.\n\n- $-\\frac{1}{9}$ is not an integer.\n\n- $-\\frac{1}{9}$ is a rational number because it can be written as $\\frac{(-1)}{9}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186425931 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034daae9-6479-5df1-9b65-7e6139e7a49a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186425911} {:answer/id #uuid "204a2417-b1ee-5a94-9387-92210e84c9fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186425912} {:answer/id #uuid "7bd19b67-41ce-5d20-9075-74172011db9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186425917} {:answer/id #uuid "daf363de-8d31-5c81-8ebc-62bc6b37b91b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186425921} {:answer/id #uuid "fa68e695-7f74-50ec-acaf-b9b8df374c7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186425924}] :answer-field/correct {:answer/id #uuid "daf363de-8d31-5c81-8ebc-62bc6b37b91b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186425921} :answer-field/id #uuid "3b56bb6c-74dd-5bd4-a9cd-cbed30098ff9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c04d4c5-9913-59ea-a83f-46d8bb7c02cf" :question/math-academy-id "q-129893" :question/problem "Let $D$ be a finite region enclosed between the curve $y=-{x}^{2}+2$ and the $x$-axis. If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}+3y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. ${∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [-1,3]$\n\nII. ${∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [0,2]$\n\nIII. ${∬}_{R}({x}^{2}+3y)\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-4,4]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/3b/3bfc135232008824ae0522bcc8454c5f97c2dfd13fb6e333e146a040ccbc1f22.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}({x}^{2}+3y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statements I is false. The rectangle $R$ does not cover the region $D.$\n\n- Statements II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186426077 :knowledge-point/_questions [{:db/id #edb/ref 17592186124511 :knowledge-point/id #uuid "084a0a83-5ce6-5184-beb7-8ae7b4f1a799" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df6b96c-ae37-5c0f-a45a-4777f6347ae1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426038} {:answer/id #uuid "32c9cac7-da71-5467-96f5-d4a01ec2f839" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186426041} {:answer/id #uuid "510c1195-aa8f-51b5-a011-ae59a01fa22b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186426044} {:answer/id #uuid "538a5c83-1a7c-59fd-ac8b-ec6142e59eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186426045} {:answer/id #uuid "78a8bbd0-591f-56da-86f2-7d40646b8958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186426053}] :answer-field/correct {:answer/id #uuid "538a5c83-1a7c-59fd-ac8b-ec6142e59eee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186426045} :answer-field/id #uuid "fa3f637a-f3b6-51d7-b9c4-70510038cd30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426070}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0f098cb-e297-54fe-a435-e8a16d43aa06" :question/math-academy-id "q-139977" :question/problem "Which of the following statements are true, given that $A$ is a $4\\times 4$ matrix and \n\n$$\n\\text{Null}(A)=\\{[\\begin{aligned}{x}_{1} \\\\ 0 \\\\ 0 \\\\ -{x}_{1}\\end{aligned}]\\,|\\,{x}_{1}\\in R\\}?\n$$\n\nI. $\\text{dim(Null}(A))=1$\n\nII. $A$ is invertible\n\nIII. $\\text{rank}(A)<4$" :question/worked-solution "Since $A$ is a $4\\times 4$ matrix, the invertible matrix theorem states the following:\n\n$A$ is invertible $\\,⇔\\,\\{\\,\\begin{aligned} & \\text{Col}(A)={R}^{4} \\\\  & \\text{dim(Col}(A))=4=\\text{rank}(A) \\\\  & \\text{Null}(A)=\\{0\\} \\\\  & \\text{dim(Null}(A))=0=\\text{nullity}(A)\\end{aligned}$\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Indeed, since \n\n$$\n\\text{Null}(A)=\\{{x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 0 \\\\ -1\\end{aligned}]\\,|\\,{x}_{1}\\in R\\}\n$$\n\nwe conclude that \n\n$$\n\\text{dim(Null}(A))=1.\n$$\n\n- Statement II is false. Since $\\text{dim(Null}(A))\\ne 0,$ then according to the invertible matrix theorem, the matrix $A$ can't be invertible.\n\n- Statement III is true. Indeed, since $A$ is not invertible, then by the invertible matrix theorem, we must have $\\text{rank}(A)\\ne 4,$ or equivalently $\\text{rank}(A)<4.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186426550 :knowledge-point/_questions [{:db/id #edb/ref 17592186124589 :knowledge-point/id #uuid "099e7caf-085a-5fd5-ad3d-1ebf189527b7" :knowledge-point/title "Verifying Properties Involving Scalar Multiplication and the Distributive Laws"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0944afe4-0d0b-565f-af88-3dbcade60f38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186426540} {:answer/id #uuid "490c90da-97c9-5fee-bb59-bd940c2df35c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426541} {:answer/id #uuid "505c9ae0-7f3e-59b3-8123-543ae49a7508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186426542} {:answer/id #uuid "6f7f5023-3192-5bc2-a421-3f0e60a1f07c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186426543} {:answer/id #uuid "7a3c0dcd-1ed6-5e80-bd76-4898442d0191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186426544}] :answer-field/correct {:answer/id #uuid "505c9ae0-7f3e-59b3-8123-543ae49a7508" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186426542} :answer-field/id #uuid "cd34e2b9-846d-52d4-a7f0-ad33a82569a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426548}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42098bc3-a0a9-510c-94ee-f777802bb49a" :question/math-academy-id "q-162666" :question/problem "Let $R$ be the set of all $2\\times 2$ matrices of the form $[\\begin{aligned}{a}^{2} & 0 \\\\ 0 & 1\\end{aligned}],$ where $a\\in Z.$ Which of the following statements are true?\n\nI. For any $A\\in R,$ we have $(-1)\\cdot A\\in R.$\n\nII. For any $A\\in R,$ we have $2\\cdot A\\in R.$\n\nIII. For any $A\\in R$ and $\\alpha \\in R$, we have $(\\alpha +1)A=\\alpha A+A.$" :question/worked-solution "Let's examine each of our statements in turn.\n\n- Statement I is false. For example,the matrix $A=[\\begin{aligned}4 & 0 \\\\ 0 & 1\\end{aligned}]\\in R,$ since $4={2}^{2}$ and $2\\in Z.$ However\n\n$$\n(-1)\\cdot A=[\\begin{aligned}-4 & 0 \\\\ 0 & -1\\end{aligned}]\\notin R,\n$$\n\nbecause a negative number ($-4$) can't be a square.\n\n- Statement II is false. For example, consider the matrix $A=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]$ from $R.$ Then, we have \n\n$$\n2\\cdot A=[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]\\notin R\n$$\n\nbecause the $22$-entry of $2\\cdot A$ is not equal to $1.$\n\n- Statement III is true. Indeed, for any $2\\times 2$ matrix $A=({a}_{ij})\\in R,$ the entries are just real numbers. Thus, for any $\\alpha \\in R,$ we obtain that\n\n$$\n(\\alpha +1){a}_{ij}=\\alpha {a}_{ij}+{a}_{ij},\n$$\n\nand hence,\n\n$$\n(\\alpha +1)A=\\alpha A+A.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186426551 :knowledge-point/_questions [{:db/id #edb/ref 17592186124484 :knowledge-point/id #uuid "7eb09138-45df-5e6c-87af-772980ff7546" :knowledge-point/title "Verifying Properties Involving Vector Addition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b5239c-b3c9-5807-b37b-2a5e43bd141d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186426538} {:answer/id #uuid "08624e18-c789-56aa-82f8-d0568d6cacd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426539} {:answer/id #uuid "7ea867be-0628-5646-98c1-28f732a418d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186426545} {:answer/id #uuid "96e40a22-66a9-56e3-b03b-cd6284f3fb8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186426546} {:answer/id #uuid "d049396a-d59f-556c-a286-aabf743c306b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186426547}] :answer-field/correct {:answer/id #uuid "08624e18-c789-56aa-82f8-d0568d6cacd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186426539} :answer-field/id #uuid "ff55dda2-87d0-5c54-864b-9856103ddee8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186426549}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca37d526-e95e-5c72-ad4b-d05af7166afb" :question/math-academy-id "q-162394" :question/problem "Let $E$ be the set of all functions $f:R\\to R$ that satisfy $f(0)=1.$ Which of the following statements are true? \n\nI. The exponential function $f(x)={e}^{x}\\in E$\n\nII. For any $f(x),g(x)\\in E$, we have $f(x)+g(x)\\in E.$\n\nIII. The set $E$ is closed under addition." :question/worked-solution "Let's examine each statement in turn.\n\n- Statement I is true. Indeed, we have that\n\n$$\nf(0)={e}^{0}=1.\n$$\n\nHence, $f\\in E.$\n\n- Statement II is false. For example, consider the function $f(x)=g(x)={e}^{x}\\in E.$ Then, \n\n$$\n(f+g)(0)={e}^{0}+{e}^{0}=1+1=2\\ne 1.\n$$\n\nSo, $f(x)+g(x)\\notin E.$\n\n- Statement III is false. Since statement II is false, $E$ is not closed under addition.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186430805 :knowledge-point/_questions [{:db/id #edb/ref 17592186133871 :knowledge-point/id #uuid "67683e7d-bf4f-5fdf-8fe5-df996c30e836" :knowledge-point/title "Determining Whether a Set of Vectors Is Orthogonal With Respect to a Given Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d39f349-998b-59ff-bf35-dc110bf6bf2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186430783} {:answer/id #uuid "8f2d2cfb-c614-5b27-bc96-e076f598725f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186430791} {:answer/id #uuid "a6621b58-77e4-59d2-b684-96f69b011cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186430793} {:answer/id #uuid "dbb7dce8-d733-517f-ba5b-5223c54118a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186430797} {:answer/id #uuid "fb73d8fe-92a2-5daf-a18a-f4c0dec77755" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186430800}] :answer-field/correct {:answer/id #uuid "2d39f349-998b-59ff-bf35-dc110bf6bf2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186430783} :answer-field/id #uuid "68a628e9-2427-55d0-991e-370a53971bc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0be806ce-1a6b-5ee1-964b-e362c3c8599e" :question/math-academy-id "q-140495" :question/problem "$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}3 \\\\ 1 \\\\ -1\\end{aligned}],\\,{v}_{3}=[\\begin{aligned}-9 \\\\ -2 \\\\ 3\\end{aligned}]\n$$\n\nConsider the vectors shown above. Given that the inner product in the vector space ${R}^{3}$ is defined as \n\n$$\n⟨x,y⟩=2{x}_{1}{y}_{1}+2{x}_{2}{y}_{2}+3{x}_{3}{y}_{3},\n$$\n\nwhich of the following statements are true?\n\nI. ${v}_{1}⊥{v}_{2}$ with respect to the given inner product\n\nII. ${v}_{1}⊥{v}_{3}$ with respect to the given inner product\n\nIII. $S=\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is an orthogonal set with respect to the given inner product" :question/worked-solution "Recall that a set of vectors in an inner product space is orthogonal if all vectors in the set are mutually orthogonal with respect to the given inner product. \n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, we have\n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{2}⟩ & =2(1)(3)+2(0)(1)+3(2)(-1) \\\\  & =6+0-6 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{2}$ with respect to the given inner product.\n\n- Statement II is true since \n\n$$\n\\begin{aligned}⟨{v}_{1},{v}_{3}⟩ & =2(1)(-9)+2(0)(-2)+3(2)(3) \\\\  & =-18+0+18 \\\\  & =0,\\end{aligned}\n$$\n\nwhich means that ${v}_{1}⊥{v}_{3}$ with respect to the given inner product.\n\n- Statement III is false. Let's check if ${v}_{2}⊥{v}_{3}.$ Computing the inner product, we have \n\n$$\n\\begin{aligned}⟨{v}_{2},{v}_{3}⟩ & =2(3)(-9)+2(1)(-2)+3(-1)(3) \\\\  & =-54-4-9 \\\\  & =-67\\ne 0,\\end{aligned}\n$$\n\nwhich means that ${v}_{2}⊥̸{v}_{3}$ with respect to the given inner product.\nSince ${v}_{2}⊥̸{v}_{3},$ the set $S$ is *not* orthogonal.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186430827 :knowledge-point/_questions [{:db/id #edb/ref 17592186119845 :knowledge-point/id #uuid "8a5d11c2-4a7c-5fdc-a363-8a87b90db19e" :knowledge-point/title "Finding the Dimension of a Span by Inspection"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "249765f6-42b9-5e83-a75a-2fb40b35fb7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186430809} {:answer/id #uuid "8fb95b63-4d2c-5d43-bd50-a2fba6e30b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186430813} {:answer/id #uuid "e1e20a6a-14b7-54fa-9105-33f5512ce16c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186430821} {:answer/id #uuid "e682f472-fa87-510a-b1cc-a0ffe0cfc749" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186430822} {:answer/id #uuid "f15db031-2bc3-5368-8dd0-db33cdf3c7fe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186430823}] :answer-field/correct {:answer/id #uuid "8fb95b63-4d2c-5d43-bd50-a2fba6e30b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186430813} :answer-field/id #uuid "c1c029bf-4874-5367-aefd-b2eea5af8718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186430826}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48a8881c-e6ac-54a2-9375-24bf5efbb3a5" :question/math-academy-id "q-79325" :question/problem "Let ${v}_{1},{v}_{2},{v}_{3}$ be linearly independent vectors, and suppose that the vector $w$ can be written as a linear combination of ${v}_{1},{v}_{2},{v}_{3}.$ Which of the following statements are true?\n\nI. ${v}_{1},{v}_{2}$ form a basis of $\\text{Span}\\{{v}_{1},{v}_{2}\\}$\n\nII. $\\text{dim}(\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\})=2$\n\nIII. $\\text{dim}(\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3},w\\})=3$" :question/worked-solution "Recall that a basis of a vector space $V$ is a set of linearly independent vectors that span $V.$ The dimension of $V$ is the number of vectors in any basis of $V$ (if such a basis exists). \n\nWith that in mind, let's consider each of the statements.\n\n- Statement I is true. Indeed, $\\text{Span}\\{{v}_{1},{v}_{2}\\}$ is spanned by ${v}_{1},{v}_{2}.$ Moreover, ${v}_{1},{v}_{2}$ are linearly independent vectors. So,  ${v}_{1},{v}_{2}$ is a basis of the span.\n\n- Statement II is false. Indeed, $\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\}$ is spanned by ${v}_{1},{v}_{2},{v}_{3}$, and we are told that ${v}_{1},{v}_{2},{v}_{3}$ are linearly independent vectors. So, ${v}_{1},{v}_{2},{v}_{3}$ is a basis of the span. Therefore, we have $\\text{dim}(\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3}\\})=3$ (not $2$).\n\n- Statement III is true. We are told that $w$ can be written as a linear combination of ${v}_{1},{v}_{2},{v}_{3}.$ This means that $\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3},w\\}$ is completely spanned by the vectors ${v}_{1},{v}_{2},{v}_{3}$ only. So, $\\text{dim}(\\text{Span}\\{{v}_{1},{v}_{2},{v}_{3},w\\})=3.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186431146 :knowledge-point/_questions [{:db/id #edb/ref 17592186147432 :knowledge-point/id #uuid "a459ec25-988e-5f91-8c25-2b7b81b6b6ee" :knowledge-point/title "Identifying Properties of a Mass-Spring System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0572e053-bbb1-51d9-80e9-c92d6011545b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186431121} {:answer/id #uuid "08d858c9-ca22-560b-97eb-40da3122196f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186431122} {:answer/id #uuid "3dddd46e-c3a5-5c09-a4c6-1f8c377929ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186431126} {:answer/id #uuid "90dfd4e1-ed47-5aa3-9478-4f0c76e8f799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186431131} {:answer/id #uuid "d1fd2ae2-4033-52e2-b506-d30e73572664" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186431135}] :answer-field/correct {:answer/id #uuid "0572e053-bbb1-51d9-80e9-c92d6011545b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186431121} :answer-field/id #uuid "5544434a-2b77-5acf-bab7-2044c21c61df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431142}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a1d55e9e-973d-5821-a2d2-76fe96bd1d7d" :question/math-academy-id "q-64257" :question/problem "A particle of mass $5\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=30\\,{\\text{kg/s}}^{2}.$ The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. \n\nIf the particle moves with simple harmonic motion, then which of the following statements are true?\n\nI. The governing differential equation is ${y}^{″}+6y=0$\n\nII. The frequency $f$ of the oscillation is $f=\\frac{3}{2\\pi }\\,{\\text{s}}^{-1}$\n\nIII. The general solution can be expressed as $y=R\\operatorname{sin}⁡(6t+ϕ),$ where $R$ is the amplitude and $ϕ$ is the phase." :question/worked-solution "Let's look at each statement.\n\n- The equation of motion for a particle of mass $m$ moving with simple harmonic motion (SHM) under the action of a spring with spring constant $k$ is given by\n\n$$\nm{y}^{″}=-ky.\n$$\n\nRearranging the above equation gives\n\n$$\n{y}^{″}+\\frac{k}{m}y=0.\n$$\n\nComparing this to the SHM equation \n\n$$\n{y}^{″}+{\\omega }^{2}y=0,\n$$\n\nwe see that\n\n$$\n{\\omega }^{2}=\\frac{k}{m}.\n$$\n\nSubstituting our values for $k$ and $m$ gives\n\n$$\n{\\omega }^{2}=\\frac{30}{5}=6\\,⟹\\,\\omega =\\sqrt{6}\n$$\n\nSo the governing differential equation is\n\n$$\n{y}^{″}+6y=0.\n$$\n\nHence, statement I is true.\n\n- The frequency $f$ (measured in ${s}^{-1}$) is given by\n\n$$\nf=\\frac{1}{T}=\\frac{\\omega }{2\\pi },\n$$\n\nwhere $T$ is the period. So in our case, we have\n\n$$\nf=\\frac{\\sqrt{6}}{2\\pi }.\n$$\n\nSo the frequency $f=\\frac{\\sqrt{6}}{2\\pi }\\,{\\text{s}}^{-1}.$\nHence, statement II is false.\n\n- The general solution for $y(t)$ can take one of three forms.\n\n1\\. $A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\n2\\. $R\\operatorname{cos}⁡(\\omega t+{ϕ}_{1})$\n\n3\\. $R\\operatorname{sin}⁡(\\omega t+{ϕ}_{2})$\n\nWriting $\\omega =\\sqrt{6}$ and ${ϕ}_{1}=ϕ$ in form 3 gives\n\n$$\ny(t)=R\\operatorname{sin}⁡(\\sqrt{6}t+ϕ).\n$$\n\nHence, statement III is false.\n\nSo, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186431859 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2a07a5-dbe2-541d-8ce4-ee6e5f93fe79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186431837} {:answer/id #uuid "35a22425-0fd6-5e91-8dbd-62be5dc9184d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186431838} {:answer/id #uuid "3e29f639-6dea-54ac-bb7f-18bb3d312722" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186431839} {:answer/id #uuid "5bfd9fd9-87e6-5685-a09c-de3d488b9e58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186431843} {:answer/id #uuid "81f8e02c-48df-5958-a046-15ad41372d47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186431844}] :answer-field/correct {:answer/id #uuid "3e29f639-6dea-54ac-bb7f-18bb3d312722" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186431839} :answer-field/id #uuid "a22e3410-aef3-5a94-97ba-9cdaa238fcc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186431857}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "adc7f30b-f5f4-5c71-84b9-9c4c7b9ab1ff" :question/math-academy-id "q-140464" :question/problem "For the vector $u=[\\begin{aligned}2 \\\\ 1 \\\\ -2\\end{aligned}]$ which of the following statements are true?\n\nI. $u⊥H,\\,$ where $H=\\{[\\begin{aligned}-4 \\\\ 10 \\\\ 1\\end{aligned}],[\\begin{aligned}0 \\\\ 10 \\\\ 5\\end{aligned}]\\}$\n\nII. $u⊥V,\\,$ where $V=\\{[\\begin{aligned}-4 \\\\ 10 \\\\ -1\\end{aligned}],[\\begin{aligned}0 \\\\ 10 \\\\ -5\\end{aligned}]\\}$\n\nIII. $u⊥W,\\,$ where $W=\\{[\\begin{aligned}5 \\\\ 0 \\\\ 5\\end{aligned}],[\\begin{aligned}10 \\\\ -5 \\\\ 0\\end{aligned}],[\\begin{aligned}-4 \\\\ 10 \\\\ -1\\end{aligned}]\\}$" :question/worked-solution "Let's denote the vectors of $H,V$ and $W$ as $\\{{h}_{1},{h}_{2}\\},\\{{v}_{1},{v}_{2}\\}$ and $\\{{w}_{1},{w}_{2},{w}_{3}\\}$, respectively.  \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $H:$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =2\\cdot (-4)+1\\cdot 10+(-2)\\cdot 1=0 & ✓ \\\\ u\\cdot {h}_{2} & =2\\cdot 0+1\\cdot 10+(-2)\\cdot 5=0 & ✓\\end{aligned}\n$$\n\nSo, $u⊥H.$\n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =2\\cdot (-4)+1\\cdot 10+(-2)\\cdot (-1)=4\\ne 0 & \\times  \\\\ u\\cdot {v}_{2} & =2\\cdot 0+1\\cdot 10+(-2)\\cdot (-5)=20\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸V.$\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =2\\cdot 5+1\\cdot 0+(-2)\\cdot 5=0 & ✓ \\\\ u\\cdot {w}_{2} & =2\\cdot 10+1\\cdot (-5)+(-2)\\cdot 0=15\\ne 0 & \\times  \\\\ u\\cdot {w}_{3} & =2\\cdot (-4)+1\\cdot 10+(-2)\\cdot (-1)=4\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸W.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186432327 :knowledge-point/_questions [{:db/id #edb/ref 17592186133864 :knowledge-point/id #uuid "1304189f-61ac-53c5-9b09-8e365f763136" :knowledge-point/title "Identifying Dimensions of Factors in a QR Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0855b0c5-d3cb-5d5a-87d3-6ae2573808c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432276} {:answer/id #uuid "40511cf5-4e38-545c-92bd-6f12dbd5bbe6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432283} {:answer/id #uuid "429b9536-a311-5367-b367-ede0065e5d2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432284} {:answer/id #uuid "60ddcb4a-b5db-50a3-82d4-5c076834cb99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432293} {:answer/id #uuid "7bc9001c-a8a7-5655-ad38-e28393932a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432299}] :answer-field/correct {:answer/id #uuid "7bc9001c-a8a7-5655-ad38-e28393932a25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432299} :answer-field/id #uuid "77a7384a-2954-50d8-86d9-02fc2c11bedd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432321}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5b19eecb-3ecc-5584-a617-4bf8675e0b01" :question/math-academy-id "q-95917" :question/problem "Given that $A=QR$ is a QR factorization of a $4\\times 2$ matrix $A$ with linearly independent columns, which of the following statements are true?\n\nI. $Q$ is a $4\\times 2$ upper triangular matrix\n\nII. The columns of $Q$ are unit vectors\n\nIII. $R$ is a $4\\times 2$ matrix" :question/worked-solution "Recall that if $A=QR$ is a QR factorization of an $m\\times n$ matrix $A,$ then\n\n$$\n{A}_{m\\times n}={Q}_{m\\times n}\\times {R}_{n\\times n},\n$$\n\nwhere \n\n- $Q$ is an $m\\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A)$\n\n- $R$ is an $n\\times n$ upper triangular matrix\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. $Q$ should be a $4\\times 2$ matrix, but is not necessarily upper triangular.\n\n- Statement II is true. Since the columns of $Q$ form an orthonormal basis, they are unit vectors.\n\n- Statement III is false. $R$ must be a $2\\times 2$ matrix.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186432328 :knowledge-point/_questions [{:db/id #edb/ref 17592186133864 :knowledge-point/id #uuid "1304189f-61ac-53c5-9b09-8e365f763136" :knowledge-point/title "Identifying Dimensions of Factors in a QR Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1194f3e3-1844-5ab9-9daf-5533b0a96a9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432277} {:answer/id #uuid "30cd0132-8138-5a90-bf6d-84623e148b9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432278} {:answer/id #uuid "3108f868-6810-5414-b79d-ed9c59cf14cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432279} {:answer/id #uuid "62bcf903-0255-59aa-affe-9d6ade55eb53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432294} {:answer/id #uuid "eede4f00-fcca-5952-bf0b-1b45f39cc595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432314}] :answer-field/correct {:answer/id #uuid "3108f868-6810-5414-b79d-ed9c59cf14cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432279} :answer-field/id #uuid "7fd0a920-47da-5738-85dc-fcfde1071d1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71004f41-ae2f-50fd-9fdc-88ec92c18337" :question/math-academy-id "q-95919" :question/problem "Given that $A=QR$ is a QR factorization of a $m\\times n$ matrix $A$ with linearly independent columns, which of the following statements are true?\n\nI. $Q$ is a square matrix\n\nII. $\\text{Col}(A)$ is spanned by the columns of $Q$\n\nIII. $R$ is a square matrix" :question/worked-solution "Recall that if $A=QR$ is a QR factorization of an $m\\times n$ matrix $A,$ then\n\n$$\n{A}_{m\\times n}={Q}_{m\\times n}\\times {R}_{n\\times n},\n$$\n\nwhere \n\n- $Q$ is an $m\\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A)$\n\n- $R$ is an $n\\times n$ upper triangular matrix\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. $Q$ should be an $m\\times n$ matrix, so $Q$ is not necessarily a square matrix.\n\n- Statement II is true.  Since the columns of $Q$ form an orthonormal basis of $\\text{Col}(A),$ they must span $\\text{Col}(A).$\n\n- Statement III is true. Indeed, $R$ must be an $m\\times n$ matrix.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186432331 :knowledge-point/_questions [{:db/id #edb/ref 17592186133864 :knowledge-point/id #uuid "1304189f-61ac-53c5-9b09-8e365f763136" :knowledge-point/title "Identifying Dimensions of Factors in a QR Factorization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34dee133-5da2-587d-bf0e-88da035eca52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432280} {:answer/id #uuid "b3c6518b-cfa4-5881-b743-5099d5ac42c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432307} {:answer/id #uuid "c4b65933-5b0f-5c15-a729-3b530d4943b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432309} {:answer/id #uuid "ee9fd3db-d080-510c-8cba-0c10cffe8599" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432313} {:answer/id #uuid "f0b12155-382a-5236-96d0-5241fdc65d8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432315}] :answer-field/correct {:answer/id #uuid "ee9fd3db-d080-510c-8cba-0c10cffe8599" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186432313} :answer-field/id #uuid "16d9df2f-7dae-571c-9898-8b25f88afb03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432319}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6266ee7-76af-56d5-9957-fa402398ddd2" :question/math-academy-id "q-95923" :question/problem "Given that $A=QR$ is a QR factorization of an $8\\times 4$ matrix $A$ with linearly independent columns, which of the following statements are true?\n\nI. $Q$ is an $8\\times 4$ matrix\n\nII. $R$ is an $8\\times 8$ matrix\n\nIII. $R$ is an upper triangular matrix" :question/worked-solution "Recall that if $A=QR$ is a  QR factorization of an $m\\times n$ matrix $A,$ then\n\n$$\n{A}_{m\\times n}={Q}_{m\\times n}\\times {R}_{n\\times n},\n$$\n\nwhere \n\n- $Q$ is an $m\\times n$ matrix whose columns form an orthonormal basis of $\\text{Col}(A)$\n\n- $R$ is an $n\\times n$ upper triangular matrix\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, $Q$ must be an $8\\times 4$ matrix.\n\n- Statement II is false. $R$ should be a $4\\times 4$ matrix.\n\n- Statement III is true. Indeed $R$ must be an upper triangular matrix.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186432828 :knowledge-point/_questions [{:db/id #edb/ref 17592186147445 :knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c" :knowledge-point/title "Identifying Types of Damped Oscillations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a699d4d-481b-5164-8a94-fe6421c0ee70" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186432800} {:answer/id #uuid "31ffbbd1-678b-5808-8fca-cdd7644b7978" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186432802} {:answer/id #uuid "635d6934-78cc-51ab-a251-c7a8c8ed0bb2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186432804} {:answer/id #uuid "902fe176-8794-5e7f-a141-85bc2b1d225d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432807} {:answer/id #uuid "d225cf09-2533-5d78-b568-46029a1627a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186432810}] :answer-field/correct {:answer/id #uuid "902fe176-8794-5e7f-a141-85bc2b1d225d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186432807} :answer-field/id #uuid "578e80cb-b054-52ce-97be-509dd668d752" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186432823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d285631-ec24-50a4-ab3c-c0601632cbad" :question/math-academy-id "q-94314" :question/problem "Which of the following statements are true?\n\nI. ${y}^{″}+8{y}^{′}+4y=0$ represents an oscillator undergoing critical damping\n\nII. ${y}^{″}+4{y}^{′}+3y=0$ represents an oscillator undergoing heavy damping\n\nIII. ${y}^{″}+12{y}^{′}+36y=0$ represents an oscillator undergoing light damping" :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+8{y}^{′}+4y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+8\\lambda +4=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={8}^{2}-4(1)(4) & =48>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement I is false.\n\n- The differential equation ${y}^{″}+4{y}^{′}+3y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+4\\lambda +3=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(3) & =4>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement II is true.\n\n- The differential equation ${y}^{″}+12{y}^{′}+36y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+12\\lambda +36=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={12}^{2}-4(1)(36) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186433607 :knowledge-point/_questions [{:db/id #edb/ref 17592186152126 :knowledge-point/id #uuid "f7063140-eebe-598c-b530-3c13509d359b" :knowledge-point/title "Classifying Numbers as Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138bd42d-bdd5-5103-a741-25924bfa0d76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186433583} {:answer/id #uuid "40048675-6488-5fe3-b64d-e1be872b48eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186433588} {:answer/id #uuid "739cdf7c-1cac-5a34-beb6-6fa4499d7934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186433593} {:answer/id #uuid "899c20e5-4344-5547-829c-68e151ee1feb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186433596} {:answer/id #uuid "e15793bd-544a-5738-b2d9-b9df1c36295d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186433602}] :answer-field/correct {:answer/id #uuid "138bd42d-bdd5-5103-a741-25924bfa0d76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186433583} :answer-field/id #uuid "6ddb88e1-f38e-5794-a535-77e7876e74f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "39fe4419-4a43-50fa-a07c-6ab5298bae4f" :question/math-academy-id "q-67819" :question/problem "Which of the following statements are true?\n\nI. $\\frac{1}{10}$ is natural number\n\nII. $\\frac{1}{10}$ is an integer\n\nIII. $\\frac{1}{10}$ is a rational number" :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $\\frac{1}{10}$ is not a natural number.\n\n- $\\frac{1}{10}$ is not an integer.\n\n- $\\frac{1}{10}$ is a rational number.\n\nTherefore, the correct answer is, \"III only.\""}] [{:db/id #edb/ref 17592186433608 :knowledge-point/_questions [{:db/id #edb/ref 17592186152126 :knowledge-point/id #uuid "f7063140-eebe-598c-b530-3c13509d359b" :knowledge-point/title "Classifying Numbers as Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef60037-3b80-5502-933c-09d72a5ba319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186433585} {:answer/id #uuid "20049e96-ae01-5c45-9a3c-1f7838319008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186433586} {:answer/id #uuid "32cb23a7-2f0e-5f7f-aacf-0afbcb6147d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186433587} {:answer/id #uuid "52d54b01-b14b-5e76-b8dd-55960b680252" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186433589} {:answer/id #uuid "d85a86a3-e5b3-5d88-8a74-b8f032a1e5b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186433601}] :answer-field/correct {:answer/id #uuid "d85a86a3-e5b3-5d88-8a74-b8f032a1e5b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186433601} :answer-field/id #uuid "4cd1f0fa-8af8-54fb-b456-0eee7ce3fb92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "46c072ed-28fe-5e0e-96d0-a316d330f872" :question/math-academy-id "q-93611" :question/problem "Which of the following statements are true?\n\nI. $-10$ is a natural number\n\nII. $-10$ is an integer\n\nIII. $-10$ is a rational number" :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-10$ is not a natural number.\n\n- $-10$ is an integer.\n\n- $-10$ is a rational number because it can be written as $\\frac{(-10)}{1}.$\n\nTherefore, the correct answer is, \"II and III only.\""}] [{:db/id #edb/ref 17592186433716 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16957b53-7f2c-5897-8254-366068b7d73a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186433686} {:answer/id #uuid "5fc5b2e1-1001-57bc-9ebf-e1899b27c976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186433693} {:answer/id #uuid "698b7655-84cd-57ff-b48c-076442522213" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186433695} {:answer/id #uuid "974e648d-43b7-5056-bead-1b5c05bf7686" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186433700} {:answer/id #uuid "d1cec6f6-74c4-595e-b9a4-e8d9615d9af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186433704}] :answer-field/correct {:answer/id #uuid "d1cec6f6-74c4-595e-b9a4-e8d9615d9af5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186433704} :answer-field/id #uuid "263fbd38-e795-53f6-b66f-cb287c466369" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433712}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93f4dbff-c62f-571f-9c49-e5503854925a" :question/math-academy-id "q-109518" :question/problem "$$\nA=[\\begin{aligned}3 & -1 \\\\ 4 & -1\\end{aligned}],\\,v=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =1$ of $A$\n\nIII. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A-I:$\n\n$$\nA-I=[\\begin{aligned}3 & -1 \\\\ 4 & -1\\end{aligned}]-[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ 4 & -2\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-I:$\n\n$$\n(A-I)v=[\\begin{aligned}2 & -1 \\\\ 4 & -2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}]={{[\\begin{aligned}3 \\\\ 6\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-I:$\n\n$$\n(A-I)w=[\\begin{aligned}2 & -1 \\\\ 4 & -2\\end{aligned}][\\begin{aligned}3 \\\\ 6\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}2 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A-I\\,}{\\to }{{[\\begin{aligned}3 \\\\ 6\\end{aligned}]}_{⏟}}_{w}\\overset{A-I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =1$ of $A.$*\n\nSo, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186433717 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23feb840-9ea0-5b4a-9981-47d41adc532e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186433687} {:answer/id #uuid "31251623-175e-5172-b53d-93dabfd51773" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186433688} {:answer/id #uuid "e31b4d52-32a8-5673-be5d-c721da9231aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186433706} {:answer/id #uuid "ebc1826a-9a0c-57f0-84eb-fb71a37f6300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186433707} {:answer/id #uuid "ef393691-7df5-5626-987f-128f055c264d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186433708}] :answer-field/correct {:answer/id #uuid "ebc1826a-9a0c-57f0-84eb-fb71a37f6300" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186433707} :answer-field/id #uuid "1a5f1e17-ee64-5f88-acce-1fb89abad6f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433711}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3d67809-78b0-59dc-9828-ea082eca69bb" :question/math-academy-id "q-109476" :question/problem "$$\nA=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}],\\,v=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\nIII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=[\\begin{aligned}-2 & 1 \\\\ -1 & 0\\end{aligned}]+[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]={{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=[\\begin{aligned}-1 & 1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}0 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A+I\\,}{\\to }{{[\\begin{aligned}1 \\\\ 1\\end{aligned}]}_{⏟}}_{w}\\overset{A+I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186433718 :knowledge-point/_questions [{:db/id #edb/ref 17592186152224 :knowledge-point/id #uuid "a0abad78-e492-5d09-a04d-bce54605c78c" :knowledge-point/title "Identifying Generalized Eigenvectors of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4123c97a-32f0-5090-ad8f-278e9a0415cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186433689} {:answer/id #uuid "58792cac-2b0d-543d-8e9e-c8057305744f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186433690} {:answer/id #uuid "72e1debb-2d7b-595f-85d2-469a31d07a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186433698} {:answer/id #uuid "b5fda644-47ed-58ee-9a8b-8a80fc0d503b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186433702} {:answer/id #uuid "fb4e6251-9cc8-5873-b9c2-aab8505ef2cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186433709}] :answer-field/correct {:answer/id #uuid "72e1debb-2d7b-595f-85d2-469a31d07a3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186433698} :answer-field/id #uuid "148bd3ea-4973-557b-89b5-48219c1a378a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186433710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab77c5c3-a1c5-5710-a08d-82e66f9fdecd" :question/math-academy-id "q-109488" :question/problem "$$\nA=[\\begin{aligned}3 & -8 \\\\ 2 & -5\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\nII. $v$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =-1$ of $A$\n\nIII. $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =-1$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{2}$ of rank $2$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{2}\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{1}\\ne 0.$ Recall that an *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith this in mind, let's examine our statements.\n\nFirst, we compute $A+I:$\n\n$$\nA+I=[\\begin{aligned}3 & -8 \\\\ 2 & -5\\end{aligned}]+[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]=[\\begin{aligned}4 & -8 \\\\ 2 & -4\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A+I:$\n\n$$\n(A+I)v=[\\begin{aligned}4 & -8 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]={{[\\begin{aligned}4 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A+I:$\n\n$$\n(A+I)w=[\\begin{aligned}4 & -8 \\\\ 2 & -4\\end{aligned}][\\begin{aligned}4 \\\\ 2\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}1 \\\\ 0\\end{aligned}]}_{⏟}}_{v}\\overset{A+I\\,}{\\to }{{[\\begin{aligned}4 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\overset{A+I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A+I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-1$ of $A.$*\n\nSo, the correct answer is \"I only.\""}]}
