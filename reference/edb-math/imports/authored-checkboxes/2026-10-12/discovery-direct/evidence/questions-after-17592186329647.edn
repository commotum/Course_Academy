92186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450673}] :answer-field/correct {:answer/id #uuid "8a3c8024-a57d-59ab-916d-48c342bfd6e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450672} :answer-field/id #uuid "2a204198-fcd4-5ddf-9145-17e9ce86b916" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451290}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e0dd88-b99c-539d-9214-7424ba73f602" :question/math-academy-id "q-43775" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R$ and its subset $E$ containing all $2\\times 2$ matrices of the form $\\alpha A$ where $A$ is some fixed $2\\times 2$ matrix and $\\alpha \\in R.$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $E$ is closed under matrix addition\n- **II.** $E$ is closed under scalar multiplication\n- **III.** $E$ is a subspace of ${\\text{M}}_{2}(R)$\n- **IV.** $E$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. If ${A}_{1}={\\alpha }_{1}A$ and ${A}_{2}={\\alpha }_{2}A$ are two matrices from $E,$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & ={\\alpha }_{1}A+{\\alpha }_{2}A=({\\alpha }_{1}+{\\alpha }_{2})A,\\end{aligned}\n$$\n\nwhich is a matrix from $E.$ So, $E$ is closed under addition.\n\n- Statement II is true. If $B=\\alpha A$ is an element of $E$ and $k\\in R,$ then \n\n$$\n\\begin{aligned}kB & =k\\alpha A=(k\\alpha )A,\\end{aligned}\n$$\n\nwhich is a matrix from $E.$ So, $E$ is closed under scalar multiplication.\n\n- Statement III is true, while statement IV is false. $E$ is a subspace because it's closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186329725 :knowledge-point/_questions [{:db/id #edb/ref 17592186124590 :knowledge-point/id #uuid "8f306cf2-6881-5948-90bd-4e0ce98b4116" :knowledge-point/title "Identifying Subspaces of Matrix Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e9a6daa-2c5c-5d77-8eaa-a58d94167479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450674} {:answer/id #uuid "d89af215-5267-5e95-9757-df23474a69a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450675}] :answer-field/correct {:answer/id #uuid "0e9a6daa-2c5c-5d77-8eaa-a58d94167479" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450674} :answer-field/id #uuid "61bb832a-79c3-5328-91ba-8dd0eb7fdadd" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451291} {:answer-field/choices [{:answer/id #uuid "a474c2c6-f2da-58b7-9e81-b2a6b82aa3bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450676} {:answer/id #uuid "dc6e7dcc-d3b8-5ecd-b4c7-00ea67f1c59a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450677}] :answer-field/correct {:answer/id #uuid "a474c2c6-f2da-58b7-9e81-b2a6b82aa3bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450676} :answer-field/id #uuid "96b7a192-f629-5635-bfa3-37753ed09578" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451292} {:answer-field/choices [{:answer/id #uuid "11a4ac47-9b1c-5cf5-a5b8-2b469a15699c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450678} {:answer/id #uuid "c1212de0-72e5-5fc3-aa30-73a1543cfb73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450679}] :answer-field/correct {:answer/id #uuid "11a4ac47-9b1c-5cf5-a5b8-2b469a15699c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450678} :answer-field/id #uuid "54b11d7e-67ca-54c3-ae9b-753a27b9e2d0" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451293} {:answer-field/choices [{:answer/id #uuid "a50d9ad1-fce2-5784-8cd8-ca215ea647d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450680} {:answer/id #uuid "38a8a057-de72-5ac2-b282-c5e8be0a4b37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450681}] :answer-field/correct {:answer/id #uuid "38a8a057-de72-5ac2-b282-c5e8be0a4b37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450681} :answer-field/id #uuid "abe6e792-acc4-595d-954e-e541f5610ace" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76fb5f0d-770c-53e0-bb5c-9231d8688147" :question/math-academy-id "q-43776" :question/problem "Consider the vector space ${\\text{M}}_{2}(R)$ of all $2\\times 2$ matrices over $R,$ and its subset $L$ containing all invertible $2\\times 2$ matrices.\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $L$ is closed under matrix addition\n\n- **II.** $L$ is closed under scalar multiplication\n\n- **III.** $L$ is a subspace of ${\\text{M}}_{2}(R)$\n\n- **IV.** $L$ is **not** a subspace of ${\\text{M}}_{2}(R)$" :question/worked-solution "Recall that a subset of a vector space is a subspace if it's closed under addition and scalar multiplication.\n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. For example, if ${A}_{1}=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]$ and ${A}_{2}=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}],$ then\n\n$$\n\\begin{aligned}{A}_{1}+{A}_{2} & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]+[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is not a matrix from $L.$ So, $L$ is *not* closed under addition.\n\n- Statement II is false. For example if $A=[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]$ and $k=0,$ then \n\n$$\n\\begin{aligned}kA & =0\\cdot [\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}],\\end{aligned}\n$$\n\nwhich is not a matrix from $L.$ So, $L$ is *not* closed under scalar multiplication.\n\n- Statement III is false, while statement IV is true. $L$ is a *not* subspace because it's not closed under addition and scalar multiplication.\n\nTherefore, the correct answer is \"IV only.\""}] [{:db/id #edb/ref 17592186329726 :knowledge-point/_questions [{:db/id #edb/ref 17592186124591 :knowledge-point/id #uuid "9b1bb974-826a-590f-8d32-cdc868ca827c" :knowledge-point/title "Identifying Subspaces of Polynomial Vector Spaces"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7277ae2d-bbfb-518d-8c20-a53659bdb623" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/r