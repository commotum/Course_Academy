#{[{:db/id #edb/ref 17592186420265 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e1582c6-f975-57a2-bb84-29de70274193" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420196} {:answer/id #uuid "5d34d488-7731-54e1-adee-10ba7466acca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420208} {:answer/id #uuid "6b4b7a2b-3e52-5afd-8b75-c581575d9429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420213} {:answer/id #uuid "86a84e34-cc31-5936-aa5b-9bcfb65473f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420218} {:answer/id #uuid "a39f6118-e6af-5c4f-b439-8c10db5598d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420222}] :answer-field/correct {:answer/id #uuid "6b4b7a2b-3e52-5afd-8b75-c581575d9429" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420213} :answer-field/id #uuid "185758a4-16ad-57b8-bf67-872651eda925" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73c135de-ad71-58aa-a780-c01d04341240" :question/math-academy-id "q-221379" :question/problem "Which of the following statements are true?\n\nI. If $12∣h$ then $4∣h$\n\nII. If $4∣h$ then $2∣h$\n\nIII. If $3∣h$ then $12∣h$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $4∣12.$ Therefore, we have\n$4∣12$ and $12∣h,$ which implies that $4∣h.$\n\n- Statement II is true. First, note that $2∣4.$ Therefore, we have\n$2∣4$ and $4∣h,$ which implies that $2∣h.$\n\n- Statement III is false. As a counterexample, let $h=3.$ Then, $3∣3$ but $12∤3.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420269 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47123b5a-4d9e-5980-b7e8-1b9b31e1fa9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420201} {:answer/id #uuid "8d1afd65-b437-5472-b418-2dc1d6ebe865" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420219} {:answer/id #uuid "a964c9b7-bccb-5c9b-b3c7-48de44c00f07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I,II, and III" :db/id #edb/ref 17592186420224} {:answer/id #uuid "dcb9bd8f-1205-50c0-a72f-14df58d7f13a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420235} {:answer/id #uuid "e26579ec-ded1-5c35-9155-e69045a20a37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420239}] :answer-field/correct {:answer/id #uuid "dcb9bd8f-1205-50c0-a72f-14df58d7f13a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420235} :answer-field/id #uuid "b5e3230f-cb4f-51e8-a721-e24f62b0c3ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420252}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3b9fb7f-2262-5e34-bb97-3a915acfa755" :question/math-academy-id "q-93648" :question/problem "Which of the following statements are true?\n\nI. If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$\n\nII. If ${17}^{2}\\,|\\,17b$ then ${17}^{2}\\,|\\,b$\n\nIII. If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}({3}^{2},10)=1.$ Therefore, we have ${3}^{2}\\,|\\,10b$ and $\\text{gcd}({3}^{2},10)=1,$ which implies ${3}^{2}\\,|\\,b.$\n\n- Statement II is false. As a counterexample, let $b=17.$ Then, ${17}^{2}∣17\\cdot 17$ but ${17}^{2}∤17.$\n\n- Statement III is true. First, note that $\\text{gcd}(20,{3}^{3})=1.$ Therefore, we have $20\\,|\\,{3}^{3}b$ and $\\text{gcd}(20,{3}^{3})=1,$ which implies $20\\,|\\,b.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420695 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3513eb3f-f65e-5b39-ab1c-2e0b58c67dc8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420601} {:answer/id #uuid "665a3479-12d8-51d1-9eed-7d84f94d646e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420615} {:answer/id #uuid "aacccf24-6858-563c-a368-02680318f958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420640} {:answer/id #uuid "ab81e2eb-223d-52f9-b5de-9d8dd67a5c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420641} {:answer/id #uuid "f7d67e91-d0dd-56ab-88bd-f085b622e666" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420667}] :answer-field/correct {:answer/id #uuid "aacccf24-6858-563c-a368-02680318f958" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420640} :answer-field/id #uuid "109f3df2-8001-5a75-986f-5286bb95d15e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5116bec0-cc13-5aa6-83e8-d90bc6884457" :question/math-academy-id "q-183415" :question/problem "$\\,$ $(m>0\\,∧n>0)⇒(m\\cdot n>0)$\n\nWhich of the following statements are true regarding the true implication above?\n\n- $m>0\\,∧n>0$ is a **necessary** condition for $m\\cdot n>0$\n- $m>0\\,∧n>0$ is a **sufficient** condition for $m\\cdot n>0$\n- $m\\cdot n>0$ is a **necessary** condition for $m>0\\,∧n>0$\n- $m\\cdot n>0$ is a **sufficient** condition for $m>0\\,∧n>0$" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case,\n\n$$\n{{(\\,m>0\\,∧n>0\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,m\\cdot n>0\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement II is true. $m>0\\,∧n>0$ is a **sufficient** condition for $m\\cdot n>0.$\n\n- Statement III is true. $m\\cdot n>0$ is a **necessary** condition for $m>0\\,∧n>0.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420697 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "466de1f8-413a-58e0-83b2-57258605ef5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186420607} {:answer/id #uuid "670334a2-3e2f-5183-94b3-36d66edcbb09" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420617} {:answer/id #uuid "89bf88fa-6413-59a1-9725-dd8030421b7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420632} {:answer/id #uuid "bcb39f58-4569-5a76-967b-4523f30abcba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420649} {:answer/id #uuid "d3dc5f69-7dfb-5a28-bec4-84c487c5398a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420655}] :answer-field/correct {:answer/id #uuid "d3dc5f69-7dfb-5a28-bec4-84c487c5398a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420655} :answer-field/id #uuid "263ae040-cfff-57c0-86ac-4eb2766a4038" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420675}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bbf3a4e-b9b9-5f74-9d97-2501c2b02398" :question/math-academy-id "q-183393" :question/problem "$\\,$ If $l$ and $m$ are coplanar and perpendicular lines, then $l\\cap m\\ne ∅.$\n\nWhich of the following statements are true regarding the implication above?\n\n- $l$ and $m$ being coplanar and perpendicular lines is a **necessary** condition for $l\\cap m\\ne ∅$\n- $l\\cap m\\ne ∅$ is a **necessary** condition for $l$ and $m$ being coplanar and perpendicular lines\n- $l$ and $m$ being coplanar and perpendicular lines is a **sufficient** condition for $l\\cap m\\ne ∅$\n- $l\\cap m\\ne ∅$ is a **sufficient** condition for $l$ and $m$ being coplanar and perpendicular lines" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, \n\n$$\n{{(\\,l,m\\text{ are coplanar and perpendicular lines}\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,l\\cap m\\ne ∅\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement II is true. $l\\cap m\\ne ∅$ is a **necessary** condition for $l$ and $m$ being coplanar and perpendicular lines\n\n- Statement III is true. $l$ and $m$ being coplanar and perpendicular lines is a **sufficient** condition for $l\\cap m\\ne ∅$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420701 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ffdc366-69cf-5944-b0cd-2f7732814b49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420600} {:answer/id #uuid "76687a4d-5975-5d07-81a2-0eb09b75fee8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420622} {:answer/id #uuid "a8d7266e-b546-58f6-b4ee-21beeed5e5d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id #edb/ref 17592186420637} {:answer/id #uuid "e33ff8b5-a92f-57e5-8a74-3a68707fbea9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420656} {:answer/id #uuid "f92a005c-a42e-5839-95ae-334f90548200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420669}] :answer-field/correct {:answer/id #uuid "f92a005c-a42e-5839-95ae-334f90548200" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420669} :answer-field/id #uuid "344fa06c-13bf-58d0-ac53-1e5a4e31e4b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bd31a8b1-49f0-5bbe-9bfb-4daa99eb8e90" :question/math-academy-id "q-216328" :question/problem "$\\,$ If $P$ and $Q$ are congruent triangles, then $P$ and $Q$ have the same area.\n\nWhich of the following statements are true regarding the implication above?\n\n- $P$ and $Q$ being congruent triangles is a **necessary** condition for $P$ and $Q$ having the same area\n- $P$ and $Q$ having the same area is a **necessary** condition for $P$ and $Q$ being congruent triangles\n- $P$ and $Q$ being congruent triangles is a **sufficient** condition for $P$ and $Q$ having the same area\n- $P$ and $Q$ having the same area is a **sufficient** condition for $P$ and $Q$ being congruent triangles" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, \n\n$$\n{{(\\,P\\text{ and }Q\\text{ are congruent triangles}\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,P\\text{ and }Q\\text{ have the same area}\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement II is true. $P$ and $Q$ having the same area is a **necessary** condition for $P$ and $Q$ being congruent triangles.\n\n- Statement III is true. $P$ and $Q$ being congruent triangles is a **sufficient** condition for $P$ and $Q$ having the same area.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420705 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "Identifying Necessary or Sufficient Conditions From Implications"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66a20978-052e-5ad7-9f1d-9b0b7ee114ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420616} {:answer/id #uuid "ac9207f2-28a9-50c4-93b1-f0bbca2c7354" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186420642} {:answer/id #uuid "b2bc00bc-102f-56a7-ae97-c99fdc494631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420645} {:answer/id #uuid "f456c94d-ebd4-5f0b-b470-ffd45783554a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420662} {:answer/id #uuid "f63ab2d4-d54d-595f-9f13-411bad3bf356" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186420664}] :answer-field/correct {:answer/id #uuid "f456c94d-ebd4-5f0b-b470-ffd45783554a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id #edb/ref 17592186420662} :answer-field/id #uuid "c6698986-949b-5e23-a1b3-d50a3d4acb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb9b0e1b-3e64-5482-b003-6352af7b5cae" :question/math-academy-id "q-183396" :question/problem "$\\,$ If $A⊂B,$ then $A\\cap \\overset{―}{B}=∅.$\n\nWhich of the following statements are true regarding the implication above?\n\n- $A\\cap \\overset{―}{B}=∅$ is a **necessary** condition for $A⊂B$\n- $A⊂B$ is a **necessary** condition for $A\\cap \\overset{―}{B}=∅$\n- $A\\cap \\overset{―}{B}=∅$ is a **sufficient** condition for $A⊂B$\n- $A⊂B$ is a **sufficient** condition for $A\\cap \\overset{―}{B}=∅$" :question/worked-solution "Given that the implication $S⇒N$ is true, we have the following:\n\n- $S$ being true *guarantees* that $N$ must also be true. Therefore, $S$ is a *sufficient condition* for $N.$\n\n- For $S$ to be true, it is *necessary* that $N$ is true. Therefore, $N$ is a *necessary condition* for $S.$ However, note that $N$ being true does *not* guarantee that $S$ is true.\n\nThese ideas can be summarized as follows:\n\n$$\n\\text{S}\\text{ufficient}\\,⇒\\,\\text{N}\\text{ecessary}.\n$$\n\n  \n\nIn our case, \n\n$$\n{{(\\,A⊂B\\,)}_{⏟}}_{\\text{sufficient}}\\,⇒\\,{{(\\,A\\cap \\overset{―}{B}=∅\\,)}_{⏟}}_{\\text{necessary}}\n$$\n\nis a true statement. Therefore:\n\n- Statement I is true. $A\\cap \\overset{―}{B}=∅$ is a **necessary** condition for $A⊂B.$\n\n- Statement IV is true. $A⊂B$ is a **sufficient** condition for $A\\cap \\overset{―}{B}=∅.$\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186420986 :knowledge-point/_questions [{:db/id #edb/ref 17592186054634 :knowledge-point/id #uuid "a6128eca-7f76-5386-9d67-d81db2943eeb" :knowledge-point/title "Computing a Cartesian Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117c917b-7d62-5b51-804f-8f0f908de52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186420961} {:answer/id #uuid "24030462-28a2-5ff6-ab9c-6ac8a212b6d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186420962} {:answer/id #uuid "8a3b603c-2196-5e99-b012-5950a3d2c4b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186420972} {:answer/id #uuid "c5a110c3-4357-5dd4-8b2e-d63c84712e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420976} {:answer/id #uuid "f94df467-1917-54c6-9462-f00a0bb4ad5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186420980}] :answer-field/correct {:answer/id #uuid "c5a110c3-4357-5dd4-8b2e-d63c84712e94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186420976} :answer-field/id #uuid "e6a82ca7-01c6-5a96-826e-af1700b4e1e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186420983}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f4365e0-4fb2-5b82-b78f-2c814bc881e5" :question/math-academy-id "q-182014" :question/problem "For the sets $A=\\{0,1,2\\},$ $B=\\{4,6,8\\},$ and $C=A\\times B,$ determine which of the following statements are true.\n\nI. $(0,2)\\in C$\n\nII. $(1,8)\\in C$\n\nIII. $(0,6)\\in C$" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\nIn this case, the schematic for $A\\times B$ is shown below.\n\n![](images/12/12d1b94cc6d53954a9c164bd069f77fcddc7a46de2c1701c1f4cdfc608eef185.png)\n\nHence, the set $C=A\\times B$ is given by\n\n$$\nC={(0,4),(0,6),(0,8),(1,4),(1,6),(1,8),(2,4),(2,6),(2,8)}.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186421406 :knowledge-point/_questions [{:db/id #edb/ref 17592186152066 :knowledge-point/id #uuid "b70dd396-b01a-51e6-a52c-8ff729f48c45" :knowledge-point/title "Determining Whether a Standard Relation Is an Equivalence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39fee494-92f8-5270-a473-d2107e7e8874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421324} {:answer/id #uuid "3fa9caf0-df86-5322-b028-e17f40231f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421326} {:answer/id #uuid "6f67c691-2dcd-52d8-87bc-d5e99dedc4c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421347} {:answer/id #uuid "a05287c6-dfca-5030-894f-a2656886976e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421359} {:answer/id #uuid "bffd83c6-f97d-535a-871d-3201a645b707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421368}] :answer-field/correct {:answer/id #uuid "3fa9caf0-df86-5322-b028-e17f40231f57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421326} :answer-field/id #uuid "52a03d34-71d7-5d2a-9d61-7aebbc62d675" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421390}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1b086cc6-e229-5377-bb89-5a8ff879bb27" :question/math-academy-id "q-214271" :question/problem "Consider the following relation defined on the set $P(A),$ where $A={1,2,3,…,10}.$ \n\n$$\nX\\,R\\,Y\\,⇔\\,|X|=|Y|\n$$\n\n Which of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive. For all $X\\in P(A),$ $|X|\\,=\\,|X|.$\n\n- The relation $R$ is symmetric. For all $X,Y\\in P(A),$ if $|X|\\,=\\,|Y|,$ then $|Y|=|X|.$\n\n- The relation $R$ is transitive. For all $X,Y,Z\\in P(A),$ if $|X|=|Y|$ and $|Y|=|Z|,$ then $|X|=|Z|.$\n\n- The relation $R$ is an equivalence relation since it's reflexive, symmetric, and transitive.\n\nTherefore, the correct answer is \"I, II, III, and IV only.\""}] [{:db/id #edb/ref 17592186421409 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6549b369-142b-53da-b553-4facda5dbfe5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421342} {:answer/id #uuid "b40d20c9-3655-52ec-b8aa-91f39c99b226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421364} {:answer/id #uuid "b81f025c-684f-5d52-9d18-235fa3336997" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421367} {:answer/id #uuid "c3273c40-cfce-55eb-8615-3692dd6d5895" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186421369} {:answer/id #uuid "ce88d57b-0226-5ecc-89db-39d37dd6f50e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421373}] :answer-field/correct {:answer/id #uuid "b40d20c9-3655-52ec-b8aa-91f39c99b226" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421364} :answer-field/id #uuid "aa93e163-1d01-58a1-bdb6-eb95656804a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ee391cd-217d-5ff1-a899-24ea6980b5eb" :question/math-academy-id "q-214279" :question/problem "Consider the relation $R$ on the set $A={∗,⋆,∘,⋄}$ defined as \n\n$$\nR={(∗,∗),(⋆,⋆),(∘,∘),(⋄,⋄),(∗,⋆),(⋆,∗)}.\n$$\n\nWhich of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive because $(∗,∗),(⋆,⋆),(∘,∘),(⋄,⋄)\\in R.$$\\,\\,✓$\n\n- The relation $R$ is symmetric because $(y,x)\\in R$ whenever $(x,y)\\in R.$$\\,\\,✓$\n\n- The relation $R$ is transitive because for all $x,y,z\\in {∗,⋆,∘,⋄},$ if  $(x,y)\\in R$ and $(y,z)\\in R,$  then $(x,z)\\in R.$ Recall that it's sufficient to check only the cases when both pairs have different components: \n\n- $(∗,⋆)\\in R$ and $(⋆,∗)\\in R,$ and also $(∗,∗)\\in R$ $\\,\\,✓$\n\n- $(⋆,∗)\\in R$ and $(∗,⋆)\\in R,$ and also $(⋆,⋆)\\in R$$\\,\\,✓$\n\n- Since $R$ is reflexive, symmetric, and transitive, it is an equivalence relation.$\\,\\,✓$\n\nTherefore, the correct answer is \"I, II, III, and IV.\""}] [{:db/id #edb/ref 17592186421412 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0327b892-d3d1-5fb3-b2f0-3b4c1f296dde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421314} {:answer/id #uuid "3aa8f00c-f005-593e-8e78-a866a0839afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186421325} {:answer/id #uuid "6ff811d1-d506-5b23-8e83-bc217090e57c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421348} {:answer/id #uuid "9161f808-0aca-580f-99a3-789451a1123e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421356} {:answer/id #uuid "9dfb0cac-6b03-5126-9a12-63bea663b5bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421358}] :answer-field/correct {:answer/id #uuid "9dfb0cac-6b03-5126-9a12-63bea663b5bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421358} :answer-field/id #uuid "e2bbacab-cf91-5eed-be7e-c39a7e7d8711" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421401}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73719e8c-e17e-53b6-804a-0ade3bbbaa7f" :question/math-academy-id "q-214273" :question/problem "Consider the relation $R$ on the set $A={a,b,c}$ defined as \n\n$$\nR={(a,a),(b,b),(c,c),(a,b),(b,a),(b,c),(c,b)}.\n$$\n\nWhich of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive because $(a,a),\\,(b,b),\\,(c,c)\\in R.$ $\\,\\,✓$\n\n- The relation $R$ is symmetric because $(y,x)\\in R$ whenever $(x,y)\\in R.$ $\\,\\,✓$\n\n- The relation $R$ is *not* transitive because $(a,b)\\in R$ and $(b,c)\\in R,$ but $(a,c)\\notin R$\n\n- The relation is *not* an equivalence relation since it's not transitive.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186421415 :knowledge-point/_questions [{:db/id #edb/ref 17592186152067 :knowledge-point/id #uuid "968df6ec-e87e-5770-9c11-e7c8d8a27e6c" :knowledge-point/title "Identifying Equivalence Relations on Finite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9f9465-cf5d-580a-9ff3-750b6c28f614" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, III, and IV" :db/id #edb/ref 17592186421320} {:answer/id #uuid "51f10fd9-b7c9-54fc-a041-a40a299e4aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421331} {:answer/id #uuid "9a50ef14-e242-54e6-8842-59f1b35210fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186421357} {:answer/id #uuid "b7315505-3d31-5c27-bce8-fce3301ee94f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421365} {:answer/id #uuid "dc8d78e5-cb92-5ee7-9999-50c90b8b56ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id #edb/ref 17592186421379}] :answer-field/correct {:answer/id #uuid "b7315505-3d31-5c27-bce8-fce3301ee94f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186421365} :answer-field/id #uuid "175e3445-e959-5d80-ae1e-e6de0e0b369c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421385}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ae54ed26-0094-5420-99d1-1b8455c5d0e3" :question/math-academy-id "q-214280" :question/problem "Consider the relation $R$ on the set $A={\\alpha ,\\beta }$ defined as \n\n$$\nR={(\\alpha ,\\alpha ),(\\alpha ,\\beta ),(\\beta ,\\beta )}.\n$$\n\nWhich of the following statements are true?\n\n- $R$ is reflexive\n- $R$ is symmetric\n- $R$ is transitive\n- $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is reflexive because $(\\alpha ,\\alpha ),(\\beta ,\\beta )\\in R.$$\\,\\,✓$\n\n- The relation $R$ is *not* symmetric because $(\\alpha ,\\beta )\\in R$ but $(\\beta ,\\alpha )\\notin R.$\n\n- The relation $R$ is transitive because it contains no \"linked\" pairs such that $(x,y)\\in R$ and $(y,z)\\in R.\\,✓$\n\n- The relation is *not* an equivalence relation since it's not symmetric.\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186421886 :knowledge-point/_questions [{:db/id #edb/ref 17592186133758 :knowledge-point/id #uuid "41c2d289-8df5-551b-9501-3a762c67386f" :knowledge-point/title "Identifying True Statements About the Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09065806-b133-53e7-a415-f60daab53b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421874} {:answer/id #uuid "201f2230-7957-57ee-9f4c-64a64340bee2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186421877} {:answer/id #uuid "650f79ed-8cca-54b7-b878-11eaac10aaa0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186421878} {:answer/id #uuid "71b3b29c-1c8b-59df-b6b7-57376201da06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186421879} {:answer/id #uuid "8aef25aa-ccf6-5e00-8e61-47a0af94462a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186421881}] :answer-field/correct {:answer/id #uuid "09065806-b133-53e7-a415-f60daab53b99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186421874} :answer-field/id #uuid "612fca8f-e7e8-5291-ad03-38fa3749ba41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186421884}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "34e8f50c-adbf-51d4-b0d4-a2150385ab67" :question/math-academy-id "q-39207" :question/problem "Suppose $(4a+2b)\\cdot a=0$, where $a\\ne 0.$ Which of the following statements are true? \n\nI. $a\\cdot a<0$\n\nII. $b\\cdot a=\\frac{1}{2}$\n\nIII. $b\\cdot a=-2(a\\cdot a)$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. Since $a\\ne 0,$ we must have $a\\cdot a>0.$\n\n- Statement II is false since it leads to a contradiction. If $b\\cdot a=\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}(4a+2b)\\cdot a & =0 \\\\ 4(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 4(a\\cdot a)+2(\\frac{1}{2}) & =0 \\\\ a\\cdot a & =-\\frac{1}{4},\\end{aligned}\n$$\n\nbut this is a contradiction since $a\\ne 0$ implies that $a\\cdot a>0.$\n\n- Statement III is true. Simplifying the expression $(4a+2b)\\cdot a=0$, we have\n\n$$\n\\begin{aligned}(4a+2b)\\cdot a & =0 \\\\ (4a)\\cdot a+(2b)\\cdot a & =0 \\\\ 4(a\\cdot a)+2(b\\cdot a) & =0 \\\\ 2(b\\cdot a) & =-4(a\\cdot a) \\\\ b\\cdot a & =-2(a\\cdot a)\\end{aligned}\n$$\n\nTherefore, we conclude that the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186423083 :knowledge-point/_questions [{:db/id #edb/ref 17592186192801 :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0019d257-76eb-58eb-993a-0411c1c8ea5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186423057} {:answer/id #uuid "0345689f-fc2f-5460-9f38-e059246fb16f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186423058} {:answer/id #uuid "4c86aada-f7d7-57c4-bae2-63a127ef9b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186423063} {:answer/id #uuid "56eca2a0-0c43-50ef-b63f-0ce7a632d9be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186423064} {:answer/id #uuid "76159088-6817-5983-996b-f9485affcb33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186423067}] :answer-field/correct {:answer/id #uuid "76159088-6817-5983-996b-f9485affcb33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186423067} :answer-field/id #uuid "857db1a9-5baa-547f-ad7c-ffed08bafef2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423078}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d743af0-a7a6-59cf-8a8b-38734a18e7f0" :question/math-academy-id "q-160458" :question/problem "$$\nf(x)=\\{\\begin{aligned}3{e}^{3x-1},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\le 0$\n\nII. ${\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x=1$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\le 0,$ we have $f(x)=3{e}^{3x-1}\\ge 0.$\n\n- Statement II is false. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}f(x)\\,\\text{d}x & ={\\int }_{-\\infty }^{0}3{e}^{3x-1}\\,\\text{d}x \\\\  & ={e}^{3x-1}\\,{|}_{-\\infty }^{0} \\\\  & ={e}^{-1}-0 \\\\  & ={e}^{-1}\\end{aligned}\n$$\n\n- Statement III is false. Since statement II is false, $f(x)$ is not a valid probability density function.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186423084 :knowledge-point/_questions [{:db/id #edb/ref 17592186192801 :knowledge-point/id #uuid "441a1de0-dc64-59fe-99a8-0ab502841425" :knowledge-point/title "Checking Whether a Given Function Is a Valid PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a4da9c-5ad8-5dda-8ba1-be02f0af04f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186423060} {:answer/id #uuid "5d964b39-2482-5346-8612-8ce043b95788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186423066} {:answer/id #uuid "793d1056-34ae-50be-bbb1-25d45ceebdd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186423068} {:answer/id #uuid "80eb078c-af7c-5800-a93c-6a0513121c1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186423070} {:answer/id #uuid "84482c4e-d104-578b-9bca-d5349bf9e6b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186423072}] :answer-field/correct {:answer/id #uuid "5d964b39-2482-5346-8612-8ce043b95788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186423066} :answer-field/id #uuid "35e8275a-bb12-5f98-ba18-184bdee245ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186423077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7af6cdaa-d1ff-562c-9d47-7e9a37adf5ba" :question/math-academy-id "q-160446" :question/problem "$$\nf(x)=\\{\\begin{aligned}{e}^{-x},\\, & x\\ge 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$\n\nGiven the function $f(x)$ above, which of the following statements are true?\n\nI. $f(x)\\ge 0$ for all $x\\ge 0$\n\nII. ${\\int }_{0}^{\\infty }f(x)\\,\\text{d}x=1$\n\nIII. $f(x)$ is a valid probability density function" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nNow, let's consider each statement in turn:\n\n- Statement I is true. Indeed, for $x\\ge 0,$ we have $f(x)={e}^{-x}\\ge 0.$\n\n- Statement II is true. Indeed,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }f(x)\\,\\text{d}x & ={\\int }_{0}^{\\infty }{e}^{-x}\\,\\text{d}x \\\\  & =-{e}^{-x}\\,{|}_{0}^{\\infty } \\\\  & =-(0-{e}^{0}) \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is true. Since statements I and II are true, the first and second conditions are satisfied. So, $f(x)$ is a valid probability density function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186424829 :knowledge-point/_questions [{:db/id #edb/ref 17592186152126 :knowledge-point/id #uuid "f7063140-eebe-598c-b530-3c13509d359b" :knowledge-point/title "Classifying Numbers as Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65467c55-4012-565e-9f4c-86f2450043e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186424689} {:answer/id #uuid "957bcbbb-38da-5714-9fd9-7d21a88cb06e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186424718} {:answer/id #uuid "c9553ae8-cd77-5fb6-81e8-25583030b458" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186424745} {:answer/id #uuid "cf4041ac-449a-56ee-bec7-41438a2640f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186424748} {:answer/id #uuid "f6b336e0-5ad1-5621-824c-34d90d2ca6f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186424771}] :answer-field/correct {:answer/id #uuid "65467c55-4012-565e-9f4c-86f2450043e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186424689} :answer-field/id #uuid "8b791c26-12be-57d7-a745-4c7665ba6d9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186424796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d38c8439-616e-58d4-9fa5-c5876ae08e79" :question/math-academy-id "q-99327" :question/problem "Which of the following statements are true?\n\nI. $-\\frac{1}{9}$ is a natural number\n\nII. $-\\frac{1}{9}$ is an integer\n\nIII. $-\\frac{1}{9}$ is a rational number" :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of all numbers that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-\\frac{1}{9}$ is not a natural number.\n\n- $-\\frac{1}{9}$ is not an integer.\n\n- $-\\frac{1}{9}$ is a rational number because it can be written as $\\frac{(-1)}{9}.$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186425931 :knowledge-point/_questions [{:db/id #edb/ref 17592186152200 :knowledge-point/id #uuid "100ab73e-3dad-5b15-9da2-d244c67bcc9b" :knowledge-point/title "Identifying True Statements About Double Integrals Over Non-Rectangular Domains"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "034daae9-6479-5df1-9b65-7e6139e7a49a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186425911} {:answer/id #uuid "204a2417-b1ee-5a94-9387-92210e84c9fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186425912} {:answer/id #uuid "7bd19b67-41ce-5d20-9075-74172011db9f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186425917} {:answer/id #uuid "daf363de-8d31-5c81-8ebc-62bc6b37b91b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186425921} {:answer/id #uuid "fa68e695-7f74-50ec-acaf-b9b8df374c7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186425924}] :answer-field/correct {:answer/id #uuid "daf363de-8d31-5c81-8ebc-62bc6b37b91b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186425921} :answer-field/id #uuid "3b56bb6c-74dd-5bd4-a9cd-cbed30098ff9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186425927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c04d4c5-9913-59ea-a83f-46d8bb7c02cf" :question/math-academy-id "q-129893" :question/problem "Let $D$ be a finite region enclosed between the curve $y=-{x}^{2}+2$ and the $x$-axis. If \n\n$$\nf(x,y)=\\{\\begin{aligned}{x}^{2}+3y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\n \nwhich of the following statements are true?\n\nI. ${∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-1,1]\\times [-1,3]$\n\nII. ${∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\\,$ where $R=[-2,2]\\times [0,2]$\n\nIII. ${∬}_{R}({x}^{2}+3y)\\,\\text{d}A={∬}_{D}f(x,y)\\,\\text{d}A,\\,$ where $R=[-3,3]\\times [-4,4]$" :question/worked-solution "First, let's draw our region $D:$\n\n![](images/3b/3bfc135232008824ae0522bcc8454c5f97c2dfd13fb6e333e146a040ccbc1f22.png)\n\nNotice that if $R$ covers $D$ completely and we define \n\n$$\nf(x,y)=\\{\\begin{aligned}({x}^{2}+3y), & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D,\\end{aligned}\n$$\n\nwe obtain\n\n$$\n{∬}_{D}({x}^{2}+3y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given statements.\n\n- Statements I is false. The rectangle $R$ does not cover the region $D.$\n\n- Statements II is true. The rectangle $R$ covers the region $D$ completely.\n\n- Statement III is false. The integrals have not been stated correctly with respect to the domains $R$ and $D$ (they have been swapped).\n\nTherefore, the correct answer is \"II only.\""}]}
