swer.type/text} :answer/value "false" :db/id #edb/ref 17592186453986} {:answer/id #uuid "3fb0edc8-eed1-522b-871a-d42ecb5cb6f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453987}] :answer-field/correct {:answer/id #uuid "3fb0edc8-eed1-522b-871a-d42ecb5cb6f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453987} :answer-field/id #uuid "c8f87254-3e95-5dd2-a491-b28a6ca20070" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454743}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3f8540b5-4c77-553b-a7f5-1fd3c7ffd53b" :question/math-academy-id "q-77149" :question/problem "Given that $6a≡6b\\,(\\text{mod}\\,8),$ which of the following statements **must** be true?\n\nSelect all that apply.\n\n- **I.** $a≡b\\,(\\text{mod}\\,4)$\n\n- **II.** $a≡b\\,(\\text{mod}\\,8)$\n\n- **III.** $4a≡4b\\,(\\text{mod}\\,16)$" :question/worked-solution "The division properties of modular arithmetic state the following:\n\n- For $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\n- For $\\text{gcd}(k,n)=1,$ we have \n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWith that in mind, let's consider each statement.\n\n- Statement I is true, while statement II is false. Applying the first property, we have the following:\n\n$$\n\\begin{aligned}6a & ≡6b &  & (\\text{mod}\\,8) \\\\ 2\\cdot 3\\cdot a & ≡2\\cdot 3\\cdot b &  & (\\text{mod}\\,2\\cdot 4) \\\\ \\cancel{2}\\cdot 3\\cdot a & ≡\\cancel{2}\\cdot 3\\cdot b &  & (\\text{mod}\\,\\cancel{2}\\cdot 4) \\\\ 3a & ≡3b &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nSince $gcd(3,4)=1,$ by the second property, we have:\n\n$$\n3a≡3b\\,(\\text{mod}\\,4)\\,⟺\\,a≡b\\,(\\text{mod}\\,4)\n$$\n\n- Statement III is true. By statement I and the first property, we have:\n\n$$\n\\begin{aligned}a≡b\\,(\\text{mod}\\,4)\\,⟺\\,4a≡4b\\,(\\text{mod}\\,16)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186415045 :knowledge-point/_questions [{:db/id #edb/ref 17592186152096 :knowledge-point/id #uuid "3822141e-3cea-5c34-b925-a522c2273335" :knowledge-point/title "Combining the Division Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45927708-ff90-530f-9c49-6589da2a0246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453718} {:answer/id #uuid "a2f19037-913e-53a0-87f3-e498af471acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453719}] :answer-field/correct {:answer/id #uuid "a2f19037-913e-53a0-87f3-e498af471acb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453719} :answer-field/id #uuid "de738dcb-962f-5139-83fe-f8affe4ebde2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454609} {:answer-field/choices [{:answer/id #uuid "f79f95c2-e632-57ef-b188-147bc9327661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453720} {:answer/id #uuid "f93abe96-ace6-5edb-8560-456f3e885d8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453721}] :answer-field/correct {:answer/id #uuid "f79f95c2-e632-57ef-b188-147bc9327661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453720} :answer-field/id #uuid "0cd32cbc-22f8-5f9c-af40-d5451f3c10c5" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454610} {:answer-field/choices [{:answer/id #uuid "341092ad-150e-5fcb-b849-7b295fcb97bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453722} {:answer/id #uuid "748191c0-6ddd-5ac7-bdc1-f2b8ad231c78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453723}] :answer-field/correct {:answer/id #uuid "748191c0-6ddd-5ac7-bdc1-f2b8ad231c78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453723} :answer-field/id #uuid "81dbaedc-783b-5b68-8134-849222d627b5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454611}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "73a43b1a-0275-523e-ad37-d72b83b2b870" :question/math-academy-id "q-213296" :question/problem "Given that $10a≡10b\\,(\\text{mod}\\,6),$ which of the following statements **must** be true?\n\nSelect all that apply.\n\n- **I.** $a≡b\\,(\\text{mod}\\,3)$\n\n- **II.** $a≡b\\,(\\text{mod}\\,6)$\n\n- **III.** $5a≡5b\\,(\\text{mod}\\,15)$" :question/worked-solution "The division properties of modular arithmetic state the following:\n\n- For $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\n- For $\\text{gcd}(k,n)=1,$ we have \n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWith that in mind, let's consider each statement.\n\n- Statement I is true, while statement II is false. Applying the first property, we have the following:\n\n$$\n\\begin{aligned}10a & ≡10b &  & (\\text{mod}\\,6) \\\\ 2\\cdot 5\\cdot a & ≡2\\cdot 5\\cdot b &  & (\\text{mod}\\,2\\cdot 3) \\\\ \\cancel{2}\\cdot 5\\cdot a & ≡\\cancel{2}\\cdot 5\\cdot b &  & (\\text{mod}\\,\\cancel{2}\\cdot 3) \\\\ 5a & ≡5b &  & (\\text{mod}\\,3)\\end{aligned}\n$$\n\nSince $gcd(5,3)=1,$ by the second property, we have:\n\n$$\n5a≡5b\\,(\\text{mod}\\,3)\\,⟺\\,a≡b\\,(\\text{mod}\\,3)\n$$\n\n- Statement III is true. By statement I and the first property, we have:\n\n$$\n\\begin{aligned}a≡b\\,(\\text{mod}\\,3)\\,⟺\\,5a≡5b\\,(\\text{mod}\\,15)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186415046 :knowledge-point/_questions [{:db/id #edb/ref 17592186152096 :knowledge-point/id #uuid "3822141e-3cea-5c34-b925-a522c2273335" :knowledge-point/title "Combining the Division Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8df1f5-a326-5744-b94d-a8f8dbfaf3eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453736} {:answer/id #uuid "05e1a544-e990-505b-b4dd-5cf2c163f81e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453737}] :answer-field/correct {:answer/id #uuid "2f8df1f5-a326-5744-b94d-a8f8dbfaf3eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453736} :answer-field/id #uuid "2f272d94-f2e5-5bc4-8d99-cb3bdc0c9e77" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454618} {:answer-field/choices [{:answer/id #uuid "6d291526-f242-5aee-bbee-15dca92f7c4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453738} {:answer/id #uuid "1f74de5b-6f10-546d-b300-bc3936015893" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453739}] :answer-field/correct {:answer/id #uuid "1f74de5b-6f10-546d-b300-bc3936015893" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453739} :answer-field/id #uuid "097f5b2b-3a82-5378-a95b-73c99e48f1df" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454619} {:answer-field/choices [{:answer/id #uuid "2da2bbfb-eaba-5993-9806-64aa68804c3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453740} {:answer/id #uuid "f57814b7-cfe3-5ebe-abe3-d7767a52fb4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453741}] :answer-field/correct {:answer/id #uuid "f57814b7-cfe3-5ebe-abe3-d7767a52fb4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453741} :answer-field/id #uuid "6be5cbf0-52ed-5cd7-a9f3-ab127978d370" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454620}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a253797f-7a56-5114-8318-23c6ded7e919" :question/math-academy-id "q-213394" :question/problem "Given that $10a≡10b\\,(\\text{mod}\\,4),$ which of the following statements **must** be true?\n\nSelect all that apply.\n\n- **I.** $a≡b\\,(\\text{mod}\\,4)$\n\n- **II.** $a≡b\\,(\\text{mod}\\,2)$\n\n- **III.** $9a≡9b\\,(\\text{mod}\\,2)$" :question/worked-solution "The division properties of modular arithmetic state the following:\n\n- For $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\n- For $\\text{gcd}(k,n)=1,$ we have \n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWith that in mind, let's consider each statement.\n\n- Statement I is false, while statement II is true. Applying the first property, we have the following:\n\n$$\n\\begin{aligned}10a & ≡10b &  & (\\text{mod}\\,4) \\\\ 2\\cdot 5\\cdot a & ≡2\\cdot 5\\cdot b &  & (\\text{mod}\\,2\\cdot 2) \\\\ \\cancel{2}\\cdot 5\\cdot a & ≡\\cancel{2}\\cdot 5\\cdot b &  & (\\text{mod}\\,\\cancel{2}\\cdot 5) \\\\ 5a & ≡5b &  & (\\text{mod}\\,2)\\end{aligned}\n$$\n\nSince $gcd(5,2)=1,$ by the second property, we have:\n\n$$\n5a≡5b\\,(\\text{mod}\\,2)\\,⟺\\,a≡b\\,(\\text{mod}\\,2)\n$$\n\n- Statement III is true. By statement II and the second property, we have:\n\n$$\n\\begin{aligned}a≡b\\,(\\text{mod}\\,2)\\,⟺\\,9a≡9b\\,(\\text{mod}\\,2)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186415047 :knowledge-point/_questions [{:db/id #edb/ref 17592186152094 :knowledge-point/id #uuid "bca70f6c-d087-5b8e-aff2-581adca9ed1f" :knowledge-point/title "Using the First Division Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "215a3373-c92b-5c76-a4aa-8454ff12465a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453102} {:answer/id #uuid "cdae0bbe-0548-5c6a-8e4c-2659c4b03746" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453103}] :answer-field/correct {:answer/id #uuid "215a3373-c92b-5c76-a4aa-8454ff12465a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453102} :answer-field/id #uuid "b286f757-c4a9-549a-af99-b2c466dac029" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454301} {:answer-field/choices [{:answer/id #uuid "b19bd3d0-0305-5a5a-ae7c-5fd65541f397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453104} {:answer/id #uuid "55d60b87-ecc4-58bf-9ce9-8c13885c95b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453105}] :answer-field/correct {:answer/id #uuid "55d60b87-ecc4-58bf-9ce9-8c13885c95b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453105} :answer-field/id #uuid "f935b726-d481-597f-9800-4e23100000cb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454302} {:answer-field/choices [{:answer/id #uuid "ae166ede-2a92-5e22-a248-5406db0b0133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453106} {:answer/id #uuid "ee84c16f-325f-5ece-90ba-2114c5a76e05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453107}] :answer-field/correct {:answer/id #uuid "ae166ede-2a92-5e22-a248-5406db0b0133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453106} :answer-field/id #uuid "dfbb6054-d1be-5f93-a093-b2c8e849540a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4019e4a-38d9-5f9b-be44-5c0d23af5290" :question/math-academy-id "q-103171" :question/problem "Given that $2a≡2b\\,(\\text{mod}\\,8),$ which of the following statements **must** be true?\n\nSelect all that apply.\n\n- **I.** $a≡b\\,(\\text{mod}\\,6)$\n\n- **II.** $a≡b\\,(\\text{mod}\\,4)$\n\n- **III.** $a≡b\\,(\\text{mod}\\,8)$" :question/worked-solution "The division property of modular arithmetic states that for $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWe're asked to consider the following statement:\n\n$$\n2a≡2b\\,(\\text{mod}\\,8)\n$$\n\nNotice that $\\text{gcd}(2,8)=2.$\n\nApplying the division property, we have the following:\n\n$$\n\\begin{aligned}2a & ≡2b &  & (\\text{mod}\\,8) \\\\ 2\\cdot a & ≡2\\cdot b &  & (\\text{mod}\\,2\\cdot 4) \\\\ \\cancel{2}\\cdot a & ≡\\cancel{2}\\cdot b &  & (\\text{mod}\\,\\cancel{2}\\cdot 4) \\\\ a & ≡b &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186415049 :knowledge-point/_questions [{:db/id #edb/ref 17592186152096 :knowledge-point/id #uuid "3822141e-3cea-5c34-b925-a522c2273335" :knowledge-point/title "Combining the Division Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "551f0b7d-81e5-5a0c-85ad-ee3443a9ac05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453730} {:answer/id #uuid "26c14664-1010-5406-a08a-c5f282d03a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453731}] :answer-field/correct {:answer/id #uuid "26c14664-1010-5406-a08a-c5f282d03a0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453731} :answer-field/id #uuid "6d627ec5-3122-5886-aba1-f7ca43ccab0a" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454615} {:answer-field/choices [{:answer/id #uuid "47aab34d-d405-565c-b065-276e17d2ef29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453732} {:answer/id #uuid "dd687af5-136d-54a7-b6be-55f311c4b328" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453733}] :answer-field/correct {:answer/id #uuid "47aab34d-d405-565c-b065-276e17d2ef29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453732} :answer-field/id #uuid "404c6b13-338a-5bba-9714-6cf1dc4bf388" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454616} {:answer-field/choices [{:answer/id #uuid "b2ea069e-68e9-5f34-8ba8-e9524f37e465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453734} {:answer/id #uuid "0078cc05-b102-5887-ab18-437410f29d26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453735}] :answer-field/correct {:answer/id #uuid "0078cc05-b102-5887-ab18-437410f29d26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453735} :answer-field/id #uuid "605e7eae-f89a-5236-a71d-ea2132fe786a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ca808cf3-f807-5d95-a81f-b5460b52df5b" :question/math-academy-id "q-213392" :question/problem "Given that $3a≡3b\\,(\\text{mod}\\,9),$ which of the following statements **must** be true?\n\nSelect all that apply.\n\n- **I.** $a≡b\\,(\\text{mod}\\,3)$\n\n- **II.** $a≡b\\,(\\text{mod}\\,9)$\n\n- **III.** $4a≡4b\\,(\\text{mod}\\,3)$" :question/worked-solution "The division properties of modular arithmetic state the following:\n\n- For $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\n- For $\\text{gcd}(k,n)=1,$ we have \n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWith that in mind, let's consider each statement.\n\n- Statement I is true, while statement II is false. Applying the first property, we have the following:\n\n$$\n\\begin{aligned}3a & ≡3b &  & (\\text{mod}\\,9) \\\\ 3\\cdot a & ≡3\\cdot b &  & (\\text{mod}\\,3\\cdot 3) \\\\ \\cancel{3}\\cdot a & ≡\\cancel{3}\\cdot b &  & (\\text{mod}\\,\\cancel{3}\\cdot 3) \\\\ a & ≡b &  & (\\text{mod}\\,3)\\end{aligned}\n$$\n\n- Statement III is true. By statement I and the second property, we have:\n\n$$\n\\begin{aligned}a≡b\\,(\\text{mod}\\,3)\\,⟺\\,4a≡4b\\,(\\text{mod}\\,3)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186415051 :knowledge-point/_questions [{:db/id #edb/ref 17592186152094 :knowledge-point/id #uuid "bca70f6c-d087-5b8e-aff2-581adca9ed1f" :knowledge-point/title "Using the First Division Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e89cf2-06e0-5398-8753-970f44e06da1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453096} {:answer/id #uuid "e65928c6-1755-58d7-afe6-af81f2e18bb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453097}] :answer-field/correct {:answer/id #uuid "82e89cf2-06e0-5398-8753-970f44e06da1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453096} :answer-field/id #uuid "9ee3331f-371c-59cf-8aea-4634363e0b0e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454298} {:answer-field/choices [{:answer/id #uuid "5c37544a-78d9-5d1e-970f-c6e77d857e8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453098} {:answer/id #uuid "b06a7d11-7b5e-5e92-92fc-c73ab108160b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453099}] :answer-field/correct {:answer/id #uuid "b06a7d11-7b5e-5e92-92fc-c73ab108160b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453099} :answer-field/id #uuid "07fbac1d-135b-5cbb-8002-714d3bf0845c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454299} {:answer-field/choices [{:answer/id #uuid "b57a3b84-f9e4-52dd-8bbb-9a58dee94b9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453100} {:answer/id #uuid "e40c642a-e2b4-5e2c-a7f0-d2023a84eb8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453101}] :answer-field/correct {:answer/id #uuid "b57a3b84-f9e4-52dd-8bbb-9a58dee94b9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453100} :answer-field/id #uuid "2534715f-1d54-5a13-8947-b595d2367807" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d23e3ed0-5575-5880-b9bf-7ff1adfe9936" :question/math-academy-id "q-103168" :question/problem "Given that $3a≡3b\\,(\\text{mod}\\,12),$ which of the following statements **must** be true?\n\nSelect all that apply.\n\n- **I.** $a≡b\\,(\\text{mod}\\,3)$\n\n- **II.** $a≡b\\,(\\text{mod}\\,4)$\n\n- **III.** $a≡b\\,(\\text{mod}\\,6)$" :question/worked-solution "The division property of modular arithmetic states that for $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWe're asked to consider the following statement:\n\n$$\n3a≡3b\\,(\\text{mod}\\,12)\n$$\n\nNotice that $\\text{gcd}(3,12)=3.$\n\nApplying the division property, we have the following:\n\n$$\n\\begin{aligned}3a & ≡3b &  & (\\text{mod}\\,12) \\\\ 3\\cdot a & ≡3\\cdot b &  & (\\text{mod}\\,3\\cdot 4) \\\\ \\cancel{3}\\cdot a & ≡\\cancel{3}\\cdot b &  & (\\text{mod}\\,\\cancel{3}\\cdot 4) \\\\ a & ≡b &  & (\\text{mod}\\,4)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186415061 :knowledge-point/_questions [{:db/id #edb/ref 17592186124485 :knowledge-point/id #uuid "486cc512-416b-5eac-8964-1a87d533de72" :knowledge-point/title "Determining if a Given Set Is Linearly Independent Given Information on Its Elements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c31adaa2-aedb-51ee-98cc-f5a5cb7cb242" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453874} {:answer/id #uuid "063facdd-b115-5116-95a9-caa5bdab8f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453875}] :answer-field/correct {:answer/id #uuid "c31adaa2-aedb-51ee-98cc-f5a5cb7cb242" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453874} :answer-field/id #uuid "a2096ae6-ffb1-5d8a-b2ca-ba762fb6d409" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454687} {:answer-field/choices [{:answer/id #uuid "3745e8da-fba3-5de6-8ee2-c06592f6933b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453876} {:answer/id #uuid "5f81960a-dd97-5893-98af-f4a31d1a3af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453877}] :answer-field/correct {:answer/id #uuid "5f81960a-dd97-5893-98af-f4a31d1a3af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453877} :answer-field/id #uuid "2316b283-b952-57f0-ab87-cfeeb442fa55" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454688} {:answer-field/choices [{:answer/id #uuid "890bce99-21fe-5928-b77c-8e07e141f72f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453878} {:answer/id #uuid "8e7aea04-d3e3-5812-868c-e15e8ab20d51" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453879}] :answer-field/correct {:answer/id #uuid "890bce99-21fe-5928-b77c-8e07e141f72f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453878} :answer-field/id #uuid "33daad36-10f5-52d9-b312-d81cb77a900b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454689}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0c07b7ca-2c8b-5a74-a857-c6a369e5fb28" :question/math-academy-id "q-35580" :question/problem "Consider a vector space $V$ and vectors ${v}_{1},{v}_{2},{v}_{3},{v}_{4}\\in V.$ Given that ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is linearly dependent and ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ has only zero solution ${x}_{1}={x}_{2}={x}_{3}={x}_{4}=0$\n- **II.** ${v}_{2}$ is a linear combination of ${v}_{1}$, ${v}_{3}$ and ${v}_{4}$\n- **III.** ${v}_{4}$ is a linear combination of ${v}_{1}$ and ${v}_{3}$" :question/worked-solution "Let's examine each of the given options in turn.\n\n- Statement I is false. Since ${{v}_{1},{v}_{2},{v}_{3},{v}_{4}}$ is a linearly dependent set, we obtain that\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nhas a non-zero solution.\n\n- Statement II is true. Indeed, solving equation ${x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0$ for ${v}_{2},$ we obtain\n\n$$\n{v}_{2}=-\\frac{{x}_{1}}{{x}_{2}}{v}_{1}-\\frac{{x}_{3}}{{x}_{2}}{v}_{3}-\\frac{{x}_{4}}{{x}_{2}}{v}_{4}.\n$$\n\nMoreover, ${x}_{2}$ can't be zero because then\n\n$$\n{x}_{1}{v}_{1}+{x}_{3}{v}_{3}+{x}_{4}{v}_{4}=0\n$$\n\nwill have a non-zero solution and that's a contradiction as ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent.\nHence, ${v}_{2}$ is a linear combination of ${v}_{1}$, ${v}_{3}$ and ${v}_{4}.$\n\n- Statement III is false. Since the set ${{v}_{1},{v}_{3},{v}_{4}}$ is linearly independent set, the equation \n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{3}+{x}_{3}{v}_{4}=0\n$$\n\nhas no non-zero solution. Hence, ${v}_{4}$ is not a linear combination of ${v}_{1}$ and ${v}_{3}$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186415272 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59393bce-26a0-53f4-b9ee-a4b60e0309ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453336} {:answer/id #uuid "d3ec25f8-9101-5ec4-ae2b-1947b4fed11b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453337}] :answer-field/correct {:answer/id #uuid "d3ec25f8-9101-5ec4-ae2b-1947b4fed11b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453337} :answer-field/id #uuid "6aafa3ab-4c0c-5ec8-8508-509f0aa15d9e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454418} {:answer-field/choices [{:answer/id #uuid "59eb0512-2892-504c-817d-6e1c62f596b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453338} {:answer/id #uuid "8c2be482-8af1-5d7d-8d56-389be603fc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453339}] :answer-field/correct {:answer/id #uuid "8c2be482-8af1-5d7d-8d56-389be603fc9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453339} :answer-field/id #uuid "359d2acf-2ea6-56b6-a467-a84c75cf4d9e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454419} {:answer-field/choices [{:answer/id #uuid "7762d99b-6748-51f0-9769-d7e020b910e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453340} {:answer/id #uuid "761205e9-2c61-502f-8e9d-e4e3f37407aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453341}] :answer-field/correct {:answer/id #uuid "7762d99b-6748-51f0-9769-d7e020b910e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453340} :answer-field/id #uuid "95713f76-4916-53c2-b271-58871420022e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454420}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0027cfb5-d932-549f-8cc6-973642895e8d" :question/math-academy-id "q-125743" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{x}\\operatorname{sin}⁡y,\\,{e}^{x}\\operatorname{cos}⁡y⟩$ and the points $O(0,0)$ and $A(1,\\frac{\\pi }{2})$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $F$ is conservative.\n\n- **II.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=e,$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$\n\n- **III.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=2e-1,$ where ${C}_{2}$ is the path along the curve $y=\\frac{\\pi }{2}\\sqrt{x},$ traversed from $O$ to $A.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{x}\\operatorname{cos}⁡y.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf={e}^{x}\\operatorname{sin}⁡y.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(1,\\frac{\\pi }{2})-f(0,0) \\\\  & ={e}^{1}\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})-{e}^{0}\\cdot \\operatorname{sin}⁡0 \\\\  & =e\\cdot 1-0 \\\\  & =e.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=e.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415275 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e94047db-68c4-551f-9095-b7004ca8440d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453324} {:answer/id #uuid "bb26d5f6-a66c-5844-b1b4-09be8fba0088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453325}] :answer-field/correct {:answer/id #uuid "bb26d5f6-a66c-5844-b1b4-09be8fba0088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453325} :answer-field/id #uuid "72a92e66-5e63-57a1-a0c4-007b140902d2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454412} {:answer-field/choices [{:answer/id #uuid "90c212f9-6c73-5efa-827a-5c7e1827ff4d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453326} {:answer/id #uuid "d032a76d-d4bb-5471-9f1d-f875814c51b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453327}] :answer-field/correct {:answer/id #uuid "d032a76d-d4bb-5471-9f1d-f875814c51b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453327} :answer-field/id #uuid "7023734c-f76f-51a8-9faa-f0979cbea5ab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454413} {:answer-field/choices [{:answer/id #uuid "09069a3c-ed3c-50a5-9d67-301f8b9abc91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453328} {:answer/id #uuid "da2b872b-a120-58a1-8c06-6c98a0c03cdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453329}] :answer-field/correct {:answer/id #uuid "09069a3c-ed3c-50a5-9d67-301f8b9abc91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453328} :answer-field/id #uuid "7125f222-da47-5c32-9e27-3e728ad73ef9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41c787c2-8fe3-51ae-aef3-bfbcd04677ea" :question/math-academy-id "q-125720" :question/problem "Consider the vector field $F(x,y)=⟨y,\\,x⟩$ and the points $O(0,0)$ and $A(\\sqrt{2},2)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $F$ is conservative.\n\n- **II.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=2\\sqrt{2},$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$\n\n- **III.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=-\\sqrt{2},$ where ${C}_{2}$ is the path along the curve $y={x}^{2},$ traversed from $O$ to $A.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}=1.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf=xy.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(\\sqrt{2},2)-f(0,0) \\\\  & =\\sqrt{2}\\cdot 2-0\\cdot 0 \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{1},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r=2\\sqrt{2}.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415281 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d72dfe19-644e-58ac-b092-ca0bf0a32235" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453330} {:answer/id #uuid "8d3cb706-2c7c-59c6-9797-8f2413c3c0ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453331}] :answer-field/correct {:answer/id #uuid "8d3cb706-2c7c-59c6-9797-8f2413c3c0ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453331} :answer-field/id #uuid "3aa85dc7-977b-504c-9e63-6eaa9497ca86" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454415} {:answer-field/choices [{:answer/id #uuid "6fc76864-a6b1-5bc1-9012-9c15cd8d9c39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453332} {:answer/id #uuid "9de221a3-7ed0-563b-8bfe-b20e6e8988e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453333}] :answer-field/correct {:answer/id #uuid "9de221a3-7ed0-563b-8bfe-b20e6e8988e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453333} :answer-field/id #uuid "6454a9c4-5959-5c99-9e74-da908dab25c3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454416} {:answer-field/choices [{:answer/id #uuid "fea26c04-19a4-5d02-95f7-713e29db1fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453334} {:answer/id #uuid "05e0a248-34b8-5d04-9e61-a958287d7eba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453335}] :answer-field/correct {:answer/id #uuid "fea26c04-19a4-5d02-95f7-713e29db1fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453334} :answer-field/id #uuid "771420e3-311e-5ce3-b340-03646c706117" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454417}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef46b0f0-6f4c-53dd-b0f1-5e1b301fe037" :question/math-academy-id "q-125736" :question/problem "Consider the vector field $F(x,y)=⟨{e}^{y},\\,x{e}^{y}⟩$ and the points $A(1,0)$ and $B(3,\\operatorname{ln}⁡3)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $F$ is conservative.\n\n- **II.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=8,$ where ${C}_{1}$ is the path along the curve $y=\\operatorname{ln}⁡(x),$ traversed from $A$ to $B.$\n\n- **III.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=3,$ where ${C}_{2}$ is the path along the line segment $\\overset{―}{AB},$ traversed from $A$ to $B.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Notice that $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ with domain $D={R}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}={e}^{y}.\n$$\n\nSince the partial derivatives exist and are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative.\n\n- Statement II is true. Since $F$ is conservative, there exists a function $f$ such that $∇f=F.$ Reconstructing the function $f$ from its gradient in the usual way, we get\n\n$$\nf=x{e}^{y}.\n$$\n\nApplying the fundamental theorem for line integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}∇f\\cdot \\text{d}r \\\\  & =f(3,\\operatorname{ln}⁡3)-f(1,0) \\\\  & =3\\cdot {e}^{\\operatorname{ln}⁡3}-1\\cdot {e}^{0} \\\\  & =3\\cdot 3-1 \\\\  & =8.\\end{aligned}\n$$\n\n- Statement III is false. Since $F$ is conservative and ${C}_{2}$ has the same initial and terminal points as ${C}_{2},$ we have\n\n$$\n{\\int }_{{C}_{2}}F\\cdot \\text{d}r={\\int }_{{C}_{2}}F\\cdot \\text{d}r=8.\n$$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186415479 :knowledge-point/_questions [{:db/id #edb/ref 17592186133913 :knowledge-point/id #uuid "abaeea03-6a2a-5d37-a2af-a9ea109175ad" :knowledge-point/title "Identifying the Reasons Why a Determinant Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c54ada56-3e8b-562f-84dd-634b27dac9cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453904} {:answer/id #uuid "1bc835ea-e9b6-5ca5-a77e-0c3bd1af050b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453905}] :answer-field/correct {:answer/id #uuid "c54ada56-3e8b-562f-84dd-634b27dac9cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453904} :answer-field/id #uuid "63c0a961-3dd4-5dcd-85e3-43b3a0493c55" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454702} {:answer-field/choices [{:answer/id #uuid "2456bbca-5dde-5fa3-a774-4b5dfb8431ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453906} {:answer/id #uuid "1b80c1f5-4c11-5a34-bb1a-faf5cdfce42f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453907}] :answer-field/correct {:answer/id #uuid "2456bbca-5dde-5fa3-a774-4b5dfb8431ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453906} :answer-field/id #uuid "36456e08-b5e0-5ffb-8bc0-2e13784267ad" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454703} {:answer-field/choices [{:answer/id #uuid "5e336f47-61c7-5dfa-b071-bc593d519e33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453908} {:answer/id #uuid "05d59b93-9de5-5bdc-af50-0154b6214595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453909}] :answer-field/correct {:answer/id #uuid "05d59b93-9de5-5bdc-af50-0154b6214595" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453909} :answer-field/id #uuid "0bb3bd4f-a1b2-5b23-a316-a0c1d1cd0bc3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454704}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8a11ae3-b740-5975-a251-a4796d69b742" :question/math-academy-id "q-43307" :question/problem "Let $A$ be a $3\\times 3$ matrix such that $|A|=0.$ Which of the following statements must be true?\n\nSelect all that apply.\n\n- **I.** $A$ has a zero column\n- **II.** $A$ has two proportional rows\n- **III.** One of the rows/columns of $A$ is a linear combination of other rows/columns of $A$" :question/worked-solution "Let's consider our statements in turn.\n\n- Statements I and II are false. For example, consider the matrix \n\n$$\nA=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1 \\\\ 1 & 2 & 3\\end{aligned}].\n$$\n\nExpending across the $1$st column, we have that \n\n$$\n\\begin{aligned}|A| & =1\\cdot |\\begin{aligned}1 & 1 \\\\ 2 & 3\\end{aligned}|+1|\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| \\\\  & =(3-2)+(1-2) \\\\  & =0\\end{aligned}\n$$\n\nbut $A$ has neither a zero column nor two proportional rows.\n\n- Statement III is true. Indeed, we can make use of the following fact:\n\n$|A|=0$ *if and only if one of the rows/columns of $A$ is a linear combination of other rows/columns of $A.$*\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186416481 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc84e201-9a3b-5b9c-b271-053b83bc1062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454190} {:answer/id #uuid "b48f37d9-b3b3-5755-8843-513b5d12ef8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454191}] :answer-field/correct {:answer/id #uuid "fc84e201-9a3b-5b9c-b271-053b83bc1062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454190} :answer-field/id #uuid "13a9bc41-dd9b-55b8-81b0-283e2528d477" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454845} {:answer-field/choices [{:answer/id #uuid "52687df0-1468-50e5-b467-bf1e68ad8627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454192} {:answer/id #uuid "47e41440-ce24-5373-9725-7970eff71e7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454193}] :answer-field/correct {:answer/id #uuid "52687df0-1468-50e5-b467-bf1e68ad8627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454192} :answer-field/id #uuid "ff9c9bed-0a04-5ac5-9daa-956eebe2c80a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454846} {:answer-field/choices [{:answer/id #uuid "339ff9c4-e5b0-5f71-b0a6-e74576728ce2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454194} {:answer/id #uuid "57d27c03-79c7-5bcb-8497-d684476d3e9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454195}] :answer-field/correct {:answer/id #uuid "57d27c03-79c7-5bcb-8497-d684476d3e9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454195} :answer-field/id #uuid "179dae7d-b2f1-55f0-bd24-81b68af5b4fa" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5650e0d2-585c-5516-892d-5eacef061cb2" :question/math-academy-id "q-95266" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Any $2\\times 3$ matrix $A$ has at most $2$ distinct singular values.\n- **II.** The matrix $A=[\\begin{aligned}1 & 0 \\\\ 0 & -2\\end{aligned}]$ has one negative singular value.\n- **III.** Any $5\\times 3$ matrix $A$ has at most $3$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $2\\times 3$ matrix and ${A}^{T}$ is a $3\\times 2$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 2}\\times {A}_{2\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is true. Since $A$ is a $5\\times 3$ matrix and ${A}^{T}$ is a $3\\times 5$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 5}\\times {A}_{5\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186416485 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4129371-905f-54bf-ae87-c438b2fd43aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454184} {:answer/id #uuid "77bf2baa-cff5-52ce-8b41-e36aedb6e4a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454185}] :answer-field/correct {:answer/id #uuid "77bf2baa-cff5-52ce-8b41-e36aedb6e4a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454185} :answer-field/id #uuid "861de6d8-648e-5127-85e8-5f06c2f6e1e5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454842} {:answer-field/choices [{:answer/id #uuid "4731f9ee-31e7-5b9b-a569-ce496f29e4a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454186} {:answer/id #uuid "2b6665d1-709e-5474-aae8-a9d99f2ffbe8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454187}] :answer-field/correct {:answer/id #uuid "2b6665d1-709e-5474-aae8-a9d99f2ffbe8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454187} :answer-field/id #uuid "b5399265-62f4-5593-8a3d-8303b79fd15a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454843} {:answer-field/choices [{:answer/id #uuid "03d6caf3-6217-5f02-8760-2707cabb06a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454188} {:answer/id #uuid "7e82bf64-150d-5e41-acc3-db5ca4cb19c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454189}] :answer-field/correct {:answer/id #uuid "03d6caf3-6217-5f02-8760-2707cabb06a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454188} :answer-field/id #uuid "416af97e-bb3e-58d1-b299-f595bb03d963" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454844}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e69dd032-aa5c-5891-a7fc-97b84703e88a" :question/math-academy-id "q-95261" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Any $4\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n- **II.** The singular values of the matrix $A=[\\begin{aligned}2 & 1 \\\\ -2 & -3\\end{aligned}]$ are non-negative.\n- **III.** Any $3\\times 4$ matrix $A$ has at most $3$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Since $A$ is a $4\\times 3$ matrix and ${A}^{T}$ is a $3\\times 4$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 4}\\times {A}_{4\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is true. All singular values of any matrix are non-negative.\n\n- Statement III is false. Since $A$ is a $3\\times 4$ matrix and ${A}^{T}$ is a $4\\times 3$ matrix, ${A}^{T}\\,A$ must be a $4\\times 4$ matrix: \n\n$$\n{{A}^{T}}_{4\\times 3}\\times {A}_{3\\times 4}={{A}^{T}\\,A}_{4\\times 4}\n$$\n\nHence, $A$ has at most $4$ distinct singular values.\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186416486 :knowledge-point/_questions [{:db/id #edb/ref 17592186184197 :knowledge-point/id #uuid "8063bc9c-a10d-562b-93b1-508b4b26a674" :knowledge-point/title "Identifying True Statements Regarding the Singular Values of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17199cb6-adea-5b61-919d-b8c404e0acce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454196} {:answer/id #uuid "8d2c651a-9fde-5d68-8dc6-db31d39c222f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454197}] :answer-field/correct {:answer/id #uuid "8d2c651a-9fde-5d68-8dc6-db31d39c222f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454197} :answer-field/id #uuid "4075aa54-0dff-530d-8aaa-0316bbe68384" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454848} {:answer-field/choices [{:answer/id #uuid "ecfe78bb-58cf-5df3-9fec-25b0e56a5cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454198} {:answer/id #uuid "1cdaafa5-1a83-54e7-855b-cedee6333689" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454199}] :answer-field/correct {:answer/id #uuid "ecfe78bb-58cf-5df3-9fec-25b0e56a5cf4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454198} :answer-field/id #uuid "ebe209e3-0b27-5e04-917c-a2a111895c0f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454849} {:answer-field/choices [{:answer/id #uuid "72750c08-7405-534f-a4d7-2b63080f7417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454200} {:answer/id #uuid "cf58434d-bb62-5004-8244-73fdeaf3e6f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454201}] :answer-field/correct {:answer/id #uuid "72750c08-7405-534f-a4d7-2b63080f7417" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454200} :answer-field/id #uuid "7b11c932-8a01-5b51-9317-14a5c84895c3" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fef86daf-091a-52fa-bcf0-1d2b609bb348" :question/math-academy-id "q-95281" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** Any $6\\times 3$ matrix $A$ has at most $3$ distinct singular values.\n- **II.** The matrix $A=[\\begin{aligned}-1 & -1 \\\\ -1 & -2\\end{aligned}]$ has one negative singular value.\n- **III.** Any $4\\times 5$ matrix $A$ has at most $4$ distinct singular values." :question/worked-solution "The singular values of the matrix $A$ are the square roots of the eigenvalues of the matrix ${A}^{T}\\,A.$ \n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, since $A$ is a $6\\times 3$ matrix and ${A}^{T}$ is a $3\\times 6$ matrix, ${A}^{T}\\,A$ must be a $3\\times 3$ matrix: \n\n$$\n{{A}^{T}}_{3\\times 6}\\times {A}_{6\\times 3}={{A}^{T}\\,A}_{3\\times 3}\n$$\n\nHence, $A$ has at most $3$ distinct singular values.\n\n- Statement II is false. All singular values of any matrix are non-negative. So, $A$ can't have a negative singular value.\n\n- Statement III is false. Since $A$ is a $4\\times 5$ matrix and ${A}^{T}$ is a $5\\times 4$ matrix, ${A}^{T}\\,A$ must be a $5\\times 5$ matrix: \n\n$$\n{{A}^{T}}_{5\\times 4}\\times {A}_{4\\times 5}={{A}^{T}\\,A}_{5\\times 5}\n$$\n\nHence, $A$ has at most $5$ distinct singular values.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186417219 :knowledge-point/_questions [{:db/id #edb/ref 17592186119926 :knowledge-point/id #uuid "19c33c51-bf11-5a81-a0fd-8381d8e0b9d7" :knowledge-point/title "Determining Whether a Line Is a Subspace of Two-Dimensional Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7384a9a6-a6f3-509e-8604-32e6ff1cf91f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453416} {:answer/id #uuid "d926c783-6a31-5aad-8676-68e3ed986684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453417}] :answer-field/correct {:answer/id #uuid "d926c783-6a31-5aad-8676-68e3ed986684" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453417} :answer-field/id #uuid "a16f14e7-1180-5cad-8b96-837d1cc5647f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454458} {:answer-field/choices [{:answer/id #uuid "f86d39fb-1e90-5901-85fd-3a8ced53e62f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453418} {:answer/id #uuid "a4e62c65-eae5-5cc0-b334-901e889e9707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453419}] :answer-field/correct {:answer/id #uuid "a4e62c65-eae5-5cc0-b334-901e889e9707" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453419} :answer-field/id #uuid "3acee59e-520e-5e8f-8529-6999b135978a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454459} {:answer-field/choices [{:answer/id #uuid "31cc429d-07c8-5275-a610-638d58689d91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453420} {:answer/id #uuid "8469e1a3-49e3-5d1c-a349-3f76f08bd629" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453421}] :answer-field/correct {:answer/id #uuid "8469e1a3-49e3-5d1c-a349-3f76f08bd629" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453421} :answer-field/id #uuid "43a7e42a-5e2f-5d59-ab7e-86b6db1851a4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454460} {:answer-field/choices [{:answer/id #uuid "332b4d60-25b6-5bcb-b419-6cb43732aabb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453422} {:answer/id #uuid "e402ecbd-276a-5177-b646-7e13763d957b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453423}] :answer-field/correct {:answer/id #uuid "332b4d60-25b6-5bcb-b419-6cb43732aabb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453422} :answer-field/id #uuid "eab3e9d9-7d15-5b97-a15c-d97464e94366" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454461}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feee3179-e7d1-55ab-bcac-f334cca10495" :question/math-academy-id "q-156620" :question/problem "Let $L$ be the line with equation $4x=2y$ in ${R}^{2}.$ Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $L$ contains the zero-vector\n- **II.** $L$ is closed under vector addition\n- **III.** $L$ is closed under scalar multiplication\n- **IV.** $L$ is **not** a subspace of ${R}^{2}$" :question/worked-solution "Recall the following two facts about subspaces: \n\n- A set of vectors in a vector space is a *subspace* if it is closed under vector addition and scalar multiplication.\n\n- If a non-empty set is closed under scalar multiplication, then this set must contain the zero-vector (because $0\\cdot v=0$ for any vector $v$). So, if a set does not contain the zero vector, then this set is not closed under scalar multiplication.\n\nNotice that $L$ contains vectors of the form \n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}x \\\\ 2x\\end{aligned}],\\,x\\in R.\n$$\n\nWith that in mind, let's examine our statements. \n\n- Statement I is true. The coordinates of the zero-vector satisfy the equation $4x=2y:$\n\n$$\n\\begin{aligned}4x & =2y \\\\ 4(0) & =2(0) \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\n- Statement II is true. Let, for example, $a=[\\begin{aligned}a \\\\ 2a\\end{aligned}]\\in L$ and $b=[\\begin{aligned}b \\\\ 2b\\end{aligned}]\\in L.$ Then,\n\n$$\n\\begin{aligned}a+b & =[\\begin{aligned}a \\\\ 2a\\end{aligned}]+[\\begin{aligned}b \\\\ 2b\\end{aligned}]=[\\begin{aligned}a+b \\\\ 2a+2b\\end{aligned}]=[\\begin{aligned}a+b \\\\ 2(a+b)\\end{aligned}],\\end{aligned}\n$$\n\nwhich satisfies the condition $4x=2y.$ Therefore, $a+b\\in L.$\n\n- Statement III is true. Let, for example, $a=[\\begin{aligned}a \\\\ 2a\\end{aligned}]\\in L$ and $k\\in R.$ Then,\n\n$$\n\\begin{aligned}k\\cdot a & =k\\cdot [\\begin{aligned}a \\\\ 2a\\end{aligned}]=[\\begin{aligned}ka \\\\ k(2a)\\end{aligned}]=[\\begin{aligned}ka \\\\ 2(ka)\\end{aligned}],\\end{aligned}\n$$\n\n \nwhich satisfies the condition $4x=2y.$ Therefore, $k\\cdot a\\in L.$\n\n- Statement IV is false. Since statements II and III are true, $L$ must be a subspace of ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III only.\""}] [{:db/id #edb/ref 17592186417703 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5a8fd7b-d587-5f84-abef-00aeb093eb8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453892} {:answer/id #uuid "a3c74f36-a3a0-589c-a45b-af2f83dc7942" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453893}] :answer-field/correct {:answer/id #uuid "e5a8fd7b-d587-5f84-abef-00aeb093eb8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453892} :answer-field/id #uuid "88425be4-23e4-530d-894d-7ba2ee67cacc" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454696} {:answer-field/choices [{:answer/id #uuid "42b1c9af-14b9-5566-a390-e0cfcfb93713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453894} {:answer/id #uuid "56beb87c-fb76-5782-843d-1bb2ef34ea37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453895}] :answer-field/correct {:answer/id #uuid "56beb87c-fb76-5782-843d-1bb2ef34ea37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453895} :answer-field/id #uuid "6eccd02e-cd48-5da5-a4d4-40a643e437ff" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454697} {:answer-field/choices [{:answer/id #uuid "62cc4c4f-6b01-5029-937b-d1096d770d25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453896} {:answer/id #uuid "998a225c-9aad-55b1-9522-e1b176e1886c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453897}] :answer-field/correct {:answer/id #uuid "62cc4c4f-6b01-5029-937b-d1096d770d25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453896} :answer-field/id #uuid "7b61e149-64e1-57db-98c8-d0a11bc647eb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454698}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0464e7a7-ce22-55cd-90ec-4b6a71a12079" :question/math-academy-id "q-38893" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and $T(x)=v$ has no solution?\n\nSelect all that apply.\n\n- **I.** $T$ is invertible\n- **II.** $\\text{Ker}(T)\\ne {0}$\n- **III.** $\\text{nullity}(T)=0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is false. Since $T(x)=v$ has no solution, we have that $v\\notin \\text{Im}(T),$ hence $\\text{Im}(T)\\ne {R}^{5}.$ According to the invertible matrix theorem, since $\\text{Im}(T)\\ne {R}^{5},$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement II is true. Since $T$ is not invertible, the invertible matrix theorem implies that  $\\text{Ker}(T)\\ne {0}.$\n\n- Statement III is false. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186417816 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fb12b54-0323-5408-9f63-bd359e7b2e14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453448} {:answer/id #uuid "164d2254-207a-594f-a70d-382d51b3f8e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453449}] :answer-field/correct {:answer/id #uuid "164d2254-207a-594f-a70d-382d51b3f8e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453449} :answer-field/id #uuid "e5032cdf-c59e-5e33-880d-955f6d02841e" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454474} {:answer-field/choices [{:answer/id #uuid "3427dac4-97f1-5765-aafc-94068cf9677e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453450} {:answer/id #uuid "6c0ad7a7-e7bc-5678-aca2-5d4474e68307" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453451}] :answer-field/correct {:answer/id #uuid "3427dac4-97f1-5765-aafc-94068cf9677e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453450} :answer-field/id #uuid "e3387072-c1bc-59ee-8d45-dc6cd0e5411d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454475} {:answer-field/choices [{:answer/id #uuid "42ad1ee2-a34e-5097-bfd1-c65783c31fe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453452} {:answer/id #uuid "0e0e000c-633e-51cc-bcaf-35de257a2bd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453453}] :answer-field/correct {:answer/id #uuid "42ad1ee2-a34e-5097-bfd1-c65783c31fe4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453452} :answer-field/id #uuid "feaa10ce-c2f4-5d9a-998c-4aa5896d0d74" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454476}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e4c0564-b5b1-55bc-bc17-3dffa3a951a9" :question/math-academy-id "q-158601" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y<-1},\\,∂A={(x,y)\\in {R}^{2}:y=-1}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(1,-1)$ lies on the boundary of $A$\n- **II.** The point $P(1,-1)$ belongs to $A$\n- **III.** The point $Q(2,0)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie below the line $y=-1.$ A sketch of this region is shown below:\n\n![](images/75/75d5d199d12cc2f3170822a40c52762fcc8368caac26a8134661f9ac72ab462b.png)\n\nLet's add the points $P(1,-1)$ and $Q(2,0)$ and some neighborhoods of these points to our diagram.\n\n![](images/81/818da293be040897d3a536b396d6fe7ff992f3d91f976301e14a6253356b5bde.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(1,-1)$ satisfy $y=-1.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is false. The coordinates of $P(-1,1)$ do not satisfy the inequality $y<-1.$ Hence, $P$ does not lie in the set $A.$\n\n- Statement III is false. Indeed, $Q$ is not an interior point of $A$ since any neighborhood of $Q$ contains at least one point *outside* the set.\n\nTherefore, the correct answer is 'I only.'"}] [{:db/id #edb/ref 17592186417817 :knowledge-point/_questions [{:db/id #edb/ref 17592186124641 :knowledge-point/id #uuid "64ba57cc-a3eb-582a-963b-b94895a20bac" :knowledge-point/title "Identifying Interior and Boundary Points From Linear Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca900fdb-2d62-5862-8f58-5e2c93efbb46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453436} {:answer/id #uuid "839c8d82-74a4-5464-b707-309afd311002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453437}] :answer-field/correct {:answer/id #uuid "839c8d82-74a4-5464-b707-309afd311002" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453437} :answer-field/id #uuid "8e5b6f56-ac9e-5312-8788-c82ee0344df5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454468} {:answer-field/choices [{:answer/id #uuid "9eb2be68-e58e-5cf5-a802-398a76d09aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453438} {:answer/id #uuid "ae1f7b94-44bb-5eab-8fad-f6e5da807f42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453439}] :answer-field/correct {:answer/id #uuid "ae1f7b94-44bb-5eab-8fad-f6e5da807f42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453439} :answer-field/id #uuid "49d1f656-b70c-5cbc-b720-c740ebcddde4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454469} {:answer-field/choices [{:answer/id #uuid "66605df2-8aaf-504d-949d-2dc2c5eb81cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453440} {:answer/id #uuid "fbb9751c-c1ad-5871-aa80-62619467576e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453441}] :answer-field/correct {:answer/id #uuid "fbb9751c-c1ad-5871-aa80-62619467576e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453441} :answer-field/id #uuid "54080e51-b892-57e7-b433-ee3c85f02bbe" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454470}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dbe53a96-4c4c-5897-ba48-d4861ec6cb49" :question/math-academy-id "q-158547" :question/problem "The set $A$ and its boundary $∂A$ are given by\n\n$$\nA={(x,y)\\in {R}^{2}:y>2x-3},\\,∂A={(x,y)\\in {R}^{2}:y=2x-3}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** The point $P(1,-1)$ lies on the boundary of $A$\n- **II.** The point $Q(0,0)$ belongs to $A$\n- **III.** The point $Q(0,0)$ is an interior point of $A$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nNow, the set $A$ consists of all points that lie above the line $y=2x-3.$ A sketch of this region is shown below:\n\n![](images/5a/5af40a400e5ea4942a1cf89b09184a277df96d252e4a7fee41bd2df7024a631f.png)\n\nLet's add the points $P(1,-1)$ and $Q(0,0)$ and some neighborhoods of these points to our diagram.\n\n![](images/27/27b978864eac65c93c7886b2d54dfede7130f0f93a16ef96421cd0e5741a6940.png)\n\nLet's examine the statements in turn.\n\n- Statement I is true. The coordinates of $P(1,-1)$ satisfy $y=2x-3.$ Hence, $P$ lies in the set $∂A,$ the boundary of $A.$\n\n- Statement II is true. Indeed, the coordinates of $Q(0,0)$ satisfy the inequality $y>2x-3.$ Hence, $Q$ lies in the set $A.$\n\n- Statement III is true. Indeed, there exists an open neighborhood of $Q$ that is entirely contained inside the set $A.$\n\nTherefore, the correct answer is 'I, II, and III.'"}] [{:db/id #edb/ref 17592186418155 :knowledge-point/_questions [{:db/id #edb/ref 17592186162016 :knowledge-point/id #uuid "c94ec9c4-650f-5d39-9294-651b03b172bf" :knowledge-point/title "Identifying True Statements Regarding Singular Value Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44bf1c7c-6b0e-563e-954c-3195f51957e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454208} {:answer/id #uuid "da6a0750-c545-55b0-96a6-f69075551811" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454209}] :answer-field/correct {:answer/id #uuid "44bf1c7c-6b0e-563e-954c-3195f51957e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454208} :answer-field/id #uuid "e5818556-f363-51a8-99fb-0d3f96f4adeb" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454854} {:answer-field/choices [{:answer/id #uuid "8908ac85-0ea3-5a1c-b891-38df1e4efa1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454210} {:answer/id #uuid "c681945d-6fe4-577f-97ef-2ee6b13ef95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454211}] :answer-field/correct {:answer/id #uuid "c681945d-6fe4-577f-97ef-2ee6b13ef95b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454211} :answer-field/id #uuid "27f45678-b73d-5101-b847-456979724eed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454855} {:answer-field/choices [{:answer/id #uuid "6a3a2869-1fca-522a-9ef5-456efad708a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454212} {:answer/id #uuid "0d94671b-f829-5477-b5c4-2a0aa1a5da65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454213}] :answer-field/correct {:answer/id #uuid "6a3a2869-1fca-522a-9ef5-456efad708a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454212} :answer-field/id #uuid "0749b39f-5020-520c-b5a7-35e6e06dd907" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d3ee109-94d4-53ed-8971-ac2ef97dce27" :question/math-academy-id "q-95901" :question/problem "Given the singular value decomposition $A=UΣ{V}^{T},$ where $A$ is a $3\\times 4$ matrix, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $Σ$ is a $4\\times 4$ matrix\n- **II.** $V$ is an orthogonal $4\\times 4$ matrix\n- **III.** $U$ is a diagonal matrix" :question/worked-solution "Recall that if  $A=UΣ{V}^{T}$ is a singular value decomposition of an $m\\times n$ matrix $A,$ then\n\n- $Σ$ is a $m\\times n$ matrix with nonnegative elements on the main diagonal and zeroes outside the main diagonal,\n\n- $U$ is an orthogonal $m\\times m$ matrix,\n\n- $V$ is an orthogonal $n\\times n$ matrix.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is false. Since $A$ is a $3\\times 4$ matrix, $Σ$ must be a $3\\times 4$ matrix.\n\n- Statement II is true. Indeed, since $A$ is a $3\\times 4$ matrix,the matrix $V$ in the singular value decomposition $UΣ{V}^{T}$ must be orthogonal $4\\times 4$ matrix.\n\n- Statement III is false. The matrix $U$ must be orthogonal but not necessarily diagonal.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186418768 :knowledge-point/_questions [{:db/id #edb/ref 17592186133778 :knowledge-point/id #uuid "7b03ea89-5152-5ff4-813a-ca985d60ed5b" :knowledge-point/title "Identifying True Statements About Orthogonality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c78237-7ba8-5f5d-a33b-f0e13b1bcaf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454048} {:answer/id #uuid "e9ae988e-f035-54a7-a23f-739a60fc9826" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454049}] :answer-field/correct {:answer/id #uuid "a7c78237-7ba8-5f5d-a33b-f0e13b1bcaf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454048} :answer-field/id #uuid "d3a1a93b-7a1e-598e-9ac9-1fec0a8541af" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454774} {:answer-field/choices [{:answer/id #uuid "a1121815-b4cb-5a43-b5a6-e6c5f54f549f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454050} {:answer/id #uuid "fdc194be-1802-5b3c-9ead-0634aaac6f8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454051}] :answer-field/correct {:answer/id #uuid "fdc194be-1802-5b3c-9ead-0634aaac6f8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454051} :answer-field/id #uuid "5c705186-a967-52c8-8f4b-6be1b77a56ab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454775} {:answer-field/choices [{:answer/id #uuid "ac97a943-76b0-577f-974e-60a75af70b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454052} {:answer/id #uuid "5c3399ef-8ee6-5f98-9847-2e8f4d1a6f50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454053}] :answer-field/correct {:answer/id #uuid "ac97a943-76b0-577f-974e-60a75af70b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454052} :answer-field/id #uuid "b18f9b5e-6144-516e-bca1-6e1944599bbe" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454776}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ac83e377-f632-58f6-8bed-4004335968a6" :question/math-academy-id "q-80514" :question/problem "For the vector $u=[\\begin{aligned}-2 \\\\ 3 \\\\ -4\\end{aligned}]$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $u⊥H,\\,$ where $H={[\\begin{aligned}2 \\\\ 0 \\\\ -1\\end{aligned}],[\\begin{aligned}-1 \\\\ -2 \\\\ 1\\end{aligned}]}$\n- **II.** $u⊥V,\\,$ where $V={[\\begin{aligned}3 \\\\ 2 \\\\ 0\\end{aligned}],[\\begin{aligned}2 \\\\ 3 \\\\ \\frac{5}{4}\\end{aligned}]}$\n- **III.** $u⊥W,\\,$ where $W={[\\begin{aligned}0 \\\\ 4 \\\\ 3\\end{aligned}],[\\begin{aligned}4 \\\\ 0 \\\\ -2\\end{aligned}],[\\begin{aligned}1 \\\\ -1 \\\\ -2\\end{aligned}]}$" :question/worked-solution "Let's denote the vectors of $H,V$ and $W$ as ${{h}_{1},{h}_{2}},{{v}_{1},{v}_{2}}$ and ${{w}_{1},{w}_{2},{w}_{3}}$, respectively.  \n\nNow, we have to compute the dot product between $u$ and the vectors in each set. \n\n- For the set $H:$\n\n$$\n\\begin{aligned}u\\cdot {h}_{1} & =(-2)\\cdot 2+3\\cdot 0+(-4)\\cdot (-1)=0 & ✓ \\\\ u\\cdot {h}_{2} & =(-2)\\cdot (-1)+3\\cdot (-2)+(-4)\\cdot 1=-8\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸H.$\n\n- For the set $V:$\n\n$$\n\\begin{aligned}u\\cdot {v}_{1} & =(-2)\\cdot 3+3\\cdot 2+(-4)\\cdot 0=0 & ✓ \\\\ u\\cdot {v}_{2} & =(-2)\\cdot 2+3\\cdot 3+(-4)\\cdot \\frac{5}{4}=0 & ✓\\end{aligned}\n$$\n\nSo, $u⊥V.$\n\n- For the set $W:$\n\n$$\n\\begin{aligned}u\\cdot {w}_{1} & =(-2)\\cdot 0+3\\cdot 4+(-4)\\cdot 3=0 & ✓ \\\\ u\\cdot {w}_{2} & =(-2)\\cdot 4+3\\cdot 0+(-4)\\cdot (-2)=0 & ✓ \\\\ u\\cdot {w}_{3} & =(-2)\\cdot 1+3\\cdot (-1)+(-4)\\cdot (-2)=3\\ne 0 & \\times \\end{aligned}\n$$\n\nSo, $u⊥̸W.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186419017 :knowledge-point/_questions [{:db/id #edb/ref 17592186172054 :knowledge-point/id #uuid "72015667-33a9-53e2-a0c4-09d8ce916b54" :knowledge-point/title "Identifying Vector Fields That Are Independent of Path"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bbc76e1-b401-5a78-abad-35dac56a605e