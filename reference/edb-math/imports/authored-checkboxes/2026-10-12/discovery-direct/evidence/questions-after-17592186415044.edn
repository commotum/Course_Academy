cce7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453346} :answer-field/id #uuid "1eb5c926-ae08-5e20-a8c6-c74a02337973" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454423} {:answer-field/choices [{:answer/id #uuid "2382595d-1329-5487-addb-48a96fc302ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453348} {:answer/id #uuid "ccaebe90-5c00-5752-8300-47cb5c96cc81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453349}] :answer-field/correct {:answer/id #uuid "2382595d-1329-5487-addb-48a96fc302ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453348} :answer-field/id #uuid "e0ae2286-b965-58b3-9eee-07c2cde691c4" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454424}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b47df0de-b5ee-5562-b36a-a659cbe48d85" :question/math-academy-id "q-125796" :question/problem "Consider the vector field $F(x,y)=⟨-y,\\,x⟩$ and the points $A(0,1)$ and $B(0,-1)$ in the $xy$-plane. \n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** ${\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne 0,$ where ${C}_{1}$ is the path along the circle ${x}^{2}+{y}^{2}=1,$ traversed from $A$ to $B$ in counterclockwise direction.\n\n- **II.** ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=0,$ where ${C}_{2}$ is the path along the segment line $\\overset{―}{AB},$ traversed from $A$ to $B.$\n\n- **III.** ${\\int }_{C}F\\cdot \\text{d}r$ is independent of path.\n\n- **IV.** $F$ is conservative." :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement I is true. Parameterizing the curve, we have\n\n$$\n{r}_{1}(t)=⟨\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t⟩,\\,t\\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}⟨-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩\\cdot ⟨-\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}{sin}^{2}⁡t+{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}1\\,\\text{d}t \\\\  & =t{|}_{\\pi /2}^{3\\pi /2} \\\\  & =\\frac{3\\pi }{2}-\\frac{\\pi }{2} \\\\  & =\\pi  \\\\  & \\ne 0.\\end{aligned}\n$$\n\n- Statement II is true. Parameterizing the line segment, we have\n\n$$\n{r}_{2}(t)=⟨0,\\,1-2t⟩,\\,t\\in [0,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}⟨2t-1,\\,0⟩\\cdot ⟨0,\\,-2⟩\\text{d}t \\\\  & ={\\int }_{0}^{1}0\\,\\text{d}t \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is false. Since ${C}_{1}$ and ${C}_{2}$ have the same initial and terminal points, yet\n\n$$\n{\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne {\\int }_{{C}_{2}}F\\cdot \\text{d}r,\n$$\n\nwe conclude that ${\\int }_{C}F\\cdot \\text{d}r$ is path-dependent.\n\n- Statement IV is false. If a vector field is conservative then it is path-independent. Since $F$ is path-dependent, it is not conservative."}] [{:db/id #edb/ref 17592186419635 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cd7a5c1-1e87-5b62-b284-bf56909fcf02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453114} {:answer/id #uuid "cd253dba-c992-5d6a-93f7-47cc0eff8bd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453115}] :answer-field/correct {:answer/id #uuid "5cd7a5c1-1e87-5b62-b284-bf56909fcf02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453114} :answer-field/id #uuid "1238bba7-07b2-559e-bf74-19e6124b8f75" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454307} {:answer-field/choices [{:answer/id #uuid "e6ab698b-ceeb-5deb-8953-08cf2d434ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453116} {:answer/id #uuid "3c93d61c-1738-5e36-85b9-dac6be86a64e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453117}] :answer-field/correct {:answer/id #uuid "e6ab698b-ceeb-5deb-8953-08cf2d434ca9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453116} :answer-field/id #uuid "4003b46e-ef87-59a5-8fe4-e94a66c5b3e9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454308} {:answer-field/choices [{:answer/id #uuid "8bff6d71-cd27-5c11-ba51-8d4d2bd41fe2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453118} {:answer/id #uuid "de862315-e733-5ab2-b08c-faee53b6da8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453119}] :answer-field/correct {:answer/id #uuid "de862315-e733-5ab2-b08c-faee53b6da8d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453119} :answer-field/id #uuid "6f6a383b-7b94-51a2-896a-27d32fdf2e42" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454309}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c37fbba7-25b2-5279-9899-188d8dedca8a" :question/math-academy-id "q-103380" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-7≡27\\,(\\text{mod}\\,5)$\n- **II.** $-5≡15\\,(\\text{mod}\\,6)$\n- **III.** $11≡18\\,(\\text{mod}\\,7)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $5∤(-7-27).$ Notice that $-7-27=-34,$ which is not divisible by $5.$\n\n- Statement II is false because $6∤(-5-15).$ Notice that $-5-15=-20,$ which is not divisible by $6.$\n\n- Statement III is true because $7\\,|\\,(11-18).$ There is no remainder:\n\n$$\n(11-18)÷7=-7÷7=-1\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186419636 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ded5d75d-d5af-5618-8bc9-286fd9df75b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453294} {:answer/id #uuid "9a2e7b64-9936-5f01-9f31-27b68303212b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453295}] :answer-field/correct {:answer/id #uuid "ded5d75d-d5af-5618-8bc9-286fd9df75b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453294} :answer-field/id #uuid "abebb316-e99d-5b7e-85e8-d421aa3b8c60" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454397} {:answer-field/choices [{:answer/id #uuid "2ad2655f-6afb-58dd-bfd3-1cab2b3512c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453296} {:answer/id #uuid "e7ffcbf0-fd13-59c6-8328-9a3f78249d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453297}] :answer-field/correct {:answer/id #uuid "e7ffcbf0-fd13-59c6-8328-9a3f78249d1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453297} :answer-field/id #uuid "16e50a4a-182e-53b4-ab0f-3c14cfb5c41c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454398} {:answer-field/choices [{:answer/id #uuid "b3f32310-cea6-56fd-bc90-91e2d05d76f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453298} {:answer/id #uuid "a622ca61-c74d-526d-a675-f91fa6ed458a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453299}] :answer-field/correct {:answer/id #uuid "a622ca61-c74d-526d-a675-f91fa6ed458a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453299} :answer-field/id #uuid "52acd980-54ed-5661-a99d-d100f4fdb7da" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454399}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e9350880-d00e-5d41-adb3-52fc6c8e0846" :question/math-academy-id "q-113664" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-5≡8\\,(\\text{mod}\\,7)$\n- **II.** $-23≡-5\\,(\\text{mod}\\,6)$\n- **III.** $-7≡-1\\,(\\text{mod}\\,2)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-5-8).$ Notice that $-5-8=-13,$ which is not divisible by $7.$\n\n- Statement II is true because $6∣(-23-(-5)).$ There is no remainder:\n\n$$\n(-23-(-5))÷6=-18÷6=-3\n$$\n\n- Statement III is true because $2\\,|\\,(-7-(-1)).$ There is no remainder:\n\n$$\n(-7-(-1))÷2=-6÷2=-3\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186419637 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fea04ad-6301-5338-84cb-8e7183ec38b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453300} {:answer/id #uuid "244b0170-04cf-576a-a359-8e6fba1609a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453301}] :answer-field/correct {:answer/id #uuid "5fea04ad-6301-5338-84cb-8e7183ec38b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453300} :answer-field/id #uuid "294256a8-04dd-5480-bd9a-025d2d07c052" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454400} {:answer-field/choices [{:answer/id #uuid "2ce7da18-5976-54f4-853e-11cd748582b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453302} {:answer/id #uuid "d63a67dc-af8b-597d-8d04-bea8356b228f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453303}] :answer-field/correct {:answer/id #uuid "2ce7da18-5976-54f4-853e-11cd748582b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453302} :answer-field/id #uuid "831851a3-f614-56ed-a446-b0ef1f20f1be" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454401} {:answer-field/choices [{:answer/id #uuid "f172228e-e7ef-5590-9ed8-ef46152687d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453304} {:answer/id #uuid "dc4882f8-d7db-52e7-a801-2733051a47c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453305}] :answer-field/correct {:answer/id #uuid "dc4882f8-d7db-52e7-a801-2733051a47c8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453305} :answer-field/id #uuid "236f2576-4c98-5799-8b90-5d928320dac1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454402}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee3460a5-a9ce-5793-8247-ccd3db242273" :question/math-academy-id "q-113675" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-36≡-19\\,(\\text{mod}\\,7)$\n- **II.** $15≡-26\\,(\\text{mod}\\,10)$\n- **III.** $-27≡9\\,(\\text{mod}\\,4)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $7∤(-36-(-19)).$ Notice that $-36-(-19)=-17,$ which is not divisible by $7.$\n\n- Statement II is false because $10∤(15-(-26)).$ Notice that $15-(-26)=41,$ which is not divisible by $10.$\n\n- Statement III is true because $4\\,|\\,(-27-9).$ There is no remainder:\n\n$$\n(-27-9)÷4=-36÷4=-9\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186419686 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573ba886-20ef-53c9-9024-a795a327b2ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454244} {:answer/id #uuid "75fa156d-1a39-536a-ab92-cd46c3d568a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454245}] :answer-field/correct {:answer/id #uuid "75fa156d-1a39-536a-ab92-cd46c3d568a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454245} :answer-field/id #uuid "6c352d4a-a883-55eb-8913-4568682a7132" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454872} {:answer-field/choices [{:answer/id #uuid "a493b3a0-15e1-540d-9b9a-49e179799c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454246} {:answer/id #uuid "6b0b13f5-b674-5518-b581-93c06913cf58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454247}] :answer-field/correct {:answer/id #uuid "a493b3a0-15e1-540d-9b9a-49e179799c67" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454246} :answer-field/id #uuid "139440a5-d4e1-5ab8-ba4c-c3d86f2c0c74" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454873} {:answer-field/choices [{:answer/id #uuid "41af9a8e-a9d1-5b00-b3e8-b95a4c022fcf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454248} {:answer/id #uuid "3a437d50-f3c9-5ac5-8e9a-de9b7e0b61f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454249}] :answer-field/correct {:answer/id #uuid "3a437d50-f3c9-5ac5-8e9a-de9b7e0b61f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454249} :answer-field/id #uuid "08c42cdc-f60a-5dff-99c5-7c1367615b5d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454874}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e737a421-d643-51f0-9d67-b9556fcc15c6" :question/math-academy-id "q-97060" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{B\\to C}$ is the change-of-coordinates matrix from basis $B$ to basis $C,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}$\n- **II.** $[T]_{C}={P}_{B\\to C}^{-1}\\cdot [T]_{B}\\cdot {P}_{B\\to C}$\n- **III.** $[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1}$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/1b/1b81504d6fdcabee0e1f586fef3dd2af5a57a8411ba4d22429e00e09b171a4d1.png)\n\n \n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{B\\to C}\\cdot [T]_{B}\\cdot {P}_{B\\to C}^{-1},\n$$\n\nwhere ${P}_{B\\to C}$ is the change-of-coordinates matrix from $B$ to $C.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{B\\to C}^{-1}\\cdot [T]_{C}\\cdot {P}_{B\\to C}.\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420071 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c2f8bfc-8a2b-5c27-8a60-ea04aa4bdc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453806} {:answer/id #uuid "999777ab-3743-55c2-a473-e80ef89adb78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453807}] :answer-field/correct {:answer/id #uuid "4c2f8bfc-8a2b-5c27-8a60-ea04aa4bdc5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453806} :answer-field/id #uuid "782c3be1-ac75-5aa2-b432-a55b29c6fd04" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454653} {:answer-field/choices [{:answer/id #uuid "fcbbbb8b-969a-59eb-ad64-12cbd15b1875" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453808} {:answer/id #uuid "817d5feb-1d83-5247-bbc1-274b57d7c67d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453809}] :answer-field/correct {:answer/id #uuid "817d5feb-1d83-5247-bbc1-274b57d7c67d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453809} :answer-field/id #uuid "60099b3d-b168-5c08-9592-0c6035c14b35" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454654} {:answer-field/choices [{:answer/id #uuid "5ad412ec-4d05-534c-98e0-999e777f75f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453810} {:answer/id #uuid "f0567f6e-4237-5109-82cc-40dfbc24f6ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453811}] :answer-field/correct {:answer/id #uuid "5ad412ec-4d05-534c-98e0-999e777f75f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453810} :answer-field/id #uuid "8d462da8-c335-5522-ab67-992c40543616" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454655}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "48fbd1ea-16f2-572a-98a1-c1983af51b24" :question/math-academy-id "q-221923" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\nSelect all that apply.\n\n- **I.** $3∣(14x+21y)$\n- **II.** $7∣(14x+21y)$\n- **III.** $4∣(14x+21y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \n\nWith that in mind, let's examine our statement in turn.\n\n- Statement I is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $3.$\n\n- Statement II is true. Notice that \n\n$$\n14x+21y=7(2x+3y).\n$$\n\nSince $x$ and $y$ are integers, $2x+3y$ must be an integer, too. So, $7∣(14x+21y).$\n\n- Statement III is false. For example, if $x=1$ and $y=0,$ we have $14(1)+21(0)=14,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186420072 :knowledge-point/_questions [{:db/id #edb/ref 17592186161919 :knowledge-point/id #uuid "559e653a-2ab9-54a8-84e3-02bf106a8f47" :knowledge-point/title "Inferring Divisibility in Algebraic Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a14c4a6-d210-5dd4-9ce2-f9ed55f64943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453830} {:answer/id #uuid "287bceee-04d3-509d-acda-bcc302b3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453831}] :answer-field/correct {:answer/id #uuid "287bceee-04d3-509d-acda-bcc302b3c7e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453831} :answer-field/id #uuid "f65bdc06-29ae-5226-b267-6fdc35815932" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454665} {:answer-field/choices [{:answer/id #uuid "6dcb7a7e-04a6-5748-90a8-7d2a33acd246" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453832} {:answer/id #uuid "4905546e-c0ac-5cb3-afe1-6534073d8055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453833}] :answer-field/correct {:answer/id #uuid "4905546e-c0ac-5cb3-afe1-6534073d8055" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453833} :answer-field/id #uuid "0638118a-1557-568f-9f04-35cd1542f5a3" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454666} {:answer-field/choices [{:answer/id #uuid "5e78ce48-c819-5bbc-bd9f-602a454f17b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453834} {:answer/id #uuid "76454f66-2d6e-5f8a-85c0-8183da34db1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453835}] :answer-field/correct {:answer/id #uuid "5e78ce48-c819-5bbc-bd9f-602a454f17b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453834} :answer-field/id #uuid "00285ea7-c2b8-59c7-a9e9-3de805e315c4" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63936aa1-e722-5014-a82a-6fe76f4b851d" :question/math-academy-id "q-221929" :question/problem "Which of the following statements must be true for any integers $x$ and $y?$\n\nSelect all that apply.\n\n- **I.** $2$ divides $(6x-18y)$\n- **II.** $3$ divides $(6x-18y)$\n- **III.** $5$ divides $(6x-18y)$" :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \nWith that in mind, let's examine our statement in turn.\n\n- Statement I is true. Notice that \n\n$$\n6x-18y=2(3x-9y).\n$$\n\nSince $x$ and $y$ are integers, $3x-9y$ must be an integer, too. So, $2$ divides $(6x-18y).$\n\n- Statement II is true. Notice that \n\n$$\n6x-18y=3(2x-6y).\n$$\n\nSince $x$ and $y$ are integers, $2x-6y$ must be an integer, too. So, $3$ divides $(6x-18y).$\n\n- Statement III is false. For example, if $x=2$ and $y=1,$ we have $6(2)-18(1)=-6,$ which is not divisible by $5.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420258 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a19b88d-f0d3-5ce1-a354-e16dd44157c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453800} {:answer/id #uuid "0b541dca-6c1b-51ea-8ff8-8e8c09c289b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453801}] :answer-field/correct {:answer/id #uuid "7a19b88d-f0d3-5ce1-a354-e16dd44157c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453800} :answer-field/id #uuid "a1b4e2c7-01ac-5098-b14e-68597e290a8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454650} {:answer-field/choices [{:answer/id #uuid "78cf09bc-6b7f-591c-abaf-c9751546fdb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453802} {:answer/id #uuid "ddeb9d9e-70bb-5940-bdfd-2a3d6e2e6eeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453803}] :answer-field/correct {:answer/id #uuid "ddeb9d9e-70bb-5940-bdfd-2a3d6e2e6eeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453803} :answer-field/id #uuid "b8c07ba5-b2aa-5743-8686-116a9dcce74f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454651} {:answer-field/choices [{:answer/id #uuid "f827277c-b111-5abf-97a9-9696bb10ca2e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453804} {:answer/id #uuid "e0e904d9-1ffd-59fc-8e5a-55e88cc383fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453805}] :answer-field/correct {:answer/id #uuid "e0e904d9-1ffd-59fc-8e5a-55e88cc383fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453805} :answer-field/id #uuid "9aee165a-37d1-5d6a-ac3d-2a33ddf9b389" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454652}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24815c66-50ab-5aab-ac7b-25ddc673e132" :question/math-academy-id "q-221381" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $11∣k$ then $33∣k$\n\n- **II.** If $33∣k$ then $11∣k$\n\n- **III.** If $33∣k$ then $3∣k$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is false. As a counterexample, let $k=11.$ Then, $11∣11$ but $33∤11.$\n\n- Statement II is true. First, note that $11∣33.$ Therefore, we have\n$11∣33$ and $33∣k,$ which implies that $11∣k.$\n\n- Statement III is true. First, note that $3∣33.$ Therefore, we have\n$3∣33$ and $33∣k,$ which implies that $3∣k.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420260 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af754b47-d4e5-5fdc-8bd2-d6344c3485f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454108} {:answer/id #uuid "20675c10-e23b-542e-8faa-3a28254d9e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454109}] :answer-field/correct {:answer/id #uuid "20675c10-e23b-542e-8faa-3a28254d9e8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454109} :answer-field/id #uuid "e07d4f8b-55b6-5aab-b645-ac6b2ab28954" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454804} {:answer-field/choices [{:answer/id #uuid "7366dfaa-c59f-53f8-9c22-adfa0d5da165" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454110} {:answer/id #uuid "b9dda14e-0c1b-50ef-9d7b-3b7da9a958ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454111}] :answer-field/correct {:answer/id #uuid "b9dda14e-0c1b-50ef-9d7b-3b7da9a958ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454111} :answer-field/id #uuid "52e80153-dfde-514d-9bca-409913cc19fb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454805} {:answer-field/choices [{:answer/id #uuid "933f0836-d1bf-5067-a251-88602fe68e54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454112} {:answer/id #uuid "a54ed7bb-eae7-5c80-b6d8-e0ca1356ae7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454113}] :answer-field/correct {:answer/id #uuid "933f0836-d1bf-5067-a251-88602fe68e54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454112} :answer-field/id #uuid "4fa5cf00-ada4-5c14-974f-fda0ade37b37" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42a248b1-4b2a-5a7f-b673-589ac28da9a8" :question/math-academy-id "q-93649" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $10\\,|\\,21b$ then $10\\,|\\,b$\n\n- **II.** If $21\\,|\\,25b$ then $21\\,|\\,b$\n\n- **III.** If $15\\,|\\,9b$ then $15\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(10,21)=1.$ Therefore, we have $10\\,|\\,21b$ and $\\text{gcd}(10,21)=1,$ which implies $10\\,|\\,b.$\n\n- Statement II is true. First, note that $\\text{gcd}(21,25)=1.$ Therefore, we have $21\\,|\\,25b$ and $\\text{gcd}(21,25)=1,$ which implies $21\\,|\\,b.$\n\n- Statement III is false. As a counterexample, let $b=5.$ Then, $15∣9\\cdot 5$ but $15∤5.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420261 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "def3d752-65f1-5731-b05f-edd7c88aec7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454114} {:answer/id #uuid "d915cf80-9790-525d-89fc-8e8a3da1a8e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454115}] :answer-field/correct {:answer/id #uuid "def3d752-65f1-5731-b05f-edd7c88aec7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454114} :answer-field/id #uuid "334729c1-cb5a-5475-9dea-97ecb5445f59" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454807} {:answer-field/choices [{:answer/id #uuid "975a5231-8c85-5465-bad9-ae972d8cf69f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454116} {:answer/id #uuid "b61fa41d-4780-51db-95c8-9c1d84982a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454117}] :answer-field/correct {:answer/id #uuid "b61fa41d-4780-51db-95c8-9c1d84982a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454117} :answer-field/id #uuid "0b5db846-64da-5dd5-8276-1cccfb9bfcfb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454808} {:answer-field/choices [{:answer/id #uuid "b1521e88-f7fe-5024-9ad1-4e80a1f3ef2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454118} {:answer/id #uuid "471b8f3e-0e11-5794-b4e9-d0565d0ed717" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454119}] :answer-field/correct {:answer/id #uuid "471b8f3e-0e11-5794-b4e9-d0565d0ed717" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454119} :answer-field/id #uuid "2ee8f5f6-b6e7-5ae4-8c2d-b577fba2c54a" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454809}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "553ed68f-8e74-5dda-a8b3-cdd3e89c31cb" :question/math-academy-id "q-93650" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If ${19}^{2}\\,|\\,19b$ then ${19}^{2}\\,|\\,b$\n\n- **II.** If $12\\,|\\,35b$ then $12\\,|\\,b$\n\n- **III.** If $22\\,|\\,{7}^{2}b$ then $22\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is false. As a counterexample, let $b=19.$ Then, ${19}^{2}∣19\\cdot 19$ but ${19}^{2}∤19.$\n\n- Statement II is true. First, note that $\\text{gcd}(12,35)=1.$ Therefore, we have $12\\,|\\,35b$ and $\\text{gcd}(12,35)=1,$ which implies $12\\,|\\,b.$\n\n- Statement III is true. First, note that $\\text{gcd}(22,{7}^{2})=1.$ Therefore, we have $22\\,|\\,{7}^{2}b$ and $\\text{gcd}(22,{7}^{2})=1,$ which implies $22\\,|\\,b.$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186420262 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73bcb4b0-570c-5336-ae48-d0a3104dce91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454120} {:answer/id #uuid "d1c56f0f-ebe8-5bcc-ab39-2214650c58a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454121}] :answer-field/correct {:answer/id #uuid "d1c56f0f-ebe8-5bcc-ab39-2214650c58a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454121} :answer-field/id #uuid "54b20b3a-0759-5c20-9cc3-7b20438b436c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454810} {:answer-field/choices [{:answer/id #uuid "4daf1445-f4b8-5db6-b905-c837fed66207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454122} {:answer/id #uuid "d2222e06-b783-5847-8936-f4ecd2c0501f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454123}] :answer-field/correct {:answer/id #uuid "4daf1445-f4b8-5db6-b905-c837fed66207" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454122} :answer-field/id #uuid "ad1b8ea2-b742-5284-a512-3d2941ba5283" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454811} {:answer-field/choices [{:answer/id #uuid "1df7369c-f888-585b-b5a0-51c050df8758" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454124} {:answer/id #uuid "84ae4082-eeb0-54b9-8f03-f8d452322695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454125}] :answer-field/correct {:answer/id #uuid "84ae4082-eeb0-54b9-8f03-f8d452322695" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454125} :answer-field/id #uuid "025dafa7-6607-51f9-8e1b-41f4d1f7008d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454812}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ddd359d-678b-53c8-9991-000fcf922944" :question/math-academy-id "q-93657" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $3\\,|\\,a$ and $2\\,|\\,a$ then $6\\,|\\,a$\n\n- **II.** If $7\\,|\\,b$ and $14\\,|\\,b$ then $98\\,|\\,b$\n\n- **III.** If ${2}^{3}\\,|\\,c$ and $3\\,|\\,c$ then $24\\,|\\,c$" :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(2,3)=1$ and $2\\cdot 3=6.$ Therefore, we have $(2\\,|\\,a),(3\\,|\\,a),$ and $\\text{gcd}(2,3)=1,$ which implies $(6\\,|\\,a).$\n\n- Statement II is false. As a counterexample, let $b=14.$ Then, $(7∣14)$ and $(14∣14),$ but $(98∤14).$\n\n- Statement III is true. First, note that $\\text{gcd}({2}^{3},3)=1$ and ${2}^{3}\\cdot 3=24.$ Therefore, we have $({2}^{3}\\,|\\,c),(3\\,|\\,c),$ and $\\text{gcd}({2}^{3},3)=1,$ which implies $(24\\,|\\,c).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420264 :knowledge-point/_questions [{:db/id #edb/ref 17592186198311 :knowledge-point/id #uuid "c37bf66e-a574-5cf1-9c1a-fdfda98ca27b" :knowledge-point/title "Identifying True Statements Regarding Divisibility by a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e971550-afed-59da-9c00-b2572793e69d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454126} {:answer/id #uuid "ad9813ed-d5d9-523d-b081-2668d852fa1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454127}] :answer-field/correct {:answer/id #uuid "ad9813ed-d5d9-523d-b081-2668d852fa1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454127} :answer-field/id #uuid "e8189c37-e52b-5bae-a536-f2eb9672a785" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454813} {:answer-field/choices [{:answer/id #uuid "035e53a3-a6de-5d10-b8b2-bdce89b90466" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454128} {:answer/id #uuid "934ae89c-1a1a-5389-af92-c23152ee7c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454129}] :answer-field/correct {:answer/id #uuid "934ae89c-1a1a-5389-af92-c23152ee7c71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454129} :answer-field/id #uuid "70c93dc3-3af0-540d-9d04-a222f3f2bf34" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454814} {:answer-field/choices [{:answer/id #uuid "ef2efbec-ee42-5329-96fe-97e9248fd330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454130} {:answer/id #uuid "58adc57e-9bd7-589d-8e1c-4a3354aeed1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454131}] :answer-field/correct {:answer/id #uuid "ef2efbec-ee42-5329-96fe-97e9248fd330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454130} :answer-field/id #uuid "1cf2310a-22d8-5a6b-b36e-f907e424874e" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d7153a0-178f-57d1-b332-d3ea8e076028" :question/math-academy-id "q-93658" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $4\\,|\\,a$ and $9\\,|\\,a$ then $36\\,|\\,a$\n\n- **II.** If $5\\,|\\,b$ and $7\\,|\\,b$ then $35\\,|\\,b$\n\n- **III.** If ${6}^{2}\\,|\\,c$ and $2\\,|\\,c$ then $72\\,|\\,c$" :question/worked-solution "Recall that for any integers $a,$ $b,$ and $c,$\n\n$a\\,|\\,c,$ $\\,b\\,|\\,c,\\,$ and $\\,\\text{gcd}(a,b)=1$ $\\,⟹\\,$ $ab\\,|\\,c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}(4,9)=1$ and $4\\cdot 9=36.$ Therefore, we have $(4\\,|\\,a),(9\\,|\\,a),$ and $\\text{gcd}(4,9)=1,$ which implies $(36\\,|\\,a).$\n\n- Statement II is true. First, note that $\\text{gcd}(5,7)=1$ and $5\\cdot 7=35.$ Therefore, we have $(5\\,|\\,b),(7\\,|\\,b),$ and $\\text{gcd}(5,7)=1,$ which implies $(35\\,|\\,b).$\n\n- Statement III is false. As a counterexample, let $c=36.$ Then, $({6}^{2}∣36)$ and $(2∣36),$ but $(72∤36).$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420265 :knowledge-point/_questions [{:db/id #edb/ref 17592186198309 :knowledge-point/id #uuid "7eb430d5-5241-56a2-96be-73f44b0f2114" :knowledge-point/title "Identifying True Statements Regarding the Transitivity of Divisibility"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f311fe-31b2-5bb0-9024-4a1542c58b5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453794} {:answer/id #uuid "4b7a35b7-cd50-59b6-8cb6-a5d519fe2985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453795}] :answer-field/correct {:answer/id #uuid "4b7a35b7-cd50-59b6-8cb6-a5d519fe2985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453795} :answer-field/id #uuid "1779d8ec-8897-538a-9e78-6ce356268b33" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454647} {:answer-field/choices [{:answer/id #uuid "0170f81d-8cb2-5d63-b89e-313b3852372c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453796} {:answer/id #uuid "e6624e35-1287-54bb-aac2-5a914892c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453797}] :answer-field/correct {:answer/id #uuid "e6624e35-1287-54bb-aac2-5a914892c441" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453797} :answer-field/id #uuid "bcffcaa8-c3cf-5b50-b9f2-0085cba43a19" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454648} {:answer-field/choices [{:answer/id #uuid "8c1b5927-257c-5610-a08d-af3853d534a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453798} {:answer/id #uuid "3e540739-1a45-52b6-be9d-27d235244263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186453799}] :answer-field/correct {:answer/id #uuid "8c1b5927-257c-5610-a08d-af3853d534a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186453798} :answer-field/id #uuid "95dcbb32-4958-59b9-9b71-aef87e544a81" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454649}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73c135de-ad71-58aa-a780-c01d04341240" :question/math-academy-id "q-221379" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If $12∣h$ then $4∣h$\n\n- **II.** If $4∣h$ then $2∣h$\n\n- **III.** If $3∣h$ then $12∣h$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$ we have transitivity of divisibility:\n\n$a∣b\\,$ and $\\,b∣c$ $\\,⟹\\,$ $a∣c$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $4∣12.$ Therefore, we have\n$4∣12$ and $12∣h,$ which implies that $4∣h.$\n\n- Statement II is true. First, note that $2∣4.$ Therefore, we have\n$2∣4$ and $4∣h,$ which implies that $2∣h.$\n\n- Statement III is false. As a counterexample, let $h=3.$ Then, $3∣3$ but $12∤3.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186420269 :knowledge-point/_questions [{:db/id #edb/ref 17592186198310 :knowledge-point/id #uuid "6b3101aa-ee9e-5940-b170-2f4e78802150" :knowledge-point/title "Identifying True Statements Regarding the Divisibility of a Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8701a912-ef68-5863-a5cf-1e029092f167" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454102} {:answer/id #uuid "db9f8878-ded0-5bcb-9d41-9a3647d69fee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454103}] :answer-field/correct {:answer/id #uuid "db9f8878-ded0-5bcb-9d41-9a3647d69fee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454103} :answer-field/id #uuid "0ec63ad7-8480-580b-8832-9f3c4d1ce0ac" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454801} {:answer-field/choices [{:answer/id #uuid "06df3a3e-e9a7-5e3c-99e5-f2aeaa40e35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454104} {:answer/id #uuid "5ec7c826-456c-5eaf-ac54-507319f46a5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454105}] :answer-field/correct {:answer/id #uuid "06df3a3e-e9a7-5e3c-99e5-f2aeaa40e35a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454104} :answer-field/id #uuid "84f1cf04-cf52-54c6-882b-230f7c6c2638" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454802} {:answer-field/choices [{:answer/id #uuid "a948fc10-5292-5a77-b044-770a048b0c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186454106} {:answer/id #uuid "8b7f8828-83e5-5419-9e0e-116c56de2b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454107}] :answer-field/correct {:answer/id #uuid "8b7f8828-83e5-5419-9e0e-116c56de2b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186454107} :answer-field/id #uuid "2f093a1f-da2a-5ae9-9856-84636d51def5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186454803}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3b9fb7f-2262-5e34-bb97-3a915acfa755" :question/math-academy-id "q-93648" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** If ${3}^{2}\\,|\\,10b$ then ${3}^{2}\\,|\\,b$\n\n- **II.** If ${17}^{2}\\,|\\,17b$ then ${17}^{2}\\,|\\,b$\n\n- **III.** If $20\\,|\\,{3}^{3}b$ then $20\\,|\\,b$" :question/worked-solution "For any integers $a,$ $b,$ and $c,$\n\n$c\\,|\\,ab\\,$ and $\\,\\text{gcd}(a,c)=1$ $\\,⟹\\,$ $\\,c\\,|\\,b.$\n\nWith that in mind, let's examine each of the statements.\n\n- Statement I is true. First, note that $\\text{gcd}({3}^{2},10)=1.$ Therefore, we have ${3}^{2}\\,|\\,10b$ and $\\text{gcd}({3}^{2},10)=1,$ which implies ${3}^{2}\\,|\\,b.$\n\n- Statement II is false. As a counterexample, let $b=17.$ Then, ${17}^{2}∣17\\cdot 17$ but ${17}^{2}∤17.$\n\n- Statement III is true. First, note that $\\text{gcd}(20,{3}^{3})=1.$ Therefore, we have $20\\,|\\,{3}^{3}b$ and $\\text{gcd}(20,{3}^{3})=1,$ which implies $20\\,|\\,b.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186420695 :knowledge-point/_questions [{:db/id #edb/ref 17592186152076 :knowledge-point/id #uuid "6414abb9-00d3-55ea-a1e5-da99999c3ccc" :knowledge-point/title "