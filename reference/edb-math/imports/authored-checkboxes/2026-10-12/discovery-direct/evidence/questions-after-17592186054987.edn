ref 17592186448489}] :answer-field/correct {:answer/id #uuid "6e56c714-9eae-5d92-ae7a-fc891040bb0d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448488} :answer-field/id #uuid "8c089e73-ed91-5a8b-9ca4-83eb63eaf923" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449284} {:answer-field/choices [{:answer/id #uuid "cacd9eab-090e-5afe-8c09-b195213ed272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448490} {:answer/id #uuid "af17e22c-cc51-54d8-bbd0-ce661facaf42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448491}] :answer-field/correct {:answer/id #uuid "cacd9eab-090e-5afe-8c09-b195213ed272" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448490} :answer-field/id #uuid "3eb3fcfd-67ab-5b82-8f85-81448f13dc98" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449285}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14a51040-e179-5b66-9e0b-fca0e478f23c" :question/math-academy-id "q-214171" :question/problem "Consider the relation $R$ on the set $A={0,1,2}$ defined as \n\n$$\nR={(1,1),(0,2),(2,0)}.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $R$ is reflexive\n- **II.** $R$ is symmetric\n- **III.** $R$ is transitive\n- **IV.** $R$ is an equivalence relation" :question/worked-solution "Given a relation $R$ on a set $A$:\n\n- $R$ is reflexive if and only if for all $x\\in A,$ $x\\,R\\,x.$\n\n- $R$ is symmetric if and only if for all $x,y\\in A,$ if $x\\,R\\,y,$ then $y\\,R\\,x.$\n\n- $R$ is transitive if and only if for all $x,y,z\\in A,$ if $x\\,R\\,y$ and $y\\,R\\,z,$ then $x\\,R\\,z.$\n\nIf $R$ is reflexive, symmetric, and transitive, then $R$ is an equivalence relation.\n\nLet's consider each of the properties in turn.\n\n- The relation $R$ is *not* reflexive because  $(0,0)\\notin R.$\n\n- The relation $R$ is symmetric because $(y,x)\\in R$ whenever $(x,y)\\in R.$ $\\,\\,✓$\n\n- The relation $R$ is *not* transitive because $(0,2)\\in R$ and $(2,0)\\in R,$ but $(0,0)\\notin R$\n\n- The relation is *not* an equivalence relation since it's neither reflexive nor transitive.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186152747 :knowledge-point/_questions [{:db/id #edb/ref 17592186152074 :knowledge-point/id #uuid "2eebe007-8a95-578d-b553-e37a7bd8a327" :knowledge-point/title "Identifying Congruent Negative Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f978570c-6580-56e1-9460-5f3214d1f235" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448750} {:answer/id #uuid "ed6dce31-f022-5946-8902-518a0e2bbb17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448751}] :answer-field/correct {:answer/id #uuid "ed6dce31-f022-5946-8902-518a0e2bbb17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448751} :answer-field/id #uuid "8410ec4c-458f-57e2-a7b5-f09e80fe4fd2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449415} {:answer-field/choices [{:answer/id #uuid "60ab0c5e-37fd-575e-88ad-4464abb84a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448752} {:answer/id #uuid "b8688616-ef55-51cb-bbfa-70d3e1a518c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448753}] :answer-field/correct {:answer/id #uuid "60ab0c5e-37fd-575e-88ad-4464abb84a76" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448752} :answer-field/id #uuid "01241a79-73a4-5696-b5e9-6c65ff7c2ea0" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449416} {:answer-field/choices [{:answer/id #uuid "f133b002-888e-5134-8f6c-ef0184bf7602" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448754} {:answer/id #uuid "7a09dde9-800a-50d3-9937-ae0eff18239d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448755}] :answer-field/correct {:answer/id #uuid "7a09dde9-800a-50d3-9937-ae0eff18239d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448755} :answer-field/id #uuid "1b47060f-60ac-5389-8d01-2fc48cd65978" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449417}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bc725849-ec72-5565-a2a3-c18e7bade536" :question/math-academy-id "q-76784" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $11≡1\\,(\\text{mod}\\,5)$\n- **II.** $27≡15\\,(\\text{mod}\\,7)$\n- **III.** $30≡-18\\,(\\text{mod}\\,4)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is true because $5∣(11-1).$ There is no remainder:\n\n$$\n(11-1)÷5=10÷5=2\n$$\n\n- Statement II is false because $7∤(27-15).$ Notice that $27-15=12,$ which is not divisible by $7.$\n\n- Statement III is true because $4\\,|\\,(30-(-18)).$ There is no remainder:\n\n$$\n(30-(-18))÷4=48÷4=12\n$$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186152758 :knowledge-point/_questions [{:db/id #edb/ref 17592186152073 :knowledge-point/id #uuid "398716c2-d0e6-5106-a702-2f71d957726f" :knowledge-point/title "Identifying Congruent Integers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1790ea95-c04e-5e74-9ebe-478d69ec14ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448756} {:answer/id #uuid "9cffea29-ce10-5b82-b6f0-fda0b3748bf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448757}] :answer-field/correct {:answer/id #uuid "1790ea95-c04e-5e74-9ebe-478d69ec14ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448756} :answer-field/id #uuid "b03b37de-484b-5600-a01c-691628ffc5ae" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449418} {:answer-field/choices [{:answer/id #uuid "920a8ce9-af55-5bb8-a0b2-55fb72f836be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448758} {:answer/id #uuid "c0ada1f3-d53f-5796-82b5-46b26051243e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448759}] :answer-field/correct {:answer/id #uuid "c0ada1f3-d53f-5796-82b5-46b26051243e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448759} :answer-field/id #uuid "4cd4257f-7d31-5e46-acef-fbfc5fe8607e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449419} {:answer-field/choices [{:answer/id #uuid "4118f2bf-38f3-5c06-9e58-43a705ca04e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448760} {:answer/id #uuid "5200f51c-731d-5dcf-aa54-116cb1aefd56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448761}] :answer-field/correct {:answer/id #uuid "4118f2bf-38f3-5c06-9e58-43a705ca04e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448760} :answer-field/id #uuid "75c31522-73f1-59dd-b623-71de9752ce3c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449420}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "665aa776-ec33-596f-ae58-1e8a076473e5" :question/math-academy-id "q-76952" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $19≡5\\,(\\text{mod}\\,4)$\n- **II.** $22≡7\\,(\\text{mod}\\,3)$\n- **III.** $20≡9\\,(\\text{mod}\\,8)$" :question/worked-solution "First, we recall that \n\n$$\na≡b\\,(\\text{mod}\\,n)\\,⟺\\,n∣(a-b).\n$$\n\nSo, $a$ and $b$ are congruent modulo $n$ if and only if $(a-b)$ is divisible by $n$ (there is no remainder).\n\nWith that in mind, let's analyze each statement in turn.\n\n- Statement I is false because $4∤(19-5).$ Notice that $19-5=14,$ which is not divisible by $4.$\n\n- Statement II is true because $3∣(22-7).$ There is no remainder:\n\n$$\n(22-7)÷3=15÷3=5\n$$\n\n- Statement III is false because $8∤(20-9).$ Notice that $20-5=15,$ which is not divisible by $4.$\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186152878 :knowledge-point/_questions [{:db/id #edb/ref 17592186152126 :knowledge-point/id #uuid "f7063140-eebe-598c-b530-3c13509d359b" :knowledge-point/title "Classifying Numbers as Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ded51ae-3828-55c2-9e45-b194a3a30cce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448858} {:answer/id #uuid "c3fc0999-add2-5a61-99f1-345783abd7de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448859}] :answer-field/correct {:answer/id #uuid "1ded51ae-3828-55c2-9e45-b194a3a30cce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448858} :answer-field/id #uuid "37f8f7af-8745-5efd-9267-e8a1ca839c2c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449469} {:answer-field/choices [{:answer/id #uuid "1492293f-4556-5254-ba65-c0b739554035" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448860} {:answer/id #uuid "53e198f5-a329-5d67-a0af-649a28e57496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448861}] :answer-field/correct {:answer/id #uuid "53e198f5-a329-5d67-a0af-649a28e57496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448861} :answer-field/id #uuid "50641ce1-4436-54c1-85f7-3ccfc8587903" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449470} {:answer-field/choices [{:answer/id #uuid "37e674fb-807c-5cf5-aa23-ece394d4fe78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448862} {:answer/id #uuid "88cf372d-e313-5560-90f4-5ad9535887c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448863}] :answer-field/correct {:answer/id #uuid "88cf372d-e313-5560-90f4-5ad9535887c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448863} :answer-field/id #uuid "5a0ae48d-fa38-5d85-b84b-0309468938dc" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449471}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0d528fe-7741-52a6-a947-e2ff7f9a758d" :question/math-academy-id "q-98382" :question/problem "Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $-2$ is a natural number\n\n- **II.** $-2$ is an integer\n\n- **III.** $-2$ is a rational number" :question/worked-solution "Let's recall our definitions.\n\n- The natural numbers consist of all positive whole numbers: $1,\\,2,\\,3,\\,4,\\,5,…$\n\n- The integers consist of all of the positive and negative whole numbers, and zero: $…,-3,\\,-2,\\,-1,\\,0,\\,1,\\,2,\\,3,…$\n\n- The rationals consist of any number that can be written as the ratio of two integers.\n\nNow, let's go through each number in turn.\n\n- $-2$ is not a natural number.\n\n- $-2$ is an integer.\n\n- $-2$ is a rational number because it can be written as $\\frac{(-2)}{1}.$\n\nTherefore, the correct answer is, \"II and III only.\""}]}
