09-b69c-f51e9fd595b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450447}] :answer-field/correct {:answer/id #uuid "9d9c5801-9019-57ca-93c4-8d5e18dac042" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450446} :answer-field/id #uuid "70e87aa0-6c37-57e0-9829-c738cc1d85a5" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451177}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55adb6e6-36a2-5272-9189-7161d38a92cd" :question/math-academy-id "q-333578" :question/problem "Which of the following statements are true when testing the stability of the trapezoidal method on the test equation ${y}^{′}=-\\lambda y$ with $y=y(x),y(0)=2,x\\ge 0,\\lambda =7,$ and step size $Δx?$\n\nSelect all that apply.\n\n- **I.** The stability function is $R(7Δx)=\\frac{1+7Δx/2}{1-7Δx/2}.$\n- **II.** The stability region is $|\\frac{2-7Δx}{2+7Δx}|<1.$\n- **III.** The method is absolutely stable.\n- **IV.** The method is **unstable** for step size $Δx=0.5.$\n\n*Hint:* The stability function $R$ is given by ${y}_{n+1}=R(\\lambda Δx){y}_{n}.$" :question/worked-solution "A numerical method\n${y}_{n+1}={y}_{n}+Δ{y}_{n}$\nis stable for a given step size $Δx$ if, when applied to the test equation\n\n$$\n{y}^{′}=-\\lambda y,\\,y(0)=2,\\,x\\ge 0,\\,\\lambda >0,\n$$\n\nthe numerical solution satisfies ${y}_{n}\\to 0$ as $n\\to \\infty ,$ just like the exact solution.\n\nWhen a method is applied to the test equation, the update takes the form\n\n$$\n{y}_{n+1}=R(\\lambda Δx){y}_{n},\n$$\n\nwhere $R(\\lambda Δx)$ is the stability function of the method. The set of values for which the method is stable, given by $|R(\\lambda Δx)|<1,$ is called the stability region of the method.\n\nA method that is stable for all possible values $\\lambda Δx>0$ is called absolutely stable.\n\nNow, let's check the stability of the trapezoidal method by applying it to the test equation\n\n$$\n{y}^{′}=-7y,\\,y(0)=2.\n$$\n\nFirst, for an initial value problem ${y}^{′}=f(x,y),y({x}_{0})={y}_{0},$ the trapezoidal method is given by the update formula\n\n$$\n{y}_{n+1}={y}_{n}+\\frac{1}{2}(f({x}_{n},{y}_{n})+f({x}_{n+1},{y}_{n+1}))\\cdot Δx.\n$$\n\nWe now examine our statements:\n\n- Applying the trapezoidal method to this test equation, we get the following:\n\n$$\n\\begin{aligned}{y}_{n+1} & ={y}_{n}+\\frac{1}{2}(f({x}_{n},{y}_{n})+f({x}_{n+1},{y}_{n+1}))\\cdot Δx \\\\ {y}_{n+1} & ={y}_{n}+\\frac{1}{2}(-7{y}_{n}+(-7{y}_{n+1}))\\cdot Δx \\\\ {y}_{n+1}+\\frac{7}{2}{y}_{n+1}\\cdot Δx & ={y}_{n}-\\frac{7}{2}{y}_{n}\\cdot Δx \\\\ (1+\\frac{7}{2}Δx){y}_{n+1} & =(1-\\frac{7}{2}Δx){y}_{n} \\\\ {y}_{n+1} & =\\frac{1-7Δx/2}{1+7Δx/2}\\cdot {y}_{n}\\end{aligned}\n$$\n\nSo, the stability function is $R(7Δx)=\\frac{1-7Δx/2}{1+7Δx/2}.$ Hence, statement I is false.\n\n- The stability region of the method is\n\n$$\n\\begin{aligned}|R(7Δx)| & <1 \\\\ |\\frac{1-7Δx/2}{1+7Δx/2}| & <1 \\\\ |\\frac{2-7Δx}{2+7Δx}| & <1.\\end{aligned}\n$$\n\nHence, statement II is true.\n\n- Rearranging, we have\n\n$$\n\\begin{aligned}\\frac{|2-7Δx|}{|2+7Δx|} & <1 \\\\ |2-7Δx| & <|2+7Δx| \\\\ (2-7Δx)^{2} & <(2+7Δx)^{2} \\\\ 4-28Δx+49(Δx)^{2} & <4+28Δx+49(Δx)^{2} \\\\ -28Δx & <28Δx.\\end{aligned}\n$$\n\nSince $Δx>0,$ this inequality is always true. Thus, the trapezoidal method is absolutely stable, and statement III is true.\n\n- Finally, since it is absolutely stable, the trapezoidal method is stable for step size $Δx=0.5,$ and hence statement IV is false.\n\nIn conclusion, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186308534 :knowledge-point/_questions [{:db/id #edb/ref 17592186229160 :knowledge-point/id #uuid "d1bff615-1f3e-50ca-b6e8-55a51ea4366e" :knowledge-point/title "Identifying True Statements About the Stability of Other Methods"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "325ae0b8-b12f-51fb-bf37-0ad049b140b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450448} {:answer/id #uuid "3f07c521-0c42-5feb-a2f9-a34c8e920b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450449}] :answer-field/correct {:answer/id #uuid "3f07c521-0c42-5feb-a2f9-a34c8e920b21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450449} :answer-field/id #uuid "e341d65f-3bb5-5181-bc1e-a5b09f7fbcec" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451178} {:answer-field/choices [{:answer/id #uuid "7130268a-ae24-5efa-a2ae-0809fb7aa80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450450} {:answer/id #uuid "18d1796c-d34c-50d6-a020-999c82bd213d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450451}] :answer-field/correct {:answer/id #uuid "7130268a-ae24-5efa-a2ae-0809fb7aa80b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450450} :answer-field/id #uuid "5fbf22b0-0965-5e9a-b603-6445eb41911b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451179} {:answer-field/choices [{:answer/id #uuid "468f66ec-a0fc-5dc6-b336-b9e20bcaee6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450452} {:answer/id #uuid "0c4e1c5b-7772-5cd1-a2eb-1eaf0ff1d57e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450453}] :answer-field/correct {:answer/id #uuid "468f66ec-a0fc-5dc6-b336-b9e20bcaee6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450452} :answer-field/id #uuid "a422fa74-2d88-57d0-ad36-8b90134fee2b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451180} {:answer-field/choices [{:answer/id #uuid "334d336b-10d6-59d7-aef6-de8a06343ff2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450454} {:answer/id #uuid "ed16a682-5357-584a-afb8-68366e4bb05e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450455}] :answer-field/correct {:answer/id #uuid "334d336b-10d6-59d7-aef6-de8a06343ff2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450454} :answer-field/id #uuid "2eb9ec87-bbc0-52e8-8de9-b614a3a68681" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451181}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d872692-c2e4-5ebe-a433-d44857eb60bd" :question/math-academy-id "q-333930" :question/problem "For the initial value problem ${y}^{′}=f(x,y),y({x}_{0})={y}_{0},$ the modified Euler method can be expressed as the update formula\n\n$$\n\\begin{aligned}Δ{y}_{n}^{(p)} & =f({x}_{n},{y}_{n})\\cdot Δx, \\\\ {y}_{n+1} & ={y}_{n}+\\frac{1}{2}(f({x}_{n},{y}_{n})+f({x}_{n+1},{y}_{n}+Δ{y}_{n}^{(p)}))\\cdot Δx.\\end{aligned}\n$$\n\nWhich of the following statements are true when testing the stability of the modified Euler method on the test equation ${y}^{′}=-\\lambda y$ with $y=y(x),y(0)=1,x\\ge 0,\\lambda =4,$ and step size $Δx?$\n\nSelect all that apply.\n\n- **I.** The stability function is $R(4Δx)=1-4Δx+8(Δx)^{2}.$\n- **II.** The stability region is $|8{(Δx-\\frac{1}{4})}^{2}|<1.$\n- **III.** The method is absolutely stable.\n- **IV.** The method is stable for step size $Δx=0.5.$\n\n*Hint:* The stability function $R$ is given by ${y}_{n+1}=R(\\lambda Δx){y}_{n}.$" :question/worked-solution "A numerical method\n${y}_{n+1}={y}_{n}+Δ{y}_{n}$\nis stable for a given step size $Δx$ if, when applied to the test equation\n\n$$\n{y}^{′}=-\\lambda y,\\,y(0)=1,\\,x\\ge 0,\\,\\lambda >0,\n$$\n\nthe numerical solution satisfies ${y}_{n}\\to 0$ as $n\\to \\infty ,$ just like the exact solution.\n\nWhen a method is applied to the test equation, the update takes the form\n\n$$\n{y}_{n+1}=R(\\lambda Δx){y}_{n},\n$$\n\nwhere $R(\\lambda Δx)$ is the stability function of the method. The set of values for which the method is stable, given by $|R(\\lambda Δx)|<1,$ is called the stability region of the method.\n\nA method that is stable for all possible values $\\lambda Δx>0$ is called absolutely stable.\n\nNow, let's check the stability of the modified Euler Method by applying it to the test equation\n\n$$\n{y}^{′}=-4y,\\,y(0)=1.\n$$\n\nWe now examine our statements:\n\n- Applying the modified Euler method to this test equation, we get the following:\n\n$$\n\\begin{aligned}{y}_{n}+Δ{y}_{n}^{(p)} & ={y}_{n}+f({x}_{n},{y}_{n})\\cdot Δx \\\\  & ={y}_{n}-4{y}_{n}\\cdot Δx\\end{aligned}\n$$\n\nThus,\n\n$$\n\\begin{aligned}{y}_{n+1} & ={y}_{n}+\\frac{1}{2}(f({x}_{n},{y}_{n})+f({x}_{n+1},{y}_{n}-4{y}_{n}\\cdot Δx))\\cdot Δx \\\\  & ={y}_{n}+\\frac{1}{2}(-4{y}_{n}-4({y}_{n}-4{y}_{n}\\cdot Δx))\\cdot Δx \\\\  & ={y}_{n}+\\frac{1}{2}(-8{y}_{n}+16{y}_{n}\\cdot Δx)\\cdot Δx \\\\  & ={y}_{n}-4{y}_{n}\\cdot Δx+8{y}_{n}\\cdot (Δx)^{2} \\\\  & =[1-4Δx+8(Δx)^{2}]{y}_{n}.\\end{aligned}\n$$\n\nSo, the stability function is $R(4Δx)=1-4Δx+8(Δx)^{2}.$ Hence, statement I is true.\n\n- The method is stable when\n\n$$\n\\begin{aligned}|R(4Δx)| & <1 \\\\ |1-4Δx+8(Δx)^{2}| & <1 \\\\ |8{(Δx-\\frac{1}{4})}^{2}+\\frac{1}{2}| & <1.\\end{aligned}\n$$\n\nTherefore, ${y}_{n}$ converges to $0$ as $n\\to \\infty $ if and only if\n\n$$\n|8{(Δx-\\frac{1}{4})}^{2}+\\frac{1}{2}|<1.\n$$\n\nHence, statement II is false.\n\n- Now, since the argument of the absolute value is always non-negative, we can remove the absolute value. So, we have\n\n$$\n\\begin{aligned}8{(Δx-\\frac{1}{4})}^{2}+\\frac{1}{2} & <1 \\\\ 8{(Δx-\\frac{1}{4})}^{2} & <\\frac{1}{2} \\\\ {(Δx-\\frac{1}{4})}^{2} & <\\frac{1}{16} \\\\ -\\frac{1}{4}<Δx-\\frac{1}{4} & <\\frac{1}{4} \\\\ 0<Δx & <\\frac{1}{2}\\end{aligned}\n$$\n\nThus, the modified Euler method is not absolutely stable, and statement III is false.\n\n- Finally, since it does not satisfy this inequality, the modified Euler method is unstable for step size $Δx=0.5,$ and hence statement IV is false.\n\nIn conclusion, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186308536 :knowledge-point/_questions [{:db/id #edb/ref 17592186229160 :knowledge-point/id #uuid "d1bff615-1f3e-50ca-b6e8-55a51ea4366e" :knowledge-point/title "Identifying True Statements About the Stability of Other Methods"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "978033bf-6d3c-5fc0-9a25-a661031ac38c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450456} {:answer/id #uuid "727e683c-c551-5aeb-b0fb-8f2c3d784e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450457}] :answer-field/correct {:answer/id #uuid "727e683c-c551-5aeb-b0fb-8f2c3d784e4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450457} :answer-field/id #uuid "b4c3637c-d804-5401-9392-eaf16c8e4c12" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-fi