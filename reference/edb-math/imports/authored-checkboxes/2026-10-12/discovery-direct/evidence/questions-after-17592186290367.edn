f31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450591} :answer-field/id #uuid "f8e4a50c-b87c-5e4d-88a1-e33c5b57c607" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451249} {:answer-field/choices [{:answer/id #uuid "52a72544-303f-5a4c-a46c-e62d55037959" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450592} {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593}] :answer-field/correct {:answer/id #uuid "ad86dbb3-f60e-5466-800f-47012e2a976c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450593} :answer-field/id #uuid "e6475119-a024-5d8a-8708-d3d59741c388" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451250}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d3f90-ae5f-56ba-9210-f0c988989a62" :question/math-academy-id "q-37267" :question/problem "Which of the following statements are true for the sets $A={5,10,15,20,25,30,35,…}$ and $B={5n∣n\\in N,3\\le n\\le 7}?$\n\nSelect all that apply.\n\n- **I.** $B⊆A$\n- **II.** $A⊆B$\n- **III.** $A⊈B$\n- **IV.** $A⊇B$" :question/worked-solution "First, we must find the elements of the set $B.$ Substituting the values $n\\in {3,4,5,6,7}$ into the formula $5n,$ we get the following elements:\n\n$$\n\\begin{aligned}n=3 & \\,⇒\\,5(3)=15 \\\\ n=4 & \\,⇒\\,5(4)=20 \\\\ n=5 & \\,⇒\\,5(5)=25 \\\\ n=6 & \\,⇒\\,5(6)=30 \\\\ n=7 & \\,⇒\\,5(7)=35\\end{aligned}\n$$\n\nSo, we have\n\n$$\nB={15,20,25,30,35}.\n$$\n\nNow, let's inspect the given statements.\n\n- $B⊆A$ is true. Every element in the set $B$ is an element of the set $A.$\n\n- $A⊆B$ is false, while $A⊈B$ is true. For example, $5\\in A$ but $5\\notin B.$\n\n- $A⊇B$ is equivalent to $B⊆A,$ which is true.\n\nTherefore, the correct answer is \"I, III, and IV only\"."}] [{:db/id #edb/ref 17592186323917 :knowledge-point/_questions [{:db/id #edb/ref 17592186124654 :knowledge-point/id #uuid "4ca319c5-9f62-51e3-b670-611fc8a8daaa" :knowledge-point/title "Classifying a Critical Point Using the Second Partial Derivatives Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76120093-e343-5052-a462-9eeed4935b72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450594} {:answer/id #uuid "555c0670-0865-5a00-b027-f58a0b26c69f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450595}] :answer-field/correct {:answer/id #uuid "555c0670-0865-5a00-b027-f58a0b26c69f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450595} :answer-field/id #uuid "3298d537-d11e-5eb5-b471-be1eb348f6fe" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451251} {:answer-field/choices [{:answer/id #uuid "1e466c1b-7f85-5787-9f33-f387b0440aa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450596} {:answer/id #uuid "3a2b7b99-7dac-506f-8f5e-60849b213bf8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450597}] :answer-field/correct {:answer/id #uuid "1e466c1b-7f85-5787-9f33-f387b0440aa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450596} :answer-field/id #uuid "1c78cee0-1b49-5dcb-820f-d25ea871fcfa" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451252} {:answer-field/choices [{:answer/id #uuid "5d90c823-2374-59b3-b675-22903d76217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450598} {:answer/id #uuid "566b5d8d-7821-54bd-ac4b-b928d840baa2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450599}] :answer-field/correct {:answer/id #uuid "5d90c823-2374-59b3-b675-22903d76217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450598} :answer-field/id #uuid "c44d6730-238d-5968-83bf-bfd50fc8649d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451253}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14dd51d6-4da8-56bc-8036-6e67390713d4" :question/math-academy-id "q-37449" :question/problem "The function   $f(x,y)$\nhas the first derivative\n\n$$\n{f}^{′}(x,y)=[\\begin{aligned}-{x}^{3}+2{x}^{2}+4y & 4x-2y\\end{aligned}]\n$$\n\nand has a stationary point at $(4,8).$ If $H$ denotes the Hessian determinant of $f,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $H(4,8)>0$\n- **II.** $\\frac{{∂}^{2}f}{∂{x}^{2}}(4,8)>0$\n- **III.** The point $(4,8)$ is a saddle point of $f$" :question/worked-solution "The second partial derivative test states that if $a\\in {R}^{2}$ is a stationary point of $f(x,y)$ with Hessian determinant $H(a),$ we have the following:\n\n- If $H(a)>0,$ then:\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)<0,$ then $f$ has a local maximum at $a$\n\n- if $\\frac{{∂}^{2}f}{∂{x}^{2}}(a)>0,$ then $f$ has a local minimum at $a$\n\n- If $H(a)<0,$ then $f$ has a saddle point at $a$\n\n- If $H(a)=0,$ then the second partial derivatives test is inconclusive.\n\nFirst, we notice that since ${f}^{′}(x,y)=[\\begin{aligned}-{x}^{3}+2{x}^{2}+4y & 4x-2y\\end{aligned}],$ we must have \n\n$$\n\\frac{∂f}{∂x}=-{x}^{3}+2{x}^{2}+4y,\\,\\frac{∂f}{∂y}=4x-2y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(-{x}^{3}+2{x}^{2}+4y)=-3{x}^{2}+4x \\\\ \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(4x-2y)=-2 \\\\ \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{{∂}^{2}f}{∂y∂x}=\\frac{∂}{∂x}(4x-2y)=4\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂x∂y}\\end{aligned}]=[\\begin{aligned}-3{x}^{2}+4x & 4 \\\\ 4 & -2\\end{aligned}].\\end{aligned}\n$$\n\nEvaluating the second derivative at $(4,8),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(4,8)=[\\begin{aligned}-32 & 4 \\\\ 4 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, computing the determinant of ${f}^{″}(4,8),$ we get\n\n$$\nH(4,8)=det({f}^{″}(4,8))=(-32)\\cdot (-2)-{4}^{2}=48>0.\n$$\n\n- Statement II is false. We have $\\frac{{∂}^{2}f}{∂{x}^{2}}(4,8)=({f}^{″}(4,8))_{11}=-32<0.$\n\n- Statement III is false. Since $H(4,8)>0$ and $\\frac{{∂}^{2}f}{∂{x}^{2}}(4,8)<0,$ the point $(4,8)$ is a local maximum by the second partial derivative test.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186326727 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a41ae6c-0d04-54af-b7e1-66f17408a105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450600} {:answer/id #uuid "a7e20032-0a94-5027-bacb-72669ad1d4f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450601}] :answer-field/correct {:answer/id #uuid "a7e20032-0a94-5027-bacb-72669ad1d4f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450601} :answer-field/id #uuid "4edeacdc-e033-5790-be2d-7d85e4729f99" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451254} {:answer-field/choices [{:answer/id #uuid "58668fbd-bb78-5c00-9a1d-8a7d75b7e60d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450602} {:answer/id #uuid "e3d6d4d0-1f79-5205-af00-ebe990fad527" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450603}] :answer-field/correct {:answer/id #uuid "e3d6d4d0-1f79-5205-af00-ebe990fad527" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450603} :answer-field/id #uuid "dc9782cf-b2f2-54f3-8f50-7e6a03793938" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451255} {:answer-field/choices [{:answer/id #uuid "40bfaa4a-5a0a-58da-a864-f7887eb901d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450604} {:answer/id #uuid "834cbe2c-64aa-52c2-adae-2d8273e27d83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450605}] :answer-field/correct {:answer/id #uuid "834cbe2c-64aa-52c2-adae-2d8273e27d83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450605} :answer-field/id #uuid "ec37b2c3-76d5-5c6f-b7f5-1d6ee3b324e5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e6f3463-c123-5a14-aa68-90e5211244ca" :question/math-academy-id "q-38905" :question/problem "Which of the following statements are true given that $T:{R}^{6}\\to {R}^{6}$ is a linear transformation whose standard matrix is $T,$ and $T$ is a bijection?\n\nSelect all that apply.\n\n- **I.** $\\text{Ker}(T)={0}$\n- **II.** $\\text{Im}(T)={R}^{6}$\n- **III.** $\\text{rank}(T)=6$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{6}$ into ${R}^{6},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{6} \\\\  & \\text{rank}(T)=6 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Ker}(T)={0}.$\n\n- Statement II is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{Im}(T)={R}^{6}.$\n\n- Statement III is true. Since $T$ is a bijection, the invertible matrix theorem implies that $\\text{rank}(T)=6.$\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186326728 :knowledge-point/_questions [{:db/id #edb/ref 17592186124521 :knowledge-point/id #uuid "e9d77214-796e-558f-a364-00ae3e25cc13" :knowledge-point/title "Identifying True Statements Using the Invertible Matrix Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3b6b69e-fdda-5b48-8cbe-b6154cd7c5d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450606} {:answer/id #uuid "97c3efcd-f3c2-540f-afcf-4d2de2e5f841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450607}] :answer-field/correct {:answer/id #uuid "97c3efcd-f3c2-540f-afcf-4d2de2e5f841" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450607} :answer-field/id #uuid "53da20ae-ae94-56fd-81c5-8688aef36c20" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451257} {:answer-field/choices [{:answer/id #uuid "bfca9365-98df-5eb7-95b1-2fb60431dc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450608} {:answer/id #uuid "6fac619f-5615-571c-9063-072979a2d254" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450609}] :answer-field/correct {:answer/id #uuid "bfca9365-98df-5eb7-95b1-2fb60431dc72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450608} :answer-field/id #uuid "993a94ac-7b36-59ae-a4b9-f0f0c7e4df6e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451258} {:answer-field/choices [{:answer/id #uuid "f0e4ee71-9c86-5467-baba-02fbccd28493" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450610} {:answer/id #uuid "d04c4a7d-4c1f-51ad-98ba-4f0eef654db3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450611}] :answer-field/correct {:answer/id #uuid "d04c4a7d-4c1f-51ad-98ba-4f0eef654db3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450611} :answer-field/id #uuid "747ffb98-bf8f-5e74-a1a2-d5a8752eab30" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451259}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d76ba203-8385-5ab0-a588-ad7d93b64899" :question/math-academy-id "q-38907" :question/problem "Which of the following statements are true given that $T:{R}^{5}\\to {R}^{5}$ is a linear transformation whose standard matrix is $T,$ and ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)?$\n\nSelect all that apply.\n\n- **I.** $\\text{rank}(T)=3$\n- **II.** $T$ is invertible\n- **III.** $\\text{nullity}(T)>0$" :question/worked-solution "Since $T$ is a linear transformation from ${R}^{5}$ into ${R}^{5},$ the invertible matrix theorem states the following:\n\n $T$ is a bijection (an invertible transformation) $\\,⟺\\,{\\,\\begin{aligned} & \\text{Im}(T)={R}^{5} \\\\  & \\text{rank}(T)=5 \\\\  & \\text{Ker}(T)={0} \\\\  & \\text{nullity}(T)=0\\end{aligned}$ \n\nWith that in mind, let's examine each statement in turn.\n\n- Statement I is true. Since ${{v}_{1},{v}_{2},{v}_{3}}$ is a basis of $\\text{Col}(T)$ we must have that $\\text{rank}(T)=3.$\n\n- Statement II is false. According to the invertible matrix theorem, since $\\text{rank}(T)\\ne 5,$ the transformation $T$ and the matrix $T$ are not invertible.\n\n- Statement III is true. Since $T$ is not invertible, the invertible matrix theorem implies that $\\text{nullity}(T)\\ne 0.$ In turn, this means that $\\text{nullity}(T)>0.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186326833 :knowledge-point/_questions [{:db/id #edb/ref 17592186129213 :knowledge-point/id #uuid "434a82c2-7964-525a-85b9-eb17fa7b5b26" :knowledge-point/title "Identifying Connections Between Matrices of a Linear Transformation Relative to Different Bases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d988f2e6-8566-5999-9247-7fac533a9295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450612} {:answer/id #uuid "89dae380-77c4-59f5-91cc-e46aa3e51718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450613}] :answer-field/correct {:answer/id #uuid "89dae380-77c4-59f5-91cc-e46aa3e51718" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450613} :answer-field/id #uuid "c7fc02e9-bc92-55a1-b760-0628ccf45a59" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451260} {:answer-field/choices [{:answer/id #uuid "b41db3b9-2667-55f0-9f27-b6ad59f1db21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450614} {:answer/id #uuid "398c62f8-02c3-5c69-8f10-417fb2ab45db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450615}] :answer-field/correct {:answer/id #uuid "b41db3b9-2667-55f0-9f27-b6ad59f1db21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450614} :answer-field/id #uuid "d9ec1260-1b87-550f-ae57-933ff1b4a57b" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451261} {:answer-field/choices [{:answer/id #uuid "16384e17-4347-5ba9-8b00-34639ad8d1d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450616} {:answer/id #uuid "98e7be82-e824-5b9c-ada1-a8ebc9470a63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450617}] :answer-field/correct {:answer/id #uuid "16384e17-4347-5ba9-8b00-34639ad8d1d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450616} :answer-field/id #uuid "cd7e9c73-8df5-5a9f-9b10-48fdad19c370" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3221319-81c0-55a5-8884-351b35c9f34f" :question/math-academy-id "q-40372" :question/problem "Let $[T]_{B}$ and $[T]_{C}$ be the matrices of a linear transformation $T$ relative to the bases $B$ and $C,$ respectively. If ${P}_{C\\to B}$ is the change-of-coordinates matrix from basis $C$ to basis $B,$ which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}$\n- **II.** $[T]_{B}=[T]_{C}^{-1}\\cdot {P}_{C\\to B}\\cdot [T]_{C}$\n- **III.** $[T]_{C}={P}_{C\\to B}\\cdot [T]_{B}\\cdot {P}_{C\\to B}^{-1}$" :question/worked-solution "The connection between the matrices of our linear transformation $T$ relative to the bases $B$ and $C$ is given by the following diagram:\n\n![](images/9b/9ba3d1f0eebdfc82c40f36bdbe16896ca15516b623c695b72c331861955329bc.png)\n\nHere, moving along an arrow means pre-multiplying by the corresponding matrix. Algebraically, we can write this as\n\n$$\n[T]_{C}={P}_{C\\to B}^{-1}\\cdot [T]_{B}\\cdot {P}_{C\\to B},\n$$\n\nwhere ${P}_{C\\to B}$ is the change-of-coordinates matrix from $C$ to $B.$\n\nSolving this equation for $[T]_{B},$ we obtain the alternative formulation\n\n$$\n[T]_{B}={P}_{C\\to B}\\cdot [T]_{C}\\cdot {P}_{C\\to B}^{-1}.\n$$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186329640 :knowledge-point/_questions [{:db/id #edb/ref 17592186115228 :knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98d094e2-1177-5e99-96ad-7caeee897640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450618} {:answer/id #uuid "ca99c815-da6d-51d7-a07d-611d7659f788" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450619}] :answer-field/correct {:answer/id #uuid "98d094e2-1177-5e99-96ad-7caeee897640" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450618} :answer-field/id #uuid "c30fd7ce-bd14-59fb-ab10-845f8a59bb92" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451263} {:answer-field/choices [{:answer/id #uuid "956b7a25-6517-5ef2-837c-39c50a5c5a32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450620} {:answer/id #uuid "bd63bdd4-4b06-56ad-b67b-a613cc1dd46f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450621}] :answer-field/correct {:answer/id #uuid "bd63bdd4-4b06-56ad-b67b-a613cc1dd46f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450621} :answer-field/id #uuid "382ec9ba-1720-5328-8c38-f194ab93dcab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451264} {:answer-field/choices [{:answer/id #uuid "762ad639-2afc-55e3-bdc7-be4e7057c714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450622} {:answer/id #uuid "7a78eef3-ff9c-56b5-98cb-545a4b324d66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450623}] :answer-field/correct {:answer/id #uuid "762ad639-2afc-55e3-bdc7-be4e7057c714" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450622} :answer-field/id #uuid "800a3551-29f1-5bb8-a3bc-66ca201c01c9" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "005a0156-3d99-59d1-ab99-adf9b9b4c7b4" :question/math-academy-id "q-42264" :question/problem "Given that $A,B,$ and $C$ are $2\\times 2$ matrices, which of the following statements are always true?\n\nSelect all that apply.\n\n- **I.** $AB=BA$\n\n- **II.** $(AB)C=A(BC)$\n\n- **III.** $A(B-C)=(B-C)A$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement II is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\n\n- Statement III is false. Matrix multiplication is not commutative, so $A(B-C)\\ne (B-C)A$ in general.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186329641 :knowledge-point/_questions [{:db/id #edb/ref 17592186115228 :knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ede5fc7-4e98-54a5-a8b6-e3d24c4c38db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450624} {:answer/id #uuid "55e4960c-b4a8-5dc4-9358-5474cf82f7c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450625}] :answer-field/correct {:answer/id #uuid "0ede5fc7-4e98-54a5-a8b6-e3d24c4c38db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450624} :answer-field/id #uuid "3d5404b0-68d0-5679-9acd-82c4cfdc5828" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451266} {:answer-field/choices [{:answer/id #uuid "a7725433-91f4-58a8-86f9-aeb838dcca83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450626} {:answer/id #uuid "db204d99-d48d-5b15-a94d-fd45955b1ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450627}] :answer-field/correct {:answer/id #uuid "db204d99-d48d-5b15-a94d-fd45955b1ffa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450627} :answer-field/id #uuid "36d78dc9-a409-525c-846b-1acf74456b6c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451267} {:answer-field/choices [{:answer/id #uuid "6be3f3c0-0d5f-53d8-b5d4-1cdbc4330e3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450628} {:answer/id #uuid "32dd403d-28b4-5b42-93d6-1c1a8a1630d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450629}] :answer-field/correct {:answer/id #uuid "32dd403d-28b4-5b42-93d6-1c1a8a1630d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450629} :answer-field/id #uuid "baab8b40-76af-5c21-b0d3-f31812f8c1dd" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451268}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cea2f24d-948b-5d70-91c6-23df57186795" :question/math-academy-id "q-42267" :question/problem "Given that $A,B,$ and $C$ are $5\\times 5$ matrices, and  ${I}_{5}$ is the $5\\times 5$ identity matrix, which of the following statements are always true?\n\nSelect all that apply.\n\n- **I.** $AB=BA$\n- **II.** $A(B+C)=AB+AC$\n- **III.** $B{I}_{5}={I}_{5}B$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement II is true. Matrix multiplication is distributive, so $(A+B)C=AC+BC,$ and $A(B+C)=AB+AC$ in general.\n\n- Statement III is true. Matrix multiplication is not commutative in general, however, multiplication by the identity matrix is always commutative. In this case, we have  $B{I}_{5}={I}_{5}B=B.$\n\nTherefore, only statements II and III are true."}] [{:db/id #edb/ref 17592186329644 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e232d15-a82e-5bae-ad4e-7151f902a03c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450630} {:answer/id #uuid "016d62d0-b45f-56de-ac7a-54959e9d1014" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450631}] :answer-field/correct {:answer/id #uuid "1e232d15-a82e-5bae-ad4e-7151f902a03c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref