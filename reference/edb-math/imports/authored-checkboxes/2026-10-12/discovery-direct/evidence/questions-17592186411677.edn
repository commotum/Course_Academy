#{[{:db/id #edb/ref 17592186411677 :knowledge-point/_questions [{:db/id #edb/ref 17592186203899 :knowledge-point/id #uuid "ff71f3f5-8383-5815-ba42-289f14e16b57" :knowledge-point/title "Identifying Ordered Pairs Belonging to a Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f7679f-73f5-5a0e-a03f-dee0f63f3f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411622} {:answer/id #uuid "2ddca7f1-da8d-5b3b-a8af-f028a712c9a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411629} {:answer/id #uuid "3e90ef8b-8d7b-59de-9f36-95572e6e5a15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411633} {:answer/id #uuid "47f66e07-d1c0-5f79-82e3-fcb796015fd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411636} {:answer/id #uuid "73e34a12-d804-5c4c-b0b0-abf70c77b752" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411646}] :answer-field/correct {:answer/id #uuid "08f7679f-73f5-5a0e-a03f-dee0f63f3f77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411622} :answer-field/id #uuid "2932e32f-ef14-5573-93fb-85f8c4797761" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411668}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "579647d8-78b0-511b-8a94-882ec6fc1b22" :question/math-academy-id "q-212923" :question/problem "Given the relation $R$ on $N$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x>y,\n$$\n\nwhich of the following statements are true?\n\nI. $6\\,R\\,8$\n\nII. $7\\,R\\,2$\n\nIII. $9\\,\\cancel{\\,R\\,}\\,1$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x>y.$ For this relation, note that\n\n- the symbols $R$ and $>$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $≯$ (or, equivalently, $\\cancel{\\,R\\,}$ and $\\le $) are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is false. Replacing $R$ with the symbol $>,$ we have $6>8,$ which is false.\n\n- Statement II is true. Replacing $R$ with the symbol $>,$ we have $7>2,$ which is true.\n\n- Statement III is false. Replacing $\\cancel{\\,R\\,}$ with the symbol $\\le ,$ we have $9\\le 1,$ which is false.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186411678 :knowledge-point/_questions [{:db/id #edb/ref 17592186203899 :knowledge-point/id #uuid "ff71f3f5-8383-5815-ba42-289f14e16b57" :knowledge-point/title "Identifying Ordered Pairs Belonging to a Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f17869c-0ece-5ef7-a77d-d4d3abc9fe0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411626} {:answer/id #uuid "4de08473-7aaa-5afc-bd97-107dd067e857" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411638} {:answer/id #uuid "cfb80eb9-1870-59ae-9a1d-0cda06ea7804" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186411659} {:answer/id #uuid "d24a8b3d-e9ae-577a-92d3-05c2bbc465f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411660} {:answer/id #uuid "f4fc5035-39d1-5b29-9501-8255ecdfee6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411666}] :answer-field/correct {:answer/id #uuid "f4fc5035-39d1-5b29-9501-8255ecdfee6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411666} :answer-field/id #uuid "48ac91af-23e6-5125-89c4-136992dc2060" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411670}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8c98d98-74bc-5116-9f06-75c38fdcf981" :question/math-academy-id "q-212926" :question/problem "Given the relation $R$ on $Z$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x∣y,\n$$\n\nwhich of the following statements are true?\n\nI. $6\\,R\\,3$\n\nII. $5\\,R\\,8$\n\nIII. $7\\,\\cancel{\\,R\\,}\\,9$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x∣y.$ For this relation, note that\n\n- the symbols $R$ and $∣$ are interchangeable, and\n\n- the symbols $\\cancel{\\,R\\,}$ and $∤$ are also interchangeable.\n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is false. Replacing $R$ with the symbol $∣,$ we have $6∣3,$ which is false.\n\n- Statement II is false. Replacing $R$ with the symbol $∣,$ we have $5∣8,$ which is false.\n\n- Statement III is true. Replacing $\\cancel{\\,R\\,}$ with the symbol $∤,$ we have $7∤9,$ which is true.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186411679 :knowledge-point/_questions [{:db/id #edb/ref 17592186203900 :knowledge-point/id #uuid "9d05194c-249d-54fb-91f1-f614c0f5e584" :knowledge-point/title "Identifying Ordered Pairs Belonging to a Non-Standard Relation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52d27a60-60f5-5754-a7bb-f26a821748ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411640} {:answer/id #uuid "5b8dfe07-93a1-57b4-9823-f9fcd6b4b485" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411643} {:answer/id #uuid "665cfac7-9e55-5543-a679-b699d85f4d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411644} {:answer/id #uuid "9f73524d-1b4f-5845-812e-02bb16d1c56e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411651} {:answer/id #uuid "eb20f44b-f74b-58f6-88d3-202204570fca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186411664}] :answer-field/correct {:answer/id #uuid "9f73524d-1b4f-5845-812e-02bb16d1c56e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186411651} :answer-field/id #uuid "7d5bc513-fdb3-5851-90bf-ada4837ec06e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411673}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5b2a52b-fd77-5422-b1dc-3a9ca690060e" :question/math-academy-id "q-212983" :question/problem "Given the relation $R$ on $Z$ defined by\n\n$$\nx\\,R\\,y\\,⇔\\,x≡y+4\\,(\\text{mod}\\,6),\n$$\n\nwhich of the following statements are true?\n\nI. $0\\,R\\,2$\n\nII. $1\\,R\\,9$\n\nIII. $4\\,\\cancel{\\,R\\,}\\,13$" :question/worked-solution "A relation $R$ on a set $A$ is a subset of the Cartesian product $A\\times A={A}^{2}.$\n\n$$\nR⊆A\\times A\n$$\n\nWe also have the following notations:\n\n- $x\\,R\\,y$ if and only if $(x,y)\\in R$\n\n- $x\\,\\cancel{\\,R\\,}\\,y$ if and only if $(x,y)\\notin R$\n\nIn this case, we have $x\\,R\\,y$ if and only if $x≡y+4\\,(\\text{mod}\\,6),$ or equivalently, $x\\,R\\,y$ if and only if $6∣(x-y-4).$ \n\nWith that in mind, let's examine our statements in turn:\n\n- Statement I is true. In this case, we have $6∣(0-2-4),$ which is true.\n\n- Statement II is true. In this case, we have $6∣(1-9-4),$ which is true.\n\n- Statement III is true. In this case, we have $6∤(4-13-4),$ which is true.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186411856 :knowledge-point/_questions [{:db/id #edb/ref 17592186162013 :knowledge-point/id #uuid "4c67d532-acd9-5231-a27f-d39084863e01" :knowledge-point/title "Identifying True Statements Regarding the Spectral Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bd70172-7256-5614-bf05-3767b88a1cba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186411728} {:answer/id #uuid "a1851ac1-51c2-53a9-b604-327eb8a7e44b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186411762} {:answer/id #uuid "adec6066-5ccc-5ce4-bd6d-a02f3d4d86ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186411768} {:answer/id #uuid "c0cc8f06-8966-54df-b620-04802f29078b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186411781} {:answer/id #uuid "c5343ac3-3229-5247-ba18-b96c1194c0cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411786}] :answer-field/correct {:answer/id #uuid "c5343ac3-3229-5247-ba18-b96c1194c0cf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186411786} :answer-field/id #uuid "7ab4e9c4-6a2c-5be8-9bcf-e0683aaf1263" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186411833}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "409399cd-9cd7-53bb-83f5-ffa99003572c" :question/math-academy-id "q-95407" :question/problem "Given that $A$ is a real symmetric matrix, which of the following statements are true?\n\nI. $A$ must have a complex eigenvalue\n\nII. $A$ is not diagonalizable\n\nIII. If $u$ and $v$ are two eigenvectors corresponding to different eigenvalues, then $u⊥v$" :question/worked-solution "Given that $A$ is an $n\\times n$ symmetric matrix over $R$, the spectral theorem states the following:\n\n- The eigenvalues of $A$ are all real.\n\n- Eigenvectors corresponding to different eigenvalues are orthogonal.\n\n- The dimension of the eigenspace for each eigenvalue equals the multiplicity of that eigenvalue as a root of the characteristic polynomial.\n\n- $A$ is orthogonally diagonalizable.\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is false. According to the spectral theorem, the eigenvalues are real.\n\n- Statement II is false. According to the spectral theorem, any symmetric matrix with real entries is orthogonally diagonalizable, so, $A$ is diagonalizable.\n\n- Statement III is true. Indeed, eigenvectors corresponding to different eigenvalues must be orthogonal.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186412421 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "023017fb-407e-5bef-96fe-5ca4f9043072" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412408} {:answer/id #uuid "0d7b32a8-3cec-559f-a17c-bf7b28c6fbce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412409} {:answer/id #uuid "578d705a-4c53-5798-b6ab-04cb9c9c2712" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186412412} {:answer/id #uuid "cb491f25-cc92-5958-9889-8d4238a0075e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412415} {:answer/id #uuid "de2cfeee-36d6-5198-8124-8b5f27baa495" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412416}] :answer-field/correct {:answer/id #uuid "0d7b32a8-3cec-559f-a17c-bf7b28c6fbce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412409} :answer-field/id #uuid "6af571c7-96ee-5d86-b8e5-c8021a9767c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412418}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79c14c2f-568d-5ff3-b628-6c8dd8d0639f" :question/math-academy-id "q-32169" :question/problem "Let \n$A=[\\begin{aligned}5 & -4 \\\\ 1 & 2\\end{aligned}].$\nWhich of the following statements are true?\n\n- The lines $5x-4y=0$ and $x+2y=0$ intersect at exactly one point\n- ${A}^{-1}$ does **not** exist\n- $Ax=0$ has no solution" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}5 & -4 \\\\ 1 & 2\\end{aligned}] \\\\  & =5\\cdot 2-(-4)\\cdot 1 \\\\  & =14\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement I is true by the fourth part of  the invertible matrix theorem.\n\n- Statement II is false by the first part of the invertible matrix theorem.\n\n- Statement III is false. According to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186412961 :knowledge-point/_questions [{:db/id #edb/ref 17592186152100 :knowledge-point/id #uuid "d1a842b5-7256-59cd-b33f-d590bc315d84" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a74b48c-8a09-5420-9014-3039dfa306ab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412824} {:answer/id #uuid "5b3caf48-3d6b-58e9-8443-a76f248d4f34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186412848} {:answer/id #uuid "5f50b178-baf5-50bc-b791-e2b9c9ce601d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412849} {:answer/id #uuid "7ba5e226-5ed0-5aa6-8f25-569b9054ddde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412862} {:answer/id #uuid "c31a23b5-9755-5c42-94ff-b6938dbd6b75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412899}] :answer-field/correct {:answer/id #uuid "c31a23b5-9755-5c42-94ff-b6938dbd6b75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412899} :answer-field/id #uuid "2372040f-636b-51db-a88a-0a20d411e932" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412932}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0f9012f2-83ba-5f6f-b553-2ea47d5d4f81" :question/math-academy-id "q-78640" :question/problem "Which of the following statements are true?\n\nI. There are $3$ distinct residue classes modulo $6$\n\nII. $[5]_{3}\\cap [1]_{3}\\ne ∅$\n\nIII. $Z=[3]_{2}\\cup [6]_{2}$" :question/worked-solution "Recall that the residue classes modulo $n$ have the following properties:\n\n- There are exactly $n$ distinct residue classes modulo $n$\n\n- Two distinct residue classes have an empty intersection: $[a]_{n}\\cap [b]_{n}=∅$ if $a≢b\\,(\\text{mod}\\,n)$\n\n- Residue classes modulo $n$ form a partition of the set of all integers: \n\n$$\nZ=[0]_{n}\\cup [1]_{n}\\cup ⋯\\cup [n-1]_{n}\n$$\n\n- The integers modulo $n$ is defined as the set containing all distinct residue classes modulo $n$: \n\n$$\n{Z}_{n}=\\{[0]_{n},\\,[1]_{n},\\,…,\\,[n-1]_{n}\\}\n$$\n\nWith that in mind, let's now consider each of the given statements.\n\n- Statement I is false. There are exactly $6$ distinct residue classes modulo $6.$\n\n- Statement II is false. Since $5≢1\\,(\\text{mod }3),$ we have that $[5]_{3}\\cap [1]_{3}=∅.$\n\n- Statement III is true. First, notice the following:\n\n$$\n\\begin{aligned}[3]_{2} & =[1+2\\cdot 1]_{2}=[1]_{2} \\\\ [6]_{2} & =[0+2\\cdot 3]_{2}=[0]_{2}\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}[3]_{2}\\cup [6]_{2} & =[1]_{2}\\cup [0]_{2} \\\\  & =[0]_{2}\\cup [1]_{2} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186412977 :knowledge-point/_questions [{:db/id #edb/ref 17592186152100 :knowledge-point/id #uuid "d1a842b5-7256-59cd-b33f-d590bc315d84" :knowledge-point/title "Identifying True Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406d20f8-1407-5435-8784-5f3e29ff681c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412834} {:answer/id #uuid "4a92891f-39e5-5cee-b46a-8784882f23fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412836} {:answer/id #uuid "52eadcaf-a11c-568b-907e-2ff81396dc49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412840} {:answer/id #uuid "7ecfdc45-6d9f-55e1-936c-36ea7836a224" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412864} {:answer/id #uuid "ccfb74cf-ee0e-514f-afc8-cbb35b8f9393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186412905}] :answer-field/correct {:answer/id #uuid "ccfb74cf-ee0e-514f-afc8-cbb35b8f9393" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186412905} :answer-field/id #uuid "0dd3a9af-e1c5-54e0-8441-f550817b9384" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f68491fc-7fbf-551d-bb56-21bac80c159f" :question/math-academy-id "q-78644" :question/problem "Which of the following statements are true?\n\nI. There are $11$ distinct residue classes modulo $11$\n\nII. $[7]_{5}\\cap [2]_{5}\\ne ∅$\n\nIII. $Z=[0]_{4}\\cup [9]_{4}\\cup [2]_{4}\\cup [15]_{4}$" :question/worked-solution "Recall that the residue classes modulo $n$ have the following properties:\n\n- There are exactly $n$ distinct residue classes modulo $n$\n\n- Two distinct residue classes have an empty intersection: $[a]_{n}\\cap [b]_{n}=∅$ if $a≢b\\,(\\text{mod}\\,n)$\n\n- Residue classes modulo $n$ form a partition of the set of all integers: \n\n$$\nZ=[0]_{n}\\cup [1]_{n}\\cup ⋯\\cup [n-1]_{n}\n$$\n\n- The integers modulo $n$ is defined as the set containing all distinct residue classes modulo $n$: \n\n$$\n{Z}_{n}=\\{[0]_{n},\\,[1]_{n},\\,…,\\,[n-1]_{n}\\}\n$$\n\nWith that in mind, let's now consider each of the given statements.\n\n- Statement I is true. There are $11$ distinct residue classes modulo $11.$\n\n- Statement II is true. Indeed, since $7≡2\\,(\\text{mod }5),$ we have that $[7]_{5}=[2]_{5}.$ Therefore, $[7]_{5}\\cap [2]_{5}\\ne ∅.$\n\n- Statement III is true. First, notice the following:\n\n$$\n\\begin{aligned}[9]_{4} & =[1+4\\cdot 2]_{4}=[1]_{4} \\\\ [15]_{4} & =[3+4\\cdot 3]_{4}=[3]_{4}\\end{aligned}\n$$\n\nAs a result, we get\n\n$$\n\\begin{aligned}[0]_{4}\\cup [9]_{4}\\cup [2]_{4}\\cup [15]_{4} & =[0]_{4}\\cup [1]_{4}\\cup [2]_{4}\\cup [3]_{4} \\\\  & =Z\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186412998 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4520b82c-7699-585f-98d4-b020b73654d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412982} {:answer/id #uuid "9865884d-6f2a-52d2-8326-716abac188bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186412987} {:answer/id #uuid "bb216ff2-4b67-5cf4-8b40-eae9eda5614c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412988} {:answer/id #uuid "d1e55130-8888-5317-8d53-8e631e8c4625" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412991} {:answer/id #uuid "fa4717c9-e5b3-5af6-a5a6-f49fdfc568d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412994}] :answer-field/correct {:answer/id #uuid "d1e55130-8888-5317-8d53-8e631e8c4625" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186412991} :answer-field/id #uuid "b1915239-194e-5aaa-b92c-9c8908387454" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412995}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "28941d92-3462-55d4-9376-780e240021c7" :question/math-academy-id "q-109277" :question/problem "$$\n\\begin{aligned}u\\overset{A+3I\\,}{\\to }v\\overset{A+3I\\,}{\\to }w\\overset{A+3I\\,}{\\to }0 \\\\ x\\overset{A-3I\\,}{\\to }y\\overset{A-3I\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A+3I$ and $A-3I$ on the nonzero vectors $u,v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\nI. $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A$\n\nII. $u$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A$\n\nIII. $y$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\nv\\overset{A+3I\\,}{\\to }w\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $v$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized  eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =-3$ of $A.$\n\n- Statement II is false. Since\n\n$$\nu\\overset{A+3I\\,}{\\to }v\\overset{A+3I\\,}{\\to }w\\overset{A+3I\\,}{\\to }0,\n$$\n\ni.e. $A+3I$ maps $u$ to $0$ in $3$ steps, \nthe vector $u$ is a generalized eigenvector of rank $3,$ not $2.$\n\n- Statement III is true. Indeed, since\n\n$$\ny\\overset{A-3I\\,}{\\to }0,\n$$\n\ni.e. $A-3I$ maps $y$ to $0$ in $1$ step, \nthe vector $y$ is an eigenvector corresponding to the eigenvalue $\\lambda =3$ of $A.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186413000 :knowledge-point/_questions [{:db/id #edb/ref 17592186152225 :knowledge-point/id #uuid "04926916-8e08-5401-a57b-3fd333741913" :knowledge-point/title "Identifying Generalized Eigenvectors Using Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "551aa92b-df71-5900-93f2-5ef5c2f52582" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186412983} {:answer/id #uuid "57f29804-0dce-5ac6-8836-fe816e8c4d5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186412984} {:answer/id #uuid "5a0d3c84-3d53-59fb-b4db-6527f0bb894b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186412985} {:answer/id #uuid "7b712b8f-0b0e-5fc8-bf18-7ff7f27b35bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412986} {:answer/id #uuid "ed537725-596f-59c3-9e2a-8cf97c17101c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186412993}] :answer-field/correct {:answer/id #uuid "7b712b8f-0b0e-5fc8-bf18-7ff7f27b35bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186412986} :answer-field/id #uuid "f812c18b-3e31-5102-8677-d82c1a372eb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186412997}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eddb46c6-735a-5bdf-b2a2-b57344c5441a" :question/math-academy-id "q-109434" :question/problem "$$\n\\begin{aligned}s\\overset{A-4I\\,}{\\to }u\\overset{A-4I\\,}{\\to }v\\overset{A-4I\\,}{\\to }w\\overset{A-4I\\,}{\\to }0 \\\\ x\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }y\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }0\\end{aligned}\n$$\n\nGiven the action of the matrices $A-4I$ and $A$ on the nonzero vectors $s,u,v,w,x$ and $y$ as depicted above, which of the following statements are true?\n\n- $s$ is a generalized  eigenvector of rank $4$  corresponding to the eigenvalue $\\lambda =4$ of $A$\n- $x$ is a generalized eigenvector of rank $1$ corresponding to the eigenvalue $\\lambda =0$ of $A$\n- $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =4$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. Indeed, since \n\n$$\ns\\overset{A-4I\\,}{\\to }u\\overset{A-4I\\,}{\\to }v\\overset{A-4I\\,}{\\to }w\\overset{A-4I\\,}{\\to }0,\n$$\n\ni.e. $A-4I$ maps $s$ to $0$ in $4$ steps, \nthe vector $s$ is an generalized eigenvector of rank $4$  corresponding to the eigenvalue $\\lambda =4$ of $A.$\n\n- Statement II is false. Since\n\n$$\nx\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }y\\overset{\\,\\,\\,A\\,\\,\\,\\,}{\\to }0,\n$$\n\ni.e. $A=A-0I$ maps $x$ to $0$ in $2$ steps, \nthe vector $x$ is a generalized eigenvector of rank $2,$ not $1.$\n\n- Statement III is false. Since\n\n$$\nv\\overset{A-4I\\,}{\\to }w\\overset{A-4I\\,}{\\to }0,\n$$\n\ni.e. $A-4I$ maps $v$ to $0$ in $2$ steps, \nthe vector $v$ is a generalized eigenvector of rank $2,$ not $3.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186413394 :knowledge-point/_questions [{:db/id #edb/ref 17592186166962 :knowledge-point/id #uuid "544f5154-5213-5898-a45d-4546bc8004c8" :knowledge-point/title "Understanding the Periodic Extension of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01205902-7ed5-5562-9748-9119a799b0e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413351} {:answer/id #uuid "9053ae09-1967-50b2-bec7-285800590fb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413366} {:answer/id #uuid "9a63d038-bac5-5072-83a9-d1a2575602e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413367} {:answer/id #uuid "c1c02e86-9fa1-5e41-9588-96d01350f6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186413373} {:answer/id #uuid "caa70edf-67db-5711-80d1-9a6c3409bbee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413374}] :answer-field/correct {:answer/id #uuid "c1c02e86-9fa1-5e41-9588-96d01350f6b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186413373} :answer-field/id #uuid "92e0b86f-b977-514f-9e9a-2b4ac1cbe0d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d1f9132-9d3c-569e-af11-701e82cf296a" :question/math-academy-id "q-340515" :question/problem "Let $F(x)=\\operatorname{sin}⁡(4x)$ for $x\\in R.$ Suppose $f(x)$ is the $\\frac{\\pi }{2}$-periodic extension of $F(x)$ from $x\\in [0,\\frac{\\pi }{2})$ to $x\\in R.$ Which of the following statements are true?\n\nI. $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nII. $f(x)=F(x)$ for all $x\\in R$\n\nIII. $f(x+2\\pi )=f(x)$ for all $x\\in R$" :question/worked-solution "Since $f$ is the $\\frac{\\pi }{2}$-periodic extension of $F,$ we have \n\n- $f(x+\\frac{\\pi }{2})=f(x)$ for all $x\\in R,$ and\n\n- $f(x)=F(x)$ for all $x\\in [0,\\frac{\\pi }{2}).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. This is exactly the definition of $\\frac{\\pi }{2}$-periodicity:\n\n$$\nf(x)=F(x)\n$$\n\n \nfor all $x\\in [0,\\frac{\\pi }{2}).$\n\n- Statement II is true. Notice that $F$ itself is $\\frac{\\pi }{2}$-periodic, because for any $x\\in R,$ we have\n\n$$\n\\begin{aligned}F(x+\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(4(x+\\frac{\\pi }{2})) \\\\  & =\\operatorname{sin}⁡(4x+2\\pi ) \\\\  & =\\operatorname{sin}⁡(4x) \\\\  & =F(x).\\end{aligned}\n$$\n\nSince $F$ already satisfies the periodicity rule, the $\\frac{\\pi }{2}$-periodic extension agrees with $F$ everywhere, so $f(x)=F(x)$ for all $x\\in R.$\n\n- Statement III is true. Since $f$ has period $\\frac{\\pi }{2},$\n\n$$\n\\begin{aligned}f(x+2\\pi )=f(x+4\\cdot \\frac{\\pi }{2})=f(x).\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186413395 :knowledge-point/_questions [{:db/id #edb/ref 17592186166962 :knowledge-point/id #uuid "544f5154-5213-5898-a45d-4546bc8004c8" :knowledge-point/title "Understanding the Periodic Extension of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05e1e707-efff-528a-b5df-65f3a2dfbd42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413352} {:answer/id #uuid "18a59817-6dfb-5331-b664-4eed5ae288bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413353} {:answer/id #uuid "6ebb288a-d478-5621-bc91-6939d6730dab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413359} {:answer/id #uuid "e8357363-67ee-56a4-a4ee-a6c60f170c06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413378} {:answer/id #uuid "ecf5f702-69d4-5d19-b5e6-ecc99227ab1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186413379}] :answer-field/correct {:answer/id #uuid "05e1e707-efff-528a-b5df-65f3a2dfbd42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413352} :answer-field/id #uuid "9b29a15f-c347-547f-840b-cae52a93cae3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413389}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e155a024-962b-5f82-95d5-406e9c9d0535" :question/math-academy-id "q-340506" :question/problem "Let $G(x)=x+1$ for $x\\in R.$ Suppose $g(x)$ is the $4$-periodic extension of $G(x)$ from $x\\in [0,4)$ to $x\\in R.$ Which of the following statements are true?\n\nI. $g(x+8)=g(x)$ for all $x\\in R$\n\nII. $g(x)=G(x)$ for all $x\\in R$\n\nIII. $g(x+2)=g(x)$ for all $x\\in R$" :question/worked-solution "Since $g$ is the $4$-periodic extension of $G,$ we have \n\n- $g(x+4)=g(x)$ for all $x\\in R,$ and\n\n- $g(x)=G(x)$ for all $x\\in [0,4).$\n\nWith that in mind, let's examine our statements in turn.\n\n- Statement I is true. We have\n\n$$\n\\begin{aligned}g(x+8)=g((x+4)+4)=g(x+4)=g(x)\\end{aligned}\n$$\n\nfor all $x\\in R.$\n\n- Statement II is false. For example, take $x=5.$ Then,\n\n$$\n\\begin{aligned}g(5)=g(1+4)=g(1)=G(1)=2,\\end{aligned}\n$$\n\nwhile\n\n$$\n\\begin{aligned}G(5)=5+1=6.\\end{aligned}\n$$\n\nHence, $g(x)\\ne G(x)$ for $x=5.$\n\n- Statement III is false. For example, take $x=1.$ Then, \n\n$$\n\\begin{aligned}g(1+2)=g(3)=G(3)=4\\end{aligned}\n$$\n\nwhile \n\n$$\n\\begin{aligned}g(1)=G(1)=2.\\end{aligned}\n$$\n\nHence, $g(x+2)\\ne g(x)$ for $x=1.$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186413744 :knowledge-point/_questions [{:db/id #edb/ref 17592186147427 :knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4" :knowledge-point/title "Identifying the Intersection of Two Planes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0adea858-c23c-564c-9506-9e4a60396c0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186413738} {:answer/id #uuid "22b5f065-43d8-5efe-9322-eca1974cc3d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186413739} {:answer/id #uuid "6d9614ef-645c-5eb3-83fc-f33c2f35aca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186413740} {:answer/id #uuid "6dc4adca-656f-5e68-9890-f48be898ac6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413741} {:answer/id #uuid "f5604891-08a1-55fe-b657-ffce04ef2384" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186413742}] :answer-field/correct {:answer/id #uuid "6dc4adca-656f-5e68-9890-f48be898ac6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186413741} :answer-field/id #uuid "aef76bea-df64-529b-85e7-fa51fb7e165e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186413743}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abe7bafd-4069-5c23-9e34-e0cbd57e3732" :question/math-academy-id "q-71465" :question/problem "Given the two planes $x+y+z=0$ and $x+y+1=0$, which of the following statements are true?\n\nI. The cross product of the normal vectors of the planes is equal to $⟨1,1,0⟩.$\n\nII. The planes intersect on a line.\n\nIII. The planes are coincident." :question/worked-solution "First, notice that:\n\n- For the plane $x+y+z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,1,1⟩.$\n\n- For the plane $x+y+1=0,$ a normal vector to the plane is ${n}_{2}=⟨1,1,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is false. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,1,1⟩\\times ⟨1,1,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 1 & 1 \\\\ 1 & 1 & 0\\end{aligned}\\right| \\\\  & =-i+j \\\\  & =⟨-1,1,0⟩\\ne ⟨1,1,0⟩.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel. Hence, the corresponding planes must intersect on a line.\n\n- Statement III is false. Indeed, two non-parallel planes could not be coincident either.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186414417 :knowledge-point/_questions [{:db/id #edb/ref 17592186171919 :knowledge-point/id #uuid "308a8c68-628a-522f-9545-17a7165aefdf" :knowledge-point/title "Finite Vs. Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "411917dc-6c93-55d0-978d-0767736c6121" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414263} {:answer/id #uuid "5cf6f434-9fed-5970-b8e2-d17962421f47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414269} {:answer/id #uuid "6e02cd42-42d0-5705-a005-75524f936d99" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414282} {:answer/id #uuid "ab558918-6e8c-59eb-9a7e-4397683388cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414317} {:answer/id #uuid "afae2ee4-4ec6-5251-afbc-9e17da7a7304" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414319}] :answer-field/correct {:answer/id #uuid "5cf6f434-9fed-5970-b8e2-d17962421f47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414269} :answer-field/id #uuid "b0ec5345-dc55-53da-93f5-32f3809241ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414398}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1261accc-9253-5b2b-9450-d1cf9dd3a558" :question/math-academy-id "q-181624" :question/problem "$$\nX=\\{a,b,2,4\\},\\,Y=\\{n\\in N∣\\,1\\le n<5\\}\n$$\n\nConsider the sets $X$ and $Y$ given above. Which of the following statements are true?\n\nI. $|X|=4$\n\nII. $|Y|=5$\n\nIII. $|X|=|Y|$" :question/worked-solution "Recall that finite sets have the same cardinality if and only if they have the same number of elements.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed, $X$ is a finite set and $|X|=4.$\n\n- Statement II is false. Notice that $Y=\\{1,2,3,4\\}$ is a finite set and $|Y|=4.$\n\n- Statement III is true. Indeed, $X$ and $Y$ are finite sets and  $|X|=|Y|=4.$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186414421 :knowledge-point/_questions [{:db/id #edb/ref 17592186171919 :knowledge-point/id #uuid "308a8c68-628a-522f-9545-17a7165aefdf" :knowledge-point/title "Finite Vs. Infinite Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16800456-6759-58c6-a585-7041bbe5d62e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414240} {:answer/id #uuid "a15fa94e-2fd4-55b5-8a43-b2bdf463ba84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414309} {:answer/id #uuid "b6a3cd4d-640f-57c2-a20a-46482aeaf94b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414324} {:answer/id #uuid "d96d5e4e-6751-5dec-b3c1-3719c09df64e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186414342} {:answer/id #uuid "f0b46f19-d690-587d-9747-1e56dd29c668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414359}] :answer-field/correct {:answer/id #uuid "16800456-6759-58c6-a585-7041bbe5d62e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414240} :answer-field/id #uuid "366327fe-3c8d-5196-b31e-017b57838927" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186414380}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c2743b2-72ab-5576-b421-aa5dcedd6c11" :question/math-academy-id "q-181626" :question/problem "$$\nS=\\{1,1,2,3,\\{4,5\\}\\},\\,T=\\{n\\in N∣\\,2\\le n\\le 7\\}\n$$\n\nConsider the sets $S$ and $T$ given above. Which of the following statements are true?\n\nI. $|S|=4$\n\nII. $|T|=5$\n\nIII. $|S|=|T|$" :question/worked-solution "Recall that finite sets have the same cardinality if and only if they have the same number of elements.\n\nWith that in mind, let's examine our statements.\n\n- Statement I is true. Indeed,  $S$ is a finite set and $|S|=4.$\n\n- Statement II is false. Notice that $T=\\{2,3,4,5,6,7\\}$ is a finite set and $|T|=6.$\n\n- Statement III is false. Since $4\\ne 6,$ we conclude that $|S|\\ne |T|.$\n\nTherefore, the correct answer is I only.\""}] [{:db/id #edb/ref 17592186415041 :knowledge-point/_questions [{:db/id #edb/ref 17592186152096 :knowledge-point/id #uuid "3822141e-3cea-5c34-b925-a522c2273335" :knowledge-point/title "Combining the Division Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45974aae-697e-59ea-90f3-58a3d7ab07f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414952} {:answer/id #uuid "53ad8ef2-28c6-563f-b134-1a1539671090" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414954} {:answer/id #uuid "8ef2cd18-60ec-5d72-8a48-14b406665bdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186414978} {:answer/id #uuid "9a43e1b2-3043-5dfc-9827-55b5c21ef088" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186414981} {:answer/id #uuid "f17a369e-4ccb-56ba-89f8-03b525e4cd5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186415010}] :answer-field/correct {:answer/id #uuid "53ad8ef2-28c6-563f-b134-1a1539671090" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414954} :answer-field/id #uuid "27721e63-6adb-57d0-9211-64392779ba7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415022}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00e9a03d-cb25-5bd2-bcfe-67d16e1b93d4" :question/math-academy-id "q-213297" :question/problem "Given that $5a≡5b\\,(\\text{mod}\\,15),$ which of the following statements **must** be true?\n\nI. $a≡b\\,(\\text{mod}\\,6)$\n\nII. $a≡b\\,(\\text{mod}\\,3)$\n\nIII. $4a≡4b\\,(\\text{mod}\\,12)$" :question/worked-solution "The division properties of modular arithmetic state the following:\n\n- For $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\n- For $\\text{gcd}(k,n)=1,$ we have \n\n$$\nka≡kb\\,(\\text{mod}\\,n)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWith that in mind, let's consider each statement.\n\n- Statement I is false, while statement II is true. Applying the first property, we have the following:\n\n$$\n\\begin{aligned}5a & ≡5b &  & (\\text{mod}\\,15) \\\\ 5\\cdot a & ≡5\\cdot b &  & (\\text{mod}\\,5\\cdot 3) \\\\ \\cancel{5}\\cdot a & ≡\\cancel{5}\\cdot b &  & (\\text{mod}\\,\\cancel{5}\\cdot 3) \\\\ a & ≡b &  & (\\text{mod}\\,3)\\end{aligned}\n$$\n\n- Statement III is true. By statement II and the first property, we have:\n\n$$\n\\begin{aligned}a≡b\\,(\\text{mod}\\,3)\\,⟺\\,4a≡4b\\,(\\text{mod}\\,12)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"II and III only\n.\""}] [{:db/id #edb/ref 17592186415043 :knowledge-point/_questions [{:db/id #edb/ref 17592186152094 :knowledge-point/id #uuid "bca70f6c-d087-5b8e-aff2-581adca9ed1f" :knowledge-point/title "Using the First Division Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b40d7ae-81fd-5560-a3b6-1912b4d03c01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186414944} {:answer/id #uuid "6333918e-5906-5548-8e59-11cfdafb53e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186414960} {:answer/id #uuid "b5c3b253-f21f-58e1-98dc-54b06420dd03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414992} {:answer/id #uuid "dd07f6b5-d64e-5f75-85b5-a565d52ddc05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186415003} {:answer/id #uuid "ffd323a5-6eca-50fb-aef2-a5207b006ddf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186415017}] :answer-field/correct {:answer/id #uuid "b5c3b253-f21f-58e1-98dc-54b06420dd03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186414992} :answer-field/id #uuid "ac14ead2-1a03-5fa3-95d0-5a72490e2583" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186415034}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ff193af-a6fe-56c6-94b7-27cf32c1ffe5" :question/math-academy-id "q-103191" :question/problem "Given that $6a≡6b\\,(\\text{mod}\\,9),$ which of the following statements **must** be true?\n\nI. $2a≡2b\\,(\\text{mod}\\,3)$\n\nII. $3a≡3b\\,(\\text{mod}\\,6)$\n\nIII. $a≡b\\,(\\text{mod}\\,9)$" :question/worked-solution "The division property of modular arithmetic states that for $k\\ne 0,$ we have\n\n$$\nka≡kb\\,(\\text{mod}\\,kn)\\,⟺\\,a≡b\\,(\\text{mod}\\,n).\n$$\n\nWe're asked to consider the following statement:\n\n$$\n6a≡6b\\,(\\text{mod}\\,9)\n$$\n\nNotice that $\\text{gcd}(6,9)=3.$\n\nApplying the division property, we have the following:\n\n$$\n\\begin{aligned}6a & ≡6b &  & (\\text{mod}\\,9) \\\\ 3\\cdot 2\\cdot a & ≡3\\cdot 2\\cdot b &  & (\\text{mod}\\,3\\cdot 3) \\\\ \\cancel{3}\\cdot 2\\cdot a & ≡\\cancel{3}\\cdot 2\\cdot b &  & (\\text{mod}\\,\\cancel{3}\\cdot 3) \\\\ 2a & ≡2b &  & (\\text{mod}\\,3)\\end{aligned}\n$$\n\nTherefore, the correct answer is \"I only\"."}]}
