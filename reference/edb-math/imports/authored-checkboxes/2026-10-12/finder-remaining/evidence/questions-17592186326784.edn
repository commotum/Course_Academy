#{[{:db/id #edb/ref 17592186326784 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07cecb66-e549-5c1c-ad09-78a83dd33eef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-5$ only" :db/id #edb/ref 17592186324042} {:answer/id #uuid "55df2ba0-f2c6-5604-9a35-63997cf52830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,\\,x=5" :db/id #edb/ref 17592186324686} {:answer/id #uuid "cb249387-39bb-5bca-aeb9-bb3d6e5d3f07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,x=1" :db/id #edb/ref 17592186325733} {:answer/id #uuid "e80c846d-e256-503b-bd6e-c02635e34775" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186326014} {:answer/id #uuid "f0231bbc-1648-5f25-943c-15ee288b5418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5,\\,x=-1,\\,x=1" :db/id #edb/ref 17592186326090}] :answer-field/correct {:answer/id #uuid "07cecb66-e549-5c1c-ad09-78a83dd33eef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-5$ only" :db/id #edb/ref 17592186324042} :answer-field/id #uuid "75e143c6-8b95-56da-82eb-2acad7352c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326431}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cd01e245-cc8a-5763-b4a7-8579762d92bc" :question/math-academy-id "q-39804" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{3}-3{x}^{2}+3x-1}{(x-1)(x+5{)}^{2}}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{3}-3{x}^{2}+3x-1}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{(x-1{)}^{3}}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{(x-1)(x-1{)}^{2}}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{\\cancel{(x-1)}(x-1{)}^{2}}{\\cancel{(x-1)}(x+5{)}^{2}} \\\\  & =\\frac{(x-1{)}^{2}}{(x+5{)}^{2}}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x+5{)}^{2}=0\n$$\n\nThis gives the solution $x=-5.$ Therefore, $x=-5$ is the only vertical asymptote."}] [{:db/id #edb/ref 17592186326791 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2964b3dc-2d94-539a-946c-a30b2755e2da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186324304} {:answer/id #uuid "5b6cc3a3-58f1-5d26-8673-5d478b6c9cda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186324724} {:answer/id #uuid "73ff3097-7a21-5a24-ac11-6c28413a6ab4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=1" :db/id #edb/ref 17592186324935} {:answer/id #uuid "932a43ae-c4e3-506f-b284-5316e420c58b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186325221} {:answer/id #uuid "b9e97693-64f6-596d-9b4a-111e079d80af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186325567}] :answer-field/correct {:answer/id #uuid "932a43ae-c4e3-506f-b284-5316e420c58b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186325221} :answer-field/id #uuid "76f771b5-672e-5778-ace6-2b8c22fa7988" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326435}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "720a20e0-eaeb-515c-b041-a17373ebe5f9" :question/math-academy-id "q-39931" :question/problem "Determine the vertical asymptotes of the function $f(x)=\\frac{{x}^{2}-4}{{x}^{3}+2{x}^{2}}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-4}{{x}^{3}+2{x}^{2}} \\\\  & =\\frac{(x-2)(x+2)}{{x}^{2}(x+2)} \\\\  & =\\frac{(x-2)\\cancel{(x+2)}}{{x}^{2}\\cancel{(x+2)}} \\\\  & =\\frac{x-2}{{x}^{2}}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}=0\n$$\n\nThis gives the solution $x=0.$ Therefore, $x=0$ is the only vertical asymptote."}] [{:db/id #edb/ref 17592186326792 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341cefcf-6aa7-5dd0-8741-16a1e49c1126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186324389} {:answer/id #uuid "b527320d-de25-5e52-98bb-3d68c7423f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,x=2" :db/id #edb/ref 17592186325527} {:answer/id #uuid "d38f3c2a-a49e-5897-801c-424300e7c8a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186325808} {:answer/id #uuid "d670e8d0-18bf-5af2-8bdf-5ce021e9152d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186325837} {:answer/id #uuid "f34e9c7e-81fd-5622-b802-8d9eedc6bd83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-7$ only" :db/id #edb/ref 17592186326114}] :answer-field/correct {:answer/id #uuid "341cefcf-6aa7-5dd0-8741-16a1e49c1126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186324389} :answer-field/id #uuid "08795b3d-c8a6-5731-9194-35bf6c829513" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326237}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2f92ee8b-33fa-5343-9c16-73df2f465b76" :question/math-academy-id "q-39934" :question/problem "Determine the vertical asymptotes of the function $f(x)=\\frac{{x}^{2}+3x}{{x}^{3}+2{x}^{2}+8x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+3x}{{x}^{3}+2{x}^{2}+8x} \\\\  & =\\frac{x(x+3)}{x({x}^{2}+2x+8)} \\\\  & =\\frac{\\cancel{x}(x+3)}{\\cancel{x}({x}^{2}+2x+8)} \\\\  & =\\frac{x+3}{{x}^{2}+2x+8}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+2x+8=0\n$$\n\nThis equation does not have any real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={2}^{2}-4(1)(8) \\\\  & =-28\\end{aligned}\n$$\n\nTherefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186329861 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097a0abc-e5fd-5fb9-87cc-5feb12a99af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186327011} {:answer/id #uuid "5c6bc529-d89b-5eb7-8d47-60d31ea78ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186327743} {:answer/id #uuid "b2a8878d-10ae-5348-b9a9-3a79555570b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186328484} {:answer/id #uuid "c659e8b4-0a4b-5891-b59b-eae29924cca4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ and $x=0$" :db/id #edb/ref 17592186328676} {:answer/id #uuid "e396cf90-de23-5177-aa7c-f3b3f49336bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186328929}] :answer-field/correct {:answer/id #uuid "097a0abc-e5fd-5fb9-87cc-5feb12a99af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186327011} :answer-field/id #uuid "e3e238cc-c08e-5e81-9ee9-5193fc6a3f5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "172d7de1-0c8f-50b5-8e69-09efd0164cd6" :question/math-academy-id "q-48087" :question/problem "![](images/2f/2f53373ebbb7e812471001388ba88122afbde33cd3317c454466168b3e633b58.png)\n\nWhat are the points of discontinuity of the function plotted above?" :question/worked-solution "The graph breaks at $x=-2$ and $x=2$ meaning that we can't draw the plot without taking our pencil off of the paper when passing through these points.\n\nTherefore, the correct answer is $x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186339110 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ae43d1-4fec-5e37-8920-14fdf8f6c77d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,2)$ and $(1,2)$" :db/id #edb/ref 17592186336245} {:answer/id #uuid "464aa712-2203-5c71-852e-42121f806af6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,2)$ only" :db/id #edb/ref 17592186336685} {:answer/id #uuid "6fb7b868-b5d8-579b-adf6-6962389cbae6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-2,-2)$" :db/id #edb/ref 17592186337020} {:answer/id #uuid "84b9fe17-3141-5ba4-b930-81eb79ca211c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,2)$ and $(2,1)$" :db/id #edb/ref 17592186337228} {:answer/id #uuid "971e49c0-6fdc-5a97-b4f7-0171b41fa764" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,0)$  and $(0,2)$" :db/id #edb/ref 17592186337407}] :answer-field/correct {:answer/id #uuid "6fb7b868-b5d8-579b-adf6-6962389cbae6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(2,2)$ and $(-2,-2)$" :db/id #edb/ref 17592186337020} :answer-field/id #uuid "2db519c2-9383-5593-acf5-9c05c003290b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338361}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9c0801c9-8ff6-5c1f-a200-5a0877707694" :question/math-academy-id "q-72410" :question/problem "At which points on the curve ${y}^{2}+2xy={x}^{2}+8$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{y}^{2}+2xy & ={x}^{2}+8 \\\\ {y}^{2}+2xy-{x}^{2} & =8\\end{aligned}\n$$\n\nIf we set $f(x,y)={y}^{2}+2xy-{x}^{2}$, our curve can be viewed as the level curve $f(x,y)=8.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({y}^{2}+2xy-{x}^{2})i-\\frac{∂}{∂x}({y}^{2}+2xy-{x}^{2})j \\\\  & =2(y+x)\\,i-2(y-x)\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ (2(y+x)\\,i-2(y-x)\\,j)\\cdot j & =0 \\\\ -2(y-x) & =0 \\\\ y & =x\\end{aligned}\n$$\n\nSubstituting $y=x$ into the equation of our curve gives:  \n\n$$\n\\begin{aligned}{y}^{2}+2xy-{x}^{2} & =8 \\\\ (x)^{2}+2x(x)-{x}^{2} & =8 \\\\ {x}^{2}+2{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nFinally:\n\n- If $x=2$, we get $y=2$ and the corresponding point is $(2,2).$\n\n- If $x=-2$, we get $y=-2$ and the corresponding point is $(-2,-2).$"}] [{:db/id #edb/ref 17592186339115 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0df1c7eb-8340-5ae5-bb12-5c1eac211a43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1)$ and  $(-2,4)$ only" :db/id #edb/ref 17592186336164} {:answer/id #uuid "3661bffb-2951-513d-a543-ac65bfdf1f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,4)$ and  $(-4,1)$ only" :db/id #edb/ref 17592186336537} {:answer/id #uuid "423b1542-232d-58c0-9337-ae84e6e0aa74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1)$ and  $(4,-4)$ only" :db/id #edb/ref 17592186336658} {:answer/id #uuid "a6e95c16-5a95-5943-85ba-54d73ac6ae5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,1)$ and  $(-4,4)$ only" :db/id #edb/ref 17592186337541} {:answer/id #uuid "b7fad17d-f3ef-5003-b21c-026ac1013257" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,4)$ only" :db/id #edb/ref 17592186337660}] :answer-field/correct {:answer/id #uuid "a6e95c16-5a95-5943-85ba-54d73ac6ae5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,1)$ and  $(-4,4)$ only" :db/id #edb/ref 17592186337541} :answer-field/id #uuid "61738848-0a31-5b0d-adc3-57da8b8e226b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338448}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5577e429-0d55-5dd4-b588-49ac727edd6b" :question/math-academy-id "q-72440" :question/problem "At which points on the curve ${x}^{2}+2xy=-5y+4$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+2xy & =-5y+4 \\\\ {x}^{2}+2xy+5y & =4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+2xy+5y$, our curve can be viewed as the level curve $f(x,y)=4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+2xy+5y)i-\\frac{∂}{∂x}({x}^{2}+2xy+5y)j \\\\  & =(2x+5)\\,i-(2x+2y)\\,j\\end{aligned}\n$$\n\n  \n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+5)\\,i-(2x+2y)\\,j)\\cdot j & =0 \\\\ -(2x+2y) & =0 \\\\ x & =-y\\end{aligned}\n$$\n\nSubstituting $x=-y$ into the equation of our curve gives:    \n\n$$\n\\begin{aligned}{x}^{2}+2xy+5y & =4 \\\\ (-y)^{2}+2(-y)y+5y & =4 \\\\ {y}^{2}-2{y}^{2}+5y & =4 \\\\ -{y}^{2}+5y-4 & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0 \\\\ y & =1\\,\\text{or}\\,y=4\\end{aligned}\n$$\n\nFinally:\n\n- If $y=1$, we get $x=-1$ and the corresponding point is $(-1,1).$\n\n- If $y=4$, we get $x=-4$ and the corresponding point is $(-4,4).$"}] [{:db/id #edb/ref 17592186348433 :knowledge-point/_questions [{:db/id #edb/ref 17592186087842 :knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc" :knowledge-point/title "Calculating the Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252db0d7-6b72-5535-bc72-42087bd9c168" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$ only" :db/id #edb/ref 17592186345686} {:answer/id #uuid "3c61c17f-df35-5231-8f8c-9855ef44fbff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186345862} {:answer/id #uuid "493990c6-7871-5af7-9742-efe497570105" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186345976} {:answer/id #uuid "7aebd289-0443-5cd1-8647-ef80a5d4ed52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=4" :db/id #edb/ref 17592186346424} {:answer/id #uuid "e86bd07f-57d6-5d65-989c-5c3ebae8b75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,x=0" :db/id #edb/ref 17592186347400}] :answer-field/correct {:answer/id #uuid "7aebd289-0443-5cd1-8647-ef80a5d4ed52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=4" :db/id #edb/ref 17592186346424} :answer-field/id #uuid "d0a0cf42-b725-56a9-a31d-6affed13eb8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347968}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45255a84-5494-574a-bd9f-880b4b37a48c" :question/math-academy-id "q-80669" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}+3x}{{x}^{2}-3x-4}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{x(x+3)}{(x+1)(x-4)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)(x-4) & =0\\end{aligned}\n$$\n\nThis gives the two solutions $x=-1$ and $x=4.$ Therefore, the equations of the vertical asymptotes are $x=-1$ and $x=4.$"}] [{:db/id #edb/ref 17592186348434 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31037d7d-615f-586a-8606-01f1b4558592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186345784} {:answer/id #uuid "4aeb91f0-cd53-5d4d-886c-fb0fd62c216e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,x=0" :db/id #edb/ref 17592186345993} {:answer/id #uuid "72812abe-a3ca-5de6-b805-36c4e38ad777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,x=2" :db/id #edb/ref 17592186346366} {:answer/id #uuid "9fe36be7-496a-56d8-8d43-bee44a476d95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ only" :db/id #edb/ref 17592186346750} {:answer/id #uuid "e47b15d6-db10-5d9f-9cc1-04b2bdf4db96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,\\,x=2" :db/id #edb/ref 17592186347364}] :answer-field/correct {:answer/id #uuid "31037d7d-615f-586a-8606-01f1b4558592" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186345784} :answer-field/id #uuid "4d9c99d4-e1f0-5d10-83b9-846a389a4e58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347736}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e336039-4f92-550b-b76c-a2a62662e884" :question/math-academy-id "q-80676" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{2x-1}{{x}^{3}-2{x}^{2}+4x-8}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2x-1}{{x}^{3}-2{x}^{2}+4x-8} \\\\  & =\\frac{2x-1}{{x}^{2}(x-2)+4(x-2)} \\\\  & =\\frac{2x-1}{({x}^{2}+4)(x-2)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n({x}^{2}+4)(x-2)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x-2=0$ gives the solution $x=2.$\n\n- The equation ${x}^{2}+4=0$ has no real solutions.\n\nTherefore, the only vertical asymptote is $x=2.$"}] [{:db/id #edb/ref 17592186348436 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e616195-c20c-5ce6-a774-a9d27760ce9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186345468} {:answer/id #uuid "5dbadb36-36cf-57bb-b77c-60cf2f937db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,\\,x=-2" :db/id #edb/ref 17592186346153} {:answer/id #uuid "91cba78e-fa38-55f5-8f5a-e2ea6d4d0101" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186346626} {:answer/id #uuid "a473e00b-5a25-5f34-8225-eb11ceb36777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186346779} {:answer/id #uuid "e22e0eef-d46c-5409-9e99-5a2584e7abcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186347339}] :answer-field/correct {:answer/id #uuid "91cba78e-fa38-55f5-8f5a-e2ea6d4d0101" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186346626} :answer-field/id #uuid "2918e306-8491-5fc4-93b6-c33073f50077" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347671}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dad69b3-29eb-58b2-9a73-eefa5740f30c" :question/math-academy-id "q-80691" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{x+2}{{x}^{2}+2x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x+2}{{x}^{2}+2x} \\\\  & =\\frac{x+2}{x(x+2)} \\\\  & =\\frac{\\cancel{x+2}}{x\\cancel{(x+2)}} \\\\  & =\\frac{1}{x}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\nx=0\n$$\n\nThis gives the solution $x=0.$ Therefore, $x=0$ is the only vertical asymptote."}] [{:db/id #edb/ref 17592186348437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d801c1c-70ef-575e-a8ce-0cf042036ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186345870} {:answer/id #uuid "af3b5cb8-178a-5fd6-856c-24bea81fccc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=1" :db/id #edb/ref 17592186346879} {:answer/id #uuid "c858a68d-354f-5009-8590-cab42e410104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186347095} {:answer/id #uuid "d8905902-e64e-5add-b785-c52f97aa4e79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186347258} {:answer/id #uuid "d89d09f7-625f-5ed9-981b-246d07b3adc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,\\,x=1" :db/id #edb/ref 17592186347260}] :answer-field/correct {:answer/id #uuid "3d801c1c-70ef-575e-a8ce-0cf042036ca1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186345870} :answer-field/id #uuid "0f66b65f-a57a-5bd8-9c0c-795c2010f044" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347636}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7fbfa1c-696c-569c-8a32-b9f903615eb9" :question/math-academy-id "q-80696" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{4x}{x({x}^{2}+1)}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{4x}{x({x}^{2}+1)} \\\\  & =\\frac{4\\cancel{x}}{\\cancel{x}({x}^{2}+1)} \\\\  & =\\frac{4}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186362340 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24569432-1366-5b0e-a6fa-35329602b43d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $3$ only" :db/id #edb/ref 17592186360990} {:answer/id #uuid "405ba37d-88bc-588c-be97-45c88986f4c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ only" :db/id #edb/ref 17592186361126} {:answer/id #uuid "822d6e62-ce1f-5081-8c99-18fcb72e9a13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ only" :db/id #edb/ref 17592186361416} {:answer/id #uuid "9d0b9dec-a477-56d5-8568-22939d39be14" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $-3$ only" :db/id #edb/ref 17592186361539} {:answer/id #uuid "b9c897ad-8b3e-52b7-83a5-70beda9d09d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$ only" :db/id #edb/ref 17592186361665}] :answer-field/correct {:answer/id #uuid "24569432-1366-5b0e-a6fa-35329602b43d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $3$ only" :db/id #edb/ref 17592186360990} :answer-field/id #uuid "9fe2b409-187a-57b6-9b05-5d49a74a922b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362129}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e554c090-e3bc-5a93-90b4-9f79a0997b62" :question/math-academy-id "q-9911" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$[\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}| & =1|\\begin{aligned}k & -k \\\\ k & k\\end{aligned}|-(-1)|\\begin{aligned}1 & -k \\\\ 5 & k\\end{aligned}|+k|\\begin{aligned}1 & k \\\\ 5 & k\\end{aligned}| \\\\  & =({k}^{2}+{k}^{2})+(k+5k)+k(k-5k) \\\\  & =2{k}^{2}+6k+k\\cdot (-4k) \\\\  & =2{k}^{2}+6k-4{k}^{2} \\\\  & =-2{k}^{2}+6k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}-2{k}^{2}+6k & =0 \\\\ k(-2k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=3.$"}] [{:db/id #edb/ref 17592186373757 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8afc3ae9-00f3-516a-bbcb-c44682d96676" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,1)$ and $(1,1)$" :db/id #edb/ref 17592186373759} {:answer/id #uuid "81d8dc6b-68e6-5833-9743-e2dd9a57e9e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,1)$ and $(0,0)$" :db/id #edb/ref 17592186373760} {:answer/id #uuid "894083b9-b198-57bd-991b-77b81ac6aedf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,\\frac{1}{3})$ only" :db/id #edb/ref 17592186373761} {:answer/id #uuid "a0589f58-1050-5bd6-9ac8-d8b3fa41a8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0)$ and $(0,\\frac{1}{3})$" :db/id #edb/ref 17592186373762} {:answer/id #uuid "9d22b9c8-42b9-5f43-a01d-96f9e724e330" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,1)$ only" :db/id #edb/ref 17592186373763}] :answer-field/correct {:answer/id #uuid "a0589f58-1050-5bd6-9ac8-d8b3fa41a8fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0)$ and $(0,\\frac{1}{3})$" :db/id #edb/ref 17592186373762} :answer-field/id #uuid "f40ff009-072c-5417-b244-503451b38228" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373758}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d9c5851-2645-50db-8b4e-b731824fd7d9" :question/math-academy-id "q-130225" :question/problem "At which points on the curve $2{x}^{2}-3{y}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2{x}^{2}-3{y}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-3{y}^{2}+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2}+y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2}+y)\\,j \\\\  & =(-6y+1)\\,i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((-6y+1)\\,i-4x\\,j)\\cdot j & =0 \\\\ -4x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nSubstituting $x=0$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2({0}^{2})-3{y}^{2} & =-y \\\\ 3{y}^{2}-y & =0 \\\\ y(3y-1) & =0 \\\\ y & =0,\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, the corresponding points are $(0,0)$ and $(0,\\frac{1}{3}).$"}] [{:db/id #edb/ref 17592186393514 :knowledge-point/_questions [{:db/id #edb/ref 17592186083280 :knowledge-point/id #uuid "12a5ad95-0cc9-53c5-8e1c-dae35d1c4447" :knowledge-point/title "Determining the Points Where the Normal is Horizontal or Vertical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a85035df-3f18-5f4a-8b7d-4120d3a258fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ and $t=\\frac{\\pi }{6}$" :db/id #edb/ref 17592186393516} {:answer/id #uuid "8814ca04-45d2-5482-92fe-bcab232b18b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=0$ and $t=\\frac{\\pi }{4}$" :db/id #edb/ref 17592186393517} {:answer/id #uuid "57d3f469-2ccf-551a-b2e0-ffe31d3bca63" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ only" :db/id #edb/ref 17592186393518} {:answer/id #uuid "6712e860-a397-555b-b691-57588df29d04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=0$ and $t=\\frac{\\pi }{3}$" :db/id #edb/ref 17592186393519} {:answer/id #uuid "332bdb7a-e350-5dc0-a978-64f0aa49c697" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ and $t=\\frac{\\pi }{3}$" :db/id #edb/ref 17592186393520}] :answer-field/correct {:answer/id #uuid "8814ca04-45d2-5482-92fe-bcab232b18b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=0$ and $t=\\frac{\\pi }{4}$" :db/id #edb/ref 17592186393517} :answer-field/id #uuid "76e4af98-e57b-515a-916f-95959841d208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5eafad9-4c2d-5469-bbd9-3cd0fcca968a" :question/math-academy-id "q-75278" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=2\\operatorname{cos}⁡4t-11,\\,y=3\\operatorname{sin}⁡4t+5,\\,0\\le t<\\frac{\\pi }{2}.\n$$\n\nDetermine the values of $t$ at which the normal to the curve is horizontal." :question/worked-solution "The normal is horizontal if the tangent is vertical. Therefore, we require ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n\\begin{aligned}{x}^{′}(t)=-8\\operatorname{sin}⁡4t,\\,{y}^{′}(t)=12\\operatorname{cos}⁡4t.\\end{aligned}\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n-8\\operatorname{sin}⁡4t=0\\,⟹\\,t=0,\\frac{\\pi }{4}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{y}^{′}(0) & =12\\operatorname{cos}⁡(0)=12\\ne 0, \\\\ {y}^{′}(\\frac{\\pi }{4}) & =12\\operatorname{cos}⁡(\\pi )=-12\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed horizontal when $t=0$ and $t=\\frac{\\pi }{4}.$"}] [{:db/id #edb/ref 17592186396107 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2a272db-6815-53ec-87da-5a281c0b5932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,x=0,\\,x=2" :db/id #edb/ref 17592186396109} {:answer/id #uuid "81bc4acc-cf96-53dd-9604-97c51e416cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\sqrt{2},\\,x=\\sqrt{2}" :db/id #edb/ref 17592186396110} {:answer/id #uuid "d3972294-8bb0-593a-9b73-d4e09973c691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186396111} {:answer/id #uuid "4649603f-3d59-5567-ab7b-c75a268bb6c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\sqrt{2},\\,x=0,\\,x=\\sqrt{2}" :db/id #edb/ref 17592186396112} {:answer/id #uuid "6b3a157a-5fe4-53f2-9241-98666b5d0e07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186396113}] :answer-field/correct {:answer/id #uuid "6b3a157a-5fe4-53f2-9241-98666b5d0e07" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186396113} :answer-field/id #uuid "cdc4a2be-1828-5c44-9645-c520108c6c2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396108}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2d87d550-5004-5d22-b9a3-b2335e96082d" :question/math-academy-id "q-6913" :question/problem "Find all of the vertical asymptotes of the function $f(x)=\\frac{x}{{x}^{3}+2x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x}{{x}^{3}+2x} \\\\  & =\\frac{x}{x({x}^{2}+2)} \\\\  & =\\frac{\\cancel{x}}{\\cancel{x}({x}^{2}+2)} \\\\  & =\\frac{1}{{x}^{2}+2}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+2=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ does not have any vertical asymptotes."}] [{:db/id #edb/ref 17592186396237 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48ffa317-1b68-57e4-8682-58b3f2cf3610" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ and $2$ only" :db/id #edb/ref 17592186396239} {:answer/id #uuid "43dbf530-ae59-578a-b191-6ba7d2edf47b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ only" :db/id #edb/ref 17592186396240} {:answer/id #uuid "c1c887a0-8c33-5ac9-b8f5-287ee0622dd9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ and $0$ only" :db/id #edb/ref 17592186396241} {:answer/id #uuid "0a134bc9-3211-56a8-ba64-b5d8b1f67691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $2$ only" :db/id #edb/ref 17592186396242} {:answer/id #uuid "c63b5ccb-5750-5b73-bc77-0f7d019725ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-2$ only" :db/id #edb/ref 17592186396243}] :answer-field/correct {:answer/id #uuid "0a134bc9-3211-56a8-ba64-b5d8b1f67691" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $2$ only" :db/id #edb/ref 17592186396242} :answer-field/id #uuid "0631763f-bf07-54e2-9810-4d0b16208a88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11af43ea-89bf-58ea-b458-4433226aa764" :question/math-academy-id "q-9913" :question/problem "Find the possible values of the constant $k$ given that the matrix  $[\\begin{aligned}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}k & 0 & 0 \\\\ 0 & 3 & 1 \\\\ 0 & 6 & k\\end{aligned}| & =k|\\begin{aligned}3 & 1 \\\\ 6 & k\\end{aligned}|+0|\\begin{aligned}0 & 1 \\\\ 0 & k\\end{aligned}|+0|\\begin{aligned}0 & 3 \\\\ 0 & 6\\end{aligned}| \\\\  & =k(3k-6)+0+0 \\\\  & =k(3k-6)\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0.$ So,  we have:\n\n \n\n$$\n\\begin{aligned}k(3k-6) & =0 \\\\ 3k(k-2) & =0 \\\\ k & =0,2\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=2.$"}] [{:db/id #edb/ref 17592186396578 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54ba84a1-3d25-5cd1-98bf-f731c2622e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186396580} {:answer/id #uuid "da75cf17-b00a-5ed0-97c9-6265dae86079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=2$" :db/id #edb/ref 17592186396581} {:answer/id #uuid "77df7b4b-c87e-5e29-808b-f38574caacd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ and $x=2$" :db/id #edb/ref 17592186396582} {:answer/id #uuid "8c127ea3-d160-5664-896d-8df951530b12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ and $x=1$" :db/id #edb/ref 17592186396583} {:answer/id #uuid "d02a6f82-debb-558b-a876-dc02aab50551" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186396584}] :answer-field/correct {:answer/id #uuid "da75cf17-b00a-5ed0-97c9-6265dae86079" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=2$" :db/id #edb/ref 17592186396581} :answer-field/id #uuid "53daf543-087e-50bb-928d-d5b44cae5b1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6685bf3-2db8-58de-88bd-a80799c06e2f" :question/math-academy-id "q-104025" :question/problem "![](images/2d/2d342689f9e4a213ac5407ccc132868b51ba218afabda1a871e7ca7b02345a17.png)\n\nWhat are the points of discontinuity of the function plotted above?" :question/worked-solution "The graph breaks at $x=-1$ and $x=2,$ meaning that we can't draw the plot without taking our pencil off of the paper when passing through these points.\n\nTherefore, the correct answer is $x=-1$ and $x=2.$"}]}
