/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439608}] :answer-field/correct {:answer/id #uuid "f33342a6-71e7-55a1-88ba-63522644016c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439607} :answer-field/id #uuid "02f59618-0384-53ab-a17c-8912c7664860" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440161}] :question/id #uuid "3291f5a6-141c-577f-9e01-4f06e16f89ac" :question/math-academy-id "q-27015" :question/problem "Which of the following statements are true regarding the function $y = \\cos x$? Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The function has maximum values at $x = \\frac{π}{2} + nπ$.\n- **II.** The function is zero at $x = \\frac{3π}{2}$.\n- **III.** The range of the function is $[- π, π]$." :question/worked-solution "Cosine attains its maxima at x=2n*pi, vanishes at x=3pi/2, and has range [-1,1]. Only statement II is true."}] [{:db/id #edb/ref 17592186176449 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68a428aa-620c-537b-bed4-6525636bfc6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439609} {:answer/id #uuid "a2bdaabe-318f-5a44-a993-5dc144a01cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439610}] :answer-field/correct {:answer/id #uuid "a2bdaabe-318f-5a44-a993-5dc144a01cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439610} :answer-field/id #uuid "c19eff62-0f3d-5e8b-8840-f4fa3fa30937" :answer-field/k