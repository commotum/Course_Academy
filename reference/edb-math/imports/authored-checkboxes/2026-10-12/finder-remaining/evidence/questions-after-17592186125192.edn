9ffdd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439865} :answer-field/id #uuid "50868321-e216-553a-b3ca-72efe4f524e3" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440290}] :question/id #uuid "142e660e-5b1f-5e61-a343-ee1945f69615" :question/math-academy-id "q-65208" :question/problem "At which points on the curve $9x^{2}y = 3y^{3} - 6x$ is the tangent vector to the curve perpendicular to the vector $i$?\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,-1)$\n- **II.** $(-1,1)$\n- **III.** $(0,0)$\n- **IV.** $(1,-1)$\n- **V.** $(1,1)$" :question/worked-solution "Write the curve as F(x,y)=0. A tangent is (F_y,-F_x); its dot product with the given vector is $9 x^{2} - 9 y^{2}$. Solving this with the curve equation gives $(-1,1), (0,0), (1,-1)$, and the tangent is nonzero at each point."}] [{:db/id #edb/ref 17592186129698 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e76d3042-f7ae-57ef-b396-eb6626b7976b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439667} {:answer/id #uuid "2a530406-e55f-5a02-bcae-6dda607cc6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439668}] :answer-field/correct {:answer/id #uuid "2a530406-e55f-5a02-bcae-6dda607cc6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439668} :answer-field/id #uuid "6d4c09b8-af08-5b44-aa99-0093f513761c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440191} {:answer-field/choices [{:answer/id #uuid "0c2050e7-dbe2-5d05-86f9-06cb01ed3583" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439669} {:answer/id #uuid "39f80e33-1da7-5439-9b91-357f2d0f3496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439670}] :answer-field/correct {:answer/id #uuid "39f80e33-1da7-5439-9b91-357f2d0f3496" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439670} :answer-field/id #uuid "8b11cd7d-37b5-5212-9ef6-22f0c845c9c6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440192} {:answer-field/choices [{:answer/id #uuid "abb18603-78f7-50e8-be5d-ea5aa74811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439671} {:answer/id #uuid "bdfff5d6-10ab-57f7-a5b3-5fa3c88e84c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439672}] :answer-field/correct {:answer/id #uuid "abb18603-78f7-50e8-be5d-ea5aa74811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439671} :answer-field/id #uuid "299234ca-1b77-5fea-b8e4-a49cfd0e7ccb" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440193}] :question/id #uuid "01c0cb00-762a-57c6-9d3d-dec1ec64cc03" :question/math-academy-id "q-38762" :question/problem "![](images/dc/dc2079e479351c8d0193961138aeb4dabd4689426c3e621668f314eb8445258f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $x = 2$ is a root of even multiplicity.\n- **II.** $x = ± 1$ are roots of odd multiplicity.\n- **III.** $p(0) = 2$." :question/worked-solution "At x=2 the curve touches and turns at the x-axis (even multiplicity). At x=-1 and x=1 it crosses (odd multiplicity). The y-intercept is below zero, so p(0)=2 is false."}] [{:db/id #edb/ref 17592186129699 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a81dde9d-7e4f-5cbc-8930-a85852a7afde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439673} {:answer/id #uuid "0c6f74a9-acf9-5646-99cd-d6e0ac1753f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439674}] :answer-field/correct {:answer/id #uuid "a81dde9d-7e4f-5cbc-8930-a85852a7afde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439673} :answer-field/id #uuid "0d8ef24e-31f2-5b16-95f7-e3e770bb7d8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440194} {:answer-field/choices [{:answer/id #uuid "918b0fa1-0b23-583e-a035-9d581dbf8a7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439675} {:answer/id #uuid "e7d545d0-bed3-5bd7-a2fd-c2acbbd879d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439676}] :answer-field/correct {:answer/id #uuid "e7d545d0-bed3-5bd7-a2fd-c2acbbd879d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439676} :answer-field/id #uuid "b071ece6-e900-5d85-bc7b-7f36900454c4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440195} {:answer-field/choices [{:answer/id #uuid "b43dce15-5b2f-531a-abf1-41aca7caf09e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439677} {:answer/id #uuid "c87e382c-4656-5a0a-875d-64acf4452ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439678}] :answer-field/correct {:answer/id #uuid "c87e382c-4656-5a0a-875d-64acf4452ebd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439678} :answer-field/id #uuid "bcd10ed6-e678-5883-b02e-6ab8e9a29d8b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440196}] :question/id #uuid "6659c5a9-8cd4-5728-b7f7-08c5ba5aeadd" :question/math-academy-id "q-38768" :question/problem "![](images/4b/4b91ee95f42770036434909f2bb62102120f85f464e548a0142a603164a41b32.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $x = 0$ is a root of even multiplicity.\n- **II.** $x =-1$ and $x = 2$ are roots of even multiplicity.\n- **III.** $p(x) → ∞$ as $x → ∞$." :question/worked-solution "The graph crosses at x=0 (odd multiplicity) and touches/turns at x=-1 and x=2 (even multiplicities). Its right-hand tail rises, giving p(x) tending to positive infinity."}] [{:db/id #edb/ref 17592186134061 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e37611b-b4ca-5379-847c-3a7765d404fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439393} {:answer/id #uuid "765faeb0-ed48-53f3-b1eb-c5a6f7e2135b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439394}] :answer-field/correct {:answer/id #uuid "5e37611b-b4ca-5379-847c-3a7765d404fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439393} :answer-field/id #uuid "b65cb51f-ba83-56b7-9dc2-4a765d918943" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440054} {:answer-field/choices [{:answer/id #uuid "394b0c92-413b-5182-bf86-908b31bea2d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439395} {:answer/id #uuid "a5a2bf22-912d-55ed-9446-5abda1fe8202" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439396}] :answer-field/correct {:answer/id #uuid "394b0c92-413b-5182-bf86-908b31bea2d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439395} :answer-field/id #uuid "a7014164-d3a8-54e0-b2b2-69b7a546b3ee" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440055} {:answer-field/choices [{:answer/id #uuid "3d66ca4c-dc58-584c-976f-6c65dcb0374b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439397} {:answer/id #uuid "2b1a3581-91b7-51be-a39a-394d06c35627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439398}] :answer-field/correct {:answer/id #uuid "2b1a3581-91b7-51be-a39a-394d06c35627" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439398} :answer-field/id #uuid "3c3322fa-b621-5555-b3ed-1f86ce1470ea" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440056} {:answer-field/choices [{:answer/id #uuid "1c747585-3d2c-5bc7-bfaa-a6485611b22f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439399} {:answer/id #uuid "36fe6723-4807-59df-ae7e-c3f3add34f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439400}] :answer-field/correct {:answer/id #uuid "1c747585-3d2c-5bc7-bfaa-a6485611b22f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439399} :answer-field/id #uuid "56a24dae-9028-5f6f-bfb1-b8f7462e6a64" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440057}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d82a128a-970f-55e8-b4ad-4c3c16a14935" :question/math-academy-id "q-105075" :question/problem "![](images/34/3411e11060b06a11c82ad677f50731faa31c6bc2e83ccb0d0d10931cf3d76592.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $∇\\cdot F>0$ at $P,$ then $F$ acts like a source at $P.$\n\n- If $∇\\cdot F<0$ at $P,$ then $F$ acts like a sink at $P.$\n\n- If $∇\\cdot F=0$ at $P,$ then $F$ acts like neither a source nor a sink at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement III is true, whereas statements I and II are false. Notice that the lengths of the vectors decrease as we move in the $y$-direction. Therefore, the vector field $F$ acts like a sink at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186134063 :knowledge-point/_questions [{:db/id #edb/ref 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba17fd4c-8a29-5e53-98c2-ac71e936d451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439401} {:answer/id #uuid "829d51be-bbb4-5302-8892-638706b87aa5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439402}] :answer-field/correct {:answer/id #uuid "ba17fd4c-8a29-5e53-98c2-ac71e936d451" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439401} :answer-field/id #uuid "c0a7c437-986c-533d-b681-b536d1087ea4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440058} {:answer-field/choices [{:answer/id #uuid "b7f91ce5-8027-5662-bf7f-89461f30876f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439403} {:answer/id #uuid "74982af7-ea24-566e-a318-31d4afed4a7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439404}] :answer-field/correct {:answer/id #uuid "74982af7-ea24-566e-a318-31d4afed4a7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439404} :answer-field/id #uuid "95428b1e-403f-5e89-9282-91389dc3cc7d" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440059} {:answer-field/choices [{:answer/id #uuid "bf4cd6a1-3348-5907-a8f5-a077070f5905" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439405} {:answer/id #uuid "7cc39078-e01a-5ae3-8435-7c5e5de22beb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439406}] :answer-field/correct {:answer/id #uuid "7cc39078-e01a-5ae3-8435-7c5e5de22beb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439406} :answer-field/id #uuid "20819904-04f5-57af-aaf8-c983f5553a47" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440060} {:answer-field/choices [{:answer/id #uuid "b28c8347-5141-5361-802d-14904582c104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439407} {:answer/id #uuid "f4e427c3-d890-5a06-a66c-a11cc7473766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439408}] :answer-field/correct {:answer/id #uuid "b28c8347-5141-5361-802d-14904582c104" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439407} :answer-field/id #uuid "5c295151-fc81-5e26-83a2-0c544bc56dcc" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440061}] :question/id #uuid "4556fe88-939e-5892-9221-116e661c0c0b" :question/math-academy-id "q-105103" :question/problem "![](images/04/04c6eb44298b639520994f01ef505ff40eba58307a1a40e7a48dfb0ebaae5d7e.png)\n\nConsider the vector field $F(x, y, z)$, shown above. Given that $F(x, y, z)$ is independent of $z$, which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $curlF = 0$\n- **II.** $curlF \\ne 0$\n- **III.** $curlF$ points in the negative $z$-direction.\n- **IV.** $F$ is irrotational" :question/worked-solution "The vector field rotates clockwise with increasing magnitude away from the origin. Its curl is nonzero and points in the negative z-direction; it is not irrotational."}] [{:db/id #edb/ref 17592186134067 :knowledge-point/_questions [{:db/id #edb/ref 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3f7214e-b431-56d7-bfb7-264d923304a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439409} {:answer/id #uuid "28aa7527-fdde-5107-909c-8eac04e3521c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439410}] :answer-field/correct {:answer/id #uuid "28aa7527-fdde-5107-909c-8eac04e3521c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439410} :answer-field/id #uuid "8de723b7-940f-5a5a-8f71-5147966d54e1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440062} {:answer-field/choices [{:answer/id #uuid "41a3396c-f648-59d7-86ad-e5a8c9e73b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439411} {:answer/id #uuid "1c6b0ab8-5bb8-53b1-a594-3981e92e91d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439412}] :answer-field/correct {:answer/id #uuid "41a3396c-f648-59d7-86ad-e5a8c9e73b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439411} :answer-field/id #uuid "475fb5dd-c494-5648-876b-68b1e41539f1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440063} {:answer-field/choices [{:answer/id #uuid "f50e153b-42df-5358-9d5f-1feae4851881" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439413} {:answer/id #uuid "92c437ec-54a4-5c1c-9163-4b0d41cb2832" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439414}] :answer-field/correct {:answer/id #uuid "f50e153b-42df-5358-9d5f-1feae4851881" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439413} :answer-field/id #uuid "36c6f469-c87b-5afd-80e2-4ce904844a8c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440064} {:answer-field/choices [{:answer/id #uuid "6abbcd53-7265-58cb-bea9-68b80e7a66ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439415} {:answer/id #uuid "343af783-682f-5a27-8c10-4cc12c878c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439416}] :answer-field/correct {:answer/id #uuid "343af783-682f-5a27-8c10-4cc12c878c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439416} :answer-field/id #uuid "ca9d0ac4-aaa2-5c2b-8f03-ae41d78b45eb" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440065}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0a7d3d7-12b8-5fcb-bcca-49538501dfd6" :question/math-academy-id "q-105571" :question/problem "![](images/86/864ce19530f022e52b7c9513c0cebc64e898f6e71ecf1066ab6aad92d6df40bf.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\nSelect all that apply.\n\n- **I.** $\\text{div}\\,F=0$\n- **II.** $\\text{div}\\,F>0$\n- **III.** $\\text{div}\\,F<0$\n- **IV.** $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id #edb/ref 17592186134092 :knowledge-point/_questions [{:db/id #edb/ref 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe357184-c804-53e5-9673-6bcefc79fd9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439453} {:answer/id #uuid "0918b264-4f40-5876-987b-5c8750a26cc4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439454}] :answer-field/correct {:answer/id #uuid "fe357184-c804-53e5-9673-6bcefc79fd9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439453} :answer-field/id #uuid "a3372797-44ff-5f24-b147-8ec1e085072b" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440084} {:answer-field/choices [{:answer/id #uuid "0842fe57-c4b3-512a-a06a-8b846341aac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439455} {:answer/id #uuid "586a0c72-4a76-59c2-8374-26e889f264c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439456}] :answer-field/correct {:answer/id #uuid "0842fe57-c4b3-512a-a06a-8b846341aac0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439455} :answer-field/id #uuid "d69bbf46-abac-5660-b279-f3c0fe70f969" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440085} {:answer-field/choices [{:answer/id #uuid "85cdaefa-89de-57a1-b19f-0c380903a4f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439457} {:answer/id #uuid "0d933456-9721-5edd-b8fc-3dc9d94ba641" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439458}] :answer-field/correct {:answer/id #uuid "0d933456-9721-5edd-b8fc-3dc9d94ba641" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439458} :answer-field/id #uuid "ac6e472f-13b9-5a6e-8237-3f44c55c1cc5" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440086}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d72f3f4-6ff1-53f9-94a6-72b405d3f343" :question/math-academy-id "q-125852" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\nSelect all that apply.\n\n- **I.** $P(x,y)=y$ and $Q(x,y)=-x$\n- **II.** $P(x,y)=\\frac{x}{2}+\\operatorname{cos}⁡{y}^{2}$ and $Q(x,y)=\\frac{y}{2}$\n- **III.** $P(x,y)=0$ and $Q(x,y)=x$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=-1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-2\\ne 1.\n$$\n\n- Pair II does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-2y\\operatorname{sin}⁡{y}^{2}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2y\\operatorname{sin}⁡{y}^{2}\\ne 1.\n$$\n\n- Pair III gives the required area. Notice that\n$\\frac{∂P}{∂y}=0$\nand\n$\\frac{∂Q}{∂x}=1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186134093 :knowledge-point/_questions [{:db/id #edb/ref 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2b8c17c-21b8-507b-8420-d670c4b65f9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439459} {:answer/id #uuid "17e98f8a-da18-55f0-8939-1564456b888b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439460}] :answer-field/correct {:answer/id #uuid "a2b8c17c-21b8-507b-8420-d670c4b65f9c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439459} :answer-field/id #uuid "182f9891-f2da-5a34-881d-2dc0e9bd1216" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440087} {:answer-field/choices [{:answer/id #uuid "aff01827-2164-503c-885f-729ce07f69b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439461} {:answer/id #uuid "41f3acaf-c391-5b28-bea3-53dc115237b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439462}] :answer-field/correct {:answer/id #uuid "41f3acaf-c391-5b28-bea3-53dc115237b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439462} :answer-field/id #uuid "c6bbea9d-55dc-56d4-af3c-6bb5a3355e6e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440088} {:answer-field/choices [{:answer/id #uuid "c35b0a14-7ff3-5770-b606-c1b4ba2b788d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439463} {:answer/id #uuid "c0470289-cbe4-59c9-abaf-f84a85ae4c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439464}] :answer-field/correct {:answer/id #uuid "c0470289-cbe4-59c9-abaf-f84a85ae4c3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439464} :answer-field/id #uuid "f690e279-0ebb-573a-bc24-60532b449e8c" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0916e138-1ac3-5dc1-b5d3-86d819d37c90" :question/math-academy-id "q-125853" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}F\\cdot \\text{d}r\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the vector field $F(x,y)?$\n\nSelect all that apply.\n\n- **I.** $F(x,y)=⟨-y,\\,{x}^{2}+x⟩$\n- **II.** $F(x,y)=⟨-\\frac{y}{4}+x,\\,\\frac{3x}{4}⟩$\n- **III.** $F(x,y)=⟨-y,\\,0⟩$" :question/worked-solution "According to Green's theorem, if $F(x,y)=⟨P(x,y),\\,Q(x,y)⟩,$ where\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y \\\\  & ={∮}_{C}F\\cdot \\text{d}r\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Vector field I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=2x+1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2x+2\\ne 1.\n$$\n\n- Vector field II gives the required area. Notice that\n$\\frac{∂P}{∂y}=-\\frac{1}{4}$\nand\n$\\frac{∂Q}{∂x}=\\frac{3}{4},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Vector field III gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186172639 :knowledge-point/_questions [{:db/id #edb/ref 17592186172041 :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da12ce2e-948a-5da1-b6c4-ad3cf04c71f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440005} {:answer/id #uuid "2f3ad942-a0cf-5a11-addd-9344559df32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440006}] :answer-field/correct {:answer/id #uuid "2f3ad942-a0cf-5a11-addd-9344559df32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440006} :answer-field/id #uuid "efceae93-0e9a-5328-a673-594e38c76d62" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440360} {:answer-field/choices [{:answer/id #uuid "565446c4-7f3f-5d73-9316-39b5cad28fac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440007} {:answer/id #uuid "9973734a-4ca1-5ea9-b1e8-ac4cb9640a9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440008}] :answer-field/correct {:answer/id #uuid "565446c4-7f3f-5d73-9316-39b5cad28fac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440007} :answer-field/id #uuid "d58bf482-6466-584a-bdea-38251341fcdb" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440361} {:answer-field/choices [{:answer/id #uuid "08dd43ae-dafe-50fa-a506-9626463b04ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440009} {:answer/id #uuid "f1dd840c-1ae3-5613-8645-575ecdd71746" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440010}] :answer-field/correct {:answer/id #uuid "08dd43ae-dafe-50fa-a506-9626463b04ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440009} :answer-field/id #uuid "c6a8eb7e-030d-57b8-89a2-4a3b521b0192" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440362}] :question/id #uuid "4026efcc-47dd-5838-ae2e-6298d2d740c1" :question/math-academy-id "q-96475" :question/problem "Consider the differential equation $\\frac{dy}{dx} = (x - 1)(y + 2)$ and its slope field. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** At every point $(x, y)$ where $x > 1$ and $y > - 2$, the slope of the slope field is positive\n- **II.** At every point $(x, y)$ where $x < 1$ and $y > - 2$, the slope of the slope field is positive\n- **III.** At every point $(x, y)$ where $x > 1$ and $y < - 2$, the slope of the slope field is positive" :question/worked-solution "For (x-1)(y+2), both factors are positive in region I. In regions II and III one factor is negative and one positive. Only statement I is true."}] [{:db/id #edb/ref 17592186172648 :knowledge-point/_questions [{:db/id #edb/ref 17592186172039 :knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3c0e91a-8719-5dbf-92fb-86a7721ef654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440023} {:answer/id #uuid "55bf2da5-d708-5480-8ab8-1441064688e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440024}] :answer-field/correct {:answer/id #uuid "a3c0e91a-8719-5dbf-92fb-86a7721ef654" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440023} :answer-field/id #uuid "402941ab-b608-5343-ad5f-8ac1f83f99c2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440369} {:answer-field/choices [{:answer/id #uuid "e82d40ad-c41b-57a8-a872-ff25ef67196e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440025} {:answer/id #uuid "fa689d24-4924-55c6-8219-2928fe0f7962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440026}] :answer-field/correct {:answer/id #uuid "fa689d24-4924-55c6-8219-2928fe0f7962" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440026} :answer-field/id #uuid "097f13ad-dd16-5c08-84cd-9bb354ae065e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440370} {:answer-field/choices [{:answer/id #uuid "934c3087-576f-525a-b55f-b5b5ad9f17fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440027} {:answer/id #uuid "926d422e-445c-57ec-9858-ba3785eafd46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440028}] :answer-field/correct {:answer/id #uuid "926d422e-445c-57ec-9858-ba3785eafd46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440028} :answer-field/id #uuid "f873dbf2-94f8-5412-b40f-fa9306104dc1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440371}] :question/id #uuid "1142a38e-b72d-5615-beec-20a68972aab2" :question/math-academy-id "q-97483" :question/problem "Consider the differential equation $\\frac{dy}{dx} = xy^{2}$ and its slope field. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** At every point in the first quadrant, the slope of the slope field is negative\n- **II.** At every point in the second quadrant, the slope of the slope field is negative\n- **III.** At every point in the third quadrant, the slope of the slope field is negative" :question/worked-solution "For xy^2, y^2 is positive in every open quadrant, so the slope has the sign of x. It is negative in quadrants II and III, and positive in quadrant I."}] [{:db/id #edb/ref 17592186176448 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "D