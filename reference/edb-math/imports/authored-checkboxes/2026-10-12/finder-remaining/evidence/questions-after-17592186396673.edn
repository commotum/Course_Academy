03-c376-5e53-9dfd-0cfa311921d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439750}] :answer-field/correct {:answer/id #uuid "b282cc6e-6169-5ed9-a853-fb5f4099d1b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439749} :answer-field/id #uuid "c72a2f69-f2cb-53c3-ba4e-785cc447b97f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440232} {:answer-field/choices [{:answer/id #uuid "d697ca92-f93c-5a09-a8a7-f68d5a89e7a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439751} {:answer/id #uuid "de2f7cfa-4da2-5415-a70d-d30b77950777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439752}] :answer-field/correct {:answer/id #uuid "d697ca92-f93c-5a09-a8a7-f68d5a89e7a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439751} :answer-field/id #uuid "ec77f5ec-84e5-5013-a57b-41a9e6b810af" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440233} {:answer-field/choices [{:answer/id #uuid "fbe97263-3047-5bd8-9894-ead82588f849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439753} {:answer/id #uuid "944b4a1e-c5b6-522f-a703-be8b22db86b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439754}] :answer-field/correct {:answer/id #uuid "fbe97263-3047-5bd8-9894-ead82588f849" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439753} :answer-field/id #uuid "9289e91e-6f0c-5a94-b1b0-b92d76ca8929" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440234}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "10e486fb-a153-567a-b122-83eab72817c1" :question/math-academy-id "q-39936" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-1}{{x}^{4}-1}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=- \\frac{1}{2}$\n- **III.** $x=0$\n- **IV.** $x=\\frac{1}{2}$\n- **V.** $x=1$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{{x}^{4}-1} \\\\  & =\\frac{{x}^{2}-1}{({x}^{2}-1)({x}^{2}+1)} \\\\  & =\\frac{(x-1)(x+1)}{(x-1)(x+1)({x}^{2}+1)} \\\\  & =\\frac{\\cancel{(x-1)(x+1)}}{\\cancel{(x-1)(x+1)}({x}^{2}+1)} \\\\  & =\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186403475 :knowledge-point/_questions [{:db/id #edb/ref 17592186124445 :knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340" :knowledge-point/title "Finding the Points Where a Gradient Vanishes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b0c95e4-c6e9-54b6-a15d-ea7087127b5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439909} {:answer/id #uuid "a2e5d812-4735-5fc8-b852-eeaeeaafc9cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answ