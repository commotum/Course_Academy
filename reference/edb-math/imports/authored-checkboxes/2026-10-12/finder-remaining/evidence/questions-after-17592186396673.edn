08166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440314} {:answer-field/choices [{:answer/id #uuid "4cfb6205-7f60-523e-9e19-0a6c99cb1be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439915} {:answer/id #uuid "1132f5d8-3334-5ba6-860f-3020fef135aa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439916}] :answer-field/correct {:answer/id #uuid "4cfb6205-7f60-523e-9e19-0a6c99cb1be6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439915} :answer-field/id #uuid "47cda995-fd9f-589a-85d9-cfbd97013861" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440315} {:answer-field/choices [{:answer/id #uuid "405c5964-ed58-56db-a7d0-221666926760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439917} {:answer/id #uuid "7990ef8e-46b5-5559-a2c5-aa8d65421d92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439918}] :answer-field/correct {:answer/id #uuid "405c5964-ed58-56db-a7d0-221666926760" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439917} :answer-field/id #uuid "84892d33-55b9-54ef-a343-3de68b52e47d" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440316} {:answer-field/choices [{:answer/id #uuid "d182b83a-f3d7-59a8-a2df-a282497de34c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439919} {:answer/id #uuid "767b3c80-fc75-58d7-a96d-c20b801d7033" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439920}] :answer-field/correct {:answer/id #uuid "d182b83a-f3d7-59a8-a2df-a282497de34c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439919} :answer-field/id #uuid "71df9b88-565a-50cb-b76e-a7999233dce6" :answer-field/key "VI" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440317}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c503ae86-f71f-5a21-9c90-e19ce4d410a1" :question/math-academy-id "q-71474" :question/problem "Given that $f(x,y,z)=\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z$, find the points $(x,y,z)$ where $∇f(x,y,z)=0.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,-1,-1)$\n- **II.** $(-1,-1,1)$\n- **III.** $(-1,1,-1)$\n- **IV.** $(-1,1,1)$\n- **V.** $(1,-1,-1)$\n- **VI.** $(1,1,1)$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{{x}^{2}y}+0-\\frac{1}{z{x}^{2}}-0 \\\\  & =-\\frac{z+y}{{x}^{2}yz} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{x{y}^{2}}-\\frac{1}{{y}^{2}}+0-0 \\\\  & =-\\frac{1+x}{x{y}^{2}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =0+0-\\frac{1}{{z}^{2}x}-1 \\\\  & =-\\frac{1+{z}^{2}x}{{z}^{2}x}\\end{aligned}\n$$\n\nHence, $∇f(x,y,z)=-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k.$ \n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }k\\end{aligned}\n$$\n\nSo, by equating the coefficient of $i$, $j$, and $k$, we obtain:\n\n$$\n\\begin{cases}-\\frac{z+y}{{x}^{2}yz}=0 \\\\ -\\frac{1+x}{x{y}^{2}}=0 \\\\ -\\frac{1+{z}^{2}x}{{z}^{2}x}=0\\end{cases}\n$$\n\nFrom the second equation, we get $x=-1.$ Substituting these into the third equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{1+{z}^{2}x}{{z}^{2}x} & =0 \\\\ -\\frac{1+{z}^{2}(-1)}{{z}^{2}(-1)} & =0 \\\\ 1-{z}^{2} & =0 \\\\ {z}^{2} & =1 \\\\ z & =\\pm 1\\end{aligned}\n$$\n\nSubstituting $x=-1$ into the first equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{z+y}{(-1)^{2}yz} & =0 \\\\ z+y & =0 \\\\ y & =-z\\end{aligned}\n$$\n\nWhen $z=1,$ we have $y=-1$ and when $z=-1,$ we have $y=1.$\n\nHence, $∇f(x,y,z)=0$ at two points: $(-1,-1,1)$ and $(-1,1,-1).$"}] [{:db/id #edb/ref 17592186410576 :knowledge-point/_questions [{:db/id #edb/ref 17592186166863 :knowledge-point/id #uuid "65adbd80-9647-59d8-bd4a-42f431587c85" :knowledge-point/title "Identifying Conservative Vector Fields"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "519cca11-1af0-5c38-ac09-9cdf3e9eb8d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439999} {:answer/id #uuid "6fbea3d5-d3a9-50cd-881a-7348e37c0dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440000}] :answer-field/correct {:answer/id #uuid "6fbea3d5-d3a9-50cd-881a-7348e37c0dbe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440000} :answer-field/id #uuid "b3485904-6c14-5182-a07e-0e8536e160b9" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440357} {:answer-field/choices [{:answer/id #uuid "cb20b90e-716b-5744-aa1c-1bc38cc09c94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440001} {:answer/id #uuid "9e61d8e1-2d98-58e5-918c-f2fb0a227922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440002}] :answer-field/correct {:answer/id #uuid "9e61d8e1-2d98-58e5-918c-f2fb0a227922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440002} :answer-field/id #uuid "908db421-59c3-5473-9555-1804770c666a" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440358} {:answer-field/choices [{:answer/id #uuid "99e2896f-89e3-56ed-85e3-9569e0e553b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440003} {:answer/id #uuid "0b03afd1-5458-5b8f-80bb-6721de8fe5c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440004}] :answer-field/correct {:answer/id #uuid "0b03afd1-5458-5b8f-80bb-6721de8fe5c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440004} :answer-field/id #uuid "12bd3f31-bc54-5cfa-8930-506cacf26495" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440359}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "953d7cc2-ab7b-52e3-b63e-6dc18089f06f" :question/math-academy-id "q-86896" :question/problem "Which of the following vector fields are conservative on ${R}^{2}?$\n\nSelect all that apply.\n\n- **I.** $F=({e}^{x+y}-\\sqrt{2})\\,i+({e}^{x+y}-\\sqrt{7})\\,j$\n- **II.** $G=({y}^{3}-6x)\\,i+(3x{y}^{2})\\,j$\n- **III.** $H=\\frac{2xy}{{x}^{2}+1}\\,i+\\operatorname{ln}⁡({x}^{2}+1)\\,j$" :question/worked-solution "Let $F(x,y)=P(x,y)\\,i+Q(x,y)\\,j$ be a vector field with domain $D={R}^{2},$ where $P$ and $Q$ have continuous first-order partial derivatives everywhere on $D.$ Then, we have the following theorem:\n\n$F$ *is conservative if and only if $\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}$ everywhere on $D.$*\n\nNote that for each of our functions, $D={R}^{2}.$ With this in mind, let's check each of the vector fields. \n\n- For the vector field $F,$ we have $P={e}^{x+y}-\\sqrt{2}$ and $Q={e}^{x+y}-\\sqrt{7}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}={e}^{x+y},\\,\\frac{∂Q}{∂x}={e}^{x+y}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $F$ is conservative on ${R}^{2}.$\n\n- For the vector field $G,$ we have $P={y}^{3}-6x$ and $Q=3x{y}^{2}.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=3{y}^{2},\\,\\frac{∂Q}{∂x}=3{y}^{2}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $G$ is conservative on ${R}^{2}.$\n\n- For the vector field $H,$ we have $P=\\frac{2xy}{{x}^{2}+1}$ and $Q=\\operatorname{ln}⁡({x}^{2}+1).$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=\\frac{2x}{{x}^{2}+1},\\,\\frac{∂Q}{∂x}=\\frac{2x}{{x}^{2}+1}.\\end{aligned}\n$$\n\nSince the partial derivatives are continuous and equal everywhere on ${R}^{2},$ we conclude that $H$ is conservative on ${R}^{2}.$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186437021 :knowledge-point/_questions [{:db/id #edb/ref 17592186124445 :knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340" :knowledge-point/title "Finding the Points Where a Gradient Vanishes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5c93cec-cb82-55b3-b6d7-62d69fb76aee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439901} {:answer/id #uuid "2c99ad9c-faf3-5acd-bdb2-ee27ef1f4fdd" :answer/type {:db/id #edb