es [{:answer/id #uuid "cdfb4c1c-a7e3-528c-ad38-0a25fa0c06e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439473} {:answer/id #uuid "c1e62795-ea37-5a2c-a40d-79165b1c9fc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439474}] :answer-field/correct {:answer/id #uuid "c1e62795-ea37-5a2c-a40d-79165b1c9fc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439474} :answer-field/id #uuid "1a16e752-a6da-51f5-a176-d4c86eab7b66" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440094} {:answer-field/choices [{:answer/id #uuid "9817eb20-9e99-5e90-bece-d6fd670b6f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439475} {:answer/id #uuid "49451522-b542-50df-a0e5-8b97f2634208" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439476}] :answer-field/correct {:answer/id #uuid "9817eb20-9e99-5e90-bece-d6fd670b6f03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439475} :answer-field/id #uuid "a7148c9c-1bda-595b-a2c5-e6841ac127f2" :answer-field/key "VI" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440095}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41e53fe4-b06e-5150-a976-5badf29f5d4c" :question/math-academy-id "q-128461" :question/problem "Find $k$ given that the vectors $a=⟨{k}^{2},7,4⟩,$ $b=⟨6,7,4⟩,$ and $c=⟨3,0,2⟩$ are coplanar.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $k=-6$\n- **II.** $k=- \\sqrt{6}$\n- **III.** $k=- \\sqrt{3}$\n- **IV.** $k=\\sqrt{3}$\n- **V.** $k=\\sqrt{6}$\n- **VI.** $k=6$" :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}{k}^{2} & 7 & 4 \\\\ 6 & 7 & 4 \\\\ 3 & 0 & 2\\end{aligned}| \\\\  & ={k}^{2}\\cdot |\\begin{aligned}7 & 4 \\\\ 0 & 2\\end{aligned}|-7\\cdot |\\begin{aligned}6 & 4 \\\\ 3 & 2\\end{aligned}|+4\\cdot |\\begin{aligned}6 & 7 \\\\ 3 & 0\\end{aligned}| \\\\  & ={k}^{2}(7\\cdot 2-0\\cdot 4)-7(6\\cdot 2-3\\cdot 4)+4(6\\cdot 0-3\\cdot 7) \\\\  & =14{k}^{2}+0-84 \\\\  & =14{k}^{2}-84 \\\\  & =14({k}^{2}-6).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =0 \\\\ 14({k}^{2}-6) & =0 \\\\ {k}^{2}-6 & =0 \\\\ {k}^{2} & =6 \\\\ k & =\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $k=-\\sqrt{6}$ or $k=\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186400366 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3601e09a-9335-5956-9835-0fbca8ffb502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439483} {:answer/id #uuid "3db08d97-0845-5f7c-ab43-56777bea1d91" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439484}] :answer-field/correct {:answer/id #uuid "3601e09a-9335-5956-9835-0fbca8ffb502" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439483} :answer-field/id #uuid "36f65856-78a1-51a9-a1da-71cda1e674f1" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-fiel