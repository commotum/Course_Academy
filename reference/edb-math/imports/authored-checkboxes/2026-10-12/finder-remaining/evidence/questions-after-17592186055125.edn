86439594}] :answer-field/correct {:answer/id #uuid "af5e1140-7285-5947-a5ac-b5f310180d37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439593} :answer-field/id #uuid "a1927fe8-050f-52b1-82d1-a1c861c978ee" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440154} {:answer-field/choices [{:answer/id #uuid "9b80889c-720b-597f-a90e-eb73416db671" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439595} {:answer/id #uuid "918a434e-157b-5abc-b419-459e4df7763a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439596}] :answer-field/correct {:answer/id #uuid "918a434e-157b-5abc-b419-459e4df7763a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439596} :answer-field/id #uuid "1bb46a2e-4942-58e0-82e0-10cc738e4275" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440155}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbd878d8-e318-5109-beb9-89ecefca7f9d" :question/math-academy-id "q-21081" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4\\operatorname{sin}⁡t+7,\\,y=4\\operatorname{cos}⁡t+10,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $t=\\frac{\\pi}{4}$\n- **II.** $t=\\frac{\\pi}{2}$\n- **III.** $t=\\frac{3 \\pi}{4}$\n- **IV.** $t=\\frac{3 \\pi}{2}$" :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=-4\\operatorname{sin}⁡t.\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n4\\operatorname{cos}⁡t=0\\,⟹\\,t=\\frac{\\pi }{2},\\frac{3\\pi }{2}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =-4\\ne 0, \\\\ {y}^{′}(\\frac{3\\pi }{2}) & =4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the tangent to the curve is indeed vertical when $t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}.$"}] [{:db/id #edb/ref 17592186088163 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bfc0ecd-2ae1-58ad-92ad-f8dc340ec234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439679} {:answer/id #uuid "78df0e11-bb79-50f4-b7b2-a536fc805fb6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439680}] :answer-field/correct {:answer/id #uuid "6bfc0ecd-2ae1-58ad-92ad-f8dc340ec234" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439679} :answer-field/id #uuid "3d4e0513-ea9c-59df-a7e3-292289436aa8" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440197} {:answer-field/choices [{:answer/id #uuid "dfcf1899-49a8-576c-b611-ec99a491a00d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439681} {:answer/id #uuid "072af8a1-f4d0-5eca-80b9-d6959a3ff056" :answer/type {:db/id #edb/ref 17592186045499 :db