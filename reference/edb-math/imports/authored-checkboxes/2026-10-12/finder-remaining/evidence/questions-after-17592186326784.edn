/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439717} {:answer/id #uuid "24b70d9d-f545-563b-8936-ae02a1a75b88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439718}] :answer-field/correct {:answer/id #uuid "b79033f7-3d4d-5951-93c7-4bd0b80611dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439717} :answer-field/id #uuid "dd0329ed-b944-5cdb-820b-534bd894cb0f" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440216} {:answer-field/choices [{:answer/id #uuid "e3408753-560e-5910-90fa-60ce18097d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439719} {:answer/id #uuid "bc4dbdc7-c28b-5056-8cb3-4b10444b0381" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439720}] :answer-field/correct {:answer/id #uuid "e3408753-560e-5910-90fa-60ce18097d54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439719} :answer-field/id #uuid "cb55c561-c749-5cc7-83b1-d4ef90d3847f" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440217} {:answer-field/choices [{:answer/id #uuid "fea95748-4d41-54c2-95d7-7515e499a2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439721} {:answer/id #uuid "57e50c0a-e034-580f-992c-1dbb57abf4e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439722}] :answer-field/correct {:answer/id #uuid "fea95748-4d41-54c2-95d7-7515e499a2f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439721} :answer-field/id #uuid "641f7ca8-9edf-56f1-a102-a0b83d5500a9" :answer-field/key "V" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440218}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cd01e245-cc8a-5763-b4a7-8579762d92bc" :question/math-academy-id "q-39804" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{3}-3{x}^{2}+3x-1}{(x-1)(x+5{)}^{2}}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-5$\n- **II.** $x=-1$\n- **III.** $x=0$\n- **IV.** $x=1$\n- **V.** $x=5$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{3}-3{x}^{2}+3x-1}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{(x-1{)}^{3}}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{(x-1)(x-1{)}^{2}}{(x-1)(x+5{)}^{2}} \\\\  & =\\frac{\\cancel{(x-1)}(x-1{)}^{2}}{\\cancel{(x-1)}(x+5{)}^{2}} \\\\  & =\\frac{(x-1{)}^{2}}{(x+5{)}^{2}}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\n(x+5{)}^{2}=0\n$$\n\nThis gives the solution $x=-5.$ Therefore, $x=-5$ is the only vertical asymptote."}] [{:db/id #edb/ref 17592186326791 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91ec1a25-8adf-5207-b26a-3ae451be1d96" :answer/type {:db/id #edb/ref 17592186045499 :db/