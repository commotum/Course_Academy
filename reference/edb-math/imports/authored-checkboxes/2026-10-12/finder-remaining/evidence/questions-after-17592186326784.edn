/id #uuid "97350f2f-8344-5d51-ae1f-afa4912362a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439953} :answer-field/id #uuid "1c8d9da9-bfdb-5788-8f6b-5523806704d2" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440334}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e5eafad9-4c2d-5469-bbd9-3cd0fcca968a" :question/math-academy-id "q-75278" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=2\\operatorname{cos}⁡4t-11,\\,y=3\\operatorname{sin}⁡4t+5,\\,0\\le t<\\frac{\\pi }{2}.\n$$\n\nDetermine the values of $t$ at which the normal to the curve is horizontal.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $t=0$\n- **II.** $t=\\frac{\\pi}{6}$\n- **III.** $t=\\frac{\\pi}{4}$\n- **IV.** $t=\\frac{\\pi}{3}$" :question/worked-solution "The normal is horizontal if the tangent is vertical. Therefore, we require ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n\\begin{aligned}{x}^{′}(t)=-8\\operatorname{sin}⁡4t,\\,{y}^{′}(t)=12\\operatorname{cos}⁡4t.\\end{aligned}\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n-8\\operatorname{sin}⁡4t=0\\,⟹\\,t=0,\\frac{\\pi }{4}.\n$$\n\nNow, we note that\n\n$$\n\\begin{aligned}{y}^{′}(0) & =12\\operatorname{cos}⁡(0)=12\\ne 0, \\\\ {y}^{′}(\\frac{\\pi }{4}) & =12\\operatorname{cos}⁡(\\pi )=-12\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the normal to the curve is indeed horizontal when $t=0$ and $t=\\frac{\\pi }{4}.$"}] [{:db/id #edb/ref 17592186396107 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c2e0a46-a4ee-5819-bfd8-b6605a0d8094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439879} {:answer/id #uuid "e9369708-bcb2-5c13-a3f7-152ce020d3b3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439880}] :answer-field/correct {:answer/id #uuid "7c2e0a46-a4ee-5819-bfd8-b6605a0d8094" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439879} :answer-field/id #uuid "ca3d5ff2-3ae3-5582-b549-bdcb6611dd13" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440297} {:answer-field/choices [{:answer/id #uuid "ffb34ed7-9fe8-5948-babf-545c5e4e0736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439881} {:answer/id #uuid "e8d04f5d-ce83-59f2-88c7-83f4627e68e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439882}] :answer-field/correct {:answer/id #uuid "ffb34ed7-9fe8-5948-babf-545c5e4e0736" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439881} :answer-field/id #uuid "012b94fc-d8bf-510d-a520-9dfc6c1811ab" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440298} {:answer-field/choices [{:answer/id #uuid "7f170be1-ffb8-592e-bb80-9f0195579084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439883} {:answer/id #uuid "7ba98035-0918-59db-93dd-e795d4f5ebd2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 1