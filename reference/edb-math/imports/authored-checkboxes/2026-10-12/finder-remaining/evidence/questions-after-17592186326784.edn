edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5577e429-0d55-5dd4-b588-49ac727edd6b" :question/math-academy-id "q-72440" :question/problem "At which points on the curve ${x}^{2}+2xy=-5y+4$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-4,1)$\n- **II.** $(-4,4)$\n- **III.** $(-2,4)$\n- **IV.** $(-1,1)$\n- **V.** $(-1,4)$\n- **VI.** $(1,1)$\n- **VII.** $(4,-4)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}{x}^{2}+2xy & =-5y+4 \\\\ {x}^{2}+2xy+5y & =4\\end{aligned}\n$$\n\nIf we set $f(x,y)={x}^{2}+2xy+5y$, our curve can be viewed as the level curve $f(x,y)=4.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}({x}^{2}+2xy+5y)i-\\frac{∂}{∂x}({x}^{2}+2xy+5y)j \\\\  & =(2x+5)\\,i-(2x+2y)\\,j\\end{aligned}\n$$\n\n  \n\nSince our tangent vector needs to be perpendicular to $j$, we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((2x+5)\\,i-(2x+2y)\\,j)\\cdot j & =0 \\\\ -(2x+2y) & =0 \\\\ x & =-y\\end{aligned}\n$$\n\nSubstituting $x=-y$ into the equation of our curve gives:    \n\n$$\n\\begin{aligned}{x}^{2}+2xy+5y & =4 \\\\ (-y)^{2}+2(-y)y+5y & =4 \\\\ {y}^{2}-2{y}^{2}+5y & =4 \\\\ -{y}^{2}+5y-4 & =0 \\\\ {y}^{2}-5y+4 & =0 \\\\ (y-1)(y-4) & =0 \\\\ y & =1\\,\\text{or}\\,y=4\\end{aligned}\n$$\n\nFinally:\n\n- If $y=1$, we get $x=-1$ and the corresponding point is $(-1,1).$\n\n- If $y=4$, we get $x=-4$ and the corresponding point is $(-4,4).$"}] [{:db/id #edb/ref 17592186348433 :knowledge-point/_questions [{:db/id #edb/ref 17592186087842 :knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc" :knowledge-point/title "Calculating the Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fbf6982-05b4-57ae-9835-2a8ab3b2e21d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439961} {:answer/id #uuid "54cc906b-e4bc-599d-8d74-6fa3a9b26e21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439962}] :answer-field/correct {:answer/id #uuid "6fbf6982-05b4-57ae-9835-2a8ab3b2e21d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439961} :answer-field/id #uuid "07350d2f-29b2-579d-9e6d-ceb08289cfd4" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440338} {:answer-field/choices [{:answer/id #uuid "f25878b7-8130-555e-aa37-27cbe26000c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439963} {:answer/id #uuid "27376910-59b5-508c-953c-14f679761cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439964}] :answer-field/correct {:answer/id #uuid "27376910-59b5-508c-953c-14f679761cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439964} :answer-field/id #uuid "41d6080f-1108-5fe0-9c51-3a0c440cb68c" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440339} {:answer-field/choices [{:answer/id #uuid "c7894690-5c97-58f9-8498-da751ab39da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439965} {:answer/id #uuid "c9827e3f-acf0-5df9-9fe2-90c258c048b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439966}] :answer-field/correct {:answer/id #uuid "c7894690-5c97-58f9-8498-da751ab39da4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439965} :answer-field/id #uuid "70ca306e-3cd4-5425-bff4-3f369e2d93d1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440340} {:answer-field/choices [{:answer/id #uuid "112e2955-ebe3-5b34-83f3-8f2972dcf1a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439967} {:answer/id #uuid "81445fe9-98f9-5684-afdd-6798f390e9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439968}] :answer-field/correct {:answer/id #uuid "81445fe9-98f9-5684-afdd-6798f390e9ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439968} :answer-field/id #uuid "a6554586-5933-53ba-ba8d-33fbdb8aa00a" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440341}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "45255a84-5494-574a-bd9f-880b4b37a48c" :question/math-academy-id "q-80669" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}+3x}{{x}^{2}-3x-4}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-3$\n- **II.** $x=-1$\n- **III.** $x=0$\n- **IV.** $x=4$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\nf(x)=\\frac{x(x+3)}{(x+1)(x-4)}.\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+1)(x-4) & =0\\end{aligned}\n$$\n\nThis gives the two solutions $x=-1$ and $x=4.$ Therefore, the equations of the vertical asymptotes are $x=-1$ and $x=4.$"}] [{:db/id #edb/ref 17592186348434 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38427c47-6a48-59eb-baae-0cd579cf066e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439969} {:answer/id #uuid "f23fff08-7ea9-52a7-9e88-f5a94698619b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439970}] :answer-field/correct {:answer/id #uuid "38427c47-6a48-59eb-baae-0cd579cf066e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439969} :answer-field/id #uuid "1911fc60-54f6-517c-8ae8-21b2ce16ca8c" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440342} {:answer-field/choices [{:answer/id #uuid "c5572999-573e-529b-862f-4bb6987d4a08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439971} {:answer/id #uuid "4337c38c-3dfe-5b58-916f-32783c4bed89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439972}] :answer-field/correct {:answer/id #uuid "c5572999-573e-529b-862f-4bb6987d4a08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439971} :answer-field/id #uuid "bc150f73-610e-51a3-838e-ff730a027cbf" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440343} {:answer-field/choices [{:answer/id #uuid "febf4efe-8826-5f6a-9c5e-0d33123893e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439973} {:answer/id #uuid "e201d944-0761-5a84-9e70-3abd37d71214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439974}] :answer-field/correct {:answer/id #uuid "e201d944-0761-5a84-9e70-3abd37d71214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439974} :answer-field/id #uuid "c9575f0f-78af-5d52-b5a5-b76147fe2120" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440344}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e336039-4f92-550b-b76c-a2a62662e884" :question/math-academy-id "q-80676" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{2x-1}{{x}^{3}-2{x}^{2}+4x-8}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-2$\n- **II.** $x=0$\n- **III.** $x=2$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2x-1}{{x}^{3}-2{x}^{2}+4x-8} \\\\  & =\\frac{2x-1}{{x}^{2}(x-2)+4(x-2)} \\\\  & =\\frac{2x-1}{({x}^{2}+4)(x-2)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n({x}^{2}+4)(x-2)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x-2=0$ gives the solution $x=2.$\n\n- The equation ${x}^{2}+4=0$ has no real solutions.\n\nTherefore, the only vertical asymptote is $x=2.$"}] [{:db/id #edb/ref 17592186348436 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17477df2-f0f4-5538-a244-56aea05cba72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439987} {:answer/id #uuid "4111ff3c-d0bc-54cd-ae53-5033ced42cf9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439988}] :answer-field/correct {:answer/id #uuid "17477df2-f0f4-5538-a244-56aea05cba72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439987} :answer-field/id #uuid "3e120579-8cdb-5aed-b472-cdd452c6dd89" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440351} {:answer-field/choices [{:answer/id #uuid "7b077963-4b94-595c-a8c7-8403dce760df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439989} {:answer/id #uuid "ac08d284-24da-54d7-95ae-c0a17688cf41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439990}] :answer-field/correct {:answer/id #uuid "ac08d284-24da-54d7-95ae-c0a17688cf41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439990} :answer-field/id #uuid "c051dc5e-f9a1-54de-bcd7-d06f80947b64" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440352} {:answer-field/choices [{:answer/id #uuid "8a670ae7-b4e9-56d5-9e32-f53179df0e56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439991} {:answer/id #uuid "6f200a3c-bfc5-508d-a0f7-8b79f49ccc25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439992}] :answer-field/correct {:answer/id #uuid "8a670ae7-b4e9-56d5-9e32-f53179df0e56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439991} :answer-field/id #uuid "ce8c3600-f50b-5a8b-8104-fc9a5591facf" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440353}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dad69b3-29eb-58b2-9a73-eefa5740f30c" :question/math-academy-id "q-80691" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{x+2}{{x}^{2}+2x}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-2$\n- **II.** $x=0$\n- **III.** $x=2$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{x+2}{{x}^{2}+2x} \\\\  & =\\frac{x+2}{x(x+2)} \\\\  & =\\frac{\\cancel{x+2}}{x\\cancel{(x+2)}} \\\\  & =\\frac{1}{x}.\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero and solve for $x:$\n\n$$\nx=0\n$$\n\nThis gives the solution $x=0.$ Therefore, $x=0$ is the only vertical asymptote."}] [{:db/id #edb/ref 17592186348437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a23df9c-0bb4-5f06-a2ce-f50dbe498d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439993} {:answer/id #uuid "15b3d22f-4cec-5498-90ba-670c1d780658" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439994}] :answer-field/correct {:answer/id #uuid "3a23df9c-0bb4-5f06-a2ce-f50dbe498d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439993} :answer-field/id #uuid "2c9ab1ab-d571-5366-9440-7a3c113c7d35" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440354} {:answer-field/choices [{:answer/id #uuid "5e50e6fe-de04-5702-9faf-549a10b505fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439995} {:answer/id #uuid "fe516876-d9e1-54d1-84bc-ee6388f07ba7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439996}] :answer-field/correct {:answer/id #uuid "5e50e6fe-de04-5702-9faf-549a10b505fa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439995} :answer-field/id #uuid "e1ddbc92-6bd1-5484-8f57-506f318d7cee" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440355} {:answer-field/choices [{:answer/id #uuid "370a76e0-2c04-500b-a841-77d0ae40552c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439997} {:answer/id #uuid "91966088-bf02-5175-b84e-d585c7568317" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439998}] :answer-field/correct {:answer/id #uuid "370a76e0-2c04-500b-a841-77d0ae40552c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439997} :answer-field/id #uuid "81e0421e-636c-51a4-83fb-f74c8f1eae44" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440356}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7fbfa1c-696c-569c-8a32-b9f903615eb9" :question/math-academy-id "q-80696" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{4x}{x({x}^{2}+1)}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=0$\n- **III.** $x=1$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{4x}{x({x}^{2}+1)} \\\\  & =\\frac{4\\cancel{x}}{\\cancel{x}({x}^{2}+1)} \\\\  & =\\frac{4}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186362340 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ac7900-ea05-5cc8-9d53-11c30c4ca60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440029} {:answer/id #uuid "91747f90-b1ca-5a23-b764-3011370995c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440030}] :answer-field/correct {:answer/id #uuid "37ac7900-ea05-5cc8-9d53-11c30c4ca60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440029} :answer-field/id #uuid "536c4571-b3d8-5ac6-b419-3f6f71056077" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440372} {:answer-field/choices [{:answer/id #uuid "d1e4cb25-b3e5-5104-8ec6-1f86c12d56d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440031} {:answer/id #uuid "7ff679bc-fdfb-5669-bd8b-854d2358190c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440032}] :answer-field/correct {:answer/id #uuid "7ff679bc-fdfb-5669-bd8b-854d2358190c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440032} :answer-field/id #uuid "e5c431c2-1fb0-5a03-b48d-74276cb322b4" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440373} {:answer-field/choices [{:answer/id #uuid "9399f58c-b270-5d89-8f0f-c6e1b2ae15a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186440033} {:answer/id #uuid "7cd73f80-9ac4-5715-aa47-0376b208e6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440034}] :answer-field/correct {:answer/id #uuid "7cd73f80-9ac4-5715-aa47-0376b208e6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186440034} :answer-field/id #uuid "f7c8be4f-cbe0-55fc-a506-530979c94394" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440374}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e554c090-e3bc-5a93-90b4-9f79a0997b62" :question/math-academy-id "q-9911" :question/problem "Find the possible values of the constant $k$ given that the matrix\n$[\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}]$ is singular.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $k=-3$\n- **II.** $k=0$\n- **III.** $k=3$" :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $k:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -1 & k \\\\ 1 & k & -k \\\\ 5 & k & k\\end{aligned}| & =1|\\begin{aligned}k & -k \\\\ k & k\\end{aligned}|-(-1)|\\begin{aligned}1 & -k \\\\ 5 & k\\end{aligned}|+k|\\begin{aligned}1 & k \\\\ 5 & k\\end{aligned}| \\\\  & =({k}^{2}+{k}^{2})+(k+5k)+k(k-5k) \\\\  & =2{k}^{2}+6k+k\\cdot (-4k) \\\\  & =2{k}^{2}+6k-4{k}^{2} \\\\  & =-2{k}^{2}+6k\\end{aligned}\n$$\n\nSince the matrix is singular, the determinant is $0,$ and we have:\n\n$$\n\\begin{aligned}-2{k}^{2}+6k & =0 \\\\ k(-2k+6) & =0\\end{aligned}\n$$\n\nTherefore, the solutions are $k=0$ and $k=3.$"}] [{:db/id #edb/ref 17592186373757 :knowledge-point/_questions [{:db/id #edb/ref 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "afbb76f8-a135-56ab-98ff-95aa371de6bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439519} {:answer/id #uuid "8c88915e-5b21-5b50-b76c-b452eb74095d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439520}] :answer-field/correct {:answer/id #uuid "afbb76f8-a135-56ab-98ff-95aa371de6bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439519} :answer-field/id #uuid "cb7991eb-11ab-5be8-9cff-8cb4c831a986" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440117} {:answer-field/choices [{:answer/id #uuid "bee1c3fd-7f28-5bd0-8439-264f31d9f15a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439521} {:answer/id #uuid "aba6457d-6ee5-5643-8c8f-eae80358d7d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439522}] :answer-field/correct {:answer/id #uuid "aba6457d-6ee5-5643-8c8f-eae80358d7d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439522} :answer-field/id #uuid "f05aaa51-707b-51f8-bed1-c062eb9077c6" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440118} {:answer-field/choices [{:answer/id #uuid "049822ce-ef15-5b5d-9864-ade62a37ec43" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439523} {:answer/id #uuid "60358451-984b-5b61-929f-f92074afc976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439524}] :answer-field/correct {:answer/id #uuid "60358451-984b-5b61-929f-f92074afc976" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439524} :answer-field/id #uuid "24967753-af42-5895-a050-8e8c6b225ad6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440119} {:answer-field/choices [{:answer/id #uuid "6a274467-574a-5539-983e-4d583bc9ec92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439525} {:answer/id #uuid "65a64ec9-6cdd-507e-9bfb-590aab6a8b2f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439526}] :answer-field/correct {:answer/id #uuid "6a274467-574a-5539-983e-4d583bc9ec92" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439525} :answer-field/id #uuid "ed98d8f5-235d-543c-a23d-ff763ed379a9" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440120}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d9c5851-2645-50db-8b4e-b731824fd7d9" :question/math-academy-id "q-130225" :question/problem "At which points on the curve $2{x}^{2}-3{y}^{2}=-y$ is the tangent vector to the curve perpendicular to the vector $j?$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $(-1,1)$\n- **II.** $(0,0)$\n- **III.** $(0,\\frac{1}{3})$\n- **IV.** $(1,1)$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2{x}^{2}-3{y}^{2}+y & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=2{x}^{2}-3{y}^{2}+y,$ our curve can be viewed as the level curve $f(x,y)=0.$ \n\nA tangent vector to the level curve can be computed as follows:\n\n$$\nt(x,y)={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j\n$$\n\nSo, we calculate $t(x,y):$\n\n$$\n\\begin{aligned}t(x,y) & ={f}_{y}(x,y)\\,i-{f}_{x}(x,y)\\,j \\\\  & =\\frac{∂}{∂y}(2{x}^{2}-3{y}^{2}+y)\\,i-\\frac{∂}{∂x}(2{x}^{2}-3{y}^{2}+y)\\,j \\\\  & =(-6y+1)\\,i-4x\\,j\\end{aligned}\n$$\n\nSince our tangent vector needs to be perpendicular to $j,$ we must have $t\\cdot j=0.$\n\n$$\n\\begin{aligned}t(x,y)\\cdot j & =0 \\\\ ((-6y+1)\\,i-4x\\,j)\\cdot j & =0 \\\\ -4x & =0 \\\\ x & =0\\end{aligned}\n$$\n\nSubstituting $x=0$ into the equation of our curve gives\n\n$$\n\\begin{aligned}2{x}^{2}-3{y}^{2} & =-y \\\\ 2({0}^{2})-3{y}^{2} & =-y \\\\ 3{y}^{2}-y & =0 \\\\ y(3y-1) & =0 \\\\ y & =0,\\frac{1}{3}.\\end{aligned}\n$$\n\nFinally, the corresponding points are $(0,0)$ and $(0,\\frac{1}{3}).$"}] [{:db/id #edb/ref 17592186393514 :knowledge-point/_questions [{:db/id #edb/ref 17592186083280 :knowledge-point/id #uuid "12a5ad95-0cc9-53c5-8e1c-dae35d1c4447" :knowledge-point/title "Determining the Points Where the Normal is Horizontal or Vertical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eb0847e-f077-52b5-a2dc-3b5be04d8d95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439947} {:answer/id #uuid "4427a1db-576b-5e6d-b443-4988d488b644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439948}] :answer-field/correct {:answer/id #uuid "4427a1db-576b-5e6d-b443-4988d488b644" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439948} :answer-field/id #uuid "f8fddcc0-226d-57ff-8494-03c04378375d" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440331} {:answer-field/choices [{:answer/id #uui