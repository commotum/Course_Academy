edb/ref 17592186439759} {:answer/id #uuid "d0a9ed5a-ca17-5e7d-8867-1da5ff5e84a5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439760}] :answer-field/correct {:answer/id #uuid "1be61f67-558c-5cf9-97de-efa3776455d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439759} :answer-field/id #uuid "c9224378-06cc-56f0-94b9-9d69d12cb10c" :answer-field/key "C" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a1fe1df-e314-527e-a884-f0c092b97472" :question/math-academy-id "q-42090" :question/problem "Which of the following matrices are upper triangular matrices?\n\nSelect all that apply.\n\n$A=[\\begin{aligned}8 & 0 & -1 & 0 \\\\ 0 & 0 & 0 & 7 \\\\ 0 & 0 & -4 & 5 \\\\ 0 & 0 & 0 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 6 \\\\ 0 & -1 & 3 \\\\ 5 & 7 & 11\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 1 \\\\ 0 & 1 & 0 \\\\ 0 & 3 & 0\\end{aligned}].$" :question/worked-solution "The matrix $A$ is an upper triangular matrix since all the entries below the main diagonal are zeros.\n\nThe matrices $B$ and $C$ are *not* upper triangular matrices since they each have a non-zero element below the main diagonal: \n\n$$\n\\begin{aligned}{b}_{31} & =5\\ne 0 \\\\ {c}_{32} & =3\\ne 0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120426 :knowledge-point/_questions [{:db/id #edb/ref 17592186119784 :knowledge-point/id #uuid "e69a4aee-6e92-598b-99b5-1d830b6dea54" :knowledge-point/title "Identifying Correct Statements About a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76bc55da-83d7-5857-aa45-f67452354c98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 1759218643976