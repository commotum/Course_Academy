 :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440307}] :question/id #uuid "c03ca93b-0e02-5579-b71e-c5575bb3360d" :question/math-academy-id "q-69515" :question/problem "Which of the following is a $3 \\times 4$ matrix?\n\nSelect all that apply.\n\n$P = \\begin{bmatrix}-4 & 5 \\\\ 0 & 0\\end{bmatrix}, Q = \\begin{bmatrix}4 & -2 & 1 \\\\ 0 & 0 & 12 \\\\ -3 & 4 & 3 \\\\ 0 & -0.1 & 7\\end{bmatrix}, R = \\begin{bmatrix}4 & -2 & 0 & -1 \\\\ 0 & 0 & -1 & -2 \\\\ -3 & 4 & 0 & 12\\end{bmatrix}$" :question/worked-solution "P is 2 by 2, Q is 4 by 3, and R is 3 by 4. Only R has the requested dimensions."}] [{:db/id #edb/ref 17592186088384 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1fea36-9671-5fbf-9dcf-f832de65f076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439975} {:answer/id #uuid "ccac611d-3a72-5cda-8e09-240f273be213" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439976}] :answer-field/correct {:answer/id #uuid "0f1fea36-9671-5fbf-9dcf-f832de65f076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439975} :answer-field/id #uuid "bd0c9173-e4a9-5048-bd6d-e31abe13f2df" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440345} {:answer-field/choices [{:answer/id #uuid "7ad3e2be-95b6-52d5-a98b-8c0101816532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439977} {:answer/id #uuid "4217e75d-426b-5ad0-a7a4-55488bc99b22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439978}] :answer-field/correct {:answer/id #uuid "7ad3e2be-95b6-52d5-a98b-8c0101816532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439977} :answer-field/id #uuid "b8880e6c-c4cd-5016-804c-1bca39dfc00e" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440346} {:answer-field/choices [{:answer/id #uuid "45a4fdc5-280e-5f4c-88db-eac46f490be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439979} {:answer/id #uuid "5024119c-836c-5798-8a8f-df5125ede612" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439980}] :answer-field/correct {:answer/id #uuid "45a4fdc5-280e-5f4c-88db-eac46f490be3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439979} :answer-field/id #uuid "49107bc8-a0f2-575c-a076-bb39b1278619" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440347}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90dc5317-bc84-5136-bb1e-99a7e0621f24" :question/math-academy-id "q-80679" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}-4x+5}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=1$\n- **III.** $x=5$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n{x}^{2}-4x+5=0.\n$$\n\nNote that the above equation has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-4{)}^{2}-4(1)(5) \\\\  & =16-20 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, $y=f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186088386 :knowledge-point/_questions [{:db/id #edb/ref 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56abaacf-7014-5ffd-9efe-e2a1caf6c344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439981} {:answer/id #uuid "dd11aaf1-5e28-57a0-8c01-6145f9df4b44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439982}] :answer-field/correct {:answer/id #uuid "56abaacf-7014-5ffd-9efe-e2a1caf6c344" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439981} :answer-field/id #uuid "7e38a71f-4842-585e-bb22-042bc0a8e856" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440348} {:answer-field/choices [{:answer/id #uuid "ccb60061-92cb-51d7-8a92-7cfc357c3414" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439983} {:answer/id #uuid "df93b8f7-7395-5cc3-bc04-b31cb28153e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439984}] :answer-field/correct {:answer/id #uuid "ccb60061-92cb-51d7-8a92-7cfc357c3414" :answer/type {:db/id #edb/ref