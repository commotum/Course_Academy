6439765} :answer-field/id #uuid "7d4fb36d-bf6c-5859-bad3-fc51a1c5bd9b" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440240}] :question/id #uuid "64e75667-2ca8-5517-b38f-4bfa5cf4e995" :question/math-academy-id "q-42115" :question/problem "Consider the matrix\n$A = \\begin{bmatrix}-3 & 1 & 0 \\\\ -1 & 1 & 0 \\\\ 0 & 0 & 5\\end{bmatrix}$.\nWhich of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $A$ is upper triangular\n- **II.** $A^{T} + A$ is upper triangular\n- **III.** $A$ is lower triangular" :question/worked-solution "A is neither upper nor lower triangular because both off-diagonal entries a12=1 and a21=-1 are nonzero. However A^T+A=diag(-6,2,10), so statement II is true."}] [{:db/id #edb/ref 17592186124945 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "261d9ebc-3761-5522-83de-662661527279" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439633} {:answer/id #uuid "46f72ccb-a1c7-5b04-a483-87efd5df56b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439634}] :answer-field/correct {:answer/id #uuid "46f72ccb-a1c7-5b04-a483-87efd5df56b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439634} :answer-field/id #uuid "5954b313-8f70-5702-b0ec-cf29f59d7bab" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440174} {:answer-field/choices [{:answer/id #uuid "d6955807-8093-5092-aaeb-32c4770e28cf" :answer/type {:db/id #edb/ref 17592186045499 :