wer.type/text} :answer/value "false" :db/id #edb/ref 17592186439575} :answer-field/id #uuid "44e4474f-97ed-5e59-b5f9-93137bfb2c2d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440145}] :question/id #uuid "9e0c6801-5ef7-5ccd-ab0c-ee92136a4d3f" :question/math-academy-id "q-19215" :question/problem "![](images/28/285bc802c51b89c2dd5b64bd3ee5ff41bf49d798110fb0c9f29c59ea00f66cf8.png)\n\nConsider the diagram that is shown above. Which of the following statements are true?\n\nSelect all that apply.\n\n- **I.** $b =-2e$\n- **II.** $c =-d$\n- **III.** $b = 2e$" :question/worked-solution "The grid gives b=(-4,-2), e=(2,1), c=(2,5), d=(-2,-5). Hence b=-2e and c=-d; b=2e is false."}] [{:db/id #edb/ref 17592186097176 :knowledge-point/_questions [{:db/id #edb/ref 17592186096700 :knowledge-point/id #uuid "dc5bab6c-1ce7-58b5-a59d-cff2ce35ecca" :knowledge-point/title "Identifying Parallel Vectors From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77818547-036e-5820-90b3-2805c7973aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439577} {:answer/id #uuid "5d01b2ab-7947-576d-a108-bee40c7176e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439578}] :answer-field/correct {:answer/id #uuid "77818547-036e-5820-90b3-2805c7973aa8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439577} :answer-field/id #uuid "8f8b99d4-02e8-53c0-9851-f767bd829299" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440146} {:answer-field/choices [{:answer/id #uuid "5cd7760c-3ab9-5ce4-b194-04b0897302d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/v