nt :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439553} :answer-field/id #uuid "d21ddfff-201d-565d-875a-ebc1c438bce9" :answer-field/key "VIII" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440134}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c642acf-da11-5fe2-a467-6e32aaff486e" :question/math-academy-id "q-130580" :question/problem "Given that the determinant of\n$[\\begin{aligned}x & 2x & 3 \\\\ 5 & x & 7 \\\\ 3 & 2 & 1\\end{aligned}]$\nis $22$, find all the possible values of $x.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-8$\n- **II.** $x=-5$\n- **III.** $x=-3$\n- **IV.** $x=-1$\n- **V.** $x=3$\n- **VI.** $x=5$\n- **VII.** $x=7$\n- **VIII.** $x=8$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $x:$\n\n$$\n\\begin{aligned}|\\begin{aligned}x & 2x & 3 \\\\ 5 & x & 7 \\\\ 3 & 2 & 1\\end{aligned}| & =x|\\begin{aligned}x & 7 \\\\ 2 & 1\\end{aligned}|-2x|\\begin{aligned}5 & 7 \\\\ 3 & 1\\end{aligned}|+3|\\begin{aligned}5 & x \\\\ 3 & 2\\end{aligned}| \\\\  & =x(x-14)-2x(5-21)+3(10-3x) \\\\  & ={x}^{2}-14x+32x+30-9x \\\\  & ={x}^{2}+9x+30\\end{aligned}\n$$\n\nSince the determinant of the matrix is $22,$ we have:\n\n$$\n\\begin{aligned}{x}^{2}+9x+30 & =22 \\\\ {x}^{2}+9x+8 & =0 \\\\ x & =\\frac{-9\\pm \\sqrt{{9}^{2}-4\\cdot 1\\cdot 8}}{2\\cdot 1} \\\\  & =\\frac{-9\\pm \\sqrt{49}}{2} \\\\  & =\\frac{-9\\pm 7}{2} \\\\  & =-8,-1\\end{aligned}\n$$\n\nTherefore, the solutions are $x=-8$ and $x=-1.$"}] [{:db/id #edb/ref 17592186265945 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21390a7b-0a54-5e9a-9011-c7deff139c41" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\frac{5}{2}$ only" :db/id #edb/ref 17592186263297} {:answer/id #uuid "91d75f72-1a96-5644-a529-caf7355ab1bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Any value of $p$" :db/id #edb/ref 17592186264249} {:answer/id #uuid "970c8319-2067-5d80-a590-021621a09030" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ and $3$ only" :db/id #edb/ref 17592186264292} {:answer/id #uuid "f080186a-d1c4-58fa-9d1f-db014dd38fcc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-3$ only" :db/id #edb/ref 17592186265109} {:answer/id #uuid "fc1c675c-a294-5ee2-a8ca-549d874e48c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$-10$ only" :db/id #edb/ref 17592186265208}] :answer-field/correct {:answer/id #uuid "91d75f72-1a96-5644-a529-caf7355ab1bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Any value of $p$" :db/id #edb/ref 17592186264249} :answer-field/id #uuid "a69f31fe-6848-54a7-8e0e-0e1258ee7ad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265543}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fee93468-4926-51f6-9486-b49c687c7f2f" :question/math-academy-id "q-130626" :question/problem "Find the possible values of the constant $p$ given that the matrix\n$[\\begin{aligned}1 & -3p & 4 \\\\ -2 & 6p & -8 \\\\ 1 & -1 & 1\\end{aligned}]$ is singular." :question/worked-solution "First, let's use our formula to find an expression for the determinant in terms of $p:$\n\n$$\n\\begin{aligned}|\\begin{aligned}1 & -3p & 4 \\\\ -2 & 6p & -8 \\\\ 1 & -1 & 1\\end{aligned}| & =1|\\begin{aligned}6p & -8 \\\\ -1 & 1\\end{aligned}|-(-3p)|\\begin{aligned}-2 & -8 \\\\ 1 & 1\\end{aligned}|+4|\\begin{aligned}-2 & 6p \\\\ 1 & -1\\end{aligned}| \\\\  & =(6p-8)+3p(-2+8)+4(2-6p) \\\\  & =6p-8+18p+8-24p \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, this matrix is singular for all values of $p.$"}] [{:db/id #edb/ref 17592186287821 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "458cafbf-7052-5688-a3e6-270feaa693c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439555} {:answer/id #uuid "f155cb5b-192c-558c-aa25-73d859f68f54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439556}] :answer-field/correct {:answer/id #uuid "f155cb5b-192c-558c-aa25-73d859f68f54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439556} :answer-field/id #uuid "11461a6e-1dea-5d60-87fb-79ffe64218c2" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440135} {:answer-field/choices [{:answer/id #uuid "ac822410-bfae-5d59-9738-427934044f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439557} {:answer/id #uuid "0258f679-5bbb-5a4f-8ebb-3d4abeaeab7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439558}] :answer-field/correct {:answer/id #uuid "ac822410-bfae-5d59-9738-427934044f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439557} :answer-field/id #uuid "e1d050ea-e9d9-5e3c-ba92-d504ed6a5ce7" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440136} {:answer-field/choices [{:answer/id #uuid "1fee28db-a2fa-5c8a-b01b-25dceb5db556" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439559} {:answer/id #uuid "1bc5a615-11e6-5a3f-b222-5f82eaec2ed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439560}] :answer-field/correct {:answer/id #uuid "1bc5a615-11e6-5a3f-b222-5f82eaec2ed5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439560} :answer-field/id #uuid "fecaf349-b286-5e78-8846-4d31a1320995" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440137} {:answer-field/choices [{:answer/id #uuid "fc065864-faea-55e7-829d-8436655f4adf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439561} {:answer/id #uuid "2e659b65-8b01-57c8-8277-3075d6254b77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439562}] :answer-field/correct {:answer/id #uuid "fc065864-faea-55e7-829d-8436655f4adf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439561} :answer-field/id #uuid "e28d926e-be6f-58c9-bdc1-98b5d2921bdf" :answer-field/key "IV" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186440138}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "627e7a3d-46e0-5ce8-b4f0-d14bd806cb23" :question/math-academy-id "q-18256" :question/problem "Given that the determinant of \n$[\\begin{aligned}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{aligned}]$\n is $81,$ find all the possible values of $y.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $y=- \\frac{25}{9}$\n- **II.** $y=- \\frac{5}{3}$\n- **III.** $y=-1$\n- **IV.** $y=1$" :question/worked-solution "Let's use our formula to find an expression for the determinant in terms of $y:$\n\n$$\n\\begin{aligned}|\\begin{aligned}4 & 2 & 3 \\\\ -3y & -2 & 1 \\\\ 2 & y & -5\\end{aligned}| & =4|\\begin{aligned}-2 & 1 \\\\ y & -5\\end{aligned}|-2|\\begin{aligned}-3y & 1 \\\\ 2 & -5\\end{aligned}|+3|\\begin{aligned}-3y & -2 \\\\ 2 & y\\end{aligned}| \\\\  & =4\\cdot (10-y)-2\\cdot (15y-2)+3\\cdot (-3{y}^{2}+4) \\\\  & =40-4y-30y+4-9{y}^{2}+12 \\\\  & =-9{y}^{2}-34y+56\\end{aligned}\n$$\n\nSince the determinant of the matrix is $81,$ we have:\n\n$$\n\\begin{aligned}-9{y}^{2}-34y+56 & =81 \\\\ -9{y}^{2}-34y-25 & =0 \\\\ 9{y}^{2}+34y+25 & =0 \\\\ y & =\\frac{-34\\pm \\sqrt{{34}^{2}-4\\cdot 9\\cdot 25}}{2\\cdot 9} \\\\  & =\\frac{-34\\pm \\sqrt{256}}{18} \\\\  & =\\frac{-34\\pm 16}{18} \\\\  & =\\frac{-17\\pm 8}{9}\\end{aligned}\n$$\n\nTherefore, the solutions are $y=-\\frac{25}{9}$ and $y=-1.$"}] [{:db/id #edb/ref 17592186287825 :knowledge-point/_questions [{:db/id #edb/ref 17592186059849 :knowledge-point/id #uuid "ab642ad6-d9e0-5734-83b4-81627b9132eb" :knowledge-point/title "Solving for an Unknown Given the Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8a0b14-4d5c-5c97-adda-ad9333ee9989" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186439563} {:answer/id #uuid "dd74231f-397c-535b-b601-fd3c79196c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186439564}] :answer-field/correct {:answer/id #uuid "dd74231f-397c-535b-b601-fd3c79196c9d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :an