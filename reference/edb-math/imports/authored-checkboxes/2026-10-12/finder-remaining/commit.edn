 & -0.1 & 7\\end{bmatrix}, R = \\begin{bmatrix}4 & -2 & 0 & -1 \\\\ 0 & 0 & -1 & -2 \\\\ -3 & 4 & 0 & 12\\end{bmatrix}$" 13194139534834 17592186045436 false] [17592186088276 1071 "Which of the following is a $3 \\times 4$ matrix?\n\nSelect all that apply.\n\n$P = \\begin{bmatrix}-4 & 5 \\\\ 0 & 0\\end{bmatrix}, Q = \\begin{bmatrix}4 & -2 & 1 \\\\ 0 & 0 & 12 \\\\ -3 & 4 & 3 \\\\ 0 & -0.1 & 7\\end{bmatrix}, R = \\begin{bmatrix}4 & -2 & 0 & -1 \\\\ 0 & 0 & -1 & -2 \\\\ -3 & 4 & 0 & 12\\end{bmatrix}$" 13194139534834 17592186045436 true] [17592186088276 1074 "P is 2 by 2, Q is 4 by 3, and R is 3 by 4. Only R has the requested dimensions." 13194139534834 17592186045436 true] [17592186088384 1068 #edb/ref 17592186348010 13194139534834 17592186045436 false] [17592186088384 1068 #edb/ref 17592186440345 13194139534834 17592186045436 true] [17592186088384 1068 #edb/ref 17592186440346 13194139534834 17592186045436 true] [17592186088384 1068 #edb/ref 17592186440347 13194139534834 17592186045436 true] [17592186088384 1071 "Calculate the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}-4x+5}.$" 13194139534834 17592186045436 false] [17592186088384 1071 "Calculate the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}-4x+5}.$\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-1$\n- **II.** $x=1$\n- **III.** $x=5$" 13194139534834 17592186045436 true] [17592186088386 1068 #edb/ref 17592186086969 13194139534834 17592186045436 false] [17592186088386 1068 #edb/ref 17592186440348 13194139534834 17592186045436 true] [17592186088386 1068 #edb/ref 17592186440349 13194139534834 17592186045436 true] [17592186088386 1068 #edb/ref 17592186440350 13194139534834 17592186045436 true] [17592186088386 1071 "Calculate the vertical asymptotes of $f(x) = (x)/(x(x - 2))$." 13194139534834 17592186045436 false] [17592186088386 1071 "Calculate the vertical asymptotes of $f(x) = (x)/(x(x - 2))$.\n\nSelect all that apply. If none apply, leave all boxes unchecked.\n\n- **I.** $x=-2$\