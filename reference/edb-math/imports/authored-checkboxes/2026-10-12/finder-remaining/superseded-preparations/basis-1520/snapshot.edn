92186080735}] :question/id #uuid "57cb918d-01c6-5793-92dd-c253fd54156c" :question/math-academy-id "q-21080" :question/problem "A curve is defined by the parametric equations\n$x = 4\\cos 2t + 5, y = 5\\sin 2t + 4, 0 \\le t < π$.\n\nDetermine the values of $t$ at which the normal to the curve is horizontal."}] [{:db/id 17592186083613 :knowledge-point/_questions [{:db/id 17592186083278 :knowledge-point/id #uuid "3fc81cba-b997-54bc-9e11-0a4ff130833e" :knowledge-point/title "Determining the Points Where the Tangent is Horizontal or Vertical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a0fa5cb-58b2-5991-aeb3-3c72630b91f4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{2}$ only" :db/id 17592186080742} {:answer/id #uuid "d40ce140-4fa5-5e19-a6d2-c2ed4122946e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{2}$ and $t = \\frac{3π}{2}$" :db/id 17592186080743} {:answer/id #uuid "ebdb6ae8-5736-5ecb-a2b0-06e71866c8c9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{3π}{2}$ only" :db/id 17592186080744} {:answer/id #uuid "1f118b88-363d-549d-8d78-43f7f7a3fe35" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{4}$ and $t = \\frac{3π}{4}$" :db/id 17592186080745} {:answer/id #uuid "416acf6e-914c-5f39-8409-93bf2a0d33b4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{4}$ only" :db/id 17592186080746}] :answer-field/id #uuid "b486e99f-74f6-58c2-873a-74bcf30e0b85" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186080741} {:answer-field/choices [{:answer/id #uuid "177fc0fe-e31a-5f41-9aab-356a0006fb3a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{3\\pi }{2}$ only" :db/id 17592186401861} {:answer/id #uuid "10683790-7483-51aa-9bcd-7831b9d3d041" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$" :db/id 17592186401862} {:answer/id #uuid "1843433f-102c-52fd-970b-a78c3d6b3a06" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ only" :db/id 17592186401863} {:answer/id #uuid "50097778-e660-56b2-929d-8baced007acc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ and $t=\\frac{3\\pi }{4}$" :db/id 17592186401864} {:answer/id #uuid "835e0688-6998-5bbb-863e-83fa6322632b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ only" :db/id 17592186401865}] :answer-field/correct {:answer/id #uuid "10683790-7483-51aa-9bcd-7831b9d3d041" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$" :db/id 17592186401862} :answer-field/id #uuid "f9d95bd4-f167-53f1-8c45-da39995abe7c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186401860}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbd878d8-e318-5109-beb9-89ecefca7f9d" :question/math-academy-id "q-21081" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4\\operatorname{sin}⁡t+7,\\,y=4\\operatorname{cos}⁡t+10,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=-4\\operatorname{sin}⁡t.\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n4\\operatorname{cos}⁡t=0\\,⟹\\,t=\\frac{\\pi }{2},\\frac{3\\pi }{2}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =-4\\ne 0, \\\\ {y}^{′}(\\frac{3\\pi }{2}) & =4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the tangent to the curve is indeed vertical when $t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}.$"}] [{:db/id 17592186088163 :knowledge-point/_questions [{:db/id 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24b3ce4f-f02a-5973-8510-abddd72abd3d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x=1,\\,x=0" :db/id 17592186324272} {:answer/id #uuid "27e02c0c-7e36-5287-8af8-5b938f095220" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id 17592186324290} {:answer/id #uuid "b4c52696-ba99-57ea-8f2e-c13d827516e0" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{1}{2}$ only" :db/id 17592186325525} {:answer/id #uuid "d3ff13b6-5212-585e-8824-169927916126" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=-\\frac{1}{2}" :db/id 17592186325815} {:answer/id #uuid "fa94debb-5a3f-5611-9395-ed887d33efbc" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x=1,\\,x=-1" :db/id 17592186326177}] :answer-field/correct {:answer/id #uuid "27e02c0c-7e36-5287-8af8-5b938f095220" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id 17592186324290} :answer-field/id #uuid "40259e5d-4cd1-55c7-8aff-27f6b5a4499e" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186326324}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bac7c54b-040c-5d96-8fcc-40e2d221cff2" :question/math-academy-id "q-39795" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{5}{{x}^{3}+{x}^{2}+x}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{5}{{x}^{3}+{x}^{2}+x} \\\\  & =\\frac{5}{x({x}^{2}+x+1)}.\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\nx({x}^{2}+x+1)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $2x=0$ gives the solution $x=0.$\n\n- The equation ${x}^{2}+x+1=0$ has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & ={1}^{2}-4(1)(1) \\\\  & =1-4 \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the only vertical asymptote is $x=0.$"}] [{:db/id 17592186088164 :knowledge-point/_questions [{:db/id 17592186087842 :knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc" :knowledge-point/title "Calculating the Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bf54f4a-6fe0-5828-91b7-9a1f23658966" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x =-2, x = 0, x = 2" :db/id 17592186085639} {:answer/id #uuid "bc557aaf-c556-5e9b-a479-3e86966eca1d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x =-2, x = 2" :db/id 17592186085640} {:answer/id #uuid "25d012a4-e043-5863-a60e-562fbc6d4763" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x =-2, x = 1" :db/id 17592186085641} {:answer/id #uuid "49ed6d3a-0c88-59f1-bad1-a0f0e26881dd" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text}