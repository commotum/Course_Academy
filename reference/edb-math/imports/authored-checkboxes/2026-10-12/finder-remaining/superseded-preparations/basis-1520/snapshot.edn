59" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id 17592186346024} :answer-field/id #uuid "e8ede0ea-63a7-5cb0-bb81-4c437869eaec" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186348010}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90dc5317-bc84-5136-bb1e-99a7e0621f24" :question/math-academy-id "q-80679" :question/problem "Calculate the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}-4x+5}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n{x}^{2}-4x+5=0.\n$$\n\nNote that the above equation has no real solutions because the discriminant $D$ is negative:\n\n$$\n\\begin{aligned}D & ={b}^{2}-4ac \\\\  & =(-4{)}^{2}-4(1)(5) \\\\  & =16-20 \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, $y=f(x)$ has no vertical asymptotes."}] [{:db/id 17592186088386 :knowledge-point/_questions [{:db/id 17592186087843 :knowledge-point/id #uuid "53b26ee4-53af-5660-a9e6-8e5cca8b3e1d" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors in the Numerator and Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814507ea-f563-57c6-ba16-848a48a57db7" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "x = 0, x = 2" :db/id 17592186086970} {:answer/id #uuid "c35dd378-61e0-57d2-bf30-b547652ac1a7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id 17592186086971} {:answer/id #uuid "ee2ef318-0c0f-5ce1-9057-c9cd4b80dfee" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text}