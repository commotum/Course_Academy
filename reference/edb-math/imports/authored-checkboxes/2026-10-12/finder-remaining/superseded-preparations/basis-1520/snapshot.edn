592186045493 :db/ident :answer-field.type/radio} :db/id 17592186127669}] :question/id #uuid "01c0cb00-762a-57c6-9d3d-dec1ec64cc03" :question/math-academy-id "q-38762" :question/problem "![](images/dc/dc2079e479351c8d0193961138aeb4dabd4689426c3e621668f314eb8445258f.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n1. $x = 2$ is a root of even multiplicity.\n2. $x = ± 1$ are roots of odd multiplicity.\n3. $p(0) = 2$."}] [{:db/id 17592186129699 :knowledge-point/_questions [{:db/id 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bde80d-60c8-5129-bc87-c431ecd90827" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186127676} {:answer/id #uuid "21416783-38b1-5c9b-9cfa-e1bf9228974e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186127677} {:answer/id #uuid "3a33f051-ef04-53d4-bf8b-3fd363c42477" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186127678} {:answer/id #uuid "40cc0720-8cd9-539c-a50a-bf0d390a31d3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186127679} {:answer/id #uuid "77f502df-21f7-5725-a5a3-d334d8cae545" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186127680}] :answer-field/id #uuid "bf141a9e-981c-564b-a7b0-d13f177fecd0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186127675}] :question/id #uuid "6659c5a9-8cd4-5728-b7f7-08c5ba5aeadd" :question/math-academy-id "q-38768" :question/problem "![](images/4b/4b91ee95f42770036434909f2bb62102120f85f464e548a0142a603164a41b32.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n1. $x = 0$ is a root of even multiplicity.\n2. $x =-1$ and $x = 2$ are roots of even multiplicity.\n3. $p(x) → ∞$ as $x → ∞$."}] [{:db/id 17592186134061 :knowledge-point/_questions [{:db/id 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a764f49-9edb-5020-9a41-bf5dac3e103e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186130523} {:answer/id #uuid "9d6d6769-d8ff-5808-9fdc-2c6a3c27f2ce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186130524} {:answer/id #uuid "e1924edf-bb90-519c-ad15-dc5c4909ac55" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id 17592186130525} {:answer/id #uuid "080a320c-3361-5001-ab96-5c073de14d26" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id 17592186130526} {:answer/id #uuid "1145c273-7eaa-577b-8a14-75a420c86885" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186130527}] :answer-field/id #uuid "39063289-e948-5c53-bc32-a9e7fa1b008c" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130522} {:answer-field/choices [{:answer/id #uuid "4af00ead-cb31-51e6-9f21-869070b74a3b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id 17592186382717} {:answer/id #uuid "5e82f46c-d873-514d-bfa9-fcd50b8798f7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382718} {:answer/id #uuid "57566773-e704-586b-bc5c-d48eca074e5b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III and IV only" :db/id 17592186382719} {:answer/id #uuid "b43f392a-de66-542d-85c1-a5e456a297d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382720} {:answer/id #uuid "a163be0a-2b14-51bd-a9a8-1d4a4207b41d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382721}] :answer-field/correct {:answer/id #uuid "b43f392a-de66-542d-85c1-a5e456a297d9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382720} :answer-field/id #uuid "2bcce67f-0a6c-5ff1-abd8-5204a040f9e5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382716}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d82a128a-970f-55e8-b4ad-4c3c16a14935" :question/math-academy-id "q-105075" :question/problem "![](images/34/3411e11060b06a11c82ad677f50731faa31c6bc2e83ccb0d0d10931cf3d76592.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $∇\\cdot F>0$ at $P,$ then $F$ acts like a source at $P.$\n\n- If $∇\\cdot F<0$ at $P,$ then $F$ acts like a sink at $P.$\n\n- If $∇\\cdot F=0$ at $P,$ then $F$ acts like neither a source nor a sink at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement III is true, whereas statements I and II are false. Notice that the lengths of the vectors decrease as we move in the $y$-direction. Therefore, the vector field $F$ acts like a sink at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186134063 :knowledge-point/_questions [{:db/id 17592186133881 :knowledge-point/id #uuid "d42243ea-58fc-53f6-a0b6-f995bf1d697c" :knowledge-point/title "Interpreting the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "984afe37-2fa9-58b4-8e69-c02e0263af15" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "IV only" :db/id 17592186130535} {:answer/id #uuid "a6e142d6-154b-55cc-8a86-91ca44984e86" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id 17592186130536} {:answer/id #uuid "c0149d09-0041-507b-9723-b5bde29dd903" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186130537} {:answer/id #uuid "d9c124d7-8cc0-57ff-98f6-d85fe98a935e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186130538} {:answer/id #uuid "22ab8d9e-65f2-5914-bcca-b8904b2ff74e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186130539}] :answer-field/id #uuid "8058c5ae-a794-5103-96a5-0833641fcaa5" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130534}] :question/id #uuid "4556fe88-939e-5892-9221-116e661c0c0b" :question/math-academy-id "q-105103" :question/problem "![](images/04/04c6eb44298b639520994f01ef505ff40eba58307a1a40e7a48dfb0ebaae5d7e.png)\n\nConsider the vector field $F(x, y, z)$, shown above. Given that $F(x, y, z)$ is independent of $z$, which of the following statements are true?\n\n1. $curlF = 0$\n2. $curlF \\ne 0$\n3. $curlF$ points in the negative $z$-direction.\n4. $F$ is irrotational"}] [{:db/id 17592186134067 :knowledge-point/_questions [{:db/id 17592186133880 :knowledge-point/id #uuid "4f47e201-105a-579a-8cde-fcb6bf8cfa2a" :knowledge-point/title "Interpreting Divergence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "869bd612-bbbc-56b2-9d4d-f34bcb0e9062" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186130559} {:answer/id #uuid "ef2bd30f-e9a9-5da5-b0ba-7117ab7d4fec" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id 17592186130560} {:answer/id #uuid "1f5a8846-da94-5536-9acc-ee78e8bdaa34" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186130561} {:answer/id #uuid "38261aa3-82a9-5fb1-abe8-0ecc0b4a52c4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id 17592186130562} {:answer/id #uuid "4fddf9c2-de5d-54e2-a6b1-6f255aed1e2d" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186130563}] :answer-field/id #uuid "2e9d4ee0-42ea-53df-aa07-9fe9b51468fb" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130558} {:answer-field/choices [{:answer/id #uuid "5f861ee0-c10a-55b7-b421-ea16180f7604" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id 17592186382821} {:answer/id #uuid "1a3efe9f-6494-50ee-b7d8-97bd8f0b08a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and IV only" :db/id 17592186382822} {:answer/id #uuid "d4611053-0c8f-5196-8404-73c9022f341f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186382823} {:answer/id #uuid "abcf06ba-2db2-5bee-b66a-0d860f76e3ce" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186382824} {:answer/id #uuid "44e3ce89-0fb0-5271-8574-d381668934c8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186382825}] :answer-field/correct {:answer/id #uuid "5f861ee0-c10a-55b7-b421-ea16180f7604" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and IV only" :db/id 17592186382821} :answer-field/id #uuid "221ebaf4-de8e-55b9-8386-ea7500ef7627" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186382820}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0a7d3d7-12b8-5fcb-bcca-49538501dfd6" :question/math-academy-id "q-105571" :question/problem "![](images/86/864ce19530f022e52b7c9513c0cebc64e898f6e71ecf1066ab6aad92d6df40bf.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" :question/worked-solution "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](images/6c/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement I is true, whereas statements II and III are false. For any point $P,$ the sum of the inward-pointing vectors equals the sum of the outward-pointing vectors. Therefore, $F$ acts neither like a source nor a sink.\n\n- Statement IV is true. Since $∇\\cdot F=0$ everywhere, the vector field $F$ is solenoidal.\n\nTherefore, the correct answer is \"I and IV only.\""}] [{:db/id 17592186134092 :knowledge-point/_questions [{:db/id 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99862250-7069-52b8-961c-43b2d6c3e458" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186130709} {:answer/id #uuid "f68109da-5447-5289-9116-b22d249e0b40" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186130710} {:answer/id #uuid "5b193744-a5b0-5a56-a6c4-959a94a39569" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186130711} {:answer/id #uuid "6b57aff0-91a2-5924-b717-b77009c0d3d6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186130712} {:answer/id #uuid "7be44107-414a-5573-bb82-9924ad37ebda" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186130713}] :answer-field/id #uuid "5d17d2d8-9928-5246-af09-a8de679c2edf" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130708} {:answer-field/choices [{:answer/id #uuid "4bbde3ea-51a4-5bb9-b415-15b081645f8b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186369320} {:answer/id #uuid "7503552f-1a3f-5846-a2bb-20c103b29664" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186369321} {:answer/id #uuid "8bb7ee7a-6e0f-5758-a561-9b3915b9f2e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186369322} {:answer/id #uuid "17bae066-3d20-59d8-b46d-cf1882d28b09" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186369323} {:answer/id #uuid "902e9dbe-6cff-5089-8658-727ffe921b4a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186369324}] :answer-field/correct {:answer/id #uuid "8bb7ee7a-6e0f-5758-a561-9b3915b9f2e8" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186369322} :answer-field/id #uuid "633e4ab2-3db4-5baf-9514-75709128a17a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186369319}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d72f3f4-6ff1-53f9-94a6-72b405d3f343" :question/math-academy-id "q-125852" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the functions $P(x,y)$ and $Q(x,y)?$\n\n- $P(x,y)=y$ and $Q(x,y)=-x$\n- $P(x,y)=\\frac{x}{2}+\\operatorname{cos}⁡{y}^{2}$ and $Q(x,y)=\\frac{y}{2}$\n- $P(x,y)=0$ and $Q(x,y)=x$" :question/worked-solution "According to Green's theorem, if \n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Pair I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=1$\nand\n$\\frac{∂Q}{∂x}=-1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=-2\\ne 1.\n$$\n\n- Pair II does *not* give the required area. Notice that\n$\\frac{∂P}{∂y}=-2y\\operatorname{sin}⁡{y}^{2}$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2y\\operatorname{sin}⁡{y}^{2}\\ne 1.\n$$\n\n- Pair III gives the required area. Notice that\n$\\frac{∂P}{∂y}=0$\nand\n$\\frac{∂Q}{∂x}=1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id 17592186134093 :knowledge-point/_questions [{:db/id 17592186133895 :knowledge-point/id #uuid "5f4f726e-d985-5915-a4d0-30cfa6f4b89b" :knowledge-point/title "Identifying Vector Fields That Satisfy the Unit Curl Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "acef05c6-00e1-5592-a1a0-889b8fae112b" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186130715} {:answer/id #uuid "b7bd9e64-696c-51f2-9326-b4dd35e8d309" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186130716} {:answer/id #uuid "033fba2e-49ef-5a43-86ee-97280d5189b6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186130717} {:answer/id #uuid "06170a0b-5016-5c98-abd7-afe22178d627" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186130718} {:answer/id #uuid "4abc258a-2852-54fd-89be-f1ca43962d66" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186130719}] :answer-field/id #uuid "097d24ae-bf47-5570-8b59-107607077491" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186130714} {:answer-field/choices [{:answer/id #uuid "51032152-ac1c-5645-b519-4d9f91f449cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186369326} {:answer/id #uuid "d548dfcc-afb7-5f57-ad90-cfdfdb29a3ba" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186369327} {:answer/id #uuid "0cc64ba0-9932-5ec8-a8c1-902a58b2e272" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186369328} {:answer/id #uuid "8c7ad01a-0f7e-5e8c-8299-0aee289f43aa" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186369329} {:answer/id #uuid "9cfcd43c-0ace-5687-91b7-d1a23321bac2" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186369330}] :answer-field/correct {:answer/id #uuid "51032152-ac1c-5645-b519-4d9f91f449cc" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186369326} :answer-field/id #uuid "07c5c5c2-3396-52cb-9fba-4aead4b7e49a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186369325}] :question/difficulty {:db/id 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0916e138-1ac3-5dc1-b5d3-86d819d37c90" :question/math-academy-id "q-125853" :question/problem "Let $C$ be a simple, piecewise-smooth, closed, and positively oriented curve. Given that the line integral\n\n$$\n{∮}_{C}F\\cdot \\text{d}r\n$$\n\n \nrepresents the area of the region $D$ enclosed by any such curve in ${R}^{2},$ which of the following could be the vector field $F(x,y)?$\n\n- $F(x,y)=⟨-y,\\,{x}^{2}+x⟩$\n- $F(x,y)=⟨-\\frac{y}{4}+x,\\,\\frac{3x}{4}⟩$\n- $F(x,y)=⟨-y,\\,0⟩$" :question/worked-solution "According to Green's theorem, if $F(x,y)=⟨P(x,y),\\,Q(x,y)⟩,$ where\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1,\n$$\n\nwe can write the area of the region $D$ enclosed by the curve $C$ as follows:\n\n$$\n\\begin{aligned}\\text{Area}(D) & ={∬}_{D}\\text{d}A \\\\  & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A \\\\  & ={∮}_{C}P\\,\\text{d}x+Q\\,\\text{d}y \\\\  & ={∮}_{C}F\\cdot \\text{d}r\\end{aligned}\n$$\n\n  \n\nWith that in mind, let's examine each pair in turn.\n\n- Vector field I does *not* give the required area. In this case, \n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=2x+1,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=2x+2\\ne 1.\n$$\n\n- Vector field II gives the required area. Notice that\n$\\frac{∂P}{∂y}=-\\frac{1}{4}$\nand\n$\\frac{∂Q}{∂x}=\\frac{3}{4},$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\n- Vector field III gives the required area. Notice that\n$\\frac{∂P}{∂y}=-1$\nand\n$\\frac{∂Q}{∂x}=0,$\nwhich gives\n\n$$\n\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}=1.\n$$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id 17592186172639 :knowledge-point/_questions [{:db/id 17592186172041 :knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c71a8e11-3808-53b6-bd23-65fd7fcd5550" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id 17592186171460} {:answer/id #uuid "12866de9-3edc-59a3-b95a-2ccf73d9c19a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id 17592186171461} {:answer/id #uuid "1da14450-0ccc-58cb-baa9-09a9454b2a88" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id 17592186171462} {:answer/id #uuid "2e5c8c2c-9c11-54a7-bc83-0f636d4ad4a4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186171463} {:answer/id #uuid "4f282a0e-df35-5fae-b43f-b6d35465926f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186171464}] :answer-field/id #uuid "8897d65d-b234-5eff-84b6-9ed7672f8