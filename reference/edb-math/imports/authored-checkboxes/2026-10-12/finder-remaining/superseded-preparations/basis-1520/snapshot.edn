 :db/id 17592186122425}] :answer-field/id #uuid "1bdf279b-86e9-5860-aa19-361360e00ba6" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186122420}] :question/id #uuid "fa8c1acf-fd5d-5946-ab8b-13077cafbbf0" :question/math-academy-id "q-36332" :question/problem "At which points on the curve $2xy + 3y^{2} = x^{2} + 4$ is the tangent vector to the curve perpendicular to the vector $j$?"}] [{:db/id 17592186125018 :knowledge-point/_questions [{:db/id 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5ab6900-c8da-56de-b62a-bf3a1d4d10d4" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id 17592186122709} {:answer/id #uuid "e2d89c4b-603f-53ac-a7b7-b89c17fd5c61" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id 17592186122710} {:answer/id #uuid "4693a105-893c-5ac9-9b6c-e651dc075271" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id 17592186122711} {:answer/id #uuid "5e948606-25c1-55c6-9bde-c9158bb85ef6" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id 17592186122712} {:answer/id #uuid "766b5449-7ecc-5a19-ba23-f9f7d5c3156f" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id 17592186122713}] :answer-field/id #uuid "db10059c-5b0b-55c3-9bcf-b1a6071ce31f" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186122708}] :question/id #uuid "4763915f-8f50-5b34-9b27-a90ea817e8a2" :question/math-academy-id "q-36897" :question/problem "![](images/ca/caeed93f57e554d6bf79b8915935261abb39c6fe54cc6d7d349ff60502a96053.png)\n\nWhich of the graphs above correspond to an invertible function?"}] [{:db/id 17592186125023 :knowledge-point/_questions [{:db/id 17592186124445 :knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340" :knowledge-point/title "Finding the Points Where a Gradient Vanishes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a668d31-3cc8-5ea9-96ef-7e0fdcd58b8c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and  $(-1,-1,-1)$" :db/id 17592186321594} {:answer/id #uuid "649040c7-206e-50ab-b58d-af585a9cdb7e" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,-1,1)$ only" :db/id 17592186321929} {:answer/id #uuid "b6c29216-4d6d-58d7-9dc1-49c48b3848a7" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,-1,0)$ only" :db/id 17592186322570} {:answer/id #uuid "eff49e99-8930-5a35-aa82-5e696d691c29" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id 17592186323039} {:answer/id #uuid "ff909540-c4d2-5403-9b36-0186dff131b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,-1,0)$" :db/id 17592186323164}] :answer-field/correct {:answer/id #uuid "ff909540-c4d2-5403-9b36-0186dff131b9" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,-1,0)$" :db/id 17592186323164} :answer-field/id #uuid "4c22ca2c-680a-5b37-a867-786a2de07c36" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186323313}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "adae0b04-7ccf-59da-b863-ae9717fcfd97" :question/math-academy-id "q-36970" :question/problem "Given $h(x,y,z)=xy+x{y}^{2}+{z}^{3}.$ Find the points $(x,y,z)$ where $∇h(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy+x{y}^{2}+{z}^{3}) \\\\  & =y+{y}^{2}+0 \\\\  & =y+{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy+x{y}^{2}+{z}^{3}) \\\\  & =x+2xy+0 \\\\  & =x+2xy \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy+x{y}^{2}+{z}^{3}) \\\\  & =0+0+3{z}^{2} \\\\  & =3{z}^{2}\\end{aligned}\n$$\n\nHence, $∇h(x,y,z)=(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k.$\n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficients of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}y+{y}^{2}=0 \\\\ x+2xy=0 \\\\ 3{z}^{2}=0\\end{aligned}\n$$\n\nThe first equation can be written as $y(1+y)=0$, which gives $y=0$ or $y=-1.$ Substituting these into the second equation, we obtain:\n\n$$\n\\begin{aligned}x+2x(0) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nor,\n\n$$\n\\begin{aligned}x+2x(-1) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nFinally, from the third equation, we get $z=0.$\n\nTherefore, $∇h(x,y,z)=0$ at two points: $(0,0,0)$ and $(0,-1,0).$"}] [{:db/id 17592186125192 :knowledge-point/_questions [{:db/id 17592186124456 :knowledge-point/id #uuid "84245283-3cf9-5889-8c42-896a0c8af291" :knowledge-point/title "Finding the Points on a Curve at which the Tangent Vector is Perpendicular to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9822afda-d1f9-50c7-a4ce-ea8333bde970" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(1,-1)$ only" :db/id 17592186123753} {:answer/id #uuid "d6cc44e4-8095-54f5-8c67-b26a7016d7a3" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 0)$ and $(1,-1)$ only" :db/id 17592186123754} {:answer/id #uuid "df50602a-0fac-52e0-a43b-248da252f93a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "$(0, 0)$ and $(1, 1)$ only" :db/id 17592186123755} {:answer/id #uuid "118a1db3-1d81-586e-807c-5bae6d8c1389" :answer/type {:db/id 175921860