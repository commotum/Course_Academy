#{[:activity/id #uuid "cf8e9ab1-e154-5646-9c62-85ad5ba15518" {:activity/course {:db/id #edb/ref 17592186405206} :activity/due #inst "2026-11-07T07:59:00.000Z" :activity/first-step {:db/id #edb/ref 17592186754858} :activity/id #uuid "cf8e9ab1-e154-5646-9c62-85ad5ba15518" :activity/steps [{:db/id #edb/ref 17592186754852 :step/content {:db/id #edb/ref 17592186754861} :step/id #uuid "82b3e54b-aa41-5700-b4a4-23a3ea6a2bbf"} {:db/id #edb/ref 17592186754853 :step/content {:db/id #edb/ref 17592186754847} :step/id #uuid "b3185485-8d11-57a9-bcef-22a737c481c8" :step/next {:db/id #edb/ref 17592186754854}} {:db/id #edb/ref 17592186754854 :step/content {:db/id #edb/ref 17592186754851} :step/id #uuid "b4da6301-6b5b-5e4b-82b4-e8ab4309116d" :step/next {:db/id #edb/ref 17592186754852}} {:db/id #edb/ref 17592186754858 :step/content {:db/id #edb/ref 17592186754857} :step/id #uuid "c7bc1213-be8b-5ca4-be2c-2dcbe03670a9" :step/next {:db/id #edb/ref 17592186754853}}] :activity/title "MTH 341 — PRQ-12" :activity/type {:db/id #edb/ref 17592186045461} :db/id #edb/ref 17592186754860}] [:step/id #uuid "82b3e54b-aa41-5700-b4a4-23a3ea6a2bbf" {:db/id #edb/ref 17592186754852 :step/content {:db/id #edb/ref 17592186754861} :step/id #uuid "82b3e54b-aa41-5700-b4a4-23a3ea6a2bbf"}] [:step/id #uuid "b3185485-8d11-57a9-bcef-22a737c481c8" {:db/id #edb/ref 17592186754853 :step/content {:db/id #edb/ref 17592186754847} :step/id #uuid "b3185485-8d11-57a9-bcef-22a737c481c8" :step/next {:db/id #edb/ref 17592186754854}}] [:step/id #uuid "b4da6301-6b5b-5e4b-82b4-e8ab4309116d" {:db/id #edb/ref 17592186754854 :step/content {:db/id #edb/ref 17592186754851} :step/id #uuid "b4da6301-6b5b-5e4b-82b4-e8ab4309116d" :step/next {:db/id #edb/ref 17592186754852}}] [:step/id #uuid "c7bc1213-be8b-5ca4-be2c-2dcbe03670a9" {:db/id #edb/ref 17592186754858 :step/content {:db/id #edb/ref 17592186754857} :step/id #uuid "c7bc1213-be8b-5ca4-be2c-2dcbe03670a9" :step/next {:db/id #edb/ref 17592186754853}}] [:tutorial/id #uuid "80321948-ed88-55bf-a660-b28382bb99ae" {:db/id #edb/ref 17592186754851 :tutorial/content "Source item: Canvas unnumbered reminder (question_59459060), between Questions 1 and 2.\n\nWhat does the Rank-Nullity Theorem say?\n\nThis source item has no response field and is retained as an ungraded reading reminder." :tutorial/id #uuid "80321948-ed88-55bf-a660-b28382bb99ae" :tutorial/title "Rank–Nullity Theorem reading reminder"}] [:tutorial/id #uuid "c756e552-73f9-5a12-8a6c-b4ab7dd27d84" {:db/id #edb/ref 17592186754857 :tutorial/content "**MTH 341 — Post-reading Questions: §§5.4 and 5.7**\n\nDue: 2026-11-06\nDue time: 11:59 p.m. PST\nDate imported: 2026-11-06\nSource: [Canvas — Post-reading Questions -Section 5.4 and 5.7](https://canvas.oregonstate.edu/courses/2064363/quizzes/3193303)\n\nStudy answers and explanations are independently authored additions. Canvas lists two response questions and also displays an unnumbered theorem reminder between them; all three source items are preserved below. Study links cover verified component skills; no whole-task equivalent was verified for the existence question or the request to compile five rank characterizations.\n\n## Instructions\n\nAnswer the True/False question and the written question. Review the intervening Rank–Nullity Theorem reminder; it has no response field in Canvas and remains ungraded here. Canvas specifies no time limit." :tutorial/id #uuid "c756e552-73f9-5a12-8a6c-b4ab7dd27d84" :tutorial/title "Assignment information"}] [:question/id #uuid "b6ef7548-a9fc-5fe6-b047-855d8fc3b908" {:db/id #edb/ref 17592186754856 :question/answer-fields [{:answer-field/choices [{:answer/feedback "An explicit example can have the same one-dimensional null space and image." :answer/id #uuid "09586289-8125-5c42-add1-1127cc16a3c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186754846} {:answer/feedback "The null space and image can be equal for a square matrix. Having different definitions does not force them to be different sets." :answer/id #uuid "c861286b-7193-5c88-83fc-c9e7ac5fae4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186754859}] :answer-field/correct {:db/id #edb/ref 17592186754846} :answer-field/id #uuid "218ac6c4-ca74-5efe-840e-433da1955153" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186754848}] :question/id #uuid "b6ef7548-a9fc-5fe6-b047-855d8fc3b908" :question/problem "Source question: Canvas Question 1 (question_59459059).\n\nIt is possible that a matrix $A$ has its null space equal to its image." :question/worked-solution "For example, take\n\n$$A=\\begin{pmatrix}0&1\\\\0&0\\end{pmatrix}.$$\n\nFor any $\\mathbf x=(x,y)^T$, $A\\mathbf x=(y,0)^T$. Thus\n\n$$\\operatorname{Null}(A)=\\{(t,0)^T:t\\in\\mathbb R\\}=\\operatorname{Im}(A).$$\n\nBoth spaces are the horizontal axis. Their dimensions are both $1$, consistent with rank–nullity: $1+1=2$. Equal dimensions alone would not prove that the two spaces are equal; the explicit descriptions above do."}] [:question/id #uuid "3bcae85b-a03e-5f2e-9b8b-b15933141baf" {:db/id #edb/ref 17592186754849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b518536b-d562-5eb7-b488-35119d8edd9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For an $m\\times n$ real matrix $A$, each of the following equals $\\operatorname{rank}(A)$:\n\n1. The dimension of its column space, $\\dim\\operatorname{Col}(A)$.\n2. The dimension of its row space, $\\dim\\operatorname{Row}(A)$.\n3. The dimension of its image as the linear map $\\mathbf x\\mapsto A\\mathbf x$.\n4. The number of pivot columns in a row echelon form of $A$ (equivalently, the number of pivot positions).\n5. The number of nonzero rows in a row echelon form or reduced row echelon form of $A$.\n6. The largest number of linearly independent columns of $A$.\n7. The largest number of linearly independent rows of $A$.\n8. The number of columns minus its nullity: $n-\\dim\\operatorname{Null}(A)$.\n\nAny five distinct valid characterizations satisfy the requested list." :db/id #edb/ref 17592186754855}] :answer-field/correct {:db/id #edb/ref 17592186754855} :answer-field/id #uuid "42cd4b5d-c6a6-50d5-b69f-636330b45fa8" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186754850}] :question/id #uuid "3bcae85b-a03e-5f2e-9b8b-b15933141baf" :question/problem "Source question: Canvas Question 2 (question_59459061).\n\nMake a list of as many different ways you can restate what the rank of a matrix is. (Can you make a list with five different, but equivalent, statements in it?)" :question/worked-solution "A basis of the column space has one original column for each pivot, so its size is both the column-space dimension and the maximum number of independent columns. The row rank equals the column rank, giving the corresponding row-space statements. Nonzero rows of an echelon form have distinct leading positions and form a basis of its row space. The image of $\\mathbf x\\mapsto A\\mathbf x$ is the column space. Finally, rank–nullity gives $\\operatorname{rank}(A)=n-\\operatorname{nullity}(A)$.\n\nCheck that each item names the same number. Count nonzero rows only after row reduction to echelon form; the number of nonzero rows of the original matrix need not equal its rank. In the rank–nullity formula, $n$ is the number of columns, not the number of rows."}] [:answer-field/id #uuid "218ac6c4-ca74-5efe-840e-433da1955153" {:answer-field/choices [{:answer/feedback "An explicit example can have the same one-dimensional null space and image." :answer/id #uuid "09586289-8125-5c42-add1-1127cc16a3c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186754846} {:answer/feedback "The null space and image can be equal for a square matrix. Having different definitions does not force them to be different sets." :answer/id #uuid "c861286b-7193-5c88-83fc-c9e7ac5fae4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186754859}] :answer-field/correct {:db/id #edb/ref 17592186754846} :answer-field/id #uuid "218ac6c4-ca74-5efe-840e-433da1955153" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186754848}] [:answer-field/id #uuid "42cd4b5d-c6a6-50d5-b69f-636330b45fa8" {:answer-field/choices [{:answer/id #uuid "b518536b-d562-5eb7-b488-35119d8edd9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For an $m\\times n$ real matrix $A$, each of the following equals $\\operatorname{rank}(A)$:\n\n1. The dimension of its column space, $\\dim\\operatorname{Col}(A)$.\n2. The dimension of its row space, $\\dim\\operatorname{Row}(A)$.\n3. The dimension of its image as the linear map $\\mathbf x\\mapsto A\\mathbf x$.\n4. The number of pivot columns in a row echelon form of $A$ (equivalently, the number of pivot positions).\n5. The number of nonzero rows in a row echelon form or reduced row echelon form of $A$.\n6. The largest number of linearly independent columns of $A$.\n7. The largest number of linearly independent rows of $A$.\n8. The number of columns minus its nullity: $n-\\dim\\operatorname{Null}(A)$.\n\nAny five distinct valid characterizations satisfy the requested list." :db/id #edb/ref 17592186754855}] :answer-field/correct {:db/id #edb/ref 17592186754855} :answer-field/id #uuid "42cd4b5d-c6a6-50d5-b69f-636330b45fa8" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186754850}] [:answer/id #uuid "b518536b-d562-5eb7-b488-35119d8edd9d" {:answer/id #uuid "b518536b-d562-5eb7-b488-35119d8edd9d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For an $m\\times n$ real matrix $A$, each of the following equals $\\operatorname{rank}(A)$:\n\n1. The dimension of its column space, $\\dim\\operatorname{Col}(A)$.\n2. The dimension of its row space, $\\dim\\operatorname{Row}(A)$.\n3. The dimension of its image as the linear map $\\mathbf x\\mapsto A\\mathbf x$.\n4. The number of pivot columns in a row echelon form of $A$ (equivalently, the number of pivot positions).\n5. The number of nonzero rows in a row echelon form or reduced row echelon form of $A$.\n6. The largest number of linearly independent columns of $A$.\n7. The largest number of linearly independent rows of $A$.\n8. The number of columns minus its nullity: $n-\\dim\\operatorname{Null}(A)$.\n\nAny five distinct valid characterizations satisfy the requested list." :db/id #edb/ref 17592186754855}] [:answer/id #uuid "c861286b-7193-5c88-83fc-c9e7ac5fae4a" {:answer/feedback "The null space and image can be equal for a square matrix. Having different definitions does not force them to be different sets." :answer/id #uuid "c861286b-7193-5c88-83fc-c9e7ac5fae4a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186754859}] [:answer/id #uuid "09586289-8125-5c42-add1-1127cc16a3c4" {:answer/feedback "An explicit example can have the same one-dimensional null space and image." :answer/id #uuid "09586289-8125-5c42-add1-1127cc16a3c4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186754846}] [:assigned-problem/id #uuid "f29c94ec-f698-5664-aaee-693b8225a784" {:assigned-problem/content {:db/id #edb/ref 17592186754849} :assigned-problem/id #uuid "f29c94ec-f698-5664-aaee-693b8225a784" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048218} {:db/id #edb/ref 17592186048978} {:db/id #edb/ref 17592186049539} {:db/id #edb/ref 17592186049881} {:db/id #edb/ref 17592186050028}] :db/id #edb/ref 17592186754861}] [:assigned-problem/id #uuid "1511d511-2004-5a5e-ada0-96a79bd437db" {:assigned-problem/content {:db/id #edb/ref 17592186754856} :assigned-problem/id #uuid "1511d511-2004-5a5e-ada0-96a79bd437db" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048181} {:db/id #edb/ref 17592186049539} {:db