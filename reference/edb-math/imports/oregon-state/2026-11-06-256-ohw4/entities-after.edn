 #uuid "6c6ce76b-7f31-5e78-b0c1-87e3e6bc1554" :step/next {:db/id #edb/ref 17592186754381}}] [:step/id #uuid "7cf6b594-74d7-5dad-8344-b0046b89e3f9" {:db/id #edb/ref 17592186754333 :step/content {:db/id #edb/ref 17592186754375} :step/id #uuid "7cf6b594-74d7-5dad-8344-b0046b89e3f9"}] [:tutorial/id #uuid "5c15895a-5353-5de0-bfa8-6759831e59be" {:db/id #edb/ref 17592186754309 :tutorial/content "**MTH 256 — WeBWorK — WebWork 4**\n\nDue: 2026-11-15\nDue time: 23:59:00 America/Los_Angeles (PST); 2026-11-16T07:59:00Z.\nDate imported: 2026-11-06\nSource: [WebWork 4](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/).\nDeadline source: WeBWorK problem list, verified during import.\n\nStudy answers and explanations are independently authored additions.\n\n## Instructions\n\nThe set contains 18 problems, each worth 1 point, with unlimited attempts. Preserve the assigned numerical variants and all 30 source answer fields. Late work receives 75% credit until the set closes on December 9, 2026 at 11:59 p.m. PST. No rounding instructions are given; the study references use exact values. Problems 1–5 request full equations of the form $y=\\cdots$ in WeBWorK; the study inputs display the fixed $y=$ label and accept its right-hand side. Other slots have their dependent-variable labels supplied. Use each problem’s stated independent variable. Problem 16 explicitly requires undetermined coefficients." :tutorial/id #uuid "5c15895a-5353-5de0-bfa8-6759831e59be" :tutorial/title "Assignment information"}] [:question/id #uuid "808dcba0-1983-52e5-9209-409e7c477a50" {:db/id #edb/ref 17592186754335 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "623a50fc-0fdd-5fcb-8246-2d195ad755ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c_1 e^{x} + c_2 e^{- 10 x}" :db/id #edb/ref 17592186754316}] :answer-field/correct {:db/id #edb/ref 17592186754316} :answer-field/id #uuid "d6d41ef7-8901-5302-aa8d-adc1a1921758" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754386}] :question/id #uuid "808dcba0-1983-52e5-9209-409e7c477a50" :question/problem "Source question: [WeBWorK Problem 1](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/1).\n\nFind the general solution to $y''+9y'-10y=0$. Use $c_1,c_2$ for arbitrary constants and $x$ as the independent variable. In WeBWorK enter the full equation $y=\\cdots$, typing the constants as `c1` and `c2`.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "The characteristic equation is $r^2+9r-10=(r-1)(r+10)=0$. Its distinct roots $1,-10$ give $y=c_1e^x+c_2e^{-10x}$. Each exponential has zero residual when substituted into the ODE."}] [:question/id #uuid "81af096f-f139-5678-8d1a-08b5f73efdea" {:db/id #edb/ref 17592186754336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6836bd5b-536f-551e-ac4f-322037e5fc18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x \\left(\\sin{\\left(3 x \\right)} - \\cos{\\left(3 x \\right)}\\right)}{6}" :db/id #edb/ref 17592186754318}] :answer-field/correct {:db/id #edb/ref 17592186754318} :answer-field/id #uuid "be12e518-361a-5e5d-9c65-af96eebe10f9" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754368}] :question/id #uuid "81af096f-f139-5678-8d1a-08b5f73efdea" :question/problem "Find a particular solution.\n\n$y_p=$ {{solution}}." :question/worked-solution "Because $\\sin(3x),\\cos(3x)$ already solve the homogeneous equation, try $x(A\\cos(3x)+B\\sin(3x))$. Applying $D^2+9$ gives $-6A\\sin(3x)+6B\\cos(3x)$, hence $A=-1/6$, $B=1/6$."}] [:question/id #uuid "8513b2d9-8edb-55f0-bb91-588823487c6a" {:db/id #edb/ref 17592186754337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46cfd86c-586b-5ccd-97e9-0c152a388cc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c_1 \\cos{\\left(3 x \\right)} + c_2 \\sin{\\left(3 x \\right)}" :db/id #edb/ref 17592186754298}] :answer-field/correct {:db/id #edb/ref 17592186754298} :answer-field/id #uuid "d9685506-debb-5dbe-a511-c3e80ae86e0f" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754390}] :question/id #uuid "8513b2d9-8edb-55f0-bb91-588823487c6a" :question/problem "Find the most general solution to the associated homogeneous equation. Use $c_1,c_2$ for arbitrary constants, entered as `c1`, `c2` in WeBWorK.\n\n$y_h=$ {{solution}}." :question/worked-solution "The characteristic roots $\\pm3i$ give $y_h=c_1\\cos(3x)+c_2\\sin(3x)$."}] [:question/id #uuid "976c52f5-881a-5a22-a30d-cfdc1a474e9f" {:db/id #edb/ref 17592186754342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdafc842-fa7a-57e4-9eca-336b4060ec5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(c_1 \\cos{\\left(x \\right)} + c_2 \\sin{\\left(x \\right)}\\right) e^{- 2 x}" :db/id #edb/ref 17592186754367}] :answer-field/correct {:db/id #edb/ref 17592186754367} :answer-field/id #uuid "d4809e54-dabe-5a13-8f44-9208e1a98d28" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754384}] :question/id #uuid "976c52f5-881a-5a22-a30d-cfdc1a474e9f" :question/problem "Find the most general solution to the associated homogeneous equation. Use $c_1,c_2$ for arbitrary constants, entered as `c1`, `c2` in WeBWorK.\n\n$y_h=$ {{solution}}." :question/worked-solution "The characteristic polynomial is $(r+2)^2+1$, so the roots $-2\\pm i$ give $y_h=e^{-2x}(c_1\\cos x+c_2\\sin x)$."}] [:question/id #uuid "97f7abe5-b804-538b-ae3d-2c4906de5a17" {:db/id #edb/ref 17592186754343 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a4845f92-2b84-5593-8542-31b2fe001680" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(c_1 + c_2 x\\right) e^{3 x}" :db/id #edb/ref 17592186754350}] :answer-field/correct {:db/id #edb/ref 17592186754350} :answer-field/id #uuid "d2853a76-9b00-5684-b828-733b7ffa7f60" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754382}] :question/id #uuid "97f7abe5-b804-538b-ae3d-2c4906de5a17" :question/problem "**(a)** Find the general solution. Use $c_1,c_2$ for arbitrary constants and $x$ as the independent variable. In WeBWorK enter the full equation $y=\\cdots$, typing the constants as `c1` and `c2`.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "The characteristic polynomial is $(r-3)^2$. A double root gives two independent solutions $e^{3x}$ and $xe^{3x}$, so $y=(c_1+c_2x)e^{3x}$."}] [:question/id #uuid "9c9a5b26-494a-5659-9be3-9b4a0cbaedd2" {:db/id #edb/ref 17592186754347 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1ddbc66-4ccb-5a7f-995c-3922a93e8d26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 x + \\frac{8}{5} + \\frac{3 e^{- x}}{2}" :db/id #edb/ref 17592186754370}] :answer-field/correct {:db/id #edb/ref 17592186754370} :answer-field/id #uuid "bd42753a-4ad3-5db1-b84e-d6307604bfed" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754366}] :question/id #uuid "9c9a5b26-494a-5659-9be3-9b4a0cbaedd2" :question/problem "Find a particular solution to the nonhomogeneous equation.\n\n$y_p=$ {{solution}}." :question/worked-solution "For the polynomial forcing use $Ax+B$: $5A=-10$, $4A+5B=0$, giving $A=-2$, $B=8/5$. For $3e^{-x}$ use $Ce^{-x}$: $(1-4+5)C=3$, giving $C=3/2$. Add the two particular solutions by linearity."}] [:question/id #uuid "a94e0ac1-d5e8-5cdf-bb48-9b356db96534" {:db/id #edb/ref 17592186754351 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3afc782-bfca-59b8-b58a-6e01c2de464c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 e^{3 t}}{10} - \\frac{3 e^{- \\frac{t}{3}}}{10}" :db/id #edb/ref 17592186754398}] :answer-field/correct {:db/id #edb/ref 17592186754398} :answer-field/id #uuid "eb0dc03b-105f-5388-ac3d-8e73b6aef815" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754404}] :question/id #uuid "a94e0ac1-d5e8-5cdf-bb48-9b356db96534" :question/problem "Find $y_2(t)$ with $y_2(0)=0$ and $y_2'(0)=1$.\n\n$y_2(t)=$ {{solution}}." :question/worked-solution "Use $y=Ae^{3t}+Be^{-t/3}$. The initial conditions give $A+B=0$ and $3A-B/3=1$, so $A=3/10$ and $B=-3/10$."}] [:question/id #uuid "c25b0f5b-f78e-5dbb-9097-b19d9a3fdbcb" {:db/id #edb/ref 17592186754371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0523b4b9-2fbc-5413-b714-e6a5c5fe6223" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{t^{2}}{15} + \\frac{17 t}{25} - \\frac{74}{1125}\\right) e^{3 t}" :db/id #edb/ref 17592186754267}] :answer-field/correct {:db/id #edb/ref 17592186754267} :answer-field/id #uuid "14a4e964-2121-5be9-a38c-6eaf256499c4" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754275}] :question/id #uuid "c25b0f5b-f78e-5dbb-9097-b19d9a3fdbcb" :question/problem "Source question: [WeBWorK Problem 16](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/16).\n\nUse the method of undetermined coefficients to find one solution of $y''+3y'-3y=(-t^2+9t+5)e^{3t}$. The method is to produce a specific solution, not the general solution.\n\n$y(t)=$ {{solution}}." :question/worked-solution "Use the undetermined-coefficients trial $y=e^{3t}(At^2+Bt+C)$. Put $v=At^2+Bt+C$; substitution reduces the left side to $e^{3t}(v''+9v'+15v)$. Matching coefficients gives $15A=-1$, $18A+15B=9$, and $2A+9B+15C=5$. Therefore $A=-1/15$, $B=17/25$, $C=-74/1125$, so $y=e^{3t}(-t^2/15+17t/25-74/1125)$. Direct differentiation verifies the original equation."}] [:question/id #uuid "c537203a-3a2e-5b3f-b901-0a3c361f3090" {:db/id #edb/ref 17592186754372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57e01dd9-c362-58dc-80c2-3f29d35510e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x \\left(\\sin{\\left(3 x \\right)} - \\cos{\\left(3 x \\right)}\\right)}{6} + \\frac{19 \\sin{\\left(3 x \\right)}}{18} + 6 \\cos{\\left(3 x \\right)}" :db/id #edb/ref 17592186754304}] :answer-field/correct {:db/id #edb/ref 17592186754304} :answer-field/id #uuid "c9558970-7b7f-5f74-9c1e-a64d33983864" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754374}] :question/id #uuid "c537203a-3a2e-5b3f-b901-0a3c361f3090" :question/problem "Find the solution to the original nonhomogeneous equation satisfying $y(0)=6$ and $y'(0)=3$.\n\n$y=$ {{solution}}." :question/worked-solution "Using the particular solution $y_p=x(\\sin(3x)-\\cos(3x))/6$, we have $y_p(0)=0$ and $y_p'(0)=-1/6$. For $y=A\\cos(3x)+B\\sin(3x)+y_p$, the conditions give $A=6$ and $3B-1/6=3$, hence $B=19/18$."}] [:question/id #uuid "c9a45dfc-743a-532d-952a-320e6b25755b" {:db/id #edb/ref 17592186754375 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f448108f-b153-5893-8bcf-0f60f4d0dbc9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 x + \\left(c_1 \\cos{\\left(x \\right)} + c_2 \\sin{\\left(x \\right)}\\right) e^{- 2 x} + \\frac{8}{5} + \\frac{3 e^{- x}}{2}" :db/id #edb/ref 17592186754412}] :answer-field/correct {:db/id #edb/ref 17592186754412} :answer-field/id #uuid "497899bf-1b8e-5e82-a1dc-3bcc8b5f561c" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754300}] :question/id #uuid "c9a45dfc-743a-532d-952a-320e6b25755b" :question/problem "Find the most general solution to the original nonhomogeneous equation. Use $c_1,c_2$ for arbitrary constants.\n\n$y=$ {{solution}}." :question/worked-solution "Add a particular solution to the complete homogeneous solution: $y=y_h+y_p$. For the polynomial forcing use $Ax+B$: $5A=-10$, $4A+5B=0$, giving $A=-2$, $B=8/5$. For $3e^{-x}$ use $Ce^{-x}$: $(1-4+5)C=3$, giving $C=3/2$. Add the two particular solutions by linearity. The characteristic polynomial is $(r+2)^2+1$, so the roots $-2\\pm i$ give $y_h=e^{-2x}(c_1\\cos x+c_2\\sin x)$."}] [:question/id #uuid "cdf76ae9-8d62-5e5a-87bb-2dceda51f931" {:db/id #edb/ref 17592186754379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d2c69aa-d0c9-5025-8be2-5e7a6fcf3bf3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{13 \\sin{\\left(\\frac{8 t}{7} \\right)}}{4} + 3 \\cos{\\left(\\frac{8 t}{7} \\right)}\\right) e^{\\frac{3 t}{7}}" :db/id #edb/ref 17592186754348}] :answer-field/correct {:db/id #edb/ref 17592186754348} :answer-field/id #uuid "466a0d97-53c4-5e1e-9fb5-b57acf122269" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754297}] :question/id #uuid "cdf76ae9-8d62-5e5a-87bb-2dceda51f931" :question/problem "Source question: [WeBWorK Problem 7](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/7).\n\nFind $y(t)$ satisfying $49y''-42y'+73y=0$, $y(0)=3$, and $y'(0)=5$.\n\n$y(t)=$ {{solution}}." :question/worked-solution "The characteristic roots are $(3\\pm8i)/7$. Write $y=e^{3t/7}(A\\cos(8t/7)+B\\sin(8t/7))$. Then $A=3$ and $(3A+8B)/7=5$, giving $B=13/4$. These constants satisfy both initial conditions."}] [:question/id #uuid "d9256045-2740-5c25-a7df-a01b54fa39c4" {:db/id #edb/ref 17592186754388 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00b869fd-0786-5db2-9b0d-3a77203f88db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c_1 + c_2 e^{- 7 x}" :db/id #edb/ref 17592186754264}] :answer-field/correct {:db/id #edb/ref 17592186754264} :answer-field/id #uuid "721c16ba-f90d-5eaf-a439-8b774f83341c" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754325}] :question/id #uuid "d9256045-2740-5c25-a7df-a01b54fa39c4" :question/problem "**(a)** Find the general solution. Use $c_1,c_2$ for arbitrary constants and $x$ as the independent variable. In WeBWorK enter the full equation $y=\\cdots$, typing the constants as `c1` and `c2`.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "The characteristic equation is $r(r+7)=0$. The root $0$ contributes the constant solution $e^{0x}=1$; the other root contributes $e^{-7x}$."}] [:question/id #uuid "dc448596-9744-57e6-90a4-9cbde7827d8f" {:db/id #edb/ref 17592186754391 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a01456b-f5ea-5c6d-9c36-5388c6cbf969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 t^{2} - 18 t - \\frac{e^{3 t}}{14} + 66" :db/id #edb/ref 17592186754290}] :answer-field/correct {:db/id #edb/ref 17592186754290} :answer-field/id #uuid "6326d70d-acfd-5041-bbab-03590268f54b" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754317}] :question/id #uuid "dc448596-9744-57e6-90a4-9cbde7827d8f" :question/problem "Source question: [WeBWorK Problem 18](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/18).\n\nFind a particular solution to $6y''+5y'+y=2t^2+2t-5e^{3t}$.\n\n$y_p(t)=$ {{solution}}." :question/worked-solution "Use $y_p=At^2+Bt+C+De^{3t}$. Polynomial coefficients give $A=2$, $10A+B=2$, and $12A+5B+C=0$, hence $B=-18$, $C=66$. The exponential coefficient gives $(54+15+1)D=-5$, so $D=-1/14$. Adding these terms produces the required forcing by linearity."}] [:question/id #uuid "e0d20620-89eb-5704-a32f-fb2d1d0136ec" {:db/id #edb/ref 17592186754393 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c7874f8-3ba9-5832-a636-0e4a17148bf9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sin{\\left(3 t \\right)} - 4 \\cos{\\left(3 t \\right)} + 6 + e^{- 3 t}" :db/id #edb/ref 17592186754283}] :answer-field/correct {:db/id #edb/ref 17592186754283} :answer-field/id #uuid "e6035ce3-162b-5f15-80ac-5813d55a5ce9" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754400}] :question/id #uuid "e0d20620-89eb-5704-a32f-fb2d1d0136ec" :question/problem "Source question: [WeBWorK Problem 14](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/14).\n\nFind $y(t)$ satisfying $y''+3y'=18\\sin(3t)+54\\cos(3t)$, $y(0)=3$, and $y'(0)=3$.\n\n$y(t)=$ {{solution}}." :question/worked-solution "The homogeneous solution is $A+Be^{-3t}$. For $y_p=C\\cos(3t)+D\\sin(3t)$, matching cosine and sine coefficients gives $-9C+9D=54$ and $-9C-9D=18$, hence $C=-4$, $D=2$. Then $A+B-4=3$ and $-3B+6=3$, giving $B=1$ and $A=6$."}] [:question/id #uuid "e5a9ed0f-95a6-5a9a-a472-343b2f52b9d6" {:db/id #edb/ref 17592186754399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7536c0ef-25cd-5849-8539-7b1bb563af0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2} e^{4 x}}{2} + \\left(c_1 + c_2 x\\right) e^{4 x}" :db/id #edb/ref 17592186754326}] :answer-field/correct {:db/id #edb/ref 17592186754326} :answer-field/id #uuid "867cb335-7195-57c7-bfcf-86fc65717e5f" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754338}] :question/id #uuid "e5a9ed0f-95a6-5a9a-a472-343b2f52b9d6" :question/problem "Find the most general solution to the original nonhomogeneous equation. Use $c_1,c_2$ for arbitrary constants.\n\n$y=$ {{solution}}." :question/worked-solution "Add a particular solution to the complete homogeneous solution: $y=y_h+y_p$. The homogeneous root $4$ has multiplicity two, so try $y_p=Ax^2e^{4x}$. Since $(D-4)^2(e^{4x}u)=e^{4x}u''$, substitution gives $2Ae^{4x}=e^{4x}$ and $A=1/2$. The characteristic polynomial is $(r-4)^2$, so $y_h=(c_1+c_2x)e^{4x}$."}] [:question/id #uuid "eb309376-4836-5217-b757-f8ab890b29f3" {:db/id #edb/ref 17592186754405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5d24af-a89b-519a-aedb-3d7f9a0e26e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- 37 t - 3\\right) e^{t} + 7 e^{7 t}" :db/id #edb/ref 17592186754270}] :answer-field/correct {:db/id #edb/ref 17592186754270} :answer-field/id #uuid "ccf117f5-2ab5-5e13-be87-d21518228e9b" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754377}] :question/id #uuid "eb309376-4836-5217-b757-f8ab890b29f3" :question/problem "Source question: [WeBWorK Problem 12](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/12).\n\nFind $y(t)$ satisfying $y''-2y'+y=252e^{7t}$, $y(0)=4$, and $y'(0)=9$.\n\n$y(t)=$ {{solution}}." :question/worked-solution "The homogeneous solution is $(A+Bt)e^t$. Trying $Ce^{7t}$ gives $(49-14+1)C=252$, so $C=7$. From $A+7=4$ get $A=-3$; from $A+B+49=9$ get $B=-37$. Substitution checks the forcing and the two initial conditions."}] [:question/id #uuid "ee194d6c-d21a-5cb4-a14d-555dcea2e811" {:db/id #edb/ref 17592186754409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e60b888-e3e4-5efa-960e-d0f74c9f40bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{\\frac{8 t}{3}}" :db/id #edb/ref 17592186754285}] :answer-field/correct {:db/id #edb/ref 17592186754285} :answer-field/id #uuid "118b0aee-d5ec-5adf-80eb-2e7f517442af" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754271}] :question/id #uuid "ee194d6c-d21a-5cb4-a14d-555dcea2e811" :question/problem "Find $W(t)=W(y_1,y_2)$.\n\n$W(t)=$ {{solution}}." :question/worked-solution "Directly, $y_1'=3(e^{3t}-e^{-t/3})/10$ and $y_2'=(9e^{3t}+e^{-t/3})/10$. Thus $W=y_1y_2'-y_1'y_2=e^{3t}e^{-t/3}=e^{8t/3}$. For an independent check, normalize the ODE to $y''-(8/3)y'-y=0$. Abel's identity gives $W=Ce^{8t/3}$, and the initial data give $W(0)=1$, hence $C=1$. The Wronskian is nonzero for all real $t$."}] [:question/id #uuid "fe908f08-b7f2-5e31-9b30-0c1eedcc2e63" {:db/id #edb/ref 17592186754417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7aa6850b-c32f-53c3-a89f-525bd4dfe8e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{7} - \\frac{e^{- 7 x}}{7}" :db/id #edb/ref 17592186754332}] :answer-field/correct {:db/id #edb/ref 17592186754332} :answer-field/id #uuid "f1f2e346-177c-56e2-a7b6-7ca3cd89256f" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754410}] :question/id #uuid "fe908f08-b7f2-5e31-9b30-0c1eedcc2e63" :question/problem "**(b)** Find the particular solution satisfying $y(0)=1$ and $y'(0)=1$.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "Write $y=A+Be^{-7x}$. The derivative condition gives $-7B=1$, so $B=-1/7$. Then $A+B=1$ gives $A=8/7$."}] [:question/id #uuid "1a1759e3-55a6-5b0f-b89a-c17c7819256e" {:db/id #edb/ref 17592186754276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d163bd3-b2f7-5b61-8476-8f8409b2100c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c_1 e^{2 x} + c_2 e^{- 10 x} + \\frac{e^{4 x}}{28}" :db/id #edb/ref 17592186754341}] :answer-field/correct {:db/id #edb/ref 17592186754341} :answer-field/id #uuid "cd848886-6725-5cab-83fb-5b8546ef8ef1" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754378}] :question/id #uuid "1a1759e3-55a6-5b0f-b89a-c17c7819256e" :question/problem "Find the most general solution to the original nonhomogeneous equation. Use $c_1,c_2$ for arbitrary constants.\n\n$y=$ {{solution}}." :question/worked-solution "Add a particular solution to the complete homogeneous solution: $y=y_h+y_p$. Try $y_p=Ae^{4x}$. Substitution gives $(16+32-20)A=1$, so $A=1/28$. The characteristic equation is $r^2+8r-20=(r-2)(r+10)=0$, so $y_h=c_1e^{2x}+c_2e^{-10x}$."}] [:question/id #uuid "27e1f65c-abfa-5ba9-a741-a35db6166e92" {:db/id #edb/ref 17592186754282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32eba9fe-7574-5612-a1e2-9375163639a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{4 x}}{28}" :db/id #edb/ref 17592186754287}] :answer-field/correct {:db/id #edb/ref 17592186754287} :answer-field/id #uuid "714ecffd-bcc2-5d63-b285-1448953b10cb" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754323}] :question/id #uuid "27e1f65c-abfa-5ba9-a741-a35db6166e92" :question/problem "Find a particular solution to the nonhomogeneous equation.\n\n$y_p=$ {{solution}}." :question/worked-solution "Try $y_p=Ae^{4x}$. Substitution gives $(16+32-20)A=1$, so $A=1/28$."}] [:question/id #uuid "387cde60-2e38-5ca8-95e4-ae8ebaeb094f" {:db/id #edb/ref 17592186754288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6066c31c-f729-557c-84be-5830c3ca5a3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(c_1 \\cos{\\left(5 x \\right)} + c_2 \\sin{\\left(5 x \\right)}\\right) e^{- 2 x}" :db/id #edb/ref 17592186754314}] :answer-field/correct {:db/id #edb/ref 17592186754314} :answer-field/id #uuid "a369b6ed-cd86-55cf-b438-63ec81ddfc3c" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754349}] :question/id #uuid "387cde60-2e38-5ca8-95e4-ae8ebaeb094f" :question/problem "Source question: [WeBWorK Problem 5](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/5).\n\nFind the general solution to $y''+4y'+29y=0$. Use $c_1,c_2$ for arbitrary constants and $x$ as the independent variable. In WeBWorK enter the full equation $y=\\cdots$, typing the constants as `c1` and `c2`.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "The characteristic equation is $(r+2)^2+25=0$, with roots $-2\\pm5i$. The real part gives the factor $e^{-2x}$ and the imaginary part gives frequency $5$."}] [:question/id #uuid "3af1dc16-4f0d-5d5d-831e-6bfe33a49690" {:db/id #edb/ref 17592186754291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceb954b9-1b1a-55b6-91e6-b910c1e2e3b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2} e^{4 x}}{2}" :db/id #edb/ref 17592186754380}] :answer-field/correct {:db/id #edb/ref 17592186754380} :answer-field/id #uuid "1441c2ef-7bba-5b96-9039-fa1e5a867f7a" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754274}] :question/id #uuid "3af1dc16-4f0d-5d5d-831e-6bfe33a49690" :question/problem "Find a particular solution to the nonhomogeneous equation.\n\n$y_p=$ {{solution}}." :question/worked-solution "The homogeneous root $4$ has multiplicity two, so try $y_p=Ax^2e^{4x}$. Since $(D-4)^2(e^{4x}u)=e^{4x}u''$, substitution gives $2Ae^{4x}=e^{4x}$ and $A=1/2$."}] [:question/id #uuid "3b8205f1-49f5-5f5b-8233-53329f239bfe" {:db/id #edb/ref 17592186754292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e06cad81-48b3-5df8-a15d-a1fb868197ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c_1 \\cos{\\left(5 x \\right)} + c_2 \\sin{\\left(5 x \\right)}" :db/id #edb/ref 17592186754392}] :answer-field/correct {:db/id #edb/ref 17592186754392} :answer-field/id #uuid "b7ee7b6a-d428-5366-b606-7d43663618fe" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754363}] :question/id #uuid "3b8205f1-49f5-5f5b-8233-53329f239bfe" :question/problem "Source question: [WeBWorK Problem 4](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/4).\n\nFind the general solution to $3y''+75y=0$. Use $c_1,c_2$ for arbitrary constants and $x$ as the independent variable. In WeBWorK enter the full equation $y=\\cdots$, typing the constants as `c1` and `c2`.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "Dividing by $3$ gives $y''+25y=0$. The roots $r=\\pm5i$ yield the real solution $y=c_1\\cos(5x)+c_2\\sin(5x)$; differentiating twice multiplies either term by $-25$."}] [:question/id #uuid "414d7403-ea18-5cc2-87f3-adf188eab803" {:db/id #edb/ref 17592186754295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aa46a27-5a0e-5703-a3d7-95c8da649681" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 t \\cos{\\left(6 t \\right)}" :db/id #edb/ref 17592186754339}] :answer-field/correct {:db/id #edb/ref 17592186754339} :answer-field/id #uuid "f845bbe2-7db1-521a-adf9-435ad7b760a7" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754413}] :question/id #uuid "414d7403-ea18-5cc2-87f3-adf188eab803" :question/problem "Source question: [WeBWorK Problem 15](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/15).\n\nFind a particular solution to $y''+36y=-24\\sin(6t)$.\n\n$y_p(t)=$ {{solution}}." :question/worked-solution "The forcing is resonant with the homogeneous sine/cosine solutions. Since $(D^2+36)[t\\cos(6t)]=-12\\sin(6t)$, multiplying by $2$ gives the required forcing $-24\\sin(6t)$."}] [:question/id #uuid "432c2c08-fc74-55c7-9b98-0f9bde352c13" {:db/id #edb/ref 17592186754296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3906dc48-445c-532c-8255-0ece34f75790" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{3 t}}{10} + \\frac{9 e^{- \\frac{t}{3}}}{10}" :db/id #edb/ref 17592186754289}] :answer-field/correct {:db/id #edb/ref 17592186754289} :answer-field/id #uuid "fed108d9-20df-5f77-b47d-c624d38cc784" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754418}] :question/id #uuid "432c2c08-fc74-55c7-9b98-0f9bde352c13" :question/problem "Find $y_1(t)$ with $y_1(0)=1$ and $y_1'(0)=0$.\n\n$y_1(t)=$ {{solution}}." :question/worked-solution "The characteristic equation $9r^2-24r-9=3(3r+1)(r-3)=0$ gives $y=Ae^{3t}+Be^{-t/3}$. The conditions give $A+B=1$ and $3A-B/3=0$, so $A=1/10$ and $B=9/10$."}] [:question/id #uuid "4daafb38-eca9-5620-828f-b784862c1416" {:db/id #edb/ref 17592186754301 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b138349-bf4e-549f-b224-4052e70217f0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "c_1 e^{2 x} + c_2 e^{- 10 x}" :db/id #edb/ref 17592186754346}] :answer-field/correct {:db/id #edb/ref 17592186754346} :answer-field/id #uuid "5b6607b7-2ecf-5e1b-949d-e17d362faffd" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754308}] :question/id #uuid "4daafb38-eca9-5620-828f-b784862c1416" :question/problem "Find the most general solution to the associated homogeneous equation. Use $c_1,c_2$ for arbitrary constants, entered as `c1`, `c2` in WeBWorK.\n\n$y_h=$ {{solution}}." :question/worked-solution "The characteristic equation is $r^2+8r-20=(r-2)(r+10)=0$, so $y_h=c_1e^{2x}+c_2e^{-10x}$."}] [:question/id #uuid "597d8cec-36c5-50dc-aa91-a26d4436f849" {:db/id #edb/ref 17592186754307 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe6db1aa-8a90-5db3-8452-01c3d48ee93e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(c_1 + c_2 x\\right) e^{4 x}" :db/id #edb/ref 17592186754416}] :answer-field/correct {:db/id #edb/ref 17592186754416} :answer-field/id #uuid "a96ccd7c-c623-5c23-bc40-1ad68895a2fd" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754352}] :question/id #uuid "597d8cec-36c5-50dc-aa91-a26d4436f849" :question/problem "Find the most general solution to the associated homogeneous equation. Use $c_1,c_2$ for arbitrary constants, entered as `c1`, `c2` in WeBWorK.\n\n$y_h=$ {{solution}}." :question/worked-solution "The characteristic polynomial is $(r-4)^2$, so $y_h=(c_1+c_2x)e^{4x}$."}] [:question/id #uuid "620c8a43-e919-52fc-8aa0-1bbc270dd594" {:db/id #edb/ref 17592186754315 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ee69056-7886-52cd-a402-1c8bb054f1a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{- 17 \\log{\\left(x \\right)} - 6}{x^{3}}" :db/id #edb/ref 17592186754293}] :answer-field/correct {:db/id #edb/ref 17592186754293} :answer-field/id #uuid "5477d5f7-7968-51c0-8d6d-8ce160d06800" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754302}] :question/id #uuid "620c8a43-e919-52fc-8aa0-1bbc270dd594" :question/problem "Source question: [WeBWorK Problem 9](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/9).\n\nFind $y(x)$ satisfying $x^2y''+7xy'+9y=0$, $y(1)=-6$, and $y'(1)=1$.\n\n$y(x)=$ {{solution}}." :question/worked-solution "The indicial equation is $r(r-1)+7r+9=(r+3)^2=0$. Thus $y=x^{-3}(A+B\\ln x)$ on $x>0$. The value condition gives $A=-6$; the derivative at $1$ is $-3A+B=1$, giving $B=-17$. The interval $x>0$ contains the initial point and avoids the singular point $0$."}] [:question/id #uuid "7628824f-381b-584a-ad74-c603fca83c01" {:db/id #edb/ref 17592186754327 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccd5fb62-a481-57b6-bbc4-de0525339c5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{33 x^{3}}{5} - \\frac{12}{5 x^{7}}" :db/id #edb/ref 17592186754376}] :answer-field/correct {:db/id #edb/ref 17592186754376} :answer-field/id #uuid "fb068b1f-c522-5d19-bc64-756037577628" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754415}] :question/id #uuid "7628824f-381b-584a-ad74-c603fca83c01" :question/problem "Source question: [WeBWorK Problem 8](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_4/8).\n\nFind $y(x)$ satisfying $x^2y''+5xy'-21y=0$, $y(1)=-9$, and $y'(1)=-3$.\n\n$y(x)=$ {{solution}}." :question/worked-solution "Use $y=x^r$. The indicial equation is $r(r-1)+5r-21=(r-3)(r+7)=0$, so $y=Ax^3+Bx^{-7}$. The conditions give $A+B=-9$ and $3A-7B=-3$, hence $A=-33/5$, $B=-12/5$. The maximal nonsingular interval containing $x=1$ is $x>0$."}] [:question/id #uuid "76808fe3-9935-5a8a-bfbf-9fdbb174d575" {:db/id #edb/ref 17592186754328 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07af28f2-77e5-5f38-abfc-63338cda2e62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(5 - 15 x\\right) e^{3 x}" :db/id #edb/ref 17592186754268}] :answer-field/correct {:db/id #edb/ref 17592186754268} :answer-field/id #uuid "e9d20b33-0a1f-5753-b09c-71158d36a1b4" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754403}] :question/id #uuid "76808fe3-9935-5a8a-bfbf-9fdbb174d575" :question/problem "**(b)** Find the solution satisfying $y(0)=5$ and $y'(0)=0$.\n\nEquation: $y=$ {{solution}}." :question/worked-solution "Using $y=(A+Bx)e^{3x}$, $y(0)=A=5$. Differentiation gives $y'(0)=B+3A=0$, hence $B=-15$. The resulting solution satisfies both initial conditions."}] [:answer-field/id #uuid "867cb335-7195-57c7-bfcf-86fc65717e5f" {:answer-field/choices [{:answer/id #uuid "7536c0ef-25cd-5849-8539-7b1bb563af0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{x^{2} e^{4 x}}{2} + \\left(c_1 + c_2 x\\right) e^{4 x}" :db/id #edb/ref 17592186754326}] :answer-field/correct {:db/id #edb/ref 17592186754326} :answer-field/id #uuid "867cb335-7195-57c7-bfcf-86fc65717e5f" :answer-field/key "solution" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186754338}] [:answer-field/id #uuid "a369b6ed-cd86-55cf-b438-63ec81ddfc3c" {:answer-field/choices [{:answer/id #uuid "6066c31c-f729-557c-84be-5830c3ca5a3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(c_1 \\cos{\\left(5 x \\right)} + c_2 \\sin{\\left(5 x \\right)}\\right) e^{- 2 x}" :db/id #edb/ref 17592186754314}] :answer-field/correct {:db/id #edb/ref 17592186754314} :answer-field/id #uuid "a369b6ed-cd86-55cf-b438-63ec81ddfc3c" :answer-field/key "solution" :answer-field/type {:db