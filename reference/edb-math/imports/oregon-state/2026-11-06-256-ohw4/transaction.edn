 {:db/id "432c2c08-fc74-55c7-9b98-0f9bde352c13"
  :question/id #uuid "432c2c08-fc74-55c7-9b98-0f9bde352c13"
  :question/problem "Find $y_1(t)$ with $y_1(0)=1$ and $y_1'(0)=0$.\n\n$y_1(t)=$ {{solution}}."
  :question/answer-fields ["fed108d9-20df-5f77-b47d-c624d38cc784"]
  :question/worked-solution "The characteristic equation $9r^2-24r-9=3(3r+1)(r-3)=0$ gives $y=Ae^{3t}+Be^{-t/3}$. The conditions give $A+B=1$ and $3A-B/3=0$, so $A=1/10$ and $B=9/10$."
  :db/ensure :question/validate}
