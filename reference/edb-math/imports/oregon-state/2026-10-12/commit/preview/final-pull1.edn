92186408167} :db/id #edb/ref 17592186484670}] [[:question/id #uuid "83d4198c-0d1e-5b61-8196-45db5101e7f8"] {:db/id #edb/ref 17592186484526 :question/answer-fields [{:db/id #edb/ref 17592186484670}] :question/id #uuid "83d4198c-0d1e-5b61-8196-45db5101e7f8" :question/problem "**(b)** Find $3B-A$ if possible; otherwise explain why it is not defined.\n\nWritten response: {{response}}" :question/worked-solution "Not defined. $3B$ is $2\\times3$ but $A$ is $3\\times2$. Subtraction requires equal dimensions."}] [[:answer/id #uuid "1569ef33-3895-5461-a6f8-ec42ee06a0ec"] {:answer/id #uuid "1569ef33-3895-5461-a6f8-ec42ee06a0ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}11 & 2 \\\\ 13 & 6 \\\\ -4 & 2\\end{bmatrix}" :db/id #edb/ref 17592186484637}] [[:answer-field/id #uuid "5d94509c-9d25-510c-97b0-b32bc629210d"] {:answer-field/choices [{:db/id #edb/ref 17592186484637}] :answer-field/correct {:db/id #edb/ref 17592186484637} :answer-field/id #uuid "5d94509c-9d25-510c-97b0-b32bc629210d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186484675}] [[:question/id #uuid "eba81b68-b9ad-594b-9e15-348f94b00f73"] {:db/id #edb/ref 17592186484607 :question/answer-fields [{:db/id #edb/ref 17592186484675}] :question/id #uuid "eba81b68-b9ad-594b-9e15-348f94b00f73" :question/problem "**(c)** Find $AC$. Show the calculation.\n\nAnswer: {{answer}}." :question/worked-solution "The product is defined since $(3\\times2)(2\\times2)$ has matching inner dimensions. Take each row of A dotted with each column of C."}] [[:answer/id #uuid "902407a2-8c86-569b-94a9-ca606406ba7f"] {:answer/id #uuid "902407a2-8c86-569b-94a9-ca606406ba7f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not defined. The inner dimensions of $(2\\times2)(3\\times2)$ are 2 and 3, so the product is undefined." :db/id #edb/ref 17592186484703}] [[:answer-field/id #uuid "da0461a2-5a5d-5245-8843-b479b9714ffc"] {:answer-field/choices [{:db/id #edb/ref 17592186484703}] :answer-field/correct {:db/id #edb/ref 17592186484703} :answer-field/id #uuid "da0461a2-5a5d-5245-8843-b479b9714ffc" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484744}] [[:question/id #uuid "5fe31ef3-b496-53fb-b5d2-fe3553f1eb3d"] {:db/id #edb/ref 17592186484500 :question/answer-fields [{:db/id #edb/ref 17592186484744}] :question/id #uuid "5fe31ef3-b496-53fb-b5d2-fe3553f1eb3d" :question/problem "**(d)** Find $CA$ if possible; otherwise explain why it is not defined.\n\nWritten response: {{response}}" :question/worked-solution "Not defined. The inner dimensions of $(2\\times2)(3\\times2)$ are 2 and 3, so the product is undefined."}] [[:answer/id #uuid "e07826d5-6e5f-5e02-91ec-0433f098b6ed"] {:answer/id #uuid "e07826d5-6e5f-5e02-91ec-0433f098b6ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}7 \\\\ 9 \\\\ -2\\end{bmatrix}" :db/id #edb/ref 17592186484748}] [[:answer-field/id #uuid "bc1c2f9b-6eef-5b3c-a6e3-cf42e18cdff5"] {:answer-field/choices [{:db/id #edb/ref 17592186484748}] :answer-field/correct {:db/id #edb/ref 17592186484748} :answer-field/id #uuid "bc1c2f9b-6eef-5b3c-a6e3-cf42e18cdff5" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186484727}] [[:question/id #uuid "7619440b-eb12-5900-92ca-03a48bdde140"] {:db/id #edb/ref 17592186484515 :question/answer-fields [{:db/id #edb/ref 17592186484727}] :question/id #uuid "7619440b-eb12-5900-92ca-03a48bdde140" :question/problem "**(e)** Find $AE$. Show the calculation.\n\nAnswer: {{answer}}." :question/worked-solution "Take each row dotted with $(1,3)^T$: $1+6=7$, $3+6=9$, and $1-3=-2$."}] [[:answer/id #uuid "6e3c06bf-96b0-5fbd-9abd-71266e52b19e"] {:answer/id #uuid "6e3c06bf-96b0-5fbd-9abd-71266e52b19e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not defined. The inner dimensions of $(2\\times1)(3\\times2)$ are 1 and 3, so the product is undefined." :db/id #edb/ref 17592186484682}] [[:answer-field/id #uuid "292b0379-b96a-52cf-a6ea-30cac5708e4d"] {:answer-field/choices [{:db/id #edb/ref 17592186484682}] :answer-field/correct {:db/id #edb/ref 17592186484682} :answer-field/id #uuid "292b0379-b96a-52cf-a6ea-30cac5708e4d" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484649}] [[:question/id #uuid "b94c5ea5-f23d-5e4f-b7e9-2b99966f0da4"] {:db/id #edb/ref 17592186484576 :question/answer-fields [{:db/id #edb/ref 17592186484649}] :question/id #uuid "b94c5ea5-f23d-5e4f-b7e9-2b99966f0da4" :question/problem "**(f)** Find $EA$ if possible; otherwise explain why it is not defined.\n\nWritten response: {{response}}" :question/worked-solution "Not defined. The inner dimensions of $(2\\times1)(3\\times2)$ are 1 and 3, so the product is undefined."}] [[:answer/id #uuid "320f5bd9-b9e4-57fe-8854-169912408a12"] {:answer/id #uuid "320f5bd9-b9e4-57fe-8854-169912408a12" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not defined. The inner dimensions of $(2\\times3)(2\\times1)$ are 3 and 2, so the product is undefined." :db/id #edb/ref 17592186484658}] [[:answer-field/id #uuid "ecb1e30d-6ae1-5c0b-978f-fd10ebec4dc7"] {:answer-field/choices [{:db/id #edb/ref 17592186484658}] :answer-field/correct {:db/id #edb/ref 17592186484658} :answer-field/id #uuid "ecb1e30d-6ae1-5c0b-978f-fd10ebec4dc7" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484761}] [[:question/id #uuid "379e5bf4-9387-59f1-88b0-fe60974d900a"] {:db/id #edb/ref 17592186484462 :question/answer-fields [{:db/id #edb/ref 17592186484761}] :question/id #uuid "379e5bf4-9387-59f1-88b0-fe60974d900a" :question/problem "**(g)** Find $BE$ if possible; otherwise explain why it is not defined.\n\nWritten response: {{response}}" :question/worked-solution "Not defined. The inner dimensions of $(2\\times3)(2\\times1)$ are 3 and 2, so the product is undefined."}] [[:answer/id #uuid "e20a1fb9-4307-5eee-8754-2797078ba984"] {:answer/id #uuid "e20a1fb9-4307-5eee-8754-2797078ba984" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}2 \\\\ -5\\end{bmatrix}" :db/id #edb/ref 17592186484749}] [[:answer-field/id #uuid "11a20abf-76a2-5762-9bc6-6bc0fca1c059"] {:answer-field/choices [{:db/id #edb/ref 17592186484749}] :answer-field/correct {:db/id #edb/ref 17592186484749} :answer-field/id #uuid "11a20abf-76a2-5762-9bc6-6bc0fca1c059" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186484635}] [[:question/id #uuid "4c2d37bd-0b9b-5453-8bce-3e3872e64b33"] {:db/id #edb/ref 17592186484481 :question/answer-fields [{:db/id #edb/ref 17592186484635}] :question/id #uuid "4c2d37bd-0b9b-5453-8bce-3e3872e64b33" :question/problem "**(h)** Find $DE$. Show the calculation.\n\nAnswer: {{answer}}." :question/worked-solution "The rows dotted with $(1,3)^T$ give $-1+3=2$ and $4-9=-5$."}] [[:step/id #uuid "90228589-48d0-58f5-840d-7b3ed943515b"] {:db/id #edb/ref 17592186484540 :step/content {:db/id #edb/ref 17592186484617} :step/id #uuid "90228589-48d0-58f5-840d-7b3ed943515b" :step/next {:db/id #edb/ref 17592186484509}}] [[:step/id #uuid "69053806-db1f-5871-86fe-98c35aba2f2f"] {:db/id #edb/ref 17592186484509 :step/content {:db/id #edb/ref 17592186484526} :step/id #uuid "69053806-db1f-5871-86fe-98c35aba2f2f" :step/next {:db/id #edb/ref 17592186484483}}] [[:step/id #uuid "4fa8bef9-4148-5ead-a650-bc98bd7476d4"] {:db/id #edb/ref 17592186484483 :step/content {:db/id #edb/ref 17592186484607} :step/id #uuid "4fa8bef9-4148-5ead-a650-bc98bd7476d4" :step/next {:db/id #edb/ref 17592186484488}}] [[:step/id #uuid "55f0e202-c936-56a9-9c84-2a80bd023d74"] {:db/id #edb/ref 17592186484488 :step/content {:db/id #edb/ref 17592186484500} :step/id #uuid "55f0e202-c936-56a9-9c84-2a80bd023d74" :step/next {:db/id #edb/ref 17592186484494}}] [[:step/id #uuid "59a9a51b-9228-5253-9a0a-3cc3356e7058"] {:db/id #edb/ref 17592186484494 :step/content {:db/id #edb/ref 17592186484515} :step/id #uuid "59a9a51b-9228-5253-9a0a-3cc3356e7058" :step/next {:db/id #edb/ref 17592186484514}}] [[:step/id #uuid "70c1fb93-3a50-5634-8616-3b3751ee14df"] {:db/id #edb/ref 17592186484514 :step/content {:db/id #edb/ref 17592186484576} :step/id #uuid "70c1fb93-3a50-5634-8616-3b3751ee14df" :step/next {:db/id #edb/ref 17592186484578}}] [[:step/id #uuid "bae0b6a5-4209-5b59-9942-b82af3c74484"] {:db/id #edb/ref 17592186484578 :step/content {:db/id #edb/ref 17592186484462} :step/id #uuid "bae0b6a5-4209-5b59-9942-b82af3c74484" :step/next {:db/id #edb/ref 17592186484601}}] [[:step/id #uuid "e737d807-6708-5f7a-b7dc-dfbaf4a65796"] {:db/id #edb/ref 17592186484601 :step/content {:db/id #edb/ref 17592186484481} :step/id #uuid "e737d807-6708-5f7a-b7dc-dfbaf4a65796"}] [[:multistep/id #uuid "18a019ce-b91b-55bf-b2be-d55bb374c90f"] {:db/id #edb/ref 17592186484440 :multistep/context "Source question: Exercise **2.1.10**, [printed page 91 (PDF page 103)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=103).\n\nConsider\n\n$A=\\begin{bmatrix}1 & 2 \\\\ 3 & 2 \\\\ 1 & -1\\end{bmatrix},\\quad B=\\begin{bmatrix}2 & -5 & 2 \\\\ -3 & 2 & 1\\end{bmatrix},\\quad C=\\begin{bmatrix}1 & 2 \\\\ 5 & 0\\end{bmatrix},\\quad D=\\begin{bmatrix}-1 & 1 \\\\ 4 & -3\\end{bmatrix},\\quad E=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}$.\n\nFind each expression if possible; explain why if it is not possible.\n\nPart (h) continues on printed page 92 (PDF page 104)." :multistep/first-step {:db/id #edb/ref 17592186484540} :multistep/id #uuid "18a019ce-b91b-55bf-b2be-d55bb374c90f" :multistep/steps [{:db/id #edb/ref 17592186484483} {:db/id #edb/ref 17592186484488} {:db/id #edb/ref 17592186484494} {:db/id #edb/ref 17592186484509} {:db/id #edb/ref 17592186484514} {:db/id #edb/ref 17592186484540} {:db/id #edb/ref 17592186484578} {:db/id #edb/ref 17592186484601}]}] [[:assigned-problem/id #uuid "ecac06e4-b8a3-5f97-93cf-d5a169ad9a73"] {:assigned-problem/content {:db/id #edb/ref 17592186484440} :assigned-problem/id #uuid "ecac06e4-b8a3-5f97-93cf-d5a169ad9a73" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048783} {:db/id #edb/ref 17592186048863} {:db/id #edb/ref 17592186050407} {:db/id #edb/ref 17592186050825} {:db/id #edb/ref 17592186050979}] :db/id #edb/ref 17592186484608}] [[:answer/id #uuid "f2dd57d1-e31f-58c5-abde-663b64ddaf38"] {:answer/id #uuid "f2dd57d1-e31f-58c5-abde-663b64ddaf38" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "One example is $A=\\begin{bmatrix}1&0\\\\0&0\\end{bmatrix}$, $B=\\begin{bmatrix}0&0\\\\0&0\\end{bmatrix}$, and $C=\\begin{bmatrix}0&0\\\\1&0\\end{bmatrix}$. Both $AB$ and $AC$ are zero, while $A\\ne0$ and $B\\ne C$. A singular left factor can annihilate a nonzero difference $B-C$." :db/id #edb/ref 17592186484762}] [[:answer-field/id #uuid "8b1f6fa5-d91b-59e2-b9eb-9fd7f7c7f187"] {:answer-field/choices [{:db/id #edb/ref 17592186484762}] :answer-field/correct {:db/id #edb/ref 17592186484762} :answer-field/id #uuid "8b1f6fa5-d91b-59e2-b9eb-9fd7f7c7f187" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484698}] [[:question/id #uuid "a6345b85-fee3-5cbb-91ca-19485b803c25"] {:db/id #edb/ref 17592186484561 :question/answer-fields [{:db/id #edb/ref 17592186484698}] :question/id #uuid "a6345b85-fee3-5cbb-91ca-19485b803c25" :question/problem "Source question: Exercise **2.1.17**, [printed page 92 (PDF page 104)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=104).\n\nGive matrices of any size $A,B,C$ with $B\\ne C$, $A\\ne0$, and $AB=AC$. Verify your example.\n\nWritten response: {{response}}" :question/worked-solution "One example is $A=\\begin{bmatrix}1&0\\\\0&0\\end{bmatrix}$, $B=\\begin{bmatrix}0&0\\\\0&0\\end{bmatrix}$, and $C=\\begin{bmatrix}0&0\\\\1&0\\end{bmatrix}$. Both $AB$ and $AC$ are zero, while $A\\ne0$ and $B\\ne C$. A singular left factor can annihilate a nonzero difference $B-C$."}] [[:assigned-problem/id #uuid "7a0ee565-aaab-5a07-b4ee-becf88960db2"] {:assigned-problem/content {:db/id #edb/ref 17592186484561} :assigned-problem/id #uuid "7a0ee565-aaab-5a07-b4ee-becf88960db2" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050122} {:db/id #edb/ref 17592186050407}] :db/id #edb/ref 17592186484519}] [[:answer/id #uuid "9e3db64e-2baa-59dd-be20-cff08d3be78b"] {:answer/id #uuid "9e3db64e-2baa-59dd-be20-cff08d3be78b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\begin{bmatrix}1 & 3 & 2 & 0 \\\\ 1 & 0 & 2 & 0 \\\\ 0 & 0 & 6 & 0 \\\\ 1 & 3 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186484711}] [[:answer-field/id #uuid "5e16170b-7ef9-55a7-a97b-c73aac95c977"] {:answer-field/choices [{:db/id #edb/ref 17592186484711}] :answer-field/correct {:db/id #edb/ref 17592186484711} :answer-field/id #uuid "5e16170b-7ef9-55a7-a97b-c73aac95c977" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186484676}] [[:question/id #uuid "f346d27c-08cd-5050-9fa7-ea756a885c3b"] {:db/id #edb/ref 17592186484614 :question/answer-fields [{:db/id #edb/ref 17592186484676}] :question/id #uuid "f346d27c-08cd-5050-9fa7-ea756a885c3b" :question/problem "Source question: Exercise **2.1.22**, [printed page 93 (PDF page 105)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=105).\n\nWrite the column of expressions $(x_1+3x_2+2x_3,\\ 2x_3+x_1,\\ 6x_3,\\ x_4+3x_2+x_1)^T$ as $A(x_1,x_2,x_3,x_4)^T$. Find A.\n\nAnswer: {{answer}}." :question/worked-solution "For each output expression, read the coefficients in the fixed order $x_1,x_2,x_3,x_4$. The rows are $(1,3,2,0)$, $(1,0,2,0)$, $(0,0,6,0)$, and $(1,3,0,1)$. Multiplying the resulting matrix by the variable column reproduces every supplied expression."}] [[:assigned-problem/id #uuid "8da71a2f-6158-53ea-93c8-9ea79db15a25"] {:assigned-problem/content {:db/id #edb/ref 17592186484614} :assigned-problem/id #uuid "8da71a2f-6158-53ea-93c8-9ea79db15a25" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050825}] :db/id #edb/ref 17592186484538}] [[:answer/id #uuid "98f5f650-3ea2-570c-bff3-63ce1fdd29b6"] {:answer/id #uuid "98f5f650-3ea2-570c-bff3-63ce1fdd29b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Compute $A^2=\\begin{bmatrix}2 & 0 & 2 \\\\ 1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}=A$ by row-column multiplication. For example the first row is $(4-2,0,4-2)=(2,0,2)$; the second is $(2+1-2,1,2+2-2)=(1,1,2)$; the third is $(-2+1,0,-2+1)=(-1,0,-1)$. Therefore A satisfies the definition." :db/id #edb/ref 17592186484710}] [[:answer-field/id #uuid "099fadd0-1e18-5aa6-9885-74fbab53f47f"] {:answer-field/choices [{:db/id #edb/ref 17592186484710}] :answer-field/correct {:db/id #edb/ref 17592186484710} :answer-field/id #uuid "099fadd0-1e18-5aa6-9885-74fbab53f47f" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484630}] [[:question/id #uuid "4a264226-8680-568e-8075-85be37307444"] {:db/id #edb/ref 17592186484479 :question/answer-fields [{:db/id #edb/ref 17592186484630}] :question/id #uuid "4a264226-8680-568e-8075-85be37307444" :question/problem "Source question: Exercise **2.1.24**, [printed page 93 (PDF page 105)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=105).\n\nA matrix is idempotent if $A^2=A$. Show that $A=\\begin{bmatrix}2 & 0 & 2 \\\\ 1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}$ is idempotent.\n\nWritten response: {{response}}" :question/worked-solution "Compute $A^2=\\begin{bmatrix}2 & 0 & 2 \\\\ 1 & 1 & 2 \\\\ -1 & 0 & -1\\end{bmatrix}=A$ by row-column multiplication. For example the first row is $(4-2,0,4-2)=(2,0,2)$; the second is $(2+1-2,1,2+2-2)=(1,1,2)$; the third is $(-2+1,0,-2+1)=(-1,0,-1)$. Therefore A satisfies the definition."}] [[:assigned-problem/id #uuid "1f510304-c302-5c2e-ac53-846a2153805d"] {:assigned-problem/content {:db/id #edb/ref 17592186484479} :assigned-problem/id #uuid "1f510304-c302-5c2e-ac53-846a2153805d" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050407}] :db/id #edb/ref 17592186484445}] [[:answer/id #uuid "2a526ce1-7975-5fd7-a45d-fd0d7be4bb52"] {:answer/id #uuid "2a526ce1-7975-5fd7-a45d-fd0d7be4bb52" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. Multiply on the left by $A^{-1}$ and use associativity: $A^{-1}(AB)=A^{-1}(AC)$ implies $(A^{-1}A)B=(A^{-1}A)C$, hence $IB=IC$ and $B=C$. Multiplication on the right would not cancel this left factor." :db/id #edb/ref 17592186484652}] [[:answer-field/id #uuid "a92b83fb-2d59-58f0-a4ed-ddf6188f90d0"] {:answer-field/choices [{:db/id #edb/ref 17592186484652}] :answer-field/correct {:db/id #edb/ref 17592186484652} :answer-field/id #uuid "a92b83fb-2d59-58f0-a4ed-ddf6188f90d0" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484718}] [[:question/id #uuid "67fb58af-414a-5b3b-a33c-bb3e81cfb9cc"] {:db/id #edb/ref 17592186484508 :question/answer-fields [{:db/id #edb/ref 17592186484718}] :question/id #uuid "67fb58af-414a-5b3b-a33c-bb3e81cfb9cc" :question/problem "Source question: Exercise **2.1.32**, [printed page 95 (PDF page 107)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=107).\n\nIf $AB=AC$ and $A$ is an invertible $n\\times n$ matrix, must $B=C$? Explain.\n\nWritten response: {{response}}" :question/worked-solution "Yes. Multiply on the left by $A^{-1}$ and use associativity: $A^{-1}(AB)=A^{-1}(AC)$ implies $(A^{-1}A)B=(A^{-1}A)C$, hence $IB=IC$ and $B=C$. Multiplication on the right would not cancel this left factor."}] [[:assigned-problem/id #uuid "e93b733d-b656-5991-9b93-3b9f7b2a76e0"] {:assigned-problem/content {:db/id #edb/ref 17592186484508} :assigned-problem/id #uuid "e93b733d-b656-5991-9b93-3b9f7b2a76e0" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050122}] :db/id #edb/ref 17592186484603}] [[:answer/id #uuid "24f71f33-eb2f-539b-b8a0-41112c96fbdd"] {:answer/id #uuid "24f71f33-eb2f-539b-b8a0-41112c96fbdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An authored example is $A=\\begin{bmatrix}3 & -4 \\\\ 2 & -3\\end{bmatrix}$. Its square is $\\begin{bmatrix}9-8&-12+12\\\\6-6&-8+9\\end{bmatrix}=I_2$. Its off-diagonal entries are nonzero, so it is neither $I_2$ nor $-I_2$. The textbook answer is the 3-by-3 diagonal matrix with entries 1, −1, 1 (Selected Exercise Answers); this 2-by-2 example differs from it." :db/id #edb/ref 17592186484647}] [[:answer-field/id #uuid "cd16aef7-2e9f-5f4b-921e-823dad1a5d74"] {:answer-field/choices [{:db/id #edb/ref 17592186484647}] :answer-field/correct {:db/id #edb/ref 17592186484647} :answer-field/id #uuid "cd16aef7-2e9f-5f4b-921e-823dad1a5d74" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484737}] [[:question/id #uuid "09726ce9-6257-5865-9c2c-a2da37b34442"] {:db/id #edb/ref 17592186484426 :question/answer-fields [{:db/id #edb/ref 17592186484737}] :question/id #uuid "09726ce9-6257-5865-9c2c-a2da37b34442" :question/problem "Source question: Exercise **2.1.34**, [printed page 95 (PDF page 107)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=107).\n\nGive a matrix A such that $A^2=I$, $A\\ne I$, and $A\\ne-I$. Instructor override: use a different matrix from the answer in the back of the book, and verify it.\n\nWritten response: {{response}}" :question/worked-solution "An authored example is $A=\\begin{bmatrix}3 & -4 \\\\ 2 & -3\\end{bmatrix}$. Its square is $\\begin{bmatrix}9-8&-12+12\\\\6-6&-8+9\\end{bmatrix}=I_2$. Its off-diagonal entries are nonzero, so it is neither $I_2$ nor $-I_2$. The textbook answer is the 3-by-3 diagonal matrix with entries 1, −1, 1 (Selected Exercise Answers); this 2-by-2 example differs from it."}] [[:assigned-problem/id #uuid "8e23727c-cc97-5966-94a8-d759df227f17"] {:assigned-problem/content {:db/id #edb/ref 17592186484426} :assigned-problem/id #uuid "8e23727c-cc97-5966-94a8-d759df227f17" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050407}] :db/id #edb/ref 17592186484539}] [[:answer/id #uuid "234f1c2c-d504-57f8-932a-d440e879f216"] {:answer/id #uuid "234f1c2c-d504-57f8-932a-d440e879f216" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Multiply the equation on the left by $A^{-1}$. Associativity gives $A^{-1}(AX)=(A^{-1}A)X=IX=X$, so $X=A^{-1}B$. The dimensions are compatible, and the order of multiplication is essential." :db/id #edb/ref 17592186484645}] [[:answer-field/id #uuid "c0bce6a1-e732-5e9e-9821-a1cf38ca6803"] {:answer-field/choices [{:db/id #edb/ref 17592186484645}] :answer-field/correct {:db/id #edb/ref 17592186484645} :answer-field/id #uuid "c0bce6a1-e732-5e9e-9821-a1cf38ca6803" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484734}] [[:question/id #uuid "7b87528e-95bd-5aaf-bac1-39956598cbf7"] {:db/id #edb/ref 17592186484522 :question/answer-fields [{:db/id #edb/ref 17592186484734}] :question/id #uuid "7b87528e-95bd-5aaf-bac1-39956598cbf7" :question/problem "Source question: Exercise **2.1.46**, [printed page 97 (PDF page 109)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=109).\n\nLet A be invertible $n\\times n$, let X be $n\\times1$, and suppose $AX=B$ for $n\\times1$ B. Show that $X=A^{-1}B$.\n\nWritten response: {{response}}" :question/worked-solution "Multiply the equation on the left by $A^{-1}$. Associativity gives $A^{-1}(AX)=(A^{-1}A)X=IX=X$, so $X=A^{-1}B$. The dimensions are compatible, and the order of multiplication is essential."}] [[:assigned-problem/id #uuid "2352fd72-0851-569e-ae7b-4337bfb9262b"] {:assigned-problem/content {:db/id #edb/ref 17592186484522} :assigned-problem/id #uuid "2352fd72-0851-569e-ae7b-4337bfb9262b" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050122}] :db/id #edb/ref 17592186484448}] [[:answer/id #uuid "8b9b90ad-8695-5ded-aacb-d55af80c38d5"] {:answer/id #uuid "8b9b90ad-8695-5ded-aacb-d55af80c38d5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Since $AB=I$, $B=IB=(A^{-1}A)B=A^{-1}(AB)=A^{-1}I=A^{-1}$. This uses associativity and the defining inverse identities. Equivalently any two two-sided inverses coincide by the same product calculation." :db/id #edb/ref 17592186484699}] [[:answer-field/id #uuid "67f9ffe6-9c4a-5169-9710-d3dbdad19eb5"] {:answer-field/choices [{:db/id #edb/ref 17592186484699}] :answer-field/correct {:db/id #edb/ref 17592186484699} :answer-field/id #uuid "67f9ffe6-9c4a-5169-9710-d3dbdad19eb5" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484679}] [[:question/id #uuid "b662df74-8b51-5933-bf22-1aee1f028c62"] {:db/id #edb/ref 17592186484575 :question/answer-fields [{:db/id #edb/ref 17592186484679}] :question/id #uuid "b662df74-8b51-5933-bf22-1aee1f028c62" :question/problem "Source question: Exercise **2.1.48**, [printed page 97 (PDF page 109)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=109).\n\nShow that the inverse of an invertible square matrix is unique: if $BA=I$ and $AB=I$, then $B=A^{-1}$.\n\nWritten response: {{response}}" :question/worked-solution "Since $AB=I$, $B=IB=(A^{-1}A)B=A^{-1}(AB)=A^{-1}I=A^{-1}$. This uses associativity and the defining inverse identities. Equivalently any two two-sided inverses coincide by the same product calculation."}] [[:assigned-problem/id #uuid "98cb828a-9954-5718-8cd6-792a0ef59b5f"] {:assigned-problem/content {:db/id #edb/ref 17592186484575} :assigned-problem/id #uuid "98cb828a-9954-5718-8cd6-792a0ef59b5f" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050122}] :db/id #edb/ref 17592186484548}] [[:answer/id #uuid "b6c1895e-6925-52f5-9a3d-fb3456b7e336"] {:answer/id #uuid "b6c1895e-6925-52f5-9a3d-fb3456b7e336" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The transpose reverses product order. Thus $A^T(A^{-1})^T=(A^{-1}A)^T=I$ and $(A^{-1})^TA^T=(AA^{-1})^T=I$. The candidate $(A^{-1})^T$ is a two-sided inverse of $A^T$, so uniqueness identifies it as $(A^T)^{-1}$." :db/id #edb/ref 17592186484722}] [[:answer-field/id #uuid "98134175-447d-5b42-b549-96b305ad46b4"] {:answer-field/choices [{:db/id #edb/ref 17592186484722}] :answer-field/correct {:db/id #edb/ref 17592186484722} :answer-field/id #uuid "98134175-447d-5b42-b549-96b305ad46b4" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484709}] [[:question/id #uuid "003a3b63-b9d9-588d-99aa-287511282258"] {:db/id #edb/ref 17592186484418 :question/answer-fields [{:db/id #edb/ref 17592186484709}] :question/id #uuid "003a3b63-b9d9-588d-99aa-287511282258" :question/problem "Source question: Exercise **2.1.49**, [printed page 97 (PDF page 109)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=109).\n\nShow that if A is invertible, then $A^T$ is invertible and $(A^T)^{-1}=(A^{-1})^T$.\n\nWritten response: {{response}}" :question/worked-solution "The transpose reverses product order. Thus $A^T(A^{-1})^T=(A^{-1}A)^T=I$ and $(A^{-1})^TA^T=(AA^{-1})^T=I$. The candidate $(A^{-1})^T$ is a two-sided inverse of $A^T$, so uniqueness identifies it as $(A^T)^{-1}$."}] [[:assigned-problem/id #uuid "f7cbbf85-5c67-5aba-8cc7-5dc720a7f45c"] {:assigned-problem/content {:db/id #edb/ref 17592186484418} :assigned-problem/id #uuid "f7cbbf85-5c67-5aba-8cc7-5dc720a7f45c" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050122} {:db/id #edb/ref 17592186050727}] :db/id #edb/ref 17592186484618}] [[:answer/id #uuid "d01b80f6-37f7-522a-b7f1-4f19b1929286"] {:answer/id #uuid "d01b80f6-37f7-522a-b7f1-4f19b1929286" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By associativity, $(AB)(B^{-1}A^{-1})=A(BB^{-1})A^{-1}=AIA^{-1}=I$. In the opposite order, $(B^{-1}A^{-1})(AB)=B^{-1}(A^{-1}A)B=B^{-1}IB=I$. Therefore $B^{-1}A^{-1}$ is a two-sided inverse of AB; uniqueness from Problem 18 gives the desired identity. The inverse order is reversed." :db/id #edb/ref 17592186484739}] [[:answer-field/id #uuid "1beb73fb-e329-5544-8a4e-c13993ca59b0"] {:answer-field/choices [{:db/id #edb/ref 17592186484739}] :answer-field/correct {:db/id #edb/ref 17592186484739} :answer-field/id #uuid "1beb73fb-e329-5544-8a4e-c13993ca59b0" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186484639}] [[:question/id #uuid "466e564b-4ad4-5fc5-87ef-00ad72e6f669"] {:db/id #edb/ref 17592186484473 :question/answer-fields [{:db/id #edb/ref 17592186484639}] :question/id #uuid "466e564b-4ad4-5fc5-87ef-00ad72e6f669" :question/problem "Source question: Exercise **2.1.50**, [printed page 97 (PDF page 109)](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf#page=109).\n\nFor invertible square matrices A and B of the same size, show $(AB)^{-1}=B^{-1}A^{-1}$ by verifying $(AB)(B^{-1}A^{-1})=I$ and $(B^{-1}A^{-1})(AB)=I$. Hint: use Exercise 2.1.48 (Problem 18).\n\nWritten response: {{response}}" :question/worked-solution "By associativity, $(AB)(B^{-1}A^{-1})=A(BB^{-1})A^{-1}=AIA^{-1}=I$. In the opposite order, $(B^{-1}A^{-1})(AB)=B^{-1}(A^{-1}A)B=B^{-1}IB=I$. Therefore $B^{-1}A^{-1}$ is a two-sided inverse of AB; uniqueness from Problem 18 gives the desired identity. The inverse order is reversed."}] [[:assigned-problem/id #uuid "b1550dde-df63-5db8-acff-297ab67e9362"] {:assigned-problem/content {:db/id #edb/ref 17592186484473} :assigned-problem/id #uuid "b1550dde-df63-5db8-acff-297ab67e9362" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049125} {:db/id #edb/ref 17592186050122}] :db/id #edb/ref 17592186484572}] [[:step/id #uuid "2bbe0dee-5d3b-51e8-b2e5-43502aa2d421"] {:db/id #edb/ref 17592186484456 :step/content {:db/id #edb/ref 17592186484453} :step/id #uuid "2bbe0dee-5d3b-51e8-b2e5-43502aa2d421" :step/next {:db/id #edb/ref 17592186484460}}] [[:step/id #uuid "3514dee3-6dfa-506e-93d1-b54fb167d5e3"] {:db/id #edb/ref 17592186484460 :step/content {:db/id #edb/ref 17592186484591} :step/id #uuid "3514dee3-6dfa-506e-93d1-b54fb167d5e3" :step/next {:db/id #edb/ref 17592186484542}}] [[:step/id #uuid "93940e2a-1b81-5d67-a9e7-d6b1bbfe1a1c"] {:db/id #edb/ref 17592186484542 :step/content {:db/id #edb/ref 17592186484545} :step/id #uuid "93940e2a-1b81-5d67-a9e7-d6b1bbfe1a1c" :step/next {:db/id #edb/ref 17592186484507}}] [[:step/id #uuid "66c02892-3fe3-5f8b-8dd5-507118d950c2"] {:db/id #edb/ref 17592186484507 :step/content {:db/id #edb/ref 17592186484588} :step/id #uuid "66c02892-3fe3-5f8b-8dd5-507118d950c2" :step/next {:db/id #edb/ref 17592186484612}}] [[:step/id #uuid "f193bb4e-e421-55c0-b7e1-7d5c5ec2bf89"] {:db/id #edb/ref 17592186484612 :step/content {:db/id #edb/ref 17592186484443} :step/id #uuid "f193bb4e-e421-55c0-b7e1-7d5c5ec2bf89" :step/next {:db/id #edb/ref 17592186484621}}] [[:step/id #uuid "fbab652c-a32e-5072-9495-1685a937eebc"] {:db/id #edb/ref 17592186484621 :step/content {:db/id #edb/ref 17592186484553} :step/id #uuid "fbab652c-a32e-5072-9495-1685a937eebc" :step/next {:db/id #edb/ref 17592186484543}}] [[:step/id #uuid "93dcbb61-1f2b-5f3a-9b36-43bef870777e"] {:db/id #edb/ref 17592186484543 :step/conte