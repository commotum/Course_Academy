98-1b5d-502c-8b38-fe9c7a3aefb5" 13194139546561 17592186502323 true] [17592186754714 1063 #edb/ref 17592186754665 13194139546561 17592186502323 true] [17592186754715 1075 #edb/ref 17592186754546 13194139546561 17592186502323 true] [17592186754715 1076 #edb/ref 17592186408167 13194139546561 17592186502323 true] [17592186754715 1077 "response" 13194139546561 17592186502323 true] [17592186754715 1078 #edb/ref 17592186754546 13194139546561 17592186502323 true] [17592186754715 1079 #uuid "af4a36f1-837c-5e49-b465-7d8fa7e27a3e" 13194139546561 17592186502323 true] [17592186754716 1080 "Yes. The exponential factor in $W=(r_2-r_1)e^{(r_1+r_2)x}$ is never zero, and $r_2-r_1\\ne0$. Hence the two given solutions are linearly independent everywhere and form a fundamental set for the second-order ODE." 13194139546561 17592186502323 true] [17592186754716 1082 #edb/ref 17592186045499 13194139546561 17592186502323 true] [17592186754716 1083 #uuid "afb8fb7f-f388-5872-a3c4-dea9211a4ba5" 13194139546561 17592186502323 true] [17592186754717 1080 "2" 13194139546561 17592186502323 true] [17592186754717 1082 #edb/ref 17592186045498 13194139546561 17592186502323 true] [17592186754717 1083 #uuid "b003ad69-afda-533c-8a81-b37940786b95" 13194139546561 17592186502323 true] [17592186754718 1068 #edb/ref 17592186754754 13194139546561 17592186502323 true] [17592186754718 1071 "**(h)** $\\nabla\\times(\\nabla\\phi)$.\n\nClassification: {{answer}}." 13194139546561 17592186502323 true] [17592186754718 1072 #uuid "b0336deb-ccb7-525f-a00f-fd96d51cc108" 13194139546561 17592186502323 true] [17592186754718 1074 "The curl takes the inner vector field to a vector field. If the mixed partials are continuous it is the zero vector field; zero does not change its type." 13194139546561 17592186502323 true] [17592186754719 1080 "2" 13194139546561 17592186502323 true] [17592186754719 1082 #edb/ref 17592186045498 13194139546561 17592186502323 true] [17592186754719 1083 #uuid "b127e0df-f481-5de0-bfc8-dfba9fc09e95" 13194139546561 17592186502323 true] [17592186754720 1088 #edb/ref 17592186049132 13194139546561 17592186502323 true] [17592186754720 1088 #edb/ref 17592186049459 13194139546561 17592186502323 true] [17592186754720 1088 #edb/ref 17592186051085 13194139546561 17592186502323 true] [17592186754720 1089 #edb/ref 17592186754774 13194139546561 17592186502323 true] [17592186754720 1090 #uuid "b15528b7-25ca-5f8d-aee4-0000d1bb9695" 13194139546561 17592186502323 true] [17592186754721 1088 #edb/ref 17592186048289 13194139546561 17592186502323 true] [17592186754721 1088 #edb/ref 17592186048391 13194139546561 17592186502323 true] [17592186754721 1088 #edb/ref 17592186049695 13194139546561 17592186502323 true] [17592186754721 1088 #edb/ref 17592186050433 13194139546561 17592186502323 true] [17592186754721 1088 #edb/ref 17592186050465 13194139546561 17592186502323 true] [17592186754721 1089 #edb/ref 17592186754496 13194139546561 17592186502323 true] [17592186754721 1090 #uuid "b24ce721-da66-5ff1-8354-4c50e4afbad6" 13194139546561 17592186502323 true] [17592186754722 1080 "vector field" 13194139546561 17592186502323 true] [17592186754722 1082 #edb/ref 17592186045499 13194139546561 17592186502323 true] [17592186754722 1083 #uuid "b2dd37ea-02dc-55e5-8feb-1cc0e66ef996" 13194139546561 17592186502323 true] [17592186754723 1080 "\\begin{pmatrix}2a\\\\2b\\\\2c\\end{pmatrix}" 13194139546561 17592186502323 true] [17592186754723 1082 #edb/ref 17592186045498 13194139546561 17592186502323 true] [17592186754723 1083 #uuid "b4248007-9fd9-5b64-b0b0-5b876c965dc1" 13194139546561 17592186502323 true] [17592186754724 1075 #edb/ref 17592186754811 13194139546561 17592186502323 true] [17592186754724 1076 #edb/ref 17592186408167 13194139546561 17592186502323 true] [17592186754724 1077 "response" 13194139546561 17592186502323 true] [17592186754724 1078 #edb/ref 17592186754811 13194139546561 17592186502323 true] [17592186754724 1079 #uuid "b43eab87-5388-51f8-a48d-85c9e6adae67" 13194139546561 17592186502323 true] [17592186754725 1088 #edb/ref 17592186048391 13194139546561 17592186502323 true] [17592186754725 1088 #edb/ref 17592186048813 13194139546561 17592186502323 true] [17592186754725 1088 #edb/ref 17592186050150 13194139546561 17592186502323 true] [17592186754725 1088 #edb/ref 17592186050271 13194139546561 17592186502323 true] [17592186754725 1088 #edb/ref 17592186050433 13194139546561 17592186502323 true] [17592186754725 1089 #edb/ref 17592186754640 13194139546561 17592186502323 true] [17592186754725 1090 #uuid "b469facc-11d4-5a52-a197-6daa7c1202d5" 13194139546561 17592186502323 true] [17592186754726 1068 #edb/ref 17592186754439 13194139546561 17592186502323 true] [17592186754726 1071 "**(a)** Show that if $\\omega=k/C$, the fields $\\mathbf E(z,t)=a\\sin(kz-\\omega t)\\mathbf i$ and $\\mathbf B(z,t)=a\\sin(kz-\\omega t)\\mathbf j$ satisfy the two given Maxwell equations." 13194139546561 17592186502323 true] [17592186754726 1072 #uuid "b4f7742f-3b32-5d9d-9605-7e32741a0562" 13194139546561 17592186502323 true] [17592186754726 1074 "Differentiate with respect to the spatial variable $z$ for curl and with respect to $t$ for the time derivatives. Keep the minus sign from $\\partial_t(kz-\\omega t)=-\\omega$." 13194139546561 17592186502323 true] [17592186754727 1080 "The RREF is $$R=\\begin{pmatrix}1&3&0&-2&0&3\\\\0&0&1&-1&0&-1\\\\0&0&0&0&1&-3\\\\0&0&0&0&0&0\\end{pmatrix}.$$ It has three pivots, so $\\operatorname{rank}(A)=3$. Its nonzero rows give the row-space basis $$\\{(1,3,0,-2,0,3),(0,0,1,-1,0,-1),(0,0,0,0,1,-3)\\}.$$ Pivot columns $1,3,5$ must be taken from the original $A$ to give the column-space basis $$\\left\\{\\begin{pmatrix}1\\\\3\\\\1\\\\1\\end{pmatrix},\\begin{pmatrix}0\\\\1\\\\1\\\\-1\\end{pmatrix},\\begin{pmatrix}0\\\\0\\\\1\\\\-2\\end{pmatrix}\\right\\}.$$ Row operations preserve row space but generally change column space; this explains the different extraction rules." 13194139546561 17592186502323 true] [17592186754727 1082 #edb/ref 17592186045499 1319413