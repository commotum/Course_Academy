rue] [17592186754604 1083 #uuid "6ab2bde9-43ef-53e1-944a-3b3e5940c8ab" 13194139546561 17592186502323 true] [17592186754605 1088 #edb/ref 17592186048181 13194139546561 17592186502323 true] [17592186754605 1088 #edb/ref 17592186048954 13194139546561 17592186502323 true] [17592186754605 1088 #edb/ref 17592186051046 13194139546561 17592186502323 true] [17592186754605 1089 #edb/ref 17592186754622 13194139546561 17592186502323 true] [17592186754605 1090 #uuid "6af013d0-078d-5ebb-abdb-0cc7a36ca181" 13194139546561 17592186502323 true] [17592186754606 1075 #edb/ref 17592186754629 13194139546561 17592186502323 true] [17592186754606 1076 #edb/ref 17592186408167 13194139546561 17592186502323 true] [17592186754606 1077 "response" 13194139546561 17592186502323 true] [17592186754606 1078 #edb/ref 17592186754629 13194139546561 17592186502323 true] [17592186754606 1079 #uuid "6b2d60c7-42bb-5cee-9316-af12e882ae50" 13194139546561 17592186502323 true] [17592186754607 1075 #edb/ref 17592186754814 13194139546561 17592186502323 true] [17592186754607 1076 #edb/ref 17592186408167 13194139546561 17592186502323 true] [17592186754607 1077 "response" 13194139546561 17592186502323 true] [17592186754607 1078 #edb/ref 17592186754814 13194139546561 17592186502323 true] [17592186754607 1079 #uuid "6b3ab567-58c2-57a8-95cb-ed28d2410db7" 13194139546561 17592186502323 true] [17592186754608 1080 "(r_2-r_1)x^{r_1+r_2-1}" 13194139546561 17592186502323 true] [17592186754608 1082 #edb/ref 17592186045498 13194139546561 17592186502323 true] [17592186754608 1083 #uuid "6b660658-f560-549d-a16b-4e8fbd3a77aa" 13194139546561 17592186502323 true] [17592186754609 1068 #edb/ref 17592186754658 13194139546561 17592186502323 true] [17592186754609 1071 "**(b)** Show that $\\nabla\\cdot(\\nabla\\times\\mathbf F)=0$." 13194139546561 17592186502323 true] [17592186754609 1072 #uuid "6d27e232-b857-5bcd-91b2-c97546684752" 13194139546561 17592186502323 true] [17592186754609 1074 "Compute curl first, apply divergence to the resul