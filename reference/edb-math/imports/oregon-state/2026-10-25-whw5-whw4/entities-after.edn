-5ef4-5fd2-b9fc-70bdea66f345" :step/next {:db/id #edb/ref 17592186702528}}] [:step/id #uuid "5c69d8bb-8add-5682-9061-5d47db48f1e5" {:db/id #edb/ref 17592186702542 :step/content {:db/id #edb/ref 17592186702598} :step/id #uuid "5c69d8bb-8add-5682-9061-5d47db48f1e5" :step/next {:db/id #edb/ref 17592186702699}}] [:step/id #uuid "5d6273ec-8db9-5610-a426-8e0e3a559bf4" {:db/id #edb/ref 17592186702543 :step/content {:db/id #edb/ref 17592186702509} :step/id #uuid "5d6273ec-8db9-5610-a426-8e0e3a559bf4"}] [:step/id #uuid "61e16448-2f00-556b-9dbc-cb53013d3351" {:db/id #edb/ref 17592186702544 :step/content {:db/id #edb/ref 17592186702573} :step/id #uuid "61e16448-2f00-556b-9dbc-cb53013d3351" :step/next {:db/id #edb/ref 17592186702695}}] [:step/id #uuid "63d2e57f-e110-5ff4-9ee8-643a619ec0c9" {:db/id #edb/ref 17592186702546 :step/content {:db/id #edb/ref 17592186702532} :step/id #uuid "63d2e57f-e110-5ff4-9ee8-643a619ec0c9" :step/next {:db/id #edb/ref 17592186702659}}] [:step/id #uuid "665aecc3-ca3a-51fc-bb3e-eea47d958088" {:db/id #edb/ref 17592186702548 :step/content {:db/id #edb/ref 17592186702519} :step/id #uuid "665aecc3-ca3a-51fc-bb3e-eea47d958088" :step/next {:db/id #edb/ref 17592186702531}}] [:step/id #uuid "6931076d-b37a-56f5-a1cb-820094ba9ec2" {:db/id #edb/ref 17592186702550 :step/content {:db/id #edb/ref 17592186702616} :step/id #uuid "6931076d-b37a-56f5-a1cb-820094ba9ec2" :step/next {:db/id #edb/ref 17592186702608}}] [:step/id #uuid "6bae0026-dfbe-5639-b8a3-e637e66dd67f" {:db/id #edb/ref 17592186702551 :step/content {:db/id #edb/ref 17592186702536} :step/id #uuid "6bae0026-dfbe-5639-b8a3-e637e66dd67f" :step/next {:db/id #edb/ref 17592186702550}}] [:step/id #uuid "6fc68834-3537-544d-9861-179d1dd04245" {:db/id #edb/ref 17592186702555 :step/content {:db/id #edb/ref 17592186702582} :step/id #uuid "6fc68834-3537-544d-9861-179d1dd04245" :step/next {:db/id #edb/ref 17592186702605}}] [:step/id #uuid "7056f59b-ad63-5024-a35d-628649b30b2a" {:db/id #edb/ref 17592186702557 :step/content {:db/id #edb/ref 17592186702576} :step/id #uuid "7056f59b-ad63-5024-a35d-628649b30b2a" :step/next {:db/id #edb/ref 17592186702625}}] [:step/id #uuid "7057a4dc-0dc5-54fc-92ab-54e3dd9d1119" {:db/id #edb/ref 17592186702558 :step/content {:db/id #edb/ref 17592186702594} :step/id #uuid "7057a4dc-0dc5-54fc-92ab-54e3dd9d1119"}] [:step/id #uuid "712b84d0-c39b-536e-9e15-461ffda747fb" {:db/id #edb/ref 17592186702559 :step/content {:db/id #edb/ref 17592186702593} :step/id #uuid "712b84d0-c39b-536e-9e15-461ffda747fb" :step/next {:db/id #edb/ref 17592186702561}}] [:step/id #uuid "72d79f5d-9597-59be-baca-aed7d0058847" {:db/id #edb/ref 17592186702561 :step/content {:db/id #edb/ref 17592186702486} :step/id #uuid "72d79f5d-9597-59be-baca-aed7d0058847" :step/next {:db/id #edb/ref 17592186702696}}] [:step/id #uuid "756c889b-72a9-5f44-b8e9-afe6c2f3e131" {:db/id #edb/ref 17592186702565 :step/content {:db/id #edb/ref 17592186702634} :step/id #uuid "756c889b-72a9-5f44-b8e9-afe6c2f3e131" :step/next {:db/id #edb/ref 17592186702635}}] [:step/id #uuid "779b5c44-c05a-5a82-a250-0c0e025c01b1" {:db/id #edb/ref 17592186702566 :step/content {:db/id #edb/ref 17592186702497} :step/id #uuid "779b5c44-c05a-5a82-a250-0c0e025c01b1" :step/next {:db/id #edb/ref 17592186702654}}] [:tutorial/id #uuid "29d2d464-a28f-51b4-b672-b6fa1126d86f" {:db/id #edb/ref 17592186702497 :tutorial/content "**MTH 341 — Written Homework 4**\n\nDue: 2026-10-28\nDue time: 11:59 p.m. PDT\nDeadline source: [Fall 2026 Canvas assignment](https://canvas.oregonstate.edu/courses/2064363/assignments/10695097), checked 2026-10-25 (Wednesday, October 28).\nDate imported: 2026-10-25\nSource: [MTH341-WHW4.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FWHW-4%2FMTH341-WHW4.pdf)\nTextbook: [A First Course in Linear Algebra, Version 2017 — Revision A](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf), Lyryx Learning, based on K. Kuttler (CC BY).\n\nStudy answers and worked explanations are independently authored additions. The current deadline comes from Fall 2026 Canvas; historical Spring dates extracted from the assignment PDF do not determine this deadline. Textbook exercise identifiers resolve two inaccurate page references on the assignment sheet.\n\n## Instructions\n\n- Complete all 13 assigned exercises, including all parts of Exercise 3.1.1 and only part (b) of Exercise 3.1.3.\n- Calculate Problems 1 and 2 **by hand, without technology**. Technology may be used to row reduce matrices elsewhere unless the problem specifies a method. Problem 8 specifically requires row operations to simplify the determinant first.\n- Show all work and write neatly. Put solutions on separate 8.5-by-11-inch or A4 sheets, using the assignment sheet as the cover. Canvas also allows handwritten work scanned to PDF or typeset work. Submit one PDF to Canvas by the deadline; late homework is not accepted.\n- The assignment points to the definition of a linear combination on textbook pages 30 and 151, and to Week 2 lecture Problems 6–7 for §§1.2.3–1.2.4. A linear combination of vectors is a sum of scalar multiples of those vectors.\n- The Canvas rubric assigns 8 points for completion and 2 points for correctly solving Problem 4 (Exercise 3.1.12)." :tutorial/id #uuid "29d2d464-a28f-51b4-b672-b6fa1126d86f" :tutorial/title "Assignment information"}] [:tutorial/id #uuid "39bc60ca-a0c0-539d-aa68-d26bd190f094" {:db/id #edb/ref 17592186702516 :tutorial/content "**MTH 255 — Written Homework 5**\n\nDue: 2026-10-29\nDue time: 11:59 p.m. PDT\nDeadline source: [Fall 2026 Canvas assignment](https://canvas.oregonstate.edu/courses/2064132/assignments/10705976), checked 2026-10-25 (Thursday, October 29).\nDate imported: 2026-10-25\nSource: [MTH255-WHW-Week5_v1.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F255%2FWHW-5%2FMTH255-WHW-Week5_v1.pdf)\n\nStudy answers, worked explanations, and corrections discussed in the reveal fields are independently authored additions. The original tasks are retained, including assertions and notation that require qualification.\n\n## Instructions\n\n- Complete all five problems and their labeled subparts. Show clear, neat supporting work or a written explanation where appropriate. Correct answers without supporting work do not earn full credit.\n- Work on the printed template, write/type on the PDF with a tablet, or use your own paper with the same layout.\n- Submit a single PDF to Gradescope under **Written Homework 5**, in the template's six-page format: the cover page followed by one page for each problem. Include the cover and blank problems. If a solution uses multiple physical pages, combine them into one collage page for that problem. A scan of the printed template should preserve its page count and format.\n- The source awards partial credit for logical, organized progress. Canvas states that late homework is not accepted; submit completed work by the deadline.\n- In Problems 1–3, $\\mathbf T$ is the unit tangent in the stated counterclockwise direction and $\\mathbf n$ is the outward unit normal. Preserve the distinction between evaluating a contour integral directly and checking whether Green's theorem applies." :tutorial/id #uuid "39bc60ca-a0c0-539d-aa68-d26bd190f094" :tutorial/title "Assignment information"}] [:question/id #uuid "801c49f8-6d3c-5b5d-bb45-b51699b6a588" {:db/id #edb/ref 17592186702576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21410ab2-1320-5733-a152-ba355682038b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2" :db/id #edb/ref 17592186702491}] :answer-field/correct {:db/id #edb/ref 17592186702491} :answer-field/id #uuid "a3e230a5-1e46-54cb-a9a4-b1d5b27c32fc" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702618}] :question/id #uuid "801c49f8-6d3c-5b5d-bb45-b51699b6a588" :question/problem "**(a)(i)** For $\\mathbf F=\\langle-y,x\\rangle$, find its domain.\n\nDomain: {{answer}}." :question/worked-solution "The components are polynomial functions, so they are defined for every real pair $(x,y)$."}] [:question/id #uuid "805d0579-8e06-52e1-98ec-6d81588ca504" {:db/id #edb/ref 17592186702577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a7c0a2b-3a9f-5741-ad2d-ee14622e3578" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The matrix is transposed. Transposing a square matrix preserves its determinant: $\\det(A^T)=\\det(A)$." :db/id #edb/ref 17592186702526}] :answer-field/correct {:db/id #edb/ref 17592186702526} :answer-field/id #uuid "1b5e55df-c0dd-51ea-8df7-d165c685c016" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702488}] :question/id #uuid "805d0579-8e06-52e1-98ec-6d81588ca504" :question/problem "Source exercise: 3.1.9, printed page **127** (PDF page 139); the assignment sheet lists page 128.\n\nIdentify the operation that changes the first matrix to the second, and explain its effect on the determinant:\n\n$$\\begin{bmatrix}a&b\\\\c&d\\end{bmatrix}\\longrightarrow\\cdots\\longrightarrow\\begin{bmatrix}a&c\\\\b&d\\end{bmatrix}.$$" :question/worked-solution "The second matrix has the old rows as columns. Directly, the first determinant is $ad-bc$, and the second is $ad-cb=ad-bc$. This is transposition, rather than swapping two rows."}] [:question/id #uuid "83017630-13a4-55f0-8afa-98393d3821c9" {:db/id #edb/ref 17592186702580 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77f3dd9d-1119-51df-b553-4a43c4537b8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Choose every coefficient to be zero. Then $0\\vec x_1+\\cdots+0\\vec x_k=\\vec0$, which is a linear combination of the given vectors. Therefore $\\vec0$ belongs to their span." :db/id #edb/ref 17592186702568}] :answer-field/correct {:db/id #edb/ref 17592186702568} :answer-field/id #uuid "b78e587c-ee6e-563c-8b7d-dce6a4933d25" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702636}] :question/id #uuid "83017630-13a4-55f0-8afa-98393d3821c9" :question/problem "Source exercise: 4.10.10, printed page 222 (PDF page 234).\n\nSuppose $\\{\\vec x_1,\\ldots,\\vec x_k\\}$ is a set of vectors in $\\mathbb R^n$. Show that $\\vec0$ is in $\\operatorname{span}\\{\\vec x_1,\\ldots,\\vec x_k\\}$." :question/worked-solution "A span allows arbitrary real coefficients, including all zeros. The argument does not require the vectors to be nonzero or independent. Producing zero with all-zero coefficients does not demonstrate dependence; dependence requires a nontrivial zero combination."}] [:question/id #uuid "8391dbe2-9a3e-510f-9e77-9168461afd0d" {:db/id #edb/ref 17592186702581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3635d16-0a67-5cb9-816d-57f276fd04ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702681}] :answer-field/correct {:db/id #edb/ref 17592186702681} :answer-field/id #uuid "a64a5703-da96-51f8-bd37-e4a7f704835d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702620}] :question/id #uuid "8391dbe2-9a3e-510f-9e77-9168461afd0d" :question/problem "**(a)(ii)** For $\\mathbf F=\\langle-y,x\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds$ **by hand**. Show your parametrization and work.\n\nIntegral: {{answer}}." :question/worked-solution "Use $\\mathbf r(t)=(\\cos t,\\sin t)$, $0\\le t\\le2\\pi$. On the unit circle the denominator, when present, equals $1$, so $\\mathbf F(\\mathbf r(t))=(-\\sin t,\\cos t)=\\mathbf r'(t)$. Thus $\\mathbf F\\cdot\\mathbf T\\,ds=\\mathbf F(\\mathbf r(t))\\cdot\\mathbf r'(t)\\,dt=dt$ and the integral is $\\int_0^{2\\pi}1\\,dt=2\\pi$."}] [:question/id #uuid "83b569b0-0b6b-5273-ae4e-6e0b127fd30d" {:db/id #edb/ref 17592186702582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9baff282-1ea0-521b-a768-4edc1668a602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702604}] :answer-field/correct {:db/id #edb/ref 17592186702604} :answer-field/id #uuid "53586b83-f875-5cd5-a67c-0ff2bafda146" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702535}] :question/id #uuid "83b569b0-0b6b-5273-ae4e-6e0b127fd30d" :question/problem "**(b)(ii)** For $\\mathbf F=\\left\\langle\\frac{-y}{x^2+y^2},\\frac{x}{x^2+y^2}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds$ **by hand**. Show your parametrization and work.\n\nIntegral: {{answer}}." :question/worked-solution "Use $\\mathbf r(t)=(\\cos t,\\sin t)$, $0\\le t\\le2\\pi$. On the unit circle the denominator, when present, equals $1$, so $\\mathbf F(\\mathbf r(t))=(-\\sin t,\\cos t)=\\mathbf r'(t)$. Thus $\\mathbf F\\cdot\\mathbf T\\,ds=\\mathbf F(\\mathbf r(t))\\cdot\\mathbf r'(t)\\,dt=dt$ and the integral is $\\int_0^{2\\pi}1\\,dt=2\\pi$."}] [:question/id #uuid "902c743a-020b-59b4-af9d-0ead240033fc" {:db/id #edb/ref 17592186702593 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dbe677d-9a8d-5d73-9cab-fff2ee3533b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The first partial derivatives of $\\mathbf F=\\langle f,g\\rangle$ are $f_x,f_y,g_x,g_y$. Those of $\\mathbf G=\\langle-g,f\\rangle$ are $-g_x,-g_y,f_x,f_y$. Negating or reordering functions preserves continuity. Thus all first partial derivatives of one field are continuous on the region exactly when all first partial derivatives of the other are." :db/id #edb/ref 17592186702607}] :answer-field/correct {:db/id #edb/ref 17592186702607} :answer-field/id #uuid "9247c709-6ec6-5fab-9361-a6bbbe35271d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702597}] :question/id #uuid "902c743a-020b-59b4-af9d-0ead240033fc" :question/problem "**(a)** Show that $\\mathbf F$ has continuous first derivatives on and inside $C$ if and only if $\\mathbf G$ does." :question/worked-solution "Both fields use the same two scalar functions, with a sign change and a component swap. Check continuity of all four first partial derivatives on the same region; no application of Green's theorem is needed."}] [:question/id #uuid "907e212d-1b2f-56e7-8af5-1ad42ba5d639" {:db/id #edb/ref 17592186702594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b0dd9f7-e858-58c2-9622-30b01c571ba7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The instruction that both fields are conservative is false on the full stated domain. A global potential for $\\mathbf F$ is\n\n$$\\phi_F=\\tfrac12\\ln(x^2+y^2)=\\ln r.$$\n\nHowever, $\\oint_{r=1}\\mathbf G\\cdot\\mathbf T\\,ds=2\\pi\\ne0$, so $\\mathbf G$ has no single-valued global potential on the punctured plane. Consequently $\\mathbf F$ has no single-valued global stream function there.\n\nLocally, after choosing a continuous angle branch $\\theta=\\arg(x+iy)$ on a cut domain, $\\nabla\\theta=\\mathbf G$. Thus $\\phi_G=\\theta$ and $\\psi_F=\\theta$ work locally; on $x>0$ one may use $\\theta=\\arctan(y/x)$.\n\nBoth fields nevertheless have zero divergence and zero curl at every point of the stated domain. With $s=x^2+y^2$,\n\n$$\\operatorname{div}\\mathbf F=\\frac{s-2x^2+s-2y^2}{s^2}=0,\\qquad\n\\operatorname{curl}\\mathbf F=\\frac{-2xy+2xy}{s^2}=0,$$\n\n$$\\operatorname{div}\\mathbf G=\\frac{2xy-2xy}{s^2}=0,\\qquad\n\\operatorname{curl}\\mathbf G=\\frac{s-2x^2+s-2y^2}{s^2}=0.$$\n\nSo both meet the worksheet's zero-divergence/zero-curl conditions without both being globally conservative." :db/id #edb/ref 17592186702503}] :answer-field/correct {:db/id #edb/ref 17592186702503} :answer-field/id #uuid "9e1e9dba-f0f0-566b-bacd-0917f1f61821" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702609}] :question/id #uuid "907e212d-1b2f-56e7-8af5-1ad42ba5d639" :question/problem "**(c)** On $\\mathbb R^2\\setminus\\{(0,0)\\}$, let\n\n$$\\mathbf F=\\left\\langle\\frac{x}{x^2+y^2},\\frac{y}{x^2+y^2}\\right\\rangle,\\qquad\n\\mathbf G=\\left\\langle\\frac{-y}{x^2+y^2},\\frac{x}{x^2+y^2}\\right\\rangle.$$\n\n(i) Confirm both are conservative. Use Problem 1 to show $\\mathbf F$ is an ideal flow (and so is $\\mathbf G$).\n\n(ii) Find potential functions for both fields. Use Problem 1 to derive a stream function for $\\mathbf F$." :question/worked-solution "Curl zero on a domain with a hole does not guarantee a global potential. Use Problem 2(b)'s nonzero circulation to disprove the global claim for $\\mathbf G$. A discontinuous principal angle or a multi-valued angle is not a single-valued differentiable potential on the whole punctured plane. Problem 1(d) transfers exactly this obstruction to a global stream function for $\\mathbf F$."}] [:question/id #uuid "928d7776-a536-5089-a550-fc78255e94dc" {:db/id #edb/ref 17592186702598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278bcbd6-88ef-53b1-8c5c-f9a389d47fa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702495}] :answer-field/correct {:db/id #edb/ref 17592186702495} :answer-field/id #uuid "52d06fdc-3175-52f3-b479-8c57eb944433" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702534}] :question/id #uuid "928d7776-a536-5089-a550-fc78255e94dc" :question/problem "**(c)(ii)** For $\\mathbf F=\\left\\langle\\frac{x}{\\sqrt{x^2+y^2}},\\frac{y}{\\sqrt{x^2+y^2}}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds$ **by hand**. Show your parametrization and work.\n\nIntegral: {{answer}}." :question/worked-solution "On the unit circle, parametrize by $\\mathbf r(t)=(\\cos t,\\sin t)$, $0\\le t\\le2\\pi$. The outward unit normal is $(\\cos t,\\sin t)$ and $ds=dt$. Each field in this problem restricts to $(\\cos t,\\sin t)$ on $C$, so the flux is $\\int_0^{2\\pi}(\\cos^2t+\\sin^2t)\\,dt=2\\pi$. Equivalently, rotate the field as in Problem 1(c) and use the corresponding circulation in Problem 2."}] [:question/id #uuid "966de5ce-896c-5026-ae25-aa55dd1e00a5" {:db/id #edb/ref 17592186702602 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d0ab866-196e-52dc-89f3-7c3a4c5069af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "They are dependent because $\\vec v_3=-2\\vec v_1+3\\vec v_2$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_4\\}$." :db/id #edb/ref 17592186702590}] :answer-field/correct {:db/id #edb/ref 17592186702590} :answer-field/id #uuid "cbbef084-1b60-5586-a0c5-aeba84ea1799" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702655}] :question/id #uuid "966de5ce-896c-5026-ae25-aa55dd1e00a5" :question/problem "Source exercise: 4.10.18, printed page 224 (PDF page 236).\n\nAre the following vectors linearly independent? If they are, explain why. If they are not, exhibit one as a linear combination of the others. Also give a linearly independent set with the same span.\n\n$$\\vec v_1=\\begin{bmatrix}1\\\\4\\\\-2\\\\1\\end{bmatrix},\\quad\\vec v_2=\\begin{bmatrix}1\\\\5\\\\-3\\\\1\\end{bmatrix},\\quad\\vec v_3=\\begin{bmatrix}1\\\\7\\\\-5\\\\1\\end{bmatrix},\\quad\\vec v_4=\\begin{bmatrix}1\\\\5\\\\-2\\\\1\\end{bmatrix}.$$" :question/worked-solution "The combination checks as $-2(1,4,-2,1)+3(1,5,-3,1)=(1,7,-5,1)$. For the proposed independent set, use the first three coordinate rows. The determinant of $\\begin{bmatrix}1&1&1\\\\4&5&5\\\\-2&-3&-2\\end{bmatrix}$ is $1$, proving independence. The removed vector $\\vec v_3$ is generated by the retained ones, so their spans agree."}] [:question/id #uuid "9dbe21c8-f881-59e7-ad0d-69a6eb42dd99" {:db/id #edb/ref 17592186702606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71c153c5-b242-591a-bc0e-031852d164f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Potentials are $\\phi_F=(x^2-y^2)/2$ and $\\phi_G=xy$, since $\\nabla\\phi_F=(x,-y)$ and $\\nabla\\phi_G=(y,x)$. A stream function for $\\mathbf F$ is $\\psi=xy$.\n\nBoth curls are zero because the fields are gradients. Also, $\\operatorname{div}\\mathbf F=1-1=0$ and $\\operatorname{div}\\mathbf G=0+0=0$. Thus both have zero divergence and zero curl, as required here. Problem 1(b) gives $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G=0$. Applying it to $\\mathbf G$, whose rotated field is $-\\mathbf F$, also gives $\\operatorname{div}\\mathbf G=-\\operatorname{curl}\\mathbf F=0$. Problem 1(d) identifies the potential of $\\mathbf G$ with the stream function of $\\mathbf F$." :db/id #edb/ref 17592186702560}] :answer-field/correct {:db/id #edb/ref 17592186702560} :answer-field/id #uuid "c479ba4b-591e-5cb9-a0e1-516fc2d62542" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702650}] :question/id #uuid "9dbe21c8-f881-59e7-ad0d-69a6eb42dd99" :question/problem "**(a)** $\\mathbf F=\\langle x,-y\\rangle$, $\\mathbf G=\\langle y,x\\rangle$ on $\\mathbb R^2$.\n\n(i) Confirm both are conservative. Use Problem 1 to show $\\mathbf F$ is an ideal flow (and so is $\\mathbf G$).\n\n(ii) Find potential functions for both fields. Use Problem 1 to derive a stream function for $\\mathbf F$." :question/worked-solution "Differentiate each potential to check both components. For $\\psi=xy$, $\\psi_y=x=F_1$ and $\\psi_x=y=-F_2$. Additive constants do not change any of these fields. The calculations verify the worksheet's stated zero-divergence/zero-curl conditions."}] [:question/id #uuid "9ea201a6-ed27-5da6-a639-d9b36c73f06a" {:db/id #edb/ref 17592186702610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d6cdc8a-250d-53ce-88eb-c7c7b3345fb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702592}] :answer-field/correct {:db/id #edb/ref 17592186702592} :answer-field/id #uuid "eb5276e7-dfa6-52f1-9f07-b3410db173fe" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702689}] :question/id #uuid "9ea201a6-ed27-5da6-a639-d9b36c73f06a" :question/problem "**(b)(i)** For $\\mathbf F=\\left\\langle\\frac{-y}{x^2+y^2},\\frac{x}{x^2+y^2}\\right\\rangle$, find its domain.\n\nDomain: {{answer}}." :question/worked-solution "The denominator vanishes exactly at $(0,0)$. Exclude the origin; the field is smooth everywhere else."}] [:question/id #uuid "9fb2ff51-bb0a-56d9-9343-4ddf27f72f30" {:db/id #edb/ref 17592186702614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92df2acd-bb90-5c44-81fa-525df536f59e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r>0$, $\\operatorname{div}\\mathbf F=1/r$. The formal area integral can be interpreted as an improper integral:\n\n$$\\lim_{\\varepsilon\\to0^+}\\int_0^{2\\pi}\\int_\\varepsilon^1\\frac1r\\,r\\,dr\\,d\\theta\n=\\lim_{\\varepsilon\\to0^+}2\\pi(1-\\varepsilon)=2\\pi.$$\n\nThe standard full-disk theorem does not apply directly because the field is undefined at the origin. The equality can be justified by applying Green's theorem to annuli and taking a limit." :db/id #edb/ref 17592186702599}] :answer-field/correct {:db/id #edb/ref 17592186702599} :answer-field/id #uuid "04e2bfc2-14e3-57f6-9455-b8939e0b7a26" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702475}] :question/id #uuid "9fb2ff51-bb0a-56d9-9343-4ddf27f72f30" :question/problem "**(c)(iii)** For $\\mathbf F=\\left\\langle\\frac{x}{\\sqrt{x^2+y^2}},\\frac{y}{\\sqrt{x^2+y^2}}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds$ “using” Green's theorem. Address any failure of its hypotheses." :question/worked-solution "For a radius-$\\varepsilon$ circle, the counterclockwise circulation (Problem 2) or outward-from-the-small-disk flux (Problem 3) is $2\\pi\\varepsilon$, which tends to zero. The annulus formula is outer integral minus that inner integral $=2\\pi(1-\\varepsilon)$. The Jacobian factor $r$ cancels the singular factor $1/r$ in the improper area integral."}] [:question/id #uuid "a55585d2-0b0b-5446-a66e-5e37d60fbf20" {:db/id #edb/ref 17592186702619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bf6e3f3-eb49-5df5-bc3e-82d627dcb3d0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Take $\\phi_F=e^x\\cos y$ and $\\phi_G=e^x\\sin y$. Their gradients are exactly the two specified fields, so both are conservative. A stream function for $\\mathbf F$ is $\\psi=e^x\\sin y$.\n\nTheir divergences are $e^x\\cos y-e^x\\cos y=0$ and $e^x\\sin y-e^x\\sin y=0$. Their curls are also zero: for $\\mathbf F$, $-e^x\\sin y-(-e^x\\sin y)=0$; for $\\mathbf G$, $e^x\\cos y-e^x\\cos y=0$. Problem 1(b) gives $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G=0$ and, after rotating $\\mathbf G$ to $-\\mathbf F$, $\\operatorname{div}\\mathbf G=-\\operatorname{curl}\\mathbf F=0$. Thus both meet the stated ideal-flow conditions." :db/id #edb/ref 17592186702541}] :answer-field/correct {:db/id #edb/ref 17592186702541} :answer-field/id #uuid "c5aecf12-592a-520d-8c44-f9e640f5c8e2" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702651}] :question/id #uuid "a55585d2-0b0b-5446-a66e-5e37d60fbf20" :question/problem "**(b)** $\\mathbf F=\\langle e^x\\cos y,-e^x\\sin y\\rangle$, $\\mathbf G=\\langle e^x\\sin y,e^x\\cos y\\rangle$ on $\\mathbb R^2$.\n\n(i) Confirm both are conservative. Use Problem 1 to show $\\mathbf F$ is an ideal flow (and so is $\\mathbf G$).\n\n(ii) Find potential functions for both fields. Use Problem 1 to derive a stream function for $\\mathbf F$." :question/worked-solution "For the stream function, check $\\psi_y=e^x\\cos y=F_1$ and $\\psi_x=e^x\\sin y=-F_2$. When differentiating in $y$, the sign in $(\\cos y)'=-\\sin y$ matters. Potentials are defined on the entire stated plane."}] [:question/id #uuid "a79033ef-5319-5e1b-a2ab-133175d056cc" {:db/id #edb/ref 17592186702623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "462deff5-b92c-575b-bde8-d2e265a1bc6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both computations yield $2\\pi$, but the agreement alone does not make a direct full-disk invocation of Green's theorem valid. The origin is excluded from the domain. In this case, annular applications and a limit do justify the equality, because the inner-boundary contribution tends to zero." :db/id #edb/ref 17592186702524}] :answer-field/correct {:db/id #edb/ref 17592186702524} :answer-field/id #uuid "255fb13b-2536-5f76-84c6-25f80be7d7c1" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702494}] :question/id #uuid "a79033ef-5319-5e1b-a2ab-133175d056cc" :question/problem "**(c)(iv)** For $\\mathbf F=\\left\\langle\\frac{x}{\\sqrt{x^2+y^2}},\\frac{y}{\\sqrt{x^2+y^2}}\\right\\rangle$, compare your answers to (ii) and (iii). Use the domain from (i) to explain any difference." :question/worked-solution "The domain and interior regularity explain whether the usual theorem applies. A matching numerical value can also occur through a justified improper limit."}] [:question/id #uuid "ae7af27d-2f3d-57f9-859d-20a413d678ca" {:db/id #edb/ref 17592186702626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2e1fa68-9010-5f23-9d15-43d096747c65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No. Each generating vector satisfies $z=-2x$, so every linear combination also satisfies $z=-2x$. The target has $x=1$ and $z=-1$, which fails that relation. It is outside the span, so no such linear combination exists." :db/id #edb/ref 17592186702646}] :answer-field/correct {:db/id #edb/ref 17592186702646} :answer-field/id #uuid "2520bb94-4364-510b-ad49-85cc3ab85797" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702493}] :question/id #uuid "ae7af27d-2f3d-57f9-859d-20a413d678ca" :question/problem "Source exercise: 4.10.4, printed page 221 (PDF page 233).\n\nConsider\n\n$$\\vec v_1=\\begin{bmatrix}1\\\\1\\\\-2\\end{bmatrix},\\quad\\vec v_2=\\begin{bmatrix}1\\\\2\\\\-2\\end{bmatrix},\\quad\\vec v_3=\\begin{bmatrix}1\\\\-3\\\\-2\\end{bmatrix},\\quad\\vec v_4=\\begin{bmatrix}-1\\\\1\\\\2\\end{bmatrix}.$$\n\nIs $\\vec w=\\begin{bmatrix}1\\\\2\\\\-1\\end{bmatrix}$ in their span? If so, exhibit a linear combination equal to $\\vec w$, using as few of the four vectors as possible." :question/worked-solution "If $\\sum c_j\\vec v_j=\\vec w$, the first-coordinate equation would give $c_1+c_2+c_3-c_4=1$, while the third would give $-2(c_1+c_2+c_3-c_4)=-1$. The first equation makes the third left side $-2$, a contradiction. The requested minimal combination is conditional on membership."}] [:question/id #uuid "aeff0721-b0ec-58e0-9819-86270bef6b68" {:db/id #edb/ref 17592186702627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6df2a8bc-93cf-5744-a847-7101bcc33f96" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. The combination is $\\vec v=2\\vec u_1-\\vec u_2$:\n\n$$2\\begin{bmatrix}3\\\\1\\\\-1\\end{bmatrix}-\\begin{bmatrix}2\\\\-2\\\\1\\end{bmatrix}=\\begin{bmatrix}4\\\\4\\\\-3\\end{bmatrix}.$$" :db/id #edb/ref 17592186702552}] :answer-field/correct {:db/id #edb/ref 17592186702552} :answer-field/id #uuid "fb07ab3d-0094-592c-9ddf-240db93273a6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702701}] :question/id #uuid "aeff0721-b0ec-58e0-9819-86270bef6b68" :question/problem "Source exercise: 4.2.3, printed page 151 (PDF page 163).\n\nDecide whether\n\n$$\\vec v=\\begin{bmatrix}4\\\\4\\\\-3\\end{bmatrix}$$\n\nis a linear combination of\n\n$$\\vec u_1=\\begin{bmatrix}3\\\\1\\\\-1\\end{bmatrix},\\qquad\\vec u_2=\\begin{bmatrix}2\\\\-2\\\\1\\end{bmatrix}.$$" :question/worked-solution "Set $a\\vec u_1+b\\vec u_2=\\vec v$. The first two equations are $3a+2b=4$ and $a-2b=4$, giving $a=2$, $b=-1$. Check the third equation: $-a+b=-2-1=-3$. All three coordinates must agree."}] [:question/id #uuid "b4665601-40c2-5b3f-a350-06e2c0c35701" {:db/id #edb/ref 17592186702634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77b2897b-cbba-5228-9728-60335f0049bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Direct calculation gives $2\\pi$, while the invalid full-disk use of Green's theorem gives $0$. The domain excludes the origin, so the theorem's regularity hypothesis fails inside $C$. The mismatch comes from ignoring the hole and its inner boundary, rather than from an error in the direct parametrization." :db/id #edb/ref 17592186702567}] :answer-field/correct {:db/id #edb/ref 17592186702567} :answer-field/id #uuid "e4f8063b-1332-5a48-846e-e72a213d3c38" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702683}] :question/id #uuid "b4665601-40c2-5b3f-a350-06e2c0c35701" :question/problem "**(b)(iv)** For $\\mathbf F=\\left\\langle\\frac{-y}{x^2+y^2},\\frac{x}{x^2+y^2}\\right\\rangle$, compare your answers to (ii) and (iii). Use the domain from (i) to explain any difference." :question/worked-solution "The domain and interior regularity explain whether the usual theorem applies. Account for every boundary component when working on a punctured region."}] [:question/id #uuid "c22bbe58-4929-5199-bc86-6f6e6f712841" {:db/id #edb/ref 17592186702645 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c446cbe1-2870-520a-88fa-d8558d9032bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702649}] :answer-field/correct {:db/id #edb/ref 17592186702649} :answer-field/id #uuid "8b628751-9b0a-5e3a-8424-44e093fc265c" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702588}] :question/id #uuid "c22bbe58-4929-5199-bc86-6f6e6f712841" :question/problem "**(c)(i)** For $\\mathbf F=\\left\\langle\\frac{-y}{\\sqrt{x^2+y^2}},\\frac{x}{\\sqrt{x^2+y^2}}\\right\\rangle$, find its domain.\n\nDomain: {{answer}}." :question/worked-solution "The denominator vanishes exactly at $(0,0)$. Exclude the origin; the field is smooth everywhere else."}] [:question/id #uuid "d13cb879-cfc1-5508-95b7-b45cbb676eab" {:db/id #edb/ref 17592186702656 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d41b273d-8e09-5af7-a5ea-44d7947cab94" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r>0$, $\\operatorname{curl}\\mathbf F=1/r$. The formal area integral can be interpreted as an improper integral:\n\n$$\\lim_{\\varepsilon\\to0^+}\\int_0^{2\\pi}\\int_\\varepsilon^1\\frac1r\\,r\\,dr\\,d\\theta\n=\\lim_{\\varepsilon\\to0^+}2\\pi(1-\\varepsilon)=2\\pi.$$\n\nThe standard full-disk theorem does not apply directly because the field is undefined at the origin. The equality can be justified by applying Green's theorem to annuli and taking a limit." :db/id #edb/ref 17592186702660}] :answer-field/correct {:db/id #edb/ref 17592186702660} :answer-field/id #uuid "b105b52f-d67c-5f04-9f64-f2c5d7a169ce" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702630}] :question/id #uuid "d13cb879-cfc1-5508-95b7-b45cbb676eab" :question/problem "**(c)(iii)** For $\\mathbf F=\\left\\langle\\frac{-y}{\\sqrt{x^2+y^2}},\\frac{x}{\\sqrt{x^2+y^2}}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds$ “using” Green's theorem. Address any failure of its hypotheses." :question/worked-solution "For a radius-$\\varepsilon$ circle, the counterclockwise circulation (Problem 2) or outward-from-the-small-disk flux (Problem 3) is $2\\pi\\varepsilon$, which tends to zero. The annulus formula is outer integral minus that inner integral $=2\\pi(1-\\varepsilon)$. The Jacobian factor $r$ cancels the singular factor $1/r$ in the improper area integral."}] [:question/id #uuid "d33be294-ddfc-53f2-a3fd-b598d37f5af2" {:db/id #edb/ref 17592186702658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0a128c0-135d-59fc-9633-3ad9971ff100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "375" :db/id #edb/ref 17592186702615}] :answer-field/correct {:db/id #edb/ref 17592186702615} :answer-field/id #uuid "83f4bdec-7b5a-5c57-b8ae-f451d3a4a3f2" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702583}] :question/id #uuid "d33be294-ddfc-53f2-a3fd-b598d37f5af2" :question/problem "Source exercise: 3.1.3(b) only, printed page 126 (PDF page 138).\n\nFind the determinant of $\\begin{bmatrix}4&3&2\\\\1&7&8\\\\3&-9&3\\end{bmatrix}$ **by hand, without technology**. Show your calculation.\n\nDeterminant: {{answer}}." :question/worked-solution "Expand along the first row, using signs $+,-,+$:\n\n$$4\\begin{vmatrix}7&8\\\\-9&3\\end{vmatrix}-3\\begin{vmatrix}1&8\\\\3&3\\end{vmatrix}+2\\begin{vmatrix}1&7\\\\3&-9\\end{vmatrix}\n=4(21+72)-3(3-24)+2(-9-21)=372+63-60=375.$$\n\nThe negative cofactor sign on the middle term is essential. A separate elimination check gives the same determinant."}] [:question/id #uuid "db96b7bd-b499-5e7f-95b8-f881abd22b47" {:db/id #edb/ref 17592186702670 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "173df41c-e05b-574e-aa20-a8d310566036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702485}] :answer-field/correct {:db/id #edb/ref 17592186702485} :answer-field/id #uuid "624366ae-d5ee-5a3c-832e-2d130d6bef73" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702545}] :question/id #uuid "db96b7bd-b499-5e7f-95b8-f881abd22b47" :question/problem "**(c)(i)** For $\\mathbf F=\\left\\langle\\frac{x}{\\sqrt{x^2+y^2}},\\frac{y}{\\sqrt{x^2+y^2}}\\right\\rangle$, find its domain.\n\nDomain: {{answer}}." :question/worked-solution "The denominator vanishes exactly at $(0,0)$. Exclude the origin; the field is smooth everywhere else."}] [:question/id #uuid "dbf8337b-9305-5996-b9f3-a273a9b46392" {:db/id #edb/ref 17592186702671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b071b47f-2819-58f0-9029-2235f9736418" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Direct calculation gives $2\\pi$, while the invalid full-disk use of Green's theorem gives $0$. The domain excludes the origin, so the theorem's regularity hypothesis fails inside $C$. The mismatch comes from ignoring the hole and its inner boundary, rather than from an error in the direct parametrization." :db/id #edb/ref 17592186702629}] :answer-field/correct {:db/id #edb/ref 17592186702629} :answer-field/id #uuid "152a12f0-6d22-58b0-8680-bd6807c31650" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702483}] :question/id #uuid "dbf8337b-9305-5996-b9f3-a273a9b46392" :question/problem "**(b)(iv)** For $\\mathbf F=\\left\\langle\\frac{x}{x^2+y^2},\\frac{y}{x^2+y^2}\\right\\rangle$, compare your answers to (ii) and (iii). Use the domain from (i) to explain any difference." :question/worked-solution "The domain and interior regularity explain whether the usual theorem applies. Account for every boundary component when working on a punctured region."}] [:question/id #uuid "dcefba0d-2688-5369-bb33-ab870575ea0e" {:db/id #edb/ref 17592186702672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5805a00c-2392-5a80-91e5-b6d845f1b4dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Here $\\operatorname{div}\\mathbf F=2$. Green's theorem applies because the field is $C^1$ on the entire disk and a neighborhood of it. Therefore\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds=\\iint_D2\\,dA=2\\operatorname{area}(D)=2\\pi.$$" :db/id #edb/ref 17592186702538}] :answer-field/correct {:db/id #edb/ref 17592186702538} :answer-field/id #uuid "d7f44212-59a7-5458-9982-5b4bacf1ad15" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702667}] :question/id #uuid "dcefba0d-2688-5369-bb33-ab870575ea0e" :question/problem "**(a)(iii)** For $\\mathbf F=\\langle x,y\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds$ “using” Green's theorem. Address any failure of its hypotheses." :question/worked-solution "Check the theorem hypotheses before replacing the boundary integral with an area integral. This field has no singularity in the disk."}] [:question/id #uuid "dd430fe7-1424-596e-9a91-6d7e40f17498" {:db/id #edb/ref 17592186702673 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9183a5c7-138b-5916-9785-973488ce8174" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both methods give $2\\pi$. The field is defined and continuously differentiable on and inside the unit circle, so Green's theorem legitimately relates the two integrals." :db/id #edb/ref 17592186702595}] :answer-field/correct {:db/id #edb/ref 17592186702595} :answer-field/id #uuid "51c81fbb-ed83-50be-ab54-2da572103db1" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702533}] :question/id #uuid "dd430fe7-1424-596e-9a91-6d7e40f17498" :question/problem "**(a)(iv)** For $\\mathbf F=\\langle-y,x\\rangle$, compare your answers to (ii) and (iii). Use the domain from (i) to explain any difference." :question/worked-solution "The domain and interior regularity explain whether the usual theorem applies. Account for every boundary component when working on a punctured region."}] [:question/id #uuid "dee55dc8-025d-5e2e-81d6-81ca2cb50427" {:db/id #edb/ref 17592186702675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "790d672e-a0a4-5642-aed9-0114d854a533" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702570}] :answer-field/correct {:db/id #edb/ref 17592186702570} :answer-field/id #uuid "a71b514a-9026-5f64-8d2d-53ce75beba13" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702621}] :question/id #uuid "dee55dc8-025d-5e2e-81d6-81ca2cb50427" :question/problem "**(a)(ii)** For $\\mathbf F=\\langle x,y\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds$ **by hand**. Show your parametrization and work.\n\nIntegral: {{answer}}." :question/worked-solution "On the unit circle, parametrize by $\\mathbf r(t)=(\\cos t,\\sin t)$, $0\\le t\\le2\\pi$. The outward unit normal is $(\\cos t,\\sin t)$ and $ds=dt$. Each field in this problem restricts to $(\\cos t,\\sin t)$ on $C$, so the flux is $\\int_0^{2\\pi}(\\cos^2t+\\sin^2t)\\,dt=2\\pi$. Equivalently, rotate the field as in Problem 1(c) and use the corresponding circulation in Problem 2."}] [:question/id #uuid "dfbb5de7-beaf-5fb0-90e3-2d39d8ba3cff" {:db/id #edb/ref 17592186702677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f481c20-7669-5276-b056-49ea2dd62d6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186702554}] :answer-field/correct {:db/id #edb/ref 17592186702554} :answer-field/id #uuid "03ef442c-08c2-5fcb-b489-c016fa035c1a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702474}] :question/id #uuid "dfbb5de7-beaf-5fb0-90e3-2d39d8ba3cff" :question/problem "**(c)** Find the determinant of $\\begin{bmatrix}4&3\\\\6&2\\end{bmatrix}$ **by hand, without technology**. Show your calculation.\n\nDeterminant: {{answer}}." :question/worked-solution "$4(2)-3(6)=8-18=-10$. For a $2\\times2$ matrix, $\\det\\begin{bmatrix}a&b\\\\c&d\\end{bmatrix}=ad-bc$. Apply the subtraction in that order."}] [:question/id #uuid "e9fd56fb-cbf6-5c16-ab37-31f9e80ce801" {:db/id #edb/ref 17592186702688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31371801-c4b1-5108-988b-f1287d84a642" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186702511}] :answer-field/correct {:db/id #edb/ref 17592186702511} :answer-field/id #uuid "e7ea4d25-8305-5f9b-afae-16246b0c0f6f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702685}] :question/id #uuid "e9fd56fb-cbf6-5c16-ab37-31f9e80ce801" :question/problem "**(a)** Find the determinant of $\\begin{bmatrix}1&3\\\\0&2\\end{bmatrix}$ **by hand, without technology**. Show your calculation.\n\nDeterminant: {{answer}}." :question/worked-solution "$1(2)-3(0)=2$. For a $2\\times2$ matrix, $\\det\\begin{bmatrix}a&b\\\\c&d\\end{bmatrix}=ad-bc$. Apply the subtraction in that order."}] [:question/id #uuid "ed7bee5a-40a1-5e12-b77a-153dac1f8572" {:db/id #edb/ref 17592186702690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e9ebcbc-b2da-58eb-b0aa-d994e87d860f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $P=(x_0,y_0)$, parametrize the line by $(x,y)=(x_0,y_0)+t(f(x_0,y_0),g(x_0,y_0))$. Its slope is $\\Delta y/\\Delta x=g(x_0,y_0)/f(x_0,y_0)$ when $f(x_0,y_0)\\ne0$. If $f=0$ and $g\\ne0$, the line is vertical. If $f=g=0$, the zero field vector specifies no direction." :db/id #edb/ref 17592186702518}] :answer-field/correct {:db/id #edb/ref 17592186702518} :answer-field/id #uuid "7a5da541-73c6-5b07-965c-962d03521a2f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702571}] :question/id #uuid "ed7bee5a-40a1-5e12-b77a-153dac1f8572" :question/problem "**(a)** Prove, or otherwise convince yourself, that the line through $P$ with the same direction as $\\mathbf F(x,y)$ has slope $g(x,y)/f(x,y)$." :question/worked-solution "A direction vector $(f,g)$ has horizontal change proportional to $f$ and vertical change proportional to $g$. State the nonzero-denominator condition rather than assigning a finite slope to a vertical line."}] [:question/id #uuid "ef048ef7-89ae-5256-b240-39323889add5" {:db/id #edb/ref 17592186702692 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d73965e8-b478-5301-a93b-edc40660a598" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r=\\sqrt{x^2+y^2}>0$, $\\operatorname{div}\\mathbf F=0$. Formally integrating that expression over the punctured disk gives $0$.\n\nThis is not a valid application of Green's theorem to the full disk: the field is undefined at the origin, which lies inside $C$. The actual boundary integral is $2\\pi$." :db/id #edb/ref 17592186702664}] :answer-field/correct {:db/id #edb/ref 17592186702664} :answer-field/id #uuid "1ca929f9-9e00-5d43-8750-3ee995575df3" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702489}] :question/id #uuid "ef048ef7-89ae-5256-b240-39323889add5" :question/problem "**(b)(iii)** For $\\mathbf F=\\left\\langle\\frac{x}{x^2+y^2},\\frac{y}{x^2+y^2}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds$ “using” Green's theorem. Address any failure of its hypotheses." :question/worked-solution "The formal value $0$ is the result the question asks you to compare, not a correct value of the contour integral. On an annulus $\\varepsilon\\le r\\le1$, Green's theorem has both outer and inner boundaries. The outer integral minus the counterclockwise inner integral is $0$; each counterclockwise integral is $2\\pi$. Omitting the inner boundary loses that contribution."}] [:question/id #uuid "08ca2ee1-3c85-5376-b8cd-192882ba0fb1" {:db/id #edb/ref 17592186702478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fadeb1c3-2fac-5963-9372-602255cf90fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702700}] :answer-field/correct {:db/id #edb/ref 17592186702700} :answer-field/id #uuid "8ba64de1-78df-526b-a684-fb466addd1c0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702589}] :question/id #uuid "08ca2ee1-3c85-5376-b8cd-192882ba0fb1" :question/problem "**(b)(ii)** For $\\mathbf F=\\left\\langle\\frac{x}{x^2+y^2},\\frac{y}{x^2+y^2}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds$ **by hand**. Show your parametrization and work.\n\nIntegral: {{answer}}." :question/worked-solution "On the unit circle, parametrize by $\\mathbf r(t)=(\\cos t,\\sin t)$, $0\\le t\\le2\\pi$. The outward unit normal is $(\\cos t,\\sin t)$ and $ds=dt$. Each field in this problem restricts to $(\\cos t,\\sin t)$ on $C$, so the flux is $\\int_0^{2\\pi}(\\cos^2t+\\sin^2t)\\,dt=2\\pi$. Equivalently, rotate the field as in Problem 1(c) and use the corresponding circulation in Problem 2."}] [:question/id #uuid "0c4ee11a-932b-509f-9464-bca3b0b4f4af" {:db/id #edb/ref 17592186702480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c023af7-0fa4-5186-8428-fbbabdcb5778" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Parametrize the counterclockwise curve by $\\mathbf r(t)=(x(t),y(t))$. Where the tangent exists, the outward normal is the clockwise rotation of the tangent, hence $\\mathbf n\\,ds=(y'(t),-x'(t))\\,dt$. Therefore\n\n$$\\mathbf F\\cdot\\mathbf n\\,ds=(fy'-gx')\\,dt=(-g,f)\\cdot(x',y')\\,dt=\\mathbf G\\cdot\\mathbf T\\,ds.$$\n\nIntegrate this pointwise identity over $C$ (piecewise for a piecewise smooth curve)." :db/id #edb/ref 17592186702479}] :answer-field/correct {:db/id #edb/ref 17592186702479} :answer-field/id #uuid "e423325b-ccb6-5a16-a938-bf8fae815cba" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702682}] :question/id #uuid "0c4ee11a-932b-509f-9464-bca3b0b4f4af" :question/problem "**(c)** Show that\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds=\\oint_C\\mathbf G\\cdot\\mathbf T\\,ds.$$\n\n**Source note:** Green's theorem may not apply. Instead, try to show $\\mathbf F\\cdot\\mathbf n\\,ds=\\mathbf G\\cdot\\mathbf T\\,ds$." :question/worked-solution "The equality depends on the orientation and the quarter-turn relating the two fields. It requires the boundary integrals to exist, but does not require either field to be continuously differentiable throughout the interior, so it remains useful when Green's theorem is unavailable."}] [:question/id #uuid "14788faa-d3cc-5182-ad0e-db1af58157e7" {:db/id #edb/ref 17592186702482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e6eb92b-c2bf-5fd9-ac1d-05691eb1508e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both computations yield $2\\pi$, but the agreement alone does not make a direct full-disk invocation of Green's theorem valid. The origin is excluded from the domain. In this case, annular applications and a limit do justify the equality, because the inner-boundary contribution tends to zero." :db/id #edb/ref 17592186702530}] :answer-field/correct {:db/id #edb/ref 17592186702530} :answer-field/id #uuid "478334df-2d59-5e3d-884a-48ed7220e653" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702525}] :question/id #uuid "14788faa-d3cc-5182-ad0e-db1af58157e7" :question/problem "**(c)(iv)** For $\\mathbf F=\\left\\langle\\frac{-y}{\\sqrt{x^2+y^2}},\\frac{x}{\\sqrt{x^2+y^2}}\\right\\rangle$, compare your answers to (ii) and (iii). Use the domain from (i) to explain any difference." :question/worked-solution "The domain and interior regularity explain whether the usual theorem applies. A matching numerical value can also occur through a justified improper limit."}] [:question/id #uuid "1702368e-f0bc-528a-a104-7f0612080884" {:db/id #edb/ref 17592186702484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7667b11-d5f9-5246-834a-a9f6246331ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r=\\sqrt{x^2+y^2}>0$, $\\operatorname{curl}\\mathbf F=0$. Formally integrating that expression over the punctured disk gives $0$.\n\nThis is not a valid application of Green's theorem to the full disk: the field is undefined at the origin, which lies inside $C$. The actual boundary integral is $2\\pi$." :db/id #edb/ref 17592186702622}] :answer-field/correct {:db/id #edb/ref 17592186702622} :answer-field/id #uuid "8a26eece-73eb-5425-ab5c-008b42b0892b" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702585}] :question/id #uuid "1702368e-f0bc-528a-a104-7f0612080884" :question/problem "**(b)(iii)** For $\\mathbf F=\\left\\langle\\frac{-y}{x^2+y^2},\\frac{x}{x^2+y^2}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds$ “using” Green's theorem. Address any failure of its hypotheses." :question/worked-solution "The formal value $0$ is the result the question asks you to compare, not a correct value of the contour integral. On an annulus $\\varepsilon\\le r\\le1$, Green's theorem has both outer and inner boundaries. The outer integral minus the counterclockwise inner integral is $0$; each counterclockwise integral is $2\\pi$. Omitting the inner boundary loses that contribution."}] [:question/id #uuid "181efbc3-58c9-5d77-9233-3e50034e40ce" {:db/id #edb/ref 17592186702486 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a77ad0c-9822-5e2c-b80f-2602ffd6d7aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Using planar scalar curl,\n\n$$\\operatorname{div}\\mathbf F=f_x+g_y,\\qquad\\operatorname{curl}\\mathbf G=f_x-(-g)_y=f_x+g_y.$$\n\nThe expressions are identical, so one is zero exactly when the other is zero. These are the definitions of source-free and irrotational, respectively." :db/id #edb/ref 17592186702500}] :answer-field/correct {:db/id #edb/ref 17592186702500} :answer-field/id #uuid "b1f05870-a3a6-5713-92fb-c66be8566641" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702631}] :question/id #uuid "181efbc3-58c9-5d77-9233-3e50034e40ce" :question/problem "**(b)** Show that $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G$. In particular, show $\\operatorname{div}\\mathbf F=0$ iff $\\operatorname{curl}\\mathbf G=0$. Conclude that $\\mathbf F$ is source-free iff $\\mathbf G$ is irrotational." :question/worked-solution "For $\\langle P,Q\\rangle$, divergence is $P_x+Q_y$, while planar curl is $Q_x-P_y$. The minus sign on the first component of $\\mathbf G$ makes its curl equal to the divergence of $\\mathbf F$."}] [:question/id #uuid "1fb3669f-d6c2-5778-940b-a11e36dc9cd0" {:db/id #edb/ref 17592186702490 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "001f6717-2818-512e-be5a-c55f0d4a02ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "63" :db/id #edb/ref 17592186702471}] :answer-field/correct {:db/id #edb/ref 17592186702471} :answer-field/id #uuid "2b9aeba5-da06-5e9b-a4e0-532626735baf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702506}] :question/id #uuid "1fb3669f-d6c2-5778-940b-a11e36dc9cd0" :question/problem "Source exercise: 3.1.24, printed page **129** (PDF page 141); the assignment sheet lists page 128.\n\nFind the determinant, **using row operations to simplify first**. Show your row operations and track their effects on the determinant.\n\n$$A=\\begin{bmatrix}1&2&1&2\\\\3&1&-2&3\\\\-1&0&3&1\\\\2&3&2&-2\\end{bmatrix}.$$\n\n$\\det(A)=$ {{answer}}." :question/worked-solution "First use $R_2\\leftarrow R_2-3R_1$, $R_3\\leftarrow R_3+R_1$, and $R_4\\leftarrow R_4-2R_1$. These row replacements preserve the determinant:\n\n$$\\begin{bmatrix}1&2&1&2\\\\0&-5&-5&-3\\\\0&2&4&3\\\\0&-1&0&-6\\end{bmatrix}.$$\n\nSwap $R_2$ and $R_4$ once, changing the determinant's sign. Then apply $R_3\\leftarrow R_3+2R_2$ and $R_4\\leftarrow R_4-5R_2$:\n\n$$\\begin{bmatrix}1&2&1&2\\\\0&-1&0&-6\\\\0&0&4&-9\\\\0&0&-5&27\\end{bmatrix}.$$\n\nFinally, $R_4\\leftarrow R_4+\\tfrac54R_3$ gives upper triangular diagonal entries $1,-1,4,63/4$. Its determinant is $-63$. There was one row swap, so $\\det(A)=63$."}] [:question/id #uuid "2913247e-6fe4-5e09-8a9d-8346095c1d59" {:db/id #edb/ref 17592186702496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f2ad2d7-d16c-56f6-871b-e9c3cb1c2424" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702575}] :answer-field/correct {:db/id #edb/ref 17592186702575} :answer-field/id #uuid "07f2f829-22f9-542b-9ade-2169285ea987" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702477}] :question/id #uuid "2913247e-6fe4-5e09-8a9d-8346095c1d59" :question/problem "**(c)(ii)** For $\\mathbf F=\\left\\langle\\frac{-y}{\\sqrt{x^2+y^2}},\\frac{x}{\\sqrt{x^2+y^2}}\\right\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds$ **by hand**. Show your parametrization and work.\n\nIntegral: {{answer}}." :question/worked-solution "Use $\\mathbf r(t)=(\\cos t,\\sin t)$, $0\\le t\\le2\\pi$. On the unit circle the denominator, when present, equals $1$, so $\\mathbf F(\\mathbf r(t))=(-\\sin t,\\cos t)=\\mathbf r'(t)$. Thus $\\mathbf F\\cdot\\mathbf T\\,ds=\\mathbf F(\\mathbf r(t))\\cdot\\mathbf r'(t)\\,dt=dt$ and the integral is $\\int_0^{2\\pi}1\\,dt=2\\pi$."}] [:question/id #uuid "2a25b401-c73c-5a57-b5f2-0d4b32e70920" {:db/id #edb/ref 17592186702498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01897633-62d1-5651-8be2-8c9be4da1364" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both methods give $2\\pi$. The field is defined and continuously differentiable on and inside the unit circle, so Green's theorem legitimately relates the two integrals." :db/id #edb/ref 17592186702472}] :answer-field/correct {:db/id #edb/ref 17592186702472} :answer-field/id #uuid "e26c5a1c-3e48-55f5-bba9-62f80b894098" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702680}] :question/id #uuid "2a25b401-c73c-5a57-b5f2-0d4b32e70920" :question/problem "**(a)(iv)** For $\\mathbf F=\\langle x,y\\rangle$, compare your answers to (ii) and (iii). Use the domain from (i) to explain any difference." :question/worked-solution "The domain and interior regularity explain whether the usual theorem applies. Account for every boundary component when working on a punctured region."}] [:question/id #uuid "2b06432f-f231-55ae-8a34-e4d79f103439" {:db/id #edb/ref 17592186702502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b63134e-55f3-5061-8a0c-a841870a4892" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A potential for $\\mathbf G=\\langle-g,f\\rangle$ satisfies $\\zeta_x=-g$ and $\\zeta_y=f$. The definition of a stream function for $\\mathbf F=\\langle f,g\\rangle$ is precisely $\\zeta_y=f$, $\\zeta_x=-g$. The two conditions are identical in both directions." :db/id #edb/ref 17592186702505}] :answer-field/correct {:db/id #edb/ref 17592186702505} :answer-field/id #uuid "d90ad0b3-4def-519f-bc26-cad3d76fb9af" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702668}] :question/id #uuid "2b06432f-f231-55ae-8a34-e4d79f103439" :question/problem "**(d)** Show that $\\zeta$ is a potential function for $\\mathbf G$ iff it is a stream function for $\\mathbf F$." :question/worked-solution "Check both partial derivatives and their signs. This equivalence concerns a function defined on the specified domain; local potentials do not automatically give a single global stream function on a domain with a hole."}] [:question/id #uuid "2f3d1841-9934-5d9b-8ff9-00e6d5262f9c" {:db/id #edb/ref 17592186702509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447c4af3-2141-5ebb-8aad-46e4298a2833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At a point with $f\\ne0$, substitute $\\psi_x=-g$ and $\\psi_y=f$ into the corrected relation from (b):\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_y}=\\frac{g}{f}.$$\n\nThis is the slope of the field direction from (a), so the level curve is tangent to $\\mathbf F$.\n\nMore generally,\n\n$$\\nabla\\psi\\cdot\\mathbf F=(-g,f)\\cdot(f,g)=0.$$\n\nAt a regular point where $\\nabla\\psi\\ne0$, the gradient is normal to the level curve, so $\\mathbf F$ is tangent to it, including vertical tangents. Thus regular level curves follow the flow. At a stagnation point $\\mathbf F=0$, no nonzero field direction is specified; the zero vector still satisfies the orthogonality identity." :db/id #edb/ref 17592186702522}] :answer-field/correct {:db/id #edb/ref 17592186702522} :answer-field/id #uuid "39cb848b-3dc7-55a4-b390-6f24001982e0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702517}] :question/id #uuid "2f3d1841-9934-5d9b-8ff9-00e6d5262f9c" :question/problem "**(c)** Use (a) and (b) to prove the source's statement that “$\\psi$ is everywhere tangent to $\\mathbf F$.” That is, show that the **level curves** of a stream function are streamlines." :question/worked-solution "It is the level curve, rather than the scalar function itself, that has a tangent. The slope proof needs $f\\ne0$; the gradient argument handles vertical tangents. A claim of a uniquely defined tangent at every critical point would need additional hypotheses, so retain the regular-point qualification."}] [:question/id #uuid "31437968-eb0b-5e95-8502-b20a3264c863" {:db/id #edb/ref 17592186702512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91b1038e-0a2e-56d6-8c20-76c870460b61" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The second row is multiplied by $2$: $R_2\\leftarrow2R_2$. The new determinant is $2$ times the old determinant." :db/id #edb/ref 17592186702596}] :answer-field/correct {:db/id #edb/ref 17592186702596} :answer-field/id #uuid "d4a99cdb-9cdc-5d48-a517-a369789cb6ee" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702661}] :question/id #uuid "31437968-eb0b-5e95-8502-b20a3264c863" :question/problem "Source exercise: 3.1.12, printed page 128 (PDF page 140).\n\nIdentify the operation that changes the first matrix to the second, and explain its effect on the determinant:\n\n$$\\begin{bmatrix}a&b\\\\c&d\\end{bmatrix}\\longrightarrow\\cdots\\longrightarrow\\begin{bmatrix}a&b\\\\2c&2d\\end{bmatrix}.$$" :question/worked-solution "Scaling one row by $2$ scales the determinant by $2$. Directly, $a(2d)-b(2c)=2(ad-bc)$. Only one row is scaled, so the factor is $2$, rather than $2^2$."}] [:question/id #uuid "33ae2fc2-38de-584c-a278-a991ff186cec" {:db/id #edb/ref 17592186702514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33bdc090-a755-588f-843a-154b39670898" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By multiplicativity,\n\n$$\\det(A)=\\det(P^{-1}BP)=\\det(P^{-1})\\det(B)\\det(P)\n=\\frac{1}{\\det(P)}\\det(B)\\det(P)=\\det(B).$$\n\nThe cancellation is valid because $P$ is invertible, so $\\det(P)\\ne0$." :db/id #edb/ref 17592186702515}] :answer-field/correct {:db/id #edb/ref 17592186702515} :answer-field/id #uuid "c88b6705-f18d-5640-b40e-bc841c62e4d8" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702653}] :question/id #uuid "33ae2fc2-38de-584c-a278-a991ff186cec" :question/problem "Source exercise: 3.1.20, printed page 129 (PDF page 141).\n\nLet $A,B$ be $n\\times n$ matrices. The notation $A\\sim B$ (**$A$ is similar to $B$**) means that some invertible matrix $P$ satisfies $A=P^{-1}BP$.\n\nShow that $A\\sim B$ implies $\\det(A)=\\det(B)$." :question/worked-solution "Use $\\det(XY)=\\det(X)\\det(Y)$ and $\\det(P^{-1})=1/\\det(P)$. Similarity uses the same invertible $P$ on the two sides of $B$ with opposite powers. The notation $\\sim$ here means similarity, as defined in this exercise."}] [:question/id #uuid "43a7a084-6042-5631-9a50-f49ed6051e5f" {:db/id #edb/ref 17592186702521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c34c8a72-6aec-5e68-bb83-22afb24b29ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The printed $\\psi_t$ is a typo: the denominator must be $\\psi_y$. With $y=y(x)$, differentiate $\\psi(x,y(x))=c$:\n\n$$\\psi_x+\\psi_y\\frac{dy}{dx}=0.$$\n\nWhere $\\psi_y\\ne0$,\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_y}.$$" :db/id #edb/ref 17592186702647}] :answer-field/correct {:db/id #edb/ref 17592186702647} :answer-field/id #uuid "ba18b400-d617-5f64-a5df-06efa663ce90" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702641}] :question/id #uuid "43a7a084-6042-5631-9a50-f49ed6051e5f" :question/problem "**(b)** Use implicit differentiation of $\\psi(x,y)=c$ to show the displayed relation in the source:\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_t}.$$\n\nThe denominator $\\psi_t$ is retained **as printed** in the PDF. Address the notation when deriving the relation." :question/worked-solution "Apply the chain rule to both dependencies of $\\psi$: its explicit $x$ argument and its $y(x)$ argument. No variable $t$ was introduced in the source context. Division by $\\psi_y$ requires $\\psi_y\\ne0$; other regular points can instead be described locally by $x$ as a function of $y$."}] [:question/id #uuid "50f6ec1f-a625-56fd-af37-7153d11ff18b" {:db/id #edb/ref 17592186702532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67f291fb-9f19-59f3-bc4a-4a57c01775f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186702549}] :answer-field/correct {:db/id #edb/ref 17592186702549} :answer-field/id #uuid "c63fc8f9-d20a-545b-87bd-ad71e9a55a57" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702652}] :question/id #uuid "50f6ec1f-a625-56fd-af37-7153d11ff18b" :question/problem "**(b)** Find the determinant of $\\begin{bmatrix}0&3\\\\0&2\\end{bmatrix}$ **by hand, without technology**. Show your calculation.\n\nDeterminant: {{answer}}." :question/worked-solution "$0(2)-3(0)=0$. For a $2\\times2$ matrix, $\\det\\begin{bmatrix}a&b\\\\c&d\\end{bmatrix}=ad-bc$. Apply the subtraction in that order."}] [:question/id #uuid "57e7dd59-de67-5fd1-b82e-9bd7d7ff64e8" {:db/id #edb/ref 17592186702537 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4da990c-4d12-5400-b3ac-10e29ac73afa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702662}] :answer-field/correct {:db/id #edb/ref 17592186702662} :answer-field/id #uuid "b994ea14-3fba-55e9-a2a8-6bb229caa506" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702640}] :question/id #uuid "57e7dd59-de67-5fd1-b82e-9bd7d7ff64e8" :question/problem "**(b)(i)** For $\\mathbf F=\\left\\langle\\frac{x}{x^2+y^2},\\frac{y}{x^2+y^2}\\right\\rangle$, find its domain.\n\nDomain: {{answer}}." :question/worked-solution "The denominator vanishes exactly at $(0,0)$. Exclude the origin; the field is smooth everywhere else."}] [:question/id #uuid "5b075aba-b77c-52f4-9246-23c2d050dae8" {:db/id #edb/ref 17592186702540 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8958b642-4a3f-58ce-9a4b-3091996a4255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-1,1\\}" :db/id #edb/ref 17592186702584}] :answer-field/correct {:db/id #edb/ref 17592186702584} :answer-field/id #uuid "702e7d4b-4c4d-50e8-8cd7-8bd6c18744bf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702556}] :question/id #uuid "5b075aba-b77c-52f4-9246-23c2d050dae8" :question/problem "Source exercise: 3.1.19, printed page 128 (PDF page 140).\n\nA real matrix is **orthogonal** if $A^T A=I$, so its inverse is its transpose. What are the possible values of $\\det(A)$?\n\nEnter the set of possible values: {{answer}}." :question/worked-solution "Taking determinants gives $\\det(A^T)\\det(A)=\\det(I)=1$. Since $\\det(A^T)=\\det(A)$, we have $(\\det A)^2=1$, hence $\\det A\\in\\{-1,1\\}$. Both occur: $I_n$ has determinant $1$, and $\\operatorname{diag}(-1,1,\\ldots,1)$ has determinant $-1$."}] [:question/id #uuid "7455514b-5312-5142-bf16-0346031c446d" {:db/id #edb/ref 17592186702562 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2c166ff-5c16-531f-9839-59410b5343f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "They are dependent because $\\vec v_4=-6\\vec v_1+4\\vec v_2+3\\vec v_3$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_3\\}$." :db/id #edb/ref 17592186702657}] :answer-field/correct {:db/id #edb/ref 17592186702657} :answer-field/id #uuid "6f11794d-626e-5b79-9985-1aeb29620714" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702553}] :question/id #uuid "7455514b-5312-5142-bf16-0346031c446d" :question/problem "Source exercise: 4.10.11, printed page 222 (PDF page 234).\n\nAre the following vectors linearly independent? If they are, explain why. If they are not, exhibit one as a linear combination of the others. Also give a linearly independent set with the same span.\n\n$$\\vec v_1=\\begin{bmatrix}1\\\\3\\\\-1\\\\1\\end{bmatrix},\\quad\\vec v_2=\\begin{bmatrix}1\\\\4\\\\-1\\\\1\\end{bmatrix},\\quad\\vec v_3=\\begin{bmatrix}1\\\\4\\\\0\\\\1\\end{bmatrix},\\quad\\vec v_4=\\begin{bmatrix}1\\\\10\\\\2\\\\1\\end{bmatrix}.$$" :question/worked-solution "The displayed combination checks in every coordinate: $-6+4+3=1$, $-18+16+12=10$, $6-4=2$, and $-6+4+3=1$. The first three rows of the matrix with columns $\\vec v_1,\\vec v_2,\\vec v_3$ form a $3\\times3$ minor with determinant $1$, so these three columns are independent. Removing $\\vec v_4$, which is generated by them, preserves the span."}] [:question/id #uuid "75171c23-6bf6-5fb3-b41d-ec62488dadcc" {:db/id #edb/ref 17592186702564 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6efe144-d94b-534b-8b5b-139afff1be5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "It is false in general. Take $A=B=I_2$. Then $\\det(A)+\\det(B)=1+1=2$, while $\\det(A+B)=\\det(2I_2)=4$." :db/id #edb/ref 17592186702684}] :answer-field/correct {:db/id #edb/ref 17592186702684} :answer-field/id #uuid "edb7cfcf-8bea-5c68-b17b-63bc60867ac9" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702691}] :question/id #uuid "75171c23-6bf6-5fb3-b41d-ec62488dadcc" :question/problem "Source exercise: 3.1.17, printed page 128 (PDF page 140).\n\nIs it true that $\\det(A+B)=\\det(A)+\\det(B)$? If true, explain why; if false, give a counterexample." :question/worked-solution "A single pair of square matrices for which the two sides differ disproves the assertion. Here $A+B=\\begin{bmatrix}2&0\\\\0&2\\end{bmatrix}$, whose determinant is $2\\cdot2=4$. The determinant is linear in one row at a time with the other rows fixed, not additive in the whole matrix."}] [:question/id #uuid "7c429fff-d597-5eb7-b988-201b2590aeda" {:db/id #edb/ref 17592186702572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b016c23f-7eca-5170-aed1-5bc2fc4e06bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2" :db/id #edb/ref 17592186702628}] :answer-field/correct {:db/id #edb/ref 17592186702628} :answer-field/id #uuid "454c7bd9-c191-5f51-b426-646010d75d0f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702523}] :question/id #uuid "7c429fff-d597-5eb7-b988-201b2590aeda" :question/problem "**(a)(i)** For $\\mathbf F=\\langle x,y\\rangle$, find its domain.\n\nDomain: {{answer}}." :question/worked-solution "The components are polynomial functions, so they are defined for every real pair $(x,y)$."}] [:question/id #uuid "7cbfe38b-fd98-546b-9207-85c535713b0c" {:db/id #edb/ref 17592186702573 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba61bd9f-1b0e-581b-ac75-c6723448df83" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Here $\\operatorname{curl}\\mathbf F=2$. Green's theorem applies because the field is $C^1$ on the entire disk and a neighborhood of it. Therefore\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds=\\iint_D2\\,dA=2\\operatorname{area}(D)=2\\pi.$$" :db/id #edb/ref 17592186702642}] :answer-field/correct {:db/id #edb/ref 17592186702642} :answer-field/id #uuid "824eb4db-8c50-5363-bae5-8bcf33c2c819" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702579}] :question/id #uuid "7cbfe38b-fd98-546b-9207-85c535713b0c" :question/problem "**(a)(iii)** For $\\mathbf F=\\langle-y,x\\rangle$, calculate $\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds$ “using” Green's theorem. Address any failure of its hypotheses." :question/worked-solution "Check the theorem hypotheses before replacing the boundary integral with an area integral. This field has no singularity in the disk."}] [:answer-field/id #uuid "824eb4db-8c50-5363-bae5-8bcf33c2c819" {:answer-field/choices [{:answer/id #uuid "ba61bd9f-1b0e-581b-ac75-c6723448df83" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Here $\\operatorname{curl}\\mathbf F=2$. Green's theorem applies because the field is $C^1$ on the entire disk and a neighborhood of it. Therefore\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds=\\iint_D2\\,dA=2\\operatorname{area}(D)=2\\pi.$$" :db/id #edb/ref 17592186702642}] :answer-field/correct {:db/id #edb/ref 17592186702642} :answer-field/id #uuid "824eb4db-8c50-5363-bae5-8bcf33c2c819" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702579}] [:answer-field/id #uuid "83f4bdec-7b5a-5c57-b8ae-f451d3a4a3f2" {:answer-field/choices [{:answer/id #uuid "a0a128c0-135d-59fc-9633-3ad9971ff100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "375" :db/id #edb/ref 17592186702615}] :answer-field/correct {:db/id #edb/ref 17592186702615} :answer-field/id #uuid "83f4bdec-7b5a-5c57-b8ae-f451d3a4a3f2" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702583}] [:answer-field/id #uuid "8a26eece-73eb-5425-ab5c-008b42b0892b" {:answer-field/choices [{:answer/id #uuid "a7667b11-d5f9-5246-834a-a9f6246331ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r=\\sqrt{x^2+y^2}>0$, $\\operatorname{curl}\\mathbf F=0$. Formally integrating that expression over the punctured disk gives $0$.\n\nThis is not a valid application of Green's theorem to the full disk: the field is undefined at the origin, which lies inside $C$. The actual boundary integral is $2\\pi$." :db/id #edb/ref 17592186702622}] :answer-field/correct {:db/id #edb/ref 17592186702622} :answer-field/id #uuid "8a26eece-73eb-5425-ab5c-008b42b0892b" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702585}] [:answer-field/id #uuid "8b628751-9b0a-5e3a-8424-44e093fc265c" {:answer-field/choices [{:answer/id #uuid "c446cbe1-2870-520a-88fa-d8558d9032bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702649}] :answer-field/correct {:db/id #edb/ref 17592186702649} :answer-field/id #uuid "8b628751-9b0a-5e3a-8424-44e093fc265c" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702588}] [:answer-field/id #uuid "8ba64de1-78df-526b-a684-fb466addd1c0" {:answer-field/choices [{:answer/id #uuid "fadeb1c3-2fac-5963-9372-602255cf90fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702700}] :answer-field/correct {:db/id #edb/ref 17592186702700} :answer-field/id #uuid "8ba64de1-78df-526b-a684-fb466addd1c0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702589}] [:answer-field/id #uuid "9247c709-6ec6-5fab-9361-a6bbbe35271d" {:answer-field/choices [{:answer/id #uuid "9dbe677d-9a8d-5d73-9cab-fff2ee3533b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The first partial derivatives of $\\mathbf F=\\langle f,g\\rangle$ are $f_x,f_y,g_x,g_y$. Those of $\\mathbf G=\\langle-g,f\\rangle$ are $-g_x,-g_y,f_x,f_y$. Negating or reordering functions preserves continuity. Thus all first partial derivatives of one field are continuous on the region exactly when all first partial derivatives of the other are." :db/id #edb/ref 17592186702607}] :answer-field/correct {:db/id #edb/ref 17592186702607} :answer-field/id #uuid "9247c709-6ec6-5fab-9361-a6bbbe35271d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702597}] [:answer-field/id #uuid "9e1e9dba-f0f0-566b-bacd-0917f1f61821" {:answer-field/choices [{:answer/id #uuid "2b0dd9f7-e858-58c2-9622-30b01c571ba7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The instruction that both fields are conservative is false on the full stated domain. A global potential for $\\mathbf F$ is\n\n$$\\phi_F=\\tfrac12\\ln(x^2+y^2)=\\ln r.$$\n\nHowever, $\\oint_{r=1}\\mathbf G\\cdot\\mathbf T\\,ds=2\\pi\\ne0$, so $\\mathbf G$ has no single-valued global potential on the punctured plane. Consequently $\\mathbf F$ has no single-valued global stream function there.\n\nLocally, after choosing a continuous angle branch $\\theta=\\arg(x+iy)$ on a cut domain, $\\nabla\\theta=\\mathbf G$. Thus $\\phi_G=\\theta$ and $\\psi_F=\\theta$ work locally; on $x>0$ one may use $\\theta=\\arctan(y/x)$.\n\nBoth fields nevertheless have zero divergence and zero curl at every point of the stated domain. With $s=x^2+y^2$,\n\n$$\\operatorname{div}\\mathbf F=\\frac{s-2x^2+s-2y^2}{s^2}=0,\\qquad\n\\operatorname{curl}\\mathbf F=\\frac{-2xy+2xy}{s^2}=0,$$\n\n$$\\operatorname{div}\\mathbf G=\\frac{2xy-2xy}{s^2}=0,\\qquad\n\\operatorname{curl}\\mathbf G=\\frac{s-2x^2+s-2y^2}{s^2}=0.$$\n\nSo both meet the worksheet's zero-divergence/zero-curl conditions without both being globally conservative." :db/id #edb/ref 17592186702503}] :answer-field/correct {:db/id #edb/ref 17592186702503} :answer-field/id #uuid "9e1e9dba-f0f0-566b-bacd-0917f1f61821" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702609}] [:answer-field/id #uuid "a3e230a5-1e46-54cb-a9a4-b1d5b27c32fc" {:answer-field/choices [{:answer/id #uuid "21410ab2-1320-5733-a152-ba355682038b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2" :db/id #edb/ref 17592186702491}] :answer-field/correct {:db/id #edb/ref 17592186702491} :answer-field/id #uuid "a3e230a5-1e46-54cb-a9a4-b1d5b27c32fc" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702618}] [:answer-field/id #uuid "a64a5703-da96-51f8-bd37-e4a7f704835d" {:answer-field/choices [{:answer/id #uuid "e3635d16-0a67-5cb9-816d-57f276fd04ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702681}] :answer-field/correct {:db/id #edb/ref 17592186702681} :answer-field/id #uuid "a64a5703-da96-51f8-bd37-e4a7f704835d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702620}] [:answer-field/id #uuid "a71b514a-9026-5f64-8d2d-53ce75beba13" {:answer-field/choices [{:answer/id #uuid "790d672e-a0a4-5642-aed9-0114d854a533" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702570}] :answer-field/correct {:db/id #edb/ref 17592186702570} :answer-field/id #uuid "a71b514a-9026-5f64-8d2d-53ce75beba13" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702621}] [:answer-field/id #uuid "b105b52f-d67c-5f04-9f64-f2c5d7a169ce" {:answer-field/choices [{:answer/id #uuid "d41b273d-8e09-5af7-a5ea-44d7947cab94" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r>0$, $\\operatorname{curl}\\mathbf F=1/r$. The formal area integral can be interpreted as an improper integral:\n\n$$\\lim_{\\varepsilon\\to0^+}\\int_0^{2\\pi}\\int_\\varepsilon^1\\frac1r\\,r\\,dr\\,d\\theta\n=\\lim_{\\varepsilon\\to0^+}2\\pi(1-\\varepsilon)=2\\pi.$$\n\nThe standard full-disk theorem does not apply directly because the field is undefined at the origin. The equality can be justified by applying Green's theorem to annuli and taking a limit." :db/id #edb/ref 17592186702660}] :answer-field/correct {:db/id #edb/ref 17592186702660} :answer-field/id #uuid "b105b52f-d67c-5f04-9f64-f2c5d7a169ce" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702630}] [:answer-field/id #uuid "b1f05870-a3a6-5713-92fb-c66be8566641" {:answer-field/choices [{:answer/id #uuid "2a77ad0c-9822-5e2c-b80f-2602ffd6d7aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Using planar scalar curl,\n\n$$\\operatorname{div}\\mathbf F=f_x+g_y,\\qquad\\operatorname{curl}\\mathbf G=f_x-(-g)_y=f_x+g_y.$$\n\nThe expressions are identical, so one is zero exactly when the other is zero. These are the definitions of source-free and irrotational, respectively." :db/id #edb/ref 17592186702500}] :answer-field/correct {:db/id #edb/ref 17592186702500} :answer-field/id #uuid "b1f05870-a3a6-5713-92fb-c66be8566641" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702631}] [:answer-field/id #uuid "b78e587c-ee6e-563c-8b7d-dce6a4933d25" {:answer-field/choices [{:answer/id #uuid "77f3dd9d-1119-51df-b553-4a43c4537b8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Choose every coefficient to be zero. Then $0\\vec x_1+\\cdots+0\\vec x_k=\\vec0$, which is a linear combination of the given vectors. Therefore $\\vec0$ belongs to their span." :db/id #edb/ref 17592186702568}] :answer-field/correct {:db/id #edb/ref 17592186702568} :answer-field/id #uuid "b78e587c-ee6e-563c-8b7d-dce6a4933d25" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702636}] [:answer-field/id #uuid "b994ea14-3fba-55e9-a2a8-6bb229caa506" {:answer-field/choices [{:answer/id #uuid "d4da990c-4d12-5400-b3ac-10e29ac73afa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702662}] :answer-field/correct {:db/id #edb/ref 17592186702662} :answer-field/id #uuid "b994ea14-3fba-55e9-a2a8-6bb229caa506" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702640}] [:answer-field/id #uuid "ba18b400-d617-5f64-a5df-06efa663ce90" {:answer-field/choices [{:answer/id #uuid "c34c8a72-6aec-5e68-bb83-22afb24b29ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The printed $\\psi_t$ is a typo: the denominator must be $\\psi_y$. With $y=y(x)$, differentiate $\\psi(x,y(x))=c$:\n\n$$\\psi_x+\\psi_y\\frac{dy}{dx}=0.$$\n\nWhere $\\psi_y\\ne0$,\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_y}.$$" :db/id #edb/ref 17592186702647}] :answer-field/correct {:db/id #edb/ref 17592186702647} :answer-field/id #uuid "ba18b400-d617-5f64-a5df-06efa663ce90" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702641}] [:answer-field/id #uuid "c479ba4b-591e-5cb9-a0e1-516fc2d62542" {:answer-field/choices [{:answer/id #uuid "71c153c5-b242-591a-bc0e-031852d164f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Potentials are $\\phi_F=(x^2-y^2)/2$ and $\\phi_G=xy$, since $\\nabla\\phi_F=(x,-y)$ and $\\nabla\\phi_G=(y,x)$. A stream function for $\\mathbf F$ is $\\psi=xy$.\n\nBoth curls are zero because the fields are gradients. Also, $\\operatorname{div}\\mathbf F=1-1=0$ and $\\operatorname{div}\\mathbf G=0+0=0$. Thus both have zero divergence and zero curl, as required here. Problem 1(b) gives $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G=0$. Applying it to $\\mathbf G$, whose rotated field is $-\\mathbf F$, also gives $\\operatorname{div}\\mathbf G=-\\operatorname{curl}\\mathbf F=0$. Problem 1(d) identifies the potential of $\\mathbf G$ with the stream function of $\\mathbf F$." :db/id #edb/ref 17592186702560}] :answer-field/correct {:db/id #edb/ref 17592186702560} :answer-field/id #uuid "c479ba4b-591e-5cb9-a0e1-516fc2d62542" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702650}] [:answer-field/id #uuid "c5aecf12-592a-520d-8c44-f9e640f5c8e2" {:answer-field/choices [{:answer/id #uuid "5bf6e3f3-eb49-5df5-bc3e-82d627dcb3d0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Take $\\phi_F=e^x\\cos y$ and $\\phi_G=e^x\\sin y$. Their gradients are exactly the two specified fields, so both are conservative. A stream function for $\\mathbf F$ is $\\psi=e^x\\sin y$.\n\nTheir divergences are $e^x\\cos y-e^x\\cos y=0$ and $e^x\\sin y-e^x\\sin y=0$. Their curls are also zero: for $\\mathbf F$, $-e^x\\sin y-(-e^x\\sin y)=0$; for $\\mathbf G$, $e^x\\cos y-e^x\\cos y=0$. Problem 1(b) gives $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G=0$ and, after rotating $\\mathbf G$ to $-\\mathbf F$, $\\operatorname{div}\\mathbf G=-\\operatorname{curl}\\mathbf F=0$. Thus both meet the stated ideal-flow conditions." :db/id #edb/ref 17592186702541}] :answer-field/correct {:db/id #edb/ref 17592186702541} :answer-field/id #uuid "c5aecf12-592a-520d-8c44-f9e640f5c8e2" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702651}] [:answer-field/id #uuid "c63fc8f9-d20a-545b-87bd-ad71e9a55a57" {:answer-field/choices [{:answer/id #uuid "67f291fb-9f19-59f3-bc4a-4a57c01775f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186702549}] :answer-field/correct {:db/id #edb/ref 17592186702549} :answer-field/id #uuid "c63fc8f9-d20a-545b-87bd-ad71e9a55a57" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702652}] [:answer-field/id #uuid "c88b6705-f18d-5640-b40e-bc841c62e4d8" {:answer-field/choices [{:answer/id #uuid "33bdc090-a755-588f-843a-154b39670898" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By multiplicativity,\n\n$$\\det(A)=\\det(P^{-1}BP)=\\det(P^{-1})\\det(B)\\det(P)\n=\\frac{1}{\\det(P)}\\det(B)\\det(P)=\\det(B).$$\n\nThe cancellation is valid because $P$ is invertible, so $\\det(P)\\ne0$." :db/id #edb/ref 17592186702515}] :answer-field/correct {:db/id #edb/ref 17592186702515} :answer-field/id #uuid "c88b6705-f18d-5640-b40e-bc841c62e4d8" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702653}] [:answer-field/id #uuid "cbbef084-1b60-5586-a0c5-aeba84ea1799" {:answer-field/choices [{:answer/id #uuid "8d0ab866-196e-52dc-89f3-7c3a4c5069af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "They are dependent because $\\vec v_3=-2\\vec v_1+3\\vec v_2$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_4\\}$." :db/id #edb/ref 17592186702590}] :answer-field/correct {:db/id #edb/ref 17592186702590} :answer-field/id #uuid "cbbef084-1b60-5586-a0c5-aeba84ea1799" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702655}] [:answer-field/id #uuid "d4a99cdb-9cdc-5d48-a517-a369789cb6ee" {:answer-field/choices [{:answer/id #uuid "91b1038e-0a2e-56d6-8c20-76c870460b61" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The second row is multiplied by $2$: $R_2\\leftarrow2R_2$. The new determinant is $2$ times the old determinant." :db/id #edb/ref 17592186702596}] :answer-field/correct {:db/id #edb/ref 17592186702596} :answer-field/id #uuid "d4a99cdb-9cdc-5d48-a517-a369789cb6ee" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702661}] [:answer-field/id #uuid "d7f44212-59a7-5458-9982-5b4bacf1ad15" {:answer-field/choices [{:answer/id #uuid "5805a00c-2392-5a80-91e5-b6d845f1b4dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Here $\\operatorname{div}\\mathbf F=2$. Green's theorem applies because the field is $C^1$ on the entire disk and a neighborhood of it. Therefore\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds=\\iint_D2\\,dA=2\\operatorname{area}(D)=2\\pi.$$" :db/id #edb/ref 17592186702538}] :answer-field/correct {:db/id #edb/ref 17592186702538} :answer-field/id #uuid "d7f44212-59a7-5458-9982-5b4bacf1ad15" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702667}] [:answer-field/id #uuid "d90ad0b3-4def-519f-bc26-cad3d76fb9af" {:answer-field/choices [{:answer/id #uuid "2b63134e-55f3-5061-8a0c-a841870a4892" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A potential for $\\mathbf G=\\langle-g,f\\rangle$ satisfies $\\zeta_x=-g$ and $\\zeta_y=f$. The definition of a stream function for $\\mathbf F=\\langle f,g\\rangle$ is precisely $\\zeta_y=f$, $\\zeta_x=-g$. The two conditions are identical in both directions." :db/id #edb/ref 17592186702505}] :answer-field/correct {:db/id #edb/ref 17592186702505} :answer-field/id #uuid "d90ad0b3-4def-519f-bc26-cad3d76fb9af" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702668}] [:answer-field/id #uuid "e26c5a1c-3e48-55f5-bba9-62f80b894098" {:answer-field/choices [{:answer/id #uuid "01897633-62d1-5651-8be2-8c9be4da1364" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both methods give $2\\pi$. The field is defined and continuously differentiable on and inside the unit circle, so Green's theorem legitimately relates the two integrals." :db/id #edb/ref 17592186702472}] :answer-field/correct {:db/id #edb/ref 17592186702472} :answer-field/id #uuid "e26c5a1c-3e48-55f5-bba9-62f80b894098" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702680}] [:answer-field/id #uuid "e423325b-ccb6-5a16-a938-bf8fae815cba" {:answer-field/choices [{:answer/id #uuid "0c023af7-0fa4-5186-8428-fbbabdcb5778" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Parametrize the counterclockwise curve by $\\mathbf r(t)=(x(t),y(t))$. Where the tangent exists, the outward normal is the clockwise rotation of the tangent, hence $\\mathbf n\\,ds=(y'(t),-x'(t))\\,dt$. Therefore\n\n$$\\mathbf F\\cdot\\mathbf n\\,ds=(fy'-gx')\\,dt=(-g,f)\\cdot(x',y')\\,dt=\\mathbf G\\cdot\\mathbf T\\,ds.$$\n\nIntegrate this pointwise identity over $C$ (piecewise for a piecewise smooth curve)." :db/id #edb/ref 17592186702479}] :answer-field/correct {:db/id #edb/ref 17592186702479} :answer-field/id #uuid "e423325b-ccb6-5a16-a938-bf8fae815cba" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702682}] [:answer-field/id #uuid "e4f8063b-1332-5a48-846e-e72a213d3c38" {:answer-field/choices [{:answer/id #uuid "77b2897b-cbba-5228-9728-60335f0049bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Direct calculation gives $2\\pi$, while the invalid full-disk use of Green's theorem gives $0$. The domain excludes the origin, so the theorem's regularity hypothesis fails inside $C$. The mismatch comes from ignoring the hole and its inner boundary, rather than from an error in the direct parametrization." :db/id #edb/ref 17592186702567}] :answer-field/correct {:db/id #edb/ref 17592186702567} :answer-field/id #uuid "e4f8063b-1332-5a48-846e-e72a213d3c38" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702683}] [:answer-field/id #uuid "e7ea4d25-8305-5f9b-afae-16246b0c0f6f" {:answer-field/choices [{:answer/id #uuid "31371801-c4b1-5108-988b-f1287d84a642" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186702511}] :answer-field/correct {:db/id #edb/ref 17592186702511} :answer-field/id #uuid "e7ea4d25-8305-5f9b-afae-16246b0c0f6f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702685}] [:answer-field/id #uuid "eb5276e7-dfa6-52f1-9f07-b3410db173fe" {:answer-field/choices [{:answer/id #uuid "8d6cdc8a-250d-53ce-88eb-c7c7b3345fb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702592}] :answer-field/correct {:db/id #edb/ref 17592186702592} :answer-field/id #uuid "eb5276e7-dfa6-52f1-9f07-b3410db173fe" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702689}] [:answer-field/id #uuid "edb7cfcf-8bea-5c68-b17b-63bc60867ac9" {:answer-field/choices [{:answer/id #uuid "e6efe144-d94b-534b-8b5b-139afff1be5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "It is false in general. Take $A=B=I_2$. Then $\\det(A)+\\det(B)=1+1=2$, while $\\det(A+B)=\\det(2I_2)=4$." :db/id #edb/ref 17592186702684}] :answer-field/correct {:db/id #edb/ref 17592186702684} :answer-field/id #uuid "edb7cfcf-8bea-5c68-b17b-63bc60867ac9" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702691}] [:answer-field/id #uuid "fb07ab3d-0094-592c-9ddf-240db93273a6" {:answer-field/choices [{:answer/id #uuid "6df2a8bc-93cf-5744-a847-7101bcc33f96" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. The combination is $\\vec v=2\\vec u_1-\\vec u_2$:\n\n$$2\\begin{bmatrix}3\\\\1\\\\-1\\end{bmatrix}-\\begin{bmatrix}2\\\\-2\\\\1\\end{bmatrix}=\\begin{bmatrix}4\\\\4\\\\-3\\end{bmatrix}.$$" :db/id #edb/ref 17592186702552}] :answer-field/correct {:db/id #edb/ref 17592186702552} :answer-field/id #uuid "fb07ab3d-0094-592c-9ddf-240db93273a6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702701}] [:answer-field/id #uuid "03ef442c-08c2-5fcb-b489-c016fa035c1a" {:answer-field/choices [{:answer/id #uuid "6f481c20-7669-5276-b056-49ea2dd62d6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186702554}] :answer-field/correct {:db/id #edb/ref 17592186702554} :answer-field/id #uuid "03ef442c-08c2-5fcb-b489-c016fa035c1a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702474}] [:answer-field/id #uuid "04e2bfc2-14e3-57f6-9455-b8939e0b7a26" {:answer-field/choices [{:answer/id #uuid "92df2acd-bb90-5c44-81fa-525df536f59e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r>0$, $\\operatorname{div}\\mathbf F=1/r$. The formal area integral can be interpreted as an improper integral:\n\n$$\\lim_{\\varepsilon\\to0^+}\\int_0^{2\\pi}\\int_\\varepsilon^1\\frac1r\\,r\\,dr\\,d\\theta\n=\\lim_{\\varepsilon\\to0^+}2\\pi(1-\\varepsilon)=2\\pi.$$\n\nThe standard full-disk theorem does not apply directly because the field is undefined at the origin. The equality can be justified by applying Green's theorem to annuli and taking a limit." :db/id #edb/ref 17592186702599}] :answer-field/correct {:db/id #edb/ref 17592186702599} :answer-field/id #uuid "04e2bfc2-14e3-57f6-9455-b8939e0b7a26" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702475}] [:answer-field/id #uuid "07f2f829-22f9-542b-9ade-2169285ea987" {:answer-field/choices [{:answer/id #uuid "7f2ad2d7-d16c-56f6-871b-e9c3cb1c2424" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702575}] :answer-field/correct {:db/id #edb/ref 17592186702575} :answer-field/id #uuid "07f2f829-22f9-542b-9ade-2169285ea987" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702477}] [:answer-field/id #uuid "152a12f0-6d22-58b0-8680-bd6807c31650" {:answer-field/choices [{:answer/id #uuid "b071b47f-2819-58f0-9029-2235f9736418" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Direct calculation gives $2\\pi$, while the invalid full-disk use of Green's theorem gives $0$. The domain excludes the origin, so the theorem's regularity hypothesis fails inside $C$. The mismatch comes from ignoring the hole and its inner boundary, rather than from an error in the direct parametrization." :db/id #edb/ref 17592186702629}] :answer-field/correct {:db/id #edb/ref 17592186702629} :answer-field/id #uuid "152a12f0-6d22-58b0-8680-bd6807c31650" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702483}] [:answer-field/id #uuid "1b5e55df-c0dd-51ea-8df7-d165c685c016" {:answer-field/choices [{:answer/id #uuid "4a7c0a2b-3a9f-5741-ad2d-ee14622e3578" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The matrix is transposed. Transposing a square matrix preserves its determinant: $\\det(A^T)=\\det(A)$." :db/id #edb/ref 17592186702526}] :answer-field/correct {:db/id #edb/ref 17592186702526} :answer-field/id #uuid "1b5e55df-c0dd-51ea-8df7-d165c685c016" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702488}] [:answer-field/id #uuid "1ca929f9-9e00-5d43-8750-3ee995575df3" {:answer-field/choices [{:answer/id #uuid "d73965e8-b478-5301-a93b-edc40660a598" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r=\\sqrt{x^2+y^2}>0$, $\\operatorname{div}\\mathbf F=0$. Formally integrating that expression over the punctured disk gives $0$.\n\nThis is not a valid application of Green's theorem to the full disk: the field is undefined at the origin, which lies inside $C$. The actual boundary integral is $2\\pi$." :db/id #edb/ref 17592186702664}] :answer-field/correct {:db/id #edb/ref 17592186702664} :answer-field/id #uuid "1ca929f9-9e00-5d43-8750-3ee995575df3" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702489}] [:answer-field/id #uuid "2520bb94-4364-510b-ad49-85cc3ab85797" {:answer-field/choices [{:answer/id #uuid "c2e1fa68-9010-5f23-9d15-43d096747c65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No. Each generating vector satisfies $z=-2x$, so every linear combination also satisfies $z=-2x$. The target has $x=1$ and $z=-1$, which fails that relation. It is outside the span, so no such linear combination exists." :db/id #edb/ref 17592186702646}] :answer-field/correct {:db/id #edb/ref 17592186702646} :answer-field/id #uuid "2520bb94-4364-510b-ad49-85cc3ab85797" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702493}] [:answer-field/id #uuid "255fb13b-2536-5f76-84c6-25f80be7d7c1" {:answer-field/choices [{:answer/id #uuid "462deff5-b92c-575b-bde8-d2e265a1bc6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both computations yield $2\\pi$, but the agreement alone does not make a direct full-disk invocation of Green's theorem valid. The origin is excluded from the domain. In this case, annular applications and a limit do justify the equality, because the inner-boundary contribution tends to zero." :db/id #edb/ref 17592186702524}] :answer-field/correct {:db/id #edb/ref 17592186702524} :answer-field/id #uuid "255fb13b-2536-5f76-84c6-25f80be7d7c1" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702494}] [:answer-field/id #uuid "2b9aeba5-da06-5e9b-a4e0-532626735baf" {:answer-field/choices [{:answer/id #uuid "001f6717-2818-512e-be5a-c55f0d4a02ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "63" :db/id #edb/ref 17592186702471}] :answer-field/correct {:db/id #edb/ref 17592186702471} :answer-field/id #uuid "2b9aeba5-da06-5e9b-a4e0-532626735baf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702506}] [:answer-field/id #uuid "39cb848b-3dc7-55a4-b390-6f24001982e0" {:answer-field/choices [{:answer/id #uuid "447c4af3-2141-5ebb-8aad-46e4298a2833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At a point with $f\\ne0$, substitute $\\psi_x=-g$ and $\\psi_y=f$ into the corrected relation from (b):\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_y}=\\frac{g}{f}.$$\n\nThis is the slope of the field direction from (a), so the level curve is tangent to $\\mathbf F$.\n\nMore generally,\n\n$$\\nabla\\psi\\cdot\\mathbf F=(-g,f)\\cdot(f,g)=0.$$\n\nAt a regular point where $\\nabla\\psi\\ne0$, the gradient is normal to the level curve, so $\\mathbf F$ is tangent to it, including vertical tangents. Thus regular level curves follow the flow. At a stagnation point $\\mathbf F=0$, no nonzero field direction is specified; the zero vector still satisfies the orthogonality identity." :db/id #edb/ref 17592186702522}] :answer-field/correct {:db/id #edb/ref 17592186702522} :answer-field/id #uuid "39cb848b-3dc7-55a4-b390-6f24001982e0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702517}] [:answer-field/id #uuid "454c7bd9-c191-5f51-b426-646010d75d0f" {:answer-field/choices [{:answer/id #uuid "b016c23f-7eca-5170-aed1-5bc2fc4e06bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2" :db/id #edb/ref 17592186702628}] :answer-field/correct {:db/id #edb/ref 17592186702628} :answer-field/id #uuid "454c7bd9-c191-5f51-b426-646010d75d0f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702523}] [:answer-field/id #uuid "478334df-2d59-5e3d-884a-48ed7220e653" {:answer-field/choices [{:answer/id #uuid "4e6eb92b-c2bf-5fd9-ac1d-05691eb1508e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both computations yield $2\\pi$, but the agreement alone does not make a direct full-disk invocation of Green's theorem valid. The origin is excluded from the domain. In this case, annular applications and a limit do justify the equality, because the inner-boundary contribution tends to zero." :db/id #edb/ref 17592186702530}] :answer-field/correct {:db/id #edb/ref 17592186702530} :answer-field/id #uuid "478334df-2d59-5e3d-884a-48ed7220e653" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702525}] [:answer-field/id #uuid "51c81fbb-ed83-50be-ab54-2da572103db1" {:answer-field/choices [{:answer/id #uuid "9183a5c7-138b-5916-9785-973488ce8174" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both methods give $2\\pi$. The field is defined and continuously differentiable on and inside the unit circle, so Green's theorem legitimately relates the two integrals." :db/id #edb/ref 17592186702595}] :answer-field/correct {:db/id #edb/ref 17592186702595} :answer-field/id #uuid "51c81fbb-ed83-50be-ab54-2da572103db1" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702533}] [:answer-field/id #uuid "52d06fdc-3175-52f3-b479-8c57eb944433" {:answer-field/choices [{:answer/id #uuid "278bcbd6-88ef-53b1-8c5c-f9a389d47fa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702495}] :answer-field/correct {:db/id #edb/ref 17592186702495} :answer-field/id #uuid "52d06fdc-3175-52f3-b479-8c57eb944433" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702534}] [:answer-field/id #uuid "53586b83-f875-5cd5-a67c-0ff2bafda146" {:answer-field/choices [{:answer/id #uuid "9baff282-1ea0-521b-a768-4edc1668a602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702604}] :answer-field/correct {:db/id #edb/ref 17592186702604} :answer-field/id #uuid "53586b83-f875-5cd5-a67c-0ff2bafda146" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702535}] [:answer-field/id #uuid "624366ae-d5ee-5a3c-832e-2d130d6bef73" {:answer-field/choices [{:answer/id #uuid "173df41c-e05b-574e-aa20-a8d310566036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702485}] :answer-field/correct {:db/id #edb/ref 17592186702485} :answer-field/id #uuid "624366ae-d5ee-5a3c-832e-2d130d6bef73" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702545}] [:answer-field/id #uuid "6f11794d-626e-5b79-9985-1aeb29620714" {:answer-field/choices [{:answer/id #uuid "d2c166ff-5c16-531f-9839-59410b5343f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "They are dependent because $\\vec v_4=-6\\vec v_1+4\\vec v_2+3\\vec v_3$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_3\\}$." :db/id #edb/ref 17592186702657}] :answer-field/correct {:db/id #edb/ref 17592186702657} :answer-field/id #uuid "6f11794d-626e-5b79-9985-1aeb29620714" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702553}] [:answer-field/id #uuid "702e7d4b-4c4d-50e8-8cd7-8bd6c18744bf" {:answer-field/choices [{:answer/id #uuid "8958b642-4a3f-58ce-9a4b-3091996a4255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-1,1\\}" :db/id #edb/ref 17592186702584}] :answer-field/correct {:db/id #edb/ref 17592186702584} :answer-field/id #uuid "702e7d4b-4c4d-50e8-8cd7-8bd6c18744bf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186702556}] [:answer-field/id #uuid "7a5da541-73c6-5b07-965c-962d03521a2f" {:answer-field/choices [{:answer/id #uuid "3e9ebcbc-b2da-58eb-b0aa-d994e87d860f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $P=(x_0,y_0)$, parametrize the line by $(x,y)=(x_0,y_0)+t(f(x_0,y_0),g(x_0,y_0))$. Its slope is $\\Delta y/\\Delta x=g(x_0,y_0)/f(x_0,y_0)$ when $f(x_0,y_0)\\ne0$. If $f=0$ and $g\\ne0$, the line is vertical. If $f=g=0$, the zero field vector specifies no direction." :db/id #edb/ref 17592186702518}] :answer-field/correct {:db/id #edb/ref 17592186702518} :answer-field/id #uuid "7a5da541-73c6-5b07-965c-962d03521a2f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186702571}] [:answer/id #uuid "8958b642-4a3f-58ce-9a4b-3091996a4255" {:answer/id #uuid "8958b642-4a3f-58ce-9a4b-3091996a4255" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\{-1,1\\}" :db/id #edb/ref 17592186702584}] [:answer/id #uuid "8d0ab866-196e-52dc-89f3-7c3a4c5069af" {:answer/id #uuid "8d0ab866-196e-52dc-89f3-7c3a4c5069af" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "They are dependent because $\\vec v_3=-2\\vec v_1+3\\vec v_2$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_4\\}$." :db/id #edb/ref 17592186702590}] [:answer/id #uuid "8d6cdc8a-250d-53ce-88eb-c7c7b3345fb1" {:answer/id #uuid "8d6cdc8a-250d-53ce-88eb-c7c7b3345fb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702592}] [:answer/id #uuid "9183a5c7-138b-5916-9785-973488ce8174" {:answer/id #uuid "9183a5c7-138b-5916-9785-973488ce8174" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both methods give $2\\pi$. The field is defined and continuously differentiable on and inside the unit circle, so Green's theorem legitimately relates the two integrals." :db/id #edb/ref 17592186702595}] [:answer/id #uuid "91b1038e-0a2e-56d6-8c20-76c870460b61" {:answer/id #uuid "91b1038e-0a2e-56d6-8c20-76c870460b61" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The second row is multiplied by $2$: $R_2\\leftarrow2R_2$. The new determinant is $2$ times the old determinant." :db/id #edb/ref 17592186702596}] [:answer/id #uuid "92df2acd-bb90-5c44-81fa-525df536f59e" {:answer/id #uuid "92df2acd-bb90-5c44-81fa-525df536f59e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r>0$, $\\operatorname{div}\\mathbf F=1/r$. The formal area integral can be interpreted as an improper integral:\n\n$$\\lim_{\\varepsilon\\to0^+}\\int_0^{2\\pi}\\int_\\varepsilon^1\\frac1r\\,r\\,dr\\,d\\theta\n=\\lim_{\\varepsilon\\to0^+}2\\pi(1-\\varepsilon)=2\\pi.$$\n\nThe standard full-disk theorem does not apply directly because the field is undefined at the origin. The equality can be justified by applying Green's theorem to annuli and taking a limit." :db/id #edb/ref 17592186702599}] [:answer/id #uuid "9baff282-1ea0-521b-a768-4edc1668a602" {:answer/id #uuid "9baff282-1ea0-521b-a768-4edc1668a602" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702604}] [:answer/id #uuid "9dbe677d-9a8d-5d73-9cab-fff2ee3533b1" {:answer/id #uuid "9dbe677d-9a8d-5d73-9cab-fff2ee3533b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The first partial derivatives of $\\mathbf F=\\langle f,g\\rangle$ are $f_x,f_y,g_x,g_y$. Those of $\\mathbf G=\\langle-g,f\\rangle$ are $-g_x,-g_y,f_x,f_y$. Negating or reordering functions preserves continuity. Thus all first partial derivatives of one field are continuous on the region exactly when all first partial derivatives of the other are." :db/id #edb/ref 17592186702607}] [:answer/id #uuid "a0a128c0-135d-59fc-9633-3ad9971ff100" {:answer/id #uuid "a0a128c0-135d-59fc-9633-3ad9971ff100" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "375" :db/id #edb/ref 17592186702615}] [:answer/id #uuid "a7667b11-d5f9-5246-834a-a9f6246331ca" {:answer/id #uuid "a7667b11-d5f9-5246-834a-a9f6246331ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r=\\sqrt{x^2+y^2}>0$, $\\operatorname{curl}\\mathbf F=0$. Formally integrating that expression over the punctured disk gives $0$.\n\nThis is not a valid application of Green's theorem to the full disk: the field is undefined at the origin, which lies inside $C$. The actual boundary integral is $2\\pi$." :db/id #edb/ref 17592186702622}] [:answer/id #uuid "b016c23f-7eca-5170-aed1-5bc2fc4e06bf" {:answer/id #uuid "b016c23f-7eca-5170-aed1-5bc2fc4e06bf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2" :db/id #edb/ref 17592186702628}] [:answer/id #uuid "b071b47f-2819-58f0-9029-2235f9736418" {:answer/id #uuid "b071b47f-2819-58f0-9029-2235f9736418" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Direct calculation gives $2\\pi$, while the invalid full-disk use of Green's theorem gives $0$. The domain excludes the origin, so the theorem's regularity hypothesis fails inside $C$. The mismatch comes from ignoring the hole and its inner boundary, rather than from an error in the direct parametrization." :db/id #edb/ref 17592186702629}] [:answer/id #uuid "ba61bd9f-1b0e-581b-ac75-c6723448df83" {:answer/id #uuid "ba61bd9f-1b0e-581b-ac75-c6723448df83" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Here $\\operatorname{curl}\\mathbf F=2$. Green's theorem applies because the field is $C^1$ on the entire disk and a neighborhood of it. Therefore\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf T\\,ds=\\iint_D2\\,dA=2\\operatorname{area}(D)=2\\pi.$$" :db/id #edb/ref 17592186702642}] [:answer/id #uuid "c2e1fa68-9010-5f23-9d15-43d096747c65" {:answer/id #uuid "c2e1fa68-9010-5f23-9d15-43d096747c65" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No. Each generating vector satisfies $z=-2x$, so every linear combination also satisfies $z=-2x$. The target has $x=1$ and $z=-1$, which fails that relation. It is outside the span, so no such linear combination exists." :db/id #edb/ref 17592186702646}] [:answer/id #uuid "c34c8a72-6aec-5e68-bb83-22afb24b29ca" {:answer/id #uuid "c34c8a72-6aec-5e68-bb83-22afb24b29ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The printed $\\psi_t$ is a typo: the denominator must be $\\psi_y$. With $y=y(x)$, differentiate $\\psi(x,y(x))=c$:\n\n$$\\psi_x+\\psi_y\\frac{dy}{dx}=0.$$\n\nWhere $\\psi_y\\ne0$,\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_y}.$$" :db/id #edb/ref 17592186702647}] [:answer/id #uuid "c446cbe1-2870-520a-88fa-d8558d9032bc" {:answer/id #uuid "c446cbe1-2870-520a-88fa-d8558d9032bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702649}] [:answer/id #uuid "d2c166ff-5c16-531f-9839-59410b5343f6" {:answer/id #uuid "d2c166ff-5c16-531f-9839-59410b5343f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "They are dependent because $\\vec v_4=-6\\vec v_1+4\\vec v_2+3\\vec v_3$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_3\\}$." :db/id #edb/ref 17592186702657}] [:answer/id #uuid "d41b273d-8e09-5af7-a5ea-44d7947cab94" {:answer/id #uuid "d41b273d-8e09-5af7-a5ea-44d7947cab94" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r>0$, $\\operatorname{curl}\\mathbf F=1/r$. The formal area integral can be interpreted as an improper integral:\n\n$$\\lim_{\\varepsilon\\to0^+}\\int_0^{2\\pi}\\int_\\varepsilon^1\\frac1r\\,r\\,dr\\,d\\theta\n=\\lim_{\\varepsilon\\to0^+}2\\pi(1-\\varepsilon)=2\\pi.$$\n\nThe standard full-disk theorem does not apply directly because the field is undefined at the origin. The equality can be justified by applying Green's theorem to annuli and taking a limit." :db/id #edb/ref 17592186702660}] [:answer/id #uuid "d4da990c-4d12-5400-b3ac-10e29ac73afa" {:answer/id #uuid "d4da990c-4d12-5400-b3ac-10e29ac73afa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702662}] [:answer/id #uuid "d73965e8-b478-5301-a93b-edc40660a598" {:answer/id #uuid "d73965e8-b478-5301-a93b-edc40660a598" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For $r=\\sqrt{x^2+y^2}>0$, $\\operatorname{div}\\mathbf F=0$. Formally integrating that expression over the punctured disk gives $0$.\n\nThis is not a valid application of Green's theorem to the full disk: the field is undefined at the origin, which lies inside $C$. The actual boundary integral is $2\\pi$." :db/id #edb/ref 17592186702664}] [:answer/id #uuid "e3635d16-0a67-5cb9-816d-57f276fd04ee" {:answer/id #uuid "e3635d16-0a67-5cb9-816d-57f276fd04ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702681}] [:answer/id #uuid "e6efe144-d94b-534b-8b5b-139afff1be5c" {:answer/id #uuid "e6efe144-d94b-534b-8b5b-139afff1be5c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "It is false in general. Take $A=B=I_2$. Then $\\det(A)+\\det(B)=1+1=2$, while $\\det(A+B)=\\det(2I_2)=4$." :db/id #edb/ref 17592186702684}] [:answer/id #uuid "fadeb1c3-2fac-5963-9372-602255cf90fd" {:answer/id #uuid "fadeb1c3-2fac-5963-9372-602255cf90fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702700}] [:answer/id #uuid "001f6717-2818-512e-be5a-c55f0d4a02ee" {:answer/id #uuid "001f6717-2818-512e-be5a-c55f0d4a02ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "63" :db/id #edb/ref 17592186702471}] [:answer/id #uuid "01897633-62d1-5651-8be2-8c9be4da1364" {:answer/id #uuid "01897633-62d1-5651-8be2-8c9be4da1364" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both methods give $2\\pi$. The field is defined and continuously differentiable on and inside the unit circle, so Green's theorem legitimately relates the two integrals." :db/id #edb/ref 17592186702472}] [:answer/id #uuid "0c023af7-0fa4-5186-8428-fbbabdcb5778" {:answer/id #uuid "0c023af7-0fa4-5186-8428-fbbabdcb5778" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Parametrize the counterclockwise curve by $\\mathbf r(t)=(x(t),y(t))$. Where the tangent exists, the outward normal is the clockwise rotation of the tangent, hence $\\mathbf n\\,ds=(y'(t),-x'(t))\\,dt$. Therefore\n\n$$\\mathbf F\\cdot\\mathbf n\\,ds=(fy'-gx')\\,dt=(-g,f)\\cdot(x',y')\\,dt=\\mathbf G\\cdot\\mathbf T\\,ds.$$\n\nIntegrate this pointwise identity over $C$ (piecewise for a piecewise smooth curve)." :db/id #edb/ref 17592186702479}] [:answer/id #uuid "173df41c-e05b-574e-aa20-a8d310566036" {:answer/id #uuid "173df41c-e05b-574e-aa20-a8d310566036" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2\\setminus\\{(0,0)\\}" :db/id #edb/ref 17592186702485}] [:answer/id #uuid "21410ab2-1320-5733-a152-ba355682038b" {:answer/id #uuid "21410ab2-1320-5733-a152-ba355682038b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\mathbb R^2" :db/id #edb/ref 17592186702491}] [:answer/id #uuid "278bcbd6-88ef-53b1-8c5c-f9a389d47fa5" {:answer/id #uuid "278bcbd6-88ef-53b1-8c5c-f9a389d47fa5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702495}] [:answer/id #uuid "2a77ad0c-9822-5e2c-b80f-2602ffd6d7aa" {:answer/id #uuid "2a77ad0c-9822-5e2c-b80f-2602ffd6d7aa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Using planar scalar curl,\n\n$$\\operatorname{div}\\mathbf F=f_x+g_y,\\qquad\\operatorname{curl}\\mathbf G=f_x-(-g)_y=f_x+g_y.$$\n\nThe expressions are identical, so one is zero exactly when the other is zero. These are the definitions of source-free and irrotational, respectively." :db/id #edb/ref 17592186702500}] [:answer/id #uuid "2b0dd9f7-e858-58c2-9622-30b01c571ba7" {:answer/id #uuid "2b0dd9f7-e858-58c2-9622-30b01c571ba7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The instruction that both fields are conservative is false on the full stated domain. A global potential for $\\mathbf F$ is\n\n$$\\phi_F=\\tfrac12\\ln(x^2+y^2)=\\ln r.$$\n\nHowever, $\\oint_{r=1}\\mathbf G\\cdot\\mathbf T\\,ds=2\\pi\\ne0$, so $\\mathbf G$ has no single-valued global potential on the punctured plane. Consequently $\\mathbf F$ has no single-valued global stream function there.\n\nLocally, after choosing a continuous angle branch $\\theta=\\arg(x+iy)$ on a cut domain, $\\nabla\\theta=\\mathbf G$. Thus $\\phi_G=\\theta$ and $\\psi_F=\\theta$ work locally; on $x>0$ one may use $\\theta=\\arctan(y/x)$.\n\nBoth fields nevertheless have zero divergence and zero curl at every point of the stated domain. With $s=x^2+y^2$,\n\n$$\\operatorname{div}\\mathbf F=\\frac{s-2x^2+s-2y^2}{s^2}=0,\\qquad\n\\operatorname{curl}\\mathbf F=\\frac{-2xy+2xy}{s^2}=0,$$\n\n$$\\operatorname{div}\\mathbf G=\\frac{2xy-2xy}{s^2}=0,\\qquad\n\\operatorname{curl}\\mathbf G=\\frac{s-2x^2+s-2y^2}{s^2}=0.$$\n\nSo both meet the worksheet's zero-divergence/zero-curl conditions without both being globally conservative." :db/id #edb/ref 17592186702503}] [:answer/id #uuid "2b63134e-55f3-5061-8a0c-a841870a4892" {:answer/id #uuid "2b63134e-55f3-5061-8a0c-a841870a4892" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A potential for $\\mathbf G=\\langle-g,f\\rangle$ satisfies $\\zeta_x=-g$ and $\\zeta_y=f$. The definition of a stream function for $\\mathbf F=\\langle f,g\\rangle$ is precisely $\\zeta_y=f$, $\\zeta_x=-g$. The two conditions are identical in both directions." :db/id #edb/ref 17592186702505}] [:answer/id #uuid "31371801-c4b1-5108-988b-f1287d84a642" {:answer/id #uuid "31371801-c4b1-5108-988b-f1287d84a642" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186702511}] [:answer/id #uuid "33bdc090-a755-588f-843a-154b39670898" {:answer/id #uuid "33bdc090-a755-588f-843a-154b39670898" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By multiplicativity,\n\n$$\\det(A)=\\det(P^{-1}BP)=\\det(P^{-1})\\det(B)\\det(P)\n=\\frac{1}{\\det(P)}\\det(B)\\det(P)=\\det(B).$$\n\nThe cancellation is valid because $P$ is invertible, so $\\det(P)\\ne0$." :db/id #edb/ref 17592186702515}] [:answer/id #uuid "3e9ebcbc-b2da-58eb-b0aa-d994e87d860f" {:answer/id #uuid "3e9ebcbc-b2da-58eb-b0aa-d994e87d860f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At $P=(x_0,y_0)$, parametrize the line by $(x,y)=(x_0,y_0)+t(f(x_0,y_0),g(x_0,y_0))$. Its slope is $\\Delta y/\\Delta x=g(x_0,y_0)/f(x_0,y_0)$ when $f(x_0,y_0)\\ne0$. If $f=0$ and $g\\ne0$, the line is vertical. If $f=g=0$, the zero field vector specifies no direction." :db/id #edb/ref 17592186702518}] [:answer/id #uuid "447c4af3-2141-5ebb-8aad-46e4298a2833" {:answer/id #uuid "447c4af3-2141-5ebb-8aad-46e4298a2833" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "At a point with $f\\ne0$, substitute $\\psi_x=-g$ and $\\psi_y=f$ into the corrected relation from (b):\n\n$$\\frac{dy}{dx}=-\\frac{\\psi_x}{\\psi_y}=\\frac{g}{f}.$$\n\nThis is the slope of the field direction from (a), so the level curve is tangent to $\\mathbf F$.\n\nMore generally,\n\n$$\\nabla\\psi\\cdot\\mathbf F=(-g,f)\\cdot(f,g)=0.$$\n\nAt a regular point where $\\nabla\\psi\\ne0$, the gradient is normal to the level curve, so $\\mathbf F$ is tangent to it, including vertical tangents. Thus regular level curves follow the flow. At a stagnation point $\\mathbf F=0$, no nonzero field direction is specified; the zero vector still satisfies the orthogonality identity." :db/id #edb/ref 17592186702522}] [:answer/id #uuid "462deff5-b92c-575b-bde8-d2e265a1bc6f" {:answer/id #uuid "462deff5-b92c-575b-bde8-d2e265a1bc6f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both computations yield $2\\pi$, but the agreement alone does not make a direct full-disk invocation of Green's theorem valid. The origin is excluded from the domain. In this case, annular applications and a limit do justify the equality, because the inner-boundary contribution tends to zero." :db/id #edb/ref 17592186702524}] [:answer/id #uuid "4a7c0a2b-3a9f-5741-ad2d-ee14622e3578" {:answer/id #uuid "4a7c0a2b-3a9f-5741-ad2d-ee14622e3578" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The matrix is transposed. Transposing a square matrix preserves its determinant: $\\det(A^T)=\\det(A)$." :db/id #edb/ref 17592186702526}] [:answer/id #uuid "4e6eb92b-c2bf-5fd9-ac1d-05691eb1508e" {:answer/id #uuid "4e6eb92b-c2bf-5fd9-ac1d-05691eb1508e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Both computations yield $2\\pi$, but the agreement alone does not make a direct full-disk invocation of Green's theorem valid. The origin is excluded from the domain. In this case, annular applications and a limit do justify the equality, because the inner-boundary contribution tends to zero." :db/id #edb/ref 17592186702530}] [:answer/id #uuid "5805a00c-2392-5a80-91e5-b6d845f1b4dc" {:answer/id #uuid "5805a00c-2392-5a80-91e5-b6d845f1b4dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Here $\\operatorname{div}\\mathbf F=2$. Green's theorem applies because the field is $C^1$ on the entire disk and a neighborhood of it. Therefore\n\n$$\\oint_C\\mathbf F\\cdot\\mathbf n\\,ds=\\iint_D2\\,dA=2\\operatorname{area}(D)=2\\pi.$$" :db/id #edb/ref 17592186702538}] [:answer/id #uuid "5bf6e3f3-eb49-5df5-bc3e-82d627dcb3d0" {:answer/id #uuid "5bf6e3f3-eb49-5df5-bc3e-82d627dcb3d0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Take $\\phi_F=e^x\\cos y$ and $\\phi_G=e^x\\sin y$. Their gradients are exactly the two specified fields, so both are conservative. A stream function for $\\mathbf F$ is $\\psi=e^x\\sin y$.\n\nTheir divergences are $e^x\\cos y-e^x\\cos y=0$ and $e^x\\sin y-e^x\\sin y=0$. Their curls are also zero: for $\\mathbf F$, $-e^x\\sin y-(-e^x\\sin y)=0$; for $\\mathbf G$, $e^x\\cos y-e^x\\cos y=0$. Problem 1(b) gives $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G=0$ and, after rotating $\\mathbf G$ to $-\\mathbf F$, $\\operatorname{div}\\mathbf G=-\\operatorname{curl}\\mathbf F=0$. Thus both meet the stated ideal-flow conditions." :db/id #edb/ref 17592186702541}] [:answer/id #uuid "67f291fb-9f19-59f3-bc4a-4a57c01775f4" {:answer/id #uuid "67f291fb-9f19-59f3-bc4a-4a57c01775f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186702549}] [:answer/id #uuid "6df2a8bc-93cf-5744-a847-7101bcc33f96" {:answer/id #uuid "6df2a8bc-93cf-5744-a847-7101bcc33f96" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. The combination is $\\vec v=2\\vec u_1-\\vec u_2$:\n\n$$2\\begin{bmatrix}3\\\\1\\\\-1\\end{bmatrix}-\\begin{bmatrix}2\\\\-2\\\\1\\end{bmatrix}=\\begin{bmatrix}4\\\\4\\\\-3\\end{bmatrix}.$$" :db/id #edb/ref 17592186702552}] [:answer/id #uuid "6f481c20-7669-5276-b056-49ea2dd62d6c" {:answer/id #uuid "6f481c20-7669-5276-b056-49ea2dd62d6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-10" :db/id #edb/ref 17592186702554}] [:answer/id #uuid "71c153c5-b242-591a-bc0e-031852d164f8" {:answer/id #uuid "71c153c5-b242-591a-bc0e-031852d164f8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Potentials are $\\phi_F=(x^2-y^2)/2$ and $\\phi_G=xy$, since $\\nabla\\phi_F=(x,-y)$ and $\\nabla\\phi_G=(y,x)$. A stream function for $\\mathbf F$ is $\\psi=xy$.\n\nBoth curls are zero because the fields are gradients. Also, $\\operatorname{div}\\mathbf F=1-1=0$ and $\\operatorname{div}\\mathbf G=0+0=0$. Thus both have zero divergence and zero curl, as required here. Problem 1(b) gives $\\operatorname{div}\\mathbf F=\\operatorname{curl}\\mathbf G=0$. Applying it to $\\mathbf G$, whose rotated field is $-\\mathbf F$, also gives $\\operatorname{div}\\mathbf G=-\\operatorname{curl}\\mathbf F=0$. Problem 1(d) identifies the potential of $\\mathbf G$ with the stream function of $\\mathbf F$." :db/id #edb/ref 17592186702560}] [:answer/id #uuid "77b2897b-cbba-5228-9728-60335f0049bf" {:answer/id #uuid "77b2897b-cbba-5228-9728-60335f0049bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Direct calculation gives $2\\pi$, while the invalid full-disk use of Green's theorem gives $0$. The domain excludes the origin, so the theorem's regularity hypothesis fails inside $C$. The mismatch comes from ignoring the hole and its inner boundary, rather than from an error in the direct parametrization." :db/id #edb/ref 17592186702567}] [:answer/id #uuid "77f3dd9d-1119-51df-b553-4a43c4537b8d" {:answer/id #uuid "77f3dd9d-1119-51df-b553-4a43c4537b8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Choose every coefficient to be zero. Then $0\\vec x_1+\\cdots+0\\vec x_k=\\vec0$, which is a linear combination of the given vectors. Therefore $\\vec0$ belongs to their span." :db/id #edb/ref 17592186702568}] [:answer/id #uuid "790d672e-a0a4-5642-aed9-0114d854a533" {:answer/id #uuid "790d672e-a0a4-5642-aed9-0114d854a533" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702570}] [:answer/id #uuid "7f2ad2d7-d16c-56f6-871b-e9c3cb1c2424" {:answer/id #uuid "7f2ad2d7-d16c-56f6-871b-e9c3cb1c2424" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi" :db/id #edb/ref 17592186702575}] [:multistep/id #uuid "df893de7-f13c-5602-9b56-5e571d7a8b23" {:db/id #edb/ref 17592186702676 :multistep/context "Source: Problem 5(a–c), PDF page 6.\n\n**Stream functions produce streamlines.** Let $\\mathbf F=\\langle f,g\\rangle$ be source-free and let $\\psi$ be its stream function, meaning\n\n$$\\psi_y=f,\\qquad\\psi_x=-g.$$\n\nLet $P=(x,y)$ lie on the level curve $\\psi(x,y)=c$. Think of the level curve locally as $y=y(x)$. The source's dependency diagram shows $\\psi$ depending on both $x$ and $y$, with $y$ itself depending on $x$; thus the composite is $\\psi(x,y(x))$." :multistep/first-step {:db/id #edb/ref 17592186702669} :multistep/id #uuid "df893de7-f13c-5602-9b56-5e571d7a8b23" :multistep/steps [{:db/id #edb/ref 17592186702508 :step/content {:db/id #edb/ref 17592186702521} :step/id #uuid "2e731cbf-effb-54cf-ae8f-3968e42893e9" :step/next {:db/id #edb/ref 17592186702543}} {:db/id #edb/ref 17592186702543 :step/content {:db/id #edb/ref 17592186702509} :step/id #uuid "5d6273ec-8db9-5610-a426-8e0e3a559bf4"} {:db/id #edb/ref 17592186702669 :step/content {:db/id #edb/ref 17592186702690} :step/id #uuid "d985a7b6-8e60-5a31-bbae-2e977e7ef4d9" :step/next {:db/id #edb/ref 17592186702508}}]}] [:multistep/id #uuid "ffbba298-c987-52cc-b2d6-0f6398a806ca" {:db/id #edb/ref 17592186702702 :multistep/context "Source: Problem 2(a–c), each with tasks (i–iv), PDF page 3.\n\nLet $C$ be the counterclockwise unit circle centered at the origin. For each field in parts (a), (b), and (c): (i) find its domain; (ii) calculate the indicated integral by hand; (iii) calculate it “using” Green's theorem; and (iv) compare (ii) and (iii), using (i) to explain any difference." :multistep/first-step {:db/id #edb/ref 17592186702557} :multistep/id #uuid "ffbba298-c987-52cc-b2d6-0f6398a806ca" :multistep/steps [{:db/id #edb/ref 17592186702510 :step/content {:db/id #edb/ref 17592186702496} :step/id #uuid "2fbb8807-5f05-53de-9b4c-a755251602c5" :step/next {:db/id #edb/ref 17592186702674}} {:db/id #edb/ref 17592186702513 :step/content {:db/id #edb/ref 17592186702610} :step/id #uuid "32b089e4-8c50-5f23-9ff8-17e91aec80d5" :step/next {:db/id #edb/ref 17592186702555}} {:db/id #edb/ref 17592186702544 :step/content {:db/id #edb/ref 17592186702573} :step/id #uuid "61e16448-2f00-556b-9dbc-cb53013d3351" :step/next {:db/id #edb/ref 17592186702695}} {:db/id #edb/ref 17592186702555 :step/content {:db/id #edb/ref 17592186702582} :step/id #uuid "6fc68834-3537-544d-9861-179d1dd04245" :step/next {:db/id #edb/ref 17592186702605}} {:db/id #edb/ref 17592186702557 :step/content {:db/id #edb/ref 17592186702576} :step/id #uuid "7056f59b-ad63-5024-a35d-628649b30b2a" :step/next {:db/id #edb/ref 17592186702625}} {:db/id #edb/ref 17592186702565 :step/content {:db/id #edb/ref 17592186702634} :step/id #uuid "756c889b-72a9-5f44-b8e9-afe6c2f3e131" :step/next {:db/id #edb/ref 17592186702635}} {:db/id #edb/ref 17592186702578 :step/content {:db/id #edb/ref 17592186702482} :step/id #uuid "81d64fff-0bc5-5d3e-830b-e7c9b7dd2f5f"} {:db/id #edb/ref 17592186702605 :step/content {:db/id #edb/ref 17592186702484} :step/id #uuid "9bef3c0d-f4cd-5ab3-b23f-494cfc5409d1" :step/next {:db/id #edb/ref 17592186702565}} {:db/id #edb/ref 17592186702625 :step/content {:db/id #edb/ref 17592186702581} :step/id #uuid "ae2c7e88-7234-5963-8131-50c9a069b8e8" :step/next {:db/id #edb/ref 17592186702544}} {:db/id #edb/ref 17592186702635 :step/content {:db/id #edb/ref 17592186702645} :step/id #uuid "b7597cbb-86f3-5032-bd18-3c2df76741db" :step/next {:db/id #edb/ref 17592186702510}} {:db/id #edb/ref 17592186702674 :step/content {:db/id #edb/ref 17592186702656} :step/id #uuid "de12c1d7-83ae-5051-b5b9-90a1609e007b" :step/next {:db/id #edb/ref 17592186702578}} {:db/id #edb/ref 17592186702695 :step/content {:db/id #edb/ref 17592186702673} :step/id #uuid "f40b6336-8d0c-58ea-886d-3f9db164902a" :step/next {:db/id #edb/ref 17592186702513}}]}] [:multistep/id #uuid "18efe2aa-0ee7-5577-80d1-bacd43921887" {:db/id #edb/ref 17592186702487 :multistep/context "Source: Problem 4(a–c), PDF page 5.\n\n**Ideal Fluids.** The source describes an ideal fluid as one with “zero viscosity (zero divergence)” and “no vortex (zero curl).” Use its stated mathematical conditions of zero divergence and zero curl for this problem. For each pair, complete (i) the conservativeness and ideal-flow discussion and (ii) the potential/stream-function construction." :multistep/first-step {:db/id #edb/ref 17592186702639} :multistep/id #uuid "18efe2aa-0ee7-5577-80d1-bacd43921887" :multistep/steps [{:db/id #edb/ref 17592186702504 :step/content {:db/id #edb/ref 17592186702619} :step/id #uuid "2b5d7638-470c-5cb9-a45c-f5e921054684" :step/next {:db/id #edb/ref 17592186702558}} {:db/id #edb/ref 17592186702558 :step/content {:db/id #edb/ref 17592186702594} :step/id #uuid "7057a4dc-0dc5-54fc-92ab-54e3dd9d1119"} {:db/id #edb/ref 17592186702639 :step/content {:db/id #edb/ref 17592186702606} :step/id #uuid "b9069d3e-069d-5cf9-9283-6d1e3b99e561" :step/next {:db/id #edb/ref 17592186702504}}]}] [:multistep/id #uuid "2a27ae01-32f5-5430-8969-0add91b1daf5" {:db/id #edb/ref 17592186702499 :multistep/context "Source: Problem 1(a–d), PDF page 2.\n\nLet $\\mathbf F=\\langle f,g\\rangle$ and $\\mathbf G=\\langle-g,f\\rangle$, and let $C$ be any counterclockwise simple closed curve in the plane." :multistep/first-step {:db/id #edb/ref 17592186702559} :multistep/id #uuid "2a27ae01-32f5-5430-8969-0add91b1daf5" :multistep/steps [{:db/id #edb/ref 17592186702559 :step/content {:db/id #edb/ref 17592186702593} :step/id #uuid "712b84d0-c39b-536e-9e15-461ffda747fb" :step/next {:db/id #edb/ref 17592186702561}} {:db/id #edb/ref 17592186702561 :step/content {:db/id #edb/ref 17592186702486} :step/id #uuid "72d79f5d-9597-59be-baca-aed7d0058847" :step/next {:db/id #edb/ref 17592186702696}} {:db/id #edb/ref 17592186702687 :step/content {:db/id #edb/ref 17592186702502} :step/id #uuid "e94a90f5-9727-5d2a-9c9a-3bda73a14177"} {:db/id #edb/ref 17592186702696 :step/content {:db/id #edb/ref 17592186702480} :step/id #uuid "f4d2ea44-5469-5f2d-98bd-2c2580332bcd" :step/next {:db/id #edb/ref 17592186702687}}]}] [:multistep/id #uuid "6524fe0f-3387-5099-a4eb-239ad80a370e" {:db/id #edb/ref 17592186702547 :multistep/context "Source exercise: 3.1.1(a–c), textbook printed page 126 (PDF page 138)." :multistep/first-step {:db/id #edb/ref 17592186702603} :multistep/id #uuid "6524fe0f-3387-5099-a4eb-239ad80a370e" :multistep/steps [{:db/id #edb/ref 17592186702546 :step/content {:db/id #edb/ref 17592186702532} :step/id #uuid "63d2e57f-e110-5ff4-9ee8-643a619ec0c9" :step/next {:db/id #edb/ref 17592186702659}} {:db/id #edb/ref 17592186702603 :step/content {:db/id #edb/ref 17592186702688} :step/id #uuid "980350aa-c6b9-5833-acad-4f4657469d3c" :step/next {:db/id #edb/ref 17592186702546}} {:db/id #edb/ref 17592186702659 :step/content {:db/id #edb/ref 17592186702677} :step/id #uuid "d3680e4d-a83e-59c1-98f6-48c84f2ca0ab"}]}] [:multistep/id #uuid "790bf7b9-b5d7-5639-b5b0-fe2cef244b42" {:db/id #edb/ref 17592186702569 :multistep/context "Source: Problem 3(a–c), each with tasks (i–iv), PDF page 4.\n\nLet $C$ be the counterclockwise unit circle centered at the origin. 