 {:db/id "4a7c0a2b-3a9f-5741-ad2d-ee14622e3578"
  :answer/id #uuid "4a7c0a2b-3a9f-5741-ad2d-ee14622e3578"
  :answer/type :answer.type/text
  :answer/value "The matrix is transposed. Transposing a square matrix preserves its determinant: $\\det(A^T)=\\det(A)$."
