 {:db/id "6df2a8bc-93cf-5744-a847-7101bcc33f96"
  :answer/id #uuid "6df2a8bc-93cf-5744-a847-7101bcc33f96"
  :answer/type :answer.type/text
  :answer/value "Yes. The combination is $\\vec v=2\\vec u_1-\\vec u_2$:\n\n$$2\\begin{bmatrix}3\\\\1\\\\-1\\end{bmatrix}-\\begin{bmatrix}2\\\\-2\\\\1\\end{bmatrix}=\\begin{bmatrix}4\\\\4\\\\-3\\end{bmatrix}.$$"
  :db/ensure :answer/validate}
