 {:db/id "8d0ab866-196e-52dc-89f3-7c3a4c5069af"
  :answer/id #uuid "8d0ab866-196e-52dc-89f3-7c3a4c5069af"
  :answer/type :answer.type/text
  :answer/value "They are dependent because $\\vec v_3=-2\\vec v_1+3\\vec v_2$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_4\\}$."
  :db/ensure :answer/validate}
