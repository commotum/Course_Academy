 {:db/id "77f3dd9d-1119-51df-b553-4a43c4537b8d"
  :answer/id #uuid "77f3dd9d-1119-51df-b553-4a43c4537b8d"
  :answer/type :answer.type/text
  :answer/value "Choose every coefficient to be zero. Then $0\\vec x_1+\\cdots+0\\vec x_k=\\vec0$, which is a linear combination of the given vectors. Therefore $\\vec0$ belongs to their span."
  :db/ensure :answer/validate}
