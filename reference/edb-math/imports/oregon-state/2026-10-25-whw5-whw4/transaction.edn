 {:db/id "c2e1fa68-9010-5f23-9d15-43d096747c65"
  :answer/id #uuid "c2e1fa68-9010-5f23-9d15-43d096747c65"
  :answer/type :answer.type/text
  :answer/value "No. Each generating vector satisfies $z=-2x$, so every linear combination also satisfies $z=-2x$. The target has $x=1$ and $z=-1$, which fails that relation. It is outside the span, so no such linear combination exists."
  :db/ensure :answer/validate}
