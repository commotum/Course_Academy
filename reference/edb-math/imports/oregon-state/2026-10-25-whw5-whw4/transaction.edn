 {:db/id "d2c166ff-5c16-531f-9839-59410b5343f6"
  :answer/id #uuid "d2c166ff-5c16-531f-9839-59410b5343f6"
  :answer/type :answer.type/text
  :answer/value "They are dependent because $\\vec v_4=-6\\vec v_1+4\\vec v_2+3\\vec v_3$. An independent set with the same span is $\\{\\vec v_1,\\vec v_2,\\vec v_3\\}$."
  :db/ensure :answer/validate}
