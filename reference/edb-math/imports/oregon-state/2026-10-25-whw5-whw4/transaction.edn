 {:db/id "3e9ebcbc-b2da-58eb-b0aa-d994e87d860f"
  :answer/id #uuid "3e9ebcbc-b2da-58eb-b0aa-d994e87d860f"
  :answer/type :answer.type/text
  :answer/value "At $P=(x_0,y_0)$, parametrize the line by $(x,y)=(x_0,y_0)+t(f(x_0,y_0),g(x_0,y_0))$. Its slope is $\\Delta y/\\Delta x=g(x_0,y_0)/f(x_0,y_0)$ when $f(x_0,y_0)\\ne0$. If $f=0$ and $g\\ne0$, the line is vertical. If $f=g=0$, the zero field vector specifies no direction."
  :db/ensure :answer/validate}
