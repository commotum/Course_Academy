 {:db/id "e6efe144-d94b-534b-8b5b-139afff1be5c"
  :answer/id #uuid "e6efe144-d94b-534b-8b5b-139afff1be5c"
  :answer/type :answer.type/text
  :answer/value "It is false in general. Take $A=B=I_2$. Then $\\det(A)+\\det(B)=1+1=2$, while $\\det(A+B)=\\det(2I_2)=4$."
  :db/ensure :answer/validate}
