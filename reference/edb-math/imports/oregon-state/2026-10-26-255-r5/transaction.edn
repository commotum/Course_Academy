 {:db/id "d4d18464-6bd9-506f-8c72-09a6410dde12"
  :question/id #uuid "d4d18464-6bd9-506f-8c72-09a6410dde12"
  :question/problem "**(a)** Find $\\operatorname{curl}\\mathbf F$.\n\nScalar curl: {{answer}}."
  :question/answer-fields ["6cbd8f99-fe20-5c85-aa8f-36cf039177e9"]
  :question/worked-solution "For $\\mathbf F=(P,Q)=(0,f(x))$, the planar scalar curl is $Q_x-P_y=f'(x)-0=f'(x)$."
  :db/ensure :question/validate}
 {:db/id "d469e5c0-77c8-51f1-ba34-7ee6ba184feb"
  :answer/id #uuid "d469e5c0-77c8-51f1-ba34-7ee6ba184feb"
  :answer/type :answer.type/text
  :answer/value "On either horizontal edge, $dy=0$. Since $\\mathbf F\\cdot\\mathbf T\\,ds=P\\,dx+Q\\,dy=0\\,dx+f(x)\\,dy$, the integrand is zero. Thus the integral along each of the top and bottom edges is zero."
  :db/ensure :answer/validate}
