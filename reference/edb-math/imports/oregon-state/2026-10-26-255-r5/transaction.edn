 {:db/id "03a7f72f-b44a-5c0f-ab85-f67c045f2da6"
  :question/id #uuid "03a7f72f-b44a-5c0f-ab85-f67c045f2da6"
  :question/problem "**(c)** Show that on the right edge of $R$, $\\int_C\\mathbf F\\cdot\\mathbf T\\,ds=f(b)$."
  :question/answer-fields ["54d42c6e-fe33-5b85-adc2-c6085a520af9"]
  :question/worked-solution "The right edge has length one, $x=b$ is fixed, and the tangent points upward. A downward parametrization would have the wrong sign for the specified boundary orientation."
  :db/ensure :question/validate}
 {:db/id "cb1f9095-887a-5b33-be76-f21c24415e49"
  :answer/id #uuid "cb1f9095-887a-5b33-be76-f21c24415e49"
  :answer/type :answer.type/text
  :answer/value "The left edge is traversed downward from $(a,1)$ to $(a,0)$. Thus\n\n$$\\int_C\\mathbf F\\cdot\\mathbf T\\,ds=\\int_1^0 f(a)\\,dy=-f(a).$$"
  :db/ensure :answer/validate}
