#{[:activity/id #uuid "67a9d64d-9f6b-5276-b3ba-06d503c39c11" {:activity/course {:db/id #edb/ref 17592186405206} :activity/first-step {:db/id #edb/ref 17592186761980} :activity/id #uuid "67a9d64d-9f6b-5276-b3ba-06d503c39c11" :activity/steps [{:db/id #edb/ref 17592186761960 :step/content {:db/id #edb/ref 17592186761977} :step/id #uuid "016f8bf7-a125-5fb5-b860-fd105e9e7f78" :step/next {:db/id #edb/ref 17592186761966}} {:db/id #edb/ref 17592186761966 :step/content {:db/id #edb/ref 17592186761976} :step/id #uuid "26645688-b2e4-5e4c-aeb0-14ea36978d4d"} {:db/id #edb/ref 17592186761972 :step/content {:db/id #edb/ref 17592186761975} :step/id #uuid "93fe29f7-3b2a-5395-880c-9c0a389fdee6" :step/next {:db/id #edb/ref 17592186761978}} {:db/id #edb/ref 17592186761978 :step/content {:db/id #edb/ref 17592186761963} :step/id #uuid "f18ba8b9-1eb5-5238-aaeb-c4bd45717a8b" :step/next {:db/id #edb/ref 17592186761960}} {:db/id #edb/ref 17592186761980 :step/content {:db/id #edb/ref 17592186761962} :step/id #uuid "fd318543-88ec-541e-89b2-32ce0c371a22" :step/next {:db/id #edb/ref 17592186761972}}] :activity/title "MTH 341 — SG-3: MiniExam 3 Review" :activity/type {:db/id #edb/ref 17592186045461} :db/id #edb/ref 17592186761967}] [:step/id #uuid "93fe29f7-3b2a-5395-880c-9c0a389fdee6" {:db/id #edb/ref 17592186761972 :step/content {:db/id #edb/ref 17592186761975} :step/id #uuid "93fe29f7-3b2a-5395-880c-9c0a389fdee6" :step/next {:db/id #edb/ref 17592186761978}}] [:step/id #uuid "f18ba8b9-1eb5-5238-aaeb-c4bd45717a8b" {:db/id #edb/ref 17592186761978 :step/content {:db/id #edb/ref 17592186761963} :step/id #uuid "f18ba8b9-1eb5-5238-aaeb-c4bd45717a8b" :step/next {:db/id #edb/ref 17592186761960}}] [:step/id #uuid "fd318543-88ec-541e-89b2-32ce0c371a22" {:db/id #edb/ref 17592186761980 :step/content {:db/id #edb/ref 17592186761962} :step/id #uuid "fd318543-88ec-541e-89b2-32ce0c371a22" :step/next {:db/id #edb/ref 17592186761972}}] [:step/id #uuid "016f8bf7-a125-5fb5-b860-fd105e9e7f78" {:db/id #edb/ref 17592186761960 :step/content {:db/id #edb/ref 17592186761977} :step/id #uuid "016f8bf7-a125-5fb5-b860-fd105e9e7f78" :step/next {:db/id #edb/ref 17592186761966}}] [:step/id #uuid "26645688-b2e4-5e4c-aeb0-14ea36978d4d" {:db/id #edb/ref 17592186761966 :step/content {:db/id #edb/ref 17592186761976} :step/id #uuid "26645688-b2e4-5e4c-aeb0-14ea36978d4d"}] [:tutorial/id #uuid "102e06e8-225a-5b61-b2d2-eb91a24a8aa1" {:db/id #edb/ref 17592186761962 :tutorial/content "**MTH 341 — MiniExam 3 Review**\n\nDue: unknown\nDate imported: 2026-11-13\nSource: [MiniExam 3 review.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FSG-3%2FMiniExam%203%20review.pdf), page 1.\nProvided solutions: [MiniExam 3 review solutions.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FSG-3%2FMiniExam%203%20review%20solutions.pdf), handwritten solutions on pages 2–3.\nTextbook: [Kuttler, *A First Course in Linear Algebra*, 2017A](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf).\n\nThe written-response references and feedback are authored study additions, independently checked against the provided solutions. Item 1 is an ungraded review reminder.\n\n## Instructions\n\nMiniExam 3 covers textbook sections **4.10.4, 4.10.5, 5.1–5.4, and 5.7**. This review is not exhaustive. Work additional similar textbook problems as needed until you are comfortable with the material. The source lists no updates yet." :tutorial/id #uuid "102e06e8-225a-5b61-b2d2-eb91a24a8aa1" :tutorial/title "Exam information and preparation advice"}] [:question/id #uuid "897f755e-3cd3-5461-95ec-90b1f155ae03" {:db/id #edb/ref 17592186761970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93f20987-89ed-561b-a680-7f74ea672d6a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By definition, $\\operatorname{im}(A)=\\{A\\mathbf{x}:\\mathbf{x}\\in\\mathbb R^n\\}\\subseteq\\mathbb R^m$.\n\nThe zero vector belongs to the image because $A\\mathbf 0_n=\\mathbf 0_m$.\n\nLet $\\mathbf u,\\mathbf v\\in\\operatorname{im}(A)$. There are $\\mathbf x,\\mathbf y\\in\\mathbb R^n$ with $\\mathbf u=A\\mathbf x$ and $\\mathbf v=A\\mathbf y$. Then\n$$\\mathbf u+\\mathbf v=A\\mathbf x+A\\mathbf y=A(\\mathbf x+\\mathbf y)\\in\\operatorname{im}(A),$$\nsince $\\mathbf x+\\mathbf y\\in\\mathbb R^n$.\n\nFor any $c\\in\\mathbb R$ and $\\mathbf u=A\\mathbf x\\in\\operatorname{im}(A)$,\n$$c\\mathbf u=c(A\\mathbf x)=A(c\\mathbf x)\\in\\operatorname{im}(A),$$\nsince $c\\mathbf x\\in\\mathbb R^n$.\n\nThus the image contains zero and is closed under addition and scalar multiplication. By the Subspace Test, it is a subspace of $\\mathbb R^m$." :db/id #edb/ref 17592186761971}] :answer-field/correct {:db/id #edb/ref 17592186761971} :answer-field/id #uuid "71fcccac-2f8f-5096-8665-4877117b7289" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186761968}] :question/id #uuid "897f755e-3cd3-5461-95ec-90b1f155ae03" :question/problem "Source item: 2, review page 1; provided solution page 2.\n\nLet $A$ be any $m\\times n$ matrix. Show by the Subspace Test that the image of $A$, $\\operatorname{im}(A)$, is a subspace." :question/worked-solution "Check all three conditions using arbitrary image vectors and an arbitrary real scalar. The vectors in the image lie in $\\mathbb R^m$; their preimages lie in $\\mathbb R^n$."}] [:question/id #uuid "c60ece8b-2bf3-53ec-8b45-32c7a99d6a70" {:db/id #edb/ref 17592186761974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "883b16ba-6454-5300-94ec-d4c6a7838393" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Let $S=\\operatorname{span}\\{T(\\mathbf v_1),\\ldots,T(\\mathbf v_n)\\}$. We prove both inclusions.\n\nFirst, take $\\mathbf z\\in\\operatorname{im}(T)$. Then $\\mathbf z=T(\\mathbf x)$ for some $\\mathbf x\\in\\mathbb R^n$. Since $\\beta$ is a basis, there are scalars $c_1,\\ldots,c_n\\in\\mathbb R$ such that $\\mathbf x=\\sum_{i=1}^n c_i\\mathbf v_i$. By linearity,\n$$\\mathbf z=T\\left(\\sum_{i=1}^n c_i\\mathbf v_i\\right)=\\sum_{i=1}^n c_iT(\\mathbf v_i)\\in S.$$\nThus $\\operatorname{im}(T)\\subseteq S$.\n\nConversely, take $\\mathbf z\\in S$. By the definition of span, $\\mathbf z=\\sum_{i=1}^n c_iT(\\mathbf v_i)$ for some real scalars $c_i$. Set $\\mathbf x=\\sum_{i=1}^n c_i\\mathbf v_i\\in\\mathbb R^n$. Linearity gives\n$$\\mathbf z=\\sum_{i=1}^n c_iT(\\mathbf v_i)=T(\\mathbf x)\\in\\operatorname{im}(T).$$\nHence $S\\subseteq\\operatorname{im}(T)$. The two inclusions prove the equality." :db/id #edb/ref 17592186761969}] :answer-field/correct {:db/id #edb/ref 17592186761969} :answer-field/id #uuid "f7fb8c42-f6f4-53ac-9895-5deecb510ed4" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186761979}] :question/id #uuid "c60ece8b-2bf3-53ec-8b45-32c7a99d6a70" :question/problem "Source item: 4, review page 1; provided solution page 3.\n\nLet $T:\\mathbb R^n\\to\\mathbb R^m$ be a linear transformation, and let $\\beta=\\{\\mathbf v_1,\\ldots,\\mathbf v_n\\}$ be a basis for $\\mathbb R^n$. Show that\n$$\\operatorname{im}(T)=\\operatorname{span}\\{T(\\mathbf v_1),\\ldots,T(\\mathbf v_n)\\}.$$" :question/worked-solution "Use the basis to express an arbitrary domain vector as a linear combination, then apply linearity. Establish both set inclusions. The images of basis vectors span the image but need not be linearly independent."}] [:question/id #uuid "0fd4ea3b-76dc-5383-a56f-7b19ab75582d" {:db/id #edb/ref 17592186761961 :question/id #uuid "0fd4ea3b-76dc-5383-a56f-7b19ab75582d" :question/problem "Source item: 1, review page 1.\n\nReview **all in-class activities from W5D1 through W6D3** and **Written Homeworks 4 and 5**. These form a big portion of your review.\n\nCoursework: [Written Homework 4](http://127.0.0.1:8765/assignments?assignment=d58af8ee-31ff-5364-87d1-9474dd41865f); [Written Homework 5](http://127.0.0.1:8765/assignments?assignment=4771eb83-434d-5edb-a38a-03676de85913)."}] [:question/id #uuid "2629cd67-2636-561c-a060-0f5663453305" {:db/id #edb/ref 17592186761965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aabe492-ae31-58e3-8897-8a109a7ba203" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No. Take $\\mathbf u=\\begin{bmatrix}1\\\\0\\\\0\\\\0\\end{bmatrix}$. Since $|1|\\le4$, we have $\\mathbf u\\in M$. But\n$$5\\mathbf u=\\begin{bmatrix}5\\\\0\\\\0\\\\0\\end{bmatrix}\\notin M,$$\nbecause $|5|>4$. Therefore $M$ is not closed under scalar multiplication and is not a subspace of $\\mathbb R^4$." :db/id #edb/ref 17592186761964}] :answer-field/correct {:db/id #edb/ref 17592186761964} :answer-field/id #uuid "c3e94bf9-459a-57a4-b8a7-b3f507c74d3f" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186761973}] :question/id #uuid "2629cd67-2636-561c-a060-0f5663453305" :question/problem "Source item: 3, review page 1; provided solution page 2.\n\nLet\n$$M=\\left\\{\\mathbf u=\\begin{bmatrix}u_1\\\\u_2\\\\u_3\\\\u_4\\end{bmatrix}\\in\\mathbb R^4:|u_1|\\le4\\right\\}.$$\nIs $M$ a subspace? Explain." :question/worked-solution "A counterexample must start with a vector in $M$ and produce a scalar multiple outside $M$. Containing the zero vector alone is not enough to be a subspace."}] [:answer-field/id #uuid "c3e94bf9-459a-57a4-b8a7-b3f507c74d3f" {:answer-field/choices [{:answer/id #uuid "1aabe492-ae31-58e3-8897-8a109a7ba203" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No. Take $\\mathbf u=\\begin{bmatrix}1\\\\0\\\\0\\\\0\\end{bmatrix}$. Since $|1|\\le4$, we have $\\mathbf u\\in M$. But\n$$5\\mathbf u=\\begin{bmatrix}5\\\\0\\\\0\\\\0\\end{bmatrix}\\notin M,$$\nbecause $|5|>4$. Therefore $M$ is not closed under scalar multiplication and is not a subspace of $\\mathbb R^4$." :db/id #edb/ref 17592186761964}] :answer-field/correct {:db/id #edb/ref 17592186761964} :answer-field/id #uuid "c3e94bf9-459a-57a4-b8a7-b3f507c74d3f" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186761973}] [:answer-field/id #uuid "f7fb8c42-f6f4-53ac-9895-5deecb510ed4" {:answer-field/choices [{:answer/id #uuid "883b16ba-6454-5300-94ec-d4c6a7838393" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Let $S=\\operatorname{span}\\{T(\\mathbf v_1),\\ldots,T(\\mathbf v_n)\\}$. We prove both inclusions.\n\nFirst, take $\\mathbf z\\in\\operatorname{im}(T)$. Then $\\mathbf z=T(\\mathbf x)$ for some $\\mathbf x\\in\\mathbb R^n$. Since $\\beta$ is a basis, there are scalars $c_1,\\ldots,c_n\\in\\mathbb R$ such that $\\mathbf x=\\sum_{i=1}^n c_i\\mathbf v_i$. By linearity,\n$$\\mathbf z=T\\left(\\sum_{i=1}^n c_i\\mathbf v_i\\right)=\\sum_{i=1}^n c_iT(\\mathbf v_i)\\in S.$$\nThus $\\operatorname{im}(T)\\subseteq S$.\n\nConversely, take $\\mathbf z\\in S$. By the definition of span, $\\mathbf z=\\sum_{i=1}^n c_iT(\\mathbf v_i)$ for some real scalars $c_i$. Set $\\mathbf x=\\sum_{i=1}^n c_i\\mathbf v_i\\in\\mathbb R^n$. Linearity gives\n$$\\mathbf z=\\sum_{i=1}^n c_iT(\\mathbf v_i)=T(\\mathbf x)\\in\\operatorname{im}(T).$$\nHence $S\\subseteq\\operatorname{im}(T)$. The two inclusions prove the equality." :db/id #edb/ref 17592186761969}] :answer-field/correct {:db/id #edb/ref 17592186761969} :answer-field/id #uuid "f7fb8c42-f6f4-53ac-9895-5deecb510ed4" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186761979}] [:answer-field/id #uuid "71fcccac-2f8f-5096-8665-4877117b7289" {:answer-field/choices [{:answer/id #uuid "93f20987-89ed-561b-a680-7f74ea672d6a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By definition, $\\operatorname{im}(A)=\\{A\\mathbf{x}:\\mathbf{x}\\in\\mathbb R^n\\}\\subseteq\\mathbb R^m$.\n\nThe zero vector belongs to the image because $A\\mathbf 0_n=\\mathbf 0_m$.\n\nLet $\\mathbf u,\\mathbf v\\in\\operatorname{im}(A)$. There are $\\mathbf x,\\mathbf y\\in\\mathbb R^n$ with $\\mathbf u=A\\mathbf x$ and $\\mathbf v=A\\mathbf y$. Then\n$$\\mathbf u+\\mathbf v=A\\mathbf x+A\\mathbf y=A(\\mathbf x+\\mathbf y)\\in\\operatorname{im}(A),$$\nsince $\\mathbf x+\\mathbf y\\in\\mathbb R^n$.\n\nFor any $c\\in\\mathbb R$ and $\\mathbf u=A\\mathbf x\\in\\operatorname{im}(A)$,\n$$c\\mathbf u=c(A\\mathbf x)=A(c\\mathbf x)\\in\\operatorname{im}(A),$$\nsince $c\\mathbf x\\in\\mathbb R^n$.\n\nThus the image contains zero and is closed under addition and scalar multiplication. By the Subspace Test, it is a subspace of $\\mathbb R^m$." :db/id #edb/ref 17592186761971}] :answer-field/correct {:db/id #edb/ref 17592186761971} :answer-field/id #uuid "71fcccac-2f8f-5096-8665-4877117b7289" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186761968}] [:answer/id #uuid "883b16ba-6454-5300-94ec-d4c6a7838393" {:answer/id #uuid "883b16ba-6454-5300-94ec-d4c6a7838393" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Let $S=\\operatorname{span}\\{T(\\mathbf v_1),\\ldots,T(\\mathbf v_n)\\}$. We prove both inclusions.\n\nFirst, take $\\mathbf z\\in\\operatorname{im}(T)$. Then $\\mathbf z=T(\\mathbf x)$ for some $\\mathbf x\\in\\mathbb R^n$. Since $\\beta$ is a basis, there are scalars $c_1,\\ldots,c_n\\in\\mathbb R$ such that $\\mathbf x=\\sum_{i=1}^n c_i\\mathbf v_i$. By linearity,\n$$\\mathbf z=T\\left(\\sum_{i=1}^n c_i\\mathbf v_i\\right)=\\sum_{i=1}^n c_iT(\\mathbf v_i)\\in S.$$\nThus $\\operatorname{im}(T)\\subseteq S$.\n\nConversely, take $\\mathbf z\\in S$. By the definition of span, $\\mathbf z=\\sum_{i=1}^n c_iT(\\mathbf v_i)$ for some real scalars $c_i$. Set $\\mathbf x=\\sum_{i=1}^n c_i\\mathbf v_i\\in\\mathbb R^n$. Linearity gives\n$$\\mathbf z=\\sum_{i=1}^n c_iT(\\mathbf v_i)=T(\\mathbf x)\\in\\operatorname{im}(T).$$\nHence $S\\subseteq\\operatorname{im}(T)$. The two inclusions prove the equality." :db/id #edb/ref 17592186761969}] [:answer/id #uuid "93f20987-89ed-561b-a680-7f74ea672d6a" {:answer/id #uuid "93f20987-89ed-561b-a680-7f74ea672d6a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "By definition, $\\operatorname{im}(A)=\\{A\\mathbf{x}:\\mathbf{x}\\in\\mathbb R^n\\}\\subseteq\\mathbb R^m$.\n\nThe zero vector belongs to the image because $A\\mathbf 0_n=\\mathbf 0_m$.\n\nLet $\\mathbf u,\\mathbf v\\in\\operatorname{im}(A)$. There are $\\mathbf x,\\mathbf y\\in\\mathbb R^n$ with $\\mathbf u=A\\mathbf x$ and $\\mathbf v=A\\mathbf y$. Then\n$$\\mathbf u+\\mathbf v=A\\mathbf x+A\\mathbf y=A(\\mathbf x+\\mathbf y)\\in\\operatorname{im}(A),$$\nsince $\\mathbf x+\\mathbf y\\in\\mathbb R^n$.\n\nFor any $c\\in\\mathbb R$ and $\\mathbf u=A\\mathbf x\\in\\operatorname{im}(A)$,\n$$c\\mathbf u=c(A\\mathbf x)=A(c\\mathbf x)\\in\\operatorname{im}(A),$$\nsince $c\\mathbf x\\in\\mathbb R^n$.\n\nThus the image contains zero and is closed under addition and scalar multiplication. By the Subspace Test, it is a subspace of $\\mathbb R^m$." :db/id #edb/ref 17592186761971}] [:answer/id #uuid "1aabe492-ae31-58e3-8897-8a109a7ba203" {:answer/id #uuid "1aabe492-ae31-58e3-8897-8a109a7ba203" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No. Take $\\mathbf u=\\begin{bmatrix}1\\\\0\\\\0\\\\0\\end{bmatrix}$. Since $|1|\\le4$, we have $\\mathbf u\\in M$. But\n$$5\\mathbf u=\\begin{bmatrix}5\\\\0\\\\0\\\\0\\end{bmatrix}\\notin M,$$\nbecause $|5|>4$. Therefore $M$ is not closed under scalar multiplication and is not a subspace of $\\mathbb R^4$." :db/id #edb/ref 17592186761964}] [:assigned-problem/id #uuid "d3245a3f-cfa6-51b0-969a-7390393ea8fd" {:assigned-problem/content {:db/id #edb/ref 17592186761961} :assigned-problem/id #uuid "d3245a3f-cfa6-51b0-969a-7390393ea8fd" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048146} {:db/id #edb/ref 17592186048181} {:db/id #edb/ref 17592186048218} {:db/id #edb/ref 17592186048315} {:db/id #edb/ref 17592186048445} 