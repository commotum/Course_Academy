  {
    "label": "762f5a81-4149-53c4-ba2b-a7b27100496e",
    "record": {
      "question": {
        ":question/problem": "Source question: Canvas Question 1, ID 59595266; submitted attempt 1.\n\nLet $A$, $B$, and $C$ be invertible matrices of the same size. Which of the following is the inverse of $BAC^T$?",
        ":question/answer-fields": [
          {
            ":answer-field/key": "selection",
            ":answer-field/type": ":answer-field.type/radio",
            ":answer-field/choices": [
              {
                ":answer/id": "30b76a0f-963b-541b-aedc-7f065649cf79",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\left(BAC^T\\right)^{-1}=B^{-1}A^{-1}\\left(C^{-1}\\right)^T"
              },
              {
                ":answer/id": "9dd55b88-5180-57bf-ab85-0e6a1113197f",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\left(BAC^T\\right)^{-1}=C^{-1}\\left(A^{-1}\\right)^T\\left(B^{-1}\\right)^T"
              },
              {
                ":answer/id": "b1586578-00d3-5990-a904-746c560e5aed",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\left(BAC^T\\right)^{-1}=\\left(C^{-1}\\right)^TA^{-1}B^{-1}"
              },
              {
                ":answer/id": "081be212-14f1-5229-83e3-d5a4667daf3a",
                ":answer/type": ":answer.type/math",
                ":answer/value": "\\left(BAC^T\\right)^{-1}=\\left(B^{-1}\\right)^T\\left(A^{-1}\\right)^TC^{-1}"
              }
            ],
            ":answer-field/correct": [
              ":answer/id",
              "b1586578-00d3-5990-a904-746c560e5aed"
            ]
          }
        ]
      },
      "knowledge_point": {
        "title": "MTH 341 actual past exam"
      },
      "generation": {
        "template": "imported-past-exam"
      }
    },
