186502323 true] [17592186762791 1063 #edb/ref 17592186762823 13194139547743 17592186502323 true] [17592186762792 1080 "$$A^{-1}=\\begin{bmatrix}1&0&0\\\\0&1/2&0\\\\2/3&0&1/3\\end{bmatrix}.$$ In the requested format:\n\n[ 1 0 0 ]\n[ 0 1/2 0 ]\n[ 2/3 0 1/3 ]" 13194139547743 17592186502323 true] [17592186762792 1082 #edb/ref 17592186045499 13194139547743 17592186502323 true] [17592186762792 1083 #uuid "21d2aef3-9260-5405-9bb9-b08b779da867" 13194139547743 17592186502323 true] [17592186762793 1088 #edb/ref 17592186049875 13194139547743 17592186502323 true] [17592186762793 1089 #edb/ref 17592186762927 13194139547743 17592186502323 true] [17592186762793 1090 #uuid "270490ea-2d32-5109-a350-9a90ea4e2cd8" 13194139547743 17592186502323 true] [17592186762794 1068 #edb/ref 17592186762939 13194139547743 17592186502323 true] [17592186762794 1071 "Source question: Canvas Question 7, ID 59595352; submitted attempt 1.\n\nAre the vectors $\\left\\{\\begin{bmatrix}0\\\\-1\\\\1\\end{bmatrix},\\begin{bmatrix}2\\\\0\\\\1\\end{bmatrix},\\begin{bmatrix}2\\\\-3\\\\4\\end{bmatrix}\\right\\}$ linearly independent?" 13194139547743 17592186502323 true] [17592186762794 1072 #uuid "2a4c681d-2c6f-5b86-9381-36d0f90bc11b" 13194139547743 17592186502323 true] [17592186762794 1074 "No. If the vectors are $v_1,v_2,v_3$, then $v_3=3v_1+v_2$. Equivalently, $3v_1+v_2-v_3=0$ is a nontrivial relation.\n\nHistorical Canvas result: 2/2 points, submitted 2026-10-30 at 23:11 PDT." 13194139547743 17592186502323 true] [17592186762795 1058 #edb/ref 17592186762894 13194139547743 17592186502323 true] [17592186762795 1062 #uuid "2ad830ac-2861-53e8-8056-ae5befe9c0af" 13194139547743 17592186502323 true] [17592186762795 1063 #edb/ref 17592186762835 13194139547743 17592186502323 true] [17592186762796 1080 "True" 13194139547743 17592186502323 true] [17592186762796 1081 "Incorrect. False. With $A=2I_2$ and $B=I_2$, the left side is $1$ while the right side is $4-1=3$. The determinant is not additive over matrices." 13194139547743 17592186502323 true] [17592186762796 1082 #edb/ref 17592186045499 13194139547743 17592186502323 true] [17592186762796 1083 #uuid "2afe1050-9056-5da6-b334-5c7ee47ea5c5" 13194139547743 17592186502323 true] [17592186762797 1088 #edb/ref 17592186048742 13194139547743 17592186502323 true] [17592186762797 1088 #edb/ref 17592186048980 13194139547743 17592186502323 true] [17592186762797 1089 #edb/ref 17592186762887 13194139547743 17592186502323 true] [17592186762797 1090 #uuid "2c578cff-dc02-5a8c-a845-b17dc50cfdc0" 13194139547743 17592186502323 true] [17592186762798 1080 "No" 13194139547743 17592186502323 true] [17592186762798 1081 "Incorrect. Yes. The matrix with these columns is $\\begin{bmatrix}1&2&-1\\\\-1&0&-2\\\\1&-2&0\\end{bmatrix}$, whose determinant is $-10\\ne0$. Hence its columns are independent." 13194139547743 17592186502323 true] [17592186762798 1082 #edb/ref 17592186045499 13194139547743 17592186502323 true] [17592186762798 1083 #uuid "308d03c9-9008-554a-a821-66ad7bbf1774" 13194139547743 17592186502323 true] [17592186762799 1080 "\\left(BAC^T\\right)^{-1}=B^{-1}A^{-1}\\left(C^{-1}\\right)^T" 13194139547743 17592186502323 true] [17592186762799 1081 "Incorrect. Reverse the factor order: $(BAC^T)^{-1}=(C^T)^{-1}A^{-1}B^{-1}$. The inverse of a transpose is the transpose of the inverse, so $(C^T)^{-1}=(C^{-1})^T$." 13194139547743 17592186502323 true] [17592186762799 1082 #edb/ref 17592186045498 13194139547743 17592186502323 true] [17592186762799 1083 #uuid "30b76a0f-963b-541b-aedc-7f065649cf79" 13194139547743 17592186502323 true] [17592186762800 1080 "3" 13194139547743 17592186502323 true] [17592186762800 1082 #edb/ref 17592186045498 13194139547743 17592186502323 true] [17592186762800 1083 #uuid "316892b5-cef5-56c7-bd3c-4f515b4f6036" 13194139547743 17592186502323 true] [17592186762801 1058 #edb/ref 17592186762903 13194139547743 17592186502323 true] [17592186762801 1062 #uuid "31be8362-331f-5ec0-aa4f-d797d61c992a" 13194139547743 17592186502323 true] [17592186762801 1063 #edb/ref 17592186762919 13194139547743 17592186502323 true] [17592186762802 1146 #edb/ref 17592186762906 13194139547743 17592186502323 true] [17592186762802 1156 #edb/ref 17592186762822 13194139547743 17592186502323 true] [17592186762802 1158 #edb/ref 17592186762853 13194139547743 17592186502323 true] [17592186762802 1161 #uuid "32f62199-e153-8574-9883-1c46b1a86283" 13194139547743 17592186502323 true] [17592186762802 1162 #edb/ref 17592186045571 13194139547743 17592186502323 true] [17592186762802 1171 #inst "2026-10-31T06:11:00.000Z" 13194139547743 17592186502323 true] [17592186762803 1146 #edb/ref 17592186762866 13194139547743 17592186502323 true] [17592186762803 1158 #edb/ref 17592186762955 13194139547743 17592186502323 true] [17592186762803 1161 #uuid "35b72b2e-78ba-8e3e-bae4-a9d478303c8c" 13194139547743 17592186502323 true] [17592186762803 1162 #edb/ref 17592186045570 13194139547743 17592186502323 true] [17592186762803 1171 #inst "2026-10-17T05:45:00.000Z" 13194139547743 17592186502323 true] [17592186762804 1080 "Yes" 13194139547743 17592186502323 true] [17592186762804 1081 "Correct. Yes. The matrix with these columns is $\\begin{bmatrix}1&2&-1\\\\-1&0&-2\\\\1&-2&0\\end{bmatrix}$, whose determinant is $-10\\ne0$. Hence its columns are independent." 13194139547743 17592186502323 true] [17592186762804 1082 #edb/ref 17592186045499 13194139547743 17592186502323 true] [17592186762804 1083 #uuid "36161e9d-4058-5f5a-9ae0-d6b1b133f504" 13194139547743 17592186502323 true] [17592186762805 1075 #edb/ref 17592186762781 13194139547743 17592186502323 true] [17592186762805 1075 #edb/ref 17592186762821 13194139547743 17592186502323 true] [17592186762805 1075 #edb/ref 17592186762936 13194139547743 17592186502323 true] [17592186762805 1076 #edb/ref 17592186045493 13194139547743 17592186502323 true] [17592186762805 1077 "selection" 13194139547743 17592186502323 true] [17592186762805 1078 #edb/ref 17592186762821 13194139547743 17592186502323 true] [17592186762805 1079 #uuid "3699af24-edd4-5cbc-94a7-4f72993e1fbf" 13194139547743 17592186502323 true] [17592186762806 1058 #edb/ref 17592186762819 13194139547743 17592186502323 true] [17592186762806 1062 #uuid "3713e0d1-ae2c-5c8f-b436-fed585a41ddf" 13194139547743 17592186502323 true] [17592186762806 1063 #edb/ref 17592186762785 13194139547743 17592186502323 true] [17592186762807 1068 #edb/ref 17592186762837 13194139547743 17592186502323 true] [17592186762807 1071 "Source question: Canvas Question 4, ID 59547884; submitted attempt 1.\n\nA system with 4 equations and 3 variables could have no solutions." 13194139547743 17592186502323 true] [17592186762807 1072 #uuid "39d71268-ac9c-55c5-a01e-01deb65b5c8c" 13194139547743 17592186502323 true] [17592186762807 1074 "True. The equations $x=0$, $x=1$, $y=0$, $z=0$ form an inconsistent example. More equations than variables do not guarantee consistency.\n\nHistorical Canvas result: 2/2 points, submitted 2026-10-16 at 22:45 PDT." 13194139547743 17592186502323 true] [17592186762808 1080 "Yes.\n\nWhile it is true that if the reduced row-echelon form of a matrix has a row of zeros then that means that at least two of the equations in the system are equivalent, and that a system of two equivalent equations can have infinite solutions, this does not mean that all of the equations are equivalent. Therefore an additional non-equivalent and consistent equation could intersect the two equivalent lines at a single point. This means that the system as a whole, as long as not all of the equations are consistent and dependent, and there remains at least one consistent independent solution, then it is possible for it to have a unique solution. " 13194139547743 17592186502323 true] [17592186762808 1082 #edb/ref 17592186045499 13194139547743 17592186502323 true] [17592186762808 1083 #uuid "3b34a3c4-9648-557b-9c33-b499cc3ee9a6" 13194139547743 17592186502323 true] [17592186762809 1088 #edb/ref 17592186048343 13194139547743 17592186502323 true] [17592186762809 1088 #