{:db/id "752fdec1-8eb3-5cd8-9cf6-f1b8e91d4c9b"
  :answer/id #uuid "752fdec1-8eb3-5cd8-9cf6-f1b8e91d4c9b"
  :answer/type :answer.type/text
  :answer/value "No. A zero row leaves at most $n-1$ pivot rows. If the system is consistent, at least one of its $n$ variables is free, so it has infinitely many solutions. If it is inconsistent, it has no solutions. Neither case gives a unique solution."
  :db/ensure :answer/validate}
