{:db/id "0a2ad936-3831-54c8-8661-73a863e2a922"
  :answer/id #uuid "0a2ad936-3831-54c8-8661-73a863e2a922"
  :answer/type :answer.type/text
  :answer/value "$$\\begin{aligned}4x-2y+z+5w&=5,\\\\6x-2y-3z+4w&=1,\\\\3x+2y-z+3w&=2.\\end{aligned}$$"
