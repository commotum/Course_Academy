{:db/id "30b76a0f-963b-541b-aedc-7f065649cf79"
  :answer/id #uuid "30b76a0f-963b-541b-aedc-7f065649cf79"
  :answer/type :answer.type/math
  :answer/value "\\left(BAC^T\\right)^{-1}=B^{-1}A^{-1}\\left(C^{-1}\\right)^T"
  :answer/feedback "Incorrect. Reverse the factor order: $(BAC^T)^{-1}=(C^T)^{-1}A^{-1}B^{-1}$. The inverse of a transpose is the transpose of the inverse, so $(C^T)^{-1}=(C^{-1})^T$."
  :db/ensure :answer/validate}
