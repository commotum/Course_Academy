{:db/id "fffb8a62-cf25-5189-8091-b8da634f0bb9"
  :answer/id #uuid "fffb8a62-cf25-5189-8091-b8da634f0bb9"
  :answer/type :answer.type/math
  :answer/value "M=\\begin{bmatrix}1&0&0\\\\3&1&0\\\\0&0&1\\end{bmatrix}\\begin{bmatrix}0&0&1\\\\0&1&0\\\\1&0&0\\end{bmatrix}"
  :answer/feedback "Incorrect. The first operation is left multiplication by $E_1=\\begin{bmatrix}1&0&0\\\\3&1&0\\\\0&0&1\\end{bmatrix}$, and the second by $E_2=\\begin{bmatrix}0&0&1\\\\0&1&0\\\\1&0&0\\end{bmatrix}$. Thus the result is $E_2E_1A$, so $M=E_2E_1$. The factor for the last operation is on the left."
  :db/ensure :answer/validate}
