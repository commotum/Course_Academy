{:db/id "e9f72fef-d701-56db-baae-f98bd47f7c42"
  :answer/id #uuid "e9f72fef-d701-56db-baae-f98bd47f7c42"
  :answer/type :answer.type/text
  :answer/value "Apply $R_2\\leftarrow R_2-2R_1$ and $R_3\\leftarrow R_3-R_1$. The result is $$\\left[\\begin{array}{rrrr|r}1&2&1&5&2\\\\0&1&-2&-6&-4\\\\0&0&0&-2&-1\\end{array}\\right],$$ which is row echelon form. Scaling $R_3\\leftarrow-\\frac12R_3$ makes all leading entries one. Continuing to RREF gives $$\\left[\\begin{array}{rrrr|r}1&0&5&0&3/2\\\\0&1&-2&0&-1\\\\0&0&0&1&1/2\\end{array}\\right].$$"
  :db/ensure :answer/validate}
