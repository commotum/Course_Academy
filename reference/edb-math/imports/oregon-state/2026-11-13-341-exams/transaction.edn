{:db/id "de2affc4-2ee4-5708-9c9b-3e9280291330"
  :answer/id #uuid "de2affc4-2ee4-5708-9c9b-3e9280291330"
  :answer/type :answer.type/text
  :answer/value "For row echelon form:\n\nR2 := R2 - 2(R1)\nR3 := R3 - R1\n\nFor reduced row echelon form:\n\nR2 := R2 - 2(R1) = [ 0 1 -2 -6 | -4 ]\nR3 := R3 - R1 = [ 0 0 0 -2 | -1 ]\nR3 := -1/2(R3) = [ 0 0 0 1 | 1/2 ]\nR1 := R1 -2(R2) = [ 1 0 5 17 | 10 ]\nR2 := R2 + 6(R3) = [ 0 1 -2 0 | -1 ]\nR1 := R1 - 17(R3) = [ 1 0 5 0 | 3/2 ]\n\n[ 1 0 5 0 | 3/2 ]\n[ 0 1 -2 0 | -1 ]\n[0 0 0 1 | 1/2 ]"
  :db/ensure :answer/validate}
