 {:db/id "c1a44f03-fe98-5b6d-8d0e-7739dfffcf82"
  :question/id #uuid "c1a44f03-fe98-5b6d-8d0e-7739dfffcf82"
  :question/problem "Source question: Canvas Question 1 (question_59459051).\n\nWhat is a defining characteristic of a eigenvalue/eigenvector pair?"
  :question/answer-fields ["fba20990-bcb2-58c5-9803-6761594d97ec"]
  :question/worked-solution "An eigenvalue/eigenvector pair satisfies $A\\vec v=\\lambda\\vec v$ with $\\vec v\\ne\\vec0$. The matrix sends the eigenvector to a scalar multiple of itself. The eigenvalue may be zero; the eigenvector may not."
  :db/ensure :question/validate}
 {:db/id "b8b87ca4-23d0-5992-a601-0d41cef37256"
  :assigned-problem/id #uuid "b8b87ca4-23d0-5992-a601-0d41cef37256"
