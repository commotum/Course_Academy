 {:db/id "e29c04ba-aa12-5636-be57-0f48f1ac8744"
  :answer/id #uuid "e29c04ba-aa12-5636-be57-0f48f1ac8744"
  :answer/type :answer.type/math
  :answer/value "A\\vec{v}=\\lambda\\vec{v}"
  :answer/feedback "This is the defining relation, with the additional requirement that $\\vec v\\ne\\vec0$."
  :db/ensure :answer/validate}
 {:db/id "5138d498-3087-5b18-a98e-8a603c384897"
  :answer/id #uuid "5138d498-3087-5b18-a98e-8a603c384897"
  :answer/type :answer.type/math
  :answer/value "A\\vec{v}=\\vec{0}"
  :answer/feedback "This is the special case $\\lambda=0$ for a nonzero eigenvector; it does not characterize every eigenvalue/eigenvector pair."
  :db/ensure :answer/validate}
 {:db/id "58905c43-0aa0-5201-8fb3-a73c84611006"
  :answer/id #uuid "58905c43-0aa0-5201-8fb3-a73c84611006"
  :answer/type :answer.type/math
  :answer/value "A\\vec{v}\\ne\\vec{0}"
  :answer/feedback "This excludes the valid eigenvalue $\\lambda=0$. It also does not require $A\\vec v$ to be a scalar multiple of $\\vec v$."
  :db/ensure :answer/validate}
 {:db/id "ea1f6d2c-4370-556f-a1ed-b18cdbb2acd0"
  :answer/id #uuid "ea1f6d2c-4370-556f-a1ed-b18cdbb2acd0"
  :answer/type :answer.type/text
  :answer/value "$\\vec{v}$ is the zero vector"
  :answer/feedback "Eigenvectors are required to be nonzero. The zero vector satisfies the equation for every scalar and therefore cannot identify an eigenvalue."
  :db/ensure :answer/validate}
