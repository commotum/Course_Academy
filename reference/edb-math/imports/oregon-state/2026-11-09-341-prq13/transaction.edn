 {:db/id "075f01e1-1b01-5904-8164-06c411d37b78"
  :answer/id #uuid "075f01e1-1b01-5904-8164-06c411d37b78"
  :answer/type :answer.type/text
  :answer/value "Homogeneous Equation"
  :answer/feedback "The associated vector equation $(A-\\lambda I)\\vec v=\\vec0$ is homogeneous. The determinant equation is specifically the characteristic equation."
  :db/ensure :answer/validate}
 {:db/id "61622f21-8f34-550d-b2f8-9d26eba84e43"
  :answer/id #uuid "61622f21-8f34-550d-b2f8-9d26eba84e43"
  :answer/type :answer.type/text
  :answer/value "Charlie"
  :answer/feedback "This is not a mathematical name for the determinant equation."
  :db/ensure :answer/validate}
 {:db/id "31c1827b-3668-50d8-9044-6c57a3362f89"
  :answer/id #uuid "31c1827b-3668-50d8-9044-6c57a3362f89"
  :answer/type :answer.type/text
  :answer/value "Characteristic Polynomial"
  :answer/feedback "This is the closest supplied choice and the source’s intended label. Precisely, $p_A(\\lambda)=\\det(A-\\lambda I)$ is the characteristic polynomial, while $p_A(\\lambda)=0$ is the characteristic equation."
  :db/ensure :answer/validate}
 {:db/id "12590479-aa2f-58c7-bcc0-e6217527111f"
  :answer/id #uuid "12590479-aa2f-58c7-bcc0-e6217527111f"
  :answer/type :answer.type/text
  :answer/value "Fundamental Polynomial"
  :answer/feedback "This is not the standard name for this object; the relevant terms are characteristic polynomial and characteristic equation."
  :db/ensure :answer/validate}
