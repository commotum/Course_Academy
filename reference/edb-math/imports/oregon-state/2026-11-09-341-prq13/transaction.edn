 {:db/id "e463c948-a56b-5dd3-b3fa-46a3203c99db"
  :answer/id #uuid "e463c948-a56b-5dd3-b3fa-46a3203c99db"
  :answer/type :answer.type/text
  :answer/value "Not enough info given."
  :answer/feedback "The equality supplies the needed dimensional information: $A\\vec v$ and $\\lambda\\vec v$ must have the same number of components."
  :db/ensure :answer/validate}
 {:db/id "93bfb916-fe8e-5d2a-aba2-f52d9a3e8f69"
  :answer/id #uuid "93bfb916-fe8e-5d2a-aba2-f52d9a3e8f69"
  :answer/type :answer.type/text
  :answer/value "Yes"
  :answer/feedback "If $A$ is $m\\times n$, then $\\vec v$ has $n$ components and $A\\vec v$ has $m$; equality with $\\lambda\\vec v$ requires $m=n$."
  :db/ensure :answer/validate}
