#{[:activity/id #uuid "f3780e1d-c0aa-59cb-a02c-da65f5b297d0" {:activity/course {:db/id #edb/ref 17592186405206} :activity/due #inst "2026-11-11T07:59:00.000Z" :activity/first-step {:db/id #edb/ref 17592186755608} :activity/id #uuid "f3780e1d-c0aa-59cb-a02c-da65f5b297d0" :activity/steps [{:db/id #edb/ref 17592186755594 :step/content {:db/id #edb/ref 17592186755609} :step/id #uuid "118d6169-c405-5a02-aaf3-bea74bf6f41e" :step/next {:db/id #edb/ref 17592186755603}} {:db/id #edb/ref 17592186755602 :step/content {:db/id #edb/ref 17592186755605} :step/id #uuid "81be1c7b-d988-548f-bba6-9200c523fbf6"} {:db/id #edb/ref 17592186755603 :step/content {:db/id #edb/ref 17592186755617} :step/id #uuid "8b7dae86-fc66-591c-916c-9af6c2bab627" :step/next {:db/id #edb/ref 17592186755602}} {:db/id #edb/ref 17592186755608 :step/content {:db/id #edb/ref 17592186755611} :step/id #uuid "a96a995a-b355-50be-b552-ee91363b75fe" :step/next {:db/id #edb/ref 17592186755594}}] :activity/title "MTH 341 — PRQ-13" :activity/type {:db/id #edb/ref 17592186045461} :db/id #edb/ref 17592186755615}] [:step/id #uuid "81be1c7b-d988-548f-bba6-9200c523fbf6" {:db/id #edb/ref 17592186755602 :step/content {:db/id #edb/ref 17592186755605} :step/id #uuid "81be1c7b-d988-548f-bba6-9200c523fbf6"}] [:step/id #uuid "8b7dae86-fc66-591c-916c-9af6c2bab627" {:db/id #edb/ref 17592186755603 :step/content {:db/id #edb/ref 17592186755617} :step/id #uuid "8b7dae86-fc66-591c-916c-9af6c2bab627" :step/next {:db/id #edb/ref 17592186755602}}] [:step/id #uuid "a96a995a-b355-50be-b552-ee91363b75fe" {:db/id #edb/ref 17592186755608 :step/content {:db/id #edb/ref 17592186755611} :step/id #uuid "a96a995a-b355-50be-b552-ee91363b75fe" :step/next {:db/id #edb/ref 17592186755594}}] [:step/id #uuid "118d6169-c405-5a02-aaf3-bea74bf6f41e" {:db/id #edb/ref 17592186755594 :step/content {:db/id #edb/ref 17592186755609} :step/id #uuid "118d6169-c405-5a02-aaf3-bea74bf6f41e" :step/next {:db/id #edb/ref 17592186755603}}] [:tutorial/id #uuid "dca5636f-7403-52da-9460-902b797889c8" {:db/id #edb/ref 17592186755611 :tutorial/content "**MTH 341 — Post-reading Questions: §§7.1.1–7.1.3**\n\nDue: 2026-11-10\nDue time: 11:59 p.m. PST\nDate imported: 2026-11-09\nSource: [Canvas — Post-reading Questions -Sections 7.1.1-7.1.3](https://canvas.oregonstate.edu/courses/2064363/quizzes/3193301)\n\nStudy answers and explanations are independently authored additions. Original choice text and ordering are retained. Question 3 has a source terminology issue; its feedback distinguishes the characteristic polynomial from the characteristic equation.\n\n## Instructions\n\nAnswer all three multiple-choice questions. Canvas specifies no time limit." :tutorial/id #uuid "dca5636f-7403-52da-9460-902b797889c8" :tutorial/title "Assignment information"}] [:question/id #uuid "9c900468-5124-57f0-aaf9-5d5f900fd66a" {:db/id #edb/ref 17592186755606 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The associated vector equation $(A-\\lambda I)\\vec v=\\vec0$ is homogeneous. The determinant equation is specifically the characteristic equation." :answer/id #uuid "075f01e1-1b01-5904-8164-06c411d37b78" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Homogeneous Equation" :db/id #edb/ref 17592186755593} {:answer/feedback "This is not the standard name for this object; the relevant terms are characteristic polynomial and characteristic equation." :answer/id #uuid "12590479-aa2f-58c7-bcc0-e6217527111f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Fundamental Polynomial" :db/id #edb/ref 17592186755595} {:answer/feedback "This is the closest supplied choice and the source’s intended label. Precisely, $p_A(\\lambda)=\\det(A-\\lambda I)$ is the characteristic polynomial, while $p_A(\\lambda)=0$ is the characteristic equation." :answer/id #uuid "31c1827b-3668-50d8-9044-6c57a3362f89" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Characteristic Polynomial" :db/id #edb/ref 17592186755597} {:answer/feedback "This is not a mathematical name for the determinant equation." :answer/id #uuid "61622f21-8f34-550d-b2f8-9d26eba84e43" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Charlie" :db/id #edb/ref 17592186755600}] :answer-field/correct {:db/id #edb/ref 17592186755597} :answer-field/id #uuid "a0a9259c-9e73-51a8-9d5e-02e2b270aa77" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186755607}] :question/id #uuid "9c900468-5124-57f0-aaf9-5d5f900fd66a" :question/problem "Source question: Canvas Question 3 (question_59459053).\n\nWhat name do we give to $\\det(A-\\lambda I)=0$?" :question/worked-solution "**Source terminology issue:** Among the original options, “Characteristic Polynomial” is the intended choice, but the displayed equality is more precisely the **characteristic equation**. The expression $p_A(\\lambda)=\\det(A-\\lambda I)$ is a polynomial in $\\lambda$; setting it equal to zero gives the equation whose roots are the eigenvalues.\n\nIndeed, $A\\vec v=\\lambda\\vec v$ is equivalent to $(A-\\lambda I)\\vec v=\\vec0$. A nonzero solution exists exactly when $A-\\lambda I$ is singular, which is equivalent to $\\det(A-\\lambda I)=0$."}] [:question/id #uuid "c1a44f03-fe98-5b6d-8d0e-7739dfffcf82" {:db/id #edb/ref 17592186755610 :question/answer-fields [{:answer-field/choices [{:answer/feedback "This is the special case $\\lambda=0$ for a nonzero eigenvector; it does not characterize every eigenvalue/eigenvector pair." :answer/id #uuid "5138d498-3087-5b18-a98e-8a603c384897" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\vec{v}=\\vec{0}" :db/id #edb/ref 17592186755598} {:answer/feedback "This excludes the valid eigenvalue $\\lambda=0$. It also does not require $A\\vec v$ to be a scalar multiple of $\\vec v$." :answer/id #uuid "58905c43-0aa0-5201-8fb3-a73c84611006" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\vec{v}\\ne\\vec{0}" :db/id #edb/ref 17592186755599} {:answer/feedback "This is the defining relation, with the additional requirement that $\\vec v\\ne\\vec0$." :answer/id #uuid "e29c04ba-aa12-5636-be57-0f48f1ac8744" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A\\vec{v}=\\lambda\\vec{v}" :db/id #edb/ref 17592186755612} {:answer/feedback "Eigenvectors are required to be nonzero. The zero vector satisfies the equation for every scalar and therefore cannot identify an eigenvalue." :answer/id #uuid "ea1f6d2c-4370-556f-a1ed-b18cdbb2acd0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$\\vec{v}$ is the zero vector" :db/id #edb/ref 17592186755614}] :answer-field/correct {:db/id #edb/ref 17592186755612} :answer-field/id #uuid "fba20990-bcb2-58c5-9803-6761594d97ec" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186755616}] :question/id #uuid "c1a44f03-fe98-5b6d-8d0e-7739dfffcf82" :question/problem "Source question: Canvas Question 1 (question_59459051).\n\nWhat is a defining characteristic of a eigenvalue/eigenvector pair?" :question/worked-solution "An eigenvalue/eigenvector pair satisfies $A\\vec v=\\lambda\\vec v$ with $\\vec v\\ne\\vec0$. The matrix sends the eigenvector to a scalar multiple of itself. The eigenvalue may be zero; the eigenvector may not."}] [:question/id #uuid "154371fc-3efa-5eaa-be4c-8ba9a66c2b2a" {:db/id #edb/ref 17592186755596 :question/answer-fields [{:answer-field/choices [{:answer/feedback "If $A$ is $m\\times n$, then $\\vec v$ has $n$ components and $A\\vec v$ has $m$; equality with $\\lambda\\vec v$ requires $m=n$." :answer/id #uuid "93bfb916-fe8e-5d2a-aba2-f52d9a3e8f69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes" :db/id #edb/ref 17592186755604} {:answer/feedback "The equality supplies the needed dimensional information: $A\\vec v$ and $\\lambda\\vec v$ must have the same number of components." :answer/id #uuid "e463c948-a56b-5dd3-b3fa-46a3203c99db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not enough info given." :db/id #edb/ref 17592186755613}] :answer-field/correct {:db/id #edb/ref 17592186755604} :answer-field/id #uuid "80f1a944-1bd9-52d8-93bd-aad280324d42" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186755601}] :question/id #uuid "154371fc-3efa-5eaa-be4c-8ba9a66c2b2a" :question/problem "Source question: Canvas Question 2 (question_59459052).\n\nIf we know that $A\\vec{v}=\\lambda\\vec{v}$ does $A$ need to be a square matrix?" :question/worked-solution "Write $A$ as an $m\\times n$ matrix. For $A\\vec v$ to be defined, $\\vec v$ is $n\\times1$, so $A\\vec v$ is $m\\times1$. Scalar multiplication leaves the dimensions of $\\vec v$ unchanged, so $\\lambda\\vec v$ is $n\\times1$. Equality of the two vectors requires $m=n$. Thus $A$ is square."}] [:answer-field/id #uuid "80f1a944-1bd9-52d8-93bd-aad280324d42" {:answer-field/choices [{:answer/feedback "If $A$ is $m\\times n$, then $\\vec v$ has $n$ components and $A\\vec v$ has $m$; equality with $\\lambda\\vec v$ requires $m=n$." :answer/id #uuid "93bfb916-fe8e-5d2a-aba2-f52d9a3e8f69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes" :db/id #edb/ref 17592186755604} {:answer/feedback "The equality supplies the needed dimensional information: $A\\vec v$ and $\\lambda\\vec v$ must have the same number of components." :answer/id #uuid "e463c948-a56b-5dd3-b3fa-46a3203c99db" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Not enough info given." :db/id #edb/ref 17592186755613}] :answer-field/correct {:db/id #edb/ref 17592186755604} :answer-field/id #uuid "80f1a944-1bd9-52d8-93bd-aad280324d42" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186755601}] [:answer-field/id #uuid "a0a9259c-9e73-51a8-9d5e-02e2b270aa77" {:answer-field/choices [{:answer/feedback "The associated vector equation $(A-\\lambda I)\\vec v=\\vec0$ is homogeneous. The determinant equation is specifically