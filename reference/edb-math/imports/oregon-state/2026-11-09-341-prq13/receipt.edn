{:edb/committed true :edb/basis-t 13611 :edb/replayed false :edb/tx-hash "bb59d27f060c9a2e80d3a4ce1d9fefc548edee4c4662982f0fba77a9c6a6553f" :edb/db-before-t 13610 :edb/db-after-t 13611 :edb/tx-data [[13194139546923 50 #inst "2026-11-10T05:32:40.140Z" 13194139546923 17592186502323 true] [17592186045416 1117 #edb/ref 17592186755615 13194139546923 17592186502323 true] [17592186045416 1118 #edb/ref 17592186048819 13194139546923 17592186502323 true] [17592186045416 1118 #edb/ref 17592186050376 13194139546923 17592186502323 true] [17592186755593 1080 "Homogeneous Equation" 13194139546923 17592186502323 true] [17592186755593 1081 "The associated vector equation $(A-\\lambda I)\\vec v=\\vec0$ is homogeneous. The determinant equation is specifically the characteristic equation." 13194139546923 17592186502323 true] [17592186755593 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755593 1083 #uuid "075f01e1-1b01-5904-8164-06c411d37b78" 13194139546923 17592186502323 true] [17592186755594 1058 #edb/ref 17592186755603 13194139546923 17592186502323 true] [17592186755594 1062 #uuid "118d6169-c405-5a02-aaf3-bea74bf6f41e" 13194139546923 17592186502323 true] [17592186755594 1063 #edb/ref 17592186755609 13194139546923 17592186502323 true] [17592186755595 1080 "Fundamental Polynomial" 13194139546923 17592186502323 true] [17592186755595 1081 "This is not the standard name for this object; the relevant terms are characteristic polynomial and characteristic equation." 13194139546923 17592186502323 true] [17592186755595 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755595 1083 #uuid "12590479-aa2f-58c7-bcc0-e6217527111f" 13194139546923 17592186502323 true] [17592186755596 1068 #edb/ref 17592186755601 13194139546923 17592186502323 true] [17592186755596 1071 "Source question: Canvas Question 2 (question_59459052).\n\nIf we know that $A\\vec{v}=\\lambda\\vec{v}$ does $A$ need to be a square matrix?" 13194139546923 17592186502323 true] [17592186755596 1072 #uuid "154371fc-3efa-5eaa-be4c-8ba9a66c2b2a" 13194139546923 17592186502323 true] [17592186755596 1074 "Write $A$ as an $m\\times n$ matrix. For $A\\vec v$ to be defined, $\\vec v$ is $n\\times1$, so $A\\vec v$ is $m\\times1$. Scalar multiplication leaves the dimensions of $\\vec v$ unchanged, so $\\lambda\\vec v$ is $n\\times1$. Equality of the two vectors requires $m=n$. Thus $A$ is square." 13194139546923 17592186502323 true] [17592186755597 1080 "Characteristic Polynomial" 13194139546923 17592186502323 true] [17592186755597 1081 "This is the closest supplied choice and the source’s intended label. Precisely, $p_A(\\lambda)=\\det(A-\\lambda I)$ is the characteristic polynomial, while $p_A(\\lambda)=0$ is the characteristic equation." 13194139546923 17592186502323 true] [17592186755597 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755597 1083 #uuid "31c1827b-3668-50d8-9044-6c57a3362f89" 13194139546923 17592186502323 true] [17592186755598 1080 "A\\vec{v}=\\vec{0}" 13194139546923 17592186502323 true] [17592186755598 1081 "This is the special case $\\lambda=0$ for a nonzero eigenvector; it does not characterize every eigenvalue/eigenvector pair." 13194139546923 17592186502323 true] [17592186755598 1082 #edb/ref 17592186045498 13194139546923 17592186502323 true] [17592186755598 1083 #uuid "5138d498-3087-5b18-a98e-8a603c384897" 13194139546923 17592186502323 true] [17592186755599 1080 "A\\vec{v}\\ne\\vec{0}" 13194139546923 17592186502323 true] [17592186755599 1081 "This excludes the valid eigenvalue $\\lambda=0$. It also does not require $A\\vec v$ to be a scalar multiple of $\\vec v$." 13194139546923 17592186502323 true] [17592186755599 1082 #edb/ref 17592186045498 13194139546923 17592186502323 true] [17592186755599 1083 #uuid "58905c43-0aa0-5201-8fb3-a73c84611006" 13194139546923 17592186502323 true] [17592186755600 1080 "Charlie" 13194139546923 17592186502323 true] [17592186755600 1081 "This is not a mathematical name for the determinant equation." 13194139546923 17592186502323 true] [17592186755600 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755600 1083 #uuid "61622f21-8f34-550d-b2f8-9d26eba84e43" 13194139546923 17592186502323 true] [17592186755601 1075 #edb/ref 17592186755604 13194139546923 17592186502323 true] [17592186755601 1075 #edb/ref 17592186755613 13194139546923 17592186502323 true] [17592186755601 1076 #edb/ref 17592186045493 13194139546923 17592186502323 true] [17592186755601 1077 "answer" 13194139546923 17592186502323 true] [17592186755601 1078 #edb/ref 17592186755604 13194139546923 17592186502323 true] [17592186755601 1079 #uuid "80f1a944-1bd9-52d8-93bd-aad280324d42" 13194139546923 17592186502323 true] [17592186755602 1062 #uuid "81be1c7b-d988-548f-bba6-9200c523fbf6" 13194139546923 17592186502323 true] [17592186755602 1063 #edb/ref 17592186755605 13194139546923 17592186502323 true] [17592186755603 1058 #edb/ref 17592186755602 13194139546923 17592186502323 true] [17592186755603 1062 #uuid "8b7dae86-fc66-591c-916c-9af6c2bab627" 13194139546923 17592186502323 true] [17592186755603 1063 #edb/ref 17592186755617 13194139546923 17592186502323 true] [17592186755604 1080 "Yes" 13194139546923 17592186502323 true] [17592186755604 1081 "If $A$ is $m\\times n$, then $\\vec v$ has $n$ components and $A\\vec v$ has $m$; equality with $\\lambda\\vec v$ requires $m=n$." 13194139546923 17592186502323 true] [17592186755604 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755604 1083 #uuid "93bfb916-fe8e-5d2a-aba2-f52d9a3e8f69" 13194139546923 17592186502323 true] [17592186755605 1088 #edb/ref 17592186048252 13194139546923 17592186502323 true] [17592186755605 1088 #edb/ref 17592186050376 13194139546923 17592186502323 true] [17592186755605 1089 #edb/ref 17592186755606 13194139546923 17592186502323 true] [17592186755605 1090 #uuid "9603bd58-7dd7-58d5-85a3-6b030b87d247" 13194139546923 17592186502323 true] [17592186755606 1068 #edb/ref 17592186755607 13194139546923 17592186502323 true] [17592186755606 1071 "Source question: Canvas Question 3 (question_59459053).\n\nWhat name do we give to $\\det(A-\\lambda I)=0$?" 13194139546923 17592186502323 true] [17592186755606 1072 #uuid "9c900468-5124-57f0-aaf9-5d5f900fd66a" 13194139546923 17592186502323 true] [17592186755606 1074 "**Source terminology issue:** Among the original options, “Characteristic Polynomial” is the intended choice, but the displayed equality is more precisely the **characteristic equation**. The expression $p_A(\\lambda)=\\det(A-\\lambda I)$ is a polynomial in $\\lambda$; setting it equal to zero gives the equation whose roots are the eigenvalues.\n\nIndeed, $A\\vec v=\\lambda\\vec v$ is equivalent to $(A-\\lambda I)\\vec v=\\vec0$. A nonzero solution exists exactly when $A-\\lambda I$ is singular, which is equivalent to $\\det(A-\\lambda I)=0$." 13194139546923 17592186502323 true] [17592186755607 1075 #edb/ref 17592186755593 13194139546923 17592186502323 true] [17592186755607 1075 #edb/ref 17592186755595 13194139546923 17592186502323 true] [17592186755607 1075 #edb/ref 17592186755597 13194139546923 17592186502323 true] [17592186755607 1075 #edb/ref 17592186755600 13194139546923 17592186502323 true] [17592186755607 1076 #edb/ref 17592186045493 13194139546923 17592186502323 true] [17592186755607 1077 "answer" 13194139546923 17592186502323 true] [17592186755607 1078 #edb/ref 17592186755597 13194139546923 17592186502323 true] [17592186755607 1079 #uuid "a0a9259c-9e73-51a8-9d5e-02e2b270aa77" 13194139546923 17592186502323 true] [17592186755608 1058 #edb/ref 17592186755594 13194139546923 17592186502323 true] [17592186755608 1062 #uuid "a96a995a-b355-50be-b552-ee91363b75fe" 13194139546923 17592186502323 true] [17592186755608 1063 #edb/ref 17592186755611 13194139546923 17592186502323 true] [17592186755609 1088 #edb/ref 17592186048819 13194139546923 17592186502323 true] [17592186755609 1088 #edb/ref 17592186050825 13194139546923 17592186502323 true] [17592186755609 1089 #edb/ref 17592186755610 13194139546923 17592186502323 true] [17592186755609 1090 #uuid "b8b87ca4-23d0-5992-a601-0d41cef37256" 13194139546923 17592186502323 true] [17592186755610 1068 #edb/ref 17592186755616 13194139546923 17592186502323 true] [17592186755610 1071 "Source question: Canvas Question 1 (question_59459051).\n\nWhat is a defining characteristic of a eigenvalue/eigenvector pair?" 13194139546923 17592186502323 true] [17592186755610 1072 #uuid "c1a44f03-fe98-5b6d-8d0e-7739dfffcf82" 13194139546923 17592186502323 true] [17592186755610 1074 "An eigenvalue/eigenvector pair satisfies $A\\vec v=\\lambda\\vec v$ with $\\vec v\\ne\\vec0$. The matrix sends the eigenvector to a scalar multiple of itself. The eigenvalue may be zero; the eigenvector may not." 13194139546923 17592186502323 true] [17592186755611 1064 "**MTH 341 — Post-reading Questions: §§7.1.1–7.1.3**\n\nDue: 2026-11-10\nDue time: 11:59 p.m. PST\nDate imported: 2026-11-09\nSource: [Canvas — Post-reading Questions -Sections 7.1.1-7.1.3](https://canvas.oregonstate.edu/courses/2064363/quizzes/3193301)\n\nStudy answers and explanations are independently authored additions. Original choice text and ordering are retained. Question 3 has a source terminology issue; its feedback distinguishes the characteristic polynomial from the characteristic equation.\n\n## Instructions\n\nAnswer all three multiple-choice questions. Canvas specifies no time limit." 13194139546923 17592186502323 true] [17592186755611 1066 #uuid "dca5636f-7403-52da-9460-902b797889c8" 13194139546923 17592186502323 true] [17592186755611 1067 "Assignment information" 13194139546923 17592186502323 true] [17592186755612 1080 "A\\vec{v}=\\lambda\\vec{v}" 13194139546923 17592186502323 true] [17592186755612 1081 "This is the defining relation, with the additional requirement that $\\vec v\\ne\\vec0$." 13194139546923 17592186502323 true] [17592186755612 1082 #edb/ref 17592186045498 13194139546923 17592186502323 true] [17592186755612 1083 #uuid "e29c04ba-aa12-5636-be57-0f48f1ac8744" 13194139546923 17592186502323 true] [17592186755613 1080 "Not enough info given." 13194139546923 17592186502323 true] [17592186755613 1081 "The equality supplies the needed dimensional information: $A\\vec v$ and $\\lambda\\vec v$ must have the same number of components." 13194139546923 17592186502323 true] [17592186755613 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755613 1083 #uuid "e463c948-a56b-5dd3-b3fa-46a3203c99db" 13194139546923 17592186502323 true] [17592186755614 1080 "$\\vec{v}$ is the zero vector" 13194139546923 17592186502323 true] [17592186755614 1081 "Eigenvectors are required to be nonzero. The zero vector satisfies the equation for every scalar and therefore cannot identify an eigenvalue." 13194139546923 17592186502323 true] [17592186755614 1082 #edb/ref 17592186045499 13194139546923 17592186502323 true] [17592186755614 1083 #uuid "ea1f6d2c-4370-556f-a1ed-b18cdbb2acd0" 13194139546923 17592186502323 true] [17592186755615 1043 #edb/ref 17592186755594 13194139546923 17592186502323 true] [17592186755615 1043 #edb/ref 17592186755602 13194139546923 17592186502323 true] [17592186755615 1043 #edb/ref 17592186755603 13194139546923 17592186502323 true] [17592186755615 1043 #edb/ref 17592186755608 13194139546923 17592186502323 true] [17592186755615 1044 #edb/ref 17592186045461 13194139546923 17592186502323 true] [17592186755615 1045 "MTH 341 — PRQ-13" 13194139546923 17592186502323 true] [17592186755615 1046 #edb/ref 17592186755608 13194139546923 17592186502323 true] [17592186755615 1047 #inst "2026-11-11T07:59:00.000Z" 13194139546923 17592186502323 true] [17592186755615 1048 #edb/ref 17592186405206 13194139546923 17592186502323 true] [17592186755615 1053 #uuid "f3780e1d-c0aa-59cb-a02c-da65f5b297d0" 13194139546923 17592186502323 true] [17592186755616 1075 #edb/ref 17592186755598 13194139546923 17592186502323 true] [17592186755616 1075 #edb/ref 17592186755599 13194139546923 17592186