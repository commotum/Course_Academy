 {:db/id "4fbfa299-1597-55c0-894e-66d5e503e601"
  :answer/id #uuid "4fbfa299-1597-55c0-894e-66d5e503e601"
  :answer/type :answer.type/text
  :answer/value "The rank-nullity theorem uses the number of columns, so $\\operatorname{rank}(A)+\\operatorname{nullity}(A)=9$. Thus $\\operatorname{rank}(A)=9-2=7$. Row rank equals column rank, so $\\dim\\operatorname{Row}(A)=7$. This applies to every matrix satisfying the hypotheses."
  :db/ensure :answer/validate}
