 {:db/id "fb295c04-2396-58df-883a-ee23cb1b576c"
  :question/id #uuid "fb295c04-2396-58df-883a-ee23cb1b576c"
  :question/problem "Source question: Assignment item (7); Kuttler 2017A, Exercise 5.4.6, printed p. 291 (PDF p. 303).\n\nFind the matrix for the linear transformation which rotates every vector in $\\mathbb R^2$ through an angle of $2\\pi/3$ and then reflects across the $x$ axis. Show supporting work.\n\nMatrix: {{matrix}}."
  :question/answer-fields ["3987f90d-443a-5c35-9112-6c4b7640d536" "ea959c9c-4157-5fba-b39e-a34e71128391"]
  :question/worked-solution "Write one matrix for each action and multiply in application order, with the first action on the right. Left multiplication by the $x$-axis reflection negates the second row of the rotation matrix."
  :db/ensure :question/validate}
