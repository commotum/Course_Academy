  :answer/id #uuid "475bf8ff-adb9-561b-bc86-1bfe6bd49962"
  :answer/type :answer.type/text
  :answer/value "True"
  :answer/feedback "A basis is an independent set of size $\\dim V$, and no independent subset of $V$ can be larger."
  :db/ensure :answer/validate}
 {:db/id "1a10ed3f-2d33-5b21-bddc-a3a7182e1613"
  :answer/id #uuid "1a10ed3f-2d33-5b21-bddc-a3a7182e1613"
  :answer/type :answer.type/text
  :answer/value "False"
  :answer/feedback "Although dimension is defined as the size of a basis, that size also equals the maximum size of an independent subset of the space."
  :db/ensure :answer/validate}
