 {:db/id "f38a38c3-223d-5252-bd53-e3e80cb2d3b9"
  :answer/id #uuid "f38a38c3-223d-5252-bd53-e3e80cb2d3b9"
  :answer/type :answer.type/text
  :answer/value "True"
  :answer/feedback "Column $j$ of the identity matrix has a $1$ in coordinate $j$ and zeros elsewhere, so it is the standard basis vector $\\mathbf e_j$."
  :db/ensure :answer/validate}
 {:db/id "ab36552e-849b-5dd0-afb4-a0ebff40d81e"
  :answer/id #uuid "ab36552e-849b-5dd0-afb4-a0ebff40d81e"
  :answer/type :answer.type/text
  :answer/value "False"
  :answer/feedback "The identity matrix has ones on the diagonal and zeros elsewhere. Its columns are exactly the standard basis vectors."
  :db/ensure :answer/validate}
