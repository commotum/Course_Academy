 {:db/id "5a4e9858-fcf5-5711-a11d-bdd01cfcf056"
  :answer/id #uuid "5a4e9858-fcf5-5711-a11d-bdd01cfcf056"
  :answer/type :answer.type/text
  :answer/value "Yes"
  :answer/feedback "Every subspace contains the zero vector; multiplying any vector in it by zero gives the zero vector."
  :db/ensure :answer/validate}
 {:db/id "3a63531a-a289-5683-9664-5c92cdeb7732"
  :answer/id #uuid "3a63531a-a289-5683-9664-5c92cdeb7732"
  :answer/type :answer.type/text
  :answer/value "No"
  :answer/feedback "A subspace is nonempty and closed under scalar multiplication, including multiplication by zero. Thus it cannot omit the zero vector."
  :db/ensure :answer/validate}
