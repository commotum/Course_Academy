 {:db/id "4ee01dc8-3e30-5878-af16-19c23ebbc0b8"
  :answer/id #uuid "4ee01dc8-3e30-5878-af16-19c23ebbc0b8"
  :answer/type :answer.type/text
  :answer/value "True"
  :answer/feedback "A spanning set may be dependent, but a basis must satisfy both spanning and linear independence."
  :db/ensure :answer/validate}
