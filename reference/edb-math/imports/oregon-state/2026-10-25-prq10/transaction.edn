 {:db/id "24b5da8f-89a0-55b1-bae6-dcd9940bb4df"
  :answer/id #uuid "24b5da8f-89a0-55b1-bae6-dcd9940bb4df"
  :answer/type :answer.type/text
  :answer/value "False"
  :answer/feedback "The standard basis of $\\mathbb R^n$ has $n$ vectors, so a fixed count of six is not correct for general $n$."
  :db/ensure :answer/validate}
