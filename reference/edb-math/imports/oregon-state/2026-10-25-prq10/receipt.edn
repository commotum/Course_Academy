{:edb/committed true :edb/basis-t 7341 :edb/replayed false :edb/tx-hash "a235f095078e78e506f8454141360274130b22376d0258ac18bc80edbf3ea042" :edb/db-before-t 7340 :edb/db-after-t 7341 :edb/tx-data [[13194139540653 50 #inst "2026-10-25T17:10:34.873Z" 13194139540653 17592186502323 true] [17592186045416 1117 #edb/ref 17592186699511 13194139540653 17592186502323 true] [17592186045416 1118 #edb/ref 17592186048218 13194139540653 17592186502323 true] [17592186045416 1118 #edb/ref 17592186048552 13194139540653 17592186502323 true] [17592186045416 1118 #edb/ref 17592186049222 13194139540653 17592186502323 true] [17592186045416 1118 #edb/ref 17592186050638 13194139540653 17592186502323 true] [17592186045416 1118 #edb/ref 17592186050656 13194139540653 17592186502323 true] [17592186045416 1118 #edb/ref 17592186051046 13194139540653 17592186502323 true] [17592186699506 1062 #uuid "06fec17a-819b-5117-9591-ac6f7f6bd1f3" 13194139540653 17592186502323 true] [17592186699506 1063 #edb/ref 17592186699516 13194139540653 17592186502323 true] [17592186699507 1088 #edb/ref 17592186048252 13194139540653 17592186502323 true] [17592186699507 1088 #edb/ref 17592186050638 13194139540653 17592186502323 true] [17592186699507 1089 #edb/ref 17592186699543 13194139540653 17592186502323 true] [17592186699507 1090 #uuid "0ff25a38-053d-555c-a5d9-b429317878d9" 13194139540653 17592186502323 true] [17592186699508 1064 "**MTH 341 — Post-reading Questions: §4.10.4**\n\nDue: 2026-10-27\nDue time: 11:59 p.m. PDT\nDate imported: 2026-10-25\nSource: [Canvas — Post-reading Questions -Section 4.10.4](https://canvas.oregonstate.edu/courses/2064363/quizzes/3193293)\n\nStudy answers and explanations are independently authored additions. Math Academy links provide verified component coverage; whole-task equivalents for the six general Yes/No and True/False questions were not verified.\n\n## Instructions\n\nAnswer all six questions using the supplied Yes/No or True/False choices. Canvas specifies no time limit. The closing reading reminder requests no response and is retained after Problem 6." 13194139540653 17592186502323 true] [17592186699508 1066 #uuid "149631f0-056a-5b55-8dfe-3094157bae70" 13194139540653 17592186502323 true] [17592186699508 1067 "Assignment information" 13194139540653 17592186502323 true] [17592186699509 1058 #edb/ref 17592186699523 13194139540653 17592186502323 true] [17592186699509 1062 #uuid "16d5f04d-12ac-593d-8251-5e7b20924669" 13194139540653 17592186502323 true] [17592186699509 1063 #edb/ref 17592186699541 13194139540653 17592186502323 true] [17592186699510 1080 "False" 13194139540653 17592186502323 true] [17592186699510 1081 "Although dimension is defined as the size of a basis, that size also equals the maximum size of an independent subset of the space." 13194139540653 17592186502323 true] [17592186699510 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699510 1083 #uuid "1a10ed3f-2d33-5b21-bddc-a3a7182e1613" 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699506 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699509 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699523 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699525 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699530 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699532 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699533 13194139540653 17592186502323 true] [17592186699511 1043 #edb/ref 17592186699535 13194139540653 17592186502323 true] [17592186699511 1044 #edb/ref 17592186045461 13194139540653 17592186502323 true] [17592186699511 1045 "MTH 341 — PRQ-10" 13194139540653 17592186502323 true] [17592186699511 1046 #edb/ref 17592186699532 13194139540653 17592186502323 true] [17592186699511 1047 #inst "2026-10-28T06:59:00.000Z" 13194139540653 17592186502323 true] [17592186699511 1048 #edb/ref 17592186405206 13194139540653 17592186502323 true] [17592186699511 1053 #uuid "1c1130c7-9d37-5976-a9ab-5cc1c2e8109a" 13194139540653 17592186502323 true] [17592186699512 1068 #edb/ref 17592186699517 13194139540653 17592186502323 true] [17592186699512 1071 "Source question: Canvas Question 1 (question_59459019).\n\nLet $V$ be a subspace of $\\mathbb R^n$. Is the zero vector in $V$?" 13194139540653 17592186502323 true] [17592186699512 1072 #uuid "231c62cd-5950-547a-92f8-00b5add4ed60" 13194139540653 17592186502323 true] [17592186699512 1074 "A subspace is nonempty, so choose $\\mathbf v\\in V$. Closure under scalar multiplication gives $0\\mathbf v=\\mathbf0\\in V$. This includes the zero subspace $V=\\{\\mathbf0\\}$." 13194139540653 17592186502323 true] [17592186699513 1080 "False" 13194139540653 17592186502323 true] [17592186699513 1081 "The standard basis of $\\mathbb R^n$ has $n$ vectors, so a fixed count of six is not correct for general $n$." 13194139540653 17592186502323 true] [17592186699513 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699513 1083 #uuid "24b5da8f-89a0-55b1-bae6-dcd9940bb4df" 13194139540653 17592186502323 true] [17592186699514 1075 #edb/ref 17592186699513 13194139540653 17592186502323 true] [17592186699514 1075 #edb/ref 17592186699528 13194139540653 17592186502323 true] [17592186699514 1076 #edb/ref 17592186045493 13194139540653 17592186502323 true] [17592186699514 1077 "answer" 13194139540653 17592186502323 true] [17592186699514 1078 #edb/ref 17592186699513 13194139540653 17592186502323 true] [17592186699514 1079 #uuid "2522467c-4ab6-52b1-88eb-e406d5e6b8f7" 13194139540653 17592186502323 true] [17592186699515 1080 "No" 13194139540653 17592186502323 true] [17592186699515 1081 "The original finite set need not be a subspace, but its span contains every real linear combination, which ensures the subspace conditions." 13194139540653 17592186502323 true] [17592186699515 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699515 1083 #uuid "30f1cf9e-1761-5ec5-8dc5-d7024dee23ab" 13194139540653 17592186502323 true] [17592186699516 1064 "**Closing reading reminder** (unnumbered source item question_59459025): Know the **Subspace Test**, Theorem 4.75, for your study. This item requests no answer." 13194139540653 17592186502323 true] [17592186699516 1066 #uuid "346cfca5-a92c-58e1-a776-1731fd2a519c" 13194139540653 17592186502323 true] [17592186699516 1067 "Closing reading reminder" 13194139540653 17592186502323 true] [17592186699517 1075 #edb/ref 17592186699519 13194139540653 17592186502323 true] [17592186699517 1075 #edb/ref 17592186699527 13194139540653 17592186502323 true] [17592186699517 1076 #edb/ref 17592186045493 13194139540653 17592186502323 true] [17592186699517 1077 "answer" 13194139540653 17592186502323 true] [17592186699517 1078 #edb/ref 17592186699527 13194139540653 17592186502323 true] [17592186699517 1079 #uuid "358b9fe9-c413-50e9-81f7-29b1293b42fc" 13194139540653 17592186502323 true] [17592186699518 1068 #edb/ref 17592186699531 13194139540653 17592186502323 true] [17592186699518 1071 "Source question: Canvas Question 2 (question_59459020).\n\nLet $\\{\\vec v_1,\\vec v_2,\\vec v_3,\\ldots,\\vec v_k\\}$ be a set of vectors in $\\mathbb R^n$.\n\nIs the span of $\\{\\vec v_1,\\vec v_2,\\vec v_3,\\ldots,\\vec v_k\\}$ a subspace of $\\mathbb R^n$?" 13194139540653 17592186502323 true] [17592186699518 1072 #uuid "38c28c42-dcfa-5814-9aa6-882982c44e00" 13194139540653 17592186502323 true] [17592186699518 1074 "Write $W=\\operatorname{span}\\{\\vec v_1,\\ldots,\\vec v_k\\}$. Choosing all coefficients zero shows $\\mathbf0\\in W$. If $\\mathbf u=\\sum_{i=1}^k a_i\\vec v_i$ and $\\mathbf w=\\sum_{i=1}^k b_i\\vec v_i$ lie in $W$, then\n\n$$\\mathbf u+\\mathbf w=\\sum_{i=1}^k(a_i+b_i)\\vec v_i\\in W,$$\n\nand for every real scalar $c$,\n\n$$c\\mathbf u=\\sum_{i=1}^k(ca_i)\\vec v_i\\in W.$$\n\nThese are the subspace conditions. The spanning vectors may be dependent, independent, or zero." 13194139540653 17592186502323 true] [17592186699519 1080 "No" 13194139540653 17592186502323 true] [17592186699519 1081 "A subspace is nonempty and closed under scalar multiplication, including multiplication by zero. Thus it cannot omit the zero vector." 13194139540653 17592186502323 true] [17592186699519 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699519 1083 #uuid "3a63531a-a289-5683-9664-5c92cdeb7732" 13194139540653 17592186502323 true] [17592186699520 1068 #edb/ref 17592186699514 13194139540653 17592186502323 true] [17592186699520 1071 "Source question: Canvas Question 4 (question_59459022).\n\nThe standard basis for $\\mathbb R^n$ has 6 vectors in it." 13194139540653 17592186502323 true] [17592186699520 1072 #uuid "3d41bbd8-0239-5e0b-bc1a-94b15180f9ac" 13194139540653 17592186502323 true] [17592186699520 1074 "The standard basis is $\\{\\mathbf e_1,\\ldots,\\mathbf e_n\\}$, where $\\mathbf e_j$ has a $1$ in coordinate $j$ and zeros elsewhere. There is one vector per coordinate, hence $n$ vectors. For example, $\\mathbb R^2$ has standard basis $\\{(1,0),(0,1)\\}$ with two vectors. The source statement holds in the special case $n=6$, but is false as a general assertion about $\\mathbb R^n$." 13194139540653 17592186502323 true] [17592186699521 1080 "False" 13194139540653 17592186502323 true] [17592186699521 1081 "Linear independence is required in the definition of a basis." 13194139540653 17592186502323 true] [17592186699521 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699521 1083 #uuid "429a0b89-baed-558f-a0e9-1469c81e8ac2" 13194139540653 17592186502323 true] [17592186699522 1080 "True" 13194139540653 17592186502323 true] [17592186699522 1081 "A basis is an independent set of size $\\dim V$, and no independent subset of $V$ can be larger." 13194139540653 17592186502323 true] [17592186699522 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699522 1083 #uuid "475bf8ff-adb9-561b-bc86-1bfe6bd49962" 13194139540653 17592186502323 true] [17592186699523 1058 #edb/ref 17592186699530 13194139540653 17592186502323 true] [17592186699523 1062 #uuid "4a286bc3-7b1d-514a-a52e-402e8ed40a6c" 13194139540653 17592186502323 true] [17592186699523 1063 #edb/ref 17592186699538 13194139540653 17592186502323 true] [17592186699524 1080 "True" 13194139540653 17592186502323 true] [17592186699524 1081 "A spanning set may be dependent, but a basis must satisfy both spanning and linear independence." 13194139540653 17592186502323 true] [17592186699524 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699524 1083 #uuid "4ee01dc8-3e30-5878-af16-19c23ebbc0b8" 13194139540653 17592186502323 true] [17592186699525 1058 #edb/ref 17592186699506 13194139540653 17592186502323 true] [17592186699525 1062 #uuid "50edb5d9-c018-5438-bf4a-fd473b9d9a9b" 13194139540653 17592186502323 true] [17592186699525 1063 #edb/ref 17592186699529 13194139540653 17592186502323 true] [17592186699526 1088 #edb/ref 17592186051046 13194139540653 17592186502323 true] [17592186699526 1089 #edb/ref 17592186699512 13194139540653 17592186502323 true] [17592186699526 1090 #uuid "563ce198-9770-5595-868e-baa620f1e785" 13194139540653 17592186502323 true] [17592186699527 1080 "Yes" 13194139540653 17592186502323 true] [17592186699527 1081 "Every subspace contains the zero vector; multiplying any vector in it by zero gives the zero vector." 13194139540653 17592186502323 true] [17592186699527 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699527 1083 #uuid "5a4e9858-fcf5-5711-a11d-bdd01cfcf056" 13194139540653 17592186502323 true] [17592186699528 1080 "True" 13194139540653 17592186502323 true] [17592186699528 1081 "Six vectors is the count only when $n=6$. The statement gives no such restriction on $n$." 13194139540653 17592186502323 true] [17592186699528 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699528 1083 #uuid "5f962599-cfbc-5f79-9579-92bc449d2057" 13194139540653 17592186502323 true] [17592186699529 1088 #edb/ref 17592186048218 13194139540653 17592186502323 true] [17592186699529 1088 #edb/ref 17592186048552 13194139540653 17592186502323 true] [17592186699529 1088 #edb/ref 17592186050426 13194139540653 17592186502323 true] [17592186699529 1088 #edb/ref 17592186051046 13194139540653 17592186502323 true] [17592186699529 1089 #edb/ref 17592186699537 13194139540653 17592186502323 true] [17592186699529 1090 #uuid "6bd94823-2af8-5542-bb42-dd8f8802d886" 13194139540653 17592186502323 true] [17592186699530 1058 #edb/ref 17592186699525 13194139540653 17592186502323 true] [17592186699530 1062 #uuid "6bea2825-f608-5e48-8145-3fd83075a7d4" 13194139540653 17592186502323 true] [17592186699530 1063 #edb/ref 17592186699507 13194139540653 17592186502323 true] [17592186699531 1075 #edb/ref 17592186699515 13194139540653 17592186502323 true] [17592186699531 1075 #edb/ref 17592186699540 13194139540653 17592186502323 true] [17592186699531 1076 #edb/ref 17592186045493 13194139540653 17592186502323 true] [17592186699531 1077 "answer" 13194139540653 17592186502323 true] [17592186699531 1078 #edb/ref 17592186699540 13194139540653 17592186502323 true] [17592186699531 1079 #uuid "72185d4a-4342-50ef-a687-0b73470c2c19" 13194139540653 17592186502323 true] [17592186699532 1058 #edb/ref 17592186699533 13194139540653 17592186502323 true] [17592186699532 1062 #uuid "7ee08125-4d58-5684-b6a1-423edded60b0" 13194139540653 17592186502323 true] [17592186699532 1063 #edb/ref 17592186699508 13194139540653 17592186502323 true] [17592186699533 1058 #edb/ref 17592186699535 13194139540653 17592186502323 true] [17592186699533 1062 #uuid "88de70f9-1f1c-58a0-9b8a-a3a74edda49b" 13194139540653 17592186502323 true] [17592186699533 1063 #edb/ref 17592186699526 13194139540653 17592186502323 true] [17592186699534 1088 #edb/ref 17592186048315 13194139540653 17592186502323 true] [17592186699534 1088 #edb/ref 17592186050656 13194139540653 17592186502323 true] [17592186699534 1088 #edb/ref 17592186051046 13194139540653 17592186502323 true] [17592186699534 1089 #edb/ref 17592186699518 13194139540653 17592186502323 true] [17592186699534 1090 #uuid "9ae48055-10f2-53b8-9d3e-701728d39416" 13194139540653 17592186502323 true] [17592186699535 1058 #edb/ref 17592186699509 13194139540653 17592186502323 true] [17592186699535 1062 #uuid "9c3aefbc-c4fc-5156-8759-c303a18e8a7c" 13194139540653 17592186502323 true] [17592186699535 1063 #edb/ref 17592186699534 13194139540653 17592186502323 true] [17592186699536 1068 #edb/ref 17592186699544 13194139540653 17592186502323 true] [17592186699536 1071 "Source question: Canvas Question 3 (question_59459021).\n\nThe vectors in a basis for a subspace do not need to be linearly independent." 13194139540653 17592186502323 true] [17592186699536 1072 #uuid "a5aeec03-395c-5f4e-9e44-dc48d1a73d10" 13194139540653 17592186502323 true] [17592186699536 1074 "A basis for $V$ is a linearly independent set that spans $V$. Both conditions are necessary. For example, $\\{(1,0),(0,1),(1,1)\\}$ spans $\\mathbb R^2$ but is not a basis, because $(1,1)=(1,0)+(0,1)$ makes the set dependent." 13194139540653 17592186502323 true] [17592186699537 1068 #edb/ref 17592186699546 13194139540653 17592186502323 true] [17592186699537 1071 "Source question: Canvas Question 6 (question_59459024).\n\nThe dimension of a subspace $V$ of $\\mathbb R^n$ is the largest number of nonzero linearly independent vectors that are contained in $V$." 13194139540653 17592186502323 true] [17592186699537 1072 #uuid "a5e7faae-c11f-5729-aa65-abf94f90a3b4" 13194139540653 17592186502323 true] [17592186699537 1074 "Let $d=\\dim V$ and choose a basis $\\{\\mathbf b_1,\\ldots,\\mathbf b_d\\}$. These $d$ vectors form an independent subset of $V$.\n\nTo check that a larger independent subset is impossible, express any $m>d$ vectors of $V$ in this basis. Put their coordinate columns into a $d\\times m$ matrix $C$. The homogeneous system $C\\mathbf a=\\mathbf0$ has more unknowns than rows, so it has a free variable and a nonzero solution. The same coefficients give a nontrivial zero combination of the original vectors; therefore they are dependent.\n\nThus the largest possible independent-set size is $d$, the number of vectors in a basis for $V$. The word **nonzero** is redundant, since any set containing the zero vector is dependent. For $V=\\{\\mathbf0\\}$, the empty basis has zero vectors and $\\dim V=0$." 13194139540653 17592186502323 true] [17592186699538 1088 #edb/ref 17592186048218 13194139540653 17592186502323 true] [17592186699538 1088 #edb/ref 17592186050638 13194139540653 17592186502323 true] [17592186699538 1089 #edb/ref 17592186699520 13194139540653 17592186502323 true] [17592186699538 1090 #uuid "a94acfef-ccad-57c1-ac43-3b4a7bb68f2b" 13194139540653 17592186502323 true] [17592186699539 1080 "False" 13194139540653 17592186502323 true] [17592186699539 1081 "The identity matrix has ones on the diagonal and zeros elsewhere. Its columns are exactly the standard basis vectors." 13194139540653 17592186502323 true] [17592186699539 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699539 1083 #uuid "ab36552e-849b-5dd0-afb4-a0ebff40d81e" 13194139540653 17592186502323 true] [17592186699540 1080 "Yes" 13194139540653 17592186502323 true] [17592186699540 1081 "The span contains zero and is closed under addition and scalar multiplication because these operations produce further linear combinations of the same vectors." 13194139540653 17592186502323 true] [17592186699540 1082 #edb/ref 17592186045499 13194139540653 17592186502323 true] [17592186699540 1083 #uuid "c260e932-4a8a-5967-bc15-8468fa3e316a" 13194139540653 17592186502323 true] [17592186699541 1088 #edb/ref 17592186049222 13194139540653 17592186502323 true] [17592186699541 1088 #edb/ref 17592186050426 13194139540653 17592186502323 true] [17592186699541 1089 #edb/ref 17592186699536 13194139540653 17592186502323 true] [17592186699541 1090 #uuid "c3ad3223-ca07-57e1-b004-25cbdb02d0ca" 13194139540653 17592186502323 true] [17592186699542 1075 #edb/ref 17592186699539 13194139540653 17592186502323 true] [17592186699542 1075 #edb/ref 17592186699545 13194139540653 17592186502323 true] [17592186699542 1076 #edb/ref 17592186045493 13194139540653 17592186502323 true] [17592186699542 1077 "answer" 13194139540653 17592186502323 true] [17592186699542 1078 #edb/ref 17592186699545 13194139540653 17592186502323 true] [17592186699542 1079 #uuid "ce9720b3-74dc-5010-9cc5-2c2817621b31" 13194139540653 17592186502323 true] [17592186699543 1068 #edb/ref 17592186699542 13194139540653 17592186502323 true] [17592186699543 1071 "Source question: Canvas Question 5 (question_59459023).\n\nThe standard basis of $\\mathbb R^n$ consists of the columns of the $n\\times n$ identity matrix." 13194139540653 17592186502323 true] [17592186699543 1072 #uuid "d54d5bea-6e03-5bed-9731-f246549d53f8" 13194139540653 17592186502323 true] [17592186699543 1074 "The identity matrix is $I_n=[\\mathbf e_1\\ \\cdots\\ \\mathbf e_n]$. Its columns span $\\mathbb R^n$ because every vector $\\mathbf x=(x_1,\\ldots,x_n)^T$ equals $x_1\\mathbf e_1+\\cdots+x_n\\mathbf e_n$. They are independent because $c_1\\mathbf e_1+\\cdots+c_n\\mathbf e_n=\\mathbf0$ forces every coordinate $c_j$ to be zero. Thus these columns form the standard basis." 13194139540653 17592186502323 true] [17592186699544 1075 #edb/ref 17592186699521 13194139540653 17592186502323 true] [17592186699544 1075 #edb/ref 17592186699524 13194139540653 17592186502323 true] [17592186699544 1076 #edb/ref 17592186045493 13194139540653 17592186502323 true] [17592186699544 1077 "answer" 13194139540653 17592186502323 true] [17592186699544 1078 #edb/ref 17592186699521 13194139540653 17592186502323 true] [17592186699544 1079 #uuid "e87ea751-8c30-5cab-a9be-b4aa1757ebf3" 13194139540653 17592186502323 true] [17592186699545 1080 "True" 13194139540653 17592186502323 true] [17592186699545 1081