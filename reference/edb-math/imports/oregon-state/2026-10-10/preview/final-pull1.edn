 17592186049859}] :db/id #edb/ref 17592186405762}] [[:answer/id #uuid "fb3063d8-4aed-5d76-a03b-eb61632f58f0"] {:answer/id #uuid "fb3063d8-4aed-5d76-a03b-eb61632f58f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{13}3" :db/id #edb/ref 17592186406324}] [[:answer-field/id #uuid "2f68a65e-f013-5ddd-bade-8ddbc9803f88"] {:answer-field/choices [{:answer/id #uuid "fb3063d8-4aed-5d76-a03b-eb61632f58f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{13}3" :db/id #edb/ref 17592186406324}] :answer-field/correct {:db/id #edb/ref 17592186406324} :answer-field/id #uuid "2f68a65e-f013-5ddd-bade-8ddbc9803f88" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405927}] [[:question/id #uuid "da9aa18c-1981-5101-908b-64dab995c7b4"] {:db/id #edb/ref 17592186405723 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb3063d8-4aed-5d76-a03b-eb61632f58f0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{13}3" :db/id #edb/ref 17592186406324}] :answer-field/correct {:db/id #edb/ref 17592186406324} :answer-field/id #uuid "2f68a65e-f013-5ddd-bade-8ddbc9803f88" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405927}] :question/id #uuid "da9aa18c-1981-5101-908b-64dab995c7b4" :question/problem "Source question: 17.\n\nFind the work of $\\mathbf F=\\langle7y,3x\\rangle$ along $\\mathbf r(t)=\\langle t,t^2\\rangle$ from t=0 to t=1.\n\nAnswer: {{answer}}." :question/worked-solution "$F(r)=(7t^2,3t)$, $r\\prime=(1,2t)$. Thus $W=\\int_0^1(7t^2+6t^2)dt=13/3$."}] [[:assigned-problem/id #uuid "098b4466-078b-535c-bcb0-1638dc514999"] {:assigned-problem/content {:db/id #edb/ref 17592186405723} :assigned-problem/id #uuid "098b4466-078b-535c-bcb0-1638dc514999" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048960} {:db/id #edb/ref 17592186049859}] :db/id #edb/ref 17592186405079}] [[:answer/id #uuid "44cb2644-25fa-5d