5d-34b6777acad3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "12-16\\sin2-12\\cos2" :db/id #edb/ref 17592186406038}] [[:answer-field/id #uuid "2c1a9543-5af7-563d-9591-b404e90c0af6"] {:answer-field/choices [{:answer/id #uuid "6934d352-492f-5f53-8c5d-34b6777acad3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "12-16\\sin2-12\\cos2" :db/id #edb/ref 17592186406038}] :answer-field/correct {:db/id #edb/ref 17592186406038} :answer-field/id #uuid "2c1a9543-5af7-563d-9591-b404e90c0af6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405920}] [[:question/id #uuid "b054d67c-ee99-5f26-bc1c-b0e0b3cfe57b"] {:db/id #edb/ref 17592186405588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6934d352-492f-5f53-8c5d-34b6777acad3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "12-16\\sin2-12\\cos2" :db/id #edb/ref 17592186406038}] :answer-field/correct {:db/id #edb/ref 17592186406038} :answer-field/id #uuid "2c1a9543-5af7-563d-9591-b404e90c0af6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405920}] :question/id #uuid "b054d67c-ee99-5f26-bc1c-b0e0b3cfe57b" :question/problem "Source question: 9.\n\nFind $\\int_C6x\\cos y\\,dx-8y\\sin x\\,dy$ along the segments (0,0) → (2,0) → (2,2) → (0,2), in that order.\n\nAnswer: {{answer}}." :question/worked-solution "The bottom segment contributes $\\int_0^2 6x dx=12$. The right segment contributes $\\int_0^2-8y\\sin2\\,dy=-16\\sin2$. The top, traversed right to left, contributes $\\int_2^0 6x\\cos2\\,dx=-12\\cos2$. Do not add a fourth segment."}] [[:assigned-problem/id #uuid "5e53c922-4405-550e-b492-5530f1f6f7c1"] {:assigned-problem/content {:db/id #edb/ref 17592186405588} :assigned-problem/id #uuid "5e53c922-4405-550e-b492-5530f1f6f7c1" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048546}] :db/id #edb/ref 17592186405336}] [[:answer/id #uuid "6bf699ad-ea33-59e1-a441-7f57fe9c5374"] {:answer/id #uuid "6bf699ad-ea33-59e1-a441-7f57fe9c5374" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "162+9\\pi" :db/id #edb/ref 17592186406045}] [[:answer-field/id #uuid "ef8fd94f-0472-53a3-b011-dff6b5a0da7d"] {:answer-field/choices [{:answer/id #uuid "6bf699ad-ea33-59e1-a441-7f57fe9c5374" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "162+9\\pi" :db/id #edb/ref 17592186406045}] :answer-field/correct {:db/id #edb/ref 17592186406045} :answer-field/id #uuid "ef8fd94f-0472-53a3-b011-dff6b5a0da7d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406289}] [[:question/id #uuid "d3e54510-4687-590a-be32-120f1c624f18"] {:db/id #edb/ref 17592186405703 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bf699ad-ea33-59e1-a441-7f57fe9c5374" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "162+9\\pi" :db/id #edb/ref 17592186406045}] :answer-field/correct {:db/id #edb/ref 17592186406045} :answer-field/id #uuid "ef8fd94f-0472-53a3-b011-dff6b5a0da7d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406289}] :question/id #uuid "d3e54510-4687-590a-be32-120f1c624f18" :question/problem "Source question: 10.\n\nA thin wire follows $x=9\\sin(2t),\\ y=9\\cos(2t),\\ 0\\le t\\le\\pi/4$ and has density $\\rho(x,y)=x+y+2$. Find its mass M.\n\nAnswer: {{answer}}." :question/worked-solution "Mass is $\\int_C\\rho ds$. Speed is 18, so $M=18\\int_0^{\\pi/4}[9\\sin2t+9\\cos2t+2]dt=18(9+\\pi/2)$."}] [[:assigned-problem/id #uuid "d0e0182c-e4b0-5a55-9bf6-975c2ffeb6a1"] {:assigned-problem/content {:db/id #edb/ref 17592186405703} :assigned-problem/id #uuid "d0e0182c-e4b0-5a55-9bf6-975c2ffeb6a1" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405693}] [[:answer/id #uuid "3ef8533c-f019-53d5-b8f3-8015a55e3942"] {:answer/id #uuid "3ef8533c-f019-53d5-b8f3-8015a55e3942" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5\\pi" :db/id #edb/ref 17592186405953}] [[:answer-field/id #uuid "5dbad462-1ce0-54c5-8287-4f1353fbeb02"] {:answer-field/choices [{:answer/id #uuid "3ef8533c-f019-53d5-b8f3-8015a55e3942" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5\\pi" :db/id #edb/ref 17592186405953}] :answer-field/correct {:db/id #edb/ref 17592186405953} :answer-field/id #uuid "5dbad462-1ce0-54c5-8287-4f1353fbeb02" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406015}] [[:question/id #uuid "ba1a1155-634a-5359-b506-deabdb302e33"] {:db/id #edb/ref 17592186405627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ef8533c-f019-53d5-b8f3-8015a55e3942" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5\\pi" :db/id #edb/ref 17592186405953}] :answer-field/correct {:db/id #edb/ref 17592186405953} :answer-field/id #uuid "5dbad462-1ce0-54c5-8287-4f1353fbeb02" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406015}] :question/id #uuid "ba1a1155-634a-5359-b506-deabdb302e33" :question/problem "Source question: 11.\n\nFind the lateral area above the xy-plane and below $z=3-y^2$, formed by vertical segments from $C: x=\\sin(11t),\\ y=\\cos(11t),\\ 0\\le t\\le2\\pi/11$.\n\nAnswer: {{answer}}." :question/worked-solution "Area is height integrated over the base arc: $A=\\int_C(3-y^2)ds$. The speed is 11; u=11t gives $\\int_0^{2\\pi}(3-\\cos^2u)du=6\\pi-\\pi$."}] [[:assigned-problem/id #uuid "2e94ae61-155c-5580-aa18-4e5855960283"] {:assigned-problem/content {:db/id #edb/ref 17592186405627} :assigned-problem/id #uuid "2e94ae61-155c-5580-aa18-4e5855960283" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405189}] [[:answer/id #uuid "373731aa-2ea2-5eaf-82f2-de7e31e52935"] {:answer/id #uuid "373731aa-2ea2-5eaf-82f2-de7e31e52935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1029" :db/id #edb/ref 17592186405934}] [[:answer-field/id #uuid "b4ecaf8d-931d-555b-9fa9-a72f5c2aa45b"] {:answer-field/choices [{:answer/id #uuid "373731aa-2ea2-5eaf-82f2-de7e31e52935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1029" :db/id #edb/ref 17592186405934}] :answer-field/correct {:db/id #edb/ref 17592186405934} :answer-field/id #uuid "b4ecaf8d-931d-555b-9fa9-a72f5c2aa45b" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406182}] [[:question/id #uuid "0384d8f4-779d-5541-bc94-33b20624855c"] {:db/id #edb/ref 17592186405060 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "373731aa-2ea2-5eaf-82f2-de7e31e52935" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1029" :db/id #edb/ref 17592186405934}] :answer-field/correct {:db/id #edb/ref 17592186405934} :answer-field/id #uuid "b4ecaf8d-931d-555b-9fa9-a72f5c2aa45b" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406182}] :question/id #uuid "0384d8f4-779d-5541-bc94-33b20624855c" :question/problem "Source question: 12.\n\nFind the lateral area above the xy-plane and below $z=6xy$, formed by vertical segments from $C: y=\\sqrt{49-x^2},\\ 0\\le x\\le7$.\n\nAnswer: {{answer}}." :question/worked-solution "Use x=7cosθ, y=7sinθ, 0≤θ≤π/2; scalar arc length is orientation independent. Then $A=\\int_0^{\\pi/2}294\\cos\\theta\\sin\\theta\\,(7)d\\theta=2058/2=1029$."}] [[:assigned-problem/id #uuid "b7801be6-3f36-592b-bed0-4dc1ed119e05"] {:assigned-problem/content {:db/id #edb/ref 17592186405060} :assigned-problem/id #uuid "b7801be6-3f36-592b-bed0-4dc1ed119e05" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405616}] [[:answer/id #uuid "f44081fe-3fa7-5094-b014-b56e46bb6adb"] {:answer/id #uuid "f44081fe-3fa7-5094-b014-b56e46bb6adb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "8\\pi\\rho\\sqrt{37}" :db/id #edb/ref 17592186406303}] [[:answer-field/id #uuid "d6c11a4c-e1ac-5409-8478-01fe11b6e6d0"] {:answer-field/choices [{:answer/id #uuid "f44081fe-3fa7-5094-b014-b56e46bb6adb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "8\\pi\\rho\\sqrt{37}" :db/id #edb/ref 17592186406303}] :answer-field/correct {:db/id #edb/ref 17592186406303} :answer-field/id #uuid "d6c11a4c-e1ac-5409-8478-01fe11b6e6d0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406247}] [[:question/id #uuid "a0b0625f-905d-5d2b-80d5-9c8364e8d7e0"] {:db/id #edb/ref 17592186405549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f44081fe-3fa7-5094-b014-b56e46bb6adb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "8\\pi\\rho\\sqrt{37}" :db/id #edb/ref 17592186406303}] :answer-field/correct {:db/id #edb/ref 17592186406303} :answer-field/id #uuid "d6c11a4c-e1ac-5409-8478-01fe11b6e6d0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406247}] :question/id #uuid "a0b0625f-905d-5d2b-80d5-9c8364e8d7e0" :question/problem "Source question: 13.\n\nA thin wire forms the helix $x=6\\cos t,\\ y=6\\sin t,\\ z=t$. Find the mass M of four turns with constant density $\\rho$.\n\nAnswer: {{answer}}." :question/worked-solution "The speed is $\\sqrt{36\\sin^2t+36\\cos^2t+1}=\\sqrt{37}$. Four turns span 8π in t. Thus mass equals density times length: $\\rho\\sqrt{37}(8\\pi)$."}] [[:assigned-problem/id #uuid "20a2ba39-f0cd-5d7f-9afa-f6cc4f772544"] {:assigned-problem/content {:db/id #edb/ref 17592186405549} :assigned-problem/id #uuid "20a2ba39-f0cd-5d7f-9afa-f6cc4f772544" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405138}] [[:answer/id #uuid "3e6bdfbc-69e8-597f-b128-f4ecbdfa7827"] {:answer/id #uuid "3e