:answer/id #uuid "400ac8c9-e400-521c-945a-74c3e5a4c8d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{68\\sqrt{26}}3" :db/id #edb/ref 17592186405958}] :answer-field/correct {:db/id #edb/ref 17592186405958} :answer-field/id #uuid "7315d4f7-3751-5b02-92c3-544c141fe2d1" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406057}] [[:question/id #uuid "30f7676a-3b0f-5273-80f7-f3100f46de67"] {:db/id #edb/ref 17592186405196 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "400ac8c9-e400-521c-945a-74c3e5a4c8d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{68\\sqrt{26}}3" :db/id #edb/ref 17592186405958}] :answer-field/correct {:db/id #edb/ref 17592186405958} :answer-field/id #uuid "7315d4f7-3751-5b02-92c3-544c141fe2d1" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406057}] :question/id #uuid "30f7676a-3b0f-5273-80f7-f3100f46de67" :question/problem "Source question: 1.\n\nLet $S:z=4x+3y+5$, $0\\le x\\le1$, $0\\le y\\le4$. Find $\\iint_S(x^2+y^2)dS$.\n\nAnswer: {{answer}}." :question/worked-solution "$dS=\\sqrt{1+4^2+3^2}dxdy=\\sqrt{26}dxdy$. Over the rectangle, the integral of x² is 4/3 and that of y² is 64/3. Their sum is 68/3."}] [[:assigned-problem/id #uuid "02e2242b-9d8a-5e4e-b6f4-a5d576b72263"] {:assigned-problem/content {:db/id #edb/ref 17592186405196} :assigned-problem/id #uuid "02e2242b-9d8a-5e4e-b6f4-a5d576b72263" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049889}] :db/id #edb/ref 17592186405057}] [[:answer/id #uuid "1fa4b54a-2442-5694-ba2c-de73c14f4547"] {:answer/id #uuid "1fa4b54a-2442-5694-ba2c-de73c14f4547" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac2{147}(233\\sqrt{233}-37\\sqrt{37})" :db/id #edb/ref 17592186405892}] [[:answer-field/id #uuid "eb28b885-69c8-5c67-92e8-8c18391be921"] {:answer-field/choices [{:answer/id #uuid "1fa4b54a-2442-5694-ba2c-de73c14f4547" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac2{147}(233\\sqrt{233}-37\\sqrt{37})" :db/id #edb/ref 17592186405892}] :answer-field/correct {:db/id #edb/ref 17592186405892} :answer-field/id #uuid "eb28b885-69c8-5c67-92e8-8c18391be921" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406284}] [[:question/id #uuid "31ee107e-5eb3-5a84-a8ab-66a3caab956b"] {:db/id #edb/ref 17592186405198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fa4b54a-2442-5694-ba2c-de73c14f4547" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac2{147}(233\\sqrt{233}-37\\sqrt{37})" :db/id #edb/ref 17592186405892}] :answer-field/correct {:db/id #edb/ref 17592186405892} :answer-field/id #uuid "eb28b885-69c8-5c67-92e8-8c18391be921" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406284}] :question/id #uuid "31ee107e-5eb3-5a84-a8ab-66a3caab956b" :question/problem "Source question: 2.\n\nLet $S:z=7x^2+6y$, $0\\le x\\le1$, $0\\le y\\le2$. Find $\\iint_S4x\\,dS$.\n\nAnswer: {{answer}}." :question/worked-solution "$dS=\\sqrt{37+196x^2}dxdy$. Integrating out y gives $\\int_0^1 8x\\sqrt{37+196x^2}dx$. Substitute u=37+196x²; the result is $2[u^{3/2}]_{37}^{233}/147$."}] [[:assigned-problem/id #uuid "1676655a-2558-509c-a1ba-303a93c823c9"] {:assigned-problem/content {:db/id #edb/ref 17592186405198} :assigned-problem/id #uuid "1676655a-2558-509c-a1ba-303a93c823c9" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049889}] :db/id #edb/ref 17592186405109}] [[:answer/id #uuid "fb3523aa-56d7-5b2a-83e3-8c7a31951511"] {:answer/id #uuid "fb3523aa-56d7-5b2a-83e3-8c7a31951511" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{61\\sqrt{402}}{2400}" :db/id #edb/ref 17592186406325}] [[:answer-field/id #uuid "b64ec265-d6d9-56f9-a88b-c7d7028aee3a"] {:answer-field/choices [{:answer/id #uuid "fb3523aa-56d7-5b2a-83e3-8c7a31951511" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{61\\sqrt{402}}{2400}" :db/id #edb/ref 17592186406325}] :answer-field/correct {:db/id #edb/ref 17592186406325} :answer-field/id #uuid "b64ec265-d6d9-56f9-a88b-c7d7028aee3a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406187}] [[:question/id #uuid "265e4772-afae-5156-b83c-de56b8b144f3"] {:db/id #edb/ref 17592186405161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb3523aa-56d7-5b2a-83e3-8c7a31951511" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{61\\sqrt{402}}{2400}" :db/id #edb/ref 17592186406325}] :answer-field/correct {:db/id #edb/ref 17592186406325} :answer-field/id #uuid "b64ec265-d6d9-56f9-a88b-c7d7028aee3a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406187}] :question/id #uuid "265e4772-afae-5156-b83c-de56b8b144f3" :question/problem "Source question: 3.\n\nFind $\\iint_S(x+y+z)dS$ on $z=x-20y$ above the xy-region bounded by y=0, x=1, and x=20y.\n\nAnswer: {{answer}}." :question/worked-solution "The region is 0≤x≤1, 0≤y≤x/20. On S, x+y+z=2x−19y and dS=√402 dxdy. The inner integral is $[2xy-19y^2/2]_0^{x/20}=61x^2/800$. Integrating x gives 61/2400."}] [[:assigned-problem/id #uuid "e063da91-f0ea-537c-8fc8-fee89a39aef6"] {:assigned-problem/content {:db/id #edb/ref 17592186405161} :assigned-problem/id #uuid "e063da91-f0ea-537c-8fc8-fee89a39aef6" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049889}] :db/id #edb/ref 17592186405747}] [[:answer/id #uuid "a3960db6-1bc1-5473-abe0-bc16ff666e55"] {:answer/id #uuid "a3960db6-1bc1-5473-abe0-bc16ff666e55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "6400\\pi" :db/id #edb/ref 17592186406153}] [[:answer-field/id #uuid "811f1d36-95bd-5584-b79e-ea1b256d54e7"] {:answer-field/choices [{:answer/id #uuid "a3960db6-1bc1-5473-abe0-bc16ff666e55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "6400\\pi" :db/id #edb/ref 17592186406153}] :answer-field/correct {:db/id #edb/ref 17592186406153} :answer-field/id #uuid "811f1d36-95bd-5584-b79e-ea1b256d54e7" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406081}] [[:question/id #uuid "87aee391-df14-5d8e-81d7-0df427ac5219"] {:db/id #edb/ref 17592186405475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3960db6-1bc1-5473-abe0-bc16ff666e55" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "6400\\pi" :db/id #edb/ref 17592186406153}] :answer-field/correct {:db/id #edb/ref 17592186406153} :answer-field/id #uuid "811f1d36-95bd-5584-b79e-ea1b256d54e7" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406081}] :question/id #uuid "87aee391-df14-5d8e-81d7-0df427ac5219" :question/problem "Source question: 4.\n\nFind $\\iint_Sx^2z\\,dS$ on the cylindrical surface $x^2+y^2=64$, $0\\le z\\le5$.\n\nAnswer: {{answer}}." :question/worked-solution "Parameterize (8cosθ,8sinθ,z); the surface element is 8dθ dz. Thus $I=512\\int_0^{2\\pi}\\cos^2\\theta d\\theta\\int_0^5z\\,dz=512\\pi(25/2)=6400\\pi$. S contains only the side, not end disks."}] [[:assigned-problem/id #uuid "3dfbcf3c-112f-5673-827f-ae65affb00af"] {:assigned-problem/content {:db/id #edb/ref 17592186405475} :assigned-problem/id #uuid "3dfbcf3c-112f-5673-827f-ae65affb00af" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050514}] :db/id #edb/ref 17592186405235}] [[:answer/id #uuid "db451701-af84-5885-8070-edb77ae0a632"] {:answer/id #uuid "db451701-af84-5885-8070-edb77ae0a632" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{x}{7}" :db/id #edb/ref 17592186406255}] [[:answer-field/id #uuid "261ed098-6d7a-53ed-8a38-b79698074081"] {:answer-field/choices [{:answer/id #uuid "db451701-af84-5885-8070-edb77ae0a632" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{x}{7}" :