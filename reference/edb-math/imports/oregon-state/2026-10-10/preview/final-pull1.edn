s [{:answer/id #uuid "f374d405-29a2-549c-b35d-09eb0474c628" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "10x+8y+54z^5" :db/id #edb/ref 17592186406299}] :answer-field/correct {:db/id #edb/ref 17592186406299} :answer-field/id #uuid "d5463076-2370-5372-9067-5e91c25822d7" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406243}] [[:question/id #uuid "a9c6ae11-f1b3-5459-a01e-7d9e7b21330f"] {:db/id #edb/ref 17592186405570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f374d405-29a2-549c-b35d-09eb0474c628" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "10x+8y+54z^5" :db/id #edb/ref 17592186406299}] :answer-field/correct {:db/id #edb/ref 17592186406299} :answer-field/id #uuid "d5463076-2370-5372-9067-5e91c25822d7" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406243}] :question/id #uuid "a9c6ae11-f1b3-5459-a01e-7d9e7b21330f" :question/problem "Source question: 1.\n\nFind $\\nabla\\cdot\\mathbf F$ for $\\mathbf F=\\langle5x^2,4y^2,9z^6\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "Divergence adds P_x+Q_y+R_z. Differentiate each component with respect to its matching coordinate: 10x, 8y, and 54z⁵."}] [[:assigned-problem/id #uuid "6e977281-ebc8-53e5-9390-35dbbcb36186"] {:assigned-problem/content {:db/id #edb/ref 17592186405570} :assigned-problem/id #uuid "6e977281-ebc8-53e5-9390-35dbbcb36186" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465}] :db/id #edb/ref 17592186405391}] [[:answer/id #uuid "3fc77115-722e-52c1-a018-a284e28a97ba"] {:answer/id #uuid "3fc77115-722e-52c1-a018-a284e28a97ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(5+6x^6)ye^z" :db/id #edb/ref 17592186405956}] [[:answer-field/id #uuid "56d9d7c2-dbaf-53af-a4e3-dd3dcebdc906"] {:answer-field/choices [{:answer/id #uuid "3fc77115-722e-52c1-a018-a284e28a97ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(5+6x^6)ye^z" :db/id #edb/ref 17592186405956}] :answer-field/correct {:db/id #edb/ref 17592186405956} :answer-field/id #uuid "56d9d7c2-dbaf-53af-a4e3-dd3dcebdc906" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406008}] [[:question/id #uuid "24a0dcf9-24f3-5f0a-90ea-42307bdb8afd"] {:db/id #edb/ref 17592186405155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fc77115-722e-52c1-a018-a284e28a97ba" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(5+6x^6)ye^z" :db/id #edb/ref 17592186405956}] :answer-field/correct {:db/id #edb/ref 17592186405956} :answer-field/id #uuid "56d9d7c2-dbaf-53af-a4e3-dd3dcebdc906" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406008}] :question/id #uuid "24a0dcf9-24f3-5f0a-90ea-42307bdb8afd" :question/problem "Source question: 2.\n\nFind $\\nabla\\cdot\\mathbf F$ for $\\mathbf F=\\langle5xye^z,6x^2e^z,6x^6ye^z\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "P_x=5yeᶻ, Q_y=0 because the second component contains no y, and R_z=6x⁶yeᶻ. Add and factor; do not differentiate Q with respect to x."}] [[:assigned-problem/id #uuid "62c7cb1a-bf92-5f6d-8441-46b657c9ad66"] {:assigned-problem/content {:db/id #edb/ref 17592186405155} :assigned-problem/id #uuid "62c7cb1a-bf92-5f6d-8441-46b657c9ad66" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465}] :db/id #edb/ref 17592186405347}] [[:answer/id #uuid "f9c1c508-7092-5b37-8c63-f30820fcdc51"] {:answer/id #uuid "f9c1c508-7092-5b37-8c63-f30820fcdc51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2+\\frac{4x+5y}{\\sqrt{4x^2+5y^2}}" :db/id #edb/ref 17592186406317}] [[:answer-field/id #uuid "2a5de7df-2118-5861-80c0-47aa425f3059"] {:answer-field/choices [{:answer/id #uuid "f9c1c508-7092-5b37-8c63-f30820fcdc51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2+\\frac{4x+5y}{\\sqrt{4x^2+5y^2}}" :db/id #edb/ref 17592186406317}] :answer-field/correct {:db/id #edb/ref 17592186406317} :answer-field/id #uuid "2a5de7df-2118-5861-80c0-47aa425f3059" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405917}] [[:question/id #uuid "4de38b69-fc49-5414-ba38-3e44e52ed23d"] {:db/id #edb/ref 17592186405292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9c1c508-7092-5b37-8c63-f30820fcdc51" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2+\\frac{4x+5y}{\\sqrt{4x^2+5y^2}}" :db/id #edb/ref 17592186406317}] :answer-field/correct {:db/id #edb/ref 17592186406317} :answer-field/id #uuid "2a5de7df-2118-5861-80c0-47aa425f3059" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405917}] :question/id #uuid "4de38b69-fc49-5414-ba38-3e44e52ed23d" :question/problem "Source question: 3.\n\nFind $\\nabla\\cdot\\mathbf F$ for $\\mathbf F=\\langle\\sqrt{4x^2+5y^2},\\sqrt{4x^2+5y^2},2z\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "The chain rule gives P_x=4x/√(4x²+5y²) and Q_y=5y/√(4x²+5y²); R_z=2. The formula applies when (x,y)≠(0,0). The required partial derivatives fail to exist on the z-axis, so the divergence is undefined there."}] [[:assigned-problem/id #uuid "94c02ce9-9caa-555b-8d4f-cebbdebe4335"] {:assigned-problem/content {:db/id #edb/ref 17592186405292} :assigned-problem/id #uuid "94c02ce9-9caa-555b-8d4f-cebbdebe4335" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465}] :db/id #edb/ref 17592186405518}] [[:answer/id #uuid "ca06b05c-6403-5f51-8b5a-59b380ad1abe"] {:answer/id #uuid "ca06b05c-6403-5f51-8b5a-59b380ad1abe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{46}{3}" :db/id #edb/ref 17592186406220}] [[:answer-field/id #uuid "7b6ebfb1-27b0-5864-ad04-16fb6d083a6e"] {:answer-field/choices [{:answer/id #uuid "ca06b05c-6403-5f51-8b5a-59b380ad1abe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{46}{3}" :db/id #edb/ref 17592186406220}] :answer-field/correct {:db/id #edb/ref 17592186406220} :answer-field/id #uuid "7b6ebfb1-27b0-5864-ad04-16fb6d083a6e" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406069}] [[:question/id #uuid "86edb82e-3c3e-550d-8bce-8b606a2ef8ab"] {:db/id #edb/ref 17592186405473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca06b05c-6403-5f51-8b5a-59b380ad1abe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{46}{3}" :db/id #edb/ref 17592186406220}] :answer-field/correct {:db/id #edb/ref 17592186406220} :answer-field/id #uuid "7b6ebfb1-27b0-5864-ad04-16fb6d083a6e" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406069}] :question/id #uuid "86edb82e-3c3e-550d-8bce-8b606a2ef8ab" :question/problem "Source question: 4.\n\nUse the divergence theorem to find the outward flux of $\\mathbf F=\\langle5xy+2z,9y^2+8,-8x-9y\\rangle$ through the surface of the solid bounded by x+y+z=2 and the three coordinate planes.\n\nAnswer: {{answer}}." :question/worked-solution "Divergence is 5y+18y=23y. The first-octant tetrahedron has volume 2³/6=4/3 and centroid y-coordinate 2/4=1/2. Hence ∭23y dV=23·(1/2)·(4/3)=46/3. Equivalently integrate 23y with 0≤x≤2, 0≤y≤2−x, 0≤z≤2−x−y."}] [[:assigned-problem/id #uuid "23f91ac0-09e0-5577-a446-ed12e0144c71"] {:assigned-problem/content {:db/id #edb/ref 17592186405473} :assigned-problem/id #uuid "23f91ac0-09e0-5577-a446-ed12e0144c71" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405153}] [[:answer/id #uuid "684a9172-3400-5722-8e2d-e2d59440cfbe"] {:answer/id #uuid "684a9172-3400-5722-8e2d-e2d59440cfbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "704" :db/id #edb/ref 17592186406036}] [[:answer-field/id #uuid "b2f93635-d830-54d0-b886-c12ce5471e2c"] {:answer-field/choices [{:answer/id #uuid "684a9172-3400-5722-8e2d-e2d59440cfbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "704" :db/id #edb/ref 17592186406036}] :answer-field/correct {:db/id #edb/ref 17592186406036} :answer-field/id #uuid "b2f93635-d830-54d0-b886-c12ce5471e2c" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406175}] [[:question/id #uuid "56055d00-5395-54ac-a58d-32197cc65912"] {:db/id #edb/ref 17592186405314 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "684a9172-3400-5722-8e2d-e2d59440cfbe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "704" :db/id #edb/ref 17592186406036}] :answer-field/correct {:db/id #edb/ref 17592186406036} :answer-field/id #uuid "b2f93635-d830-54d0-b886-c12ce5471e2c" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406175}] :question/id #uuid "56055d00-5395-54ac-a58d-32197cc65912" :question/problem "Source question: 5.\n\nUse the divergence theorem to find the outward flux of $\\mathbf F=\\langle2x-6y,9y-6z,7x-y\\rangle$ through the cube with faces x=±2, y=±2, z=±2.\n\nAnswer: {{answer}}." :question/worked-solution "Divergence is 2+9+0=11. The cube has side length 4, not 2, and volume 64. Thus the flux is 11·64=704."}] [[:assigned-problem/id #uuid "e20ae9c8-1515-56fd-85af-a2886f8918d1"] {:assigned-problem/content {:db/id #edb/ref 17592186405314} :assigned-problem/id #uuid "e20ae9c8-1515-56fd-85af-a2886f8918d1" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405754}] [[:answer/id #uuid "410c077b-43e7-5697-8f4e-aa470eb41149"] {:answer/id #uuid "410c077b-43e7-5697-8f4e-aa470eb41149" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2250\\pi" :db/id #edb/ref 17592186405960}] [[:answer-field/id #uuid "fbb3ed32-736a-5d2c-b0d4-48b8b2840055"] {:answer-field/choices [{:answer/id #uuid "410c077b-43e7-5697-8f4e-aa470eb41149" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2250\\pi" :db/id #edb/ref 17592186405960}] :answer-field/correct {:db/id #edb/ref 17592186405960} :answer-field/id #uuid "fbb3ed32-736a-5d2c-b0d4-48b8b2840055" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406327}] [[:question/id #uuid "81e342ef-0ce2-5e29-8051-7809751b201e"] {:db/id #edb/ref 17592186405452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "410c077b-43e7-5697-8f4e-aa470eb41149" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2250\\pi" :db/id #edb/ref 17592186405960}] :answer-field/correct {:db/id #edb/ref 17592186405960} :answer-field/id #uuid "fbb3ed32-736a-5d2c-b0d4-48b8b2840055" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406327}] :question/id #uuid "81e342ef-0ce2-5e29-8051-7809751b201e" :question/problem "Source question: 6.\n\nUse the divergence theorem to find the outward flux of $\\mathbf F=\\langle5x,3y^2,9z^2\\rangle$ through the entire boundary of the solid cylinder $x^2+y^2\\le9$, 0≤z≤5.\n\nAnswer: {{answer}}." :question/worked-solution "Divergence is 5+6y+18z. The y term integrates to zero over each centered disk. The area is 9π, so the integral is $9\\pi\\int_0^5(5+18z)dz=9\\pi(25+225)=2250\\pi$. The boundary includes both end disks."}] [[:assigned-problem/id #uuid "f01b9730-4bf4-56db-849b-ec52e051f3be"] {:assigned-problem/content {:db/id #edb/ref 17592186405452} :assigned-problem/id #uuid "f01b9730-4bf4-56db-849b-ec52e051f3be" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405786}] [[:answer/id #uuid "79226c5d-12bd-5308-a528-76b7cbd45db1"] {:answer/id #uuid "79226c5d-12bd-5308-a528-76b7cbd45db1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406063}] [[:answer-field/id #uuid "67a66e89-4014-5d7a-a4fc-fde559f02722"] {:answer-field/choices [{:answer/id #uuid "79226c5d-12bd-5308-a528-76b7cbd45db1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406063}] :answer-field/correct {:db/id #edb/ref 17592186406063} :answer-field/id #uuid "67a66e89-4014-5d7a-a4fc-fde559f02722" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406034}] [[:question/id #uuid "94b74c00-d8ab-51c7-b89c-2d184ff5338a"] {:db/id #edb/ref 17592186405517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79226c5d-12bd-5308-a528-76b7cbd45db1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406063}] :answer-field/correct {:db/id #edb/ref 17592186406063} :answer-field/id #uuid "67a66e89-4014-5d7a-a4fc-fde559f02722" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406034}] :question/id #uuid "94b74c00-d8ab-51c7-b89c-2d184ff5338a" :question/problem "Source question: 7.\n\nUse the divergence theorem to find the outward flux of $\\mathbf F=\\langle5yz,3xz,-9xy\\rangle$ through the tetrahedron with vertices (0,0,0), (5,0,0), (0,5,0), and (0,0,5).\n\nAnswer: {{answer}}." :question/worked-solution "P is independent of x, Q of y, and R of z, so divergence is 0 everywhere. Its integral over the tetrahedron is therefore 0. The field is smooth on the entire solid."}] [[:assigned-problem/id #uuid "f6399e6e-d636-57aa-ac64-8c4d2db6dab8"] {:assigned-problem/content {:db/id #edb/ref 17592186405517} :assigned-problem/id #uuid "f6399e6e-d636-57aa-ac64-8c4d2db6dab8" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405814}] [[:answer/id #uuid "cdfc16b8-dbf3-51d6-85bc-703fa59ca07e"] {:answer/id #uuid "cdfc16b8-dbf3-51d6-85bc-703fa59ca07e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "abc" :db/id #edb/ref 17592186406226}] [[:answer-field/id #uuid "de280945-6071-5153-8e98-4e820ba8feeb"] {:answer-field/choices [{:answer/id #uuid "cdfc16b8-dbf3-51d6-85bc-703fa59ca07e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "abc" :db/id #edb/ref 17592186406226}] :answer-field/correct {:db/id #edb/ref 17592186406226} :answer-field/id #uuid "de280945-6071-5153-8e98-4e820ba8feeb" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406260}] [[:question/id #uuid "0e2e8dc9-31df-5d18-abb8-1bd279f745b0"] {:db/id #edb/ref 17592186405089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cdfc16b8-dbf3-51d6-85bc-703fa59ca07e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "abc" :db/id #edb/ref 17592186406226}] :answer-field/correct {:db/id #edb/ref 17592186406226} :answer-field/id #uuid "de280945-6071-5153-8e98-4e820ba8feeb" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406260}] :question/id #uuid "0e2e8dc9-31df-5d18-abb8-1bd279f745b0" :question/problem "Source question: 8.\n\nLet $\\mathbf F=\\langle x,y,z\\rangle$ and let S bound a solid E satisfying the divergence theorem, with outward normal n. Use $V=\\frac13\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS$ to find the volume of a rectangular parallelepiped with side lengths a,b,c.\n\nAnswer: {{answer}}." :question/worked-solution "Place the box in 0≤x≤a, 0≤y≤b, 0≤z≤c. Flux on the three coordinate-plane faces is 0. On x=a the flux is a·bc=abc; the faces y=b and z=c each contribute abc as well. Total flux is 3abc, so dividing by 3 gives V=abc."}] [[:assigned-problem/id #uuid "c60a9c40-57e8-5cc3-9a75-2a7fba0d95fd"] {:assigned-problem/content {:db/id #edb/ref 17592186405089} :assigned-problem/id #uuid "c60a9c40-57e8-5cc3-9a75-2a7fba0d95fd" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405657}] [[:answer/id #uuid "13d6c066-7ca0-5399-9bda-1cf1593a438e"] {:answer/id #uuid "13d6c066-7ca0-5399-9bda-1cf1593a438e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi R^2h}{3}" :db/id #edb/ref 17592186405870}] [[:answer-field/id #uuid "38f76559-fc36-5124-a0ec-b2b2b1147536"] {:answer-field/choices [{:answer/id #uuid "13d6c066-7ca0-5399-9bda-1cf1593a438e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi R^2h}{3}" :db/id #edb/ref 17592186405870}] :answer-field/correct {:db/id #edb/ref 17592186405870} :answer-field/id #uuid "38f76559-fc36-5124-a0ec-b2b2b1147536" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405938}] [[:question/id #uuid "3e523128-6517-5b34-b017-bec6f0c077df"] {:db/id #edb/ref 17592186405237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13d6c066-7ca0-5399-9bda-1cf1593a438e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{\\pi R^2h}{3}" :db/id #edb/ref 17592186405870}] :answer-field/correct {:db/id #edb/ref 17592186405870} :answer-field/id #uuid "38f76559-fc36-5124-a0ec-b2b2b1147536" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405938}] :question/id #uuid "3e523128-6517-5b34-b017-bec6f0c077df" :question/problem "Source question: 9.\n\nLet $\\mathbf F=\\langle x,y,z\\rangle$ and use $V=\\frac13\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS$, with outward n, to find the volume of a right circular cone of height h and base radius R. Hint: orient the cone with vertex at the origin as shown.\n\n![Cone with vertex at the origin](images/b6/b680c204ce20d30c0451dede0c53b8fbef270bbacb3a2bcc6084796cb91a3018.png)\n\nAnswer: {{answer}}." :question/worked-solution "Place the vertex at the origin and base at z=h. The position vector F is tangent to the conical side along each generating line, so the side contributes zero flux. On the top disk the outward normal is k, so F·n=h and flux=hπR². The stated formula gives V=πR²h/3."}] [[:assigned-problem/id #uuid "eebe1f82-0161-57e2-bbb2-93e6adda5141"] {:assigned-problem/content {:db/id #edb/ref 17592186405237} :assigned-problem/id #uuid "eebe1f82-0161-57e2-bbb2-93e6adda5141" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405781}] [[:answer/id #uuid "99fa44af-ee25-58aa-8c41-6c7874823297"] {:answer/id #uuid "99fa44af-ee25-58aa-8c41-6c7874823297" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{4\\pi R^3}{3}" :db/id #edb/ref 17592186406128}] [[:answer-field/id #uuid "b3d0be84-baeb-5d92-9f0a-0bdc8ae6528f"] {:answer-field/choices [{:answer/id #uuid "99fa44af-ee25-58aa-8c41-6c7874823297" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{4\\pi R^3}{3}" :db/id #edb/ref 17592186406128}] :answer-field/correct {:db/id #edb/ref 17592186406128} :answer-field/id #uuid "b3d0be84-baeb-5d92-9f0a-0bdc8ae6528f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406178}] [[:question/id #uuid "3dfe008e-a7e5-5320-9768-ea799426d409"] {:db/id #edb/ref 17592186405236 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99fa44af-ee25-58aa-8c41-6c7874823297" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{4\\pi R^3}{3}" :db/id #edb/ref 17592186406128}] :answer-field/correct {:db/id #edb/ref 17592186406128} :answer-field/id #uuid "b3d0be84-baeb-5d92-9f0a-0bdc8ae6528f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406178}] :question/id #uuid "3dfe008e-a7e5-5320-9768-ea799426d409" :question/problem "Source question: 10.\n\nLet $\\mathbf F=\\langle x,y,z\\rangle$ and use $V=\\frac13\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS$, with outward n, to find the volume of a sphere of radius R.\n\nAnswer: {{answer}}." :question/worked-solution "Center the sphere at the origin. On its surface n=(x,y,z)/R, so F·n=R. Multiplying by its surface area 4πR² gives flux 4πR³. Divide by 3 to obtain V=4πR³/3."}] [[:assigned-problem/id #uuid "58fb2e0a-c06b-59e0-9660-f2fef42941d5"] {:assigned-problem/content {:db/id #edb/ref 17592186405236} :assigned-problem/id #uuid "58fb2e0a-c06b-59e0-9660-f2fef42941d5" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465} {:db/id #edb/ref 17592186050540}] :db/id #edb/ref 17592186405319}] [[:answer/id #uuid "e01caf60-0d3e-50f8-b031-f4eb32bad154"] {:answer/id #uuid "e01caf60-0d3e-50f8-b031-f4eb32bad154" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "30" :db/id #edb/ref 17592186406265}] [[:answer-field/id #uuid "b5611a0a-9fa8-5cd2-9a26-e922e5e3f27a"] {:answer-field/choices [{:answer/id #uuid "e01caf60-0d3e-50f8-b031-f4eb32bad154" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "30" :db/id #edb/ref 17592186406265}] :answer-field/correct {:db/id #edb/ref 17592186406265} :answer-field/id #uuid "b5611a0a-9fa8-5cd2-9a26-e922e5e3f27a" :answer-field/key "divf" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406184}] [[:answer/id #uuid "e3a78a74-9026-5c0c-96e6-11ce4ba0f25c"] {:answer/id #uuid "e3a78a74-9026-5c0c-96e6-11ce4ba0f25c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "30" :db/id #edb/ref 17592186406268}] [[:answer-field/id #uuid "7617d22e-b009-544a-bfad-dfef4a1e84ff"] {:answer-field/choices [{:answer/id #uuid "e3a78a74-9026-5c0c-96e6-11ce4ba0f25c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "30" :db/id #edb/ref 17592186406268}] :answer-field/correct {:db/id #edb/ref 17592186406268} :answer-field/id #uuid "7617d22e-b009-544a-bfad-dfef4a1e84ff" :answer-field/key "divg" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406059}] [[:question/id #uuid "20de299a-3d32-54ca-bfc6-cf1c6e597332"] {:db/id #edb/ref 17592186405139 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3a78a74-9026-5c0c-96e6-11ce4ba0f25c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "30" :db/id #edb/ref 17592186406268}] :answer-field/correct {:db/id #edb/ref 17592186406268} :answer-field/id #uuid "7617d22e-b009-544a-bfad-dfef4a1e84ff" :answer-field/key "divg" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406059} {:answer-field/choices [{:answer/id #uuid "e01caf60-0d3e-50f8-b031-f4eb32bad154" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "30" :db/id #edb/ref 17592186406265}] :answer-field/correct {:db/id #edb/ref 17592186406265} :answer-field/id #uuid "b5611a0a-9fa8-5cd2-9a26-e922e5e3f27a" :answer-field/key "divf" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406184}] :question/id #uuid "20de299a-3d32-54ca-bfc6-cf1c6e597332" :question/problem "Find both divergences.\n\n$\\nabla\\cdot\\mathbf F=$ {{divf}}.\n\n$\\nabla\\cdot\\mathbf G=$ {{divg}}." :question/worked-solution "Div F=7+3+20=30 and div G=19+5+6=30. The terms 11x and 5y in the third components vanish when differentiated with respect to z."}] [[:answer/id #uuid "dd5b4475-1daa-57b7-820d-faef46020c84"] {:answer/feedback "The divergence theorem gives each outward flux as 30·Volume(E), so they are equal for every eligible solid. Different component functions need not produce different total fluxes when their divergences agree." :answer/id #uuid "dd5b4475-1daa-57b7-820d-faef46020c84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS=\\iint_S\\mathbf G\\cdot\\mathbf n\\,dS" :db/id #edb/ref 17592186406258}] [[:answer/id #uuid "1db3b31f-45e9-5533-95c1-85590e70439c"] {:answer/feedback "Both divergences are identically 30. The volume changes both fluxes by the same amount, so the equality holds for every such S." :answer/id #uuid "1db3b31f-45e9-5533-95c1-85590e70439c" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The relation depends on the surface S." :db/id #edb/ref 17592186405890}] [[:answer/id #uuid "f129241e-91a4-583a-8f23-824d3688a2dd"] {:answer/fe