[[[:tutorial/id #uuid "fb2e578a-cebf-5e22-aee7-ab14b49bddf4"] {:db/id #edb/ref 17592186405826 :tutorial/content "Date: 2026-09-29\nDue: 2026-09-29\n\nSource: [Original worksheet](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F255%2FR1%2F255-R1.pdf)\n\n## Instructions\n\nRecitation worksheets are graded for completeness. Complete the worksheet on the printed pages, digitally on the PDF, or on your own paper with the same problem layout. Submit a single PDF to Gradescope under **Recitation Worksheet 1**, with the cover page followed by one page per problem, including blank problems. If a solution spans multiple pages, merge those pages into a single page for that problem. See the original PDF for the full submission instructions.\n\nStudy answers, explanations, and reference graphics are authored additions to the linked source." :tutorial/id #uuid "fb2e578a-cebf-5e22-aee7-ab14b49bddf4" :tutorial/title "Assignment information"}] [[:answer/id #uuid "c5341ad1-4278-52c0-83c8-f0bf9f6eab8e"] {:answer/id #uuid "c5341ad1-4278-52c0-83c8-f0bf9f6eab8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-4/sqrt(3)" :db/id #edb/ref 17592186406212}] [[:answer-field/id #uuid "bd035edb-ff84-5bf6-a775-e8b3a4d661d7"] {:answer-field/choices [{:answer/id #uuid "c5341ad1-4278-52c0-83c8-f0bf9f6eab8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-4/sqrt(3)" :db/id #edb/ref 17592186406212}] :answer-field/correct {:db/id #edb/ref 17592186406212} :answer-field/id #uuid "bd035edb-ff84-5bf6-a775-e8b3a4d661d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406196}] [[:question/id #uuid "f15adcb9-fdf3-562e-a671-9c4b91b63f9d"] {:db/id #edb/ref 17592186405798 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5341ad1-4278-52c0-83c8-f0bf9f6eab8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-4/sqrt(3)" :db/id #edb/ref 17592186406212}] :answer-field/correct {:db/id #edb/ref 17592186406212} :answer-field/id #uuid "bd035edb-ff84-5bf6-a775-e8b3a4d661d7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406196}] :question/id #uuid "f15adcb9-fdf3-562e-a671-9c4b91b63f9d" :question/problem "**Question 1 — Part A**\n\nFind the rate of change of the voltage at $P$ in the direction of $\\mathbf v$.\n\nRate: {{field-1}}." :question/worked-solution "$\\nabla V=\\langle3x^2-5y+yz,-5x+xz,xy\\rangle$, so $\\nabla V(P)=\\langle12,0,16\\rangle$. Normalize the given direction: $\\mathbf u=\\langle1,1,-1\\rangle/\\sqrt3$. Then $D_{\\mathbf u}V=\\nabla V(P)\\cdot\\mathbf u=(12-16)/\\sqrt3=-4/\\sqrt3$. The negative sign means voltage decreases in that direction."}] [[:answer/id #uuid "d3a0ab6d-808d-5a2c-83be-9ffd834224f2"] {:answer/id #uuid "d3a0ab6d-808d-5a2c-83be-9ffd834224f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "20" :db/id #edb/ref 17592186406239}] [[:answer-field/id #uuid "4d639057-fa5d-557f-b585-8530053e00b6"] {:answer-field/choices [{:answer/id #uuid "d3a0ab6d-808d-5a2c-83be-9ffd834224f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "20" :db/id #edb/ref 17592186406239}] :answer-field/correct {:db/id #edb/ref 17592186406239} :answer-field/id #uuid "4d639057-fa5d-557f-b585-8530053e00b6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405993}] [[:question/id #uuid "3a79ded3-4b07-5789-80aa-ca3c4678dc65"] {:db/id #edb/ref 17592186405224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3a0ab6d-808d-5a2c-83be-9ffd834224f2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "20" :db/id #edb/ref 17592186406239}] :answer-field/correct {:db/id #edb/ref 17592186406239} :answer-field/id #uuid "4d639057-fa5d-557f-b585-8530053e00b6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405993}] :question/id #uuid "3a79ded3-4b07-5789-80aa-ca3c4678dc65" :question/problem "**Question 1 — Part B**\n\nWhat is the maximum rate of change of the voltage at $P$?\n\nMaximum rate: {{field-1}}." :question/worked-solution "The largest directional derivative is $\\|\\nabla V(P)\\|=\\sqrt{12^2+0^2+16^2}=20$, by Cauchy–Schwarz for unit directions."}] [[:answer/id #uuid "fcc50e30-285d-5d8d-9a57-5d5accb351d1"] {:answer/id #uuid "fcc50e30-285d-5d8d-9a57-5d5accb351d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(3/5,0,4/5)" :db/id #edb/ref 17592186406330}] [[:answer-field/id #uuid "62db2b34-110c-5e53-9239-26a8a97cf76e"] {:answer-field/choices [{:answer/id #uuid "fcc50e30-285d-5d8d-9a57-5d5accb351d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(3/5,0,4/5)" :db/id #edb/ref 17592186406330}] :answer-field/correct {:db/id #edb/ref 17592186406330} :answer-field/id #uuid "62db2b34-110c-5e53-9239-26a8a97cf76e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406026}] [[:answer/id #uuid "79ee08b3-94ea-557a-b17c-4d87b4bbaf6c"] {:answer/id #uuid "79ee08b3-94ea-557a-b17c-4d87b4bbaf6c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-3/5,0,-4/5)" :db/id #edb/ref 17592186406064}] [[:answer-field/id #uuid "f95e8f5f-8161-5d51-b930-e52eb23e8b7f"] {:answer-field/choices [{:answer/id #uuid "79ee08b3-94ea-557a-b17c-4d87b4bbaf6c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-3/5,0,-4/5)" :db/id #edb/ref 17592186406064}] :answer-field/correct {:db/id #edb/ref 17592186406064} :answer-field/id #uuid "f95e8f5f-8161-5d51-b930-e52eb23e8b7f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406316}] [[:question/id #uuid "993ff6df-13ee-5888-9f6a-38f0ce68a202"] {:db/id #edb/ref 17592186405525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fcc50e30-285d-5d8d-9a57-5d5accb351d1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(3/5,0,4/5)" :db/id #edb/ref 17592186406330}] :answer-field/correct {:db/id #edb/ref 17592186406330} :answer-field/id #uuid "62db2b34-110c-5e53-9239-26a8a97cf76e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406026} {:answer-field/choices [{:answer/id #uuid "79ee08b3-94ea-557a-b17c-4d87b4bbaf6c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-3/5,0,-4/5)" :db/id #edb/ref 17592186406064}] :answer-field/correct {:db/id #edb/ref 17592186406064} :answer-field/id #uuid "f95e8f5f-8161-5d51-b930-e52eb23e8b7f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406316}] :question/id #uuid "993ff6df-13ee-5888-9f6a-38f0ce68a202" :question/problem "**Question 1 — Part C**\n\nIn which direction does the voltage increase/decrease most rapidly at $P$?\n\nUnit direction of fastest increase: {{field-1}}.\n\nUnit direction of fastest decrease: {{field-2}}." :question/worked-solution "Normalize $\\langle12,0,16\\rangle$ by its magnitude $20$ for increase. Negate it for decrease. Their directional derivatives are respectively $20$ and $-20$."}] [[:question/id #uuid "c727d611-c655-5cc6-b14c-49e9e6d8a48d"] {:db/id #edb/ref 17592186405665 :question/id #uuid "c727d611-c655-5cc6-b14c-49e9e6d8a48d" :question/problem "**Question 1 — Part D**\n\nGive two orthogonal directions in which the rate of change of the voltage at $P$ is $0$." :question/worked-solution "One pair is $\\mathbf u=\\langle0,1,0\\rangle$ and $\\mathbf v=\\langle4/5,0,-3/5\\rangle$. They are unit vectors, $\\mathbf u\\cdot\\mathbf v=0$, and each has dot product zero with $\\nabla V(P)=\\langle12,0,16\\rangle$. Other orthogonal unit pairs in this plane are valid.\n\nZero change means $12u_x+16u_z=0$. Choose two independent directions in that plane, then check their mutual orthogonality as well as their orthogonality to the gradient. Merely choosing a vector and its negative does not give an orthogonal pair."}] [[:step/id #uuid "e16d8b4e-203f-5b3d-957a-5b0ffe692774"] {:db/id #edb/ref 17592186405750 :step/content {:db/id #edb/ref 17592186405798} :step/id #uuid "e16d8b4e-203f-5b3d-957a-5b0ffe692774" :step/next {:db/id #edb/ref 17592186405755}}] [[:step/id #uuid "e2e50cce-a68f-55c9-ba58-a9eebf4278ac"] {:db/id #edb/ref 17592186405755 :step/content {:db/id #edb/ref 17592186405224} :step/id #uuid "e2e50cce-a68f-55c9-ba58-a9eebf4278ac" :step/next {:db/id #edb/ref 17592186405829}}] [[:step/id #uuid "fba15544-dc64-5de9-ae9a-da36e00a9978"] {:db/id #edb/ref 17592186405829 :step/content {:db/id #edb/ref 17592186405525} :step/id #uuid "fba15544-dc64-5de9-ae9a-da36e00a9978" :step/next {:db/id #edb/ref 17592186405332}}] [[:step/id #uuid "5d2833ea-bdc5-5197-aaa7-5dd6c12a331c"] {:db/id #edb/ref 17592186405332 :step/content {:db/id #edb/ref 17592186405665} :step/id #uuid "5d2833ea-bdc5-5197-aaa7-5dd6c12a331c"}] [[:multistep/id #uuid "bc124f4a-6fac-5bac-8188-819201405a8d"] {:db/id #edb/ref 17592186405636 :multistep/context "Source question: 1.\n\nThe electrical voltage in some 3D region is given by\n\n$$\nV(x,y,z)=x^3-5xy+xyz.\n$$\n\nConsider $P(2,8,5)$ and $\\mathbf v=\\langle 1,1,-1\\rangle$." :multistep/first-step {:db/id #edb/ref 17592186405750} :multistep/id #uuid "bc124f4a-6fac-5bac-8188-819201405a8d" :multistep/steps [{:db/id #edb/ref 17592186405332 :step/content {:db/id #edb/ref 17592186405665} :step/id #uuid "5d2833ea-bdc5-5197-aaa7-5dd6c12a331c"} {:db/id #edb/ref 17592186405750 :step/content {:db/id #edb/ref 17592186405798} :step/id #uuid "e16d8b4e-203f-5b3d-957a-5b0ffe692774" :step/next {:db/id #edb/ref 17592186405755}} {:db/id #edb/ref 17592186405755 :step/content {:db/id #edb/ref 17592186405224} :step/id #uuid "e2e50cce-a68f-55c9-ba58-a9eebf4278ac" :step/next {:db/id #edb/ref 17592186405829}} {:db/id #edb/ref 17592186405829 :step/content {:db/id #edb/ref 17592186405525} :step/id #uuid "fba15544-dc64-5de9-ae9a-da36e00a9978" :step/next {:db/id #edb/ref 17592186405332}}]}] [[:assigned-problem/id #uuid "0bd0446d-754d-57ba-8f1a-313d3045ef6f"] {:assigned-problem/content {:db/id #edb/ref 17592186405636} :assigned-problem/id #uuid "0bd0446d-754d-57ba-8f1a-313d3045ef6f" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048960} {:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050561}] :db/id #edb/ref 17592186405086}] [[:answer/id #uuid "82f52b6c-975f-5e8d-881f-d945ba561342"] {:answer/id #uuid "82f52b6c-975f-5e8d-881f-d945ba561342" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(3,4,5tan(t))" :db/id #edb/ref 17592186406088}] [[:answer-field/id #uuid "1189cd3e-a922-5beb-929d-d975188f3a20"] {:answer-field/choices [{:answer/id #uuid "82f52b6c-975f-5e8d-881f-d945ba561342" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(3,4,5tan(t))" :db/id #edb/ref 17592186406088}] :answer-field/correct {:db/id #edb/ref 17592186406088} :answer-field/id #uuid "1189cd3e-a922-5beb-929d-d975188f3a20" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405864}] [[:question/id #uuid "700ccd4c-2830-5ef7-a43a-6a74ddcf99c3"] {:db/id #edb/ref 17592186405399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82f52b6c-975f-5e8d-881f-d945ba561342" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(3,4,5tan(t))" :db/id #edb/ref 17592186406088}] :answer-field/correct {:db/id #edb/ref 17592186406088} :answer-field/id #uuid "1189cd3e-a922-5beb-929d-d975188f3a20" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405864}] :question/id #uuid "700ccd4c-2830-5ef7-a43a-6a74ddcf99c3" :question/problem "**Question 2 — Part A**\n\nFind\n\n$$\n\\frac{d\\mathbf r}{dt}=\\mathbf r'(t)=\\langle x'(t),y'(t),z'(t)\\rangle.\n$$\n\n$\\mathbf r\\,\\prime(t)=$ {{field-1}}." :question/worked-solution "Differentiate each component. In particular, $(\\ln\\sec t)\\prime=\\sec t\\tan t/\\sec t=\\tan t$ wherever the real-valued logarithm is defined."}] [[:question/id #uuid "0a9b777c-4f52-5acd-ad72-f0011ed22156"] {:db/id #edb/ref 17592186405083 :question/id #uuid "0a9b777c-4f52-5acd-ad72-f0011ed22156" :question/problem "**Question 2 — Part B**\n\nFind $d\\mathbf r=\\langle dx,dy,dz\\rangle$ (in terms of $dt$)." :question/worked-solution "$d\\mathbf r=\\langle3,4,5\\tan t\\rangle\\,dt$, so $dx=3\\,dt$, $dy=4\\,dt$, and $dz=5\\tan t\\,dt$.\n\nThe vector differential is $\\mathbf r\\,\\prime(t)\\,dt$. The same scalar increment $dt$ multiplies every component; it is not a fourth component."}] [[:question/id #uuid "101dfad0-8dd2-541a-be72-28b8ba7ed9a6"] {:db/id #edb/ref 17592186405096 :question/id #uuid "101dfad0-8dd2-541a-be72-28b8ba7ed9a6" :question/problem "**Question 2 — Part C**\n\nFind the differential arc length $ds=|d\\mathbf r|$ (in terms of $dt$)." :question/worked-solution "$ds=5|\\sec t|\\,|dt|$. On the interval $0\\le t\\le\\pi/3$, with increasing $t$, this is $ds=5\\sec t\\,dt$.\n\n$|d\\mathbf r|=\\sqrt{3^2+4^2+25\\tan^2t}\\,|dt|=5\\sqrt{1+\\tan^2t}\\,|dt|=5|\\sec t|\\,|dt|$. The absolute values express the nonnegative length element."}] [[:answer/id #uuid "59c39d2d-59ef-53e5-bd14-9167e516ec59"] {:answer/id #uuid "59c39d2d-59ef-53e5-bd14-9167e516ec59" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5ln(2+sqrt(3))" :db/id #edb/ref 17592186406013}] [[:answer-field/id #uuid "1a650772-f89d-5434-9e3d-58b22002036e"] {:answer-field/choices [{:answer/id #uuid "59c39d2d-59ef-53e5-bd14-9167e516ec59" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5ln(2+sqrt(3))" :db/id #edb/ref 17592186406013}] :answer-field/correct {:db/id #edb/ref 17592186406013} :answer-field/id #uuid "1a650772-f89d-5434-9e3d-58b22002036e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405884}] [[:question/id #uuid "b42a9d0a-cca4-516d-8620-0f708ba5e1cb"] {:db/id #edb/ref 17592186405603 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59c39d2d-59ef-53e5-bd14-9167e516ec59" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "5ln(2+sqrt(3))" :db/id #edb/ref 17592186406013}] :answer-field/correct {:db/id #edb/ref 17592186406013} :answer-field/id #uuid "1a650772-f89d-5434-9e3d-58b22002036e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405884}] :question/id #uuid "b42a9d0a-cca4-516d-8620-0f708ba5e1cb" :question/problem "**Question 2 — Part D**\n\nFind the arc length from $t=0$ to $t=\\frac{\\pi}{3}$.\n\nArc length: {{field-1}}." :question/worked-solution "$L=\\int_0^{\\pi/3}5\\sec t\\,dt=5[\\ln|\\sec t+\\tan t|]_0^{\\pi/3}=5\\ln(2+\\sqrt3)$. The integrand is positive throughout the interval."}] [[:step/id #uuid "94556729-3a5a-5d93-9aad-a34d17641f08"] {:db/id #edb/ref 17592186405516 :step/content {:db/id #edb/ref 17592186405399} :step/id #uuid "94556729-3a5a-5d93-9aad-a34d17641f08" :step/next {:db/id #edb/ref 17592186405257}}] [[:step/id #uuid "4260a7a8-0c0f-5b53-b212-2ef38df928b5"] {:db/id #edb/ref 17592186405257 :step/content {:db/id #edb/ref 17592186405083} :step/id #uuid "4260a7a8-0c0f-5b53-b212-2ef38df928b5" :step/next {:db/id #edb/ref 17592186405658}}] [[:step/id #uuid "c60b7f3d-1eb4-5010-a17a-dbab803a86b5"] {:db/id #edb/ref 17592186405658 :step/content {:db/id #edb/ref 17592186405096} :step/id #uuid "c60b7f3d-1eb4-5010-a17a-dbab803a86b5" :step/next {:db/id #edb/ref 17592186405489}}] [[:step/id #uuid "8bce52f4-560c-5f2a-a011-142eea67431a"] {:db/id #edb/ref 17592186405489 :step/content {:db/id #edb/ref 17592186405603} :step/id #uuid "8bce52f4-560c-5f2a-a011-142eea67431a"}] [[:multistep/id #uuid "5729a5c0-155c-5d48-8a99-c052c7c857f4"] {:db/id #edb/ref 17592186405316 :multistep/context "Source question: 2.\n\nConsider the space curve\n\n$$\n\\mathbf r(t)=\\langle x(t),y(t),z(t)\\rangle\n=\\langle 3t,4t,5\\ln\\sec t\\rangle.\n$$" :multistep/first-step {:db/id #edb/ref 17592186405516} :multistep/id #uuid "5729a5c0-155c-5d48-8a99-c052c7c857f4" :multistep/steps [{:db/id #edb/ref 17592186405257 :step/content {:db/id #edb/ref 17592186405083} :step/id #uuid "4260a7a8-0c0f-5b53-b212-2ef38df928b5" :step/next {:db/id #edb/ref 17592186405658}} {:db/id #edb/ref 17592186405489 :step/content {:db/id #edb/ref 17592186405603} :step/id #uuid "8bce52f4-560c-5f2a-a011-142eea67431a"} {:db/id #edb/ref 17592186405516 :step/content {:db/id #edb/ref 17592186405399} :step/id #uuid "94556729-3a5a-5d93-9aad-a34d17641f08" :step/next {:db/id #edb/ref 17592186405257}} {:db/id #edb/ref 17592186405658 :step/content {:db/id #edb/ref 17592186405096} :step/id #uuid "c60b7f3d-1eb4-5010-a17a-dbab803a86b5" :step/next {:db/id #edb/ref 17592186405489}}]}] [[:assigned-problem/id #uuid "5b19ab97-b57a-5a0a-a0d6-25b4a8bea932"] {:assigned-problem/content {:db/id #edb/ref 17592186405316} :assigned-problem/id #uuid "5b19ab97-b57a-5a0a-a0d6-25b4a8bea932" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048239} {:db/id #edb/ref 17592186048424} {:db/id #edb/ref 17592186051090}] :db/id #edb/ref 17592186405327}] [[:answer/id #uuid "3e7e6c73-cd82-5ce0-bd16-4dc0fb780b86"] {:answer/id #uuid "3e7e6c73-cd82-5ce0-bd16-4dc0fb780b86" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "pi*sqrt(3)/3-1/2+ln(2)/3" :db/id #edb/ref 17592186405952}] [[:answer-field/id #uuid "52fb4932-5293-5dd6-a5d1-af022dcb652d"] {:answer-field/choices [{:answer/id #uuid "3e7e6c73-cd82-5ce0-bd16-4dc0fb780b86" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "pi*sqrt(3)/3-1/2+ln(2)/3" :db/id #edb/ref 17592186405952}] :answer-field/correct {:db/id #edb/ref 17592186405952} :answer-field/id #uuid "52fb4932-5293-5dd6-a5d1-af022dcb652d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406002}] [[:question/id #uuid "22d488a9-44de-5413-ab9f-6ebef1a36d31"] {:db/id #edb/ref 17592186405145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e7e6c73-cd82-5ce0-bd16-4dc0fb780b86" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "pi*sqrt(3)/3-1/2+ln(2)/3" :db/id #edb/ref 17592186405952}] :answer-field/correct {:db/id #edb/ref 17592186405952} :answer-field/id #uuid "52fb4932-5293-5dd6-a5d1-af022dcb652d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406002}] :question/id #uuid "22d488a9-44de-5413-ab9f-6ebef1a36d31" :question/problem "**Question 3 — Part A**\n\nUse polar coordinates to evaluate\n\n$$\n\\int_0^{\\sqrt{3}}\\int_1^{\\sqrt{4-y^2}}\n\\sqrt{x^2+y^2-1}\\,dx\\,dy.\n$$\n\nIntegral: {{field-1}}." :question/worked-solution "The region is the first-quadrant portion of $r\\le2$ with $x\\ge1$. Thus $0\\le\\theta\\le\\pi/3$ and $\\sec\\theta\\le r\\le2$. Including the Jacobian, the integral is $\\int_0^{\\pi/3}\\int_{\\sec\\theta}^2 r\\sqrt{r^2-1}\\,dr\\,d\\theta=\\frac13\\int_0^{\\pi/3}(3\\sqrt3-\\tan^3\\theta)\\,d\\theta$. Since $\\int\\tan^3\\theta\\,d\\theta=\\tfrac12\\tan^2\\theta+\\ln|\\cos\\theta|$, its value is $\\pi\\sqrt3/3-1/2+\\ln2/3$."}] [[:answer/id #uuid "54c693b2-1929-53b1-8b63-30ea85adc803"] {:answer/id #uuid "54c693b2-1929-53b1-8b63-30ea85adc803" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "pi/4" :db/id #edb/ref 17592186406005}] [[:answer-field/id #uuid "f6c2b6a6-fa6d-53b9-a5b4-c1cc16d67042"] {:answer-field/choices [{:answer/id #uuid "54c693b2-1929-53b1-8b63-30ea85adc803" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "pi/4" :db/id #edb/ref 17592186406005}] :answer-field/correct {:db/id #edb/ref 17592186406005} :answer-field/id #uuid "f6c2b6a6-fa6d-53b9-a5b4-c1cc16d67042" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406309}] [[:answer/id #uuid "e9236017-71f4-5bf8-8e95-54cbe8313df4"] {:answer/id #uuid "e9236017-71f4-5bf8-8e95-54cbe8313df4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "sqrt(pi)/2" :db/id #edb/ref 17592186406280}] [[:answer-field/id #uuid "ecbcf84a-1d75-5a43-8f4f-56d034364a30"] {:answer-field/choices [{:answer/id #uuid "e9236017-71f4-5bf8-8e95-54cbe8313df4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "sqrt(pi)/2" :db/id #edb/ref 17592186406280}] :answer-field/correct {:db/id #edb/ref 17592186406280} :answer-field/id #uuid "ecbcf84a-1d75-5a43-8f4f-56d034364a30" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406286}] [[:answer/id #uuid "a179cc1e-9377-5231-a1e3-3410976b707c"] {:answer/id #uuid "a179cc1e-9377-5231-a1e3-3410976b707c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "sqrt(pi)" :db/id #edb/ref 17592186406147}] [[:answer-field/id #uuid "29c7f5c3-da49-5769-8135-a93fe127b8ac"] {:answer-field/choices [{:answer/id #uuid "a179cc1e-9377-5231-a1e3-3410976b707c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "sqrt(pi)" :db/id #edb/ref 17592186406147}] :answer-field/correct {:db/id #edb/ref 17592186406147} :answer-field/id #uuid "29c7f5c3-da49-5769-8135-a93fe127b8ac" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405916}] [[:question/id #uuid "ca6efe45-1e34-528b-98ca-b08851ed0a7e"] {:db/id #edb/ref 17592186405675 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a179cc1e-9377-5231-a1e3-3410976b707c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "sqrt(pi)" :db/id #edb/ref 17592186406147}] :answer-field/correct {:db/id #edb/ref 17592186406147} :answer-field/id #uuid "29c7f5c3-da49-5769-8135-a93fe127b8ac" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405916} {:answer-field/choices [{:answer/id #uuid "e9236017-71f4-5bf8-8e95-54cbe8313df4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "sqrt(pi)/2" :db/id #edb/ref 17592186406280}] :answer-field/correct {:db/id #edb/ref 17592186406280} :answer-field/id #uuid "ecbcf84a-1d75-5a43-8f4f-56d034364a30" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406286} {:answer-field/choices [{:answer/id #uuid "54c693b2-1929-53b1-8b63-30ea85adc803" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "pi/4" :db/id #edb/ref 17592186406005}] :answer-field/correct {:db/id #edb/ref 17592186406005} :answer-field/id #uuid "f6c2b6a6-fa6d-53b9-a5b4-c1cc16d67042" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406309}] :question/id #uuid "ca6efe45-1e34-528b-98ca-b08851ed0a7e" :question/problem "**Question 3 — Part B**\n\nUse polar coordinates to evaluate\n\n$$\n\\int_0^\\infty\\int_0^\\infty e^{-x^2-y^2}\\,dy\\,dx.\n$$\n\nWhat does this say about $\\displaystyle\\int_0^\\infty e^{-x^2}\\,dx$? How about $\\displaystyle\\int_{-\\infty}^\\infty e^{-x^2}\\,dx$?\n\nDouble integral: {{field-1}}.\n\n$\\int_0^\\infty e^{-x^2}\\,dx=$ {{field-2}}.\n\n$\\int_{-\\infty}^\\infty e^{-x^2}\\,dx=$ {{field-3}}." :question/worked-solution "The first quadrant becomes $0\\le\\theta\\le\\pi/2$, $r\\ge0$. The double integral is $\\int_0^{\\pi/2}\\int_0^\\infty e^{-r^2}r\\,dr\\,d\\theta=(\\pi/2)(1/2)=\\pi/4$. Because the nonnegative integrand factors as $e^{-x^2}e^{-y^2}$, this equals $I^2$ where $I=\\int_0^\\infty e^{-x^2}\\,dx>0$. Hence $I=\\sqrt\\pi/2$. Evenness doubles it on the real line."}] [[:step/id #uuid "cf9a956c-a3c0-5013-88d8-c23a69c30128"] {:db/id #edb/ref 17592186405689 :step/content {:db/id #edb/ref 17592186405145} :step/id #uuid "cf9a956c-a3c0-5013-88d8-c23a69c30128" :step/next {:db/id #edb/ref 17592186405212}}] [[:step/id #uuid "3712dea9-ed24-5d95-ae4a-f097f40d967c"] {:db/id #edb/ref 17592186405212 :step/content {:db/id #edb/ref 17592186405675} :step/id #uuid "3712dea9-ed24-5d95-ae4a-f097f40d967c"}] [[:multistep/id #uuid "056ef53c-025c-521f-8d9f-19aaa38a2c86"] {:db/id #edb/ref 17592186405068 :multistep/context "Source question: 3." :multistep/first-step {:db/id #edb/ref 17592186405689} :multistep/id #uuid "056ef53c-025c-521f-8d9f-19aaa38a2c86" :multistep/steps [{:db/id #edb/ref 17592186405212 :step/content {:db/id #edb/ref 17592186405675} :step/id #uuid "3712dea9-ed24-5d95-ae4a-f097f40d967c"} {:db/id #edb/ref 17592186405689 :step/content {:db/id #edb/ref 17592186405145} :step/id #uuid "cf9a956c-a3c0-5013-88d8-c23a69c30128" :step/next {:db/id #edb/ref 17592186405212}}]}] [[:assigned-problem/id #uuid "d19d6430-b467-59eb-bb30-e7e16af7e002"] {:assigned-problem/content {:db/id #edb/ref 17592186405068} :assigned-problem/id #uuid "d19d6430-b467-59eb-bb30-e7e16af7e002" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049090} {:db/id #edb/ref 17592186049487} {:db/id #edb/ref 17592186051022}] :db/id #edb/ref 17592186405696}] [[:question/id #uuid "3b5a5cc9-b23c-5e50-8e56-9a1731ec22f0"] {:db/id #edb/ref 17592186405225 :question/id #uuid "3b5a5cc9-b23c-5e50-8e56-9a1731ec22f0" :question/problem "**Question 4 — Part A**\n\nThere is a helix in the room with parameterization\n\n$$\n\\langle x,y,z\\rangle=\\langle\\cos t,\\sin t,t\\rangle.\n$$\n\nUse chain rule to find $\\dfrac{dw}{dt}$. Reflect on whether your answer makes sense." :question/worked-solution "By the chain rule, $dw/dt=2x(-\\sin t)+2y\\cos t+2z=2\\cos t(-\\sin t)+2\\sin t\\cos t+2t=2t$. This makes sense because on the helix $w=1+t^2$: the circular motion leaves $x^2+y^2$ unchanged while height changes.\n\nInclude all three coordinate contributions. Substituting into $w$ first gives an independent check, but the requested derivation should explicitly use the chain rule."}] [[:question/id #uuid "4167989d-ba81-5251-9167-13ec920ddaca"] {:db/id #edb/ref 17592186405253 :question/id #uuid "4167989d-ba81-5251-9167-13ec920ddaca" :question/problem "**Question 4 — Part B**\n\nThere is a cone in the room with parameterization\n\n$$\n\\langle x,y,z\\rangle=\\langle r\\cos\\theta,r\\sin\\theta,r\\rangle.\n$$\n\nUse chain rule to find $\\dfrac{\\partial w}{\\partial r}$ and $\\dfrac{\\partial w}{\\partial\\theta}$. Reflect on whether your answers make sense." :question/worked-solution "$w_r=2x\\cos\\theta+2y\\sin\\theta+2z=4r$. Also $w_\\theta=2x(-r\\sin\\theta)+2y(r\\cos\\theta)+2z(0)=0$. On the cone $w=2r^2$, so it increases with radius and is independent of the angular coordinate.\n\nFor $w_r$, the $z=r$ coordinate contributes another $2r$. For $w_\\theta$, the sine/cosine terms cancel. Hold the other parameter fixed for each partial derivative."}] [[:step/id #uuid "a2596300-d6d9-5edb-b67a-d8e367612e2e"] {:db/id #edb/ref 17592186405555 :step/content {:db/id #edb/ref 17592186405225} :step/id #uuid "a2596300-d6d9-5edb-b67a-d8e367612e2e" :step/next {:db/id #edb/ref 17592186405110}}] [[:step/id #uuid "17eafedd-08c9-50d1-b9bd-6e33688b0e53"] {:db/id #edb/ref 17592186405110 :step/content {:db/id #edb/ref 17592186405253} :step/id #uuid "17eafedd-08c9-50d1-b9bd-6e33688b0e53"}] [[:multistep/id #uuid "f3be8c40-72a0-544b-a839-8210545fba3b"] {:db/id #edb/ref 17592186405806 :multistep/context "Source question: 4.\n\nThe temperature in a room is given by the function\n\n$$\nw=f(x,y,z)=x^2+y^2+z^2.\n$$" :multistep/first-step {:db/id #edb/ref 17592186405555} :multistep/id #uuid "f3be8c40-72a0-544b-a839-8210545fba3b" :multistep/steps [{:db/id #edb/ref 17592186405110 :step/content {:db/id #edb/ref 17592186405253} :step/id #uuid "17eafedd-08c9-50d1-b9bd-6e33688b0e53"} {:db/id #edb/ref 17592186405555 :step/content {:db/id #edb/ref 17592186405225} :step/id #uuid "a2596300-d6d9-5edb-b67a-d8e367612e2e" :step/next {:db/id #edb/ref 17592186405110}}]}] [[:assigned-problem/id #uuid "3fb3d0b7-62c7-5189-95dc-fee0bc320b2a"] {:assigned-problem/content {:db/id #edb/ref 17592186405806} :assigned-problem/id #uuid "3fb3d0b7-62c7-5189-95dc-fee0bc320b2a" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048239} {:db/id #edb/ref 17592186048641} {:db/id #edb/ref 17592186049261} {:db/id #edb/ref 17592186050037} {:db/id #edb/ref 17592186050149}] :db/id #edb/ref 17592186405242}] [[:question/id #uuid "58dee5b5-8a4b-592d-bde6-a58086d626eb"] {:db/id #edb/ref 17592186405318 :question/id #uuid "58dee5b5-8a4b-592d-bde6-a58086d626eb" :question/problem "Source question: 5.\n\n**Question 5**\n\nThe temperature in a room is given by the function\n\n$$\nw=f(x,y,z)=x^2+y^2+z^2.\n$$\n\nThere is a sphere in the room with parameterization\n\n$$\n\\langle x,y,z\\rangle\n=\\langle\\rho\\sin\\phi\\cos\\theta,\\rho\\sin\\phi\\sin\\theta,\\rho\\cos\\phi\\rangle.\n$$\n\nUse chain rule to find $\\dfrac{\\partial w}{\\partial\\rho}$, $\\dfrac{\\partial w}{\\partial\\phi}$, and $\\dfrac{\\partial w}{\\partial\\theta}$. Reflect on whether your answers make sense." :question/worked-solution "With $\\mathbf r=\\langle\\rho\\sin\\phi\\cos\\theta,\\rho\\sin\\phi\\sin\\theta,\\rho\\cos\\phi\\rangle$, the chain rule gives $w_q=2\\mathbf r\\cdot\\mathbf r_q$. Thus $w_\\rho=2\\rho(\\sin^2\\phi\\cos^2\\theta+\\sin^2\\phi\\sin^2\\theta+\\cos^2\\phi)=2\\rho$. The terms in $w_\\phi=2\\rho^2\\sin\\phi\\cos\\phi(\\cos^2\\theta+\\sin^2\\theta-1)$ cancel, and the terms in $w_\\theta=2\\rho^2\\sin^2\\phi(-\\cos\\theta\\sin\\theta+\\sin\\theta\\cos\\theta)$ cancel. Therefore $w_\\rho=2\\rho$, $w_\\phi=0$, and $w_\\theta=0$. This agrees with $w=\\rho^2$: temperature depends only on distance from the origin.\n\nCompute the coordinate derivatives before taking each dot product. At fixed radius, moving in either angular direction stays on the same sphere and cannot change $x^2+y^2+z^2$."}] [[:assigned-problem/id #uuid "4f5bdf7b-34f1-5e2c-80ae-bdeaf78ef45f"] {:assigned-problem/content {:db/id #edb/ref 17592186405318} :assigned-problem/id #uuid "4f5bdf7b-34f1-5e2c-80ae-bdeaf78ef45f" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048641} {:db/id #edb/ref 17592186050037}] :db/id #edb/ref 17592186405299}] [[:question/id #uuid "02a8dd04-6537-5a0c-b832-3fbc8660a80b"] {:db/id #edb/ref 17592186405054 :question/id #uuid "02a8dd04-6537-5a0c-b832-3fbc8660a80b" :question/problem "**Question 6 — Part A**\n\nGive $D$ as a set of triples in cylindrical coordinates:\n\n$$\nD=\\{(r,\\theta,z)\\mid {?}\\le r\\le {?},\\;{?}\\le\\theta\\le {?},\\;{?}\\le z\\le {?}\\}.\n$$" :question/worked-solution "$D=\\{(r,\\theta,z):a\\le r\\le b,\\ 0\\le\\theta\\le2\\pi,\\ g(r)\\le z\\le f(r)\\}$.\n\nRotation about the $z$-axis replaces the nonnegative horizontal coordinate $x$ by radial distance $r$. One full turn gives the angular range; the lower and upper surfaces retain the original functions evaluated at $r$."}] [[:question/id #uuid "6e013021-17a2-5e93-a708-796917c64419"] {:db/id #edb/ref 17592186405388 :question/id #uuid "6e013021-17a2-5e93-a708-796917c64419" :question/problem "**Question 6 — Part B**\n\nLet $V$ be the volume of $D$. Prove the shell formula:\n\n$$\nV=\\iiint_D dV=2\\pi\\int_a^b\\bigl[xf(x)-xg(x)\\bigr]\\,dx.\n$$" :question/worked-solution "Using the cylindrical volume element $dV=r\\,dz\\,dr\\,d\\theta$,\n\n$$V=\\int_0^{2\\pi}\\int_a^b\\int_{g(r)}^{f(r)}r\\,dz\\,dr\\,d\\theta=2\\pi\\int_a^b r[f(r)-g(r)]\\,dr=2\\pi\\int_a^b[xf(x)-xg(x)]\\,dx.$$\n\nThe last step only renames the dummy variable. As usual, the functions must define an integrable solid of finite volume for this finite-volume formula.\n\nThe factor $r$ is the Jacobian. Integrating over height gives $r(f-g)$, and integrating over the full angle gives $2\\pi$. The assumptions $r\\ge0$ and $f\\ge g$ make the shell contribution nonnegative."}] [[:step/id #uuid "3ddca503-d723-542b-9689-19a1ee35b3e5"] {:db/id #edb/ref 17592186405234 :step/content {:db/id #edb/ref 17592186405054} :step/id #uuid "3ddca503-d723-542b-9689-19a1ee35b3e5" :step/next {:db/id #edb/ref 17592186405602}}] [[:step/id #uuid "b4208474-358d-5f7d-8443-cc7f546d1528"] {:db/id #edb/ref 17592186405602 :step/content {:db/id #edb/ref 17592186405388} :step/id #uuid "b4208474-358d-5f7d-8443-cc7f546d1528"}] [[:multistep/id #uuid "0002af53-81f1-5367-a1e1-4ac77ed1db15"] {:db/id #edb/ref 17592186405046 :multistep/context "Source question: 6.\n\nLet $0\\le a\\le b$ and let $f(x)\\ge g(x)$ on $[a,b]$.\n\nLet $R$ be the region on the $xz$-plane between $z=f(x)$ and $z=g(x)$ over $[a,b]$, and let $D$ be the solid region obtained by rotating $R$ around the $z$-axis." :multistep/first-step {:db/id #edb/ref 17592186405234} :multistep/id #uuid "0002af53-81f1-5367-a1e1-4ac77ed1db15" :multistep/steps [{:db/id #edb/ref 17592186405234 :step/content {:db/id #edb/ref 17592186405054} :step/id #uuid "3ddca503-d723-542b-9689-19a1ee35b3e5" :step/next {:db/id #edb/ref 17592186405602}} {:db/id #edb/ref 17592186405602 :step/content {:db/id #edb/ref 17592186405388} :step/id #uuid "b4208474-358d-5f7d-8443-cc7f546d1528"}]}] [[:assigned-problem/id #uuid "147eb189-7a83-5424-bc98-c405a82a3bb8"] {:assigned-problem/content {:db/id #edb/ref 17592186405046} :assigned-problem/id #uuid "147eb189-7a83-5424-bc98-c405a82a3bb8" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050349}] :db/id #edb/ref 17592186405107}] [[:step/id #uuid "de7015b4-415c-5196-aff3-b73808ad2dde"] {:db/id #edb/ref 17592186405733 :step/content {:db/id #edb/ref 17592186405826} :step/id #uuid "de7015b4-415c-5196-aff3-b73808ad2dde" :step/next {:db/id #edb/ref 17592186405330}}] [[:step/id #uuid "5bdd3bcc-030e-54b3-a3f5-1ff76279f0c5"] {:db/id #edb/ref 17592186405330 :step/content {:db/id #edb/ref 17592186405086} :step/id #uuid "5bdd3bcc-030e-54b3-a3f5-1ff76279f0c5" :step/next {:db/id #edb/ref 17592186405700}}] [[:step/id #uuid "d2d0d0e6-045a-52e5-8404-4ef75dfab311"] {:db/id #edb/ref 17592186405700 :step/content {:db/id #edb/ref 17592186405327} :step/id #uuid "d2d0d0e6-045a-52e5-8404-4ef75dfab311" :step/next {:db/id #edb/ref 17592186405630}}] [[:step/id #uuid "ba8fb377-f0cf-51b6-af00-6b588cf882ed"] {:db/id #edb/ref 17592186405630 :step/content {:db/id #edb/ref 17592186405696} :step/id #uuid "ba8fb377-f0cf-51b6-af00-6b588cf882ed" :step/next {:db/id #edb/ref 17592186405250}}] [[:step/id #uuid "414677d8-a81b-50bd-ae0b-c5479c76deab"] {:db/id #edb/ref 17592186405250 :step/con