hoices [{:answer/id #uuid "6840c443-fdd1-519c-a48e-7833733c717e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "129" :db/id #edb/ref 17592186406035}] :answer-field/correct {:db/id #edb/ref 17592186406035} :answer-field/id #uuid "17f9ea1f-9a0b-5813-af43-76bb234908ba" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405881}] [[:question/id #uuid "25e8cc7f-7b52-55ed-90f3-afc7af8e5d0c"] {:db/id #edb/ref 17592186405158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6840c443-fdd1-519c-a48e-7833733c717e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "129" :db/id #edb/ref 17592186406035}] :answer-field/correct {:db/id #edb/ref 17592186406035} :answer-field/id #uuid "17f9ea1f-9a0b-5813-af43-76bb234908ba" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405881}] :question/id #uuid "25e8cc7f-7b52-55ed-90f3-afc7af8e5d0c" :question/problem "Source question: 1.\n\nUse the **Fundamental Theorem of Line Integrals** to evaluate $\\int_C\\mathbf F\\cdot d\\mathbf r$. The field $\\mathbf F=\\langle6x-3y,20y-3x\\rangle$ is conservative with the supplied potential $f=3x^2-3xy+10y^2$. The piecewise smooth curve joins $(3,-1)$ to $(5,4)$.\n\nIntegral: {{integral}}." :question/worked-solution "$f(5,4)=75-60+160=175$ and $f(3,-1)=27+9+10=46$. Subtract final minus initial: 175−46=129."}] [[:assigned-problem/id #uuid "7db79555-306d-5e13-83a5-81ee7e48d3e2"] {:assigned-problem/content {:db/id #edb/ref 17592186405158} :assigned-problem/id #uuid "7db79555-306d-5e13-83a5-81ee7e48d3e2" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050149}] :db/id #edb/ref 17592186405443}] [[:answer/id #uuid "ceb3bfd7-9112-5d3d-8846-7ea489d5b0f4"] {:answer/id #uuid "ceb3bfd7-9112-5d3d-8846-7ea489d5b0f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-2535" :db/id #edb/ref 17592186406228}] [[:answer-field/id #uuid "28e68615-5984-5e2b-b9b3-5db8bee1b708"] {:answer-field/choices [{:answer/id #uuid "ceb3bfd7-9112-5d3d-8846-7ea489d5b0f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-2535" :db/id #edb/ref 17592186406228}] :answer-field/correct {:db/id #edb/ref 17592186406228} :answer-field/id #uuid "28e68615-5984-5e2b-b9b3-5db8bee1b708" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405913}] [[:question/id #uuid "6e71df8a-2048-5f70-9531-c01214bf86b0"] {:db/id #edb/ref 17592186405389 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ceb3bfd7-9112-5d3d-8846-7ea489d5b0f4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-2535" :db/id #edb/ref 17592186406228}] :answer-field/correct {:db/id #edb/ref 17592186406228} :answer-field/id #uuid "28e68615-5984-5e2b-b9b3-5db8bee1b708" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405913}] :question/id #uuid "6e71df8a-2048-5f70-9531-c01214bf86b0" :question/problem "Source question: 2.\n\nUse the **Fundamental Theorem of Line Integrals** to evaluate $\\int_C\\mathbf F\\cdot d\\mathbf r$. The field $\\mathbf F=\\langle13y^2+26x,26xy\\rangle$ is conservative with the supplied potential $f=13xy^2+13x^2$. The piecewise smooth curve joins $(2,2)$ to $(-3,8)$.\n\nIntegral: {{integral}}." :question/worked-solution "$f(-3,8)=-2496+117=-2379$ and $f(2,2)=104+52=156$. The difference is −2535."}] [[:assigned-problem/id #uuid "f60ce69c-0541-52d0-9cdd-c539f3f72088"] {:assigned-problem/content {:db/id #edb/ref 17592186405389} :assigned-problem/id #uuid "f60ce69c-0541-52d0-9cdd-c539f3f72088" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050149}] :db/id #edb/ref 17592186405813}] [[:answer/id #uuid "aafb02da-8850-5c4b-a298-5ace35d79106"] {:answer/id #uuid "aafb02da-8850-5c4b-a298-5ace35d79106" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e^9-1" :db/id #edb/ref 17592186406165}] [[:answer-field/id #uuid "1713d70e-2f2b-5707-ad9b-3166a871ddfd"] {:answer-field/choices [{:answer/id #uuid "aafb02da-8850-5c4b-a298-5ace35d79106" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e^9-1" :db/id #edb/ref 17592186406165}] :answer-field/correct {:db/id #edb/ref 17592186406165} :answer-field/id #uuid "1713d70e-2f2b-5707-ad9b-3166a871ddfd" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405877}] [[:question/id #uuid "849d1ca7-6e6d-571a-9244-5dd9c265d746"] {:db/id #edb/ref 17592186405462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aafb02da-8850-5c4b-a298-5ace35d79106" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e^9-1" :db/id #edb/ref 17592186406165}] :answer-field/correct {:db/id #edb/ref 17592186406165} :answer-field/id #uuid "1713d70e-2f2b-5707-ad9b-3166a871ddfd" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405877}] :question/id #uuid "849d1ca7-6e6d-571a-9244-5dd9c265d746" :question/problem "Source question: 3.\n\nUse the **Fundamental Theorem of Line Integrals** to evaluate $\\int_C\\mathbf F\\cdot d\\mathbf r$. The field $\\mathbf F=\\langle14xe^{7x^2+2y^2},4ye^{7x^2+2y^2}\\rangle$ is conservative with the supplied potential $f=e^{7x^2+2y^2}$. The piecewise smooth curve joins $(0,0)$ to $(1,1)$.\n\nIntegral: {{integral}}." :question/worked-solution "The final exponent is 7+2=9 and the initial exponent is 0. Thus f(B)−f(A)=e⁹−1."}] [[:assigned-problem/id #uuid "556e1fb8-43a0-571a-a865-1040ea79a200"] {:assigned-problem/content {:db/id #edb/ref 17592186405462} :assigned-problem/id #uuid "556e1fb8-43a0-571a-a865-1040ea79a200" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050149}] :db/id #edb/ref 17592186405313}] [[:answer/id #uuid "c1facf79-5511-59b8-91dc-8b52e5da3d69"] {:answer/id #uuid "c1facf79-5511-59b8-91dc-8b52e5da3d69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac12\\ln\\frac{557}{93}" :db/id #edb/ref 17592186406206}] [[:answer-field/id #uuid "84976508-d8ea-53d9-b93e-9f9ee254578b"] {:answer-field/choices [{:answer/id #uuid "c1facf79-5511-59b8-91dc-8b52e5da3d69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac12\\ln\\frac{557}{93}" :db/id #edb/ref 17592186406206}] :answer-field/correct {:db/id #edb/ref 17592186406206} :answer-field/id #uuid "84976508-d8ea-53d9-b93e-9f9ee254578b" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406092}] [[:question/id #uuid "740fb150-6096-5941-a88d-25c2d5508769"] {:db/id #edb/ref 17592186405417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1facf79-5511-59b8-91dc-8b52e5da3d69" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac12\\ln\\frac{557}{93}" :db/id #edb/ref 17592186406206}] :answer-field/correct {:db/id #edb/ref 17592186406206} :answer-field/id #uuid "84976508-d8ea-53d9-b93e-9f9ee254578b" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406092}] :question/id #uuid "740fb150-6096-5941-a88d-25c2d5508769" :question/problem "Source question: 4.\n\nUse the **Fundamental Theorem of Line Integrals** to evaluate $\\int_C\\mathbf F\\cdot d\\mathbf r$. The field $\\mathbf F=\\left\\langle\\frac{5x}{5x^2+3y^2},\\frac{3y}{5x^2+3y^2}\\right\\rangle$ is conservative with the supplied potential $f=\\ln\\sqrt{5x^2+3y^2}$. The piecewise smooth curve joins $(3,4)$ to $(5,12)$.\n\nIntegral: {{integral}}." :question/worked-solution "$5(5)^2+3(12)^2=557$ and $5(3)^2+3(4)^2=93$. Thus $f(B)-f(A)=\\ln\\sqrt{557}-\\ln\\sqrt{93}$. The curve is understood to lie in the field domain, excluding the origin."}] [[:assigned-problem/id #uuid "76c352a6-fc05-5d9f-a133-b4533abf0591"] {:assigned-problem/content {:db/id #edb/ref 17592186405417} :assigned-problem/id #uuid "76c352a6-fc05-5d9f-a133-b4533abf0591" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050149}] :db/id #edb/ref 17592186405421}] [[:answer/id #uuid "429d42fc-af94-5855-b872-ac98d342f53a"] {:answer/id #uuid "429d42fc-af94-5855-b872-ac98d342f53a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{448}{3}" :db/id #edb/ref 17592186405964}] [[:answer-field/id #uuid "9546c3c0-eeb0-5b3d-aebe-865312901826"] {:answer-field/choices [{:answer/id #uuid "429d42fc-af94-5855-b872-ac98d342f53a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{448}{3}" :db/id #edb/ref 17592186405964}] :answer-field/correct {:db/id #edb/ref 17592186405964} :answer-field/id #uuid "9546c3c0-eeb0-5b3d-aebe-865312901826" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406117}] [[:question/id #uuid "413f1c89-e850-582d-a37b-4374f78ad053"] {:db/id #edb/ref 17592186405249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "429d42fc-af94-5855-b872-ac98d342f53a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{448}{3}" :db/id #edb/ref 17592186405964}] :answer-field/correct {:db/id #edb/ref 17592186405964} :answer-field/id #uuid "9546c3c0-eeb0-5b3d-aebe-865312901826" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406117}] :question/id #uuid "413f1c89-e850-582d-a37b-4374f78ad053" :question/problem "Source question: 5.\n\nFor the conservative field $\\mathbf F=\\langle7x^2+y^2,2xy+\\sin y\\rangle$, evaluate $\\int_C(7x^2+y^2)dx+(2xy+\\sin y)dy$ from (0,0) to (4,0) along a piecewise smooth curve.\n\nIntegral: {{integral}}." :question/worked-solution "A potential is $f=7x^3/3+xy^2-\\cos y$. Its partial derivatives reproduce the field. Then $f(4,0)-f(0,0)=(448/3-1)-(-1)=448/3$."}] [[:assigned-problem/id #uuid "87b44d53-8c5c-5df6-bac3-1905b40bbe0d"] {:assigned-problem/content {:db/id #edb/ref 17592186405249} :assigned-problem/id #uuid "87b44d53-8c5c-5df6-bac3-1905b40bbe0d" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050875}] :db/id #edb/ref 17592186405476}] [[:answer/id #uuid "45aa1e90-0ca1-5835-863a-78c8e621a239"] {:answer/id #uuid "45aa1e90-0ca1-5835-863a-78c8e621a239" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186405973}] [[:answer-field/id #uuid "4248fb01-fbcd-5faa-baac-0e9f3f8594b7"] {:answer-field/choices [{:answer/id #uuid "45aa1e90-0ca1-5835-863a-78c8e621a239" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186405973}] :answer-field/correct {:db/id #edb/ref 17592186405973} :answer-field/id #uuid "4248fb01-fbcd-5faa-baac-0e9f3f8594b7" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405962}] [[:question/id #uuid "b91c6caf-20c7-506c-b577-b041551f1f6d"] {:db/id #edb/ref 17592186405623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45aa1e90-0ca1-5835-863a-78c8e621a239" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{13}{2}" :db/id #edb/ref 17592186405973}] :answer-field/correct {:db/id #edb/ref 17592186405973} :answer-field/id #uuid "4248fb01-fbcd-5faa-baac-0e9f3f8594b7" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405962}] :question/id #uuid "b91c6caf-20c7-506c-b577-b041551f1f6d" :question/problem "Source question: 6.\n\nFor the conservative field $\\mathbf F=\\langle3x-\\cos y,x\\sin y\\rangle$, evaluate $\\int_C(3x-\\cos y)dx+x\\sin y\\,dy$ from $(1,\\pi/2)$ to $(2,\\pi)$ along a piecewise smooth curve.\n\nIntegral: {{integral}}." :question/worked-solution "A potential is $f=3x^2/2-x\\cos y$. Its gradient is the stated field. The endpoint values are 8 and 3/2, giving 13/2."}] [[:assigned-problem/id #uuid "465bf1fc-94b3-5db7-987a-e65e026f34f5"] {:assigned-problem/content {:db/id #edb/ref 17592186405623} :assigned-problem/id #uuid "465bf1fc-94b3-5db7-987a-e65e026f34f5" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050875}] :db/id #edb/ref 17592186405269}] [[:answer/id #uuid "f2d0c258-6acb-5e71-8ed1-e3fd6af410f6"] {:answer/id #uuid "f2d0c258-6acb-5e71-8ed1-e3fd6af410f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3x^2-5xy+2x+9y+K" :db/id #edb/ref 17592186406297}] [[:answer-field/id #uuid "d33cefc6-619d-5679-9ff6-bff989d15a80"] {:answer-field/choices [{:answer/id #uuid "f2d0c258-6acb-5e71-8ed1-e3fd6af410f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3x^2-5xy+2x+9y+K" :db/id #edb/ref 17592186406297}] :answer-field/correct {:db/id #edb/ref 17592186406297} :answer-field/id #uuid "d33cefc6-619d-5679-9ff6-bff989d15a80" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406238}] [[:question/id #uuid "5baa9f7a-2863-5acb-9cd7-97395d050c8c"] {:db/id #edb/ref 17592186405329 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2d0c258-6acb-5e71-8ed1-e3fd6af410f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3x^2-5xy+2x+9y+K" :db/id #edb/ref 17592186406297}] :answer-field/correct {:db/id #edb/ref 17592186406297} :answer-field/id #uuid "d33cefc6-619d-5679-9ff6-bff989d15a80" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406238}] :question/id #uuid "5baa9f7a-2863-5acb-9cd7-97395d050c8c" :question/problem "Source question: 7.\n\nThe field $\\mathbf F=\\langle6x-5y+2,9-5x\\rangle$ is conservative. Find a potential f. Use K for the arbitrary constant and absorb into K as much as possible.\n\n$f(x,y)=$ {{potential}}." :question/worked-solution "Integrate $f_x=6x-5y+2$ to get $3x^2-5xy+2x+g(y)$. Matching $f_y=9-5x$ gives g′=9, hence g=9y+K. Differentiating both components verifies the result."}] [[:assigned-problem/id #uuid "79dcb780-769d-5936-9a71-d9d802d443c5"] {:assigned-problem/content {:db/id #edb/ref 17592186405329} :assigned-problem/id #uuid "79dcb780-769d-5936-9a71-d9d802d443c5" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050875}] :db/id #edb/ref 17592186405429}] [[:answer/id #uuid "1d7beb83-6810-5ce9-bc16-9f81f6e91847"] {:answer/id #uuid "1d7beb83-6810-5ce9-bc16-9f81f6e91847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x\\ln y+6x^2+K" :db/id #edb/ref 17592186405889}] [[:answer-field/id #uuid "4117bcff-a93b-5ea5-830d-c70ad7554b1a"] {:answer-field/choices [{:answer/id #uuid "1d7beb83-6810-5ce9-bc16-9f81f6e91847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x\\ln y+6x^2+K" :db/id #edb/ref 17592186405889}] :answer-field/correct {:db/id #edb/ref 17592186405889} :answer-field/id #uuid "4117bcff-a93b-5ea5-830d-c70ad7554b1a" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405961}] [[:question/id #uuid "f1c08da6-fd73-585c-82ce-6fe086b59b48"] {:db/id #edb/ref 17592186405802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7beb83-6810-5ce9-bc16-9f81f6e91847" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x\\ln y+6x^2+K" :db/id #edb/ref 17592186405889}] :answer-field/correct {:db/id #edb/ref 17592186405889} :answer-field/id #uuid "4117bcff-a93b-5ea5-830d-c70ad7554b1a" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405961}] :question/id #uuid "f1c08da6-fd73-585c-82ce-6fe086b59b48" :question/problem "Source question: 8.\n\nThe field $\\mathbf F=\\langle\\ln y+12x,x/y\\rangle$ is conservative. Find a potential f. Use K for the arbitrary constant and absorb into K as much as possible.\n\n$f(x,y)=$ {{potential}}." :question/worked-solution "For y>0, integration in x gives $f=x\\ln y+6x^2+g(y)$. Then $f_y=x/y+g′(y)$, so g′=0. The domain condition y>0 comes from ln y."}] [[:assigned-problem/id #uuid "b1648d18-ae1f-5547-967d-ed7a00e139ca"] {:assigned-problem/content {:db/id #edb/ref 17592186405802} :assigned-problem/id #uuid "b1648d18-ae1f-5547-967d-ed7a00e139ca" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050875}] :db/id #edb/ref 17592186405592}] [[:answer/id #uuid "e55f7c48-143a-5304-bcb9-05a3f62ef15a"] {:answer/id #uuid "e55f7c48-143a-5304-bcb9-05a3f62ef15a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{ye^{9x}}9+K" :db/id #edb/ref 17592186406272}] [[:answer-field/id #uuid "2b110e4f-12d7-5c6a-acdc-8e8a453cf42b"] {:answer-field/choices [{:answer/id #uuid "e55f7c48-143a-5304-bcb9-05a3f62ef15a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{ye^{9x}}9+K" :db/id #edb/ref 17592186406272}] :answer-field/correct {:db/id #edb/ref 17592186406272} :answer-field/id #uuid "2b110e4f-12d7-5c6a-acdc-8e8a453cf42b" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405919}] [[:question/id #uuid "bbd61bdf-d27a-595a-baf4-a11edba76226"] {:db/id #edb/ref 17592186405634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e55f7c48-143a-5304-bcb9-05a3f62ef15a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{ye^{9x}}9+K" :db/id #edb/ref 17592186406272}] :answer-field/correct {:db/id #edb/ref 17592186406272} :answer-field/id #uuid "2b110e4f-12d7-5c6a-acdc-8e8a453cf42b" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405919}] :question/id #uuid "bbd61bdf-d27a-595a-baf4-a11edba76226" :question/problem "Source question: 9.\n\nThe field $\\mathbf F=\\langle ye^{9x},e^{9x}/9\\rangle$ is conservative. Find a potential f. Use K for the arbitrary constant and absorb into K as much as possible.\n\n$f(x,y)=$ {{potential}}." :question/worked-solution "Integrate ye⁹ˣ with respect to x: $f=ye^{9x}/9+g(y)$. Its y derivative is e⁹ˣ/9+g′, so g′=0. Differentiating in x cancels the factor 1/9."}] [[:assigned-problem/id #uuid "d3826e30-2e00-5141-b857-f124c244215e"] {:assigned-problem/content {:db/id #edb/ref 17592186405634} :assigned-problem/id #uuid "d3826e30-2e00-5141-b857-f124c244215e" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050875}] :db/id #edb/ref 17592186405701}] [[:answer/id #uuid "e534a2ee-5b6b-599b-b829-d446cab3fe36"] {:answer/feedback "Both cross partials equal 10y⁹ on all of the plane, and the displayed potential differentiates to F." :answer/id #uuid "e534a2ee-5b6b-599b-b829-d446cab3fe36" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186406271}] [[:answer/id #uuid "ea8a07e3-b9d0-5343-a842-79d4fabe7597"] {:answer/feedback "Here P_y=10y⁹=Q_x everywhere. A global potential exists on the plane." :answer/id #uuid "ea8a07e3-b9d0-5343-a842-79d4fabe7597" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186406283}] [[:answer-field/id #uuid "1bdca32d-1c12-50a7-8362-195063fc29bd"] {:answer-field/choices [{:answer/feedback "Both cross partials equal 10y⁹ on all of the plane, and the displayed potential differentiates to F." :answer/id #uuid "e534a2ee-5b6b-599b-b829-d446cab3fe36" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186406271} {:answer/feedback "Here P_y=10y⁹=Q_x everywhere. A global potential exists on the plane." :answer/id #uuid "ea8a07e3-b9d0-5343-a842-79d4fabe7597" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186406283}] :answer-field/correct {:db/id #edb/ref 17592186406271} :answer-field/id #uuid "1bdca32d-1c12-50a7-8362-195063fc29bd" :answer-field/key "conservative" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 175921864