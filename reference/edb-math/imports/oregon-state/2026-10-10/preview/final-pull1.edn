alue "x/72+9/2" :db/id #edb/ref 17592186405838}] [[:answer-field/id #uuid "02ce9224-0884-5990-a109-65989371f7ab"] {:answer-field/choices [{:answer/id #uuid "012028d8-ae0d-5c51-931c-4f7d194b1894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x/72+9/2" :db/id #edb/ref 17592186405838}] :answer-field/correct {:db/id #edb/ref 17592186405838} :answer-field/id #uuid "02ce9224-0884-5990-a109-65989371f7ab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405840}] [[:question/id #uuid "09ab09e1-ceb7-5179-b55b-307a079ef53b"] {:db/id #edb/ref 17592186405080 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012028d8-ae0d-5c51-931c-4f7d194b1894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x/72+9/2" :db/id #edb/ref 17592186405838}] :answer-field/correct {:db/id #edb/ref 17592186405838} :answer-field/id #uuid "02ce9224-0884-5990-a109-65989371f7ab" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405840}] :question/id #uuid "09ab09e1-ceb7-5179-b55b-307a079ef53b" :question/problem "Source question: 1.\n\n**Question 1**\n\nFind the tangent line for $x(t)=4t^2$ and $y(t)=t$ at $t=9$. Give an exact answer.\n\n$y(x)=$ {{field-1}}." :question/worked-solution "Use $dy/dx=y'(t)/x'(t)$. At $t=9$, the point is $(324,9)$ and the slope is $1/72$. Thus $y-9=(x-324)/72$, or $y=x/72+9/2$."}] [[:assigned-problem/id #uuid "e1b0357d-422a-51bd-bceb-eda4e1f43c8d"] {:assigned-problem/content {:db/id #edb/ref 17592186405080} :assigned-problem/id #uuid "e1b0357d-422a-51bd-bceb-eda4e1f43c8d" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050168} {:db/id #edb/ref 17592186050537}] :db/id #edb/ref 17592186405751}] [[:answer/id #uuid "f05ff9a0-0302-5c9c-b62b-12f42dfecbdc"] {:answer/id #uuid "f05ff9a0-0302-5c9c-b62b-12f42dfecbdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "12x/11-38" :db/id #edb/ref 17592186406291}] [[:answer-field/id #uuid "5803168d-2bf2-5933-9422-ca3b341b6966"] {:answer-field/choices [{:answer/id #uuid "f05ff9a0-0302-5c9c-b62b-12f42dfecbdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "12x/11-38" :db/id #edb/ref 17592186406291}] :answer-field/correct {:db/id #edb/ref 17592186406291} :answer-field/id #uuid "5803168d-2bf2-5933-9422-ca3b341b6966" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406011}] [[:question/id #uuid "0078d6c2-5079-5550-adfa-d8b2a018000b"] {:db/id #edb/ref 17592186405049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f05ff9a0-0302-5c9c-b62b-12f42dfecbdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "12x/11-38" :db/id #edb/ref 17592186406291}] :answer-field/correct {:db/id #edb/ref 17592186406291} :answer-field/id #uuid "5803168d-2bf2-5933-9422-ca3b341b6966" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406011}] :question/id #uuid "0078d6c2-5079-5550-adfa-d8b2a018000b" :question/problem "Source question: 2.\n\n**Question 2**\n\nFind the tangent line for $x(t)=11t$ and $y(t)=t^2-2$ at $t=6$. Give an exact answer.\n\n$y(x)=$ {{field-1}}." :question/worked-solution "The slope is $(2t)/11$, so at $t=6$ it is $12/11$. The point is $(66,34)$, giving $y-34=(12/11)(x-66)$ and $y=12x/11-38$."}] [[:assigned-problem/id #uuid "e0351426-14cb-5d1b-bfe0-bbacecf95ca1"] {:assigned-problem/content {:db/id #edb/ref 17592186405049} :assigned-problem/id #uuid "e0351426-14cb-5d1b-bfe0-bbacecf95ca1" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050168} {:db/id #edb/ref 17592186050537}] :db/id #edb/ref 17592186405744}] [[:answer/id #uuid "38303de9-9753-5a20-aef3-54caf742750f"] {:answer/id #uuid "38303de9-9753-5a20-aef3-54caf742750f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7x/8+7/2" :db/id #edb/ref 17592186405937}] [[:answer-field/id #uuid "f0fa10b1-1928-5a16-8c07-8effff3fb4ed"] {:answer-field/choices [{:answer/id #uuid "38303de9-9753-5a20-aef3-54caf742750f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7x/8+7/2" :db/id #edb/ref 17592186405937}] :answer-field/correct {:db/id #edb/ref 17592186405937} :answer-field/id #uuid "f0fa10b1-1928-5a16-8c07-8effff3fb4ed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406295}] [[:question/id #uuid "05a4b2b6-5604-5780-be4f-67bb5dc2ad84"] {:db/id #edb/ref 17592186405069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38303de9-9753-5a20-aef3-54caf742750f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7x/8+7/2" :db/id #edb/ref 17592186405937}] :answer-field/correct {:db/id #edb/ref 17592186405937} :answer-field/id #uuid "f0fa10b1-1928-5a16-8c07-8effff3fb4ed" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406295}] :question/id #uuid "05a4b2b6-5604-5780-be4f-67bb5dc2ad84" :question/problem "Source question: 3.\n\n**Question 3**\n\nFind the tangent line for $x(t)=4/t^2$ and $y(t)=7/t$ at $t=1$. Give an exact answer.\n\n$y(x)=$ {{field-1}}." :question/worked-solution "Differentiate with respect to $t$: $x'=-8/t^3$ and $y'=-7/t^2$. At $t=1$, the slope is $7/8$ and the point is $(4,7)$, so $y-7=(7/8)(x-4)$."}] [[:assigned-problem/id #uuid "206a4c48-c01b-5692-9cd2-6fc67860812c"] {:assigned-problem/content {:db/id #edb/ref 17592186405069} :assigned-problem/id #uuid "206a4c48-c01b-5692-9cd2-6fc67860812c" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050168} {:db/id #edb/ref 17592186050537}] :db/id #edb/ref 17592186405137}] [[:answer/id #uuid "aa79cd25-6609-5437-9537-c90b6f5747a1"] {:answer/id #uuid "aa79cd25-6609-5437-9537-c90b6f5747a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(0,0)" :db/id #edb/ref 17592186406163}] [[:answer-field/id #uuid "bbedb144-b632-5d95-a1d0-3a4b9fe0414c"] {:answer-field/choices [{:answer/id #uuid "aa79cd25-6609-5437-9537-c90b6f5747a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(0,0)" :db/id #edb/ref 17592186406163}] :answer-field/correct {:db/id #edb/ref 17592186406163} :answer-field/id #uuid "bbedb144-b632-5d95-a1d0-3a4b9fe0414c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406194}] [[:question/id #uuid "cb479d44-fe4f-5635-98f3-5c844ff53e09"] {:db/id #edb/ref 17592186405676 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa79cd25-6609-5437-9537-c90b6f5747a1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(0,0)" :db/id #edb/ref 17592186406163}] :answer-field/correct {:db/id #edb/ref 17592186406163} :answer-field/id #uuid "bbedb144-b632-5d95-a1d0-3a4b9fe0414c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406194}] :question/id #uuid "cb479d44-fe4f-5635-98f3-5c844ff53e09" :question/problem "**Question 4 — Part A**\n\nPoints with horizontal tangents: {{field-1}}." :question/worked-solution "A horizontal tangent requires $y'=0$ and $x'\\ne0$. Here $y'=4t$ vanishes at $t=0$, while $x'=3t^2-144=-144$. The point is $(0,0)$."}] [[:answer/id #uuid "714a926d-be7e-5bf7-a088-2e46af3d3a9a"] {:answer/id #uuid "714a926d-be7e-5bf7-a088-2e46af3d3a9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-384sqrt(3),96),(384sqrt(3),96)" :db/id #edb/ref 17592186406052}] [[:answer-field/id #uuid "c2e47c16-23fe-549b-b29b-effcf8b9098f"] {:answer-field/choices [{:answer/id #uuid "714a926d-be7e-5bf7-a088-2e46af3d3a9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-384sqrt(3),96),(384sqrt(3),96)" :db/id #edb/ref 17592186406052}] :answer-field/correct {:db/id #edb/ref 17592186406052} :answer-field/id #uuid "c2e47c16-23fe-549b-b29b-effcf8b9098f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406207}] [[:question/id #uuid "4576d74b-e149-587c-9e92-e199d7405580"] {:db/id #edb/ref 17592186405264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "714a926d-be7e-5bf7-a088-2e46af3d3a9a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-384sqrt(3),96),(384sqrt(3),96)" :db/id #edb/ref 17592186406052}] :answer-field/correct {:db/id #edb/ref 17592186406052} :answer-field/id #uuid "c2e47c16-23fe-549b-b29b-effcf8b9098f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406207}] :question/id #uuid "4576d74b-e149-587c-9e92-e199d7405580" :question/problem "**Question 4 — Part B**\n\nPoints with vertical tangents: {{field-1}}." :question/worked-solution "A vertical tangent requires $x'=0$ and $y'\\ne0$. Solving $3t^2-144=0$ gives $t=\\pm4\\sqrt3$. Since $x=t(48-144)=-96t$ and $y=96$, the points are $(-384\\sqrt3,96)$ and $(384\\sqrt3,96)$."}] [[:step/id #uuid "d4755237-ab6e-5ec2-afe8-8e4c721bbd72"] {:db/id #edb/ref 17592186405706 :step/content {:db/id #edb/ref 17592186405676} :step/id #uuid "d4755237-ab6e-5ec2-afe8-8e4c721bbd72" :step/next {:db/id #edb/ref 17592186405413}}] [[:step/id #uuid "7328ff42-e8b3-52fa-a540-e630bd5aa047"] {:db/id #edb/ref 17592186405413 :step/content {:db/id #edb/ref 17592186405264} :step/id #uuid "7328ff42-e8b3-52fa-a540-e630bd5aa047"}] [[:multistep/id #uuid "91143f11-89c8-563a-afa3-9a3d2e8b071c"] {:db/id #edb/ref 17592186405508 :multistep/context "Source question: 4.\n\nFor $x(t)=t^3-144t$ and $y(t)=2t^2$, find all points with horizontal or vertical tangent lines. Give exact coordinate pairs as a comma-separated list; enter `DNE` if there are none." :multistep/first-step {:db/id #edb/ref 17592186405706} :multistep/id #uuid "91143f11-89c8-563a-afa3-9a3d2e8b071c" :multistep/steps [{:db/id #edb/ref 17592186405413 :step/content {:db/id #edb/ref 17592186405264} :step/id #uuid "7328ff42-e8b3-52fa-a540-e630bd5aa047"} {:db/id #edb/ref 17592186405706 :step/content {:db/id #edb/ref 17592186405676} :step/id #uuid "d475