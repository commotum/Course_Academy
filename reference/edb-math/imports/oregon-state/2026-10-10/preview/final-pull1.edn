z)=\\langle9x^2,9y^2,3z^4\\rangle$. \n\nAnswer: {{answer}}." :question/worked-solution "The three same-coordinate derivatives are 18x, 18y, and 12z³. Add them; divergence is a scalar."}] [[:assigned-problem/id #uuid "64e8fc06-fda9-527f-a6d6-8b8089ea0ae9"] {:assigned-problem/content {:db/id #edb/ref 17592186405810} :assigned-problem/id #uuid "64e8fc06-fda9-527f-a6d6-8b8089ea0ae9" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465}] :db/id #edb/ref 17592186405358}] [[:answer/id #uuid "2673acae-9649-541f-a51f-04d2f610d90b"] {:answer/id #uuid "2673acae-9649-541f-a51f-04d2f610d90b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "8+3x+30xyz^4" :db/id #edb/ref 17592186405906}] [[:answer-field/id #uuid "9a1c446c-ecdd-5711-a88d-d5021c37c385"] {:answer-field/choices [{:answer/id #uuid "2673acae-9649-541f-a51f-04d2f610d90b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "8+3x+30xyz^4" :db/id #edb/ref 17592186405906}] :answer-field/correct {:db/id #edb/ref 17592186405906} :answer-field/id #uuid "9a1c446c-ecdd-5711-a88d-d5021c37c385" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406131}] [[:question/id #uuid "4eff6f77-e744-536b-9f24-4fc46d8a0aa5"] {:db/id #edb/ref 17592186405295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2673acae-9649-541f-a51f-04d2f610d90b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "8+3x+30xyz^4" :db/id #edb/ref 17592186405906}] :answer-field/correct {:db/id #edb/ref 17592186405906} :answer-field/id #uuid "9a1c446c-ecdd-5711-a88d-d5021c37c385" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406131}] :question/id #uuid "4eff6f77-e744-536b-9f24-4fc46d8a0aa5" :question/problem "Source question: 2.\n\nFind the divergence of $\\mathbf F(x,y,z)=\\langle8x,3xy,6xyz^5\\rangle$. \n\nAnswer: {{answer}}." :question/worked-solution "$P_x=8$, $Q_y=3x$, $R_z=30xyz^4$. Hold the other coordinates fixed in each partial derivative."}] [[:assigned-problem/id #uuid "f2e054bd-a748-518f-94f0-1f970d7b36c6"] {:assigned-problem/content {:db/id #edb/ref 17592186405295} :assigned-problem/id #uuid "f2e054bd-a748-518f-94f0-1f970d7b36c6" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049465}] :db/id #edb/ref 17592186405804}] [[:answer/id #uuid "9af8df0a-b225-55dc-b3c9-2c4a3fd14dca"] {:answer/id #uuid "9af8df0a-b225-55dc-b3c9-2c4a3fd14dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "22+3\\sin x" :db/id #edb/ref 17592186406132}] [[:answer-field/id #uuid "f3d1b665-3ef5-54dc-b63b-b57a946b7af3"] {:answer-field/choices [{:answer/id #uuid "9af8df0a-b225-55dc-b3c9-2c4a3fd14dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "22+3\\sin x" :db/id #edb/ref 17592186406132}] :answer-field/correct {:db/id #edb/ref 17592186406132} :answer-field/id #uuid "f3d1b665-3ef5-54dc-b63b-b57a946b7af3" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406300}] [[:question/id #uuid "2c051e01-8005-5d78-b740-dd26d934c808"] {:db/id #edb/ref 17592186405179 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9af8df0a-b225-55dc-b3c9-2c4a3fd14dca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "22+3\\sin x" :db/id #edb/ref 17592186406132}] :answer-field/correct {:db/id #edb/ref 17592186406132} :answer-field/id #uuid "f3d1b665-3ef5-54dc-b63b-b57a946b7af3" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406300}] :question/id #uuid "2c051e01-8005-5d78-b740-dd26d934c808" :question/problem "Source question: 3.\n\nFind the divergence of $\\mathbf F(x,y,z)=\\langle7x+4\\cos x,8y+7y\\sin x,7z\\rangle$. \n\nAnswer: {{answer}}." :question/worked-solution "$P_x=7-4\\sin x$, $Q_y=8+7\\sin x$, $R_z=7$. Their sum is 22+3sin x."}] [[:assigned-problem/id #uuid "af78aa19-f731-572b-b2dc-5acb664c7e73"] {:assigned-problem/content {:db/i