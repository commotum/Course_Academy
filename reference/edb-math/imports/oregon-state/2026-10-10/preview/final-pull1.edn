d #uuid "724da0d3-e6c1-56a7-84cd-b38b5511b26d" :question/problem "Source question: 7.\n\nFor $f(x,y)=2xe^y$, find its line integrals with respect to x and y along $5x-y=8$ from (0,−8) to (1,−3).\n\n$\\int_C f\\,dx=$ {{dx}}.\n\n$\\int_C f\\,dy=$ {{dy}}." :question/worked-solution "Use y=5x−8 and dy=5dx, x from 0 to 1. Integration by parts gives $\\int_0^1 2xe^{5x-8}dx=[(2/25)e^{5x-8}(5x-1)]_0^1$. The dy integral is five times the dx integral."}] [[:assigned-problem/id #uuid "8628c127-644b-5eff-a949-785f7eca069b"] {:assigned-problem/content {:db/id #edb/ref 17592186405410} :assigned-problem/id #uuid "8628c127-644b-5eff-a949-785f7eca069b" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050935} {:db/id #edb/ref 17592186051006}] :db/id #edb/ref 17592186405469}] [[:answer/id #uuid "2de89ba0-13b3-54a7-bc46-17b5c1bf8236"] {:answer/id #uuid "2de89ba0-13b3-54a7-bc46-17b5c1bf8236" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac75(e^{15}-1)" :db/id #edb/ref 17592186405924}] [[:answer-field/id #uuid "fbcbeb49-02b1-5ba2-bbaf-cf3f0d396614"] {:answer-field/choices [{:answer/id #uuid "2de89ba0-13b3-54a7-bc46-17b5c1bf8236" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac75(e^{15}-1)" :db/id #edb/ref 17592186405924}] :answer-field/correct {:db/id #edb/ref 17592186405924} :answer-field/id #uuid "fbcbeb49-02b1-5ba2-bbaf-cf3f0d396614" :answer-field/key "dx" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406328}] [[:answer/id #uuid "0d0f5bb3-20e0-573b-9dcb-51c3216b4b67"] {:answer/id #uuid "0d0f5bb3-20e0-573b-9dcb-51c3216b4b67" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac38(e^8-1)" :db/id #edb/ref 17592186405853}] [[:answer-field/id #uuid "b39dd697-749a-50d0-b7bb-01cdea376d9a"] {:answer-field/choices [{:answer/id #uuid "0d0f5bb3-20e0-573b-9dcb-51c3216b4b67" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac38(e^8-1)" :db/id #edb/ref 17592186405853}] :answer-field/correct {