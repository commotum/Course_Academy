rrect {:db/id #edb/ref 17592186406158} :answer-field/id #uuid "72a93e16-2614-5554-a8b3-bfbf334a9393" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406056}] [[:question/id #uuid "9a9e3065-d6b9-5dba-9912-3e722a0b62c5"] {:db/id #edb/ref 17592186405533 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7c1ad9c-e7e7-57b2-866d-5aa28e091f06" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "23\\sqrt{10}" :db/id #edb/ref 17592186406158}] :answer-field/correct {:db/id #edb/ref 17592186406158} :answer-field/id #uuid "72a93e16-2614-5554-a8b3-bfbf334a9393" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406056}] :question/id #uuid "9a9e3065-d6b9-5dba-9912-3e722a0b62c5" :question/problem "Source question: 6.\n\nFind $\\int_C(2x+7y)\\,ds$ for $x=\\sin(5t),\\ y=3\\sin(5t),\\ 0\\le t\\le\\pi/5$.\n\nAnswer: {{answer}}." :question/worked-solution "The speed is $5\\sqrt{10}|\\cos(5t)|$ and the integrand is 23sin(5t). With u=5t, $I=23\\sqrt{10}\\int_0^\\pi\\sin u|\\cos u|du=23\\sqrt{10}$. Split at π/2: each half contributes 1/2. The path retraces the segment, so both passes count."}] [[:assigned-problem/id #uuid "8b9ae13e-c429-59f7-ba8b-07928cf21834"] {:assigned-problem/content {:db/id #edb/ref 17592186405533} :assigned-problem/id #uuid "8b9ae13e-c429-59f7-ba8b-07928cf21834" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405488}] [[:answer/id #uuid "902db6f3-bd84-50bb-a192-0a032e2dc4d9"] {:answer/id #uuid "902db6f3-bd84-50bb-a192-0a032e2dc4d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac2{25}(4e^{-3}+e^{-8})" :db/id #edb/ref 17592186406109}] [[:answer-field/id #uuid "dc567003-9274-5399-b3a1-01f9fadf241f"] {:answer-field/choices [{:answer/id #uuid "902db6f3-bd84-50bb-a192-0a032e2dc4d9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\f