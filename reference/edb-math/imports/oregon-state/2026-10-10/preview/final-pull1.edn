808ad2dde" :step/next {:db/id #edb/ref 17592186405330}}] :activity/title "MTH 255 — R-1" :activity/type {:db/id #edb/ref 17592186045461} :db/id #edb/ref 17592186405215}] [[:tutorial/id #uuid "2b4d9eac-0448-59cf-bfc2-ecbbdbe828de"] {:db/id #edb/ref 17592186405177 :tutorial/content "**1.1 Parametric Equations**\n\nSource: [Macmillan Achieve](https://achieve.macmillanlearning.com/ihub/assessment/f188d950-dd73-11e0-9572-0800200c9a66/5a1db2a7-4295-4a4c-9dbb-ceb8b174a282/1af7ea5c-56c7-4f8d-aaec-e540bb4b3c9e?actualCourseId=5a1db2a7-4295-4a4c-9dbb-ceb8b174a282)\nDue: 2026-10-01\nImported: 2026-10-01 · 6 questions\n\nStudy answers, explanations, and reference graphics are authored additions to the linked source." :tutorial/id #uuid "2b4d9eac-0448-59cf-bfc2-ecbbdbe828de" :tutorial/title "Assignment information"}] [[:answer/id #uuid "4eeb9ad4-2be6-5bd5-af54-bbe6babdcbc6"] {:answer/feedback "Eliminating $t$ gives $x^2/81+y^2/121=1$. The squared terms add; a hyperbola has a difference of squared terms." :answer/id #uuid "4eeb9ad4-2be6-5bd5-af54-bbe6babdcbc6" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbola." :db/id #edb/ref 17592186406000}] [[:answer/id #uuid "48a95ac3-8f73-5319-b40b-86053d291410"] {:answer/feedback "The identity $\\sin^2t+\\cos^2t=1$ gives a quadratic relation $x^2/81+y^2/121=1$, not a linear relation." :answer/id #uuid "48a95ac3-8f73-5319-b40b-86053d291410" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A line." :db/id #edb/ref 17592186405982}] [[:answer/id #uuid "8992196d-fcd6-518b-8e2c-2686fcb72aa3"] {:answer/feedback "A circle would require equal semiaxes. Here the horizontal and vertical semiaxes are $9$ and $11$." :answer/id #uuid "8992196d-fcd6-518b-8e2c-2686fcb72aa3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A circle." :db/id #edb/ref 17592186406101}] [[:answer/id #uuid "0d8492ba-969a-5882-b138-a3b95808b680"] {:answer/feedback "Divide by the amplitudes and use $\\sin^2t+\\cos^2t=1$: $x^2/81+y^2/121=1$. Unequal positive semiaxes give an ellipse." :answer/id #uuid "0d8492ba-969a-5882-b138-a3b95808b680" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An ellipse." :db/id #edb/ref 17592186405854}] [[:answer/id #uuid "ac896571-de9d-5aa0-9b14-ccb1be427f98"] {:answer/feedback "Both coordinates contribute squared terms to $x^2/81+y^2/121=1$. A parabola does not have this bounded ellipse equation." :answer/id #uuid "ac896571-de9d-5aa0-9b14-ccb1be427f98" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A parabola." :db/id #edb/ref 17592186406166}] [[:answer-field/id #uuid "472986f7-f987-5c4f-98af-7205b013397f"] {:answer-field/choices [{:answer/feedback "Divide by the amplitudes and use $\\sin^2t+\\cos^2t=1$: $x^2/81+y^2/121=1$. Unequal positive semiaxes give an ellipse." :answer/id #uuid "0d8492ba-969a-5882-b138-a3b95808b680" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An ellipse." :db/id #edb/ref 17592186405854} {:answer/feedback "The identity $\\sin^2t+\\cos^2t=1$ gives a quadratic relation $x^2/81+y^2/121=1$, not a linear relation." :answer/id #uuid "48a95ac3-8f73-5319-b40b-86053d291410" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A line." :db/id #edb/ref 17592186405982} {:answer/feedback "Eliminating $t$ gives $x^2/81+y^2/121=1$. The squared terms add; a hyperbola has a difference of squared terms." :answer/id #uuid "4eeb9ad4-2be6-5bd5-af54-bbe6babdcbc6" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbola." :db/id #edb/ref 17592186406000} {:answer/feedback "A circle would require equal semiaxes. Here the horizontal and vertical semiaxes are $9$ and $11$." :answer/id #uuid "8992196d-fcd6-518b-8e2c-2686fcb72aa3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A circle." :db/id #edb/ref 17592186406101} {:answer/feedback "Both coordinates contribute squared terms to $x^2/81+y^2/121=1$. A parabola does not have this bounded ellipse equation." :answer/id #uuid "ac896571-de9d-5aa0-9b14-ccb1be427f98" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A parabola." :db/id #edb/ref 17592186406166}] :answer-field/correct {:db/id #edb/ref 17592186405854} :answer-field/id #uuid "472986f7-f987-5c4f-98af-7205b013397f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186405977}] [[:question/id #uuid "5a8ce0ff-66bf-5c93-9779-a5ae2f4be25e"] {:db/id #edb/ref 17592186405325 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Divide by the amplitudes and use $\\sin^2t+\\cos^2t=1$: $x^2/81+y^2/121=1$. Unequal positive semiaxes give an ellipse." :answer/id #uuid "0d8492ba-969a-5882-b138-a3b95808b680" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "An ellipse." :db/id #edb/ref 17592186405854} {:answer/feedback "The identity $\\sin^2t+\\cos^2t=1$ gives a quadratic relation $x^2/81+y^2/121=1$, not a linear relation." :answer/id #uuid "48a95ac3-8f73-5319-b40b-86053d291410" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A line." :db/id #edb/ref 17592186405982} {:answer/feedback "Eliminating $t$ gives $x^2/81+y^2/121=1$. The squared terms add; a hyperbola has a difference of squared terms." :answer/id #uuid "4eeb9ad4-2be6-5bd5-af54-bbe6babdcbc6" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A hyperbola." :db/id #edb/ref 17592186406000} {:answer/feedback "A circle would require equal semiaxes. Here the horizontal and vertical semiaxes are $9$ and $11$." :answer/id #uuid "8992196d-fcd6-518b-8e2c-2686fcb72aa3" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A circle." :db/id #edb/ref 17592186406101} {:answer/feedback "Both coordinates contribute squared terms to $x^2/81+y^2/121=1$. A parabola does not have this bounded ellipse equation." :answer/id #uuid "ac896571-de9d-5aa0-9b14-ccb1be427f98" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "A parabola." :db/id #edb/ref 17592186406166}] :answer-field/correct {:db/id #edb/ref 17592186405854} :answer-field/id #uuid "472986f7-f987-5c4f-98af-7205b013397f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186405977}] :question/id #uuid "5a8ce0ff-66bf-5c93-9779-a5ae2f4be25e" :question/problem "Source question: 1.\n\n**Question 1**\n\nWhich type of curve is described by $x(t)=9\\sin t$ and $y(t)=11\\cos t$?" :question/worked-solution "Divide by the amplitudes and use $\\sin^2t+\\cos^2t=1$: $x^2/81+y^2/121=1$. Unequal positive semiaxes give an ellipse."}] [[:assigned-problem/id #uuid "d451fcf0-e709-5f5b-bc5d-c3222d8e6001"] {:assigned-problem/content {:db/id #edb/ref 17592186405325} :assigned-problem/id #uuid "d451fcf0-e709-5f5b-bc5d-c3222d8e6001" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049462} {:db/id #edb/ref 17592186049494} {:db/id #edb/ref 17592186049678}] :db/id #edb/ref 17592186405705}] [[:answer/id #uuid "400ab1ad-1582-5fc2-be8d-fe88efa4d730"] {:answer/id #uuid "400ab1ad-1582-5fc2-be8d-fe88efa4d730" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(x+63)/8" :db/id #edb/ref 17592186405957}] [[:answer-field/id #uuid "d28b33f0-f998-52e2-ad02-3d360c5e67f4"] {:answer-field/choices [{:answer/id #uuid "400ab1ad-1582-5fc2-be8d-fe88efa4d730" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(x+63)/8" :db/id #edb/ref 17592186405957}] :answer-field/correct {:db/id #edb/ref 17592186405957} :answer-field/id #uuid "d28b33f0-f998-52e2-ad02-3d360c5e67f4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406236}] [[:question/id #uuid "d710ec0b-3410-5b66-9a71-891c2cf88b4c"] {:db/id #edb/ref 17592186405712 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "400ab1ad-1582-5fc2-be8d-fe88efa4d730" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(x+63)/8" :db/id #edb/ref 17592186405957}] :answer-field/correct {:db/id #edb/ref 17592186405957} :answer-field/id #uuid "d28b33f0-f998-52e2-ad02-3d360c5e67f4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406236}] :question/id #uuid "d710ec0b-3410-5b66-9a71-891c2cf88b4c" :question/problem "**Question 2 — Part A**\n\nComplete the rectangular equation: $y=$ {{field-1}}." :question/worked-solution "Solve $x=8t+1$ for $t=(x-1)/8$. Substitution gives $y=(x-1)/8+8=(x+63)/8$."}] [[:answer/id #uuid "6971e547-63d5-5365-8f3d-5f062944fb5f"] {:answer/id #uuid "6971e547-63d5-5365-8f3d-5f062944fb5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-infinity,infinity)" :db/id #edb/ref 17592186406039}] [[:answer-field/id #uuid "8a119c5f-88e2-570d-a82c-2b1a17e5d208"] {:answer-field/choices [{:answer/id #uuid "6971e547-63d5-5365-8f3d-5f062944fb5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-infinity,infinity)" :db/id #edb/ref 17592186406039}] :answer-field/correct {:db/id #edb/ref 17592186406039} :answer-field/id #uuid "8a119c5f-88e2-570d-a82c-2b1a17e5d208" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406103}] [[:question/id #uuid "449cb27b-f44b-5945-b6fe-56020bda4ddb"] {:db/id #edb/ref 17592186405261 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6971e547-63d5-5365-8f3d-5f062944fb5f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(-infinity,infinity)" :db/id #edb/ref 17592186406039}] :answer-field/correct {:db/id #edb/ref 17592186406039} :answer-field/id #uuid "8a119c5f-88e2-570d-a82c-2b1a17e5d208" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406103}] :question/id #uuid "449cb27b-f44b-5945-b6fe-56020bda4ddb" :question/problem "**Question 2 — Part B**\n\nGive the domain in interval notation: $x\\in$ {{field-1}}." :question/worked-solution "As $t$ ranges over all real numbers, the nonconstant linear function $x=8t+1$ also takes every real value. The domain is $(-\\infty,\\infty)$."}]