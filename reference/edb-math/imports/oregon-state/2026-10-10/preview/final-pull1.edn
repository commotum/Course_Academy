592186405888}] :answer-field/correct {:db/id #edb/ref 17592186405888} :answer-field/id #uuid "25e41508-ab89-52dc-85a7-ad90edd8d32b" :answer-field/key "n3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405904} {:answer-field/choices [{:answer/id #uuid "db451701-af84-5885-8070-edb77ae0a632" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{x}{7}" :db/id #edb/ref 17592186406255}] :answer-field/correct {:db/id #edb/ref 17592186406255} :answer-field/id #uuid "261ed098-6d7a-53ed-8a38-b79698074081" :answer-field/key "n1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405905} {:answer-field/choices [{:answer/id #uuid "78c4d6ee-18e3-5d60-ab57-281a1cb423bd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{y}{7}" :db/id #edb/ref 17592186406062}] :answer-field/correct {:db/id #edb/ref 17592186406062} :answer-field/id #uuid "6e4927b4-987b-5d9c-9662-1355e4ce612f" :answer-field/key "n2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406048}] :question/id #uuid "19b61e5c-ef5c-5fb6-bdf2-89030e4ab719" :question/problem "Source question: 5.\n\nFind the upward-pointing unit normal $\\mathbf n=n_1\\mathbf i+n_2\\mathbf j+n_3\\mathbf k$ to $z=\\sqrt{49-x^2-y^2}$, $0\\le x^2+y^2\\le49$.\n\n$n_1=$ {{n1}}.\n\n$n_2=$ {{n2}}.\n\n$n_3=$ {{n3}}." :question/worked-solution "This is the upper radius-7 hemisphere. The radial normal (x,y,z) has length 7, so divide by 7. Its z component is positive in the interior. At the equator it extends continuously as a horizontal unit normal; a strictly upward component there is impossible, and the graph derivatives are singular."}] [[:assigned-problem/id #uuid "043ad055-4d51-5569-b353-b0198d68c711"] {:assigned-problem/content {:db/id #edb/ref 17592186405112} :assigned-problem/id #uuid "043ad055-4d51-5569-b353-b0198d68c711" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049366} {:db/id #edb/ref 17592186050033}] :db/id #edb/ref 17592186405062}] [[:answer/id #uuid "a1713f59-d10d-5fe1-80b8-66533177881f"] {:answer/id #uuid "a1713f59-d10d-5fe1-80b8-66533177881f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{686\\pi}{3}" :db/id #edb/ref 17592186406146}] [[:answer-field/id #uuid "483d783e-18ed-539b-82ff-737ee379cfaa"] {:answer-field/choices [{:answer/id #uuid "a1713f59-d10d-5fe1-80b8-66533177881f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{686\\pi}{3}" :db/id #edb/ref 17592186406146}] :answer-field/correct {:db/id #edb/ref 17592186406146} :answer-field/id #uuid "483d783e-18ed-539b-82ff-737ee379cfaa" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405981}] [[:question/id #uuid "b782860b-1eaa-5a7d-8c10-9856303f7e0b"] {:db/id #edb/ref 17592186405617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1713f59-d10d-5fe1-80b8-66533177881f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{686\\pi}{3}" :db/id #edb/ref 17592186406146}] :answer-field/correct {:db/id #edb/ref 17592186406146} :answer-field/id #uuid "483d783e-18ed-539b-82ff-737ee379cfaa" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405981}] :question/id #uuid "b782860b-1eaa-5a7d-8c10-9856303f7e0b" :question/problem "Source question: 6.\n\nFor $\\mathbf F=\\langle-y,x,z\\rangle$ on $S:x^2+y^2+z^2=49$, z≥0, find $\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS$ with outer unit normal n.\n\nAnswer: {{answer}}." :question/worked-solution "On the radius-7 sphere, $n=(x,y,z)/7$, so F·n=z²/7. Use z=7cosφ and dS=49sinφ dφdθ, 0≤φ≤π/2: flux $=343(2\\pi)\\int_0^{\\pi/2}\\cos^2\\phi\\sin\\phi d\\phi=686\\pi/3$."}] [[:assigned-problem/id #uuid "d48937b5-a399-52c7-b85d-88679065d110"] {:assigned-problem/content {:db/id #edb/ref 17592186405617} :assigned-problem/id #uuid "d48937b5-a399-52c7-b85d-88679065d110" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048191}] :db/id #edb/ref 17592186405707}] [[:answer/id #uuid "c8d11fb7-51f9-5e41-882c-d37168d273ec"] {:answer/id #uuid "c8d11fb7-51f9-5e41-882c-d37168d273ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "552\\pi\\sqrt2" :db/id #edb/ref 17592186406218}] [[:answer-field/id #uuid "a54d4aea-8f4f-5685-b379-0f7367551c1b"] {:answer-field/choices [{:answer/id #uuid "c8d11fb7-51f9-5e41-882c-d37168d273ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "552\\pi\\sqrt2" :db/id #edb/ref 17592186406218}] :answer-field/correct {:db/id #edb/ref 17592186406218} :answer-field/id #uuid "a54d4aea-8f4f-5685-b379-0f7367551c1b" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406157}] [[:question/id #uuid "27e51273-0689-5143-82e5-62771ec38f7d"] {:db/id #edb/ref 17592186405170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8d11fb7-51f9-5e41-882c-d37168d273ec" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "552\\pi\\sqrt2" :db/id #edb/ref 17592186406218}] :answer-field/correct {:db/id #edb/ref 17592186406218} :answer-field/id #uuid "a54d4aea-8f4f-5685-b379-0f7367551c1b" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406157}] :question/id #uuid "27e51273-0689-5143-82e5-62771ec38f7d" :question/problem "Source question: 7.\n\nFind the mass of the conical lamina $z=\\sqrt{x^2+y^2}$, $2\\le z\\le5$, with surface density $\\rho=30-z$.\n\nAnswer: {{answer}}." :question/worked-solution "Use (r cosθ,r sinθ,r), 2≤r≤5. The surface element is √2 r drdθ. Therefore $M=2\\pi\\sqrt2\\int_2^5(30-r)rdr=2\\pi\\sqrt2[15r^2-r^3/3]_2^5=552\\pi\\sqrt2$."}] [[:assigned-problem/id #uuid "bdafa48d-2ccc-5663-a62e-ca5dd3f07050"] {:assigned-problem/content {:db/id #edb/ref 17592186405170} :assigned-problem/id #uuid "bdafa48d-2ccc-5663-a62e-ca5dd3f07050" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050514}] :db/id #edb/ref 17592186405640}] [[:answer/id #uuid "fb642306-2375-5380-af39-4356789d4622"] {:answer/id #uuid "fb642306-2375-5380-af39-4356789d4622" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\frac{2401\\pi\\rho_0}{2}" :db/id #edb/ref 17592186406326}] [[:answer-field/id #uuid "b932533c-580e-5853-9220-8b6870ffadcf"] {:answer-field/choices [{:answer/id #uuid "fb642306-2375-5380-af39-4356789d4622" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\frac{2401\\pi\\rho_0}{2}" :db/id #edb/ref 17592186406326}] :answer-field/correct {:db/id #edb/ref 17592186406326} :answer-field/id #uuid "b932533c-580e-5853-9220-8b6870ffadcf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406191}] [[:question/id #uuid "e1c86b2f-9af3-50b9-8209-64644c12c39a"] {:db/id #edb/ref 17592186405753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb642306-2375-5380-af39-4356789d4622" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\frac{2401\\pi\\rho_0}{2}" :db/id #edb/ref 17592186406326}] :answer-field/correct {:db/id #edb/ref 17592186406326} :answer-field/id #uuid "b932533c-580e-5853-9220-8b6870ffadcf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406191}] :question/id #uuid "e1c86b2f-9af3-50b9-8209-64644c12c39a" :question/problem "Source question: 8.\n\nA fluid of constant mass density crosses $z=x^2+y^2$, z≤49, with velocity $\\mathbf F=\\langle-x,-y,-z\\rangle$. Find the mass flow in one unit of time in the direction of the outer normal.\n\n**Source gap:** The constant density has no numerical value. For this study answer, denote it by $\\rho_0$; report signed outward mass flow.\n\nAnswer: {{answer}}." :question/worked-solution "Interpret outward relative to the solid inside the bowl, capped at z=49. On the curved surface the outward vector area is $(2x,2y,-1)dxdy$, so F·dS=−(x²+y²)dxdy. Its integral over r≤7 is $-2\\pi\\int_0^7r^3dr=-2401\\pi/2$. Multiply by the constant density ρ₀. This is signed outward mass flow; the positive mass entering is 2401πρ₀/2. With unit density, omit ρ₀. The source supplies no density value and does not distinguish signed flow from positive mass."}] [[:assigned-problem/id #uuid "c84df452-16cc-5290-830e-3467cf5af313"] {:assigned-problem/content {:db/id #edb/ref 17592186405753} :assigned-problem/id #uuid "c84df452-16cc-5290-830e-3467cf5af313" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048259}] :db/id #edb/ref 17592186405667}] [[:answer/id #uuid "c61b4455-ddb0-53c6-bdfa-d52ec0f120a9"] {:answer/id #uuid "c61b4455-ddb0-53c6-bdfa-d52ec0f120a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7452\\pi\\rho_0" :db/id #edb/ref 17592186406215}] [[:answer-field/id #uuid "540bb22c-2b2b-56be-b450-b0042b02e624"] {:answer-field/choices [{:answer/id #uuid "c61b4455-ddb0-53c6-bdfa-d52ec0f120a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7452\\pi\\rho_0" :db/id #edb/ref 17592186406215}] :answer-field/correct {:db/id #edb/ref 17592186406215} :answer-field/id #uuid "540bb22c-2b2b-56be-b450-b0042b02e624" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406004}] [[:question/id #uuid "b990240c-49ef-55fd-aa91-1ef51a672c6c"] {:db/id #edb/ref 17592186405625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c61b4455-ddb0-53c6-bdfa-d52ec0f120a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "7452\\pi\\rho_0" :db/id #edb/ref 17592186406215}] :answer-field/correct {:db/id #edb/ref 17592186406215} :answer-field/id #uuid "540bb22c-2b2b-56be-b450-b0042b02e624" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406004}] :question/id #uuid "b990240c-49ef-55fd-aa91-1ef51a672c6c" :question/problem "Source question: 9.\n\nA fluid of constant mass density crosses $z=81-x^2-y^2$, z≥0, with velocity $\\mathbf F=\\langle x,y,11\\rangle$. Find the mass flowing outward in one unit of time.\n\n**Source gap:** The constant density has no numerical value. For this study answer, denote it by $\\rho_0$; report signed outward mass flow.\n\nAnswer: {{answer}}." :question/worked-solution "Outward relative to the solid beneath the paraboloid and above z=0 is upward: $n\\,dS=(2x,2y,1)dxdy$. The flux density is 2r²+11. Integrating over r≤9 gives $2\\pi\\int_0^9(2r^2+11)rdr=\\pi(9^4+11\\cdot9^2)=7452\\pi$. Multiply by ρ₀; with unit density omit that factor. No density value is supplied in the source."}] [[:assigned-problem/id #uuid "b302eafe-c25d-5f50-b350-312d5fc34a48"] {:assigned-problem/content {:db/id #edb/ref 17592186405625} :assigned-problem/id #uuid "b302eafe-c25d-5f50-b350-312d5fc34a48" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048259}] :db/id #edb/ref 17592186405596}] [[:answer/id #uuid "b626159c-25bf-5e4f-8e75-99423e33377e"] {:answer/id #uuid "b626159c-25bf-5e4f-8e75-99423e33377e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "54\\pi" :db/id #edb/ref 17592186406186}] [[:answer-field/id #uuid "f890b027-dbfa-5904-a7fb-6b330d481d62"] {:answer-field/choices [{:answer/id #uuid "b626159c-25bf-5e4f-8e75-99423e33377e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "54\\pi" :db/id #edb/ref 17592186406186}] :answer-field/correct {:db/id #edb/ref 17592186406186} :answer-field/id #uuid "f890b027-dbfa-5904-a7fb-6b330d481d62" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406315}] [[:question/id #uuid "1d0ff580-cbfb-5d8f-af8d-e0fd4efc6f0d"] {:db/id #edb/ref 17592186405125 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b626159c-25bf-5e4f-8e75-99423e33377e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "54\\pi" :db/id #edb/ref 17592186406186}] :answer-field/correct {:db/id #edb/ref 17592186406186} :answer-field/id #uuid "f890b027-dbfa-5904-a7fb-6b330d481d62" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406315}] :question/id #uuid "1d0ff580-cbfb-5d8f-af8d-e0fd4efc6f0d" :question/problem "Source question: 10.\n\nFind the outward electric flux of $\\mathbf E=\\langle x,2y,10z\\rangle$ across the cylindrical side $x^2+y^2=9$, $0\\le z\\le2$.\n\nAnswer: {{answer}}." :question/worked-solution "Use (3cosθ,3sinθ,z). The outward vector area is (3cosθ,3sinθ,0)dθ dz. Its dot product with E is 9cos²θ+18sin²θ. Integrate θ from 0 to 2π and z from 0 to 2: $2(9\\pi+18\\pi)=54\\pi$. The vertical component contributes nothing on the side."}] [[:assigned-problem/id #uuid "cedb1d93-2c07-5056-be4e-79abcd1dcb33"] {:assigned-problem/content {:db/id #edb/ref 17592186405125} :assigned-problem/id #uuid "cedb1d93-2c07-5056-be4e-79abcd1dcb33" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048191}] :db/id #edb/ref 17592186405684}] [[:answer/id #uuid "445d50fa-0b51-52a9-a342-e7e1fff15e9c"] {:answer/id #uuid "445d50fa-0b51-52a9-a342-e7e1fff15e9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{28}{3}" :db/id #edb/ref 17592186405969}] [[:answer-field/id #uuid "5df14e47-1e35-5470-80ec-33083b599d42"] {:answer-field/choices [{:answer/id #uuid "445d50fa-0b51-52a9-a342-e7e1fff15e9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{28}{3}" :db/id #edb/ref 17592186405969}] :answer-field/correct {:db/id #edb/ref 17592186405969} :answer-field/id #uuid "5df14e47-1e35-5470-80ec-33083b599d42" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406016}] [[:question/id #uuid "5d6a40a2-5a20-57b3-b9db-6cdb825d7b5f"] {:db/id #edb/ref 17592186405333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "445d50fa-0b51-52a9-a342-e7e1fff15e9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{28}{3}" :db/id #edb/ref 17592186405969}] :answer-field/correct {:db/id #edb/ref 17592186405969} :answer-field/id #uuid "5df14e47-1e35-5470-80ec-33083b599d42" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406016}] :question/id #uuid "5d6a40a2-5a20-57b3-b9db-6cdb825d7b5f" :question/problem "Source question: 11.\n\nLet $\\mathbf F=\\langle x+y,3x-z,y\\rangle$ and let S be $z+2x+2y=4$ in the first octant. Find its outward flux $\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS$.\n\nAnswer: {{answer}}." :question/worked-solution "Outward from the first-octant tetrahedron gives vector area (2,2,1)dxdy on the plane. Substituting z=4−2x−2y yields F·(2,2,1)=12x+7y−8. On x≥0,y≥0,x+y≤2, area=2 and both first moments equal 4/3. Thus flux =12·4/3+7·4/3−16=28/3."}] [[:assigned-problem/id #uuid "fbf749c0-f12d-5644-9b91-f7abc1f1a583"] {:assigned-problem/content {:db/id #edb/ref 17592186405333} :assigned-problem/id #uuid "fbf749c0-f12d-5644-9b91-f7abc1f1a583" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048259}] :db/id #edb/ref 17592186405830}] [[:answer/id #uuid "806904e4-c853-5545-a7f4-807f0b63abea"] {:answer/id #uuid "806904e4-c853-5545-a7f4-807f0b63abea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{173\\sqrt{13}}{15}" :db/id #edb/ref 17592186406080}] [[:answer-field/id #uuid "d020974b-a597-594a-a7e8-6a14b225ef5d"] {:answer-field/choices [{:answer/id #uuid "806904e4-c853-5545-a7f4-807f0b63abea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{173\\sqrt{13}}{15}" :db/id #edb/ref 17592186406080}] :answer-field/correct {:db/id #edb/ref 17592186406080} :answer-field/id #uuid "d020974b-a597-594a-a7e8-6a14b225ef5d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406231}] [[:question/id #uuid "922ce6de-c171-533d-adb5-9b6fea505dad"] {:db/id #edb/ref 17592186405511 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "806904e4-c853-5545-a7f4-807f0b63abea" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{173\\sqrt{13}}{15}" :db/id #edb/ref 17592186406080}] :answer-field/correct {:db/id #edb/ref 17592186406080} :answer-field/id #uuid "d020974b-a597-594a-a7e8-6a14b225ef5d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406231}] :question/id #uuid "922ce6de-c171-533d-adb5-9b6fea505dad" :question/problem "Source question: 12.\n\nFind $\\iint_S(x+4y)dS$ for $\\mathbf r(u,v)=\\langle6u\\cos v,u^2+1,4u\\cos v\\rangle$, $0\\le u\\le1$, $0\\le v\\le\\pi/2$.\n\nAnswer: {{answer}}." :question/worked-solution "$r_u=(6\\cos v,2u,4\\cos v)$ and $r_v=(-6u\\sin v,0,-4u\\sin v)$. Their cross product is $(-8u^2\\sin v,0,12u^2\\sin v)$, with norm $4\\sqrt{13}u^2\\sin v$. The integrand is $6u\\cos v+4u^2+4$. Integrate in v, then u: $4\\sqrt{13}\\int_0^1u^2(3u+4u^2+4)du=4\\sqrt{13}(3/4+4/5+4/3)$."}] [[:assigned-problem/id #uuid "9b51bdeb-0f77-5a56-9bd5-478e0198a655"] {:assigned-problem/content {:db/id #edb/ref 17592186405511} :assigned-problem/id #uuid "9b51bdeb-0f77-5a56-9bd5-478e0198a655" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050514}] :db/id #edb/ref 17592186405535}] [[:step/id #uuid "8e174821-d7a3-543c-98e4-7b7dee412e81"] {:db/id #edb/ref 17592186405496 :step/content {:db/id #edb/ref 17592186405126} :step/id #uuid "8e174821-d7a3-543c-98e4-7b7dee412e81" :step/next {:db/id #edb/ref 17592186405287}}] [[:step/id #uuid "4bf4ac62-5d84-5346-8986-8737ae4017d9"] {:db/id #edb/ref 17592186405287 :step/content {:db/id #edb/ref 17592186405057} :step/id #uuid "4bf4ac62-5d84-5346-8986-8737ae4017d9" :step/next {:db/id #edb/ref 17592186405190}}] [[:step/id #uuid "2ef2ab63-09f4-54a4-b836-609f5bf99743"] {:db/id #edb/ref 17592186405190 :step/content {:db/id #edb/ref 17592186405109} :step/id #uuid "2ef2ab63-09f4-54a4-b836-609f5bf99743" :step/next {:db/id #edb/ref 17592186405115}}] [[:step/id #uuid "1aedeb19-3ac8-5a39-bce8-ce3870fed5da"] {:db/id #edb/ref 17592186405115 :step/content {:db/id #edb/ref 17592186405747} :step/id #uuid "1aedeb19-3ac8-5a39