rect {:db/id #edb/ref 17592186405968} :answer-field/id #uuid "8682d29d-9ce9-50c2-b442-ef5e89ab8a50" :answer-field/key "potential" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406096}] :question/id #uuid "995cbe4d-53fa-547b-aaf6-3f7270f7c624" :question/problem "**(a)** Given $\\nabla f=3x\\mathbf i+8y\\mathbf j$, find f. Use K for the arbitrary constant and absorb into K as much as possible.\n\n$f(x,y)=$ {{potential}}." :question/worked-solution "Integrate 3x in x, then match the y derivative to 8y. The two partial derivatives of $3x^2/2+4y^2+K$ are exactly 3x and 8y."}] [[:answer/id #uuid "c1929c80-c2d2-5325-a171-61a17694e0ac"] {:answer/id #uuid "c1929c80-c2d2-5325-a171-61a17694e0ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{137}{2}" :db/id #edb/ref 17592186406204}] [[:answer-field/id #uuid "d53e289a-5326-5645-925e-c7d504b05387"] {:answer-field/choices [{:answer/id #uuid "c1929c80-c2d2-5325-a171-61a17694e0ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{137}{2}" :db/id #edb/ref 17592186406204}] :answer-field/correct {:db/id #edb/ref 17592186406204} :answer-field/id #uuid "d53e289a-5326-5645-925e-c7d504b05387" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406242}] [[:question/id #uuid "46150f7a-2a95-5436-bf30-8755f3888245"] {:db/id #edb/ref 17592186405267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1929c80-c2d2-5325-a171-61a17694e0ac" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{137}{2}" :db/id #edb/ref 17592186406204}] :answer-field/correct {:db/id #edb/ref 17592186406204} :answer-field/id #uuid "d53e289a-5326-5645-925e-c7d504b05387" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406242}] :question/id #uuid "46150f7a-2a95-5436-bf30-8755f3888245" :question/problem "**(b)** Evaluate $\\int_C3x\\,dx+8y\\,dy$ along a piecewise smooth curve from (1,3) to (2,5). Integral: {{integral}}." :question/worked-solution "Use the potential from part (a). The final value (without K) is 6+100=106; the initial value is 3/2+36=75/2. Their difference is 137/2."}] [[:step/id #uuid "644241c0-34f6-53ff-be4e-efed6f2f55f9"] {:db/id #edb/ref 17592186405355 :step/content {:db/id #edb/ref 17592186405526} :step/id #uuid "644241c0-34f6-53ff-be4e-efed6f2f55f9" :step/next {:db/id #edb/ref 17592186405113}}] [[:step/id #uuid "19d9b88e-5569-5b33-8f52-591f091f55da"] {:db/id #edb/ref 17592186405113 :step/content {:db/id #edb/ref 17592186405267} :step/id #uuid "19d9b88e-5569-5b33-8f52-591f091f55da"}] [[:multistep/id #uuid "8be4e529-b068-50b1-9fb5-96f48c8389d2"] {:db/id #edb/ref 17592186405490 :multistep/context "Source question: 11(a)–(b)." :multistep/first-step {:db/id #edb/ref 17592186405355} :multistep/id #uuid "8be4e529-b068-50b1-9fb5-96f48c8389d2" :multistep/steps [{:db/id #edb/ref 17592186405113 :step/content {:db/id #edb/ref 17592186405267} :step/id #uuid "19d9b88e-5569-5b33-8f52-591f091f55da"} {:db/id #edb/ref 17592186405355 :step/content {:db/id #edb/ref 17592186405526} :step/id #uuid "644241c0-34f6-53ff-be4e-efed6f2f55f9" :step/next {:db/id #edb/ref 17592186405113}}]}] [[:assigned-problem/id #uuid "4bd5ee04-799e-555f-b62d-0a7f7918f84a"] {:assigned-problem/content {:db/id #edb/ref 17592186405490} :assigned-problem/id #uuid "4bd5ee04-799e-555f-b62d-0a7f7918f84a" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048314} {:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050875}] :db/id #edb/ref 17592186405286}] [[:answer/id #uuid "1ffd4418-1a03-54ae-9453-96e0341ed82d"] {:answer/id #uuid "1ffd4418-1a03-54ae-9453-96e0341ed82d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-e^9-\\frac{e^8}{2}" :db/id #edb/ref 17592186405894}] [[:answer-field/id #uuid "0afed85f-027b-55eb-a261-17748d909174"] {:answer-field/choices [{:answer/id #uuid "1ffd4418-1a03-54ae-9453-96e0341ed82d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-e^9-\\frac{e^8}{2}" :db/id #edb/ref 17592186405894}] :answer-field/correct {:db/id #edb/ref 17592186405894} :answer-field/id #uuid "0afed85f-027b-55eb-a261-17748d909174" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405849}] [[:question/id #uuid "2a22ab5f-8e26-562e-8cf4-a4358e220ad8"] {:db/id #edb/ref 17592186405174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ffd4418-1a03-54ae-9453-96e0341ed82d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-e^9-\\frac{e^8}{2}" :db/id #edb/ref 17592186405894}] :answer-field/correct {:db/id #edb/ref 17592186405894} :answer-field/id #uuid "0afed85f-027b-55eb-a261-17748d909174" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405849}] :question/id #uuid "2a22ab5f-8e26-562e-8cf4-a4358e220ad8" :question/problem "**(a)** C consists of the line segment(s) joining $(8,\\pi/3)\\to(9,\\pi/3)\\to(9,\\pi)$, in that order.\n\nIntegral: {{integral}}." :question/worked-solution "The potential is $f=e^x\\cos y$. All three paths have the same endpoints. Thus $f(9,\\pi)-f(8,\\pi/3)=-e^9-e^8/2$. Differentiating f verifies the two coefficients of the differential."}] [[:answer/id #uuid "a1434c66-c5ff-51e2-a3c7-00304c4097b0"] {:answer/id #uuid "a1434c66-c5ff-51e2-a3c7-00304c4097b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-e^9-\\frac{e^8}{2}" :db/id #edb/ref 17592186406144}] [[:answer-field/id #uuid "b6b42f2b-2733-5cb4-bce8-65561f072d37"] {:answer-field/choices [{:answer/id #uuid "a1434c66-c5ff-51e2-a3c7-00304c4097b0" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-e^9-\\frac{e^8}{2}" :db/id #edb/ref 17592186406144}] :answer-field/correct {:db/id #edb/ref 17592186406144} :answer-field/id #uuid "b6b42f2b-2733-5cb4-bce8-65561f072d37" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref