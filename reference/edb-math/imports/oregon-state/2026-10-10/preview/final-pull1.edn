p/next {:db/id #edb/ref 17592186405371}} {:db/id #edb/ref 17592186405653 :step/content {:db/id #edb/ref 17592186405809} :step/id #uuid "c48d089b-9362-56a5-9e61-187732a48700" :step/next {:db/id #edb/ref 17592186405064}} {:db/id #edb/ref 17592186405711 :step/content {:db/id #edb/ref 17592186405172} :step/id #uuid "d6f7492d-9674-5cca-9654-1ff0dfe7e99e" :step/next {:db/id #edb/ref 17592186405122}} {:db/id #edb/ref 17592186405795 :step/content {:db/id #edb/ref 17592186405698} :step/id #uuid "f0b08bfd-b17f-5b46-82c2-2d3419b4e400" :step/next {:db/id #edb/ref 17592186405711}}] :activity/title "MTH 255 — OHW-3" :activity/type {:db/id #edb/ref 17592186045461} :db/id #edb/ref 17592186405797}] [[:tutorial/id #uuid "79f244bc-585f-55c6-b7af-ebf165d173ff"] {:db/id #edb/ref 17592186405431 :tutorial/content "Date: 2026-09-29\nDue: 2026-09-29\n\nSource: [Original worksheet](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FR1%2F256-R1.pdf)\n\nThe purpose of this recitation is to review material from previous calculus classes that will be important during the quarter.\n\nStudy answers, explanations, and reference graphics are authored additions to the linked source." :tutorial/id #uuid "79f244bc-585f-55c6-b7af-ebf165d173ff" :tutorial/title "Assignment information"}] [[:answer/id #uuid "ea20ce4c-b69b-5280-a53b-044e8d163bdc"] {:answer/id #uuid "ea20ce4c-b69b-5280-a53b-044e8d163bdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e^x*(sin(x)+cos(x))" :db/id #edb/ref 17592186406282}] [[:answer-field/id #uuid "5373f97c-b984-5267-b521-45eff0225634"] {:answer-field/choices [{:answer/id #uuid "ea20ce4c-b69b-5280-a53b-044e8d163bdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e^x*(sin(x)+cos(x))" :db/id #edb/ref 17592186406282}] :answer-field/correct {:db/id #edb/ref 17592186406282} :answer-field/id #uuid "5373f97c-b984-5267-b521-45eff0225634" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406003}] [[:question/id #uuid "1fbcd441-47d5-54f9-956c-997f296607cb"] {:db/id #edb/ref 17592186405134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea20ce4c-b69b-5280-a53b-044e8d163bdc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "e^x*(sin(x)+cos(x))" :db/id #edb/ref 17592186406282}] :answer-field/correct {:db/id #edb/ref 17592186406282} :answer-field/id #uuid "5373f97c-b984-5267-b521-45eff0225634" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406003}] :question/id #uuid "1fbcd441-47d5-54f9-956c-997f296607cb" :question/problem "**Question 1 — Part A**\n\nCompute the derivative of $f(x)=e^x\\sin(x)$.\n\n$f\\prime(x)=$ {{field-1}}." :question/worked-solution "The product rule gives $(e^x)\\prime\\sin x+e^x(\\sin x)\\prime=e^x\\sin x+e^x\\cos x$. Both factors vary with $x$."}] [[:question/id #uuid "aa053063-e2ae-5112-ac07-5d463e12648f"] {:db/id #edb/ref 17592186405571 :question/id #uuid "aa053063-e2ae-5112-ac07-5d463e12648f" :question/problem "**Question 1 — Part B**\n\nExpress the following in terms of $y(x)$ and $y'(x)$:\n\n$$\n\\frac{d}{dx}\\bigl(\\sin(x)\\,y(x)\\bigr).\n$$" :question/worked-solution "$\\frac{d}{dx}(\\sin x\\,y(x))=\\cos x\\,y(x)+\\sin x\\,y\\prime(x)$.\n\nTreat $y(x)$ as a differentiable function, not a constant. Differentiate each factor once and retain the undifferentiated partner in each term."}] [[:answer/id #uuid "fd7a530a-cbfc-5d2f-8b32-bfdc6d662a5d"] {:answer/id #uuid "fd7a530a-cbfc-5d2f-8b32-bfdc6d662a5d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x*e^(x^2)" :db/id #edb/ref 17592186406331}] [[:answer-field/id #uuid "0eac685e-dea3-58b8-b3ea-6bb5db9b4e49"] {:answer-field/choices [{:answer/id #uuid "fd7a530a-cbfc-5d2f-8b32-bfdc6d662a5d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x*e^(x^2)" :db/id #edb/ref 17592186406331}] :answer-field/correct {:db/id #edb/ref 17592186406331} :answer-field/id #uuid "0eac685e-dea3-58b8-b3ea-6bb5db9b4e49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405856}] [[:question/id #uuid "4a520d04-73da-5ea2-9040-ef0ef4ce8ef6"] {:db/id #edb/ref 17592186405282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd7a530a-cbfc-5d2f-8b32-bfdc6d662a5d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x*e^(x^2)" :db/id #edb/ref 17592186406331}] :answer-field/correct {:db/id #edb/ref 17592186406331} :answer-field/id #uuid "0eac685e-dea3-58b8-b3ea-6bb5db9b4e49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405856}] :question/id #uuid "4a520d04-73da-5ea2-9040-ef0ef4ce8ef6" :question/problem "**Question 1 — Part C**\n\nCompute the following derivative ($\\exp(x)=e^x$):\n\n$$\n\\frac{d}{dx}\\exp(x^2).\n$$\n\nDerivative: {{field-1}}." :question/worked-solution "For $e^{u(x)}$, the derivative is $e^{u(x)}u\\prime(x)$. Here $u=x^2$ and $u\\prime=2x$."}] [[:question/id #uuid "ed1748cc-4512-50d3-a9cc-9588a21891c6"] {:db/id #edb/ref 17592186405777 :question/id #uuid "ed1748cc-4512-50d3-a9cc-9588a21891c6" :question/problem "**Question 1 — Part D**\n\nExpress the following derivative in terms of $p(x)$ and an antiderivative:\n\n$$\n\\frac{d}{dx}\\exp\\left(\\int p(x)\\,dx\\right).\n$$" :question/worked-solution "Let $P(x)$ be any antiderivative of $p(x)$. Then $\\frac{d}{dx}e^{P(x)}=P\\prime(x)e^{P(x)}=p(x)e^{P(x)}=p(x)\\exp(\\int p(x)\\,dx)$.\n\nApply the exponential chain rule and then the definition $P\\prime=p$. The additive constant in $P$ only changes a constant multiplicative factor in the exponential; the displayed derivative identity remains valid."}] [[:step/id #uuid "d2a56faf-af04-5ae6-8a28-c595bdefbae4"] {:db/id #edb/ref 17592186405699 :step/content {:db/id #edb/ref 17592186405134} :step/id #uuid "d2a56faf-af04-5ae6-8a28-c595bdefbae4" :step/next {:db/id #edb/ref 17592186405536}}] [[:step/id #uuid "9c2