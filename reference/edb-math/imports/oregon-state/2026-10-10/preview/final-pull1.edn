orrect {:db/id #edb/ref 17592186406266} :answer-field/id #uuid "61abd66e-b781-57cb-86eb-cb137fe11210" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406024}] :question/id #uuid "67db9163-a31a-513e-b2a5-ee0b12e7a217" :question/problem "**Question 3 — Part B**\n\nGive the domain in interval notation: {{field-1}}." :question/worked-solution "The increasing function $x=t-6$ maps the included endpoints $t=0,2$ to $x=-6,-4$. Thus $-6\\le x\\le-4$."}] [[:step/id #uuid "ad1d40c7-63e1-532d-87c0-327d358f19d5"] {:db/id #edb/ref 17592186405579 :step/content {:db/id #edb/ref 17592186405136} :step/id #uuid "ad1d40c7-63e1-532d-87c0-327d358f19d5" :step/next {:db/id #edb/ref 17592186405776}}] [[:step/id #uuid "ecb98044-8e28-5a2e-891e-0f813e1caca2"] {:db/id #edb/ref 17592186405776 :step/content {:db/id #edb/ref 17592186405369} :step/id #uuid "ecb98044-8e28-5a2e-891e-0f813e1caca2"}] [[:multistep/id #uuid "b4baeb0c-f674-508b-b39a-7dfb18d20741"] {:db/id #edb/ref 17592186405606 :multistep/context "Source question: 3.\n\nFor $x(t)=t-6$ and $y(t)=5t+1$, with $0\\le t\\le2$, eliminate the parameter. Give exact answers." :multistep/first-step {:db/id #edb/ref 17592186405579} :multistep/id #uuid "b4baeb0c-f674-508b-b39a-7dfb18d20741" :multistep/steps [{:db/id #edb/ref 17592186405579 :step/content {:db/id #edb/ref 17592186405136} :step/id #uuid "ad1d40c7-63e1-532d-87c0-327d358f19d5" :step/next {:db/id #edb/ref 17592186405776}} {:db/id #edb/ref 17592186405776 :step/content {:db/id #edb/ref 17592186405369} :step/id #uuid "ecb98044-8e28-5a2e-891e-0f813e1caca2"}]}] [[:assigned-problem/id #uuid "02c291be-ef43-5c72-904f-9019e50e9828"] {:assigned-problem/content {:db/id #edb/ref 17592186405606} :assigned-problem/id #uuid "02c291be-ef43-5c72-904f-9019e50e9828" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048832} {:db/id #edb/ref 17592186049150} {:db/id #edb/ref 17592186049168}] :db/id #edb/ref 17592186405056}] [[:answer/id #uuid "a3fb02b8-df70-5fde-ad43-b695015040a5"] {:answer/id #uuid "a3fb02b8-df70-5fde-ad43-b695015040a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x^2+y^2=25" :db/id #edb/ref 17592186406154}] [[:answer-field/id #uuid "a9308fb1-5044-5898-a430-092acfe1c453"] {:answer-field/choices [{:answer/id #uuid "a3fb02b8-df70-5fde-ad43-b695015040a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x^2+y^2=25" :db/id #edb/ref 17592186406154}] :answer-field/correct {:db/id #edb/ref 17592186406154} :answer-field/id #uuid "a9308fb1-5044-5898-a430-092acfe1c453" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406161}] [[:question/id #uuid "8d094c68-435b-5c9d-8f3e-bca9fd89d7cf"] {:db/id #edb/ref 17592186405494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3fb02b8-df70-5fde-ad43-b695015040a5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x^2+y^2=25" :db/id #edb/ref 17592186406154}] :answer-field/correct {:db/id #edb/ref 17592186406154} :answer-field/id #uuid "a9308fb1-5044-5898-a430-092acfe1c453" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406161}] :question/id #uuid "8d094c68-435b-5c9d-8f3e-bca9fd89d7cf" :question/problem "**Question 4 — Part A**\n\nEnter the rectangular equation: {{field-1}}." :question/worked-solution "Squaring and adding gives $x^2+y^2=25(\\sin^2t+\\cos^2t)=25$. The parameter interval traces the whole circle."}] [[:answer/id #uuid "bd465262-61e6-5536-91b8-ffebce74f698"] {:answer/feedback "The circle has center $(0,0)$ and radius $5$. At $t=0$, the point is $(0,5)$ and the velocity is $(5,0)$, so it moves clockwise." :answer/id #uuid "bd465262-61e6-5536-91b8-ffebce74f698" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/d8/d8c88faa66f299ab520136887210567700ad34f4a25e0fbfd80a8e513a92ebae.png" :db/id #edb/ref 17592186406197}] [[:answer/id #uuid "f01b6ecd-e925-52dc-ba20-2140ae8b8d5e"] {:answer/feedback "This circle is shifted right and is traversed counterclockwise. The equations have no coordinate offsets and start at the top moving right." :answer/id #uuid "f01b6ecd-e925-52dc-ba20-2140ae8b8d5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/91/913130e84d7777315aef2a2d0937e96d897fed6d3ff17e6fcc447a321cc89da7.png" :db/id #edb/ref 17592186406290}] [[:answer/id #uuid "95bc86cd-b7e8-5fde-8ec3-2b30f4ee8af5"] {:answer/feedback "The clockwise direction agrees, but the center is shifted right. The equation $x^2+y^2=25$ puts the center at the origin." :answer/id #uuid "95bc86cd-b7e8-5fde-8ec3-2b30f4ee8af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/bf/bf1ef84e20ef40a580e31e821168d82b88224aef7765a8310d253fa2380adb22.png" :db/id #edb/ref 17592186406120}] [[:answer/id #uuid "c3f73c9e-69e9-5f0c-9ae5-9170e49ccf39"] {:answer/feedback "The center agrees, but the arrows are counterclockwise. At $t=0$, $x'=5$ and $y'=0$, so motion from the top is to the right." :answer/id #uuid "c3f73c9e-69e9-5f0c-9ae5-9170e49ccf39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/6a/6aa3ec9f041275f7830bbecdf8a19ba1481442400b8b718dc22629ed261a73b6.png" :db/id #edb/ref 17592186406210}] [[:answer-field/id #uuid "90947044-ac6e-508e-97e3-f7a7a381042b"] {:answer-field/choices [{:answer/feedback "The clockwise direction agrees, but the center is shifted right. The equation $x^2+y^2=25$ puts the center at the origin." :answer/id #uuid "95bc86cd-b7e8-5fde-8ec3-2b30f4ee8af5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/bf/bf1ef84e20ef40a580e31e821168d82b88224aef7765a8310d253fa2380adb22.png" :db/id #edb/ref 17592186406120} {:answer/feedback "The circle has center $(0,0)$ and radius $5$. At $t=0$, the point is $(0,5)$ and the velocity is $(5,0)$, so it moves clockwise." :answer/id #uuid "bd465262-61e6-5536-91b8-ffebce74f698" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/d8/d8c8