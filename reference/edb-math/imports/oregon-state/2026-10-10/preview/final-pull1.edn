4b-ab43-6dfe6671f4ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406263}] [[:answer-field/id #uuid "69ab73ce-906b-585d-a1dd-df4aca182d5e"] {:answer-field/choices [{:answer/id #uuid "debe0e96-6451-5e4b-ab43-6dfe6671f4ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406263}] :answer-field/correct {:db/id #edb/ref 17592186406263} :answer-field/id #uuid "69ab73ce-906b-585d-a1dd-df4aca182d5e" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406041}] [[:question/id #uuid "ee65c84c-2102-5bc7-9a35-fadda3ae61dc"] {:db/id #edb/ref 17592186405779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "debe0e96-6451-5e4b-ab43-6dfe6671f4ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186406263}] :answer-field/correct {:db/id #edb/ref 17592186406263} :answer-field/id #uuid "69ab73ce-906b-585d-a1dd-df4aca182d5e" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406041}] :question/id #uuid "ee65c84c-2102-5bc7-9a35-fadda3ae61dc" :question/problem "Source question: 15.\n\nFind $\\int_C\\mathbf F\\cdot d\\mathbf r$ for $\\mathbf F=\\langle16x^2,xy\\rangle$, $\\mathbf r(t)=\\langle\\sin t,-4\\cos t\\rangle$, $0\\le t\\le\\pi$.\n\nAnswer: {{answer}}." :question/worked-solution "$F(r)=(16\\sin^2t,-4\\sin t\\cos t)$ and $r\\prime=(\\cos t,4\\sin t)$. Their dot product is identically zero. This checks the integral without evaluating an antiderivative."}] [[:assigned-problem/id #uuid "6b212159-b2ab-54af-b3bb-14e702e8b990"] {:assigned-problem/content {:db/id #edb/ref 17592186405779} :assigned-problem/id #uuid "6b212159-b2ab-54af-b3bb-14e702e8b990" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048960} {:db/id #edb/ref 17592186049859}] :db/id #edb/ref 17592186405378}] [[:answer/id #uuid "32aca840-d34a-5852-ad05-1162fcf0ee90"] {:answer/id