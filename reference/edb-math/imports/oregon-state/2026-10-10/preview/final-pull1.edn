hoices [{:answer/id #uuid "9a039654-ef0e-5418-8760-d2cb61f18279" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(2020^(3/2)-4096)/1323" :db/id #edb/ref 17592186406129}] :answer-field/correct {:db/id #edb/ref 17592186406129} :answer-field/id #uuid "7cedadf0-dada-567c-a5c5-60e8c202704d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406072}] :question/id #uuid "d722ad10-0137-5a5f-a2db-bf50b5c530a9" :question/problem "Source question: 6.\n\n**Question 6**\n\nFind the arc length for $x(t)=7t^3$, $y(t)=8t^2$, $0\\le t\\le2$. Give an exact answer.\n\n$s=$ {{field-1}}." :question/worked-solution "Arc length integrates speed: $s=\\int_0^2\\sqrt{(21t^2)^2+(16t)^2}\\,dt=\\int_0^2t\\sqrt{441t^2+256}\\,dt$, since $t\\ge0$. With $u=441t^2+256$, this is $[(441t^2+256)^{3/2}/1323]_0^2=(2020^{3/2}-4096)/1323$."}] [[:assigned-problem/id #uuid "eee91690-0a9b-5f65-9410-0f39a05d774d"] {:assigned-problem/content {:db/id #edb/ref 17592186405713} :assigned-problem/id #uuid "eee91690-0a9b-5f65-9410-0f39a05d774d" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049487} {:db/id #edb/ref 17592186050537} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405783}] [[:answer/id #uuid "9d25ecae-adb0-51ae-9ffb-543d21ac69f7"] {:answer/id #uuid "9d25ecae-adb0-51ae-9ffb-543d21ac69f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2(205^(3/2)-2197)/27" :db/id #edb/ref 17592186406136}] [[:answer-field/id #uuid "54d96522-dfeb-5f80-a0ed-2a7857020f6e"] {:answer-field/choices [{:answer/id #uuid "9d25ecae-adb0-51ae-9ffb-543d21ac69f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2(205^(3/2)-2197)/27" :db/id #edb/ref 17592186406136}] :answer-field/correct {:db/id #edb/ref 17592186406136} :answer-field/id #uuid "54d96522-dfeb-5f80-a0ed-2a7857020f6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406006}] [[:question/id #uuid "b8fcb546-d6c9-50b5-a552-4ead01edb044"] {:db/id #edb/ref 17592186405622 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d25ecae-adb0-51ae-9ffb-543d21ac69f7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2(205^(3/2)-2197)/27" :db/id #edb/ref 17592186406136}] :answer-field/correct {:db/id #edb/ref 17592186406136} :answer-field/id #uuid "54d96522-dfeb-5f80-a0ed-2a7857020f6e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406006}] :question/id #uuid "b8fcb546-d6c9-50b5-a552-4ead01edb044" :question/problem "Source question: 7.\n\n**Question 7**\n\nFind the arc length for $x(t)=13t^2+1$, $y(t)=2t^3-1$, $0\\le t\\le2$. Give an exact answer.\n\n$s=$ {{field-1}}." :question/worked-solution "The speed is $\\sqrt{(26t)^2+(6t^2)^2}=2t\\sqrt{169+9t^2}$ on this interval. Substituting $u=169+9t^2$ gives $s=[2(169+9t^2)^{3/2}/27]_0^2=2(205^{3/2}-2197)/27$."}] [[:assigned-problem/id #uuid "a5247ff6-ad16-5126-b1a0-b5705bcb9b50"] {:assigned-problem/content {:db/id #edb/ref 17592186405622} :assigned-problem/id #uuid "a5247ff6-ad16-5126-b1a0-b5705bcb9b50" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049487} {:db/id #edb/ref 17592186050537} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405561}] [[:answer/id #uuid "16310d9f-4770-52d6-9d88-9a92545da7d2"] {:answer/id #uuid "16310d9f-4770-52d6-9d88-9a92545da7d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "13pi" :db/id #edb/ref 17592186405874}] [[:answer-field/id #uuid "4341ad89-0605-5a47-8484-56642b05aeff"] {:answer-field/choices [{:answer/id #uuid "16310d9f-4770-52d6-9d88-9a92545da7d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "13pi" :db/id #edb/ref 17592186405874}] :answer-field/correct {:db/id #edb/ref 17592186405874} :answer-field/id #uuid "4341ad89-0605-5a47-8484-56642b05aeff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405967}] [[:question/id #uuid "138cb653-9644-50eb-9825-e0b6e9abad8b"] {:db/id #edb/ref 17592186405104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16310d9f-4770-52d6-9d88-9a92545da7d2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "13pi" :db/id #edb/ref 17592186405874}] :answer-field/correct {:db/id #edb/ref 17592186405874} :answer-field/id #uuid "4341ad89-0605-5a47-8484-56642b05aeff" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405967}] :question/id #uuid "138cb653-9644-50eb-9825-e0b6e9abad8b" :question/problem "Source question: 8.\n\n**Question 8**\n\nFind the arc length for $x(t)=13\\sin t$, $y(t)=13\\cos t$, $-\\pi/2\\le t\\le\\pi/2$. Give an exact answer.\n\n$s=$ {{field-1}}." :question/worked-solution "The speed is $\\sqrt{169\\cos^2t+169\\sin^2t}=13$. The parameter interval has length $\\pi$, so $s=13\\pi$, the length of a semicircle of radius $13$."}] [[:assigned-problem/id #uuid "fd9f92de-e279-504a-8168-89f6490bdab8"] {:assigned-problem/content {:db/id #edb/ref 17592186405104} :assigned-problem/id #uuid "fd9f92de-e279-504a-8168-89f6490bdab8" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050537} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405832}] [[:answer/id #uuid "d9a0bde4-6b9d-589b-af9a-4fdfede33418"] {:answer/id #uuid "d9a0bde4-6b9d-589b-af9a-4fdfede33418" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(5pi*sqrt(1+25pi^2)+ln(5pi+sqrt(1+25pi^2)))/2" :db/id #edb/ref 17592186406251}] [[:answer-field/id #uuid "83703d5c-2aa5-56c0-a9f5-3b2dfd7d51b8"] {:answer-field/choices [{:answer/id #uuid "d9a0bde4-6b9d-589b-af9a-4fdfede33418" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(5pi*sqrt(1+25pi^2)+ln(5pi+sqrt(1+25pi^2)))/2" :db/id #edb/ref 17592186406251}] :answer-field/correct {:db/id #edb/ref 17592186406251} :answer-field/id #uuid "83703d5c-2aa5-56c0-a9f5-3b2dfd7d51b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406089}] [[:question/id #uuid "127579f2-ed87-5852-a2d8-16b3b9558e0d"] {:db/id #edb/ref 17592186405100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9a0bde4-6b9d-589b-af9a-4fdfede33418" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(5pi*sqrt(1+25pi^2)+ln(5pi+sqrt(1+25pi^2)))/2" :db/id #edb/ref 17592186406251}] :answer-field/correct {:db/id #edb/ref 17592186406251} :answer-field/id #uuid "83703d5c-2aa5-56c0-a9f5-3b2dfd7d51b8" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406089}] :question/id #uuid "127579f2-ed87-5852-a2d8-16b3b9558e0d" :question/problem "**Question 9 — Part A**\n\nFind its exact arc length: {{field-1}}." :question/worked-solution "The derivatives are $x'=\\cos t-t\\sin t$ and $y'=\\sin t+t\\cos t$, so the squared speed is $1+t^2$. Thus $s=\\int_0^{5\\pi}\\sqrt{1+t^2}\\,dt=\\frac12[5\\pi\\sqrt{1+25\\pi^2}+\\ln(5\\pi+\\sqrt{1+25\\pi^2})]$."}] [[:answer/id #uuid "8d53ff29-be5f-5be8-a36f-5ac1ec4836cc"] {:answer/feedback "In polar form, $r=t$ and $\\theta=t$. The spiral starts at the origin, moves counterclockwise, and ends at $(-5\\pi,0)$ after $2.5$ turns. At $t=9\\pi/2$ it crosses the positive $y$-axis near $14.14$, matching this graph." :answer/id #uuid "8d53ff29-be5f-5be8-a36f-5ac1ec4836cc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/37/372d7deacc99d3b233815fe3d95c094d6cdaa98b5f3cd407d7e95a13667be2d7.png" :db/id #edb/ref 17592186406106}] [[:answer/id #uuid "74ffc6d4-a13c-591e-998e-086358d4dbf8"] {:answer/feedback "The outer arc here passes below the origin before reaching the negative $x$-axis. The required final half-turn has $4\\pi\\le t\\le5\\pi$, where $\\sin t\\ge0$, so that arc must lie above the $x$-axis." :answer/id #uuid "74ffc6d4-a13c-591e-998e-086358d4dbf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/76/7614756ffc7255c13fe186e66808f0e582f89f724f528ce6ee4a1a0c1366ea97.png" :db/id #edb/ref 17592186406058}] [[:answer/id #uuid "fa4c4dc5-5732-593f-b9d1-70bff13314d6"] {:answer/feedback "This spiral ends on the positive $x$-axis. At the required endpoint, $x(5\\pi)=5\\pi\\cos(5\\pi)=-5\\pi$ and $y(5\\pi)=0$." :answer/id #uuid "fa4c4dc5-5732-593f-b9d1-70bff13314d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/6c/6ced21be689964ce9e98983942308acc90bc892fc0e338872b5e1d8251b1c780.png" :db/id #edb/ref 17592186406323}] [[:answer/id #uuid "2d53de56-c79c-5f26-9d1c-db57bca9ebbe"] {:answer/feedback "This spiral also ends on the positive $x$-axis. The specified interval ends at $(-5\\pi,0)$; moreover $r=t$ and $\\theta=t$ give counterclockwise outward motion." :answer/id #uuid "2d53de56-c79c-5f26-9d1c-db57bca9ebbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/1b/1b13b961523e7938a69522c271d6baba8daed266bdb9a4fe316d02126a480445.png" :db/id #edb/ref 17592186405923}] [[:answer-field/id #uuid "50766557-bec7-5380-876f-e1f1e8ffdf0d"] {:answer-field/choices [{:answer/feedback "This spiral also ends on the positive $x$-axis. The specified interval ends at $(-5\\pi,0)$; moreover $r=t$ and $\\theta=t$ give counterclockwise outward motion." :answer/id #uuid "2d53de56-c79c-5f26-9d1c-db57bca9ebbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/1b/1b13b961523e7938a69522c271d6baba8daed266bdb9a4fe316d02126a480445.png" :db/id #edb/ref 17592186405923} {:answer/feedback "The outer arc here passes below the origin before reaching the negative $x$-axis. The required final half-turn has $4\\pi\\le t\\le5\\pi$, where $\\sin t\\ge0$, so that arc must lie above the $x$-axis." :answer/id #uuid "74ffc6d4-a13c-591e-998e-086358d4dbf8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "images/76/7614756ffc7255c13fe186e66808f0e582f89f724f528ce6ee4a1a0c1366ea97.png" :db/id #edb/ref 17592186406058} {:answer/feedback "In polar form, $r=t$ and $\\theta=t$. The spiral starts at the origin, moves 