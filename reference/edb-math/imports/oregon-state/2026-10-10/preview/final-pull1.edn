7} {:db/id #edb/ref 17592186050277} {:db/id #edb/ref 17592186051090}] :db/id #edb/ref 17592186405071}] [[:answer/id #uuid "4df7af1c-bc04-5e4a-8ffe-e7972dfd0d4b"] {:answer/id #uuid "4df7af1c-bc04-5e4a-8ffe-e7972dfd0d4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x^5/5+5" :db/id #edb/ref 17592186405996}] [[:answer-field/id #uuid "e8ade808-2eac-502b-9bd7-fd9992456c80"] {:answer-field/choices [{:answer/id #uuid "4df7af1c-bc04-5e4a-8ffe-e7972dfd0d4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x^5/5+5" :db/id #edb/ref 17592186405996}] :answer-field/correct {:db/id #edb/ref 17592186405996} :answer-field/id #uuid "e8ade808-2eac-502b-9bd7-fd9992456c80" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406277}] [[:question/id #uuid "9188c534-eecb-580b-8ca2-b0d089a1834b"] {:db/id #edb/ref 17592186405509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4df7af1c-bc04-5e4a-8ffe-e7972dfd0d4b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "x^5/5+5" :db/id #edb/ref 17592186405996}] :answer-field/correct {:db/id #edb/ref 17592186405996} :answer-field/id #uuid "e8ade808-2eac-502b-9bd7-fd9992456c80" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406277}] :question/id #uuid "9188c534-eecb-580b-8ca2-b0d089a1834b" :question/problem "**Question 2 — Part A**\n\n$y'(x)=x^4,\\quad y(0)=5$.\n\n$y(x)=$ {{field-1}}." :question/worked-solution "Integrating $x^4$ gives $x^5/5+C$. The value at $0$ fixes $C=5$. Differentiating the result recovers $x^4$."}] [[:answer/id #uuid "272b1a8c-e382-54d7-8793-5798410e86c3"] {:answer/id #uuid "272b1a8c-e382-54d7-8793-5798410e86c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x^(3/2)/3+4" :db/id #edb/ref 17592186405909}] [[:answer-field/id #uuid "98e85d5f-3f25-5936-8ddd-6f2569924523"] {:answer-field/choices [{:answer/id #uuid "272b1a8c-e382-54d7-8793-5798410e86c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x^(3/2)/3+4" :db/id #edb/ref 17592186405909}] :answer-field/correct {:db/id #edb/ref 17592186405909} :answer-field/id #uuid "98e85d5f-3f25-5936-8ddd-6f2569924523" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406124}] [[:question/id #uuid "6356ed6a-ade3-5dff-93b8-239095fa922a"] {:db/id #edb/ref 17592186405350 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "272b1a8c-e382-54d7-8793-5798410e86c3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x^(3/2)/3+4" :db/id #edb/ref 17592186405909}] :answer-field/correct {:db/id #edb/ref 17592186405909} :answer-field/id #uuid "98e85d5f-3f25-5936-8ddd-6f2569924523" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406124}] :question/id #uuid "6356ed6a-ade3-5dff-93b8-239095fa922a" :question/problem "**Question 2 — Part B**\n\n$y'(x)=\\sqrt{x},\\quad y(0)=4$.\n\n$y(x)=$ {{field-1}}, for $x\\ge0$." :question/worked-solution "Integrate $x^{1/2}$ to get $(2/3)x^{3/2}+C$. The initial condition sets $C=4$. This real solution is defined for $x\\ge0$; its derivative at the endpoint is understood from the right."}] [[:answer/id #uuid "05f34f9e-a42b-5ca4-92ff-78f343cf89ca"] {:answer/id #uuid "05f34f9e-a42b-5ca4-92ff-78f343cf89ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "15-5cos(x)" :db/id #edb/ref 17592186405845}] [[:answer-field/id #uuid "7f33dc55-1ed1-5ccc-a1f8-1aab4b5e7da7"] {:answer-field/choices [{:answer/id #uuid "05f34f9e-a42b-5ca4-92ff-78f343cf89ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "15-5cos(x)" :db/id #edb/ref 17592186405845}] :answer-field/correct {:db/id #edb/ref 17592186405845} :answer-field/id #uuid "7f33dc55-1ed1-5ccc-a1f8-1aab4b5e7da7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406078}] [[:question/id #uuid "f06eea79-3c3d-5368-935f-83b346a40f7f"] {:db/id #edb/ref 17592186405791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f34f9e-a42b-5ca4-92ff-78f343cf89ca" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "15-5cos(x)" :db/id #edb/ref 17592186405845}] :answer-field/correct {:db/id #edb/ref 17592186405845} :answer-field/id #uuid "7f33dc55-1ed1-5ccc-a1f8-1aab4b5e7da7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406078}] :question/id #uuid "f06eea79-3c3d-5368-935f-83b346a40f7f" :question/problem "**Question 2 — Part C**\n\n$y'(x)=5\\sin(x),\\quad y(0)=10$.\n\n$y(x)=$ {{field-1}}." :question/worked-solution "An antiderivative of $5\\sin x$ is $-5\\cos x$. Setting $-5+C=10$ gives $C=15$, and $y\\prime=5\\sin x$."}] [[:answer/id #uuid "7a6645d5-f9e5-5f4a-8cc6-03b9d0e025bb"] {:answer/id #uuid "7a6645d5-f9e5-5f4a-8cc6-03b9d0e025bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "ln(x)+3" :db/id #edb/ref 17592186406066}] [[:answer-field/id #uuid "c98f1dbc-b49e-5783-b759-f27679c75927"] {:answer-field/choices [{:answer/id #uuid "7a6645d5-f9e5-5f4a-8cc6-03b9d0e025bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "ln(x)+3" :db/id #edb/ref 17592186406066}] :answer-field/correct {:db/id #edb/ref 17592186406066} :answer-field/id #uuid "c98f1dbc-b49e-5783-b759-f27679c75927" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406219}] [[:question/id #uuid "a14906b0-4d4b-5a16-b145-872851409e4e"] {:db/id #edb/ref 17592186405550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a6645d5-f9e5-5f4a-8cc6-03b9d0e025bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "ln(x)+3" :db/id #edb/ref 17592186406066}] :answer-field/correct {:db/id #edb/ref 17592186406066} :answer-field/id #uuid "c98f1dbc-b49e-5783-b759-f27679c75927" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406219}] :question/id #uuid "a14906b0-4d4b-5a16-b145-872851409e4e" :question/problem "**Question 2 — Part D**\n\n$y'(x)=\\dfrac{1}{x},\\quad y(1)=3$.\n\n$y(x)=$ {{field-1}}, on $x>0$." :question/worked-solution "Integrate to $\\ln|x|+C$. The interval containing the initial point $x=1$ is positive, so use $\\ln x$. At $1$, the logarithm is zero and $C=3$. The solution cannot cross the singular point $x=0$."}] [[:step/id #uuid "cf11b0b8-4f07-58fb-98a7-8548897d5184"] {:db/id #edb/ref 17592186405685 :step/content {:db/id #edb/ref 17592186405509} :step/id #uuid "cf11b0b8-4f07-58fb-98a7-8548897d5184" :step/next {:db/id #edb/ref 17592186405792}}] [[:step/id #uuid "f07e17ad-26f9-5b56-86d8-0353ce3eeff6"] {:db/id #edb/ref 17592186405792 :step/content {:db/id #edb/ref 17592186405350} :step/id #uuid "f07e17ad-26f9-5b56-86d8-0353ce3eeff6" :step/next {:db/id #edb/ref 17592186405554}}] [[:step/id #uuid "a23e4c72-cbd6-54c2-8d0a-76055109f351"] {:db/id #edb/ref 17592186405554 :step/content {:db/id #edb/ref 17592186405791} :step/id #uuid "a23e4c72-cbd6-54c2-8d0a-76055109f351" :step/next {:db/id #edb/ref 17592186405775}}] [[:step/id #uuid "ec773a7f-03c6-5243-8e45-f3ed66d38daf"] {:db/id #edb/ref 17592186405775 :step/content {:db/id #edb/ref 17592186405550} :step/id #uuid "ec773a7f-03c6-5243-8e45-f3ed66d38daf"}] [[:multistep/id #uuid "9768ff19-fbdb-57cb-98b2-c90310055446"] {:db/id #edb/ref 17592186405522 :multistep/context "Source question: 2.\n\nSolving initial value problems was an important application of integration from MTH 252. Recall that the function $y(x)$ satisfying\n\n$$\ny'(x)=f(x),\\qquad y(x_0)=a\n$$\n\nis\n\n$$\ny(x)=a+\\int_{x_0}^x f(s)\\,ds.\n$$\n\nThe function $y(x)$ is known as the solution to the initial value problem. Solve the following initial value problems:" :multistep/first-step {:db/id #edb/ref 17592186405685} :multistep/id #uuid "9768ff19-fbdb-57cb-98b2-c90310055446" :multistep/steps [{:db/id #edb/ref 17592186405554 :step/content {:db/id #edb/ref 17592186405791} :step/id #uuid "a23e4c72-cbd6-54c2-8d0a-76055109f351" :step/next {:db/id #edb/ref 17592186405775}} {:db/id #edb/ref 17592186405685 :step/content {:db/id #edb/ref 17592186405509} :step/id #uuid "cf11b0b8-4f07-58fb-98a7-8548897d5184" :step/next {:db/id #edb/ref 17592186405792}} {:db/id #edb/ref 17592186405775 :step/content {:db/id #edb/ref 17592186405550} :step/id #uuid "ec773a7f-03c6-5243-8e45-f3ed66d38daf"} {:db/id #edb/ref 17592186405792 :step/content {:db/id #edb/ref 17592186405350} :step/id #uuid "f07e17ad-26f9-5b56-86d8-0353ce3eeff6" :step/next {:db/id #edb/ref 17592186405554}}]}] [[:assigned-problem/id #uuid "0bce51e8-64a9-50f7-9b97-b4fda3322256"] {:assigned-problem/content {:db/id #edb/ref 17592186405522} :assigned-problem/id #uuid "0bce51e8-64a9-50f7-9b97-b4fda3322256" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049386} {:db/id #edb/ref 17592186049487}] :db/id #edb/ref 17592186405085}] [[:question/id #uuid "7e087087-e9d1-5aab-955b-b1c9a4f59158"] {:db/id #edb/ref 17592186405444 :question/id #uuid "7e087087-e9d1-5aab-955b-b1c9a4f59158" :question/problem "**Question 3 — Part A**\n\nUse the product rule to express the following in terms of $e^x$, $y$, and $y'$:\n\n$$\n\\frac{d}{dx}(e^xy).\n$$\n\nIf $e^xy'+e^xy=0$, what must be true about $\\dfrac{d}{dx}(e^xy)$?" :question/worked-solution "$\\frac{d}{dx}(e^xy)=e^xy+e^xy\\prime$. By the given differential equation this derivative equals $0$.\n\nThe product rule combines the two terms of the ODE into one derivative. The zero is the derivative of the product, not a claim that $y$ or $e^xy$ itself must be zero."}] [[:question/id #uuid "a55f2244-ab74-5fa5-bc3c-af255c731687"] {:db/id #edb/ref 17592186405562 :question/id #uuid "a55f2244-ab74-5fa5-bc3c-af255c731687" :question/problem "**Question 3 — Part B**\n\nWhat does part (a) imply about $e^xy$?" :question/worked-solution "The product $e^xy$ is constant: $e^xy=C$.\n\nA differentiable function with derivative zero throughout an interval is constant on that interval. That constant is determined by the initial condition, not assumed to be zero."}] [[:answer/id #uuid "08fc8afb-8112-519b-9419-f89f3bd25c11"] {:answer/id #uuid "08fc8afb-8112-519b-9419-f89f3bd25c11" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "y_0" :db/id #edb/ref 17592186405847}] [[:answer-field/id #uuid "24795a7a-9f66-5b46-9fb6-bc3405e2ac0a"] {:answer-field/choices [{:answer/id #uuid "08fc8afb-8112-519b-9419-f89f3bd25c11" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "y_0" :db/id #edb/ref 17592186405847}] :answer-field/correct {:db/id #edb/ref 17592186405847} :answer-field/id #uuid "24795a7a-9f66-5b46-9fb6-bc3405e2ac0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405903}] [[:question/id #uuid "c8c2dd09-f362-5d9d-ac5a-b26dfebc7a7e"] {:db/id #edb/ref 17592186405671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fc8afb-8112-519b-9419-f89f3bd25c11" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "y_0" :db/id #edb/ref 17592186405847}] :answer-field/correct {:db/id #edb/ref 17592186405847} :answer-field/id #uuid "24795a7a-9f66-5b46-9fb6-bc3405e2ac0a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405903}] :question/id #uuid "c8c2dd09-f362-5d9d-ac5a-b26dfebc7a7e" :question/problem "**Question 3 — Part C**\n\nIf $y(0)=y_0$, what is $e^0y(0)$ equal to?\n\n$e^0y(0)=$ {{field-1}}." :question/worked-solution "Since $e^0=1$ and $y(0)=y_0$, the constant value of $e^xy$ is $y_0$."}] [[:answer/id #uuid "cb3fa81b-1016-56eb-9fa1-e68d9a478914"] {:answer/id #uuid "cb3fa81b-1016-56eb-9fa1-e68d9a478914" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "y_0*e^(-x)" :db/id #edb/ref 17592186406222}] [[:answer-field/id #uuid "5e221039-12e5-5f2d-ac1a-64933e7ab5f1"] {:answer-field/choices [{:answer/id #uuid "cb3fa81b-1016-56eb-9fa1-e68d9a478914" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "y_0*e^(-x)" :db/id #edb/ref 17592186406222}] :answer-field/correct {:db/id #edb/ref 17592186406222} :answer-field/id #uuid "5e221039-12e5-5f2d-ac1a-64933e7ab5f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406018}] [[:question/id #uuid "817abe0c-0d61-5710-8723-65691e6065d4"] {:db/id #edb/ref 17592186405450 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb3fa81b-1016-56eb-9fa1-e68d9a478914" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "y_0*e^(-x)" :db/id #edb/ref 17592186406222}] :answer-field/correct {:db/id #edb/ref 17592186406222} :answer-field/id #uuid "5e221039-12e5-5f2d-ac1a-64933e7ab5f1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406018}] :question/id #uuid "817abe0c-0d61-5710-8723-65691e6065d4" :question/problem "**Question 3 — Part D**\n\nUse the above to determine what $y(x)$ must be equal to.\n\n$y(x)=$ {{field-1}}." :question/worked-solution "From $e^xy=y_0$, divide by $e^x>0$ to get $y=y_0e^{-x}$. Its derivative is $-y_0e^{-x}=-y$, and at $x=0$ its value is $y_0$."}] [[:step/id #uuid "486db1f7-1b40-52b7-88d7-53ae04f0c008"] {:db/id #edb/ref 17592186405277 :step/content {:db/id #edb/ref 17592186405444} :step/id #uuid "486db1f7-1b40-52b7-88d7-53ae04f0c008" :step/next {:db/id #edb/ref 17592186405367}}] [[:step/id #uuid "67080205-77f9-57c4-92b3-4dd6faded73f"] {:db/id #edb/ref 17592186405367 :step/content {:db/id #edb/ref 17592186405562} :step/id #uuid "67080205-77f9-57c4-92b3-4dd6faded73f" :step/next {:db/id #edb/ref 17592186405468}}] [[:step/id #uuid "85e946e9-046b-5c63-94e0-0364425689c5"] {:db/id #edb/ref 17592186405468 :step/content {:db/id #edb/ref 17592186405671} :step/id #uuid "85e946e9-046b-5c63-94e0-0364425689c5" :step/next {:db/id #edb/ref 17592186405167}}] [[:step/id #uuid "27680012-56a3-5c80-ae3b-080fff69670a"] {:db/id #edb/ref 17592186405167 :step/content 