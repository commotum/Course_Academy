86406055}] [[:answer-field/id #uuid "8190563d-f55b-56b1-bda7-2d13d777c400"] {:answer-field/choices [{:answer/id #uuid "72a01d66-1bd2-5d28-ad71-50369f0fe5b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-3164k" :db/id #edb/ref 17592186406055}] :answer-field/correct {:db/id #edb/ref 17592186406055} :answer-field/id #uuid "8190563d-f55b-56b1-bda7-2d13d777c400" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406083}] [[:question/id #uuid "7ba0c993-1461-54bf-ab68-81e93a577d6d"] {:db/id #edb/ref 17592186405439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72a01d66-1bd2-5d28-ad71-50369f0fe5b1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-3164k" :db/id #edb/ref 17592186406055}] :answer-field/correct {:db/id #edb/ref 17592186406055} :answer-field/id #uuid "8190563d-f55b-56b1-bda7-2d13d777c400" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406083}] :question/id #uuid "7ba0c993-1461-54bf-ab68-81e93a577d6d" :question/problem "Source question: 22.\n\nAn object follows $\\mathbf r(t)=\\langle16t,14t-3t^2\\rangle$ from t=0 to t=7. A force has magnitude proportional to speed and direction opposite velocity. Find its work W, using k for the proportionality constant.\n\nAnswer: {{answer}}." :question/worked-solution "The force is $F=-k r\\prime$, so $W=-k\\int_0^7\\|r\\prime\\|^2dt=-k\\int_0^7[256+(14-6t)^2]dt=-k(1792+1372)$. The negative sign agrees with resistance to motion."}] [[:assigned-problem/id #uuid "fad67b1b-8827-5dd4-8516-ee49051ec6d6"] {:assigned-problem/content {:db/id #edb/ref 17592186405439} :assigned-problem/id #uuid "fad67b1b-8827-5dd4-8516-ee49051ec6d6" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048960} {:db/id #edb/ref 17592186049859}] :db/id #edb/ref 17592186405823}] [[:answer/id #uuid "aac1d599-cf3c-59fb-a875-5d27d9ffe9ae"] {:answer/id #uuid "aac1d599-cf3c-59fb-a875-5d27d9ffe9ae" :an