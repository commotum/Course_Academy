ces [{:answer/id #uuid "39fe0ad1-a1ca-5b32-8b41-c31be535c9c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle0,0,0\\rangle" :db/id #edb/ref 17592186405939}] :answer-field/correct {:db/id #edb/ref 17592186405939} :answer-field/id #uuid "d27576ae-37d1-5531-b031-a486725b13bc" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406235}] [[:question/id #uuid "2c8e935b-4fff-5d0b-92dd-00eb9a4ff1f3"] {:db/id #edb/ref 17592186405180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39fe0ad1-a1ca-5b32-8b41-c31be535c9c8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle0,0,0\\rangle" :db/id #edb/ref 17592186405939}] :answer-field/correct {:db/id #edb/ref 17592186405939} :answer-field/id #uuid "d27576ae-37d1-5531-b031-a486725b13bc" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406235}] :question/id #uuid "2c8e935b-4fff-5d0b-92dd-00eb9a4ff1f3" :question/problem "Source question: 1.\n\nFind $\\nabla\\times\\mathbf F$ for $\\mathbf F=\\langle4x,2y,0\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "For F=(P,Q,R), curl F=(R_y−Q_z,P_z−R_x,Q_x−P_y). All six cross partials here vanish."}] [[:assigned-problem/id #uuid "7a4dd39c-1d2c-5300-b344-442151bffcae"] {:assigned-problem/content {:db/id #edb/ref 17592186405180} :assigned-problem/id #uuid "7a4dd39c-1d2c-5300-b344-442151bffcae" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405432}] [[:answer/id #uuid "db6dbad6-0385-5dab-b584-938b9bc1948f"] {:answer/id #uuid "db6dbad6-0385-5dab-b584-938b9bc1948f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle-6y^2\\cos(6z),54xyz^8-3e^{6z},-6xz^9\\rangle" :db/id #edb/ref 17592186406256}] [[:answer-field/id #uuid "e4272ecc-bfbd-5387-8df9-eb292cf38b01"] {:answer-field/choices [{:answer/id #uuid "db6dbad6-0385-5dab-b584-938b9bc1948f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle-6y^2\\cos(6z),54xyz^8-3e^{6z},-6xz^9\\rangle" :db/id #edb/ref 17592186406256}] :answer-field/correct {:db/id #edb/ref 17592186406256} :answer-field/id #uuid "e4272ecc-bfbd-5387-8df9-eb292cf38b01" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406269}] [[:question/id #uuid "c28d5052-b40d-5f11-bc21-0d49dee27a1b"] {:db/id #edb/ref 17592186405652 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "db6dbad6-0385-5dab-b584-938b9bc1948f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle-6y^2\\cos(6z),54xyz^8-3e^{6z},-6xz^9\\rangle" :db/id #edb/ref 17592186406256}] :answer-field/correct {:db/id #edb/ref 17592186406256} :answer-field/id #uuid "e4272ecc-bfbd-5387-8df9-eb292cf38b01" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406269}] :question/id #uuid "c28d5052-b40d-5f11-bc21-0d49dee27a1b" :question/problem "Source question: 2.\n\nFind $\\nabla\\times\\mathbf F$ for $\\mathbf F=\\langle6xyz^9,y^2\\sin(6z),3xe^{6z}\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "Use (R_y−Q_z,P_z−R_x,Q_x−P_y). The pairs of derivatives are (0,6y²cos(6z)), (54xyz⁸,3e⁶ᶻ), and (0,6xz⁹). The second component is P_z−R_x, so keep that subtraction order."}] [[:assigned-problem/id #uuid "5a1d8c22-269a-5902-bc22-58d19093d606"] {:assigned-problem/content {:db/id #edb/ref 17592186405652} :assigned-problem/id #uuid "5a1d8c22-269a-5902-bc22-58d19093d606" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405324}] [[:answer/id #uuid "c1e2f603-e6e9-5f87-9e40-c18942d6d31c"] {:answer/id #uuid "c1e2f603-e6e9-5f87-9e40-c18942d6d31c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle4z-32xz^7,7y,4z^8-7z\\rangle" :db/id #edb/ref 17592186406205}] [[:answer-field/id #uuid "0bdc9ae9-aa96-5398-aa3a-02d07dfaecd5"] {:answer-field/choices [{:answer/id #uuid "c1e2f603-e6e9-5f87-9e40-c18942d6d31c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle4z-32xz^7,7y,4z^8-7z\\rangle" :db/id #edb/ref 17592186406205}] :answer-field/correct {:db/id #edb/ref 17592186406205} :answer-field/id #uuid "0bdc9ae9-aa96-5398-aa3a-02d07dfaecd5" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405850}] [[:question/id #uuid "2351fba0-a80b-50c0-a594-02a4735d09ee"] {:db/id #edb/ref 17592186405150 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1e2f603-e6e9-5f87-9e40-c18942d6d31c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle4z-32xz^7,7y,4z^8-7z\\rangle" :db/id #edb/ref 17592186406205}] :answer-field/correct {:db/id #edb/ref 17592186406205} :answer-field/id #uuid "0bdc9ae9-aa96-5398-aa3a-02d07dfaecd5" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405850}] :question/id #uuid "2351fba0-a80b-50c0-a594-02a4735d09ee" :question/problem "Source question: 3.\n\nFind $\\nabla\\times\\mathbf F$ for $\\mathbf F=\\langle7yz,4z^8x,4yz\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "The first component is R_y−Q_z=4z−32xz⁷. The second is P_z−R_x=7y−0, and the third is Q_x−P_y=4z⁸−7z."}] [[:assigned-problem/id #uuid "38596a05-50aa-5553-9465-1f1519b03cf6"] {:assigned-problem/content {:db/id #edb/ref 17592186405150} :assigned-problem/id #uuid "38596a05-50aa-5553-9465-1f1519b03cf6" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405216}] [[:answer/id #uuid "ae7a903a-2b79-5241-b774-014914320167"] {:answer/id #uuid "ae7a903a-2b79-5241-b774-014914320167" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle0,-8,-5y^8\\sin(xy^8)-32x\\cos(8xy)\\rangle" :db/id #edb/ref 17592186406168}] [[:answer-field/id #uuid "b67ee8e3-b954-5615-a8f5-05f53659a424"] {:answer-field/choices [{:answer/id #uuid "ae7a903a-2b79-5241-b774-014914320167" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle0,-8,-5y^8\\sin(xy^8)-32x\\cos(8xy)\\rangle" :db/id #edb/ref 17592186406168}] :answer-field/correct {:db/id #edb/ref 17592186406168} :answer-field/id #uuid "b67ee8e3-b954-5615-a8f5-05f53659a424" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406188}] [[:question/id #uuid "6cb915d9-32da-5882-8a15-52de048ec570"] {:db/id #edb/ref 17592186405382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ae7a903a-2b79-5241-b774-014914320167" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle0,-8,-5y^8\\sin(xy^8)-32x\\cos(8xy)\\rangle" :db/id #edb/ref 17592186406168}] :answer-field/correct {:db/id #edb/ref 17592186406168} :answer-field/id #uuid "b67ee8e3-b954-5615-a8f5-05f53659a424" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406188}] :question/id #uuid "6cb915d9-32da-5882-8a15-52de048ec570" :question/problem "Source question: 4.\n\nFind $\\nabla\\times\\mathbf F$ for $\\mathbf F=\\langle4\\sin(8xy),5\\cos(xy^8),8x\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "R_y−Q_z=0. P_z−R_x=−8. By the chain rule, Q_x=−5y⁸sin(xy⁸) and P_y=32xcos(8xy); subtract these to obtain the third component."}] [[:assigned-problem/id #uuid "d758e0ad-d448-5694-826e-683c9e4dd7ad"] {:assigned-problem/content {:db/id #edb/ref 17592186405382} :assigned-problem/id #uuid "d758e0ad-d448-5694-826e-683c9e4dd7ad" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405714}] [[:answer/id #uuid "fe655b2b-e1c5-5bdc-97d7-4ceee9bdca58"] {:answer/id #uuid "fe655b2b-e1c5-5bdc-97d7-4ceee9bdca58" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle-9,-6,-1\\rangle" :db/id #edb/ref 17592186406333}] [[:answer-field/id #uuid "60a5dafd-6daf-5b68-90cd-7a47d02680c0"] {:answer-field/choices [{:answer/id #uuid "fe655b2b-e1c5-5bdc-97d7-4ceee9bdca58" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle-9,-6,-1\\rangle" :db/id #edb/ref 17592186406333}] :answer-field/correct {:db/id #edb/ref 17592186406333} :answer-field/id #uuid "60a5dafd-6daf-5b68-90cd-7a47d02680c0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406022}] [[:question/id #uuid "735c0ea9-3a81-5b5f-a1e0-8fa3c4265e9c"] {:db/id #edb/ref 17592186405414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe655b2b-e1c5-5bdc-97d7-4ceee9bdca58" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\langle-9,-6,-1\\rangle" :db/id #edb/ref 17592186406333}] :answer-field/correct {:db/id #edb/ref 17592186406333} :answer-field/id #uuid "60a5dafd-6daf-5b68-90cd-7a47d02680c0" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406022}] :question/id #uuid "735c0ea9-3a81-5b5f-a1e0-8fa3c4265e9c" :question/problem "Source question: 5.\n\nFind $\\nabla\\times\\mathbf F$ for $\\mathbf F=\\langle3x+y,3y+9z,5z+6x\\rangle$.\n\nAnswer: {{answer}}." :question/worked-solution "The three components are R_y−Q_z=0−9, P_z−R_x=0−6, and Q_x−P_y=0−1."}] [[:assigned-problem/id #uuid "c7d73c74-4819-5800-ae90-b373e4fa2605"] {:assigned-problem/content {:db/id #edb/ref 17592186405414} :assigned-problem/id #uuid "c7d73c74-4819-5800-ae90-b373e4fa2605" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405666}] [[:answer/id #uuid "82049242-c15d-5594-bd1d-31a0c59f46c6"] {:answer/id #uuid "82049242-c15d-5594-bd1d-31a0c59f46c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "24\\pi" :db/id #edb/ref 17592186406087}] [[:answer-field/id #uuid "edf0b0de-4225-5062-b4c3-e7140791713c"] {:answer-field/choices [{:answer/id #uuid "82049242-c15d-5594-bd1d-31a0c59f46c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "24\\pi" :db/id #edb/ref 17592186406087}] :answer-field/correct {:db/id #edb/ref 17592186406087} :answer-field/id #uuid "edf0b0de-4225-5062-b4c3-e7140791713c" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406287}] [[:question/id #uuid "550d2871-2ff9-50f1-976f-5226181d2091"] {:db/id #edb/ref 17592186405312 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82049242-c15d-5594-bd1d-31a0c59f46c6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "24\\pi" :db/id #edb/ref 17592186406087}] :answer-field/correct {:db/id #edb/ref 17592186406087} :answer-field/id #uuid "edf0b0de-4225-5062-b4c3-e7140791713c" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406287}] :question/id #uuid "550d2871-2ff9-50f1-976f-5226181d2091" :question/problem "Source question: 6.\n\nUse Stokes’ theorem to find $\\iint_S(\\nabla\\times\\mathbf F)\\cdot\\mathbf n\\,dS$, where $\\mathbf F=\\langle3z,8x,9y\\rangle$ and S is the paraboloid cap $z=6-x^2-y^2$, z≥3. **Source ambiguity:** No normal direction is given; use the upward normal for this study answer.\n\nAnswer: {{answer}}." :question/worked-solution "The boundary is the circle x²+y²=3 at z=3. Replace the cap by the upward-oriented disk with the same boundary. The curl is (9,3,8), so its flux through the disk is 8 times its area, 8·3π=24π. A downward normal gives −24π. If “surface enclosed” were intended to include a closing base as well, the total curl flux of that closed surface would be 0."}] [[:assigned-problem/id #uuid "a02928b4-af79-5c8e-b095-b3c99d652102"] {:assigned-problem/content {:db/id #edb/ref 17592186405312} :assigned-problem/id #uuid "a02928b4-af79-5c8e-b095-b3c99d652102" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049768} {:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405548}] [[:answer/id #uuid "31a00d6a-6825-5703-9bea-4e0a699797e1"] {:answer/id #uuid "31a00d6a-6825-5703-9bea-4e0a699797e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "147\\pi" :db/id #edb/ref 17592186405929}] [[:answer-field/id #uuid "22511fff-833b-52ee-bff3-1f5339951dcf"] {:answer-field/choices [{:answer/id #uuid "31a00d6a-6825-5703-9bea-4e0a699797e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "147\\pi" :db/id #edb/ref 17592186405929}] :answer-field/correct {:db/id #edb/ref 17592186405929} :answer-field/id #uuid "22511fff-833b-52ee-bff3-1f5339951dcf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405899}] [[:question/id #uuid "cf20a424-ee80-53f7-a6d6-b5756b63d69b"] {:db/id #edb/ref 17592186405686 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31a00d6a-6825-5703-9bea-4e0a699797e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "147\\pi" :db/id #edb/ref 17592186405929}] :answer-field/correct {:db/id #edb/ref 17592186405929} :answer-field/id #uuid "22511fff-833b-52ee-bff3-1f5339951dcf" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405899}] :question/id #uuid "cf20a424-ee80-53f7-a6d6-b5756b63d69b" :question/problem "Source question: 7.\n\nUse Stokes’ theorem to find $\\oint_C[2x\\,dx+(3x+y)dy+(6x+y+z)dz]$, where $\\mathbf r(t)=\\langle7\\cos t,7\\sin t,7\\rangle$, 0≤t≤2π, counterclockwise.\n\nAnswer: {{answer}}." :question/worked-solution "The curl of (2x,3x+y,6x+y+z) is (1,−6,3). Use the horizontal radius-7 disk with upward normal. Only its third component contributes: 3·π·7²=147π."}] [[:assigned-problem/id #uuid "3c0a433d-29b9-540c-a344-f1d9fa83b28f"] {:assigned-problem/content {:db/id #edb/ref 17592186405686} :assigned-problem/id #uuid "3c0a433d-29b9-540c-a344-f1d9fa83b28f" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049768} {:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405226}] [[:answer/id #uuid "6a6072c7-8913-5c94-a673-19787d20a248"] {:answer/id #uuid "6a6072c7-8913-5c94-a673-19787d20a248" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-648" :db/id #edb/ref 17592186406044}] [[:answer-field/id #uuid "943bf5a0-a2ea-52ab-a656-9fef91072811"] {:answer-field/choices [{:answer/id #uuid "6a6072c7-8913-5c94-a673-19787d20a248" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-648" :db/id #edb/ref 17592186406044}] :answer-field/correct {:db/id #edb/ref 17592186406044} :answer-field/id #uuid "943bf5a0-a2ea-52ab-a656-9fef91072811" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406115}] [[:question/id #uuid "060f02f4-487e-5f5b-8a1c-5f000f57d3c8"] {:db/id #edb/ref 17592186405070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a6072c7-8913-5c94-a673-19787d20a248" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-648" :db/id #edb/ref 17592186406044}] :answer-field/correct {:db/id #edb/ref 17592186406044} :answer-field/id #uuid "943bf5a0-a2ea-52ab-a656-9fef91072811" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406115}] :question/id #uuid "060f02f4-487e-5f5b-8a1c-5f000f57d3c8" :question/problem "Source question: 8.\n\nUse Stokes’ theorem to find $\\oint_C[3y^2dx+3z^2dy+3x^2dz]$, where C is the triangle with vertices (6,0,0), (0,6,0), (0,0,6), oriented counterclockwise. Interpret counterclockwise as viewed from above (positive z).\n\nAnswer: {{answer}}." :question/worked-solution "The spanning plane is z=6−x−y, with upward vector area (1,1,1)dxdy. Curl F=(−6z,−6x,−6y); its dot product with (1,1,1) is −6(x+y+z)=−36. The xy-projection has area 6·6/2=18, so the integral is −648. The reverse traversal gives +648."}] [[:assigned-problem/id #uuid "6a660494-6591-503b-a265-1ffd682ec62f"] {:assigned-problem/content {:db/id #edb/ref 17592186405070} :assigned-problem/id #uuid "6a660494-6591-503b-a265-1ffd682ec62f" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049768} {:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405375}] [[:answer/id #uuid "a15b4005-2837-5733-b472-a3d8f6d8fa2d"] {:answer/feedback "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero." :answer/id #uuid "a15b4005-2837-5733-b472-a3d8f6d8fa2d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186406145}] [[:answer/id #uuid "4be6778c-c76f-5fdd-a192-c57aefaed237"] {:answer/feedback "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero." :answer/id #uuid "4be6778c-c76f-5fdd-a192-c57aefaed237" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186405989}] [[:answer-field/id #uuid "0c3374f9-7485-5053-80c6-8b4e17472f2a"] {:answer-field/choices [{:answer/feedback "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero." :answer/id #uuid "4be6778c-c76f-5fdd-a192-c57aefaed237" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186405989} {:answer/feedback "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero." :answer/id #uuid "a15b4005-2837-5733-b472-a3d8f6d8fa2d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186406145}] :answer-field/correct {:db/id #edb/ref 17592186406145} :answer-field/id #uuid "0c3374f9-7485-5053-80c6-8b4e17472f2a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186405851}] [[:question/id #uuid "c661bc94-62bf-5770-8a4a-56c5e6619ad9"] {:db/id #edb/ref 17592186405660 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero." :answer/id #uuid "4be6778c-c76f-5fdd-a192-c57aefaed237" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186405989} {:answer/feedback "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero." :answer/id #uuid "a15b4005-2837-5733-b472-a3d8f6d8fa2d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186406145}] :answer-field/correct {:db/id #edb/ref 17592186406145} :answer-field/id #uuid "0c3374f9-7485-5053-80c6-8b4e17472f2a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186405851}] :question/id #uuid "c661bc94-62bf-5770-8a4a-56c5e6619ad9" :question/problem "Source question: 9.\n\nDetermine whether the following force is a conservative vector field.\n\n$\\mathbf F=\\langle6x,9y,0\\rangle$." :question/worked-solution "The potential f=3x²+(9/2)y² has gradient F throughout space. Thus F is conservative; its curl is also identically zero."}] [[:assigned-problem/id #uuid "b3e8e1a3-5204-5945-864b-0e77d882e961"] {:assigned-problem/content {:db/id #edb/ref 17592186405660} :assigned-problem/id #uuid "b3e8e1a3-5204-5945-864b-0e77d882e961" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050989}] :db/id #edb/ref 17592186405601}] [[:answer/id #uuid "15d9c977-53b8-5abb-b416-ee71db17a1b2"] {:answer/feedback "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0." :answer/id #uuid "15d9c977-53b8-5abb-b416-ee71db17a1b2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186405873}] [[:answer/id #uuid "61d0ba5d-5961-5f95-93b5-4bc2c76262e1"] {:answer/feedback "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0." :answer/id #uuid "61d0ba5d-5961-5f95-93b5-4bc2c76262e1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186406025}] [[:answer-field/id #uuid "af7b7953-265d-59bf-9261-760d3e74b955"] {:answer-field/choices [{:answer/feedback "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0." :answer/id #uuid "15d9c977-53b8-5abb-b416-ee71db17a1b2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186405873} {:answer/feedback "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0." :answer/id #uuid "61d0ba5d-5961-5f95-93b5-4bc2c76262e1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186406025}] :answer-field/correct {:db/id #edb/ref 17592186406025} :answer-field/id #uuid "af7b7953-265d-59bf-9261-760d3e74b955" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406171}] [[:question/id #uuid "82617c5c-e6ff-5ca5-859d-739ccead9946"] {:db/id #edb/ref 17592186405456 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0." :answer/id #uuid "15d9c977-53b8-5abb-b416-ee71db17a1b2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is conservative." :db/id #edb/ref 17592186405873} {:answer/feedback "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0." :answer/id #uuid "61d0ba5d-5961-5f95-93b5-4bc2c76262e1" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "The field is not conservative." :db/id #edb/ref 17592186406025}] :answer-field/correct {:db/id #edb/ref 17592186406025} :answer-field/id #uuid "af7b7953-265d-59bf-9261-760d3e74b955" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406171}] :question/id #uuid "82617c5c-e6ff-5ca5-859d-739ccead9946" :question/problem "Source question: 10.\n\nDetermine whether the following force is a conservative vector field.\n\n$\\mathbf F=\\langle10xy,yz,8xz\\rangle$." :question/worked-solution "Curl F=(−y,−8z,−10x), which is not identically zero. Therefore F cannot be a gradient field on all of space. For instance, P_y=10x differs from Q_x=0."}] [[:assigned-problem/id #uuid "820b191f-ad2d-578f-9376-b82873b3fe03"] {:assigned-problem/content {:db/id #edb/ref 17592186405456} :assigned-problem/id #uuid "820b191f-ad2d-578f-9376-b82873b3fe03" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186051091}] :db/id #edb/ref 17592186405454}] [[:answer/id #uuid "c11e53ad-c9ec-513a-8e25-f65f0bcfc41a"] {:answer/id #uuid "c11e53ad-c9ec-513a-8e25-f65f0bcfc41a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac9{10}" :db/id #edb/ref 17592186406203}] [[:answer-field/id #uuid "91376435-f76f-5bad-9e88-32b184a2d6fb"] {:answer-field/choices [{:answer/id #uuid "c11e53ad-c9ec-513a-8e25-f65f0bcfc41a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac9{10}" :db/id #edb/ref 17592186406203}] :answer-field/correct {:db/id #edb/ref 17592186406203} :answer-field/id #uuid "91376435-f76f-5bad-9e88-32b184a2d6fb" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406111}] [[:question/id #uuid "439fb7e3-b5d0-5388-898e-ba5874d315cc"] {:db/id #edb/ref 17592186405259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c11e53ad-c9ec-513a-8e25-f65f0bcfc41a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac9{10}" :db/id #edb/ref 17592186406203}] :answer-field/correct {:db/id #edb/ref 17592186406203} :answer-field/id #uuid "91376435-f76f-5bad-9e88-32b184a2d6fb" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406111}] :question/id #uuid "439fb7e3-b5d0-5388-898e-ba5874d315cc" :question/problem "Source question: 11.\n\nFind c so that $\\mathbf F=\\langle9xy,5cx^2,0\\rangle$ is conservative in space.\n\nAnswer: {{answer}}." :question/worked-solution "The only nontrivial cross-partial condition is P_y=Q_x: 9x=10cx for every x. Hence c=9/10. A global potential is f=(9/2)x²y, independent of z, which verifies sufficiency."}] [[:assigned-problem/id #uuid "3c0ac35a-f49d-5436-8f85-53ee103e1ab8"] {:assigned-problem/content {:db/id #edb/ref 17592186405259} :assigned-problem/id #uuid "3c0ac35a-f49d-5436-8f85-53ee103e1ab8" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050989}] :db/id #edb/ref 17592186405227}] [[:answer/id #uuid "45c4f236-9f39-5a06-ad34-fc51b5199fe9"] {:answer/id #uuid "45c4f236-9f39-5a06-ad34-fc51b5199fe9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186405974}] [[:answer-field/id #uuid "9982a83f-7c0f-521c-9fe1-827914d3f514"] {:answer-field/choices [{:answer/id #uuid "45c4f236-9f39-5a06-ad34-fc51b5199fe9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186405974}] :answer-field/correct {:db/id #edb/ref 17592186405974} :answer-field/id #uuid "9982a83f-7c0f-521c-9fe1-827914d3f514" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406126}] [[:question/id #uuid "d1053cb4-da92-53ac-af0a-f0cd8596195a"] {:db/id #edb/ref 17592186405694 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45c4f236-9f39-5a06-ad34-fc51b5199fe9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186405974}] :answer-field/correct {:db/id #edb/ref 17592186405974} :answer-field/id #uuid "9982a83f-7c0f-521c-9fe1-827914d3f514" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406126}] :question/id #uuid "d1053cb4-da92-53ac-af0a-f0cd8596195a" :question/problem "Source question: 12.\n\nFind $\\iint_S\\mathbf F\\cdot\\mathbf n\\,dS$ for $\\mathbf F=\\langle8z,3x,6y\\rangle$ on the hemisphere $z=\\sqrt{1-x^2-y^2}$.\n\nAnswer: {{answer}}." :question/worked-solution "For the outward normal on the unit sphere, F·n=8xz+3xy+6yz. Each term integrates to zero by reflection symmetry: xz and xy change sign under x→−x; yz changes sign under y→−y. Thus flux is 0. The source omits orientation, but reversing the normal leaves this zero answer unchanged. A closed-surface check: div F=0 and the closing disk has flux ∫∫−6y dA=0."}] [[:assigned-problem/id #uuid "5146e3e9-3ab5-5080-aee4-539ec2512013"] {:assigned-problem/content {:db/id #edb/ref 17592186405694} :assigned-problem/id #uuid "5146e3e9-3ab5-5080-aee4-539ec2512013" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048191}] :db/id #edb/ref 17592186405304}] [[:step/id #uuid "6ec35a50-baa3-5667-8239-91e6701e8c2b"] {:db/id #edb/ref 17592186405392 :step/content {:db/id #edb/ref 17592186405362} :step/id #uuid "6ec35a50-baa3-5667-8239-91e6701e8c2b" :step/next {:db/id #edb/ref 17592186405260}}] [[:step/id #uuid "444db75a-6f7e-524a-913d-204514d0e797"] {:db/id #edb/ref 17592186405260 :step/content {:db/id #edb/ref 17592186405432} :step/id #uuid "444db75a-6f7e-524a-913d-204514d0e797" :step/next {:db/id #edb/ref 17592186405674}}] [[:step/id #uuid "c9ff89ed-bef8-5d7f-b959-fa93ea0a6171"] {:db/id #edb/ref 17592186405674 :step/content {:db/id #edb/ref 17592186405324} :step/id #uuid "c9ff89ed-bef8-5d7f-b959-fa93ea0a6171" :step/next {:db/id #edb/ref 17592186405811}}] [[:step/id #uuid "f5f22eaa-bd88-510e-85bd-716da395dcea"] {:db/id #edb/ref 17592186405811 :step/content {:db/id #edb/ref 17592186405216} :step/id #uuid "f5f22eaa-bd88-510e-85bd-716da395dcea" :step/next {:db/id #edb/ref 17