id #edb/ref 17592186405639} :assigned-problem/id #uuid "1bd17899-d2e1-5157-bd52-fc53ba7450b1" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048923} {:db/id #edb/ref 17592186050418}] :db/id #edb/ref 17592186405120}] [[:answer/id #uuid "4c6bfbc3-68f8-51e7-9321-5384f64edb01"] {:answer/id #uuid "4c6bfbc3-68f8-51e7-9321-5384f64edb01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(e^(8y),8x*e^(8y))" :db/id #edb/ref 17592186405990}] [[:answer-field/id #uuid "ac8d4ccb-a854-5631-a6af-35bbdcbf9fd9"] {:answer-field/choices [{:answer/id #uuid "4c6bfbc3-68f8-51e7-9321-5384f64edb01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(e^(8y),8x*e^(8y))" :db/id #edb/ref 17592186405990}] :answer-field/correct {:db/id #edb/ref 17592186405990} :answer-field/id #uuid "ac8d4ccb-a854-5631-a6af-35bbdcbf9fd9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406167}] [[:question/id #uuid "cdd9ac70-9a19-53e6-a0a5-26ae32b05fbc"] {:db/id #edb/ref 17592186405683 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c6bfbc3-68f8-51e7-9321-5384f64edb01" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(e^(8y),8x*e^(8y))" :db/id #edb/ref 17592186405990}] :answer-field/correct {:db/id #edb/ref 17592186405990} :answer-field/id #uuid "ac8d4ccb-a854-5631-a6af-35bbdcbf9fd9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406167}] :question/id #uuid "cdd9ac70-9a19-53e6-a0a5-26ae32b05fbc" :question/problem "Source question: 9.\n\n**Question 9**\n\nFind the gradient vector field of $f(x,y)=xe^{8y}$. Use component form or standard basis vectors, with exact values.\n\n$\\nabla f(x,y)=$ {{field-1}}." :question/worked-solution "The gradient lists partial derivatives. Holding $y$ fixed gives $f_x=e^{8y}$; holding $x$ fixed and using the chain rule gives $f_y=8xe^{8y}$. Thus $\\nabla f=\\langle e^{8y},8xe^{8y}\\rangle$."}] [[:assigned-problem/id #uuid "f7921811-246a-59af-9fa5-9597d633a6ea"] {:assigned-problem/content {:db/id #edb/ref 17592186405683} :assigned-problem/id #uuid "f7921811-246a-59af-9fa5-9597d633a6ea" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050891}] :db/id #edb/ref 17592186405816}] [[:answer/id #uuid "26c1b1dc-a391-5e7f-8479-5c858eee2f53"] {:answer/id #uuid "26c1b1dc-a391-5e7f-8479-5c858eee2f53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(6x^5*y+4y*z^8,x^6+4x*z^8,32x*y*z^7)" :db/id #edb/ref 17592186405907}] [[:answer-field/id #uuid "83b7bb6f-45ad-5f54-9302-4018405c4851"] {:answer-field/choices [{:answer/id #uuid "26c1b1dc-a391-5e7f-8479-5c858eee2f53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(6x^5*y+4y*z^8,x^6+4x*z^8,32x*y*z^7)" :db/id #edb/ref 17592186405907}] :answer-field/correct {:db/id #edb/ref 17592186405907} :answer-field/id #uuid "83b7bb6f-45ad-5f54-9302-4018405c4851" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406090}] [[:question/id #uuid "dcd664ee-2da1-56d0-824b-dd7a1e2b4c71"] {:db/id #edb/ref 17592186405728 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c1b1dc-a391-5e7f-8479-5c858eee2f53" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "(6x^5*y+4y*z^8,x^6+4x*z^8,32x*y*z^7)" :db/id #edb/ref 17592186405907}] :answer-field/correct {:db/id #edb/ref 17592186405907} :answer-field/id #uuid "83b7bb6f-45ad-5f54-9302-4018405c4851" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406090}] :question/id #uuid "dcd664ee-2da1-56d0-824b-dd7a1e2b4c71" :question/problem "Source question: 10.\n\n**Question 10**\n\nFind the gradient vector field of $f(x,y,z)=x^6y+4xyz^8$. Use component form or standard basis vectors, with exact values.\n\n$\\nabla f(x,y,z)=$ {{field-1}}." :question/worked-solution "Differentiate with respect to one variable at a time, holding the others fixed: $f_x=6x^5y+4yz^8$, $f_y=x^6+4xz^8$, and $f_z=32xyz^7$. These are the three gradient components."}] [[:assigned-problem/id #uuid "d2a32df3-b2b0-5fc1-99ff-ee4ea60f03f5"] {:assigned-problem/content {:db/id #edb/ref 17592186405728} :assigned-problem/id #uuid "d2a32df3-b2b0-5fc1-99ff-ee4ea60f03f5" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050149} {:db/id #edb/ref 17592186050891}] :db/id #edb/ref 17592186405698}] [[:answer/id #uuid "dea5ce03-c3c7-54c1-8565-605d477bbf0a"] {:answer/feedback "A vector parallel to the $y$-axis has zero horizontal component, but the field has horizontal component $-y$, which is generally nonzero." :answer/id #uuid "dea5ce03-c3c7-54c1-8565-605d477bbf0a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the $y$-axis." :db/id #edb/ref 17592186406262}] [[:answer/id #uuid "b0448a30-dc0f-5ce7-9b91-c71e824a73e2"] {:answer/feedback "The radius vector is $\\langle x,y\\rangle$. Its dot product with $\\langle-y,x\\rangle$ is $-xy+xy=0$, so the vectors are perpendicular rather than parallel away from the origin." :answer/id #uuid "b0448a30-dc0f-5ce7-9b91-c71e824a73e2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the radius vectors of circles centered at the origin." :db/id #edb/ref 17592186406172}] [[:answer/id #uuid "9a0ed592-4873-5ae2-8536-c4074e8df511"] {:answer/feedback "A vector parallel to the $x$-axis has zero vertical component, but the vertical component here is $x$, which is generally nonzero." :answer/id #uuid "9a0ed592-4873-5ae2-8536-c4074e8df511" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the $x$-axis." :db/id #edb/ref 17592186406130}] [[:answer/id #uuid "710e1afb-6549-5ac1-8637-8c58b6e864de"] {:answer/feedback "The field vector is perpendicular to the radius: $\\langle x,y\\rangle\\cdot\\langle-y,x\\rangle=0$. Therefore it is tangent to the circle through that point, except that the origin has the zero vector." :answer/id #uuid "710e1afb-6549-5ac1-8637-8c58b6e864de" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Tangent to circles centered at the origin." :db/id #edb/ref 17592186406051}] [[:answer-field/id #uuid "86f7dfff-3448-5a56-a0b2-cb4de9e178e3"] {:answer-field/choices [{:answer/feedback "The field vector is perpendicular to the radius: $\\langle x,y\\rangle\\cdot\\langle-y,x\\rangle=0$. Therefore it is tangent to the circle through that point, except that the origin has the zero vector." :answer/id #uuid "710e1afb-6549-5ac1-8637-8c58b6e864de" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Tangent to circles centered at the origin." :db/id #edb/ref 17592186406051} {:answer/feedback "A vector parallel to the $x$-axis has zero vertical component, but the vertical component here is $x$, which is generally nonzero." :answer/id #uuid "9a0ed592-4873-5ae2-8536-c4074e8df511" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the $x$-axis." :db/id #edb/ref 17592186406130} {:answer/feedback "The radius vector is $\\langle x,y\\rangle$. Its dot product with $\\langle-y,x\\rangle$ is $-xy+xy=0$, so the vectors are perpendicular rather than parallel away from the origin." :answer/id #uuid "b0448a30-dc0f-5ce7-9b91-c71e824a73e2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the radius vectors of circles centered at the origin." :db/id #edb/ref 17592186406172} {:answer/feedback "A vector parallel to the $y$-axis has zero horizontal component, but the field has horizontal component $-y$, which is generally nonzero." :answer/id #uuid "dea5ce03-c3c7-54c1-8565-605d477bbf0a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the $y$-axis." :db/id #edb/ref 17592186406262}] :answer-field/correct {:db/id #edb/ref 17592186406051} :answer-field/id #uuid "86f7dfff-3448-5a56-a0b2-cb4de9e178e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406098}] [[:question/id #uuid "01d6d0ba-a3db-5470-bc3f-51935b58fc3a"] {:db/id #edb/ref 17592186405053 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The field vector is perpendicular to the radius: $\\langle x,y\\rangle\\cdot\\langle-y,x\\rangle=0$. Therefore it is tangent to the circle through that point, except that the origin has the zero vector." :answer/id #uuid "710e1afb-6549-5ac1-8637-8c58b6e864de" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Tangent to circles centered at the origin." :db/id #edb/ref 17592186406051} {:answer/feedback "A vector parallel to the $x$-axis has zero vertical component, but the vertical component here is $x$, which is generally nonzero." :answer/id #uuid "9a0ed592-4873-5ae2-8536-c4074e8df511" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the $x$-axis." :db/id #edb/ref 17592186406130} {:answer/feedback "The radius vector is $\\langle x,y\\rangle$. Its dot product with $\\langle-y,x\\rangle$ is $-xy+xy=0$, so the vectors are perpendicular rather than parallel away from the origin." :answer/id #uuid "b0448a30-dc0f-5ce7-9b91-c71e824a73e2" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the radius vectors of circles centered at the origin." :db/id #edb/ref 17592186406172} {:answer/feedback "A vector parallel to the $y$-axis has zero horizontal component, but the field has horizontal component $-y$, which is generally nonzero." :answer/id #uuid "dea5ce03-c3c7-54c1-8565-605d477bbf0a" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "Parallel to the $y$-axis." :db/id #edb/ref 17592186406262}] :answer-field/correct {:db/id #edb/ref 17592186406051} :answer-field/id #uuid "86f7dfff-3448-5a56-a0b2-cb4de9e178e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406098}] :question/id #uuid "01d6d0ba-a3db-5470-bc3f-51935b58fc3a" :question/problem "**Question 11 — Part A**\n\nHow are the field vectors directed?" :question/worked-solution "The field vector is perpendicular to the radius: $\\langle x,y\\rangle\\cdot\\langle-y,x\\rangle=0$. Therefore it is tangent to the circle through that point, except that the origin has the zero vector."}] [[:answer/id #uuid "d14ddafb-39d4-5f0b-841c-eaa7659a9441"] {:answer/feedback "The magnitude is $\\sqrt{(-y)^2+x^2}=\\sqrt{x^2+y^2}$, which is the radius of the circle centered at the origin." :answer/id #uuid "d14ddafb-39d4-5f0b-841c-eaa7659a9441" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It equals the radius of the circle." :db/id #edb/ref 17592186406232}] [[:answer/id #uuid "81ccf9c1-0222-58f0-83a4-e271ac70c07d"] {:answer/feedback "Distance from the $y$-axis is $|x|$. The magnitude also depends on $y$: it is $\\sqrt{x^2+y^2}$." :answer/id #uuid "81ccf9c1-0222-58f0-83a4-e271ac70c07d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It is proportional to the distance from the $y$-axis." :db/id #edb/ref 17592186406085}] [[:answer/id #uuid "6a4e6cb6-b5f3-5e4e-b7af-32dc4c24e585"] {:answer/feedback "The squared magnitude is $x^2+y^2=r^2$, but the magnitude itself is its square root, $r$." :answer/id #uuid "6a4e6cb6-b5f3-5e4e-b7af-32dc4c24e585" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It equals the square of the circle radius." :db/id #edb/ref 17592186406043}] [[:answer/id #uuid "3d66ad6e-b2f1-538c-9f82-d7108c13b00b"] {:answer/feedback "Distance from the $x$-axis is $|y|$. The field magnitude depends on both coordinates and equals $\\sqrt{x^2+y^2}$." :answer/id #uuid "3d66ad6e-b2f1-538c-9f82-d7108c13b00b" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It is proportional to the distance from the $x$-axis." :db/id #edb/ref 17592186405948}] [[:answer-field/id #uuid "a87dfb63-0a04-51d2-a54d-f22806fa530c"] {:answer-field/choices [{:answer/feedback "Distance from the $x$-axis is $|y|$. The field magnitude depends on both coordinates and equals $\\sqrt{x^2+y^2}$." :answer/id #uuid "3d66ad6e-b2f1-538c-9f82-d7108c13b00b" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It is proportional to the distance from the $x$-axis." :db/id #edb/ref 17592186405948} {:answer/feedback "The squared magnitude is $x^2+y^2=r^2$, but the magnitude itself is its square root, $r$." :answer/id #uuid "6a4e6cb6-b5f3-5e4e-b7af-32dc4c24e585" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It equals the square of the circle radius." :db/id #edb/ref 17592186406043} {:answer/feedback "Distance from the $y$-axis is $|x|$. The magnitude also depends on $y$: it is $\\sqrt{x^2+y^2}$." :answer/id #uuid "81ccf9c1-0222-58f0-83a4-e271ac70c07d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It is proportional to the distance from the $y$-axis." :db/id #edb/ref 17592186406085} {:answer/feedback "The magnitude is $\\sqrt{(-y)^2+x^2}=\\sqrt{x^2+y^2}$, which is the radius of the circle centered at the origin." :answer/id #uuid "d14ddafb-39d4-5f0b-841c-eaa7659a9441" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It equals the radius of the circle." :db/id #edb/ref 17592186406232}] :answer-field/correct {:db/id #edb/ref 17592186406232} :answer-field/id #uuid "a87dfb63-0a04-51d2-a54d-f22806fa530c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406159}] [[:question/id #uuid "4521702d-06b2-51ae-b0a7-3094c46ca97a"] {:db/id #edb/ref 17592186405263 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Distance from the $x$-axis is $|y|$. The field magnitude depends on both coordinates and equals $\\sqrt{x^2+y^2}$." :answer/id #uuid "3d66ad6e-b2f1-538c-9f82-d7108c13b00b" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It is proportional to the distance from the $x$-axis." :db/id #edb/ref 17592186405948} {:answer/feedback "The squared magnitude is $x^2+y^2=r^2$, but the magnitude itself is its square root, $r$." :answer/id #uuid "6a4e6cb6-b5f3-5e4e-b7af-32dc4c24e585" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It equals the square of the circle radius." :db/id #edb/ref 17592186406043} {:answer/feedback "Distance from the $y$-axis is $|x|$. The magnitude also depends on $y$: it is $\\sqrt{x^2+y^2}$." :answer/id #uuid "81ccf9c1-0222-58f0-83a4-e271ac70c07d" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It is proportional to the distance from the $y$-axis." :db/id #edb/ref 17592186406085} {:answer/feedback "The magnitude is $\\sqrt{(-y)^2+x^2}=\\sqrt{x^2+y^2}$, which is the radius of the circle centered at the origin." :answer/id #uuid "d14ddafb-39d4-5f0b-841c-eaa7659a9441" :answer/type {:db/id #edb/ref 17592186045500} :answer/value "It equals the radius of the circle." :db/id #edb/ref 17592186406232}] :answer-field/correct {:db/id #edb/ref 17592186406232} :answer-field/id #uuid "a87dfb63-0a04-51d2-a54d-f22806fa530c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186406159}] :question/id #uuid "4521702d-06b2-51ae-b0a7-3094c46ca97a" :question/problem "**Question 11 — Part B**\n\nHow does the magnitude of a field vector depend on its position?" :question/worked-solution "The magnitude is $\\sqrt{(-y)^2+x^2}=\\sqrt{x^2+y^2}$, which is the radius of the circle centered at the origin."}] [[:step/id #uuid "d06e5cfd-e454-54fb-9107-f37f55706ac1"] {:db/id #edb/ref 17592186405692 :step/content {:db/id #edb/ref 17592186405053} :step/id #uuid "d06e5cfd-e454-54fb-9107-f37f55706ac1" :step/next {:db/id #edb/ref 17592186405453}}] [[:step/id #uuid "81e3a94a-19ee-5c49-82aa-aa850913fdfa"] {:db/id #edb/ref 17592186405453 :step/content {:db/id #edb/ref 17592186405263} :step/id #uuid "81e3a94a-19ee-5c49-82aa-aa850913fdfa"}] [[:multistep/id #uuid "3329cc20-e925-586c-8436-5d656a240bfe"] {:db/id #edb/ref 17592186405202 :multistep/context "Source question: 11.\n\nConsider $\\mathbf F(x,y)=-y\\mathbf i+x\\mathbf j$." :multistep/first-step {:db/id #edb/ref 17592186405692} :multistep/id #uuid "3329cc20-e925-586c-8436-5d656a240bfe" :multistep/steps [{:db/id #edb/ref 17592186405453 :step/content {:db/id #edb/ref 17592186405263} :step/id #uuid "81e3a94a-19ee-5c49-82aa-aa850913fdfa"} {:db/id #edb/ref 17592186405692 :step/content {:db/id #edb/ref 17592186405053} :step/id #uuid "d06e5cfd-e454-54fb-9107-f37f55706ac1" :step/next {:db/id #edb/ref 17592186405453}}]}] [[:assigned-problem/id #uuid "293d4f90-5b95-5e48-9074-3d9302bfba20"] {:assigned-problem/content {:db/id #edb/ref 17592186405202} :assigned-problem/id #uuid "293d4f90-5b95-5e48-9074-3d9302bfba20" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048923} {:db/id #edb/ref 17592186048960} {:db/id #edb/ref 17592186050994}] :db/id #edb/ref 17592186405172}] [[:answer/id #uuid "c47bb1f3-36e6-5513-8165-1e3e8dcfffdf"] {:answer/feedback "The positive sign points away from the attracting mass. Since $\\nabla u=Gm\\mathbf r/r^3$, taking its negative gives an inward field." :answer/id #uuid "c47bb1f3-36e6-5513-8165-1e3e8dcfffdf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=\\dfrac{Gm}{r^3}\\mathbf r" :db/id #edb/ref 17592186406211}] [[:answer/id #uuid "6341dba2-b14d-5fe5-8ef7-7fc49f94d3cd"] {:answer/feedback "Using $r=\\sqrt{x^2+y^2+z^2}$ gives $\\nabla(1/r)=-\\mathbf r/r^3$. Hence $\\nabla u=Gm\\mathbf r/r^3$ and $\\mathbf g=-Gm\\mathbf r/r^3$, directed toward the mass." :answer/id #uuid "6341dba2-b14d-5fe5-8ef7-7fc49f94d3cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=-\\dfrac{Gm}{r^3}\\mathbf r" :db/id #edb/ref 17592186406027}] [[:answer/id #uuid "76318b9a-58d2-57f8-b1e8-f4c3c7fe3b3c"] {:answer/feedback "This scalar expression gives a signed radial magnitude but omits the direction vector. The vector field is $-(Gm/r^2)(\\mathbf r/r)=-Gm\\mathbf r/r^3$." :answer/id #uuid "76318b9a-58d2-57f8-b1e8-f4c3c7fe3b3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=-\\dfrac{Gm}{r^2}" :db/id #edb/ref 17592186406060}] [[:answer/id #uuid "7a0aeec2-355c-522d-95f3-4090bfa7b094"] {:answer/feedback "The factor $1/2$ cancels when differentiating $(x^2+y^2+z^2)^{-1/2}$ because the inner derivative contributes $2x$, $2y$, or $2z$. No factor $1/2$ remains." :answer/id #uuid "7a0aeec2-355c-522d-95f3-4090bfa7b094" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=-\\dfrac12\\dfrac{Gm}{r^3}\\mathbf r" :db/id #edb/ref 17592186406065}] [[:answer-field/id #uuid "b5af2d95-20b9-54d8-b7c1-578bf994fa8a"] {:answer-field/choices [{:answer/feedback "Using $r=\\sqrt{x^2+y^2+z^2}$ gives $\\nabla(1/r)=-\\mathbf r/r^3$. Hence $\\nabla u=Gm\\mathbf r/r^3$ and $\\mathbf g=-Gm\\mathbf r/r^3$, directed toward the mass." :answer/id #uuid "6341dba2-b14d-5fe5-8ef7-7fc49f94d3cd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=-\\dfrac{Gm}{r^3}\\mathbf r" :db/id #edb/ref 17592186406027} {:answer/feedback "This scalar expression gives a signed radial magnitude but omits the direction vector. The vector field is $-(Gm/r^2)(\\mathbf r/r)=-Gm\\mathbf r/r^3$." :answer/id #uuid "76318b9a-58d2-57f8-b1e8-f4c3c7fe3b3c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=-\\dfrac{Gm}{r^2}" :db/id #edb/ref 17592186406060} {:answer/feedback "The factor $1/2$ cancels when differentiating $(x^2+y^2+z^2)^{-1/2}$ because the inner derivative contributes $2x$, $2y$, or $2z$. No factor $1/2$ remains." :answer/id #uuid "7a0aeec2-355c-522d-95f3-4090bfa7b094" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=-\\dfrac12\\dfrac{Gm}{r^3}\\mathbf r" :db/id #edb/ref 17592186406065} {:answer/feedback "The positive sign points away from the attracting mass. Since $\\nabla u=Gm\\mathbf r/r^3$, taking its negative gives an inward field." :answer/id #uuid "c47bb1f3-36e6-5513-8165-1e3e8dcfffdf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\mathbf g=\\dfrac{Gm}{r^3}\\mathbf r" :db/id #edb/ref 17592186406211}] :answer-field/correct {