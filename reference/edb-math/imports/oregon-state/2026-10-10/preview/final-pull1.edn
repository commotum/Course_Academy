id #edb/ref 17592186045499} :answer/value "630u^4-1650w^9" :db/id #edb/ref 17592186406137}] :answer-field/correct {:db/id #edb/ref 17592186406137} :answer-field/id #uuid "84b752c4-ed3d-5ef4-8c26-e22cc0711ce6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406093}] :question/id #uuid "e9d22828-f010-55f3-bd94-50509105365c" :question/problem "Source question: 6.\n\nFind $\\partial(x,y,z)/\\partial(u,v,w)$ for $x=3(u+v)$, $y=-5u+7w$, $z=6u^5-11w^{10}$.\n\nAnswer: {{answer}}." :question/worked-solution "The matrix is $\\begin{pmatrix}3&3&0\\\\-5&0&7\\\\30u^4&0&-110w^9\\end{pmatrix}$. Expand along the second column: $-3(550w^9-210u^4)=630u^4-1650w^9$."}] [[:assigned-problem/id #uuid "0f1b9599-fc7c-5c7f-9447-5eea83ffc38e"] {:assigned-problem/content {:db/id #edb/ref 17592186405770} :assigned-problem/id #uuid "0f1b9599-fc7c-5c7f-9447-5eea83ffc38e" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048152} {:db/id #edb/ref 17592186049536}] :db/id #edb/ref 17592186405093}] [[:answer/id #uuid "66518d3f-af1d-52a9-8826-35e97f1bf41b"] {:answer/id #uuid "66518d3f-af1d-52a9-8826-35e97f1bf41b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186406033}] [[:answer-field/id #uuid "93a157d8-9df4-5d54-95b3-4ed03430cfd6"] {:answer-field/choices [{:answer/id #uuid "66518d3f-af1d-52a9-8826-35e97f1bf41b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186406033}] :answer-field/correct {:db/id #edb/ref 17592186406033} :answer-field/id #uuid "93a157d8-9df4-5d54-95b3-4ed03430cfd6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406113}] [[:question/id #uuid "66b4c714-c89d-531f-a0b4-9a94ac90d295"] {:db/id #edb/ref 17592186405366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66518d3f-af1d-52a9-8826-35e97f1bf41b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{55}{3}" :db/id #edb/ref 17592186406033}] :answer-field/correct {:db/id #edb/ref 17592186406033} :answer-field/id #uuid "93a157d8-9df4-5d54-95b3-4ed03430cfd6" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406113}] :question/id #uuid "66b4c714-c89d-531f-a0b4-9a94ac90d295" :question/problem "Source question: 7.\n\nFind $\\iint_R5x\\,dA$, where R is enclosed by $5x-y=0$, $5x-y=8$, $x+y=0$, $x+y=3$. Use $u=5x-y$, $v=x+y$.\n\nAnswer: {{answer}}." :question/worked-solution "Invert: $x=(u+v)/6$, $y=(5v-u)/6$. The new rectangle is 0≤u≤8, 0≤v≤3, and $|J|=1/6$. Thus $I=\\frac5{36}\\int_0^8\\int_0^3(u+v)dvdu=\\frac5{36}(132)=55/3$."}] [[:assigned-problem/id #uuid "b8567fa8-6658-5601-be04-bf9eb64f4d61"] {:assigned-problem/content {:db/id #edb/ref 17592186405366} :assigned-problem/id #uuid "b8567fa8-6658-5601-be04-bf9eb64f4d61" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048225} {:db/id #edb/ref 17592186050488}] :db/id #edb/ref 17592186405620}] [[:answer/id #uuid "204915c2-df9d-5480-a8d9-aafa51c3b84b"] {:answer/id #uuid "204915c2-df9d-5480-a8d9-aafa51c3b84b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\frac72(49+\\cos10)" :db/id #edb/ref 17592186405896}] [[:answer-field/id #uuid "d757cd7c-5f3a-52ea-9b66-9593a4d1f2da"] {:answer-field/choices [{:answer/id #uuid "204915c2-df9d-5480-a8d9-aafa51c3b84b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\frac72(49+\\cos10)" :db/id #edb/ref 17592186405896}] :answer-field/correct {:db/id #edb/ref 17592186405896} :answer-field/id #uuid "d757cd7c-5f3a-52ea-9b66-9593a4d1f2da" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406248}] [[:question/id #uuid "d3dd8f6e-8215-53df-be23-e99770146c42"] {:db/id #edb/ref 17592186405702 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "204915c2-df9d-5480-a8d9-aafa51c3b84b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "-\\frac72(49+\\cos10)" :db/id #edb/ref 17592186405896}] :answer-field/correct {:db/id #edb/ref 17592186405896} :answer-field/id #uuid "d757cd7c-5f3a-52ea-9b66-9593a4d1f2da" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406248}] :question/id #uuid "d3dd8f6e-8215-53df-be23-e99770146c42" :question/problem "Source question: 8.\n\nFind $\\iint_R7(x+y)\\sin(x-y)\\,dA$ on the triangle with vertices (−5,5), (5,5), (0,0). Use $u=x+y$, $v=x-y$.\n\nAnswer: {{answer}}." :question/worked-solution "The inverse is $x=(u+v)/2$, $y=(u-v)/2$, so $|J|=1/2$. The transformed vertices are (0,−10),(10,0),(0,0), giving 0≤u≤10 and u−10≤v≤0. Hence $I=\\frac72\\int_0^{10}u[\\cos(u-10)-1]du=\\frac72[(1-\\cos10)-50]$. Angles are in radians."}] [[:assigned-problem/id #uuid "ee1bd779-0028-505a-947f-385fe4ddd1cd"] {:assigned-problem/content {:db/id #edb/ref 17592186405702} :assigned-problem/id #uuid "ee1bd779-0028-505a-947f-385fe4ddd1cd" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048225} {:db/id #edb/ref 17592186050488}] :db/id #edb/ref 17592186405778}] [[:answer/id #uuid "9560d38d-8a39-593d-aa44-a11ef4840289"] {:answer/id #uuid "9560d38d-8a39-593d-aa44-a11ef4840289" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "480\\pi" :db/id #edb/ref 17592186406118}] [[:answer-field/id #uuid "89fdb89a-92f8-5e85-8f74-bc2ac2faa773"] {:answer-field/choices [{:answer/id #uuid "9560d38d-8a39-593d-aa44-a11ef4840289" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "480\\pi" :db/id #edb/ref 17592186406118}] :answer-field/correct {:db/id #edb/ref 17592186406118} :answer-field/id #uuid "89fdb89a-92f8-5e85-8f74-bc2ac2faa773" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406102}] [[:question/id #uuid "9dc2d24e-6f5e-5f85-ac98-621c35f81b07"] {:db/id #edb/ref 17592186405542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9560d38d-8a39-593d-aa44-a11ef4840289" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "480\\pi" :db/id #edb/ref 17592186406118}] :answer-field/correct {:db/id #edb/ref 17592186406118} :answer-field/id #uuid "89fdb89a-92f8-5e85-8f74-bc2ac2faa773" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406102}] :question/id #uuid "9dc2d24e-6f5e-5f85-ac98-621c35f81b07" :question/problem "Source question: 9.\n\nFind $\\iiint_E(x+3)\\,dV$ inside $x^2/16+y^2/25+z^2/36=1$. Use $u=x/4$, $v=y/5$, $w=z/6$.\n\nAnswer: {{answer}}." :question/worked-solution "The ellipsoid becomes the unit ball. The inverse map (4u,5v,6w) has determinant 120, so integrate $120(4u+3)$. The odd u term vanishes; the constant contributes $360\\cdot4\\pi/3=480\\pi$."}] [[:assigned-problem/id #uuid "9fece06b-e7a7-55f5-890a-4c1d9b372215"] {:assigned-problem/content {:db/id #edb/ref 17592186405542} :assigned-problem/id #uuid "9fece06b-e7a7-55f5-890a-4c1d9b372215" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186049536} {:db/id #edb/ref 17592186049645}] :db/id #edb/ref 17592186405547}] [[:answer/id #uuid "292b9dfa-83d9-571c-8d41-d03ce50f6ece"] {:answer/id #uuid "292b9dfa-83d9-571c-8d41-d03ce50f6ece" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186405915}] [[:answer-field/id #uuid "113b1107-c9da-5c0c-a1d4-fc978bfc2a00"] {:answer-field/choices [{:answer/id #uuid "292b9dfa-83d9-571c-8d41-d03ce50f6ece" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186405915}] :answer-field/correct {:db/id #edb/ref 17592186405915} :answer-field/id #uuid "113b1107-c9da-5c0c-a1d4-fc978bfc2a00" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405863}] [[:question/id #uuid "9a124eab-9d1a-503a-b9a6-310f8f6a3adb"] {:db/id #edb/ref 17592186405529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "292b9dfa-83d9-571c-8d41-d03ce50f6ece" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186405915}] :answer-field/correct {:db/id #edb/ref 17592186405915} :answer-field/id #uuid "113b1107-c9da-5c0c-a1d4-fc978bfc2a00" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405863}] :question/id #uuid "9a124eab-9d1a-503a-b9a6-310f8f6a3adb" :question/problem "Source question: 10.\n\nFind $\\iint_R10x\\,dA$ over the ellipse $x^2/16+y^2/49\\le1$.\n\nAnswer: {{answer}}." :question/worked-solution "Use x=4u,y=7v, so the region is the unit disk and dA=28du dv. The transformed integrand is 1120u, odd across u=0; symmetric halves cancel."}] [[:assigned-problem/id #uuid "278bbe57-f9f3-5986-bf4f-4ac15ae514a6"] {:assigned-problem/content {:db/id #edb/ref 17592186405529} :assigned-problem/id #uuid "278bbe57-f9f3-5986-bf4f-4ac15ae514a6" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048225} {:db/id #edb/ref 17592186050488}] :db/id #edb/ref 17592186405169}] [[:answer/id #uuid "59090b73-a114-5734-a93b-f2d71a0a5552"] {:answer/id #uuid "59090b73-a114-5734-a93b-f2d71a0a5552" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "16(\\sin75-\\sin15)" :db/id #edb/ref 17592186406012}] [[:answer-field/id #uuid "9fe11eb1-d823-5553-b761-02b72bf8c70a"] {:answer-field/choices [{:answer/id #uuid "59090b73-a114-5734-a93b-f2d71a0a5552" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "16(\\sin75-\\sin15)" :db/id #edb/ref 17592186406012}] :answer-field/correct {:db/id #edb/ref 17592186406012} :answer-field/id #uuid "9fe11eb1-d823-5553-b761-02b72bf8c70a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406140}] [[:question/id #uuid "12cfc085-2336-51ef-9c85-ce58272ebf2b"] {:db/id #edb/ref 17592186405102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59090b73-a114-5734-a93b-f2d71a0a5552" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "16(\\sin75-\\sin15)" :db/id #edb/ref 17592186406012}] :answer-field/correct {:db/id #edb/ref 17592186406012} :answer-field/id #uuid "9fe11eb1-d823-5553-b761-02b72bf8c70a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406140}] :question/id #uuid "12cfc085-2336-51ef-9c85-ce58272ebf2b" :question/problem "Source question: 11.\n\nFind $\\iint_R16x\\cos(15xy)\\,dA$ over the region bounded by $xy=1$, $xy=5$, $x=1$, $x=16$. Use $u=x$, $v=xy$.\n\nAnswer: {{answer}}." :question/worked-solution "Invert: x=u,y=v/u. Since u>0, $|J|=1/u$. The rectangle is 1≤u≤16, 1≤v≤5. Thus $I=\\int_1^{16}\\int_1^5 16\\cos(15v)dvdu=16(\\sin75-\\sin15)$."}] [[:assigned-problem/id #uuid "b8205605-60fb-5f48-9400-7ef18432e2c0"] {:assigned-problem/content {:db/id #edb/ref 17592186405102} :assigned-problem/id #uuid "b8205605-60fb-5f48-9400-7ef18432e2c0" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048225} {:db/id #edb/ref 17592186050488}] :db/id #edb/ref 17592186405619}] [[:answer/id #uuid "9c626c11-4d41-55aa-8367-f74d50eee610"] {:answer/id #uuid "9c626c11-4d41-55aa-8367-f74d50eee610" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{77}{8}" :db/id #edb/ref 17592186406133}] [[:answer-field/id #uuid "704ffb97-0854-5dc5-9bc7-0dde5469d31d"] {:answer-field/choices [{:answer/id #uuid "9c626c11-4d41-55aa-8367-f74d50eee610" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{77}{8}" :db/id #edb/ref 17592186406133}] :answer-field/correct {:db/id #edb/ref 17592186406133} :answer-field/id #uuid "704ffb97-0854-5dc5-9bc7-0dde5469d31d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406050}] [[:question/id #uuid "f02b8cf2-3664-5402-abdc-628228493f50"] {:db/id #edb/ref 17592186405787 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c626c11-4d41-55aa-8367-f74d50eee610" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{77}{8}" :db/id #edb/ref 17592186406133}] :answer-field/correct {:db/id #edb/ref 17592186406133} :answer-field/id #uuid "704ffb97-0854-5dc5-9bc7-0dde5469d31d" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406050}] :question/id #uuid "f02b8cf2-3664-5402-abdc-628228493f50" :question/problem "Source question: 12.\n\nUse a change of variables to find the area enclosed by $x+y=4$, $x+y=-7$, $y=7x$, and $y=7x+7$. Give the area in square units.\n\nAnswer: {{answer}}." :question/worked-solution "Choose u=x+y and v=y−7x. The new rectangle has −7≤u≤4 and 0≤v≤7. Inverting gives x=(u−v)/8,y=(7u+v)/8 and $|J|=1/8$. The area is 11·7/8=77/8 square units."}] [[:assigned-problem/id #uuid "e1c6f0a7-fc26-5a85-9ec3-4f18892c7a13"] {:assigned-problem/content {:db/id #edb/ref 17592186405787} :assigned-problem/id #uuid "e1c6f0a7-fc26-5a85-9ec3-4f18892c7a13" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048225} {:db/id #edb/ref 17592186050711}] :db/id #edb/ref 17592186405752}] [[:step/id #uuid "89fe4cce-28a2-5c30-add0-597f38857876"] {:db/id #edb/ref 17592186405482 :step/content {:db/id #edb/ref 17592186405796} :step/id #uuid "89fe4cce-28a2-5c30-add0-597f38857876" :step/next {:db/id #edb/ref 17592186405595}}] [[:step/id #uuid "b2ff52fb-f5ee-55b9-84f7-cf6baf4a2b9a"] {:db/id #edb/ref 17592186405595 :step/content {:db/id #edb/ref 17592186405128} :step/id #uuid "b2ff52fb-f5ee-55b9-84f7-cf6baf4a2b9a" :step/next {:db/id #edb/ref 17592186405604}}] [[:step/id #uuid "b45f4134-201f-5b0b-b8dc-ddaa78ef91cd"] {:db/id #edb/ref 17592186405604 :step/content {:db/id #edb/ref 17592186405131} :step/id #uuid "b45f4134-201f-5b0b-b8dc-ddaa78ef91cd" :step/next {:db/id #edb/ref 17592186405320}}] [[:step/id #uuid "59466ced-3069-5773-8ffc-657db1de63f5"] {:db/id #edb/ref 17592186405320 :step/content {:db/id #edb/ref 17592186405612} :step/id #uuid "59466ced-3069-5773-8ffc-657db1de63f5" :step/next {:db/id #edb/ref 17592186405487}}] [[:step/id #uuid "8a9a66