e9bb"] {:answer-field/choices [{:answer/id #uuid "4a7007aa-87a5-54a2-975b-22c1ba4d2638" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{21\\sqrt2}{4}" :db/id #edb/ref 17592186405986}] :answer-field/correct {:db/id #edb/ref 17592186405986} :answer-field/id #uuid "c6dd20f8-e8ee-56ed-aef3-21bede09e9bb" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406216}] [[:question/id #uuid "710bf196-32e2-56c2-825f-5f467096d5d8"] {:db/id #edb/ref 17592186405405 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a7007aa-87a5-54a2-975b-22c1ba4d2638" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{21\\sqrt2}{4}" :db/id #edb/ref 17592186405986}] :answer-field/correct {:db/id #edb/ref 17592186405986} :answer-field/id #uuid "c6dd20f8-e8ee-56ed-aef3-21bede09e9bb" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406216}] :question/id #uuid "710bf196-32e2-56c2-825f-5f467096d5d8" :question/problem "Source question: 1.\n\nFind $\\int_C21x^2y\\,ds$ for $x=\\cos(13t),\\ y=\\cos(13t),\\ 0\\le t\\le\\pi/26$.\n\nAnswer: {{answer}}." :question/worked-solution "$ds=13\\sqrt2\\sin(13t)dt$ on this interval. With u=cos(13t), the integral is $21\\sqrt2\\int_0^1u^3du=21\\sqrt2/4$. The straight segment from (1,1) to (0,0) gives the same result."}] [[:assigned-problem/id #uuid "60617532-73d6-5e5a-831c-45d4495270e4"] {:assigned-problem/content {:db/id #edb/ref 17592186405405} :assigned-problem/id #uuid "60617532-73d6-5e5a-831c-45d4495270e4" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405342}] [[:answer/id #uuid "47ae0af6-da6a-52fd-a102-61bf23f9c35e"] {:answer/id #uuid "47ae0af6-da6a-52fd-a102-61bf23f9c35e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{329\\sqrt{37}}5" :db/id #edb/ref 17592186405978}] [[:answer-field/id #uuid "e9234b59-9982-599e-bb0d-371cc7fd78be"] {:answer-field/choices [{:answer/id #uuid "47ae0af6-da6a-52fd-a102-61bf23f9c35e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{329\\sqrt{37}}5" :db/id #edb/ref 17592186405978}] :answer-field/correct {:db/id #edb/ref 17592186405978} :answer-field/id #uuid "e9234b59-9982-599e-bb0d-371cc7fd78be" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406279}] [[:question/id #uuid "0634e164-3396-5330-9fa0-45d465864c53"] {:db/id #edb/ref 17592186405072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47ae0af6-da6a-52fd-a102-61bf23f9c35e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac{329\\sqrt{37}}5" :db/id #edb/ref 17592186405978}] :answer-field/correct {:db/id #edb/ref 17592186405978} :answer-field/id #uuid "e9234b59-9982-599e-bb0d-371cc7fd78be" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406279}] :question/id #uuid "0634e164-3396-5330-9fa0-45d465864c53" :question/problem "Source question: 2.\n\nFind $\\int_C(22y-x^4)\\,ds$ for $x=t,\\ y=6t,\\ 0\\le t\\le1$.\n\nAnswer: {{answer}}." :question/worked-solution "The speed is $\\sqrt{1+36}=\\sqrt{37}$. Thus $I=\\sqrt{37}\\int_0^1(132t-t^4)dt=\\sqrt{37}(66-1/5)$."}] [[:assigned-problem/id #uuid "a2c08e18-dfdb-5bc7-aeb8-d0dc880d78d0"] {:assigned-problem/content {:db/id #edb/ref 17592186405072} :assigned-problem/id #uuid "a2c08e18-dfdb-5bc7-aeb8-d0dc880d78d0" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405558}] [[:answer/id #uuid "0a9be663-faa4-5795-aa93-c4615ebfd883"] {:answer/id #uuid "0a9be663-faa4-5795-aa93-c4615ebfd883" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac3{196}(205\\sqrt{205}-27)" :db/id #edb/ref 17592186405848}] [[:answer-field/id #uuid "44a941bc-bd33-542f-8ba1-a98ee6fa0e12"] {:answer-field/choices [{:answer/id #uuid "0a9be663-faa4-5795-aa93-c4615ebfd883" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac3{196}(205\\sqrt{205}-27)" :db/id #edb/ref 17592186405848}] :answer-field/correct {:db/id #edb/ref 17592186405848} :answer-field/id #uuid "44a941bc-bd33-542f-8ba1-a98ee6fa0e12" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405970}] [[:question/id #uuid "488b7fed-19aa-5c2b-b3a5-3a41cf3c7eb3"] {:db/id #edb/ref 17592186405278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9be663-faa4-5795-aa93-c4615ebfd883" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac3{196}(205\\sqrt{205}-27)" :db/id #edb/ref 17592186405848}] :answer-field/correct {:db/id #edb/ref 17592186405848} :answer-field/id #uuid "44a941bc-bd33-542f-8ba1-a98ee6fa0e12" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186405970}] :question/id #uuid "488b7fed-19aa-5c2b-b3a5-3a41cf3c7eb3" :question/problem "Source question: 3.\n\nFind $\\int_C3x\\,ds$ for $x=3t,\\ y=7t^2,\\ 0\\le t\\le1$.\n\nAnswer: {{answer}}." :question/worked-solution "$ds=\\sqrt{9+196t^2}dt$. Integrate $9t\\sqrt{9+196t^2}$ using u=9+196t², du=392t dt; the antiderivative is $3(9+196t^2)^{3/2}/196$."}] [[:assigned-problem/id #uuid "003b5958-a3f3-5db4-af36-f5866d42b791"] {:assigned-problem/content {:db/id #edb/ref 17592186405278} :assigned-problem/id #uuid "003b5958-a3f3-5db4-af36-f5866d42b791" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050295} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405048}] [[:answer/id #uuid "fa07b0ac-0386-5f81-a7a7-ddb6512d616e"] {:answer/id #uuid "fa07b0ac-0386-5f81-a7a7-ddb6512d616e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac7{27}(37\\sqrt{37}-1)" :db/id #edb/ref 17592186406319}] [[:answer-field/id #uuid "f6e91db2-3289-5105-8405-8bf211a73100"] {:answer-field/choices [{:answer/id #uuid "fa07b0ac-0386-5f81-a7a7-ddb6512d616e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac7{27}(37\\sqrt{37}-1)" :db/id #edb/ref 17592186406319}] :answer-field/correct {:db/id #edb/ref 17592186406319} :answer-field/id #uuid "f6e91db2-3289-5105-8405-8bf211a73100" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406310}] [[:question/id #uuid "393c353d-ed34-5314-8a22-8aa25230d955"] {:db/id #edb/ref 17592186405219 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fa07b0ac-0386-5f81-a7a7-ddb6512d616e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac7{27}(37\\sqrt{37}-1)" :db/id #edb/ref 17592186406319}] :answer-field/correct {:db/id #edb/ref 17592186406319} :answer-field/id #uuid "f6e91db2-3289-5105-8405-8bf211a73100" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186406310}] :question/id #uuid "393c353d-ed34-5314-8a22-8aa25230d955" :question/problem "Source question: 4.\n\nFind $\\int_C7y\\,ds$ along $y=x^3/2$ from (0,0) to (2,4).\n\nAnswer: {{answer}}." :question/worked-solution "$ds=\\sqrt{1+9x^4/4}\\,dx$ and 7y=7x³/2. Set u=1+9x⁴/4, du=9x³dx. This gives $\\frac7{27}[u^{3/2}]_1^{37}$."}] [[:assigned-problem/id #uuid "e671770b-a69c-5c34-be91-bc21955614af"] {:assigned-problem/content {:db/id #edb/ref 17592186405219} :assigned-problem/id #uuid "e671770b-a69c-5c34-be91-bc21955614af" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048651} {:db/id #edb/ref 17592186050866}] :db/id #edb/ref 17592186405763}] [[:answer/id #uuid "7efd5277-2c3b-5bdb-bf0c-955d50cda6a9"] {:answer/id #uuid "7efd5277-2c3b-5bdb-bf0c-955d50cda6a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "\\frac5{81}(82\\sqrt{82}-1)" :db/id #edb/ref 17592186406077}] [[:answer-field/id #uuid "047ff00a-c9b4-55a4-91c0-ab1760f3498a"] {:answer-field/choices [{:answer/id #uuid "7efd5277-2c3b-5bdb-bf0c-955d50cda6a9" :answer/type {:db/id #edb/ref 17592186045499} :answer/va