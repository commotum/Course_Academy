d #uuid "71252346-dfe4-510b-8520-af88c5181b82" {:answer-field/choices [{:db/id #edb/ref 17592186493194}] :answer-field/correct {:db/id #edb/ref 17592186493194} :answer-field/id #uuid "71252346-dfe4-510b-8520-af88c5181b82" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186493229}] [:answer-field/id #uuid "778ac57a-a629-5c2c-8855-1c3f648addbc" {:answer-field/choices [{:db/id #edb/ref 17592186493218}] :answer-field/correct {:db/id #edb/ref 17592186493218} :answer-field/id #uuid "778ac57a-a629-5c2c-8855-1c3f648addbc" :answer-field/key "response" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186493230}] [:answer-field/id #uuid "7a24d650-50a4-52c0-8ab6-3083216efa84" {:answer-field/choices [{:db/id #edb/ref 17592186493278} {:db/id #edb/ref 17592186493290}] :answer-field/correct {:db/id #edb/ref 17592186493290} :answer-field/id #uuid "7a24d650-50a4-52c0-8ab6-3083216efa84" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186493231}] [:answer/id #uuid "8104d831-1ab2-5987-8dab-79e5fbcad039" {:answer/feedback "All three rows are the same nonzero row. Subtract the first row from the other two to get one nonzero row and two zero rows, so the rank is 1. Rank is neither the number of repeated rows nor the number of columns." :answer/id #uuid "8104d831-1ab2-5987-8dab-79e5fbcad039" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "1" :db/id #edb/ref 17592186493233}] [:answer/id #uuid "99efdab7-e2ea-564a-8000-f328eefee10b" {:answer/id #uuid "99efdab7-e2ea-564a-8000-f328eefee10b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The identity matrix $I_n$ has 1 on every main-diagonal entry and 0 everywhere else: $(I_n)_{ij}=1$ if $i=j$, and 0 otherwise. It is square and satisfies $I_nA=A$ and $AI_n=A$ whenever the dimensions match." :db/id #edb/ref 17592186493237}] [:answer/id #uuid "a0cc988e-0787-5b66-99bf-9d4bb96b66f6" {:answer/id #uuid "a0cc988e-0787-5b66-99bf-9d4bb96b66f6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=2,\\quad k\\ne4" :db/id #edb/ref 17592186493239}] [:answer/id #uuid "a15de8ee-1a6e-5706-a8f6-a13f130a5304" {:answer/id #uuid "a15de8ee-1a6e-5706-a8f6-a13f130a5304" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A free variable is a variable whose coefficient column is not a pivot column. In a consistent system it may be assigned an arbitrary parameter value; the basic variables then depend on those parameters. The right-hand-side column is not a free variable." :db/id #edb/ref 17592186493240}] [:answer/id #uuid "a282e7f9-16e2-5f66-b771-c9080cdecfdd" {:answer/feedback "No. Substituting zero for every variable makes every homogeneous equation $0=0$, so the trivial solution always exists. Homogeneity does not guarantee uniqueness." :answer/id #uuid "a282e7f9-16e2-5f66-b771-c9080cdecfdd" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No" :db/id #edb/ref 17592186493241}] [:answer/id #uuid "a3fd7b3e-5382-5331-b00a-965b7684301d" {:answer/id #uuid "a3fd7b3e-5382-5331-b00a-965b7684301d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186493243}] [:answer/id #uuid "a8429139-4810-58c2-a91f-95046b7f0101" {:answer/feedback "All three rows are the same nonzero row. Subtract the first row from the other two to get one nonzero row and two zero rows, so the rank is 1. Rank is neither the number of repeated rows nor the number of columns." :answer/id #uuid "a8429139-4810-58c2-a91f-95046b7f0101" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2" :db/id #edb/ref 17592186493245}] [:answer/id #uuid "a851d1ea-f610-55cd-ab2a-1e5d6d75ff4f" {:answer/id #uuid "a851d1ea-f610-55cd-ab2a-1e5d6d75ff4f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "It is a system in which every equation has zero right-hand side; in matrix form, $A\\mathbf x=\\mathbf0$. It always has the trivial solution $\\mathbf x=\\mathbf0$. It may also have nontrivial solutions if the coefficient matrix has free-variable columns." :db/id #edb/ref 17592186493246}] [:answer/id #uuid "b08efe81-0564-53ff-bc84-83b8eb2dfc91" {:answer/feedback "Use the variable order x,y,z. The second equation is $-2x+3y-z=-1$, so its row is $(-2,3,-1\\mid-1)$. The other rows also agree. The assertion is true." :answer/id #uuid "b08efe81-0564-53ff-bc84-83b8eb2dfc91" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493251}] [:answer/id #uuid "b5085e24-dbb3-53af-9343-70f2225a3074" {:answer/id #uuid "b5085e24-dbb3-53af-9343-70f2225a3074" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h=2,\\quad k=4" :db/id #edb/ref 17592186493252}] [:answer/id #uuid "b53da8de-fbfe-5c54-9c4a-9994ea5f8167" {:answer/feedback "True. If $A$ is $m\\times n$ and $B$ is $n\\times p$, both sides are $p\\times m$. Their (i,j)-entries agree: $(AB)^T_{ij}=\\sum_k a_{jk}b_{ki}=\\sum_k (B^T)_{ik}(A^T)_{kj}$. Transposing a product reverses the order." :answer/id #uuid "b53da8de-fbfe-5c54-9c4a-9994ea5f8167" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493253}] [:answer/id #uuid "b5c4f126-abcd-5c09-b688-def7b6d6f366" {:answer/id #uuid "b5c4f126-abcd-5c09-b688-def7b6d6f366" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A square matrix A is skew symmetric when $A^T=-A$, equivalently $a_{ji}=-a_{ij}$. For real matrices, every diagonal entry must be zero because $a_{ii}=-a_{ii}$. For example $\\begin{bmatrix}0&2\\\\-2&0\\end{bmatrix}$ is skew symmetric." :db/id #edb/ref 17592186493254}] [:answer/id #uuid "badae619-1426-5ed3-82a1-6cd7ec86ab5e" {:answer/id #uuid "badae619-1426-5ed3-82a1-6cd7ec86ab5e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A pivot column is a column containing a pivot position in echelon form. To find it, locate each nonzero row’s leading entry and identify its column. A coefficient pivot column corresponds to a basic variable; a pivot in the augmented column instead signals inconsistency." :db/id #edb/ref 17592186493256}] [:answer/id #uuid "bb354bcf-dd88-5e69-9e3e-22aa98d0d944" {:answer/feedback "Yes. Multiplying every entry of the second matrix by 2 gives $(4,6;8,2)$, entry-for-entry equal to E." :answer/id #uuid "bb354bcf-dd88-5e69-9e3e-22aa98d0d944" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes" :db/id #edb/ref 17592186493257}] [:answer/id #uuid "bcd28e56-fb94-5db7-a6d1-6bc4020e6257" {:answer/id #uuid "bcd28e56-fb94-5db7-a6d1-6bc4020e6257" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An authored reference is $B=\\begin{bmatrix}6&9\\\\-4&-6\\end{bmatrix}$, which is nonzero. Its square is $$B^2=\\begin{bmatrix}36-36&54-54\\\\-24+24&-36+36\\end{bmatrix}=0.$$ Again, a matrix $\\begin{bmatrix}a&b\\\\c&-a\\end{bmatrix}$ squares to $(a^2+bc)I$. Choose nonzero entries satisfying $a^2+bc=0$. Here $36+9(-4)=0$. Nonzero matrices can have zero square; ordinary scalar intuition does not apply." :db/id #edb/ref 17592186493259}] [:answer/id #uuid "bf7d7d44-dfa9-5ab1-821e-1a20a8ba1270" {:answer/id #uuid "bf7d7d44-dfa9-5ab1-821e-1a20a8ba1270" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A complete peer response identifies a real classmate’s proposed equations, verifies that the first two have a common solution, and checks that the three together are inconsistent. Row-reduce the first two and then the full augmented matrix, or compare any dependent left-hand sides with their constants. If the full system is consistent, propose changing the right-hand side of a dependent equation. If it works, describe an alternative such as two intersecting planes and a third plane parallel to one of them with a different constant. This is a response checklist, not a claim about an unseen classmate’s work." :db/id #edb/ref 17592186493262}] [:answer/id #uuid "bf81c91e-9f65-55cb-b77c-44fcf80cf693" {:answer/feedback "True. The inner dimensions of $(3\\times3)(3\\times4)$ agree. AB is a $3\\times4$ matrix." :answer/id #uuid "bf81c91e-9f65-55cb-b77c-44fcf80cf693" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493263}] [:answer/id #uuid "c12cd01d-7d18-5b53-b479-b430cbe49ddc" {:answer/id #uuid "c12cd01d-7d18-5b53-b479-b430cbe49ddc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A is invertible if it is square and there is a matrix $A^{-1}$ of the same size with $AA^{-1}=A^{-1}A=I$. Both products give the identity. Nonzero entries alone do not imply invertibility." :db/id #edb/ref 17592186493265}] [:answer/id #uuid "c17d716c-53fa-5483-80d4-8de6cdfe510d" {:answer/id #uuid "c17d716c-53fa-5483-80d4-8de6cdfe510d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "h\\ne2,\\quad k\\in\\mathbb R" :db/id #edb/ref 17592186493266}] [:answer/id #uuid "d3be0592-83e5-5d2b-9b71-07c6e87e20c9" {:answer/id #uuid "d3be0592-83e5-5d2b-9b71-07c6e87e20c9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A pivot position is the position of the leading nonzero entry in a nonzero row of an echelon form. In this textbook’s normalized row-echelon form, and in RREF, that entry is 1. The position is the row-column location; it is not the entire column." :db/id #edb/ref 17592186493270}] [:answer/id #uuid "d4c82f88-0259-53f9-a11b-3eb3ebad510a" {:answer/id #uuid "d4c82f88-0259-53f9-a11b-3eb3ebad510a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "One authored reference example is $$\\begin{cases}x+7y-2z=3\\\\3x-y+5z=4\\\\7x+5y+8z=16\\end{cases}$$ The first two equations have, for example, the solution $(31/22,5/22,0)$. Their first left-hand side plus twice their second left-hand side is $7x+5y+8z$, but the corresponding right-hand side is $3+2(4)=11$, not 16. Thus no point satisfies all three. The construction deliberately makes the third left side dependent while choosing an incompatible constant. For your own submission, choose your own coefficients and confirm it differs from your course examples." :db/id #edb/ref 17592186493271}] [:answer/id #uuid "d578d171-2f12-53b2-8555-0a87c0bf4b8e" {:answer/feedback "True: $2(1,1,1)^T+1(0,0,1)^T=(2,2,3)^T$. The same scalar multiplies every component of a given vector." :answer/id #uuid "d578d171-2f12-53b2-8555-0a87c0bf4b8e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493272}] [:answer/id #uuid "d942d337-74fb-509f-843d-afc92276a808" {:answer/feedback "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." :answer/id #uuid "d942d337-74fb-509f-843d-afc92276a808" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x4" :db/id #edb/ref 17592186493274}] [:answer/id #uuid "da4fc77f-38a1-5fc4-9309-6422e5ecc82e" {:answer/id #uuid "da4fc77f-38a1-5fc4-9309-6422e5ecc82e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Transposition interchanges rows and columns. If $A=(a_{ij})$ is $m\\times n$, then $A^T$ is $n\\times m$ and $(A^T)_{ij}=a_{ji}$. It does not negate the entries." :db/id #edb/ref 17592186493275}] [:answer/id #uuid "dec75c03-b189-5d4d-a30f-b213dce4e894" {:answer/id #uuid "dec75c03-b189-5d4d-a30f-b213dce4e894" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. Use $x=1$, $y=2$, $z=3$, $x+y=3$, and $y+z=5$. The first three force the unique point $(1,2,3)$ and the last two are satisfied by it. The coefficient and augmented ranks are both 3. Extra equations do not destroy uniqueness when they are compatible." :db/id #edb/ref 17592186493276}] [:answer/id #uuid "e3f197e6-0707-538b-9236-03b6386c271a" {:answer/feedback "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." :answer/id #uuid "e3f197e6-0707-538b-9236-03b6386c271a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4x2" :db/id #edb/ref 17592186493277}] [:answer/id #uuid "e69221d7-23be-5804-b1e5-946b8d560ace" {:answer/feedback "False. For example, $A=\\begin{bmatrix}1&0\\\\0&0\\end{bmatrix}$ and $B=\\begin{bmatrix}0&1\\\\0&0\\end{bmatrix}$ give $AB=B$ but $BA=0$. Both products exist, but matrix multiplication need not commute." :answer/id #uuid "e69221d7-23be-5804-b1e5-946b8d560ace" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493278}] [:answer/id #uuid "eabdcb3e-ce82-5850-8f6a-33fc28ad8953" {:answer/id #uuid "eabdcb3e-ce82-5850-8f6a-33fc28ad8953" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. One example is $x+y+z=0$, $2x+2y+2z=0$, $3x+3y+3z=0$, $4x+4y+4z=0$, and $5x+5y+5z=0$. All five reduce to the same equation, so $(x,y,z)=(s,t,-s-t)$, $s,t\\in\\mathbb R$. The coefficient and augmented matrices both have rank 1; two variables are free." :db/id #edb/ref 17592186493279}] [:answer/id #uuid "ee562462-0feb-5e6c-8955-60527c2a0244" {:answer/id #uuid "ee562462-0feb-5e6c-8955-60527c2a0244" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes. Use $x+y+z=0$, $x+y+z=1$, $x=0$, $y=0$, and $z=0$. The first two equations already contradict each other. Subtracting their augmented rows gives $[0\\ 0\\ 0\\mid1]$, so no common solution exists." :db/id #edb/ref 17592186493280}] [:answer/id #uuid "ef752f77-7085-5620-b577-5b5d807bdb74" {:answer/id #uuid "ef752f77-7085-5620-b577-5b5d807bdb74" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A" :db/id #edb/ref 17592186493281}] [:answer/id #uuid "f0366301-63aa-53e5-9b6b-5a6cf29aa67d" {:answer/feedback "True: $2(1,1,1)^T+1(0,0,1)^T=(2,2,3)^T$. The same scalar multiplies every component of a given vector." :answer/id #uuid "f0366301-63aa-53e5-9b6b-5a6cf29aa67d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493282}] [:answer/id #uuid "f06e9819-95a6-5020-8f15-7b29c9c57bb5" {:answer/feedback "All three rows are the same nonzero row. Subtract the first row from the other two to get one nonzero row and two zero rows, so the rank is 1. Rank is neither the number of repeated rows nor the number of columns." :answer/id #uuid "f06e9819-95a6-5020-8f15-7b29c9c57bb5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3" :db/id #edb/ref 17592186493283}] [:answer/id #uuid "f76435e9-f25b-5418-afe1-6b6b5ab1f11e" {:answer/feedback "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." :answer/id #uuid "f76435e9-f25b-5418-afe1-6b6b5ab1f11e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "2x3" :db/id #edb/ref 17592186493285}] [:answer/id #uuid "fadd3d68-7810-5c21-9f59-d51467702fab" {:answer/feedback "All three rows are the same nonzero row. Subtract the first row from the other two to get one nonzero row and two zero rows, so the rank is 1. Rank is neither the number of repeated rows nor the number of columns." :answer/id #uuid "fadd3d68-7810-5c21-9f59-d51467702fab" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "0" :db/id #edb/ref 17592186493287}] [:answer/id #uuid "fba5bc4f-4a2b-534d-8dc2-b4d35da9ffd4" {:answer/feedback "False. A has dimensions $3\\times3$ and B has dimensions $3\\times4$. Matrix addition requires equal dimensions, even though their row counts match." :answer/id #uuid "fba5bc4f-4a2b-534d-8dc2-b4d35da9ffd4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493288}] [:answer/id #uuid "fc007165-3170-5c92-bfc7-4dba420e35f6" {:answer/id #uuid "fc007165-3170-5c92-bfc7-4dba420e35f6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186493289}] [:answer/id #uuid "fd356ee2-225b-50ca-b8cc-94620ac3ba9c" {:answer/feedback "False. For example, $A=\\begin{bmatrix}1&0\\\\0&0\\end{bmatrix}$ and $B=\\begin{bmatrix}0&1\\\\0&0\\end{bmatrix}$ give $AB=B$ but $BA=0$. Both products exist, but matrix multiplication need not commute." :answer/id #uuid "fd356ee2-225b-50ca-b8cc-94620ac3ba9c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493290}] [:answer/id #uuid "01791fb6-d9aa-596a-8bcb-cd1fc9f1f7d3" {:answer/id #uuid "01791fb6-d9aa-596a-8bcb-cd1fc9f1f7d3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The hypothesis holds for every A, so choose $A=I_n$. Then $I_nB=I_n$ by the hypothesis, while $I_nB=B$ by the identity property. Therefore $B=I_n$. Conversely, the identity does satisfy $AI_n=I_nA=A$. The phrase “for every A” is essential; one choice such as A=0 alone would not force B to be the identity." :db/id #edb/ref 17592186493185}] [:answer/id #uuid "0e5f7b8b-5a39-5382-8df9-0068b7bfefc7" {:answer/id #uuid "0e5f7b8b-5a39-5382-8df9-0068b7bfefc7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No real k works. The products are $$AB=\\begin{bmatrix}3&2+2k\\\\7&6+4k\\end{bmatrix},\\qquad BA=\\begin{bmatrix}7&10\\\\1+3k&2+4k\\end{bmatrix}.$$ Their (1,1)-entries are always 3 and 7, independent of k. Thus equality is impossible; no need to solve the other entry equations." :db/id #edb/ref 17592186493188}] [:answer/id #uuid "19907cde-73d9-5a36-ad3c-e4bb4a4be0be" {:answer/id #uuid "19907cde-73d9-5a36-ad3c-e4bb4a4be0be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The rank of A is the number of pivot positions, equivalently the number of nonzero rows in an echelon form of A. It also equals the dimension of its column space (and row space). Count pivots after row reduction, not merely the nonzero original rows." :db/id #edb/ref 17592186493193}] [:answer/id #uuid "1dd912af-3d43-5900-b5a3-734511898331" {:answer/id #uuid "1dd912af-3d43-5900-b5a3-734511898331" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "It is a linear equation with zero constant term, written $a_1x_1+\\cdots+a_nx_n=0$. Variables occur only to the first power and are not multiplied together. The zero assignment to all variables always satisfies it." :db/id #edb/ref 17592186493194}] [:answer/id #uuid "1e055df5-19b5-5068-abe1-5a687f6bd003" {:answer/feedback "True. The inner dimensions of $(3\\times3)(3\\times4)$ agree. AB is a $3\\times4$ matrix." :answer/id #uuid "1e055df5-19b5-5068-abe1-5a687f6bd003" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493195}] [:answer/id #uuid "25078cdb-639d-58c1-b51c-43840f9af302" {:answer/feedback "Use the variable order x,y,z. The second equation is $-2x+3y-z=-1$, so its row is $(-2,3,-1\\mid-1)$. The other rows also agree. The assertion is true." :answer/id #uuid "25078cdb-639d-58c1-b51c-43840f9af302" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493196}] [:answer/id #uuid "258c2986-4581-576f-b3ad-079fe1bf8f29" {:answer/feedback "All three rows are the same nonzero row. Subtract the first row from the other two to get one nonzero row and two zero rows, so the rank is 1. Rank is neither the number of repeated rows nor the number of columns." :answer/id #uuid "258c2986-4581-576f-b3ad-079fe1bf8f29" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4" :db/id #edb/ref 17592186493197}] [:answer/id #uuid "289d091e-31cb-5780-8f28-873b92b38080" {:answer/feedback "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." :answer/id #uuid "289d091e-31cb-5780-8f28-873b92b38080" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3x4" :db/id #edb/ref 17592186493199}] [:answer/id #uuid "29cbfc50-010f-55b1-b8ed-35ab73fcde38" {:answer/id #uuid "29cbfc50-010f-55b1-b8ed-35ab73fcde38" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "In this row-reduction context, two matrices are row-equivalent if one can be obtained from the other by a finite sequence of elementary row operations. For matrices of the same size, this is equivalent to having the same RREF. Having only the same rank does not guarantee row equivalence." :db/id #edb/ref 17592186493200}] [:answer/id #uuid "2ca275fa-f873-52aa-a2a3-bc342b203343" {:answer/feedback "No. B has 3 rows and 4 columns; square matrices have equal row and column counts." :answer/id #uuid "2ca275fa-f873-52aa-a2a3-bc342b203343" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No" :db/id #edb/ref 17592186493201}] [:answer/id #uuid "335ab671-c6c1-5a58-9642-1cc1dea5776c" {:answer/id #uuid "335ab671-c6c1-5a58-9642-1cc1dea5776c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Use a real peer’s matrices. Compute all four entries of each square, check that A has real entries and $A^2=-I$, and check both $B\\ne0$ and $B^2=0$. Explain any incorrect sign, missing entry, or failure of a condition and show a correction. For a valid example, an alternative construction is the trace-zero family $\\begin{bmatrix}a&b\\\\c&-a\\end{bmatrix}$: choose $a^2+bc=-1$ for A or 0 for a nonzero B. This checklist does not invent a peer’s post." :db/id #edb/ref 17592186493204}] [:answer/id #uuid "3a35565f-d95b-5657-9ab8-4efee484e023" {:answer/feedback "No. B has 3 rows and 4 columns; square matrices have equal row and column counts." :answer/id #uuid "3a35565f-d95b-5657-9ab8-4efee484e023" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes" :db/id #edb/ref 17592186493207}] [:answer/id #uuid "43374999-e3ef-5c66-a5be-96a30c46c95c" {:answer/feedback "Both right-hand sides are zero, so the system is homogeneous. The different numbers of equations and variables do not change that definition." :answer/id #uuid "43374999-e3ef-5c66-a5be-96a30c46c95c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493209}] [:answer/id #uuid "46ded145-28ae-5399-8885-4a0dc949b751" {:answer/feedback "False. A has dimensions $3\\times3$ and B has dimensions $3\\times4$. Matrix addition requires equal dimensions, even though their row counts match." :answer/id #uuid "46ded145-28ae-5399-8885-4a0dc949b751" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493211}] [:answer/id #uuid "4af735f8-4787-5fc2-9829-e980798699d8" {:answer/id #uuid "4af735f8-4787-5fc2-9829-e980798699d8" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186493213}] [:answer/id #uuid "4c696406-bb2b-5783-a40e-c50d472c5467" {:answer/id #uuid "4c696406-bb2b-5783-a40e-c50d472c5467" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "One authored reference is $A=\\begin{bmatrix}3&5\\\\-2&-3\\end{bmatrix}$. Direct multiplication gives $$A^2=\\begin{bmatrix}9-10&15-15\\\\-6+6&-10+9\\end{bmatrix}=-I_2.$$ To construct it, start with $A=\\begin{bmatrix}a&b\\\\c&-a\\end{bmatrix}$, whose square is $(a^2+bc)I$. Choose real entries with $a^2+bc=-1$; for example $a=3,b=5,c=-2$. Select your own coefficients for an original submission." :db/id #edb/ref 17592186493214}] [:answer/id #uuid "4d293910-9760-5279-93d2-6e080f05d282" {:answer/feedback "True. If $A$ is $m\\times n$ and $B$ is $n\\times p$, both sides are $p\\times m$. Their (i,j)-entries agree: $(AB)^T_{ij}=\\sum_k a_{jk}b_{ki}=\\sum_k (B^T)_{ik}(A^T)_{kj}$. Transposing a product reverses the order." :answer/id #uuid "4d293910-9760-5279-93d2-6e080f05d282" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "True" :db/id #edb/ref 17592186493215}] [:answer/id #uuid "509b82fe-56dc-5ab3-95cd-7b83ba556e15" {:answer/id #uuid "509b82fe-56dc-5ab3-95cd-7b83ba556e15" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A basic variable is a variable whose coefficient column is a pivot column of the row-reduced augmented matrix. Such variables are solved in terms of any free variables. The augmented constant column is not a variable column." :db/id #edb/ref 17592186493216}] [:answer/id #uuid "5ecc2282-4a0e-5ef0-8862-995227dfba49" {:answer/id #uuid "5ecc2282-4a0e-5ef0-8862-995227dfba49" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "A square matrix A is symmetric when $A^T=A$, equivalently $a_{ij}=a_{ji}$ for every pair of indices. The entries mirror across the main diagonal." :db/id #edb/ref 17592186493218}] [:answer/id #uuid "607e7fa6-df3e-54f7-ba7a-392534993145" {:answer/feedback "Both right-hand sides are zero, so the system is homogeneous. The different numbers of equations and variables do not change that definition." :answer/id #uuid "607e7fa6-df3e-54f7-ba7a-392534993145" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "False" :db/id #edb/ref 17592186493219}] [:answer/id #uuid "64be9c12-dfb5-5a43-8da1-21cd255fc711" {:answer/feedback "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." :answer/id #uuid "64be9c12-dfb5-5a43-8da1-21cd255fc711" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "4x3" :db/id #edb/ref 17592186493221}] [:answer/id #uuid "6517541b-f8ff-51f4-a2a2-34924e88d0a6" {:answer/id #uuid "6517541b-f8ff-51f4-a2a2-34924e88d0a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186493222}] [:answer/id #uuid "69772d1f-87d7-576d-b0f5-8adcc2d8ff9f" {:answer/feedback "Yes. Multiplying every entry of the second matrix by 2 gives $(4,6;8,2)$, entry-for-entry equal to E." :answer/id #uuid "69772d1f-87d7-576d-b0f5-8adcc2d8ff9f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No" :db/id #edb/ref 17592186493224}] [:answer/id #uuid "6a999f09-d13a-56da-85cc-d3fb0cdaaf99" {:answer/feedback "No. Substituting zero for every variable makes every homogeneous equation $0=0$, so the trivial solution always exists. Homogeneity does not guarantee uniqueness." :answer/id #uuid "6a999f09-d13a-56da-85cc-d3fb0cdaaf99" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Yes" :db/id #edb/ref 17592186493226}] [:answer/id #uuid "7fbe29ee-2bb2-5753-9af9-70d8f08e67fc" {:answer/feedback "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." :answer/id #uuid "7fbe29ee-2bb2-5753-9af9-70d8f08e67fc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "3x2" :db/id #edb/ref 17592186493232}] [:multistep/id #uuid "b0d0bc1c-9140-51f8-89cc-4e6ef7a37a31" {:db/id #edb/ref 17592186493135 :multistep/context "Source question: Week 2 discussion, original matrix examples." :multistep/first-step {:db/id #edb/ref 17592186493129} :multistep/id #uuid "b0d0bc1c-9140-51f8-89cc-4e6ef7a37a31" :multistep/steps [{:db/id #edb/ref 17592186493129} {:db/id #edb/ref 17592186493156}]}] [:multistep/id #uuid "1ee9b271-b224-5ecd-97ba-edd32755a7a2" {:db/id #edb/ref 17592186493045 :multistep/context "Source question: Review Problem 2(a–d), PDF page 1.\n\nSuppose a linear system has **five equations and three variables**. Part (d) requires an example or impossibility explanation for each of (a)–(c); that work is included in the corresponding response below." :multistep/first-step {:db/id #edb/ref 17592186493161} :multistep/id #uuid "1ee9b271-b224-5ecd-97ba-edd32755a7a2" :multistep/steps [{:db/id #edb/ref 17592186493028} {:db/id #edb/ref 17592186493103} {:db/id #edb/ref 17592186493161}]}] [:multistep/id #uuid "5abcf76d-80dc-534c-8adc-aedc28da8a5c" {:db/id #edb/ref 17592186493074 :multistep/context "Source question: Review Problem 3(a–c), PDF page 1.\n\nConsider the augmented matrix $\\left[\\begin{array}{cc|c}1&h&2\\\\2&4&k\\end{array}\\right]$." :multistep/first-step {:db/id #edb/ref 17592186493110} :multistep/id #uuid "5abcf76d-80dc-534c-8adc-aedc28da8a5c" :multistep/steps [{:db/id #edb/ref 17592186493034} {:db/id #edb/ref 17592186493099} {:db/id #edb/ref 17592186493110}]}] [:assigned-problem/id #uuid "83baa9e1-9369-52fc-afee-da4f792530c0" {:assigned-problem/content {:db/id #edb/ref 17592186493080} :assigned-problem/id #uuid "83baa9e1-9369-52fc-afee-da4f792530c0" :db/id #edb/ref 17592186493101}] [:assigned-problem/id #uuid "8a407948-a7e1-5a5f-b721-c993fee337de" {:assigned-problem/content {:db/id #edb/ref 17592186493064} :assigned-problem/id #uuid "8a407948-a7e1-5a5f-b721-c993fee337de" :db/id #edb/ref 17592186493105}] [:assigned-problem/id #uuid "954f12e4-b267-57e3-92b3-bd22ace1a99c" {:assigned-problem/content {:db/id #edb/ref 17592186493074} :assigned-problem/id #uuid "954f12e4-b267-57e3-92b3-bd22ace1a99c" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048445} {:db/id #edb/ref 17592186049120}] :db/id #edb/ref 17592186493112}] [:assigned-problem/id #uuid "95a8bf33-0645-5987-8d15-6d1cdd5dc715" {:assigned-problem/content {:db/id #edb/ref 17592186493097} :assigned-problem/id #uuid "95a8bf33-0645-5987-8d15-6d1cdd5dc715" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048445} {:db/id #edb/ref 17592186049723}] :db/id #edb/ref 17592186493113}] [:assigned-problem/id #uuid "95c8e3e5-c259-5235-812b-f750e82823fa" {:assigned-problem/content {:db/id #edb/ref 17592186493104} :assigned-problem/id #uuid "95c8e3e5-c259-5235-812b-f750e82823fa" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048853}] :db/id #edb/ref 17592186493114}] [:assigned-problem/id #uuid "9bf121d9-3354-582d-96dd-9859df07c196" {:assigned-problem/content {:db/id #edb/ref 17592186493106} :assigned-problem/id #uuid "9bf121d9-3354-582d-96dd-9859df07c196" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050727}] :db/id #edb/ref 17592186493120}] [:assigned-problem/id #uuid "9dcbf433-33bd-55e5-a06f-326ac216ee6f" {:assigned-problem/content {:db/id #edb/ref 17592186493119} :assigned-problem/id #uuid "9dcbf433-33bd-55e5-a06f-326ac216ee6f" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186050765}] :db/id #edb/ref 17592186493124}] [:assigned-problem/id #uuid "a4502fb6-abe8-5e97-8637-84bd96cb2696" {:assigned-problem/content {:db/id #edb/ref 17592186493040} :assigned-problem/id #uuid "a4502fb6-abe8-5e97-8637-84bd96cb2696" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048252}] :db/id #edb/ref 17592186493126}] [:assigned-pro