9535304 17592186045436 true] [17592186493252 1080 "h=2,\\quad k=4" 13194139535304 17592186045436 true] [17592186493252 1082 #edb/ref 17592186045498 13194139535304 17592186045436 true] [17592186493252 1083 #uuid "b5085e24-dbb3-53af-9343-70f2225a3074" 13194139535304 17592186045436 true] [17592186493253 1080 "False" 13194139535304 17592186045436 true] [17592186493253 1081 "True. If $A$ is $m\\times n$ and $B$ is $n\\times p$, both sides are $p\\times m$. Their (i,j)-entries agree: $(AB)^T_{ij}=\\sum_k a_{jk}b_{ki}=\\sum_k (B^T)_{ik}(A^T)_{kj}$. Transposing a product reverses the order." 13194139535304 17592186045436 true] [17592186493253 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493253 1083 #uuid "b53da8de-fbfe-5c54-9c4a-9994ea5f8167" 13194139535304 17592186045436 true] [17592186493254 1080 "A square matrix A is skew symmetric when $A^T=-A$, equivalently $a_{ji}=-a_{ij}$. For real matrices, every diagonal entry must be zero because $a_{ii}=-a_{ii}$. For example $\\begin{bmatrix}0&2\\\\-2&0\\end{bmatrix}$ is skew symmetric." 13194139535304 17592186045436 true] [17592186493254 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493254 1083 #uuid "b5c4f126-abcd-5c09-b688-def7b6d6f366" 13194139535304 17592186045436 true] [17592186493255 1075 #edb/ref 17592186493215 13194139535304 17592186045436 true] [17592186493255 1075 #edb/ref 17592186493253 13194139535304 17592186045436 true] [17592186493255 1076 #edb/ref 17592186045493 13194139535304 17592186045436 true] [17592186493255 1077 "answer" 13194139535304 17592186045436 true] [17592186493255 1078 #edb/ref 17592186493215 13194139535304 17592186045436 true] [17592186493255 1079 #uuid "ba41987a-5a08-598d-b369-510b9bbba9a7" 13194139535304 17592186045436 true] [17592186493256 1080 "A pivot column is a column containing a pivot position in echelon form. To find it, locate each nonzero row’s leading entry and identify its column. A coefficient pivot column corresponds to a basic variable; a pivot in the augmented column instead signals inconsistency." 13194139535304 17592186045436 true] [17592186493256 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493256 1083 #uuid "badae619-1426-5ed3-82a1-6cd7ec86ab5e" 13194139535304 17592186045436 true] [17592186493257 1080 "Yes" 13194139535304 17592186045436 true] [17592186493257 1081 "Yes. Multiplying every entry of the second matrix by 2 gives $(4,6;8,2)$, entry-for-entry equal to E." 13194139535304 17592186045436 true] [17592186493257 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493257 1083 #uuid "bb354bcf-dd88-5e69-9e3e-22aa98d0d944" 13194139535304 17592186045436 true] [17592186493258 1075 #edb/ref 17592186493211 13194139535304 17592186045436 true] [17592186493258 1075 #edb/ref 17592186493288 13194139535304 17592186045436 true] [17592186493258 1076 #edb/ref 17592186045493 13194139535304 17592186045436 true] [17592186493258 1077 "answer" 13194139535304 17592186045436 true] [17592186493258 1078 #edb/ref 17592186493288 13194139535304 17592186045436 true] [17592186493258 1079 #uuid "bcaea671-164d-5e38-87ff-aa0ad95e1bed" 13194139535304 17592186045436 true] [17592186493259 1080 "An authored reference is $B=\\begin{bmatrix}6&9\\\\-4&-6\\end{bmatrix}$, which is nonzero. Its square is $$B^2=\\begin{bmatrix}36-36&54-54\\\\-24+24&-36+36\\end{bmatrix}=0.$$ Again, a matrix $\\begin{bmatrix}a&b\\\\c&-a\\end{bmatrix}$ squares to $(a^2+bc)I$. Choose nonzero entries satisfying $a^2+bc=0$. Here $36+9(-4)=0$. Nonzero matrices can have zero square; ordinary scalar intuition does not apply." 13194139535304 17592186045436 true] [17592186493259 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493259 1083 #uuid "bcd28e56-fb94-5db7-a6d1-6bc4020e6257" 13194139535304 17592186045436 true] [17592186493260 1075 #edb/ref 17592186493270 13194139535304 17592186045436 true] [17592186493260 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493260 1077 "response" 13194139535304 17592186045436 true] [17592186493260 1078 #edb/ref 17592186493270 13194139535304 17592186045436 true] [17592186493260 1079 #uuid "bceb05d1-ff0c-5b4d-a07e-5b033da7f168" 13194139535304 17592186045436 true] [17592186493261 1075 #edb/ref 17592186493200 13194139535304 17592186045436 true] [17592186493261 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493261 1077 "response" 13194139535304 17592186045436 true] [17592186493261 1078 #edb/ref 17592186493200 13194139535304 17592186045436 true] [17592186493261 1079 #uuid "bf77d55f-10b7-58f1-b865-454d8b39509e" 13194139535304 17592186045436 true] [17592186493262 1080 "A complete peer response identifies a real classmate’s proposed equations, verifies that the first two have a common solution, and checks that the three together are inconsistent. Row-reduce the first two and then the full augmented matrix, or compare any dependent left-hand sides with their constants. If the full system is consistent, propose changing the right-hand side of a dependent equation. If it works, describe an alternative such as two intersecting planes and a third plane parallel to one of them with a different constant. This is a response checklist, not a claim about an unseen classmate’s work." 13194139535304 17592186045436 true] [17592186493262 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493262 1083 #uuid "bf7d7d44-dfa9-5ab1-821e-1a20a8ba1270" 13194139535304 17592186045436 true] [17592186493263 1080 "True" 13194139535304 17592186045436 true] [17592186493263 1081 "True. The inner dimensions of $(3\\times3)(3\\times4)$ agree. AB is a $3\\times4$ matrix." 13194139535304 17592186045436 true] [17592186493263 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493263 1083 #uuid "bf81c91e-9f65-55cb-b77c-44fcf80cf693" 13194139535304 17592186045436 true] [17592186493264 1075 #edb/ref 17592186493275 13194139535304 17592186045436 true] [17592186493264 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493264 1077 "response" 13194139535304 17592186045436 true] [17592186493264 1078 #edb/ref 17592186493275 13194139535304 17592186045436 true] [17592186493264 1079 #uuid "c11825d6-bc69-5b35-bfbb-dfc28e5b2930" 13194139535304 17592186045436 true] [17592186493265 1080 "A is invertible if it is square and there is a matrix $A^{-1}$ of the same size with $AA^{-1}=A^{-1}A=I$. Both products give the identity. Nonzero entries alone do not imply invertibility." 13194139535304 17592186045436 true] [17592186493265 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493265 1083 #uuid "c12cd01d-7d18-5b53-b479-b430cbe49ddc" 13194139535304 17592186045436 true] [17592186493266 1080 "h\\ne2,\\quad k\\in\\mathbb R" 13194139535304 17592186045436 true] [17592186493266 1082 #edb/ref 17592186045498 13194139535304 17592186045436 true] [17592186493266 1083 #uuid "c17d716c-53fa-5483-80d4-8de6cdfe510d" 13194139535304 17592186045436 true] [17592186493267 1075 #edb/ref 17592186493280 13194139535304 17592186045436 true] [17592186493267 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493267 1077 "response" 13194139535304 17592186045436 true] [17592186493267 1078 #edb/ref 17592186493280 13194139535304 17592186045436 true] [17592186493267 1079 #uuid "c3c400da-57bb-55b4-9413-7833541fa906" 13194139535304 17592186045436 true] [17592186493268 1075 #edb/ref 17592186493254 13194139535304 17592186045436 true] [17592186493268 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493268 1077 "response" 13194139535304 17592186045436 true] [17592186493268 1078 #edb/ref 17592186493254 13194139535304 17592186045436 true] [17592186493268 1079 #uuid "cc98888d-8eb1-5a7c-8b8b-1dd4171bc0e6" 13194139535304 17592186045436 true] [17592186493269 1075 #edb/ref 17592186493252 13194139535304 17592186045436 true] [17592186493269 1076 #edb/ref 17592186045492 13194139535304 17592186045436 true] [17592186493269 1077 "answer" 13194139535304 17592186045436 true] [17592186493269 1078 #edb/ref 17592186493252 13194139535304 17592186045436 true] [17592186493269 1079 #uuid "cf8ed2c8-ccc4-5429-b5fc-7bccd67defa5" 13194139535304 17592186045436 true] [17592186493270 1080 "A pivot position is the position of the leading nonzero entry in a nonzero row of an echelon form. In this textbook’s normalized row-echelon form, and in RREF, that entry is 1. The position is the row-column location; it is not the entire column." 13194139535304 17592186045436 true] [17592186493270 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493270 1083 #uuid "d3be0592-83e5-5d2b-9b71-07c6e87e20c9" 13194139535304 17592186045436 true] [17592186493271 1080 "One authored reference example is $$\\begin{cases}x+7y-2z=3\\\\3x-y+5z=4\\\\7x+5y+8z=16\\end{cases}$$ The first two equations have, for example, the solution $(31/22,5/22,0)$. Their first left-hand side plus twice their second left-hand side is $7x+5y+8z$, but the corresponding right-hand side is $3+2(4)=11$, not 16. Thus no point satisfies all three. The construction deliberately makes the third left side dependent while choosing an incompatible constant. For your own submission, choose your own coefficients and confirm it differs from your course examples." 13194139535304 17592186045436 true] [17592186493271 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493271 1083 #uuid "d4c82f88-0259-53f9-a11b-3eb3ebad510a" 13194139535304 17592186045436 true] [17592186493272 1080 "False" 13194139535304 17592186045436 true] [17592186493272 1081 "True: $2(1,1,1)^T+1(0,0,1)^T=(2,2,3)^T$. The same scalar multiplies every component of a given vector." 13194139535304 17592186045436 true] [17592186493272 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493272 1083 #uuid "d578d171-2f12-53b2-8555-0a87c0bf4b8e" 13194139535304 17592186045436 true] [17592186493273 1075 #edb/ref 17592186493201 13194139535304 17592186045436 true] [17592186493273 1075 #edb/ref 17592186493207 13194139535304 17592186045436 true] [17592186493273 1076 #edb/ref 17592186045493 13194139535304 17592186045436 true] [17592186493273 1077 "answer" 13194139535304 17592186045436 true] [17592186493273 1078 #edb/ref 17592186493201 13194139535304 17592186045436 true] [17592186493273 1079 #uuid "d84095a2-6b83-5bfd-95df-043b48d17a26" 13194139535304 17592186045436 true] [17592186493274 1080 "2x4" 13194139535304 17592186045436 true] [17592186493274 1081 "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." 13194139535304 17592186045436 true] [17592186493274 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493274 1083 #uuid "d942d337-74fb-509f-843d-afc92276a808" 13194139535304 17592186045436 true] [17592186493275 1080 "Transposition interchanges rows and columns. If $A=(a_{ij})$ is $m\\times n$, then $A^T$ is $n\\times m$ and $(A^T)_{ij}=a_{ji}$. It does not negate the entries." 13194139535304 17592186045436 true] [17592186493275 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493275 1083 #uuid "da4fc77f-38a1-5fc4-9309-6422e5ecc82e" 13194139535304 17592186045436 true] [17592186493276 1080 "Yes. Use $x=1$, $y=2$, $z=3$, $x+y=3$, and $y+z=5$. The first three force the unique point $(1,2,3)$ and the last two are satisfied by it. The coefficient and augmented ranks are both 3. Extra equations do not destroy uniqueness when they are compatible." 13194139535304 17592186045436 true] [17592186493276 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493276 1083 #uuid "dec75c03-b189-5d4d-a30f-b213dce4e894" 13194139535304 17592186045436 true] [17592186493277 1080 "4x2" 13194139535304 17592186045436 true] [17592186493277 1081 "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." 13194139535304 17592186045436 true] [17592186493277 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493277 1083 #uuid "e3f197e6-0707-538b-9236-03b6386c271a" 13194139535304 17592186045436 true] [17592186493278 1080 "True" 13194139535304 17592186045436 true] [17592186493278 1081 "False. For example, $A=\\begin{bmatrix}1&0\\\\0&0\\end{bmatrix}$ and $B=\\begin{bmatrix}0&1\\\\0&0\\end{bmatrix}$ give $AB=B$ but $BA=0$. Both products exist, but matrix multiplication need not commute." 13194139535304 17592186045436 true] [17592186493278 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493278 1083 #uuid "e69221d7-23be-5804-b1e5-946b8d560ace" 13194139535304 17592186045436 true] [17592186493279 1080 "Yes. One example is $x+y+z=0$, $2x+2y+2z=0$, $3x+3y+3z=0$, $4x+4y+4z=0$, and $5x+5y+5z=0$. All five reduce to the same equation, so $(x,y,z)=(s,t,-s-t)$, $s,t\\in\\mathbb R$. The coefficient and augmented matrices both have rank 1; two variables are free." 13194139535304 17592186045436 true] [17592186493279 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493279 1083 #uuid "eabdcb3e-ce82-5850-8f6a-33fc28ad8953" 13194139535304 17592186045436 true] [17592186493280 1080 "Yes. Use $x+y+z=0$, $x+y+z=1$, $x=0$, $y=0$, and $z=0$. The first two equations already contradict each other. Subtracting their augmented rows gives $[0\\ 0\\ 0\\mid1]$, so no common solution exists." 13194139535304 17592186045436 true] [17592186493280 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493280 1083 #uuid "ee562462-0feb-5e6c-8955-60527c2a0244" 13194139535304 17592186045436 true] [17592186493281 1080 "A" 13194139535304 17592186045436 true] [17592186493281 1082 #edb/ref 17592186045498 13194139535304 17592186045436 true] [17592186493281 1083 #uuid "ef752f77-7085-5620-b577-5b5d807bdb74" 13194139535304 17592186045436 true] [17592186493282 1080 "True" 13194139535304 17592186045436 true] [17592186493282 1081 "True: $2(1,1,1)^T+1(0,0,1)^T=(2,2,3)^T$. The same scalar multiplies every component of a given vector." 13194139535304 17592186045436 true] [17592186493282 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493282 1083 #uuid "f0366301-63aa-53e5-9b6b-5a6cf29aa67d" 13194139535304 17592186045436 true] [17592186493283 1080 "3" 13194139535304 17592186045436 true] [17592186493283 1081 "All three rows are the same nonzero row. Subtract the first row from the other two to get one nonzero row and two zero rows, so the rank is 1. Rank is neither the number of repeated rows nor the number of columns." 13194139535304 17592186045436 true] [17592186493283 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493283 1083 #uuid "f06e9819-95a6-5020-8f15-7b29c9c57bb5" 13194139535304 17592186045436 true] [17592186493284 1075 #edb/ref 17592186493197 13194139535304 17592186045436 true] [17592186493284 1075 #edb/ref 17592186493233 13194139535304 17592186045436 true] [17592186493284 1075 #edb/ref 17592186493245 13194139535304 17592186045436 true] [17592186493284 1075 #edb/ref 17592186493283 13194139535304 17592186045436 true] [17592186493284 1075 #edb/ref 17592186493287 13194139535304 17592186045436 true] [17592186493284 1076 #edb/ref 17592186045493 13194139535304 17592186045436 true] [17592186493284 1077 "answer" 13194139535304 17592186045436 true] [17592186493284 1078 #edb/ref 17592186493233 13194139535304 17592186045436 true] [17592186493284 1079 #uuid "f0ce39ef-c7ab-58ea-9d1f-1ce6ce1a7f9b" 13194139535304 17592186045436 true] [17592186493285 1080 "2x3" 13194139535304 17592186045436 true] [17592186493285 1081 "$M$ is $4\\times3$ and $N$ is $3\\times2$. The shared inner dimension 3 makes the product defined; the outer dimensions give $4\\times2$." 13194139535304 17592186045436 true] [17592186493285 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493285 1083 #uuid "f76435e9-f25b-5418-a