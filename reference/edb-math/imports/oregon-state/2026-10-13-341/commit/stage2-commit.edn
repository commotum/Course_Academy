 17592186045436 true] [17592186493223 1078 #edb/ref 17592186493214 13194139535304 17592186045436 true] [17592186493223 1079 #uuid "683829ff-8123-567b-89fc-6e5e46ee58e3" 13194139535304 17592186045436 true] [17592186493224 1080 "No" 13194139535304 17592186045436 true] [17592186493224 1081 "Yes. Multiplying every entry of the second matrix by 2 gives $(4,6;8,2)$, entry-for-entry equal to E." 13194139535304 17592186045436 true] [17592186493224 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493224 1083 #uuid "69772d1f-87d7-576d-b0f5-8adcc2d8ff9f" 13194139535304 17592186045436 true] [17592186493225 1075 #edb/ref 17592186493196 13194139535304 17592186045436 true] [17592186493225 1075 #edb/ref 17592186493251 13194139535304 17592186045436 true] [17592186493225 1076 #edb/ref 17592186045493 13194139535304 17592186045436 true] [17592186493225 1077 "answer" 13194139535304 17592186045436 true] [17592186493225 1078 #edb/ref 17592186493251 13194139535304 17592186045436 true] [17592186493225 1079 #uuid "6a058e5b-2398-5424-9ccb-d52eccb70f90" 13194139535304 17592186045436 true] [17592186493226 1080 "Yes" 13194139535304 17592186045436 true] [17592186493226 1081 "No. Substituting zero for every variable makes every homogeneous equation $0=0$, so the trivial solution always exists. Homogeneity does not guarantee uniqueness." 13194139535304 17592186045436 true] [17592186493226 1082 #edb/ref 17592186045499 13194139535304 17592186045436 true] [17592186493226 1083 #uuid "6a999f09-d13a-56da-85cc-d3fb0cdaaf99" 13194139535304 17592186045436 true] [17592186493227 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493227 1077 "answer" 13194139535304 17592186045436 true] [17592186493227 1079 #uuid "6af3d7e1-23f6-5847-ae4a-7926a32ce10b" 13194139535304 17592186045436 true] [17592186493228 1075 #edb/ref 17592186493259 13194139535304 17592186045436 true] [17592186493228 1076 #edb/ref 17592186408167 13194139535304 17592186045436 true] [17592186493228 10