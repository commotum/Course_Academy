torial/validate} {:db/id "5e9f9735-35c3-5380-b2fa-01ac0753e615" :question/id #uuid "5e9f9735-35c3-5380-b2fa-01ac0753e615" :question/problem "Source question: Canvas Question 1 (question_59459026).\n\nI understand that elementary row operations for matrices are “the same” as elementary operations for linear equations.\n\nc1. True\n\nc2. False\n\nYour selection: ____" :db/ensure :question/validate} {:db/id "83baa9e1-9369-52fc-afee-da4f792530c0" :assigned-problem/id #uuid "83baa9e1-9369-52fc-afee-da4f792530c0" :assigned-problem/content "5e9f9735-35c3-5380-b2fa-01ac0753e615" :db/ensure :assigned-problem/validate} {:db/id "9b4f589c-1832-5f6e-becf-d297def301fd" :question/id #uuid "9b4f589c-1832-5f6e-becf-d297def301fd" :question/problem "Source question: Canvas Question 2 (question_59459027).\n\nTrue or false: the system $$\\begin{cases}2x-3y+4z=7\\\\3y-2x-z=-1\\\\x-2y+3z=5\\end{cases}$$ has augmented matrix $$\\left[\\begin{array}{ccc|c}2&-3&4&7\\\\-2&3&-1&-1\\\\1&-2&3&5\\end{array}\\right]$$.\n\n1. True\n\n2. False" :db/ensure :question/validate} {:db/id "9dcbf433-33bd-55e5-a06f-326ac216ee6f" :assigned-problem/id #uuid "9dcbf433-33bd-55e5-a06f-326ac216ee6f" :assigned-problem/content "9b4f589c-1832-5f6e-becf-d297def301fd" :db/ensure :assigned-problem/validate} {:db/id "516497a5-baf1-555d-bad6-0155bec29c8c" :question/id #uuid "516497a5-baf1-555d-bad6-0155bec29c8c" :question/problem "Source question: Canvas Question 3 (question_59459028).\n\nWhat is a pivot position in an augmented matrix that has been row reduced?" :db/ensure :question/validate} {:db/id "eae0f5d9-bb38-5708-a64d-ac6e9221d6dd" :assigned-problem/id #uuid "eae0f5d9-bb38-5708-a64d-ac6e9221d6dd" :assigned-problem/content "516497a5-baf1-555d-bad6-0155bec29c8c" :db/ensure :assigned-problem/validate} {:db/id "f15bcc0e-c3eb-5d42-ae58-d0976739b724" :question/id #uuid "f15bcc0e-c3eb-5d42-ae58-d0976739b724" :question/problem "Source question: Canvas Question 4 (question_59459029).\n\nWhat is a pivot column in an augmented matrix that has been row reduced?" :db/ensure :question/validate} {:db/id "508ed9c1-6bbe-5783-b1cb-c19ccbfc837d" :assigned-problem/id #uuid "508ed9c1-6bbe-5783-b1cb-c19ccbfc837d" :assigned-problem/content "f15bcc0e-c3eb-5d42-ae58-d0976739b724" :db/ensure :assigned-problem/validate} {:db/id "43003fc3-b031-57a5-aa91-4adcb7b71d2b" :question/id #uuid "43003fc3-b031-57a5-aa91-4adcb7b71d2b" :question/problem "Source question: Canvas Question 5 (question_59459030).\n\nAfter reading Algorithm 1.19 on textbook page 19, do you feel able to create an augmented matrix from a system of equations and row reduce it to RREF by yourself? You will be asked to do this in class. The source allows multiple selections.\n\nc1. Yes\n\nc2. No\n\nc3. Maybe\n\nYour selections: ____" :db/ensure :question/validate} {:db/id "12080f83-4f94-59ae-8659-47ce75f6f42d" :assigned-problem/id #uuid "12080f83-4f94-59ae-8659-47ce75f6f42d" :assigned-problem/content "43003fc3-b031-57a5-aa91-4adcb7b71d2b" :db/ensure :assigned-problem/validate} {:db/id "7b8bacba-83fd-5cfd-bb71-9e46cf358e9c" :question/id #uuid "7b8bacba-83fd-5cfd-bb71-9e46cf358e9c" :question/problem "Source question: Canvas Question 6 (question_59459031).\n\nWhat is a basic variable?" :db/ensure :question/validate} {:db/id "95a8bf33-0645-5987-8d15-6d1cdd5dc715" :assigned-problem/id #uuid "95a8bf33-0645-5987-8d15-6d1cdd5dc715" :assigned-problem/content "7b8bacba-83fd-5cfd-bb71-9e46cf358e9c" :db/ensure :assigned-problem/validate} {:db/id "4a81573c-399a-523c-bdde-4b9f90840625" :question/id #uuid "4a81573c-399a-523c-bdde-4b9f90840625" :question/problem "Source question: Canvas Question 7 (question_59459032).\n\nWhat is a free variable?" :db/ensure :question/validate} {:db/id "bae54f4c-82ae-5eaa-b221-f6b81c0e589b" :assigned-problem/id #uuid "bae54f4c-82ae-5eaa-b221-f6b81c0e589b" :assigned-problem/content "4a81573c-399a-523c-bdde-4b9f90840625" :db/ensure :assigned-problem/validate} {:db/id "5b9660a3-885f-5fac-98c2-18e106a61985" :step/id #uuid "5b9