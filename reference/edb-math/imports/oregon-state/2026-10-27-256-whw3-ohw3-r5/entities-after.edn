} :step/id #uuid "5c1cafe8-f21b-5c04-8b52-fd4a782919a7" :step/next {:db/id #edb/ref 17592186725598}}] [:step/id #uuid "5f13db05-7d05-5268-acf9-795b210da28d" {:db/id #edb/ref 17592186725616 :step/content {:db/id #edb/ref 17592186725548} :step/id #uuid "5f13db05-7d05-5268-acf9-795b210da28d" :step/next {:db/id #edb/ref 17592186725670}}] [:step/id #uuid "646619cf-f890-5868-8e5f-4ecb5ef7fe8a" {:db/id #edb/ref 17592186725619 :step/content {:db/id #edb/ref 17592186725621} :step/id #uuid "646619cf-f890-5868-8e5f-4ecb5ef7fe8a" :step/next {:db/id #edb/ref 17592186725703}}] [:step/id #uuid "710697c5-874c-5d03-9b8e-e037987b2eb8" {:db/id #edb/ref 17592186725628 :step/content {:db/id #edb/ref 17592186725611} :step/id #uuid "710697c5-874c-5d03-9b8e-e037987b2eb8" :step/next {:db/id #edb/ref 17592186725713}}] [:step/id #uuid "741ede89-eee5-5be7-ad4f-85db12bd0e8d" {:db/id #edb/ref 17592186725632 :step/content {:db/id #edb/ref 17592186725684} :step/id #uuid "741ede89-eee5-5be7-ad4f-85db12bd0e8d"}] [:step/id #uuid "7579277a-1be0-52da-8848-e52c9ee879d0" {:db/id #edb/ref 17592186725633 :step/content {:db/id #edb/ref 17592186725610} :step/id #uuid "7579277a-1be0-52da-8848-e52c9ee879d0" :step/next {:db/id #edb/ref 17592186725686}}] [:step/id #uuid "762fd679-7500-5fc4-9852-0e9b05be8a57" {:db/id #edb/ref 17592186725635 :step/content {:db/id #edb/ref 17592186725577} :step/id #uuid "762fd679-7500-5fc4-9852-0e9b05be8a57" :step/next {:db/id #edb/ref 17592186725628}}] [:step/id #uuid "786e79d6-1aec-53f1-aaa8-a4a4f40be0f0" {:db/id #edb/ref 17592186725640 :step/content {:db/id #edb/ref 17592186725566} :step/id #uuid "786e79d6-1aec-53f1-aaa8-a4a4f40be0f0" :step/next {:db/id #edb/ref 17592186725568}}] [:step/id #uuid "797f78e0-3a21-5a2c-9716-7b2dd5922de0" {:db/id #edb/ref 17592186725642 :step/content {:db/id #edb/ref 17592186725663} :step/id #uuid "797f78e0-3a21-5a2c-9716-7b2dd5922de0"}] [:tutorial/id #uuid "071ab7bb-69a1-5205-9fc8-75c9ecff92c5" {:db/id #edb/ref 17592186725537 :tutorial/content "**MTH 256 — WeBWorK — WebWork 3**\n\nDue: 2026-10-30\nDate imported: 2026-10-27\nSource: [WebWork 3](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_3/)\nDeadline source: User’s explicit Friday deadline, 2026-10-30 (date only).\nPlatform deadline: WeBWorK displays November 1, 2026 at 11:59 p.m. PST.\nDeadline convention: The Friday date supplied by the user controls this study assignment; no Friday submission time was supplied. The application’s established date-only convention is end of day, 23:59:59 America/Los_Angeles.\n\nStudy answers and explanations are independently authored additions.\n\n## Instructions\n\nSeven problems, each worth 1 point, with unlimited attempts. Retain the assigned numerical variants and all source response slots. Problems 2–5 and 7 permit partial credit. The platform says late work earns 75% until December 9, 2026 at 11:59 p.m. PST; its listed platform deadline differs from the user’s Friday study deadline above. No rounding rule appears on these questions; exact study answers and optional decimal checks are provided. No answers were entered or submitted to WeBWorK." :tutorial/id #uuid "071ab7bb-69a1-5205-9fc8-75c9ecff92c5" :tutorial/title "Assignment information"}] [:tutorial/id #uuid "2aaf9fe9-0dc2-502c-9e7b-c55af43b827a" {:db/id #edb/ref 17592186725566 :tutorial/content "**MTH 256 — Recitation 5 Activity**\n\nDue: 2026-10-28\nDate imported: 2026-10-27\nSource: [256-R5.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FR-5%2F256-R5.pdf)\nDue time: 11:59 p.m. PDT\nDeadline source: [Canvas Recitation 5 Activity](https://canvas.oregonstate.edu/courses/2064169/assignments/10722770), checked 2026-10-27; Wednesday by 11:59 p.m.\n\nStudy answers and explanations are independently authored additions.\n\n## Instructions\n\nThis active-learning activity teaches the process for Problems 2–5 on WebWork 3. Work through each requested intermediate model and calculation. Use hours in Problem 1, years since 1989 in Problem 2, and minutes in Problems 3–4. Exact values are provided as study keys; decimal approximations in explanations are optional, since the PDF specifies no rounding rule. Pages 3, 5, and 7 contain only workspace, not additional problems." :tutorial/id #uuid "2aaf9fe9-0dc2-502c-9e7b-c55af43b827a" :tutorial/title "Assignment information"}] [:tutorial/id #uuid "5a9860e7-1a8a-5141-b0f2-7104a8afa2cd" {:db/id #edb/ref 17592186725612 :tutorial/content "**MTH 256 — Written Homework 3**\n\nDue: 2026-10-30\nDate imported: 2026-10-27\nSource: [256-WHW3.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FWHW-3%2F256-WHW3.pdf)\nDue time: 11:59 p.m. PDT\nDeadline source: [Canvas Written Homework 3](https://canvas.oregonstate.edu/courses/2064169/assignments/10722772), checked 2026-10-27; Friday by 11:59 p.m., also confirmed by the user.\n\nStudy answers and explanations are independently authored additions.\n\n## Instructions\n\nRetain all derivations and drawings. Problem 3 explicitly requires a statement explaining why each pair is a fundamental set of solutions. The physical spring interpretation uses $m>0$ and $k>0$; the source gives no numerical values for them. In Problem 2 the PDF prints the acceleration unit as “$m/x$”; this is a source typo. Use the supplied equation with the stated numerical value $g=9.8$ (for a one-meter pendulum, the coefficient is acceleration divided by length)." :tutorial/id #uuid "5a9860e7-1a8a-5141-b0f2-7104a8afa2cd" :tutorial/title "Assignment information"}] [:question/id #uuid "8f2ff586-5c08-5985-851b-11eed9fd9327" {:db/id #edb/ref 17592186725653 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e619384c-0826-5b03-8089-28d199da7636" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The chain rule gives $\\theta\\!\\prime\\!\\prime=(dv/d\\theta)(d\\theta/dt)=v\\,dv/d\\theta$. Hence $v\\,dv/d\\theta=-g\\sin\\theta$, equivalently $v\\,dv=-g\\sin\\theta\\,d\\theta$." :db/id #edb/ref 17592186725722}] :answer-field/correct {:db/id #edb/ref 17592186725722} :answer-field/id #uuid "f1983a61-fc77-544e-91a4-b0bdb9d27db5" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725731}] :question/id #uuid "8f2ff586-5c08-5985-851b-11eed9fd9327" :question/problem "**(a)** Derive a separable differential equation involving $\\theta$, $v$, and $dv/d\\theta$. Show the change of variable." :question/worked-solution "Here $v$ is angular velocity. The change to angle as the independent variable is local where that parametrization is valid; omitting the chain-rule factor $v$ gives the wrong equation."}] [:question/id #uuid "931f5d2e-4962-5c0e-b914-226502af5591" {:db/id #edb/ref 17592186725658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "906c3a2f-1636-53a2-9793-95133477f785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186725654}] :answer-field/correct {:db/id #edb/ref 17592186725654} :answer-field/id #uuid "af605a2b-2869-5f31-b2b3-35ad200fa152" :answer-field/key "r2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725681} {:answer-field/choices [{:answer/id #uuid "0cd45acc-dd54-527c-8479-82577233fa7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186725544}] :answer-field/correct {:db/id #edb/ref 17592186725544} :answer-field/id #uuid "c3e93303-4a61-5610-b831-f6dea0bfa195" :answer-field/key "r1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725700}] :question/id #uuid "931f5d2e-4962-5c0e-b914-226502af5591" :question/problem "Source question: [WeBWorK Problem 7](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_3/7).\n\nThe general solution of $y\\!\\prime\\!\\prime+2y\\prime-24y=0$ has the form $y(x)=c_1e^{r_1x}+c_2e^{r_2x}$. Find $r_1$ and $r_2$.\n\n$r_1=$ {{r1}} and $r_2=$ {{r2}}." :question/worked-solution "The characteristic polynomial is $r^2+2r-24=(r-4)(r+6)$, so the two roots are $4$ and $-6$. One labeling is $r_1=4$, $r_2=-6$; reversing the labels gives the same general solution after swapping $c_1,c_2$. The two roots must be distinct."}] [:question/id #uuid "955723f3-9c6b-53de-8450-decddf9985a5" {:db/id #edb/ref 17592186725659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "454b4315-8409-508c-b13d-b8878b042cc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30-15e^{-t/15}" :db/id #edb/ref 17592186725597}] :answer-field/correct {:db/id #edb/ref 17592186725597} :answer-field/id #uuid "23288ce6-e30b-5961-9fb4-6851c029c5e6" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725562}] :question/id #uuid "955723f3-9c6b-53de-8450-decddf9985a5" :question/problem "**(c)** Solve the IVP to determine $Q(t)$. $Q(t)=$ {{mass}} pounds.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "The equilibrium mass is $30$ pounds. Set $U=Q-30$ to get $U\\prime=-U/15$, $U(0)=-15$, so $Q=30-15e^{-t/15}$. Check $Q(0)=15$ and $Q\\prime=e^{-t/15}=2-Q/15$."}] [:question/id #uuid "9c3f031f-f0e2-55e2-880e-f5857e2be6b4" {:db/id #edb/ref 17592186725665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43348720-23d7-5a2f-a2f6-b3710f7b9375" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\ln50}{\\ln10}" :db/id #edb/ref 17592186725595}] :answer-field/correct {:db/id #edb/ref 17592186725595} :answer-field/id #uuid "3a5fed1c-174d-5a92-a53d-961b89f8ec65" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725580}] :question/id #uuid "9c3f031f-f0e2-55e2-880e-f5857e2be6b4" :question/problem "**(d)** Solve $P(t)=100000$ for $t$ to determine the time to reach that population. $t=$ {{time}} hours." :question/worked-solution "$2000e^{rt}=100000$ reduces to $e^{rt}=50$. Therefore $t=\\ln50/r=10\\ln50/\\ln10\\approx16.9897$ hours after the initial observation."}] [:question/id #uuid "a39e7c4b-5b0d-5e36-8919-5cac9904beee" {:db/id #edb/ref 17592186725672 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e39301a8-3c31-5a77-a7fb-459d8c254cd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,5" :db/id #edb/ref 17592186725721}] :answer-field/correct {:db/id #edb/ref 17592186725721} :answer-field/id #uuid "2d46db2f-3c33-51a8-84d4-a47e732547ad" :answer-field/key "roots" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725569}] :question/id #uuid "a39e7c4b-5b0d-5e36-8919-5cac9904beee" :question/problem "Source question: [WeBWorK Problem 6](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_3/6).\n\nFor what values of $r$ does $y=e^{rx}$ satisfy $y\\!\\prime\\!\\prime-9y\\prime+20y=0$? Separate the values by commas: $r=$ {{roots}}." :question/worked-solution "Substitution gives $e^{rx}(r^2-9r+20)=0$. Since the exponential never vanishes, solve $(r-4)(r-5)=0$, giving $r=4,5$. Substituting either value into the characteristic polynomial gives zero."}] [:question/id #uuid "a9c87327-3f9a-5655-b78a-b474c82eded0" {:db/id #edb/ref 17592186725677 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b79c322-6598-546f-ad9c-ecda3e0b8cee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln2}{5597}" :db/id #edb/ref 17592186725583}] :answer-field/correct {:db/id #edb/ref 17592186725583} :answer-field/id #uuid "ff6095c6-d621-568e-945a-4a98930a3119" :answer-field/key "rate" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725744}] :question/id #uuid "a9c87327-3f9a-5655-b78a-b474c82eded0" :question/problem "**(a)** Find $k$ in $C\\prime=-kC$. $k=$ {{rate}} per year." :question/worked-solution "$C(t)=C(0)e^{-kt}$ and $C(5597)=C(0)/2$. Hence $e^{-5597k}=1/2$ and $k=\\ln2/5597\\approx0.0001238426$ per year."}] [:question/id #uuid "ae3e0cea-9932-57e0-baa5-af6c78393887" {:db/id #edb/ref 17592186725680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac015d86-1e71-504f-89e3-9cddc6d0109a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50+50\\exp(-63/50)" :db/id #edb/ref 17592186725679}] :answer-field/correct {:db/id #edb/ref 17592186725679} :answer-field/id #uuid "cf9fa493-66ab-5d2d-96a9-ac5a5db9462c" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725709}] :question/id #uuid "ae3e0cea-9932-57e0-baa5-af6c78393887" :question/problem "**(b)** Find the salt mass after 3.5 hours. Amount $=$ {{mass}} kg.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "Volume stays 1000 L. The balance is $Q\\prime=0.05(6)-(6/1000)Q=0.3-0.006Q$, $Q(0)=100$. Thus $Q(t)=50+50e^{-0.006t}$ with $t$ in minutes. Convert 3.5 hours to 210 minutes: $Q(210)=50+50e^{-1.26}\\approx64.1827$ kg."}] [:question/id #uuid "b38f63c5-0074-54c6-aed4-bd6dbe5a4e7e" {:db/id #edb/ref 17592186725685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be33fc5d-7e68-51d1-bb43-2fc9c184a9a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac1{10}" :db/id #edb/ref 17592186725694}] :answer-field/correct {:db/id #edb/ref 17592186725694} :answer-field/id #uuid "3e86b2d5-29e6-5939-a05d-08cd2678b5a0" :answer-field/key "concentration" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725589}] :question/id #uuid "b38f63c5-0074-54c6-aed4-bd6dbe5a4e7e" :question/problem "**(a)** What is the initial concentration? Concentration $=$ {{concentration}} kg/L." :question/worked-solution "The initial concentration is $100/1000=0.1$ kg/L, not the incoming concentration 0.05 kg/L."}] [:question/id #uuid "c3285c9a-9575-5529-bbdf-ba74e9f9589f" {:db/id #edb/ref 17592186725699 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eea4edcd-2fab-535c-b25e-687557e78beb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln(17/12)}{10}" :db/id #edb/ref 17592186725728}] :answer-field/correct {:db/id #edb/ref 17592186725728} :answer-field/id #uuid "8efe075d-4034-5877-9e2e-551be0608d3d" :answer-field/key "rate" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725652}] :question/id #uuid "c3285c9a-9575-5529-bbdf-ba74e9f9589f" :question/problem "**(b)** Determine $k$ using $T(10)=15$. $k=$ {{rate}} per minute." :question/worked-solution "$15=3+17e^{-10k}$ gives $e^{-10k}=12/17$, so $k=\\ln(17/12)/10\\approx0.0348307$ per minute."}] [:question/id #uuid "e6ef7d7a-fd29-5796-b3a0-dfabf1ed28a9" {:db/id #edb/ref 17592186725724 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abc3391e-fe78-57d4-813c-33ac8c6a14f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{\\frac{2E-kx^2}{m}}" :db/id #edb/ref 17592186725678}] :answer-field/correct {:db/id #edb/ref 17592186725678} :answer-field/id #uuid "546ab586-8a8c-5712-9c93-5ea1a34ab84e" :answer-field/key "v" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725609} {:answer-field/choices [{:answer/id #uuid "0907c8ed-e0ff-5874-a936-b6b8fabc8b77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{\\frac{2E-kx^2}{m}}" :db/id #edb/ref 17592186725540}] :answer-field/correct {:db/id #edb/ref 17592186725540} :answer-field/id #uuid "64a778fb-3467-55a0-92a8-a62e339adb7c" :answer-field/key "rhs" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725620}] :question/id #uuid "e6ef7d7a-fd29-5796-b3a0-dfabf1ed28a9" :question/problem "**(d)** Forget the initial conditions in (c). For the physical mass, assume $m>0$. Solve the energy equation in (b) for $v$ in terms of $x$, then replace $v$ by $dx/dt$ to obtain a first-order ODE with constants $m,k,E$. Give both branches.\n\n$v=$ {{v}}; $\\dfrac{dx}{dt}=$ {{rhs}}." :question/worked-solution "Rearrange to $mv^2=2E-kx^2$, then take both square roots. Real motion requires $2E-kx^2\\geq0$ when $m>0$. Each sign describes a monotone segment; a nonconstant oscillation changes branches at turning points. This is not one fixed-sign equation for the entire oscillation."}] [:question/id #uuid "f036f5f1-7a77-54ec-9788-b8c52978888e" {:db/id #edb/ref 17592186725730 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67a5d355-5c7c-57fd-910e-da30d96c8fd6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An example rocking trajectory has $(\\theta(0),v(0))=(0,\\sqrt{2g})$, so $E=g<2g$ and the closed curve is $v^2=2g\\cos\\theta$, $-\\pi/2\\leq\\theta\\leq\\pi/2$. Draw its upper branch rightward and lower branch leftward. For rotation choose $E=3g>2g$. The positive branch $v=\\sqrt{2g(2+\\cos\\theta)}$ through $(0,\\sqrt{6g})$ moves right; the negative branch through $(0,-\\sqrt{6g})$ moves left. With increasing angle defined as counterclockwise, these represent counterclockwise and clockwise physical rotation respectively.\n\n![Authored reference: three pendulum trajectories](/api/asset?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FWHW-3%2Fauthored-pendulum-trajectories.png)" :db/id #edb/ref 17592186725622}] :answer-field/correct {:db/id #edb/ref 17592186725622} :answer-field/id #uuid "41660829-f5f6-55d2-b5a1-8ee30fe7859d" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725593}] :question/id #uuid "f036f5f1-7a77-54ec-9788-b8c52978888e" :question/problem "**(c)** Draw three trajectories in the $\\theta$–$v$ plane: (i) rocking motion, (ii) counterclockwise rotating motion, and (iii) clockwise rotating motion. Choose initial conditions corresponding to each type.\n\n![Source pendulum phase plane](/api/asset?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FWHW-3%2Fpendulum-phase-plane.png)" :question/worked-solution "The potential energy ranges from $0$ to $2g$. Thus $0<E<2g$ gives rocking, $E>2g$ gives rotation, and $E=2g$ is the separatrix, not a generic rotation. The upper and lower rotation branches never meet because $v$ never vanishes. Physical rotation direction is the sign of angular velocity; it is distinct from the orientation of a closed curve in the phase plane."}] [:question/id #uuid "f2c3e3f6-f5b2-54c1-b03d-5a605d6a1530" {:db/id #edb/ref 17592186725733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd52e4f9-64fa-58aa-971a-2b8ac85dce79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln23}{\\ln(23/13)}" :db/id #edb/ref 17592186725716}] :answer-field/correct {:db/id #edb/ref 17592186725716} :answer-field/id #uuid "6bca0ef5-bdb7-59c1-b2df-22172c9272b8" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725627}] :question/id #uuid "f2c3e3f6-f5b2-54c1-b03d-5a605d6a1530" :question/problem "**(b)** When will the thermometer read $0^\\circ C$? Time $=$ {{time}} minutes after it was taken outdoors." :question/worked-solution "Set $-1+23(13/23)^t=0$. Then $(13/23)^t=1/23$, so $t=\\ln23/\\ln(23/13)\\approx5.4956$ minutes from the original move."}] [:question/id #uuid "f920e85d-bd6c-5bb0-9d9d-f55cb25c26a3" {:db/id #edb/ref 17592186725739 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d83e5c9f-fedf-536c-9b40-543a9e73b4a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\ln(17/2)}{\\ln(17/12)}" :db/id #edb/ref 17592186725712}] :answer-field/correct {:db/id #edb/ref 17592186725712} :answer-field/id #uuid "bd42da1f-f4c2-5c9f-ad78-a0db20a1958f" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725693}] :question/id #uuid "f920e85d-bd6c-5bb0-9d9d-f55cb25c26a3" :question/problem "**(d)** Use the expression from (c) and solve $T(t)=5$ for the cooling time. $t=$ {{time}} minutes." :question/worked-solution "$5=3+17e^{-kt}$ gives $e^{-kt}=2/17$. Therefore $t=\\ln(17/2)/k=10\\ln(17/2)/\\ln(17/12)\\approx61.4420$ minutes from placement in the cooler."}] [:question/id #uuid "07c56a92-8d7f-5c18-aeba-79175171afee" {:db/id #edb/ref 17592186725539 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ad8410-8ec4-53af-ab6b-d51d0c8bb8bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln2}{24110}" :db/id #edb/ref 17592186725541}] :answer-field/correct {:db/id #edb/ref 17592186725541} :answer-field/id #uuid "714d099b-215c-5adc-a485-6ac23688a757" :answer-field/key "rate" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725630}] :question/id #uuid "07c56a92-8d7f-5c18-aeba-79175171afee" :question/problem "**(b)** The half-life means $189e^{-24110k}=94.5$, equivalently $e^{-24110k}=1/2$. Find $k$. $k=$ {{rate}} per year." :question/worked-solution "Take logarithms: $-24110k=-\\ln2$. Thus $k=\\ln2/24110>0$, consistent with decay in $Q\\prime=-kQ$."}] [:question/id #uuid "14f1afe9-a934-593f-91bd-4ef2f8ff243d" {:db/id #edb/ref 17592186725548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34dcda8d-8b1f-5ffc-91ae-f4c24826be6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac18" :db/id #edb/ref 17592186725574}] :answer-field/correct {:db/id #edb/ref 17592186725574} :answer-field/id #uuid "faa2b3a9-6916-5359-bd53-2aececac13a1" :answer-field/key "concentration" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725740}] :question/id #uuid "14f1afe9-a934-593f-91bd-4ef2f8ff243d" :question/problem "**(a)** Determine the initial concentration. $C(0)=$ {{concentration}} pounds/gallon." :question/worked-solution "Concentration is mass divided by volume: $15/120=1/8$ pound per gallon."}] [:question/id #uuid "1a1f50a0-d592-5b5a-9969-b1155e1424b8" {:db/id #edb/ref 17592186725551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79006951-b357-5088-a775-fd60b8a81cd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac1{20}" :db/id #edb/ref 17592186725641}] :answer-field/correct {:db/id #edb/ref 17592186725641} :answer-field/id #uuid "c6f45db7-d4be-5533-ad89-303c219dd34c" :answer-field/key "concentration" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725702}] :question/id #uuid "1a1f50a0-d592-5b5a-9969-b1155e1424b8" :question/problem "**(c)** Find the limiting concentration as time tends to infinity. Concentration $=$ {{concentration}} kg/L." :question/worked-solution "As $t\\to\\infty$, $Q(t)\\to50$ kg. Divide by 1000 L: the limiting concentration is $0.05$ kg/L, equal to the inflow concentration."}] [:question/id #uuid "1e48d5dc-682b-53ed-a559-732e6f5e8e65" {:db/id #edb/ref 17592186725556 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7158de45-0da7-56b2-9e27-609a073b284b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1+23(13/23)^5" :db/id #edb/ref 17592186725631}] :answer-field/correct {:db/id #edb/ref 17592186725631} :answer-field/id #uuid "d0d65af6-44e4-525a-a4c7-e4b12f51fbe1" :answer-field/key "temperature" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725710}] :question/id #uuid "1e48d5dc-682b-53ed-a559-732e6f5e8e65" :question/problem "**(a)** What will it read after **4 more minutes** (after the first minute)? Temperature $=$ {{temperature}} degrees Celsius." :question/worked-solution "Newton cooling gives $T=-1+23e^{-kt}$. At $t=1$, $13=23e^{-k}$, so $T(t)=-1+23(13/23)^t$. Four more minutes after the first minute means $t=5$, giving $T(5)=-1+23(13/23)^5\\approx0.3268$ °C."}] [:question/id #uuid "22e3bfc7-f450-5ead-8438-01b251ae46ff" {:db/id #edb/ref 17592186725560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "452408df-0d58-5249-86b8-071bfce53497" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1360\\sqrt2" :db/id #edb/ref 17592186725596}] :answer-field/correct {:db/id #edb/ref 17592186725596} :answer-field/id #uuid "079cad84-a8f7-57a6-a266-474cb650a77f" :answer-field/key "population" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725538}] :question/id #uuid "22e3bfc7-f450-5ead-8438-01b251ae46ff" :question/problem "**(b)** What is the population after 5 hours? Population $=$ {{population}}." :question/worked-solution "$P(5)=340\\cdot4^{5/4}=1360\\sqrt2\\approx1923.33$. If reporting a whole-number model estimate, this is about 1,923 bacteria."}] [:question/id #uuid "2fa40454-60b7-5fb3-951d-a5b75a830926" {:db/id #edb/ref 17592186725571 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f651b3-b9d1-52ee-94c0-b0a3f9d75c68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+17(12/17)^{t/10}" :db/id #edb/ref 17592186725536}] :answer-field/correct {:db/id #edb/ref 17592186725536} :answer-field/id #uuid "230c794d-b4d9-59a5-82a3-17041872bc6e" :answer-field/key "temperature" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725561}] :question/id #uuid "2fa40454-60b7-5fb3-951d-a5b75a830926" :question/problem "**(c)** Substitute the value from (b) into the expression for temperature from (a). $T(t)=$ {{temperature}} degrees Celsius.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "$e^{-kt}=e^{(t/10)\\ln(12/17)}=(12/17)^{t/10}$. This yields 20 at $t=0$ and 15 at $t=10$, and tends to the cooler temperature 3."}] [:question/id #uuid "31d571e3-98f5-5b76-83b0-4a3a8b4cdf95" {:db/id #edb/ref 17592186725572 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d34074e2-b505-578a-b5c1-85115cc874d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\ln(2230/340)}{\\ln4}" :db/id #edb/ref 17592186725711}] :answer-field/correct {:db/id #edb/ref 17592186725711} :answer-field/id #uuid "1d92b949-8127-57c9-a41f-8210eeaa2eb7" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725555}] :question/id #uuid "31d571e3-98f5-5b76-83b0-4a3a8b4cdf95" :question/problem "**(c)** How long will it take for the population to reach 2,230? Time $=$ {{time}} hours." :question/worked-solution "$340\\cdot4^{t/4}=2230$. Taking logarithms gives $t=4\\ln(2230/340)/\\ln4\\approx5.4269$ hours."}] [:question/id #uuid "3798d1bc-675f-53ab-bf65-04be31148457" {:db/id #edb/ref 17592186725575 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7d48639-3eee-59ba-8b4a-2662888d849f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The initial energy is $E_0=m/2+9k/8$. Draw the ellipse $kx^2+mv^2=m+9k/4$ through $(-1.5,1)$. Its horizontal semiaxis is $\\sqrt{9/4+m/k}$ and vertical semiaxis is $\\sqrt{1+9k/(4m)}$. Mark the initial point in the upper-left quadrant and clockwise motion. The initial tangent is $(x\\prime,v\\prime)=(1,3k/(2m))$, pointing right and up. The exact aspect ratio depends on the unspecified $k/m$." :db/id #edb/ref 17592186725674}] :answer-field/correct {:db/id #edb/ref 17592186725674} :answer-field/id #uuid "ba0ad1e3-4c93-59a5-bc60-eb6d31946387" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725692}] :question/id #uuid "3798d1bc-675f-53ab-bf65-04be31148457" :question/problem "**(c)** Draw the trajectory in the $x$–$v$ plane corresponding to $x(0)=-1.5$, $v(0)=1$.\n\n![Source spring phase plane](/api/asset?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FWHW-3%2Fspring-phase-plane.png)" :question/worked-solution "Use the level curve through the given point, with $x$ horizontal and $v$ vertical. Above the horizontal axis, $x\\prime=v>0$, so motion goes right; at the rightmost point $v\\prime=-(k/m)x<0$, so it goes downward. Do not assume numerical values for $m$ and $k$ from an unlabeled family of curves."}] [:question/id #uuid "3822e6fa-8979-51db-b3a6-0d28acf60b95" {:db/id #edb/ref 17592186725576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ddac532-4811-5b32-ad98-a1a19281d322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5597\\ln(100/91)}{\\ln2}" :db/id #edb/ref 17592186725588}] :answer-field/correct {:db/id #edb/ref 17592186725588} :answer-field/id #uuid "92f69073-39c9-540a-88f2-910dd52db0c0" :answer-field/key "age" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725657}] :question/id #uuid "3822e6fa-8979-51db-b3a6-0d28acf60b95" :question/problem "**(b)** The question states that, in 1988, three teams found that the Shroud of Turin contained about 91% of the carbon-14 in freshly made cloth of the same material (source attribution: The New York Times, October 18, 1988). According to these data, how old was it in 1988?\n\nAge $=$ {{age}} years." :question/worked-solution "The source data imply $C(t)/C(0)=0.91=e^{-kt}$. Thus $t=-\\ln(0.91)/k=5597\\ln(100/91)/\\ln2\\approx761.54$ years. This solves the supplied mathematical scenario; it is the age in 1988, not a calendar date."}] [:question/id #uuid "3cb874d3-a29e-5091-a052-256934b25d94" {:db/id #edb/ref 17592186725586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f1007c1-6e26-5296-a39f-bee1a9d8c2c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{24110\\ln(189/50)}{\\ln2}" :db/id #edb/ref 17592186725590}] :answer-field/correct {:db/id #edb/ref 17592186725590} :answer-field/id #uuid "84eba35f-dbd2-5d87-8db3-f955b89f295d" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725647}] :question/id #uuid "3cb874d3-a29e-5091-a052-256934b25d94" :question/problem "**(d)** Solve $Q(t)=50$ to find the years after 1989 until 50 kg remains. $t=$ {{time}} years." :question/worked-solution "$e^{-kt}=50/189$ gives $t=\\ln(189/50)/k$. Hence $t=24110\\ln(189/50)/\\ln2\\approx46252.3$ years after 1989. This is an elapsed time, not a calendar year."}] [:question/id #uuid "3cf27de0-dc25-5831-809d-94a6bd49b113" {:db/id #edb/ref 17592186725587 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ccb8e6ca-93b9-5483-8773-8ec56582f05e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{2E-2g\\cdot(1-\\cos\\theta)}" :db/id #edb/ref 17592186725708}] :answer-field/correct {:db/id #edb/ref 17592186725708} :answer-field/id #uuid "1a39b475-6153-594e-8678-ccb24681ee0b" :answer-field/key "v" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725552} {:answer-field/choices [{:answer/id #uuid "e9b48a54-b8ca-5358-9f48-69a5d0aec979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{2E-2g\\cdot(1-\\cos\\theta)}" :db/id #edb/ref 17592186725727}] :answer-field/correct {:db/id #edb/ref 17592186725727} :answer-field/id #uuid "e1403a8c-7048-542b-adf5-95bceacc3b88" :answer-field/key "rhs" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725719}] :question/id #uuid "3cf27de0-dc25-5831-809d-94a6bd49b113" :question/problem "**(d)** Solve the energy equation in (b) for $v$ in terms of $\\theta$, then replace $v$ with $d\\theta/dt$ to obtain a first-order ODE with constants $g,E$. Give both branches.\n\n$v=$ {{v}}; $\\dfrac{d\\theta}{dt}=$ {{rhs}}." :question/worked-solution "Multiply the energy equation by 2 and isolate $v^2$. The radicand must be nonnegative. Rocking trajectories change sign at turning points; rotations with $E>2g$ retain one sign. The equilibrium states are also included when the radicand vanishes at a constant angle."}] [:question/id #uuid "401603bc-170b-538f-ad71-ed8999d6b10b" {:db/id #edb/ref 17592186725591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9b5c09f-7d79-5548-8b06-a03e9a89a6bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Integrating $v\\,dv=-g\\sin\\theta\\,d\\theta$ gives $v^2/2=g\\cos\\theta+C$. Thus $v^2/2+g(1-\\cos\\theta)=C+g=E$, after renaming the constant." :db/id #edb/ref 17592186725676}] :answer-field/correct {:db/id #edb/ref 17592186725676} :answer-field/id #uuid "a844a431-31cd-5553-9c7b-7ee6f5c2a820" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725675}] :question/id #uuid "401603bc-170b-538f-ad71-ed8999d6b10b" :question/problem "**(b)** Find the implicit solutions of (a) and derive $\\frac12v^2+g(1-\\cos\\theta)=E$, with $E$ constant." :question/worked-solution "The antiderivative of $-g\\sin\\theta$ is $g\\cos\\theta$, not $-g\\cos\\theta$. Check conservation directly: $d[v^2/2+g(1-\\cos\\theta)]/dt=v(v\\prime+g\\sin\\theta)=0$."}] [:question/id #uuid "42b35269-3dbb-518e-be5a-da6547caaed1" {:db/id #edb/ref 17592186725594 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e70a42d6-a4a8-5bb2-a355-4ffaecd94e70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y_1\\prime=e^x$ and $y_2\\prime=(1+x)e^x$. Hence $W=\\begin{vmatrix}e^x&xe^x\\\\e^x&(1+x)e^x\\end{vmatrix}=e^{2x}\\ne0$ on $\\mathbb R$. Both are solutions and the equation has continuous coefficients on $\\mathbb R$. The Wronskian proves linear independence, so these two solutions form a fundamental set on $\\mathbb R$." :db/id #edb/ref 17592186725725}] :answer-field/correct {:db/id #edb/ref 17592186725725} :answer-field/id #uuid "8598d633-5fd1-50fe-b964-38e5b1f8c7bb" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725648}] :question/id #uuid "42b35269-3dbb-518e-be5a-da6547caaed1" :question/problem "**(b)** The functions $y_1=e^x$ and $y_2=xe^x$ solve $y\\!\\prime\\!\\prime-2y\\prime+y=0$. Use the Wronskian to show that they form a fundamental set of solutions. Include a statement explaining your reasoning for full credit." :question/worked-solution "The product rule in $(xe^x)\\prime=(1+x)e^x$ is essential. Cancellation leaves $e^{2x}$, not zero. Because the equation is second-order and homogeneous, the independent pair spans its solution space."}] [:question/id #uuid "486e23c7-d519-5894-9f25-30026dac21d3" {:db/id #edb/ref 17592186725601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "150e2c9b-2ea1-5bf9-9f70-4c68d5bd41a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{49\\cdot3600}{1609.344}" :db/id #edb/ref 17592186725549}] :answer-field/correct {:db/id #edb/ref 17592186725549} :answer-field/id #uuid "52f908e1-b5a9-5c10-867f-70233043aa60" :answer-field/key "velocity" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725606}] :question/id #uuid "486e23c7-d519-5894-9f25-30026dac21d3" :question/problem "Source question: [WeBWorK Problem 1](https://webwork2.science.oregonstate.edu/webwork2/MTH_256_020_F2026/WebWork_3/1).\n\nA 50 kg skydiver jumps from an airplane. Find her terminal velocity in miles per hour, assuming the free-fall linear-drag constant is $k=10\\,\\mathrm{kg/s}$ (no parachute). The answer must be negative for downward velocity.\n\nTerminal velocity $=$ {{velocity}} mph." :question/worked-solution "With upward positive, $mv\\prime=-mg-kv$. At terminal velocity $0=-mg-kv_T$, so $v_T=-mg/k=-49$ m/s using the standard course value $g=9.8$ m/s². Convert using 1 mile = 1609.344 m: $v_T=-49(3600/1609.344)\\approx-109.6106$ mph. The source does not restate $g$; the study answer explicitly uses $9.8$."}] [:question/id #uuid "54539418-360d-52d8-a017-eeeff799e9be" {:db/id #edb/ref 17592186725608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b98c8521-db22-568a-b989-bbfa83e2b558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2000\\sqrt{10}" :db/id #edb/ref 17592186725691}] :answer-field/correct {:db/id #edb/ref 17592186725691} :answer-field/id #uuid "f8894222-e211-5362-b756-9bed0542816a" :answer-field/key "population" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725738}] :question/id #uuid "54539418-360d-52d8-a017-eeeff799e9be" :question/problem "**(c)** Determine the population after 5 hours. $P(5)=$ {{population}} bacteria." :question/worked-solution "$P(5)=2000e^{(\\ln10)/2}=2000\\sqrt{10}\\approx6324.56$. The model predicts about 6,325 bacteria if a whole-number estimate is desired."}] [:question/id #uuid "566e4a0c-0d60-5aa9-8735-e2b797e78a03" {:db/id #edb/ref 17592186725610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bc5c922-566d-5d7c-8841-0769cd3ade9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2000e^{rt}" :db/id #edb/ref 17592186725584}] :answer-field/correct {:db/id #edb/ref 17592186725584} :answer-field/id #uuid "81bf102d-c568-5575-9235-36531211a122" :answer-field/key "population" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725645}] :question/id #uuid "566e4a0c-0d60-5aa9-8735-e2b797e78a03" :question/problem "**(a)** Solve the IVP for $P(t)$ in terms of time $t$ in hours and the constant $r$. $P(t)=$ {{population}}.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "Separate $dP/P=r\\,dt$ to obtain $P=Ce^{rt}$. Applying $P(0)=2000$ gives $C=2000$. Differentiation verifies $P\\prime=rP$."}] [:question/id #uuid "5cff68ac-53de-5096-b9b0-f63599fcec11" {:db/id #edb/ref 17592186725614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b0c4ca9-1c1a-5905-9577-01fd7ef2bbe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+17e^{-kt}" :db/id #edb/ref 17592186725643}] :answer-field/correct {:db/id #edb/ref 17592186725643} :answer-field/id #uuid "9673354b-2210-5191-b893-0af62d3dbe3f" :answer-field/key "temperature" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725661} {:answer-field/choices [{:answer/id #uuid "c0a65c4e-9d54-5086-8e73-cc023a98500e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3k" :db/id #edb/ref 17592186725697}] :answer-field/correct {:db/id #edb/ref 17592186725697} :answer-field/id #uuid "9d26c1a7-ddb1-5ec5-b51e-dd57acd1bef4" :answer-field/key "forcing" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725667}] :question/id #uuid "5cff68ac-53de-5096-b9b0-f63599fcec11" :question/problem "**(a)** Substitute $T_m=3$ and $T_0=20$ into the cooling IVP, then solve for $T(t)$ in terms of $k$ and time $t$ in minutes.\n\n$T\\prime+kT=$ {{forcing}}, $T(0)=20$; $T(t)=$ {{temperature}}.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "The IVP is $T\\prime+kT=3k$, $T(0)=20$. Subtract the ambient temperature: $U=T-3$ satisfies $U\\prime=-kU$, $U(0)=17$. Thus $T=3+17e^{-kt}$; substitution checks both the ODE and initial value."}] [:question/id #uuid "61054895-b229-5690-97a0-37fe777c79c8" {:db/id #edb/ref 17592186725617 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76f4f2a9-a51c-5a26-a655-15374984d328" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "189\\exp(-10000\\ln2/24110)" :db/id #edb/ref 17592186725636}] :answer-field/correct {:db/id #edb/ref 17592186725636} :answer-field/id #uuid "b34de256-3e18-55af-bb9f-6f403bef0b35" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725683}] :question/id #uuid "61054895-b229-5690-97a0-37fe777c79c8" :question/problem "**(c)** Substitute the value of $k$ into $Q(t)$ and determine the mass after 10,000 years. $Q(10000)=$ {{mass}} kg.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "$Q(10000)=189e^{-10000\\ln2/24110}=189\\cdot2^{-10000/24110}\\approx141.78$ kg. Less than one half-life has passed, so the mass must exceed $94.5$ kg."}] [:question/id #uuid "62476e8a-0f97-598e-b923-47a29016fc8b" {:db/id #edb/ref 17592186725618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1f585f-af17-55e2-ae7b-47a01dfea635" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "On an interval where velocity can be regarded as a function of position, the chain rule gives $x\\!\\prime\\!\\prime=dv/dt=(dv/dx)(dx/dt)=v\\,dv/dx$. Thus $mv\\,dv/dx=-kx$, or $mv\\,dv=-kx\\,dx$." :db/id #edb/ref 17592186725554}] :answer-field/correct {:db/id #edb/ref 17592186725554} :answer-field/id #uuid "96d5f7d5-ae7a-5cb7-bc2a-a29131601489" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725662}] :question/id #uuid "62476e8a-0f97-598e-b923-47a29016fc8b" :question/problem "**(a)** Derive a separable differential equation involving $x$, $v$, and $dv/dx$. Show the change of variable." :question/worked-solution "Do not replace $x\\!\\prime\\!\\prime$ by $dv/dx$ alone: the chain rule contributes $dx/dt=v$. At turning points the position parametrization can fail; the energy identity obtained in (b) extends through them."}] [:question/id #uuid "6964efcd-98a8-5b89-93a0-5b9676ae8c53" {:db/id #edb/ref 17592186725623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8631363-3ddd-5d7c-bf76-36c8160cc73a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "340\\cdot4^{t/4}" :db/id #edb/ref 17592186725690}] :answer-field/correct {:db/id #edb/ref 17592186725690} :answer-field/id #uuid "10a53e91-c42b-50f1-a788-5872ca4e4a5b" :answer-field/key "population" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725545}] :question/id #uuid "6964efcd-98a8-5b89-93a0-5b9676ae8c53" :question/problem "**(a)** Express the population after $t$ hours as a function of $t$. Population $=$ {{population}}.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "$P=P_0e^{rt}$ and $P_0=340$. Since $1360/340=4$, $e^{4r}=4$, so $P(t)=340e^{t\\ln4/4}=340\\cdot4^{t/4}$."}] [:question/id #uuid "69ec9f25-4f97-5af0-94a2-64e81e082888" {:db/id #edb/ref 17592186725624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daa67354-91f4-551d-ae77-97f6a5ecaf05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Integrate $mv\\,dv=-kx\\,dx$ to get $mv^2/2=-kx^2/2+C$. Moving the position term to the left gives $\\frac m2v^2+\\frac k2x^2=E$." :db/id #edb/ref 17592186725714}] :answer-field/correct {:db/id #edb/ref 17592186725714} :answer-field/id #uuid "38d573d7-7c6c-548e-8209-8381bc809189" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725578}] :question/id #uuid "69ec9f25-4f97-5af0-94a2-64e81e082888" :question/problem "**(b)** Find the implicit solutions to the separable equation in (a) and derive the conservation of energy equation $\\frac m2v^2+\\frac k2x^2=E$, where $E$ is a constant." :question/worked-solution "The factors $1/2$ come from integrating $v$ and $x$. Independently, $d(mv^2/2+kx^2/2)/dt=v(mv\\prime+kx)=0$ along Newton’s equation, including at $v=0$."}] [:question/id #uuid "6a5d6dc4-a997-5c41-ad7f-595dd4c4af37" {:db/id #edb/ref 17592186725625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499b012f-3fbc-50dd-8e0e-ed5f6307ae72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$W(y_1,y_2)=\\begin{vmatrix}e^{2x}&e^{-x}\\\\2e^{2x}&-e^{-x}\\end{vmatrix}=-3e^x\\ne0$ for every $x\\in\\mathbb R$. The two given functions are solutions of the homogeneous second-order linear equation, whose coefficients are continuous on $\\mathbb R$. The nonzero Wronskian proves linear independence, so the pair is a fundamental set on $\\mathbb R$." :db/id #edb/ref 17592186725602}] :answer-field/correct {:db/id #edb/ref 17592186725602} :answer-field/id #uuid "c91a482d-b4f5-5cd6-a413-be51576f915f" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725705}] :question/id #uuid "6a5d6dc4-a997-5c41-ad7f-595dd4c4af37" :question/problem "**(a)** The functions $y_1=e^{2x}$ and $y_2=e^{-x}$ solve $y\\!\\prime\\!\\prime-y\\prime-2y=0$. Use the Wronskian to show that they form a fundamental set of solutions. Include a statement explaining your reasoning for full credit." :question/worked-solution "Use functions in the first row and their derivatives in the second. A determinant alone does not finish the requested explanation: state nonvanishing, linear independence, and why two independent solutions form a fundamental set for this second-order equation."}] [:question/id #uuid "710a65ec-c084-5806-a566-9fa6eebba34e" {:db/id #edb/ref 17592186725629 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9fb065-28e7-5d87-9833-cb49e687ce2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30-15e^{-2}" :db/id #edb/ref 17592186725543}] :answer-field/correct {:db/id #edb/ref 17592186725543} :answer-field/id #uuid "80ec3e6c-e6fd-5f99-b376-04423ae643b4" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725644}] :question/id #uuid "710a65ec-c084-5806-a566-9fa6eebba34e" :question/problem "**(d)** Determine the sugar mass after 30 minutes. $Q(30)=$ {{mass}} pounds.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "Substitute $t=30$: $Q(30)=30-15e^{-2}\\approx27.9700$ pounds. This lies between the initial 15 pounds and the limiting 30 pounds."}] [:question/id #uuid "760f3d2a-b4f9-5faa-9809-2255158fd7ae" {:db/id #edb/ref 17592186725634 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c5239a2-4e80-5e01-a36e-eee67d03b448" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "189e^{-kt}" :db/id #edb/ref 17592186725585}] :answer-field/correct {:db/id #edb/ref 17592186725585} :answer-field/id #uuid "f615fd68-0a0d-55ff-8dbb-a78ca3ba5125" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725735}] :question/id #uuid "760f3d2a-b4f9-5faa-9809-2255158fd7ae" :question/problem "**(a)** The rate of change of radioactive mass is proportional to the remaining mass: $Q\\prime(t)=-kQ(t)$, $Q(0)=189$. Solve the IVP, leaving $k$ undetermined. $Q(t)=$ {{mass}} kg.\n\nNotation: $e^z=\\exp(z)$ denotes the natural exponential." :question/worked-solution "Separate and integrate to get $Q=Ce^{-kt}$. The initial condition gives $C=189$. Its derivative is $-kQ$ and its initial value is 189."}] [:question/id #uuid "77091b57-11a1-5e2b-a033-95b1455f530e" {:db/id #edb/ref 17592186725637 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a586136b-925b-5997-a73b-a6dd624e954a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln 10}{10}" :db/id #edb/ref 17592186725673}] :answer-field/correct {:db/id #edb/ref 17592186725673} :answer-field/id #uuid "6acc04b3-66c2-5317-8613-972c3bb0a5cc" :answer-field/key "rate" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725626}] :question/id #uuid "77091b57-11a1-5e2b-a033-95b1455f530e" :question/problem "**(b)** Determine $r$ from $P(10)=20000$. $r=$ {{rate}} per hour." :question/worked-solution "$2000e^{10r}=20000$ implies $e^{10r}=10$, so $r=\\ln(10)/10\\approx0.2302585$ per hour."}] [:question/id #uuid "77550cc4-c025-57c1-91d3-15afeed43b57" {:db/id #edb/ref 17592186725638 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6aa4002-f1ac-51f1-b8a9-d92e79d5cf46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\frac{Q}{15}" :db/id #edb/ref 17592186725723}] :answer-field/correct {:db/id #edb/ref 17592186725723} :answer-field/id #uuid "9b713f2e-8b2d-53a6-a765-d17b9de42731" :answer-field/key "rhs" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725664} {:answer-field/choices [{:answer/id #uuid "9c44a045-ff98-5251-b665-a6b6049c4b06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{Q}{120}" :db/id #edb/ref 17592186725666}] :answer-field/correct {:db/id #edb/ref 17592186725666} :answer-field/id #uuid "cc141c94-455a-50f0-8dd0-9cbca8b14d56" :answer-field/key "concentration" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725707}] :question/id #uuid "77550cc4-c025-57c1-91d3-15afeed43b57" :question/problem "**(b)** Let $Q(t)$ be the sugar mass in pounds. The model is $Q\\prime=$ [rate sugar enters] $-$ [rate sugar leaves], $Q(0)=15$. Sugar enters at $(1/4)(8)=2$ lb/min and leaves at $8C(t)$ lb/min. Express the concentration using $Q(t)$ and the constant volume, then write the ODE.\n\n$C(t)=$ {{concentration}}; $Q\\prime(t)=$ {{rhs}}, $Q(0)=15$. In these input expressions, use $Q$ for $Q(t)$." :question/worked-solution "Equal inflow and outflow keep volume at 120 gallons. Thus $C=Q/120$, the outflow mass rate is $8Q/120=Q/15$, and $Q\\prime=2-Q/15$. Both terms have units lb/min."}] [:answer-field/id #uuid "80ec3e6c-e6fd-5f99-b376-04423ae643b4" {:answer-field/choices [{:answer/id #uuid "0c9fb065-28e7-5d87-9833-cb49e687ce2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30-15e^{-2}" :db/id #edb/ref 17592186725543}] :answer-field/correct {:db/id #edb/ref 17592186725543} :answer-field/id #uuid "80ec3e6c-e6fd-5f99-b376-04423ae643b4" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725644}] [:answer-field/id #uuid "81bf102d-c568-5575-9235-36531211a122" {:answer-field/choices [{:answer/id #uuid "3bc5c922-566d-5d7c-8841-0769cd3ade9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2000e^{rt}" :db/id #edb/ref 17592186725584}] :answer-field/correct {:db/id #edb/ref 17592186725584} :answer-field/id #uuid "81bf102d-c568-5575-9235-36531211a122" :answer-field/key "population" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725645}] [:answer-field/id #uuid "84eba35f-dbd2-5d87-8db3-f955b89f295d" {:answer-field/choices [{:answer/id #uuid "3f1007c1-6e26-5296-a39f-bee1a9d8c2c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{24110\\ln(189/50)}{\\ln2}" :db/id #edb/ref 17592186725590}] :answer-field/correct {:db/id #edb/ref 17592186725590} :answer-field/id #uuid "84eba35f-dbd2-5d87-8db3-f955b89f295d" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725647}] [:answer-field/id #uuid "8598d633-5fd1-50fe-b964-38e5b1f8c7bb" {:answer-field/choices [{:answer/id #uuid "e70a42d6-a4a8-5bb2-a355-4ffaecd94e70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y_1\\prime=e^x$ and $y_2\\prime=(1+x)e^x$. Hence $W=\\begin{vmatrix}e^x&xe^x\\\\e^x&(1+x)e^x\\end{vmatrix}=e^{2x}\\ne0$ on $\\mathbb R$. Both are solutions and the equation has continuous coefficients on $\\mathbb R$. The Wronskian proves linear independence, so these two solutions form a fundamental set on $\\mathbb R$." :db/id #edb/ref 17592186725725}] :answer-field/correct {:db/id #edb/ref 17592186725725} :answer-field/id #uuid "8598d633-5fd1-50fe-b964-38e5b1f8c7bb" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725648}] [:answer-field/id #uuid "8efe075d-4034-5877-9e2e-551be0608d3d" {:answer-field/choices [{:answer/id #uuid "eea4edcd-2fab-535c-b25e-687557e78beb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln(17/12)}{10}" :db/id #edb/ref 17592186725728}] :answer-field/correct {:db/id #edb/ref 17592186725728} :answer-field/id #uuid "8efe075d-4034-5877-9e2e-551be0608d3d" :answer-field/key "rate" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725652}] [:answer-field/id #uuid "92f69073-39c9-540a-88f2-910dd52db0c0" {:answer-field/choices [{:answer/id #uuid "3ddac532-4811-5b32-ad98-a1a19281d322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5597\\ln(100/91)}{\\ln2}" :db/id #edb/ref 17592186725588}] :answer-field/correct {:db/id #edb/ref 17592186725588} :answer-field/id #uuid "92f69073-39c9-540a-88f2-910dd52db0c0" :answer-field/key "age" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725657}] [:answer-field/id #uuid "9673354b-2210-5191-b893-0af62d3dbe3f" {:answer-field/choices [{:answer/id #uuid "7b0c4ca9-1c1a-5905-9577-01fd7ef2bbe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+17e^{-kt}" :db/id #edb/ref 17592186725643}] :answer-field/correct {:db/id #edb/ref 17592186725643} :answer-field/id #uuid "9673354b-2210-5191-b893-0af62d3dbe3f" :answer-field/key "temperature" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725661}] [:answer-field/id #uuid "96d5f7d5-ae7a-5cb7-bc2a-a29131601489" {:answer-field/choices [{:answer/id #uuid "1b1f585f-af17-55e2-ae7b-47a01dfea635" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "On an interval where velocity can be regarded as a function of position, the chain rule gives $x\\!\\prime\\!\\prime=dv/dt=(dv/dx)(dx/dt)=v\\,dv/dx$. Thus $mv\\,dv/dx=-kx$, or $mv\\,dv=-kx\\,dx$." :db/id #edb/ref 17592186725554}] :answer-field/correct {:db/id #edb/ref 17592186725554} :answer-field/id #uuid "96d5f7d5-ae7a-5cb7-bc2a-a29131601489" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725662}] [:answer-field/id #uuid "9b713f2e-8b2d-53a6-a765-d17b9de42731" {:answer-field/choices [{:answer/id #uuid "e6aa4002-f1ac-51f1-b8a9-d92e79d5cf46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\frac{Q}{15}" :db/id #edb/ref 17592186725723}] :answer-field/correct {:db/id #edb/ref 17592186725723} :answer-field/id #uuid "9b713f2e-8b2d-53a6-a765-d17b9de42731" :answer-field/key "rhs" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725664}] [:answer-field/id #uuid "9d26c1a7-ddb1-5ec5-b51e-dd57acd1bef4" {:answer-field/choices [{:answer/id #uuid "c0a65c4e-9d54-5086-8e73-cc023a98500e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3k" :db/id #edb/ref 17592186725697}] :answer-field/correct {:db/id #edb/ref 17592186725697} :answer-field/id #uuid "9d26c1a7-ddb1-5ec5-b51e-dd57acd1bef4" :answer-field/key "forcing" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725667}] [:answer-field/id #uuid "a844a431-31cd-5553-9c7b-7ee6f5c2a820" {:answer-field/choices [{:answer/id #uuid "a9b5c09f-7d79-5548-8b06-a03e9a89a6bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Integrating $v\\,dv=-g\\sin\\theta\\,d\\theta$ gives $v^2/2=g\\cos\\theta+C$. Thus $v^2/2+g(1-\\cos\\theta)=C+g=E$, after renaming the constant." :db/id #edb/ref 17592186725676}] :answer-field/correct {:db/id #edb/ref 17592186725676} :answer-field/id #uuid "a844a431-31cd-5553-9c7b-7ee6f5c2a820" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725675}] [:answer-field/id #uuid "af605a2b-2869-5f31-b2b3-35ad200fa152" {:answer-field/choices [{:answer/id #uuid "906c3a2f-1636-53a2-9793-95133477f785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186725654}] :answer-field/correct {:db/id #edb/ref 17592186725654} :answer-field/id #uuid "af605a2b-2869-5f31-b2b3-35ad200fa152" :answer-field/key "r2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725681}] [:answer-field/id #uuid "b34de256-3e18-55af-bb9f-6f403bef0b35" {:answer-field/choices [{:answer/id #uuid "76f4f2a9-a51c-5a26-a655-15374984d328" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "189\\exp(-10000\\ln2/24110)" :db/id #edb/ref 17592186725636}] :answer-field/correct {:db/id #edb/ref 17592186725636} :answer-field/id #uuid "b34de256-3e18-55af-bb9f-6f403bef0b35" :answer-field/key "mass" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725683}] [:answer-field/id #uuid "ba0ad1e3-4c93-59a5-bc60-eb6d31946387" {:answer-field/choices [{:answer/id #uuid "a7d48639-3eee-59ba-8b4a-2662888d849f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The initial energy is $E_0=m/2+9k/8$. Draw the ellipse $kx^2+mv^2=m+9k/4$ through $(-1.5,1)$. Its horizontal semiaxis is $\\sqrt{9/4+m/k}$ and vertical semiaxis is $\\sqrt{1+9k/(4m)}$. Mark the initial point in the upper-left quadrant and clockwise motion. The initial tangent is $(x\\prime,v\\prime)=(1,3k/(2m))$, pointing right and up. The exact aspect ratio depends on the unspecified $k/m$." :db/id #edb/ref 17592186725674}] :answer-field/correct {:db/id #edb/ref 17592186725674} :answer-field/id #uuid "ba0ad1e3-4c93-59a5-bc60-eb6d31946387" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725692}] [:answer-field/id #uuid "bd42da1f-f4c2-5c9f-ad78-a0db20a1958f" {:answer-field/choices [{:answer/id #uuid "d83e5c9f-fedf-536c-9b40-543a9e73b4a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\ln(17/2)}{\\ln(17/12)}" :db/id #edb/ref 17592186725712}] :answer-field/correct {:db/id #edb/ref 17592186725712} :answer-field/id #uuid "bd42da1f-f4c2-5c9f-ad78-a0db20a1958f" :answer-field/key "time" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725693}] [:answer-field/id #uuid "c3e93303-4a61-5610-b831-f6dea0bfa195" {:answer-field/choices [{:answer/id #uuid "0cd45acc-dd54-527c-8479-82577233fa7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186725544}] :answer-field/correct {:db/id #edb/ref 17592186725544} :answer-field/id #uuid "c3e93303-4a61-5610-b831-f6dea0bfa195" :answer-field/key "r1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725700}] [:answer-field/id #uuid "c6f45db7-d4be-5533-ad89-303c219dd34c" {:answer-field/choices [{:answer/id #uuid "79006951-b357-5088-a775-fd60b8a81cd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac1{20}" :db/id #edb/ref 17592186725641}] :answer-field/correct {:db/id #edb/ref 17592186725641} :answer-field/id #uuid "c6f45db7-d4be-5533-ad89-303c219dd34c" :answer-field/key "concentration" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725702}] [:answer-field/id #uuid "c91a482d-b4f5-5cd6-a413-be51576f915f" {:answer-field/choices [{:answer/id #uuid "499b012f-3fbc-50dd-8e0e-ed5f6307ae72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$W(y_1,y_2)=\\begin{vmatrix}e^{2x}&e^{-x}\\