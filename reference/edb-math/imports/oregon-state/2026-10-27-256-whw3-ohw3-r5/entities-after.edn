/ref 17592186725541}] :answer-field/correct {:db/id #edb/ref 17592186725541} :answer-field/id #uuid "714d099b-215c-5adc-a485-6ac23688a757" :answer-field/key "rate" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725630}] [:answer/id #uuid "906c3a2f-1636-53a2-9793-95133477f785" {:answer/id #uuid "906c3a2f-1636-53a2-9793-95133477f785" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186725654}] [:answer/id #uuid "9c44a045-ff98-5251-b665-a6b6049c4b06" {:answer/id #uuid "9c44a045-ff98-5251-b665-a6b6049c4b06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{Q}{120}" :db/id #edb/ref 17592186725666}] [:answer/id #uuid "a586136b-925b-5997-a73b-a6dd624e954a" {:answer/id #uuid "a586136b-925b-5997-a73b-a6dd624e954a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln 10}{10}" :db/id #edb/ref 17592186725673}] [:answer/id #uuid "a7d48639-3eee-59ba-8b4a-2662888d849f" {:answer/id #uuid "a7d48639-3eee-59ba-8b4a-2662888d849f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The initial energy is $E_0=m/2+9k/8$. Draw the ellipse $kx^2+mv^2=m+9k/4$ through $(-1.5,1)$. Its horizontal semiaxis is $\\sqrt{9/4+m/k}$ and vertical semiaxis is $\\sqrt{1+9k/(4m)}$. Mark the initial point in the upper-left quadrant and clockwise motion. The initial tangent is $(x\\prime,v\\prime)=(1,3k/(2m))$, pointing right and up. The exact aspect ratio depends on the unspecified $k/m$." :db/id #edb/ref 17592186725674}] [:answer/id #uuid "a9b5c09f-7d79-5548-8b06-a03e9a89a6bb" {:answer/id #uuid "a9b5c09f-7d79-5548-8b06-a03e9a89a6bb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Integrating $v\\,dv=-g\\sin\\theta\\,d\\theta$ gives $v^2/2=g\\cos\\theta+C$. Thus $v^2/2+g(1-\\cos\\theta)=C+g=E$, after renaming the constant." :db/id #edb/ref 17592186725676}] [:answer/id #uuid "abc3391e-fe78-57d4-813c-33ac8c6a14f1" {:answer/id #uuid "abc3391e-fe78-57d4-813c-33ac8c6a14f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{\\frac{2E-kx^2}{m}}" :db/id #edb/ref 17592186725678}] [:answer/id #uuid "ac015d86-1e71-504f-89e3-9cddc6d0109a" {:answer/id #uuid "ac015d86-1e71-504f-89e3-9cddc6d0109a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "50+50\\exp(-63/50)" :db/id #edb/ref 17592186725679}] [:answer/id #uuid "b8631363-3ddd-5d7c-bf76-36c8160cc73a" {:answer/id #uuid "b8631363-3ddd-5d7c-bf76-36c8160cc73a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "340\\cdot4^{t/4}" :db/id #edb/ref 17592186725690}] [:answer/id #uuid "b98c8521-db22-568a-b989-bbfa83e2b558" {:answer/id #uuid "b98c8521-db22-568a-b989-bbfa83e2b558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2000\\sqrt{10}" :db/id #edb/ref 17592186725691}] [:answer/id #uuid "be33fc5d-7e68-51d1-bb43-2fc9c184a9a6" {:answer/id #uuid "be33fc5d-7e68-51d1-bb43-2fc9c184a9a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac1{10}" :db/id #edb/ref 17592186725694}] [:answer/id #uuid "c0a65c4e-9d54-5086-8e73-cc023a98500e" {:answer/id #uuid "c0a65c4e-9d54-5086-8e73-cc023a98500e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3k" :db/id #edb/ref 17592186725697}] [:answer/id #uuid "ccb8e6ca-93b9-5483-8773-8ec56582f05e" {:answer/id #uuid "ccb8e6ca-93b9-5483-8773-8ec56582f05e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{2E-2g\\cdot(1-\\cos\\theta)}" :db/id #edb/ref 17592186725708}] [:answer/id #uuid "d34074e2-b505-578a-b5c1-85115cc874d0" {:answer/id #uuid "d34074e2-b505-578a-b5c1-85115cc874d0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4\\ln(2230/340)}{\\ln4}" :db/id #edb/ref 17592186725711}] [:answer/id #uuid "d83e5c9f-fedf-536c-9b40-543a9e73b4a2" {:answer/id #uuid "d83e5c9f-fedf-536c-9b40-543a9e73b4a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\ln(17/2)}{\\ln(17/12)}" :db/id #edb/ref 17592186725712}] [:answer/id #uuid "daa67354-91f4-551d-ae77-97f6a5ecaf05" {:answer/id #uuid "daa67354-91f4-551d-ae77-97f6a5ecaf05" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Integrate $mv\\,dv=-kx\\,dx$ to get $mv^2/2=-kx^2/2+C$. Moving the position term to the left gives $\\frac m2v^2+\\frac k2x^2=E$." :db/id #edb/ref 17592186725714}] [:answer/id #uuid "dd52e4f9-64fa-58aa-971a-2b8ac85dce79" {:answer/id #uuid "dd52e4f9-64fa-58aa-971a-2b8ac85dce79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln23}{\\ln(23/13)}" :db/id #edb/ref 17592186725716}] [:answer/id #uuid "e39301a8-3c31-5a77-a7fb-459d8c254cd3" {:answer/id #uuid "e39301a8-3c31-5a77-a7fb-459d8c254cd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4,5" :db/id #edb/ref 17592186725721}] [:answer/id #uuid "e619384c-0826-5b03-8089-28d199da7636" {:answer/id #uuid "e619384c-0826-5b03-8089-28d199da7636" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The chain rule gives $\\theta\\!\\prime\\!\\prime=(dv/d\\theta)(d\\theta/dt)=v\\,dv/d\\theta$. Hence $v\\,dv/d\\theta=-g\\sin\\theta$, equivalently $v\\,dv=-g\\sin\\theta\\,d\\theta$." :db/id #edb/ref 17592186725722}] [:answer/id #uuid "e6aa4002-f1ac-51f1-b8a9-d92e79d5cf46" {:answer/id #uuid "e6aa4002-f1ac-51f1-b8a9-d92e79d5cf46" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2-\\frac{Q}{15}" :db/id #edb/ref 17592186725723}] [:answer/id #uuid "e70a42d6-a4a8-5bb2-a355-4ffaecd94e70" {:answer/id #uuid "e70a42d6-a4a8-5bb2-a355-4ffaecd94e70" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y_1\\prime=e^x$ and $y_2\\prime=(1+x)e^x$. Hence $W=\\begin{vmatrix}e^x&xe^x\\\\e^x&(1+x)e^x\\end{vmatrix}=e^{2x}\\ne0$ on $\\mathbb R$. Both are solutions and the equation has continuous coefficients on $\\mathbb R$. The Wronskian proves linear independence, so these two solutions form a fundamental set on $\\mathbb R$." :db/id #edb/ref 17592186725725}] [:answer/id #uuid "e9b48a54-b8ca-5358-9f48-69a5d0aec979" {:answer/id #uuid "e9b48a54-b8ca-5358-9f48-69a5d0aec979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{2E-2g\\cdot(1-\\cos\\theta)}" :db/id #edb/ref 17592186725727}] [:answer/id #uuid "eea4edcd-2fab-535c-b25e-687557e78beb" {:answer/id #uuid "eea4edcd-2fab-535c-b25e-687557e78beb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln(17/12)}{10}" :db/id #edb/ref 17592186725728}] [:answer/id #uuid "05f651b3-b9d1-52ee-94c0-b0a3f9d75c68" {:answer/id #uuid "05f651b3-b9d1-52ee-94c0-b0a3f9d75c68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+17(12/17)^{t/10}" :db/id #edb/ref 17592186725536}] [:answer/id #uuid "0907c8ed-e0ff-5874-a936-b6b8fabc8b77" {:answer/id #uuid "0907c8ed-e0ff-5874-a936-b6b8fabc8b77" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pm\\sqrt{\\frac{2E-kx^2}{m}}" :db/id #edb/ref 17592186725540}] [:answer/id #uuid "09ad8410-8ec4-53af-ab6b-d51d0c8bb8bb" {:answer/id #uuid "09ad8410-8ec4-53af-ab6b-d51d0c8bb8bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln2}{24110}" :db/id #edb/ref 17592186725541}] [:answer/id #uuid "0c9fb065-28e7-5d87-9833-cb49e687ce2c" {:answer/id #uuid "0c9fb065-28e7-5d87-9833-cb49e687ce2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30-15e^{-2}" :db/id #edb/ref 17592186725543}] [:answer/id #uuid "0cd45acc-dd54-527c-8479-82577233fa7c" {:answer/id #uuid "0cd45acc-dd54-527c-8479-82577233fa7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186725544}] [:answer/id #uuid "150e2c9b-2ea1-5bf9-9f70-4c68d5bd41a8" {:answer/id #uuid "150e2c9b-2ea1-5bf9-9f70-4c68d5bd41a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{49\\cdot3600}{1609.344}" :db/id #edb/ref 17592186725549}] [:answer/id #uuid "1b1f585f-af17-55e2-ae7b-47a01dfea635" {:answer/id #uuid "1b1f585f-af17-55e2-ae7b-47a01dfea635" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "On an interval where velocity can be regarded as a function of position, the chain rule gives $x\\!\\prime\\!\\prime=dv/dt=(dv/dx)(dx/dt)=v\\,dv/dx$. Thus $mv\\,dv/dx=-kx$, or $mv\\,dv=-kx\\,dx$." :db/id #edb/ref 17592186725554}] [:answer/id #uuid "34dcda8d-8b1f-5ffc-91ae-f4c24826be6d" {:answer/id #uuid "34dcda8d-8b1f-5ffc-91ae-f4c24826be6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac18" :db/id #edb/ref 17592186725574}] [:answer/id #uuid "3b79c322-6598-546f-ad9c-ecda3e0b8cee" {:answer/id #uuid "3b79c322-6598-546f-ad9c-ecda3e0b8cee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\ln2}{5597}" :db/id #edb/ref 17592186725583}] [:answer/id #uuid "3bc5c922-566d-5d7c-8841-0769cd3ade9e" {:answer/id #uuid "3bc5c922-566d-5d7c-8841-0769cd3ade9e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2000e^{rt}" :db/id #edb/ref 17592186725584}] [:answer/id #uuid "3c5239a2-4e80-5e01-a36e-eee67d03b448" {:answer/id #uuid "3c5239a2-4e80-5e01-a36e-eee67d03b448" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "189e^{-kt}" :db/id #edb/ref 17592186725585}] [:answer/id #uuid "3ddac532-4811-5b32-ad98-a1a19281d322" {:answer/id #uuid "3ddac532-4811-5b32-ad98-a1a19281d322" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5597\\ln(100/91)}{\\ln2}" :db/id #edb/ref 17592186725588}] [:answer/id #uuid "3f1007c1-6e26-5296-a39f-bee1a9d8c2c3" {:answer/id #uuid "3f1007c1-6e26-5296-a39f-bee1a9d8c2c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{24110\\ln(189/50)}{\\ln2}" :db/id #edb/ref 17592186725590}] [:answer/id #uuid "43348720-23d7-5a2f-a2f6-b3710f7b9375" {:answer/id #uuid "43348720-23d7-5a2f-a2f6-b3710f7b9375" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10\\ln50}{\\ln10}" :db/id #edb/ref 17592186725595}] [:answer/id #uuid "452408df-0d58-5249-86b8-071bfce53497" {:answer/id #uuid "452408df-0d58-5249-86b8-071bfce53497" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1360\\sqrt2" :db/id #edb/ref 17592186725596}] [:answer/id #uuid "454b4315-8409-508c-b13d-b8878b042cc8" {:answer/id #uuid "454b4315-8409-508c-b13d-b8878b042cc8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "30-15e^{-t/15}" :db/id #edb/ref 17592186725597}] [:answer/id #uuid "499b012f-3fbc-50dd-8e0e-ed5f6307ae72" {:answer/id #uuid "499b012f-3fbc-50dd-8e0e-ed5f6307ae72" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$W(y_1,y_2)=\\begin{vmatrix}e^{2x}&e^{-x}\\\\2e^{2x}&-e^{-x}\\end{vmatrix}=-3e^x\\ne0$ for every $x\\in\\mathbb R$. The two given functions are solutions of the homogeneous second-order linear equation, whose coefficients are continuous on $\\mathbb R$. The nonzero Wronskian proves linear independence, so the pair is a fundamental set on $\\mathbb R$." :db/id #edb/ref 17592186725602}] [:answer/id #uuid "67a5d355-5c7c-57fd-910e-da30d96c8fd6" {:answer/id #uuid "67a5d355-5c7c-57fd-910e-da30d96c8fd6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An example rocking trajectory has $(\\theta(0),v(0))=(0,\\sqrt{2g})$, so $E=g<2g$ and the closed curve is $v^2=2g\\cos\\theta$, $-\\pi/2\\leq\\theta\\leq\\pi/2$. Draw its upper branch rightward and lower branch leftward. For rotation choose $E=3g>2g$. The positive branch $v=\\sqrt{2g(2+\\cos\\theta)}$ through $(0,\\sqrt{6g})$ moves right; the negative branch through $(0,-\\sqrt{6g})$ moves left. With increasing angle defined as counterclockwise, these represent counterclockwise and clockwise physical rotation respectively.\n\n![Authored reference: three pendulum trajectories](/api/asset?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FWHW-3%2Fauthored-pendulum-trajectories.png)" :db/id #edb/ref 17592186725622}] [:answer/id #uuid "7158de45-0da7-56b2-9e27-609a073b284b" {:answer/id #uuid "7158de45-0da7-56b2-9e27-609a073b284b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1+23(13/23)^5" :db/id #edb/ref 17592186725631}] [:answer/id #uuid "76f4f2a9-a51c-5a26-a655-15374984d328" {:answer/id #uuid "76f4f2a9-a51c-5a26-a655-15374984d328" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "189\\exp(-10000\\ln2/24110)" :db/id #edb/ref 17592186725636}] [:answer/id #uuid "79006951-b357-5088-a775-fd60b8a81cd7" {:answer/id #uuid "79006951-b357-5088-a775-fd60b8a81cd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac1{20}" :db/id #edb/ref 17592186725641}] [:answer/id #uuid "7b0c4ca9-1c1a-5905-9577-01fd7ef2bbe3" {:answer/id #uuid "7b0c4ca9-1c1a-5905-9577-01fd7ef2bbe3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+17e^{-kt}" :db/id #edb/ref 17592186725643}] [:multistep/id #uuid "9dc17ff2-9a03-5c98-affa-8baa7d351dfa" {:db/id #edb/ref 17592186725668 :multistep/context "Source question: assignment PDF page 1, parts (a)–(d).\n\nA petri dish initially contains 2,000 bacteria and contains 20,000 after 10 hours. Assume $P\\prime(t)=rP(t)$, $P(0)=2000$." :multistep/first-step {:db/id #edb/ref 17592186725633} :multistep/id #uuid "9dc17ff2-9a03-5c98-affa-8baa7d351dfa" :multistep/steps [{:db/id #edb/ref 17592186725579 :step/content {:db/id #edb/ref 17592186725608} :step/id #uuid "39fed138-2442-50ec-ae7e-5e53529e449b" :step/next {:db/id #edb/ref 17592186725718}} {:db/id #edb/ref 17592186725633 :step/content {:db/id #edb/ref 17592186725610} :step/id #uuid "7579277a-1be0-52da-8848-e52c9ee879d0" :step/next {:db/id #edb/ref 17592186725686}} {:db/id #edb/ref 17592186725686 :step/content {:db/id #edb/ref 17592186725637} :step/id #uuid "b6345f45-9e85-555e-8030-bdb96ec2f9e0" :step/next {:db/id #edb/ref 17592186725579}} {:db/id #edb/ref 17592186725718 :step/content {:db/id #edb/ref 17592186725665} :step/id #uuid "e0e89a50-cbee-5922-9d25-865f5f44b6d1"}]}] [:multistep/id #uuid "b653dfdc-5aa2-5384-b6a9-cdd76f0a543f" {:db/id #edb/ref 17592186725687 :multistep/context "Source question: assignment PDF pages 3–4, parts (a)–(d).\n\nStart with $\\theta\\!\\prime\\!\\prime(t)=-g\\sin\\theta(t)$ for a simple pendulum of length $1\\,m$, with the source’s stated value $g=9.8$. 