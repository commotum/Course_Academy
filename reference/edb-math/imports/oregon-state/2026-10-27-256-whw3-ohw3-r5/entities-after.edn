wer-field/key "concentration" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725589}] [:answer-field/id #uuid "41660829-f5f6-55d2-b5a1-8ee30fe7859d" {:answer-field/choices [{:answer/id #uuid "67a5d355-5c7c-57fd-910e-da30d96c8fd6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "An example rocking trajectory has $(\\theta(0),v(0))=(0,\\sqrt{2g})$, so $E=g<2g$ and the closed curve is $v^2=2g\\cos\\theta$, $-\\pi/2\\leq\\theta\\leq\\pi/2$. Draw its upper branch rightward and lower branch leftward. For rotation choose $E=3g>2g$. The positive branch $v=\\sqrt{2g(2+\\cos\\theta)}$ through $(0,\\sqrt{6g})$ moves right; the negative branch through $(0,-\\sqrt{6g})$ moves left. With increasing angle defined as counterclockwise, these represent counterclockwise and clockwise physical rotation respectively.\n\n![Authored reference: three pendulum trajectories](/api/asset?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F256%2FWHW-3%2Fauthored-pendulum-trajectories.png)" :db/id #edb/ref 17592186725622}] :answer-field/correct {:db/id #edb/ref 17592186725622} :answer-field/id #uuid "41660829-f5f6-55d2-b5a1-8ee30fe7859d" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186725593}] [:answer-field/id #uuid "52f908e1-b5a9-5c10-867f-70233043aa60" {:answer-field/choices [{:answer/id #uuid "150e2c9b-2ea1-5bf9-9f70-4c68d5bd41a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{49\\cdot3600}{1609.344}" :db/id #edb/ref 17592186725549}] :answer-field/correct {:db/id #edb/ref 17592186725549} :answer-field/id #uuid "52f908e1-b5a9-5c10-867f-70233043aa60" :answer-field/key "velocity" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186725606}] [:answer-field/id #uuid "546ab586-8a8c-5712-9c93-5ea1a34ab84e" {:answer-field/choices [{:answer/id #uuid "abc3391e-fe78-57d4-813c-33ac8c6a14f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\p