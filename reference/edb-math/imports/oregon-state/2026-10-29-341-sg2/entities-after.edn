#{[:activity/id #uuid "ac962ebc-9a2a-5d1f-b694-b5dcb1149005" {:activity/course {:db/id #edb/ref 17592186405206} :activity/first-step {:db/id #edb/ref 17592186746927} :activity/id #uuid "ac962ebc-9a2a-5d1f-b694-b5dcb1149005" :activity/steps [{:db/id #edb/ref 17592186746916 :step/content {:db/id #edb/ref 17592186746942} :step/id #uuid "1160537a-0dfe-5cf6-980d-69fd74630a3a" :step/next {:db/id #edb/ref 17592186746945}} {:db/id #edb/ref 17592186746925 :step/content {:db/id #edb/ref 17592186746923} :step/id #uuid "30ea3927-05e8-5bd6-afec-7e57b30de2bf" :step/next {:db/id #edb/ref 17592186746916}} {:db/id #edb/ref 17592186746927 :step/content {:db/id #edb/ref 17592186746938} :step/id #uuid "41d82bea-1c4b-573c-a4c2-d18c1260ac32" :step/next {:db/id #edb/ref 17592186746925}} {:db/id #edb/ref 17592186746931 :step/content {:db/id #edb/ref 17592186746954} :step/id #uuid "57b4a881-f808-5cb3-8a64-528033acc8a1" :step/next {:db/id #edb/ref 17592186746953}} {:db/id #edb/ref 17592186746945 :step/content {:db/id #edb/ref 17592186746915} :step/id #uuid "b15cf211-f2df-5827-a531-040be99e0950" :step/next {:db/id #edb/ref 17592186746931}} {:db/id #edb/ref 17592186746953 :step/content {:db/id #edb/ref 17592186746921} :step/id #uuid "dd9b6b0a-75bc-5d79-ab19-ad9d9d6afa47"}] :activity/title "MTH 341 — Mini Exam 2 Review" :activity/type {:db/id #edb/ref 17592186045461} :db/id #edb/ref 17592186746941}] [:step/id #uuid "b15cf211-f2df-5827-a531-040be99e0950" {:db/id #edb/ref 17592186746945 :step/content {:db/id #edb/ref 17592186746915} :step/id #uuid "b15cf211-f2df-5827-a531-040be99e0950" :step/next {:db/id #edb/ref 17592186746931}}] [:step/id #uuid "dd9b6b0a-75bc-5d79-ab19-ad9d9d6afa47" {:db/id #edb/ref 17592186746953 :step/content {:db/id #edb/ref 17592186746921} :step/id #uuid "dd9b6b0a-75bc-5d79-ab19-ad9d9d6afa47"}] [:step/id #uuid "0628cfa3-9ea4-5a5f-afcf-57205440da1e" {:db/id #edb/ref 17592186746913 :step/content {:db/id #edb/ref 17592186746917} :step/id #uuid "0628cfa3-9ea4-5a5f-afcf-57205440da1e"}] [:step/id #uuid "1160537a-0dfe-5cf6-980d-69fd74630a3a" {:db/id #edb/ref 17592186746916 :step/content {:db/id #edb/ref 17592186746942} :step/id #uuid "1160537a-0dfe-5cf6-980d-69fd74630a3a" :step/next {:db/id #edb/ref 17592186746945}}] [:step/id #uuid "166967ee-86f9-50c2-9ee9-3781441c9141" {:db/id #edb/ref 17592186746918 :step/content {:db/id #edb/ref 17592186746914} :step/id #uuid "166967ee-86f9-50c2-9ee9-3781441c9141" :step/next {:db/id #edb/ref 17592186746913}}] [:step/id #uuid "30ea3927-05e8-5bd6-afec-7e57b30de2bf" {:db/id #edb/ref 17592186746925 :step/content {:db/id #edb/ref 17592186746923} :step/id #uuid "30ea3927-05e8-5bd6-afec-7e57b30de2bf" :step/next {:db/id #edb/ref 17592186746916}}] [:step/id #uuid "41d82bea-1c4b-573c-a4c2-d18c1260ac32" {:db/id #edb/ref 17592186746927 :step/content {:db/id #edb/ref 17592186746938} :step/id #uuid "41d82bea-1c4b-573c-a4c2-d18c1260ac32" :step/next {:db/id #edb/ref 17592186746925}}] [:step/id #uuid "4dac0a3b-b6b5-52ee-a0da-d519a1f0333f" {:db/id #edb/ref 17592186746929 :step/content {:db/id #edb/ref 17592186746955} :step/id #uuid "4dac0a3b-b6b5-52ee-a0da-d519a1f0333f" :step/next {:db/id #edb/ref 17592186746936}}] [:step/id #uuid "57b4a881-f808-5cb3-8a64-528033acc8a1" {:db/id #edb/ref 17592186746931 :step/content {:db/id #edb/ref 17592186746954} :step/id #uuid "57b4a881-f808-5cb3-8a64-528033acc8a1" :step/next {:db/id #edb/ref 17592186746953}}] [:step/id #uuid "665b5404-4a93-5fc9-b320-4faf5ee2d0e8" {:db/id #edb/ref 17592186746935 :step/content {:db/id #edb/ref 17592186746946} :step/id #uuid "665b5404-4a93-5fc9-b320-4faf5ee2d0e8"}] [:step/id #uuid "73f58a8d-2ead-554f-923b-f491a40b4f92" {:db/id #edb/ref 17592186746936 :step/content {:db/id #edb/ref 17592186746949} :step/id #uuid "73f58a8d-2ead-554f-923b-f491a40b4f92" :step/next {:db/id #edb/ref 17592186746935}}] [:tutorial/id #uuid "8fe816ac-6683-590c-a7f6-eaf00890030f" {:db/id #edb/ref 17592186746938 :tutorial/content "**MTH 341 — Mini Exam 2 Review**\n\nDue: unknown\nDeadline note: This is an exam review guide. Neither supplied PDF states a submission deadline or the current exam date; no deadline has been inferred from the historical PDF metadata.\nDate imported: 2026-10-29\nQuestion PDF: [MTH341-Mini-Exam2_Review-1.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FSG-2%2FMTH341-Mini-Exam2_Review-1.pdf)\nSupplied answer key: [ME2 review solutions-1.pdf](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FSG-2%2FME2%20review%20solutions-1.pdf)\nTextbook: [A First Course in Linear Algebra — Version 2017, Revision A](/api/source?path=%2Fhome%2Fjake%2FDeveloper%2Fstudy%2Fvault%2FF26%2Fsource%2F341%2FKuttler-LinearAlgebra-AFirstCourse-2017A.pdf), Lyryx Learning, based on K. Kuttler.\n\nStudy answers and worked explanations are authored additions, checked independently and compared with the supplied handwritten key. Alternative valid elementary-matrix factorizations and nonzero scalar multiples of a dependence relation are acceptable.\n\n## Instructions\n\nMini Exam 2 covers textbook §§2.1.9 (Elementary Matrices), 2.1.10 (More on Matrix Inverses), 3.1 (Basic Techniques and Properties of determinants), 4.10.1 (Spanning Set of Vectors), and 4.10.2 (Linearly Independent Set of Vectors). The review is not exhaustive. If a problem gives you trouble, work more similar problems from the textbook until you are comfortable with the ideas.\n\nThere are five numbered review items: one study direction and four mathematical exercises. Preserve both determinant methods in Problem 3. In Problem 2(c), infer the reversed product from row operations without multiplying the matrices." :tutorial/id #uuid "8fe816ac-6683-590c-a7f6-eaf00890030f" :tutorial/title "Assignment information"}] [:tutorial/id #uuid "2eab2c9b-153b-53a2-bb99-3e1a329d7fa2" {:db/id #edb/ref 17592186746923 :tutorial/content "Source question: review item 1, question PDF page 1.\n\nReview **all in-class activities and written homeworks**; the source says these form a large portion of the review. Revisit the original course work, especially the named textbook sections above. This is a study direction and requests no separate answer. The links below cover the named section concepts, rather than every earlier activity." :tutorial/id #uuid "2eab2c9b-153b-53a2-bb99-3e1a329d7fa2" :tutorial/title "Review earlier classwork — source item 1"}] [:question/id #uuid "b5bc11b8-a5c3-528d-84c3-062ac503f63c" {:db/id #edb/ref 17592186746946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9fb1dc8-c7e7-5225-82b2-b93a2b53f2d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the factors $A=E_3E_2E_1$ above, the reversed product is $E_1E_2E_3$. Read it as operations on $I_3$: first $R_1\\leftarrow R_1+4R_3$, then $R_3\\leftarrow2R_3$, then $R_1\\leftrightarrow R_2$. The result is $$E_1E_2E_3=\\begin{bmatrix}0&1&0\\\\1&0&4\\\\0&0&2\\end{bmatrix}.$$ The added 4 is not later doubled, because the scaling occurs after the addition. The final swap puts it in row 2. For another factorization, reverse that factorization and track its own operations." :db/id #edb/ref 17592186746952}] :answer-field/correct {:db/id #edb/ref 17592186746952} :answer-field/id #uuid "af8e3fc8-a46e-5d4f-a302-9edbe92321bc" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746944}] :question/id #uuid "b5bc11b8-a5c3-528d-84c3-062ac503f63c" :question/problem "**(c)** What effect does multiplying your elementary matrices in the opposite order have? Without performing the multiplication, identify that reversed product and explain its row-operation effect." :question/worked-solution "Reversing factors reverses the chronological row operations; it does not invert them. This reversed product is generally neither $A$ nor $A^{-1}$. The reference determines its entries from operations on the identity, as requested, rather than from matrix multiplication."}] [:question/id #uuid "cd7da067-9c9c-57f4-b9b6-107527036154" {:db/id #edb/ref 17592186746949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9cd5a101-3002-589f-a3a7-47cb62232d23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the factorization in the reference to (a), $E_2E_1=\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&2\\end{bmatrix}$. Then $$E_3(E_2E_1)=\\begin{bmatrix}1&0&4\\\\0&1&0\\\\0&0&1\\end{bmatrix}\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&2\\end{bmatrix}=\\begin{bmatrix}0&1&8\\\\1&0&0\\\\0&0&2\\end{bmatrix}=A.$$ Thus the proposed ordered product does equal $A$." :db/id #edb/ref 17592186746939}] :answer-field/correct {:db/id #edb/ref 17592186746939} :answer-field/id #uuid "292a7f77-4761-536e-ba26-1dcddfd006f2" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746922}] :question/id #uuid "cd7da067-9c9c-57f4-b9b6-107527036154" :question/problem "**(b)** Does your product of elementary matrices equal $A$? Multiply it out and show the verification." :question/worked-solution "Use the factors you actually chose in (a). The displayed calculation verifies the reference factorization by ordinary matrix multiplication. The top-right entry is $4\\cdot2=8$; swapping the factor order changes which row contains that entry."}] [:question/id #uuid "f4513fb9-a131-586d-9c6e-36d57b240a08" {:db/id #edb/ref 17592186746955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8a5017e-dc31-5471-b14c-22428fd5f039" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "One valid factorization is $A=E_3E_2E_1$, with $E_1=\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&1\\end{bmatrix}$, $E_2=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&2\\end{bmatrix}$, and $E_3=\\begin{bmatrix}1&0&4\\\\0&1&0\\\\0&0&1\\end{bmatrix}$. These correspond respectively to $R_1\\leftrightarrow R_2$, $R_3\\leftarrow2R_3$, and $R_1\\leftarrow R_1+4R_3$, applied to $I_3$ in that chronological order." :db/id #edb/ref 17592186746948}] :answer-field/correct {:db/id #edb/ref 17592186746948} :answer-field/id #uuid "d1bc35a6-6e4c-5b3c-93a6-4b3785f7a738" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746950}] :question/id #uuid "f4513fb9-a131-586d-9c6e-36d57b240a08" :question/problem "**(a)** Write $A$ as a product of elementary matrices." :question/worked-solution "Each factor must be obtainable from the identity by one elementary row operation. Left multiplication applies the rightmost factor first: the chronological sequence $E_1,E_2,E_3$ gives $E_3E_2E_1I_3=A$. A different correct sequence and factorization is also valid."}] [:question/id #uuid "ff1b9f3f-4126-5d55-af40-1d53f581908c" {:db/id #edb/ref 17592186746957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aee6afe-6f37-5500-a43a-edf199b43c56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The columns $\\mathbf a_1,\\mathbf a_2,\\mathbf a_3$ are linearly dependent. One relation is $$\\mathbf a_1+2\\mathbf a_2-3\\mathbf a_3=\\mathbf0.$$ For example, $$\\operatorname{rref}(A)=\\begin{bmatrix}1&0&1/3\\\\0&1&2/3\\\\0&0&0\\\\0&0&0\\end{bmatrix}.$$ Thus $A(c_1,c_2,c_3)^T=0$ gives $c_1=-c_3/3$, $c_2=-2c_3/3$. Choosing $c_3=-3$ yields the displayed relation. The key chooses the equivalent coefficients $(-1/3,-2/3,1)$." :db/id #edb/ref 17592186746919}] :answer-field/correct {:db/id #edb/ref 17592186746919} :answer-field/id #uuid "7497aab8-8b6d-5644-afd4-7eeabd61251d" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746937}] :question/id #uuid "ff1b9f3f-4126-5d55-af40-1d53f581908c" :question/problem "Source question: review Problem 5, question PDF page 2; supplied key PDF page 6.\n\nConsider $$A=\\begin{bmatrix}1&1&1\\\\9&6&7\\\\3&9&7\\\\6&3&4\\end{bmatrix}.$$ Are its columns linearly independent or linearly dependent? If they are dependent, find a nontrivial linear combination of the columns equal to the zero vector." :question/worked-solution "The relation is nontrivial because its coefficients are not all zero. Directly check its four components: $1+2-3=0$, $9+12-21=0$, $3+18-21=0$, and $6+6-12=0$. Any nonzero scalar multiple of the same coefficient vector works. Four rows and three columns alone do not imply dependence; the nonzero homogeneous solution establishes it."}] [:question/id #uuid "0b125d8f-8a4d-5cc6-851c-9d8c2af905e9" {:db/id #edb/ref 17592186746914 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3884f7c-a3a2-5b02-b1a0-39043fa1e46f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Expanding across row 1, $$\\det A=1\\begin{vmatrix}-2&0\\\\5&1\\end{vmatrix}-2\\begin{vmatrix}-1&0\\\\1&1\\end{vmatrix}+3\\begin{vmatrix}-1&-2\\\\1&5\\end{vmatrix}=-2-2(-1)+3(-5+2)=-9.$$" :db/id #edb/ref 17592186746951}] :answer-field/correct {:db/id #edb/ref 17592186746951} :answer-field/id #uuid "25418d11-221c-5a1f-8bd3-22da0bf28214" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746920} {:answer-field/choices [{:answer/id #uuid "a2b6ce5c-a998-59cb-8bcb-10b6b13f5769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186746940}] :answer-field/correct {:db/id #edb/ref 17592186746940} :answer-field/id #uuid "b9e9ff6f-a512-50e6-baef-bf37b37ee54b" :answer-field/key "determinant" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186746947}] :question/id #uuid "0b125d8f-8a4d-5cc6-851c-9d8c2af905e9" :question/problem "**(a)** Use **Laplace expansion**. Enter the determinant and show the expansion and evaluation.\n\n$\\det A=$ {{determinant}}." :question/worked-solution "The cofactor signs across the first row are $+,-,+$. The three minors have determinants $-2,-1,-3$. The middle contribution is $-2(-1)=+2$, so the total is $-2+2-9=-9$. Another correct row or column expansion is acceptable; the required method must remain visible in your work."}] [:question/id #uuid "15819c92-79f5-5c87-b090-bc3986a056d2" {:db/id #edb/ref 17592186746917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d948748-c270-56cd-9699-a77deaede177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186746934}] :answer-field/correct {:db/id #edb/ref 17592186746934} :answer-field/id #uuid "30361551-0c8b-5362-9416-f01c2f7be2f2" :answer-field/key "determinant" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186746924} {:answer-field/choices [{:answer/id #uuid "4142209a-5a5a-5cc2-8df6-46ed0387b6b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Apply $R_2\\leftarrow R_2+R_1$ to obtain $\\begin{bmatrix}1&2&3\\\\0&0&3\\\\1&5&1\\end{bmatrix}$. Swap $R_2,R_3$, then apply $R_2\\leftarrow R_2-R_1$. The resulting upper-triangular matrix is $U=\\begin{bmatrix}1&2&3\\\\0&3&-2\\\\0&0&3\\end{bmatrix}$. Both row replacements preserve determinant, while the one row swap reverses its sign. Thus $\\det U=1\\cdot3\\cdot3=9=-\\det A$, giving $\\det A=-9$." :db/id #edb/ref 17592186746926}] :answer-field/correct {:db/id #edb/ref 17592186746926} :answer-field/id #uuid "ae15c331-72f7-561d-ba6c-c99df0f3f39e" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746943}] :question/id #uuid "15819c92-79f5-5c87-b090-bc3986a056d2" :question/problem "**(b)** Use **row operations**, tracking their effects on the determinant. Enter the determinant and show the row operations.\n\n$\\det A=$ {{determinant}}." :question/worked-solution "Adding a multiple of another row preserves determinant; swapping two rows multiplies it by $-1$. The diagonal product 9 belongs to the transformed matrix, so undo the single sign change to recover the determinant of the original matrix. If you scale a row in another solution, account for that scale too."}] [:question/id #uuid "4fdfb66e-2939-52a3-b11b-5cfe0d5fca75" {:db/id #edb/ref 17592186746930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57ca3159-583c-56aa-ab74-db492349ab3e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The span is the plane through the origin $$\\operatorname{span}\\{\\mathbf u,\\mathbf w,\\mathbf p\\}=\\{(x,y,z)^T\\in\\mathbb R^3:x-2y+4z=0\\}.$$ Indeed, $\\mathbf p=\\frac32\\mathbf u+\\frac12\\mathbf w$, so the third vector adds no new direction. The first two vectors are independent. Their cross product is $\\mathbf u\\times\\mathbf w=(-2,4,-8)^T$, which is normal to their span, giving $-2x+4y-8z=0$. Equivalently, the plane is $(x,y,z)^T=s(-2,3,2)^T+t(2,1,0)^T$, $s,t\\in\\mathbb R$." :db/id #edb/ref 17592186746932}] :answer-field/correct {:db/id #edb/ref 17592186746932} :answer-field/id #uuid "5cb6c1fa-00be-59f4-8716-457dcdb02ecc" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746933}] :question/id #uuid "4fdfb66e-2939-52a3-b11b-5cfe0d5fca75" :question/problem "Source question: review Problem 4, question PDF page 1; supplied key PDF page 5.\n\nGeometrically describe the span of $\\mathbf u=(-2,3,2)^T$, $\\mathbf w=(2,1,0)^T$, and $\\mathbf p=(-2,5,3)^T$, using an equation of a line or plane, or another appropriate geometric description." :question/worked-solution "A nonzero normal is orthogonal to all three vectors, so each lies in the stated plane. The first two independent vectors span a two-dimensional set, proving that their span equals the whole plane, rather than merely lying within it. The set is not a line, and the third vector does not make the span all of $\\mathbb R^3$."}] [:answer-field/id #uuid "ae15c331-72f7-561d-ba6c-c99df0f3f39e" {:answer-field/choices [{:answer/id #uuid "4142209a-5a5a-5cc2-8df6-46ed0387b6b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Apply $R_2\\leftarrow R_2+R_1$ to obtain $\\begin{bmatrix}1&2&3\\\\0&0&3\\\\1&5&1\\end{bmatrix}$. Swap $R_2,R_3$, then apply $R_2\\leftarrow R_2-R_1$. The resulting upper-triangular matrix is $U=\\begin{bmatrix}1&2&3\\\\0&3&-2\\\\0&0&3\\end{bmatrix}$. Both row replacements preserve determinant, while the one row swap reverses its sign. Thus $\\det U=1\\cdot3\\cdot3=9=-\\det A$, giving $\\det A=-9$." :db/id #edb/ref 17592186746926}] :answer-field/correct {:db/id #edb/ref 17592186746926} :answer-field/id #uuid "ae15c331-72f7-561d-ba6c-c99df0f3f39e" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746943}] [:answer-field/id #uuid "af8e3fc8-a46e-5d4f-a302-9edbe92321bc" {:answer-field/choices [{:answer/id #uuid "d9fb1dc8-c7e7-5225-82b2-b93a2b53f2d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the factors $A=E_3E_2E_1$ above, the reversed product is $E_1E_2E_3$. Read it as operations on $I_3$: first $R_1\\leftarrow R_1+4R_3$, then $R_3\\leftarrow2R_3$, then $R_1\\leftrightarrow R_2$. The result is $$E_1E_2E_3=\\begin{bmatrix}0&1&0\\\\1&0&4\\\\0&0&2\\end{bmatrix}.$$ The added 4 is not later doubled, because the scaling occurs after the addition. The final swap puts it in row 2. For another factorization, reverse that factorization and track its own operations." :db/id #edb/ref 17592186746952}] :answer-field/correct {:db/id #edb/ref 17592186746952} :answer-field/id #uuid "af8e3fc8-a46e-5d4f-a302-9edbe92321bc" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746944}] [:answer-field/id #uuid "b9e9ff6f-a512-50e6-baef-bf37b37ee54b" {:answer-field/choices [{:answer/id #uuid "a2b6ce5c-a998-59cb-8bcb-10b6b13f5769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186746940}] :answer-field/correct {:db/id #edb/ref 17592186746940} :answer-field/id #uuid "b9e9ff6f-a512-50e6-baef-bf37b37ee54b" :answer-field/key "determinant" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186746947}] [:answer-field/id #uuid "d1bc35a6-6e4c-5b3c-93a6-4b3785f7a738" {:answer-field/choices [{:answer/id #uuid "c8a5017e-dc31-5471-b14c-22428fd5f039" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "One valid factorization is $A=E_3E_2E_1$, with $E_1=\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&1\\end{bmatrix}$, $E_2=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&2\\end{bmatrix}$, and $E_3=\\begin{bmatrix}1&0&4\\\\0&1&0\\\\0&0&1\\end{bmatrix}$. These correspond respectively to $R_1\\leftrightarrow R_2$, $R_3\\leftarrow2R_3$, and $R_1\\leftarrow R_1+4R_3$, applied to $I_3$ in that chronological order." :db/id #edb/ref 17592186746948}] :answer-field/correct {:db/id #edb/ref 17592186746948} :answer-field/id #uuid "d1bc35a6-6e4c-5b3c-93a6-4b3785f7a738" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746950}] [:answer-field/id #uuid "25418d11-221c-5a1f-8bd3-22da0bf28214" {:answer-field/choices [{:answer/id #uuid "d3884f7c-a3a2-5b02-b1a0-39043fa1e46f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Expanding across row 1, $$\\det A=1\\begin{vmatrix}-2&0\\\\5&1\\end{vmatrix}-2\\begin{vmatrix}-1&0\\\\1&1\\end{vmatrix}+3\\begin{vmatrix}-1&-2\\\\1&5\\end{vmatrix}=-2-2(-1)+3(-5+2)=-9.$$" :db/id #edb/ref 17592186746951}] :answer-field/correct {:db/id #edb/ref 17592186746951} :answer-field/id #uuid "25418d11-221c-5a1f-8bd3-22da0bf28214" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746920}] [:answer-field/id #uuid "292a7f77-4761-536e-ba26-1dcddfd006f2" {:answer-field/choices [{:answer/id #uuid "9cd5a101-3002-589f-a3a7-47cb62232d23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the factorization in the reference to (a), $E_2E_1=\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&2\\end{bmatrix}$. Then $$E_3(E_2E_1)=\\begin{bmatrix}1&0&4\\\\0&1&0\\\\0&0&1\\end{bmatrix}\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&2\\end{bmatrix}=\\begin{bmatrix}0&1&8\\\\1&0&0\\\\0&0&2\\end{bmatrix}=A.$$ Thus the proposed ordered product does equal $A$." :db/id #edb/ref 17592186746939}] :answer-field/correct {:db/id #edb/ref 17592186746939} :answer-field/id #uuid "292a7f77-4761-536e-ba26-1dcddfd006f2" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746922}] [:answer-field/id #uuid "30361551-0c8b-5362-9416-f01c2f7be2f2" {:answer-field/choices [{:answer/id #uuid "5d948748-c270-56cd-9699-a77deaede177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186746934}] :answer-field/correct {:db/id #edb/ref 17592186746934} :answer-field/id #uuid "30361551-0c8b-5362-9416-f01c2f7be2f2" :answer-field/key "determinant" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186746924}] [:answer-field/id #uuid "5cb6c1fa-00be-59f4-8716-457dcdb02ecc" {:answer-field/choices [{:answer/id #uuid "57ca3159-583c-56aa-ab74-db492349ab3e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The span is the plane through the origin $$\\operatorname{span}\\{\\mathbf u,\\mathbf w,\\mathbf p\\}=\\{(x,y,z)^T\\in\\mathbb R^3:x-2y+4z=0\\}.$$ Indeed, $\\mathbf p=\\frac32\\mathbf u+\\frac12\\mathbf w$, so the third vector adds no new direction. The first two vectors are independent. Their cross product is $\\mathbf u\\times\\mathbf w=(-2,4,-8)^T$, which is normal to their span, giving $-2x+4y-8z=0$. Equivalently, the plane is $(x,y,z)^T=s(-2,3,2)^T+t(2,1,0)^T$, $s,t\\in\\mathbb R$." :db/id #edb/ref 17592186746932}] :answer-field/correct {:db/id #edb/ref 17592186746932} :answer-field/id #uuid "5cb6c1fa-00be-59f4-8716-457dcdb02ecc" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746933}] [:answer-field/id #uuid "7497aab8-8b6d-5644-afd4-7eeabd61251d" {:answer-field/choices [{:answer/id #uuid "1aee6afe-6f37-5500-a43a-edf199b43c56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The columns $\\mathbf a_1,\\mathbf a_2,\\mathbf a_3$ are linearly dependent. One relation is $$\\mathbf a_1+2\\mathbf a_2-3\\mathbf a_3=\\mathbf0.$$ For example, $$\\operatorname{rref}(A)=\\begin{bmatrix}1&0&1/3\\\\0&1&2/3\\\\0&0&0\\\\0&0&0\\end{bmatrix}.$$ Thus $A(c_1,c_2,c_3)^T=0$ gives $c_1=-c_3/3$, $c_2=-2c_3/3$. Choosing $c_3=-3$ yields the displayed relation. The key chooses the equivalent coefficients $(-1/3,-2/3,1)$." :db/id #edb/ref 17592186746919}] :answer-field/correct {:db/id #edb/ref 17592186746919} :answer-field/id #uuid "7497aab8-8b6d-5644-afd4-7eeabd61251d" :answer-field/key "work" :answer-field/type {:db/id #edb/ref 17592186408167} :db/id #edb/ref 17592186746937}] [:answer/id #uuid "9cd5a101-3002-589f-a3a7-47cb62232d23" {:answer/id #uuid "9cd5a101-3002-589f-a3a7-47cb62232d23" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the factorization in the reference to (a), $E_2E_1=\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&2\\end{bmatrix}$. Then $$E_3(E_2E_1)=\\begin{bmatrix}1&0&4\\\\0&1&0\\\\0&0&1\\end{bmatrix}\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&2\\end{bmatrix}=\\begin{bmatrix}0&1&8\\\\1&0&0\\\\0&0&2\\end{bmatrix}=A.$$ Thus the proposed ordered product does equal $A$." :db/id #edb/ref 17592186746939}] [:answer/id #uuid "a2b6ce5c-a998-59cb-8bcb-10b6b13f5769" {:answer/id #uuid "a2b6ce5c-a998-59cb-8bcb-10b6b13f5769" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186746940}] [:answer/id #uuid "c8a5017e-dc31-5471-b14c-22428fd5f039" {:answer/id #uuid "c8a5017e-dc31-5471-b14c-22428fd5f039" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "One valid factorization is $A=E_3E_2E_1$, with $E_1=\\begin{bmatrix}0&1&0\\\\1&0&0\\\\0&0&1\\end{bmatrix}$, $E_2=\\begin{bmatrix}1&0&0\\\\0&1&0\\\\0&0&2\\end{bmatrix}$, and $E_3=\\begin{bmatrix}1&0&4\\\\0&1&0\\\\0&0&1\\end{bmatrix}$. These correspond respectively to $R_1\\leftrightarrow R_2$, $R_3\\leftarrow2R_3$, and $R_1\\leftarrow R_1+4R_3$, applied to $I_3$ in that chronological order." :db/id #edb/ref 17592186746948}] [:answer/id #uuid "d3884f7c-a3a2-5b02-b1a0-39043fa1e46f" {:answer/id #uuid "d3884f7c-a3a2-5b02-b1a0-39043fa1e46f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Expanding across row 1, $$\\det A=1\\begin{vmatrix}-2&0\\\\5&1\\end{vmatrix}-2\\begin{vmatrix}-1&0\\\\1&1\\end{vmatrix}+3\\begin{vmatrix}-1&-2\\\\1&5\\end{vmatrix}=-2-2(-1)+3(-5+2)=-9.$$" :db/id #edb/ref 17592186746951}] [:answer/id #uuid "d9fb1dc8-c7e7-5225-82b2-b93a2b53f2d4" {:answer/id #uuid "d9fb1dc8-c7e7-5225-82b2-b93a2b53f2d4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "For the factors $A=E_3E_2E_1$ above, the reversed product is $E_1E_2E_3$. Read it as operations on $I_3$: first $R_1\\leftarrow R_1+4R_3$, then $R_3\\leftarrow2R_3$, then $R_1\\leftrightarrow R_2$. The result is $$E_1E_2E_3=\\begin{bmatrix}0&1&0\\\\1&0&4\\\\0&0&2\\end{bmatrix}.$$ The added 4 is not later doubled, because the scaling occurs after the addition. The final swap puts it in row 2. For another factorization, reverse that factorization and track its own operations." :db/id #edb/ref 17592186746952}] [:answer/id #uuid "1aee6afe-6f37-5500-a43a-edf199b43c56" {:answer/id #uuid "1aee6afe-6f37-5500-a43a-edf199b43c56" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The columns $\\mathbf a_1,\\mathbf a_2,\\mathbf a_3$ are linearly dependent. One relation is $$\\mathbf a_1+2\\mathbf a_2-3\\mathbf a_3=\\mathbf0.$$ For example, $$\\operatorname{rref}(A)=\\begin{bmatrix}1&0&1/3\\\\0&1&2/3\\\\0&0&0\\\\0&0&0\\end{bmatrix}.$$ Thus $A(c_1,c_2,c_3)^T=0$ gives $c_1=-c_3/3$, $c_2=-2c_3/3$. Choosing $c_3=-3$ yields the displayed relation. The key chooses the equivalent coefficients $(-1/3,-2/3,1)$." :db/id #edb/ref 17592186746919}] [:answer/id #uuid "4142209a-5a5a-5cc2-8df6-46ed0387b6b6" {:answer/id #uuid "4142209a-5a5a-5cc2-8df6-46ed0387b6b6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "Apply $R_2\\leftarrow R_2+R_1$ to obtain $\\begin{bmatrix}1&2&3\\\\0&0&3\\\\1&5&1\\end{bmatrix}$. Swap $R_2,R_3$, then apply $R_2\\leftarrow R_2-R_1$. The resulting upper-triangular matrix is $U=\\begin{bmatrix}1&2&3\\\\0&3&-2\\\\0&0&3\\end{bmatrix}$. Both row replacements preserve determinant, while the one row swap reverses its sign. Thus $\\det U=1\\cdot3\\cdot3=9=-\\det A$, giving $\\det A=-9$." :db/id #edb/ref 17592186746926}] [:answer/id #uuid "57ca3159-583c-56aa-ab74-db492349ab3e" {:answer/id #uuid "57ca3159-583c-56aa-ab74-db492349ab3e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The span is the plane through the origin $$\\operatorname{span}\\{\\mathbf u,\\mathbf w,\\mathbf p\\}=\\{(x,y,z)^T\\in\\mathbb R^3:x-2y+4z=0\\}.$$ Indeed, $\\mathbf p=\\frac32\\mathbf u+\\frac12\\mathbf w$, so the third vector adds no new direction. The first two vectors are independent. Their cross product is $\\mathbf u\\times\\mathbf w=(-2,4,-8)^T$, which is normal to their span, giving $-2x+4y-8z=0$. Equivalently, the plane is $(x,y,z)^T=s(-2,3,2)^T+t(2,1,0)^T$, $s,t\\in\\mathbb R$." :db/id #edb/ref 17592186746932}] [:answer/id #uuid "5d948748-c270-56cd-9699-a77deaede177" {:answer/id #uuid "5d948748-c270-56cd-9699-a77deaede177" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186746934}] [:multistep/id #uuid "f455a750-0bc2-52cc-a2b5-5d5ea50602f7" {:db/id #edb/ref 17592186746956 :multistep/context "Source question: review Problem 3(a)–(b), question PDF page 1; supplied key PDF page 4.\n\nLet $A=\\begin{bmatrix}1&2&3\\\\-1&-2&0\\\\1&5&1\\end{bmatrix}$. Find $\\det A$ in both requested ways." :multistep/first-step {:db/id #edb/ref 17592186746918} :multistep/id #uuid "f455a750-0bc2-52cc-a2b5-5d5ea50602f7" :multistep/steps [{:db/id #edb/ref 17592186746913 :step/content {:db/id #edb/ref 17592186746917} :step/id #uuid "0628cfa3-9ea4-5a5f-afcf-57205440da1e"} {:db/id #edb/ref 17592186746918 :step/content {:db/id #edb/ref 17592186746914} :step/id #uuid "166967ee-86f9-50c2-9ee9-3781441c9141" :step/next {:db/id #edb/ref 17592186746913}}]}] [:multistep/id #uuid "44f7bb2e-122b-5418-8d85-11a3d76e5ed2" {:db/id #edb/ref 17592186746928 :multistep/context "Source question: review Problem 2(a)–(c), question PDF page 1; supplied key PDF page 3.\n\nLet $A=\\begin{bmatrix}0&1&8\\\\1&0&0\\\\0&0&2\\end{bmatrix}$." :multistep/first-step {:db/id #edb/ref 17592186746929} :multistep/id #uuid "44f7bb2e-122b-5418-8d85-11a3d76e5ed2" :multistep/steps [{:db/id #edb/ref 17592186746929 :step/content {:db/id #edb/ref 17592186746955} :step/id #uuid "4dac0a3b-b6b5-52ee-a0da-d519a1f0333f" :step/next {:db/id #edb/ref 17592186746936}} {:db/id #edb/ref 17592186746935 :step/content {:db/id #edb/ref 17592186746946} :step/id #uuid "665b5404-4a93-5fc9-b320-4faf5ee2d0e8"} {:db/id #edb/ref 17592186746936 :step/content {:db/id #edb/ref 17592186746949} :step/id #uuid "73f58a8d-2ead-554f-923b-f491a40b4f92" :step/next {:db/id #edb/ref 17592186746935}}]}] [:assigned-problem/id #uuid "acc0290c-b2e2-514f-bd14-83a02db1e3f7" {:assigned-problem/content {:db/id #edb/ref 17592186746928} :assigned-problem/id #uuid "acc0290c-b2e2-514f-bd14-83a02db1e3f7" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048897} {:db/id #edb/ref 17592186048947} {:db/id #edb/ref 17592186049120} {:db/id #edb/ref 17592186050122} {:db/id #edb/ref 17592186050407}] :db/id #edb/ref 17592186746942}] [:assigned-problem/id #uuid "f1f9e9c9-b7a4-5713-9f01-e39366507bfe" {:assigned-problem/content {:db/id #edb/ref 17592186746930} :assigned-problem/id #uuid "f1f9e9c9-b7a4-5713-9f01-e39366507bfe" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048315} {:db/id #edb/ref 17592186049132} {:db/id #edb/ref 17592186050426} {:db/id #edb/ref 17592186050830}] :db/id #edb/ref 17592186746954}] [:assigned-problem/id #uuid "1002dfd1-55d7-5677-9924-d7eeaac99075" {:assigned-problem/content {:db/id #edb/ref 17592186746956} :assigned-problem/id #uuid "1002dfd1-55d7-5677-9924-d7eeaac99075" :assigned-problem/topic-coverage [{:db/id #edb/ref 17592186048146} {:db/id #edb/ref 17592186048462} {:db/id #edb/ref 17592186049044} {:db/id #edb/ref 17592186049