e64c-7403-513f-8226-965dc9047c83" :answer-field/key "selection"] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/type :answer-field.type/radio] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/choices "6cfc93ed-a04e-53e2-aef8-93a800f546f9"] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/choices "66e803e3-07ba-5dbc-be08-f2c22bbd17d0"] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/choices "073af3cd-23f6-5eb0-b9da-dad13af15789"] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/choices "85586217-4ffc-500b-9207-6b311e44de74"] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/choices "82c8939a-af3e-53e0-8c53-7247f14776d0"] [:db/add "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/correct "6cfc93ed-a04e-53e2-aef8-93a800f546f9"] [:db/ensure "e3ade64c-7403-513f-8226-965dc9047c83" :answer-field/validate] [:db/add "0b997fa8-0912-5e8b-aee1-48d51dbcc779" :question/id #uuid "0b997fa8-0912-5e8b-aee1-48d51dbcc779"] [:db/add "0b997fa8-0912-5e8b-aee1-48d51dbcc779" :question/problem "![](images/ab/ab890e4a7841dc3868808f95cc81035e85d88ef53ff3b0aeb0f439b522496af6.png)\n\nIn the diagram, $L$ lies on the segment $DV$. The given vectors are $\\overrightarrow{OD}=g$ and $\\overrightarrow{OV}=r$. The lengths satisfy $DL:LV=1:5$.\n\nExpress $\\overrightarrow{OL}$ in terms of $g$ and $r$."] [:db/add "0b997fa8-0912-5e8b-aee1-48d51dbcc779" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OD}=g\\qquad \\overrightarrow{OV}=r .\n$$\n\nTrace the path from $D$ through $O$ to $V$:\n\n$$\n\\overrightarrow{DV}=\\overrightarrow{DO}+\\overrightarrow{OV}=-g+r.\n$$\n\nThe ratio $DL:LV=1:5$ gives $6$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{DL}=\\frac{1}{6}\\overrightarrow{DV}=\\frac{1}{6}(-g+r).\n$$\n\nAdd along the path $O\\to D\\to L$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OL}&=\\overrightarrow{OD}+\\overrightarrow{DL}\\\\&=g+\\frac{1}{6}(-g+r)\\\\&=\\frac{5}{6}g+\\frac{1}{6}r.\\end{aligned}\n$$"] [:db/add "0b997fa8-0912-5e8b-aee1-48d51dbcc779" :question/difficulty :question.difficulty/easy] [:db/add "0b997fa8-0912-5e8b-aee1-48d51dbcc779" :question/answer-fields "e3ade64c-7403-513f-8226-965dc9047c83"] [:db/ensure "0b997fa8-0912-5e8b-aee1-48d51dbcc779" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "0b997fa8-0912-5e8b-aee1-48d51dbcc779"] [:db/add "6778e000-f141-505b-966b-24e0b7644bd0" :answer/id #uuid "6778e000-f141-505b-966b-24e0b7644bd0"] [:db/add "6778e000-f141-505b-966b-24e0b7644bd0" :answer/type :answer.type/math] [:db/add "6778e000-f141-505b-966b-24e0b7644bd0" :answer/value "\\frac{1}{3}"] [:db/ensure "6778e000-f141-505b-966b-24e0b7644bd0" :answer/validate] [:db/add "e33f99be-4cc8-569d-86e7-4ab74c95035d" :answer-field/id #uuid "e33f99be-4cc8-569d-86e7-4ab74c95035d"] [:db/add "e33f99be-4cc8-569d-86e7-4ab74c95035d" :answer-field/key "field-1"] [:db/add "e33f99be-4cc8-569d-86e7-4ab74c95035d" :answer-field/type :answer-field.type/blank] [:db/add "e33f99be-4cc8-569d-86e7-4ab74c95035d" :answer-field/choices "6778e000-f141-505b-966b-24e0b7644bd0"] [:db/add "e33f99be-4cc8-569d-86e7-4ab74c95035d" :answer-field/correct "6778e000-f141-505b-966b-24e0b7644bd0"] [:db/ensure "e33f99be-4cc8-569d-86e7-4ab74c95035d" :answer-field/validate] [:db/add "0aff5c53-1b53-549b-8be3-d82fc45fc102" :answer/id #uuid "0aff5c53-1b53-549b-8be3-d82fc45fc102"] [:db/add "0aff5c53-1b53-549b-8be3-d82fc45fc102" :answer/type :answer.type/math] [:db/add "0aff5c53-1b53-549b-8be3-d82fc45fc102" :answer/value "\\frac{2}{3}"] [:db/ensure "0aff5c53-1b53-549b-8be3-d82fc45fc102" :answer/validate] [:db/add "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6" :answer-field/id #uuid "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6"] [:db/add "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6" :answer-field/key "field-2"] [:db/add "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6" :answer-field/type :answer-field.type/blank] [:db/add "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6" :answer-field/choices "0aff5c53-1b53-549b-8be3-d82fc45fc102"] [:db/add "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6" :answer-field/correct "0aff5c53-1b53-549b-8be3-d82fc45fc102"] [:db/ensure "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6" :answer-field/validate] [:db/add "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/id #uuid "c73a3fe1-fdab-5918-9c50-99a72c51bc7a"] [:db/add "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/problem "![](images/7c/7c2e0b48533b27a5bc790bfa7ec742589dfd3da75775a71ca9ec66a401b4e664.png)\n\nIn the diagram, $C$ lies on the segment $FP$. The given vectors are $\\overrightarrow{OF}=g$ and $\\overrightarrow{OP}=v$. The lengths satisfy $FC:CP=2:1$.\n\nExpress $\\overrightarrow{OC}$ in terms of $g$ and $v$. Fill in both coefficients, including their signs.\n\n$\\overrightarrow{OC}=$ {{field-1}} $g+$ {{field-2}} $v$"] [:db/add "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OF}=g\\qquad \\overrightarrow{OP}=v .\n$$\n\nTrace the path from $F$ through $O$ to $P$:\n\n$$\n\\overrightarrow{FP}=\\overrightarrow{FO}+\\overrightarrow{OP}=-g+v.\n$$\n\nThe ratio $FC:CP=2:1$ gives $3$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{FC}=\\frac{2}{3}\\overrightarrow{FP}=\\frac{2}{3}(-g+v).\n$$\n\nAdd along the path $O\\to F\\to C$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OC}&=\\overrightarrow{OF}+\\overrightarrow{FC}\\\\&=g+\\frac{2}{3}(-g+v)\\\\&=\\frac{1}{3}g+\\frac{2}{3}v.\\end{aligned}\n$$"] [:db/add "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/difficulty :question.difficulty/easy] [:db/add "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/answer-fields "e33f99be-4cc8-569d-86e7-4ab74c95035d"] [:db/add "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/answer-fields "51d00ae1-bdcd-5daa-a77b-6adaf84efbe6"] [:db/ensure "c73a3fe1-fdab-5918-9c50-99a72c51bc7a" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "c73a3fe1-fdab-5918-9c50-99a72c51bc7a"] [:db/add "cb58cc95-fa8f-581f-b035-1d2798289ed8" :answer/id #uuid "cb58cc95-fa8f-581f-b035-1d2798289ed8"] [:db/add "cb58cc95-fa8f-581f-b035-1d2798289ed8" :answer/type :answer.type/math] [:db/add "cb58cc95-fa8f-581f-b035-1d2798289ed8" :answer/value "\\overrightarrow{OE}=\\frac{1}{2}a+\\frac{1}{2}d"] [:db/ensure "cb58cc95-fa8f-581f-b035-1d2798289ed8" :answer/validate] [:db/add "8eed9c20-1144-5d34-b9d7-c30b11e6b497" :answer/id #uuid "8eed9c20-1144-5d34-b9d7-c30b11e6b497"] [:db/add "8eed9c20-1144-5d34-b9d7-c30b11e6b497" :answer/type :answer.type/math] [:db/add "8eed9c20-1144-5d34-b9d7-c30b11e6b497" :answer/value "\\overrightarrow{OE}=\\frac{2}{3}a+\\frac{1}{3}d"] [:db/ensure "8eed9c20-1144-5d34-b9d7-c30b11e6b497" :answer/validate] [:db/add "c835c825-b64f-5329-8db8-246f04f95113" :answer/id #uuid "c835c825-b64f-5329-8db8-246f04f95113"] [:db/add "c835c825-b64f-5329-8db8-246f04f95113" :answer/type :answer.type/math] [:db/add "c835c825-b64f-5329-8db8-246f04f95113" :answer/value "\\overrightarrow{OE}=\\frac{4}{5}a+\\frac{1}{5}d"] [:db/ensure "c835c825-b64f-5329-8db8-246f04f95113" :answer/validate] [:db/add "c57ca50e-1c62-5c63-a34b-b45cd924bc0c" :answer/id #uuid "c57ca50e-1c62-5c63-a34b-b45cd924bc0c"] [:db/add "c57ca50e-1c62-5c63-a34b-b45cd924bc0c" :answer/type :answer.type/math] [:db/add "c57ca50e-1c62-5c63-a34b-b45cd924bc0c" :answer/value "\\overrightarrow{OE}=\\frac{1}{3}a+\\frac{2}{3}d"] [:db/ensure "c57ca50e-1c62-5c63-a34b-b45cd924bc0c" :answer/validate] [:db/add "19e649ab-0346-57ab-ba7a-c736abbdf1ff" :answer/id #uuid "19e649ab-0346-57ab-ba7a-c736abbdf1ff"] [:db/add "19e649ab-0346-57ab-ba7a-c736abbdf1ff" :answer/type :answer.type/math] [:db/add "19e649ab-0346-57ab-ba7a-c736abbdf1ff" :answer/value "\\overrightarrow{OE}=\\frac{1}{5}a+\\frac{4}{5}d"] [:db/ensure "19e649ab-0346-57ab-ba7a-c736abbdf1ff" :answer/validate] [:db/add "2b1d519a-f0ec-5655-aeb9-1e946710166c" :answer-field/id #uuid "2b1d519a-f0ec-5655-