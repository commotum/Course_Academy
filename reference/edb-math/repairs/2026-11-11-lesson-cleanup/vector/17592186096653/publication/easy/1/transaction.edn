E}&=\\overrightarrow{OY}+\\overrightarrow{YE}\\\\&=a+\\frac{1}{3}(-a+d)\\\\&=\\frac{2}{3}a+\\frac{1}{3}d.\\end{aligned}\n$$"] [:db/add "b829ed91-7bc0-5c36-a885-c8f9aaa618eb" :question/difficulty :question.difficulty/easy] [:db/add "b829ed91-7bc0-5c36-a885-c8f9aaa618eb" :question/answer-fields "2b1d519a-f0ec-5655-aeb9-1e946710166c"] [:db/ensure "b829ed91-7bc0-5c36-a885-c8f9aaa618eb" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "b829ed91-7bc0-5c36-a885-c8f9aaa618eb"] [:db/add "23a7fcc8-a78f-5747-b726-147a1b51f87a" :answer/id #uuid "23a7fcc8-a78f-5747-b726-147a1b51f87a"] [:db/add "23a7fcc8-a78f-5747-b726-147a1b51f87a" :answer/type :answer.type/math] [:db/add "23a7fcc8-a78f-5747-b726-147a1b51f87a" :answer/value "\\overrightarrow{OE}=\\frac{5}{9}k+\\frac{4}{9}d"] [:db/ensure "23a7fcc8-a78f-5747-b726-147a1b51f87a" :answer/validate] [:db/add "e95b6f23-3577-5b09-a64c-830a74d50b49" :answer/id #uuid "e95b6f23-3577-5b09-a64c-830a74d50b49"] [:db/add "e95b6f23-3577-5b09-a64c-830a74d50b49" :answer/type :answer.type/math] [:db/add "e95b6f23-3577-5b09-a64c-830a74d50b49" :answer/value "\\overrightarrow{OE}=\\frac{1}{2}k+\\frac{1}{2}d"] [:db/ensure "e95b6f23-3577-5b09-a64c-830a74d50b49" :answer/validate] [:db/add "527448bd-44ef-5668-ad10-5932c436d8af" :answer/id #uuid "527448bd-44ef-5668-ad10-5932c436d8af"] [:db/add "527448bd-44ef-5668-ad10-5932c436d8af" :answer/type :answer.type/math] [:db/add "527448bd-44ef-5668-ad10-5932c436d8af" :answer/value "\\overrightarrow{OE}=\\frac{2}{7}k+\\frac{5}{7}d"] [:db/ensure "527448bd-44ef-5668-ad10-5932c436d8af" :answer/validate] [:db/add "be66bf8b-5f17-564b-9c33-c9a03809e84c" :answer/id #uuid "be66bf8b-5f17-564b-9c33-c9a03809e84c"] [:db/add "be66bf8b-5f17-564b-9c33-c9a03809e84c" :answer/type :answer.type/math] [:db/add "be66bf8b-5f17-564b-9c33-c9a03809e84c" :answer/value "\\overrightarrow{OE}=\\frac{5}{7}k+\\frac{2}{7}d"] [:db/ensure "be66bf8b-5f17-564b-9c33-c9a03809e84c" :answer/validate] [:db/add "66cd466f-0972-5a1d-8360-70623425e860" :answer/id #uuid "66cd466f-0972-5a1d-8360-70623425e860"] [:db/add "66cd466f-0972-5a1d-8360-70623425e860" :answer/type :answer.type/math] [:db/add "66cd466f-0972-5a1d-8360-70623425e860" :answer/value "\\overrightarrow{OE}=\\frac{4}{9}k+\\frac{5}{9}d"] [:db/ensure "66cd466f-0972-5a1d-8360-70623425e860" :answer/validate] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/id #uuid "1de84cb4-8c7d-5834-a2e7-100c25262105"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/key "selection"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/type :answer-field.type/radio] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/choices "23a7fcc8-a78f-5747-b726-147a1b51f87a"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/choices "e95b6f23-3577-5b09-a64c-830a74d50b49"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/choices "527448bd-44ef-5668-ad10-5932c436d8af"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/choices "be66bf8b-5f17-564b-9c33-c9a03809e84c"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/choices "66cd466f-0972-5a1d-8360-70623425e860"] [:db/add "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/correct "66cd466f-0972-5a1d-8360-70623425e860"] [:db/ensure "1de84cb4-8c7d-5834-a2e7-100c25262105" :answer-field/validate] [:db/add "92b2472e-3451-563a-b8b4-ba567efa49e0" :question/id #uuid "92b2472e-3451-563a-b8b4-ba567efa49e0"] [:db/add "92b2472e-3451-563a-b8b4-ba567efa49e0" :question/problem "![](images/be/bef828df5540b1332dca87bf79090bf906ca224a648446c2470e6fb32f5174fd.png)\n\nIn the diagram, $E$ lies on the segment $PY$. The given vectors are $\\overrightarrow{OP}=k$ and $\\overrightarrow{OY}=d$. The lengths satisfy $PE:EY=5:4$.\n\nExpress $\\overrightarrow{OE}$ in terms of $k$ and $d$."] [:db/add "92b2472e-3451-563a-b8b4-ba567efa49e0" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OP}=k\\qquad \\overrightarrow{OY}=d .\n$$\n\nTrace the path from $P$ through $O$ to $Y$:\n\n$$\n\\overrightarrow{PY}=\\overrightarrow{PO}+\\overrightarrow{OY}=-k+d.\n$$\n\nThe ratio $PE:EY=5:4$ gives $9$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{PE}=\\frac{5}{9}\\overrightarrow{PY}=\\frac{5}{9}(-k+d).\n$$\n\nAdd along the path $O\\to P\\to E$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OE}&=\\overrightarrow{OP}+\\overrightarrow{PE}\\\\&=k+\\frac{5}{9}(-k+d)\\\\&=\\frac{4}{9}k+\\frac{5}{9}d.\\end{aligned}\n$$"] [:db/add "92b2472e-3451-563a-b8b4-ba567efa49e0" :question/difficulty :question.difficulty/easy] [:db/add "92b2472e-3451-563a-b8b4-ba567efa49e0" :question/answer-fields "1de84cb4-8c7d-5834-a2e7-100c25262105"] [:db/ensure "92b2472e-3451-563a-b8b4-ba567efa49e0" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "92b2472e-3451-563a-b8b4-ba567efa49e0"] [:db/add "c5a62a9d-dd31-5427-b7cb-735080dc07c2" :answer/id #uuid "c5a62a9d-dd31-5427-b7cb-735080dc07c2"] [:db/add "c5a62a9d-dd31-5427-b7cb-735080dc07c2" :answer/type :answer.type/math] [:db/add "c5a62a9d-dd31-5427-b7cb-735080dc07c2" :answer/value "\\frac{4}{7}"] [:db/ensure "c5a62a9d-dd31-5427-b7cb-735080dc07c2" :answer/validate] [:db/add "836377c8-d425-5def-bae9-8ba28a24b89c" :answer-field/id #uuid "836377c8-d425-5def-bae9-8ba28a24b89c"] [:db/add "836377c8-d425-5def-bae9-8ba28a24b89c" :answer-field/key "field-1"] [:db/add "836377c8-d425-5def-bae9-8ba28a24b89c" :answer-field/type :answer-field.type/blank] [:db/add "836377c8-d425-5def-bae9-8ba28a24b89c" :answer-field/choices "c5a62a9d-dd31-5427-b7cb-735080dc07c2"] [:db/add "836377c8-d425-5def-bae9-8ba28a24b89c" :answer-field/correct "c5a62a9d-dd31-5427-b7cb-735080dc07c2"] [:db/ensure "836377c8-d425-5def-bae9-8ba28a24b89c" :answer-field/validate] [:db/add "1eafc2a1-a7b9-58a1-b422-7005a61c38dc" :answer/id #uuid "1eafc2a1-a7b9-58a1-b422-7005a61c38dc"] [:db/add "1eafc2a1-a7b9-58a1-b422-7005a61c38dc" :answer/type :answer.type/math] [:db/add "1eafc2a1-a7b9-58a1-b422-7005a61c38dc" :answer/value "\\frac{3}{7}"] [:db/ensure "1eafc2a1-a7b9-58a1-b422-7005a61c38dc" :answer/validate] [:db/add "9255d333-8bc8-57d8-9792-a7f5cf43209f" :answer-field/id #uuid "9255d333-8bc8-57d8-9792-a7f5cf43209f"] [:db/add "9255d333-8bc8-57d8-9792-a7f5cf43209f" :answer-field/key "field-2"] [:db/add "9255d333-8bc8-57d8-9792-a7f5cf43209f" :answer-field/type :answer-field.type/blank] [:db/add "9255d333-8bc8-57d8-9792-a7f5cf43209f" :answer-field/choices "1eafc2a1-a7b9-58a1-b422-7005a61c38dc"] [:db/add "9255d333-8bc8-57d8-9792-a7f5cf43209f" :answer-field/correct "1eafc2a1-a7b9-58a1-b422-7005a61c38dc"] [:db/ensure "9255d333-8bc8-57d8-9792-a7f5cf43209f" :answer-field/validate] [:db/add "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/id #uuid "e193f0d2-053b-5054-9eb2-74b96e7e2780"] [:db/add "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/problem "![](images/2a/2aff0727b19f7a32a04f35e316489b8f9b18675cf88841cfd59b52e845d6dd2b.png)\n\nIn the diagram, $Z$ lies on the segment $XR$. The given vectors are $\\overrightarrow{OX}=f$ and $\\overrightarrow{OR}=u$. The lengths satisfy $XZ:ZR=3:4$.\n\nExpress $\\overrightarrow{OZ}$ in terms of $f$ and $u$. Fill in both coefficients, including their signs.\n\n$\\overrightarrow{OZ}=$ {{field-1}} $f+$ {{field-2}} $u$"] [:db/add "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OX}=f\\qquad \\overrightarrow{OR}=u .\n$$\n\nTrace the path from $X$ through $O$ to $R$:\n\n$$\n\\overrightarrow{XR}=\\overrightarrow{XO}+\\overrightarrow{OR}=-f+u.\n$$\n\nThe ratio $XZ:ZR=3:4$ gives $7$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{XZ}=\\frac{3}{7}\\overrightarrow{XR}=\\frac{3}{7}(-f+u).\n$$\n\nAdd along the path $O\\to X\\to Z$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OZ}&=\\overrightarrow{OX}+\\overrightarrow{XZ}\\\\&=f+\\frac{3}{7}(-f+u)\\\\&=\\frac{4}{7}f+\\frac{3}{7}u.\\end{aligned}\n$$"] [:db/add "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/difficulty :question.difficulty/easy] [:db/add "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/answer-fields "836377c8-d425-5def-bae9-8ba28a24b89c"] [:db/add "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/answer-fields "9255d333-8bc8-57d8-9792-a7f5cf43209f"] [:db/ensure "e193f0d2-053b-5054-9eb2-74b96e7e2780" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "e193f0d2-053b-5054-9eb2-74b96e7e2780"] [:db/add "e0832d30-19eb-556e-afd5-4e9413137aaa" :answer/id #uuid "e0832d30-19eb-556e-afd5-4e9413137aaa"] [:db/add "e0832d30-19eb-556e-afd5-4e9413137aaa" :answer/type :answer.type/math] [:db/add "e0832d30-19eb-556e-afd5-4e9413137aaa" :answer/value "\\overrightarrow{OK}=\\frac{1}{3}s+\\frac{2}{3}p"] [:db/ensure "e0832d30-19eb-556e-afd5-4e9413137aaa" :answer/validate] [:db/add "da385bb7-51d5-5e96-b6fc-fb4866b56292" :answer/id #uuid "da385bb7-51d5-5e96-b6fc-fb4866b56292"] [:db/add "da385bb7-51d5-5e96-b6fc-fb4866b56292" :answer/type :answer.type/math] [:db/add "da385bb7-51d5-5e96-b6fc-fb4866b56292" :answer/value "\\overrightarrow{OK}=\\frac{2}{3}s+\\frac{1}{3}p"] [:db/ensure "da385bb7-51d5-5e96-b6fc-fb4866b56292" :answer/validate] [:db/add "503c1f3e-5a66-57f1-ae68-5ba9fcbb45ea" :answer/id #uuid "503c1f3e-5a66-57f1-ae68-5ba9fcbb45ea"] [:db/add "503c1f3e-5a66-57f1-ae68-5ba9fcbb45ea" :answer/type :answer.type/math] [:db/add "503c1f3e-5a66-57f1-ae68-5ba9fcbb45ea" :answer/value "\\overrightarrow{OK}=\\frac{1}{5}s+\\frac{4}{5}p"] [:db/ensure "503c1f3e-5a66-57f1-ae68-5ba9fcbb45ea" :answer/validate] [:db/add "6333c243-4fce-56a9-8301-aa40688b014f" :answer/id #uuid "6333c243-4fce-56a9-8301-aa40688b014f"] [:db/add "6333c243-4fce-56a9-8301-aa40688b014f" :answer/type :answer.type/math] [:db/add "6333c243-4fce-56a9-8301-aa40688b014f" :answer/value "\\overrightarrow{OK}=\\frac{4}{5}s+\\frac{1}{5}p"] [:db/ensure "6333c243-4fce-56a9-8301-aa40688b014f" :answer/validate] [:db/add "3d4ebe70-9f80-582d-829c-9a25ca2fffe4" :answer/id #uuid "3d4ebe70-9f80-582d-829c-9a25ca2fffe4"] [:db/add "3d4ebe70-9f80-582d-829c-9a25ca2fffe4" :answer/type :answer.type/math] [:db/add "3d4ebe70-9f80-582d-829c-9a25ca2fffe4" :answer/value "\\overrightarrow{OK}=\\frac{1}{2}s+\\frac{1}{2}p"] [:db/ensure "3d4ebe70-9f80-582d-829c-9a25ca2fffe4" :answer/validate] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/id #uuid "ff203300-85c5-5cd4-a372-1706c7a6dc30"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/key "selection"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/type :answer-field.type/radio] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/choices "e0832d30-19eb-556e-afd5-4e9413137aaa"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/choices "da385bb7-51d5-5e96-b6fc-fb4866b56292"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/choices "503c1f3e-5a66-57f1-ae68-5ba9fcbb45ea"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/choices "6333c243-4fce-56a9-8301-aa40688b014f"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/choices "3d4ebe70-9f80-582d-829c-9a25ca2fffe4"] [:db/add "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/correct "6333c243-4fce-56a9-8301-aa40688b014f"] [:db/ensure "ff203300-85c5-5cd4-a372-1706c7a6dc30" :answer-field/validate] [:db/add "8d2b819b-ae02-5b15-948d-31abbce117fc" :question/id #uuid "8d2b819b-ae02-5b15-948d-31abbce117fc"] [:db/add "8d2b819b-ae02-5b15-948d-31abbce117fc" :question/problem "![](images/31/3143098a67eb20c3a558b1afa1bccad7e3b8e459458cf78a738acb598708a4d6.png)\n\nIn the diagram, $K$ lies on the segment $HL$. The given vectors are $\\overrightarrow{OH}=s$ and $\\overrightarrow{OL}=p$. The lengths satisfy $HK:KL=1:4$.\n\nExpress $\\overrightarrow{OK}$ in terms of $s$ and $p$."] [:db/add "8d2b819b-ae02-5b15-948d-31abbce117fc" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OH}=s\\qquad \\overrightarrow{OL}=p .\n$$\n\nTrace the path from $H$ through $O$ to $L$:\n\n$$\n\\overrightarrow{HL}=\\overrightarrow{HO}+\\overrightarrow{OL}=-s+p.\n$$\n\nThe ratio $HK:KL=1:4$ gives $5$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{HK}=\\frac{1}{5}\\overrightarrow{HL}=\\frac{1}{5}(-s+p).\n$$\n\nAdd along the path $O\\to H\\to K$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OK}&=\\overrightarrow{OH}+\\overrightarrow{HK}\\\\&=s+\\frac{1}{5}(-s+p)\\\\&=\\frac{4}{5}s+\\frac{1}{5}p.\\end{aligned}\n$$"] [:db/add "8d2b819b-ae02-5b15-948d-31abbce117fc" :question/difficulty :question.difficulty/easy] [:db/add "8d2b819b-ae02-5b15-948d-31abbce117fc" :question/answer-fields "ff203300-85c5-5cd4-a372-1706c7a6dc30"] [:db/ensure "8d2b819b-ae02-5b15-948d-31abbce117fc" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "8d2b819b-ae02-5b15-948d-31abbce117fc"] [:db/ensure 17592186096653 :knowledge-point/validate]]
