the path $O\\to P\\to E$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OE}&=\\overrightarrow{OP}+\\overrightarrow{PE}\\\\&=k+\\frac{10}{19}(-k+d)\\\\&=\\frac{9}{19}k+\\frac{10}{19}d.\\end{aligned}\n$$"] [:db/add "4adbc1b9-3b50-5121-80ab-ecb2db12fe3c" :question/difficulty :question.difficulty/moderate] [:db/add "4adbc1b9-3b50-5121-80ab-ecb2db12fe3c" :question/answer-fields "21602433-68c0-53d7-96a9-c0159b2cb76e"] [:db/ensure "4adbc1b9-3b50-5121-80ab-ecb2db12fe3c" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "4adbc1b9-3b50-5121-80ab-ecb2db12fe3c"] [:db/add "d2856112-3d1a-57d6-92cc-ce07d213c37d" :answer/id #uuid "d2856112-3d1a-57d6-92cc-ce07d213c37d"] [:db/add "d2856112-3d1a-57d6-92cc-ce07d213c37d" :answer/type :answer.type/math] [:db/add "d2856112-3d1a-57d6-92cc-ce07d213c37d" :answer/value "\\frac{12}{23}"] [:db/ensure "d2856112-3d1a-57d6-92cc-ce07d213c37d" :answer/validate] [:db/add "668cb9cb-422c-5663-acd8-d1b2c3df7c83" :answer-field/id #uuid "668cb9cb-422c-5663-acd8-d1b2c3df7c83"] [:db/add "668cb9cb-422c-5663-acd8-d1b2c3df7c83" :answer-field/key "field-1"] [:db/add "668cb9cb-422c-5663-acd8-d1b2c3df7c83" :answer-field/type :answer-field.type/blank] [:db/add "668cb9cb-422c-5663-acd8-d1b2c3df7c83" :answer-field/choices "d2856112-3d1a-57d6-92cc-ce07d213c37d"] [:db/add "668cb9cb-422c-5663-acd8-d1b2c3df7c83" :answer-field/correct "d2856112-3d1a-57d6-92cc-ce07d213c37d"] [:db/ensure "668cb9cb-422c-5663-acd8-d1b2c3df7c83" :answer-field/validate] [:db/add "9fa54458-955c-55bc-970c-46365255ed10" :answer/id #uuid "9fa54458-955c-55bc-970c-46365255ed10"] [:db/add "9fa54458-955c-55bc-970c-46365255ed10" :answer/type :answer.type/math] [:db/add "9fa54458-955c-55bc-970c-46365255ed10" :answer/value "\\frac{11}{23}"] [:db/ensure "9fa54458-955c-55bc-970c-46365255ed10" :answer/validate] [:db/add "e8ccd2cf-3cca-585e-8627-ec6e02ddbead" :answer-field/id #uuid "e8ccd2cf-3cca-585e-8627-ec6e02ddbead"] [:db/add "e8ccd2cf-3cca-585e-8627-ec6e02ddbead" 