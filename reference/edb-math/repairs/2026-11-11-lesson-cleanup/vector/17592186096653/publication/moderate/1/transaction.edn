b0089003" :answer-field/key "selection"] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/type :answer-field.type/radio] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/choices "b5085c6a-5c9e-5f2f-976f-3061ff450660"] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/choices "cd81ea85-1976-5d41-8197-03090a414dca"] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/choices "6801c8bc-d3dd-5a52-9541-41930f95e453"] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/choices "0965c45b-9d13-5fd5-8a32-fd748fa18cf2"] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/choices "f283b3de-f090-5ae6-a328-23938b470e0f"] [:db/add "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/correct "cd81ea85-1976-5d41-8197-03090a414dca"] [:db/ensure "0f70e424-94d7-5005-8e38-d239b0089003" :answer-field/validate] [:db/add "a1cb4fde-c42a-5e61-ba0e-1332ece6699f" :question/id #uuid "a1cb4fde-c42a-5e61-ba0e-1332ece6699f"] [:db/add "a1cb4fde-c42a-5e61-ba0e-1332ece6699f" :question/problem "![](images/c4/c4b26c7ea6f872ba0a21b2950ace0aa467fd630c52c302bd0017bcedaadee5b2.png)\n\nIn the diagram, $Z$ lies on the segment $GN$. The given vectors are $\\overrightarrow{OG}=h$ and $\\overrightarrow{ON}=d$. The lengths satisfy $GZ:ZN=5:7$.\n\nExpress $\\overrightarrow{OZ}$ in terms of $h$ and $d$."] [:db/add "a1cb4fde-c42a-5e61-ba0e-1332ece6699f" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OG}=h\\qquad \\overrightarrow{ON}=d .\n$$\n\nTrace the path from $G$ through $O$ to $N$:\n\n$$\n\\overrightarrow{GN}=\\overrightarrow{GO}+\\overrightarrow{ON}=-h+d.\n$$\n\nThe ratio $GZ:ZN=5:7$ gives $12$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{GZ}=\\frac{5}{12}\\overrightarrow{GN}=\\frac{5}{12}(-h+d).\n$$\n\nAdd along the path $O\\to G\\to Z$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OZ}&=\\overrightarrow{OG}+\\overrightarrow{GZ}\\\\&=h+\\frac{5}{12}(-h+d)\\\\&=\\frac{7}{12}h+\\frac{5}{12}d.\\end{aligned}\n$$"] [:db/add "a1cb4fde-c42a-5e61-ba0e-1332ece6699f" :question/difficulty :question.difficulty/moderate] [:db/add "a1cb4fde-c42a-5e61-ba0e-1332ece6699f" :question/answer-fields "0f70e424-94d7-5005-8e38-d239b0089003"] [:db/ensure "a1cb4fde-c42a-5e61-ba0e-1332ece6699f" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "a1cb4fde-c42a-5e61-ba0e-1332ece6699f"] [:db/add "4bd2a1b6-9e6d-515f-b078-56c4b6947646" :answer/id #uuid "4bd2a1b6-9e6d-515f-b078-56c4b6947646"] [:db/add "4bd2a1b6-9e6d-515f-b078-56c4b6947646" :answer/type :answer.type/math] [:db/add "4bd2a1b6-9e6d-515f-b078-56c4b6947646" :answer/value "\\overrightarrow{OV}=\\frac{3}{10}n+\\frac{7}{10}g"] [:db/ensure "4bd2a1b6-9e6d-515f-b078-56c4b6947646" :answer/validate] [:db/add "9545aff0-2a1e-557c-8acb-fdba7d67ca34" :answer/id #uuid "9545aff0-2a1e-557c-8acb-fdba7d67ca34"] [:db/add "9545aff0-2a1e-557c-8acb-fdba7d67ca34" :answer/type :answer.type/math] [:db/add "9545aff0-2a1e-557c-8acb-fdba7d67ca34" :answer/value "\\overrightarrow{OV}=\\frac{7}{13}n+\\frac{6}{13}g"] [:db/ensure "9545aff0-2a1e-557c-8acb-fdba7d67ca34" :answer/validate] [:db/add "483ab8c7-aebd-5f8b-9a24-0439d63aa76a" :answer/id #uuid "483ab8c7-aebd-5f8b-9a24-0439d63aa76a"] [:db/add "483ab8c7-aebd-5f8b-9a24-0439d63aa76a" :answer/type :answer.type/math] [:db/add "483ab8c7-aebd-5f8b-9a24-0439d63aa76a" :answer/value "\\overrightarrow{OV}=\\frac{6}{13}n+\\frac{7}{13}g"] [:db/ensure "483ab8c7-aebd-5f8b-9a24-0439d63aa76a" :answer/validate] [:db/add "909171a2-4d9f-50d8-a342-755b5502cf5f" :answer/id #uuid "909171a2-4d9f-50d8-a342-755b5502cf5f"] [:db/add "909171a2-4d9f-50d8-a342-755b5502cf5f" :answer/type :answer.type/math] [:db/add "909171a2-4d9f-50d8-a342-755b5502cf5f" :answer/value "\\overrightarrow{OV}=\\frac{7}{10}n+\\frac{3}{10}g"] [:db/ensure "909171a2-4d9f-50d8-a342-755b5502cf5f" :answer/validate] [:db/add "551a006e-872b-594f-86a8-03d6d5e006e4" :answer/id #uuid "551a006e-872b-594f-86a8-03d6d5e006e4"] [:db/add "551a006e-872b-594f-86a8-03d6d5e006e4" :answer/type :answer.type/math] [:db/add "551a006e-872b-594f-86a8-03d6d5e006e4" :answer/value "\\overrightarrow{OV}=\\frac{1}{2}n+\\frac{1}{2}g"] [:db/ensure "551a006e-872b-594f-86a8-03d6d5e006e4" :answer/validate] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/id #uuid "0d0e7d6e-2c89-566a-aeb7-61a533ab285f"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/key "selection"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/type :answer-field.type/radio] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/choices "4bd2a1b6-9e6d-515f-b078-56c4b6947646"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/choices "9545aff0-2a1e-557c-8acb-fdba7d67ca34"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/choices "483ab8c7-aebd-5f8b-9a24-0439d63aa76a"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/choices "909171a2-4d9f-50d8-a342-755b5502cf5f"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/choices "551a006e-872b-594f-86a8-03d6d5e006e4"] [:db/add "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/correct "4bd2a1b6-9e6d-515f-b078-56c4b6947646"] [:db/ensure "0d0e7d6e-2c89-566a-aeb7-61a533ab285f" :answer-field/validate] [:db/add "4680d3f7-13c1-59ac-81f1-9cc1c480b8af" :question/id #uuid "4680d3f7-13c1-59ac-81f1-9cc1c480b8af"] [:db/add "4680d3f7-13c1-59ac-81f1-9cc1c480b8af" :question/problem "![](images/c2/c228916ab39da6264c51b6c9a08789cfd1f4580ac2774913fce04834024ac421.png)\n\nIn the diagram, $V$ lies on the segment $AD$. The given vectors are $\\overrightarrow{OA}=n$ and $\\overrightarrow{OD}=g$. The lengths satisfy $AV:VD=7:3$.\n\nExpress $\\overrightarrow{OV}$ in terms of $n$ and $g$."] [:db/add "4680d3f7-13c1-59ac-81f1-9cc1c480b8af" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OA}=n\\qquad \\overrightarrow{OD}=g .\n$$\n\nTrace the path from $A$ through $O$ to $D$:\n\n$$\n\\overrightarrow{AD}=\\overrightarrow{AO}+\\overrightarrow{OD}=-n+g.\n$$\n\nThe ratio $AV:VD=7:3$ gives $10$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{AV}=\\frac{7}{10}\\overrightarrow{AD}=\\frac{7}{10}(-n+g).\n$$\n\nAdd along the path $O\\to A\\to V$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OV}&=\\overrightarrow{OA}+\\overrightarrow{AV}\\\\&=n+\\frac{7}{10}(-n+g)\\\\&=\\frac{3}{10}n+\\frac{7}{10}g.\\end{aligned}\n$$"] [:db/add "4680d3f7-13c1-59ac-81f1-9cc1c480b8af" :question/difficulty :question.difficulty/moderate] [:db/add "4680d3f7-13c1-59ac-81f1-9cc1c480b8af" :question/answer-fields "0d0e7d6e-2c89-566a-aeb7-61a533ab285f"] [:db/ensure "4680d3f7-13c1-59ac-81f1-9cc1c480b8af" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "4680d3f7-13c1-59ac-81f1-9cc1c480b8af"] [:db/add "12972cec-03a7-5b75-bb19-6b3f6ac68fc0" :answer/id #uuid "12972cec-03a7-5b75-bb19-6b3f6ac68fc0"] [:db/add "12972cec-03a7-5b75-bb19-6b3f6ac68fc0" :answer/type :answer.type/math] [:db/add "12972cec-03a7-5b75-bb19-6b3f6ac68fc0" :answer/value "\\frac{2}{13}"] [:db/ensure "12972cec-03a7-5b75-bb19-6b3f6ac68fc0" :answer/validate] [:db/add "7c0c00a7-7d53-592a-a093-646c47fc72f8" :answer-field/id #uuid "7c0c00a7-7d53-592a-a093-646c47fc72f8"] [:db/add "7c0c00a7-7d53-592a-a093-646c47fc72f8" :answer-field/key "field-1"] [:db/add "7c0c00a7-7d53-592a-a093-646c47fc72f8" :answer-field/type :answer-field.type/blank] [:db/add "7c0c00a7-7d53-592a-a093-646c47fc72f8" :answer-field/choices "12972cec-03a7-5b75-bb19-6b3f6ac68fc0"] [:db/add "7c0c00a7-7d53-592a-a093-646c47fc72f8" :answer-field/correct "12972cec-03a7-5b75-bb19-6b3f6ac68fc0"] [:db/ensure "7c0c00a7-7d53-592a-a093-646c47fc72f8" :answer-field/validate] [:db/add "2b3d364a-2594-5022-835f-62a24b50eec6" :answer/id #uuid "2b3d364a-2594-5022-835f-62a24b50eec6"] [:db/add "2b3d364a-2594-5022-835f-62a24b50eec6" :answer/type :answer.type/math] [:db/add "2b3d364a-2594-5022-835f-62a24b50eec6" :answer/value "\\frac{11}{13}"] [:db/ensure "2b3d364a-2594-5022-835f-62a24b50eec6" :answer/validate] [:db/add "76739498-68c5-58f2-8e95-bd2be5774dad" :answer-field/id #uuid "76739498-68c5-58f2-8e95-bd2be5774dad"] [:db/add "76739498-68c5-58f2-8e95-bd2be5774dad" :answer-field/key "field-2"] [:db/add "76739498-68c5-58f2-8e95-bd2be5774dad" :answer-field/type :answer-field.type/blank] [:db/add "76739498-68c5-58f2-8e95-bd2be5774dad" :answer-field/choices "2b3d364a-2594-5022-835f-62a24b50eec6"] [:db/add "76739498-68c5-58f2-8e95-bd2be5774dad" :answer-field/correct "2b3d364a-2594-5022-835f-62a24b50eec6"] [:db/ensure "76739498-68c5-58f2-8e95-bd2be5774dad" :answer-field/validate] [:db/add "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/id #uuid "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86"] [:db/add "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/problem "![](images/f1/f1d3556f09bff6ca1ae516c7b0d8890dedbbfd23070493bf748e4a875bdff30f.png)\n\nIn the diagram, $F$ lies on the segment $XJ$. The given vectors are $\\overrightarrow{OX}=r$ and $\\overrightarrow{OJ}=c$. The lengths satisfy $XF:FJ=11:2$.\n\nExpress $\\overrightarrow{OF}$ in terms of $r$ and $c$. Fill in both coefficients, including their signs.\n\n$\\overrightarrow{OF}=$ {{field-1}} $r+$ {{field-2}} $c$"] [:db/add "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OX}=r\\qquad \\overrightarrow{OJ}=c .\n$$\n\nTrace the path from $X$ through $O$ to $J$:\n\n$$\n\\overrightarrow{XJ}=\\overrightarrow{XO}+\\overrightarrow{OJ}=-r+c.\n$$\n\nThe ratio $XF:FJ=11:2$ gives $13$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{XF}=\\frac{11}{13}\\overrightarrow{XJ}=\\frac{11}{13}(-r+c).\n$$\n\nAdd along the path $O\\to X\\to F$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OF}&=\\overrightarrow{OX}+\\overrightarrow{XF}\\\\&=r+\\frac{11}{13}(-r+c)\\\\&=\\frac{2}{13}r+\\frac{11}{13}c.\\end{aligned}\n$$"] [:db/add "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/difficulty :question.difficulty/moderate] [:db/add "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/answer-fields "7c0c00a7-7d53-592a-a093-646c47fc72f8"] [:db/add "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/answer-fields "76739498-68c5-58f2-8e95-bd2be5774dad"] [:db/ensure "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "5333224f-f7f0-5f6e-a2a1-2a7ed0c40b86"] [:db/add "f05f0c00-0e13-51c8-b35e-d4eefcd64210" :answer/id #uuid "f05f0c00-0e13-51c8-b35e-d4eefcd64210"] [:db/add "f05f0c00-0e13-51c8-b35e-d4eefcd64210" :answer/type :answer.type/math] [:db/add "f05f0c00-0e13-51c8-b35e-d4eefcd64210" :answer/value "\\frac{11}{18}"] [:db/ensure "f05f0c00-0e13-51c8-b35e-d4eefcd64210" :answer/validate] [:db/add "0fec72ba-ac0b-5574-9ff5-21390142a46c" :answer-field/id #uuid "0fec72ba-ac0b-5574-9ff5-21390142a46c"] [:db/add "0fec72ba-ac0b-5574-9ff5-21390142a46c" :answer-field/key "field-1"] [:db/add "0fec72ba-ac0b-5574-9ff5-21390142a46c" :answer-field/type :answer-field.type/blank] [:db/add "0fec72ba-ac0b-5574-9ff5-21390142a46c" :answer-field/choices "f05f0c00-0e13-51c8-b35e-d4eefcd64210"] [:db/add "0fec72ba-ac0b-5574-9ff5-21390142a46c" :answer-field/correct "f05f0c00-0e13-51c8-b35e-d4eefcd64210"] [:db/ensure "0fec72ba-ac0b-5574-9ff5-21390142a46c" :answer-field/validate] [:db/add "311dd228-0f1b-5127-a92a-b7749f0d9b8e" :answer/id #uuid "311dd228-0f1b-5127-a92a-b7749f0d9b8e"] [:db/add "311dd228-0f1b-5127-a92a-b7749f0d9b8e" :answer/type :answer.type/math] [:db/add "311dd228-0f1b-5127-a92a-b7749f0d9b8e" :answer/value "\\frac{7}{18}"] [:db/ensure "311dd228-0f1b-5127-a92a-b7749f0d9b8e" :answer/validate] [:db/add "23634226-30ae-5913-ad11-6345c4590760" :answer-field/id #uuid "23634226-30ae-5913-ad11-6345c4590760"] [:db/add "23634226-30ae-5913-ad11-6345c4590760" :answer-field/key "field-2"] [:db/add "23634226-30ae-5913-ad11-6345c4590760" :answer-field/type :answer-field.type/blank] [:db/add "23634226-30ae-5913-ad11-6345c4590760" :answer-field/choices "311dd228-0f1b-5127-a92a-b7749f0d9b8e"] [:db/add "23634226-30ae-5913-ad11-6345c4590760" :answer-field/correct "311dd228-0f1b-5127-a92a-b7749f0d9b8e"] [:db/ensure "23634226-30ae-5913-ad11-6345c4590760" :answer-field/validate] [:db/add "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/id #uuid "23f7041f-625a-5ea5-b5b4-5f5994fbb56f"] [:db/add "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/problem "![](images/37/378ce9fe3c66837b21bf33004cb9c7c64ef53242721bac8204d11745839ff2e3.png)\n\nIn the diagram, $Y$ lies on the segment $KH$. The given vectors are $\\overrightarrow{OK}=e$ and $\\overrightarrow{OH}=a$. The lengths satisfy $KY:YH=7:11$.\n\nExpress $\\overrightarrow{OY}$ in terms of $e$ and $a$. Fill in both coefficients, including their signs.\n\n$\\overrightarrow{OY}=$ {{field-1}} $e+$ {{field-2}} $a$"] [:db/add "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/worked-solution "First express both endpoint vectors in the directions away from $O$:\n\n$$\n\\overrightarrow{OK}=e\\qquad \\overrightarrow{OH}=a .\n$$\n\nTrace the path from $K$ through $O$ to $H$:\n\n$$\n\\overrightarrow{KH}=\\overrightarrow{KO}+\\overrightarrow{OH}=-e+a.\n$$\n\nThe ratio $KY:YH=7:11$ gives $18$ parts in the whole segment. Thus\n\n$$\n\\overrightarrow{KY}=\\frac{7}{18}\\overrightarrow{KH}=\\frac{7}{18}(-e+a).\n$$\n\nAdd along the path $O\\to K\\to Y$ and collect coefficients:\n\n$$\n\\begin{aligned}\\overrightarrow{OY}&=\\overrightarrow{OK}+\\overrightarrow{KY}\\\\&=e+\\frac{7}{18}(-e+a)\\\\&=\\frac{11}{18}e+\\frac{7}{18}a.\\end{aligned}\n$$"] [:db/add "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/difficulty :question.difficulty/moderate] [:db/add "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/answer-fields "0fec72ba-ac0b-5574-9ff5-21390142a46c"] [:db/add "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/answer-fields "23634226-30ae-5913-ad11-6345c4590760"] [:db/ensure "23f7041f-625a-5ea5-b5b4-5f5994fbb56f" :question/validate] [:db/add 17592186096653 :knowledge-point/questions "23f7041f-625a-5ea5-b5b4-5f5994fbb56f"] [:db/add "22823fb0-35b2-5ab3-a7dc-9a1600cf094b" :answer/id #uuid "22823fb0-35b2-5ab3-a7dc-9a1600cf094b"] [:db/add "22823fb0-35b2-5ab3-a7dc-9a1600cf094b" :answer/type :answer.type/math] [:db/add "22823fb0-35b2-5ab3-a7dc-9a1600cf094b" :answer/value "\\overrightarrow{OE}=\\frac{10}{19}k+\\frac{9}{19}d"] [:db/ensure "22823fb0-35b2-5ab3-a7dc-9a1600cf094b" :answer/validate] [:db/add "1b13c8df-4388-5bc5-bd94-949a29fd3150" :answer/id #uuid "1b13c8df-4388-5bc5-bd94-949a29fd3150"] [:db/add "1b13c8df-4388-5bc5-bd94-949a29fd3150" :answer/type :answer.type/math] [:db/add "1b13c8df-4388-5bc5-bd94-949a29fd3150" :answer/value "\\overrightarrow{OE}=\\frac{1}{2}k+\\frac{1}{2}d"] [:db/ensure "1b13c8df-4388-5bc5-bd94-949a29fd3150" :answer/validate] [:db/add "95e1b8f1-db79-567c-98bb-84ec54a78f8a" :answer/id #uuid "95e1b8f1-db79-567c-98bb-84ec54a78f8a"] [:db/add "95e1b8f1-db79-567c-98bb-84ec54a78f8a" :answer/type :answer.type/math] [:db/add "95e1b8f1-db79-567c-98bb-84ec54a78f8a" :answer/value "\\overrightarrow{OE}=\\frac{9}{29}k+\\frac{20}{29}d"] [:db/ensure "95e1b8f1-db79-567c-98bb-84ec54a78f8a" :answer/validate] [:db/add "0607fc8c-9d62-5d42-bb6d-50e8e766344e" :answer/id #uuid "0607fc8c-9d62-5d42-bb6d-50e8e766344e"] [:db/add "0607fc8c-9d62-5d42-bb6d-50e8e766344e" :answer/type :answer.type/math] [:db/add "0607fc8c-9d62-5d42-bb6d-50e8e766344e" :answer/value "\\overrightarrow{OE}=\\frac{20}{29}k+\\frac{9}{29}d"] [:db/ensure "0607fc8c-9d62-5d42-bb6d-50e8e766344e" :answer/validate] [:db/add "ee0aea77-07ac-5b38-819d-f464dcb1fc33" :answer/id #uuid "ee0aea77-07ac-5b38-819d-f464dcb1fc33"] [:db/add "ee0aea77-07ac-5b38-819d-f464dcb1fc33" :answer/type :answer.type/math] [:db/add "ee0aea77-07ac-5b38-819d-f464dcb1fc33" :answer/value "\\overrightarrow{OE}=\\frac{9}{19}k+\\frac{10}{19}d"] [:db/ensure "ee0aea77-07ac-5b38-819d-f464dcb1fc33" :answer/validate] [:db/a