                ":db/ident": ":answer.type/math"
              },
              ":answer/value": "\\frac{1}{4}",
              ":db/id": 17592186572420
            }
          ],
          ":answer-field/correct": {
            ":answer/id": "57534557-824c-57ce-9724-420aeeed76a9",
            ":answer/type": {
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "\\frac{1}{4}",
            ":db/id": 17592186572420
          },
          ":answer-field/id": "f419c0b9-3927-593f-9535-801465b684b3",
          ":answer-field/key": "field-1",
