              ":answer/value": "1/2",
              ":db/id": 17592186300196
            }
          ],
          ":answer-field/correct": {
            ":answer/id": "30a0045e-f1f3-57fa-89c6-bd1617062077",
            ":answer/type": {
              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "1/2",
            ":db/id": 17592186300196
          },
          ":answer-field/id": "a550aade-6952-55e1-9a53-4cfddf1f7e28",
          ":answer-field/key": "field-1",
          ":answer-field/type": {
            ":db/ident": ":answer-field.type/blank"
