7-4ab1-50cf-9751-5854ed0fdb85"] [:db/add "3663df30-f30d-57dd-b20a-07eb48196938" :answer-field/choices "14cf3cf5-e429-5e27-afeb-ef769a0e90e1"] [:db/add "3663df30-f30d-57dd-b20a-07eb48196938" :answer-field/choices "a909fe44-3ee7-597c-bea5-069fc1654d07"] [:db/add "3663df30-f30d-57dd-b20a-07eb48196938" :answer-field/choices "fb438f64-6546-5a16-a63a-e204c2c6f524"] [:db/add "3663df30-f30d-57dd-b20a-07eb48196938" :answer-field/choices "0dd9e88f-de27-50d2-9e41-9612615d0234"] [:db/add "3663df30-f30d-57dd-b20a-07eb48196938" :answer-field/correct "0dd9e88f-de27-50d2-9e41-9612615d0234"] [:db/ensure "3663df30-f30d-57dd-b20a-07eb48196938" :answer-field/validate] [:db/add "9b15d2db-74b7-566c-87ae-209f31ab7471" :question/id #uuid "9b15d2db-74b7-566c-87ae-209f31ab7471"] [:db/add "9b15d2db-74b7-566c-87ae-209f31ab7471" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/2d/2d883d44781fdfc6c31cdcce5043c889cfafe68b9772cf2d2cf66a308480e4d2.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+\\mathbf{b}$, find $\\lambda$."] [:db/add "9b15d2db-74b7-566c-87ae-209f31ab7471" :question/worked-solution "Construct the known component $\\mathbf{b}$ from $O$, ending at $B$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OB} &=1\\,(0, 2)=(0, 2). \\\\\n\\overrightarrow{BC} &=(4, 0).\n\\end{aligned}\n$$\n\n![](images/ee/ee57e8d5e74994866b908473fab76bb7bb666a1595ebea04cf8f879a1770f3db.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(2, 0)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{4}{2}=2\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{BC}=2\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OB}+\\overrightarrow{BC} \\\\\n&=\\mathbf{b}+2\\mathbf{a} \\\\\n&=2\\mathbf{a}+\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=2$."] [:db/add "9b15d2db-74b7-566c-87ae-209f31ab7471" :question/difficulty :question.difficulty/easy] [:db/add "9b15d2db-74b7-566c-87ae-209f31ab7471" :question/answer-fields "3663df30-f30d-57dd-b20a-07eb48196938"] [:db/ensure "9b15d2db-74b7-566c-87ae-209f31ab7471" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "9b15d2db-74b7-566c-87ae-209f31ab7471"] [:db/add "b7e7ada5-3193-5a86-af93-d1f59c93be6f" :answer/id #uuid "b7e7ada5-3193-5a86-af93-d1f59c93be6f"] [:db/add "b7e7ada5-3193-5a86-af93-d1f59c93be6f" :answer/type :answer.type/math] [:db/add "b7e7ada5-3193-5a86-af93-d1f59c93be6f" :answer/value "2"] [:db/ensure "b7e7ada5-3193-5a86-af93-d1f59c93be6f" :answer/validate] [:db/add "cf50ea37-2fe9-5a20-9d54-836819fff919" :answer/id #uuid "cf50ea37-2fe9-5a20-9d54-836819fff919"] [:db/add "cf50ea37-2fe9-5a20-9d54-836819fff919" :answer/type :answer.type/math] [:db/add "cf50ea37-2fe9-5a20-9d54-836819fff919" :answer/value "3"] [:db/ensure "cf50ea37-2fe9-5a20-9d54-836819fff919" :answer/validate] [:db/add "9172bb0e-8609-5e15-bc30-d54a75a52740" :answer/id #uuid "9172bb0e-8609-5e15-bc30-d54a75a52740"] [:db/add "9172bb0e-8609-5e15-bc30-d54a75a52740" :answer/type :answer.type/math] [:db/add "9172bb0e-8609-5e15-bc30-d54a75a52740" :answer/value "\\frac{5}{2}"] [:db/ensure "9172bb0e-8609-5e15-bc30-d54a75a52740" :answer/validate] [:db/add "3e32ab3c-2751-5c26-a0ed-defa0e27bbdc" :answer/id #uuid "3e32ab3c-2751-5c26-a0ed-defa0e27bbdc"] [:db/add "3e32ab3c-2751-5c26-a0ed-defa0e27bbdc" :answer/type :answer.type/math] [:db/add "3e32ab3c-2751-5c26-a0ed-defa0e27bbdc" :answer/value "1"] [:db/ensure "3e32ab3c-2751-5c26-a0ed-defa0e27bbdc" :answer/validate] [:db/add "b576d007-8190-51e3-b571-b61a42d3524a" :answer/id #uuid "b576d007-8190-51e3-b571-b61a42d3524a"] [:db/add "b576d007-8190-51e3-b571-b61a42d3524a" :answer/type :answer.type/math] [:db/add "b576d007-8190-51e3-b571-b61a42d3524a" :answer/value "\\frac{3}{2}"] [:db/ensure "b576d007-8190-51e3-b571-b61a42d3524a" :answer/validate] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/id #uuid "b6cfc7bc-4a97-58e8-82a3-69441afcae94"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/key "selection"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/type :answer-field.type/radio] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/choices "b7e7ada5-3193-5a86-af93-d1f59c93be6f"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/choices "cf50ea37-2fe9-5a20-9d54-836819fff919"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/choices "9172bb0e-8609-5e15-bc30-d54a75a52740"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/choices "3e32ab3c-2751-5c26-a0ed-defa0e27bbdc"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/choices "b576d007-8190-51e3-b571-b61a42d3524a"] [:db/add "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/correct "9172bb0e-8609-5e15-bc30-d54a75a52740"] [:db/ensure "b6cfc7bc-4a97-58e8-82a3-69441afcae94" :answer-field/validate] [:db/add "179bf212-0bfb-539a-ad37-65e12d98e79f" :question/id #uuid "179bf212-0bfb-539a-ad37-65e12d98e79f"] [:db/add "179bf212-0bfb-539a-ad37-65e12d98e79f" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/45/450bbc1c472dd6a5f2189bbc1954beb04aa29a2520947ec1a4e3c14a6133103c.png)\n\nGiven that $\\mathbf{c}=\\mathbf{a}+\\lambda\\mathbf{b}$, find $\\lambda$."] [:db/add "179bf212-0bfb-539a-ad37-65e12d98e79f" :question/worked-solution "Construct the known component $\\mathbf{a}$ from $O$, ending at $A$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OA} &=1\\,(0, -5)=(0, -5). \\\\\n\\overrightarrow{AC} &=(10, 0).\n\\end{aligned}\n$$\n\n![](images/c5/c51cfbbc29a6d168dbc17af3246d3a21ff7d9933884d0fe244e2823f6501f555.png)\n\nCompare the remaining displacement with $\\mathbf{b}$, whose grid displacement is $(4, 0)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{10}{4}=\\frac{5}{2}\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{b}$. Thus $\\overrightarrow{AC}=\\frac{5}{2}\\mathbf{b}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OA}+\\overrightarrow{AC} \\\\\n&=\\mathbf{a}+\\frac{5}{2}\\mathbf{b} \\\\\n&=\\mathbf{a}+\\frac{5}{2}\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{b}$ gives $\\lambda=\\frac{5}{2}$."] [:db/add "179bf212-0bfb-539a-ad37-65e12d98e79f" :question/difficulty :question.difficulty/easy] [:db/add "179bf212-0bfb-539a-ad37-65e12d98e79f" :question/answer-fields "b6cfc7bc-4a97-58e8-82a3-69441afcae94"] [:db/ensure "179bf212-0bfb-539a-ad37-65e12d98e79f" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "179bf212-0bfb-539a-ad37-65e12d98e79f"] [:db/add "3abc1122-ac33-5363-a4a7-c492caa7718e" :answer/id #uuid "3abc1122-ac33-5363-a4a7-c492caa7718e"] [:db/add "3abc1122-ac33-5363-a4a7-c492caa7718e" :answer/type :answer.type/math] [:db/add "3abc1122-ac33-5363-a4a7-c492caa7718e" :answer/value "\\frac{7}{2}"] [:db/ensure "3abc1122-ac33-5363-a4a7-c492caa7718e" :answer/validate] [:db/add "1efb5c11-7107-5152-b142-4077afc16f07" :answer/id #uuid "1efb5c11-7107-5152-b142-4077afc16f07"] [:db/add "1efb5c11-7107-5152-b142-4077afc16f07" :answer/type :answer.type/math] [:db/add "1efb5c11-7107-5152-b142-4077afc16f07" :answer/value "3"] [:db/ensure "1efb5c11-7107-5152-b142-4077afc16f07" :answer/validate] [:db/add "762926f3-f449-522e-901d-413da5cc5786" :answer/id #uuid "762926f3-f449-522e-901d-413da5cc5786"] [:db/add "762926f3-f449-522e-901d-413da5cc5786" :answer/type :answer.type/math] [:db/add "762926f3-f449-522e-901d-413da5cc5786" :answer/value "\\frac{5}{2}"] [:db/ensure "762926f3-f449-522e-901d-413da5cc5786" :answer/validate] [:db/add "bb27f7b5-9b0d-59e4-8c9e-bef57dbc9bca" :answer/id #uuid "bb27f7b5-9b0d-59e4-8c9e-bef57dbc9bca"] [:db/add "bb27f7b5-9b0d-59e4-8c9e-bef57dbc9bca" :answer/type :answer.type/math] [:db/add "bb27f7b5-9b0d-59e4-8c9e-bef57dbc9bca" :answer/value "2"] [:db/ensure "bb27f7b5-9b0d-59e4-8c9e-bef57dbc9bca" :answer/validate] [:db/add "5ae4dfde-b32a-5ba5-9159-26ce9d1ca567" :answer/id #uuid "5ae4dfde-b32a-5ba5-9159-26ce9d1ca567"] [:db/add "5ae4dfde-b32a-5ba5-9159-26ce9d1ca567" :answer/type :answer.type/math] [:db/add "5ae4dfde-b32a-5ba5-9159-26ce9d1ca567" :answer/value "\\frac{3}{2}"] [:db/ensure "5ae4dfde-b32a-5ba5-9159-26ce9d1ca567" :answer/validate] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/id #uuid "73f646d1-b618-5bb0-97e8-11ab810321f2"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/key "selection"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/type :answer-field.type/radio] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/choices "3abc1122-ac33-5363-a4a7-c492caa7718e"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/choices "1efb5c11-7107-5152-b142-4077afc16f07"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/choices "762926f3-f449-522e-901d-413da5cc5786"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/choices "bb27f7b5-9b0d-59e4-8c9e-bef57dbc9bca"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/choices "5ae4dfde-b32a-5ba5-9159-26ce9d1ca567"] [:db/add "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/correct "3abc1122-ac33-5363-a4a7-c492caa7718e"] [:db/ensure "73f646d1-b618-5bb0-97e8-11ab810321f2" :answer-field/validate] [:db/add "7ce064d7-f1b5-56fa-99ca-503943a7ce4e" :question/id #uuid "7ce064d7-f1b5-56fa-99ca-503943a7ce4e"] [:db/add "7ce064d7-f1b5-56fa-99ca-503943a7ce4e" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/82/8268d901267c0b135ea130106be9b0b62044ff0ce38607ae3fbd1098dad20635.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+\\mathbf{b}$, find $\\lambda$."] [:db/add "7ce064d7-f1b5-56fa-99ca-503943a7ce4e" :question/worked-solution "Construct the known component $\\mathbf{b}$ from $O$, ending at $B$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OB} &=1\\,(2, 0)=(2, 0). \\\\\n\\overrightarrow{BC} &=(0, -7).\n\\end{aligned}\n$$\n\n![](images/08/08514ab2b05886b357479ba094fe3eac737c6dac49717d9c9b2e15be8846dcd8.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(0, -2)$:\n\n$$\n\\begin{aligned}\n\\text{Vertical scale} &=\\frac{-7}{-2}=\\frac{7}{2}\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{BC}=\\frac{7}{2}\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OB}+\\overrightarrow{BC} \\\\\n&=\\mathbf{b}+\\frac{7}{2}\\mathbf{a} \\\\\n&=\\frac{7}{2}\\mathbf{a}+\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=\\frac{7}{2}$."] [:db/add "7ce064d7-f1b5-56fa-99ca-503943a7ce4e" :question/difficulty :question.difficulty/easy] [:db/add "7ce064d7-f1b5-56fa-99ca-503943a7ce4e" :question/answer-fields "73f646d1-b618-5bb0-97e8-11ab810321f2"] [:db/ensure "7ce064d7-f1b5-56fa-99ca-503943a7ce4e" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "7ce064d7-f1b5-56fa-99ca-503943a7ce4e"] [:db/add "2a4e045a-bebb-57ef-85b0-3d7713f9e677" :answer/id #uuid "2a4e045a-bebb-57ef-85b0-3d7713f9e677"] [:db/add "2a4e045a-bebb-57ef-85b0-3d7713f9e677" :answer/type :answer.type/math] [:db/add "2a4e045a-bebb-57ef-85b0-3d7713f9e677" :answer/value "\\frac{1}{2}"] [:db/ensure "2a4e045a-bebb-57ef-85b0-3d7713f9e677" :answer/validate] [:db/add "b04668b2-e8cc-57e5-a17f-bb56a12ad96d" :answer-field/id #uuid "b04668b2-e8cc-57e5-a17f-bb56a12ad96d"] [:db/add "b04668b2-e8cc-57e5-a17f-bb56a12ad96d" :answer-field/key "field-1"] [:db/add "b04668b2-e8cc-57e5-a17f-bb56a12ad96d" :answer-field/type :answer-field.type/blank] [:db/add "b04668b2-e8cc-57e5-a17f-bb56a12ad96d" :answer-field/choices "2a4e045a-bebb-57ef-85b0-3d7713f9e677"] [:db/add "b04668b2-e8cc-57e5-a17f-bb56a12ad96d" :answer-field/correct "2a4e045a-bebb-57ef-85b0-3d7713f9e677"] [:db/ensure "b04668b2-e8cc-57e5-a17f-bb56a12ad96d" :answer-field/validate] [:db/add "31fe6aa1-ed1c-5040-a39d-dbc385628868" :question/id #uuid "31fe6aa1-ed1c-5040-a39d-dbc385628868"] [:db/add "31fe6aa1-ed1c-5040-a39d-dbc385628868" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/e6/e639cf6dcd4133ab8c3f858621c4c02c4018a56ec8430efcbd592b10d6b20eac.png)\n\nGiven that $\\mathbf{c}=\\mathbf{a}+\\lambda\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}."] [:db/add "31fe6aa1-ed1c-5040-a39d-dbc385628868" :question/worked-solution "Construct the known component $\\mathbf{a}$ from $O$, ending at $A$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OA} &=1\\,(2, 0)=(2, 0). \\\\\n\\overrightarrow{AC} &=(0, -2).\n\\end{aligned}\n$$\n\n![](images/c6/c63704ec4b7fbd93dc0d104d08bf906cb9d278e66afb0fc3568932b11cd0aaee.png)\n\nCompare the remaining displacement with $\\mathbf{b}$, whose grid displacement is $(0, -4)$:\n\n$$\n\\begin{aligned}\n\\text{Vertical scale} &=\\frac{-2}{-4}=\\frac{1}{2}\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{b}$. Thus $\\overrightarrow{AC}=\\frac{1}{2}\\mathbf{b}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OA}+\\overrightarrow{AC} \\\\\n&=\\mathbf{a}+\\frac{1}{2}\\mathbf{b} \\\\\n&=\\mathbf{a}+\\frac{1}{2}\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{b}$ gives $\\lambda=\\frac{1}{2}$."] [:db/add "31fe6aa1-ed1c-5040-a39d-dbc385628868" :question/difficulty :question.difficulty/easy] [:db/add "31fe6aa1-ed1c-5040-a39d-dbc385628868" :question/answer-fields "b04668b2-e8cc-57e5-a17f-bb56a12ad96d"] [:db/ensure "31fe6aa1-ed1c-5040-a39d-dbc385628868" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "31fe6aa1-ed1c-5040-a39d-dbc385628868"] [:db/add "2f8f2bcb-e103-5062-a4bb-a0022bccb809" :answer/id #uuid "2f8f2bcb-e103-5062-a4bb-a0022bccb809"] [:db/add "2f8f2bcb-e103-5062-a4bb-a0022bccb809" :answer/type :answer.type/math] [:db/add "2f8f2bcb-e103-5062-a4bb-a0022bccb809" :answer/value "1"] [:db/ensure "2f8f2bcb-e103-5062-a4bb-a0022bccb809" :answer/validate] [:db/add "48233ffb-12fd-5e56-b194-4ba8ae480222" :answer/id #uuid "48233ffb-12fd-5e56-b194-4ba8ae480222"] [:db/add "48233ffb-12fd-5e56-b194-4ba8ae480222" :answer/type :answer.type/math] [:db/add "48233ffb-12fd-5e56-b194-4ba8ae480222" :answer/value "\\frac{5}{2}"] [:db/ensure "48233ffb-12fd-5e56-b194-4ba8ae480222" :answer/validate] [:db/add "1ffcfe9a-be2d-5fc7-89a2-c62865b13541" :answer/id #uuid "1ffcfe9a-be2d-5fc7-89a2-c62865b13541"] [:db/add "1ffcfe9a-be2d-5fc7-89a2-c62865b13541" :answer/type :answer.type/math] [:db/add "1ffcfe9a-be2d-5fc7-89a2-c62865b13541" :answer/value "2"] [:db/ensure "1ffcfe9a-be2d-5fc7-89a2-c62865b13541" :answer/validate] [:db/add "57ac6bec-3786-55fc-9391-50e36e161a79" :answer/id #uuid "57ac6bec-3786-55fc-9391-50e36e161a79"] [:db/add "57ac6bec-3786-55fc-9391-