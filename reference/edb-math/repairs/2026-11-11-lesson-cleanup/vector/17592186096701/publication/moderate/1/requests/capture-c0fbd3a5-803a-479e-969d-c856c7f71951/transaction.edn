a-4fa2-5c24-b231-c2bec9c5b887"] [:db/add "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4" :answer-field/choices "bd27c4ee-08fc-5b46-9ff2-3b5ef8db53f5"] [:db/add "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4" :answer-field/choices "d1dadc72-ce76-52ce-b9ea-b8d073d8f8e2"] [:db/add "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4" :answer-field/choices "6d891a84-a77f-5e89-8bee-0980d1efe5b2"] [:db/add "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4" :answer-field/choices "571f5750-f085-531a-a470-8e10a70f8d2e"] [:db/add "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4" :answer-field/correct "571f5750-f085-531a-a470-8e10a70f8d2e"] [:db/ensure "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4" :answer-field/validate] [:db/add "07c2b492-d44f-5131-9a7b-db9206a3e7e1" :question/id #uuid "07c2b492-d44f-5131-9a7b-db9206a3e7e1"] [:db/add "07c2b492-d44f-5131-9a7b-db9206a3e7e1" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/87/870ab808de9f829e5967f4792119b4b596ad9de28ff714e1ce5c3b2b686338fb.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+\\frac{4}{3}\\mathbf{b}$, find $\\lambda$."] [:db/add "07c2b492-d44f-5131-9a7b-db9206a3e7e1" :question/worked-solution "Construct the known component $\\frac{4}{3}\\mathbf{b}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=\\frac{4}{3}\\,(3, 0)=(4, 0). \\\\\n\\overrightarrow{PC} &=(4, -8).\n\\end{aligned}\n$$\n\n![](images/80/808f2835fcaf678e3cbde7898ac8af3893e9dc71ed879cff900aefc430393c74.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(2, -4)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{4}{2}=2 \\\\\n\\text{Vertical scale} &=\\frac{-8}{-4}=2\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{PC}=2\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=\\frac{4}{3}\\mathbf{b}+2\\mathbf{a} \\\\\n&=2\\mathbf{a}+\\frac{4}{3}\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=2$."] [:db/add "07c2b492-d44f-5131-9a7b-db9206a3e7e1" :question/difficulty :question.difficulty/moderate] [:db/add "07c2b492-d44f-5131-9a7b-db9206a3e7e1" :question/answer-fields "0569ed5b-dbf7-5fb9-b56c-18dbe194edb4"] [:db/ensure "07c2b492-d44f-5131-9a7b-db9206a3e7e1" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "07c2b492-d44f-5131-9a7b-db9206a3e7e1"] [:db/add "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c" :answer/id #uuid "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c"] [:db/add "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c" :answer/type :answer.type/math] [:db/add "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c" :answer/value "2"] [:db/ensure "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c" :answer/validate] [:db/add "f30c7502-b272-5b2a-962b-d10658252e14" :answer-field/id #uuid "f30c7502-b272-5b2a-962b-d10658252e14"] [:db/add "f30c7502-b272-5b2a-962b-d10658252e14" :answer-field/key "field-1"] [:db/add "f30c7502-b272-5b2a-962b-d10658252e14" :answer-field/type :answer-field.type/blank] [:db/add "f30c7502-b272-5b2a-962b-d10658252e14" :answer-field/choices "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c"] [:db/add "f30c7502-b272-5b2a-962b-d10658252e14" :answer-field/correct "6d481b42-e4bc-59fc-b6ce-4ec41bf84b6c"] [:db/ensure "f30c7502-b272-5b2a-962b-d10658252e14" :answer-field/validate] [:db/add "5b880935-6ff4-54af-834b-282c8fffc65e" :question/id #uuid "5b880935-6ff4-54af-834b-282c8fffc65e"] [:db/add "5b880935-6ff4-54af-834b-282c8fffc65e" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/5e/5e81fc8d41121ddfde878e3ba0aec7531eb29901282786e1915a408ae5e6af01.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+3\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}."] [:db/add "5b880935-6ff4-54af-834b-282c8fffc65e" :question/worked-solution "Construct the known component $3\\mathbf{b}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=3\\,(2, -2)=(6, -6). \\\\\n\\overrightarrow{PC} &=(-4, 0).\n\\end{aligned}\n$$\n\n![](images/f5/f571ab2db29957aa8533bfb6fb602fb5c061fffb2d996ee60d6f8279e2fb19d9.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(-2, 0)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{-4}{-2}=2\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{PC}=2\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=3\\mathbf{b}+2\\mathbf{a} \\\\\n&=2\\mathbf{a}+3\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=2$."] [:db/add "5b880935-6ff4-54af-834b-282c8fffc65e" :question/difficulty :question.difficulty/moderate] [:db/add "5b880935-6ff4-54af-834b-282c8fffc65e" :question/answer-fields "f30c7502-b272-5b2a-962b-d10658252e14"] [:db/ensure "5b880935-6ff4-54af-834b-282c8fffc65e" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "5b880935-6ff4-54af-834b-282c8fffc65e"] [:db/add "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae" :answer/id #uuid "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae"] [:db/add "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae" :answer/type :answer.type/math] [:db/add "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae" :answer/value "1"] [:db/ensure "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae" :answer/validate] [:db/add "1fc513a5-5201-5a67-9402-1f27b78c924b" :answer-field/id #uuid "1fc513a5-5201-5a67-9402-1f27b78c924b"] [:db/add "1fc513a5-5201-5a67-9402-1f27b78c924b" :answer-field/key "field-1"] [:db/add "1fc513a5-5201-5a67-9402-1f27b78c924b" :answer-field/type :answer-field.type/blank] [:db/add "1fc513a5-5201-5a67-9402-1f27b78c924b" :answer-field/choices "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae"] [:db/add "1fc513a5-5201-5a67-9402-1f27b78c924b" :answer-field/correct "b4cc3525-8080-5721-b0af-2e6ef5ecd2ae"] [:db/ensure "1fc513a5-5201-5a67-9402-1f27b78c924b" :answer-field/validate] [:db/add "d479cc32-0b20-5773-bb01-d92fe3db0f2e" :question/id #uuid "d479cc32-0b20-5773-bb01-d92fe3db0f2e"] [:db/add "d479cc32-0b20-5773-bb01-d92fe3db0f2e" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/9c/9c588029ebd0ca04c3317cff5891ac0c548d5606eb83bf918fa85ecab57cff00.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+3\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}."] [:db/add "d479cc32-0b20-5773-bb01-d92fe3db0f2e" :question/worked-solution "Construct the known component $3\\mathbf{b}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=3\\,(-2, 2)=(-6, 6). \\\\\n\\overrightarrow{PC} &=(-2, 0).\n\\end{aligned}\n$$\n\n![](images/be/bec67a793df45efe9f3a6907514c2cc2d17ed6f4446c87958eb04910787ff4fd.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(-2, 0)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{-2}{-2}=1\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{PC}=\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=3\\mathbf{b}+\\mathbf{a} \\\\\n&=\\mathbf{a}+3\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=1$."] [:db/add "d479cc32-0b20-5773-bb01-d92fe3db0f2e" :question/difficulty :question.difficulty/moderate] [:db/add "d479cc32-0b20-5773-bb01-d92fe3db0f2e" :question/answer-fields "1fc513a5-5201-5a67-9402-1f27b78c924b"] [:db/ensure "d479cc32-0b20-5773-bb01-d92fe3db0f2e" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "d479cc32-0b20-5773-bb01-d92fe3db0f2e"] [:db/add "3ea1290f-a304-5b2c-a65a-05b6aa2f1712" :answer/id #uuid "3ea1290f-a304-5b2c-a65a-05b6aa2f1712"] [:db/add "3ea1290f-a304-5b2c-a65a-05b6aa2f1712" :answer/type :answer.type/math] [:db/add "3ea1290f-a304-5b2c-a65a-05b6aa2f1712" :answer/value "3"] [:db/ensure "3ea1290f-a304-5b2c-a65a-05b6aa2f1712" :answer/validate] [:db/add "a7bc8e7c-9591-57ac-8208-b6dc94487196" :answer/id #uuid "a7bc8e7c-9591-57ac-8208-b6dc94487196"] [:db/add "a7bc8e7c-9591-57ac-8208-b6dc94487196" :answer/type :answer.type/math] [:db/add "a7bc8e7c-9591-57ac-8208-b6dc94487196" :answer/value "\\frac{5}{2}"] [:db/ensure "a7bc8e7c-9591-57ac-8208-b6dc94487196" :answer/validate] [:db/add "d1abc686-42b5-569d-bef0-4bb17d2002a6" :answer/id #uuid "d1abc686-42b5-569d-bef0-4bb17d2002a6"] [:db/add "d1abc686-42b5-569d-bef0-4bb17d2002a6" :answer/type :answer.type/math] [:db/add "d1abc686-42b5-569d-bef0-4bb17d2002a6" :answer/value "\\frac{3}{2}"] [:db/ensure "d1abc686-42b5-569d-bef0-4bb17d2002a6" :answer/validate] [:db/add "602968b2-2e20-5463-a891-c5361b16c4d8" :answer/id #uuid "602968b2-2e20-5463-a891-c5361b16c4d8"] [:db/add "602968b2-2e20-5463-a891-c5361b16c4d8" :answer/type :answer.type/math] [:db/add "602968b2-2e20-5463-a891-c5361b16c4d8" :answer/value "1"] [:db/ensure "602968b2-2e20-5463-a891-c5361b16c4d8" :answer/validate] [:db/add "0fd16f20-900b-5533-bbfc-e311652a30dc" :answer/id #uuid "0fd16f20-900b-5533-bbfc-e311652a30dc"] [:db/add "0fd16f20-900b-5533-bbfc-e311652a30dc" :answer/type :answer.type/math] [:db/add "0fd16f20-900b-5533-bbfc-e311652a30dc" :answer/value "2"] [:db/ensure "0fd16f20-900b-5533-bbfc-e311652a30dc" :answer/validate] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/id #uuid "edf056b3-92b0-5f19-af59-24981fd98f55"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/key "selection"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/type :answer-field.type/radio] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/choices "3ea1290f-a304-5b2c-a65a-05b6aa2f1712"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/choices "a7bc8e7c-9591-57ac-8208-b6dc94487196"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/choices "d1abc686-42b5-569d-bef0-4bb17d2002a6"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/choices "602968b2-2e20-5463-a891-c5361b16c4d8"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/choices "0fd16f20-900b-5533-bbfc-e311652a30dc"] [:db/add "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/correct "3ea1290f-a304-5b2c-a65a-05b6aa2f1712"] [:db/ensure "edf056b3-92b0-5f19-af59-24981fd98f55" :answer-field/validate] [:db/add "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa" :question/id #uuid "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa"] [:db/add "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Grid squares have side length one unit.\n\n![](images/aa/aa82a832d995267377fc509465ad66fa2d1ae45020a1d7a6e1d59c634147e9b1.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+\\mathbf{b}$, find $\\lambda$."] [:db/add "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa" :question/worked-solution "Construct the known component $\\mathbf{b}$ from $O$, ending at $B$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OB} &=1\\,(3, 0)=(3, 0). \\\\\n\\overrightarrow{BC} &=(12, -12).\n\\end{aligned}\n$$\n\n![](images/3e/3e0501efbcbc85ddf1046ea01a03dea98ba5c9f8fa9d24c706b888b885ec71c6.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(4, -4)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{12}{4}=3 \\\\\n\\text{Vertical scale} &=\\frac{-12}{-4}=3\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{BC}=3\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OB}+\\overrightarrow{BC} \\\\\n&=\\mathbf{b}+3\\mathbf{a} \\\\\n&=3\\mathbf{a}+\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=3$."] [:db/add "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa" :question/difficulty :question.difficulty/moderate] [:db/add "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa" :question/answer-fields "edf056b3-92b0-5f19-af59-24981fd98f55"] [:db/ensure "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa" :question/validate] [:db/add 17592186096701 :knowledge-point/questions "5bd1ee6d-05c9-56b6-8062-0b5bd06d6caa"] [:db/add "bccd4032-1759-587a-b3d8-7420a1950fd9" :answer/id #uuid "bccd4032-1759-587a-b3d8-7420a1950fd9"] [:db/add "bccd4032-1759-587a-b3d8-7420a1950fd9" :answer/type :answer.type/math] [:db/add "bccd4032-1759-587a-b3d8-7420a1950fd9" :answer/value "1"] [:db/ensure "bccd4032-1759-587a-b3d8-7420a1950fd9" :answer/validate] [:db/add "530a43c8-e4f7-5553-ba77-1a40d52420e6" :answer/id #uuid "530a43c8-e4f7-5553-ba77-1a40d52420e6"] [:db/add "530a43c8-e4f7-5553-ba77-1a40d52420e6" :answer/type :answer.type/math] [:db/add "530a43c8-e4f7-5553-ba77-1a40d52420e6" :answer/value "\\frac{5}{2}"] [:db/ensure "530a43c8-e4f7-5553-ba77-1a40d52420e6" :answer/validate] [:db/add "c3edaf37-f59a-52bb-91ba-b57f6f9c9e93" :answer/id #uuid "c3edaf37-f59a-52bb-91ba-b57f6f9c9e93"] [:db/add "c3edaf37-f59a-52bb-91ba-b57f