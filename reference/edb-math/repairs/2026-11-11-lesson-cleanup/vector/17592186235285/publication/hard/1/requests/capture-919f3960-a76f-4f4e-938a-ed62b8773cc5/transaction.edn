718-a67e-32c7ea4dbe75" :answer-field/choices "caf095a4-1747-502c-85f0-c5158809d818"] [:db/add "9177891f-10c6-5718-a67e-32c7ea4dbe75" :answer-field/choices "7170a1a0-cab7-5626-9486-eb040433c436"] [:db/add "9177891f-10c6-5718-a67e-32c7ea4dbe75" :answer-field/choices "26548894-4d77-5a12-b1e0-9767a6bcb83f"] [:db/add "9177891f-10c6-5718-a67e-32c7ea4dbe75" :answer-field/choices "62ca490e-937f-5b2f-acdb-55a55454599a"] [:db/add "9177891f-10c6-5718-a67e-32c7ea4dbe75" :answer-field/choices "c7a07ca7-db83-5ba7-89f0-9a82f2e15bc9"] [:db/add "9177891f-10c6-5718-a67e-32c7ea4dbe75" :answer-field/correct "26548894-4d77-5a12-b1e0-9767a6bcb83f"] [:db/ensure "9177891f-10c6-5718-a67e-32c7ea4dbe75" :answer-field/validate] [:db/add "6423178c-2eaf-5332-9d49-4298e72d771d" :question/id #uuid "6423178c-2eaf-5332-9d49-4298e72d771d"] [:db/add "6423178c-2eaf-5332-9d49-4298e72d771d" :question/problem "The three vectors share an origin, and each grid square has the same side length.\n\n![](images/d0/d0781081331f88d9c1cbc54562e3d2b027b9f15eceec4acb2015f24e7709f9b8.png)\n\nGiven $\\mathbf{c}=\\lambda\\mathbf{a}-3\\mathbf{b}$, find $\\lambda$."] [:db/add "6423178c-2eaf-5332-9d49-4298e72d771d" :question/worked-solution "First trace $-3\\mathbf{b}$ from the common origin $O$ to a point $P$: reverse its direction and scale its length. The remaining path from $P$ to the endpoint $C$ must be the unknown multiple of $\\mathbf{a}$.\n\n![](images/a6/a6f6deeb8bd820aa00470bdfed05ed45ba1676862d508653a4e9bc229214a950.png)\n\nFollowing the grid direction of $\\mathbf{a}$ takes $4$ steps, while the parallel path $PC$ has $14$ steps. Their length ratio is $\\frac{14}{4}=\\frac{7}{2}$. The remaining path points in the opposite direction to $\\mathbf{a}$, so\n$$\n\\overrightarrow{PC}=-\\frac{7}{2}\\mathbf{a}.\n$$\nAdding the path vectors gives\n$$\n\\begin{aligned}\n\\mathbf{c}&=\\overrightarrow{OP}+\\overrightarrow{PC}\\\\\n&=-3\\mathbf{b}+\\left(-\\frac{7}{2}\\mathbf{a}\\right)\\\\\n&=-\\frac{7}{2}\\mathbf{a}-3\\mathbf{b}.\n\\end{aligned}\n$$\nBecause $\\mathbf{a}$ and $\\mathbf{b}$ are nonparallel, these coefficients are unique. Comparing with $\\mathbf{c}=\\lambda\\mathbf{a}-3\\mathbf{b}$ gives $\\lambda=-\\frac{7}{2}$. The minus sign records the reversed direction."] [:db/add "6423178c-2eaf-5332-9d49-4298e72d771d" :question/difficulty :question.difficulty/hard] [:db/add "6423178c-2eaf-5332-9d49-4298e72d771d" :question/answer-fields "9177891f-10c6-5718-a67e-32c7ea4dbe75"] [:db/ensure "6423178c-2eaf-5332-9d49-4298e72d771d" :question/validate] [:db/add 17592186235285 :knowledge-point/questions "6423178c-2eaf-5332-9d49-4298e72d771d"] [:db/add "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a" :answer/id #uuid "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a"] [:db/add "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a" :answer/type :answer.type/math] [:db/add "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a" :answer/value "-\\frac{5}{2}"] [:db/ensure "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a" :answer/validate] [:db/add "eae5d6fa-3690-5bf0-b356-1952bbc48b0e" :answer-field/id #uuid "eae5d6fa-3690-5bf0-b356-1952bbc48b0e"] [:db/add "eae5d6fa-3690-5bf0-b356-1952bbc48b0e" :answer-field/key "field-1"] [:db/add "eae5d6fa-3690-5bf0-b356-1952bbc48b0e" :answer-field/type :answer-field.type/blank] [:db/add "eae5d6fa-3690-5bf0-b356-1952bbc48b0e" :answer-field/choices "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a"] [:db/add "eae5d6fa-3690-5bf0-b356-1952bbc48b0e" :answer-field/correct "ccbbab9f-1eb5-5e77-b0df-f6aaf777a49a"] [:db/ensure "eae5d6fa-3690-5bf0-b356-1952bbc48b0e" :answer-field/validate] [:db/add "e3ce329c-dd66-5517-a558-105ba9239dec" :question/id #uuid "e3ce329c-dd66-5517-a558-105ba9239dec"] [:db/add "e3ce329c-dd66-5517-a558-105ba9239dec" :question/problem "The three vectors share an origin, and each grid square has the same side length.\n\n![](images/82/82726f9c00950d5d4ca30dd65916a7ee785f8efe3137619f39f96638f51aff73.png)\n\nIf $\\mathbf{c}=\\lambda\\mathbf{a}-3\\mathbf{b}$, then $\\lambda=$ {{field-1}}."] [:db/add "e3ce329c-dd66-5517-a558-105ba9239dec" :question/worked-solution "First trace $-3\\mathbf{b}$ from the common origin $O$ to a point $P$: reverse its direction and scale its length. The remaining path from $P$ to the endpoint $C$ must be the unknown multiple of $\\mathbf{a}$.\n\n![](images/b6/b678b96c8e3e7c2a24cf26bef124aac0b3761b3f78a6c0167b436ddec715671a.png)\n\nFollowing the grid direction of $\\mathbf{a}$ takes $4$ steps, while the parallel path $PC$ has $10$ steps. Their length ratio is $\\frac{10}{4}=\\frac{5}{2}$. The remaining path points in the opposite direction to $\\mathbf{a}$, so\n$$\n\\overrightarrow{PC}=-\\frac{5}{2}\\mathbf{a}.\n$$\nAdding the path vectors gives\n$$\n\\begin{aligned}\n\\mathbf{c}&=\\overrightarrow{OP}+\\overrightarrow{PC}\\\\\n&=-3\\mathbf{b}+\\left(-\\frac{5}{2}\\mathbf{a}\\right)\\\\\n&=-\\frac{5}{2}\\mathbf{a}-3\\mathbf{b}.\n\\end{aligned}\n$$\nBecause $\\mathbf{a}$ and $\\mathbf{b}$ are nonparallel, these coefficients are unique. Comparing with $\\mathbf{c}=\\lambda\\mathbf{a}-3\\mathbf{b}$ gives $\\lambda=-\\frac{5}{2}$. The minus sign records the reversed direction."] [:db/add "e3ce329c-dd66-5517-a558-105ba9239dec" :question/difficulty :question.difficulty/hard] [:db/add "e3ce329c-dd66-5517-a558-105ba9239dec" :question/answer-fields "eae5d6fa-3690-5bf0-b356-1952bbc48b0e"] [:db/ensure "e3ce329c-dd66-5517-a558-105ba9239dec" :question/validate] [:db/add 17592186235285 :knowledge-point/questions "e3ce329c-dd66-5517-a558-105ba9239dec"] [:db/ensure 17592186235285 :knowledge-point/validate]]
