87e-5f9f-9652-d28d3f805c49"] [:db/add "ada81192-287e-5f9f-9652-d28d3f805c49" :question/problem "The three vectors share an origin, and each grid square has the same side length.\n\n![](images/12/12f50b8f037a1543f526ff9a4182a46640591625fc2f7f6c1ee2a42904bae298.png)\n\nGiven $\\mathbf{c}=\\lambda\\mathbf{a}+2\\mathbf{b}$, find $\\lambda$."] [:db/add "ada81192-287e-5f9f-9652-d28d3f805c49" :question/worked-solution "First trace $2\\mathbf{b}$ from the common origin $O$ to a point $P$: keep its direction and scale its length. The remaining path from $P$ to the endpoint $C$ must be the unknown multiple of $\\mathbf{a}$.\n\n![](images/21/2134a459490bc84a092a28016bc130c481d488f02eeeb52f4fbe7b04a8fe2cd6.png)\n\nFollowing the grid direction of $\\mathbf{a}$ takes $2$ steps, while the parallel path $PC$ has $6$ steps. Their length ratio is $\\frac{6}{2}=3$. The remaining path points in the opposite direction to $\\mathbf{a}$, so\n$$\n\\overrightarrow{PC}=-3\\mathbf{a}.\n$$\nAdding the path vectors gives\n$$\n\\begin{aligned}\n\\mathbf{c}&=\\overrightarrow{OP}+\\overrightarrow{PC}\\\\\n&=2\\mathbf{b}+(-3\\mathbf{a})\\\\\n&=-3\\mathbf{a}+2\\mathbf{b}.\n\\end{aligned}\n$$\nBecause $\\mathbf{a}$ and $\\mathbf{b}$ are nonparallel, these coefficients are unique. Comparing with $\\mathbf{c}=\\lambda\\mathbf{a}+2\\mathbf{b}$ gives $\\lambda=-3$. The minus sign records the reversed direction."] [:db/add "ada81192-287e-5f9f-9652-d28d3f805c49" :question/difficulty :question.difficulty/moderate] [:db/add "ada81192-287e-5f9f-9652-d28d3f805c49" :question/answer-fields "fa75b41d-e61c-5aad-a7a3-3c3ac655e53f"] [:db/ensure "ada81192-287e-5f9f-9652-d28d3f805c49" :question/validate] [:db/add 17592186235285 :knowledge-point/questions "ada81192-287e-5f9f-9652-d28d3f805c49"] [:db/add "808b4cd9-7464-5fb7-846a-b3a391680667" :answer/id #uuid "808b4cd9-7464-5fb7-846a-b3a391680667"] [:db/add "808b4cd9-7464-5fb7-846a-b3a391680667" :answer/type :answer.type/math] [:db/add "808b4cd9-7464-5fb7-846a-b3a391680667" :answer/value "-3"] [:db/ensure "808b4cd9-7464-5fb7-846a-b3a391680667" :answer/validate] [:db/add "0ea898df-3034-520b-bb9b-14172f31f6b7" :answer-field/id #uuid "0ea898df-3034-520b-bb9b-14172f31f6b7"] [:db/add "0ea898df-3034-520b-bb9b-14172f31f6b7" :answer-field/key "field-1"] [:db/add "0ea898df-3034-520b-bb9b-14172f31f6b7" :answer-field/type :answer-field.type/blank] [:db/add "0ea898df-3034-520b-bb9b-14172f31f6b7" :answer-field/choices "808b4cd9-7464-5fb7-846a-b3a391680667"] [:db/add "0ea898df-3034-520b-bb9b-14172f31f6b7" :answer-field/correct "808b4cd9-7464-5fb7-846a-b3a391680667"] [:db/ensure "0ea898df-3034-520b-bb9b-14172f31f6b7" :answer-field/validate] [:db/add "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5" :question/id #uuid "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5"] [:db/add "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5" :question/problem "The three vectors share an origin, and each grid square has the same side length.\n\n![](images/f7/f7d9435e01b73dc9af761698d095d29512780c12f0053d11e5c5fdf3adc26b6e.png)\n\nIf $\\mathbf{c}=\\lambda\\mathbf{a}+3\\mathbf{b}$, then $\\lambda=$ {{field-1}}."] [:db/add "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5" :question/worked-solution "First trace $3\\mathbf{b}$ from the common origin $O$ to a point $P$: keep its direction and scale its length. The remaining path from $P$ to the endpoint $C$ must be the unknown multiple of $\\mathbf{a}$.\n\n![](images/dd/dda3b2be27f2cc635aaec18488c2c88bc5182ee069605643b762ff7d39ff1d46.png)\n\nFollowing the grid direction of $\\mathbf{a}$ takes $2$ steps, while the parallel path $PC$ has $6$ steps. Their length ratio is $\\frac{6}{2}=3$. The remaining path points in the opposite direction to $\\mathbf{a}$, so\n$$\n\\overrightarrow{PC}=-3\\mathbf{a}.\n$$\nAdding the path vectors gives\n$$\n\\begin{aligned}\n\\mathbf{c}&=\\overrightarrow{OP}+\\overrightarrow{PC}\\\\\n&=3\\mathbf{b}+(-3\\mathbf{a})\\\\\n&=-3\\mathbf{a}+3\\mathbf{b}.\n\\end{aligned}\n$$\nBecause $\\mathbf{a}$ and $\\mathbf{b}$ are nonparallel, these coefficients are unique. Comparing with $\\mathbf{c}=\\lambda\\mathbf{a}+3\\mathbf{b}$ gives $\\lambda=-3$. The minus sign records the reversed direction."] [:db/add "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5" :question/difficulty :question.difficulty/moderate] [:db/add "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5" :question/answer-fields "0ea898df-3034-520b-bb9b-14172f31f6b7"] [:db/ensure "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5" :question/validate] [:db/add 17592186235285 :knowledge-point/questions "4d4c8a83-2be0-53f5-ac51-6fd7b75910b5"] [:db/add "13e1b35e-65aa-5ccf-bb48-792c0054887a" :answer/id #uuid "13e1b35e-65aa-5ccf-bb48-792c0054887a"] [:db/add "13e1b35e-65aa-5ccf-bb48-792c0054887a" :answer/type :answer.type/math] [:db/add "13e1b35e-65aa-5ccf-bb48-792c0054887a" :answer/value "-2"] [:db/ensure "13e1b35e-65aa-5ccf-bb48-792c0054887a" :answer/validate] [:db/add "d8a68145-a08c-514a-9e65-0a676f2691de" :answer-field/id #uuid "d8a68145-a08c-514a-9e65-0a676f2691de"] [:db/add "d8a68145-a08c-514a-9e65-0a676f2691de" :answer-field/key "field-1"] [:db/add "d8a68145-a08c-514a-9e65-0a676f2691de" :answer-field/type :answer-field.type/blank] [:db/add "d8a68145-a08c-514a-9e65-0a676f2691de" :answer-field/choices "13e1b35e-65aa-5ccf-bb48-792c0054887a"] [:db/add "d8a68145-a08c-514a-9e65-0a676f2691de" :answer-field/correct "13e1b35e-65aa-5ccf-bb48-792c0054887a"] [:db/ensure "d8a68145-a08c-514a-9e65-0a676f2691de" :answer-field/validate] [:db/add "63ac9e62-6da7-5180-a166-deb588aa991b" :question/id #uuid "63ac9e62-6da7-5180-a166-deb588aa991b"] [:db/add "63ac9e62-6da7-5180-a166-deb588aa991b" :question/problem "The three vectors share an origin, and each grid square has the same side length.\n\n![](images/6d/6dc16bd9419a7b8dc42531bc3904368ce93a6b3a94b81bfb28bdfb6eb8efb63d.png)\n\nIf $\\mathbf{c}=\\lambda\\mathbf{a}+3\\mathbf{b}$, then $\\lambda=$ {{field-1}}."] [:db/add "63ac9e62-6da7-5180-a166-deb588aa991b" :question/worked-solution "First trace $3\\mathbf{b}$ from the common origin $O$ to a point $P$: keep its direction and scale its length. The remaining path from $P$ to the endpoint $C$ must be the unknown multiple of $\\mathbf{a}$.\n\n![](images/4e/4eacb8493dafecf3a69729c614e7b1b5b46605071e6347852ca523af010b1cfc.png)\n\nFollowing the grid direction of $\\mathbf{a}$ takes $2$ steps, while the parallel path $PC$ has $4$ steps. Their length ratio is $\\frac{4}{2}=2$. The remaining path points in the opposite direction to $\\mathbf{a}$, so\n$$\n\\overrightarrow{PC}=-2\\mathbf{a}.\n$$\nAdding the path vectors gives\n$$\n\\begin{aligned}\n\\mathbf{c}&=\\overrightarrow{OP}+\\overrightarrow{PC}\\\\\n&=3\\mathbf{b}+(-2\\mathbf{a})\\\\\n&=-2\\mathbf{a}+3\\mathbf{b}.\n\\end{aligned}\n$$\nBecause $\\mathbf{a}$ and $\\mathbf{b}$ are nonparallel, these coefficients are unique. Comparing with $\\mathbf{c}=\\lambda\\mathbf{a}+3\\mathbf{b}$ gives $\\lambda=-2$. The minus sign records the reversed direction."] [:db/add "63ac9e62-6da7-5180-a166-deb588aa991b" :question/difficulty :question.difficulty/moderate] [:db/add "63ac9e62-6da7-5180-a166-deb588aa991b" :question/answer-fields "d8a68145-a08c-514a-9e65-0a676f2691de"] [:db/ensure "63ac9e62-6da7-5180-a166-deb588aa991b" :question/validate] [:db/add 17592186235285 :knowledge-point/questions "63ac9e62-6da7-5180-a166-deb588aa991b"] [:db/add "e0ed577a-9d6c-58b6-8419-23299c6ff7e4" :answer/id #uuid "e0ed577a-9d6c-58b6-8419-23299c6ff7e4"] [:db/add "e0ed577a-9d6c-58b6-8419-23299c6ff7e4" :answer/type :answer.type/math] [:db/add "e0ed577a-9d6c-58b6-8419-23299c6ff7e4" :answer/value "-\\frac{16}{3}"] [:db/ensure "e0ed577a-9d6c-58b6-8419-23299c6ff7e4" :answer/validate] [:db/add "56c6ff33-76f8-5f85-9f76-d21f1eab859b" :answer/id #uuid "56c6ff33-76f8-5f85-9f76-d21f1eab859b"] [:db/add "56c6ff33-76f8-5f85-9f76-d21f1eab859b" :answer/type :answer.type/math] [:db/add "56c6ff33-76f8-5f85-9f76-d21f1eab859b" :answer/value "-4"] [:db/ensure "56c6ff33-76f8-5f85-9f76-d21f1eab859b" :answer/validate] [:db/add "2ebf1801-2786-5bd6-9391-e13d48a0e9ed" :answer/