                  ":answer/id": "95092ddd-a592-51a9-a935-ee8d21d09f58",
                  ":answer/type": {
                    ":db/ident": ":answer.type/math"
                  },
                  ":answer/value": "\\overrightarrow{OT} = \\mathbf{a} + \\frac{1}{2}\\mathbf{b}",
                  ":db/id": 17592186094250
                },
                {
                  ":answer/id": "c8ea1899-3edc-5a44-a68d-8e0dc35e8f3e",
                  ":answer/type": {
                    ":db/ident": ":answer.type/math"
                  },
                  ":answer/value": "\\overrightarrow{OT} = \\frac{2}{3}\\mathbf{a} + \\frac{1}{3}\\mathbf{b}",
                  ":db/id": 17592186094251
                },
                {
                  ":answer/id": "0f332864-f317-5e8c-afc1-79039bba7d4b",
                  ":answer/type": {
                    ":db/ident": ":answer.type/math"
                  },
                  ":answer/value": "\\overrightarrow{OT} = \\frac{1}{3}\\mathbf{a} + \\frac{2}{3}\\mathbf{b}",
                  ":db/id": 17592186094252
                },
                {
                  ":answer/id": "149f3ec8-5bfe-5cff-b544-5450e508dd7d",
                  ":answer/type": {
