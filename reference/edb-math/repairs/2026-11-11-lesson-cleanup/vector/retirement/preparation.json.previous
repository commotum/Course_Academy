                  ":answer/id": "af713187-7446-509e-9f13-5b7ff7016b45",
                  ":answer/type": {
                    ":db/ident": ":answer.type/math"
                  },
                  ":answer/value": "3",
                  ":db/id": 17592186735390
                },
                {
                  ":answer/id": "bdc0fa8e-7e27-5c5a-8151-564170920abc",
                  ":answer/type": {
                    ":db/ident": ":answer.type/math"
