                }
              ],
              ":answer-field/correct": {
                ":answer/id": "8fbec857-bdfa-5ce4-93b7-979d192af93b",
                ":answer/type": {
                  ":db/ident": ":answer.type/math"
                },
                ":answer/value": "1",
                ":db/id": 17592186735421
              },
              ":answer-field/id": "43483cdb-567b-5c55-bded-236793d2adb2",
              ":answer-field/key": "field-1",
              ":answer-field/type": {
                ":db/ident": ":answer-field.type/blank"
              },
