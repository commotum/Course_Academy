                  ":db/ident": ":answer.type/math"
                },
                ":answer/value": "2",
                ":db/id": 17592186735004
              },
              ":answer-field/id": "0a075dfb-65b3-55a4-a702-e92f22aba919",
              ":answer-field/key": "field-2",
              ":answer-field/type": {
