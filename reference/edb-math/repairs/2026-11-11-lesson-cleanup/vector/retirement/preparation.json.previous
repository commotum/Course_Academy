                {
                  ":answer/id": "bb1a8c24-4115-5d89-a601-bd095e5bfa7f",
                  ":answer/type": {
                    ":db/ident": ":answer.type/text"
                  },
                  ":answer/value": "$\\lambda =-2$ and $\\mu =-3$",
                  ":db/id": 17592186572523
                },
                {
                  ":answer/id": "e054b3a2-0eea-5210-8737-47555b3de52a",
