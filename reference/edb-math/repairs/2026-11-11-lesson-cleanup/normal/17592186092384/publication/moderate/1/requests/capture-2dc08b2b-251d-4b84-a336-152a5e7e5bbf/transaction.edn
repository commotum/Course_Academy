[[:db/add "ab4ddfa7-52df-5728-b0e1-719076325db9" :answer/id #uuid "ab4ddfa7-52df-5728-b0e1-719076325db9"] [:db/add "ab4ddfa7-52df-5728-b0e1-719076325db9" :answer/type :answer.type/math] [:db/add "ab4ddfa7-52df-5728-b0e1-719076325db9" :answer/value "-\\frac{1}{6}"] [:db/ensure "ab4ddfa7-52df-5728-b0e1-719076325db9" :answer/validate] [:db/add "f8064394-a467-5621-b670-65d8cde1af82" :answer-field/id #uuid "f8064394-a467-5621-b670-65d8cde1af82"] [:db/add "f8064394-a467-5621-b670-65d8cde1af82" :answer-field/key "field-1"] [:db/add "f8064394-a467-5621-b670-65d8cde1af82" :answer-field/type :answer-field.type/blank] [:db/add "f8064394-a467-5621-b670-65d8cde1af82" :answer-field/choices "ab4ddfa7-52df-5728-b0e1-719076325db9"] [:db/add "f8064394-a467-5621-b670-65d8cde1af82" :answer-field/correct "ab4ddfa7-52df-5728-b0e1-719076325db9"] [:db/ensure "f8064394-a467-5621-b670-65d8cde1af82" :answer-field/validate] [:db/add "229c4819-0721-5a67-b268-0b7d8501a4a0" :question/id #uuid "229c4819-0721-5a67-b268-0b7d8501a4a0"] [:db/add "229c4819-0721-5a67-b268-0b7d8501a4a0" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x-2)(x^{2}+x)\n$$\n\nat the point $\\left(2,0\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "229c4819-0721-5a67-b268-0b7d8501a4a0" :question/worked-solution "Let $f(x)=(x-2)(x^{2}+x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}+x^{2}-2x^{2}-2x\\\\\n&=x^{3}-x^{2}-2x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}-2x-2\n$$\n\nThe tangent slope at $\\left(2,0\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(2)&=3\\left(2\\right)^{2}-2\\left(2\\right)-2\\\\\n&=12-4-2\\\\\n&=6\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(6\\right)}\\\\\n&=-\\frac{1}{6}\n\\end{aligned}\n$$"] [:db/add "229c4819-0721-5a67-b268-0b7d8501a4a0" :question/difficulty :question.difficulty/moderate] [:db/add "229c4819-0721-5a67-b268-0b7d8501a4a0" :question/answer-fields "f8064394-a467-5621-b670-65d8cde1af82"] [:db/ensure "229c4819-0721-5a67-b268-0b7d8501a4a0" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "229c4819-0721-5a67-b268-0b7d8501a4a0"] [:db/add "d38a48de-853d-5f1c-ab46-45101a7d57d9" :answer/id #uuid "d38a48de-853d-5f1c-ab46-45101a7d57d9"] [:db/add "d38a48de-853d-5f1c-ab46-45101a7d57d9" :answer/type :answer.type/math] [:db/add "d38a48de-853d-5f1c-ab46-45101a7d57d9" :answer/value "-\\frac{1}{11}"] [:db/ensure "d38a48de-853d-5f1c-ab46-45101a7d57d9" :answer/validate] [:db/add "8d2b1619-66d8-5b91-9ab5-33a1de776b0f" :answer-field/id #uuid "8d2b1619-66d8-5b91-9ab5-33a1de776b0f"] [:db/add "8d2b1619-66d8-5b91-9ab5-33a1de776b0f" :answer-field/key "field-1"] [:db/add "8d2b1619-66d8-5b91-9ab5-33a1de776b0f" :answer-field/type :answer-field.type/blank] [:db/add "8d2b1619-66d8-5b91-9ab5-33a1de776b0f" :answer-field/choices "d38a48de-853d-5f1c-ab46-45101a7d57d9"] [:db/add "8d2b1619-66d8-5b91-9ab5-33a1de776b0f" :answer-field/correct "d38a48de-853d-5f1c-ab46-45101a7d57d9"] [:db/ensure "8d2b1619-66d8-5b91-9ab5-33a1de776b0f" :answer-field/validate] [:db/add "98465be8-fd70-5cdc-bb24-15806a36e6d8" :question/id #uuid "98465be8-fd70-5cdc-bb24-15806a36e6d8"] [:db/add "98465be8-fd70-5cdc-bb24-15806a36e6d8" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x-1)(x^{2}+x)\n$$\n\nat the point $\\left(-2,-6\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "98465be8-fd70-5cdc-bb24-15806a36e6d8" :question/worked-solution "Let $f(x)=(x-1)(x^{2}+x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}+x^{2}-x^{2}-x\\\\\n&=x^{3}-x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}-1\n$$\n\nThe tangent slope at $\\left(-2,-6\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-2)&=3\\left(-2\\right)^{2}-1\\\\\n&=12-1\\\\\n&=11\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(11\\right)}\\\\\n&=-\\frac{1}{11}\n\\end{aligned}\n$$"] [:db/add "98465be8-fd70-5cdc-bb24-15806a36e6d8" :question/difficulty :question.difficulty/moderate] [:db/add "98465be8-fd70-5cdc-bb24-15806a36e6d8" :question/answer-fields "8d2b1619-66d8-5b91-9ab5-33a1de776b0f"] [:db/ensure "98465be8-fd70-5cdc-bb24-15806a36e6d8" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "98465be8-fd70-5cdc-bb24-15806a36e6d8"] [:db/add "6d164aab-26ac-5cf6-9d2a-e3a8042493ec" :answer/id #uuid "6d164aab-26ac-5cf6-9d2a-e3a8042493ec"] [:db/add "6d164aab-26ac-5cf6-9d2a-e3a8042493ec" :answer/type :answer.type/math] [:db/add "6d164aab-26ac-5cf6-9d2a-e3a8042493ec" :answer/value "1"] [:db/ensure "6d164aab-26ac-5cf6-9d2a-e3a8042493ec" :answer/validate] [:db/add "10465f0c-4337-50c1-8344-ac1800a75eea" :answer-field/id #uuid "10465f0c-4337-50c1-8344-ac1800a75eea"] [:db/add "10465f0c-4337-50c1-8344-ac1800a75eea" :answer-field/key "field-1"] [:db/add "10465f0c-4337-50c1-8344-ac1800a75eea" :answer-field/type :answer-field.type/blank] [:db/add "10465f0c-4337-50c1-8344-ac1800a75eea" :answer-field/choices "6d164aab-26ac-5cf6-9d2a-e3a8042493ec"] [:db/add "10465f0c-4337-50c1-8344-ac1800a75eea" :answer-field/correct "6d164aab-26ac-5cf6-9d2a-e3a8042493ec"] [:db/ensure "10465f0c-4337-50c1-8344-ac1800a75eea" :answer-field/validate] [:db/add "13ffce0a-6aca-53fc-b21e-8eedd82600a4" :question/id #uuid "13ffce0a-6aca-53fc-b21e-8eedd82600a4"] [:db/add "13ffce0a-6aca-53fc-b21e-8eedd82600a4" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x-1)(x^{2}+2x)\n$$\n\nat the point $\\left(-1,2\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "13ffce0a-6aca-53fc-b21e-8eedd82600a4" :question/worked-solution "Let $f(x)=(x-1)(x^{2}+2x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}+2x^{2}-x^{2}-2x\\\\\n&=x^{3}+x^{2}-2x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}+2x-2\n$$\n\nThe tangent slope at $\\left(-1,2\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-1)&=3\\left(-1\\right)^{2}+2\\left(-1\\right)-2\\\\\n&=3-2-2\\\\\n&=-1\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-1\\right)}\\\\\n&=1\n\\end{aligned}\n$$"] [:db/add "13ffce0a-6aca-53fc-b21e-8eedd82600a4" :question/difficulty :question.difficulty/moderate] [:db/add "13ffce0a-6aca-53fc-b21e-8eedd82600a4" :question/answer-fields "10465f0c-4337-50c1-8344-ac1800a75eea"] [:db/ensure "13ffce0a-6aca-53fc-b21e-8eedd82600a4" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "13ffce0a-6aca-53fc-b21e-8eedd82600a4"] [:db/add "22a6e057-a944-51bf-b053-784fa4d9e5b0" :answer/id #uuid "22a6e057-a944-51bf-b053-784fa4d9e5b0"] [:db/add "22a6e057-a944-51bf-b053-784fa4d9e5b0" :answer/type :answer.type/math] [:db/add "22a6e057-a944-51bf-b053-784fa4d9e5b0" :answer/value "-\\frac{1}{2}"] [:db/ensure "22a6e057-a944-51bf-b053-784fa4d9e5b0" :answer/validate] [:db/add "ed16d1b4-3333-5ec8-8a35-d56846a4133f" :answer-field/id #uuid "ed16d1b4-3333-5ec8-8a35-d56846a4133f"] [:db/add "ed16d1b4-3333-5ec8-8a35-d56846a4133f" :answer-field/key "field-1"] [:db/add "ed16d1b4-3333-5ec8-8a35-d56846a4133f" :answer-field/type :answer-field.type/blank] [:db/add "ed16d1b4-3333-5ec8-8a35-d56846a4133f" :answer-field/choices "22a6e057-a944-51bf-b053-784fa4d9e5b0"] [:db/add "ed16d1b4-3333-5ec8-8a35-d56846a4133f" :answer-field/correct "22a6e057-a944-51bf-b053-784fa4d9e5b0"] [:db/ensure "ed16d1b4-3333-5ec8-8a35-d56846a4133f" :answer-field/validate] [:db/add "22201f9d-6ca9-5d62-bd59-8395f61f8ad5" :question/id #uuid "22201f9d-6ca9-5d62-bd59-8395f61f8ad5"] [:db/add "22201f9d-6ca9-5d62-bd59-8395f61f8ad5" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x-2)(x^{2}-x)\n$$\n\nat the point $\\left(2,0\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "22201f9d-6ca9-5d62-bd59-8395f61f8ad5" :question/worked-solution "Let $f(x)=(x-2)(x^{2}-x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}-x^{2}-2x^{2}+2x\\\\\n&=x^{3}-3x^{2}+2x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}-6x+2\n$$\n\nThe tangent slope at $\\left(2,0\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(2)&=3\\left(2\\right)^{2}-6\\left(2\\right)+2\\\\\n&=12-12+2\\\\\n&=2\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(2\\right)}\\\\\n&=-\\frac{1}{2}\n\\end{aligned}\n$$"] [:db/add "22201f9d-6ca9-5d62-bd59-8395f61f8ad5" :question/difficulty :question.difficulty/moderate] [:db/add "22201f9d-6ca9-5d62-bd59-8395f61f8ad5" :question/answer-fields "ed16d1b4-3333-5ec8-8a35-d56846a4133f"] [:db/ensure "22201f9d-6ca9-5d62-bd59-8395f61f8ad5" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "22201f9d-6ca9-5d62-bd59-8395f61f8ad5"] [:db/add "17c1a001-59d1-5ddb-b46a-5df5b4db950e" :answer/id #uuid "17c1a001-59d1-5ddb-b46a-5df5b4db950e"] [:db/add "17c1a001-59d1-5ddb-b46a-5df5b4db950e" :answer/type :answer.type/math] [:db/add "17c1a001-59d1-5ddb-b46a-5df5b4db950e" :answer/value "-\\frac{1}{14}"] [:db/ensure "17c1a001-59d1-5ddb-b46a-5df5b4db950e" :answer/validate] [:db/add "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9" :answer-field/id #uuid "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9"] [:db/add "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9" :answer-field/key "field-1"] [:db/add "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9" :answer-field/type :answer-field.type/blank] [:db/add "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9" :answer-field/choices "17c1a001-59d1-5ddb-b46a-5df5b4db950e"] [:db/add "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9" :answer-field/correct "17c1a001-59d1-5ddb-b46a-5df5b4db950e"] [:db/ensure "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9" :answer-field/validate] [:db/add "e6ca2069-f4a7-54c8-a819-485817a2cc11" :question/id #uuid "e6ca2069-f4a7-54c8-a819-485817a2cc11"] [:db/add "e6ca2069-f4a7-54c8-a819-485817a2cc11" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=(x+2)(x^{2}-x)\n$$\n\nat the point $\\left(2,8\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "e6ca2069-f4a7-54c8-a819-485817a2cc11" :question/worked-solution "Let $f(x)=(x+2)(x^{2}-x)$. Expand and combine like terms before differentiating.\n\n$$\n\\begin{aligned}\nf(x)&=x^{3}-x^{2}+2x^{2}-2x\\\\\n&=x^{3}+x^{2}-2x\n\\end{aligned}\n$$\n\nApply the power rule:\n\n$$\nf'(x)=3x^{2}+2x-2\n$$\n\nThe tangent slope at $\\left(2,8\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(2)&=3\\left(2\\right)^{2}+2\\left(2\\right)-2\\\\\n&=12+4-2\\\\\n&=14\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(14\\right)}\\\\\n&=-\\frac{1}{14}\n\\end{aligned}\n$$"] [:db/add "e6ca2069-f4a7-54c8-a819-485817a2cc11" :question/difficulty :question.difficulty/moderate] [:db/add "e6ca2069-f4a7-54c8-a819-485817a2cc11" :question/answer-fields "2dc91774-0db4-5ab3-a2f3-e5feeb1f79d9"] [:db/ensure "e6ca2069-f4a7-54c8-a819-485817a2cc11" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "e6ca2069-f4a7-54c8-a819-485817a2cc11"] [:db/ensure 17592186092384 :knowledge-point/validate]]
