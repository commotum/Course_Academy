#{[{:db/id #edb/ref 17592186092384 :knowledge-point/canonical-example {:db/id #edb/ref 17592186091953 :question/id #uuid "4a734f55-ceac-587c-a831-fa8bed578a99" :question/math-academy-id "e-148" :question/problem "Find the slope of the normal line to the curve $y = 2x^3 -x^2$ at the point $(1,1).$" :question/worked-solution "Let $f(x) = 2x^3-x^2.$ First, we compute the derivative:\n\n$$\nf'(x)  =6x^2 -2x\n$$\n\nThen, we compute the slope of the tangent at the point $(1,1)\\mathbin{:}$\n\n$$\nm=f'(1) = 6(1)^2 - 2(1) = 4\n$$\n\nTherefore, the slope of the normal line $m'$ is\n\n$$\nm' = -\\dfrac{1}{m} = -\\dfrac 1 4.\n$$"} :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050473 :topic/difficulty 1.1558263047756883 :topic/id #uuid "4c6d2580-78c9-5782-9c3a-465dcd055b32" :topic/knowledge-points [{:db/id #edb/ref 17592186175922} {:db/id #edb/ref 17592186175923} {:db/id #edb/ref 17592186175924}] :topic/math-academy-id 3562 :topic/next [{:db/id #edb/ref 17592186049021} {:db/id #edb/ref 17592186049119} {:db/id #edb/ref 17592186049564} {:db/id #edb/ref 17592186049583} {:db/id #edb/ref 17592186050409} {:db/id #edb/ref 17592186050667}] :topic/title "Finding Equations of Perpendicular Lines"} {:db/id #edb/ref 17592186050711 :topic/difficulty 0.9795434122769167 :topic/id #uuid "608cf86b-83ea-5cc3-a6a8-222e7fa44e21" :topic/knowledge-points [{:db/id #edb/ref 17592186064259} {:db/id #edb/ref 17592186064342} {:db/id #edb/ref 17592186064343}] :topic/math-academy-id 332 :topic/next [{:db/id #edb/ref 17592186048123} {:db/id #edb/ref 17592186048749} {:db/id #edb/ref 17592186050644}] :topic/title "Calculating the Slope of a Tangent Line Using Differentiation"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy}] :knowledge-point/question-generator {:db/id #edb/ref 17592186760982 :question-generator/id #uuid "f44affe9-e9f1-5885-9223-45e3d0e275b8" :question-generator/script "generators/57/57af8cd