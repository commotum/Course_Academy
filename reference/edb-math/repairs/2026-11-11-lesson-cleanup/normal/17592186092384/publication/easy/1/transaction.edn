[[:db/add "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e" :answer/id #uuid "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e"] [:db/add "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e" :answer/type :answer.type/math] [:db/add "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e" :answer/value "1"] [:db/ensure "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e" :answer/validate] [:db/add "981151e0-b847-57d4-bb2b-d31f434bc658" :answer-field/id #uuid "981151e0-b847-57d4-bb2b-d31f434bc658"] [:db/add "981151e0-b847-57d4-bb2b-d31f434bc658" :answer-field/key "field-1"] [:db/add "981151e0-b847-57d4-bb2b-d31f434bc658" :answer-field/type :answer-field.type/blank] [:db/add "981151e0-b847-57d4-bb2b-d31f434bc658" :answer-field/choices "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e"] [:db/add "981151e0-b847-57d4-bb2b-d31f434bc658" :answer-field/correct "9cdeaa78-d73a-5b5d-b05e-fea2019f5c9e"] [:db/ensure "981151e0-b847-57d4-bb2b-d31f434bc658" :answer-field/validate] [:db/add "29010ba2-70b7-5832-959a-392d77ed4cd8" :question/id #uuid "29010ba2-70b7-5832-959a-392d77ed4cd8"] [:db/add "29010ba2-70b7-5832-959a-392d77ed4cd8" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=-x^{2}-5x-2\n$$\n\nat the point $\\left(-2,4\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "29010ba2-70b7-5832-959a-392d77ed4cd8" :question/worked-solution "Let $f(x)=-x^{2}-5x-2$.\n\nApply the power rule:\n\n$$\nf'(x)=-2x-5\n$$\n\nThe tangent slope at $\\left(-2,4\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(-2)&=-2\\left(-2\\right)-5\\\\\n&=4-5\\\\\n&=-1\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-1\\right)}\\\\\n&=1\n\\end{aligned}\n$$"] [:db/add "29010ba2-70b7-5832-959a-392d77ed4cd8" :question/difficulty :question.difficulty/easy] [:db/add "29010ba2-70b7-5832-959a-392d77ed4cd8" :question/answer-fields "981151e0-b847-57d4-bb2b-d31f434bc658"] [:db/ensure "29010ba2-70b7-5832-959a-392d77ed4cd8" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "29010ba2-70b7-5832-959a-392d77ed4cd8"] [:db/add "1b4a9ef6-dbca-5e05-92d2-7f41c7084602" :answer/id #uuid "1b4a9ef6-dbca-5e05-92d2-7f41c7084602"] [:db/add "1b4a9ef6-dbca-5e05-92d2-7f41c7084602" :answer/type :answer.type/math] [:db/add "1b4a9ef6-dbca-5e05-92d2-7f41c7084602" :answer/value "1"] [:db/ensure "1b4a9ef6-dbca-5e05-92d2-7f41c7084602" :answer/validate] [:db/add "da1f960e-d781-548c-b06e-fdea25a71e5c" :answer-field/id #uuid "da1f960e-d781-548c-b06e-fdea25a71e5c"] [:db/add "da1f960e-d781-548c-b06e-fdea25a71e5c" :answer-field/key "field-1"] [:db/add "da1f960e-d781-548c-b06e-fdea25a71e5c" :answer-field/type :answer-field.type/blank] [:db/add "da1f960e-d781-548c-b06e-fdea25a71e5c" :answer-field/choices "1b4a9ef6-dbca-5e05-92d2-7f41c7084602"] [:db/add "da1f960e-d781-548c-b06e-fdea25a71e5c" :answer-field/correct "1b4a9ef6-dbca-5e05-92d2-7f41c7084602"] [:db/ensure "da1f960e-d781-548c-b06e-fdea25a71e5c" :answer-field/validate] [:db/add "d93532a0-89ea-5012-9358-b3864546a1c4" :question/id #uuid "d93532a0-89ea-5012-9358-b3864546a1c4"] [:db/add "d93532a0-89ea-5012-9358-b3864546a1c4" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=2x^{2}-5x-1\n$$\n\nat the point $\\left(1,-4\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "d93532a0-89ea-5012-9358-b3864546a1c4" :question/worked-solution "Let $f(x)=2x^{2}-5x-1$.\n\nApply the power rule:\n\n$$\nf'(x)=4x-5\n$$\n\nThe tangent slope at $\\left(1,-4\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(1)&=4\\left(1\\right)-5\\\\\n&=4-5\\\\\n&=-1\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-1\\right)}\\\\\n&=1\n\\end{aligned}\n$$"] [:db/add "d93532a0-89ea-5012-9358-b3864546a1c4" :question/difficulty :question.difficulty/easy] [:db/add "d93532a0-89ea-5012-9358-b3864546a1c4" :question/answer-fields "da1f960e-d781-548c-b06e-fdea25a71e5c"] [:db/ensure "d93532a0-89ea-5012-9358-b3864546a1c4" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "d93532a0-89ea-5012-9358-b3864546a1c4"] [:db/add "77e400f4-0130-574b-ac4f-08f4a984545f" :answer/id #uuid "77e400f4-0130-574b-ac4f-08f4a984545f"] [:db/add "77e400f4-0130-574b-ac4f-08f4a984545f" :answer/type :answer.type/math] [:db/add "77e400f4-0130-574b-ac4f-08f4a984545f" :answer/value "\\frac{1}{8}"] [:db/ensure "77e400f4-0130-574b-ac4f-08f4a984545f" :answer/validate] [:db/add "a2c55724-0e24-5ff8-a779-a363394e7665" :answer-field/id #uuid "a2c55724-0e24-5ff8-a779-a363394e7665"] [:db/add "a2c55724-0e24-5ff8-a779-a363394e7665" :answer-field/key "field-1"] [:db/add "a2c55724-0e24-5ff8-a779-a363394e7665" :answer-field/type :answer-field.type/blank] [:db/add "a2c55724-0e24-5ff8-a779-a363394e7665" :answer-field/choices "77e400f4-0130-574b-ac4f-08f4a984545f"] [:db/add "a2c55724-0e24-5ff8-a779-a363394e7665" :answer-field/correct "77e400f4-0130-574b-ac4f-08f4a984545f"] [:db/ensure "a2c55724-0e24-5ff8-a779-a363394e7665" :answer-field/validate] [:db/add "1e88392e-bd06-5cb1-82b0-30200767c300" :question/id #uuid "1e88392e-bd06-5cb1-82b0-30200767c300"] [:db/add "1e88392e-bd06-5cb1-82b0-30200767c300" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=-2x^{2}-4x+1\n$$\n\nat the point $\\left(1,-5\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "1e88392e-bd06-5cb1-82b0-30200767c300" :question/worked-solution "Let $f(x)=-2x^{2}-4x+1$.\n\nApply the power rule:\n\n$$\nf'(x)=-4x-4\n$$\n\nThe tangent slope at $\\left(1,-5\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(1)&=-4\\left(1\\right)-4\\\\\n&=-4-4\\\\\n&=-8\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(-8\\right)}\\\\\n&=\\frac{1}{8}\n\\end{aligned}\n$$"] [:db/add "1e88392e-bd06-5cb1-82b0-30200767c300" :question/difficulty :question.difficulty/easy] [:db/add "1e88392e-bd06-5cb1-82b0-30200767c300" :question/answer-fields "a2c55724-0e24-5ff8-a779-a363394e7665"] [:db/ensure "1e88392e-bd06-5cb1-82b0-30200767c300" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "1e88392e-bd06-5cb1-82b0-30200767c300"] [:db/add "9935b7f9-bb18-5144-add8-05879a24fef6" :answer/id #uuid "9935b7f9-bb18-5144-add8-05879a24fef6"] [:db/add "9935b7f9-bb18-5144-add8-05879a24fef6" :answer/type :answer.type/math] [:db/add "9935b7f9-bb18-5144-add8-05879a24fef6" :answer/value "-1"] [:db/ensure "9935b7f9-bb18-5144-add8-05879a24fef6" :answer/validate] [:db/add "51116206-260f-5b14-9471-2361b4d1a8ee" :answer-field/id #uuid "51116206-260f-5b14-9471-2361b4d1a8ee"] [:db/add "51116206-260f-5b14-9471-2361b4d1a8ee" :answer-field/key "field-1"] [:db/add "51116206-260f-5b14-9471-2361b4d1a8ee" :answer-field/type :answer-field.type/blank] [:db/add "51116206-260f-5b14-9471-2361b4d1a8ee" :answer-field/choices "9935b7f9-bb18-5144-add8-05879a24fef6"] [:db/add "51116206-260f-5b14-9471-2361b4d1a8ee" :answer-field/correct "9935b7f9-bb18-5144-add8-05879a24fef6"] [:db/ensure "51116206-260f-5b14-9471-2361b4d1a8ee" :answer-field/validate] [:db/add "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38" :question/id #uuid "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38"] [:db/add "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=-2x^{2}+5x-2\n$$\n\nat the point $\\left(1,1\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38" :question/worked-solution "Let $f(x)=-2x^{2}+5x-2$.\n\nApply the power rule:\n\n$$\nf'(x)=-4x+5\n$$\n\nThe tangent slope at $\\left(1,1\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(1)&=-4\\left(1\\right)+5\\\\\n&=-4+5\\\\\n&=1\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(1\\right)}\\\\\n&=-1\n\\end{aligned}\n$$"] [:db/add "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38" :question/difficulty :question.difficulty/easy] [:db/add "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38" :question/answer-fields "51116206-260f-5b14-9471-2361b4d1a8ee"] [:db/ensure "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "bee2509b-b7ac-5e50-95b1-d9ce7ab65b38"] [:db/add "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6" :answer/id #uuid "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6"] [:db/add "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6" :answer/type :answer.type/math] [:db/add "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6" :answer/value "-\\frac{1}{4}"] [:db/ensure "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6" :answer/validate] [:db/add "3111609d-bb1b-51cf-8f82-afb1fb63dc3b" :answer-field/id #uuid "3111609d-bb1b-51cf-8f82-afb1fb63dc3b"] [:db/add "3111609d-bb1b-51cf-8f82-afb1fb63dc3b" :answer-field/key "field-1"] [:db/add "3111609d-bb1b-51cf-8f82-afb1fb63dc3b" :answer-field/type :answer-field.type/blank] [:db/add "3111609d-bb1b-51cf-8f82-afb1fb63dc3b" :answer-field/choices "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6"] [:db/add "3111609d-bb1b-51cf-8f82-afb1fb63dc3b" :answer-field/correct "6044fbc3-71ab-5ae4-8d37-8ed1b737cfa6"] [:db/ensure "3111609d-bb1b-51cf-8f82-afb1fb63dc3b" :answer-field/validate] [:db/add "6f326c25-c303-5aac-84b9-ee058e3c0b7c" :question/id #uuid "6f326c25-c303-5aac-84b9-ee058e3c0b7c"] [:db/add "6f326c25-c303-5aac-84b9-ee058e3c0b7c" :question/problem "Find the slope $m'$ of the normal line to the curve\n\n$$\ny=2x^{2}-4x-1\n$$\n\nat the point $\\left(2,-1\\right)$. Give an exact answer.\n\n$m'=$\n{{field-1}}"] [:db/add "6f326c25-c303-5aac-84b9-ee058e3c0b7c" :question/worked-solution "Let $f(x)=2x^{2}-4x-1$.\n\nApply the power rule:\n\n$$\nf'(x)=4x-4\n$$\n\nThe tangent slope at $\\left(2,-1\\right)$ is\n\n$$\n\\begin{aligned}\nm=f'(2)&=4\\left(2\\right)-4\\\\\n&=8-4\\\\\n&=4\n\\end{aligned}\n$$\n\nThe normal is perpendicular to the tangent, so take the negative reciprocal:\n\n$$\n\\begin{aligned}\nm'&=-\\frac{1}{m}\\\\\n&=-\\frac{1}{\\left(4\\right)}\\\\\n&=-\\frac{1}{4}\n\\end{aligned}\n$$"] [:db/add "6f326c25-c303-5aac-84b9-ee058e3c0b7c" :question/difficulty :question.difficulty/easy] [:db/add "6f326c25-c303-5aac-84b9-ee058e3c0b7c" :question/answer-fields "3111609d-bb1b-51cf-8f82-afb1fb63dc3b"] [:db/ensure "6f326c25-c303-5aac-84b9-ee058e3c0b7c" :question/validate] [:db/add 17592186092384 :knowledge-point/questions "6f326c25-c303-5aac-84b9-ee058e3c0b7c"] [:db/ensure 17592186092384 :knowledge-point/validate]]
