{2}} + x, \\\\f'(x)&=1 - \\frac{1}{x^{\\frac{1}{2}}}=1 - \\frac{1}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(4)&=1 - \\frac{1}{\\sqrt{(4)}}=\\frac{1}{2}, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{\\left(\\frac{1}{2}\\right)}=-2.\n\\end{aligned}\n$$\n\nUse point-slope form through $(4,0)$.\n\n$$\n\\begin{aligned}\ny-(0)&=-2(x-(4)), \\\\y&=- 2 x + 8.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$.\n\n$$\n\\begin{aligned}\ny&=-2\\cdot 0+(8), \\\\y&=8.\n\\end{aligned}\n$$\n\nThe intersection is $(0,8)$."] [:db/add "34365ec9-a5ed-5c26-9151-b702279b6579" :question/difficulty :question.difficulty/hard] [:db/add "34365ec9-a5ed-5c26-9151-b702279b6579" :question/answer-fields "25dc6060-26fb-542d-afc0-849db5051640"] [:db/add "34365ec9-a5ed-5c26-9151-b702279b6579" :question/answer-fields "f6b02766-cdd0-58c2-a403-87a63135e6f0"] [:db/ensure "34365ec9-a5ed-5c26-9151-b702279b6579" :question/validate] [:db/add 17592186092385 :knowledge-point/questions "34365ec9-a5ed-5c26-9151-b702279b6579"] [:db/add "d36b435c-29df-52c3-9a8c-07c23f95d5a4" :answer/id #uuid "d36b435c-29df-52c3-9a8c-07c23f95d5a4"] [:db/add "d36b435c-29df-52c3-9a8c-07c23f95d5a4" :answer/type :answer.type/math] [:db/add "d36b435c-29df-52c3-9a8c-07c23f95d5a4" :answer/value "6"] [:db/ensure "d36b435c-29df-52c3-9a8c-07c23f95d5a4" :answer/validate] [:db/add "8da78daf-6784-5353-9207-672bbe849a44" :answer-field/id #uuid "8da78daf-6784-5353-9207-672bbe849a44"] [:db/add "8da78daf-6784-5353-9207-672bbe849a44" :answer-field/key "field-1"] [:db/add "8da78daf-6784-5353-9207-672bbe849a44" :answer-field/type :answer-field.type/blank] [:db/add "8da78daf-6784-5353-9207-672bbe849a44" :answer-field/choices "d36b435c-29df-52c3-9a8c-07c23f95d5a4"] [:db/add "8da78daf-6784-5353-9207-672bbe849a44" :answer-field/correct "d36b435c-29df-52c3-9a8c-07c23f95d5a4"] [:db/ensure "8da78daf-6784-5353-9207-672bbe849a44" :answer-field/validate] [:db/add "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae" :answer/id #uuid "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae"] [:db/add "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae" :answer/type :answer.type/math] [:db/add "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae" :answer/value "0"] [:db/ensure "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae" :answer/validate] [:db/add "87062f35-07be-5f09-a8a8-e2024b503454" :answer-field/id #uuid "87062f35-07be-5f09-a8a8-e2024b503454"] [:db/add "87062f35-07be-5f09-a8a8-e2024b503454" :answer-field/key "field-2"] [:db/add "87062f35-07be-5f09-a8a8-e2024b503454" :answer-field/type :answer-field.type/blank] [:db/add "87062f35-07be-5f09-a8a8-e2024b503454" :answer-field/choices "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae"] [:db/add "87062f35-07be-5f09-a8a8-e2024b503454" :answer-field/correct "d65474fb-03d8-5c5b-9a14-dbbc5bde4eae"] [:db/ensure "87062f35-07be-5f09-a8a8-e2024b503454" :answer-field/validate] [:db/add "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/id #uuid "e35487bf-219f-55b0-9fd0-0715bbba81c5"] [:db/add "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/problem "Find where the normal line to the curve $y=-4\\sqrt{x}+2x+2$ at the point with $x$-coordinate $4$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values."] [:db/add "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/worked-solution "First find the point on the curve.\n\n$$\nf(4)=-4\\sqrt{(4)}+2(4)+2=2.\n$$\n\nThe normal passes through $(4,2)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=- 4 x^{\\frac{1}{2}} + 2 x + 2, \\\\f'(x)&=2 - \\frac{2}{x^{\\frac{1}{2}}}=2 - \\frac{2}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(4)&=2 - \\frac{2}{\\sqrt{(4)}}=1, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(1)}=-1.\n\\end{aligned}\n$$\n\nUse point-slope form through $(4,2)$.\n\n$$\n\\begin{aligned}\ny-(2)&=-1(x-(4)), \\\\y&=- x + 6.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=-1x+(6), \\\\x&=6.\n\\end{aligned}\n$$\n\nThe intersection is $(6,0)$."] [:db/add "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/difficulty :question.difficulty/hard] [:db/add "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/answer-fields "8da78daf-6784-5353-9207-672bbe849a44"] [:db/add "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/answer-fields "87062f35-07be-5f09-a8a8-e2024b503454"] [:db/ensure "e35487bf-219f-55b0-9fd0-0715bbba81c5" :question/validate] [:db/add 17592186092385 :knowledge-point/questions "e35487bf-219f-55b0-9fd0-0715bbba81c5"] [:db/add "8b0b8981-f10c-5561-b81d-5c528ca31951" :answer/id #uuid "8b0b8981-f10c-5561-b81d-5c528ca31951"] [:db/add "8b0b8981-f10c-5561-b81d-5c528ca31951" :answer/type :answer.type/math] [:db/add "8b0b8981-f10c-5561-b81d-5c528ca31951" :answer/value "0"] [:db/ensure "8b0b8981-f10c-5561-b81d-5c528ca31951" :answer/validate] [:db/add "2f0f6a11-9696-5bf0-8067-b654217801a9" :answer-field/id #uuid "2f0f6a11-9696-5bf0-8067-b654217801a9"] [:db/add "2f0f6a11-9696-5bf0-8067-b654217801a9" :answer-field/key "field-1"] [:db/add "2f0f6a11-9696-5bf0-8067-b654217801a9" :answer-field/type :answer-field.type/blank] [:db/add "2f0f6a11-9696-5bf0-8067-b654217801a9" :answer-field/choices "8b0b8981-f10c-5561-b81d-5c528ca31951"] [:db/add "2f0f6a11-9696-5bf0-8067-b654217801a9" :answer-field/correct "8b0b8981-f10c-5561-b81d-5c528ca31951"] [:db/ensure "2f0f6a11-9696-5bf0-8067-b654217801a9" :answer-field/validate] [:db/add "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360" :answer/id #uuid "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360"] [:db/add "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360" :answer/type :answer.type/math] [:db/add "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360" :answer/value "14"] [:db/ensure "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360" :answer/validate] [:db/add "24a937cd-fccc-523b-b503-e84d8677c046" :answer-field/id #uuid "24a937cd-fccc-523b-b503-e84d8677c046"] [:db/add "24a937cd-fccc-523b-b503-e84d8677c046" :answer-field/key "field-2"] [:db/add "24a937cd-fccc-523b-b503-e84d8677c046" :answer-field/type :answer-field.type/blank] [:db/add "24a937cd-fccc-523b-b503-e84d8677c046" :answer-field/choices "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360"] [:db/add "24a937cd-fccc-523b-b503-e84d8677c046" :answer-field/correct "7eb3ce37-ee0d-54fb-8f44-ba7f5a5fe360"] [:db/ensure "24a937cd-fccc-523b-b503-e84d8677c046" :answer-field/validate] [:db/add "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/id #uuid "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9"] [:db/add "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/problem "Find where the normal line to the curve $y=4\\sqrt{x}+x$ at the point with $x$-coordinate $4$ intersects the $y$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values."] [:db/add "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/worked-solution "First find the point on the curve.\n\n$$\nf(4)=4\\sqrt{(4)}+(4)=12.\n$$\n\nThe normal passes through $(4,12)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=4 x^{\\frac{1}{2}} + x, \\\\f'(x)&=1 + \\frac{2}{x^{\\frac{1}{2}}}=1 + \\frac{2}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(4)&=1 + \\frac{2}{\\sqrt{(4)}}=2, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(2)}=- \\frac{1}{2}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(4,12)$.\n\n$$\n\\begin{aligned}\ny-(12)&=- \\frac{1}{2}(x-(4)), \\\\y&=- \\frac{x}{2} + 14.\n\\end{aligned}\n$$\n\nAt the $y$-axis, $x=0$.\n\n$$\n\\begin{aligned}\ny&=- \\frac{1}{2}\\cdot 0+(14), \\\\y&=14.\n\\end{aligned}\n$$\n\nThe intersection is $(0,14)$."] [:db/add "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/difficulty :question.difficulty/hard] [:db/add "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/answer-fields "2f0f6a11-9696-5bf0-8067-b654217801a9"] [:db/add "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/answer-fields "24a937cd-fccc-523b-b503-e84d8677c046"] [:db/ensure "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9" :question/validate] [:db/add 17592186092385 :knowledge-point/questions "33c230ad-4f63-530c-a4ad-bb1b06cb3ba9"] [:db/add "d5fe3843-2666-5a23-ac8e-eb9326ecd411" :answer/id #uuid "d5fe3843-2666-5a23-ac8e-eb9326ecd411"] [:db/add "d5fe3843-2666-5a23-ac8e-eb9326ecd411" :answer/type :answer.type/math] [:db/add "d5fe3843-2666-5a23-ac8e-eb9326ecd411" :answer/value "21"] [:db/ensure "d5fe3843-2666-5a23-ac8e-eb9326ecd411" :answer/validate] [:db/add "9a518425-569a-51a8-a4d8-0f11f8f17176" :answer-field/id #uuid "9a518425-569a-51a8-a4d8-0f11f8f17176"] [:db/add "9a518425-569a-51a8-a4d8-0f11f8f17176" :answer-field/key "field-1"] [:db/add "9a518425-569a-51a8-a4d8-0f11f8f17176" :answer-field/type :answer-field.type/blank] [:db/add "9a518425-569a-51a8-a4d8-0f11f8f17176" :answer-field/choices "d5fe3843-2666-5a23-ac8e-eb9326ecd411"] [:db/add "9a518425-569a-51a8-a4d8-0f11f8f17176" :answer-field/correct "d5fe3843-2666-5a23-ac8e-eb9326ecd411"] [:db/ensure "9a518425-569a-51a8-a4d8-0f11f8f17176" :answer-field/validate] [:db/add "8c86d08d-3b94-53f7-89a6-cb0989e3be18" :answer/id #uuid "8c86d08d-3b94-53f7-89a6-cb0989e3be18"] [:db/add "8c86d08d-3b94-53f7-89a6-cb0989e3be18" :answer/type :answer.type/math] [:db/add "8c86d08d-3b94-53f7-89a6-cb0989e3be18" :answer/value "0"] [:db/ensure "8c86d08d-3b94-53f7-89a6-cb0989e3be18" :answer/validate] [:db/add "9e5f5481-423d-5887-84a8-a268232322f6" :answer-field/id #uuid "9e5f5481-423d-5887-84a8-a268232322f6"] [:db/add "9e5f5481-423d-5887-84a8-a268232322f6" :answer-field/key "field-2"] [:db/add "9e5f5481-423d-5887-84a8-a268232322f6" :answer-field/type :answer-field.type/blank] [:db/add "9e5f5481-423d-5887-84a8-a268232322f6" :answer-field/choices "8c86d08d-3b94-53f7-89a6-cb0989e3be18"] [:db/add "9e5f5481-423d-5887-84a8-a268232322f6" :answer-field/correct "8c86d08d-3b94-53f7-89a6-cb0989e3be18"] [:db/ensure "9e5f5481-423d-5887-84a8-a268232322f6" :answer-field/validate] [:db/add "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/id #uuid "a04bfa45-58bc-50f8-86ea-6c7b8174dfef"] [:db/add "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/problem "Find where the normal line to the curve $y=2\\sqrt{x}+3x$ at the point with $x$-coordinate $1$ intersects the $x$-axis.\n\nThe intersection is $(${{field-1}}$,$ {{field-2}}$)$. Give exact values."] [:db/add "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/worked-solution "First find the point on the curve.\n\n$$\nf(1)=2\\sqrt{(1)}+3(1)=5.\n$$\n\nThe normal passes through $(1,5)$.\n\nRewrite the radical or reciprocal using powers, then differentiate.\n\n$$\n\\begin{aligned}\nf(x)&=2 x^{\\frac{1}{2}} + 3 x, \\\\f'(x)&=3 + \\frac{1}{x^{\\frac{1}{2}}}=3 + \\frac{1}{\\sqrt{x}}.\n\\end{aligned}\n$$\n\nEvaluate the tangent slope and take its negative reciprocal to find the normal slope.\n\n$$\n\\begin{aligned}\nm_t=f'(1)&=3 + \\frac{1}{\\sqrt{(1)}}=4, \\\\m_n=-\\frac{1}{m_t}&=-\\frac{1}{(4)}=- \\frac{1}{4}.\n\\end{aligned}\n$$\n\nUse point-slope form through $(1,5)$.\n\n$$\n\\begin{aligned}\ny-(5)&=- \\frac{1}{4}(x-(1)), \\\\y&=- \\frac{x}{4} + \\frac{21}{4}.\n\\end{aligned}\n$$\n\nAt the $x$-axis, $y=0$.\n\n$$\n\\begin{aligned}\n0&=- \\frac{1}{4}x+\\left(\\frac{21}{4}\\right), \\\\x&=21.\n\\end{aligned}\n$$\n\nThe intersection is $(21,0)$."] [:db/add "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/difficulty :question.difficulty/hard] [:db/add "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/answer-fields "9a518425-569a-51a8-a4d8-0f11f8f17176"] [:db/add "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/answer-fields "9e5f5481-423d-5887-84a8-a268232322f6"] [:db/ensure "a04bfa45-58bc-50f8-86ea-6c7b8174dfef" :question/validate] [:db/add 17592186092385 :knowledge-point/questions "a04bfa45-58bc-50f8-86ea-6c7b8174dfef"] [:db/ensure 17592186092385 :knowledge-point/validate]]
