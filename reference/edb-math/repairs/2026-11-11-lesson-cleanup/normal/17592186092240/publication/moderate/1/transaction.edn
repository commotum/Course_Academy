[[:db/add "1116b275-3031-5f4f-abb2-c17ba06fd42d" :answer/id #uuid "1116b275-3031-5f4f-abb2-c17ba06fd42d"] [:db/add "1116b275-3031-5f4f-abb2-c17ba06fd42d" :answer/type :answer.type/math] [:db/add "1116b275-3031-5f4f-abb2-c17ba06fd42d" :answer/value "-2"] [:db/ensure "1116b275-3031-5f4f-abb2-c17ba06fd42d" :answer/validate] [:db/add "40d2ae72-356e-525b-87a4-ca76f065948c" :answer-field/id #uuid "40d2ae72-356e-525b-87a4-ca76f065948c"] [:db/add "40d2ae72-356e-525b-87a4-ca76f065948c" :answer-field/key "coefficient"] [:db/add "40d2ae72-356e-525b-87a4-ca76f065948c" :answer-field/type :answer-field.type/blank] [:db/add "40d2ae72-356e-525b-87a4-ca76f065948c" :answer-field/choices "1116b275-3031-5f4f-abb2-c17ba06fd42d"] [:db/add "40d2ae72-356e-525b-87a4-ca76f065948c" :answer-field/correct "1116b275-3031-5f4f-abb2-c17ba06fd42d"] [:db/ensure "40d2ae72-356e-525b-87a4-ca76f065948c" :answer-field/validate] [:db/add "5f1c9d7b-ae44-5d71-957e-1cb49a93c426" :answer/id #uuid "5f1c9d7b-ae44-5d71-957e-1cb49a93c426"] [:db/add "5f1c9d7b-ae44-5d71-957e-1cb49a93c426" :answer/type :answer.type/math] [:db/add "5f1c9d7b-ae44-5d71-957e-1cb49a93c426" :answer/value "-3"] [:db/ensure "5f1c9d7b-ae44-5d71-957e-1cb49a93c426" :answer/validate] [:db/add "4840325e-2bf7-5909-9322-d70150c6ed72" :answer-field/id #uuid "4840325e-2bf7-5909-9322-d70150c6ed72"] [:db/add "4840325e-2bf7-5909-9322-d70150c6ed72" :answer-field/key "constant"] [:db/add "4840325e-2bf7-5909-9322-d70150c6ed72" :answer-field/type :answer-field.type/blank] [:db/add "4840325e-2bf7-5909-9322-d70150c6ed72" :answer-field/choices "5f1c9d7b-ae44-5d71-957e-1cb49a93c426"] [:db/add "4840325e-2bf7-5909-9322-d70150c6ed72" :answer-field/correct "5f1c9d7b-ae44-5d71-957e-1cb49a93c426"] [:db/ensure "4840325e-2bf7-5909-9322-d70150c6ed72" :answer-field/validate] [:db/add "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/id #uuid "39fa67c3-62a0-548a-8170-3fac475b3d2d"] [:db/add "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/problem "Find the equation of the normal line to the curve $y=2 x^{2} + 2 x + 1$ at $\\left(-1,1\\right)$.\n\nGive exact values of $a$ and $b$ in $x+ay=b$.\n\n$a=$ {{coefficient}}\n\n$b=$ {{constant}}"] [:db/add "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/worked-solution "Let $f(x)=2 x^{2} + 2 x + 1$. Differentiate:\n\n$$\nf'(x)=4 x + 2\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(-1\\right)=4 \\left(-1\\right) + 2=-2\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(-2\\right)}=\\frac{1}{2}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(1\\right)&=\\frac{1}{2}\\left(x-\\left(-1\\right)\\right)\\\\\ny&=\\frac{x}{2}+\\left(\\frac{1}{2}\\right)+\\left(1\\right)\\\\\ny&=\\frac{x}{2} + \\frac{3}{2}\\\\\n\\left(-2\\right)y&=-x+\\left(-1\\right)+\\left(-2\\right)\\\\\nx+\\left(-2\\right)y&=-3\n\\end{aligned}\n$$\n\nThe coefficient is $-2$ and the constant is $-3$."] [:db/add "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/difficulty :question.difficulty/moderate] [:db/add "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/answer-fields "40d2ae72-356e-525b-87a4-ca76f065948c"] [:db/add "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/answer-fields "4840325e-2bf7-5909-9322-d70150c6ed72"] [:db/ensure "39fa67c3-62a0-548a-8170-3fac475b3d2d" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "39fa67c3-62a0-548a-8170-3fac475b3d2d"] [:db/add "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49" :answer/id #uuid "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49"] [:db/add "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49" :answer/type :answer.type/math] [:db/add "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49" :answer/value "-4"] [:db/ensure "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49" :answer/validate] [:db/add "c2a7f7ed-4b00-58bf-b2d9-040432997b9c" :answer-field/id #uuid "c2a7f7ed-4b00-58bf-b2d9-040432997b9c"] [:db/add "c2a7f7ed-4b00-58bf-b2d9-040432997b9c" :answer-field/key "coefficient"] [:db/add "c2a7f7ed-4b00-58bf-b2d9-040432997b9c" :answer-field/type :answer-field.type/blank] [:db/add "c2a7f7ed-4b00-58bf-b2d9-040432997b9c" :answer-field/choices "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49"] [:db/add "c2a7f7ed-4b00-58bf-b2d9-040432997b9c" :answer-field/correct "cfbee6fa-ccf2-597f-9ca4-49c69c0cdd49"] [:db/ensure "c2a7f7ed-4b00-58bf-b2d9-040432997b9c" :answer-field/validate] [:db/add "092f3e13-18b0-5147-9334-655a4455b136" :answer/id #uuid "092f3e13-18b0-5147-9334-655a4455b136"] [:db/add "092f3e13-18b0-5147-9334-655a4455b136" :answer/type :answer.type/math] [:db/add "092f3e13-18b0-5147-9334-655a4455b136" :answer/value "-9"] [:db/ensure "092f3e13-18b0-5147-9334-655a4455b136" :answer/validate] [:db/add "ca114210-6ebb-53ac-bb72-5706d0693b4f" :answer-field/id #uuid "ca114210-6ebb-53ac-bb72-5706d0693b4f"] [:db/add "ca114210-6ebb-53ac-bb72-5706d0693b4f" :answer-field/key "constant"] [:db/add "ca114210-6ebb-53ac-bb72-5706d0693b4f" :answer-field/type :answer-field.type/blank] [:db/add "ca114210-6ebb-53ac-bb72-5706d0693b4f" :answer-field/choices "092f3e13-18b0-5147-9334-655a4455b136"] [:db/add "ca114210-6ebb-53ac-bb72-5706d0693b4f" :answer-field/correct "092f3e13-18b0-5147-9334-655a4455b136"] [:db/ensure "ca114210-6ebb-53ac-bb72-5706d0693b4f" :answer-field/validate] [:db/add "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/id #uuid "4ba14831-ccaf-5066-8ec7-2385271d6d52"] [:db/add "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/problem "Find the equation of the normal line to the curve $y=- x^{3} - x$ at $\\left(-1,2\\right)$.\n\nGive exact values of $a$ and $b$ in $x+ay=b$.\n\n$a=$ {{coefficient}}\n\n$b=$ {{constant}}"] [:db/add "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/worked-solution "Let $f(x)=- x^{3} - x$. Differentiate:\n\n$$\nf'(x)=- 3 x^{2} - 1\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(-1\\right)=- 3 \\left(-1\\right)^{2} - 1=-4\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(-4\\right)}=\\frac{1}{4}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(2\\right)&=\\frac{1}{4}\\left(x-\\left(-1\\right)\\right)\\\\\ny&=\\frac{x}{4}+\\left(\\frac{1}{4}\\right)+\\left(2\\right)\\\\\ny&=\\frac{x}{4} + \\frac{9}{4}\\\\\n\\left(-4\\right)y&=-x+\\left(-1\\right)+\\left(-8\\right)\\\\\nx+\\left(-4\\right)y&=-9\n\\end{aligned}\n$$\n\nThe coefficient is $-4$ and the constant is $-9$."] [:db/add "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/difficulty :question.difficulty/moderate] [:db/add "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/answer-fields "c2a7f7ed-4b00-58bf-b2d9-040432997b9c"] [:db/add "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/answer-fields "ca114210-6ebb-53ac-bb72-5706d0693b4f"] [:db/ensure "4ba14831-ccaf-5066-8ec7-2385271d6d52" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "4ba14831-ccaf-5066-8ec7-2385271d6d52"] [:db/add "b68fbb92-5681-57ab-9699-b40993969dbd" :answer/id #uuid "b68fbb92-5681-57ab-9699-b40993969dbd"] [:db/add "b68fbb92-5681-57ab-9699-b40993969dbd" :answer/type :answer.type/math] [:db/add "b68fbb92-5681-57ab-9699-b40993969dbd" :answer/value "-3"] [:db/ensure "b68fbb92-5681-57ab-9699-b40993969dbd" :answer/validate] [:db/add "8710b6f5-9fdc-551e-8ba5-09c18597e74b" :answer-field/id #uuid "8710b6f5-9fdc-551e-8ba5-09c18597e74b"] [:db/add "8710b6f5-9fdc-551e-8ba5-09c18597e74b" :answer-field/key "coefficient"] [:db/add "8710b6f5-9fdc-551e-8ba5-09c18597e74b" :answer-field/type :answer-field.type/blank] [:db/add "8710b6f5-9fdc-551e-8ba5-09c18597e74b" :answer-field/choices "b68fbb92-5681-57ab-9699-b40993969dbd"] [:db/add "8710b6f5-9fdc-551e-8ba5-09c18597e74b" :answer-field/correct "b68fbb92-5681-57ab-9699-b40993969dbd"] [:db/ensure "8710b6f5-9fdc-551e-8ba5-09c18597e74b" :answer-field/validate] [:db/add "d1c15051-b107-52bd-b010-99f06e9c015d" :answer/id #uuid "d1c15051-b107-52bd-b010-99f06e9c015d"] [:db/add "d1c15051-b107-52bd-b010-99f06e9c015d" :answer/type :answer.type/math] [:db/add "d1c15051-b107-52bd-b010-99f06e9c015d" :answer/value "-16"] [:db/ensure "d1c15051-b107-52bd-b010-99f06e9c015d" :answer/validate] [:db/add "18b87479-a840-5b94-aaf9-476a14d579bf" :answer-field/id #uuid "18b87479-a840-5b94-aaf9-476a14d579bf"] [:db/add "18b87479-a840-5b94-aaf9-476a14d579bf" :answer-field/key "constant"] [:db/add "18b87479-a840-5b94-aaf9-476a14d579bf" :answer-field/type :answer-field.type/blank] [:db/add "18b87479-a840-5b94-aaf9-476a14d579bf" :answer-field/choices "d1c15051-b107-52bd-b010-99f06e9c015d"] [:db/add "18b87479-a840-5b94-aaf9-476a14d579bf" :answer-field/correct "d1c15051-b107-52bd-b010-99f06e9c015d"] [:db/ensure "18b87479-a840-5b94-aaf9-476a14d579bf" :answer-field/validate] [:db/add "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/id #uuid "e7ec8128-9f8e-5a81-8ccf-813630666d31"] [:db/add "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/problem "Find the equation of the normal line to the curve $y=- \\frac{x^{6}}{8} + \\frac{7 x^{3}}{4}$ at $\\left(2,6\\right)$.\n\nGive exact values of $a$ and $b$ in $x+ay=b$.\n\n$a=$ {{coefficient}}\n\n$b=$ {{constant}}"] [:db/add "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/worked-solution "Let $f(x)=- \\frac{x^{6}}{8} + \\frac{7 x^{3}}{4}$. Differentiate:\n\n$$\nf'(x)=- \\frac{3 x^{5}}{4} + \\frac{21 x^{2}}{4}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(2\\right)=- \\frac{3 \\left(2\\right)^{5}}{4} + \\frac{21 \\left(2\\right)^{2}}{4}=-3\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(-3\\right)}=\\frac{1}{3}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(6\\right)&=\\frac{1}{3}\\left(x-\\left(2\\right)\\right)\\\\\ny&=\\frac{x}{3}+\\left(- \\frac{2}{3}\\right)+\\left(6\\right)\\\\\ny&=\\frac{x}{3} + \\frac{16}{3}\\\\\n\\left(-3\\right)y&=-x+\\left(2\\right)+\\left(-18\\right)\\\\\nx+\\left(-3\\right)y&=-16\n\\end{aligned}\n$$\n\nThe coefficient is $-3$ and the constant is $-16$."] [:db/add "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/difficulty :question.difficulty/moderate] [:db/add "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/answer-fields "8710b6f5-9fdc-551e-8ba5-09c18597e74b"] [:db/add "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/answer-fields "18b87479-a840-5b94-aaf9-476a14d579bf"] [:db/ensure "e7ec8128-9f8e-5a81-8ccf-813630666d31" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "e7ec8128-9f8e-5a81-8ccf-813630666d31"] [:db/add "47da1aea-5eff-533d-9ea8-12955dbd8a55" :answer/id #uuid "47da1aea-5eff-533d-9ea8-12955dbd8a55"] [:db/add "47da1aea-5eff-533d-9ea8-12955dbd8a55" :answer/type :answer.type/math] [:db/add "47da1aea-5eff-533d-9ea8-12955dbd8a55" :answer/value "6"] [:db/ensure "47da1aea-5eff-533d-9ea8-12955dbd8a55" :answer/validate] [:db/add "c92a2da9-fb77-53fc-9c10-e764c4184c88" :answer-field/id #uuid "c92a2da9-fb77-53fc-9c10-e764c4184c88"] [:db/add "c92a2da9-fb77-53fc-9c10-e764c4184c88" :answer-field/key "coefficient"] [:db/add "c92a2da9-fb77-53fc-9c10-e764c4184c88" :answer-field/type :answer-field.type/blank] [:db/add "c92a2da9-fb77-53fc-9c10-e764c4184c88" :answer-field/choices "47da1aea-5eff-533d-9ea8-12955dbd8a55"] [:db/add "c92a2da9-fb77-53fc-9c10-e764c4184c88" :answer-field/correct "47da1aea-5eff-533d-9ea8-12955dbd8a55"] [:db/ensure "c92a2da9-fb77-53fc-9c10-e764c4184c88" :answer-field/validate] [:db/add "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4" :answer/id #uuid "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4"] [:db/add "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4" :answer/type :answer.type/math] [:db/add "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4" :answer/value "38"] [:db/ensure "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4" :answer/validate] [:db/add "709e0431-757d-555e-bb01-ce0d6305a892" :answer-field/id #uuid "709e0431-757d-555e-bb01-ce0d6305a892"] [:db/add "709e0431-757d-555e-bb01-ce0d6305a892" :answer-field/key "constant"] [:db/add "709e0431-757d-555e-bb01-ce0d6305a892" :answer-field/type :answer-field.type/blank] [:db/add "709e0431-757d-555e-bb01-ce0d6305a892" :answer-field/choices "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4"] [:db/add "709e0431-757d-555e-bb01-ce0d6305a892" :answer-field/correct "e7f59ff4-f5d1-59c8-b571-40c28fbb84d4"] [:db/ensure "709e0431-757d-555e-bb01-ce0d6305a892" :answer-field/validate] [:db/add "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/id #uuid "616ce1da-bec2-552b-b86b-ceedf6d758da"] [:db/add "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/problem "Find the equation of the normal line to the curve $y=2 x^{2} - 2 x + 2$ at $\\left(2,6\\right)$.\n\nGive exact values of $a$ and $b$ in $x+ay=b$.\n\n$a=$ {{coefficient}}\n\n$b=$ {{constant}}"] [:db/add "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/worked-solution "Let $f(x)=2 x^{2} - 2 x + 2$. Differentiate:\n\n$$\nf'(x)=4 x - 2\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(2\\right)=4 \\left(2\\right) - 2=6\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(6\\right)}=- \\frac{1}{6}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(6\\right)&=- \\frac{1}{6}\\left(x-\\left(2\\right)\\right)\\\\\ny&=- \\frac{x}{6}+\\left(\\frac{1}{3}\\right)+\\left(6\\right)\\\\\ny&=\\frac{19}{3} - \\frac{x}{6}\\\\\n\\left(6\\right)y&=-x+\\left(2\\right)+\\left(36\\right)\\\\\nx+\\left(6\\right)y&=38\n\\end{aligned}\n$$\n\nThe coefficient is $6$ and the constant is $38$."] [:db/add "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/difficulty :question.difficulty/moderate] [:db/add "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/answer-fields "c92a2da9-fb77-53fc-9c10-e764c4184c88"] [:db/add "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/answer-fields "709e0431-757d-555e-bb01-ce0d6305a892"] [:db/ensure "616ce1da-bec2-552b-b86b-ceedf6d758da" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "616ce1da-bec2-552b-b86b-ceedf6d758da"] [:db/add "ed890029-b7b4-51a1-af4f-22b6f1