[[:db/add "51b444ec-82a6-5134-9f96-a061c5664c4c" :answer/id #uuid "51b444ec-82a6-5134-9f96-a061c5664c4c"] [:db/add "51b444ec-82a6-5134-9f96-a061c5664c4c" :answer/type :answer.type/math] [:db/add "51b444ec-82a6-5134-9f96-a061c5664c4c" :answer/value "-8"] [:db/ensure "51b444ec-82a6-5134-9f96-a061c5664c4c" :answer/validate] [:db/add "1fce9253-716e-5b24-ac23-23435721085f" :answer-field/id #uuid "1fce9253-716e-5b24-ac23-23435721085f"] [:db/add "1fce9253-716e-5b24-ac23-23435721085f" :answer-field/key "slope"] [:db/add "1fce9253-716e-5b24-ac23-23435721085f" :answer-field/type :answer-field.type/blank] [:db/add "1fce9253-716e-5b24-ac23-23435721085f" :answer-field/choices "51b444ec-82a6-5134-9f96-a061c5664c4c"] [:db/add "1fce9253-716e-5b24-ac23-23435721085f" :answer-field/correct "51b444ec-82a6-5134-9f96-a061c5664c4c"] [:db/ensure "1fce9253-716e-5b24-ac23-23435721085f" :answer-field/validate] [:db/add "a191428a-dfce-5282-ad4e-ac288a37a0dd" :answer/id #uuid "a191428a-dfce-5282-ad4e-ac288a37a0dd"] [:db/add "a191428a-dfce-5282-ad4e-ac288a37a0dd" :answer/type :answer.type/math] [:db/add "a191428a-dfce-5282-ad4e-ac288a37a0dd" :answer/value "\\frac{129}{4}"] [:db/ensure "a191428a-dfce-5282-ad4e-ac288a37a0dd" :answer/validate] [:db/add "719b9933-300e-5bba-b699-65646af0e67c" :answer-field/id #uuid "719b9933-300e-5bba-b699-65646af0e67c"] [:db/add "719b9933-300e-5bba-b699-65646af0e67c" :answer-field/key "intercept"] [:db/add "719b9933-300e-5bba-b699-65646af0e67c" :answer-field/type :answer-field.type/blank] [:db/add "719b9933-300e-5bba-b699-65646af0e67c" :answer-field/choices "a191428a-dfce-5282-ad4e-ac288a37a0dd"] [:db/add "719b9933-300e-5bba-b699-65646af0e67c" :answer-field/correct "a191428a-dfce-5282-ad4e-ac288a37a0dd"] [:db/ensure "719b9933-300e-5bba-b699-65646af0e67c" :answer-field/validate] [:db/add "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/id #uuid "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc"] [:db/add "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/problem "Find the equation of the normal line to the curve $y=1 - \\frac{1}{x} - \\frac{1}{\\sqrt{x}}$ at $\\left(4,\\frac{1}{4}\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/worked-solution "Let $f(x)=1 - \\frac{1}{x} - \\frac{1}{\\sqrt{x}}$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(-1x^{- \\frac{1}{2}})+(-1x^{-1})+(1)\\\\\nf'(x)&=\\frac{1}{x^{2}} + \\frac{1}{2 x^{\\frac{3}{2}}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(4\\right)=\\frac{1}{\\left(4\\right)^{2}} + \\frac{1}{2 \\left(4\\right)^{\\frac{3}{2}}}=\\frac{1}{8}\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(\\frac{1}{8}\\right)}=-8.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(\\frac{1}{4}\\right)&=-8\\left(x-\\left(4\\right)\\right)\\\\\ny&=- 8 x+\\left(32\\right)+\\left(\\frac{1}{4}\\right)\\\\\ny&=\\frac{129}{4} - 8 x\n\\end{aligned}\n$$\n\nThus $a=-8$ and $b=\\frac{129}{4}$."] [:db/add "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/difficulty :question.difficulty/hard] [:db/add "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/answer-fields "1fce9253-716e-5b24-ac23-23435721085f"] [:db/add "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/answer-fields "719b9933-300e-5bba-b699-65646af0e67c"] [:db/ensure "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "0eebeabb-6f2b-5bd5-8ffc-c7e26262f1dc"] [:db/add "f37c1814-b6e9-5483-8e1a-1f4ab64e201f" :answer/id #uuid "f37c1814-b6e9-5483-8e1a-1f4ab64e201f"] [:db/add "f37c1814-b6e9-5483-8e1a-1f4ab64e201f" :answer/type :answer.type/math] [:db/add "f37c1814-b6e9-5483-8e1a-1f4ab64e201f" :answer/value "- \\frac{3}{4}"] [:db/ensure "f37c1814-b6e9-5483-8e1a-1f4ab64e201f" :answer/validate] [:db/add "c8a2e337-1e09-5829-83f8-48b0ad2bc91e" :answer-field/id #uuid "c8a2e337-1e09-5829-83f8-48b0ad2bc91e"] [:db/add "c8a2e337-1e09-5829-83f8-48b0ad2bc91e" :answer-field/key "slope"] [:db/add "c8a2e337-1e09-5829-83f8-48b0ad2bc91e" :answer-field/type :answer-field.type/blank] [:db/add "c8a2e337-1e09-5829-83f8-48b0ad2bc91e" :answer-field/choices "f37c1814-b6e9-5483-8e1a-1f4ab64e201f"] [:db/add "c8a2e337-1e09-5829-83f8-48b0ad2bc91e" :answer-field/correct "f37c1814-b6e9-5483-8e1a-1f4ab64e201f"] [:db/ensure "c8a2e337-1e09-5829-83f8-48b0ad2bc91e" :answer-field/validate] [:db/add "c46be954-41d0-5992-b976-93e914b34b0f" :answer/id #uuid "c46be954-41d0-5992-b976-93e914b34b0f"] [:db/add "c46be954-41d0-5992-b976-93e914b34b0f" :answer/type :answer.type/math] [:db/add "c46be954-41d0-5992-b976-93e914b34b0f" :answer/value "\\frac{15}{4}"] [:db/ensure "c46be954-41d0-5992-b976-93e914b34b0f" :answer/validate] [:db/add "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4" :answer-field/id #uuid "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4"] [:db/add "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4" :answer-field/key "intercept"] [:db/add "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4" :answer-field/type :answer-field.type/blank] [:db/add "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4" :answer-field/choices "c46be954-41d0-5992-b976-93e914b34b0f"] [:db/add "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4" :answer-field/correct "c46be954-41d0-5992-b976-93e914b34b0f"] [:db/ensure "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4" :answer-field/validate] [:db/add "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/id #uuid "c8a86daf-29d3-5679-8c66-a7916a2fe96c"] [:db/add "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/problem "Find the equation of the normal line to the curve $y=\\sqrt[3]{x} + x + 1$ at $\\left(1,3\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/worked-solution "Let $f(x)=\\sqrt[3]{x} + x + 1$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(1x^{\\frac{1}{3}})+(1x^{1})+(1)\\\\\nf'(x)&=1 + \\frac{1}{3 x^{\\frac{2}{3}}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(1\\right)=1 + \\frac{1}{3 \\left(1\\right)^{\\frac{2}{3}}}=\\frac{4}{3}\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(\\frac{4}{3}\\right)}=- \\frac{3}{4}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(3\\right)&=- \\frac{3}{4}\\left(x-\\left(1\\right)\\right)\\\\\ny&=- \\frac{3 x}{4}+\\left(\\frac{3}{4}\\right)+\\left(3\\right)\\\\\ny&=\\frac{15}{4} - \\frac{3 x}{4}\n\\end{aligned}\n$$\n\nThus $a=- \\frac{3}{4}$ and $b=\\frac{15}{4}$."] [:db/add "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/difficulty :question.difficulty/hard] [:db/add "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/answer-fields "c8a2e337-1e09-5829-83f8-48b0ad2bc91e"] [:db/add "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/answer-fields "7ca7ea8e-0f3c-5534-be4c-96d2b71c9ee4"] [:db/ensure "c8a86daf-29d3-5679-8c66-a7916a2fe96c" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "c8a86daf-29d3-5679-8c66-a7916a2fe96c"] [:db/add "4424851a-600a-5d99-9588-ef0fd77654a6" :answer/id #uuid "4424851a-600a-5d99-9588-ef0fd77654a6"] [:db/add "4424851a-600a-5d99-9588-ef0fd77654a6" :answer/type :answer.type/math] [:db/add "4424851a-600a-5d99-9588-ef0fd77654a6" :answer/value "3"] [:db/ensure "4424851a-600a-5d99-9588-ef0fd77654a6" :answer/validate] [:db/add "2d696085-f4c3-5c6e-89dc-865b3e83e14d" :answer-field/id #uuid "2d696085-f4c3-5c6e-89dc-865b3e83e14d"] [:db/add "2d696085-f4c3-5c6e-89dc-865b3e83e14d" :answer-field/key "slope"] [:db/add "2d696085-f4c3-5c6e-89dc-865b3e83e14d" :answer-field/type :answer-field.type/blank] [:db/add "2d696085-f4c3-5c6e-89dc-865b3e83e14d" :answer-field/choices "4424851a-600a-5d99-9588-ef0fd77654a6"] [:db/add "2d696085-f4c3-5c6e-89dc-865b3e83e14d" :answer-field/correct "4424851a-600a-5d99-9588-ef0fd77654a6"] [:db/ensure "2d696085-f4c3-5c6e-89dc-865b3e83e14d" :answer-field/validate] [:db/add "ab883b8b-b08d-5252-a846-115605ef2dba" :answer/id #uuid "ab883b8b-b08d-5252-a846-115605ef2dba"] [:db/add "ab883b8b-b08d-5252-a846-115605ef2dba" :answer/type :answer.type/math] [:db/add "ab883b8b-b08d-5252-a846-115605ef2dba" :answer/value "-1"] [:db/ensure "ab883b8b-b08d-5252-a846-115605ef2dba" :answer/validate] [:db/add "476909fe-071a-52c7-8426-2febb47c355f" :answer-field/id #uuid "476909fe-071a-52c7-8426-2febb47c355f"] [:db/add "476909fe-071a-52c7-8426-2febb47c355f" :answer-field/key "intercept"] [:db/add "476909fe-071a-52c7-8426-2febb47c355f" :answer-field/type :answer-field.type/blank] [:db/add "476909fe-071a-52c7-8426-2febb47c355f" :answer-field/choices "ab883b8b-b08d-5252-a846-115605ef2dba"] [:db/add "476909fe-071a-52c7-8426-2febb47c355f" :answer-field/correct "ab883b8b-b08d-5252-a846-115605ef2dba"] [:db/ensure "476909fe-071a-52c7-8426-2febb47c355f" :answer-field/validate] [:db/add "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/id #uuid "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195"] [:db/add "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/problem "Find the equation of the normal line to the curve $y=2 \\sqrt[3]{x} - x + 1$ at $\\left(1,2\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/worked-solution "Let $f(x)=2 \\sqrt[3]{x} - x + 1$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(2x^{\\frac{1}{3}})+(-1x^{1})+(1)\\\\\nf'(x)&=-1 + \\frac{2}{3 x^{\\frac{2}{3}}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(1\\right)=-1 + \\frac{2}{3 \\left(1\\right)^{\\frac{2}{3}}}=- \\frac{1}{3}\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(- \\frac{1}{3}\\right)}=3.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(2\\right)&=3\\left(x-\\left(1\\right)\\right)\\\\\ny&=3 x+\\left(-3\\right)+\\left(2\\right)\\\\\ny&=3 x - 1\n\\end{aligned}\n$$\n\nThus $a=3$ and $b=-1$."] [:db/add "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/difficulty :question.difficulty/hard] [:db/add "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/answer-fields "2d696085-f4c3-5c6e-89dc-865b3e83e14d"] [:db/add "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/answer-fields "476909fe-071a-52c7-8426-2febb47c355f"] [:db/ensure "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "0fef9ef4-06cc-5ee7-9b0d-4fa0aee2b195"] [:db/add "047980f1-f5c2-5834-b437-18b3089116b7" :answer/id #uuid "047980f1-f5c2-5834-b437-18b3089116b7"] [:db/add "047980f1-f5c2-5834-b437-18b3089116b7" :answer/type :answer.type/math] [:db/add "047980f1-f5c2-5834-b437-18b3089116b7" :answer/value "1"] [:db/ensure "047980f1-f5c2-5834-b437-18b3089116b7" :answer/validate] [:db/add "347aac71-508e-50d6-8ca8-92488682008c" :answer-field/id #uuid "347aac71-508e-50d6-8ca8-92488682008c"] [:db/add "347aac71-508e-50d6-8ca8-92488682008c" :answer-field/key "slope"] [:db/add "347aac71-508e-50d6-8ca8-92488682008c" :answer-field/type :answer-field.type/blank] [:db/add "347aac71-508e-50d6-8ca8-92488682008c" :answer-field/choices "047980f1-f5c2-5834-b437-18b3089116b7"] [:db/add "347aac71-508e-50d6-8ca8-92488682008c" :answer-field/correct "047980f1-f5c2-5834-b437-18b3089116b7"] [:db/ensure "347aac71-508e-50d6-8ca8-92488682008c" :answer-field/validate] [:db/add "014aa6bc-ce3b-5b15-98b3-541883d21d7b" :answer/id #uuid "014aa6bc-ce3b-5b15-98b3-541883d21d7b"] [:db/add "014aa6bc-ce3b-5b15-98b3-541883d21d7b" :answer/type :answer.type/math] [:db/add "014aa6bc-ce3b-5b15-98b3-541883d21d7b" :answer/value "0"] [:db/ensure "014aa6bc-ce3b-5b15-98b3-541883d21d7b" :answer/validate] [:db/add "d01084c2-9d26-53aa-89f0-a5cdc5d275ea" :answer-field/id #uuid "d01084c2-9d26-53aa-89f0-a5cdc5d275ea"] [:db/add "d01084c2-9d26-53aa-89f0-a5cdc5d275ea" :answer-field/key "intercept"] [:db/add "d01084c2-9d26-53aa-89f0-a5cdc5d275ea" :answer-field/type :answer-field.type/blank] [:db/add "d01084c2-9d26-53aa-89f0-a5cdc5d275ea" :answer-field/choices "014aa6bc-ce3b-5b15-98b3-541883d21d7b"] [:db/add "d01084c2-9d26-53aa-89f0-a5cdc5d275ea" :answer-field/correct "014aa6bc-ce3b-5b15-98b3-541883d21d7b"] [:db/ensure "d01084c2-9d26-53aa-89f0-a5cdc5d275ea" :answer-field/validate] [:db/add "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/id #uuid "1014e800-5a2c-5f20-8875-1aa337cf96e8"] [:db/add "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/problem "Find the equation of the normal line to the curve $y=1 + \\frac{2}{x} - \\frac{2}{\\sqrt{x}}$ at $\\left(1,1\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/worked-solution "Let $f(x)=1 + \\frac{2}{x} - \\frac{2}{\\sqrt{x}}$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(-2x^{- \\frac{1}{2}})+(2x^{-1})+(1)\\\\\nf'(x)&=- \\frac{2}{x^{2}} + \\frac{1}{x^{\\frac{3}{2}}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(1\\right)=- \\frac{2}{\\left(1\\right)^{2}} + \\frac{1}{\\left(1\\right)^{\\frac{3}{2}}}=-1\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(-1\\right)}=1.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(1\\right)&=1\\left(x-\\left(1\\right)\\right)\\\\\ny&=x+\\left(-1\\right)+\\left(1\\right)\\\\\ny&=x\n\\end{aligned}\n$$\n\nThus $a=1$ and $b=0$."] [:db/add "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/difficulty :question.difficulty/hard] [:db/add "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/answer-fields "347aac71-508e-50d6-8ca8-92488682008c"] [:db/add "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/answer-fields "d01084c2-9d26-53aa-89f0-a5cdc5d275ea"] [:db/ensure "1014e800-5a2c-5f20-8875-1aa337cf96e8" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "1014e800-5a2c-5f20-8875-1aa337cf96e8"] [:db/add "14ae001f-e725-531b-9b33-0329f90f07ec" :answer/id #uuid "14ae001f-e725-531b-9b33-0329f90f07ec"] [:db/add "14ae001f-e725-531b-9b33-0329f90f07ec" :answer/type :answer.type/math] [:db/add "14ae001f-e725-531b-9b33-0329f90f07ec" :answer/value "-1"] [:db/ensure "14ae001f-e725-531b-9b33-0329f90f07ec" :answer/validate] [:db/add "efbefead-99cc-506e-a93b-471cd249ec53" :answer-field/id #uuid "efbefead-99cc-506e-a93b-471cd249ec53"] [:db/add "efbefead-99cc-506e-a93b-471cd249ec53" :answer-field/key "slope"] [:db/add "efbefead-99cc-506e-a93b-471cd249ec53" :answer-field/type :answer-field.type/blank] [:db/add "efbefead-99cc-506e-a93b-471cd249ec53" :answer-field/choices "14ae001f-e725-531b-9b33-0329f90f07ec"] [:db/add "efbefead-99cc-506e-a93b-471cd249ec53" :answer-field/correct "14ae001f-e725-531b-9b33-0329f90f07ec"] [:db/ensure "efbefead-99cc-506e-a93b-471cd249ec53" :answer-field/validate] [:db/add "5ceba755-0c1e-5955-bc5e-8040b5940580" :answer/id #uuid "5ceba755-0c1e-5955-bc5e-8040b5940580"] [:db/add "5ceba755-0c1e-5955-bc5e-8040b5940580" :answer/type :answer.type/math] [:db/add "5ceba755-0c1e-5955-bc5e-8040b5940580" :answer/value "- \\frac{1}{2}"] [:db/ensure "5ceba755-0c1e-5955-bc5e-8040b5940580" :answer/validate] [:db/add "c1f7305e-7023-5951-b86d-f19c0b5b9e21" :answer-field/id #uuid "c1f7305e-7023-5951-b86d-f19c0b5b9e21"] [:db/add "c1f7305e-7023-5951-b86d-f19c0b5b9e21" :answer-field/key "intercept"] [:db/add "c1f7305e-7023-5951-b86d-f19c0b5b9e21" :answer-field/type :answer-field.type/blank] [:db/add "c1f7305e-7023-5951-b86d-f19c0b5b9e21" :answer-field/choices "5ceba755-0c1e-5955-bc5e-8040b5940580"] [:db/add "c1f7305e-7023-5951-b86d-f19c0b5b9e21" :answer-field/correct "5ceba755-0c1e-5955-bc5e-8040b5940580"] [:db/ensure "c1f7305e-7023-5951-b86d-f19c0b5b9e21" :answer-field/validate] [:db/add "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/id #uuid "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b"] [:db/add "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/problem "Find the equation of the normal line to the curve $y=-1 - \\frac{2}{x} - \\frac{2}{x^{2}}$ at $\\left(2,- \\frac{5}{2}\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/worked-solution "Let $f(x)=-1 - \\frac{2}{x} - \\frac{2}{x^{2}}$. Rewrite with powers, then differentiate term by term:\n\n$$\n\\begin{aligned}\nf(x)&=(-2x^{-1})+(-2x^{-2})+(-1)\\\\\nf'(x)&=\\frac{2}{x^{2}} + \\frac{4}{x^{3}}\n\\end{aligned}\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(2\\right)=\\frac{2}{\\left(2\\right)^{2}} + \\frac{4}{\\left(2\\right)^{3}}=1\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(1\\right)}=-1.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(- \\frac{5}{2}\\right)&=-1\\left(x-\\left(2\\right)\\right)\\\\\ny&=- x+\\left(2\\right)+\\left(- \\frac{5}{2}\\right)\\\\\ny&=- x - \\frac{1}{2}\n\\end{aligned}\n$$\n\nThus $a=-1$ and $b=- \\frac{1}{2}$."] [:db/add "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/difficulty :question.difficulty/hard] [:db/add "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/answer-fields "efbefead-99cc-506e-a93b-471cd249ec53"] [:db/add "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/answer-fields "c1f7305e-7023-5951-b86d-f19c0b5b9e21"] [:db/ensure "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "f6dfc15e-6d7e-5386-aad7-f90a84fbc97b"] [:db/ensure 17592186092240 :knowledge-point/validate]]
