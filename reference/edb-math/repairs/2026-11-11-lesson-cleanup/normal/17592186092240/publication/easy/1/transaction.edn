d1e8e1-6c58-5feb-8546-1c89ed2de14b"] [:db/add "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b" :question/problem "Find the equation of the normal line to the curve $y=2 - x^{2}$ at $\\left(2,-2\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b" :question/worked-solution "Let $f(x)=2 - x^{2}$. Differentiate:\n\n$$\nf'(x)=- 2 x\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(2\\right)=- 2 \\left(2\\right)=-4\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(-4\\right)}=\\frac{1}{4}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(-2\\right)&=\\frac{1}{4}\\left(x-\\left(2\\right)\\right)\\\\\ny&=\\frac{x}{4}+\\left(- \\frac{1}{2}\\right)+\\left(-2\\right)\\\\\ny&=\\frac{x}{4} - \\frac{5}{2}\n\\end{aligned}\n$$\n\nThus $a=\\frac{1}{4}$ and $b=- \\frac{5}{2}$."] [:db/add "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b" :question/difficulty :question.difficulty/easy] [:db/add "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b" :question/answer-fields "2b22ee3e-60ac-5ee6-a8b3-12d700540dc9"] [:db/add "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b" :question/answer-fields "f4d9a343-fb61-557c-a955-b099bf209f82"] [:db/ensure "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "e1d1e8e1-6c58-5feb-8546-1c89ed2de14b"] [:db/add "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39" :answer/id #uuid "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39"] [:db/add "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39" :answer/type :answer.type/math] [:db/add "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39" :answer/value "- \\frac{1}{9}"] [:db/ensure "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39" :answer/validate] [:db/add "754662c5-3a1e-5018-8466-8be99aef7960" :answer-field/id #uuid "754662c5-3a1e-5018-8466-8be99aef7960"] [:db/add "754662c5-3a1e-5018-8466-8be99aef7960" :answer-field/key "slope"] [:db/add "754662c5-3a1e-5018-8466-8be99aef7960" :answer-field/type :answer-field.type/blank] [:db/add "754662c5-3a1e-5018-8466-8be99aef7960" :answer-field/choices "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39"] [:db/add "754662c5-3a1e-5018-8466-8be99aef7960" :answer-field/correct "33a7f804-47f2-59d5-9de0-ed7ef1b5fe39"] [:db/ensure "754662c5-3a1e-5018-8466-8be99aef7960" :answer-field/validate] [:db/add "4dd9549f-b3bd-5de3-8938-aa53298ef75b" :answer/id #uuid "4dd9549f-b3bd-5de3-8938-aa53298ef75b"] [:db/add "4dd9549f-b3bd-5de3-8938-aa53298ef75b" :answer/type :answer.type/math] [:db/add "4dd9549f-b3bd-5de3-8938-aa53298ef75b" :answer/value "\\frac{92}{9}"] [:db/ensure "4dd9549f-b3bd-5de3-8938-aa53298ef75b" :answer/validate] [:db/add "acc4aae5-f289-5b65-895e-552c65646dc6" :answer-field/id #uuid "acc4aae5-f289-5b65-895e-552c65646dc6"] [:db/add "acc4aae5-f289-5b65-895e-552c65646dc6" :answer-field/key "intercept"] [:db/add "acc4aae5-f289-5b65-895e-552c65646dc6" :answer-field/type :answer-field.type/blank] [:db/add "acc4aae5-f289-5b65-895e-552c65646dc6" :answer-field/choices "4dd9549f-b3bd-5de3-8938-aa53298ef75b"] [:db/add "acc4aae5-f289-5b65-895e-552c65646dc6" :answer-field/correct "4dd9549f-b3bd-5de3-8938-aa53298ef75b"] [:db/ensure "acc4aae5-f289-5b65-895e-552c65646dc6" :answer-field/validate] [:db/add "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/id #uuid "ea1b21db-b725-5c95-9dfd-e31f17ca067b"] [:db/add "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/problem "Find the equation of the normal line to the curve $y=2 x^{2} + x$ at $\\left(2,10\\right)$.\n\nGive exact values of $a$ and $b$ in $y=ax+b$.\n\n$a=$ {{slope}}\n\n$b=$ {{intercept}}"] [:db/add "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/worked-solution "Let $f(x)=2 x^{2} + x$. Differentiate:\n\n$$\nf'(x)=4 x + 1\n$$\n\nEvaluate the tangent slope at the supplied abscissa:\n\n$$\nm_t=f'\\left(2\\right)=4 \\left(2\\right) + 1=9\n$$\n\nThe normal is perpendicular to the tangent, so\n\n$$\nm_n=-\\frac{1}{m_t}=-\\frac{1}{\\left(9\\right)}=- \\frac{1}{9}.\n$$\n\nUse the point in point-slope form and rearrange:\n\n$$\n\\begin{aligned}\ny-\\left(10\\right)&=- \\frac{1}{9}\\left(x-\\left(2\\right)\\right)\\\\\ny&=- \\frac{x}{9}+\\left(\\frac{2}{9}\\right)+\\left(10\\right)\\\\\ny&=\\frac{92}{9} - \\frac{x}{9}\n\\end{aligned}\n$$\n\nThus $a=- \\frac{1}{9}$ and $b=\\frac{92}{9}$."] [:db/add "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/difficulty :question.difficulty/easy] [:db/add "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/answer-fields "754662c5-3a1e-5018-8466-8be99aef7960"] [:db/add "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/answer-fields "acc4aae5-f289-5b65-895e-552c65646dc6"] [:db/ensure "ea1b21db-b725-5c95-9dfd-e31f17ca067b" :question/validate] [:db/add 17592186092240 :knowledge-point/questions "ea1b21db-b725-5c95-9dfd-e31f17ca067b"] [:db/ensure 17592186092240 :knowledge-point/validate]]
