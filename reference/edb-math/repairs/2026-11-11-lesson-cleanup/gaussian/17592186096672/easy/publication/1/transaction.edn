& 2 & 2 & -1 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]"] [:db/ensure "20a5f230-f182-5cca-aa8a-dab8ea87ad0f" :answer/validate] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/id #uuid "e207af42-e08d-58a6-a71b-221e9cccc91a"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/key "selection"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/type :answer-field.type/radio] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/choices "3b5773dc-a57d-5db4-8627-0b4f0e34cac3"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/choices "61d80c3a-f3cc-5601-b187-1273305c90fa"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/choices "b35d9e9e-0998-551b-b4a1-f41600fa5ad6"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/choices "86ae8e62-3552-5744-b8c9-fb84687be42d"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/choices "20a5f230-f182-5cca-aa8a-dab8ea87ad0f"] [:db/add "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/correct "b35d9e9e-0998-551b-b4a1-f41600fa5ad6"] [:db/ensure "e207af42-e08d-58a6-a71b-221e9cccc91a" :answer-field/validate] [:db/add "49bb4710-b92e-54c7-b99c-2722f73c1b5c" :question/id #uuid "49bb4710-b92e-54c7-b99c-2722f73c1b5c"] [:db/add "49bb4710-b92e-54c7-b99c-2722f73c1b5c" :question/problem "Consider the augmented matrix\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & 2 & -1 \\\\ -2 & -3 & -2 & -2 \\\\ -1 & -2 & -4 & -5\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [:db/add "49bb4710-b92e-54c7-b99c-2722f73c1b5c" :question/worked-solution "The augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 2 & 2 & -1 \\\\ -2 & -3 & -2 & -2 \\\\ -1 & -2 & -4 & -5\\end{array}\\right].\n$$\n\nUsing $R_2:=R_2+2R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 2 & -1 \\\\ 0 & 1 & 2 & -4 \\\\ -1 & -2 & -4 & -5\\end{array}\\right].\n$$\n\nUsing $R_3:=R_3+R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 2 & -1 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & 0 & -2 & -6\\end{array}\\right].\n$$\n\nUsing $R_3:=-\\frac{1}{2}R_3$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 2 & -1 \\\\ 0 & 1 & 2 & -4 \\\\ 0 & 0 & 1 & 3\\end{array}\\right].\n$$\n\nThe matrix is in row echelon form: each pivot lies to the right of the pivot above it, with zeros below each pivot."] [:db/add "49bb4710-b92e-54c7-b99c-2722f73c1b5c" :question/difficulty :question.difficulty/easy] [:db/add "49bb4710-b92e-54c7-b99c-2722f73c1b5c" :question/answer-fields "e207af42-e08d-58a6-a71b-221e9cccc91a"] [:db/ensure "49bb4710-b92e-54c7-b99c-2722f73c1b5c" :question/validate] [:db/add 17592186096672 :knowledge-point/questions "49bb4710-b92e-54c7-b99c-2722f73c1b5c"] [:db/add "0df0bba8-f734-5b87-a8ff-f169effe8c29" :answer/id #uuid "0df0bba8-f734-5b87-a8ff-f169effe8c29"] [:db/add "0df0bba8-f734-5b87-a8ff-f169effe8c29" :answer/type :answer.type/math] [:db/add "0df0bba8-f734-5b87-a8ff-f169effe8c29" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]"] [:db/ensure "0df0bba8-f734-5b87-a8ff-f169effe8c29" :answer/validate] [:db/add "f2d88b9c-8dc3-5c25-86c5-299e362f6c74" :answer/id #uuid "f2d88b9c-8dc3-5c25-86c5-299e362f6c74"] [:db/add "f2d88b9c-8dc3-5c25-86c5-299e362f6c74" :answer/type :answer.type/math] [:db/add "f2d88b9c-8dc3-5c25-86c5-299e362f6c74" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]"] [:db/ensure "f2d88b9c-8dc3-5c25-86c5-299e362f6c74" :answer/validate] [:db/add "1575434f-9c16-5ae1-920b-eca5b0853d7c" :answer/id #uuid "1575434f-9c16-5ae1-920b-eca5b0853d7c"] [:db/add "1575434f-9c16-5ae1-920b-eca5b0853d7c" :answer/type :answer.type/math] [:db/add "1575434f-9c16-5ae1-920b-eca5b0853d7c" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]"] 