d #uuid "4edefd5c-4505-5968-9bc4-0b2aa552a2d8"] [:db/add "4edefd5c-4505-5968-9bc4-0b2aa552a2d8" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+z&=4 \\\\ -x+y-3z&=0 \\\\ x+3z&=4\\end{aligned}\\right..\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form."] [:db/add "4edefd5c-4505-5968-9bc4-0b2aa552a2d8" :question/worked-solution "The augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ -1 & 1 & -3 & 0 \\\\ 1 & 0 & 3 & 4\\end{array}\\right].\n$$\n\nUsing $R_2:=R_2+R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 1 & -2 & 4 \\\\ 1 & 0 & 3 & 4\\end{array}\\right].\n$$\n\nUsing $R_3:=R_3-R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 2 & 0\\end{array}\\right].\n$$\n\nUsing $R_3:=\\frac{1}{2}R_3$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 0 & 1 & 4 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 1 & 0\\end{array}\\right].\n$$\n\nThe matrix is in row echelon form: each pivot lies to the right of the pivot above it, with zeros below each pivot."] [:db/add "4edefd5c-4505-5968-9bc4-0b2aa552a2d8" :question/difficulty :question.difficulty/easy] [:db/add "4edefd5c-4505-5968-9bc4-0b2aa552a2d8" :question/answer-fields "ff85fd45-b5b0-5d1e-90dd-0afe88ca66ff"] [:db/ensure "4edefd5c-4505-5968-9bc4-0b2aa552a2d8" :question/validate] [:db/add 17592186096672 :knowledge-point/questions "4edefd5c-4505-5968-9bc4-0b2aa552a2d8"] [:db/add "cc4c26ac-98b7-51a4-9752-c8461dbbd0db" :answer/id #uuid "cc4c26ac-98b7-51a4-9752-c8461dbbd0db"] [:db/add "cc4c26ac-98b7-51a4-9752-c8461dbbd0db" :answer/type :answer.type/math] [:db/add "cc4c26ac-98b7-51a4-9752-c8461dbbd0db" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 2 & 1 & -1 \\\\ 0 & 1 & -2 & -2 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]"] [:db/ensure "cc4c26ac-98b7-51a4-9752-c8461dbbd0db" :answer/validate] [:db/add "89c59358-2660-5e3d-b084-32ac7c