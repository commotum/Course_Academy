6d63e-10fb-5e63-a587-3ae34befb46a" :question/validate] [:db/add 17592186096672 :knowledge-point/questions "0f16d63e-10fb-5e63-a587-3ae34befb46a"] [:db/add "508bf687-0850-5b20-b95c-c221ecbc51ac" :answer/id #uuid "508bf687-0850-5b20-b95c-c221ecbc51ac"] [:db/add "508bf687-0850-5b20-b95c-c221ecbc51ac" :answer/type :answer.type/math] [:db/add "508bf687-0850-5b20-b95c-c221ecbc51ac" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -4 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]"] [:db/ensure "508bf687-0850-5b20-b95c-c221ecbc51ac" :answer/validate] [:db/add "c2bf42ab-8674-543f-b198-26c627ff940b" :answer/id #uuid "c2bf42ab-8674-543f-b198-26c627ff940b"] [:db/add "c2bf42ab-8674-543f-b198-26c627ff940b" :answer/type :answer.type/math] [:db/add "c2bf42ab-8674-543f-b198-26c627ff940b" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -4 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 1 & -4\\end{array}\\right]"] [:db/ensure "c2bf42ab-8674-543f-b198-26c627ff940b" :answer/validate] [:db/add "9c9dd982-4e76-5032-a284-b772ea003303" :answer/id #uuid "9c9dd982-4e76-5032-a284-b772ea003303"] [:db/add "9c9dd982-4e76-5032-a284-b772ea003303" :answer/type :answer.type/math] [:db/add "9c9dd982-4e76-5032-a284-b772ea003303" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -4 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]"] [:db/ensure "9c9dd982-4e76-5032-a284-b772ea003303" :answer/validate] [:db/add "07865d8d-aa88-53b9-9dac-b30ad94ffc45" :answer/id #uuid "07865d8d-aa88-53b9-9dac-b30ad94ffc45"] [:db/add "07865d8d-aa88-53b9-9dac-b30ad94ffc45" :answer/type :answer.type/math] [:db/add "07865d8d-aa88-53b9-9dac-b30ad94ffc45" :answer/value "M\\sim \\left[\\begin{array}{ccc|c}1 & 1 & 0 & -4 \\\\ 0 & 1 & 0 & -4 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]"] [:db/ensure "07865d8d-aa88-53b9-9dac-b30ad94ffc45" :answer/validate] [:db/add "a858fabb-7bd6-5134-b6e2-238955bad2f6" :answer/id #uuid "a858fabb-7bd6-5134-b6e2-238955bad2f6"] [:db/add "a858fabb-7bd6-5134-b6e2-23