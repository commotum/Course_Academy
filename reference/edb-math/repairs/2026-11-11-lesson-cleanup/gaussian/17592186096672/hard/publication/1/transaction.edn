15d2e3b71"] [:db/add "779664c7-5a51-56a2-932c-dc44af522327" :answer-field/choices "3ec3d6eb-c003-5b63-99b1-ab8eefbbc7cc"] [:db/add "779664c7-5a51-56a2-932c-dc44af522327" :answer-field/correct "1ba3caa4-c9f4-52c4-a704-3b342ca7e518"] [:db/ensure "779664c7-5a51-56a2-932c-dc44af522327" :answer-field/validate] [:db/add "fade46b1-3adf-5ab6-8e99-7a231061d220" :question/id #uuid "fade46b1-3adf-5ab6-8e99-7a231061d220"] [:db/add "fade46b1-3adf-5ab6-8e99-7a231061d220" :question/problem "Consider the augmented matrix\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 0 & 8 \\\\ 2 & -4 & 0 & 2 \\\\ -1 & 3 & -2 & 2\\end{array}\\right].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [:db/add "fade46b1-3adf-5ab6-8e99-7a231061d220" :question/worked-solution "The augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}2 & -2 & 0 & 8 \\\\ 2 & -4 & 0 & 2 \\\\ -1 & 3 & -2 & 2\\end{array}\\right].\n$$\n\nUsing $R_1:=\\frac{1}{2}R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ 2 & -4 & 0 & 2 \\\\ -1 & 3 & -2 & 2\\end{array}\\right].\n$$\n\nUsing $R_2:=R_2-2R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ 0 & -2 & 0 & -6 \\\\ -1 & 3 & -2 & 2\\end{array}\\right].\n$$\n\nUsing $R_3:=R_3+R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ 0 & -2 & 0 & -6 \\\\ 0 & 2 & -2 & 6\\end{array}\\right].\n$$\n\nUsing $R_2:=-\\frac{1}{2}R_2$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 2 & -2 & 6\\end{array}\\right].\n$$\n\nUsing $R_3:=R_3-2R_2$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & -2 & 0\\end{array}\\right].\n$$\n\nUsing $R_3:=-\\frac{1}{2}R_3$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 4 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 0\\end{array}\\right].\n$$\n\nThe matrix is in row echelon form: each pivot lies to the right of the pivot above it, with zeros below each pivot.\n\nThe corresponding triangular system is\n\n$$\n\\left\\{\\begin{aligned}x-y&=4 \\\\ y&=3 \\\\ z&=0\\end{aligned}\\right..\n$$\n\nBack substitution gives\n\n$$\n\\begin{aligned}z&=0 \\\\ y&=3-(0)(0)=3 \\\\ x&=4-(-1)(3)-(0)(0)=7.\\end{aligned}\n$$\n\nTherefore, the solution is $\\langle 7,3,0\\rangle$."] [:db/add "fade46b1-3adf-5ab6-8e99-7a231061d220" :question/difficulty :question.difficulty/hard] [:db/add "fade46b1-3adf-5ab6-8e99-7a231061d220" :question/answer-fields "779664c7-5a51-56a2-932c-dc44af522327"] [:db/ensure "fade46b1-3adf-5ab6-8e99-7a231061d220" :question/validate] [:db/add 17592186096672 :knowledge-point/questions "fade46b1-3adf-5ab6-8e99-7a231061d220"] [:db/add "8872e7bb-1fea-5423-a5b5-7e5386a94478" :answer/id #uuid "8872e7bb-1fea-5423-a5b5-7e5386a94478"] [:db/add "8872e7bb-1fea-5423-a5b5-7e5386a94478" :answer/type :answer.type/math] [:db/add "8872e7bb-1fea-5423-a5b5-7e5386a94478" :answer/value "x=-3,\\quad y=3,\\quad z=3"] [:db/ensure "8872e7bb-1fea-5423-a5b5-7e5386a94478" :answer/validate] [:db/add "468f9f11-871f-5aa3-a40e-6b60d0376edf" :answer/id #uuid "468f9f11-871f-5aa3-a40e-6b60d0376edf"] [:db/add "468f9f11-871f-5aa3-a40e-6b60d0376edf" :answer/type :answer.type/math] [:db/add "468f9f11-871f-5aa3-a40e-6b60d0376edf" :answer/value "x=3,\\quad y=-3,\\quad z=-3"] [:db/ensure "468f9f11-871f-5aa3-a40e-6b60d0376edf" :answer/validate] [:db/add "b787104b-48b4-5c70-9328-dccbef931e2e" :answer/id #uuid "b787104b-48b4-5c70-9328-dccbef931e2e"] [:db/add "b787104b-48b4-5c70-9328-dccbef931e2e" :answer/type :answer.type/math] [:db/add "b787104b-48b4-5c70-9328-dccbef931e2e" :answer/value "x=4,\\quad y=-4,\\quad z=-4"] [:db/ensure "b787104b-48b4-5c70-9328-dccbef931e2e" :answer/validate] [:db/add "ba7b1168-f177-5c05-a86c-37b22bf23b35" :answer/id #uuid "ba7b1168-f177-5c05-a86c-37b22bf23b35"] [:db/add "ba7b1168-f177-5c05-a86c-37b22bf23b35" :answer/type :answer.type/math] [:db/add "ba7b1168-f177-5c05-a86c-37b22bf23b35" :answer/value "x=-1,\\quad y=1,\\quad z=1"] [:db/ensure "ba7b1168-f177-5c05-a86c-37b22bf23b35" :answer/validate] [:db/add "681b012f-e17f-5e27-a2e7-01ffb8570f74" :answer/id #uuid "681b012f-e17f-5e27-a2e7-01ffb8570f74"] [:db/add "681b012f-e17f-5e27-a2e7-01ffb8570f74" :answer/type :answer.type/math] [:db/add "681b012f-e17f-5e27-a2e7-01ffb8570f74" :answer/value "x=2,\\quad y=-2,\\quad z=-2"] [:db/ensure "681b012f-e17f-5e27-a2e7-01ffb8570f74" :answer/validate] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/id #uuid "7d52a6bc-0a49-50ec-b701-191e28c37218"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/key "selection"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/type :answer-field.type/radio] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/choices "8872e7bb-1fea-5423-a5b5-7e5386a94478"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/choices "468f9f11-871f-5aa3-a40e-6b60d0376edf"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/choices "b787104b-48b4-5c70-9328-dccbef931e2e"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/choices "ba7b1168-f177-5c05-a86c-37b22bf23b35"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/choices "681b012f-e17f-5e27-a2e7-01ffb8570f74"] [:db/add "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/correct "8872e7bb-1fea-5423-a5b5-7e5386a94478"] [:db/ensure "7d52a6bc-0a49-50ec-b701-191e28c37218" :answer-field/validate] [:db/add "4b5b8295-4a52-582a-bdaa-4c65f3858954" :question/id #uuid "4b5b8295-4a52-582a-bdaa-4c65f3858954"] [:db/add "4b5b8295-4a52-582a-bdaa-4c65f3858954" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-2x+2y-4z&=0 \\\\ x+y&=0 \\\\ -x+3y-z&=9\\end{aligned}\\right..\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system."] [:db/add "4b5b8295-4a52-582a-bdaa-4c65f3858954" :question/worked-solution "The augmented matrix is\n\n$$\nM=\\left[\\begin{array}{ccc|c}-2 & 2 & -4 & 0 \\\\ 1 & 1 & 0 & 0 \\\\ -1 & 3 & -1 & 9\\end{array}\\right].\n$$\n\nUsing $R_1:=-\\frac{1}{2}R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 2 & 0 \\\\ 1 & 1 & 0 & 0 \\\\ -1 & 3 & -1 & 9\\end{array}\\right].\n$$\n\nUsing $R_2:=R_2-R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 2 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ -1 & 3 & -1 & 9\\end{array}\\right].\n$$\n\nUsing $R_3:=R_3+R_1$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 2 & 0 \\\\ 0 & 2 & -2 & 0 \\\\ 0 & 2 & 1 & 9\\end{array}\\right].\n$$\n\nUsing $R_2:=\\frac{1}{2}R_2$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 2 & 0 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & 2 & 1 & 9\\end{array}\\right].\n$$\n\nUsing $R_3:=R_3-2R_2$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 2 & 0 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & 0 & 3 & 9\\end{array}\\right].\n$$\n\nUsing $R_3:=\\frac{1}{3}R_3$, we obtain\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 2 & 0 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & 0 & 1 & 3\\end{array}\\right].\n$$\n\nThe matrix is in row echelon form: each pivot lies to the right of the pivot above it, with zeros below each pivot.\n\nThe corresponding triangular system is\n\n$$\n\\left\\{\\begin{aligned}x-y+2z&=0 \\\\ y-z&=0 \\\\ z&=3\\end{aligned}\\right..\n$$\n\nBack substitution gives\n\n$$\n\\begin{aligned}z&=3 \\\\ y&=0-(-1)(3)=3 \\\\ x&=0-(-1)(3)-(2)(3)=-3.\\end{aligned}\n$$\n\nTherefore, the solution is $\\langle -3,3,3\\rangle$."] [:db/add "4b5b8295-4a52-582a-bdaa-4c65f3858954" :question/difficulty :question.difficulty/hard] [:db/add "4b5b8295-4a52-582a-bdaa-4c65f3858954" :question/answer-fields "7d52a6bc-0a49-50ec-b701-191e28c37218"] [:db/ensure "4b5b8295-4a52-582a-bdaa-4c65f3858954" :question/validate] [:db/add 17592186096672 :knowledge-point/questions "4b5b8295-4a52-582a-bdaa-4c65f3858954"] [:db/ensure 17592186096672 :knowledge-point/validate]]
