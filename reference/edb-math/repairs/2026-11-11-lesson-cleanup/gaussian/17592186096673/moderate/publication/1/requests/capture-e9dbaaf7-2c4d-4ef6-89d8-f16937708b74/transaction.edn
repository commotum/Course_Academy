19-aedd-e4091de5d29e"] [:db/add "fd66c9fb-b647-5717-8e9c-858f87049edc" :answer-field/choices "dcdc7c4c-f184-59e8-a393-18630ecfec70"] [:db/add "fd66c9fb-b647-5717-8e9c-858f87049edc" :answer-field/correct "dcdc7c4c-f184-59e8-a393-18630ecfec70"] [:db/ensure "fd66c9fb-b647-5717-8e9c-858f87049edc" :answer-field/validate] [:db/add "6f71952a-6cf5-5c1b-baed-c8962647cd28" :question/id #uuid "6f71952a-6cf5-5c1b-baed-c8962647cd28"] [:db/add "6f71952a-6cf5-5c1b-baed-c8962647cd28" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}2 & -6 & 4 & -2 \\\\ -2 & 6 & -5 & 6 \\\\ -1 & 6 & -8 & 10\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form. Select the resulting augmented matrix."] [:db/add "6f71952a-6cf5-5c1b-baed-c8962647cd28" :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}2 & -6 & 4 & -2 \\\\ -2 & 6 & -5 & 6 \\\\ -1 & 6 & -8 & 10\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=\\frac{1}{2}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ -2 & 6 & -5 & 6 \\\\ -1 & 6 & -8 & 10\\end{array}\\right]\n$$\n\n$R_2:=R_2+(2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 0 & -1 & 4 \\\\ -1 & 6 & -8 & 10\\end{array}\\right]\n$$\n\n$R_3:=R_3+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 0 & -1 & 4 \\\\ 0 & 3 & -6 & 9\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 3 & -6 & 9 \\\\ 0 & 0 & -1 & 4\\end{array}\\right]\n$$\n\nNormalize with $R_2:=\\frac{1}{3}R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & -1 & 4\\end{array}\\right]\n$$\n\nNormalize with $R_3:=-1R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & -4\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & 2 & -1 \\\\ 0 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & -4\\end{array}\\right]\n$$\n\n"] [:db/add "6f71952a-6cf5-5c1b-baed-c8962647cd28" :question/difficulty :question.difficulty/moderate] [:db/add "6f71952a-6cf5-5c1b-baed-c8962647cd28" :question/answer-fields "fd66c9fb-b647-5717-8e9c-858f87049edc"] [:db/ensure "6f71952a-6cf5-5c1b-baed-c8962647cd28" :question/validate] [:db/add 17592186096673 :knowledge-point/questions "6f71952a-6cf5-5c1b-baed-c8962647cd28"] [:db/add "60f14f8c-9b14-5aaf-ab22-677a6bc7fe24" :answer/id #uuid "60f14f8c-9b14-5aaf-ab22-677a6bc7fe24"] [:db/add "60f14f8c-9b14-5aaf-ab22-677a6bc7fe24" :answer/type :answer.type/math] [:db/add "60f14f8c-9b14-5aaf-ab22-677a6bc7fe24" :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & 2 & 4 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]"] [:db/ensure "60f14f8c-9b14-5aaf-ab22-677a6bc7fe24" :answer/validate] [:db/add "00ab9327-a395-5bc2-9e36-e16b5f62a316" :answer/id #uuid "00ab9327-a395-5bc2-9e36-e16b5f62a316"] [:db/add "00ab9327-a395-5bc2-9e36-e16b5f62a316" :answer/type :answer.type/math] [:db/add "00ab9327-a395-5bc2-9e36-e16b5f62a316" :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & -2 & 4 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]"] [:db/ensure "00ab9327-a395-5bc2-9e36-e16b5f62a316" :answer/validate] [:db/add "7c6f0eb1-3f77-562e-98d7-4ae0c4628346" :answer/id #uuid "7c6f0eb1-3f77-562e-98d7-4ae0c4628346"] [:db/add "7c6f0eb1-3f77-562e-98d7-4ae0c4628346" :answer/type :answer.type/math] [:db/add "7c6f0eb1-3f77-562e-98d7-4ae0c4628346" :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & 0 & 5 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]"] [:db/ensure "7c6f0eb1-3f77-562e-98d7-4ae0c4628346" :answer/validate] [:db/add "af9eb6a0-25f4-5551-bad7-fbba6800026f" :answer/id #uuid "af9eb6a0-25f4-5551-bad7-fbba6800026f"] [:db/add "af9eb6a0-25f4-5551-bad7-fbba6800026f" :answer/type :answer.type/math] [:db/add "af9eb6a0-25f4-5551-bad7-fbba6800026f" :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & -1 & 4 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]"] [:db/ensure "af9eb6a0-25f4-5551-bad7-fbba6800026f" :answer/validate] [:db/add "21316c3a-f718-58e3-a4a2-9547bb2593bf" :answer/id #uuid "21316c3a-f718-58e3-a4a2-9547bb2593bf"] [:db/add "21316c3a-f718-58e3-a4a2-9547bb2593bf" :answer/type :answer.type/math] [:db/add "21316c3a-f718-58e3-a4a2-9547bb2593bf" :answer/value "\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]"] [:db/ensure "21316c3a-f718-58e3-a4a2-9547bb2593bf" :answer/validate] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/id #uuid "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/key "selection"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/type :answer-field.type/radio] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/choices "60f14f8c-9b14-5aaf-ab22-677a6bc7fe24"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/choices "00ab9327-a395-5bc2-9e36-e16b5f62a316"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/choices "7c6f0eb1-3f77-562e-98d7-4ae0c4628346"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/choices "af9eb6a0-25f4-5551-bad7-fbba6800026f"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/choices "21316c3a-f718-58e3-a4a2-9547bb2593bf"] [:db/add "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/correct "21316c3a-f718-58e3-a4a2-9547bb2593bf"] [:db/ensure "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8" :answer-field/validate] [:db/add "9393fded-f9c2-50dc-99ee-2d56fb3f3545" :question/id #uuid "9393fded-f9c2-50dc-99ee-2d56fb3f3545"] [:db/add "9393fded-f9c2-50dc-99ee-2d56fb3f3545" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-2x-6y+2z &=6 \\\\ -x-3y &=-1 \\\\ -y &=-2\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form. Select the resulting augmented matrix."] [:db/add "9393fded-f9c2-50dc-99ee-2d56fb3f3545" :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}-2 & -6 & 2 & 6 \\\\ -1 & -3 & 0 & -1 \\\\ 0 & -1 & 0 & -2\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=-\\frac{1}{2}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ -1 & -3 & 0 & -1 \\\\ 0 & -1 & 0 & -2\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 0 & -1 & -4 \\\\ 0 & -1 & 0 & -2\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & -1 & 0 & -2 \\\\ 0 & 0 & -1 & -4\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-1R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & -1 & -4\\end{array}\\right]\n$$\n\nNormalize with $R_3:=-1R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 3 & -1 & -3 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 4\\end{array}\\right]\n$$\n\n"] [:db/add "9393fded-f9c2-50dc-99ee-2d56fb3f3545" :question/difficulty :question.difficulty/moderate] [:db/add "9393fded-f9c2-50dc-99ee-2d56fb3f3545" :question/answer-fields "a1367a29-5ad1-5bb8-8f42-5a794b8fcad8"] [:db/ensure "9393fded-f9c2-50dc-99ee-2d56fb3f3545" :question/validate] [:db/add 17592186096673 :knowledge-point/questions "9393fded-f9c2-50dc-99ee-2d56fb3f3545"] [:db/add "84fb5fbe-f27e-54d2-9eb0-7f80483e6190" :answer/id #uuid "84fb5fbe-f27e-54d2-9eb0-7f80483e6190"] [:db/add "84fb5fbe-f27e-54d2-9eb0-7f80483e6190" :answer/type :answer.type/math] [:db/add "84fb5fbe-f27e-54d2-9eb0-7f80483e6190" :answer/value "\\left(19,7,-3\\right)"] [:db/ensure "84fb5fbe-f27e-54d2-9eb0-7f80483e6190" :answer/validate] [:db/add "9f284170-e4ad-5b4c-8883-3dbd7f42af88" :answer/id #uuid "9f284170-e4ad-5b4c-8883-3dbd7f42af88"] [:db/add "9f284170-e4ad-5b4c-8883-3dbd7f42af88" :answer/type :answer.type/math] [:db/add "9f284170-e4ad-5b4c-8883-3dbd7f42af88" :answer/value "\\left(-2,0,-3\\right)"] [:db/ensure "9f284170-e4ad-5b4c-8883-3dbd7f42af88" :answer/validate] [:db/add "15368c93-ee98-52fb-91e7-4f9c5cbdaa98" :answer/id #uuid "15368c93-ee98-52fb-91e7-4f9c5cbdaa98"] [:db/add "15368c93-ee98-52fb-91e7-4f9c5cbdaa98" :answer/type :answer.type/math] [:db/add "15368c93-ee98-52fb-91e7-4f9c5cbdaa98" :answer/value "\\left(-23,-7,-3\\right)"] [:db/ensure "15368c93-ee98-52fb-91e7-4f9c5cbdaa98" :answer/validate] [:db/add "9c8db620-ef38-5882-8b0b-e9b9bde17ffc" :answer/id #uuid "9c8db620-ef38-5882-8b0b-e9b9bde17ffc"] [:db/add "9c8db620-ef38-5882-8b0b-e9b9bde17ffc" :answer/type :answer.type/math] [:db/add "9c8db620-ef38-5882-8b0b-e9b9bde17ffc" :answer/value "\\left(-31,-12,4\\right)"] [:db/ensure "9c8db620-ef38-5882-8b0b-e9b9bde17ffc" :answer/validate] [:db/add "6e77e798-2117-5b7d-9615-6bb1904587ca" :answer/id #uuid "6e77e798-2117-5b7d-9615-6bb1904587ca"] [:db/add "6e77e798-2117-5b7d-9615-6bb1904587ca" :answer/type :answer.type/math] [:db/add "6e77e798-2117-5b7d-9615-6bb1904587ca" :answer/value "\\left(35,10,4\\right)"] [:db/ensure "6e77e798-2117-5b7d-9615-6bb1904587ca" :answer/validate] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/id #uuid "72b01402-efba-5d04-bf97-428790a74de9"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/key "selection"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/type :answer-field.type/radio] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/choices "84fb5fbe-f27e-54d2-9eb0-7f80483e6190"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/choices "9f284170-e4ad-5b4c-8883-3dbd7f42af88"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/choices "15368c93-ee98-52fb-91e7-4f9c5cbdaa98"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/choices "9c8db620-ef38-5882-8b0b-e9b9bde17ffc"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/choices "6e77e798-2117-5b7d-9615-6bb1904587ca"] [:db/add "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/correct "9f284170-e4ad-5b4c-8883-3dbd7f42af88"] [:db/ensure "72b01402-efba-5d04-bf97-428790a74de9" :answer-field/validate] [:db/add "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c" :question/id #uuid "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c"] [:db/add "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}2 & -6 & -2 & 2 \\\\ -2 & 6 & -1 & 7 \\\\ 2 & -9 & 1 & -7\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$."] [:db/add "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c" :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}2 & -6 & -2 & 2 \\\\ -2 & 6 & -1 & 7 \\\\ 2 & -9 & 1 & -7\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=\\frac{1}{2}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ -2 & 6 & -1 & 7 \\\\ 2 & -9 & 1 & -7\\end{array}\\right]\n$$\n\n$R_2:=R_2+(2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ 0 & 0 & -3 & 9 \\\\ 2 & -9 & 1 & -7\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ 0 & 0 & -3 & 9 \\\\ 0 & -3 & 3 & -9\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ 0 & -3 & 3 & -9 \\\\ 0 & 0 & -3 & 9\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-\\frac{1}{3}R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ 0 & 1 & -1 & 3 \\\\ 0 & 0 & -3 & 9\\end{array}\\right]\n$$\n\nNormalize with $R_3:=-\\frac{1}{3}R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ 0 & 1 & -1 & 3 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 1 \\\\ 0 & 1 & -1 & 3 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=-3 \\\\ y &=3-(-1)(-3) \\\\ &=0 \\\\ x &=1-(-3)(0) \\\\ &\\quad -(-1)(-3) \\\\ &=-2\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(-2,0,-3\\right)\n$$\n\n"] [:db/add "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c" :question/difficulty :question.difficulty/moderate] [:db/add "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c" :question/answer-fields "72b01402-efba-5d04-bf97-428790a74de9"] [:db/ensure "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c" :question/validate] [:db/add 17592186096673 :knowledge-point/questions "1472fb8c-b7bf-571e-bf3e-7012c4f5ed1c"] [:db/add "7148bc8f-6629-56fb-ab42-30792ae32180" :answer/id #uuid "7148bc8f-6629-56fb-ab42-30792ae32180"] [:db/add "7148bc8f-6629-56fb-ab42-30792ae32180" :answer/type :answer.type/math] [:db/add "7148bc8f-6629-56fb-ab42-30792ae32180" :answer/value "\\left(-2,-7,4\\right)"] [:db/ensure "7148bc8f-6629-56fb-ab42-30792ae32180" :answer/validate] [:db/add "b804ee01-251e-5aa3-ac6a-1696ae1dc15a" :answer/id #uuid "b804ee01-251e-5aa3-ac6a-1696ae1dc15a"] [:db/add "b804ee01-251e-5aa3-ac6a-1696ae1dc15a" :answer/type :answer.type/math] [:db/add "b804ee01-251e-5aa3-ac6a-1696ae1dc15a" :answer/value "\\left(12,6,-2\\right)"] [:db/ensure "b804ee01-251e-5aa3-ac6a-1696ae1dc15a" :answer/validate] [:db/add "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c" :answer/id #uuid "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c"] [:db/add "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c" :answer/type :answer.type/math] [:db/add "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c" :answer/value "\\left(2,1,-2\\right)"] [:db/ensure "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c" :answer/validate] [:db/add "473804c9-00bf-5f1f-8837-622fe3fde350" :answer/id #uuid "473804c9-00bf-5f1f-8837-622fe3fde350"] [:db/add "473804c9-00bf-5f1f-8837-622fe3fde350" :answer/type :answer.type/math] [:db/add "473804c9-00bf-5f1f-8837-622fe3fde350" :answer/value "\\left(36,12,4\\right)"] [:db/ensure "473804c9-00bf-5f1f-8837-622fe3fde350" :answer/validate] [:db/add "d3025888-b0d3-532e-87fd-44633235aa4a" :answer/id #uuid "d3025888-b0d3-532e-87fd-44633235aa4a"] [:db/add "d3025888-b0d3-532e-87fd-44633235aa4a" :answer/type :answer.type/math] [:db/add "d3025888-b0d3-532e-87fd-44633235aa4a" :answer/value "\\left(28,8,4\\right)"] [:db/ensure "d3025888-b0d3-532e-87fd-44633235aa4a" :answer/validate] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/id #uuid "2d7eda76-e2ca-5cbd-b119-48aad289bb4f"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/key "selection"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/type :answer-field.type/radio] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/choices "7148bc8f-6629-56fb-ab42-30792ae32180"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/choices "b804ee01-251e-5aa3-ac6a-1696ae1dc15a"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/choices "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/choices "473804c9-00bf-5f1f-8837-622fe3fde350"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/choices "d3025888-b0d3-532e-87fd-44633235aa4a"] [:db/add "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/correct "c8b4c0c4-c2f7-5c5e-90ff-28ebc7e9390c"] [:db/ensure "2d7eda76-e2ca-5cbd-b119-48aad289bb4f" :answer-field/validate] [:db/add "408717d6-ef5b-5430-a82f-0bd21f93a44a" :question/id #uuid "408717d6-ef5b-5430-a82f-0bd21f93a44a"] [:db/add "408717d6-ef5b-5430-a82f-0bd21f93a44a" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}2 & -4 & -4 & 8 \\\\ -2 & 4 & 7 & -14 \\\\ 0 & -1 & 2 & -5\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$."] [:db/add "408717d6-ef5b-5430-a82f-0bd21f93a44a" :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}2 & -4 & -4 & 8 \\\\ -2 & 4 & 7 & -14 \\\\ 0 & -1 & 2 & -5\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=\\frac{1}{2}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -2 & 4 \\\\ -2 & 4 & 7 & -14 \\\\ 0 & -1 & 2 & -5\\end{array}\\right]\n$$\n\n$R_2:=R_2+(2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -2 & 4 \\\\ 0 & 0 & 3 & -6 \\\\ 0 & -1 & 2 & -5\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -2 & 4 \\\\ 0 & -1 & 2 & -5 \\\\ 0 & 0 & 3 & -6\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-1R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -2 & 4 \\\\ 0 & 1 & -2 & 5 \\\\ 0 & 0 & 3 & -6\\end{array}\\right]\n$$\n\nNormalize with $R_3:=\\frac{1}{3}R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -2 & 4 \\\\ 0 & 1 & -2 & 5 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -2 & 4 \\\\ 0 & 1 & -2 & 5 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=-2 \\\\ y &=5-(-2)(-2) \\\\ &=1 \\\\ x &=4-(-2)(1) \\\\ &\\quad -(-2)(-2) \\\\ &=2\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(2,1,-2\\right)\n$$\n\n"] [:db/add "408717d6-ef5b-5430-a82f-0bd21f93a44a" :question/difficulty :question.difficulty/moderate] [:db/add "408717d6-ef5b-5430-a82f-0bd21f93a44a" :question/answer-fields "2d7eda76-e2ca-5cbd-b119-48aad289bb4f"] [:db/ensure "408717d6-ef5b-5430-a82f-0bd21f93a44a" :question/validate] [:db/add 17592186096673 :knowledge-point/questions "408717d6-ef5b-5430-a82f-0bd21f93a44a"] [:db/ensure 17592186096673 :knowledge-point/validate]]
