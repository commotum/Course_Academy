0 & 0 & 1 & -1\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186760815 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e6633a2-0bf0-570c-abb2-a0b3ca210ff4" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 0 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186760804} {:answer/id #uuid "2e4786fc-1312-5d21-9014-67b4addda47a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186760808} {:answer/id #uuid "335825d2-825f-5b0d-afed-49bdae0de665" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186760810} {:answer/id #uuid "829bb97e-9253-5577-9416-ca4747e7572a" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & -1 & -2 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186760820} {:answer/id #uuid "ae3e9147-5673-5527-aed3-137284f7aa48" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186760826}] :answer-field/correct {:answer/id #uuid "ae3e9147-5673-5527-aed3-137284f7aa48" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]" :db/id #edb/ref 17592186760826} :answer-field/id #uuid "e9a5aa58-f2dd-5b88-8bcd-9828b00a4284" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760834}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "4b37ea0a-b170-512b-b110-412075d4a4cc" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+2y &=-1 \\\\ x+2y+z &=0 \\\\ x+3y &=2\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form. Select the resulting augmented matrix." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 1 & 2 & 1 & 0 \\\\ 1 & 3 & 0 & 2\\end{array}\\right]\n$$\n\n$R_2:=R_2+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 0 & 1 & 1 \\\\ 1 & 3 & 0 & 2\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 1 & 0 & 3\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & -1 \\\\ 0 & 1 & 0 & 3 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186760816 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d495234-2e3e-5458-87b9-b336f5b0be19" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186760802} {:answer/id #uuid "19c616fd-6599-5590-99c4-b6f696a8b547" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186760803} {:answer/id #uuid "2bbf8613-45dd-5a01-9485-6cf0a8e860c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186760807} {:answer/id #uuid "c47564a1-d985-5f57-a2f1-316c37ab2fbc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & -1 & -1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186760830} {:answer/id #uuid "c9962142-c900-5e72-bec2-3c6fedbe5a4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & 3\\end{array}\\right]" :db/id #edb/ref 17592186760832}] :answer-field/correct {:answer/id #uuid "19c616fd-6599-5590-99c4-b6f696a8b547" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]" :db/id #edb/ref 17592186760803} :answer-field/id #uuid "dca850b4-48c3-5374-b3d5-13708a6a82c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760833}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "58d0bd61-a83b-523f-8c51-2fd462725b4d" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x+y &=-2 \\\\ -x-y+z &=2 \\\\ -x+z &=4\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form. Select the resulting augmented matrix." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ -1 & -1 & 1 & 2 \\\\ -1 & 0 & 1 & 4\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 0 \\\\ -1 & 0 & 1 & 4\\end{array}\\right]\n$$\n\n$R_3:=R_3+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 1 & 1 & 2\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 0 & -2 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & 0\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186760823 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3323e206-9772-52e7-95d1-ae555a2267d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-2,0,1\\right)" :db/id #edb/ref 17592186760809} {:answer/id #uuid "47180298-2284-5003-8009-4ab8e41d3b44" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(2,2,1\\right)" :db/id #edb/ref 17592186760814} {:answer/id #uuid "8fdad44b-bde0-5b46-8672-ca0c1f7f6127" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-4,-1,1\\right)" :db/id #edb/ref 17592186760825} {:answer/id #uuid "b3055e57-9904-5a83-8358-2b14218d350d" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-8,-2,-1\\right)" :db/id #edb/ref 17592186760827} {:answer/id #uuid "c7cd0788-9e2f-51a7-a847-331faa12c136" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,2,-1\\right)" :db/id #edb/ref 17592186760831}] :answer-field/correct {:answer/id #uuid "8fdad44b-bde0-5b46-8672-ca0c1f7f6127" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-4,-1,1\\right)" :db/id #edb/ref 17592186760825} :answer-field/id #uuid "279aecc0-5469-5835-a1c8-143797813597" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760806}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "89e0ec45-c6c5-510c-8d5d-815a56ed5603" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & -3 \\\\ -1 & 2 & 2 & 4 \\\\ 1 & -1 & 0 & -3\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & -3 \\\\ -1 & 2 & 2 & 4 \\\\ 1 & -1 & 0 & -3\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & -3 \\\\ 0 & 0 & 1 & 1 \\\\ 1 & -1 & 0 & -3\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & -3 \\\\ 0 & 0 & 1 & 1 \\\\ 0 & 1 & 1 & 0\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & -3 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & -3 \\\\ 0 & 1 & 1 & 0 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=1 \\\\ y &=0-(1)(1) \\\\ &=-1 \\\\ x &=-3-(-2)(-1) \\\\ &\\quad -(-1)(1) \\\\ &=-4\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(-4,-1,1\\right)\n$$\n\n"} {:db/id #edb/ref 17592186760828 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3412d9b0-6ed3-5a0e-8dd3-cb41a217534e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186760811} {:answer/id #uuid "64a678ea-d625-558d-8043-513b5dfdec2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 0 \\\\ 0 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]" :db/id #edb/ref 17592186760817} {:answer/id #uuid "6cfa7ff9-ed5d-58c3-9eca-a8bd6f62fecf" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 0 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186760818} {:answer/id #uuid "857cfca3-97dc-55dc-b2b8-99516cb7691e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 0 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & -3\\end{array}\\right]" :db/id #edb/ref 17592186760822} {:answer/id