1 & -1 & 2 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -2 & -1 & 2 \\\\ 0 & 1 & -1 & 2 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]\n$$\n\n"} {:db/id #edb/ref 17592186757090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "382e0069-911e-50d5-a15b-2a3fef037f35" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-2,0\\right)" :db/id #edb/ref 17592186757076} {:answer/id #uuid "adc42256-fbc2-5dab-b6c3-14d593f7470e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(5,3,-2\\right)" :db/id #edb/ref 17592186757092} {:answer/id #uuid "ca999b1d-20a4-5615-a84d-d5f9c335be43" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(3,1,-2\\right)" :db/id #edb/ref 17592186757095} {:answer/id #uuid "d0f1aa48-fac4-5c0d-8c12-226190008f52" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4,2,0\\right)" :db/id #edb/ref 17592186757097} {:answer/id #uuid "d12eeec4-7d1c-5819-b0e6-25a9b4528cdc" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-2,-2\\right)" :db/id #edb/ref 17592186757098}] :answer-field/correct {:answer/id #uuid "adc42256-fbc2-5dab-b6c3-14d593f7470e" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(5,3,-2\\right)" :db/id #edb/ref 17592186757092} :answer-field/id #uuid "1eff4e64-fc18-5628-a50d-e8a668542847" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186757073}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a64a32da-52bc-5a23-8ccc-41d276244ac7" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}x-y &=2 \\\\ x-y+z &=0 \\\\ x+z &=3\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 1 & -1 & 1 & 0 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]\n$$\n\n$R_2:=R_2+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 1 & 0 & 1 & 3\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 0 & 1 & -2 \\\\ 0 & 1 & 1 & 1\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & 0 & 2 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=-2 \\\\ y &=1-(1)(-2) \\\\ &=3 \\\\ x &=2-(-1)(3) \\\\ &\\quad -(0)(-2) \\\\ &=5\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(5,3,-2\\right)\n$$\n\n"} {:db/id #edb/ref 17592186757102 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e588afc-3992-51b0-b44e-f8e12a2d57e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-1,-4,2\\right)" :db/id #edb/ref 17592186757071} {:answer/id #uuid "20180d75-875d-5f9b-b4ba-216ca1af45b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-5,4,-2\\right)" :db/id #edb/ref 17592186757074} {:answer/id #uuid "561f86db-e1e2-5611-8412-f5d12c1acd02" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-1,-2\\right)" :db/id #edb/ref 17592186757080} {:answer/id #uuid "8d466cb3-7536-59fa-b6ed-5bc0f5ddcfa4" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-6,1,2\\right)" :db/id #edb/ref 17592186757087} {:answer/id #uuid "cca69b9b-434e-57f4-b2d4-c5a180d69182" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-5,0,2\\right)" :db/id #edb/ref 17592186757096}] :answer-field/correct {:answer/id #uuid "0e588afc-3992-51b0-b44e-f8e12a2d57e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(-1,-4,2\\right)" :db/id #edb/ref 17592186757071} :answer-field/id #uuid "4c90c7b0-6f28-51f0-970c-1a1884db7716" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186757078}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f85b4885-741b-5d33-a0ae-7c13bbdc9516" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ -1 & -1 & 0 & 5 \\\\ 1 & 2 & 2 & -5\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ -1 & -1 & 0 & 5 \\\\ 1 & 2 & 2 & -5\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & 2 \\\\ 1 & 2 & 2 & -5\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 0 & 1 & 2 \\\\ 0 & 1 & 1 & -2\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 1 & 1 & -3 \\\\ 0 & 1 & 1 & -2 \\\\ 0 & 0 & 1 & 2\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=2 \\\\ y &=-2-(1)(2) \\\\ &=-4 \\\\ x &=-3-(1)(-4) \\\\ &\\quad -(1)(2) \\\\ &=-1\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(-1,-4,2\\right)\n$$\n\n"} {:db/id #edb/ref 17592186760465 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6cbbf4-5d91-5928-93d0-04cb0cbb5935" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(1,-\\frac{5}{3},2\\right)" :db/id #edb/ref 17592186760464} {:answer/id #uuid "71d538c2-8847-56f7-b339-788185693f68" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(10,\\frac{4}{3},2\\right)" :db/id #edb/ref 17592186760466} {:answer/id #uuid "87c1ea42-dcda-5c3a-9aa1-0298408180e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{17}{2},\\frac{4}{3},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760467} {:answer/id #uuid "f0c55a97-aa64-5783-90fc-feb2f4d641ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(8,\\frac{7}{6},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760469} {:answer/id #uuid "f1aab4ab-a652-51a8-904d-cfad99fdf6d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-\\frac{3}{2},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760470}] :answer-field/correct {:answer/id #uuid "f1aab4ab-a652-51a8-904d-cfad99fdf6d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(0,-\\frac{3}{2},\\frac{1}{2}\\right)" :db/id #edb/ref 17592186760470} :answer-field/id #uuid "c83bcd60-4571-5cd6-a57a-e46d8a22925e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760468}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0c142b90-4f01-5d72-88af-eb2fb9332317" :question/problem "Consider the system of linear equations\n\n$$\n\\left\\{\\begin{aligned}-3x+9y+3z &=-12 \\\\ -x+3y+3z &=-3 \\\\ 2x-9y-z &=13\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & 9 & 3 & -12 \\\\ -1 & 3 & 3 & -3 \\\\ 2 & -9 & -1 & 13\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=-\\frac{1}{3}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ -1 & 3 & 3 & -3 \\\\ 2 & -9 & -1 & 13\\end{array}\\right]\n$$\n\n$R_2:=R_2+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 2 & -9 & -1 & 13\\end{array}\\right]\n$$\n\n$R_3:=R_3+(-2)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 0 & 2 & 1 \\\\ 0 & -3 & 1 & 5\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & -3 & 1 & 5 \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-\\frac{1}{3}R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{5}{3} \\\\ 0 & 0 & 2 & 1\\end{array}\\right]\n$$\n\nNormalize with $R_3:=\\frac{1}{2}R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{5}{3} \\\\ 0 & 0 & 1 & \\frac{1}{2}\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -3 & -1 & 4 \\\\ 0 & 1 & -\\frac{1}{3} & -\\frac{5}{3} \\\\ 0 & 0 & 1 & \\frac{1}{2}\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=\\frac{1}{2} \\\\ y &=-\\frac{5}{3}-\\left(-\\frac{1}{3}\\right)\\left(\\frac{1}{2}\\right) \\\\ &=-\\frac{3}{2} \\\\ x &=4-(-3)\\left(-\\frac{3}{2}\\right) \\\\ &\\quad -(-1)\\left(\\frac{1}{2}\\right) \\\\ &=0\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(0,-\\frac{3}{2},\\frac{1}{2}\\right)\n$$\n\n"} {:db/id #edb/ref 17592186760476 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d5204c-a40c-5750-84dd-492eca6ec46f" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(4,\\frac{1}{2},-\\frac{3}{2}\\right)" :db/id #edb/ref 17592186760471} {:answer/id #uuid "5de78fbb-869a-590c-8fd1-2df710b73ace" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{26}{3},-\\frac{11}{6},-\\frac{3}{2}\\right)" :db/id #edb/ref 17592186760472} {:answer/id #uuid "aa01e644-6b0b-5925-83f5-3ce8c1a1f063" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{3},\\frac{7}{3},1\\right)" :db/id #edb/ref 17592186760474} {:answer/id #uuid "b6a07efd-97ed-5039-b858-00030098b7fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{19}{3},-\\frac{2}{3},1\\right)" :db/id #edb/ref 17592186760475} {:answer/id #uuid "fe00b889-a680-566e-b651-401f7b8ebf14" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{7}{3},\\frac{4}{3},-\\frac{3}{2}\\right)" :db/id #edb/ref 17592186760477}] :answer-field/correct {:answer/id #uuid "aa01e644-6b0b-5925-83f5-3ce8c1a1f063" :answer/type {:db/ident :answer.type/math} :answer/value "\\left(\\frac{1}{3},\\frac{7}{3},1\\right)" :db/id #edb/ref 17592186760474} :answer-field/id #uuid "74ff48e3-ea77-5e0d-b520-a8e8ea034f2a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186760473}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c3217a82-84e6-5b88-91bd-7219d4650961" :question/problem "Consider the augmented matrix $M$ for the variables $x,y,z$ in that order.\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & -6 & 0 & -15 \\\\ -3 & -6 & 2 & -13 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix to row echelon form, and then solve the linear system. Select the solution $(x,y,z)$." :question/worked-solution "The augmented matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}-3 & -6 & 0 & -15 \\\\ -3 & -6 & 2 & -13 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\nNormalize the first pivot with $R_1:=-\\frac{1}{3}R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ -3 & -6 & 2 & -13 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\n$R_2:=R_2+(3)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 0 & 2 & 2 \\\\ -1 & -5 & 4 & -8\\end{array}\\right]\n$$\n\n$R_3:=R_3+(1)R_1$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 0 & 2 & 2 \\\\ 0 & -3 & 4 & -3\\end{array}\\right]\n$$\n\nThe second pivot is zero, while the third row has a nonzero second entry. Exchange $R_2$ and $R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & -3 & 4 & -3 \\\\ 0 & 0 & 2 & 2\\end{array}\\right]\n$$\n\nNormalize with $R_2:=-\\frac{1}{3}R_2$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 1 & -\\frac{4}{3} & 1 \\\\ 0 & 0 & 2 & 2\\end{array}\\right]\n$$\n\nNormalize with $R_3:=\\frac{1}{2}R_3$.\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 1 & -\\frac{4}{3} & 1 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nThus the row echelon matrix is\n\n$$\n\\left[\\begin{array}{ccc|c}1 & 2 & 0 & 5 \\\\ 0 & 1 & -\\frac{4}{3} & 1 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nBack substitute, starting with the last row:\n\n$$\n\\begin{aligned}z &=1 \\\\ y &=1-\\left(-\\frac{4}{3}\\right)(1) \\\\ &=\\frac{7}{3} \\\\ x &=5-(2)\\left(\\frac{7}{3}\\right) \\\\ &\\quad -(0)(1) \\\\ &=\\frac{1}{3}\\end{aligned}\n$$\n\nThe solution $(x,y,z)$ is\n\n$$\n\\left(\\frac{1}{3},\\frac{7}{3},1\\right)\n$$\n\n"} {:db/id #edb/ref 17592186760812 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ebe8c82-9ef6-5fe6-806a-7791c7d71a5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -1\\end{array}\\right]" :db/id #edb/ref 17592186760819} {:answer/id #uuid "8517375d-85ad-5368-9431-8a17981b9897" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & 1 & 2 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186760821} {:answer/id #uuid "8ad24f22-8a66-5c03-a8cb-8d5f9892532c" :answer/type {:db/ident :answer.type/math} :answer/value "\\left[\\begin{array}{ccc|c}1 & 1 & 1 & 2 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & -2\\end{array}\\right]" :db/id #edb/ref 17592186760824} {:answer/id #uuid "c3ab1247-07bd-5322-a945-