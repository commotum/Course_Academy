#{[{:db/id #edb/ref 17592186387353 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b97203e9-8d87-5cac-b645-904ef91cae7d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,\\,\\frac{3}{2}⟩" :db/id #edb/ref 17592186387355} {:answer/id #uuid "4f63b47e-4384-5932-bde6-b16ca9aebd87" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186387356} {:answer/id #uuid "5941fefb-b666-5264-9ff1-ea630cf1bd88" :answer/type {:db/ident :answer.type/math} :answer/value "⟨12,\\,\\frac{1}{4}⟩" :db/id #edb/ref 17592186387357} {:answer/id #uuid "cd8b17a6-4cbf-54f9-99c3-f7a62dd1829d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨6,\\,\\frac{4}{3}⟩" :db/id #edb/ref 17592186387358} {:answer/id #uuid "53d7fc04-e503-5637-99f3-3e1a31b96eda" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{1}{3},\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186387359}] :answer-field/correct {:answer/id #uuid "4f63b47e-4384-5932-bde6-b16ca9aebd87" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,\\frac{3}{4}⟩" :db/id #edb/ref 17592186387356} :answer-field/id #uuid "e7722d9c-8a8e-51c2-9846-c98ae9635908" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387354}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "12003e8d-c48c-5642-87cc-c7c437d424fc" :question/math-academy-id "q-123203" :question/problem "Given that $r(t)=⟨6\\operatorname{cos}⁡(5t),\\,{\\sin }^{2}⁡(5t)⟩,$ calculate $r\\left(\\frac{\\pi }{3}\\right).$" :question/worked-solution "We substitute $t=\\frac{\\pi }{3}$ into our function, and we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{3}\\right) & =⟨6\\operatorname{cos}⁡(5\\cdot \\frac{\\pi }{3}),\\,{\\sin }^{2}⁡(5\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨(6\\cdot \\frac{1}{2}),\\,{\\left(-\\frac{\\sqrt{3}}{2}\\right)}^{2}⟩ \\\\  & =⟨3,\\,\\frac{3}{4}⟩.\\end{aligned}\n$$"}]}
