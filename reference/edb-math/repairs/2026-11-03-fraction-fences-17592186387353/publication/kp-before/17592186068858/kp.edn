\\,2\\sqrt{3},\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r\\left(\\frac{\\pi }{3}\\right)| & =\\sqrt{{(1)}^{2}+{(2\\sqrt{3})}^{2}+(6)^{2}} \\\\  & =\\sqrt{1+12+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c56555e-e263-58c1-9d7c-43ccc7a2d2a4" :answer/type {:db/ident :answer.type/math} :answer/value "15\\sqrt{3}" :db/id #edb/ref 17592186257323} {:answer/id #uuid "4c651046-ae15-540f-a74c-400db7c7bb2d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{17}" :db/id #edb/ref 17592186257442} {:answer/id #uuid "8a621f33-227b-5bd6-a433-f66b65c0f33e" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186257996} {:answer/id #uuid "c54ad82b-8af1-5a77-91ad-830ba90f7fc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186258508} {:answer/id #uuid "df41981e-bc6a-511d-b0c5-2955e0aac5af" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186258726}] :answer-field/correct {:answer/id #uuid "c54ad82b-8af1-5a77-91ad-830ba90f7fc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186258508} :answer-field/id #uuid "c9c3b7b3-f26e-56f1-89ed-dc360da3ab31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259384}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "d2cb5398-f770-50d2-8fda-1f3dfeb385ed" :question/math-academy-id "q-123218" :question/problem "Given that $r(t)=⟨4{\\sin }^{2}⁡(5t),\\,10\\operatorname{cos}⁡(5t)⟩,$ $|r\\left(\\frac{\\pi }{3}\\right)|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{3}\\right) & =⟨4{\\sin }^{2}⁡\\left(\\frac{5\\pi }{3}\\right),\\,10\\operatorname{cos}⁡\\left(\\frac{5\\pi }{3}\\right)⟩ \\\\  & =⟨3,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r\\left(\\frac{\\pi }{3}\\right)| & =\\sqrt{{(3)}^{2}+{(5)}^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db240b4-a7c9-51a0-9f32-dd937b82093a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186256914} {:answer/id #uuid "472cac87-d88b-58da-a5a5-d08d709395a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186257406} {:answer/id #uuid "8a653775-d1ee-5abb-b1ec-c2c3e8e58fd7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257997} {:answer/id #uuid "ccf72b57-3322-5290-9ae1-0d44c0b7c304" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186258556} {:answer/id #uuid "f8968334-0778-54e1-aa6e-e518943a2ca4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186258963}] :answer-field/correct {:answer/id #uuid "0db240b4-a7c9-51a0-9f32-dd937b82093a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186256914} :answer-field/id #uuid "2eb00ed0-8676-5af9-889c-f6df6f301a0c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259114}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "51716a53-902e-5340-9b27-1830ed4e1172" :question/math-academy-id "q-123278" :question/problem "Given that $r(t)=⟨\\sqrt{t+1},\\,t-3⟩,$ $|r(6)|=$" :question/worked-solution "Evaluating the function at $t=6,$ we get\n\n$$\n\\begin{aligned}r(6) & =⟨\\sqrt{6+1},\\,6-3⟩ \\\\  & =⟨\\sqrt{7},\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(6)| & =\\sqrt{{(\\sqrt{7})}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{7+9} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257193} {:answer/id #uuid "3ad77a2c-49f2-5511-924d-4faa1c57848d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186257303} {:answer/id #uuid "4fcc1fe8-6924-5242-8003-92db046c49f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257466} {:answer/id #uuid "77ee4e3f-3119-5178-9cc9-6c6fad461078" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186257844} {:answer/id #uuid "fbd4d0c6-5832-5ee3-b5ee-c611a5b10f72" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186258985}] :answer-field/correct {:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186257193} :answer-field/id #uuid "cf0b12ff-4caf-5d30-beb4-b81232a60432" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259398}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "20f2240f-dd6d-5b3d-ad54-350df9ad6212" :question/math-academy-id "q-123284" :question/problem "Given that $r(t)=⟨\\operatorname{sin}⁡4t,\\,\\operatorname{cos}⁡4t⟩,$ $|r\\left(\\frac{\\pi }{3}\\right)|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{3}\\right) & =⟨\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{3}),\\,\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨-\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r\\left(\\frac{\\pi }{3}\\right)| & =\\sqrt{{\\left(-\\frac{\\sqrt{3}}{2}\\right)}^{2}+{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259506 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4faf58df-3b97-5f86-b4d0-ccad7387b653" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186257465} {:answer/id #uuid "69b56758-6897-526b-81c8-85f74816af0e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186257718} {:answer/id #uuid "afcf93cf-ebd8-5c5f-92c1-d5f81d47cc2f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186258313} {:answer/id #uuid "ba0a6475-7f1d-58d2-9bd1-ced25027ae26" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186258412} {:answer/id #uuid "fdf5b73b-98d7-5982-b903-c898796f4459" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186259005}] :answer-field/correct {:answer/id #uuid "ba0a6475-7f1d-58d2-9bd1-ced25027ae26" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186258412} :answer-field/id #uuid "4dc7395c-0fb1-53f2-880b-5f2f7111231f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259168}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "647a72a4-f6ec-506f-91d3-97cde8555744" :question/math-academy-id "q-123285" :question/problem "Find $|r(3)|$ given that $r(t)=⟨2t-4,\\,\\sqrt{6t+7},\\,\\sqrt{t+4}⟩.$" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨2(3)-4,\\,\\sqrt{6(3)+7},\\,\\sqrt{3+4}⟩ \\\\  & =⟨2,\\,5,\\,\\sqrt{7}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{(2)}^{2}+{(5)}^{2}+(\\sqrt{7})^{2}} \\\\  & =\\sqrt{4+25+7} \\\\  & =\\sqrt{36} \\\\  & =6.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fb44ab6-e33b-5854-8a53-145dfcc5b669" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317827}] :answer-field/correct {:answer/id #uuid "4fb44ab6-e33b-5854-8a53-145dfcc5b669" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317827} :answer-field/id #uuid "ff4bbf8e-10c9-51d1-80fd-d43a4afbb8e6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318958}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5eef400f-884d-53c6-836a-31383c82fba9" :question/math-academy-id "q-348674" :question/problem "Given that $r(t)=⟨{2}^{t-1},\\,\\frac{4}{t+1}⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨{2}^{0},\\,\\frac{4}{2}⟩ \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{1}^{2}+{2}^{2}} \\\\  & =\\sqrt{5} \\\\  & =\\sqrt{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319278 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e59ea6b8-12d4-5431-9a64-3e50ebd2827e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186318332}] :answer-field/correct {:answer/id #uuid "e59ea6b8-12d4-5431-9a64-3e50ebd2827e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186318332} :answer-field/id #uuid "512aac96-85e0-5566-a877-97731725bc2b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318598}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e3530f24-225b-51c8-bb84-340326538d3c" :question/math-academy-id "q-348688" :question/problem "Given that $r(t)=⟨\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t,\\,\\sqrt{t+3}⟩,$ what is $|r(0)|?$\n\n$|r(0)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨\\operatorname{tan}⁡(0),\\,\\operatorname{sec}⁡(0),\\,\\sqrt{0+3}⟩ \\\\  & =⟨0,\\,1,\\,\\sqrt{3}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(0)| & =\\sqrt{{0}^{2}+{1}^{2}+{(\\sqrt{3})}^{2}} \\\\  & =\\sqrt{0+1+3} \\\\  & =\\sqrt{4} \\\\  & =2.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99ccd0c5-c9f5-5a83-9bcb-a6eedad3e8a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186318092}] :answer-field/correct {:answer/id #uuid "99ccd0c5-c9f5-5a83-9bcb-a6eedad3e8a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186318092} :answer-field/id #uuid "b8fba009-9b2f-5de7-983c-3162568cd196" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318824}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "467bbe03-18b4-513c-ba49-7eedf1cc8a92" :question/math-academy-id "q-348690" :question/problem "Given that $$\n\\displaystyle r(t)=⟨\\cos \\,\\left(\\frac{\\pi t}{2}\\right),\\,\\sqrt{{t}^{3}-4},\\,\\ln \\,(2\\,{e}^{t-2}-1)⟩,\n$$ what is $|r(2)|?$ Do not round the answer.\n\n$|r(2)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨\\cos \\,\\left(\\frac{2\\pi }{2}\\right),\\,\\sqrt{{2}^{3}-4},\\,\\ln \\,(2\\,{e}^{0}-1)⟩ \\\\  & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,\\operatorname{ln}⁡(1)⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4+0} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32b5ad4b-8d56-5f3a-b8b4-026c2aaf0e47" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186317725}] :answer-field/correct {:answer/id #uuid "32b5ad4b-8d56-5f3a-b8b4-026c2aaf0e47" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186317725} :answer-field/id #uuid "b8c33aac-dc31-58ae-9b39-7cdb94fa7e3f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318823}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c027bb21-dcd4-5596-85c9-6da87679f319" :question/math-academy-id "q-348691" :question/problem "Given that $r(t)=⟨\\sqrt{t+3},\\,3\\,{e}^{t-1}⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨\\sqrt{1+3},\\,3\\,{e}^{1-1}⟩ \\\\  & =⟨\\sqrt{4},\\,3\\,{e}^{0}⟩ \\\\  & =⟨2,\\,3⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{2}^{2}+{3}^{2}} \\\\  & =\\sqrt{4+9} \\\\  & =\\sqrt{13}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1134010b-c90c-5364-bdbf-6351f4aead82" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317621}] :answer-field/correct {:answer/id #uuid "1134010b-c90c-5364-bdbf-6351f4aead82" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317621} :answer-field/id #uuid "10ddeb3d-5072-5905-b3e1-be70102a5b65" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186318461}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1bd1a588-edf0-5720-9e2d-306abd5f8af7" :question/math-academy-id "q-348693" :question/problem "Given that $r(t)=⟨\\operatorname{cos}⁡(\\pi t),\\,\\sqrt{t+3},\\,t-1⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,0⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345014 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "213c55cc-b400-5377-9058-bd34f39b7911" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186342513} {:answer/id #uuid "5edce411-6450-5a72-885e-5f5697bcd90f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186343038} {:answer/id #uuid "d6f95458-4bb8-5ad3-a0dd-d8a9d0a8a332" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186344125} {:answer/id #uuid "f393e9e6-4bbf-5736-a0fd-bfd2be688d79" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186344382} {:answer/id #uuid "f5c06a87-a77a-5a9d-83dc-507977b8cfcd" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186344401}] :answer-field/correct {:answer/id #uuid "d6f95458-4bb8-5ad3-a0dd-d8a9d0a8a332" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186344125} :answer-field/id #uuid "2fd0f00d-f655-5fb4-8bb8-b431451aae9a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344576}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "69666851-9696-5bfc-814b-85edf6949681" :question/math-academy-id "q-74997" :question/problem "Given that $r(t)=⟨3t-1,\\,2t⟩,$ $|r(3)|=$" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨3(3)-1,\\,2(3)⟩ \\\\  & =⟨8,\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{(8)}^{2}+{(6)}^{2}} \\\\  & =\\sqrt{64+36} \\\\  & =10.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345016 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ae8d47-6440-5fc4-88ae-e824693f9ef2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186342248} {:answer/id #uuid "20d4aa5f-09e8-5783-94d8-a54f3143800f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342509} {:answer/id #uuid "7677c0ef-de2d-5968-b2df-6bd6d3470071" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186343265} {:answer/id #uuid "98ad0632-945b-591e-a1dc-99940b6f8a58" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186343580} {:answer/id #uuid "bb57386b-6b73-5c7d-992b-357beefd33a9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{7}" :db/id #edb/ref 17592186343885}] :answer-field/correct {:answer/id #uuid "00ae8d47-6440-5fc4-88ae-e824693f9ef2" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186342248} :answer-field/id #uuid "6413f0a1-b956-52e5-8ef3-58ed51bcf5cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344661}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9f935716-782b-55ad-aef7-e16daab198c1" :question/math-academy-id "q-75003" :question/problem "Find $|r(4)|$ given that $r(t)=⟨\\frac{10}{t+1},\\,2t-2,\\,t-1⟩.$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨\\frac{10}{4+1},\\,2(4)-2,\\,4-1⟩ \\\\  & =⟨2,\\,6,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(2)}^{2}+{(6)}^{2}+(3)^{2}} \\\\  & =\\sqrt{4+36+9} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345017 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30d51eff-42f3-5193-bd0c-3c492f1889cd" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342647} {:answer/id #uuid "c6ea8410-50de-52e4-bf00-07b5d70c1277" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186343982} {:answer/id #uuid "c75b2667-0486-53a7-8e38-5c65e9869b1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186343989} {:answer/id #uuid "f3400453-fecb-5d78-a600-08d4156638cc" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186344377} {:answer/id #uuid "fba50e80-e32c-507d-8ba1-4e2e2dae9f8c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186344452}] :answer-field/correct {:answer/id #uuid "fba50e80-e32c-507d-8ba1-4e2e2dae9f8c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186344452} :answer-field/id #uuid "9a3f47ed-f3d1-5b98-929b-48ad74186cdf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344758}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c0a3f35d-905e-58d7-b70f-a757375e6c6f" :question/math-academy-id "q-75004" :question/problem "Given that $r(t)=⟨\\sqrt{t},\\,t-3⟩,$ $|r(5)|=$" :question/worked-solution "Evaluating the function at $t=5,$ we get\n\n$$\n\\begin{aligned}r(5) & =⟨\\sqrt{5},\\,5-3⟩ \\\\  & =⟨\\sqrt{5},\\,2⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(5)| & =\\sqrt{{(\\sqrt{5})}^{2}+{(2)}^{2}} \\\\  & =\\sqrt{5+4} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b808877-145f-5d3d-97fd-1ba6af329415" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186342337} {:answer/id #uuid "42e82f89-fb3b-5bb2-b0d9-8663b97e59f3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186342797} {:answer/id #uuid "73d4ec33-7f3d-51de-ac74-e8f8cc8569db" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186343240} {:answer/id #uuid "9293c224-73fd-5eb8-8a76-acf8eb4b7844" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186343518} {:answer/id #uuid "c5423b78-de47-50dd-8df8-faa15e241932" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186343971}] :answer-field/correct {:answer/id #uuid "42e82f89-fb3b-5bb2-b0d9-8663b97e59f3" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186342797} :answer-field/id #uuid "d35c111b-fef0-5b64-86f0-b8e3eb13ade7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344859}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2253c444-f34d-55fe-ab5e-5602fee40a1d" :question/math-academy-id "q-75007" :question/problem "Find $|r(2)|$ given that $r(t)=⟨t+1,\\,\\sqrt{t+1},\\,t⟩.$" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨2+1,\\,\\sqrt{2+1},\\,2⟩ \\\\  & =⟨3,\\,\\sqrt{3},\\,2⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(3)^{2}+(\\sqrt{3})^{2}+(2)^{2}} \\\\  & =\\sqrt{9+3+4} \\\\  & =\\sqrt{16} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186372984 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0b2fd90-b2d0-5bff-89b9-c0cfe2e250f9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186372986}] :answer-field/correct {:answer/id #uuid "a0b2fd90-b2d0-5bff-89b9-c0cfe2e250f9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186372986} :answer-field/id #uuid "6117625f-05ef-53e9-943b-6f3c65d34905" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186372985}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5e394120-3869-5269-8095-84ba7453c5cb" :question/math-academy-id "q-348675" :question/problem "Given that $r(t)=⟨\\sin \\,\\left(\\frac{\\pi t}{2}\\right),\\,t-1⟩,$ what is $|r(2)|?$\n\n$|r(2)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨\\operatorname{sin}⁡\\left(\\frac{\\pi (2)}{2}\\right),\\,2-1⟩ \\\\  & =⟨\\operatorname{sin}⁡(\\pi ),\\,1⟩ \\\\  & =⟨0,\\,1⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{{0}^{2}+{1}^{2}} \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186541151 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4c60dd5-4f2f-5247-b508-e4412be02a72" :answer/type {:db/ident :answer.type/math} :answer/value "31.68" :db/id #edb/ref 17592186540888}] :answer-field/correct {:answer/id #uuid "d4c60dd5-4f2f-5247-b508-e4412be02a72" :answer/type {:db/ident :answer.type/math} :answer/value "31.68" :db/id #edb/ref 17592186540888} :answer-field/id #uuid "8f220aba-10fa-5140-91ce-bb3c746dbdc3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186541001}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f4a5e43e-e7a6-55b0-a709-f89ec3a86933" :question/math-academy-id "q-133293" :question/problem "Let $r(t)=⟨x(t),y(t)⟩$ be the position vector of the eagle. Find the distance between the eagle and its nest at time $t=5\\,\\text{s},$ rounded to two decimal places.\n\nThe eagle is approximately$\\,$\n{{field-1}}\n$\\text{m}$ away from its nest after $t=5$ seconds." :question/worked-solution "Since the nest is at the origin, the distance between the bird and its nest at time $t=5$ is $|r(5)|.$\n\nWe know that $y(5)=\\frac{95}{3}.$ Evaluating the function at $t=5,$ we get\n\n$$\n\\begin{aligned}r(5) & =⟨\\operatorname{arctan}⁡\\left(\\frac{5}{5}\\right),\\frac{95}{3}⟩ \\\\  & =⟨\\frac{\\pi }{4},\\frac{95}{3}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(5)| & =\\sqrt{{\\left(\\frac{\\pi }{4}\\right)}^{2}+{\\left(\\frac{95}{3}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{{\\pi }^{2}}{16}+\\frac{9\\,025}{9}} \\\\  & ≈31.68\\,\\text{m}\\end{aligned}\n$$\n\nrounded to two decimal places."} {:db/id #edb/ref 17592186575615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575033}] :answer-field/correct {:answer/id #uuid "30dfc837-d5c1-5761-8aca-09d8e183f2c6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186575033} :answer-field/id #uuid "b8dd47c6-0daf-57eb-b7fa-e36f8f40c1d7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575487}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "e8bf0613-dc2d-57fb-b4e9-45d51faad202" :question/math-academy-id "q-348682" :question/problem "Given that $$\n\\displaystyle r(t)=⟨\\cos \\,\\left(\\frac{\\pi t}{2}\\right),\\,\\frac{4}{t-1}⟩,\n$$ what is $|r(3)|?$\n\n$|r(3)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨\\cos \\,\\left(\\frac{3\\pi }{2}\\right),\\,\\frac{4}{3-1}⟩ \\\\  & =⟨0,\\,2⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{0}^{2}+{2}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186575034} {:answer/id #uuid "637850e7-5b69-5e11-8f07-9bcea38d6888" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186575129} {:answer/id #uuid "9200df3f-c132-5c9d-b7e0-d5ed27923967" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186575202} {:answer/id #uuid "988fc287-3433-562c-bd45-9cb784417c65" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186575209} {:answer/id #uuid "b7701537-72c1-5510-bb99-fa0372ec42ec" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{5}" :db/id #edb/ref 17592186575276}] :answer-field/correct {:answer/id #uuid "31837ee6-10ca-577f-944f-bdb787e80bd6" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186575034} :answer-field/id #uuid "03372984-3b6a-52fd-b939-f99920dffdff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575408}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "ed1928c0-77ed-571b-8c4d-3959f2119041" :question/math-academy-id "q-123288" :question/problem "Find $|r(1)|$ given that $r(t)=⟨8{t}^{2}-5,\\,2t+2,\\,5t⟩.$" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨8({1}^{2})-5,\\,2(1)+2,\\,5(1)⟩ \\\\  & =⟨3,\\,4,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{(3)}^{2}+{(4)}^{2}+(5)^{2}} \\\\  & =\\sqrt{9+16+25} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186603003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c658892-cfff-5719-9466-85e185302033" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186602581} {:answer/id #uuid "162529db-94e2-53e6-942e-41bc0fe6f25f" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186602593} {:answer/id #uuid "868ed72d-7c51-5c3b-b2d7-3ce9dce4d3f6" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186602713} {:answer/id #uuid "87f93eea-f487-5a46-bd13-0e7e3ca86d2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186602715} {:answer/id #uuid "d8988b60-84f4-5037-ab2c-83e7fbb5b849" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186602829}] :answer-field/correct {:answer/id #uuid "0c658892-cfff-5719-9466-85e185302033" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186602581} :answer-field/id #uuid "8ec44893-e55c-5466-aaa6-28a7e6e5a591" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186602941}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "13e1a728-9acf-5c9e-b21e-002241f3ccbb" :question/math-academy-id "q-123215" :question/problem "Find $|r(4)|$ given that $r(t)=⟨\\frac{16}{{t}^{2}},\\,t-3,\\,6-2t⟩.$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨\\frac{16}{{4}^{2}},\\,4-3,\\,6-2(4)⟩ \\\\  & =⟨1,\\,1,\\,-2⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(1)}^{2}+{(1)}^{2}+(-2)^{2}} \\\\  & =\\sqrt{1+1+4} \\\\  & =\\sqrt{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186603026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a183daf-5346-561d-976f-c75854a18657" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186602597}] :answer-field/correct {:answer/id #uuid "1a183daf-5346-561d-976f-c75854a18657" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186602597} :answer-field/id #uuid "3cd429eb-f38d-582b-8ead-2f44c7fae8d3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186602894}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "35b01f91-97de-5c92-90e3-e5c3ee5fc4cb" :question/math-academy-id "q-346881" :question/problem "Given that $r(t)=⟨\\sqrt{\\frac{12}{t+1}},\\,{t}^{2}-8⟩,$ what is $|r(3)|?$\n\n$|r(3)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨\\sqrt{\\frac{12}{3+1}},\\,{3}^{2}-8⟩ \\\\  & =⟨\\sqrt{\\frac{12}{4}},\\,1⟩ \\\\  & =⟨\\sqrt{3},\\,1⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(3)| & =\\sqrt{{(\\sqrt{3})}^{2}+{1}^{2}} \\\\  & =\\sqrt{3+1} \\\\  & =2\\end{aligned}\n$$"}] :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}]}
