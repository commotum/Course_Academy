d}p(3) & =\\left\\langle {\\log }_{5}⁡({3}^{2}+16),\\,\\tan \\,\\left(\\frac{3\\pi }{9}\\right),\\,{3}^{3}-6(3)\\right\\rangle  \\\\  & =\\left\\langle {\\log }_{5}⁡(25),\\,\\tan \\,\\left(\\frac{\\pi }{3}\\right),\\,27-18\\right\\rangle  \\\\  & =⟨2,\\,\\sqrt{3},\\,9⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09e0561f-7808-53e1-943e-fda0d375b0fe" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186574965}] :answer-field/correct {:answer/id #uuid "09e0561f-7808-53e1-943e-fda0d375b0fe" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186574965} :answer-field/id #uuid "5226de93-b02a-5675-8114-df9cb62aa845" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575454} {:answer-field/choices [{:answer/id #uuid "c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575299}] :answer-field/correct {:answer/id #uuid "c55e24a0-4fa8-5f96-90c9-43fc090e610e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575299} :answer-field/id #uuid "ca938a16-0a70-51f0-a38c-c526ac7bf7d8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575500} {:answer-field/choices [{:answer/id #uuid "cf767b13-484b-5211-88e0-118a601e941c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(16)" :db/id #edb/ref 17592186575316} {:answer/id #uuid "3d84cf83-0889-44a5-899b-66f4e6043874" :answer/type {:db/ident :answer.type/math} :answer/value "4\\ln2" :db/id #edb/ref 17592186748401}] :answer-field/correct {:answer/id #uuid "cf767b13-484b-5211-88e0-118a601e941c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(16)" :db/id #edb/ref 17592186575316} :answer-field/id #uuid "ce022f64-1926-5855-b59b-cbb659564deb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575503}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "a3f0d323-4472-593b-894f-b4448dff1085" :question/math-academy-id "q-348650" :question/problem "What is the value of $$\n\\displaystyle q(t)=\\sqrt{t-3}\\,i+\\ln \\,({t}^{2})\\,j+\\frac{5}{t+1}\\operatorname{sin}⁡(\\pi t)\\,k\n$$ at $t=4?$\n\n$q(4)=$\n{{field-1}} $i\\,+\\,$\n\n{{field-2}} $j\\,+\\,$\n\n{{field-3}} $k$" :question/worked-solution "To evaluate, we substitute $t=4$ into the function, as follows:\n\n$$\n\\begin{aligned}q(4) & =\\sqrt{4-3}\\,i+\\ln \\,({4}^{2})\\,j+\\frac{5}{4+1}\\operatorname{sin}⁡(4\\pi )\\,k \\\\  & =\\sqrt{1}\\,i+\\operatorname{ln}⁡(16)\\,j+\\frac{5}{5}\\cdot 0\\,k \\\\  & =1\\,i+\\operatorname{ln}⁡(16)\\,j+0\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575600 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c481408a-4444-530b-b268-67fbe75e182d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575296}] :answer-field/correct {:answer/id #uuid "c481408a-4444-530b-b268-67fbe75e182d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575296} :answer-field/id #uuid "2627111a-37e8-5d2c-8a5b-4d5136c68472" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575429} {:answer-field/choices [{:answer/id #uuid "8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575183}] :answer-field/correct {:answer/id #uuid "8324fe7b-ac3f-57ba-80f6-ed595d15ca83" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575183} :answer-field/id #uuid "2c8d376b-9f7b-5064-964a-ded341c098b6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575437} {:answer-field/choices [{:answer/id #uuid "354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575039}] :answer-field/correct {:answer/id #uuid "354b471b-f02d-5a8f-b605-c9b1d7cfa995" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186575039} :answer-field/id #uuid "54256760-b370-56e1-8f9d-274cd9ac9901" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186575455}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "cc70b07d-530b-5e77-9200-c7de006703f0" :question/math-academy-id "q-348662" :question/problem "What is the value of $$\n\\displaystyle g(t)=\\left\\langle {3}^{\\,t-1},\\,{\\log }_{3}⁡({t}^{2}+2t),\\,{sec}^{2}\\,\\left(\\frac{\\pi t}{4}\\right)-1\\right\\rangle \n$$ at $t=1?$\n\n$g(1)=⟨$\n{{field-1}} $,\\,$\n{{field-2}} $,\\,$\n{{field-3}} $⟩$" :question/worked-solution "To evaluate, we substitute $t=1$ into the function, as follows:\n\n$$\n\\begin{aligned}g(1) & =\\left\\langle {3}^{1-1},\\,{\\log }_{3}⁡({1}^{2}+2(1)),\\,{sec}^{2}\\,\\left(\\frac{\\pi }{4}\\right)-1\\right\\rangle  \\\\  & =⟨1,\\,{\\log }_{3}⁡(3),\\,{(\\sqrt{2})}^{2}-1⟩ \\\\  & =⟨1,\\,1,\\,1⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186575620 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186574997} {:answer/id #uuid "5dd5b5cd-005e-5343-bec2-584e99c95568" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186575117} {:answer/id #uuid "6969e4a1-4a1e-5a38-83f0-7effe12a76ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -1 \\\\ \\frac{\\sqrt{2}}{2}\\end{bmatrix}" :db/id #edb/ref 17592186575136} {:answer/id #uuid "cef7cdb8-1750-586d-9b65-5c0a924fd3ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\sqrt{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186575315} {:answer/id #uuid "f6712659-f7f2-5848-8213-91e6b729c7c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 \\\\ \\frac{1}{2} \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186575385}] :answer-field/correct {:answer/id #uuid "1e550028-3605-535d-afc4-0b67b596e1d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}" :db/id #edb/ref 17592186574997} :answer-field/id #uuid "760957fd-b385-5f58-b025-bc8ecf6a9ef0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575466}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f479be92-cf45-5de7-9956-484ec8fcce81" :question/math-academy-id "q-161508" :question/problem "What is the value of $$\n\\displaystyle f(t)=\\begin{bmatrix}\\operatorname{sin}⁡2t \\\\ \\operatorname{cos}⁡\\left(2t+\\frac{\\pi }{2}\\right) \\\\ \\operatorname{tan}⁡t\\end{bmatrix}\n$$ at $t=\\frac{\\pi }{4}?$" :question/worked-solution "To evaluate, we substitute $t=\\frac{\\pi }{4}$ into the function, as follows:\n\n$$\n\\begin{aligned}f\\left(\\frac{\\pi }{4}\\right) & =\\begin{bmatrix}\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{4}\\right) \\\\ \\operatorname{cos}⁡\\left(2\\cdot \\frac{\\pi }{4}+\\frac{\\pi }{2}\\right) \\\\ \\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\ \\operatorname{cos}⁡\\pi  \\\\ \\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=\\frac{\\pi }{4}$ is the vector $\\begin{bmatrix}1 \\\\ -1 \\\\ 1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186575623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48c1ce60-2b0d-57ed-93c9-2c44ea8c8499" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-1,-1⟩" :db/id #edb/ref 17592186575073} {:answer/id #uuid "696c269f-d224-59e2-8641-29de25014cf5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,1,-1⟩" :db/id #edb/ref 17592186575137} {:answer/id #uuid "6bd30911-f54e-5de1-885c-7eb77b6d9f1a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,1,-1⟩" :db/id #edb/ref 17592186575144} {:answer/id #uuid "c5b8f200-b728-5605-9aff-7d960603ed99" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1,-1⟩" :db/id #edb/ref 17592186575300} {:answer/id #uuid "ebcf05f5-066d-5d9a-b201-2e8b780e8878" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,-1,1⟩" :db/id #edb/ref 17592186575365}] :answer-field/correct {:answer/id #uuid "6bd30911-f54e-5de1-885c-7eb77b6d9f1a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,1,-1⟩" :db/id #edb/ref 17592186575144} :answer-field/id #uuid "241b5b77-18a0-5d73-90a0-a56c2517100f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186575427}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "fa3121c1-bbfa-5933-8aaf-25e82847d915" :question/math-academy-id "q-160783" :question/problem "What is the value of $f(s)=⟨{s}^{2},\\,3s-2,\\,-s⟩$ at $s=1?$" :question/worked-solution "To evaluate, we substitute $s=1$ into the function, as follows:\n\n$$\n\\begin{aligned}f(1) & =⟨{1}^{2},\\,3\\cdot 1-2,\\,-1⟩ \\\\  & =⟨1,1,-1⟩\\end{aligned}\n$$\n\nSo, the value of $f(s)$ at $s=1$ is the vector $⟨1,1,-1⟩.$"}] :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}]}
