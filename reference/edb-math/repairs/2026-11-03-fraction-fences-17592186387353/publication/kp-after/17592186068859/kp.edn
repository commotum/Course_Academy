#{[{:db/id #edb/ref 17592186068859 :knowledge-point/canonical-example {:db/id #edb/ref 17592186068459 :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi.$" :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,\\,\\operatorname{sin}⁡\\pi ,\\,\\pi ⟩=⟨-1,0,\\pi \\,⟩\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle.$\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n$$\n-\\,\\mathbf i +\\pi\\,\\mathbf k, \\qquad  {\\left[ \\begin{array}{c}- 1 \\\\ 0 \\\\ \\pi \\end{array} \\right]}\n$$"} :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050173 :topic/id #uuid "33e80361-ab74-58ae-9d96-655433239057" :topic/knowledge-points [{:db/id #edb/ref 17592186100859} {:db/id #edb/ref 17592186100860} {:db/id #edb/ref 17592186100861}] :topic/math-academy-id 1166 :topic/next [{:db/id #edb/ref 17592186048954} {:db/id #edb/ref 17592186049186} {:db/id #edb/ref 17592186049537} {:db/id #edb/ref 17592186050267}] :topic/title "Three-Dimensional Vectors in Component Form"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/questions [{:db/id #edb/ref 17592186069088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6ac286a-5a8c-5bc2-a520-23174ec1fb64" :answer/type {:db/ident :answer.type/math} :answer/value "96" :db/id #edb/ref 17592186065962} {:answer/id #uuid "dad6711c-b2a4-5130-9203-acc820cc4e19" :answer/type {:db/ident :answer.type/math} :answer/value "8i + 16j