:db/id #edb/ref 17592186069413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f213150-dedb-5a93-a5f7-e1ca3c70c773" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186067649} {:answer/id #uuid "90a02313-4c06-546e-80db-ec68df938e6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{12}" :db/id #edb/ref 17592186067650} {:answer/id #uuid "075868fc-4808-5ee4-a43a-3c349cce036b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "25" :db/id #edb/ref 17592186067651} {:answer/id #uuid "112de0a1-c15a-5a52-a942-0b390dcd547c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186067652} {:answer/id #uuid "4b5ff11c-972c-57b8-9d36-f4c3db383e0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186067653}] :answer-field/id #uuid "d82f3b6e-646c-537e-882f-d0112424e31c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186067648}] :question/id #uuid "eae43b53-98f1-5f00-8589-76d973eb09f0" :question/math-academy-id "q-50360" :question/problem "Given that $r(t) = \\left\\langle \\frac{6}{t}, t^{3} - 4\\right\\rangle $, what is $\\mid r(2) \\mid$?"} {:db/id #edb/ref 17592186234368 :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "21cf0b12-845b-524d-bc78-3bc9f234746f" :question/math-academy-id "q-75001" :question/problem "Find $|r\\left(\\frac{\\pi }{3}\\right)|$ given that $r(t)=⟨2\\operatorname{cos}t,\\,4\\operatorname{sin}t,\\,6⟩.$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{3}\\right) & =\\left\\langle 2\\operatorname{cos}\\left(\\frac{\\pi }{3}\\right),\\,4\\operatorname{sin}\\left(\\frac{\\pi }{3}\\right),\\,6\\right\\rangle  \\\\  & =\\left\\langle 2\\cdot \\frac{1}{2},\\,4\\cdot \\frac{\\sqrt{3}}{2},\\,6\\right\\rangle  \\\\  & =⟨1,\\,2\\sqrt{3},\\,6⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r\\left(\\frac{\\pi }{3}\\right)| & =\\sqrt{{(1)}^{2}+{(2\\sqrt{3})}^{2}+(6)^{2}} \\\\  & =\\sqrt{1+12+36} \\\\  & =\\sqrt{49} \\\\  & =7.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c56555e-e263-58c1-9d7c-43ccc7a2d2a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "15\\sqrt{3}" :db/id #edb/ref 17592186257323} {:answer/id #uuid "4c651046-ae15-540f-a74c-400db7c7bb2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{17}" :db/id #edb/ref 17592186257442} {:answer/id #uuid "8a621f33-227b-5bd6-a433-f66b65c0f33e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "34" :db/id #edb/ref 17592186257996} {:answer/id #uuid "c54ad82b-8af1-5a77-91ad-830ba90f7fc7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186258508} {:answer/id #uuid "df41981e-bc6a-511d-b0c5-2955e0aac5af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186258726}] :answer-field/correct {:db/id #edb/ref 17592186258508} :answer-field/id #uuid "c9c3b7b3-f26e-56f1-89ed-dc360da3ab31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259384}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d2cb5398-f770-50d2-8fda-1f3dfeb385ed" :question/math-academy-id "q-123218" :question/problem "Given that $r(t)=⟨4{\\sin }^{2}⁡(5t),\\,10\\operatorname{cos}⁡(5t)⟩,$ $|r\\left(\\frac{\\pi }{3}\\right)|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{3}\\right) & =\\left\\langle 4{\\sin }^{2}⁡\\left(\\frac{5\\pi }{3}\\right),\\,10\\operatorname{cos}⁡\\left(\\frac{5\\pi }{3}\\right)\\right\\rangle  \\\\  & =⟨3,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r\\left(\\frac{\\pi }{3}\\right)| & =\\sqrt{{(3)}^{2}+{(5)}^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259505 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e4d2e24-4022-547b-b5b6-6add54b37d8e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186257193} {:answer/id #uuid "3ad77a2c-49f2-5511-924d-4faa1c57848d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186257303} {:answer/id #uuid "4fcc1fe8-6924-5242-8003-92db046c49f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186257466} {:answer/id #uuid "77ee4e3f-3119-5178-9cc9-6c6fad461078" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186257844} {:answer/id #uuid "fbd4d0c6-5832-5ee3-b5ee-c611a5b10f72" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186258985}] :answer-field/correct {:db/id #edb/ref 17592186257193} :answer-field/id #uuid "cf0b12ff-4caf-5d30-beb4-b81232a60432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186259398}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "20f2240f-dd6d-5b3d-ad54-350df9ad6212" :question/math-academy-id "q-123284" :question/problem "Given that $r(t)=⟨\\operatorname{sin}⁡4t,\\,\\operatorname{cos}⁡4t⟩,$ $|r\\left(\\frac{\\pi }{3}\\right)|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r\\left(\\frac{\\pi }{3}\\right) & =\\left\\langle \\operatorname{sin}⁡\\left(4\\cdot \\frac{\\pi }{3}\\right),\\,\\operatorname{cos}⁡\\left(4\\cdot \\frac{\\pi }{3}\\right)\\right\\rangle  \\\\  & =\\left\\langle -\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2}\\right\\rangle .\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r\\left(\\frac{\\pi }{3}\\right)| & =\\sqrt{{\\left(-\\frac{\\sqrt{3}}{2}\\right)}^{2}+{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$"} {:answer/id #uuid "392502a1-fec8-5017-b0fc-77e04ed1df60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{1}{4},28,8\\right\\rangle " :db/id #edb/ref 17592186275982} {:answer/id #uuid "fc405551-0e1b-5f58-8795-904f34d9d5ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{1}{2},28,16\\right\\rangle " :db/id #edb/ref 17592186277689} {:db/id #edb/ref 17592186278536 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cbbdcf-3883-54fa-8e64-7dacfd69a8e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,10,16⟩" :db/id #edb/ref 17592186275809} {:answer/id #uuid "392502a1-fec8-5017-b0fc-77e04ed1df60" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{1}{4},28,8\\right\\rangle " :db/id #edb/ref 17592186275982} {:answer/id #uuid "4c52d055-4b4d-59c8-9a28-17a8367cbf3e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,28,16⟩" :db/id #edb/ref 17592186276150} {:answer/id #uuid "e553081c-3f1c-5e09-bae8-aa9c1d251c06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨2,10,24⟩" :db/id #edb/ref 17592186277479} {:answer/id #uuid "fc405551-0e1b-5f58-8795-904f34d9d5ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{1}{2},28,16\\right\\rangle " :db/id #edb/ref 17592186277689}] :answer-field/correct {:db/id #edb/ref 17592186276150} :answer-field/id #uuid "44ad22c9-8ca2-53b2-8bd4-b0ad84350f1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277832}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f3cd75d0-9b9c-56ab-b0bf-df2c562d6d74" :question/math-academy-id "q-161510" :question/problem "What is the value of $f(t)=\\left\\langle \\frac{4}{t-1},\\,1+{t}^{3},\\,(t-1)^{4}\\right\\rangle $ at $t=3?$" :question/worked-solution "To evaluate, we substitute $t=3$ into the function, as follows:\n\n$$\n\\begin{aligned}f(3) & =\\left\\langle \\frac{4}{3-1},1+{3}^{3},(3-1)^{4}\\right\\rangle  \\\\  & =\\left\\langle \\frac{4}{2},1+27,{2}^{4}\\right\\rangle  \\\\  & =⟨2,28,16⟩\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=3$ is the vector $⟨2,28,16⟩.$"} {:db/id #edb/ref 17592186319273 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ec1354bf-06b7-5d2a-acb2-56c04c8d7d6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "31" :db/id #edb/ref 17592186318354}] :answer-field/correct {:db/id #edb/ref 17592186318354} :answer-field/id #uuid "5e7282a9-da5f-562a-bea2-ef44bd9a2f01" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186318625} {:answer-field/choices [{:answer/id #uuid "3e6a0b04-e440-502b-a1ec-4833b0e00ed0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186317763}] :answer-field/correct {:db/id #edb/ref 17592186317763} :answer-field/id #uuid "870c41bd-e5e4-524e-83cd-2a83f18c5cf1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186318718}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "07462e9c-0e9b-52f4-965a-3115d4df2433" :question/math-academy-id "q-348644" :question/problem "Given that $r(t)=\\left\\langle \\frac{3}{t-2},\\,2{t}^{2}-1\\right\\rangle ,$ calculate $r(4).$\n\n$r(4)=⟨$\n{{field-1}} $,$\n\n{{field-2}}$⟩$" :question/worked-solution "We substitute $t=4$ into our function, and we get\n\n$$\n\\begin{aligned}r(4) & =\\left\\langle \\frac{3}{4-2},\\,2(4)^{2}-1\\right\\rangle  \\\\  & =\\left\\langle \\frac{3}{2},\\,31\\right\\rangle .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319277 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fb44ab6-e33b-5854-8a53-145dfcc5b669" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186317827}] :answer-field/correct {:db/id #edb/ref 17592186317827} :answer-field/id #uuid "ff4bbf8e-10c9-51d1-80fd-d43a4afbb8e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186318958}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "5eef400f-884d-53c6-836a-31383c82fba9" :question/math-academy-id "q-348674" :question/problem "Given that $r(t)=\\left\\langle {2}^{t-1},\\,\\frac{4}{t+1}\\right\\rangle ,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =\\left\\langle {2}^{0},\\,\\frac{4}{2}\\right\\rangle  \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{{1}^{2}+{2}^{2}} \\\\  & =\\sqrt{5} \\\\  & =\\sqrt{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186319279 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99ccd0c5-c9f5-5a83-9bcb-a6eedad3e8a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186318092}] :answer-field/correct {:db/id #edb/ref 17592186318092} :answer-field/id #uuid "b8fba009-9b2f-5de7-983c-3162568cd196" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186318824}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "467bbe03-18b4-513c-ba49-7eedf1cc8a92" :question/math-academy-id "q-348690" :question/problem "Given that $$\n\\displaystyle r(t)=\\left\\langle \\cos \\,\\left(\\frac{\\pi t}{2}\\right),\\,\\sqrt{{t}^{3}-4},\\,\\ln \\,(2\\,{e}^{t-2}-1)\\right\\rangle ,\n$$ what is $|r(2)|?$ Do not round the answer.\n\n$|r(2)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =\\left\\langle \\cos \\,\\left(\\frac{2\\pi }{2}\\right),\\,\\sqrt{{2}^{3}-4},\\,\\ln \\,(2\\,{e}^{0}-1)\\right\\rangle  \\\\  & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,\\operatorname{ln}⁡(1)⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4+0} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ded53ea-da00-585b-bb9e-e3fdf96a2a23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8,\\,2⟩" :db/id #edb/ref 17592186342359} {:answer/id #uuid "a50cb1cd-4035-5920-8b73-fd6e3fe50b82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨9,\\,4⟩" :db/id #edb/ref 17592186343693} {:answer/id #uuid "b62ec8c5-8752-5b06-a4a3-135f9c4c2e3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨12,\\,6⟩" :db/id #edb/ref 17592186343835} {:answer/id #uuid "c843ea52-ca0c-5635-9164-6e5f37a047c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨8,\\,4⟩" :db/id #edb/ref 17592186343998} {:answer/id #uuid "f5a2724c-e985-5761-9cfd-80782d357e1d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨10,\\,2⟩" :db/id #edb/ref 17592186344399}] :answer-field/correct {:db/id #edb/ref 17592186342359} :answer-field/id #uuid "54f2a41a-a64d-53cb-b886-1943ce034fcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344636}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "291578c2-fb79-5e53-a3ce-fe6420611802" :question/math-academy-id "q-74988" :question/problem "Given that $r(t)=\\left\\langle t+6,\\,\\frac{5t-2}{2t}\\right\\rangle ,$ calculate $r(2).$" :question/worked-solution "We  substitute $t=2$ into our function, and we get\n\n$$\n\\begin{aligned}r(2) & =\\left\\langle 2+6,\\,\\frac{5(2)-2}{2(2)}\\right\\rangle  \\\\  & =⟨8,\\,2⟩.\\end{aligned}\n$$"}