right)}" :db/id #edb/ref 17592186657610} :answer-field/id #uuid "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/problem "Given that $f(x)={2}^{x}\\log _{7} (x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{2^{x}}{x \\ln{\\left(7 \\right)}}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={2}^{x}$ and $v(x)=\\log _{7} (x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({2}^{x})}^{′}\\log _{7} (x)+{2}^{x}{(\\log _{7} (x))}^{′} \\\\  & =({2}^{x}\\ln  (2))(\\log _{7} (x))+({2}^{x})(\\frac{1}{x\\ln  (7)}) \\\\  & ={2}^{x}\\ln  (2)\\log _{7} (x)+\\frac{{2}^{x}}{x\\ln  (7)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{10}(x) \\sec^{2}{\\left(x \\right)}" :db/id #edb/ref 17592186657625}] :answer-field/correct {:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\log_{10}(x) \\sec^{2}{\\left(x \\right)}" :db/id #edb/ref 17592186657625} :answer-field/id #uuid "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b796de74-72c4-529b-b038-a4d67224a125" :question/problem "Given that $f(x)=\\tan(x)\\log(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\log(x)=\\log_{10}(x)$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{\\tan{\\left(x \\right)}}{x \\ln{\\left(10 \\right)}}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\tan(x)$ and $v(x)=\\log(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\tan(x))^{′}\\log(x)+\\tan(x)(\\log(x))^{′} \\\\  & =(\\sec^{2}(x))(\\log(x))+(\\tan(x))(\\frac{1}{x\\ln(10)}) \\\\  & =\\sec^{2}(x)\\log(x)+\\frac{\\tan(x)}{x\\ln(10)}\\end{aligned}\n$$"}]}
