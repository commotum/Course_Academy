#{[{:db/id #edb/ref 17592186157736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac12\\log_{8}(6)" :db/id #edb/ref 17592186548859}] :answer-field/correct {:answer/id #uuid "fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac12\\log_{8}(6)" :db/id #edb/ref 17592186548859} :answer-field/id #uuid "2317ac7a-6810-5ebd-b759-0ad3059d4d54" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186155258} {:answer-field/choices [{:answer/id #uuid "f4d0b791-662a-50d7-9a51-777bd93033b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "<" :db/id #edb/ref 17592186548844}] :answer-field/correct {:answer/id #uuid "f4d0b791-662a-50d7-9a51-777bd93033b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "<" :db/id #edb/ref 17592186548844} :answer-field/id #uuid "32f00e3e-0ee2-5b85-a1c5-2b6e6779f01e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186155259}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a7e522c-a79d-5bda-94b9-530843463aa8" :question/math-academy-id "q-276944" :question/problem "Solve the inequality $2\\cdot {8}^{2x}<\\frac{1}{3}.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}2\\cdot {8}^{2x} & <\\frac{1}{3} \\\\ {8}^{2x} & <\\frac{1}{6}.\\end{aligned}\n$$\n\nThen, taking the logarithm to base $8$ of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}{log}_{8}⁡({8}^{2x}) & <{log}_{8}⁡\\left(\\frac{1}{6}\\right) \\\\ 2x & <{log}_{8}⁡({6}^{-1}) \\\\ 2x & <-{log}_{8}⁡(6) \\\\ x & <-\\frac{1}{2}{log}_{8}⁡(6).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186405578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1facf79-5511-59b8-91dc-8b52e5da3d69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac12\\ln\\frac{557}{93}" :db/id #edb/ref 17592186406367}] :answer-field/correct {:answer/id #uuid "c1facf79-5511-59b8-91dc-8b52e5da3d69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac12\\ln\\frac{557}{93}" :db/id #edb/ref 17592186406367} :answer-field/id #uuid "84976508-d8ea-53d9-b93e-9f9ee254578b" :answer-field/key "integral" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186406253}] :question/id #uuid "740fb150-6096-5941-a88d-25c2d5508769" :question/problem "Source question: 4.\n\nUse the **Fundamental Theorem of Line Integrals** to evaluate $$\n\\displaystyle \\int_C\\mathbf F\\cdot d\\mathbf r.\n$$ The field $$\n\\displaystyle \\mathbf F=\\left\\langle\\frac{5x}{5x^2+3y^2},\\frac{3y}{5x^2+3y^2}\\right\\rangle\n$$ is conservative with the supplied potential $f=\\ln\\sqrt{5x^2+3y^2}$. The piecewise smooth curve joins $(3,4)$ to $(5,12)$.\n\nIntegral: {{integral}}." :question/worked-solution "$5(5)^2+3(12)^2=557$ and $5(3)^2+3(4)^2=93$. Thus $f(B)-f(A)=\\ln\\sqrt{557}-\\ln\\sqrt{93}$. The curve is understood to lie in the field domain, excluding the origin.\n\nSince $557$ and $93$ are positive, the power and quotient rules for logarithms give\n\n$$\\ln\\sqrt{557}-\\ln\\sqrt{93}=\\frac12\\ln557-\\frac12\\ln93=\\frac12\\ln\\left(\\frac{557}{93}\\right).$$"}] [{:db/id #edb/ref 17592186537006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321df476-4949-5c09-820e-9305d838bc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537000} {:answer/id #uuid "4e59d9d4-da68-5e58-aff1-c4c4a3337e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{4} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537014} {:answer/id #uuid "9a68c5dc-993d-52d2-9754-5b09d9106e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{4 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537041} {:answer/id #uuid "b4961f55-574a-53f6-91ac-244a2907cf1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{\\sqrt{81 - r^{2}}}^{-5}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537051} {:answer/id #uuid "c82cc82c-e96d-5c71-9bfd-49718a58969e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537059}] :answer-field/correct {:answer/id #uuid "321df476-4949-5c09-820e-9305d838bc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537000} :answer-field/id #uuid "346ca32c-f65c-5df0-9d38-5355dcbfffd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537004}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3595f3ec-49d1-5481-82e6-c23464cfa603" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y-4)^{2}\\le 16,x\\le 0,\\,-5\\le z\\le \\sqrt{- x^{2} - y^{2} + 81}\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}2 x y\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/57/5764f328a614ddaa96abd28a4568c4cd7dfcf0988033d3122bdce0e1e52b7bc5.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(0,4)$ in the $xy$-plane, and is\n\n- bounded below by $z=-5,$ and\n\n- bounded above by $z=\\sqrt{- x^{2} - y^{2} + 81}=\\sqrt{81 - r^{2}}.$\n\nWith that in mind, let's now write the ${x}^{2}+(y-4)^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-4)^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta-4)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -8r\\operatorname{sin}⁡\\theta+16 & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{sin}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{sin}⁡\\theta & =0 \\\\ r(r-8\\operatorname{sin}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\sin{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\sin{\\left(\\theta \\right)},\\,\\frac{\\pi}{2}\\le \\theta \\le \\pi,\\,-5\\le z\\le \\sqrt{81 - r^{2}}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}2 x y\\,\\text{d}V & ={∭}_{Δ}2(r\\operatorname{cos}⁡\\theta)(r\\operatorname{sin}⁡\\theta)\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539371 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49693d90-a88f-5cc1-8d9c-4cdbfd34c316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{203 \\ln(4)}{2}" :db/id #edb/ref 17592186539364} {:answer/id #uuid "5ce3c7dc-caf4-59c6-bc90-66911b31b855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 26 \\ln(4)" :db/id #edb/ref 17592186539370} {:answer/id #uuid "66c4bff9-f18e-5a0a-ae8c-565ea3df5f96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\ln(4)" :db/id #edb/ref 17592186539372} {:answer/id #uuid "8b1f244f-0b28-5817-86a7-3ca216955106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539378} {:answer/id #uuid "f6dbc465-6dd3-5c31-801d-8e21abfc3c96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "78 \\ln(4)" :db/id #edb/ref 17592186539390}] :answer-field/correct {:answer/id #uuid "8b1f244f-0b28-5817-86a7-3ca216955106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539378} :answer-field/id #uuid "189e4d5c-7d67-5000-8ba2-67a9c86a5254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539360}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5fc233a3-016d-5c4e-a242-9f02a02751f2" :question/problem "Using the change of variables $u=\\frac{y}{{x}^{2}}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}(xy)^{2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,{x}^{2}\\le y\\le 16{x}^{2},\\,2\\le xy\\le 5\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 16,\\,2\\le v\\le 5\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{aligned}| \\\\  & =-\\frac{3y}{{x}^{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(-\\frac{3y}{{x}^{2}}\\right)}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{\\int }_{1}^{16}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}[{\\int }_{1}^{16}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{16}]dv \\\\  & =\\frac{1}{3}{\\int }_{2}^{5}{v}^{2}(\\operatorname{ln}⁡16-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}{\\int }_{2}^{5}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{2}^{5} \\\\  & =\\frac{2\\operatorname{ln}⁡4}{9}\\cdot (125-8) \\\\  & =26\\operatorname{ln}⁡4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186539380 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1760086a-7c09-5e8c-b8a1-c75d9fe9a51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\ln(4)" :db/id #edb/ref 17592186539359} {:answer/id #uuid "6a996faf-b917-5a49-b738-11415367209b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 14 \\ln(4)" :db/id #edb/ref 17592186539373} {:answer/id #uuid "7ea0e4fa-607a-52bf-a6d1-09e1f76b57f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539377} {:answer/id #uuid "cf2b0b28-1110-5655-97fd-3599b3b30adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42 \\ln(4)" :db/id #edb/ref 17592186539385} {:answer/id #uuid "d44bf487-a72f-5688-b79f-679c5c9843de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{85 \\ln(4)}{2}" :db/id #edb/ref 17592186539386}] :answer-field/correct {:answer/id #uuid "7ea0e4fa-607a-52bf-a6d1-09e1f76b57f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\operatorname{ln}⁡4" :db/id #edb/ref 17592186539377} :answer-field/id #uuid "e0c9be7b-466c-5bfe-beef-e661d5145178" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186539389}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b880e9be-152d-5343-be07-baad51f74777" :question/problem "Using the change of variables $u=\\frac{y}{{x}^{2}}$ and $v=xy,$ evaluate the double integral\n\n$$\n{∬}_{D}(xy)^{2}\\,dx\\,dy,\n$$\n\nwhere $D=\\{(x,y)\\,:\\,{x}^{2}\\le y\\le 16{x}^{2},\\,1\\le xy\\le 4\\}.$" :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}]\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\,dx\\,dy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))|\\frac{∂(x,y)}{∂(u,v)}|du\\,dv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nNote that the change of variables\n\n$$\nu=\\frac{y}{{x}^{2}},\\,v=xy\n$$\n\n \ngives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:[\\begin{aligned}x \\\\ y\\end{aligned}]\\to [\\begin{aligned}u(x,y) \\\\ v(x,y)\\end{aligned}].\n$$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 16,\\,1\\le v\\le 4\\}.\\end{aligned}\n$$\n\n**Step 2**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =|\\begin{aligned}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\frac{2y}{{x}^{3}} & \\frac{1}{{x}^{2}} \\\\ y & \\text{ }\\text{ }x\\end{aligned}| \\\\  & =-\\frac{3y}{{x}^{2}}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to $T:$\n\nThe Jacobian determinant corresponding to $T$ is\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(-\\frac{3y}{{x}^{2}}\\right)}=-\\frac{1}{3u}.\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 4**: Perform the change of variables:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{\\int }_{1}^{16}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}[{\\int }_{1}^{16}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{16}]dv \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}(\\operatorname{ln}⁡16-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}{\\int }_{1}^{4}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{1}^{4} \\\\  & =\\frac{2\\operatorname{ln}⁡4}{9}\\cdot (64-1) \\\\  & =14\\operatorname{ln}⁡4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce4be0f-5d33-51bc-9050-760037179d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left(- 2 {e}^{2(t + 1)} \\sin((t + 1)^{2}) (t + 1)\\right)" :db/id #edb/ref 17592186555963} {:answer/id #uuid "357d82b0-b468-5bc5-b46c-2ef6c8defaa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left(2{e}^{2(t + 1)}(\\operatorname{cos}⁡({(t + 1)}^{2})-(t + 1)\\operatorname{sin}⁡({(t + 1)}^{2}))\\right)" :db/id #edb/ref 17592186555970} {:answer/id #uuid "55240750-0f78-5bc6-92b3-9cedb81aed12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left({e}^{2(t + 1)} \\left(2 \\cos((t + 1)^{2}) - \\sin((t + 1)^{2})\\right)\\right)" :db/id #edb/ref 17592186555976} {:answer/id #uuid "5d4a2f77-851b-5117-b328-24f12ba3ba72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left(2 \\cos((t + 1)^{2}) {e}^{2(t + 1)}\\right)" :db/id #edb/ref 17592186555979} {:answer/id #uuid "97ca2dc3-593b-53d0-842f-e141944c8015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left({e}^{(t + 1)} \\left(2 \\cos((t + 1)^{2}) - {e}^{(t + 1)} \\sin((t + 1)^{2})\\right)\\right)" :db/id #edb/ref 17592186555992}] :answer-field/correct {:answer/id #uuid "357d82b0-b468-5bc5-b46c-2ef6c8defaa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\left(2{e}^{2(t + 1)}(\\operatorname{cos}⁡({(t + 1)}^{2})-(t + 1)\\operatorname{sin}⁡({(t + 1)}^{2}))\\right)" :db/id #edb/ref 17592186555970} :answer-field/id #uuid "7227fc03-6c4a-59f2-afbf-1702442c4391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555983}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f25a065-b9d2-5631-91bf-0e1b3f75fc51" :question/problem "If $f(x,y,z)=4\\left(yz\\operatorname{cos}⁡x\\right)$ and $r(t)={(t + 1)}^{2}\\,i+{e}^{(t + 1)}\\,j+{e}^{(t + 1)}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(4\\left(yz\\operatorname{cos}⁡x\\right))\\,i+\\frac{∂}{∂y}(4\\left(yz\\operatorname{cos}⁡x\\right))\\,j+\\frac{∂}{∂z}(4\\left(yz\\operatorname{cos}⁡x\\right))\\,k \\\\  & =(4\\left(-yz\\operatorname{sin}⁡x\\right))\\,i+(4\\left(+z\\operatorname{cos}⁡x\\right))\\,j+(4\\left(+y\\operatorname{cos}⁡x\\right))\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={(t + 1)}^{2},y={e}^{(t + 1)},$ and $z={e}^{(t + 1)}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(4\\left(-{e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})\\right))\\,i+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,j+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({(t + 1)}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{(t + 1)})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{(t + 1)})\\,k \\\\  & =(2(t + 1))\\,i+(+{e}^{(t + 1)})\\,j+(+{e}^{(t + 1)})\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((4\\left(-{e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})\\right))\\,i+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,j+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,k)\\cdot ((2(t + 1))\\,i+(+{e}^{(t + 1)})\\,j+(+{e}^{(t + 1)})\\,k) \\\\  & =4\\left(-2(t + 1){e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\cdot {e}^{(t + 1)}+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\cdot {e}^{(t + 1)}\\right) \\\\  & =4\\left(-2(t + 1){e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})+2{e}^{2(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right) \\\\  & =4\\left(2{e}^{2(t + 1)}(\\operatorname{cos}⁡({(t + 1)}^{2})-(t + 1)\\operatorname{sin}⁡({(t + 1)}^{2}))\\right).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186555998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d1d6bd-d89b-5bad-bd17-b50341f803cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 {e}^{2(t - 2)} \\sin((t - 2)^{2}) (t - 2)" :db/id #edb/ref 17592186555960} {:answer/id #uuid "4664a78f-effb-5ddf-988f-356dddd95a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\cos((t - 2)^{2}) {e}^{2(t - 2)}" :db/id #edb/ref 17592186555971} {:answer/id #uuid "8f66985e-58fb-59d3-98c8-1287b1ccd811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2(t - 2)}(\\operatorname{cos}⁡({(t - 2)}^{2})-(t - 2)\\operatorname{sin}⁡({(t - 2)}^{2}))" :db/id #edb/ref 17592186555991} {:answer/id #uuid "b5f54656-e29a-5b5b-890b-fac4665b8674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{(t - 2)} \\left(2 \\cos((t - 2)^{2}) - {e}^{(t - 2)} \\sin((t - 2)^{2})\\right)" :db/id #edb/ref 17592186555997} {:answer/id #uuid "ee89e640-8825-5ae1-b367-7b5359189bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2(t - 2)} \\left(2 \\cos((t - 2)^{2}) - \\sin((t - 2)^{2})\\right)" :db/id #edb/ref 17592186556005}] :answer-field/correct {:answer/id #uuid "8f66985e-58fb-59d3-98c8-1287b1ccd811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2(t - 2)}(\\operatorname{cos}⁡({(t - 2)}^{2})-(t - 2)\\operatorname{sin}⁡({(t - 2)}^{2}))" :db/id #edb/ref 17592186555991} :answer-field/id #uuid "9f7f1241-2ff1-5381-8dd4-2f497ed46b35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555994}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b766d452-c3b3-5624-a6b9-7ef01ce70700" :question/problem "If $f(x,y,z)=yz\\operatorname{cos}⁡x$ and $r(t)={(t - 2)}^{2}\\,i+{e}^{(t - 2)}\\,j+{e}^{(t - 2)}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(yz\\operatorname{cos}⁡x)\\,i+\\frac{∂}{∂y}(yz\\operatorname{cos}⁡x)\\,j+\\frac{∂}{∂z}(yz\\operatorname{cos}⁡x)\\,k \\\\  & =-yz\\operatorname{sin}⁡x\\,i+z\\operatorname{cos}⁡x\\,j+y\\operatorname{cos}⁡x\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={(t - 2)}^{2},y={e}^{(t - 2)},$ and $z={e}^{(t - 2)}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(-{e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2}))\\,i+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,j+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({(t - 2)}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{(t - 2)})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{(t - 2)})\\,k \\\\  & =(2(t - 2))\\,i+(+{e}^{(t - 2)})\\,j+(+{e}^{(t - 2)})\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((-{e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2}))\\,i+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,j+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,k)\\cdot ((2(t - 2))\\,i+(+{e}^{(t - 2)})\\,j+(+{e}^{(t - 2)})\\,k) \\\\  & =-2(t - 2){e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2})+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2})\\cdot {e}^{(t - 2)}+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2})\\cdot {e}^{(t - 2)} \\\\  & =-2(t - 2){e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2})+2{e}^{2(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}) \\\\  & =2{e}^{2(t - 2)}(\\operatorname{cos}⁡({(t - 2)}^{2})-(t - 2)\\operatorname{sin}⁡({(t - 2)}^{2})).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0847027d-bd26-57f8-9403-9e4eb6cdf358" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{11}{2}\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(\\frac{11}{2}\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657611} {:answer/id #uuid "3e3cc552-b13d-5424-9879-4f15ac541649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(5\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(5\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657615} {:answer/id #uuid "921c17d0-1976-5b3a-915c-86d80055277b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(4\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(4\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657621} {:answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(6\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657622} {:answer/id #uuid "bffd7eb9-1ef0-5aae-98d8-18005e448afe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(\\frac{9}{2}\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(\\frac{9}{2}\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657624}] :answer-field/correct {:answer/id #uuid "96e424aa-4e93-575f-89d4-05f0f2353484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(6\\right)\\left(\\frac{\\log_{5}(x)}{x}\\right)+\\left(6\\right)\\left(\\frac{\\ln(x)}{x\\ln(5)}\\right)" :db/id #edb/ref 17592186657622} :answer-field/id #uuid "571e7da4-8bf0-538e-b7aa-3f10b987cbb7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657617}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0bcc9f93-4f3c-5124-8641-edf082f5099b" :question/problem "Given that $f(x) = 6\\log_{5} x\\ln x$, find $f^{′}(x)$." :question/worked-solution "Here, we have the product of two functions $u(x)=6\\log_{5} x$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(6\\log_{5} x)^{′}\\ln x+6\\log_{5} x(\\ln x)^{′} \\\\  & =(\\frac{6}{x \\ln{\\left(5 \\right)}})(\\ln x)+(6\\log_{5} x)(\\frac{1}{x}) \\\\  & =\\frac{6\\log_{5} x}{x} + \\frac{6\\ln x}{x\\ln 5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a5691a-21e3-5308-8cb3-fbdd26bcd3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657609} {:answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657616} {:answer/id #uuid "d8b56f65-2f66-5f41-a6d1-e135ab1d87f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(0\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657626} {:answer/id #uuid "e0f9ff9a-2e3c-5c35-8c02-c94b59758a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-1\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(2\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657628} {:answer/id #uuid "e96037dc-192b-5953-9f3f-a01cce4af599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-1\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657629}] :answer-field/correct {:answer/id #uuid "43131dd5-cd59-5802-b52a-0f14d66ec6ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\left(-2\\right)\\left(\\frac{\\log_{4}(x)}{x^{3}}\\right)+\\left(1\\right)\\left(\\frac{1}{x^{3} \\ln{\\left(4 \\right)}}\\right)" :db/id #edb/ref 17592186657616} :answer-field/id #uuid "f6fe5e07-85dc-5fb0-a386-89122bedaa05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186657630}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "18f3eb93-e574-5f5a-8279-040ddcf04567" :question/problem "Given that $f(x) = x^{-2}\\log_{4} x$, find $f^{′}(x)$." :question/worked-solution "Here, we have the product of two functions $u(x)=x^{-2}$ and $v(x)=\\log_{4} x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(x^{-2})^{′}\\log_{4} x+x^{-2}(\\log_{4} x)^{′} \\\\  & =(- \\frac{2}{x^{3}})(\\log_{4} x)+(x^{-2})(\\frac{1}{x \\ln{\\left(4 \\right)}}) \\\\  & =x^{-3}(-2\\log_{4} x + \\frac{1}{\\ln 4})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186657619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f8e988-371d-5570-a38a-e5d41a7860f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x} \\log_{7}(x) \\ln{\\left(2 \\right)}" :db/id #edb/ref 17592186657610} {:answer/id #uuid "8c63305c-69f5-4ae0-b54e-0402c2f68f76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186675707} {:answer/id #uuid "71157233-8537-44ad-a81f-f6da7a244aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x}" :db/id #edb/ref 17592186675708} {:answer/id #uuid "deb9a7d0-c1f7-41bd-8094-8396049b6cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x}l" :db/id #edb/ref 17592186675709} {:answer/id #uuid "9f11ea98-e167-4bd6-a3db-0b5fd2cac758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x}\\ln" :db/id #edb/ref 17592186675710} {:answer/id #uuid "b9e4551d-d315-4154-b6e0-a5d8d2756272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2^{x}\\ln2" :db/id #edb/ref 17592186675711} {:answer/id #uuid "66f48a77-e405-46b5-b282-cbfe28726b56" :answer/type {:db/id #edb/ref 17592186