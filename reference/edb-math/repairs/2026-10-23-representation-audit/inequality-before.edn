 -3{e}^{2-3x} & <-9 \\\\ {e}^{2-3x} & >3.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2-3x}) & >\\operatorname{ln}⁡3 \\\\ 2-3x & >\\operatorname{ln}⁡3 \\\\ -3x & >\\operatorname{ln}⁡3-2 \\\\ 3x & <2-\\operatorname{ln}⁡3 \\\\ x & <\\frac{1}{3}(2-\\operatorname{ln}⁡3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36c91c58-a410-5c55-87bc-e96d25c23eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186548464}] :answer-field/correct {:answer/id #uuid "36c91c58-a410-5c55-87bc-e96d25c23eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186548464} :answer-field/id #uuid "b219f5c4-1405-5df3-8409-1c09dc28bb30" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186548942} {:answer-field/choices [{:answer/id #uuid "53d7e613-89f8-5827-98a8-0f87820ea103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value ">" :db/id #edb/ref 17592186548512}] :answer-field/correct {:answer/id #uuid "53d7e613-89f8-5827-98a8-0f87820ea103" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value ">" :db/id #edb/ref 17592186548512} :answer-field/id #uuid "de8ff1b6-dbc5-59c7-b40e-6086f8c8b93d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186548965}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c14a17a4-e51c-5a30-87f2-f52799025a61" :question/math-academy-id "q-277850" :question/problem "Solve the inequality $\\frac{3{e}^{x}-{e}^{3/2}}{2\\sqrt{e}}>e.$\n\n$x$\n{{field-1}}{{field-2}}" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{3{e}^{x}-{e}^{3/2}}{2\\sqrt{e}} & >e \\\\ 3{e}^{x}-{e}^{3/2} & >2e\\sqrt{e} \\\\ 3{e}^{x}-{e}^{3/2} & >2e\\cdot {e}^{1/2} \\\\ 3{e}^{x}-{e}^{3/2} & >2{e}^{(1+\\frac{1}{2})} \\\\ 3{e}^{x}-{e}^{3/2} & >2{e}^{3/2} \\\\ 3{e}^{x} & >3{e}^{3/2} \\\\ {e}^{x} & >{e}^{3/2}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & >\\operatorname{ln}⁡({e}^{3/2}) \\\\ x & >\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186549065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50ce5010-9bbd-5ade-899e-fe1a3f097428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\operatorname{ln}⁡5-\\operatorname{ln}⁡2" :db/id #edb/ref 17592186548507} {:answer/id #uuid "5e5e4a4c-1f14-58c2-b546-bbbe0317d298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\operatorname{ln}⁡2-\\operatorname{ln}⁡5" :db/id #edb/ref 17592186548527} {:answer/id #uuid "cf312d58-edda-5e8f-ba13-2b32799659a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\operatorname{ln}⁡2+\\operatorname{ln}⁡5" :db/id #edb/ref 17592186548761} {:answer/id #uuid "e79d4b8f-48ac-5d71-b6cb-54ae49de9a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\operatorname{ln}⁡2-\\operatorname{ln}⁡5" :db/id #edb/ref 17592186548809} {:answer/id #uuid "f34a907c-f391-5979-9222-48eb1c76e838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\operatorname{ln}⁡2+\\operatorname{ln}⁡5" :db/id #edb/ref 17592186548838}] :answer-field/correct {:answer/id #uuid "e79d4b8f-48ac-5d71-b6cb-54ae49de9a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\operatorname{ln}⁡2-\\operatorname{ln}⁡5" :db/id #edb/ref 17592186548809} :answer-field/id #uuid "41f9833e-1de8-5784-982b-34d3e897640a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186548899}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3a9275d-4331-54c5-bd20-117d217d8aa5" :question/math-academy-id "q-87718" :question/problem "Solve the inequality $5{e}^{x}+2\\le 4.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}5{e}^{x}+2 & \\le 4 \\\\ 5{e}^{x} & \\le 2 \\\\ {e}^{x} & \\le \\frac{2}{5}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & \\le \\operatorname{ln}⁡\\left(\\frac{2}{5}\\right) \\\\ x & \\le \\operatorname{ln}⁡2-\\operatorname{ln}⁡5.\\end{aligned}\n$$"}] :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Greater Than One"}]}
