#{[{:db/id #edb/ref 17592186157429 :knowledge-point/canonical-example {:db/id #edb/ref 17592186157135 :question/id #uuid "e5b64c26-300d-530d-b22f-ff061f4e3296" :question/math-academy-id "e-7657" :question/problem "Solve the inequality $4e^x - 5 >  0.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}4{e}^{x}-5 & >0 \\\\ 4{e}^{x} & >5 \\\\ {e}^{x} & >\\frac{5}{4}.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x}) & >\\operatorname{ln}⁡\\left(\\frac{5}{4}\\right) \\\\ x & >\\operatorname{ln}⁡5-\\operatorname{ln}⁡4.\\end{aligned}\n$$"} :knowledge-point/id #uuid "04309d45-2991-5d4b-9dc9-b75422610ab6" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049053} {:db/id #edb/ref 17592186049195} {:db/id #edb/ref 17592186049986} {:db/id #edb/ref 17592186050649}] :knowledge-point/questions [{:db/id #edb/ref 17592186157736 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\ln 6}{2\\ln 8}" :db/id #edb/ref 17592186548859}] :answer-field/correct {:answer/id #uuid "fb7116a0-6991-5a7c-bb2e-44f6d98b2da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\ln 6}{2\\ln 8}" :db/id #edb/ref 17592186548859} :answer-field/id #uuid "2317ac7a-6810-5ebd-b759-0ad3059d4d54" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186155258} {:answer-field/choices [{:answer/id #uuid "f4d0b791-662a-50d7-9a51-777bd93033b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "<" :db/id #edb/ref 17592186548844}] :answer-field/correct {:answer/id #uuid "f4d0b791-662a-50d7-9a51-777bd93033b6" :answer/type {:db/id #edb/ref 17592