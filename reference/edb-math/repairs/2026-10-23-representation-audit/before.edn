#{[{:db/id #edb/ref 17592186096618 :knowledge-point/canonical-example {:db/id #edb/ref 17592186096418 :question/id #uuid "6bb0eded-7277-5ab5-8c13-bfc480403b1a" :question/math-academy-id "e-3635" :question/problem "Given that $f(x)=x^2\\ln x,$ find $f'(x).$" :question/worked-solution "Here, we have the product of two functions $u(x) = x^2$ and $v(x)=\\ln x.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={({x}^{2})}^{′}ln⁡x+{x}^{2}{(ln⁡x)}^{′} \\\\  & =2x\\cdot ln⁡x+{x}^{2}\\left(\\frac{1}{x}\\right) \\\\  & =2xln⁡x+x \\\\  & =x(2ln⁡x+1)\\end{aligned}\n$$"} :knowledge-point/id #uuid "f15a60dd-f6a7-577d-bdbc-148032de94c8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048749} {:db/id #edb/ref 17592186050690}] :knowledge-point/question-generator {:db/id #edb/ref 17592186657632 :question-generator/id #uuid "660f448b-996d-51ca-96b2-1f1874f969d6" :question-generator/script "generators/f5/f51b9059708e5efae3794d79ff1f81534269d4843a7013759e9781a1af819e02/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186097162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b0160d55-41e0-5207-b70c-5dfc23c09ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5\\ln x}{x}" :db/id #edb/ref 17592186094946} {:answer/id #uuid "c7990de4-7764-55e3-9375-eb40c109bc76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{x} + \\frac{5\\ln x}{x\\ln 3}" :db/id #edb/ref 17592186094947} {:answer/id #uuid "d09b4047-e57a-53fc-a06a-395be25f2765" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{\\ln x}{x\\ln 3}" :db/id #edb/ref 17592186094948} {:answer/id #uuid "335f8a22-7cb0-58d7-b32a-65b960fb6f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\log_{3} x}{x} + \\frac{5\\ln x}{x\\ln 3}" :db/id #edb