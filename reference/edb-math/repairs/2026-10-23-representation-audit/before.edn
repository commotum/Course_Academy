variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}(xy)^{2}\\,dx\\,dy & ={∬}_{Δ}{v}^{2}|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\,\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\cdot |\\frac{1}{3u}|\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{\\int }_{1}^{16}\\frac{{v}^{2}}{u}\\,\\text{d}u\\,\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}[{\\int }_{1}^{16}\\frac{1}{u}\\,\\text{d}u]\\text{d}v \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}[\\operatorname{ln}⁡|u|\\,{|}_{1}^{16}]dv \\\\  & =\\frac{1}{3}{\\int }_{1}^{4}{v}^{2}(\\operatorname{ln}⁡16-\\operatorname{ln}⁡1)\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}{\\int }_{1}^{4}{v}^{2}\\,dv \\\\  & =\\frac{2\\operatorname{ln}⁡4}{3}\\cdot \\frac{1}{3}{v}^{3}\\,{|}_{1}^{4} \\\\  & =\\frac{2\\operatorname{ln}⁡4}{9}\\cdot (64-1) \\\\  & =14\\operatorname{ln}⁡4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186539387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c8e42dd-1135-55d6-baea-5eaf5e395812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{182 \\ln{\\left(2 \\right)}}{9}" :db/id #edb/ref 17592186539362} {:answer/id #uuid "5775d9e0-17da-5f4b-97d4-d8327fe13f79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{671 \\ln{\\left(2 \\right)}}{6}" :db/id #edb/ref 17592186539368} {:answer/id #uuid "bee804f0-fe47-54f2-82b3-1ab225bbaa16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\ln{\\left(2 \\right)}}{3}" :db/id #edb/ref 17592186539381} {:answer/id #uuid "c8511436-e484-5251-a621-0417962a64ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{182 \\ln{\\left(2 \\right)}}{3}" :db/id #edb/ref 17592186539383} {:answer/id #uuid "f7a1ff94-668d-56c9-ab15-77c13bfdd79a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{182 \\ln{\\left(2 \\right)}}{9}" :db/id #edb/ref 