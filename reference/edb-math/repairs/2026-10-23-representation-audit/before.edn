}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{'}(x) & =({x}^{2})^{'}{e}^{2x}+{x}^{2}({e}^{2x})^{'} \\\\  & =(2x)({e}^{2x})+({x}^{2})(2{e}^{2x}) \\\\  & =2x{e}^{2x}+2{x}^{2}{e}^{2x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40427a01-e865-553d-9978-a8f9a86f4287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\cdot {3}^{x}" :db/id #edb/ref 17592186251086} {:answer/id #uuid "4d3624d4-0726-5e76-8ec2-c6738c5615aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186251193} {:answer/id #uuid "a5e9eb2f-18a3-50d7-9c4e-0a47c7a87ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186251984} {:answer/id #uuid "b56383b5-a0ac-53ad-a0fe-2a36c1ab2610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}" :db/id #edb/ref 17592186252146} {:answer/id #uuid "ee1a7c18-5e33-593a-86b3-851a45507a67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186252636}] :answer-field/correct {:answer/id #uuid "a5e9eb2f-18a3-50d7-9c4e-0a47c7a87ea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1+x\\operatorname{ln}⁡3){3}^{x}" :db/id #edb/ref 17592186251984} :answer-field/id #uuid "7ce3d68b-66a4-51fa-a4ba-3670771baf6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253021}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11c94822-e3fa-5674-8f0a-3b72546b7b89" :question/math-academy-id "q-11841" :question/problem "Given that $f(x)=x\\cdot {3}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)=x$ and $v(x)={3}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(x)^{′}\\cdot {3}^{x}+x\\cdot ({3}^{x})^{′} \\\\  & ={3}^{x}+(x)(\\operatorname{ln}⁡3\\cdot {3}^{x}) \\\\  & ={3}^{x}+x\\operatorname{ln}⁡3\\cdot {3}^{x} \\\\  & =(1+x\\operatorname{ln}⁡3){3}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1371ebf8-eb22-510a-8da9-ab71603cf224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)x{e}^{x}" :db/id #edb/ref 17592186284960} {:answer/id #uuid "53d9fa80-4531-56fa-a24b-26f7f44fadfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{x}" :db/id #edb/ref 17592186285560} {:answer/id #uuid "7e63c504-8cfa-54d7-aead-931836c675c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(2{e}^{x}+x)" :db/id #edb/ref 17592186285950} {:answer/id #uuid "8f418a4b-7d9e-52b0-a17c-229783a68355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)x{e}^{x}" :db/id #edb/ref 17592186286094} {:answer/id #uuid "904ec37a-bb54-5997-a86e-3970a5f9817d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(x{e}^{x}+2)" :db/id #edb/ref 17592186286106}] :answer-field/correct {:answer/id #uuid "1371ebf8-eb22-510a-8da9-ab71603cf224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)x{e}^{x}" :db/id #edb/ref 17592186284960} :answer-field/id #uuid "4af7b461-8f62-58e4-ac36-73b94cae5741" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287310}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d5b2e99-3a45-59ab-9bf2-0e86debf5990" :question/math-academy-id "q-1916" :question/problem "Given that $f(x)={x}^{2}{e}^{x},$ find ${f}^{′}(x).$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{2})^{′}{e}^{x}+{x}^{2}({e}^{x})^{′} \\\\  & =(2x)({e}^{x})+({x}^{2})({e}^{x}) \\\\  & =2x{e}^{x}+{x}^{2}{e}^{x} \\\\  & =(x+2)x{e}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186287943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733a21b6-530d-58ad-a226-6cac63423ff9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{ln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186285849} {:answer/id #uuid "b59cbc6b-900a-5727-b8b9-ede6d31b43fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{x}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286442} {:answer/id #uuid "b7de04db-df2e-5b86-833c-791e2ab5c775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}+sin⁡xlog⁡x" :db/id #edb/ref 17592186286464} {:answer/id #uuid "c5d4f500-323e-5311-9fac-df967ad59f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286604} {:answer/id #uuid "df108f3b-d4a9-5d27-b27b-ac44d2256aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{x}-sin⁡x" :db/id #edb/ref 17592186286822}] :answer-field/correct {:answer/id #uuid "c5d4f500-323e-5311-9fac-df967ad59f73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x}{xln⁡10}-sin⁡xlog⁡x" :db/id #edb/ref 17592186286604} :answer-field/id #uuid "87489006-c764-5370-a687-c0a258ab9b3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident 