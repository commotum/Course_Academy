ligned}\n$$"} {:db/id #edb/ref 17592186299804 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "308e34e3-3155-5d60-9431-e03d0af4fa0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297757} {:answer/id #uuid "fb9ed3fa-86d1-4803-8dcc-ef4b061d6628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x^2e^{x}" :db/id #edb/ref 17592186576149}] :answer-field/correct {:answer/id #uuid "308e34e3-3155-5d60-9431-e03d0af4fa0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297757} :answer-field/id #uuid "f623b835-9c91-54d1-9180-2267f616a2e6" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b53a0674-b02c-54b5-9306-2aa04fbf2674" :question/math-academy-id "q-319902" :question/problem "Given that $f(x)={x}^{3}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,{x}^{3}{e}^{x}$" :question/worked-solution "Here, we have the product of two functions $u(x)={x}^{3}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =({x}^{3})^{′}{e}^{x}+{x}^{3}({e}^{x})^{′} \\\\  & =(3{x}^{2})({e}^{x})+({x}^{3})({e}^{x}) \\\\  & =3{x}^{2}{e}^{x}+{x}^{3}{e}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "401c2c7b-6e36-5f00-8952-5abb22a759f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297807}] :answer-field/correct {:answer/id #uuid "401c2c7b-6e36-5f00-8952-5abb22a759f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}{e}^{x}" :db/id #edb/ref 17592186297807} :answer-field/id #uuid "1f735430-71e8-5777-be52-a2e57f486a49" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298744}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7e457c64-526b-50d2-a5e1-9c9608789ec6" :question/math-academy-id "q-319903" :question/problem "Given that $f(x)=5{x}^{2}{e}^{x},$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=10x{e}^{x}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=5{x}^{2}$ and $v(x)={e}^{x}.$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(5{x}^{2})^{′}{e}^{x}+5{x}^{2}({e}^{x})^{′} \\\\  & =(10x)({e}^{x})+(5{x}^{2})({e}^{x}) \\\\  & =10x{e}^{x}+5{x}^{2}{e}^{x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2303e32-8b26-55ec-9d0f-18e1bc3899cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3){log}_{3}(x)" :db/id #edb/ref 17592186298462}] :answer-field/correct {:answer/id #uuid "d2303e32-8b26-55ec-9d0f-18e1bc3899cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3}^{x}\\operatorname{ln}(3){log}_{3}(x)" :db/id #edb/ref 17592186298462} :answer-field/id #uuid "792dd6e3-1db8-586c-a5f7-0da2170dac92" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299050}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d825ca35-2305-5442-afb6-a99517062893" :question/math-academy-id "q-320814" :question/problem "Given that $f(x)={3}^{x}{log}_{3}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={3}^{x}$ and $v(x)={log}_{3}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({3}^{x})}^{′}{log}_{3}⁡(x)+{3}^{x}{({log}_{3}⁡(x))}^{′} \\\\  & =({3}^{x}\\operatorname{ln}⁡(3))({log}_{3}⁡(x))+({3}^{x})\\left(\\frac{1}{x\\operatorname{ln}⁡(3)}\\right) \\\\  & ={3}^{x}\\operatorname{ln}⁡(3){log}_{3}⁡(x)+\\frac{{3}^{x}}{x\\operatorname{ln}⁡(3)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ca46b1c5-ece7-5119-abe8-777dcc7ec3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{x\\operatorname{ln}(4)}" :db/id #edb/ref 17592186298433}] :answer-field/correct {:answer/id #uuid "ca46b1c5-ece7-5119-abe8-777dcc7ec3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{4}^{x}}{x\\operatorname{ln}(4)}" :db/id #edb/ref 17592186298433} :answer-field/id #uuid "0aa44b57-7202-5d5a-9c5f-cd88604e7d86" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6161762d-7ca8-5487-95de-c569a1e07882" :question/math-academy-id "q-320815" :question/problem "Given that $f(x)={4}^{x}{log}_{4}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of the two functions $u(x)={4}^{x}$ and $v(x)={log}_{4}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({4}^{x})}^{′}{log}_{4}⁡(x)+{4}^{x}{({log}_{4}⁡(x))}^{′} \\\\  & =({4}^{x}\\operatorname{ln}⁡(4))({log}_{4}⁡(x))+({4}^{x})\\left(\\frac{1}{x\\operatorname{ln}⁡(4)}\\right) \\\\  & ={4}^{x}\\operatorname{ln}⁡(4){log}_{4}⁡(x)+\\frac{{4}^{x}}{x\\operatorname{ln}⁡(4)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186299908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e34c232-975f-51cf-8ed5-ecf0f78eff8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{5}^{-x}\\operatorname{ln}(5){log}_{7}(x)" :db/id #edb/ref 17592186297797} {:answer/id #uuid "8a591582-6e6f-4147-9d4d-ddb81a77153c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5^{-x}\\ln5\\left(\\log_7x\\right)" :db/id #edb/ref 17592186576151}] :answer-field/correct {:answer/id #uuid "3e34c232-975f-51cf-8ed5-ecf0f78eff8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{5}^{-x}\\operatorname{ln}(5){log}_{7}(x)" :db/id #edb/ref 17592186297797} :answer-field/id #uuid "3b389b0c-f96f-5746-b4d1-da5e3f5fb10c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42b535b3-90b5-5bc5-bbb3-36d4082e369c" :question/math-academy-id "q-320816" :question/problem "Given that $f(x)={5}^{-x}{log}_{7}⁡(x),$ find ${f}^{′}(x).$\n\n${f}^{′}(x)=$\n{{field-1}} $+\\,\\frac{{5}^{-x}}{xln⁡(7)}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={5}^{-x}$ and $v(x)={log}_{7}⁡(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({5}^{-x})}^{′}{log}_{7}⁡(x)+{5}^{-x}{({log}_{7}⁡(x))}^{′} \\\\  & =(-{5}^{-x}ln⁡(5))({log}_{7}⁡(x))+({5}^{-x})\\left(\\frac{1}{xln⁡(7)}\\right) \\\\  & =-{5}^{-x}ln⁡(5){log}_{7}⁡(x)+\\frac{{5}^{-x}}{xln⁡(7)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186571385 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7864c3b-b764-56cd-a641-bd65ea7dd484" 