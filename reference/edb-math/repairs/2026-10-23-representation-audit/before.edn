{x} \\ln{\\left(2 \\right)} \\ln{\\left(x \\right)}}{\\ln{\\left(7 \\right)}}" :db/id #edb/ref 17592186657610} :answer-field/id #uuid "23643de0-4f04-5b7d-97e1-51f4725c1a04" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657614}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "726b77c9-4439-577a-8549-9ccc83c65f8b" :question/problem "Given that $f(x)={2}^{x}\\log _{7} (x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{2^{x}}{x \\ln{\\left(7 \\right)}}$" :question/worked-solution "Here, we have the product of the two functions $u(x)={2}^{x}$ and $v(x)=\\log _{7} (x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & ={({2}^{x})}^{′}\\log _{7} (x)+{2}^{x}{(\\log _{7} (x))}^{′} \\\\  & =({2}^{x}\\ln  (2))(\\log _{7} (x))+({2}^{x})(\\frac{1}{x\\ln  (7)}) \\\\  & ={2}^{x}\\ln  (2)\\log _{7} (x)+\\frac{{2}^{x}}{x\\ln  (7)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657623 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\ln{\\left(10 \\right)}}" :db/id #edb/ref 17592186657625}] :answer-field/correct {:answer/id #uuid "c94a4fb8-5d4b-51de-9265-fdf1204cf1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\ln{\\left(x \\right)} \\sec^{2}{\\left(x \\right)}}{\\ln{\\left(10 \\right)}}" :db/id #edb/ref 17592186657625} :answer-field/id #uuid "66f0f5cd-b5e5-5b2f-b843-1258c616a836" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b796de74-72c4-529b-b038-a4d67224a125" :question/problem "Given that $f(x)=\\tan(x)\\log(x),$ find ${f}^{′}(x).$\n\n**Hint:** $\\log(x)=\\log_{10}(x)$\n\n$f^{\\prime}(x)=$\n{{field-1}} $+\\,\\frac{\\tan{\\left(x \\right)}}{x \\ln{\\left(10 \\right)}}$" :question/worked-solution "Here, we have the product of two functions $u(x)=\\tan(x)$ and $v(x)=\\log(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(\\tan(x))^{′}\\log(x)+\\tan(x)(\\log(x))^{′} \\\\  & =(\\sec^{2}(x))(\\log(x))+(\\tan(x))(\\frac{1}{x\\ln(10)}) \\\\  & =\\sec^{2}(x)\\log(x)+\\frac{\\tan(x)}{x\\ln(10)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186657627 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620} {:answer/id #uuid "e7cb6598-216f-42c9-acbb-153b6a47e8da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^3+4}{x}" :db/id #edb/ref 17592186674541}] :answer-field/correct {:answer/id #uuid "7d4fe52b-b7be-5dfe-9a62-a9bb807e825c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x^{3} + 4}{x}" :db/id #edb/ref 17592186657620} :answer-field/id #uuid "fd8a4fb2-1b6c-5f94-bc6f-ffd7cd7945d1" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186657631}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd5b6598-4397-5f58-8be5-6a17f6668cbf" :question/problem "Given that $f(x)=({x}^{3}+4)\\ln(x),$ find ${f}^{′}(x).$\n\n$f^{\\prime}(x)=3 x^{2} \\ln{\\left(x \\right)}\\,+$\n{{field-1}}" :question/worked-solution "Here, we have the product of two functions $u(x)=({x}^{3}+4)$ and $v(x)=\\ln(x).$ So, we apply the product rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =(({x}^{3}+4))^{′}\\ln(x)+({x}^{3}+4)(\\ln(x))^{′} \\\\  & =(3{x}^{2})(\\ln(x))+({x}^{3}+4)(\\frac{1}{x}) \\\\  & =3{x}^{2}\\ln(x)+\\frac{{x}^{3}+4}{x}\\end{aligned}\n$$"}] :knowledge-point/title "Differentiating a Product Containing an Exponential or Logarithmic Function"}] [{:db/id #edb/ref 17592186124470 :knowledge-point/canonical-example {:db/id #edb/ref 17592186124277 :question/id #uuid "033e459e-5148-5e78-ab5c-7e455b06cd64" :question/math-academy-id "e-3695" :question/problem "If $f(x,y,z) = xz\\ln{y}$ and $\\mathbf r (t) =  t^2 \\, \\mathbf i + t  \\, \\mathbf j +t^3  \\, \\mathbf k,$ compute $\\dfrac {\\textrm d}{\\textrm d t} [f(\\mathbf r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\dfrac {\\textrm d}{\\textrm d t} [f(\\mathbf r (t))] = \\nabla f(\\mathbf r(t)) \\cdot \\mathbf r'(t).\n$$\n\nFirst, we need to compute $\\nabla f(x,y,z){:}$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(xz\\operatorname{ln}⁡y)\\,i+\\frac{∂}{∂y}(xz\\operatorname{ln}⁡y)\\,j+\\frac{∂}{∂z}(xz\\operatorname{ln}⁡y)\\,k \\\\  & =z\\operatorname{ln}⁡y\\,i+\\frac{xz}{y}\\,j+x\\operatorname{ln}⁡y\\,k\\end{aligned}\n$$\n\nNext, we substitute $x= t^2,$ $y = t$ and $z= t^3$ into the above to find $\\nabla f(\\mathbf{r}(t)){:}$\n\n$$\n\\begin{aligned}∇f(r(t)) & ={t}^{3}\\operatorname{ln}⁡t\\,i+{t}^{4}\\,j+{t}^{2}\\operatorname{ln}⁡t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $\\mathbf{r}(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,k \\\\  & =2t\\,i+\\,j+3{t}^{2}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =({t}^{3}\\operatorname{ln}⁡t\\,i+{t}^{4}\\,j+{t}^{2}\\operatorname{ln}⁡t\\,k)\\cdot (2t\\,i+\\,j+3{t}^{2}\\,k) \\\\  & =({t}^{3}\\operatorname{ln}⁡t)\\cdot 2t+({t}^{4})\\cdot 1+({t}^{2}\\operatorname{ln}⁡t)\\cdot 3{t}^{2} \\\\  & =2{t}^{4}\\operatorname{ln}⁡t+{t}^{4}+3{t}^{4}\\operatorname{ln}⁡t \\\\  & ={t}^{4}(5\\operatorname{ln}⁡t+1).\\end{aligned}\n$$"} :knowledge-point/id #uuid "112e3378-bde8-5896-822e-e815bde51501" :knowledge-point/question-generator {:db/id #edb/ref 17592186556007 :question-generator/id #uuid "10ad4d6c-c271-5873-87a1-cccc6bed0a8f" :question-generator/script "generate/scratch/17592186124470.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186124959 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6b5248-8092-5223-a861-76c990d98151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t+1}+(1+2t){e}^{t}+e" :db/id #edb/ref 17592186445647} {:answer/id #uuid "3f8c2a6a-498f-5431-bf0a-f09364aeca5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}+2e+t" :db/id #edb/ref 17592186445649} {:answer/id #uuid "55795f5b-54c2-5a78-8f3f-d7bc330a0c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t+1}+(t+1){e}^{t}+2" :db/id #edb/ref 17592186445653} {:answer/id #uuid "88d607c8-fe3c-5a8f-95e2-26b4560aaab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t+1}+(1+t){e}^{t}+e" :db/id #edb/ref 17592186445659} {:answer/id #uuid "9a2dcd24-b4f5-5abd-afe6-bb8c91b06230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t+1}+t{e}^{t}+e" :db/id #edb/ref 17592186445663}] :answer-field/correct {:answer/id #uuid "88d607c8-fe3c-5a8f-95e2-26b4560aaab5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{t+1}+(1+t){e}^{t}+e" :db/id #edb/ref 17592186445659} :answer-field/id #uuid "00f9b55f-9f7a-5171-8a0f-7462d539b472" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122354}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f10e177e-2926-5cde-8e9a-4b0a99b2ff4c" :question/math-academy-id "q-36238" :question/problem "If $f(x,y,z)=xy+yz+xz$ and $r(t)=t\\,i+{e}^{t}\\,j+e\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(xy+yz+xz)\\,i+\\frac{∂}{∂y}(xy+yz+xz)\\,j+\\frac{∂}{∂z}(xy+yz+xz)\\,k \\\\  & =(y+z)\\,i+(x+z)\\,j+(y+x)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y={e}^{t},$ and $z=e$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =({e}^{t}+e)\\,i+(t+e)\\,j+({e}^{t}+t)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(e)\\,k \\\\  & =i+{e}^{t}\\,j+(0)\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(({e}^{t}+e)\\,i+(t+e)\\,j+({e}^{t}+t)\\,k)\\cdot (i+{e}^{t}\\,j+(0)\\,k) \\\\  & =({e}^{t}+e)\\cdot 1+(t+e)\\cdot {e}^{t}+({e}^{t}+t)\\cdot 0 \\\\  & ={e}^{t}+e+t{e}^{t}+{e}^{t+1} \\\\  & ={e}^{t+1}+(1+t){e}^{t}+e.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186125250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f80eba8-e277-54b6-a822-397fce4bd264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186124103} {:answer/id #uuid "8ab97f80-a525-5bbe-a6b4-4f61835de51f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}+\\operatorname{sin}⁡t+\\operatorname{cos}⁡t" :db/id #edb/ref 17592186479565} {:answer/id #uuid "ae4d169e-765b-5d10-9ef3-ea60b0437938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)" :db/id #edb/ref 17592186479620} {:answer/id #uuid "e711ca65-092d-53a1-9492-fad3c11a523c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}\\operatorname{sin}⁡t" :db/id #edb/ref 17592186479701} {:answer/id #uuid "eef6c2ca-b384-52f9-bf10-2db701968ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}\\operatorname{cos}⁡t" :db/id #edb/ref 17592186479712}] :answer-field/correct {:answer/id #uuid "eef6c2ca-b384-52f9-bf10-2db701968ad9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t}\\operatorname{cos}⁡t" :db/id #edb/ref 17592186479712} :answer-field/id #uuid "f6d53ae6-99b0-5b9a-984f-d8cbdd57249f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186124100}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9127ceaf-3e13-50a4-b08a-89114324036d" :question/math-academy-id "q-95075" :question/problem "If $f(x,y,z)=z(x+y)$ and $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(z(x+y))\\,i+\\frac{∂}{∂y}(z(x+y))\\,j+\\frac{∂}{∂z}(z(x+y))\\,k \\\\  & =z\\,i+z\\,j+(x+y)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,$ $y=\\operatorname{cos}⁡t$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & ={e}^{t}\\,i+{e}^{t}\\,j+(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =({e}^{t}\\,i+{e}^{t}\\,j+(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\,k)\\cdot (\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+{e}^{t}\\,k) \\\\  & ={e}^{t}\\cdot \\operatorname{cos}⁡t+{e}^{t}\\cdot (-\\operatorname{sin}⁡t)+(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)\\cdot {e}^{t} \\\\  & ={e}^{t}\\operatorname{cos}⁡t-{e}^{t}\\operatorname{sin}⁡t+{e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\  & =2{e}^{t}\\operatorname{cos}⁡t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186284584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1346c66e-add9-58bb-914d-bde230ffb97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{t}^{2}+3t" :db/id #edb/ref 17592186281874} {:answer/id #uuid "5cbc6691-be3c-5174-bc33-891dad11a619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+2t" :db/id #edb/ref 17592186282476} {:answer/id #uuid "7ca6cbe6-66c9-5cdf-85f9-16bcc6c8db5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{t}^{2}" :db/id #edb/ref 17592186282765} {:answer/id #uuid "c8135d32-63d4-5f0e-ba7b-566e64774dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{t}^{2}" :db/id #edb/ref 17592186283438} {:answer/id #uuid "d748975e-258c-5fd7-a8c3-a751942b65a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{3}+3{t}^{2}" :db/id #edb/ref 17592186283565}] :answer-field/correct {:answer/id #uuid "7ca6cbe6-66c9-5cdf-85f9-16bcc6c8db5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{t}^{2}" :db/id #edb/ref 17592186282765} :answer-field/id #uuid "771db56a-a84d-5c67-ab37-e76a138f7e66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284138}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78b6efe3-1fb5-5655-97e2-03def53db36e" :question/math-academy-id "q-167453" :question/problem "If $f(x,y,z)=x{y}^{2}+y{z}^{3}$ and $r(t)={t}^{3}\\,i+\\,j+t\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x{y}^{2}+y{z}^{3})\\,i+\\frac{∂}{∂y}(x{y}^{2}+y{z}^{3})\\,j+\\frac{∂}{∂z}(x{y}^{2}+y{z}^{3})\\,k \\\\  & ={y}^{2}\\,i+(2xy+{z}^{3})\\,j+3y{z}^{2}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{3},y=1,$ and $z=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\,i+3{t}^{3}\\,j+3{t}^{2}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,i+\\frac{\\text{d}}{\\text{d}t}(1)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =3{t}^{2}i+(0)\\,j+\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\,i+3{t}^{3}\\,j+3{t}^{2}\\,k)\\cdot (3{t}^{2}i+(0)\\,j+\\,k) \\\\  & =1\\cdot 3{t}^{2}+3{t}^{3}\\cdot 0+3{t}^{2}\\cdot 1 \\\\  & =3{t}^{2}+3{t}^{2} \\\\  & =6{t}^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043ac664-b524-524e-aa72-bf1d30123527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186357793} {:answer/id #uuid "af3ddaa4-8953-5d46-9032-e2f95ff616b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡2t{cos}^{3}⁡2t" :db/id #edb/ref 17592186359275} {:answer/id #uuid "c43dfc74-6743-5922-a14e-6c2caaeb73de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t{sin}^{3}⁡t" :db/id #edb/ref 17592186359473} {:answer/id #uuid "cc97c0a8-0127-5bdc-a492-17ba4f68be95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359546} {:answer/id #uuid "da9c33c8-b2a5-5f98-b17d-5810e16dbeda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡t" :db/id #edb/ref 17592186359665}] :answer-field/correct {:answer/id #uuid "043ac664-b524-524e-aa72-bf1d30123527" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186357793} :answer-field/id #uuid "f9feea77-0770-57d9-9bdc-bf443c95c674" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360439}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a60dcabe-5a9f-584e-9268-2f3213ceda5a" :question/math-academy-id "q-95070" :question/problem "If $f(x,y,z)={x}^{4}-{y}^{4}-\\operatorname{cos}⁡z$ and $r(t)=\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j+2t\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}({x}^{4}-{y}^{4}-\\operatorname{cos}⁡z)\\,i+\\frac{∂}{∂y}({x}^{4}-{y}^{4}-\\operatorname{cos}⁡z)\\,j+\\frac{∂}{∂z}({x}^{4}-{y}^{4}-\\operatorname{cos}⁡z)\\,k \\\\  & =4{x}^{3}\\,i-4{y}^{3}\\,j+\\operatorname{sin}⁡z\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,$ $y=\\operatorname{cos}⁡t$ and $z=2t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =4{sin}^{3}⁡t\\,i-4{cos}^{3}⁡t\\,j+\\operatorname{sin}⁡2t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(2t)\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(4{sin}^{3}⁡t\\,i-4{cos}^{3}⁡t\\,j+\\operatorname{sin}⁡2t\\,k)\\cdot (\\operatorname{cos}⁡t\\,i-\\operatorname{sin}⁡t\\,j+2\\,k) \\\\  & =4{sin}^{3}⁡t\\cdot \\operatorname{cos}⁡t-4{cos}^{3}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{sin}⁡2t\\cdot 2 \\\\  & =4{sin}^{3}⁡t\\operatorname{cos}⁡t+4{cos}^{3}⁡t\\operatorname{sin}⁡t+2\\operatorname{sin}⁡2t \\\\  & =4\\operatorname{sin}⁡t\\operatorname{cos}⁡t({sin}^{2}⁡t+{cos}^{2}⁡t)+2\\operatorname{sin}⁡2t \\\\  & =4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2\\operatorname{sin}⁡2t \\\\  & =2\\operatorname{sin}⁡2t+2\\operatorname{sin}⁡2t \\\\  & =4\\operatorname{sin}⁡2t.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1347f5a2-01c0-5c7b-b717-680930abc12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t{e}^{t}+1}{t}" :db/id #edb/ref 17592186357914} {:answer/id #uuid "4c03b829-963e-5a53-bccb-1865320c6ba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{t}+1}{t}" :db/id #edb/ref 17592186358409} {:answer/id #uuid "8e8b2be7-935d-58f9-a8d2-f58e5e602a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{t-1}(1-t)" :db/id #edb/ref 17592186358993} {:answer/id #uuid "a48fbdf1-c888-5cc7-ad1f-26a035cc7e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t+1}{t}" :db/id #edb/ref 17592186359180} {:answer/id #uuid "aa082587-0924-59bd-be2d-48ce5c0b988c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186359215}] :answer-field/correct {:answer/id #uuid "a48fbdf1-c888-5cc7-ad1f-26a035cc7e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2t+1}{t}" :db/id #edb/ref 17592186359180} :answer-field/id #uuid "9c6ee750-c6b9-5399-bdf4-e7500571e2b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360267}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "75389de5-3518-524a-bf8a-ad60601e753c" :question/math-academy-id "q-95072" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(xyz)$ and $r(t)=t\\,i+{e}^{t-1}\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xyz))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xyz))\\,j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(xyz))\\,k \\\\  & =\\frac{yz}{xyz}\\,i+\\frac{xz}{xyz}\\,j+\\frac{xy}{xyz}\\,k \\\\  & =\\frac{1}{x}\\,i+\\frac{1}{y}\\,j+\\frac{1}{z}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y={e}^{t-1},$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{1}{t}\\,i+\\frac{1}{{e}^{t-1}}\\,j+\\frac{1}{{e}^{t}}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t-1})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =i+{e}^{t-1}\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{1}{t}\\,i+\\frac{1}{{e}^{t-1}}\\,j+\\frac{1}{{e}^{t}}\\,k)\\cdot (i+{e}^{t-1}\\,j+{e}^{t}\\,k) \\\\  & =\\frac{1}{t}+\\frac{{e}^{t-1}}{{e}^{t-1}}+\\frac{{e}^{t}}{{e}^{t}} \\\\  & =\\frac{1}{t}+2 \\\\  & =\\frac{2t+1}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28d173fc-2ace-5c23-8e6c-2e1100a8bcd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t(t-\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186358124} {:answer/id #uuid "55409a0b-0c25-504a-bd65-c0781332f04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4+4t+{t}^{2}\\operatorname{ln}⁡t" :db/id #edb/ref 17592186358492} {:answer/id #uuid "ce0052e5-1ee4-5d5c-9667-77f78de9d0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(t-\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186359564} {:answer/id #uuid "ee064399-1401-555f-b6c0-3013abc3be94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t(t-1)" :db/id #edb/ref 17592186359872} {:answer/id #uuid "f41185b3-09b1-59b6-88eb-3c7555fb8f88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\operatorname{ln}⁡t+1)" :db/id #edb/ref 17592186359919}] :answer-field/correct {:answer/id #uuid "f41185b3-09b1-59b6-88eb-3c7555fb8f88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(\\operatorname{ln}⁡t+1)" :db/id #edb/ref 17592186359919} :answer-field/id #uuid "a6daa545-65f3-5e47-b745-8aab21ef0ff5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ce5cc103-892b-5471-8317-cbb325d2454d" :question/math-academy-id "q-95142" :question/problem "If $f(x,y,z)=x({y}^{2}-{z}^{2})$ and $r(t)=\\operatorname{ln}⁡t\\,i+(t+1)\\,j+(t-1)\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}[x({y}^{2}-{z}^{2})]\\,i+\\frac{∂}{∂y}[x({y}^{2}-{z}^{2})]\\,j+\\frac{∂}{∂z}[x({y}^{2}-{z}^{2})]\\,k \\\\  & =({y}^{2}-{z}^{2})\\,i+2xy\\,j-2xz\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{ln}⁡t,$ $y=t+1$ and $z=t-1$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =[(t+1)^{2}-(t-1)^{2}]i+2\\operatorname{ln}⁡t\\cdot (t+1)\\,j-2\\operatorname{ln}⁡t\\cdot (t-1)\\,k \\\\  & =4t\\,i+2(t+1)\\operatorname{ln}⁡t\\,j-2(t-1)\\operatorname{ln}⁡t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t+1)\\,j+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,k \\\\  & =\\frac{1}{t}\\,i+\\,j+\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(4t\\,i+2(t+1)\\operatorname{ln}⁡t\\,j-2(t-1)\\operatorname{ln}⁡t\\,k)\\cdot (\\frac{1}{t}\\,i+\\,j+\\,k) \\\\  & =4t\\cdot \\frac{1}{t}+2(t+1)\\operatorname{ln}⁡t\\cdot 1-2(t-1)\\operatorname{ln}⁡t\\cdot 1 \\\\  & =4+2(t+1)\\operatorname{ln}⁡t-2(t-1)\\operatorname{ln}⁡t \\\\  & =4+4\\operatorname{ln}⁡t \\\\  & =4(\\operatorname{ln}⁡t+1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67fb2e01-985f-513d-813b-cfde3f1b377e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2t}\\operatorname{cos}⁡t" :db/id #edb/ref 17592186358661} {:answer/id #uuid "788c776c-5597-51d2-9394-be9dfb7f75ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2t}" :db/id #edb/ref 17592186358792} {:answer/id #uuid "901c96ff-6cee-55e9-8211-cd0101addfb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2t}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)" :db/id #edb/ref 17592186359007} {:answer/id #uuid "a22be918-009f-5e59-9d70-9b6808c8792a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2t}(2\\operatorname{cos}⁡{t}^{2}-\\operatorname{sin}⁡{t}^{2})" :db/id #edb/ref 17592186359167} {:answer/id #uuid "cbc10872-0c59-572a-92f2-5c00d7f80870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2t}(\\operatorname{cos}⁡{t}^{2}-t\\operatorname{sin}⁡{t}^{2})" :db/id #edb/ref 17592186359542}] :answer-field/correct {:answer/id #uuid "cbc10872-0c59-572a-92f2-5c00d7f80870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{2t}(\\operatorname{cos}⁡{t}^{2}-t\\operatorname{sin}⁡{t}^{2})" :db/id #edb/ref 17592186359542} :answer-field/id #uuid "fef695bf-af69-5590-8e72-7ce89ea59101" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360451}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee940918-1cef-5c23-a56c-5afe1494fd57" :question/math-academy-id "q-95146" :question/problem "If $f(x,y,z)=yz\\operatorname{cos}⁡x$ and $r(t)={t}^{2}\\,i+{e}^{t}\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(yz\\operatorname{cos}⁡x)\\,i+\\frac{∂}{∂y}(yz\\operatorname{cos}⁡x)\\,j+\\frac{∂}{∂z}(yz\\operatorname{cos}⁡x)\\,k \\\\  & =-yz\\operatorname{sin}⁡x\\,i+z\\operatorname{cos}⁡x\\,j+y\\operatorname{cos}⁡x\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={t}^{2},y={e}^{t},$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =-{e}^{2t}\\operatorname{sin}⁡{t}^{2}\\,i+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,j+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =2t\\,i+{e}^{t}\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(-{e}^{2t}\\operatorname{sin}⁡{t}^{2}\\,i+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,j+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\,k)\\cdot (2t\\,i+{e}^{t}\\,j+{e}^{t}\\,k) \\\\  & =-2t{e}^{2t}\\operatorname{sin}⁡{t}^{2}+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\cdot {e}^{t}+{e}^{t}\\operatorname{cos}⁡{t}^{2}\\cdot {e}^{t} \\\\  & =-2t{e}^{2t}\\operatorname{sin}⁡{t}^{2}+2{e}^{2t}\\operatorname{cos}⁡{t}^{2} \\\\  & =2{e}^{2t}(\\operatorname{cos}⁡{t}^{2}-t\\operatorname{sin}⁡{t}^{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186360579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5305687e-83d8-5c87-af7d-a5b0a362d788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡t+{e}^{{t}^{2}}+t" :db/id #edb/ref 17592186358466} {:answer/id #uuid "631de459-4352-5ad1-949e-8ac23d4b20f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡t+2t{e}^{{t}^{2}}" :db/id #edb/ref 17592186358613} {:answer/id #uuid "b15809fa-40bc-5563-9a51-d40e84efc938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}" :db/id #edb/ref 17592186359292} {:answer/id #uuid "c66b80bb-3662-52ab-bf2e-dab3fb4673d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t+{e}^{{t}^{2}}-1" :db/id #edb/ref 17592186359496} {:answer/id #uuid "e0073e63-c4b1-5f0a-b806-ed90e183c49f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡t+\\frac{{e}^{{t}^{2}}}{{t}^{2}}" :db/id #edb/ref 17592186359718}] :answer-field/correct {:answer/id #uuid "b15809fa-40bc-5563-9a51-d40e84efc938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}" :db/id #edb/ref 17592186359292} :answer-field/id #uuid "d86a4006-7e81-5ee9-a91c-4ead86d71714" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360371}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "312e3468-92a5-5996-9fc8-ac654be83975" :question/math-academy-id "q-95149" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(xz)+{e}^{y}$ and $r(t)=\\operatorname{sin}⁡t\\,i+{t}^{2}\\,j+\\frac{1}{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,j+\\frac{∂}{∂z}(\\operatorname{ln}⁡(xz)+{e}^{y})\\,k \\\\  & =\\frac{1}{x}\\,i+{e}^{y}\\,j+\\frac{1}{z}\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=\\operatorname{sin}⁡t,y={t}^{2},$ and $z=\\frac{1}{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\frac{1}{\\operatorname{sin}⁡t}\\,i+{e}^{{t}^{2}}\\,j+t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)k \\\\  & =\\operatorname{cos}⁡t\\,i+2t\\,j-\\frac{1}{{t}^{2}}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\frac{1}{\\operatorname{sin}⁡t}\\,i+{e}^{{t}^{2}}\\,j+t\\,k)\\cdot (\\operatorname{cos}⁡t\\,i+2t\\,j-\\frac{1}{{t}^{2}}\\,k) \\\\  & =\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+2t{e}^{{t}^{2}}-\\frac{t}{{t}^{2}} \\\\  & =\\operatorname{cot}⁡t+2t{e}^{{t}^{2}}-\\frac{1}{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186445679 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a36a033-d9b0-5aa7-a7f4-b5451390ac7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡(2t)" :db/id #edb/ref 17592186445648} {:answer/id #uuid "60dab585-b4f4-59ea-8d98-9a5182b158eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡(2t)-\\operatorname{cos}⁡t" :db/id #edb/ref 17592186445654} {:answer/id #uuid "8d6d49e7-278c-5501-995f-670dd3f19484" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2+2t)\\operatorname{cos}⁡(2t)" :db/id #edb/ref 17592186445660} {:answer/id #uuid "d82ae990-52e1-5862-b9ec-b3ce7c4bd555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(2t)" :db/id #edb/ref 17592186445667} {:answer/id #uuid "ff848b94-7fca-53f6-95e5-3ab48c4f01c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(2t)+\\frac{1}{t}" :db/id #edb/ref 17592186445672}] :answer-field/correct {:answer/id #uuid "d82ae990-52e1-5862-b9ec-b3ce7c4bd555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(2t)" :db/id #edb/ref 17592186445667} :answer-field/id #uuid "88e49b12-6312-563d-bb5a-a9112af44abf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186445674}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "430b6986-f30c-500a-b5e9-219dd0f3ace5" :question/math-academy-id "q-167463" :question/problem "If $f(x,y,z)=\\operatorname{sin}⁡(xyz)$ and $r(t)=t\\,i+2t\\,j+\\frac{1}{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xyz))\\,i+\\frac{∂}{∂y}(\\operatorname{sin}⁡(xyz))\\,j+\\frac{∂}{∂z}(\\operatorname{sin}⁡(xyz))\\,k \\\\  & =yz\\operatorname{cos}⁡(xyz)\\,i+xz\\operatorname{cos}⁡(xyz)\\,j+xy\\operatorname{cos}⁡(xyz)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,$ $y=2t$ and $z=\\frac{1}{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =2\\operatorname{cos}⁡(2t)\\,i+\\operatorname{cos}⁡(2t)\\,j+2{t}^{2}\\operatorname{cos}⁡(2t)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{1}{t}\\right)\\,k \\\\  & =\\,i+2\\,j-\\frac{1}{{t}^{2}}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2\\operatorname{cos}⁡(2t)\\,i+\\operatorname{cos}⁡(2t)\\,j+2{t}^{2}\\operatorname{cos}⁡(2t)\\,k)\\cdot (\\,i+2\\,j-\\frac{1}{{t}^{2}}\\,k) \\\\  & =2\\operatorname{cos}⁡(2t)\\cdot 1+\\operatorname{cos}⁡(2t)\\cdot 2+2{t}^{2}\\operatorname{cos}⁡(2t)\\cdot \\left(-\\frac{1}{{t}^{2}}\\right) \\\\  & =2\\operatorname{cos}⁡(2t)+2\\operatorname{cos}⁡(2t)-2\\operatorname{cos}⁡(2t) \\\\  & =2\\operatorname{cos}⁡(2t).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49a16002-fb70-57d8-b56c-e846ae55b5f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡2t" :db/id #edb/ref 17592186479469} {:answer/id #uuid "800531bb-e5bf-57d0-94df-bfb46de70ee9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(2{t}^{2}-\\operatorname{sin}⁡t)" :db/id #edb/ref 17592186479550} {:answer/id #uuid "87ac30df-06f9-515c-b483-8fa371168b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({t}^{2}-1)+\\operatorname{cos}⁡t" :db/id #edb/ref 17592186479560} {:answer/id #uuid "c3353af3-19ba-5e14-a733-a22abed74ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t)" :db/id #edb/ref 17592186479654} {:answer/id #uuid "eaa24879-c05e-53a3-b066-9afb3802f261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t(1+\\operatorname{sin}⁡t\\operatorname{cos}⁡t)" :db/id #edb/ref 17592186479704}] :answer-field/correct {:answer/id #uuid "c3353af3-19ba-5e14-a733-a22abed74ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4(t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t)" :db/id #edb/ref 17592186479654} :answer-field/id #uuid "65e8ce36-6bdd-5ffc-86d9-2cca52842880" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479779}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23fc0071-5d5d-57b9-949a-5e0f696a08ef" :question/math-academy-id "q-95074" :question/problem "If $f(x,y,z)={x}^{2}+{y}^{2}+2{z}^{2}$ and $r(t)=(t+1)\\,i+(t-1)\\,j+\\operatorname{sin}⁡t\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2}+2{z}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2}+2{z}^{2})\\,j+\\frac{∂}{∂z}({x}^{2}+{y}^{2}+2{z}^{2})\\,k \\\\  & =2x\\,i+2y\\,j+4z\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t+1,$ $y=t-1$ and $z=\\operatorname{sin}⁡t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =2(t+1)\\,i+2(t-1)\\,j+4\\operatorname{sin}⁡t\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =i+j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(2(t+1)\\,i+2(t-1)\\,j+4\\operatorname{sin}⁡t\\,k)\\cdot (i+j+\\operatorname{cos}⁡t\\,k) \\\\  & =2(t+1)\\cdot 1+2(t-1)\\cdot 1+4\\operatorname{sin}⁡t\\cdot \\operatorname{cos}⁡t \\\\  & =2t+2+2t-2+4\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =4(t+\\operatorname{sin}⁡t\\operatorname{cos}⁡t).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186479899 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a625792-3ebb-5931-8a2d-6a88c5f87ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡{e}^{t}-2\\operatorname{tan}⁡{t}^{2}" :db/id #edb/ref 17592186479401} {:answer/id #uuid "2f3fec76-0a6e-5e27-983b-461d88932bfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\operatorname{cot}⁡t+{t}^{2}\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{tan}⁡{e}^{t}" :db/id #edb/ref 17592186479430} {:answer/id #uuid "a28056a9-f916-52a5-9c57-bf67a29a290d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t-\\operatorname{tan}⁡{t}^{2}+\\operatorname{cot}⁡{e}^{t}" :db/id #edb/ref 17592186479603} {:answer/id #uuid "b34fbe3e-3237-5a50-aaa6-a8cad66ce7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cot}⁡t-\\operatorname{tan}⁡{t}^{2}" :db/id #edb/ref 17592186479626} {:answer/id #uuid "bce18e25-d9a2-5b97-b848-b56b779ae552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t-2t\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{cot}⁡{e}^{t}" :db/id #edb/ref 17592186479644}] :answer-field/correct {:answer/id #uuid "bce18e25-d9a2-5b97-b848-b56b779ae552" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡t-2t\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{cot}⁡{e}^{t}" :db/id #edb/ref 17592186479644} :answer-field/id #uuid "73405ecf-58c2-52c0-a13d-a399aaa1b75c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186479781}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f5e2cc69-b41b-55a6-ba1d-f0aa44f4db50" :question/math-academy-id "q-95143" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)$ and $r(t)=t\\,i+{t}^{2}\\,j+{e}^{t}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)\\,i+\\frac{∂}{∂y}\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)\\,j+\\frac{∂}{∂z}\\operatorname{ln}⁡(\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z)\\,k \\\\  & =\\frac{\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}\\,i-\\frac{\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\operatorname{sin}⁡z}{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}\\,j+\\frac{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{cos}⁡z}{\\operatorname{sin}⁡x\\operatorname{cos}⁡y\\operatorname{sin}⁡z}\\,k \\\\  & =\\operatorname{cot}⁡x\\,i-\\operatorname{tan}⁡y\\,j+\\operatorname{cot}⁡z\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,$ $y={t}^{2}$ and $z={e}^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\operatorname{cot}⁡t\\,i-\\operatorname{tan}⁡{t}^{2}\\,j+\\operatorname{cot}⁡{e}^{t}\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =i+2t\\,j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\operatorname{cot}⁡t\\,i-\\operatorname{tan}⁡{t}^{2}\\,j+\\operatorname{cot}⁡{e}^{t}\\,k)\\cdot (i+2t\\,j+{e}^{t}\\,k) \\\\  & =\\operatorname{cot}⁡t-2t\\operatorname{tan}⁡{t}^{2}+{e}^{t}\\operatorname{cot}⁡{e}^{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186485588 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e1312-3232-541a-a772-9a4195876e08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(2t+{t}^{2})" :db/id #edb/ref 17592186484854} {:answer/id #uuid "1cf61e8f-1cbe-5cf7-b7de-cb285c2945df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(t+1)\\operatorname{sin}⁡(2t+{t}^{2})" :db/id #edb/ref 17592186484868} {:answer/id #uuid "54a8785f-b684-5fbf-ab5e-7a2651308e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)^{2}\\operatorname{cos}⁡(2t+{t}^{2})" :db/id #edb/ref 17592186485006} {:answer/id #uuid "7b1155ed-ffcf-5482-9835-4e132b93d976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+2{t}^{2}\\operatorname{cos}⁡(2t+{t}^{2})" :db/id #edb/ref 17592186485086} {:answer/id #uuid "7d4e5d76-01d4-5027-9d0b-5f4455a3c94c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+\\operatorname{cos}⁡(2t+{t}^{2})" :db/id #edb/ref 17592186485089}] :answer-field/correct {:answer/id #uuid "54a8785f-b684-5fbf-ab5e-7a2651308e2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)^{2}\\operatorname{cos}⁡(2t+{t}^{2})" :db/id #edb/ref 17592186485006} :answer-field/id #uuid "26f9db34-f1fa-54a6-9839-7f297b6a756c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186485384}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eabe5e6a-dc85-5118-84d2-9aa9f31a6a23" :question/math-academy-id "q-95086" :question/problem "If $f(x,y,z)=x\\operatorname{sin}⁡(y+z)$ and $r(t)=(t+1)\\,i+2t\\,j+{t}^{2}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(y+z))\\,i+\\frac{∂}{∂y}(x\\operatorname{sin}⁡(y+z))\\,j+\\frac{∂}{∂z}(x\\operatorname{sin}⁡(y+z))\\,k \\\\  & =\\operatorname{sin}⁡(y+z)\\,i+x\\operatorname{cos}⁡(y+z)\\,j+x\\operatorname{cos}⁡(y+z)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t+1,$ $y=2t$ and $z={t}^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =\\operatorname{sin}⁡(2t+{t}^{2})\\,i+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,j+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =\\,i+2\\,j+2t\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =(\\operatorname{sin}⁡(2t+{t}^{2})\\,i+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,j+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\,k)\\cdot (\\,i+2\\,j+2t\\,k) \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})\\cdot 1+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\cdot 2+(t+1)\\operatorname{cos}⁡(2t+{t}^{2})\\cdot 2t \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)\\operatorname{cos}⁡(2t+{t}^{2})+2t(t+1)\\operatorname{cos}⁡(2t+{t}^{2}) \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)(1+t)\\operatorname{cos}⁡(2t+{t}^{2}) \\\\  & =\\operatorname{sin}⁡(2t+{t}^{2})+2(t+1)^{2}\\operatorname{cos}⁡(2t+{t}^{2}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326ed290-c2d9-50d2-88c8-74db06917de4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- t \\left(t + 1\\right)" :db/id #edb/ref 17592186555967} {:answer/id #uuid "336c3865-f674-544a-82cb-712e32c64648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (6 t + 1)" :db/id #edb/ref 17592186555969} {:answer/id #uuid "4db710c0-beac-5a6e-854d-7b7866f60c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (2 t + 1)" :db/id #edb/ref 17592186555973} {:answer/id #uuid "56a00959-2111-50b5-b5fe-ba2f85d7c3bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 t - 1" :db/id #edb/ref 17592186555977} {:answer/id #uuid "a9e4f8f2-4f25-544c-a9ba-33e2472e1343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 t" :db/id #edb/ref 17592186555996}] :answer-field/correct {:answer/id #uuid "4db710c0-beac-5a6e-854d-7b7866f60c72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (2 t + 1)" :db/id #edb/ref 17592186555973} :answer-field/id #uuid "32e468ca-2d16-55b6-a084-1a0ff8b6f7f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555968}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11cc55a9-a3be-504c-b916-0f019947db61" :question/problem "If $f(x,y,z)=- x - 3 y + 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t^{2})\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(- x - 3 y + 2 z)\\,i+\\frac{∂}{∂y}(- x - 3 y + 2 z)\\,j+\\frac{∂}{∂z}(- x - 3 y + 2 z)\\,k \\\\  & =(-1)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(-1)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((-1)\\,i+(-3)\\,j+(2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(-1)\\cdot (1)+(-3)\\cdot (2 t)+(2)\\cdot (2 t) \\\\  & =(-1)+(- 6 t)+(4 t) \\\\  & =- (2 t + 1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f8edcc7-83f3-51eb-a02a-f98f35085a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 10 t" :db/id #edb/ref 17592186555966} {:answer/id #uuid "69f314a2-61a8-53f2-b0ac-eb90c1a11c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (10 t + 3)" :db/id #edb/ref 17592186555981} {:answer/id #uuid "7a0b14be-60a6-545a-ac09-803a1de56af5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 \\left(2 t + 1\\right)" :db/id #edb/ref 17592186555986} {:answer/id #uuid "7ad1d7fe-61c1-5328-9f74-34705da6c672" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (4 t + 3)" :db/id #edb/ref 17592186555987} {:answer/id #uuid "99bcbeaa-ab4e-516c-bbf9-8ff846ba257b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- t \\left(5 t + 3\\right)" :db/id #edb/ref 17592186555993}] :answer-field/correct {:answer/id #uuid "69f314a2-61a8-53f2-b0ac-eb90c1a11c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (10 t + 3)" :db/id #edb/ref 17592186555981} :answer-field/id #uuid "5c278396-ed1e-50e5-a1d5-838e5e5875f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555978}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "216d3edd-79b6-5b78-9d7a-c69bb1f635e7" :question/problem "If $f(x,y,z)=- 3 x - 2 y - 3 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t^{2})\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(- 3 x - 2 y - 3 z)\\,i+\\frac{∂}{∂y}(- 3 x - 2 y - 3 z)\\,j+\\frac{∂}{∂z}(- 3 x - 2 y - 3 z)\\,k \\\\  & =(-3)\\,i+(-2)\\,j+(-3)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(-3)\\,i+(-2)\\,j+(-3)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((-3)\\,i+(-2)\\,j+(-3)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(-3)\\cdot (1)+(-2)\\cdot (2 t)+(-3)\\cdot (2 t) \\\\  & =(-3)+(- 4 t)+(- 6 t) \\\\  & =- (10 t + 3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a17b40b-479d-5751-b0e3-83bf67df5a76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- t \\left(3 t + 1\\right)" :db/id #edb/ref 17592186555972} {:answer/id #uuid "6377a370-44ec-5cec-9bc0-51c381fef7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186555980} {:answer/id #uuid "72871cc2-889b-515a-9b90-c36e695dffa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 \\left(3 t + 1\\right)" :db/id #edb/ref 17592186555984} {:answer/id #uuid "7f26a776-36f8-56ac-8203-f0bde320ccfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (6 t + 1)" :db/id #edb/ref 17592186555988} {:answer/id #uuid "e493d7f7-de85-5a7d-9fa4-d1fef1c84e4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1 - 6 t" :db/id #edb/ref 17592186556004}] :answer-field/correct {:answer/id #uuid "7f26a776-36f8-56ac-8203-f0bde320ccfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- (6 t + 1)" :db/id #edb/ref 17592186555988} :answer-field/id #uuid "083c6ee8-7fc2-50bc-af5d-3d6b19fae25c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ed8bb8a-ea3c-5edb-81c1-5b691ab3509b" :question/problem "If $f(x,y,z)=x - 3 y - 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t)\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x - 3 y - 2 z)\\,i+\\frac{∂}{∂y}(x - 3 y - 2 z)\\,j+\\frac{∂}{∂z}(x - 3 y - 2 z)\\,k \\\\  & =(1)\\,i+(-3)\\,j+(-2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(1)\\,i+(-3)\\,j+(-2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(1)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((1)\\,i+(-3)\\,j+(-2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(1)\\,k) \\\\  & =(1)\\cdot (1)+(-3)\\cdot (2 t)+(-2)\\cdot (1) \\\\  & =(1)+(- 6 t)+(-2) \\\\  & =- (6 t + 1).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce4be0f-5d33-51bc-9050-760037179d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 \\left(t + 1\\right) e^{2} e^{2 t} \\sin{\\left(t^{2} + 2 t + 1 \\right)}" :db/id #edb/ref 17592186555963} {:answer/id #uuid "357d82b0-b468-5bc5-b46c-2ef6c8defaa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\left(- t \\sin{\\left(t^{2} + 2 t + 1 \\right)} - \\sin{\\left(t^{2} + 2 t + 1 \\right)} + \\cos{\\left(t^{2} + 2 t + 1 \\right)}\\right) e^{2} e^{2 t}" :db/id #edb/ref 17592186555970} {:answer/id #uuid "55240750-0f78-5bc6-92b3-9cedb81aed12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 \\left(- \\sin{\\left(t^{2} + 2 t + 1 \\right)} + 2 \\cos{\\left(t^{2} + 2 t + 1 \\right)}\\right) e^{2} e^{2 t}" :db/id #edb/ref 17592186555976} {:answer/id #uuid "5d4a2f77-851b-5117-b328-24f12ba3ba72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 e^{2} e^{2 t} \\cos{\\left(t^{2} + 2 t + 1 \\right)}" :db/id #edb/ref 17592186555979} {:answer/id #uuid "97ca2dc3-593b-53d0-842f-e141944c8015" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4 e \\left(- e e^{t} \\sin{\\left(t^{2} + 2 t + 1 \\right)} + 2 \\cos{\\left(t^{2} + 2 t + 1 \\right)}\\right) e^{t}" :db/id #edb/ref 17592186555992}] :answer-field/correct {:answer/id #uuid "357d82b0-b468-5bc5-b46c-2ef6c8defaa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 \\left(- t \\sin{\\left(t^{2} + 2 t + 1 \\right)} - \\sin{\\left(t^{2} + 2 t + 1 \\right)} + \\cos{\\left(t^{2} + 2 t + 1 \\right)}\\right) e^{2} e^{2 t}" :db/id #edb/ref 17592186555970} :answer-field/id #uuid "7227fc03-6c4a-59f2-afbf-1702442c4391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555983}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8f25a065-b9d2-5631-91bf-0e1b3f75fc51" :question/problem "If $f(x,y,z)=4\\left(yz\\operatorname{cos}⁡x\\right)$ and $r(t)={(t + 1)}^{2}\\,i+{e}^{(t + 1)}\\,j+{e}^{(t + 1)}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(4\\left(yz\\operatorname{cos}⁡x\\right))\\,i+\\frac{∂}{∂y}(4\\left(yz\\operatorname{cos}⁡x\\right))\\,j+\\frac{∂}{∂z}(4\\left(yz\\operatorname{cos}⁡x\\right))\\,k \\\\  & =(4\\left(-yz\\operatorname{sin}⁡x\\right))\\,i+(4\\left(+z\\operatorname{cos}⁡x\\right))\\,j+(4\\left(+y\\operatorname{cos}⁡x\\right))\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={(t + 1)}^{2},y={e}^{(t + 1)},$ and $z={e}^{(t + 1)}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(4\\left(-{e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})\\right))\\,i+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,j+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({(t + 1)}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{(t + 1)})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{(t + 1)})\\,k \\\\  & =(2(t + 1))\\,i+(+{e}^{(t + 1)})\\,j+(+{e}^{(t + 1)})\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((4\\left(-{e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})\\right))\\,i+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,j+(4\\left(+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right))\\,k)\\cdot ((2(t + 1))\\,i+(+{e}^{(t + 1)})\\,j+(+{e}^{(t + 1)})\\,k) \\\\  & =4\\left(-2(t + 1){e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\cdot {e}^{(t + 1)}+{e}^{(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\cdot {e}^{(t + 1)}\\right) \\\\  & =4\\left(-2(t + 1){e}^{2(t + 1)}\\operatorname{sin}⁡({(t + 1)}^{2})+2{e}^{2(t + 1)}\\operatorname{cos}⁡({(t + 1)}^{2})\\right) \\\\  & =4\\left(2{e}^{2(t + 1)}(\\operatorname{cos}⁡({(t + 1)}^{2})-(t + 1)\\operatorname{sin}⁡({(t + 1)}^{2}))\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06d1d6bd-d89b-5bad-bd17-b50341f803cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(2 - t\\right) e^{2 t} \\sin{\\left(t^{2} - 4 t + 4 \\right)}}{e^{4}}" :db/id #edb/ref 17592186555960} {:answer/id #uuid "4664a78f-effb-5ddf-988f-356dddd95a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 e^{2 t} \\cos{\\left(t^{2} - 4 t + 4 \\right)}}{e^{4}}" :db/id #edb/ref 17592186555971} {:answer/id #uuid "8f66985e-58fb-59d3-98c8-1287b1ccd811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(- t \\sin{\\left(t^{2} - 4 t + 4 \\right)} + 2 \\sin{\\left(t^{2} - 4 t + 4 \\right)} + \\cos{\\left(t^{2} - 4 t + 4 \\right)}\\right) e^{2 t}}{e^{4}}" :db/id #edb/ref 17592186555991} {:answer/id #uuid "b5f54656-e29a-5b5b-890b-fac4665b8674" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\left(- \\frac{e^{t} \\sin{\\left(t^{2} - 4 t + 4 \\right)}}{e^{2}} + 2 \\cos{\\left(t^{2} - 4 t + 4 \\right)}\\right) e^{t}}{e^{2}}" :db/id #edb/ref 17592186555997} {:answer/id #uuid "ee89e640-8825-5ae1-b367-7b5359189bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\left(- \\sin{\\left(t^{2} - 4 t + 4 \\right)} + 2 \\cos{\\left(t^{2} - 4 t + 4 \\right)}\\right) e^{2 t}}{e^{4}}" :db/id #edb/ref 17592186556005}] :answer-field/correct {:answer/id #uuid "8f66985e-58fb-59d3-98c8-1287b1ccd811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2 \\left(- t \\sin{\\left(t^{2} - 4 t + 4 \\right)} + 2 \\sin{\\left(t^{2} - 4 t + 4 \\right)} + \\cos{\\left(t^{2} - 4 t + 4 \\right)}\\right) e^{2 t}}{e^{4}}" :db/id #edb/ref 17592186555991} :answer-field/id #uuid "9f7f1241-2ff1-5381-8dd4-2f497ed46b35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555994}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b766d452-c3b3-5624-a6b9-7ef01ce70700" :question/problem "If $f(x,y,z)=yz\\operatorname{cos}⁡x$ and $r(t)={(t - 2)}^{2}\\,i+{e}^{(t - 2)}\\,j+{e}^{(t - 2)}\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(yz\\operatorname{cos}⁡x)\\,i+\\frac{∂}{∂y}(yz\\operatorname{cos}⁡x)\\,j+\\frac{∂}{∂z}(yz\\operatorname{cos}⁡x)\\,k \\\\  & =-yz\\operatorname{sin}⁡x\\,i+z\\operatorname{cos}⁡x\\,j+y\\operatorname{cos}⁡x\\,k\\end{aligned}\n$$\n\nNext, we substitute $x={(t - 2)}^{2},y={e}^{(t - 2)},$ and $z={e}^{(t - 2)}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(-{e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2}))\\,i+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,j+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({(t - 2)}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{(t - 2)})\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{(t - 2)})\\,k \\\\  & =(2(t - 2))\\,i+(+{e}^{(t - 2)})\\,j+(+{e}^{(t - 2)})\\,k.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((-{e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2}))\\,i+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,j+(+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}))\\,k)\\cdot ((2(t - 2))\\,i+(+{e}^{(t - 2)})\\,j+(+{e}^{(t - 2)})\\,k) \\\\  & =-2(t - 2){e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2})+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2})\\cdot {e}^{(t - 2)}+{e}^{(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2})\\cdot {e}^{(t - 2)} \\\\  & =-2(t - 2){e}^{2(t - 2)}\\operatorname{sin}⁡({(t - 2)}^{2})+2{e}^{2(t - 2)}\\operatorname{cos}⁡({(t - 2)}^{2}) \\\\  & =2{e}^{2(t - 2)}(\\operatorname{cos}⁡({(t - 2)}^{2})-(t - 2)\\operatorname{sin}⁡({(t - 2)}^{2})).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186555999 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c54f7b-0460-5650-8e11-7dbfff0c05e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(2 t + 1\\right)" :db/id #edb/ref 17592186555958} {:answer/id #uuid "6add913c-9635-5380-9dd3-082d19b4c8e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 - 3 t\\right)" :db/id #edb/ref 17592186555982} {:answer/id #uuid "a5a53ab2-3b2d-511f-8d27-0c2e3593b2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 t" :db/id #edb/ref 17592186555995} {:answer/id #uuid "ba0ce4fb-faf2-545c-813c-92335b2551d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t \\left(2 - t\\right)" :db/id #edb/ref 17592186556000} {:answer/id #uuid "cc2d2ded-87cd-520a-9927-cc57f85daf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 - t\\right)" :db/id #edb/ref 17592186556001}] :answer-field/correct {:answer/id #uuid "cc2d2ded-87cd-520a-9927-cc57f85daf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(1 - t\\right)" :db/id #edb/ref 17592186556001} :answer-field/id #uuid "4ea5389a-261a-518e-b827-bc0fb8107846" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b831457d-f088-5348-bc3d-27f5556d6376" :question/problem "If $f(x,y,z)=2 x - 3 y + 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t^{2})\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(2 x - 3 y + 2 z)\\,i+\\frac{∂}{∂y}(2 x - 3 y + 2 z)\\,j+\\frac{∂}{∂z}(2 x - 3 y + 2 z)\\,k \\\\  & =(2)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t^{2}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2)\\,i+(-3)\\,j+(2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(2 t)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((2)\\,i+(-3)\\,j+(2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(2 t)\\,k) \\\\  & =(2)\\cdot (1)+(-3)\\cdot (2 t)+(2)\\cdot (2 t) \\\\  & =(2)+(- 6 t)+(4 t) \\\\  & =2 \\left(1 - t\\right).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186556006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0508161d-0559-5c9c-94b0-dabbf30c8892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 t - 1" :db/id #edb/ref 17592186555959} {:answer/id #uuid "09f295d9-03a2-5561-bbef-04c9bb89034c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186555962} {:answer/id #uuid "78c86cc8-66c7-50dd-9fc4-ded5ae059599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 t + 1" :db/id #edb/ref 17592186555985} {:answer/id #uuid "d334b550-3042-553b-b847-e1e7fe52d626" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 \\left(t - 1\\right)" :db/id #edb/ref 17592186556002} {:answer/id #uuid "d9187c94-57be-571f-b824-8290c0c50c00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t \\left(t - 1\\right)" :db/id #edb/ref 17592186556003}] :answer-field/correct {:answer/id #uuid "0508161d-0559-5c9c-94b0-dabbf30c8892" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2 t - 1" :db/id #edb/ref 17592186555959} :answer-field/id #uuid "844dfb74-8a60-5fe0-bb44-50294978c57a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186555989}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbb4e13f-d8a8-5c5d-b9d1-448311f2dde4" :question/problem "If $f(x,y,z)=x + y - 2 z$ and $r(t)=(t)\\,i+(t^{2})\\,j+(t)\\,k,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y,z):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & =\\frac{∂}{∂x}(x + y - 2 z)\\,i+\\frac{∂}{∂y}(x + y - 2 z)\\,j+\\frac{∂}{∂z}(x + y - 2 z)\\,k \\\\  & =(1)\\,i+(1)\\,j+(-2)\\,k\\end{aligned}\n$$\n\nNext, we substitute $x=t,y=t^{2},$ and $z=t$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(1)\\,i+(1)\\,j+(-2)\\,k\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =(1)\\,i+(2 t)\\,j+(1)\\,k\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((1)\\,i+(1)\\,j+(-2)\\,k)\\cdot ((1)\\,i+(2 t)\\,j+(1)\\,k) \\\\  & =(1)\\cdot (1)+(1)\\cdot (2 t)+(-2)\\cdot (1) \\\\  & =(1)+(2 t)+(-2) \\\\  & =2 t - 1.\\end{aligned}\n$$"}] :knowledge-point/title "Applying the Vector Form of the Chain Rule to a Function of Three Variables"}] [{:db/id #edb/ref 17592186129268 :knowledge-point/canonical-example {:db/id #edb/ref 17592186128845 :question/id #uuid "043cc93d-1eae-5640-a109-9acbe7a34f92" :question/math-academy-id "e-11471" :question/problem "If the solid region $R$ is given by \n\n$$\nR = \\left\\{ (x,y,z) \\, : \\, (x-1)^2 + y^2 \\leq 1, \\: -2 \\leq z \\leq 4-y \\right\\},\n$$\n\nthen express the triple integral\n\n$$\n\\displaystyle \\iiint\\limits_R \\sqrt{x^2 + y^2} \\: \\textrm{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iiint\\limits_{R} f(x,y,z) \\, \\mathrm{d}V = \n\\iiint\\limits_{\\Delta} \\, f(r \\cos\\theta, r\\sin\\theta, z) \\:  r \\: \\mathrm{d}z \\, \\mathrm{d}r \\, \\mathrm{d}\\theta.\n$$\n\nIf $(r, \\theta, z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx = r\\cos\\theta, \\qquad\ny = r\\sin\\theta, \\qquad \nz = z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/a5/a551e379767395a2422f690a66fc38defab64cff03c752c0c9a5a0748561d2f7.png)\n\nThe region $R$ is a right vertical cylinder of radius $1$ whose axis passes through the point $(1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z = -2,$ and\n\n- bounded above by $z = 4 - y = 4 - r\\sin{\\theta}.$\n\nWith that in mind, let's write the equation $(x-1)^2 + y^2 = 1$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2} & =1 \\\\ {(r\\operatorname{cos}⁡\\theta -1)}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta -2r\\operatorname{cos}⁡\\theta +1+{r}^{2}{sin}^{2}⁡\\theta  & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r = 2\\cos{\\theta}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\n\\Delta = \\left\\{ (r,\\theta,z) \\, : \\, 0 \\leq r \\leq 2\\cos{\\theta}, \\: -\\dfrac{\\pi}{2} \\leq \\theta \\leq \\dfrac{\\pi}{2}, \\: -2 \\leq z \\leq 4-r\\sin{\\theta} \\right\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}V & ={∭}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{-\\pi /2}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{-2}^{4-r\\operatorname{sin}⁡\\theta }{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} :knowledge-point/id #uuid "aea71b56-dd09-564e-a2bf-5606233e2819" :knowledge-point/question-generator {:db/id #edb/ref 17592186537081 :question-generator/id #uuid "176ad11d-77c9-58f9-aaa7-c4d7d3927260" :question-generator/script "generate/scratch/17592186129268.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186129517 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "267e1e75-5ebd-55ab-842b-e40b9ba9c3d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2+{r}^{2}}{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555079} {:answer/id #uuid "5c988fe0-3022-55d5-a9a9-c2db39cbe076" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{3}{\\int }_{0}^{2+r}{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555207} {:answer/id #uuid "a295bb42-7a73-51b6-8777-f5e3a19c436a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{6\\operatorname{cos}⁡\\theta }{\\int }_{0}^{2+{r}^{2}}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555390} {:answer/id #uuid "d507184c-2f44-5f85-9623-216dcd8ab2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{3}{\\int }_{0}^{2+r}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555505} {:answer/id #uuid "f1e5d412-e590-5a31-80ed-967fe6f3ff74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2+{r}^{2}}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555595}] :answer-field/correct {:answer/id #uuid "f1e5d412-e590-5a31-80ed-967fe6f3ff74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2+{r}^{2}}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186555595} :answer-field/id #uuid "b7d66d94-89fa-5367-8f41-89e27a901a29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0593d504-dbf8-59c9-9282-2775ebdf4b88" :question/math-academy-id "q-161521" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y+3)^{2}\\le 9,\\,0\\le z\\le 2+{x}^{2}+{y}^{2}\\},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}xy\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/75/75bec31176c369e69d5b11af3eeab23f86a4f32251e37f56b225e9dd0bd4a3de.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(0,-3)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=2+{x}^{2}+{y}^{2}=2+{r}^{2}.$\n\nWith that in mind, let's write the equation ${x}^{2}+(y+3)^{2}=9$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+3)^{2} & =9 \\\\ {(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta +3)}^{2} & =9 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +6r\\operatorname{sin}⁡\\theta +9 & =9 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+6r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+6r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+6\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=-6\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -6\\operatorname{sin}⁡\\theta ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le z\\le 2+{r}^{2}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}xy\\,\\text{d}V & ={∭}_{Δ}(r\\operatorname{cos}⁡\\theta )(r\\operatorname{sin}⁡\\theta )\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi }^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2+{r}^{2}}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186129519 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bc181a-8974-5f88-9734-198cc3d71ac0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186564976} {:answer/id #uuid "26efd65d-e4b0-5765-a52f-7e5570d50b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{-2\\operatorname{sin}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565000} {:answer/id #uuid "3049d143-915e-5318-81f0-56825c644df0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565010} {:answer/id #uuid "7ee7a4ae-58f1-55dc-93b1-0b065f6a2752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565131} {:answer/id #uuid "b5c377e8-f5a2-5500-8cd7-722a46d1c396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{-\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565211}] :answer-field/correct {:answer/id #uuid "3049d143-915e-5318-81f0-56825c644df0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186565010} :answer-field/id #uuid "5de2e9ed-6a8e-5e65-b0f4-c004ab1d9bd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126614}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc7985de-f7b8-5b62-b788-d731ea9f3ce6" :question/math-academy-id "q-161523" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-1)^{2}+{y}^{2}\\le 1,\\,y\\ge 0,\\,1\\le z\\le 2\\},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/60/603dc3142d8329fd9ff9fe8d09b131fe09497405f761918d59261fde314772c6.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $1$ whose axis passes through the point $(1,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z=2.$\n\nWith that in mind, let's now write the $(x-1)^{2}+{y}^{2}=1$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta -1)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta -2r\\operatorname{cos}⁡\\theta +1+{r}^{2}{sin}^{2}⁡\\theta  & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 2\\operatorname{cos}⁡\\theta ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,1\\le z\\le 2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}{x}^{2}+{y}^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2\\operatorname{cos}⁡\\theta }{\\int }_{1}^{2}{r}^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186367722 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b265b7cc-feb9-5f37-9252-3a78cad0bd5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{cos}⁡\\theta }{\\int }_{-8}^{r\\operatorname{cos}⁡\\theta +2}\\frac{1}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367724} {:answer/id #uuid "8580f07f-10cc-5678-a359-0d89f29a5582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{-8}^{r\\operatorname{sin}⁡\\theta +2}\\frac{1}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367725} {:answer/id #uuid "5d8af12c-fb84-5a5a-a7a2-521fb178be84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{-8}^{r\\operatorname{cos}⁡\\theta +2}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367726} {:answer/id #uuid "54950957-60fb-56ff-96f5-e10b21a3d9ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{cos}⁡\\theta }{\\int }_{-8}^{r\\operatorname{sin}⁡\\theta +2}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367727} {:answer/id #uuid "dff4f68f-af71-5932-8072-ae940cffd5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{cos}⁡\\theta }{\\int }_{-8}^{r\\operatorname{cos}⁡\\theta +2}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367728}] :answer-field/correct {:answer/id #uuid "dff4f68f-af71-5932-8072-ae940cffd5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{cos}⁡\\theta }{\\int }_{-8}^{r\\operatorname{cos}⁡\\theta +2}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367728} :answer-field/id #uuid "8751e409-d7fb-5aec-8818-db14c330ee72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367723}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f13fe1ec-6a87-5577-82ff-9825a15656c9" :question/math-academy-id "q-161630" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x+3)^{2}+{y}^{2}\\le 9,\\,-8\\le z\\le x+2\\},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/3c/3c03dde21942c60de527ace896bb51ad8070781126d72f5be5e2f6069700736d.png)\n\nThe region $R$ is a right vertical cylinder of radius $3$ whose axis passes through the point $(-3,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-8,$ and\n\n- bounded above by $z=x+2=r\\operatorname{cos}⁡\\theta +2.$\n\nWith that in mind, let's write the equation $(x+3)^{2}+{y}^{2}=9$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+3)^{2}+{y}^{2} & =9 \\\\ {(r\\operatorname{cos}⁡\\theta +3)}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2} & =9 \\\\ {r}^{2}{cos}^{2}⁡\\theta +6r\\operatorname{cos}⁡\\theta +9+{r}^{2}{sin}^{2}⁡\\theta  & =9 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+6r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}+6r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r+6\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=-6\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le -6\\operatorname{cos}⁡\\theta ,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2},\\,-8\\le z\\le r\\operatorname{cos}⁡\\theta +2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{{x}^{2}+{y}^{2}+1}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}}\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-6\\operatorname{cos}⁡\\theta }{\\int }_{-8}^{r\\operatorname{cos}⁡\\theta +2}\\frac{r}{\\sqrt{{r}^{2}+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186367729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b100d2-4636-55d3-9270-cc48d2b6fc52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{6\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{sin}⁡\\theta }^{6}\\frac{r}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367731} {:answer/id #uuid "9a29a4a1-8401-5c26-985a-c9e53ed3d39d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{6\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{sin}⁡\\theta }^{6}\\frac{1}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367732} {:answer/id #uuid "cfe69c16-aea5-5c84-b3e2-6e91f9235a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{r\\operatorname{sin}⁡\\theta }^{6}\\frac{1}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367733} {:answer/id #uuid "6d67683a-c100-5cd2-85f2-e42c45195bdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{6\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{6}\\frac{r}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367734} {:answer/id #uuid "30a2338f-aa3a-5e0e-a5d0-96cd484338d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{-6\\operatorname{sin}⁡\\theta }{\\int }_{r\\operatorname{cos}⁡\\theta }^{6}\\frac{r}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367735}] :answer-field/correct {:answer/id #uuid "19b100d2-4636-55d3-9270-cc48d2b6fc52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{6\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{sin}⁡\\theta }^{6}\\frac{r}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186367731} :answer-field/id #uuid "29402b40-ddfd-5d71-9239-ec1aa69d5ac0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186367730}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d873cc92-450d-547b-9f0c-590b7060a8cb" :question/math-academy-id "q-161636" :question/problem "If the solid region $R$ is given by \n\n$$\nR={(x,y,z)\\,:\\,(x-3)^{2}+{y}^{2}\\le 9,\\,y\\le 0,\\,y\\le z\\le 6},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}\\frac{1}{\\sqrt{z+1}}\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/cc/ccc5cab37aed89c0d701ce0195414796211ddc73a498eaaa1ff145a45c42e9fd.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $3$ whose axis passes through the point $(3,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=y=r\\operatorname{sin}⁡\\theta ,$ and\n\n- bounded above by $z=6.$\n\nWith that in mind, let's now write the $(x-3)^{2}+{y}^{2}=9$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-3)^{2}+{y}^{2} & =9 \\\\ (r\\operatorname{cos}⁡\\theta -3)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =3 \\\\ {r}^{2}{cos}^{2}⁡\\theta -6r\\operatorname{cos}⁡\\theta +9+{r}^{2}{sin}^{2}⁡\\theta  & =9 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-6r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}-6r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-6\\operatorname{cos}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=6\\operatorname{cos}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ={(r,\\theta ,z)\\,:\\,0\\le r\\le 6\\operatorname{cos}⁡\\theta ,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,r\\operatorname{sin}⁡\\theta \\le z\\le 6}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{z+1}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{z+1}}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }{\\int }_{0}^{6\\operatorname{cos}⁡\\theta }{\\int }_{r\\operatorname{sin}⁡\\theta }^{6}\\frac{r}{\\sqrt{z+1}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186427905 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07316687-6f83-5fed-b3ec-6bddf779b76b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{2}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427865} {:answer/id #uuid "8a070aa5-47af-5201-85a2-9449ca643060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427880} {:answer/id #uuid "aa6ce7d9-8ba5-51ed-8961-057d4fc31ae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{-4\\operatorname{cos}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{2}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427884} {:answer/id #uuid "b00512c6-580b-5ace-be32-2aca9c459007" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427885} {:answer/id #uuid "c7c92edf-23c0-5c0c-b7bb-0f570aaf2732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{-4\\operatorname{cos}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427887}] :answer-field/correct {:answer/id #uuid "8a070aa5-47af-5201-85a2-9449ca643060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427880} :answer-field/id #uuid "5a4c28d8-7673-5151-abc1-64dbe75c6bbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427898}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f86783a2-30c3-5d18-9eb0-dc2efdbbae6a" :question/math-academy-id "q-161633" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y-2)^{2}\\le 4,\\,x\\le 0,\\,-2\\le z\\le \\sqrt{16-({x}^{2}+{y}^{2})}\\},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}2xy\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/83/831de8cf1d9833f8674a7e4cb69d01098970eefb9cf576c0537fa7be471c8c2c.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(0,2)$ in the $xy$-plane, and is\n\n- bounded below by $z=-2,$ and\n\n- bounded above by $z=\\sqrt{16-({x}^{2}+{y}^{2})}=\\sqrt{16-{r}^{2}}.$\n\nWith that in mind, let's now write the ${x}^{2}+(y-2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta -2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -4r\\operatorname{sin}⁡\\theta +4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-4r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-4r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-4\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 4\\operatorname{sin}⁡\\theta ,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi ,\\,-2\\le z\\le \\sqrt{16-{r}^{2}}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}2xy\\,\\text{d}V & ={∭}_{Δ}2(r\\operatorname{cos}⁡\\theta )(r\\operatorname{sin}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{0}^{4\\operatorname{sin}⁡\\theta }{\\int }_{-2}^{\\sqrt{16-{r}^{2}}}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186427906 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6caf10ce-b939-51d0-8ac6-b9727918700b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{sin}⁡\\theta }\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427874} {:answer/id #uuid "88813988-bed1-58d5-9361-f7b9c3b921af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{cos}⁡\\theta }r\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427879} {:answer/id #uuid "aa5a0734-d3ec-5220-8c59-ae2d980b4839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{sin}⁡\\theta }r\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427883} {:answer/id #uuid "d4e25a86-fc0b-500c-9ea6-617a19745775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{cos}⁡\\theta }\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427888} {:answer/id #uuid "f1e27cb0-5d40-54cb-b1f4-f82c347f9fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{cos}⁡\\theta }r\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427891}] :answer-field/correct {:answer/id #uuid "88813988-bed1-58d5-9361-f7b9c3b921af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi /2}{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{cos}⁡\\theta }r\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186427879} :answer-field/id #uuid "ae592001-7c80-5683-9d64-6ebfa88e4b3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186427899}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa2c3789-4a9d-5deb-a378-eba9cd152cf2" :question/math-academy-id "q-161637" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y-4)^{2}\\le 16,\\,x\\ge 0,\\,-5\\le z\\le x\\},\n$$\n\nthen $$\n\\displaystyle {∭}_{R}\\sqrt{{x}^{2}+{y}^{2}+1}\\,\\text{d}V=\n$$" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/b6/b66b8db18b2f5773addc2d00c02f2f15f4a7ead53323418e63bd50457f74466b.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(0,4)$ in the $xy$-plane, and is\n\n- bounded below by $z=-5,$ and\n\n- bounded above by $z=x=r\\operatorname{cos}⁡\\theta .$\n\nWith that in mind, let's now write the ${x}^{2}+(y-4)^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-4)^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta -4)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -8r\\operatorname{sin}⁡\\theta +16 & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-8r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-8\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8\\operatorname{sin}⁡\\theta .$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le \\frac{\\pi }{2},\\,-5\\le z\\le r\\operatorname{cos}⁡\\theta \\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{{x}^{2}+{y}^{2}+1}\\,\\text{d}V & ={∭}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={∭}_{Δ}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}\\cdot r\\,dz\\,dr\\,d\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{8\\operatorname{sin}⁡\\theta }{\\int }_{-5}^{r\\operatorname{cos}⁡\\theta }r\\sqrt{{r}^{2}+1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "237e8e7d-e3db-5f7c-9347-4abfc31811d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{0}^{1}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536996} {:answer/id #uuid "4f83f8a6-2631-55b9-a475-cf21a17cb881" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{0}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537015} {:answer/id #uuid "9d691199-900d-5dbc-95ff-fd5da1703bb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{0}^{1}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537043} {:answer/id #uuid "b727e49c-dd3f-5d45-b030-cf65baa91799" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{0}^{1}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537053} {:answer/id #uuid "f8d59057-b6e1-58d4-8bca-71b7a0d1be8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{2 \\cos{\\left(\\theta \\right)}}{\\int }_{0}^{1}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537076}] :answer-field/correct {:answer/id #uuid "237e8e7d-e3db-5f7c-9347-4abfc31811d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{0}^{1}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536996} :answer-field/id #uuid "fb63a029-3502-5e90-a9fa-8ddfb79c7c2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537078}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "00623118-ee32-53b0-8e64-30db43b56fa6" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-2)^{2}+{y}^{2}\\le 4,y\\ge 0,\\,0\\le z\\le 1\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x^{2} + y^{2}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/d2/d2b3344b7b910f5685d4fd81b75a600608af6b008778ff608cb084edb5a92da9.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(2,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=1.$\n\nWith that in mind, let's now write the $(x-2)^{2}+{y}^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta-2)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta -4r\\operatorname{cos}⁡\\theta+4+{r}^{2}{sin}^{2}⁡\\theta & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-4r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-4r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-4\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 4 \\cos{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,0\\le z\\le 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x^{2} + y^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{0}^{1}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30aa1de6-9825-58df-a0bb-9361d44a7568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{3} \\cos^{2}{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536998} {:answer/id #uuid "32b99b29-cd14-5ea5-9fc1-15df5b4eb850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537001} {:answer/id #uuid "9605e9f5-cd80-5de4-9598-0eef1d67fdca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{2} \\sin^{2}{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537039} {:answer/id #uuid "9c51e829-74a8-59f0-b024-a19f558413ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{2} \\cos^{2}{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537042} {:answer/id #uuid "dff20a83-a22c-52be-b879-f991bfe4e845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{3} \\sin^{2}{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537068}] :answer-field/correct {:answer/id #uuid "32b99b29-cd14-5ea5-9fc1-15df5b4eb850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537001} :answer-field/id #uuid "c677a795-89fc-56d8-8a2d-f295aa205e01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3421c850-1e07-524f-a0e9-45c83fcec039" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y+2)^{2}\\le 4,\\,0\\le z\\le x^{2} + y^{2} + 5\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x y\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/ce/cee08173667c9577f4c7aab8cac5386434f2e1ecab8836150ebe8066d1cbaa68.png)\n\nThe region $R$ is a right vertical cylinder of radius $2$ whose axis passes through the point $(0,-2)$ in the $xy$-plane, and is\n\n- bounded below by $z=0,$ and\n\n- bounded above by $z=x^{2} + y^{2} + 5=r^{2} + 5.$\n\nWith that in mind, let's write the equation ${x}^{2}+(y+2)^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta+2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +4r\\operatorname{sin}⁡\\theta+4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{sin}⁡\\theta & =0 \\\\ {r}^{2}+4r\\operatorname{sin}⁡\\theta & =0 \\\\ r(r+4\\operatorname{sin}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=- 4 \\sin{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le - 4 \\sin{\\left(\\theta \\right)},\\,\\pi\\le \\theta \\le 2 \\pi,\\,0\\le z\\le r^{2} + 5\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x y\\,\\text{d}V & ={∭}_{Δ}(r\\operatorname{cos}⁡\\theta)(r\\operatorname{sin}⁡\\theta)\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\pi}^{2 \\pi}{\\int }_{0}^{- 4 \\sin{\\left(\\theta \\right)}}{\\int }_{0}^{r^{2} + 5}r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537006 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "321df476-4949-5c09-820e-9305d838bc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537000} {:answer/id #uuid "4e59d9d4-da68-5e58-aff1-c4c4a3337e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{4} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537014} {:answer/id #uuid "9a68c5dc-993d-52d2-9754-5b09d9106e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{4 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537041} {:answer/id #uuid "b4961f55-574a-53f6-91ac-244a2907cf1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{\\sqrt{81 - r^{2}}}^{-5}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537051} {:answer/id #uuid "c82cc82c-e96d-5c71-9bfd-49718a58969e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537059}] :answer-field/correct {:answer/id #uuid "321df476-4949-5c09-820e-9305d838bc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}2 r^{3} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537000} :answer-field/id #uuid "346ca32c-f65c-5df0-9d38-5355dcbfffd3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537004}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3595f3ec-49d1-5481-82e6-c23464cfa603" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y-4)^{2}\\le 16,x\\le 0,\\,-5\\le z\\le \\sqrt{- x^{2} - y^{2} + 81}\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}2 x y\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/57/5764f328a614ddaa96abd28a4568c4cd7dfcf0988033d3122bdce0e1e52b7bc5.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(0,4)$ in the $xy$-plane, and is\n\n- bounded below by $z=-5,$ and\n\n- bounded above by $z=\\sqrt{- x^{2} - y^{2} + 81}=\\sqrt{81 - r^{2}}.$\n\nWith that in mind, let's now write the ${x}^{2}+(y-4)^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-4)^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta-4)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -8r\\operatorname{sin}⁡\\theta+16 & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{sin}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{sin}⁡\\theta & =0 \\\\ r(r-8\\operatorname{sin}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\sin{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\sin{\\left(\\theta \\right)},\\,\\frac{\\pi}{2}\\le \\theta \\le \\pi,\\,-5\\le z\\le \\sqrt{81 - r^{2}}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}2 x y\\,\\text{d}V & ={∭}_{Δ}2(r\\operatorname{cos}⁡\\theta)(r\\operatorname{sin}⁡\\theta)\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{\\pi}{2}}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-5}^{\\sqrt{81 - r^{2}}}{r}^{3}\\operatorname{sin}⁡2\\theta \\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30efa546-da45-5a01-977f-f55cd5e7ba61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536999} {:answer/id #uuid "3dc4f541-1cf6-594c-ba21-8359f5bbbc24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{7}^{4}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537011} {:answer/id #uuid "7a324aba-9b63-5874-a2b1-733a50c7781b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537033} {:answer/id #uuid "81de05b4-209e-5bc0-9833-10807223dd7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{2 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537035} {:answer/id #uuid "e388a7a5-3cdc-52bc-8ddf-defa6c22aae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537070}] :answer-field/correct {:answer/id #uuid "30efa546-da45-5a01-977f-f55cd5e7ba61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536999} :answer-field/id #uuid "65f21aac-e7ac-5168-a171-1b5b4f594e1c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537022}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "590500ab-ca5a-598f-be1f-2910c46fae9a" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-2)^{2}+{y}^{2}\\le 4,y\\ge 0,\\,4\\le z\\le 7\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x^{2} + y^{2}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/d2/d2b3344b7b910f5685d4fd81b75a600608af6b008778ff608cb084edb5a92da9.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $2$ whose axis passes through the point $(2,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=4,$ and\n\n- bounded above by $z=7.$\n\nWith that in mind, let's now write the $(x-2)^{2}+{y}^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta-2)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta -4r\\operatorname{cos}⁡\\theta+4+{r}^{2}{sin}^{2}⁡\\theta & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-4r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-4r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-4\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 4 \\cos{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,4\\le z\\le 7\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x^{2} + y^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da30d8b-b4d8-596a-8c80-6b14e0374096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536987} {:answer/id #uuid "0e208e2f-cf97-52a6-913e-893119de1c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536988} {:answer/id #uuid "20ec8899-9f98-5939-b1be-717c8a36b84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536994} {:answer/id #uuid "37eefddf-45ba-5950-8013-940c638fd35a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{7}^{4}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537007} {:answer/id #uuid "9f831628-be52-5b60-9299-337a30d46fe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537044}] :answer-field/correct {:answer/id #uuid "0e208e2f-cf97-52a6-913e-893119de1c31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536988} :answer-field/id #uuid "3b7df119-1e10-5a12-b44e-c332dcfb8b0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537008}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "69ed0333-f7ae-5aef-adf8-ef1e138c3825" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-4)^{2}+{y}^{2}\\le 16,y\\ge 0,\\,4\\le z\\le 7\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x^{2} + y^{2}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/80/80a919b28ae7ed559b06b34bd8512859794a7d6550970b56347e2deb653bf76d.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=4,$ and\n\n- bounded above by $z=7.$\n\nWith that in mind, let's now write the $(x-4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta-4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta -8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\cos{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,4\\le z\\le 7\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x^{2} + y^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{7}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e702de4-81fb-57f8-b700-52c7a2d5b037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\cos{\\left(\\theta \\right)} + 5}^{-1}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537029} {:answer/id #uuid "6eef909b-2ae7-54ad-8347-4b8012df300a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-1}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537030} {:answer/id #uuid "a4798cdd-ba94-5538-b8db-9acc2dd4aebf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-1}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{1}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537046} {:answer/id #uuid "d2013466-8cd9-50cf-ab08-7466182070c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 2 \\cos{\\left(\\theta \\right)}}{\\int }_{-1}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537061} {:answer/id #uuid "f189cf4d-34b4-53e8-8fda-d1dc11be310f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-1}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r^{2}}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537073}] :answer-field/correct {:answer/id #uuid "6eef909b-2ae7-54ad-8347-4b8012df300a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-1}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537030} :answer-field/id #uuid "1e63057c-fad2-57b0-ab28-4c0735601f0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6a4d1aae-ff57-5336-93e6-e2feb480e2e3" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x+2)^{2}+{y}^{2}\\le 4,\\,-1\\le z\\le x + 5\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f8/f830c1469527c615d213ffcd11e472083c77d7e5fbc8c1577a85244fb5739fc4.png)\n\nThe region $R$ is a right vertical cylinder of radius $2$ whose axis passes through the point $(-2,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-1,$ and\n\n- bounded above by $z=x + 5=r \\cos{\\left(\\theta \\right)} + 5.$\n\nWith that in mind, let's write the equation $(x+2)^{2}+{y}^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta+2)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +4r\\operatorname{cos}⁡\\theta+4+{r}^{2}{sin}^{2}⁡\\theta & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}+4r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r+4\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=- 4 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le - 4 \\cos{\\left(\\theta \\right)},\\,\\frac{\\pi}{2}\\le \\theta \\le \\frac{3 \\pi}{2},\\,-1\\le z\\le r \\cos{\\left(\\theta \\right)} + 5\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2}+2}}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+2}}\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-1}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537040 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0525826c-a736-5227-9f0a-27dd1c50c845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 2 \\cos{\\left(\\theta \\right)}}{\\int }_{-4}^{r \\cos{\\left(\\theta \\right)} + 1}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536984} {:answer/id #uuid "202eb17e-51e1-5247-9d96-d74c13ad2578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-4}^{r \\cos{\\left(\\theta \\right)} + 1}\\frac{r^{2}}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536992} {:answer/id #uuid "ccfe631f-2545-5c41-af46-41c806290c74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\cos{\\left(\\theta \\right)} + 1}^{-4}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537060} {:answer/id #uuid "d3a68dfb-291a-522b-9d54-5f6067f6ec23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-4}^{r \\cos{\\left(\\theta \\right)} + 1}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537063} {:answer/id #uuid "f764cb4a-e42e-5109-87ae-915856bb8816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-4}^{r \\cos{\\left(\\theta \\right)} + 1}\\frac{1}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537075}] :answer-field/correct {:answer/id #uuid "d3a68dfb-291a-522b-9d54-5f6067f6ec23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-4}^{r \\cos{\\left(\\theta \\right)} + 1}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537063} :answer-field/id #uuid "fc962529-0553-5bdb-9bba-afa4db3dcd57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537080}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9786603b-57ce-5b6a-ad81-096bf72b5c29" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x+2)^{2}+{y}^{2}\\le 4,\\,-4\\le z\\le x + 1\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/f8/f830c1469527c615d213ffcd11e472083c77d7e5fbc8c1577a85244fb5739fc4.png)\n\nThe region $R$ is a right vertical cylinder of radius $2$ whose axis passes through the point $(-2,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-4,$ and\n\n- bounded above by $z=x + 1=r \\cos{\\left(\\theta \\right)} + 1.$\n\nWith that in mind, let's write the equation $(x+2)^{2}+{y}^{2}=4$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta+2)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +4r\\operatorname{cos}⁡\\theta+4+{r}^{2}{sin}^{2}⁡\\theta & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}+4r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r+4\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=- 4 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le - 4 \\cos{\\left(\\theta \\right)},\\,\\frac{\\pi}{2}\\le \\theta \\le \\frac{3 \\pi}{2},\\,-4\\le z\\le r \\cos{\\left(\\theta \\right)} + 1\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2}+2}}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+2}}\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-4}^{r \\cos{\\left(\\theta \\right)} + 1}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b0e90e7-4add-5e33-8547-4c25dae10c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 4 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537013} {:answer/id #uuid "51c76675-9e2c-59b9-8577-4dc096a8cdfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\cos{\\left(\\theta \\right)} + 5}^{-6}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537016} {:answer/id #uuid "5d3b8ee2-e524-5b41-8574-e188f91ae2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r^{2}}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537020} {:answer/id #uuid "a36208fb-a2e1-572d-a6a9-8b8ccf4ee98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537045} {:answer/id #uuid "d3040689-2239-57e5-8500-1ac134938960" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{1}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537062}] :answer-field/correct {:answer/id #uuid "a36208fb-a2e1-572d-a6a9-8b8ccf4ee98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537045} :answer-field/id #uuid "3c179be8-68d6-5589-9fd5-03692660f907" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537009}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a4df6a09-850b-5ef6-8bf5-1f79b92be5fa" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x+4)^{2}+{y}^{2}\\le 16,\\,-6\\le z\\le x + 5\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/8b/8b16f7e69a4ce84b0b7c4597defd9e9f55593e50623f344f001d24518d59c483.png)\n\nThe region $R$ is a right vertical cylinder of radius $4$ whose axis passes through the point $(-4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=-6,$ and\n\n- bounded above by $z=x + 5=r \\cos{\\left(\\theta \\right)} + 5.$\n\nWith that in mind, let's write the equation $(x+4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x+4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta+4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}+8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r+8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire circle, we must have $r=- 8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le - 8 \\cos{\\left(\\theta \\right)},\\,\\frac{\\pi}{2}\\le \\theta \\le \\frac{3 \\pi}{2},\\,-6\\le z\\le r \\cos{\\left(\\theta \\right)} + 5\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{x^{2} + y^{2} + 2}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{(r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2}+2}}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}\\frac{r}{\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+2}}\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{\\pi}{2}}^{\\frac{3 \\pi}{2}}{\\int }_{0}^{- 8 \\cos{\\left(\\theta \\right)}}{\\int }_{-6}^{r \\cos{\\left(\\theta \\right)} + 5}\\frac{r}{\\sqrt{r^{2} + 2}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098d3517-e148-57fb-b802-0b2dbc349278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\sin{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536985} {:answer/id #uuid "24acc4ff-e0b0-5c78-95ce-b81732e7ce1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536997} {:answer/id #uuid "3554a9cb-6c59-5f65-87eb-c96e1206a180" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}\\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537005} {:answer/id #uuid "42573f2c-f0d7-5b0a-a697-3d745e18a680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537012} {:answer/id #uuid "b2ef5227-2542-5600-9c83-8758d74eee3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\pi}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\sin{\\left(\\theta \\right)}}\\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537050}] :answer-field/correct {:answer/id #uuid "24acc4ff-e0b0-5c78-95ce-b81732e7ce1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536997} :answer-field/id #uuid "8f1ed8e4-2fa2-59d9-98df-3af8a6aba784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537037}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ab4dd324-45c0-5df5-a923-9696a0511377" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,{x}^{2}+(y-4)^{2}\\le 16,x\\ge 0,\\,-2\\le z\\le x\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\sqrt{x^{2} + y^{2} + 1}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/26/262fdb09ab8f6ee5de1a31cec2d238cb633ae2d5dfa2e99d80ed58d4cb849ec5.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(0,4)$ in the $xy$-plane, and is\n\n- bounded below by $z=-2,$ and\n\n- bounded above by $z=x=r \\cos{\\left(\\theta \\right)}.$\n\nWith that in mind, let's now write the ${x}^{2}+(y-4)^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+(y-4)^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta-4)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -8r\\operatorname{sin}⁡\\theta+16 & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{sin}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{sin}⁡\\theta & =0 \\\\ r(r-8\\operatorname{sin}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\sin{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\sin{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,-2\\le z\\le r \\cos{\\left(\\theta \\right)}\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}\\sqrt{x^{2} + y^{2} + 1}\\,\\text{d}V & ={∭}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2}+1}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+1}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\sin{\\left(\\theta \\right)}}{\\int }_{-2}^{r \\cos{\\left(\\theta \\right)}}r \\sqrt{r^{2} + 1}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a83957d-072f-56dd-967f-e6e3cad6b479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536986} {:answer/id #uuid "2156c48d-60f6-5a75-b7bd-532244308380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536995} {:answer/id #uuid "55850eab-9b9d-5708-b164-b99babf0d7c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537017} {:answer/id #uuid "8d424d92-a14d-56fd-9646-621bf9980044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{2}^{1}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537036} {:answer/id #uuid "d8b1f40f-3ec1-5b86-a168-1bf950f81dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537065}] :answer-field/correct {:answer/id #uuid "55850eab-9b9d-5708-b164-b99babf0d7c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537017} :answer-field/id #uuid "3c67f654-3428-5c4c-b065-5f85356ec766" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537010}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5e1ca18-2705-5bdb-9505-7d24e5965b22" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-4)^{2}+{y}^{2}\\le 16,y\\ge 0,\\,1\\le z\\le 2\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}x^{2} + y^{2}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/80/80a919b28ae7ed559b06b34bd8512859794a7d6550970b56347e2deb653bf76d.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=1,$ and\n\n- bounded above by $z=2.$\n\nWith that in mind, let's now write the $(x-4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta-4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta -8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\cos{\\left(\\theta \\right)},\\,0\\le \\theta \\le \\frac{\\pi}{2},\\,1\\le z\\le 2\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}{∭}_{R}x^{2} + y^{2}\\,\\text{d}V & ={∭}_{Δ}((r\\operatorname{cos}⁡\\theta)^{2}+(r\\operatorname{sin}⁡\\theta)^{2})\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={∭}_{Δ}{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{1}^{2}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f5725f-873a-5cb2-9d93-8dd091bb64fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{r \\sin{\\left(\\theta \\right)}}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186536989} {:answer/id #uuid "341da02c-a537-571e-98d0-36040cb4c3d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537002} {:answer/id #uuid "55f37382-115f-5176-b367-f0f7693481cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{1}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537018} {:answer/id #uuid "95c46129-e371-5472-a8c0-39ca8937604f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537038} {:answer/id #uuid "dede804f-1f13-5287-811a-67eb0c9566f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r^{2}}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537067}] :answer-field/correct {:answer/id #uuid "341da02c-a537-571e-98d0-36040cb4c3d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537002} :answer-field/id #uuid "f3833d31-d0a7-5f2a-ba09-40678b399d56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537074}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c80df8b3-485c-5c4b-a01f-65b076ecb41f" :question/problem "If the solid region $R$ is given by \n\n$$\nR=\\{(x,y,z)\\,:\\,(x-4)^{2}+{y}^{2}\\le 16,y\\le 0,\\,y\\le z\\le 4\\},\n$$\n\nthen express the triple integral\n\n$$\n{∭}_{R}\\frac{1}{\\sqrt{z + 5}}\\,\\text{d}V\n$$\n\nas an equivalent integral in cylindrical polar coordinates." :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n{∭}_{R}f(x,y,z)\\,dV={∭}_{Δ}\\,f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta ,z)\\,r\\,dz\\,dr\\,d\\theta .\n$$\n\nIf $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the formulas\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z.\n$$\n\nFirst, let's sketch the projection of $R$ onto the $xy$-plane:\n\n![](images/51/510a5ecd48459be9372c1a797d00cc78a167b7ebc0563063e4f1a1e187e32bd0.png)\n\nThe region $R$ is one-half of a right vertical cylinder of radius $4$ whose axis passes through the point $(4,0)$ in the $xy$-plane, and is\n\n- bounded below by $z=y=r \\sin{\\left(\\theta \\right)},$ and\n\n- bounded above by $z=4.$\n\nWith that in mind, let's now write the $(x-4)^{2}+{y}^{2}=16$ in polar coordinates:\n\n$$\n\\begin{aligned}(x-4)^{2}+{y}^{2} & =16 \\\\ (r\\operatorname{cos}⁡\\theta-4)^{2}+(r\\operatorname{sin}⁡\\theta)^{2} & =16 \\\\ {r}^{2}{cos}^{2}⁡\\theta -8r\\operatorname{cos}⁡\\theta+16+{r}^{2}{sin}^{2}⁡\\theta & =16 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-8r\\operatorname{cos}⁡\\theta & =0 \\\\ {r}^{2}-8r\\operatorname{cos}⁡\\theta & =0 \\\\ r(r-8\\operatorname{cos}⁡\\theta) & =0\\end{aligned}\n$$\n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=8 \\cos{\\left(\\theta \\right)}.$\n\nAs a result, in cylindrical polar coordinates, our region can be expressed as \n\n$$\nΔ=\\{(r,\\theta ,z)\\,:\\,0\\le r\\le 8 \\cos{\\left(\\theta \\right)},\\,\\frac{3 \\pi}{2}\\le \\theta \\le 2 \\pi,\\,r \\sin{\\left(\\theta \\right)}\\le z\\le 4\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∭}_{R}\\frac{1}{\\sqrt{z + 5}}\\,\\text{d}V & ={∭}_{Δ}\\frac{1}{\\sqrt{z + 5}}\\cdot r\\,dz\\,dr\\,d\\theta \\\\  & ={\\int }_{\\frac{3 \\pi}{2}}^{2 \\pi}{\\int }_{0}^{8 \\cos{\\left(\\theta \\right)}}{\\int }_{r \\sin{\\left(\\theta \\right)}}^{4}\\frac{r}{\\sqrt{z + 5}}\\,dz\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186537064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6797e6ea-0e50-5bcf-8670-1502efade88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{2 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537023} {:answer/id #uuid "6a1f36d1-2f5f-5b5d-b048-0f5b93961b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{6}^{4}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537026} {:answer/id #uuid "80b41028-1697-5a18-89f0-2ed59ee0559f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{2}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537034} {:answer/id #uuid "c719c5f0-f401-5da6-91a4-572901eb262b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537057} {:answer/id #uuid "fb13a566-d121-503a-8bc9-4bd42bb083df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{4}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537077}] :answer-field/correct {:answer/id #uuid "c719c5f0-f401-5da6-91a4-572901eb262b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\frac{\\pi}{2}}{\\int }_{0}^{4 \\cos{\\left(\\theta \\right)}}{\\int }_{4}^{6}r^{3}\\,dz\\,\\text{d}r\\,\\text{d}\\theta " :db/id #edb/ref 17592186537057} :answer-field/id #uuid "5d4af9d5-325d-5634-94af-ef6d75847f12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186537021}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d488f663-9171-597d-b