(t-s))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{4t}\\end{bmatrix},\\,x(0)=\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cosh}⁡(4t) & \\operatorname{sinh}⁡(4t) \\\\ \\operatorname{sinh}⁡(4t) & \\operatorname{cosh}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ 4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">$\\operatorname{cosh}⁡(4t)+3\\operatorname{sinh}⁡(4t)$</td>\n<td align=\"center\" width=\"5px\"></td><td align=\"center\" height=\"30px\" rowspan=\"2\">$\\displaystyle \\,\\,+{\\int }_{0}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"160px\">${e}^{4s}\\operatorname{sinh}⁡(4(t-s))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr><tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\"></td><td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186479851 :question/worked-solution "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n${i}^{′}=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}$ \nand \n${j}^{′}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=\\begin{bmatrix}2 & -1 \\\\ 3 & 1\\end{bmatrix}.\n$$" "Every linear transformation in ${R}^{2}$ can be represented as a $2\\times 2$ matrix. The standard matrix representation of the transformation has columns that are the images of the vectors $i$ and $j$ under the action of the transformation.\n\nFrom the diagram we see that \n$$\n\\displaystyle {i}^{′}=\\begin{bmatrix}2 \\\\ 3\\end{bmatrix}\n$$ \nand \n$$\n\\displaystyle {j}^{′}=\\begin{bmatrix}-1 \\\\ 1\\end{bmatrix}.\n$$\n\nTherefore, the standard matrix for the linear transformation is \n\n$$\nT=\\begin{bmatrix}2 & -1 \\\\ 3 & 1\\end{bmatrix}.\n$$"] [:db/cas 17592186479852 :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\sqrt{2}$ given that $∇f(x,y)=(\\operatorname{ln}⁡(x+y)+\\frac{x}{x+y})i+\\frac{x}{x+y}\\,j$ and $r(t)=2t\\,i+(1-2t)\\,j.$" "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(r(t))]$ at $t=\\sqrt{2}$ given that $$\n\\displaystyle ∇f(x,y)=(\\operatorname{ln}⁡(x+y)+\\frac{x}{x+y})i+\\frac{x}{x+y}\\,j\n$$ and $r(t)=2t\\,i+(1-2t)\\,j.$"] [:db/cas 17592186479854 :question/problem "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{4t}\\end{bmatrix},\\,x(1)=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">$5\\operatorname{sin}⁡(4(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">${e}^{4s}\\operatorname{cos}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "$$\n{x}^{′}(t)=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}x+\\begin{bmatrix}0 \\\\ {e}^{4t}\\end{bmatrix},\\,x(1)=\\begin{bmatrix}0 \\\\ 5\\end{bmatrix}\n$$\n\nWrite down the expression that gives the solution of the initial value problem above.\n\n*Hint: ${e}^{At}=\\begin{bmatrix}\\operatorname{cos}⁡(4t) & \\operatorname{sin}⁡(4t) \\\\ -\\operatorname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{bmatrix},$ where $A=\\begin{bmatrix}0 & 4 \\\\ -4 & 0\\end{bmatrix}.$*\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$x(t)=\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">$5\\operatorname{sin}⁡(4(t-1))$</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\displaystyle \\,\\,+{\\int }_{1}^{t}\\,\\,$</td>\n<td align=\"center\" height=\"40px\" width=\"5px\"></td>\n<td align=\"center\" width=\"100px\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n<td align=\"center\" height=\"30px\" rowspan=\"2\">$\\,\\,\\text{d}s$</td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">${e}^{4s}\\operatorname{cos}⁡(4(t-s))$</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186479869 :question/problem "Consider the inhomogeneous system  ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below.\n\n$\\text{L1}:\\,$ Let $y(t)={e}^{-A(t-{t}_{0})}x(t)$  \n\n$\\text{L2}:\\,$ ${y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)$  \n\n$\\text{L3}:\\,$ ${y}^{′}(t)={e}^{-A(t-{t}_{0})}g(t)$  \n\n$\\text{L4}:\\,$ $y(t)-y({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$\n\n$\\text{L5}:\\,$ $y({t}_{0})=x({t}_{0})$ \n\n$\\text{L6}:\\,$ $y(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s$  \n\n$\\text{L7}:\\,$ ${e}^{A(t-{t}_{0})}y(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\n$\\text{L8}:\\,$ ${e}^{A(t-{t}_{0})}y(t)=x(t)$\n\n$\\text{L9}:\\,$ $x(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by  \n{{field-2}}.\n\n$\\,$ Line $\\text{L9}$ follows from line $\\text{L7}$ by  \n{{field-3}}." "Consider the inhomogeneous system  ${x}^{′}(t)=Ax(t)+g(t),$ where $A$ is a constant square matrix. A derivation of the formula for the solution $x(t)$ passing through $x({t}_{0})$ is presented below.\n\n$\\text{L1}:\\,$ Let $y(t)={e}^{-A(t-{t}_{0})}x(t)$  \n\n$\\text{L2}:\\,$ ${y}^{′}(t)=-A{e}^{-A(t-{t}_{0})}x(t)+{e}^{-A(t-{t}_{0})}{x}^{′}(t)$  \n\n$\\text{L3}:\\,$ ${y}^{′}(t)={e}^{-A(t-{t}_{0})}g(t)$  \n\n$\\text{L4}:\\,$ $$\n\\displaystyle y(t)-y({t}_{0})={\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s\n$$\n\n$\\text{L5}:\\,$ $y({t}_{0})=x({t}_{0})$ \n\n$\\text{L6}:\\,$ $$\n\\displaystyle y(t)=x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{-A(s-{t}_{0})}g(s)\\,\\text{d}s\n$$  \n\n$\\text{L7}:\\,$ $$\n\\displaystyle {e}^{A(t-{t}_{0})}y(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s\n$$\n\n$\\text{L8}:\\,$ ${e}^{A(t-{t}_{0})}y(t)=x(t)$\n\n$\\text{L9}:\\,$ $$\n\\displaystyle x(t)={e}^{A(t-{t}_{0})}x({t}_{0})+{\\int }_{{t}_{0}}^{t}{e}^{A(t-s)}g(s)\\,\\text{d}s\n$$\n\nSelect the correct options to justify each step of the reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from $\\text{L1}$ by  \n{{field-1}}.\n\n$\\,$ Line $\\text{L7}$ follows from line $\\text{L6}$ by  \n{{field-2}}.\n\n$\\,$ Line $\\text{L9}$ follows from line $\\text{L7}$ by  \n{{field-3}}."] [:db/cas 17592186480710 :question/problem "${\\left(\\frac{1}{6}\\right)}^{5}\\times {\\left(\\frac{1}{6}\\right)}^{8}=$" "$$\n\\displaystyle {\\left(\\frac{1}{6}\\right)}^{5}\\times {\\left(\\frac{1}{6}\\right)}^{8}=\n$$"] [:db/cas 17592186481350 :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-1)\\cdot 2+(-3)\\cdot 1+1\\cdot (-1)}{{2}^{2}+{1}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}\\}$ is an orthogonal basis for $V.$\n\nFinally, $a=1,$ $b=-2,$ and  \n\n$$\n\\frac{b}{a}=\\frac{-2}{1}=-2.\n$$" "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-1)\\cdot 2+(-3)\\cdot 1+1\\cdot (-1)}{{2}^{2}+{1}^{2}+(-1)^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-1 \\\\ -3 \\\\ 1\\end{bmatrix}+\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $$\n\\displaystyle B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}2 \\\\ 1 \\\\ -1\\end{bmatrix},\\begin{bmatrix}1 \\\\ -2 \\\\ 0\\end{bmatrix}\\}\n$$ is an orthogonal basis for $V.$\n\nFinally, $a=1,$ $b=-2,$ and  \n\n$$\n\\frac{b}{a}=\\frac{-2}{1}=-2.\n$$"] [:db/cas 17592186481353 :question/problem "$(7-5)^{-4}+{(\\frac{3}{5}-\\frac{1}{2})}^{0}=${{field-1}}" "$$\n\\displaystyle (7-5)^{-4}+{(\\frac{3}{5}-\\frac{1}{2})}^{0}=\n$${{field-1}}"] [:db/cas 17592186481353 :question/worked-solution "To evaluate the given expression, we use PEMDAS. \n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\begin{aligned}(7-5)^{-4}+{(\\frac{3}{5}-\\frac{1}{2})}^{0} &= {2}^{-4}+{(\\frac{6}{10}-\\frac{5}{10})}^{0} \\\\ &= {2}^{-4}+{\\left(\\frac{1}{10}\\right)}^{0}\\end{aligned}\n$$\n\nNext, notice that ${\\left(\\frac{1}{10}\\right)}^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}{2}^{-4}+{\\left(\\frac{1}{10}\\right)}^{0} &= {2}^{-4}+1\\end{aligned}\n$$\n\nFinally, notice that ${2}^{-4}=\\frac{1}{{2}^{4}}=\\frac{1}{16}.$ So, \n\n$$\n\\begin{aligned}{2}^{-4}+1 &= \\frac{1}{16}+1 \\\\ &= \\frac{1+16}{16} \\\\ &= \\frac{17}{16}.\\end{aligned}\n$$" "To evaluate the given expression, we use PEMDAS. \n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\begin{aligned}(7-5)^{-4}+{(\\frac{3}{5}-\\frac{1}{2})}^{0} &= {2}^{-4}+{(\\frac{6}{10}-\\frac{5}{10})}^{0} \\\\ &= {2}^{-4}+{\\left(\\frac{1}{10}\\right)}^{0}\\end{aligned}\n$$\n\nNext, notice that ${\\left(\\frac{1}{10}\\right)}^{0}=1.$ So, we obtain:\n\n$$\n\\begin{aligned}{2}^{-4}+{\\left(\\frac{1}{10}\\right)}^{0} &= {2}^{-4}+1\\end{aligned}\n$$\n\nFinally, notice that $$\n\\displaystyle {2}^{-4}=\\frac{1}{{2}^{4}}=\\frac{1}{16}.\n$$ So, \n\n$$\n\\begin{aligned}{2}^{-4}+1 &= \\frac{1}{16}+1 \\\\ &= \\frac{1+16}{16} \\\\ &= \\frac{17}{16}.\\end{aligned}\n$$"] [:db/cas 17592186481360 :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{4\\cdot 1+0\\cdot (-2)+2\\cdot 1}{{1}^{2}+(-2)^{2}+{1}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}\\}$ is an orthogonal basis for $V.$\n\nFinally, $a=3,$ $c=1,$ and  \n\n$$\n\\frac{c}{a}=\\frac{1}{3}.\n$$" "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{4\\cdot 1+0\\cdot (-2)+2\\cdot 1}{{1}^{2}+(-2)^{2}+{1}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}4 \\\\ 0 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $$\n\\displaystyle B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix},\\begin{bmatrix}3 \\\\ 2 \\\\ 1\\end{bmatrix}\\}\n$$ is an orthogonal basis for $V.$\n\nFinally, $a=3,$ $c=1,$ and  \n\n$$\n\\frac{c}{a}=\\frac{1}{3}.\n$$"] [:db/cas 17592186481363 :question/worked-solution "First, let's denote \n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-1)\\cdot (-3)+0\\cdot 1+2\\cdot 2}{(-3)^{2}+{1}^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 1\\end{bmatrix}\\}$ is an orthogonal basis for $V.$\n\nFinally, we have $a=\\frac{1}{2},$ $c=1,$ and \n\n$$\n\\frac{c}{a}=\\frac{1}{\\left(\\frac{1}{2}\\right)}=2.\n$$" "First, let's denote \n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{(-1)\\cdot (-3)+0\\cdot 1+2\\cdot 2}{(-3)^{2}+{1}^{2}+{2}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}-1 \\\\ 0 \\\\ 2\\end{bmatrix}-\\frac{1}{2}\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, $$\n\\displaystyle B=\\{{v}_{1},{v}_{2}\\}=\\{\\begin{bmatrix}-3 \\\\ 1 \\\\ 2\\end{bmatrix},\\begin{bmatrix}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 1\\end{bmatrix}\\}\n$$ is an orthogonal basis for $V.$\n\nFinally, we have $a=\\frac{1}{2},$ $c=1,$ and \n\n$$\n\\frac{c}{a}=\\frac{1}{\\left(\\frac{1}{2}\\right)}=2.\n$$"] [:db/cas 17592186481368 :question/problem "$6{x}^{3}(\\frac{x}{2}-\\frac{{x}^{3}}{3})=$" "$$\n\\displaystyle 6{x}^{3}(\\frac{x}{2}-\\frac{{x}^{3}}{3})=\n$$"] [:db/cas 17592186481373 :question/problem "Calculate ${(\\frac{8}{7}-\\frac{1}{16})}^{0}-11\\times {\\left(\\frac{1}{2}\\right)}^{-3}.$" "Calculate $$\n\\displaystyle {(\\frac{8}{7}-\\frac{1}{16})}^{0}-11\\times {\\left(\\frac{1}{2}\\right)}^{-3}.\n$$"] [:db/cas 17592186481375 :question/worked-solution "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\frac{5}{36}\\times 2+(5+1)^{-2}=\\frac{5}{36}\\times 2+{6}^{-2}\n$$\n\nNext, notice that ${6}^{-2}=\\frac{1}{{6}^{2}}=\\frac{1}{36}.$ So, we obtain:\n\n$$\n\\begin{aligned}\\frac{5}{36}\\times 2+{6}^{-2} &= \\frac{5}{36}\\times 2+\\frac{1}{36} \\\\ &= \\frac{5}{36}\\times \\frac{2}{1}+\\frac{1}{36} \\\\ &= \\frac{5\\times 2}{36\\times 1}+\\frac{1}{36} \\\\ &= \\frac{10}{36}+\\frac{1}{36} \\\\ &= \\frac{10+1}{36} \\\\ &= \\frac{11}{36}\\end{aligned}\n$$" "To evaluate the given expression, we use PEMDAS.\n\nFirst, we compute the expression inside the parentheses:\n\n$$\n\\frac{5}{36}\\times 2+(5+1)^{-2}=\\frac{5}{36}\\times 2+{6}^{-2}\n$$\n\nNext, notice that $$\n\\displaystyle {6}^{-2}=\\frac{1}{{6}^{2}}=\\frac{1}{36}.\n$$ So, we obtain:\n\n$$\n\\begin{aligned}\\frac{5}{36}\\times 2+{6}^{-2} &= \\frac{5}{36}\\times 2+\\frac{1}{36} \\\\ &= \\frac{5}{36}\\times \\frac{2}{1}+\\frac{1}{36} \\\\ &= \\frac{5\\times 2}{36\\times 1}+\\frac{1}{36} \\\\ &= \\frac{10}{36}+\\frac{1}{36} \\\\ &= \\frac{10+1}{36} \\\\ &= \\frac{11}{36}\\end{aligned}\n$$"] [:db/cas 17592186481376 :question/problem "$\\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 4 \\\\ 6\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6 \\\\ 9\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10 \\\\ -15\\end{bmatrix}\\})=$" "$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 4 \\\\ 6\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6 \\\\ 9\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10 \\\\ -15\\end{bmatrix}\\})=\n$$"] [:db/cas 17592186481376 :question/worked-solution "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-2 & -3 & 5 \\\\ 4 & 6 & -10 \\\\ 6 & 9 & -15\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -3 & 5 \\\\ 0 & 0 & 0 \\\\ 6 & 9 & -15\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -3 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $1$ pivot column (or alternatively, it has exactly $1$ non-zero row). \n\nTherefore, \n$\\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 4 \\\\ -6\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6 \\\\ 9\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10 \\\\ -15\\end{bmatrix}\\})=1.$" "We start by creating a matrix whose columns are made up of our vectors, and then we reduce the matrix to row echelon form:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-2 & -3 & 5 \\\\ 4 & 6 & -10 \\\\ 6 & 9 & -15\\end{bmatrix} & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -3 & 5 \\\\ 0 & 0 & 0 \\\\ 6 & 9 & -15\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}-2 & -3 & 5 \\\\ 0 & 0 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to basis vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the reduced matrix has $1$ pivot column (or alternatively, it has exactly $1$ non-zero row). \n\nTherefore, \n$$\n\\displaystyle \\text{dim}(\\text{Span}\\{\\begin{bmatrix}-2 \\\\ 4 \\\\ -6\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 6 \\\\ 9\\end{bmatrix},\\begin{bmatrix}5 \\\\ -10 \\\\ -15\\end{bmatrix}\\})=1.\n$$"] [:db/cas 17592186481418 :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}y{cos}^{2}⁡(y-x)\\,dxdy,\n$$\n\n \nwhere $D=\\{(x,y)\\,:\\,|y-x|\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2}\\}.$" "Use a change of variables to evaluate the double integral \n\n$$\n{∬}_{D}y{cos}^{2}⁡(y-x)\\,dxdy,\n$$\n\n \nwhere $$\n\\displaystyle D=\\{(x,y)\\,:\\,|y-x|\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{2}\\}.\n$$"] [:db/cas 17592186481433 :question/worked-solution "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot (-1)+7\\cdot 1+2\\cdot 3}{(-1)^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- ${u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{3}^{2}}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix}.$\n\n- ${u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{3}^{2}+{6}^{2}+(-1)^{2}}}\\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{bmatrix}.$\n\nTherefore, $B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix},\\begin{bmatrix}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{bmatrix}\\}$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{3\\sqrt{46}}{46},$ $b=\\frac{3\\sqrt{46}}{23},$ $c=-\\frac{\\sqrt{46}}{46}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{3\\sqrt{46}}{46}|+|\\frac{3\\sqrt{46}}{23}|+|-\\frac{\\sqrt{46}}{46}|=\\frac{5\\sqrt{46}}{23}.\n$$" "First, let's denote\n\n$\\,$ ${a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}\\,$ and $\\,{a}_{2}=\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}.$ \n\nWe proceed to find an orthogonal basis using the Gram-Schmidt process, as follows.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}.$\n\n**Step 2**: Next, we find ${v}_{2}$, by using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{2}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-\\frac{2\\cdot (-1)+7\\cdot 1+2\\cdot 3}{(-1)^{2}+{1}^{2}+{3}^{2}}{v}_{1} \\\\  & =\\begin{bmatrix}2 \\\\ 7 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize each vector to get an orthonormal basis:\n\n- $$\n\\displaystyle {u}_{1}=\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{(-1)^{2}+{1}^{2}+{3}^{2}}}\\begin{bmatrix}-1 \\\\ 1 \\\\ 3\\end{bmatrix}=\\begin{bmatrix}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix}.\n$$\n\n- $$\n\\displaystyle {u}_{2}=\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{{3}^{2}+{6}^{2}+(-1)^{2}}}\\begin{bmatrix}3 \\\\ 6 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{bmatrix}.\n$$\n\nTherefore, $$\n\\displaystyle B=\\{{u}_{1},{u}_{2}\\}=\\{\\begin{bmatrix}\\frac{-\\sqrt{11}}{11} \\\\ \\frac{\\sqrt{11}}{11} \\\\ \\frac{3\\sqrt{11}}{11}\\end{bmatrix},\\begin{bmatrix}\\frac{3\\sqrt{46}}{46} \\\\ \\frac{3\\sqrt{46}}{23} \\\\ -\\frac{\\sqrt{46}}{46}\\end{bmatrix}\\}\n$$ is an orthonormal basis of $V.$\n\nFinally, $a=\\frac{3\\sqrt{46}}{46},$ $b=\\frac{3\\sqrt{46}}{23},$ $c=-\\frac{\\sqrt{46}}{46}$ and  \n\n$$\n|a|+|b|+|c|=|\\frac{3\\sqrt{46}}{46}|+|\\frac{3\\sqrt{46}}{23}|+|-\\frac{\\sqrt{46}}{46}|=\\frac{5\\sqrt{46}}{23}.\n$$"] [:db/cas 17592186481762 :question/worked-solution "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[2\\sqrt{x-1}]}_{2}^{a} \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2\\sqrt{2-1}) \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}\\frac{1}{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\operatorname{ln}⁡|x|]}_{a}^{-1} \\\\  & ={lim}_{a\\to -\\infty }(\\operatorname{ln}⁡|-1|-\\operatorname{ln}⁡|a|) \\\\  & =-\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{x}]}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{a}+\\frac{1}{1}) \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent.\n\nIn conclusion, only integrals ${\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x$ and ${\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x$ are divergent." "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[2\\sqrt{x-1}]}_{2}^{a} \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2\\sqrt{2-1}) \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}\\frac{1}{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\operatorname{ln}⁡|x|]}_{a}^{-1} \\\\  & ={lim}_{a\\to -\\infty }(\\operatorname{ln}⁡|-1|-\\operatorname{ln}⁡|a|) \\\\  & =-\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{x}]}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{a}+\\frac{1}{1}) \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent.\n\nIn conclusion, only integrals $$\n\\displaystyle {\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x\n$$ and $$\n\\displaystyle {\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x\n$$ are divergent."] [:db/cas 17592186482544 :question/problem "![](images/a6/a68077b18f8c08fc7cd68889b6472373c7677bcfcb6f370abce1e93cf67c4594.png)\n\nIf $D$ is the finite region enclosed by the line $x=0,$ and the curves $y=5-{x}^{2}$ and $y=-\\frac{1}{2}x,$ as shown above, then ${∬}_{D}x\\operatorname{ln}⁡(y+1)\\,dA=$" "![](images/a6/a68077b18f8c08fc7cd68889b6472373c7677bcfcb6f370abce1e93cf67c4594.png)\n\nIf $D$ is the finite region enclosed by the line $x=0,$ and the curves $y=5-{x}^{2}$ and $y=-\\frac{1}{2}x,$ as shown above, then $$\n\\displaystyle {∬}_{D}x\\operatorname{ln}⁡(y+1)\\,dA=\n$$"] [:db/cas 17592186482584 :question/problem "Let $D$ be a finite region enclosed by the curves $y=2{x}^{2}+1$ and $y=3.$ If $R=[-1,1]\\times [1,3],$ and\n\n$$\n{∬}_{D}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nII. $\\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}$" "Let $D$ be a finite region enclosed by the curves $y=2{x}^{2}+1$ and $y=3.$ If $R=[-1,1]\\times [1,3],$ and\n\n$$\n{∬}_{D}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡y)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $$\n\\displaystyle \\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$\n\nII. $$\n\\displaystyle \\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in R\\cap D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}\n$$\n\nIII. $$\n\\displaystyle \\{\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡y, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D\\end{aligned}\n$$"] [:db/cas 17592186482597 :question/problem "![](images/f5/f5f6dae762414eb327b9eae9e5445ef1916e9efc0e17c1316339bbeb416ec94e.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}(y-x)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $\\{\\begin{aligned}y-x, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$\n\nII. $\\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ y-x, & (x,y)\\in D\\end{aligned}$\n\nIII. $\\{\\begin{aligned}y-x, & (x,y)\\in R∖D, \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$" "![](images/f5/f5f6dae762414eb327b9eae9e5445ef1916e9efc0e17c1316339bbeb416ec94e.png)\n\nConsider the region $D$ shown above. If $R=[-2,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}(y-x)\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\nI. $$\n\\displaystyle \\{\\begin{aligned}y-x, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}\n$$\n\nII. $$\n\\displaystyle \\{\\begin{aligned}0, & (x,y)\\in R∖D \\\\ y-x, & (x,y)\\in D\\end{aligned}\n$$\n\nIII. $$\n\\displaystyle \\{\\begin{aligned}y-x, & (x,y)\\in R∖D, \\\\ 0, & (x,y)\\in D∖R\\end{aligned}\n$$"] [:db/cas 17592186482716 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{\\pi}{20}}9 \\sin{\\left(10 x \\right)}\\,\\text{d}x=$\n\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\frac{\\pi}{20}}9 \\sin{\\left(10 x \\right)}\\,\\text{d}x=\n$$\n\n{{field-1}}"] [:db/cas 17592186482718 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{1}{4}}\\cos{\\left(2 \\pi x \\right)}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\frac{1}{4}}\\cos{\\left(2 \\pi x \\right)}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186482722 :question/problem "Calculate ${\\int }_{0}^{\\frac{\\pi}{27}}\\sin{\\left(9 x + \\frac{\\pi}{3} \\right)}\\,\\text{d}x.$" "Calculate $$\n\\displaystyle {\\int }_{0}^{\\frac{\\pi}{27}}\\sin{\\left(9 x + \\frac{\\pi}{3} \\right)}\\,\\text{d}x.\n$$"] [:db/cas 17592186482724 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\frac{\\pi}{48}}9 \\sin{\\left(24 x \\right)}\\,\\text{d}x=$\n\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\frac{\\pi}{48}}9 \\sin{\\left(24 x \\right)}\\,\\text{d}x=\n$$\n\n{{field-1}}"] [:db/cas 17592186482728 :question/problem "What is $\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displaystyle \\int\\frac{\\csch^{2} x}{7\\coth x + 1}dx$?" "What is $$\n\\displaystyle \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displaystyle \\int\\frac{\\csch^{2} x}{7\\coth x + 1}dx\n$$?"] [:db/cas 17592186482739 :question/problem "What is $\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\displayst