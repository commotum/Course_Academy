y}\\right)}_{(3,\\,3)} \\\\  & =\\frac{3\\cdot 3}{2\\cdot 3} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is $$\n\\displaystyle {m}^{'}=-\\frac{1}{m}=-\\frac{1}{3/2}=-\\frac{2}{3}.\n$$ We can write the equation of the normal at the point $(3,\\,3)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & ={m}^{'}(x-{x}_{1}) \\\\ (y-3) & =-\\frac{2}{3}(x-3) \\\\ y & =-\\frac{2}{3}(x-3)+3\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}(x-3)+3 \\\\ y & =-\\frac{2}{3}(0-3)+3 \\\\ y & =-\\frac{2}{3}(-3)+3 \\\\ y & =2+3 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,5).$" 13194139539078 17592186576411 true] [17592186234142 1074 "First of all, we need to find the slope of the normal line at the point $(3,\\,3).$  Remember that the slope of the normal line, ${m}^{'},$ is the negative reciprocal of the slope of the tangent line:\n\n$$\n{m}^{'}=-\\frac{1}{m}\n$$\n\nTo find the slope of the tangent line, we will calculate the derivative using implicit differentiation, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}-2{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(9) \\\\ \\frac{\\text{d}}{\\text{d}x}(3{x}^{2})-\\frac{\\text{d}}{\\text{d}x}(2{y}^{2}) & =0 \\\\ 6x-4y\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ -4y\\frac{\\text{d}y}{\\text{d}x} & =-6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{-6x}{-4y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3x}{2y}\\end{aligned}\n$$\n\nSo, the slope of the tangent at the point $(3,\\,3)$ is \n\n$$\n\\begin{aligned}m & ={\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)}_{(3,\\,3)} \\\\  & ={\\left(\\frac{3x}{2y}\\right)}_{(3,\\,3)} \\\\  & =\\frac{3\\cdot 3}{2\\cdot 3} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line is ${m}^{'}=-\\frac{1}{m}=-\\frac{1}{3/2}=-\\frac{2}{3}.$ We can write the equation of the normal at the point $(3,\\,3)$ as follows:\n\n$$\n\\begin{aligned}(y-{y}_{1}) & ={m}^{'}(x-{x}_{1}) \\\\ (y-3) & =-\\frac{2}{3}(x-3) \\\\ y & =-\\frac{2}{3}(x-3)+3\\end{aligned}\n$$\n\nNow, we just need to find where this normal line intersects the $y$-axis. At the point $P$ the $x$-coordinate is $0,$ so we set $x=0$ and solve for $y:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}(x-3)+3 \\\\ y & =-\\frac{2}{3}(0-3)+3 \\\\ y & =-\\frac{2}{3}(-3)+3 \\\\ y & =2+3 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the coordinates of $P$ are $(0,\\,5).$" 13194139539078 17592186576411 false] [17592186234166 1074 "First, we find an angle that's coterminal with $\\frac{17\\pi }{6}$ by *subtracting* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $$\n\\displaystyle \\frac{17\\pi }{6}-2\\pi =\\frac{5\\pi }{6}\\,✓\n$$\n\nSo the angle $\\frac{17\\pi }{6}$ is coterminal with $\\frac{5\\pi }{6}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](images/1c/1c7c1d3a8d69502521dc71f24335ff79e707867161b95d6a80eaf95c0bf6e36c.png)\n\nWe see that $\\frac{5\\pi }{6}$ lies in quadrant II. Therefore, $\\frac{17\\pi }{6}$ also lies in this quadrant." 13194139539078 17592186576411 true] [17592186234166 1074 "First, we find an angle that's coterminal with $\\frac{17\\pi }{6}$ by *subtracting* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $\\frac{17\\pi }{6}-2\\pi =\\frac{5\\pi }{6}\\,✓$\n\nSo the angle $\\frac{17\\pi }{6}$ is coterminal with $\\frac{5\\pi }{6}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](images/1c/1c7c1d3a8d69502521dc71f24335ff79e707867161b95d6a80eaf95c0bf6e36c.png)\n\nWe see that $\\frac{5\\pi }{6}$ lies in quadrant II. Therefore, $\\frac{17\\pi }{6}$ also lies in this quadrant." 13194139539078 17592186576411 false] [17592186234167 1074 "First, we find an angle that's coterminal with $-\\frac{4\\pi }{3