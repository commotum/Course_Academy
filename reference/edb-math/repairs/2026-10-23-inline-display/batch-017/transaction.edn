e}^{2t+2}-3(\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D) \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2}+C,\\end{aligned}\n$$\n\nwhere $C=-3D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =(\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2})\\,{|}_{0}^{1} \\\\  & =(\\frac{3}{2}({1}^{2}){e}^{2(1)+2}-\\frac{3}{2}(1){e}^{2(1)+2}+\\frac{3}{4}{e}^{2(1)+2})-(\\frac{3}{2}({0}^{2}){e}^{2(0)+2}-\\frac{3}{2}(0){e}^{2(0)+2}+\\frac{3}{4}{e}^{2(0)+2}) \\\\  & =\\frac{3}{4}{e}^{4}-\\frac{3}{4}{e}^{2} \\\\  & =\\frac{3{e}^{4}-3{e}^{2}}{4}\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}=3{e}^{2t+2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int 3{e}^{2t+2}\\,\\text{d}t=\\frac{3}{2}{e}^{2t+2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2})(\\frac{3}{2}{e}^{2t+2})-\\int (\\frac{3}{2}{e}^{2t+2})(2t)\\,\\text{d}t \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3\\int t{e}^{2t+2}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int t{e}^{2t+2}\\,\\text{d}t.\n$$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+2}\\,\\text{d}t=\\frac{1}{2}{e}^{2t+2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t{e}^{2t+2}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{1}{2}{e}^{2t+2})-\\int (\\frac{1}{2}{e}^{2t+2})(1)\\,\\text{d}t \\\\  & =\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{2}\\int {e}^{2t+2}\\,\\text{d}t \\\\  & =\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3\\int t{e}^{2t+2}\\,\\text{d}t \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3(\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D) \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2}+C,\\end{aligned}\n$$\n\nwhere $C=-3D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =(\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2})\\,{|}_{0}^{1} \\\\  & =(\\frac{3}{2}({1}^{2}){e}^{2(1)+2}-\\frac{3}{2}(1){e}^{2(1)+2}+\\frac{3}{4}{e}^{2(1)+2})-(\\frac{3}{2}({0}^{2}){e}^{2(0)+2}-\\frac{3}{2}(0){e}^{2(0)+2}+\\frac{3}{4}{e}^{2(0)+2}) \\\\  & =\\frac{3}{4}{e}^{4}-\\frac{3}{4}{e}^{2} \\\\  & =\\frac{3{e}^{4}-3{e}^{2}}{4}\\end{aligned}\n$$"] [:db/cas 17592186320934 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y=\n$$\n{{field-1}}"] [:db/cas 17592186320934 :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+3\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+3)\\left(\\frac{{e}^{2y-1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y-1}}{2}\\right)(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int y\\,{e}^{2y-1}\\,\\text{d}y.$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)\\left(\\frac{{e}^{2y-1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y-1}}{2}\\right)(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{1}{2}\\int {e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-(\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D) \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\frac{y\\,{e}^{2y-1}}{2}+\\frac{{e}^{2y-1}}{4}-D \\\\  & =\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & ={[\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)]}_{1}^{2} \\\\  & =(\\frac{{e}^{2(2)-1}}{4}(2(2)^{2}-2(2)+7))-(\\frac{{e}^{2(1)-1}}{4}(2(1)^{2}-2(1)+7)) \\\\  & =\\frac{{e}^{3}}{4}(8-4+7)-\\frac{e}{4}(2-2+7) \\\\  & =\\frac{11{e}^{3}}{4}-\\frac{7e}{4} \\\\  & =\\frac{11{e}^{3}-7e}{4}\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+3\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+3)\\left(\\frac{{e}^{2y-1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y-1}}{2}\\right)(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int y\\,{e}^{2y-1}\\,\\text{d}y.\n$$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)\\left(\\frac{{e}^{2y-1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y-1}}{2}\\right)(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{1}{2}\\int {e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-(\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D) \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\frac{y\\,{e}^{2y-1}}{2}+\\frac{{e}^{2y-1}}{4}-D \\\\  & =\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & ={[\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)]}_{1}^{2} \\\\  & =(\\frac{{e}^{2(2)-1}}{4}(2(2)^{2}-2(2)+7))-(\\frac{{e}^{2(1)-1}}{4}(2(1)^{2}-2(1)+7)) \\\\  & =\\frac{{e}^{3}}{4}(8-4+7)-\\frac{e}{4}(2-2+7) \\\\  & =\\frac{11{e}^{3}}{4}-\\frac{7e}{4} \\\\  & =\\frac{11{e}^{3}-7e}{4}\\end{aligned}\n$$"] [:db/cas 17592186320935 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y=\n$$\n{{field-1}}"] [:db/cas 17592186320935 :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+4\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+4)\\left(\\frac{{e}^{2y+1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y+1}}{2}\\right)(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int y\\,{e}^{2y+1}\\,\\text{d}y.$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)\\left(\\frac{{e}^{2y+1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y+1}}{2}\\right)(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{1}{2}\\int {e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-(\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D) \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\frac{y\\,{e}^{2y+1}}{2}+\\frac{{e}^{2y+1}}{4}-D \\\\  & =\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & ={[\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)]}_{0}^{2} \\\\  & =(\\frac{{e}^{2(2)+1}}{4}(2(2)^{2}-2(2)+9))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+9)) \\\\  & =\\frac{{e}^{5}}{4}(8-4+9)-\\frac{e}{4}(0-0+9) \\\\  & =\\frac{13{e}^{5}}{4}-\\frac{9e}{4} \\\\  & =\\frac{13{e}^{5}-9e}{4}\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+4\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+4)\\left(\\frac{{e}^{2y+1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y+1}}{2}\\right)(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int y\\,{e}^{2y+1}\\,\\text{d}y.\n$$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)\\left(\\frac{{e}^{2y+1}}{2}\\right)-\\int \\left(\\frac{{e}^{2y+1}}{2}\\right)(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{1}{2}\\int {e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-(\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D) \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\frac{y\\,{e}^{2y+1}}{2}+\\frac{{e}^{2y+1}}{4}-D \\\\  & =\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & ={[\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)]}_{0}^{2} \\\\  & =(\\frac{{e}^{2(2)+1}}{4}(2(2)^{2}-2(2)+9))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+9)) \\\\  & =\\frac{{e}^{5}}{4}(8-4+9)-\\frac{e}{4}(0-0+9) \\\\  & =\\frac{13{e}^{5}}{4}-\\frac{9e}{4} \\\\  & =\\frac{13{e}^{5}-9e}{4}\\end{aligned}\n$$"] [:db/cas 17592186320938 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi }(5{x}^{2}+7)\\operatorname{sin}⁡x\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi }(5{x}^{2}+7)\\operatorname{sin}⁡x\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320938 :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=5{x}^{2}+7\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=10x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int (5{x}^{2}+7)\\operatorname{sin}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(5{x}^{2}+7)(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)(10x)\\,\\text{d}x \\\\  & =-(5{x}^{2}+7)\\operatorname{cos}⁡x+10\\int x\\operatorname{cos}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{cos}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x & \\,⟹\\,v=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x\\operatorname{sin}⁡x-\\int \\operatorname{sin}⁡x\\,dx \\\\  & =x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int (5{x}^{2}+7)\\operatorname{sin}⁡x\\,\\text{d}x & =-(5{x}^{2}+7)\\operatorname{cos}⁡x+10\\int x\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =-(5{x}^{2}+7)\\operatorname{cos}⁡x+10(x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+D) \\\\  & =-(5{x}^{2}+7)\\operatorname{cos}⁡x+10x\\operatorname{sin}⁡x+10\\operatorname{cos}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=10D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }(5{x}^{2}+7)\\operatorname{sin}⁡x\\,\\text{d}x & ={[-(5{x}^{2}+7)\\operatorname{cos}⁡x+10x\\operatorname{sin}⁡x+10\\operatorname{cos}⁡x]}_{0}^{\\pi } \\\\  & =(-(5{\\pi }^{2}+7)\\operatorname{cos}⁡\\pi +10\\pi \\operatorname{sin}⁡\\pi +10\\operatorname{cos}⁡\\pi )-(-7\\operatorname{cos}⁡0+10(0)\\operatorname{sin}⁡0+10\\operatorname{cos}⁡0) \\\\  & =(5{\\pi }^{2}+7-10)-(-7+10) \\\\  & =5{\\pi }^{2}-3-3 \\\\  & =5{\\pi }^{2}-6\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=5{x}^{2}+7\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=10x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\