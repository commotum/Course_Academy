+n-1}.\n$$\n\nNow, isolating the $n=0$ terms for the other terms in the ODE, we have\n\n$$\n\\begin{aligned}8x{y}^{″} & =8({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda -1}+{\\sum }_{n=1}^{\\infty }8((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n-1}, \\\\ -2{y}^{′} & =-2\\lambda {a}_{0}{x}^{\\lambda -1}-{\\sum }_{n=1}^{\\infty }2(\\lambda +n){a}_{n}{x}^{\\lambda +n-1}.\\end{aligned}\n$$\n\n**Step 4**: Consolidate all the series into a single series that is equal to $0.$\n\nCollecting the terms for $n=0,$ we have\n\n$$\n\\begin{aligned}8({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda -1}-2\\lambda {a}_{0}{x}^{\\lambda -1} &= (8{\\lambda }^{2}-8\\lambda -2\\lambda ){a}_{0}{x}^{\\lambda -1} \\\\ &= (8{\\lambda }^{2}-10\\lambda ){a}_{0}{x}^{\\lambda -1}.\\end{aligned}\n$$\n\nSimilarly, collecting terms for $n\\ge 1,$ we obtain an infinite series of the form $$\n\\displaystyle {x}^{\\lambda -1}{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n},\n$$ for some ${b}_{n}(\\lambda ),$ $n\\ge 1.$\nTherefore, substituting into the homogeneous ODE, we have\n\n$$\n\\begin{aligned}(8{\\lambda }^{2}-10\\lambda ){a}_{0}{x}^{\\lambda -1}+{x}^{\\lambda -1}{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0 \\\\ 2(4{\\lambda }^{2}-5\\lambda ){a}_{0}+{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0.\\end{aligned}\n$$\n\n**Step 5**:  Set the coefficients of the series equal to $0.$\n\nSetting the coefficients of the $n=0$ term equal to $0$ with arbitrary ${a}_{0}\\ne 0,$ we obtain the indicial equation:\n\n$$\n\\begin{aligned}2(4{\\lambda }^{2}-5\\lambda ){a}_{0} & =0 \\\\ 4{\\lambda }^{2}-5\\lambda  & =0\\end{aligned}\n$$"] [:db/cas 17592186318985 :question/worked-solution "If $x=0$ is a regular singular point of a second-order homogeneous linear differential equation, then the method of Frobenius states that there is at least one solution of the form\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n},\n$$\n\nwhere $\\lambda $ and ${a}_{n}$ for $n=0,1,2,…$ are constants.\n\nSubstituting this solution and its derivatives into the ODE, collecting like terms, and setting coefficients equal to zero, we obtain: \n\n- the indicial equation from the coefficients of the $n=0$ term for arbitrary ${a}_{0},$ and\n\n- a recurrence formula from the coefficients of the $n\\ge 1$ terms.\n\n**Step 1**: Write the solution $y$ as a Frobenius power series:\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n}\n$$\n\n**Step 2**: Compute the derivatives ${y}^{′}$ and ${y}^{″}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\ {y}^{″} & ={({\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2}\\end{aligned}\n$$\n\n**Step 3**: Rewrite all the series in the equation so that they use the same index of summation, the powers of $x$ are the same, and the indices start at the same value.\n\nThe terms of the differential equation are\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & ={x}^{2}\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2} \\\\  & ={\\sum }_{n=0}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 3x(x-3){y}^{′} & =(3{x}^{2}-9x)\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\  & ={\\sum }_{n=0}^{\\infty }3(\\lambda +n){a}_{n}{x}^{\\lambda +n+1}-{\\sum }_{n=0}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n}, \\\\ -6y & =-{\\sum }_{n=0}^{\\infty }6{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nIn the first sum of the ${y}^{′}$ term, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n3x(x-3){y}^{′}={\\sum }_{m=1}^{\\infty }3(\\lambda +m-1){a}_{m-1}{x}^{\\lambda +m}-{\\sum }_{n=0}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n}.\n$$\n\nThen, replacing $m$ with $n$ (since it does not matter which letter we use) and isolating the $n=0$ term gives\n\n$$\n\\begin{aligned}3x(x-3){y}^{′} & ={\\sum }_{n=1}^{\\infty }3(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-{\\sum }_{n=0}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & ={\\sum }_{n=1}^{\\infty }3(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-9\\lambda {a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & =-9\\lambda {a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }[3(\\lambda +n-1){a}_{n-1}-9(\\lambda +n){a}_{n}]{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nSimilarly, isolating the $n=0$ terms for the other terms in the ODE, we have\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & =({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ -6y & =-6{a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }6{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\n**Step 4**: Consolidate all the series into a single series that is equal to $0.$\n\nCollecting the terms for $n=0,$ we have\n\n$$\n\\begin{aligned}({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }-9\\lambda {a}_{0}{x}^{\\lambda }-6{a}_{0}{x}^{\\lambda } &= ({\\lambda }^{2}-\\lambda -9\\lambda -6){a}_{0}{x}^{\\lambda } \\\\ &= ({\\lambda }^{2}-10\\lambda -6){a}_{0}{x}^{\\lambda }.\\end{aligned}\n$$\n\nSimilarly, collecting terms for $n\\ge 1,$ we obtain an infinite series of the form\n${x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n},$\nfor some ${b}_{n}(\\lambda ),$ $n\\ge 1.$\nTherefore, substituting into the homogeneous ODE, we have\n\n$$\n\\begin{aligned}({\\lambda }^{2}-10\\lambda -6){a}_{0}{x}^{\\lambda }+{x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0 \\\\ ({\\lambda }^{2}-10\\lambda -6){a}_{0}+{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0.\\end{aligned}\n$$\n\n**Step 5**:  Set the coefficients of the series equal to $0.$\n\nSetting the coefficient of the $n=0$ term equal to $0$ with arbitrary ${a}_{0}\\ne 0,$ we obtain the indicial equation:\n\n$$\n\\begin{aligned}({\\lambda }^{2}-10\\lambda -6){a}_{0} & =0 \\\\ {\\lambda }^{2}-10\\lambda -6 & =0\\end{aligned}\n$$" "If $x=0$ is a regular singular point of a second-order homogeneous linear differential equation, then the method of Frobenius states that there is at least one solution of the form\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n},\n$$\n\nwhere $\\lambda $ and ${a}_{n}$ for $n=0,1,2,…$ are constants.\n\nSubstituting this solution and its derivatives into the ODE, collecting like terms, and setting coefficients equal to zero, we obtain: \n\n- the indicial equation from the coefficients of the $n=0$ term for arbitrary ${a}_{0},$ and\n\n- a recurrence formula from the coefficients of the $n\\ge 1$ terms.\n\n**Step 1**: Write the solution $y$ as a Frobenius power series:\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n}\n$$\n\n**Step 2**: Compute the derivatives ${y}^{′}$ and ${y}^{″}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\ {y}^{″} & ={({\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2}\\end{aligned}\n$$\n\n**Step 3**: Rewrite all the series in the equation so that they use the same index of summation, the powers of $x$ are the same, and the indices start at the same value.\n\nThe terms of the differential equation are\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & ={x}^{2}\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2} \\\\  & ={\\sum }_{n=0}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 3x(x-3){y}^{′} & =(3{x}^{2}-9x)\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\  & ={\\sum }_{n=0}^{\\infty }3(\\lambda +n){a}_{n}{x}^{\\lambda +n+1}-{\\sum }_{n=0}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n}, \\\\ -6y & =-{\\sum }_{n=0}^{\\infty }6{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nIn the first sum of the ${y}^{′}$ term, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n3x(x-3){y}^{′}={\\sum }_{m=1}^{\\infty }3(\\lambda +m-1){a}_{m-1}{x}^{\\lambda +m}-{\\sum }_{n=0}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n}.\n$$\n\nThen, replacing $m$ with $n$ (since it does not matter which letter we use) and isolating the $n=0$ term gives\n\n$$\n\\begin{aligned}3x(x-3){y}^{′} & ={\\sum }_{n=1}^{\\infty }3(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-{\\sum }_{n=0}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & ={\\sum }_{n=1}^{\\infty }3(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-9\\lambda {a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }9(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & =-9\\lambda {a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }[3(\\lambda +n-1){a}_{n-1}-9(\\lambda +n){a}_{n}]{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nSimilarly, isolating the $n=0$ terms for the other terms in the ODE, we have\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & =({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ -6y & =-6{a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }6{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\n**Step 4**: Consolidate all the series into a single series that is equal to $0.$\n\nCollecting the terms for $n=0,$ we have\n\n$$\n\\begin{aligned}({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }-9\\lambda {a}_{0}{x}^{\\lambda }-6{a}_{0}{x}^{\\lambda } &= ({\\lambda }^{2}-\\lambda -9\\lambda -6){a}_{0}{x}^{\\lambda } \\\\ &= ({\\lambda }^{2}-10\\lambda -6){a}_{0}{x}^{\\lambda }.\\end{aligned}\n$$\n\nSimilarly, collecting terms for $n\\ge 1,$ we obtain an infinite series of the form\n$$\n\\displaystyle {x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n},\n$$\nfor some ${b}_{n}(\\lambda ),$ $n\\ge 1.$\nTherefore, substituting into the homogeneous ODE, we have\n\n$$\n\\begin{aligned}({\\lambda }^{2}-10\\lambda -6){a}_{0}{x}^{\\lambda }+{x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0 \\\\ ({\\lambda }^{2}-10\\lambda -6){a}_{0}+{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0.\\end{aligned}\n$$\n\n**Step 5**:  Set the coefficients of the series equal to $0.$\n\nSetting the coefficient of the $n=0$ term equal to $0$ with arbitrary ${a}_{0}\\ne 0,$ we obtain the indicial equation:\n\n$$\n\\begin{aligned}({\\lambda }^{2}-10\\lambda -6){a}_{0} & =0 \\\\ {\\lambda }^{2}-10\\lambda -6 & =0\\end{aligned}\n$$"] [:db/cas 17592186318986 :question/worked-solution "If $x=0$ is a regular singular point of a second-order homogeneous linear differential equation, then the method of Frobenius states that there is at least one solution of the form\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n},\n$$\n\nwhere $\\lambda $ and ${a}_{n}$ for $n=0,1,2,…$ are constants.\n\nSubstituting this solution and its derivatives into the ODE, collecting like terms, and setting coefficients equal to zero, we obtain: \n\n- the indicial equation from the coefficients of the $n=0$ term for arbitrary ${a}_{0},$ and\n\n- a recurrence formula from the coefficients of the $n\\ge 1$ terms.\n\n**Step 1**: Write the solution $y$ as a Frobenius power series:\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n}\n$$\n\n**Step 2**: Compute the derivatives ${y}^{′}$ and ${y}^{″}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\ {y}^{″} & ={({\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2}\\end{aligned}\n$$\n\n**Step 3**: Rewrite all the series in the equation so that they use the same index of summation, the powers of $x$ are the same, and the indices start at the same value.\n\nThe terms of the differential equation are\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & ={x}^{2}\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2} \\\\  & ={\\sum }_{n=0}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ -4x(x+7){y}^{′} & =(-4{x}^{2}-28x)\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\  & =-{\\sum }_{n=0}^{\\infty }4(\\lambda +n){a}_{n}{x}^{\\lambda +n+1}-{\\sum }_{n=0}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n}, \\\\ 11y & ={\\sum }_{n=0}^{\\infty }11{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nIn the first sum of the ${y}^{′}$ term, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n-4x(x+7){y}^{′}=-{\\sum }_{m=1}^{\\infty }4(\\lambda +m-1){a}_{m-1}{x}^{\\lambda +m}-{\\sum }_{n=0}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n}.\n$$\n\nThen, replacing $m$ with $n$ (since it does not matter which letter we use) and isolating the $n=0$ term gives\n\n$$\n\\begin{aligned}-4x(x+7){y}^{′} & =-{\\sum }_{n=1}^{\\infty }4(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-{\\sum }_{n=0}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & =-{\\sum }_{n=1}^{\\infty }4(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-28\\lambda {a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & =-28\\lambda {a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }[-4(\\lambda +n-1){a}_{n-1}-28(\\lambda +n){a}_{n}]{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nSimilarly, isolating the $n=0$ terms for the other terms in the ODE, we have\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & =({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 11y & =11{a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }11{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\n**Step 4**: Consolidate all the series into a single series that is equal to $0.$\n\nCollecting the terms for $n=0,$ we have\n\n$$\n\\begin{aligned}({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }-28\\lambda {a}_{0}{x}^{\\lambda }+11{a}_{0}{x}^{\\lambda } &= ({\\lambda }^{2}-\\lambda -28\\lambda +11){a}_{0}{x}^{\\lambda } \\\\ &= ({\\lambda }^{2}-29\\lambda +11){a}_{0}{x}^{\\lambda }.\\end{aligned}\n$$\n\nSimilarly, collecting terms for $n\\ge 1,$ we obtain an infinite series of the form\n${x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n},$\nfor some ${b}_{n}(\\lambda ),$ $n\\ge 1.$\nTherefore, substituting into the homogeneous ODE, we have\n\n$$\n\\begin{aligned}({\\lambda }^{2}-29\\lambda +11){a}_{0}{x}^{\\lambda }+{x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0 \\\\ ({\\lambda }^{2}-29\\lambda +11){a}_{0}+{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0.\\end{aligned}\n$$\n\n**Step 5**:  Set the coefficients of the series equal to $0.$\n\nSetting the coefficient of the $n=0$ term equal to $0$ with arbitrary ${a}_{0}\\ne 0,$ we obtain the indicial equation:\n\n$$\n\\begin{aligned}({\\lambda }^{2}-29\\lambda +11){a}_{0} & =0 \\\\ {\\lambda }^{2}-29\\lambda +11 & =0\\end{aligned}\n$$" "If $x=0$ is a regular singular point of a second-order homogeneous linear differential equation, then the method of Frobenius states that there is at least one solution of the form\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n},\n$$\n\nwhere $\\lambda $ and ${a}_{n}$ for $n=0,1,2,…$ are constants.\n\nSubstituting this solution and its derivatives into the ODE, collecting like terms, and setting coefficients equal to zero, we obtain: \n\n- the indicial equation from the coefficients of the $n=0$ term for arbitrary ${a}_{0},$ and\n\n- a recurrence formula from the coefficients of the $n\\ge 1$ terms.\n\n**Step 1**: Write the solution $y$ as a Frobenius power series:\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n}\n$$\n\n**Step 2**: Compute the derivatives ${y}^{′}$ and ${y}^{″}:$\n\n$$\n\\begin{aligned}{y}^{′} & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{\\lambda +n})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\ {y}^{″} & ={({\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1})}^{′}={\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2}\\end{aligned}\n$$\n\n**Step 3**: Rewrite all the series in the equation so that they use the same index of summation, the powers of $x$ are the same, and the indices start at the same value.\n\nThe terms of the differential equation are\n\n$$\n\\begin{aligned}{x}^{2}{y}^{″} & ={x}^{2}\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n-1)(\\lambda +n){a}_{n}{x}^{\\lambda +n-2} \\\\  & ={\\sum }_{n=0}^{\\infty }((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ -4x(x+7){y}^{′} & =(-4{x}^{2}-28x)\\cdot {\\sum }_{n=0}^{\\infty }(\\lambda +n){a}_{n}{x}^{\\lambda +n-1} \\\\  & =-{\\sum }_{n=0}^{\\infty }4(\\lambda +n){a}_{n}{x}^{\\lambda +n+1}-{\\sum }_{n=0}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n}, \\\\ 11y & ={\\sum }_{n=0}^{\\infty }11{a}_{n}{x}^{\\lambda +n}.\\end{aligned}\n$$\n\nIn the first sum of the ${y}^{′}$ term, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n-4x(x+7){y}^{′}=-{\\sum }_{m=1}^{\\infty }4(\\lambda +m-1){a}_{m-1}{x}^{\\lambda +m}-{\\sum }_{n=0}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n}.\n$$\n\nThen, replacing $m$ with $n$ (since it does not matter which letter we use) and isolating the $n=0$ term gives\n\n$$\n\\begin{aligned}-4x(x+7){y}^{′} & =-{\\sum }_{n=1}^{\\infty }4(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-{\\sum }_{n=0}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\  & =-{\\sum }_{n=1}^{\\infty }4(\\lambda +n-1){a}_{n-1}{x}^{\\lambda +n}-28\\lambda {a}_{0}{x}^{\\lambda }-{\\sum }_{n=1}^{\\infty }28(\\lambda +n){a}_{n}{x}^{\\lambda +n}