d-1}}\n$)\\operatorname{ln}⁡3$"] [:db/cas 17592186320814 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x=($\n{{field-1}}\n$)\\,\\operatorname{ln}⁡5$" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{5}^{125}\\frac{8}{3x{log}_{5}⁡({x}^{2})}\\,\\text{d}x=(\n$$\n{{field-1}}\n$)\\,\\operatorname{ln}⁡5$"] [:db/cas 17592186320815 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320816 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\sqrt{3}}^{\\infty }\\frac{12}{1+{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\sqrt{3}}^{\\infty }\\frac{12}{1+{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320817 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\sqrt{3}/3}^{\\infty }\\frac{8}{1+{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{\\sqrt{3}/3}^{\\infty }\\frac{8}{1+{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320818 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{8}{1+16{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\infty }\\frac{8}{1+16{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320819 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x=$\n\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x=\n$$\n\n{{field-1}}"] [:db/cas 17592186320821 :question/problem "Find the range of values of $k$ for which the series\n${\\sum }_{n=1}^{\\infty }{\\left(\\frac{9}{{81}^{k}}\\right)}^{n}$\nconverges. Do not round the answer.\n\n$k$\n{{field-1}}{{field-2}}" "Find the range of values of $k$ for which the series\n$$\n\\displaystyle {\\sum }_{n=1}^{\\infty }{\\left(\\frac{9}{{81}^{k}}\\right)}^{n}\n$$\nconverges. Do not round the answer.\n\n$k$\n{{field-1}}{{field-2}}"] [:db/cas 17592186320822 :question/problem "Find the range of values of $k$ for which the series\n${\\sum }_{n=1}^{\\infty }\\frac{{3}^{6n}}{{9}^{kn}}$\nconverges. Do not round the answer.\n\n$k$\n{{field-1}}{{field-2}}" "Find the range of values of $k$ for which the series\n$$\n\\displaystyle {\\sum }_{n=1}^{\\infty }\\frac{{3}^{6n}}{{9}^{kn}}\n$$\nconverges. Do not round the answer.\n\n$k$\n{{field-1}}{{field-2}}"] [:db/cas 17592186320822 :question/worked-solution "First, we rewrite the series so that it's in the form ${\\sum }_{n=1}^{\\infty }a{r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{{3}^{6n}}{{9}^{kn}} & ={\\sum }_{n=1}^{\\infty }{\\left(\\frac{{3}^{6}}{{9}^{k}}\\right)}^{n} \\\\  & ={\\sum }_{n=1}^{\\infty }{\\left(\\frac{{9}^{3}}{{9}^{k}}\\right)}^{n} \\\\  & ={\\sum }_{n=1}^{\\infty }{({9}^{3-k})}^{n}\\end{aligned}\n$$\n\nWe see that this is a geometric series with a common ratio of $r={9}^{3-k}.$ \n\nFor the series to converge, we require $|r|<1.$ Therefore, we have\n\n$$\n\\begin{aligned}|{9}^{3-k}| & <1 \\\\ {9}^{3-k} & <1.\\end{aligned}\n$$\n\nNotice that we could remove the absolute value bars because ${9}^{3-k}$ is always positive.\n\nThe equation ${9}^{3-k}=1$ has the solution $k=3.$ Now, since ${9}^{3-k}$ decreases as $k$ increases, the solution to ${9}^{3-k}<1$ must be $k>3.$" "First, we rewrite the series so that it's in the form $$\n\\displaystyle {\\sum }_{n=1}^{\\infty }a{r}^{n},\n$$ as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }\\frac{{3}^{6n}}{{9}^{kn}} & ={\\sum }_{n=1}^{\\infty }{\\left(\\frac{{3}^{6}}{{9}^{k}}\\right)}^{n} \\\\  & ={\\sum }_{n=1}^{\\infty }{\\left(\\frac{{9}^{3}}{{9}^{k}}\\right)}^{n} \\\\  & ={\\sum }_{n=1}^{\\infty }{({9}^{3-k})}^{n}\\end{aligned}\n$$\n\nWe see that this is a geometric series with a common ratio of $r={9}^{3-k}.$ \n\nFor the series to converge, we require $|r|<1.$ Therefore, we have\n\n$$\n\\begin{aligned}|{9}^{3-k}| & <1 \\\\ {9}^{3-k} & <1.\\end{aligned}\n$$\n\nNotice that we could remove the absolute value bars because ${9}^{3-k}$ is always positive.\n\nThe equation ${9}^{3-k}=1$ has the solution $k=3.$ Now, since ${9}^{3-k}$ decreases as $k$ increases, the solution to ${9}^{3-k}<1$ must be $k>3.$"] [:db/cas 17592186320831 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x=$\n\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x=\n$$\n\n{{field-1}}"] [:db/cas 17592186320832 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}{5}^{x+1}\\,\\text{d}x=$\n\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}{5}^{x+1}\\,\\text{d}x=\n$$\n\n{{field-1}}"] [:db/cas 17592186320833 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}{3}^{2x+2}\\,\\text{d}x=$\n\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}{3}^{2x+2}\\,\\text{d}x=\n$$\n\n{{field-1}}"] [:db/cas 17592186320850 :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=3$ plus the total displacement over $t\\in [3,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(3)+{\\int }_{3}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(3)=3$, and we can compute the integral ${\\int }_{3}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=3$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{3}^{7}v(t)\\,\\text{d}t=8.\n$$\n\nTherefore,\n\n$$\nx(7)=3+8=11.\n$$\n\nSo the position of the particle at $t=7$ is $x=11.$" "The position of the particle at $t=7$ is equal to its position at $t=3$ plus the total displacement over $t\\in [3,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(3)+{\\int }_{3}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(3)=3$, and we can compute the integral $$\n\\displaystyle {\\int }_{3}^{7}v(t)\\,\\text{d}t\n$$ by finding the signed area under the graph from $t=3$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{3}^{7}v(t)\\,\\text{d}t=8.\n$$\n\nTherefore,\n\n$$\nx(7)=3+8=11.\n$$\n\nSo the position of the particle at $t=7$ is $x=11.$"] [:db/cas 17592186320852 :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(0)+{\\int }_{0}^{6}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=-4$, and we can compute the integral ${\\int }_{0}^{6}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=6.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{6}v(t)\\,\\text{d}t=10.\n$$\n\nTherefore,\n\n$$\nx(6)=-4+10=6.\n$$\n\nSo the position of the particle at $t=6$ is $x=6.$" "The position of the particle at $t=6$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(0)+{\\int }_{0}^{6}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=-4$, and we can compute the integral $$\n\\displaystyle {\\int }_{0}^{6}v(t)\\,\\text{d}t\n$$ by finding the signed area under the graph from $t=0$ to $t=6.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{6}v(t)\\,\\text{d}t=10.\n$$\n\nTherefore,\n\n$$\nx(6)=-4+10=6.\n$$\n\nSo the position of the particle at $t=6$ is $x=6.$"] [:db/cas 17592186320853 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{\\sqrt[5]{\\operatorname{sin}⁡x}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{\\sqrt[5]{\\operatorname{sin}⁡x}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320854 :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(0)+{\\int }_{0}^{4}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=4$, and we can compute the integral ${\\int }_{0}^{4}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=4.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{4}v(t)\\,\\text{d}t=-1.\n$$\n\nTherefore,\n\n$$\nx(4)=4+(-1)=3.\n$$\n\nSo the position of the particle at $t=4$ is $x=3.$" "The position of the particle at $t=4$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(0)+{\\int }_{0}^{4}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=4$, and we can compute the integral $$\n\\displaystyle {\\int }_{0}^{4}v(t)\\,\\text{d}t\n$$ by finding the signed area under the graph from $t=0$ to $t=4.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{4}v(t)\\,\\text{d}t=-1.\n$$\n\nTherefore,\n\n$$\nx(4)=4+(-1)=3.\n$$\n\nSo the position of the particle at $t=4$ is $x=3.$"] [:db/cas 17592186320855 :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=4$ plus the total displacement over $t\\in [4,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(4)+{\\int }_{4}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(4)=-3$, and we can compute the integral ${\\int }_{4}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=4$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{4}^{7}v(t)\\,\\text{d}t=3.\n$$\n\nTherefore,\n\n$$\nx(7)=-3+3=0.\n$$\n\nSo the position of the particle at $t=7$ is $x=0.$" "The position of the particle at $t=7$ is equal to its position at $t=4$ plus the total displacement over $t\\in [4,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(4)+{\\int }_{4}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(4)=-3$, and we can compute the integral $$\n\\displaystyle {\\int }_{4}^{7}v(t)\\,\\text{d}t\n$$ by finding the signed area under the graph from $t=4$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{4}^{7}v(t)\\,\\text{d}t=3.\n$$\n\nTherefore,\n\n$$\nx(7)=-3+3=0.\n$$\n\nSo the position of the particle at $t=7$ is $x=0.$"] [:db/cas 17592186320856 :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(2)+{\\int }_{2}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(2)=8$, and we can compute the integral ${\\int }_{2}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=2$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{2}^{7}v(t)\\,\\text{d}t=-3.\n$$\n\nTherefore,\n\n$$\nx(7)=8+(-3)=5.\n$$\n\nSo the position of the particle at $t=7$ is $x=5.$" "The position of the particle at $t=7$ is equal to its position at $t=2$ plus the total displacement over $t\\in [2,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(2)+{\\int }_{2}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(2)=8$, and we can compute the integral $$\n\\displaystyle {\\int }_{2}^{7}v(t)\\,\\text{d}t\n$$ by finding the signed area under the graph from $t=2$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{2}^{7}v(t)\\,\\text{d}t=-3.\n$$\n\nTherefore,\n\n$$\nx(7)=8+(-3)=5.\n$$\n\nSo the position of the particle at $t=7$ is $x=5.$"] [:db/cas 17592186320859 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320860 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{3x}}}{\\sqrt{x}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320862 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{\\infty }\\frac{{3}^{-\\operatorname{ln}⁡x}}{x}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320863 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{\\infty }\\frac{1}{x\\cdot {4}^{\\operatorname{ln}⁡x}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320864 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}\\frac{{e}^{3/x}}{{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320865 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{{e}^{5/x}}{{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}\\frac{{e}^{5/x}}{{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320867 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{{e}^{3/x-1}}{{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}\\frac{{e}^{3/x-1}}{{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320868 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{\\infty }\\frac{4}{9+4{x}^{2}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{\\infty }\\frac{4}{9+4{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320873 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }{2}^{-3x}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{1}^{\\infty }{2}^{-3x}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320874 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{6}{{z}^{2}+9}\\,\\text{d}z=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}\\frac{6}{{z}^{2}+9}\\,\\text{d}z=\n$$\n{{field-1}}"] [:db/cas 17592186320874 :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{6}{{z}^{2}+9}\\,\\text{d}z & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{{z}^{2}+9}\\,\\text{d}z \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{{z}^{2}+{3}^{2}}\\,\\text{d}z \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{3}\\operatorname{arctan}⁡\\left(\\frac{z}{3}\\right)]}_{a}^{0} \\\\  & =2\\cdot {lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡0-\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =2\\cdot (0-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)).\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=\\frac{\\pi }{2}$\n\n![](images/a4/a4961fa6f4f1aafeba2e8f77ed91e7d034fffd6aa249f13bb8357da11a7cea5e.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{6}{{z}^{2}+9}\\,\\text{d}z & =2\\cdot (0-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =2\\cdot (0-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =2\\cdot \\frac{\\pi }{2} \\\\  & =\\pi .\\end{aligned}\n$$" "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{6}{{z}^{2}+9}\\,\\text{d}z & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{{z}^{2}+9}\\,\\text{d}z \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{{z}^{2}+{3}^{2}}\\,\\text{d}z \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{3}\\operatorname{arctan}⁡\\left(\\frac{z}{3}\\right)]}_{a}^{0} \\\\  & =2\\cdot {lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡0-\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =2\\cdot (0-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)).\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right),$ shown in the graph below:\n\n- $$\n\\displaystyle {lim}_{x\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=-\\frac{\\pi }{2}\n$$\n\n- $$\n\\displaystyle {lim}_{x\\to \\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=\\frac{\\pi }{2}\n$$\n\n![](images/a4/a4961fa6f4f1aafeba2e8f77ed91e7d034fffd6aa249f13bb8357da11a7cea5e.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{6}{{z}^{2}+9}\\,\\text{d}z & =2\\cdot (0-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =2\\cdot (0-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =2\\cdot \\frac{\\pi }{2} \\\\  & =\\pi .\\end{aligned}\n$$"] [:db/cas 17592186320875 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{\\sqrt{3}}\\frac{12}{{x}^{2}+9}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{\\sqrt{3}}\\frac{12}{{x}^{2}+9}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320875 :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\sqrt{3}}\\frac{12}{{x}^{2}+9}\\,\\text{d}x & =12\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{\\sqrt{3}}\\frac{1}{{x}^{2}+9}\\,\\text{d}x \\\\  & =12\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{\\sqrt{3}}\\frac{1}{{x}^{2}+{3}^{2}}\\,\\text{d}x \\\\  & =12\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{3}\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)]}_{a}^{\\sqrt{3}} \\\\  & =4\\cdot {lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right)-\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =4\\cdot (\\frac{\\pi }{6}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)).\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=\\frac{\\pi }{2}$\n\n![](images/24/24ca4823d220c3eb31127ed28ab7c75b1297e10ae20a1926d112a234806c411e.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\sqrt{3}}\\frac{12}{{x}^{2}+9}\\,\\text{d}x & =4\\cdot (\\frac{\\pi }{6}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =4\\cdot (\\frac{\\pi }{6}-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =4\\cdot (\\frac{\\pi }{6}+\\frac{\\pi }{2}) \\\\  & =4\\cdot \\frac{2\\pi }{3} \\\\  & =\\frac{8\\pi }{3}.\\end{aligned}\n$$" "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\sqrt{3}}\\frac{12}{{x}^{2}+9}\\,\\text{d}x & =12\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{\\sqrt{3}}\\frac{1}{{x}^{2}+9}\\,\\text{d}x \\\\  & =12\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{\\sqrt{3}}\\frac{1}{{x}^{2}+{3}^{2}}\\,\\text{d}x \\\\  & =12\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{3}\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)]}_{a}^{\\sqrt{3}} \\\\  & =4\\cdot {lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡\\left(\\frac{\\sqrt{3}}{3}\\right)-\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =4\\cdot (\\frac{\\pi }{6}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)).\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right),$ shown in the graph below:\n\n- $$\n\\displaystyle {lim}_{x\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=-\\frac{\\pi }{2}\n$$\n\n- $$\n\\displaystyle {lim}_{x\\to \\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{3}\\right)=\\frac{\\pi }{2}\n$$\n\n![](images/24/24ca4823d220c3eb31127ed28ab7c75b1297e10ae20a1926d112a234806c411e.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\sqrt{3}}\\frac{12}{{x}^{2}+9}\\,\\text{d}x & =4\\cdot (\\frac{\\pi }{6}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{3}\\right)) \\\\  & =4\\cdot (\\frac{\\pi }{6}-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =4\\cdot (\\frac{\\pi }{6}+\\frac{\\pi }{2}) \\\\  & =4\\cdot \\frac{2\\pi }{3} \\\\  & =\\frac{8\\pi }{3}.\\end{aligned}\n$$"] [:db/cas 17592186320876 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{5}\\frac{6}{{x}^{2}+25}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{5}\\frac{6}{{x}^{2}+25}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320876 :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{5}\\frac{6}{{x}^{2}+25}\\,\\text{d}x & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{5}\\frac{1}{{x}^{2}+25}\\,\\text{d}x \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{5}\\frac{1}{{x}^{2}+{5}^{2}}\\,\\text{d}x \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{5}\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)]}_{a}^{5} \\\\  & =\\frac{6}{5}\\cdot {lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡\\left(\\frac{a}{5}\\right)) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{5}\\right)).\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)=\\frac{\\pi }{2}$\n\n![](images/f8/f8325b1ea152bd40aaa909202bfce59e621952486041c657c0e27b9192ecec03.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{5}\\frac{6}{{x}^{2}+25}\\,\\text{d}x & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{5}\\right)) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}+\\frac{\\pi }{2}) \\\\  & =\\frac{6}{5}\\cdot \\frac{3\\pi }{4} \\\\  & =\\frac{9\\pi }{10}.\\end{aligned}\n$$" "First, let's recall the following result:\n\n$$\n\\int \\frac{1}{{k}^{2}+{x}^{2}}\\,\\text{d}x=\\frac{1}{k}\\operatorname{arctan}⁡\\left(\\frac{x}{k}\\right)+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{5}\\frac{6}{{x}^{2}+25}\\,\\text{d}x & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{5}\\frac{1}{{x}^{2}+25}\\,\\text{d}x \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{5}\\frac{1}{{x}^{2}+{5}^{2}}\\,\\text{d}x \\\\  & =6\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{5}\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)]}_{a}^{5} \\\\  & =\\frac{6}{5}\\cdot {lim}_{a\\to -\\infty }(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡\\left(\\frac{a}{5}\\right)) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{5}\\right)).\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right),$ shown in the graph below:\n\n- $$\n\\displaystyle {lim}_{x\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)=-\\frac{\\pi }{2}\n$$\n\n- $$\n\\displaystyle {lim}_{x\\to \\infty }\\operatorname{arctan}⁡\\left(\\frac{x}{5}\\right)=\\frac{\\pi }{2}\n$$\n\n![](images/f8/f8325b1ea152bd40aaa909202bfce59e621952486041c657c0e27b9192ecec03.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{5}\\frac{6}{{x}^{2}+25}\\,\\text{d}x & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-{lim}_{a\\to -\\infty }\\operatorname{arctan}⁡\\left(\\frac{a}{5}\\right)) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =\\frac{6}{5}\\cdot (\\frac{\\pi }{4}+\\frac{\\pi }{2}) \\\\  & =\\frac{6}{5}\\cdot \\frac{3\\pi }{4} \\\\  & =\\frac{9\\pi }{10}.\\end{aligned}\n$$"] [:db/cas 17592186320877 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{\\infty }\\frac{6|x|}{{e}^{2{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{\\infty }\\frac{6|x|}{{e}^{2{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320886 :question/worked-solution "First, note that we are given $y(0)$ and asked to find $y\\,\\left(\\frac{3}{2}\\right).$ The distance from $x=0$ to $x=\\frac{3}{2}$ is $\\frac{3}{2},$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{(\\frac{3}{2}-0)}{2}=\\frac{3}{4}.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=1.$ \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x+2=2\\cdot 0+2=2 \\\\ Δy & ={y}^{′}\\cdot Δx=2\\cdot \\frac{3}{4}=\\frac{3}{2} \\\\ {x}_{\\text{new}} & =x+Δx=0+\\frac{3}{4}=\\frac{3}{4} \\\\ {y}_{\\text{new}} & =1+Δy=1+\\frac{3}{2}=\\frac{5}{2}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{3}{2}$ |\n| $\\frac{3}{4}$ | $\\frac{5}{2}$ | $$ | $$ |\n\n \n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x+2=2\\cdot \\frac{3}{4}+2=\\frac{7}{2} \\\\ Δy & ={y}^{′}\\cdot Δx=\\frac{7}{2}\\cdot \\frac{3}{4}=\\frac{21}{8} \\\\ {x}_{\\text{new}} & =x+Δx=\\frac{3}{4}+\\frac{3}{4}=\\frac{3}{2} \\\\ {y}_{\\text{new}} & =y+Δy=\\frac{5}{2}+\\frac{21}{8}=\\frac{41}{8}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{3}{2}$ |\n| $\\frac{3}{4}$ | $\\frac{5}{2}$ | $\\frac{7}{2}$ | $\\frac{21}{8}$ |\n| $\\frac{3}{2}$ | $\\frac{41}{8}$ | $$ | $$ |\n\n \n\nTherefore, we conclude that  $y\\,\\left(\\frac{3}{2}\\right)≈\\frac{41}{8}.$" "First, note that we are given $y(0)$ and asked to find $y\\,\\left(\\frac{3}{2}\\right).$ The distance from $x=0$ to $x=\\frac{3}{2}$ is $\\frac{3}{2},$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{(\\frac{3}{2}-0)}{2}=\\frac{3}{4}.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=1.$ \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x+2=2\\cdot 0+2=2 \\\\ Δy & ={y}^{′}\\cdot Δx=2\\cdot \\frac{3}{4}=\\frac{3}{2} \\\\ {x}_{\\text{new}} & =x+Δx=0+\\frac{3}{4}=\\frac{3}{4} \\\\ {y}_{\\text{new}} & =1+Δy=1+\\frac{3}{2}=\\frac{5}{2}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{3}{2}$ |\n| $\\frac{3}{4}$ | $\\frac{5}{2}$ | $$ | $$ |\n\n \n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x+2=2\\cdot \\frac{3}{4}+2=\\frac{7}{2} \\\\ Δy & ={y}^{′}\\cdot Δx=\\frac{7}{2}\\cdot \\frac{3}{4}=\\frac{21}{8} \\\\ {x}_{\\text{new}} & =x+Δx=\\frac{3}{4}+\\frac{3}{4}=\\frac{3}{2} \\\\ {y}_{\\text{new}} & =y+Δy=\\frac{5}{2}+\\frac{21}{8}=\\frac{41}{8}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{3}{2}$ |\n| $\\frac{3}{4}$ | $\\frac{5}{2}$ | $\\frac{7}{2}$ | $\\frac{21}{8}$ |\n| $\\frac{3}{2}$ | $\\frac{41}{8}$ | $$ | $$ |\n\n \n\nTherefore, we conclude that  $$\n\\displaystyle y\\,\\left(\\frac{3}{2}\\right)≈\\frac{41}{8}.\n$$"] [:db/cas 17592186320904 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320904 :question/worked-solution "First, we substitute $u={x}^{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}\\,⟹\\,\\text{d}u=4{x}^{3}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{4}$ is as follows:\n\n| $x$ | $0$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x={\\int }_{\\infty }^{0}\\frac{1}{{u}^{2}+4}\\,\\text{d}u=-{\\int }_{0}^{\\infty }\\frac{1}{{u}^{2}+4}\\,\\text{d}u.\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x & =-{lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{{u}^{2}+4}\\,\\text{d}u \\\\  & =-{lim}_{a\\to \\infty }{[\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{u}{2}\\right)]}_{0}^{a} \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }(\\operatorname{arctan}⁡\\left(\\frac{a}{2}\\right)-\\operatorname{arctan}⁡(0)) \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }[\\operatorname{arctan}⁡\\left(\\frac{a}{2}\\right)]\\end{aligned}\n$$\n\nFinally, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)]=\\frac{\\pi }{2}$\n\n![](images/71/7151efaca7e4356e590a437f5d50a2ab6e5646e960b7ffa82b0bbed27bb9db47.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x & =-\\frac{1}{2}{lim}_{a\\to \\infty }[\\operatorname{arctan}⁡\\left(\\frac{a}{2}\\right)] \\\\  & =-\\frac{1}{2}\\left(\\frac{\\pi }{2}\\right) \\\\  & =-\\frac{\\pi }{4}.\\end{aligned}\n$$" "First, we substitute $u={x}^{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}\\,⟹\\,\\text{d}u=4{x}^{3}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{4}$ is as follows:\n\n| $x$ | $0$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x={\\int }_{\\infty }^{0}\\frac{1}{{u}^{2}+4}\\,\\text{d}u=-{\\int }_{0}^{\\infty }\\frac{1}{{u}^{2}+4}\\,\\text{d}u.\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x & =-{lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{{u}^{2}+4}\\,\\text{d}u \\\\  & =-{lim}_{a\\to \\infty }{[\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{u}{2}\\right)]}_{0}^{a} \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }(\\operatorname{arctan}⁡\\left(\\frac{a}{2}\\right)-\\operatorname{arctan}⁡(0)) \\\\  & =-\\frac{1}{2}{lim}_{a\\to \\infty }[\\operatorname{arctan}⁡\\left(\\frac{a}{2}\\right)]\\end{aligned}\n$$\n\nFinally, recall the end behavior of the function $y=\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right),$ shown in the graph below:\n\n- $$\n\\displaystyle {lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)]=-\\frac{\\pi }{2}\n$$\n\n- $$\n\\displaystyle {lim}_{x\\to \\infty }[\\operatorname{arctan}⁡\\left(\\frac{x}{2}\\right)]=\\frac{\\pi }{2}\n$$\n\n![](images/71/7151efaca7e4356e590a437f5d50a2ab6e5646e960b7ffa82b0bbed27bb9db47.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{x}^{8}+4}\\,\\text{d}x & =-\\frac{1}{2}{lim}_{a\\to \\infty }[\\operatorname{arctan}⁡\\left(\\frac{a}{2}\\right)] \\\\  & =-\\frac{1}{2}\\left(\\frac{\\pi }{2}\\right) \\\\  & =-\\frac{\\pi }{4}.\\end{aligned}\n$$"] [:db/cas 17592186320915 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320917 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-0.2}^{0.2}\\frac{3}{\\sqrt{3-75{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{-0.2}^{0.2}\\frac{3}{\\sqrt{3-75{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320918 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320919 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{4}\\frac{12}{3+27{x}^{2}}\\,\\text{d}x=$\n{{field-1}}\n$\\operatorname{arctan}⁡($\n{{field-2}}$)$" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{4}\\frac{12}{3+27{x}^{2}}\\,\\text{d}x=\n$$\n{{field-1}}\n$\\operatorname{arctan}⁡($\n{{field-2}}$)$"] [:db/cas 17592186320920 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}\\frac{1}{\\sqrt{12-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡($\n{{field-1}}$)$" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{2}\\frac{1}{\\sqrt{12-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡(\n$$\n{{field-1}}$)$"] [:db/cas 17592186320931 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}{t}^{2}{e}^{4t}\\,\\text{d}t=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{1}{t}^{2}{e}^{4t}\\,\\text{d}t=\n$$\n{{field-1}}"] [:db/cas 17592186320931 :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{4t}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{4t}\\,\\text{d}t=\\frac{1}{4}{e}^{4t}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {t}^{2}{e}^{4t}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2})(\\frac{1}{4}{e}^{4t})-\\int (\\frac{1}{4}{e}^{4t})(2t)\\,\\text{d}t \\\\  & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{2}\\int t{e}^{4t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int t{e}^{4t}\\,\\text{d}t.$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{4t}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{4t}\\,\\text{d}t=\\frac{1}{4}{e}^{4t}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t{e}^{4t}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{1}{4}{e}^{4t})-\\int (\\frac{1}{4}{e}^{4t})(1)\\,\\text{d}t \\\\  & =\\frac{1}{4}t{e}^{4t}-\\frac{1}{4}\\int {e}^{4t}\\,\\text{d}t \\\\  & =\\frac{1}{4}t{e}^{4t}-\\frac{1}{16}{e}^{4t}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int {t}^{2}{e}^{4t}\\,\\text{d}t & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{2}\\int t{e}^{4t}\\,\\text{d}t \\\\  & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{2}(\\frac{1}{4}t{e}^{4t}-\\frac{1}{16}{e}^{4t}+D) \\\\  & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{8}t{e}^{4t}+\\frac{1}{32}{e}^{4t}+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{D}{2}.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{t}^{2}{e}^{4t}\\,\\text{d}t & =(\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{8}t{e}^{4t}+\\frac{1}{32}{e}^{4t})\\,{|}_{0}^{1} \\\\  & =(\\frac{1}{4}({1}^{2}){e}^{4}-\\frac{1}{8}(1){e}^{4}+\\frac{1}{32}{e}^{4})-(\\frac{1}{4}({0}^{2}){e}^{0}-\\frac{1}{8}(0){e}^{0}+\\frac{1}{32}{e}^{0}) \\\\  & =\\frac{5}{32}{e}^{4}-\\frac{1}{32} \\\\  & =\\frac{5{e}^{4}-1}{32}\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{4t}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{4t}\\,\\text{d}t=\\frac{1}{4}{e}^{4t}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {t}^{2}{e}^{4t}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2})(\\frac{1}{4}{e}^{4t})-\\int (\\frac{1}{4}{e}^{4t})(2t)\\,\\text{d}t \\\\  & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{2}\\int t{e}^{4t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int t{e}^{4t}\\,\\text{d}t.\n$$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{4t}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{4t}\\,\\text{d}t=\\frac{1}{4}{e}^{4t}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t{e}^{4t}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{1}{4}{e}^{4t})-\\int (\\frac{1}{4}{e}^{4t})(1)\\,\\text{d}t \\\\  & =\\frac{1}{4}t{e}^{4t}-\\frac{1}{4}\\int {e}^{4t}\\,\\text{d}t \\\\  & =\\frac{1}{4}t{e}^{4t}-\\frac{1}{16}{e}^{4t}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int {t}^{2}{e}^{4t}\\,\\text{d}t & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{2}\\int t{e}^{4t}\\,\\text{d}t \\\\  & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{2}(\\frac{1}{4}t{e}^{4t}-\\frac{1}{16}{e}^{4t}+D) \\\\  & =\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{8}t{e}^{4t}+\\frac{1}{32}{e}^{4t}+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{D}{2}.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{t}^{2}{e}^{4t}\\,\\text{d}t & =(\\frac{1}{4}{t}^{2}{e}^{4t}-\\frac{1}{8}t{e}^{4t}+\\frac{1}{32}{e}^{4t})\\,{|}_{0}^{1} \\\\  & =(\\frac{1}{4}({1}^{2}){e}^{4}-\\frac{1}{8}(1){e}^{4}+\\frac{1}{32}{e}^{4})-(\\frac{1}{4}({0}^{2}){e}^{0}-\\frac{1}{8}(0){e}^{0}+\\frac{1}{32}{e}^{0}) \\\\  & =\\frac{5}{32}{e}^{4}-\\frac{1}{32} \\\\  & =\\frac{5{e}^{4}-1}{32}\\end{aligned}\n$$"] [:db/cas 17592186320933 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displays