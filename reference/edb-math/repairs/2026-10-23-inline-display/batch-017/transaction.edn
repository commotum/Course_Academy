 1\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{5}\\begin{bmatrix}3 & 1 \\\\ -2 & 1\\end{bmatrix}\\begin{bmatrix}-5 \\\\ 5\\end{bmatrix}\\end{aligned}\n$$"] [:db/cas 17592186302056 :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}7 & -1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$A=\\begin{bmatrix}7 & -1 \\\\ 1 & 4\\end{bmatrix}.$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot 4-(-1)\\cdot 1}\\begin{bmatrix}4 & 1 \\\\ -1 & 7\\end{bmatrix} \\\\  & =\\frac{1}{29}\\begin{bmatrix}4 & 1 \\\\ -1 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{29}\\begin{bmatrix}4 & 1 \\\\ -1 & 7\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$" "This system can be written as\n\n$$\n\\begin{bmatrix}7 & -1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}x \\\\ y\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}.\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix \n$$\n\\displaystyle A=\\begin{bmatrix}7 & -1 \\\\ 1 & 4\\end{bmatrix}.\n$$\nThis gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot 4-(-1)\\cdot 1}\\begin{bmatrix}4 & 1 \\\\ -1 & 7\\end{bmatrix} \\\\  & =\\frac{1}{29}\\begin{bmatrix}4 & 1 \\\\ -1 & 7\\end{bmatrix}.\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{29}\\begin{bmatrix}4 & 1 \\\\ -1 & 7\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$"] [:db/cas 17592186302057 :question/worked-solution "This system can be written as\n\n$$\n\\begin{bmatrix}4 & -1 \\\\ 1 & 4\\end{bmatrix}\\begin{bmatrix}x 