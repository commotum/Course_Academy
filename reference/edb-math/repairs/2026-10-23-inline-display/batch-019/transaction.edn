\,dx \\\\  & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & =6{x}^{2}\\operatorname{sin}⁡x-12\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =6{x}^{2}\\operatorname{sin}⁡x-12(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=-12D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & ={[6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =(\\frac{3{\\pi }^{2}}{2}-12)-0 \\\\  & =\\frac{3{\\pi }^{2}}{2}-12\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=6{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=12x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(6{x}^{2})(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(12x)\\,\\text{d}x \\\\  & =6{x}^{2}\\operatorname{sin}⁡x-12\\int x\\operatorname{sin}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $$\n\\displaystyle \\int x\\operatorname{sin}⁡x\\,\\text{d}x.\n$$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x & \\,⟹\\,v=\\int \\operatorname{sin}⁡x\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)\\,dx \\\\  & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & =6{x}^{2}\\operatorname{sin}⁡x-12\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =6{x}^{2}\\operatorname{sin}⁡x-12(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=-12D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & ={[6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =(\\frac{3{\\pi }^{2}}{2}-12)-0 \\\\  & =\\frac{3{\\pi }^{2}}{2}-12\\end{aligned}\n$$"] [:db/cas 17592186320944 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{\\pi /2}2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186320944 :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=2{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=4x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(2{x}^{2})\\left(-\\frac{\\operatorname{cos}⁡(2x)}{2}\\right)-\\int \\left(-\\frac{\\operatorname{cos}⁡(2x)}{2}\\right)(4x)\\,\\text{d}x \\\\  & =-{x}^{2}\\operatorname{cos}⁡(2x)+2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x) & \\,⟹\\,v=\\int \\operatorname{cos}⁡(2x)\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x\\left(\\frac{\\operatorname{sin}⁡(2x)}{2}\\right)-\\int \\left(\\frac{\\operatorname{sin}⁡(2x)}{2}\\right)\\cdot 1\\,dx \\\\  & =\\frac{x\\operatorname{sin}⁡(2x)}{2}+\\frac{\\operatorname{cos}⁡(2x)}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =-{x}^{2}\\operatorname{cos}⁡(2x)+2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-{x}^{2}\\operatorname{cos}⁡(2x)+2(\\frac{x\\operatorname{sin}⁡(2x)}{2}+\\frac{\\operatorname{cos}⁡(2x)}{4}+D) \\\\  & =-{x}^{2}\\operatorname{cos}⁡(2x)+x\\operatorname{sin}⁡(2x)+\\frac{\\operatorname{cos}⁡(2x)}{2}+C,\\end{aligned}\n$$\n\nwhere $C=2D.$\n\nFinally, then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x & ={[-{x}^{2}\\operatorname{cos}⁡(2x)+x\\operatorname{sin}⁡(2x)+\\frac{\\operatorname{cos}⁡(2x)}{2}]}_{0}^{\\pi /2} \\\\  & =(-{\\left(\\frac{\\pi }{2}\\right)}^{2}\\operatorname{cos}⁡(\\pi )+\\left(\\frac{\\pi }{2}\\right)\\operatorname{sin}⁡(\\pi )+\\frac{\\operatorname{cos}⁡(\\pi )}{2}) \\\\  & \\,-(-(0)^{2}\\operatorname{cos}⁡(0)+(0)\\operatorname{sin}⁡(0)+\\frac{\\operatorname{cos}⁡(0)}{2}) \\\\  & =(\\frac{{\\pi }^{2}}{4}-\\frac{1}{2})-\\frac{1}{2} \\\\  & =\\frac{{\\pi }^{2}}{4}-1 \\\\  & =\\frac{{\\pi }^{2}}{4}-1\\end{aligned}\n$$" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=2{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=4x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(2{x}^{2})\\left(-\\frac{\\operatorname{cos}⁡(2x)}{2}\\right)-\\int \\left(-\\frac{\\operatorname{cos}⁡(2x)}{2}\\right)(4x)\\,\\text{d}x \\\\  & =-{x}^{2}\\operatorname{cos}⁡(2x)+2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $$\n\\displaystyle \\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x.\n$$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(2x) & \\,⟹\\,v=\\int \\operatorname{cos}⁡(2x)\\text{d}x=\\frac{\\operatorname{sin}⁡(2x)}{2}.\\end{aligned}\n$$\n\nIn thi