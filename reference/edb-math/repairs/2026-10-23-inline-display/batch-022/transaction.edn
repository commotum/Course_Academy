 \\\\ 0 \\\\ -1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ -\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $|\\,d\\,|=|-\\frac{\\sqrt{2}}{2}|=\\frac{\\sqrt{2}}{2}.$" "Since the first two vectors are already orthogonal, we proceed to find an orthogonal basis using the Gram-Schmidt process.\n\n**Step 1**: We set ${v}_{1}={a}_{1}=\\begin{bmatrix}2 \\\\ -2 \\\\ -2 \\\\ 2\\end{bmatrix}.$\n\n**Step 2**: We set ${v}_{2}={a}_{2}=\\begin{bmatrix}1 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix}.$\n\n**Step 3**. Next, we find ${v}_{3}$ using the formula\n\n$$\n\\begin{aligned}{v}_{3} & ={a}_{3}-{\\text{proj}}_{{v}_{1}}\\,{a}_{3}-{\\text{proj}}_{{v}_{2}}\\,{a}_{3} \\\\  & ={a}_{3}-\\frac{{a}_{3}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1}-\\frac{{a}_{3}\\cdot {v}_{2}}{{v}_{2}\\cdot {v}_{2}}{v}_{2}.\\end{aligned}\n$$\n\nApplying the formula for ${v}_{3}$ in our case gives\n\n$$\n\\begin{aligned}{v}_{3} & =\\begin{bmatrix}3 \\\\ -1 \\\\ -3 \\\\ 1\\end{bmatrix}-\\frac{16}{16}\\begin{bmatrix}2 \\\\ -2 \\\\ -2 \\\\ 2\\end{bmatrix}-\\frac{2}{2}\\begin{bmatrix}1 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ -1 \\\\ -3 \\\\ 1\\end{bmatrix}-\\begin{bmatrix}2 \\\\ -2 \\\\ -2 \\\\ 2\\end{bmatrix}-\\begin{bmatrix}1 \\\\ 1 \\\\ 0 \\\\ 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 \\\\ 0 \\\\ -1 \\\\ -1\\end{bmatrix}.\\end{aligned}\n$$\n\nNow, we normalize ${v}_{3}$ dividing it by $‖{v}_{3}‖=\\sqrt{2}:$\n\n$$\n\\begin{aligned}{u}_{3} & =\\frac{{v}_{3}}{‖{v}_{3}‖}=\\frac{1}{\\sqrt{2}}\\begin{bmatrix}0 \\\\ 0 \\\\ -1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}0 \\\\ 0 \\\\ -\\frac{\\sqrt{2}}{2} \\\\ -\\frac{\\sqrt{2}}{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nFinally, $$\n\\displaystyle |\\,d\\,|=|-\\frac{\\sqrt{2}}{2}|=\\frac{\\sqrt{2}}{2}.\n$$"] [:db/cas 17592186392435 :question/problem "Find the product $AB$, if\n$A=\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.$" "Find the product $AB$, if\n$$\n\\displaystyle A=\\begin{bmatrix}\\sqrt{3} & -5 & 5 \\\\ -5 & 3\\sqrt{2} & -3.5 \\\\ 1 & 2 & -4\\sqrt{5}\\end{bmatrix}\n$$\nand \n$$\n\\displaystyle B=\\begin{bmatrix}0 \\\\ 0 \\\\ 1\\end{bmatrix}.\n$$"] [:db/cas 17592186392468 :question/problem "$|\\begin{aligned}2 & -1 & 4 & 0 \\\\ 3 & 1 & 2 & 2 \\\\ -1 & 2 & 3 & 0 \\\\ -3 & -2 & 5 & -1\\end{aligned}|=$" "$$\n\\displaystyle |\\begin{aligned}2 & -1 & 4 & 0 \\\\ 3 & 1 & 2 & 2 \\\\ -1 & 2 & 3 & 0 \\\\ -3 & -2 & 5 & -1\\end{aligned}|=\n$$"] [:db/cas 17592186392541 :question/problem "Consider the system of linear equations \n\n$$\n\\left\\{\\begin{aligned}2x-y &=-6 \\\\ \\,\\,\\,x+y &=7.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, the unknown $y$ can be written as $y=\\frac{{D}_{y}}{|\\begin{aligned}2 & \\,\\,-1 \\\\ 1 & 1\\end{aligned}|}$, where ${D}_{y}=$" "Consider the system of linear equations \n\n$$\n\\left\\{\\begin{aligned}2x-y &=-6 \\\\ \\,\\,\\,x+y &=7.\\end{aligned}\\right.\n$$\n\nAccording to Cramer's rule, the unknown $y$ can be written as $$\n\\displaystyle y=\\frac{{D}_{y}}{|\\begin{aligned}2 & \\,\\,-1 \\\\ 1 & 1\\end{aligned}|},\n$$ where ${D}_{y}=$"] [:db/cas 17592186392642 :question/worked-solution "Let $A$ be the area of the square, and $h$ be the length of the diagonal. The relationship between $A$ and $h$ is\n\n$$\nA=\\frac{{h}^{2}}{2}.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{h}^{2}}{2}\\right) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}h}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}h}\\left(\\frac{{h}^{2}}{2}\\right) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}h}{\\text{d}t}\\cdot h.\\end{aligned}\n$$\n\nThe given information tells us that $\\frac{\\text{d}A}{\\text{d}t}=4\\frac{\\text{d}h}{\\text{d}t}$, so replacing $\\frac{\\text{d}A}{\\text{d}t}$ in the above gives\n\n$$\n\\begin{aligned}4\\frac{\\text{d}h}{\\text{d}t} & =h\\frac{\\text{d}h}{\\text{d}t} \\\\ 4\\cancel{\\frac{\\text{d}h}{\\text{d}t}} & =h\\cancel{\\frac{\\text{d}h}{\\text{d}t}} \\\\ 4 & =h.\\end{aligned}\n$$\n\nSo at that particular moment, we have that the length of the diagonals of the square is $4\\text{ feet}.$" "Let $A$ be the area of the square, and $h$ be the length of the diagonal. The relationship between $A$ and $h$ is\n\n$$\nA=\\frac{{h}^{2}}{2}.\n$$\n\nDifferentiating this relationship with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(A) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{{h}^{2}}{2}\\right) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}h}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}h}\\left(\\frac{{h}^{2}}{2}\\right) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}h}{\\text{d}t}\\cdot h.\\end{aligned}\n$$\n\nThe given information tells us that $$\n\\displaystyle \\frac{\\text{d}A}{\\text{d}t}=4\\frac{\\text{d}h}{\\text{d}t},\n$$ so replacing $\\frac{\\text{d}A}{\\text{d}t}$ in the above gives\n\n$$\n\\begin{aligned}4\\frac{\\text{d}h}{\\text{d}t} & =h\\frac{\\text{d}h}{\\text{d}t} \\\\ 4\\cancel{\\frac{\\text{d}h}{\\text{d}t}} & =h\\cancel{\\frac{\\text{d}h}{\\text{d}t}} \\\\ 4 & =h.\\end{aligned}\n$$\n\nSo at that particular moment, we have that the length of the diagonals of the square is $4\\text{ feet}.$"] [:db/cas 17592186392689 :question/problem "Given that $u=3-2{x}^{2}$, which integral is equivalent to ${\\int }_{-1}^{0}{x}^{3}\\sqrt{3-2{x}^{2}}\\,\\text{d}x?$" "Given that $u=3-2{x}^{2}$, which integral is equivalent to $$\n\\displaystyle {\\int }_{-1}^{0}{x}^{3}\\sqrt{3-2{x}^{2}}\\,\\text{d}x?\n$$"] [:db/cas 17592186392702 :question/problem "$\\int ⟨{e}^{-t},\\operatorname{tan}⁡t\\operatorname{sec}⁡t⟩\\,\\text{d}t=$" "$$\n\\displaystyle \\int ⟨{e}^{-t},\\operatorname{tan}⁡t\\operatorname{sec}⁡t⟩\\,\\text{d}t=\n$$