t)=3t\\end{aligned}\n$$\n\nTherefore, the correct answer is $\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=5{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}\\right.$ only." "Recall that a first-order linear system of differential equations with two dependent variables is a system of the form\n\n$$\n\\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t) &=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t).\\end{aligned}\\right.\n$$\n\nIf $f≡0$ and $g≡0$ (i.e., both $f$ and $g$ are zero functions), then the system is *homogeneous*. Otherwise, if at least one of $f$ or $g$ is not identically zero, the system is *inhomogeneous*.\n\nWith this in mind, let's inspect each system:\n\n- System $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=3{x}_{1}(t)+2{x}_{2}(t)+\\operatorname{ln}⁡(5t) \\\\ {x}_{2}^{′}(t) &=-{x}_{1}(t)+4{x}_{2}(t)+1\\end{aligned}\\right.\n$$ is inhomogeneous since it can be written in the standard form with $f≢0$ and $g≢0:$\n\n$$\n\\begin{aligned}a(t)=3, &  & b(t)=2, &  & f(t)=\\operatorname{ln}⁡(5t) \\\\ c(t)=-1, &  & d(t)=4, &  & g(t)=1\\end{aligned}\n$$\n\n- System $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=5{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}\\right.\n$$ is homogeneous since it can be written in the standard form with $f≡0$ and $g≡0:$\n\n$$\n\\begin{aligned}a(t)=-1, &  & b(t)=1, &  & f(t)=0 \\\\ c(t)=5, &  & d(t)=6, &  & g(t)=0\\end{aligned}\n$$\n\n- System $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=4{x}_{1}(t)+{e}^{2} \\\\ {x}_{2}^{′}(t) &={x}_{2}(t)+3t\\end{aligned}\\right.\n$$ is inhomogeneous since it can be written in the standard form with $f≢0$ and $g≢0:$\n\n$$\n\\begin{aligned}a(t)=4, &  & b(t)=0, &  & f(t)={e}^{2} \\\\ c(t)=0, &  & d(t)=1, &  & g(t)=3t\\end{aligned}\n$$\n\nTherefore, the correct answer is $$\n\\displaystyle \\left\\{\\begin{aligned}{x}_{1}^{′}(t) &=-{x}_{1}(t)+{x}_{2}(t) \\\\ {x}_{2}^{′}(t) &=5{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}\\right.\n$$ only."] [:db/cas 17592186314818 :question/problem "![](images/35/353412402972b390de950f56b3273d8dbecf60d4d07c7c27e9281c28145a86d2.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n${\\int }_{-3}^{7}f(x)\\,\\text{d}x=$\n{{field-1}}." "![](images/35/353412402972b390de950f56b3273d8dbecf60d4d07c7c27e9281c28145a86d2.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n$$\n\\displaystyle {\\int }_{-3}^{7}f(x)\\,\\text{d}x=\n$$\n{{field-1}}."] [:db/cas 17592186314819 :question/problem "![](images/38/38270fdcb312cdce6a76e1d88bfa0117b4a69b5024b2acfd0456646471ead71f.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n${\\int }_{-6}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." "![](images/38/38270fdcb312cdce6a76e1d88bfa0117b4a69b5024b2acfd0456646471ead71f.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n$$\n\\displaystyle {\\int }_{-6}^{5}f(x)\\,\\text{d}x=\n$$\n{{field-1}}."] [:db/cas 17592186314828 :question/problem "$\\int {e}^{2x}\\operatorname{sin}⁡(3x)\\,\\text{d}x=$" "$$\n\\displaystyle \\int {e}^{2x}\\operatorname{sin}⁡(3x)\\,\\text{d}x=\n$$"] [:db/cas 17592186314845 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=\\frac{1}{3},$ we will use a step size of\n\n$$\nΔx=\\frac{1}{3}-0=\\frac{1}{3}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(3x+2y+(3{x}_{\\text{new}}+2{y}_{\\text{new}}))\\cdot \\frac{1}{3} \\\\  & =\\frac{1}{6}(3x+2y+3{x}_{\\text{new}}+2{y}_{\\text{new}}) \\\\  & =\\frac{1}{6}(3x+2y+3{x}_{\\text{new}})+\\frac{1}{3}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{6}(3x+2y+3{x}_{\\text{new}})+\\frac{1}{3}{y}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{1}{6}(3x+3{x}_{\\text{new}}+8y)+\\frac{1}{3}{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}\\frac{2}{3}{y}_{\\text{new}} & =\\frac{1}{6}(3x+3{x}_{\\text{new}}+8y) \\\\ {y}_{\\text{new}} & =\\frac{1}{4}(3x+3{x}_{\\text{new}}+8y)\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=0+\\frac{1}{3}=\\frac{1}{3}.$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{1}{4}(3x+3{x}_{\\text{new}}+8y) \\\\  & =\\frac{1}{4}(3\\cdot 0+3\\cdot \\frac{1}{3}+8\\cdot 0) \\\\  & =\\frac{1}{4} \\\\  & =0.25.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(\\frac{1}{3}\\right)≈0.25.$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=\\frac{1}{3},$ we will use a step size of\n\n$$\nΔx=\\frac{1}{3}-0=\\frac{1}{3}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(3x+2y+(3{x}_{\\text{new}}+2{y}_{\\text{new}}))\\cdot \\frac{1}{3} \\\\  & =\\frac{1}{6}(3x+2y+3{x}_{\\text{new}}+2{y}_{\\text{new}}) \\\\  & =\\frac{1}{6}(3x+2y+3{x}_{\\text{new}})+\\frac{1}{3}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{6}(3x+2y+3{x}_{\\text{new}})+\\frac{1}{3}{y}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{1}{6}(3x+3{x}_{\\text{new}}+8y)+\\frac{1}{3}{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}\\frac{2}{3}{y}_{\\text{new}} & =\\frac{1}{6}(3x+3{x}_{\\text{new}}+8y) \\\\ {y}_{\\text{new}} & =\\frac{1}{4}(3x+3{x}_{\\text{new}}+8y)\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is $$\n\\displaystyle {x}_{\\text{new}}=0+\\frac{1}{3}=\\frac{1}{3}.\n$$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{1}{4}(3x+3{x}_{\\text{new}}+8y) \\\\  & =\\frac{1}{4}(3\\cdot 0+3\\cdot \\frac{1}{3}+8\\cdot 0) \\\\  & =\\frac{1}{4} \\\\  & =0.25.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(\\frac{1}{3}\\right)≈0.25.$"] [:db/cas 17592186314846 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=\\frac{1}{2},$ we will use a step size of\n\n$$\nΔx=\\frac{1}{2}-0=\\frac{1}{2}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(x+2y+({x}_{\\text{new}}+2{y}_{\\text{new}}))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{4}(x+2y+{x}_{\\text{new}}+2{y}_{\\text{new}}) \\\\  & =\\frac{1}{4}(x+2y+{x}_{\\text{new}})+\\frac{1}{2}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{4}(x+2y+{x}_{\\text{new}})+\\frac{1}{2}{y}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{1}{4}(x+{x}_{\\text{new}}+6y)+\\frac{1}{2}{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{y}_{\\text{new}} & =\\frac{1}{4}(x+{x}_{\\text{new}}+6y) \\\\ {y}_{\\text{new}} & =\\frac{1}{2}(x+{x}_{\\text{new}}+6y)\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=0+\\frac{1}{2}=\\frac{1}{2}.$\n Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{1}{2}(x+{x}_{\\text{new}}+6y) \\\\  & =\\frac{1}{2}(0+\\frac{1}{2}+6\\cdot \\frac{1}{4}) \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(\\frac{1}{2}\\right)≈1.00.$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=\\frac{1}{2},$ we will use a step size of\n\n$$\nΔx=\\frac{1}{2}-0=\\frac{1}{2}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(x+2y+({x}_{\\text{new}}+2{y}_{\\text{new}}))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{4}(x+2y+{x}_{\\text{new}}+2{y}_{\\text{new}}) \\\\  & =\\frac{1}{4}(x+2y+{x}_{\\text{new}})+\\frac{1}{2}{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{4}(x+2y+{x}_{\\text{new}})+\\frac{1}{2}{y}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{1}{4}(x+{x}_{\\text{new}}+6y)+\\frac{1}{2}{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{y}_{\\text{new}} & =\\frac{1}{4}(x+{x}_{\\text{new}}+6y) \\\\ {y}_{\\text{new}} & =\\frac{1}{2}(x+{x}_{\\text{new}}+6y)\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is $$\n\\displaystyle {x}_{\\text{new}}=0+\\frac{1}{2}=\\frac{1}{2}.\n$$\n Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{1}{2}(x+{x}_{\\text{new}}+6y) \\\\  & =\\frac{1}{2}(0+\\frac{1}{2}+6\\cdot \\frac{1}{4}) \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(\\frac{1}{2}\\right)≈1.00.$"] [:db/cas 17592186314848 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=-\\frac{1}{3},$ we will use a step size of\n\n$$\nΔx=-\\frac{1}{3}-(-1)=\\frac{2}{3}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(4x-3y+(4{x}_{\\text{new}}-3{y}_{\\text{new}}))\\cdot \\frac{2}{3} \\\\  & =\\frac{1}{3}(4x-3y+4{x}_{\\text{new}}-3{y}_{\\text{new}}) \\\\  & =\\frac{1}{3}(4x+4{x}_{\\text{new}}-3y)-{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{3}(4x+4{x}_{\\text{new}}-3y)-{y}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{1}{3}(4x+4{x}_{\\text{new}})-{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}2{y}_{\\text{new}} & =\\frac{4}{3}(x+{x}_{\\text{new}}) \\\\ {y}_{\\text{new}} & =\\frac{2}{3}(x+{x}_{\\text{new}})\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=-1+\\frac{2}{3}=-\\frac{1}{3}.$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{2}{3}(x+{x}_{\\text{new}}) \\\\  & =\\frac{2}{3}(-1+\\left(-\\frac{1}{3}\\right)) \\\\  & =-\\frac{8}{9} \\\\  & ≈-0.89.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(-\\frac{1}{3}\\right)≈-0.89.$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=-\\frac{1}{3},$ we will use a step size of\n\n$$\nΔx=-\\frac{1}{3}-(-1)=\\frac{2}{3}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(4x-3y+(4{x}_{\\text{new}}-3{y}_{\\text{new}}))\\cdot \\frac{2}{3} \\\\  & =\\frac{1}{3}(4x-3y+4{x}_{\\text{new}}-3{y}_{\\text{new}}) \\\\  & =\\frac{1}{3}(4x+4{x}_{\\text{new}}-3y)-{y}_{\\text{new}}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{3}(4x+4{x}_{\\text{new}}-3y)-{y}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{1}{3}(4x+4{x}_{\\text{new}})-{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}2{y}_{\\text{new}} & =\\frac{4}{3}(x+{x}_{\\text{new}}) \\\\ {y}_{\\text{new}} & =\\frac{2}{3}(x+{x}_{\\text{new}})\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is $$\n\\displaystyle {x}_{\\text{new}}=-1+\\frac{2}{3}=-\\frac{1}{3}.\n$$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{2}{3}(x+{x}_{\\text{new}}) \\\\  & =\\frac{2}{3}(-1+\\left(-\\frac{1}{3}\\right)) \\\\  & =-\\frac{8}{9} \\\\  & ≈-0.89.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(-\\frac{1}{3}\\right)≈-0.89.$"] [:db/cas 17592186314850 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=-\\frac{1}{2},$ we will use a step size of\n\n$$\nΔx=-\\frac{1}{2}-(-1)=\\frac{1}{2}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(y({x}^{2}+1)+{y}_{\\text{new}}(({x}_{\\text{new}})^{2}+1))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{4}y({x}^{2}+1)+\\frac{1}{4}{y}_{\\text{new}}(({x}_{\\text{new}})^{2}+1).\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{4}y({x}^{2}+1)+\\frac{1}{4}{y}_{\\text{new}}(({x}_{\\text{new}})^{2}+1) \\\\ {y}_{\\text{new}} & =\\frac{1}{4}y({x}^{2}+5)+\\frac{1}{4}{y}_{\\text{new}}({x}_{\\text{new}})^{2}+\\frac{1}{4}{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}\\frac{3}{4}{y}_{\\text{new}}-\\frac{1}{4}{y}_{\\text{new}}({x}_{\\text{new}})^{2} & =\\frac{1}{4}y({x}^{2}+5) \\\\ \\frac{1}{4}{y}_{\\text{new}}(3-({x}_{\\text{new}})^{2}) & =\\frac{1}{4}y({x}^{2}+5) \\\\ {y}_{\\text{new}} & =\\frac{y({x}^{2}+5)}{3-({x}_{\\text{new}})^{2}}\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=-1+\\frac{1}{2}=-\\frac{1}{2}.$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{y({x}^{2}+5)}{3-({x}_{\\text{new}})^{2}} \\\\  & =\\frac{\\frac{11}{3}((-1)^{2}+5)}{3-{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\frac{22}{\\left(\\frac{11}{4}\\right)} \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(-\\frac{1}{2}\\right)≈8.00.$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nFirst, since we want to find the value of $y$ at $x=-\\frac{1}{2},$ we will use a step size of\n\n$$\nΔx=-\\frac{1}{2}-(-1)=\\frac{1}{2}.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(y({x}^{2}+1)+{y}_{\\text{new}}(({x}_{\\text{new}})^{2}+1))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{4}y({x}^{2}+1)+\\frac{1}{4}{y}_{\\text{new}}(({x}_{\\text{new}})^{2}+1).\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{4}y({x}^{2}+1)+\\frac{1}{4}{y}_{\\text{new}}(({x}_{\\text{new}})^{2}+1) \\\\ {y}_{\\text{new}} & =\\frac{1}{4}y({x}^{2}+5)+\\frac{1}{4}{y}_{\\text{new}}({x}_{\\text{new}})^{2}+\\frac{1}{4}{y}_{\\text{new}}\\end{aligned}\n$$\n\nThen, we solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}\\frac{3}{4}{y}_{\\text{new}}-\\frac{1}{4}{y}_{\\text{new}}({x}_{\\text{new}})^{2} & =\\frac{1}{4}y({x}^{2}+5) \\\\ \\frac{1}{4}{y}_{\\text{new}}(3-({x}_{\\text{new}})^{2}) & =\\frac{1}{4}y({x}^{2}+5) \\\\ {y}_{\\text{new}} & =\\frac{y({x}^{2}+5)}{3-({x}_{\\text{new}})^{2}}\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is $$\n\\displaystyle {x}_{\\text{new}}=-1+\\frac{1}{2}=-\\frac{1}{2}.\n$$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{y({x}^{2}+5)}{3-({x}_{\\text{new}})^{2}} \\\\  & =\\frac{\\frac{11}{3}((-1)^{2}+5)}{3-{\\left(-\\frac{1}{2}\\right)}^{2}} \\\\  & =\\frac{22}{\\left(\\frac{11}{4}\\right)} \\\\  & =8.\\end{aligned}\n$$\n\nTherefore, we conclude that $y\\,\\left(-\\frac{1}{2}\\right)≈8.00.$"] [:db/cas 17592186314854 :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{3}5{e}^{x}\\,\\text{d}x=$\n{{field-1}}" "Evaluate the following integral. Do not round the answer.\n\n$$\n\\displaystyle {\\int }_{0}^{3}5{e}^{x}\\,\\text{d}x=\n$$\n{{field-1}}"] [:db/cas 17592186314857 :question/problem "Calculate $\\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.$" "Calculate $$\n\\displaystyle \\int {e}^{-x}\\operatorname{cos}⁡(2x)\\,\\text{d}x.\n$$"] [:db/cas 17592186314858 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first three sample slopes, evaluated at the initial point and first intermediate points, are already computed. Now let's find the others.\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(1+1,\\,-1+\\frac{13}{4}\\cdot 1) \\\\  & =(2,\\frac{9}{4}).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =2{x}_{3}+{y}_{3} \\\\  & =2\\cdot 2+\\frac{9}{4} \\\\  & =\\frac{25}{4}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(1+2\\cdot \\frac{5}{2}+2\\cdot \\frac{13}{4}+\\frac{25}{4})\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot \\frac{75}{4} \\\\  & =\\frac{25}{8}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ | $\\frac{25}{8}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =1+1 \\\\  & =2 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =-1+\\frac{25}{8} \\\\  & =-\\frac{8}{8}+\\frac{25}{8} \\\\  & =\\frac{17}{8}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ | $\\frac{25}{8}$ |\n| $2$ | $\\frac{17}{8}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(2)≈\\frac{17}{8}.\\end{aligned}\n$$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $$\n\\displaystyle ({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),\n$$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $$\n\\displaystyle ({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),\n$$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first three sample slopes, evaluated at the initial point and first intermediate points, are already computed. Now let's find the others.\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(1+1,\\,-1+\\frac{13}{4}\\cdot 1) \\\\  & =(2,\\frac{9}{4}).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =2{x}_{3}+{y}_{3} \\\\  & =2\\cdot 2+\\frac{9}{4} \\\\  & =\\frac{25}{4}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(1+2\\cdot \\frac{5}{2}+2\\cdot \\frac{13}{4}+\\frac{25}{4})\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot \\frac{75}{4} \\\\  & =\\frac{25}{8}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ | $\\frac{25}{8}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =1+1 \\\\  & =2 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =-1+\\frac{25}{8} \\\\  & =-\\frac{8}{8}+\\frac{25}{8} \\\\  & =\\frac{17}{8}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ | $\\frac{25}{8}$ |\n| $2$ | $\\frac{17}{8}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(2)≈\\frac{17}{8}.\\end{aligned}\n$$"] [:db/cas 17592186314859 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first three sample slopes, evaluated at the initial point and first intermediate points, are already computed. Now let's find the others.\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2},\\,2+(-2)\\cdot \\frac{1}{2}) \\\\  & =(\\frac{1}{2},1).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =-2{x}_{3}-{y}_{3} \\\\  & =-2\\cdot \\frac{1}{2}-1 \\\\  & =-2.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $-2$ | $-2$ | $-2$ | $-2$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(-2+2\\cdot (-2)+2\\cdot (-2)+(-2))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{12}\\cdot (-12) \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $-2$ | $-2$ | $-2$ | $-2$ | $-1$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+\\frac{1}{2} \\\\  & =\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =2+(-1) \\\\  & =1\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $-2$ | $-2$ | $-2$ | $-2$ | $-1$ |\n| $\\,\\frac{1}{2}$ | $1$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,\\left(\\frac{1}{2}\\right)≈1.\\end{aligned}\n$$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $$\n\\displaystyle ({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),\n$$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $$\n\\displaystyle ({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),\n$$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first three sample slopes, evaluated at the initial point and first intermediate points, are already computed. Now let's find the others.\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2},\\,2+(-2)\\cdot \\frac{1}{2}) \\\\  & =(\\frac{1}{2},1).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =-2{x}_{3}-{y}_{3} \\\\  & =-2\\cdot \\frac{1}{2}-1 \\\\  & =-2.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $-2$ | $-2$ | $-2$ | $-2$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(-2+2\\cdot (-2)+2\\cdot (-2)+(-2))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{12}\\cdot (-12) \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $-2$ | $-2$ | $-2$ | $-2$ | $-1$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+\\frac{1}{2} \\\\  & =\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =2+(-1) \\\\  & =1\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $-2$ | $-2$ | $-2$ | $-2$ | $-1$ |\n| $\\,\\frac{1}{2}$ | $1$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,\\left(\\frac{1}{2}\\right)≈1.\\end{aligned}\n$$"] [:db/cas 17592186314860 :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first two sample slopes, evaluated at the initial point and first intermediate point, are already computed. Now let's find the others.\n\n- The second intermediate point is\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot 1,\\,1+\\frac{1}{2}\\cdot \\frac{5}{4}\\cdot 1) \\\\  & =(\\frac{1}{2},\\frac{13}{8}).\\end{aligned}\n$$\n\nSo, the second intermediate slope is\n\n$$\n\\begin{aligned}{y}_{2}^{′} & =2{x}_{2}{y}_{2}+({x}_{2})^{2} \\\\  & =2\\cdot \\frac{1}{2}\\cdot \\frac{13}{8}+{\\left(\\frac{1}{2}\\right)}^{2} \\\\  & =\\frac{15}{8}.\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $\\frac{5}{4}$ | $\\frac{15}{8}$ |  |  |\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(0+1,\\,1+\\frac{15}{8}\\cdot 1) \\\\  & =(1,\\frac{23}{8}).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =2{x}_{3}{y}_{3}+({x}_{3})^{2} \\\\  & =2\\cdot 1\\cdot \\frac{23}{8}+{1}^{2} \\\\  & =\\frac{27}{4}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $\\frac{5}{4}$ | $\\frac{15}{8}$ | $\\frac{27}{4}$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(0+2\\cdot \\frac{5}{4}+2\\cdot \\frac{15}{8}+\\frac{27}{4})\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot 13 \\\\  & =\\frac{13}{6}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $\\frac{5}{4}$ | $\\frac{15}{8}$ | $\\frac{27}{4}$ | $\\frac{13}{6}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+1 \\\\  & =1 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =1+\\frac{13}{6} \\\\  & =\\frac{19}{6}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $\\frac{5}{4}$ | $\\frac{15}{8}$ | $\\frac{27}{4}$ | $\\frac{13}{6}$ |\n| $1$ | $\\frac{19}{6}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(1)≈\\frac{19}{6}.\\end{aligned}\n$$" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $$\n\\displaystyle ({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),\n$$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $$\n\\displaystyle ({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),\n$$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first two sample slopes, evaluated at the initial point and first intermediate point, are already computed. Now let's find the others.\n\n- The second intermediate point is\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,\\,({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot 1,\\,1+\\frac{1}{2}\\cdot \\frac{5}{4}\\cdot 1) \\\\  & =(\\frac{1}{2},\\frac{13}{8}).\\end{aligned}\n$$\n\nSo, the second intermediate slope is\n\n$$\n\\begin{aligned}{y}_{2}^{′} & =2{x}_{2}{y}_{2}+({x}_{2})^{2} \\\\  & =2\\cdot \\frac{1}{2}\\cdot \\frac{13}{8}+{\\left(\\frac{1}{2}\\right)}^{2} \\\\  & =\\frac{15}{8}.\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $\\frac{5}{4}$ | $\\frac{15}{8}$ |  |  |\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx)