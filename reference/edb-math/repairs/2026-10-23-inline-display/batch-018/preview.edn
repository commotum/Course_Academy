ac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{4}{5}.$\n\nFinally, knowing that $$\n\\displaystyle \\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },\n$$ and $$\n\\displaystyle \\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\n$$ we have:\n\n- $$\n\\displaystyle \\operatorname{cot}⁡\\theta =\\frac{\\left(-\\frac{4}{5}\\right)}{\\left(\\frac{3}{5}\\right)}=-\\frac{4}{3}\n$$\n\n- $$\n\\displaystyle \\operatorname{tan}⁡\\theta =\\frac{\\left(\\frac{3}{5}\\right)}{\\left(-\\frac{4}{5}\\right)}=-\\frac{3}{4}.\n$$\n\nFinally, we have\n\n$$\n\\displaystyle \\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta =-\\frac{4}{3}-\\frac{3}{4}=-\\frac{25}{12}.\n$$" 13194139539078 17592186576411 true] [17592186329770 1074 "As $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ then $\\operatorname{sin}⁡\\theta =\\frac{1}{\\operatorname{csc}⁡\\theta }=\\frac{3}{5}.$\n\nLet's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/aa/aaba5af0542d29ef91d4b0e17907a81e32bccc402c48b32c205e7298630b5bc0.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{\\left(\\frac{3}{5}\\right)}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{25}} \\\\  & =\\pm \\sqrt{\\frac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{4}{5}.$\n\nFinally, knowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ and $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }$ we have:\n\n- $\\operatorname{cot}⁡\\theta =\\frac{\\left(-\\frac{4}{5}\\right)}{\\left(\\frac{3}{5}\\right)}=-\\frac{4}{3}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{\\left(\\frac{3}{5}\\right)}{\\left(-\\frac{4}{5}\\right)}=-\\frac{3}{4}.$\n\nFinally, we have\n\n$\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta =-\\frac{4}{3}-\\frac{3}{4}=-\\frac{25}{12}.$" 13194139539078 17592186576411 false] [17592186329799 1074 "To find the horizontal asymptote of a rational function, we divide every term in the numerator and denominator by the dominant term in the denominator, and then we let $x\\to \\infty .$\n\nIgnoring the coefficient, the dominant term in the denominator is ${x}^{3}.$ So, we divide every term in the numerator and denominator by ${x}^{3},$ as follows:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}+2x-3}{{x}^{3}-x} \\\\  & =\\frac{(\\frac{{x}^{2}}{{x}^{3}}+\\frac{2x}{{x}^{3}}-\\frac{3}{{x}^{3}})}{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{x}{{x}^{3}})} \\\\  & =\\frac{(\\frac{1}{x}+\\frac{2}{{x}^{2}}-\\frac{3}{{x}^{3}})}{(1-\\frac{1}{{x}^{2}})}\\end{aligned}\n$$\n\nNow, when $x$ is very large, the terms $$\n\\displaystyle \\frac{1}{x},\\frac{2}{{x}^{2}},\\frac{3}{{x}^{3}}\n$$ and $\\frac{1}{{x}^{2}}$ become very small. Therefore, as $x\\to \\infty ,$ we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{(\\frac{1}{x}+\\frac{2}{{x}^{2}}-\\frac{3}{{x}^{3}})}{(1-\\frac{1}{{x}^{2}})} \\\\  & \\to \\frac{0+0-0}{1-0} \\\\  & =0.\\end{aligned}\n$$\n\nSo, the horizontal asymptote is $y=0.$" 13194139539078 17592186576411 true] [17592186329799 1074 "To find the horizontal asymptote of a rational function, we divide every term in the numerator and denominator by the dominant term in the denominator, and then w