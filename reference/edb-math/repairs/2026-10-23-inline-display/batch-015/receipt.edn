^{-3x}\\,\\text{d}x & =-\\frac{x{e}^{-3x}}{3}+\\frac{1}{3}\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-\\frac{x{e}^{-3x}}{3}-\\frac{{e}^{-3x}}{9}+C\\end{aligned}\n$$" 13194139539092 17592186576411 true] [17592186259828 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x{e}^{-3x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{-3x}\\, & ⟹\\,v=-\\frac{{e}^{-3x}}{3}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{-3x}\\,\\text{d}x & =x\\cdot \\left(-\\frac{{e}^{-3x}}{3}\\right)-\\int \\left(-\\frac{{e}^{-3x}}{3}\\right)\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x{e}^{-3x}\\,\\text{d}x & =-\\frac{x{e}^{-3x}}{3}+\\frac{1}{3}\\int {e}^{-3x}\\,\\text{d}x \\\\  & =-\\frac{x{e}^{-3x}}{3}-\\frac{{e}^{-3x}}{9}+C\\end{aligned}\n$$" 13194139539092 17592186576411 false] [17592186259830 1071 "Calculate $$\n\\displaystyle \\int (3x+5){e}^{-5x}\\,\\text{d}x.\n$$" 13194139539092 17592186576411 true] [17592186259830 1071 "Calculate $\\int (3x+5){e}^{-5x}\\,\\text{d}x.$" 13194139539092 17592186576411 false] [17592186259830 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int (3x+5){e}^{-5x}\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=3x+5\\, & ⟹\\,{u}^{′}=3 \\\\ {v}^{′}={e}^{-5x}\\, & ⟹\\,v=-\\frac{{e}^{-5x}}{5}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (3x+5)\\cdot {e}^{-5x}\\,\\text{d}x & =(3x+5)\\cdot \\left(-\\frac{{e}^{-5x}}{5}\\right)-\\int \\left(-\\frac{{e}^{-5x}}{5}\\right)\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (3x+5){e}^{-5x}\\,\\text{d}x & =-\\frac{(3x+5){e}^{-5x}}{5}+\\frac{3}{5}\\int {e}^{-5x}\\,\\text{d}x \\\\  & =-\\frac{(3x+5){e}^{-5x}}{5}-\\frac{3{e}^{-5x}}{25}+C\\end{aligned}\n$$" 13194139539092 17592186576411 true] [17592186259830 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (3x+5){e}^{-5x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=3x+5\\, & ⟹\\,{u}^{′}=3 \\\\ {v}^{′}={e}^{-5x}\\, & ⟹\\,v=-\\frac{{e}^{-5x}}{5}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (3x+5)\\cdot {e}^{-5x}\\,\\text{d}x & =(3x+5)\\cdot \\left(-\\frac{{e}^{-5x}}{5}\\right)-\\int \\left(-\\frac{{e}^{-5x}}{5}\\right)\\cdot 3\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (3x+5){e}^{-5x}\\,\\text{d}x & =-\\frac{(3x+5){e}^{-5x}}{5}+\\frac{3}{5}\\int {e}^{-5x}\\,\\text{d}x \\\\  & =-\\frac{(3x+5){e}^{-5x}}{5}-\\frac{3{e}^{-5x}}{25}+C\\end{aligned}\n$$" 13194139539092 17592186576411 false] [17592186259831 1071 "Calculate the integral $$\n\\displaystyle \\int (x+7){e}^{2x+5}\\,\\text{d}x.\n$$" 13194139539092 17592186576411 true] [17592186259831 1071 "Calculate the integral $\\int (x+7){e}^{2x+5}\\,\\text{d}x.$" 13194139539092 17592186576411 false] [17592186259831 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\displaystyle \\int (x+7){e}^{2x+5}\\,\\text{d}x$ as $\\displaystyle \\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+7\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{2x+5}\\, & ⟹\\,v=\\frac{{e}^{2x+5}}{2}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+7)\\cdot {e}^{2x+5}\\,\\text{d}x & =(x+7)\\cdot \\frac{{e}^{2x+5}}{2}-\\int \\frac{{e}^{2x+5}}{2}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+7){e}^{2x+5}\\,\\text{d}x & =\\frac{(x+7){e}^{2x+5}}{2}-\\frac{1}{2}\\int {e}^{2x+5}\\,\\text{d}x \\\\  & =\\frac{(x+7){e}^{2x+5}}{2}-\\frac{{e}^{2x+5}}{4}+C\\end{aligned}\n$$" 13194139539092 17592186576411 true] [17592186259831 1074 "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (x+7){e}^{2x+5}\\,\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+7\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{2x+5}\\, & ⟹\\,v=\\frac{{e}^{2x+5}}{2}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+7)\\cdot {e}^{2x+5}\\,\\text{d}x & =(x+7)\\cdot \\frac{{e}^{2x+5}}{2}-\\int \\frac{{e}^{2x+5}}{2}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+7){e}^{2x+5}\\,\\text{d}x & =\\frac{(x+7){e}^{2x+5}}{2}-\\frac{1}{2}\\int {e}^{2x+5}\\,\\text{d}x \\\\  & =\\frac{(x+7){e}^{2x+5}}{2}-\\frac{{e}^{2x+5}}{4}+C\\end{aligned}\n$$" 13194139539092 17592186576411 false] [17592186259834 1074 "The circulation $Γ$ measures the total work done by a force $F$ in moving a particle along a *closed* curve $C.$\nIt is given by the formula\n\n$$\nΓ={∮}_{C}F\\cdot 