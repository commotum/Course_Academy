rac{\\pi}{4})\\cos x.$$\n\nEvaluating at $x=0$ gives $f'(0)=-\\sin\\left(\\frac{\\pi}{4}\\right)=- \\frac{\\sqrt{2}}{2}$.\n\nFinally, use the point-slope equation:\n\n$$y-\\left(\\frac{\\sqrt{2}}{2}\\right)=\\left(- \\frac{\\sqrt{2}}{2}\\right)(x-0),\\qquad y=- \\frac{\\sqrt{2} x}{2} + \\frac{\\sqrt{2}}{2}.$$" 13194139539078 17592186576411 false] [17592186484803 1074 "First, the slope of $y=f(x)$ at $x=0$ is given by $f'(0)$.\n\nWe calculate $f'(x)$ using the chain rule. First, express $f(x)$ as the composite function\n\n$$f=\\cos u,\\qquad u=\\sin{\\left(x \\right)} + \\frac{2 \\pi}{3}.$$\n\nDifferentiating gives\n\n$$\\frac{\\mathrm{d}f}{\\mathrm{d}u}=-\\sin u,\\qquad \\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\cos x.$$\n\nWe now apply the chain rule:\n\n$$f'(x)=\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x}=-\\sin(\\sin{\\left(x \\right)} + \\frac{2 \\pi}{3})\\cos x.$$\n\nEvaluating at $x=0$ gives $$\n\\displaystyle f'(0)=-\\sin\\left(\\frac{2 \\pi}{3}\\right)=- \\frac{\\sqrt{3}}{2}.\n$$\n\nFinally, use the point-slope equation:\n\n$$y-\\left(- \\frac{1}{2}\\right)=\\left(- \\frac{\\sqrt{3}}{2}\\right)(x-0),\\qquad y=- \\frac{\\sqrt{3} x}{2} - \\frac{1}{2}.$$" 13194139539078 17592186576411 true] [17592186484803 1074 "First, the slope of $y=f(x)$ at $x=0$ is given by $f'(0)$.\n\nWe calculate $f'(x)$ using the chain rule. First, express $f(x)$ as the composite function\n\n$$f=\\cos u,\\qquad u=\\sin{\\left(x \\right)} + \\frac{2 \\pi}{3}.$$\n\nDifferentiating gives\n\n$$\\frac{\\mathrm{d}f}{\\mathrm{d}u}=-\\sin u,\\qquad \\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\cos x.$$\n\nWe now apply the chain rule:\n\n$$f'(x)=\\frac{\\mathrm{d}f}{\\mathrm{d}u}\\cdot \\frac{\\mathrm{d}u}{\\mathrm{d}x}=-\\sin(\\sin{\\left(x \\right)} + \\frac{2 \\pi}{3})\\cos x.$$\n\nEvaluating at $x=0$ gives $f'(0)=-\\sin\\left(\\frac{2 \\pi}{3}\\right)=- \\frac{\\sqrt{3}}{2}$.\n\nFinally, use the point-slope equation:\n\n$$y-\\left(- \\frac{1}{2}\\right)=\\left(- \\frac{\\sqrt{