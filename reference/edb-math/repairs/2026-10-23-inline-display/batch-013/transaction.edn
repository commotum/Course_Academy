{2}]}_{0}^{1} \\\\  & =8[\\frac{2}{3}-\\frac{1}{2}-0] \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\n- Statement “${\\int }_{{C}_{2}}F\\cdot \\text{d}r=\\frac{16}{3},$ where ${C}_{2}$ is the path along the curve $y=\\sqrt{x},$ traversed from $O$ to $A.$” is true. Parameterizing the curve, we have\n\n$$\n{r}_{2}(t)=⟨{t}^{2},\\,t⟩,\\,t\\in [0,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}⟨{t}^{2},\\,-{t}^{2}⟩\\cdot ⟨2t,\\,1⟩\\text{d}t \\\\  & ={\\int }_{0}^{2}2{t}^{3}-{t}^{2}\\,\\text{d}t \\\\  & ={\\frac{{t}^{4}}{2}-\\frac{{t}^{3}}{3}|}_{0}^{2} \\\\  & =(\\frac{{2}^{4}}{2}-\\frac{{2}^{3}}{3})-0 \\\\  & =8-\\frac{8}{3} \\\\  & =\\frac{16}{3}.\\end{aligned}\n$$\n\n- Statement “${\\int }_{C}F\\cdot \\text{d}r$ is independent of path” is false. Since ${C}_{1}$ and ${C}_{2}$ have the same initial and terminal points, yet\n\n$$\n{\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne {\\int }_{{C}_{2}}F\\cdot \\text{d}r,\n$$\n\nwe conclude that ${\\int }_{C}F\\cdot \\text{d}r$ is path-dependent.\n\n- Statement “$F$ is conservative” is false. If a vector field is conservative then it is path-independent. Since $F$ is path-dependent, it is not conservative." "Let $C$ be a piecewise-smooth curve given by the vector-valued function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nThis theorem implies that the line integral of a conservative vector field depends only on the value of $f$ at the initial and terminal points $A$ and $B,$ and is independent of the path between them.\n\nWith that in mind, we consider each statement in turn.\n\n- Statement “$$\n\\displaystyle {\\int }_{{C}_{1}}F\\cdot \\text{d}r=\\frac{5}{6},\n$$ where ${C}_{1}$ is the path along the line segment $\\overset{―}{OA},$ traversed from $O$ to $A.$” is false. Parameterizing the line segment, we have\n\n$$\n{r}_{1}(t)=⟨4t,\\,2t⟩,\\,t\\in [0,1].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{1}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}⟨4{t}^{2},\\,-4t⟩\\cdot ⟨4,\\,2⟩\\text{d}t \\\\  & ={\\int }_{0}^{1}16{t}^{2}-8t\\,\\text{d}t \\\\  & =8\\,{\\int }_{0}^{1}2{t}^{2}-t\\,\\text{d}t \\\\  & =8{[\\frac{2{t}^{3}}{3}-\\frac{{t}^{2}}{2}]}_{0}^{1} \\\\  & =8[\\frac{2}{3}-\\frac{1}{2}-0] \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\n- Statement “$$\n\\displaystyle {\\int }_{{C}_{2}}F\\cdot \\text{d}r=\\frac{16}{3},\n$$ where ${C}_{2}$ is the path along the curve $y=\\sqrt{x},$ traversed from $O$ to $A.$” is true. Parameterizing the curve, we have\n\n$$\n{r}_{2}(t)=⟨{t}^{2},\\,t⟩,\\,t\\in [0,2].\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{{C}_{2}}F\\cdot \\text{d}r & ={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}⟨{t}^{2},\\,-{t}^{2}⟩\\cdot ⟨2t,\\,1⟩\\text{d}t \\\\  & ={\\int }_{0}^{2}2{t}^{3}-{t}^{2}\\,\\text{d}t \\\\  & ={\\frac{{t}^{4}}{2}-\\frac{{t}^{3}}{3}|}_{0}^{2} \\\\  & =(\\frac{{2}^{4}}{2}-\\frac{{2}^{3}}{3})-0 \\\\  & =8-\\frac{8}{3} \\\\  & =\\frac{16}{3}.\\end{aligned}\n$$\n\n- Statement “$$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ is independent of path” is false. Since ${C}_{1}$ and ${C}_{2}$ have the same initial and terminal points, yet\n\n$$\n{\\int }_{{C}_{1}}F\\cdot \\text{d}r\\ne {\\int }_{{C}_{2}}F\\cdot \\text{d}r,\n$$\n\nwe conclude that $$\n\\displaystyle {\\int }_{C}F\\cdot \\text{d}r\n$$ is path-dependent.\n\n- Statement “$F$ is conservative” is false. If a vector field is conservative then it is path-independent. Since $F$ is path-dependent, it is not conservative."] [:db/cas 17592186262571 :question/worked-solution "The coefficient of ${(x+\\frac{1}{3})}^{3}$ is $\\frac{1}{3!}{f}^{(3)}\\left(-\\frac{1}{3}\\right).$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-3x} \\\\ {f}^{′}(x) & =-3{e}^{-3x} \\\\ {f}^{″}(x) & =9{e}^{-3x} \\\\ {f}^{‴}(x) & =-27{e}^{-3x}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}\\left(-\\frac{1}{3}\\right),$ which gives\n\n$$\n{f}^{‴}\\left(-\\frac{1}{3}\\right)=-27\\cdot {e}^{-3\\cdot (-1/3)}=-27e.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}\\left(-\\frac{1}{3}\\right)=\\frac{1}{6}\\cdot (-27e)=-\\frac{9e}{2}.\n$$\n\nSo the coefficient of ${(x+\\frac{1}{3})}^{3}$ is $-\\frac{9e}{2}.$" "The coefficient of ${(x+\\frac{1}{3})}^{3}$ is $$\n\\displaystyle \\frac{1}{3!}{f}^{(3)}\\left(-\\frac{1}{3}\\right).\n$$ Let's compute the necessary derivatives:\n\n$$\n\\begin{aligned}f(x) & ={e}^{-3x} \\\\ {f}^{′}(x) & =-3{e}^{-3x} \\\\ {f}^{″}(x) & =9{e}^{-3x} \\\\ {f}^{‴}(x) & =-27{e}^{-3x}\\end{aligned}\n$$\n\nNext, we evaluate ${f}^{‴}\\left(-\\frac{1}{3}\\right),$ which gives\n\n$$\n{f}^{‴}\\left(-\\frac{1}{3}\\right)=-27\\cdot {e}^{-3\\cdot (-1/3)}=-27e.\n$$\n\nTherefore,\n\n$$\n\\frac{1}{3!}{f}^{‴}\\left(-\\frac{1}{3}\\right)=\\frac{1}{6}\\cdot (-27e)=-\\frac{9e}{2}.\n$$\n\nSo the coefficient of ${(x+\\frac{1}{3})}^{3}$ is $-\\frac{9e}{2}.$"] [:db/cas 17592186262573 :question/problem "Find the sum of the series $1+\\frac{e}{3}+\\frac{{e}^{2}}{9}+⋯+\\frac{{e}^{n}}{{3}^{n}}+⋯.$" "Find the sum of the series $$\n\\displaystyle 1+\\frac{e}{3}+\\frac{{e}^{2}}{9}+⋯+\\frac{{e}^{n}}{{3}^{n}}+⋯.\n$$"] [:db/cas 17592186262574 :question/problem "$1-\\frac{2}{e}+\\frac{4}{{e}^{2}}-⋯+\\frac{(-1)^{n}\\,{2}^{n}}{{e}^{n}}+⋯=$" "$$\n\\displaystyle 1-\\frac{2}{e}+\\frac{4}{{e}^{2}}-⋯+\\frac{(-1)^{n}\\,{2}^{n}}{{e}^{n}}+⋯=\n$$"] [:db/cas 17592186262581 :question/problem "Find the sum $1+\\sqrt{\\pi }+\\frac{\\pi }{2!}+\\frac{\\pi \\sqrt{\\pi }}{3!}+⋯+\\frac{(\\sqrt{\\pi })^{n}}{n!}+⋯.$" "Find the sum $$\n\\displaystyle 1+\\sqrt{\\pi }+\\frac{\\pi }{2!}+\\frac{\\pi \\sqrt{\\pi }}{3!}+⋯+\\frac{(\\sqrt{\\pi })^{n}}{n!}+⋯.\n$$"] [:db/cas 17592186262621 :question/problem "Find $Zx$ if \n$Z=\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}$\nand\n$x=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.$" "Find $Zx$ if \n$$\n\\displaystyle Z=\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle x=\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}.\n$$"] [:db/cas 17592186262621 :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}1\\cdot 1+(-4)\\cdot (-1) \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}5 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 2\\cdot 1+(-7)\\cdot (-1)\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$Zx=\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.$" "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}1\\cdot 1+(-4)\\cdot (-1) \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}5 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}1 & -4 \\\\ 2 & -7\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}5 \\\\ 2\\cdot 1+(-7)\\cdot (-1)\\end{bmatrix}=\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle Zx=\\begin{bmatrix}5 \\\\ 9\\end{bmatrix}.\n$$"] [:db/cas 17592186262622 :question/problem "Find $Xy$ if \n$X=\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}$\nand\n$y=\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}.$" "Find $Xy$ if \n$$\n\\displaystyle X=\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle y=\\begin{bmatrix}2 \\\\ 9\\end{bmatrix}.\n$$"] [:db/cas 17592186262622 :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}5\\cdot 2+(-2)\\cdot 9 \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}-8 \\\\ (-6)\\cdot 2+2\\cdot 9\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$Xy=\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}.$" "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}5\\cdot 2+(-2)\\cdot 9 \\\\ ∗\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ ∗\\end{bmatrix}.\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}\\begin{bmatrix}5 & -2 \\\\ -6 & 2\\end{bmatrix}\\begin{bmatrix}2 \\\\ 9\\end{bmatrix} & =\\begin{bmatrix}-8 \\\\ (-6)\\cdot 2+2\\cdot 9\\end{bmatrix}=\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle Xy=\\begin{bmatrix}-8 \\\\ 6\\end{bmatrix}.\n$$"] [:db/cas 17592186262636 :question/problem "![](images/83/831b2131cf134ec21def0014a3121429ded4cd3afd98dfd1660b1e78c1a9ba93.png)\n\nConsider the path $C$ shown above. Given that $F(x,y)=⟨y(x+1),\\,x(y+1)⟩,$ which of the following is equivalent to ${∮}_{C}F\\cdot dr\\,?$" "![](images/83/831b2131cf134ec21def0014a3121429ded4cd3afd98dfd1660b1e78c1a9ba93.png)\n\nConsider the path $C$ shown above. Given that $F(x,y)=⟨y(x+1),\\,x(y+1)⟩,$ which of the following is equivalent to $$\n\\displaystyle {∮}_{C}F\\cdot dr\\,?\n$$"] [:db/cas 17592186262637 :question/problem "![](images/8c/8cb15d895d5baf46d359d811fce99b73238434eb01079d1199cfd99d3f52f222.png)\n\nConsider the path $C$ shown above. Given that $F(x,y)=⟨{y}^{2}+{x}^{2},\\,xy+y{e}^{y}⟩,$ which of the following is equivalent to ${∮}_{C}F\\cdot dr\\,?$" "![](images/8c/8cb15d895d5baf46d359d811fce99b73238434eb01079d1199cfd99d3f52f222.png)\n\nConsider the path $C$ shown above. Given that $F(x,y)=⟨{y}^{2}+{x}^{2},\\,xy+y{e}^{y}⟩,$ which of the following is equivalent to $$\n\\displaystyle {∮}_{C}F\\cdot dr\\,?\n$$"] [:db/cas 17592186262640 :question/problem "Use Green's theorem to evaluate ${∮}_{C}F\\cdot dr,$ where $F(x,y)=⟨2-{x}^{2}y,1+x{y}^{2}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=25,$ oriented counterclockwise." "Use Green's theorem to evaluate $$\n\\displaystyle {∮}_{C}F\\cdot dr,\n$$ where $F(x,y)=⟨2-{x}^{2}y,1+x{y}^{2}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=25,$ oriented counterclockwise."] [:db/cas 17592186262641 :question/problem "Use Green's theorem to evaluate ${∮}_{C}F\\cdot dr,$ where $F(x,y)=⟨\\operatorname{sin}⁡x-2{x}^{2}y,\\text{ }\\,\\sqrt{y+3}+2x{y}^{2}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=1,$ oriented counterclockwise." "Use Green's theorem to evaluate $$\n\\displaystyle {∮}_{C}F\\cdot dr,\n$$ where $F(x,y)=⟨\\operatorname{sin}⁡x-2{x}^{2}y,\\text{ }\\,\\sqrt{y+3}+2x{y}^{2}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=1,$ oriented counterclockwise."] [:db/cas 17592186262647 :question/problem "![](images/21/21e8aa9acdca87acf153b2e7ad3f5e51d5708f53b81562e682e16098721d752a.png)\n\nEvaluate ${∮}_{C}({3}^{x}+{x}^{2}y)dx+({2}^{y}+x{y}^{2})\\,dy,$ where the path $C$ is shown above." "![](images/21/21e8aa9acdca87acf153b2e7ad3f5e51d5708f53b81562e682e16098721d752a.png)\n\nEvaluate $$\n\\displaystyle {∮}_{C}({3}^{x}+{x}^{2}y)dx+({2}^{y}+x{y}^{2})\\,dy,\n$$ where the path $C$ is shown above."] [:db/cas 17592186262648 :question/problem "Use Green's theorem to evaluate ${∮}_{C}F\\cdot dr,$ where $F(x,y)=⟨{4}^{x}-{y}^{3}+2,\\,\\frac{2}{{y}^{2}+1}+{x}^{3}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=2,$ oriented counterclockwise." "Use Green's theorem to evaluate $$\n\\displaystyle {∮}_{C}F\\cdot dr,\n$$ where $F(x,y)=⟨{4}^{x}-{y}^{3}+2,\\,\\frac{2}{{y}^{2}+1}+{x}^{3}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=2,$ oriented counterclockwise."] [:db/cas 17592186262649 :question/problem "![](images/d6/d675e8d06f2037531a2eec3a7e48374bb0d2e5cb59adfee0cbee5ce3a23add67.png)\n\nEvaluate ${∮}_{C}({e}^{x}-2{x}^{2}y)dx+({e}^{y}+2x{y}^{2})\\,dy,$ where the path $C$ is shown above." "![](images/d6/d675e8d06f2037531a2eec3a7e48374bb0d2e5cb59adfee0cbee5ce3a23add67.png)\n\nEvaluate $$\n\\displaystyle {∮}_{C}({e}^{x}-2{x}^{2}y)dx+({e}^{y}+2x{y}^{2})\\,dy,\n$$ where the path $C$ is shown above."] [:db/cas 17592186262650 :question/problem "![](images/bc/bcdc0f59fa284c2b1f1621e7de057ef6f0e084d2eca6732fbc5eae3f74ede113.png)\n\nEvaluate ${∮}_{C}(\\sqrt{5+x}-3{x}^{2}y)dx+({e}^{-{y}^{2}}+3x{y}^{2})\\,dy,$ where the path $C$ is shown above." "![](images/bc/bcdc0f59fa284c2b1f1621e7de057ef6f0e084d2eca6732fbc5eae3f74ede113.png)\n\nEvaluate $$\n\\displaystyle {∮}_{C}(\\sqrt{5+x}-3{x}^{2}y)dx+({e}^{-{y}^{2}}+3x{y}^{2})\\,dy,\n$$ where the path $C$ is shown above."] [:db/cas 17592186262651 :question/problem "Use Green's theorem to evaluate ${∮}_{C}F\\cdot dr,$ where $F(x,y)=⟨\\frac{\\sqrt{x+5}-{y}^{3}}{3},\\frac{\\sqrt{y+5}+{x}^{3}}{3}⟩$ and $C$ is the circle ${x}^{2}+{y}^{2}=4,$ oriented counterclockwise." "Use Green's theorem to evaluate $$\n\\displaystyle {∮}_{C}F\\cdot dr,\n$$ where $$\n\\displaystyle F(x,y)=⟨\\frac{\\sqrt{x+5}-{y}^{3}}{3},\\frac{\\sqrt{y+5}+{x}^{3}}{3}⟩\n$$ and $C$ is the circle ${x}^{2}+{y}^{2}=4,$ oriented counterclockwise."] [:db/cas 17592186262689 :question/problem "Calculate $\\int 5{x}^{2}{e}^{3x}\\,\\text{d}x.$" "Calculate $$\n\\displaystyle \\int 5{x}^{2}{e}^{3x}\\,\\text{d}x.\n$$"] [:db/cas 17592186262689 :question/worked-solution "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=5{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=10x \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{3x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{3x}\\,\\text{d}x=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 5{x}^{2}{e}^{3x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(5{x}^{2})\\left(\\frac{{e}^{3x}}{3}\\right)-\\int \\left(\\frac{{e}^{3x}}{3}\\right)(10x)\\,\\text{d}x \\\\  & =\\frac{5{x}^{2}{e}^{3x}}{3}-\\frac{10}{3}\\int x{e}^{3x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{e}^{3x}\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{3x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{3x}\\,\\text{d}x=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{3x}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x\\left(\\frac{{e}^{3x}}{3}\\right)-\\int \\left(\\frac{{e}^{3x}}{3}\\right)(1)\\,\\text{d}x \\\\  & =\\frac{x{e}^{3x}}{3}-\\frac{1}{3}\\int {e}^{3x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{3x}}{3}-\\frac{{e}^{3x}}{9}+D \\\\  & =\\frac{{e}^{3x}}{9}(3x-1)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 5{x}^{2}{e}^{3x}\\,\\text{d}x & =\\frac{5{x}^{2}{e}^{3x}}{3}-\\frac{10}{3}(\\frac{{e}^{3x}}{9}(3x-1)+D) \\\\  & =\\frac{5{x}^{2}{e}^{3x}}{3}-\\frac{10{e}^{3x}}{27}(3x-1)-\\frac{10D}{3} \\\\  & =\\frac{5{e}^{3x}}{27}(9{x}^{2}-6x+2)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{10D}{3}.$" "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=5{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=10x \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{3x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{3x}\\,\\text{d}x=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 5{x}^{2}{e}^{3x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(5{x}^{2})\\left(\\frac{{e}^{3x}}{3}\\right)-\\int \\left(\\frac{{e}^{3x}}{3}\\right)(10x)\\,\\text{d}x \\\\  & =\\frac{5{x}^{2}{e}^{3x}}{3}-\\frac{10}{3}\\int x{e}^{3x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int x{e}^{3x}\\,\\text{d}x.\n$$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{3x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{3x}\\,\\text{d}x=\\frac{{e}^{3x}}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{3x}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x\\left(\\frac{{e}^{3x}}{3}\\right)-\\int \\left(\\frac{{e}^{3x}}{3}\\right)(1)\\,\\text{d}x \\\\  & =\\frac{x{e}^{3x}}{3}-\\frac{1}{3}\\int {e}^{3x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{3x}}{3}-\\frac{{e}^{3x}}{9}+D \\\\  & =\\frac{{e}^{3x}}{9}(3x-1)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int 5{x}^{2}{e}^{3x}\\,\\text{d}x & =\\frac{5{x}^{2}{e}^{3x}}{3}-\\frac{10}{3}(\\frac{{e}^{3x}}{9}(3x-1)+D) \\\\  & =\\frac{5{x}^{2}{e}^{3x}}{3}-\\frac{10{e}^{3x}}{27}(3x-1)-\\frac{10D}{3} \\\\  & =\\frac{5{e}^{3x}}{27}(9{x}^{2}-6x+2)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{10D}{3}.$"] [:db/cas 17592186262705 :question/problem "Consider the straight line with the canonical equation $\\frac{x-4}{3}=\\frac{y-7}{-1}=\\frac{z+6}{-7}.$ Find the vector equation of the line." "Consider the straight line with the canonical equation $$\n\\displaystyle \\frac{x-4}{3}=\\frac{y-7}{-1}=\\frac{z+6}{-7}.\n$$ Find the vector equation of the line."] [:db/cas 17592186262707 :question/problem "Find the parametric equations of the line $\\frac{x-10}{7}=\\frac{y+8}{-4}=\\frac{z+1}{11}.$" "Find the parametric equations of the line $$\n\\displaystyle \\frac{x-10}{7}=\\frac{y+8}{-4}=\\frac{z+1}{11}.\n$$"] [:db/cas 17592186262709 :question/problem "Calculate the integral $\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x.$" "Calculate the integral $$\n\\displaystyle \\int ({log}_{3}⁡x)^{2}\\,\\text{d}x.\n$$"] [:db/cas 17592186262709 :question/worked-solution "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{3}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{3}⁡x)}^{2}(x)-\\int (x)\\left(\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3}\\right)\\,\\text{d}x \\\\  & =x{({log}_{3}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡3}\\int {log}_{3}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{3}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{3}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡(x))(x)-\\int (x)\\left(\\frac{1}{x\\operatorname{ln}⁡3}\\right)\\,\\text{d}x \\\\  & =x{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\int \\,\\text{d}x \\\\  & =x{log}_{3}⁡(x)-\\frac{x}{\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x & =x{({log}_{3}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡3}(x{log}_{3}⁡(x)-\\frac{x}{\\operatorname{ln}⁡3}+D) \\\\  & =x{({log}_{3}⁡x)}^{2}-\\frac{2x{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2x}{{ln}^{2}⁡3}-\\frac{2D}{\\operatorname{ln}⁡3} \\\\  & =x({({log}_{3}⁡x)}^{2}-\\frac{2{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2}{{ln}^{2}⁡3})+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡3}.$" "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{3}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{3}⁡x)}^{2}(x)-\\int (x)\\left(\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3}\\right)\\,\\text{d}x \\\\  & =x{({log}_{3}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡3}\\int {log}_{3}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $$\n\\displaystyle \\int {log}_{3}⁡(x)\\,\\text{d}x.\n$$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{3}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡(x))(x)-\\int (x)\\left(\\frac{1}{x\\operatorname{ln}⁡3}\\right)\\,\\text{d}x \\\\  & =x{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\int \\,\\text{d}x \\\\  & =x{log}_{3}⁡(x)-\\frac{x}{\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x & =x{({log}_{3}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡3}(x{log}_{3}⁡(x)-\\frac{x}{\\operatorname{ln}⁡3}+D) \\\\  & =x{({log}_{3}⁡x)}^{2}-\\frac{2x{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2x}{{ln}^{2}⁡3}-\\frac{2D}{\\operatorname{ln}⁡3} \\\\  & =x({({log}_{3}⁡x)}^{2}-\\frac{2{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2}{{ln}^{2}⁡3})+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡3}.$"] [:db/cas 17592186262743 :question/problem "$\\begin{bmatrix}6 & -4 & -6 \\\\ -2 & 5 & 2 \\\\ -1 & -4 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1 \\\\ 2\\end{bmatrix}=$" "$$\n\\displaystyle \\begin{bmatrix}6 & -4 & -6 \\\\ -2 & 5 & 2 \\\\ -1 & -4 & 1\\end{bmatrix}\\begin{bmatrix}2 \\\\ -1 \\\\ 2\\end{bmatrix}=\n$$"] [:db/cas 17592186262745 :question/problem "Find the unit tangent vector to the curve $r(t)=\\operatorname{tan}⁡t\\,p(t)$ at the point corresponding to $t=\\frac{\\pi }{4}$, given that  $p\\left(\\frac{\\pi }{4}\\right)=i-\\frac{3}{2}\\,j+\\frac{\\sqrt{3}}{2}\\,k\\,$ and $\\,{p}^{′}\\left(\\frac{\\pi }{4}\\right)=\\sqrt{3}\\,k.$" "Find the unit tangent vector to the curve $r(t)=\\operatorname{tan}⁡t\\,p(t)$ at the point corresponding to $t=\\frac{\\pi }{4}$, given that  $$\n\\displaystyle p\\left(\\frac{\\pi }{4}\\right)=i-\\frac{3}{2}\\,j+\\frac{\\sqrt{3}}{2}\\,k\\,\n$$ and $\\,{p}^{′}\\left(\\frac{\\pi }{4}\\right)=\\sqrt{3}\\,k.$"] [:db/cas 17592186262745 :question/worked-solution "For a curve $r(t)=x(t)i+y(t)j+z(t)k$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{4}:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t\\,p(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t)\\cdot p(t)+\\operatorname{tan}⁡t\\cdot \\frac{\\text{d}}{\\text{d}t}(p(t)) \\\\  & ={sec}^{2}⁡t\\,p(t)+\\operatorname{tan}⁡t\\,{p}^{′}(t) \\\\ {r}^{′}\\left(\\frac{\\pi }{4}\\right) & ={sec}^{2}⁡\\left(\\frac{\\pi }{4}\\right)p\\left(\\frac{\\pi }{4}\\right)+\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right){p}^{′}\\left(\\frac{\\pi }{4}\\right) \\\\  & =2(i-\\frac{3}{2}\\,j+\\frac{\\sqrt{3}}{2}\\,k)+(1)(\\sqrt{3}\\,k) \\\\  & =(2\\,i-3\\,j+\\sqrt{3}\\,k)+\\sqrt{3}\\,k \\\\  & =2\\,i-3\\,j+2\\sqrt{3}\\,k\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}\\left(\\frac{\\pi }{4}\\right):$ \n\n$$\n\\begin{aligned}‖r\\left(\\frac{\\pi }{4}\\right)‖ & =\\sqrt{(2)^{2}+(-3)^{2}+(2\\sqrt{3})^{2}} \\\\  & =\\sqrt{4+9+12} \\\\  & =5\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}\\left(\\frac{\\pi }{4}\\right):$  \n\n$$\n\\begin{aligned}T\\left(\\frac{\\pi }{4}\\right) & =\\frac{{r}^{′}\\left(\\frac{\\pi }{4}\\right)}{‖{r}^{′}\\left(\\frac{\\pi }{4}\\right)‖} \\\\  & =\\frac{1}{5}\\cdot (2\\,i-3\\,j+2\\sqrt{3}\\,k) \\\\  & =\\frac{2}{5}\\,i-\\frac{3}{5}\\,j+\\frac{2\\sqrt{3}}{5}\\,k\\end{aligned}\n$$\n\nTherefore, the unit tangent vector to the curve at the point that corresponds to $t=\\frac{\\pi }{4}$ is\n $T\\left(\\frac{\\pi }{4}\\right)=\\frac{2}{5}\\,i-\\frac{3}{5}\\,j+\\frac{2\\sqrt{3}}{5}\\,k.$" "For a curve $r(t)=x(t)i+y(t)j+z(t)k$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{4}:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t\\,p(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t)\\cdot p(t)+\\operatorname{tan}⁡t\\cdot \\frac{\\text{d}}{\\text{d}t}(p(t)) \\\\  & ={sec}^{2}⁡t\\,p(t)+\\operatorname{tan}⁡t\\,{p}^{′}(t) \\\\ {r}^{′}\\left(\\frac{\\pi }{4}\\right) & ={sec}^{2}⁡\\left(\\frac{\\pi }{4}\\right)p\\left(\\frac{\\pi }{4}\\right)+\\operatorname{tan}⁡\\left(\\frac{\\pi }{4}\\right){p}^{′}\\left(\\frac{\\pi }{4}\\right) \\\\  & =2(i-\\frac{3}{2}\\,j+\\frac{\\sqrt{3}}{2}\\,k)+(1)(\\sqrt{3}\\,k) \\\\  & =(2\\,i-3\\,j+\\sqrt{3}\\,k)+\\sqrt{3}\\,k \\\\  & =2\\,i-3\\,j+2\\sqrt{3}\\,k\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}\\left(\\frac{\\pi }{4}\\right):$ \n\n$$\n\\begin{aligned}‖r\\left(\\frac{\\pi }{4}\\right)‖ & =\\sqrt{(2)^{2}+(-3)^{2}+(2\\sqrt{3})^{2}} \\\\  & =\\sqrt{4+9+12} \\\\  & =5\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}\\left(\\frac{\\pi }{4}\\right):$  \n\n$$\n\\begin{aligned}T\\left(\\frac{\\pi }{4}\\right) & =\\frac{{r}^{′}\\left(\\frac{\\pi }{4}\\right)}{‖{r}^{′}\\left(\\frac{\\pi }{4}\\right)‖} \\\\  & =\\frac{1}{5}\\cdot (2\\,i-3\\,j+2\\sqrt{3}\\,k) \\\\  & =\\frac{2}{5}\\,i-\\frac{3}{5}\\,j+\\frac{2\\sqrt{3}}{5}\\,k\\end{aligned}\n$$\n\nTherefore, the unit tangent vector to the curve at the point that corresponds to $t=\\frac{\\pi }{4}$ is\n $$\n\\displaystyle T\\left(\\frac{\\pi }{4}\\right)=\\frac{2}{5}\\,i-\\frac{3}{5}\\,j+\\frac{2\\sqrt{3}}{5}\\,k.\n$$"] [:db/cas 17592186262746 :question/problem "Find $Mz$ if \n$M=\\begin{bmatrix}s & t \\\\ -t & s\\end{bmatrix}$\nand\n$z=\\begin{bmatrix}s \\\\ t\\end{bmatrix}.$" "Find $Mz$ if \n$$\n\\displaystyle M=\\begin{bmatrix}s & t \\\\ -t & s\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle z=\\begin{bmatrix}s \\\\ t\\end{bmatrix}.\n$$"] [:db/cas 17592186262747 :question/problem "Find $Qg$ if \n$Q=\\begin{bmatrix}m & 2m \\\\ -m & n\\end{bmatrix}$\nand\n$g=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.$" "Find $Qg$ if \n$$\n\\displaystyle Q=\\begin{bmatrix}m & 2m \\\\ -m & n\\end{bmatrix}\n$$\nand\n$$\n\\displaystyle g=\\begin{bmatrix}-2 \\\\ 3\\end{bmatrix}.\n$$"] [:db/cas 17592186262748 :question/worked-solution "For a curve $r(t)=x(t)i+y(t)j+z(t)k$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=-\\frac{\\pi }{6}:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t\\,p(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)\\cdot p(t)+\\operatorname{cos}⁡2t\\cdot \\frac{\\text{d}}{\\text{d}t}(p(t)) \\\\  & =-2\\operatorname{sin}⁡2t\\,p(t)+\\operatorname{cos}⁡2t\\,{p}^{′}(t) \\\\ {r}^{′}\\left(-\\frac{\\pi }{6}\\right) & =-2\\operatorname{sin}⁡\\left(-\\frac{\\pi }{3}\\right)p\\left(-\\frac{\\pi }{6}\\right)+\\operatorname{cos}⁡\\left(-\\frac{\\pi }{3}\\right){p}^{′}\\left(-\\frac{\\pi }{6}\\right) \\\\  & =\\sqrt{3}(\\sqrt{3}\\,i+\\sqrt{3}\\,k)+\\frac{1}{2}(-2\\,i-8\\,j+4\\,k) \\\\  & =(3\\,i+3\\,k)+(-\\,i-4\\,j+2\\,k) \\\\  & =2\\,i-4\\,j+5\\,k\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}\\left(-\\frac{\\pi }{6}\\right):$ \n\n$$\n\\begin{aligned}‖{r}^{′}\\left(-\\frac{\\pi }{6}\\right)‖ & =\\sqrt{(2)^{2}+(-4)^{2}+(5)^{2}} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}\\left(-\\frac{\\pi }{6}\\right):$  \n\n$$\n\\begin{aligned}T\\left(-\\frac{\\pi }{6}\\right) & =\\frac{{r}^{′}\\left(-\\frac{\\pi }{6}\\right)}{‖{r}^{′}\\left(-\\frac{\\pi }{6}\\right)‖} \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot (2\\,i-4\\,j+5\\,k) \\\\  & =\\frac{2\\sqrt{5}}{15}\\,i-\\frac{4\\sqrt{5}}{15}\\,j+\\frac{\\sqrt{5}}{3}\\,k\\end{aligned}\n$$\n\nTherefore, the unit tangent vector to the curve at the point that corresponds to $t=-\\frac{\\pi }{6}$ is\n $T\\left(-\\frac{\\pi }{6}\\right)=\\frac{2\\sqrt{5}}{15}\\,i-\\frac{4\\sqrt{5}}{15}\\,j+\\frac{\\sqrt{5}}{3}\\,k.$" "For a curve $r(t)=x(t)i+y(t)j+z(t)k$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t),z(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find ${r}^{′}(t)$ and evaluate it at $t=-\\frac{\\pi }{6}:$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t\\,p(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)\\cdot p(t)+\\operatorname{cos}⁡2t\\cdot \\frac{\\text{d}}{\\text{d}t}(p(t)) \\\\  & =-2\\operatorname{sin}⁡2t\\,p(t)+\\operatorname{cos}⁡2t\\,{p}^{′}(t) \\\\ {r}^{′}\\left(-\\frac{\\pi }{6}\\right) & =-2\\operatorname{sin}⁡\\left(-\\frac{\\pi }{3}\\right)p\\left(-\\frac{\\pi }{6}\\right)+\\operatorname{cos}⁡\\left(-\\frac{\\pi }{3}\\right){p}^{′}\\left(-\\frac{\\pi }{6}\\right) \\\\  & =\\sqrt{3}(\\sqrt{3}\\,i+\\sqrt{3}\\,k)+\\frac{1}{2}(-2\\,i-8\\,j+4\\,k) \\\\  & =(3\\,i+3\\,k)+(-\\,i-4\\,j+2\\,k) \\\\  & =2\\,i-4\\,j+5\\,k\\end{aligned}\n$$\n\nNow, we calculate the magnitude of ${r}^{′}\\left(-\\frac{\\pi }{6}\\right):$ \n\n$$\n\\begin{aligned}‖{r}^{′}\\left(-\\frac{\\pi }{6}\\right)‖ & =\\sqrt{(2)^{2}+(-4)^{2}+(5)^{2}} \\\\  & =\\sqrt{45} \\\\  & =3\\sqrt{5}\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}\\left(-\\frac{\\pi }{6}\\right):$  \n\n$$\n\\begin{aligned}T\\left(-\\frac{\\pi }{6}\\right) & =\\frac{{r}^{′}\\left(-\\frac{\\pi }{6}\\right)}{‖{r}^{′}\\left(-\\frac{\\pi }{6}\\right)‖} \\\\  & =\\frac{1}{3\\sqrt{5}}\\cdot (2\\,i-4\\,j+5\\,k) \\\\  & =\\frac{2\\sqrt{5}}{15}\\,i-\\frac{4\\sqrt{5}}{15}\\,j+\\frac{\\sqrt{5}}{3}\\,k\\end{aligned}\n$$\n\nTherefore, the unit tangent vector to the curve at the point that corresponds to $t=-\\frac{\\pi }{6}$ is\n $$\n\\displaystyle T\\left(-\\frac{\\pi }{6}\\right)=\\frac{2\\sqrt{5}}{15}\\,i-\\frac{4\\sqrt{5}}{15}\\,j+\\frac{\\sqrt{5}}{3}\\,k.\n$$"] [:db/cas 17592186262750 :question/problem "If $L=\\begin{bmatrix}\\frac{1}{2} & 7 \\\\ \\frac{1}{4} & 3\\end{bmatrix}\\,$\nand\n$M=\\begin{bmatrix}-36 & 4