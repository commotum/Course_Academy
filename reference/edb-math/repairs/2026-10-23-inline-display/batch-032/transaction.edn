_{1}}({x}_{2}-{x}_{1}) & \\frac{∂}{∂{x}_{2}}({x}_{2}-{x}_{1}) & \\frac{∂}{∂{x}_{3}}({x}_{2}-{x}_{1})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{x}_{1} & 2{x}_{2} & 2{x}_{3} \\\\ -1 & 1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=\\begin{bmatrix}-2 & 2 & 0 \\\\ -1 & 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 2 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 2 & 0 \\\\ -1 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 6 & 0 \\\\ -3 & 3 & 0\\end{bmatrix}.\\end{aligned}\n$$" "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{2}.$ Thus, the total derivative of $f$ with respect to $y$ is a $2\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂{y}_{1}}(3{y}_{1}) & \\frac{∂}{∂{y}_{2}}(3{y}_{1}) \\\\ \\frac{∂}{∂{y}_{1}}(2{y}_{1}-{y}_{2}) & \\frac{∂}{∂{y}_{2}}(2{y}_{1}-{y}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 2 & -1\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at $$\n\\displaystyle {y}_{0}=y({x}_{0})=\\begin{bmatrix}(-1)^{2}+{1}^{2}+{0}^{2} \\\\ 1-(-1)\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 2\\end{bmatrix},\n$$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}3 & 0 \\\\ 2 & -1\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{3}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 3$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\begin{bmatrix}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} & \\frac{∂{y}_{1}}{∂{x}_{3}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}} & \\frac{∂{y}_{2}}{∂{x}_{3}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂{x}_{1}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) & \\frac{∂}{∂{x}_{3}}({x}_{1}^{2}+{x}_{2}^{2}+{x}_{3}^{2}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{2}-{x}_{1}) & \\frac{∂}{∂{x}_{2}}({x}_{2}-{x}_{1}) & \\frac{∂}{∂{x}_{3}}({x}_{2}-{x}_{1})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{x}_{1} & 2{x}_{2} & 2{x}_{3} \\\\ -1 & 1 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=\\begin{bmatrix}-1 \\\\ 1 \\\\ 0\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=\\begin{bmatrix}-2 & 2 & 0 \\\\ -1 & 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}3 & 0 \\\\ 2 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}-2 & 2 & 0 \\\\ -1 & 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}-6 & 6 & 0 \\\\ -3 & 3 & 0\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186666097 :question/problem "What is the minor of ${f}_{53}$ in  $F=\\begin{bmatrix}0 & -1 & 5 & -2 & \\sqrt{7} \\\\ 7 & 2 & 0 & \\sqrt{2} & 3 \\\\ 3 & 2 & 8 & 4 & -1 \\\\ 5 & \\sqrt{11} & 2 & 0 & 1 \\\\ 4 & 1 & 3 & 12 & 2\\end{bmatrix}?$" "What is the minor of ${f}_{53}$ in  $$\n\\displaystyle F=\\begin{bmatrix}0 & -1 & 5 & -2 & \\sqrt{7} \\\\ 7 & 2 & 0 & \\sqrt{2} & 3 \\\\ 3 & 2 & 8 & 4 & -1 \\\\ 5 & \\sqrt{11} & 2 & 0 & 1 \\\\ 4 & 1 & 3 & 12 & 2\\end{bmatrix}?\n$$"] [:db/cas 17592186666100 :question/problem "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{3},$ defined by\n\n$$\ny(x)=\\begin{bmatrix}{x}_{1}^{2}+{x}_{2}^{2} \\\\ {x}_{1}{x}_{2}\\end{bmatrix},\\,f(y)=\\begin{bmatrix}{y}_{1}^{2} \\\\ {y}_{2}^{2} \\\\ {y}_{1}^{2}+{y}_{2}^{2}\\end{bmatrix}.\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n${x}_{0}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}?$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$0$</td>\n<td align=\"center\" width=\"30px\">$4$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "Consider the functions $y:{R}^{2}\\to {R}^{2}$ and $f:{R}^{2}\\to {R}^{3},$ defined by\n\n$$\ny(x)=\\begin{bmatrix}{x}_{1}^{2}+{x}_{2}^{2} \\\\ {x}_{1}{x}_{2}\\end{bmatrix},\\,f(y)=\\begin{bmatrix}{y}_{1}^{2} \\\\ {y}_{2}^{2} \\\\ {y}_{1}^{2}+{y}_{2}^{2}\\end{bmatrix}.\n$$\n\nWhat is \n$\\frac{\\text{d}}{\\text{d}x}f(y(x))$ evaluated at \n$$\n\\displaystyle {x}_{0}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}?\n$$\n\n<table cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"70px\" rowspan=\"3\" width=\"30px\">\n${\\frac{\\text{d}}{\\text{d}x}f(y(x))|}_{{x}_{0}}=\\,\\,$\n</td>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">$0$</td>\n<td align=\"center\" width=\"30px\">$4$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\" width=\"5px\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">{{field-1}}</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"35px\"></td>\n<td align=\"center\">{{field-2}}</td>\n<td align=\"center\">{{field-3}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>"] [:db/cas 17592186666100 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus, the total derivative of $f$ with respect to $y$ is a $3\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{3}}{∂{y}_{1}} & \\frac{∂{f}_{3}}{∂{y}_{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂{y}_{1}}({y}_{1}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{2}^{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}^{2}+{y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}+{y}_{2}^{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{y}_{1} & 0 \\\\ 0 & 2{y}_{2} \\\\ 2{y}_{1} & 2{y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at ${y}_{0}=y({x}_{0})=\\begin{bmatrix}{0}^{2}+{1}^{2} \\\\ 0\\cdot 1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}2 & 0 \\\\ 0 & 0 \\\\ 2 & 0\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\begin{bmatrix}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂{x}_{1}}({x}_{1}^{2}+{x}_{2}^{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}^{2}+{x}_{2}^{2}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}{x}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{x}_{1} & 2{x}_{2} \\\\ {x}_{2} & {x}_{1}\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=\\begin{bmatrix}0 & 2 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 0 \\\\ 2 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 2 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 4 \\\\ 0 & 0 \\\\ 0 & 4\\end{bmatrix}.\\end{aligned}\n$$" "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(y(x))=\\frac{\\text{d}f}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $f(y)\\in {R}^{3}.$ Thus, the total derivative of $f$ with respect to $y$ is a $3\\times 2$ matrix \n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}y} & =\\begin{bmatrix}\\frac{∂{f}_{1}}{∂{y}_{1}} & \\frac{∂{f}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{y}_{1}} & \\frac{∂{f}_{2}}{∂{y}_{2}} \\\\ \\frac{∂{f}_{3}}{∂{y}_{1}} & \\frac{∂{f}_{3}}{∂{y}_{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂{y}_{1}}({y}_{1}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{2}^{2}) \\\\ \\frac{∂}{∂{y}_{1}}({y}_{1}^{2}+{y}_{2}^{2}) & \\frac{∂}{∂{y}_{2}}({y}_{1}^{2}+{y}_{2}^{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{y}_{1} & 0 \\\\ 0 & 2{y}_{2} \\\\ 2{y}_{1} & 2{y}_{2}\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at $$\n\\displaystyle {y}_{0}=y({x}_{0})=\\begin{bmatrix}{0}^{2}+{1}^{2} \\\\ 0\\cdot 1\\end{bmatrix}=\\begin{bmatrix}1 \\\\ 0\\end{bmatrix},\n$$ we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}2 & 0 \\\\ 0 & 0 \\\\ 2 & 0\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus, the total derivative of $y$ with respect to $x$ is a $2\\times 2$ matrix\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\begin{bmatrix}\\frac{∂{y}_{1}}{∂{x}_{1}} & \\frac{∂{y}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{y}_{2}}{∂{x}_{1}} & \\frac{∂{y}_{2}}{∂{x}_{2}}\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\frac{∂}{∂{x}_{1}}({x}_{1}^{2}+{x}_{2}^{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}^{2}+{x}_{2}^{2}) \\\\ \\frac{∂}{∂{x}_{1}}({x}_{1}{x}_{2}) & \\frac{∂}{∂{x}_{2}}({x}_{1}{x}_{2})\\end{bmatrix} \\\\  & =\\begin{bmatrix}2{x}_{1} & 2{x}_{2} \\\\ {x}_{2} & {x}_{1}\\end{bmatrix}.\\end{aligned}\n$$\n\nEvaluating at ${x}_{0}=\\begin{bmatrix}0 \\\\ 1\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}}=\\begin{bmatrix}0 & 2 \\\\ 1 & 0\\end{bmatrix}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(y(x)){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}2 & 0 \\\\ 0 & 0 \\\\ 2 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}0 & 2 \\\\ 1 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 4 \\\\ 0 & 0 \\\\ 0 & 4\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186666109 :question/worked-solution "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax &=b\\,⟹\\,\\underbrace{(LU)}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL\\underbrace{(Ux)}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -1 \\\\ -5\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=1 \\\\ 3{y}_{1}+{y}_{2} &=-1 \\\\ 4{y}_{1}+3{y}_{2}+{y}_{3} &=-5.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =1, \\\\ {y}_{2} & =-1-3{y}_{1} \\\\  & =-1-3(1) \\\\  & =-4, \\\\ {y}_{3} & =-5-4{y}_{1}-3{y}_{2} \\\\  & =-5-4(1)-3(-4) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, \n$y=\\begin{bmatrix}1 \\\\ -4 \\\\ 3\\end{bmatrix}.$" "First, notice that since $A=LU,$ we can write\n\n$$\n\\begin{aligned}Ax &=b\\,⟹\\,\\underbrace{(LU)}_{A}x=b.\\end{aligned}\n$$\n\nNow, setting $Ux=y,$ we obtain\n\n$$\nL\\underbrace{(Ux)}_{y}=b\\,⟹\\,\\left\\{\\begin{aligned}Ly &=b \\\\ Ux &=y.\\end{aligned}\\right.\n$$\n\nWe now solve $Ly=b.$ Writing this equation in matrix form, we get\n\n$$\n\\begin{bmatrix}1 & 0 & 0 \\\\ 3 & 1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}\\begin{bmatrix}{y}_{1} \\\\ {y}_{2} \\\\ {y}_{3}\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -1 \\\\ -5\\end{bmatrix}.\n$$\n\nThis gives the system of equations\n\n$$\n\\left\\{\\begin{aligned}{y}_{1} &=1 \\\\ 3{y}_{1}+{y}_{2} &=-1 \\\\ 4{y}_{1}+3{y}_{2}+{y}_{3} &=-5.\\end{aligned}\\right.\n$$\n\nWe can compute the solution to this system using forward substitution, as follows:\n\n$$\n\\begin{aligned}{y}_{1} & =1, \\\\ {y}_{2} & =-1-3{y}_{1} \\\\  & =-1-3(1) \\\\  & =-4, \\\\ {y}_{3} & =-5-4{y}_{1}-3{y}_{2} \\\\  & =-5-4(1)-3(-4) \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, \n$$\n\\displaystyle y=\\begin{bmatrix}1 \\\\ -4 \\\\ 3\\end{bmatrix}.\n$$"] [:db/cas 17592186666129 :question/problem "Find the shortest distance between the lines ${l}_{1}$ and ${l}_{2}$ with equations\n\n$\\,$ $\\frac{x-7}{8}=\\frac{y+3}{-1}=\\frac{z+7}{6}\\,$ and $\\,\\left\\{\\begin{aligned}x &=-12+8t \\\\ y &=6-t \\\\ z &=3+6t\\end{aligned}\\right.$" "Find the shortest distance between the lines ${l}_{1}$ and ${l}_{2}$ with equations\n\n$\\,$ $$\n\\displaystyle \\frac{x-7}{8}=\\frac{y+3}{-1}=\\frac{z+7}{6}\\,\n$$ and $$\n\\displaystyle \\,\\left\\{\\begin{aligned}x &=-12+8t \\\\ y &=6-t \\\\ z &=3+6t\\end{aligned}\\right.\n$$"] [:db/cas 17592186666131 :question/problem "${\\int }_{0}^{1}\\frac{4x-3}{2x+1}\\,\\text{d}x=$" "$$\n\\displaystyle {\\int }_{0}^{1}\\frac{4x-3}{2x+1}\\,\\text{d}x=\n$$"] [:db/cas 17592186666135 :question/problem "Given that the sequence ${a}_{n}$ is defined by\n\n$$\n{a}_{n}=\\{\\begin{aligned}2,\\,1\\le n\\le 10 \\\\ 0,\\,n\\ge 11,\\end{aligned}\n$$\n\ndoes ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge? If it converges, what is the sum of the series?" "Given that the sequence ${a}_{n}$ is defined by\n\n$$\n{a}_{n}=\\{\\begin{aligned}2,\\,1\\le n\\le 10 \\\\ 0,\\,n\\ge 11,\\end{aligned}\n$$\n\ndoes $$\n\\displaystyle {\\sum }_{n=1}^{\\infty }{a}_{n}\n$$ converge or diverge? If it converges, what is the sum of the series?"] [:db/cas 17592186666135 :question/worked-solution "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =2 \\\\ {s}_{2} & =2+2=2\\cdot 2 \\\\ {s}_{3} & =2\\cdot 2+2=3\\cdot 2 \\\\ {s}_{4} & =3\\cdot 2+2=4\\cdot 2\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum for $1\\le n\\le 10$ is ${s}_{n}=2n.$ In particular, ${s}_{10}=2\\cdot 10=20.$\n\nLet's compute the first few partial sums for $n\\ge 11:$ \n\n$$\n\\begin{aligned}{s}_{11} & =20+0=20 \\\\ {s}_{12} & =20+0=20 \\\\ {s}_{13} & =20+0=20\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum for $n\\ge 11$ is\n\n$$\n{s}_{n}=20.\n$$\n\nThe sequence of partial sums is convergent:\n\n$$\n{lim}_{n\\to \\infty }{s}_{n}={lim}_{n\\to \\infty }20=20\n$$\n\nTherefore, the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converges to $20.$" "Let's compute the first few partial sums:\n\n$$\n\\begin{aligned}{s}_{1} & =2 \\\\ {s}_{2} & =2+2=2\\cdot 2 \\\\ {s}_{3} & =2\\cdot 2+2=3\\cdot 2 \\\\ {s}_{4} & =3\\cdot 2+2=4\\cdot 2\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum for $1\\le n\\le 10$ is ${s}_{n}=2n.$ In particular, ${s}_{10}=2\\cdot 10=20.$\n\nLet's compute the first few partial sums for $n\\ge 11:$ \n\n$$\n\\begin{aligned}{s}_{11} & =20+0=20 \\\\ {s}_{12} & =20+0=20 \\\\ {s}_{13} & =20+0=20\\end{aligned}\n$$\n\nLooking at the sequence of partial sums, we can see that the formula for the $n$th partial sum for $n\\ge 11$ is\n\n$$\n{s}_{n}=20.\n$$\n\nThe sequence of partial sums is convergent:\n\n$$\n{lim}_{n\\to \\infty }{s}_{n}={lim}_{n\\to \\infty }20=20\n$$\n\nTherefore, the series $$\n\\displaystyle {\\sum }_{n=1}^{\\infty }{a}_{n}\n$$ converges to $20.$"] [:db/cas 17592186666137 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=\\begin{bmatrix}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{bmatrix}=\\begin{bmatrix}3{y}_{1}^{2} & 0 \\\\ 0 & 3{y}_{2}^{2}\\end{bmatrix}.\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=\\begin{bmatrix}3 & -1 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}3(-1)^{2} & 0 \\\\ 0 & 3(0)^{2}\\end{bmatrix}=\\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ -3 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -1 \\\\ 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 & 0 \\\\ -9 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -1 \\\\ 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}45 & -15 \\\\ -27 & 9\\end{bmatrix}.\\end{aligned}\n$$" "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=\\begin{bmatrix}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{bmatrix}=\\begin{bmatrix}3{y}_{1}^{2} & 0 \\\\ 0 & 3{y}_{2}^{2}\\end{bmatrix}.\n$$\n\nEvaluating at $$\n\\displaystyle {y}_{0}=A{x}_{0}=\\begin{bmatrix}3 & -1 \\\\ 2 & 0\\end{bmatrix}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ 0\\end{bmatrix},\n$$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}3(-1)^{2} & 0 \\\\ 0 & 3(0)^{2}\\end{bmatrix}=\\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}5 & 4 \\\\ -3 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 0 \\\\ 0 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -1 \\\\ 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}15 & 0 \\\\ -9 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}3 & -1 \\\\ 2 & 0\\end{bmatrix} \\\\  & =\\begin{bmatrix}45 & -15 \\\\ -27 & 9\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186666144 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=\\begin{bmatrix}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{bmatrix}=\\begin{bmatrix}2{y}_{1} & -2{y}_{2} \\\\ -2{y}_{1} & 2{y}_{2}\\end{bmatrix}.\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=\\begin{bmatrix}3 & 2 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}8 \\\\ -1\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}2(8) & -2(-1) \\\\ -2(8) & 2(-1)\\end{bmatrix}=\\begin{bmatrix}16 & 2 \\\\ -16 & -2\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}16 & 2 \\\\ -16 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 32 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 88 & 76\\end{bmatrix}.\\end{aligned}\n$$" "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=\\begin{bmatrix}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{bmatrix}=\\begin{bmatrix}2{y}_{1} & -2{y}_{2} \\\\ -2{y}_{1} & 2{y}_{2}\\end{bmatrix}.\n$$\n\nEvaluating at $$\n\\displaystyle {y}_{0}=A{x}_{0}=\\begin{bmatrix}3 & 2 \\\\ -2 & 3\\end{bmatrix}\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}=\\begin{bmatrix}8 \\\\ -1\\end{bmatrix},\n$$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}2(8) & -2(-1) \\\\ -2(8) & 2(-1)\\end{bmatrix}=\\begin{bmatrix}16 & 2 \\\\ -16 & -2\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}1 & 1 \\\\ 2 & 0\\end{bmatrix}\\cdot \\begin{bmatrix}16 & 2 \\\\ -16 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 32 & 4\\end{bmatrix}\\cdot \\begin{bmatrix}3 & 2 \\\\ -2 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ 88 & 76\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186666147 :question/problem "Consider the matrix \n$H=\\begin{bmatrix}3 & -2 & 1 \\\\ -6 & 4 & -1 \\\\ 9 & -6 & 1\\end{bmatrix}.$ \nFind a basis $B$ of $\\text{Col}(H).$" "Consider the matrix \n$$\n\\displaystyle H=\\begin{bmatrix}3 & -2 & 1 \\\\ -6 & 4 & -1 \\\\ 9 & -6 & 1\\end{bmatrix}.\n$$ \nFind a basis $B$ of $\\text{Col}(H).$"] [:db/cas 17592186666148 :question/worked-solution "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=\\begin{bmatrix}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{bmatrix}=\\begin{bmatrix}{y}_{2} & {y}_{1} \\\\ -{y}_{2} & -{y}_{1}\\end{bmatrix}.\n$$\n\nEvaluating at ${y}_{0}=A{x}_{0}=\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}-2 & 0 \\\\ 0 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 & -2 \\\\ 5 & 1\\end{bmatrix}.\\end{aligned}\n$$" "Using the chain rule, we have\n\n$$\n\\frac{\\text{d}}{\\text{d}x}f(z(y(x)))=\\frac{\\text{d}f}{\\text{d}z}\\cdot \\frac{\\text{d}z}{\\text{d}y}\\cdot \\frac{\\text{d}y}{\\text{d}x}.\n$$\n\nLet's consider each of the factors in turn.\n\n- The function $f$ acts on a vector $z\\in {R}^{2}$ by multiplying it by $C$ and outputs a vector $f(z)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}f}{\\text{d}z}=C.\n$$\n\n- The function $z$ acts on a vector $y\\in {R}^{2}$ and outputs a vector $z(y)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}=\\begin{bmatrix}\\frac{∂{z}_{1}}{∂{y}_{1}} & \\frac{∂{z}_{1}}{∂{y}_{2}} \\\\ \\frac{∂{z}_{2}}{∂{y}_{1}} & \\frac{∂{z}_{2}}{∂{y}_{2}}\\end{bmatrix}=\\begin{bmatrix}{y}_{2} & {y}_{1} \\\\ -{y}_{2} & -{y}_{1}\\end{bmatrix}.\n$$\n\nEvaluating at $$\n\\displaystyle {y}_{0}=A{x}_{0}=\\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix}\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}=\\begin{bmatrix}2 \\\\ 1\\end{bmatrix},\n$$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}=\\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}.\n$$\n\n- The function $y$ acts on a vector $x\\in {R}^{2}$ by multiplying it by $A$ and outputs a vector $y(x)\\in {R}^{2}.$ Thus,\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=A.\n$$\n\nTherefore, we have \n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}f(z(y(x))){|}_{{x}_{0}} & =\\frac{\\text{d}f}{\\text{d}z}{|}_{{z}_{0}}\\cdot \\frac{\\text{d}z}{\\text{d}y}{|}_{{y}_{0}}\\cdot \\frac{\\text{d}y}{\\text{d}x}{|}_{{x}_{0}} \\\\  & =\\begin{bmatrix}-2 & 0 \\\\ 0 & -1\\end{bmatrix}\\cdot \\begin{bmatrix}1 & 2 \\\\ -1 & -2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-2 & -4 \\\\ 1 & 2\\end{bmatrix}\\cdot \\begin{bmatrix}1 & -1 \\\\ 2 & 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 & -2 \\\\ 5 & 1\\end{bmatrix}.\\end{aligned}\n$$"] [:db/cas 17592186666921 :question/problem "What is the cycle type of the permutation \n$\\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 & 7 \\\\ 3 & 6 & 5 & 7 & 1 & 2 & 4\\end{pmatrix}?$" "What is the cycle type of the permutation \n$$\n\\displaystyle \\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 & 7 \\\\ 3 & 6 & 5 & 7 & 1 & 2 & 4\\end{pmatrix}?\n$$"] [:db/cas 17592186666931 :question/problem "What is the cycle type of the permutation \n$\\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 \\\\ 1 & 4 & 3 & 2 & 5 & 6\\end{pmatrix}?$" "What is the cycle type of the permutation \n$$\n\\displaystyle \\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 \\\\ 1 & 4 & 3 & 2 & 5 & 6\\end{pmatrix}?\n$$"] [:db/cas 17592186666937 :question/problem "What is the cycle type of the permutation \n$\\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 & 7 \\\\ 6 & 5 & 7 & 4 & 2 & 1 & 3\\end{pmatrix}?$" "What is the cycle type of the permutation \n$$\n\\displaystyle \\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 & 7 \\\\ 6 & 5 & 7 & 4 & 2 & 1 & 3\\end{pmatrix}?\n$$"] [:db/cas 17592186666948 :question/problem "What is the cycle type of the permutation \n$\\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 \\\\ 4 & 2 & 6 & 1 & 3 & 5\\end{pmatrix}?$" "What is the cycle type of the permutation \n$$\n\\displaystyle \\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 \\\\ 4 & 2 & 6 & 1 & 3 & 5\\end{pmatrix}?\n$$"] [:db/cas 17592186666949 :question/problem "What is the cycle type of the permutation \n$\\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 & 7 \\\\ 4 & 3 & 1 & 2 & 7 & 6 & 5\\end{pmatrix}?$" "What is the cycle type of the permutation \n$$\n\\displaystyle \\sigma =\\begin{pmatrix}1 & 2 & 3 & 4 & 5 & 6 & 7 \\\\ 4 & 3 & 1 & 2 & 7 & 6 & 5\\end{pmatrix}?\n$$"] [:db/cas 17592186666996 :question/problem "Given that\n$D=\\begin{bmatrix}\\frac{\\pi }{4} & 0 & 0 & 0 \\\\ 0 & \\frac{\\pi }{3} & 0 & 0 \\\\ 0 & 0 & \\frac{\\pi }{3} & 0 \\\\ 0 & 0 & 0 & \\pi \\end{bmatrix},$\nfind ${tan}^{2}⁡D.$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" width=\"30px\"></td>\n<td align=\"center\" height=\"30px\" width=\"5px\"></td>\n<td align=\"center\" width=\"30px\">{{field-1}}</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\" width=\"5px\"></td>\n</tr>\n<tr>\n<td align=\"right\" height=\"30px\" rowspan=\"2\">${tan}^{2}⁡D=\\,\\,$</td>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\" width=\"30px\">{{field-2}}</td>\n<td align=\"center\" width=\"30px\">{{field-3}}</td>\n<td align=\"center\" width=\"30px\">{{field-4}}</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\" width=\"30px\">{{field-5}}</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\"></td>\n</tr>\n<tr>\n<td align=\"center\" height=\"30px\"></td>\n<td align=\"center\"></td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\">$0$</td>\n<td align=\"center\" width=\"30px\">{{field-6}}</td>\n<td align=\"center\"></td>\n</tr>\n</tbody></table>" "Given that\n$$\n\\displaystyle D=\\begin{bmatrix}\\frac{\\pi }{4} & 0 & 0 & 0 \\\\ 0 & \\frac{\\pi }{3} & 0 & 0 \\\\ 0 & 0 & \\frac{\\pi }{3} & 0 \\\\ 0 & 0 & 0 & \\pi \\end{bmatrix},\n$$\nfind ${tan}^{2}⁡D.$\n\n<table align=\"l\" cellpadding=\"0\" rules=\"all\">\n<tbody><tr>\n<td align=\"center\" height=\"30px\" width=\"30px\"