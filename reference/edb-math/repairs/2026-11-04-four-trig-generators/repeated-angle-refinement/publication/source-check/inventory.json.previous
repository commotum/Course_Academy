            ":answer/value": "-4\\sqrt{2}",
            ":db/id": 17592186696019
          },
          ":answer-field/id": "5d3273ef-447e-5d04-b3a7-02bef4538847",
          ":answer-field/key": "field-1",
          ":answer-field/type": {
