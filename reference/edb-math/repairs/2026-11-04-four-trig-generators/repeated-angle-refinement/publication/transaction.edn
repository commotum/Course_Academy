884" :answer-field/choices "db53bbb2-3402-5e1d-9f07-2b7cd8717680"] [:db/add "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/choices "e7af0949-b849-537b-bf63-f4a38066ce61"] [:db/add "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/choices "f1585335-a414-5452-a6f5-9ec0769b80b5"] [:db/add "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/choices "2d017e70-2af1-54e6-9041-60add084bf85"] [:db/add "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/choices "6f2600e4-aa04-55ea-a5b6-cd84b9452173"] [:db/add "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/correct "db53bbb2-3402-5e1d-9f07-2b7cd8717680"] [:db/ensure "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/validate] [:db/add "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/id #uuid "47b7e499-be75-5994-89eb-47a2f5bdc3dc"] [:db/add "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/problem "Without using a calculator, find the exact value of\n$$\n4\\,\\sin\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{8}\\right).\n$$"] [:db/add "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{\\pi}{16}$ and then at $x=\\frac{\\pi}{8}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=2\\,\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right)\\\\&=\\sin\\left(\\frac{\\pi}{4}\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(\\frac{\\pi}{4}\\right)=\\frac{\\sqrt{2}}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\&=\\frac{\\sqrt{2}}{2}.\n\\end{aligned}\n$$"] [:db/add "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/difficulty :question.difficulty/easy] [:db/add "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/answer-fields "5186798b-7abd-56e2-8a30-03c4aa6cc884"] [:db/ensure "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/validate] [:db/add 17592186059672 :knowledge-point/questions "47b7e499-be75-5994-89eb-47a2f5bdc3dc"] [:db/add "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f" :answer/id #uuid "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f"] [:db/add "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f" :answer/type :answer.type/math] [:db/add "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f" :answer/value "4 \\sqrt{2}"] [:db/ensure "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f" :answer/validate] [:db/add "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/id #uuid "fbafddf7-98f4-574e-afcb-9ad4325dcab4"] [:db/add "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/key "field-1"] [:db/add "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/type :answer-field.type/blank] [:db/add "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/choices "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f"] [:db/add "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/correct "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f"] [:db/ensure "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/validate] [:db/add "018e9f50-0472-569b-869e-52327dfb3a0b" :question/id #uuid "018e9f50-0472-569b-869e-52327dfb3a0b"] [:db/add "018e9f50-0472-569b-869e-52327dfb3a0b" :question/problem "Without using a calculator, find the exact value of\n$$\n\\frac{\\sec\\left(67.5^\\circ\\right)}{\\sin\\left(33.75^\\circ\\right)\\cos\\left(33.75^\\circ\\right)}.\n$$\n{{field-1}}"] [:db/add "018e9f50-0472-569b-869e-52327dfb3a0b" :question/worked-solution "Let $E$ denote the given expression. Apply $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ at $x=33.75^\\circ$ in the denominator. Use $\\sec x=1/\\cos x$, then apply the double-angle identity again at $x=67.5^\\circ$.\n$$\n\\begin{aligned}\nE&=\\frac{2\\,\\sec\\left(67.5^\\circ\\right)}{\\sin\\left(67.5^\\circ\\right)}\\\\&=\\frac{2}{\\sin\\left(67.5^\\circ\\right)\\cos\\left(67.5^\\circ\\right)}\\\\&=\\frac{4}{\\sin\\left(135^\\circ\\right)}\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(135^\\circ\\right)=\\frac{\\sqrt{2}}{2}$.\nRationalize the denominator by multiplying numerator and denominator by $\\sqrt{2}$:\n$$\n\\begin{aligned}\nE&=\\frac{4}{\\left(\\frac{\\sqrt{2}}{2}\\right)}\\\\&=\\frac{8}{\\sqrt{2}}\\\\&=4 \\sqrt{2}.\n\\end{aligned}\n$$"] [:db/add "018e9f50-0472-569b-869e-52327dfb3a0b" :question/difficulty :question.difficulty/hard] [:db/add "018e9f50-0472-569b-869e-52327dfb3a0b" :question/answer-fields "fbafddf7-98f4-574e-afcb-9ad4325dcab4"] [:db/ensure "018e9f50-0472-569b-869e-52327dfb3a0b" :question/validate] [:db/add 17592186059672 :knowledge-point/questions "018e9f50-0472-569b-869e-52327dfb3a0b"] [:db/add "generator" :question-generator/id #uuid "50a21fc9-aa2a-5273-9421-9d7d97a4704e"] [:db/add "generator" :question-generator/script "generators/93/9337de33429f720e400d28159cee11e07a426ad39530af33b9646bd7c5af67bf/generator.py"] [:db/add 17592186059672 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059672 :knowledge-point/validate] [:db/cas 17592186749214 :question/retired nil true] [:db/cas 17592186749226 :question/retired nil true] [:db/cas 17592186749243 :question/retired nil true] [:db/cas 17592186749269 :question/retired nil true]]
