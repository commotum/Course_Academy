\\sqrt{3}}{2}\\right)\\\\&=\\frac{\\sqrt{3}}{8}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029d687d-6bdf-5d50-8a26-c12c66256da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{2}}{8}" :db/id #edb/ref 17592186696459} {:answer/id #uuid "712db24e-43d4-5a1d-b599-e01f890e7e79" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186696468} {:answer/id #uuid "e0ffbda3-c70a-5f23-b5f9-354169308143" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186696480} {:answer/id #uuid "e17c5967-20fa-530e-9463-59c2e621fc67" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3 \\sqrt{3}}{16}" :db/id #edb/ref 17592186696481} {:answer/id #uuid "f0701d0a-791a-5a5a-a979-907175f778ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186696485}] :answer-field/correct {:answer/id #uuid "f0701d0a-791a-5a5a-a979-907175f778ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186696485} :answer-field/id #uuid "a02b09aa-0f6d-5f2b-bef1-f293b52b1e3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696470}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "efb73604-909d-53a0-ae97-6e34be06688f" :question/problem "Without using a calculator, find the exact value of\n$$\n3\\,\\sin\\left(7.5^\\circ\\right)\\cos\\left(7.5^\\circ\\right)\\cos\\left(15^\\circ\\right).\n$$\nUse $2\\sin x\\cos x=\\sin(2x)$, first with $x=7.5^\\circ$ and then with $x=15^\\circ$." :question/retired true :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=7.5^\\circ$ and then at $x=15^\\circ$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=\\frac{3}{2}\\,\\sin\\left(15^\\circ\\right)\\cos\\left(15^\\circ\\right)\\\\&=\\frac{3}{4}\\,\\sin\\left(30^\\circ\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(30^\\circ\\right)=\\frac{1}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\frac{3}{4}\\,\\left(\\frac{1}{2}\\right)\\\\&=\\frac{3}{8}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6c6079a-8812-52a0-9f13-205ddcae7b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{3}}{3}" :db/id #edb/ref 17592186749267}] :answer-field/correct {:answer/id #uuid "f6c6079a-8812-52a0-9f13-205ddcae7b6e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16 \\sqrt{3}}{3}" :db/id #edb/ref 17592186749267} :answer-field/id #uuid "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186749248}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/problem "Without using a calculator, find the exact value of\n$$\n\\frac{2\\,\\sec\\left(30^\\circ\\right)}{\\sin\\left(15^\\circ\\right)\\cos\\left(15^\\circ\\right)}.\n$$\n{{field-1}}" :question/retired true :question/worked-solution "Let $E$ denote the given expression. Apply $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ at $x=15^\\circ$ in the denominator. Use $\\sec x=1/\\cos x$, then apply the double-angle identity again at $x=30^\\circ$.\n$$\n\\begin{aligned}\nE&=\\frac{4\\,\\sec\\left(30^\\circ\\right)}{\\sin\\left(30^\\circ\\right)}\\\\&=\\frac{4}{\\sin\\left(30^\\circ\\right)\\cos\\left(30^\\circ\\right)}\\\\&=\\frac{8}{\\sin\\left(60^\\circ\\right)}\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(60^\\circ\\right)=\\frac{\\sqrt{3}}{2}$.\nRationalize the denominator by multiplying numerator and denominator by $\\sqrt{3}$:\n$$\n\\begin{aligned}\nE&=\\frac{8}{\\left(\\frac{\\sqrt{3}}{2}\\right)}\\\\&=\\frac{16}{\\sqrt{3}}\\\\&=\\frac{16 \\sqrt{3}}{3}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "663cad9a-6a7b-5cf3-82e3-a0e88dbbd671" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{3}" :db/id #edb/ref 17592186749232} {:answer/id #uuid "8696e1eb-9aba-56cd-9bae-cb7df9be3494" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{2}" :db/id #edb/ref 17592186749240} {:answer/id #uuid "ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186749246} {:answer/id #uuid "c959220b-9980-58cf-861c-e495765d3eca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186749251} {:answer/id #uuid "d2942498-38fd-50a1-a171-03017841f23c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186749252}] :answer-field/correct {:answer/id #uuid "c959220b-9980-58cf-861c-e495765d3eca" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186749251} :answer-field/id #uuid "c4609a50-7f80-5b60-9842-6d7ce5941dd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749249}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0b13d522-9f37-55f4-abb4-03939cf0584e" :question/problem "Without using a calculator, find the exact value of\n$$\n8\\,\\sin\\left(7.5^\\circ\\right)\\cos\\left(7.5^\\circ\\right)\\cos\\left(15^\\circ\\right).\n$$" :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=7.5^\\circ$ and then at $x=15^\\circ$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=4\\,\\sin\\left(15^\\circ\\right)\\cos\\left(15^\\circ\\right)\\\\&=2\\,\\sin\\left(30^\\circ\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(30^\\circ\\right)=\\frac{1}{2}$.