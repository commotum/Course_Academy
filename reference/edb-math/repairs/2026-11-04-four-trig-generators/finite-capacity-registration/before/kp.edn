 x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{5 \\pi}{32}$ and then at $x=\\frac{5 \\pi}{16}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=\\sin\\left(\\frac{5 \\pi}{16}\\right)\\cos\\left(\\frac{5 \\pi}{16}\\right)\\\\&=\\frac{1}{2}\\,\\sin\\left(\\frac{5 \\pi}{8}\\right)\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4deb71c8-fdad-5b6a-b340-1c3d76d095ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749223} {:answer/id #uuid "5d0324ad-c372-5805-9c02-d168ddfcc982" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186749230} {:answer/id #uuid "66068ac3-b985-5cbb-b1f7-f32543d25407" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186749231} {:answer/id #uuid "f32321a4-0253-5eb1-a6bb-3bd15b58e4cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186749262} {:answer/id #uuid "f6c4265d-062e-5418-b4ad-08c35968de5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186749266}] :answer-field/correct {:answer/id #uuid "f6c4265d-062e-5418-b4ad-08c35968de5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186749266} :answer-field/id #uuid "67d34673-0071-50d8-a159-6749f0e4b6be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749233}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "34e7eb2c-14af-5bd1-bf04-01774dae2e4c" :question/problem "Without using a calculator, find the exact value of\n$$\n8\\,\\sin\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{8}\\right).\n$$" :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{\\pi}{16}$ and then at $x=\\frac{\\pi}{8}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=4\\,\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right)\\\\&=2\\,\\sin\\left(\\frac{\\pi}{4}\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(\\frac{\\pi}{4}\\right)=\\frac{\\sqrt{2}}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=2\\,\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\&=\\sqrt{2}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4feb1838-bf6a-55b7-8199-4cef0f2bab91" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{2}" :db/id #edb/ref 17592186749224} {:answer/id #uuid "5a412728-5a20-53cf-a363-2e228976f66d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186749229} {:answer/id #uuid "6e7fe509-f728-51ba-ba90-6a1dddc0dad8" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186749235} {:answer/id #uuid "84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186749239} {:answer/id #uuid "f4eb1584-1a1f-56ee-9e96-f0f946e13fa0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186749264}] :answer-field/correct {:answer/id #uuid "f4eb1584-1a1f-56ee-9e96-f0f946e13fa0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186749264} :answer-field/id #uuid "0574cf5b-7c20-59f3-8e24-87d729740cc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749212}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "5205ab04-98cb-5c68-9725-f0902169acf7" :question/problem "Without using a calculator, find the exact value of\n$$\n8\\,\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{4}\\right).\n$$" :question/retired true :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{\\pi}{8}$ and then at $x=\\frac{\\pi}{4}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=4\\,\\sin\\left(\\frac{\\pi}{4}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)\\\\&=2\\,\\sin\\left(\\frac{\\pi}{2}\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(\\frac{\\pi}{2}\\right)=1$.\nTherefore,\n$$\n\\begin{aligned}\nE&=2\\,\\left(1\\right)\\\\&=2.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51b269ab-2323-5dc4-8295-2ccbd2bc2663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186749225} {:answer/id #uuid "b540806d-ab28-5d3f-9303-864194a19a9d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186749245} {:answer/id #uuid "e1a3b33b-886d-5b02-82a3-5d60199c0086" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186749254} {:answer/id #uuid "ef7ded27-c9d5-5493-97e1-560789a01f9e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186749258} {:answer/id #uuid "f0634960-19b8-57eb-a258-b3b410de96e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749259}] :answer-field/correct {:answer/id #uuid "b540806d-ab28-5d3f-9303-864194a19a9d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186749245} :answer-field/id #uuid "e9eb51c5-ef2d-5809-a2b9-c47e2f435227" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749257}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "90970a95-e0ab-56f8-bcbf-d7ffa043e550" :question/problem "Without using a calculator, find the exact value of\n$$\n4\\,\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{4}\\right).\n$$" :question/retired true :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{\\pi}{8}$ and then at $x=\\frac{\\pi}{4}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=2\\,\\sin\\left(\\frac{\\pi}{4}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)\\\\&=\\sin\\left(\\frac{\\pi}{2}\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(\\frac{\\pi}{2}\\right)=1$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\left(1\\right)\\\\&=1.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749250 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a20e14-b7e7-5aa7-974c-e3c669e04176" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{16}" :db/id #edb/ref 17592186749227} {:answer/id #uuid "af461d4d-89b3-5ed9-a949-9bb02437da96" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{32}" :db/id #edb/ref 17592186749244} {:answer/id #uuid "d8473857-1946-5ff8-827b-e088c6cf9a4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186749253} {:answer/id #uuid "e3d72e34-9aec-537b-956e-24db719ce04f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{16}" :db/id #edb/ref 17592186749255} {:answer/id #uuid "f120e81a-721b-5033-83c3-ce741840b16e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{8}" :db/id #edb/ref 17592186749260}] :answer-field/correct {:answer/id #uuid "f120e81a-721b-5033-83c3-ce741840b16e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{8}" :db/id #edb/ref 17592186749260} :answer-field/id #uuid "e65bf125-7f3f-594d-9f23-e80e0ea6e8d4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749256}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c5362cd4-e28f-5871-8896-bc4de86ede35" :question/problem "Without using a calculator, find the exact value of\n$$\n\\sin\\left(\\frac{3 \\pi}{16}\\right)\\cos\\left(\\frac{3 \\pi}{16}\\right)\\cos\\left(\\frac{3 \\pi}{8}\\right).\n$$" :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{3 \\pi}{16}$ and then at $x=\\frac{3 \\pi}{8}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=\\frac{1}{2}\\,\\sin\\left(\\frac{3 \\pi}{8}\\right)\\cos\\left(\\frac{3 \\pi}{8}\\right)\\\\&=\\frac{1}{4}\\,\\sin\\left(\\frac{3 \\pi}{4}\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(\\frac{3 \\pi}{4}\\right)=\\frac{\\sqrt{2}}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\frac{1}{4}\\,\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\&=\\frac{\\sqrt{2}}{8}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28a55eb5-d201-5d8a-9054-1c20b504f5dd" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\sin\\left(\\frac{\\pi}{5}\\right)" :db/id #edb/ref 17592186749219} {:answer/id #uuid "57799975-740f-5377-81c5-41efae97d248" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186749228} {:answer/id #uuid "77b29c9a-1ac8-5380-a528-9bec26f68e8a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\,\\cos\\left(\\frac{\\pi}{5}\\right)" :db/id #edb/ref 17592186749237} {:answer/id #uuid "808a721e-17f7-50a5-baa0-e6091a5efe66" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186749238} {:answer/id #uuid "f27edaa5-8eca-5a48-90c2-c9e38d4e9e99" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\csc\\left(\\frac{\\pi}{10}\\right)" :db/id #edb/ref 17592186749261}] :answer-field/correct {:answer/id #uuid "57799975-740f-5377-81c5-41efae97d248" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186749228} :answer-field/id #uuid "457d341a-469a-56aa-af29-cc618375fb46" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749221}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f5eb2271-5f6e-539f-a116-c79daec2a6c8" :question/problem "Without using a calculator, find the exact value of\n$$\n8\\,\\sin\\left(\\frac{\\pi}{10}\\right)\\cos\\left(\\frac{\\pi}{10}\\right)\\csc\\left(\\frac{\\pi}{5}\\right).\n$$" :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ at $x=\\frac{\\pi}{10}$, then $\\csc x=1/\\sin x$. The nonzero sine cancels.\n$$\n\\begin{aligned}\nE&=4\\,\\sin\\left(\\frac{\\pi}{5}\\right)\\csc\\left(\\frac{\\pi}{5}\\right)\\\\&=4\\,\\frac{\\sin\\left(\\frac{\\pi}{5}\\right)}{\\sin\\left(\\frac{\\pi}{5}\\right)}\\\\&=4\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d2f5a41-6ac2-5ca0-8d8b-315663aba221" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749216} {:answer/id #uuid "4958c399-6d8b-5f06-912f-b1d879b282fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186749222} {:answer/id #uuid "76a12179-d37a-5ba8-b18c-fa0a3b5f1daf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186749236} {:answer/id #uuid "8c54ff57-fb04-544d-9296-9db316c32394" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{2}" :db/id #edb/ref 17592186749241} {:answer/id #uuid "f8dd6a24-4510-53b3-bc21-a3d10c8d6758" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186749268}] :answer-field/correct {:answer/id #uuid "4958c399-6d8b-5f06-912f-b1d879b282fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186749222} :answer-field/id #uuid "f48b0324-6d84-5908-9d76-cee56d4ccf40" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749263}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f8fa23a0-df4e-59d2-a1e6-1e3769930383" :question/problem "Without using a calculator, find the exact value of\n$$\n8\\,\\sin\\left(15^\\circ\\right)\\cos\\left(15^\\circ\\right)\\cos\\left(30^\\circ\\right).\n$$" :question/retired true :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=15^\\circ$ and then at $x=30^\\circ$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=4\\,\\sin\\left(30^\\circ\\right)\\cos\\left(30^\\circ\\right)\\\\&=2\\,\\sin\\left(60^\\circ\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(60^\\circ\\right)=\\frac{\\sqrt{3}}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=2\\,\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\&=\\sqrt{3}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sqrt{2}" :db/id #edb/ref 17592186749686}] :answer-field/correct {:answer/id #uuid "250ff5c2-1fcc-5eba-b50b-aeefc4d78e4f" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sqrt{2}" :db/id #edb/ref 17592186749686} :answer-field/id #uuid "fbafddf7-98f4-574e-afcb-9ad4325dcab4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186749694}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "018e9f50-0472-569b-869e-52327dfb3a0b" :question/problem "Without using a calculator, find the exact value of\n$$\n\\frac{\\sec\\left(67.5^\\circ\\right)}{\\sin\\left(33.75^\\circ\\right)\\cos\\left(33.75^\\circ\\right)}.\n$$\n{{field-1}}" :question/worked-solution "Let $E$ denote the given expression. Apply $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ at $x=33.75^\\circ$ in the denominator. Use $\\sec x=1/\\cos x$, then apply the double-angle identity again at $x=67.5^\\circ$.\n$$\n\\begin{aligned}\nE&=\\frac{2\\,\\sec\\left(67.5^\\circ\\right)}{\\sin\\left(67.5^\\circ\\right)}\\\\&=\\frac{2}{\\sin\\left(67.5^\\circ\\right)\\cos\\left(67.5^\\circ\\right)}\\\\&=\\frac{4}{\\sin\\left(135^\\circ\\right)}\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(135^\\circ\\right)=\\frac{\\sqrt{2}}{2}$.\nRationalize the denominator by multiplying numerator and denominator by $\\sqrt{2}$:\n$$\n\\begin{aligned}\nE&=\\frac{4}{\\left(\\frac{\\sqrt{2}}{2}\\right)}\\\\&=\\frac{8}{\\sqrt{2}}\\\\&=4 \\sqrt{2}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749688 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d017e70-2af1-54e6-9041-60add084bf85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749687} {:answer/id #uuid "6f2600e4-aa04-55ea-a5b6-cd84b9452173" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186749690} {:answer/id #uuid "db53bbb2-3402-5e1d-9f07-2b7cd8717680" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186749691} {:answer/id #uuid "e7af0949-b849-537b-bf63-f4a38066ce61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186749692} {:answer/id #uuid "f1585335-a414-5452-a6f5-9ec0769b80b5" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186749693}] :answer-field/correct {:answer/id #uuid "db53bbb2-3402-5e1d-9f07-2b7cd8717680" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186749691} :answer-field/id #uuid "5186798b-7abd-56e2-8a30-03c4aa6cc884" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749689}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "47b7e499-be75-5994-89eb-47a2f5bdc3dc" :question/problem "Without using a calculator, find the exact value of\n$$\n4\\,\\sin\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{8}\\right).\n$$" :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=\\frac{\\pi}{16}$ and then at $x=\\frac{\\pi}{8}$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=2\\,\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right)\\\\&=\\sin\\left(\\frac{\\pi}{4}\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(\\frac{\\pi}{4}\\right)=\\frac{\\sqrt{2}}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\&=\\frac{\\sqrt{2}}{2}.\n\\end{aligned}\n$$"}] :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}]}
