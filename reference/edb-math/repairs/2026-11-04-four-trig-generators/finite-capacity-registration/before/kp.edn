n}⁡\\left(\\frac{2\\pi }{5}\\right)\\cdot \\frac{1}{\\operatorname{sin}⁡\\left(\\frac{2\\pi }{5}\\right)} \\\\  & =4\\end{aligned}\n$$"} {:db/id #edb/ref 17592186290577 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39c3ecbd-17ed-5b06-b654-653c3049502e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288427} {:answer/id #uuid "4c1c7922-d73e-55f5-a376-2d36947a8151" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186288559} {:answer/id #uuid "5af6a861-2ad4-55c6-9de1-23e3e121be7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sec}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288666} {:answer/id #uuid "640a6f06-222f-5050-8d99-73191247207c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288735} {:answer/id #uuid "6c6c9ed9-62d6-592d-8648-4a352af8d6c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)" :db/id #edb/ref 17592186288797}] :answer-field/correct {:answer/id #uuid "640a6f06-222f-5050-8d99-73191247207c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)" :db/id #edb/ref 17592186288735} :answer-field/id #uuid "ef225602-1693-5ca7-8c43-67f2e54eda30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290226}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "87e7afa8-1798-5127-a9ff-a08924db07de" :question/math-academy-id "q-24792" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)}.\n$$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{8}\\right)\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)} & =\\frac{\\frac{1}{2}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right)\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{4}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)} & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{4}\\right) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b64c24fe-86c0-528a-a80a-d441c9376663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186300870}] :answer-field/correct {:answer/id #uuid "b64c24fe-86c0-528a-a80a-d441c9376663" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186300870} :answer-field/id #uuid "51f40c8d-649b-5cc5-8611-1a3900cfece1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301496}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "6a88295e-a9f4-5381-9209-7cdc6c3b161d" :question/math-academy-id "q-327716" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{24}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{12}\\right)}.\n$$\n\n$$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{24}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{12}\\right)}=\n$$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{24}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{24}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{24}\\right)\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{24}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{24}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{12}\\right)} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{12}\\right)} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{12}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{24}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{12}\\right)} & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{12}\\right) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04c58237-1e79-538c-ba35-64864273d7c4" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186299953}] :answer-field/correct {:answer/id #uuid "04c58237-1e79-538c-ba35-64864273d7c4" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186299953} :answer-field/id #uuid "f6c6a4ff-0ad2-5a80-99b9-227f85929a6d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302015}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4fabc70d-25ca-5a30-9a52-90a915524efa" :question/math-academy-id "q-328087" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sec}⁡\\left(\\frac{7\\pi }{12}\\right)}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{24}\\right)}.\n$$\n\n$$\n\\displaystyle \\frac{\\operatorname{sec}⁡\\left(\\frac{7\\pi }{12}\\right)}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{24}\\right)}=\n$$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡(2x)\n$$\n\nSubstituting $x=\\frac{7\\pi }{24}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{7\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{24}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{7\\pi }{24}\\right)\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{7\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{24}\\right)=\\operatorname{sin}⁡\\left(\\frac{7\\pi }{12}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sec}⁡\\left(\\frac{7\\pi }{12}\\right)}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{24}\\right)} & =\\frac{2\\operatorname{sec}⁡\\left(\\frac{7\\pi }{12}\\right)}{2\\operatorname{sin}⁡\\left(\\frac{7\\pi }{24}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{24}\\right)} \\\\  & =\\frac{2\\operatorname{sec}⁡\\left(\\frac{7\\pi }{12}\\right)}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{12}\\right)} \\\\  & =\\frac{2}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{12}\\right)}\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{7\\pi }{12}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{2}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{12}\\right)} & =\\frac{2\\cdot 2}{2\\operatorname{sin}⁡\\left(\\frac{7\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{7\\pi }{12}\\right)} \\\\  & =\\frac{4}{\\operatorname{sin}⁡\\left(2\\cdot \\frac{7\\pi }{12}\\right)} \\\\  & =\\frac{4}{\\operatorname{sin}⁡\\left(\\frac{7\\pi }{6}\\right)} \\\\  & =\\frac{4}{\\left(-\\frac{1}{2}\\right)} \\\\  & =-8\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323805 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6dcfdc0-0425-58da-9863-8d71fb334ef1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{8}" :db/id #edb/ref 17592186322824}] :answer-field/correct {:answer/id #uuid "d6dcfdc0-0425-58da-9863-8d71fb334ef1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{8}" :db/id #edb/ref 17592186322824} :answer-field/id #uuid "1ebc2e95-bd33-54eb-b38e-19227069b90a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186323226}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "5749738c-9ac0-51f9-9b71-e3d7fdfbde49" :question/math-academy-id "q-364639" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{16}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{16}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)}.\n$$\n\n$$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{16}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{16}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)}=\n$$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{16}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{16}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{16}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{16}\\right)\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{16}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{16}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{16}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{16}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{8}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{16}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{16}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)} & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{8}\\right) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{2}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186323806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5527a2df-a2d6-5eff-8e35-66b2ae6e3318" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{8}" :db/id #edb/ref 17592186321819}] :answer-field/correct {:answer/id #uuid "5527a2df-a2d6-5eff-8e35-66b2ae6e3318" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{8}" :db/id #edb/ref 17592186321819} :answer-field/id #uuid "bdcaa383-804e-5471-975f-ae53c9f7d704" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186323540}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e9ff4e40-981d-5344-8025-a467141eea82" :question/math-academy-id "q-364640" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{6}\\right)}.\n$$\n\n$$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{6}\\right)}=\n$$\n{{field-1}}" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{12}\\right)\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{6}\\right)} & =\\frac{\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{6}\\right)} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right)\\end{aligned}\n$$\n\nFinally, using the double-angle formula once more with $x=\\frac{\\pi }{6}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{12}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{12}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{6}\\right)} & =\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{4}\\cdot 2\\operatorname{sin}⁡\\left(\\frac{\\pi }{6}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{4}\\cdot \\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{3}\\right) \\\\  & =\\frac{1}{4}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6624c503-a440-59c9-8f2d-03632a1ac414" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\operatorname{sin}⁡\\left(\\frac{2\\pi }{7}\\right)" :db/id #edb/ref 17592186343105} {:answer/id #uuid "9a938235-b3f4-54c2-b79f-6fe77fb80b1e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡\\left(\\frac{2\\pi }{7}\\right)" :db/id #edb/ref 17592186343599} {:answer/id #uuid "9dd4d77b-6b5a-5089-99a1-e818c683648e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343625} {:answer/id #uuid "bb100409-5df2-5a5a-8228-1775440e2d46" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{csc}⁡\\left(\\frac{\\pi }{7}\\right)" :db/id #edb/ref 17592186343883} {:answer/id #uuid "d99f783f-0b69-5884-9e2f-48416231f2b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186344148}] :answer-field/correct {:answer/id #uuid "9dd4d77b-6b5a-5089-99a1-e818c683648e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343625} :answer-field/id #uuid "1748e2fb-ce8f-5df0-8345-b0b4c3f06cc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344530}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "3d7f3236-aee5-5d63-80b7-2ecd442664e7" :question/math-academy-id "q-76660" :question/problem "$$\n\\displaystyle 6\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{7}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{7}\\right)\\operatorname{csc}⁡\\left(\\frac{2\\pi }{7}\\right)=\n$$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{7}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{7}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{7}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{7}\\right)=\\operatorname{sin}⁡\\left(\\frac{2\\pi }{7}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}6\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{7}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{7}\\right)\\operatorname{csc}⁡\\left(\\frac{2\\pi }{7}\\right) & =3\\cdot \\left[2\\operatorname{sin}⁡\\left(\\frac{\\pi }{7}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{7}\\right)\\right]\\operatorname{csc}⁡\\left(\\frac{2\\pi }{7}\\right) \\\\  & =3\\operatorname{sin}⁡\\left(\\frac{2\\pi }{7}\\right)\\cdot \\frac{1}{\\operatorname{sin}⁡\\left(\\frac{2\\pi }{7}\\right)} \\\\  & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345244 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a1cebb-a7ec-573e-834f-5765dcecf952" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)" :db/id #edb/ref 17592186342394} {:answer/id #uuid "254c3227-d0aa-5723-a923-035c9df92844" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186342551} {:answer/id #uuid "6ab0592e-6a5f-5609-ad32-dc332fbcc425" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{csc}⁡\\left(\\frac{\\pi }{10}\\right)" :db/id #edb/ref 17592186343147} {:answer/id #uuid "83b4ab2f-a0ac-5b73-956c-314a45cef514" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343363} {:answer/id #uuid "afff12a2-3582-5334-9126-b7ef6ab71ae1" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{csc}⁡\\left(\\frac{\\pi }{10}\\right)" :db/id #edb/ref 17592186343784}] :answer-field/correct {:answer/id #uuid "83b4ab2f-a0ac-5b73-956c-314a45cef514" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343363} :answer-field/id #uuid "24cdb73d-8bf4-5a1b-9d30-d95b06bf3c8c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344560}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "c41ea86a-3b09-5773-9843-df888de284a4" :question/math-academy-id "q-76664" :question/problem "$$\n\\displaystyle 6\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{10}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)\\operatorname{csc}⁡\\left(\\frac{\\pi }{5}\\right)=\n$$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{10}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡\\left(\\frac{\\pi }{10}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)=\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{10}\\right)=\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}6\\,\\operatorname{sin}⁡\\left(\\frac{\\pi }{10}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)\\operatorname{csc}⁡\\left(\\frac{\\pi }{5}\\right) & =3\\cdot \\left[2\\operatorname{sin}⁡\\left(\\frac{\\pi }{10}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{10}\\right)\\right]\\operatorname{csc}⁡\\left(\\frac{\\pi }{5}\\right) \\\\  & =3\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)\\cdot \\frac{1}{\\operatorname{sin}⁡\\left(\\frac{\\pi }{5}\\right)} \\\\  & =3\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22155814-2e37-5e33-bac0-7171c896a0fc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{8}" :db/id #edb/ref 17592186696010} {:answer/id #uuid "65ada7bc-a1f0-53d7-a69a-e1c830bd9241" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{8}" :db/id #edb/ref 17592186696017} {:answer/id #uuid "895d39bd-2973-5a32-8b58-8f1949d41b25" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186696018} {:answer/id #uuid "ab20ebb6-bd86-5778-b38a-5eae9a602bbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{16}" :db/id #edb/ref 17592186696020} {:answer/id #uuid "ff049149-7eb5-5670-9d67-5561e3e11044" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{4}" :db/id #edb/ref 17592186696024}] :answer-field/correct {:answer/id #uuid "65ada7bc-a1f0-53d7-a69a-e1c830bd9241" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{8}" :db/id #edb/ref 17592186696017} :answer-field/id #uuid "b30b00d4-6a0d-5c61-a206-cd09af6d2cc1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696022}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0abb88c3-b1d8-5fd6-9259-e93980f1b3ad" :question/problem "Without using a calculator, find the exact value of\n$$\n3\\sin(15^\\circ)\\cos(15^\\circ)\\cos(30^\\circ).\n$$" :question/retired true :question/worked-solution "Use the double-angle identity in the form $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$:\n$$\n\\begin{aligned}\n3\\sin(15^\\circ)\\cos(15^\\circ)\\cos(30^\\circ)\n&=\\frac{3}{2}\\sin(30^\\circ)\\cos(30^\\circ)\\\\\n&=\\frac{3}{4}\\sin(60^\\circ)\\\\\n&=\\frac{3}{4}\\cdot\\frac{\\sqrt{3}}{2}\\\\\n&=\\frac{3\\sqrt{3}}{8}.\n\\end{aligned}\n$$\nThe identity is used twice: the angles progress from $15^\\circ$ to $30^\\circ$ to $60^\\circ$. Each use introduces a factor of $\\frac{1}{2}$."} {:db/id #edb/ref 17592186696009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9ff46e3-0ea0-5dc2-8d04-4c4708045688" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186696019}] :answer-field/correct {:answer/id #uuid "a9ff46e3-0ea0-5dc2-8d04-4c4708045688" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\sqrt{2}" :db/id #edb/ref 17592186696019} :answer-field/id #uuid "5d3273ef-447e-5d04-b3a7-02bef4538847" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186696014}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "1043af1e-be8e-50e8-a088-c079feee421f" :question/problem "Without using a calculator, find the exact value of\n$$\n\\frac{\\sec\\left(\\frac{5\\pi}{8}\\right)}{\\sin\\left(\\frac{5\\pi}{16}\\right)\\cos\\left(\\frac{5\\pi}{16}\\right)}.\n$$\n{{field-1}}" :question/retired true :question/worked-solution "First use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ in the denominator. Then write secant as the reciprocal of cosine:\n$$\n\\begin{aligned}\n\\frac{\\sec\\left(\\frac{5\\pi}{8}\\right)}{\\sin\\left(\\frac{5\\pi}{16}\\right)\\cos\\left(\\frac{5\\pi}{16}\\right)}\n&=\\frac{2\\sec\\left(\\frac{5\\pi}{8}\\right)}{\\sin\\left(\\frac{5\\pi}{8}\\right)}\\\\\n&=\\frac{2}{\\sin\\left(\\frac{5\\pi}{8}\\right)\\cos\\left(\\frac{5\\pi}{8}\\right)}\\\\\n&=\\frac{4}{\\sin\\left(\\frac{5\\pi}{4}\\right)}.\n\\end{aligned}\n$$\nThe last step uses the double-angle identity a second time. Since $\\frac{5\\pi}{4}$ lies in quadrant III, $\\sin\\left(\\frac{5\\pi}{4}\\right)=-\\frac{\\sqrt{2}}{2}$. Therefore,\n$$\n\\frac{4}{-\\frac{\\sqrt{2}}{2}}=-\\frac{8}{\\sqrt{2}}=-4\\sqrt{2}.\n$$"} {:db/id #edb/ref 17592186696011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f0cf48-d111-57cb-8e12-2cc71f950d2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696012} {:answer/id #uuid "5f8ed73c-85b7-5fc2-a19a-a001a5ca7b8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186696015} {:answer/id #uuid "645fb0d0-ca3b-53ea-97d6-693dd7883dea" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin\\left(\\frac{\\pi}{8}\\right)" :db/id #edb/ref 17592186696016} {:answer/id #uuid "b0380848-af16-51fe-af42-6915027a3178" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186696021} {:answer/id #uuid "d6d5b322-4d69-5dd0-9b4e-9e5b5c3fb769" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186696023}] :answer-field/correct {:answer/id #uuid "47f0cf48-d111-57cb-8e12-2cc71f950d2a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696012} :answer-field/id #uuid "52d288e6-6a69-5bea-bfbb-8a58cf5588c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696013}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "23700599-02b8-5b30-905e-86d4d7a86aa5" :question/problem "Without using a calculator, find the exact value of\n$$\n4\\sin\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{8}\\right).\n$$\nUse $2\\sin x\\cos x=\\sin(2x)$, first with $x=\\frac{\\pi}{16}$ and then with $x=\\frac{\\pi}{8}$." :question/retired true :question/worked-solution "Let $E$ denote the given expression. Group a factor of $2$ with the first sine–cosine pair:\n$$\n\\begin{aligned}\nE&=2\\left[2\\sin\\left(\\frac{\\pi}{16}\\right)\\cos\\left(\\frac{\\pi}{16}\\right)\\right]\\cos\\left(\\frac{\\pi}{8}\\right)\\\\\n&=2\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right).\n\\end{aligned}\n$$\nThe new sine has the same angle as the remaining cosine, so apply the identity again:\n$$\n2\\sin\\left(\\frac{\\pi}{8}\\right)\\cos\\left(\\frac{\\pi}{8}\\right)\n=\\sin\\left(\\frac{\\pi}{4}\\right)=\\frac{\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186696414 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13538aaa-ca65-5d06-85af-2913f76d3a3f" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186696410} {:answer/id #uuid "4bb793f3-bbc6-5877-82d5-3fc01ed94b41" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186696417} {:answer/id #uuid "663d514e-6784-5e2a-9ad8-d8f21ea6c235" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186696424} {:answer/id #uuid "afecf3fe-e744-5e83-b5da-be31d16572d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186696432} {:answer/id #uuid "f233d6e8-42ef-5432-848c-eec50e0252b3" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{4}" :db/id #edb/ref 17592186696441}] :answer-field/correct {:answer/id #uuid "afecf3fe-e744-5e83-b5da-be31d16572d3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186696432} :answer-field/id #uuid "d1a32f35-a829-593c-aa5f-de7575807153" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696435}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "1fe16984-8dc7-561a-bb43-80bc768dbed2" :question/problem "Without using a calculator, find the exact value of\n$$\n4\\,\\sin\\left(67.5^\\circ\\right)\\cos\\left(67.5^\\circ\\right)\\cos\\left(135^\\circ\\right).\n$$" :question/retired true :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=67.5^\\circ$ and then at $x=135^\\circ$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=2\\,\\sin\\left(135^\\circ\\right)\\cos\\left(135^\\circ\\right)\\\\&=\\sin\\left(270^\\circ\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(270^\\circ\\right)=-1$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\left(-1\\right)\\\\&=-1.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696420 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ec7ef2-a593-586c-abe6-8357e5e5e3da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{16}" :db/id #edb/ref 17592186696411} {:answer/id #uuid "9a4c4936-1148-5e91-bd56-647d9ae1f4b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{8}" :db/id #edb/ref 17592186696429} {:answer/id #uuid "adda62d6-2d7b-5ef1-9867-71d8187fc3d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186696431} {:answer/id #uuid "d9d97b2c-109b-5e43-9aee-a7bfdf3a3df7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186696436} {:answer/id #uuid "e491a915-a5fc-5aa7-85fb-6c2848d371cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186696438}] :answer-field/correct {:answer/id #uuid "e491a915-a5fc-5aa7-85fb-6c2848d371cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186696438} :answer-field/id #uuid "33e4d7ac-4a91-5c7f-b9ae-f4cc6bd2f0c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696415}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "4ea294b3-11ab-5619-84a6-dff30ff4752b" :question/problem "Without using a calculator, find the exact value of\n$$\n2\\,\\sin\\left(15^\\circ\\right)\\cos\\left(15^\\circ\\right)\\cos\\left(30^\\circ\\right).\n$$" :question/retired true :question/worked-solution "Let $E$ denote the given expression. Use $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ first at $x=15^\\circ$ and then at $x=30^\\circ$. Each application introduces a factor of $\\frac{1}{2}$.\n$$\n\\begin{aligned}\nE&=\\sin\\left(30^\\circ\\right)\\cos\\left(30^\\circ\\right)\\\\&=\\frac{1}{2}\\,\\sin\\left(60^\\circ\\right)\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(60^\\circ\\right)=\\frac{\\sqrt{3}}{2}$.\nTherefore,\n$$\n\\begin{aligned}\nE&=\\frac{1}{2}\\,\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\&=\\frac{\\sqrt{3}}{4}.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1674d517-3220-5613-a583-37d0b9c0c82b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696412} {:answer/id #uuid "4bb825f9-d4dc-5f97-ae4b-413bf0325abd" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186696418} {:answer/id #uuid "4e2ec0b1-45c1-5cd6-85c0-6622194f78b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186696419} {:answer/id #uuid "a53a774e-91de-553f-aa96-c774adc6cb72" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186696430} {:answer/id #uuid "b9291df2-e04f-523a-8831-0dbae8e1ff3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186696433}] :answer-field/correct {:answer/id #uuid "b9291df2-e04f-523a-8831-0dbae8e1ff3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186696433} :answer-field/id #uuid "6c3b92ef-5405-56a4-a7e3-e9d0af6d8066" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696425}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5f5f9ddc-cee0-5b98-973b-5ba53e1662a7" :question/problem "With