#{[{:db/id #edb/ref 17592186087671 :knowledge-point/canonical-example {:db/id #edb/ref 17592186087479 :question/id #uuid "e617aaf2-1232-57cc-8644-2467effda030" :question/math-academy-id "e-3668" :question/problem "Without using a calculator, find the exact value of $\\cos^2\\left( 22.5^\\circ\\right) - \\sin^2\\left( 22.5^\\circ\\right).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n\\cos^2 x - \\sin^2 x = \\cos 2x\n$$\n\nSubstituting $x={22.5^\\circ}$ into the above, we get\n\n$$\n\\begin{aligned}{\\cos }^{2}⁡({22.5}^{∘})-{\\sin }^{2}⁡({22.5}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {22.5}^{∘}) \\\\  & =\\operatorname{cos}⁡{45}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186749211 :question-generator/id #uuid "270a33a7-6203-5a32-80c4-dfd3d40556c2" :question-generator/script "generators/06/0662caf122bf49285656896e1b884ddc5bc8b24f21bca7e483b3a95d3d0fb773/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186088096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0043b9dd-acd7-5722-ae3f-3f717ea8f717" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288026} {:answer/id #uuid "0fcd1b2f-6684-5235-9ad9-1439089c5d1d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288147} {:answer/id #uuid "2e93b461-8b28-554d-a5d3-b0197fe38c18" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288346} {:answer/id #uuid "38664848-58db-58e9-955b-e673ca767957" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186288415} {:answer/id #uuid "679b2481-2