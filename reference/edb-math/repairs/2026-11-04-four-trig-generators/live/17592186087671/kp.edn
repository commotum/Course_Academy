left(165^\\circ\\right)-\\sin^2\\left(165^\\circ\\right) \\\\\n&= \\cos\\left(2\\cdot 165^\\circ\\right) \\\\\n&= \\cos\\left(330^\\circ\\right) \\\\\n&= \\cos\\left(30^\\circ\\right) \\\\\n&= \\frac{\\sqrt{3}}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186702810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2577cb59-0c54-5c9a-80aa-c4716f891a00" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186702808}] :answer-field/correct {:answer/id #uuid "2577cb59-0c54-5c9a-80aa-c4716f891a00" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186702808} :answer-field/id #uuid "283390d2-8a38-561c-9e79-421d57c261a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186702809}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e0f7b235-8ae9-5937-8e10-baa26e88faee" :question/problem "Without using a calculator, find the **exact** value.\n\n$$\n\\begin{aligned}\n&\\cos^4\\left(\\frac{3\\pi}{4}\\right) \\\\\n&\\quad -2\\cos^2\\left(\\frac{3\\pi}{4}\\right)\\sin^2\\left(\\frac{3\\pi}{4}\\right) \\\\\n&\\quad +\\sin^4\\left(\\frac{3\\pi}{4}\\right)=\n\\end{aligned}\n$$\n{{field-1}}" :question/retired true :question/worked-solution "Let $E$ denote the expression in the question. Recognize the expanded perfect square:\n\n$$\n\\begin{aligned}\nE &= \\left(\\cos^2\\left(\\frac{3\\pi}{4}\\right)-\\sin^2\\left(\\frac{3\\pi}{4}\\right)\\right)^2\n\\end{aligned}\n$$\n\nUse the cosine double-angle identity:\n\n$$\n\\cos^2\\left(x\\right)-\\sin^2\\left(x\\right)=\\cos(2x)\n$$\n\nSubstitute the angle and evaluate the standard-angle cosine:\n\n$$\n\\begin{aligned}\n&\\cos^2\\left(\\frac{3\\pi}{4}\\right)-\\sin^2\\left(\\frac{3\\pi}{4}\\right) \\\\\n&= \\cos\\left(2\\cdot \\frac{3\\pi}{4}\\right) \\\\\n&= \\cos\\left(\\frac{3\\pi}{2}\\right) \\\\\n&= 0\n\\end{aligned}\n$$\n\nFinally, square the value:\n\n$$\n\\begin{aligned}\nE &= \\left(0\\right)^2 \\\\\n&= 0\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17606882-795c-5b1c-bf33-dc12266ad96f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186749198}] :answer-field/correct {:answer/id #uuid "17606882-795c-5b1c-bf33-dc12266ad96f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186749198} :answer-field/id #uuid "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186749210}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/problem "Without using a calculator, find the **exact** value.\n\n$$\n\\begin{aligned}\n&\\cos^4\\left(15^\\circ\\right) \\\\\n&\\quad -2\\cos^2\\left(15^\\circ\\right)\\sin^2\\left(15^\\circ\\right) \\\\\n&\\quad +\\sin^4\\left(15^\\circ\\right)=\n\\end{aligned}\n$$\n{{field-1}}" :question/worked-solution "Let $E$ denote the expression in the question. Recognize the expanded perfect square:\n\n$$\n\\begin{aligned}\nE &= \\left(\\cos^2\\left(15^\\circ\\right)-\\sin^2\\left(15^\\circ\\right)\\right)^2\n\\end{aligned}\n$$\n\nUse the cosine double-angle identity:\n\n$$\n\\cos^2\\left(x\\right)-\\sin^2\\left(x\\right)=\\cos(2x)\n$$\n\nSubstitute the angle and evaluate the standard-angle cosine:\n\n$$\n\\begin{aligned}\n&\\cos^2\\left(15^\\circ\\right)-\\sin^2\\left(15^\\circ\\right) \\\\\n&= \\cos\\left(2\\cdot 15^\\circ\\right) \\\\\n&= \\cos\\left(30^\\circ\\right) \\\\\n&= \\frac{\\sqrt{3}}{2}\n\\end{aligned}\n$$\n\nFinally, square the value:\n\n$$\n\\begin{aligned}\nE &= \\left(\\frac{\\sqrt{3}}{2}\\right)^2 \\\\\n&= \\frac{3}{4}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30332f01-50d0-591f-bb59-33e892c3fde5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186749200} {:answer/id #uuid "974aa8fb-e15e-53b8-9db7-cde3162c02ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186749204} {:answer/id #uuid "b1274eae-a2c9-5ea4-a5b6-418a5f850a25" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749206} {:answer/id #uuid "ea4f9e73-a660-5646-aea4-7628de4d97b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749208} {:answer/id #uuid "f52cf417-ba91-583e-9fc6-15c605c15923" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186749209}] :answer-field/correct {:answer/id #uuid "b1274eae-a2c9-5ea4-a5b6-418a5f850a25" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749206} :answer-field/id #uuid "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749201}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "44f5ec04-b094-507a-beff-1d5d8144c102" :question/problem "Without using a calculator, find the **exact** value.\n\n$$\n\\cos^2\\left(105^\\circ\\right)-\\sin^2\\left(105^\\circ\\right)\n$$" :question/worked-solution "Use the cosine double-angle identity:\n\n$$\n\\cos^2\\left(x\\right)-\\sin^2\\left(x\\right)=\\cos(2x)\n$$\n\nSubstitute the angle and evaluate the standard-angle cosine:\n\n$$\n\\begin{aligned}\n&\\cos^2\\left(105^\\circ\\right)-\\sin^2\\left(105^\\circ\\right) \\\\\n&= \\cos\\left(2\\cdot 105^\\circ\\right) \\\\\n&= \\cos\\left(210^\\circ\\right) \\\\\n&= -\\cos\\left(30^\\circ\\right) \\\\\n&= -\\frac{\\sqrt{3}}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abca0a98-3a7c-59cf-9ca1-fafec142d1fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749205}] :answer-field/correct {:answer/id #uuid "abca0a98-3a7c-59cf-9ca1-fafec142d1fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186749205} :answer-field/id #uuid "b986ae9e-4087-54bd-b45f-4652562f4456" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186749207}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7b49733d-b3b2-51bc-8e25-b9e8f9358d07" :question/problem "Without using a calculator, find the **exact** value.\n\n$$\n2\\cos^2\\left(15^\\circ\\right)-1=\n$$\n{{field-1}}" :question/worked-solution "Use the cosine double-angle identity:\n\n$$\n2\\cos^2\\left(x\\right)-1=\\cos(2x)\n$$\n\nSubstitute the angle and evaluate the standard-angle cosine:\n\n$$\n\\begin{aligned}\n&2\\cos^2\\left(15^\\circ\\right)-1 \\\\\n&= \\cos\\left(2\\cdot 15^\\circ\\right) \\\\\n&= \\cos\\left(30^\\circ\\right) \\\\\n&= \\frac{\\sqrt{3}}{2}\n\\end{aligned}\n$$"}] :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}]}
