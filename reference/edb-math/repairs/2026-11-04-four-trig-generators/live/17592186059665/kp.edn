#{[{:db/id #edb/ref 17592186059665 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059496 :question/id #uuid "1d8679d3-8922-5471-811f-60c8c41c853a" :question/math-academy-id "e-3522" :question/problem "Express $\\cos\\left( x - \\dfrac{\\pi}{2} \\right)$ in terms of $\\sin x$ and $\\cos x.$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\cos(u - v) = \\cos u \\cos v + \\sin u \\sin v\n$$\n\nApplying the difference formula for cosine with $u = x$ and $v = \\dfrac{\\pi}{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\left(x-\\frac{\\pi }{2}\\right) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+\\operatorname{sin}⁡x\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right) \\\\  & =\\operatorname{cos}⁡x\\cdot 0+\\operatorname{sin}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$"} :knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186749553 :question-generator/id #uuid "3b827934-0095-5325-87ae-7e993c7d9645" :question-generator/script "generators/09/0940f0ed4fcb6eb9670c9075772ac4911f0498659a88606471afc049fa1228b3/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7728e2a-5c28-5db3-b7ba-289f7761c1b4" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186056983} {:answer/id #uuid "eae97f1e-283c-58bb-a6b0-38343ba94a94" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186056984} {:answer/id #uuid "69030a67-ce6a-5f3a-82b9-c32af24a0eb3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x" :db/id #edb/ref 17592186056985} {:answer/id #uuid "701c07df-b095-5da7-a3b4-2bbece344ddb" :answer/type {:db/ident :answer.type/math} :answe