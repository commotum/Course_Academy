{cos}⁡x\\cdot \\left(-\\frac{1}{2}\\right)-\\operatorname{sin}⁡x\\cdot \\left(\\frac{\\sqrt{3}}{2}\\right) \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186253583 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12b4b6a2-fa4c-5800-a03c-dff3849ed336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡w-\\operatorname{cos}⁡w)" :db/id #edb/ref 17592186250712} {:answer/id #uuid "bcb2d3b5-9f77-55ca-a49f-f753c8e38910" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡w-\\operatorname{sin}⁡w" :db/id #edb/ref 17592186252219} {:answer/id #uuid "c94f2ecf-93ac-5340-87bc-eeb34a01cdd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{sin}⁡w-\\sqrt{2}\\operatorname{cos}⁡w)" :db/id #edb/ref 17592186252333} {:answer/id #uuid "e79cd7f0-cb9e-5c1e-81d7-3ea5800024fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{2}\\operatorname{sin}⁡w-\\operatorname{cos}⁡w)" :db/id #edb/ref 17592186252578} {:answer/id #uuid "ff3aec82-b34b-5e4c-93d4-b7250d5ad260" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡w+\\operatorname{cos}⁡w)" :db/id #edb/ref 17592186252796}] :answer-field/correct {:answer/id #uuid "12b4b6a2-fa4c-5800-a03c-dff3849ed336" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡w-\\operatorname{cos}⁡w)" :db/id #edb/ref 17592186250712} :answer-field/id #uuid "c2ed983a-988e-5ef0-83d9-e0d3d1d7aed9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253142}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8e2c5aed-c37a-55b2-85b1-5c5820fa0a08" :question/math-academy-id "q-119485" :question/problem "$\\operatorname{cos}⁡\\left(w-\\frac{3\\pi }{4}\\right)=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=w$ and $v=\\frac{3\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\left(w-\\frac{3\\pi }{4}\\right) & =\\operatorname{cos}⁡w\\operatorname{cos}⁡\\left(\\frac{3\\pi }{4}\\right)+\\operatorname{sin}⁡w\\operatorname{sin}⁡\\left(\\frac{3\\pi }{4}\\right) \\\\  & =\\operatorname{cos}⁡w\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right)+\\operatorname{sin}⁡w\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{sin}⁡w-\\operatorname{cos}⁡w).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186272275 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b931fa1-ee52-5db3-bac9-497efc06f498" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269370} {:answer/id #uuid "2342b124-c9e0-58c0-a580-8d4f8695808a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269577} {:answer/id #uuid "69b15b7b-0cac-5374-93f1-818c8990768a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270207} {:answer/id #uuid "a358caaa-5c57-5746-b54c-5548bfb79b9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270725} {:answer/id #uuid "dff6ea96-0ee2-5bc4-80b8-7b9f1617a512" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271232}] :answer-field/correct {:answer/id #uuid "0b931fa1-ee52-5db3-bac9-497efc06f498" :answer/type {:db/ident :answer.type/m