edb/ref 17592186749523} :answer-field/id #uuid "acb700c8-6d4e-5764-8aee-d62e28f7ae2e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749533}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c7ddba96-b85f-5bda-a524-dba2423b764a" :question/problem "Express $\\cos\\left(x+\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ or $\\cos x$." :question/worked-solution "Use the sum formula:\n\n$$\n\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{\\pi}{2}$, the exact values are $\\cos\\left(\\frac{\\pi}{2}\\right)=0$ and $\\sin\\left(\\frac{\\pi}{2}\\right)=1$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x+\\frac{\\pi}{2}\\right)&=\\cos x\\cos\\left(\\frac{\\pi}{2}\\right)-\\sin x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\cos x\\cdot\\left(0\\right)-\\sin x\\cdot\\left(1\\right)\\\\\n&=-\\sin x.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0804b55f-3231-55ab-8fd6-b3bd9597a35e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sin x-\\frac{\\sqrt{3}}{2}\\cos x" :db/id #edb/ref 17592186749505} {:answer/id #uuid "3451df24-f085-5e80-9258-c094eb3be5d0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x" :db/id #edb/ref 17592186749513} {:answer/id #uuid "53157fd8-d62c-57b2-a2dd-0c51c86d047c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\sin x+\\frac{\\sqrt{3}}{2}\\cos x" :db/id #edb/ref 17592186749518} {:answer/id #uuid "8ecf3516-86f4-58ab-927f-2bb1625f3218" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x" :db/id #edb/ref 17592186749529} {:answer/id #uuid "e25651e9-8e90-5e8b-8b7f-6aaba1c531f2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186749546}] :answer-field/correct {:answer/id #uuid "3451df24-f085-5e80-9258-c094eb3be5d0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x" :db/id #edb/ref 17592186749513} :answer-field/id #uuid "9363adf7-186f-51ab-85a1-92e81d13d378" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749530}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/problem "Express $\\cos\\left(x-\\frac{5\\pi}{3}\\right)$ in terms of $\\sin x$ and $\\cos x$." :question/worked-solution "Use the difference formula:\n\n$$\n\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{5\\pi}{3}$, the exact values are $\\cos\\left(\\frac{5\\pi}{3}\\right)=\\frac{1}{2}$ and $\\sin\\left(\\frac{5\\pi}{3}\\right)=-\\frac{\\sqrt{3}}{2}$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x-\\frac{5\\pi}{3}\\right)&=\\cos x\\cos\\left(\\frac{5\\pi}{3}\\right)+\\sin x\\sin\\left(\\frac{5\\pi}{3}\\right)\\\\\n&=\\cos x\\cdot\\left(\\frac{1}{2}\\right)+\\sin x\\cdot\\left(-\\frac{\\sqrt{3}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749550 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x" :db/id #edb/ref 17592186749517}] :answer-field/correct {:answer/id #uuid "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x" :db/id #edb/ref 17592186749517} :answer-field/id #uuid "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186749536}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/problem "Express $\\cos\\left(x+\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\cos\\left(x+\\frac{\\pi}{2}\\right)=$ {{field-1}}" :question/worked-solution "Use the sum formula:\n\n$$\n\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{\\pi}{2}$, the exact values are $\\cos\\left(\\frac{\\pi}{2}\\right)=0$ and $\\sin\\left(\\frac{\\pi}{2}\\right)=1$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x+\\frac{\\pi}{2}\\right)&=\\cos x\\cos\\left(\\frac{\\pi}{2}\\right)-\\sin x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\cos x\\cdot\\left(0\\right)-\\sin x\\cdot\\left(1\\right)\\\\\n&=-\\sin x.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186749551 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5fdd64-05fb-53aa-b3f5-9c3f49bb0d35" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x" :db/id #edb/ref 17592186749509} {:answer/id #uuid "5976781b-cd9a-586c-8973-439973cc6e45" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186749519} {:answer/id #uuid "5c943a2d-2ac9-5302-a151-a82205807509" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186749520} {:answer/id #uuid "c5cb2240-a227-5d06-bceb-4a62f18f8233" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos x" :db/id #edb/ref 17592186749537} {:answer/id #uuid "fc137ed5-4af6-55e0-85ba-b8b7dedad813" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186749552}] :answer-field/correct {:answer/id #uuid "5976781b-cd9a-586c-8973-439973cc6e45" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186749519} :answer-field/id #uuid "d4e757c7-6604-54e3-904f-0fc307127db0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186749544}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/problem "Express $\\cos\\left(x-\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ or $\\cos x$." :question/worked-solution "Use the difference formula:\n\n$$\n\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{\\pi}{2}$, the exact values are $\\cos\\left(\\frac{\\pi}{2}\\right)=0$ and $\\sin\\left(\\frac{\\pi}{2}\\right)=1$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x-\\frac{\\pi}{2}\\right)&=\\cos x\\cos\\left(\\frac{\\pi}{2}\\right)+\\sin x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\cos x\\cdot\\left(0\\right)+\\sin x\\cdot\\left(1\\right)\\\\\n&=\\sin x.\n\\end{aligned}\n$$"}] :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}]}
