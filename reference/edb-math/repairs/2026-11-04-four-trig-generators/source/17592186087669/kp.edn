\\right)-\\sin^{2}\\left(\\frac{4\\pi}{31}\\right)\\right).\n$$\n\nRecall the **double-angle formula for cosine**:\n\n$$\n\\cos^2 x-\\sin^2 x=\\cos(2x).\n$$\n\nSubstitute $x=\\frac{4\\pi}{31}$ and double the angle:\n\n$$\n\\begin{aligned}\n&6\\left(\\cos^{2}\\left(\\frac{4\\pi}{31}\\right)-\\sin^{2}\\left(\\frac{4\\pi}{31}\\right)\\right) \\\\\n&=6\\cos\\left(2\\cdot \\frac{4\\pi}{31}\\right) \\\\\n&=6\\cos\\left(\\frac{8\\pi}{31}\\right).\n\\end{aligned}\n$$\n\nOnly the angle doubles; the common coefficient stays outside the cosine."} {:db/id #edb/ref 17592186703470 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5772c7fc-86c0-59da-82ee-765252f54172" :answer/type {:db/ident :answer.type/math} :answer/value "6\\cos\\left(\\frac{8\\pi}{31}\\right)" :db/id #edb/ref 17592186703465} {:answer/id #uuid "69cdcde8-bd17-51bd-8913-01f2c3634237" :answer/type {:db/ident :answer.type/math} :answer/value "6\\cos\\left(\\frac{4\\pi}{31}\\right)" :db/id #edb/ref 17592186703469} {:answer/id #uuid "7a84bd13-f227-5a41-a41a-e33de5cdcd62" :answer/type {:db/ident :answer.type/math} :answer/value "6\\cos\\left(\\frac{2\\pi}{31}\\right)" :db/id #edb/ref 17592186703475} {:answer/id #uuid "90e5c43b-aa9f-5eab-ba4b-12a4c54e9b3d" :answer/type {:db/ident :answer.type/math} :answer/value "12\\cos\\left(\\frac{2\\pi}{31}\\right)" :db/id #edb/ref 17592186703478} {:answer/id #uuid "a0b29768-afed-5c58-84db-f6a76b872952" :answer/type {:db/ident :answer.type/math} :answer/value "12\\cos\\left(\\frac{4\\pi}{31}\\right)" :db/id #edb/ref 17592186703481}] :answer-field/correct {:answer/id #uuid "90e5c43b-aa9f-5eab-ba4b-12a4c54e9b3d" :answer/type {:db/ident :answer.type/math} :answer/value "12\\cos\\left(\\frac{2\\pi}{31}\\right)" :db/id #edb/ref 17592186703478} :answer-field/id #uuid "7935dd4a-c980-584d-a1ee-e1be49e66859" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186703472}] :question/difficulty {:db/ident :question.diffic