77de-57f5-afd4-2bf8ad3b1dc1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186303739} :answer-field/id #uuid "51ef8fc9-b283-5905-9e44-87e881dc30ab" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304302} {:answer-field/choices [{:answer/id #uuid "4a3600ad-ef32-5bc6-8dc7-e2e1f54136e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302925} {:answer/id #uuid "98b51796-7f59-4e5c-a4b9-9be4421512c9" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos\\left(330\\right)" :db/id #edb/ref 17592186748730}] :answer-field/correct {:answer/id #uuid "4a3600ad-ef32-5bc6-8dc7-e2e1f54136e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186302925} :answer-field/id #uuid "cd8338c6-4319-5ef6-914e-35e3afb90334" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304635}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6052003d-1d49-5b7d-8e0a-9da23d0ca76c" :question/math-academy-id "q-332517" :question/problem "Express $\\operatorname{cos}⁡(x-{330}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{cos}⁡(x-{330}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={330}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{330}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{330}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{330}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}+\\operatorname{sin}⁡x\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =-\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186335842 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bb8d833-6de2-5451-9f9c-c5d8d3708550" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334096} {:answer/id #uuid "93808a56-eb48-52ea-abc5-c468f9cda602" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186334302} {:answer/id #uuid "d021ad0f-489b-5659-9c18-99da45401b30" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334804} {:answer/id #uuid "d6a7468f-3f6c-532c-88cf-d8fb7621b428" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186334870} {:answer/id #uuid "f1f41673-800b-5ab1-a73f-487ca1004b1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186335110}] :answer-field/correct {:answer/id #uuid "7bb8d833-6de2-5451-9f9c-c5d8d3708550" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186334096} :answer-field/id #uuid "d5ad8fbe-fe48-5093-aa93-26b804d38363" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335625}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "111e5055-17bc-579b-ab4f-19329757a900" :question/math-academy-id "q-65503" :question/problem "$\\operatorname{cos}⁡(x-{90}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={90}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{90}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{90}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{90}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (0)+\\operatorname{sin}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c12236-3fe5-5036-9eca-2a0e85a9c883" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186715260}] :answer-field/correct {:answer/id #uuid "05c12236-3fe5-5036-9eca-2a0e85a9c883" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186715260} :answer-field/id #uuid "4c7ea8b3-138c-53eb-b981-1027c2856319" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715265} {:answer-field/choices [{:answer/id #uuid "26d3d36b-50eb-59a2-90b9-c5baf4f4903c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186715263}] :answer-field/correct {:answer/id #uuid "26d3d36b-50eb-59a2-90b9-c5baf4f4903c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186715263} :answer-field/id #uuid "c131d461-b544-5f07-8ebf-5f22b3009cb0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715274}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "05ad88de-7012-573a-9363-69c2884cc9d5" :question/problem "Simplify $2\\cos(x-60^\\circ)-\\cos(x+60^\\circ)$ using $\\sin x$ and $\\cos x$.\n\nEnter signed coefficients:\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use both cosine formulas:\n\n$$\n\\begin{aligned}\n\\cos(u-v)&=\\cos u\\cos v+\\sin u\\sin v,\\\\\n\\cos(u+v)&=\\cos u\\cos v-\\sin u\\sin v.\n\\end{aligned}\n$$\n\nSince $\\cos 60^\\circ=\\frac{1}{2}$ and $\\sin 60^\\circ=\\frac{\\sqrt{3}}{2}$, the two expansions are\n\n$$\n\\begin{aligned}\n\\cos(x-60^\\circ)&=\\frac{1}{2}\\cos x+\\frac{\\sqrt{3}}{2}\\sin x,\\\\\n\\cos(x+60^\\circ)&=\\frac{1}{2}\\cos x-\\frac{\\sqrt{3}}{2}\\sin x.\n\\end{aligned}\n$$\n\nLet $E=2\\cos(x-60^\\circ)-\\cos(x+60^\\circ)$. Substitute both expansions and distribute the factor $2$ and the subtraction:\n\n$$\n\\begin{aligned}\nE&=2\\left(\\frac{1}{2}\\cos x+\\frac{\\sqrt{3}}{2}\\sin x\\right)\\\\\n&\\quad-\\left(\\frac{1}{2}\\cos x-\\frac{\\sqrt{3}}{2}\\sin x\\right)\\\\\n&=\\cos x+\\sqrt{3}\\sin x\\\\\n&\\quad-\\frac{1}{2}\\cos x+\\frac{\\sqrt{3}}{2}\\sin x.\n\\end{aligned}\n$$\n\nSubtracting the second expansion changes its negative sine term to a positive term. Collect like terms:\n\n$$\n\\begin{aligned}\nE&=\\left(1-\\frac{1}{2}\\right)\\cos x\\\\\n&\\quad+\\left(\\sqrt{3}+\\frac{\\sqrt{3}}{2}\\right)\\sin x\\\\\n&=\\frac{3\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x.\n\\end{aligned}\n$$\n\nThe coefficients are $\\frac{3\\sqrt{3}}{2}$ and $\\frac{1}{2}$, respectively."} {:db/id #edb/ref 17592186715266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c490fe-e8dc-5879-b8ff-344676c48da6" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186715261} {:answer/id #uuid "1b0f96a8-db7b-5d01-bb50-984849f3fb13" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x" :db/id #edb/ref 17592186715262} {:answer/id #uuid "384fad89-a3ac-59c7-8774-912e9f2cf16d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos x" :db/id #edb/ref 17592186715264} {:answer/id #uuid "8f87836a-3d24-53d9-bffe-900d89618f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\cos x-\\sqrt{3}\\sin x}{2}" :db/id #edb/ref 17592186715269} {:answer/id #uuid "b8af9570-12bb-5282-b6dc-2a2bce002da3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186715273}] :answer-field/correct {:answer/id #uuid "384fad89-a3ac-59c7-8774-912e9f2cf16d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos x" :db/id #edb/ref 17592186715264} :answer-field/id #uuid "91a342e6-fc3d-5d95-86c8-f0b43178f6ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186715270}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "713fc9e9-a934-5ade-a434-2fc8e03b3d8a" :question/problem "Express $\\cos(x+180^\\circ)$ in terms of $\\sin x$ or $\\cos x$." :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v.\n$$\n\nApply it with $u=x$ and $v=180^\\circ$. Since $\\cos 180^\\circ=-1$ and $\\sin 180^\\circ=0$,\n\n$$\n\\begin{aligned}\n\\cos(x+180^\\circ)&=\\cos x\\cos 180^\\circ-\\sin x\\sin 180^\\circ\\\\\n&=\\cos x\\cdot(-1)-\\sin x\\cdot0\\\\\n&=-\\cos x.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7e4be31-0343-50f5-a76f-1011a1353282" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186715272}] :answer-field/correct {:answer/id #uuid "b7e4be31-0343-50f5-a76f-1011a1353282" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186715272} :answer-field/id #uuid "8b160ded-c2e0-5ace-b031-b96bf986bcde" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715268} {:answer-field/choices [{:answer/id #uuid "863859fc-acaa-5d85-8d03-5a6ba1713878" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715267}] :answer-field/correct {:answer/id #uuid "863859fc-acaa-5d85-8d03-5a6ba1713878" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715267} :answer-field/id #uuid "f87a711b-7a2f-5706-b666-8ef9859482a9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715275}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9913ffe2-b7c2-526d-9646-266c2a2c651f" :question/problem "Express $\\cos(x+150^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n$\\cos(x+150^\\circ)=$ {{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v.\n$$\n\nThe angle $150^\\circ$ lies in quadrant II, so $\\cos 150^\\circ=-\\frac{\\sqrt{3}}{2}$ and $\\sin 150^\\circ=\\frac{1}{2}$. Therefore,\n\n$$\n\\begin{aligned}\n\\cos(x+150^\\circ)&=\\cos x\\cos 150^\\circ-\\sin x\\sin 150^\\circ\\\\\n&=\\cos x\\left(-\\frac{\\sqrt{3}}{2}\\right)-\\sin x\\left(\\frac{1}{2}\\right)\\\\\n&=-\\frac{1}{2}\\sin x-\\frac{\\sqrt{3}}{2}\\cos x.\n\\end{aligned}\n$$\n\nThe first coefficient is $-\\frac{1}{2}$ and the second is $-\\frac{\\sqrt{3}}{2}$. Each blank includes its coefficient's sign."} {:db/id #edb/ref 17592186715650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12ec722c-80f6-560f-847f-4c6c4fab7651" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186715649} {:answer/id #uuid "5db9ffee-51f9-5cad-a0ea-0514da4807c3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186715658} {:answer/id #uuid "8bc8c4ca-6fce-5d17-8386-e54392c3cf6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sin x+\\frac{1}{2}\\cos x" :db/id #edb/ref 17592186715664} {:answer/id #uuid "a5ce5419-68c2-5b32-ab1b-153e09915574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186715670} {:answer/id #uuid "ffc22e30-af00-5724-bb45-a39b4efb1661" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186715674}] :answer-field/correct {:answer/id #uuid "a5ce5419-68c2-5b32-ab1b-153e09915574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186715670} :answer-field/id #uuid "469c896e-1010-5e2c-9e47-486a55bd7148" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186715655}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "25e76154-9bd8-5895-9ad7-a7cd22262f7d" :question/problem "Express $\\cos(x+225^\\circ)$ in terms of $\\sin x$ and $\\cos x$." :question/worked-solution "Use $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=225^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+225^\\circ)&=\\cos x\\cos 225^\\circ-\\sin x\\sin 225^\\circ\\\\\n&=\\cos x\\left(- \\frac{\\sqrt{2}}{2}\\right)-\\sin x\\left(- \\frac{\\sqrt{2}}{2}\\right)\\\\\n&=\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715659 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ebe237e-532e-5a59-93e3-b51b61fcd337" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186715663}] :answer-field/correct {:answer/id #uuid "7ebe237e-532e-5a59-93e3-b51b61fcd337" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186715663} :answer-field/id #uuid "57f229fe-bec9-52fe-aad5-cf5f84c256db" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715657} {:answer-field/choices [{:answer/id #uuid "9b70604f-5bb2-594d-bed6-1addbaac2093" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715667}] :answer-field/correct {:answer/id #uuid "9b70604f-5bb2-594d-bed6-1addbaac2093" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715667} :answer-field/id #uuid "7166f5e8-56f9-5ecc-a141-15bc361eb431" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715660}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5e0b4cf5-fd40-5c0f-bb16-5040c158b046" :question/problem "Simplify $\\cos(x-60^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v$ with $u=x$ and $v=60^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x-60^\\circ)&=\\cos x\\cos 60^\\circ+\\sin x\\sin 60^\\circ\\\\\n&=\\cos x\\left(\\frac{1}{2}\\right)+\\sin x\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\\n&=\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $\\frac{\\sqrt{3}}{2}$ and the second is $\\frac{1}{2}$."} {:db/id #edb/ref 17592186715662 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "958d1726-9f6e-5736-a24b-7011c1d18911" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186715666}] :answer-field/correct {:answer/id #uuid "958d1726-9f6e-5736-a24b-7011c1d18911" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186715666} :answer-field/id #uuid "27a2780f-a688-58b2-b2c6-ae9ee8cc4718" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715651} {:answer-field/choices [{:answer/id #uuid "7d6a3b83-4160-5fcf-93ab-f9eecd1e395a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186715661}] :answer-field/correct {:answer/id #uuid "7d6a3b83-4160-5fcf-93ab-f9eecd1e395a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186715661} :answer-field/id #uuid "31c9dfd1-cb9c-5e1f-8e7b-6a17e2f8be6c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715652}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7ddc5298-137c-5268-bdce-1c6fbf6bfbda" :question/problem "Simplify $\\cos(x+45^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=45^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+45^\\circ)&=\\cos x\\cos 45^\\circ-\\sin x\\sin 45^\\circ\\\\\n&=\\cos x\\left(\\frac{\\sqrt{2}}{2}\\right)-\\sin x\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $- \\frac{\\sqrt{2}}{2}$ and the second is $\\frac{\\sqrt{2}}{2}$."} {:db/id #edb/ref 17592186715668 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6d340f6-c000-52f1-957b-02a0501b577d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186715672}] :answer-field/correct {:answer/id #uuid "e6d340f6-c000-52f1-957b-02a0501b577d" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186715672} :answer-field/id #uuid "4cfd4b33-dc98-5885-96c4-421d726f05b4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715656} {:answer-field/choices [{:answer/id #uuid "3588307b-0012-5753-8f65-ec56e9deb9c1" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715653}] :answer-field/correct {:answer/id #uuid "3588307b-0012-5753-8f65-ec56e9deb9c1" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715653} :answer-field/id #uuid "fc25cc14-4ec1-5b6b-9bf5-434121e33ebb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715673}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9d4e8d96-4b81-5914-bbc8-a3f869931c44" :question/problem "Simplify $\\cos(x-300^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x-$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v$ with $u=x$ and $v=300^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x-300^\\circ)&=\\cos x\\cos 300^\\circ+\\sin x\\sin 300^\\circ\\\\\n&=\\cos x\\left(\\frac{1}{2}\\right)+\\sin x\\left(- \\frac{\\sqrt{3}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $- \\frac{\\sqrt{3}}{2}$ and the second is $- \\frac{1}{2}$. The printed minus sign means the second entry is the negative of the cosine coefficient: $-\\left(- \\frac{1}{2}\\right)=\\frac{1}{2}$."} {:db/id #edb/ref 17592186715669 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "952872a1-c89a-54bc-a2eb-13547288a4be" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715665}] :answer-field/correct {:answer/id #uuid "952872a1-c89a-54bc-a2eb-13547288a4be" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715665} :answer-field/id #uuid "4187e290-d929-55ae-bb47-702960aec463" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715654} {:answer-field/choices [{:answer/id #uuid "011d5265-0e30-5984-a1e4-483baebb5863" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186715648}] :answer-field/correct {:answer/id #uuid "011d5265-0e30-5984-a1e4-483baebb5863" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186715648} :answer-field/id #uuid "b5c31ec0-cb16-53c1-a4e7-b3cb424280e7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715671}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "9ece7786-8636-5278-a134-aa0a9ecb42aa" :question/problem "Simplify $\\cos(x+120^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x-$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=120^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+120^\\circ)&=\\cos x\\cos 120^\\circ-\\sin x\\sin 120^\\circ\\\\\n&=\\cos x\\left(- \\frac{1}{2}\\right)-\\sin x\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $- \\frac{\\sqrt{3}}{2}$ and the second is $\\frac{1}{2}$. The printed minus sign means the second entry is the negative of the cosine coefficient: $-\\left(\\frac{1}{2}\\right)=- \\frac{1}{2}$."} {:db/id #edb/ref 17592186715680 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74cc3877-8bff-567e-8801-64393e36494b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186715687}] :answer-field/correct {:answer/id #uuid "74cc3877-8bff-567e-8801-64393e36494b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\sqrt{2}}{2}" :db/id #edb/ref 17592186715687} :answer-field/id #uuid "157eaac6-d9b7-5031-8d4f-1a4fc7510af3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715677} {:answer-field/choices [{:answer/id #uuid "1abdc8bd-a07f-5413-9bc7-71d4c174cffa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186715678}] :answer-field/correct {:answer/id #uuid "1abdc8bd-a07f-5413-9bc7-71d4c174cffa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186715678} :answer-field/id #uuid "567d36b7-5544-5553-bf58-a57e8f8d66e8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715684}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "21e797de-cf09-53d4-b0d5-9e682ffa53e0" :question/problem "Simplify $2\\cos(x-135^\\circ)-\\cos(x-45^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v$ with $u=x$ and $v=135^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x-135^\\circ)&=\\cos x\\cos 135^\\circ+\\sin x\\sin 135^\\circ\\\\\n&=\\cos x\\left(- \\frac{\\sqrt{2}}{2}\\right)+\\sin x\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\\n&=\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$\n\nUse $\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v$ with $u=x$ and $v=45^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x-45^\\circ)&=\\cos x\\cos 45^\\circ+\\sin x\\sin 45^\\circ\\\\\n&=\\cos x\\left(\\frac{\\sqrt{2}}{2}\\right)+\\sin x\\left(\\frac{\\sqrt{2}}{2}\\right)\\\\\n&=\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$\n\nDistribute the outside factors, then collect the sine and cosine terms. Let $E$ denote the original expression.\n\n$$\n\\begin{aligned}\nE&=2\\left(\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x\\right)\\\\\n&\\quad -1\\left(\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x\\right)\\\\\n&=\\left(2\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right)+-1\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right)\\right)\\sin x\\\\\n&\\quad+\\left(2\\cdot\\left(- \\frac{\\sqrt{2}}{2}\\right)+-1\\cdot\\left(\\frac{\\sqrt{2}}{2}\\right)\\right)\\cos x\\\\\n&=\\frac{\\sqrt{2}}{2}\\sin x-\\frac{3 \\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $\\frac{\\sqrt{2}}{2}$ and the second is $- \\frac{3 \\sqrt{2}}{2}$."} {:db/id #edb/ref 17592186715689 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56e81d5a-79a6-5c40-a04c-03ca079fd074" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186715685}] :answer-field/correct {:answer/id #uuid "56e81d5a-79a6-5c40-a04c-03ca079fd074" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186715685} :answer-field/id #uuid "c1667f4d-0b4a-52b1-bff2-96f20670b848" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715690} {:answer-field/choices [{:answer/id #uuid "35a2dfc8-1385-5cde-89e8-eda67c0e6329" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{3}" :db/id #edb/ref 17592186715681}] :answer-field/correct {:answer/id #uuid "35a2dfc8-1385-5cde-89e8-eda67c0e6329" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sqrt{3}" :db/id #edb/ref 17592186715681} :answer-field/id #uuid "da98521e-7887-59a8-b3da-7e32279f2ad5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715691}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "9ffe237a-9d62-5b08-b090-09b8c4a0600d" :question/problem "Simplify $2\\cos(x-60^\\circ)+2\\cos(x+240^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v$ with $u=x$ and $v=60^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x-60^\\circ)&=\\cos x\\cos 60^\\circ+\\sin x\\sin 60^\\circ\\\\\n&=\\cos x\\left(\\frac{1}{2}\\right)+\\sin x\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\\n&=\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nUse $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=240^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+240^\\circ)&=\\cos x\\cos 240^\\circ-\\sin x\\sin 240^\\circ\\\\\n&=\\cos x\\left(- \\frac{1}{2}\\right)-\\sin x\\left(- \\frac{\\sqrt{3}}{2}\\right)\\\\\n&=\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nDistribute the outside factors, then collect the sine and cosine terms. Let $E$ denote the original expression.\n\n$$\n\\begin{aligned}\nE&=2\\left(\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\\right)\\\\\n&\\quad +2\\left(\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x\\right)\\\\\n&=\\left(2\\cdot\\left(\\frac{\\sqrt{3}}{2}\\right)+2\\cdot\\left(\\frac{\\sqrt{3}}{2}\\right)\\right)\\sin x\\\\\n&\\quad+\\left(2\\cdot\\left(\\frac{1}{2}\\right)+2\\cdot\\left(- \\frac{1}{2}\\right)\\right)\\cos x\\\\\n&=2 \\sqrt{3}\\sin x\n\\end{aligned}\n$$\n\nThe first blank is $2 \\sqrt{3}$ and the second is $0$."} {:db/id #edb/ref 17592186715693 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebcb1432-2496-5dff-988a-a5024f11bd4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186715694}] :answer-field/correct {:answer/id #uuid "ebcb1432-2496-5dff-988a-a5024f11bd4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186715694} :answer-field/id #uuid "59cd7aff-cce9-5326-8d5b-374eb31cf912" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715686} {:answer-field/choices [{:answer/id #uuid "14aae864-93a3-5a5f-a06f-0d670e8263ee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186715676}] :answer-field/correct {:answer/id #uuid "14aae864-93a3-5a5f-a06f-0d670e8263ee" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186715676} :answer-field/id #uuid "e2c1b52a-8938-5f33-9071-469291c0a290" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715692}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "eba9baa0-1d27-51ba-bf0c-a71477a198e5" :question/problem "Simplify $\\cos(x+330^\\circ)-\\cos(x+210^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=330^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+330^\\circ)&=\\cos x\\cos 330^\\circ-\\sin x\\sin 330^\\circ\\\\\n&=\\cos x\\left(\\frac{\\sqrt{3}}{2}\\right)-\\sin x\\left(- \\frac{1}{2}\\right)\\\\\n&=\\frac{1}{2}\\sin x+\\frac{\\sqrt{3}}{2}\\cos x\n\\end{aligned}\n$$\n\nUse $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=210^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+210^\\circ)&=\\cos x\\cos 210^\\circ-\\sin x\\sin 210^\\circ\\\\\n&=\\cos x\\left(- \\frac{\\sqrt{3}}{2}\\right)-\\sin x\\left(- \\frac{1}{2}\\right)\\\\\n&=\\frac{1}{2}\\sin x-\\frac{\\sqrt{3}}{2}\\cos x\n\\end{aligned}\n$$\n\nDistribute the outside factors, then collect the sine and cosine terms. Let $E$ denote the original expression.\n\n$$\n\\begin{aligned}\nE&=1\\left(\\frac{1}{2}\\sin x+\\frac{\\sqrt{3}}{2}\\cos x\\right)\\\\\n&\\quad -1\\left(\\frac{1}{2}\\sin x-\\frac{\\sqrt{3}}{2}\\cos x\\right)\\\\\n&=\\left(1\\cdot\\left(\\frac{1}{2}\\right)+-1\\cdot\\left(\\frac{1}{2}\\right)\\right)\\sin x\\\\\n&\\quad+\\left(1\\cdot\\left(\\frac{\\sqrt{3}}{2}\\right)+-1\\cdot\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\cos x\\\\\n&=\\sqrt{3}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $0$ and the second is $\\sqrt{3}$."} {:db/id #edb/ref 17592186715695 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98a5f131-f4e3-54c0-870f-8fe65cb5fd0b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186715688}] :answer-field/correct {:answer/id #uuid "98a5f131-f4e3-54c0-870f-8fe65cb5fd0b" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186715688} :answer-field/id #uuid "1e02d4d8-b2e2-5513-a60b-04d21e25f9c0" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715679} {:answer-field/choices [{:answer/id #uuid "3ff3e510-38ec-5948-8f4f-f5530e51cfdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715682}] :answer-field/correct {:answer/id #uuid "3ff3e510-38ec-5948-8f4f-f5530e51cfdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186715682} :answer-field/id #uuid "4b7dcdef-a815-5b9d-a8fb-5011b86abf9f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186715683}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f64ce496-30b9-55e2-87e9-3300b3fffed3" :question/problem "Simplify $\\cos(x-300^\\circ)-2\\cos(x+60^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$" :question/worked-solution "Use $\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v$ with $u=x$ and $v=300^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x-300^\\circ)&=\\cos x\\cos 300^\\circ+\\sin x\\sin 300^\\circ\\\\\n&=\\cos x\\left(\\frac{1}{2}\\right)+\\sin x\\left(- \\frac{\\sqrt{3}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nUse $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=60^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+60^\\circ)&=\\cos x\\cos 60^\\circ-\\sin x\\sin 60^\\circ\\\\\n&=\\cos x\\left(\\frac{1}{2}\\right)-\\sin x\\left(\\frac{\\sqrt{3}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nDistribute the outside factors, then collect the sine and cosine terms. Let $E$ denote the original expression.\n\n$$\n\\begin{aligned}\nE&=1\\left(-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\\right)\\\\\n&\\quad -2\\left(-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x\\right)\\\\\n&=\\left(1\\cdot\\left(- \\frac{\\sqrt{3}}{2}\\right)+-2\\cdot\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\sin x\\\\\n&\\quad+\\left(1\\cdot\\left(\\frac{1}{2}\\right)+-2\\cdot\\left(\\frac{1}{2}\\right)\\right)\\cos x\\\\\n&=\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $\\frac{\\sqrt{3}}{2}$ and the second is $- \\frac{1}{2}$."}] :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}]}
