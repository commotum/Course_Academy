#{[{:db/id #edb/ref 17592186059821 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059628 :question/id #uuid "b643e820-52c3-5c08-a099-aecbed7b2b2a" :question/math-academy-id "e-9991" :question/problem "Express $\\cos(x - 60^\\circ)$ in terms of $\\sin x$ and $\\cos x.$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\cos(u - v) = \\cos{u}\\cos{v} + \\sin{u}\\sin{v}\n$$\n\nApplying the difference formula for cosine with $u = x$ and $v = 60^\\circ,$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{60}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{60}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{60}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}+\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186715675 :question-generator/id #uuid "32bedfd7-518b-5cd9-9fec-23f42b631af7" :question-generator/script "generators/95/95cd0b98e494eb519a94a8be42c7bc7593ebc758f249eb4b1f44b952b55c0399/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060354 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a4d7124-f904-5ac4-a22d-cc43cf695743" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\cos x - \\sqrt{3}\\sin x)" :db/id #edb/ref 17592186058747} {:answer/id #uuid "be36c777-5ed9-5d6f-aeb4-6ff0379a7792" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}(\\sin x + \\cos x)" :db/id #edb/ref 17592186058748} {:answer/id #uuid "ef16edda-be22-5d1c-ab36-ff929563a870" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2