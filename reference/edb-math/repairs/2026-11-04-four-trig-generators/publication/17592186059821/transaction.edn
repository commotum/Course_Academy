-5947-944c-a71cca56bf64" :question/id #uuid "b8e8f898-b7f3-5947-944c-a71cca56bf64"] [:db/add "b8e8f898-b7f3-5947-944c-a71cca56bf64" :question/problem "Simplify $\\cos(x+315^\\circ)$ using $\\sin x$ and $\\cos x$. Enter signed coefficients.\n\n{{field-1}} $\\sin x+$ {{field-2}} $\\cos x$"] [:db/add "b8e8f898-b7f3-5947-944c-a71cca56bf64" :question/worked-solution "Use $\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v$ with $u=x$ and $v=315^\\circ$.\n\n$$\n\\begin{aligned}\n\\cos(x+315^\\circ)&=\\cos x\\cos 315^\\circ-\\sin x\\sin 315^\\circ\\\\\n&=\\cos x\\left(\\frac{\\sqrt{2}}{2}\\right)-\\sin x\\left(- \\frac{\\sqrt{2}}{2}\\right)\\\\\n&=\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $\\frac{\\sqrt{2}}{2}$ and the second is $\\frac{\\sqrt{2}}{2}$."] [:db/add "b8e8f898-b7f3-5947-944c-a71cca56bf64" :question/difficulty :question.difficulty/hard] [:db/add "b8e8f898-b7f3-5947-944c-a71cca56bf64" :question/answer-fields "bbde2693-efc0-5cc5-ae69-cac614494b59"] [:db/add "b8e8f898-b7f3-5947-944c-a71cca56bf64" :question/answer-fields "6c34c6ee-9f4f-5d00-919b-555ff09eea68"] [:db/ensure "b8e8f898-b7f3-5947-944c-a71cca56bf64" :question/validate] [:db/add 17592186059821 :knowledge-point/questions "b8e8f898-b7f3-5947-944c-a71cca56bf64"] [:db/add "ccaff237-f18f-5e6c-9b17-8cfce44a7188" :answer/id #uuid "ccaff237-f18f-5e6c-9b17-8cfce44a7188"] [:db/add "ccaff237-f18f-5e6c-9b17-8cfce44a7188" :answer/type :answer.type/math] [:db/add "ccaff237-f18f-5e6c-9b17-8cfce44a7188" :answer/value "\\frac{1}{2}"] [:db/ensure "ccaff237-f18f-5e6c-9b17-8cfce44a7188" :answer/validate] [:db/add "171e4f40-1166-575a-8673-0e0665dbb854" :answer-field/id #uuid "171e4f40-1166-575a-8673-0e0665dbb854"] [:db/add "171e4f40-1166-575a-8673-0e0665dbb854" :answer-field/key "field-1"] [:db/add "171e4f40-1166-575a-8673-0e0665dbb854" :answer-field/type :answer-field.type/blank] [:db/add "171e4f40-1166-575a-8673-0e0665dbb854" :answer-field/choices "ccaff237-f18f-5e6c-9b17-8cfce4