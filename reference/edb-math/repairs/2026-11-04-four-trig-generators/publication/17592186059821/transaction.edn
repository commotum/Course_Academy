circ-\\sin x\\sin 240^\\circ\\\\\n&=\\cos x\\left(- \\frac{1}{2}\\right)-\\sin x\\left(- \\frac{\\sqrt{3}}{2}\\right)\\\\\n&=\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\n\nThe first blank is $\\frac{\\sqrt{3}}{2}$ and the second is $- \\frac{1}{2}$."] [:db/add "94a90b91-6bfe-504a-85e9-3fc97a8a0533" :question/difficulty :question.difficulty/moderate] [:db/add "94a90b91-6bfe-504a-85e9-3fc97a8a0533" :question/answer-fields "a8fbf15b-29a2-57bb-88fc-26335e5b17a9"] [:db/add "94a90b91-6bfe-504a-85e9-3fc97a8a0533" :question/answer-fields "1e3fd584-fcc9-5dc5-be54-14a37b8751c0"] [:db/ensure "94a90b91-6bfe-504a-85e9-3fc97a8a0533" :question/validate] [:db/add 17592186059821 :knowledge-point/questions "94a90b91-6bfe-504a-85e9-3fc97a8a0533"] [:db/add "6bcfd3e8-db08-5d88-a7ef-488214cc6843" :answer/id #uuid "6bcfd3e8-db08-5d88-a7ef-488214cc6843"] [:db/add "6bcfd3e8-db08-5d88-a7ef-488214cc6843" :answer/type :answer.type/math] [:db/add "6bcfd3e8-db08-5d88-a7ef-488214cc6843" :answer/value "\\frac{1}{2}"] [:db/ensure "6bcfd3e8-db08-5d88-a7ef-488214cc6843" :answer/validate] [:db/add "ce359f6b-99d1-5531-ae49-76f157f57e82" :answer-field/id #uuid "ce359f6b-99d1-5531-ae49-76f157f57e82"] [:db/add "ce359f6b-99d1-5531-ae49-76f157f57e82" :answer-field/key "field-1"] [:db/add "ce359f6b-99d1-5531-ae49-76f157f57e82" :answer-field/type :answer-field.type/blank] [:db/add "ce359f6b-99d1-5531-ae49-76f157f57e82" :answer-field/choices "6bcfd3e8-db08-5d88-a7ef-488214cc6843"] [:db/add "ce359f6b-99d1-5531-ae49-76f157f57e82" :answer-field/correct "6bcfd3e8-db08-5d88-a7ef-488214cc6843"] [:db/ensure "ce359f6b-99d1-5531-ae49-76f157f57e82" :answer-field/validate] [:db/add "e8f8322d-ef1f-53b0-88c9-ef76abf14f5b" :answer/id #uuid "e8f8322d-ef1f-53b0-88c9-ef76abf14f5b"] [:db/add "e8f8322d-ef1f-53b0-88c9-ef76abf14f5b" :answer/type :answer.type/math] [:db/add "e8f8322d-ef1f-53b0-88c9-ef76abf14f5b" :answer/value "- \\frac{\\sqrt{3}}{2}"] [:db/ensure "e8f8322d-ef1f-53b0-88c9-ef76abf14f5b" :answe