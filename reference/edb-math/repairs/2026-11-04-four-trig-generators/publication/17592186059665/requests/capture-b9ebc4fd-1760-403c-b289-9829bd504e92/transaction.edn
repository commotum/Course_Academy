e] [:db/add "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/id #uuid "f219c796-f242-55ce-9fe8-9020e85d7c50"] [:db/add "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/problem "Express $\\cos\\left(x-\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ or $\\cos x$."] [:db/add "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/worked-solution "Use the difference formula:\n\n$$\n\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{\\pi}{2}$, the exact values are $\\cos\\left(\\frac{\\pi}{2}\\right)=0$ and $\\sin\\left(\\frac{\\pi}{2}\\right)=1$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x-\\frac{\\pi}{2}\\right)&=\\cos x\\cos\\left(\\frac{\\pi}{2}\\right)+\\sin x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\cos x\\cdot\\left(0\\right)+\\sin x\\cdot\\left(1\\right)\\\\\n&=\\sin x.\n\\end{aligned}\n$$"] [:db/add "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/difficulty :question.difficulty/easy] [:db/add "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/answer-fields "d4e757c7-6604-54e3-904f-0fc307127db0"] [:db/ensure "f219c796-f242-55ce-9fe8-9020e85d7c50" :question/validate] [:db/add 17592186059665 :knowledge-point/questions "f219c796-f242-55ce-9fe8-9020e85d7c50"] [:db/add "b09b1cc5-6020-53b2-8aaa-17a8e911e511" :answer/id #uuid "b09b1cc5-6020-53b2-8aaa-17a8e911e511"] [:db/add "b09b1cc5-6020-53b2-8aaa-17a8e911e511" :answer/type :answer.type/math] [:db/add "b09b1cc5-6020-53b2-8aaa-17a8e911e511" :answer/value "-\\cos x"] [:db/ensure "b09b1cc5-6020-53b2-8aaa-17a8e911e511" :answer/validate] [:db/add "36a726db-0cae-53a2-8b61-6f93293bf9b4" :answer-field/id #uuid "36a726db-0cae-53a2-8b61-6f93293bf9b4"] [:db/add "36a726db-0cae-53a2-8b61-6f93293bf9b4" :answer-field/key "field-1"] [:db/add "36a726db-0cae-53a2-8b61-6f93293bf9b4" :answer-field/type :answer-field.type/blank] [:db/add "36a726db-0cae-53a2-8b61-6f93293bf9b4" :answer-field/choices "b09b1cc5-6020-53b2-8aaa-17a8e911e511"] [:db/add "36a726db-0cae-53a2-8b61-6f93293bf9b4" :answer-field/correct "b09b1cc5-6020-53b2-8aaa-17a8e911e511"] [:db/ensure "36a726db-0cae-53a2-8b61-6f93293bf9b4" :answer-field/validate] [:db/add "997d0f1d-d108-5a39-a1d4-ee3403b11114" :question/id #uuid "997d0f1d-d108-5a39-a1d4-ee3403b11114"] [:db/add "997d0f1d-d108-5a39-a1d4-ee3403b11114" :question/problem "Express $\\cos\\left(x-\\pi\\right)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\cos\\left(x-\\pi\\right)=$ {{field-1}}"] [:db/add "997d0f1d-d108-5a39-a1d4-ee3403b11114" :question/worked-solution "Use the difference formula:\n\n$$\n\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\pi$, the exact values are $\\cos(\\pi)=-1$ and $\\sin(\\pi)=0$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x-\\pi\\right)&=\\cos x\\cos\\left(\\pi\\right)+\\sin x\\sin\\left(\\pi\\right)\\\\\n&=\\cos x\\cdot\\left(-1\\right)+\\sin x\\cdot\\left(0\\right)\\\\\n&=-\\cos x.\n\\end{aligned}\n$$"] [:db/add "997d0f1d-d108-5a39-a1d4-ee3403b11114" :question/difficulty :question.difficulty/moderate] [:db/add "997d0f1d-d108-5a39-a1d4-ee3403b11114" :question/answer-fields "36a726db-0cae-53a2-8b61-6f93293bf9b4"] [:db/ensure "997d0f1d-d108-5a39-a1d4-ee3403b11114" :question/validate] [:db/add 17592186059665 :knowledge-point/questions "997d0f1d-d108-5a39-a1d4-ee3403b11114"] [:db/add "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22" :answer/id #uuid "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22"] [:db/add "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22" :answer/type :answer.type/math] [:db/add "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22" :answer/value "\\sin x"] [:db/ensure "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22" :answer/validate] [:db/add "84732176-1654-5623-a449-d95b2ccc84ca" :answer-field/id #uuid "84732176-1654-5623-a449-d95b2ccc84ca"] [:db/add "84732176-1654-5623-a449-d95b2ccc84ca" :answer-field/key "field-1"] [:db/add "84732176-1654-5623-a449-d95b2ccc84ca" :answer-field/type :answer-field.type/blank] [:db/add "84732176-1654-5623-a449-d95b2ccc84ca" :answer-field/choices "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22"] [:db/add "84732176-1654-5623-a449-d95b2ccc84ca" :answer-field/correct "8dc62d6c-ef52-54e8-b22a-e6c7b5151b22"] [:db/ensure "84732176-1654-5623-a449-d95b2ccc84ca" :answer-field/validate] [:db/add "33557e0a-53e1-5c03-9880-6696d51ec59a" :question/id #uuid "33557e0a-53e1-5c03-9880-6696d51ec59a"] [:db/add "33557e0a-53e1-5c03-9880-6696d51ec59a" :question/problem "Express $\\cos\\left(x+\\frac{3\\pi}{2}\\right)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\cos\\left(x+\\frac{3\\pi}{2}\\right)=$ {{field-1}}"] [:db/add "33557e0a-53e1-5c03-9880-6696d51ec59a" :question/worked-solution "Use the sum formula:\n\n$$\n\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{3\\pi}{2}$, the exact values are $\\cos\\left(\\frac{3\\pi}{2}\\right)=0$ and $\\sin\\left(\\frac{3\\pi}{2}\\right)=-1$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x+\\frac{3\\pi}{2}\\right)&=\\cos x\\cos\\left(\\frac{3\\pi}{2}\\right)-\\sin x\\sin\\left(\\frac{3\\pi}{2}\\right)\\\\\n&=\\cos x\\cdot\\left(0\\right)-\\sin x\\cdot\\left(-1\\right)\\\\\n&=\\sin x.\n\\end{aligned}\n$$"] [:db/add "33557e0a-53e1-5c03-9880-6696d51ec59a" :question/difficulty :question.difficulty/moderate] [:db/add "33557e0a-53e1-5c03-9880-6696d51ec59a" :question/answer-fields "84732176-1654-5623-a449-d95b2ccc84ca"] [:db/ensure "33557e0a-53e1-5c03-9880-6696d51ec59a" :question/validate] [:db/add 17592186059665 :knowledge-point/questions "33557e0a-53e1-5c03-9880-6696d51ec59a"] [:db/add "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1" :answer/id #uuid "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1"] [:db/add "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1" :answer/type :answer.type/math] [:db/add "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1" :answer/value "-\\sin x"] [:db/ensure "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1" :answer/validate] [:db/add "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/id #uuid "bbd740c1-10c0-52b8-8f52-3664f61e1e30"] [:db/add "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/key "field-1"] [:db/add "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/type :answer-field.type/blank] [:db/add "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/choices "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1"] [:db/add "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/correct "4b8e71c2-d0e7-5524-abeb-9e9fcd0158e1"] [:db/ensure "bbd740c1-10c0-52b8-8f52-3664f61e1e30" :answer-field/validate] [:db/add "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/id #uuid "efd9d4ae-65a5-5008-8f35-473189c8e660"] [:db/add "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/problem "Express $\\cos\\left(x+\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\cos\\left(x+\\frac{\\pi}{2}\\right)=$ {{field-1}}"] [:db/add "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/worked-solution "Use the sum formula:\n\n$$\n\\cos(u+v)=\\cos u\\cos v-\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{\\pi}{2}$, the exact values are $\\cos\\left(\\frac{\\pi}{2}\\right)=0$ and $\\sin\\left(\\frac{\\pi}{2}\\right)=1$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x+\\frac{\\pi}{2}\\right)&=\\cos x\\cos\\left(\\frac{\\pi}{2}\\right)-\\sin x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\cos x\\cdot\\left(0\\right)-\\sin x\\cdot\\left(1\\right)\\\\\n&=-\\sin x.\n\\end{aligned}\n$$"] [:db/add "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/difficulty :question.difficulty/moderate] [:db/add "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/answer-fields "bbd740c1-10c0-52b8-8f52-3664f61e1e30"] [:db/ensure "efd9d4ae-65a5-5008-8f35-473189c8e660" :question/validate] [:db/add 17592186059665 :knowledge-point/questions "efd9d4ae-65a5-5008-8f35-473189c8e660"] [:db/add "0804b55f-3231-55ab-8fd6-b3bd9597a35e" :answer/id #uuid "0804b55f-3231-55ab-8fd6-b3bd9597a35e"] [:db/add "0804b55f-3231-55ab-8fd6-b3bd9597a35e" :answer/type :answer.type/math] [:db/add "0804b55f-3231-55ab-8fd6-b3bd9597a35e" :answer/value "\\fr