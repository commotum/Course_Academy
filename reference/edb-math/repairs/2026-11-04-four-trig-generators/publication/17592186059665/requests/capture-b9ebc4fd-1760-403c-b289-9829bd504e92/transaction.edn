3adf7-186f-51ab-85a1-92e81d13d378" :answer-field/choices "8ecf3516-86f4-58ab-927f-2bb1625f3218"] [:db/add "9363adf7-186f-51ab-85a1-92e81d13d378" :answer-field/choices "53157fd8-d62c-57b2-a2dd-0c51c86d047c"] [:db/add "9363adf7-186f-51ab-85a1-92e81d13d378" :answer-field/choices "3451df24-f085-5e80-9258-c094eb3be5d0"] [:db/add "9363adf7-186f-51ab-85a1-92e81d13d378" :answer-field/choices "e25651e9-8e90-5e8b-8b7f-6aaba1c531f2"] [:db/add "9363adf7-186f-51ab-85a1-92e81d13d378" :answer-field/correct "3451df24-f085-5e80-9258-c094eb3be5d0"] [:db/ensure "9363adf7-186f-51ab-85a1-92e81d13d378" :answer-field/validate] [:db/add "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/id #uuid "e2e0ca28-7673-52d2-9272-1d429da2bf6d"] [:db/add "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/problem "Express $\\cos\\left(x-\\frac{5\\pi}{3}\\right)$ in terms of $\\sin x$ and $\\cos x$."] [:db/add "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/worked-solution "Use the difference formula:\n\n$$\n\\cos(u-v)=\\cos u\\cos v+\\sin u\\sin v\n$$\n\nWith $u=x$ and $v=\\frac{5\\pi}{3}$, the exact values are $\\cos\\left(\\frac{5\\pi}{3}\\right)=\\frac{1}{2}$ and $\\sin\\left(\\frac{5\\pi}{3}\\right)=-\\frac{\\sqrt{3}}{2}$. Substitute and collect the terms in the requested order:\n\n$$\n\\begin{aligned}\n\\cos\\left(x-\\frac{5\\pi}{3}\\right)&=\\cos x\\cos\\left(\\frac{5\\pi}{3}\\right)+\\sin x\\sin\\left(\\frac{5\\pi}{3}\\right)\\\\\n&=\\cos x\\cdot\\left(\\frac{1}{2}\\right)+\\sin x\\cdot\\left(-\\frac{\\sqrt{3}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x+\\frac{1}{2}\\cos x.\n\\end{aligned}\n$$"] [:db/add "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/difficulty :question.difficulty/hard] [:db/add "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/answer-fields "9363adf7-186f-51ab-85a1-92e81d13d378"] [:db/ensure "e2e0ca28-7673-52d2-9272-1d429da2bf6d" :question/validate] [:db/add 17592186059665 :knowledge-point/questions "e2e0ca28-7673-52d2-9272-1d429da2bf6d"] [:db/add "generator" :question-gene