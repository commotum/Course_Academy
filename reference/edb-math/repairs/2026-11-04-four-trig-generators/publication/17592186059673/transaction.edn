c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/id #uuid "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/key "selection"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/type :answer-field.type/radio] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/choices "a3b91745-c173-5b06-9f6a-0cd518d0fdc9"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/choices "47b8c61d-4a0b-5c94-b5c6-85730e3a17df"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/choices "c04ba8ae-616f-5d57-981e-b5c437ff8294"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/choices "84a30ada-41bb-53e5-a05f-4d60131e4dee"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/choices "8d43f041-f988-5d56-8058-36d8503b15c4"] [:db/add "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/correct "8d43f041-f988-5d56-8058-36d8503b15c4"] [:db/ensure "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9" :answer-field/validate] [:db/add "5361be42-5ed7-5adf-8a76-6512902e8c29" :question/id #uuid "5361be42-5ed7-5adf-8a76-6512902e8c29"] [:db/add "5361be42-5ed7-5adf-8a76-6512902e8c29" :question/problem "Simplify.\n\n$$\n\\frac{\\sin\\left(78^\\circ\\right)\\tan\\left(39^\\circ\\right)-1}{\\sin\\left(39^\\circ\\right)+\\cos\\left(39^\\circ\\right)}\n$$"] [:db/add "5361be42-5ed7-5adf-8a76-6512902e8c29" :question/worked-solution "Write $s=\\sin\\left(39^\\circ\\right)$ and $c=\\cos\\left(39^\\circ\\right)$. The **double-angle formula** gives $\\sin\\left(78^\\circ\\right)=2sc$.\n\n Also, $\\tan\\left(39^\\circ\\right)=\\frac{s}{c}$.\n\nRewrite the quotient ratio and use $s^2+c^2=1$ to obtain a difference of squares. Factor before cancelling.\n\n$$\n\\begin{aligned}\n\\frac{2sc\\frac{s}{c}-1}{s+c} &=\\frac{2s^2-1}{s+c} \\\\ &=\\frac{s^2-c^2}{s+c} \\\\ &=\\frac{(s-c)(s+c)}{s+c} \\\\ &=s-c \\\\ &=\\sin\\left(39^\\circ\\right)-\\cos\\left(39^\\circ\\right)\n\\end{aligned}\n$$\n\nAll cancellations use nonzero factors in the original expression."] [:db/add "5361be42-5ed7-5adf-8a76-6512902e8c29" :question/difficulty :question.difficulty/hard] [:db/add "5361be42-5ed7-5adf-8a76-6512902e8c29" :question/answer-fields "3f2c8c71-68f7-5d41-a6f5-01b424a3ebe9"] [:db/ensure "5361be42-5ed7-5adf-8a76-6512902e8c29" :question/validate] [:db/add 17592186059673 :knowledge-point/questions "5361be42-5ed7-5adf-8a76-6512902e8c29"] [:db/add "generator" :question-generator/id #uuid "759060c0-6ada-5d66-aeb2-e202f6e9c388"] [:db/add "generator" :question-generator/script "generators/d6/d64d5cee7b50e4f748630325af27e242aee56cca050b61682d334fced52fc034/generator.py"] [:db/add 17592186059673 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059673 :knowledge-point/validate] [:db/cas 17592186696346 :question/retired nil true] [:db/cas 17592186696347 :question/retired nil true] [:db/cas 17592186696353 :question/retired nil true] [:db/cas 17592186696356 :question/retired nil true] [:db/cas 17592186696369 :question/retired nil true] [:db/cas 17592186696446 :question/retired nil true] [:db/cas 17592186696456 :question/retired nil true] [:db/cas 17592186696490 :question/retired nil true] [:db/cas 17592186696500 :question/retired nil true]]
