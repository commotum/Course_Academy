 "272794e9-8de4-5c64-b54c-1385df676f1f"] [:db/add "8b6b53df-e7cc-5585-a58c-ecc963575330" :answer-field/choices "3402802b-a4f1-5e03-bc6f-a5c402ce1f0b"] [:db/add "8b6b53df-e7cc-5585-a58c-ecc963575330" :answer-field/choices "e554401a-24c3-58c2-8aa7-2695e83f00a2"] [:db/add "8b6b53df-e7cc-5585-a58c-ecc963575330" :answer-field/choices "4a01fd0b-73cb-5a3f-85fd-bbef5cd79413"] [:db/add "8b6b53df-e7cc-5585-a58c-ecc963575330" :answer-field/choices "6662a77a-f4a9-517b-8f98-c2edf162f7c0"] [:db/add "8b6b53df-e7cc-5585-a58c-ecc963575330" :answer-field/correct "e554401a-24c3-58c2-8aa7-2695e83f00a2"] [:db/ensure "8b6b53df-e7cc-5585-a58c-ecc963575330" :answer-field/validate] [:db/add "6735129e-3b3d-5f85-9610-818aaff3755c" :question/id #uuid "6735129e-3b3d-5f85-9610-818aaff3755c"] [:db/add "6735129e-3b3d-5f85-9610-818aaff3755c" :question/problem "Simplify.\n\n$$\n\\frac{\\sin\\left(\\frac{2\\pi}{19}\\right)}{\\cos^2\\left(\\frac{\\pi}{19}\\right)}\n$$"] [:db/add "6735129e-3b3d-5f85-9610-818aaff3755c" :question/worked-solution "Write $s=\\sin\\left(\\frac{\\pi}{19}\\right)$ and $c=\\cos\\left(\\frac{\\pi}{19}\\right)$. The **double-angle formula** gives $\\sin\\left(\\frac{2\\pi}{19}\\right)=2sc$.\n\n\n\nCancel one factor of the squared denominator, then rewrite the quotient.\n\n$$\n\\begin{aligned}\n\\frac{2sc}{c^2} &=\\frac{2s}{c} \\\\ &=2\\tan\\left(\\frac{\\pi}{19}\\right)\n\\end{aligned}\n$$\n\nAll cancellations use nonzero factors in the original expression."] [:db/add "6735129e-3b3d-5f85-9610-818aaff3755c" :question/difficulty :question.difficulty/moderate] [:db/add "6735129e-3b3d-5f85-9610-818aaff3755c" :question/answer-fields "8b6b53df-e7cc-5585-a58c-ecc963575330"] [:db/ensure "6735129e-3b3d-5f85-9610-818aaff3755c" :question/validate] [:db/add 17592186059673 :knowledge-point/questions "6735129e-3b3d-5f85-9610-818aaff3755c"] [:db/add "6fab64ec-672d-5cad-b805-6b8c20e17d4e" :answer/id #uuid "6fab64ec-672d-5cad-b805-6b8c20e17d4e"] [:db/add "6fab64ec-672d-5cad-b805-6b8c20e17d4e" :a