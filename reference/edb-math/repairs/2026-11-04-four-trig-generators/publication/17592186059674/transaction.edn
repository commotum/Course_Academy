"] [:db/add "323e1172-86d5-5365-84b8-5bc2f42c1ed1" :answer/type :answer.type/math] [:db/add "323e1172-86d5-5365-84b8-5bc2f42c1ed1" :answer/value "- \\frac{\\sqrt{2}}{4}"] [:db/ensure "323e1172-86d5-5365-84b8-5bc2f42c1ed1" :answer/validate] [:db/add "3a42dd5a-3e8c-516e-8968-cdffcabbd549" :answer-field/id #uuid "3a42dd5a-3e8c-516e-8968-cdffcabbd549"] [:db/add "3a42dd5a-3e8c-516e-8968-cdffcabbd549" :answer-field/key "value"] [:db/add "3a42dd5a-3e8c-516e-8968-cdffcabbd549" :answer-field/type :answer-field.type/blank] [:db/add "3a42dd5a-3e8c-516e-8968-cdffcabbd549" :answer-field/choices "323e1172-86d5-5365-84b8-5bc2f42c1ed1"] [:db/add "3a42dd5a-3e8c-516e-8968-cdffcabbd549" :answer-field/correct "323e1172-86d5-5365-84b8-5bc2f42c1ed1"] [:db/ensure "3a42dd5a-3e8c-516e-8968-cdffcabbd549" :answer-field/validate] [:db/add "e028ee12-09c4-5cf4-abbd-e86b1689f8ee" :question/id #uuid "e028ee12-09c4-5cf4-abbd-e86b1689f8ee"] [:db/add "e028ee12-09c4-5cf4-abbd-e86b1689f8ee" :question/problem "Without using a calculator, find the exact value of\n\n$$\n\\sin\\left(\\frac{5 \\pi}{8}\\right)\\cos\\left(\\frac{5 \\pi}{8}\\right)\n$$\n\n$$\n\\sin\\left(\\frac{5 \\pi}{8}\\right)\\cos\\left(\\frac{5 \\pi}{8}\\right)=\n$$\n{{value}}"] [:db/add "e028ee12-09c4-5cf4-abbd-e86b1689f8ee" :question/worked-solution "Use the double-angle formula for sine and keep the multiplier.\n\nSet $x=\\frac{5 \\pi}{8}$.\n\n$$\n\\begin{aligned}2\\sin x\\cos x &=\\sin(2x) \\\\ &=\\sin\\left(\\frac{5 \\pi}{4}\\right) \\\\ &=- \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute this exact value:\n\n$$\n\\begin{aligned}\\sin\\left(\\frac{5 \\pi}{8}\\right)\\cos\\left(\\frac{5 \\pi}{8}\\right)&=\\frac{1}{2}\\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &=- \\frac{\\sqrt{2}}{4}\\end{aligned}\n$$"] [:db/add "e028ee12-09c4-5cf4-abbd-e86b1689f8ee" :question/difficulty :question.difficulty/easy] [:db/add "e028ee12-09c4-5cf4-abbd-e86b1689f8ee" :question/answer-fields "3a42dd5a-3e8c-516e-8968-cdffcabbd549"] [:db/ensure "e028ee12-09c4-5cf4-abbd-e86b1689f8ee" :question/validate] [:db/add 17592186059674 :knowledge-point/questions "e028ee12-09c4-5cf4-abbd-e86b1689f8ee"] [:db/add "da3d2ca5-20ab-56fd-82c9-add126a2fe0c" :answer/id #uuid "da3d2ca5-20ab-56fd-82c9-add126a2fe0c"] [:db/add "da3d2ca5-20ab-56fd-82c9-add126a2fe0c" :answer/type :answer.type/math] [:db/add "da3d2ca5-20ab-56fd-82c9-add126a2fe0c" :answer/value "\\frac{1}{2}"] [:db/ensure "da3d2ca5-20ab-56fd-82c9-add126a2fe0c" :answer/validate] [:db/add "16869b4b-50fa-5296-ad11-3eecc2f26fd4" :answer/id #uuid "16869b4b-50fa-5296-ad11-3eecc2f26fd4"] [:db/add "16869b4b-50fa-5296-ad11-3eecc2f26fd4" :answer/type :answer.type/math] [:db/add "16869b4b-50fa-5296-ad11-3eecc2f26fd4" :answer/value "1 + \\sqrt{2}"] [:db/ensure "16869b4b-50fa-5296-ad11-3eecc2f26fd4" :answer/validate] [:db/add "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1" :answer/id #uuid "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1"] [:db/add "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1" :answer/type :answer.type/math] [:db/add "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1" :answer/value "\\frac{\\sqrt{2}}{2} + 1"] [:db/ensure "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1" :answer/validate] [:db/add "d82f13c6-5907-5db8-b79d-c6466e2e864b" :answer/id #uuid "d82f13c6-5907-5db8-b79d-c6466e2e864b"] [:db/add "d82f13c6-5907-5db8-b79d-c6466e2e864b" :answer/type :answer.type/math] [:db/add "d82f13c6-5907-5db8-b79d-c6466e2e864b" :answer/value "0"] [:db/ensure "d82f13c6-5907-5db8-b79d-c6466e2e864b" :answer/validate] [:db/add "a0c5d049-bc6a-5a0a-8dce-e71b7bfb349d" :answer/id #uuid "a0c5d049-bc6a-5a0a-8dce-e71b7bfb349d"] [:db/add "a0c5d049-bc6a-5a0a-8dce-e71b7bfb349d" :answer/type :answer.type/math] [:db/add "a0c5d049-bc6a-5a0a-8dce-e71b7bfb349d" :answer/value "1 - \\frac{\\sqrt{2}}{2}"] [:db/ensure "a0c5d049-bc6a-5a0a-8dce-e71b7bfb349d" :answer/validate] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/id #uuid "2f22ba46-c8aa-57cb-842f-f1057daed0b6"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/key "value"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/type :answer-field.type/radio] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/choices "da3d2ca5-20ab-56fd-82c9-add126a2fe0c"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/choices "16869b4b-50fa-5296-ad11-3eecc2f26fd4"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/choices "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/choices "d82f13c6-5907-5db8-b79d-c6466e2e864b"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/choices "a0c5d049-bc6a-5a0a-8dce-e71b7bfb349d"] [:db/add "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/correct "bd8749a9-85c9-5a49-a1dd-fd229e5e67f1"] [:db/ensure "2f22ba46-c8aa-57cb-842f-f1057daed0b6" :answer-field/validate] [:db/add "ad003933-1da3-50f3-a6f1-1af9b15ec325" :question/id #uuid "ad003933-1da3-50f3-a6f1-1af9b15ec325"] [:db/add "ad003933-1da3-50f3-a6f1-1af9b15ec325" :question/problem "Without using a calculator, find the exact value of\n\n$$\n\\left(\\sin\\left(22.5^{\\circ}\\right)+\\cos\\left(22.5^{\\circ}\\right)\\right)^2\n$$"] [:db/add "ad003933-1da3-50f3-a6f1-1af9b15ec325" :question/worked-solution "Expand the square and use the Pythagorean identity.\n\nSet $x=22.5^{\\circ}$.\n\n$$\n\\begin{aligned}(\\sin x+\\cos x)^2 &= \\sin^2 x+2\\sin x\\cos x+\\cos^2 x \\\\ &=1+2\\sin x\\cos x \\\\ &=1+\\sin(2x)\\end{aligned}\n$$\n\n$$\n\\begin{aligned}2\\sin x\\cos x &=\\sin(2x) \\\\ &=\\sin\\left(45^{\\circ}\\right) \\\\ &=\\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute this exact value:\n\n$$\n\\begin{aligned}\\left(\\sin\\left(22.5^{\\circ}\\right)+\\cos\\left(22.5^{\\circ}\\right)\\right)^2&=1+\\left(\\frac{\\sqrt{2}}{2}\\right) \\\\ &=\\frac{\\sqrt{2}}{2} + 1\\end{aligned}\n$$"] [:db/add "ad003933-1da3-50f3-a6f1-1af9b15ec325" :question/difficulty :question.difficulty/moderate] [:db/add "ad003933-1da3-50f3-a6f1-1af9b15ec325" :question/answer-fields "2f22ba46-c8aa-57cb-842f-f1057daed0b6"] [:db/ensure "ad003933-1da3-50f3-a6f1-1af9b15ec325" :question/validate] [:db/add 17592186059674 :knowledge-point/questions "ad003933-1da3-50f3-a6f1-1af9b15ec325"] [:db/add "e0cfb0e4-9037-5ecf-83bf-051b5030b1bc" :answer/id #uuid "e0cfb0e4-9037-5ecf-83bf-051b5030b1bc"] [:db/add "e0cfb0e4-9037-5ecf-83bf-051b5030b1bc" :answer/type :answer.type/math] [:db/add "e0cfb0e4-9037-5ecf-83bf-051b5030b1bc" :answer/value "\\frac{1}{2}"] [:db/ensure "e0cfb0e4-9037-5ecf-83bf-051b5030b1bc" :answer/validate] [:db/add "9b8bff19-af20-5547-82a0-450b5d347fb8" :answer/id #uuid "9b8bff19-af20-5547-82a0-450b5d347fb8"] [:db/add "9b8bff19-af20-5547-82a0-450b5d347fb8" :answer/type :answer.type/math] [:db/add "9b8bff19-af20-5547-82a0-450b5d347fb8" :answer/value "\\frac{1}{4}"] [:db/ensure "9b8bff19-af20-5547-82a0-450b5d347fb8" :answer/validate] [:db/add "fb1e52ba-d0dd-5716-9796-af3b4984ae20" :answer/id #uuid "fb1e52ba-d0dd-5716-9796-af3b4984ae20"] [:db/add "fb1e52ba-d0dd-5716-9796-af3b4984ae20" :answer/type :answer.type/math] [:db/add "fb1e52ba-d0dd-5716-9796-af3b4984ae20" :answer/value "- \\frac{\\sqrt{3}}{4}"] [:db/ensure "fb1e52ba-d0dd-5716-9796-af3b4984ae20" :answer/validate] [:db/add "6a9fd2e9-e55a-5b46-bee6-3090f0c9c335" :answer/id #uuid "6a9fd2e9-e55a-5b46-bee6-3090f0c9c335"] [:db/add "6a9fd2e9-e55a-5b46-bee6-3090f0c9c335" :answer/type :answer.type/math] [:db/add "6a9fd2e9-e55a-5b46-bee6-3090f0c9c335" :answer/value "- \\frac{\\sqrt{2}}{4}"] [:db/ensure "6a9fd2e9-e55a-5b46-bee6-3090f0c9c335" :answer/validate] [:db/add "380e937f-162e-5937-b7ec-9fbc3584bcdf" :answer/id #uuid "380e937f-162e-5937-b7ec-9fbc3584bcdf"] [:db/add "380e937f-162e-5937-b7ec-9fbc3584bcdf" :answer/type :answer.type/math] [:db/add "380e937f-162e-5937-b7ec-9fbc3584bcdf" :answer/value "- \\frac{1}{4}"] [:db/ensure "380e937f-162e-5937-b7ec-9fbc3584bcdf" :answer/validate] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/id #uuid "ae7dbe42-e899-580e-8369-0598f9f4cae0"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/key "value"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/type :answer-field.type/radio] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/choices "e0cfb0e4-9037-5ecf-83bf-051b5030b1bc"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/choices "9b8bff19-af20-5547-82a0-450b5d347fb8"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/choices "fb1e52ba-d0dd-5716-9796-af3b4984ae20"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/choices "6a9fd2e9-e55a-5b46-bee6-3090f0c9c335"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/choices "380e937f-162e-5937-b7ec-9fbc3584bcdf"] [:db/add "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/correct "9b8bff19-af20-5547-82a0-450b5d347fb8"] [:db/ensure "ae7dbe42-e899-580e-8369-0598f9f4cae0" :answer-field/validate] [:db/add "101d5959-4f52-5e8b-b4b5-84c7224b6154" :question/id #uuid "101d5959-4f52-5e8b-b4b5-84c7224b6154"] [:db/add "101d5959-4f52-5e8b-b4b5-84c7224b6154" :question/problem "Without using a calculator, find the exact value of\n\n$$\n\\frac{\\sin\\left(\\frac{\\pi}{12}\\right)}{\\sec\\left(\\frac{\\pi}{12}\\right)}\n$$"] [:db/add "101d5959-4f52-5e8b-b4b5-84c7224b6154" :question/worked-solution "Rewrite the reciprocal denominator to expose a sine–cosine product.\n\nSet $x=\\frac{\\pi}{12}$.\n\n$$\n\\frac{\\sin\\left(x\\right)}{\\sec\\left(x\\right)}=\\sin\\left(x\\right)\\cdot\\frac{1}{\\sec\\left(x\\right)}=\\sin x\\cos x\n$$\n\n$$\n\\begin{aligned}2\\sin x\\cos x &=\\sin(2x) \\\\ &=\\sin\\left(\\frac{\\pi}{6}\\right) \\\\ &=\\frac{1}{2}\\end{aligned}\n$$\n\nSubstitute this exact value:\n\n$$\n\\begin{aligned}\\frac{\\sin\\left(\\frac{\\pi}{12}\\right)}{\\sec\\left(\\frac{\\pi}{12}\\right)}&=\\frac{1}{2}\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{1}{4}\\end{aligned}\n$$"] [:db/add "101d5959-4f52-5e8b-b4b5-84c7224b6154" :question/difficulty :question.difficulty/hard] [:db/add "101d5959-4f52-5e8b-b4b5-84c7224b6154" :question/answer-fields "ae7dbe42-e899-580e-8369-0598f9f4cae0"] [:db/ensure "101d5959-4f52-5e8b-b4b5-84c7224b6154" :question/validate] [:db/add 17592186059674 :knowledge-point/questions "101d5959-4f52-5e8b-b4b5-84c7224b6154"] [:db/add "generator" :question-generator/id #uuid "3eb33477-ece3-5740-bd01-61b4220002a5"] [:db/add "generator" :question-generator/script "generators/4a/4a0e6f87ac4ec68e1028912b0bd4f31d8c456c1cad76544c5d294968264094c8/generator.py"] [:db/add 17592186059674 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059674 :knowledge-point/validate] [:db/cas 17592186696379 :question/retired nil true] [:db/cas 17592186696380 :question/retired nil true] [:db/cas 17592186696386 :question/retired nil true] [:db/cas 17592186696392 :question/retired nil true] [:db/cas 17592186696405 :question/retired nil true] [:db/cas 17592186696501 :question/retired nil true] [:db/cas 17592186696509 :question/retired nil true]]
