{:answer/id #uuid "8d604dff-b7f8-55d8-8e26-f14966ac8a9a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186696389} {:answer/id #uuid "afb4b8be-68b4-5670-a925-01828b55c9fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186696395} {:answer/id #uuid "bd31b3a4-5bb6-54ab-9737-42c3891baa49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186696396} {:answer/id #uuid "e5c4f477-27e9-54d1-b71d-30ef4b0e9d0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186696404}] :answer-field/correct {:answer/id #uuid "afb4b8be-68b4-5670-a925-01828b55c9fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186696395} :answer-field/id #uuid "da1e63fb-ecd4-55aa-b29a-2a3bf126dbbb" :answer-field/key "value" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696402}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ea75dccf-91d0-57cc-9194-af310c0de40e" :question/problem "Without using a calculator, find the exact value of\n\n$$\n\\sin\\left(15^{\\circ}\\right)\\cos\\left(15^{\\circ}\\right)\n$$" :question/worked-solution "Use the double-angle formula for sine and keep the multiplier.\n\nSet $x=15^{\\circ}$.\n\n$$\n\\begin{aligned}2\\sin x\\cos x &=\\sin(2x) \\\\ &=\\sin\\left(30^{\\circ}\\right) \\\\ &=\\frac{1}{2}\\end{aligned}\n$$\n\nSubstitute this exact value:\n\n$$\n\\begin{aligned}\\sin\\left(15^{\\circ}\\right)\\cos\\left(15^{\\circ}\\right)&=\\frac{1}{2}\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dbfacef-17ca-55ef-8083-2595c018bdc3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186696502} {:answer/id #uuid "49d17a18-5730-5104-a77c-3ebe5b747a1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186696503} {:answer/id #uuid "560d2ed7-0d9b-5ebb-93ae-ba33b4d7a096" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186696504} {:answer/id #uuid "81e8a37f-3774-5b04-83a5-d7dfe7a851e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186696506} {:answer/id #uuid "e4effd09-39c4-536c-b53e-a085c3ec8c85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186696507}] :answer-field/correct {:answer/id #uuid "e4effd09-39c4-536c-b53e-a085c3ec8c85" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186696507} :answer-field/id #uuid "64654332-07cb-5049-bd0f-b0237f1cf590" :answer-field/key "value" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186696505}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2ce9d5f1-b15d-5732-b2ad-9ab6e07a2cb5" :question/problem "Without using a calculator, find the exact value of\n\n$$\n\\frac{\\cos\\left(15^{\\circ}\\right)}{\\csc\\left(15^{\\circ}\\right)}\n$$" :question/worked-solution "Rewrite the reciprocal denominator to expose a sine–cosine product.\n\nSet $x=15^{\\circ}$.\n\n$$\n\\frac{\\cos\\left(x\\right)}{\\csc\\left(x\\right)}=\\cos\\left(x\\right)\\cdot\\frac{1}{\\csc\\left(x\\right)}=\\sin x\\cos x\n$$\n\n$$\n\\begin{aligned}2\\sin x\\cos x &=\\sin(2x) \\\\ &=\\sin\\left(30^{\\circ}\\right) \\\\ &=\\frac{1}{2}\\end{aligned}\n$$\n\nSubstitute this exact value:\n\n$$\n\\begin{aligned}\\frac{\\cos\\left(15^{\\circ}\\right)}{\\csc\\left(15^{\\circ}\\right)}&=\\frac{1}{2}\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696509 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "352ee0d0-923e-5ae3-bacc-b5e35376601b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2} + 1" :db/id #edb/ref 17592186696508}] :answer-field/correct {:answer/id #uuid "352ee0d0-923e-5ae3-bacc-b5e35376601b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2} + 1" :db/id #edb/ref 17592186696508} :answer-field/id #uuid "6dac9d88-18b5-5c26-9c6b-dcfba79d5c6f" :answer-field/key "value" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186696510}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "54ffcac0-8589-5d10-8fa3-847311b3ffae" :question/problem "Without using a calculator, find the exact value of\n\n$$\n\\left(\\sin\\left(\\frac{225}{2}^{\\circ}\\right)-\\cos\\left(\\frac{225}{2}^{\\circ}\\right)\\right)^2\n$$\n\n$$\n\\left(\\sin\\left(\\frac{225}{2}^{\\circ}\\right)-\\cos\\left(\\frac{225}{2}^{\\circ}\\right)\\right)^2=\n$$\n{{value}}" :question/worked-solution "Expand the square and use the Pythagorean identity.\n\nSet $x=\\frac{225}{2}^{\\circ}$.\n\n$$\n\\begin{aligned}(\\sin x-\\cos x)^2 &= \\sin^2 x-2\\sin x\\cos x+\\cos^2 x \\\\ &=1-2\\sin x\\cos x \\\\ &=1-\\sin(2x)\\end{aligned}\n$$\n\n$$\n\\begin{aligned}2\\sin x\\cos x &=\\sin(2x) \\\\ &=\\sin\\left(225^{\\circ}\\right) \\\\ &=- \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSubstitute this exact value:\n\n$$\n\\begin{aligned}\\left(\\sin\\left(\\frac{225}{2}^{\\circ}\\right)-\\cos\\left(\\frac{225}{2}^{\\circ}\\right)\\right)^2&=1-\\left(- \\frac{\\sqrt{2}}{2}\\right) \\\\ &=\\frac{\\sqrt{2}}{2} + 1\\end{aligned}\n$$"}] :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}]}
