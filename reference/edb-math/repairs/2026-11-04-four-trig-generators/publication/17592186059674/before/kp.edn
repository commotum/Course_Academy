alue "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186251347} {:answer/id #uuid "b2646330-ca77-5a0d-b193-c06bcdc7a115" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186252111} {:answer/id #uuid "d26cc6ac-3efb-5846-8c19-760d22ea431d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186252414}] :answer-field/correct {:answer/id #uuid "61086b08-503f-5afe-8d5f-93b7e8662a41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186251347} :answer-field/id #uuid "7f04de3e-9c49-5ec2-bb16-a4b47af64121" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253023}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ad1365bd-d309-5764-8412-78c271945c47" :question/math-academy-id "q-120058" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)}.\n$$" :question/worked-solution "First, we note that:\n\n$$\n\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)}=\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\cdot \\frac{1}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)}=\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) & =\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{8}\\right) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\frac{\\sqrt{2}}{4}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{\\pi }{8}\\right)}=\\frac{\\sqrt{2}}{4}.\n$$"} {:db/id #edb/ref 17592186290576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6931cbd8-8aec-59e8-9beb-4aedea7d2b08" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186288773} {:answer/id #uuid "75d06901-1591-5a02-bd70-d0b5359fdc2e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288848} {:answer/id #uuid "aaed2909-cde1-5ba1-9b2f-148de0944131" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186289163} {:answer/id #uuid "c5938940-d658-5ae5-b42e-bafb832ed043" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186289342} {:answer/id #uuid "ef4e0599-c81e-5b40-9345-cbe04ca22479" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186289607}] :answer-field/correct {:answer/id #uuid "c5938940-d658-5ae5-b42e-bafb832ed043" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186289342} :answer-field/id #uuid "a9d1237f-fc45-51a4-903c-c80006523323" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290108}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c8b170de-4305-57f7-8f86-f2f06478c4e5" :question/math-academy-id "q-24781" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}.\n$$" :question/worked-solution "First, we note that:\n\n$$\n\\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}=\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\cdot \\frac{1}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}=\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) & =\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{8}\\right) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=\\frac{\\sqrt{2}}{4}.\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)}{\\operatorname{csc}⁡\\left(\\frac{\\pi }{8}\\right)}=\\frac{\\sqrt{2}}{4}.\n$$"} {:db/id #edb/ref 17592186292685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078b25eb-c753-58c4-a8bb-c23711fdad11" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186290671} {:answer/id #uuid "7908b470-d7ec-55b9-b4ab-b86372edd49a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291145} {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} {:answer/id #uuid "9fdbc26c-f0b1-58b7-b55e-4663ee54eccb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186291327} {:answer/id #uuid "fcc2c5b1-4056-55a7-8817-839d1d89caec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{3}}{2}" :db/id #edb/ref 17592186291707}] :answer-field/correct {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} :answer-field/id #uuid "d670500b-2a4c-531d-a949-3190b98d3ea6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292387}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "83f3d502-62d9-5e1b-a7be-52d9144a4c16" :question/math-academy-id "q-26907" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}.$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2} & ={\\sin }^{2}⁡({105}^{∘})+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})+{\\cos }^{2}⁡({105}^{∘}) \\\\  & =[{\\sin }^{2}⁡({105}^{∘})+{\\cos }^{2}⁡({105}^{∘})]+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) \\\\  & =1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={105}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {105}^{∘}) \\\\  & =\\operatorname{sin}⁡({210}^{∘}) \\\\  & =\\operatorname{sin}⁡({180}^{∘}+{30}^{∘}) \\\\  & =-\\operatorname{sin}⁡({30}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}=\\frac{1}{2}.\n$$"} {:db/id #edb/ref 17592186302330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9bdc1b2-8ea1-5127-89c0-6b997d1343aa" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186300968}] :answer-field/correct {:answer/id #uuid "c9bdc1b2-8ea1-5127-89c0-6b997d1343aa" :answer/type {:db/ident :answer.type/math} :answer/value "1+\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186300968} :answer-field/id #uuid "99c7c1d5-e064-5947-ad92-edb4b63aee4f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301718}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5fc8ff6e-fc33-5efd-ab02-f17a877d633b" :question/math-academy-id "q-327247" :question/problem "Find the exact value of $$\n\\displaystyle {\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\right)}^{2}.\n$$\n\n$$\n\\displaystyle {\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\right)}^{2}=\n$$\n{{field-1}}" :question/worked-solution "First, we expand the parentheses and use the Pythagorean identity.\n\n$$\n\\begin{aligned}\\,\\,\\,\\,\\,\\,\\,\\,{\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\right)}^{2} & ={\\sin }^{2}⁡\\left(\\frac{\\pi }{8}\\right)+2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)+{\\cos }^{2}⁡\\left(\\frac{\\pi }{8}\\right) \\\\  & =\\left[{\\sin }^{2}⁡\\left(\\frac{\\pi }{8}\\right)+{\\cos }^{2}⁡\\left(\\frac{\\pi }{8}\\right)\\right]+2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) \\\\  & =1+2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\end{aligned}\n$$\n\nLet's recall the double-angle formula for sine:\n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡(2x)\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right) & =\\operatorname{sin}⁡\\left(2\\cdot \\frac{\\pi }{8}\\right) \\\\  & =\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right) \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)=1+\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{\\left(\\operatorname{sin}⁡\\left(\\frac{\\pi }{8}\\right)+\\operatorname{cos}⁡\\left(\\frac{\\pi }{8}\\right)\\right)}^{2}=1+\\frac{\\sqrt{2}}{2}.\n$$"} {:db/id #edb/ref 17592186302332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d53bf1bf-3240-597c-8ba6-91c426822271" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186301022}] :answer-field/correct {:answer/id #uuid "d53bf1bf-3240-597c-8ba6-91c426822271" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186301022} :answer-field/id #uuid "2d2fa77f-5bcb-5df5-8444-35c66cd13a26" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301370}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c456891a-3eac-5005-ae95-48c26bfb98c5" :question/math-academy-id "q-327277" :question/problem "Find the exact value of $$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{3\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{3\\pi }{8}\\right)}.\n$$\n\n$$\n\\displaystyle \\frac{\\operatorname{sin}⁡\\left(\\frac{3\\pi }{8}\\right)}{\\operatorname{sec}⁡\\left(\\frac{3\\pi }{8}\\right)}=\n$$\n{{field-1}}" :question/worked-solution "First, we note that:\n\n$$\n\\frac{\\operatorname{sin}⁡\\left(\\frac{3\\pi }{8}\\righ