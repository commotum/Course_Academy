39-496a-50fd-a5c8-8899cfb4461f" :answer-field/correct "441dc97e-97cf-5c1a-b9dd-32ecb87344fa"] [:db/ensure "b64cfb39-496a-50fd-a5c8-8899cfb4461f" :answer-field/validate] [:db/add "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6" :question/id #uuid "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6"] [:db/add "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6" :question/problem "Express $\\sin\\left(x-\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ and $\\cos x$."] [:db/add "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6" :question/worked-solution "Use the difference formula for sine:\n\n$$\n\\sin(u-v)=\\sin u\\cos v-\\cos u\\sin v.\n$$\n\nThe fixed angle has exact values\n\n$$\n\\cos\\left(\\frac{\\pi}{2}\\right)=0,\\qquad \\sin\\left(\\frac{\\pi}{2}\\right)=1.\n$$\n\nSubstitute $u=x$ and $v=\\frac{\\pi}{2}$, then simplify the coefficients:\n\n$$\n\\begin{aligned}\n\\sin\\left(x-\\frac{\\pi}{2}\\right)&=\\sin x\\cos\\left(\\frac{\\pi}{2}\\right)-\\cos x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\sin x\\left(0\\right)-\\cos x\\left(1\\right)\\\\\n&=-\\cos x.\n\\end{aligned}\n$$"] [:db/add "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6" :question/difficulty :question.difficulty/moderate] [:db/add "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6" :question/answer-fields "b64cfb39-496a-50fd-a5c8-8899cfb4461f"] [:db/ensure "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6" :question/validate] [:db/add 17592186059820 :knowledge-point/questions "fd75540b-f2ec-5c0b-a8d6-2537cdc232d6"] [:db/add "fd57787a-8905-544f-a396-8bb3ff7b12c5" :answer/id #uuid "fd57787a-8905-544f-a396-8bb3ff7b12c5"] [:db/add "fd57787a-8905-544f-a396-8bb3ff7b12c5" :answer/type :answer.type/math] [:db/add "fd57787a-8905-544f-a396-8bb3ff7b12c5" :answer/value "0"] [:db/ensure "fd57787a-8905-544f-a396-8bb3ff7b12c5" :answer/validate] [:db/add "c231e2e3-a26b-5f46-b33e-76623bd7db6b" :answer-field/id #uuid "c231e2e3-a26b-5f46-b33e-76623bd7db6b"] [:db/add "c231e2e3-a26b-5f46-b33e-76623bd7db6b" :answer-field/key "field-1"] [:db/add "c231e2e3-a26b-5f46-b33e-76623bd7db6b" :answer-field/type :a