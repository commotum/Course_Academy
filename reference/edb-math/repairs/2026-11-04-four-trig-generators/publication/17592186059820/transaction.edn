ld/choices "07af28b8-320a-54c1-8fed-071e13f99079"] [:db/add "91989131-1066-56ab-b6d7-68c5d88999b6" :answer-field/choices "41c09ca2-e709-5011-9696-30abad5f16ca"] [:db/add "91989131-1066-56ab-b6d7-68c5d88999b6" :answer-field/choices "70ae836b-9f80-53ea-be74-b1185c97e967"] [:db/add "91989131-1066-56ab-b6d7-68c5d88999b6" :answer-field/correct "70ae836b-9f80-53ea-be74-b1185c97e967"] [:db/ensure "91989131-1066-56ab-b6d7-68c5d88999b6" :answer-field/validate] [:db/add "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec" :question/id #uuid "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec"] [:db/add "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec" :question/problem "Express $\\sin\\left(x-\\pi\\right)$ in terms of $\\sin x$ and $\\cos x$."] [:db/add "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec" :question/worked-solution "Use the difference formula for sine:\n\n$$\n\\sin(u-v)=\\sin u\\cos v-\\cos u\\sin v.\n$$\n\nThe fixed angle has exact values\n\n$$\n\\cos\\left(\\pi\\right)=-1,\\qquad \\sin\\left(\\pi\\right)=0.\n$$\n\nSubstitute $u=x$ and $v=\\pi$, then simplify the coefficients:\n\n$$\n\\begin{aligned}\n\\sin\\left(x-\\pi\\right)&=\\sin x\\cos\\left(\\pi\\right)-\\cos x\\sin\\left(\\pi\\right)\\\\\n&=\\sin x\\left(-1\\right)-\\cos x\\left(0\\right)\\\\\n&=-\\sin x.\n\\end{aligned}\n$$"] [:db/add "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec" :question/difficulty :question.difficulty/easy] [:db/add "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec" :question/answer-fields "91989131-1066-56ab-b6d7-68c5d88999b6"] [:db/ensure "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec" :question/validate] [:db/add 17592186059820 :knowledge-point/questions "9b7230db-f6d9-5e47-b23b-a61ddcbfd2ec"] [:db/add "189dd98b-4b35-5fdf-9707-9e6863dc2b49" :answer/id #uuid "189dd98b-4b35-5fdf-9707-9e6863dc2b49"] [:db/add "189dd98b-4b35-5fdf-9707-9e6863dc2b49" :answer/type :answer.type/math] [:db/add "189dd98b-4b35-5fdf-9707-9e6863dc2b49" :answer/value "1"] [:db/ensure "189dd98b-4b35-5fdf-9707-9e6863dc2b49" :answer/validate] [:db/add "78bdb1ec-e21d-5d82-8260-a7bf9b2c046e" :