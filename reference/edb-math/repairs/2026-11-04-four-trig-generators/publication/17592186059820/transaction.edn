\frac{\\sqrt{2}}{2}\\right)\\\\\n&=\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x.\n\\end{aligned}\n$$"] [:db/add "b2dae34d-a6be-54a3-a3c7-e2cb32316bf2" :question/difficulty :question.difficulty/hard] [:db/add "b2dae34d-a6be-54a3-a3c7-e2cb32316bf2" :question/answer-fields "0d126dd9-c0dd-5ba5-916c-13be68423395"] [:db/ensure "b2dae34d-a6be-54a3-a3c7-e2cb32316bf2" :question/validate] [:db/add 17592186059820 :knowledge-point/questions "b2dae34d-a6be-54a3-a3c7-e2cb32316bf2"] [:db/add "generator" :question-generator/id #uuid "6d6d268d-df6b-5105-b34c-185092df3845"] [:db/add "generator" :question-generator/script "generators/10/10380ac046af1343e3aac7053164992ee66cbaabbbafd98446038dc2dad89f28/generator.py"] [:db/add 17592186059820 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059820 :knowledge-point/validate] [:db/cas 17592186701780 :question/retired nil true] [:db/cas 17592186701791 :question/retired nil true] [:db/cas 17592186701792 :question/retired nil true] [:db/cas 17592186701956 :question/retired nil true] [:db/cas 17592186701957 :question/retired nil true] [:db/cas 17592186701965 :question/retired nil true] [:db/cas 17592186701967 :question/retired nil true] [:db/cas 17592186705162 :question/retired nil true] [:db/cas 17592186705171 :question/retired nil true] [:db/cas 17592186705180 :question/retired nil true] [:db/cas 17592186705187 :question/retired nil true] [:db/cas 17592186705219 :question/retired nil true] [:db/cas 17592186705221 :question/retired nil true] [:db/cas 17592186705223 :question/retired nil true] [:db/cas 17592186705238 :question/retired nil true]]
