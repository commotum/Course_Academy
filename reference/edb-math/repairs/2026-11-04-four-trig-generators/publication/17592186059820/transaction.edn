60-460d-50ca-8d9a-025e42033f6c" :answer-field/choices "34bb19af-d5f0-5ac3-b93a-3ad4e9c709b7"] [:db/add "af715560-460d-50ca-8d9a-025e42033f6c" :answer-field/correct "bde5f847-157a-587e-b65b-f5e1f497daf3"] [:db/ensure "af715560-460d-50ca-8d9a-025e42033f6c" :answer-field/validate] [:db/add "067fa6ca-8a7f-505c-9ec1-85ac3033b5be" :question/id #uuid "067fa6ca-8a7f-505c-9ec1-85ac3033b5be"] [:db/add "067fa6ca-8a7f-505c-9ec1-85ac3033b5be" :question/problem "Express $\\sin\\left(x+\\frac{\\pi}{2}\\right)$ in terms of $\\sin x$ and $\\cos x$."] [:db/add "067fa6ca-8a7f-505c-9ec1-85ac3033b5be" :question/worked-solution "Use the sum formula for sine:\n\n$$\n\\sin(u+v)=\\sin u\\cos v+\\cos u\\sin v.\n$$\n\nThe fixed angle has exact values\n\n$$\n\\cos\\left(\\frac{\\pi}{2}\\right)=0,\\qquad \\sin\\left(\\frac{\\pi}{2}\\right)=1.\n$$\n\nSubstitute $u=x$ and $v=\\frac{\\pi}{2}$, then simplify the coefficients:\n\n$$\n\\begin{aligned}\n\\sin\\left(x+\\frac{\\pi}{2}\\right)&=\\sin x\\cos\\left(\\frac{\\pi}{2}\\right)+\\cos x\\sin\\left(\\frac{\\pi}{2}\\right)\\\\\n&=\\sin x\\left(0\\right)+\\cos x\\left(1\\right)\\\\\n&=\\cos x.\n\\end{aligned}\n$$"] [:db/add "067fa6ca-8a7f-505c-9ec1-85ac3033b5be" :question/difficulty :question.difficulty/easy] [:db/add "067fa6ca-8a7f-505c-9ec1-85ac3033b5be" :question/answer-fields "af715560-460d-50ca-8d9a-025e42033f6c"] [:db/ensure "067fa6ca-8a7f-505c-9ec1-85ac3033b5be" :question/validate] [:db/add 17592186059820 :knowledge-point/questions "067fa6ca-8a7f-505c-9ec1-85ac3033b5be"] [:db/add "a2b2da88-399b-571b-bf6c-f1915d433583" :answer/id #uuid "a2b2da88-399b-571b-bf6c-f1915d433583"] [:db/add "a2b2da88-399b-571b-bf6c-f1915d433583" :answer/type :answer.type/math] [:db/add "a2b2da88-399b-571b-bf6c-f1915d433583" :answer/value "\\cos x"] [:db/ensure "a2b2da88-399b-571b-bf6c-f1915d433583" :answer/validate] [:db/add "441dc97e-97cf-5c1a-b9dd-32ecb87344fa" :answer/id #uuid "441dc97e-97cf-5c1a-b9dd-32ecb87344fa"] [:db/add "441dc97e-97cf-5c1a-b9dd-32ecb87344fa" 