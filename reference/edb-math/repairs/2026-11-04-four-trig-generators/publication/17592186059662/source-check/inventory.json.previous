              ":db/ident": ":answer.type/math"
            },
            ":answer/value": "\\sqrt{2}",
            ":db/id": 17592186705308
          },
          ":answer-field/id": "c81d787f-06e8-5877-9bec-a6990d883bf8",
          ":answer-field/key": "field-2",
