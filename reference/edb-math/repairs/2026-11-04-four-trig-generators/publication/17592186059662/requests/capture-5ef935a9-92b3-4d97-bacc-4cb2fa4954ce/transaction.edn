circ)=$ {{field-1}} $\\sin x+$ {{field-2}} $\\cos x$"] [:db/add "2b540cf2-3bd8-5214-9403-8c2db6465420" :question/worked-solution "Use the sum formula for sine:\n$$\n\\sin(u+v)=\\sin u\\cos v+\\cos u\\sin v.\n$$\nApply it and substitute the exact special-angle values:\n$$\n\\begin{aligned}\n\\sin(x+210^\\circ)&=\\sin x\\cos 210^\\circ+\\cos x\\sin 210^\\circ\\\\\n&=\\sin x\\cdot\\left(-\\frac{\\sqrt{3}}{2}\\right)+\\cos x\\cdot\\left(-\\frac{1}{2}\\right)\\\\\n&=-\\frac{\\sqrt{3}}{2}\\sin x-\\frac{1}{2}\\cos x\n\\end{aligned}\n$$\nThe plus sign outside the second blank is supplied. The entries are $-\\frac{\\sqrt{3}}{2}$ and $-\\frac{1}{2}$, respectively."] [:db/add "2b540cf2-3bd8-5214-9403-8c2db6465420" :question/difficulty :question.difficulty/hard] [:db/add "2b540cf2-3bd8-5214-9403-8c2db6465420" :question/answer-fields "5a5ba855-9ae4-5ff2-aacb-9b256c0ded01"] [:db/add "2b540cf2-3bd8-5214-9403-8c2db6465420" :question/answer-fields "b742f4f7-1da0-5d96-b7ef-9979e936efb2"] [:db/ensure "2b540cf2-3bd8-5214-9403-8c2db6465420" :question/validate] [:db/add 17592186059662 :knowledge-point/questions "2b540cf2-3bd8-5214-9403-8c2db6465420"] [:db/add "9a98ed1c-1d88-57c2-b8f0-647732753a89" :answer/id #uuid "9a98ed1c-1d88-57c2-b8f0-647732753a89"] [:db/add "9a98ed1c-1d88-57c2-b8f0-647732753a89" :answer/type :answer.type/math] [:db/add "9a98ed1c-1d88-57c2-b8f0-647732753a89" :answer/value "-\\frac{1}{2}"] [:db/ensure "9a98ed1c-1d88-57c2-b8f0-647732753a89" :answer/validate] [:db/add "7719f3dc-284b-57d9-9a81-866c44808c16" :answer-field/id #uuid "7719f3dc-284b-57d9-9a81-866c44808c16"] [:db/add "7719f3dc-284b-57d9-9a81-866c44808c16" :answer-field/key "field-1"] [:db/add "7719f3dc-284b-57d9-9a81-866c44808c16" :answer-field/type :answer-field.type/blank] [:db/add "7719f3dc-284b-57d9-9a81-866c44808c16" :answer-field/choices "9a98ed1c-1d88-57c2-b8f0-647732753a89"] [:db/add "7719f3dc-284b-57d9-9a81-866c44808c16" :answer-field/correct "9a98ed1c-1d88-57c2-b8f0-647732753a89"] [:db/ensure "7719f3