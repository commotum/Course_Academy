[[:db/add "3689d497-ba37-54cc-bab9-e966c6a22bf6" :answer/id #uuid "3689d497-ba37-54cc-bab9-e966c6a22bf6"] [:db/add "3689d497-ba37-54cc-bab9-e966c6a22bf6" :answer/type :answer.type/math] [:db/add "3689d497-ba37-54cc-bab9-e966c6a22bf6" :answer/value "-\\cos x"] [:db/ensure "3689d497-ba37-54cc-bab9-e966c6a22bf6" :answer/validate] [:db/add "4462feb6-0f26-5ed4-a71d-04a8ba82d285" :answer-field/id #uuid "4462feb6-0f26-5ed4-a71d-04a8ba82d285"] [:db/add "4462feb6-0f26-5ed4-a71d-04a8ba82d285" :answer-field/key "field-1"] [:db/add "4462feb6-0f26-5ed4-a71d-04a8ba82d285" :answer-field/type :answer-field.type/blank] [:db/add "4462feb6-0f26-5ed4-a71d-04a8ba82d285" :answer-field/choices "3689d497-ba37-54cc-bab9-e966c6a22bf6"] [:db/add "4462feb6-0f26-5ed4-a71d-04a8ba82d285" :answer-field/correct "3689d497-ba37-54cc-bab9-e966c6a22bf6"] [:db/ensure "4462feb6-0f26-5ed4-a71d-04a8ba82d285" :answer-field/validate] [:db/add "d367e9eb-6031-5114-a868-db56a424a5c7" :question/id #uuid "d367e9eb-6031-5114-a868-db56a424a5c7"] [:db/add "d367e9eb-6031-5114-a868-db56a424a5c7" :question/problem "Express $\\sin(x-90^\\circ)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\sin(x-90^\\circ)=$ {{field-1}}"] [:db/add "d367e9eb-6031-5114-a868-db56a424a5c7" :question/worked-solution "Use the difference formula for sine:\n$$\n\\sin(u-v)=\\sin u\\cos v-\\cos u\\sin v.\n$$\nApply it and substitute the exact special-angle values:\n$$\n\\begin{aligned}\n\\sin(x-90^\\circ)&=\\sin x\\cos 90^\\circ-\\cos x\\sin 90^\\circ\\\\\n&=\\sin x\\cdot\\left(0\\right)-\\cos x\\cdot\\left(1\\right)\\\\\n&=-\\cos x\n\\end{aligned}\n$$"] [:db/add "d367e9eb-6031-5114-a868-db56a424a5c7" :question/difficulty :question.difficulty/easy] [:db/add "d367e9eb-6031-5114-a868-db56a424a5c7" :question/answer-fields "4462feb6-0f26-5ed4-a71d-04a8ba82d285"] [:db/ensure "d367e9eb-6031-5114-a868-db56a424a5c7" :question/validate] [:db/add 17592186059662 :knowledge-point/questions "d367e9eb-6031-5114-a868-db56a424a5c7"] [:db/add "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a" :answer/id #uuid "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a"] [:db/add "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a" :answer/type :answer.type/math] [:db/add "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a" :answer/value "\\cos x"] [:db/ensure "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a" :answer/validate] [:db/add "29314bd3-24fd-591d-bdc5-57488d95ab3d" :answer-field/id #uuid "29314bd3-24fd-591d-bdc5-57488d95ab3d"] [:db/add "29314bd3-24fd-591d-bdc5-57488d95ab3d" :answer-field/key "field-1"] [:db/add "29314bd3-24fd-591d-bdc5-57488d95ab3d" :answer-field/type :answer-field.type/blank] [:db/add "29314bd3-24fd-591d-bdc5-57488d95ab3d" :answer-field/choices "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a"] [:db/add "29314bd3-24fd-591d-bdc5-57488d95ab3d" :answer-field/correct "4b8dd913-79bf-5ec4-8ead-9216e3ac6f9a"] [:db/ensure "29314bd3-24fd-591d-bdc5-57488d95ab3d" :answer-field/validate] [:db/add "58d2ca95-a389-5a95-a946-903c61609ae8" :question/id #uuid "58d2ca95-a389-5a95-a946-903c61609ae8"] [:db/add "58d2ca95-a389-5a95-a946-903c61609ae8" :question/problem "Express $\\sin(x+90^\\circ)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\sin(x+90^\\circ)=$ {{field-1}}"] [:db/add "58d2ca95-a389-5a95-a946-903c61609ae8" :question/worked-solution "Use the sum formula for sine:\n$$\n\\sin(u+v)=\\sin u\\cos v+\\cos u\\sin v.\n$$\nApply it and substitute the exact special-angle values:\n$$\n\\begin{aligned}\n\\sin(x+90^\\circ)&=\\sin x\\cos 90^\\circ+\\cos x\\sin 90^\\circ\\\\\n&=\\sin x\\cdot\\left(0\\right)+\\cos x\\cdot\\left(1\\right)\\\\\n&=\\cos x\n\\end{aligned}\n$$"] [:db/add "58d2ca95-a389-5a95-a946-903c61609ae8" :question/difficulty :question.difficulty/easy] [:db/add "58d2ca95-a389-5a95-a946-903c61609ae8" :question/answer-fields "29314bd3-24fd-591d-bdc5-57488d95ab3d"] [:db/ensure "58d2ca95-a389-5a95-a946-903c61609ae8" :question/validate] [:db/add 17592186059662 :knowledge-point/questions "58d2ca95-a389-5a95-a946-903c61609ae8"] [:db/add "f29b2194-642c-5094-8645-44398a5f2112" :answer/id #uuid "f29b2194-6