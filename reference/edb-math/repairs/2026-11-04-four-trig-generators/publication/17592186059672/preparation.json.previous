\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(30^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(30^\\\\circ\\\\right)=\\\\frac{1}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(\\\\frac{1}{2}\\\\right)\\\\\\\\&=1.\\n\\\\end{aligned}\\n$$\"] [:db/add \"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/difficulty :question.difficulty/easy] [:db/add \"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/answer-fields \"c4609a50-7f80-5b60-9842-6d7ce5941dd9\"] [:db/ensure \"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"0b13d522-9f37-55f4-abb4-03939cf0584e\"] [:db/add \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/id #uuid \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\"] [:db/add \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/type :answer.type/math] [:db/add \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [:db/ensure \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/validate] [:db/add \"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/id #uuid \"f6c4265d-062e-5418-b4ad-08c35968de5d\"] [:db/add \"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/type :answer.type/math] [:db/add \"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/value \"\\\\sqrt{2}\"] [:db/ensure \"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/validate] [:db/add \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/id #uuid \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\"] [:db/add \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/type :answer.type/math] [:db/add \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [:db/ensure \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/validate] [:db/add \"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/id #uuid \"5d0324ad-c372-5805-9c02-d168ddfcc982\"] [:db/add \"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/type :answer.type/math] [:db/add \"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\"] [:db/ensure \"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/validate] [:db/add \"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/id #uuid \"66068ac3-b985-5cbb-b1f7-f32543d25407\"] [:db/add \"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/type :answer.type/math] [:db/add \"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/value \"1\"] [:db/ensure \"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/validate] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/id #uuid \"67d34673-0071-50d8-a159-6749f0e4b6be\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/key \"selection\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/type :answer-field.type/radio] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"f6c4265d-062e-5418-b4ad-08c35968de5d\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"5d0324ad-c372-5805-9c02-d168ddfcc982\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"66068ac3-b985-5cbb-b1f7-f32543d25407\"] [:db/add \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/correct \"f6c4265d-062e-5418-b4ad-08c35968de5d\"] [:db/ensure \"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/validate] [:db/add \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/id #uuid \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\"] [:db/add \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right).\\n$$\"] [:db/add \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{\\\\pi}{16}$ and then at $x=\\\\frac{\\\\pi}{8}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)=\\\\frac{\\\\sqrt{2}}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\\\\\&=\\\\sqrt{2}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/difficulty :question.difficulty/easy] [:db/add \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/answer-fields \"67d34673-0071-50d8-a159-6749f0e4b6be\"] [:db/ensure \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\"] [:db/add \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/id #uuid \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\"] [:db/add \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/type :answer.type/math] [:db/add \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/value \"1\"] [:db/ensure \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/validate] [:db/add \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/id #uuid \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\"] [:db/add \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/type :answer.type/math] [:db/add \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/value \"\\\\sqrt{3}\"] [:db/ensure \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/validate] [:db/add \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/id #uuid \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\"] [:db/add \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/type :answer.type/math] [:db/add \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/value \"2\"] [:db/ensure \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/validate] [:db/add \"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/id #uuid \"5a412728-5a20-53cf-a363-2e228976f66d\"] [:db/add \"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/type :answer.type/math] [:db/add \"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/value \"\\\\frac{1}{2}\"] [:db/ensure \"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/validate] [:db/add \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/id #uuid \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\"] [:db/add \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/type :answer.type/math] [:db/add \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/value \"2 \\\\sqrt{2}\"] [:db/ensure \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/validate] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/id #uuid \"0574cf5b-7c20-59f3-8e24-87d729740cc4\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/key \"selection\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/type :answer-field.type/radio] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"5a412728-5a20-53cf-a363-2e228976f66d\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\"] [:db/add \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/correct \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\"] [:db/ensure \"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/validate] [:db/add \"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/id #uuid \"5205ab04-98cb-5c68-9725-f0902169acf7\"] [:db/add \"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right).\\n$$\"] [:db/add \"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{\\\\pi}{8}$ and then at $x=\\\\frac{\\\\pi}{4}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)=1$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(1\\\\right)\\\\\\\\&=2.\\n\\\\end{aligned}\\n$$\"] [:db/add \"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/difficulty :question.difficulty/easy] [:db/add \"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/answer-fields \"0574cf5b-7c20-59f3-8e24-87d729740cc4\"] [:db/ensure \"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"5205ab04-98cb-5c68-9725-f0902169acf7\"] [:db/add \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/id #uuid \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\"] [:db/add \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/type :answer.type/math] [:db/add \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/value \"4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\"] [:db/ensure \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/validate] [:db/add \"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/id #uuid \"808a721e-17f7-50a5-baa0-e6091a5efe66\"] [:db/add \"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/type :answer.type/math] [:db/add \"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/value \"16\"] [:db/ensure \"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/validate] [:db/add \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/id #uuid \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\"] [:db/add \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/type :answer.type/math] [:db/add \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/value \"2\\\\,\\\\csc\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\"] [:db/ensure \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/validate] [:db/add \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/id #uuid \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\"] [:db/add \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/type :answer.type/math] [:db/add \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/value \"4\\\\,\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\"] [:db/ensure \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/validate] [:db/add \"57799975-740f-5377-81c5-41efae97d248\" :answer/id #uuid \"57799975-740f-5377-81c5-41efae97d248\"] [:db/add \"57799975-740f-5377-81c5-41efae97d248\" :answer/type :answer.type/math] [:db/add \"57799975-740f-5377-81c5-41efae97d248\" :answer/value \"4\"] [:db/ensure \"57799975-740f-5377-81c5-41efae97d248\" :answer/validate] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/id #uuid \"457d341a-469a-56aa-af29-cc618375fb46\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/key \"selection\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/type :answer-field.type/radio] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"808a721e-17f7-50a5-baa0-e6091a5efe66\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"57799975-740f-5377-81c5-41efae97d248\"] [:db/add \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/correct \"57799975-740f-5377-81c5-41efae97d248\"] [:db/ensure \"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/validate] [:db/add \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/id #uuid \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\"] [:db/add \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\\\\csc\\\\left(\\\\frac{\\\\pi}{5}\\\\right).\\n$$\"] [:db/add \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ at $x=\\\\frac{\\\\pi}{10}$, then $\\\\csc x=1/\\\\sin x$. The nonzero sine cancels.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\\\\csc\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\\\\\\\\&=4\\\\,\\\\frac{\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)}{\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)}\\\\\\\\&=4\\n\\\\end{aligned}\\n$$\"] [:db/add \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/difficulty :question.difficulty/moderate] [:db/add \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/answer-fields \"457d341a-469a-56aa-af29-cc618375fb46\"] [:db/ensure \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\"] [:db/add \"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/id #uuid \"af461d4d-89b3-5ed9-a949-9bb02437da96\"] [:db/add \"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/type :answer.type/math] [:db/add \"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/value \"\\\\frac{\\\\sqrt{2}}{32}\"] [:db/ensure \"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/validate] [:db/add \"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/id #uuid \"e3d72e34-9aec-537b-956e-24db719ce04f\"] [:db/add \"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/type :answer.type/math] [:db/add \"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/value \"\\\\frac{\\\\sqrt{3}}{16}\"] [:db/ensure \"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/validate] [:db/add \"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/id #uuid \"52a20e14-b7e7-5aa7-974c-e3c669e04176\"] [:db/add \"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/type :answer.type/math] [:db/add \"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/value \"\\\\frac{\\\\sqrt{2}}{16}\"] [:db/ensure \"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/validate] [:db/add \"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/id #uuid \"d8473857-1946-5ff8-827b-e088c6cf9a4e\"] [:db/add \"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/type :answer.type/math] [:db/add \"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/value \"\\\\frac{1}{16}\"] [:db/ensure \"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/validate] [:db/add \"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/id #uuid \"f120e81a-721b-5033-83c3-ce741840b16e\"] [:db/add \"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/type :answer.type/math] [:db/add \"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/value \"\\\\frac{\\\\sqrt{2}}{8}\"] [:db/ensure \"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/validate] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/id #uuid \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/key \"selection\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/type :answer-field.type/radio] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"af461d4d-89b3-5ed9-a949-9bb02437da96\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"e3d72e34-9aec-537b-956e-24db719ce04f\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"52a20e14-b7e7-5aa7-974c-e3c669e04176\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"d8473857-1946-5ff8-827b-e088c6cf9a4e\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"f120e81a-721b-5033-83c3-ce741840b16e\"] [:db/add \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/correct \"f120e81a-721b-5033-83c3-ce741840b16e\"] [:db/ensure \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/validate] [:db/add \"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/id #uuid \"c5362cd4-e28f-5871-8896-bc4de86ede35\"] [:db/add \"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n\\\\sin\\\\left(\\\\frac{3 \\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{3 \\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{3 \\\\pi}{8}\\\\right).\\n$$\"] [:db/add \"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{3 \\\\pi}{16}$ and then at $x=\\\\frac{3 \\\\pi}{8}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{3 \\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{3 \\\\pi}{8}\\\\right)\\\\\\\\&=\\\\frac{1}{4}\\\\,\\\\sin\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right)=\\\\frac{\\\\sqrt{2}}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{1}{4}\\\\,\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\\\\\&=\\\\frac{\\\\sqrt{2}}{8}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/difficulty :question.difficulty/moderate] [:db/add \"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/answer-fields \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\"] [:db/ensure \"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"c5362cd4-e28f-5871-8896-bc4de86ede35\"] [:db/add \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/id #uuid \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\"] [:db/add \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/type :answer.type/math] [:db/add \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/value \"\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right)\"] [:db/ensure \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/validate] [:db/add \"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/id #uuid \"092fc2de-230d-5de6-a34c-4624b0a29b88\"] [:db/add \"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/type :answer.type/math] [:db/add \"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/value \"\\\\frac{1}{4}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{4}\\\\right)\"] [:db/ensure \"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/validate] [:db/add \"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/id #uuid \"8d73c491-046f-5cd3-b706-8f3b35452af7\"] [:db/add \"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/type :answer.type/math] [:db/add \"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/value \"\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\"] [:db/ensure \"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/validate] [:db/add \"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/id #uuid \"6b2e7d2e-2039-542b-8d0a-11408915e466\"] [:db/add \"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/type :answer.type/math] [:db/add \"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/value \"\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\"] [:db/ensure \"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/validate] [:db/add \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/id #uuid \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\"] [:db/add \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/type :answer.type/math] [:db/add \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/value \"\\\\frac{1}{4}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\"] [:db/ensure \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/validate] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/id #uuid \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/key \"selection\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/type :answer-field.type/radio] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"092fc2de-230d-5de6-a34c-4624b0a29b88\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"8d73c491-046f-5cd3-b706-8f3b35452af7\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"6b2e7d2e-2039-542b-8d0a-11408915e466\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\"] [:db/add \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/correct \"8d73c491-046f-5cd3-b706-8f3b35452af7\"] [:db/ensure \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/validate] [:db/add \"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/id #uuid \"13caf36a-02b4-55f9-a580-190c0c5631fb\"] [:db/add \"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/problem \"Express the following as a constant multiple of a single trigonometric ratio.\\n$$\\n2\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{32}\\\\right)\\\\cos\\\\left(\\\\frac{5 \\\\pi}{32}\\\\right)\\\\cos\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right).\\n$$\"] [:db/add \"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{5 \\\\pi}{32}$ and then at $x=\\\\frac{5 \\\\pi}{16}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=\\\\sin\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right)\\\\\\\\&=\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\\n\\\\end{aligned}\\n$$\"] [:db/add \"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/difficulty :question.difficulty/moderate] [:db/add \"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/answer-fields \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\"] [:db/ensure \"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"13caf36a-02b4-55f9-a580-190c0c5631fb\"] [:db/add \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/id #uuid \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\"] [:db/add \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/type :answer.type/math] [:db/add \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/value \"\\\\frac{16 \\\\sqrt{3}}{3}\"] [:db/ensure \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/validate] [:db/add \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/id #uuid \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\"] [:db/add \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/key \"field-1\"] [:db/add \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/type :answer-field.type/blank] [:db/add \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/choices \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\"] [:db/add \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/correct \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\"] [:db/ensure \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/validate] [:db/add \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/id #uuid \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\"] [:db/add \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n\\\\frac{2\\\\,\\\\sec\\\\left(30^\\\\circ\\\\right)}{\\\\sin\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(15^\\\\circ\\\\right)}.\\n$$\\n{{field-1}}\"] [:db/add \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/worked-solution \"Let $E$ denote the given expression. Apply $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ at $x=15^\\\\circ$ in the denominator. Use $\\\\sec x=1/\\\\cos x$, then apply the double-angle identity again at $x=30^\\\\circ$.\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{4\\\\,\\\\sec\\\\left(30^\\\\circ\\\\right)}{\\\\sin\\\\left(30^\\\\circ\\\\right)}\\\\\\\\&=\\\\frac{4}{\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)}\\\\\\\\&=\\\\frac{8}{\\\\sin\\\\left(60^\\\\circ\\\\right)}\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(60^\\\\circ\\\\right)=\\\\frac{\\\\sqrt{3}}{2}$.\\nRationalize the denominator by multiplying numerator and denominator by $\\\\sqrt{3}$:\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{8}{\\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right)}\\\\\\\\&=\\\\frac{16}{\\\\sqrt{3}}\\\\\\\\&=\\\\frac{16 \\\\sqrt{3}}{3}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/difficulty :question.difficulty/hard] [:db/add \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/answer-fields \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\"] [:db/ensure \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\"] [:db/add \"generator\" :question-generator/id #uuid \"da8b8b89-3c65-555e-a59a-7eb8bd977472\"] [:db/add \"generator\" :question-generator/script \"generators/c3/c350c734808c295ff11fc76361e10a82ef42d08f2248eaf6309552b98881fc35/generator.py\"] [:db/add 17592186059672 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186059672 :knowledge-point/validate]] \"assertions\" [[\"76a12179-d37a-5ba8-b18c-fa0a3b5f1daf\" :answer/id #uuid \"76a12179-d37a-5ba8-b18c-fa0a3b5f1daf\"] [\"76a12179-d37a-5ba8-b18c-fa0a3b5f1daf\" :answer/type :answer.type/math] [\"76a12179-d37a-5ba8-b18c-fa0a3b5f1daf\" :answer/value \"2\"] [\"8c54ff57-fb04-544d-9296-9db316c32394\" :answer/id #uuid \"8c54ff57-fb04-544d-9296-9db316c32394\"] [\"8c54ff57-fb04-544d-9296-9db316c32394\" :answer/type :answer.type/math] [\"8c54ff57-fb04-544d-9296-9db316c32394\" :answer/value \"2 \\\\sqrt{2}\"] [\"4958c399-6d8b-5f06-912f-b1d879b282fd\" :answer/id #uuid \"4958c399-6d8b-5f06-912f-b1d879b282fd\"] [\"4958c399-6d8b-5f06-912f-b1d879b282fd\" :answer/type :answer.type/math] [\"4958c399-6d8b-5f06-912f-b1d879b282fd\" :answer/value \"\\\\sqrt{3}\"] [\"f8dd6a24-4510-53b3-bc21-a3d10c8d6758\" :answer/id #uuid \"f8dd6a24-4510-53b3-bc21-a3d10c8d6758\"] [\"f8dd6a24-4510-53b3-bc21-a3d10c8d6758\" :answer/type :answer.type/math] [\"f8dd6a24-4510-53b3-bc21-a3d10c8d6758\" :answer/value \"\\\\frac{1}{2}\"] [\"0d2f5a41-6ac2-5ca0-8d8b-315663aba221\" :answer/id #uuid \"0d2f5a41-6ac2-5ca0-8d8b-315663aba221\"] [\"0d2f5a41-6ac2-5ca0-8d8b-315663aba221\" :answer/type :answer.type/math] [\"0d2f5a41-6ac2-5ca0-8d8b-315663aba221\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/id #uuid \"f48b0324-6d84-5908-9d76-cee56d4ccf40\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/key \"selection\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/type :answer-field.type/radio] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"76a12179-d37a-5ba8-b18c-fa0a3b5f1daf\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"8c54ff57-fb04-544d-9296-9db316c32394\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"4958c399-6d8b-5f06-912f-b1d879b282fd\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"f8dd6a24-4510-53b3-bc21-a3d10c8d6758\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"0d2f5a41-6ac2-5ca0-8d8b-315663aba221\"] [\"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/correct \"4958c399-6d8b-5f06-912f-b1d879b282fd\"] [\"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/id #uuid \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\"] [\"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right).\\n$$\"] [\"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=15^\\\\circ$ and then at $x=30^\\\\circ$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(60^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(60^\\\\circ\\\\right)=\\\\frac{\\\\sqrt{3}}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\\\\\&=\\\\sqrt{3}.\\n\\\\end{aligned}\\n$$\"] [\"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/difficulty :question.difficulty/easy] [\"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/answer-fields \"f48b0324-6d84-5908-9d76-cee56d4ccf40\"] [17592186059672 :knowledge-point/questions \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\"] [\"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/id #uuid \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\"] [\"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/type :answer.type/math] [\"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/value \"\\\\frac{1}{2}\"] [\"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/id #uuid \"b540806d-ab28-5d3f-9303-864194a19a9d\"] [\"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/type :answer.type/math] [\"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/value \"1\"] [\"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/id #uuid \"ef7ded27-c9d5-5493-97e1-560789a01f9e\"] [\"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/type :answer.type/math] [\"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/value \"\\\\sqrt{2}\"] [\"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/id #uuid \"e1a3b33b-886d-5b02-82a3-5d60199c0086\"] [\"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/type :answer.type/math] [\"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/value \"\\\\frac{1}{4}\"] [\"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/id #uuid \"f0634960-19b8-57eb-a258-b3b410de96e8\"] [\"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/type :answer.type/math] [\"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/id #uuid \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/key \"selection\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/type :answer-field.type/radio] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"b540806d-ab28-5d3f-9303-864194a19a9d\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"ef7ded27-c9d5-5493-97e1-560789a01f9e\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"e1a3b33b-886d-5b02-82a3-5d60199c0086\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"f0634960-19b8-57eb-a258-b3b410de96e8\"] [\"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/correct \"b540806d-ab28-5d3f-9303-864194a19a9d\"] [\"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/id #uuid \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\"] [\"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right).\\n$$\"] [\"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{\\\\pi}{8}$ and then at $x=\\\\frac{\\\\pi}{4}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\\\\\&=\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)=1$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=\\\\left(1\\\\right)\\\\\\\\&=1.\\n\\\\end{aligned}\\n$$\"] [\"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/difficulty :question.difficulty/easy] [\"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/answer-fields \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\"] [17592186059672 :knowledge-point/questions \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\"] [\"c959220b-9980-58cf-861c-e495765d3eca\" :answer/id #uuid \"c959220b-9980-58cf-861c-e495765d3eca\"] [\"c959220b-9980-58cf-861c-e495765d3eca\" :answer/type :answer.type/math] [\"c959220b-9980-58cf-861c-e495765d3eca\" :answer/value \"1\"] [\"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/id #uuid \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\"] [\"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/type :answer.type/math] [\"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/value \"4\"] [\"d2942498-38fd-50a1-a171-03017841f23c\" :answer/id #uuid \"d2942498-38fd-50a1-a171-03017841f23c\"] [\"d2942498-38fd-50a1-a171-03017841f23c\" :answer/type :answer.type/math] [\"d2942498-38fd-50a1-a171-03017841f23c\" :answer/value \"2\"] [\"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/id #uuid \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\"] [\"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/type :answer.type/math] [\"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/value \"2 \\\\sqrt{2}\"] [\"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\" :answer/id #uuid \"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\"] [\"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\" :answer/type :answer.type/math] [\"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\" :answer/value \"2 \\\\sqrt{3}\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/id #uuid \"c4609a50-7f80-5b60-9842-6d7ce5941dd9\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/key \"selection\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/type :answer-field.type/radio] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/choices \"c959220b-9980-58cf-861c-e495765d3eca\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/choices \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/choices \"d2942498-38fd-50a1-a171-03017841f23c\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/choices \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/choices \"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\"] [\"c4609a50-7f80-5b60-9842-6d7ce5941dd9\" :answer-field/correct \"c959220b-9980-58cf-861c-e495765d3eca\"] [\"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/id #uuid \"0b13d522-9f37-55f4-abb4-03939cf0584e\"] [\"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(7.5^\\\\circ\\\\right)\\\\cos\\\\left(7.5^\\\\circ\\\\right)\\\\cos\\\\left(15^\\\\circ\\\\right).\\n$$\"] [\"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=7.5^\\\\circ$ and then at $x=15^\\\\circ$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(15^\\\\circ\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(30^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(30^\\\\circ\\\\right)=\\\\frac{1}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(\\\\frac{1}{2}\\\\right)\\\\\\\\&=1.\\n\\\\end{aligned}\\n$$\"] [\"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/difficulty :question.difficulty/easy] [\"0b13d522-9f37-55f4-abb4-03939cf0584e\" :question/answer-fields \"c4609a50-7f80-5b60-9842-6d7ce5941dd9\"] [17592186059672 :knowledge-point/questions \"0b13d522-9f37-55f4-abb4-03939cf0584e\"] [\"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/id #uuid \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\"] [\"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/type :answer.type/math] [\"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [\"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/id #uuid \"f6c4265d-062e-5418-b4ad-08c35968de5d\"] [\"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/type :answer.type/math] [\"f6c4265d-062e-5418-b4ad-08c35968de5d\" :answer/value \"\\\\sqrt{2}\"] [\"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/id #uuid \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\"] [\"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/type :answer.type/math] [\"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [\"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/id #uuid \"5d0324ad-c372-5805-9c02-d168ddfcc982\"] [\"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/type :answer.type/math] [\"5d0324ad-c372-5805-9c02-d168ddfcc982\" :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\"] [\"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/id #uuid \"66068ac3-b985-5cbb-b1f7-f32543d25407\"] [\"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/type :answer.type/math] [\"66068ac3-b985-5cbb-b1f7-f32543d25407\" :answer/value \"1\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/id #uuid \"67d34673-0071-50d8-a159-6749f0e4b6be\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/key \"selection\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/type :answer-field.type/radio] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"4deb71c8-fdad-5b6a-b340-1c3d76d095ee\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"f6c4265d-062e-5418-b4ad-08c35968de5d\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"f32321a4-0253-5eb1-a6bb-3bd15b58e4cc\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"5d0324ad-c372-5805-9c02-d168ddfcc982\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/choices \"66068ac3-b985-5cbb-b1f7-f32543d25407\"] [\"67d34673-0071-50d8-a159-6749f0e4b6be\" :answer-field/correct \"f6c4265d-062e-5418-b4ad-08c35968de5d\"] [\"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/id #uuid \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\"] [\"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right).\\n$$\"] [\"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{\\\\pi}{16}$ and then at $x=\\\\frac{\\\\pi}{8}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)=\\\\frac{\\\\sqrt{2}}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\\\\\&=\\\\sqrt{2}.\\n\\\\end{aligned}\\n$$\"] [\"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/difficulty :question.difficulty/easy] [\"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\" :question/answer-fields \"67d34673-0071-50d8-a159-6749f0e4b6be\"] [17592186059672 :knowledge-point/questions \"34e7eb2c-14af-5bd1-bf04-01774dae2e4c\"] [\"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/id #uuid \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\"] [\"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/type :answer.type/math] [\"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\" :answer/value \"1\"] [\"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/id #uuid \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\"] [\"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/type :answer.type/math] [\"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\" :answer/value \"\\\\sqrt{3}\"] [\"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/id #uuid \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\"] [\"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/type :answer.type/math] [\"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\" :answer/value \"2\"] [\"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/id #uuid \"5a412728-5a20-53cf-a363-2e228976f66d\"] [\"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/type :answer.type/math] [\"5a412728-5a20-53cf-a363-2e228976f66d\" :answer/value \"\\\\frac{1}{2}\"] [\"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/id #uuid \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\"] [\"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/type :answer.type/math] [\"4feb1838-bf6a-55b7-8199-4cef0f2bab91\" :answer/value \"2 \\\\sqrt{2}\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/id #uuid \"0574cf5b-7c20-59f3-8e24-87d729740cc4\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/key \"selection\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/type :answer-field.type/radio] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"84c79d3f-1b7c-5fa5-bd5c-636ea65bf0ab\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"6e7fe509-f728-51ba-ba90-6a1dddc0dad8\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"5a412728-5a20-53cf-a363-2e228976f66d\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/choices \"4feb1838-bf6a-55b7-8199-4cef0f2bab91\"] [\"0574cf5b-7c20-59f3-8e24-87d729740cc4\" :answer-field/correct \"f4eb1584-1a1f-56ee-9e96-f0f946e13fa0\"] [\"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/id #uuid \"5205ab04-98cb-5c68-9725-f0902169acf7\"] [\"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right).\\n$$\"] [\"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{\\\\pi}{8}$ and then at $x=\\\\frac{\\\\pi}{4}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)=1$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(1\\\\right)\\\\\\\\&=2.\\n\\\\end{aligned}\\n$$\"] [\"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/difficulty :question.difficulty/easy] [\"5205ab04-98cb-5c68-9725-f0902169acf7\" :question/answer-fields \"0574cf5b-7c20-59f3-8e24-87d729740cc4\"] [17592186059672 :knowledge-point/questions \"5205ab04-98cb-5c68-9725-f0902169acf7\"] [\"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/id #uuid \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\"] [\"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/type :answer.type/math] [\"28a55eb5-d201-5d8a-9054-1c20b504f5dd\" :answer/value \"4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\"] [\"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/id #uuid \"808a721e-17f7-50a5-baa0-e6091a5efe66\"] [\"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/type :answer.type/math] [\"808a721e-17f7-50a5-baa0-e6091a5efe66\" :answer/value \"16\"] [\"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/id #uuid \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\"] [\"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/type :answer.type/math] [\"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\" :answer/value \"2\\\\,\\\\csc\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\"] [\"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/id #uuid \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\"] [\"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/type :answer.type/math] [\"77b29c9a-1ac8-5380-a528-9bec26f68e8a\" :answer/value \"4\\\\,\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\"] [\"57799975-740f-5377-81c5-41efae97d248\" :answer/id #uuid \"57799975-740f-5377-81c5-41efae97d248\"] [\"57799975-740f-5377-81c5-41efae97d248\" :answer/type :answer.type/math] [\"57799975-740f-5377-81c5-41efae97d248\" :answer/value \"4\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/id #uuid \"457d341a-469a-56aa-af29-cc618375fb46\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/key \"selection\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/type :answer-field.type/radio] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"28a55eb5-d201-5d8a-9054-1c20b504f5dd\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"808a721e-17f7-50a5-baa0-e6091a5efe66\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"f27edaa5-8eca-5a48-90c2-c9e38d4e9e99\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"77b29c9a-1ac8-5380-a528-9bec26f68e8a\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/choices \"57799975-740f-5377-81c5-41efae97d248\"] [\"457d341a-469a-56aa-af29-cc618375fb46\" :answer-field/correct \"57799975-740f-5377-81c5-41efae97d248\"] [\"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/id #uuid \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\"] [\"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\\\\csc\\\\left(\\\\frac{\\\\pi}{5}\\\\right).\\n$$\"] [\"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ at $x=\\\\frac{\\\\pi}{10}$, then $\\\\csc x=1/\\\\sin x$. The nonzero sine cancels.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\\\\csc\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\\\\\\\\&=4\\\\,\\\\frac{\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)}{\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)}\\\\\\\\&=4\\n\\\\end{aligned}\\n$$\"] [\"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/difficulty :question.difficulty/moderate] [\"f5eb2271-5f6e-539f-a116-c79daec2a6c8\" :question/answer-fields \"457d341a-469a-56aa-af29-cc618375fb46\"] [17592186059672 :knowledge-point/questions \"f5eb2271-5f6e-539f-a116-c79daec2a6c8\"] [\"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/id #uuid \"af461d4d-89b3-5ed9-a949-9bb02437da96\"] [\"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/type :answer.type/math] [\"af461d4d-89b3-5ed9-a949-9bb02437da96\" :answer/value \"\\\\frac{\\\\sqrt{2}}{32}\"] [\"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/id #uuid \"e3d72e34-9aec-537b-956e-24db719ce04f\"] [\"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/type :answer.type/math] [\"e3d72e34-9aec-537b-956e-24db719ce04f\" :answer/value \"\\\\frac{\\\\sqrt{3}}{16}\"] [\"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/id #uuid \"52a20e14-b7e7-5aa7-974c-e3c669e04176\"] [\"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/type :answer.type/math] [\"52a20e14-b7e7-5aa7-974c-e3c669e04176\" :answer/value \"\\\\frac{\\\\sqrt{2}}{16}\"] [\"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/id #uuid \"d8473857-1946-5ff8-827b-e088c6cf9a4e\"] [\"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/type :answer.type/math] [\"d8473857-1946-5ff8-827b-e088c6cf9a4e\" :answer/value \"\\\\frac{1}{16}\"] [\"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/id #uuid \"f120e81a-721b-5033-83c3-ce741840b16e\"] [\"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/type :answer.type/math] [\"f120e81a-721b-5033-83c3-ce741840b16e\" :answer/value \"\\\\frac{\\\\sqrt{2}}{8}\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/id #uuid \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/key \"selection\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/type :answer-field.type/radio] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"af461d4d-89b3-5ed9-a949-9bb02437da96\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"e3d72e34-9aec-537b-956e-24db719ce04f\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"52a20e14-b7e7-5aa7-974c-e3c669e04176\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"d8473857-1946-5ff8-827b-e088c6cf9a4e\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/choices \"f120e81a-721b-5033-83c3-ce741840b16e\"] [\"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\" :answer-field/correct \"f120e81a-721b-5033-83c3-ce741840b16e\"] [\"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/id #uuid \"c5362cd4-e28f-5871-8896-bc4de86ede35\"] [\"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n\\\\sin\\\\left(\\\\frac{3 \\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{3 \\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{3 \\\\pi}{8}\\\\right).\\n$$\"] [\"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{3 \\\\pi}{16}$ and then at $x=\\\\frac{3 \\\\pi}{8}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{3 \\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{3 \\\\pi}{8}\\\\right)\\\\\\\\&=\\\\frac{1}{4}\\\\,\\\\sin\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{3 \\\\pi}{4}\\\\right)=\\\\frac{\\\\sqrt{2}}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{1}{4}\\\\,\\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\\\\\&=\\\\frac{\\\\sqrt{2}}{8}.\\n\\\\end{aligned}\\n$$\"] [\"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/difficulty :question.difficulty/moderate] [\"c5362cd4-e28f-5871-8896-bc4de86ede35\" :question/answer-fields \"e65bf125-7f3f-594d-9f23-e80e0ea6e8d4\"] [17592186059672 :knowledge-point/questions \"c5362cd4-e28f-5871-8896-bc4de86ede35\"] [\"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/id #uuid \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\"] [\"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/type :answer.type/math] [\"246afe6a-2f9a-5df7-b668-3c292e65e7ec\" :answer/value \"\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right)\"] [\"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/id #uuid \"092fc2de-230d-5de6-a34c-4624b0a29b88\"] [\"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/type :answer.type/math] [\"092fc2de-230d-5de6-a34c-4624b0a29b88\" :answer/value \"\\\\frac{1}{4}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{4}\\\\right)\"] [\"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/id #uuid \"8d73c491-046f-5cd3-b706-8f3b35452af7\"] [\"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/type :answer.type/math] [\"8d73c491-046f-5cd3-b706-8f3b35452af7\" :answer/value \"\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\"] [\"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/id #uuid \"6b2e7d2e-2039-542b-8d0a-11408915e466\"] [\"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/type :answer.type/math] [\"6b2e7d2e-2039-542b-8d0a-11408915e466\" :answer/value \"\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\"] [\"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/id #uuid \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\"] [\"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/type :answer.type/math] [\"f9e615fa-520a-5bcf-8f52-3320465ad0a6\" :answer/value \"\\\\frac{1}{4}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/id #uuid \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/key \"selection\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/type :answer-field.type/radio] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"246afe6a-2f9a-5df7-b668-3c292e65e7ec\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"092fc2de-230d-5de6-a34c-4624b0a29b88\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"8d73c491-046f-5cd3-b706-8f3b35452af7\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"6b2e7d2e-2039-542b-8d0a-11408915e466\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/choices \"f9e615fa-520a-5bcf-8f52-3320465ad0a6\"] [\"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\" :answer-field/correct \"8d73c491-046f-5cd3-b706-8f3b35452af7\"] [\"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/id #uuid \"13caf36a-02b4-55f9-a580-190c0c5631fb\"] [\"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/problem \"Express the following as a constant multiple of a single trigonometric ratio.\\n$$\\n2\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{32}\\\\right)\\\\cos\\\\left(\\\\frac{5 \\\\pi}{32}\\\\right)\\\\cos\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right).\\n$$\"] [\"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{5 \\\\pi}{32}$ and then at $x=\\\\frac{5 \\\\pi}{16}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=\\\\sin\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right)\\\\cos\\\\left(\\\\frac{5 \\\\pi}{16}\\\\right)\\\\\\\\&=\\\\frac{1}{2}\\\\,\\\\sin\\\\left(\\\\frac{5 \\\\pi}{8}\\\\right)\\n\\\\end{aligned}\\n$$\"] [\"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/difficulty :question.difficulty/moderate] [\"13caf36a-02b4-55f9-a580-190c0c5631fb\" :question/answer-fields \"bcb9c93e-895f-5366-b2e9-6f7e8f93ef26\"] [17592186059672 :knowledge-point/questions \"13caf36a-02b4-55f9-a580-190c0c5631fb\"] [\"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/id #uuid \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\"] [\"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/type :answer.type/math] [\"f6c6079a-8812-52a0-9f13-205ddcae7b6e\" :answer/value \"\\\\frac{16 \\\\sqrt{3}}{3}\"] [\"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/id #uuid \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\"] [\"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/key \"field-1\"] [\"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/type :answer-field.type/blank] [\"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/choices \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\"] [\"bed228c6-ded3-5844-b7e1-02f0f5e9df18\" :answer-field/correct \"f6c6079a-8812-52a0-9f13-205ddcae7b6e\"] [\"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/id #uuid \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\"] [\"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n\\\\frac{2\\\\,\\\\sec\\\\left(30^\\\\circ\\\\right)}{\\\\sin\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(15^\\\\circ\\\\right)}.\\n$$\\n{{field-1}}\"] [\"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/worked-solution \"Let $E$ denote the given expression. Apply $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ at $x=15^\\\\circ$ in the denominator. Use $\\\\sec x=1/\\\\cos x$, then apply the double-angle identity again at $x=30^\\\\circ$.\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{4\\\\,\\\\sec\\\\left(30^\\\\circ\\\\right)}{\\\\sin\\\\left(30^\\\\circ\\\\right)}\\\\\\\\&=\\\\frac{4}{\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)}\\\\\\\\&=\\\\frac{8}{\\\\sin\\\\left(60^\\\\circ\\\\right)}\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(60^\\\\circ\\\\right)=\\\\frac{\\\\sqrt{3}}{2}$.\\nRationalize the denominator by multiplying numerator and denominator by $\\\\sqrt{3}$:\\n$$\\n\\\\begin{aligned}\\nE&=\\\\frac{8}{\\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right)}\\\\\\\\&=\\\\frac{16}{\\\\sqrt{3}}\\\\\\\\&=\\\\frac{16 \\\\sqrt{3}}{3}.\\n\\\\end{aligned}\\n$$\"] [\"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/difficulty :question.difficulty/hard] [\"0b0c10e5-d9cd-5acf-90f2-1444664f4067\" :question/answer-fields \"bed228c6-ded3-5844-b7e1-02f0f5e9df18\"] [17592186059672 :knowledge-point/questions \"0b0c10e5-d9cd-5acf-90f2-1444664f4067\"] [\"generator\" :question-generator/id #uuid \"da8b8b89-3c65-555e-a59a-7eb8bd977472\"] [\"generator\" :question-generator/script \"generators/c3/c350c734808c295ff11fc76361e10a82ef42d08f2248eaf6309552b98881fc35/generator.py\"] [17592186059672 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186059672 :knowledge-point/question-generator 17592186696444]]}",
