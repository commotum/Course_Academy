4-5908-9d76-cee56d4ccf40\" :answer-field/type :answer-field.type/radio] [:db/add \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"76a12179-d37a-5ba8-b18c-fa0a3b5f1daf\"] [:db/add \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"8c54ff57-fb04-544d-9296-9db316c32394\"] [:db/add \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"4958c399-6d8b-5f06-912f-b1d879b282fd\"] [:db/add \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"f8dd6a24-4510-53b3-bc21-a3d10c8d6758\"] [:db/add \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/choices \"0d2f5a41-6ac2-5ca0-8d8b-315663aba221\"] [:db/add \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/correct \"4958c399-6d8b-5f06-912f-b1d879b282fd\"] [:db/ensure \"f48b0324-6d84-5908-9d76-cee56d4ccf40\" :answer-field/validate] [:db/add \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/id #uuid \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\"] [:db/add \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n8\\\\,\\\\sin\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(15^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right).\\n$$\"] [:db/add \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=15^\\\\circ$ and then at $x=30^\\\\circ$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=4\\\\,\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\\\\\&=2\\\\,\\\\sin\\\\left(60^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(60^\\\\circ\\\\right)=\\\\frac{\\\\sqrt{3}}{2}$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\\\\\&=\\\\sqrt{3}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/difficulty :question.difficulty/easy] [:db/add \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/answer-fields \"f48b0324-6d84-5908-9d76-cee56d4ccf40\"] [:db/ensure \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"f8fa23a0-df4e-59d2-a1e6-1e3769930383\"] [:db/add \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/id #uuid \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\"] [:db/add \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/type :answer.type/math] [:db/add \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/value \"\\\\frac{1}{2}\"] [:db/ensure \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\" :answer/validate] [:db/add \"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/id #uuid \"b540806d-ab28-5d3f-9303-864194a19a9d\"] [:db/add \"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/type :answer.type/math] [:db/add \"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/value \"1\"] [:db/ensure \"b540806d-ab28-5d3f-9303-864194a19a9d\" :answer/validate] [:db/add \"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/id #uuid \"ef7ded27-c9d5-5493-97e1-560789a01f9e\"] [:db/add \"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/type :answer.type/math] [:db/add \"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/value \"\\\\sqrt{2}\"] [:db/ensure \"ef7ded27-c9d5-5493-97e1-560789a01f9e\" :answer/validate] [:db/add \"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/id #uuid \"e1a3b33b-886d-5b02-82a3-5d60199c0086\"] [:db/add \"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/type :answer.type/math] [:db/add \"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/value \"\\\\frac{1}{4}\"] [:db/ensure \"e1a3b33b-886d-5b02-82a3-5d60199c0086\" :answer/validate] [:db/add \"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/id #uuid \"f0634960-19b8-57eb-a258-b3b410de96e8\"] [:db/add \"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/type :answer.type/math] [:db/add \"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [:db/ensure \"f0634960-19b8-57eb-a258-b3b410de96e8\" :answer/validate] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/id #uuid \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/key \"selection\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/type :answer-field.type/radio] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"51b269ab-2323-5dc4-8295-2ccbd2bc2663\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"b540806d-ab28-5d3f-9303-864194a19a9d\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"ef7ded27-c9d5-5493-97e1-560789a01f9e\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"e1a3b33b-886d-5b02-82a3-5d60199c0086\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/choices \"f0634960-19b8-57eb-a258-b3b410de96e8\"] [:db/add \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/correct \"b540806d-ab28-5d3f-9303-864194a19a9d\"] [:db/ensure \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\" :answer-field/validate] [:db/add \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/id #uuid \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\"] [:db/add \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/problem \"Without using a calculator, find the exact value of\\n$$\\n4\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right).\\n$$\"] [:db/add \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/worked-solution \"Let $E$ denote the given expression. Use $\\\\sin x\\\\cos x=\\\\frac{1}{2}\\\\sin(2x)$ first at $x=\\\\frac{\\\\pi}{8}$ and then at $x=\\\\frac{\\\\pi}{4}$. Each application introduces a factor of $\\\\frac{1}{2}$.\\n$$\\n\\\\begin{aligned}\\nE&=2\\\\,\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\\\\\&=\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\\n\\\\end{aligned}\\n$$\\nThe terminal sine is $\\\\sin\\\\left(\\\\frac{\\\\pi}{2}\\\\right)=1$.\\nTherefore,\\n$$\\n\\\\begin{aligned}\\nE&=\\\\left(1\\\\right)\\\\\\\\&=1.\\n\\\\end{aligned}\\n$$\"] [:db/add \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/difficulty :question.difficulty/easy] [:db/add \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/answer-fields \"e9eb51c5-ef2d-5809-a2b9-c47e2f435227\"] [:db/ensure \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\" :question/validate] [:db/add 17592186059672 :knowledge-point/questions \"90970a95-e0ab-56f8-bcbf-d7ffa043e550\"] [:db/add \"c959220b-9980-58cf-861c-e495765d3eca\" :answer/id #uuid \"c959220b-9980-58cf-861c-e495765d3eca\"] [:db/add \"c959220b-9980-58cf-861c-e495765d3eca\" :answer/type :answer.type/math] [:db/add \"c959220b-9980-58cf-861c-e495765d3eca\" :answer/value \"1\"] [:db/ensure \"c959220b-9980-58cf-861c-e495765d3eca\" :answer/validate] [:db/add \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/id #uuid \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\"] [:db/add \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/type :answer.type/math] [:db/add \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/value \"4\"] [:db/ensure \"ba76f02f-7bd0-5a3f-9a2c-38d56266f2dc\" :answer/validate] [:db/add \"d2942498-38fd-50a1-a171-03017841f23c\" :answer/id #uuid \"d2942498-38fd-50a1-a171-03017841f23c\"] [:db/add \"d2942498-38fd-50a1-a171-03017841f23c\" :answer/type :answer.type/math] [:db/add \"d2942498-38fd-50a1-a171-03017841f23c\" :answer/value \"2\"] [:db/ensure \"d2942498-38fd-50a1-a171-03017841f23c\" :answer/validate] [:db/add \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/id #uuid \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\"] [:db/add \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/type :answer.type/math] [:db/add \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/value \"2 \\\\sqrt{2}\"] [:db/ensure \"8696e1eb-9aba-56cd-9bae-cb7df9be3494\" :answer/validate] [:db/add \"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\" :answer/id #uuid \"663cad9a-6a7b-5cf3-82e3-a0e88dbbd671\"] [:db/add \"663cad9a-6a7b-5cf3-82e3-a0e88