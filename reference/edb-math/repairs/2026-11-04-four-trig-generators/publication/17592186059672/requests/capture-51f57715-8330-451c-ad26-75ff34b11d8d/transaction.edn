631fb"] [:db/add "f6c6079a-8812-52a0-9f13-205ddcae7b6e" :answer/id #uuid "f6c6079a-8812-52a0-9f13-205ddcae7b6e"] [:db/add "f6c6079a-8812-52a0-9f13-205ddcae7b6e" :answer/type :answer.type/math] [:db/add "f6c6079a-8812-52a0-9f13-205ddcae7b6e" :answer/value "\\frac{16 \\sqrt{3}}{3}"] [:db/ensure "f6c6079a-8812-52a0-9f13-205ddcae7b6e" :answer/validate] [:db/add "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/id #uuid "bed228c6-ded3-5844-b7e1-02f0f5e9df18"] [:db/add "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/key "field-1"] [:db/add "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/type :answer-field.type/blank] [:db/add "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/choices "f6c6079a-8812-52a0-9f13-205ddcae7b6e"] [:db/add "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/correct "f6c6079a-8812-52a0-9f13-205ddcae7b6e"] [:db/ensure "bed228c6-ded3-5844-b7e1-02f0f5e9df18" :answer-field/validate] [:db/add "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/id #uuid "0b0c10e5-d9cd-5acf-90f2-1444664f4067"] [:db/add "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/problem "Without using a calculator, find the exact value of\n$$\n\\frac{2\\,\\sec\\left(30^\\circ\\right)}{\\sin\\left(15^\\circ\\right)\\cos\\left(15^\\circ\\right)}.\n$$\n{{field-1}}"] [:db/add "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/worked-solution "Let $E$ denote the given expression. Apply $\\sin x\\cos x=\\frac{1}{2}\\sin(2x)$ at $x=15^\\circ$ in the denominator. Use $\\sec x=1/\\cos x$, then apply the double-angle identity again at $x=30^\\circ$.\n$$\n\\begin{aligned}\nE&=\\frac{4\\,\\sec\\left(30^\\circ\\right)}{\\sin\\left(30^\\circ\\right)}\\\\&=\\frac{4}{\\sin\\left(30^\\circ\\right)\\cos\\left(30^\\circ\\right)}\\\\&=\\frac{8}{\\sin\\left(60^\\circ\\right)}\n\\end{aligned}\n$$\nThe terminal sine is $\\sin\\left(60^\\circ\\right)=\\frac{\\sqrt{3}}{2}$.\nRationalize the denominator by multiplying numerator and denominator by $\\sqrt{3}$:\n$$\n\\begin{aligned}\nE&=\\frac{8}{\\left(\\frac{\\sqrt{3}}{2}\\right)}\\\\&=\\frac{16}{\\sqrt{3}}\\\\&=\\frac{16 \\sqrt{3}}{3}.\n\\end{aligned}\n$$"] [:db/add "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/difficulty :question.difficulty/hard] [:db/add "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/answer-fields "bed228c6-ded3-5844-b7e1-02f0f5e9df18"] [:db/ensure "0b0c10e5-d9cd-5acf-90f2-1444664f4067" :question/validate] [:db/add 17592186059672 :knowledge-point/questions "0b0c10e5-d9cd-5acf-90f2-1444664f4067"] [:db/add "generator" :question-generator/id #uuid "da8b8b89-3c65-555e-a59a-7eb8bd977472"] [:db/add "generator" :question-generator/script "generators/c3/c350c734808c295ff11fc76361e10a82ef42d08f2248eaf6309552b98881fc35/generator.py"] [:db/add 17592186059672 :knowledge-point/question-generator "generator"] [:db/ensure 17592186059672 :knowledge-point/validate] [:db/cas 17592186696008 :question/retired nil true] [:db/cas 17592186696009 :question/retired nil true] [:db/cas 17592186696011 :question/retired nil true] [:db/cas 17592186696414 :question/retired nil true] [:db/cas 17592186696420 :question/retired nil true] [:db/cas 17592186696423 :question/retired nil true] [:db/cas 17592186696428 :question/retired nil true] [:db/cas 17592186696434 :question/retired nil true] [:db/cas 17592186696466 :question/retired nil true] [:db/cas 17592186696472 :question/retired nil true] [:db/cas 17592186696479 :question/retired nil true] [:db/cas 17592186696484 :question/retired nil true]]
