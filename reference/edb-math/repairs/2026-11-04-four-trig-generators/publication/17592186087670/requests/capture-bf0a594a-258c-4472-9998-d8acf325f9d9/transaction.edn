\\left(158^\\circ\\right)\n\\end{aligned}\n$$"] [:db/add "90114c66-7fd4-5a3c-924e-bfa8ab05846d" :question/difficulty :question.difficulty/hard] [:db/add "90114c66-7fd4-5a3c-924e-bfa8ab05846d" :question/answer-fields "a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e"] [:db/ensure "90114c66-7fd4-5a3c-924e-bfa8ab05846d" :question/validate] [:db/add 17592186087670 :knowledge-point/questions "90114c66-7fd4-5a3c-924e-bfa8ab05846d"] [:db/add "3b4e0a0e-7f16-5a7d-ac73-1c421219f61c" :answer/id #uuid "3b4e0a0e-7f16-5a7d-ac73-1c421219f61c"] [:db/add "3b4e0a0e-7f16-5a7d-ac73-1c421219f61c" :answer/type :answer.type/math] [:db/add "3b4e0a0e-7f16-5a7d-ac73-1c421219f61c" :answer/value "\\frac{2}{3}\\cos\\left(\\frac{15\\pi}{8}\\right)"] [:db/ensure "3b4e0a0e-7f16-5a7d-ac73-1c421219f61c" :answer/validate] [:db/add "e4f1f926-58cf-521f-8b52-b6d0c36f45e5" :answer/id #uuid "e4f1f926-58cf-521f-8b52-b6d0c36f45e5"] [:db/add "e4f1f926-58cf-521f-8b52-b6d0c36f45e5" :answer/type :answer.type/math] [:db/add "e4f1f926-58cf-521f-8b52-b6d0c36f45e5" :answer/value "\\frac{2}{3}\\cos\\left(\\frac{15\\pi}{4}\\right)"] [:db/ensure "e4f1f926-58cf-521f-8b52-b6d0c36f45e5" :answer/validate] [:db/add "9f321728-cc53-5dc4-ac15-8dbba49136f4" :answer/id #uuid "9f321728-cc53-5dc4-ac15-8dbba49136f4"] [:db/add "9f321728-cc53-5dc4-ac15-8dbba49136f4" :answer/type :answer.type/math] [:db/add "9f321728-cc53-5dc4-ac15-8dbba49136f4" :answer/value "\\frac{2}{3}\\cos\\left(\\frac{15\\pi}{2}\\right)"] [:db/ensure "9f321728-cc53-5dc4-ac15-8dbba49136f4" :answer/validate] [:db/add "4433b41b-7014-5f96-9527-4b715a2252e7" :answer/id #uuid "4433b41b-7014-5f96-9527-4b715a2252e7"] [:db/add "4433b41b-7014-5f96-9527-4b715a2252e7" :answer/type :answer.type/math] [:db/add "4433b41b-7014-5f96-9527-4b715a2252e7" :answer/value "\\frac{1}{3}\\cos\\left(\\frac{15\\pi}{4}\\right)"] [:db/ensure "4433b41b-7014-5f96-9527-4b715a2252e7" :answer/validate] [:db/add "bd5b3f17-d893-598b-86dc-34ae6f02ea3f" :answer/id #uuid "bd5b3f17-d893-598b-86dc-34ae6f02ea3f"] [