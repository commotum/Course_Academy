ype/math} :answer/value \"2\\\\operatorname{cos}⁡{33}^{∘}\" :db/id 17592186342817} {:answer/id #uuid \"a6b8ca77-3cc8-55fc-a867-a1e0902bc98f\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{sin}⁡{33}^{∘}\" :db/id 17592186343705} {:answer/id #uuid \"d89b4728-9e47-5294-a8b6-427819d5e4b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"2{\\\\cos }^{2}⁡{66}^{∘}\" :db/id 17592186344141}] :answer-field/correct {:answer/id #uuid \"2629e2e1-4d82-54f8-ad47-60d62b593e34\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{66}^{∘}\" :db/id 17592186342561} :answer-field/id #uuid \"9fea7d78-c94b-5ae2-b0cb-909fba75789a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344774}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"04abbf67-4a6c-52f1-b4dc-77c7ccec9a6d\" :question/math-academy-id \"q-7697\" :question/problem \"Express $2{\\\\cos }^{2}⁡{33}^{∘}-1$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n2{\\\\cos }^{2}⁡x-1=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={33}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡{33}^{∘}-1 & =\\\\operatorname{cos}⁡(2\\\\cdot {33}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{66}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186598566 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8e3d60a9-c6bb-56b7-b90b-4cdb195240fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{5\\\\pi }{4}\\\\right)\" :db/id 17592186598128} {:answer/id #uuid \"a14d5d7a-0c1d-59e2-abd8-8ebb441186f7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{5}\\\\right)\" :db/id 17592186598178} {:answer/id #uuid \"bdb82f16-7e45-52b3-bf6d-cd9a476101e0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{5}\\\\right)\" :db/id 17592186598235} {:answer/id #uuid \"d65d0ff0-1740-54fd-b6fd-6aa8f1907148\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{8\\\\pi }{5}\\\\right)\" :db/id 17592186598304} {:answer/id #uuid \"e059b769-b1f8-57b9-9e68-fa91ecfbf9a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{4\\\\pi }{5}\\\\right)\" :db/id 17592186598324}] :answer-field/correct {:answer/id #uuid \"d65d0ff0-1740-54fd-b6fd-6aa8f1907148\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{8\\\\pi }{5}\\\\right)\" :db/id 17592186598304} :answer-field/id #uuid \"8a33d2e9-e76c-52ca-9dd6-3b6a3d56837c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186598490}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"05f1f706-d7bf-52e0-b85d-26db016781e2\" :question/math-academy-id \"q-24502\" :question/problem \"Express $2{\\\\cos }^{2}⁡\\\\left(\\\\frac{4\\\\pi }{5}\\\\right)-1$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n2{\\\\cos }^{2}⁡x-1=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{4\\\\pi }{5}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡\\\\left(\\\\frac{4\\\\pi }{5}\\\\right)-1 & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{4\\\\pi }{5}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{8\\\\pi }{5}\\\\right).\\\\end{aligned}\\n$$\"} {:db/id 17592186600356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3d8037c5-8b27-5a29-b856-fb075028cbda\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{7}\\\\right)\" :db/id 17592186600063} {:answer/id #uuid \"64c8f911-5af5-5682-a1fc-425b5d056d6e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{3\\\\pi }{7}\\\\right)\" :db/id 17592186600107} {:answer/id #uuid \"7d433807-00c2-5fab-bfab-5eaf9972b312\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sin}⁡\\\\left(\\\\frac{2\\\\pi }{5}\\\\right)\" :db/id 17592186600135} {:answer/id #uuid \"b1fad5b5-f50b-50a2-b0fb-86a24286dfc4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{5}\\\\right)\" :db/id 17592186600186} {:answer/id #uuid \"fee6b43b-05cf-5d02-9e4a-456de4bceda1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{7}\\\\right)\" :db/id 17592186600270}] :answer-field/correct {:answer/id #uuid \"fee6b43b-05cf-5d02-9e4a-456de4bceda1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{7}\\\\right)\" :db/id 17592186600270} :answer-field/id #uuid \"ba2910a8-7e77-56c6-8abd-dd31bf504df2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186600324}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"3040e843-834f-5c85-8b47-67e7449af8b6\" :question/math-academy-id \"q-24487\" :question/problem \"Express $1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{7}\\\\right)$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{\\\\pi }{7}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{7}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{\\\\pi }{7}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{7}\\\\right).\\\\end{aligned}\\n$$\"} {:db/id 17592186600406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"29a83298-4767-5c0f-9454-4a21206193e2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\operatorname{cos}⁡{36}^{∘}\" :db/id 17592186600036} {:answer/id #uuid \"2d34af50-0f90-535d-b4ca-1f9653c68dd4\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{cos}⁡{24}^{∘}\" :db/id 17592186600044} {:answer/id #uuid \"4ecb49aa-96a4-5a10-a2aa-1729bfeadcaf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\\\\operatorname{cos}⁡{12}^{∘}\" :db/id 17592186600088} {:answer/id #uuid \"653e3974-067f-5766-8514-58510430d6a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\\\\operatorname{cos}⁡{24}^{∘}\" :db/id 17592186600109} {:answer/id #uuid \"bc64522c-1a81-5a9d-8a0b-e11fa390d7d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{24}^{∘}\" :db/id 17592186600195}] :answer-field/correct {:answer/id #uuid \"653e3974-067f-5766-8514-58510430d6a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\\\\operatorname{cos}⁡{24}^{∘}\" :db/id 17592186600109} :answer-field/id #uuid \"fbf31bb2-dca7-5733-aec8-eb9ed2328952\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186600340}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"fcf02ed8-7ca6-562d-a40a-acc3531d1966\" :question/math-academy-id \"q-7340\" :question/problem \"Express $2\\\\sqrt{3}{\\\\cos }^{2}⁡{12}^{∘}-\\\\sqrt{3}$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n\\\\sqrt{3}(2{\\\\cos }^{2}⁡{12}^{∘}-1)\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n2{\\\\cos }^{2}⁡x-1=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={12}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡{12}^{∘}-1 & =\\\\operatorname{cos}⁡(2\\\\cdot {12}^{∘})=\\\\operatorname{cos}⁡{24}^{∘}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}\\\\sqrt{3}(2{\\\\cos }^{2}⁡{12}^{∘}-1) & =\\\\sqrt{3}\\\\operatorname{cos}⁡{24}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186698902 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"11bbcaa3-7980-53a2-b9bb-09b73d4b7a1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos(52^\\\\circ)\" :db/id 17592186698896} {:answer/id #uuid \"4a524d22-66f4-5ce0-852a-f0d398e60cc3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos^2(52^\\\\circ)\" :db/id 17592186698901} {:answer/id #uuid \"5556fcb1-5bf1-5834-a1c6-6180d34aff0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos(52^\\\\circ)\" :db/id 17592186698904} {:answer/id #uuid \"63d4e74f-bccd-5dc4-857c-40762cd61c48\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos(26^\\\\circ)\" :db/id 17592186698905} {:answer/id #uuid \"92540f9b-15c5-554f-8cd4-6ee2dfe3fecf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sin(52^\\\\circ)\" :db/id 17592186698907}] :answer-field/correct {:answer/id #uuid \"5556fcb1-5bf1-5834-a1c6-6180d34aff0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos(52^\\\\circ)\" :db/id 17592186698904} :answer-field/id #uuid \"1e7dd1a0-14f3-5264-b0f7-04381107693f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186698897}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"4cc86fd4-4cff-556b-b498-0ed5f903f896\" :question/problem \"Express $2\\\\cos^2(26^\\\\circ)-1$ as a single trigonometric ratio.\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x).\\n$$\\n\\nSubstitute $x=26^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2(26^\\\\circ)-1&=\\\\cos(2\\\\cdot26^\\\\circ)\\\\\\\\\\n&=\\\\cos(52^\\\\circ).\\n\\\\end{aligned}\\n$$\\n\\nThe angle doubles; the result has no square or extra factor of $2$.\"} {:db/id 17592186698903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0706ea7f-cd98-5387-adcb-07f81e44c4a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\" :db/id 17592186698894} {:answer/id #uuid \"3423b747-848f-58cb-9004-a4bc1a0eaea0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\" :db/id 17592186698899} {:answer/id #uuid \"97f7a21a-a597-59dc-9f85-53c5ccfc2fdb\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\sin\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\" :db/id 17592186698908} {:answer/id #uuid \"d7610bd6-1798-55e0-a234-6ca4a15bac8f\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\cos\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\" :db/id 17592186698912} {:answer/id #uuid \"db724d67-af6c-5b0f-9fc4-f4cb3685d754\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\" :db/id 17592186698914}] :answer-field/correct {:answer/id #uuid \"db724d67-af6c-5b0f-9fc4-f4cb3685d754\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right)\" :db/id 17592186698914} :answer-field/id #uuid \"861c4ceb-4c44-53d2-924a-01ae578451b1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186698906}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"50cdd9e4-0770-5f5a-9786-42413bfe694e\" :question/problem \"Express $3-6\\\\sin^2\\\\left(\\\\frac{\\\\pi}{10}\\\\right)$ as a single trigonometric ratio.\" :question/worked-solution \"First factor out $3$ to expose the identity:\\n\\n$$\\n3-6\\\\sin^2\\\\left(\\\\frac{\\\\pi}{10}\\\\right)=3\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\\\\right).\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x).\\n$$\\n\\nWith $x=\\\\frac{\\\\pi}{10}$, this gives\\n\\n$$\\n\\\\begin{aligned}\\n3\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{\\\\pi}{10}\\\\right)\\\\right)&=3\\\\cos\\\\left(2\\\\cdot\\\\frac{\\\\pi}{10}\\\\right)\\\\\\\\\\n&=3\\\\cos\\\\left(\\\\frac{\\\\pi}{5}\\\\right).\\n\\\\end{aligned}\\n$$\\n\\nThe outside factor $3$ remains; only the angle inside the cosine doubles.\"} {:db/id 17592186698910 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d4e91ed-960f-5efb-b298-fa987a5b85de\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos(72^\\\\circ)\" :db/id 17592186698895} {:answer/id #uuid \"2246f092-2c32-5d99-bbde-f50941615fd8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos(72^\\\\circ)\" :db/id 17592186698898} {:answer/id #uuid \"46a3f90f-317d-56b6-a6d5-99e073f24ed1\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\cos(72^\\\\circ)\" :db/id 17592186698900} {:answer/id #uuid \"a417f80f-1c8c-56d3-963b-072411b2fe7f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos^2(36^\\\\circ)\" :db/id 17592186698909} {:answer/id #uuid \"c2eba2d4-af68-5d1f-833c-d748c674a054\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos(36^\\\\circ)\" :db/id 17592186698911}] :answer-field/correct {:answer/id #uuid \"2246f092-2c32-5d99-bbde-f50941615fd8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos(72^\\\\circ)\" :db/id 17592186698898} :answer-field/id #uuid \"d93d62da-704d-555a-8f78-198a2159b0db\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186698913}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"bf5d2462-3174-5e60-a7b0-a4fd39f0ece8\" :question/problem \"Express $8\\\\cos^4(18^\\\\circ)-8\\\\cos^2(18^\\\\circ)+1$ as a single trigonometric ratio.\" :question/worked-solution \"Regroup the expression so that the alternative double-angle formula can be used twice. To check the regrouping, write $u=\\\\cos^2(18^\\\\circ)$:\\n\\n$$\\n2(2u-1)^2-1=2(4u^2-4u+1)-1=8u^2-8u+1.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\n&8\\\\cos^4(18^\\\\circ)-8\\\\cos^2(18^\\\\circ)+1\\\\\\\\\\n&\\\\qquad=2\\\\left(2\\\\cos^2(18^\\\\circ)-1\\\\right)^2-1.\\n\\\\end{aligned}\\n$$\\n\\nUse $2\\\\cos^2 x-1=\\\\cos(2x)$ first at $x=18^\\\\circ$:\\n\\n$$\\n2\\\\cos^2(18^\\\\circ)-1=\\\\cos(36^\\\\circ).\\n$$\\n\\nSubstitute this into the regrouped expression, then use the same identity at $x=36^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\left(2\\\\cos^2(18^\\\\circ)-1\\\\right)^2-1&=2\\\\cos^2(36^\\\\circ)-1\\\\\\\\\\n&=\\\\cos(2\\\\cdot36^\\\\circ)\\\\\\\\\\n&=\\\\cos(72^\\\\circ).\\n\\\\end{aligned}\\n$$\\n\\nBoth applications are needed: $\\\\cos(36^\\\\circ)$ replaces only the inner expression.\"} {:db/id 17592186698993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"324daf71-3aff-5125-9eca-ae2732cdd15a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(\\\\frac{6\\\\pi}{5}\\\\right)\" :db/id 17592186698982} {:answer/id #uuid \"59b40398-70bc-5711-a116-f34eb5e9a94a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{24\\\\pi}{5}\\\\right)\" :db/id 17592186698988} {:answer/id #uuid \"78373942-6177-5437-8ba6-b32012a411a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(\\\\frac{6\\\\pi}{5}\\\\right)\" :db/id 17592186698994} {:answer/id #uuid \"af87479b-8e57-51c7-9cf6-b26ee52f73c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{12\\\\pi}{5}\\\\right)\" :db/id 17592186699001} {:answer/id #uuid \"f71c05dc-35bf-542e-a5d1-388a70bf2f8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{3\\\\pi}{5}\\\\right)\" :db/id 17592186699011}] :answer-field/correct {:answer/id #uuid \"af87479b-8e57-51c7-9cf6-b26ee52f73c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{12\\\\pi}{5}\\\\right)\" :db/id 17592186699001} :answer-field/id #uuid \"358c6d10-2a27-5760-bcda-1c052e385e9a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186698983}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"76ebaf08-ec5f-5876-9b74-adaba31cb124\" :question/problem \"Express $2\\\\cos^2\\\\left(\\\\frac{6\\\\pi}{5}\\\\right)-1$ as a single trigonometric ratio.\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{6\\\\pi}{5}$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(\\\\frac{6\\\\pi}{5}\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot \\\\frac{6\\\\pi}{5}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{12\\\\pi}{5}\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186698996 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"15679255-4bc2-5718-b383-6e0feded886f\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(89^\\\\circ\\\\right)\" :db/id 17592186698978} {:answer/id #uuid \"5f9b3ef1-d486-5d1a-bea6-79f202ae07f1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(89^\\\\circ\\\\right)\" :db/id 17592186698989} {:answer/id #uuid \"65b012e6-d928-55e2-837c-0ba3257f897e\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(356^\\\\circ\\\\right)\" :db/id 17592186698990} {:answer/id #uuid \"672fe2ac-f3c7-5c1a-b73b-55278d306458\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(178^\\\\circ\\\\right)\" :db/id 17592186698992} {:answer/id #uuid \"a8d5f916-58e9-5edd-8608-342c28c84893\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(89^\\\\circ\\\\right)\" :db/id 17592186698999}] :answer-field/correct {:answer/id #uuid \"672fe2ac-f3c7-5c1a-b73b-55278d306458\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(178^\\\\circ\\\\right)\" :db/id 17592186698992} :answer-field/id #uuid \"5760c5b7-edb8-5c3f-872d-ff1b734f111e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186698985}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9965564e-6288-577a-935f-f28a95f7058e\" :question/problem \"Express $2\\\\cos^2\\\\left(89^\\\\circ\\\\right)-1$ as a single trigonometric ratio.\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=89^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(89^\\\\circ\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot 89^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(178^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186698998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"16606979-8044-59eb-97ab-b5922dbd5e6f\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(61^\\\\circ\\\\right)\" :db/id 17592186698979} {:answer/id #uuid \"1c091572-b414-5344-9a9b-59a2959aba73\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(122^\\\\circ\\\\right)\" :db/id 17592186698980} {:answer/id #uuid \"2e812b52-657b-5c22-adec-ec406a028475\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(61^\\\\circ\\\\right)\" :db/id 17592186698981} {:answer/id #uuid \"e2df30c2-dfad-52e1-ae47-019689073ebc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(122^\\\\circ\\\\right)\" :db/id 17592186699006} {:answer/id #uuid \"eba032f4-5549-544a-adb4-41c35737ad36\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(183^\\\\circ\\\\right)\" :db/id 17592186699009}] :answer-field/correct {:answer/id #uuid \"1c091572-b414-5344-9a9b-59a2959aba73\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(122^\\\\circ\\\\right)\" :db/id 17592186698980} :answer-field/id #uuid \"d8ea5b60-b458-5db0-b377-073d9b70338e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186699005}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a899deaf-569f-5010-bd40-1da4ebab1ce9\" :question/problem \"Express $2\\\\cos^2\\\\left(61^\\\\circ\\\\right)-1$ as a single trigonometric ratio.\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=61^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(61^\\\\circ\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot 61^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(122^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186699002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0a249fe9-c3f6-5512-a559-ccf4e3829b4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(2\\\\pi\\\\right)\" :db/id 17592186698977} {:answer/id #uuid \"435837e0-884e-53e9-a138-a46b2454ccb0\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(\\\\pi\\\\right)\" :db/id 17592186698984} {:answer/id #uuid \"a27ae1e7-665d-5aa3-9e94-ae37fef412e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(4\\\\pi\\\\right)\" :db/id 17592186698997} {:answer/id #uuid \"d6e7cccf-c294-5b5b-a929-a5ee8cd03c76\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\" :db/id 17592186699003} {:answer/id #uuid \"f0866e38-4fc6-521c-ba5f-d6c2e046c59c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(2\\\\pi\\\\right)\" :db/id 17592186699010}] :answer-field/correct {:answer/id #uuid \"0a249fe9-c3f6-5512-a559-ccf4e3829b4d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(2\\\\pi\\\\right)\" :db/id 17592186698977} :answer-field/id #uuid \"7fdda891-ac98-5c16-b912-19654974a06c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186698995}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ca9d6976-3025-56d6-84cb-4a6491c56d96\" :question/problem \"Express $1-2\\\\sin^2\\\\left(\\\\pi\\\\right)$ as a single trigonometric ratio.\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\pi$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(\\\\pi\\\\right)&=\\\\cos\\\\left(2\\\\cdot \\\\pi\\\\right)\\\\\\\\&=\\\\cos\\\\left(2\\\\pi\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186699008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"57929aa5-04b0-5993-87db-e5700979f2ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(159^\\\\circ\\\\right)\" :db/id 17592186698986} {:answer/id #uuid \"58f41968-2780-511c-af56-9b9ffced9619\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(318^\\\\circ\\\\right)\" :db/id 17592186698987} {:answer/id #uuid \"65f6eb6c-0beb-58c5-885c-f6ed4b5a93d3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(159^\\\\circ\\\\right)\" :db/id 17592186698991} {:answer/id #uuid \"d72ae5a4-6ca8-5761-981a-12c7ecba303d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(318^\\\\circ\\\\right)\" :db/id 17592186699004} {:answer/id #uuid \"e55af766-0f84-5565-95b9-52989163dd5d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(159^\\\\circ\\\\right)\" :db/id 17592186699007}] :answer-field/correct {:answer/id #uuid \"58f41968-2780-511c-af56-9b9ffced9619\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(318^\\\\circ\\\\right)\" :db/id 17592186698987} :answer-field/id #uuid \"ad96e4ec-4c5d-512b-a507-d62ce9e97540\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186699000}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e79a86d8-4485-599e-a2f1-c694de9b2f01\" :question/problem \"Express $1-2\\\\sin^2\\\\left(159^\\\\circ\\\\right)$ as a single trigonometric ratio.\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=159^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(159^\\\\circ\\\\right)&=\\\\cos\\\\left(2\\\\cdot 159^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(318^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186703559 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4dd7ebe8-17b3-55e8-a9da-41770f073158\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(164^\\\\circ\\\\right)\" :db/id 17592186703554} {:answer/id #uuid \"50f259ee-be7d-5e85-a1e0-eeff2bf2f4a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(246^\\\\circ\\\\right)\" :db/id 17592186703555} {:answer/id #uuid \"5271db1b-4825-5c6f-9dad-408c93b6b7d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(41^\\\\circ\\\\right)\" :db/id 17592186703557} {:answer/id #uuid \"8ef764b8-cc0f-52d7-8508-2f7830b3967b\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(328^\\\\circ\\\\right)\" :db/id 17592186703562} {:answer/id #uuid \"9843d1d8-d0ef-580e-ad6f-105ef72b0c3f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(328^\\\\circ\\\\right)\" :db/id 17592186703564}] :answer-field/correct {:answer/id #uuid \"4dd7ebe8-17b3-55e8-a9da-41770f073158\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(164^\\\\circ\\\\right)\" :db/id 17592186703554} :answer-field/id #uuid \"124b9d08-3eb0-5a11-a327-782a0679bb99\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186703550}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"5792154b-065f-57e5-a81c-059b162a08b4\" :question/problem \"Express $8\\\\cos^4\\\\left(41^\\\\circ\\\\right)-8\\\\cos^2\\\\left(41^\\\\circ\\\\right)+1$ as a single trigonometric ratio.\" :question/worked-solution \"Write $u=\\\\cos^2\\\\left(41^\\\\circ\\\\right)$. Expanding the square gives\\n\\n$$\\n\\\\begin{aligned}2(2u-1)^2-1 &=8u^2-8u+1\\\\end{aligned}\\n$$\\n\\nRegroup the given expression:\\n\\n$$\\n\\\\begin{aligned}\\n&8\\\\cos^4\\\\left(41^\\\\circ\\\\right)-8\\\\cos^2\\\\left(41^\\\\circ\\\\right)+1\\\\\\\\&\\\\qquad=2\\\\left(2\\\\cos^2\\\\left(41^\\\\circ\\\\right)-1\\\\right)^2-1\\n\\\\end{aligned}\\n$$\\n\\nUse $2\\\\cos^2 x-1=\\\\cos(2x)$ on the inner expression:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(41^\\\\circ\\\\right)-1&=\\\\cos\\\\left(82^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nSubstitute, then apply the cosine form once more:\\n\\n$$\\n\\\\begin{aligned}\\n&2\\\\left(2\\\\cos^2\\\\left(41^\\\\circ\\\\right)-1\\\\right)^2-1\\\\\\\\&\\\\qquad=2\\\\cos^2\\\\left(82^\\\\circ\\\\right)-1\\\\\\\\&\\\\qquad=\\\\cos\\\\left(164^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186703560 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7b957099-9c95-5e4d-b129-b975dcbb5d30\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\" :db/id 17592186703561} {:answer/id #uuid \"ab81bc5d-585f-58f0-be27-775f22f68139\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(\\\\frac{4\\\\pi}{9}\\\\right)\" :db/id 17592186703567} {:answer/id #uuid \"b0b1923c-bd2d-5659-bb50-c919c57fe961\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{8\\\\pi}{9}\\\\right)\" :db/id 17592186703568} {:answer/id #uuid \"b36cda47-d5e4-5714-9e4d-cf770d67a098\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(\\\\frac{8\\\\pi}{9}\\\\right)\" :db/id 17592186703569} {:answer/id #uuid \"e5a4c711-5f9c-58e6-af3b-57a723eb77a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{4\\\\pi}{9}\\\\right)\" :db/id 17592186703573}] :answer-field/correct {:answer/id #uuid \"b0b1923c-bd2d-5659-bb50-c919c57fe961\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{8\\\\pi}{9}\\\\right)\" :db/id 17592186703568} :answer-field/id #uuid \"f6d1adcd-ebf9-51f4-9a4f-99775cbb7411\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186703574}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"793b0119-35a3-5150-953b-a73f2d53afcb\" :question/problem \"Express $8\\\\sin^4\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)-8\\\\sin^2\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)+1$ as a single trigonometric ratio.\" :question/worked-solution \"Write $u=\\\\sin^2\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)$. Expanding the square gives\\n\\n$$\\n\\\\begin{aligned}2(1-2u)^2-1 &=8u^2-8u+1\\\\end{aligned}\\n$$\\n\\nRegroup the given expression:\\n\\n$$\\n\\\\begin{aligned}\\n&8\\\\sin^4\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)-8\\\\sin^2\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)+1\\\\\\\\&\\\\qquad=2\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\\\\right)^2-1\\n\\\\end{aligned}\\n$$\\n\\nUse $1-2\\\\sin^2 x=\\\\cos(2x)$ on the inner expression:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)&=\\\\cos\\\\left(\\\\frac{4\\\\pi}{9}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nSubstitute, then apply the cosine form once more:\\n\\n$$\\n\\\\begin{aligned}\\n&2\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\\\\right)^2-1\\\\\\\\&\\\\qquad=2\\\\cos^2\\\\left(\\\\frac{4\\\\pi}{9}\\\\right)-1\\\\\\\\&\\\\qquad=\\\\cos\\\\left(\\\\frac{8\\\\pi}{9}\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186703565 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"10f6856e-7cc4-559b-9093-7bb3f8984d51\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(128^\\\\circ\\\\right)\" :db/id 17592186703549} {:answer/id #uuid \"51cceedb-4ebc-55d3-9834-7aa606f35cd0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(32^\\\\circ\\\\right)\" :db/id 17592186703556} {:answer/id #uuid \"9328d4e6-8850-5f06-8af9-a87df0ee0df1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(64^\\\\circ\\\\right)\" :db/id 17592186703563} {:answer/id #uuid \"aacd0aad-c2d1-53b1-8738-a2144c8cc5fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(128^\\\\circ\\\\right)\" :db/id 17592186703566} {:answer/id #uuid \"d93d8001-ca2c-59ac-b542-3a8bcad097fd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(192^\\\\circ\\\\right)\" :db/id 17592186703572}] :answer-field/correct {:answer/id #uuid \"aacd0aad-c2d1-53b1-8738-a2144c8cc5fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(128^\\\\circ\\\\right)\" :db/id 17592186703566} :answer-field/id #uuid \"05f4ae34-7029-519e-9b79-38e4e3f5b058\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186703547}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"987be508-f11a-5a39-a972-96e89ee6964b\" :question/problem \"Express $8\\\\sin^4\\\\left(32^\\\\circ\\\\right)-8\\\\sin^2\\\\left(32^\\\\circ\\\\right)+1$ as a single trigonometric ratio.\" :question/worked-solution \"Write $u=\\\\sin^2\\\\left(32^\\\\circ\\\\right)$. Expanding the square gives\\n\\n$$\\n\\\\begin{aligned}2(1-2u)^2-1 &=8u^2-8u+1\\\\end{aligned}\\n$$\\n\\nRegroup the given expression:\\n\\n$$\\n\\\\begin{aligned}\\n&8\\\\sin^4\\\\left(32^\\\\circ\\\\right)-8\\\\sin^2\\\\left(32^\\\\circ\\\\right)+1\\\\\\\\&\\\\qquad=2\\\\left(1-2\\\\sin^2\\\\left(32^\\\\circ\\\\right)\\\\right)^2-1\\n\\\\end{aligned}\\n$$\\n\\nUse $1-2\\\\sin^2 x=\\\\cos(2x)$ on the inner expression:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(32^\\\\circ\\\\right)&=\\\\cos\\\\left(64^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nSubstitute, then apply the cosine form once more:\\n\\n$$\\n\\\\begin{aligned}\\n&2\\\\left(1-2\\\\sin^2\\\\left(32^\\\\circ\\\\right)\\\\right)^2-1\\\\\\\\&\\\\qquad=2\\\\cos^2\\\\left(64^\\\\circ\\\\right)-1\\\\\\\\&\\\\qquad=\\\\cos\\\\left(128^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186703570 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0cdca884-b99d-50a3-bfe0-f1aec1e16b21\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(\\\\frac{\\\\pi}{9}\\\\right)\" :db/id 17592186703548} {:answer/id #uuid \"253f5fb9-7e35-5059-bc73-9c4dede60bb8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\" :db/id 17592186703551} {:answer/id #uuid \"2cc85eee-2efe-577f-b8f2-8c155e854fef\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\cos\\\\left(\\\\frac{\\\\pi}{9}\\\\right)\" :db/id 17592186703552} {:answer/id #uuid \"38a5a01c-b9c5-5d5b-a05a-368a44533b62\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\" :db/id 17592186703553} {:answer/id #uuid \"560377a5-8c2d-59f0-9c88-dbfc33b83208\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{4\\\\pi}{9}\\\\right)\" :db/id 17592186703558}] :answer-field/correct {:answer/id #uuid \"38a5a01c-b9c5-5d5b-a05a-368a44533b62\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\" :db/id 17592186703553} :answer-field/id #uuid \"c057de91-27d7-56c4-bc31-3d357f285340\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186703571}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"bacb6f46-5c8d-5327-a385-e7236806295b\" :question/problem \"Express $8\\\\cos^4\\\\left(\\\\frac{\\\\pi}{18}\\\\right)-8\\\\cos^2\\\\left(\\\\frac{\\\\pi}{18}\\\\right)+1$ as a single trigonometric ratio.\" :question/worked-solution \"Write $u=\\\\cos^2\\\\left(\\\\frac{\\\\pi}{18}\\\\right)$. Expanding the square gives\\n\\n$$\\n\\\\begin{aligned}2(2u-1)^2-1 &=8u^2-8u+1\\\\end{aligned}\\n$$\\n\\nRegroup the given expression:\\n\\n$$\\n\\\\begin{aligned}\\n&8\\\\cos^4\\\\left(\\\\frac{\\\\pi}{18}\\\\right)-8\\\\cos^2\\\\left(\\\\frac{\\\\pi}{18}\\\\right)+1\\\\\\\\&\\\\qquad=2\\\\left(2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{18}\\\\right)-1\\\\right)^2-1\\n\\\\end{aligned}\\n$$\\n\\nUse $2\\\\cos^2 x-1=\\\\cos(2x)$ on the inner expression:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{18}\\\\right)-1&=\\\\cos\\\\left(\\\\frac{\\\\pi}{9}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nSubstitute, then apply the cosine form once more:\\n\\n$$\\n\\\\begin{aligned}\\n&2\\\\left(2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{18}\\\\right)-1\\\\right)^2-1\\\\\\\\&\\\\qquad=2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{9}\\\\right)-1\\\\\\\\&\\\\qquad=\\\\cos\\\\left(\\\\frac{2\\\\pi}{9}\\\\right)\\n\\\\end{aligned}\\n$$\"}] :knowledge-point/title \"Using Alternative Forms of Double-Angle Formula to Simplify Expressions\"}",
