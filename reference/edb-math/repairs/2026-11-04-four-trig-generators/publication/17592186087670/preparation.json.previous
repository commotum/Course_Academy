9-50f7-5e65-a3b2-d14471eaad53\"] [17592186087670 :knowledge-point/questions \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\"] [\"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/id #uuid \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\"] [\"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/type :answer.type/math] [\"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(\\\\frac{13\\\\pi}{20}\\\\right)\"] [\"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/id #uuid \"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\"] [\"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/type :answer.type/math] [\"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/value \"\\\\frac{3}{2}\\\\cos\\\\left(\\\\frac{26\\\\pi}{5}\\\\right)\"] [\"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/id #uuid \"b2845e58-c1ab-5faf-91d8-9b133de33333\"] [\"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/type :answer.type/math] [\"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/value \"\\\\frac{3}{8}\\\\cos\\\\left(\\\\frac{13\\\\pi}{5}\\\\right)\"] [\"3bab5e85-e58c-5170-84da-7acf5c593725\" :answer/id #uuid \"3bab5e85-e58c-5170-84da-7acf5c593725\"] [\"3bab5e85-e58c-5170-84da-7acf5c593725\" :answer/type :answer.type/math] [\"3bab5e85-e58c-5170-84da-7acf5c593725\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(\\\\frac{13\\\\pi}{5}\\\\right)\"] [\"8ee71078-f0fc-58fa-b51e-1318acb2cadd\" :answer/id #uuid \"8ee71078-f0fc-58fa-b51e-1318acb2cadd\"] [\"8ee71078-f0fc-58fa-b51e-1318acb2cadd\" :answer/type :answer.type/math] [\"8ee71078-f0fc-58fa-b51e-1318acb2cadd\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(\\\\frac{39\\\\pi}{10}\\\\right)\"] [\"6aec1210-7a90-5b22-9759-ec0b42453962\" :answer-field/id #uuid \"6aec1210-7a90-5b22-9759-ec0b42453962\"] [\"6aec1210-7a90-5b22-9759-ec0b42453962\" :answer-field/key \"selection\"] [\"6aec1210-7a90-5b22-9759-ec0b42453962\" :answer-field/type :answer-field.type/radio] [\"6aec1210-7a90-5b22-9759-ec0b42453962\" :answer-field/choices \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\"] [\"6aec1210-7a9