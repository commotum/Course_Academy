  "before_edn": "{:db/id 17592186087670 :knowledge-point/canonical-example {:db/id 17592186087478 :question/id #uuid \"2b9dc462-ec26-5762-aa64-d9e8f16112c9\" :question/math-academy-id \"e-3667\" :question/problem \"Express $2\\\\cos^2{\\\\left(\\\\dfrac{\\\\pi}{3}\\\\right)}-1$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n2 \\\\cos^2 x - 1 = \\\\cos 2x\\n$$\\n\\nSubstituting $x={\\\\dfrac{\\\\pi}{3}}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-1 & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{3}\\\\right).\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"12ff17ae-9319-5498-a5e0-1d49ddbef50a\" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186703575 :question-generator/id #uuid \"804c42f3-1d6c-5fc7-bd1f-b7857de1dc78\" :question-generator/script \"generators/52/5289cbde6015c14cbd33188f0d37f4b7331e78ddf23c89e0bd8b95a6900d0e71/generator.py\"} :knowledge-point/questions [{:db/id 17592186088095 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7088b1af-54df-5c95-bec1-e96b53c5f1cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{3\\\\pi }{2}\\\\right)\" :db/id 17592186288815} {:answer/id #uuid \"9ca70449-d3c0-500a-bf01-9fc59bdb8e04\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{5\\\\pi }{2}\\\\right)\" :db/id 17592186289086} {:answer/id #uuid \"ab1691b5-d526-5306-8cf2-8c5f601c7ba3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{5\\\\pi }{3}\\\\right)\" :db/id 17592186289165} {:answer/id #uuid \"e0db6555-c3dc-5b31-9920-d1231647197e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{7\\\\pi }{3}\\\\right)\" :db/id 17592186289533} {:answer/id #uuid \"e474e08f-fd81-5207-ab8d-f763fcb42bbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{10\\\\pi }{3}\\\\right)\" :db/id 17592186289548}] :answer-field/correct {:answer/id #uuid \"e474e08f-fd81-5207-ab8d-f763fcb42bbb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{10\\\\pi }{3}\\\\right)\" :db/id 17592186289548} :answer-field/id #uuid \"6da4ca44-fffb-53ef-ac9c-e81ad6738ecf\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186289972}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a18ec028-af86-5940-bde5-98a13535f55f\" :question/math-academy-id \"q-24490\" :question/problem \"Express $2{\\\\cos }^{2}⁡\\\\left(\\\\frac{5\\\\pi }{3}\\\\right)-1$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n2{\\\\cos }^{2}⁡x-1=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{5\\\\pi }{3}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡\\\\left(\\\\frac{5\\\\pi }{3}\\\\right)-1 & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{5\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{10\\\\pi }{3}\\\\right).\\\\end{aligned}\\n$$\"} {:db/id 17592186088339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"397011d1-40ef-58e1-a271-2a88e28eddef\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{sin}⁡{20}^{∘}\\\\operatorname{cos}⁡{20}^{∘}\" :db/id 17592186342709} {:answer/id #uuid \"5f5fa170-0ddc-52a6-868a-72cbec943905\" :answer/type {:db/ident :answer.type/math} :answer/value \"2{\\\\cos }^{2}⁡{40}^{∘}\" :db/id 17592186343043} {:answer/id #uuid \"6e8b168b-8168-5d02-9a89-868692b0642f\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{cos}⁡{40}^{∘}\" :db/id 17592186343189} {:answer/id #uuid \"737e14b8-f80f-5ff7-a071-c67c9ee7f9e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sin}⁡{20}^{∘}\\\\operatorname{cos}⁡{20}^{∘}\" :db/id 17592186343238} {:answer/id #uuid \"dc28258e-62ee-554a-9496-55d7f7b52dfa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{40}^{∘}\" :db/id 17592186344170}] :answer-field/correct {:answer/id #uuid \"6e8b168b-8168-5d02-9a89-868692b0642f\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{cos}⁡{40}^{∘}\" :db/id 17592186343189} :answer-field/id #uuid \"72362da5-626c-57b5-9cfa-ac674781feb3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344698}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9c84ae1b-25c3-565d-8730-075bec8eef99\" :question/math-academy-id \"q-7698\" :question/problem \"Express $5-10{\\\\sin }^{2}⁡{20}^{∘}$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n5(1-2{\\\\sin }^{2}⁡{20}^{∘})\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={20}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡{20}^{∘} & =\\\\operatorname{cos}⁡(2\\\\cdot {20}^{∘})=\\\\operatorname{cos}⁡{40}^{∘}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain\\n\\n$$\\n5(1-2{\\\\sin }^{2}⁡{20}^{∘})=5\\\\operatorname{cos}⁡{40}^{∘}.\\n$$\"} {:db/id 17592186256396 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"08223f8a-38cb-545e-b395-de639c4ea440\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{cos}⁡{15}^{∘}\" :db/id 17592186253729} {:answer/id #uuid \"a4806ed8-1b9a-5bba-8fa9-742970bb6963\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186255121} {:answer/id #uuid \"c4e194ef-9bdf-5652-a9b5-d8cbdaa36035\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186255430} {:answer/id #uuid \"e7d9f460-cfda-5e52-b54d-ea1e3efd160e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{60}^{∘}\" :db/id 17592186255708} {:answer/id #uuid \"ea68980f-74c9-54db-b250-a26d03eb923e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{15}^{∘}\" :db/id 17592186255724}] :answer-field/correct {:answer/id #uuid \"c4e194ef-9bdf-5652-a9b5-d8cbdaa36035\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186255430} :answer-field/id #uuid \"f6f08da5-cdb4-57ec-989a-7398084f4434\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186256355}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c6b8a43b-52ca-5dc3-8609-7ee28897f062\" :question/math-academy-id \"q-120357\" :question/problem \"Express $1-2{\\\\sin }^{2}⁡({15}^{∘})$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={15}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡{15}^{∘} & =\\\\operatorname{cos}⁡(2\\\\cdot {15}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{30}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186256397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0fc04807-b343-515b-9c43-7382684abb13\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{8}\\\\right)\" :db/id 17592186253811} {:answer/id #uuid \"474a2bcd-a05b-55df-819f-946a0389240f\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\" :db/id 17592186254275} {:answer/id #uuid \"765c96ab-63cf-5369-9efe-a918084b0992\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\" :db/id 17592186254714} {:answer/id #uuid \"7dd5a3a3-2244-571c-a76f-0674c6cff271\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{8}\\\\right)\" :db/id 17592186254785} {:answer/id #uuid \"9a878f24-4030-5bee-92fd-e58cdacc282e\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\" :db/id 17592186255034}] :answer-field/correct {:answer/id #uuid \"765c96ab-63cf-5369-9efe-a918084b0992\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\" :db/id 17592186254714} :answer-field/id #uuid \"38cdbaa8-adb7-5d1c-a1c4-ebe21d0fa1d0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186256024}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"6564bb9b-39cf-5d47-ba17-b3f0f77c4c7a\" :question/math-academy-id \"q-120358\" :question/problem \"Express $3-6{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{8}\\\\right)$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n3\\\\left(1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{8}\\\\right)\\\\right)\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{\\\\pi }{8}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{8}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{\\\\pi }{8}\\\\right)=\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right).\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}3\\\\left(1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{8}\\\\right)\\\\right) & =3\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right).\\\\end{aligned}\\n$$\"} {:db/id 17592186256398 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"157cee2f-b39d-5759-8141-9311f65baea4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\operatorname{cos}⁡{110}^{∘}\" :db/id 17592186253857} {:answer/id #uuid \"b658d1bf-666b-53ab-86f3-7ef9d39e3d7b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\\\\operatorname{cos}⁡{55}^{∘}\" :db/id 17592186255284} {:answer/id #uuid \"d6a267b4-b9d7-542f-b375-9cbb1aec3915\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{2}\\\\operatorname{cos}⁡{110}^{∘}\" :db/id 17592186255571} {:answer/id #uuid \"f1c24ae1-987c-52e7-81fe-5a16178072dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\operatorname{cos}⁡{55}^{∘}\" :db/id 17592186255782} {:answer/id #uuid \"f3389054-48e3-5025-9361-e8574b467c1d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{cos}⁡{110}^{∘}\" :db/id 17592186255799}] :answer-field/correct {:answer/id #uuid \"157cee2f-b39d-5759-8141-9311f65baea4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\operatorname{cos}⁡{110}^{∘}\" :db/id 17592186253857} :answer-field/id #uuid \"20eaadd3-fcd2-5ba3-9fe8-b461ce34013a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186255977}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"de163629-b9d5-5fdd-bc23-30faf9d38fa4\" :question/math-academy-id \"q-120362\" :question/problem \"Express $\\\\sqrt{2}-2\\\\sqrt{2}{\\\\sin }^{2}⁡{55}^{∘}$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n\\\\sqrt{2}(1-2{\\\\sin }^{2}⁡{55}^{∘})\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={55}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡{55}^{∘} & =\\\\operatorname{cos}⁡(2\\\\cdot {55}^{∘})=\\\\operatorname{cos}⁡{110}^{∘}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}\\\\sqrt{2}(1-2{\\\\sin }^{2}⁡{55}^{∘}) & =\\\\sqrt{2}\\\\operatorname{cos}⁡{110}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186290546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3c6c484f-0d4c-5059-abdc-0a5388322664\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{10}\\\\right)\" :db/id 17592186288449} {:answer/id #uuid \"905767c2-2f4f-53cd-a805-da5f17ade7e7\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{5}\\\\right)\" :db/id 17592186288998} {:answer/id #uuid \"a2d3b909-fd08-568d-a4fd-3a367cf58a52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{5}\\\\right)\" :db/id 17592186289118} {:answer/id #uuid \"b27cd6d7-da62-5d7b-84c9-e5730cb22b5c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{4\\\\pi }{5}\\\\right)\" :db/id 17592186289211} {:answer/id #uuid \"e1c5c2bc-0b3f-5d28-8a4b-51fdecf0f8b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{10}\\\\right)\" :db/id 17592186289536}] :answer-field/correct {:answer/id #uuid \"a2d3b909-fd08-568d-a4fd-3a367cf58a52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{5}\\\\right)\" :db/id 17592186289118} :answer-field/id #uuid \"f665bcbb-88dc-5ad6-8703-67a0c36bad75\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186290240}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a509f6a5-78b4-503c-a592-ded49f6e4644\" :question/math-academy-id \"q-24341\" :question/problem \"Express $1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{5}\\\\right)$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{\\\\pi }{5}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{5}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{\\\\pi }{5}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{2\\\\pi }{5}\\\\right).\\\\end{aligned}\\n$$\"} {:db/id 17592186341956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"07e8e070-de91-5d4a-9b99-628f6756d676\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186339193} {:answer/id #uuid \"2ccf4ffd-92b7-5a00-a7f6-90d277aa4692\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{2}\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186339518} {:answer/id #uuid \"3c18563b-3c67-5345-9b64-9fed57602fcd\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186339664} {:answer/id #uuid \"cd2c8228-381e-5f58-a3c1-ada285b73163\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\operatorname{cos}⁡{60}^{∘}\" :db/id 17592186340947} {:answer/id #uuid \"fa6ba006-51af-5e25-a7bf-390eee765235\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186341342}] :answer-field/correct {:answer/id #uuid \"3c18563b-3c67-5345-9b64-9fed57602fcd\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\operatorname{cos}⁡{30}^{∘}\" :db/id 17592186339664} :answer-field/id #uuid \"2ec2dfa8-1f0e-5019-a5b0-9b7117cace3d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341459}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"8bd0eb34-b6c0-50be-b394-72a3c77e61f3\" :question/math-academy-id \"q-7338\" :question/problem \"Express $8{\\\\cos }^{2}⁡{15}^{∘}-4$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n4(2{\\\\cos }^{2}⁡{15}^{∘}-1)\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n2{\\\\cos }^{2}⁡x-1=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={15}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡{15}^{∘}-1 & =\\\\operatorname{cos}⁡(2\\\\cdot {15}^{∘})=\\\\operatorname{cos}⁡{30}^{∘}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}4(2{\\\\cos }^{2}⁡{15}^{∘}-1) & =4\\\\operatorname{cos}⁡{30}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186344970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ac0d450-3d96-56fc-a7da-749bd9cd175a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{5}\\\\operatorname{cos}⁡{84}^{∘}\" :db/id 17592186342327} {:answer/id #uuid \"487e57df-6dcc-5e07-859e-1c0b862f87bd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{5}\\\\operatorname{cos}⁡{42}^{∘}\" :db/id 17592186342834} {:answer/id #uuid \"58c632f4-be12-57a0-8a48-b7d571fd0978\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{84}^{∘}\" :db/id 17592186342983} {:answer/id #uuid \"61ee2da5-4291-57e8-90ea-878ace56b024\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{cos}⁡{84}^{∘}\" :db/id 17592186343069} {:answer/id #uuid \"7bcca78a-7c40-5864-9bfd-9a11c27c4e61\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\operatorname{cos}⁡{52}^{∘}\" :db/id 17592186343304}] :answer-field/correct {:answer/id #uuid \"0ac0d450-3d96-56fc-a7da-749bd9cd175a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{5}\\\\operatorname{cos}⁡{84}^{∘}\" :db/id 17592186342327} :answer-field/id #uuid \"b12a2734-5735-53be-8c39-1eacbf1c0767\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344803}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9aec5fcf-a57f-59cb-ba8e-4d66452e89ff\" :question/math-academy-id \"q-7469\" :question/problem \"Express $\\\\sqrt{5}-2\\\\sqrt{5}{\\\\sin }^{2}⁡{42}^{∘}$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n\\\\sqrt{5}(1-2{\\\\sin }^{2}⁡{42}^{∘})\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={42}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡{42}^{∘} & =\\\\operatorname{cos}⁡(2\\\\cdot {42}^{∘})=\\\\operatorname{cos}⁡{84}^{∘}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}\\\\sqrt{5}(1-2{\\\\sin }^{2}⁡{42}^{∘}) & =\\\\sqrt{5}\\\\operatorname{cos}⁡{84}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186345262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4a0075a5-c212-5332-8254-ebacab091f7b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{44}^{∘}\" :db/id 17592186342847} {:answer/id #uuid \"579bc87b-bc15-55d2-9b88-65df7df9f603\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{sin}⁡{22}^{∘}\\\\operatorname{cos}⁡{22}^{∘}\" :db/id 17592186342969} {:answer/id #uuid \"83360fb2-68cd-5170-8292-0cf16f4cf726\" :answer/type {:db/ident :answer.type/math} :answer/value \"{\\\\cos }^{2}⁡{44}^{∘}\" :db/id 17592186343361} {:answer/id #uuid \"dd6b13d2-42b5-583d-8200-ed5b37808ec0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sin}⁡{44}^{∘}\" :db/id 17592186344182} {:answer/id #uuid \"fb1a1f8b-f9f2-5fba-9b53-4159efa314f6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sin}⁡{25}^{∘}\\\\operatorname{cos}⁡{25}^{∘}\" :db/id 17592186344446}] :answer-field/correct {:answer/id #uuid \"4a0075a5-c212-5332-8254-ebacab091f7b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cos}⁡{44}^{∘}\" :db/id 17592186342847} :answer-field/id #uuid \"f6797f23-b08c-5f40-9334-1a28a80d78c8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344925}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ec9090ba-bb1f-5578-9f23-889023ae580e\" :question/math-academy-id \"q-7692\" :question/problem \"Express $2{\\\\cos }^{2}⁡{22}^{∘}-1$ as a single trigonometric ratio.\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n2{\\\\cos }^{2}⁡x-1=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={22}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}2{\\\\cos }^{2}⁡{22}^{∘}-1 & =\\\\operatorname{cos}⁡2\\\\cdot {22}^{∘} \\\\\\\\  & =\\\\operatorname{cos}⁡{44}^{∘}.\\\\end{aligned}\\n$$\"} {:db/id 17592186345263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"495e48ba-ce0b-5f17-9ea9-3c0de9b87b3f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\operatorname{cos}⁡{72}^{∘}\" :db/id 17592186342842} {:answer/id #uuid \"4cc794e6-518e-5201-985b-480d78134e14\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\operatorname{cos}⁡{72}^{∘}\" :db/id 17592186342871} {:answer/id #uuid \"5613601b-b3de-5ec9-9972-06ec89e5e450\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sin}⁡{36}^{∘}\\\\operatorname{cos}⁡{36}^{∘}\" :db/id 17592186342953} {:answer/id #uuid \"7df81b43-af34-5fec-9846-aa94d12fc04a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{cos}⁡{72}^{∘}\" :db/id 17592186343324} {:answer/id #uuid \"df7d4368-b9c7-5c78-b289-897f34af8392\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{sin}⁡{36}^{∘}\\\\operatorname{cos}⁡{36}^{∘}\" :db/id 17592186344197}] :answer-field/correct {:answer/id #uuid \"495e48ba-ce0b-5f17-9ea9-3c0de9b87b3f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\operatorname{cos}⁡{72}^{∘}\" :db/id 17592186342842} :answer-field/id #uuid \"aed55220-229f-5342-afae-df2331b04920\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344797}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"cee7273b-130f-5592-b575-ba77e49e3d09\" :question/math-academy-id \"q-7693\" :question/problem \"Express $$\\n\\\\displaystyle \\\\frac{1}{4}-\\\\frac{1}{2}{\\\\sin }^{2}⁡{36}^{∘}\\n$$ as a single trigonometric ratio.\" :question/worked-solution \"Our expression can be factored as follows:\\n\\n$$\\n\\\\frac{1}{4}(1-2{\\\\sin }^{2}⁡{36}^{∘})\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={36}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡{36}^{∘} & =\\\\operatorname{cos}⁡(2\\\\cdot {36}^{∘})=\\\\operatorname{cos}⁡{72}^{∘}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\frac{1}{4}(1-2{\\\\sin }^{2}⁡{36}^{∘})=\\\\frac{1}{4}\\\\operatorname{cos}⁡{72}^{∘}.\\n$$\"} {:db/id 17592186345265 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"25ab01e5-b620-5d49-a5fa-89fdab0e8924\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{sin}⁡{45}^{∘}\\\\operatorname{cos}⁡{45}^{∘}\" :db/id 17592186342555} {:answer/id #uuid \"29bc2584-7a26-5fbb-b03c-689a525b5a49\" :answer/type {:db/ident :answer.type/math} :answer/value \"{\\\\cos }^{2}⁡{90}^{∘}\" :db/id 17592186342588} {:answer/id #uuid \"c26ac6e7-ac03-5975-891c-ce