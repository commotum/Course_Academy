 \"45c964ec-d9d3-5b26-a133-4f4905e552aa\"] [:db/ensure \"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/validate] [:db/add \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/id #uuid \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\"] [:db/add \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/problem \"Express $-\\\\frac{3}{2}\\\\sin^2\\\\left(79^\\\\circ\\\\right)+\\\\frac{3}{4}$ as a single trigonometric ratio.\"] [:db/add \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&-\\\\frac{3}{2}\\\\sin^2\\\\left(79^\\\\circ\\\\right)+\\\\frac{3}{4}\\\\\\\\&=\\\\frac{3}{4}\\\\left(1-2\\\\sin^2\\\\left(79^\\\\circ\\\\right)\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=79^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(79^\\\\circ\\\\right)&=\\\\cos\\\\left(2\\\\cdot 79^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(158^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{3}{4}\\\\left(1-2\\\\sin^2\\\\left(79^\\\\circ\\\\right)\\\\right)&=\\\\frac{3}{4}\\\\cos\\\\left(158^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"] [:db/add \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/difficulty :question.difficulty/hard] [:db/add \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/answer-fields \"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\"] [:db/ensure \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/validate] [:db/add 17592186087670 :knowledge-point/questions \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\"] [:db/add \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/id #uuid \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\"] [:db/add \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/type :answer.type/math] [:db/add \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/value \"\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\"] [:db/ensure \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/validate] [:db/add \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/id #uuid \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\"] [:db/add \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/type :answer.type/math] [:db/add \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/value \"\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\"] [:db/ensure \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/validate] [:db/add \"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/id #uuid \"9f321728-cc53-5dc4-ac15-8dbba49136f4\"] [:db/add \"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/type :answer.type/math] [:db/add \"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/value \"\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{2}\\\\right)\"] [:db/ensure \"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/validate] [:db/add \"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/id #uuid \"4433b41b-7014-5f96-9527-4b715a2252e7\"] [:db/add \"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/type :answer.type/math] [:db/add \"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/value \"\\\\frac{1}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\"] [:db/ensure \"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/validate] [:db/add \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/id #uuid \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\"] [:db/add \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/type :answer.type/math] [:db/add \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/value \"\\\\frac{4}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\"] [:db/ensure \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/validate] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/id #uuid \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/key \"selection\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/type :answer-field.type/radio] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"9f321728-cc53-5dc4-ac15-8dbba49136f4\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"4433b41b-7014-5f96-9527-4b715a2252e7\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\"] [:db/add \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/correct \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\"] [:db/ensure \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/validate] [:db/add \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/id #uuid \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\"] [:db/add \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/problem \"Express $\\\\frac{2}{3}-\\\\frac{4}{3}\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)$ as a single trigonometric ratio.\"] [:db/add \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\frac{2}{3}-\\\\frac{4}{3}\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\frac{2}{3}\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{15\\\\pi}{8}$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)&=\\\\cos\\\\left(2\\\\cdot \\\\frac{15\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{2}{3}\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\\\\right)&=\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\"] [:db/add \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/difficulty :question.difficulty/hard] [:db/add \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/answer-fields \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\"] [:db/ensure \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/validate] [:db/add 17592186087670 :knowledge-point/questions \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\"] [:db/add \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/id #uuid \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\"] [:db/add \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/type :answer.type/math] [:db/add \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(183^\\\\circ\\\\right)\"] [:db/ensure \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/validate] [:db/add \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/id #uuid \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\"] [:db/add \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/type :answer.type/math] [:db/add \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(61^\\\\circ\\\\right)\"] [:db/ensure \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/validate] [:db/add \"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/id #uuid \"313982ed-9ff4-5943-846d-5656b6c49e9e\"] [:db/add \"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/type :answer.type/math] [:db/add \"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/value \"\\\\frac{6}{5}\\\\cos\\\\left(244^\\\\circ\\\\right)\"] [:db/ensure \"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/validate] [:db/add \"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/id #uuid \"70626ff1-ed24-5be3-9574-607588fb40d2\"] [:db/add \"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/type :answer.type/math] [:db/add \"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(122^\\\\circ\\\\right)\"] [:db/ensure \"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/validate] [:db/add \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/id #uuid \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\"] [:db/add \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/type :answer.type/math] [:db/add \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/value \"\\\\frac{3}{10}\\\\cos\\\\left(61^\\\\circ\\\\right)\"] [:db/ensure \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/validate] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/id #uuid \"979720b9-50f7-5e65-a3b2-d14471eaad53\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/key \"selection\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/type :answer-field.type/radio] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/choices \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/choices \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/choices \"313982ed-9ff4-5943-846d-5656b6c49e9e\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/choices \"70626ff1-ed24-5be3-9574-607588fb40d2\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/choices \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\"] [:db/add \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/correct \"70626ff1-ed24-5be3-9574-607588fb40d2\"] [:db/ensure \"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/validate] [:db/add \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\" :question/id #uuid \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\"] [:db/add \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\" :question/problem \"Express $-\\\\frac{3}{5}+\\\\frac{6}{5}\\\\cos^2\\\\left(61^\\\\circ\\\\right)$ as a single trigonometric ratio.\"] [:db/add \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&-\\\\frac{3}{5}+\\\\frac{6}{5}\\\\cos^2\\\\left(61^\\\\circ\\\\right)\\\\\\\\&=\\\\frac{3}{5}\\\\left(2\\\\cos^2\\\\left(61^\\\\circ\\\\right)-1\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=61^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(61^\\\\circ\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot 61^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(122^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{3}{5}\\\\left(2\\\\cos^2\\\\left(61^\\\\circ\\\\right)-1\\\\right)&=\\\\frac{3}{5}\\\\cos\\\\left(122^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"] [:db/add \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\" :question/difficulty :question.difficulty/hard] [:db/add \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\" :question/answer-fields \"979720b9-50f7-5e65-a3b2-d14471eaad53\"] [:db/ensure \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\" :question/validate] [:db/add 17592186087670 :knowledge-point/questions \"8ea35b13-cb72-5c11-87ad-d3a9b0bb402c\"] [:db/add \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/id #uuid \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\"] [:db/add \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/type :answer.type/math] [:db/add \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(\\\\frac{13\\\\pi}{20}\\\\right)\"] [:db/ensure \"d2c015e0-a3c6-58c4-abc5-32e116e6a55c\" :answer/validate] [:db/add \"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/id #uuid \"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\"] [:db/add \"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/type :answer.type/math] [:db/add \"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/value \"\\\\frac{3}{2}\\\\cos\\\\left(\\\\frac{26\\\\pi}{5}\\\\right)\"] [:db/ensure \"64554ef4-7e90-52b9-b8ed-2ade5c876b2b\" :answer/validate] [:db/add \"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/id #uuid \"b2845e58-c1ab-5faf-91d8-9b133de33333\"] [:db/add \"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/type :answer.type/math] [:db/add \"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/value \"\\\\frac{3}{8}\\\\cos\\\\left(\\\\frac{13\\\\pi}{5}\\\\right)\"] [:db/ensure \"b2845e58-c1ab-5faf-91d8-9b133de33333\" :answer/validate] [:db/add \"3bab5e