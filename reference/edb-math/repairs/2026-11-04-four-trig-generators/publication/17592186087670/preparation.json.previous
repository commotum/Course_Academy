a56-50d3-bae8-d09b33cf69fb\"] [\"704aaac6-3da7-5b8f-8f00-7ae5b84b9ef0\" :answer-field/correct \"dec005cc-9a56-50d3-bae8-d09b33cf69fb\"] [\"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\" :question/id #uuid \"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\"] [\"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\" :question/problem \"Express $2\\\\cos^2\\\\left(137^\\\\circ\\\\right)-1$ as a single trigonometric ratio.\"] [\"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\" :question/worked-solution \"Use the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=137^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(137^\\\\circ\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot 137^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(274^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"] [\"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\" :question/difficulty :question.difficulty/easy] [\"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\" :question/answer-fields \"704aaac6-3da7-5b8f-8f00-7ae5b84b9ef0\"] [17592186087670 :knowledge-point/questions \"64f9cd10-e45d-5ea3-a088-7bb27e08cc19\"] [\"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/id #uuid \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\"] [\"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/type :answer.type/math] [\"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/value \"4\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\"] [\"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/id #uuid \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\"] [\"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/type :answer.type/math] [\"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/value \"8\\\\cos\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\"] [\"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/id #uuid \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\"] [\"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/type :answer.type/math] [\"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/value \"8\\\\cos\\\\left(\\\\frac{80\\\\pi}{11}\\\\right)\"] [\"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/id #uuid \"003a8c02-0475-5d35-baac-3401efd06b33\"] [\"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/type :answer.type/math] [\"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/value \"4\\\\cos\\\\left(\\\\frac{10\\\\pi}{11}\\\\right)\"] [\"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/id #uuid \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\"] [\"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/type :answer.type/math] [\"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/value \"8\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/id #uuid \"6411acf6-4a8e-553a-817b-36a87f3caef9\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/key \"selection\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/type :answer-field.type/radio] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"003a8c02-0475-5d35-baac-3401efd06b33\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\"] [\"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/correct \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\"] [\"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/id #uuid \"53cc34ab-8f6b-5502-9175-b06d82df6a79\"] [\"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/problem \"Express $4-8\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)$ as a single trigonometric ratio.\"] [\"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&4-8\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\\\\\\\\&=4\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{20\\\\pi}{11}$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)&=\\\\cos\\\\left(2\\\\cdot \\\\frac{20\\\\pi}{11}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n4\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\\\\right)&=4\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\\n\\\\end{aligned}\\n$$\"] [\"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/difficulty :question.difficulty/moderate] [\"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/answer-fields \"6411acf6-4a8e-553a-817b-36a87f3caef9\"] [17592186087670 :knowledge-point/questions \"53cc34ab-8f6b-5502-9175-b06d82df6a79\"] [\"729e4888-4af1-5397-9027-644e418f8cea\" :answer/id #uuid \"729e4888-4af1-5397-9027-644e418f8cea\"] [\"729e4888-4af1-5397-9027-644e418f8cea\" :answer/type :answer.type/math] [\"729e4888-4af1-5397-9027-644e418f8cea\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{16}\\\\right)\"] [\"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/id #uuid \"5a865bf9-6921-5afa-85b2-156b71cb01de\"] [\"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/type :answer.type/math] [\"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{3\\\\pi}{8}\\\\right)\"] [\"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/id #uuid \"1166d582-f2ec-5899-b9b0-396d597892ea\"] [\"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/type :answer.type/math] [\"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/value \"\\\\frac{6}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\"] [\"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/id #uuid \"36888c5f-64af-5794-8ad1-feade4a7c65b\"] [\"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/type :answer.type/math] [\"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/value \"\\\\frac{6}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\"] [\"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/id #uuid \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\"] [\"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/type :answer.type/math] [\"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/id #uuid \"eaa71578-03fb-575f-8906-11908fee236f\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/key \"selection\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/type :answer-field.type/radio] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"729e4888-4af1-5397-9027-644e418f8cea\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"5a865bf9-6921-5afa-85b2-156b71cb01de\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"1166d582-f2ec-5899-b9b0-396d597892ea\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"36888c5f-64af-5794-8ad1-feade4a7c65b\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\"] [\"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/correct \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\"] [\"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/id #uuid \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\"] [\"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/problem \"Express $-\\\\frac{3}{5}+\\\\frac{6}{5}\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)$ as a single trigonometric ratio.\"] [\"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&-\\\\frac{3}{5}+\\\\frac{6}{5}\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\frac{3}{5}\\\\left(2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)-1\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{\\\\pi}{8}$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot \\\\frac{\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{3}{5}\\\\left(2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)-1\\\\right)&=\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\"] [\"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/difficulty :question.difficulty/hard] [\"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/answer-fields \"eaa71578-03fb-575f-8906-11908fee236f\"] [17592186087670 :knowledge-point/questions \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\"] [\"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/id #uuid \"e9905e99-1b3c-563a-aa11-f1433d102d1d\"] [\"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/type :answer.type/math] [\"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/value \"\\\\frac{3}{2}\\\\cos\\\\left(316^\\\\circ\\\\right)\"] [\"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/id #uuid \"45c964ec-d9d3-5b26-a133-4f4905e552aa\"] [\"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/type :answer.type/math] [\"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(158^\\\\circ\\\\right)\"] [\"6e84df50-b16e-51a2-892c-de1786993f5a\" :answer/id #uuid \"6e84df50-b16e-51a2-892c-de1786993f5a\"] [\"6e84df50-b16e-51a2-892c-de1786993f5a\" :answer/type :answer.type/math] [\"6e84df50-b16e-51a2-892c-de1786993f5a\" :answer/value \"\\\\frac{3}{8}\\\\cos\\\\left(158^\\\\circ\\\\right)\"] [\"040173b1-17de-51ae-8a5d-b41f6b4f6d12\" :answer/id #uuid \"040173b1-17de-51ae-8a5d-b41f6b4f6d12\"] [\"040173b1-17de-51ae-8a5d-b41f6b4f6d12\" :answer/type :answer.type/math] [\"040173b1-17de-51ae-8a5d-b41f6b4f6d12\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(316^\\\\circ\\\\right)\"] [\"0653aec1-e980-54f8-947e-f3790af5c72f\" :answer/id #uuid \"0653aec1-e980-54f8-947e-f3790af5c72f\"] [\"0653aec1-e980-54f8-947e-f3790af5c72f\" :answer/type :answer.type/math] [\"0653aec1-e980-54f8-947e-f3790af5c72f\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(79^\\\\circ\\\\right)\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/id #uuid \"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/key \"selection\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/type :answer-field.type/radio] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/choices \"e9905e99-1b3c-563a-aa11-f1433d102d1d\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/choices \"45c964ec-d9d3-5b26-a133-4f4905e552aa\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/choices \"6e84df50-b16e-51a2-892c-de1786993f5a\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/choices \"040173b1-17de-51ae-8a5d-b41f6b4f6d12\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/choices \"0653aec1-e980-54f8-947e-f3790af5c72f\"] [\"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\" :answer-field/correct \"45c964ec-d9d3-5b26-a133-4f4905e552aa\"] [\"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/id #uuid \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\"] [\"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/problem \"Express $-\\\\frac{3}{2}\\\\sin^2\\\\left(79^\\\\circ\\\\right)+\\\\frac{3}{4}$ as a single trigonometric ratio.\"] [\"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&-\\\\frac{3}{2}\\\\sin^2\\\\left(79^\\\\circ\\\\right)+\\\\frac{3}{4}\\\\\\\\&=\\\\frac{3}{4}\\\\left(1-2\\\\sin^2\\\\left(79^\\\\circ\\\\right)\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=79^\\\\circ$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(79^\\\\circ\\\\right)&=\\\\cos\\\\left(2\\\\cdot 79^\\\\circ\\\\right)\\\\\\\\&=\\\\cos\\\\left(158^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{3}{4}\\\\left(1-2\\\\sin^2\\\\left(79^\\\\circ\\\\right)\\\\right)&=\\\\frac{3}{4}\\\\cos\\\\left(158^\\\\circ\\\\right)\\n\\\\end{aligned}\\n$$\"] [\"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/difficulty :question.difficulty/hard] [\"90114c66-7fd4-5a3c-924e-bfa8ab05846d\" :question/answer-fields \"a0b344d5-dc9f-5c4f-baf0-52ab19de9f5e\"] [17592186087670 :knowledge-point/questions \"90114c66-7fd4-5a3c-924e-bfa8ab05846d\"] [\"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/id #uuid \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\"] [\"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/type :answer.type/math] [\"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\" :answer/value \"\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\"] [\"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/id #uuid \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\"] [\"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/type :answer.type/math] [\"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\" :answer/value \"\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\"] [\"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/id #uuid \"9f321728-cc53-5dc4-ac15-8dbba49136f4\"] [\"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/type :answer.type/math] [\"9f321728-cc53-5dc4-ac15-8dbba49136f4\" :answer/value \"\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{2}\\\\right)\"] [\"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/id #uuid \"4433b41b-7014-5f96-9527-4b715a2252e7\"] [\"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/type :answer.type/math] [\"4433b41b-7014-5f96-9527-4b715a2252e7\" :answer/value \"\\\\frac{1}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\"] [\"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/id #uuid \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\"] [\"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/type :answer.type/math] [\"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\" :answer/value \"\\\\frac{4}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/id #uuid \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/key \"selection\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/type :answer-field.type/radio] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"3b4e0a0e-7f16-5a7d-ac73-1c421219f61c\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"9f321728-cc53-5dc4-ac15-8dbba49136f4\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"4433b41b-7014-5f96-9527-4b715a2252e7\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/choices \"bd5b3f17-d893-598b-86dc-34ae6f02ea3f\"] [\"4a2f71b9-a0f6-53fb-8405-8d0d50228688\" :answer-field/correct \"e4f1f926-58cf-521f-8b52-b6d0c36f45e5\"] [\"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/id #uuid \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\"] [\"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/problem \"Express $\\\\frac{2}{3}-\\\\frac{4}{3}\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)$ as a single trigonometric ratio.\"] [\"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\frac{2}{3}-\\\\frac{4}{3}\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\frac{2}{3}\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{15\\\\pi}{8}$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)&=\\\\cos\\\\left(2\\\\cdot \\\\frac{15\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{2}{3}\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{15\\\\pi}{8}\\\\right)\\\\right)&=\\\\frac{2}{3}\\\\cos\\\\left(\\\\frac{15\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\"] [\"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/difficulty :question.difficulty/hard] [\"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\" :question/answer-fields \"4a2f71b9-a0f6-53fb-8405-8d0d50228688\"] [17592186087670 :knowledge-point/questions \"e35eacaf-be9a-53a1-bb9d-ba4a75053b16\"] [\"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/id #uuid \"a9e66256-732f-5a65-9e8d-405b2e19c3f2\"] [\"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/type :answer.type/math] [\"a9e66256-732f-5a65-9e8d-405b2e19c3f2\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(183^\\\\circ\\\\right)\"] [\"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/id #uuid \"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\"] [\"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/type :answer.type/math] [\"66e7ed88-bcc6-5e63-a2c1-758726c59ba5\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(61^\\\\circ\\\\right)\"] [\"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/id #uuid \"313982ed-9ff4-5943-846d-5656b6c49e9e\"] [\"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/type :answer.type/math] [\"313982ed-9ff4-5943-846d-5656b6c49e9e\" :answer/value \"\\\\frac{6}{5}\\\\cos\\\\left(244^\\\\circ\\\\right)\"] [\"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/id #uuid \"70626ff1-ed24-5be3-9574-607588fb40d2\"] [\"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/type :answer.type/math] [\"70626ff1-ed24-5be3-9574-607588fb40d2\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(122^\\\\circ\\\\right)\"] [\"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/id #uuid \"78163e91-fb5a-560f-ac2d-b35df6e91a0c\"] [\"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/type :answer.type/math] [\"78163e91-fb5a-560f-ac2d-b35df6e91a0c\" :answer/value \"\\\\frac{3}{10}\\\\cos\\\\left(61^\\\\circ\\\\right)\"] [\"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/id #uuid \"979720b9-50f7-5e65-a3b2-d14471eaad53\"] [\"979720b9-50f7-5e65-a3b2-d14471eaad53\" :answer-field/key \"selection\"] [\"979720b9-50f7-5e