5d-5ea3-a088-7bb27e08cc19\"] [:db/add \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/id #uuid \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\"] [:db/add \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/type :answer.type/math] [:db/add \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/value \"4\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\"] [:db/ensure \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\" :answer/validate] [:db/add \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/id #uuid \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\"] [:db/add \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/type :answer.type/math] [:db/add \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/value \"8\\\\cos\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\"] [:db/ensure \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\" :answer/validate] [:db/add \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/id #uuid \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\"] [:db/add \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/type :answer.type/math] [:db/add \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/value \"8\\\\cos\\\\left(\\\\frac{80\\\\pi}{11}\\\\right)\"] [:db/ensure \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\" :answer/validate] [:db/add \"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/id #uuid \"003a8c02-0475-5d35-baac-3401efd06b33\"] [:db/add \"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/type :answer.type/math] [:db/add \"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/value \"4\\\\cos\\\\left(\\\\frac{10\\\\pi}{11}\\\\right)\"] [:db/ensure \"003a8c02-0475-5d35-baac-3401efd06b33\" :answer/validate] [:db/add \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/id #uuid \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\"] [:db/add \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/type :answer.type/math] [:db/add \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/value \"8\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\"] [:db/ensure \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\" :answer/validate] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/id #uuid \"6411acf6-4a8e-553a-817b-36a87f3caef9\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/key \"selection\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/type :answer-field.type/radio] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"1a72d538-78d1-5a19-8688-44ab99fbc4b5\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"eb56dbcf-a233-52f7-bc65-cb87a2fbbd66\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"003a8c02-0475-5d35-baac-3401efd06b33\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/choices \"0fb96a78-f61b-59c9-a059-bf229fec2b3d\"] [:db/add \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/correct \"ac5ee1ab-7631-554d-ba30-a2fbe7d80262\"] [:db/ensure \"6411acf6-4a8e-553a-817b-36a87f3caef9\" :answer-field/validate] [:db/add \"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/id #uuid \"53cc34ab-8f6b-5502-9175-b06d82df6a79\"] [:db/add \"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/problem \"Express $4-8\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)$ as a single trigonometric ratio.\"] [:db/add \"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&4-8\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\\\\\\\\&=4\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n1-2\\\\sin^2 x=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{20\\\\pi}{11}$:\\n\\n$$\\n\\\\begin{aligned}\\n1-2\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)&=\\\\cos\\\\left(2\\\\cdot \\\\frac{20\\\\pi}{11}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n4\\\\left(1-2\\\\sin^2\\\\left(\\\\frac{20\\\\pi}{11}\\\\right)\\\\right)&=4\\\\cos\\\\left(\\\\frac{40\\\\pi}{11}\\\\right)\\n\\\\end{aligned}\\n$$\"] [:db/add \"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/difficulty :question.difficulty/moderate] [:db/add \"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/answer-fields \"6411acf6-4a8e-553a-817b-36a87f3caef9\"] [:db/ensure \"53cc34ab-8f6b-5502-9175-b06d82df6a79\" :question/validate] [:db/add 17592186087670 :knowledge-point/questions \"53cc34ab-8f6b-5502-9175-b06d82df6a79\"] [:db/add \"729e4888-4af1-5397-9027-644e418f8cea\" :answer/id #uuid \"729e4888-4af1-5397-9027-644e418f8cea\"] [:db/add \"729e4888-4af1-5397-9027-644e418f8cea\" :answer/type :answer.type/math] [:db/add \"729e4888-4af1-5397-9027-644e418f8cea\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{16}\\\\right)\"] [:db/ensure \"729e4888-4af1-5397-9027-644e418f8cea\" :answer/validate] [:db/add \"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/id #uuid \"5a865bf9-6921-5afa-85b2-156b71cb01de\"] [:db/add \"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/type :answer.type/math] [:db/add \"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{3\\\\pi}{8}\\\\right)\"] [:db/ensure \"5a865bf9-6921-5afa-85b2-156b71cb01de\" :answer/validate] [:db/add \"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/id #uuid \"1166d582-f2ec-5899-b9b0-396d597892ea\"] [:db/add \"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/type :answer.type/math] [:db/add \"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/value \"\\\\frac{6}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\"] [:db/ensure \"1166d582-f2ec-5899-b9b0-396d597892ea\" :answer/validate] [:db/add \"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/id #uuid \"36888c5f-64af-5794-8ad1-feade4a7c65b\"] [:db/add \"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/type :answer.type/math] [:db/add \"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/value \"\\\\frac{6}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{2}\\\\right)\"] [:db/ensure \"36888c5f-64af-5794-8ad1-feade4a7c65b\" :answer/validate] [:db/add \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/id #uuid \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\"] [:db/add \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/type :answer.type/math] [:db/add \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/value \"\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\"] [:db/ensure \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\" :answer/validate] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/id #uuid \"eaa71578-03fb-575f-8906-11908fee236f\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/key \"selection\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/type :answer-field.type/radio] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"729e4888-4af1-5397-9027-644e418f8cea\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"5a865bf9-6921-5afa-85b2-156b71cb01de\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"1166d582-f2ec-5899-b9b0-396d597892ea\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"36888c5f-64af-5794-8ad1-feade4a7c65b\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/choices \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\"] [:db/add \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/correct \"142ced94-8ed7-5ca8-9ca2-c0b51b9b765d\"] [:db/ensure \"eaa71578-03fb-575f-8906-11908fee236f\" :answer-field/validate] [:db/add \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/id #uuid \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\"] [:db/add \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/problem \"Express $-\\\\frac{3}{5}+\\\\frac{6}{5}\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)$ as a single trigonometric ratio.\"] [:db/add \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/worked-solution \"Collect the common factor:\\n\\n$$\\n\\\\begin{aligned}\\n&-\\\\frac{3}{5}+\\\\frac{6}{5}\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\frac{3}{5}\\\\left(2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)-1\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nUse the alternative cosine double-angle formula:\\n\\n$$\\n2\\\\cos^2 x-1=\\\\cos(2x)\\n$$\\n\\nSubstitute $x=\\\\frac{\\\\pi}{8}$:\\n\\n$$\\n\\\\begin{aligned}\\n2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)-1&=\\\\cos\\\\left(2\\\\cdot \\\\frac{\\\\pi}{8}\\\\right)\\\\\\\\&=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\\n\\nKeep the outside factor:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\frac{3}{5}\\\\left(2\\\\cos^2\\\\left(\\\\frac{\\\\pi}{8}\\\\right)-1\\\\right)&=\\\\frac{3}{5}\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\n\\\\end{aligned}\\n$$\"] [:db/add \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/difficulty :question.difficulty/hard] [:db/add \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/answer-fields \"eaa71578-03fb-575f-8906-11908fee236f\"] [:db/ensure \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\" :question/validate] [:db/add 17592186087670 :knowledge-point/questions \"f0cb6707-abd4-5620-9a54-30969bf2ef4b\"] [:db/add \"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/id #uuid \"e9905e99-1b3c-563a-aa11-f1433d102d1d\"] [:db/add \"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/type :answer.type/math] [:db/add \"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/value \"\\\\frac{3}{2}\\\\cos\\\\left(316^\\\\circ\\\\right)\"] [:db/ensure \"e9905e99-1b3c-563a-aa11-f1433d102d1d\" :answer/validate] [:db/add \"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/id #uuid \"45c964ec-d9d3-5b26-a133-4f4905e552aa\"] [:db/add \"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/type :answer.type/math] [:db/add \"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/value \"\\\\frac{3}{4}\\\\cos\\\\left(158^\\\\circ\\\\right)\"] [:db/ensure \"45c964ec-d9d3-5b26-a133-4f4905e552aa\" :answer/validate] [:db/add \"6e84df50-b16e-51a2-892c-de1786993f5a\" :answer/id #uuid \"6e84df50-b16e-51