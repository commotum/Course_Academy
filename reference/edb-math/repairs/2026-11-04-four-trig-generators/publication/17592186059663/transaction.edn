tion.difficulty/easy] [:db/add "9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede" :question/answer-fields "0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c"] [:db/ensure "9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede" :question/validate] [:db/add 17592186059663 :knowledge-point/questions "9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede"] [:db/add "d51fbaff-db6c-532c-91ae-221bc107b5cb" :answer/id #uuid "d51fbaff-db6c-532c-91ae-221bc107b5cb"] [:db/add "d51fbaff-db6c-532c-91ae-221bc107b5cb" :answer/type :answer.type/math] [:db/add "d51fbaff-db6c-532c-91ae-221bc107b5cb" :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}"] [:db/ensure "d51fbaff-db6c-532c-91ae-221bc107b5cb" :answer/validate] [:db/add "8a1960a0-a775-5727-b272-1e71a456bbc8" :answer/id #uuid "8a1960a0-a775-5727-b272-1e71a456bbc8"] [:db/add "8a1960a0-a775-5727-b272-1e71a456bbc8" :answer/type :answer.type/math] [:db/add "8a1960a0-a775-5727-b272-1e71a456bbc8" :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}"] [:db/ensure "8a1960a0-a775-5727-b272-1e71a456bbc8" :answer/validate] [:db/add "7d31c6fd-fa3b-5c20-a588-31868760db38" :answer/id #uuid "7d31c6fd-fa3b-5c20-a588-31868760db38"] [:db/add "7d31c6fd-fa3b-5c20-a588-31868760db38" :answer/type :answer.type/math] [:db/add "7d31c6fd-fa3b-5c20-a588-31868760db38" :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}"] [:db/ensure "7d31c6fd-fa3b-5c20-a588-31868760db38" :answer/validate] [:db/add "1b92844d-d398-59d6-a2e1-f653b49272c8" :answer/id #uuid "1b92844d-d398-59d6-a2e1-f653b49272c8"] [:db/add "1b92844d-d398-59d6-a2e1-f653b49272c8" :answer/type :answer.type/math] [:db/add "1b92844d-d398-59d6-a2e1-f653b49272c8" :answer/value "-\\frac{\\sqrt{2}}{4}"] [:db/ensure "1b92844d-d398-59d6-a2e1-f653b49272c8" :answer/validate] [:db/add "935b0f5f-3361-5310-a38f-fc697db347f7" :answer/id #uuid "935b0f5f-3361-5310-a38f-fc697db347f7"] [:db/add "935b0f5f-3361-5310-a38f-fc697db347f7" :answer/type :answer.type/math] [:db/add "935b0f5f-3361-5310-a38f-fc697db347f7" :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}"] [:db/ensure "935b0f5f-3361-531