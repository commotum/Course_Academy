d/correct "d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8"] [:db/ensure "571f1b76-037f-5240-bb60-808689501b48" :answer-field/validate] [:db/add "2ed50138-474a-54c5-b601-b5f1bfa8af7f" :question/id #uuid "2ed50138-474a-54c5-b601-b5f1bfa8af7f"] [:db/add "2ed50138-474a-54c5-b601-b5f1bfa8af7f" :question/problem "What is the exact value of $\\sin\\left(-165^\\circ\\right)$ without using a calculator?"] [:db/add "2ed50138-474a-54c5-b601-b5f1bfa8af7f" :question/worked-solution "Write the angle as a sum or difference of special angles: $-165^\\circ=60^\\circ-225^\\circ$.\n\nRecall the difference formula for sine:\n\n$$\n\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(-165^\\circ\\right) &=\\sin\\left(60^\\circ-225^\\circ\\right) \\\\ &=\\sin\\left(60^\\circ\\right)\\cos\\left(225^\\circ\\right)-\\cos\\left(60^\\circ\\right)\\sin\\left(225^\\circ\\right) \\\\ &=\\frac{\\sqrt{3}}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right)-\\frac{1}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\ &=-\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\ &=\\frac{-\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"] [:db/add "2ed50138-474a-54c5-b601-b5f1bfa8af7f" :question/difficulty :question.difficulty/hard] [:db/add "2ed50138-474a-54c5-b601-b5f1bfa8af7f" :question/answer-fields "571f1b76-037f-5240-bb60-808689501b48"] [:db/ensure "2ed50138-474a-54c5-b601-b5f1bfa8af7f" :question/validate] [:db/add 17592186059663 :knowledge-point/questions "2ed50138-474a-54c5-b601-b5f1bfa8af7f"] [:db/add "c29e7d0e-de17-5fe2-86c0-4ac18597b758" :answer/id #uuid "c29e7d0e-de17-5fe2-86c0-4ac18597b758"] [:db/add "c29e7d0e-de17-5fe2-86c0-4ac18597b758" :answer/type :answer.type/math] [:db/add "c29e7d0e-de17-5fe2-86c0-4ac18597b758" :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}"] [:db/ensure "c29e7d0e-de17-5fe2-86c0-4ac18597b758" :answer/validate] [:db/add "4ecccc80-8efb-57e7-8ee3-68cd021572c8" :answer/id #uuid "4ecccc80-8efb-57e7-8ee3-68cd021