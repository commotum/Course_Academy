\frac{\\pi}{4}\\right) \\\\ &=\\frac{1}{2}\\cdot \\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\ &=\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{-\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"] [:db/add "108f6809-67db-598a-a6ac-2051b41ce05f" :question/difficulty :question.difficulty/easy] [:db/add "108f6809-67db-598a-a6ac-2051b41ce05f" :question/answer-fields "18dedcb5-d9e9-53f6-8bce-e8a2addf29d9"] [:db/ensure "108f6809-67db-598a-a6ac-2051b41ce05f" :question/validate] [:db/add 17592186059663 :knowledge-point/questions "108f6809-67db-598a-a6ac-2051b41ce05f"] [:db/add "2e12a23d-3ec7-564d-b54e-448020535812" :answer/id #uuid "2e12a23d-3ec7-564d-b54e-448020535812"] [:db/add "2e12a23d-3ec7-564d-b54e-448020535812" :answer/type :answer.type/math] [:db/add "2e12a23d-3ec7-564d-b54e-448020535812" :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}"] [:db/ensure "2e12a23d-3ec7-564d-b54e-448020535812" :answer/validate] [:db/add "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd" :answer/id #uuid "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd"] [:db/add "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd" :answer/type :answer.type/math] [:db/add "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd" :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}"] [:db/ensure "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd" :answer/validate] [:db/add "0c30c185-f053-5d30-bf51-ec95638b3b42" :answer/id #uuid "0c30c185-f053-5d30-bf51-ec95638b3b42"] [:db/add "0c30c185-f053-5d30-bf51-ec95638b3b42" :answer/type :answer.type/math] [:db/add "0c30c185-f053-5d30-bf51-ec95638b3b42" :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}"] [:db/ensure "0c30c185-f053-5d30-bf51-ec95638b3b42" :answer/validate] [:db/add "2ed7219d-ebc9-530c-bb69-6e716bb5edb2" :answer/id #uuid "2ed7219d-ebc9-530c-bb69-6e716bb5edb2"] [:db/add "2ed7219d-ebc9-530c-bb69-6e716bb5edb2" :answer/type :answer.type/math] [:db/add "2ed7219d-ebc9-530c-bb69-6e716bb5edb2" :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}"] [:db/ensure "2ed7219d-ebc9-530c-bb69-6e716bb5edb2" :answer/validate] [:db/add "399b88a0-fe1f-5f2b-a021-6dd8da3e2af3" :answer/id #uuid "399b88a0-fe1f-5f2b-a021-6dd8da3e2af3"] [:db/add "399b88a0-fe1f-5f2b-a021-6dd8da3e2af3" :answer/type :answer.type/math] [:db/add "399b88a0-fe1f-5f2b-a021-6dd8da3e2af3" :answer/value "\\frac{\\sqrt{2}}{4}"] [:db/ensure "399b88a0-fe1f-5f2b-a021-6dd8da3e2af3" :answer/validate] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/id #uuid "10e6c758-cfed-5a5b-b480-2b004c9aee54"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/key "selection"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/type :answer-field.type/radio] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/choices "2e12a23d-3ec7-564d-b54e-448020535812"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/choices "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/choices "0c30c185-f053-5d30-bf51-ec95638b3b42"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/choices "2ed7219d-ebc9-530c-bb69-6e716bb5edb2"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/choices "399b88a0-fe1f-5f2b-a021-6dd8da3e2af3"] [:db/add "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/correct "ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd"] [:db/ensure "10e6c758-cfed-5a5b-b480-2b004c9aee54" :answer-field/validate] [:db/add "edf66a66-5610-574f-9d8b-7c8d25b2364d" :question/id #uuid "edf66a66-5610-574f-9d8b-7c8d25b2364d"] [:db/add "edf66a66-5610-574f-9d8b-7c8d25b2364d" :question/problem "What is the exact value of $\\sin\\left(\\frac{5\\pi}{12}\\right)$ without using a calculator?\n\n*Hint: Use the fact that $\\frac{5\\pi}{12}=\\frac{\\pi}{6}+\\frac{\\pi}{4}$.*"] [:db/add "edf66a66-5610-574f-9d8b-7c8d25b2364d" :question/worked-solution "Write the angle as a sum or difference of special angles: $\\frac{5\\pi}{12}=\\frac{\\pi}{6}+\\frac{\\pi}{4}$.\n\nRecall the sum formula for sine:\n\n$$\n\\sin(x+y)=\\sin x\\cos y+\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(\\frac{5\\pi}{12}\\right) &=\\sin\\left(\\frac{\\pi}{6}+\\frac{\\pi}{4}\\right) \\\\ &=\\sin\\left(\\frac{\\pi}{6}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)+\\cos\\left(\\frac{\\pi}{6}\\right)\\sin\\left(\\frac{\\pi}{4}\\right) \\\\ &=\\frac{1}{2}\\cdot \\frac{\\sqrt{2}}{2}+\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\ &=\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"] [:db/add "edf66a66-5610-574f-9d8b-7c8d25b2364d" :question/difficulty :question.difficulty/easy] [:db/add "edf66a66-5610-574f-9d8b-7c8d25b2364d" :question/answer-fields "10e6c758-cfed-5a5b-b480-2b004c9aee54"] [:db/ensure "edf66a66-5610-574f-9d8b-7c8d25b2364d" :question/validate] [:db/add 17592186059663 :knowledge-point/questions "edf66a66-5610-574f-9d8b-7c8d25b2364d"] [:db/add "86950b2d-6634-5da1-a406-27b6c01f9486" :answer/id #uuid "86950b2d-6634-5da1-a406-27b6c01f9486"] [:db/add "86950b2d-6634-5da1-a406-27b6c01f9486" :answer/type :answer.type/math] [:db/add "86950b2d-6634-5da1-a406-27b6c01f9486" :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}"] [:db/ensure "86950b2d-6634-5da1-a406-27b6c01f9486" :answer/validate] [:db/add "77f09e1e-0860-5c79-abd7-9814bf3cad99" :answer-field/id #uuid "77f09e1e-0860-5c79-abd7-9814bf3cad99"] [:db/add "77f09e1e-0860-5c79-abd7-9814bf3cad99" :answer-field/key "field-1"] [:db/add "77f09e1e-0860-5c79-abd7-9814bf3cad99" :answer-field/type :answer-field.type/blank] [:db/add "77f09e1e-0860-5c79-abd7-9814bf3cad99" :answer-field/choices "86950b2d-6634-5da1-a406-27b6c01f9486"] [:db/add "77f09e1e-0860-5c79-abd7-9814bf3cad99" :answer-field/correct "86950b2d-6634-5da1-a406-27b6c01f9486"] [:db/ensure "77f09e1e-0860-5c79-abd7-9814bf3cad99" :answer-field/validate] [:db/add "c8da6d15-25b7-5267-8bcb-1931fb1fc352" :question/id #uuid "c8da6d15-25b7-5267-8bcb-1931fb1fc352"] [:db/add "c8da6d15-25b7-5267-8bcb-1931fb1fc352" :question/problem "Using the fact that $105^\\circ=330^\\circ-225^\\circ$, calculate the **exact** value of $\\sin\\left(105^\\circ\\right)$ without a calculator.\n\n$\\sin\\left(105^\\circ\\right)=$ {{field-1}}"] [:db/add "c8da6d15-25b7-5267-8bcb-1931fb1fc352" :question/worked-solution "Write the angle as a sum or difference of special angles: $105^\\circ=330^\\circ-225^\\circ$.\n\nRecall the difference formula for sine:\n\n$$\n\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(105^\\circ\\right) &=\\sin\\left(330^\\circ-225^\\circ\\right) \\\\ &=\\sin\\left(330^\\circ\\right)\\cos\\left(225^\\circ\\right)-\\cos\\left(330^\\circ\\right)\\sin\\left(225^\\circ\\right) \\\\ &=\\left(-\\frac{1}{2}\\right)\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right)-\\frac{\\sqrt{3}}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\ &=\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"] [:db/add "c8da6d15-25b7-5267-8bcb-1931fb1fc352" :question/difficulty :question.difficulty/moderate] [:db/add "c8da6d15-25b7-5267-8bcb-1931fb1fc352" :question/answer-fields "77f09e1e-0860-5c79-abd7-9814bf3cad99"] [:db/ensure "c8da6d15-25b7-5267-8bcb-1931fb1fc352" :question/validate] [:db/add 17592186059663 :knowledge-point/questions "c8da6d15-25b7-5267-8bcb-1931fb1fc352"] [:db/add "1e1c4c69-e862-5b26-9ed6-2e3eaad660bd" :answer/id #uuid "1e1c4c69-e862-5b26-9ed6-2e3eaad660bd"] [:db/add "1e1c4c69-e862-5b26-9ed6-2e3eaad660bd" :answer/type :answer.type/math] [:db/add "1e1c4c69-e862-5b26-9ed6-2e3eaad660bd" :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}"] [:db/ensure "1e1c4c69-e862-5b26-9ed6-2e3eaad660bd" :answer/validate] [:db/add "1decae6a-9bf0-55b8-bce2-aee9c74aa17e" :answer/id #uuid "1decae6a-9bf0-55b8-bce2-aee9c74aa17e"] [:db/add "1decae6a-9bf0-55b8-bce2-aee9c74aa17e" :answer/type :answer.type/math] [:db/add "1decae6a-9bf0-55b8-bce2-aee9c74aa17e" :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}"] [:db