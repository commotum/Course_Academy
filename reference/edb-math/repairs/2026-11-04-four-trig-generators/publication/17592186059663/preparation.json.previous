  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/id #uuid \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\"] [:db/add \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/type :answer.type/math] [:db/add \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/validate] [:db/add \"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/id #uuid \"100d01b2-821e-5840-8708-6b7f2a3125fc\"] [:db/add \"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/type :answer.type/math] [:db/add \"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/value \"-\\\\frac{\\\\sqrt{6}}{4}\"] [:db/ensure \"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/validate] [:db/add \"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/id #uuid \"11e36a3c-def3-5cbf-b1be-83287efb7568\"] [:db/add \"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/type :answer.type/math] [:db/add \"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/validate] [:db/add \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/id #uuid \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\"] [:db/add \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/type :answer.type/math] [:db/add \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/validate] [:db/add \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/id #uuid \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\"] [:db/add \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/type :answer.type/math] [:db/add \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/validate] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/id #uuid \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/key \"selection\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/type :answer-field.type/radio] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"100d01b2-821e-5840-8708-6b7f2a3125fc\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"11e36a3c-def3-5cbf-b1be-83287efb7568\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\"] [:db/add \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/correct \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\"] [:db/ensure \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/validate] [:db/add \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/id #uuid \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\"] [:db/add \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{3}-\\\\frac{\\\\pi}{4}$.*\"] [:db/add \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{3}-\\\\frac{\\\\pi}{4}$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{3}-\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)-\\\\cos\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/difficulty :question.difficulty/easy] [:db/add \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/answer-fields \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\"] [:db/ensure \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\"] [:db/add \"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/id #uuid \"d51fbaff-db6c-532c-91ae-221bc107b5cb\"] [:db/add \"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/type :answer.type/math] [:db/add \"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/validate] [:db/add \"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/id #uuid \"8a1960a0-a775-5727-b272-1e71a456bbc8\"] [:db/add \"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/type :answer.type/math] [:db/add \"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/validate] [:db/add \"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/id #uuid \"7d31c6fd-fa3b-5c20-a588-31868760db38\"] [:db/add \"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/type :answer.type/math] [:db/add \"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/validate] [:db/add \"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/id #uuid \"1b92844d-d398-59d6-a2e1-f653b49272c8\"] [:db/add \"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/type :answer.type/math] [:db/add \"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\"] [:db/ensure \"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/validate] [:db/add \"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/id #uuid \"935b0f5f-3361-5310-a38f-fc697db347f7\"] [:db/add \"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/type :answer.type/math] [:db/add \"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/validate] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/id #uuid \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/key \"selection\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/type :answer-field.type/radio] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"d51fbaff-db6c-532c-91ae-221bc107b5cb\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"8a1960a0-a775-5727-b272-1e71a456bbc8\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"7d31c6fd-fa3b-5c20-a588-31868760db38\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"1b92844d-d398-59d6-a2e1-f653b49272c8\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"935b0f5f-3361-5310-a38f-fc697db347f7\"] [:db/add \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/correct \"d51fbaff-db6c-532c-91ae-221bc107b5cb\"] [:db/ensure \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/validate] [:db/add \"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/id #uuid \"108f6809-67db-598a-a6ac-2051b41ce05f\"] [:db/add \"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-\\\\frac{\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $-\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{6}-\\\\frac{\\\\pi}{4}$.*\"] [:db/add \"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{6}-\\\\frac{\\\\pi}{4}$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-\\\\frac{\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}-\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)-\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/difficulty :question.difficulty/easy] [:db/add \"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/answer-fields \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\"] [:db/ensure \"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"108f6809-67db-598a-a6ac-2051b41ce05f\"] [:db/add \"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/id #uuid \"2e12a23d-3ec7-564d-b54e-448020535812\"] [:db/add \"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/type :answer.type/math] [:db/add \"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/validate] [:db/add \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/id #uuid \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\"] [:db/add \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/type :answer.type/math] [:db/add \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/validate] [:db/add \"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/id #uuid \"0c30c185-f053-5d30-bf51-ec95638b3b42\"] [:db/add \"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/type :answer.type/math] [:db/add \"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/validate] [:db/add \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/id #uuid \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\"] [:db/add \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/type :answer.type/math] [:db/add \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/validate] [:db/add \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/id #uuid \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\"] [:db/add \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/type :answer.type/math] [:db/add \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [:db/ensure \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/validate] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/id #uuid \"10e6c758-cfed-5a5b-b480-2b004c9aee54\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/key \"selection\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/type :answer-field.type/radio] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"2e12a23d-3ec7-564d-b54e-448020535812\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"0c30c185-f053-5d30-bf51-ec95638b3b42\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\"] [:db/add \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/correct \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\"] [:db/ensure \"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/validate] [:db/add \"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/id #uuid \"edf66a66-5610-574f-9d8b-7c8d25b2364d\"] [:db/add \"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{6}+\\\\frac{\\\\pi}{4}$.*\"] [:db/add \"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{6}+\\\\frac{\\\\pi}{4}$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{5\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}+\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)+\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/difficulty :question.difficulty/easy] [:db/add \"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/answer-fields \"10e6c758-cfed-5a5b-b480-2b004c9aee54\"] [:db/ensure \"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"edf66a66-5610-574f-9d8b-7c8d25b2364d\"] [:db/add \"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/id #uuid \"86950b2d-6634-5da1-a406-27b6c01f9486\"] [:db/add \"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/type :answer.type/math] [:db/add \"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/validate] [:db/add \"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/id #uuid \"77f09e1e-0860-5c79-abd7-9814bf3cad99\"] [:db/add \"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/key \"field-1\"] [:db/add \"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/type :answer-field.type/blank] [:db/add \"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/choices \"86950b2d-6634-5da1-a406-27b6c01f9486\"] [:db/add \"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/correct \"86950b2d-6634-5da1-a406-27b6c01f9486\"] [:db/ensure \"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/validate] [:db/add \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/id #uuid \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\"] [:db/add \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/problem \"Using the fact that $105^\\\\circ=330^\\\\circ-225^\\\\circ$, calculate the **exact** value of $\\\\sin\\\\left(105^\\\\circ\\\\right)$ without a calculator.\\n\\n$\\\\sin\\\\left(105^\\\\circ\\\\right)=$ {{field-1}}\"] [:db/add \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $105^\\\\circ=330^\\\\circ-225^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(105^\\\\circ\\\\right) &=\\\\sin\\\\left(330^\\\\circ-225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(330^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)-\\\\cos\\\\left(330^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/difficulty :question.difficulty/moderate] [:db/add \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/answer-fields \"77f09e1e-0860-5c79-abd7-9814bf3cad99\"] [:db/ensure \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\"] [:db/add \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/id #uuid \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\"] [:db/add \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/type :answer.type/math] [:db/add \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/validate] [:db/add \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/id #uuid \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\"] [:db/add \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/type :answer.type/math] [:db/add \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/validate] [:db/add \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/id #uuid \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\"] [:db/add \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/type :answer.type/math] [:db/add \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/validate] [:db/add \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/id #uuid \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\"] [:db/add \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/type :answer.type/math] [:db/add \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [:db/ensure \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/validate] [:db/add \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/id #uuid \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\"] [:db/add \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/type :answer.type/math] [:db/add \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/validate] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/id #uuid \"571f1b76-037f-5240-bb60-808689501b48\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/key \"selection\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/type :answer-field.type/radio] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\"] [:db/add \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/correct \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\"] [:db/ensure \"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/validate] [:db/add \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/id #uuid \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\"] [:db/add \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-165^\\\\circ\\\\right)$ without using a calculator?\"] [:db/add \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-165^\\\\circ=60^\\\\circ-225^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-165^\\\\circ\\\\right) &=\\\\sin\\\\left(60^\\\\circ-225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(60^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)-\\\\cos\\\\left(60^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/difficulty :question.difficulty/hard] [:db/add \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/answer-fields \"571f1b76-037f-5240-bb60-808689501b48\"] [:db/ensure \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\"] [:db/add \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/id #uuid \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\"] [:db/add \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/type :answer.type/math] [:db/add \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/validate] [:db/add \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/id #uuid \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\"] [:db/add \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/type :answer.type/math] [:db/add \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/validate] [:db/add \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/id #uuid \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\"] [:db/add \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/type :answer.type/math] [:db/add \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/validate] [:db/add \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/id #uuid \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\"] [:db/add \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/type :answer.type/math] [:db/add \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/validate] [:db/add \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/id #uuid \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\"] [:db/add \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/type :answer.type/math] [:db/add \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\"] [:db/ensure \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/validate] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/id #uuid \"6de60033-cc2a-551b-9168-1c50c6911970\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/key \"selection\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/type :answer-field.type/radio] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\"] [:db/add \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/correct \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\"] [:db/ensure \"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/validate] [:db/add \"df940827-db1a-57df-86eb-7717e0bb6534\" :question/id #uuid \"df940827-db1a-57df-86eb-7717e0bb6534\"] [:db/add \"df940827-db1a-57df-86eb-7717e0bb6534\" :question/problem \"What is the exact value of $\\\\sin\\\\left(165^\\\\circ\\\\right)$ without using a calculator?\"] [:db/add \"df940827-db1a-57df-86eb-7717e0bb6534\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $165^\\\\circ=210^\\\\circ-45^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(165^\\\\circ\\\\right) &=\\\\sin\\\\left(210^\\\\circ-45^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(210^\\\\circ\\\\right)\\\\cos\\\\left(45^\\\\circ\\\\right)-\\\\cos\\\\left(210^\\\\circ\\\\right)\\\\sin\\\\left(45^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"df940827-db1a-57df-86eb-7717e0bb6534\" :question/difficulty :question.difficulty/hard] [:db/add \"df940827-db1a-57df-86eb-7717e0bb6534\" :question/answer-fields \"6de60033-cc2a-551b-9168-1c50c6911970\"] [:db/ensure \"df940827-db1a-57df-86eb-7717e0bb6534\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"df940827-db1a-57df-86eb-7717e0bb6534\"] [:db/add \"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/id #uuid \"758e054b-49a1-57ef-9299-1264f6e47ca2\"] [:db/add \"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/type :answer.type/math] [:db/add \"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\"] [:db/ensure \"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/validate] [:db/add \"71e6a958-f4d4-503c-98d2-357c31595509\" :answer/id #uuid \"71e6a958-f4d4