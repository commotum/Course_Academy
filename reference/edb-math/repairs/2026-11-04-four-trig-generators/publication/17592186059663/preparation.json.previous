-5772-bcdf-93a60f81b7b9\"] [:db/add \"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"fc24a635-4c0a-50fd-8a63-fff2b497dc85\"] [:db/add \"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"d1fc5d71-c841-507a-b3c6-a1d245c5f4b1\"] [:db/add \"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/correct \"88035ed2-25a4-5772-bcdf-93a60f81b7b9\"] [:db/ensure \"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/validate] [:db/add \"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/id #uuid \"c1e80544-fe02-5fa5-8201-2d434c92b362\"] [:db/add \"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/problem \"What is the exact value of $\\\\sin\\\\left(75^\\\\circ\\\\right)$ without using a calculator?\"] [:db/add \"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $75^\\\\circ=30^\\\\circ+45^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(75^\\\\circ\\\\right) &=\\\\sin\\\\left(30^\\\\circ+45^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(45^\\\\circ\\\\right)+\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\sin\\\\left(45^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/difficulty :question.difficulty/hard] [:db/add \"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/answer-fields \"13e444a3-d300-5241-967c-586e052f79c3\"] [:db/ensure \"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"c1e80544-fe02-5fa5-8201-2d434c92b362\"] [:db/add \"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/id #uuid \"fd108dc6-a1f2-5d4d-9797-26074515f751\"] [:db/add \"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/type :answer.type/math] [:db/add \"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [:db/ensure \"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/validate] [:db/add \"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/id #uuid \"198162e4-9336-561c-8c2b-73f427585bb0\"] [:db/add \"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/type :answer.type/math] [:db/add \"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/validate] [:db/add \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/id #uuid \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\"] [:db/add \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/type :answer.type/math] [:db/add \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/validate] [:db/add \"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/id #uuid \"ae44747f-fd53-5928-8901-d0f56590fe1a\"] [:db/add \"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/type :answer.type/math] [:db/add \"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [:db/ensure \"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/validate] [:db/add \"725c098f-43d4-503e-9de6-b22d89960782\" :answer/id #uuid \"725c098f-43d4-503e-9de6-b22d89960782\"] [:db/add \"725c098f-43d4-503e-9de6-b22d89960782\" :answer/type :answer.type/math] [:db/add \"725c098f-43d4-503e-9de6-b22d89960782\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [:db/ensure \"725c098f-43d4-503e-9de6-b22d89960782\" :answer/validate] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/id #uuid \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/key \"selection\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/type :answer-field.type/radio] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"fd108dc6-a1f2-5d4d-9797-26074515f751\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"198162e4-9336-561c-8c2b-73f427585bb0\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"ae44747f-fd53-5928-8901-d0f56590fe1a\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"725c098f-43d4-503e-9de6-b22d89960782\"] [:db/add \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/correct \"198162e4-9336-561c-8c2b-73f427585bb0\"] [:db/ensure \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/validate] [:db/add \"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/id #uuid \"b8cd3d62-73d9-5075-a54e-589f90524e28\"] [:db/add \"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/problem \"What is the exact value of $\\\\sin\\\\left(255^\\\\circ\\\\right)$ without using a calculator?\"] [:db/add \"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $255^\\\\circ=120^\\\\circ+135^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(255^\\\\circ\\\\right) &=\\\\sin\\\\left(120^\\\\circ+135^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(120^\\\\circ\\\\right)\\\\cos\\\\left(135^\\\\circ\\\\right)+\\\\cos\\\\left(120^\\\\circ\\\\right)\\\\sin\\\\left(135^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [:db/add \"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/difficulty :question.difficulty/hard] [:db/add \"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/answer-fields \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\"] [:db/ensure \"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/validate] [:db/add 17592186059663 :knowledge-point/questions \"b8cd3d62-73d9-5075-a54e-589f90524e28\"] [:db/add \"generator\" :question-generator/id #uuid \"6eac7706-08a3-5f09-a2c6-60a702df344b\"] [:db/add \"generator\" :question-generator/script \"generators/28/28163aeddca6f507dbc940e398e8e596985600bcc891317c97d6ab840270e42b/generator.py\"] [:db/add 17592186059663 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186059663 :knowledge-point/validate]] \"assertions\" [[\"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/id #uuid \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\"] [\"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/type :answer.type/math] [\"45b11682-f8f6-5c46-ace2-b8bb7615abc4\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/id #uuid \"100d01b2-821e-5840-8708-6b7f2a3125fc\"] [\"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/type :answer.type/math] [\"100d01b2-821e-5840-8708-6b7f2a3125fc\" :answer/value \"-\\\\frac{\\\\sqrt{6}}{4}\"] [\"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/id #uuid \"11e36a3c-def3-5cbf-b1be-83287efb7568\"] [\"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/type :answer.type/math] [\"11e36a3c-def3-5cbf-b1be-83287efb7568\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/id #uuid \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\"] [\"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/type :answer.type/math] [\"5eeb91f6-fd5a-5254-ad61-39c9711ec400\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/id #uuid \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\"] [\"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/type :answer.type/math] [\"a5273ec9-49ef-5215-a6a0-ddd4fc450685\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/id #uuid \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/key \"selection\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/type :answer-field.type/radio] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"45b11682-f8f6-5c46-ace2-b8bb7615abc4\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"100d01b2-821e-5840-8708-6b7f2a3125fc\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"11e36a3c-def3-5cbf-b1be-83287efb7568\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"5eeb91f6-fd5a-5254-ad61-39c9711ec400\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/choices \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\"] [\"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\" :answer-field/correct \"a5273ec9-49ef-5215-a6a0-ddd4fc450685\"] [\"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/id #uuid \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\"] [\"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{3}-\\\\frac{\\\\pi}{4}$.*\"] [\"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{3}-\\\\frac{\\\\pi}{4}$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{3}-\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)-\\\\cos\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/difficulty :question.difficulty/easy] [\"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\" :question/answer-fields \"0ddcc8e4-215c-5c33-a61c-69e1f5f27e9c\"] [17592186059663 :knowledge-point/questions \"9c104d33-ed3c-5e5a-b2bb-e3ee4bf6fede\"] [\"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/id #uuid \"d51fbaff-db6c-532c-91ae-221bc107b5cb\"] [\"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/type :answer.type/math] [\"d51fbaff-db6c-532c-91ae-221bc107b5cb\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/id #uuid \"8a1960a0-a775-5727-b272-1e71a456bbc8\"] [\"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/type :answer.type/math] [\"8a1960a0-a775-5727-b272-1e71a456bbc8\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/id #uuid \"7d31c6fd-fa3b-5c20-a588-31868760db38\"] [\"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/type :answer.type/math] [\"7d31c6fd-fa3b-5c20-a588-31868760db38\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/id #uuid \"1b92844d-d398-59d6-a2e1-f653b49272c8\"] [\"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/type :answer.type/math] [\"1b92844d-d398-59d6-a2e1-f653b49272c8\" :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\"] [\"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/id #uuid \"935b0f5f-3361-5310-a38f-fc697db347f7\"] [\"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/type :answer.type/math] [\"935b0f5f-3361-5310-a38f-fc697db347f7\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/id #uuid \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/key \"selection\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/type :answer-field.type/radio] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"d51fbaff-db6c-532c-91ae-221bc107b5cb\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"8a1960a0-a775-5727-b272-1e71a456bbc8\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"7d31c6fd-fa3b-5c20-a588-31868760db38\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"1b92844d-d398-59d6-a2e1-f653b49272c8\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/choices \"935b0f5f-3361-5310-a38f-fc697db347f7\"] [\"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\" :answer-field/correct \"d51fbaff-db6c-532c-91ae-221bc107b5cb\"] [\"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/id #uuid \"108f6809-67db-598a-a6ac-2051b41ce05f\"] [\"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-\\\\frac{\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $-\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{6}-\\\\frac{\\\\pi}{4}$.*\"] [\"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-\\\\frac{\\\\pi}{12}=\\\\frac{\\\\pi}{6}-\\\\frac{\\\\pi}{4}$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-\\\\frac{\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}-\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)-\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/difficulty :question.difficulty/easy] [\"108f6809-67db-598a-a6ac-2051b41ce05f\" :question/answer-fields \"18dedcb5-d9e9-53f6-8bce-e8a2addf29d9\"] [17592186059663 :knowledge-point/questions \"108f6809-67db-598a-a6ac-2051b41ce05f\"] [\"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/id #uuid \"2e12a23d-3ec7-564d-b54e-448020535812\"] [\"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/type :answer.type/math] [\"2e12a23d-3ec7-564d-b54e-448020535812\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/id #uuid \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\"] [\"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/type :answer.type/math] [\"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/id #uuid \"0c30c185-f053-5d30-bf51-ec95638b3b42\"] [\"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/type :answer.type/math] [\"0c30c185-f053-5d30-bf51-ec95638b3b42\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/id #uuid \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\"] [\"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/type :answer.type/math] [\"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/id #uuid \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\"] [\"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/type :answer.type/math] [\"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/id #uuid \"10e6c758-cfed-5a5b-b480-2b004c9aee54\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/key \"selection\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/type :answer-field.type/radio] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"2e12a23d-3ec7-564d-b54e-448020535812\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"0c30c185-f053-5d30-bf51-ec95638b3b42\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"2ed7219d-ebc9-530c-bb69-6e716bb5edb2\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/choices \"399b88a0-fe1f-5f2b-a021-6dd8da3e2af3\"] [\"10e6c758-cfed-5a5b-b480-2b004c9aee54\" :answer-field/correct \"ab0bd9e6-82b8-5aa5-8f6f-e0a4d12344fd\"] [\"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/id #uuid \"edf66a66-5610-574f-9d8b-7c8d25b2364d\"] [\"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{6}+\\\\frac{\\\\pi}{4}$.*\"] [\"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{6}+\\\\frac{\\\\pi}{4}$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{5\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}+\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)+\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/difficulty :question.difficulty/easy] [\"edf66a66-5610-574f-9d8b-7c8d25b2364d\" :question/answer-fields \"10e6c758-cfed-5a5b-b480-2b004c9aee54\"] [17592186059663 :knowledge-point/questions \"edf66a66-5610-574f-9d8b-7c8d25b2364d\"] [\"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/id #uuid \"86950b2d-6634-5da1-a406-27b6c01f9486\"] [\"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/type :answer.type/math] [\"86950b2d-6634-5da1-a406-27b6c01f9486\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/id #uuid \"77f09e1e-0860-5c79-abd7-9814bf3cad99\"] [\"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/key \"field-1\"] [\"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/type :answer-field.type/blank] [\"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/choices \"86950b2d-6634-5da1-a406-27b6c01f9486\"] [\"77f09e1e-0860-5c79-abd7-9814bf3cad99\" :answer-field/correct \"86950b2d-6634-5da1-a406-27b6c01f9486\"] [\"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/id #uuid \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\"] [\"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/problem \"Using the fact that $105^\\\\circ=330^\\\\circ-225^\\\\circ$, calculate the **exact** value of $\\\\sin\\\\left(105^\\\\circ\\\\right)$ without a calculator.\\n\\n$\\\\sin\\\\left(105^\\\\circ\\\\right)=$ {{field-1}}\"] [\"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $105^\\\\circ=330^\\\\circ-225^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(105^\\\\circ\\\\right) &=\\\\sin\\\\left(330^\\\\circ-225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(330^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)-\\\\cos\\\\left(330^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/difficulty :question.difficulty/moderate] [\"c8da6d15-25b7-5267-8bcb-1931fb1fc352\" :question/answer-fields \"77f09e1e-0860-5c79-abd7-9814bf3cad99\"] [17592186059663 :knowledge-point/questions \"c8da6d15-25b7-5267-8bcb-1931fb1fc352\"] [\"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/id #uuid \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\"] [\"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/type :answer.type/math] [\"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/id #uuid \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\"] [\"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/type :answer.type/math] [\"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/id #uuid \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\"] [\"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/type :answer.type/math] [\"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/id #uuid \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\"] [\"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/type :answer.type/math] [\"fc533a30-716f-5ea8-8084-8f9b215bd9c7\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [\"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/id #uuid \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\"] [\"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/type :answer.type/math] [\"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/id #uuid \"571f1b76-037f-5240-bb60-808689501b48\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/key \"selection\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/type :answer-field.type/radio] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"1e1c4c69-e862-5b26-9ed6-2e3eaad660bd\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"1decae6a-9bf0-55b8-bce2-aee9c74aa17e\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"fc533a30-716f-5ea8-8084-8f9b215bd9c7\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/choices \"f8ab9bc6-b4e4-56ae-8495-e2b95c447826\"] [\"571f1b76-037f-5240-bb60-808689501b48\" :answer-field/correct \"d6c76f15-eedd-5b4f-93f9-fa2b5a6262b8\"] [\"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/id #uuid \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\"] [\"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-165^\\\\circ\\\\right)$ without using a calculator?\"] [\"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-165^\\\\circ=60^\\\\circ-225^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-165^\\\\circ\\\\right) &=\\\\sin\\\\left(60^\\\\circ-225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(60^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)-\\\\cos\\\\left(60^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/difficulty :question.difficulty/hard] [\"2ed50138-474a-54c5-b601-b5f1bfa8af7f\" :question/answer-fields \"571f1b76-037f-5240-bb60-808689501b48\"] [17592186059663 :knowledge-point/questions \"2ed50138-474a-54c5-b601-b5f1bfa8af7f\"] [\"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/id #uuid \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\"] [\"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/type :answer.type/math] [\"c29e7d0e-de17-5fe2-86c0-4ac18597b758\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/id #uuid \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\"] [\"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/type :answer.type/math] [\"4ecccc80-8efb-57e7-8ee3-68cd021572c8\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/id #uuid \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\"] [\"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/type :answer.type/math] [\"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/id #uuid \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\"] [\"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/type :answer.type/math] [\"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/id #uuid \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\"] [\"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/type :answer.type/math] [\"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\" :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/id #uuid \"6de60033-cc2a-551b-9168-1c50c6911970\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/key \"selection\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/type :answer-field.type/radio] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"4ecccc80-8efb-57e7-8ee3-68cd021572c8\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"4dc29d28-1f7a-5f06-a160-1ae2e978f4af\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"ce2beaa4-6c5f-5f69-b21c-8552ac8f6c2c\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/choices \"e59fb7a6-6d8d-5d3d-90d0-876b2b0abb9f\"] [\"6de60033-cc2a-551b-9168-1c50c6911970\" :answer-field/correct \"c29e7d0e-de17-5fe2-86c0-4ac18597b758\"] [\"df940827-db1a-57df-86eb-7717e0bb6534\" :question/id #uuid \"df940827-db1a-57df-86eb-7717e0bb6534\"] [\"df940827-db1a-57df-86eb-7717e0bb6534\" :question/problem \"What is the exact value of $\\\\sin\\\\left(165^\\\\circ\\\\right)$ without using a calculator?\"] [\"df940827-db1a-57df-86eb-7717e0bb6534\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $165^\\\\circ=210^\\\\circ-45^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(165^\\\\circ\\\\right) &=\\\\sin\\\\left(210^\\\\circ-45^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(210^\\\\circ\\\\right)\\\\cos\\\\left(45^\\\\circ\\\\right)-\\\\cos\\\\left(210^\\\\circ\\\\right)\\\\sin\\\\left(45^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"df940827-db1a-57df-86eb-7717e0bb6534\" :question/difficulty :question.difficulty/hard] [\"df940827-db1a-57df-86eb-7717e0bb6534\" :question/answer-fields \"6de60033-cc2a-551b-9168-1c50c6911970\"] [17592186059663 :knowledge-point/questions \"df940827-db1a-57df-86eb-7717e0bb6534\"] [\"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/id #uuid \"758e054b-49a1-57ef-9299-1264f6e47ca2\"] [\"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/type :answer.type/math] [\"758e054b-49a1-57ef-9299-1264f6e47ca2\" :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\"] [\"71e6a958-f4d4-503c-98d2-357c31595509\" :answer/id #uuid \"71e6a958-f4d4-503c-98d2-357c31595509\"] [\"71e6a958-f4d4-503c-98d2-357c31595509\" :answer/type :answer.type/math] [\"71e6a958-f4d4-503c-98d2-357c31595509\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"88035ed2-25a4-5772-bcdf-93a60f81b7b9\" :answer/id #uuid \"88035ed2-25a4-5772-bcdf-93a60f81b7b9\"] [\"88035ed2-25a4-5772-bcdf-93a60f81b7b9\" :answer/type :answer.type/math] [\"88035ed2-25a4-5772-bcdf-93a60f81b7b9\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"fc24a635-4c0a-50fd-8a63-fff2b497dc85\" :answer/id #uuid \"fc24a635-4c0a-50fd-8a63-fff2b497dc85\"] [\"fc24a635-4c0a-50fd-8a63-fff2b497dc85\" :answer/type :answer.type/math] [\"fc24a635-4c0a-50fd-8a63-fff2b497dc85\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"d1fc5d71-c841-507a-b3c6-a1d245c5f4b1\" :answer/id #uuid \"d1fc5d71-c841-507a-b3c6-a1d245c5f4b1\"] [\"d1fc5d71-c841-507a-b3c6-a1d245c5f4b1\" :answer/type :answer.type/math] [\"d1fc5d71-c841-507a-b3c6-a1d245c5f4b1\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/id #uuid \"13e444a3-d300-5241-967c-586e052f79c3\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/key \"selection\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/type :answer-field.type/radio] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"758e054b-49a1-57ef-9299-1264f6e47ca2\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"71e6a958-f4d4-503c-98d2-357c31595509\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"88035ed2-25a4-5772-bcdf-93a60f81b7b9\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"fc24a635-4c0a-50fd-8a63-fff2b497dc85\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/choices \"d1fc5d71-c841-507a-b3c6-a1d245c5f4b1\"] [\"13e444a3-d300-5241-967c-586e052f79c3\" :answer-field/correct \"88035ed2-25a4-5772-bcdf-93a60f81b7b9\"] [\"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/id #uuid \"c1e80544-fe02-5fa5-8201-2d434c92b362\"] [\"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/problem \"What is the exact value of $\\\\sin\\\\left(75^\\\\circ\\\\right)$ without using a calculator?\"] [\"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $75^\\\\circ=30^\\\\circ+45^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(75^\\\\circ\\\\right) &=\\\\sin\\\\left(30^\\\\circ+45^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(45^\\\\circ\\\\right)+\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\sin\\\\left(45^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/difficulty :question.difficulty/hard] [\"c1e80544-fe02-5fa5-8201-2d434c92b362\" :question/answer-fields \"13e444a3-d300-5241-967c-586e052f79c3\"] [17592186059663 :knowledge-point/questions \"c1e80544-fe02-5fa5-8201-2d434c92b362\"] [\"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/id #uuid \"fd108dc6-a1f2-5d4d-9797-26074515f751\"] [\"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/type :answer.type/math] [\"fd108dc6-a1f2-5d4d-9797-26074515f751\" :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\"] [\"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/id #uuid \"198162e4-9336-561c-8c2b-73f427585bb0\"] [\"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/type :answer.type/math] [\"198162e4-9336-561c-8c2b-73f427585bb0\" :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/id #uuid \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\"] [\"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/type :answer.type/math] [\"d8471ed2-3401-5d74-b7ea-e6f2e050d190\" :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/id #uuid \"ae44747f-fd53-5928-8901-d0f56590fe1a\"] [\"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/type :answer.type/math] [\"ae44747f-fd53-5928-8901-d0f56590fe1a\" :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\"] [\"725c098f-43d4-503e-9de6-b22d89960782\" :answer/id #uuid \"725c098f-43d4-503e-9de6-b22d89960782\"] [\"725c098f-43d4-503e-9de6-b22d89960782\" :answer/type :answer.type/math] [\"725c098f-43d4-503e-9de6-b22d89960782\" :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/id #uuid \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/key \"selection\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/type :answer-field.type/radio] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"fd108dc6-a1f2-5d4d-9797-26074515f751\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"198162e4-9336-561c-8c2b-73f427585bb0\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"d8471ed2-3401-5d74-b7ea-e6f2e050d190\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"ae44747f-fd53-5928-8901-d0f56590fe1a\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/choices \"725c098f-43d4-503e-9de6-b22d89960782\"] [\"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\" :answer-field/correct \"198162e4-9336-561c-8c2b-73f427585bb0\"] [\"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/id #uuid \"b8cd3d62-73d9-5075-a54e-589f90524e28\"] [\"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/problem \"What is the exact value of $\\\\sin\\\\left(255^\\\\circ\\\\right)$ without using a calculator?\"] [\"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $255^\\\\circ=120^\\\\circ+135^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(255^\\\\circ\\\\right) &=\\\\sin\\\\left(120^\\\\circ+135^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(120^\\\\circ\\\\right)\\\\cos\\\\left(135^\\\\circ\\\\right)+\\\\cos\\\\left(120^\\\\circ\\\\right)\\\\sin\\\\left(135^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"] [\"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/difficulty :question.difficulty/hard] [\"b8cd3d62-73d9-5075-a54e-589f90524e28\" :question/answer-fields \"0bffb3ed-0e8e-52fa-b6a0-9637b1f73f7e\"] [17592186059663 :knowledge-point/questions \"b8cd3d62-73d9-5075-a54e-589f90524e28\"] [\"generator\" :question-generator/id #uuid \"6eac7706-08a3-5f09-a2c6-60a702df344b\"] [\"generator\" :question-generator/script \"generators/28/28163aeddca6f507dbc940e398e8e596985600bcc891317c97d6ab840270e42b/generator.py\"] [17592186059663 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186059663 :knowledge-point/question-generator 17592186701936]]}",
