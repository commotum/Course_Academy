  "before_edn": "{:db/id 17592186059663 :knowledge-point/canonical-example {:db/id 17592186059494 :question/id #uuid \"7341638b-3c0f-5c10-8b7d-a2c313607bed\" :question/math-academy-id \"e-3519\" :question/problem \"Find the exact value of $\\\\sin\\\\left(\\\\dfrac{\\\\pi}{12}\\\\right)$ without using a calculator.\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle \\\\dfrac{\\\\pi}{12} = \\\\dfrac{\\\\pi}{3} - \\\\dfrac{\\\\pi}{4}.\\n$$*\" :question/worked-solution \"Recall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y) = \\\\sin x\\\\cos y - \\\\cos x\\\\sin y\\n$$\\n\\nApplying the difference formula for sine with $x = \\\\dfrac{\\\\pi}{3}$ and $y = \\\\dfrac{\\\\pi}{4},$ we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{12}\\\\right) & =\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{3}-\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"213eda96-c41d-5361-9da9-8349617014f1\" :knowledge-point/key-prerequisites [{:db/id 17592186049923 :topic/id #uuid \"1ed8dd8d-e728-5e57-81fe-a7c1a6a08469\" :topic/knowledge-points [{:db/id 17592186124481} {:db/id 17592186124482} {:db/id 17592186124483}] :topic/math-academy-id 1927 :topic/next [{:db/id 17592186048132} {:db/id 17592186048187} {:db/id 17592186048702} {:db/id 17592186048868} {:db/id 17592186048952} {:db/id 17592186049029} {:db/id 17592186049067} {:db/id 17592186049878} {:db/id 17592186049999} {:db/id 17592186050341} {:db/id 17592186050496}] :topic/title \"The Product Rule for Radicals\"} {:db/id 17592186050848 :topic/id #uuid \"6b88d999-b59b-5a39-b090-40b21de4e2a4\" :topic/knowledge-points [{:db/id 17592186184141} {:db/id 17592186184205}] :topic/math-academy-id 3766 :topic/next [{:db/id 17592186048319} {:db/id 17592186048329} {:db/id 17592186049773} {:db/id 17592186049940} {:db/id 17592186050242} {:db/id 17592186050276} {:db/id 17592186050938}] :topic/title \"Evaluating Trigonometric Expressions\"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186701936 :question-generator/id #uuid \"438a5fde-5018-56b4-9658-c7d105245e33\" :question-generator/script \"generators/98/98423f48f206dc53df825fd4fbe8cec4f34792989a42160079b23eba3dc6242f/generator.py\"} :knowledge-point/questions [{:db/id 17592186060002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"91ad6f18-edf3-520c-b7be-b5a2078d3d9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6} - \\\\sqrt{2}}{4}\" :db/id 17592186056371} {:answer/id #uuid \"db2973aa-3a4a-5419-957d-a7fa5732b03f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186056372} {:answer/id #uuid \"e40cb612-fb35-5907-a4f9-ffc43a956078\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} - \\\\sqrt{6}}{4}\" :db/id 17592186056373} {:answer/id #uuid \"52a42dee-9e2c-52a8-a228-cd76cbd5d16c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{2}\" :db/id 17592186056374} {:answer/id #uuid \"6b2ff55e-248f-5412-a37f-fdfafdaad369\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186056375}] :answer-field/id #uuid \"6ca21add-e184-523e-b311-b14995ac58df\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186056370}] :question/id #uuid \"a3970135-b09a-510a-8a49-4f060f0ca725\" :question/math-academy-id \"q-119175\" :question/problem \"What is the exact value of $\\\\sin 345^{∘}$?\\n\\n*Hint: Use the fact that $345^{∘} = 300^{∘} + 45^{∘}$.*\"} {:db/id 17592186060103 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"487e22e1-54bd-51d6-863d-10475f2000c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186282302} {:answer/id #uuid \"4ed9f056-d1a9-573b-9183-1e03d8b72004\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{2}\" :db/id 17592186282365} {:answer/id #uuid \"4f6663c6-af0b-5715-97f3-659787c5835c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}+\\\\sqrt{2}}{4}\" :db/id 17592186282371} {:answer/id #uuid \"570b6c79-4aa5-5bbf-8d05-cdecd9374d0e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{2}\" :db/id 17592186282428} {:answer/id #uuid \"7e845f7f-9675-5c66-9d46-6e6ac9369ec2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186282780}] :answer-field/correct {:answer/id #uuid \"7e845f7f-9675-5c66-9d46-6e6ac9369ec2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186282780} :answer-field/id #uuid \"e92b5d50-5aa6-5f5d-9324-c7c10bad93f9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186284346}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"d93d90d2-8105-59cb-a801-47640240ddbd\" :question/math-academy-id \"q-1708\" :question/problem \"What is the exact value of $\\\\operatorname{sin}⁡\\\\left(\\\\frac{5\\\\pi }{12}\\\\right)?$\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle \\\\frac{5\\\\pi }{12}=\\\\frac{\\\\pi }{4}+\\\\frac{\\\\pi }{6}.\\n$$*\" :question/worked-solution \"Recall the sum formula for sine:\\n\\n$$\\n\\\\operatorname{sin}⁡(x+y)=\\\\operatorname{sin}⁡x\\\\operatorname{cos}⁡y+\\\\operatorname{cos}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the sum formula for sine with $x=\\\\frac{\\\\pi }{4}$ and $y=\\\\frac{\\\\pi }{6}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}⁡\\\\left(\\\\frac{5\\\\pi }{12}\\\\right) & =\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{4}+\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)+\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f304e544-6270-59ca-8530-7fe512d813f3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186232693}] :answer-field/correct {:answer/id #uuid \"f304e544-6270-59ca-8530-7fe512d813f3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186232693} :answer-field/id #uuid \"26f525fd-4e20-5cfa-b8f9-f15c5b49c8e2\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232692}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2f345820-3d37-51b7-9bb6-51dedb3880f8\" :question/math-academy-id \"q-332158\" :question/problem \"Using the fact that ${75}^{∘}={45}^{∘}+{30}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{sin}({75}^{∘}).$\\n\\n$\\\\operatorname{sin}({75}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for sine:\\n\\n$$\\n\\\\operatorname{sin}(x+y)=\\\\operatorname{sin}x\\\\operatorname{cos}y+\\\\operatorname{cos}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for sine with $x={45}^{∘}$ and $y={30}^{∘}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}({75}^{∘}) & =\\\\operatorname{sin}({45}^{∘}+{30}^{∘}) \\\\\\\\  & =\\\\operatorname{sin}({45}^{∘})\\\\operatorname{cos}({30}^{∘})+\\\\operatorname{cos}({45}^{∘})\\\\operatorname{sin}({30}^{∘}) \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"72643f05-90c6-52af-b240-b68a55683fea\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186232695}] :answer-field/correct {:answer/id #uuid \"72643f05-90c6-52af-b240-b68a55683fea\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186232695} :answer-field/id #uuid \"689caa53-b486-5c31-b472-9df979e0142f\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232694}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"16e4e461-f621-53d1-96fa-7b2df72cfebc\" :question/math-academy-id \"q-332159\" :question/problem \"Using the fact that ${105}^{∘}={60}^{∘}+{45}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{sin}({105}^{∘}).$\\n\\n$\\\\operatorname{sin}({105}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for sine:\\n\\n$$\\n\\\\operatorname{sin}(x+y)=\\\\operatorname{sin}x\\\\operatorname{cos}y+\\\\operatorname{cos}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for sine with $x={60}^{∘}$ and $y={45}^{∘}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}({105}^{∘}) & =\\\\operatorname{sin}({60}^{∘}+{45}^{∘}) \\\\\\\\  & =\\\\operatorname{sin}({60}^{∘})\\\\operatorname{cos}({45}^{∘})+\\\\operatorname{cos}({60}^{∘})\\\\operatorname{sin}({45}^{∘}) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186253530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"40e39a76-ec70-50ca-864d-8989ec887a8e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186251092} {:answer/id #uuid \"47eab5b2-3e2c-5dd1-a458-23a91c1a4181\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186251149} {:answer/id #uuid \"5003212d-ce1d-5519-a755-5603e3a28c20\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{3}}{2}\" :db/id 17592186251208} {:answer/id #uuid \"780276bd-face-56f9-94f9-639f97133c74\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}+\\\\sqrt{2}}{4}\" :db/id 17592186251545} {:answer/id #uuid \"ab7c0a1f-74f2-5b0c-a9a5-180fd3015b26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+1}{4}\" :db/id 17592186252040}] :answer-field/correct {:answer/id #uuid \"47eab5b2-3e2c-5dd1-a458-23a91c1a4181\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186251149} :answer-field/id #uuid \"333cadb6-b105-5b48-8c09-a59a2a9c8b99\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186252893}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"97e8e577-5bc3-50c1-b8c6-66747cc71a22\" :question/math-academy-id \"q-119007\" :question/problem \"What is the exact value of $\\\\operatorname{sin}⁡({75}^{∘})?$\" :question/worked-solution \"The angle ${75}^{∘}$ is not a special angle. However, we can rewrite it as the sum of two special angles, as follows:\\n\\n$$\\n\\\\begin{aligned}{75}^{∘}={45}^{∘}+{30}^{∘}\\\\end{aligned}\\n$$\\n\\nWe now recall the sum formula for sine:\\n\\n$$\\n\\\\operatorname{sin}⁡(x+y)=\\\\operatorname{sin}⁡x\\\\operatorname{cos}⁡y+\\\\operatorname{cos}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the sum formula for sine with $x={45}^{∘}$ and $y={30}^{∘},$ we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}⁡({75}^{∘}) & =\\\\operatorname{sin}⁡({45}^{∘}+{30}^{∘}) \\\\\\\\  & =\\\\operatorname{sin}⁡{45}^{∘}\\\\operatorname{cos}⁡{30}^{∘}+\\\\operatorname{cos}⁡{45}^{∘}\\\\operatorname{sin}⁡{30}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186292748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e8ec2a45-2842-5b4c-acdd-a649ac1b1c6c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186291607}] :answer-field/correct {:answer/id #uuid \"e8ec2a45-2842-5b4c-acdd-a649ac1b1c6c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186291607} :answer-field/id #uuid \"db846e3e-68fd-593b-bfb4-4529425488f8\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186292415}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"996eb380-c7f3-58b2-8258-bc17318d5244\" :question/math-academy-id \"q-274557\" :question/problem \"Using the fact that ${75}^{∘}={135}^{∘}-{60}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{sin}⁡{75}^{∘}.$\\n\\n$\\\\operatorname{sin}⁡({75}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the difference formula for sine:\\n\\n$$\\n\\\\operatorname{sin}⁡(x-y)=\\\\operatorname{sin}⁡x\\\\operatorname{cos}⁡y-\\\\operatorname{cos}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the difference formula for sine with $x={135}^{∘}$ and $y={60}^{∘},$ we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}⁡{75}^{∘} & =\\\\operatorname{sin}⁡({135}^{∘}-{60}^{∘}) \\\\\\\\  & =\\\\operatorname{sin}⁡{135}^{∘}\\\\operatorname{cos}⁡{60}^{∘}-\\\\operatorname{cos}⁡{135}^{∘}\\\\operatorname{sin}⁡{60}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2}-\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186335834 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3b7e71a1-540f-5903-a353-483cfa6ced0c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186333552} {:answer/id #uuid \"573aace2-d7ed-5759-b52b-c897e1f38e81\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186333785} {:answer/id #uuid \"5af8090f-e014-5587-901a-3c106f54a0c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186333821} {:answer/id #uuid \"a99a4457-c774-5779-bb5c-5a973ede85f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186334476} {:answer/id #uuid \"b486a69e-1f42-5339-a393-a6f36f33f348\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{3}}{4}\" :db/id 17592186334570}] :answer-field/correct {:answer/id #uuid \"a99a4457-c774-5779-bb5c-5a973ede85f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186334476} :answer-field/id #uuid \"c9707a27-b3b6-57dc-891d-4427cb25a436\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186335610}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"585e18d7-2aa5-5d3f-86ad-587ffce85678\" :question/math-academy-id \"q-65427\" :question/problem \"What is the exact value of $\\\\operatorname{sin}⁡(-{105}^{∘})?$\\n\\n*Hint: Use the fact that $-{105}^{∘}={30}^{∘}-{135}^{∘}.$*\" :question/worked-solution \"Recall the difference formula for sine:\\n\\n$$\\n\\\\operatorname{sin}⁡(x-y)=\\\\operatorname{sin}⁡x\\\\operatorname{cos}⁡y-\\\\operatorname{cos}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the difference formula for sine with $x={30}^{∘}$ and $y={135}^{∘},$ we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}⁡(-{105}^{∘}) & =\\\\operatorname{sin}⁡({30}^{∘}-{135}^{∘}) \\\\\\\\  & =\\\\operatorname{sin}⁡{30}^{∘}\\\\operatorname{cos}⁡{135}^{∘}-\\\\operatorname{cos}⁡{30}^{∘}\\\\operatorname{sin}⁡{135}^{∘} \\\\\\\\  & =\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186335835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"51a9cbb7-6557-56b8-b41b-efdef54412d4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186333737} {:answer/id #uuid \"81b1e9cd-c7a9-5810-8b9f-efc4191b4b23\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186334141} {:answer/id #uuid \"8bbeb5ca-4805-5bb3-a579-86a166eaad07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186334236} {:answer/id #uuid \"a67c9e7d-c929-590e-863b-c57c5938356f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186334445} {:answer/id #uuid \"cfa5d35b-d0a6-5ef1-baa6-529dd89b4095\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{2}\" :db/id 17592186334799}] :answer-field/correct {:answer/id #uuid \"8bbeb5ca-4805-5bb3-a579-86a166eaad07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186334236} :answer-field/id #uuid \"e62b1cc7-51fe-56a3-bfd4-d5243e6b80e1\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186335640}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"4bf1dbaf-6e61-5607-8543-7f1dda28cf3f\" :question/math-academy-id \"q-65430\" :question/problem \"What is the exact value of $\\\\operatorname{sin}⁡\\\\left(\\\\frac{11\\\\pi }{12}\\\\right)?$\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle \\\\frac{11\\\\pi }{12}=\\\\frac{7\\\\pi }{6}-\\\\frac{\\\\pi }{4}.\\n$$*\" :question/worked-solution \"Recall the difference formula for sine:\\n\\n$$\\n\\\\operatorname{sin}⁡(x-y)=\\\\operatorname{sin}⁡x\\\\operatorname{cos}⁡y-\\\\operatorname{cos}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the difference formula for sine with $x=\\\\frac{7\\\\pi }{6}$ and $y=\\\\frac{\\\\pi }{4}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{sin}⁡\\\\left(\\\\frac{11\\\\pi }{12}\\\\right) & =\\\\operatorname{sin}⁡\\\\left(\\\\frac{7\\\\pi }{6}-\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\operatorname{sin}⁡\\\\left(\\\\frac{7\\\\pi }{6}\\\\right)\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-\\\\operatorname{cos}⁡\\\\left(\\\\frac{7\\\\pi }{6}\\\\right)\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186701916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3b52f88f-18cb-5753-85fe-8d7f8eb778fb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701915} {:answer/id #uuid \"6ea37bed-b167-5a45-b750-dcb389422d8f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701921} {:answer/id #uuid \"a0c83661-4e54-5920-87fc-9f91b2deb0b5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701927} {:answer/id #uuid \"a5108ff9-4282-561d-b3a4-a9fe0ad38549\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701928} {:answer/id #uuid \"c3570ce1-fca8-52a7-9c3f-ec89e9f44b57\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186701932}] :answer-field/correct {:answer/id #uuid \"a5108ff9-4282-561d-b3a4-a9fe0ad38549\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701928} :answer-field/id #uuid \"ce5dda4b-8d6a-5fb7-a28e-6b140e50d489\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186701933}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"3c63f1f8-2a20-54cf-ba8d-ad06ceaa1128\" :question/problem \"What is the exact value of $\\\\sin\\\\left(345^\\\\circ\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $345^\\\\circ=210^\\\\circ+135^\\\\circ$.*\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $345^\\\\circ=210^\\\\circ+135^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(345^\\\\circ\\\\right) &=\\\\sin\\\\left(210^\\\\circ+135^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(210^\\\\circ\\\\right)\\\\cos\\\\left(135^\\\\circ\\\\right)+\\\\cos\\\\left(210^\\\\circ\\\\right)\\\\sin\\\\left(135^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186701917 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"28ba89eb-2af1-511e-95e7-20632cb5f03c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701913} {:answer/id #uuid \"7cb4fa89-d60e-5dd5-8a71-174ab1cd22f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701923} {:answer/id #uuid \"90863a6e-2733-52af-bb44-4545053c6c9c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701925} {:answer/id #uuid \"a5ba3762-2268-5013-9018-218484d80fcd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701929} {:answer/id #uuid \"b518464b-59a0-5bd5-9278-8020d21b1acd\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186701931}] :answer-field/correct {:answer/id #uuid \"7cb4fa89-d60e-5dd5-8a71-174ab1cd22f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701923} :answer-field/id #uuid \"044ce272-68c1-5fd4-a3d9-56245343c24d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186701909}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"49af8cc1-0845-5380-ba86-ed503a17e195\" :question/problem \"What is the exact value of $\\\\sin\\\\left(15^\\\\circ\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $15^\\\\circ=330^\\\\circ-315^\\\\circ$.*\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $15^\\\\circ=330^\\\\circ-315^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(15^\\\\circ\\\\right) &=\\\\sin\\\\left(330^\\\\circ-315^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(330^\\\\circ\\\\right)\\\\cos\\\\left(315^\\\\circ\\\\right)-\\\\cos\\\\left(330^\\\\circ\\\\right)\\\\sin\\\\left(315^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186701919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"34aeac79-6868-578f-9a6e-3f20c4815605\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701914} {:answer/id #uuid \"4f4016a0-1a51-5700-8960-56e80ba62522\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701918} {:answer/id #uuid \"62770c2e-df16-506e-8efd-f07fd27cc451\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186701920} {:answer/id #uuid \"7899de01-d729-5ba0-86bc-3d4dd8b0d112\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701922} {:answer/id #uuid \"b4acc0aa-c036-50b6-ab92-710ee41ec1ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701930}] :answer-field/correct {:answer/id #uuid \"34aeac79-6868-578f-9a6e-3f20c4815605\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186701914} :answer-field/id #uuid \"ed76dac3-2a3b-5ae7-986e-c6b29a921fc6\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186701935}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"594b65a8-e270-5e2d-b7a0-ff5d51b00e6e\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-285^\\\\circ\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $-285^\\\\circ=45^\\\\circ-330^\\\\circ$.*\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-285^\\\\circ=45^\\\\circ-330^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-285^\\\\circ\\\\right) &=\\\\sin\\\\left(45^\\\\circ-330^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(330^\\\\circ\\\\right)-\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(330^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(-\\\\frac{1}{2}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186701924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2644b610-7723-5ada-92c4-a5bb03725771\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701912}] :answer-field/correct {:answer/id #uuid \"2644b610-7723-5ada-92c4-a5bb03725771\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701912} :answer-field/id #uuid \"05e9e0a1-75a9-5f0f-b5fe-92b1130c240b\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186701910}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"7cf906bd-8773-5c99-9c04-015afcfd7296\" :question/problem \"Using the fact that $165^\\\\circ=30^\\\\circ+135^\\\\circ$, calculate the **exact** value of $\\\\sin\\\\left(165^\\\\circ\\\\right)$ without a calculator.\\n\\n$\\\\sin\\\\left(165^\\\\circ\\\\right)=$ {{field-1}}\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $165^\\\\circ=30^\\\\circ+135^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(165^\\\\circ\\\\right) &=\\\\sin\\\\left(30^\\\\circ+135^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(135^\\\\circ\\\\right)+\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\sin\\\\left(135^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186701934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"97d3e1da-801c-525d-a6cc-94f36a436e7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701926}] :answer-field/correct {:answer/id #uuid \"97d3e1da-801c-525d-a6cc-94f36a436e7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186701926} :answer-field/id #uuid \"22ea227f-8c8a-51a4-a2ed-bcc267d9a727\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186701911}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"d4a5db3e-855f-5a6e-ba7c-fab5ea268cd6\" :question/problem \"Using the fact that $255^\\\\circ=30^\\\\circ+225^\\\\circ$, calculate the **exact** value of $\\\\sin\\\\left(255^\\\\circ\\\\right)$ without a calculator.\\n\\n$\\\\sin\\\\left(255^\\\\circ\\\\right)=$ {{field-1}}\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $255^\\\\circ=30^\\\\circ+225^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(255^\\\\circ\\\\right) &=\\\\sin\\\\left(30^\\\\circ+225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)+\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0be43441-f81d-5900-b036-8c74450e11ca\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705132} {:answer/id #uuid \"194606ef-c800-57f7-a839-39dceb04a1ca\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186705134} {:answer/id #uuid \"1f86df39-9c81-54b1-b79b-42b2c7127fb4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705135} {:answer/id #uuid \"33661af0-9eb4-58d8-9be3-395dc98a654f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705138} {:answer/id #uuid \"63ac4d53-fb11-539e-839f-e14934f43dc4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705142}] :answer-field/correct {:answer/id #uuid \"33661af0-9eb4-58d8-9be3-395dc98a654f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705138} :answer-field/id #uuid \"8e1f4c93-682e-545b-9372-9d42e62897bf\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705147}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"308c0cf6-baee-526e-af8c-e497d6b497da\" :question/problem \"What is the exact value of $\\\\sin\\\\left(285^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $285^\\\\circ=135^\\\\circ+150^\\\\circ$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(285^\\\\circ\\\\right) &=\\\\sin\\\\left(135^\\\\circ+150^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(135^\\\\circ\\\\right)\\\\cos\\\\left(150^\\\\circ\\\\right)+\\\\cos\\\\left(135^\\\\circ\\\\right)\\\\sin\\\\left(150^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3fe5cdab-a426-5ba1-b393-21feb009e17b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186705139} {:answer/id #uuid \"5c38ee27-5425-5117-99ea-037c1e48f427\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705140} {:answer/id #uuid \"c6112d89-0108-5206-83e7-af5f2d0bfe4a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705151} {:answer/id #uuid \"ddc8d1d6-939f-54da-b75f-a6dc4b5db8e4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705155} {:answer/id #uuid \"f01a8bf9-fbb3-54eb-aa89-2a83be23832f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705158}] :answer-field/correct {:answer/id #uuid \"f01a8bf9-fbb3-54eb-aa89-2a83be23832f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705158} :answer-field/id #uuid \"c2021111-5e6c-5763-8665-48a0159fd9ab\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705150}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"6f5dea09-cd94-529f-9d6d-d8e5ce5fd80c\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-195^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-195^\\\\circ=30^\\\\circ-225^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-195^\\\\circ\\\\right) &=\\\\sin\\\\left(30^\\\\circ-225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)-\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6057329c-21f8-5ecf-b65d-17948a467406\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705141} {:answer/id #uuid \"caab6b1f-024b-5c23-9e09-5c662f4f2100\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186705152} {:answer/id #uuid \"cd181587-479d-5cfa-96a1-69d69603ce58\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705153} {:answer/id #uuid \"edfa5991-db74-5287-ac98-a3de7dad7032\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705157} {:answer/id #uuid \"f43fa962-e2eb-5c35-a896-ef19d3b5ad4b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705159}] :answer-field/correct {:answer/id #uuid \"edfa5991-db74-5287-ac98-a3de7dad7032\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705157} :answer-field/id #uuid \"7acf82fd-5f60-5f50-9f23-62220fe3317e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705145}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"75984562-6816-559a-9c8b-653559103938\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-15^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-15^\\\\circ=315^\\\\circ-330^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-15^\\\\circ\\\\right) &=\\\\sin\\\\left(315^\\\\circ-330^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(315^\\\\circ\\\\right)\\\\cos\\\\left(330^\\\\circ\\\\right)-\\\\cos\\\\left(315^\\\\circ\\\\right)\\\\sin\\\\left(330^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(-\\\\frac{1}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705148 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d7bc9e1-7694-5cee-b4b9-75ee88c79cc0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705133} {:answer/id #uuid \"265e13c8-d6fa-5d9c-9672-75085538a471\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705136} {:answer/id #uuid \"7dac5f99-354c-5283-ba97-9e8df58c59dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186705146} {:answer/id #uuid \"b1a94241-077d-5b26-b2bb-f9689b8ed2a8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705149} {:answer/id #uuid \"e9d8117c-aafc-58d6-bdff-0210b5a581d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705156}] :answer-field/correct {:answer/id #uuid \"265e13c8-d6fa-5d9c-9672-75085538a471\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705136} :answer-field/id #uuid \"da108e5a-18ad-56e1-88aa-33d8ceb962c2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705154}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"92d76975-8b58-54ac-82eb-73759a022070\" :question/problem \"What is the exact value of $\\\\sin\\\\left(105^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $105^\\\\circ=330^\\\\circ-225^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(105^\\\\circ\\\\right) &=\\\\sin\\\\left(330^\\\\circ-225^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(330^\\\\circ\\\\right)\\\\cos\\\\left(225^\\\\circ\\\\right)-\\\\cos\\\\left(330^\\\\circ\\\\right)\\\\sin\\\\left(225^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5eac0d84-64bd-5fb2-956a-53307782055c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705197} {:answer/id #uuid \"638bab33-bb9c-5f34-bab5-322351f38396\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186705198} {:answer/id #uuid \"85a4ffda-4106-5dd2-981e-2472a31de351\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705203} {:answer/id #uuid \"c4113e5c-1839-56cd-abb9-43c032226798\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705208} {:answer/id #uuid \"d553c03c-0d4f-5d3a-ad18-f9cf3e6ee58f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705210}] :answer-field/correct {:answer/id #uuid \"5eac0d84-64bd-5fb2-956a-53307782055c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705197} :answer-field/id #uuid \"9e5a8e44-4d48-571f-aea7-b6d526308044\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705206}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1634a943-386e-54f9-b090-bf9abaaa6de6\" :question/problem \"What is the exact value of $\\\\sin\\\\left(195^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $195^\\\\circ=225^\\\\circ-30^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(195^\\\\circ\\\\right) &=\\\\sin\\\\left(225^\\\\circ-30^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(225^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)-\\\\cos\\\\left(225^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d15e57b-c6fc-566a-9e25-d0ed36f3d4ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705188} {:answer/id #uuid \"496461da-3b90-59ef-a298-35a230b690b7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186705195} {:answer/id #uuid \"7e4eccf8-0a62-5f04-9a47-c3bf9fda7d34\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705201} {:answer/id #uuid \"85d76438-2655-5b43-8183-2c7f645ee7b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705204} {:answer/id #uuid \"e90eea08-e585-5f5f-a16d-a3e8bc2adbc9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705212}] :answer-field/correct {:answer/id #uuid \"85d76438-2655-5b43-8183-2c7f645ee7b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705204} :answer-field/id #uuid \"7a1a0c4c-fb14-53b1-ad30-cdf1735e8671\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705199}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"dadfda35-3829-550c-b028-3c80ff1951ca\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-105^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-105^\\\\circ=225^\\\\circ-330^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-105^\\\\circ\\\\right) &=\\\\sin\\\\left(225^\\\\circ-330^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(225^\\\\circ\\\\right)\\\\cos\\\\left(330^\\\\circ\\\\right)-\\\\cos\\\\left(225^\\\\circ\\\\right)\\\\sin\\\\left(330^\\\\circ\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{1}{2}\\\\right) \\\\\\\\ &=-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705213 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"150568b5-321e-5b2b-9a3a-d05ef1426d79\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705189} {:answer/id #uuid \"1e5d29d9-43f5-5eb3-bc8f-24f67da37ffb\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186705192} {:answer/id #uuid \"1f61fbd3-572c-5887-a973-54c972dbd9c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705193} {:answer/id #uuid \"7d8d19d3-efe2-57f1-acba-659059876105\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705200} {:answer/id #uuid \"c4cf03b3-d207-52f4-b32a-0b4ff4c1c631\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705209}] :answer-field/correct {:answer/id #uuid \"7d8d19d3-efe2-57f1-acba-659059876105\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705200} :answer-field/id #uuid \"fbcd20e8-2a75-5640-912e-38cc521ca72e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705215}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"eb1ea3c5-32a6-515c-8b43-7931d6692e1c\" :question/problem \"What is the exact value of $\\\\sin\\\\left(15^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $15^\\\\circ=45^\\\\circ-30^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(15^\\\\circ\\\\right) &=\\\\sin\\\\left(45^\\\\circ-30^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)-\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1df138aa-05e5-567c-a66c-f9caf5015e3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705191} {:answer/id #uuid \"5adf7cb6-245b-5a7e-b3cf-c83b1d10dd16\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705196} {:answer/id #uuid \"803f77c2-301b-5e2e-80e8-e2f31ecb3762\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705202} {:answer/id #uuid \"867b5bf6-2d0e-5ec7-8bda-658b0f3633c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186705205} {:answer/id #uuid \"b1a4afdd-14d1-58f3-901e-163cf8154476\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705207}] :answer-field/correct {:answer/id #uuid \"b1a4afdd-14d1-58f3-901e-163cf8154476\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705207} :answer-field/id #uuid \"431853cc-5e13-5e3b-84b6-1a67d720868f\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705194}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ef930dc5-9f6a-5590-a1a8-7bb3ed9e0470\" :question/problem \"What is the exact value of $\\\\sin\\\\left(-255^\\\\circ\\\\right)$ without using a calculator?\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $-255^\\\\circ=60^\\\\circ-315^\\\\circ$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(-255^\\\\circ\\\\right) &=\\\\sin\\\\left(60^\\\\circ-315^\\\\circ\\\\right) \\\\\\\\ &=\\\\sin\\\\left(60^\\\\circ\\\\right)\\\\cos\\\\left(315^\\\\circ\\\\right)-\\\\cos\\\\left(60^\\\\circ\\\\right)\\\\sin\\\\left(315^\\\\circ\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2d29c2be-a907-5b53-b049-82df061eda03\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705246} {:answer/id #uuid \"3f41fb6d-d4ef-5fc2-a670-c4c4f788b365\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705248} {:answer/id #uuid \"408793bc-d590-591f-aa43-6c620bb7435e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705249} {:answer/id #uuid \"6b4a3d61-7fa4-5ff4-8442-490258b290f5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186705253} {:answer/id #uuid \"84cb92cd-7771-5866-acc4-2fedeb16ee25\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705256}] :answer-field/correct {:answer/id #uuid \"408793bc-d590-591f-aa43-6c620bb7435e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705249} :answer-field/id #uuid \"4e7a615a-2580-57c5-960d-14c7e2d27495\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705252}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"76934c31-4987-519b-bb41-5e4cdf6610e5\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{19\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{19\\\\pi}{12}=\\\\frac{11\\\\pi}{6}-\\\\frac{\\\\pi}{4}$.*\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{19\\\\pi}{12}=\\\\frac{11\\\\pi}{6}-\\\\frac{\\\\pi}{4}$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{19\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{11\\\\pi}{6}-\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{11\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)-\\\\cos\\\\left(\\\\frac{11\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2f102d4d-ff7a-56bc-aa84-c0c45ebe9e31\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705247} {:answer/id #uuid \"40885653-e5c7-5ea9-a479-266943eb79ce\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705250} {:answer/id #uuid \"4d8d8c07-625a-521e-be19-dbbd712fbed2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705251} {:answer/id #uuid \"c68db47f-54f9-5422-a8bb-d950ff7c7731\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{4}\" :db/id 17592186705261} {:answer/id #uuid \"da2c1831-e9a5-5b0e-9847-e8eaf7359020\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705263}] :answer-field/correct {:answer/id #uuid \"da2c1831-e9a5-5b0e-9847-e8eaf7359020\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705263} :answer-field/id #uuid \"241f093f-3aeb-5245-ba8d-fdc8d16f583a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705245}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"86a6967f-c1b2-59a9-b1dd-d20c99ad7a01\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{11\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{11\\\\pi}{12}=\\\\frac{\\\\pi}{4}+\\\\frac{2\\\\pi}{3}$.*\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{11\\\\pi}{12}=\\\\frac{\\\\pi}{4}+\\\\frac{2\\\\pi}{3}$.\\n\\nRecall the sum formula for sine:\\n\\n$$\\n\\\\sin(x+y)=\\\\sin x\\\\cos y+\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{11\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{\\\\pi}{4}+\\\\frac{2\\\\pi}{3}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)+\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{2\\\\pi}{3}\\\\right) \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(-\\\\frac{1}{2}\\\\right)+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\ &=-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"} {:db/id 17592186705264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"167ba3e6-b166-5123-847d-1c9617d73207\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}}{4}\" :db/id 17592186705244} {:answer/id #uuid \"7e9086fa-b269-5ad9-b08d-ac60a2413242\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705255} {:answer/id #uuid \"86cbd4a2-ad4c-5207-a179-212f04f8860f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705258} {:answer/id #uuid \"87f4a8ba-9120-57aa-8a86-97cd7934af27\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705259} {:answer/id #uuid \"b63221ba-e41f-51e0-8fc5-ed4a81223516\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186705260}] :answer-field/correct {:answer/id #uuid \"87f4a8ba-9120-57aa-8a86-97cd7934af27\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186705259} :answer-field/id #uuid \"c717afd8-69ea-55a6-b2f2-fc9c6dd6db64\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186705262}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"f3cc533d-6704-53aa-9a3e-745ca513e58d\" :question/problem \"What is the exact value of $\\\\sin\\\\left(\\\\frac{13\\\\pi}{12}\\\\right)$ without using a calculator?\\n\\n*Hint: Use the fact that $\\\\frac{13\\\\pi}{12}=\\\\frac{11\\\\pi}{6}-\\\\frac{3\\\\pi}{4}$.*\" :question/worked-solution \"Write the angle as a sum or difference of special angles: $\\\\frac{13\\\\pi}{12}=\\\\frac{11\\\\pi}{6}-\\\\frac{3\\\\pi}{4}$.\\n\\nRecall the difference formula for sine:\\n\\n$$\\n\\\\sin(x-y)=\\\\sin x\\\\cos y-\\\\cos x\\\\sin y\\n$$\\n\\nSubstitute the signed unit-circle values, multiply, and combine:\\n\\n$$\\n\\\\begin{aligned}\\\\sin\\\\left(\\\\frac{13\\\\pi}{12}\\\\right) &=\\\\sin\\\\left(\\\\frac{11\\\\pi}{6}-\\\\frac{3\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\sin\\\\left(\\\\frac{11\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)-\\\\cos\\\\left(\\\\frac{11\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{3\\\\pi}{4}\\\\right) \\\\\\\\ &=\\\\left(-\\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\ &=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\ &=\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4}\\\\end{aligned}\\n$$\"}] :knowledge-point/title \"Finding Exact Values Using the Sum and Difference Formulas\"}",
  "records": [
