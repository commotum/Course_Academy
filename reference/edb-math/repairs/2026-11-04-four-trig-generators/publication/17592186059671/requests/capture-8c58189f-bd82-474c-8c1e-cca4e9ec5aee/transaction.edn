d3-cfb6-57c3-9f32-af02047e7567" :answer-field/key "selection"] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/type :answer-field.type/radio] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/choices "9a6bf4f3-1766-5e1f-9e9a-63379636b81d"] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/choices "599df076-5c33-5d70-92a3-e96437be6bf0"] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/choices "422b80fe-1a55-51d1-ae70-2085dc09a86a"] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/choices "053eb439-84d6-5fa6-bdd7-6ff02c5fe5b2"] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/choices "39879775-e98d-51b7-8495-422f1dcc3651"] [:db/add "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/correct "9a6bf4f3-1766-5e1f-9e9a-63379636b81d"] [:db/ensure "8c873cd3-cfb6-57c3-9f32-af02047e7567" :answer-field/validate] [:db/add "c80d2e58-ac70-5e5e-813d-4c7b8290b468" :question/id #uuid "c80d2e58-ac70-5e5e-813d-4c7b8290b468"] [:db/add "c80d2e58-ac70-5e5e-813d-4c7b8290b468" :question/problem "Simplify.\n\n$$\n\\frac{-\\cos\\left(\\frac{\\pi}{7}\\right)\\sin\\left(\\frac{\\pi}{7}\\right)}{2\\cos\\left(\\frac{2\\pi}{7}\\right)}\n$$"] [:db/add "c80d2e58-ac70-5e5e-813d-4c7b8290b468" :question/worked-solution "Put $x=\\frac{\\pi}{7}$. Recall $2\\sin x\\cos x=\\sin(2x)$.\n\n$$\n\\begin{aligned}\n\\frac{-\\sin x\\cos x}{2\\cos(2x)} &=-\\frac{1}{4}\\frac{2\\sin x\\cos x}{\\cos(2x)} \\\\ &=-\\frac{1}{4}\\frac{\\sin(2x)}{\\cos(2x)} \\\\ &=-\\frac{1}{4}\\tan(2x)\n\\end{aligned}\n$$\n\nThe denominator is nonzero, and $\\tan(2x)=\\sin(2x)/\\cos(2x)$.\n\nSubstitute $x=\\frac{\\pi}{7}$ and double the whole angle: $2x=\\frac{2\\pi}{7}$. The result is\n\n$$\n-\\frac{1}{4}\\tan\\left(\\frac{2\\pi}{7}\\right) .\n$$"] [:db/add "c80d2e58-ac70-5e5e-813d-4c7b8290b468" :question/difficulty :question.difficulty/hard] [:db/add "c80d2e58-ac70-5e5e-813d-4c7b8290b468" :question/answer-fields "8c873cd3-cfb6-57c3-9f32-af02047e7567"] [:db/en