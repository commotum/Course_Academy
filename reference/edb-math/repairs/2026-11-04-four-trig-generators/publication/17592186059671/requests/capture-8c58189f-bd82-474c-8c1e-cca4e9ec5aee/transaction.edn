-55fe-8be0-443cbc33dcc2"] [:db/add "7c944db5-a8e8-5fd3-a15b-b453ea9793dd" :answer-field/choices "7e5f0780-c48f-5163-a3f3-e11588d7285e"] [:db/add "7c944db5-a8e8-5fd3-a15b-b453ea9793dd" :answer-field/choices "464f180a-17bb-506f-93eb-0e0487a0bca0"] [:db/add "7c944db5-a8e8-5fd3-a15b-b453ea9793dd" :answer-field/choices "7b423315-da21-5bd5-9c7a-270d0a22ca32"] [:db/add "7c944db5-a8e8-5fd3-a15b-b453ea9793dd" :answer-field/choices "35f8f4a9-fcba-5b33-9e8c-b41a0694f12a"] [:db/add "7c944db5-a8e8-5fd3-a15b-b453ea9793dd" :answer-field/correct "35f8f4a9-fcba-5b33-9e8c-b41a0694f12a"] [:db/ensure "7c944db5-a8e8-5fd3-a15b-b453ea9793dd" :answer-field/validate] [:db/add "34daa134-2812-536b-a498-c1b3f613a9f5" :question/id #uuid "34daa134-2812-536b-a498-c1b3f613a9f5"] [:db/add "34daa134-2812-536b-a498-c1b3f613a9f5" :question/problem "Simplify.\n\n$$\n-\\frac{1}{2}\\left(\\sin\\left(7^\\circ\\right)-\\cos\\left(7^\\circ\\right)\\right)^2\n$$"] [:db/add "34daa134-2812-536b-a498-c1b3f613a9f5" :question/worked-solution "Put $x=7^\\circ$. Expand the square and combine the squared terms.\n\n$$\n\\begin{aligned}\n(\\sin x-\\cos x)^2 &=\\sin^2 x-2\\sin x\\cos x+\\cos^2 x \\\\ &=1-2\\sin x\\cos x \\\\ &=1-\\sin(2x)\n\\end{aligned}\n$$\n\nHere $\\sin^2 x+\\cos^2 x=1$ and $2\\sin x\\cos x=\\sin(2x)$. Multiply both terms by $-\\frac{1}{2}$.\n\nSubstitute $x=7^\\circ$ and double the whole angle: $2x=14^\\circ$. The result is\n\n$$\n-\\frac{1}{2}+\\frac{1}{2}\\sin\\left(14^\\circ\\right) .\n$$"] [:db/add "34daa134-2812-536b-a498-c1b3f613a9f5" :question/difficulty :question.difficulty/hard] [:db/add "34daa134-2812-536b-a498-c1b3f613a9f5" :question/answer-fields "7c944db5-a8e8-5fd3-a15b-b453ea9793dd"] [:db/ensure "34daa134-2812-536b-a498-c1b3f613a9f5" :question/validate] [:db/add 17592186059671 :knowledge-point/questions "34daa134-2812-536b-a498-c1b3f613a9f5"] [:db/add "a1bc3e0e-878a-5bbf-8b06-80052d569d11" :answer/id #uuid "a1bc3e0e-878a-5bbf-8b06-80052d569d11"] [:db/add "a1bc3e0e-878a-5bbf-8b06-80052