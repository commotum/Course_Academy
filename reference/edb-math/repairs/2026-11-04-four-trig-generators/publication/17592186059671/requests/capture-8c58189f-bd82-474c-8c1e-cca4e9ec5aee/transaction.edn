9-b579-5262-83dc-cd52b3595010" :answer-field/choices "03d61e2c-9335-5c0d-b330-6ee55d74b73d"] [:db/add "1c4b3189-b579-5262-83dc-cd52b3595010" :answer-field/choices "9f45e127-dbe0-5070-82ac-8a91e9553999"] [:db/add "1c4b3189-b579-5262-83dc-cd52b3595010" :answer-field/choices "951a5759-5318-574e-8593-641233583c21"] [:db/add "1c4b3189-b579-5262-83dc-cd52b3595010" :answer-field/choices "7a060f25-ef88-5a0e-af0a-d8528247c26a"] [:db/add "1c4b3189-b579-5262-83dc-cd52b3595010" :answer-field/choices "d4004487-edfd-5bcb-80de-88094e01e994"] [:db/add "1c4b3189-b579-5262-83dc-cd52b3595010" :answer-field/correct "951a5759-5318-574e-8593-641233583c21"] [:db/ensure "1c4b3189-b579-5262-83dc-cd52b3595010" :answer-field/validate] [:db/add "697e0128-090a-5e0b-b882-923e78acb21e" :question/id #uuid "697e0128-090a-5e0b-b882-923e78acb21e"] [:db/add "697e0128-090a-5e0b-b882-923e78acb21e" :question/problem "Simplify.\n\n$$\n\\left(\\sin\\left(53^\\circ\\right)-\\cos\\left(53^\\circ\\right)\\right)^2\n$$"] [:db/add "697e0128-090a-5e0b-b882-923e78acb21e" :question/worked-solution "Put $x=53^\\circ$. Expand the square and combine the squared terms.\n\n$$\n\\begin{aligned}\n(\\sin x-\\cos x)^2 &=\\sin^2 x-2\\sin x\\cos x+\\cos^2 x \\\\ &=1-2\\sin x\\cos x \\\\ &=1-\\sin(2x)\n\\end{aligned}\n$$\n\nHere $\\sin^2 x+\\cos^2 x=1$ and $2\\sin x\\cos x=\\sin(2x)$.\n\nSubstitute $x=53^\\circ$ and double the whole angle: $2x=106^\\circ$. The result is\n\n$$\n1-\\sin\\left(106^\\circ\\right) .\n$$"] [:db/add "697e0128-090a-5e0b-b882-923e78acb21e" :question/difficulty :question.difficulty/moderate] [:db/add "697e0128-090a-5e0b-b882-923e78acb21e" :question/answer-fields "1c4b3189-b579-5262-83dc-cd52b3595010"] [:db/ensure "697e0128-090a-5e0b-b882-923e78acb21e" :question/validate] [:db/add 17592186059671 :knowledge-point/questions "697e0128-090a-5e0b-b882-923e78acb21e"] [:db/add "db0b31a3-7daa-5392-8322-14849f45dd87" :answer/id #uuid "db0b31a3-7daa-5392-8322-14849f45dd87"] [:db/add "db0b31a3-7daa-5392-8322-14849