  "before_edn": "{:db/id 17592186087671 :knowledge-point/canonical-example {:db/id 17592186087479 :question/id #uuid \"e617aaf2-1232-57cc-8644-2467effda030\" :question/math-academy-id \"e-3668\" :question/problem \"Without using a calculator, find the exact value of $\\\\cos^2\\\\left( 22.5^\\\\circ\\\\right) - \\\\sin^2\\\\left( 22.5^\\\\circ\\\\right).$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n\\\\cos^2 x - \\\\sin^2 x = \\\\cos 2x\\n$$\\n\\nSubstituting $x={22.5^\\\\circ}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡({22.5}^{∘})-{\\\\sin }^{2}⁡({22.5}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {22.5}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{45}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"2902b205-4508-55c6-9a68-f57d3afc9eab\" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186699271 :question-generator/id #uuid \"5bda0d43-b583-5eec-bfd5-123f0102b54f\" :question-generator/script \"generators/d8/d8cf54d2ca00f3d82f6ff3aad01d2ebce01dd917fec367bdeab62790ebc41dd6/generator.py\"} :knowledge-point/questions [{:db/id 17592186088096 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0043b9dd-acd7-5722-ae3f-3f717ea8f717\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186288026} {:answer/id #uuid \"0fcd1b2f-6684-5235-9ad9-1439089c5d1d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186288147} {:answer/id #uuid \"2e93b461-8b28-554d-a5d3-b0197fe38c18\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186288346} {:answer/id #uuid \"38664848-58db-58e9-955b-e673ca767957\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\sqrt{3}\" :db/id 17592186288415} {:answer/id #uuid \"679b2481-2702-5446-9e64-41947ec19124\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186288759}] :answer-field/correct {:answer/id #uuid \"679b2481-2702-5446-9e64-41947ec19124\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186288759} :answer-field/id #uuid \"0e2b6c24-7b3b-5d04-808b-ab04891dc6ac\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186289763}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"baeab088-833a-54f7-96df-e4a2e1a80c83\" :question/math-academy-id \"q-24514\" :question/problem \"Find the exact value of $$\\n\\\\displaystyle {\\\\cos }^{2}⁡\\\\left(\\\\frac{\\\\pi }{12}\\\\right)-{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{12}\\\\right).\\n$$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{\\\\pi }{12}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡\\\\left(\\\\frac{\\\\pi }{12}\\\\right)-{\\\\sin }^{2}⁡\\\\left(\\\\frac{\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{\\\\pi }{12}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186088111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0c335d98-0aff-5512-8c90-fb857ce5f43e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186290690} {:answer/id #uuid \"0f5e2260-8483-51b1-bece-55704d606b17\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186290702} {:answer/id #uuid \"b76b10df-1ac1-504b-a97f-8b92f696b0d9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186291429} {:answer/id #uuid \"f27a750b-ccda-56d7-bfaf-2c1c37c66eb9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186291652} {:answer/id #uuid \"fb47e48c-4106-50e5-87c5-9d5d71d6c1ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186291697}] :answer-field/correct {:answer/id #uuid \"fb47e48c-4106-50e5-87c5-9d5d71d6c1ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186291697} :answer-field/id #uuid \"8ea8649a-e5af-5e8b-bbeb-3b924ae079e8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186292181}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a0283435-c23b-5d26-b5af-8d4a513ca18b\" :question/math-academy-id \"q-26706\" :question/problem \"Find the exact value of $1-2{\\\\sin }^{2}⁡({67.5}^{∘}).$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={67.5}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡({67.5}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {67.5}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{135}^{∘} \\\\\\\\  & =-\\\\operatorname{cos}⁡{45}^{∘} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186256399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0778ee07-8e08-5767-b5b5-39fa9f5bd3b4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186253726} {:answer/id #uuid \"3141858b-3546-56b0-a225-f1d26fc10b70\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186254099} {:answer/id #uuid \"50e838be-c2e5-56cd-bd3f-42e1ef0167bc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186254372} {:answer/id #uuid \"7bc93bfa-7e8d-5884-82ed-7bd2edacb355\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186254772} {:answer/id #uuid \"e9177016-3d33-5bdf-b43c-ff255bcb6f8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186255717}] :answer-field/correct {:answer/id #uuid \"50e838be-c2e5-56cd-bd3f-42e1ef0167bc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186254372} :answer-field/id #uuid \"32edd36e-c1e8-57b1-927a-22604b1325fd\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186256011}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"908ae38c-0e5f-5da6-8253-8eb427ca6c40\" :question/math-academy-id \"q-120367\" :question/problem \"Find the exact value of $$\\n\\\\displaystyle {\\\\cos }^{2}⁡\\\\left(\\\\frac{3\\\\pi }{8}\\\\right)-{\\\\sin }^{2}⁡\\\\left(\\\\frac{3\\\\pi }{8}\\\\right).\\n$$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{3\\\\pi }{8}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡\\\\left(\\\\frac{3\\\\pi }{8}\\\\right)-{\\\\sin }^{2}⁡\\\\left(\\\\frac{3\\\\pi }{8}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{3\\\\pi }{8}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{3\\\\pi }{4}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186256400 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8115a298-59cf-58fc-9780-43bfd440dc7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186254809} {:answer/id #uuid \"a6dd8fd3-359e-5caf-8632-dcb93f87be9b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186255142} {:answer/id #uuid \"b70ee42e-3196-506a-933d-10c437bf0f5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186255292} {:answer/id #uuid \"e2de5623-c20f-5c7f-8f5f-6797a3974a10\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255679} {:answer/id #uuid \"f13a9ca7-7626-508b-a2f5-d4bd0901acea\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255777}] :answer-field/correct {:answer/id #uuid \"f13a9ca7-7626-508b-a2f5-d4bd0901acea\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255777} :answer-field/id #uuid \"c9f715fd-d0e4-558c-8e7e-51782fd04ee2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186256281}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2db81725-7807-50fc-8c34-2ee3aee5909f\" :question/math-academy-id \"q-120368\" :question/problem \"Find the exact value of ${\\\\cos }^{2}⁡{165}^{∘}-{\\\\sin }^{2}⁡{165}^{∘}.$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={165}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡{165}^{∘}-{\\\\sin }^{2}⁡{165}^{∘} & =\\\\operatorname{cos}⁡(2\\\\cdot {165}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{330}^{∘} \\\\\\\\  & =\\\\operatorname{cos}⁡{30}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186256401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0efb571c-483a-563e-90d9-cb87e72aef2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186253800} {:answer/id #uuid \"936a3292-3003-538b-ac5a-bdafbe5c67b4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186254964} {:answer/id #uuid \"ac064fe8-638c-5851-b167-3a2d65119de0\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255189} {:answer/id #uuid \"e2d28c64-588e-564f-b3a3-554152e0f434\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186255678} {:answer/id #uuid \"f5362cb5-e5e6-5977-80e9-1d87eb6ccfaa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186255818}] :answer-field/correct {:answer/id #uuid \"ac064fe8-638c-5851-b167-3a2d65119de0\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255189} :answer-field/id #uuid \"3966172c-baa0-58e5-bb01-12250853b673\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186256026}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f9ed8218-8b72-5f11-b5f2-bf16df5e7136\" :question/math-academy-id \"q-120369\" :question/problem \"Find the exact value of $1-2{\\\\sin }^{2}⁡({75}^{∘}).$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={75}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡({75}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {75}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{150}^{∘} \\\\\\\\  & =-\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186256402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"04a787f9-cc71-5ee2-a0e1-b99585c88d53\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186253705} {:answer/id #uuid \"16d56a41-211d-5c70-8028-81878a75223d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186253866} {:answer/id #uuid \"81b5e797-3b0a-5b21-8981-ffb0b7deb98b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186254819} {:answer/id #uuid \"9a317ce9-dc1c-5e53-a908-c201f6c07a81\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255031} {:answer/id #uuid \"b3c8b4d7-5e3d-529c-932f-88f0c9e1da29\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186255254}] :answer-field/correct {:answer/id #uuid \"16d56a41-211d-5c70-8028-81878a75223d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186253866} :answer-field/id #uuid \"c7eb9b1b-f118-5a2b-a9b0-5db7af729615\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186256274}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1ee8111c-4b37-517d-b1b7-ddd1df3f014f\" :question/math-academy-id \"q-120370\" :question/problem \"Find the exact value of ${\\\\cos }^{2}⁡({157.5}^{∘})-{\\\\sin }^{2}⁡({157.5}^{∘}).$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={157.5}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡({157.5}^{∘})-{\\\\sin }^{2}⁡({157.5}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {157.5}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{315}^{∘} \\\\\\\\  & =\\\\operatorname{cos}⁡{45}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186292878 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8d2a35b5-b3fc-5870-8139-a0f009be1ae0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\" :db/id 17592186291234}] :answer-field/correct {:answer/id #uuid \"8d2a35b5-b3fc-5870-8139-a0f009be1ae0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\" :db/id 17592186291234} :answer-field/id #uuid \"040aff19-8fde-5325-9a72-92cc6df66da4\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186291746}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7227f9ac-0ffc-5d99-83ac-2d10c6986d6c\" :question/math-academy-id \"q-275706\" :question/problem \"Find the **exact** value of the expression below.\\n\\n${\\\\cos }^{4}⁡({15}^{∘})-2{\\\\cos }^{2}⁡({15}^{∘}){\\\\sin }^{2}⁡({15}^{∘})+{\\\\sin }^{4}⁡({15}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"First, notice that our expression is a perfect square that can be rewritten as follows:\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{4}⁡({15}^{∘})-2{\\\\cos }^{2}⁡({15}^{∘}){\\\\sin }^{2}⁡({15}^{∘})+{\\\\sin }^{4}⁡({15}^{∘}) & ={({\\\\cos }^{2}⁡({15}^{∘})-{\\\\sin }^{2}⁡({15}^{∘}))}^{2}\\\\end{aligned}\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={15}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡({15}^{∘})-{\\\\sin }^{2}⁡({15}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {15}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡({30}^{∘}) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}{({\\\\cos }^{2}⁡({15}^{∘})-{\\\\sin }^{2}⁡({15}^{∘}))}^{2} & ={\\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right)}^{2}=\\\\frac{3}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186304985 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a81a47c7-179d-5483-a227-55f039ceab1f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186303492}] :answer-field/correct {:answer/id #uuid \"a81a47c7-179d-5483-a227-55f039ceab1f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186303492} :answer-field/id #uuid \"b703b978-722c-5e0b-95fc-55b9de7046c9\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304571}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7557cacf-886f-55fb-9076-1837e9a0913c\" :question/math-academy-id \"q-332138\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\displaystyle {cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{8}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{8}\\\\right)=\\n$$\\n{{field-1}}\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{7\\\\pi }{8}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{8}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{8}\\\\right) & =\\\\cos \\\\,\\\\left(2\\\\cdot \\\\frac{7\\\\pi }{8}\\\\right) \\\\\\\\  & =\\\\cos \\\\,\\\\left(\\\\frac{7\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186304986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1704f202-ad10-5a8f-b37a-2571e0cb54a8\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186302606}] :answer-field/correct {:answer/id #uuid \"1704f202-ad10-5a8f-b37a-2571e0cb54a8\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186302606} :answer-field/id #uuid \"b9f219ae-f2f8-5acf-af63-4e88382630fe\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304582}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"24bac5e7-d993-51f0-aa0a-781406c4bd83\" :question/math-academy-id \"q-332139\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\displaystyle {cos}^{2}\\\\,\\\\left(\\\\frac{5\\\\pi }{12}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{5\\\\pi }{12}\\\\right)=\\n$$\\n{{field-1}}\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{5\\\\pi }{12}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{cos}^{2}\\\\,\\\\left(\\\\frac{5\\\\pi }{12}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{5\\\\pi }{12}\\\\right) & =\\\\cos \\\\,\\\\left(2\\\\cdot \\\\frac{5\\\\pi }{12}\\\\right) \\\\\\\\  & =\\\\cos \\\\,\\\\left(\\\\frac{5\\\\pi }{6}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186304987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"943ada75-e8c9-5d64-8cce-ce3d2d08c85a\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186303377}] :answer-field/correct {:answer/id #uuid \"943ada75-e8c9-5d64-8cce-ce3d2d08c85a\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186303377} :answer-field/id #uuid \"ab2517b9-ed76-5cd1-9530-d352f6239167\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304542}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"64b6ca5b-7886-5c02-8389-aebf02e6026c\" :question/math-academy-id \"q-332147\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$1-2{sin}^{2}\\\\,\\\\left(\\\\frac{5\\\\pi }{8}\\\\right)=$\\n{{field-1}}\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{5\\\\pi }{8}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{sin}^{2}\\\\,\\\\left(\\\\frac{5\\\\pi }{8}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(2\\\\cdot \\\\frac{5\\\\pi }{8}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{5\\\\pi }{4}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186304988 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7f8a4639-cf5a-5adf-a1ac-d48e128b9c09\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186303253}] :answer-field/correct {:answer/id #uuid \"7f8a4639-cf5a-5adf-a1ac-d48e128b9c09\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186303253} :answer-field/id #uuid \"48b51173-4ff4-5274-ab59-653c294a8939\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304276}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7667b041-07ed-5199-9efb-833c8da623ff\" :question/math-academy-id \"q-332148\" :question/problem \"Find the **exact** value of the expression below.\\n\\n${\\\\cos }^{4}⁡({67.5}^{∘})-2{\\\\cos }^{2}⁡({67.5}^{∘}){\\\\sin }^{2}⁡({67.5}^{∘})+{\\\\sin }^{4}⁡({67.5}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"First, notice that our expression is a perfect square that can be rewritten as follows:\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{4}⁡({67.5}^{∘})-2{\\\\cos }^{2}⁡({67.5}^{∘}){\\\\sin }^{2}⁡({67.5}^{∘})+{\\\\sin }^{4}⁡({67.5}^{∘}) & ={({\\\\cos }^{2}⁡({67.5}^{∘})-{\\\\sin }^{2}⁡({67.5}^{∘}))}^{2}\\\\end{aligned}\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={67.5}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡({67.5}^{∘})-{\\\\sin }^{2}⁡({67.5}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {67.5}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡({135}^{∘}) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}{({\\\\cos }^{2}⁡({67.5}^{∘})-{\\\\sin }^{2}⁡({67.5}^{∘}))}^{2} & ={\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)}^{2}=\\\\frac{1}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186304989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4d11a4f8-ffee-5767-9368-4c4c6f3d7aec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\" :db/id 17592186302940}] :answer-field/correct {:answer/id #uuid \"4d11a4f8-ffee-5767-9368-4c4c6f3d7aec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\" :db/id 17592186302940} :answer-field/id #uuid \"51165ca4-38a6-5ad0-bb61-4d9760434384\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304298}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f3454171-a1b3-502e-bdda-985c2af86469\" :question/math-academy-id \"q-332150\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\displaystyle {cos}^{4}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)-2{cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right){sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)+{sin}^{4}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)=\\n$$\\n{{field-1}}\" :question/worked-solution \"First, notice that our expression is a perfect square that can be rewritten as follows:\\n\\n$$\\n\\\\begin{aligned}{cos}^{4}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)-2{cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right){sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)+{sin}^{4}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right) & ={\\\\left({cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)\\\\right)}^{2}\\\\end{aligned}\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{7\\\\pi }{12}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right) & =\\\\cos \\\\,\\\\left(2\\\\cdot \\\\frac{7\\\\pi }{12}\\\\right) \\\\\\\\  & =\\\\cos \\\\,\\\\left(\\\\frac{7\\\\pi }{6}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}{\\\\left({cos}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{7\\\\pi }{12}\\\\right)\\\\right)}^{2} & ={\\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)}^{2}=\\\\frac{3}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186304990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d347f734-6ca7-5952-bea8-22d7f06f35a1\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186303767}] :answer-field/correct {:answer/id #uuid \"d347f734-6ca7-5952-bea8-22d7f06f35a1\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186303767} :answer-field/id #uuid \"f93642d3-ae42-5979-8df4-3afa14978559\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304747}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"0d3b4ee6-98d1-5207-a0a1-2482e40fe54d\" :question/math-academy-id \"q-332151\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\displaystyle {cos}^{4}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-2{cos}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right){sin}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)+{sin}^{4}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)=\\n$$\\n{{field-1}}\" :question/worked-solution \"First, notice that our expression is a perfect square that can be rewritten as follows:\\n\\n$$\\n\\\\begin{aligned}{cos}^{4}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-2{cos}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right){sin}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)+{sin}^{4}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right) & ={\\\\left({cos}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\\\\right)}^{2}\\\\end{aligned}\\n$$\\n\\nNow, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x=\\\\frac{\\\\pi }{4}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{cos}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right) & =\\\\cos \\\\,\\\\left(2\\\\cdot \\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\cos \\\\,\\\\left(\\\\frac{\\\\pi }{2}\\\\right) \\\\\\\\  & =0.\\\\end{aligned}\\n$$\\n\\nFinally, we obtain \\n\\n$$\\n\\\\begin{aligned}{\\\\left({cos}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)-{sin}^{2}\\\\,\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\\\\right)}^{2} & ={0}^{2}=0.\\\\end{aligned}\\n$$\"} {:db/id 17592186344972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"204b7397-7f5c-5030-80fc-591a56bfcf47\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186342504} {:answer/id #uuid \"2c72c70c-d4d1-5423-a197-7c87f8c25db4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186342611} {:answer/id #uuid \"397acd27-9340-5da7-b993-a94dc5cdfb94\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186342710} {:answer/id #uuid \"5f117df8-418a-5605-9136-a53d6658af50\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186343040} {:answer/id #uuid \"6adbc01f-454b-5884-bf45-1838dd101ba8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186343149}] :answer-field/correct {:answer/id #uuid \"397acd27-9340-5da7-b993-a94dc5cdfb94\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186342710} :answer-field/id #uuid \"aae57d48-55b5-5a1f-8dc9-556896931748\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344792}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e8e88b3f-3c2d-5ee4-b86c-d4867f649b19\" :question/math-academy-id \"q-7470\" :question/problem \"Find the exact value of ${\\\\cos }^{2}⁡({75}^{∘})-{\\\\sin }^{2}⁡({75}^{∘}).$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n{\\\\cos }^{2}⁡x-{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={75}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}{\\\\cos }^{2}⁡({75}^{∘})-{\\\\sin }^{2}⁡({75}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {75}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{150}^{∘} \\\\\\\\  & =-\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186344977 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"02d46c16-ac4e-57b4-ae20-20086616c19f\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186342277} {:answer/id #uuid \"24e78c28-e4f9-5764-a34b-418c159f48ec\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186342548} {:answer/id #uuid \"461de0e9-b9bb-5f6f-af7c-df1d3be102dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186342814} {:answer/id #uuid \"80b774e9-0533-56ca-9013-aade87186d21\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186343348} {:answer/id #uuid \"9d2368da-9551-54cc-b612-4a5cc5d70024\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186343622}] :answer-field/correct {:answer/id #uuid \"80b774e9-0533-56ca-9013-aade87186d21\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186343348} :answer-field/id #uuid \"a4a9942c-2ff0-547a-87bb-c11cc79e965c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186344783}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"b81c92b6-aaf0-5164-b094-1fd4bab4c1a6\" :question/math-academy-id \"q-7473\" :question/problem \"Find the exact value of $1-2{\\\\sin }^{2}⁡({22.5}^{∘}).$\" :question/worked-solution \"First, let's recall the double-angle formula for cosine:\\n\\n$$\\n1-2{\\\\sin }^{2}⁡x=\\\\operatorname{cos}⁡2x\\n$$\\n\\nSubstituting $x={22.5}^{∘}$ into the above, we get\\n\\n$$\\n\\\\begin{aligned}1-2{\\\\sin }^{2}⁡({22.5}^{∘}) & =\\\\operatorname{cos}⁡(2\\\\cdot {22.5}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{45}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186699252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6ab65652-e171-51f0-acae-5105ba02dba2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699253}] :answer-field/correct {:answer/id #uuid \"6ab65652-e171-51f0-acae-5105ba02dba2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699253} :answer-field/id #uuid \"60e899bb-1387-5d49-97ff-ab21baf2bd0e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186699251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"66eb80a9-2401-5f22-b610-dfa1293aad55\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\cos^2\\\\left(\\\\frac{7\\\\pi}{8}\\\\right)-\\\\sin^2\\\\left(\\\\frac{7\\\\pi}{8}\\\\right)=\\n$$\\n{{field-1}}\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(\\\\frac{7\\\\pi}{8}\\\\right)-\\\\sin^2\\\\left(\\\\frac{7\\\\pi}{8}\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot \\\\frac{7\\\\pi}{8}\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(\\\\frac{7\\\\pi}{4}\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\\\n&= \\\\frac{\\\\sqrt{2}}{2}\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186699259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3cf7b389-8380-509c-92a6-babc7b58128a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699245} {:answer/id #uuid \"51ce2600-76e4-5bd2-a20e-4dac013f2e0d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699248} {:answer/id #uuid \"85b1be04-215f-54f3-8e1e-8e35317f9308\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186699257} {:answer/id #uuid \"adbc056f-43da-5992-a235-cd443f48a8d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699261} {:answer/id #uuid \"d3ab8163-6378-5e95-a0f3-5bcd1c93f0a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699266}] :answer-field/correct {:answer/id #uuid \"adbc056f-43da-5992-a235-cd443f48a8d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699261} :answer-field/id #uuid \"40231008-d257-54fd-b58d-79c46ed95aaf\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186699247}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9fa4ea3e-0264-5847-9e21-df37078d86d3\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\cos^2\\\\left(112.5^\\\\circ\\\\right)-\\\\sin^2\\\\left(112.5^\\\\circ\\\\right)\\n$$\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(112.5^\\\\circ\\\\right)-\\\\sin^2\\\\left(112.5^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 112.5^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(225^\\\\circ\\\\right) \\\\\\\\\\n&= -\\\\cos\\\\left(45^\\\\circ\\\\right) \\\\\\\\\\n&= -\\\\frac{\\\\sqrt{2}}{2}\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186699260 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"972a3ea5-6347-50a5-aa81-7bc9cdd5d7e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699258}] :answer-field/correct {:answer/id #uuid \"972a3ea5-6347-50a5-aa81-7bc9cdd5d7e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699258} :answer-field/id #uuid \"6d89f8b2-7c4e-5865-b770-72eaf5d83d3e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186699254}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"a98de52d-8dd1-5ab0-99c7-0525eca4f8df\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\cos^2\\\\left(22.5^\\\\circ\\\\right)-\\\\sin^2\\\\left(22.5^\\\\circ\\\\right)=\\n$$\\n{{field-1}}\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(22.5^\\\\circ\\\\right)-\\\\sin^2\\\\left(22.5^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 22.5^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(45^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\frac{\\\\sqrt{2}}{2}\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186699263 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3ed797d0-4fff-55fc-8bb0-e46202e44553\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699246} {:answer/id #uuid \"78eb9749-98a8-512f-9f74-efc7d49611ab\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699255} {:answer/id #uuid \"794061bf-195e-5fe2-955c-a31ba232432b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186699256} {:answer/id #uuid \"b0375de5-2eae-5699-a98c-94a16524d38a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699262} {:answer/id #uuid \"f4ce19c3-6fd3-5a1b-a1bb-1a332579a770\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699267}] :answer-field/correct {:answer/id #uuid \"3ed797d0-4fff-55fc-8bb0-e46202e44553\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699246} :answer-field/id #uuid \"fff0463f-acd7-5385-8b03-07d0ce028020\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186699270}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b2151a50-3832-5bd7-bdc4-d0d04b66a266\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\cos^2\\\\left(75^\\\\circ\\\\right)-\\\\sin^2\\\\left(75^\\\\circ\\\\right)\\n$$\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(75^\\\\circ\\\\right)-\\\\sin^2\\\\left(75^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 75^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(150^\\\\circ\\\\right) \\\\\\\\\\n&= -\\\\cos\\\\left(30^\\\\circ\\\\right) \\\\\\\\\\n&= -\\\\frac{\\\\sqrt{3}}{2}\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186699269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"59bd154d-039a-5123-9428-36ae9a22490c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186699249} {:answer/id #uuid \"5c04c4b9-80de-5114-9dcc-4bf0be130c26\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699250} {:answer/id #uuid \"c1949a41-0657-5c4f-9b66-a4b2f0d314a2\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\" :db/id 17592186699264} {:answer/id #uuid \"c3ba7223-b681-5777-b508-4c5dee56746f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699265} {:answer/id #uuid \"f8ca9bf2-7d68-5625-a35f-e3704b1cc3ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699268}] :answer-field/correct {:answer/id #uuid \"f8ca9bf2-7d68-5625-a35f-e3704b1cc3ba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186699268} :answer-field/id #uuid \"2c48b6ad-4055-5d65-b98e-b25ce866c5ec\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186699244}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"ff585c8e-d692-5174-b6fd-22411e460429\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\cos^2\\\\left(165^\\\\circ\\\\right)-\\\\sin^2\\\\left(165^\\\\circ\\\\right)\\n$$\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(165^\\\\circ\\\\right)-\\\\sin^2\\\\left(165^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 165^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(330^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(30^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\frac{\\\\sqrt{3}}{2}\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186702810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2577cb59-0c54-5c9a-80aa-c4716f891a00\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186702808}] :answer-field/correct {:answer/id #uuid \"2577cb59-0c54-5c9a-80aa-c4716f891a00\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186702808} :answer-field/id #uuid \"283390d2-8a38-561c-9e79-421d57c261a7\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186702809}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e0f7b235-8ae9-5937-8e10-baa26e88faee\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^4\\\\left(\\\\frac{3\\\\pi}{4}\\\\right) \\\\\\\\\\n&\\\\quad -2\\\\cos^2\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\\\sin^2\\\\left(\\\\frac{3\\\\pi}{4}\\\\right) \\\\\\\\\\n&\\\\quad +\\\\sin^4\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)=\\n\\\\end{aligned}\\n$$\\n{{field-1}}\" :question/worked-solution \"Let $E$ denote the expression in the question. Recognize the expanded perfect square:\\n\\n$$\\n\\\\begin{aligned}\\nE &= \\\\left(\\\\cos^2\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)-\\\\sin^2\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\\\right)^2\\n\\\\end{aligned}\\n$$\\n\\nUse the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)-\\\\sin^2\\\\left(\\\\frac{3\\\\pi}{4}\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot \\\\frac{3\\\\pi}{4}\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(\\\\frac{3\\\\pi}{2}\\\\right) \\\\\\\\\\n&= 0\\n\\\\end{aligned}\\n$$\\n\\nFinally, square the value:\\n\\n$$\\n\\\\begin{aligned}\\nE &= \\\\left(0\\\\right)^2 \\\\\\\\\\n&= 0\\n\\\\end{aligned}\\n$$\"}] :knowledge-point/title \"Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula\"}",
