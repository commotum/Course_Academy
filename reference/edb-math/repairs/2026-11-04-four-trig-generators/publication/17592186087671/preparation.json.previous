  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/id #uuid \"ea4f9e73-a660-5646-aea4-7628de4d97b3\"] [:db/add \"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/type :answer.type/math] [:db/add \"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [:db/ensure \"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/validate] [:db/add \"30332f01-50d0-591f-bb59-33e892c3fde5\" :answer/id #uuid \"30332f01-50d0-591f-bb59-33e892c3fde5\"] [:db/add \"30332f01-50d0-591f-bb59-33e892c3fde5\" :answer/type :answer.type/math] [:db/add \"30332f01-50d0-591f-bb59-33e892c3fde5\" :answer/value \"\\\\frac{\\\\sqrt{2}}{2}\"] [:db/ensure \"30332f01-50d0-591f-bb59-33e892c3fde5\" :answer/validate] [:db/add \"974aa8fb-e15e-53b8-9db7-cde3162c02ff\" :answer/id #uuid \"974aa8fb-e15e-53b8-9db7-cde3162c02ff\"] [:db/add \"974aa8fb-e15e-53b8-9db7-cde3162c02ff\" :answer/type :answer.type/math] [:db/add \"974aa8fb-e15e-53b8-9db7-cde3162c02ff\" :answer/value \"-\\\\frac{\\\\sqrt{2}}{2}\"] [:db/ensure \"974aa8fb-e15e-53b8-9db7-cde3162c02ff\" :answer/validate] [:db/add \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\" :answer/id #uuid \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\"] [:db/add \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\" :answer/type :answer.type/math] [:db/add \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\" :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\"] [:db/ensure \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\" :answer/validate] [:db/add \"f52cf417-ba91-583e-9fc6-15c605c15923\" :answer/id #uuid \"f52cf417-ba91-583e-9fc6-15c605c15923\"] [:db/add \"f52cf417-ba91-583e-9fc6-15c605c15923\" :answer/type :answer.type/math] [:db/add \"f52cf417-ba91-583e-9fc6-15c605c15923\" :answer/value \"-\\\\frac{1}{2}\"] [:db/ensure \"f52cf417-ba91-583e-9fc6-15c605c15923\" :answer/validate] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/id #uuid \"3319f386-5192-550e-8071-983b2dee71bc\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/key \"selection\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/type :answer-field.type/radio] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/choices \"ea4f9e73-a660-5646-aea4-7628de4d97b3\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/choices \"30332f01-50d0-591f-bb59-33e892c3fde5\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/choices \"974aa8fb-e15e-53b8-9db7-cde3162c02ff\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/choices \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/choices \"f52cf417-ba91-583e-9fc6-15c605c15923\"] [:db/add \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/correct \"b1274eae-a2c9-5ea4-a5b6-418a5f850a25\"] [:db/ensure \"3319f386-5192-550e-8071-983b2dee71bc\" :answer-field/validate] [:db/add \"44f5ec04-b094-507a-beff-1d5d8144c102\" :question/id #uuid \"44f5ec04-b094-507a-beff-1d5d8144c102\"] [:db/add \"44f5ec04-b094-507a-beff-1d5d8144c102\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\cos^2\\\\left(105^\\\\circ\\\\right)-\\\\sin^2\\\\left(105^\\\\circ\\\\right)\\n$$\"] [:db/add \"44f5ec04-b094-507a-beff-1d5d8144c102\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(105^\\\\circ\\\\right)-\\\\sin^2\\\\left(105^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 105^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(210^\\\\circ\\\\right) \\\\\\\\\\n&= -\\\\cos\\\\left(30^\\\\circ\\\\right) \\\\\\\\\\n&= -\\\\frac{\\\\sqrt{3}}{2}\\n\\\\end{aligned}\\n$$\"] [:db/add \"44f5ec04-b094-507a-beff-1d5d8144c102\" :question/difficulty :question.difficulty/easy] [:db/add \"44f5ec04-b094-507a-beff-1d5d8144c102\" :question/answer-fields \"3319f386-5192-550e-8071-983b2dee71bc\"] [:db/ensure \"44f5ec04-b094-507a-beff-1d5d8144c102\" :question/validate] [:db/add 17592186087671 :knowledge-point/questions \"44f5ec04-b094-507a-beff-1d5d8144c102\"] [:db/add \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\" :answer/id #uuid \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\"] [:db/add \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\" :answer/type :answer.type/math] [:db/add \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [:db/ensure \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\" :answer/validate] [:db/add \"b986ae9e-4087-54bd-b45f-4652562f4456\" :answer-field/id #uuid \"b986ae9e-4087-54bd-b45f-4652562f4456\"] [:db/add \"b986ae9e-4087-54bd-b45f-4652562f4456\" :answer-field/key \"field-1\"] [:db/add \"b986ae9e-4087-54bd-b45f-4652562f4456\" :answer-field/type :answer-field.type/blank] [:db/add \"b986ae9e-4087-54bd-b45f-4652562f4456\" :answer-field/choices \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\"] [:db/add \"b986ae9e-4087-54bd-b45f-4652562f4456\" :answer-field/correct \"abca0a98-3a7c-59cf-9ca1-fafec142d1fd\"] [:db/ensure \"b986ae9e-4087-54bd-b45f-4652562f4456\" :answer-field/validate] [:db/add \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\" :question/id #uuid \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\"] [:db/add \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n2\\\\cos^2\\\\left(15^\\\\circ\\\\right)-1=\\n$$\\n{{field-1}}\"] [:db/add \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\" :question/worked-solution \"Use the cosine double-angle identity:\\n\\n$$\\n2\\\\cos^2\\\\left(x\\\\right)-1=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&2\\\\cos^2\\\\left(15^\\\\circ\\\\right)-1 \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 15^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(30^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\frac{\\\\sqrt{3}}{2}\\n\\\\end{aligned}\\n$$\"] [:db/add \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\" :question/difficulty :question.difficulty/moderate] [:db/add \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\" :question/answer-fields \"b986ae9e-4087-54bd-b45f-4652562f4456\"] [:db/ensure \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\" :question/validate] [:db/add 17592186087671 :knowledge-point/questions \"7b49733d-b3b2-51bc-8e25-b9e8f9358d07\"] [:db/add \"17606882-795c-5b1c-bf33-dc12266ad96f\" :answer/id #uuid \"17606882-795c-5b1c-bf33-dc12266ad96f\"] [:db/add \"17606882-795c-5b1c-bf33-dc12266ad96f\" :answer/type :answer.type/math] [:db/add \"17606882-795c-5b1c-bf33-dc12266ad96f\" :answer/value \"\\\\frac{3}{4}\"] [:db/ensure \"17606882-795c-5b1c-bf33-dc12266ad96f\" :answer/validate] [:db/add \"fb340e38-8dd4-5b77-a433-f4428ee9543a\" :answer-field/id #uuid \"fb340e38-8dd4-5b77-a433-f4428ee9543a\"] [:db/add \"fb340e38-8dd4-5b77-a433-f4428ee9543a\" :answer-field/key \"field-1\"] [:db/add \"fb340e38-8dd4-5b77-a433-f4428ee9543a\" :answer-field/type :answer-field.type/blank] [:db/add \"fb340e38-8dd4-5b77-a433-f4428ee9543a\" :answer-field/choices \"17606882-795c-5b1c-bf33-dc12266ad96f\"] [:db/add \"fb340e38-8dd4-5b77-a433-f4428ee9543a\" :answer-field/correct \"17606882-795c-5b1c-bf33-dc12266ad96f\"] [:db/ensure \"fb340e38-8dd4-5b77-a433-f4428ee9543a\" :answer-field/validate] [:db/add \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\" :question/id #uuid \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\"] [:db/add \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\" :question/problem \"Without using a calculator, find the **exact** value.\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^4\\\\left(15^\\\\circ\\\\right) \\\\\\\\\\n&\\\\quad -2\\\\cos^2\\\\left(15^\\\\circ\\\\right)\\\\sin^2\\\\left(15^\\\\circ\\\\right) \\\\\\\\\\n&\\\\quad +\\\\sin^4\\\\left(15^\\\\circ\\\\right)=\\n\\\\end{aligned}\\n$$\\n{{field-1}}\"] [:db/add \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\" :question/worked-solution \"Let $E$ denote the expression in the question. Recognize the expanded perfect square:\\n\\n$$\\n\\\\begin{aligned}\\nE &= \\\\left(\\\\cos^2\\\\left(15^\\\\circ\\\\right)-\\\\sin^2\\\\left(15^\\\\circ\\\\right)\\\\right)^2\\n\\\\end{aligned}\\n$$\\n\\nUse the cosine double-angle identity:\\n\\n$$\\n\\\\cos^2\\\\left(x\\\\right)-\\\\sin^2\\\\left(x\\\\right)=\\\\cos(2x)\\n$$\\n\\nSubstitute the angle and evaluate the standard-angle cosine:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos^2\\\\left(15^\\\\circ\\\\right)-\\\\sin^2\\\\left(15^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(2\\\\cdot 15^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\cos\\\\left(30^\\\\circ\\\\right) \\\\\\\\\\n&= \\\\frac{\\\\sqrt{3}}{2}\\n\\\\end{aligned}\\n$$\\n\\nFinally, square the value:\\n\\n$$\\n\\\\begin{aligned}\\nE &= \\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right)^2 \\\\\\\\\\n&= \\\\frac{3}{4}\\n\\\\end{aligned}\\n$$\"] [:db/add \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\" :question/difficulty :question.difficulty/hard] [:db/add \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\" :question/answer-fields \"fb340e38-8dd4-5b77-a433-f4428ee9543a\"] [:db/ensure \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\" :question/validate] [:db/add 17592186087671 :knowledge-point/questions \"284fa8b1-a821-55e3-a0ff-4cb6b704414a\"] [:db/add \"generator\" :question-generator/id #uuid \"270a33a7-6203-5a32-80c4-dfd3d40556c2\"] [:db/add \"generator\" :question-generator/script \"generators/06/0662caf122bf49285656896e1b884ddc5bc8b24f21bca7e483b3a95d3d0fb773/generator.py\"] [:db/add 17592186087671 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186087671 :knowledge-point/validate]] \"assertions\" [[\"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/id #uuid \"ea4f9e73-a660-5646-aea4-7628de4d97b3\"] [\"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/type :answer.type/math] [\"ea4f9e73-a660-5646-aea4-7628de4d97b3\" :answer/value \"\\\\frac{\\\\sqrt{3}}{2}\"] [\"30332f01-50d0-591f-bb59-33e892c3fde5\" :answer/id #uuid \"30332f01-50d0-591f-bb59-33e892c3fde5\"] [\"30332f01-50d0-591f-bb59-33e892c3fde5\" :answer/type :answer.type/math] [