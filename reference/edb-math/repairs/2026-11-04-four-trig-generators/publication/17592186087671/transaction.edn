f33-dc12266ad96f"] [:db/add "17606882-795c-5b1c-bf33-dc12266ad96f" :answer/type :answer.type/math] [:db/add "17606882-795c-5b1c-bf33-dc12266ad96f" :answer/value "\\frac{3}{4}"] [:db/ensure "17606882-795c-5b1c-bf33-dc12266ad96f" :answer/validate] [:db/add "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/id #uuid "fb340e38-8dd4-5b77-a433-f4428ee9543a"] [:db/add "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/key "field-1"] [:db/add "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/type :answer-field.type/blank] [:db/add "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/choices "17606882-795c-5b1c-bf33-dc12266ad96f"] [:db/add "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/correct "17606882-795c-5b1c-bf33-dc12266ad96f"] [:db/ensure "fb340e38-8dd4-5b77-a433-f4428ee9543a" :answer-field/validate] [:db/add "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/id #uuid "284fa8b1-a821-55e3-a0ff-4cb6b704414a"] [:db/add "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/problem "Without using a calculator, find the **exact** value.\n\n$$\n\\begin{aligned}\n&\\cos^4\\left(15^\\circ\\right) \\\\\n&\\quad -2\\cos^2\\left(15^\\circ\\right)\\sin^2\\left(15^\\circ\\right) \\\\\n&\\quad +\\sin^4\\left(15^\\circ\\right)=\n\\end{aligned}\n$$\n{{field-1}}"] [:db/add "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/worked-solution "Let $E$ denote the expression in the question. Recognize the expanded perfect square:\n\n$$\n\\begin{aligned}\nE &= \\left(\\cos^2\\left(15^\\circ\\right)-\\sin^2\\left(15^\\circ\\right)\\right)^2\n\\end{aligned}\n$$\n\nUse the cosine double-angle identity:\n\n$$\n\\cos^2\\left(x\\right)-\\sin^2\\left(x\\right)=\\cos(2x)\n$$\n\nSubstitute the angle and evaluate the standard-angle cosine:\n\n$$\n\\begin{aligned}\n&\\cos^2\\left(15^\\circ\\right)-\\sin^2\\left(15^\\circ\\right) \\\\\n&= \\cos\\left(2\\cdot 15^\\circ\\right) \\\\\n&= \\cos\\left(30^\\circ\\right) \\\\\n&= \\frac{\\sqrt{3}}{2}\n\\end{aligned}\n$$\n\nFinally, square the value:\n\n$$\n\\begin{aligned}\nE &= \\left(\\frac{\\sqrt{3}}{2}\\right)^2 \\\\\n&= \\frac{3}{4}\n\\end{aligned}\n$$"] [:db/add "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/difficulty :question.difficulty/hard] [:db/add "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/answer-fields "fb340e38-8dd4-5b77-a433-f4428ee9543a"] [:db/ensure "284fa8b1-a821-55e3-a0ff-4cb6b704414a" :question/validate] [:db/add 17592186087671 :knowledge-point/questions "284fa8b1-a821-55e3-a0ff-4cb6b704414a"] [:db/add "generator" :question-generator/id #uuid "270a33a7-6203-5a32-80c4-dfd3d40556c2"] [:db/add "generator" :question-generator/script "generators/06/0662caf122bf49285656896e1b884ddc5bc8b24f21bca7e483b3a95d3d0fb773/generator.py"] [:db/add 17592186087671 :knowledge-point/question-generator "generator"] [:db/ensure 17592186087671 :knowledge-point/validate] [:db/cas 17592186699252 :question/retired nil true] [:db/cas 17592186699259 :question/retired nil true] [:db/cas 17592186699260 :question/retired nil true] [:db/cas 17592186699263 :question/retired nil true] [:db/cas 17592186699269 :question/retired nil true] [:db/cas 17592186702810 :question/retired nil true]]
