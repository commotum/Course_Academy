92-550e-8071-983b2dee71bc" :answer-field/choices "ea4f9e73-a660-5646-aea4-7628de4d97b3"] [:db/add "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/choices "30332f01-50d0-591f-bb59-33e892c3fde5"] [:db/add "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/choices "974aa8fb-e15e-53b8-9db7-cde3162c02ff"] [:db/add "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/choices "b1274eae-a2c9-5ea4-a5b6-418a5f850a25"] [:db/add "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/choices "f52cf417-ba91-583e-9fc6-15c605c15923"] [:db/add "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/correct "b1274eae-a2c9-5ea4-a5b6-418a5f850a25"] [:db/ensure "3319f386-5192-550e-8071-983b2dee71bc" :answer-field/validate] [:db/add "44f5ec04-b094-507a-beff-1d5d8144c102" :question/id #uuid "44f5ec04-b094-507a-beff-1d5d8144c102"] [:db/add "44f5ec04-b094-507a-beff-1d5d8144c102" :question/problem "Without using a calculator, find the **exact** value.\n\n$$\n\\cos^2\\left(105^\\circ\\right)-\\sin^2\\left(105^\\circ\\right)\n$$"] [:db/add "44f5ec04-b094-507a-beff-1d5d8144c102" :question/worked-solution "Use the cosine double-angle identity:\n\n$$\n\\cos^2\\left(x\\right)-\\sin^2\\left(x\\right)=\\cos(2x)\n$$\n\nSubstitute the angle and evaluate the standard-angle cosine:\n\n$$\n\\begin{aligned}\n&\\cos^2\\left(105^\\circ\\right)-\\sin^2\\left(105^\\circ\\right) \\\\\n&= \\cos\\left(2\\cdot 105^\\circ\\right) \\\\\n&= \\cos\\left(210^\\circ\\right) \\\\\n&= -\\cos\\left(30^\\circ\\right) \\\\\n&= -\\frac{\\sqrt{3}}{2}\n\\end{aligned}\n$$"] [:db/add "44f5ec04-b094-507a-beff-1d5d8144c102" :question/difficulty :question.difficulty/easy] [:db/add "44f5ec04-b094-507a-beff-1d5d8144c102" :question/answer-fields "3319f386-5192-550e-8071-983b2dee71bc"] [:db/ensure "44f5ec04-b094-507a-beff-1d5d8144c102" :question/validate] [:db/add 17592186087671 :knowledge-point/questions "44f5ec04-b094-507a-beff-1d5d8144c102"] [:db/add "abca0a98-3a7c-59cf-9ca1-fafec142d1fd" :answer/id #uuid "abca0a98-3a7c-59cf-9ca1-