right)\n$$\n\nSubstitute the signed special-angle values and combine:\n\n$$\n\\begin{aligned}\n&=\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\\n&=\\frac{\\sqrt{6}}{4}-\\frac{\\sqrt{2}}{4} \\\\\n&=\\frac{- \\sqrt{2} + \\sqrt{6}}{4}.\n\\end{aligned}\n$$"] [:db/add "5b10f18d-fff7-5deb-ab4b-e20e51b8a320" :question/difficulty :question.difficulty/easy] [:db/add "5b10f18d-fff7-5deb-ab4b-e20e51b8a320" :question/answer-fields "2a987957-4d07-5536-a788-11dd5bbd0230"] [:db/ensure "5b10f18d-fff7-5deb-ab4b-e20e51b8a320" :question/validate] [:db/add 17592186059666 :knowledge-point/questions "5b10f18d-fff7-5deb-ab4b-e20e51b8a320"] [:db/add "cb604c69-c91c-5034-9d03-c90a4dc5e808" :answer/id #uuid "cb604c69-c91c-5034-9d03-c90a4dc5e808"] [:db/add "cb604c69-c91c-5034-9d03-c90a4dc5e808" :answer/type :answer.type/math] [:db/add "cb604c69-c91c-5034-9d03-c90a4dc5e808" :answer/value "\\frac{- \\sqrt{2} + \\sqrt{6}}{4}"] [:db/ensure "cb604c69-c91c-5034-9d03-c90a4dc5e808" :answer/validate] [:db/add "7e8457da-5e2d-50d4-9d68-fa52069cd4bb" :answer/id #uuid "7e8457da-5e2d-50d4-9d68-fa52069cd4bb"] [:db/add "7e8457da-5e2d-50d4-9d68-fa52069cd4bb" :answer/type :answer.type/math] [:db/add "7e8457da-5e2d-50d4-9d68-fa52069cd4bb" :answer/value "\\frac{\\sqrt{2} + \\sqrt{6}}{4}"] [:db/ensure "7e8457da-5e2d-50d4-9d68-fa52069cd4bb" :answer/validate] [:db/add "6e86f9f2-59e4-59b3-9d32-445dd1c0e361" :answer/id #uuid "6e86f9f2-59e4-59b3-9d32-445dd1c0e361"] [:db/add "6e86f9f2-59e4-59b3-9d32-445dd1c0e361" :answer/type :answer.type/math] [:db/add "6e86f9f2-59e4-59b3-9d32-445dd1c0e361" :answer/value "- \\frac{\\sqrt{2} + \\sqrt{6}}{4}"] [:db/ensure "6e86f9f2-59e4-59b3-9d32-445dd1c0e361" :answer/validate] [:db/add "c124f2e6-cb18-5067-9357-512ac13369a8" :answer/id #uuid "c124f2e6-cb18-5067-9357-512ac13369a8"] [:db/add "c124f2e6-cb18-5067-9357-512ac13369a8" :answer/type :answer.type/math] [:db/add "c124f2e6-cb18-5067-9357-512ac13369a8" :answer/value "\\frac{- \\sqrt{6} + 