 \\\\\n&=- \\frac{\\sqrt{2} + \\sqrt{6}}{4}.\n\\end{aligned}\n$$"] [:db/add "f6792163-892d-567c-8d26-c5674dc37aa7" :question/difficulty :question.difficulty/easy] [:db/add "f6792163-892d-567c-8d26-c5674dc37aa7" :question/answer-fields "d10634b3-458c-59d8-9b38-ec472b8b9fbb"] [:db/ensure "f6792163-892d-567c-8d26-c5674dc37aa7" :question/validate] [:db/add 17592186059666 :knowledge-point/questions "f6792163-892d-567c-8d26-c5674dc37aa7"] [:db/add "4a0b0e7b-1827-5173-80d7-774275899c22" :answer/id #uuid "4a0b0e7b-1827-5173-80d7-774275899c22"] [:db/add "4a0b0e7b-1827-5173-80d7-774275899c22" :answer/type :answer.type/math] [:db/add "4a0b0e7b-1827-5173-80d7-774275899c22" :answer/value "\\frac{- \\sqrt{2} + \\sqrt{6}}{4}"] [:db/ensure "4a0b0e7b-1827-5173-80d7-774275899c22" :answer/validate] [:db/add "623ea438-0523-5cba-bc4a-49bacb2c61c7" :answer/id #uuid "623ea438-0523-5cba-bc4a-49bacb2c61c7"] [:db/add "623ea438-0523-5cba-bc4a-49bacb2c61c7" :answer/type :answer.type/math] [:db/add "623ea438-0523-5cba-bc4a-49bacb2c61c7" :answer/value "\\frac{\\sqrt{2} + \\sqrt{6}}{4}"] [:db/ensure "623ea438-0523-5cba-bc4a-49bacb2c61c7" :answer/validate] [:db/add "e5659820-74ad-57be-bd5b-d46845d9e540" :answer/id #uuid "e5659820-74ad-57be-bd5b-d46845d9e540"] [:db/add "e5659820-74ad-57be-bd5b-d46845d9e540" :answer/type :answer.type/math] [:db/add "e5659820-74ad-57be-bd5b-d46845d9e540" :answer/value "- \\frac{\\sqrt{2} + \\sqrt{6}}{4}"] [:db/ensure "e5659820-74ad-57be-bd5b-d46845d9e540" :answer/validate] [:db/add "7cd96ec1-a01c-5171-8679-00e9f54f55a7" :answer/id #uuid "7cd96ec1-a01c-5171-8679-00e9f54f55a7"] [:db/add "7cd96ec1-a01c-5171-8679-00e9f54f55a7" :answer/type :answer.type/math] [:db/add "7cd96ec1-a01c-5171-8679-00e9f54f55a7" :answer/value "\\frac{- \\sqrt{6} + \\sqrt{2}}{4}"] [:db/ensure "7cd96ec1-a01c-5171-8679-00e9f54f55a7" :answer/validate] [:db/add "22710d1e-ed92-5109-9ea1-15848e7bae8b" :answer/id #uuid "22710d1e-ed92-5109-9ea1-15848e7bae8b"] [:db/add "22710d1e-ed92-5109-9ea1-15848e7bae