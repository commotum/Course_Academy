  "before_edn": "{:db/id 17592186059666 :knowledge-point/canonical-example {:db/id 17592186059497 :question/id #uuid \"bdb79801-7c8f-5b39-8730-85dcc3d9cdd0\" :question/math-academy-id \"e-3523\" :question/problem \"Find the exact value of $\\\\cos \\\\left( -\\\\dfrac{\\\\pi}{12} \\\\right).$\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle -\\\\dfrac{\\\\pi}{12} = \\\\dfrac{\\\\pi}{6} - \\\\dfrac{\\\\pi}{4}.\\n$$*\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x - y) = \\\\cos{x}\\\\cos{y} + \\\\sin{x}\\\\sin{y}\\n$$\\n\\nApplying the difference formula for cosine with $x = \\\\dfrac{\\\\pi}{6}$ and $y = \\\\dfrac{\\\\pi}{4},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}⁡\\\\left(-\\\\frac{\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{6}-\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)+\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"283415d8-47d7-5d42-8836-0c0b0c4efc85\" :knowledge-point/key-prerequisites [{:db/id 17592186049923 :topic/id #uuid \"1ed8dd8d-e728-5e57-81fe-a7c1a6a08469\" :topic/knowledge-points [{:db/id 17592186124481} {:db/id 17592186124482} {:db/id 17592186124483}] :topic/math-academy-id 1927 :topic/next [{:db/id 17592186048132} {:db/id 17592186048187} {:db/id 17592186048702} {:db/id 17592186048868} {:db/id 17592186048952} {:db/id 17592186049029} {:db/id 17592186049067} {:db/id 17592186049878} {:db/id 17592186049999} {:db/id 17592186050341} {:db/id 17592186050496}] :topic/title \"The Product Rule for Radicals\"} {:db/id 17592186050848 :topic/id #uuid \"6b88d999-b59b-5a39-b090-40b21de4e2a4\" :topic/knowledge-points [{:db/id 17592186184141} {:db/id 17592186184205}] :topic/math-academy-id 3766 :topic/next [{:db/id 17592186048319} {:db/id 17592186048329} {:db/id 17592186049773} {:db/id 17592186049940} {:db/id 17592186050242} {:db/id 17592186050276} {:db/id 17592186050938}] :topic/title \"Evaluating Trigonometric Expressions\"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186715295 :question-generator/id #uuid \"bf912e29-9c05-52a9-86da-98bf433aa790\" :question-generator/script \"generators/50/508381f702e2b5e4baaf04f9417fdd31cc3c9973e2ce7d911dfdaa6d8af660ac/generator.py\"} :knowledge-point/questions [{:db/id 17592186060115 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9cd79ff3-6fcd-5363-a542-26fb10e08168\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3} - \\\\sqrt{2}}{4}\" :db/id 17592186057049} {:answer/id #uuid \"e7358caa-a04b-5a28-a4bc-d63797cb47cd\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{3}\" :db/id 17592186057050} {:answer/id #uuid \"eef3db50-1fc7-540d-b863-f05bd8847594\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} - \\\\sqrt{6}}{4}\" :db/id 17592186057051} {:answer/id #uuid \"0998843d-7596-5042-bc3e-c7eb87f976af\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3} + \\\\sqrt{2}}{4}\" :db/id 17592186057052} {:answer/id #uuid \"432fa2dc-4dd9-5652-8eea-947857c63f2e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186057053}] :answer-field/id #uuid \"e15470ae-d6b2-53b9-ac39-ed66f65ab18c\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186057048}] :question/id #uuid \"77444f38-cac9-5d6a-8c97-90a36461067e\" :question/math-academy-id \"q-1716\" :question/problem \"Find the exact value of $\\\\cos \\\\left(\\\\frac{7π}{12}\\\\right)$.\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle \\\\frac{7π}{12} = \\\\frac{π}{3} + \\\\frac{π}{4}.\\n$$*\"} {:db/id 17592186060357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"c22c1b3d-aa1a-55cd-a95e-5d8ca0929cd0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} - \\\\sqrt{6}}{4}\" :db/id 17592186058765} {:answer/id #uuid \"c450acf9-b6b3-51f2-8dd8-6904b20bd530\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3} + \\\\sqrt{2}}{2}\" :db/id 17592186058766} {:answer/id #uuid \"e1a436f9-6c64-5e68-8737-3539a6edad5e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3} - \\\\sqrt{2}}{2}\" :db/id 17592186058767} {:answer/id #uuid \"420fc568-6caf-5e60-bfb9-1b8280c9a41d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6} - \\\\sqrt{2}}{4}\" :db/id 17592186058768} {:answer/id #uuid \"5193862b-ccfa-5b8f-9cff-b49fff460eed\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186058769}] :answer-field/id #uuid \"fef77f27-0b44-587e-8cd3-0d25684a9902\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186058764}] :question/id #uuid \"b63851da-4dfe-541b-a499-12ca2fe2b084\" :question/math-academy-id \"q-65555\" :question/problem \"Find the exact value of $\\\\cos 285^{∘}$.\\n\\n*Hint: Use the fact that $285^{∘} = 240^{∘} + 45^{∘}$.*\"} {:db/id 17592186233270 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"42e12840-e254-5d23-8205-fd6d9545a4e4\" :question/math-academy-id \"q-119481\" :question/problem \"Find the exact value of $\\\\operatorname{cos}(-{75}^{∘}).$\\n\\n*Hint: Use the fact that $-{75}^{∘}={60}^{∘}-{135}^{∘}.$*\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x-y)=\\\\operatorname{cos}x\\\\operatorname{cos}y+\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the difference formula for cosine with $x={60}^{∘}$ and $y={135}^{∘},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}(-{75}^{∘}) & =\\\\operatorname{cos}({60}^{∘}-{135}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}{60}^{∘}\\\\operatorname{cos}{135}^{∘}+\\\\operatorname{sin}{60}^{∘}\\\\operatorname{sin}{135}^{∘} \\\\\\\\  & =\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233852 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ffe742bc-c810-5bfc-ae08-cf12baee8500\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186232713}] :answer-field/correct {:answer/id #uuid \"ffe742bc-c810-5bfc-ae08-cf12baee8500\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186232713} :answer-field/id #uuid \"fa940d42-97be-559a-9a9e-a71e2702f78f\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232712}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b67c309d-f1ce-5ff4-97dc-3605a30b0439\" :question/math-academy-id \"q-332487\" :question/problem \"Using the fact that $$\\n\\\\displaystyle \\\\frac{11\\\\pi }{12}=\\\\frac{3\\\\pi }{4}+\\\\frac{\\\\pi }{6},\\n$$\\ncalculate the **exact** value of $\\\\operatorname{cos}\\\\left(\\\\frac{11\\\\pi }{12}\\\\right).$\\n\\n$\\\\operatorname{cos}\\\\left(\\\\frac{11\\\\pi }{12}\\\\right)=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x+y)=\\\\operatorname{cos}x\\\\operatorname{cos}y-\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for cosine with $x=\\\\frac{3\\\\pi }{4}$ and $y=\\\\frac{\\\\pi }{6}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}\\\\left(\\\\frac{11\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}\\\\left(\\\\frac{3\\\\pi }{4}+\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}\\\\left(\\\\frac{3\\\\pi }{4}\\\\right)\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{6}\\\\right)-\\\\operatorname{sin}\\\\left(\\\\frac{3\\\\pi }{4}\\\\right)\\\\operatorname{sin}\\\\left(\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233853 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9c2081ac-016b-5596-b46b-59171b11fa5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186232715}] :answer-field/correct {:answer/id #uuid \"9c2081ac-016b-5596-b46b-59171b11fa5f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186232715} :answer-field/id #uuid \"3fe15bf4-bc0c-5ade-a990-0bea34e15590\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232714}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e4605c71-e2bc-5367-b6ca-7ac14bd5654c\" :question/math-academy-id \"q-332488\" :question/problem \"Using the fact that $$\\n\\\\displaystyle \\\\frac{17\\\\pi }{12}=\\\\frac{3\\\\pi }{4}+\\\\frac{2\\\\pi }{3},\\n$$\\ncalculate the **exact** value of $\\\\operatorname{cos}\\\\left(\\\\frac{17\\\\pi }{12}\\\\right).$\\n\\n$\\\\operatorname{cos}\\\\left(\\\\frac{17\\\\pi }{12}\\\\right)=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x+y)=\\\\operatorname{cos}x\\\\operatorname{cos}y-\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for cosine with $x=\\\\frac{3\\\\pi }{4}$ and $y=\\\\frac{2\\\\pi }{3}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}\\\\left(\\\\frac{17\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}\\\\left(\\\\frac{3\\\\pi }{4}+\\\\frac{2\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}\\\\left(\\\\frac{3\\\\pi }{4}\\\\right)\\\\operatorname{cos}\\\\left(\\\\frac{2\\\\pi }{3}\\\\right)-\\\\operatorname{sin}\\\\left(\\\\frac{3\\\\pi }{4}\\\\right)\\\\operatorname{sin}\\\\left(\\\\frac{2\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\left(-\\\\frac{1}{2}\\\\right)-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a7e47e92-a913-58e7-bc41-07c0a22f2626\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186232717}] :answer-field/correct {:answer/id #uuid \"a7e47e92-a913-58e7-bc41-07c0a22f2626\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186232717} :answer-field/id #uuid \"8473b400-0e3d-5e1d-8ec8-178ef51da3ee\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232716}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"acc1e027-711e-56dc-aafe-c425c5c217bb\" :question/math-academy-id \"q-332492\" :question/problem \"Using the fact that ${75}^{∘}={45}^{∘}+{30}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{cos}({75}^{∘}).$\\n\\n$\\\\operatorname{cos}({75}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x+y)=\\\\operatorname{cos}x\\\\operatorname{cos}y-\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for cosine with $x={45}^{∘}$ and $y={30}^{∘}$, we obtain\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}({75}^{∘}) & =\\\\operatorname{cos}({45}^{∘}+{30}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}({45}^{∘})\\\\operatorname{cos}({30}^{∘})-\\\\operatorname{sin}({45}^{∘})\\\\operatorname{sin}({30}^{∘}) \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a351893f-dedd-55b4-841a-6e74145b4c7d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186232719}] :answer-field/correct {:answer/id #uuid \"a351893f-dedd-55b4-841a-6e74145b4c7d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186232719} :answer-field/id #uuid \"71c44759-a2b9-551e-8f99-999c6e888bee\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232718}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ee2206e0-9825-56e9-b775-43a2d0447c20\" :question/math-academy-id \"q-332497\" :question/problem \"Using the fact that $-{165}^{∘}={60}^{∘}-{225}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{cos}(-{165}^{∘}).$\\n\\n$\\\\operatorname{cos}(-{165}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x-y)=\\\\operatorname{cos}x\\\\operatorname{cos}y+\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for cosine with $x={60}^{∘}$ and $y={225}^{∘},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}(-{165}^{∘}) & =\\\\operatorname{cos}({60}^{∘}-{225}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}({60}^{∘})\\\\operatorname{cos}({225}^{∘})+\\\\operatorname{sin}({60}^{∘})\\\\operatorname{sin}({225}^{∘}) \\\\\\\\  & =\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186233856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8ecb0ced-6f35-5743-b44e-663b8ffbfe91\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186232721}] :answer-field/correct {:answer/id #uuid \"8ecb0ced-6f35-5743-b44e-663b8ffbfe91\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\" :db/id 17592186232721} :answer-field/id #uuid \"75bfaeb4-219b-516c-a58d-558034596152\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186232720}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"cb9a138e-76d2-528f-b913-b0fc66fe6f14\" :question/math-academy-id \"q-332500\" :question/problem \"Using the fact that ${120}^{∘}={150}^{∘}-{30}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{cos}({120}^{∘}).$\\n\\n$\\\\operatorname{cos}({120}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x-y)=\\\\operatorname{cos}x\\\\operatorname{cos}y+\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for cosine with $x={150}^{∘}$ and $y={30}^{∘},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}({120}^{∘}) & =\\\\operatorname{cos}({150}^{∘}-{30}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}({150}^{∘})\\\\operatorname{cos}({30}^{∘})+\\\\operatorname{sin}({150}^{∘})\\\\operatorname{sin}({30}^{∘}) \\\\\\\\  & =\\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}+\\\\frac{1}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =-\\\\frac{3}{4}+\\\\frac{1}{4} \\\\\\\\  & =-\\\\frac{1}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186234045 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f39fa11c-0222-54e9-8d62-4eb053a5813d\" :question/math-academy-id \"q-43381\" :question/problem \"Find the exact value of $\\\\operatorname{cos}{165}^{∘}.$\\n\\n*Hint: Use the fact that ${165}^{∘}={120}^{∘}+{45}^{∘}.$*\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x+y)=\\\\operatorname{cos}x\\\\operatorname{cos}y-\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the sum formula for cosine with $x={120}^{∘}$ and $y={45}^{∘}$, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}({165}^{∘}) & =\\\\operatorname{cos}({120}^{∘}+{45}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}{120}^{∘}\\\\operatorname{cos}{45}^{∘}-\\\\operatorname{sin}{120}^{∘}\\\\operatorname{sin}{45}^{∘} \\\\\\\\  & =-\\\\frac{1}{2}\\\\cdot \\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186234179 :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f08e504a-4e7b-5af5-bce4-4991a275c783\" :question/math-academy-id \"q-65551\" :question/problem \"Find the exact value of $\\\\operatorname{cos}\\\\left(\\\\frac{13\\\\pi }{12}\\\\right).$\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle \\\\frac{13\\\\pi }{12}=\\\\frac{5\\\\pi }{4}-\\\\frac{\\\\pi }{6}.\\n$$*\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x-y)=\\\\operatorname{cos}x\\\\operatorname{cos}y+\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the difference formula for cosine with $x=\\\\frac{5\\\\pi }{4}$ and $y=\\\\frac{\\\\pi }{6}$, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}\\\\left(\\\\frac{13\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}\\\\left(\\\\frac{5\\\\pi }{4}-\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}\\\\left(\\\\frac{5\\\\pi }{4}\\\\right)\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{6}\\\\right)+\\\\operatorname{sin}\\\\left(\\\\frac{5\\\\pi }{4}\\\\right)\\\\operatorname{sin}\\\\left(\\\\frac{\\\\pi }{6}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186234180 :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"9b896832-365a-53e2-87c9-f14f4fb24d89\" :question/math-academy-id \"q-65556\" :question/problem \"Find the exact value of  $\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{12}\\\\right).$\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle \\\\frac{\\\\pi }{12}=\\\\frac{\\\\pi }{3}-\\\\frac{\\\\pi }{4}.\\n$$*\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}(x-y)=\\\\operatorname{cos}x\\\\operatorname{cos}y+\\\\operatorname{sin}x\\\\operatorname{sin}y\\n$$\\n\\nApplying the difference formula for cosine with $x=\\\\frac{\\\\pi }{3}$ and $y=\\\\frac{\\\\pi }{4},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{3}-\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{3}\\\\right)\\\\operatorname{cos}\\\\left(\\\\frac{\\\\pi }{4}\\\\right)+\\\\operatorname{sin}\\\\left(\\\\frac{\\\\pi }{3}\\\\right)\\\\operatorname{sin}\\\\left(\\\\frac{\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186253581 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"33c614c8-e574-54c4-afe7-ea7cbe93a089\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}-\\\\sqrt{6}}{4}\" :db/id 17592186250984} {:answer/id #uuid \"82138ae6-184b-5b43-9d31-1dafcb47b464\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186251649} {:answer/id #uuid \"866785b4-4b0d-5ed0-ab10-df319b0d8757\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186251680} {:answer/id #uuid \"cb17904f-e9e2-5ce4-ac6b-159a7742e47c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186252351} {:answer/id #uuid \"f85fd59f-f673-55d7-9727-39ba21278ce9\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}+\\\\sqrt{6}}{4}\" :db/id 17592186252727}] :answer-field/correct {:answer/id #uuid \"82138ae6-184b-5b43-9d31-1dafcb47b464\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186251649} :answer-field/id #uuid \"307233f6-b9b3-54e3-9937-9c7b41e5ed35\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186252888}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9b9e46d2-105c-587e-ad59-8da071cc7eea\" :question/math-academy-id \"q-119479\" :question/problem \"Find the exact value of  $\\\\operatorname{cos}⁡{195}^{∘}.$\\n\\n*Hint: Use the fact that ${195}^{∘}={135}^{∘}+{60}^{∘}.$*\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}⁡(x+y)=\\\\operatorname{cos}⁡x\\\\operatorname{cos}⁡y-\\\\operatorname{sin}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the sum formula for cosine with $x={135}^{∘}$ and $y={60}^{∘}$, we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}⁡({195}^{∘}) & =\\\\operatorname{cos}⁡({135}^{∘}+{60}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{135}^{∘}\\\\operatorname{cos}⁡{60}^{∘}-\\\\operatorname{sin}⁡{135}^{∘}\\\\operatorname{sin}⁡{60}^{∘} \\\\\\\\  & =\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186272269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"70772ebb-922a-557a-9ea9-f54d6d437fb4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186270264} {:answer/id #uuid \"a3e2ba4e-1030-54b7-bb9e-52eeaa51ec52\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{3}}{4}\" :db/id 17592186270732} {:answer/id #uuid \"afb75370-3708-5e38-be35-0de44709eb35\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186270834} {:answer/id #uuid \"d4bc3b99-7b00-52dd-a05c-66df48bef76e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1+\\\\sqrt{6}}{4}\" :db/id 17592186271139} {:answer/id #uuid \"f22eb4a3-842c-506f-9e15-5e501d2c0cfc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{3}}{4}\" :db/id 17592186271395}] :answer-field/correct {:answer/id #uuid \"70772ebb-922a-557a-9ea9-f54d6d437fb4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186270264} :answer-field/id #uuid \"f03ebea0-4a7a-5a11-a858-d951b06424b4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186271929}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7f15816e-a4ea-5e54-ac29-0fac8d7bc4b0\" :question/math-academy-id \"q-141360\" :question/problem \"Find the exact value of $\\\\operatorname{cos}⁡\\\\left(-\\\\frac{\\\\pi }{12}\\\\right).$\\n\\n*Hint: Use the fact that $$\\n\\\\displaystyle -\\\\frac{\\\\pi }{12}=\\\\frac{\\\\pi }{4}-\\\\frac{\\\\pi }{3}.\\n$$*\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}⁡(x-y)=\\\\operatorname{cos}⁡x\\\\operatorname{cos}⁡y+\\\\operatorname{sin}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the difference formula for cosine with $x=\\\\frac{\\\\pi }{4}$ and $y=\\\\frac{\\\\pi }{3},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}⁡\\\\left(-\\\\frac{\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}-\\\\frac{\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)+\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{4}\\\\right)\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right) \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2}+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186284690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"090f6197-9bfe-5d8c-b735-94decd1ea657\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-6}{2}\" :db/id 17592186281768} {:answer/id #uuid \"56bed151-1560-57ad-9353-21e49bac0c8a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+2}{4}\" :db/id 17592186282424} {:answer/id #uuid \"6aa45ee8-5694-53e6-94b0-344617488a4e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186282608} {:answer/id #uuid \"8b70aa81-edec-544b-b13d-e2f695e33d37\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186282894} {:answer/id #uuid \"9ede1d6e-88b3-59c8-85cd-da8918bb4f4e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{2}\" :db/id 17592186283073}] :answer-field/correct {:answer/id #uuid \"8b70aa81-edec-544b-b13d-e2f695e33d37\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186282894} :answer-field/id #uuid \"9bb03f94-03e6-5579-8d6d-d77f6d051afe\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186284201}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c456fc7d-3362-5f0f-892b-2dc7d01dc677\" :question/math-academy-id \"q-1727\" :question/problem \"Find the exact value of $\\\\operatorname{cos}⁡(-{105}^{∘}).$\\n\\n*Hint: Use the fact that $-{105}^{∘}={45}^{∘}-{150}^{∘}.$*\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}⁡(x-y)=\\\\operatorname{cos}⁡x\\\\operatorname{cos}⁡y+\\\\operatorname{sin}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the difference formula for cosine with $x={45}^{∘}$ and $y={150}^{∘},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}⁡(-{105}^{∘}) & =\\\\operatorname{cos}⁡({45}^{∘}-{150}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡{45}^{∘}\\\\operatorname{cos}⁡{150}^{∘}+\\\\operatorname{sin}⁡{45}^{∘}\\\\operatorname{sin}⁡{150}^{∘} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\  & =-\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{-\\\\sqrt{6}+\\\\sqrt{2}}{4} \\\\\\\\  & =\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186292738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2c5c6bb3-b6c5-5c98-a71c-766e55d73681\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186290810}] :answer-field/correct {:answer/id #uuid \"2c5c6bb3-b6c5-5c98-a71c-766e55d73681\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}\" :db/id 17592186290810} :answer-field/id #uuid \"004083d1-756b-57ee-afb2-b32436d92634\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186291727}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9be8168c-23d9-5e9e-9448-c2a71491be02\" :question/math-academy-id \"q-274484\" :question/problem \"Using the fact that $$\\n\\\\displaystyle -\\\\frac{11\\\\pi }{12}=\\\\frac{\\\\pi }{3}-\\\\frac{5\\\\pi }{4},\\n$$\\ncalculate the **exact** value of $\\\\operatorname{cos}⁡\\\\left(-\\\\frac{11\\\\pi }{12}\\\\right).$\\n\\n$\\\\operatorname{cos}⁡\\\\left(-\\\\frac{11\\\\pi }{12}\\\\right)=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}⁡(x-y)=\\\\operatorname{cos}⁡x\\\\operatorname{cos}⁡y+\\\\operatorname{sin}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the sum formula for cosine with $x=\\\\frac{\\\\pi }{3}$ and $y=\\\\frac{5\\\\pi }{4},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}⁡\\\\left(-\\\\frac{11\\\\pi }{12}\\\\right) & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{3}-\\\\frac{5\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\operatorname{cos}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)\\\\operatorname{cos}⁡\\\\left(\\\\frac{5\\\\pi }{4}\\\\right)+\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)\\\\operatorname{sin}⁡\\\\left(\\\\frac{5\\\\pi }{4}\\\\right) \\\\\\\\  & =\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{2}+\\\\sqrt{6}}{4}.\\\\end{aligned}\\n$$\"} {:db/id 17592186305039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f4e419df-6c04-5fb6-983e-5a12894b3f2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186303994}] :answer-field/correct {:answer/id #uuid \"f4e419df-6c04-5fb6-983e-5a12894b3f2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186303994} :answer-field/id #uuid \"c0bc25a8-5b64-525f-8ec1-18bacb29b0aa\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186304603}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"688375ae-4d98-550a-942a-dba16a7b32d6\" :question/math-academy-id \"q-332499\" :question/problem \"Using the fact that $-{210}^{∘}={30}^{∘}-{240}^{∘},$\\ncalculate the **exact** value of $\\\\operatorname{cos}⁡(-{210}^{∘}).$\\n\\n$\\\\operatorname{cos}⁡(-{210}^{∘})=$\\n{{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\operatorname{cos}⁡(x-y)=\\\\operatorname{cos}⁡x\\\\operatorname{cos}⁡y+\\\\operatorname{sin}⁡x\\\\operatorname{sin}⁡y\\n$$\\n\\nApplying the sum formula for cosine with $x={30}^{∘}$ and $y={240}^{∘},$ we get\\n\\n$$\\n\\\\begin{aligned}\\\\operatorname{cos}⁡(-{210}^{∘}) & =\\\\operatorname{cos}⁡({30}^{∘}-{240}^{∘}) \\\\\\\\  & =\\\\operatorname{cos}⁡({30}^{∘})\\\\operatorname{cos}⁡({240}^{∘})+\\\\operatorname{sin}⁡({30}^{∘})\\\\operatorname{sin}⁡({240}^{∘}) \\\\\\\\  & =\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\left(-\\\\frac{1}{2}\\\\right)+\\\\frac{1}{2}\\\\cdot \\\\left(-\\\\frac{\\\\sqrt{3}}{2}\\\\right) \\\\\\\\  & =-\\\\frac{\\\\sqrt{3}}{4}-\\\\frac{\\\\sqrt{3}}{4} \\\\\\\\  & =-\\\\frac{\\\\sqrt{3}}{2}.\\\\end{aligned}\\n$$\"} {:db/id 17592186714819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a033e156-2507-5cb6-b19d-7a730fb080fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186714826}] :answer-field/correct {:answer/id #uuid \"a033e156-2507-5cb6-b19d-7a730fb080fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186714826} :answer-field/id #uuid \"d0ea9da9-9730-55b0-9ddc-6f3eea8f8558\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186714828}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"252126f0-142c-514f-8cc9-9ddbe81844d9\" :question/problem \"Using the fact that\\n\\n$$\\n-\\\\frac{13\\\\pi}{12}=\\\\frac{\\\\pi}{6}-\\\\frac{5\\\\pi}{4},\\n$$\\ncalculate the **exact** value of $\\\\cos\\\\left(-\\\\frac{13\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(-\\\\frac{13\\\\pi}{12}\\\\right)=$ {{field-1}}\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\nThe supplied decomposition gives\\n\\n$$\\n\\\\cos\\\\left(-\\\\frac{13\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{6}-\\\\frac{5\\\\pi}{4}\\\\right).\\n$$\\nThe angle $\\\\frac{5\\\\pi}{4}$ is in quadrant III, so both its cosine and its sine are negative. Apply the difference formula and substitute these signed values:\\n\\n$$\\n\\\\begin{aligned}\\n&\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{5\\\\pi}{4}\\\\right)+\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{5\\\\pi}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\frac{1}{2}\\\\cdot\\\\left(-\\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\\\n&=-\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\\nThus $\\\\cos\\\\left(-\\\\frac{13\\\\pi}{12}\\\\right)=-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}$. The plus sign in the difference formula combines two negative products. It does not make the result positive.\"} {:db/id 17592186714820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4d2d8aee-dba8-5342-b392-8edb550a8f61\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186714821}] :answer-field/correct {:answer/id #uuid \"4d2d8aee-dba8-5342-b392-8edb550a8f61\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186714821} :answer-field/id #uuid \"fc573b51-dd38-5265-a824-8226a840f95e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186714830}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4194f8cc-7517-5acb-8a53-a554eb94eeaf\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)-\\\\sin\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Recognize the sum formula for cosine in reverse:\\n\\n$$\\n\\\\cos x\\\\cos y-\\\\sin x\\\\sin y=\\\\cos(x+y).\\n$$\\nWith $x=\\\\frac{5\\\\pi}{12}$ and $y=\\\\frac{\\\\pi}{6}$, the given expression becomes\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}+\\\\frac{\\\\pi}{6}\\\\right)=\\\\cos\\\\left(\\\\frac{7\\\\pi}{12}\\\\right).\\n$$\\nThis angle is not a standard unit-circle angle. Choose a decomposition into two special angles:\\n\\n$$\\n\\\\frac{7\\\\pi}{12}=\\\\frac{\\\\pi}{3}+\\\\frac{\\\\pi}{4}.\\n$$\\nNow apply the same sum formula to evaluate it:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\cos\\\\left(\\\\frac{7\\\\pi}{12}\\\\right)\\n&=\\\\cos\\\\left(\\\\frac{\\\\pi}{3}+\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\\\n&=\\\\cos\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)-\\\\sin\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{1}{2}\\\\cdot\\\\frac{\\\\sqrt{2}}{2}-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot\\\\frac{\\\\sqrt{2}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\\nThus the original expression equals $\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}$. The result is negative, consistent with $\\\\frac{7\\\\pi}{12}$ being in quadrant II.\"} {:db/id 17592186714827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"06242c29-c81c-5e15-a01b-1a7a993daa23\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186714818} {:answer/id #uuid \"645749f7-9cea-541b-8ab3-d81cef940726\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2}-\\\\sqrt{6}}{4}\" :db/id 17592186714822} {:answer/id #uuid \"6ddc2918-24ba-5430-b81e-48d9cab1e59e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}-\\\\sqrt{2}}{4}\" :db/id 17592186714823} {:answer/id #uuid \"77bef8f9-b142-5281-9335-3a97b3ac88a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt{6}+\\\\sqrt{2}}{4}\" :db/id 17592186714824} {:answer/id #uuid \"eafa0dd4-c6e9-5b3f-80a6-0fa2c175e0cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186714829}] :answer-field/correct {:answer/id #uuid \"eafa0dd4-c6e9-5b3f-80a6-0fa2c175e0cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}\" :db/id 17592186714829} :answer-field/id #uuid \"8d42449e-a871-5323-8088-0eca2ebd7c8b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186714825}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c338ba7e-729f-5c5d-97ab-549fb226cb62\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{4}+\\\\frac{\\\\pi}{6}.\\n$$\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\nUse the supplied decomposition and the special-angle values:\\n\\n$$\\n\\\\begin{aligned}\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)\\n&=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}+\\\\frac{\\\\pi}{6}\\\\right) \\\\\\\\\\n&=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)-\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot\\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot\\\\frac{1}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}-\\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\\nThe minus sign between the products comes from the cosine **sum** formula.\"} {:db/id 17592186715276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0d729ce4-0302-5a4e-88e9-a2b2f7f861b6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{8}\" :db/id 17592186715277} {:answer/id #uuid \"1fa1980c-fbdb-5a4a-811e-c0c2ce52dcca\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715278} {:answer/id #uuid \"23a88951-9b79-5036-9078-87f1e6ad32fc\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715279} {:answer/id #uuid \"3c1706f2-bd65-5352-adec-0b185860cb4c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715284} {:answer/id #uuid \"b1a579d2-bb12-527b-994e-865a116fe36b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715289}] :answer-field/correct {:answer/id #uuid \"1fa1980c-fbdb-5a4a-811e-c0c2ce52dcca\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715278} :answer-field/id #uuid \"74afab49-6040-53cb-9f5d-2a82f177d2a3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186715285}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"00907707-0f47-524e-8d9d-c2a99b1347bf\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n\\\\frac{17\\\\pi}{12}=\\\\frac{5\\\\pi}{4}+\\\\frac{\\\\pi}{6}.\\n$$\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{5\\\\pi}{4}+\\\\frac{\\\\pi}{6}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)-\\\\sin\\\\left(\\\\frac{5\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7a4ec224-b4d3-5e0a-a3b2-6b2de812b7e4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715286}] :answer-field/correct {:answer/id #uuid \"7a4ec224-b4d3-5e0a-a3b2-6b2de812b7e4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715286} :answer-field/id #uuid \"8ce22f6e-0027-5062-af90-948e61ec187b\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715287}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2b2b87cf-2911-5184-8366-5576c53dc0a0\" :question/problem \"Using the fact that\\n\\n$$\\n255^\\\\circ=135^\\\\circ+120^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(255^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(255^\\\\circ\\\\right)=$ {{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(255^\\\\circ\\\\right)=\\\\cos\\\\left(135^\\\\circ+120^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(135^\\\\circ\\\\right)\\\\cos\\\\left(120^\\\\circ\\\\right)-\\\\sin\\\\left(135^\\\\circ\\\\right)\\\\sin\\\\left(120^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right)-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"cb23ec69-5da6-59a3-902e-2662d9f20946\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715292}] :answer-field/correct {:answer/id #uuid \"cb23ec69-5da6-59a3-902e-2662d9f20946\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715292} :answer-field/id #uuid \"c588587a-5d22-576a-b35a-720ed2d9b548\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715290}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"390bfd59-3cf6-5b25-9647-d4e0b252a4d0\" :question/problem \"Using the fact that\\n\\n$$\\n-285^\\\\circ=45^\\\\circ-330^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(-285^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(-285^\\\\circ\\\\right)=$ {{field-1}}\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(-285^\\\\circ\\\\right)=\\\\cos\\\\left(45^\\\\circ-330^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(330^\\\\circ\\\\right)+\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(330^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}+\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2b607a2f-c365-5ef4-8dee-8a3811318534\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715281}] :answer-field/correct {:answer/id #uuid \"2b607a2f-c365-5ef4-8dee-8a3811318534\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715281} :answer-field/id #uuid \"c9da5509-d6d0-5b3b-8616-738c6c52839b\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715291}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a5b037a9-c48c-5315-8b78-53211b223292\" :question/problem \"Using the fact that\\n\\n$$\\n\\\\frac{\\\\pi}{12}=\\\\frac{4\\\\pi}{3}-\\\\frac{5\\\\pi}{4},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(\\\\frac{\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(\\\\frac{\\\\pi}{12}\\\\right)=$ {{field-1}}\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{4\\\\pi}{3}-\\\\frac{5\\\\pi}{4}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{4\\\\pi}{3}\\\\right)\\\\cos\\\\left(\\\\frac{5\\\\pi}{4}\\\\right)+\\\\sin\\\\left(\\\\frac{4\\\\pi}{3}\\\\right)\\\\sin\\\\left(\\\\frac{5\\\\pi}{4}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715293 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f23a349f-daa2-5743-b057-6aac00640c27\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186715294} {:answer/id #uuid \"9f87c1f3-1b1c-43aa-9d15-9f1865f54537\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\sqrt3}{2}\" :db/id 17592186748724}] :answer-field/correct {:answer/id #uuid \"f23a349f-daa2-5743-b057-6aac00640c27\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sqrt{3}}{2}\" :db/id 17592186715294} :answer-field/id #uuid \"3a76a740-d03f-526d-aea2-5b35e5ffab73\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715283}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f14939ed-c78b-5eac-89a9-43e51098bfbb\" :question/problem \"Using the fact that\\n\\n$$\\n\\\\frac{7\\\\pi}{6}=\\\\frac{5\\\\pi}{6}+\\\\frac{\\\\pi}{3},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)$.\\n\\n$\\\\cos\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)=$ {{field-1}}\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)=\\\\cos\\\\left(\\\\frac{5\\\\pi}{6}+\\\\frac{\\\\pi}{3}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{3}\\\\right)-\\\\sin\\\\left(\\\\frac{5\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{1}{2}-\\\\frac{1}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{3}}{4}\\\\right)-\\\\frac{\\\\sqrt{3}}{4} \\\\\\\\\\n&=- \\\\frac{\\\\sqrt{3}}{2}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715336 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8c8e2db9-f941-5d29-b80d-f67e67177168\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715343}] :answer-field/correct {:answer/id #uuid \"8c8e2db9-f941-5d29-b80d-f67e67177168\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715343} :answer-field/id #uuid \"3748a627-c534-565f-90d1-d9889d652c7a\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715338}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"19b67319-b58d-5f67-be63-00d76df8f311\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{11\\\\pi}{12}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{3}\\\\right)+\\\\sin\\\\left(\\\\frac{11\\\\pi}{12}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Recognize the difference formula in reverse:\\n\\n$$\\n\\\\cos x\\\\cos y+\\\\sin x\\\\sin y=\\\\cos(x-y).\\n$$\\n\\nCombining the angles gives\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{11\\\\pi}{12}-\\\\frac{\\\\pi}{3}\\\\right)=\\\\cos\\\\left(\\\\frac{7\\\\pi}{12}\\\\right).\\n$$\\n\\nChoose a decomposition into special angles:\\n\\n$$\\n\\\\frac{7\\\\pi}{12}=\\\\frac{7\\\\pi}{4}-\\\\frac{7\\\\pi}{6}.\\n$$\\n\\nRecall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{7\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{7\\\\pi}{4}-\\\\frac{7\\\\pi}{6}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{7\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)+\\\\sin\\\\left(\\\\frac{7\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right) \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right)+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715337 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8d69ea68-5adf-5760-8fd3-7d18ec20d518\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715344} {:answer/id #uuid \"3e104402-37e3-45b6-ae08-cd09a73b55a0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt2}{2}\" :db/id 17592186748719}] :answer-field/correct {:answer/id #uuid \"8d69ea68-5adf-5760-8fd3-7d18ec20d518\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715344} :answer-field/id #uuid \"54cb7999-113e-506b-81be-9adc4fb23923\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715341}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"31388341-544f-5e6b-8fe8-8155a0101cd5\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\cos\\\\left(-345^\\\\circ\\\\right)\\\\cos\\\\left(60^\\\\circ\\\\right)-\\\\sin\\\\left(-345^\\\\circ\\\\right)\\\\sin\\\\left(60^\\\\circ\\\\right)\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Recognize the sum formula in reverse:\\n\\n$$\\n\\\\cos x\\\\cos y-\\\\sin x\\\\sin y=\\\\cos(x+y).\\n$$\\n\\nCombining the angles gives\\n\\n$$\\n\\\\cos\\\\left(-345^\\\\circ+60^\\\\circ\\\\right)=\\\\cos\\\\left(-285^\\\\circ\\\\right).\\n$$\\n\\nChoose a decomposition into special angles:\\n\\n$$\\n-285^\\\\circ=30^\\\\circ-315^\\\\circ.\\n$$\\n\\nRecall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(-285^\\\\circ\\\\right)=\\\\cos\\\\left(30^\\\\circ-315^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(30^\\\\circ\\\\right)\\\\cos\\\\left(315^\\\\circ\\\\right)+\\\\sin\\\\left(30^\\\\circ\\\\right)\\\\sin\\\\left(315^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}+\\\\frac{1}{2}\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}+\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b7033f81-8b53-539b-8842-2b7864879aa9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715345}] :answer-field/correct {:answer/id #uuid \"b7033f81-8b53-539b-8842-2b7864879aa9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715345} :answer-field/id #uuid \"486950d0-33b4-5626-9727-5198f67d69dd\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715340}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3eda9012-52fc-5c2e-894e-946e00ddd760\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\cos\\\\left(105^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)+\\\\sin\\\\left(105^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right)\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Recognize the difference formula in reverse:\\n\\n$$\\n\\\\cos x\\\\cos y+\\\\sin x\\\\sin y=\\\\cos(x-y).\\n$$\\n\\nCombining the angles gives\\n\\n$$\\n\\\\cos\\\\left(105^\\\\circ-30^\\\\circ\\\\right)=\\\\cos\\\\left(75^\\\\circ\\\\right).\\n$$\\n\\nChoose a decomposition into special angles:\\n\\n$$\\n75^\\\\circ=45^\\\\circ+30^\\\\circ.\\n$$\\n\\nRecall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(75^\\\\circ\\\\right)=\\\\cos\\\\left(45^\\\\circ+30^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)-\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1366b80f-5930-57db-986b-d73a87d08c91\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715335}] :answer-field/correct {:answer/id #uuid \"1366b80f-5930-57db-986b-d73a87d08c91\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715335} :answer-field/id #uuid \"7453027b-e2e8-5970-a107-d6cbfcd4b706\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186715342}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f1aab739-d82b-54d8-99ad-7aaba2b2c1f3\" :question/problem \"Find the **exact** value of the expression below.\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{13\\\\pi}{12}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{3}\\\\right)-\\\\sin\\\\left(\\\\frac{13\\\\pi}{12}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{3}\\\\right)\\n$$\\n\\n{{field-1}}\" :question/worked-solution \"Recognize the sum formula in reverse:\\n\\n$$\\n\\\\cos x\\\\cos y-\\\\sin x\\\\sin y=\\\\cos(x+y).\\n$$\\n\\nCombining the angles gives\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{13\\\\pi}{12}+\\\\frac{\\\\pi}{3}\\\\right)=\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right).\\n$$\\n\\nChoose a decomposition into special angles:\\n\\n$$\\n\\\\frac{17\\\\pi}{12}=\\\\frac{2\\\\pi}{3}+\\\\frac{3\\\\pi}{4}.\\n$$\\n\\nRecall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{2\\\\pi}{3}+\\\\frac{3\\\\pi}{4}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)\\\\cos\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)-\\\\sin\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)\\\\sin\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)-\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"} {:db/id 17592186715397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"24e9c9f2-21e4-57a4-8079-613366abe46e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715392} {:answer/id #uuid \"27139604-a684-5482-8973-24692551f52f\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715393} {:answer/id #uuid \"3b1f17fa-a764-5151-b535-7882e73bf0f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\" :db/id 17592186715394} {:answer/id #uuid \"470ba003-21de-5bc2-8b10-b4814a0b2e41\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{8}\" :db/id 17592186715395} {:answer/id #uuid \"630487c0-e9f6-558b-b647-f4325bb04d7c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715396}] :answer-field/correct {:answer/id #uuid \"24e9c9f2-21e4-57a4-8079-613366abe46e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\" :db/id 17592186715392} :answer-field/id #uuid \"d970b662-ab43-59be-9beb-8e2a79e21cc9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186715398}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"c7caf03f-2b5d-5b11-8629-8d9a037ddb77\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(15^\\\\circ\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n15^\\\\circ=45^\\\\circ-30^\\\\circ.\\n$$\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(15^\\\\circ\\\\right)=\\\\cos\\\\left(45^\\\\circ-30^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)+\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}+\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"}] :knowledge-point/title \"Finding Exact Values Using the Sum and Difference Formulas\"}",
