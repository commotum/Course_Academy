  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/id #uuid \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\"] [:db/add \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/type :answer.type/math] [:db/add \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/validate] [:db/add \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/id #uuid \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\"] [:db/add \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/key \"field-1\"] [:db/add \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/type :answer-field.type/blank] [:db/add \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/choices \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\"] [:db/add \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/correct \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\"] [:db/ensure \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/validate] [:db/add \"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/id #uuid \"f6792163-892d-567c-8d26-c5674dc37aa7\"] [:db/add \"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/problem \"Using the fact that\\n\\n$$\\n165^\\\\circ=225^\\\\circ-60^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(165^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(165^\\\\circ\\\\right)=$ {{field-1}}\"] [:db/add \"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(165^\\\\circ\\\\right)=\\\\cos\\\\left(225^\\\\circ-60^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(225^\\\\circ\\\\right)\\\\cos\\\\left(60^\\\\circ\\\\right)+\\\\sin\\\\left(225^\\\\circ\\\\right)\\\\sin\\\\left(60^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2}+\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right) \\\\\\\\\\n&=- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/difficulty :question.difficulty/easy] [:db/add \"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/answer-fields \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\"] [:db/ensure \"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"f6792163-892d-567c-8d26-c5674dc37aa7\"] [:db/add \"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/id #uuid \"4a0b0e7b-1827-5173-80d7-774275899c22\"] [:db/add \"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/type :answer.type/math] [:db/add \"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/validate] [:db/add \"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/id #uuid \"623ea438-0523-5cba-bc4a-49bacb2c61c7\"] [:db/add \"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/type :answer.type/math] [:db/add \"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/validate] [:db/add \"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/id #uuid \"e5659820-74ad-57be-bd5b-d46845d9e540\"] [:db/add \"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/type :answer.type/math] [:db/add \"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/validate] [:db/add \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/id #uuid \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\"] [:db/add \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/type :answer.type/math] [:db/add \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [:db/ensure \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/validate] [:db/add \"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/id #uuid \"22710d1e-ed92-5109-9ea1-15848e7bae8b\"] [:db/add \"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/type :answer.type/math] [:db/add \"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{8}\"] [:db/ensure \"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/validate] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/id #uuid \"2a987957-4d07-5536-a788-11dd5bbd0230\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/key \"selection\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/type :answer-field.type/radio] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"4a0b0e7b-1827-5173-80d7-774275899c22\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"623ea438-0523-5cba-bc4a-49bacb2c61c7\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"e5659820-74ad-57be-bd5b-d46845d9e540\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"22710d1e-ed92-5109-9ea1-15848e7bae8b\"] [:db/add \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/correct \"4a0b0e7b-1827-5173-80d7-774275899c22\"] [:db/ensure \"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/validate] [:db/add \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/id #uuid \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\"] [:db/add \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{4}+\\\\frac{\\\\pi}{6}.\\n$$\"] [:db/add \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}+\\\\frac{\\\\pi}{6}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)-\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/difficulty :question.difficulty/easy] [:db/add \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/answer-fields \"2a987957-4d07-5536-a788-11dd5bbd0230\"] [:db/ensure \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\"] [:db/add \"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/id #uuid \"cb604c69-c91c-5034-9d03-c90a4dc5e808\"] [:db/add \"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/type :answer.type/math] [:db/add \"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/validate] [:db/add \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/id #uuid \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\"] [:db/add \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/type :answer.type/math] [:db/add \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/validate] [:db/add \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/id #uuid \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\"] [:db/add \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/type :answer.type/math] [:db/add \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/validate] [:db/add \"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/id #uuid \"c124f2e6-cb18-5067-9357-512ac13369a8\"] [:db/add \"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/type :answer.type/math] [:db/add \"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{8}\"] [:db/ensure \"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/validate] [:db/add \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/id #uuid \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\"] [:db/add \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/type :answer.type/math] [:db/add \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [:db/ensure \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/validate] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/id #uuid \"2d736977-2893-51e6-a663-0615508617b3\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/key \"selection\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/type :answer-field.type/radio] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"cb604c69-c91c-5034-9d03-c90a4dc5e808\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"c124f2e6-cb18-5067-9357-512ac13369a8\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\"] [:db/add \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/correct \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\"] [:db/ensure \"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/validate] [:db/add \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/id #uuid \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\"] [:db/add \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(255^\\\\circ\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n255^\\\\circ=225^\\\\circ+30^\\\\circ.\\n$$\"] [:db/add \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(255^\\\\circ\\\\right)=\\\\cos\\\\left(225^\\\\circ+30^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(225^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)-\\\\sin\\\\left(225^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/difficulty :question.difficulty/moderate] [:db/add \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/answer-fields \"2d736977-2893-51e6-a663-0615508617b3\"] [:db/ensure \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\"] [:db/add \"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/id #uuid \"8c5c3450-d1e5-552e-8227-989879635ea6\"] [:db/add \"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/type :answer.type/math] [:db/add \"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [:db/ensure \"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/validate] [:db/add \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/id #uuid \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\"] [:db/add \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/key \"field-1\"] [:db/add \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/type :answer-field.type/blank] [:db/add \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/choices \"8c5c3450-d1e5-552e-8227-989879635ea6\"] [:db/add \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/correct \"8c5c3450-d1e5-552e-8227-989879635ea6\"] [:db/ensure \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/validate] [:db/add \"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/id #uuid \"014e904c-4ac0-5d05-ae04-396c1677c3b1\"] [:db/add \"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/problem \"Using the fact that\\n\\n$$\\n105^\\\\circ=240^\\\\circ-135^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(105^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(105^\\\\circ\\\\right)=$ {{field-1}}\"] [:db/add \"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(105^\\\\circ\\\\right)=\\\\cos\\\\left(240^\\\\circ-135^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(240^\\\\circ\\\\right)\\\\cos\\\\left(135^\\\\circ\\\\right)+\\\\sin\\\\left(240^\\\\circ\\\\right)\\\\sin\\\\left(135^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}+\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/difficulty :question.difficulty/hard] [:db/add \"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/answer-fields \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\"] [:db/ensure \"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"014e904c-4ac0-5d05-ae04-396c1677c3b1\"] [:db/add \"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/id #uuid \"0df03d40-dfc0-549e-8d10-3c89b078b29b\"] [:db/add \"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/type :answer.type/math] [:db/add \"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [:db/ensure \"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/validate] [:db/add \"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/id #uuid \"e7cdacdf-9b4e-5f44-af91-467135a1e441\"] [:db/add \"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/key \"field-1\"] [:db/add \"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/type :answer-field.type/blank] [:db/add \"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/choices \"0df03d40-dfc0-549e-8d10-3c89b078b29b\"] [:db/add \"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/correct \"0df03d40-dfc0-549e-8d10-3c89b078b29b\"] [:db/ensure \"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/validate] [:db/add \"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/id #uuid \"a3594bde-81e0-5a40-85cd-984ec5434e25\"] [:db/add \"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/problem \"Using the fact that\\n\\n$$\\n\\\\frac{17\\\\pi}{12}=\\\\frac{3\\\\pi}{4}+\\\\frac{2\\\\pi}{3},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)=$ {{field-1}}\"] [:db/add \"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{3\\\\pi}{4}+\\\\frac{2\\\\pi}{3}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)-\\\\sin\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right)-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/difficulty :question.difficulty/hard] [:db/add \"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/answer-fields \"e7cdacdf-9b4e-5f44-af91-467135a1e441\"] [:db/ensure \"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"a3594bde-81e0-5a40-85cd-984ec5434e25\"] [:db/add \"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/id #uuid \"f9aa45a1-9a38-576a-8d4d-2838200c247c\"] [:db/add \"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/type :answer.type/math] [:db/add \"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/validate] [:db/add \"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/id #uuid \"0d0584aa-aff0-5498-967d-369a9fcfcf85\"] [:db/add \"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/key \"field-1\"] [:db/add \"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/type :answer-field.type/blank] [:db/add \"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/choices \"f9aa45a1-9a38-576a-8d4d-2838200c247c\"] [:db/add \"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/correct \"f9aa45a1-9a38-576a-8d4d-2838200c247c\"] [:db/ensure \"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/validate] [:db/add \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/id #uuid \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\"] [:db/add \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/problem \"Using the fact that\\n\\n$$\\n-75^\\\\circ=45^\\\\circ-120^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(-75^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(-75^\\\\circ\\\\right)=$ {{field-1}}\"] [:db/add \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(-75^\\\\circ\\\\right)=\\\\cos\\\\left(45^\\\\circ-120^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(120^\\\\circ\\\\right)+\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(120^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right)+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right)+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/difficulty :question.difficulty/hard] [:db/add \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/answer-fields \"0d0584aa-aff0-5498-967d-369a9fcfcf85\"] [:db/ensure \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\"] [:db/add \"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/id #uuid \"3543ed55-fff1-5697-be0a-011afcd150f6\"] [:db/add \"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/type :answer.type/math] [:db/add \"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/validate] [:db/add \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/id #uuid \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\"] [:db/add \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/key \"field-1\"] [:db/add \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/type :answer-field.type/blank] [:db/add \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/choices \"3543ed55-fff1-5697-be0a-011afcd150f6\"] [:db/add \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/correct \"3543ed55-fff1-5697-be0a-011afcd150f6\"] [:db/ensure \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/validate] [:db/add \"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/id #uuid \"1445f9a4-ddce-59b1-855c-0727569a68df\"] [:db/add \"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/problem \"Using the fact that\\n\\n$$\\n\\\\frac{23\\\\pi}{12}=\\\\frac{\\\\pi}{6}+\\\\frac{7\\\\pi}{4},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(\\\\frac{23\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(\\\\frac{23\\\\pi}{12}\\\\right)=$ {{field-1}}\"] [:db/add \"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{23\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{6}+\\\\frac{7\\\\pi}{4}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{7\\\\pi}{4}\\\\right)-\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{7\\\\pi}{4}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}-\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/difficulty :question.difficulty/hard] [:db/add \"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/answer-fields \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\"] [:db/ensure \"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"1445f9a4-ddce-59b1-855c-0727569a68df\"] [:db/add \"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/id #uuid \"554e161c-c2da-55d5-bbd0-6999bf4c663b\"] [:db/add \"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/type :answer.type/math] [:db/add \"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [:db/ensure \"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/validate] [:db/add \"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/id #uuid \"03b9b630-0b80-5314-b540-772b35d14a98\"] [:db/add \"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/key \"field-1\"] [:db/add \"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/type :answer-field.type/blank] [:db/add \"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/choices \"554e161c-c2da-55d5-bbd0-6999bf4c663b\"] [:db/add \"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/correct \"554e161c-c2da-55d5-bbd0-6999bf4c663b\"] [:db/ensure \"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/validate] [:db/add \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/id #uuid \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\"] [:db/add \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/problem \"Using the fact that\\n\\n$$\\n-\\\\frac{11\\\\pi}{12}=\\\\frac{\\\\pi}{4}-\\\\frac{7\\\\pi}{6},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(-\\\\frac{11\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(-\\\\frac{11\\\\pi}{12}\\\\right)=$ {{field-1}}\"] [:db/add \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(-\\\\frac{11\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}-\\\\frac{7\\\\pi}{6}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)+\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right) \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [:db/add \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/difficulty :question.difficulty/hard] [:db/add \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/answer-fields \"03b9b630-0b80-5314-b540-772b35d14a98\"] [:db/ensure \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/validate] [:db/add 17592186059666 :knowledge-point/questions \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\"] [:db/add \"generator\" :question-generator/id #uuid \"000b985d-474b-5ecb-94a1-4befd443a0d2\"] [:db/add \"generator\" :question-generator/script \"generators/11/11f5405dce86981ef8d18c16d69f8bf1925924e54e1966bac413aac8c2d4c2e6/generator.py\"] [:db/add 17592186059666 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186059666 :knowledge-point/validate]] \"assertions\" [[\"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/id #uuid \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\"] [\"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/type :answer.type/math] [\"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/id #uuid \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\"] [\"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/key \"field-1\"] [\"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/type :answer-field.type/blank] [\"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/choices \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\"] [\"d10634b3-458c-59d8-9b38-ec472b8b9fbb\" :answer-field/correct \"395f95e3-2b0c-5f4f-8a45-021e8304a6b5\"] [\"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/id #uuid \"f6792163-892d-567c-8d26-c5674dc37aa7\"] [\"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/problem \"Using the fact that\\n\\n$$\\n165^\\\\circ=225^\\\\circ-60^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(165^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(165^\\\\circ\\\\right)=$ {{field-1}}\"] [\"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(165^\\\\circ\\\\right)=\\\\cos\\\\left(225^\\\\circ-60^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(225^\\\\circ\\\\right)\\\\cos\\\\left(60^\\\\circ\\\\right)+\\\\sin\\\\left(225^\\\\circ\\\\right)\\\\sin\\\\left(60^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2}+\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right) \\\\\\\\\\n&=- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/difficulty :question.difficulty/easy] [\"f6792163-892d-567c-8d26-c5674dc37aa7\" :question/answer-fields \"d10634b3-458c-59d8-9b38-ec472b8b9fbb\"] [17592186059666 :knowledge-point/questions \"f6792163-892d-567c-8d26-c5674dc37aa7\"] [\"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/id #uuid \"4a0b0e7b-1827-5173-80d7-774275899c22\"] [\"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/type :answer.type/math] [\"4a0b0e7b-1827-5173-80d7-774275899c22\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/id #uuid \"623ea438-0523-5cba-bc4a-49bacb2c61c7\"] [\"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/type :answer.type/math] [\"623ea438-0523-5cba-bc4a-49bacb2c61c7\" :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/id #uuid \"e5659820-74ad-57be-bd5b-d46845d9e540\"] [\"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/type :answer.type/math] [\"e5659820-74ad-57be-bd5b-d46845d9e540\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/id #uuid \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\"] [\"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/type :answer.type/math] [\"7cd96ec1-a01c-5171-8679-00e9f54f55a7\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [\"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/id #uuid \"22710d1e-ed92-5109-9ea1-15848e7bae8b\"] [\"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/type :answer.type/math] [\"22710d1e-ed92-5109-9ea1-15848e7bae8b\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{8}\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/id #uuid \"2a987957-4d07-5536-a788-11dd5bbd0230\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/key \"selection\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/type :answer-field.type/radio] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"4a0b0e7b-1827-5173-80d7-774275899c22\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"623ea438-0523-5cba-bc4a-49bacb2c61c7\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"e5659820-74ad-57be-bd5b-d46845d9e540\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"7cd96ec1-a01c-5171-8679-00e9f54f55a7\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/choices \"22710d1e-ed92-5109-9ea1-15848e7bae8b\"] [\"2a987957-4d07-5536-a788-11dd5bbd0230\" :answer-field/correct \"4a0b0e7b-1827-5173-80d7-774275899c22\"] [\"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/id #uuid \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\"] [\"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n\\\\frac{5\\\\pi}{12}=\\\\frac{\\\\pi}{4}+\\\\frac{\\\\pi}{6}.\\n$$\"] [\"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{5\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}+\\\\frac{\\\\pi}{6}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)-\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}-\\\\frac{\\\\sqrt{2}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/difficulty :question.difficulty/easy] [\"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\" :question/answer-fields \"2a987957-4d07-5536-a788-11dd5bbd0230\"] [17592186059666 :knowledge-point/questions \"5b10f18d-fff7-5deb-ab4b-e20e51b8a320\"] [\"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/id #uuid \"cb604c69-c91c-5034-9d03-c90a4dc5e808\"] [\"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/type :answer.type/math] [\"cb604c69-c91c-5034-9d03-c90a4dc5e808\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/id #uuid \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\"] [\"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/type :answer.type/math] [\"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\" :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/id #uuid \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\"] [\"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/type :answer.type/math] [\"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/id #uuid \"c124f2e6-cb18-5067-9357-512ac13369a8\"] [\"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/type :answer.type/math] [\"c124f2e6-cb18-5067-9357-512ac13369a8\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{8}\"] [\"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/id #uuid \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\"] [\"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/type :answer.type/math] [\"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/id #uuid \"2d736977-2893-51e6-a663-0615508617b3\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/key \"selection\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/type :answer-field.type/radio] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"cb604c69-c91c-5034-9d03-c90a4dc5e808\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"7e8457da-5e2d-50d4-9d68-fa52069cd4bb\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"6e86f9f2-59e4-59b3-9d32-445dd1c0e361\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"c124f2e6-cb18-5067-9357-512ac13369a8\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/choices \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\"] [\"2d736977-2893-51e6-a663-0615508617b3\" :answer-field/correct \"79049e3d-9a7a-5dc8-8fa5-8accca2a6c2b\"] [\"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/id #uuid \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\"] [\"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/problem \"Find the **exact** value of $\\\\cos\\\\left(255^\\\\circ\\\\right)$.\\n\\n*Hint: Use the fact that*\\n\\n$$\\n255^\\\\circ=225^\\\\circ+30^\\\\circ.\\n$$\"] [\"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(255^\\\\circ\\\\right)=\\\\cos\\\\left(225^\\\\circ+30^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(225^\\\\circ\\\\right)\\\\cos\\\\left(30^\\\\circ\\\\right)-\\\\sin\\\\left(225^\\\\circ\\\\right)\\\\sin\\\\left(30^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{3}}{2}-\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\frac{1}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right)-\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/difficulty :question.difficulty/moderate] [\"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\" :question/answer-fields \"2d736977-2893-51e6-a663-0615508617b3\"] [17592186059666 :knowledge-point/questions \"4fc9ef0c-fb5d-5d39-bbec-ab1af2cf98bc\"] [\"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/id #uuid \"8c5c3450-d1e5-552e-8227-989879635ea6\"] [\"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/type :answer.type/math] [\"8c5c3450-d1e5-552e-8227-989879635ea6\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [\"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/id #uuid \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\"] [\"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/key \"field-1\"] [\"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/type :answer-field.type/blank] [\"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/choices \"8c5c3450-d1e5-552e-8227-989879635ea6\"] [\"2ac3b95d-427a-5a44-a5e3-1e6c55842097\" :answer-field/correct \"8c5c3450-d1e5-552e-8227-989879635ea6\"] [\"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/id #uuid \"014e904c-4ac0-5d05-ae04-396c1677c3b1\"] [\"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/problem \"Using the fact that\\n\\n$$\\n105^\\\\circ=240^\\\\circ-135^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(105^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(105^\\\\circ\\\\right)=$ {{field-1}}\"] [\"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(105^\\\\circ\\\\right)=\\\\cos\\\\left(240^\\\\circ-135^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(240^\\\\circ\\\\right)\\\\cos\\\\left(135^\\\\circ\\\\right)+\\\\sin\\\\left(240^\\\\circ\\\\right)\\\\sin\\\\left(135^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{1}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)\\\\cdot \\\\frac{\\\\sqrt{2}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}+\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/difficulty :question.difficulty/hard] [\"014e904c-4ac0-5d05-ae04-396c1677c3b1\" :question/answer-fields \"2ac3b95d-427a-5a44-a5e3-1e6c55842097\"] [17592186059666 :knowledge-point/questions \"014e904c-4ac0-5d05-ae04-396c1677c3b1\"] [\"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/id #uuid \"0df03d40-dfc0-549e-8d10-3c89b078b29b\"] [\"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/type :answer.type/math] [\"0df03d40-dfc0-549e-8d10-3c89b078b29b\" :answer/value \"\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}\"] [\"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/id #uuid \"e7cdacdf-9b4e-5f44-af91-467135a1e441\"] [\"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/key \"field-1\"] [\"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/type :answer-field.type/blank] [\"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/choices \"0df03d40-dfc0-549e-8d10-3c89b078b29b\"] [\"e7cdacdf-9b4e-5f44-af91-467135a1e441\" :answer-field/correct \"0df03d40-dfc0-549e-8d10-3c89b078b29b\"] [\"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/id #uuid \"a3594bde-81e0-5a40-85cd-984ec5434e25\"] [\"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/problem \"Using the fact that\\n\\n$$\\n\\\\frac{17\\\\pi}{12}=\\\\frac{3\\\\pi}{4}+\\\\frac{2\\\\pi}{3},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)=$ {{field-1}}\"] [\"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{17\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{3\\\\pi}{4}+\\\\frac{2\\\\pi}{3}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)-\\\\sin\\\\left(\\\\frac{3\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{2\\\\pi}{3}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right)\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right)-\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2}}{4}-\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{6} + \\\\sqrt{2}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/difficulty :question.difficulty/hard] [\"a3594bde-81e0-5a40-85cd-984ec5434e25\" :question/answer-fields \"e7cdacdf-9b4e-5f44-af91-467135a1e441\"] [17592186059666 :knowledge-point/questions \"a3594bde-81e0-5a40-85cd-984ec5434e25\"] [\"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/id #uuid \"f9aa45a1-9a38-576a-8d4d-2838200c247c\"] [\"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/type :answer.type/math] [\"f9aa45a1-9a38-576a-8d4d-2838200c247c\" :answer/value \"\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/id #uuid \"0d0584aa-aff0-5498-967d-369a9fcfcf85\"] [\"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/key \"field-1\"] [\"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/type :answer-field.type/blank] [\"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/choices \"f9aa45a1-9a38-576a-8d4d-2838200c247c\"] [\"0d0584aa-aff0-5498-967d-369a9fcfcf85\" :answer-field/correct \"f9aa45a1-9a38-576a-8d4d-2838200c247c\"] [\"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/id #uuid \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\"] [\"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/problem \"Using the fact that\\n\\n$$\\n-75^\\\\circ=45^\\\\circ-120^\\\\circ,\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(-75^\\\\circ\\\\right)$.\\n\\n$\\\\cos\\\\left(-75^\\\\circ\\\\right)=$ {{field-1}}\"] [\"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(-75^\\\\circ\\\\right)=\\\\cos\\\\left(45^\\\\circ-120^\\\\circ\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(45^\\\\circ\\\\right)\\\\cos\\\\left(120^\\\\circ\\\\right)+\\\\sin\\\\left(45^\\\\circ\\\\right)\\\\sin\\\\left(120^\\\\circ\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right)+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\frac{\\\\sqrt{3}}{2} \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right)+\\\\frac{\\\\sqrt{6}}{4} \\\\\\\\\\n&=\\\\frac{- \\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/difficulty :question.difficulty/hard] [\"79666e9c-2f88-5b52-bd7c-67da11dc25a1\" :question/answer-fields \"0d0584aa-aff0-5498-967d-369a9fcfcf85\"] [17592186059666 :knowledge-point/questions \"79666e9c-2f88-5b52-bd7c-67da11dc25a1\"] [\"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/id #uuid \"3543ed55-fff1-5697-be0a-011afcd150f6\"] [\"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/type :answer.type/math] [\"3543ed55-fff1-5697-be0a-011afcd150f6\" :answer/value \"\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/id #uuid \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\"] [\"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/key \"field-1\"] [\"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/type :answer-field.type/blank] [\"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/choices \"3543ed55-fff1-5697-be0a-011afcd150f6\"] [\"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\" :answer-field/correct \"3543ed55-fff1-5697-be0a-011afcd150f6\"] [\"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/id #uuid \"1445f9a4-ddce-59b1-855c-0727569a68df\"] [\"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/problem \"Using the fact that\\n\\n$$\\n\\\\frac{23\\\\pi}{12}=\\\\frac{\\\\pi}{6}+\\\\frac{7\\\\pi}{4},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(\\\\frac{23\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(\\\\frac{23\\\\pi}{12}\\\\right)=$ {{field-1}}\"] [\"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/worked-solution \"Recall the sum formula for cosine:\\n\\n$$\\n\\\\cos(x+y)=\\\\cos x\\\\cos y-\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{23\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{6}+\\\\frac{7\\\\pi}{4}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\cos\\\\left(\\\\frac{7\\\\pi}{4}\\\\right)-\\\\sin\\\\left(\\\\frac{\\\\pi}{6}\\\\right)\\\\sin\\\\left(\\\\frac{7\\\\pi}{4}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{3}}{2}\\\\cdot \\\\frac{\\\\sqrt{2}}{2}-\\\\frac{1}{2}\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{2}}{2}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{6}}{4}-\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=\\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/difficulty :question.difficulty/hard] [\"1445f9a4-ddce-59b1-855c-0727569a68df\" :question/answer-fields \"1896ea3c-1d20-5c06-bfaf-b0a6968788a1\"] [17592186059666 :knowledge-point/questions \"1445f9a4-ddce-59b1-855c-0727569a68df\"] [\"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/id #uuid \"554e161c-c2da-55d5-bbd0-6999bf4c663b\"] [\"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/type :answer.type/math] [\"554e161c-c2da-55d5-bbd0-6999bf4c663b\" :answer/value \"- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}\"] [\"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/id #uuid \"03b9b630-0b80-5314-b540-772b35d14a98\"] [\"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/key \"field-1\"] [\"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/type :answer-field.type/blank] [\"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/choices \"554e161c-c2da-55d5-bbd0-6999bf4c663b\"] [\"03b9b630-0b80-5314-b540-772b35d14a98\" :answer-field/correct \"554e161c-c2da-55d5-bbd0-6999bf4c663b\"] [\"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/id #uuid \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\"] [\"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/problem \"Using the fact that\\n\\n$$\\n-\\\\frac{11\\\\pi}{12}=\\\\frac{\\\\pi}{4}-\\\\frac{7\\\\pi}{6},\\n$$\\n\\ncalculate the **exact** value of $\\\\cos\\\\left(-\\\\frac{11\\\\pi}{12}\\\\right)$.\\n\\n$\\\\cos\\\\left(-\\\\frac{11\\\\pi}{12}\\\\right)=$ {{field-1}}\"] [\"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/worked-solution \"Recall the difference formula for cosine:\\n\\n$$\\n\\\\cos(x-y)=\\\\cos x\\\\cos y+\\\\sin x\\\\sin y.\\n$$\\n\\nApply it to the decomposition:\\n\\n$$\\n\\\\cos\\\\left(-\\\\frac{11\\\\pi}{12}\\\\right)=\\\\cos\\\\left(\\\\frac{\\\\pi}{4}-\\\\frac{7\\\\pi}{6}\\\\right).\\n$$\\n\\n$$\\n\\\\cos\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\cos\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)+\\\\sin\\\\left(\\\\frac{\\\\pi}{4}\\\\right)\\\\sin\\\\left(\\\\frac{7\\\\pi}{6}\\\\right)\\n$$\\n\\nSubstitute the signed special-angle values and combine:\\n\\n$$\\n\\\\begin{aligned}\\n&=\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{\\\\sqrt{3}}{2}\\\\right)+\\\\frac{\\\\sqrt{2}}{2}\\\\cdot \\\\left(- \\\\frac{1}{2}\\\\right) \\\\\\\\\\n&=\\\\left(- \\\\frac{\\\\sqrt{6}}{4}\\\\right)+\\\\left(- \\\\frac{\\\\sqrt{2}}{4}\\\\right) \\\\\\\\\\n&=- \\\\frac{\\\\sqrt{2} + \\\\sqrt{6}}{4}.\\n\\\\end{aligned}\\n$$\"] [\"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/difficulty :question.difficulty/hard] [\"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\" :question/answer-fields \"03b9b630-0b80-5314-b540-772b35d14a98\"] [17592186059666 :knowledge-point/questions \"f33fad89-1bf5-5863-a27a-cf99ad3f26e6\"] [\"generator\" :question-generator/id #uuid \"000b985d-474b-5ecb-94a1-4befd443a0d2\"] [\"generator\" :question-generator/script \"generators/11/11f5405dce86981ef8d18c16d69f8bf1925924e54e1966bac413aac8c2d4c2e6/generator.py\"] [17592186059666 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186059666 :knowledge-point/question-generator 17592186715295]]}",
