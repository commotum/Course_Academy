\\,\\operatorname{cos}⁡x \\\\  & =-\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304993 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8540635-abef-588a-a946-2176f8e4be45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303493}] :answer-field/correct {:answer/id #uuid "a8540635-abef-588a-a946-2176f8e4be45" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303493} :answer-field/id #uuid "e2967536-19df-584e-ab0a-cfd6ff920c58" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304691} {:answer-field/choices [{:answer/id #uuid "d7c0318b-0316-57b9-b47b-f54289eeab20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186303803}] :answer-field/correct {:answer/id #uuid "d7c0318b-0316-57b9-b47b-f54289eeab20" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186303803} :answer-field/id #uuid "e55b054f-88f5-579a-a52a-c8475546eb8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304698}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "bfc5afd1-9723-5b19-a1e3-57f1ad1233ac" :question/math-academy-id "q-332178" :question/problem "Express $\\operatorname{sin}⁡(x-{300}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{300}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={300}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{300}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{300}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{300}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot \\left(\\frac{1}{2}\\right)-\\operatorname{cos}⁡x\\cdot \\left(-\\frac{\\sqrt{3}}{2}\\right) \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{1}{2}\\,\\operatorname{sin}⁡x+\\frac{\\sqrt{3}}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186304994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0168083-fd13-58d7-94db-d52dea7980c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186303858}] :answer-field/correct {:answer/id #uuid "e0168083-fd13-58d7-94db-d52dea7980c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186303858} :answer-field/id #uuid "b9749321-65a9-5df7-8e13-3949fd9b6f57" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304580} {:answer-field/choices [{:answer/id #uuid "6eeb6fd3-6bd0-5115-8bce-23039b036ac0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303135}] :answer-field/correct {:answer/id #uuid "6eeb6fd3-6bd0-5115-8bce-23039b036ac0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186303135} :answer-field/id #uuid "fcb27a3b-b684-5e5c-a435-33238a031563" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186304753}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "da4f3b0b-e716-525b-97e5-9d6526f804b7" :question/math-academy-id "q-332180" :question/problem "Express $\\operatorname{sin}⁡(x-{330}^{∘})$ in terms of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x.$\n\n$\\operatorname{sin}⁡(x-{330}^{∘})=$\n{{field-1}}$\\operatorname{sin}⁡x\\,+$\n{{field-2}}$\\operatorname{cos}⁡x$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={330}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{330}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{330}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{330}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot \\left(\\frac{\\sqrt{3}}{2}\\right)-\\operatorname{cos}⁡x\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x \\\\  & =\\frac{\\sqrt{3}}{2}\\,\\operatorname{sin}⁡x+\\frac{1}{2}\\,\\operatorname{cos}⁡x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701658 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62290bda-b3b8-55af-8031-fc5438735023" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12" :db/id #edb/ref 17592186701665}] :answer-field/correct {:answer/id #uuid "62290bda-b3b8-55af-8031-fc5438735023" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12" :db/id #edb/ref 17592186701665} :answer-field/id #uuid "591f4ac5-8c41-521c-be02-37f2ec725601" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701662} {:answer-field/choices [{:answer/id #uuid "fa61bcde-c85a-5079-92c7-d06dd328724c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt3}{2}" :db/id #edb/ref 17592186701674}] :answer-field/correct {:answer/id #uuid "fa61bcde-c85a-5079-92c7-d06dd328724c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt3}{2}" :db/id #edb/ref 17592186701674} :answer-field/id #uuid "612dce16-c87f-50ba-a9b9-c6ada01d4cb9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701663}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "01bece61-4e20-59b8-ba47-2811024557f8" :question/problem "Express $\\sin(x+300^\\circ)$ using $\\sin x$ and $\\cos x$. Enter exact coefficients.\n\n$\\sin(x+300^\\circ)=$ {{field-1}} $\\sin x\\,-$ {{field-2}} $\\cos x$" :question/worked-solution "Recall the sum formula for sine:\n$$\n\\sin(u+v)=\\sin u\\cos v+\\cos u\\sin v.\n$$\nThe angle $300^\\circ$ lies in quadrant IV with reference angle $60^\\circ$, so\n$$\n\\cos300^\\circ=\\frac12,\\qquad \\sin300^\\circ=-\\frac{\\sqrt3}{2}.\n$$\nSubstituting into the sum formula gives\n$$\n\\begin{aligned}\n\\sin(x+300^\\circ)&=\\sin x\\cos300^\\circ+\\cos x\\sin300^\\circ\\\\\n&=\\sin x\\cdot\\frac12+\\cos x\\cdot\\left(-\\frac{\\sqrt3}{2}\\right)\\\\\n&=\\frac12\\sin x-\\frac{\\sqrt3}{2}\\cos x.\n\\end{aligned}\n$$\nThe minus sign is already supplied before the second blank, so the entries are $\\frac12$ and $\\frac{\\sqrt3}{2}$."} {:db/id #edb/ref 17592186701660 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "615e8eaa-97da-577d-86eb-e55ba15f8a95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt2}{2}" :db/id #edb/ref 17592186701664}] :answer-field/correct {:answer/id #uuid "615e8eaa-97da-577d-86eb-e55ba15f8a95" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt2}{2}" :db/id #edb/ref 17592186701664} :answer-field/id #uuid "05b5a62e-e11a-563e-9b79-83e0d28bc51a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701659} {:answer-field/choices [{:answer/id #uuid "9705a543-41d0-574f-8835-efb9872c5cd8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt3+\\sqrt2}{2}" :db/id #edb/ref 17592186701669}] :answer-field/correct {:answer/id #uuid "9705a543-41d0-574f-8835-efb9872c5cd8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt3+\\sqrt2}{2}" :db/id #edb/ref 17592186701669} :answer-field/id #uuid "b1cb2319-ebd2-57a2-8c31-8ca39ca05438" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701670}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "4d725a40-8d02-5848-a5ca-6afc87538588" :question/problem "Express $\\sin(x+150^\\circ)-\\sin(x-45^\\circ)$ in the form $A\\sin x+B\\cos x$. Enter exact, signed coefficients.\n\n$A=$ {{field-1}}\n\n$B=$ {{field-2}}" :question/worked-solution "Use the sum and difference formulas for sine:\n$$\n\\begin{aligned}\n\\sin(u+v)&=\\sin u\\cos v+\\cos u\\sin v,\\\\\n\\sin(u-v)&=\\sin u\\cos v-\\cos u\\sin v.\n\\end{aligned}\n$$\nThe needed exact values are\n$$\n\\begin{aligned}\n\\cos150^\\circ&=-\\frac{\\sqrt3}{2}, & \\sin150^\\circ&=\\frac12,\\\\\n\\cos45^\\circ&=\\frac{\\sqrt2}{2}, & \\sin45^\\circ&=\\frac{\\sqrt2}{2}.\n\\end{aligned}\n$$\nExpand each sine expression:\n$$\n\\begin{aligned}\n\\sin(x+150^\\circ)&=-\\frac{\\sqrt3}{2}\\sin x+\\frac12\\cos x,\\\\\n\\sin(x-45^\\circ)&=\\frac{\\sqrt2}{2}\\sin x-\\frac{\\sqrt2}{2}\\cos x.\n\\end{aligned}\n$$\nLet $E$ denote the original expression. Subtract the entire second expansion, reversing both of its signs, and collect the sine and cosine terms:\n$$\n\\begin{aligned}\nE&=\\left(-\\frac{\\sqrt3}{2}\\sin x+\\frac12\\cos x\\right)\\\\\n &\\quad-\\left(\\frac{\\sqrt2}{2}\\sin x-\\frac{\\sqrt2}{2}\\cos x\\right)\\\\\n &=\\left(-\\frac{\\sqrt3}{2}-\\frac{\\sqrt2}{2}\\right)\\sin x\\\\\n &\\quad+\\left(\\frac12+\\frac{\\sqrt2}{2}\\right)\\cos x\\\\\n &=-\\frac{\\sqrt3+\\sqrt2}{2}\\sin x+\\frac{1+\\sqrt2}{2}\\cos x.\n\\end{aligned}\n$$\nThus $A=-\\frac{\\sqrt3+\\sqrt2}{2}$ and $B=\\frac{1+\\sqrt2}{2}$."} {:db/id #edb/ref 17592186701661 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763cac61-281d-5188-9233-3ff8cb1622f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x+\\cos x" :db/id #edb/ref 17592186701666} {:answer/id #uuid "78e5cdbf-7cf2-52a8-8c9f-074253635f1a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\cos x" :db/id #edb/ref 17592186701667} {:answer/id #uuid "95731460-d6c9-5f58-a9a2-32cce0dcbf8a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x" :db/id #edb/ref 17592186701668} {:answer/id #uuid "e944fc36-c0f1-5655-aa73-de2df20a5234" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x" :db/id #edb/ref 17592186701672} {:answer/id #uuid "ed5b6c83-631f-579e-a2bd-8ed52bb95f76" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186701673}] :answer-field/correct {:answer/id #uuid "ed5b6c83-631f-579e-a2bd-8ed52bb95f76" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos x" :db/id #edb/ref 17592186701673} :answer-field/id #uuid "bd6c5231-09c2-52a4-928b-4e49edbc463a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701671}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "510d0ad5-a38a-5942-b886-27217a13f30c" :question/problem "Express $\\sin(x+90^\\circ)$ in terms of $\\sin x$ or $\\cos x$.\n\n$\\sin(x+90^\\circ)=$" :question/worked-solution "Recall the sum formula for sine:\n$$\n\\sin(u+v)=\\sin u\\cos v+\\cos u\\sin v.\n$$\nApply it with $u=x$ and $v=90^\\circ$. Since $\\cos90^\\circ=0$ and $\\sin90^\\circ=1$,\n$$\n\\begin{aligned}\n\\sin(x+90^\\circ)&=\\sin x\\cos90^\\circ+\\cos x\\sin90^\\circ\\\\\n&=\\sin x\\cdot0+\\cos x\\cdot1\\\\\n&=\\cos x.\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136ae130-443b-5f11-8e83-a981cd50acf6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186701794}] :answer-field/correct {:answer/id #uuid "136ae130-443b-5f11-8e83-a981cd50acf6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186701794} :answer-field/id #uuid "299fa3c1-0baf-5a80-a2d4-3a6af24e17ec" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701796} {:answer-field/choices [{:answer/id #uuid "51476b14-a8f9-550d-b3ad-ed5457ad5f69" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186701798}] :answer-field/correct {:answer/id #uuid "51476b14-a8f9-550d-b3ad-ed5457ad5f69" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186701798} :answer-field/id #uuid "c77adf94-4dd8-5850-9b20-d9ca2a905863" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701814}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0eacfd6d-9dd7-540d-af8e-6932ed09c531" :question/problem "Express $\\sin(x-225^\\circ)$ using $\\sin x$ and $\\cos x$. Enter exact coefficients, including their signs.\n\n$\\sin(x-225^\\circ)=$ {{field-1}} $\\sin x-$ {{field-2}} $\\cos x$" :question/worked-solution "Use the difference formula for sine:\n$$\n\\sin(u-v)=\\sin u\\cos v-\\cos u\\sin v.\n$$\nApply it and substitute the exact special-angle values:\n$$\n\\begin{aligned}\n\\sin(x-225^\\circ)&=\\sin x\\cos 225^\\circ-\\cos x\\sin 225^\\circ\\\\\n&=\\sin x\\cdot\\left(-\\frac{\\sqrt{2}}{2}\\right)-\\cos x\\cdot\\left(-\\frac{\\sqrt{2}}{2}\\right)\\\\\n&=-\\frac{\\sqrt{2}}{2}\\sin x+\\frac{\\sqrt{2}}{2}\\cos x\n\\end{aligned}\n$$\nThe minus sign outside the second blank is supplied. The entries are $-\\frac{\\sqrt{2}}{2}$ and $-\\frac{\\sqrt{2}}{2}$, respectively."} {:db/id #edb/ref 17592186701797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a7eb16c-e91e-50f1-8ad6-80a45794cd09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\sin x-\\frac{\\sqrt{2}}{2}\\cos x" :db/id #edb/ref 17592186701801} {:answer/id #uuid "d2edfd32-df36-50d8-b817-9928c83f78e1" :answer/type {:db/ident :answer.type/math} :answer/value 