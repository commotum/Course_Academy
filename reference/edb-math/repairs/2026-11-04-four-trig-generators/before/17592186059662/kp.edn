#{[{:db/id #edb/ref 17592186059662 :knowledge-point/canonical-example {:db/id #edb/ref 17592186059493 :question/id #uuid "4cd24c10-1838-5f4b-ac88-cfbfc2ec4c21" :question/math-academy-id "e-3518" :question/problem "Express $\\sin\\left(x - 30^{\\circ} \\right )$ in terms of $\\sin x$ and $\\cos x.$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\sin(u-v) = \\sin u\\cos v - \\cos u\\sin v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=30^{\\circ},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{30}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{30}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{30}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot \\left(\\frac{\\sqrt{3}}{2}\\right)-\\operatorname{cos}⁡x\\cdot \\left(\\frac{1}{2}\\right) \\\\  & =\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2}-\\frac{\\operatorname{cos}⁡x}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"} :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id #edb/ref 17592186701824 :question-generator/id #uuid "82966369-e84d-5446-9fc9-c6effbcc7f90" :question-generator/script "generators/12/12cd4a2cf5a92b6b9e216341ce07366cb5a7369ae37958ce8057421f1ed5a48f/generator.py"} :knowledge-point/questions [{:db/id #edb/ref 17592186060120 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11056920-f672-5f49-87f8-c2e42a4f708c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186281847} {:answer/id #uuid "1b72638a-a341-5e44-853d-bf560ae64987" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{\\sqrt{3}}" :db/id #edb/ref 17592186281938} {:answer/id #uuid "51f8662e-5812-55cd-8d27-36142f686750" :answer/type {:db/ident