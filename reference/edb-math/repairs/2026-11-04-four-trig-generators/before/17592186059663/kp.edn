\\sqrt{2}}{2}\\cdot \\frac{1}{2} \\\\ &=\\frac{\\sqrt{6}}{4}-\\frac{\\sqrt{2}}{4} \\\\ &=\\frac{\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705214 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1df138aa-05e5-567c-a66c-f9caf5015e3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705191} {:answer/id #uuid "5adf7cb6-245b-5a7e-b3cf-c83b1d10dd16" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705196} {:answer/id #uuid "803f77c2-301b-5e2e-80e8-e2f31ecb3762" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705202} {:answer/id #uuid "867b5bf6-2d0e-5ec7-8bda-658b0f3633c7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186705205} {:answer/id #uuid "b1a4afdd-14d1-58f3-901e-163cf8154476" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705207}] :answer-field/correct {:answer/id #uuid "b1a4afdd-14d1-58f3-901e-163cf8154476" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705207} :answer-field/id #uuid "431853cc-5e13-5e3b-84b6-1a67d720868f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186705194}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ef930dc5-9f6a-5590-a1a8-7bb3ed9e0470" :question/problem "What is the exact value of $\\sin\\left(-255^\\circ\\right)$ without using a calculator?" :question/worked-solution "Write the angle as a sum or difference of special angles: $-255^\\circ=60^\\circ-315^\\circ$.\n\nRecall the difference formula for sine:\n\n$$\n\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(-255^\\circ\\right) &=\\sin\\left(60^\\circ-315^\\circ\\right) \\\\ &=\\sin\\left(60^\\circ\\right)\\cos\\left(315^\\circ\\right)-\\cos\\left(60^\\circ\\right)\\sin\\left(315^\\circ\\right) \\\\ &=\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2}-\\frac{1}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\ &=\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\ &=\\frac{\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705254 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d29c2be-a907-5b53-b049-82df061eda03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705246} {:answer/id #uuid "3f41fb6d-d4ef-5fc2-a670-c4c4f788b365" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705248} {:answer/id #uuid "408793bc-d590-591f-aa43-6c620bb7435e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705249} {:answer/id #uuid "6b4a3d61-7fa4-5ff4-8442-490258b290f5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186705253} {:answer/id #uuid "84cb92cd-7771-5866-acc4-2fedeb16ee25" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705256}] :answer-field/correct {:answer/id #uuid "408793bc-d590-591f-aa43-6c620bb7435e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705249} :answer-field/id #uuid "4e7a615a-2580-57c5-960d-14c7e2d27495" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186705252}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "76934c31-4987-519b-bb41-5e4cdf6610e5" :question/problem "What is the exact value of $\\sin\\left(\\frac{19\\pi}{12}\\right)$ without using a calculator?\n\n*Hint: Use the fact that $\\frac{19\\pi}{12}=\\frac{11\\pi}{6}-\\frac{\\pi}{4}$.*" :question/worked-solution "Write the angle as a sum or difference of special angles: $\\frac{19\\pi}{12}=\\frac{11\\pi}{6}-\\frac{\\pi}{4}$.\n\nRecall the difference formula for sine:\n\n$$\n\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(\\frac{19\\pi}{12}\\right) &=\\sin\\left(\\frac{11\\pi}{6}-\\frac{\\pi}{4}\\right) \\\\ &=\\sin\\left(\\frac{11\\pi}{6}\\right)\\cos\\left(\\frac{\\pi}{4}\\right)-\\cos\\left(\\frac{11\\pi}{6}\\right)\\sin\\left(\\frac{\\pi}{4}\\right) \\\\ &=\\left(-\\frac{1}{2}\\right)\\cdot \\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\ &=-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{-\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f102d4d-ff7a-56bc-aa84-c0c45ebe9e31" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705247} {:answer/id #uuid "40885653-e5c7-5ea9-a479-266943eb79ce" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705250} {:answer/id #uuid "4d8d8c07-625a-521e-be19-dbbd712fbed2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705251} {:answer/id #uuid "c68db47f-54f9-5422-a8bb-d950ff7c7731" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186705261} {:answer/id #uuid "da2c1831-e9a5-5b0e-9847-e8eaf7359020" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705263}] :answer-field/correct {:answer/id #uuid "da2c1831-e9a5-5b0e-9847-e8eaf7359020" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705263} :answer-field/id #uuid "241f093f-3aeb-5245-ba8d-fdc8d16f583a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186705245}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "86a6967f-c1b2-59a9-b1dd-d20c99ad7a01" :question/problem "What is the exact value of $\\sin\\left(\\frac{11\\pi}{12}\\right)$ without using a calculator?\n\n*Hint: Use the fact that $\\frac{11\\pi}{12}=\\frac{\\pi}{4}+\\frac{2\\pi}{3}$.*" :question/worked-solution "Write the angle as a sum or difference of special angles: $\\frac{11\\pi}{12}=\\frac{\\pi}{4}+\\frac{2\\pi}{3}$.\n\nRecall the sum formula for sine:\n\n$$\n\\sin(x+y)=\\sin x\\cos y+\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(\\frac{11\\pi}{12}\\right) &=\\sin\\left(\\frac{\\pi}{4}+\\frac{2\\pi}{3}\\right) \\\\ &=\\sin\\left(\\frac{\\pi}{4}\\right)\\cos\\left(\\frac{2\\pi}{3}\\right)+\\cos\\left(\\frac{\\pi}{4}\\right)\\sin\\left(\\frac{2\\pi}{3}\\right) \\\\ &=\\frac{\\sqrt{2}}{2}\\cdot \\left(-\\frac{1}{2}\\right)+\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\ &=-\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "167ba3e6-b166-5123-847d-1c9617d73207" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{4}" :db/id #edb/ref 17592186705244} {:answer/id #uuid "7e9086fa-b269-5ad9-b08d-ac60a2413242" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705255} {:answer/id #uuid "86cbd4a2-ad4c-5207-a179-212f04f8860f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705258} {:answer/id #uuid "87f4a8ba-9120-57aa-8a86-97cd7934af27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705259} {:answer/id #uuid "b63221ba-e41f-51e0-8fc5-ed4a81223516" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186705260}] :answer-field/correct {:answer/id #uuid "87f4a8ba-9120-57aa-8a86-97cd7934af27" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186705259} :answer-field/id #uuid "c717afd8-69ea-55a6-b2f2-fc9c6dd6db64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186705262}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f3cc533d-6704-53aa-9a3e-745ca513e58d" :question/problem "What is the exact value of $\\sin\\left(\\frac{13\\pi}{12}\\right)$ without using a calculator?\n\n*Hint: Use the fact that $\\frac{13\\pi}{12}=\\frac{11\\pi}{6}-\\frac{3\\pi}{4}$.*" :question/worked-solution "Write the angle as a sum or difference of special angles: $\\frac{13\\pi}{12}=\\frac{11\\pi}{6}-\\frac{3\\pi}{4}$.\n\nRecall the difference formula for sine:\n\n$$\n\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(\\frac{13\\pi}{12}\\right) &=\\sin\\left(\\frac{11\\pi}{6}-\\frac{3\\pi}{4}\\right) \\\\ &=\\sin\\left(\\frac{11\\pi}{6}\\right)\\cos\\left(\\frac{3\\pi}{4}\\right)-\\cos\\left(\\frac{11\\pi}{6}\\right)\\sin\\left(\\frac{3\\pi}{4}\\right) \\\\ &=\\left(-\\frac{1}{2}\\right)\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right)-\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\ &=\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{-\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"}] :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}]}
