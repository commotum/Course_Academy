\\right) \\\\ &=-\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34aeac79-6868-578f-9a6e-3f20c4815605" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186701914} {:answer/id #uuid "4f4016a0-1a51-5700-8960-56e80ba62522" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186701918} {:answer/id #uuid "62770c2e-df16-506e-8efd-f07fd27cc451" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{6}}{4}" :db/id #edb/ref 17592186701920} {:answer/id #uuid "7899de01-d729-5ba0-86bc-3d4dd8b0d112" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186701922} {:answer/id #uuid "b4acc0aa-c036-50b6-ab92-710ee41ec1ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186701930}] :answer-field/correct {:answer/id #uuid "34aeac79-6868-578f-9a6e-3f20c4815605" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}+\\sqrt{2}}{4}" :db/id #edb/ref 17592186701914} :answer-field/id #uuid "ed76dac3-2a3b-5ae7-986e-c6b29a921fc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186701935}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "594b65a8-e270-5e2d-b7a0-ff5d51b00e6e" :question/problem "What is the exact value of $\\sin\\left(-285^\\circ\\right)$ without using a calculator?\n\n*Hint: Use the fact that $-285^\\circ=45^\\circ-330^\\circ$.*" :question/worked-solution "Write the angle as a sum or difference of special angles: $-285^\\circ=45^\\circ-330^\\circ$.\n\nRecall the difference formula for sine:\n\n$$\n\\sin(x-y)=\\sin x\\cos y-\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(-285^\\circ\\right) &=\\sin\\left(45^\\circ-330^\\circ\\right) \\\\ &=\\sin\\left(45^\\circ\\right)\\cos\\left(330^\\circ\\right)-\\cos\\left(45^\\circ\\right)\\sin\\left(330^\\circ\\right) \\\\ &=\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\left(-\\frac{1}{2}\\right) \\\\ &=\\frac{\\sqrt{6}}{4}+\\frac{\\sqrt{2}}{4} \\\\ &=\\frac{\\sqrt{6}+\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701924 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2644b610-7723-5ada-92c4-a5bb03725771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186701912}] :answer-field/correct {:answer/id #uuid "2644b610-7723-5ada-92c4-a5bb03725771" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186701912} :answer-field/id #uuid "05e9e0a1-75a9-5f0f-b5fe-92b1130c240b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701910}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "7cf906bd-8773-5c99-9c04-015afcfd7296" :question/problem "Using the fact that $165^\\circ=30^\\circ+135^\\circ$, calculate the **exact** value of $\\sin\\left(165^\\circ\\right)$ without a calculator.\n\n$\\sin\\left(165^\\circ\\right)=$ {{field-1}}" :question/worked-solution "Write the angle as a sum or difference of special angles: $165^\\circ=30^\\circ+135^\\circ$.\n\nRecall the sum formula for sine:\n\n$$\n\\sin(x+y)=\\sin x\\cos y+\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(165^\\circ\\right) &=\\sin\\left(30^\\circ+135^\\circ\\right) \\\\ &=\\sin\\left(30^\\circ\\right)\\cos\\left(135^\\circ\\right)+\\cos\\left(30^\\circ\\right)\\sin\\left(135^\\circ\\right) \\\\ &=\\frac{1}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right)+\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\ &=-\\frac{\\sqrt{2}}{4}+\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701934 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97d3e1da-801c-525d-a6cc-94f36a436e7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186701926}] :answer-field/correct {:answer/id #uuid "97d3e1da-801c-525d-a6cc-94f36a436e7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{6}-\\sqrt{2}}{4}" :db/id #edb/ref 17592186701926} :answer-field/id #uuid "22ea227f-8c8a-51a4-a2ed-bcc267d9a727" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186701911}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d4a5db3e-855f-5a6e-ba7c-fab5ea268cd6" :question/problem "Using the fact that $255^\\circ=30^\\circ+225^\\circ$, calculate the **exact** value of $\\sin\\left(255^\\circ\\right)$ without a calculator.\n\n$\\sin\\left(255^\\circ\\right)=$ {{field-1}}" :question/worked-solution "Write the angle as a sum or difference of special angles: $255^\\circ=30^\\circ+225^\\circ$.\n\nRecall the sum formula for sine:\n\n$$\n\\sin(x+y)=\\sin x\\cos y+\\cos x\\sin y\n$$\n\nSubstitute the signed unit-circle values, multiply, and combine:\n\n$$\n\\begin{aligned}\\sin\\left(255^\\circ\\right) &=\\sin\\left(30^\\circ+225^\\circ\\right) \\\\ &=\\sin\\left(30^\\circ\\right)\\cos\\left(225^\\circ\\right)+\\cos\\left(30^\\circ\\right)\\sin\\left(225^\\circ\\right) \\\\ &=\\frac{1}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right)+\\frac{\\sqrt{3}}{2}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\ &=-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\ &=\\frac{-\\sqrt{6}-\\sqrt{2}}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0be4