3c4dad-39b7-55f7-91a6-f184104aea4e" :answer-field/choices "0b6d34cc-e290-537c-b44d-88b382e25757"] [:db/add "5d3c4dad-39b7-55f7-91a6-f184104aea4e" :answer-field/choices "9ac27650-3805-55b4-b960-7c0a60bb5463"] [:db/add "5d3c4dad-39b7-55f7-91a6-f184104aea4e" :answer-field/choices "68d86fa5-acb2-5971-8f4f-813d5b3c30be"] [:db/add "5d3c4dad-39b7-55f7-91a6-f184104aea4e" :answer-field/choices "c7309caf-9d0f-58c9-8268-d84170c869e8"] [:db/add "5d3c4dad-39b7-55f7-91a6-f184104aea4e" :answer-field/correct "9ac27650-3805-55b4-b960-7c0a60bb5463"] [:db/ensure "5d3c4dad-39b7-55f7-91a6-f184104aea4e" :answer-field/validate] [:db/add "1feaa59d-f154-5ff9-a24e-73a97dbf734c" :question/id #uuid "1feaa59d-f154-5ff9-a24e-73a97dbf734c"] [:db/add "1feaa59d-f154-5ff9-a24e-73a97dbf734c" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{6}} \\frac{4}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "1feaa59d-f154-5ff9-a24e-73a97dbf734c" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{3}=\\frac{4}{3}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{6}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{6}} \\frac{4}{\\sqrt{1 - 9 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{4}{3}\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=\\frac{4}{3}\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2 \\pi}{9}.\n$$"] [:db/add "1feaa59d-f154-5ff9-a24e-73a97dbf734c" :question/difficulty :question.difficulty/easy] [:db/add "1feaa59d-f154-5ff9-a24e-73a97dbf734c" :question/answer-fields "5d3c4dad-39b7-55f7-91a6-f184104aea4e"] [:db/ensure "1feaa59d-f154-5ff9-a24e-73a97dbf734c" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "1feaa59d-f154-5ff9-a24e-73a97dbf734c"] [:db/add "d3c732dd-5a33-512c-a76e-7431c5b3e2d6" :answer/id #uuid "d3c732dd-5a33-512c-a76e-7431c5b3e2d6"] [:db/add "d3c732dd-5a33-512c-a76e-7431c5b3e2d6" :answer/type :answer.type/math] [:db/add "d3c732dd-5a33-512c-a76e-7431c5b3e2d6" :answer/value "\\frac{3 \\pi}{20}"] [:db/ensure "d3c732dd-5a33-512c-a76e-7431c5b3e2d6" :answer/validate] [:db/add "b571c826-ba48-5e61-9fea-dbd878d7f88a" :answer/id #uuid "b571c826-ba48-5e61-9fea-dbd878d7f88a"] [:db/add "b571c826-ba48-5e61-9fea-dbd878d7f88a" :answer/type :answer.type/math] [:db/add "b571c826-ba48-5e61-9fea-dbd878d7f88a" :answer/value "0"] [:db/ensure "b571c826-ba48-5e61-9fea-dbd878d7f88a" :answer/validate] [:db/add "2805ba98-cdf0-5287-8813-b3a853d065cf" :answer/id #uuid "2805ba98-cdf0-5287-8813-b3a853d065cf"] [:db/add "2805ba98-cdf0-5287-8813-b3a853d065cf" :answer/type :answer.type/math] [:db/add "2805ba98-cdf0-5287-8813-b3a853d065cf" :answer/value "- \\frac{3 \\pi}{10}"] [:db/ensure "2805ba98-cdf0-5287-8813-b3a853d065cf" :answer/validate] [:db/add "58697149-40ef-591b-a688-719cc761531d" :answer/id #uuid "58697149-40ef-591b-a688-719cc761531d"] [:db/add "58697149-40ef-591b-a688-719cc761531d" :answer/type :answer.type/math] [:db/add "58697149-40ef-591b-a688-719cc761531d" :answer/value "\\frac{3 \\pi}{10}"] [:db/ensure "58697149-40ef-591b-a688-719cc761531d" :answer/validate] [:db/add "79946dc9-d4f2-50b3-a693-2402f98713c3" :answer/id #uuid "79946dc9-d4f2-50b3-a693-2402f98713c3"] [:db/add "79946dc9-d4f2-50b3-a693-2402f98713c3" :answer/type :answer.type/math] [:db/add "79946dc9-d4f2-50b3-a693-2402f98713c3" :answer/value "\\frac{3 \\pi}{20} + 2"] [:db/ensure "79946dc9-d4f2-50b3-a693-2402f98713c3" :answer/validate] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/id #uuid "f7144acc-1ee0-5d9f-945c-9dae241fc93c"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/key "answer"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/type :answer-field.type/radio] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/choices "d3c732dd-5a33-512c-a76e-7431c5b3e2d6"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/choices "b571c826-ba48-5e61-9fea-dbd878d7f88a"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/choices "2805ba98-cdf0-5287-8813-b3a853d065cf"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/choices "58697149-40ef-591b-a688-719cc761531d"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/choices "79946dc9-d4f2-50b3-a693-2402f98713c3"] [:db/add "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/correct "d3c732dd-5a33-512c-a76e-7431c5b3e2d6"] [:db/ensure "f7144acc-1ee0-5d9f-945c-9dae241fc93c" :answer-field/validate] [:db/add "b2e63285-7417-50ad-bb20-73e004f347f0" :question/id #uuid "b2e63285-7417-50ad-bb20-73e004f347f0"] [:db/add "b2e63285-7417-50ad-bb20-73e004f347f0" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{5}} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "b2e63285-7417-50ad-bb20-73e004f347f0" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{5}=\\frac{3}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{5}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{5}} \\frac{3}{25 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{3}{5}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{3}{5}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3 \\pi}{20}.\n$$"] [:db/add "b2e63285-7417-50ad-bb20-73e004f347f0" :question/difficulty :question.difficulty/easy] [:db/add "b2e63285-7417-50ad-bb20-73e004f347f0" :question/answer-fields "f7144acc-1ee0-5d9f-945c-9dae241fc93c"] [:db/ensure "b2e63285-7417-50ad-bb20-73e004f347f0" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "b2e63285-7417-50ad-bb20-73e004f347f0"] [:db/add "064fd54f-9fe2-5b01-86e2-39f7183612e2" :answer/id #uuid "064fd54f-9fe2-5b01-86e2-39f7183612e2"] [:db/add "064fd54f-9fe2-5b01-86e2-39f7183612e2" :answer/type :answer.type/math] [:db/add "064fd54f-9fe2-5b01-86e2-39f7183612e2" :answer/value "- \\frac{\\pi}{6}"] [:db/ensure "064fd54f-9fe2-5b01-86e2-39f7183612e2" :answer/validate] [:db/add "5d49318d-ad10-55cc-b045-fac7e2c46bc6" :answer/id #uuid "5d49318d-ad10-55cc-b045-fac7e2c46bc6"] [:db/add "5d49318d-ad10-55cc-b045-fac7e2c46bc6" :answer/type :answer.type/math] [:db/add "5d49318d-ad10-55cc-b045-fac7e2c46bc6" :answer/value "\\frac{\\pi}{2}"] [:db/ensure "5d49318d-ad10-55cc-b045-fac7e2c46bc6" :answer/validate] [:db/add "d48faa79-e2a4-5f72-9331-0f3ba8a15e16" :answer/id #uuid "d48faa79-e2a4-5f72-9331-0f3ba8a15e16"] [:db/add "d48faa79-e2a4-5f72-9331-0f3ba8a15e16" :answer/type :answer.type/math] [:db/add "d48faa79-e2a4-5f72-9331-0f3ba8a15e16" :answer/value "0"] [:db/ensure "d48faa79-e2a4-5f72-9331-0f3ba8a15e16" :answer/validate] [:db/add "d9e5d8b6-a37e-530c-8f9f-2c4508a52f2b" :answer/id #uuid "d9e5d