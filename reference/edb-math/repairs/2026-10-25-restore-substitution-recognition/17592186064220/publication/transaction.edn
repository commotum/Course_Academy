c3c21" :answer-field/correct "2d0c96de-b3a7-5494-94ac-ae1b11ca6a1a"] [:db/ensure "841b34f0-7031-549e-b3e8-49becfbc3c21" :answer-field/validate] [:db/add "00924dd3-6d74-5429-a5be-6719353db7ac" :question/id #uuid "00924dd3-6d74-5429-a5be-6719353db7ac"] [:db/add "00924dd3-6d74-5429-a5be-6719353db7ac" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{2}} \\frac{3}{4 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "00924dd3-6d74-5429-a5be-6719353db7ac" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{2}=\\frac{3}{2}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{2}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{2}} \\frac{3}{4 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{3}{2}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{3}{2}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3 \\pi}{8}.\n$$"] [:db/add "00924dd3-6d74-5429-a5be-6719353db7ac" :question/difficulty :question.difficulty/easy] [:db/add "00924dd3-6d74-5429-a5be-6719353db7ac" :question/answer-fields "841b34f0-7031-549e-b3e8-49becfbc3c21"] [:db/ensure "00924dd3-6d74-5429-a5be-6719353db7ac" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "00924dd3-6d74-5429-a5be-6719353db7ac"] [:db/add "c52c5873-b676-5c8e-8445-18dfbde61af0" :answer/id #uuid "c52c5873-b676-5