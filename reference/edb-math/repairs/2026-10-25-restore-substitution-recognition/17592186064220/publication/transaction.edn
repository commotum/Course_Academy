6bf140-48dd-53af-afae-f8f26b57bfd6" :answer-field/validate] [:db/add "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331" :question/id #uuid "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331"] [:db/add "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{4}} \\frac{2}{16 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{4}=\\frac{1}{2}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{4}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{4}} \\frac{2}{16 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{1}{2}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"] [:db/add "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331" :question/difficulty :question.difficulty/easy] [:db/add "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331" :question/answer-fields "e16bf140-48dd-53af-afae-f8f26b57bfd6"] [:db/ensure "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "ef4ff22f-d7cc-5ff1-a8c9-e0c6487fa331"] [:db/add "generator" :question-generator/id #uuid "b051acd5-f59d-545a-bf2d-089b7c5a60a4"] [:db/add "generator" :question-generator/script "generators/c8/c8105d1fadcd