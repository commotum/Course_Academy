b5" :answer-field/choices "5e21a22e-b0c2-57a5-a770-7bc3a33f25ee"] [:db/add "6b1f4898-8933-5ffa-9d32-1b006f6824b5" :answer-field/choices "77abd06f-5086-54a8-ae6b-ceb7b617ba72"] [:db/add "6b1f4898-8933-5ffa-9d32-1b006f6824b5" :answer-field/choices "7ee8033b-db95-5d8a-8756-c68da261a9de"] [:db/add "6b1f4898-8933-5ffa-9d32-1b006f6824b5" :answer-field/choices "74e99998-fa45-5d9c-8c34-1ec4f03f4690"] [:db/add "6b1f4898-8933-5ffa-9d32-1b006f6824b5" :answer-field/choices "3bb114e7-2bfb-530b-97e1-706960c63b4a"] [:db/add "6b1f4898-8933-5ffa-9d32-1b006f6824b5" :answer-field/correct "7ee8033b-db95-5d8a-8756-c68da261a9de"] [:db/ensure "6b1f4898-8933-5ffa-9d32-1b006f6824b5" :answer-field/validate] [:db/add "fc42df58-65de-5a98-94e4-e78fc895ec49" :question/id #uuid "fc42df58-65de-5a98-94e4-e78fc895ec49"] [:db/add "fc42df58-65de-5a98-94e4-e78fc895ec49" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{10}} \\frac{3}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "fc42df58-65de-5a98-94e4-e78fc895ec49" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{5}=\\frac{3}{5}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{10}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{10}} \\frac{3}{\\sqrt{1 - 25 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{3}{5}\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{3}{5}\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=\\frac{3}{5}\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{10}.\n$$"] [:db/add "fc42df58-65de-5a98-94e4-e78fc895ec49" :question/difficulty :question.difficulty/easy] [:db/add "fc42df58-65de-5a98-94e4-e78fc895ec49" :question/answer-fields "6b1f4898-8933-5ffa-9d32-1b006f6824b5"] [:db/ensure "fc42df58-65de-5a98-94e4-e78fc895ec49" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "fc42df58-65de-5a98-94e4-e78fc895ec49"] [:db/add "fdea8eea-6165-5cda-9308-d150b140eaa2" :answer/id #uuid "fdea8eea-6165-5cda-9308-d150b140eaa2"] [:db/add "fdea8eea-6165-5cda-9308-d150b140eaa2" :answer/type :answer.type/math] [:db/add "fdea8eea-6165-5cda-9308-d150b140eaa2" :answer/value "\\frac{\\pi}{3} + 2"] [:db/ensure "fdea8eea-6165-5cda-9308-d150b140eaa2" :answer/validate] [:db/add "efe38840-41b1-546c-b3c4-c988f2ba7552" :answer/id #uuid "efe38840-41b1-546c-b3c4-c988f2ba7552"] [:db/add "efe38840-41b1-546c-b3c4-c988f2ba7552" :answer/type :answer.type/math] [:db/add "efe38840-41b1-546c-b3c4-c988f2ba7552" :answer/value "- \\frac{\\pi}{3}"] [:db/ensure "efe38840-41b1-546c-b3c4-c988f2ba7552" :answer/validate] [:db/add "1409665d-b7c1-5c47-8379-77c9d01d95d9" :answer/id #uuid "1409665d-b7c1-5c47-8379-77c9d01d95d9"] [:db/add "1409665d-b7c1-5c47-8379-77c9d01d95d9" :answer/type :answer.type/math] [:db/add "1409665d-b7c1-5c47-8379-77c9d01d95d9" :answer/value "\\pi"] [:db/ensure "1409665d-b7c1-5c47-8379-77c9d01d95d9" :answer/validate] [:db/add "7277aeb8-a7ef-554f-9255-e8a657c07ac5" :answer/id #uuid "7277aeb8-a7ef-554f-9255-e8a657c07ac5"] [:db/add "7277aeb8-a7ef-554f-9255-e8a657c07ac5" :answer/type :answer.type/math] [:db/add "7277aeb8-a7ef-554f-9255-e8a657c07ac5" :answer/value "\\frac{\\pi}{3}"] [:db/ensure "7277aeb8-a7ef-554f-9255-e8a657c07ac5" :answer/validate] [:db/add "54c5f71b-b5b7-55be-8b35-4844fa2a87ea" :answer/id #uuid "54c5f71b-b5b7-55be-8b35-4844fa2a87ea"] [:db/add "54c5f71b-b5b7-55be-8b35-4844fa2a87ea" :answer/type :answer.type/math] [:db/add "54c5f71b-b5b7-55be-8b35-4844fa2a87ea" :answer/value "\\frac{2 \\pi}{3}"] [:db/ensure "54c5f71b-b5b7-55be-8b35-4844fa2a87ea" :answer/validate] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/id #uuid "6d3ee101-7e4f-5c04-b41b-97398c14f916"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/key "answer"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/type :answer-field.type/radio] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/choices "fdea8eea-6165-5cda-9308-d150b140eaa2"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/choices "efe38840-41b1-546c-b3c4-c988f2ba7552"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/choices "1409665d-b7c1-5c47-8379-77c9d01d95d9"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/choices "7277aeb8-a7ef-554f-9255-e8a657c07ac5"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/choices "54c5f71b-b5b7-55be-8b35-4844fa2a87ea"] [:db/add "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/correct "7277aeb8-a7ef-554f-9255-e8a657c07ac5"] [:db/ensure "6d3ee101-7e4f-5c04-b41b-97398c14f916" :answer-field/validate] [:db/add "8036e401-1ec2-57bd-8035-1d4fa9902fd3" :question/id #uuid "8036e401-1ec2-57bd-8035-1d4fa9902fd3"] [:db/add "8036e401-1ec2-57bd-8035-1d4fa9902fd3" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{3}} \\frac{4}{9 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "8036e401-1ec2-57bd-8035-1d4fa9902fd3" :question/worked-solution "Let $u=3 x$. Then $\\mathrm{d}u=(3)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{3}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{3}=\\frac{4}{3}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{3}&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} \\frac{4}{9 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{4}{3}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{4}{3}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"] [:db/add "8036e401-1ec2-57bd-8035-1d4fa9902fd3" :question/difficulty :question.difficulty/easy] [:db/add "8036e401-1ec2-57bd-8035-1d4fa9902fd3" :question/answer-fields "6d3ee101-7e4f-5c04-b41b-97398c14f916"] [:db/ensure "8036e401-1ec2-57bd-8035-1d4fa9902fd3" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "8036e401-1ec2-57bd-8035-1d4fa9902fd3"] [:db/add "c719c30e-0869-555e-9ba0-3311b02ebe61" :answer/id #uuid "c719c30e-0869-555e-9ba0-3311b02ebe61"] [:db/add "c719c30e-0869-555e-9ba0-3311b02ebe61" :answer/type :answer.type/math] [:db/add "c719c30e-0869-555e-9ba0-3311b02ebe61" :answer/value "\\frac{\\pi}{2}"] [:db/ensure "c719c30e-0869-555e-9ba0-3311b02ebe61" :answer/validate] [:db/add "808f5add-18d1-54ba-b00b-92a62a4de4c2" :answer/id #uuid "808f5add-18d1-54ba-b00b-92a62a4de4c2"] [:db/add "808f5add-18d1-54ba-b00b-92a62a4de4c2" :answer/type :answer.type/math] [:db/add "808f5add-18d1-54ba-b00b-92a62a4de4c2" :answer/value "\\frac{\\pi}{12}"] [:db/ensure "808f5add-18d1-54ba-b00b-92a62a4de4c2" :answer/validate] [:db/add "1a53354f-87fd-55d1-9c49-10a877ee4c02" :answer/id #uuid "1a53354f-87fd-55d1-9c49-10a877ee4c02"] [:db/add "1a53354f-87fd-55d1-9c49-10a877ee4c02" :answer/type :answer.type/math] [:db/add "1a53354f-87fd-55d1-9c49-10a877ee4c02" :answer/value "\\frac{\\pi}{18}"] [:db/ensure "1a53354f-87fd-55d1-9c49-10a877ee4c02" :answer/validate] [:db/add "46db9b26-4079-58a6-8520-d4be84b023b6" :answer/id #uuid "46db9b26-4079-58a6-8520-d4be84b023b6"] [:db/add "46db9b26-4079-58a6-8520-d4be84b023b6" :answer/type :answer.type/math] [:db/add "46db9b26-4079-58a6-8520-d4be84b023b6" :answer/value "\\frac{\\pi}{6}"] [:db/ensure "46db9b26-4079-58a6-8520-d4be84b023b6" :answer/validate] [:db/add "207da028-335e-5ee1-b670-4e3b934ee150" :answer/id #uuid "207da028-335e-5ee1-b670-4e3b934ee150"] [:db/add "207da028-335e-5ee1-b670-4e3b934ee150" :answer/type :answer.type/math] [:db/add "207da028-335e-5ee1-b670-4e3b934ee150" :answer/value "\\frac{\\pi}{6} + 2"] [:db/ensure "207da028-335e-5ee1-b670-4e3b934ee150" :answer/validate] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/id #uuid "49dabe65-8090-5777-85bf-39c17e7fc2d9"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/key "answer"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/type :answer-field.type/radio] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/choices "c719c30e-0869-555e-9ba0-3311b02ebe61"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/choices "808f5add-18d1-54ba-b00b-92a62a4de4c2"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/choices "1a53354f-87fd-55d1-9c49-10a877ee4c02"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/choices "46db9b26-4079-58a6-8520-d4be84b023b6"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/choices "207da028-335e-5ee1-b670-4e3b934ee150"] [:db/add "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/correct "46db9b26-4079-58a6-8520-d4be84b023b6"] [:db/ensure "49dabe65-8090-5777-85bf-39c17e7fc2d9" :answer-field/validate] [:db/add "e68f3ff6-c74a-5753-b1d6-5a3122891e65" :question/id #uuid "e68f3ff6-c74a-5753-b1d6-5a3122891e65"] [:db/add "e68f3ff6-c74a-5753-b1d6-5a3122891e65" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{1}{4}} \\frac{2}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "e68f3ff6-c74a-5753-b1d6-5a3122891e65" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{2}=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{1}{4}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{4}} \\frac{2}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\\\\&=\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}=\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{6}.\n$$"] [:db/add "e68f3ff6-c74a-5753-b1d6-5a3122891e65" :question/difficulty :question.difficulty/easy] [:db/add "e68f3ff6-c74a-5753-b1d6-5a3122891e65" :question/answer-fields "49dabe65-8090-5777-85bf-39c17e7fc2d9"] [:db/ensure "e68f3ff6-c74a-5753-b1d6-5a3122891e65" :question/validate] [:db/add 17592186064220 :knowledge-point/questions "e68f3ff6-c74a-5753-b1d6-5a3122891e65"] [:db/add "2d0c96de-b3a7-5494-94ac-ae1b11ca6a1a" :answer/id #uuid "2d0c96de-b3a7-5494-94ac-ae1b11ca6a1a"] [:db/add "2d0c96de-b3a7-5494-94ac-ae1b11ca6a1a" :answer/type :answer.type/math] [:db/add "2d0c96de-b3a7-5494-94ac-ae1b11ca6a1a" :answer/value "\\frac{3 \\pi}{8}"] [:db/ensure "2d0c96de-b3a7-5494-94ac-ae1b11ca6a1a" :answer/validate] [:db/add "212092dd-6c22-5022-a2e7-e842e8df157a" :answer/id #uuid "212092dd-6c22-5022-a2e7-e842e8df157a"] [:db/add "212092dd-6c22-5022-a2e7-e842e8df157a" :answer/type :answer.type/math] [:db/add "212092dd-