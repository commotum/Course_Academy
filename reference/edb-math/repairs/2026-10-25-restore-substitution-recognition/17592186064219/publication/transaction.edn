2db634db2"] [:db/ensure "cc72f537-c122-544b-8a2b-812589850c79" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "cc72f537-c122-544b-8a2b-812589850c79"] [:db/add "70a54b86-808d-5dd7-ae69-7155e3b64566" :answer/id #uuid "70a54b86-808d-5dd7-ae69-7155e3b64566"] [:db/add "70a54b86-808d-5dd7-ae69-7155e3b64566" :answer/type :answer.type/math] [:db/add "70a54b86-808d-5dd7-ae69-7155e3b64566" :answer/value "- \\frac{\\arctan{\\left(4 x \\right)}}{2}+C"] [:db/ensure "70a54b86-808d-5dd7-ae69-7155e3b64566" :answer/validate] [:db/add "f35300d1-b7c7-5723-a2e0-3682a5fa8ab3" :answer/id #uuid "f35300d1-b7c7-5723-a2e0-3682a5fa8ab3"] [:db/add "f35300d1-b7c7-5723-a2e0-3682a5fa8ab3" :answer/type :answer.type/math] [:db/add "f35300d1-b7c7-5723-a2e0-3682a5fa8ab3" :answer/value "\\frac{\\arctan{\\left(4 x + 1 \\right)}}{2}+C"] [:db/ensure "f35300d1-b7c7-5723-a2e0-3682a5fa8ab3" :answer/validate] [:db/add "544c8869-14ba-50d1-86af-b19a7ddb2af9" :answer/id #uuid "544c8869-14ba-50d1-86af-b19a7ddb2af9"] [:db/add "544c8869-14ba-50d1-86af-b19a7ddb2af9" :answer/type :answer.type/math] [:db/add "544c8869-14ba-50d1-86af-b19a7ddb2af9" :answer/value "\\frac{\\arctan{\\left(4 x \\right)}}{2}+C"] [:db/ensure "544c8869-14ba-50d1-86af-b19a7ddb2af9" :answer/validate] [:db/add "abdaad3e-f970-5f5c-aa5c-6277fea65631" :answer/id #uuid "abdaad3e-f970-5f5c-aa5c-6277fea65631"] [:db/add "abdaad3e-f970-5f5c-aa5c-6277fea65631" :answer/type :answer.type/math] [:db/add "abdaad3e-f970-5f5c-aa5c-6277fea65631" :answer/value "\\frac{\\arctan{\\left(2 x \\right)}}{2}+C"] [:db/ensure "abdaad3e-f970-5f5c-aa5c-6277fea65631" :answer/validate] [:db/add "0dee87a3-7427-58fe-aa1e-f209ddd8922a" :answer/id #uuid "0dee87a3-7427-58fe-aa1e-f209ddd8922a"] [:db/add "0dee87a3-7427-58fe-aa1e-f209ddd8922a" :answer/type :answer.type/math] [:db/add "0dee87a3-7427-58fe-aa1e-f209ddd8922a" :answer/value "\\frac{\\arctan{\\left(x \\right)}}{2}+C"] [:db/ensure "0dee87a3-7427-58fe-aa1e-f209ddd8922a" :answer/validate] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/id #uuid "d7f8e506-5298-5842-b026-078f06f54a47"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/key "answer"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/type :answer-field.type/radio] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/choices "70a54b86-808d-5dd7-ae69-7155e3b64566"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/choices "f35300d1-b7c7-5723-a2e0-3682a5fa8ab3"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/choices "544c8869-14ba-50d1-86af-b19a7ddb2af9"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/choices "abdaad3e-f970-5f5c-aa5c-6277fea65631"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/choices "0dee87a3-7427-58fe-aa1e-f209ddd8922a"] [:db/add "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/correct "544c8869-14ba-50d1-86af-b19a7ddb2af9"] [:db/ensure "d7f8e506-5298-5842-b026-078f06f54a47" :answer-field/validate] [:db/add "aef55a5e-03c2-55d6-819c-a0f6a24b86f7" :question/id #uuid "aef55a5e-03c2-55d6-819c-a0f6a24b86f7"] [:db/add "aef55a5e-03c2-55d6-819c-a0f6a24b86f7" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{16 x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "aef55a5e-03c2-55d6-819c-a0f6a24b86f7" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{4}=\\frac{1}{2}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{16 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{2}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{\\arctan{\\left(4 x \\right)}}{2}+C.\n$$"] [:db/add "aef55a5e-03c2-55d6-819c-a0f6a24b86f7" :question/difficulty :question.difficulty/easy] [:db/add "aef55a5e-03c2-55d6-819c-a0f6a24b86f7" :question/answer-fields "d7f8e506-5298-5842-b026-078f06f54a47"] [:db/ensure "aef55a5e-03c2-55d6-819c-a0f6a24b86f7" :question/validate] [:db/add 17592186064219 :knowledge-point/questions "aef55a5e-03c2-55d6-819c-a0f6a24b86f7"] [:db/add "cdfa1e1c-4f50-5dc7-b4c2-600caf900273" :answer/id #uuid "cdfa1e1c-4f50-5dc7-b4c2-600caf900273"] [:db/add "cdfa1e1c-4f50-5dc7-b4c2-600caf900273" :answer/type :answer.type/math] [:db/add "cdfa1e1c-4f50-5dc7-b4c2-600caf900273" :answer/value "\\arctan{\\left(2 x \\right)}+C"] [:db/ensure "cdfa1e1c-4f50-5dc7-b4c2-600caf900273" :answer/validate] [:db/add "e23fb74f-c099-5f37-b642-2aa7c7bdd301" :answer/id #uuid "e23fb74f-c099-5f37-b642-2aa7c7bdd301"] [:db/add "e23fb74f-c099-5f37-b642-2aa7c7bdd301" :answer/type :answer.type/math] [:db/add "e23fb74f-c099-5f37-b642-2aa7c7bdd301" :answer/value "6 \\arctan{\\left(2 x \\right)}+C"] [:db/ensure "e23fb74f-c099-5f37-b642-2aa7c7bdd301" :answer/validate] [:db/add "312ccf28-b017-5fa7-b739-7f88c72e6f0e" :answer/id #uuid "312ccf28-b017-5fa7-b739-7f88c72e6f0e"] [:db/add "312ccf28-b017-5fa7-b739-7f88c72e6f0e" :answer/type :answer.type/math] [:db/add "312ccf28-b017-5fa7-b739-7f88c72e6f0e" :answer/value "- 4 \\arctan{\\left(2 x \\right)}+C"] [:db/ensure "312ccf28-b017-5fa7-b739-7f88c72e6f0e" :answer/validate] [:db/add "ec1e9111-ad86-590f-ab59-eef21a687fa9" :answer/id #uuid "ec1e9111-ad86-590f-ab59-eef21a687fa9"] [:db/add "ec1e9111-ad86-590f-ab59-eef21a687fa9" :answer/type :answer.type/math] [:db/add "ec1e9111-ad86-590f-ab59-eef21a687fa9" :answer/value "2 \\arctan{\\left(2 x \\right)}+C"] [:db/ensure "ec1e9111-ad86-590f-ab59-eef21a687fa9" :answer/validate] [:db/add "d819fad0-12ea-5f46-8e79-1c44b3e86a41" :answer/id #uuid "d819fad0-12ea-5f46-8e79-1c44b3