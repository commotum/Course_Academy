  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/id #uuid \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\"] [:db/add \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/type :answer.type/math] [:db/add \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/value \"2 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/validate] [:db/add \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/id #uuid \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\"] [:db/add \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/type :answer.type/math] [:db/add \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/value \"\\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/validate] [:db/add \"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/id #uuid \"80ca6573-693f-5150-93d4-21ae62f1dbe9\"] [:db/add \"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/type :answer.type/math] [:db/add \"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/value \"- \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/validate] [:db/add \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/id #uuid \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\"] [:db/add \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/type :answer.type/math] [:db/add \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/value \"\\\\arctan{\\\\left(2 x + 1 \\\\right)}+C\"] [:db/ensure \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/validate] [:db/add \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/id #uuid \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\"] [:db/add \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/type :answer.type/math] [:db/add \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(2 x \\\\right)}}{3}+C\"] [:db/ensure \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/validate] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/id #uuid \"b267fd7b-5155-5760-90a6-5472db634db2\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/key \"answer\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/type :answer-field.type/radio] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"80ca6573-693f-5150-93d4-21ae62f1dbe9\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\"] [:db/add \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/correct \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\"] [:db/ensure \"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/validate] [:db/add \"cc72f537-c122-544b-8a2b-812589850c79\" :question/id #uuid \"cc72f537-c122-544b-8a2b-812589850c79\"] [:db/add \"cc72f537-c122-544b-8a2b-812589850c79\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"cc72f537-c122-544b-8a2b-812589850c79\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(2 x \\\\right)}+C.\\n$$\"] [:db/add \"cc72f537-c122-544b-8a2b-812589850c79\" :question/difficulty :question.difficulty/easy] [:db/add \"cc72f537-c122-544b-8a2b-812589850c79\" :question/answer-fields \"b267fd7b-5155-5760-90a6-5472db634db2\"] [:db/ensure \"cc72f537-c122-544b-8a2b-812589850c79\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"cc72f537-c122-544b-8a2b-812589850c79\"] [:db/add \"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/id #uuid \"70a54b86-808d-5dd7-ae69-7155e3b64566\"] [:db/add \"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/type :answer.type/math] [:db/add \"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/value \"- \\\\frac{\\\\arctan{\\\\left(4 x \\\\right)}}{2}+C\"] [:db/ensure \"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/validate] [:db/add \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/id #uuid \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\"] [:db/add \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/type :answer.type/math] [:db/add \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(4 x + 1 \\\\right)}}{2}+C\"] [:db/ensure \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/validate] [:db/add \"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/id #uuid \"544c8869-14ba-50d1-86af-b19a7ddb2af9\"] [:db/add \"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/type :answer.type/math] [:db/add \"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(4 x \\\\right)}}{2}+C\"] [:db/ensure \"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/validate] [:db/add \"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/id #uuid \"abdaad3e-f970-5f5c-aa5c-6277fea65631\"] [:db/add \"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/type :answer.type/math] [:db/add \"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(2 x \\\\right)}}{2}+C\"] [:db/ensure \"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/validate] [:db/add \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/id #uuid \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\"] [:db/add \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/type :answer.type/math] [:db/add \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(x \\\\right)}}{2}+C\"] [:db/ensure \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/validate] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/id #uuid \"d7f8e506-5298-5842-b026-078f06f54a47\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/key \"answer\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/type :answer-field.type/radio] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"70a54b86-808d-5dd7-ae69-7155e3b64566\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"544c8869-14ba-50d1-86af-b19a7ddb2af9\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"abdaad3e-f970-5f5c-aa5c-6277fea65631\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\"] [:db/add \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/correct \"544c8869-14ba-50d1-86af-b19a7ddb2af9\"] [:db/ensure \"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/validate] [:db/add \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/id #uuid \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\"] [:db/add \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\arctan{\\\\left(4 x \\\\right)}}{2}+C.\\n$$\"] [:db/add \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/difficulty :question.difficulty/easy] [:db/add \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/answer-fields \"d7f8e506-5298-5842-b026-078f06f54a47\"] [:db/ensure \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\"] [:db/add \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/id #uuid \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\"] [:db/add \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/type :answer.type/math] [:db/add \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/value \"\\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/validate] [:db/add \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/id #uuid \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\"] [:db/add \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/type :answer.type/math] [:db/add \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/value \"6 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/validate] [:db/add \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/id #uuid \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\"] [:db/add \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/type :answer.type/math] [:db/add \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/value \"- 4 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/validate] [:db/add \"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/id #uuid \"ec1e9111-ad86-590f-ab59-eef21a687fa9\"] [:db/add \"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/type :answer.type/math] [:db/add \"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/value \"2 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [:db/ensure \"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/validate] [:db/add \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/id #uuid \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\"] [:db/add \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/type :answer.type/math] [:db/add \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/value \"2 \\\\arctan{\\\\left(x \\\\right)}+C\"] [:db/ensure \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/validate] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/id #uuid \"5251532e-275d-5ec8-86b0-fc8e529c8895\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/key \"answer\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/type :answer-field.type/radio] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"ec1e9111-ad86-590f-ab59-eef21a687fa9\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\"] [:db/add \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/correct \"ec1e9111-ad86-590f-ab59-eef21a687fa9\"] [:db/ensure \"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/validate] [:db/add \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/id #uuid \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\"] [:db/add \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2 \\\\arctan{\\\\left(2 x \\\\right)}+C.\\n$$\"] [:db/add \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/difficulty :question.difficulty/easy] [:db/add \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/answer-fields \"5251532e-275d-5ec8-86b0-fc8e529c8895\"] [:db/ensure \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\"] [:db/add \"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/id #uuid \"0aa846a1-8098-56fa-b5b0-dba9688c489e\"] [:db/add \"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/type :answer.type/math] [:db/add \"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [:db/ensure \"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/validate] [:db/add \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/id #uuid \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\"] [:db/add \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/type :answer.type/math] [:db/add \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/value \"\\\\frac{2 \\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}}{3}+C\"] [:db/ensure \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/validate] [:db/add \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/id #uuid \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\"] [:db/add \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/type :answer.type/math] [:db/add \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/value \"\\\\frac{2 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [:db/ensure \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/validate] [:db/add \"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/id #uuid \"14e87b93-b675-557f-b53e-ddf6c52121b9\"] [:db/add \"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/type :answer.type/math] [:db/add \"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/value \"\\\\frac{2 \\\\arctan{\\\\left(6 x \\\\right)}}{3}+C\"] [:db/ensure \"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/validate] [:db/add \"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/id #uuid \"4567bd61-923e-5ed2-920f-169e04a043da\"] [:db/add \"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/type :answer.type/math] [:db/add \"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/value \"3 x+C\"] [:db/ensure \"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/validate] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/id #uuid \"2554c77f-6748-58e4-9b7b-a4e227f83aad\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/key \"answer\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/type :answer-field.type/radio] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"0aa846a1-8098-56fa-b5b0-dba9688c489e\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"14e87b93-b675-557f-b53e-ddf6c52121b9\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"4567bd61-923e-5ed2-920f-169e04a043da\"] [:db/add \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/correct \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\"] [:db/ensure \"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/validate] [:db/add \"47de0ac9-f092-5b81-9d83-313ace789357\" :question/id #uuid \"47de0ac9-f092-5b81-9d83-313ace789357\"] [:db/add \"47de0ac9-f092-5b81-9d83-313ace789357\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"47de0ac9-f092-5b81-9d83-313ace789357\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C.\\n$$\"] [:db/add \"47de0ac9-f092-5b81-9d83-313ace789357\" :question/difficulty :question.difficulty/easy] [:db/add \"47de0ac9-f092-5b81-9d83-313ace789357\" :question/answer-fields \"2554c77f-6748-58e4-9b7b-a4e227f83aad\"] [:db/ensure \"47de0ac9-f092-5b81-9d83-313ace789357\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"47de0ac9-f092-5b81-9d83-313ace789357\"] [:db/add \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/id #uuid \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\"] [:db/add \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/type :answer.type/math] [:db/add \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [:db/ensure \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/validate] [:db/add \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/id #uuid \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\"] [:db/add \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/type :answer.type/math] [:db/add \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/value \"\\\\frac{9 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [:db/ensure \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/validate] [:db/add \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/id #uuid \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\"] [:db/add \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/type :answer.type/math] [:db/add \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/value \"- \\\\frac{6 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [:db/ensure \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/validate] [:db/add \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/id #uuid \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\"] [:db/add \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/type :answer.type/math] [:db/add \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(5 x + 1 \\\\right)}}{5}+C\"] [:db/ensure \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/validate] [:db/add \"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/id #uuid \"67dacb6c-299b-55e3-b539-9567e5b5d12c\"] [:db/add \"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/type :answer.type/math] [:db/add \"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [:db/ensure \"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/validate] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/id #uuid \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/key \"answer\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/type :answer-field.type/radio] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"67dacb6c-299b-55e3-b539-9567e5b5d12c\"] [:db/add \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/correct \"67dacb6c-299b-55e3-b539-9567e5b5d12c\"] [:db/ensure \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/validate] [:db/add \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/id #uuid \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\"] [:db/add \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C.\\n$$\"] [:db/add \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/difficulty :question.difficulty/easy] [:db/add \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/answer-fields \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\"] [:db/ensure \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\"] [:db/add \"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/id #uuid \"c65aa482-4267-5e3c-963e-ec56cba4db9d\"] [:db/add \"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/type :answer.type/math] [:db/add \"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/value \"3 x+C\"] [:db/ensure \"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/validate] [:db/add \"1089106d-88e0-5948-b280-89e737be3c49\" :answer/id #uuid \"1089106d-88e0-5948-b280-89e737be3c49\"] [:db/add \"1089106d-88e0-5948-b280-89e737be3c49\" :answer/type :answer.type/math] [:db/add \"1089106d-88e0-5948-b280-89e737be3c49\" :answer/value \"\\\\frac{4 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [:db/ensure \"1089106d-88e0-5948-b280-89e737be3c49\" :answer/validate] [:db/add \"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/id #uuid \"806c738f-772b-5716-b7e9-e18d1a93758f\"] [:db/add \"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/type :answer.type/math] [:db/add \"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/value \"\\\\frac{4 \\\\arctan{\\\\left(3 x + 1 \\\\right)}}{3}+C\"] [:db/ensure \"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/validate] [:db/add \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/id #uuid \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\"] [:db/add \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/type :answer.type/math] [:db/add \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/value \"- \\\\frac{8 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [:db/ensure \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/validate] [:db/add \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/id #uuid \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\"] [:db/add \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/type :answer.type/math] [:db/add \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/value \"4 \\\\arctan{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/validate] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/id #uuid \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/key \"answer\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/type :answer-field.type/radio] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"c65aa482-4267-5e3c-963e-ec56cba4db9d\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"1089106d-88e0-5948-b280-89e737be3c49\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"806c738f-772b-5716-b7e9-e18d1a93758f\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\"] [:db/add \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/correct \"1089106d-88e0-5948-b280-89e737be3c49\"] [:db/ensure \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/validate] [:db/add \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/id #uuid \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\"] [:db/add \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C.\\n$$\"] [:db/add \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/difficulty :question.difficulty/easy] [:db/add \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/answer-fields \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\"] [:db/ensure \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\"] [:db/add \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/id #uuid \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\"] [:db/add \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/type :answer.type/math] [:db/add \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\"] [:db/ensure \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/validate] [:db/add \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/id #uuid \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\"] [:db/add \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/type :answer.type/math] [:db/add \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\"] [:db/ensure \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/validate] [:db/add \"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/id #uuid \"e1c56253-56b9-585e-80fc-d648983bc69c\"] [:db/add \"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/type :answer.type/math] [:db/add \"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/value \"- \\\\arctan{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/validate] [:db/add \"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/id #uuid \"b168866f-4afd-542b-8238-cb31e18e7136\"] [:db/add \"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/type :answer.type/math] [:db/add \"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/value \"\\\\arctan{\\\\left(3 x \\\\right)}+C\"] [:db/ensure \"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/validate] [:db/add \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/id #uuid \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\"] [:db/add \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/type :answer.type/math] [:db/add \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/value \"3 x+C\"] [:db/ensure \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/validate] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/id #uuid \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/key \"answer\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/type :answer-field.type/radio] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"e1c56253-56b9-585e-80fc-d648983bc69c\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"b168866f-4afd-542b-8238-cb31e18e7136\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\"] [:db/add \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/correct \"b168866f-4afd-542b-8238-cb31e18e7136\"] [:db/ensure \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/validate] [:db/add \"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/id #uuid \"c943f831-82d8-5e03-9026-017ad0972fcb\"] [:db/add \"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(3 x \\\\right)}+C.\\n$$\"] [:db/add \"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/difficulty :question.difficulty/easy] [:db/add \"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/answer-fields \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\"] [:db/ensure \"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"c943f831-82d8-5e03-9026-017ad0972fcb\"] [:db/add \"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/id #uuid \"b04b8539-93d3-53c1-959d-715ad05fcecc\"] [:db/add \"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/type :answer.type/math] [:db/add \"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{4}+C\"] [:db/ensure \"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/validate] [:db/add \"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/id #uuid \"060e2d2e-3bda-5860-84a1-706e1eff8994\"] [:db/add \"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/type :answer.type/math] [:db/add \"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/value \"4 x+C\"] [:db/ensure \"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/validate] [:db/add \"a991277b-585f-5749-9b00-57fca990b369\" :answer/id #uuid \"a991277b-585f-5749-9b00-57fca990b369\"] [:db/add \"a991277b-585f-5749-9b00-57fca990b369\" :answer/type :answer.type/math] [:db/add \"a991277b-585f-5749-9b00-57fca990b369\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{8}+C\"] [:db/ensure \"a991277b-585f-5749-9b00-57fca990b369\" :answer/validate] [:db/add \"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/id #uuid \"1bd7ad10-5580-565d-b143-6fc51712688f\"] [:db/add \"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/type :answer.type/math] [:db/add \"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{2}+C\"] [:db/ensure \"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/validate] [:db/add \"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/id #uuid \"29c9fe78-1780-5364-92ff-22b73fe46da1\"] [:db/add \"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/type :answer.type/math] [:db/add \"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(x \\\\right)}}{4}+C\"] [:db/ensure \"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/validate] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/id #uuid \"ec8c7cab-9e72-529f-80b4-154f7be3e053\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/key \"answer\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/type :answer-field.type/radio] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"b04b8539-93d3-53c1-959d-715ad05fcecc\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"060e2d2e-3bda-5860-84a1-706e1eff8994\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"a991277b-585f-5749-9b00-57fca990b369\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"1bd7ad10-5580-565d-b143-6fc51712688f\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"29c9fe78-1780-5364-92ff-22b73fe46da1\"] [:db/add \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/correct \"b04b8539-93d3-53c1-959d-715ad05fcecc\"] [:db/ensure \"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/validate] [:db/add \"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/id #uuid \"67db3791-c5e5-531b-a6ec-eecedc347ed2\"] [:db/add \"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{4}+C.\\n$$\"] [:db/add \"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/difficulty :question.difficulty/easy] [:db/add \"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/answer-fields \"ec8c7cab-9e72-529f-80b4-154f7be3e053\"] [:db/ensure \"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/validate] [:db/add 17592186064219 :knowledge-point/questions \"67db3791-c5e5-531b-a6ec-eecedc347ed2\"] [:db/add \"generator\" :question-generator/id #uuid \"db292685-492c-577a-a81a-e28054437854\"] [:db/add \"generator\" :question-generator/script \"generators/e7/e7ec9a4376033301e7fc3bf5e04dfb06f0c0a280a6d353170d03a3339441ced4/generator.py\"] [:db/add 17592186064219 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186064219 :knowledge-point/validate]] \"assertions\" [[\"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/id #uuid \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\"] [\"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/type :answer.type/math] [\"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\" :answer/value \"2 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/id #uuid \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\"] [\"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/type :answer.type/math] [\"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\" :answer/value \"\\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/id #uuid \"80ca6573-693f-5150-93d4-21ae62f1dbe9\"] [\"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/type :answer.type/math] [\"80ca6573-693f-5150-93d4-21ae62f1dbe9\" :answer/value \"- \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/id #uuid \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\"] [\"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/type :answer.type/math] [\"74e8b926-d023-5ce5-ad8c-9c522abefd1b\" :answer/value \"\\\\arctan{\\\\left(2 x + 1 \\\\right)}+C\"] [\"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/id #uuid \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\"] [\"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/type :answer.type/math] [\"15fc4436-d3ea-5aea-b60b-0d1be3bef914\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(2 x \\\\right)}}{3}+C\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/id #uuid \"b267fd7b-5155-5760-90a6-5472db634db2\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/key \"answer\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/type :answer-field.type/radio] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"a1a2c5f1-e0ff-5a56-ab86-dc91508ac718\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"80ca6573-693f-5150-93d4-21ae62f1dbe9\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"74e8b926-d023-5ce5-ad8c-9c522abefd1b\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/choices \"15fc4436-d3ea-5aea-b60b-0d1be3bef914\"] [\"b267fd7b-5155-5760-90a6-5472db634db2\" :answer-field/correct \"c356f6d7-e578-5898-8bcf-4fdcc7d092b6\"] [\"cc72f537-c122-544b-8a2b-812589850c79\" :question/id #uuid \"cc72f537-c122-544b-8a2b-812589850c79\"] [\"cc72f537-c122-544b-8a2b-812589850c79\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"cc72f537-c122-544b-8a2b-812589850c79\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{2}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(2 x \\\\right)}+C.\\n$$\"] [\"cc72f537-c122-544b-8a2b-812589850c79\" :question/difficulty :question.difficulty/easy] [\"cc72f537-c122-544b-8a2b-812589850c79\" :question/answer-fields \"b267fd7b-5155-5760-90a6-5472db634db2\"] [17592186064219 :knowledge-point/questions \"cc72f537-c122-544b-8a2b-812589850c79\"] [\"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/id #uuid \"70a54b86-808d-5dd7-ae69-7155e3b64566\"] [\"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/type :answer.type/math] [\"70a54b86-808d-5dd7-ae69-7155e3b64566\" :answer/value \"- \\\\frac{\\\\arctan{\\\\left(4 x \\\\right)}}{2}+C\"] [\"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/id #uuid \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\"] [\"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/type :answer.type/math] [\"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(4 x + 1 \\\\right)}}{2}+C\"] [\"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/id #uuid \"544c8869-14ba-50d1-86af-b19a7ddb2af9\"] [\"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/type :answer.type/math] [\"544c8869-14ba-50d1-86af-b19a7ddb2af9\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(4 x \\\\right)}}{2}+C\"] [\"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/id #uuid \"abdaad3e-f970-5f5c-aa5c-6277fea65631\"] [\"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/type :answer.type/math] [\"abdaad3e-f970-5f5c-aa5c-6277fea65631\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(2 x \\\\right)}}{2}+C\"] [\"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/id #uuid \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\"] [\"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/type :answer.type/math] [\"0dee87a3-7427-58fe-aa1e-f209ddd8922a\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(x \\\\right)}}{2}+C\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/id #uuid \"d7f8e506-5298-5842-b026-078f06f54a47\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/key \"answer\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/type :answer-field.type/radio] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"70a54b86-808d-5dd7-ae69-7155e3b64566\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"f35300d1-b7c7-5723-a2e0-3682a5fa8ab3\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"544c8869-14ba-50d1-86af-b19a7ddb2af9\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"abdaad3e-f970-5f5c-aa5c-6277fea65631\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/choices \"0dee87a3-7427-58fe-aa1e-f209ddd8922a\"] [\"d7f8e506-5298-5842-b026-078f06f54a47\" :answer-field/correct \"544c8869-14ba-50d1-86af-b19a7ddb2af9\"] [\"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/id #uuid \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\"] [\"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{4}=\\\\frac{1}{2}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\arctan{\\\\left(4 x \\\\right)}}{2}+C.\\n$$\"] [\"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/difficulty :question.difficulty/easy] [\"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\" :question/answer-fields \"d7f8e506-5298-5842-b026-078f06f54a47\"] [17592186064219 :knowledge-point/questions \"aef55a5e-03c2-55d6-819c-a0f6a24b86f7\"] [\"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/id #uuid \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\"] [\"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/type :answer.type/math] [\"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\" :answer/value \"\\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/id #uuid \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\"] [\"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/type :answer.type/math] [\"e23fb74f-c099-5f37-b642-2aa7c7bdd301\" :answer/value \"6 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/id #uuid \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\"] [\"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/type :answer.type/math] [\"312ccf28-b017-5fa7-b739-7f88c72e6f0e\" :answer/value \"- 4 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/id #uuid \"ec1e9111-ad86-590f-ab59-eef21a687fa9\"] [\"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/type :answer.type/math] [\"ec1e9111-ad86-590f-ab59-eef21a687fa9\" :answer/value \"2 \\\\arctan{\\\\left(2 x \\\\right)}+C\"] [\"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/id #uuid \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\"] [\"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/type :answer.type/math] [\"d819fad0-12ea-5f46-8e79-1c44b3e86a41\" :answer/value \"2 \\\\arctan{\\\\left(x \\\\right)}+C\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/id #uuid \"5251532e-275d-5ec8-86b0-fc8e529c8895\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/key \"answer\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/type :answer-field.type/radio] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"cdfa1e1c-4f50-5dc7-b4c2-600caf900273\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"e23fb74f-c099-5f37-b642-2aa7c7bdd301\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"312ccf28-b017-5fa7-b739-7f88c72e6f0e\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"ec1e9111-ad86-590f-ab59-eef21a687fa9\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/choices \"d819fad0-12ea-5f46-8e79-1c44b3e86a41\"] [\"5251532e-275d-5ec8-86b0-fc8e529c8895\" :answer-field/correct \"ec1e9111-ad86-590f-ab59-eef21a687fa9\"] [\"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/id #uuid \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\"] [\"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{2}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{2}=2$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{4 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2 \\\\arctan{\\\\left(2 x \\\\right)}+C.\\n$$\"] [\"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/difficulty :question.difficulty/easy] [\"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\" :question/answer-fields \"5251532e-275d-5ec8-86b0-fc8e529c8895\"] [17592186064219 :knowledge-point/questions \"f5e4d6fa-219e-5e15-8eee-4bf63bc6ff6a\"] [\"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/id #uuid \"0aa846a1-8098-56fa-b5b0-dba9688c489e\"] [\"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/type :answer.type/math] [\"0aa846a1-8098-56fa-b5b0-dba9688c489e\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [\"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/id #uuid \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\"] [\"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/type :answer.type/math] [\"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\" :answer/value \"\\\\frac{2 \\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}}{3}+C\"] [\"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/id #uuid \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\"] [\"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/type :answer.type/math] [\"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\" :answer/value \"\\\\frac{2 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [\"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/id #uuid \"14e87b93-b675-557f-b53e-ddf6c52121b9\"] [\"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/type :answer.type/math] [\"14e87b93-b675-557f-b53e-ddf6c52121b9\" :answer/value \"\\\\frac{2 \\\\arctan{\\\\left(6 x \\\\right)}}{3}+C\"] [\"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/id #uuid \"4567bd61-923e-5ed2-920f-169e04a043da\"] [\"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/type :answer.type/math] [\"4567bd61-923e-5ed2-920f-169e04a043da\" :answer/value \"3 x+C\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/id #uuid \"2554c77f-6748-58e4-9b7b-a4e227f83aad\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/key \"answer\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/type :answer-field.type/radio] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"0aa846a1-8098-56fa-b5b0-dba9688c489e\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"1751a7e2-e9cd-5eac-84ad-6937d220e4b8\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"14e87b93-b675-557f-b53e-ddf6c52121b9\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/choices \"4567bd61-923e-5ed2-920f-169e04a043da\"] [\"2554c77f-6748-58e4-9b7b-a4e227f83aad\" :answer-field/correct \"d122ef8a-bd0a-5fc7-8a56-a49ba492380f\"] [\"47de0ac9-f092-5b81-9d83-313ace789357\" :question/id #uuid \"47de0ac9-f092-5b81-9d83-313ace789357\"] [\"47de0ac9-f092-5b81-9d83-313ace789357\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"47de0ac9-f092-5b81-9d83-313ace789357\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $2\\\\cdot \\\\frac{1}{3}=\\\\frac{2}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C.\\n$$\"] [\"47de0ac9-f092-5b81-9d83-313ace789357\" :question/difficulty :question.difficulty/easy] [\"47de0ac9-f092-5b81-9d83-313ace789357\" :question/answer-fields \"2554c77f-6748-58e4-9b7b-a4e227f83aad\"] [17592186064219 :knowledge-point/questions \"47de0ac9-f092-5b81-9d83-313ace789357\"] [\"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/id #uuid \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\"] [\"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/type :answer.type/math] [\"a2f9e65d-6d56-5409-b49d-05a36a1367b8\" :answer/value \"\\\\frac{\\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [\"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/id #uuid \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\"] [\"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/type :answer.type/math] [\"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\" :answer/value \"\\\\frac{9 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [\"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/id #uuid \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\"] [\"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/type :answer.type/math] [\"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\" :answer/value \"- \\\\frac{6 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [\"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/id #uuid \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\"] [\"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/type :answer.type/math] [\"90e30ab7-6c90-514b-85ee-9a6bde0b404b\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(5 x + 1 \\\\right)}}{5}+C\"] [\"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/id #uuid \"67dacb6c-299b-55e3-b539-9567e5b5d12c\"] [\"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/type :answer.type/math] [\"67dacb6c-299b-55e3-b539-9567e5b5d12c\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/id #uuid \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/key \"answer\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/type :answer-field.type/radio] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"a2f9e65d-6d56-5409-b49d-05a36a1367b8\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"519275dd-ca3f-530d-b7cf-ad7dfe50ab37\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"ec934ae7-4a05-50c1-b205-9e6bf36c2b60\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"90e30ab7-6c90-514b-85ee-9a6bde0b404b\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/choices \"67dacb6c-299b-55e3-b539-9567e5b5d12c\"] [\"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\" :answer-field/correct \"67dacb6c-299b-55e3-b539-9567e5b5d12c\"] [\"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/id #uuid \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\"] [\"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/worked-solution \"Let $u=5 x$. Then $\\\\mathrm{d}u=(5)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{5}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{5}=\\\\frac{3}{5}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{25 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{5}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{5}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\arctan{\\\\left(5 x \\\\right)}}{5}+C.\\n$$\"] [\"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/difficulty :question.difficulty/easy] [\"c63e701c-6695-5b9a-b2af-b1c88c6d680b\" :question/answer-fields \"ac5119a7-cdce-523c-b1a5-cc109d9a7a2a\"] [17592186064219 :knowledge-point/questions \"c63e701c-6695-5b9a-b2af-b1c88c6d680b\"] [\"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/id #uuid \"c65aa482-4267-5e3c-963e-ec56cba4db9d\"] [\"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/type :answer.type/math] [\"c65aa482-4267-5e3c-963e-ec56cba4db9d\" :answer/value \"3 x+C\"] [\"1089106d-88e0-5948-b280-89e737be3c49\" :answer/id #uuid \"1089106d-88e0-5948-b280-89e737be3c49\"] [\"1089106d-88e0-5948-b280-89e737be3c49\" :answer/type :answer.type/math] [\"1089106d-88e0-5948-b280-89e737be3c49\" :answer/value \"\\\\frac{4 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [\"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/id #uuid \"806c738f-772b-5716-b7e9-e18d1a93758f\"] [\"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/type :answer.type/math] [\"806c738f-772b-5716-b7e9-e18d1a93758f\" :answer/value \"\\\\frac{4 \\\\arctan{\\\\left(3 x + 1 \\\\right)}}{3}+C\"] [\"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/id #uuid \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\"] [\"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/type :answer.type/math] [\"ab660229-f3a7-5d96-bcd9-d0049a4e4416\" :answer/value \"- \\\\frac{8 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C\"] [\"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/id #uuid \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\"] [\"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/type :answer.type/math] [\"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\" :answer/value \"4 \\\\arctan{\\\\left(3 x \\\\right)}+C\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/id #uuid \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/key \"answer\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/type :answer-field.type/radio] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"c65aa482-4267-5e3c-963e-ec56cba4db9d\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"1089106d-88e0-5948-b280-89e737be3c49\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"806c738f-772b-5716-b7e9-e18d1a93758f\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"ab660229-f3a7-5d96-bcd9-d0049a4e4416\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/choices \"3b9e53f9-e6c5-57eb-8ad0-0e473f89fe33\"] [\"1623eb08-9f4f-567f-b046-2686e8cb9eaa\" :answer-field/correct \"1089106d-88e0-5948-b280-89e737be3c49\"] [\"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/id #uuid \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\"] [\"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $4\\\\cdot \\\\frac{1}{3}=\\\\frac{4}{3}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{4}{3}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{3}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4 \\\\arctan{\\\\left(3 x \\\\right)}}{3}+C.\\n$$\"] [\"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/difficulty :question.difficulty/easy] [\"db04ce03-1959-5d7d-91b0-8b560a6f6b99\" :question/answer-fields \"1623eb08-9f4f-567f-b046-2686e8cb9eaa\"] [17592186064219 :knowledge-point/questions \"db04ce03-1959-5d7d-91b0-8b560a6f6b99\"] [\"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/id #uuid \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\"] [\"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/type :answer.type/math] [\"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\" :answer/value \"\\\\arctan{\\\\left(\\\\frac{3 x}{2} \\\\right)}+C\"] [\"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/id #uuid \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\"] [\"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/type :answer.type/math] [\"b5ff2804-50ca-593f-9404-ccbd9ae20fde\" :answer/value \"\\\\arctan{\\\\left(x \\\\right)}+C\"] [\"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/id #uuid \"e1c56253-56b9-585e-80fc-d648983bc69c\"] [\"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/type :answer.type/math] [\"e1c56253-56b9-585e-80fc-d648983bc69c\" :answer/value \"- \\\\arctan{\\\\left(3 x \\\\right)}+C\"] [\"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/id #uuid \"b168866f-4afd-542b-8238-cb31e18e7136\"] [\"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/type :answer.type/math] [\"b168866f-4afd-542b-8238-cb31e18e7136\" :answer/value \"\\\\arctan{\\\\left(3 x \\\\right)}+C\"] [\"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/id #uuid \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\"] [\"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/type :answer.type/math] [\"3497efb1-6841-5627-b4ac-8320e3ca0d5c\" :answer/value \"3 x+C\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/id #uuid \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/key \"answer\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/type :answer-field.type/radio] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"35121cc6-93bf-54d8-b9e4-d2e6b2a9ead7\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"b5ff2804-50ca-593f-9404-ccbd9ae20fde\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"e1c56253-56b9-585e-80fc-d648983bc69c\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"b168866f-4afd-542b-8238-cb31e18e7136\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/choices \"3497efb1-6841-5627-b4ac-8320e3ca0d5c\"] [\"ff7bdb7e-46af-5351-a6b6-861a4364ef15\" :answer-field/correct \"b168866f-4afd-542b-8238-cb31e18e7136\"] [\"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/id #uuid \"c943f831-82d8-5e03-9026-017ad0972fcb\"] [\"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/worked-solution \"Let $u=3 x$. Then $\\\\mathrm{d}u=(3)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{3}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{3}=1$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{9 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\arctan{\\\\left(3 x \\\\right)}+C.\\n$$\"] [\"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/difficulty :question.difficulty/easy] [\"c943f831-82d8-5e03-9026-017ad0972fcb\" :question/answer-fields \"ff7bdb7e-46af-5351-a6b6-861a4364ef15\"] [17592186064219 :knowledge-point/questions \"c943f831-82d8-5e03-9026-017ad0972fcb\"] [\"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/id #uuid \"b04b8539-93d3-53c1-959d-715ad05fcecc\"] [\"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/type :answer.type/math] [\"b04b8539-93d3-53c1-959d-715ad05fcecc\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{4}+C\"] [\"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/id #uuid \"060e2d2e-3bda-5860-84a1-706e1eff8994\"] [\"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/type :answer.type/math] [\"060e2d2e-3bda-5860-84a1-706e1eff8994\" :answer/value \"4 x+C\"] [\"a991277b-585f-5749-9b00-57fca990b369\" :answer/id #uuid \"a991277b-585f-5749-9b00-57fca990b369\"] [\"a991277b-585f-5749-9b00-57fca990b369\" :answer/type :answer.type/math] [\"a991277b-585f-5749-9b00-57fca990b369\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{8}+C\"] [\"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/id #uuid \"1bd7ad10-5580-565d-b143-6fc51712688f\"] [\"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/type :answer.type/math] [\"1bd7ad10-5580-565d-b143-6fc51712688f\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{2}+C\"] [\"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/id #uuid \"29c9fe78-1780-5364-92ff-22b73fe46da1\"] [\"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/type :answer.type/math] [\"29c9fe78-1780-5364-92ff-22b73fe46da1\" :answer/value \"\\\\frac{3 \\\\arctan{\\\\left(x \\\\right)}}{4}+C\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/id #uuid \"ec8c7cab-9e72-529f-80b4-154f7be3e053\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/key \"answer\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/type :answer-field.type/radio] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"b04b8539-93d3-53c1-959d-715ad05fcecc\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"060e2d2e-3bda-5860-84a1-706e1eff8994\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"a991277b-585f-5749-9b00-57fca990b369\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"1bd7ad10-5580-565d-b143-6fc51712688f\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/choices \"29c9fe78-1780-5364-92ff-22b73fe46da1\"] [\"ec8c7cab-9e72-529f-80b4-154f7be3e053\" :answer-field/correct \"b04b8539-93d3-53c1-959d-715ad05fcecc\"] [\"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/id #uuid \"67db3791-c5e5-531b-a6ec-eecedc347ed2\"] [\"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/worked-solution \"Let $u=4 x$. Then $\\\\mathrm{d}u=(4)\\\\,\\\\mathrm{d}x$.\\n\\nThe differential is $\\\\mathrm{d}x=\\\\frac{1}{4}\\\\,\\\\mathrm{d}u$. The outside factor is $3\\\\cdot \\\\frac{1}{4}=\\\\frac{3}{4}$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3}{16 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u=\\\\arctan{\\\\left(u \\\\right)}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{4}\\\\left(\\\\int \\\\frac{1}{u^{2} + 1}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{4}\\\\left(\\\\arctan{\\\\left(u \\\\right)}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\arctan{\\\\left(4 x \\\\right)}}{4}+C.\\n$$\"] [\"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/difficulty :question.difficulty/easy] [\"67db3791-c5e5-531b-a6ec-eecedc347ed2\" :question/answer-fields \"ec8c7cab-9e72-529f-80b4-154f7be3e053\"] [17592186064219 :knowledge-point/questions \"67db3791-c5e5-531b-a6ec-eecedc347ed2\"] [\"generator\" :question-generator/id #uuid \"db292685-492c-577a-a81a-e28054437854\"] [\"generator\" :question-generator/script \"generators/e7/e7ec9a4376033301e7fc3bf5e04dfb06f0c0a280a6d353170d03a3339441ced4/generator.py\"] [17592186064219 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186064219 :knowledge-point/question-generator 17592186682895]]}",
