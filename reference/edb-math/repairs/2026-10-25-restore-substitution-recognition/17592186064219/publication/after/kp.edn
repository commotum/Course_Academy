ar substitution $u=\\frac{x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{3},\\qquad \\mathrm{d}x=(3)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{9}{x^{2} + 9}\\,\\mathrm{d}x \\\\  &= 1\\int \\frac{1}{1+(\\frac{x}{3})^{2}}\\,\\mathrm{d}x \\\\  &= 1(3)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= 3\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= 3 \\operatorname{arctan}{\\left(u \\right)}+C \\\\  &= 3 \\operatorname{arctan}{\\left(\\frac{x}{3} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0769c362-ae23-56e8-9ec9-7f91d8e28adc" :answer/type {:db/ident :answer.type/math} :answer/value "9 \\operatorname{arctan}{\\left(2 x \\right)}+C" :db/id #edb/ref 17592186676709} {:answer/id #uuid "13abb57a-6a30-51a9-9be4-207da1cf738a" :answer/type {:db/ident :answer.type/math} :answer/value "18 \\operatorname{arctan}{\\left(2 x \\right)}+C" :db/id #edb/ref 17592186676720} {:answer/id #uuid "6b7824b8-9a8c-5756-8476-bbac3d10265a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arctan}{\\left(2 x \\right)}}{2}+C" :db/id #edb/ref 17592186676774} {:answer/id #uuid "9dfd40ca-3b2f-5fe7-b919-2cb4abfd52b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arctan}{\\left(x \\right)}}{2}+C" :db/id #edb/ref 17592186676803} {:answer/id #uuid "c41c9187-28fb-5a68-bc11-1ac2507b3cf1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arcsin}{\\left(2 x \\right)}}{2}+C" :db/id #edb/ref 17592186676829}] :answer-field/correct {:answer/id #uuid "6b7824b8-9a8c-5756-8476-bbac3d10265a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9 \\operatorname{arctan}{\\left(2 x \\right)}}{2}+C" :db/id #edb/ref 17592