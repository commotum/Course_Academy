nt \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{7 \\sqrt{5}}{25}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{7 \\sqrt{5} \\operatorname{arctan}{\\left(u \\right)}}{25}+C \\\\  &= \\frac{7 \\sqrt{5} \\operatorname{arctan}{\\left(\\frac{\\sqrt{5} x}{5} \\right)}}{25}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676764 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17780bed-4359-5126-81c4-a87852eeacd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{8}+C" :db/id #edb/ref 17592186676723} {:answer/id #uuid "55bbad3c-c50c-5e9a-8517-a624d325a0b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(x \\right)}}{8}+C" :db/id #edb/ref 17592186676762} {:answer/id #uuid "af1b5b20-413d-532c-a91f-7a7a59b90f40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{64}+C" :db/id #edb/ref 17592186676813} {:answer/id #uuid "c206a918-46b3-5b97-8ec2-e04b6ffd1b0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{x}{8} \\right)}}{8}+C" :db/id #edb/ref 17592186676828} {:answer/id #uuid "ed8ae318-a787-513f-8541-f627576c0f50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{512}+C" :db/id #edb/ref 17592186676861}] :answer-field/correct {:answer/id #uuid "17780bed-4359-5126-81c4-a87852eeacd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{8}+C" :db/id #edb/ref 17592186676723} :answer-field/id #uuid "bede5953-de93-55e7-9413-a0c2afad3313" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676824}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5a03e52f-a789-58b8-8cc0-a47e970671ff" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{x^{2} + 64}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 64=64(1+(\\frac{1}{64})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{8}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{8},\\qquad \\mathrm{d}x=(8)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{x^{2} + 64}\\,\\mathrm{d}x \\\\  &= \\frac{1}{64}\\int \\frac{1}{1+(\\frac{x}{8})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{64}(8)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{8}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arctan}{\\left(u \\right)}}{8}+C \\\\  &= \\frac{\\operatorname{arctan}{\\left(\\frac{x}{8} \\right)}}{8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676784 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e8e958b-c343-5170-816b-4e648ead370c" :answer/type {:db/ident :answer.type/math} :answer/value "16 \\operatorname{arctan}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676739} {:answer/id #uuid "3f7c3f4c-d1c9-5343-98d1-9dc76c21ae47" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\operatorname{arctan}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676751} {:answer/id #uuid "64f43cea-82e3-5cf1-9cbf-43842411bb39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(x \\right)}}{4}+C" :db/id #edb/ref 17592186676770} {:answer/id #uuid "70e02059-973f-581c-a1d3-bc66b391d5bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(8 x \\right)}}{4}+C" :db/id #edb/ref 17592186676781} {:answer/id #uuid "9c524791-e707-5343-b791-1b1e03c75f52" :answer/type {:db/ident :answer.type/math} :answer/val