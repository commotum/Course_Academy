+(\\frac{x}{7})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{7}(7)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arctan}{\\left(u \\right)}+C \\\\  &= \\operatorname{arctan}{\\left(\\frac{x}{7} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38104d99-89dc-5c65-91da-a38ea89cecd5" :answer/type {:db/ident :answer.type/math} :answer/value "20 \\operatorname{arctan}{\\left(5 x \\right)}+C" :db/id #edb/ref 17592186676747} {:answer/id #uuid "4dbf7579-c4a6-5e84-b316-e43a2c06c6d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arcsin}{\\left(5 x \\right)}}{5}+C" :db/id #edb/ref 17592186676757} {:answer/id #uuid "c066d068-8f0f-5b8f-9079-684135eeaaa4" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\operatorname{arctan}{\\left(5 x \\right)}+C" :db/id #edb/ref 17592186676827} {:answer/id #uuid "ccab861f-97b1-5360-bb18-335589f6b68d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(x \\right)}}{5}+C" :db/id #edb/ref 17592186676835} {:answer/id #uuid "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(5 x \\right)}}{5}+C" :db/id #edb/ref 17592186676841}] :answer-field/correct {:answer/id #uuid "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(5 x \\right)}}{5}+C" :db/id #edb/ref 17592186676841} :answer-field/id #uuid "b0d76d60-375d-5a12-b771-5d768e620be3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676817}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "ef7b058e-fc6a-5813-9eb1-d41bf53d2867" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{4}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=5,\\qquad \\mathrm{d}x=(\\frac{1}{5})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{25 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 4\\int \\frac{1}{1+(5 x)^{2}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{1}{5})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{5}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\operatorname{arctan}{\\left(u \\right)}}{5}+C \\\\  &= \\frac{4 \\operatorname{arctan}{\\left(5 x \\right)}}{5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1354a5c6-4986-51a0-a180-095d77f61a88" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(x \\right)}}{7}+C" :db/id #edb/ref 17592186676718} {:answer/id #uuid "522f0b49-36d3-5564-8587-88f69e0b4972" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arcsin}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676760} {:answer/id #uuid "6e79f9b7-9587-51cb-9715-6d0667bfbe94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676780} {:answer/id #uuid "73505e5a-61de-522f-98f5-f372a4aff84d" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}+C" :db/id #edb/ref 17592186676782} {:answer/id #uuid "87246861-a0f8-5866-8f47-f2e094fd4e05" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}+C" :db/id #edb/ref 17592186676793}] :answer-field/correct {:answer/id #uuid "6e79f9b7-9587-51cb-9715-6d0667bfbe94" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676780} :answer-field/id #uuid "6c913ac6-a686-52ea-8fea-4ea5396bf730" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676777}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f49dc8f2-18d9-5ea1-864b-63e28786f067" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{4}{7 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=\\sqrt{7} x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\sqrt{7},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{7 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 4\\int \\frac{1}{1+(\\sqrt{7} x)^{2}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{\\sqrt{7}}{7})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{7}}{7}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}}{7}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ad1890-2cae-51ec-85ca-7aff39f86cd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{2}+C" :db/id #edb/ref 17592186676711} {:answer/id #uuid "3fb86f00-a7d3-5e1c-ab6a-eef0c1e19200" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{4}+C" :db/id #edb/ref 17592186676752} {:answer/id #uuid "9c11befe-819f-5bde-9b9b-0a8eae816193" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}{\\left(2 x \\right)}+C" :db/id #edb/ref 17592186676801} {:answer/id #uuid "cbbee414-a342-56e0-8aec-8562cf05d4ef" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}{\\left(2 x \\right)}}{4}+C" :db/id #edb/ref 17592186676834} {:answer/id #uuid "e809e901-278c-58b4-87b5-87d3488d051b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(x \\right)}}{4}+C" :db/id #edb/ref 17592186676856}] :answer-field/correct {:answer/id #uuid "3fb86f00-a7d3-5e1c-ab6a-eef0c1e19200" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{4}+C" :db/id #edb/ref 17592186676752} :answer-field/id #uuid "e55d26c5-0fc0-52a8-8e03-1e3787dd3fa8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676853}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f85c1197-a16c-562c-8e6f-5ec36344ebe3" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{8 x^{2} + 2}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n8 x^{2} + 2=2(1+(4)x^{2})\n$$\n\nUse the linear substitution $u=2 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2,\\qquad \\mathrm{d}x=(\\frac{1}{2})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{8 x^{2} + 2}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int \\frac{1}{1+(2 x)^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{1}{2})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{4}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arctan}{\\left(u \\right)}}{4}+C \\\\  &= \\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{4}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186678774 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0828d66e-5e07-5f2b-b949-ebf7ea84e487" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678771} {:answer/id #uuid "1d77ddcd-3fe6-572d-a877-3eebff19d0e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678784} {:answer/id #uuid "721ba121-1d99-5222-a5d4-240d8cddfa54" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678837} {:answer/id #uuid "9307150f-c452-5ecd-ac84-2b71ef836d07" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678862} {:answer/id #uuid "a15e2513-a6df-5621-a5b2-3f3659f279e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678870}] :answer-field/correct {:answer/id #uuid "1d77ddcd-3fe6-572d-a877-3eebff19d0e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678784} :answer-field/id #uuid "af1eb895-a271-5c6f-82b1-19836b060167" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186678880}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "0b04ba51-a09d-59d8-800c-a9f9a2586595" :question/problem "Use the substitution $u=4 x$. Which integral is obtained?\n\n$$\n\\int \\frac{3}{16 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{4}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{16 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186678793 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c1556d0-151d-5f41-8c3a-ee218dcfdf80" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186678811} {:answer/id #uuid "52c45dc3-30dd-53aa-b8f3-667ff2be361d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678817} {:answer/id #uuid "756a8ddc-326b-5a32-941e-e425a433277f" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678840} {:answer/id #uuid "948eada2-b615-5a51-8cc5-fd9fe61725e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678863} {:answer/id #uuid "dfe4ffa6-de38-562d-9bf4-f1904dda7934" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(3 x \\right)}\\right)+C" :db/id #edb/ref 17592186678910}] :answer-field/correct {:answer/id #uuid "52c45dc3-30dd-53aa-b8f3-667ff2be361d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678817} :answer-field/id #uuid "b8613995-bd94-5b2a-8266-024798cec93f" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186678889}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2c2bce04-d1e3-5f1d-bdce-22472d9c21e5" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{9 x^{2} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant." :question/retired true :question/worked-solution "Let $u=\\frac{3 x}{2}$. Then $\\mathrm{d}u=(\\frac{3}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n9 x^{2} + 4=4\\left(1+(\\frac{3 x}{2})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{2}{3}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{2}\\cdot \\frac{2}{3}=\\frac{1}{3}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{9 x^{2} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{3}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186678796 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232d27ea-930a-565a-875d-f68023a5ca43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\left(\\arctan{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186678787} {:answer/id #uuid "3c8ff4ae-c9fe-5952-9c43-f7cdf215894d" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678804} {:answer/id #uuid "9840a545-ee22-5b99-b4dd-cc8c75ac3005" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{2}\\left(\\arctan{\\left(\\frac{x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678865} {:answer/id #uuid "b130ca