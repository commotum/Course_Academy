f91-8644-6e27b958d398" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186679935} {:answer/id #uuid "9244c46c-ed63-5ef5-b25d-ca51e142b429" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C" :db/id #edb/ref 17592186679979} {:answer/id #uuid "e072f18c-bb82-5789-9baf-fe35ff4f8a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(3 x \\right)}\\right)+C" :db/id #edb/ref 17592186680035} {:answer/id #uuid "e67e530c-d28e-54f4-8748-5520d3b08f18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186680040}] :answer-field/correct {:answer/id #uuid "e67e530c-d28e-54f4-8748-5520d3b08f18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186680040} :answer-field/id #uuid "0faf9fd4-a04e-5eb0-991f-2443a2f7f221" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679905}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0659bd20-fc90-57d9-99e5-b2b3ea9b8df3" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{9 x^{2} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant." :question/retired true :question/worked-solution "Let $u=\\frac{3 x}{2}$. Then $\\mathrm{d}u=(\\frac{3}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n9 x^{2} + 4=4\\left(1+(\\frac{3 x}{2})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{2}{3}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{4}\\cdot \\frac{2}{3}=\\frac{1}{6}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{9 x^{2} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{6}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186679904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042db0ac-edc0-5704-a363-301b14e7f963" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{2}\\left(\\arctan{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679894} {:answer/id #uuid "2872334f-71fb-5bb6-bfd5-1d2597cdc370" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\arctan{\\left(4 x \\right)}\\right)+C" :db/id #edb/ref 17592186679917} {:answer/id #uuid "3abb76b7-63b0-5fae-8d7e-b570c1717f59" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\arctan{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679928} {:answer/id #uuid "5d089b64-7bf0-5842-aa42-4775b3d32980" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\arctan{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679951} {:answer/id #uuid "cf7f9bd4-3000-552f-86c9-f8421db9c068" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\arctan{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186680018}] :answer-field/correct {:answer/id #uuid "5d089b64-7bf0-5842-aa42-4775b3d32980" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\arctan{\\left(2 x \\right)}\\right)+C" :db/id #edb/ref 17592186679951} :answer-field/id #uuid "314b4635-a9da-5e01-98b0-acd17aa10beb" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186679923}] :que