t :answer-field.type/radio} :db/id #edb/ref 17592186678778}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "67479a77-7ea9-5968-a20e-c449af8b91d7" :question/problem "Use the substitution $u=2 x$. Which integral is obtained?\n\n$$\n\\int \\frac{1}{4 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $1\\cdot \\frac{1}{2}=\\frac{1}{2}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{4 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{2}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186678844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abcc45e3-4991-5d38-b599-c4a622f1b4fc" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C" :db/id #edb/ref 17592186678877} {:answer/id #uuid "b803e232-a7b2-5df9-8df2-69c21d155af6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C" :db/id #edb/ref 17592186678888} {:answer/id #uuid "bd9a9b95-3d27-59b9-9581-00b5c6acc9f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678891} {:answer/id #uuid "ecea85df-c350-56f7-aa01-661e96f3d540" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186678916} {:answer/id #uuid "fa6dcb2e-ab06-5d32-af91-201dc60ff6bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{4} \\right)}\\right)+C" :db/id #edb/re