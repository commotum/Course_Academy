\\int \\frac{2}{9 x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{2}{3}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186678873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136b8547-68d2-5b6e-98d0-8e42188a6159" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678780} {:answer/id #uuid "5685248d-fd97-5cd4-9e89-fc782d03f59a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186678820} {:answer/id #uuid "755c98a9-b985-5e1c-a002-b4af7a088984" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678839} {:answer/id #uuid "7ee84d70-506d-5e27-90e8-4fd93e6c9033" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(3 x \\right)}\\right)+C" :db/id #edb/ref 17592186678849} {:answer/id #uuid "83d9fbe0-421e-5aac-b9eb-c57d2956a84d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678853}] :answer-field/correct {:answer/id #uuid "755c98a9-b985-5e1c-a002-b4af7a088984" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C" :db/id #edb/ref 17592186678839} :answer-field/id #uuid "2594effe-021e-55f3-a72f-333ef6c7c492" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186678788}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "a8629d5d-1e6e-54c2-aed2-982e5ac05452" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{1}{9 x^{2} + 4}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant." :question/retired true :question/worked-solution "Let $u=\\frac{3 x}{2}$. Then $\\mathrm{d}u=(\\frac{3}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n9 x^{2} + 4=4\\left(1+(\\frac{3 x}{2})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=\\frac{2}{3}\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{4}\\cdot \\frac{2}{3}=\\frac{1}{6}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{1}{9 x^{2} + 4}\\,\\mathrm{d}x\\\\&=\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the supplied primitive:\n\n$$\n\\frac{1}{6}\\left(\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right)=\\frac{1}{6}\\left(\\arctan{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{1}{6}\\left(\\arctan{\\left(\\frac{3 x}{2} \\right)}\\right)+C.\n$$"} {:db/id #edb/ref 17592186678883 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21fceb15-fb08-5014-b855-f61d5649e263" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(x \\right)}\\right)+C" :db/id #edb/ref 17592186678786} {:answer/id #uuid "4eba47d0-4f61-533e-907e-c22de74c465a" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{6}\\left(\\arctan{\\left(\\frac{2 x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186678814} {:answer/id #uuid "aa931078-fea9-5b2e-bcf5-e61508754df8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\arctan{\\left(\\frac{2 x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186678876} {:answer/id #uuid "d244f049-72cb-5a30-93a5-35dba62ed212" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\arctan{\\left(\\frac{2 x}{3} \\right)}\\right)+C" :db/id #edb/ref 17592186678903} {:answer/id #u