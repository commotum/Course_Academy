  "before_edn": "{:db/id 17592186184351 :knowledge-point/canonical-example {:db/id 17592186183947 :question/id #uuid \"70fd3433-e905-5643-8e55-0bdf774d781e\" :question/math-academy-id \"e-14404\" :question/problem \"Calculate  $$\\n\\\\displaystyle \\\\int \\\\dfrac {e^{2x}} {e^{2x} + 1} \\\\, \\\\textrm{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u = e^{2x}+1.$ Differentiating gives \\n\\n$$\\n\\\\dfrac{\\\\textrm{d}u}{\\\\textrm{d}x}= 2e^{2x}\\\\quad\\\\Longrightarrow\\\\quad\\n\\\\dfrac{1}{2}\\\\, \\\\textrm{d}u = e^{2x} \\\\, \\\\textrm{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{e}^{2x}}{{e}^{2x}+1}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{e}^{2x}+1}\\\\cdot {e}^{2x}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|{e}^{2x}+1|+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡({e}^{2x}+1)+C.\\\\end{aligned}\\n$$\\n\\nNotice that, in the last step, we used the fact that $e^{2x} + 1 > 0$ for all $x.$\"} :knowledge-point/id #uuid \"ed3b6c3d-b840-50ef-9e6b-584bf14877b3\" :knowledge-point/key-prerequisites [{:db/id 17592186049443 :topic/difficulty 1.2233896690425385 :topic/encompasses [{:db/id 17592186428224 :encompassing/rationale \"Initial Codex estimate from captured target-band crossing frequency. Selected account foundations: 1 rises / 2 eligible passed source activities = 0.500000; nearest selected fraction = 1/2. Crossing activity numbers [2]; waits [2]. Separate account estimates: foundations=1/2 (1/2). Selection: most observations, then lower weight, then account name; no averaging. Single-activity estimates included. Intervening target updates: False. Crossing frequency is the chosen practical estimate of encompassing coverage; a multi-band rise counts once. This does not interpret color steps as physical repetition units. Method: encompassing-report.md. Evidence: reference/mathacademy/encompassing-analysis-2026-10-11/frequency-fractions/foundations-frequency-estimates.json, pair 1361->30. All account evidence retained in the prepared import's selected-relationships.json.\" :encompassing/topic {:db/id 17592186049195} :encompassing/weight 0.5}] :topic/id #uuid \"f580d418-6860-5b04-b964-2999aa08b42f\" :topic/knowledge-points [{:db/id 17592186105715} {:db/id 17592186105716} {:db/id 17592186105720}] :topic/math-academy-id 1361 :topic/next [{:db/id 17592186048557} {:db/id 17592186048754}] :topic/title \"Integrating the Reciprocal Function\"}] :knowledge-point/level-coverage [{:db/ident :question.difficulty/easy} {:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186683204 :question-generator/id #uuid \"22cd48e5-24b6-5864-8220-6da8b41d4d15\" :question-generator/script \"generators/8d/8d791c44004bb7d383ad2615991c6b063c9e6bb343393b909d3d4197f7134356/generator.py\"} :knowledge-point/questions [{:db/id 17592186184451 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"29e54fcf-d2f2-5df4-90db-2d54fb195e46\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{({e}^{3x}+2)}^{4}}{4}+C\" :db/id 17592186247795} {:answer/id #uuid \"431bf13d-976e-5095-9df8-63b0916664a9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{({e}^{3x}+2)}^{3}}{3}+C\" :db/id 17592186248025} {:answer/id #uuid \"4fa1568a-384f-58a8-924a-2a38ae937084\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{({e}^{3x}+2)}^{4}}{6}+C\" :db/id 17592186248140} {:answer/id #uuid \"577a0caf-bf7e-59b5-a4ca-f40167c4fa08\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{({e}^{3x}+2)}^{3}}{6}+C\" :db/id 17592186248218} {:answer/id #uuid \"87d85e70-9986-5c51-90ba-53c36aea0512\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2{({e}^{3x}+2)}^{4}}{3}+C\" :db/id 17592186248638}] :answer-field/correct {:answer/id #uuid \"4fa1568a-384f-58a8-924a-2a38ae937084\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{{({e}^{3x}+2)}^{4}}{6}+C\" :db/id 17592186248140} :answer-field/id #uuid \"792f7b0f-b886-5c74-9417-ec3ce40c477b\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249878}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2445485f-2474-5b96-9886-76e2b061635a\" :question/math-academy-id \"q-113852\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={e}^{3x}+2.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{e}^{3x}\\\\,⟹\\\\,\\\\frac{2}{3}\\\\text{d}u=2{e}^{3x}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 2{e}^{3x}{({e}^{3x}+2)}^{3}\\\\,\\\\text{d}x & =\\\\int {({e}^{3x}+2)}^{3}\\\\cdot 2{e}^{3x}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {u}^{3}\\\\,\\\\frac{2}{3}\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{3}\\\\int {u}^{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{3}\\\\frac{{u}^{4}}{4}+C \\\\\\\\  & =\\\\frac{{({e}^{3x}+2)}^{4}}{6}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186184452 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b970921c-d15d-53a0-b5c6-fc46e6dcab7b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6\\\\sqrt{3^{x} + 1}}{\\\\ln 3} + C\" :db/id 17592186180890} {:answer/id #uuid \"d778ab08-7f17-5d9d-8fac-d2f1898f19d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3^{x} + 1}}{6\\\\ln 3} + C\" :db/id 17592186180891} {:answer/id #uuid \"e134739a-8071-5865-951f-b5b40b3c8ea4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3^{x} + 1}}{3\\\\ln 3} + C\" :db/id 17592186180892} {:answer/id #uuid \"e6051283-eee8-5ca7-aef7-508bb9f721c6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3^{x} + 1}}{\\\\ln 3} + C\" :db/id 17592186180893} {:answer/id #uuid \"53948032-e541-5f9a-a89d-710bf093f2e2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\sqrt{3^{x} + 1}}{2\\\\ln 3} + C\" :db/id 17592186180894}] :answer-field/id #uuid \"ffc72a8c-7d71-520d-87f2-59d147ec95f7\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186180889}] :question/id #uuid \"7818d7dd-cee4-50cd-9c8b-99419a2fa97a\" :question/math-academy-id \"q-113876\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int\\\\frac{3^{x + 1}}{\\\\sqrt{3^{x} + 1}}dx.\\n$$\"} {:db/id 17592186234356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"23b3ff8f-fef3-5d4b-8ac7-c7f0be3c20e4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{{2}^{z}-9}}{2}+C\" :db/id 17592186339438} {:answer/id #uuid \"36b29201-973e-54a1-9076-d11d6f4d33f1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{{2}^{z}-9}+C\" :db/id 17592186339618} {:answer/id #uuid \"714604c9-2b37-531a-bb67-a0c67b2a5cb6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{{2}^{z}-9}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186340134} {:answer/id #uuid \"d56615b3-79b5-569f-a38a-6eae7ea1c379\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{{2}^{z}-9}}{2\\\\operatorname{ln}⁡2}+C\" :db/id 17592186341017} {:answer/id #uuid \"dcc1530c-4d98-5329-89c2-53ade6de9cab\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{ln}⁡2\\\\sqrt{{2}^{z}-9}+C\" :db/id 17592186341089}] :answer-field/correct {:answer/id #uuid \"714604c9-2b37-531a-bb67-a0c67b2a5cb6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{{2}^{z}-9}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186340134} :answer-field/id #uuid \"9441441f-4088-5ff2-aa37-6b852eabed90\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341641}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9aadcdf1-9134-541b-ab5d-b526e490dc48\" :question/math-academy-id \"q-73670\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{2}^{z}}{\\\\sqrt{{2}^{z}-9}}\\\\,\\\\text{d}z.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={2}^{z}-9.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}z}={2}^{z}\\\\operatorname{ln}⁡2\\\\,⟹\\\\,\\\\frac{1}{\\\\operatorname{ln}⁡2}\\\\,\\\\text{d}u={2}^{z}\\\\,\\\\text{d}z.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{{2}^{z}}{\\\\sqrt{{2}^{z}-9}}\\\\,\\\\text{d}z & =\\\\int \\\\frac{1}{\\\\sqrt{{2}^{z}-9}}\\\\cdot {2}^{z}\\\\,\\\\text{d}z \\\\\\\\  & =\\\\int \\\\frac{1}{\\\\operatorname{ln}⁡2}\\\\cdot \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡2}\\\\int {u}^{-1/2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡2}\\\\cdot \\\\frac{{u}^{1/2}}{\\\\left(\\\\frac{1}{2}\\\\right)} \\\\\\\\  & =\\\\frac{2\\\\sqrt{{2}^{z}-9}}{\\\\operatorname{ln}⁡2}+C.\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186250127 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"04d4c17e-b4e9-5c3d-8e37-585ca78e36f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C\" :db/id 17592186247458} {:answer/id #uuid \"5dbb5507-aaa0-5749-a41a-43f26c688149\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{4}+C\" :db/id 17592186248276} {:answer/id #uuid \"b5da3429-fa5a-5c1e-bc1f-55c28c97d965\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{2{e}^{2x}}+C\" :db/id 17592186249052} {:answer/id #uuid \"b800b44e-6e5f-530d-a74e-e61c336c427d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{{e}^{2x}}+C\" :db/id 17592186249070} {:answer/id #uuid \"c9a200ad-d245-5814-a41d-3e6f3d647290\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C\" :db/id 17592186249218}] :answer-field/correct {:answer/id #uuid \"c9a200ad-d245-5814-a41d-3e6f3d647290\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C\" :db/id 17592186249218} :answer-field/id #uuid \"1a658127-d29f-5d3c-9088-48b067088416\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186249714}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e2191fab-edb1-5e72-a762-ef056bc648a3\" :question/math-academy-id \"q-113873\" :question/problem \"Calculate the integral$$\\n\\\\displaystyle \\\\int \\\\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={e}^{2x}-2x.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2{e}^{2x}-2=2({e}^{2x}-1)\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=({e}^{2x}-1)\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{e}^{2x}-1}{{e}^{2x}-2x}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{e}^{2x}-2x}\\\\cdot ({e}^{2x}-1)\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{\\\\operatorname{ln}⁡|{e}^{2x}-2x|}{2}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186297410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"398d7153-dd3c-5a82-b5a4-cae2a584156a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5x}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295595} {:answer/id #uuid \"4ca4abb9-0851-5c3b-9177-0dd90d8d8845\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({5}^{x}+1)}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295704} {:answer/id #uuid \"7a287bc3-0892-5d93-8218-78604cf894d1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5\\\\operatorname{ln}⁡({5}^{x}+1)}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295934} {:answer/id #uuid \"7ef3b95e-bd1a-57ef-8fe5-5cd8afb14244\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{{5}^{x}\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295954} {:answer/id #uuid \"af23df45-3861-5a0d-ac36-df9c438d8eb0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({5}^{x}+1)}{5\\\\operatorname{ln}⁡5}+C\" :db/id 17592186296190}] :answer-field/correct {:answer/id #uuid \"4ca4abb9-0851-5c3b-9177-0dd90d8d8845\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({5}^{x}+1)}{\\\\operatorname{ln}⁡5}+C\" :db/id 17592186295704} :answer-field/id #uuid \"04a5f69b-9de4-5df4-950b-038dd6a88814\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296647}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cb025f0b-ba4d-525b-a215-9bdb02362821\" :question/math-academy-id \"q-31478\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{5}^{x}}{{5}^{x}+1}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={5}^{x}+1.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={5}^{x}\\\\operatorname{ln}⁡5\\\\,⟹\\\\,\\\\frac{1}{\\\\operatorname{ln}⁡5}\\\\,\\\\text{d}u={5}^{x}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{5}^{x}}{{5}^{x}+1}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{5}^{x}+1}\\\\cdot {5}^{x}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\frac{1}{\\\\operatorname{ln}⁡5}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡5}\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡5}\\\\cdot \\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡5}\\\\cdot \\\\operatorname{ln}⁡|{5}^{x}+1|+C \\\\\\\\  & =\\\\frac{\\\\operatorname{ln}⁡({5}^{x}+1)}{\\\\operatorname{ln}⁡5}+C.\\\\end{aligned}\\n$$\\n\\nNotice that, in the last step, we used the fact that ${5}^{x}+1>0$ for all $x.$\"} {:db/id 17592186297411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"07618f82-80dd-5c73-b8a4-2164bc070f03\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({4}^{x})}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295304} {:answer/id #uuid \"7fabc313-b7ec-5fea-8e37-3c5a06d43177\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{{4}^{x}\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295957} {:answer/id #uuid \"872590b5-df6d-5e6e-9dc4-79994e14eb92\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({4}^{x}+2)}{4\\\\operatorname{ln}⁡4}+C\" :db/id 17592186295994} {:answer/id #uuid \"ac13f248-7d32-5d3e-b31a-bf1601844a70\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({4}^{x}+2)}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186296173} {:answer/id #uuid \"b29969af-ede3-53c4-a306-057c9ce68656\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4\\\\operatorname{ln}⁡({4}^{x}+2)}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186296208}] :answer-field/correct {:answer/id #uuid \"ac13f248-7d32-5d3e-b31a-bf1601844a70\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({4}^{x}+2)}{\\\\operatorname{ln}⁡4}+C\" :db/id 17592186296173} :answer-field/id #uuid \"7f35bb0c-6a4b-5fe9-b22b-03be76e5104e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296892}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"fa16c83a-9f14-57ce-8cd3-45bb3a59d16f\" :question/math-academy-id \"q-31480\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{4}^{x}}{{4}^{x}+2}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={4}^{x}+2.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={4}^{x}\\\\operatorname{ln}⁡4\\\\,⟹\\\\,\\\\frac{1}{\\\\operatorname{ln}⁡4}\\\\,\\\\text{d}u={4}^{x}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{4}^{x}}{{4}^{x}+2}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{4}^{x}+2}\\\\cdot {4}^{x}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\frac{1}{\\\\operatorname{ln}⁡4}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡4}\\\\int \\\\frac{1}{u}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡4}\\\\cdot \\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{1}{\\\\operatorname{ln}⁡4}\\\\cdot \\\\operatorname{ln}⁡|{4}^{x}+2|+C \\\\\\\\  & =\\\\frac{\\\\operatorname{ln}⁡({4}^{x}+2)}{\\\\operatorname{ln}⁡4}+C.\\\\end{aligned}\\n$$\\n\\nNotice that, in the last step, we used the fact that ${4}^{x}+2>0$ for all $x.$\"} {:db/id 17592186332748 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"027a07ce-3cfe-56e8-be37-2a1cb12f5c96\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\sqrt{({e}^{x}+4)^{5}}+C\" :db/id 17592186329985} {:answer/id #uuid \"21d26b82-340b-5005-b15b-4c394deda50e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{5}\\\\sqrt{({e}^{x}+4)^{3}}+C\" :db/id 17592186330239} {:answer/id #uuid \"34f46ff9-bbb8-5507-929a-8bf833e4a41a\" :answer/type {:db/ident :answer.type/math} :answer/value \"5\\\\sqrt{({e}^{x}+4)^{3}}+C\" :db/id 17592186330415} {:answer/id #uuid \"b30e1c0f-e528-5e60-ac58-17f053cef19d\" :answer/type {:db/ident :answer.type/math} :answer/value \"10\\\\sqrt[3]{({e}^{x}+4)^{2}}+C\" :db/id 17592186331531} {:answer/id #uuid \"c31f2fe7-9fe8-531c-bb86-82e9bb1e9492\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{10}{3}\\\\sqrt{({e}^{x}+4)^{3}}+C\" :db/id 17592186331685}] :answer-field/correct {:answer/id #uuid \"c31f2fe7-9fe8-531c-bb86-82e9bb1e9492\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{10}{3}\\\\sqrt{({e}^{x}+4)^{3}}+C\" :db/id 17592186331685} :answer-field/id #uuid \"18e0a5f1-7890-529c-b7ba-c46e029335b7\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186332236}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2a94e796-17ea-59f0-8634-ea54546ad51c\" :question/math-academy-id \"q-49577\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 5{e}^{x}\\\\sqrt{{e}^{x}+4}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={e}^{x}+4.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={e}^{x}\\\\,⟹\\\\,\\\\text{d}u={e}^{x}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int 5{e}^{x}\\\\sqrt{{e}^{x}+4}\\\\,\\\\text{d}x & =5\\\\int \\\\sqrt{{e}^{x}+4}\\\\cdot {e}^{x}\\\\,\\\\text{d}x \\\\\\\\  & =5\\\\int \\\\sqrt{u}\\\\,\\\\text{d}u \\\\\\\\  & =5\\\\int {u}^{1/2}\\\\,\\\\text{d}u \\\\\\\\  & =5\\\\cdot \\\\frac{2{u}^{3/2}}{3}+C \\\\\\\\  & =\\\\frac{10}{3}\\\\sqrt{{u}^{3}}+C \\\\\\\\  & =\\\\frac{10}{3}\\\\sqrt{({e}^{x}+4)^{3}}+C.\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186342057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0c85fd39-fb12-5fd0-84ca-1f9410fd86c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{{2}^{x}-5}+C\" :db/id 17592186339238} {:answer/id #uuid \"35d01e19-8df6-5a98-9a4e-a13ff45e59c6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{\\\\operatorname{ln}⁡2}\\\\sqrt{({2}^{x}-5)^{3}}+C\" :db/id 17592186339607} {:answer/id #uuid \"ba62682b-6375-50c8-ab0e-ae65ecff8935\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3\\\\operatorname{ln}⁡2}\\\\sqrt{({2}^{x}-5)^{3}}+C\" :db/id 17592186340799} {:answer/id #uuid \"f040dd33-55b8-577d-b65c-882719ad8257\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3\\\\operatorname{ln}⁡2}\\\\sqrt{{2}^{x}-5}+C\" :db/id 17592186341244} {:answer/id #uuid \"fbec05e7-3328-5ebb-a6b8-92e98b6e67b7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\sqrt{({2}^{x}-5)^{3}}+C\" :db/id 17592186341354}] :answer-field/correct {:answer/id #uuid \"ba62682b-6375-50c8-ab0e-ae65ecff8935\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3\\\\operatorname{ln}⁡2}\\\\sqrt{({2}^{x}-5)^{3}}+C\" :db/id 17592186340799} :answer-field/id #uuid \"9475f005-9702-55df-8eb5-e3d9087d1fde\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186341643}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4d8e2bdb-04c0-5bb8-8174-6e672a971ff9\" :question/math-academy-id \"q-73669\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int {2}^{x+1}\\\\sqrt{{2}^{x}-5}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\\n\\n$$\\n\\\\begin{aligned}\\\\frac{\\\\text{d}u}{\\\\text{d}x} & ={2}^{x}\\\\operatorname{ln}⁡2\\\\,⟹\\\\,\\\\frac{1}{\\\\operatorname{ln}⁡2}\\\\,\\\\text{d}u={2}^{x}\\\\,\\\\text{d}x.\\\\end{aligned}\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int {2}^{x+1}\\\\sqrt{{2}^{x}-5}\\\\,\\\\text{d}x & =\\\\int 2\\\\cdot {2}^{x}\\\\sqrt{{2}^{x}-5}\\\\,\\\\text{d}x \\\\\\\\  & =2\\\\int \\\\sqrt{{2}^{x}-5}\\\\cdot {2}^{x}\\\\,\\\\text{d}x \\\\\\\\  & =2\\\\int \\\\sqrt{u}\\\\cdot \\\\frac{1}{\\\\operatorname{ln}⁡2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{\\\\operatorname{ln}⁡2}\\\\int {u}^{1/2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{\\\\operatorname{ln}⁡2}\\\\cdot \\\\frac{{u}^{3/2}}{\\\\left(\\\\frac{3}{2}\\\\right)}+C \\\\\\\\  & =\\\\frac{2}{\\\\operatorname{ln}⁡2}\\\\cdot \\\\frac{2}{3}\\\\cdot {u}^{3/2} \\\\\\\\  & =\\\\frac{4}{3\\\\operatorname{ln}⁡2}\\\\sqrt{{u}^{3}}+C \\\\\\\\  & =\\\\frac{4}{3\\\\operatorname{ln}⁡2}\\\\sqrt{({2}^{x}-5)^{3}}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186608168 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0f888669-2477-534b-93c1-14dd41a1467c\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{{e}^{z}+1}+C\" :db/id 17592186607822} {:answer/id #uuid \"8a28e55e-aa6e-55ec-9c6f-983a66c3f811\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\sqrt{{e}^{z}+1}+C\" :db/id 17592186607968} {:answer/id #uuid \"a422661a-62b6-548f-99fb-b5e248bf15ef\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\sqrt{{e}^{z}+1}}+C\" :db/id 17592186607999} {:answer/id #uuid \"dd7625c3-f004-5df2-addc-77e2835786c9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{{e}^{z}+2}+C\" :db/id 17592186608048} {:answer/id #uuid \"ef774d49-b81e-572f-9499-ca77b619a297\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{{e}^{z}+1}+C\" :db/id 17592186608069}] :answer-field/correct {:answer/id #uuid \"0f888669-2477-534b-93c1-14dd41a1467c\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\sqrt{{e}^{z}+1}+C\" :db/id 17592186607822} :answer-field/id #uuid \"060253c5-cf85-5b59-9850-bd847d9b4cdb\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186608091}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"14a57d7f-2f51-563e-9400-c8274f6aaa38\" :question/math-academy-id \"q-49574\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{e}^{z}}{\\\\sqrt{{e}^{z}+1}}\\\\,\\\\text{d}z.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u={e}^{z}+1.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}z}={e}^{z}\\\\,⟹\\\\,\\\\text{d}u={e}^{z}\\\\,\\\\text{d}z.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{{e}^{z}}{\\\\sqrt{{e}^{z}+1}}\\\\,\\\\text{d}z & =\\\\int \\\\frac{1}{\\\\sqrt{{e}^{z}+1}}\\\\cdot {e}^{z}\\\\,\\\\text{d}z \\\\\\\\  & =\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\int {u}^{-1/2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{{u}^{1/2}}{\\\\left(\\\\frac{1}{2}\\\\right)}+C \\\\\\\\  & =2\\\\sqrt{{e}^{z}+1}+C.\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186608178 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"34c67ac0-41e8-5678-8336-d0107e58afba\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\operatorname{ln}⁡|2-{6}^{x}|}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186607865} {:answer/id #uuid \"4d4864b2-2c2f-57f4-956b-9433730346bd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡|2-{6}^{x}|}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186607904} {:answer/id #uuid \"70f388a5-6722-5425-b634-fd9fcace933e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\operatorname{ln}⁡|2-{6}^{x}|}{6\\\\operatorname{ln}⁡6}+C\" :db/id 17592186607939} {:answer/id #uuid \"7e2d864c-a850-55c1-893b-e69551329f80\" :answer/type {:db/ident :answer.type/math} :answer/value \"-6\\\\operatorname{ln}⁡|2-{6}^{x}|+C\" :db/id 17592186607958} {:answer/id #uuid \"8f824d94-ffac-51cd-ade0-eac66ce2397f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{6\\\\operatorname{ln}⁡|2-{6}^{x}|}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186607971}] :answer-field/correct {:answer/id #uuid \"34c67ac0-41e8-5678-8336-d0107e58afba\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{\\\\operatorname{ln}⁡|2-{6}^{x}|}{\\\\operatorname{ln}⁡6}+C\" :db/id 17592186607865} :answer-field/id #uuid \"be0455fc-1523-58f5-9e10-d164fbc5cf2a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186608146}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"35f0c1cb-49ca-5544-8236-0e4cefc5c8cd\" :question/math-academy-id \"q-113875\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{6}^{x}}{2-{6}^{x}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u=2-{6}^{x}.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-{6}^{x}\\\\operatorname{ln}⁡6\\\\,⟹\\\\,-\\\\frac{1}{\\\\operatorname{ln}⁡6}\\\\,\\\\text{d}u={6}^{x}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{6}^{x}}{2-{6}^{x}}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{2-{6}^{x}}\\\\cdot {6}^{x}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{u}\\\\cdot \\\\left(-\\\\frac{1}{\\\\operatorname{ln}⁡6}\\\\right)\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{\\\\operatorname{ln}⁡6}\\\\int \\\\frac{1}{u}\\\\cdot \\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{\\\\operatorname{ln}⁡6}\\\\cdot \\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =-\\\\frac{\\\\operatorname{ln}⁡|2-{6}^{x}|}{\\\\operatorname{ln}⁡6}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186627685 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ab0391c-aba7-5b4b-b924-823a0ecf8ef0\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{2}^{2-3{x}^{2}}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186627112} {:answer/id #uuid \"282c73af-4464-5ea1-be06-b83bdc954507\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{2}^{1-3{x}^{3}}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186627163} {:answer/id #uuid \"64b77f22-9abf-56fe-8cb2-efe9fed08e09\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{3\\\\cdot {2}^{3-3{x}^{3}}}{\\\\operatorname{ln}⁡2}+C\" :db/id 17592186627264} {:answer/id #uuid \"7516a0db-3848-55de-b5a0-79b72e92b866\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{2}^{1-3{x}^{3}}}{3\\\\operatorname{ln}⁡2}+C\" :db/id 17592186627290} {:answer/id #uuid \"bef4977f-efe8-5b57-8f0e-155b8d88345f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{2}^{3-3{x}^{3}}}{3\\\\operatorname{ln}⁡2}+C\" :db/id 17592186627409}] :answer-field/correct {:answer/id #uuid \"bef4977f-efe8-5b57-8f0e-155b8d88345f\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{{2}^{3-3{x}^{3}}}{3\\\\operatorname{ln}⁡2}+C\" :db/id 17592186627409} :answer-field/id #uuid \"84fca298-420b-5070-8302-520084591405\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186627601}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"45b28540-4478-5f51-a0e6-dbeb90f3ba88\" :question/math-academy-id \"q-73666\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 6{x}^{2}\\\\,{2}^{2-3{x}^{3}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let's introduce the new variable $u=2-3{x}^{3}.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-9{x}^{2}\\\\,⟹\\\\,-\\\\frac{1}{9}\\\\,\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int 6{x}^{2}\\\\,{2}^{2-3{x}^{3}}\\\\,\\\\text{d}x & =6\\\\int {2}^{2-3{x}^{3}}\\\\,\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =6\\\\int {2}^{u}\\\\cdot \\\\left(-\\\\frac{1}{9}\\\\right)\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{2}{3}\\\\int {2}^{u}\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{2}{3}\\\\cdot \\\\frac{{2}^{u}}{\\\\operatorname{ln}⁡2}+C \\\\\\\\  & =-\\\\frac{{2}^{1}\\\\cdot {2}^{2-3{x}^{3}}}{3\\\\operatorname{ln}⁡2}+C \\\\\\\\  & =-\\\\frac{{2}^{3-3{x}^{3}}}{3\\\\operatorname{ln}⁡2}+C.\\\\end{aligned}\\n$$\"} {:db/id 17592186664062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"70a9e400-9f93-57ab-9a14-7ffb9d25e219\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\operatorname{ln}⁡({3}^{x+1}+1)}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186663694} {:answer/id #uuid \"ac6d1d4d-fceb-50d0-b5e6-abfc0eb65dde\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\operatorname{ln}⁡({3}^{x}+1)}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186663796} {:answer/id #uuid \"ba253305-8757-572e-8b4a-4c6a6d188d9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({3}^{x}+1)}{3}+C\" :db/id 17592186663821} {:answer/id #uuid \"d9d02898-740e-54de-af62-005f64fa7dd5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\operatorname{ln}⁡({3}^{x-1}+1)}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186663879} {:answer/id #uuid \"e1d58cd5-60ac-5ca2-8082-2c6c2008174d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{ln}⁡({3}^{x}+1)}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186663890}] :answer-field/correct {:answer/id #uuid \"ac6d1d4d-fceb-50d0-b5e6-abfc0eb65dde\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3\\\\operatorname{ln}⁡({3}^{x}+1)}{\\\\operatorname{ln}⁡3}+C\" :db/id 17592186663796} :answer-field/id #uuid \"dbfdfb0e-1c45-5415-8a60-6b10719a32f2\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186664017}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"50d988aa-30cb-58ec-89a4-3a5bc9d0a71a\" :question/math-academy-id \"q-113872\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{3}^{x+1}}{{3}^{x}+1}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Notice that the numerator is proportional to the derivative of the denominator. So, we introduce the new variable $u={3}^{x}+1.$ Differentiating gives \\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}={3}^{x}\\\\operatorname{ln}⁡3\\\\,⟹\\\\,\\\\frac{1}{\\\\operatorname{ln}⁡3}\\\\,\\\\text{d}u={3}^{x}\\\\,\\\\text{d}x.\\n$$\\n\\nTherefore,\\n\\n$$\\n\\\\begin{aligned}\\\\int \\\\frac{{3}^{x+1}}{{3}^{x}+1}\\\\,\\\\text{d}x & =\\\\int \\\\frac{1}{{3}^{x}+1}\\\\cdot {3}^{x+1}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\frac{1}{{3}^{x}+1}\\\\cdot 3\\\\cdot {3}^{x}\\\\,\\\\text{d}x \\\\\\\\  & =3\\\\int \\\\frac{1}{u}\\\\cdot \\\\frac{1}{\\\\operatorname{ln}⁡3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{\\\\operatorname{ln}⁡3}\\\\cdot \\\\operatorname{ln}⁡|u|+C \\\\\\\\  & =\\\\frac{3\\\\operatorname{ln}⁡({3}^{x}+1)}{\\\\operatorname{ln}⁡3}+C.\\\\end{aligned}\\n$$\\n\\nNotice that, in the last step, we used the fact that ${3}^{x}+1>0$ for all $x.$\"} {:db/id 17592186679422 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(3^{x} + 4\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186679492}] :answer-field/correct {:answer/id #uuid \"ac0a3a05-fdcb-5ea7-8f78-c6250c9aa1d0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(3^{x} + 4\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186679492} :answer-field/id #uuid \"a79080ff-3a68-56f4-bd9c-22a0870f1b37\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679490}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"0156d36e-072e-5215-9c38-b10ce4b47e6d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 3^{x} \\\\sqrt{3^{x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u=\\\\frac{2 u^{\\\\frac{3}{2}}}{3}+C$.\\n\\nWork where $3^{x} + 4>0$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=3^{x} + 4$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 4>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 3^{x} \\\\sqrt{3^{x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 u^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(3^{x} + 4\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\"} {:db/id 17592186679429 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"acbdbbf0-0d6c-5391-b6a4-3aee96bd807f\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679494} {:answer/id #uuid \"b3991143-d38e-53c7-8a27-5d190666569b\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679497} {:answer/id #uuid \"b88134a9-93b2-53fd-add6-da3c8df3ac13\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int u^{2}\\\\,\\\\mathrm{d}u\" :db/id 17592186679500} {:answer/id #uuid \"cef139c2-af29-569f-97d3-211d93d5fac5\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679506} {:answer/id #uuid \"eadcf2e6-93d0-589d-91c6-e568dc71f1b4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679517}] :answer-field/correct {:answer/id #uuid \"eadcf2e6-93d0-589d-91c6-e568dc71f1b4\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679517} :answer-field/id #uuid \"178e5483-12e9-5478-82dc-be7ebb32cefe\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679432}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"0f15d446-4d46-574b-861e-a957a2536c10\" :question/problem \"Use the substitution $u=e^{2 x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679430 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e180d782-4de4-56af-b422-90495e9d1e10\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{2^{x} + 2}\\\\right)\" :db/id 17592186679514}] :answer-field/correct {:answer/id #uuid \"e180d782-4de4-56af-b422-90495e9d1e10\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{2^{x} + 2}\\\\right)\" :db/id 17592186679514} :answer-field/id #uuid \"82cc3620-0ac2-51ea-96d5-046a3c0a3a4f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679480}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"11ef6d40-0a09-58bb-8363-01217a52d0ea\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cdot 2^{x}}{\\\\sqrt{2^{x} + 2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u=2 \\\\sqrt{u}+C$.\\n\\nWork where $2^{x} + 2>0$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cdot 2^{x}}{\\\\sqrt{2^{x} + 2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{2^{x} + 2}\\\\right)+C.\\n$$\"} {:db/id 17592186679437 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6af84686-d09b-5aa3-ae4a-19ceb28d8a0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|2 x + e^{2 x} + 4\\\\right|\" :db/id 17592186679467}] :answer-field/correct {:answer/id #uuid \"6af84686-d09b-5aa3-ae4a-19ceb28d8a0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|2 x + e^{2 x} + 4\\\\right|\" :db/id 17592186679467} :answer-field/id #uuid \"dcf91abd-7972-5cdd-a9d1-a1b544bbffff\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679511}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1fbf42aa-0c2a-5aad-95e1-ee2ce4773cfc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 x + e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x} + 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|2 x + e^{2 x} + 4\\\\right|+C.\\n$$\"} {:db/id 17592186679439 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d8ce16e4-e6e9-5770-bd52-c528f41d4c34\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|e^{x} + 1\\\\right|\\\\right)\" :db/id 17592186679509}] :answer-field/correct {:answer/id #uuid \"d8ce16e4-e6e9-5770-bd52-c528f41d4c34\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|e^{x} + 1\\\\right|\\\\right)\" :db/id 17592186679509} :answer-field/id #uuid \"e044980f-df8c-5ebc-9aab-7e314954a789\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679513}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"234b841b-ddf2-5537-9f3b-c343ab766392\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=e^{x} + 1$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\ln\\\\left|e^{x} + 1\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679440 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2e228d92-8e66-55f1-83eb-fa5d97e219e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186679443}] :answer-field/correct {:answer/id #uuid \"2e228d92-8e66-55f1-83eb-fa5d97e219e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186679443} :answer-field/id #uuid \"309b896d-0ed4-573b-ae38-151b2a7fd9ba\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679444}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"24ac3e9f-c431-5dd9-aaf4-0785964f442b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x + e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x} + 1)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\ln\\\\left|x + e^{x} + 3\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679448 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ba6f291-bb76-5ba6-a32c-91faf617ea35\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679427} {:answer/id #uuid \"1aec8f7e-eb38-55de-b967-a99fae3472e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int u^{2}\\\\,\\\\mathrm{d}u\" :db/id 17592186679433} {:answer/id #uuid \"2287504f-e1dc-5e9a-868a-72d547ff8970\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679438} {:answer/id #uuid \"c8d86aa4-7bae-5058-8638-babc5b7a040b\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679503} {:answer/id #uuid \"dd069ab8-e030-5af0-87f0-6bbdb029763b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679512}] :answer-field/correct {:answer/id #uuid \"1aec8f7e-eb38-55de-b967-a99fae3472e3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int u^{2}\\\\,\\\\mathrm{d}u\" :db/id 17592186679433} :answer-field/id #uuid \"a26b5c34-17e1-5280-8d13-b4e435154956\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679489}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"3607a00c-ed00-5182-88fc-30842ad51810\" :question/problem \"Use the substitution $u=e^{2 x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int u^{2}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186679449 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"03291e69-301a-5e36-a8ee-5af9f62b63b0\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679424} {:answer/id #uuid \"1b356308-7f73-522c-8bcd-159b18b21749\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679434} {:answer/id #uuid \"4f9eeb44-05c8-5aa5-876d-8e0b4c3f60dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679456} {:answer/id #uuid \"a95a2c34-08d0-5e7e-b641-1671402e4b65\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679491} {:answer/id #uuid \"daf8c088-8328-59ff-bd2d-7625b285ab5c\" :answer/type {:db/ident :answer.type/math} :answer/value \"9\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679510}] :answer-field/correct {:answer/id #uuid \"1b356308-7f73-522c-8bcd-159b18b21749\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679434} :answer-field/id #uuid \"570bf4fa-e98a-5c46-804b-259fdbb167a9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679460}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"37076561-9cc7-54e0-b6a6-f12582ef2576\" :question/problem \"Use the substitution $u=e^{x} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679458 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1c95dfe4-db81-5259-aa60-815421fbd377\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2 \\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679435} {:answer/id #uuid \"5102527f-8dc0-5dd6-a34d-b228066149de\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679457} {:answer/id #uuid \"53c7c3e1-48cd-50d6-98b7-0913f873b41d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679459} {:answer/id #uuid \"5f9187f5-22ec-5e13-b86a-998e6cfcb208\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679462} {:answer/id #uuid \"f3397fd6-64bf-5ecf-911a-8e5aba594a85\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679523}] :answer-field/correct {:answer/id #uuid \"5102527f-8dc0-5dd6-a34d-b228066149de\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679457} :answer-field/id #uuid \"9c9260c8-ddb4-529f-afa3-95f155a1d130\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679487}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5196a682-3b3b-548b-8bcb-d71c48d9fec1\" :question/problem \"Use the substitution $u=2^{x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679461 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1221a1b3-47cd-5c09-b449-e6d1c00cfbe6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int u^{3}\\\\,\\\\mathrm{d}u\" :db/id 17592186679431} {:answer/id #uuid \"66565b37-6c8e-545e-a73c-b882168b6efe\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679465} {:answer/id #uuid \"721a0769-6bac-5940-b57c-f18f3f105970\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679470} {:answer/id #uuid \"7af9d7b9-9a79-5235-b715-4dafeac6a7f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679475} {:answer/id #uuid \"7d71dfca-38d2-5c28-852d-646dea09301f\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679476}] :answer-field/correct {:answer/id #uuid \"7af9d7b9-9a79-5235-b715-4dafeac6a7f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679475} :answer-field/id #uuid \"74724f24-3864-5dbf-9f26-2a473f015706\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679472}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"5f6584c0-0c89-55ec-8ed8-15570be602ff\" :question/problem \"Use the substitution $u=e^{2 x} + 4$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 4>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9fbb508d-92db-5035-8a17-fd24237b638d\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186679488}] :answer-field/correct {:answer/id #uuid \"9fbb508d-92db-5035-8a17-fd24237b638d\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186679488} :answer-field/id #uuid \"6fc081b0-2f19-5297-9456-fed742bd694e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679469}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"65cd622a-f56e-5266-8bca-f7152ab8c719\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4 e^{2 x} - 4}{- 2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 2 x + e^{2 x} + 1$. Then $\\\\mathrm{d}u=(2 e^{2 x} - 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4 e^{2 x} - 4}{- 2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 1\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3320dec6-8b4f-590e-8dcb-0742047d4bbe\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\frac{2 \\\\left(e^{2 x} + 1\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186679445}] :answer-field/correct {:answer/id #uuid \"3320dec6-8b4f-590e-8dcb-0742047d4bbe\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\frac{2 \\\\left(e^{2 x} + 1\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186679445} :answer-field/id #uuid \"947510be-5291-5029-825b-05037b47652f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679486}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"69d1eec5-81a3-5284-a785-7a97dc40fb64\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\sqrt{e^{2 x} + 1} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u=\\\\frac{2 u^{\\\\frac{3}{2}}}{3}+C$.\\n\\nWork where $e^{2 x} + 1>0$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=e^{2 x} + 1$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\sqrt{e^{2 x} + 1} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\frac{2 u^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\frac{2 \\\\left(e^{2 x} + 1\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\"} {:db/id 17592186679474 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8156d017-3401-5bd3-a0d0-6313ab57906c\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(2 \\\\sqrt{e^{x} + 3}\\\\right)\" :db/id 17592186679479}] :answer-field/correct {:answer/id #uuid \"8156d017-3401-5bd3-a0d0-6313ab57906c\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(2 \\\\sqrt{e^{x} + 3}\\\\right)\" :db/id 17592186679479} :answer-field/id #uuid \"396dc548-1d55-579a-8b96-6c2d63e31740\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679451}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"79fd7a1c-f80b-5f30-b249-83e9987f33c8\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 e^{x}}{\\\\sqrt{e^{x} + 3}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u=2 \\\\sqrt{u}+C$.\\n\\nWork where $e^{x} + 3>0$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 e^{x}}{\\\\sqrt{e^{x} + 3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(2 \\\\sqrt{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(2 \\\\sqrt{e^{x} + 3}\\\\right)+C.\\n$$\"} {:db/id 17592186679478 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0112c27e-e043-5b29-ad36-2fcf89749094\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679421} {:answer/id #uuid \"1db2cacd-09b6-5d56-bec4-99b5e44e4bb2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2 \\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679436} {:answer/id #uuid \"4291fb9e-1b8e-5ddc-967f-c0e3b03413b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679454} {:answer/id #uuid \"9170ccab-76b1-55f3-97b7-12457409c35e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679485} {:answer/id #uuid \"bfa83503-e282-588c-b247-182a63a0ca9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679502}] :answer-field/correct {:answer/id #uuid \"9170ccab-76b1-55f3-97b7-12457409c35e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679485} :answer-field/id #uuid \"7ef48f89-6555-56a6-8966-c7eb1e61fb14\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679477}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"7f1f1976-4597-5cd7-b4eb-0a8b45b14871\" :question/problem \"Use the substitution $u=2^{x} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=2^{x} + 1$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ef9d19b8-b764-5fc0-89ff-6ac72aea9d00\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 4\\\\right|\\\\right)\" :db/id 17592186679520}] :answer-field/correct {:answer/id #uuid \"ef9d19b8-b764-5fc0-89ff-6ac72aea9d00\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 4\\\\right|\\\\right)\" :db/id 17592186679520} :answer-field/id #uuid \"72c51815-1bd0-5eb5-8b76-2f5b576ed2d6\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679471}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ad79e0bf-30a8-5a5e-8565-5721f911bb72\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{e^{2 x} - 1}{- 2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 2 x + e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x} - 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{e^{2 x} - 1}{- 2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 4\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3c2773b8-e383-53d3-879a-20d6c9ce3514\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679452} {:answer/id #uuid \"46240bb4-c1fc-5f98-ab19-458fe118c7aa\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679455} {:answer/id #uuid \"65115652-80cf-5ac5-a896-87f83940f93d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679463} {:answer/id #uuid \"75201187-4fad-5d9f-94e1-23d6add14478\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679473} {:answer/id #uuid \"82e47d65-a005-5d9e-996f-be60450c3190\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679481}] :answer-field/correct {:answer/id #uuid \"82e47d65-a005-5d9e-996f-be60450c3190\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679481} :answer-field/id #uuid \"e5f8ec3b-e9b3-592d-b56a-b3ba4f2d56bd\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679515}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b179e51d-fde0-5f87-b5e7-b1a25d37beaf\" :question/problem \"Use the substitution $u=3^{x} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=3^{x} + 1$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"efba1585-12c6-5bc3-b452-387ee1d85550\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 2\\\\right|\\\\right)\" :db/id 17592186679521}] :answer-field/correct {:answer/id #uuid \"efba1585-12c6-5bc3-b452-387ee1d85550\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 2\\\\right|\\\\right)\" :db/id 17592186679521} :answer-field/id #uuid \"350bf0df-e11e-5e67-a2ef-d167b0009b5b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679446}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b48f00d3-1d5f-57ce-8193-e35fdb23619c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x + e^{x} + 2$. Then $\\\\mathrm{d}u=(e^{x} + 1)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\ln\\\\left|x + e^{x} + 2\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6edf7752-6e76-549e-b7f5-cc968d4c1e6b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 4\\\\right|\\\\right)\" :db/id 17592186679468}] :answer-field/correct {:answer/id #uuid \"6edf7752-6e76-549e-b7f5-cc968d4c1e6b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 4\\\\right|\\\\right)\" :db/id 17592186679468} :answer-field/id #uuid \"2670a155-a926-5568-96d3-f75f22455479\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679441}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"b600485f-2a8a-53d6-9f97-db58335a0f24\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5^{x}}{5^{x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5^{x} + 4$. Then $\\\\mathrm{d}u=(5^{x} \\\\ln{\\\\left(5 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5^{x}}{5^{x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 4\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186679493}] :answer-field/correct {:answer/id #uuid \"ac2c5013-33bd-5d19-9cc8-c4d9e9a915d2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186679493} :answer-field/id #uuid \"8b553907-b58e-5267-8715-e4778af79c9c\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679484}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"bc08d550-1e24-59f1-bab8-fa99a8cbf667\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 x + e^{2 x} + 1$. Then $\\\\mathrm{d}u=(2 e^{2 x} + 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|2 x + e^{2 x} + 1\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0b54f5fb-03d0-5484-83f6-fa79c875ba8b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679426} {:answer/id #uuid \"357be9f6-28af-514e-bf35-46ec344268c4\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679447} {:answer/id #uuid \"406631ca-87e3-5641-9550-b02c7363333e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679453} {:answer/id #uuid \"8a39baf6-7ace-54f9-8881-c10507bd3782\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679483} {:answer/id #uuid \"d476efcc-72c6-5e8a-9aae-2e28144faf04\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679508}] :answer-field/correct {:answer/id #uuid \"d476efcc-72c6-5e8a-9aae-2e28144faf04\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186679508} :answer-field/id #uuid \"030a6517-a740-55b4-bc0a-8e71e55423ed\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186679423}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"d122d325-dd4e-5e3c-9bf4-42390c0e7f21\" :question/problem \"Use the substitution $u=3^{x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\" :question/retired true :question/worked-solution \"Let $u=3^{x} + 2$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186679516 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"85ea9013-4282-55bc-946e-30500a65a254\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|- x + e^{2 x} + 3\\\\right|\" :db/id 17592186679482}] :answer-field/correct {:answer/id #uuid \"85ea9013-4282-55bc-946e-30500a65a254\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|- x + e^{2 x} + 3\\\\right|\" :db/id 17592186679482} :answer-field/id #uuid \"2aff0ff1-c58a-5dd9-a5c8-c85342df2e78\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679442}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ea1a7e25-e71f-582a-863b-88aa6d9cf7aa\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{2 x} - 1}{- x + e^{2 x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- x + e^{2 x} + 3$. Then $\\\\mathrm{d}u=(2 e^{2 x} - 1)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{2 x} - 1}{- x + e^{2 x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|- x + e^{2 x} + 3\\\\right|+C.\\n$$\"} {:db/id 17592186679518 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 2\\\\right|\\\\right)\" :db/id 17592186679519}] :answer-field/correct {:answer/id #uuid \"ec0420e0-bc5c-5ba5-bc50-0c2ecb853f02\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 2\\\\right|\\\\right)\" :db/id 17592186679519} :answer-field/id #uuid \"cd09eb4b-c664-50f9-8113-b56c9880d85e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679505}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"eaed86d4-f4ba-55c4-8957-65e72c41413d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\cdot 5^{x}}{5^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5^{x} + 2$. Then $\\\\mathrm{d}u=(5^{x} \\\\ln{\\\\left(5 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\cdot 5^{x}}{5^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 2\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"389a48de-ba61-5e04-bb93-b02531e55793\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|- 2 x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186679450}] :answer-field/correct {:answer/id #uuid \"389a48de-ba61-5e04-bb93-b02531e55793\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|- 2 x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186679450} :answer-field/id #uuid \"04943376-ec09-5ee8-a026-2717f0edb9fc\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679425}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f17aa6e6-95fe-551d-a18c-b1c22fb1c92f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=- 2 x + e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x} - 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\ln\\\\left|- 2 x + e^{x} + 3\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186679524 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"cc74a0e7-44e2-5fae-a5db-8d69f134f85d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(2^{x} + 3\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186679504}] :answer-field/correct {:answer/id #uuid \"cc74a0e7-44e2-5fae-a5db-8d69f134f85d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(2^{x} + 3\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186679504} :answer-field/id #uuid \"0db88b23-58cf-5ec3-87d8-e693487a62ba\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186679428}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"fbe42d09-6935-5167-af4a-642732c52ed7\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2^{x} \\\\sqrt{2^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u=\\\\frac{2 u^{\\\\frac{3}{2}}}{3}+C$.\\n\\nWork where $2^{x} + 3>0$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2^{x} + 3$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2^{x} \\\\sqrt{2^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the supplied primitive:\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 u^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(2^{x} + 3\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\"} {:db/id 17592186680406 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"227e2baf-aefe-5678-9f7b-7a5e2eb3728a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680405} {:answer/id #uuid \"7abed499-d15d-5691-aaaa-85e7a0e3fc73\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680422} {:answer/id #uuid \"e3c7da52-301d-5386-8455-24692839dde2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680445} {:answer/id #uuid \"f044088e-2046-5e3e-af43-e898b92ae470\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2 \\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680450} {:answer/id #uuid \"f571a24e-4602-5715-969a-a1a15f4c070c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680452}] :answer-field/correct {:answer/id #uuid \"f571a24e-4602-5715-969a-a1a15f4c070c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680452} :answer-field/id #uuid \"b5621bf7-1f65-5944-973f-a520343836cd\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680436}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"25890b4a-964d-5a74-8a9f-1c35449df460\" :question/problem \"Use the substitution $u=3^{x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3^{x} + 2$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680407 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1b5bcb43-0cca-5c2a-9169-149df94c2031\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2 \\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680403} {:answer/id #uuid \"6ab268ee-2ae3-5fbe-8283-56f32ae93868\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680417} {:answer/id #uuid \"6b541f73-7f28-547b-baa6-850cedf5d969\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3 \\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680418} {:answer/id #uuid \"aef523ca-b642-5b7d-8f92-8a740db76f1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680434} {:answer/id #uuid \"f57dd4d8-7715-5dc5-8a14-92e0d141959f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680453}] :answer-field/correct {:answer/id #uuid \"aef523ca-b642-5b7d-8f92-8a740db76f1c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680434} :answer-field/id #uuid \"b73371d0-8047-5cdf-8d1e-15c6922878c4\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680437}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"2c8bc691-512a-5aa5-b633-0f8327edcf5f\" :question/problem \"Use the substitution $u=3^{x} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=3^{x} + 1$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"04315202-4b2e-5b71-ab88-2d37ace4e04c\" :answer/type {:db/ident :answer.type/math} :answer/value \"9\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680400} {:answer/id #uuid \"15b81dd3-7585-523d-96c2-e29a1cff3dba\" :answer/type {:db/ident :answer.type/math} :answer/value \"-9\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680402} {:answer/id #uuid \"9077d9af-c19c-5951-8b17-424a45362b85\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680427} {:answer/id #uuid \"a09f6fac-8090-5b0c-8011-80d6a322dcc7\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680432} {:answer/id #uuid \"fc533f8b-ec66-5f62-8e3c-cce922930757\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680455}] :answer-field/correct {:answer/id #uuid \"a09f6fac-8090-5b0c-8011-80d6a322dcc7\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680432} :answer-field/id #uuid \"48a942bd-dc12-57e6-bcc3-f84d0102feb3\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680414}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"36946f62-226e-58a3-ab7b-b44073beaec4\" :question/problem \"Use the substitution $u=e^{x} + 3$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680410 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1fdde018-9a73-5735-8501-e5f0878a4905\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2 \\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680404} {:answer/id #uuid \"9881e485-453f-527e-ace8-72a45216ab9d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680430} {:answer/id #uuid \"9d0057d7-6811-5300-bb8e-12df23e30edc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{12}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680431} {:answer/id #uuid \"aa7367ea-c9f5-54e9-8468-64a40a4008bf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680433} {:answer/id #uuid \"be41fe91-37c3-533f-aec2-24f2aa468ae0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{9}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680438}] :answer-field/correct {:answer/id #uuid \"aa7367ea-c9f5-54e9-8468-64a40a4008bf\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680433} :answer-field/id #uuid \"e1e0ea4a-60e4-522f-8ada-49a672eebbd9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680444}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"39aa8900-5518-5435-87c9-6d2e9947a6d6\" :question/problem \"Use the substitution $u=2^{x} + 1$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2^{x} + 1$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680411 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5a6fbd5f-8e02-58c2-88e8-ce00f2b91239\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680415} {:answer/id #uuid \"7b1e6217-2777-5273-8d06-01f7d0bf5a61\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680423} {:answer/id #uuid \"89df1570-9fff-5ced-9faa-89b2b3eb9e9b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680424} {:answer/id #uuid \"c97a82b1-a39e-50d8-803c-0db3b9c17b28\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680439} {:answer/id #uuid \"dfdb3b1b-cf45-52a4-b298-5553fe27d3ed\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680442}] :answer-field/correct {:answer/id #uuid \"7b1e6217-2777-5273-8d06-01f7d0bf5a61\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680423} :answer-field/id #uuid \"8f166a2f-c2ef-5d49-bc29-0e9b10ae4d9b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680426}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"3ee7779f-f74a-5e9b-9262-938b202383ca\" :question/problem \"Use the substitution $u=e^{2 x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0e8dcc25-4724-507c-a309-2e7267b56cee\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680401} {:answer/id #uuid \"6972a4a0-1406-5dcb-a5d9-09ec09c59fdd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int u^{3}\\\\,\\\\mathrm{d}u\" :db/id 17592186680416} {:answer/id #uuid \"75e9de73-4468-5455-b7a2-ca7ad186d125\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680420} {:answer/id #uuid \"796f02d9-fd96-544a-9da2-c7ddadc25a0b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680421} {:answer/id #uuid \"94eba983-99e3-56af-a050-8337640c8cec\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{6}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680429}] :answer-field/correct {:answer/id #uuid \"796f02d9-fd96-544a-9da2-c7ddadc25a0b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680421} :answer-field/id #uuid \"8a2230fc-6dae-5873-8e99-700a44b0a611\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680425}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"402a4ba8-6365-5bcf-8450-bb991e8bc837\" :question/problem \"Use the substitution $u=e^{2 x} + 4$. Which integral is obtained?\\n\\n$$\\n\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 4>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2fdfd8b0-0d18-523c-8385-f1ac8b1024c7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{6}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680408} {:answer/id #uuid \"b3ac4f80-0cd2-5897-8412-23ad1cc87c41\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2 \\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680435} {:answer/id #uuid \"da8cf729-f959-56f8-bb5c-555960568bac\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680440} {:answer/id #uuid \"de5b22ae-7de0-5189-b389-b29788bb087d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{9}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680441} {:answer/id #uuid \"e76c462b-3c11-53e5-b3dd-656c368e9905\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680448}] :answer-field/correct {:answer/id #uuid \"da8cf729-f959-56f8-bb5c-555960568bac\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680440} :answer-field/id #uuid \"738bf61e-a659-5297-be45-e300424876bb\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680419}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"43505f39-47bc-5bcb-a52a-404c18fa49ce\" :question/problem \"Use the substitution $u=2^{x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186680446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"931fae0a-be5b-50d6-8bf9-01afff9557ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"-4\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680428} {:answer/id #uuid \"e679a7d7-f2e6-5da3-9283-306c87c148ad\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680447} {:answer/id #uuid \"ebcbdb55-6206-570a-b6b5-356db1ad0c07\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680449} {:answer/id #uuid \"f2e0827c-1cfb-50cb-8cf1-6070bf28a6fb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int u^{2}\\\\,\\\\mathrm{d}u\" :db/id 17592186680451} {:answer/id #uuid \"fa4a257f-de8c-506e-8b74-5a2a064cacce\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680454}] :answer-field/correct {:answer/id #uuid \"ebcbdb55-6206-570a-b6b5-356db1ad0c07\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186680449} :answer-field/id #uuid \"e07bc310-4638-516b-8bc0-ef976a0ee5af\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186680443}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e65c2cb0-80e2-5a89-a816-79b95b129529\" :question/problem \"Use the substitution $u=e^{2 x} + 2$. Which integral is obtained?\\n\\n$$\\n\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186683158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"905fd618-c8e5-5066-9095-4c108ed45416\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\frac{2 \\\\left(e^{2 x} + 1\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186683183}] :answer-field/correct {:answer/id #uuid \"905fd618-c8e5-5066-9095-4c108ed45416\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\frac{2 \\\\left(e^{2 x} + 1\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186683183} :answer-field/id #uuid \"e7828fb5-201a-567d-8d5e-f194a1d7b755\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683200}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"12253e43-2776-5ace-9c3a-7db8b22905e1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\sqrt{e^{2 x} + 1} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 1>0$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=e^{2 x} + 1$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\sqrt{e^{2 x} + 1} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u=\\\\frac{2 u^{\\\\frac{3}{2}}}{3}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\frac{2 u^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\frac{2 \\\\left(e^{2 x} + 1\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\"} {:db/id 17592186683159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"c1d6dfca-33d1-50d5-b39f-f1e01fad43d5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(2^{x} + 3\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186683191}] :answer-field/correct {:answer/id #uuid \"c1d6dfca-33d1-50d5-b39f-f1e01fad43d5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(2^{x} + 3\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186683191} :answer-field/id #uuid \"f24f102d-1558-5840-92f0-bf6b8e16f958\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683202}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1521ff74-6088-5fc8-ba62-bf6953ac95be\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2^{x} \\\\sqrt{2^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $2^{x} + 3>0$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2^{x} + 3$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2^{x} \\\\sqrt{2^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u=\\\\frac{2 u^{\\\\frac{3}{2}}}{3}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 u^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(2^{x} + 3\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\"} {:db/id 17592186683161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"49a9b07a-8101-5daa-9dc0-f2b02b07afba\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|- 2 x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186683169}] :answer-field/correct {:answer/id #uuid \"49a9b07a-8101-5daa-9dc0-f2b02b07afba\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|- 2 x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186683169} :answer-field/id #uuid \"094192ba-6339-5cb4-b476-c1b5fb56a3ed\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683156}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"15e81c30-60bd-5d53-9d15-12b445c36ff0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=- 2 x + e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x} - 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4 e^{x} - 8}{- 2 x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\ln\\\\left|- 2 x + e^{x} + 3\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683162 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6c1b9b3d-d58f-5014-851d-aa6f45245706\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|e^{x} + 1\\\\right|\\\\right)\" :db/id 17592186683173}] :answer-field/correct {:answer/id #uuid \"6c1b9b3d-d58f-5014-851d-aa6f45245706\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\left(\\\\ln\\\\left|e^{x} + 1\\\\right|\\\\right)\" :db/id 17592186683173} :answer-field/id #uuid \"894a01d5-14e3-54d8-9af8-ce0275f9c54e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683182}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"211ce25f-f7ca-5657-b57d-eb90788744d1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=e^{x} + 1$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4 e^{x}}{e^{x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n4\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=4\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n4\\\\left(\\\\ln\\\\left|e^{x} + 1\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d2603ae0-e396-5aa5-b456-3663f4422741\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|2 x + e^{2 x} + 4\\\\right|\" :db/id 17592186683197}] :answer-field/correct {:answer/id #uuid \"d2603ae0-e396-5aa5-b456-3663f4422741\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|2 x + e^{2 x} + 4\\\\right|\" :db/id 17592186683197} :answer-field/id #uuid \"2eb6bd44-fc4c-520a-92a2-c308b49029ba\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683166}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3022dfa7-5158-57bf-8cb2-acb01878091d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x + e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x} + 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{2 x} + 2}{2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|2 x + e^{2 x} + 4\\\\right|+C.\\n$$\"} {:db/id 17592186683177 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6cb106b4-9166-5e76-b897-a0221fd66210\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|- x + e^{2 x} + 3\\\\right|\" :db/id 17592186683174}] :answer-field/correct {:answer/id #uuid \"6cb106b4-9166-5e76-b897-a0221fd66210\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\ln\\\\left|- x + e^{2 x} + 3\\\\right|\" :db/id 17592186683174} :answer-field/id #uuid \"d247c712-aa40-5b32-ac58-aaf0bad0d94d\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683196}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7733754f-32ed-5e75-bdd1-8972875a7706\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{2 x} - 1}{- x + e^{2 x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=- x + e^{2 x} + 3$. Then $\\\\mathrm{d}u=(2 e^{2 x} - 1)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{2 x} - 1}{- x + e^{2 x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\ln\\\\left|- x + e^{2 x} + 3\\\\right|+C.\\n$$\"} {:db/id 17592186683180 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"600ba5d3-5c66-55d6-947c-678d4ea14e35\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 4\\\\right|\\\\right)\" :db/id 17592186683172}] :answer-field/correct {:answer/id #uuid \"600ba5d3-5c66-55d6-947c-678d4ea14e35\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 4\\\\right|\\\\right)\" :db/id 17592186683172} :answer-field/id #uuid \"7396ae79-8338-5f0d-a117-94c48fe7b2d2\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683176}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"7cc50af0-d932-5993-9c02-08c5170a567c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{5^{x}}{5^{x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=5^{x} + 4$. Then $\\\\mathrm{d}u=(5^{x} \\\\ln{\\\\left(5 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{5^{x}}{5^{x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 4\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6f3aba44-26b5-56d5-b2f5-790ffdc2057f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186683175}] :answer-field/correct {:answer/id #uuid \"6f3aba44-26b5-56d5-b2f5-790ffdc2057f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186683175} :answer-field/id #uuid \"d02975e3-0018-5782-9574-68ecc479127a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683195}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b52c3c92-6c98-5f45-940c-2c918ff5aeb4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2 x + e^{2 x} + 1$. Then $\\\\mathrm{d}u=(2 e^{2 x} + 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 e^{2 x} + 3}{2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\ln\\\\left|2 x + e^{2 x} + 1\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683188 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(2 \\\\sqrt{e^{x} + 3}\\\\right)\" :db/id 17592186683187}] :answer-field/correct {:answer/id #uuid \"b8ee15dd-87e6-5ee7-a52a-800da8ca7fd9\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(2 \\\\sqrt{e^{x} + 3}\\\\right)\" :db/id 17592186683187} :answer-field/id #uuid \"22edb980-938e-55ae-b15d-f2cc64be9e01\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683164}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"bad594e9-e3ea-5f37-bed8-7498761a9628\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 e^{x}}{\\\\sqrt{e^{x} + 3}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{x} + 3>0$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 e^{x}}{\\\\sqrt{e^{x} + 3}}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u=2 \\\\sqrt{u}+C.\\n$$\\n\\n$$\\n3\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(2 \\\\sqrt{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3\\\\left(2 \\\\sqrt{e^{x} + 3}\\\\right)+C.\\n$$\"} {:db/id 17592186683190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7c5bab19-6161-5101-a165-18a3ffd01325\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186683179}] :answer-field/correct {:answer/id #uuid \"7c5bab19-6161-5101-a165-18a3ffd01325\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 3\\\\right|\\\\right)\" :db/id 17592186683179} :answer-field/id #uuid \"09bb2350-c5bd-522f-95e8-6f15ab48eec3\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683157}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"bf388ce7-7f54-566c-b013-28bd33cfcead\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x + e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x} + 1)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 3}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\ln\\\\left|x + e^{x} + 3\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683192 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"bc6c2ae8-6b02-559c-85bd-c3849fdd5eba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 2\\\\right|\\\\right)\" :db/id 17592186683189}] :answer-field/correct {:answer/id #uuid \"bc6c2ae8-6b02-559c-85bd-c3849fdd5eba\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 2\\\\right|\\\\right)\" :db/id 17592186683189} :answer-field/id #uuid \"15c1212f-262c-5037-99c0-082ac53c1a70\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683160}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c46741f4-bd53-5442-a723-dfe845118a09\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\cdot 5^{x}}{5^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=5^{x} + 2$. Then $\\\\mathrm{d}u=(5^{x} \\\\ln{\\\\left(5 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\cdot 5^{x}}{5^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(5 \\\\right)}}\\\\left(\\\\ln\\\\left|5^{x} + 2\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2e9d78fb-a66d-5f27-8397-38c25eadc86e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{2^{x} + 2}\\\\right)\" :db/id 17592186683165}] :answer-field/correct {:answer/id #uuid \"2e9d78fb-a66d-5f27-8397-38c25eadc86e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{2^{x} + 2}\\\\right)\" :db/id 17592186683165} :answer-field/id #uuid \"aa3a3b0b-97aa-5c57-9ff8-8ddfce24fd32\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683184}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c8da8569-d026-552c-bc62-7ded1a3b3820\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cdot 2^{x}}{\\\\sqrt{2^{x} + 2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $2^{x} + 2>0$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cdot 2^{x}}{\\\\sqrt{2^{x} + 2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u=2 \\\\sqrt{u}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int \\\\frac{1}{\\\\sqrt{u}}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{u}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(2 \\\\sqrt{2^{x} + 2}\\\\right)+C.\\n$$\"} {:db/id 17592186683198 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7a0df22d-2c7c-5778-875d-d7e3c17f496b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(3^{x} + 4\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186683178}] :answer-field/correct {:answer/id #uuid \"7a0df22d-2c7c-5778-875d-d7e3c17f496b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(3^{x} + 4\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)\" :db/id 17592186683178} :answer-field/id #uuid \"57ddf01a-f4b7-53a2-beda-c85868fc3d10\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683170}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"d2c1b3c9-c97f-5f96-b1e6-8c1a8a5d5166\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\cdot 3^{x} \\\\sqrt{3^{x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $3^{x} + 4>0$.\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=3^{x} + 4$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 4>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\cdot 3^{x} \\\\sqrt{3^{x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u=\\\\frac{2 u^{\\\\frac{3}{2}}}{3}+C.\\n$$\\n\\n$$\\n\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int \\\\sqrt{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 u^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{4}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{2 \\\\left(3^{x} + 4\\\\right)^{\\\\frac{3}{2}}}{3}\\\\right)+C.\\n$$\"} {:db/id 17592186683199 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"21b31637-5205-50a3-98dd-7d0d6175cdbc\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 2\\\\right|\\\\right)\" :db/id 17592186683163}] :answer-field/correct {:answer/id #uuid \"21b31637-5205-50a3-98dd-7d0d6175cdbc\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|x + e^{x} + 2\\\\right|\\\\right)\" :db/id 17592186683163} :answer-field/id #uuid \"b75bbeac-83f2-584c-b186-6fc256c87f58\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683186}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"d4db5818-aab2-534d-93ef-f6f93f256024\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x + e^{x} + 2$. Then $\\\\mathrm{d}u=(e^{x} + 1)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 e^{x} + 2}{x + e^{x} + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\ln\\\\left|x + e^{x} + 2\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683201 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3443c4e8-9ce4-58d8-843e-6e10fc77e9b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186683168}] :answer-field/correct {:answer/id #uuid \"3443c4e8-9ce4-58d8-843e-6e10fc77e9b1\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 1\\\\right|\\\\right)\" :db/id 17592186683168} :answer-field/id #uuid \"cbc5d4cf-026c-5133-a17d-3bcf4930415a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683194}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"ee45ef5e-78b7-56c2-8a70-c5b3e11ebd85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{4 e^{2 x} - 4}{- 2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=- 2 x + e^{2 x} + 1$. Then $\\\\mathrm{d}u=(2 e^{2 x} - 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{4 e^{2 x} - 4}{- 2 x + e^{2 x} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 1\\\\right|\\\\right)+C.\\n$$\"} {:db/id 17592186683203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8479c2d6-a87d-502b-bf23-37b341449923\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 4\\\\right|\\\\right)\" :db/id 17592186683181}] :answer-field/correct {:answer/id #uuid \"8479c2d6-a87d-502b-bf23-37b341449923\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 4\\\\right|\\\\right)\" :db/id 17592186683181} :answer-field/id #uuid \"5bd35909-9f12-5709-aad6-653896cfcde3\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186683171}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f9aade53-c709-509d-8dd5-b965ca84727d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{e^{2 x} - 1}{- 2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=- 2 x + e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x} - 2)\\\\,\\\\mathrm{d}x$.\\n\\nUse a connected real interval on which the integrand is defined.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{e^{2 x} - 1}{- 2 x + e^{2 x} + 4}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u=\\\\ln\\\\left|u\\\\right|+C.\\n$$\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\frac{1}{u}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|u\\\\right|\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\ln\\\\left|- 2 x + e^{2 x} + 4\\\\right|\\\\right)+C.\\n$$\"}] :knowledge-point/title \"More Complex Cases\"}",
