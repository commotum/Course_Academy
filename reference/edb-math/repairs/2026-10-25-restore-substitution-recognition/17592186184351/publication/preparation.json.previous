  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/id #uuid \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\"] [:db/add \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/type :answer.type/math] [:db/add \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 3\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/validate] [:db/add \"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/id #uuid \"b5538129-1177-5a16-919e-da3d33eabd99\"] [:db/add \"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/type :answer.type/math] [:db/add \"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/value \"\\\\frac{3 x^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/validate] [:db/add \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/id #uuid \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\"] [:db/add \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/type :answer.type/math] [:db/add \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 2\\\\right)^{4}}{8 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/validate] [:db/add \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/id #uuid \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\"] [:db/add \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/type :answer.type/math] [:db/add \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/value \"\\\\frac{3 \\\\left(2 \\\\cdot 2^{x} + 4\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/validate] [:db/add \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/id #uuid \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\"] [:db/add \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/type :answer.type/math] [:db/add \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 2\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/validate] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/id #uuid \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/key \"answer\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/type :answer-field.type/radio] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"b5538129-1177-5a16-919e-da3d33eabd99\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\"] [:db/add \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/correct \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\"] [:db/ensure \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/validate] [:db/add \"e632c680-496e-59ea-95dc-16067a645516\" :question/id #uuid \"e632c680-496e-59ea-95dc-16067a645516\"] [:db/add \"e632c680-496e-59ea-95dc-16067a645516\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $2^{x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e632c680-496e-59ea-95dc-16067a645516\" :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{3}\\\\,\\\\mathrm{d}u=\\\\frac{u^{4}}{4}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{u^{4}}{4}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\left(2^{x} + 2\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\"] [:db/add \"e632c680-496e-59ea-95dc-16067a645516\" :question/difficulty :question.difficulty/easy] [:db/add \"e632c680-496e-59ea-95dc-16067a645516\" :question/answer-fields \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\"] [:db/ensure \"e632c680-496e-59ea-95dc-16067a645516\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"e632c680-496e-59ea-95dc-16067a645516\"] [:db/add \"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/id #uuid \"798f2c0d-946b-594c-97a2-b666ec6d970e\"] [:db/add \"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/type :answer.type/math] [:db/add \"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/value \"\\\\left(e^{x} + 4\\\\right)^{3}+C\"] [:db/ensure \"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/validate] [:db/add \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/id #uuid \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\"] [:db/add \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/type :answer.type/math] [:db/add \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/value \"- 2 \\\\left(e^{x} + 3\\\\right)^{3}+C\"] [:db/ensure \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/validate] [:db/add \"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/id #uuid \"707d18cb-1f1b-5c21-815e-6db05d6fa575\"] [:db/add \"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/type :answer.type/math] [:db/add \"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/value \"e^{x} + 3+C\"] [:db/ensure \"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/validate] [:db/add \"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/id #uuid \"c1e0bc34-447f-5312-8981-2073aff34c15\"] [:db/add \"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/type :answer.type/math] [:db/add \"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/value \"\\\\left(e^{x} + 3\\\\right)^{3}+C\"] [:db/ensure \"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/validate] [:db/add \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/id #uuid \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\"] [:db/add \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/type :answer.type/math] [:db/add \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/value \"x^{3}+C\"] [:db/ensure \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/validate] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/id #uuid \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/key \"answer\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/type :answer-field.type/radio] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"798f2c0d-946b-594c-97a2-b666ec6d970e\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"707d18cb-1f1b-5c21-815e-6db05d6fa575\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"c1e0bc34-447f-5312-8981-2073aff34c15\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\"] [:db/add \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/correct \"c1e0bc34-447f-5312-8981-2073aff34c15\"] [:db/ensure \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/validate] [:db/add \"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/id #uuid \"c09dc904-67bc-5850-bb34-0c0ff6836057\"] [:db/add \"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{x} + 3>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/worked-solution \"Let $u=e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\left(e^{x} + 3\\\\right)^{3}+C.\\n$$\"] [:db/add \"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/difficulty :question.difficulty/easy] [:db/add \"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/answer-fields \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\"] [:db/ensure \"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"c09dc904-67bc-5850-bb34-0c0ff6836057\"] [:db/add \"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/id #uuid \"ace9b886-4650-5632-bfd8-03753da66c78\"] [:db/add \"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/type :answer.type/math] [:db/add \"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{9 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/validate] [:db/add \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/id #uuid \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\"] [:db/add \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/type :answer.type/math] [:db/add \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/value \"\\\\frac{2 \\\\left(\\\\frac{3^{x}}{2} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/validate] [:db/add \"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/id #uuid \"c176422a-2c97-5912-ba83-e91f41daa7a0\"] [:db/add \"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/type :answer.type/math] [:db/add \"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 3\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/validate] [:db/add \"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/id #uuid \"1cf11729-1f4f-5980-825d-98526ca7719c\"] [:db/add \"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/type :answer.type/math] [:db/add \"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/value \"\\\\frac{2 \\\\left(2 \\\\cdot 3^{x} + 4\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/validate] [:db/add \"f40b8ada-c523-5b48-943e-03185658d715\" :answer/id #uuid \"f40b8ada-c523-5b48-943e-03185658d715\"] [:db/add \"f40b8ada-c523-5b48-943e-03185658d715\" :answer/type :answer.type/math] [:db/add \"f40b8ada-c523-5b48-943e-03185658d715\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"f40b8ada-c523-5b48-943e-03185658d715\" :answer/validate] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/id #uuid \"5c568666-f41c-5477-be0f-bec79adf21c3\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/key \"answer\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/type :answer-field.type/radio] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"ace9b886-4650-5632-bfd8-03753da66c78\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"c176422a-2c97-5912-ba83-e91f41daa7a0\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"1cf11729-1f4f-5980-825d-98526ca7719c\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"f40b8ada-c523-5b48-943e-03185658d715\"] [:db/add \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/correct \"f40b8ada-c523-5b48-943e-03185658d715\"] [:db/ensure \"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/validate] [:db/add \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/id #uuid \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\"] [:db/add \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $3^{x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/worked-solution \"Let $u=3^{x} + 2$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C.\\n$$\"] [:db/add \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/difficulty :question.difficulty/easy] [:db/add \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/answer-fields \"5c568666-f41c-5477-be0f-bec79adf21c3\"] [:db/ensure \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\"] [:db/add \"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/id #uuid \"6d2bea10-b41d-5d58-b32c-47deebda1403\"] [:db/add \"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/type :answer.type/math] [:db/add \"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/value \"\\\\frac{2 \\\\left(\\\\frac{e^{2 x}}{2} + 1\\\\right)^{3}}{3}+C\"] [:db/ensure \"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/validate] [:db/add \"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/id #uuid \"7d9f7646-747c-5619-913c-0411ccf56249\"] [:db/add \"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/type :answer.type/math] [:db/add \"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/value \"- \\\\frac{4 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [:db/ensure \"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/validate] [:db/add \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/id #uuid \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\"] [:db/add \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/type :answer.type/math] [:db/add \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/value \"\\\\frac{2 \\\\left(e^{2 x} + 3\\\\right)^{3}}{3}+C\"] [:db/ensure \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/validate] [:db/add \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/id #uuid \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\"] [:db/add \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/type :answer.type/math] [:db/add \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [:db/ensure \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/validate] [:db/add \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/id #uuid \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\"] [:db/add \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/type :answer.type/math] [:db/add \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/value \"\\\\frac{2 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [:db/ensure \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/validate] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/id #uuid \"99572807-ec4d-5813-adf9-c6d7e6a2268f\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/key \"answer\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/type :answer-field.type/radio] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"6d2bea10-b41d-5d58-b32c-47deebda1403\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"7d9f7646-747c-5619-913c-0411ccf56249\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\"] [:db/add \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/correct \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\"] [:db/ensure \"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/validate] [:db/add \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/id #uuid \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\"] [:db/add \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C.\\n$$\"] [:db/add \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/difficulty :question.difficulty/easy] [:db/add \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/answer-fields \"99572807-ec4d-5813-adf9-c6d7e6a2268f\"] [:db/ensure \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\"] [:db/add \"34ba3174-d278-556e-bae3-0129792545ed\" :answer/id #uuid \"34ba3174-d278-556e-bae3-0129792545ed\"] [:db/add \"34ba3174-d278-556e-bae3-0129792545ed\" :answer/type :answer.type/math] [:db/add \"34ba3174-d278-556e-bae3-0129792545ed\" :answer/value \"2^{x} + 1+C\"] [:db/ensure \"34ba3174-d278-556e-bae3-0129792545ed\" :answer/validate] [:db/add \"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/id #uuid \"158c887d-2a05-5e83-a9aa-f2adf65f80af\"] [:db/add \"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/type :answer.type/math] [:db/add \"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/validate] [:db/add \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/id #uuid \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\"] [:db/add \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/type :answer.type/math] [:db/add \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/value \"\\\\frac{3 x^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/validate] [:db/add \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/id #uuid \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\"] [:db/add \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/type :answer.type/math] [:db/add \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/value \"- \\\\frac{3 \\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/validate] [:db/add \"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/id #uuid \"91cc9846-7751-54c0-adfb-3fb60a586169\"] [:db/add \"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/type :answer.type/math] [:db/add \"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/value \"\\\\frac{\\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [:db/ensure \"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/validate] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/id #uuid \"d1c8911f-8364-5b23-94ca-92daef001437\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/key \"answer\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/type :answer-field.type/radio] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"34ba3174-d278-556e-bae3-0129792545ed\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"158c887d-2a05-5e83-a9aa-f2adf65f80af\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"91cc9846-7751-54c0-adfb-3fb60a586169\"] [:db/add \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/correct \"158c887d-2a05-5e83-a9aa-f2adf65f80af\"] [:db/ensure \"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/validate] [:db/add \"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/id #uuid \"5e9c245f-c237-585a-b2f6-6b621446ab85\"] [:db/add \"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $2^{x} + 1>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/worked-solution \"Let $u=2^{x} + 1$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{3}\\\\,\\\\mathrm{d}u=\\\\frac{u^{4}}{4}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{u^{4}}{4}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\"] [:db/add \"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/difficulty :question.difficulty/easy] [:db/add \"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/answer-fields \"d1c8911f-8364-5b23-94ca-92daef001437\"] [:db/ensure \"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"5e9c245f-c237-585a-b2f6-6b621446ab85\"] [:db/add \"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/id #uuid \"2ae4c1d8-05e1-5413-8181-2be437299426\"] [:db/add \"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/type :answer.type/math] [:db/add \"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/value \"\\\\frac{3 \\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C\"] [:db/ensure \"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/validate] [:db/add \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/id #uuid \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\"] [:db/add \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/type :answer.type/math] [:db/add \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C\"] [:db/ensure \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/validate] [:db/add \"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/id #uuid \"8103239e-21d1-5997-b7eb-cce643201dde\"] [:db/add \"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/type :answer.type/math] [:db/add \"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 5\\\\right)^{4}}{8}+C\"] [:db/ensure \"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/validate] [:db/add \"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/id #uuid \"7533bd9a-1b1b-58dc-8985-722a3bd21597\"] [:db/add \"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/type :answer.type/math] [:db/add \"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/value \"- \\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C\"] [:db/ensure \"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/validate] [:db/add \"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/id #uuid \"6a27f733-9117-501e-969a-81a4873efb1e\"] [:db/add \"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/type :answer.type/math] [:db/add \"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/value \"- \\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{4}+C\"] [:db/ensure \"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/validate] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/id #uuid \"8603834b-8a24-549d-a055-f327fe182904\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/key \"answer\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/type :answer-field.type/radio] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"2ae4c1d8-05e1-5413-8181-2be437299426\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"8103239e-21d1-5997-b7eb-cce643201dde\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"7533bd9a-1b1b-58dc-8985-722a3bd21597\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"6a27f733-9117-501e-969a-81a4873efb1e\"] [:db/add \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/correct \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\"] [:db/ensure \"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/validate] [:db/add \"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/id #uuid \"abc12ec6-aea6-5814-a2ae-777b12316714\"] [:db/add \"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 4>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/worked-solution \"Let $u=e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 4>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{3}\\\\,\\\\mathrm{d}u=\\\\frac{u^{4}}{4}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\frac{u^{4}}{4}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C.\\n$$\"] [:db/add \"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/difficulty :question.difficulty/easy] [:db/add \"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/answer-fields \"8603834b-8a24-549d-a055-f327fe182904\"] [:db/ensure \"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"abc12ec6-aea6-5814-a2ae-777b12316714\"] [:db/add \"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/id #uuid \"f76158f7-1c19-5899-a6e7-286a0fefedc0\"] [:db/add \"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/type :answer.type/math] [:db/add \"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/value \"\\\\frac{4 \\\\left(3^{x} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/validate] [:db/add \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/id #uuid \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\"] [:db/add \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/type :answer.type/math] [:db/add \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/value \"3^{x} + 1+C\"] [:db/ensure \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/validate] [:db/add \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/id #uuid \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\"] [:db/add \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/type :answer.type/math] [:db/add \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 1\\\\right)^{3}}{9 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/validate] [:db/add \"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/id #uuid \"f3214313-3558-5487-a951-6a0ced2c15d3\"] [:db/add \"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/type :answer.type/math] [:db/add \"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/validate] [:db/add \"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/id #uuid \"e0a7c18a-ff61-5903-9926-67764b54250d\"] [:db/add \"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/type :answer.type/math] [:db/add \"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [:db/ensure \"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/validate] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/id #uuid \"5f78e393-ac56-5a9d-bcaf-676a4650d649\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/key \"answer\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/type :answer-field.type/radio] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"f76158f7-1c19-5899-a6e7-286a0fefedc0\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"f3214313-3558-5487-a951-6a0ced2c15d3\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"e0a7c18a-ff61-5903-9926-67764b54250d\"] [:db/add \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/correct \"e0a7c18a-ff61-5903-9926-67764b54250d\"] [:db/ensure \"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/validate] [:db/add \"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/id #uuid \"c298eccc-ebbf-57ce-b804-ed8499873e4e\"] [:db/add \"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $3^{x} + 1>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/worked-solution \"Let $u=3^{x} + 1$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\left(3^{x} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C.\\n$$\"] [:db/add \"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/difficulty :question.difficulty/easy] [:db/add \"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/answer-fields \"5f78e393-ac56-5a9d-bcaf-676a4650d649\"] [:db/ensure \"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"c298eccc-ebbf-57ce-b804-ed8499873e4e\"] [:db/add \"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/id #uuid \"bed8f85e-5751-57b6-8b59-45c374fddbdf\"] [:db/add \"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/type :answer.type/math] [:db/add \"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [:db/ensure \"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/validate] [:db/add \"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/id #uuid \"fc37f787-7179-5125-901d-f8b29c9ad6de\"] [:db/add \"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/type :answer.type/math] [:db/add \"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/value \"\\\\left(e^{2 x} + 2\\\\right)^{3}+C\"] [:db/ensure \"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/validate] [:db/add \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/id #uuid \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\"] [:db/add \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/type :answer.type/math] [:db/add \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/value \"\\\\frac{\\\\left(\\\\frac{e^{2 x}}{2} + 1\\\\right)^{3}}{3}+C\"] [:db/ensure \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/validate] [:db/add \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/id #uuid \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\"] [:db/add \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/type :answer.type/math] [:db/add \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/value \"\\\\frac{x^{3}}{3}+C\"] [:db/ensure \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/validate] [:db/add \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/id #uuid \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\"] [:db/add \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/type :answer.type/math] [:db/add \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/value \"\\\\frac{2 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [:db/ensure \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/validate] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/id #uuid \"0fc5b778-5744-5c25-a311-fbbf0587882b\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/key \"answer\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/type :answer-field.type/radio] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"bed8f85e-5751-57b6-8b59-45c374fddbdf\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"fc37f787-7179-5125-901d-f8b29c9ad6de\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\"] [:db/add \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/correct \"bed8f85e-5751-57b6-8b59-45c374fddbdf\"] [:db/ensure \"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/validate] [:db/add \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/id #uuid \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\"] [:db/add \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int u^{2}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C.\\n$$\"] [:db/add \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/difficulty :question.difficulty/easy] [:db/add \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/answer-fields \"0fc5b778-5744-5c25-a311-fbbf0587882b\"] [:db/ensure \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/validate] [:db/add 17592186184351 :knowledge-point/questions \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\"] [:db/add \"generator\" :question-generator/id #uuid \"6814898e-6d38-54e0-8336-3b6c8123cc26\"] [:db/add \"generator\" :question-generator/script \"generators/15/150f4e52d85b0b991b99f9213eac68a07b999c6b9d1d142044b63f49c0891e8d/generator.py\"] [:db/add 17592186184351 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186184351 :knowledge-point/validate]] \"assertions\" [[\"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/id #uuid \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\"] [\"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/type :answer.type/math] [\"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 3\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/id #uuid \"b5538129-1177-5a16-919e-da3d33eabd99\"] [\"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/type :answer.type/math] [\"b5538129-1177-5a16-919e-da3d33eabd99\" :answer/value \"\\\\frac{3 x^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/id #uuid \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\"] [\"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/type :answer.type/math] [\"0f93cf91-7d11-52d5-a2fc-0e0531f973da\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 2\\\\right)^{4}}{8 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/id #uuid \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\"] [\"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/type :answer.type/math] [\"b0836ea4-5d14-5ed9-a014-2f4a9996e963\" :answer/value \"\\\\frac{3 \\\\left(2 \\\\cdot 2^{x} + 4\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/id #uuid \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\"] [\"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/type :answer.type/math] [\"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 2\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/id #uuid \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/key \"answer\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/type :answer-field.type/radio] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"a9f5d3bd-0470-517f-8bef-751fdeaa3f8e\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"b5538129-1177-5a16-919e-da3d33eabd99\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"0f93cf91-7d11-52d5-a2fc-0e0531f973da\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"b0836ea4-5d14-5ed9-a014-2f4a9996e963\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/choices \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\"] [\"cd4664af-8834-5e8c-9a7d-5d024d93d71e\" :answer-field/correct \"5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca\"] [\"e632c680-496e-59ea-95dc-16067a645516\" :question/id #uuid \"e632c680-496e-59ea-95dc-16067a645516\"] [\"e632c680-496e-59ea-95dc-16067a645516\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $2^{x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e632c680-496e-59ea-95dc-16067a645516\" :question/worked-solution \"Let $u=2^{x} + 2$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 2\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{3}\\\\,\\\\mathrm{d}u=\\\\frac{u^{4}}{4}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{u^{4}}{4}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\left(2^{x} + 2\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\"] [\"e632c680-496e-59ea-95dc-16067a645516\" :question/difficulty :question.difficulty/easy] [\"e632c680-496e-59ea-95dc-16067a645516\" :question/answer-fields \"cd4664af-8834-5e8c-9a7d-5d024d93d71e\"] [17592186184351 :knowledge-point/questions \"e632c680-496e-59ea-95dc-16067a645516\"] [\"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/id #uuid \"798f2c0d-946b-594c-97a2-b666ec6d970e\"] [\"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/type :answer.type/math] [\"798f2c0d-946b-594c-97a2-b666ec6d970e\" :answer/value \"\\\\left(e^{x} + 4\\\\right)^{3}+C\"] [\"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/id #uuid \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\"] [\"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/type :answer.type/math] [\"c1941f07-17ec-5fbc-8a17-1642ef1d1903\" :answer/value \"- 2 \\\\left(e^{x} + 3\\\\right)^{3}+C\"] [\"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/id #uuid \"707d18cb-1f1b-5c21-815e-6db05d6fa575\"] [\"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/type :answer.type/math] [\"707d18cb-1f1b-5c21-815e-6db05d6fa575\" :answer/value \"e^{x} + 3+C\"] [\"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/id #uuid \"c1e0bc34-447f-5312-8981-2073aff34c15\"] [\"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/type :answer.type/math] [\"c1e0bc34-447f-5312-8981-2073aff34c15\" :answer/value \"\\\\left(e^{x} + 3\\\\right)^{3}+C\"] [\"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/id #uuid \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\"] [\"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/type :answer.type/math] [\"ea7b9a66-c24d-59d3-9f31-236b89a7386f\" :answer/value \"x^{3}+C\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/id #uuid \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/key \"answer\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/type :answer-field.type/radio] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"798f2c0d-946b-594c-97a2-b666ec6d970e\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"c1941f07-17ec-5fbc-8a17-1642ef1d1903\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"707d18cb-1f1b-5c21-815e-6db05d6fa575\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"c1e0bc34-447f-5312-8981-2073aff34c15\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/choices \"ea7b9a66-c24d-59d3-9f31-236b89a7386f\"] [\"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\" :answer-field/correct \"c1e0bc34-447f-5312-8981-2073aff34c15\"] [\"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/id #uuid \"c09dc904-67bc-5850-bb34-0c0ff6836057\"] [\"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{x} + 3>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/worked-solution \"Let $u=e^{x} + 3$. Then $\\\\mathrm{d}u=(e^{x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{x} + 3>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\left(e^{x} + 3\\\\right)^{2} e^{x}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n3\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=3\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\left(e^{x} + 3\\\\right)^{3}+C.\\n$$\"] [\"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/difficulty :question.difficulty/easy] [\"c09dc904-67bc-5850-bb34-0c0ff6836057\" :question/answer-fields \"e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53\"] [17592186184351 :knowledge-point/questions \"c09dc904-67bc-5850-bb34-0c0ff6836057\"] [\"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/id #uuid \"ace9b886-4650-5632-bfd8-03753da66c78\"] [\"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/type :answer.type/math] [\"ace9b886-4650-5632-bfd8-03753da66c78\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{9 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/id #uuid \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\"] [\"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/type :answer.type/math] [\"8a6e4009-bca4-5468-ae4c-1d84b1783b01\" :answer/value \"\\\\frac{2 \\\\left(\\\\frac{3^{x}}{2} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/id #uuid \"c176422a-2c97-5912-ba83-e91f41daa7a0\"] [\"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/type :answer.type/math] [\"c176422a-2c97-5912-ba83-e91f41daa7a0\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 3\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/id #uuid \"1cf11729-1f4f-5980-825d-98526ca7719c\"] [\"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/type :answer.type/math] [\"1cf11729-1f4f-5980-825d-98526ca7719c\" :answer/value \"\\\\frac{2 \\\\left(2 \\\\cdot 3^{x} + 4\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"f40b8ada-c523-5b48-943e-03185658d715\" :answer/id #uuid \"f40b8ada-c523-5b48-943e-03185658d715\"] [\"f40b8ada-c523-5b48-943e-03185658d715\" :answer/type :answer.type/math] [\"f40b8ada-c523-5b48-943e-03185658d715\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/id #uuid \"5c568666-f41c-5477-be0f-bec79adf21c3\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/key \"answer\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/type :answer-field.type/radio] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"ace9b886-4650-5632-bfd8-03753da66c78\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"8a6e4009-bca4-5468-ae4c-1d84b1783b01\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"c176422a-2c97-5912-ba83-e91f41daa7a0\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"1cf11729-1f4f-5980-825d-98526ca7719c\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/choices \"f40b8ada-c523-5b48-943e-03185658d715\"] [\"5c568666-f41c-5477-be0f-bec79adf21c3\" :answer-field/correct \"f40b8ada-c523-5b48-943e-03185658d715\"] [\"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/id #uuid \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\"] [\"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $3^{x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/worked-solution \"Let $u=3^{x} + 2$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 2\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C.\\n$$\"] [\"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/difficulty :question.difficulty/easy] [\"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\" :question/answer-fields \"5c568666-f41c-5477-be0f-bec79adf21c3\"] [17592186184351 :knowledge-point/questions \"bfb8dc7a-8efe-5c10-8f98-d40a62827a4c\"] [\"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/id #uuid \"6d2bea10-b41d-5d58-b32c-47deebda1403\"] [\"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/type :answer.type/math] [\"6d2bea10-b41d-5d58-b32c-47deebda1403\" :answer/value \"\\\\frac{2 \\\\left(\\\\frac{e^{2 x}}{2} + 1\\\\right)^{3}}{3}+C\"] [\"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/id #uuid \"7d9f7646-747c-5619-913c-0411ccf56249\"] [\"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/type :answer.type/math] [\"7d9f7646-747c-5619-913c-0411ccf56249\" :answer/value \"- \\\\frac{4 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [\"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/id #uuid \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\"] [\"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/type :answer.type/math] [\"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\" :answer/value \"\\\\frac{2 \\\\left(e^{2 x} + 3\\\\right)^{3}}{3}+C\"] [\"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/id #uuid \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\"] [\"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/type :answer.type/math] [\"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [\"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/id #uuid \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\"] [\"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/type :answer.type/math] [\"722dfd7f-17e8-597d-b89c-441c0a48ef0e\" :answer/value \"\\\\frac{2 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/id #uuid \"99572807-ec4d-5813-adf9-c6d7e6a2268f\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/key \"answer\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/type :answer-field.type/radio] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"6d2bea10-b41d-5d58-b32c-47deebda1403\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"7d9f7646-747c-5619-913c-0411ccf56249\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"284b327f-6f48-5ecb-8eb4-e2c368f0c8c5\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"1933d5bb-cd61-5d51-ad59-c58ce3954a6d\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/choices \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\"] [\"99572807-ec4d-5813-adf9-c6d7e6a2268f\" :answer-field/correct \"722dfd7f-17e8-597d-b89c-441c0a48ef0e\"] [\"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/id #uuid \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\"] [\"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 4 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n2\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=2\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C.\\n$$\"] [\"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/difficulty :question.difficulty/easy] [\"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\" :question/answer-fields \"99572807-ec4d-5813-adf9-c6d7e6a2268f\"] [17592186184351 :knowledge-point/questions \"ae4bd4cd-5e1a-530d-9800-bd478ae2d890\"] [\"34ba3174-d278-556e-bae3-0129792545ed\" :answer/id #uuid \"34ba3174-d278-556e-bae3-0129792545ed\"] [\"34ba3174-d278-556e-bae3-0129792545ed\" :answer/type :answer.type/math] [\"34ba3174-d278-556e-bae3-0129792545ed\" :answer/value \"2^{x} + 1+C\"] [\"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/id #uuid \"158c887d-2a05-5e83-a9aa-f2adf65f80af\"] [\"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/type :answer.type/math] [\"158c887d-2a05-5e83-a9aa-f2adf65f80af\" :answer/value \"\\\\frac{3 \\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/id #uuid \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\"] [\"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/type :answer.type/math] [\"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\" :answer/value \"\\\\frac{3 x^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/id #uuid \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\"] [\"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/type :answer.type/math] [\"92e8e858-060c-5d3d-a37a-802a13d7d0bf\" :answer/value \"- \\\\frac{3 \\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/id #uuid \"91cc9846-7751-54c0-adfb-3fb60a586169\"] [\"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/type :answer.type/math] [\"91cc9846-7751-54c0-adfb-3fb60a586169\" :answer/value \"\\\\frac{\\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/id #uuid \"d1c8911f-8364-5b23-94ca-92daef001437\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/key \"answer\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/type :answer-field.type/radio] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"34ba3174-d278-556e-bae3-0129792545ed\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"158c887d-2a05-5e83-a9aa-f2adf65f80af\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"86b40a74-a9d7-58a2-ac0b-f69e0a1a83d1\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"92e8e858-060c-5d3d-a37a-802a13d7d0bf\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/choices \"91cc9846-7751-54c0-adfb-3fb60a586169\"] [\"d1c8911f-8364-5b23-94ca-92daef001437\" :answer-field/correct \"158c887d-2a05-5e83-a9aa-f2adf65f80af\"] [\"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/id #uuid \"5e9c245f-c237-585a-b2f6-6b621446ab85\"] [\"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $2^{x} + 1>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/worked-solution \"Let $u=2^{x} + 1$. Then $\\\\mathrm{d}u=(2^{x} \\\\ln{\\\\left(2 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $2^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 \\\\cdot 2^{x} \\\\left(2^{x} + 1\\\\right)^{3}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{3}\\\\,\\\\mathrm{d}u=\\\\frac{u^{4}}{4}+C.\\n$$\\n\\n$$\\n\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3}{\\\\ln{\\\\left(2 \\\\right)}}\\\\left(\\\\frac{u^{4}}{4}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\left(2^{x} + 1\\\\right)^{4}}{4 \\\\ln{\\\\left(2 \\\\right)}}+C.\\n$$\"] [\"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/difficulty :question.difficulty/easy] [\"5e9c245f-c237-585a-b2f6-6b621446ab85\" :question/answer-fields \"d1c8911f-8364-5b23-94ca-92daef001437\"] [17592186184351 :knowledge-point/questions \"5e9c245f-c237-585a-b2f6-6b621446ab85\"] [\"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/id #uuid \"2ae4c1d8-05e1-5413-8181-2be437299426\"] [\"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/type :answer.type/math] [\"2ae4c1d8-05e1-5413-8181-2be437299426\" :answer/value \"\\\\frac{3 \\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C\"] [\"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/id #uuid \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\"] [\"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/type :answer.type/math] [\"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C\"] [\"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/id #uuid \"8103239e-21d1-5997-b7eb-cce643201dde\"] [\"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/type :answer.type/math] [\"8103239e-21d1-5997-b7eb-cce643201dde\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 5\\\\right)^{4}}{8}+C\"] [\"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/id #uuid \"7533bd9a-1b1b-58dc-8985-722a3bd21597\"] [\"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/type :answer.type/math] [\"7533bd9a-1b1b-58dc-8985-722a3bd21597\" :answer/value \"- \\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C\"] [\"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/id #uuid \"6a27f733-9117-501e-969a-81a4873efb1e\"] [\"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/type :answer.type/math] [\"6a27f733-9117-501e-969a-81a4873efb1e\" :answer/value \"- \\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{4}+C\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/id #uuid \"8603834b-8a24-549d-a055-f327fe182904\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/key \"answer\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/type :answer-field.type/radio] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"2ae4c1d8-05e1-5413-8181-2be437299426\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"8103239e-21d1-5997-b7eb-cce643201dde\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"7533bd9a-1b1b-58dc-8985-722a3bd21597\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/choices \"6a27f733-9117-501e-969a-81a4873efb1e\"] [\"8603834b-8a24-549d-a055-f327fe182904\" :answer-field/correct \"1e0a393c-8e34-5b6d-aa05-45ca9ccc4fd4\"] [\"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/id #uuid \"abc12ec6-aea6-5814-a2ae-777b12316714\"] [\"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 4>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/worked-solution \"Let $u=e^{2 x} + 4$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 4>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\left(e^{2 x} + 4\\\\right)^{3} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{3}\\\\,\\\\mathrm{d}u=\\\\frac{u^{4}}{4}+C.\\n$$\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int u^{3}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{1}{2}\\\\left(\\\\frac{u^{4}}{4}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\left(e^{2 x} + 4\\\\right)^{4}}{8}+C.\\n$$\"] [\"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/difficulty :question.difficulty/easy] [\"abc12ec6-aea6-5814-a2ae-777b12316714\" :question/answer-fields \"8603834b-8a24-549d-a055-f327fe182904\"] [17592186184351 :knowledge-point/questions \"abc12ec6-aea6-5814-a2ae-777b12316714\"] [\"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/id #uuid \"f76158f7-1c19-5899-a6e7-286a0fefedc0\"] [\"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/type :answer.type/math] [\"f76158f7-1c19-5899-a6e7-286a0fefedc0\" :answer/value \"\\\\frac{4 \\\\left(3^{x} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/id #uuid \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\"] [\"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/type :answer.type/math] [\"4c56d3f7-b5db-5c2f-9111-de972742e4ef\" :answer/value \"3^{x} + 1+C\"] [\"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/id #uuid \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\"] [\"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/type :answer.type/math] [\"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 1\\\\right)^{3}}{9 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/id #uuid \"f3214313-3558-5487-a951-6a0ced2c15d3\"] [\"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/type :answer.type/math] [\"f3214313-3558-5487-a951-6a0ced2c15d3\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 2\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/id #uuid \"e0a7c18a-ff61-5903-9926-67764b54250d\"] [\"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/type :answer.type/math] [\"e0a7c18a-ff61-5903-9926-67764b54250d\" :answer/value \"\\\\frac{2 \\\\left(3^{x} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/id #uuid \"5f78e393-ac56-5a9d-bcaf-676a4650d649\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/key \"answer\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/type :answer-field.type/radio] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"f76158f7-1c19-5899-a6e7-286a0fefedc0\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"4c56d3f7-b5db-5c2f-9111-de972742e4ef\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"f43ce179-e0b5-548e-9f79-ff00a6b5d25f\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"f3214313-3558-5487-a951-6a0ced2c15d3\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/choices \"e0a7c18a-ff61-5903-9926-67764b54250d\"] [\"5f78e393-ac56-5a9d-bcaf-676a4650d649\" :answer-field/correct \"e0a7c18a-ff61-5903-9926-67764b54250d\"] [\"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/id #uuid \"c298eccc-ebbf-57ce-b804-ed8499873e4e\"] [\"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $3^{x} + 1>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/worked-solution \"Let $u=3^{x} + 1$. Then $\\\\mathrm{d}u=(3^{x} \\\\ln{\\\\left(3 \\\\right)})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $3^{x} + 1>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\cdot 3^{x} \\\\left(3^{x} + 1\\\\right)^{2}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\int u^{2}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2}{\\\\ln{\\\\left(3 \\\\right)}}\\\\left(\\\\frac{u^{3}}{3}\\\\right)+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\left(3^{x} + 1\\\\right)^{3}}{3 \\\\ln{\\\\left(3 \\\\right)}}+C.\\n$$\"] [\"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/difficulty :question.difficulty/easy] [\"c298eccc-ebbf-57ce-b804-ed8499873e4e\" :question/answer-fields \"5f78e393-ac56-5a9d-bcaf-676a4650d649\"] [17592186184351 :knowledge-point/questions \"c298eccc-ebbf-57ce-b804-ed8499873e4e\"] [\"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/id #uuid \"bed8f85e-5751-57b6-8b59-45c374fddbdf\"] [\"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/type :answer.type/math] [\"bed8f85e-5751-57b6-8b59-45c374fddbdf\" :answer/value \"\\\\frac{\\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [\"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/id #uuid \"fc37f787-7179-5125-901d-f8b29c9ad6de\"] [\"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/type :answer.type/math] [\"fc37f787-7179-5125-901d-f8b29c9ad6de\" :answer/value \"\\\\left(e^{2 x} + 2\\\\right)^{3}+C\"] [\"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/id #uuid \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\"] [\"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/type :answer.type/math] [\"20e275ca-fefa-5ebc-9778-dcfa2aefa453\" :answer/value \"\\\\frac{\\\\left(\\\\frac{e^{2 x}}{2} + 1\\\\right)^{3}}{3}+C\"] [\"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/id #uuid \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\"] [\"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/type :answer.type/math] [\"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\" :answer/value \"\\\\frac{x^{3}}{3}+C\"] [\"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/id #uuid \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\"] [\"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/type :answer.type/math] [\"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\" :answer/value \"\\\\frac{2 \\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/id #uuid \"0fc5b778-5744-5c25-a311-fbbf0587882b\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/key \"answer\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/type :answer-field.type/radio] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"bed8f85e-5751-57b6-8b59-45c374fddbdf\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"fc37f787-7179-5125-901d-f8b29c9ad6de\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"20e275ca-fefa-5ebc-9778-dcfa2aefa453\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"d4f323c9-a6fa-5c8b-87fd-cec9667dfa19\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/choices \"6abaf954-4be4-57ee-88ce-d2d6a4a153f4\"] [\"0fc5b778-5744-5c25-a311-fbbf0587882b\" :answer-field/correct \"bed8f85e-5751-57b6-8b59-45c374fddbdf\"] [\"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/id #uuid \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\"] [\"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/worked-solution \"Let $u=e^{2 x} + 2$. Then $\\\\mathrm{d}u=(2 e^{2 x})\\\\,\\\\mathrm{d}x$.\\n\\nWork where $e^{2 x} + 2>0$.\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 \\\\left(e^{2 x} + 2\\\\right)^{2} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int u^{2}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\n$$\\n\\\\int u^{2}\\\\,\\\\mathrm{d}u=\\\\frac{u^{3}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\left(e^{2 x} + 2\\\\right)^{3}}{3}+C.\\n$$\"] [\"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/difficulty :question.difficulty/easy] [\"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\" :question/answer-fields \"0fc5b778-5744-5c25-a311-fbbf0587882b\"] [17592186184351 :knowledge-point/questions \"15aecd0c-7a63-5ed0-a8d5-0fcdbef27db3\"] [\"generator\" :question-generator/id #uuid \"6814898e-6d38-54e0-8336-3b6c8123cc26\"] [\"generator\" :question-generator/script \"generators/15/150f4e52d