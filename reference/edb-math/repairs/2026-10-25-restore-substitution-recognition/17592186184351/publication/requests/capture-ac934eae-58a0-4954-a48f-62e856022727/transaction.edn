af-8834-5e8c-9a7d-5d024d93d71e"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/key "answer"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/type :answer-field.type/radio] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/choices "a9f5d3bd-0470-517f-8bef-751fdeaa3f8e"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/choices "b5538129-1177-5a16-919e-da3d33eabd99"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/choices "0f93cf91-7d11-52d5-a2fc-0e0531f973da"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/choices "b0836ea4-5d14-5ed9-a014-2f4a9996e963"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/choices "5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca"] [:db/add "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/correct "5eae3ca1-521c-5ed6-ad70-e2f97b8d6cca"] [:db/ensure "cd4664af-8834-5e8c-9a7d-5d024d93d71e" :answer-field/validate] [:db/add "e632c680-496e-59ea-95dc-16067a645516" :question/id #uuid "e632c680-496e-59ea-95dc-16067a645516"] [:db/add "e632c680-496e-59ea-95dc-16067a645516" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 \\cdot 2^{x} \\left(2^{x} + 2\\right)^{3}\\,\\mathrm{d}x\n$$\n\nWork where $2^{x} + 2>0$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "e632c680-496e-59ea-95dc-16067a645516" :question/worked-solution "Let $u=2^{x} + 2$. Then $\\mathrm{d}u=(2^{x} \\ln{\\left(2 \\right)})\\,\\mathrm{d}x$.\n\nWork where $2^{x} + 2>0$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 \\cdot 2^{x} \\left(2^{x} + 2\\right)^{3}\\,\\mathrm{d}x\\\\&=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int u^{3}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int u^{3}\\,\\mathrm{d}u=\\frac{u^{4}}{4}+C.\n$$\n\n$$\n\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\int u^{3}\\,\\mathrm{d}u\\right)=\\frac{3}{\\ln{\\left(2 \\right)}}\\left(\\frac{u^{4}}{4}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\left(2^{x} + 2\\right)^{4}}{4 \\ln{\\left(2 \\right)}}+C.\n$$"] [:db/add "e632c680-496e-59ea-95dc-16067a645516" :question/difficulty :question.difficulty/easy] [:db/add "e632c680-496e-59ea-95dc-16067a645516" :question/answer-fields "cd4664af-8834-5e8c-9a7d-5d024d93d71e"] [:db/ensure "e632c680-496e-59ea-95dc-16067a645516" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "e632c680-496e-59ea-95dc-16067a645516"] [:db/add "798f2c0d-946b-594c-97a2-b666ec6d970e" :answer/id #uuid "798f2c0d-946b-594c-97a2-b666ec6d970e"] [:db/add "798f2c0d-946b-594c-97a2-b666ec6d970e" :answer/type :answer.type/math] [:db/add "798f2c0d-946b-594c-97a2-b666ec6d970e" :answer/value "\\left(e^{x} + 4\\right)^{3}+C"] [:db/ensure "798f2c0d-946b-594c-97a2-b666ec6d970e" :answer/validate] [:db/add "c1941f07-17ec-5fbc-8a17-1642ef1d1903" :answer/id #uuid "c1941f07-17ec-5fbc-8a17-1642ef1d1903"] [:db/add "c1941f07-17ec-5fbc-8a17-1642ef1d1903" :answer/type :answer.type/math] [:db/add "c1941f07-17ec-5fbc-8a17-1642ef1d1903" :answer/value "- 2 \\left(e^{x} + 3\\right)^{3}+C"] [:db/ensure "c1941f07-17ec-5fbc-8a17-1642ef1d1903" :answer/validate] [:db/add "707d18cb-1f1b-5c21-815e-6db05d6fa575" :answer/id #uuid "707d18cb-1f1b-5c21-815e-6db05d6fa575"] [:db/add "707d18cb-1f1b-5c21-815e-6db05d6fa575" :answer/type :answer.type/math] [:db/add "707d18cb-1f1b-5c21-815e-6db05d6fa575" :answer/value "e^{x} + 3+C"] [:db/ensure "707d18cb-1f1b-5c21-815e-6db05d6fa575" :answer/validate] [:db/add "c1e0bc34-447f-5312-8981-2073aff34c15" :answer/id #uuid "c1e0bc34-447f-5312-8981-2073aff34c15"] [:db/add "c1e0bc34-447f-5312-8981-2073aff34c15" :answer/type :answer.type/math] [:db/add "c1e0bc34-447f-5312-8981-2073aff34c15" :answer/value "\\left(e^{x} + 3\\right)^{3}+C"] [:db/ensure "c1e0bc34-447f-5312-8981-2073aff34c15" :answer/validate] [:db/add "ea7b9a66-c24d-59d3-9f31-236b89a7386f" :answer/id #uuid "ea7b9a66-c24d-59d3-9f31-236b89a7386f"] [:db/add "ea7b9a66-c24d-59d3-9f31-236b89a7386f" :answe