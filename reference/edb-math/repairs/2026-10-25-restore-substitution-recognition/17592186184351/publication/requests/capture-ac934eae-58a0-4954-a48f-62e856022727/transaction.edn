$$\n\n$$\n3\\left(\\int u^{2}\\,\\mathrm{d}u\\right)=3\\left(\\frac{u^{3}}{3}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\left(e^{x} + 3\\right)^{3}+C.\n$$"] [:db/add "c09dc904-67bc-5850-bb34-0c0ff6836057" :question/difficulty :question.difficulty/easy] [:db/add "c09dc904-67bc-5850-bb34-0c0ff6836057" :question/answer-fields "e1178dbf-e8ba-55a0-b3a5-b2daa44a6b53"] [:db/ensure "c09dc904-67bc-5850-bb34-0c0ff6836057" :question/validate] [:db/add 17592186184351 :knowledge-point/questions "c09dc904-67bc-5850-bb34-0c0ff6836057"] [:db/add "ace9b886-4650-5632-bfd8-03753da66c78" :answer/id #uuid "ace9b886-4650-5632-bfd8-03753da66c78"] [:db/add "ace9b886-4650-5632-bfd8-03753da66c78" :answer/type :answer.type/math] [:db/add "ace9b886-4650-5632-bfd8-03753da66c78" :answer/value "\\frac{2 \\left(3^{x} + 2\\right)^{3}}{9 \\ln{\\left(3 \\right)}}+C"] [:db/ensure "ace9b886-4650-5632-bfd8-03753da66c78" :answer/validate] [:db/add "8a6e4009-bca4-5468-ae4c-1d84b1783b01" :answer/id #uuid "8a6e4009-bca4-5468-ae4c-1d84b1783b01"] [:db/add "8a6e4009-bca4-5468-ae4c-1d84b1783b01" :answer/type :answer.type/math] [:db/add "8a6e4009-bca4-5468-ae4c-1d84b1783b01" :answer/value "\\frac{2 \\left(\\frac{3^{x}}{2} + 1\\right)^{3}}{3 \\ln{\\left(3 \\right)}}+C"] [:db/ensure "8a6e4009-bca4-5468-ae4c-1d84b1783b01" :answer/validate] [:db/add "c176422a-2c97-5912-ba83-e91f41daa7a0" :answer/id #uuid "c176422a-2c97-5912-ba83-e91f41daa7a0"] [:db/add "c176422a-2c97-5912-ba83-e91f41daa7a0" :answer/type :answer.type/math] [:db/add "c176422a-2c97-5912-ba83-e91f41daa7a0" :answer/value "\\frac{2 \\left(3^{x} + 3\\right)^{3}}{3 \\ln{\\left(3 \\right)}}+C"] [:db/ensure "c176422a-2c97-5912-ba83-e91f41daa7a0" :answer/validate] [:db/add "1cf11729-1f4f-5980-825d-98526ca7719c" :answer/id #uuid "1cf11729-1f4f-5980-825d-98526ca7719c"] [:db/add "1cf11729-1f4f-5980-825d-98526ca7719c" :answer/type :answer.type/math] [:db/add "1cf11729-1f4f-5980-825d-98526ca7719c" :answer/value "\\frac{2 \\left(2 \\cdot 3^{x} + 4\\right)^{3}}{3 \\