m{d}u\\right)=- \\frac{\\cot{\\left(u \\right)}}{3}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{\\cot{\\left(x^{3} \\right)}}{3}+C.\n$$"] [:db/add "40a4438e-75a4-56e4-b7e6-126b49154631" :question/difficulty :question.difficulty/easy] [:db/add "40a4438e-75a4-56e4-b7e6-126b49154631" :question/answer-fields "a05eafc0-b5df-5069-ba6d-c40e3f809e0a"] [:db/ensure "40a4438e-75a4-56e4-b7e6-126b49154631" :question/validate] [:db/add 17592186068917 :knowledge-point/questions "40a4438e-75a4-56e4-b7e6-126b49154631"] [:db/add "9e2aa0ca-a27e-5dcf-b802-01f5103ce176" :answer/id #uuid "9e2aa0ca-a27e-5dcf-b802-01f5103ce176"] [:db/add "9e2aa0ca-a27e-5dcf-b802-01f5103ce176" :answer/type :answer.type/math] [:db/add "9e2aa0ca-a27e-5dcf-b802-01f5103ce176" :answer/value "\\frac{4 \\cos{\\left(x^{3} \\right)}}{3}+C"] [:db/ensure "9e2aa0ca-a27e-5dcf-b802-01f5103ce176" :answer/validate] [:db/add "11d5d6c2-d79a-5012-a688-589d394e29fb" :answer/id #uuid "11d5d6c2-d79a-5012-a688-589d394e29fb"] [:db/add "11d5d6c2-d79a-5012-a688-589d394e29fb" :answer/type :answer.type/math] [:db/add "11d5d6c2-d79a-5012-a688-589d394e29fb" :answer/value "\\frac{2 \\cos{\\left(x^{3} \\right)}}{3}+C"] [:db/ensure "11d5d6c2-d79a-5012-a688-589d394e29fb" :answer/validate] [:db/add "9c6cdea2-5650-5956-826f-7d75f1b6ac49" :answer/id #uuid "9c6cdea2-5650-5956-826f-7d75f1b6ac49"] [:db/add "9c6cdea2-5650-5956-826f-7d75f1b6ac49" :answer/type :answer.type/math] [:db/add "9c6cdea2-5650-5956-826f-7d75f1b6ac49" :answer/value "- \\frac{2 \\cos{\\left(\\frac{x^{3}}{2} \\right)}}{3}+C"] [:db/ensure "9c6cdea2-5650-5956-826f-7d75f1b6ac49" :answer/validate] [:db/add "1167156d-e32a-54a6-981c-103cbb54edd4" :answer/id #uuid "1167156d-e32a-54a6-981c-103cbb54edd4"] [:db/add "1167156d-e32a-54a6-981c-103cbb54edd4" :answer/type :answer.type/math] [:db/add "1167156d-e32a-54a6-981c-103cbb54edd4" :answer/value "- \\frac{2 \\cos{\\left(x^{3} \\right)}}{3}+C"] [:db/ensure "1167156d-e32a-54a6-981c-103cbb54edd4" :answer/validate] [:db/add "0fb67a20-b5e5-5d