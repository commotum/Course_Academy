  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"0fe01840-04dd-5352-bde2-245545b58730\" :answer/id #uuid \"0fe01840-04dd-5352-bde2-245545b58730\"] [:db/add \"0fe01840-04dd-5352-bde2-245545b58730\" :answer/type :answer.type/math] [:db/add \"0fe01840-04dd-5352-bde2-245545b58730\" :answer/value \"- \\\\sin{\\\\left(x^{2} \\\\right)}+C\"] [:db/ensure \"0fe01840-04dd-5352-bde2-245545b58730\" :answer/validate] [:db/add \"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/id #uuid \"571c07f7-932a-57b5-aacf-8b1583a9a944\"] [:db/add \"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/type :answer.type/math] [:db/add \"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/value \"\\\\sin{\\\\left(x^{2} \\\\right)}+C\"] [:db/ensure \"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/validate] [:db/add \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/id #uuid \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\"] [:db/add \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/type :answer.type/math] [:db/add \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/value \"3 \\\\sin{\\\\left(x^{2} \\\\right)}+C\"] [:db/ensure \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/validate] [:db/add \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/id #uuid \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\"] [:db/add \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/type :answer.type/math] [:db/add \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/value \"\\\\sin{\\\\left(\\\\frac{x^{2}}{2} \\\\right)}+C\"] [:db/ensure \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/validate] [:db/add \"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/id #uuid \"7f7053e4-bb12-54d2-8185-09d694e04ff6\"] [:db/add \"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/type :answer.type/math] [:db/add \"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/value \"\\\\sin{\\\\left(2 x^{2} \\\\right)}+C\"] [:db/ensure \"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/validate] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/id #uuid \"f43b8742-1703-5d21-b8c3-ae48dc835629\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/key \"answer\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/type :answer-field.type/radio] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"0fe01840-04dd-5352-bde2-245545b58730\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"571c07f7-932a-57b5-aacf-8b1583a9a944\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"7f7053e4-bb12-54d2-8185-09d694e04ff6\"] [:db/add \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/correct \"571c07f7-932a-57b5-aacf-8b1583a9a944\"] [:db/ensure \"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/validate] [:db/add \"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/id #uuid \"7f9a1eea-25dd-5f39-b354-685880d8e60b\"] [:db/add \"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\sin{\\\\left(x^{2} \\\\right)}+C.\\n$$\"] [:db/add \"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/difficulty :question.difficulty/easy] [:db/add \"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/answer-fields \"f43b8742-1703-5d21-b8c3-ae48dc835629\"] [:db/ensure \"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"7f9a1eea-25dd-5f39-b354-685880d8e60b\"] [:db/add \"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/id #uuid \"21589a3d-26ec-516e-a430-3ffcc471eb2f\"] [:db/add \"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/type :answer.type/math] [:db/add \"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/value \"x^{3}+C\"] [:db/ensure \"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/validate] [:db/add \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/id #uuid \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\"] [:db/add \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/type :answer.type/math] [:db/add \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/value \"- \\\\tan{\\\\left(x^{3} \\\\right)}+C\"] [:db/ensure \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/validate] [:db/add \"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/id #uuid \"3370c20a-0cea-5fa6-8092-f41643dd084a\"] [:db/add \"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/type :answer.type/math] [:db/add \"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/value \"\\\\frac{\\\\tan{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/validate] [:db/add \"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/id #uuid \"356cbae2-ca2d-551f-b3db-d3952f13bafc\"] [:db/add \"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/type :answer.type/math] [:db/add \"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/value \"3 \\\\tan{\\\\left(x^{3} \\\\right)}+C\"] [:db/ensure \"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/validate] [:db/add \"7e47a764-2d7c-584a-a809-d264eefbb714\" :answer/id #uuid \"7e47a764-2d