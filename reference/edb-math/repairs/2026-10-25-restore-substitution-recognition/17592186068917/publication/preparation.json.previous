ght)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\tan{\\\\left(x^{3} \\\\right)}+C.\\n$$\"] [:db/add \"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/difficulty :question.difficulty/easy] [:db/add \"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/answer-fields \"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\"] [:db/ensure \"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"639ea0b6-3ae6-5b7b-bd85-9540685724d8\"] [:db/add \"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/id #uuid \"d6045465-8d62-5b64-91ce-17eb6b261460\"] [:db/add \"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/type :answer.type/math] [:db/add \"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/value \"- \\\\frac{2 \\\\cot{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/validate] [:db/add \"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/id #uuid \"a7137561-cf39-56f4-8d57-e2bde126de46\"] [:db/add \"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/type :answer.type/math] [:db/add \"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/value \"x^{3}+C\"] [:db/ensure \"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/validate] [:db/add \"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/id #uuid \"55c3def3-4693-5a90-9503-ffc553748dc7\"] [:db/add \"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/type :answer.type/math] [:db/add \"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/value \"- \\\\cot{\\\\left(x^{3} \\\\right)}+C\"] [:db/ensure \"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/validate] [:db/add \"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/id #uuid \"2fb819e4-3830-5049-97f7-d7e952707b7c\"] [:db/add \"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/type :answer.type/math] [:db/add \"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/value \"- \\\\frac{\\\\cot{\\\\left(2 x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/validate] [:db/add \"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/id #uuid \"cd627ea9-ae32-5fde-b905-65c004961640\"] [:db/add \"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/type :answer.type/math] [:db/add \"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/value \"- \\\\frac{\\\\cot{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/validate] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/id #uuid \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/key \"answer\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/type :answer-field.type/radio] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"d6045465-8d62-5b64-91ce-17eb6b261460\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"a7137561-cf39-56f4-8d57-e2bde126de46\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"55c3def3-4693-5a90-9503-ffc553748dc7\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"2fb819e4-3830-5049-97f7-d7e952707b7c\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"cd627ea9-ae32-5fde-b905-65c004961640\"] [:db/add \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/correct \"cd627ea9-ae32-5fde-b905-65c004961640\"] [:db/ensure \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/validate] [:db/add \"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/id #uuid \"40a4438e-75a4-56e4-b7e6-126b49154631\"] [:db/add \"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} \\\\csc^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\csc^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{\\\\cot{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{\\\\cot{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [:db/add \"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/difficulty :question.difficulty/easy] [:db/add \"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/answer-fields \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\"] [:db/ensure \"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"40a4438e-75a4-56e4-b7e6-126b49154631\"] [:db/add \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/id #uuid \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\"] [:db/add \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/type :answer.type/math] [:db/add \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/value \"\\\\frac{4 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/validate] [:db/add \"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/id #uuid \"11d5d6c2-d79a-5012-a688-589d394e29fb\"] [:db/add \"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/type :answer.type/math] [:db/add \"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/value \"\\\\frac{2 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/validate] [:db/add \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/id #uuid \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\"] [:db/add \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/type :answer.type/math] [:db/add \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/value \"- \\\\frac{2 \\\\cos{\\\\left(\\\\frac{x^{3}}{2} \\\\right)}}{3}+C\"] [:db/ensure \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/validate] [:db/add \"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/id #uuid \"1167156d-e32a-54a6-981c-103cbb54edd4\"] [:db/add \"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/type :answer.type/math] [:db/add \"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/value \"- \\\\frac{2 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/validate] [:db/add \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/id #uuid \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\"] [:db/add \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/type :answer.type/math] [:db/add \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/value \"- \\\\frac{2 \\\\cos{\\\\left(x^{3} + 1 \\\\right)}}{3}+C\"] [:db/ensure \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/validate] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/id #uuid \"27242213-0e71-5441-a4e6-60da76f03e74\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/key \"answer\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/type :answer-field.type/radio] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"11d5d6c2-d79a-5012-a688-589d394e29fb\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"1167156d-e32a-54a6-981c-103cbb54edd4\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\"] [:db/add \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/correct \"1167156d-e32a-54a6-981c-103cbb54edd4\"] [:db/ensure \"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/validate] [:db/add \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/id #uuid \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\"] [:db/add \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2 \\\\cos{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [:db/add \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/difficulty :question.difficulty/easy] [:db/add \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/answer-fields \"27242213-0e71-5441-a4e6-60da76f03e74\"] [:db/ensure \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\"] [:db/add \"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/id #uuid \"98ff7521-9b92-5d64-b06a-55c0e295428a\"] [:db/add \"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/type :answer.type/math] [:db/add \"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(x^{3} + 1 \\\\right)}}{3}+C\"] [:db/ensure \"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/validate] [:db/add \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/id #uuid \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\"] [:db/add \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/type :answer.type/math] [:db/add \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/value \"- \\\\frac{4 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/validate] [:db/add \"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/id #uuid \"4d477e28-646c-5281-8fcc-6c2be444bac3\"] [:db/add \"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/type :answer.type/math] [:db/add \"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(\\\\frac{x^{3}}{2} \\\\right)}}{3}+C\"] [:db/ensure \"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/validate] [:db/add \"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/id #uuid \"63f25881-951f-5d3d-a9b6-83689776cbe5\"] [:db/add \"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/type :answer.type/math] [:db/add \"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(2 x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/validate] [:db/add \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/id #uuid \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\"] [:db/add \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/type :answer.type/math] [:db/add \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/validate] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/id #uuid \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/key \"answer\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/type :answer-field.type/radio] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"98ff7521-9b92-5d64-b06a-55c0e295428a\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"4d477e28-646c-5281-8fcc-6c2be444bac3\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"63f25881-951f-5d3d-a9b6-83689776cbe5\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\"] [:db/add \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/correct \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\"] [:db/ensure \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/validate] [:db/add \"e311139a-9e29-5471-bf3a-243aed01977f\" :question/id #uuid \"e311139a-9e29-5471-bf3a-243aed01977f\"] [:db/add \"e311139a-9e29-5471-bf3a-243aed01977f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\tan{\\\\left(x^{3} \\\\right)} \\\\sec{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"e311139a-9e29-5471-bf3a-243aed01977f\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\tan{\\\\left(x^{3} \\\\right)} \\\\sec{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\sec{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [:db/add \"e311139a-9e29-5471-bf3a-243aed01977f\" :question/difficulty :question.difficulty/easy] [:db/add \"e311139a-9e29-5471-bf3a-243aed01977f\" :question/answer-fields \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\"] [:db/ensure \"e311139a-9e29-5471-bf3a-243aed01977f\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"e311139a-9e29-5471-bf3a-243aed01977f\"] [:db/add \"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/id #uuid \"e4f57ae7-a955-57c2-a0cb-9151822c7800\"] [:db/add \"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/type :answer.type/math] [:db/add \"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/value \"\\\\frac{4 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/validate] [:db/add \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/id #uuid \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\"] [:db/add \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/type :answer.type/math] [:db/add \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/value \"\\\\frac{2 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/validate] [:db/add \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/id #uuid \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\"] [:db/add \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/type :answer.type/math] [:db/add \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/value \"- \\\\frac{2 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/validate] [:db/add \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/id #uuid \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\"] [:db/add \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/type :answer.type/math] [:db/add \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/value \"- \\\\frac{\\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/validate] [:db/add \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/id #uuid \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\"] [:db/add \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/type :answer.type/math] [:db/add \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/value \"- \\\\frac{2 \\\\csc{\\\\left(x^{3} + 1 \\\\right)}}{3}+C\"] [:db/ensure \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/validate] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/id #uuid \"ffd2617a-ea2e-5356-96ff-c5d593c60258\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/key \"answer\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/type :answer-field.type/radio] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"e4f57ae7-a955-57c2-a0cb-9151822c7800\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\"] [:db/add \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/correct \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\"] [:db/ensure \"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/validate] [:db/add \"8d058984-a017-5192-92d1-ddd80292fa11\" :question/id #uuid \"8d058984-a017-5192-92d1-ddd80292fa11\"] [:db/add \"8d058984-a017-5192-92d1-ddd80292fa11\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"8d058984-a017-5192-92d1-ddd80292fa11\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2 \\\\csc{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [:db/add \"8d058984-a017-5192-92d1-ddd80292fa11\" :question/difficulty :question.difficulty/easy] [:db/add \"8d058984-a017-5192-92d1-ddd80292fa11\" :question/answer-fields \"ffd2617a-ea2e-5356-96ff-c5d593c60258\"] [:db/ensure \"8d058984-a017-5192-92d1-ddd80292fa11\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"8d058984-a017-5192-92d1-ddd80292fa11\"] [:db/add \"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/id #uuid \"345fbf49-c123-513b-9942-467ab8f3a099\"] [:db/add \"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/type :answer.type/math] [:db/add \"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/value \"- \\\\frac{4 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/validate] [:db/add \"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/id #uuid \"7a56bea5-bc81-5053-978d-69d48a52b1eb\"] [:db/add \"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/type :answer.type/math] [:db/add \"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/value \"\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C\"] [:db/ensure \"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/validate] [:db/add \"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/id #uuid \"31a87405-12d1-5965-8b57-28bf462411d1\"] [:db/add \"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/type :answer.type/math] [:db/add \"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/value \"\\\\frac{2 \\\\sin{\\\\left(\\\\frac{x^{3}}{2} \\\\right)}}{3}+C\"] [:db/ensure \"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/validate] [:db/add \"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/id #uuid \"dc7bb8dc-54f4-520d-8640-d38feb7266de\"] [:db/add \"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/type :answer.type/math] [:db/add \"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/value \"x^{3}+C\"] [:db/ensure \"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/validate] [:db/add \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/id #uuid \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\"] [:db/add \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/type :answer.type/math] [:db/add \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/value \"2 \\\\sin{\\\\left(x^{3} \\\\right)}+C\"] [:db/ensure \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/validate] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/id #uuid \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/key \"answer\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/type :answer-field.type/radio] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"345fbf49-c123-513b-9942-467ab8f3a099\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"7a56bea5-bc81-5053-978d-69d48a52b1eb\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"31a87405-12d1-5965-8b57-28bf462411d1\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"dc7bb8dc-54f4-520d-8640-d38feb7266de\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\"] [:db/add \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/correct \"7a56bea5-bc81-5053-978d-69d48a52b1eb\"] [:db/ensure \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/validate] [:db/add \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/id #uuid \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\"] [:db/add \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\sin{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [:db/add \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/difficulty :question.difficulty/easy] [:db/add \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/answer-fields \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\"] [:db/ensure \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\"] [:db/add \"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/id #uuid \"d3652321-73af-5af5-81a1-f8606ecb2b62\"] [:db/add \"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/type :answer.type/math] [:db/add \"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x \\\\right)}}{2}+C\"] [:db/ensure \"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/validate] [:db/add \"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/id #uuid \"1b303114-90f6-53da-9684-1f7ba22d0fd5\"] [:db/add \"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/type :answer.type/math] [:db/add \"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x^{2} \\\\right)}}{2}+C\"] [:db/ensure \"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/validate] [:db/add \"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/id #uuid \"9b87b68a-4006-589d-9c30-70eef6721874\"] [:db/add \"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/type :answer.type/math] [:db/add \"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x^{2} \\\\right)}}{4}+C\"] [:db/ensure \"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/validate] [:db/add \"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/id #uuid \"f0c15454-7fb6-5689-b8a5-a28364a66647\"] [:db/add \"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/type :answer.type/math] [:db/add \"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/value \"\\\\frac{9 \\\\tan{\\\\left(x^{2} \\\\right)}}{2}+C\"] [:db/ensure \"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/validate] [:db/add \"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/id #uuid \"85291b8c-46f2-56ed-9300-7ad5be0cde43\"] [:db/add \"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/type :answer.type/math] [:db/add \"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(2 x^{2} \\\\right)}}{2}+C\"] [:db/ensure \"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/validate] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/id #uuid \"1803a769-2043-5e90-894c-dc2cfddf718f\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/key \"answer\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/type :answer-field.type/radio] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"d3652321-73af-5af5-81a1-f8606ecb2b62\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"1b303114-90f6-53da-9684-1f7ba22d0fd5\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"9b87b68a-4006-589d-9c30-70eef6721874\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"f0c15454-7fb6-5689-b8a5-a28364a66647\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"85291b8c-46f2-56ed-9300-7ad5be0cde43\"] [:db/add \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/correct \"1b303114-90f6-53da-9684-1f7ba22d0fd5\"] [:db/ensure \"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/validate] [:db/add \"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/id #uuid \"836e3cff-5a63-5505-90cd-9ba385b65fb2\"] [:db/add \"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [:db/add \"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3 \\\\tan{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\tan{\\\\left(x^{2} \\\\right)}}{2}+C.\\n$$\"] [:db/add \"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/difficulty :question.difficulty/easy] [:db/add \"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/answer-fields \"1803a769-2043-5e90-894c-dc2cfddf718f\"] [:db/ensure \"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/validate] [:db/add 17592186068917 :knowledge-point/questions \"836e3cff-5a63-5505-90cd-9ba385b65fb2\"] [:db/add \"generator\" :question-generator/id #uuid \"8608026d-d3f5-5209-afed-bfea42b4ca68\"] [:db/add \"generator\" :question-generator/script \"generators/5d/5dffbaf59822612035565b2974ffc45d6531e74d0f089df001b14bdd505ae5a3/generator.py\"] [:db/add 17592186068917 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186068917 :knowledge-point/validate]] \"assertions\" [[\"0fe01840-04dd-5352-bde2-245545b58730\" :answer/id #uuid \"0fe01840-04dd-5352-bde2-245545b58730\"] [\"0fe01840-04dd-5352-bde2-245545b58730\" :answer/type :answer.type/math] [\"0fe01840-04dd-5352-bde2-245545b58730\" :answer/value \"- \\\\sin{\\\\left(x^{2} \\\\right)}+C\"] [\"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/id #uuid \"571c07f7-932a-57b5-aacf-8b1583a9a944\"] [\"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/type :answer.type/math] [\"571c07f7-932a-57b5-aacf-8b1583a9a944\" :answer/value \"\\\\sin{\\\\left(x^{2} \\\\right)}+C\"] [\"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/id #uuid \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\"] [\"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/type :answer.type/math] [\"425f2d13-cbc7-5489-b99d-0848dbb8dc22\" :answer/value \"3 \\\\sin{\\\\left(x^{2} \\\\right)}+C\"] [\"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/id #uuid \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\"] [\"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/type :answer.type/math] [\"be32286a-dd54-5df5-98b6-55cb08d2e5a8\" :answer/value \"\\\\sin{\\\\left(\\\\frac{x^{2}}{2} \\\\right)}+C\"] [\"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/id #uuid \"7f7053e4-bb12-54d2-8185-09d694e04ff6\"] [\"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/type :answer.type/math] [\"7f7053e4-bb12-54d2-8185-09d694e04ff6\" :answer/value \"\\\\sin{\\\\left(2 x^{2} \\\\right)}+C\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/id #uuid \"f43b8742-1703-5d21-b8c3-ae48dc835629\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/key \"answer\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/type :answer-field.type/radio] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"0fe01840-04dd-5352-bde2-245545b58730\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"571c07f7-932a-57b5-aacf-8b1583a9a944\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"425f2d13-cbc7-5489-b99d-0848dbb8dc22\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"be32286a-dd54-5df5-98b6-55cb08d2e5a8\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/choices \"7f7053e4-bb12-54d2-8185-09d694e04ff6\"] [\"f43b8742-1703-5d21-b8c3-ae48dc835629\" :answer-field/correct \"571c07f7-932a-57b5-aacf-8b1583a9a944\"] [\"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/id #uuid \"7f9a1eea-25dd-5f39-b354-685880d8e60b\"] [\"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\sin{\\\\left(x^{2} \\\\right)}+C.\\n$$\"] [\"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/difficulty :question.difficulty/easy] [\"7f9a1eea-25dd-5f39-b354-685880d8e60b\" :question/answer-fields \"f43b8742-1703-5d21-b8c3-ae48dc835629\"] [17592186068917 :knowledge-point/questions \"7f9a1eea-25dd-5f39-b354-685880d8e60b\"] [\"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/id #uuid \"21589a3d-26ec-516e-a430-3ffcc471eb2f\"] [\"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/type :answer.type/math] [\"21589a3d-26ec-516e-a430-3ffcc471eb2f\" :answer/value \"x^{3}+C\"] [\"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/id #uuid \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\"] [\"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/type :answer.type/math] [\"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\" :answer/value \"- \\\\tan{\\\\left(x^{3} \\\\right)}+C\"] [\"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/id #uuid \"3370c20a-0cea-5fa6-8092-f41643dd084a\"] [\"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/type :answer.type/math] [\"3370c20a-0cea-5fa6-8092-f41643dd084a\" :answer/value \"\\\\frac{\\\\tan{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/id #uuid \"356cbae2-ca2d-551f-b3db-d3952f13bafc\"] [\"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/type :answer.type/math] [\"356cbae2-ca2d-551f-b3db-d3952f13bafc\" :answer/value \"3 \\\\tan{\\\\left(x^{3} \\\\right)}+C\"] [\"7e47a764-2d7c-584a-a809-d264eefbb714\" :answer/id #uuid \"7e47a764-2d7c-584a-a809-d264eefbb714\"] [\"7e47a764-2d7c-584a-a809-d264eefbb714\" :answer/type :answer.type/math] [\"7e47a764-2d7c-584a-a809-d264eefbb714\" :answer/value \"\\\\tan{\\\\left(x^{3} \\\\right)}+C\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/id #uuid \"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/key \"answer\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/type :answer-field.type/radio] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/choices \"21589a3d-26ec-516e-a430-3ffcc471eb2f\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/choices \"4cd6c568-2c78-5eb2-ba3e-f51e413fa4c0\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/choices \"3370c20a-0cea-5fa6-8092-f41643dd084a\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/choices \"356cbae2-ca2d-551f-b3db-d3952f13bafc\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/choices \"7e47a764-2d7c-584a-a809-d264eefbb714\"] [\"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\" :answer-field/correct \"7e47a764-2d7c-584a-a809-d264eefbb714\"] [\"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/id #uuid \"639ea0b6-3ae6-5b7b-bd85-9540685724d8\"] [\"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x^{2} \\\\sec^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} \\\\sec^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\tan{\\\\left(x^{3} \\\\right)}+C.\\n$$\"] [\"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/difficulty :question.difficulty/easy] [\"639ea0b6-3ae6-5b7b-bd85-9540685724d8\" :question/answer-fields \"24a6d7b2-7efc-5026-b297-d5aa3e5006a8\"] [17592186068917 :knowledge-point/questions \"639ea0b6-3ae6-5b7b-bd85-9540685724d8\"] [\"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/id #uuid \"d6045465-8d62-5b64-91ce-17eb6b261460\"] [\"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/type :answer.type/math] [\"d6045465-8d62-5b64-91ce-17eb6b261460\" :answer/value \"- \\\\frac{2 \\\\cot{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/id #uuid \"a7137561-cf39-56f4-8d57-e2bde126de46\"] [\"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/type :answer.type/math] [\"a7137561-cf39-56f4-8d57-e2bde126de46\" :answer/value \"x^{3}+C\"] [\"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/id #uuid \"55c3def3-4693-5a90-9503-ffc553748dc7\"] [\"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/type :answer.type/math] [\"55c3def3-4693-5a90-9503-ffc553748dc7\" :answer/value \"- \\\\cot{\\\\left(x^{3} \\\\right)}+C\"] [\"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/id #uuid \"2fb819e4-3830-5049-97f7-d7e952707b7c\"] [\"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/type :answer.type/math] [\"2fb819e4-3830-5049-97f7-d7e952707b7c\" :answer/value \"- \\\\frac{\\\\cot{\\\\left(2 x^{3} \\\\right)}}{3}+C\"] [\"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/id #uuid \"cd627ea9-ae32-5fde-b905-65c004961640\"] [\"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/type :answer.type/math] [\"cd627ea9-ae32-5fde-b905-65c004961640\" :answer/value \"- \\\\frac{\\\\cot{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/id #uuid \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/key \"answer\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/type :answer-field.type/radio] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"d6045465-8d62-5b64-91ce-17eb6b261460\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"a7137561-cf39-56f4-8d57-e2bde126de46\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"55c3def3-4693-5a90-9503-ffc553748dc7\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"2fb819e4-3830-5049-97f7-d7e952707b7c\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/choices \"cd627ea9-ae32-5fde-b905-65c004961640\"] [\"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\" :answer-field/correct \"cd627ea9-ae32-5fde-b905-65c004961640\"] [\"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/id #uuid \"40a4438e-75a4-56e4-b7e6-126b49154631\"] [\"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} \\\\csc^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\csc^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{\\\\cot{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{\\\\cot{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [\"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/difficulty :question.difficulty/easy] [\"40a4438e-75a4-56e4-b7e6-126b49154631\" :question/answer-fields \"a05eafc0-b5df-5069-ba6d-c40e3f809e0a\"] [17592186068917 :knowledge-point/questions \"40a4438e-75a4-56e4-b7e6-126b49154631\"] [\"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/id #uuid \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\"] [\"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/type :answer.type/math] [\"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\" :answer/value \"\\\\frac{4 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/id #uuid \"11d5d6c2-d79a-5012-a688-589d394e29fb\"] [\"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/type :answer.type/math] [\"11d5d6c2-d79a-5012-a688-589d394e29fb\" :answer/value \"\\\\frac{2 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/id #uuid \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\"] [\"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/type :answer.type/math] [\"9c6cdea2-5650-5956-826f-7d75f1b6ac49\" :answer/value \"- \\\\frac{2 \\\\cos{\\\\left(\\\\frac{x^{3}}{2} \\\\right)}}{3}+C\"] [\"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/id #uuid \"1167156d-e32a-54a6-981c-103cbb54edd4\"] [\"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/type :answer.type/math] [\"1167156d-e32a-54a6-981c-103cbb54edd4\" :answer/value \"- \\\\frac{2 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/id #uuid \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\"] [\"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/type :answer.type/math] [\"0fb67a20-b5e5-5d37-a10f-49d1d5329541\" :answer/value \"- \\\\frac{2 \\\\cos{\\\\left(x^{3} + 1 \\\\right)}}{3}+C\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/id #uuid \"27242213-0e71-5441-a4e6-60da76f03e74\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/key \"answer\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/type :answer-field.type/radio] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"9e2aa0ca-a27e-5dcf-b802-01f5103ce176\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"11d5d6c2-d79a-5012-a688-589d394e29fb\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"9c6cdea2-5650-5956-826f-7d75f1b6ac49\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"1167156d-e32a-54a6-981c-103cbb54edd4\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/choices \"0fb67a20-b5e5-5d37-a10f-49d1d5329541\"] [\"27242213-0e71-5441-a4e6-60da76f03e74\" :answer-field/correct \"1167156d-e32a-54a6-981c-103cbb54edd4\"] [\"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/id #uuid \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\"] [\"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2 \\\\cos{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2 \\\\cos{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [\"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/difficulty :question.difficulty/easy] [\"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\" :question/answer-fields \"27242213-0e71-5441-a4e6-60da76f03e74\"] [17592186068917 :knowledge-point/questions \"e605fe81-8ae9-5f81-9f29-4e2e03aeb1d5\"] [\"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/id #uuid \"98ff7521-9b92-5d64-b06a-55c0e295428a\"] [\"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/type :answer.type/math] [\"98ff7521-9b92-5d64-b06a-55c0e295428a\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(x^{3} + 1 \\\\right)}}{3}+C\"] [\"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/id #uuid \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\"] [\"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/type :answer.type/math] [\"986e7511-ec1f-5964-b4fd-b65744ea5ed3\" :answer/value \"- \\\\frac{4 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/id #uuid \"4d477e28-646c-5281-8fcc-6c2be444bac3\"] [\"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/type :answer.type/math] [\"4d477e28-646c-5281-8fcc-6c2be444bac3\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(\\\\frac{x^{3}}{2} \\\\right)}}{3}+C\"] [\"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/id #uuid \"63f25881-951f-5d3d-a9b6-83689776cbe5\"] [\"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/type :answer.type/math] [\"63f25881-951f-5d3d-a9b6-83689776cbe5\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(2 x^{3} \\\\right)}}{3}+C\"] [\"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/id #uuid \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\"] [\"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/type :answer.type/math] [\"c42a4a8d-2041-501d-8b8c-226d9485cd3f\" :answer/value \"\\\\frac{2 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/id #uuid \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/key \"answer\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/type :answer-field.type/radio] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"98ff7521-9b92-5d64-b06a-55c0e295428a\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"986e7511-ec1f-5964-b4fd-b65744ea5ed3\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"4d477e28-646c-5281-8fcc-6c2be444bac3\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"63f25881-951f-5d3d-a9b6-83689776cbe5\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/choices \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\"] [\"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\" :answer-field/correct \"c42a4a8d-2041-501d-8b8c-226d9485cd3f\"] [\"e311139a-9e29-5471-bf3a-243aed01977f\" :question/id #uuid \"e311139a-9e29-5471-bf3a-243aed01977f\"] [\"e311139a-9e29-5471-bf3a-243aed01977f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\tan{\\\\left(x^{3} \\\\right)} \\\\sec{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"e311139a-9e29-5471-bf3a-243aed01977f\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\tan{\\\\left(x^{3} \\\\right)} \\\\sec{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\sec{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [\"e311139a-9e29-5471-bf3a-243aed01977f\" :question/difficulty :question.difficulty/easy] [\"e311139a-9e29-5471-bf3a-243aed01977f\" :question/answer-fields \"efc8f1de-5cfd-50f8-a0bf-92425fe62faa\"] [17592186068917 :knowledge-point/questions \"e311139a-9e29-5471-bf3a-243aed01977f\"] [\"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/id #uuid \"e4f57ae7-a955-57c2-a0cb-9151822c7800\"] [\"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/type :answer.type/math] [\"e4f57ae7-a955-57c2-a0cb-9151822c7800\" :answer/value \"\\\\frac{4 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/id #uuid \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\"] [\"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/type :answer.type/math] [\"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\" :answer/value \"\\\\frac{2 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/id #uuid \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\"] [\"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/type :answer.type/math] [\"1d0ded6c-712a-51d5-8d98-9c8d947e7983\" :answer/value \"- \\\\frac{2 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/id #uuid \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\"] [\"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/type :answer.type/math] [\"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\" :answer/value \"- \\\\frac{\\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/id #uuid \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\"] [\"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/type :answer.type/math] [\"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\" :answer/value \"- \\\\frac{2 \\\\csc{\\\\left(x^{3} + 1 \\\\right)}}{3}+C\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/id #uuid \"ffd2617a-ea2e-5356-96ff-c5d593c60258\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/key \"answer\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/type :answer-field.type/radio] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"e4f57ae7-a955-57c2-a0cb-9151822c7800\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"e607b06d-3ba0-5bfd-ac67-d2b745f8168b\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"89d6f6e3-eed2-5a8f-acba-22bf10ae8b6c\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/choices \"257fc888-0b6c-5b3c-a4ec-7e329d7b588d\"] [\"ffd2617a-ea2e-5356-96ff-c5d593c60258\" :answer-field/correct \"1d0ded6c-712a-51d5-8d98-9c8d947e7983\"] [\"8d058984-a017-5192-92d1-ddd80292fa11\" :question/id #uuid \"8d058984-a017-5192-92d1-ddd80292fa11\"] [\"8d058984-a017-5192-92d1-ddd80292fa11\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"8d058984-a017-5192-92d1-ddd80292fa11\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2 \\\\csc{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2 \\\\csc{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [\"8d058984-a017-5192-92d1-ddd80292fa11\" :question/difficulty :question.difficulty/easy] [\"8d058984-a017-5192-92d1-ddd80292fa11\" :question/answer-fields \"ffd2617a-ea2e-5356-96ff-c5d593c60258\"] [17592186068917 :knowledge-point/questions \"8d058984-a017-5192-92d1-ddd80292fa11\"] [\"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/id #uuid \"345fbf49-c123-513b-9942-467ab8f3a099\"] [\"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/type :answer.type/math] [\"345fbf49-c123-513b-9942-467ab8f3a099\" :answer/value \"- \\\\frac{4 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/id #uuid \"7a56bea5-bc81-5053-978d-69d48a52b1eb\"] [\"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/type :answer.type/math] [\"7a56bea5-bc81-5053-978d-69d48a52b1eb\" :answer/value \"\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C\"] [\"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/id #uuid \"31a87405-12d1-5965-8b57-28bf462411d1\"] [\"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/type :answer.type/math] [\"31a87405-12d1-5965-8b57-28bf462411d1\" :answer/value \"\\\\frac{2 \\\\sin{\\\\left(\\\\frac{x^{3}}{2} \\\\right)}}{3}+C\"] [\"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/id #uuid \"dc7bb8dc-54f4-520d-8640-d38feb7266de\"] [\"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/type :answer.type/math] [\"dc7bb8dc-54f4-520d-8640-d38feb7266de\" :answer/value \"x^{3}+C\"] [\"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/id #uuid \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\"] [\"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/type :answer.type/math] [\"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\" :answer/value \"2 \\\\sin{\\\\left(x^{3} \\\\right)}+C\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/id #uuid \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/key \"answer\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/type :answer-field.type/radio] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"345fbf49-c123-513b-9942-467ab8f3a099\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"7a56bea5-bc81-5053-978d-69d48a52b1eb\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"31a87405-12d1-5965-8b57-28bf462411d1\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"dc7bb8dc-54f4-520d-8640-d38feb7266de\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/choices \"01f52cb1-7359-5210-a27f-8c2ec1aae0c0\"] [\"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\" :answer-field/correct \"7a56bea5-bc81-5053-978d-69d48a52b1eb\"] [\"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/id #uuid \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\"] [\"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\sin{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"] [\"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/difficulty :question.difficulty/easy] [\"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\" :question/answer-fields \"93bc30a4-c97a-5d5f-b47a-66893b4d9bce\"] [17592186068917 :knowledge-point/questions \"2fecdd9d-24dc-5919-8d6e-cfd9385edffe\"] [\"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/id #uuid \"d3652321-73af-5af5-81a1-f8606ecb2b62\"] [\"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/type :answer.type/math] [\"d3652321-73af-5af5-81a1-f8606ecb2b62\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x \\\\right)}}{2}+C\"] [\"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/id #uuid \"1b303114-90f6-53da-9684-1f7ba22d0fd5\"] [\"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/type :answer.type/math] [\"1b303114-90f6-53da-9684-1f7ba22d0fd5\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x^{2} \\\\right)}}{2}+C\"] [\"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/id #uuid \"9b87b68a-4006-589d-9c30-70eef6721874\"] [\"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/type :answer.type/math] [\"9b87b68a-4006-589d-9c30-70eef6721874\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x^{2} \\\\right)}}{4}+C\"] [\"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/id #uuid \"f0c15454-7fb6-5689-b8a5-a28364a66647\"] [\"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/type :answer.type/math] [\"f0c15454-7fb6-5689-b8a5-a28364a66647\" :answer/value \"\\\\frac{9 \\\\tan{\\\\left(x^{2} \\\\right)}}{2}+C\"] [\"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/id #uuid \"85291b8c-46f2-56ed-9300-7ad5be0cde43\"] [\"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/type :answer.type/math] [\"85291b8c-46f2-56ed-9300-7ad5be0cde43\" :answer/value \"\\\\frac{3 \\\\tan{\\\\left(2 x^{2} \\\\right)}}{2}+C\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/id #uuid \"1803a769-2043-5e90-894c-dc2cfddf718f\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/key \"answer\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/type :answer-field.type/radio] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"d3652321-73af-5af5-81a1-f8606ecb2b62\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"1b303114-90f6-53da-9684-1f7ba22d0fd5\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"9b87b68a-4006-589d-9c30-70eef6721874\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"f0c15454-7fb6-5689-b8a5-a28364a66647\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/choices \"85291b8c-46f2-56ed-9300-7ad5be0cde43\"] [\"1803a769-2043-5e90-894c-dc2cfddf718f\" :answer-field/correct \"1b303114-90f6-53da-9684-1f7ba22d0fd5\"] [\"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/id #uuid \"836e3cff-5a63-5505-90cd-9ba385b65fb2\"] [\"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant.\"] [\"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{3 \\\\tan{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{3 \\\\tan{\\\\left(x^{2} \\\\right)}}{2}+C.\\n$$\"] [\"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/difficulty :question.difficulty/easy] [\"836e3cff-5a63-5505-90cd-9ba385b65fb2\" :question/answer-fields \"1803a769-2043-5e90-894c-dc2cfddf718f\"] [17592186068917 :knowledge-point/questions \"836e3cff-5a63-5505-90cd-9ba385b65fb2\"] [\"generator\" :question-generator/id #uuid \"8608026d-d3f5-5209-afed-bfea42b4ca68\"] [\"generator\" :question-generator/script \"generators/5d/5dffbaf59822612035565b2974ffc45d6531e74d0f089df001b14bdd505ae5a3/generator.py\"] [17592186068917 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186068917 :knowledge-point/question-generator 17592186682620]]}",
