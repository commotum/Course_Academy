  "before_edn": "{:db/id 17592186068917 :knowledge-point/canonical-example {:db/id 17592186068569 :question/id #uuid \"234c7a86-037c-5316-9419-14db90d1da60\" :question/math-academy-id \"e-466\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int x^2 \\\\sec^2\\\\left(x^3-\\\\dfrac{\\\\pi}{6}\\\\right)\\\\,\\\\textrm d x.\\n$$\" :question/worked-solution \"Let $u = x^3 - \\\\dfrac{\\\\pi}{6}.$ Differentiating, we have\\n\\n$$\\n\\\\dfrac{\\\\textrm{d} u}{\\\\textrm{d}x } = 3x^2 \\\\quad\\\\Longrightarrow\\\\quad \\\\dfrac 1 3 \\\\textrm d u = x^2\\\\,\\\\textrm d x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}{sec}^{2}⁡({x}^{3}-\\\\frac{\\\\pi }{6})\\\\,\\\\text{d}x & =\\\\int {sec}^{2}⁡({x}^{3}-\\\\frac{\\\\pi }{6})\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {sec}^{2}⁡(u)\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\int {sec}^{2}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{tan}⁡u+C \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{tan}⁡({x}^{3}-\\\\frac{\\\\pi }{6})+C\\\\end{aligned}\\n$$\"} :knowledge-point/id #uuid \"d359337c-4ec2-5100-bdac-d0858619db3b\" :knowledge-point/level-coverage [{:db/ident :question.difficulty/hard} {:db/ident :question.difficulty/moderate}] :knowledge-point/question-generator {:db/id 17592186682620 :question-generator/id #uuid \"77f57477-b1b8-5082-9e7f-133d85fa9462\" :question-generator/script \"generators/10/10f57f79b5f965f5200744a65337dc01ec15c5748bb8f67a16ca8576b6e03022/generator.py\"} :knowledge-point/questions [{:db/id 17592186069045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"91d866f1-e720-5398-a46e-0722090f6821\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos (x^{2}) + C\" :db/id 17592186065704} {:answer/id #uuid \"c75da138-5eaf-58e3-a55c-12f0301a6fde\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\cos (x^{2}) + C\" :db/id 17592186065705} {:answer/id #uuid \"ef04e350-3350-5a0b-a549-5f78e588537b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\cos (x^{2}) + C\" :db/id 17592186065706} {:answer/id #uuid \"3a105d51-4ff7-5170-ac6d-b385e94641b3\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\cos (x^{2}) + C\" :db/id 17592186065707} {:answer/id #uuid \"540349cb-bc1a-5e4c-8d86-026eb01a1818\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\cos (x^{2}) + C\" :db/id 17592186065708}] :answer-field/id #uuid \"6cfbbaf7-a063-5438-b10b-9280b277421d\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186065703}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"2a7f0dcc-b7a4-5602-a929-f05d47269ff4\" :question/math-academy-id \"q-13461\" :question/problem \"Calculate $\\\\intx\\\\sin (x^{2})dx$.\"} {:db/id 17592186069046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3a9ba381-dfc6-54d8-b261-945875616b86\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186266662} {:answer/id #uuid \"9828aecd-8ee6-528b-84cd-c4bcd17317b2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\operatorname{sec}⁡({x}^{3})+C\" :db/id 17592186267508} {:answer/id #uuid \"c2c830ad-dfcc-5ddf-a4bf-a03b19a9f887\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186267881} {:answer/id #uuid \"f14834f1-3a8c-5e06-be70-0657e9f80ea7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186268290} {:answer/id #uuid \"fe106718-50d2-53cd-a30d-c21520e167e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186268381}] :answer-field/correct {:answer/id #uuid \"fe106718-50d2-53cd-a30d-c21520e167e8\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186268381} :answer-field/id #uuid \"19c18458-8765-5ccd-8e3b-95cdb8f39a5e\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186268448}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a1978088-009a-552d-a613-5fc9a66c590e\" :question/math-academy-id \"q-13474\" :question/problem \"$$\\n\\\\displaystyle \\\\int 4{x}^{2}{sec}^{2}⁡({x}^{3})\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let $u={x}^{3}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{x}^{2}\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 4{x}^{2}{sec}^{2}⁡({x}^{3})\\\\,\\\\text{d}x & =4\\\\int {sec}^{2}⁡({x}^{3})\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =4\\\\int {sec}^{2}⁡(u)\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{4}{3}\\\\int {sec}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{4}{3}\\\\operatorname{tan}⁡u+C \\\\\\\\  & =\\\\frac{4}{3}\\\\operatorname{tan}⁡({x}^{3})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186269003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"31a3a928-39e8-519d-8e4b-7c0882dd6b6e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186266580} {:answer/id #uuid \"4bc87232-7fa2-5455-9bba-0f566c45856c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{csc}⁡({x}^{2})+C\" :db/id 17592186266815} {:answer/id #uuid \"b14b1ce8-4234-539c-a803-8f5ab3f5fe07\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186267738} {:answer/id #uuid \"bf43c962-7cbd-5860-878b-8cb93ec9cd06\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{4}\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186267858} {:answer/id #uuid \"c412de53-dcb8-561f-b75c-83b12fa53e7d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186267896}] :answer-field/correct {:answer/id #uuid \"c412de53-dcb8-561f-b75c-83b12fa53e7d\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186267896} :answer-field/id #uuid \"6edf94d4-6780-5605-a47c-83b77d601c42\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186268609}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9cb5aaff-6467-5367-a002-45fca048bd67\" :question/math-academy-id \"q-13464\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int x{csc}^{2}⁡({x}^{2})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u={x}^{2}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int x{csc}^{2}⁡({x}^{2})\\\\,\\\\text{d}x & =\\\\int {csc}^{2}⁡({x}^{2})\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {csc}^{2}⁡u\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int {csc}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{cot}⁡u+C \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{cot}⁡({x}^{2})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186269033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2bba42d0-4d22-55d1-bf2a-5afa7f154545\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186266532} {:answer/id #uuid \"6f0dba1e-ebd9-58df-9ff0-a39f534c6156\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\" :db/id 17592186267118} {:answer/id #uuid \"9a78f2b9-be60-5dd9-a1b2-d3dae91c37e1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5}{4}\" :db/id 17592186267540} {:answer/id #uuid \"a54496d0-737c-5f0e-b323-1106d3723e9a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\" :db/id 17592186267634} {:answer/id #uuid \"da3d8464-42f7-59e9-bbc9-ba3a5c255583\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186268077}] :answer-field/correct {:answer/id #uuid \"2bba42d0-4d22-55d1-bf2a-5afa7f154545\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186266532} :answer-field/id #uuid \"464dd787-aac1-5fd3-8b68-a426f70499c4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186268525}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"5d3c5f6c-be88-5a7d-88c2-f5f9124aa97d\" :question/math-academy-id \"q-13533\" :question/problem \"$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\sqrt{\\\\pi /2}}5x\\\\operatorname{cos}⁡(2{x}^{2})\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let $u=2{x}^{2}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4x\\\\,⟹\\\\,\\\\frac{1}{4}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\sqrt{\\\\pi /2}$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $\\\\pi $ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\sqrt{\\\\pi /2}}5x\\\\operatorname{cos}⁡(2{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\sqrt{\\\\pi /2}}5\\\\operatorname{cos}⁡(2{x}^{2})\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{0}^{\\\\pi }5\\\\operatorname{cos}⁡u\\\\cdot \\\\frac{1}{4}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{4}{\\\\int }_{0}^{\\\\pi }\\\\operatorname{cos}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{4}\\\\operatorname{sin}⁡u{|}_{0}^{\\\\pi } \\\\\\\\  & =\\\\frac{5}{4}(\\\\operatorname{sin}⁡(\\\\pi )-\\\\operatorname{sin}⁡(0)) \\\\\\\\  & =\\\\frac{5}{4}(0) \\\\\\\\  & =0\\\\end{aligned}\\n$$\"} {:db/id 17592186269045 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"573778d5-04ef-570b-bb92-30f2581d353a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\" :db/id 17592186266920} {:answer/id #uuid \"853703e3-5ee8-58a7-a762-0b6b51b9da3b\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186267318} {:answer/id #uuid \"8a690975-9629-524f-8754-019e655cbcf7\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186267378} {:answer/id #uuid \"b4e7245c-ae8f-576f-ad7b-ae3e6def801c\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{3}{4}\" :db/id 17592186267761} {:answer/id #uuid \"c5d49c16-cf0d-5d32-ac21-f912a3f35a4f\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186267918}] :answer-field/correct {:answer/id #uuid \"c5d49c16-cf0d-5d32-ac21-f912a3f35a4f\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186267918} :answer-field/id #uuid \"d8a52cc8-a59a-5790-8e07-7483e8b8eee9\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186268791}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"f9af6a27-d8cc-5d10-84b4-1e204dd24944\" :question/math-academy-id \"q-13537\" :question/problem \"Evaluate the integral $$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\sqrt{\\\\pi }}3x\\\\operatorname{sin}⁡(2{x}^{2})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u=2{x}^{2}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=4x\\\\,⟹\\\\,\\\\frac{1}{4}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\sqrt{\\\\pi }$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $2\\\\pi $ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\sqrt{\\\\pi }}3x\\\\operatorname{sin}⁡(2{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\sqrt{\\\\pi }}3\\\\operatorname{sin}⁡(2{x}^{2})\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{0}^{2\\\\pi }3\\\\operatorname{sin}⁡u\\\\cdot \\\\frac{1}{4}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{3}{4}{\\\\int }_{0}^{2\\\\pi }\\\\operatorname{sin}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{3}{4}\\\\operatorname{cos}⁡u{|}_{0}^{2\\\\pi } \\\\\\\\  & =-\\\\frac{3}{4}(\\\\operatorname{cos}⁡(2\\\\pi )-\\\\operatorname{cos}⁡(0)) \\\\\\\\  & =-\\\\frac{3}{4}(1-1) \\\\\\\\  & =-\\\\frac{3}{4}\\\\cdot 0 \\\\\\\\  & =0\\\\end{aligned}\\n$$\"} {:db/id 17592186297287 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4675341d-47de-58d1-9169-e4ea300f6534\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{tan}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\" :db/id 17592186295666} {:answer/id #uuid \"49060b70-8ca0-5560-a25f-c33fdf13abe5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cot}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\" :db/id 17592186295684} {:answer/id #uuid \"73e82961-671e-5f43-927c-85b68cebb79e\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{csc}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\" :db/id 17592186295902} {:answer/id #uuid \"8cc5e39c-b266-5cff-bbd7-b9a7c961e739\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{sec}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\" :db/id 17592186296018} {:answer/id #uuid \"902705ff-4eac-5fc0-8d8a-b9ebd4cdfeff\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{tan}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\" :db/id 17592186296039}] :answer-field/correct {:answer/id #uuid \"4675341d-47de-58d1-9169-e4ea300f6534\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{tan}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\" :db/id 17592186295666} :answer-field/id #uuid \"4c5828d6-8af8-5472-82db-0c5fb62611d4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186296780}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"7ade3ef7-2470-5279-802e-68d9ba79206f\" :question/math-academy-id \"q-3038\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int \\\\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u=\\\\frac{1}{x}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=-\\\\frac{1}{{x}^{2}}\\\\,⟹\\\\,-\\\\text{d}u=\\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{{sec}^{2}⁡(1/x)}{{x}^{2}}\\\\,\\\\text{d}x & =\\\\int {sec}^{2}⁡\\\\left(\\\\frac{1}{x}\\\\right)\\\\cdot \\\\frac{1}{{x}^{2}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {sec}^{2}⁡u\\\\cdot (-\\\\text{d}u) \\\\\\\\  & =-\\\\int {sec}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{tan}⁡u+C \\\\\\\\  & =-\\\\operatorname{tan}⁡\\\\left(\\\\frac{1}{x}\\\\right)+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186319366 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8483f978-0eb7-58b8-8af7-e33b9170b809\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186318016}] :answer-field/correct {:answer/id #uuid \"8483f978-0eb7-58b8-8af7-e33b9170b809\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186318016} :answer-field/id #uuid \"072ef757-3ef7-5291-a2b9-f78bdb72dd2b\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318442}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b2f52a91-e2df-5743-9b16-3551c628a81b\" :question/math-academy-id \"q-350202\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\sqrt{\\\\pi /12}}8xsec\\\\,(4{x}^{2})tan\\\\,(4{x}^{2})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=4{x}^{2},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=8x\\\\,⟹\\\\,\\\\text{d}u=8x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\sqrt{\\\\pi /12}$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $\\\\pi /3$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\sqrt{\\\\pi /12}}8xsec\\\\,(4{x}^{2})tan\\\\,(4{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\sqrt{\\\\pi /12}}sec\\\\,(4{x}^{2})tan\\\\,(4{x}^{2})\\\\cdot 8x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{0}^{\\\\pi /3}\\\\operatorname{sec}⁡(u)\\\\operatorname{tan}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{sec}⁡(u)\\\\,{|}_{0}^{\\\\pi /3} \\\\\\\\  & =\\\\operatorname{sec}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-\\\\operatorname{sec}⁡(0) \\\\\\\\  & =2-1 \\\\\\\\  & =1\\\\end{aligned}\\n$$\"} {:db/id 17592186319367 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6a0832f3-44e5-55dc-b0d6-cde9d7754977\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186317931}] :answer-field/correct {:answer/id #uuid \"6a0832f3-44e5-55dc-b0d6-cde9d7754977\" :answer/type {:db/ident :answer.type/math} :answer/value \"-1\" :db/id 17592186317931} :answer-field/id #uuid \"81013bc8-e699-5fa8-92f3-108172fec02c\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186318703}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4977c738-ef65-5d72-9699-ec8683cb5818\" :question/math-academy-id \"q-350203\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\sqrt{\\\\pi /12}}^{\\\\sqrt{\\\\pi /6}}12x\\\\operatorname{cos}⁡(6{x}^{2})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=6{x}^{2},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=12x\\\\,⟹\\\\,\\\\text{d}u=12x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\sqrt{\\\\pi /12}$ | $\\\\sqrt{\\\\pi /6}$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /2$ | $\\\\pi $ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\sqrt{\\\\pi /12}}^{\\\\sqrt{\\\\pi /6}}12x\\\\operatorname{cos}⁡(6{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{\\\\sqrt{\\\\pi /12}}^{\\\\sqrt{\\\\pi /6}}\\\\operatorname{cos}⁡(6{x}^{2})\\\\cdot 12x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{\\\\pi /2}^{\\\\pi }\\\\operatorname{cos}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{sin}⁡(u)\\\\,{|}_{\\\\pi /2}^{\\\\pi } \\\\\\\\  & =\\\\operatorname{sin}⁡(\\\\pi )-\\\\operatorname{sin}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right) \\\\\\\\  & =0-1 \\\\\\\\  & =-1\\\\end{aligned}\\n$$\"} {:db/id 17592186486542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"67db1928-5d77-5d01-9982-b91efb720baf\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cot{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486547} {:answer/id #uuid \"80b3b820-877a-56c3-86d8-db243bd28b5d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486551} {:answer/id #uuid \"8414f7a2-369f-5120-b9a8-467cd2cbffd3\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\cot{\\\\left(x^{2} \\\\right)}}{2}+C\" :db/id 17592186486553} {:answer/id #uuid \"8dcad831-351c-5fb6-8252-0ad06ca0e301\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\cot{\\\\left(x^{2} \\\\right)}}{2}+C\" :db/id 17592186486554} {:answer/id #uuid \"d2010a1d-48cd-5e3a-8bb6-9f30dbdd2492\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cot{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486561}] :answer-field/correct {:answer/id #uuid \"67db1928-5d77-5d01-9982-b91efb720baf\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cot{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486547} :answer-field/id #uuid \"240f4141-c6e4-573e-9f31-860c6fa6e3b0\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186486545}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"002482ff-69a9-5b63-b3f0-5cd70a51819a\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int 2 x \\\\csc^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\text{d}x.\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{2},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2 x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 2 x \\\\csc^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\text{d}x &= 1\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\text{d}u \\\\\\\\ &= - \\\\cot{\\\\left(u \\\\right)}+C \\\\\\\\ &= - \\\\cot{\\\\left(x^{2} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186486552 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0b2b14aa-939d-5f78-95d5-a8ac2d5a46b9\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486543} {:answer/id #uuid \"1202f884-82b1-540e-bfd1-0ee80ba2c514\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cos{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486544} {:answer/id #uuid \"b9b4275b-87e1-5689-822b-8dac3c858579\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\cos{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486558} {:answer/id #uuid \"cb6699db-b1f0-5226-8168-b9ec448eac86\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\cos{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486560} {:answer/id #uuid \"fcef9471-29d4-56f5-9a65-4b6c75538bcf\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 4 \\\\cos{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486562}] :answer-field/correct {:answer/id #uuid \"0b2b14aa-939d-5f78-95d5-a8ac2d5a46b9\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{2} \\\\right)}+C\" :db/id 17592186486543} :answer-field/id #uuid \"79c1360c-2029-597a-92dc-abe7f1cbfea3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186486550}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"82583355-6299-599e-bdc6-d65fa8aebd0a\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int 2 x \\\\sin{\\\\left(x^{2} \\\\right)}\\\\,\\\\text{d}x.\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{2},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2 x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 2 x \\\\sin{\\\\left(x^{2} \\\\right)}\\\\,\\\\text{d}x &= 1\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\text{d}u \\\\\\\\ &= - \\\\cos{\\\\left(u \\\\right)}+C \\\\\\\\ &= - \\\\cos{\\\\left(x^{2} \\\\right)}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186486555 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"28b0a88b-6033-5a60-beab-0cbad3f7fed3\" :answer/type {:db/ident :answer.type/math} :answer/value \"6 \\\\tan{\\\\left(x^{3} \\\\right)}+C\" :db/id 17592186486546} {:answer/id #uuid \"6f9bacea-3262-508b-9719-4fd80bf9d534\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\sec{\\\\left(x^{3} \\\\right)}}{3}+C\" :db/id 17592186486548} {:answer/id #uuid \"79463279-bba4-5ce7-b66d-91ca6c29fee1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\tan{\\\\left(x^{3} \\\\right)}}{3}+C\" :db/id 17592186486549} {:answer/id #uuid \"b44d88f2-1b54-541f-aa56-dae6e3f577f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3 \\\\tan{\\\\left(x^{3} \\\\right)}}{2}+C\" :db/id 17592186486556} {:answer/id #uuid \"c04acc4c-98a0-5857-8fdc-cdb07ac37366\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\tan{\\\\left(x^{3} \\\\right)}+C\" :db/id 17592186486559}] :answer-field/correct {:answer/id #uuid \"79463279-bba4-5ce7-b66d-91ca6c29fee1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{8 \\\\tan{\\\\left(x^{3} \\\\right)}}{3}+C\" :db/id 17592186486549} :answer-field/id #uuid \"b59d98d5-6b64-56b9-afca-bffec0e1eaf3\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186486557}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9f181c0b-4ade-5cfb-806e-89c254367d4c\" :question/problem \"$$\\n\\\\displaystyle \\\\int 8 x^{2} \\\\sec^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\text{d}x=\\n$$\" :question/retired true :question/worked-solution \"Let $u=x^{3},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3 x^{2}.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 8 x^{2} \\\\sec^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\text{d}x &= \\\\frac{8}{3}\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\text{d}u \\\\\\\\ &= \\\\frac{8 \\\\tan{\\\\left(u \\\\right)}}{3}+C \\\\\\\\ &= \\\\frac{8 \\\\tan{\\\\left(x^{3} \\\\right)}}{3}+C\\\\end{aligned}\\n$$\"} {:db/id 17592186580879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1536851e-467a-513f-a39f-a987ce9f476f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{sec}⁡({x}^{3})+C\" :db/id 17592186580419} {:answer/id #uuid \"419eae3a-7c99-539d-9f8c-43bd5d3ee2ab\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186580497} {:answer/id #uuid \"57682a10-50f1-57c4-b856-6b7dcb623188\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sec}⁡({x}^{3})+C\" :db/id 17592186580531} {:answer/id #uuid \"fb615c57-9a5f-515f-9538-4b290aa37b2d\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{sec}⁡({x}^{3})+C\" :db/id 17592186580784} {:answer/id #uuid \"fd9a6454-9002-50d7-81dc-56d4699c4393\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{tan}⁡({x}^{3})+C\" :db/id 17592186580788}] :answer-field/correct {:answer/id #uuid \"1536851e-467a-513f-a39f-a987ce9f476f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{sec}⁡({x}^{3})+C\" :db/id 17592186580419} :answer-field/id #uuid \"ed6dccc4-202e-5529-b8af-ac630177fe14\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580874}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"038974cd-ae48-5200-9bdc-eb592bd2ef40\" :question/math-academy-id \"q-13467\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int {x}^{2}\\\\operatorname{sec}⁡({x}^{3})\\\\operatorname{tan}⁡({x}^{3})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u={x}^{3}$, Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{x}^{2}\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int {x}^{2}\\\\operatorname{sec}⁡({x}^{3})\\\\operatorname{tan}⁡({x}^{3})\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{sec}⁡({x}^{3})\\\\operatorname{tan}⁡({x}^{3})\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\int \\\\operatorname{sec}⁡u\\\\operatorname{tan}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{sec}⁡u+C \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{sec}⁡({x}^{3})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186580887 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0b4cd558-9e46-545e-9b83-95b0ce86e4f9\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{3}\\\\operatorname{csc}⁡({x}^{3})+C\" :db/id 17592186580405} {:answer/id #uuid \"1a0cd29b-2281-5fdf-b83a-3d81905f346b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{cot}⁡({x}^{3})+C\" :db/id 17592186580425} {:answer/id #uuid \"2ff41e67-12fd-5ad3-95e3-b11f2dafd8a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{csc}⁡({x}^{3})+C\" :db/id 17592186580466} {:answer/id #uuid \"3ae7711a-aefc-5cb7-b38b-ebf016041585\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{cot}⁡({x}^{3})+C\" :db/id 17592186580486} {:answer/id #uuid \"a1cd5e71-b7f5-5663-936f-68abc2dbf93c\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\operatorname{csc}⁡({x}^{3})+C\" :db/id 17592186580658}] :answer-field/correct {:answer/id #uuid \"2ff41e67-12fd-5ad3-95e3-b11f2dafd8a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\operatorname{csc}⁡({x}^{3})+C\" :db/id 17592186580466} :answer-field/id #uuid \"c8e9515f-e4f9-5256-98c2-11c0b1c56ec8\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580864}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"185fc978-acea-5e9e-aec8-3d21ff92c62e\" :question/math-academy-id \"q-13470\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 3{x}^{2}\\\\operatorname{csc}⁡({x}^{3})\\\\operatorname{cot}⁡({x}^{3})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u={x}^{3}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{x}^{2}\\\\,⟹\\\\,\\\\text{d}u=3{x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 3{x}^{2}\\\\operatorname{csc}⁡({x}^{3})\\\\operatorname{cot}⁡({x}^{3})\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{csc}⁡({x}^{3})\\\\operatorname{cot}⁡({x}^{3})\\\\cdot 3{x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{csc}⁡u+C \\\\\\\\  & =-\\\\operatorname{csc}⁡({x}^{3})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186580930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"399980b9-86fd-5875-909a-55ccdeec0bc9\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186580483}] :answer-field/correct {:answer/id #uuid \"399980b9-86fd-5875-909a-55ccdeec0bc9\" :answer/type {:db/ident :answer.type/math} :answer/value \"0\" :db/id 17592186580483} :answer-field/id #uuid \"2147e959-626e-5c5e-a384-3e369b129c13\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186580807}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"95f61cbe-50e0-52a1-9899-3308592615d8\" :question/math-academy-id \"q-350186\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{0}^{\\\\sqrt{\\\\pi /4}}8x\\\\operatorname{cos}⁡(4{x}^{2})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=4{x}^{2},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=8x\\\\,⟹\\\\,\\\\text{d}u=8x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $0$ | $\\\\sqrt{\\\\pi /4}$ |\\n| --- | --- | --- |\\n| $u$ | $0$ | $\\\\pi$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{0}^{\\\\sqrt{\\\\pi /4}}8x\\\\operatorname{cos}⁡(4{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{0}^{\\\\sqrt{\\\\pi /4}}\\\\operatorname{cos}⁡(4{x}^{2})\\\\cdot 8x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{0}^{\\\\pi }\\\\operatorname{cos}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =\\\\operatorname{sin}⁡(u)\\\\,{|}_{0}^{\\\\pi } \\\\\\\\  & =\\\\operatorname{sin}⁡(\\\\pi )-\\\\operatorname{sin}⁡(0) \\\\\\\\  & =0-0 \\\\\\\\  & =0\\\\end{aligned}\\n$$\"} {:db/id 17592186580949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"143b0cf4-599c-56a0-9697-0fd3b6ad7b6f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{sin}⁡({x}^{3})+C\" :db/id 17592186580415} {:answer/id #uuid \"2da5f0d2-90ae-5eae-81fe-3ad54334ae4b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5}{3}\\\\operatorname{sin}⁡({x}^{3})+C\" :db/id 17592186580460} {:answer/id #uuid \"a609fb08-4df5-5f2f-b07c-716c4b0fa8c6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{sin}⁡({x}^{3})+C\" :db/id 17592186580666} {:answer/id #uuid \"c625891a-9893-5be4-8d26-dd89a0f3f09e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{sin}⁡(3{x}^{2})+C\" :db/id 17592186580696} {:answer/id #uuid \"f6631fd8-eb98-5921-a11b-8cab13d33385\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5}{3}\\\\operatorname{sin}⁡({x}^{2})+C\" :db/id 17592186580776}] :answer-field/correct {:answer/id #uuid \"2da5f0d2-90ae-5eae-81fe-3ad54334ae4b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5}{3}\\\\operatorname{sin}⁡({x}^{3})+C\" :db/id 17592186580460} :answer-field/id #uuid \"8cd33e1c-d19d-5110-b549-226f09fdc6db\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186580844}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c8478693-7123-504b-ab62-3a7e2bce3f4a\" :question/math-academy-id \"q-13471\" :question/problem \"$$\\n\\\\displaystyle \\\\int 5{x}^{2}\\\\operatorname{cos}⁡({x}^{3})\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let $u={x}^{3}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{x}^{2}\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 5{x}^{2}\\\\operatorname{cos}⁡({x}^{3})\\\\,\\\\text{d}x & =\\\\int 5\\\\operatorname{cos}⁡({x}^{3})\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int 5\\\\operatorname{cos}⁡u\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\int \\\\operatorname{cos}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{5}{3}\\\\operatorname{sin}⁡u+C \\\\\\\\  & =\\\\frac{5}{3}\\\\operatorname{sin}⁡({x}^{3})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186605837 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5841f26e-e77f-5abf-8554-e49b74956114\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{tan}⁡({x}^{2})+C\" :db/id 17592186605411} {:answer/id #uuid \"ad4068a3-7725-577e-884c-b90d2c736c8d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{4}\\\\operatorname{tan}⁡({x}^{2})+C\" :db/id 17592186605570} {:answer/id #uuid \"bb027bbd-ba2d-5754-a425-ba0860b0a7f4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{tan}⁡({x}^{2})+C\" :db/id 17592186605592} {:answer/id #uuid \"e0cf21a2-6ecf-507d-a9c4-69f7f0f50726\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{sec}⁡({x}^{2})+C\" :db/id 17592186605661} {:answer/id #uuid \"fab56faa-facf-50d9-bd7a-d52d97b81de9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{tan}⁡({x}^{2})+C\" :db/id 17592186605708}] :answer-field/correct {:answer/id #uuid \"fab56faa-facf-50d9-bd7a-d52d97b81de9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{tan}⁡({x}^{2})+C\" :db/id 17592186605708} :answer-field/id #uuid \"0fb66e89-485f-5599-801d-5b503ee20e58\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186605721}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"1b7a1c4f-ee46-59c2-a0d1-028c953d1f17\" :question/math-academy-id \"q-13460\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int x{sec}^{2}⁡({x}^{2})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u={x}^{2}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x\\\\,⟹\\\\,\\\\frac{1}{2}\\\\,\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int x{sec}^{2}⁡({x}^{2})\\\\,\\\\text{d}x & =\\\\int {sec}^{2}⁡({x}^{2})\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int {sec}^{2}⁡u\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int {sec}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{tan}⁡u+C \\\\\\\\  & =\\\\frac{1}{2}\\\\operatorname{tan}⁡({x}^{2})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186605847 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"084d6296-4e0e-5291-a90f-82b7617ff7a1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{3}\" :db/id 17592186605264} {:answer/id #uuid \"2341f810-fcdd-5f61-be44-39e52dde1228\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{9}\" :db/id 17592186605311} {:answer/id #uuid \"320634f0-cac2-5787-bb32-88a333793829\" :answer/type {:db/ident :answer.type/math} :answer/value \"4\\\\sqrt{3}\" :db/id 17592186605344} {:answer/id #uuid \"86afb790-2d4b-5953-a77a-737ee084b7a3\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{3}\" :db/id 17592186605490} {:answer/id #uuid \"a9fbf28e-c6bd-5a97-8692-75b54a26c81b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sqrt{3}}{6}\" :db/id 17592186605562}] :answer-field/correct {:answer/id #uuid \"2341f810-fcdd-5f61-be44-39e52dde1228\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\sqrt{3}}{9}\" :db/id 17592186605311} :answer-field/id #uuid \"d01f36ee-521c-54fe-9274-182cb22b18d4\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186605813}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"3d11b8d3-3d89-559d-9bb2-2df9905b80bd\" :question/math-academy-id \"q-13544\" :question/problem \"$$\\n\\\\displaystyle {\\\\int }_{\\\\sqrt{\\\\pi /18}}^{\\\\sqrt{\\\\pi /9}}2x{sec}^{2}⁡(3{x}^{2})\\\\,\\\\text{d}x=\\n$$\" :question/worked-solution \"Let $u=3{x}^{2}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=6x\\\\,⟹\\\\,\\\\frac{1}{6}\\\\,\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\sqrt{\\\\pi /18}$ | $\\\\sqrt{\\\\pi /9}$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\frac{\\\\pi }{6}$ | $\\\\frac{\\\\pi }{3}$ |\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\sqrt{\\\\pi /18}}^{\\\\sqrt{\\\\pi /9}}2x{sec}^{2}⁡(3{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{\\\\sqrt{\\\\pi /18}}^{\\\\sqrt{\\\\pi /9}}2{sec}^{2}⁡(3{x}^{2})\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{\\\\pi /6}^{\\\\pi /3}2{sec}^{2}⁡u\\\\cdot \\\\frac{1}{6}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}{\\\\int }_{\\\\pi /6}^{\\\\pi /3}{sec}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{3}\\\\operatorname{tan}⁡u{|}_{\\\\pi /6}^{\\\\pi /3} \\\\\\\\  & =\\\\frac{1}{3}(\\\\operatorname{tan}⁡\\\\left(\\\\frac{\\\\pi }{3}\\\\right)-\\\\operatorname{tan}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)) \\\\\\\\  & =\\\\frac{1}{3}(\\\\sqrt{3}-\\\\frac{1}{\\\\sqrt{3}}) \\\\\\\\  & =\\\\frac{1}{3}\\\\left(\\\\frac{2}{\\\\sqrt{3}}\\\\right) \\\\\\\\  & =\\\\frac{2\\\\sqrt{3}}{9}\\\\end{aligned}\\n$$\"} {:db/id 17592186611646 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"16adda69-f89e-5bfd-af50-5b8bdb679010\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{x}\\\\operatorname{sin}⁡(\\\\sqrt{x})+C\" :db/id 17592186611107} {:answer/id #uuid \"35602054-babb-540a-9b9d-a91bf0cf7892\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\operatorname{sin}⁡(\\\\sqrt{x})}{2}+C\" :db/id 17592186611150} {:answer/id #uuid \"4ad15320-a1c5-5373-af1d-0273c9fbce64\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{sin}⁡(\\\\sqrt{x})+C\" :db/id 17592186611180} {:answer/id #uuid \"96c61819-0fb7-50f0-b5d8-8d48e3ea6491\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\sqrt{x}\\\\operatorname{cos}⁡(\\\\sqrt{x})+C\" :db/id 17592186611307} {:answer/id #uuid \"cff5f868-a0dd-5fc7-ad99-0ff5e51cab1a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2\\\\operatorname{sin}⁡(\\\\sqrt{x})}{\\\\sqrt{x}}+C\" :db/id 17592186611398}] :answer-field/correct {:answer/id #uuid \"4ad15320-a1c5-5373-af1d-0273c9fbce64\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{sin}⁡(\\\\sqrt{x})+C\" :db/id 17592186611180} :answer-field/id #uuid \"447f0452-c7c0-5061-ac54-ed0e8121ebfa\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186611488}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f8b1a93e-d361-59f6-a945-adc08b0914f2\" :question/math-academy-id \"q-2377\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int \\\\frac{\\\\operatorname{cos}⁡(\\\\sqrt{x})}{\\\\sqrt{x}}\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u=\\\\sqrt{x}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=\\\\frac{1}{2\\\\sqrt{x}}\\\\,⟹\\\\,2\\\\,\\\\text{d}u=\\\\frac{1}{\\\\sqrt{x}}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\begin{aligned}\\\\int \\\\frac{\\\\operatorname{cos}⁡(\\\\sqrt{x})}{\\\\sqrt{x}}\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{cos}⁡(\\\\sqrt{x})\\\\cdot \\\\frac{1}{\\\\sqrt{x}}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\operatorname{cos}⁡u\\\\cdot 2\\\\,\\\\text{d}u \\\\\\\\  & =2\\\\int \\\\operatorname{cos}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =2\\\\operatorname{sin}⁡u+C \\\\\\\\  & =2\\\\operatorname{sin}⁡(\\\\sqrt{x})+C\\\\end{aligned}\\\\end{aligned}\\n$$\"} {:db/id 17592186657446 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"00d572ac-01af-5955-82aa-3e768b36e2f8\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186657049}] :answer-field/correct {:answer/id #uuid \"00d572ac-01af-5955-82aa-3e768b36e2f8\" :answer/type {:db/ident :answer.type/math} :answer/value \"1\" :db/id 17592186657049} :answer-field/id #uuid \"a6512d6a-335a-528d-b7fb-d8511385140d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186657402}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1bf4d546-3968-549c-809c-efe4c07584b8\" :question/math-academy-id \"q-350883\" :question/problem \"Evaluate the following integral. Do not round the answer.\\n\\n$$\\n\\\\displaystyle {\\\\int }_{\\\\sqrt{\\\\pi /30}}^{\\\\sqrt{\\\\pi /10}}10xcsc\\\\,(5{x}^{2})cot\\\\,(5{x}^{2})\\\\,\\\\text{d}x=\\n$$\\n{{field-1}}\" :question/worked-solution \"If we let $u=5{x}^{2},$ then\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=10x\\\\,⟹\\\\,\\\\text{d}u=10x\\\\,\\\\text{d}x.\\n$$\\n\\nCalculating the limits for $u$ gives\\n\\n| $x$ | $\\\\sqrt{\\\\pi /30}$ | $\\\\sqrt{\\\\pi /10}$ |\\n| --- | --- | --- |\\n| $u$ | $\\\\pi /6$ | $\\\\pi /2$ |\\n\\nUsing the above, we can rewrite the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}{\\\\int }_{\\\\sqrt{\\\\pi /30}}^{\\\\sqrt{\\\\pi /10}}10xcsc\\\\,(5{x}^{2})cot\\\\,(5{x}^{2})\\\\,\\\\text{d}x & ={\\\\int }_{\\\\sqrt{\\\\pi /30}}^{\\\\sqrt{\\\\pi /10}}csc\\\\,(5{x}^{2})cot\\\\,(5{x}^{2})\\\\cdot 10x\\\\,\\\\text{d}x \\\\\\\\  & ={\\\\int }_{\\\\pi /6}^{\\\\pi /2}\\\\operatorname{csc}⁡(u)\\\\operatorname{cot}⁡(u)\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\operatorname{csc}⁡(u)\\\\,{|}_{\\\\pi /6}^{\\\\pi /2} \\\\\\\\  & =-(\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{2}\\\\right)-\\\\operatorname{csc}⁡\\\\left(\\\\frac{\\\\pi }{6}\\\\right)) \\\\\\\\  & =-(1-2) \\\\\\\\  & =1\\\\end{aligned}\\n$$\"} {:db/id 17592186658964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0007f85e-299c-5b79-b9ec-8453687d1ce7\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\operatorname{cot}⁡({x}^{3})+C\" :db/id 17592186658407} {:answer/id #uuid \"18a80f2e-bcd8-593d-984d-a492d040e259\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\operatorname{csc}⁡({x}^{3})+C\" :db/id 17592186658435} {:answer/id #uuid \"35a285de-59a9-5b2f-88de-9dae11d3c597\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2}{3}\\\\operatorname{csc}⁡({x}^{3})+C\" :db/id 17592186658482} {:answer/id #uuid \"aea7e1e8-b929-5225-a1c2-e230e26ee364\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2}{3}\\\\operatorname{cot}⁡({x}^{3})+C\" :db/id 17592186658660} {:answer/id #uuid \"d78244c3-8175-5680-ae70-38b7480692ea\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{cot}⁡({x}^{3})+C\" :db/id 17592186658731}] :answer-field/correct {:answer/id #uuid \"aea7e1e8-b929-5225-a1c2-e230e26ee364\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{2}{3}\\\\operatorname{cot}⁡({x}^{3})+C\" :db/id 17592186658660} :answer-field/id #uuid \"5769a818-a51d-5cb6-b9be-b957cdd1a61a\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186658851}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"afb796da-b0f3-583a-9b91-f7ceb9e49619\" :question/math-academy-id \"q-13469\" :question/problem \"Calculate the integral $$\\n\\\\displaystyle \\\\int 2{x}^{2}{csc}^{2}⁡({x}^{3})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u={x}^{3}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=3{x}^{2}\\\\,⟹\\\\,\\\\frac{1}{3}\\\\text{d}u={x}^{2}\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int 2{x}^{2}{csc}^{2}⁡({x}^{3})\\\\,\\\\text{d}x & =\\\\int 2{csc}^{2}⁡({x}^{3})\\\\cdot {x}^{2}\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int 2{csc}^{2}⁡u\\\\cdot \\\\frac{1}{3}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{2}{3}\\\\int {csc}^{2}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{2}{3}\\\\operatorname{cot}⁡u+C \\\\\\\\  & =-\\\\frac{2}{3}\\\\operatorname{cot}⁡({x}^{3})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186658981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"26428b0f-27ad-57ff-82c1-38411c7ad4e6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{csc}⁡({x}^{2})+C\" :db/id 17592186658459} {:answer/id #uuid \"64009f61-39d7-5a4c-87a5-147048718d28\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\operatorname{csc}⁡({x}^{2})+C\" :db/id 17592186658555} {:answer/id #uuid \"88560ed4-3fd2-5e35-b823-59a0de90bf5b\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\operatorname{csc}⁡({x}^{2})+C\" :db/id 17592186658598} {:answer/id #uuid \"9d479de0-2368-5b17-a3d1-550085306fdb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186658634} {:answer/id #uuid \"d4866fef-c958-566f-bda6-62f7eafd4907\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{cot}⁡({x}^{2})+C\" :db/id 17592186658723}] :answer-field/correct {:answer/id #uuid \"26428b0f-27ad-57ff-82c1-38411c7ad4e6\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\frac{1}{2}\\\\operatorname{csc}⁡({x}^{2})+C\" :db/id 17592186658459} :answer-field/id #uuid \"73c3d111-7c51-5bd3-8a2a-34f907747af7\" :answer-field/key \"selection\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186658862}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"cd35717b-5994-5159-928f-a06c0623a4c4\" :question/math-academy-id \"q-13463\" :question/problem \"Calculate $$\\n\\\\displaystyle \\\\int x\\\\operatorname{csc}⁡({x}^{2})\\\\operatorname{cot}⁡({x}^{2})\\\\,\\\\text{d}x.\\n$$\" :question/worked-solution \"Let $u={x}^{2}.$ Differentiating, we have\\n\\n$$\\n\\\\frac{\\\\text{d}u}{\\\\text{d}x}=2x\\\\,⟹\\\\,\\\\frac{1}{2}\\\\text{d}u=x\\\\,\\\\text{d}x.\\n$$\\n\\nUsing the above, we can write the integral in terms of $u$ and evaluate:\\n\\n$$\\n\\\\begin{aligned}\\\\int x\\\\operatorname{csc}⁡({x}^{2})\\\\operatorname{cot}⁡({x}^{2})\\\\,\\\\text{d}x & =\\\\int \\\\operatorname{csc}⁡({x}^{2})\\\\operatorname{cot}⁡({x}^{2})\\\\cdot x\\\\,\\\\text{d}x \\\\\\\\  & =\\\\int \\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\cdot \\\\frac{1}{2}\\\\,\\\\text{d}u \\\\\\\\  & =\\\\frac{1}{2}\\\\int \\\\operatorname{csc}⁡u\\\\operatorname{cot}⁡u\\\\,\\\\text{d}u \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{csc}⁡u+C \\\\\\\\  & =-\\\\frac{1}{2}\\\\operatorname{csc}⁡({x}^{2})+C\\\\end{aligned}\\n$$\"} {:db/id 17592186677462 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f875e36d-de2a-5736-a342-e3fe9fc5e489\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cot{\\\\left(4 x^{2} \\\\right)}\" :db/id 17592186677527}] :answer-field/correct {:answer/id #uuid \"f875e36d-de2a-5736-a342-e3fe9fc5e489\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cot{\\\\left(4 x^{2} \\\\right)}\" :db/id 17592186677527} :answer-field/id #uuid \"bd04cd60-bda3-5cfd-862c-71c2696c1094\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677511}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"101b9e2e-a853-5b6d-9dde-606da78be59b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 16 x \\\\csc^{2}{\\\\left(4 x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=4 x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=8 x.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 16 x \\\\csc^{2}{\\\\left(4 x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=2 \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2 \\\\cot{\\\\left(4 x^{2} \\\\right)}+C.\\n$$\"} {:db/id 17592186677464 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"31b78f18-a0fc-53c6-8a7b-11967228cf4a\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\cos{\\\\left(x^{3} \\\\right)}\" :db/id 17592186677474}] :answer-field/correct {:answer/id #uuid \"31b78f18-a0fc-53c6-8a7b-11967228cf4a\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\cos{\\\\left(x^{3} \\\\right)}\" :db/id 17592186677474} :answer-field/id #uuid \"b261a77b-1cf9-5e4e-aac4-71e2e8a1aec5\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677508}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"19d11ce6-4765-5312-9507-03305372084d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 9 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 9 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=3 \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3 \\\\cos{\\\\left(x^{3} \\\\right)}+C.\\n$$\"} {:db/id 17592186677466 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"cc63992a-9d07-51c6-9a14-7da8160f18ca\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\tan{\\\\left(4 x^{3} \\\\right)}\" :db/id 17592186677518}] :answer-field/correct {:answer/id #uuid \"cc63992a-9d07-51c6-9a14-7da8160f18ca\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\tan{\\\\left(4 x^{3} \\\\right)}\" :db/id 17592186677518} :answer-field/id #uuid \"43d191ba-9a39-5e10-8346-6d765a976bf9\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677480}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"1db3af81-54fc-56f5-90d7-2aef78d7368b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 12 x^{2} \\\\sec^{2}{\\\\left(4 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=4 x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=12 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 12 x^{2} \\\\sec^{2}{\\\\left(4 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\tan{\\\\left(4 x^{3} \\\\right)}+C.\\n$$\"} {:db/id 17592186677467 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"3361d4af-bd2b-5ae9-a120-637e9a9e0478\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\cos{\\\\left(\\\\frac{2}{x} \\\\right)}}{2}\" :db/id 17592186677475}] :answer-field/correct {:answer/id #uuid \"3361d4af-bd2b-5ae9-a120-637e9a9e0478\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\cos{\\\\left(\\\\frac{2}{x} \\\\right)}}{2}\" :db/id 17592186677475} :answer-field/id #uuid \"12bd3826-f8b2-58fe-8161-3fce354addb0\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677463}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"1e714881-ee39-59fc-9a3f-3bf6f9cafc07\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - \\\\frac{\\\\sin{\\\\left(\\\\frac{2}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{2}{x}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{2}{x^{2}}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - \\\\frac{\\\\sin{\\\\left(\\\\frac{2}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{\\\\cos{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{\\\\cos{\\\\left(\\\\frac{2}{x} \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186677468 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"707ea017-4814-59c8-9a51-54005373d40b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\sin{\\\\left(x^{2} \\\\right)}\" :db/id 17592186677488}] :answer-field/correct {:answer/id #uuid \"707ea017-4814-59c8-9a51-54005373d40b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\sin{\\\\left(x^{2} \\\\right)}\" :db/id 17592186677488} :answer-field/id #uuid \"38ffebb3-bb75-519e-94de-a81686427cc9\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677476}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"1ef50331-2222-53a5-a60c-7d970b3c98ed\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\sin{\\\\left(x^{2} \\\\right)}+C.\\n$$\"} {:db/id 17592186677481 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"39ffb3ba-b62e-5f11-92d9-7036b34292ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\tan{\\\\left(\\\\frac{5}{x} \\\\right)}}{5}\" :db/id 17592186677477}] :answer-field/correct {:answer/id #uuid \"39ffb3ba-b62e-5f11-92d9-7036b34292ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\tan{\\\\left(\\\\frac{5}{x} \\\\right)}}{5}\" :db/id 17592186677477} :answer-field/id #uuid \"c436089f-aa2c-5f65-881b-e8fb257be424\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677515}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4583bf88-1e2a-5cbe-9d4f-a672a66aef43\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - \\\\frac{2 \\\\sec^{2}{\\\\left(\\\\frac{5}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{5}{x}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{5}{x^{2}}.\\n$$\\n\\nThe negative derivative is included in the factor outside the new integral.\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - \\\\frac{2 \\\\sec^{2}{\\\\left(\\\\frac{5}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{5}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{5}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\tan{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\tan{\\\\left(\\\\frac{5}{x} \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186677482 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"db3231b5-aeed-5602-9be7-1ccd334e5bf3\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\sec{\\\\left(3 x^{3} \\\\right)}\" :db/id 17592186677520}] :answer-field/correct {:answer/id #uuid \"db3231b5-aeed-5602-9be7-1ccd334e5bf3\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\sec{\\\\left(3 x^{3} \\\\right)}\" :db/id 17592186677520} :answer-field/id #uuid \"3bc55393-9d08-5e57-99fa-5252031d3ff2\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677478}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"47920ea4-5406-5ed0-8b6f-fa27c6691446\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 9 x^{2} \\\\tan{\\\\left(3 x^{3} \\\\right)} \\\\sec{\\\\left(3 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=3 x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 9 x^{2} \\\\tan{\\\\left(3 x^{3} \\\\right)} \\\\sec{\\\\left(3 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\sec{\\\\left(3 x^{3} \\\\right)}+C.\\n$$\"} {:db/id 17592186677489 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"63f21307-c497-5db0-a85c-03c9d51ed1f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3} - \\\\frac{\\\\sqrt{2}}{3}\" :db/id 17592186677487}] :answer-field/correct {:answer/id #uuid \"63f21307-c497-5db0-a85c-03c9d51ed1f0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3} - \\\\frac{\\\\sqrt{2}}{3}\" :db/id 17592186677487} :answer-field/id #uuid \"47dbca7f-63c7-50ca-9696-c48aa1bffece\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677483}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"73c5d24b-b081-5013-81bb-38ff31edef36\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\sqrt{5} \\\\sqrt{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt{6} \\\\sqrt{\\\\pi}}{6}} - 4 x \\\\sin{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=3 x^{2} - \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6 x.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\sqrt{5} \\\\sqrt{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\sqrt{6} \\\\sqrt{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\sqrt{5} \\\\sqrt{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt{6} \\\\sqrt{\\\\pi}}{6}} - 4 x \\\\sin{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{3}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{2 \\\\cos{\\\\left(u \\\\right)}}{3}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(\\\\frac{1}{3}\\\\right)-\\\\left(\\\\frac{\\\\sqrt{2}}{3}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{1}{3} - \\\\frac{\\\\sqrt{2}}{3}.\\n$$\"} {:db/id 17592186677494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0decba54-8a07-57e2-ad81-00835ebda0a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\sin{\\\\left(2 \\\\sqrt{x} - \\\\frac{\\\\pi}{6} \\\\right)}\" :db/id 17592186677460}] :answer-field/correct {:answer/id #uuid \"0decba54-8a07-57e2-ad81-00835ebda0a6\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\sin{\\\\left(2 \\\\sqrt{x} - \\\\frac{\\\\pi}{6} \\\\right)}\" :db/id 17592186677460} :answer-field/id #uuid \"fbf6a0de-6107-5841-b1f1-711ea3fa9b4f\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677528}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"89bdc3ca-86c0-5c17-ac43-fa3e553566d0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - \\\\frac{2 \\\\cos{\\\\left(2 \\\\sqrt{x} - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 \\\\sqrt{x} - \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{\\\\sqrt{x}}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - \\\\frac{2 \\\\cos{\\\\left(2 \\\\sqrt{x} - \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 2 \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 2 \\\\sin{\\\\left(2 \\\\sqrt{x} - \\\\frac{\\\\pi}{6} \\\\right)}+C.\\n$$\"} {:db/id 17592186677495 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8ec1ea4d-e5b7-5b15-900d-6b9a8bdc5f43\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{18} - \\\\frac{\\\\sqrt{2}}{18}\" :db/id 17592186677496}] :answer-field/correct {:answer/id #uuid \"8ec1ea4d-e5b7-5b15-900d-6b9a8bdc5f43\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{18} - \\\\frac{\\\\sqrt{2}}{18}\" :db/id 17592186677496} :answer-field/id #uuid \"e8e215fc-d4c2-5cd1-b568-86a3864b9a1d\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677522}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"8d3c55dc-1e6c-5a48-93f5-b03770577f5c\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\sqrt[3]{30} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}} - x^{2} \\\\cos{\\\\left(3 x^{3} - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=3 x^{3} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9 x^{2}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\sqrt[3]{30} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\sqrt[3]{30} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}} - x^{2} \\\\cos{\\\\left(3 x^{3} - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{9}\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}} \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{\\\\sin{\\\\left(u \\\\right)}}{9}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}}=\\\\left(- \\\\frac{\\\\sqrt{2}}{18}\\\\right)-\\\\left(- \\\\frac{1}{18}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n\\\\frac{1}{18} - \\\\frac{\\\\sqrt{2}}{18}.\\n$$\"} {:db/id 17592186677497 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"d152707d-b92d-593a-a45f-6ff4e9f70d8b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2 \\\\tan{\\\\left(5 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677519}] :answer-field/correct {:answer/id #uuid \"d152707d-b92d-593a-a45f-6ff4e9f70d8b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2 \\\\tan{\\\\left(5 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677519} :answer-field/id #uuid \"c6614455-3b56-5713-b44f-e1f8edfc1857\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677516}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"91db11c0-dfd0-57e8-b6ea-5ae92e47c396\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 6 x^{2} \\\\sec^{2}{\\\\left(5 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5 x^{3} + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=15 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 6 x^{2} \\\\sec^{2}{\\\\left(5 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{2 \\\\tan{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{2 \\\\tan{\\\\left(5 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186677499 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"7d4c1f48-7a70-50b6-8c08-32c76bff5e3f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\cot{\\\\left(3 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{2}\" :db/id 17592186677492}] :answer-field/correct {:answer/id #uuid \"7d4c1f48-7a70-50b6-8c08-32c76bff5e3f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\cot{\\\\left(3 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{2}\" :db/id 17592186677492} :answer-field/id #uuid \"a6c480ed-e3e4-59ce-90b3-c54c7f7f8a37\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677505}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"973e9055-eac7-5fba-b71f-b62daa06bf9b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 3 x \\\\csc^{2}{\\\\left(3 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=3 x^{2} + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6 x.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 3 x \\\\csc^{2}{\\\\left(3 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\cot{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\cot{\\\\left(3 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186677500 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e9afe3b5-812c-5b18-a488-b9fd11d61a98\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{12} + \\\\frac{7 \\\\sqrt{3}}{36}\" :db/id 17592186677523}] :answer-field/correct {:answer/id #uuid \"e9afe3b5-812c-5b18-a488-b9fd11d61a98\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7}{12} + \\\\frac{7 \\\\sqrt{3}}{36}\" :db/id 17592186677523} :answer-field/id #uuid \"78973ae1-ce69-5f5c-8a3a-6e322d90d824\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677490}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"9749bbc3-f1b3-5367-8b91-1569703885d7\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\sqrt[3]{18} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt[3]{5} \\\\cdot 6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{12}} - 7 x^{2} \\\\sec^{2}{\\\\left(4 x^{3} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=4 x^{3} - \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=12 x^{2}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\sqrt[3]{18} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=\\\\frac{\\\\sqrt[3]{5} \\\\cdot 6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{12}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\sqrt[3]{18} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt[3]{5} \\\\cdot 6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{12}} - 7 x^{2} \\\\sec^{2}{\\\\left(4 x^{3} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{12}\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}} \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{7 \\\\tan{\\\\left(u \\\\right)}}{12}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}}=\\\\left(- \\\\frac{7}{12}\\\\right)-\\\\left(- \\\\frac{7 \\\\sqrt{3}}{36}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{7}{12} + \\\\frac{7 \\\\sqrt{3}}{36}.\\n$$\"} {:db/id 17592186677501 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f03fa46a-1413-5fca-8b71-a8c0e88b14a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\csc{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}}{4}\" :db/id 17592186677524}] :answer-field/correct {:answer/id #uuid \"f03fa46a-1413-5fca-8b71-a8c0e88b14a4\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{5 \\\\csc{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}}{4}\" :db/id 17592186677524} :answer-field/id #uuid \"2f9c52dc-1a72-5826-9182-f27a0c5f6656\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677472}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9de74302-8fa4-56ae-bdfc-1a0e6cde33d5\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 5 x \\\\cot{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)} \\\\csc{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 x^{2} - \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=4 x.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 5 x \\\\cot{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)} \\\\csc{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{4}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{5}{4}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{5 \\\\csc{\\\\left(u \\\\right)}}{4}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{5 \\\\csc{\\\\left(2 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}}{4}+C.\\n$$\"} {:db/id 17592186677502 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"4240a1ff-fa1b-5a50-b86e-727de8a75f54\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4 \\\\sqrt{2}}{9} + \\\\frac{8 \\\\sqrt{3}}{27}\" :db/id 17592186677479}] :answer-field/correct {:answer/id #uuid \"4240a1ff-fa1b-5a50-b86e-727de8a75f54\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4 \\\\sqrt{2}}{9} + \\\\frac{8 \\\\sqrt{3}}{27}\" :db/id 17592186677479} :answer-field/id #uuid \"b8a9861d-151c-5794-b355-bec1caa4273e\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677509}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a0f9e5be-a771-57c5-a59e-80a712358640\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt[3]{42} \\\\sqrt[3]{\\\\pi}}{6}} - 4 x^{2} \\\\cot{\\\\left(3 x^{3} - \\\\frac{\\\\pi}{4} \\\\right)} \\\\csc{\\\\left(3 x^{3} - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=3 x^{3} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9 x^{2}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\\\\\x=\\\\frac{\\\\sqrt[3]{42} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt[3]{42} \\\\sqrt[3]{\\\\pi}}{6}} - 4 x^{2} \\\\cot{\\\\left(3 x^{3} - \\\\frac{\\\\pi}{4} \\\\right)} \\\\csc{\\\\left(3 x^{3} - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{4}{9}\\\\left(\\\\int_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}} \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{4 \\\\csc{\\\\left(u \\\\right)}}{9}\\\\right]_{\\\\frac{\\\\pi}{4}}^{\\\\frac{\\\\pi}{3}}=\\\\left(\\\\frac{8 \\\\sqrt{3}}{27}\\\\right)-\\\\left(\\\\frac{4 \\\\sqrt{2}}{9}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{4 \\\\sqrt{2}}{9} + \\\\frac{8 \\\\sqrt{3}}{27}.\\n$$\"} {:db/id 17592186677507 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"31949ad0-96b1-58e3-bf6c-53fb4c72e773\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\cos{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}}{3}\" :db/id 17592186677473}] :answer-field/correct {:answer/id #uuid \"31949ad0-96b1-58e3-bf6c-53fb4c72e773\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\cos{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}}{3}\" :db/id 17592186677473} :answer-field/id #uuid \"c9bad736-0fce-57a0-af1c-df02f7de5a48\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677517}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"b1d33425-3609-51b7-b446-8aaf1d499fe0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 4 x \\\\sin{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=3 x^{2} - \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6 x.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 4 x \\\\sin{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\cos{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\cos{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{6} \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186677510 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0dc8b030-b1bf-5b26-bff4-f7094c77cbf4\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{5 \\\\sqrt{2}}{6} + \\\\frac{5 \\\\sqrt{3}}{9}\" :db/id 17592186677459}] :answer-field/correct {:answer/id #uuid \"0dc8b030-b1bf-5b26-bff4-f7094c77cbf4\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{5 \\\\sqrt{2}}{6} + \\\\frac{5 \\\\sqrt{3}}{9}\" :db/id 17592186677459} :answer-field/id #uuid \"250cce16-4722-5b76-b45f-f77bd947727c\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677471}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b8e0ec31-d0ce-535f-99ad-9b1b6605c3e8\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{3^{\\\\frac{2}{3}} \\\\sqrt[3]{5} \\\\sqrt[3]{\\\\pi}}{6}} - 5 x^{2} \\\\tan{\\\\left(2 x^{3} - \\\\frac{\\\\pi}{6} \\\\right)} \\\\sec{\\\\left(2 x^{3} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=2 x^{3} - \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6 x^{2}.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=\\\\frac{3^{\\\\frac{2}{3}} \\\\sqrt[3]{5} \\\\sqrt[3]{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{4}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{6^{\\\\frac{2}{3}} \\\\sqrt[3]{\\\\pi}}{6}}^{\\\\frac{3^{\\\\frac{2}{3}} \\\\sqrt[3]{5} \\\\sqrt[3]{\\\\pi}}{6}} - 5 x^{2} \\\\tan{\\\\left(2 x^{3} - \\\\frac{\\\\pi}{6} \\\\right)} \\\\sec{\\\\left(2 x^{3} - \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{5}{6}\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}} \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[- \\\\frac{5 \\\\sec{\\\\left(u \\\\right)}}{6}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{4}}=\\\\left(- \\\\frac{5 \\\\sqrt{2}}{6}\\\\right)-\\\\left(- \\\\frac{5 \\\\sqrt{3}}{9}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{5 \\\\sqrt{2}}{6} + \\\\frac{5 \\\\sqrt{3}}{9}.\\n$$\"} {:db/id 17592186677512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"58bfa3d8-d227-57e9-b82a-fe9da15e43ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\csc{\\\\left(3 x^{3} \\\\right)}\" :db/id 17592186677486}] :answer-field/correct {:answer/id #uuid \"58bfa3d8-d227-57e9-b82a-fe9da15e43ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\csc{\\\\left(3 x^{3} \\\\right)}\" :db/id 17592186677486} :answer-field/id #uuid \"7adf920c-bfc1-5695-b5d8-9224f28065ec\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677491}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"bd8c81ba-30ea-501d-a51f-626a1c33904a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 18 x^{2} \\\\cot{\\\\left(3 x^{3} \\\\right)} \\\\csc{\\\\left(3 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=3 x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 18 x^{2} \\\\cot{\\\\left(3 x^{3} \\\\right)} \\\\csc{\\\\left(3 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n2\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 2 \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 2 \\\\csc{\\\\left(3 x^{3} \\\\right)}+C.\\n$$\"} {:db/id 17592186677513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"24cae070-0ed2-546a-b423-db4cc244efd9\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\cos{\\\\left(3 x^{3} \\\\right)}\" :db/id 17592186677470}] :answer-field/correct {:answer/id #uuid \"24cae070-0ed2-546a-b423-db4cc244efd9\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\cos{\\\\left(3 x^{3} \\\\right)}\" :db/id 17592186677470} :answer-field/id #uuid \"955fdd38-6ab4-5155-ae93-cec4da8fd5d1\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677498}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"bdc9ccb7-c883-51d4-9fec-ab8fe84f9c03\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 18 x^{2} \\\\sin{\\\\left(3 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=3 x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=9 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 18 x^{2} \\\\sin{\\\\left(3 x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 2 \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 2 \\\\cos{\\\\left(3 x^{3} \\\\right)}+C.\\n$$\"} {:db/id 17592186677514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a7c350d3-cc87-543d-96d5-dac111bb66d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7 \\\\sec{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}}{6}\" :db/id 17592186677506}] :answer-field/correct {:answer/id #uuid \"a7c350d3-cc87-543d-96d5-dac111bb66d8\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{7 \\\\sec{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}}{6}\" :db/id 17592186677506} :answer-field/id #uuid \"f08cf9d6-984c-5dbb-8482-f0f3c0ba90b2\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677525}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"c396d67e-fbe1-5c22-8d3f-5b57601ca92f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 7 x^{2} \\\\tan{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)} \\\\sec{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=2 x^{3} + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 7 x^{2} \\\\tan{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)} \\\\sec{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{7}{6}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{7}{6}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{7 \\\\sec{\\\\left(u \\\\right)}}{6}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{7 \\\\sec{\\\\left(2 x^{3} + \\\\frac{\\\\pi}{6} \\\\right)}}{6}+C.\\n$$\"} {:db/id 17592186677521 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"541bfba8-dbd2-5692-8400-5c23781bb5dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\csc{\\\\left(x^{3} \\\\right)}\" :db/id 17592186677485}] :answer-field/correct {:answer/id #uuid \"541bfba8-dbd2-5692-8400-5c23781bb5dd\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\csc{\\\\left(x^{3} \\\\right)}\" :db/id 17592186677485} :answer-field/id #uuid \"0ee87188-29f0-557d-a757-3c404187f545\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677461}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e1dc1856-8570-5f0a-89ab-959e51200fe2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 9 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 9 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=3 \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3 \\\\csc{\\\\left(x^{3} \\\\right)}+C.\\n$$\"} {:db/id 17592186677526 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"51020b2b-4ab2-516a-889d-5cf5b26de613\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sin{\\\\left(5 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677484}] :answer-field/correct {:answer/id #uuid \"51020b2b-4ab2-516a-889d-5cf5b26de613\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sin{\\\\left(5 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677484} :answer-field/id #uuid \"1af47b71-2283-5efc-9ad6-1b3b80bcf148\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677465}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f7b57d6e-64c9-5e9d-9290-4d7d99e4c7f2\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - 2 x \\\\cos{\\\\left(5 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5 x^{2} + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=10 x.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - 2 x \\\\cos{\\\\left(5 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{5}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{1}{5}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{\\\\sin{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{\\\\sin{\\\\left(5 x^{2} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186677529 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a65e73ea-3d51-5404-b96a-5f8ce1db2360\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sqrt{3}}{3}\" :db/id 17592186677504}] :answer-field/correct {:answer/id #uuid \"a65e73ea-3d51-5404-b96a-5f8ce1db2360\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{\\\\sqrt{3}}{3}\" :db/id 17592186677504} :answer-field/id #uuid \"a5683675-71ad-5da7-afc3-6f39ec053991\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677503}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"fc028ba0-f028-5d1e-ad05-ccae9e0c7366\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{\\\\frac{\\\\sqrt{5} \\\\sqrt{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt{7} \\\\sqrt{\\\\pi}}{6}} - 3 x \\\\csc^{2}{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}}\" :question/retired true :question/worked-solution \"Let $u=3 x^{2} - \\\\frac{\\\\pi}{4}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=6 x.\\n$$\\n\\nChange both bounds:\\n\\n$$\\n\\\\begin{aligned}x=\\\\frac{\\\\sqrt{5} \\\\sqrt{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{6}\\\\\\\\x=\\\\frac{\\\\sqrt{7} \\\\sqrt{\\\\pi}}{6}&\\\\Longrightarrow u=\\\\frac{\\\\pi}{3}\\\\end{aligned}\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{\\\\frac{\\\\sqrt{5} \\\\sqrt{\\\\pi}}{6}}^{\\\\frac{\\\\sqrt{7} \\\\sqrt{\\\\pi}}{6}} - 3 x \\\\csc^{2}{\\\\left(3 x^{2} - \\\\frac{\\\\pi}{4} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{1}{2}\\\\left(\\\\int_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{3}} \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate and evaluate at both bounds:\\n\\n$$\\n\\\\left[\\\\frac{\\\\cot{\\\\left(u \\\\right)}}{2}\\\\right]_{\\\\frac{\\\\pi}{6}}^{\\\\frac{\\\\pi}{3}}=\\\\left(\\\\frac{\\\\sqrt{3}}{6}\\\\right)-\\\\left(\\\\frac{\\\\sqrt{3}}{2}\\\\right).\\n$$\\n\\nSimplifying gives\\n\\n$$\\n- \\\\frac{\\\\sqrt{3}}{3}.\\n$$\"} {:db/id 17592186677530 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"874c8860-d002-5d4c-9834-6274554740cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\cos{\\\\left(5 \\\\sqrt{x} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677493}] :answer-field/correct {:answer/id #uuid \"874c8860-d002-5d4c-9834-6274554740cc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\cos{\\\\left(5 \\\\sqrt{x} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}\" :db/id 17592186677493} :answer-field/id #uuid \"20e22cb0-eb8e-5ec4-858c-74f69a20fffd\" :answer-field/key \"field-1\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186677469}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"fd1c4148-3a35-5bf9-9e42-774419a3d255\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int - \\\\frac{\\\\sin{\\\\left(5 \\\\sqrt{x} + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{field-1}} $+C$\" :question/retired true :question/worked-solution \"Let $u=5 \\\\sqrt{x} + \\\\frac{\\\\pi}{6}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{5}{2 \\\\sqrt{x}}.\\n$$\\n\\nSubstituting, including the required constant factor, gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int - \\\\frac{\\\\sin{\\\\left(5 \\\\sqrt{x} + \\\\frac{\\\\pi}{6} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\\\\\\\&=- \\\\frac{2}{5}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n- \\\\frac{2}{5}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\cos{\\\\left(u \\\\right)}}{5}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\cos{\\\\left(5 \\\\sqrt{x} + \\\\frac{\\\\pi}{6} \\\\right)}}{5}+C.\\n$$\"} {:db/id 17592186678240 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"18cb1952-5fc5-5a88-a712-3b7f78568b7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678247} {:answer/id #uuid \"54a26180-d229-5997-9f1f-b45542743ce5\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678270} {:answer/id #uuid \"64791f06-edbd-577a-8d27-973ea7a1734b\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678280} {:answer/id #uuid \"64dc4cda-ac84-5edf-a512-6224f2f042c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678281} {:answer/id #uuid \"bbee7677-2f30-5e31-8afb-3b968cb13a97\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678313}] :answer-field/correct {:answer/id #uuid \"64dc4cda-ac84-5edf-a512-6224f2f042c2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678281} :answer-field/id #uuid \"658d3fb5-a648-51b0-bba6-86e98b159369\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678282}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"02ceeebd-f46a-5ad6-a275-6126a452f225\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\sin{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678249 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"09ac6e5a-afcf-5df3-88a2-c89258afddab\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678244} {:answer/id #uuid \"4a03700c-93c8-5d77-a3c3-91b759165d84\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678265} {:answer/id #uuid \"5188fe4d-b150-50d0-af7b-81aa4a9fd8b0\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678268} {:answer/id #uuid \"61d1d498-b344-513b-94c2-1a4603458dfe\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678278} {:answer/id #uuid \"d2cb404b-b088-547d-bac0-bb76fa9aad49\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678322}] :answer-field/correct {:answer/id #uuid \"d2cb404b-b088-547d-bac0-bb76fa9aad49\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678322} :answer-field/id #uuid \"e4c42855-e202-5ed0-b029-642991a744a9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678330}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"1c4f6e5f-fe7c-5c07-bfb2-24b55da17589\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678252 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5cc8d3fc-1c12-528e-a342-81964a4d8e78\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\tan{\\\\left(x^{3} + 1 \\\\right)}}{3}\" :db/id 17592186678276}] :answer-field/correct {:answer/id #uuid \"5cc8d3fc-1c12-528e-a342-81964a4d8e78\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\tan{\\\\left(x^{3} + 1 \\\\right)}}{3}\" :db/id 17592186678276} :answer-field/id #uuid \"0358b406-7288-515a-bd51-fe60af4c25a1\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678241}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"220ecb78-b0f1-5890-93be-f37a58cc6781\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} \\\\sec^{2}{\\\\left(x^{3} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\sec^{2}{\\\\left(x^{3} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\tan{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\tan{\\\\left(x^{3} + 1 \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186678255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ca134f58-86a7-5be5-934e-43774b4fc4c0\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\cot{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186678318}] :answer-field/correct {:answer/id #uuid \"ca134f58-86a7-5be5-934e-43774b4fc4c0\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\cot{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186678318} :answer-field/id #uuid \"31bce280-8abe-5e70-8acf-f3e2e1341df3\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678256}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"261035cc-9a8d-5fd2-92a0-e4c3087e4f7b\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\csc^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{1}{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 1\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\csc^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=3 \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3 \\\\cot{\\\\left(\\\\frac{1}{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186678264 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"affbea99-8e67-5f38-9d01-129ad9570237\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\cot{\\\\left(x^{2} \\\\right)}}{2}\" :db/id 17592186678306}] :answer-field/correct {:answer/id #uuid \"affbea99-8e67-5f38-9d01-129ad9570237\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\cot{\\\\left(x^{2} \\\\right)}}{2}\" :db/id 17592186678306} :answer-field/id #uuid \"f324306a-1dd2-58ca-a8a7-d152b4f27a63\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678337}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"4679df82-defc-570f-b989-bdb94985298d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x \\\\csc^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\csc^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3 \\\\cot{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3 \\\\cot{\\\\left(x^{2} \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186678266 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"1e871552-49a0-5503-a3c5-c543d7f405d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678250} {:answer/id #uuid \"9f593f5a-8c50-53fc-8620-0ca2eaebb1ae\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678301} {:answer/id #uuid \"c1bf190d-0158-5933-b932-1d781ad91edf\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678316} {:answer/id #uuid \"c24c8044-7608-5c5b-b729-7e791b80ee65\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678317} {:answer/id #uuid \"fd188149-e84c-599d-a2dc-b62d20e53ee0\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678341}] :answer-field/correct {:answer/id #uuid \"1e871552-49a0-5503-a3c5-c543d7f405d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678250} :answer-field/id #uuid \"e16cd2c3-11d8-577e-ade7-1e0458b62547\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678329}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"4ad1fac1-6505-50f0-b771-2029c0f5d2cc\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 x^{2} \\\\sec^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} \\\\sec^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186678267 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5684b7df-c65b-5b00-93eb-8d6a2d066b08\" :answer/type {:db/ident :answer.type/math} :answer/value \"6 \\\\sin{\\\\left(\\\\sqrt{x} \\\\right)}\" :db/id 17592186678273}] :answer-field/correct {:answer/id #uuid \"5684b7df-c65b-5b00-93eb-8d6a2d066b08\" :answer/type {:db/ident :answer.type/math} :answer/value \"6 \\\\sin{\\\\left(\\\\sqrt{x} \\\\right)}\" :db/id 17592186678273} :answer-field/id #uuid \"a25fa674-6064-581d-a907-718018b34efa\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678302}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4d30c709-e683-5166-a055-8d0acee315c9\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cos{\\\\left(\\\\sqrt{x} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\sqrt{x}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2 \\\\sqrt{x}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cos{\\\\left(\\\\sqrt{x} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\\\\\\\&=6\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n6\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=6 \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n6 \\\\sin{\\\\left(\\\\sqrt{x} \\\\right)}+C.\\n$$\"} {:db/id 17592186678269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8ac27cac-b677-5f52-8752-b7b47d11fa08\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cos{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186678292}] :answer-field/correct {:answer/id #uuid \"8ac27cac-b677-5f52-8752-b7b47d11fa08\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cos{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186678292} :answer-field/id #uuid \"fc60f24b-f477-53e1-a964-3b01f8952def\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678340}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"52a3f685-0a30-57bc-ab64-0eded745bb85\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\sin{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{1}{x + 2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 2\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\sin{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=2 \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2 \\\\cos{\\\\left(\\\\frac{1}{x + 2} \\\\right)}+C.\\n$$\"} {:db/id 17592186678272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"44b2fd23-e10c-51e4-8f70-6f5a97fb0169\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 6 \\\\cos{\\\\left(\\\\sqrt{x + 1} \\\\right)}\" :db/id 17592186678263}] :answer-field/correct {:answer/id #uuid \"44b2fd23-e10c-51e4-8f70-6f5a97fb0169\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 6 \\\\cos{\\\\left(\\\\sqrt{x + 1} \\\\right)}\" :db/id 17592186678263} :answer-field/id #uuid \"9ec02247-d137-5202-8eec-f836c23fd7c6\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678300}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"5608e43a-4e25-5209-8f54-c831cf312061\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sin{\\\\left(\\\\sqrt{x + 1} \\\\right)}}{\\\\sqrt{x + 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\sqrt{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2 \\\\sqrt{x + 1}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sin{\\\\left(\\\\sqrt{x + 1} \\\\right)}}{\\\\sqrt{x + 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=6\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n6\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 6 \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 6 \\\\cos{\\\\left(\\\\sqrt{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186678285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"eb3b0d2f-07ca-580d-9045-492a80e9b799\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{2} + 1 \\\\right)}\" :db/id 17592186678335}] :answer-field/correct {:answer/id #uuid \"eb3b0d2f-07ca-580d-9045-492a80e9b799\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{2} + 1 \\\\right)}\" :db/id 17592186678335} :answer-field/id #uuid \"03634545-7861-50d0-8f73-b4884120585a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678242}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"69206d9d-63cd-5bb9-847c-bd4494453b87\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x \\\\sin{\\\\left(x^{2} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{2} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x \\\\sin{\\\\left(x^{2} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\cos{\\\\left(x^{2} + 1 \\\\right)}+C.\\n$$\"} {:db/id 17592186678288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"62b9aad0-72b5-5996-bbcf-d9dadcd7a37f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}\" :db/id 17592186678279}] :answer-field/correct {:answer/id #uuid \"62b9aad0-72b5-5996-bbcf-d9dadcd7a37f\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}\" :db/id 17592186678279} :answer-field/id #uuid \"d8dd693c-bde5-5617-95da-76870682e40b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678326}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"76260971-dee8-535d-abad-25a054e5f811\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\sin{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186678289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"245611f0-cadb-50c1-9c24-5e979cd6cd77\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678254} {:answer/id #uuid \"5554840a-8dd6-55aa-b2c7-517f8ee745cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678271} {:answer/id #uuid \"8f35233e-d2a6-5f9d-90fe-c1af70ea77a2\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678293} {:answer/id #uuid \"955aa823-8f63-5f54-8b2d-6bc0bfdff83b\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678296} {:answer/id #uuid \"d3e97198-efc0-58e3-ab60-bde0722ecf7e\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{4}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678324}] :answer-field/correct {:answer/id #uuid \"5554840a-8dd6-55aa-b2c7-517f8ee745cb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678271} :answer-field/id #uuid \"68634317-f148-5301-813c-20d2ffe41381\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678284}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"776df9c6-df13-510b-ae73-510a04633763\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 x^{2} \\\\tan{\\\\left(x^{3} \\\\right)} \\\\sec{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\tan{\\\\left(x^{3} \\\\right)} \\\\sec{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678291 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"349582aa-cecd-5c1e-82ec-440bb1a8b379\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678257} {:answer/id #uuid \"3fc4ae72-151d-505c-9072-d589be1e0aff\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678259} {:answer/id #uuid \"3fe5f984-b4ff-5098-9255-b69553db8da9\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{2}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678260} {:answer/id #uuid \"984e493f-700c-5507-b373-ca4157c00506\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678298} {:answer/id #uuid \"e04ce411-cb97-5508-8530-88bc73fb6ecb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678328}] :answer-field/correct {:answer/id #uuid \"e04ce411-cb97-5508-8530-88bc73fb6ecb\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678328} :answer-field/id #uuid \"bd0139dd-01de-5a05-b64f-cea3c03be721\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678314}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"84f073b5-e3b1-59e9-a055-a6e9dcf4b5cf\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x \\\\cos{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\n$$\"} {:db/id 17592186678294 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"796b20c7-6752-54be-9ba7-0e02d42d6849\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\sin{\\\\left(\\\\frac{1}{x} \\\\right)}\" :db/id 17592186678290}] :answer-field/correct {:answer/id #uuid \"796b20c7-6752-54be-9ba7-0e02d42d6849\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\sin{\\\\left(\\\\frac{1}{x} \\\\right)}\" :db/id 17592186678290} :answer-field/id #uuid \"5f5b81ad-c73c-5093-8f9f-232ea653d45b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678277}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"905bff24-82d3-5866-9044-a52ed8f0e8c4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\cos{\\\\left(\\\\frac{1}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{1}{x}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{x^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\cos{\\\\left(\\\\frac{1}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 2 \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 2 \\\\sin{\\\\left(\\\\frac{1}{x} \\\\right)}+C.\\n$$\"} {:db/id 17592186678297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a5c877b4-db6b-5042-9f8f-62cde24c9fcd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sec{\\\\left(x^{3} + 2 \\\\right)}}{3}\" :db/id 17592186678304}] :answer-field/correct {:answer/id #uuid \"a5c877b4-db6b-5042-9f8f-62cde24c9fcd\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sec{\\\\left(x^{3} + 2 \\\\right)}}{3}\" :db/id 17592186678304} :answer-field/id #uuid \"432e7c05-7724-598e-814b-fb2c94effcd6\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678262}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"9566aff7-b976-5c0a-85c3-d7d41083e7b1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} \\\\tan{\\\\left(x^{3} + 2 \\\\right)} \\\\sec{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\tan{\\\\left(x^{3} + 2 \\\\right)} \\\\sec{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\sec{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\sec{\\\\left(x^{3} + 2 \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186678303 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6d87ae77-06b9-5d22-994c-0dd36d086d92\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\csc{\\\\left(x^{2} + 2 \\\\right)}}{2}\" :db/id 17592186678286}] :answer-field/correct {:answer/id #uuid \"6d87ae77-06b9-5d22-994c-0dd36d086d92\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\csc{\\\\left(x^{2} + 2 \\\\right)}}{2}\" :db/id 17592186678286} :answer-field/id #uuid \"b21ed25c-933f-522c-a404-61fadc00d605\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678307}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"a4406e92-3fdf-528c-bc71-97d93112204f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x \\\\cot{\\\\left(x^{2} + 2 \\\\right)} \\\\csc{\\\\left(x^{2} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{2} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\cot{\\\\left(x^{2} + 2 \\\\right)} \\\\csc{\\\\left(x^{2} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3 \\\\csc{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3 \\\\csc{\\\\left(x^{2} + 2 \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186678308 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"f91cf734-d9a2-5c15-ba32-f6d129eb976d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186678338}] :answer-field/correct {:answer/id #uuid \"f91cf734-d9a2-5c15-ba32-f6d129eb976d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186678338} :answer-field/id #uuid \"eb33753b-15c2-5041-9331-0cf5c84e60bc\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678334}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b24398ca-99b9-5a39-a042-a9b6d791af93\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)} \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{1}{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 1\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)} \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 3 \\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 3 \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186678309 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"10306567-3786-5bb6-b48a-264df6f8c19c\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\" :db/id 17592186678246} {:answer/id #uuid \"1a6b9c1a-750b-5917-bf9b-72064d5ab3dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678248} {:answer/id #uuid \"5891f849-cdc9-5a96-9500-7ed3b726bd69\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678275} {:answer/id #uuid \"d122c9c1-699a-567a-9c2f-263df3f5e4bc\" :answer/type {:db/ident :answer.type/math} :answer/value \"-\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678321} {:answer/id #uuid \"d5d30a1b-08f2-5ad2-ae40-ff291da65c3a\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678325}] :answer-field/correct {:answer/id #uuid \"1a6b9c1a-750b-5917-bf9b-72064d5ab3dc\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678248} :answer-field/id #uuid \"f2f57764-e4d0-53c4-8b08-8ee8a04be1a7\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678336}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"b2f9afef-2213-5cf4-8ac2-9379af1651a3\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int x^{2} \\\\csc^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\csc^{2}{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678310 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"236cdf46-4b6a-5c87-962b-6997cc8ac76e\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186678253}] :answer-field/correct {:answer/id #uuid \"236cdf46-4b6a-5c87-962b-6997cc8ac76e\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186678253} :answer-field/id #uuid \"66b308e4-a79f-58bf-a2b2-dee262c5f2c9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678283}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"b68c8ef6-932f-5813-929e-93028ab9527d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cot{\\\\left(\\\\frac{1}{x + 2} \\\\right)} \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{1}{x + 2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 2\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cot{\\\\left(\\\\frac{1}{x + 2} \\\\right)} \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=3 \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3 \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}+C.\\n$$\"} {:db/id 17592186678331 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"9e485969-d487-51ab-96e4-daade8ca1b7a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186678299}] :answer-field/correct {:answer/id #uuid \"9e485969-d487-51ab-96e4-daade8ca1b7a\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186678299} :answer-field/id #uuid \"bb5c8603-2aba-5592-8356-ef1e43a2071c\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678312}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e574e398-8295-56da-ac04-ba955b317b9e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x^{2} \\\\sin{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} \\\\sin{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\cos{\\\\left(x^{3} + 2 \\\\right)}+C.\\n$$\"} {:db/id 17592186678332 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"086006e9-aba3-5cd4-a11f-ecabbf7116d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186678243}] :answer-field/correct {:answer/id #uuid \"086006e9-aba3-5cd4-a11f-ecabbf7116d6\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186678243} :answer-field/id #uuid \"3c05e156-cb2e-537f-a101-d7dd7c973737\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678258}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"e7671a7a-b0e0-5a86-ad98-a2c2512cac33\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x^{2} \\\\cot{\\\\left(x^{3} + 2 \\\\right)} \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=x^{3} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} \\\\cot{\\\\left(x^{3} + 2 \\\\right)} \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\csc{\\\\left(x^{3} + 2 \\\\right)}+C.\\n$$\"} {:db/id 17592186678333 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"01789e25-272a-58fe-9e4e-270dee3903fb\" :answer/type {:db/ident :answer.type/math} :answer/value \"6\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678239} {:answer/id #uuid \"0dcd148c-a37d-5f93-8109-9812fde37868\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{4}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678245} {:answer/id #uuid \"56e15bb6-b6d0-5170-b17c-c7ec6bfda498\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678274} {:answer/id #uuid \"91b44fde-4e3f-5236-9071-20f1e6648ea2\" :answer/type {:db/ident :answer.type/math} :answer/value \"-3\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678295} {:answer/id #uuid \"b95177df-864d-5167-8185-9ef07e8c04b5\" :answer/type {:db/ident :answer.type/math} :answer/value \"3\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678311}] :answer-field/correct {:answer/id #uuid \"56e15bb6-b6d0-5170-b17c-c7ec6bfda498\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678274} :answer-field/id #uuid \"21244045-a0ed-5fb6-9b86-74641c6f0660\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678251}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"e9365dbd-fe00-591b-8075-15e95aedd5c3\" :question/problem \"Use the substitution $u=x^{2}$. Which integral is obtained?\\n\\n$$\\n\\\\int 3 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\sec^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186678339 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"427cbe4c-1597-5719-817a-8894a65f7d13\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186678261}] :answer-field/correct {:answer/id #uuid \"427cbe4c-1597-5719-817a-8894a65f7d13\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186678261} :answer-field/id #uuid \"d2ec099b-fd47-5d00-bc9e-3c19070b6b2d\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186678323}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"fbf8cce0-35ad-51b8-abae-abab36d33981\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nYou may use $\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C$.\\n\\n{{answer}} $+C$\" :question/retired true :question/worked-solution \"Let $u=\\\\frac{1}{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 1\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 3 \\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186678342 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"74dfefa1-40e2-5015-9e25-907b347524d7\" :answer/type {:db/ident :answer.type/math} :answer/value \"2\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678287} {:answer/id #uuid \"a999c23f-1cc7-5eb8-8800-723fdf9fc145\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678305} {:answer/id #uuid \"d0203d56-ba3d-5688-a894-ced5460e75fa\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{4}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678319} {:answer/id #uuid \"d024d229-84b9-59b9-8437-8889ef040537\" :answer/type {:db/ident :answer.type/math} :answer/value \"-2\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678320} {:answer/id #uuid \"d938ae3b-c317-58e2-9249-1a13d0600ae1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678327}] :answer-field/correct {:answer/id #uuid \"d938ae3b-c317-58e2-9249-1a13d0600ae1\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)\" :db/id 17592186678327} :answer-field/id #uuid \"be6e3500-44ed-5337-8838-0adbdc9605bb\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/radio} :db/id 17592186678315}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid \"fda80108-f3cb-5d6f-be8c-842c99ce457f\" :question/problem \"Use the substitution $u=x^{3}$. Which integral is obtained?\\n\\n$$\\n\\\\int 2 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cot{\\\\left(x^{3} \\\\right)} \\\\csc{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nThe transformed integral is\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\n$$\"} {:db/id 17592186682576 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0ee5177d-e676-5627-870a-0cc765478b65\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186682573}] :answer-field/correct {:answer/id #uuid \"0ee5177d-e676-5627-870a-0cc765478b65\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186682573} :answer-field/id #uuid \"a4b55cdc-8729-5076-9a78-48d1952ff386\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682602}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"213953a6-0aa3-5fc6-a5b4-b88d4ecec95f\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x^{2} \\\\sin{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{3} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} \\\\sin{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\cos{\\\\left(x^{3} + 2 \\\\right)}+C.\\n$$\"} {:db/id 17592186682578 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"99cb5b39-8bb1-5c72-a923-b3ac1322ce6d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\sin{\\\\left(\\\\frac{1}{x} \\\\right)}\" :db/id 17592186682599}] :answer-field/correct {:answer/id #uuid \"99cb5b39-8bb1-5c72-a923-b3ac1322ce6d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 2 \\\\sin{\\\\left(\\\\frac{1}{x} \\\\right)}\" :db/id 17592186682599} :answer-field/id #uuid \"5986715d-a74a-5b9a-b607-4c452d53ca11\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682589}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"22800ce1-22b4-5647-895c-5fa618aed8f1\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\cos{\\\\left(\\\\frac{1}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\frac{1}{x}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{x^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\cos{\\\\left(\\\\frac{1}{x} \\\\right)}}{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 2 \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 2 \\\\sin{\\\\left(\\\\frac{1}{x} \\\\right)}+C.\\n$$\"} {:db/id 17592186682579 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"28c836a2-8b2d-50c3-b89d-9bd2bc1ee84e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186682581}] :answer-field/correct {:answer/id #uuid \"28c836a2-8b2d-50c3-b89d-9bd2bc1ee84e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186682581} :answer-field/id #uuid \"87314e5a-9205-558c-9967-f8c8388551d2\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682595}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"24777013-b8d3-5e04-b08c-96de9e04799e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)} \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\frac{1}{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 1\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)} \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 3 \\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 3 \\\\sec{\\\\left(\\\\frac{1}{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186682582 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"a299121f-f4cf-5c1c-b79d-ecf655605c39\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186682600}] :answer-field/correct {:answer/id #uuid \"a299121f-f4cf-5c1c-b79d-ecf655605c39\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186682600} :answer-field/id #uuid \"6b60acb8-5432-523c-8dad-41923bfdbd12\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682592}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"2f8236fc-77ad-5c64-a431-aa60a8046451\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\frac{1}{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 1\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sec^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 3 \\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 3 \\\\tan{\\\\left(\\\\frac{1}{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186682584 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"6b769e32-8845-56ab-898e-74647012294d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\tan{\\\\left(x^{3} + 1 \\\\right)}}{3}\" :db/id 17592186682593}] :answer-field/correct {:answer/id #uuid \"6b769e32-8845-56ab-898e-74647012294d\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\tan{\\\\left(x^{3} + 1 \\\\right)}}{3}\" :db/id 17592186682593} :answer-field/id #uuid \"92dd62e8-b7ac-5ecc-8995-8dea1a20db53\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682597}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"3503c64b-c34d-5a2f-b993-ed88e86c9520\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} \\\\sec^{2}{\\\\left(x^{3} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{3} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\sec^{2}{\\\\left(x^{3} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\tan{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\sec^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\tan{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\tan{\\\\left(x^{3} + 1 \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186682585 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"0f04a7c2-6cd6-580d-82a3-6cf8a3f4e878\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186682574}] :answer-field/correct {:answer/id #uuid \"0f04a7c2-6cd6-580d-82a3-6cf8a3f4e878\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\" :db/id 17592186682574} :answer-field/id #uuid \"5411168e-fae7-53b0-bc95-989c45f44b61\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682587}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"3b0ac0bb-7ce8-5044-b70d-7560fb1e7c2d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x^{2} \\\\cot{\\\\left(x^{3} + 2 \\\\right)} \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{3} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x^{2} \\\\cot{\\\\left(x^{3} + 2 \\\\right)} \\\\csc{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\csc{\\\\left(x^{3} + 2 \\\\right)}+C.\\n$$\"} {:db/id 17592186682586 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2218cbe4-bd68-5685-ad28-4aca4e2ba34c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 6 \\\\cos{\\\\left(\\\\sqrt{x + 1} \\\\right)}\" :db/id 17592186682577}] :answer-field/correct {:answer/id #uuid \"2218cbe4-bd68-5685-ad28-4aca4e2ba34c\" :answer/type {:db/ident :answer.type/math} :answer/value \"- 6 \\\\cos{\\\\left(\\\\sqrt{x + 1} \\\\right)}\" :db/id 17592186682577} :answer-field/id #uuid \"566a9c50-0c75-5972-9f2c-4b8dac58354b\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682588}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"4431d68e-8101-5cb4-87da-6ca47c7b03dc\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\sin{\\\\left(\\\\sqrt{x + 1} \\\\right)}}{\\\\sqrt{x + 1}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\sqrt{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2 \\\\sqrt{x + 1}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\sin{\\\\left(\\\\sqrt{x + 1} \\\\right)}}{\\\\sqrt{x + 1}}\\\\,\\\\mathrm{d}x\\\\\\\\&=6\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n6\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- 6 \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- 6 \\\\cos{\\\\left(\\\\sqrt{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186682591 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"b7396f35-1ab8-53ba-8d5a-a46dd1780146\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sec{\\\\left(x^{3} + 2 \\\\right)}}{3}\" :db/id 17592186682604}] :answer-field/correct {:answer/id #uuid \"b7396f35-1ab8-53ba-8d5a-a46dd1780146\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{\\\\sec{\\\\left(x^{3} + 2 \\\\right)}}{3}\" :db/id 17592186682604} :answer-field/id #uuid \"71e5bf37-d1d5-51b7-b220-136cee071d47\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682594}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"6ae8b686-a96a-50fc-8811-70b1525a9d1d\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int x^{2} \\\\tan{\\\\left(x^{3} + 2 \\\\right)} \\\\sec{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{3} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int x^{2} \\\\tan{\\\\left(x^{3} + 2 \\\\right)} \\\\sec{\\\\left(x^{3} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sec{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{1}{3}\\\\left(\\\\int \\\\tan{\\\\left(u \\\\right)} \\\\sec{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{\\\\sec{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{\\\\sec{\\\\left(x^{3} + 2 \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186682598 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"e07b30ad-aa06-521b-b902-c76f75ed2338\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}\" :db/id 17592186682616}] :answer-field/correct {:answer/id #uuid \"e07b30ad-aa06-521b-b902-c76f75ed2338\" :answer/type {:db/ident :answer.type/math} :answer/value \"\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}\" :db/id 17592186682616} :answer-field/id #uuid \"cd093c04-e9ef-5d69-8a4a-7f5636fa8e1f\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682612}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"98059661-accc-5315-978a-90a341d6bb2a\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{3}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=3 x^{2}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x^{2} \\\\cos{\\\\left(x^{3} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{2}{3}\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=\\\\frac{2 \\\\sin{\\\\left(u \\\\right)}}{3}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n\\\\frac{2 \\\\sin{\\\\left(x^{3} \\\\right)}}{3}+C.\\n$$\"} {:db/id 17592186682601 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ca3b5931-f6f4-509b-9e40-761a804b4cc5\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186682609}] :answer-field/correct {:answer/id #uuid \"ca3b5931-f6f4-509b-9e40-761a804b4cc5\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186682609} :answer-field/id #uuid \"d2c077f1-ff65-5ca9-9bf2-de0b82cbbd6a\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682613}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"a4521fc6-cec0-581c-b41b-3c4297dc34f4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cot{\\\\left(\\\\frac{1}{x + 2} \\\\right)} \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\frac{1}{x + 2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 2\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cot{\\\\left(\\\\frac{1}{x + 2} \\\\right)} \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=3 \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3 \\\\csc{\\\\left(\\\\frac{1}{x + 2} \\\\right)}+C.\\n$$\"} {:db/id 17592186682603 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"8d96e438-b7bc-5216-b58a-f610c2253712\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\cot{\\\\left(x^{2} \\\\right)}}{2}\" :db/id 17592186682596}] :answer-field/correct {:answer/id #uuid \"8d96e438-b7bc-5216-b58a-f610c2253712\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\cot{\\\\left(x^{2} \\\\right)}}{2}\" :db/id 17592186682596} :answer-field/id #uuid \"0251f4ac-63e8-56d7-ade1-7936222eba9e\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682572}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ac491912-d824-5384-8703-127f1691c94e\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x \\\\csc^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\csc^{2}{\\\\left(x^{2} \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3 \\\\cot{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3 \\\\cot{\\\\left(x^{2} \\\\right)}}{2}+C.\\n$$\"} {:db/id 17592186682606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"c92f433a-937c-5532-a6df-6b18894cce0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"6 \\\\sin{\\\\left(\\\\sqrt{x} \\\\right)}\" :db/id 17592186682608}] :answer-field/correct {:answer/id #uuid \"c92f433a-937c-5532-a6df-6b18894cce0a\" :answer/type {:db/ident :answer.type/math} :answer/value \"6 \\\\sin{\\\\left(\\\\sqrt{x} \\\\right)}\" :db/id 17592186682608} :answer-field/id #uuid \"0faef82f-02d8-5038-818a-943e69f8cdd6\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682575}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"c682838c-441d-52c4-bca4-1c893d76ddf0\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\cos{\\\\left(\\\\sqrt{x} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\sqrt{x}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=\\\\frac{1}{2 \\\\sqrt{x}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\cos{\\\\left(\\\\sqrt{x} \\\\right)}}{\\\\sqrt{x}}\\\\,\\\\mathrm{d}x\\\\\\\\&=6\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=\\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n6\\\\left(\\\\int \\\\cos{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=6 \\\\sin{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n6 \\\\sin{\\\\left(\\\\sqrt{x} \\\\right)}+C.\\n$$\"} {:db/id 17592186682614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"cc1437e3-3127-553e-aff2-8606aa433d0d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{2} + 1 \\\\right)}\" :db/id 17592186682610}] :answer-field/correct {:answer/id #uuid \"cc1437e3-3127-553e-aff2-8606aa433d0d\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\cos{\\\\left(x^{2} + 1 \\\\right)}\" :db/id 17592186682610} :answer-field/id #uuid \"c4fc48b1-8659-572c-8200-8f98e6cf48c9\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682605}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"ddddb292-1f71-57a4-beb3-28f714287ab4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 2 x \\\\sin{\\\\left(x^{2} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{2} + 1$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 2 x \\\\sin{\\\\left(x^{2} + 1 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\cos{\\\\left(x^{2} + 1 \\\\right)}+C.\\n$$\"} {:db/id 17592186682615 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"5dd68423-d4c5-51c3-b56c-78a3b6ece56f\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\cot{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186682590}] :answer-field/correct {:answer/id #uuid \"5dd68423-d4c5-51c3-b56c-78a3b6ece56f\" :answer/type {:db/ident :answer.type/math} :answer/value \"3 \\\\cot{\\\\left(\\\\frac{1}{x + 1} \\\\right)}\" :db/id 17592186682590} :answer-field/id #uuid \"34957e6c-2d37-5113-825b-15316edadb96\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682583}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"dfa86080-eedd-5b9e-8afb-c8a9ebb355f4\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{3 \\\\csc^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\frac{1}{x + 1}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 1\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{3 \\\\csc^{2}{\\\\left(\\\\frac{1}{x + 1} \\\\right)}}{\\\\left(x + 1\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-3\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-3\\\\left(\\\\int \\\\csc^{2}{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=3 \\\\cot{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n3 \\\\cot{\\\\left(\\\\frac{1}{x + 1} \\\\right)}+C.\\n$$\"} {:db/id 17592186682618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"2730e8aa-499d-5cb6-b163-5f63d3219b35\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cos{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186682580}] :answer-field/correct {:answer/id #uuid \"2730e8aa-499d-5cb6-b163-5f63d3219b35\" :answer/type {:db/ident :answer.type/math} :answer/value \"2 \\\\cos{\\\\left(\\\\frac{1}{x + 2} \\\\right)}\" :db/id 17592186682580} :answer-field/id #uuid \"c909eb6e-d85d-5f5d-abf7-70781ca5732c\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682607}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid \"e19875d8-3438-5edf-9e74-07e21ace86b3\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int \\\\frac{2 \\\\sin{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=\\\\frac{1}{x + 2}$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=- \\\\frac{1}{\\\\left(x + 2\\\\right)^{2}}.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int \\\\frac{2 \\\\sin{\\\\left(\\\\frac{1}{x + 2} \\\\right)}}{\\\\left(x + 2\\\\right)^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=-2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n-2\\\\left(\\\\int \\\\sin{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=2 \\\\cos{\\\\left(u \\\\right)}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n2 \\\\cos{\\\\left(\\\\frac{1}{x + 2} \\\\right)}+C.\\n$$\"} {:db/id 17592186682619 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid \"ccde88b6-ac98-5d48-9756-10d67944b78e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\csc{\\\\left(x^{2} + 2 \\\\right)}}{2}\" :db/id 17592186682611}] :answer-field/correct {:answer/id #uuid \"ccde88b6-ac98-5d48-9756-10d67944b78e\" :answer/type {:db/ident :answer.type/math} :answer/value \"- \\\\frac{3 \\\\csc{\\\\left(x^{2} + 2 \\\\right)}}{2}\" :db/id 17592186682611} :answer-field/id #uuid \"e0be59d9-b5a8-5760-be31-45b6eaff99a3\" :answer-field/key \"answer\" :answer-field/type {:db/ident :answer-field.type/blank} :db/id 17592186682617}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid \"f5308edd-7673-58fe-9d05-ac0871e43493\" :question/problem \"Find an antiderivative.\\n\\n$$\\n\\\\int 3 x \\\\cot{\\\\left(x^{2} + 2 \\\\right)} \\\\csc{\\\\left(x^{2} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\n$$\\n\\n{{answer}} $+C$\" :question/worked-solution \"Let $u=x^{2} + 2$. Then\\n\\n$$\\n\\\\frac{\\\\mathrm{d}u}{\\\\mathrm{d}x}=2 x.\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int 3 x \\\\cot{\\\\left(x^{2} + 2 \\\\right)} \\\\csc{\\\\left(x^{2} + 2 \\\\right)}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u=- \\\\csc{\\\\left(u \\\\right)}+C.\\n$$\\n\\nIntegrate with respect to $u$:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\int \\\\cot{\\\\left(u \\\\right)} \\\\csc{\\\\left(u \\\\right)}\\\\,\\\\mathrm{d}u\\\\right)=- \\\\frac{3 \\\\csc{\\\\left(u \\\\right)}}{2}+C.\\n$$\\n\\nSubstitute back:\\n\\n$$\\n- \\\\frac{3 \\\\csc{\\\\left(x^{2} + 2 \\\\right)}}{2}+C.\\n$$\"}] :knowledge-point/title \"Integrating Products Containing Trigonometric Functions Using Substitution\"}",
