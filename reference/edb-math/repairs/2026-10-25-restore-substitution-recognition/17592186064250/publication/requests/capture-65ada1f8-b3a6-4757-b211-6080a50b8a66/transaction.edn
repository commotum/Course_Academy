.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(4 x \\right)}+C.\n$$"] [:db/add "0cf79bdb-a1c1-524e-9b54-8922590b2783" :question/difficulty :question.difficulty/easy] [:db/add "0cf79bdb-a1c1-524e-9b54-8922590b2783" :question/answer-fields "fb943425-8048-5513-9a16-8b586c91be64"] [:db/ensure "0cf79bdb-a1c1-524e-9b54-8922590b2783" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "0cf79bdb-a1c1-524e-9b54-8922590b2783"] [:db/add "37ca5f21-581d-5dbb-bb08-5492c2c4edb5" :answer/id #uuid "37ca5f21-581d-5dbb-bb08-5492c2c4edb5"] [:db/add "37ca5f21-581d-5dbb-bb08-5492c2c4edb5" :answer/type :answer.type/math] [:db/add "37ca5f21-581d-5dbb-bb08-5492c2c4edb5" :answer/value "3 \\operatorname{arcsec}{\\left(4 x \\right)}+C"] [:db/ensure "37ca5f21-581d-5dbb-bb08-5492c2c4edb5" :answer/validate] [:db/add "55f0cc92-1331-5e86-a24e-bb17391e704a" :answer/id #uuid "55f0cc92-1331-5e86-a24e-bb17391e704a"] [:db/add "55f0cc92-1331-5e86-a24e-bb17391e704a" :answer/type :answer.type/math] [:db/add "55f0cc92-1331-5e86-a24e-bb17391e704a" :answer/value "- 3 \\operatorname{arcsec}{\\left(4 x \\right)}+C"] [:db/ensure "55f0cc92-1331-5e86-a24e-bb17391e704a" :answer/validate] [:db/add "6b89e142-35b3-52ce-8308-5a045aa1abe6" :answer/id #uuid "6b89e142-35b3-52ce-8308-5a045aa1abe6"] [:db/add "6b89e142-35b3-52ce-8308-5a045aa1abe6" :answer/type :answer.type/math] [:db/add "6b89e142-35b3-52ce-8308-5a045aa1abe6" :answer/value "\\frac{3 \\operatorname{arcsec}{\\left(4 x \\right)}}{2}+C"] [:db/ensure "6b89e142-35b3-52ce-8308-5a045aa1abe6" :answer/validate] [:db/add "695d23e6-a9cf-5e4b-b9b7-676d7ff43de2" :answer/id #uuid "695d23e6-a9cf-5e4b-b9b7-676d7ff43de2"] [:db/add "695d23e6-a9cf-5e4b-b9b7-676d7ff43de2" :answer/type :answer.type/math] [:db/add "695d23e6-a9cf-5e4b-b9b7-676d7ff43de2" :answer/value "- 6 \\operatorname{arcsec}{\\left(4 x \\right)}+C"] [:db/ensure "695d23e6-a9cf-5e4b-b9b7-676d7ff43de2" :answer/validate] [:db/add "30d20449-dad9-5cb2-ad8f-2a78378b2a48" :answer/id #u