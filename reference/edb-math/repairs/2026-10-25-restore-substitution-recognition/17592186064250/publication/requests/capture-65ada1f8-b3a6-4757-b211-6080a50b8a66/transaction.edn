eld/id #uuid "16eed95d-68d7-57e2-b6f4-9f45ce02687d"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/key "answer"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/type :answer-field.type/radio] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/choices "04388f6f-3e25-55ac-aea7-3af5668853fd"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/choices "552a860f-a4e3-5d98-af3e-28bd5f5ece31"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/choices "53564a8a-d5aa-59c7-9fbb-0dd2a405294f"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/choices "640b585c-a341-5814-be9b-e5bc17ee1f0a"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/choices "f43fe352-123a-5e61-b8a9-1df1fe3287f3"] [:db/add "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/correct "640b585c-a341-5814-be9b-e5bc17ee1f0a"] [:db/ensure "16eed95d-68d7-57e2-b6f4-9f45ce02687d" :answer-field/validate] [:db/add "07d641d2-449d-58f6-a1b5-3603a57c9728" :question/id #uuid "07d641d2-449d-58f6-a1b5-3603a57c9728"] [:db/add "07d641d2-449d-58f6-a1b5-3603a57c9728" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{2}{|5 x|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|5 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "07d641d2-449d-58f6-a1b5-3603a57c9728" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|5 x|>1$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $2\\cdot \\frac{1}{5}=\\frac{2}{5}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{2}{|5 x|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\frac{2}{5}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{2}{5}\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=\\frac{2}{5}\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2}{5}\\left(\\operatorname{arcsec}{\\left(5 x \\right)}\\right)+C.\n$$"] [:db/add "07d641d2-449d-58f6-a1b5-3603a57c9728" :question/difficulty :question.difficulty/moderate] [:db/add "07d641d2-449d-58f6-a1b5-3603a57c9728" :question/answer-fields "16eed95d-68d7-57e2-b6f4-9f45ce02687d"] [:db/ensure "07d641d2-449d-58f6-a1b5-3603a57c9728" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "07d641d2-449d-58f6-a1b5-3603a57c9728"] [:db/add "a517f5ba-4d9e-5716-a2db-cfb1c3e38de3" :answer/id #uuid "a517f5ba-4d9e-5716-a2db-cfb1c3e38de3"] [:db/add "a517f5ba-4d9e-5716-a2db-cfb1c3e38de3" :answer/type :answer.type/math] [:db/add "a517f5ba-4d9e-5716-a2db-cfb1c3e38de3" :answer/value "\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(2 x \\right)}\\right)+C"] [:db/ensure "a517f5ba-4d9e-5716-a2db-cfb1c3e38de3" :answer/validate] [:db/add "cfa4a09e-fdbf-5b89-83f2-fd53e155dd19" :answer/id #uuid "cfa4a09e-fdbf-5b89-83f2-fd53e155dd19"] [:db/add "cfa4a09e-fdbf-5b89-83f2-fd53e155dd19" :answer/type :answer.type/math] [:db/add "cfa4a09e-fdbf-5b89-83f2-fd53e155dd19" :answer/value "\\frac{3}{4}\\left(\\operatorname{arcsec}{\\left(4 x \\right)}\\right)+C"] [:db/ensure "cfa4a09e-fdbf-5b89-83f2-fd53e155dd19" :answer/validate] [:db/add "7139db5b-e417-5fa8-9b3c-5d41cb522f01" :answer/id #uuid "7139db5b-e417-5fa8-9b3c-5d41cb522f01"] [:db/add "7139db5b-e417-5fa8-9b3c-5d41cb522f01" :answer/type :answer.type/math] [:db/add "7139db5b-e417-5fa8-9b3c-5d41cb522f01" :answer/value "3\\left(\\operatorname{arcsec}{\\left(x \\right)}\\right)+C"] [:db/ensure "7139db5b-e417-5fa8-9b3c-5d41cb522f01" :answer/validate] [:db/add "e3326589-dd5b-5910-84b6-e149462e8b27" :answer/id #uuid "e3326589-dd5b-5910-84b6-e149462e8b27"] [:db/add "e332