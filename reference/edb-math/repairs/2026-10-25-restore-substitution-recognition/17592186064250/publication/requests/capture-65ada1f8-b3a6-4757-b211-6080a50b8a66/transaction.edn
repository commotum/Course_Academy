er-field/type :answer-field.type/radio] [:db/add "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/choices "985d4117-8a30-5e5f-aece-0fb8cd33ff13"] [:db/add "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/choices "6ed0c45e-67ba-5277-8ab8-eaa190dfc649"] [:db/add "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/choices "3d42108a-6407-532f-8441-88eb4fe90930"] [:db/add "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/choices "e533cb4a-41f8-5462-8025-53fc71a93af3"] [:db/add "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/choices "80bad00a-a006-5d4d-b04f-234c6f35854d"] [:db/add "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/correct "3d42108a-6407-532f-8441-88eb4fe90930"] [:db/ensure "32e002e0-7d7f-532e-bd92-d700dbcbf2e0" :answer-field/validate] [:db/add "4772e7cc-83fd-5e59-8f8b-f4fdff748f05" :question/id #uuid "4772e7cc-83fd-5e59-8f8b-f4fdff748f05"] [:db/add "4772e7cc-83fd-5e59-8f8b-f4fdff748f05" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{5}{|5 x|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|5 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "4772e7cc-83fd-5e59-8f8b-f4fdff748f05" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|5 x|>1$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $5\\cdot \\frac{1}{5}=1$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{5}{|5 x|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\operatorname{arcsec}{\\left(5 x \\right)}+C.\n$$"] [:db/add "4772e7cc-83fd-5e59-8f8b-f4fdff748f05" :question/difficulty :question.difficulty/easy] [:db/add "4772e7cc-83fd-5e59-8f8b-f4fdff748f05" :question/answer-fields "32e002e0-7d7f-532e-bd92-d700dbcbf2e0"] [:db/ensure "4772e7cc-83fd-5e59-8f8b-f4fdff748f05" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "4772e7cc-83fd-5e59-8f8b-f4fdff748f05"] [:db/add "e605d56c-6cf2-5e44-a274-dd9185418d73" :answer/id #uuid "e605d56c-6cf2-5e44-a274-dd9185418d73"] [:db/add "e605d56c-6cf2-5e44-a274-dd9185418d73" :answer/type :answer.type/math] [:db/add "e605d56c-6cf2-5e44-a274-dd9185418d73" :answer/value "2 \\operatorname{arcsec}{\\left(x \\right)}+C"] [:db/ensure "e605d56c-6cf2-5e44-a274-dd9185418d73" :answer/validate] [:db/add "a2409b84-983f-57a0-baab-20fc0124c600" :answer/id #uuid "a2409b84-983f-57a0-baab-20fc0124c600"] [:db/add "a2409b84-983f-57a0-baab-20fc0124c600" :answer/type :answer.type/math] [:db/add "a2409b84-983f-57a0-baab-20fc0124c600" :answer/value "2 \\operatorname{arcsec}{\\left(5 x \\right)}+C"] [:db/ensure "a2409b84-983f-57a0-baab-20fc0124c600" :answer/validate] [:db/add "f69643a8-1b19-5035-9b5e-93273ec6aef9" :answer/id #uuid "f69643a8-1b19-5035-9b5e-93273ec6aef9"] [:db/add "f69643a8-1b19-5035-9b5e-93273ec6aef9" :answer/type :answer.type/math] [:db/add "f69643a8-1b19-5035-9b5e-93273ec6aef9" :answer/value "\\operatorname{arcsec}{\\left(5 x \\right)}+C"] [:db/ensure "f69643a8-1b19-5035-9b5e-93273ec6aef9" :answer/validate] [:db/add "4826b5e1-ef26-5efd-90eb-e61a0340ee82" :answer/id #uuid "4826b5e1-ef26-5efd-90eb-e61a0340ee82"] [:db/add "4826b5e1-ef26-5efd-90eb-e61a0340ee82" :answer/type :answer.type/math] [:db/add "4826b5e1-ef26-5efd-90eb-e61a0340ee82" :answer/value "2 \\operatorname{arcsec}{\\left(\\frac{5 x}{2} \\right)}+C"] [:db/ensure "4826b5e1-ef26-5efd-90eb-e61a0340ee82" :answer/validate] [:db/add "6d32cbf7-05da-5058-bad2-9a2a36736c76" :answer/id #uuid "6d32cbf7-05da-5058-bad2-9a2a36736c76"] [:db/add "6d32cbf7-05da-5058-bad2-9a2a36736c76" :answer/type :answer.type/math] [:db/add "6d32cbf7-05da-5058-bad2-9a2a36736c76" :answer/value "2 \\operatorname{arcsec}{\\left(5 x + 1 \\right)}+C"] [:db/ensure "6d32cbf7-05da-5058-bad2-9a2a36736c76" :answer/validate] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/id #uuid "a76cd67a-4125-5d65-b775-abf66de81554"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/key "answer"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/type :answer-field.type/radio] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/choices "e605d56c-6cf2-5e44-a274-dd9185418d73"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/choices "a2409b84-983f-57a0-baab-20fc0124c600"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/choices "f69643a8-1b19-5035-9b5e-93273ec6aef9"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/choices "4826b5e1-ef26-5efd-90eb-e61a0340ee82"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/choices "6d32cbf7-05da-5058-bad2-9a2a36736c76"] [:db/add "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/correct "a2409b84-983f-57a0-baab-20fc0124c600"] [:db/ensure "a76cd67a-4125-5d65-b775-abf66de81554" :answer-field/validate] [:db/add "500430dd-d837-527f-8c05-3f998c917599" :question/id #uuid "500430dd-d837-527f-8c05-3f998c917599"] [:db/add "500430dd-d837-527f-8c05-3f998c917599" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{10}{|5 x|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\n$$\n\nWork on a connected interval where $|5 x|>1$.\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "500430dd-d837-527f-8c05-3f998c917599" :question/worked-solution "Let $u=5 x$. Then $\\mathrm{d}u=(5)\\,\\mathrm{d}x$.\n\nWork on a connected real interval where $|5 x|>1$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{5}\\,\\mathrm{d}u$. The outside factor is $10\\cdot \\frac{1}{5}=2$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{10}{|5 x|\\sqrt{25 x^{2} - 1}}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\n$$\n2\\left(\\int \\frac{1}{\\sqrt{u^{2} - 1} \\left|{u}\\right|}\\,\\mathrm{d}u\\right)=2\\left(\\operatorname{arcsec}{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2 \\operatorname{arcsec}{\\left(5 x \\right)}+C.\n$$"] [:db/add "500430dd-d837-527f-8c05-3f998c917599" :question/difficulty :question.difficulty/easy] [:db/add "500430dd-d837-527f-8c05-3f998c917599" :question/answer-fields "a76cd67a-4125-5d65-b775-abf66de81554"] [:db/ensure "500430dd-d837-527f-8c05-3f998c917599" :question/validate] [:db/add 17592186064250 :knowledge-point/questions "500430dd-d837-527f-8c05-3f998c917599"] [:db/add "4b014eb4-b438-5e9b-97bf-25884630caef" :answer/id #uuid "4b014eb4-b438-5e9b-97bf-25884630caef"] [:db/add "4b014eb4-b438-5e9b-97bf-25884630caef" :answer/type :answer.type/math] [:db/add "4b014eb4-b438-5e9b-97bf-25884630caef" :answer/value "3 \\operatorname{arcsec}{\\left(3 x \\right)}+C"] [:db/ensure "4b014eb4-b438-5e9b-97bf-25884630caef" :answer/validate] [:db/add "d11b90a0-0c98-570e-9e6b-44a6a1ac31bf" :answer/id #uuid "d11b90a0-0c98-570e-9e6b-44a6a1ac31bf"] [:db/add "d11b90a0-0c98-570e-9e6b-44a6a1ac31bf" :answer/type :answer.type/math] [:db/add "d11b90a0-0c98-570e-9e6b-44a6a1ac31bf" :answer/value "3 \\operatorname{arcsec}{\\left(3 x + 1 \\right)}+C"] [:db/ensure "d11b90a0-0c98-570e-9e6b-44a6a1ac31bf" :answer/validate] [:db/add "29bb9d97-ffb1-5ca5-9765-1b7a6858f499" :answer/id #uuid "29bb9d97-ffb1-5ca5-9765-1b7a6858f499"] [:db/add "29bb9d97-ffb1-5ca5-9765-1b7a6858f499" :answer/type :answer.type/math] [:db/add "29bb9d97-ffb1-5ca5-9765-1b7a6858f499" :answer/value "3 x+C"] [:db/ensure "29bb9d97-ffb1-5ca5-9765-1b7a