\\,\\mathrm{d}u\\right)=\\frac{2}{3}\\left(\\frac{2^{u}}{\\ln{\\left(2 \\right)}}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{2 \\cdot 2^{x^{3} + 2}}{3 \\ln{\\left(2 \\right)}}+C.\n$$"] [:db/add "6ffd53e5-76c7-5bad-8a59-8afa6c29060a" :question/difficulty :question.difficulty/easy] [:db/add "6ffd53e5-76c7-5bad-8a59-8afa6c29060a" :question/answer-fields "642da68d-048c-5998-8287-97f2df3c4876"] [:db/ensure "6ffd53e5-76c7-5bad-8a59-8afa6c29060a" :question/validate] [:db/add 17592186184350 :knowledge-point/questions "6ffd53e5-76c7-5bad-8a59-8afa6c29060a"] [:db/add "41edcda1-989a-5c89-a17d-134cabaae0bd" :answer/id #uuid "41edcda1-989a-5c89-a17d-134cabaae0bd"] [:db/add "41edcda1-989a-5c89-a17d-134cabaae0bd" :answer/type :answer.type/math] [:db/add "41edcda1-989a-5c89-a17d-134cabaae0bd" :answer/value "- \\frac{4 \\cdot 2^{x^{2} + 2}}{\\ln{\\left(2 \\right)}}+C"] [:db/ensure "41edcda1-989a-5c89-a17d-134cabaae0bd" :answer/validate] [:db/add "4c5cb4ff-8f48-52a0-a014-f706e50aad72" :answer/id #uuid "4c5cb4ff-8f48-52a0-a014-f706e50aad72"] [:db/add "4c5cb4ff-8f48-52a0-a014-f706e50aad72" :answer/type :answer.type/math] [:db/add "4c5cb4ff-8f48-52a0-a014-f706e50aad72" :answer/value "\\frac{2 \\cdot 2^{x^{2} + 2}}{\\ln{\\left(2 \\right)}}+C"] [:db/ensure "4c5cb4ff-8f48-52a0-a014-f706e50aad72" :answer/validate] [:db/add "94b97ef6-7f6b-59f8-a1fc-bf969cc20644" :answer/id #uuid "94b97ef6-7f6b-59f8-a1fc-bf969cc20644"] [:db/add "94b97ef6-7f6b-59f8-a1fc-bf969cc20644" :answer/type :answer.type/math] [:db/add "94b97ef6-7f6b-59f8-a1fc-bf969cc20644" :answer/value "\\frac{2 \\cdot 2^{x^{2} + 3}}{\\ln{\\left(2 \\right)}}+C"] [:db/ensure "94b97ef6-7f6b-59f8-a1fc-bf969cc20644" :answer/validate] [:db/add "303fb4c3-634d-52fb-b4ed-07d2e186e940" :answer/id #uuid "303fb4c3-634d-52fb-b4ed-07d2e186e940"] [:db/add "303fb4c3-634d-52fb-b4ed-07d2e186e940" :answer/type :answer.type/math] [:db/add "303fb4c3-634d-52fb-b4ed-07d2e186e940" :answer/value "\\frac{2 \\cdot 2^{2 x^{2} + 4}}{\\ln{\\left(2 \\right)}}+