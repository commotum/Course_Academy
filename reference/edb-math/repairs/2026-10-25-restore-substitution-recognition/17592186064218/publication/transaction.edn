b7-c1661e848933" :answer-field/type :answer-field.type/radio] [:db/add "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/choices "efabc4af-e568-5ad1-b820-e20f52b569aa"] [:db/add "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/choices "7c44d3d1-2195-5f8a-9578-f57ae00ac48b"] [:db/add "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/choices "a81262f1-56ef-51ce-9cd7-5c44104e140d"] [:db/add "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/choices "8322f43b-0ab2-5005-9d09-dfd9325cf79c"] [:db/add "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/choices "b0fd2337-e645-5c84-9a6b-d484eb79344b"] [:db/add "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/correct "a81262f1-56ef-51ce-9cd7-5c44104e140d"] [:db/ensure "c70cdf0d-7359-572c-90b7-c1661e848933" :answer-field/validate] [:db/add "de61b015-16e9-58f1-ad1b-3983410c4f58" :question/id #uuid "de61b015-16e9-58f1-ad1b-3983410c4f58"] [:db/add "de61b015-16e9-58f1-ad1b-3983410c4f58" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{3}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "de61b015-16e9-58f1-ad1b-3983410c4f58" :question/worked-solution "Let $u=4 x$. Then $\\mathrm{d}u=(4)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{4}\\,\\mathrm{d}u$. The outside factor is $3\\cdot \\frac{1}{4}=\\frac{3}{4}$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{3}{\\sqrt{1 - 16 x^{2}}}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n\\frac{3}{4}\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=\\frac{3}{4}\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n\\frac{3 \\arcsin{\\left(4 x \\right)}}{4}+C.\n$$"] [:db/add "de61b015-16e9-58f1-ad1b-3983410c4f58" :question/difficulty :question.difficulty/easy] [:db/add "de61b015-16e9-58f1-ad1b-3983410c4f58" :question/answer-fields "c70cdf0d-7359-572c-90b7-c1661e848933"] [:db/ensure "de61b015-16e9-58f1-ad1b-3983410c4f58" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "de61b015-16e9-58f1-ad1b-3983410c4f58"] [:db/add "c8665e3f-8763-5b84-95f9-f1e16d5072cf" :answer/id #uuid "c8665e3f-8763-5b84-95f9-f1e16d5072cf"] [:db/add "c8665e3f-8763-5b84-95f9-f1e16d5072cf" :answer/type :answer.type/math] [:db/add "c8665e3f-8763-5b84-95f9-f1e16d5072cf" :answer/value "- 4 \\arcsin{\\left(2 x \\right)}+C"] [:db/ensure "c8665e3f-8763-5b84-95f9-f1e16d5072cf" :answer/validate] [:db/add "7a14400a-4f29-5797-9889-94f84f685d54" :answer/id #uuid "7a14400a-4f29-5797-9889-94f84f685d54"] [:db/add "7a14400a-4f29-5797-9889-94f84f685d54" :answer/type :answer.type/math] [:db/add "7a14400a-4f29-5797-9889-94f84f685d54" :answer/value "2 \\arcsin{\\left(2 x \\right)}+C"] [:db/ensure "7a14400a-4f29-5797-9889-94f84f685d54" :answer/validate] [:db/add "3ed7bec9-a35b-50cb-abf5-37bcabadd39a" :answer/id #uuid "3ed7bec9-a35b-50cb-abf5-37bcabadd39a"] [:db/add "3ed7bec9-a35b-50cb-abf5-37bcabadd39a" :answer/type :answer.type/math] [:db/add "3ed7bec9-a35b-50cb-abf5-37bcabadd39a" :answer/value "6 \\arcsin{\\left(2 x \\right)}+C"] [:db/ensure "3ed7bec9-a35b-50cb-abf5-37bcabadd39a" :answer/validate] [:db/add "9c053124-1d9c-5777-b3c6-a762c510bc00" :answer/id #uuid "9c053124-1d9c-5777-b3c6-a762c510bc00"] [:db/add "9c053124-1d9c-5777-b3c6-a762c510bc00" :answer/type :answer.type/math] [:db/add "9c053124-1d9c-5777-b3c6-a762c510bc00" :answer/value "2 x+C"] [:db/ensure "9c053124-1d9c-5777-b3c6-a762c510bc00" :answer/validate] [:db/add "0dbadd21-5ff9-5b1f-b788-cc965d424532" :answer/id #uuid "0dbadd21-5ff9-5b1f-b788-cc965d424532"] [:db/add "0dbadd21-5ff9-5b1f-b788-cc965d424532" :answer/type :answer.type/math] [:db/add "0dbadd21-5ff9-5b1f-b788-cc965d424532" :answer/value "2 \\arcsin{\\left(x \\right)}+C"] [:db/ensure "0dbadd21-5ff9-5b1f-b788-cc965d424532" :answer/validate] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/id #uuid "7548dbc7-455e-56ec-8360-36731b4311fd"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/key "answer"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/type :answer-field.type/radio] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/choices "c8665e3f-8763-5b84-95f9-f1e16d5072cf"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/choices "7a14400a-4f29-5797-9889-94f84f685d54"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/choices "3ed7bec9-a35b-50cb-abf5-37bcabadd39a"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/choices "9c053124-1d9c-5777-b3c6-a762c510bc00"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/choices "0dbadd21-5ff9-5b1f-b788-cc965d424532"] [:db/add "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/correct "7a14400a-4f29-5797-9889-94f84f685d54"] [:db/ensure "7548dbc7-455e-56ec-8360-36731b4311fd" :answer-field/validate] [:db/add "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7" :question/id #uuid "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7"] [:db/add "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7" :question/problem "Find an antiderivative.\n\n$$\n\\int \\frac{4}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\n$$\n\nChoose the antiderivative. In each choice, $C$ is an arbitrary constant."] [:db/add "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7" :question/worked-solution "Let $u=2 x$. Then $\\mathrm{d}u=(2)\\,\\mathrm{d}x$.\n\nThe differential is $\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u$. The outside factor is $4\\cdot \\frac{1}{2}=2$.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\frac{4}{\\sqrt{1 - 4 x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\n$$\n2\\left(\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right)=2\\left(\\arcsin{\\left(u \\right)}\\right)+C.\n$$\n\nSubstitute back:\n\n$$\n2 \\arcsin{\\left(2 x \\right)}+C.\n$$"] [:db/add "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7" :question/difficulty :question.difficulty/easy] [:db/add "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7" :question/answer-fields "7548dbc7-455e-56ec-8360-36731b4311fd"] [:db/ensure "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7" :question/validate] [:db/add 17592186064218 :knowledge-point/questions "4e8cb577-d6cf-5bbc-aa93-9a53d60d33f7"] [:db/add "a420ec03-0a75-5ef8-bd9c-6f3189699f3c" :answer/id #uuid "a420ec03-0a75-5ef8-bd9c-6f3189699f3c"] [:db/add "a420ec03-0a75-5ef8-bd9c-6f3189699f3c" :answer/type :answer.type/math] [:db/add "a420ec03-0a75-5ef8-bd9c-6f3189699f3c" :answer/value "\\frac{4 \\arcsin{\\left(3 x \\right)}}{9}+C"] [:db/ensure "a420ec03-0a75-5ef8-bd9c-6f3189699f3c" :answer/validate] [:db/add "90ed459e-c5b6-5d12-8cbb-0757f3c9717d" :answer/id #uuid "90ed459e-c5b6-5d12-8cbb-0757f3c9717d"] [:db/add "90ed459e-c5b6-5d12-8cbb-0757f3c9717d" :answer/type :answer.type/math] [:db/add "90ed459e-c5b6-5d12-8cbb-0757f3c9717d" :answer/value "\\frac{4 \\arcsin{\\left(3 x + 1 \\right)}}{3}+C"] [:db/ensure "90ed459e-c5b6-5d12-8cbb-0757f3c9717d" :answer/validate] [:db/add "8c30ff1f-10bb-58f5-8bbf-d5160ed33103" :answer/id #uuid "8c30ff1f-10bb-58f5-8bbf-d5160ed33103"] [:db/add "8c30ff1f-10bb-58f5-8bbf-d5160ed33103" :answer/type :answer.type/math] [:db/add "8c30ff1f-10bb-58f5-8bbf-d5160ed33103" :answer/value "\\frac{4 \\arcsin{\\left(3 x \\right)}}{3}+C"] [:db/ensure "8c30ff1f-10bb-58f5-8bbf-d5160ed33103" :answer/validate] [:db/add "4a907831-82aa-5754-bbd6-3565c7039670" :answer/id #uuid "4a907831-82aa-5754-bbd6-3565c7039670"] [:db/add "4a907831-82aa-5754-bbd6-3565c7039670" :answer/type :answer.type/math] [:db/add "4a907831-82aa-5754-bbd6-3565c7039670" :answer/value "\\frac{4 \\arcsin{\\left(\\frac{3 x}{2} \\right)}}{3}+C"] [:db/ensure "4a907831-82aa-5754-bbd6-3565c70