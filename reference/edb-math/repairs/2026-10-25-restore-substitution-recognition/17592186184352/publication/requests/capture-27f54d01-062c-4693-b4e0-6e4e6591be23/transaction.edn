23fd748d61" :answer-field/validate] [:db/add "8f74c32b-6785-5fbf-8802-fdcafb1f33f1" :question/id #uuid "8f74c32b-6785-5fbf-8802-fdcafb1f33f1"] [:db/add "8f74c32b-6785-5fbf-8802-fdcafb1f33f1" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} x e^{x^{2} + 1}\\,\\mathrm{d}x\n$$\n\nChoose the exact value."] [:db/add "8f74c32b-6785-5fbf-8802-fdcafb1f33f1" :question/worked-solution "Let $u=x^{2} + 1$. Then $\\mathrm{d}u=(2 x)\\,\\mathrm{d}x$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=1\\\\x=\\sqrt{\\ln{\\left(2 \\right)}}&\\Longrightarrow u=\\ln{\\left(2 \\right)} + 1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\sqrt{\\ln{\\left(2 \\right)}}} x e^{x^{2} + 1}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{1}^{\\ln{\\left(2 \\right)} + 1} e^{u}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $e^{\\ln 2}=2,\\quad e^{2\\ln 2}=4$.\n\nUse the integration rule:\n\n$$\n\\int e^{u}\\,\\mathrm{d}u=e^{u}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[e^{u}\\right]_{1}^{\\ln{\\left(2 \\right)} + 1}\\right)=\\frac{1}{2}\\left(\\left(2 e\\right)-\\left(e\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{e}{2}.\n$$"] [:db/add "8f74c32b-6785-5fbf-8802-fdcafb1f33f1" :question/difficulty :question.difficulty/easy] [:db/add "8f74c32b-6785-5fbf-8802-fdcafb1f33f1" :question/answer-fields "9c8fde7b-2d94-56a9-b801-9623fd748d61"] [:db/ensure "8f74c32b-6785-5fbf-8802-fdcafb1f33f1" :question/validate] [:db/add 17592186184352 :knowledge-point/questions "8f74c32b-6785-5fbf-8802-fdcafb1f33f1"] [:db/add "c15c9c6c-72dc-5029-a194-4ac26de2648a" :answer/id #uuid "c15c9c6c-72dc-5029-a194-4ac26de2648a"] [:db/add "c15c9c6c-72dc-5029-a194-4ac26de2648a" :answer/type :answer.type/math] [:db/add "c15c9c6c-72dc-5029-a194-4ac26de2648a" :answer/value "3 e^{2}"] [:db/ensure "c15c9c6c-72dc-5029-a194-4ac26de2648a" :answer/validat