  "batch_edn": "{\"source\" \":agent/codex\" \"forms\" [[:db/add \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/id #uuid \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\"] [:db/add \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/type :answer.type/math] [:db/add \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/value \"\\\\frac{3 e}{2}\"] [:db/ensure \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/validate] [:db/add \"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/id #uuid \"18b79c6b-141a-5e47-9320-6f439b0fb03f\"] [:db/add \"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/type :answer.type/math] [:db/add \"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/value \"1 + \\\\frac{3 e}{2}\"] [:db/ensure \"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/validate] [:db/add \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/id #uuid \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\"] [:db/add \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/type :answer.type/math] [:db/add \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/value \"- 3 e\"] [:db/ensure \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/validate] [:db/add \"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/id #uuid \"e0455bae-e74b-5427-a76a-85ff3edc1317\"] [:db/add \"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/type :answer.type/math] [:db/add \"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/value \"\\\\frac{3 e}{4}\"] [:db/ensure \"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/validate] [:db/add \"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/id #uuid \"da2eccdf-714a-53a1-9f66-3d8aa577f674\"] [:db/add \"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/type :answer.type/math] [:db/add \"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/value \"\\\\frac{e}{2}\"] [:db/ensure \"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/validate] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/id #uuid \"a5df3437-01f3-5397-98cb-72078f3f5916\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/key \"answer\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/type :answer-field.type/radio] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"18b79c6b-141a-5e47-9320-6f439b0fb03f\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"e0455bae-e74b-5427-a76a-85ff3edc1317\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"da2eccdf-714a-53a1-9f66-3d8aa577f674\"] [:db/add \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/correct \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\"] [:db/ensure \"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/validate] [:db/add \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/id #uuid \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\"] [:db/add \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=1 + \\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[e^{u}\\\\right]_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(4 e\\\\right)-\\\\left(e\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{3 e}{2}.\\n$$\"] [:db/add \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/difficulty :question.difficulty/easy] [:db/add \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/answer-fields \"a5df3437-01f3-5397-98cb-72078f3f5916\"] [:db/ensure \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\"] [:db/add \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/id #uuid \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\"] [:db/add \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/type :answer.type/math] [:db/add \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/value \"- 4 e\"] [:db/ensure \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/validate] [:db/add \"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/id #uuid \"83e5ecf4-5345-529a-a8bd-c1801b64068e\"] [:db/add \"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/type :answer.type/math] [:db/add \"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/value \"4 e\"] [:db/ensure \"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/validate] [:db/add \"9859c69d-7782-550e-b343-95e58b509469\" :answer/id #uuid \"9859c69d-7782-550e-b343-95e58b509469\"] [:db/add \"9859c69d-7782-550e-b343-95e58b509469\" :answer/type :answer.type/math] [:db/add \"9859c69d-7782-550e-b343-95e58b509469\" :answer/value \"2 e\"] [:db/ensure \"9859c69d-7782-550e-b343-95e58b509469\" :answer/validate] [:db/add \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/id #uuid \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\"] [:db/add \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/type :answer.type/math] [:db/add \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/value \"8 e\"] [:db/ensure \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/validate] [:db/add \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/id #uuid \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\"] [:db/add \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/type :answer.type/math] [:db/add \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/value \"\\\\frac{4 e}{3}\"] [:db/ensure \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/validate] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/id #uuid \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/key \"answer\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/type :answer-field.type/radio] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"83e5ecf4-5345-529a-a8bd-c1801b64068e\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"9859c69d-7782-550e-b343-95e58b509469\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\"] [:db/add \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/correct \"83e5ecf4-5345-529a-a8bd-c1801b64068e\"] [:db/ensure \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/validate] [:db/add \"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/id #uuid \"f406a425-58e3-5cb0-8a62-2e89af536b93\"] [:db/add \"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n4\\\\left(\\\\left[e^{u}\\\\right]_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1}\\\\right)=4\\\\left(\\\\left(2 e\\\\right)-\\\\left(e\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n4 e.\\n$$\"] [:db/add \"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/difficulty :question.difficulty/easy] [:db/add \"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/answer-fields \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\"] [:db/ensure \"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"f406a425-58e3-5cb0-8a62-2e89af536b93\"] [:db/add \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/id #uuid \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\"] [:db/add \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/type :answer.type/math] [:db/add \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/value \"1\"] [:db/ensure \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/validate] [:db/add \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/id #uuid \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\"] [:db/add \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/type :answer.type/math] [:db/add \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/value \"3\"] [:db/ensure \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/validate] [:db/add \"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/id #uuid \"bb380a3a-cdbc-5089-a078-318f0a79cb30\"] [:db/add \"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/type :answer.type/math] [:db/add \"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/value \"\\\\frac{2}{3}\"] [:db/ensure \"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/validate] [:db/add \"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/id #uuid \"92ac924c-ab03-546c-8fc4-59089b9fb12a\"] [:db/add \"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/type :answer.type/math] [:db/add \"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/value \"4\"] [:db/ensure \"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/validate] [:db/add \"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/id #uuid \"d00627be-806e-56e1-a0f4-adffa702335e\"] [:db/add \"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/type :answer.type/math] [:db/add \"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/value \"2\"] [:db/ensure \"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/validate] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/id #uuid \"927abd5e-1d6a-5af0-b897-119b76a16469\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/key \"answer\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/type :answer-field.type/radio] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"bb380a3a-cdbc-5089-a078-318f0a79cb30\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"92ac924c-ab03-546c-8fc4-59089b9fb12a\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"d00627be-806e-56e1-a0f4-adffa702335e\"] [:db/add \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/correct \"d00627be-806e-56e1-a0f4-adffa702335e\"] [:db/ensure \"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/validate] [:db/add \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/id #uuid \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\"] [:db/add \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)=2\\\\left(\\\\left(2\\\\right)-\\\\left(1\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n2.\\n$$\"] [:db/add \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/difficulty :question.difficulty/easy] [:db/add \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/answer-fields \"927abd5e-1d6a-5af0-b897-119b76a16469\"] [:db/ensure \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\"] [:db/add \"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/id #uuid \"ebf49655-443a-5127-b311-79e85425e7ea\"] [:db/add \"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/type :answer.type/math] [:db/add \"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/value \"\\\\frac{5}{2}\"] [:db/ensure \"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/validate] [:db/add \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/id #uuid \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\"] [:db/add \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/type :answer.type/math] [:db/add \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/value \"3\"] [:db/ensure \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/validate] [:db/add \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/id #uuid \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\"] [:db/add \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/type :answer.type/math] [:db/add \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/value \"\\\\frac{3}{2}\"] [:db/ensure \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/validate] [:db/add \"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/id #uuid \"15debcdc-0d61-565d-a7a6-2bf07ab35569\"] [:db/add \"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/type :answer.type/math] [:db/add \"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/value \"\\\\frac{7}{2}\"] [:db/ensure \"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/validate] [:db/add \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/id #uuid \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\"] [:db/add \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/type :answer.type/math] [:db/add \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/value \"\\\\frac{3}{4}\"] [:db/ensure \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/validate] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/id #uuid \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/key \"answer\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/type :answer-field.type/radio] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"ebf49655-443a-5127-b311-79e85425e7ea\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"15debcdc-0d61-565d-a7a6-2bf07ab35569\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\"] [:db/add \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/correct \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\"] [:db/ensure \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/validate] [:db/add \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/id #uuid \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\"] [:db/add \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(4 \\\\right)}}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(4\\\\right)-\\\\left(1\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{3}{2}.\\n$$\"] [:db/add \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/difficulty :question.difficulty/easy] [:db/add \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/answer-fields \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\"] [:db/ensure \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\"] [:db/add \"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/id #uuid \"54f6aa68-cc41-5701-a86d-4b4ef910e724\"] [:db/add \"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/type :answer.type/math] [:db/add \"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/value \"1\"] [:db/ensure \"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/validate] [:db/add \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/id #uuid \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\"] [:db/add \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/type :answer.type/math] [:db/add \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/value \"3\"] [:db/ensure \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/validate] [:db/add \"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/id #uuid \"aa0e7596-1dec-58d2-9258-7fa864a57f47\"] [:db/add \"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/type :answer.type/math] [:db/add \"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/value \"-2\"] [:db/ensure \"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/validate] [:db/add \"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/id #uuid \"9b40bda3-0f78-5171-b752-a9ec490a26b3\"] [:db/add \"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/type :answer.type/math] [:db/add \"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/value \"0\"] [:db/ensure \"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/validate] [:db/add \"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/id #uuid \"27fca89a-d521-572c-81bc-2a2f66d88c45\"] [:db/add \"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/type :answer.type/math] [:db/add \"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/value \"2\"] [:db/ensure \"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/validate] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/id #uuid \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/key \"answer\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/type :answer-field.type/radio] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"54f6aa68-cc41-5701-a86d-4b4ef910e724\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"aa0e7596-1dec-58d2-9258-7fa864a57f47\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"9b40bda3-0f78-5171-b752-a9ec490a26b3\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"27fca89a-d521-572c-81bc-2a2f66d88c45\"] [:db/add \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/correct \"54f6aa68-cc41-5701-a86d-4b4ef910e724\"] [:db/ensure \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/validate] [:db/add \"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/id #uuid \"1162eac6-17c1-5233-98b3-49a36c01cb96\"] [:db/add \"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(2 \\\\right)}}=\\\\left(2\\\\right)-\\\\left(1\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n1.\\n$$\"] [:db/add \"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/difficulty :question.difficulty/easy] [:db/add \"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/answer-fields \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\"] [:db/ensure \"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"1162eac6-17c1-5233-98b3-49a36c01cb96\"] [:db/add \"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/id #uuid \"2693ded1-26c1-5c0d-b4c4-412355c38d90\"] [:db/add \"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/type :answer.type/math] [:db/add \"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/value \"\\\\frac{9}{4}\"] [:db/ensure \"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/validate] [:db/add \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/id #uuid \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\"] [:db/add \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/type :answer.type/math] [:db/add \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/value \"\\\\frac{9}{2}\"] [:db/ensure \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/validate] [:db/add \"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/id #uuid \"8ba79cc8-bf17-5634-bca9-40d441d938d0\"] [:db/add \"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/type :answer.type/math] [:db/add \"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/value \"9\"] [:db/ensure \"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/validate] [:db/add \"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/id #uuid \"24c2143a-5033-5a7f-8092-fbe8f603b270\"] [:db/add \"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/type :answer.type/math] [:db/add \"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/value \"- \\\\frac{3}{2}\"] [:db/ensure \"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/validate] [:db/add \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/id #uuid \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\"] [:db/add \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/type :answer.type/math] [:db/add \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/value \"-9\"] [:db/ensure \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/validate] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/id #uuid \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/key \"answer\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/type :answer-field.type/radio] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"2693ded1-26c1-5c0d-b4c4-412355c38d90\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"8ba79cc8-bf17-5634-bca9-40d441d938d0\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"24c2143a-5033-5a7f-8092-fbe8f603b270\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\"] [:db/add \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/correct \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\"] [:db/ensure \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/validate] [:db/add \"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/id #uuid \"0c4ed185-75bb-5475-8582-73fab14779ef\"] [:db/add \"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(4 \\\\right)}}\\\\right)=\\\\frac{3}{2}\\\\left(\\\\left(4\\\\right)-\\\\left(1\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{9}{2}.\\n$$\"] [:db/add \"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/difficulty :question.difficulty/easy] [:db/add \"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/answer-fields \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\"] [:db/ensure \"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"0c4ed185-75bb-5475-8582-73fab14779ef\"] [:db/add \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/id #uuid \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\"] [:db/add \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/type :answer.type/math] [:db/add \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/value \"e\"] [:db/ensure \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/validate] [:db/add \"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/id #uuid \"4579a606-705a-5b81-92f9-e9a771902eed\"] [:db/add \"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/type :answer.type/math] [:db/add \"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/value \"- \\\\frac{e}{2}\"] [:db/ensure \"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/validate] [:db/add \"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/id #uuid \"5161b975-ca2d-599e-9946-4e74d6cf200f\"] [:db/add \"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/type :answer.type/math] [:db/add \"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/value \"\\\\frac{e}{6}\"] [:db/ensure \"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/validate] [:db/add \"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/id #uuid \"048efbea-6e0c-5241-b860-7e4d47da59ee\"] [:db/add \"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/type :answer.type/math] [:db/add \"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/value \"\\\\frac{e}{2} + 2\"] [:db/ensure \"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/validate] [:db/add \"670e64ba-929c-5283-92fd-97c770affb04\" :answer/id #uuid \"670e64ba-929c-5283-92fd-97c770affb04\"] [:db/add \"670e64ba-929c-5283-92fd-97c770affb04\" :answer/type :answer.type/math] [:db/add \"670e64ba-929c-5283-92fd-97c770affb04\" :answer/value \"\\\\frac{e}{2}\"] [:db/ensure \"670e64ba-929c-5283-92fd-97c770affb04\" :answer/validate] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/id #uuid \"9c8fde7b-2d94-56a9-b801-9623fd748d61\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/key \"answer\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/type :answer-field.type/radio] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"4579a606-705a-5b81-92f9-e9a771902eed\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"5161b975-ca2d-599e-9946-4e74d6cf200f\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"048efbea-6e0c-5241-b860-7e4d47da59ee\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"670e64ba-929c-5283-92fd-97c770affb04\"] [:db/add \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/correct \"670e64ba-929c-5283-92fd-97c770affb04\"] [:db/ensure \"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/validate] [:db/add \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/id #uuid \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\"] [:db/add \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[e^{u}\\\\right]_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(2 e\\\\right)-\\\\left(e\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{e}{2}.\\n$$\"] [:db/add \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/difficulty :question.difficulty/easy] [:db/add \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/answer-fields \"9c8fde7b-2d94-56a9-b801-9623fd748d61\"] [:db/ensure \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\"] [:db/add \"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/id #uuid \"c15c9c6c-72dc-5029-a194-4ac26de2648a\"] [:db/add \"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/type :answer.type/math] [:db/add \"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/value \"3 e^{2}\"] [:db/ensure \"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/validate] [:db/add \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/id #uuid \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\"] [:db/add \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/type :answer.type/math] [:db/add \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/value \"6 e^{2}\"] [:db/ensure \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/validate] [:db/add \"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/id #uuid \"c59b1278-42f4-5394-b44d-827c55f4dd8b\"] [:db/add \"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/type :answer.type/math] [:db/add \"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/value \"2 + 3 e^{2}\"] [:db/ensure \"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/validate] [:db/add \"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/id #uuid \"9a07d953-17e6-5229-901b-2c75990a8b05\"] [:db/add \"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/type :answer.type/math] [:db/add \"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/value \"- 3 e^{2}\"] [:db/ensure \"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/validate] [:db/add \"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/id #uuid \"036e3781-356a-57c7-bd36-1660aa1b0f1b\"] [:db/add \"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/type :answer.type/math] [:db/add \"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/value \"\\\\frac{3 e^{2}}{2}\"] [:db/ensure \"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/validate] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/id #uuid \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/key \"answer\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/type :answer-field.type/radio] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"c15c9c6c-72dc-5029-a194-4ac26de2648a\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"c59b1278-42f4-5394-b44d-827c55f4dd8b\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"9a07d953-17e6-5229-901b-2c75990a8b05\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"036e3781-356a-57c7-bd36-1660aa1b0f1b\"] [:db/add \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/correct \"c15c9c6c-72dc-5029-a194-4ac26de2648a\"] [:db/ensure \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/validate] [:db/add \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/id #uuid \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\"] [:db/add \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [:db/add \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/worked-solution \"Let $u=x + 2$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[e^{u}\\\\right]_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2}\\\\right)=3\\\\left(\\\\left(2 e^{2}\\\\right)-\\\\left(e^{2}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3 e^{2}.\\n$$\"] [:db/add \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/difficulty :question.difficulty/easy] [:db/add \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/answer-fields \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\"] [:db/ensure \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/validate] [:db/add 17592186184352 :knowledge-point/questions \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\"] [:db/add \"generator\" :question-generator/id #uuid \"9beb9b28-d4ce-5d84-873b-5e1e13e4f48f\"] [:db/add \"generator\" :question-generator/script \"generators/5f/5f493e8a1609ad7a80f5108c87f8ebe6122af635ee43ac29dc16041c915b6f54/generator.py\"] [:db/add 17592186184352 :knowledge-point/question-generator \"generator\"] [:db/ensure 17592186184352 :knowledge-point/validate]] \"assertions\" [[\"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/id #uuid \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\"] [\"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/type :answer.type/math] [\"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\" :answer/value \"\\\\frac{3 e}{2}\"] [\"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/id #uuid \"18b79c6b-141a-5e47-9320-6f439b0fb03f\"] [\"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/type :answer.type/math] [\"18b79c6b-141a-5e47-9320-6f439b0fb03f\" :answer/value \"1 + \\\\frac{3 e}{2}\"] [\"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/id #uuid \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\"] [\"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/type :answer.type/math] [\"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\" :answer/value \"- 3 e\"] [\"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/id #uuid \"e0455bae-e74b-5427-a76a-85ff3edc1317\"] [\"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/type :answer.type/math] [\"e0455bae-e74b-5427-a76a-85ff3edc1317\" :answer/value \"\\\\frac{3 e}{4}\"] [\"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/id #uuid \"da2eccdf-714a-53a1-9f66-3d8aa577f674\"] [\"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/type :answer.type/math] [\"da2eccdf-714a-53a1-9f66-3d8aa577f674\" :answer/value \"\\\\frac{e}{2}\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/id #uuid \"a5df3437-01f3-5397-98cb-72078f3f5916\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/key \"answer\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/type :answer-field.type/radio] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"18b79c6b-141a-5e47-9320-6f439b0fb03f\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"f2b51c9b-f3b3-5b19-a1fe-7a9ce66de292\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"e0455bae-e74b-5427-a76a-85ff3edc1317\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/choices \"da2eccdf-714a-53a1-9f66-3d8aa577f674\"] [\"a5df3437-01f3-5397-98cb-72078f3f5916\" :answer-field/correct \"a42a2ea8-8104-517f-a2c1-83cf2501a7b4\"] [\"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/id #uuid \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\"] [\"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/worked-solution \"Let $u=2 x^{2} + 1$. Then $\\\\mathrm{d}u=(4 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=1 + \\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{2 x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[e^{u}\\\\right]_{1}^{1 + \\\\ln{\\\\left(4 \\\\right)}}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(4 e\\\\right)-\\\\left(e\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{3 e}{2}.\\n$$\"] [\"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/difficulty :question.difficulty/easy] [\"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\" :question/answer-fields \"a5df3437-01f3-5397-98cb-72078f3f5916\"] [17592186184352 :knowledge-point/questions \"24bdcdaf-ab24-5eb7-9897-4aa4058292eb\"] [\"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/id #uuid \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\"] [\"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/type :answer.type/math] [\"4aea5cc7-3f32-5642-acb9-e0319af96dc2\" :answer/value \"- 4 e\"] [\"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/id #uuid \"83e5ecf4-5345-529a-a8bd-c1801b64068e\"] [\"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/type :answer.type/math] [\"83e5ecf4-5345-529a-a8bd-c1801b64068e\" :answer/value \"4 e\"] [\"9859c69d-7782-550e-b343-95e58b509469\" :answer/id #uuid \"9859c69d-7782-550e-b343-95e58b509469\"] [\"9859c69d-7782-550e-b343-95e58b509469\" :answer/type :answer.type/math] [\"9859c69d-7782-550e-b343-95e58b509469\" :answer/value \"2 e\"] [\"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/id #uuid \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\"] [\"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/type :answer.type/math] [\"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\" :answer/value \"8 e\"] [\"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/id #uuid \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\"] [\"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/type :answer.type/math] [\"77bc0e93-1948-5837-b8e0-0c0061b9dee4\" :answer/value \"\\\\frac{4 e}{3}\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/id #uuid \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/key \"answer\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/type :answer-field.type/radio] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"4aea5cc7-3f32-5642-acb9-e0319af96dc2\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"83e5ecf4-5345-529a-a8bd-c1801b64068e\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"9859c69d-7782-550e-b343-95e58b509469\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"2367f4c3-a5ba-5ca0-a543-e4ec0d4d3266\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/choices \"77bc0e93-1948-5837-b8e0-0c0061b9dee4\"] [\"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\" :answer-field/correct \"83e5ecf4-5345-529a-a8bd-c1801b64068e\"] [\"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/id #uuid \"f406a425-58e3-5cb0-8a62-2e89af536b93\"] [\"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/worked-solution \"Let $u=x + 1$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 4 e^{x + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=4\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n4\\\\left(\\\\left[e^{u}\\\\right]_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1}\\\\right)=4\\\\left(\\\\left(2 e\\\\right)-\\\\left(e\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n4 e.\\n$$\"] [\"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/difficulty :question.difficulty/easy] [\"f406a425-58e3-5cb0-8a62-2e89af536b93\" :question/answer-fields \"a1d0866e-c90b-55c6-9686-a1d7c0e650a6\"] [17592186184352 :knowledge-point/questions \"f406a425-58e3-5cb0-8a62-2e89af536b93\"] [\"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/id #uuid \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\"] [\"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/type :answer.type/math] [\"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\" :answer/value \"1\"] [\"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/id #uuid \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\"] [\"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/type :answer.type/math] [\"5ee53119-801c-5d7a-bb64-62cc1c92a98e\" :answer/value \"3\"] [\"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/id #uuid \"bb380a3a-cdbc-5089-a078-318f0a79cb30\"] [\"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/type :answer.type/math] [\"bb380a3a-cdbc-5089-a078-318f0a79cb30\" :answer/value \"\\\\frac{2}{3}\"] [\"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/id #uuid \"92ac924c-ab03-546c-8fc4-59089b9fb12a\"] [\"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/type :answer.type/math] [\"92ac924c-ab03-546c-8fc4-59089b9fb12a\" :answer/value \"4\"] [\"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/id #uuid \"d00627be-806e-56e1-a0f4-adffa702335e\"] [\"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/type :answer.type/math] [\"d00627be-806e-56e1-a0f4-adffa702335e\" :answer/value \"2\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/id #uuid \"927abd5e-1d6a-5af0-b897-119b76a16469\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/key \"answer\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/type :answer-field.type/radio] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"fd6742df-8cb3-5526-a4da-ef6e9b8a767d\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"5ee53119-801c-5d7a-bb64-62cc1c92a98e\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"bb380a3a-cdbc-5089-a078-318f0a79cb30\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"92ac924c-ab03-546c-8fc4-59089b9fb12a\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/choices \"d00627be-806e-56e1-a0f4-adffa702335e\"] [\"927abd5e-1d6a-5af0-b897-119b76a16469\" :answer-field/correct \"d00627be-806e-56e1-a0f4-adffa702335e\"] [\"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/id #uuid \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\"] [\"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 4 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=2\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n2\\\\left(\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(2 \\\\right)}}\\\\right)=2\\\\left(\\\\left(2\\\\right)-\\\\left(1\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n2.\\n$$\"] [\"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/difficulty :question.difficulty/easy] [\"6a946e03-6181-5b4b-9cac-25d4e9fde19e\" :question/answer-fields \"927abd5e-1d6a-5af0-b897-119b76a16469\"] [17592186184352 :knowledge-point/questions \"6a946e03-6181-5b4b-9cac-25d4e9fde19e\"] [\"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/id #uuid \"ebf49655-443a-5127-b311-79e85425e7ea\"] [\"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/type :answer.type/math] [\"ebf49655-443a-5127-b311-79e85425e7ea\" :answer/value \"\\\\frac{5}{2}\"] [\"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/id #uuid \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\"] [\"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/type :answer.type/math] [\"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\" :answer/value \"3\"] [\"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/id #uuid \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\"] [\"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/type :answer.type/math] [\"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\" :answer/value \"\\\\frac{3}{2}\"] [\"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/id #uuid \"15debcdc-0d61-565d-a7a6-2bf07ab35569\"] [\"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/type :answer.type/math] [\"15debcdc-0d61-565d-a7a6-2bf07ab35569\" :answer/value \"\\\\frac{7}{2}\"] [\"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/id #uuid \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\"] [\"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/type :answer.type/math] [\"ddf09385-6d7c-5642-b532-1ed2c51c22a1\" :answer/value \"\\\\frac{3}{4}\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/id #uuid \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/key \"answer\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/type :answer-field.type/radio] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"ebf49655-443a-5127-b311-79e85425e7ea\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"e2e01880-d67a-5e07-8fbb-87aeb77c0d52\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"15debcdc-0d61-565d-a7a6-2bf07ab35569\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/choices \"ddf09385-6d7c-5642-b532-1ed2c51c22a1\"] [\"77e60f23-a5ed-5ad1-bd45-17f9e6222094\" :answer-field/correct \"1e20bdb2-f617-5b4e-818b-7ae9dce5e6ff\"] [\"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/id #uuid \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\"] [\"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(4 \\\\right)}}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(4\\\\right)-\\\\left(1\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{3}{2}.\\n$$\"] [\"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/difficulty :question.difficulty/easy] [\"07203f15-8335-5d08-82e4-7f6bd6a8d51f\" :question/answer-fields \"77e60f23-a5ed-5ad1-bd45-17f9e6222094\"] [17592186184352 :knowledge-point/questions \"07203f15-8335-5d08-82e4-7f6bd6a8d51f\"] [\"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/id #uuid \"54f6aa68-cc41-5701-a86d-4b4ef910e724\"] [\"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/type :answer.type/math] [\"54f6aa68-cc41-5701-a86d-4b4ef910e724\" :answer/value \"1\"] [\"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/id #uuid \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\"] [\"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/type :answer.type/math] [\"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\" :answer/value \"3\"] [\"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/id #uuid \"aa0e7596-1dec-58d2-9258-7fa864a57f47\"] [\"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/type :answer.type/math] [\"aa0e7596-1dec-58d2-9258-7fa864a57f47\" :answer/value \"-2\"] [\"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/id #uuid \"9b40bda3-0f78-5171-b752-a9ec490a26b3\"] [\"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/type :answer.type/math] [\"9b40bda3-0f78-5171-b752-a9ec490a26b3\" :answer/value \"0\"] [\"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/id #uuid \"27fca89a-d521-572c-81bc-2a2f66d88c45\"] [\"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/type :answer.type/math] [\"27fca89a-d521-572c-81bc-2a2f66d88c45\" :answer/value \"2\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/id #uuid \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/key \"answer\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/type :answer-field.type/radio] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"54f6aa68-cc41-5701-a86d-4b4ef910e724\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"192a1f6c-a4fe-5b05-9abe-9a60c7c579bd\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"aa0e7596-1dec-58d2-9258-7fa864a57f47\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"9b40bda3-0f78-5171-b752-a9ec490a26b3\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/choices \"27fca89a-d521-572c-81bc-2a2f66d88c45\"] [\"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\" :answer-field/correct \"54f6aa68-cc41-5701-a86d-4b4ef910e724\"] [\"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/id #uuid \"1162eac6-17c1-5233-98b3-49a36c01cb96\"] [\"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/worked-solution \"Let $u=x^{2}$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} 2 x e^{x^{2}}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u.\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(2 \\\\right)}}=\\\\left(2\\\\right)-\\\\left(1\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n1.\\n$$\"] [\"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/difficulty :question.difficulty/easy] [\"1162eac6-17c1-5233-98b3-49a36c01cb96\" :question/answer-fields \"96bd0d82-e2f6-533e-a230-a4279b9e6e3b\"] [17592186184352 :knowledge-point/questions \"1162eac6-17c1-5233-98b3-49a36c01cb96\"] [\"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/id #uuid \"2693ded1-26c1-5c0d-b4c4-412355c38d90\"] [\"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/type :answer.type/math] [\"2693ded1-26c1-5c0d-b4c4-412355c38d90\" :answer/value \"\\\\frac{9}{4}\"] [\"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/id #uuid \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\"] [\"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/type :answer.type/math] [\"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\" :answer/value \"\\\\frac{9}{2}\"] [\"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/id #uuid \"8ba79cc8-bf17-5634-bca9-40d441d938d0\"] [\"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/type :answer.type/math] [\"8ba79cc8-bf17-5634-bca9-40d441d938d0\" :answer/value \"9\"] [\"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/id #uuid \"24c2143a-5033-5a7f-8092-fbe8f603b270\"] [\"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/type :answer.type/math] [\"24c2143a-5033-5a7f-8092-fbe8f603b270\" :answer/value \"- \\\\frac{3}{2}\"] [\"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/id #uuid \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\"] [\"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/type :answer.type/math] [\"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\" :answer/value \"-9\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/id #uuid \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/key \"answer\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/type :answer-field.type/radio] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"2693ded1-26c1-5c0d-b4c4-412355c38d90\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"8ba79cc8-bf17-5634-bca9-40d441d938d0\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"24c2143a-5033-5a7f-8092-fbe8f603b270\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/choices \"3feb9416-7edb-5b9e-bfd4-d0212b8cf423\"] [\"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\" :answer-field/correct \"e97a8ef5-1dbb-5d85-8670-9499bb9eaf5e\"] [\"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/id #uuid \"0c4ed185-75bb-5475-8582-73fab14779ef\"] [\"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/worked-solution \"Let $u=2 x$. Then $\\\\mathrm{d}u=(2)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=0\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(4 \\\\right)}\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{2 x}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{3}{2}\\\\left(\\\\int_{0}^{\\\\ln{\\\\left(4 \\\\right)}} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{3}{2}\\\\left(\\\\left[e^{u}\\\\right]_{0}^{\\\\ln{\\\\left(4 \\\\right)}}\\\\right)=\\\\frac{3}{2}\\\\left(\\\\left(4\\\\right)-\\\\left(1\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{9}{2}.\\n$$\"] [\"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/difficulty :question.difficulty/easy] [\"0c4ed185-75bb-5475-8582-73fab14779ef\" :question/answer-fields \"8e9c99ac-9267-5c5a-bc04-4c4131e0494e\"] [17592186184352 :knowledge-point/questions \"0c4ed185-75bb-5475-8582-73fab14779ef\"] [\"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/id #uuid \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\"] [\"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/type :answer.type/math] [\"c5cb16b4-b62c-58a7-988e-a43c4be2687d\" :answer/value \"e\"] [\"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/id #uuid \"4579a606-705a-5b81-92f9-e9a771902eed\"] [\"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/type :answer.type/math] [\"4579a606-705a-5b81-92f9-e9a771902eed\" :answer/value \"- \\\\frac{e}{2}\"] [\"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/id #uuid \"5161b975-ca2d-599e-9946-4e74d6cf200f\"] [\"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/type :answer.type/math] [\"5161b975-ca2d-599e-9946-4e74d6cf200f\" :answer/value \"\\\\frac{e}{6}\"] [\"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/id #uuid \"048efbea-6e0c-5241-b860-7e4d47da59ee\"] [\"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/type :answer.type/math] [\"048efbea-6e0c-5241-b860-7e4d47da59ee\" :answer/value \"\\\\frac{e}{2} + 2\"] [\"670e64ba-929c-5283-92fd-97c770affb04\" :answer/id #uuid \"670e64ba-929c-5283-92fd-97c770affb04\"] [\"670e64ba-929c-5283-92fd-97c770affb04\" :answer/type :answer.type/math] [\"670e64ba-929c-5283-92fd-97c770affb04\" :answer/value \"\\\\frac{e}{2}\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/id #uuid \"9c8fde7b-2d94-56a9-b801-9623fd748d61\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/key \"answer\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/type :answer-field.type/radio] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"c5cb16b4-b62c-58a7-988e-a43c4be2687d\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"4579a606-705a-5b81-92f9-e9a771902eed\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"5161b975-ca2d-599e-9946-4e74d6cf200f\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"048efbea-6e0c-5241-b860-7e4d47da59ee\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/choices \"670e64ba-929c-5283-92fd-97c770affb04\"] [\"9c8fde7b-2d94-56a9-b801-9623fd748d61\" :answer-field/correct \"670e64ba-929c-5283-92fd-97c770affb04\"] [\"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/id #uuid \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\"] [\"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/worked-solution \"Let $u=x^{2} + 1$. Then $\\\\mathrm{d}u=(2 x)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=1\\\\\\\\x=\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 1\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\sqrt{\\\\ln{\\\\left(2 \\\\right)}}} x e^{x^{2} + 1}\\\\,\\\\mathrm{d}x\\\\\\\\&=\\\\frac{1}{2}\\\\left(\\\\int_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n\\\\frac{1}{2}\\\\left(\\\\left[e^{u}\\\\right]_{1}^{\\\\ln{\\\\left(2 \\\\right)} + 1}\\\\right)=\\\\frac{1}{2}\\\\left(\\\\left(2 e\\\\right)-\\\\left(e\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n\\\\frac{e}{2}.\\n$$\"] [\"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/difficulty :question.difficulty/easy] [\"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\" :question/answer-fields \"9c8fde7b-2d94-56a9-b801-9623fd748d61\"] [17592186184352 :knowledge-point/questions \"8f74c32b-6785-5fbf-8802-fdcafb1f33f1\"] [\"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/id #uuid \"c15c9c6c-72dc-5029-a194-4ac26de2648a\"] [\"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/type :answer.type/math] [\"c15c9c6c-72dc-5029-a194-4ac26de2648a\" :answer/value \"3 e^{2}\"] [\"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/id #uuid \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\"] [\"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/type :answer.type/math] [\"48f7e0e6-8fc6-54a8-9f06-0b685010090e\" :answer/value \"6 e^{2}\"] [\"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/id #uuid \"c59b1278-42f4-5394-b44d-827c55f4dd8b\"] [\"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/type :answer.type/math] [\"c59b1278-42f4-5394-b44d-827c55f4dd8b\" :answer/value \"2 + 3 e^{2}\"] [\"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/id #uuid \"9a07d953-17e6-5229-901b-2c75990a8b05\"] [\"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/type :answer.type/math] [\"9a07d953-17e6-5229-901b-2c75990a8b05\" :answer/value \"- 3 e^{2}\"] [\"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/id #uuid \"036e3781-356a-57c7-bd36-1660aa1b0f1b\"] [\"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/type :answer.type/math] [\"036e3781-356a-57c7-bd36-1660aa1b0f1b\" :answer/value \"\\\\frac{3 e^{2}}{2}\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/id #uuid \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/key \"answer\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/type :answer-field.type/radio] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"c15c9c6c-72dc-5029-a194-4ac26de2648a\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"48f7e0e6-8fc6-54a8-9f06-0b685010090e\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"c59b1278-42f4-5394-b44d-827c55f4dd8b\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"9a07d953-17e6-5229-901b-2c75990a8b05\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/choices \"036e3781-356a-57c7-bd36-1660aa1b0f1b\"] [\"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\" :answer-field/correct \"c15c9c6c-72dc-5029-a194-4ac26de2648a\"] [\"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/id #uuid \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\"] [\"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/problem \"Evaluate exactly.\\n\\n$$\\n\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\n$$\\n\\nChoose the exact value.\"] [\"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/worked-solution \"Let $u=x + 2$. Then $\\\\mathrm{d}u=(1)\\\\,\\\\mathrm{d}x$.\\n\\nTransform both bounds:\\n\\n$$\\n\\\\begin{aligned}x=0&\\\\Longrightarrow u=2\\\\\\\\x=\\\\ln{\\\\left(2 \\\\right)}&\\\\Longrightarrow u=\\\\ln{\\\\left(2 \\\\right)} + 2\\\\end{aligned}\\n$$\\n\\nIncluding the differential factor gives\\n\\n$$\\n\\\\begin{aligned}&\\\\int_{0}^{\\\\ln{\\\\left(2 \\\\right)}} 3 e^{x + 2}\\\\,\\\\mathrm{d}x\\\\\\\\&=3\\\\left(\\\\int_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2} e^{u}\\\\,\\\\mathrm{d}u\\\\right).\\\\end{aligned}\\n$$\\n\\nEndpoint values: $e^{\\\\ln 2}=2,\\\\quad e^{2\\\\ln 2}=4$.\\n\\nUse the integration rule:\\n\\n$$\\n\\\\int e^{u}\\\\,\\\\mathrm{d}u=e^{u}+C.\\n$$\\n\\nEvaluate the primitive and subtract lower from upper:\\n\\n$$\\n3\\\\left(\\\\left[e^{u}\\\\right]_{2}^{\\\\ln{\\\\left(2 \\\\right)} + 2}\\\\right)=3\\\\left(\\\\left(2 e^{2}\\\\right)-\\\\left(e^{2}\\\\right)\\\\right).\\n$$\\n\\nThe exact answer is\\n\\n$$\\n3 e^{2}.\\n$$\"] [\"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/difficulty :question.difficulty/easy] [\"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\" :question/answer-fields \"1ef5cd53-d8af-5c45-b2f1-7692b75aa93c\"] [17592186184352 :knowledge-point/questions \"5e90f8ba-50a9-529a-9dd5-db0308df9cdc\"] [\"generator\" :question-generator/id #uuid \"9beb9b28-d4ce-5d84-873b-5e1e13e4f48f\"] [\"generator\" :question-generator/script \"generators/5f/5f493e8a1609ad7a80f5108c87f8ebe6122af635ee43ac29dc16041c915b6f54/generator.py\"] [17592186184352 :knowledge-point/question-generator \"generator\"]] \"retractions\" [[17592186184352 :knowledge-point/question-generator 17592186683253]]}",
