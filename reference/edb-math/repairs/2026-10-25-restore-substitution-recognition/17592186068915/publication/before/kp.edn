frac{7 \\pi}{6}}^{\\frac{7 \\pi}{4}}\\\\ &=- \\frac{9}{16}\\left(\\cos\\left(\\frac{7 \\pi}{4}\\right)-\\cos\\left(\\frac{7 \\pi}{6}\\right)\\right)\\\\ &=- \\frac{9}{16}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676295 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}" :db/id #edb/ref 17592186676256}] :answer-field/correct {:answer/id #uuid "4a0e74a7-1c36-51b6-91e4-886cab511f20" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}" :db/id #edb/ref 17592186676256} :answer-field/id #uuid "e10b7850-b68c-56e8-b02f-3dbe81ab05a7" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676306}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c367b576-70c2-5965-8278-60a472b975f2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=- \\frac{2 x}{5} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{2}{5},\\qquad \\mathrm{d}x=\\left(- \\frac{5}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{15 \\pi}{4}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(- \\frac{15 \\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{11 \\pi}{6}\\\\ x=\\frac{5 \\pi}{24}&\\quad\\Longrightarrow\\quad u=- \\frac{2}{5}\\left(\\frac{5 \\pi}{24}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{15 \\pi}{4}}^{\\frac{5 \\pi}{24}} \\frac{4}{3}\\sin\\left(- \\frac{2 x}{5} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{4}{3}\\left(- \\frac{5}{2}\\right)\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\int_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{11 \\pi}{6}}^{\\frac{\\pi}{4}}\\\\ &=\\frac{10}{3}\\left(\\cos\\left(\\frac{\\pi}{4}\\right)-\\cos\\left(\\frac{11 \\pi}{6}\\right)\\right)\\\\ &=\\frac{10}{3}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(\\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{3} + \\frac{5 \\sqrt{2}}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676296 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}" :db/id #edb/ref 17592186676300}] :answer-field/correct {:answer/id #uuid "cf452ea9-b76c-5931-acd8-0d28a08d20ad" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}" :db/id #edb/ref 17592186676300} :answer-field/id #uuid "9eaf1394-6f14-55a0-a068-583ffa37b8e2" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676285}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "c4127c78-e9a5-5dca-9fdf-b419c6a80b69" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=- \\frac{3 x}{2} + \\frac{\\pi}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=- \\frac{3}{2},\\qquad \\mathrm{d}x=\\left(- \\frac{2}{3}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{7 \\pi}{9}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{7 \\pi}{9}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{5 \\pi}{3}\\\\ x=- \\frac{\\pi}{6}&\\quad\\Longrightarrow\\quad u=- \\frac{3}{2}\\left(- \\frac{\\pi}{6}\\right)+\\left(\\frac{\\pi}{2}\\right)=\\frac{3 \\pi}{4}.\\end{aligned}\n$$\n\nThe transformed bounds decrease because the inner derivative is negative. Keep their order together with the negative substitution factor.\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{7 \\pi}{9}}^{- \\frac{\\pi}{6}} \\frac{5}{3}\\cos\\left(- \\frac{3 x}{2} + \\frac{\\pi}{2}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{5}{3}\\left(- \\frac{2}{3}\\right)\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\int_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{10}{9}\\left[\\sin\\left(u\\right)\\right]_{\\frac{5 \\pi}{3}}^{\\frac{3 \\pi}{4}}\\\\ &=- \\frac{10}{9}\\left(\\sin\\left(\\frac{3 \\pi}{4}\\right)-\\sin\\left(\\frac{5 \\pi}{3}\\right)\\right)\\\\ &=- \\frac{10}{9}\\left(\\left(\\frac{\\sqrt{2}}{2}\\right)-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\right)\\\\ &=- \\frac{5 \\sqrt{3}}{9} - \\frac{5 \\sqrt{2}}{9}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676305 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\pi}" :db/id #edb/ref 17592186676302}] :answer-field/correct {:answer/id #uuid "d3fcda61-dde0-56ba-aba9-3c128ff21e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{\\pi}" :db/id #edb/ref 17592186676302} :answer-field/id #uuid "ec92a541-0236-55c6-9780-e15a96944df5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676311}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e08ae2d3-6cbc-51bb-9630-56e2ea57265b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{\\pi x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\pi}{2},\\qquad \\mathrm{d}x=\\left(\\frac{2}{\\pi}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=0&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(0\\right)+\\left(0\\right)=0\\\\ x=\\frac{1}{3}&\\quad\\Longrightarrow\\quad u=\\frac{\\pi}{2}\\left(\\frac{1}{3}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{1}{3}} 7\\cos\\left(\\frac{\\pi x}{2}\\right)\\,\\mathrm{d}x\\\\ &=7\\left(\\frac{2}{\\pi}\\right)\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\int_{0}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{14}{\\pi}\\left[\\sin\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{6}}\\\\ &=\\frac{14}{\\pi}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(0\\right)\\right)\\\\ &=\\frac{14}{\\pi}\\left(\\left(\\frac{1}{2}\\right)-\\left(0\\right)\\right)\\\\ &=\\frac{7}{\\pi}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186678030 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d364c40-fa06-5866-9730-fc22241b4e8d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678038} {:answer/id #uuid "0d7b3916-d16a-55a0-887c-9707e9a294ca" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678039} {:answer/id #uuid "329a4cb4-a769-5de9-aacc-d3079ac1112e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678055} {:answer/id #uuid "a8d12b77-3bc8-5510-bf0f-5292e1c94647" :answer/type {:db/ident :answer.type/math} :answer/value "\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u" :db/id #edb/ref 17592186678102} {:answer/id #uuid "e3244a65-bdfd-5e2b-b49c-7d1d726668df" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678121}] :answer-field/correct {:answer/id #uuid "329a4cb4-a769-5de9-aacc-d3079ac1112e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678055} :answer-field/id #uuid "51f41b3b-a03c-5106-84c8-f7a88bbcb4fa" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186678065}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "01533aaa-438a-5910-8a75-4893f358992d" :question/problem "Use the substitution $u=3 x$. Which integral is obtained?\n\n$$\n\\int \\sin{\\left(3 x \\right)}\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=3 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int \\sin{\\left(3 x \\right)}\\,\\mathrm{d}x\\\\&=\\frac{1}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\frac{1}{3}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\n$$"} {:db/id #edb/ref 17592186678032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1370ebf1-d10d-5180-8784-1da63b65d3cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u" :db/id #edb/ref 17592186678042} {:answer/id #uuid "20a6f83e-08a7-5e18-b0a6-e42e13f4d6b1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678046} {:answer/id #uuid "724fe2c8-bd5c-52c8-822c-2f560bfc0df9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678078} {:answer/id #uuid "87d0fe98-793f-5c5c-ae8f-50ede75bb5b7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678093} {:answer/id #uuid "a6a23450-f444-5f2f-a684-aa998f8e2f64" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678099}] :answer-field/correct {:answer/id #uuid "1370ebf1-d10d-5180-8784-1da63b65d3cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u" :db/id #edb/ref 17592186678042} :answer-field/id #uuid "4794dbc9-64ab-5a53-a007-6a1a920a04b4" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186678062}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "03958827-e800-5038-835b-8f267d750c98" :question/problem "Use the substitution $u=2 x$. Which integral is obtained?\n\n$$\n\\int 2 \\cos{\\left(2 x \\right)}\\,\\mathrm{d}x\n$$" :question/worked-solution "Let $u=2 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 2 \\cos{\\left(2 x \\right)}\\,\\mathrm{d}x\\\\&=\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nThe transformed integral is\n\n$$\n\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u.\n$$"} {:db/id #edb/ref 17592186678033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bd2ef87-461c-54e9-9cd4-436889993594" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sin{\\left(1 - 4 x \\right)}" :db/id #edb/ref 17592186678050}] :answer-field/correct {:answer/id #uuid "2bd2ef87-461c-54e9-9cd4-436889993594" :answer/type {:db/ident :answer.type/math} :answer/value "- \\sin{\\left(1 - 4 x \\right)}" :db/id #edb/ref 17592186678050} :answer-field/id #uuid "7662edc2-84aa-5b07-a675-80237a70e872" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186678081}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "04ed37b0-08bb-53bf-b3a9-2a83ea7f67cd" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cos{\\left(1 - 4 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\n{{answer}} $+C$" :question/retired true :question/worked-solution "Let $u=1 - 4 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-4.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cos{\\left(1 - 4 x \\right)}\\,\\mathrm{d}x\\\\&=-\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n-\\left(\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- \\sin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\sin{\\left(1 - 4 x \\right)}+C.\n$$"} {:db/id #edb/ref 17592186678044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a51af6db-9344-5ef0-81f9-25a39a63aa6f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186678098}] :answer-field/correct {:answer/id #uuid "a51af6db-9344-5ef0-81f9-25a39a63aa6f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186678098} :answer-field/id #uuid "aec93d34-d853-521e-9b50-c9c26acbc741" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186678106}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "14a4bdf4-8ea4-51a6-81da-5304f43e7279" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{\\pi}{8}} 4 \\cos{\\left(- 4 x + \\frac{\\pi}{2} \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\sin{\\left(\\frac{\\pi}{2} \\right)}=1,\\quad \\sin{\\left(0 \\right)}=0$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=- 4 x + \\frac{\\pi}{2}$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-4.\n$$\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=\\frac{\\pi}{2}\\\\x=\\frac{\\pi}{8}&\\Longrightarrow u=0\\end{aligned}\n$$\n\nThe new bounds decrease. Keep this order when evaluating the antiderivative.\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{\\pi}{8}} 4 \\cos{\\left(- 4 x + \\frac{\\pi}{2} \\right)}\\,\\mathrm{d}x\\\\&=-\\left(\\int_{\\frac{\\pi}{2}}^{0} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate:\n\n$$\n\\left[- \\sin{\\left(u \\right)}\\right]_{\\frac{\\pi}{2}}^{0}=\\left(0\\right)-\\left(-1\\right).\n$$\n\nThe answer is\n\n$$\n1.\n$$"} {:db/id #edb/ref 17592186678049 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8772597-72e4-58b4-b2a1-6f679b96ed8f" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2}{3}" :db/id #edb/ref 17592186678108}] :answer-field/correct {:answer/id #uuid "b8772597-72e4-58b4-b2a1-6f679b96ed8f" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{2}{3}" :db/id #edb/ref 17592186678108} :answer-field/id #uuid "dcd96290-8241-5bb2-b355-d84f90a808e0" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186678118}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "25bced4a-34ed-5c44-b898-2a6f8e96effe" :question/problem "Evaluate exactly.\n\n$$\n\\int_{\\frac{\\pi}{3}}^{\\frac{\\pi}{2}} 2 \\cos{\\left(3 x \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\nEndpoint values: $\\sin{\\left(\\pi \\right)}=0,\\quad \\sin{\\left(\\frac{3 \\pi}{2} \\right)}=-1$.\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=3 x$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=3.\n$$\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=\\frac{\\pi}{3}&\\Longrightarrow u=\\pi\\\\x=\\frac{\\pi}{2}&\\Longrightarrow u=\\frac{3 \\pi}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{\\frac{\\pi}{3}}^{\\frac{\\pi}{2}} 2 \\cos{\\left(3 x \\right)}\\,\\mathrm{d}x\\\\&=\\frac{2}{3}\\left(\\int_{\\pi}^{\\frac{3 \\pi}{2}} \\cos{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate and evaluate:\n\n$$\n\\left[\\frac{2 \\sin{\\left(u \\right)}}{3}\\right]_{\\pi}^{\\frac{3 \\pi}{2}}=\\left(- \\frac{2}{3}\\right)-\\left(0\\right).\n$$\n\nThe answer is\n\n$$\n- \\frac{2}{3}.\n$$"} {:db/id #edb/ref 17592186678052 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e86e62-b46c-53c0-b647-0a53dd840de6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin{\\left(4 x + 1 \\right)}" :db/id #edb/ref 17592186678035}] :answer-field/correct {:answer/id #uuid "06e86e62-b46c-53c0-b647-0a53dd840de6" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin{\\left(4 x + 1 \\right)}" :db/id #edb/ref 17592186678035} :answer-field/id #uuid "58cda100-a260-5e8e-be68-fde68d9e9f1e" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186678069}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "2ecdfaa1-5bd9-5f81-b6e3-023e7b805d55" :question/problem "Find an antiderivative.\n\n$$\n\\int 4 \\cos{\\left(4 x + 1 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C$.\n\n{{answer}} $+C$" :question/retired true :question/worked-solution "Let $u=4 x + 1$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 4 \\cos{\\left(4 x + 1 \\right)}\\,\\mathrm{d}x\\\\&=\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\int \\cos{\\left(u \\right)}\\,\\mathrm{d}u=\\sin{\\left(u \\right)}+C.\n$$\n\nSubstitute back:\n\n$$\n\\sin{\\left(4 x + 1 \\right)}+C.\n$$"} {:db/id #edb/ref 17592186678057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228461a2-75b4-5f54-8f71-89933be5be66" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\cos{\\left(2 x + 1 \\right)}}{2}" :db/id #edb/ref 17592186678048}] :answer-field/correct {:answer/id #uuid "228461a2-75b4-5f54-8f71-89933be5be66" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3 \\cos{\\left(2 x + 1 \\right)}}{2}" :db/id #edb/ref 17592186678048} :answer-field/id #uuid "9fb08089-1bd7-5116-9851-4fa4e676b4dc" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186678095}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "364c4cf3-af52-5e60-b60f-daba0a790be0" :question/problem "Find an antiderivative.\n\n$$\n\\int 3 \\sin{\\left(2 x + 1 \\right)}\\,\\mathrm{d}x\n$$\n\nYou may use $\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u=- \\cos{\\left(u \\right)}+C$.\n\n{{answer}} $+C$" :question/retired true :question/worked-solution "Let $u=2 x + 1$. Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2.\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int 3 \\sin{\\left(2 x + 1 \\right)}\\,\\mathrm{d}x\\\\&=\\frac{3}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nIntegrate with respect to $u$:\n\n$$\n\\frac{3}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)=- \\frac{3 \\cos{\\left(u \\right)}}{2}+C.\n$$\n\nSubstitute back:\n\n$$\n- \\frac{3 \\cos{\\left(2 x + 1 \\right)}}{2}+C.\n$$"} {:db/id #edb/ref 17592186678058 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3185c284-174a-5de9-9fcc-b81120e57947" :answer/type {:db/ident :answer.type/math} :answer/value "-\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678054} {:answer/id #uuid "4f51384d-7893-5c2f-b40e-f039060605dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678063} {:answer/id #uuid "6b56642e-85d1-54a2-9e38-06e33e664536" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678074} {:answer/id #uuid "af66ef88-cf83-5f91-bfc0-f9f6fb513226" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678107} {:answer/id #uuid "bdbd2481-d186-5643-8429-a445812bd2dc" :answer/type {:db/ident :answer.type/math} :answer/value "8\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678110}] :answer-field/correct {:answer/id #uuid "4f51384d-7893-5c2f-b40e-f039060605dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\left(\\int \\sin{\\left(u \\right)}\\,\\mathrm{d}u\\right)" :db/id #edb/ref 17592186678063} :answer-field/id #uuid "a3508ac1-91cd-5909-b864-c38a56b47702" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186678097}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "369e69ee-ba29-5731-a1df-5057b2bd69bb" :question/problem "Use the substitution