2}}^{\\frac{\\pi}{6}} 8\\sin\\left(6 x\\right)\\,\\mathrm{d}x\\\\ &=8\\left(\\frac{1}{6}\\right)\\int_{\\frac{\\pi}{2}}^{\\pi} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\int_{\\frac{\\pi}{2}}^{\\pi} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\left[-\\cos\\left(u\\right)\\right]_{\\frac{\\pi}{2}}^{\\pi}\\\\ &=- \\frac{4}{3}\\left(\\cos\\left(\\pi\\right)-\\cos\\left(\\frac{\\pi}{2}\\right)\\right)\\\\ &=- \\frac{4}{3}\\left(\\left(-1\\right)-\\left(0\\right)\\right)\\\\ &=\\frac{4}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}" :db/id #edb/ref 17592186676307}] :answer-field/correct {:answer/id #uuid "e121f6b0-8162-5af1-8275-aafe620e7f30" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}" :db/id #edb/ref 17592186676307} :answer-field/id #uuid "e1757f25-fe17-5f29-aeef-375989f1d640" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676308}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "91ceb661-bbb3-59a9-a7e3-99caa019215e" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{4 x}{3} + \\frac{\\pi}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{4}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{4}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{16}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(- \\frac{\\pi}{16}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{4}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{4}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(\\frac{\\pi}{3}\\right)=\\frac{2 \\pi}{3}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{16}}^{\\frac{\\pi}{4}} \\frac{7}{3}\\cos\\left(\\frac{4 x}{3} + \\frac{\\pi}{3}\\right)\\,\\mathrm{d}x\\\\ &=\\frac{7}{3}\\left(\\frac{3}{4}\\right)\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\int_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{7}{4}\\left[\\sin\\left(u\\right)\\right]_{\\frac{\\pi}{4}}^{\\frac{2 \\pi}{3}}\\\\ &=\\frac{7}{4}\\left(\\sin\\left(\\frac{2 \\pi}{3}\\right)-\\sin\\left(\\frac{\\pi}{4}\\right)\\right)\\\\ &=\\frac{7}{4}\\left(\\left(\\frac{\\sqrt{3}}{2}\\right)-\\left(\\frac{\\sqrt{2}}{2}\\right)\\right)\\\\ &=- \\frac{7 \\sqrt{2}}{8} + \\frac{7 \\sqrt{3}}{8}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676289 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209ed13-71e1-5e2c-8d34-7c9e19e93ce1" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186676242} {:answer/id #uuid "6e33ac7d-1111-58bc-a5ef-3e977fe55380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{4}" :db/id #edb/ref 17592186676271} {:answer/id #uuid "97607e32-bce9-5350-af3d-b0b95b9120a8" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{27}{2}" :db/id #edb/ref 17592186676283} {:answer/id #uuid "a3ae71b0-0616-5582-8426-8500a21242c5" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186676287} {:answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186676312}] :answer-field/correct {:answer/id #uuid "ed465d05-32c5-59f9-862e-19ebdb8ba802" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{2}" :db/id #edb/ref 17592186676312} :answer-field/id #uuid "91ff406b-b01c-500b-a9d1-8a1f7d62f93a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186676281}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a3ee7f62-5bfe-5d41-ba73-e391e6af3e4b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Let $u=\\frac{2 x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{2}{3},\\qquad \\mathrm{d}x=\\left(\\frac{3}{2}\\right)\\mathrm{d}u.\n$$\n\nTransform both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(- \\frac{\\pi}{4}\\right)+\\left(0\\right)=- \\frac{\\pi}{6}\\\\ x=\\frac{\\pi}{4}&\\quad\\Longrightarrow\\quad u=\\frac{2}{3}\\left(\\frac{\\pi}{4}\\right)+\\left(0\\right)=\\frac{\\pi}{6}.\\end{aligned}\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int_{- \\frac{\\pi}{4}}^{\\frac{\\pi}{4}} 9\\cos\\left(\\frac{2 x}{3}\\right)\\,\\mathrm{d}x\\\\ &=9\\left(\\frac{3}{2}\\right)\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\int_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}} \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{27}{2}\\left[\\sin\\left(u\\right)\\right]_{- \\frac{\\pi}{6}}^{\\frac{\\pi}{6}}\\\\ &=\\frac{27}{2}\\left(\\sin\\left(\\frac{\\pi}{6}\\right)-\\sin\\left(- \\frac{\\pi}{6}\\right)\\right)\\\\ &=\\frac{27}{2}\\left(\\left(\\frac{1}{2}\\right)-\\left(- \\frac{1}{2}\\right)\\right)\\\\ &=\\frac{27}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676292 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5564e6d7-8470-5ee5-be25-90e415f3a1f7" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{9 \\sqrt{3}}{32} - \\frac{9 \\sqrt{2}}{32}" :db/id #edb/ref 17592186676260} 