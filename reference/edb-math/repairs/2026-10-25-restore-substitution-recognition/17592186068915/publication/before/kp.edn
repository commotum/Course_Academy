\right)\\int_{0}^{\\frac{\\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\int_{0}^{\\frac{\\pi}{3}} \\sin\\left(u\\right)\\,\\mathrm{d}u\\\\ &=\\frac{4}{3}\\left[-\\cos\\left(u\\right)\\right]_{0}^{\\frac{\\pi}{3}}\\\\ &=- \\frac{4}{3}\\left(\\cos\\left(\\frac{\\pi}{3}\\right)-\\cos\\left(0\\right)\\right)\\\\ &=- \\frac{4}{3}\\left(\\left(\\frac{1}{2}\\right)-\\left(1\\right)\\right)\\\\ &=\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676276 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)" :db/id #edb/ref 17592186676268}] :answer-field/correct {:answer/id #uuid "6b096547-15c1-510d-a3dc-fbef497569c6" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)" :db/id #edb/ref 17592186676268} :answer-field/id #uuid "22365332-c83c-5a84-b180-311e56a951fa" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186676243}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "883d352c-d5bb-5a9d-bb5a-ac9c9965c71c" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int 4\\cos\\left(1 - 5 x\\right)\\,\\mathrm{d}x =\n$$\n\n{{answer}} $+C$" :question/retired true :question/worked-solution "Let $u=1 - 5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=-5,\\qquad \\mathrm{d}x=\\left(- \\frac{1}{5}\\right)\\mathrm{d}u.\n$$\n\nSubstitute and integrate:\n\n$$\n\\begin{aligned}&\\int 4\\cos\\left(1 - 5 x\\right)\\,\\mathrm{d}x\\\\ &=4\\left(- \\frac{1}{5}\\right)\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{4}{5}\\int \\cos\\left(u\\right)\\,\\mathrm{d}u\\\\ &=- \\frac{4}{5}\\left(\\sin\\left(u\\right)\\right)+C\\\\ &=- \\frac{4}{5}\\sin\\left(1 - 5 x\\right)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676277 :question/answer-fields [{:answer-fi