rac{3 \\pi}{2} \\right)}=0,\\quad \\cos{\\left(2 \\pi \\right)}=1$.\n\nIntegrate and evaluate:\n\n$$\n\\left[- \\frac{\\cos{\\left(u \\right)}}{3}\\right]_{\\frac{3 \\pi}{2}}^{2 \\pi}=\\left(- \\frac{1}{3}\\right)-\\left(0\\right).\n$$\n\nThe answer is\n\n$$\n- \\frac{1}{3}.\n$$"] [:db/add "faa2cd78-ea47-5dd0-a920-89ce06af0eb4" :question/difficulty :question.difficulty/easy] [:db/add "faa2cd78-ea47-5dd0-a920-89ce06af0eb4" :question/answer-fields "37160a5f-0f7a-52e6-a471-2cfc5367c04e"] [:db/ensure "faa2cd78-ea47-5dd0-a920-89ce06af0eb4" :question/validate] [:db/add 17592186068915 :knowledge-point/questions "faa2cd78-ea47-5dd0-a920-89ce06af0eb4"] [:db/add "4b61a539-a800-5d5f-a30b-06695677f4e6" :answer/id #uuid "4b61a539-a800-5d5f-a30b-06695677f4e6"] [:db/add "4b61a539-a800-5d5f-a30b-06695677f4e6" :answer/type :answer.type/math] [:db/add "4b61a539-a800-5d5f-a30b-06695677f4e6" :answer/value "- \\frac{\\cos{\\left(3 x \\right)}}{3}+C"] [:db/ensure "4b61a539-a800-5d5f-a30b-06695677f4e6" :answer/validate] [:db/add "ad4f3ee3-3ab8-500f-aace-22010201a5c6" :answer/id #uuid "ad4f3ee3-3ab8-500f-aace-22010201a5c6"] [:db/add "ad4f3ee3-3ab8-500f-aace-22010201a5c6" :answer/type :answer.type/math] [:db/add "ad4f3ee3-3ab8-500f-aace-22010201a5c6" :answer/value "\\frac{2 \\cos{\\left(3 x \\right)}}{3}+C"] [:db/ensure "ad4f3ee3-3ab8-500f-aace-22010201a5c6" :answer/validate] [:db/add "bdae9815-2795-5762-afa6-e76435e009c8" :answer/id #uuid "bdae9815-2795-5762-afa6-e76435e009c8"] [:db/add "bdae9815-2795-5762-afa6-e76435e009c8" :answer/type :answer.type/math] [:db/add "bdae9815-2795-5762-afa6-e76435e009c8" :answer/value "- \\frac{\\cos{\\left(3 x + 1 \\right)}}{3}+C"] [:db/ensure "bdae9815-2795-5762-afa6-e76435e009c8" :answer/validate] [:db/add "3f8d42b1-f703-53bf-8f19-1376ee424ff7" :answer/id #uuid "3f8d42b1-f703-53bf-8f19-1376ee424ff7"] [:db/add "3f8d42b1-f703-53bf-8f19-1376ee424ff7" :answer/type :answer.type/math] [:db/add "3f8d42b1-f703-53bf-8f19-1376ee424ff7" :answer/value "- \\frac{\\co