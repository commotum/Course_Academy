d "be3cb9cd-cb94-5657-98ff-b3d91e1ff9d6" :answer/type {:db/ident :answer.type/math} :answer/value "-6ru+3st" :db/id #edb/ref 17592186334635} {:answer/id #uuid "fa49eaa1-621e-5ca8-a141-b55927a350aa" :answer/type {:db/ident :answer.type/math} :answer/value "3(2st-ru)" :db/id #edb/ref 17592186335181}] :answer-field/correct {:answer/id #uuid "925c8e43-d240-576e-96a7-f6450bcebaff" :answer/type {:db/ident :answer.type/math} :answer/value "6(st-ru)" :db/id #edb/ref 17592186334293} :answer-field/id #uuid "8926dc70-416f-5104-b768-f00f2078937e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335501}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f8c0050-79c4-5426-9e5c-a8628ebc0ae0" :question/math-academy-id "q-69650" :question/problem "Calculate $det(H)$, if\n$$\n\\displaystyle H=\\begin{bmatrix}-2r & 3s \\\\ -2t & 3u\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =\\begin{vmatrix}-2r & 3s \\\\ -2t & 3u\\end{vmatrix} \\\\  & =-2r\\cdot 3u-3s\\cdot (-2t) \\\\  & =-6ru-(-6st) \\\\  & =-6ru+6st \\\\  & =6(st-ru)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335992 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd1c86f-37e4-5b7b-9ec3-6d55d9670cea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186333244} {:answer/id #uuid "4342bd65-1b39-56fb-b10b-45b1a8deeebc" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186333618} {:answer/id #uuid "982f2c1a-e0ab-57c2-b71f-62ccc2593e9b" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186334339} {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186334384} {:answer/id #uuid "ab173fd5-9f80-5b1f-9676-76188073a554" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186334491}] :answer-field/correct {:answer/id #uuid "9e476a33-a9f4-5b54-ad86-0d592acad0c2" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186334384} :answer-field/id #uuid "8c672b33-f965-56dc-b5e9-ce679a558195" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335509}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66ad3ebb-398d-57e0-be2a-0ce7c08b87a1" :question/math-academy-id "q-69661" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}1-p & 1+p \\\\ -3 & 2\\end{bmatrix}\n$$\nand $det(S)=2$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}1-p & 1+p \\\\ -3 & 2\\end{vmatrix} \\\\  & =(1-p)\\cdot 2-(1+p)\\cdot (-3) \\\\  & =2-2p+3+3p \\\\  & =5+p\\end{aligned}\n$$\n\nSince $det(S)=2$, we obtain:\n\n$$\n\\begin{aligned}det(S) & =2 \\\\ 5+p & =2 \\\\ p & =2-5 \\\\ p & =-3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510569 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a997286f-4db9-53ee-8849-22966e083d6c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{113}{280}" :db/id #edb/ref 17592186510578}] :answer-field/correct {:answer/id #uuid "a997286f-4db9-53ee-8849-22966e083d6c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{113}{280}" :db/id #edb/ref 17592186510578} :answer-field/id #uuid "aac06ef3-2984-5073-a683-edc5d64f81a8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510579}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "107b0d08-c0c2-5e3b-a247-c4238dbd6d8f" :question/problem "Calculate $det(A)$ given that\n$$\n\\displaystyle A=\\begin{bmatrix}\\frac{5}{8} & \\frac{9}{5} \\\\ -\\frac{2}{9} & -\\frac{9}{7}\\end{bmatrix}.\n$$\n\n$det(A)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(A) & =\\begin{vmatrix}\\frac{5}{8} & \\frac{9}{5} \\\\ -\\frac{2}{9} & -\\frac{9}{7}\\end{vmatrix} \\\\  & =\\frac{5}{8}\\cdot \\left(-\\frac{9}{7}\\right)-\\frac{9}{5}\\cdot \\left(-\\frac{2}{9}\\right) \\\\  & =-\\frac{45}{56}-\\left(-\\frac{2}{5}\\right) \\\\  & =-\\frac{113}{280}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510573 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32e54747-95d9-5771-963b-49dcf4295948" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{55}{14}" :db/id #edb/ref 17592186510574}] :answer-field/correct {:answer/id #uuid "32e54747-95d9-5771-963b-49dcf4295948" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{55}{14}" :db/id #edb/ref 17592186510574} :answer-field/id #uuid "1b44817c-904a-519b-9cfd-76497778888f" :answer-field/key "field-1" :answer-field/type {