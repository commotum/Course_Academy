ath} :answer/value "-x-2{y}^{2}" :db/id #edb/ref 17592186631627} {:answer/id #uuid "d5125629-e1a8-53f9-90e9-35ff079d06bb" :answer/type {:db/ident :answer.type/math} :answer/value "-{x}^{2}-2y" :db/id #edb/ref 17592186631635} {:answer/id #uuid "d8e2477e-c358-5333-a3dd-60457a919cfb" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{2}-y" :db/id #edb/ref 17592186631646}] :answer-field/correct {:answer/id #uuid "d8e2477e-c358-5333-a3dd-60457a919cfb" :answer/type {:db/ident :answer.type/math} :answer/value "-2{x}^{2}-y" :db/id #edb/ref 17592186631646} :answer-field/id #uuid "48b618e3-2e1d-5898-8dd7-356068fbebc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186631768}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "557300de-09b3-5e0a-8a2f-375395204316" :question/math-academy-id "q-69652" :question/problem "Calculate $det(M)$, if\n $$\n\\displaystyle M=\\begin{bmatrix}2x & \\sqrt{y} \\\\ \\sqrt{y} & -x\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(M) & =\\begin{vmatrix}2x & \\sqrt{y} \\\\ \\sqrt{y} & -x\\end{vmatrix} \\\\  & =2x\\cdot (-x)-\\sqrt{y}\\cdot \\sqrt{y} \\\\  & =-2{x}^{2}-y\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632685 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e4bb45-d508-5b70-8ed2-f20eeac35ac7" :answer/type {:db/ident :answer.type/math} :answer/value "3-\\sqrt{2}z" :db/id #edb/ref 17592186632180} {:answer/id #uuid "43a035f5-e17f-596a-ae9d-b69bc4af5b9d" :answer/type {:db/ident :answer.type/math} :answer/value "2+3z" :db/id #edb/ref 17592186632233} {:answer/id #uuid "469b0701-86d6-5c2f-b831-b0922d1f108a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}-3z" :db/id #edb/ref 17592186632243} {:answer/id #uuid "6a1394b3-db21-57d8-8761-69658e219f6b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}+3z" :db/id #edb/ref 17592186632304} {:answer/id #uuid "d7fea6f7-ac67-5882-b9b2-ba8e1ad1c432" :answer/type {:db/ident :answer.type/math} :answer/value "2-3z" :db/id #edb/ref 17592186632473}] :answer-field/correct {:answer/id #uuid "d7fea6f7-ac67-5882-b9b2-ba8e1ad1c432" :answer/type {:db/ident :answer.type/math} :answer/value "2-3z" :db/id #edb/ref 17592186632473} :answer-field/id #uuid "8b8c93d5-4aa0-5aa8-8854-3c4446fcbfee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632607}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c832111-7e26-5f06-bbf5-0fe500587e8b" :question/math-academy-id "q-69648" :question/problem "$$\n\\displaystyle \\begin{vmatrix}\\sqrt{2} & z \\\\ 3 & \\sqrt{2}\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{2} & 3 \\\\ z & \\sqrt{2}\\end{vmatrix} & =\\sqrt{2}\\cdot \\sqrt{2}-z\\cdot 3 \\\\  & =2-3z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632688 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a492949-3bd3-5139-a09e-bd9913dab194" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186632169} {:answer/id #uuid "60936ee6-077a-5769-8dc2-3c8fefce1f0d" :answer/type {:db/ident :answer.type/math} :answer/value "x=-5" :db/id #edb/ref 17592186632286} {:answer/id #uuid "8ef20736-29c1-50f0-84a6-1558444988de" :answer/type {:db/ident :answer.type/math} :answer/value "x=6" :db/id #edb/ref 17592186632364} {:answer/id #uuid "ca1c6019-99d5-5cac-a1f8-9077432f3728" :answer/type {:db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186632446} {:answer/id #uuid "f70a2a78-ceac-54fe-b05a-31a8e59bf980" :answer/type {:db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186632529}] :answer-field/correct {:answer/id #uuid "ca1c6019-99d5-5cac-a1f8-9077432f3728" :answer/type {:db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186632446} :answer-field/id #uuid "10a75dfb-dbb7-5551-954d-06078da5405d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186632550}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67bf1af6-08b7-5d3a-b028-0c31c332e000" :question/math-academy-id "q-11647" :question/problem "If\n$$\n\\displaystyle B=\\begin{bmatrix}2 & x \\\\ 2 & 6\\end{bmatrix}\n$$\nand\n$\\text{det}(B)=2$, what is the value of $x?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(B) & =\\begin{vmatrix}2 & x \\\\ 2 & 6\\end{vmatrix} \\\\  & =2\\cdot 6-x\\cdot 2 \\\\  & =12-2x.\\end{aligned}\n$$\n\n \n\nSince $det(B)=2$, we get:\n\n$$\n\\begin{aligned}det(B) & =2 \\\\ 12-2x & =2 \\\\ -2x & =2-12 \\\\ -2x & =-10 \\\\ x & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186632702 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37d076a4-6367-5487-9f22-ea5c34784e3a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186632215}] :answer-field/correct {:answer/id #uuid "37d076a4-6367-5487-9f22-ea5c34784e3a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186632215} :answer-field/id #uuid "c2f8f65c-9492-5e44-a731-352186ac01a7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186632623}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "948a413c-4dce-57f7-8b58-de4a73761168" :question/math-academy-id "q-275599" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+t & 4t \\\\ -3 & 3-t\\end{bmatrix}\n$$\nand $det(A)=45,$ what is the value of $t?$\n\n$t=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+t & 4t \\\\ -3 & 3-t\\end{vmatrix} \\\\  & =(3+t)(3-t)-4t(-3) \\\\  & =9-{t}^{2}+12t \\\\  & =-{t}^{2}+12t+9.\\end{aligned}\n$$\n\nSince $det(A)=45$, we obtain\n\n$$\n\\begin{aligned}det(A) & =45 \\\\ -{t}^{2}+12t+9 & =45 \\\\ -{t}^{2}+12t-36 & =0 \\\\ {t}^{2}-12t+36 & =0 \\\\ (t-6)^{2} & =0 \\\\ t & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637666 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ffb014-a19e-5186-88f1-ecaf37893ba5" :answer/type {:db/ident :answer.type/math} :answer/value "51" :db/id #edb/ref 17592186637663} {:answer/id #uuid "648ce248-63f0-5833-ae5a-478a0e07fda8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/i