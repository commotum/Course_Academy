th} :answer/value "-8" :db/id #edb/ref 17592186637680} :answer-field/id #uuid "329b94c1-1a26-5ab0-bb5c-9a9653b1dee7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186637668}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3d689d20-2d7f-5cf6-a734-7021d15cd1a4" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}9 & 2 \\\\ 4 & 0\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}9 & 2 \\\\ 4 & 0\\end{vmatrix} & =9\\cdot 0-2\\cdot 4 \\\\  & =0-8 \\\\  & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637682 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387b3e94-0bd5-5035-8182-20219196f3d3" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186637669} {:answer/id #uuid "39c867aa-b4ab-5ff2-b3b1-fc92bbba611e" :answer/type {:db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186637670} {:answer/id #uuid "3e80d07d-fb89-53af-add5-e737e487017c" :answer/type {:db/ident :answer.type/math} :answer/value "-63" :db/id #edb/ref 17592186637672} {:answer/id #uuid "ce3d33cb-9292-5031-8dc9-fc8ef152a2bb" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186637685} {:answer/id #uuid "d6ba0c04-20d7-5cd0-a238-163b99f4557d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637688}] :answer-field/correct {:answer/id #uuid "387b3e94-0bd5-5035-8182-20219196f3d3" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186637669} :answer-field/id #uuid "142e7bbc-988f-5a9a-a690-a72993edd34d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637665}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f6cc57d-53af-5dcc-86a6-8248d3858078" :question/problem "Calculate $\\text{det}(M)$, if\n$$\n\\displaystyle M=\\begin{bmatrix}1 & 6 \\\\ -2 & 2\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(M) & =\\begin{vmatrix}1 & 6 \\\\ -2 & 2\\end{vmatrix} \\\\  & =1\\cdot 2-6\\cdot (-2) \\\\  & =2-(-12) \\\\  & =14\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637686 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6405c50c-ff58-5a00-bcee-240630cdf904" :answer/type {:db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186637674} {:answer/id #uuid "6a5bbfe0-589a-5f35-a568-bbc754c53a0f" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186637678} {:answer/id #uuid "810fb912-9044-5f96-a6cc-135ce7b6e4d6" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186637679} {:answer/id #uuid "d681fed6-c792-5907-ba3d-2ff6e1966f03" :answer/type {:db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186637687} {:answer/id #uuid "de48e019-0135-5d02-8cf9-3f6e3744f22a" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186637692}] :answer-field/correct {:answer/id #uuid "de48e019-0135-5d02-8cf9-3f6e3744f22a" :answer/type {:db/ident :answer.type/math} :answer/value "56" :db/id #edb/ref 17592186637692} :answer-field/id #uuid "084669d9-78f1-50e8-bacc-4b9a41f1bca0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637664}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d59ae0d7-588c-5848-ab89-a73aadfb2aa7" :question/problem "$$\n\\displaystyle \\begin{vmatrix}7 & 0 \\\\ 5 & 8\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & 0 \\\\ 5 & 8\\end{vmatrix} & =7\\cdot 8-0\\cdot 5 \\\\  & =56-0 \\\\  & =56\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186637691 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b60fe57-3565-5ef0-9f8b-a26c1b2b37ab" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186637667} {:answer/id #uuid "4a0b2e54-b519-51b4-8bdd-53121e73853e" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186637673} {:answer/id #uuid "8fe86f0d-7d4c-5dbe-9e94-707bebaa665c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637681} {:answer/id #uuid "b0239739-5d44-588f-ae6e-54f5c57c830d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186637683} {:answer/id #uuid "b3296a8f-8c5a-5df4-b2b5-5eae55d7b6c2" :answer/type {:db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186637684}] :answer-field/correct {:answer/id #uuid "8fe86f0d-7d4c-5dbe-9e94-707bebaa665c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186637681} :answer-field/id #uuid "64f1bbf2-8a8e-5963-82db-2c55b3372417" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186637676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dcba43ae-7666-52b0-997b-a7c6ac084ccc" :question/problem "Calculate $\\text{det}(X)$, if\n$$\n\\displaystyle X=\\begin{bmatrix}6 & 2 \\\\ 9 & 3\\end{bmatrix}.\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(X) & =\\begin{vmatrix}6 & 2 \\\\ 9 & 3\\end{vmatrix} \\\\  & =6\\cdot 3-2\\cdot 9 \\\\  & =18-18 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639317 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "005c827f-689c-5cf3-90d1-109920cf0783" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186639312} {:answer/id #uuid "38a18f0f-2317-594f-8efd-6328ee622609" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186639316} {:answer/id #uuid "6d2fbe70-79ba-5ce8-95da-6fd6fd50af02" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186639321} {:answer/id #uuid "e20fe210-3854-5d24-ac3a-84c2f2dfe577" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186639334} {:answer/id #uuid "f300bc55-7ee3-5229-80ae-2b9eefd1c42e" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186639337}] :answer-field/correct {:answer/id #uuid "f300bc55-7ee3-5229-80ae-2b9eefd1c42e" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186639337} :answer-field/id #uuid "71dbc4a4-c2ab-51eb-a362-49f13ff7f22c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4059a0e6-5992-5028-8c36-2765a1d37a20" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-3v & -7 \\\\ 8 & -3\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=-16$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-3v & -7 \\\\ 8 & -3\\end{vmatrix} \\\\  & =(-3v)\\cdot (-3)-(-7)\\cdot 8 \\\\  & =9v+56\\end{aligned}\n$$\n\nSince $det(U)=-16$, we get:\n\n$$\n\\begin{aligned}det(U) & =-16 \\\\ 9v+56 & =-16 \\\\ 9v & =-16-56 \\\\ 9v & =-72 \\\\ v & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639318 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fa9f658-ec24-5921-9904-29629964f774" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186639314}] :answer-field/correct {:answer/id #uuid "0fa9f658-ec24-5921-9904-29629964f774" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186639314} :answer-field/id #uuid "bcd5acb9-fb09-5626-954d-96b09cf7d0cf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639332}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46a646ff-1f4c-5382-ae10-f7d28464d45e" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-6-8r & 2-6r \\\\ 5 & 7\\end{bmatrix}\n$$\nand $det(U)=182$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =\\begin{vmatrix}-6-8r & 2-6r \\\\ 5 & 7\\end{vmatrix} \\\\  & =(-6-8r)\\cdot 7-(2-6r)\\cdot 5 \\\\  & =-42-56r-10+30r \\\\  & =-52-26r.\\end{aligned}\n$$\n\nSince $det(U)=182,$ we get\n\n$$\n\\begin{aligned}det(U) & =182 \\\\ -52-26r & =182 \\\\ -26r & =234 \\\\ r & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639325 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bdfc11ec-373d-57de-b54c-04933ee37f0b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186639333}] :answer-field/correct {:answer/id #uuid "bdfc11ec-373d-57de-b54c-04933ee37f0b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186639333} :answer-field/id #uuid "6f65a0f8-1d0b-5f58-868d-246b5e15dc18" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639322}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cea3e82-e2a1-50e4-a3dc-49d532c82f4a" :question/problem "If\n$$\n\\displaystyle C=\\begin{bmatrix}-2 & k \\\\ -8 & -4\\end{bmatrix}\n$$\nand\n$\\text{det}(C)=16,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}-2 & k \\\\ -8 & -4\\end{vmatrix} \\\\  & =(-2)\\cdot (-4)-k\\cdot (-8) \\\\  & =8+8k.\\end{aligned}\n$$\n\nSince $det(C)=16$, we get\n\n$$\n\\begin{aligned}det(C) & =16 \\\\ 8+8k & =16 \\\\ 8k & =16-8 \\\\ 8k & =8 \\\\ k & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639327 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18c1b194-4820-510f-8ae8-e434621b24c0" :answer/type {:db/ident :answer.type/math} :answer/value "k=-6" :db/id #edb/ref 17592186639315} {:answer/id #uuid "5f67fc68-3c45-5065-b1b1-022c24d47fd1" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186639319} {:answer/id #uuid "745bb945-f72e-581f-893e-68e5c56a6be3" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186639324} {:answer/id #uuid "ad1dc6a7-b788-5237-b036-89ce79c15958" :answer/type {:db/ident :answer.type/math} :answer/value "k=3" :db/id #edb/ref 17592186639330} {:answer/id #uuid "edfb9e4d-bf50-5404-9e1c-250542e45730" :answer/type {:db/ident :answer.type/math} :answer/value "k=7" :db/id #edb/ref 17592186639335}] :answer-field/correct {:answer/id #uuid "5f67fc68-3c45-5065-b1b1-022c24d47fd1" :answer/type {:db/ident :answer.type/math} :answer/value "k=0" :db/id #edb/ref 17592186639319} :answer-field/id #uuid "83fd7816-cba8-5cfd-8cf1-72ff3b96cac5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639326}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "898c44e6-caae-5b89-a738-909dbdb2bd54" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-3 & -6 \\\\ -4k & 8k+2\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=-6$, what is the value of $k?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-3 & -6 \\\\ -4k & 8k+2\\end{vmatrix} \\\\  & =(-3)\\cdot (8k+2)-(-6)\\cdot (-4k) \\\\  & =-48k-6\\end{aligned}\n$$\n\nSince $det(U)=-6$, we get:\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ -48k-6 & =-6 \\\\ -48k & =-6-(-6) \\\\ -48k & =0 \\\\ k & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639331 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fccc5f-e11c-5381-8753-653378414177" :answer/type {:db/ident :answer.type/math} :answer/value "k=-8" :db/id #edb/ref 17592186639313} {:answer/id #uuid "9f1a8e26-30e7-57f7-bb98-09c47d21b898" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186639328} {:answer/id #uuid "a35ccc33-9c87-5d21-a82f-2f69c0c8c3ed" :answer/type {:db/ident :answer.type/math} :answer/value "k=2" :db/id #edb/ref 17592186639329} {:answer/id #uuid "f252b6de-fe64-5742-af1a-4b99b72662a2" :answer/type {:db/ident :answer.type/math} :answer/value "k=-5" :db/id #edb/ref 17592186639336} {:answer/id #uuid "ff5daba2-9c57-556e-ab55-dad610664e28" :answer/type {:db/ident :answer.type/math} :answer/value "k=-4" :db/id #edb/ref 17592186639338}] :answer-field/correct {:answer/id #uuid "9f1a8e26-30e7-57f7-bb98-09c47d21b898" :answer/type {:db/ident :answer.type/math} :answer/value "k=-7" :db/id #edb/ref 17592186639328} :answer-field/id #uuid "684879ec-f444-5c04-9846-f23446b2ed95" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639320}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b6541fe9-b31d-5be5-b2a6-4679896c9955" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}8 & 7 \\\\ 7k & 7k-5\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=-89$, what is the value of $k?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}8 & 7 \\\\ 7k & 7k-5\\end{vmatrix} \\\\  & =8\\cdot (7k-5)-7\\cdot 7k \\\\  & =7k-40\\end{aligned}\n$$\n\nSince $det(U)=-89$, we get:\n\n$$\n\\begin{aligned}det(U) & =-89 \\\\ 7k-40 & =-89 \\\\ 7k & =-89-(-40) \\\\ 7k & =-49 \\\\ k & =-7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639340 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ac242bf-5d6d-5022-8c1a-0f4b4b677710" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{21}" :db/id #edb/ref 17592186639344}] :answer-field/correct {:answer/id #uuid "3ac242bf-5d6d-5022-8c1a-0f4b4b677710" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{21}" :db/id #edb/ref 17592186639344} :answer-field/id #uuid "593e88c7-6bfd-51c4-b1f7-1d0dc66cc1d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639346}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "09aafcf5-eb62-5760-9810-48a471fed2b8" :question/problem "Calculate $det(D)$ given that\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$D=\\begin{bmatrix}\\frac{1}{3} & -6 \\\\ -\\frac{2}{7} & 7\\end{bmatrix}$</div>\n</div>\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}\\frac{1}{3} & -6 \\\\ -\\frac{2}{7} & 7\\end{vmatrix} \\\\  & =\\frac{1}{3}\\cdot 7-(-6)\\cdot \\left(-\\frac{2}{7}\\right) \\\\  & =\\frac{7}{3}-\\frac{12}{7} \\\\  & =\\frac{13}{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639341 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f34cf5a8-5c27-538c-a35a-75a99adfc884" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186639365}] :answer-field/correct {:answer/id #uuid "f34cf5a8-5c27-538c-a35a-75a99adfc884" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186639365} :answer-field/id #uuid "b77d1437-56f5-5899-ab7e-1ee68b9a6755" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639359}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0b11b093-daa3-57d3-b97c-9296f81e0d47" :question/problem "Calculate $det(E)$ given that\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$E=\\begin{bmatrix}-\\frac{2}{3} & 2 \\\\ 2 & -5\\end{bmatrix}$</div>\n</div>\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =\\begin{vmatrix}-\\frac{2}{3} & 2 \\\\ 2 & -5\\end{vmatrix} \\\\  & =-\\frac{2}{3}\\cdot (-5)-2\\cdot 2 \\\\  & =\\frac{10}{3}-4 \\\\  & =-\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639345 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2188fe79-a76a-51b4-ad37-c3d2a5c4a7ff" :answer/type {:db/ident :answer.type/math} :answer/value "-8xy" :db/id #edb/ref 17592186639342} {:answer/id #uuid "5c7b2e02-c757-5875-aa23-1697b15d931b" :answer/type {:db/ident :answer.type/math} :answer/value "-30xy" :db/id #edb/ref 17592186639349} {:answer/id #uuid "d1fb2756-e8be-5132-a59f-3f60523a8d02" :answer/type {:db/ident :answer.type/math} :answer/value "2xy" :db/id #edb/ref 17592186639360} {:answer/id #uuid "df865b60-c71e-5515-bd50-2d65fa633e6a" :answer/type {:db/ident :answer.type/math} :answer/value "-5xy" :db/id #edb/ref 17592186639362} {:answer/id #uuid "ed75fc99-2d19-5567-ac93-ac5575c22004" :answer/type {:db/ident :answer.type/math} :answer/value "-xy" :db/id #edb/ref 17592186639364}] :answer-field/correct {:answer/id #uuid "5c7b2e02-c757-5875-aa23-1697b15d931b" :answer/type {:db/ident :answer.type/math} :answer/value "-30xy" :db/id #edb/ref 17592186639349} :answer-field/id #uuid "916192da-1d51-5b17-9106-60cbe61a2011" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639356}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d439578-50a4-5d2b-9801-d8534fc7ff1a" :question/problem "Calculate $det(C)$, if\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$C=\\begin{bmatrix}-4x & -4y \\\\ \\frac{x}{2} & 8y\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}-4x & -4y \\\\ \\frac{x}{2} & 8y\\end{vmatrix} \\\\  & =-4x\\cdot 8y-(-4y)\\cdot \\frac{x}{2} \\\\  & =-32xy+2xy \\\\  & =-30xy\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639354 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f81b72f-2573-5079-8cdd-51d22f2f3a82" :answer/type {:db/ident :answer.type/math} :answer/value "14\\left(ru-st\\right)" :db/id #edb/ref 17592186639343} {:answer/id #uuid "5e553e6f-6776-5f41-b35c-8578fc3d06b2" :answer/type {:db/ident :answer.type/math} :answer/value "56\\left(ru-st\\right)" :db/id #edb/ref 17592186639350} {:answer/id #uuid "642d93ec-f95b-5ee8-b562-8ccfb43303cd" :answer/type {:db/ident :answer.type/math} :answer/value "36\\left(ru-st\\right)" :db/id #edb/ref 17592186639351} {:answer/id #uuid "8a19ec22-03f9-5cc9-b73e-30d0229d763f" :answer/type {:db/ident :answer.type/math} :answer/value "24\\left(ru-st\\right)" :db/id #edb/ref 17592186639352} {:answer/id #uuid "8b0a836b-18cc-528e-92d0-ba6fa184f7e6" :answer/type {:db/ident :answer.type/math} :answer/value "16\\left(ru-st\\right)" :db/id #edb/ref 17592186639353}] :answer-field/correct {:answer/id #uuid "2f81b72f-2573-5079-8cdd-51d22f2f3a82" :answer/type {:db/ident :answer.type/math} :answer/value "14\\left(ru-st\\right)" :db/id #edb/ref 17592186639343} :answer-field/id #uuid "b2b47578-eae9-5ed8-80e2-64b3347f1e70" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8dd46ce8-8808-5254-800a-0f54bc7488d1" :question/problem "Calculate $det(H)$, if\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$H=\\begin{bmatrix}-2t & 7u \\\\ -2r & 7s\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(H) & =\\begin{vmatrix}-2t & 7u \\\\ -2r & 7s\\end{vmatrix} \\\\  & =-2t\\cdot 7s-7u\\cdot (-2r) \\\\  & =-14st-(-14ru) \\\\  & =14\\left(ru-st\\right)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639363 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aec8442-7467-5873-869f-258878a5f0f4" :answer/type {:db/ident :answer.type/math} :answer/value "2y\\left(2{x}^{2}+1\\right)" :db/id #edb/ref 17592186639348} {:answer/id #uuid "90e99275-eb15-5e67-876d-c833a04e4b06" :answer/type {:db/ident :answer.type/math} :answer/value "3y\\left({x}^{2}+1\\right)" :db/id #edb/ref 17592186639355} {:answer/id #uuid "92a6ccc2-8a72-5c43-8ae5-1e6872fe7af4" :answer/type {:db/ident :answer.type/math} :answer/value "2y\\left(3{x}^{2}+1\\right)" :db/id #edb/ref 17592186639357} {:answer/id #uuid "de05e50f-2675-533c-af0e-4506a45a6196" :answer/type {:db/ident :answer.type/math} :answer/value "2y\\left({x}^{2}+1\\right)" :db/id #edb/ref 17592186639361} {:answer/id #uuid "f909bad3-77e9-5a47-808f-879f1af3d391" :answer/type {:db/ident :answer.type/math} :answer/value "y\\left(5{x}^{2}+3\\right)" :db/id #edb/ref 17592186639366}] :answer-field/correct {:answer/id #uuid "92a6ccc2-8a72-5c43-8ae5-1e6872fe7af4" :answer/type {:db/ident :answer.type/math} :answer/value "2y\\left(3{x}^{2}+1\\right)" :db/id #edb/ref 17592186639357} :answer-field/id #uuid "59e3410a-713f-55ee-b30b-7118f6dc5508" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186639347}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dfd803bb-3dbf-5b74-af0b-2b5faef6ba6a" :question/problem "Calculate $det(D)$, if\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$D=\\begin{bmatrix}6x & -2 \\\\ y & xy\\end{bmatrix}$</div>\n</div>" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}6x & -2 \\\\ y & xy\\end{vmatrix} \\\\  & =6x\\cdot xy-(-2\\cdot y) \\\\  & =6{x}^{2}y-(-2y) \\\\  & =2y\\left(3{x}^{2}+1\\right)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639371 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0737dd86-7ea8-5edd-a7f6-9089c06e979b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186639368}] :answer-field/correct {:answer/id #uuid "0737dd86-7ea8-5edd-a7f6-9089c06e979b" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186639368} :answer-field/id #uuid "fdec6006-e422-576a-a0f7-8f139bc986c1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639379}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38c47915-6f68-5518-b913-de4c53318abb" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}-5+p & -2p-{p}^{2} \\\\ 1 & -4-p\\end{bmatrix}\n$$\nand $det(A)=38,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}-5+p & -2p-{p}^{2} \\\\ 1 & -4-p\\end{vmatrix} \\\\  & =(-5+p)(-4-p)-(-2p-{p}^{2})\\cdot 1 \\\\  & =20+5p-4p-{p}^{2}+2p+{p}^{2} \\\\  & =20+3p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =20+3p.\\end{aligned}\n$$\n\nFinally, since $det(A)=38$, we obtain\n\n$$\n\\begin{aligned}det(A) & =38 \\\\ 20+3p & =38 \\\\ 3p & =18 \\\\ p & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639375 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e8e32f0-f403-5921-a466-7f3d75d9c7bd" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186639369}] :answer-field/correct {:answer/id #uuid "2e8e32f0-f403-5921-a466-7f3d75d9c7bd" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186639369} :answer-field/id #uuid "83f455e3-cdd3-5426-bed7-c84613564549" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639376}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6e463122-efbb-5d02-95c5-fd1427b3ebb1" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}7+p & -6p-{p}^{2} \\\\ 1 & 2-p\\end{bmatrix}\n$$\nand $det(A)=23,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}7+p & -6p-{p}^{2} \\\\ 1 & 2-p\\end{vmatrix} \\\\  & =(7+p)(2-p)-(-6p-{p}^{2})\\cdot 1 \\\\  & =14-7p+2p-{p}^{2}+6p+{p}^{2} \\\\  & =14+p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =14+p.\\end{aligned}\n$$\n\nFinally, since $det(A)=23$, we obtain\n\n$$\n\\begin{aligned}det(A) & =23 \\\\ 14+p & =23 \\\\ p & =9 \\\\ p & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639377 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b918bc3-43cb-545f-b25b-277f6bf89403" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186639374}] :answer-field/correct {:answer/id #uuid "6b918bc3-43cb-545f-b25b-277f6bf89403" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186639374} :answer-field/id #uuid "327a7a0c-7023-5434-a7ce-ce3828aff719" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639370}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9333705c-58cc-567e-9660-11375155a969" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}4+p & 7p-{p}^{2} \\\\ 1 & -5-p\\end{bmatrix}\n$$\nand $det(A)=-180,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}4+p & 7p-{p}^{2} \\\\ 1 & -5-p\\end{vmatrix} \\\\  & =(4+p)(-5-p)-(7p-{p}^{2})\\cdot 1 \\\\  & =-20-4p-5p-{p}^{2}-7p+{p}^{2} \\\\  & =-20-16p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =-20-16p.\\end{aligned}\n$$\n\nFinally, since $det(A)=-180$, we obtain\n\n$$\n\\begin{aligned}det(A) & =-180 \\\\ -20-16p & =-180 \\\\ -16p & =-160 \\\\ p & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186639378 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64ad9141-f944-5052-ab08-7fd552b10459" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186639373}] :answer-field/correct {:answer/id #uuid "64ad9141-f944-5052-ab08-7fd552b10459" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186639373} :answer-field/id #uuid "63a925aa-d3fd-5dbc-95d4-49984cdf96ba" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186639372}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9de463d3-005b-5c57-8e51-9f4d98e4461a" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+p & 8p-{p}^{2} \\\\ 1 & 4-p\\end{bmatrix}\n$$\nand $det(A)=82,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+p & 8p-{p}^{2} \\\\ 1 & 4-p\\end{vmatrix} \\\\  & =(3+p)(4-p)-(8p-{p}^{2})\\cdot 1 \\\\  & =12-3p+4p-{p}^{2}-8p+{p}^{2} \\\\  & =12-7p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =12-7p.\\end{aligned}\n$$\n\nFinally, since $det(A)=82$, we obtain\n\n$$\n\\begin{aligned}det(A) & =82 \\\\ 12-7p & =82 \\\\ -7p & =70 \\\\ p & =-10.\\end{aligned}\n$$"}]}
