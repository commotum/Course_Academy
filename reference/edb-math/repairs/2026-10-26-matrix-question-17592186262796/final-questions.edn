x} \\\\  & =(r-3)\\cdot r-r\\cdot 3 \\\\  & ={r}^{2}-6r\\end{aligned}\n$$\n\nSince $det(P)=-9$, we obtain:\n\n$$\n\\begin{aligned}det(P) & =-9 \\\\ {r}^{2}-6r & =-9 \\\\ {r}^{2}-6r+9 & =0 \\\\ (r-3)^{2} & =0 \\\\ r & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262806 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d8c86ed-6d17-58e5-80b8-58959792fbea" :answer/type {:db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186260000} {:answer/id #uuid "5da2ff79-d5ff-5f94-843d-fd01485931c3" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{2}{5}" :db/id #edb/ref 17592186260680} {:answer/id #uuid "63782cc1-1e3c-5b15-9b88-3f08b70112ea" :answer/type {:db/ident :answer.type/math} :answer/value "p=\\frac{1}{3}" :db/id #edb/ref 17592186260732} {:answer/id #uuid "7a8b63ad-24d0-5034-a4cd-e73692e2757c" :answer/type {:db/ident :answer.type/math} :answer/value "p=3" :db/id #edb/ref 17592186260943} {:answer/id #uuid "c7f4b75b-8f4c-53c9-98ea-95862842547a" :answer/type {:db/ident :answer.type/math} :answer/value "p=-5" :db/id #edb/ref 17592186261645}] :answer-field/correct {:answer/id #uuid "0d8c86ed-6d17-58e5-80b8-58959792fbea" :answer/type {:db/ident :answer.type/math} :answer/value "p=1" :db/id #edb/ref 17592186260000} :answer-field/id #uuid "4e8c9907-19d6-5803-bfec-b352898f4520" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262266}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4e03a4dd-5246-5c91-8e03-9d7ad64d917d" :question/math-academy-id "q-127608" :question/problem "If\n$$\n\\displaystyle B=\\begin{bmatrix}5-p & p \\\\ 3 & p\\end{bmatrix}\n$$\nand $det(B)=1$, what is the value of $p?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(B) & =\\begin{vmatrix}5-p & p \\\\ 3 & p\\end{vmatrix} \\\\  & =(5-p)\\cdot p-p\\cdot 3 \\\\  & =-{p}^{2}+2p\\end{aligned}\n$$\n\nSince $det(B)=1$, we obtain:\n\n$$\n\\begin{aligned}det(B) & =1 \\\\ -{p}^{2}+2p & =1 \\\\ -{p}^{2}+2p-1 & =0 \\\\ {p}^{2}-2p+1 & =0 \\\\ (p-1)^{2} & =0 \\\\ p & =1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262807 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a37c432-ec3a-54fa-a265-be8a73e5b042" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186260101} {:answer/id #uuid "570d06e5-402c-5a48-aa29-06ffa92a5243" :answer/type {:db/ident :answer.type/math} :answer/value "y=18" :db/id #edb/ref 17592186260619} {:answer/id #uuid "76d5eb3b-a067-51ff-b76b-ba5ac4fdd83a" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186260912} {:answer/id #uuid "bd179fed-e737-5b98-9f59-7194e6703cb3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{9}{2}" :db/id #edb/ref 17592186261544} {:answer/id #uuid "d688ed58-3493-5fc2-84fe-15f1d55d1e83" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{18}{2}" :db/id #edb/ref 17592186261762}] :answer-field/correct {:answer/id #uuid "1a37c432-ec3a-54fa-a265-be8a73e5b042" :answer/type {:db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186260101} :answer-field/id #uuid "a12a44ba-4364-5ba9-9b64-63befc571bbb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262414}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41f9cebe-1261-5298-9d1d-10bd7138212b" :question/math-academy-id "q-127609" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3y & y \\\\ 3 & y-5\\end{bmatrix}\n$$\nand $det(A)=-27$, what is the value of $y?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3y & y \\\\ 3 & y-5\\end{vmatrix} \\\\  & =3y\\cdot (y-5)-y\\cdot 3 \\\\  & =3{y}^{2}-18y\\end{aligned}\n$$\n\nSince $det(A)=-27$, we obtain:\n\n$$\n\\begin{aligned}det(A) & =-27 \\\\ 3{y}^{2}-18y & =-27 \\\\ 3{y}^{2}-18y+27 & =0 \\\\ {y}^{2}-6y+9 & =0 \\\\ (y-3)^{2} & =0 \\\\ y & =3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292870 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231}] :answer-field/correct {:answer/id #uuid "8c1e3733-5463-5a73-87fe-9bad262f9b95" :answer/type {:db/ident :answer.type/math} :answer/value "3-2y" :db/id #edb/ref 17592186291231} :answer-field/id #uuid "60cd938e-fe0c-506b-935f-e549ff5c73c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292029}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d53568b9-73ac-5ba0-8169-82ca6f9fc7df" :question/math-academy-id "q-275595" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{vmatrix}=\n$$\n {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{3} & y \\\\ 2 & \\sqrt{3}\\end{vmatrix} & =\\sqrt{3}\\cdot \\sqrt{3}-y\\cdot 2 \\\\  & =3-2y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292872 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291058}] :answer-field/correct {:answer/id #uuid "637424aa-e375-5ca5-bc92-9b93538da967" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186291058} :answer-field/id #uuid "5deef2d0-b2e7-54ab-a3df-7734195f5705" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292019}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d712990-6aa9-538b-af72-704fc59cbac8" :question/math-academy-id "q-275598" :question/problem "If\n$$\n\\displaystyle C=\\begin{bmatrix}1 & k \\\\ 4 & 6\\end{bmatrix}\n$$\nand\n$\\text{det}(C)=-14,$ determine the value of $k.$\n\n$k=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(C) & =\\begin{vmatrix}1 & k \\\\ 4 & 6\\end{vmatrix} \\\\  & =1\\cdot 6-k\\cdot 4 \\\\  & =6-4k.\\end{aligned}\n$$\n\nSince $det(C)=-14$, we get\n\n$$\n\\begin{aligned}det(C) & =-14 \\\\ 6-4k & =-14 \\\\ -4k & =-14-6 \\\\ -4k & =-20 \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292873 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291266}] :answer-field/correct {:answer/id #uuid "93399e4d-4d85-580e-9e08-c041fa5d5800" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186291266} :answer-field/id #uuid "339de4a9-ce7b-517d-9496-4255c739b1c2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291908}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d673c24b-03d4-55e8-a5fb-605bc1d6c21f" :question/math-academy-id "q-275601" :question/problem "If\n$$\n\\displaystyle A=\\begin{bmatrix}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{bmatrix}\n$$\nand $det(A)=7,$ what is the value of $p?$\n\n$p=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}3+p & 4p-{p}^{2} \\\\ 1 & 5-p\\end{vmatrix} \\\\  & =(3+p)(5-p)-(4p-{p}^{2})\\cdot 1 \\\\  & =15-3p+5p-{p}^{2}-4p+{p}^{2} \\\\  & =15-2p-\\cancel{{p}^{2}}+\\cancel{{p}^{2}} \\\\  & =15-2p.\\end{aligned}\n$$\n\nFinally, since $det(A)=7$, we obtain\n\n$$\n\\begin{aligned}det(A) & =7 \\\\ 15-2p & =7 \\\\ -2p & =-8 \\\\ p & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299591 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ce25fc2-f172-5796-bdb4-80f062501242" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186298240}] :answer-field/correct {:answer/id #uuid "9ce25fc2-f172-5796-bdb4-80f062501242" :answer/type {:db/ident :answer.type/math} :answer/value "47" :db/id #edb/ref 17592186298240} :answer-field/id #uuid "42ec026c-9601-596a-aac7-34e1c7298d90" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298866}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52b70b4e-c944-5a6c-9fb5-10e8bb1b8364" :question/math-academy-id "q-317335" :question/problem "Calculate $det(R)$ given that\n$$\n\\displaystyle R=\\begin{bmatrix}8 & -5 \\\\ 3 & 4\\end{bmatrix}.\n$$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =\\begin{vmatrix}8 & -5 \\\\ 3 & 4\\end{vmatrix} \\\\  & =(8)(4)-(-5)(3) \\\\  & =32+15 \\\\  & =47.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299592 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56075e41-2276-59fc-aa32-dc0aefbc46ea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297914}] :answer-field/correct {:answer/id #uuid "56075e41-2276-59fc-aa32-dc0aefbc46ea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297914} :answer-field/id #uuid "9dd2ce63-3870-5dc7-88b5-af30fb44581f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "51e6ce71-0f6b-5ca6-9047-0832d38b3af3" :question/math-academy-id "q-317336" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}2 & 4 \\\\ 1 & 3\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}2 & 4 \\\\ 1 & 3\\end{vmatrix} \\\\  & =(2)(3)-(4)(1) \\\\  & =6-4 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299593 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6324678-0597-5421-a104-04c3342494f7" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186298419}] :answer-field/correct {:answer/id #uuid "c6324678-0597-5421-a104-04c3342494f7" :answer/type {:db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186298419} :answer-field/id #uuid "cfc4e21a-193b-52dd-8dc9-d21c2d8f7ddb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd3c7419-67b1-5120-a5e4-6bd19d8d0a71" :question/math-academy-id "q-317342" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}6 & -2 \\\\ 5 & 7\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}6 & -2 \\\\ 5 & 7\\end{vmatrix} \\\\  & =(6)(7)-(-2)(5) \\\\  & =42+10 \\\\  & =52.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299596 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616}] :answer-field/correct {:answer/id #uuid "0d4b2714-199b-59fe-a41f-f7e979f3f9ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186297616} :answer-field/id #uuid "0ac069ea-97f0-5b28-aae8-5ec01ea01538" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298670}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6ca014c-b5cb-5825-95b8-87e00a3142c6" :question/math-academy-id "q-317367" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}\\frac{2}{5} & -3 \\\\ -\\frac{1}{2} & 2\\end{vmatrix} \\\\  & =\\frac{2}{5}\\cdot 2-(-3)\\cdot \\left(-\\frac{1}{2}\\right) \\\\  & =\\frac{4}{5}-\\frac{3}{2} \\\\  & =-\\frac{7}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299597 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774}] :answer-field/correct {:answer/id #uuid "3706ac16-28a9-5ab4-9e33-623654c6773f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{37}{4}" :db/id #edb/ref 17592186297774} :answer-field/id #uuid "eab4d4b7-2252-5c08-b2b6-6e240fa0a5f2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299429}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a27ba74d-67e7-552a-808b-c86c1ab2858a" :question/math-academy-id "q-317368" :question/problem "Calculate $det(E)$ given that\n$$\n\\displaystyle E=\\begin{bmatrix}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{bmatrix}.\n$$\n\n$det(E)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(E) & =\\begin{vmatrix}-\\frac{3}{4} & 5 \\\\ 2 & -1\\end{vmatrix} \\\\  & =-\\frac{3}{4}\\cdot (-1)-5\\cdot 2 \\\\  & =\\frac{3}{4}-10 \\\\  & =-\\frac{37}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299598 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811}] :answer-field/correct {:answer/id #uuid "40a3d64e-42ef-5497-8784-49a7773dc05d" :answer/type {:db/ident :answer.type/math} :answer/value "3{x}^{2}+10y" :db/id #edb/ref 17592186297811} :answer-field/id #uuid "d3a33b9b-67e3-53e5-bc18-a48957e9fa7a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299357}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8c1aa-faf5-5b19-b22a-04f7e16807fe" :question/math-academy-id "q-317372" :question/problem "Calculate $det(D)$ given that\n$$\n\\displaystyle D=\\begin{bmatrix}3x & 2y \\\\ -5 & x\\end{bmatrix}.\n$$\n\n$det(D)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}3x & 2y \\\\ -5 & x\\end{vmatrix} \\\\  & =3x\\cdot x-2y\\cdot (-5) \\\\  & =3{x}^{2}+10y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299599 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787}] :answer-field/correct {:answer/id #uuid "3b9c6b6c-4e1d-5c3a-8a64-705c04043917" :answer/type {:db/ident :answer.type/math} :answer/value "6-4y" :db/id #edb/ref 17592186297787} :answer-field/id #uuid "5f79e083-14ad-5456-a436-b4ade461c1f1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298964}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9aa98f1a-30c2-558c-875f-c99582477892" :question/math-academy-id "q-317374" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}\\sqrt{6} & y \\\\ 4 & \\sqrt{6}\\end{vmatrix} & =\\sqrt{6}\\cdot \\sqrt{6}-y\\cdot 4 \\\\  & =6-4y.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299600 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479}] :answer-field/correct {:answer/id #uuid "d7fa1ff0-7dcd-55bd-a8fb-9db3d54aaf17" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298479} :answer-field/id #uuid "154b6de9-0d77-5e77-8de1-45bf6ab48913" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e3ffcd6-7f26-5f4f-8230-33ae44d7f744" :question/math-academy-id "q-317377" :question/problem "If\n$$\n\\displaystyle D=\\begin{bmatrix}2 & m \\\\ 3 & 5\\end{bmatrix}\n$$\nand\n$\\text{det}(D)=-11,$ determine the value of $m.$\n\n$m=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\text{det}(D) & =\\begin{vmatrix}2 & m \\\\ 3 & 5\\end{vmatrix} \\\\  & =2\\cdot 5-m\\cdot 3 \\\\  & =10-3m.\\end{aligned}\n$$\n\nSince $det(D)=-11,$ we get\n\n$$\n\\begin{aligned}det(D) & =-11 \\\\ 10-3m & =-11 \\\\ -3m & =-21 \\\\ m & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299601 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524}] :answer-field/correct {:answer/id #uuid "e2846b11-7ae8-5649-abfa-db38bcffb861" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186298524} :answer-field/id #uuid "ebf4f818-ea4f-5a3d-9526-388b53c60cf1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d0f61095-530a-54e2-bb79-353fa0efed39" :question/math-academy-id "q-317382" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}1+r & 2-r \\\\ -5 & 4\\end{bmatrix}\n$$\nand $det(U)=-6$, what is the value of $r?$\n\n$r=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(U) & =\\begin{vmatrix}1+r & 2-r \\\\ -5 & 4\\end{vmatrix} \\\\  & =(1+r)\\cdot 4-(2-r)\\cdot (-5) \\\\  & =4+4r+10-5r \\\\  & =14-r.\\end{aligned}\n$$\n\nSince $det(U)=-6,$ we get\n\n$$\n\\begin{aligned}det(U) & =-6 \\\\ 14-r & =-6 \\\\ -r & =-20 \\\\ r & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299602 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164}] :answer-field/correct {:answer/id #uuid "8cb2781e-f836-5ab8-a7a5-4a709b95dddb" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298164} :answer-field/id #uuid "0eda0fee-f95d-5630-8031-5abef3969057" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e22859c-f056-5995-96a3-08af912796b8" :question/math-academy-id "q-317385" :question/problem "If\n$$\n\\displaystyle S=\\begin{bmatrix}3+s & 2s \\\\ -4 & 3-s\\end{bmatrix}\n$$\nand $det(S)=25,$ what is the value of $s?$\n\n$s=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}3+s & 2s \\\\ -4 & 3-s\\end{vmatrix} \\\\  & =(3+s)(3-s)-2s(-4) \\\\  & =9-{s}^{2}+8s \\\\  & =-{s}^{2}+8s+9.\\end{aligned}\n$$\n\nSince $det(S)=25,$ we get\n\n$$\n\\begin{aligned}det(S) & =25 \\\\ -{s}^{2}+8s+9 & =25 \\\\ -{s}^{2}+8s-16 & =0 \\\\ {s}^{2}-8s+16 & =0 \\\\ (s-4)^{2} & =0 \\\\ s & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186335990 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0feb68bf-c01c-5e15-9300-ed8a2f76be21" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2y{z}^{2}" :db/id #edb/ref 17592186333131} {:answer/id #uuid "1b7eebe0-7cb3-5f9c-90c8-996ed14bd473" :answer/type {:db/ident :answer.type/math} :answer/value "3x-2{z}^{2}y" :db/id #edb/ref 17592186333241} {:answer/id #uuid "62b8bc2c-0ea0-54c2-81f8-ac2379203980" :answer/type {:db/ident :answer.type/math} :answer/value "-2x-3y{z}^{2}" :db/id #edb/ref 17592186333886} {:answer/id #uuid "d6426e90-34c6-5f45-884d-afd51e4b42c3" :answer/type {:db/ident :answer.type/math} :answer/value "-3x-2{y}^{2}