{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d3ba017-304d-5563-b51d-7e1f4f2d1a63" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186510596}] :answer-field/correct {:answer/id #uuid "4d3ba017-304d-5563-b51d-7e1f4f2d1a63" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186510596} :answer-field/id #uuid "a00250fb-51e3-5ea7-bb3a-d6728b1caebb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510609}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae33cd48-4286-533b-a46d-20551d42a300" :question/problem "Calculate $det(R)$ given that\n$$\n\\displaystyle R=\\begin{bmatrix}-8 & 14 \\\\ -7 & 13\\end{bmatrix}.\n$$\n\n$det(R)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(R) & =\\begin{vmatrix}-8 & 14 \\\\ -7 & 13\\end{vmatrix} \\\\  & =(-8)(13)-(14)(-7) \\\\  & =-104+98 \\\\  & =-6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510612 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7510b5f-6370-56f3-aaeb-ffce4ec766ff" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186510621}] :answer-field/correct {:answer/id #uuid "f7510b5f-6370-56f3-aaeb-ffce4ec766ff" :answer/type {:db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186510621} :answer-field/id #uuid "d775c716-9480-511e-b2f7-a5ea4fe55174" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510618}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b02768f5-2401-5388-9659-b87f57ee6732" :question/problem "Calculate $det(A)$ given that\n$$\n\\displaystyle A=\\begin{bmatrix}7 & -12 \\\\ 7 & -15\\end{bmatrix}.\n$$\n\n$det(A)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(A) & =\\begin{vmatrix}7 & -12 \\\\ 7 & -15\\end{vmatrix} \\\\  & =(7)(-15)-(-12)(7) \\\\  & =-105+84 \\\\  & =-21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510613 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de85e9f7-1fad-524b-bd8b-7104cec09347" :answer/type {:db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186510619}] :answer-field/correct {:answer/id #uuid "de85e9f7-1fad-524b-bd8b-7104cec09347" :answer/type {:db/ident :answer.type/math} :answer/value "-90" :db/id #edb/ref 17592186510619} :answer-field/id #uuid "0d20830b-2284-575f-9545-dae95ed220c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186510586}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1a64264-a586-541e-93d2-598674ef4459" :question/problem "Calculate $det(S)$ given that\n$$\n\\displaystyle S=\\begin{bmatrix}-9 & 1 \\\\ 9 & 9\\end{bmatrix}.\n$$\n\n$det(S)=$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}det(S) & =\\begin{vmatrix}-9 & 1 \\\\ 9 & 9\\end{vmatrix} \\\\  & =(-9)(9)-(1)(9) \\\\  & =-81-9 \\\\  & =-90.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510614 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f538a77-e08e-5555-add4-bafa899fb543" :answer/type {:db/ident :answer.type/math} :answer/value "-335" :db/id #edb/ref 17592186510589} {:answer/id #uuid "235a772b-5538-5b61-ada2-553ca7d2cfbb" :answer/type {:db/ident :answer.type/math} :answer/value "315" :db/id #edb/ref 17592186510590} {:answer/id #uuid "8b00f4b7-d970-56a3-806a-2fa066818eb3" :answer/type {:db/ident :answer.type/math} :answer/value "335" :db/id #edb/ref 17592186510605} {:answer/id #uuid "a2b8fa0b-e840-5468-a6e1-12b887ee6913" :answer/type {:db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186510610} {:answer/id #uuid "c928ad02-b344-5e24-a7d6-2cb2e76b8a64" :answer/type {:db/ident :answer.type/math} :answer/value "225" :db/id #edb/ref 17592186510616}] :answer-field/correct {:answer/id #uuid "8b00f4b7-d970-56a3-806a-2fa066818eb3" :answer/type {:db/ident :answer.type/math} :answer/value "335" :db/id #edb/ref 17592186510605} :answer-field/id #uuid "4ce62e8c-ff19-5b5a-a636-830fc7ba65dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510595}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b23310d1-b6de-5e56-8977-6813a00c8cb9" :question/problem "$$\n\\displaystyle \\begin{vmatrix}-15 & -11 \\\\ 10 & -15\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-15 & -11 \\\\ 10 & -15\\end{vmatrix} & =-15\\cdot (-15)-(-11)\\cdot 10 \\\\  & =225-(-110) \\\\  & =335\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186510617 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45482320-ca91-5c71-a92c-e0a8ce03cdb5" :answer/type {:db/ident :answer.type/math} :answer/value "156" :db/id #edb/ref 17592186510594} {:answer/id #uuid "680e2bfe-fb61-5d5e-8dcb-8e656b48c082" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186510601} {:answer/id #uuid "7d3723d1-3bbb-5378-bdf1-8adae692d227" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186510604} {:answer/id #uuid "c6097b50-9415-5938-9802-60334296d427" :answer/type {:db/ident :answer.type/math} :answer/value "288" :db/id #edb/ref 17592186510615} {:answer/id #uuid "f5822848-cd15-5ab7-809a-95aee17f1031" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186510620}] :answer-field/correct {:answer/id #uuid "f5822848-cd15-5ab7-809a-95aee17f1031" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186510620} :answer-field/id #uuid "61a929df-3a8c-52c0-bc0d-8ef7863835ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186510599}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c979d384-64a3-52ee-ad97-dd8b3f818ebf" :question/problem "$$\n\\displaystyle \\begin{vmatrix}-13 & 11 \\\\ 12 & -12\\end{vmatrix}=\n$$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\begin{vmatrix}-13 & 11 \\\\ 12 & -12\\end{vmatrix} & =-13\\cdot (-12)-11\\cdot 12 \\\\  & =156-132 \\\\  & =24\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592241 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ec04919-851c-5f1c-955b-e2ff97fdf5f3" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186591815} {:answer/id #uuid "179118cd-8436-5fb0-9d7f-dcce778b3766" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591825} {:answer/id #uuid "83672e87-80c5-5786-a4c9-02556e774a35" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186591969} {:answer/id #uuid "e4fef352-25c1-5611-b453-4c7c29fa7623" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186592108} {:answer/id #uuid "e6683a70-94fb-5b5c-9555-12c8a50c3815" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186592110}] :answer-field/correct {:answer/id #uuid "179118cd-8436-5fb0-9d7f-dcce778b3766" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186591825} :answer-field/id #uuid "0de6d142-7706-50b2-ae89-6ca03ca1279e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186592155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1de59b11-3c24-56b4-ab0a-82d3c06932c8" :question/math-academy-id "q-69658" :question/problem "If\n$$\n\\displaystyle U=\\begin{bmatrix}-v & 5 \\\\ 4 & 3\\end{bmatrix}\n$$\nand\n$\\text{det}(U)=4$, what is the value of $v?$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(U) & =\\begin{vmatrix}-v & 5 \\\\ 4 & 3\\end{vmatrix} \\\\  & =-v\\cdot 3-5\\cdot 4 \\\\  & =-3v-20\\end{aligned}\n$$\n\nSince $det(U)=4$, we get:\n\n$$\n\\begin{aligned}det(U) & =4 \\\\ -3v-20 & =4 \\\\ -3v & =4+20 \\\\ -3v & =24 \\\\ v & =-8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592242 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad091e5c-707a-518d-9b21-5e4622f2cd0c" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186592035}] :answer-field/correct {:answer/id #uuid "ad091e5c-707a-518d-9b21-5e4622f2cd0c" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186592035} :answer-field/id #uuid "2a53609f-6339-5056-99fc-1faddb53d517" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186592167}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e824411-1e03-5958-a98d-c29104d4627e" :question/math-academy-id "q-317341" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}7 & 2 \\\\ 5 & 4\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}7 & 2 \\\\ 5 & 4\\end{vmatrix} & =7\\cdot 4-2\\cdot 5 \\\\  & =28-10 \\\\  & =18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592254 :knowledge-point/_questions [{:knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4a224e-44a8-51a0-b051-0bb30d5b7162" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sqrt{3}" :db/id #edb/ref 17592186591816}] :answer-field/correct {:answer/id #uuid "0f4a224e-44a8-51a0-b051-0bb30d5b7162" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\sqrt{3}" :db/id #edb/ref 17592186591816} :answer-field/id #uuid "b6df6735-8419-5b2f-a9d4-bfe1d4b061e2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186592211}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5711e1a6-e6b6-576f-bfa5-52e1edd7ede4" :question/math-academy-id "q-317369" :question/problem "Evaluate the determinant:\n\n$$\n\\displaystyle \\begin{vmatrix}-\\sqrt{3} & 4 \\\\ \\sqrt{3} & 1\\end{vmatrix}=\n$$\n{{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have\n\n$$\n\\begin{aligned}\\begin{vmatrix}-\\sqrt{3} & 4 \\\\ \\sqrt{3} & 1\\end{vmatrix} & =-\\sqrt{3}\\cdot 1-4\\cdot \\sqrt{3} \\\\  & =-\\sqrt{3}-4\\sqrt{3} \\\\  & =-5\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186592292 :knowledge-point/_questions [{:knowledge-point/id #uuid "2129aee3-923d-57de-8bdc-983ffdf787f1" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5220f649-c738-5122-9599-d9f859321690" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186591903} {:answer/id #uuid "80de4d31-9aa8-5e7b-88f9-e0000d031070" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186591965} {:answer/id #uuid "947a0df3-49f3-5c04-a318-f69823764ba8" :answer/type {:db/ident :answer.type/math} :a