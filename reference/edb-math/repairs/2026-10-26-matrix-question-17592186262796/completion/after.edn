ns [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8f75c6a-39ca-54ce-90b2-d2fed57bce1c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186057631} {:answer/id #uuid "f1cc6fa4-5d2d-5ef7-8b9e-ca6b2a04a6df" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186057632} {:answer/id #uuid "34efec5a-0267-59a9-a0e8-a8bbc8e3bbc3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057633} {:answer/id #uuid "626288b8-1266-5c66-8802-e4279b82a65f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186057634} {:answer/id #uuid "65626e08-ea8e-5f2e-a56f-1de07c241265" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186057635}] :answer-field/correct {:answer/id #uuid "34efec5a-0267-59a9-a0e8-a8bbc8e3bbc3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186057633} :answer-field/id #uuid "1cb55465-244d-5741-a788-539ef4e5adf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186057630}] :question/id #uuid "e1d88843-5476-50c9-8034-3251a4933b8a" :question/math-academy-id "q-19801" :question/problem "If\n$$\n\\displaystyle A = \\begin{bmatrix}1 + t & 2t \\\\ -3 & 1 - t\\end{bmatrix}\n$$\nand $det(A) = 10$, what is the value of $t$?" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\n\\det(A)&=\\begin{vmatrix}1+t & 2t \\\\ -3 & 1-t\\end{vmatrix} \\\\\n&=(1+t)(1-t)-(2t)(-3) \\\\\n&=1-t^2+6t.\n\\end{aligned}\n$$\n\nSince $\\det(A)=10$, we obtain:\n\n$$\n\\begin{aligned}\n1-t^2+6t&=10 \\\\\nt^2-6t+9&=0 \\\\\n(t-3)^2&=0 \\\\\nt&=3.\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233379 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ccdde46-a4ab-517e-910b-571a3a166b6a" :knowledge-point/title "Solving for an Unknown in an Expression Involving the Determinant of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d273204-9c71-5dd0-b69b-1a90276ae151" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186716952}] :answer-field/correct {:answer/id #uuid "2d273204-9c71-5dd0-b69b-1a90276ae151" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186716952} :answer-field/id #uuid "d37edfe3-8d04-5659-9550-117d4c4acd83" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186716953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed3ae951-db6d-557c-8a34-9c013751cf9a" :question/math-academy-id "q-127614" :question/problem "If\n$$\n\\displaystyle D=\\begin{bmatrix}2x & 6 \\\\ 2x & x-2\\end{bmatrix}\n$$\nand $det(D)=-32$, what is the value of $x?$\n\n$x=$ {{field-1}}" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n\\begin{vmatrix}a & b \\\\ c & d\\end{vmatrix}=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}det(D) & =\\begin{vmatrix}2x & 6 \\\\ 2x & x-2\\end{vmatrix} \\\\  & =2x\\cdot (x-2)-6\\cdot 2x \\\\  & =2{x}^{2}-16x\\end{aligned}\n$$\n\nSince $det(D)=-32$, we obtain:\n\n$$\n\\begin{aligned}det(D) & =-32 \\\\ 2{x}^{2}-16x & =-32 \\\\ 2{x}^{2}-16x+32 & =0 \\\\ {x}^{2}-8x+16 & =0 \\\\ (x-4)^{2} & =0 \\\\ x & =4\\end{aligned}\n$$"}]}
