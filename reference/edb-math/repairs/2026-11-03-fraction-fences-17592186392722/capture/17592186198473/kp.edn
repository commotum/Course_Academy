^{2}\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}({2}^{t})\\end{bmatrix}=\\begin{bmatrix}-\\frac{20}{{t}^{5}} \\\\ 2t\\operatorname{sin}⁡t+{t}^{2}\\operatorname{cos}⁡t \\\\ {2}^{t}\\operatorname{ln}⁡2\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186388104 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c1fe797-2919-5ad5-93f4-36e98939c7be" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,\\frac{1}{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩" :db/id #edb/ref 17592186388106} {:answer/id #uuid "e466e53d-149c-525e-ba62-5068da1d66a9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩" :db/id #edb/ref 17592186388107} {:answer/id #uuid "698b7584-db59-5635-8441-8bada94b325a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\pi ,\\,\\sqrt{{\\pi }^{2}+1},\\,2(2\\pi +1)⟩" :db/id #edb/ref 17592186388108} {:answer/id #uuid "f3dc9d67-7e06-5b29-a02d-e5f0b4cf4be7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\pi ,\\,\\frac{2}{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi -2)⟩" :db/id #edb/ref 17592186388109} {:answer/id #uuid "0f95bba9-b5f0-5dff-8ca4-f870c2f23413" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2\\pi ⟩" :db/id #edb/ref 17592186388110}] :answer-field/correct {:answer/id #uuid "e466e53d-149c-525e-ba62-5068da1d66a9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩" :db/id #edb/ref 17592186388107} :answer-field/id #uuid "c2be193b-5173-592e-b997-b1966e08ed0f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388105}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6d3b1235-338f-544b-9e5f-ca61081e2c9e" :question/math-academy-id "q-130408" :question/problem "Find the derivative of  $f(t)=⟨\\operatorname{cos}⁡2t,\\,\\sqrt{{t}^{2}+1},\\,(t+2)^{2}⟩$ at $t=\\pi .$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{{t}^{2}+1}),\\,\\frac{\\text{d}}{\\text{d}t}((t+2)^{2})⟩ \\\\  & =⟨-2\\operatorname{sin}⁡2t,\\,\\frac{t}{\\sqrt{{t}^{2}+1}},\\,2(t+2)⟩\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(\\pi )$ we substitute $t=\\pi $ into the expression for ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =⟨-2\\operatorname{sin}⁡2\\pi ,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩ \\\\  & =⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186391890 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d8f4b31-7cd4-567a-b1ab-e1908f4c5bd0" :answer/type {:db/ident :answer.type/math} :answer/value "-2{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-2{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391892} {:answer/id #uuid "770c4032-8926-5b49-96b8-17c721eb3eeb" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }\\,i-{e}^{\\pi }\\,j+{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391893} {:answer/id #uuid "d767d08e-9f3d-5075-804a-e32b3b238995" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{\\pi }\\,j" :db/id #edb/ref 17592186391894} {:answer/id #uuid "53ba9a50-f890-5647-8a42-ad787ec3b6e8" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391895} {:answer/id #uuid "fadb0885-54d3-518c-85c6-6d456aea62cc" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }\\,i-{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391896}] :answer-field/correct {:answer/id #uuid "53ba9a50-f890-5647-8a42-ad787ec3b6e8" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{\\pi }\\,i+{e}^{\\pi }\\,j-{e}^{\\pi }\\,k" :db/id #edb/ref 17592186391895} :answer-field/id #uuid "1620165b-3bcb-5548-