k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eec3fb3-98bb-539f-828a-96203367f774" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln(3)+2" :db/id #edb/ref 17592186500764}] :answer-field/correct {:answer/id #uuid "8eec3fb3-98bb-539f-828a-96203367f774" :answer/type {:db/ident :answer.type/math} :answer/value "2\\ln(3)+2" :db/id #edb/ref 17592186500764} :answer-field/id #uuid "0bfa90a3-ba24-559f-9c8b-5a07e671e7fb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501023} {:answer-field/choices [{:answer/id #uuid "11cf7146-ed56-5694-a708-a9b3016a6fdc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186500506}] :answer-field/correct {:answer/id #uuid "11cf7146-ed56-5694-a708-a9b3016a6fdc" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186500506} :answer-field/id #uuid "504d5d52-6b4f-57e5-9c75-2dca13703f87" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501049} {:answer-field/choices [{:answer/id #uuid "bc780555-5bb0-55aa-b97f-a47fa4610bb8" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cos(1)" :db/id #edb/ref 17592186500860}] :answer-field/correct {:answer/id #uuid "bc780555-5bb0-55aa-b97f-a47fa4610bb8" :answer/type {:db/ident :answer.type/math} :answer/value "5\\cos(1)" :db/id #edb/ref 17592186500860} :answer-field/id #uuid "f4dc9af4-ea47-5fb1-8da7-ddafaed28423" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501126}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "87416abb-dad9-5afe-bb9d-e8fcd5a9095c" :question/math-academy-id "q-350227" :question/problem "Given that  $$\n\\displaystyle f(t)=2t\\operatorname{ln}⁡(3t)\\,i-5\\operatorname{sin}⁡t\\,j+\\frac{6}{t}\\,k,\n$$   what is ${f}^{′}(