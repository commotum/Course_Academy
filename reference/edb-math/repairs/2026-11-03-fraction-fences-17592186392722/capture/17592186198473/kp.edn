{aligned}\n$$\n\nFor component 2, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(- 3 t^{2}\\right) \\\\ &=- 6 t\n\\end{aligned}\n$$\n\nFor component 3, use the product rule:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(- t e^{t}\\right) \\\\ &=-1\\left(1\\cdot e^t+t\\cdot e^t\\right) \\\\ &=- t e^{t} - e^{t}\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}- \\frac{1}{t^{2}} \\\\ - 6 t \\\\ - t e^{t} - e^{t}\\end{bmatrix}.\n$$\n\nSubstitute $t=2$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(2)&=- \\frac{1}{\\left(2\\right)^{2}} \\\\ &=- \\frac{1}{4} \\\\ f_{2}'(2)&=- 6 \\left(2\\right) \\\\ &=-12 \\\\ f_{3}'(2)&=- \\left(2\\right) e^{\\left(2\\right)} - e^{\\left(2\\right)} \\\\ &=- 3 e^{2}\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(2)=\\begin{bmatrix}- \\frac{1}{4} \\\\ -12 \\\\ - 3 e^{2}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186708344 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75c9fb31-a232-58cd-bc75-40e00f8271ca" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186708332}] :answer-field/correct {:answer/id #uuid "75c9fb31-a232-58cd-bc75-40e00f8271ca" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186708332} :answer-field/id #uuid "4e1182f2-2cc6-504f-8814-d90f9f5db60c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708322} {:answer-field/choices [{:answer/id #uuid "06a0dd8c-d0f3-5863-b54f-6162eb9ad543" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186708311}] :answer-field/correct {:answer/id #uuid "06a0dd8c-d0f3-5863-b54f-6162eb9ad543" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186708311} :answer-field/id #uuid "529538ee-9f95-5d65-9b61-f0c7e98f6a54" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708323} {:answer-field/choices [{:answer/id #uuid "0aa7fd8e-6bca-5a95-92b0-9c3bef652b3f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186708313}] :answer-field/correct {:answer/id #uuid "0aa7fd8e-6bca-5a95-92b0-9c3bef652b3f" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186708313} :answer-field/id #uuid "5dd2e3c5-95f5-5aa8-9cf0-23807a83e342" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708327}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eed33536-322e-5aef-b66b-662c39c7c6ee" :question/problem "Find $\\mathbf{f}'(0)$ for\n\n$$\n\\begin{aligned}\\mathbf{f}(t)&=\\left(\\arctan{\\left(3 t \\right)}\\right)\\mathbf{i} \\\\ &+\\left(\\frac{3}{t + 1}\\right)\\mathbf{j} \\\\ &+\\left(- 3 t^{2} + 3 t\\right)\\mathbf{k}.\\end{aligned}\n$$\n\nWork on the real domain where $t + 1\\ne0$.\n\nEnter exact components in order.\n\n$\\mathbf{f}'(0)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the inverse-tangent and chain rules:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(\\arctan{\\left(3 t \\right)}\\right) \\\\ &=1\\cdot\\frac{3}{1+(3 t)^2} \\\\ &=\\frac{3}{9 t^{2} + 1}\n\\end{aligned}\n$$\n\nFor component 2, use the negative-power and chain rules:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(\\frac{3}{t + 1}\\right) \\\\ &=- \\frac{3}{\\left(t + 1\\right)^{2}}\n\\end{aligned}\n$$\n\nFor component 3, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(- 3 t^{2} + 3 t\\right) \\\\ &=3 - 6 t\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}\\frac{3}{9 t^{2} + 1} \\\\ - \\frac{3}{\\left(t + 1\\right)^{2}} \\\\ 3 - 6 t\\end{bmatrix}.\n$$\n\nSubstitute $t=0$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(0)&=\\frac{3}{9 \\left(0\\right)^{2} + 1} \\\\ &=3 \\\\ f_{2}'(0)&=- \\frac{3}{\\left(\\left(0\\right) + 1\\right)^{2}} \\\\ &=-3 \\\\ f_{3}'(0)&=3 - 6 \\left(0\\right) \\\\ &=3\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(0)=\\begin{bmatrix}3 \\\\ -3 \\\\ 3\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186708348 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62992d6d-3f04-5a66-9956-02fb58d0268d" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 \\sin{\\left(2 \\right)}" :db/id #edb/ref 17592186708359}] :answer-field/correct {:answer/id #uuid "62992d6d-3f04-5a66-9956-02fb58d0268d" :answer/type {:db/ident :answer.type/math} :answer/value "- 6 \\sin{\\left(2 \\right)}" :db/id #edb/ref 17592186708359} :answer-field/id #uuid "1030f1d1-6ff9-5296-bcec-9f1da8e675ee" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708350} {:answer-field/choices [{:answer/id #uuid "862823b1-3ca4-538e-9cba-851a0d6beafe" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186708362}] :answer-field/correct {:answer/id #uuid "862823b1-3ca4-538e-9cba-851a0d6beafe" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186708362} :answer-field/id #uuid "982bc473-6034-5817-9bb8-e0fc0306b138" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708364} {:answer-field/choices [{:answer/id #uuid "e104ef77-fdd6-5767-92cb-43d6ba4cd701" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{37} + \\arctan{\\left(6 \\right)}" :db/id #edb/ref 17592186708371}] :answer-field/correct {:answer/id #uuid "e104ef77-fdd6-5767-92cb-43d6ba4cd701" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{6}{37} + \\arctan{\\left(6 \\right)}" :db/id #edb/ref 17592186708371} :answer-field/id #uuid "b89ddcc6-a927-5a85-b95b-0ab08ec8130b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708366}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "0d5e4851-98af-53f9-a1d2-2c563a8fcbfc" :question/problem "Find $\\mathbf{f}'(2)$ for\n\n$$\n\\mathbf{f}(t)=\\left\\langle t \\arctan{\\left(3 t \\right)},\\,3 t \\cos{\\left(t \\right)} - 3 \\sin{\\left(t \\right)},\\,2 t^{2}\\right\\rangle.\n$$\n\nEnter exact components in order.\n\n$\\mathbf{f}'(2)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the product rule with inverse-tangent chain rule:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(t \\arctan{\\left(3 t \\right)}\\right) \\\\ &=1\\left(1\\cdot \\arctan{\\left(3 t \\right)}+t\\cdot\\frac{3}{1+(3 t)^2}\\right) \\\\ &=\\frac{3 t}{9 t^{2} + 1} + \\arctan{\\left(3 t \\right)}\n\\end{aligned}\n$$\n\nFor component 2, use the sum and product rules; cancel opposite cosine terms:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(3 t \\cos{\\left(t \\right)} - 3 \\sin{\\left(t \\right)}\\right) \\\\ &=-3\\left(\\cos t-\\cos t+t\\sin t\\right) \\\\ &=- 3 t \\sin{\\left(t \\right)}\n\\end{aligned}\n$$\n\nFor component 3, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(2 t^{2}\\right) \\\\ &=4 t\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}\\frac{3 t}{9 t^{2} + 1} + \\arctan{\\left(3 t \\right)} \\\\ - 3 t \\sin{\\left(t \\right)} \\\\ 4 t\\end{bmatrix}.\n$$\n\nSubstitute $t=2$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(2)&=\\frac{3 \\left(2\\right)}{9 \\left(2\\right)^{2} + 1} + \\arctan{\\left(3 \\left(2\\right) \\right)} \\\\ &=\\frac{6}{37} + \\arctan{\\left(6 \\right)} \\\\ f_{2}'(2)&=- 3 \\left(2\\right) \\sin{\\left(\\left(2\\right) \\right)} \\\\ &=- 6 \\sin{\\left(2 \\right)} \\\\ f_{3}'(2)&=4 \\left(2\\right) \\\\ &=8\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(2)=\\begin{bmatrix}\\frac{6}{37} + \\arctan{\\left(6 \\right)} \\\\ - 6 \\sin{\\left(2 \\right)} \\\\ 8\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."} {:db/id #edb/ref 17592186708356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b26eb399-124a-5fd4-b0de-7af5ce6445fc" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cos{\\left(1 \\right)}" :db/id #edb/ref 17592186708365}] :answer-field/correct {:answer/id #uuid "b26eb399-124a-5fd4-b0de-7af5ce6445fc" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\cos{\\left(1 \\right)}" :db/id #edb/ref 17592186708365} :answer-field/id #uuid "194ab153-0291-5a99-a96f-34b385497604" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708353} {:answer-field/choices [{:answer/id #uuid "0eaf1d00-bbeb-508f-9b16-092861b9e286" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3} + \\ln{\\left(3 \\right)}" :db/id #edb/ref 17592186708349}] :answer-field/correct {:answer/id #uuid "0eaf1d00-bbeb-508f-9b16-092861b9e286" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3} + \\ln{\\left(3 \\right)}" :db/id #edb/ref 17592186708349} :answer-field/id #uuid "29fa2f1e-c1b1-5b31-9460-2d91f633335c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708355} {:answer-field/choices [{:answer/id #uuid "de62688c-7ee4-58e4-9950-682e7f3686d0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186708370}] :answer-field/correct {:answer/id #uuid "de62688c-7ee4-58e4-9950-682e7f3686d0" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186708370} :answer-field/id #uuid "89dff7a3-120d-5511-ab6d-966c3d44c7a4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708363}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "3a017d54-e4a3-5485-827e-02e55ef8dd26" :question/problem "Find $\\mathbf{f}'(1)$ for\n\n$$\n\\mathbf{f}(t)=\\left\\langle t \\ln{\\left(2 t + 1 \\right)},\\,3 t^{2},\\,2 t \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right\\rangle.\n$$\n\nWork on the real domain where $2 t + 1>0$.\n\nEnter exact components in order.\n\n$\\mathbf{f}'(1)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the product rule with logarithm chain rule:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(t \\ln{\\left(2 t + 1 \\right)}\\right) \\\\ &=1\\left(1\\cdot \\ln{\\left(2 t + 1 \\right)}+t\\cdot\\frac{2}{2 t + 1}\\right) \\\\ &=\\frac{2 t}{2 t + 1} + \\ln{\\left(2 t + 1 \\right)}\n\\end{aligned}\n$$\n\nFor component 2, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(3 t^{2}\\right) \\\\ &=6 t\n\\end{aligned}\n$$\n\nFor component 3, use the sum and product rules; cancel opposite sine terms:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(2 t \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) \\\\ &=2\\left(-\\sin t+\\sin t+t\\cos t\\right) \\\\ &=2 t \\cos{\\left(t \\right)}\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}\\frac{2 t}{2 t + 1} + \\ln{\\left(2 t + 1 \\right)} \\\\ 6 t \\\\ 2 t \\cos{\\left(t \\right)}\\end{bmatrix}.\n$$\n\nSubstitute $t=1$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(1)&=\\frac{2 \\left(1\\right)}{2 \\left(1\\right) + 1} + \\ln{\\left(2 \\left(1\\right) + 1 \\right)} \\\\ &=\\frac{2}{3} + \\ln{\\left(3 \\right)} \\\\ f_{2}'(1)&=6 \\left(1\\right) \\\\ &=6 \\\\ f_{3}'(1)&=2 \\left(1\\right) \\cos{\\left(\\left(1\\right) \\right)} \\\\ &=2 \\cos{\\left(1 \\right)}\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(1)=\\begin{bmatrix}\\frac{2}{3} + \\ln{\\left(3 \\right)} \\\\ 6 \\\\ 2 \\cos{\\left(1 \\right)}\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."} {:db/id #edb/ref 17592186708372 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73695fae-a933-5836-b594-36fd010cffbf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\ln{\\left(8 \\right)} - \\frac{3}{4}" :db/id #edb/ref 17592186708361}] :answer-field/correct {:answer/id #uuid "73695fae-a933-5836-b594-36fd010cffbf" :answer/type {:db/ident :answer.type/math} :answer/value "- \\ln{\\left(8 \\right)} - \\frac{3}{4}" :db/id #edb/ref 17592186708361} :answer-field/id #uuid "0966782c-d659-573a-a795-914d397d98f5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708347} {:answer-field/choices [{:answer/id #uuid "5c5a1b9c-4248-5b2d-8c20-6dfeaa4f72d2" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(2 \\right)}" :db/id #edb/ref 17592186708358}] :answer-field/correct {:answer/id #uuid "5c5a1b9c-4248-5b2d-8c20-6dfeaa4f72d2" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(2 \\right)}" :db/id #edb/ref 17592186708358} :answer-field/id #uuid "cfd86eac-861d-5497-838a-f7524db765db" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708368} {:answer-field/choices [{:answer/id #uuid "ec46d804-2c83-562f-99b7-d82b36820216" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186708374}] :answer-field/correct {:answer/id #uuid "ec46d804-2c83-562f-99b7-d82b36820216" :answer/type {:db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186708374} :answer-field/id #uuid "dc143cb0-5dc0-55a1-add0-2429a0d19578" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708369}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e44311bb-145e-5825-8fa7-6542860b7c63" :question/problem "Find $\\mathbf{f}'(2)$ for\n\n$$\n\\mathbf{f}(t)=\\begin{bmatrix}- 2 \\sin{\\left(t \\right)} \\\\ - 2 t^{2} \\\\ - t \\ln{\\left(3 t + 2 \\right)}\\end{bmatrix}.\n$$\n\nWork on the real domain where $3 t + 2>0$.\n\nEnter exact components in order.\n\n$\\mathbf{f}'(2)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the trigonometric and chain rules:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(- 2 \\sin{\\left(t \\right)}\\right) \\\\ &=-2\\cdot 1\\cdot \\cos{\\left(t \\right)} \\\\ &=- 2 \\cos{\\left(t \\right)}\n\\end{aligned}\n$$\n\nFor component 2, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(- 2 t^{2}\\right) \\\\ &=- 4 t\n\\end{aligned}\n$$\n\nFor component 3, use the product rule with logarithm chain rule:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(- t \\ln{\\left(3 t + 2 \\right)}\\right) \\\\ &=-1\\left(1\\cdot \\ln{\\left(3 t + 2 \\right)}+t\\cdot\\frac{3}{3 t + 2}\\right) \\\\ &=- \\frac{3 t}{3 t + 2} - \\ln{\\left(3 t + 2 \\right)}\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}- 2 \\cos{\\left(t \\right)} \\\\ - 4 t \\\\ - \\frac{3 t}{3 t + 2} - \\ln{\\left(3 t + 2 \\right)}\\end{bmatrix}.\n$$\n\nSubstitute $t=2$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(2)&=- 2 \\cos{\\left(\\left(2\\right) \\right)} \\\\ &=- 2 \\cos{\\left(2 \\right)} \\\\ f_{2}'(2)&=- 4 \\left(2\\right) \\\\ &=-8 \\\\ f_{3}'(2)&=- \\frac{3 \\left(2\\right)}{3 \\left(2\\right) + 2} - \\ln{\\left(3 \\left(2\\right) + 2 \\right)} \\\\ &=- \\ln{\\left(8 \\right)} - \\frac{3}{4}\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(2)=\\begin{bmatrix}- 2 \\cos{\\left(2 \\right)} \\\\ -8 \\\\ - \\ln{\\left(8 \\right)} - \\frac{3}{4}\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."} {:db/id #edb/ref 17592186708373 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2646969e-b73c-5a12-ba74-c7813062c920" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cos{\\left(2 \\right)}" :db/id #edb/ref 17592186708354}] :answer-field/correct {:answer/id #uuid "2646969e-b73c-5a12-ba74-c7813062c920" :answer/type {:db/ident :answer.type/math} :answer/value "4 \\cos{\\left(2 \\right)}" :db/id #edb/ref 17592186708354} :answer-field/id #uuid "1933f88b-a4e5-55dc-afe5-b85a10275cdc" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708352} {:answer-field/choices [{:answer/id #uuid "630a87a0-a0db-5d74-9235-c512111786c4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\arctan{\\left(4 \\right)} - \\frac{4}{17}" :db/id #edb/ref 17592186708360}] :answer-field/correct {:answer/id #uuid "630a87a0-a0db-5d74-9235-c512111786c4" :answer/type {:db/ident :answer.type/math} :answer/value "- \\arctan{\\left(4 \\right)} - \\frac{4}{17}" :db/id #edb/ref 17592186708360} :answer-field/id #uuid "496c6450-1a31-5ecb-9ab5-f19b1d9b74b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708357} {:answer-field/choices [{:answer/id #uuid "188d0e1d-be2c-5ca7-8085-3eadc8bcdf5b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186708351}] :answer-field/correct {:answer/id #uuid "188d0e1d-be2c-5ca7-8085-3eadc8bcdf5b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186708351} :answer-field/id #uuid "c97ad1ac-ec65-5617-8835-709ce4057f10" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708367}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "ec12a6a2-cf6c-5d69-8cb8-c4aa50ecbca3" :question/problem "Find $\\mathbf{f}'(2)$ for\n\n$$\n\\begin{aligned}\\mathbf{f}(t)&=\\left(- t \\arctan{\\left(2 t \\right)}\\right)\\mathbf{i} \\\\ &+\\left(2 t \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right)\\mathbf{j} \\\\ &+\\left(- t^{2}\\right)\\mathbf{k}.\\end{aligned}\n$$\n\nEnter exact components in order.\n\n$\\mathbf{f}'(2)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the product rule with inverse-tangent chain rule:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(- t \\arctan{\\left(2 t \\right)}\\right) \\\\ &=-1\\left(1\\cdot \\arctan{\\left(2 t \\right)}+t\\cdot\\frac{2}{1+(2 t)^2}\\right) \\\\ &=- \\frac{2 t}{4 t^{2} + 1} - \\arctan{\\left(2 t \\right)}\n\\end{aligned}\n$$\n\nFor component 2, use the sum and product rules; cancel opposite sine terms:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(2 t \\sin{\\left(t \\right)} + 2 \\cos{\\left(t \\right)}\\right) \\\\ &=2\\left(-\\sin t+\\sin t+t\\cos t\\right) \\\\ &=2 t \\cos{\\left(t \\right)}\n\\end{aligned}\n$$\n\nFor component 3, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(- t^{2}\\right) \\\\ &=- 2 t\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}- \\frac{2 t}{4 t^{2} + 1} - \\arctan{\\left(2 t \\right)} \\\\ 2 t \\cos{\\left(t \\right)} \\\\ - 2 t\\end{bmatrix}.\n$$\n\nSubstitute $t=2$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(2)&=- \\frac{2 \\left(2\\right)}{4 \\left(2\\right)^{2} + 1} - \\arctan{\\left(2 \\left(2\\right) \\right)} \\\\ &=- \\arctan{\\left(4 \\right)} - \\frac{4}{17} \\\\ f_{2}'(2)&=2 \\left(2\\right) \\cos{\\left(\\left(2\\right) \\right)} \\\\ &=4 \\cos{\\left(2 \\right)} \\\\ f_{3}'(2)&=- 2 \\left(2\\right) \\\\ &=-4\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(2)=\\begin{bmatrix}- \\arctan{\\left(4 \\right)} - \\frac{4}{17} \\\\ 4 \\cos{\\left(2 \\right)} \\\\ -4\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."} {:db/id #edb/ref 17592186708382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "386f6267-fa3d-5339-b333-baadbe3295bf" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(1 \\right)}" :db/id #edb/ref 17592186708378}] :answer-field/correct {:answer/id #uuid "386f6267-fa3d-5339-b333-baadbe3295bf" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\cos{\\left(1 \\right)}" :db/id #edb/ref 17592186708378} :answer-field/id #uuid "224e066e-6786-50a7-922a-088d68af3c48" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708376} {:answer-field/choices [{:answer/id #uuid "cfac5e5c-391e-5bc2-bc8c-ff7bb7815974" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186708385}] :answer-field/correct {:answer/id #uuid "cfac5e5c-391e-5bc2-bc8c-ff7bb7815974" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186708385} :answer-field/id #uuid "38fa10b9-a4b6-5b18-b773-ed6f874bddf8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708379} {:answer-field/choices [{:answer/id #uuid "dd79fc58-dc89-534f-834c-442cf6ad9644" :answer/type {:db/ident :answer.type/math} :answer/value "- \\ln{\\left(5 \\right)} - \\frac{3}{5}" :db/id #edb/ref 17592186708386}] :answer-field/correct {:answer/id #uuid "dd79fc58-dc89-534f-834c-442cf6ad9644" :answer/type {:db/ident :answer.type/math} :answer/value "- \\ln{\\left(5 \\right)} - \\frac{3}{5}" :db/id #edb/ref 17592186708386} :answer-field/id #uuid "8056596e-5514-5505-8673-c5d167eca7b8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708381}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "81e87b77-cdef-56b7-aaf5-5d632163dd08" :question/problem "Find $\\mathbf{f}'(1)$ for\n\n$$\n\\mathbf{f}(t)=\\left\\langle - 2 t \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)},\\,- t \\ln{\\left(3 t + 2 \\right)},\\,3 t^{2}\\right\\rangle.\n$$\n\nWork on the real domain where $3 t + 2>0$.\n\nEnter exact components in order.\n\n$\\mathbf{f}'(1)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the sum and product rules; cancel opposite sine terms:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(- 2 t \\sin{\\left(t \\right)} - 2 \\cos{\\left(t \\right)}\\right) \\\\ &=-2\\left(-\\sin t+\\sin t+t\\cos t\\right) \\\\ &=- 2 t \\cos{\\left(t \\right)}\n\\end{aligned}\n$$\n\nFor component 2, use the product rule with logarithm chain rule:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(- t \\ln{\\left(3 t + 2 \\right)}\\right) \\\\ &=-1\\left(1\\cdot \\ln{\\left(3 t + 2 \\right)}+t\\cdot\\frac{3}{3 t + 2}\\right) \\\\ &=- \\frac{3 t}{3 t + 2} - \\ln{\\left(3 t + 2 \\right)}\n\\end{aligned}\n$$\n\nFor component 3, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(3 t^{2}\\right) \\\\ &=6 t\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}- 2 t \\cos{\\left(t \\right)} \\\\ - \\frac{3 t}{3 t + 2} - \\ln{\\left(3 t + 2 \\right)} \\\\ 6 t\\end{bmatrix}.\n$$\n\nSubstitute $t=1$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(1)&=- 2 \\left(1\\right) \\cos{\\left(\\left(1\\right) \\right)} \\\\ &=- 2 \\cos{\\left(1 \\right)} \\\\ f_{2}'(1)&=- \\frac{3 \\left(1\\right)}{3 \\left(1\\right) + 2} - \\ln{\\left(3 \\left(1\\right) + 2 \\right)} \\\\ &=- \\ln{\\left(5 \\right)} - \\frac{3}{5} \\\\ f_{3}'(1)&=6 \\left(1\\right) \\\\ &=6\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(1)=\\begin{bmatrix}- 2 \\cos{\\left(1 \\right)} \\\\ - \\ln{\\left(5 \\right)} - \\frac{3}{5} \\\\ 6\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."} {:db/id #edb/ref 17592186708387 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9871784a-34b6-5de5-81b2-30523142bb1d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186708383}] :answer-field/correct {:answer/id #uuid "9871784a-34b6-5de5-81b2-30523142bb1d" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186708383} :answer-field/id #uuid "0005247b-6a02-5bc2-87bd-ba2af12ff80a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708375} {:answer-field/choices [{:answer/id #uuid "c333f65a-a1bb-5390-b9dc-f7ba89f522b2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\arctan{\\left(3 \\right)} - \\frac{3}{10}" :db/id #edb/ref 17592186708384}] :answer-field/correct {:answer/id #uuid "c333f65a-a1bb-5390-b9dc-f7ba89f522b2" :answer/type {:db/ident :answer.type/math} :answer/value "- \\arctan{\\left(3 \\right)} - \\frac{3}{10}" :db/id #edb/ref 17592186708384} :answer-field/id #uuid "77e9049c-be35-53ab-9aa5-15a9c193b106" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708380} {:answer-field/choices [{:answer/id #uuid "37dc50ad-3f9c-5f13-a321-dabd6214d301" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\sin{\\left(1 \\right)}" :db/id #edb/ref 17592186708377}] :answer-field/correct {:answer/id #uuid "37dc50ad-3f9c-5f13-a321-dabd6214d301" :answer/type {:db/ident :answer.type/math} :answer/value "- 2 \\sin{\\left(1 \\right)}" :db/id #edb/ref 17592186708377} :answer-field/id #uuid "e649971d-ddde-54a6-ac94-a54308b808e6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708388}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "e49654ab-6b4d-506e-a8ff-566e8f7d9d3c" :question/problem "Find $\\mathbf{f}'(1)$ for\n\n$$\n\\mathbf{f}(t)=\\left\\langle - 2 t^{2},\\,2 \\cos{\\left(t \\right)},\\,- t \\arctan{\\left(3 t \\right)}\\right\\rangle.\n$$\n\nEnter exact components in order.\n\n$\\mathbf{f}'(1)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(- 2 t^{2}\\right) \\\\ &=- 4 t\n\\end{aligned}\n$$\n\nFor component 2, use the trigonometric and chain rules:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(2 \\cos{\\left(t \\right)}\\right) \\\\ &=2\\cdot 1\\cdot - \\sin{\\left(t \\right)} \\\\ &=- 2 \\sin{\\left(t \\right)}\n\\end{aligned}\n$$\n\nFor component 3, use the product rule with inverse-tangent chain rule:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(- t \\arctan{\\left(3 t \\right)}\\right) \\\\ &=-1\\left(1\\cdot \\arctan{\\left(3 t \\right)}+t\\cdot\\frac{3}{1+(3 t)^2}\\right) \\\\ &=- \\frac{3 t}{9 t^{2} + 1} - \\arctan{\\left(3 t \\right)}\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}- 4 t \\\\ - 2 \\sin{\\left(t \\right)} \\\\ - \\frac{3 t}{9 t^{2} + 1} - \\arctan{\\left(3 t \\right)}\\end{bmatrix}.\n$$\n\nSubstitute $t=1$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(1)&=- 4 \\left(1\\right) \\\\ &=-4 \\\\ f_{2}'(1)&=- 2 \\sin{\\left(\\left(1\\right) \\right)} \\\\ &=- 2 \\sin{\\left(1 \\right)} \\\\ f_{3}'(1)&=- \\frac{3 \\left(1\\right)}{9 \\left(1\\right)^{2} + 1} - \\arctan{\\left(3 \\left(1\\right) \\right)} \\\\ &=- \\arctan{\\left(3 \\right)} - \\frac{3}{10}\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(1)=\\begin{bmatrix}-4 \\\\ - 2 \\sin{\\left(1 \\right)} \\\\ - \\arctan{\\left(3 \\right)} - \\frac{3}{10}\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."} {:db/id #edb/ref 17592186708395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93b7892f-0195-50e8-91ba-c0bc89494933" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sin{\\left(2 \\right)}" :db/id #edb/ref 17592186708390}] :answer-field/correct {:answer/id #uuid "93b7892f-0195-50e8-91ba-c0bc89494933" :answer/type {:db/ident :answer.type/math} :answer/value "2 \\sin{\\left(2 \\right)}" :db/id #edb/ref 17592186708390} :answer-field/id #uuid "94e3dd41-2048-543c-8c35-be16296904aa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708391} {:answer-field/choices [{:answer/id #uuid "afaa1fa4-c2f1-5194-822b-c74925a1fcc2" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 \\ln{\\left(7 \\right)} - \\frac{18}{7}" :db/id #edb/ref 17592186708393}] :answer-field/correct {:answer/id #uuid "afaa1fa4-c2f1-5194-822b-c74925a1fcc2" :answer/type {:db/ident :answer.type/math} :answer/value "- 3 \\ln{\\left(7 \\right)} - \\frac{18}{7}" :db/id #edb/ref 17592186708393} :answer-field/id #uuid "a407e1bf-8658-5dd8-8722-812041001833" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708392} {:answer-field/choices [{:answer/id #uuid "43db122c-c141-5cd2-9077-ba64346709e6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186708389}] :answer-field/correct {:answer/id #uuid "43db122c-c141-5cd2-9077-ba64346709e6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186708389} :answer-field/id #uuid "f5750586-c4a2-50eb-abba-6b23ca4af6f7" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708394}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f9dbd4e4-677a-53d5-ade7-e4db20e4aebb" :question/problem "Find $\\mathbf{f}'(2)$ for\n\n$$\n\\begin{aligned}\\mathbf{f}(t)&=\\left(- 3 t \\ln{\\left(3 t + 1 \\right)}\\right)\\mathbf{i} \\\\ &+\\left(- t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}\\right)\\mathbf{j} \\\\ &+\\left(2 t^{2}\\right)\\mathbf{k}.\\end{aligned}\n$$\n\nWork on the real domain where $3 t + 1>0$.\n\nEnter exact components in order.\n\n$\\mathbf{f}'(2)=\\langle$ {{field-1}} $,$ {{field-2}} $,$ {{field-3}} $\\rangle$" :question/worked-solution "Let $f_1$, $f_2$, and $f_3$ be the components in the given order. Differentiate each scalar component separately.\n\nFor component 1, use the product rule with logarithm chain rule:\n\n$$\n\\begin{aligned}\nf_{1}'(t)&=\\frac{d}{dt}\\left(- 3 t \\ln{\\left(3 t + 1 \\right)}\\right) \\\\ &=-3\\left(1\\cdot \\ln{\\left(3 t + 1 \\right)}+t\\cdot\\frac{3}{3 t + 1}\\right) \\\\ &=- \\frac{9 t}{3 t + 1} - 3 \\ln{\\left(3 t + 1 \\right)}\n\\end{aligned}\n$$\n\nFor component 2, use the sum and product rules; cancel opposite cosine terms:\n\n$$\n\\begin{aligned}\nf_{2}'(t)&=\\frac{d}{dt}\\left(- t \\cos{\\left(t \\right)} + \\sin{\\left(t \\right)}\\right) \\\\ &=1\\left(\\cos t-\\cos t+t\\sin t\\right) \\\\ &=t \\sin{\\left(t \\right)}\n\\end{aligned}\n$$\n\nFor component 3, use the power and sum rules:\n\n$$\n\\begin{aligned}\nf_{3}'(t)&=\\frac{d}{dt}\\left(2 t^{2}\\right) \\\\ &=4 t\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf{f}'(t)=\\begin{bmatrix}- \\frac{9 t}{3 t + 1} - 3 \\ln{\\left(3 t + 1 \\right)} \\\\ t \\sin{\\left(t \\right)} \\\\ 4 t\\end{bmatrix}.\n$$\n\nSubstitute $t=2$ into the derivative, after differentiating:\n\n$$\n\\begin{aligned}\nf_{1}'(2)&=- \\frac{9 \\left(2\\right)}{3 \\left(2\\right) + 1} - 3 \\ln{\\left(3 \\left(2\\right) + 1 \\right)} \\\\ &=- 3 \\ln{\\left(7 \\right)} - \\frac{18}{7} \\\\ f_{2}'(2)&=\\left(2\\right) \\sin{\\left(\\left(2\\right) \\right)} \\\\ &=2 \\sin{\\left(2 \\right)} \\\\ f_{3}'(2)&=4 \\left(2\\right) \\\\ &=8\n\\end{aligned}\n$$\n\nKeeping the component order gives\n\n$$\n\\mathbf{f}'(2)=\\begin{bmatrix}- 3 \\ln{\\left(7 \\right)} - \\frac{18}{7} \\\\ 2 \\sin{\\left(2 \\right)} \\\\ 8\\end{bmatrix}.\n$$\n\nAngles are in radians. Leave unevaluated trigonometric values exact."}] :knowledge-point/title "The Derivative of a Three-Component Vector-Valued Function"}]}
