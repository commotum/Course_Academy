}(t{e}^{t})\\,i-\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{3}{{t}^{2}}\\right)k \\\\  & =(t+1){e}^{t}\\,i-6t\\,j-\\frac{6}{{t}^{3}}\\,k\\end{aligned}\n$$\n\n \n\nNow, to compute ${f}^{′}(2)$ we substitute $t=2$ into the expression for ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(2) & =(2+1){e}^{2}\\,i-6(2)\\,j-\\frac{6}{{2}^{3}}\\,k \\\\  & =3{e}^{2}\\,i-12\\,j-\\frac{3}{4}\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302157 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0db3f942-5a8e-5c2a-9795-e961f39580cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-9{t}^{2}}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/id #edb/ref 17592186300006} {:answer/id #uuid "59f11bd6-b9db-576a-845f-5008a1c945f1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{1-9{t}^{2}}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/id #edb/ref 17592186300430} {:answer/id #uuid "5a1ab615-f3d9-5c6e-be11-88b45849bbe2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{1-9{t}^{2}}}\\,i-5{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/id #edb/ref 17592186300431} {:answer/id #uuid "8710fa72-9009-525d-ae96-e335042f6b29" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{1-{t}^{2}}}\\,i-20{t}^{3}\\,j+\\frac{6}{{t}^{4}}\\,k" :db/id #edb/ref 17592186300641} {:answer/id #uuid "b90224c9-aa56-5a7b-91b0-1356c9aead70" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{1-{t}^{2}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/id #edb/ref 17592186300887}] :answer-field/correct {:answer/id #uuid "59f11bd6-b9db-576a-845f-5008a1c945f1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{\\sqrt{1-9{t}^{2}}}\\,i-20{t}^{3}\\,j-\\frac{6}{{t}^{4}}\\,k" :db/id #edb/ref 17592186300430} :answer-field/id #uuid "0eb0988d-ace0-5f09-b160-12ad3b3114c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/rad