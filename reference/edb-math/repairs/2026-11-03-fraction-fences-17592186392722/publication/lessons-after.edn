#{[{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186199241} :activity/id #uuid "74f9ba1c-b4de-59c9-abfb-e43102be1d8d" :activity/scope {:db/id #edb/ref 17592186048999} :activity/steps [{:db/id #edb/ref 17592186199241 :step/content {:db/id #edb/ref 17592186199448 :tutorial/content "Differentiating vector-valued functions is easy: we just differentiate each component separately. So, if \n\n$$\n\\mathbf{r}(t) = \\left< x(t), \\, y(t) \\right>,\n$$\n\n then \n\n$$\n\\dfrac{\\textrm d \\mathbf{r} }{\\textrm dt}  = \\mathbf{r}'(t) = \\left< x'(t), \\, y'(t) \\right>.\n$$\n\nFor example, if $\\mathbf{r}(t) = \\left< t+1, \\, t^2+2 \\right>,$ then\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}t} & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(t+1),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}+2)\\right\\rangle  \\\\  & =⟨1,\\,2t⟩\\end{aligned}\n$$\n\nGeometrically, the derivative of a vector-valued function $\\mathbf r(t)$ at the point $t$ gives a vector that's tangent to the curve traced out by $\\mathbf r(t)$ at $t.$\n\n![](images/6d/6d7f1a972197ff5a92bb64bd0bab9e6dd779e800be48232124f8fda39fa3c949.png)\n\nLet's see some examples." :tutorial/id #uuid "2a3dd559-f60a-5a18-8d82-3dc93d7d7487" :tutorial/math-academy-id 1091 :tutorial/title "Introduction"} :step/id #uuid "4745692d-4755-5843-b652-badc497f62c4" :step/math-academy-id 2149 :step/next {:db/id #edb/ref 17592186199242}} {:db/id #edb/ref 17592186199242 :step/content {:db/id #edb/ref 17592186198355 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198230 :question/id #uuid "c737d317-8e09-5ccb-b816-b5f56e925ba9" :question/math-academy-id "e-609" :question/problem "Given that $\\mathbf r(t) = \\langle 10t^4 ,\\, 6\\ln t\\rangle,$ what is $\\mathbf r'\\left(\\dfrac{1}{2}\\right)?$" :question/worked-solution "We differentiate each component separately.\n\n- For the $x$-component $x(t) = 10t^4,$ we have\n\n$$\nx'(t) = 40t^3,\n$$\n\nand therefore\n\n$$\nx'\\left(\\dfrac{1}{2}\\right) = 40\\left(\\dfrac{1}{2}\\right)^3 = 5.\n$$\n\n- For the $y$-component $y(t) = 6 \\ln t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t)=\\frac{6}{t},\\end{aligned}\n$$\n\nand therefore\n\n$$\ny'\\left(\\dfrac{1}{2}\\right) = \\dfrac{6}{\\left(\\dfrac{1}{2}\\right)}=12.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}\\left(\\frac{1}{2}\\right) & =\\left\\langle {x}^{′}\\left(\\frac{1}{2}\\right),\\,{y}^{′}\\left(\\frac{1}{2}\\right)\\right\\rangle  \\\\  & =⟨5,\\,12⟩.\\end{aligned}\n$$"} :knowledge-point/id #uuid "072ad553-dd0b-58e0-b3e2-082c6d9866dd" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048191} {:db/id #edb/ref 17592186050171} {:db/id #edb/ref 17592186050531}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186708427} :knowledge-point/questions [{:db/id #edb/ref 17592186198983} {:db/id #edb/ref 17592186198984} {:db/id #edb/ref 17592186319190} {:db/id #edb/ref 17592186319191} {:db/id #edb/ref 17592186319341} {:db/id #edb/ref 17592186319343} {:db/id #edb/ref 17592186319368} {:db/id #edb/ref 17592186332819} {:db/id #edb/ref 17592186332820} {:db/id #edb/ref 17592186332821} {:db/id #edb/ref 17592186392722} {:db/id #edb/ref 17592186501147} {:db/id #edb/ref 17592186501155} {:db/id #edb/ref 17592186501223} {:db/id #edb/ref 17592186541128} {:db/id #edb/ref 17592186578791} {:db/id #edb/ref 17592186578830} {:db/id #edb/ref 17592186578857} {:db/id #edb/ref 17592186578875} {:db/id #edb/ref 17592186616172} {:db/id #edb/ref 17592186708396} {:db/id #edb/ref 17592186708402} {:db/id #edb/ref 17592186708409} {:db/id #edb/ref 17592186708413} {:db/id #edb/ref 17592186708417} {:db/id #edb/ref 17592186708430}] :knowledge-point/title "Finding the Derivative of a Vector-Valued Function"} :step/id #uuid "2d430221-0498-5e8c-8fa0-61b7f22e0100" :step/math-academy-id 2151 :step/next {:db/id #edb/ref 17592186199441}} {:db/id #edb/ref 17592186199243 :step/content {:db/id #edb/ref 17592186198356 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198231 :question/id #uuid "cde8f304-4937-5eb7-a8e1-a08355ee4d4e" :question/math-academy-id "e-611" :question/problem "Given that $\\mathbf r(t) = \\langle t^6,\\, t^5\\rangle,$ Calculate $\\mathbf r''(t).$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t) = t^6,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =6{t}^{5} \\\\ {x}^{″}(t) & =30{t}^{4}.\\end{aligned}\n$$\n\n- For $y(t) = t^5,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =5{t}^{4} \\\\ {y}^{″}(t) & =20{t}^{3}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨30{t}^{4},\\,20{t}^{3}⟩ \\\\  & =10⟨3{t}^{4},\\,2{t}^{3}⟩.\\end{aligned}\n$$"} :knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050902}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045486} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186708148} :knowledge-point/questions [{:db/id #edb/ref 17592186198985} {:db/id #edb/ref 17592186198986} {:db/id #edb/ref 17592186256783} {:db/id #edb/ref 17592186259484} {:db/id #edb/ref 17592186265904} {:db/id #edb/ref 17592186302126} {:db/id #edb/ref 17592186302156} {:db/id #edb/ref 17592186336018} {:db/id #edb/ref 17592186387346} {:db/id #edb/ref 17592186392729} {:db/id #edb/ref 17592186393751} {:db/id #edb/ref 17592186403794} {:db/id #edb/ref 17592186501141} {:db/id #edb/ref 17592186501194} {:db/id #edb/ref 17592186501238} {:db/id #edb/ref 17592186501242} {:db/id #edb/ref 17592186578808} {:db/id #edb/ref 17592186578849} {:db/id #edb/ref 17592186578863} {:db/id #edb/ref 17592186578867} {:db/id #edb/ref 17592186707802} {:db/id #edb/ref 17592186707813} {:db/id #edb/ref 17592186707818} {:db/id #edb/ref 17592186708129} {:db/id #edb/ref 17592186708133} {:db/id #edb/ref 17592186708137} {:db/id #edb/ref 17592186708141} {:db/id #edb/ref 17592186708146} {:db/id #edb/ref 17592186708151} {:db/id #edb/ref 17592186708152} {:db/id #edb/ref 17592186708164} {:db/id #edb/ref 17592186708176}] :knowledge-point/title "The Second Derivative of a Vector-Valued Function"} :step/id #uuid "10220786-cf3d-5712-b398-62d47674f692" :step/math-academy-id 2153} {:db/id #edb/ref 17592186199441 :step/content {:db/id #edb/ref 17592186199449 :tutorial/content "We can differentiate vector-valued functions with three components in the same way. \n\nFor example, if \n\n$$\n\\mathbf{f}(t) = \\big\\langle x(t), \\: y(t), \\: z(t) \\big\\rangle\n$$\n\nis our vector-valued function, then the derivative is computed as follows:\n\n$$\n\\dfrac{ \\text{d}\\mathbf{f}}{\\text{d}t} = \\left\\langle \\dfrac{ \\text{d}x}{\\text{d}t}, \\: \\dfrac{ \\text{d}y}{\\text{d}t}, \\: \\dfrac{ \\text{d}z}{\\text{d}t} \\right\\rangle\n$$\n\n \n\nFor example, suppose that we are given the vector function \n\n$$\n\\mathbf f (t) = \\left\\langle t^3, \\:  \\ln(t+3), \\:  \\sqrt{t}\\right\\rangle.\n$$\n\n \n\nTo compute the derivative $\\mathbf f'\\!(t),$ we find the derivative of each component function, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{d}{dt}⟨{t}^{3},\\,\\operatorname{ln}⁡(t+3),\\,\\sqrt{t}⟩ \\\\  & =\\left\\langle \\frac{d}{dt}({t}^{3}),\\,\\frac{d}{dt}(\\operatorname{ln}⁡(t+3)),\\,\\frac{d}{dt}(\\sqrt{t})\\right\\rangle  \\\\  & =\\left\\langle 3{t}^{2},\\,\\frac{1}{t+3},\\,\\frac{1}{2\\sqrt{t}}\\right\\rangle \\end{aligned}\n$$" :tutorial/id #uuid "f81076bc-29eb-53de-950f-4dd6e7b16816" :tutorial/math-academy-id 2110 :tutorial/title "Derivatives of Vector-Valued Functions"} :step/id #uuid "5f0730aa-e9f5-5a08-bce6-78e83d82631e" :step/math-academy-id 8190 :step/next {:db/id #edb/ref 17592186199442}} {:db/id #edb/ref 17592186199442 :step/content {:db/id #edb/ref 17592186198473 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198227 :question/id #uuid "a5637d71-22d4-548e-ad36-d09bff61d643" :question/math-academy-id "e-2398" :question/problem "Find the derivative of  $\\mathbf f(t) = \\langle \\sin t ,\\cos t , t \\rangle$ at $t= \\dfrac{\\pi}4.$" :question/worked-solution "First, we find $\\mathbf f'(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(t)\\right\\rangle  \\\\  & =⟨\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t,\\,1⟩\\end{aligned}\n$$\n\nNow, to compute $\\mathbf f'\\left(\\dfrac{\\pi}4\\right),$ we substitute $t=\\dfrac{\\pi}4$ into the expression for $\\mathbf f'(t)\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}^{′}\\left(\\frac{\\pi }{4}\\right) & =\\left\\langle \\operatorname{cos}⁡\\left(\\frac{\\pi }{4}\\right),\\,-\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right),\\,1\\right\\rangle  \\\\  & =\\left\\langle \\frac{\\sqrt{2}}{2},\\,-\\frac{\\sqrt{2}}{2},\\,1\\right\\rangle \\end{aligned}\n$$"} :knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050173} {:db/id #edb/ref 17592186050420} {:db/id #edb/ref 17592186050675}] :knowledge-point/level-coverage [{:db/id #edb/ref 17592186045485} {:db/id #edb/ref 17592186045487}] :knowledge-point/question-generator {:db/id #edb/ref 17592186708346} :knowledge-point/questions [{:db/id #edb/ref 17592186198942} {:db/id #edb/ref 17592186198943} {:db/id #edb/ref 17592186265901} {:db/id #edb/ref 17592186265902} {:db/id #edb/ref 17592186265903} {:db/id #edb/ref 17592186302157} {:db/id #edb/ref 17592186319193} {:db/id #edb/ref 17592186345316} {:db/id #edb/ref 17592186388097} {:db/id #edb/ref 17592186388104} {:db/id #edb/ref 17592186391890} {:db/id #edb/ref 17592186501172} {:db/id #edb/ref 17592186501190} {:db/id #edb/ref 17592186578797} {:db/id #edb/ref 17592186578831} {:db/id #edb/ref 17592186578845} {:db/id #edb/ref 17592186578882} {:db/id #edb/ref 17592186616180} {:db/id #edb/ref 17592186707884} {:db/id #edb/ref 17592186707886} {:db/id #edb/ref 17592186707891} {:db/id #edb/ref 17592186708316} {:db/id #edb/ref 17592186708326} {:db/id #edb/ref 17592186708336} {:db/id #edb/ref 17592186708339} {:db/id #edb/ref 17592186708344} {:db/id #edb/ref 17592186708348} {:db/id #edb/ref 17592186708356} {:db/id #edb/ref 17592186708372} {:db/id #edb/ref 17592186708373} {:db/id #edb/ref 17592186708382} {:db/id #edb/ref 17592186708387} {:db/id #edb/ref 17592186708395}] :knowledge-point/title "The Derivative of a Three-Component Vector-Valued Function"} :step/id #uuid "5d1be177-bebe-5aaf-9bfe-1f0622f69332" :step/math-academy-id 8191 :step/next {:db/id #edb/ref 17592186199243}}] :activity/title "Differentiating Vector-Valued Functions" :activity/type {:db/ident :activity.type/lesson} :db/id #edb/ref 17592186198483}]}
