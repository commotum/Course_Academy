me{cos}⁡t-\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+\\frac{\\sqrt{3}}{2}\\cdot 2t\\,k \\\\  & =t\\operatorname{cos}⁡t\\,i+t\\operatorname{sin}⁡t\\,j+\\sqrt{3}t\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9fceca-75ad-51bc-ae92-c08f9fc2becc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\operatorname{cos}⁡s,\\operatorname{sin}⁡s,4\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500524} {:answer/id #uuid "21637f5f-66fc-5d10-9eec-a98e25102b49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-4\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500537} {:answer/id #uuid "5e8fe481-3298-52af-9b2d-8bc1094ba831" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\sqrt{2}\\operatorname{cos}⁡s,\\sqrt{2}\\operatorname{sin}⁡s,16\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500662} {:answer/id #uuid "85151a70-250f-5968-b519-91999091ac9c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-16\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500743} {:answer/id #uuid "c51b200a-ecff-5cd9-93e9-8afa94661d25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\sqrt{2}\\operatorname{sin}⁡s,-\\sqrt{2}\\operatorname{cos}⁡s,-16\\operatorname{sin}⁡4s⟩" :db/id #edb/ref 17592186500883}] :answer-field/correct {:db/id #edb/ref 17592186500743} :answer-field/id #uuid "4afb8b57-1fee-58f6-a694-2fa66ad992b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186501047}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f415e47a-854d-5840-b197-b8e66cc67e42" :question/math-academy-id "q-34722" :question/problem "Calculate the second derivative of  $f(s)=⟨\\sqrt{2}\\operatorname{cos}⁡s,\\sqrt{2}\\operatorname{sin}⁡s,\\operatorname{cos}⁡4s⟩$ with respect to $s.$" :question/worked-solution "First, we find the derivative of $f(s)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{cos}⁡s),\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{sin}⁡s),\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡4s)⟩ \\\\  & =⟨-\\sqrt{2}\\operatorname{sin}⁡s,\\sqrt{2}\\operatorname{cos}⁡s,-4\\operatorname{sin}⁡4s⟩\\end{aligned}\n$$\n\nNext, we calculate ${f}^{″}(s)$ by differentiating ${f}^{′}(s):$\n\n$$\n\\begin{aligned}{f}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-\\sqrt{2}\\operatorname{sin}⁡s),\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{cos}⁡s),\\frac{\\text{d}}{\\text{d}s}(-4\\operatorname{sin}⁡4s)⟩ \\\\  & =⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-16\\operatorname{cos}⁡4s⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186541128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c621d975-7e42-532e-8cd1-a5a95ff3741c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186540860}] :answer-field/correct {:db/id #edb/ref 17592186540860} :answer-field/id #uuid "280a3379-43b0-5e7e-835c-37f28ffa4d1a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540961} {:answer-field/choices [{:answer/id #uuid "cdc34de8-c927-5f9c-8dbf-b5874f7e2681" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186540873}] :answer-field/correct {:db/id #edb/ref 17592186540873} :answer-field/id #uuid "4d783132-2979-54b3-9fd1-5a7588deaa6d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186540978}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c1baae25-37ff-504a-9b40-31c45e15f352" :question/math-academy-id "q-133294" :question/problem "${r}^{′}(\\sqrt{5})=\\,$$⟨$\n{{field-1}}\n$,$\n{{field-2}}\n$⟩$" :question/worked-solution "We differentiate each component separately.\n\n* For the $x$-component, we have\n\n$$\n{x}^{′}(t)=\\frac{5}{25+{t}^{2}},\n$$\n\nand therefore,\n\n$$\n{x}^{′}(\\sqrt{5})=\\frac{5}{25+(\\sqrt{5})^{2}}=\\frac{1}{6}.\n$$\n\n* For the $y$-component, we have\n\n$$\n{y}^{′}(t)={t}^{2}-2,\n$$\n\nand therefore,\n\n$$\n{y}^{′}(\\sqrt{5})=(\\sqrt{5})^{2}-2=3.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(\\sqrt{5}) & =⟨{x}^{′}(\\sqrt{5}),{y}^{′}(\\sqrt{5})⟩ \\\\  & =⟨\\frac{1}{6},3⟩.\\end{aligned}\n$$"} {:answer/id #uuid "03b8afc6-ea44-541a-b97e-a936ff8c99d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{(t-1)^{3}},\\,4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578281} {:answer/id #uuid "184e7b09-03c9-59e5-a5e3-feab167d2f61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},12t+60,-1⟩" :db/id #edb/ref 17592186578313} {:answer/id #uuid "2ceafae3-2d27-5aa2-9b53-d22a24b05c69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+4{t}^{2}},12t+6,-1⟩" :db/id #edb/ref 17592186578343} {:answer/id #uuid "573ada0a-f0c1-52dc-a229-7935f93d84d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},12t+5,-1⟩" :db/id #edb/ref 17592186578410} {:answer/id #uuid "66a781b9-2748-56b4-b93f-c6603e12f076" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{(t-1)^{3}},\\,-2\\operatorname{cos}⁡(2t)⟩" :db/id #edb/ref 17592186578439} {:answer/id #uuid "8c57e040-49f2-52ad-bf8e-45654daef059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{(t-1)^{3}},\\,-4\\operatorname{cos}⁡(2t)⟩" :db/id #edb/ref 17592186578496} {:answer/id #uuid "a4e21f0a-a067-5841-83ab-5060216bd871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},12t+6,1⟩" :db/id #edb/ref 17592186578530} {:answer/id #uuid "d7db80ab-c211-5f31-845b-80b7a2580341" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{2}{(t-1)^{3}},\\,2\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578609} {:answer/id #uuid "dd0f6753-b96b-54db-98a7-f93fc22d0bf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},10t+30,14⟩" :db/id #edb/ref 17592186578626} {:answer/id #uuid "e11e0b7b-beea-5c09-bba4-1337cdf8b10b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{2}{(t-1)^{3}},\\,-4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578633} {:db/id #edb/ref 17592186578791 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15b4e2ef-e235-5e8d-a1bb-5f11c58eb2ad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186578304}] :answer-field/correct {:db/id #edb/ref 17592186578304} :answer-field/id #uuid "37e0c65a-8bde-58ad-8512-6f5590e399eb" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186578707} {:answer-field/choices [{:answer/id #uuid "bf1b77c6-c140-5642-9aa7-8ca14ff416d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186578569}] :answer-field/correct {:db/id #edb/ref 17592186578569} :answer-field/id #uuid "626184a9-9d57-5880-91a8-6fc6755275d9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186578725}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0082a403-d881-57c2-9693-c2f4c2c9c358" :question/math-academy-id "q-349471" :question/problem "Given that $r(t)=⟨(t-1)({t}^{2}+2),\\,\\operatorname{ln}⁡(8-{t}^{2})⟩,$ what is ${r}^{′}(-1)?$\n\n${r}^{′}(-1)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" :question/worked-solution "We differentiate each component separately.\n\n- For the $x$-component $x(t)=(t-1)({t}^{2}+2),$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =(1)({t}^{2}+2)+(t-1)(2t) \\\\  & =({t}^{2}+2)+2t(t-1),\\end{aligned}\n$$\n\nand therefore,\n\n$$\n{x}^{′}(-1)=({(-1)}^{2}+2)+2(-1)((-1)-1)=7.\n$$\n\n- For the $y$-component $y(t)=\\operatorname{ln}⁡(8-{t}^{2}),$ we have\n\n$$\n{y}^{′}(t)=-\\frac{2t}{8-{t}^{2}},\n$$\n\nand therefore,\n\n$$\n{y}^{′}(-1)=-\\frac{2\\cdot (-1)}{8-{(-1)}^{2}}=\\frac{2}{7}.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(-1) & =⟨{x}^{′}(-1),\\,{y}^{′}(-1)⟩ \\\\  & =⟨7,\\,\\frac{2}{7}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578797 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184e7b09-03c9-59e5-a5e3-feab167d2f61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},12t+60,-1⟩" :db/id #edb/ref 17592186578313} {:answer/id #uuid "2ceafae3-2d27-5aa2-9b53-d22a24b05c69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+4{t}^{2}},12t+6,-1⟩" :db/id #edb/ref 17592186578343} {:answer/id #uuid "573ada0a-f0c1-52dc-a229-7935f93d84d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},12t+5,-1⟩" :db/id #edb/ref 17592186578410} {:answer/id #uuid "a4e21f0a-a067-5841-83ab-5060216bd871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},12t+6,1⟩" :db/id #edb/ref 17592186578530} {:answer/id #uuid "dd0f6753-b96b-54db-98a7-f93fc22d0bf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{1+16{t}^{2}},10t+30,14⟩" :db/id #edb/ref 17592186578626}] :answer-field/correct {:db/id #edb/ref 17592186578313} :answer-field/id #uuid "9dff84f1-f032-5bd8-ac78-3901ea15b78a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186578748}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "12d523d0-155a-5fd3-a582-49f7ff03b371" :question/math-academy-id "q-32418" :question/problem "Calculate the derivative of  $f(t)=⟨\\operatorname{arctan}⁡4t,6(t+5)^{2},14-t⟩$ with respect to $t.$" :question/worked-solution "We find the derivative of $f(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arctan}⁡4t),\\frac{\\text{d}}{\\text{d}t}(6(t+5)^{2}),\\frac{\\text{d}}{\\text{d}t}(14-t)⟩ \\\\  & =⟨\\frac{4}{1+16{t}^{2}},12t+60,-1⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b8afc6-ea44-541a-b97e-a936ff8c99d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{(t-1)^{3}},\\,4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578281} {:answer/id #uuid "66a781b9-2748-56b4-b93f-c6603e12f076" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{(t-1)^{3}},\\,-2\\operatorname{cos}⁡(2t)⟩" :db/id #edb/ref 17592186578439} {:answer/id #uuid "8c57e040-49f2-52ad-bf8e-45654daef059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{4}{(t-1)^{3}},\\,-4\\operatorname{cos}⁡(2t)⟩" :db/id #edb/ref 17592186578496} {:answer/id #uuid "d7db80ab-c211-5f31-845b-80b7a2580341" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{2}{(t-1)^{3}},\\,2\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578609} {:answer/id #uuid "e11e0b7b-beea-5c09-bba4-1337cdf8b10b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{2}{(t-1)^{3}},\\,-4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578633}] :answer-field/correct {:db/id #edb/ref 17592186578633} :answer-field/id #uuid "b8a7f531-97df-5ed0-907d-ba5ccf90a0bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186578761}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2867142f-2689-574f-a1df-8a99e1f1a37d" :question/math-academy-id "q-75066" :question/problem "Given that $r(t)=⟨\\frac{t}{t-1},\\,\\operatorname{sin}⁡(2t)⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\frac{t}{t-1},$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{(t-1)-t}{(t-1)^{2}} \\\\  & =-\\frac{1}{(t-1)^{2}} \\\\ {x}^{″}(t) & =\\frac{2}{(t-1)^{3}}.\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{sin}⁡(2t),$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =2\\operatorname{cos}⁡(2t) \\\\ {y}^{″}(t) & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨\\frac{2}{(t-1)^{3}},\\,-4\\operatorname{sin}⁡(2t)⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34408940-abbe-510e-a59c-3453e2e877f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{34}" :db/id #edb/ref 17592186578353}] :answer-field/correct {:db/id #edb/ref 17592186578353} :answer-field/id #uuid "56894de3-5c4e-50b7-8368-ba0533f5d21c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186578721}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a5bbeacb-82d4-53a1-914c-5f431020b11c" :question/math-academy-id "q-349497" :question/problem "Given that $r(t)=⟨12\\operatorname{ln}⁡(t),\\,\\frac{5}{2}{t}^{2}⟩,$ what is $|{r}^{′}(2)|?$ Do not round the answer.\n\n$|{r}^{′}(2)|=$\n{{field-1}}" :question/worked-solution "We differentiate each component separately.\n\n- For the $x$-component $x(t)=12\\operatorname{ln}⁡(t),$ we have\n\n$$\n{x}^{′}(t)=\\frac{12}{t},\n$$\n\nand therefore,\n\n$$\n{x}^{′}(2)=\\frac{12}{2}=6.\n$$\n\n- For the $y$-component $y(t)=\\frac{5}{2}{t}^{2},$ we have\n\n$$\n{y}^{′}(t)=5t,\n$$\n\nand therefore,\n\n$$\n{y}^{′}(2)=5(2)=10.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(2) & =⟨{x}^{′}(2),\\,{y}^{′}(2)⟩ \\\\  & =⟨6,\\,10⟩.\\end{aligned}\n$$\n\nFinally, computing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|{r}^{′}(2)| & =\\sqrt{{6}^{2}+{10}^{2}} \\\\  & =\\sqrt{36+100} \\\\  & =\\sqrt{136} \\\\  & =2\\sqrt{34}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e27f6d2-73f0-58ef-832e-9344a0b38e26" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186578500}] :answer-field/correct {:db/id #edb/ref 17592186578500} :answer-field/id #uuid "2a281b6c-699b-5518-aef7-7be40ad529b3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186578703} {:answer-field/choices [{:answer/id #uuid "3e2c0edc-9be7-5412-bae1-e35f4b3173db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7" :db/id #edb/ref 17592186578373}] :answer-field/correct {:db/id #edb/ref 17592186578373} :answer-field/id #uuid "ca5988bf-c8e4-554a-aaf1-083a96eb7fc9" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186578765} {:answer-field/choices [{:answer/id #uuid "cd1d68c9-e84c-50ff-82e8-3219f8888a98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186578592}] :answer-field/correct {:db/id #edb/ref 17592186578592} :answer-field/id #uuid "fe540cef-fdaa-5db1-99a0-fae021b5e0b7" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186578786}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbbb4b78-cc4b-55dc-ad15-b9a522fb422e" :question/math-academy-id "q-350766" :question/problem "Given that  $f(t)=⟨4\\operatorname{cos}⁡t,\\,3\\operatorname{sin}⁡t-t,\\,7t⟩,$   what is ${f}^{′}(\\pi )?$\n\n${f}^{′}(\\pi )=⟨${{field-1}}$,$\n{{field-2}}$,$\n{{field-3}}$⟩$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t-t),\\,\\frac{\\text{d}}{\\text{d}t}(7t)⟩ \\\\  & =⟨-4\\operatorname{sin}⁡t,\\,3\\operatorname{cos}⁡t-1,\\,7⟩\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(\\pi ),$ we substitute $t=\\pi$ into the expression for ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =⟨-4\\operatorname{sin}⁡(\\pi ),\\,3\\operatorname{cos}⁡(\\pi )-1,\\,7⟩ \\\\  & =⟨0,\\,-4,\\,7⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186707802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e09ae513-703d-558d-bb0d-fc9623cb30f3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{4t^{3/2}}" :db/id #edb/ref 17592186707815}] :answer-field/correct {:db/id #edb/ref 17592186707815} :answer-field/id #uuid "62312279-18c2-5373-82f7-69c96578a7af" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186707803} {:answer-field/choices [{:answer/id #uuid "25f6d81b-1ff1-5bd5-a7ed-2e867f5bdf97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-12t^2" :db/id #edb/ref 17592186707801}] :answer-field/correct {:db/id #edb/ref 17592186707801} :answer-field/id #uuid "6e7b0d90-af9d-5944-9593-6ced818d79a4" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186707805} {:answer-field/choices [{:answer/id #uuid "e4fd9a21-8077-5584-a037-a7663cde3a39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9e^{2-3t}" :db/id #edb/ref 17592186707816}] :answer-field/correct {:db/id #edb/ref 17592186707816} :answer-field/id #uuid "95ceaff7-c1b0-536c-a629-4a3350a1f0b5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186707807}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5e28e5f7-bae6-5e32-9f7e-3a01ec9a055d" :question/problem "Determine $\\mathbf f''(t)$ for $t>0$, given that\n\n$$\n\\mathbf f(t)=\\begin{bmatrix}3\\sqrt{t} \\\\ e^{2-3t} \\\\ -t^4\\end{bmatrix}.\n$$\n\nEnter the three components in order.\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $\\mathbf f''(t)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First differentiate each component. Rewrite $3\\sqrt{t}$ as $3t^{1/2}$ and use the chain rule for the exponential.\n\n$$\n\\mathbf f'(t)=\\begin{bmatrix}\\frac{3}{2}t^{-1/2} \\\\ -3e^{2-3t} \\\\ -4t^3\\end{bmatrix}.\n$$\n\nDifferentiate again. For the first component, $(\\frac{3}{2}t^{-1/2})'= -\\frac{3}{4}t^{-3/2}$. The exponential gains another factor of $-3$, so its coefficient is $(-3)(-3)=9$. Also, $(-4t^3)'=-12t^2$. Therefore\n\n$$\n\\mathbf f''(t)=\\begin{bmatrix}-\\frac{3}{4t^{3/2}} \\\\ 9e^{2-3t} \\\\ -12t^2\\end{bmatrix}.\n$$"} {:answer/id #uuid "1e19e6e6-2a09-568a-85fd-dca48ff2da45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 6 t,\\, \\frac{2 \\left(e^{2 t} + 2\\right) e^{2 t} + 2 e^{4 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle" :db/id #edb/ref 17592186708399} {:db/id #edb/ref 17592186708402 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "517e87e7-3201-5cca-b3c5-4ac121103b1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 2 t,\\, 0\\rangle" :db/id #edb/ref 17592186708405} {:answer/id #uuid "81d39942-8e3f-578e-9a98-ed8d68364ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{t^{2} - 4},\\, 6 e^{3 t}\\rangle" :db/id #edb/ref 17592186708414} {:answer/id #uuid "81f6d2b9-b974-51d8-ae50-94c44330c76d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{2 t}{t^{2} - 4},\\, 6 e^{3 t}\\rangle" :db/id #edb/ref 17592186708415} {:answer/id #uuid "874a8aba-dc26-536b-86c3-6a8fa368edbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{2 t}{t^{2} - 4},\\, 0\\rangle" :db/id #edb/ref 17592186708416} {:answer/id #uuid "d5407a90-61ac-5e83-997c-05ba1cf0ae21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{2 t}{t^{2} - 4},\\, 2 e^{3 t}\\rangle" :db/id #edb/ref 17592186708424}] :answer-field/correct {:db/id #edb/ref 17592186708415} :answer-field/id #uuid "30cae4ba-4ae8-5452-832c-e2917ebb9fb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186708401}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3736a541-cd3c-54bf-868c-6bf078048b2f" :question/problem "Given that $r(t)=\\langle \\ln{\\left(t^{2} - 4 \\right)},\\, 2 e^{3 t}\\rangle$, what is $r'(t)$?" :question/worked-solution "For the $x$-component, use the chain rule.\n\n$$\n\\begin{aligned}x(t) &= \\ln{\\left(t^{2} - 4 \\right)} \\\\ x'(t) &= \\frac{2 t}{t^{2} - 4}\\end{aligned}\n$$\n\nFor the $y$-component, use the chain rule.\n\n$$\n\\begin{aligned}y(t) &= 2 e^{3 t} \\\\ y'(t) &= 6 e^{3 t}\\end{aligned}\n$$\n\nRetain the coordinate order:\n\n$$\nr'(t)=\\langle \\frac{2 t}{t^{2} - 4},\\, 6 e^{3 t}\\rangle\n$$"} {:answer/id #uuid "3a22e6d1-27ea-5a5f-8182-b5ec29e35b99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 6 t^{5},\\, \\frac{4 e^{2 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle" :db/id #edb/ref 17592186708403} {:db/id #edb/ref 17592186708409 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e0bef6a7-fa88-57e8-9de4-d9bf6d8a5fd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{3}{\\sqrt{t}}" :db/id #edb/ref 17592186708426}] :answer-field/correct {:db/id #edb/ref 17592186708426} :answer-field/id #uuid "6bedd2d3-553b-5fd1-9c1f-ee617150cbfc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186708410} {:answer-field/choices [{:answer/id #uuid "5c4f3a1f-0194-5e4c-862e-fe4a26884440" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 e^{2 t}" :db/id #edb/ref 17592186708407}] :answer-field/correct {:db/id #edb/ref 17592186708407} :answer-field/id #uuid "6d092fcc-3983-5262-8644-916c6a8e8b49" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186708411}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "6abec1ea-11ca-55b3-8bcd-65f760390e8e" :question/problem "Given that $r(t)=\\langle - 6 \\sqrt{t},\\, e^{2 t} - 4\\rangle$, what is $r'(t)$?\n\n$r'(t)=\\langle$ {{field-1}} $,\\,$ {{field-2}} $\\rangle$" :question/worked-solution "For the $x$-component, use the power rule.\n\n$$\n\\begin{aligned}x(t) &= - 6 \\sqrt{t} \\\\ x'(t) &= - \\frac{3}{\\sqrt{t}}\\end{aligned}\n$$\n\nFor the $y$-component, use the chain rule.\n\n$$\n\\begin{aligned}y(t) &= e^{2 t} - 4 \\\\ y'(t) &= 2 e^{2 t}\\end{aligned}\n$$\n\nRetain the coordinate order:\n\n$$\nr'(t)=\\langle - \\frac{3}{\\sqrt{t}},\\, 2 e^{2 t}\\rangle\n$$"} {:answer/id #uuid "81d39942-8e3f-578e-9a98-ed8d68364ce7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{t^{2} - 4},\\, 6 e^{3 t}\\rangle" :db/id #edb/ref 17592186708414} {:answer/id #uuid "81f6d2b9-b974-51d8-ae50-94c44330c76d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{2 t}{t^{2} - 4},\\, 6 e^{3 t}\\rangle" :db/id #edb/ref 17592186708415} {:answer/id #uuid "874a8aba-dc26-536b-86c3-6a8fa368edbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{2 t}{t^{2} - 4},\\, 0\\rangle" :db/id #edb/ref 17592186708416} {:db/id #edb/ref 17592186708417 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e19e6e6-2a09-568a-85fd-dca48ff2da45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 6 t,\\, \\frac{2 \\left(e^{2 t} + 2\\right) e^{2 t} + 2 e^{4 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle" :db/id #edb/ref 17592186708399} {:answer/id #uuid "3a22e6d1-27ea-5a5f-8182-b5ec29e35b99" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 6 t^{5},\\, \\frac{4 e^{2 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle" :db/id #edb/ref 17592186708403} {:answer/id #uuid "89f6b493-8d70-5fea-bdec-6da3f41904ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle t^{5},\\, \\frac{2 e^{2 t}}{e^{2 t} + 2}\\rangle" :db/id #edb/ref 17592186708418} {:answer/id #uuid "9e97f422-da6f-51c1-a24a-9e340fac7c10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle t^{5},\\, \\frac{2 \\left(e^{2 t} + 2\\right) e^{2 t} + 2 e^{4 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle" :db/id #edb/ref 17592186708420} {:answer/id #uuid "da71f87f-d346-558d-ae8f-b4ed5226eaa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 6 t,\\, \\frac{2 e^{2 t}}{e^{2 t} + 2}\\rangle" :db/id #edb/ref 17592186708425}] :answer-field/correct {:db/id #edb/ref 17592186708403} :answer-field/id #uuid "567619dc-a07e-5f37-9381-e545c9fbee15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186708406}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "877b4c1d-ef6b-5096-9066-e22ebcacb3c7" :question/problem "Given that $r(t)=\\langle t^{6},\\, \\frac{e^{2 t}}{e^{2 t} + 2}\\rangle$, what is $r'(t)$?" :question/worked-solution "For the $x$-component, use the power rule.\n\n$$\n\\begin{aligned}x(t) &= t^{6} \\\\ x'(t) &= 6 t^{5}\\end{aligned}\n$$\n\nFor the $y$-component, use the quotient and chain rules.\n\n$$\n\\begin{aligned}y(t) &= \\frac{e^{2 t}}{e^{2 t} + 2} \\\\ y'(t) &= \\frac{(2 e^{2 t})(e^{2 t} + 2)-(e^{2 t})(2 e^{2 t})}{(e^{2 t} + 2)^2} \\\\ &= \\frac{4 e^{2 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\end{aligned}\n$$\n\nRetain the coordinate order:\n\n$$\nr'(t)=\\langle 6 t^{5},\\, \\frac{4 e^{2 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle\n$$"} {:answer/id #uuid "89f6b493-8d70-5fea-bdec-6da3f41904ba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle t^{5},\\, \\frac{2 e^{2 t}}{e^{2 t} + 2}\\rangle" :db/id #edb/ref 17592186708418} {:answer/id #uuid "9e97f422-da6f-51c1-a24a-9e340fac7c10" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle t^{5},\\, \\frac{2 \\left(e^{2 t} + 2\\right) e^{2 t} + 2 e^{4 t}}{\\left(e^{2 t} + 2\\right)^{2}}\\rangle" :db/id #edb/ref 17592186708420} {:answer/id #uuid "d5407a90-61ac-5e83-997c-05ba1cf0ae21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{2 t}{t^{2} - 4},\\, 2 e^{3 t}\\rangle" :db/id #edb/ref 17592186708424} {:answer/id #uuid "da71f87f-d346-558d-ae8f-b4ed5226eaa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 6 t,\\, \\frac{2 e^{2 t}}{e^{2 t} + 2}\\rangle" :db/id #edb/ref 17592186708425}]
