c06e-58dc-a7bf-c70f8fc3d3db" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393757}] :answer-field/correct {:db/id #edb/ref 17592186393756} :answer-field/id #uuid "1e182f36-1f51-5195-9065-734439498a28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186393752}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19d44fb9-0b26-5bc1-af60-efeec2020695" :question/math-academy-id "q-77683" :question/problem "Find the second derivative of $$\n\\displaystyle f(t)=t\\operatorname{cos}⁡t\\,i+t\\operatorname{sin}⁡t\\,j+(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k\n$$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+(3\\cdot \\frac{1}{3}{t}^{2}-2\\cdot \\frac{1}{2}t)\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+({t}^{2}-t)\\,k\\end{aligned}\n$$\n\n \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,k \\\\  & =(-\\operatorname{sin}⁡t-\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k \\\\  & =-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186403794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ca92dd1-d3b1-5bbd-87a9-9caff1cfe1bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{4\\sqrt{{t}^{3}}},\\,\\frac{-3}{(t+1)^{2}}⟩" :db/id #edb/ref 17592186403796} {:answer/id #uuid "eaf9ebfc-20a2-5603-a31d-0792c9a03622" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{-3}{t+1},\\,-\\frac{1}{2\\sqrt{t}}⟩" :db/id #edb/ref 17592186403797} {:answer/id #uuid "7ecb4957-d24d-59f5-9347-136d1afee955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{(t+1)^{2}},\\,\\frac{1}{\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403798} {:answer/id #uuid "b63167ac-944e-5401-84cf-f23779d4b9e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{-3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403799} {:answer/id #uuid "ccf003b1-60be-57fa-890c-82515b81d733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{-1}{t+1},\\,-\\frac{1}{2\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403800}] :answer-field/correct {:db/id #edb/ref 17592186403799} :answer-field/id #uuid "3ab71387-0269-5f3f-bf93-cd7cf7c2275e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403795}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "40db78a3-8e98-5f3c-8f6f-0721104f563f" :question/math-academy-id "q-75034" :question/problem "Given that $r(t)=⟨3\\operatorname{ln}⁡(t+1),\\,\\sqrt{t}⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=3\\operatorname{ln}⁡(t+1),$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{3}{t+1} \\\\ {x}^{″}(t) & =-\\frac{3}{(t+1)^{2}}.\\end{aligned}\n$$\n\n- For $y(t)=\\sqrt{t},$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{1}{2\\sqrt{t}} \\\\ {y}^{″}(t) & =-\\frac{1}{4\\sqrt{{t}^{3}}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨-\\frac{3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩.\\end{aligned}\n$$"} {:answer/id #uuid "1ca92dd1-d3b1-5bbd-87a9-9caff1cfe1bc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{4\\sqrt{{t}^{3}}},\\,\\frac{-3}{(t+1)^{2}}⟩" :db/id #edb/ref 17592186403796} {:answer/id #uuid "eaf9ebfc-20a2-5603-a31d-0792c9a03622" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{-3}{t+1},\\,-\\frac{1}{2\\sqrt{t}}⟩" :db/id #edb/ref 17592186403797} {:answer/id #uuid "7ecb4957-d24d-59f5-9347-136d1afee955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{(t+1)^{2}},\\,\\frac{1}{\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403798} {:answer/id #uuid "b63167ac-944e-5401-84cf-f23779d4b9e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{-3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403799} {:answer/id #uuid "ccf003b1-60be-57fa-890c-82515b81d733" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{-1}{t+1},\\,-\\frac{1}{2\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403800} {:answer/id #uuid "06006b25-a443-54f2-8024-d157cc2b8a3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨4t,\\,\\frac{3}{t}⟩" :db/id #edb/ref 17592186500478} {:answer/id #uuid "4eee71c6-18a3-564f-aef0-94f6b2a849b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨4,\\,\\frac{1}{3t}⟩" :db/id #edb/ref 17592186500627} {:answer/id #uuid "67188f0b-4321-5aa6-8b40-a0a721632c19" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨4,\\,\\frac{3}{t}⟩" :db/id #edb/ref 17592186500681} {:answer/id #uuid "da6cdfe0-793c-5d04-b91f-02dd3f4e71ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨t,\\,\\frac{3}{t}⟩" :db/id #edb/ref 17592186500932} {:db/id #ed