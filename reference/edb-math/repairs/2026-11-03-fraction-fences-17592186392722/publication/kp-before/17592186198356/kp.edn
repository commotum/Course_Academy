key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256129}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "a571f70a-2498-5266-8661-d093b5f70776" :question/math-academy-id "q-123167" :question/problem "Given that $r(t)=⟨2\\operatorname{cos}⁡t,\\,{t}^{2}-t⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=2\\operatorname{cos}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-2\\operatorname{sin}⁡t \\\\ {x}^{″}(t) & =-2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\n- For $y(t)={t}^{2}-t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =2t-1 \\\\ {y}^{″}(t) & =2.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨-2\\operatorname{cos}⁡t,\\,2⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186259484 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66acecfe-de86-5afc-988b-9f1070523b47" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{csc}⁡t(\\operatorname{cot}⁡t+\\operatorname{csc}⁡t),\\,\\frac{1}{t}⟩" :db/id #edb/ref 17592186257689} {:answer/id #uuid "6b27ee5e-014c-5fdf-9960-1dee281e352c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{csc}⁡t({\\cot }^{2}⁡t+{\\csc }^{2}⁡t),\\,-\\frac{2}{{t}^{2}}⟩" :db/id #edb/ref 17592186257727} {:answer/id #uuid "6b8fa841-78c3-5ab2-bed1-ff0215ecad07" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{csc}⁡t({\\cot }^{2}⁡t+{\\csc }^{2}⁡t),\\,\\frac{1}{{t}^{2}}⟩" :db/id #edb/ref 17592186257731} {:answer/id #uuid "ed7b6986-fca0-55b7-ad52-a902a9fa6a41" :answer/type {:db/ident :answer.type/math} :answer/value "⟨{\\cot }^{2}⁡t+{\\csc }^{2}⁡t,\\,-\\frac{2}{{t}^{2}}⟩" :db/id #edb/ref 17592186258835} {:answer/id #uuid "f6954e6f-e086-5f0e-bddb-8ea6239737d0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{csc}⁡t(\\operatorname{cot}⁡t+\\operatorname{csc}⁡t),\\,\\frac{2}{t}⟩" :db/id #edb/ref 17592186258941}] :answer-field/correct {:answer/id #uuid "6b27ee5e-014c-5fdf-9960-1dee281e352c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{csc}⁡t({\\cot }^{2}⁡t+{\\csc }^{2}⁡t),\\,-\\frac{2}{{t}^{2}}⟩" :db/id #edb/ref 17592186257727} :answer-field/id #uuid "8e09c224-5f2f-55b1-923a-f7806a571acc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259277}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "be344af1-dfa6-5b94-ab32-51d8f42a61b9" :question/math-academy-id "q-123171" :question/problem "Given that $r(t)=⟨\\operatorname{csc}⁡t,\\,\\operatorname{ln}⁡({t}^{2})⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\operatorname{csc}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-\\operatorname{cot}⁡t\\operatorname{csc}⁡t \\\\ {x}^{″}(t) & =\\operatorname{csc}⁡t{\\cot }^{2}⁡t+{\\csc }^{3}⁡t \\\\  & =\\operatorname{csc}⁡t({\\cot }^{2}⁡t+{\\csc }^{2}⁡t).\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{ln}⁡({t}^{2}),$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{2}{t} \\\\ {y}^{″}(t) & =-\\frac{2}{{t}^{2}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨\\operatorname{csc}⁡t({\\cot }^{2}⁡t+{\\csc }^{2}⁡t),\\,-\\frac{2}{{t}^{2}}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265904 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33b55018-38c0-5e34-9580-07a2c3c867b2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+6t\\,k" :db/id #edb/ref 17592186263451} {:answer/id #uuid "3b4ddef8-4d99-51c1-ab78-38977889bf2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{t}\\,i-(\\operatorname{cos}⁡t+{e}^{t})\\,j+2t\\,k" :db/id #edb/ref 17592186263527} {:answer/id #uuid "b23bcc05-8bc2-5235-8264-0f5793af6cad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{{t}^{2}}\\,i-(\\operatorname{sin}⁡t+{e}^{t})\\,j+2t+1\\,k" :db/id #edb/ref 17592186264533} {:answer/id #uuid "d12a7bb0-b92e-5b23-8653-3a8cea2991c2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+12t\\,k" :db/id #edb/ref 17592186264828} {:answer/id #uuid "d38c3c98-3c61-5251-805a-df6056e5e60a" :answer/type {:db/ident :answer.type/math} :answer/value "2{t}^{2}\\,i+\\operatorname{cos}⁡t\\,j+t\\,k" :db/id #edb/ref 17592186264843}] :answer-field/correct {:answer/id #uuid "d12a7bb0-b92e-5b23-8653-3a8cea2991c2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+12t\\,k" :db/id #edb/ref 17592186264828} :answer-field/id #uuid "fa24fc58-2f6f-5d99-b351-2b877dfd4f87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265691}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "d4515a57-a635-54cc-a4da-7d85b8cf6876" :question/math-academy-id "q-130426" :question/problem "Find the second derivative of $f(t)=2\\operatorname{ln}⁡t\\,i-(\\operatorname{cos}⁡t+{e}^{t})\\,j+(2{t}^{3}+t-2)\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{ln}⁡t)\\,i-\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+{e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}+t-2)\\,k \\\\  & =\\frac{2}{t}\\,i-(-\\operatorname{sin}⁡t+{e}^{t})\\,j+(6{t}^{2}+1)\\,k \\\\  & =\\frac{2}{t}\\,i+(\\operatorname{sin}⁡t-{e}^{t})\\,j+(6{t}^{2}+1)\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{2}{t}\\right)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-{e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}+1)\\,k \\\\  & =-\\frac{2}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+12t\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186302126 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10034851-c3dc-522b-8e9f-79f761ae3ac3" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -6 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186300025} {:answer/id #uuid "1c89099a-8f65-59d6-8b86-51ea17597482" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 0 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186300093} {:answer/id #uuid "242c2c26-7f42-5937-8408-83c0348f5952" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -6 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186300134} {:answer/id #uuid "ee280677-ec46-52c6-b8f5-07d9602a81a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -6 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186301141} {:answer/id #uuid "f5863708-92db-5e15-8111-3db5d040aab9" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ 6 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186301171}] :answer-field/correct {:answer/id #uuid "ee280677-ec46-52c6-b8f5-07d9602a81a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -6 \\\\ 0\\end{bmatrix}" :db/id #edb/ref 17592186301141} :answer-field/id #uuid "0029851a-804f-51dd-856f-df69f962be7f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301230}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "591da14b-a9b8-58b9-a31f-95d22b99b938" :question/math-academy-id "q-32280" :question/problem "Find ${f}^{″}(\\pi )$ if $$\n\\displaystyle f(t)=\\begin{bmatrix}\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ 3{\\cos }^{2}⁡t \\\\ 4\\operatorname{sin}⁡t-5\\end{bmatrix}.\n$$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n{f}^{′}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(3{\\cos }^{2}⁡t)\\,\\,\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t-5)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -6\\operatorname{cos}⁡t\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{bmatrix}\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(-6\\operatorname{cos}⁡t\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)\\,\\end{bmatrix}=\\begin{bmatrix}-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ -6({\\cos }^{2}⁡t-{\\sin }^{2}⁡t) \\\\ -4\\operatorname{sin}⁡t\\end{bmatrix}=\\begin{bmatrix}-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -6\\operatorname{cos}⁡2t \\\\ -4\\operatorname{sin}⁡t\\end{bmatrix}\n$$\n\nFinally, we find ${f}^{″}(\\pi )$ by substituting $t=\\pi $ into the above:\n\n$$\n{f}^{″}(\\pi )=\\begin{bmatrix}-\\operatorname{cos}⁡\\pi -\\operatorname{sin}⁡\\pi  \\\\ -6\\operatorname{cos}⁡2\\pi  \\\\ -4\\operatorname{sin}⁡\\pi \\end{bmatrix}=\\begin{bmatrix}-(-1)-0 \\\\ -6\\cdot 1 \\\\ -4\\cdot 0\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -6 \\\\ 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186302156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c08e415-1582-566c-abca-01f98220019c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\operatorname{cos}⁡2s,12{s}^{2},0⟩" :db/id #edb/ref 17592186299994} {:answer/id #uuid "1cacc6ae-6c30-5cef-af1f-99f16fec5988" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-2\\operatorname{sin}⁡2s,4{s}^{3}+10,0⟩" :db/id #edb/ref 17592186300094} {:answer/id #uuid "4abdc31a-a0b8-56f6-9d09-328a2a8e3d07" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4\\operatorname{cos}⁡2s,12{s}^{2},0⟩" :db/id #edb/ref 17592186300345} {:answer/id #uuid "8dff7ef7-14fa-540d-9f26-e1581a5dc18f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4\\operatorname{cos}⁡2s,12{s}^{2},1⟩" :db/id #edb/ref 17592186300682} {:answer/id #uuid "99c862a2-d0f6-5006-9548-657c2bc2cea8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\operatorname{sin}⁡2s,4{s}^{3}+10,0⟩" :db/id #edb/ref 17592186300733}] :answer-field/correct {:answer/id #uuid "4abdc31a-a0b8-56f6-9d09-328a2a8e3d07" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-4\\operatorname{cos}⁡2s,12{s}^{2},0⟩" :db/id #edb/ref 17592186300345} :answer-field/id #uuid "6cf36595-db23-5508-b678-6942ff38d4fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301565}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f8539782-987e-5a96-b997-ff8444e6065b" :question/math-academy-id "q-32416" :question/problem "Calculate the second derivative of  $f(s)=⟨\\operatorname{cos}⁡2s,\\,{s}^{4}+10s,\\,55⟩$ with respect to $s.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡2s),\\,\\frac{\\text{d}}{\\text{d}s}({s}^{4}+10s),\\,\\frac{\\text{d}}{\\text{d}s}(55)⟩ \\\\  & =⟨-2\\operatorname{sin}⁡2s,\\,4{s}^{3}+10,\\,0⟩\\end{aligned}\n$$\n\nNext, we calculate the second derivative by differentiating ${f}^{′}(s)$:\n\n$$\n\\begin{aligned}{f}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-2\\operatorname{sin}⁡2s),\\,\\frac{\\text{d}}{\\text{d}s}(4{s}^{3}+10),\\,\\frac{\\text{d}}{\\text{d}s}(0)⟩ \\\\  & =⟨-4\\operatorname{cos}⁡2s,\\,12{s}^{2},\\,0⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186336018 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eaccab4-2cae-5b80-a84d-f58b15187490" :answer/type {:db/ident :answer.type/math} :answer/value "9{e}^{3t+2}\\,i-\\operatorname{cos}⁡2t\\,j+20{t}^{3}\\,k" :db/id #edb/ref 17592186333118} {:answer/id #uuid "1fe1a48f-39fe-5866-8b0f-0b0c3442e060" :answer/type {:db/ident :answer.type/math} :answer/value "9{e}^{3t+2}\\,i-4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k" :db/id #edb/ref 17592186333275} {:answer/id #uuid "26c536d0-7f2c-5c6a-b82f-46e230efe2a6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3t+2}\\,i-\\operatorname{cos}⁡2t\\,j+20{t}^{3}\\,k" :db/id #edb/ref 17592186333345} {:answer/id #uuid "2802eed7-ccf8-5308-bf51-b22cd717e899" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3t+2}\\,i+4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k" :db/id #edb/ref 17592186333356} {:answer/id #uuid "f6003820-1338-53dd-a7de-4c0d29d032b8" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{3t+2}\\,i+\\operatorname{cos}⁡2t\\,j-10{t}^{3}\\,k" :db/id #edb/ref 17592186335145}] :answer-field/correct {:answer/id #uuid "1fe1a48f-39fe-5866-8b0f-0b0c3442e060" :answer/type {:db/ident :answer.type/math} :answer/value "9{e}^{3t+2}\\,i-4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k" :db/id #edb/ref 17592186333275} :answer-field/id #uuid "47cd2290-b7e8-5a7d-938d-b059560a66e0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335375}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f2ea5cad-9652-5b52-b71f-3a11074a333d" :question/math-academy-id "q-69907" :question/problem "Find the second derivative of $f(t)={e}^{3t+2}\\,i+\\operatorname{cos}⁡2t\\,j-2{t}^{5}\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{3t+2})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(-2{t}^{5})\\,k \\\\  & =3{e}^{3t+2}\\,i+(-2\\cdot \\operatorname{sin}⁡2t)\\,j+(-2\\cdot 5{t}^{4})\\,k \\\\  & =3{e}^{3t+2}\\,i-2\\operatorname{sin}⁡2t\\,j-10{t}^{4}\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(3{e}^{3t+2})\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{sin}⁡2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(-10{t}^{4})\\,k \\\\  & =3(3{e}^{3t+2})\\,i-2(2\\operatorname{cos}⁡2t)\\,j-10(4{t}^{3})\\,k \\\\  & =9{e}^{3t+2}\\,i-4\\operatorname{cos}⁡2t\\,j-40{t}^{3}\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186387346 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c4f3a69-92f8-593d-a5d5-10afbe7a1536" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡(t)-{\\sec }^{2}⁡(2t)),\\,\\frac{1}{{t}^{2}}⟩" :db/id #edb/ref 17592186387348} {:answer/id #uuid "59ff0643-9755-5655-9e7a-c6a58bcc6ea4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡t+{\\sec }^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩" :db/id #edb/ref 17592186387349} {:answer/id #uuid "d4dbbc4f-0523-5ed7-98a6-d97ffa12a2b1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4{\\sec }^{2}⁡(2t)(\\operatorname{tan}⁡(2t)-\\operatorname{sec}⁡(2t)),\\,-\\frac{3}{t}⟩" :db/id #edb/ref 17592186387350} {:answer/id #uuid "bc3ab8fd-29e4-55fd-ab10-4110925db260" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡(2t)+{\\sec }^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩" :db/id #edb/ref 17592186387351} {:answer/id #uuid "83af61a3-eb17-5200-919f-b41643d2b386" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡(2t)+\\operatorname{sec}⁡(2t)),\\,\\frac{1}{{t}^{3}}⟩" :db/id #edb/ref 17592186387352}] :answer-field/correct {:answer/id #uuid "bc3ab8fd-29e4-55fd-ab10-4110925db260" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡(2t)+{\\sec }^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩" :db/id #edb/ref 17592186387351} :answer-field/id #uuid "21580012-8c25-5076-900b-45885ca5b66a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387347}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "b02b05ec-3c49-5ba7-a525-3faa0181bc7c" :question/math-academy-id "q-123184" :question/problem "Given that $r(t)=⟨\\operatorname{sec}⁡(2t),\\,\\operatorname{ln}⁡({t}^{3})⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\operatorname{sec}⁡(2t),$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2\\operatorname{tan}⁡(2t)\\operatorname{sec}⁡(2t) \\\\ {x}^{″}(t) & =4\\operatorname{sec}⁡(2t){\\tan }^{2}⁡(2t)+4\\operatorname{sec}⁡(2t){\\sec }^{2}⁡(2t) \\\\  & =4\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡(2t)+{\\sec }^{2}⁡(2t)).\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{ln}⁡({t}^{3}),$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{3}{t} \\\\ {y}^{″}(t) & =-\\frac{3}{{t}^{2}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨4\\operatorname{sec}⁡(2t)({\\tan }^{2}⁡(2t)+{\\sec }^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186392729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe19103f-5f99-576d-a025-053904208525" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({\\tan }^{2}⁡t+{\\sec }^{2}⁡t)⟩" :db/id #edb/ref 17592186392731} {:answer/id #uuid "e01882fe-f747-5560-b961-3aeaa74d08c2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{\\sec }^{2}⁡t\\operatorname{tan}⁡t,\\,{\\sec }^{3}⁡t⟩" :db/id #edb/ref 17592186392732} {:answer/id #uuid "574da43a-a87f-5e11-8117-2e74261fac00" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{\\sec }^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({\\tan }^{2}⁡t+{\\sec }^{2}⁡t)⟩" :db/id #edb/ref 17592186392733} {:answer/id #uuid "8eccfb9d-3d94-5276-98aa-105bb31f0184" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{\\sec }^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({\\tan }^{2}⁡t+\\operatorname{sec}⁡t)⟩" :db/id #edb/ref 17592186392734} {:answer/id #uuid "13350f1d-caa5-59e1-8249-6fc0fdc305b0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,{\\sec }^{3}⁡t\\operatorname{tan}⁡t⟩" :db/id #edb/ref 17592186392735}] :answer-field/correct {:answer/id #uuid "574da43a-a87f-5e11-8117-2e74261fac00" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2{\\sec }^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({\\tan }^{2}⁡t+{\\sec }^{2}⁡t)⟩" :db/id #edb/ref 17592186392733} :answer-field/id #uuid "30603a02-99ff-59c6-861c-ce870828f5cd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392730}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "7fd0a18c-43f2-5761-ad4b-96e6a87257fc" :question/math-academy-id "q-50467" :question/problem "Given that $r(t)=⟨\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\operatorname{tan}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & ={\\sec }^{2}⁡t \\\\ {x}^{″}(t) & =2{\\sec }^{2}⁡t\\operatorname{tan}⁡t.\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{sec}⁡t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\operatorname{sec}⁡t\\operatorname{tan}⁡t \\\\ {y}^{″}(t) & =\\operatorname{sec}⁡t{\\tan }^{2}⁡t+{\\sec }^{3}⁡t \\\\  & =\\operatorname{sec}⁡t({\\tan }^{2}⁡t+{\\sec }^{2}⁡t).\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨2{\\sec }^{2}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({\\tan }^{2}⁡t+{\\sec }^{2}⁡t)⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186393751 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86cea4ef-71ce-511e-9d8b-a1f718158b3e" :answer/type {:db/ident :answer.type/math} :answer/value "(t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\,i-(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393753} {:answer/id #uuid "3673b7a2-f1d8-5266-9125-906d7dbc0f9e" :answer/type {:db/ident :answer.type/math} :answer/value "(2\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i-(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(t+1)\\,k" :db/id #edb/ref 17592186393754} {:answer/id #uuid "8003fc75-b7ed-5c00-8921-9a01cf27a9f6" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i-(2\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(t+1)\\,k" :db/id #edb/ref 17592186393755} {:answer/id #uuid "43982434-8c3d-5fcd-a8cb-9c0931e39dd8" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393756} {:answer/id #uuid "48238325-c06e-58dc-a7bf-c70f8fc3d3db" :answer/type {:db/ident :answer.type/math} :answer/value "(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393757}] :answer-field/correct {:answer/id #uuid "43982434-8c3d-5fcd-a8cb-9c0931e39dd8" :answer/type {:db/ident :answer.type/math} :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/id #edb/ref 17592186393756} :answer-field/id #uuid "1e182f36-1f51-5195-9065-734439498a28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393752}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "19d44fb9-0b26-5bc1-af60-efeec2020695" :question/math-academy-id "q-77683" :question/problem "Find the second derivative of $$\n\\displaystyle f(t)=t\\operatorname{cos}⁡t\\,i+t\\operatorname{sin}⁡t\\,j+(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k\n$$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+(3\\cdot \\frac{1}{3}{t}^{2}-2\\cdot \\frac{1}{2}t)\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+({t}^{2}-t)\\,k\\end{aligned}\n$$\n\n \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,k \\\\  & =(-\\operatorname{sin}⁡t-\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k \\\\  & =-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186403794 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ca92dd1-d3b1-5bbd-87a9-9caff1cfe1bc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{4\\sqrt{{t}^{3}}},\\,\\frac{-3}{(t+1)^{2}}⟩" :db/id #edb/ref 17592186403796} {:answer/id #uuid "eaf9ebfc-20a2-5603-a31d-0792c9a03622" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{-3}{t+1},\\,-\\frac{1}{2\\sqrt{t}}⟩" :db/id #edb/ref 17592186403797} {:answer/id #uuid "7ecb4957-d24d-59f5-9347-136d1afee955" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{3}{(t+1)^{2}},\\,\\frac{1}{\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403798} {:answer/id #uuid "b63167ac-944e-5401-84cf-f23779d4b9e5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{-3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403799} {:answer/id #uuid "ccf003b1-60be-57fa-890c-82515b81d733" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{-1}{t+1},\\,-\\frac{1}{2\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403800}] :answer-field/correct {:answer/id #uuid "b63167ac-944e-5401-84cf-f23779d4b9e5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{-3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩" :db/id #edb/ref 17592186403799} :answer-field/id #uuid "3ab71387-0269-5f3f-bf93-cd7cf7c2275e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403795}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "40db78a3-8e98-5f3c-8f6f-0721104f563f" :question/math-academy-id "q-75034" :question/problem "Given that $r(t)=⟨3\\operatorname{ln}⁡(t+1),\\,\\sqrt{t}⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=3\\operatorname{ln}⁡(t+1),$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{3}{t+1} \\\\ {x}^{″}(t) & =-\\frac{3}{(t+1)^{2}}.\\end{aligned}\n$$\n\n- For $y(t)=\\sqrt{t},$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{1}{2\\sqrt{t}} \\\\ {y}^{″}(t) & =-\\frac{1}{4\\sqrt{{t}^{3}}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨-\\frac{3}{(t+1)^{2}},\\,-\\frac{1}{4\\sqrt{{t}^{3}}}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501141 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61d7cc13-045d-5dfc-8f21-557e9035974d" :answer/type {:db/ident :answer.type/math} :answer/value "-60t^4" :db/id #edb/ref 17592186500669}] :answer-field/correct {:answer/id #uuid "61d7cc13-045d-5dfc-8f21-557e9035974d" :answer/type {:db/ident :answer.type/math} :answer/value "-60t^4" :db/id #edb/ref 17592186500669} :answer-field/id #uuid "9181ccb7-fad9-5675-90e4-730835fd6807" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501083} {:answer-field/choices [{:answer/id #uuid "51e9395c-263f-51bd-b6a4-d472df228bdf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{t^{3/2}}" :db/id #edb/ref 17592186500636}] :answer-field/correct {:answer/id #uuid "51e9395c-263f-51bd-b6a4-d472df228bdf" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{t^{3/2}}" :db/id #edb/ref 17592186500636} :answer-field/id #uuid "bd2548aa-0d72-568a-936f-6eb2f6da4f5c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501107} {:answer-field/choices [{:answer/id #uuid "3300ef54-fdde-5f40-809c-0c4bab2d0166" :answer/type {:db/ident :answer.type/math} :answer/value "4e^{1-2t}" :db/id #edb/ref 17592186500576}] :answer-field/correct {:answer/id #uuid "3300ef54-fdde-5f40-809c-0c4bab2d0166" :answer/type {:db/ident :answer.type/math} :answer/value "4e^{1-2t}" :db/id #edb/ref 17592186500576} :answer-field/id #uuid "d0de4306-091e-529b-ae8c-530f65ea903f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501115}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "0cc15b80-72fe-59a5-9238-583abab2565e" :question/math-academy-id "q-350802" :question/problem "Determine ${f}^{″}(t)$ given that $f(t)=\\begin{bmatrix}4\\sqrt{t} \\\\ {e}^{1-2t} \\\\ -2{t}^{6}\\end{bmatrix}.$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| ${f}^{″}(t)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n{f}^{′}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(4\\sqrt{t}) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{1-2t})\\,\\,\\,\\, \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{t}^{6})\\end{bmatrix}=\\begin{bmatrix}\\frac{2}{\\sqrt{t}} \\\\ -2{e}^{1-2t} \\\\ -12{t}^{5}\\end{bmatrix}\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{2}{\\sqrt{t}}\\right) \\\\ \\frac{\\text{d}}{\\text{d}t}(-2{e}^{1-2t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(-12{t}^{5})\\,\\end{bmatrix}=\\begin{bmatrix}-\\frac{1}{{t}^{3/2}} \\\\ 4{e}^{1-2t} \\\\ -60{t}^{4}\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186501194 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1655080f-c794-53f9-9762-71446a1428b5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨24{t}^{3},\\,16{t}^{2}⟩" :db/id #edb/ref 17592186500517} {:answer/id #uuid "4aa25a3e-ad0c-5469-b35f-f6b463e1bf29" :answer/type {:db/ident :answer.type/math} :answer/value "⟨12t,\\,-12{t}^{3}⟩" :db/id #edb/ref 17592186500617} {:answer/id #uuid "4de7e70a-49ca-5324-89ae-72cc0b88d9c0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨24{t}^{2},\\,36t⟩" :db/id #edb/ref 17592186500626} {:answer/id #uuid "6ec79135-6f74-58f5-be5f-857da38fc279" :answer/type {:db/ident :answer.type/math} :answer/value "⟨24t,\\,-36{t}^{2}⟩" :db/id #edb/ref 17592186500693} {:answer/id #uuid "ce607db8-3e5f-5aee-be46-05f404a110b9" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-36t,\\,24{t}^{2}⟩" :db/id #edb/ref 17592186500908}] :answer-field/correct {:answer/id #uuid "6ec79135-6f74-58f5-be5f-857da38fc279" :answer/type {:db/ident :answer.type/math} :answer/value "⟨24t,\\,-36{t}^{2}⟩" :db/id #edb/ref 17592186500693} :answer-field/id #uuid "ad618895-a9b2-5479-91a2-b7889155fabf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501096}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "8b01d0b7-5c1a-5382-b422-a24594a7e8ee" :question/math-academy-id "q-75033" :question/problem "Given that $r(t)=⟨4{t}^{3}-t,\\,7t-3{t}^{4}⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=4{t}^{3}-t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =12{t}^{2}-1 \\\\ {x}^{″}(t) & =24t.\\end{aligned}\n$$\n\n- For $y(t)=7t-3{t}^{4},$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =7-12{t}^{3} \\\\ {y}^{″}(t) & =-36{t}^{2}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨24t,\\,-36{t}^{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501238 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e24d1ecc-57dc-5c33-9cba-5e409dfc2302" :answer/type {:db/ident :answer.type/math} :answer/value "4e^{5-2t}" :db/id #edb/ref 17592186500946}] :answer-field/correct {:answer/id #uuid "e24d1ecc-57dc-5c33-9cba-5e409dfc2302" :answer/type {:db/ident :answer.type/math} :answer/value "4e^{5-2t}" :db/id #edb/ref 17592186500946} :answer-field/id #uuid "3d407d0c-c934-570f-b937-ad8a2b67c857" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501040} {:answer-field/choices [{:answer/id #uuid "1d3bbfad-8739-5e99-a5ae-7f7260792e57" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sin(3t)" :db/id #edb/ref 17592186500527}] :answer-field/correct {:answer/id #uuid "1d3bbfad-8739-5e99-a5ae-7f7260792e57" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sin(3t)" :db/id #edb/ref 17592186500527} :answer-field/id #uuid "71566823-fdda-54f3-9974-db4a29c8e963" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501067} {:answer-field/choices [{:answer/id #uuid "4529e2b9-bc07-531e-b375-674552dad476" :answer/type {:db/ident :answer.type/math} :answer/value "36t^2" :db/id #edb/ref 17592186500604}] :answer-field/correct {:answer/id #uuid "4529e2b9-bc07-531e-b375-674552dad476" :answer/type {:db/ident :answer.type/math} :answer/value "36t^2" :db/id #edb/ref 17592186500604} :answer-field/id #uuid "9b71e92c-1904-5ed5-a643-9f6e96a86f83" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186501087}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "eb16de2e-8644-5cec-a8df-6022a66874f3" :question/math-academy-id "q-347967" :question/problem "Determine ${f}^{″}(t)$ given that $f(t)={e}^{5-2t}\\,i+\\operatorname{sin}⁡(3t)\\,j-3{t}^{4}\\,k.$\n\n${f}^{″}(t)=$\n{{field-1}}\n$i\\,\\,-$\n{{field-2}}\n$j\\,\\,-$\n{{field-3}}\n$k$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{5-2t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))\\,j+\\frac{\\text{d}}{\\text{d}t}(-3{t}^{4})\\,k \\\\  & =-2{e}^{5-2t}\\,i+3\\operatorname{cos}⁡(3t)\\,j-12{t}^{3}\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(-2{e}^{5-2t})\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡(3t))\\,j+\\frac{\\text{d}}{\\text{d}t}(-12{t}^{3})\\,k \\\\  & =-2(-2{e}^{5-2t})\\,i+3(-3\\operatorname{sin}⁡(3t))\\,j-12(3{t}^{2})\\,k \\\\  & =4{e}^{5-2t}\\,i-9\\operatorname{sin}⁡(3t)\\,j-36{t}^{2}\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186501242 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9fceca-75ad-51bc-ae92-c08f9fc2becc" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{cos}⁡s,\\operatorname{sin}⁡s,4\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500524} {:answer/id #uuid "21637f5f-66fc-5d10-9eec-a98e25102b49" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-4\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500537} {:answer/id #uuid "5e8fe481-3298-52af-9b2d-8bc1094ba831" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2}\\operatorname{cos}⁡s,\\sqrt{2}\\operatorname{sin}⁡s,16\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500662} {:answer/id #uuid "85151a70-250f-5968-b519-91999091ac9c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-16\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500743} {:answer/id #uuid "c51b200a-ecff-5cd9-93e9-8afa94661d25" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\sqrt{2}\\operatorname{sin}⁡s,-\\sqrt{2}\\operatorname{cos}⁡s,-16\\operatorname{sin}⁡4s⟩" :db/id #edb/ref 17592186500883}] :answer-field/correct {:answer/id #uuid "85151a70-250f-5968-b519-91999091ac9c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-16\\operatorname{cos}⁡4s⟩" :db/id #edb/ref 17592186500743} :answer-field/id #uuid "4afb8b57-1fee-58f6-a694-2fa66ad992b0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186501047}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "f415e47a-854d-5840-b197-b8e66cc67e42" :question/math-academy-id "q-34722" :question/problem "Calculate the second derivative of  $f(s)=⟨\\sqrt{2}\\operatorname{cos}⁡s,\\sqrt{2}\\operatorname{sin}⁡s,\\operatorname{cos}⁡4s⟩$ with respect to $s.$" :question/worked-solution "First, we find the derivative of $f(s)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{cos}⁡s),\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{sin}⁡s),\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡4s)⟩ \\\\  & =⟨-\\sqrt{2}\\operatorname{sin}⁡s,\\sqrt{2}\\operatorname{cos}⁡s,-4\\operatorname{sin}⁡4s⟩\\end{aligned}\n$$\n\nNext, we calculate ${f}^{″}(s)$ by differentiating ${f}^{′}(s):$\n\n$$\n\\begin{aligned}{f}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-\\sqrt{2}\\operatorname{sin}⁡s),\\frac{\\text{d}}{\\text{d}s}(\\sqrt{2}\\operatorname{cos}⁡s),\\frac{\\text{d}}{\\text{d}s}(-4\\operatorname{sin}⁡4s)⟩ \\\\  & =⟨-\\sqrt{2}\\operatorname{cos}⁡s,-\\sqrt{2}\\operatorname{sin}⁡s,-16\\operatorname{cos}⁡4s⟩\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03b8afc6-ea44-541a-b97e-a936ff8c99d7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{(t-1)^{3}},\\,4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578281} {:answer/id #uuid "66a781b9-2748-56b4-b93f-c6603e12f076" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{(t-1)^{3}},\\,-2\\operatorname{cos}⁡(2t)⟩" :db/id #edb/ref 17592186578439} {:answer/id #uuid "8c57e040-49f2-52ad-bf8e-45654daef059" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{4}{(t-1)^{3}},\\,-4\\operatorname{cos}⁡(2t)⟩" :db/id #edb/ref 17592186578496} {:answer/id #uuid "d7db80ab-c211-5f31-845b-80b7a2580341" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\frac{2}{(t-1)^{3}},\\,2\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578609} {:answer/id #uuid "e11e0b7b-beea-5c09-bba4-1337cdf8b10b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{(t-1)^{3}},\\,-4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578633}] :answer-field/correct {:answer/id #uuid "e11e0b7b-beea-5c09-bba4-1337cdf8b10b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\frac{2}{(t-1)^{3}},\\,-4\\operatorname{sin}⁡(2t)⟩" :db/id #edb/ref 17592186578633} :answer-field/id #uuid "b8a7f531-97df-5ed0-907d-ba5ccf90a0bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578761}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "2867142f-2689-574f-a1df-8a99e1f1a37d" :question/math-academy-id "q-75066" :question/problem "Given that $r(t)=⟨\\frac{t}{t-1},\\,\\operatorname{sin}⁡(2t)⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\frac{t}{t-1},$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =\\frac{(t-1)-t}{(t-1)^{2}} \\\\  & =-\\frac{1}{(t-1)^{2}} \\\\ {x}^{″}(t) & =\\frac{2}{(t-1)^{3}}.\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{sin}⁡(2t),$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =2\\operatorname{cos}⁡(2t) \\\\ {y}^{″}(t) & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨\\frac{2}{(t-1)^{3}},\\,-4\\operatorname{sin}⁡(2t)⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cff7d77-5fd6-5b92-828d-f1490eff650f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578322}] :answer-field/correct {:answer/id #uuid "1cff7d77-5fd6-5b92-828d-f1490eff650f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186578322} :answer-field/id #uuid "383a8fab-5ba5-511e-a8c4-7a142b497010" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578708} {:answer-field/choices [{:answer/id #uuid "0a2a6db0-2985-5544-b4ec-59327c956e12" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186578291}] :answer-field/correct {:answer/id #uuid "0a2a6db0-2985-5544-b4ec-59327c956e12" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186578291} :answer-field/id #uuid "4fdfa56f-91d8-5e4d-b130-c7dc28f9e72e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578717} {:answer-field/choices [{:answer/id #uuid "093244fd-4c63-50cd-850b-97c557d274b1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186578287}] :answer-field/correct {:answer/id #uuid "093244fd-4c63-50cd-850b-97c557d274b1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186578287} :answer-field/id #uuid "d5974644-849b-5336-b3f7-497b9ff06936" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186578770}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "849f67ec-584b-579e-b282-5dcc897ae7f2" :question/math-academy-id "q-347965" :question/problem "Given that $$\n\\displaystyle f(t)=\\begin{bmatrix}\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ 5{\\cos }^{2}⁡t \\\\ 2\\operatorname{sin}⁡t+7\\end{bmatrix},\n$$ what is ${f}^{″}(0)?$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| ${f}^{″}(0)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component:\n\n$$\n{f}^{′}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(5{\\cos }^{2}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t+7)\\end{bmatrix}=\\begin{bmatrix}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ -10\\operatorname{cos}⁡t\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{bmatrix}=\\begin{bmatrix}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ -5\\operatorname{sin}⁡2t \\\\ 2\\operatorname{cos}⁡t\\end{bmatrix}\n$$\n\nNext, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n{f}^{″}(t)=\\begin{bmatrix}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(-5\\operatorname{sin}⁡2t) \\\\ \\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,\\end{bmatrix}=\\begin{bmatrix}-\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ -10\\operatorname{cos}⁡2t \\\\ -2\\operatorname{sin}⁡t\\end{bmatrix}\n$$\n\nFinally, we find ${f}^{″}(0)$ by substituting $t=0$ into the above:\n\n$$\n{f}^{″}(0)=\\begin{bmatrix}-\\operatorname{sin}⁡0+\\operatorname{cos}⁡0 \\\\ -10\\operatorname{cos}⁡(2\\cdot 0) \\\\ -2\\operatorname{sin}⁡0\\end{bmatrix}=\\begin{bmatrix}-0+1 \\\\ -10(1) \\\\ -2(0)\\end{bmatrix}=\\begin{bmatrix}1 \\\\ -10 \\\\ 0\\end{bmatrix}\n$$"} {:db/id #edb/ref 17592186578863 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f6fadd-ae9f-5e90-b147-d1ab164cfb22" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2-\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t⟩" :db/id #edb/ref 17592186578316} {:answer/id #uuid "49793528-9813-5c18-b55d-1b7395390483" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,-t\\operatorname{sin}⁡t⟩" :db/id #edb/ref 17592186578390} {:answer/id #uuid "9caba74e-305c-573c-853e-e980f2ffde93" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,2+t\\operatorname{cos}⁡t⟩" :db/id #edb/ref 17592186578521} {:answer/id #uuid "dbf2603e-a212-58f5-bd13-80d3848a5dfa" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-\\operatorname{cos}⁡t,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩" :db/id #edb/ref 17592186578622} {:answer/id #uuid "f5ea43d2-5bdc-5146-badd-c074f110c2cd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2+\\operatorname{cos}⁡t,\\,\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t⟩" :db/id #edb/ref 17592186578665}] :answer-field/correct {:answer/id #uuid "18f6fadd-ae9f-5e90-b147-d1ab164cfb22" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2-\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t⟩" :db/id #edb/ref 17592186578316} :answer-field/id #uuid "473ca721-38d4-51a4-9abf-b7e30141d53d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578713}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "bde50ff5-6ad8-5c6a-a55c-0b7ef55d1ab4" :question/math-academy-id "q-75032" :question/problem "Given that $r(t)=⟨{t}^{2}+\\operatorname{cos}⁡t,\\,t\\operatorname{sin}⁡(t)⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)={t}^{2}+\\operatorname{cos}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2t-\\operatorname{sin}⁡t \\\\ {x}^{″}(t) & =2-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\n- For $y(t)=t\\operatorname{sin}⁡t,$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t \\\\ {y}^{″}(t) & =\\operatorname{cos}⁡t+\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t \\\\  & =2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨2-\\operatorname{cos}⁡t,\\,2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186578867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fe695a9-1891-5c31-9719-6edb991311bb" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,i-(\\operatorname{sin}⁡t-2)\\,j+30t\\,k" :db/id #edb/ref 17592186578349} {:answer/id #uuid "30ca5c24-9302-56a6-b42c-0d91f25f10cc" :answer/type {:db/ident :answer.type/math} :answer/value "12t\\,i+(2-\\operatorname{cos}⁡t)\\,j+30t\\,k" :db/id #edb/ref 17592186578350} {:answer/id #uuid "775aeaea-8313-5c98-8733-e0cda9e195bc" :answer/type {:db/ident :answer.type/math} :answer/value "12t\\,i+(\\operatorname{sin}⁡t-2)\\,j+30t\\,k" :db/id #edb/ref 17592186578460} {:answer/id #uuid "9f187852-4bdd-5676-9c08-390a5c630eea" :answer/type {:db/ident :answer.type/math} :answer/value "12t\\,i+(\\operatorname{cos}⁡t-2)\\,j+30t\\,k" :db/id #edb/ref 17592186578522} {:answer/id #uuid "d94291d3-7892-5106-a150-92a3206b67fc" :answer/type {:db/ident :answer.type/math} :answer/value "12t\\,i+(\\operatorname{cos}⁡t-2)\\,j+15t\\,k" :db/id #edb/ref 17592186578612}] :answer-field/correct {:answer/id #uuid "9f187852-4bdd-5676-9c08-390a5c630eea" :answer/type {:db/ident :answer.type/math} :answer/value "12t\\,i+(\\operatorname{cos}⁡t-2)\\,j+30t\\,k" :db/id #edb/ref 17592186578522} :answer-field/id #uuid "10d36146-2a46-5865-a27a-2ca5e640aeef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186578689}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "cd618069-3aff-50c7-a924-e65b3520d5d7" :question/math-academy-id "q-32278" :question/problem "Find the second derivative of $f(t)=2{t}^{3}\\,i-(\\operatorname{cos}⁡t+{t}^{2})\\,j+(5{t}^{3}+\\sqrt{5}t-2\\sqrt{5})\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})\\,i-\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+{t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(5{t}^{3}+\\sqrt{5}t-2\\sqrt{5})\\,k \\\\  & =6{t}^{2}\\,i-(-\\operatorname{sin}⁡t+2t)\\,j+(15{t}^{2}+\\sqrt{5})\\,k \\\\  & =6{t}^{2}\\,i+(\\operatorname{sin}⁡t-2t)\\,j+(15{t}^{2}+\\sqrt{5})\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(15{t}^{2}+\\sqrt{5})\\,k \\\\  & =12t\\,i+(\\operatorname{cos}⁡t-2)\\,j+30t\\,k\\end{aligned}\n$$"} {:db/id #edb/ref 17592186707802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e09ae513-703d-558d-bb0d-fc9623cb30f3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4t^{3/2}}" :db/id #edb/ref 17592186707815}] :answer-field/correct {:answer/id #uuid "e09ae513-703d-558d-bb0d-fc9623cb30f3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4t^{3/2}}" :db/id #edb/ref 17592186707815} :answer-field/id #uuid "62312279-18c2-5373-82f7-69c96578a7af" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186707803} {:answer-field/choices [{:answer/id #uuid "25f6d81b-1ff1-5bd5-a7ed-2e867f5bdf97" :answer/type {:db/ident :answer.type/math} :answer/value "-12t^2" :db/id #edb/ref 17592186707801}] :answer-field/correct {:answer/id #uuid "25f6d81b-1ff1-5bd5-a7ed-2e867f5bdf97" :answer/type {:db/ident :answer.type/math} :answer/value "-12t^2" :db/id #edb/ref 17592186707801} :answer-field/id #uuid "6e7b0d90-af9d-5944-9593-6ced818d79a4" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186707805} {:answer-field/choices [{:answer/id #uuid "e4fd9a21-8077-5584-a037-a7663cde3a39" :answer/type {:db/ident :answer.type/math} :answer/value "9e^{2-3t}" :db/id #edb/ref 17592186707816}] :answer-field/correct {:answer/id #uuid "e4fd9a21-8077-5584-a037-a7663cde3a39" :answer/type {:db/ident :answer.type/math} :answer/value "9e^{2-3t}" :db/id #edb/ref 17592186707816} :answer-field/id #uuid "95ceaff7-c1b0-536c-a629-4a3350a1f0b5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186707807}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "5e28e5f7-bae6-5e32-9f7e-3a01ec9a055d" :question/problem "Determine $\\mathbf f''(t)$ for $t>0$, given that\n\n$$\n\\mathbf f(t)=\\begin{bmatrix}3\\sqrt{t} \\\\ e^{2-3t} \\\\ -t^4\\end{bmatrix}.\n$$\n\nEnter the three components in order.\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $\\mathbf f''(t)=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "First differentiate each component. Rewrite $3\\sqrt{t}$ as $3t^{1/2}$ and use the chain rule for the exponential.\n\n$$\n\\mathbf f'(t)=\\begin{bmatrix}\\frac{3}{2}t^{-1/2} \\\\ -3e^{2-3t} \\\\ -4t^3\\end{bmatrix}.\n$$\n\nDifferentiate again. For the first component, $(\\frac{3}{2}t^{-1/2})'= -\\frac{3}{4}t^{-3/2}$. The exponential gains another factor of $-3$, so its coefficient is $(-3)(-3)=9$. Also, $(-4t^3)'=-12t^2$. Therefore\n\n$$\n\\mathbf f''(t)=\\begin{bmatrix}-\\frac{3}{4t^{3/2}} \\\\ 9e^{2-3t} \\\\ -12t^2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186707813 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0200dbc4-fefc-5bb7-9b38-6de3a5690480" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle 6t^2,\\,2\\rangle" :db/id #edb/ref 17592186707798} {:answer/id #uuid "a1cecbf9-da36-56f7-bc56-d305a5f23658" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle 2,\\,6t\\rangle" :db/id #edb/ref 17592186707809} {:answer/id #uuid "a32d71f9-2df6-504e-a00a-815210a04fef" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle 6t,\\,2t\\rangle" :db/id #edb/ref 17592186707810} {:answer/id #uuid "ae2d0ecc-16da-5246-9db0-5360d5e4b684" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle 6t,\\,2\\rangle" :db/id #edb/ref 17592186707811} {:answer/id #uuid "c396a724-f878-5c8f-8f85-df33e49dfd16" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle 3t^2,\\,2t\\rangle" :db/id #edb/ref 17592186707814}] :answer-field/correct {:answer/id #uuid "ae2d0ecc-16da-5246-9db0-5360d5e4b684" :answer/type {:db/ident :answer.type/math} :answer/value "\\langle 6t,\\,2\\rangle" :db/id #edb/ref 17592186707811} :answer-field/id #uuid "215fca6a-033b-5239-ba6d-fd77f3ad5864" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186707800}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c37cd66a-58c6-5ea2-9ce6-e2807ffda959" :question/problem "Given that $\\mathbf r(t)=\\langle t^3,\\,t^2\\rangle$, find $\\mathbf r^{\\prime\\prime}(t)$." :question/worked-solution "Differentiate each component twice, keeping the components in their original order.\n\nFor $x(t)=t^3$,\n\n$$\n\\begin{aligned}\nx'(t)&=3t^2 \\\\\nx''(t)&=6t.\n\\end{aligned}\n$$\n\nFor $y(t)=t^2$,\n\n$$\n\\begin{aligned}\ny'(t)&=2t \\\\\ny''(t)&=2.\n\\end{aligned}\n$$\n\nThus\n\n$$\n\\mathbf r''(t)=\\langle x''(t),\\,y''(t)\\rangle=\\langle 6t,\\,2\\rangle.\n$$"} {:db/id #edb/ref 17592186707818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19282ccb-5539-5409-ace5-4c0b3bcc9350" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\langle \\frac{2t}{t^2+1},\\,-2\\sin(2t)\\right\\rangle" :db/id #edb/ref 17592186707799} {:answer/id #uuid "6438c01d-599f-53a2-8f04-9c56980371a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\langle \\frac{2-2t^2}{(t^2+1)^2},\\,-4\\cos(2t)\\right\\rangle" :db/id #edb/ref 17592186707804} {:answer/id #uuid "8423f6d3-5840-576f-b1d4-76942b2548bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\langle \\frac{2}{t^2+1},\\,-4\\cos(2t)\\right\\rangle" :db/id #edb/ref 17592186707806} {:answer/id #uuid "979d26d1-26d6-5e10-a002-dbc898192291" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\langle \\frac{2-2t^2}{(t^2+1)^2},\\,-2\\cos(2t)\\right\\rangle" :db/id #edb/ref 17592186707808} {:answer/id #uuid "baad97a9-9018-52bc-af1e-1e941f9481f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\langle \\frac{2+6t^2}{(t^2+1)^2},\\,-4\\cos(2t)\\right\\rangle" :db/id #edb/ref 17592186707812}] :answer-field/correct {:answer/id #uuid "6438c01d-599f-53a2-8f04-9c56980371a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\left\\langle \\frac{2-2t^2}{(t^2+1)^2},\\,-4\\cos(2t)\\right\\rangle" :db/id #edb/ref 17592186707804} :answer-field/id #uuid "f0f18f51-7e73-5cd2-bc97-8cb6c4614430" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186707817}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "f7ffb31e-bc99-55e3-a7e7-6b2320bc83b8" :question/problem "Given that $\\mathbf r(t)=\\langle \\ln(t^2+1),\\,\\cos(2t)\\rangle$, find $\\mathbf r^{\\prime\\prime}(t)$." :question/worked-solution "Differentiate each component twice.\n\nFor $x(t)=\\ln(t^2+1)$, the chain rule gives $x'(t)=\\frac{2t}{t^2+1}$. Apply the quotient rule to this first derivative:\n\n$$\n\\begin{aligned}\nx''(t)&=\\frac{2(t^2+1)-(2t)(2t)}{(t^2+1)^2} \\\\\n&=\\frac{2-2t^2}{(t^2+1)^2}.\n\\end{aligned}\n$$\n\nFor $y(t)=\\cos(2t)$, apply the chain rule at both stages:\n\n$$\n\\begin{aligned}\ny'(t)&=-2\\sin(2t) \\\\\ny''(t)&=-4\\cos(2t).\n\\end{aligned}\n$$\n\nReassemble the components in their original order:\n\n$$\n\\mathbf r''(t)=\\left\\langle \\frac{2-2t^2}{(t^2+1)^2},\\,-4\\cos(2t)\\right\\rangle.\n$$"} {:db/id #edb/ref 17592186708129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153e16c4-226e-5d84-8649-727b422f0fd0" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e^{- 3 t}" :db/id #edb/ref 17592186708114}] :answer-field/correct {:answer/id #uuid "153e16c4-226e-5d84-8649-727b422f0fd0" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e^{- 3 t}" :db/id #edb/ref 17592186708114} :answer-field/id #uuid "3eb67ae4-6d94-5044-9b93-af54cc16949c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708122} {:answer-field/choices [{:answer/id #uuid "835a104d-4ffb-5d97-9a8a-0b0ba13b2ba0" :answer/type {:db/ident :answer.type/math} :answer/value "12 t^{2}" :db/id #edb/ref 17592186708135}] :answer-field/correct {:answer/id #uuid "835a104d-4ffb-5d97-9a8a-0b0ba13b2ba0" :answer/type {:db/ident :answer.type/math} :answer/value "12 t^{2}" :db/id #edb/ref 17592186708135} :answer-field/id #uuid "532e0f88-a3a9-5e62-a584-c352892dc86b" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708124} {:answer-field/choices [{:answer/id #uuid "79a4260a-ddfd-57fd-a7bb-792d781e69ac" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{4 t^{\\frac{3}{2}}}" :db/id #edb/ref 17592186708130}] :answer-field/correct {:answer/id #uuid "79a4260a-ddfd-57fd-a7bb-792d781e69ac" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{1}{4 t^{\\frac{3}{2}}}" :db/id #edb/ref 17592186708130} :answer-field/id #uuid "fd675164-e325-5bd3-82cc-3cb851b9e09a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708147}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "69861cf3-a26d-5c69-a23d-6ebd735c9fe7" :question/problem "Given that\n\n$$\n\\mathbf r(t)=\\begin{bmatrix}\\sqrt{t} \\\\ - e^{- 3 t} \\\\ t^{4}\\end{bmatrix}.\n$$\n\nFind $\\mathbf r^{\\prime\\prime}(t)$ for $t>0$.\n\nEnter the components in their original order.\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$\\mathbf r''(t)=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td></tr>\n<tr><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Differentiate each component twice, keeping the original component order.\n\nFor $x(t)=\\sqrt{t}$. Rewrite $\\sqrt{t}=1t^{1/2}$ and apply the power rule twice.\n\nAfter the second power rule, $- \\frac{1}{4}t^{-3/2}=- \\frac{1}{4 t^{\\frac{3}{2}}}$.\n\n$$\n\\begin{aligned}\nx'(t)&=\\frac{1}{2 \\sqrt{t}} \\\\ x''(t)&=- \\frac{1}{4 t^{\\frac{3}{2}}}.\n\\end{aligned}\n$$\n\nFor $y(t)=- e^{- 3 t}$. Use the same inner argument at both stages; each differentiation contributes a factor of $-3$.\n\n$$\n\\begin{aligned}\ny'(t)&=3 e^{- 3 t} \\\\ y''(t)&=- 9 e^{- 3 t}.\n\\end{aligned}\n$$\n\nFor $z(t)=t^{4}$. Apply the power rule at both stages.\n\n$$\n\\begin{aligned}\nz'(t)&=4 t^{3} \\\\ z''(t)&=12 t^{2}.\n\\end{aligned}\n$$\n\nReassemble the components:\n\n$$\n\\mathbf r''(t)=\\begin{bmatrix}- \\frac{1}{4 t^{\\frac{3}{2}}} \\\\ - 9 e^{- 3 t} \\\\ 12 t^{2}\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186708133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30af1b7a-d8f6-53d0-996e-e156ec3850cb" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{4 t^{\\frac{3}{2}}}" :db/id #edb/ref 17592186708119}] :answer-field/correct {:answer/id #uuid "30af1b7a-d8f6-53d0-996e-e156ec3850cb" :answer/type {:db/ident :answer.type/math} :answer/value "- \\frac{3}{4 t^{\\frac{3}{2}}}" :db/id #edb/ref 17592186708119} :answer-field/id #uuid "1d012636-6b84-5908-ade7-c3cc6086bafd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708116} {:answer-field/choices [{:answer/id #uuid "653f6722-7f41-551e-8d4d-b0b0b1cde551" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e^{- 3 t - 2}" :db/id #edb/ref 17592186708128}] :answer-field/correct {:answer/id #uuid "653f6722-7f41-551e-8d4d-b0b0b1cde551" :answer/type {:db/ident :answer.type/math} :answer/value "- 9 e^{- 3 t - 2}" :db/id #edb/ref 17592186708128} :answer-field/id #uuid "643cd847-2a63-50c0-a7d3-342cafe00145" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186708127} {:answer-field/choices [{:answer/id #uuid "8227b9c2-6490-55f4-921f-5d1ccb6b4205" :answer/type {:db/ident :answer.type/math} :answer/value "36 t^{2}" :db/id #edb/ref 17592186708134}] :answer-field/correct {:answer/id #uuid "8227b9c2-6490-55f4-921f-5d1ccb6b4205" :answer/type {:db/ident :answer.type/math} :answer/value "36 t^{2}" :db/id #edb/ref 17592186708134} :answer-fie