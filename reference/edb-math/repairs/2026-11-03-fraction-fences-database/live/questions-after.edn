#{[{:db/id #edb/ref 17592186055397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adc1a519-0634-5110-8964-325bd9682ba4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2} + 3c" :db/id #edb/ref 17592186053620} {:answer/id #uuid "255680fb-7005-5796-a9aa-ef3c1c6ac87c" :answer/type {:db/ident :answer.type/math} :answer/value "3 + \\frac{1}{2}c" :db/id #edb/ref 17592186053621} {:answer/id #uuid "3b6197aa-0925-5df9-b392-919bfa879af5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2} + 3c" :db/id #edb/ref 17592186053622} {:answer/id #uuid "3e4df2f0-7d7d-54c2-a4d9-914d9e48d860" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2} - 3c" :db/id #edb/ref 17592186053623} {:answer/id #uuid "705741b4-843c-5134-8140-b1661cd84cb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2} - 3c" :db/id #edb/ref 17592186053624}] :answer-field/id #uuid "5b5ee7cd-cc09-5e08-8298-5f770a80ce1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186053619}] :question/id #uuid "281a7ccb-8efd-5d66-a6be-21d2a02d105b" :question/math-academy-id "q-57028" :question/problem "Expand $- \\left(\\frac{1}{2} + 3c\\right)$."}] [{:db/id #edb/ref 17592186060047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c52df7a-329a-513d-ba90-59439fdf20c3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨45, 0, 1⟩" :db/id #edb/ref 17592186056641} {:answer/id #uuid "9fe22398-ad1d-5641-9ca1-2d178280b598" :answer/type {:db/ident :answer.type/math} :answer/value "⟨45, 1, 1⟩" :db/id #edb/ref 17592186056642} {:answer/id #uuid "22d1b2c3-1252-5258-a581-4139af6aa2b7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨9,-1, 1⟩" :db/id #edb/ref 17592186056643} {:answer/id #uuid "281c2db9-0585-56df-8397-d9d5d0c07e0b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨45,-1,-1⟩" :db/id #edb/ref 17592186056644} {:answer/id #uuid "626cdb03-c38d-59fb-ae90-c0a438b0b03c" :answer/type {:db/ident :answer.type/math} :answer/value "⟨ - 9,-1,-1⟩" :db/id #edb/ref 17592186056645}] :answer-field/correct {:answer/id #uuid "281c2db9-0585-56df-8397-d9d5d0c07e0b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨45,-1,-1⟩" :db/id #edb/ref 17592186056644} :answer-field/id #uuid "6955e160-edc6-5daf-b539-aec04e8f2cc3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186056640}] :question/id #uuid "eee40076-098f-5267-94c9-3c8be76fb995" :question/math-academy-id "q-1408" :question/problem "Let $\\mathbf{u}=\\left\\langle \\frac{1}{3},9,6\\right\\rangle $ and $\\mathbf{v}=⟨0,-3,3⟩$. Find $\\mathbf{u}\\times \\mathbf{v}$." :question/worked-solution "The source asks for the cross product. Expanding its determinant gives\n$$\\mathbf u\\times\\mathbf v=\\left\\langle9(3)-6(-3),\\ 6(0)-\\frac13(3),\\ \\frac13(-3)-9(0)\\right\\rangle=\\langle45,-1,-1\\rangle.$$"}] [{:db/id #edb/ref 17592186064600 :question/answer-fields [{:answer-field/id #uuid "bda53f6e-0e99-5e05-bf87-e436c3199bca" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061698} {:answer-field/id #uuid "5ad3d1fa-bd03-5ca2-b152-fd86a8b0c34c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186061699}] :question/id #uuid "f03cf08f-4483-54f6-9afa-7d17685e8152" :question/math-academy-id "q-217026" :question/problem "$(3x)^{2}\\left(x^{3} - \\frac{1}{5}x\\right) =$ {{field-1}} $x^{5} -$\n{{field-2}}"}] [{:db/id #edb/ref 17592186064858 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3541e9d4-b110-5c63-a736-7fc7f4d31791" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186330422} {:answer/id #uuid "86df8515-e1e9-50e5-8ffa-c0f477c898b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331153} {:answer/id #uuid "9dec32d8-d9c0-5660-8378-5288983a6ac9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331364} {:answer/id #uuid "a3922fe0-a979-577b-8dba-fd55ff68e732" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186331416} {:answer/id #uuid "f1373522-1826-5a96-a8aa-2b1480b28e0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{tan}⁡x+C" :db/id #edb/ref 17592186332069}] :answer-field/correct {:answer/id #uuid "86df8515-e1e9-50e5-8ffa-c0f477c898b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186331153} :answer-field/id #uuid "dc984231-74ce-5ee3-a0d9-26f2e71c9fc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332589}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "c589cab7-d081-524b-ae47-ab787d74dcb4" :question/math-academy-id "q-49273" :question/problem "$$\n\\displaystyle \\int \\frac{{\\cos }^{3}⁡x+{\\cot }^{2}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x=\n$$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{\\cos }^{3}⁡x+{\\cot }^{2}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{\\cos }^{2}⁡x}({\\cos }^{3}⁡x+{\\cot }^{2}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${\\cot }^{2}⁡x=\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{\\cos }^{2}⁡x}\\left({\\cos }^{3}⁡x+\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x}\\right)\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{\\cos }^{3}⁡x+{\\cot }^{2}⁡x}{{\\cos }^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{\\cos }^{2}⁡x}\\left({\\cos }^{3}⁡x+\\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x}\\right)\\text{d}x \\\\  & =\\int \\left(\\frac{1}{{\\cos }^{2}⁡x}\\cdot {\\cos }^{3}⁡x+\\frac{1}{{\\cos }^{2}⁡x}\\cdot \\frac{{\\cos }^{2}⁡x}{{\\sin }^{2}⁡x}\\right)\\text{d}x \\\\  & =\\int \\left(\\operatorname{cos}⁡x+\\frac{1}{{\\sin }^{2}⁡x}\\right)\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+{\\csc }^{2}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb84938b-4e85-52ad-bd29-6493a85415ad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2x^{2}}(\\ln (x) + \\ln (x) + 2) + C" :db/id #edb/ref 17592186066743} {:answer/id #uuid "4c631bea-6fbf-571f-a223-68b06cf6efd5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2x^{2}}(2\\ln (x) + 2x + 1) + C" :db/id #edb/ref 17592186066744} {:answer/id #uuid "7121bd29-f8e0-5390-af8a-61942f7f1d9b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4x^{2}}(2\\ln^{2} (x) + 2\\ln (x) + 1) + C" :db/id #edb/ref 17592186066745} {:answer/id #uuid "783b8264-0c1f-5b95-a989-efc67d9cee3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4x^{2}}(2\\ln^{2} (x) - 2x\\ln (x) - 1) + C" :db/id #edb/ref 17592186066746} {:answer/id #uuid "7c175ddc-5a30-554c-a959-fd0d2ab57583" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln (x))/(4x^{2})(4\\ln (x) + 2x - 1) + C" :db/id #edb/ref 17592186066747}] :answer-field/id #uuid "524578ee-6e6e-58c9-9a66-2e748e474ad2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066742} {:answer-field/choices [{:answer/id #uuid "f93bb800-dc42-5668-91b5-920a928aa57c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2{x}^{2}}(\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(x)+2)+C" :db/id #edb/ref 17592186377322} {:answer/id #uuid "11358afa-0e6f-5a2c-ac00-bac5ee0d2324" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4{x}^{2}}(2{\\ln }^{2}⁡(x)-2x\\operatorname{ln}⁡(x)-1)+C" :db/id #edb/ref 17592186377323} {:answer/id #uuid "8700b438-ddae-5f4f-9b2f-8578bc8c450e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2{x}^{2}}(2\\operatorname{ln}⁡(x)+2x+1)+C" :db/id #edb/ref 17592186377324} {:answer/id #uuid "06a6cfac-e003-591c-93ea-d82ce1a4d5dd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{2}}(2{\\ln }^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C" :db/id #edb/ref 17592186377325} {:answer/id #uuid "3f20800c-2e9e-54bc-b586-4b25aa538d0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(x)}{4{x}^{2}}(4\\operatorname{ln}⁡(x)+2x-1)+C" :db/id #edb/ref 17592186377326}] :answer-field/correct {:answer/id #uuid "06a6cfac-e003-591c-93ea-d82ce1a4d5dd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{2}}(2{\\ln }^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C" :db/id #edb/ref 17592186377325} :answer-field/id #uuid "4f4ccc09-3130-56b3-a2bb-f52755a0fe14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377321}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "6c2769dd-8773-5498-9a3b-b2fed58e581f" :question/math-academy-id "q-3400" :question/problem "$$\n\\displaystyle \\int \\frac{{\\ln }^{2}⁡x}{{x}^{3}}\\,\\text{d}x=\n$$" :question/worked-solution "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={\\ln }^{2}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(x)}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\ln }^{2}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({\\ln }^{2}⁡(x))\\left(-\\frac{1}{2{x}^{2}}\\right)-\\int \\left(-\\frac{1}{2{x}^{2}}\\right)\\left(\\frac{2\\operatorname{ln}⁡(x)}{x}\\right)\\,\\text{d}x \\\\  & =-\\frac{{\\ln }^{2}⁡(x)}{2{x}^{2}}+\\int \\frac{\\operatorname{ln}⁡(x)}{{x}^{3}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $$\n\\displaystyle \\int \\frac{\\operatorname{ln}⁡(x)}{{x}^{3}}\\text{d}x.\n$$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡(x))\\left(-\\frac{1}{2{x}^{2}}\\right)-\\int \\left(-\\frac{1}{2{x}^{2}}\\right)\\left(\\frac{1}{x}\\right)\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}+\\frac{1}{2}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int \\frac{{\\ln }^{2}⁡x}{{x}^{3}}\\,\\text{d}x & =-\\frac{{\\ln }^{2}⁡(x)}{2{x}^{2}}+\\left(-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C\\right) \\\\  & =-\\frac{{\\ln }^{2}⁡(x)}{2{x}^{2}}-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C \\\\  & =-\\frac{1}{4{x}^{2}}(2{\\ln }^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186079054 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0038b49d-54d4-5f28-9928-56ebe6cc31d6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186329953} {:answer/id #uuid "35b8ada7-942f-5085-a2fc-ca6886826ab4" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186330428} {:answer/id #uuid "9025b587-da68-591c-8038-d5fe66c4bfb4" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186331232} {:answer/id #uuid "ab10e72f-2d0e-5aa5-82bb-df6c8a32014a" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186331466} {:answer/id #uuid "d7f6f9ea-4a0a-505e-9254-326e9200a558" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186331865}] :answer-field/correct {:answer/id #uuid "d7f6f9ea-4a0a-505e-9254-326e9200a558" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186331865} :answer-field/id #uuid "8e7594bb-3d43-58eb-8b64-bf18a77c7b49" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332451}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "f7ff75a6-3ae3-540e-8971-b7a98178dcaa" :question/math-academy-id "q-5046" :question/problem "The function $f(x)$ is defined below. What is the value of \n$$\n\\displaystyle {\\int }_{-3}^{4}f(x)\\,\\text{d}x?\n$$\n\n$$\nf(x)=\\begin{cases}4, & x<0 \\\\ -x+4, & x\\ge 0\\end{cases}\n$$" :question/requires-calculator true :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-3}^{4}f(x)\\,\\text{d}x & ={\\int }_{-3}^{0}4\\,\\text{d}x+{\\int }_{0}^{4}(-x+4)\\,\\text{d}x \\\\  & =4x{|}_{-3}^{0}+\\left(-\\frac{{x}^{2}}{2}+4x\\right){|}_{0}^{4} \\\\  & =[4(0)-4(-3)]+\\left[-\\frac{(4)^{2}}{2}+4(4)+\\frac{(0)^{2}}{2}-4(0)\\right] \\\\  & =[0+12]+[-8+16+0-0] \\\\  & =12+8 \\\\  & =20.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083496 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5844549f-b897-5a58-bf08-acfbe8efa2a6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186251276} {:answer/id #uuid "7667e2f4-ee83-5482-af7c-d2bdd84fc202" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251526} {:answer/id #uuid "a218e653-d88f-5440-be12-f0ad6810fe89" :answer/type {:db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186251949} {:answer/id #uuid "c7cc8e9f-2139-5926-aacc-b95747012288" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186252321} {:answer/id #uuid "f79ecc31-c3ea-5c7d-ae4d-ea007b99bc9d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252718}] :answer-field/correct {:answer/id #uuid "7667e2f4-ee83-5482-af7c-d2bdd84fc202" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186251526} :answer-field/id #uuid "9f22f9c0-c715-5c9f-b358-40ff3aa9350f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253084}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "8d988115-5b28-5cc4-948a-8ebc728e32c9" :question/math-academy-id "q-118619" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "First, we substitute $u=1+{x}^{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=1+{x}^{2}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{x}{{(1+{x}^{2})}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\lim_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\lim_{a\\to \\infty }[-{u}^{-1}]_{1}^{a} \\\\  & =-\\frac{1}{2}\\lim_{a\\to \\infty }{\\left[\\frac{1}{u}\\right]}_{1}^{a} \\\\  & =-\\frac{1}{2}\\lim_{a\\to \\infty }\\left(\\frac{1}{a}-1\\right) \\\\  & =-\\frac{1}{2}(0-1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96ee0952-7f7e-5111-afa5-1ef89748e96e" :answer/type {:db/ident :answer.type/math} :answer/value "v(3) = ⟨48, 0⟩" :db/id #edb/ref 17592186081978} {:answer/id #uuid "e50cfa82-f56c-57c0-b083-503aadd10305" :answer/type {:db/ident :answer.type/math} :answer/value "v(3) = ⟨36, 45⟩" :db/id #edb/ref 17592186081979} {:answer/id #uuid "efe920f9-2126-5377-834c-933025f706e1" :answer/type {:db/ident :answer.type/math} :answer/value "v(3) = ⟨48, 45⟩" :db/id #edb/ref 17592186081980} {:answer/id #uuid "0f001a21-d9f7-5ad7-823b-874885f16d04" :answer/type {:db/ident :answer.type/math} :answer/value "v(3) = ⟨72, 45⟩" :db/id #edb/ref 17592186081981} {:answer/id #uuid "40820cde-bed6-51ea-bb27-36f3020ca93b" :answer/type {:db/ident :answer.type/math} :answer/value "v(3) = ⟨72, 0⟩" :db/id #edb/ref 17592186081982}] :answer-field/id #uuid "6162c83f-4ae4-5cc5-b0ea-9e9aeb72bf4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186081977} {:answer-field/choices [{:answer/id #uuid "f0e85798-7c47-5981-b9f8-90078a0a95e8" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨36,\\,45⟩" :db/id #edb/ref 17592186373078} {:answer/id #uuid "6f429ead-fcb9-5683-acc1-238d318a3f5f" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨48,\\,0⟩" :db/id #edb/ref 17592186373079} {:answer/id #uuid "8a8e69ca-5508-566c-882c-46efd2707784" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨48,\\,45⟩" :db/id #edb/ref 17592186373080} {:answer/id #uuid "e209cea2-5088-5213-9fc1-c40a3bd68f18" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨72,\\,45⟩" :db/id #edb/ref 17592186373081} {:answer/id #uuid "56cdba81-0b81-524b-b603-c19cd25a17a0" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨72,\\,0⟩" :db/id #edb/ref 17592186373082}] :answer-field/correct {:answer/id #uuid "6f429ead-fcb9-5683-acc1-238d318a3f5f" :answer/type {:db/ident :answer.type/math} :answer/value "v(3)=⟨48,\\,0⟩" :db/id #edb/ref 17592186373079} :answer-field/id #uuid "6a935459-2512-56ab-87ad-d87ad12f7445" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373077}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "adaed8cd-e3ac-52d9-8b99-508210c20f63" :question/math-academy-id "q-6388" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨8{t}^{2},\\,45⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=3.$" :question/worked-solution "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =\\left\\langle \\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}\\right\\rangle  \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}(8{t}^{2}),\\frac{\\text{d}}{\\text{d}t}(45)\\right\\rangle  \\\\  & =⟨16t,0⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=3,$ we substitute into the above:\n\n$$\n\\begin{aligned}v(3) & =⟨16(3),\\,0⟩ \\\\  & =⟨48,\\,0⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f240a0-6f5b-5c52-a231-d9c802a1fe46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186351614} {:answer/id #uuid "5f1acb7a-a724-5169-9f60-4e36f2d43040" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186352411} {:answer/id #uuid "91789e7a-62c5-57cb-b923-ae9254a5a428" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186352826} {:answer/id #uuid "e2851343-1d07-5126-a23f-8e4fe2da7574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186353537} {:answer/id #uuid "f11d718b-11d8-5bf5-a07c-f54bf97f76a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186353666}] :answer-field/correct {:answer/id #uuid "04f240a0-6f5b-5c52-a231-d9c802a1fe46" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186351614} :answer-field/id #uuid "93ebf0c7-1af4-53ff-966f-1b5f16a4f22f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354079}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "234add05-86f7-55a3-868f-ff02274a16b2" :question/math-academy-id "q-85665" :question/problem "Compute the arc length of $y=\\frac{1}{2}({e}^{x}+{e}^{-x})$ for $x\\in [0,\\operatorname{ln}⁡2].$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{1}{2}({e}^{x}+{e}^{-x}),$ $a=0,$ and $b=\\operatorname{ln}⁡2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{1}{2}({e}^{x}-{e}^{-x})\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$\n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{\\left[\\frac{1}{2}({e}^{x}-{e}^{-x})\\right]}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{4}({e}^{2x}-2+{e}^{-2x})} \\\\  & =\\sqrt{\\frac{1}{4}({e}^{2x}+2+{e}^{-2x})} \\\\  & =\\sqrt{\\frac{1}{4}{({e}^{x}+{e}^{-x})}^{2}} \\\\  & =\\frac{1}{2}({e}^{x}+{e}^{-x})\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{2}({e}^{x}+{e}^{-x})$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\operatorname{ln}⁡2}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\operatorname{ln}⁡2}({e}^{x}+{e}^{-x})\\,\\text{d}x \\\\  & =\\frac{1}{2}({e}^{x}-{e}^{-x}){|}_{0}^{\\operatorname{ln}⁡2} \\\\  & =\\frac{1}{2}[({e}^{\\operatorname{ln}⁡2}-{e}^{-\\operatorname{ln}⁡2})-({e}^{0}-{e}^{-0})] \\\\  & =\\frac{1}{2}\\left[2-\\frac{1}{2}-0\\right] \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088285 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5d55fb2-4cab-5d84-9d91-7523b2d9cc66" :answer/type {:db/ident :answer.type/math} :answer/value "a = \\left\\langle \\frac{t - 1}{2}, 3t^{2}\\right\\rangle " :db/id #edb/ref 17592186086365} {:answer/id #uuid "d1f57a29-6cde-52d3-8d71-3aa96bd03eed" :answer/type {:db/ident :answer.type/math} :answer/value "a = \\left\\langle \\frac{t - 1}{2}, 6t^{2}\\right\\rangle " :db/id #edb/ref 17592186086366} {:answer/id #uuid "f6832422-6da0-5ed3-a7e7-1e9a29995785" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨t, 3t^{2}⟩" :db/id #edb/ref 17592186086367} {:answer/id #uuid "10854812-654d-5c3a-84c4-062b08fc41d6" :answer/type {:db/ident :answer.type/math} :answer/value "a = \\left\\langle t - \\frac{1}{2}, 6t^{2}\\right\\rangle " :db/id #edb/ref 17592186086368} {:answer/id #uuid "195a5c48-30d5-59ec-8451-32e6e045b654" :answer/type {:db/ident :answer.type/math} :answer/value "a = ⟨t, 6t^{2}⟩" :db/id #edb/ref 17592186086369}] :answer-field/id #uuid "71813afe-3557-5c7a-81fc-5a2ff1f007bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086364}] :question/id #uuid "25b96514-7751-51a9-b8e9-1c0cef408552" :question/math-academy-id "q-7157" :question/problem "The velocity vector $v = ⟨u, v⟩$ of a particle $P$ at time $t$ is given by\n$v = \\left\\langle \\frac{t^{2} - t}{2}, 2t^{3} - 3\\right\\rangle $.\nCalculate the acceleration vector $a$."}] [{:db/id #edb/ref 17592186092635 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "079aa6af-b919-5a9d-bde2-0d086f2c30d1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5π}{6}" :db/id #edb/ref 17592186090094} {:answer/id #uuid "2091197b-fa3d-5c32-8eb9-3ff54bbdd155" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2π}{3}" :db/id #edb/ref 17592186090095} {:answer/id #uuid "243cb7cc-0a54-5d54-aa32-0c58fe0f2059" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2π}{3}" :db/id #edb/ref 17592186090096} {:answer/id #uuid "6f4e4297-1f60-50f5-903d-3c0a8b527300" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3π}{4}" :db/id #edb/ref 17592186090097} {:answer/id #uuid "73725570-2d3c-563d-9aec-70b0fda090b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5π}{6}" :db/id #edb/ref 17592186090098}] :answer-field/id #uuid "88b84e5a-b4d5-5274-8842-679dfff9deff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186090093}] :question/id #uuid "248f47c2-8404-5967-9241-5f548534d460" :question/math-academy-id "q-21089" :question/problem "Given that $x_{1}$ and $x_{2}$ are the solutions to $\\sin \\left(x - \\frac{π}{6}\\right) =-\\frac{1}{2}$ for $- π \\le x < π$, what is the value of $x_{1} + x_{2}$?\n\n> A calculator is required to answer this question." :question/requires-calculator true}] [{:db/id #edb/ref 17592186097255 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45cc9080-d5de-52fd-b1d5-f6bac9b3144a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186327545} {:answer/id #uuid "88177515-b706-5b8d-9e57-fe4ca5ffdb6c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328105} {:answer/id #uuid "cb990cf6-7116-5da8-a17d-0aed6aa02c7b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186328718} {:answer/id #uuid "cce6785f-e03e-5476-9ca9-90161251f71c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186328734} {:answer/id #uuid "cfc1fed9-5f9f-5634-9248-1be3cac24df7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186328761}] :answer-field/correct {:answer/id #uuid "cce6785f-e03e-5476-9ca9-90161251f71c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186328734} :answer-field/id #uuid "e9a12cbc-2747-55da-a0e3-44579d212709" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329588}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e52c46bb-53c6-584c-86da-75775eac460d" :question/math-academy-id "q-48806" :question/problem "Given that $r=\\operatorname{cos}⁡\\theta $ for $\\theta =\\theta (t),$ and that $\\frac{\\text{d}r}{\\text{d}t}=\\sqrt{2}$ at the point where $\\theta =\\frac{\\pi }{4},$ find $\\frac{\\text{d}\\theta }{\\text{d}t}.$" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}r & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{\\text{d}}{\\text{d}t}(r) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡\\theta ) \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{cos}⁡\\theta ) \\\\ \\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot (-\\operatorname{sin}⁡\\theta ).\\end{aligned}\n$$\n\nNow we can substitute the given information $\\frac{\\text{d}r}{\\text{d}t}=\\sqrt{2}$ and $\\theta =\\frac{\\pi }{4},$ and solve for $\\frac{\\text{d}\\theta }{\\text{d}t}.$ We get\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}t} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\operatorname{cos}⁡\\theta  \\\\ \\sqrt{2} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\left(-\\operatorname{sin}⁡\\left(\\frac{\\pi }{4}\\right)\\right) \\\\ \\sqrt{2} & =\\frac{\\text{d}\\theta }{\\text{d}t}\\cdot \\left(-\\frac{\\sqrt{2}}{2}\\right) \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =-\\sqrt{2}\\cdot \\frac{2}{\\sqrt{2}} \\\\ \\frac{\\text{d}\\theta }{\\text{d}t} & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097352 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "307c7cf1-5fd8-539a-baf5-43476b1da200" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460191} {:answer/id #uuid "ed3fcb48-ebc2-5e8e-9078-7e2580db3f5c" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460192}] :answer-field/correct {:answer/id #uuid "307c7cf1-5fd8-539a-baf5-43476b1da200" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460191} :answer-field/id #uuid "6d23e71b-bbc8-5c5f-97bb-805a4e9c6d29" :answer-field/key "${a}_{n}=\\frac{n-1}{{n}^{3}+1}$ for $n\\ge 1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460962} {:answer-field/choices [{:answer/id #uuid "0219cde5-ece9-54b0-8ffc-80286a692f29" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460193} {:answer/id #uuid "3e370409-0e5a-5645-b7a2-56152ac74d7a" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460194}] :answer-field/correct {:answer/id #uuid "0219cde5-ece9-54b0-8ffc-80286a692f29" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460193} :answer-field/id #uuid "f9ee3097-d4bf-50d0-95bf-6225fd4600c1" :answer-field/key "${a}_{n}=\\frac{2}{{n}^{3}}$ for $n\\ge 1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460963} {:answer-field/choices [{:answer/id #uuid "6136d6ba-9486-55c8-88e7-53fdc6a2739a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186460195} {:answer/id #uuid "300f1985-42e9-5c1f-9981-13270d98f964" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460196}] :answer-field/correct {:answer/id #uuid "300f1985-42e9-5c1f-9981-13270d98f964" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186460196} :answer-field/id #uuid "f264bd79-c732-55ec-8b29-50df8e1604b3" :answer-field/key "${a}_{n}=\\frac{{n}^{3}+3}{3{n}^{2}-n}$ for $n\\ge 1$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186460964} {:answer-field/choices [{:answer/id #uuid "3995f471-7081-5e24-b892-3be083f26d0d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668104} {:answer/id #uuid "ebd247d0-c026-5a95-8bcc-8b6e75e784c9" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186668105}] :answer-field/correct {:answer/id #uuid "3995f471-7081-5e24-b892-3be083f26d0d" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186668104} :answer-field/id #uuid "e1fc04a1-ab5c-59d3-b9cd-bac1872719ed" :answer-field/key "None of the above" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186668329}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "42d47711-2fa8-573a-a785-99e3eb0e6a31" :question/math-academy-id "q-74055" :question/problem "Which of the following sequences diverge?\n\nSelect all that apply." :question/worked-solution "Let's analyze each sequence in turn. We need to calculate the limit of each sequence as $n$ approaches at infinity.\n\n- In sequence “${a}_{n}=\\frac{n-1}{{n}^{3}+1}$ for $n\\ge 1$”, the dominant term in the denominator is ${n}^{3},$ so we divide the numerator and the denominator by ${n}^{3}$ and get\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{a}_{n} & =\\lim_{n\\to \\infty }\\frac{n-1}{{n}^{3}+1} \\\\  & =\\lim_{n\\to \\infty }⁡\\frac{\\left(\\frac{n}{{n}^{3}}-\\frac{1}{{n}^{3}}\\right)}{\\left(\\frac{{n}^{3}}{{n}^{3}}+\\frac{1}{{n}^{3}}\\right)} \\\\  & =\\lim_{n\\to \\infty }⁡\\frac{\\left(\\frac{1}{{n}^{2}}-\\frac{1}{{n}^{3}}\\right)}{\\left(1+\\frac{1}{{n}^{3}}\\right)} \\\\  & =\\frac{0-0}{1+0} \\\\  & =0.\\end{aligned}\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence “${a}_{n}=\\frac{2}{{n}^{3}}$ for $n\\ge 1$”, the limit is\n\n$$\n\\lim_{n\\to \\infty }{a}_{n}=\\lim_{n\\to \\infty }\\frac{2}{{n}^{3}}=0.\n$$\n\nThe limit exists, so the sequence converges.\n\n- In sequence “${a}_{n}=\\frac{{n}^{3}+3}{3{n}^{2}-n}$ for $n\\ge 1$”, the dominant term in the denominator is $3{n}^{2},$ so we divide the numerator and the denominator by ${n}^{2}$ and get\n\n$$\n\\begin{aligned}\\lim_{n\\to \\infty }{a}_{n} & =\\lim_{n\\to \\infty }\\frac{{n}^{3}+3}{3{n}^{2}-n} \\\\  & =\\lim_{n\\to \\infty }\\frac{\\left(\\frac{{n}^{3}}{{n}^{2}}+\\frac{3}{{n}^{2}}\\right)}{\\left(\\frac{3{n}^{2}}{{n}^{2}}-\\frac{n}{{n}^{2}}\\right)} \\\\  & =\\lim_{n\\to \\infty }\\frac{\\left(n+\\frac{3}{{n}^{2}}\\right)}{\\left(3-\\frac{1}{n}\\right)} \\\\  & =\\lim_{n\\to \\infty }\\frac{n+0}{3-0} \\\\  & =\\infty .\\end{aligned}\n$$\n\nThe limit does not exist, so the sequence diverges.\n\nIn conclusion, sequence “${a}_{n}=\\frac{{n}^{3}+3}{3{n}^{2}-n}$ for $n\\ge 1$” diverges."}] [{:db/id #edb/ref 17592186101297 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00ad7b38-011b-5bbc-ad6f-119764a28f5c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left({e}^{4x}-\\frac{1}{4}\\right)" :db/id #edb/ref 17592186284794} {:answer/id #uuid "5cd60163-91c2-5f68-b12b-44f98e6c673c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡({e}^{4x}+5)" :db/id #edb/ref 17592186285640} {:answer/id #uuid "60978d4b-4f9a-549a-a78c-7b2ab10d8ff1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}}{4}+C\\right)" :db/id #edb/ref 17592186285674} {:answer/id #uuid "675c44fb-e5b5-5cc4-a665-61ee54152b6a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}+4{e}^{5}-1}{4}\\right)" :db/id #edb/ref 17592186285732} {:answer/id #uuid "dd44c23d-4f4e-5432-b33e-dff52c07b119" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}}{4}+{e}^{5}+\\frac{1}{4}\\right)" :db/id #edb/ref 17592186286799}] :answer-field/correct {:answer/id #uuid "675c44fb-e5b5-5cc4-a665-61ee54152b6a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}+4{e}^{5}-1}{4}\\right)" :db/id #edb/ref 17592186285732} :answer-field/id #uuid "af959d06-569d-5cc3-8e3f-fadee181c763" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287510}] :question/difficulty {:db/ident :question.difficulty/moderate} :question/id #uuid "e844aafc-6198-5e85-8b96-36f86924e412" :question/math-academy-id "q-20071" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{4x-y}$ that satisfies $y(0)=5.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{4x-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{4x}\\cdot {e}^{-y} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{4x} \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{4x}\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int {e}^{4x}\\,\\text{d}x \\\\ {e}^{y} & =\\frac{{e}^{4x}}{4}+C\\,.\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}}{4}+C\\right) \\\\ y & =\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}}{4}+C\\right)\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=5$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =5 \\\\ \\operatorname{ln}⁡\\left(\\frac{{e}^{4\\cdot 0}}{4}+C\\right) & =5 \\\\ \\operatorname{ln}⁡\\left(\\frac{1}{4}+C\\right) & =5 \\\\ \\frac{1}{4}+C & ={e}^{5} \\\\ C & =\\frac{4{e}^{5}-1}{4}\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={e}^{4x-y}$ that satisfies the condition $y(0)=5$ is\n\n$$\ny=\\operatorname{ln}⁡\\left(\\frac{{e}^{4x}+4{e}^{5}-1}{4}\\right).\n$$"}] [{:db/id #edb/ref 17592186106055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21af3edc-3323-554a-bca0-c25456bef3a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275782} {:answer/id #uuid "570dae43-0ab0-58ae-84d9-65901a7c41b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186276255} {:answer/id #uuid "900dc292-41a8-5398-9c59-94c9060331f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276780} {:answer/id #uuid "9fe329c6-b978-58eb-96d6-ef0bb8c82ee6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276918} {:answer/id #uuid "b3f3da64-a53b-5cfa-890d-f8da21171141" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277087}] :answer-field/correct {:answer/id #uuid "570dae43-0ab0-58ae-84d9-65901a7c41b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186276255} :answer-field/id #uuid "73f910f0-310b-59fc-93fc-e2425f5aa705" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277929}] :question/difficulty {:db/ident :question.difficulty/easy} :question/id #uuid "3535bc96-e0a2-5dcb-9a5f-4a6bf759302b" :question/math-academy-id "q-158437" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\left\\{\\begin{aligned}\\frac{{x}^{2}}{4}+k,\\, & 0<x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\\right.\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- $$\n\\displaystyle {\\int }_{S}f(x)\\,\\text{d}x=1\n$$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{0}^{2}\\left(\\frac{{x}^{2}}{4}+k\\right)\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\left(\\frac{{x}^{2}}{4}+k\\right)\\,\\text{d}x & ={\\left[\\frac{1}{12}{x}^{3}+kx\\right]}_{0}^{2} \\\\  & =\\left[\\frac{8}{12}+2k\\right]-[0+0] \\\\  & =\\frac{2}{3}+2k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{2}{3}+2k=1\\,⟹\\,k=\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186111356 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e99a9025-fb5a-54a5-9ab7-72135a77225a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477371} {:answer/id #uuid "31d95762-28dc-50a8-9be3-b41da2513393" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477372}] :answer-field/correct {:answer/id #uuid "e99a9025-fb5a-54a5-9ab7-72135a77225a" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477371} :answer-field/id #uuid "ebe38af3-d0d5-5d75-8290-3d1c253f0e72" :answer-field/key "$\\left(\\frac{\\pi }{6},\\frac{1}{2}\\right)$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477655} {:answer-field/choices [{:answer/id #uuid "3a190686-8589-5b4f-bc1a-09311cd52f78" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477373} {:answer/id #uuid "ab355908-fb0d-548d-91e1-477450397db4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477374}] :answer-field/correct {:answer/id #uuid "ab355908-fb0d-548d-91e1-477450397db4" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477374} :answer-field/id #uuid "020c5de8-ab36-5db9-93c8-08f5b80d9611" :answer-field/key "$\\left(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3}\\right)$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477656} {:answer-field/choices [{:answer/id #uuid "05fb94e2-3269-55ad-b4e5-f2eae77367f8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477375} {:answer/id #uuid "e76f3778-f579-5d7f-8eb5-1903f27e06d1" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477376}] :answer-field/correct {:answer/id #uuid "05fb94e2-3269-55ad-b4e5-f2eae77367f8" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477375} :answer-field/id #uuid "8c0ede3e-962d-534c-8407-ad55a5311589" :answer-field/key "$(0,2\\pi )$" :answer-field/type {:db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477657}] :question/difficulty {:db/ident :question.difficulty/hard} :question/id #uuid "183017f0-e71f-5632-89e1-4603485e8f26" :question/math-academy-id "q-65744" :question/problem "Which of the following points lies on the graph of the function $y=\\operatorname{arcsin}⁡x?$\n\nSelect all that apply." :question/worked-solution "In order for a point $(a,b)$ to lie on the graph of the function $y=\\operatorname{arcsin}⁡x,$ the following conditions must hold:\n\n- The reflected point $(b,a)$ must lie on the graph of $y=\\operatorname{sin}⁡x,$ meaning $a=\\operatorname{sin}⁡b.$\n\n- The $y$-value of the point must lie in the range of $y=\\operatorname{arcsin}⁡x,$ which is $y\\in \\left[-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right].$\n\nWith this in mind, let's check each of the points. \n\n- First, we consider the point $\\left(\\frac{\\pi }{6},\\frac{1}{2}\\right).$ We note the following:\n\n- The point $\\left(\\frac{1}{2},\\frac{\\pi }{6}\\right)$ does **not** lie on the graph of $y=\\operatorname{sin}⁡x.$  $\\,\\times $\n\nTherefore, the point $\\left(\\frac{\\pi }{6},\\frac{1}{2}\\right)$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Next, we consider the point $\\left(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3}\\right).$ We note the following:\n\n- The point $\\left(\\frac{\\pi }{3},\\frac{\\sqrt{3}}{2}\\right)$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in \\left[-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right],$ and $y=\\frac{\\pi }{3}$ lies within this range. $\\,✓$\n\nTherefore, the point $\\left(\\frac{\\sqrt{3}}{2},\\frac{\\pi }{3}\\right)$ does lie on the graph of $y=\\operatorname{arcsin}⁡x.$\n\n- Finally, we consider the point $(0,2\\pi ).$ We note the following:\n\n- The point $(2\\pi ,0)$ lies on the graph of $y=\\operatorname{sin}⁡x.\\,✓$\n\n- The range of $y=\\operatorname{arcsin}⁡x$ is $y\\in \\left[-\\frac{\\pi }{2},\\frac{\\pi }{2}\\right],$ and $y=2\\pi $ does **not** lie within this range. $\\,\\times $\n\nTherefore, the point $(0,2\\pi )$ does **not** lie on the graph of $y=\\operatorname{arcsin}⁡x.$"}] [{:db/id #edb/ref 17592186111361 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56708daa-2130-56c2-b5e5-0e10fce06ad0" :answer/type {:db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477377} {:answer/id #uuid "069f7725-2ffb-56bc-b017-8a08b698c7d5" :answer/type {:db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477378}] :answer-field/corr