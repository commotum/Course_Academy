5}\\rangle \\\\ &=\\frac{(2)(4)+(-2)(-3)}{5} \\\\ &=\\frac{14}{5}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186732624 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15582a4a-10b2-54b1-bc0e-42571aafc127" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{14}{5}" :db/id #edb/ref 17592186732607} {:answer/id #uuid "348aff3f-aeca-5c0f-a556-66e71a091233" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{2}{5}" :db/id #edb/ref 17592186732611} {:answer/id #uuid "52202ca0-2d5e-5a5f-abc2-33e6df678627" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186732614} {:answer/id #uuid "9be2be79-fac0-5a1e-b302-ee3c3715943a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{5}" :db/id #edb/ref 17592186732622} {:answer/id #uuid "b2b4fa82-930a-569e-afb2-51d7c7668fd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{25}" :db/id #edb/ref 17592186732625}] :answer-field/correct {:db/id #edb/ref 17592186732614} :answer-field/id #uuid "74302698-8baf-53b6-8020-d3595bbd8844" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732616}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a4cd994a-eef1-5909-a57a-48389cb6e58c" :question/problem "Consider the function $f(x,y)=- x^{2} + y^{2}$. What is the signed rate of change of $f$ at the point $(-1,-1)$ in the direction of the vector $\\mathbf v=\\langle 4,-3\\rangle$?" :question/worked-solution "The rate is the directional derivative $D_{\\mathbf u}f=\\nabla f\\cdot\\mathbf u$, with $\\mathbf u$ a unit vector.\n\nCompute the partial derivatives and evaluate them at the given point:\n\n$$\n\\begin{aligned}\nf_x(x,y)&=- 2 x \\\\ f_y(x,y)&=2 y \\\\ \\nabla f(-1,-1)&=\\langle 2,-2\\rangle\n\\end{aligned}\n$$\n\nNormalize the direction vector:\n\n$$\n\\begin{aligned}\n\\|\\mathbf v\\|&=\\sqrt{(4)^2+(-3)^2}=5 \\\\ \\mathbf u&