 $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x))$ and carry out the integration:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y{e}^{-2x}) & =x \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{e}^{-2x})\\text{d}x & =\\int x\\,\\text{d}x \\\\ y{e}^{-2x} & =\\frac{{x}^{2}}{2}+C \\\\ y & =\\frac{{x}^{2}{e}^{2x}}{2}+C{e}^{2x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186686880 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e4d5f2b-f338-5b67-b124-87b4ada135af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{5 x}" :db/id #edb/ref 17592186686851} {:answer/id #uuid "9654245b-5efb-56c9-9288-399b465ce8fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{- 6 x}" :db/id #edb/ref 17592186686863} {:answer/id #uuid "de5d6d00-79d9-527b-9b0c-8164cd718625" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{6 x}" :db/id #edb/ref 17592186686876} {:answer/id #uuid "fe222aea-e57f-5666-aa33-39e13e3fbf16" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3 x}" :db/id #edb/ref 17592186686886}] :answer-field/correct {:db/id #edb/ref 17592186686876} :answer-field/id #uuid "7a13a748-df6f-50f0-a978-6dc594652206" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186686857} {:answer-field/choices [{:answer/id #uuid "4fa47a06-448c-56ac-af89-590cedf4d709" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 5 x} + \\frac{x^{3} e^{- 6 x}}{2}" :db/id #edb/ref 17592186686843} {:answer/id #uuid "8ec473c6-ffa4-540f-a457-8dafe0a37cb1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 6 x} + \\frac{x^{3} e^{- 6 x}}{2}" :db/id #edb/ref 17592186686862} {:answer/id #uuid "9e7c2dfa-d9f3-5a0f-9bed-4b46cb7fb90b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 6 x} + \\frac{x^{3} e^{- 6 x}}{3}" :db/id #edb/ref 17592186686867} {:answer/id #uuid "e45befc9-cc79-593f-bf11-911b14b68ff6" :answer/type {:db/id #edb/ref 17592186045498} :answe