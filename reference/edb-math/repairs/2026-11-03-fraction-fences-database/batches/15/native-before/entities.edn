^{2} + 16}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{16}\\cdot 4=\\frac{1}{4}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-4&\\Longrightarrow u=-1\\\\x=4&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-4}^{4} \\frac{1}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{4}\\left(\\int_{-1}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{4}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{1}\\right)=\\frac{1}{4}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"} {:db/id #edb/ref 17592186683036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "950b070f-afe8-5d89-8e28-5337a676c2c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186683035}] :answer-field/correct {:db/id #edb/ref 17592186683035} :answer-field/id #uuid "3475a3fa-ea54-5adb-89d5-92c2bcc0a9f3" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683021}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "97f77f4b-3619-56ef-ada9-9d87d6d509ce" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-2}^{2} \\frac{2}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{16 - x^{2}}=4\\sqrt{1-(\\frac{x}{4})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{2}\\cdot 4=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-2&\\Longrightarrow u=- \\frac{1}{2}\\\\x=2&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-2}^{2} \\frac{2}{\\sqrt{16 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2 \\pi}{3}.\n$$"} {:db/id #edb/ref 17592186683038 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "266c1cae-3692-5924-96cb-117702847d5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\pi}{3}" :db/id #edb/ref 17592186683017}] :answer-field/correct {:db/id #edb/ref 17592186683017} :answer-field/id #uuid "80f7df34-3e6d-5955-94fe-963eee69c65a" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683032}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a3d5756b-44e6-5fa5-a82f-9cefb144862a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-1}^{1} \\frac{2}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $1\\cdot 2=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-1&\\Longrightarrow u=- \\frac{1}{2}\\\\x=1&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-1}^{1} \\frac{2}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{- \\frac{1}{2}}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(- \\frac{1}{2} \\right)}=- \\frac{\\pi}{6},\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{1}{2}}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(- \\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{2 \\pi}{3}.\n$$"} {:db/id #edb/ref 17592186683042 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "240331fe-77e6-5e07-bbd7-7c3036a7406d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{6}" :db/id #edb/ref 17592186683016}] :answer-field/correct {:db/id #edb/ref 17592186683016} :answer-field/id #uuid "0564ed71-add6-5e7d-9cef-0e7fccbf5758" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683009}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c0a31a52-2d0e-58b1-8e5c-8873975ed4b7" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{3}{2}} \\frac{1}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=3\\sqrt{1-(\\frac{x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{3}\\cdot 3=1$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{3}{2}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{3}{2}} \\frac{1}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\\\\&=\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u.\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}=\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{6}.\n$$"} {:db/id #edb/ref 17592186683043 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb93ae60-1314-5c1b-8b18-5be2bf67f2c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186683052}] :answer-field/correct {:db/id #edb/ref 17592186683052} :answer-field/id #uuid "2e7c9b3d-a38a-5b2d-8d31-027e6df341be" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683018}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c3a16373-f0d4-5113-bf47-986eb7d7132a" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{1} \\frac{3}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{2}$. Then $\\mathrm{d}u=(\\frac{1}{2})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{4 - x^{2}}=2\\sqrt{1-(\\frac{x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=2\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{2}\\cdot 2=3$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=1&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{1} \\frac{3}{\\sqrt{4 - x^{2}}}\\,\\mathrm{d}x\\\\&=3\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n3\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=3\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{2}.\n$$"} {:db/id #edb/ref 17592186683046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "562b82fb-611f-5664-a991-c0e59c08eb80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186683023}] :answer-field/correct {:db/id #edb/ref 17592186683023} :answer-field/id #uuid "f3803484-923b-5b20-a75e-e8453de7a349" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683055}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cf008381-995e-5932-b9bc-a91de5a94927" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{\\frac{3}{2}} \\frac{2}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\n\\sqrt{9 - x^{2}}=3\\sqrt{1-(\\frac{x}{3})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{2}{3}\\cdot 3=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=\\frac{3}{2}&\\Longrightarrow u=\\frac{1}{2}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{\\frac{3}{2}} \\frac{2}{\\sqrt{9 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{0}^{\\frac{1}{2}} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(0 \\right)}=0,\\quad \\arcsin{\\left(\\frac{1}{2} \\right)}=\\frac{\\pi}{6}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{0}^{\\frac{1}{2}}\\right)=2\\left(\\left(\\frac{\\pi}{6}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"} {:db/id #edb/ref 17592186683047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e290a4ec-1f1d-5c85-bd8a-e94dc7cc4306" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\pi}{8}" :db/id #edb/ref 17592186683049}] :answer-field/correct {:db/id #edb/ref 17592186683049} :answer-field/id #uuid "59bb2407-e075-51f9-af5b-d3307318152f" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683025}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d2136a2c-75f4-5393-b4ed-03d63d126a6b" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-4}^{4} \\frac{3}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{3}{16}\\cdot 4=\\frac{3}{4}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-4&\\Longrightarrow u=-1\\\\x=4&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-4}^{4} \\frac{3}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{3}{4}\\left(\\int_{-1}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(-1 \\right)}=- \\frac{\\pi}{4},\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{3}{4}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{-1}^{1}\\right)=\\frac{3}{4}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{3 \\pi}{8}.\n$$"} {:db/id #edb/ref 17592186683048 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7681548d-f47c-5759-816e-a74d22459909" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{8}" :db/id #edb/ref 17592186683031}] :answer-field/correct {:db/id #edb/ref 17592186683031} :answer-field/id #uuid "9b441eb5-bd0a-5835-b315-aadb79762777" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683037}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "df32ded5-a46c-5912-9f6c-872c8f24c708" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{4} \\frac{2}{x^{2} + 16}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{4}$. Then $\\mathrm{d}u=(\\frac{1}{4})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 16=16\\left(1+(\\frac{x}{4})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=4\\,\\mathrm{d}u$. The outside factor is $\\frac{1}{8}\\cdot 4=\\frac{1}{2}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=4&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{4} \\frac{2}{x^{2} + 16}\\,\\mathrm{d}x\\\\&=\\frac{1}{2}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{1}{2}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{1}{2}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{8}.\n$$"} {:db/id #edb/ref 17592186683051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56a5bbcb-5604-53d6-90b9-661dc62994c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{3}" :db/id #edb/ref 17592186683024}] :answer-field/correct {:db/id #edb/ref 17592186683024} :answer-field/id #uuid "1a3ae534-c2b7-5e22-a8c5-7585eedc2a70" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186683013}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ead967b2-4710-5b6a-baf1-443fc36d1a7f" :question/problem "Evaluate exactly.\n\n$$\n\\int_{0}^{3} \\frac{4}{x^{2} + 9}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/retired true :question/worked-solution "Let $u=\\frac{x}{3}$. Then $\\mathrm{d}u=(\\frac{1}{3})\\,\\mathrm{d}x$.\n\nFactor the constant in the denominator:\n\n$$\nx^{2} + 9=9\\left(1+(\\frac{x}{3})^2\\right).\n$$\n\nThe differential is $\\mathrm{d}x=3\\,\\mathrm{d}u$. The outside factor is $\\frac{4}{9}\\cdot 3=\\frac{4}{3}$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=0&\\Longrightarrow u=0\\\\x=3&\\Longrightarrow u=1\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{0}^{3} \\frac{4}{x^{2} + 9}\\,\\mathrm{d}x\\\\&=\\frac{4}{3}\\left(\\int_{0}^{1} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(0 \\right)}=0,\\quad \\arctan{\\left(1 \\right)}=\\frac{\\pi}{4}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{4}{3}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{0}^{1}\\right)=\\frac{4}{3}\\left(\\left(\\frac{\\pi}{4}\\right)-\\left(0\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{3}.\n$$"} {:answer/id #uuid "272c268c-a1d0-55af-a3e3-3858d90a387c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,\\frac{32}{3})" :db/id #edb/ref 17592186684958} {:answer/id #uuid "3d46a024-33c4-5170-8623-96e0372edeae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-3,\\frac{4}{3})" :db/id #edb/ref 17592186684959} {:answer/id #uuid "4701bb17-26bd-5b96-b53a-b9edf6ad2c23" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-9,\\frac{4}{3})" :db/id #edb/ref 17592186684961} {:answer/id #uuid "83256d6a-29ae-538d-912b-9503ad0402e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{15}{4},-8)" :db/id #edb/ref 17592186684967} {:answer/id #uuid "f0ae3e3b-e44c-5b0d-9ecf-9fcc7d0d4ecd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{15}{4},6)" :db/id #edb/ref 17592186684975} {:answer/id #uuid "0188e590-2394-5be8-acb0-16653890294b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3},-1)" :db/id #edb/ref 17592186685302} {:answer/id #uuid "0aba0f0b-4732-5332-b967-78548437afd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2,\\frac{15}{2})" :db/id #edb/ref 17592186685305} {:answer/id #uuid "5757d947-fe9e-52c3-8d10-14cbb3058a98" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{3}{2},5)" :db/id #edb/ref 17592186685314} {:answer/id 