y)=0" :db/id #edb/ref 17592186691864} {:answer/id #uuid "e38044ac-fa3a-59fe-84a7-9ab9e17e1250" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{8 x^{2}}((8 x y)\\,\\text{d}x+\\,\\text{d}y)=0" :db/id #edb/ref 17592186691879}] :answer-field/correct {:db/id #edb/ref 17592186691864} :answer-field/id #uuid "bad99d8b-a37b-5fac-b4cc-88f874a566b9" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186691862} {:answer-field/choices [{:answer/id #uuid "49a5cd10-4d66-5f39-9d98-099242f7290b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(-\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186691810} {:answer/id #uuid "52606449-6fcc-5b30-9562-7976a7d12db6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(-g(x))" :db/id #edb/ref 17592186691817} {:answer/id #uuid "a6e90241-40a4-5180-a8c3-541033aa81e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(g(x))" :db/id #edb/ref 17592186691853} {:answer/id #uuid "d065b322-dcf7-5d75-988d-0bf7d92b5895" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186691868}] :answer-field/correct {:db/id #edb/ref 17592186691868} :answer-field/id #uuid "e66088d4-ab42-5be1-b11e-6968e741fa7f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186691880}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7a3fe005-b210-5de4-b9bc-95e8ab06e86e" :question/problem "Suppose we would like to find an **integrating factor** to convert the differential equation\n\n$$\n(8 x y)\\,\\text{d}x+\\,\\text{d}y=0\n$$\n\ninto an exact equation. Select the correct options in the reasoning below. Take $x$ to be real.\n\nFor a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0\n$$\n\nif\n\n$$\n{{field-1}}=g(x)\n$$\n\nwhere $g(x)$ is independent of $y$, an integrating factor is\n\n$$\nI(x)={{field-2}}\n$$\n\nwhere $\\exp(x)$ denotes $e^x$.\n\nLet's denote\n\n$$\nP(x,y)=8 x y,\\qquad Q(x,y)=1\n$$\n\nNow compute the partial derivatives:\n\n$$\n\\frac{\\partial P}{\\partial y}={{field-3}}\n$$\n\n$$\n\\frac{\\partial Q}{\\partial x}={{field-4}}\n$$\n\nSince\n\n$$\n\\frac{1}{Q}(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x})={{field-5}}\n$$\n\nis a function of $x$ only, an integrating factor is\n\n$$\nI(x)={{field-6}}\n$$\n\nand multiplication gives the exact equation\n\n$$\n{{field-7}}\n$$\n\nChoose the multiplicative constant to be one." :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0\n$$\n\nif\n\n$$\n\\frac{1}{Q}(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x})=g(x)\n$$\n\nwhere $g(x)$ is independent of $y$, an integrating factor is\n\n$$\nI(x)=\\exp(\\int g(x)\\,\\text{d}x)\n$$.\n\nHere $\\exp(x)=e^x$.\n\nLet's denote\n\n$$\nP(x,y)=8 x y,\\qquad Q(x,y)=1\n$$\n\nCompute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{\\partial P}{\\partial y}&=\\frac{\\partial}{\\partial y}(8 x y)=8 x \\\\ \\frac{\\partial Q}{\\partial x}&=\\frac{\\partial}{\\partial x}(1)=0\\end{aligned}\n$$\n\nThen\n\n$$\n\\begin{aligned}\\frac{1}{Q}(\\frac{\\partial P}{\\partial y}-\\frac{\\partial Q}{\\partial x})&=\\frac{1}{1}(8 x-(0)) \\\\ &=8 x\\end{aligned}\n$$\n\nThis is a function of $x$ only. Choose the multiplicative constant to be one. Thus\n\n$$\n\\begin{aligned}I(x)&=\\exp(\\int (8 x)\\,\\text{d}x) \\\\ &=\\exp(4 x^{2}) \\\\ &=e^{4 x^{2}}\\end{aligned}\n$$\n\nMultiply the original differential equation by this integrating factor:\n\n$$\n\\begin{aligned}I(x)((8 x y)\\,\\text{d}x+\\,\\text{d}y)&=I(x)\\cdot 0 \\\\ e^{4 x^{2}}((8 x y)\\,\\text{d}x+\\,\\text{d}y)&=0\\end{aligned}\n$$"} {:db/id #edb/ref 17592186691829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ec45dc2-e677-5c48-a848-3de66feaf4d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 x" :db/id #edb/ref 17592186691794} {:answer/id #uuid "b24b48d8-0104-59fb-842f-2c81a0bc5906" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 4 x" :db/id #edb/ref 17592186691856} {:answer/id #uuid "c30d54a2-328a-5834-9e07-65177db63098" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 x" :db/id #edb/ref 17592186691865} {:answer/id #uuid "da99b8de-bfb2-530b-b7b7-77e86f5fac18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 x" :db/id #edb/ref 17592186691876}] :answer-field/correct {:db/id #edb/ref 17592186691856} :answer-field/id #uuid "04168601-9e2e-526d-a9ea-7789821a9c14" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186691783} {:answer-field/choices [{:answer/id #uuid "132e30eb-5d27-504d-8de2-510e4e8ec57a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(-\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186691790} {:answer/id #uuid "2bb1dbb3-1483-5579-b699-88edbf9f983f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(g(x))" :db/id #edb/ref 17592186691799} {:answer/id #uuid "75612836-4897-5c8f-a008-1c7fa13e6c54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(-g(x))" :db/id #edb/ref 17592186691827} {:answer/id #uuid "aa120e6e-c693-5982-84c7-d4adfa735829" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\exp(\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186691854}] :answer-field/correct {:db/id #edb/ref 17592186691854} :answer-field/id #uuid "44bc1465-4f51-5e01-a3da-f096cd7d4600" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186691807} {:answer-field/choices [{:answer/id #uuid "02d25478-a6f2-5888-9786-365dd1dab261" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186691782} {:answer/id #uuid "2bcd75e7-36f4-57f7-8643-aeb90ee3603b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb