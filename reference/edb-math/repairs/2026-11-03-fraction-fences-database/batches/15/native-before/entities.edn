t(\\frac{3}{u}\\right)}^{1/4})}^{11/4} &= {\\left(\\frac{3}{u}\\right)}^{(1/4)(11/4)} \\\\ &= {\\left(\\frac{3}{u}\\right)}^{11/16} \\\\ &= \\sqrt[16]{{\\left(\\frac{3}{u}\\right)}^{11}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705554 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c71c6e-9567-56b5-8d26-85d2cdb010ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[16]{{\\left(\\frac{3}{u}\\right)}^{9}}" :db/id #edb/ref 17592186705536} {:answer/id #uuid "4865292d-058f-5f89-a203-73609ff0dd80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[9]{{\\left(\\frac{3}{u}\\right)}^{1}}" :db/id #edb/ref 17592186705538} {:answer/id #uuid "a4278a57-42cd-5987-84b4-30f0442caeab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[18]{{\\left(\\frac{3}{u}\\right)}^{11}}" :db/id #edb/ref 17592186705545} {:answer/id #uuid "cc1c5133-e820-5060-bff2-8278ddda4132" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[24]{{\\left(\\frac{3}{u}\\right)}^{17}}" :db/id #edb/ref 17592186705549} {:answer/id #uuid "df84687d-5b0b-5e7d-a993-0a091f32ffa8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[16]{{\\left(\\frac{3}{u}\\right)}^{11}}" :db/id #edb/ref 17592186705553}] :answer-field/correct {:db/id #edb/ref 17592186705545} :answer-field/id #uuid "61fa3221-d155-5274-b575-cbef8a53d242" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705543}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e3f7972b-5b5e-5ac7-aa65-4e18efe5a62b" :question/problem "The equivalent radical expression for ${({\\left(\\frac{3}{u}\\right)}^{1/6})}^{11/3}$ is\n\nAssume $u>0$." :question/worked-solution "First, we apply the power rule and then we express the resulting fractional power as a radical:\n\n$$\n\\begin{aligned}{({\\left(\\frac{3}{u}\\right)}^{1/6})}^{11/3} &= {\\left(\\frac{3}{u}\\right)}^{(1/6)(11/3)} \\\\ &= {\\left(\\frac{3}{u}\\right)}^{11/18} \\\\ &= \\sqrt[18]{{\\left(\\frac{3}{u}\\right)}^{11}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705597 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0584bffb-2e7b-5921-8fdc-d16295e00715" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705594} {:answer/id #uuid "0c860ec0-794f-5bd9-86c0-43e97b835872" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{\\sqrt{3}}{\\sqrt{2 \\sqrt{3} + 7}}\\right)\\,i+\\left(\\frac{- \\sqrt{3} - 1}{\\sqrt{2 \\sqrt{3} + 7}}\\right)\\,j" :db/id #edb/ref 17592186705596} {:answer/id #uuid "76810378-6e5e-5c8f-b51a-1a84273a1a8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705615} {:answer/id #uuid "a4141256-83d4-503d-9060-f0d6ca54b2b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705620} {:answer/id #uuid "d4ab196d-a9d5-50ef-885e-ec72b1d08da6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1 + \\sqrt{3}}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,i+\\left(\\frac{- \\sqrt{3} - 1}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,j" :db/id #edb/ref 17592186705624}] :answer-field/correct {:db/id #edb/ref 17592186705620} :answer-field/id #uuid "58a49492-49ad-5c30-8b98-64e9b859f1c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705611}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0f605aaa-ae26-5b68-87f9-17830de80cc0" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=e^{x - y} \\sin{\\left(x + y \\right)} + 1$ that passes through the point $(x,y)=(\\frac{\\pi}{2},\\frac{\\pi}{6})$." :question/worked-solution "The gradient at the specified point is normal to the level curve. Differentiate before substituting the coordinates. Apply both product and chain rules to each partial derivative.\n\n$$\n\\begin{aligned}\nf_x(x,y)&=\\left(\\sin{\\left(x + y \\right)} + \\cos{\\left(x + y \\right)}\\right) e^{x - y} \\\\ f_y(x,y)&=\\left(- \\sin{\\left(x + y \\right)} + \\cos{\\left(x + y \\right)}\\right) e^{x - y} \\\\ \\sin\\left(\\frac{2 \\pi}{3}\\right)&=\\frac{\\sqrt{3}}{2} \\\\ \\cos\\left(\\frac{2 \\pi}{3}\\right)&=- \\frac{1}{2} \\\\ \\nabla f(\\frac{\\pi}{2},\\frac{\\pi}{6})&=\\frac{e^{\\frac{\\pi}{3}}}{2}\\,\\mathbf v \\\\ \\mathbf v&=\\left(-1 + \\sqrt{3}\\right)\\,i+\\left(- \\sqrt{3} - 1\\right)\\,j \\\\ \\|\\mathbf v\\|^2&=\\left(-1 + \\sqrt{3}\\right)^2+\\left(- \\sqrt{3} - 1\\right)^2 \\\\ &=8 \\\\ \\|\\nabla f(\\frac{\\pi}{2},\\frac{\\pi}{6})\\|&=\\sqrt{2} e^{\\frac{\\pi}{3}}\n\\end{aligned}\n$$\n\nThis gradient is nonzero. Divide it by its magnitude; the common exponential factor is positive and cancels:\n\n$$\n\\begin{aligned}\\mathbf n&=\\frac{\\nabla f(\\frac{\\pi}{2},\\frac{\\pi}{6})}{\\|\\nabla f(\\frac{\\pi}{2},\\frac{\\pi}{6})\\|} \\\\ &=\\frac{\\left(-1 + \\sqrt{3}\\right)\\,i+\\left(- \\sqrt{3} - 1\\right)\\,j}{2 \\sqrt{2}} \\\\ &=\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,j\n\\end{aligned}\n$$\n\nIts negative is also a unit normal. Exactly one displayed choice is a unit vector parallel to the gradient."} {:db/id #edb/ref 17592186705614 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22953525-b5e9-5596-915e-71172f1ce1bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,j" :db/id #edb/ref 17592186705600} {:answer/id #uuid "3d4045a8-553f-5ddb-8fdc-b24d25e31c75" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{1}{2}\\right)\\,i+\\left(- \\frac{\\sqrt{3}}{2}\\right)\\,j" :db/id #edb/ref 17592186705604} {:answer/id #uuid "43532700-ce0a-587a-b915-30e3a1344bb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{- \\sqrt{3} - 1}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,i+\\left(\\frac{1 + \\sqrt{3}}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,j" :db/id #edb/ref 17592186705607} {:answer/id #uuid "9f357cc3-0848-5792-a1af-35ba171ed94c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705619} {:answer/id #uuid "e156e8c6-c841-5711-b70b-74566b9eab91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{1}{\\sqrt{5 - 2 \\sqrt{3}}}\\right)\\,i+\\left(\\frac{1 - \\sqrt{3}}{\\sqrt{5 - 2 \\sqrt{3}}}\\right)\\,j" :db/id #edb/ref 17592186705628}] :answer-field/correct {:db/id #edb/ref 17592186705619} :answer-field/id #uuid "65058df1-dcfa-55c1-ad91-62c3cc090ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705613}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6f130794-d992-58c1-b0b9-d32d6518a6a8" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=- e^{x - y} \\sin{\\left(x + y \\right)} + 1$ that passes through the point $(x,y)=(\\frac{\\pi}{6},0)$." :question/worked-solution "The gradient at the specified point is normal to the level curve. Differentiate before substituting the coordinates. Apply both product and chain rules to each partial derivative.\n\n$$\n\\begin{aligned}\nf_x(x,y)&=\\left(- \\sin{\\left(x + y \\right)} - \\cos{\\left(x + y \\right)}\\right) e^{x - y} \\\\ f_y(x,y)&=\\left(\\sin{\\left(x + y \\right)} - \\cos{\\left(x + y \\right)}\\right) e^{x - y} \\\\ \\sin\\left(\\frac{\\pi}{6}\\right)&=\\frac{1}{2} \\\\ \\cos\\left(\\frac{\\pi}{6}\\right)&=\\frac{\\sqrt{3}}{2} \\\\ \\nabla f(\\frac{\\pi}{6},0)&=\\frac{e^{\\frac{\\pi}{6}}}{2}\\,\\mathbf v \\\\ \\mathbf v&=\\left(- \\sqrt{3} - 1\\right)\\,i+\\left(1 - \\sqrt{3}\\right)\\,j \\\\ \\|\\mathbf v\\|^2&=\\left(- \\sqrt{3} - 1\\right)^2+\\left(1 - \\sqrt{3}\\right)^2 \\\\ &=8 \\\\ \\|\\nabla f(\\frac{\\pi}{6},0)\\|&=\\sqrt{2} e^{\\frac{\\pi}{6}}\n\\end{aligned}\n$$\n\nThis gradient is nonzero. Divide it by its magnitude; the common exponential factor is positive and cancels:\n\n$$\n\\begin{aligned}\\mathbf n&=\\frac{\\nabla f(\\frac{\\pi}{6},0)}{\\|\\nabla f(\\frac{\\pi}{6},0)\\|} \\\\ &=\\frac{\\left(- \\sqrt{3} - 1\\right)\\,i+\\left(1 - \\sqrt{3}\\right)\\,j}{2 \\sqrt{2}} \\\\ &=\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j\n\\end{aligned}\n$$\n\nIts negative is also a unit normal. Exactly one displayed choice is a unit vector parallel to the gradient."} {:db/id #edb/ref 17592186705616 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19092c6c-5acb-5a6e-b36a-167b24277fb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{1}{2}\\right)\\,i+\\left(\\frac{\\sqrt{3}}{2}\\right)\\,j" :db/id #edb/ref 17592186705599} {:answer/id #uuid "283c4205-bea2-5e7b-bdea-845d19046ef2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{- \\sqrt{3} - 1}{\\sqrt{2 \\sqrt{3} + 7}}\\right)\\,i+\\left(\\frac{\\sqrt{3}}{\\sqrt{2 \\sqrt{3} + 7}}\\right)\\,j" :db/id #edb/ref 17592186705601} {:answer/id #uuid "3a64baaf-a95b-5761-8212-1f2e2cc46853" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705603} {:answer/id #uuid "433a8fd6-e06d-5391-8b89-a37a47532cee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,j" :db/id #edb/ref 17592186705606} {:answer/id #uuid "e0131dea-e20f-5bf6-97d2-5ec2716e1ddb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,j" :db/id #edb/ref 17592186705627}] :answer-field/correct {:db/id #edb/ref 17592186705606} :answer-field/id #uuid "5621bd7c-b2bc-5294-8a53-5152e043a0ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705609}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "7a8d4ef2-c82d-5f34-ae79-41fc3ab1f3b1" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=- e^{- x - y} \\sin{\\left(x - y \\right)} - 1$ that passes through the point $(x,y)=(0,\\frac{\\pi}{6})$." :question/worked-solution "The gradient at the specified point is normal to the level curve. Differentiate before substituting the coordinates. Apply both product and chain rules to each partial derivative.\n\n$$\n\\begin{aligned}\nf_x(x,y)&=\\left(\\sin{\\left(x - y \\right)} - \\cos{\\left(x - y \\right)}\\right) e^{- x - y} \\\\ f_y(x,y)&=\\left(\\sin{\\left(x - y \\right)} + \\cos{\\left(x - y \\right)}\\right) e^{- x - y} \\\\ \\sin\\left(- \\frac{\\pi}{6}\\right)&=- \\frac{1}{2} \\\\ \\cos\\left(- \\frac{\\pi}{6}\\right)&=\\frac{\\sqrt{3}}{2} \\\\ \\nabla f(0,\\frac{\\pi}{6})&=\\frac{1}{2 e^{\\frac{\\pi}{6}}}\\,\\mathbf v \\\\ \\mathbf v&=\\left(- \\sqrt{3} - 1\\right)\\,i+\\left(-1 + \\sqrt{3}\\right)\\,j \\\\ \\|\\mathbf v\\|^2&=\\left(- \\sqrt{3} - 1\\right)^2+\\left(-1 + \\sqrt{3}\\right)^2 \\\\ &=8 \\\\ \\|\\nabla f(0,\\frac{\\pi}{6})\\|&=\\frac{\\sqrt{2}}{e^{\\frac{\\pi}{6}}}\n\\end{aligned}\n$$\n\nThis gradient is nonzero. Divide it by its magnitude; the common exponential factor is positive and cancels:\n\n$$\n\\begin{aligned}\\mathbf n&=\\frac{\\nabla f(0,\\frac{\\pi}{6})}{\\|\\nabla f(0,\\frac{\\pi}{6})\\|} \\\\ &=\\frac{\\left(- \\sqrt{3} - 1\\right)\\,i+\\left(-1 + \\sqrt{3}\\right)\\,j}{2 \\sqrt{2}} \\\\ &=\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,j\n\\end{aligned}\n$$\n\nIts negative is also a unit normal. Exactly one displayed choice is a unit vector parallel to the gradient."} {:db/id #edb/ref 17592186705618 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "402f08ef-6731-5bb7-ad99-bfbb7abaec6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705605} {:answer/id #uuid "529ed544-2fff-5578-af21-3d18cded24f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705608} {:answer/id #uuid "56b518bb-6798-5e44-9c17-8a1a9304c8ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1 - \\sqrt{3}}{\\sqrt{5 - 2 \\sqrt{3}}}\\right)\\,i+\\left(- \\frac{1}{\\sqrt{5 - 2 \\sqrt{3}}}\\right)\\,j" :db/id #edb/ref 17592186705610} {:answer/id #uuid "cd2642ea-6d46-51ad-b2bb-552f01441cf4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705623} {:answer/id #uuid "dbd96dc8-6a04-5713-9445-0569db236766" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{- \\sqrt{3} - 1}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,i+\\left(\\frac{- \\sqrt{3} - 1}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,j" :db/id #edb/ref 17592186705626}] :answer-field/correct {:db/id #edb/ref 17592186705605} :answer-field/id #uuid "610b4e73-e3eb-509f-bcaf-1ccad591e9dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705612}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "8a9ba066-e207-534b-b904-793028ce8309" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=- e^{- x + y} \\sin{\\left(x + y \\right)} + 1$ that passes through the point $(x,y)=(\\frac{\\pi}{3},- \\frac{\\pi}{6})$." :question/worked-solution "The gradient at the specified point is normal to the level curve. Differentiate before substituting the coordinates. Apply both product and chain rules to each partial derivative.\n\n$$\n\\begin{aligned}\nf_x(x,y)&=\\left(\\sin{\\left(x + y \\right)} - \\cos{\\left(x + y \\right)}\\right) e^{- x + y} \\\\ f_y(x,y)&=\\left(- \\sin{\\left(x + y \\right)} - \\cos{\\left(x + y \\right)}\\right) e^{- x + y} \\\\ \\sin\\left(\\frac{\\pi}{6}\\right)&=\\frac{1}{2} \\\\ \\cos\\left(\\frac{\\pi}{6}\\right)&=\\frac{\\sqrt{3}}{2} \\\\ \\nabla f(\\frac{\\pi}{3},- \\frac{\\pi}{6})&=\\frac{1}{2 e^{\\frac{\\pi}{2}}}\\,\\mathbf v \\\\ \\mathbf v&=\\left(1 - \\sqrt{3}\\right)\\,i+\\left(- \\sqrt{3} - 1\\right)\\,j \\\\ \\|\\mathbf v\\|^2&=\\left(1 - \\sqrt{3}\\right)^2+\\left(- \\sqrt{3} - 1\\right)^2 \\\\ &=8 \\\\ \\|\\nabla f(\\frac{\\pi}{3},- \\frac{\\pi}{6})\\|&=\\frac{\\sqrt{2}}{e^{\\frac{\\pi}{2}}}\n\\end{aligned}\n$$\n\nThis gradient is nonzero. Divide it by its magnitude; the common exponential factor is positive and cancels:\n\n$$\n\\begin{aligned}\\mathbf n&=\\frac{\\nabla f(\\frac{\\pi}{3},- \\frac{\\pi}{6})}{\\|\\nabla f(\\frac{\\pi}{3},- \\frac{\\pi}{6})\\|} \\\\ &=\\frac{\\left(1 - \\sqrt{3}\\right)\\,i+\\left(- \\sqrt{3} - 1\\right)\\,j}{2 \\sqrt{2}} \\\\ &=\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} - \\frac{\\sqrt{2}}{4}\\right)\\,j\n\\end{aligned}\n$$\n\nIts negative is also a unit normal. Exactly one displayed choice is a unit vector parallel to the gradient."} {:db/id #edb/ref 17592186705625 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c5ddfdc-2def-5b02-9885-2175fbe48a81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1}{\\sqrt{5 - 2 \\sqrt{3}}}\\right)\\,i+\\left(\\frac{1 - \\sqrt{3}}{\\sqrt{5 - 2 \\sqrt{3}}}\\right)\\,j" :db/id #edb/ref 17592186705595} {:answer/id #uuid "163e7732-e3e3-5b62-9a4a-abfcd56c8d4f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,i+\\left(\\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,j" :db/id #edb/ref 17592186705598} {:answer/id #uuid "28b09933-b2a2-5c7a-bc45-b988e00ccdae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1 + \\sqrt{3}}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,i+\\left(\\frac{1 + \\sqrt{3}}{2 \\sqrt{\\sqrt{3} + 2}}\\right)\\,j" :db/id #edb/ref 17592186705602} {:answer/id #uuid "af2b1cf4-5c2f-54f2-804f-70f6aa1d8b1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j" :db/id #edb/ref 17592186705621} {:answer/id #uuid "b6c96a30-9308-5de8-9e1c-5a8a7d432f18" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{1 + \\sqrt{3}}{\\sqrt{2 \\sqrt{3} + 7}}\\right)\\,i+\\left(- \\frac{\\sqrt{3}}{\\sqrt{2 \\sqrt{3} + 7}}\\right)\\,j" :db/id #edb/ref 17592186705622}] :answer-field/correct {:db/id #edb/ref 17592186705621} :answer-field/id #uuid "85f8cdee-b364-5121-bf7f-b22daff15286" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705617}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d8fb2de5-609a-50c8-9118-5b8a81628b43" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=e^{x - y} \\sin{\\left(x + y \\right)} - 1$ that passes through the point $(x,y)=(\\frac{\\pi}{3},0)$." :question/worked-solution "The gradient at the specified point is normal to the level curve. Differentiate before substituting the coordinates. Apply both product and chain rules to each partial derivative.\n\n$$\n\\begin{aligned}\nf_x(x,y)&=\\left(\\sin{\\left(x + y \\right)} + \\cos{\\left(x + y \\right)}\\right) e^{x - y} \\\\ f_y(x,y)&=\\left(- \\sin{\\left(x + y \\right)} + \\cos{\\left(x + y \\right)}\\right) e^{x - y} \\\\ \\sin\\left(\\frac{\\pi}{3}\\right)&=\\frac{\\sqrt{3}}{2} \\\\ \\cos\\left(\\frac{\\pi}{3}\\right)&=\\frac{1}{2} \\\\ \\nabla f(\\frac{\\pi}{3},0)&=\\frac{e^{\\frac{\\pi}{3}}}{2}\\,\\mathbf v \\\\ \\mathbf v&=\\left(1 + \\sqrt{3}\\right)\\,i+\\left(1 - \\sqrt{3}\\right)\\,j \\\\ \\|\\mathbf v\\|^2&=\\left(1 + \\sqrt{3}\\right)^2+\\left(1 - \\sqrt{3}\\right)^2 \\\\ &=8 \\\\ \\|\\nabla f(\\frac{\\pi}{3},0)\\|&=\\sqrt{2} e^{\\frac{\\pi}{3}}\n\\end{aligned}\n$$\n\nThis gradient is nonzero. Divide it by its magnitude; the common exponential factor is positive and cancels:\n\n$$\n\\begin{aligned}\\mathbf n&=\\frac{\\nabla f(\\frac{\\pi}{3},0)}{\\|\\nabla f(\\frac{\\pi}{3},0)\\|} \\\\ &=\\frac{\\left(1 + \\sqrt{3}\\right)\\,i+\\left(1 - \\sqrt{3}\\right)\\,j}{2 \\sqrt{2}} \\\\ &=\\left(\\frac{\\sqrt{2}}{4} + \\frac{\\sqrt{6}}{4}\\right)\\,i+\\left(- \\frac{\\sqrt{6}}{4} + \\frac{\\sqrt{2}}{4}\\right)\\,j\n\\end{aligned}\n$$\n\nIts negative is also a unit normal. Exactly one displayed choice is a unit vector parallel to the gradient."} {:db/id #edb/ref 17592186705753 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "724b8163-e7e2-55b6-959a-e56c2dc23c6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186705754}] :answer-field/correct {:db/id #edb/ref 17592186705754} :answer-field/id #uuid "adf129e2-7b8b-51b6-bc4a-72e559962d4a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186705757}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4204b0d0-3b14-59e9-ae05-0d9970414907" :question/problem "Expressed as a fraction in its simplest form, ${(-2)}^{-3}=${{field-1}}." :question/worked-solution "We find the reciprocal of the base $(-2),$ and then raise that reciprocal to the same power but with the *opposite* sign $(+3),$ as follows:\n\n$$\n\\begin{aligned}{(-2)}^{-3} & ={(-\\frac{1}{2})}^{3} \\\\  & =(-\\frac{1}{2})\\times (-\\frac{1}{2})\\times (-\\frac{1}{2}) \\\\  & =(\\frac{1\\times 1\\times 1}{(-2)\\times (-2)\\times (-2)}) \\\\  & =-\\frac{1}{8}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705758 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0073543-1ae1-560b-a51c-7d65d3b21747" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{27}" :db/id #edb/ref 17592186705756}] :answer-field/correct {:db/id #edb/ref 17592186705756} :answer-field/id #uuid "d622a79b-4584-519d-9435-5de868f29b5a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186705760}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b3e992cb-8112-5f80-9ab9-d31e7b160776" :question/problem "Expressed as a fraction in its simplest form, ${3}^{-3}=${{field-1}}." :question/worked-solution "We find the reciprocal of the base $(3),$ and then raise that reciprocal to the same power but with the *opposite* sign $(+3),$ as follows:\n\n$$\n\\begin{aligned}{3}^{-3} & ={(\\frac{1}{3})}^{3} \\\\  & =(\\frac{1}{3})\\times (\\frac{1}{3})\\times (\\frac{1}{3}) \\\\  & =(\\frac{1\\times 1\\times 1}{3\\times 3\\times 3}) \\\\  & =\\frac{1}{27}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705759 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e911c1-e4b0-5d50-a6cc-e47ccbdbef8c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{256}" :db/id #edb/ref 17592186705752}] :answer-field/correct {:db/id #edb/ref 17592186705752} :answer-field/id #uuid "1964879d-8727-5346-a20d-650e3d60a2da" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186705750}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c0a4510d-a3f5-510c-bc95-f2d385226577" :question/problem "Expressed as a fraction in its simplest form, ${(-4)}^{-4}=${{field-1}}." :question/worked-solution "We find the reciprocal of the base $(-4),$ and then raise that reciprocal to the same power but with the *opposite* sign $(+4),$ as follows:\n\n$$\n\\begin{aligned}{(-4)}^{-4} & ={(-\\frac{1}{4})}^{4} \\\\  & =(-\\frac{1}{4})\\times (-\\frac{1}{4})\\times (-\\frac{1}{4})\\times (-\\frac{1}{4}) \\\\  & =(\\frac{1\\times 1\\times 1\\times 1}{(-4)\\times (-4)\\times (-4)\\times (-4)}) \\\\  & =\\frac{1}{256}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8794c347-aa72-5834-84f2-c0082785c08d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{27}" :db/id #edb/ref 17592186705755}] :answer-field/correct {:db/id #edb/ref 17592186705755} :answer-field/id #uuid "1d3fc7dc-4da9-5095-9c4d-151016ece21f" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186705751}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fa6ee861-85c8-5859-a38c-d3b36bfac824" :question/problem "Expressed as a fraction in its simplest form, ${(-3)}^{-3}=${{field-1}}." :question/worked-solution "We find the reciprocal of the base $(-3),$ and then raise that reciprocal to the same power but with the *opposite* sign $(+3),$ as follows:\n\n$$\n\\begin{aligned}{(-3)}^{-3} & ={(-\\frac{1}{3})}^{3} \\\\  & =(-\\frac{1}{3})\\times (-\\frac{1}{3})\\times (-\\fr