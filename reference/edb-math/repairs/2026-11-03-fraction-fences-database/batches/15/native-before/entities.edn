{4}{u}\\right)}^{1/5})}^{13/2}$ is\n\nAssume $u>0$." :question/worked-solution "First, we apply the power rule and then we express the resulting fractional power as a radical:\n\n$$\n\\begin{aligned}{({\\left(\\frac{4}{u}\\right)}^{1/5})}^{13/2} &= {\\left(\\frac{4}{u}\\right)}^{(1/5)(13/2)} \\\\ &= {\\left(\\frac{4}{u}\\right)}^{13/10} \\\\ &= \\sqrt[10]{{\\left(\\frac{4}{u}\\right)}^{13}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186705544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dd2af72-07ca-5f38-b2ff-b6afadb56bb7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[9]{{\\left(\\frac{2}{u}\\right)}^{1}}" :db/id #edb/ref 17592186705542} {:answer/id #uuid "b4d7eb08-0697-53f4-9e55-8cf5a2966ff0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[9]{{\\left(\\frac{2}{u}\\right)}^{2}}" :db/id #edb/ref 17592186705547} {:answer/id #uuid "ceb0286f-fad1-5c54-9cef-99e9d8b883ce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[25]{{\\left(\\frac{2}{u}\\right)}^{13}}" :db/id #edb/ref 17592186705550} {:answer/id #uuid "cf3b33af-e681-5cbd-89d8-393cbabb7d7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[5]{{\\left(\\frac{2}{u}\\right)}^{3}}" :db/id #edb/ref 17592186705551} {:answer/id #uuid "fb54ecda-3b87-5bfa-bf04-c735d089c61f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[25]{{\\left(\\frac{2}{u}\\right)}^{17}}" :db/id #edb/ref 17592186705556}] :answer-field/correct {:db/id #edb/ref 17592186705551} :answer-field/id #uuid "54d60afe-e7b8-5904-b061-00caaa331272" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705541}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6c45c316-19f6-5abd-b29a-5e400d41117c" :question/problem "The equivalent radical expression for ${({\\left(\\frac{2}{u}\\right)}^{1/3})}^{9/5}$ is\n\nAssume $u>0$." :question/worked-solution "First, we apply the pow