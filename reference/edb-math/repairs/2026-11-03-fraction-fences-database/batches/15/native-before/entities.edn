d}x=1&\\Longrightarrow u=\\frac{\\sqrt{3}}{3}\\\\x=3&\\Longrightarrow u=\\sqrt{3}\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{1}^{3} \\frac{2}{x^{2} + 3}\\,\\mathrm{d}x\\\\&=\\frac{2 \\sqrt{3}}{3}\\left(\\int_{\\frac{\\sqrt{3}}{3}}^{\\sqrt{3}} \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arctan{\\left(\\frac{\\sqrt{3}}{3} \\right)}=\\frac{\\pi}{6},\\quad \\arctan{\\left(\\sqrt{3} \\right)}=\\frac{\\pi}{3}$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{u^{2} + 1}\\,\\mathrm{d}u=\\arctan{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n\\frac{2 \\sqrt{3}}{3}\\left(\\left[\\arctan{\\left(u \\right)}\\right]_{\\frac{\\sqrt{3}}{3}}^{\\sqrt{3}}\\right)=\\frac{2 \\sqrt{3}}{3}\\left(\\left(\\frac{\\pi}{3}\\right)-\\left(\\frac{\\pi}{6}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\sqrt{3} \\pi}{9}.\n$$"} {:db/id #edb/ref 17592186693155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef654d89-f93f-534f-ab9f-1a9989542a07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186693149}] :answer-field/correct {:db/id #edb/ref 17592186693149} :answer-field/id #uuid "f244f8d2-4622-55b9-8ad2-276b6fcf3652" :answer-field/key "answer" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186693150}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fc989089-ee91-5602-b354-1363e3229631" :question/problem "Evaluate exactly.\n\n$$\n\\int_{-1}^{0} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x\n$$\n\n{{answer}}" :question/worked-solution "Let $u=\\frac{\\sqrt{2} x}{2}$. Then $\\mathrm{d}u=(\\frac{\\sqrt{2}}{2})\\,\\mathrm{d}x$.\n\nNormalize the denominator:\n\n$$\n\\sqrt{2 - x^{2}}=\\sqrt{2}\\sqrt{1-(\\frac{\\sqrt{2} x}{2})^2}.\n$$\n\nThe differential is $\\mathrm{d}x=\\sqrt{2}\\,\\mathrm{d}u$. The outside factor is $\\sqrt{2}\\cdot \\sqrt{2}=2$.\n\nTransform both bounds:\n\n$$\n\\begin{aligned}x=-1&\\Longrightarrow u=- \\frac{\\sqrt{2}}{2}\\\\x=0&\\Longrightarrow u=0\\end{aligned}\n$$\n\nIncluding the differential factor gives\n\n$$\n\\begin{aligned}&\\int_{-1}^{0} \\frac{2}{\\sqrt{2 - x^{2}}}\\,\\mathrm{d}x\\\\&=2\\left(\\int_{- \\frac{\\sqrt{2}}{2}}^{0} \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u\\right).\\end{aligned}\n$$\n\nEndpoint values: $\\arcsin{\\left(- \\frac{\\sqrt{2}}{2} \\right)}=- \\frac{\\pi}{4},\\quad \\arcsin{\\left(0 \\right)}=0$.\n\nUse the integration rule:\n\n$$\n\\int \\frac{1}{\\sqrt{1 - u^{2}}}\\,\\mathrm{d}u=\\arcsin{\\left(u \\right)}+C.\n$$\n\nEvaluate the primitive and subtract lower from upper:\n\n$$\n2\\left(\\left[\\arcsin{\\left(u \\right)}\\right]_{- \\frac{\\sqrt{2}}{2}}^{0}\\right)=2\\left(\\left(0\\right)-\\left(- \\frac{\\pi}{4}\\right)\\right).\n$$\n\nThe exact answer is\n\n$$\n\\frac{\\pi}{2}.\n$$"} {:db/id #edb/ref 17592186694090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43f17e0b-6268-57e2-b958-be505667edba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{x}{\\ln{(3 )}} + \\frac{1}{\\ln{(3 )}^{2}}\\right)3^{x}+C" :db/id #edb/ref 17592186694099} {:answer/id #uuid "6691ac63-0715-5aa8-beda-5e6f73f58a58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{x}{\\ln{(3 )}} - \\frac{1}{\\ln{(3 )}^{2}}\\right)3^{x}+C" :db/id #edb/ref 17592186694102} {:answer/id #uuid "b8ec7872-591d-54b6-8518-d1e7ab3fe837" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{x}{\\ln{(3 )}^{2}} + \\frac{x}{\\ln{(3 )}}\\right)3^{x}+C" :db/id #edb/ref 17592186694114} {:answer/id #uuid "c6dd5d6e-cc9c-5f8c-b55c-33653930fb6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{x}{\\ln{(3 )}}\\right)3^{x}+C" :db/id #edb/ref 17592186694115} {:answer/id #uuid "d2f8a7cc-fe5a-541c-af1c-c1dae3c73035" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{x}{\\ln{(3 )}} - \\frac{1}{\\ln{(3 )}^{2}}\\right)3^{x}+C" :db/id #edb/ref 17592186694117}] :answer-field/correct {:db/id #edb/ref 17592186694102} :answer-field/id #uuid "a26a53b2-9ce2-5c2a-a9de-7dfb9416db7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186694111}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "19e99f60-9da4-54ea-bd6c-9fe3cc030a8c" :question/problem "$$\n\\int x3^{x}\\,\\text{d}x=\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x3^{x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u & =x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′} & =3^{x}\\, & ⟹\\,v=\\frac{3^{x}}{\\ln{(3 )}}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot 3^{x}\\,\\text{d}x & =x\\cdot \\frac{3^{x}}{\\ln{(3 )}}-\\int \\frac{3^{x}}{\\ln{(3 )}}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x3^{x}\\,\\text{d}x & =\\frac{3^{x} x}{\\ln{(3 )}}-\\int \\frac{3^{x}}{\\ln{(3 )}}\\,\\text{d}x \\\\  & =\\frac{1}{\\ln{(3 )}}\\cdot x3^{x}-\\frac{1}{\\ln{(3 )}^{2}}\\cdot 3^{x}+C \\\\  & =\\frac{3^{x}}{\\ln{(3 )}}(x - \\frac{1}{\\ln{(3 )}})+C\\end{aligned}\n$$\n\nCollecting the linear terms gives\n\n$$\n\\begin{aligned}\\int x3^{x}\\,\\mathrm{d}x & =\\left(\\frac{x}{\\ln{(3 )}} - \\frac{1}{\\ln{(3 )}^{2}}\\right)3^{x}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186694098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044388a4-3e6a-5dae-8a22-4f1aae63b2b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(x - \\frac{1}{\\ln{(4 )}^{2}}\\right)4^{x}+C" :db/id #edb/ref 17592186694087} {:answer/id #uuid "23c13642-8ef2-550b-8d1d-2292d0a5a4c0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{x}{\\ln{(4 )}} - \\frac{1}{\\ln{(4 )}}\\right)4^{x}+C" :db/id #edb/ref 17592186694092} {:answer/id #uuid "63433243-33c0-5af7-b7e1-896d58cd0728" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(- \\frac{x}{\\ln{(4 )}^{2}} + \\frac{x}{\\ln{(4 )}}\\right)4^{x}+C" :db/id #edb/ref 17592186694101} {:answer/id #uuid "7441a536-69e3-5178-8dad-512064ab445e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{x}{\\ln{(4 )}} - \\frac{1}{\\ln{(4 )}^{2}}\\right)4^{x}+C" :db/id #edb/ref 17592186694105} {:answer/id #uuid "ae18c487-3421-594f-bf4d-3580e7cef989" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left(\\frac{x}{\\ln{(4 )}} + \\frac{1}{\\ln{(4 )}^{2}}\\right)4^{x}+C" :db/id #edb/ref 17592186694113}] :answer-field/correct {:db/id #edb/ref 17592186694105} :answer-field/id #uuid "ef30f411-d368-586e-9bca-4a07c7d9cdb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186694119}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3e25002e-622d-5e60-afd0-bf72bc97b78c" :question/problem "Calculate\n\n$$\n\\int x4^{x}\\,\\text{d}x.\n$$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x4^{x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u & =x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′} & =4^{x}\\, & ⟹\\,v=\\frac{4^{x}}{\\ln{(4 )}}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot 4^{x}\\,\\text{d}x & =x\\cdot \\frac{4^{x}}{\\ln{(4 )}}-\\int \\frac{4^{x}}{\\ln{(4 )}}\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x4^{x}\\,\\text{d}x & =\\frac{4^{x} x}{\\ln{(4 )}}-\\int \\frac{4^{x}}{\\ln{(4 )}}\\,\\text{d}x \\\\  & =\\frac{1}{\\ln{(4 )}}\\cdot x4^{x}-\\frac{1}{\\ln{(4 )}^{2}}\\cdot 4^{x}+C \\\\  & =\\frac{4^{x}}{\\ln{(4 )}}(x - \\frac{1}{\\ln{(4 )}})+C\\end{aligned}\n$$\n\nCollecting the linear terms gives\n\n$$\n\\begin{aligned}\\int x4^{x}\\,\\mathrm{d}x & =\\left(\\frac{x}{\\ln{(4 )}} - \\frac{1}{\\ln{(4 )}^{2}}\\right)4^{x}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186696806 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8af484a-e64f-5798-8c57-860e7dc65aeb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}" :db/id #edb/ref 17592186696809}] :answer-field/correct {:db/id #edb/ref 17592186696809} :answer-field/id #uuid "302cb732-0754-5291-b677-071113095b9d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696793} {:answer-field/choices [{:answer/id #uuid "1015ce7d-f281-5758-a725-44cc01768a4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186696788}] :answer-field/correct {:db/id #edb/ref 17592186696788} :answer-field/id #uuid "5b1bf62a-743a-51fb-a959-a017a3cdcdba" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696797}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "bb54745e-8a8d-5ab3-b56b-6f835688e54a" :question/problem "The point of intersection of the lines $y=\\frac{2}{3}x+\\frac{1}{3}$ and $y=\\frac{4}{3}x-2$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=\\frac{2}{3}x+\\frac{1}{3}$ and $y=\\frac{4}{3}x-2.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=\\frac{2}{3}x+\\frac{1}{3} \\\\ y &=\\frac{4}{3}x-2\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=\\frac{2}{3}x+\\frac{1}{3}$ into the second equation $y=\\frac{4}{3}x-2$ yields an equation that we can solve for $x:$ Multiply both sides by $3$ to clear the denominators.\n\n$$\n\\begin{aligned}\\frac{2}{3}x+\\frac{1}{3} &=\\frac{4}{3}x-2 \\\\ 2x+1 &=4x-6 \\\\ -2x &=-7 \\\\ x &=\\frac{7}{2}\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=\\frac{7}{2}$ back into one of the equations, say $y=\\frac{2}{3}x+\\frac{1}{3},$ as follows:\n\n$$\n\\begin{aligned}y &=\\frac{2}{3}x+\\frac{1}{3} \\\\  &=\\frac{2}{3}(\\frac{7}{2})+\\frac{1}{3} \\\\  &=\\frac{7}{3}+\\frac{1}{3} \\\\  &=\\frac{8}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{7}{2},\\,y=\\frac{8}{3}.$ So, the coordinates of the intersection point are $(\\frac{7}{2},\\frac{8}{3}).$"} {:db/id #edb/ref 17592186696808 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3431aaf7-5729-5160-8c08-2acf79deb7b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{3}" :db/id #edb/ref 17592186696794}] :answer-field/correct {:db/id #edb/ref 17592186696794} :answer-field/id #uuid "767c0dba-bd9e-580f-bafa-193f59d3de43" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696801} {:answer-field/choices [{:answer/id #uuid "018c7748-09de-5e39-8c45-14f433d0f18a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186696786}] :answer-field/correct {:db/id #edb/ref 17592186696786} :answer-field/id #uuid "9246b386-98c7-5c5d-8a68-7b853236c65e" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696803}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e1453099-4bed-5299-ad26-3cb3bc085457" :question/problem "The point of intersection of the lines $y=-\\frac{4}{3}x+\\frac{2}{3}$ and $y=-\\frac{5}{3}x+\\frac{5}{3}$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=-\\frac{4}{3}x+\\frac{2}{3}$ and $y=-\\frac{5}{3}x+\\frac{5}{3}.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=-\\frac{4}{3}x+\\frac{2}{3} \\\\ y &=-\\frac{5}{3}x+\\frac{5}{3}\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=-\\frac{4}{3}x+\\frac{2}{3}$ into the second equation $y=-\\frac{5}{3}x+\\frac{5}{3}$ yields an equation that we can solve for $x:$ Multiply both sides by $3$ to clear the denominators.\n\n$$\n\\begin{aligned}-\\frac{4}{3}x+\\frac{2}{3} &=-\\frac{5}{3}x+\\frac{5}{3} \\\\ -4x+2 &=-5x+5 \\\\ x &=3 \\\\ x &=3\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=3$ back into one of the equations, say $y=-\\frac{4}{3}x+\\frac{2}{3},$ as follows:\n\n$$\n\\begin{aligned}y &=-\\frac{4}{3}x+\\frac{2}{3} \\\\  &=-\\frac{4}{3}(3)+\\frac{2}{3} \\\\  &=-4+\\frac{2}{3} \\\\  &=-\\frac{10}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=3,\\,y=-\\frac{10}{3}.$ So, the coordinates of the intersection point are $(3,-\\frac{10}{3}).$"} {:db/id #edb/ref 17592186696810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e8bceb2-f96f-519a-9b53-ba2241469a5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186696798}] :answer-field/correct {:db/id #edb/ref 17592186696798} :answer-field/id #uuid "200dcfbe-3836-5a2b-9153-4c00617f105c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696790} {:answer-field/choices [{:answer/id #uuid "b7bb77e9-248b-5c6a-842d-ac01cf619920" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186696805}] :answer-field/correct {:db/id #edb/ref 17592186696805} :answer-field/id #uuid "93a20662-1fe5-5052-9448-617a9a0d4c57" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696804}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "fc156c8f-3834-5548-9991-93fa5aa6fc96" :question/problem "The point of intersection of the lines $y=\\frac{5}{2}x+\\frac{5}{2}$ and $y=-2x+1$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=\\frac{5}{2}x+\\frac{5}{2}$ and $y=-2x+1.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=\\frac{5}{2}x+\\frac{5}{2} \\\\ y &=-2x+1\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=\\frac{5}{2}x+\\frac{5}{2}$ into the second equation $y=-2x+1$ yields an equation that we can solve for $x:$ Multiply both sides by $2$ to clear the denominators.\n\n$$\n\\begin{aligned}\\frac{5}{2}x+\\frac{5}{2} &=-2x+1 \\\\ 5x+5 &=-4x+2 \\\\ 9x &=-3 \\\\ x &=-\\frac{1}{3}\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=-\\frac{1}{3}$ back into one of the equations, say $y=-2x+1,$ as follows:\n\n$$\n\\begin{aligned}y &=-2x+1 \\\\  &=-2(-\\frac{1}{3})+1 \\\\  &=\\frac{2}{3}+1 \\\\  &=\\frac{5}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-\\frac{1}{3},\\,y=\\frac{5}{3}.$ So, the coordinates of the intersection point are $(-\\frac{1}{3},\\frac{5}{3}).$"} {:db/id #edb/ref 17592186696822 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65d455ca-fc14-5676-a883-9c493f2e5940" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186696820}] :answer-field/correct {:db/id #edb/ref 17592186696820} :answer-field/id #uuid "291ab283-8f3a-5b22-956a-483bc4b6eaa9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696815} {:answer-field/choices [{:answer/id #uuid "6da36764-d246-5fcf-a795-187f3704a068" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186696821}] :answer-field/correct {:db/id #edb/ref 17592186696821} :answer-field/id #uuid "2d569d7b-5811-51f0-8394-8dd29748a298" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696816}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "71fab742-c825-59ca-bc36-92778e9f66d1" :question/problem "The point of intersection of the lines $y=5x+2$ and $y=-x-1$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=5x+2$ and $y=-x-1.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=5x+2 \\\\ y &=-x-1\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=5x+2$ into the second equation $y=-x-1$ yields an equation that we can solve for $x:$\n\n$$\n\\begin{aligned}5x+2 &=-x-1 \\\\ 5x &=-x-3 \\\\ 6x &=-3 \\\\ x &=-\\frac{1}{2}\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=-\\frac{1}{2}$ back into one of the equations, say $y=5x+2,$ as follows:\n\n$$\n\\begin{aligned}y &=5x+2 \\\\  &=5(-\\frac{1}{2})+2 \\\\  &=-\\frac{5}{2}+2 \\\\  &=-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-\\frac{1}{2},\\,y=-\\frac{1}{2}.$ So, the coordinates of the intersection point are $(-\\frac{1}{2},-\\frac{1}{2}).$"} {:db/id #edb/ref 17592186696825 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02fca1f2-fd4b-5e42-994e-bc78e3d9683a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186696812}] :answer-field/correct {:db/id #edb/ref 17592186696812} :answer-field/id #uuid "116a14b5-768d-5792-8f25-9b540ebfc475" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696813} {:answer-field/choices [{:answer/id #uuid "8274460a-f348-5282-b8f5-b7fd74802628" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186696824}] :answer-field/correct {:db/id #edb/ref 17592186696824} :answer-field/id #uuid "da363bf9-4678-5c3c-b076-d91848a91999" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696830}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "836bb240-3ff6-5e50-834b-9f1f5b62bb43" :question/problem "The point of intersection of the lines $y=-2x+3$ and $y=x+5$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=-2x+3$ and $y=x+5.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=-2x+3 \\\\ y &=x+5\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=-2x+3$ into the second equation $y=x+5$ yields an equation that we can solve for $x:$\n\n$$\n\\begin{aligned}-2x+3 &=x+5 \\\\ -2x &=x+2 \\\\ -3x &=2 \\\\ x &=-\\frac{2}{3}\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=-\\frac{2}{3}$ back into one of the equations, say $y=x+5,$ as follows:\n\n$$\n\\begin{aligned}y &=x+5 \\\\  &=(-\\frac{2}{3})+5 \\\\  &=-\\frac{2}{3}+5 \\\\  &=\\frac{13}{3}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-\\frac{2}{3},\\,y=\\frac{13}{3}.$ So, the coordinates of the intersection point are $(-\\frac{2}{3},\\frac{13}{3}).$"} {:db/id #edb/ref 17592186696827 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "853c347a-88e1-5a7c-8896-d013703ef64d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186696826}] :answer-field/correct {:db/id #edb/ref 17592186696826} :answer-field/id #uuid "3a5915e9-921f-59f3-99f1-977842ba679c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696817} {:answer-field/choices [{:answer/id #uuid "ec5b7636-b295-51c9-bd4e-c1274ecb50e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186696831}] :answer-field/correct {:db/id #edb/ref 17592186696831} :answer-field/id #uuid "61e0e38d-ec2d-57a0-99e9-8539cbcbdbfd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696819}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8843c1dd-ea1a-5973-8bdd-4ac00a2aa2c2" :question/problem "The point of intersection of the lines $y=-x+4$ and $y=-3x+9$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=-x+4$ and $y=-3x+9.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=-x+4 \\\\ y &=-3x+9\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=-x+4$ into the second equation $y=-3x+9$ yields an equation that we can solve for $x:$\n\n$$\n\\begin{aligned}-x+4 &=-3x+9 \\\\ -x &=-3x+5 \\\\ 2x &=5 \\\\ x &=\\frac{5}{2}\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=\\frac{5}{2}$ back into one of the equations, say $y=-3x+9,$ as follows:\n\n$$\n\\begin{aligned}y &=-3x+9 \\\\  &=-3(\\frac{5}{2})+9 \\\\  &=-\\frac{15}{2}+9 \\\\  &=\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{5}{2},\\,y=\\frac{3}{2}.$ So, the coordinates of the intersection point are $(\\frac{5}{2},\\frac{3}{2}).$"} {:db/id #edb/ref 17592186696829 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cfd8220-e2d6-5afa-a719-bd9b54a26959" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186696828}] :answer-field/correct {:db/id #edb/ref 17592186696828} :answer-field/id #uuid "1c397072-ebcd-59be-a4a7-5d73ba7e491e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696814} {:answer-field/choices [{:answer/id #uuid "781d3076-e17f-5f29-a13e-fa07e6abfd63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186696823}] :answer-field/correct {:db/id #edb/ref 17592186696823} :answer-field/id #uuid "46ce68b7-e569-5027-9319-6e0979f8f2e4" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696818}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "99eaea06-272d-5ad1-b74e-1576abe40c65" :question/problem "The point of intersection of the lines $y=x+4$ and $y=5x+2$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$ \n{{field-2}}\n$).$" :question/worked-solution "The point of intersection consists of the coordinates $(x,y)$ that satisfy both equations $y=x+4$ and $y=5x+2.$ So, we need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}y &=x+4 \\\\ y &=5x+2\\end{aligned}\\right.\n$$\n\nWe can solve this system by substitution. Substituting the first equation $y=x+4$ into the second equation $y=5x+2$ yields an equation that we can solve for $x:$\n\n$$\n\\begin{aligned}x+4 &=5x+2 \\\\ x &=5x-2 \\\\ -4x &=-2 \\\\ x &=\\frac{1}{2}\\end{aligned}\n$$\n\nThis is the $x$-coordinate of the point of intersection. To find the $y$-coordinate, we substitute $x=\\frac{1}{2}$ back into one of the equations, say $y=x+4,$ as follows:\n\n$$\n\\begin{aligned}y &=x+4 \\\\  &=(\\frac{1}{2})+4 \\\\  &=\\frac{1}{2}+4 \\\\  &=\\frac{9}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{1}{2},\\,y=\\frac{9}{2}.$ So, the coordinates of the intersection point are $(\\frac{1}{2},\\frac{9}{2}).$"} {:db/id #edb/ref 17592186696879 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e266e5f-7025-58c3-9e54-ed557978fa3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\pi \\sin{\\left(2 \\right)}}{4}" :db/id #edb/ref 17592186696885} {:answer/id #uuid "7a1da077-1b6a-58c3-b903-d993197eabe8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2 + \\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696888} {:answer/id #uuid "7efa374f-3b10-5ae6-bb2e-5a54120dc987" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186696889} {:answer/id #uuid "a4728647-caf0-59f3-a113-fb564992cbc6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186696896} {:answer/id #uuid "b322517c-b6d3-5c21-a085-944c5dd3e444" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\sqrt{2}" :db/id #edb/ref 17592186696899}] :answer-field/correct {:db/id #edb/ref 17592186696899} :answer-field/id #uuid "49fe6b28-f5ea-5f9b-8c50-7b11d696d453" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186696883}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "31582087-7497-5a02-8271-e41ad7e2cb50" :question/problem "Evaluate the real-valued function\n\n$$\nf(x,y)=x\\cdot \\sin\\left(y\\right)\n$$\n\nat the point $(-2,\\frac{\\pi}{4})$." :question/worked-solution "Substitute $x=-2$ and $y=\\frac{\\pi}{4}$ throughout the expression. Keep parentheses around signed inputs:\n\n$$\nf(-2,\\frac{\\pi}{4})=(-2)\\cdot \\sin\\left(\\frac{\\pi}{4}\\right)\n$$\n\nEvaluate the inner operations before combining them:\n\n$$\n\\begin{aligned}\n\\sin\\left(\\frac{\\pi}{4}\\right) &=\\frac{\\sqrt{2}}{2} \\\\\n(-2)\\cdot \\sin\\left(\\frac{\\pi}{4}\\right) &=- \\sqrt{2}\n\\end{aligned}\n$$\n\nThus $f(-2,\\frac{\\pi}{4})=- \\sqrt{2}$."} {:db/id #edb/ref 17592186696919 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a0cd06-54cd-5e77-b187-b69bffb64a4c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{10}{3}" :db/id #edb/ref 17592186696920}] :answer-field/correct {:db/id #edb/ref 17592186696920} :answer-field/id #uuid "c0d0447f-1411-5ccd-bc0c-d667f08a2ec5" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696922} {:answer-field/choices [{:answer/id #uuid "51202540-0e91-5df4-b5d3-af9e2e3a9e87" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{3}" :db/id #edb/ref 17592186696918}] :answer-field/correct {:db/id #edb/ref 17592186696918} :answer-field/id #uuid "c9c7f65b-d7f1-56b0-b061-028fc6f17463" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696923}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "567cfc62-1ec5-5a62-baf9-6240533b7779" :question/problem "The lines $2x+y=b$ and $x-2y=2b$ intersect at the point $C$ with coordinates $(a,2)$. Find the parameters $a$ and $b$. Give exact answers.\n\n$a=$\n{{field-1}}\n$,\\,b=$\n{{field-2}}" :question/worked-solution "The point $C=(a,2)$ lies on both lines, so substitute $x=a$ and $y=2$ into the system:\n\n$$\n\\left\\{\\begin{aligned}2x+y &=b \\\\ x-2y &=2b\\end{aligned}\\right.\n$$\n\nThis gives\n\n$$\n\\left\\{\\begin{aligned}2a+2 &=b \\\\ a-4 &=2b\\end{aligned}\\right.\n$$\n\nBoth equations involve $a$ and $b$. Express $b$ using the first equation, then substitute that expression into the second:\n\n$$\n\\begin{aligned}a-4&=2(2a+2) \\\\ a-4&=4a+4 \\\\ -8&=3a \\\\ a&=-\\frac{8}{3}\\end{aligned}\n$$\n\nSubstitute this value into $b=2a+2$:\n\n$$\n\\begin{aligned}b&=2\\left(-\\frac{8}{3}\\right)+2 \\\\ b&=-\\frac{16}{3}+\\frac{6}{3} \\\\ b&=-\\frac{10}{3}\\end{aligned}\n$$\n\nTherefore, $a=-\\frac{8}{3}$ and $b=-\\frac{10}{3}$. Check $C=(-\\frac{8}{3},2)$ in both lines:\n\n$$\n\\begin{aligned}2\\left(-\\frac{8}{3}\\right)+2&=-\\frac{10}{3}=b \\\\ -\\frac{8}{3}-2(2)&=-\\frac{20}{3}=2b\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186696997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5b0c3ec-191b-5579-b944-4695685199a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186697017}] :answer-field/correct {:db/id #edb/ref 17592186697017} :answer-field/id #uuid "2ca0d1aa-dd57-50e4-ac6e-e24cda28614b" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186696999} {:answer-field/choices [{:answer/id #uuid "dff1c6c8-347b-5e9a-bd15-fb29f86bb031" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186697014}] :answer-field/correct {:db/id #edb/ref 17592186697014} :answer-field/id #uuid "cdeee4c3-e2c4-5cf5-b857-78818a55c16c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697013}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "074c3445-dd1e-50b3-a72b-410246ecfa92" :question/problem "The point of intersection of the lines $2x-2y=-1$ and $4x-3y=-4$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}2x-2y &=-1 \\\\ 4x-3y &=-4\\end{aligned}\\right.\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $-2$, then its $x$-term becomes $-4x$, which cancels the $x$-term in the other equation.\n\n$$\n\\left\\{\\begin{aligned}-4x+4y &=2 \\\\ 4x-3y &=-4\\end{aligned}\\right.\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y$:\n\n$$\n\\begin{aligned}(4y-3y) &=(2-4) \\\\ y &=-2 \\\\ y &=-2\\end{aligned}\n$$\n\nFinally, we can substitute $y=-2$ into the first equation $2x-2y=-1$ to solve for $x$:\n\n$$\n\\begin{aligned}-2(-2)+2x &=-1 \\\\ 2x &=-5 \\\\ x &=-\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-\\frac{5}{2},\\,y=-2$. So the coordinates of the point of intersection are $(-\\frac{5}{2},-2)$."} {:db/id #edb/ref 17592186697000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d291312-580d-5e18-a110-048d8935bbda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186696998}] :answer-field/correct {:db/id #edb/ref 17592186696998} :answer-field/id #uuid "751ba956-9512-55d3-9e2e-82eba9c7b157" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697005} {:answer-field/choices [{:answer/id #uuid "94ae1c5d-b08d-5fb2-afa5-559c715b629b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186697007}] :answer-field/correct {:db/id #edb/ref 17592186697007} :answer-field/id #uuid "99f5eee8-1a6b-5113-9e71-a5d3ca1bb638" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697009}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "36f23b6b-f88b-55a5-8621-7ec2dd9529ab" :question/problem "The point of intersection of the lines $-2x-2y=3$ and $-6x-4y=1$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}-2x-2y &=3 \\\\ -6x-4y &=1\\end{aligned}\\right.\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $-3$, then its $x$-term becomes $6x$, which cancels the $x$-term in the other equation.\n\n$$\n\\left\\{\\begin{aligned}6x+6y &=-9 \\\\ -6x-4y &=1\\end{aligned}\\right.\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y$:\n\n$$\n\\begin{aligned}(6y-4y) &=(-9+1) \\\\ 2y &=-8 \\\\ y &=-4\\end{aligned}\n$$\n\nFinally, we can substitute $y=-4$ into the first equation $-2x-2y=3$ to solve for $x$:\n\n$$\n\\begin{aligned}-2(-4)-2x &=3 \\\\ -2x &=-5 \\\\ x &=\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{5}{2},\\,y=-4$. So the coordinates of the point of intersection are $(\\frac{5}{2},-4)$."} {:db/id #edb/ref 17592186697003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f84cbf91-a3a3-58a2-b5df-3614d85d069a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186697019}] :answer-field/correct {:db/id #edb/ref 17592186697019} :answer-field/id #uuid "97dadec5-2946-539b-82aa-07c86a57d78f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697008} {:answer-field/choices [{:answer/id #uuid "70f8ccb4-a4ce-520b-a88f-cc8aa3eb9cf7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186697004}] :answer-field/correct {:db/id #edb/ref 17592186697004} :answer-field/id #uuid "a5aec69c-c5c9-5119-857f-7adc3d9a881a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697010}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5cce93ac-021f-5b37-a3da-997a9792550f" :question/problem "The point of intersection of the lines $3x-2y=0$ and $4x-6y=5$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}3x-2y &=0 \\\\ 4x-6y &=5\\end{aligned}\\right.\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the first equation by $-3$, then its $y$-term becomes $6y$, which cancels the $y$-term in the other equation.\n\n$$\n\\left\\{\\begin{aligned}-9x+6y &=0 \\\\ 4x-6y &=5\\end{aligned}\\right.\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x$:\n\n$$\n\\begin{aligned}(-9x+4x) &=(0+5) \\\\ -5x &=5 \\\\ x &=-1\\end{aligned}\n$$\n\nFinally, we can substitute $x=-1$ into the second equation $4x-6y=5$ to solve for $y$:\n\n$$\n\\begin{aligned}4(-1)-6y &=5 \\\\ -6y &=9 \\\\ y &=-\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=-1,\\,y=-\\frac{3}{2}$. So the coordinates of the point of intersection are $(-1,-\\frac{3}{2})$."} {:db/id #edb/ref 17592186697011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f027328d-6142-5a99-adc0-38baabb83109" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186697015}] :answer-field/correct {:db/id #edb/ref 17592186697015} :answer-field/id #uuid "f06d9ba6-7edc-5102-8365-2f76b96c41b3" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697016} {:answer-field/choices [{:answer/id #uuid "4c4399d9-09b8-59d3-a81f-25f59a3a3d5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186697001}] :answer-field/correct {:db/id #edb/ref 17592186697001} :answer-field/id #uuid "f8a1a80c-a906-5c1b-b252-0838f89cf432" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697020}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "b17e02ba-9cb1-5d26-9f49-e919788a62f2" :question/problem "The point of intersection of the lines $2x+4y=-6$ and $4x+2y=-3$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}2x+4y &=-6 \\\\ 4x+2y &=-3\\end{aligned}\\right.\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $-2$, then its $y$-term becomes $-4y$, which cancels the $y$-term in the other equation.\n\n$$\n\\left\\{\\begin{aligned}2x+4y &=-6 \\\\ -8x-4y &=6\\end{aligned}\\right.\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x$:\n\n$$\n\\begin{aligned}(2x-8x) &=(-6+6) \\\\ -6x &=0 \\\\ x &=0\\end{aligned}\n$$\n\nFinally, we can substitute $x=0$ into the second equation $4x+2y=-3$ to solve for $y$:\n\n$$\n\\begin{aligned}4(0)+2y &=-3 \\\\ 2y &=-3 \\\\ y &=-\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=0,\\,y=-\\frac{3}{2}$. So the coordinates of the point of intersection are $(0,-\\frac{3}{2})$."} {:db/id #edb/ref 17592186697012 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "886a8c28-3aa0-5b17-adba-6e8283934722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186697006}] :answer-field/correct {:db/id #edb/ref 17592186697006} :answer-field/id #uuid "5776dbf1-46f0-5dc6-9840-5cf787664ffc" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697002} {:answer-field/choices [{:answer/id #uuid "03008eb8-f29c-5a7d-a341-7827b1e668e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186696996}] :answer-field/correct {:db/id #edb/ref 17592186696996} :answer-field/id #uuid "f5e60bac-8cdd-5cb6-ad31-197ea515fc4d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186697018}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2072efc-df93-515d-b886-932e1af4ed68" :question/problem "The point of intersection of the lines $4x-2y=3$ and $x-y=1$ has coordinates\n\n$\\,($\n{{field-1}}\n$,$\n{{field-2}}\n$).$" :question/worked-solution "We need to solve the system of equations consisting of the two lines:\n\n$$\n\\left\\{\\begin{aligned}4x-2y &=3 \\\\ x-y &=1\\end{aligned}\\right.\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $-2$, then its $y$-term becomes $2y$, which cancels the $y$-term in the other equation.\n\n$$\n\\left\\{\\begin{aligned}4x-2y &=3 \\\\ -2x+2y &=-2\\end{aligned}\\right.\n$$\n\nAdding the two equations eliminates the $y$-variable and allows us to solve for $x$:\n\n$$\n\\begin{aligned}(4x-2x) &=(3-2) \\\\ 2x &=1 \\\\ x &=\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we can substitute $x=\\frac{1}{2}$ into the first equation $4x-2y=3$ to solve for $y$:\n\n$$\n\\begin{aligned}4\\left(\\frac{1}{2}\\right)-2y &=3 \\\\ -2y &=1 \\\\ y &=-\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{1}{2},\\,y=-\\frac{1}{2}$. So the coordinates of the point of intersection are $(\\frac{1}{2},-\\frac{1}{2})$."} {:answer/id #uuid "388cd6e5-6e05-560f-bf22-d2cf95c986e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{5}{2},-\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697865} {:db/id #edb/ref 17592186697866 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388cd6e5-6e05-560f-bf22-d2cf95c986e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{5}{2},-\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697865} {:answer/id #uuid "6415c56d-3a9e-5e05-a2a4-e4f46a9ccf95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle -\\frac{7}{2},\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697870} {:answer/id #uuid "9b56bb05-0be5-5591-87d5-a1ae7e0ac4be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{2},-\\frac{1}{2},-1\\rangle" :db/id #edb/ref 17592186697878} {:answer/id #uuid "d0327256-a694-5eef-a281-ad46733eee50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{7}{2},\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697882} {:answer/id #uuid "d16995ed-131e-5a46-a49b-14bada5dba52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle -\\frac{1}{2},\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697883}] :answer-field/correct {:db/id #edb/ref 17592186697882} :answer-field/id #uuid "862a2e79-45cc-5512-a6cd-c13be18cb956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186697875}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "41e7c2ff-6ab2-51cd-b555-6f8020f94ebf" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\left[\\begin{array}{ccc|c}1 & -1 & -1 & 2 \\\\ 0 & 1 & -\\frac{1}{2} & 0 \\\\ 0 & 0 & 1 & 1\\end{array}\\right]\n$$\n\nThe variable columns are ordered $x,y,z$. Select the solution vector in that order." :question/worked-solution "The matrix represents the system\n\n$$\n\\left\\{\\begin{aligned}x-y-z &=2 \\\\ y-\\frac{1}{2}z &=0 \\\\ z &=1\\end{aligned}\\right.\n$$\n\nThe bottom equation gives $z=1$.\n\nSubstitute the known values into the next equation above:\n\n$$\n\\begin{aligned}y-\\frac{1}{2}\\left(1\\right)&=0 \\\\ y&=0 + \\frac{1}{2}\\left(1\\right) \\\\ y&=\\frac{1}{2}\\end{aligned}\n$$\n\n\n\nSubstitute the known values into the first equation:\n\n$$\n\\begin{aligned}x-\\left(\\frac{1}{2}\\right)-\\left(1\\right)&=2 \\\\ x&=2 + \\left(\\frac{1}{2}\\right) + \\left(1\\right) \\\\ x&=\\frac{7}{2}\\end{aligned}\n$$\n\n\n\nThus the solution vector is $\\langle \\frac{7}{2},\\frac{1}{2},1\\rangle$."} {:answer/id #uuid "6415c56d-3a9e-5e05-a2a4-e4f46a9ccf95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle -\\frac{7}{2},\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697870} {:answer/id #uuid "9b56bb05-0be5-5591-87d5-a1ae7e0ac4be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{2},-\\frac{1}{2},-1\\rangle" :db/id #edb/ref 17592186697878} {:answer/id #uuid "d0327256-a694-5eef-a281-ad46733eee50" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{7}{2},\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697882} {:answer/id #uuid "d16995ed-131e-5a46-a49b-14bada5dba52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle -\\frac{1}{2},\\frac{1}{2},1\\rangle" :db/id #edb/ref 17592186697883} {:db/id #edb/ref 17592186699144 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b183eb9-d4c7-5c8f-b895-2178bc1b54ee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1 + \\frac{\\pi}{2}" :db/id #edb/ref 17592186699122} {:answer/id #uuid "56bc0705-7448-52ae-854e-4fafb563c113" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186699139} {:answer/id #uuid "6004465d-a128-52ee-ad8a-f85f3ba55ebe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9 \\pi}{16}" :db/id #edb/ref 17592186699140} {:answer/id #uuid "83698164-b262-5351-9534-a11eb21a20b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1 + \\frac{\\pi}{2}" :db/id #edb/ref 17592186699143} {:answer/id #uuid "9701d1af-c558-5fc6-bb75-b77b4229312b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186699148}] :answer-field/correct {:db/id #edb/ref 17592186699143} :answer-field/id #uuid "2d567bde-8205-583d-8144-3c7df1d5d53b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699130}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8bfa4687-ea8e-5445-b5aa-82f3155d1dbc" :question/problem "For $f(x,y)=x \\tan{\\left(x y^{2} \\right)}$, evaluate $f_x(\\frac{\\pi}{16},-2)$. Assume $\\cos(x y^{2})\\ne0$." :question/worked-solution "Differentiate with respect to $x$, treating $y$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=x,\\quad v=\\tan{\\left(x y^{2} \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_x&=1\\\\\nv_x&=y^{2} \\sec^{2}{\\left(x y^{2} \\right)}\\\\\nr_x&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_x&=C(u_xv+uv_x)+r_x\\\\\n&=1\\left[\\left(1\\right)\\left(\\tan{\\left(x y^{2} \\right)}\\right)+\\left(x\\right)\\left(y^{2} \\sec^{2}{\\left(x y^{2} \\right)}\\right)\\right]+\\left(0\\right)\\\\\n&=x y^{2} \\sec^{2}{\\left(x y^{2} \\right)} + \\tan{\\left(x y^{2} \\right)}\n\\end{aligned}\n$$\n\nNow substitute $x=\\frac{\\pi}{16}$ and $y=-2$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_x(\\frac{\\pi}{16},-2)&=\\left(1\\right)\\left(1\\right)+\\left(\\frac{\\pi}{16}\\right)\\left(8\\right)\\\\\n&=1 + \\frac{\\pi}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186699145 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a01521e-28fe-55d5-9258-e8c15ab0dfba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699126} {:answer/id #uuid "3a4133ab-2447-506f-860f-6797538c4336" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi^{2}}{8} + \\frac{\\pi}{2}" :db/id #edb/ref 17592186699133} {:answer/id #uuid "3d9e9e86-d222-53ac-a373-6b409e8b0553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186699135} {:answer/id #uuid "c219ef8d-3a55-51ac-887b-f586199f99e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi^{2}}{8} + \\pi" :db/id #edb/ref 17592186699149} {:answer/id #uuid "dc99b071-0a75-5b1b-b245-268d0529efd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2} + \\frac{\\pi^{2}}{4}" :db/id #edb/ref 17592186699151}] :answer-field/correct {:db/id #edb/ref 17592186699133} :answer-field/id #uuid "17511e64-76db-588b-9f95-a34f5735e8db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699125}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8fd87939-2c31-5ef4-853f-ca1c06299873" :question/problem "For $f(x,y)=y^{2} \\tan{\\left(x^{2} y \\right)}$, evaluate $f_y(-1,- \\frac{\\pi}{4})$. Assume $\\cos(x^{2} y)\\ne0$." :question/worked-solution "Differentiate with respect to $y$, treating $x$ as constant. Write $f=Cuv+r$, where\n\n$$\n\\begin{aligned}\nC&=1,\\quad r=0\\\\\nu&=y^{2},\\quad v=\\tan{\\left(x^{2} y \\right)}\n\\end{aligned}\n$$\n\nUsing the power, sum, and chain rules on the active factors gives\n\n$$\n\\begin{aligned}\nu_y&=2 y\\\\\nv_y&=x^{2} \\sec^{2}{\\left(x^{2} y \\right)}\\\\\nr_y&=0\n\\end{aligned}\n$$\n\nApply both terms of the product rule:\n\n$$\n\\begin{aligned}\nf_y&=C(u_yv+uv_y)+r_y\\\\\n&=1\\left[\\left(2 y\\right)\\left(\\tan{\\left(x^{2} y \\right)}\\right)+\\left(y^{2}\\right)\\left(x^{2} \\sec^{2}{\\left(x^{2} y \\right)}\\right)\\right]+\\left(0\\right)\\\\\n&=x^{2} y^{2} \\sec^{2}{\\left(x^{2} y \\right)} + 2 y \\tan{\\left(x^{2} y \\right)}\n\\end{aligned}\n$$\n\nNow substitute $x=-1$ and $y=- \\frac{\\pi}{4}$ and combine the exact values:\n\n$$\n\\begin{aligned}\nf_y(-1,- \\frac{\\pi}{4})&=\\left(- \\frac{\\pi}{2}\\right)\\left(-1\\right)+\\left(\\frac{\\pi^{2}}{16}\\right)\\left(2\\right)\\\\\n&=\\frac{\\pi^{2}}{8} + \\frac{\\pi}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186699492 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2caf5535-3310-57e1-b98e-4aa38842998f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699477} {:answer/id #uuid "3088fa28-fb09-57e4-b619-db7616e9c92b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\pi \\left(\\frac{1}{2} + \\pi\\right)" :db/id #edb/ref 17592186699478} {:answer/id #uuid "3514a087-1faf-5c90-a1d7-664a33ce5956" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi \\left(- \\pi - 1\\right)" :db/id #edb/ref 17592186699480} {:answer/id #uuid "7c4a4e6e-8092-5761-a760-9474b2b04591" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi \\left(-1 + \\pi\\right)}{2}" :db/id #edb/ref 17592186699488} {:answer/id #uuid "7e686f23-d883-57f4-8e07-ffdb32be8b4d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 \\pi - 1" :db/id #edb/ref 17592186699490}] :answer-field/correct {:db/id #edb/ref 17592186699478} :answer-field/id #uuid "f9f20d81-bc28-506f-930d-b824026f2228" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699504}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "85fc884e-7343-5fd1-b009-771feda2a88a" :question/problem "For the function $f(x,y)=2 x^{2} y^{2} - \\cos{\\left(x y \\right)}$, evaluate $f_y(- \\frac{\\pi}{2},-1)$." :question/worked-solution "Treat $x$ as constant and differentiate with respect to $y$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=x y\\\\\n\\frac{\\partial u}{\\partial y}&=x\\\\\n\\frac{\\partial}{\\partial y}\\left(- \\cos{\\left(u \\right)}\\right)&=\\left(\\sin{\\left(u \\right)}\\right)\\cdot\\frac{\\partial u}{\\partial y}\\\\\n\\frac{\\partial}{\\partial y}\\left(2 x^{2} y^{2}\\right)&=4 x^{2} y\\\\\nf_y(x,y)&=\\left(\\sin{\\left(u \\right)}\\right)\\cdot\\left(x\\right)+\\left(4 x^{2} y\\right)\\\\\n&=4 x^{2} y + x \\sin{\\left(x y \\right)}\n\\end{aligned}\n$$\n\nSubstitute $x=- \\frac{\\pi}{2}$ and $y=-1$ after differentiating. The inner input is\n\n$$\nu_0=\\left(- \\frac{\\pi}{2}\\right) \\left(-1\\right)=\\frac{\\pi}{2}.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_y(- \\frac{\\pi}{2},-1)&=\\left(\\sin{\\left(u_0 \\right)}\\right)\\cdot\\left(- \\frac{\\pi}{2}\\right)+\\left(- \\pi^{2}\\right)\\\\\n&=\\left(1\\right)\\cdot\\left(- \\frac{\\pi}{2}\\right)+\\left(- \\pi^{2}\\right)\\\\\n&=- \\pi \\left(\\frac{1}{2} + \\pi\\right).\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."} {:db/id #edb/ref 17592186699494 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51312c46-3332-5b1b-b097-7b5e9e97daae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186699485} {:answer/id #uuid "6dc52ad2-b40f-5301-94fb-3b1c3b4c6c9d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186699486} {:answer/id #uuid "7e12c707-b42f-543f-993d-4cb0f3a4d421" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186699489} {:answer/id #uuid "920460f0-09c3-5832-834c-82859710c5ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186699493} {:answer/id #uuid "beadd131-726b-5a50-84f8-17120d0ce5a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186699498}] :answer-field/correct {:db/id #edb/ref 17592186699498} :answer-field/id #uuid "e98dd5e4-005f-5354-8b53-c0703844adde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186699501}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "94b0e1db-015a-50cb-95c7-36f75ef3bfc1" :question/problem "For the function $f(x,y)=\\cos^{2}{\\left(- x^{2} + 2 y \\right)}$, evaluate $f_x(2,\\frac{\\pi}{4} + 2)$." :question/worked-solution "Treat $y$ as constant and differentiate with respect to $x$. Apply the chain rule, and the sum and constant multiple rules where needed.\n\n$$\n\\begin{aligned}\nu&=- x^{2} + 2 y\\\\\n\\frac{\\partial u}{\\partial x}&=- 2 x\\\\\n\\frac{\\partial}{\\partial x}\\cos^2(u)&=2\\cos(u)\\cdot(-\\sin(u))\\cdot\\frac{\\partial u}{\\partial x}\\\\\nf_x(x,y)&=\\left(- 2 \\sin{\\left(u \\right)} \\cos{\\left(u \\right)}\\right)\\cdot\\left(- 2 x\\right)\\\\\n&=4 x \\sin{\\left(- x^{2} + 2 y \\right)} \\cos{\\left(- x^{2} + 2 y \\right)}\n\\end{aligned}\n$$\n\nSubstitute $x=2$ and $y=\\frac{\\pi}{4} + 2$ after differentiating. The inner input is\n\n$$\nu_0=- \\left(2\\right)^{2} + 2 \\left(\\frac{\\pi}{4} + 2\\right)=\\frac{\\pi}{2}.\n$$\n\nUsing this value in the chain factors gives\n\n$$\n\\begin{aligned}\nf_x(2,\\frac{\\pi}{4} + 2)&=\\left(- 2 \\sin{\\left(u_0 \\right)} \\cos{\\left(u_0 \\right)}\\right)\\cdot\\left(-4\\right)\\\\\n&=\\left(0\\right)\\cdot\\left(-4\\right)\\\\\n&=0.\n\\end{aligned}\n$$\n\nThese derivatives apply for all real $x,y$."} {:db/id #edb/ref 17592186700218 :question/answer-fields [{:answer-field/choices [{:answer/feedback "Subtract the cross-partials rather than adding them." :answer/id #uuid "0c9792b2-dda7-5356-ad4b-ee003cf76f8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{5 \\pi}{2}" :db/id #edb/ref 17592186700201} {:answer/feedback "This reverses the subtraction. Use $Q_x-P_y$." :answer/id #uuid "2751cef5-1b86-55b5-9b52-e4fd240f371c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{7 \\pi}{2}" :db/id #edb/ref 17592186700206} {:answer/feedback "This uses $Q_y-P_x$, with the differentiation variables interchanged." :answer/id #uuid "9d509e31-c5a9-516e-b60a-78092da9e99a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\pi" :db/id #edb/ref 17592186700214} {:answer/feedback "This keeps only $Q_x$; the $P_y$ contribution is also required." :answer/id #uuid "c08e32f8-b57b-5fb8-be0e-663790fef749" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi}{2}" :db/id #edb/ref 17592186700219} {:answer/feedback "Correct: subtract $P_y$ from $Q_x$." :answer/id #uuid "d80c4d65-fcf6-50d6-8f9b-3fe1521d3067" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7 \\pi}{2}" :db/id #edb/ref 17592186700224}] :answer-field/correct {:db/id #edb/ref 17592186700224} :answer-field/id #uuid "ac7b8dff-f547-5a57-a7d4-288bcd28b466" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186700217}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bda0cb5e-5897-5e3b-92ef-3505267c1fea" :question/problem "Given the vector field $\\mathbf F(x,y)=\\left(- 4 x^{2} - 3 y^{2}\\right)\\,\\mathbf i+\\left(- y^{2} + \\sin{\\left(x y \\right)}\\right)\\,\\mathbf j$, evaluate its scalar curl at $(0,\\frac{\\pi}{2})$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, the **scalar curl** is $Q_x-P_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nQ_x&=\\frac{\\partial}{\\partial x}\\left(- y^{2} + \\sin{\\left(x y \\right)}\\right)\\\\\n&=y \\cos{\\left(x y \\right)}\\\\\nP_y&=\\frac{\\partial}{\\partial y}\\left(- 4 x^{2} - 3 y^{2}\\right)\\\\\n&=- 6 y\\\\\nQ_x-P_y&=\\left(y \\cos{\\left(x y \\right)}\\right)-\\left(- 6 y\\right)\\\\\n&=y \\cos{\\left(x y \\right)} + 6 y\n\\end{aligned}\n$$\n\nDifferentiate first, then substitute the point:\n\n$$\n\\begin{aligned}\n(Q_x-P_y)(0,\\frac{\\pi}{2})&=\\left(\\frac{\\pi}{2}\\right)-\\left(- 3 \\pi\\right)\\\\\n&=\\frac{7 \\pi}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186700229 :question/answer-fields [{:answer-field/choices [{:answer/feedback "The sign of the first cross-partial has been reversed." :answer/id #uuid "109eb2b7-de8a-502a-994c-4383244f2fce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186700202} {:answer/feedback "Subtract the cross-partials rather than adding them." :answer/id #uuid "15fdcc4c-7c15-5715-9db2-4680b05b2c32" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{2}" :db/id #edb/ref 17592186700203} {:answer/feedback "This keeps only $-P_y$; the $Q_x$ contribution is also required." :answer/id #uuid "9ee3c439-0db1-5d31-8226-9810a81050df" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186700215} {:answer/feedback "This is the divergence $P_x+Q_y$, not scalar curl." :answer/id #uuid "c774962e-2fb9-53e4-a52a-ce05b1a3a6a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186700220} {:answer/feedback "Correct: subtract $P_y$ from $Q_x$." :answer/id #uuid "f2f0dd72-dce9-50ab-ae93-cc6a143c967e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186700226}] :answer-field/correct {:db/id #edb/ref 17592186700226} :answer-field/id #uuid "0bcfd9c2-e459-5b38-8e6c-13e0ac74c87f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186700199}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f87f6483-9b83-53cd-b96c-e7b791dc63ea" :question/problem "Given the vector field $\\mathbf F(x,y)=\\left(- x^{2} - 3 \\ln{\\left(x + y \\right)}\\right)\\,\\mathbf i+\\left(3 x y + 2 y^{2}\\right)\\,\\mathbf j$, defined where $x+y>0$, evaluate its scalar curl at $(0,\\frac{1}{2})$." :question/worked-solution "For $\\mathbf F=P\\,\\mathbf i+Q\\,\\mathbf j$, the **scalar curl** is $Q_x-P_y$. Hold the other coordinate constant in each partial derivative.\n\n$$\n\\begin{aligned}\nQ_x&=\\frac{\\partial}{\\partial x}\\left(3 x y + 2 y^{2}\\right)\\\\\n&=3 y\\\\\nP_y&=\\frac{\\partial}{\\partial y}\\left(- x^{2} - 3 \\ln{\\left(x + y \\right)}\\right)\\\\\n&=- \\frac{3}{x + y}\\\\\nQ_x-P_y&=\\left(3 y\\right)-\\left(- \\frac{3}{x + y}\\right)\\\\\n&=3 y + \\frac{3}{x + y}\n\\end{aligned}\n$$\n\nDifferentiate first, then substitute the point:\n\n$$\n\\begin{aligned}\n(Q_x-P_y)(0,\\frac{1}{2})&=\\left(\\frac{3}{2}\\right)-\\left(-6\\right)\\\\\n&=\\frac{15}{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701097 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c21b08c-6569-5a70-9eab-5ab764295e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\sqrt{30}}{108}" :db/id #edb/ref 17592186701105} {:answer/id #uuid "43020db3-5943-5475-9919-0d602f443458" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\sqrt{30}}{3}" :db/id #edb/ref 17592186701106} {:answer/id #uuid "80ae634d-389d-5b49-8bbf-e00839bfb9ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{10 \\sqrt{3}}{3}" :db/id #edb/ref 17592186701115} {:answer/id #uuid "8ea070e5-5022-53a7-8782-c4c0a56f7b8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\sqrt{30}}{120}" :db/id #edb/ref 17592186701118} {:answer/id #uuid "b19ffb40-1a41-577e-b157-d65d7caa5566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\sqrt{30}}{18}" :db/id #edb/ref 17592186701123}] :answer-field/correct {:db/id #edb/ref 17592186701106} :answer-field/id #uuid "79c8b8d8-6162-596d-9a0c-1809a555fa8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186701112}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00b17c43-8b90-5d56-be0c-96bcd18391ca" :question/problem "Evaluate the line integral of $f(x,y)=- 2 \\cos{\\left(x \\right)}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 t^{2},- t^{2}\\rangle,\\qquad 0\\le t\\le \\sqrt{\\frac{\\pi}{9}}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 t^{2})\\,i+(- t^{2})\\,j$, then along the curve we have $x=3 t^{2}$, $y=- t^{2}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 t^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(- t^{2})\\,j \\\\  & =(6 t)\\,i+(- 2 t)\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(6 t)^2+(- 2 t)^2} \\\\  & =\\sqrt{40 t^{2}} \\\\  & =2 \\sqrt{10}|t| \\\\  & =2 \\sqrt{10} t\\end{aligned}\n$$\n\nNotice that $|t|=t$ because $t\\geq0$ along the path of $C.$\n\nNow, since $f(x,y)=- 2 \\cos{\\left(x \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =- 2 \\cos{\\left(3 t^{2} \\right)}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\sqrt{\\frac{\\pi}{9}}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\sqrt{\\frac{\\pi}{9}}}(- 2 \\cos{\\left(3 t^{2} \\right)})(2 \\sqrt{10} t)\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=3 t^{2}$, $\\text{d}u=(6 t)\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{0}^{\\frac{\\pi}{3}}- \\frac{2 \\sqrt{10}}{3}\\cdot \\cos u\\,\\text{d}u \\\\  & =- \\frac{2 \\sqrt{10}}{3}\\sin u\\big|_{0}^{\\frac{\\pi}{3}} \\\\  & =- \\frac{2 \\sqrt{10}}{3}[\\sin\\left(\\frac{\\pi}{3}\\right)-\\sin(0)] \\\\  & =- \\frac{2 \\sqrt{10}}{3}[\\left(\\frac{\\sqrt{3}}{2}\\right)-(0)] \\\\  & =\\left(- \\frac{\\sqrt{30}}{3}\\right)-(0) \\\\  & =- \\frac{\\sqrt{30}}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd13bde-6d9e-5c3e-a4e5-cbd2a122ea69" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{125}{72}" :db/id #edb/ref 17592186701102} {:answer/id #uuid "54b220d4-3608-58cb-9d7f-6065d629f80a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{72}" :db/id #edb/ref 17592186701108} {:answer/id #uuid "8567bcad-90d3-51dd-ad8a-5da667384e2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{125}{24}" :db/id #edb/ref 17592186701117} {:answer/id #uuid "9f0f8bf8-39e8-514b-a0ba-920b358a7e31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3125}{72}" :db/id #edb/ref 17592186701120} {:answer/id #uuid "ba61f66e-7d07-534c-a9db-793099510320" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{625}{72}" :db/id #edb/ref 17592186701125}] :answer-field/correct {:db/id #edb/ref 17592186701102} :answer-field/id #uuid "0e8991dd-c0bc-5bd8-8dde-990f2b621f47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186701101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4b2c3d27-3ea7-5c92-afe5-8617224ddffe" :question/problem "Evaluate the line integral of $f(x,y)=\\frac{x^{2}}{3} + \\frac{y^{2}}{3}$ along the curve\n\n$$\n\\mathbf r(t)=\\langle 3 \\sin{\\left(t \\right)},- 4 \\sin{\\left(t \\right)}\\rangle,\\qquad 0\\le t\\le \\frac{\\pi}{6}.\n$$\n\nGive the exact value." :question/worked-solution "To calculate the line integral, we will use the formula\n\n$$\n\\begin{aligned}\\int_C f\\,\\text{d}s &=\\int_a^b f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t.\\end{aligned}\n$$\n\nSince $r(t)=(3 \\sin{\\left(t \\right)})\\,i+(- 4 \\sin{\\left(t \\right)})\\,j$, then along the curve we have $x=3 \\sin{\\left(t \\right)}$, $y=- 4 \\sin{\\left(t \\right)}$.\n\nComputing $r'(t)$ and $\\|r'(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r'(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3 \\sin{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(- 4 \\sin{\\left(t \\right)})\\,j \\\\  & =(3 \\cos{\\left(t \\right)})\\,i+(- 4 \\cos{\\left(t \\right)})\\,j \\\\ \\|r'(t)\\| & =\\sqrt{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)^2+\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)^2} \\\\  & =\\sqrt{(3 \\cos{\\left(t \\right)})^2+(- 4 \\cos{\\left(t \\right)})^2} \\\\  & =\\sqrt{9\\cos^2 t+16\\cos^2 t} \\\\  & =\\sqrt{25 \\cos^{2}{\\left(t \\right)}} \\\\  & =5|\\cos t| \\\\  & =5 \\cos{\\left(t \\right)}\\end{aligned}\n$$\n\nNotice that $|\\cos t|=\\cos t$ because $\\cos t\\geq0$ along this interval.\n\nNow, since $f(x,y)=\\frac{x^{2}}{3} + \\frac{y^{2}}{3}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(3 \\sin{\\left(t \\right)})^2+(- 4 \\sin{\\left(t \\right)})^2}{3} \\\\  & =\\frac{9\\sin^2 t+16\\sin^2 t}{3} \\\\  & =\\frac{25 \\sin^{2}{\\left(t \\right)}}{3}\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}I & =\\int_C f\\,\\text{d}s \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}f(r(t))\\,\\|r'(t)\\|\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}\\left(\\frac{25 \\sin^{2}{\\left(t \\right)}}{3}\\right)(5 \\cos{\\left(t \\right)})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\frac{\\pi}{6}}\\frac{125 \\sin^{2}{\\left(t \\right)} \\cos{\\left(t \\right)}}{3}\\,\\text{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\sin{\\left(t \\right)}$, $\\text{d}u=(\\cos{\\left(t \\right)})\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}I & ={\\int }_{0}^{\\frac{1}{2}}\\frac{125}{3}\\cdot u^2\\,\\text{d}u \\\\  & =\\frac{125}{3}\\cdot\\frac{u^3}{3}\\big|_{0}^{\\frac{1}{2}} \\\\  & =\\frac{125}{3}[\\frac{\\left(\\frac{1}{2}\\right)^3}{3}-\\frac{(0)^3}{3}] \\\\  & =\\frac{125}{3}[\\left(\\frac{1}{24}\\right)-(0)] \\\\  & =\\left(\\frac{125}{72}\\right)-(0) \\\\  & =\\frac{125}{72}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186701626 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff78d051-c055-568c-b88e-73371f1f3b5c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x - 6) (x + 8)}{4}" :db/id #edb/ref 17592186701639}] :answer-field/correct {:db/id #edb/ref 17592186701639} :answer-field/id #uuid "50a0827f-3bda-5080-8b28-f15f33d4c6f0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186701632}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24b7e1d9-33e3-586d-8b04-263308fb535a" :question/problem "Consider the curve defined parametrically by\n\n$$\nx=2 t - 2,\\quad y=(t - 4) (t + 3),\\quad t\\in\\mathbb{R}.\n$$\n\nThe Cartesian equation is\n\n$y=$ {{field-1}}$,\\quad x\\in\\mathbb{R}.$" :question/worked-solution "Eliminate the parameter by using the $x$ equation to isolate $t$:\n\n$$\n\\begin{aligned}x &=2 t - 2 \\\\ t &=\\frac{x}{2} + 1\\end{aligned}\n$$\n\nSubstitute $t=\\frac{x}{2} + 1$ into the original $y$ expression, then simplify:\n\n$$\n\\begin{aligned}y &=((\\frac{x}{2} + 1) - 4) ((\\frac{x}{2} + 1) + 3) \\\\ &=(\\frac{x}{2} - 3) (\\frac{x}{2} + 4) \\\\ &=\\frac{(x - 6) (x + 8)}{4}\\end{aligned}\n$$\n\nThe affine $x$ equation attains every real value, so $x\\in\\mathbb{R}$.\n\nTherefore the complete Cartesian equation is\n\n$$\ny=\\frac{(x - 6) (x + 8)}{4},\\quad x\\in\\mathbb{R}.\n$$"} {:db/id #edb/ref 17592186701631 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20c220bb-6d24-5b9b-bc77-392bf4be691a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{(x + 3) (x + 9)}{4}" :db/id #edb/ref 17592186701625}] :answer-field/correct {:db/id #edb/ref 17592186701625} :answer-field/id #uuid "73f8b083-c6fa-58f8-8298-68131bfd2857" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186701633}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4308e09c-0107-5fc5-9e53-e626f645f042" :question/problem "Consider the curve defined parametrically by\n\n$$\nx=- 2 t - 5,\\quad y=- (t - 2) (t + 1),\\quad t\\in\\mathbb{R}.\n$$\n\nThe Cartesian equation is\n\n$y=$ {{field-1}}$,\\quad x\\in\\mathbb{R}.$" :question/worked-solution "Eliminate the parameter by using the $x$ equation to isolate $t$:\n\n$$\n\\begin{aligned}x &=- 2 t - 5 \\\\ t &=- \\frac{x}{2} - \\frac{5}{2}\\end{aligned}\n$$\n\nSubstitute $t=- \\frac{x}{2} - \\frac{5}{2}$ into the original $y$ expression, then simplify:\n\n$$\n\\begin{aligned}y &=-(((- \\frac{x}{2} - \\frac{5}{2}) - 2) ((- \\frac{x}{2} - \\frac{5}{2}) + 1)) \\\\ &=- (- \\frac{x}{2} - \\frac{9}{2}) (- \\frac{x}{2} - \\frac{3}{2}) \\\\ &=- \\frac{(x + 3) (x + 9)}{4}\\end{aligned}\n$$\n\nThe affine $x$ equation attains every real value, so $x\\in\\mathbb{R}$.\n\nTherefore the complete Cartesian equation is\n\n$$\ny=- \\frac{(x + 3) (x + 9)}{4},\\quad x\\in\\mathbb{R}.\n$$"} {:db/id #edb/ref 17592186701636 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fde71e2-50e2-5916-a08a-e6178995d3a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{(x - 8) (x + 1)}{9}" :db/id #edb/ref 17592186701630}] :answer-field/correct {:db/id #edb/ref 17592186701630} :answer-field/id #uuid "325e1ef7-13ac-5892-9867-c0b1e9d8a71c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186701628}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c4785928-8dd2-50a0-aed4-1cce11289a1e" :question/problem "Consider the curve defined parametrically by\n\n$$\nx=- 3 t - 1,\\quad y=t (t + 3),\\quad t\\in\\mathbb{R}.\n$$\n\nThe Cartesian equation is\n\n$y=$ {{field-1}}$,\\quad x\\in\\mathbb{R}.$" :question/worked-solution "Eliminate the parameter by using the $x$ equation to isolate $t$:\n\n$$\n\\begin{aligned}x &=- 3 t - 1 \\\\ t &=- \\frac{x}{3} - \\frac{1}{3}\\end{aligned}\n$$\n\nSubstitute $t=- \\frac{x}{3} - \\frac{1}{3}$ into the original $y$ expression, then simplify:\n\n$$\n\\begin{aligned}y &=(- \\frac{x}{3} - \\frac{1}{3}) ((- \\frac{x}{3} - \\frac{1}{3}) + 3) \\\\ &=(\\frac{8}{3} - \\frac{x}{3}) (- \\frac{x}{3} - \\frac{1}{3}) \\\\ &=\\frac{(x - 8) (x + 1)}{9}\\end{aligned}\n$$\n\nThe affine $x$ equation attains every real value, so $x\\in\\mathbb{R}$.\n\nTherefore the complete Cartesian equation is\n\n$$\ny=\\frac{(x - 8) (x + 1)}{9},\\quad x\\in\\mathbb{R}.\n$$"} {:answer/id #uuid "24588712-6e75-5337-a7f9-c47f0b63ca63" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\ln 2+\\frac{1}{2},\\,\\frac{1}{2}\\rangle" :db/id #edb/ref 17592186702131} {:answer/id #uuid "a0959a13-0727-57e7-8b32-43c76ef35150" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\ln 2+\\frac{1}{2},\\,\\ln 2+\\frac{1}{2}\\rangle" :db/id #edb/ref 17592186702143} {:answer/id #uuid "e20ebcce-8f04-5931-bd64-fcf1dcf875d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{2},\\,\\ln 2+\\frac{1}{2}\\rangle" :db/id #edb/ref 17592186702149} {:answer/id #uuid "fb6a6758-f302-5fdb-a358-1b71fb0a7051" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{2},\\,\\frac{1}{2}\\rangle" :db/id #edb/ref 17592186702150} {:db/id #edb/ref 17592186702259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41044ddf-2a72-59ef-8b6e-21709f0a3446" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^2\\sqrt{2}}{2}\\left(\\mathbf i+\\left(2-\\frac{\\pi}{4}\\right)\\,\\mathbf j-\\mathbf k\\right)" :db/id #edb/ref 17592186702246} {:answer/id #uuid "8087ffd1-93af-52fb-8908-96eb7402102f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^2\\sqrt{2}}{2}\\left(\\mathbf i+2\\,\\mathbf j-\\mathbf k\\right)" :db/id #edb/ref 17592186702254} {:answer/id #uuid "83abcbad-aa3f-5a59-b18a-bdc67abe04c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^2\\sqrt{2}}{2}\\left(\\mathbf i+\\left(2+\\frac{\\pi}{4}\\right)\\,\\mathbf j+\\mathbf k\\right)" :db/id #edb/ref 17592186702255} {:answer/id #uuid "85c38537-5185-52d2-ab07-3d88982837d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^2\\sqrt{2}}{2}\\left(2\\,\\mathbf i+\\left(1-\\frac{\\pi}{4}\\right)\\,\\mathbf j-\\mathbf k\\right)" :db/id #edb/ref 17592186702256} {:answer/id #uuid "aed08e14-a34e-5de5-8dce-6e1aab12b825" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^2\\sqrt{2}}{2}\\left(\\mathbf i+\\mathbf j-\\mathbf k\\right)" :db/id #edb/ref 17592186702258}] :answer-field/correct {:db/id #edb/ref 17592186702246} :answer-field/id #uuid "6fcc0e46-f953-56fd-a25d-5d22756bcd8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186702250}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "af1be92d-6c3b-5df7-b03e-eb365537222e" :question/problem "Evaluate $\\nabla h(x,y,z)$ at $(2,1,\\frac{\\pi}{4})$ if $h(x,y,z)=e^{xy}\\cos(yz).$" :question/worked-solution "In the $y$ partial derivative, both factors depend on $y$, so use the product rule as well as the chain rule:\n\n$$\n\\begin{aligned}h_x(x,y,z)&=ye^{xy}\\cos(yz) \\\\ h_y(x,y,z)&=xe^{xy}\\cos(yz)-ze^{xy}\\sin(yz) \\\\ h_z(x,y,z)&=-ye^{xy}\\sin(yz).\\end{aligned}\n$$\n\nAssemble the gradient in coordinate order:\n\n$$\n\\begin{aligned}\\nabla h(x,y,z)&=h_x\\,\\mathbf i+h_y\\,\\mathbf j+h_z\\,\\mathbf k \\\\\n&=ye^{xy}\\cos(yz)\\,\\mathbf i \\\\\n&\\quad+e^{xy}(x\\cos(yz)-z\\sin(yz))\\,\\mathbf j \\\\\n&\\quad-ye^{xy}\\sin(yz)\\,\\mathbf k.\n\\end{aligned}\n$$\n\nAt the stated point, $xy=2$, $yz=\\frac{\\pi}{4}$, and $\\sin\\left(\\frac{\\pi}{4}\\right)=\\cos\\left(\\frac{\\pi}{4}\\right)=\\frac{\\sqrt{2}}{2}$. Therefore,\n\n$$\n\\begin{aligned}h_x(2,1,\\tfrac{\\pi}{4})&=\\frac{e^2\\sqrt{2}}{2} \\\\\nh_y(2,1,\\tfrac{\\pi}{4})&=e^2\\left(2\\frac{\\sqrt{2}}{2}-\\frac{\\pi}{4}\\frac{\\sqrt{2}}{2}\\right) \\\\\nh_z(2,1,\\tfrac{\\pi}{4})&=-\\frac{e^2\\sqrt{2}}{2}.\n\\end{aligned}\n$$\n\nThus,\n\n$$\n\\begin{aligned}\\nabla h(2,1,\\tfrac{\\pi}{4})& \\\\\n&=\\frac{e^2\\sqrt{2}}{2}\\left(\\mathbf i+\\left(2-\\frac{\\pi}{4}\\right)\\,\\mathbf j-\\mathbf k\\right).\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186703364 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50986543-13ec-5ca6-9328-75970b994c61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\ln\\left|x^{2} + x - 2\\right|+C" :db/id #edb/ref 17592186703369} {:answer/id #uuid "bdfea21c-f5e2-5674-a333-2a57754d2e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\ln\\left|x^{2} + x - 2\\right|+C" :db/id #edb/ref 17592186703385} {:answer/id #uuid "c3d817a9-fc9d-567d-bd0c-9de917f52110" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\ln\\left|x^{2} + x - 2\\right|+C" :db/id #edb/ref 17592186703386} {:answer/id #uuid "d16049ad-33cd-5ef3-a7d2-caad935325d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}\\ln\\left|x^{2} + x - 2\\right|+C" :db/id #edb/ref 17592186703387} {:answer/id #uuid "fea3b72c-5185-5cc6-8899-933f2626f301" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{8}\\ln\\left|x^{2} + x - 2\\right|+C" :db/id #edb/ref 17592186703389}] :answer-field/correct {:db/id #edb/ref 17592186703369} :answer-field/id #uuid "9d4f6e4d-fba2-515a-b160-b2b03d5a94f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186703379}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "232aa360-52df-54c3-93c7-d1f780859df2" :question/problem "Calculate\n\n$$\n\\displaystyle \\int \\frac{x + \\frac{1}{2}}{(x + 2)(x - 1)}\\,\\mathrm{d}x.\n$$" :question/worked-solution "First expand the denominator:\n\n$$\n(x + 2)(x - 1)=x^{2} + x - 2.\n$$\n\nLet $u=x^{2} + x - 2.$ Differentiate and compare the whole numerator:\n\n$$\n\\begin{aligned}\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}&=2 x + 1 \\\\\nx + \\frac{1}{2}&=\\frac{1}{2}\\left(2 x + 1\\right).\\end{aligned}\n$$\n\nThus $(x + \\frac{1}{2})\\,\\mathrm{d}x=\\frac{1}{2}\\,\\mathrm{d}u.$ Substitute and integrate:\n\n$$\n\\begin{aligned}\n\\int \\frac{x + \\frac{1}{2}}{(x + 2)(x - 1)}\\,\\mathrm{d}x\n&=\\frac{1}{2}\\int \\frac{1}{u}\\,\\mathrm{d}u \\\\\n&=\\frac{1}{2}\\ln|u|+C \\\\\n&=\\frac{1}{2}\\ln\\left|x^{2} + x - 2\\right|+C.\\end{aligned}\n$$\n\nThe result holds on each real interval where $x^{2} + x - 2\\ne0.$ The absolute value retains both possible signs of the denominator."} {:db/id #edb/ref 17592186703942 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cd4f428-2054-5e60-810c-ab135978eb15" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{- 4 x - 2}{9 x + 4}" :db/id #edb/ref 17592186703943}] :answer-field/correct {:db/id #edb/ref 17592186703943} :answer-field/id #uuid "8da118a6-0f34-5204-a7f0-78bafec7a27c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186703946} {:answer-field/choices [{:answer/id #uuid "b38a42ef-e061-5d63-b3b2-6f802989b6c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{4}{9}" :db/id #edb/ref 17592186703949}] :answer-field/correct {:db/id #edb/ref 17592186703949} :answer-field/id #uuid "ac5a49ce-3366-5f64-a922-1a28fe1a428f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186703948}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2701513f-19c5-512b-b879-0ac0465ac508" :question/problem "Consider the curve defined parametrically by\n\n$$\nx=\\frac{2}{t - 4},\\quad y=- \\frac{t}{2 t + 1},\\quad t\\ne - \\frac{1}{2},\\quad t\\ne 4.\n$$\n\nThe Cartesian equation is\n\n$y=$ {{field-1}}$,\\quad x\\ne 0,\\quad x\\ne$ {{field-2}}." :question/worked-solution "Eliminate the parameter by using the $x$ equation to isolate $t$:\n\n$$\n\\begin{aligned}x &=\\frac{2}{t - 4} \\\\ t &=4 + \\frac{2}{x}\\end{aligned}\n$$\n\nSubstitute $t=4 + \\frac{2}{x}$ into the original $y$ expression, then simplify:\n\n$$\n\\begin{aligned}y &=-\\left(\\frac{(4 + \\frac{2}{x})}{2 (4 + \\frac{2}{x}) + 1}\\right) \\\\ &=- \\frac{4 + \\frac{2}{x}}{9 + \\frac{4}{x}} \\\\ &=\\frac{(-4 - \\frac{2}{x})(x)}{(9 + \\frac{4}{x})(x)} \\\\ &=- \\frac{2 (2 x + 1)}{9 x + 4} \\\\ &=\\frac{- 4 x - 2}{9 x + 4}\\end{aligned}\n$$\n\nThe reciprocal $x$ expression never equals $0$. The other excluded parameter value $t=- \\frac{1}{2}$ would give $x=- \\frac{4}{9}$, so it must also be excluded. The simplified formula alone does not retain every missing point.\n\nTherefore the complete Cartesian equation is\n\n$$\ny=\\frac{- 4 x - 2}{9 x + 4},\\quad x\\ne - \\frac{4}{9},\\quad x\\ne 0.\n$$"} {:db/id #edb/ref 17592186703945 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78f1d09d-e7ec-5b29-8eee-3af136884365" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 x + 2}{7 x + 4}" :db/id #edb/ref 17592186703944}] :answer-field/correct {:db/id #edb/ref 17592186703944} :answer-field/id #uuid "95f7e7cd-989f-5f3e-b510-bb58dc629e09" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186703947} {:answer-field/choices [{:answer/id #uuid "eb5aae48-070f-5e92-9cc6-eb3f5d1d2613" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{4}{7}" :db/id #edb/ref 17592186703951}] :answer-field/correct {:db/id #edb/ref 17592186703951} :answer-field/id #uuid "c7e3600c-ac6e-55d5-9031-1f3167c62d44" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186703950}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "898a649a-895d-50d6-a08e-ed9327b12610" :question/problem "Consider the curve defined parametrically by\n\n$$\nx=- \\frac{2}{t + 3},\\quad y=- \\frac{t}{1 - 2 t},\\quad t\\ne -3,\\quad t\\ne \\frac{1}{2}.\n$$\n\nThe Cartesian equation is\n\n$y=$ {{field-1}}$,\\quad x\\ne 0,\\quad x\\ne$ {{field-2}}." :question/worked-solution "Eliminate the parameter by using the $x$ equation to isolate $t$:\n\n$$\n\\begin{aligned}x &=- \\frac{2}{t + 3} \\\\ t &=-3 - \\frac{2}{x}\\end{aligned}\n$$\n\nSubstitute $t=-3 - \\frac{2}{x}$ into the original $y$ expression, then simplify:\n\n$$\n\\begin{aligned}y &=-\\left(\\frac{(-3 - \\frac{2}{x})}{1 - 2 (-3 - \\frac{2}{x})}\\right) \\\\ &=- \\frac{-3 - \\frac{2}{x}}{7 + \\frac{4}{x}} \\\\ &=\\frac{(3 + \\frac{2}{x})(x)}{(7 + \\frac{4}{x})(x)} \\\\ &=- \\frac{- 3 x - 2}{7 x + 4} \\\\ &=\\frac{3 x + 2}{7 x + 4}\\end{aligned}\n$$\n\nThe reciprocal $x$ expression never equals $0$. The other excluded parameter value $t=\\frac{1}{2}$ would give $x=- \\frac{4}{7}$, so it must also be excluded. The simplified formula alone does not retain every missing point.\n\nTherefore the complete Cartesian equation is\n\n$$\ny=\\frac{3 x + 2}{7 x + 4},\\quad x\\ne - \\frac{4}{7},\\quad x\\ne 0.\n$$"} {:db/id #edb/ref 17592186705404 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50ae996b-77ff-5c8a-a40a-5b0799d734d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{5}\\times 8^{5}" :db/id #edb/ref 17592186705405} {:answer/id #uuid "953da201-e0e1-5d48-b18a-d2f896a8077f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{7}\\times 8^{7}" :db/id #edb/ref 17592186705406} {:answer/id #uuid "a1849a42-e94b-5923-984a-b6267c99ae97" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}\\times 8^{5}" :db/id #edb/ref 17592186705407} {:answer/id #uuid "bf406eec-4727-5d43-9929-4368cf3ccfea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{2}\\times 8^{2}" :db/id #edb/ref 17592186705408} {:answer/id #uuid "df5d0b61-6d33-5a24-ae5d-829867afdaf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{5}\\times 8" :db/id #edb/ref 17592186705410}] :answer-field/correct {:db/id #edb/ref 17592186705406} :answer-field/id #uuid "c01a29fd-ea0a-5c1f-a7e9-628e2fc9d4cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705409}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "09ce318d-2b4f-5653-a2b8-2f308195d509" :question/problem "$(-\\frac{1}{3}\\times 8)^{7}=$" :question/worked-solution "To raise the product of two numbers to the power of $7$, we can raise each number to the power of $7,$ and then multiply:\n\n$$\n(-\\frac{1}{3}\\times 8)^{7}=((-\\frac{1}{3})\\times 8)^{7}=(-\\frac{1}{3})^{7}\\times 8^{7}\n$$"} {:answer/id #uuid "50ae996b-77ff-5c8a-a40a-5b0799d734d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{5}\\times 8^{5}" :db/id #edb/ref 17592186705405} {:answer/id #uuid "953da201-e0e1-5d48-b18a-d2f896a8077f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{7}\\times 8^{7}" :db/id #edb/ref 17592186705406} {:answer/id #uuid "bf406eec-4727-5d43-9929-4368cf3ccfea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{2}\\times 8^{2}" :db/id #edb/ref 17592186705408} {:answer/id #uuid "df5d0b61-6d33-5a24-ae5d-829867afdaf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\frac{1}{3})^{5}\\times 8" :db/id #edb/ref 17592186705410} {:answer/id #uuid "45e33883-a613-550b-9020-04c6a531e49a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{6 y}{\\left(x - y\\right)^{2}},\\,\\frac{6 x}{\\left(x - y\\right)^{2}}\\rangle" :db/id #edb/ref 17592186705469} {:answer/id #uuid "613f7470-6d98-5b16-a933-965545eb0f4a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle - \\frac{6 y}{\\left(x - y\\right)^{2}},\\,- \\frac{6 x}{\\left(x - y\\right)^{2}}\\rangle" :db/id #edb/ref 17592186705472} {:db/id #edb/ref 17592186705475 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4978112b-47db-5c25-91bf-0ab7a9d2df94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 3,\\,18\\rangle" :db/id #edb/ref 17592186705470} {:answer/id #uuid "8084856b-b49b-5343-b1c4-2611e011cf41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{1}{2},\\,27\\rangle" :db/id #edb/ref 17592186705478} {:answer/id #uuid "8ea1e4d0-6128-5f75-8e30-07de9a8d6e2a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 0,\\,6\\rangle" :db/id #edb/ref 17592186705481} {:answer/id #uuid "beedadae-bec0-5757-8bd6-c99812507791" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,18\\rangle" :db/id #edb/ref 17592186705490} {:answer/id #uuid "cbeb1ed2-978b-5a0a-ad43-86994ee2afd8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle - \\frac{3}{2},\\,18\\rangle" :db/id #edb/ref 17592186705492}] :answer-field/correct {:db/id #edb/ref 17592186705490} :answer-field/id #uuid "8d642ab2-4e5b-513f-9d50-b2471fa35011" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186705480}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "714cdd5e-3a09-50b7-a250-b5aa4f10711d" :question/problem "Evaluate $\\nabla f(x,y)$ at $(2,3)$ if $f(x,y)=y^{2} \\sqrt{x + 7}$. Work on the domain $x + 7>0$." :question/worked-solution "Differentiate with respect to one coordinate at a time, holding the other constant.\n\n$$\n\\begin{aligned}f_x(x,y)&=y^{2}\\cdot\\frac{1}{2\\sqrt{x + 7}} \\\\ &=\\frac{y^{2}}{2 \\sqrt{x + 7}} \\\\ f_y(x,y)&=2 y\\sqrt{x + 7} \\\\ &=2 y \\sqrt{x + 7}\\end{aligned}\n$$\n\nAssemble the partial derivatives in order:\n\n$$\n\\begin{aligned}\\nabla f(x,y)&=\\left(\\frac{y^{2}}{2 \\sqrt{x + 7}}\\right)\\,\\mathbf i \\\\ &\\quad+(2 y \\sqrt{x + 7})\\,\\mathbf j\\end{aligned}\n$$\n\nNow substitute the point:\n\n$$\n\\begin{aligned}f_x(2,3)&=\\frac{\\left(3\\right)^{2}}{2 \\sqrt{\\left(2\\right) + 7}} \\\\ &=\\frac{3}{2} \\\\ f_y(2,3)&=2 \\left(3\\right) \\sqrt{\\left(2\\right) + 7} \\\\ &=18\\end{aligned}\n$$\n\nTherefore, $\\nabla f(2,3)=\\langle \\frac{3}{2},\\,18\\rangle$."} {:answer/id #uuid "76c86401-8a33-5a3c-bc27-42e8705a4f2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle - y \\cos{\\left(x y \\right)} - \\frac{2 y^{4}}{x},\\,- x \\cos{\\left(x y \\right)} - 8 y^{3} \\ln{\\left(x \\right)}\\rangle" :db/id #edb/ref 17592186705476} {:db/id #edb/ref 17592186705477 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76c86401-8a33-5a3c-bc27-42e8705a4f2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle - y \\cos{\\left(x y \\right)} - \\frac{2 y^{4}}{x},\\,- x \\cos{\\left(x y \\right)} - 8 y^{3} \\ln{\\left(x \\right)}\\rangle" :db/id #edb/ref 1759218670547