}}{\\text{d}x}(y{e}^{3x}) & =x \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{e}^{3x})\\text{d}x & =\\int x\\,\\text{d}x \\\\ y{e}^{3x} & =\\frac{{x}^{2}}{2}+C \\\\ y & =\\frac{{x}^{2}{e}^{-3x}}{2}+C{e}^{-3x}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186686849 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67407bcb-72ad-565f-a66a-d7e08a2b703e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{- 3 x}" :db/id #edb/ref 17592186686848} {:answer/id #uuid "703ecbf7-ee1b-51b5-954b-800cc4eb5a6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{2 x}" :db/id #edb/ref 17592186686852} {:answer/id #uuid "aa9a682d-7b10-50dc-91f8-48f4f380dac3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{3 x}" :db/id #edb/ref 17592186686870} {:answer/id #uuid "f08d8bb9-5f03-5fd1-acd9-039128dfedb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "e^{6 x}" :db/id #edb/ref 17592186686879}] :answer-field/correct {:db/id #edb/ref 17592186686870} :answer-field/id #uuid "191f942b-0616-59d5-8b60-7fc4a0927035" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494} :db/id #edb/ref 17592186686835} {:answer-field/choices [{:answer/id #uuid "01e2a9fb-2513-5dcb-9ecf-525c54e77df3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 3 x} + \\frac{x^{2} e^{- 3 x}}{2}" :db/id #edb/ref 17592186686832} {:answer/id #uuid "5cc46c3b-f029-5d33-85ce-f2e12844e158" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 2 x} + \\frac{x^{2} e^{- 3 x}}{2}" :db/id #edb/ref 17592186686844} {:answer/id #uuid "71c67f33-c23b-53c9-b254-f1a1e09ee2d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 3 x} + \\frac{x^{2} e^{- 3 x}}{3}" :db/id #edb/ref 17592186686853} {:answer/id #uuid "7e96c2bb-5bf9-58ac-af9f-c0641860711e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "C e^{- 2 x} + \\frac{x^{2} e^{- 3 x}}{3}" :db/id #edb/ref 17592186686858}] :answer-field/correct {:db/id #ed