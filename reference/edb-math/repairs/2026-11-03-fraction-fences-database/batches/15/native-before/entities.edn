c-42cfe97d8242" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186732662}] :answer-field/correct {:db/id #edb/ref 17592186732662} :answer-field/id #uuid "2d82963b-1ed8-5ea0-aead-8aeb8b737580" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732651}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9da5a546-e1d1-5fc5-ba6f-72958efd9da7" :question/problem "Consider the function $f(x,y)=x^{2} + y^{2}$. What is the signed rate of change of $f$ at the point $(2,2)$ in the direction of the vector $\\mathbf v=\\langle 4,-3\\rangle$?" :question/worked-solution "The rate is the directional derivative $D_{\\mathbf u}f=\\nabla f\\cdot\\mathbf u$, with $\\mathbf u$ a unit vector.\n\nCompute the partial derivatives and evaluate them at the given point:\n\n$$\n\\begin{aligned}\nf_x(x,y)&=2 x \\\\ f_y(x,y)&=2 y \\\\ \\nabla f(2,2)&=\\langle 4,4\\rangle\n\\end{aligned}\n$$\n\nNormalize the direction vector:\n\n$$\n\\begin{aligned}\n\\|\\mathbf v\\|&=\\sqrt{(4)^2+(-3)^2}=5 \\\\ \\mathbf u&=\\langle \\frac{4}{5},- \\frac{3}{5}\\rangle\n\\end{aligned}\n$$\n\nThen take the dot product:\n\n$$\n\\begin{aligned}\nD_{\\mathbf u}f&=\\langle 4,4\\rangle\\cdot \\langle \\frac{4}{5},- \\frac{3}{5}\\rangle \\\\ &=\\frac{(4)(4)+(4)(-3)}{5} \\\\ &=\\frac{4}{5}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186732666 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bf17154-ddc4-5d0c-a6aa-f51b765be87d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186732646} {:answer/id #uuid "0d59b6a2-e102-5534-9b62-8a410d77852c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 \\sqrt{5}" :db/id #edb/ref 17592186732648} {:answer/id #uuid "24d89f6e-c641-5082-b6a3-3b98232c8b0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 \\sqrt{2}" :db/id #edb/ref 17592186732650} {:answer/id #uuid "40078383-a2e1-5c08-a03a-69bde5cae41d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 3 \\sqrt{2}" :db/id #edb/ref 17592186732654} {:answer/id #uuid "cde66307-ee79-51c7-aefc-5feb7f64a7f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\sqrt{2}" :db/id #edb/ref 17592186732668}] :answer-field/correct {:db/id #edb/ref 17592186732650} :answer-field/id #uuid "041970f9-d130-5a21-8bca-1711b9fde33c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732644}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a3b24121-1794-53de-b367-a5db4e35d13c" :question/problem "Consider the function $f(x,y)=x^{2} - y^{2}$. What is the signed rate of change of $f$ at the point $(1,2)$ in the direction of the vector $\\mathbf v=\\langle 1,-1\\rangle$?" :question/worked-solution "The rate is the directional derivative $D_{\\mathbf u}f=\\nabla f\\cdot\\mathbf u$, with $\\mathbf u$ a unit vector.\n\nCompute the partial derivatives and evaluate them at the given point:\n\n$$\n\\begin{aligned}\nf_x(x,y)&=2 x \\\\ f_y(x,y)&=- 2 y \\\\ \\nabla f(1,2)&=\\langle 2,-4\\rangle\n\\end{aligned}\n$$\n\nNormalize the direction vector:\n\n$$\n\\begin{aligned}\n\\|\\mathbf v\\|&=\\sqrt{(1)^2+(-1)^2}=\\sqrt{2} \\\\ \\mathbf u&=\\langle \\frac{\\sqrt{2}}{2},- \\frac{\\sqrt{2}}{2}\\rangle\n\\end{aligned}\n$$\n\nThen take the dot product:\n\n$$\n\\begin{aligned}\nD_{\\mathbf u}f&=\\langle 2,-4\\rangle\\cdot \\langle \\frac{\\sqrt{2}}{2},- \\frac{\\sqrt{2}}{2}\\rangle \\\\ &=\\frac{(2)(1)+(-4)(-1)}{\\sqrt{2}} \\\\ &=3 \\sqrt{2}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186732958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06534085-50f7-5a5e-80b1-3a9a77a6672c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{12y}" :db/id #edb/ref 17592186732952} {:answer/id #uuid "2b97cdf9-593b-556d-95f7-b62779d5c4d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3y}" :db/id #edb/ref 17592186732959} {:answer/id #uuid "6aed4988-67c3-5d34-927a-361d55aaf7d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12y}" :db/id #edb/ref 17592186732964} {:answer/id #uuid "9a72066e-5e22-52ea-9459-ccaef884cad6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3y}" :db/id #edb/ref 17592186732970} {:answer/id #uuid "fd0cfc88-9375-5667-a535-807b302db61f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186732985}] :answer-field/correct {:db/id #edb/ref 17592186732959} :answer-field/id #uuid "84a018e9-88d0-5423-a3ce-7ea51dd1895c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732965}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "25faaa24-b933-551a-97c9-cacdc7a53247" :question/problem "![](images/d7/d74841d94a7ec15d7f6f7a5ae50fbe18ee2c528065f1fa680e84177e9894cae1.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of $y$, for $y\\ne0$." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(6,-2).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=6$ and $y=-2$ into the equation above, we get\n\n$$\n\\begin{aligned}(-2)^{2} & =4p(6) \\\\ 4 & =24p \\\\ p & =\\frac{1}{6}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{2}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{3y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186732981 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14cc5d80-45f7-5112-b2a0-22793a453706" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3y}" :db/id #edb/ref 17592186732954} {:answer/id #uuid "1bd57efc-e1df-5b72-a8ba-79ad2e4a8ef7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186732955} {:answer/id #uuid "afb1e5e2-7c0c-5b3d-bc66-adbf1bea6875" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3y}" :db/id #edb/ref 17592186732974} {:answer/id #uuid "d28eb2ac-08bf-5355-82a9-270395884dec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8}{3y}" :db/id #edb/ref 17592186732980} {:answer/id #uuid "e6a9d536-c704-574f-b27a-069984c74a6c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3y}" :db/id #edb/ref 17592186732984}] :answer-field/correct {:db/id #edb/ref 17592186732974} :answer-field/id #uuid "a6a7cbad-e0e6-5939-82e4-1a64b171e96e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732971}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d3c46923-8c4f-5cb5-bb34-774a93ebc18b" :question/problem "![](images/b8/b8fb51bc41718ab198a3cbf8c5b2536741fdc22895bac249be398d3ae47d600c.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the right-opening parabola shown above. Express the answer in terms of $y$, for $y\\ne0$." :question/worked-solution "The diagram shows that the parabola has its vertex at $O,$ and passes through the point $(3,-2).$\n\nThe standard equation of a left- or right-opening parabola whose vertex is at $(0,0)$ is given by\n\n$$\n{y}^{2}=4px.\n$$\n\nSubstituting $x=3$ and $y=-2$ into the equation above, we get\n\n$$\n\\begin{aligned}(-2)^{2} & =4p(3) \\\\ 4 & =12p \\\\ p & =\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the equation of our parabola is \n\n$$\n{y}^{2}=\\frac{4}{3}x.\n$$\n\nFinally, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{4}{3}x) \\\\ 2y\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4}{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2}{3y}\\end{aligned}\n$$"} {:answer/id #uuid "49a0fa64-8205-5a7b-a871-5009fbe3acfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,\\frac{5}{2},\\,-4\\rangle" :db/id #edb/ref 17592186733027} {:answer/id #uuid "69fccffb-5219-5d6b-ab70-954f51a3a9a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 3,\\,- \\frac{3}{2},\\,-4\\rangle" :db/id #edb/ref 17592186733032} {:answer/id #uuid "77628660-ba4f-5486-b83e-ee453084c262" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,- \\frac{1}{2},\\,-2\\rangle" :db/id #edb/ref 17592186733036} {:answer/id #uuid "dc4ca22c-33c6-500f-961a-3686edd96d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,-4,\\,\\frac{21}{2}\\rangle" :db/id #edb/ref 17592186733045} {:db/id #edb/ref 17592186733051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49a0fa64-8205-5a7b-a871-5009fbe3acfb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,\\frac{5}{2},\\,-4\\rangle" :db/id #edb/ref 17592186733027} {:answer/id #uuid "69fccffb-5219-5d6b-ab70-954f51a3a9a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle 3,\\,- \\frac{3}{2},\\,-4\\rangle" :db/id #edb/ref 17592186733032} {:answer/id #uuid "77628660-ba4f-5486-b83e-ee453084c262" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,- \\frac{1}{2},\\,-2\\rangle" :db/id #edb/ref 17592186733036} {:answer/id #uuid "dc4ca22c-33c6-500f-961a-3686edd96d5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle \\frac{3}{2},\\,-4,\\,\\frac{21}{2}\\rangle" :db/id #edb/ref 17592186733045} {:answer/id #uuid "fd23901e-a9d3-5184-a6a1-b9f760e7ab2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle - \\frac{3}{2},\\,- \\frac{1}{2},\\,2\\rangle" :db/id #edb/ref 17592186733053}] :answer-field/correct {:db/id #edb/ref 17592186733027} :answer-field/id #uuid "bb63fc34-4daf-5ee2-a872-fc04738869da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186733041}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "ea176f48-101b-52f9-8eca-e1d224150fad" :question/problem "In what direction does the function $f(x,y,z)=- 3 \\ln{\\left(y - x \\right)} + y z^{2}$ increase most rapidly at the point $(-1,1,-2)$?" :question/worked-solution "A differentiable function increases most rapidly in the direction of its gradient.\n\nCompute the partial derivatives, holding the other variables constant:\n\n$$\n\\begin{aligned}\nf_{x}&=\\frac{3}{y - x}\\\\f_{y}&=z^{2} - \\frac{3}{y - x}\\\\f_{z}&=2 y z\n\\end{aligned}\n$$\n\nEvaluate each partial at the given point:\n\n$$\n\\begin{aligned}\nf_{x}(-1,1,-2)&=\\frac{3}{\\left(1\\right) - \\left(-1\\right)}\\\\&=\\frac{3}{2}\\\\f_{y}(-1,1,-2)&=\\left(-2\\right)^{2} - \\frac{3}{\\left(1\\right) - \\left(-1\\right)}\\\\&=\\frac{5}{2}\\\\f_{z}(-1,1,-2)&=2 \\left(1\\right) \\left(-2\\right)\\\\&=-4\n\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\n\\nabla f(-1,1,-2)&=\\langle \\frac{3}{2},\\,\\frac{5}{2},\\,-4\\rangle\n\\end{aligned}\n$$\n\nKeep the gradient direction.\n\n$$\n\\begin{aligned}\n\\nabla f(-1,1,-2)&=\\langle \\frac{3}{2},\\,\\frac{5}{2},\\,-4\\rangle\n\\end{aligned}\n$$\n\nAny positive multiple of this vector points in the same direction."} {:answer/id #uuid "fd23901e-a9d3-5184-a6a1-b9f760e7ab2d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\langle - \\frac{3}{2},\\,- \\frac{1}{2},\\,2\\rangle" :db/id #edb/ref 17592186733053} {:db/id #edb/ref 17592186733257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1941c393-f38a-56cb-bf11-74c1981612d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\frac{7 \\pi}{6}}^{\\frac{11 \\pi}{6}}\\int_{3}^{- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}}r^{3} \\cos{\\left(\\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186733253} {:answer/id #uuid "1b125c08-a9b9-5347-b21d-2ee4b24e2bdf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\frac{7 \\pi}{6}}^{\\frac{11 \\pi}{6}}\\int_{- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}}^{3}r^{2} \\cos{\\left(\\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186733255} {:answer/id #uuid "51f83b9e-21bb-552c-bf90-36395092be37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\frac{7 \\pi}{6}}^{\\frac{11 \\pi}{6}}\\int_{3}^{- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}}r^{2} \\cos{\\left(\\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186733262} {:answer/id #uuid "e1597a10-6c98-53cd-bbed-2446bcd2cbc5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\frac{3 \\pi}{2}}^{\\frac{11 \\pi}{6}}\\int_{3}^{- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}}r^{2} \\cos{\\left(\\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186733273} {:answer/id #uuid "f62b4b51-ed6d-55bb-8f18-a2f2609cb551" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\int_{\\frac{7 \\pi}{6}}^{\\frac{11 \\pi}{6}}\\int_{- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}}^{3}r^{3} \\cos{\\left(\\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta" :db/id #edb/ref 17592186733276}] :answer-field/correct {:db/id #edb/ref 17592186733255} :answer-field/id #uuid "c8242adf-59a8-5899-bfd2-a8f9b740b0a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186733270}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2bc8418f-0a03-5d70-a230-d87a806f479d" :question/problem "![Shaded region D](images/fe/fe24d21f22e049b1edd55c35c1e757047c6fa32e0e2be3c4e2f7b134ef455159.png)\n\nThe shaded region $D$ is inside $x^{2} + y^{2}=9$ and on the side $- y\\geq \\frac{3}{2}$ of the line.\n\nWhich integral expresses\n\n$$\n\\iint_D x\\,\\mathrm{d}A\n$$\n\nin polar coordinates, with integration in the order $\\mathrm{d}r\\,\\mathrm{d}\\theta$? Do not evaluate." :question/worked-solution "The shaded region $D$ is inside $x^{2} + y^{2}=9$ and on the side $- y\\geq \\frac{3}{2}$ of the line.\n\nUse $x=r\\cos\\theta$ and $y=r\\sin\\theta$.\n\nThe circle becomes $r^2=9$, so its radius is $r=3$.\n\nThe line $- y=\\frac{3}{2}$ becomes\n\n$$\n\\begin{aligned}r\\left(- \\sin{\\left(\\theta \\right)}\\right)&=\\frac{3}{2}\\\\r&=- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}.\\end{aligned}\n$$\n\nTo find the circle–line intersections, substitute $y=- \\frac{3}{2}$ into the circle:\n\n$$\nx^{2} + \\frac{9}{4}=9.\n$$\n\nSolving gives $x=- \\frac{3 \\sqrt{3}}{2} \\text{ or } \\frac{3 \\sqrt{3}}{2}$. The intersections are $(- \\frac{3 \\sqrt{3}}{2},- \\frac{3}{2})$ and $(\\frac{3 \\sqrt{3}}{2},- \\frac{3}{2})$, at angles $\\frac{7 \\pi}{6}$ and $\\frac{11 \\pi}{6}$.\n\nOn these rays $- \\sin{\\left(\\theta \\right)}>0$. A ray enters through the line and exits through the circle. Hence\n\n$$\n\\begin{aligned}\\frac{7 \\pi}{6}&\\leq\\theta\\leq \\frac{11 \\pi}{6},\\\\- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}&\\leq r\\leq 3.\\end{aligned}\n$$\n\n![Entry and exit along a ray](images/8c/8c8a1f28d5ec7481cc89f9f3648ba25d6d1a38b37d90f8620ada7752a42b1336.png)\n\nTransform the integrand before including the area element:\n\n$$\nx=r \\cos{\\left(\\theta \\right)}=r \\cos{\\left(\\theta \\right)}.\n$$\n\nThe area element supplies one more factor of $r$:\n\n$$\nr \\cos{\\left(\\theta \\right)}\\,r=r^{2} \\cos{\\left(\\theta \\right)}.\n$$\n\nTherefore the requested integral is\n\n$$\n\\int_{\\frac{7 \\pi}{6}}^{\\frac{11 \\pi}{6}}\\int_{- \\frac{3}{2 \\sin{\\left(\\theta \\right)}}}^{3}r^{2} \\cos{\\left(\\theta \\right)}\\,\\mathrm{d}r\\,\\mathrm{d}\\theta.\n$$"} {:answer/id #uuid "5d1b35c3-6cb1-56cf-8a3d-d4c0674b9f41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- (2 \\sqrt{3} + \\frac{729}{8})" :db/id #edb/ref 17592186734071} {:db/id #edb/ref 17592186734076 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d1b35c3-6cb1-56cf-8a3d-d4c0674b9f41" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- (2 \\sqrt{3} + \\frac{729}{8})" :db/id #edb/ref 17592186734071} {:answer/id #uuid "66c72d08-3bfe-5391-b478-255162c3838c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{729}{8}" :db/id #edb/ref 17592186734072} {:answer/id #uuid "9f74c6e5-b321-5812-8505-277442ebfed7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{729 \\sqrt{3}}{8} + 2" :db/id #edb/ref 17592186734082} {:answer/id #uuid "e1e50bf0-0333-5104-9df5-74a7b6aed676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- (2 \\sqrt{3} + \\frac{729}{4})" :db/id #edb/ref 17592186734092} {:answer/id #uuid "e836fd1a-6299-5d9f-89e0-c286bb18fc79" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{729}{8} + 2 \\sqrt{3}" :db/id #edb/ref 17592186734095}] :answer-field/correct {:db/id #edb/ref 17592186734071} :answer-field/id #uuid "5009ff8c-c303-5d5a-9ac1-0e27a84c760f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734070}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "88f55bc9-d602-52d1-b5d3-d0bf614c770f" :question/problem "Compute the rate of change of the function $f(x,y)=3 x^{3} + y^{2}$ with respect to $t$ along the curve $\\mathbf{r}(t)=\\left\\langle - 3 \\sin{\\left(t \\right)},- 2 \\cos{\\left(t \\right)}\\right\\rangle$ at $t=\\frac{\\pi}{3}$." :question/worked-solution "The vector form of the chain rule gives\n\n$$\n\\frac{d}{dt}f(\\mathbf{r}(t))=\\nabla f(\\mathbf{r}(t))\\cdot \\mathbf{r}'(t).\n$$\n\nDifferentiate with respect to each coordinate, holding the others fixed:\n\n$$\n\\nabla f(x,y)=\\begin{bmatrix}9 x^{2} \\\\ 2 y\\end{bmatrix}.\n$$\n\nSubstitute the curve into the gradient:\n\n$$\n\\nabla f(\\mathbf{r}(t))=\\begin{bmatrix}81 \\sin^{2}{\\left(t \\right)} \\\\ - 4 \\cos{\\left(t \\right)}\\end{bmatrix}.\n$$\n\nDifferentiate each component of the curve:\n\n$$\n\\mathbf{r}'(t)=\\begin{bmatrix}- 3 \\cos{\\left(t \\right)} \\\\ 2 \\sin{\\left(t \\right)}\\end{bmatrix}.\n$$\n\nEvaluate the trigonometric factors at the stated time. Where a negative argument occurs, use $\\cos(-u)=\\cos(u)$ and $\\sin(-u)=-\\sin(u)$.\n\nAt $t=\\frac{\\pi}{3}$, evaluate the point, gradient and velocity:\n\n$$\n\\begin{aligned}\n\\mathbf{r}\\left(\\frac{\\pi}{3}\\right)&=\\begin{bmatrix}- \\frac{3 \\sqrt{3}}{2} \\\\ -1\\end{bmatrix}, \\\\ \\nabla f(\\mathbf{r}\\left(\\frac{\\pi}{3}\\right))&=\\begin{bmatrix}\\frac{243}{4} \\\\ -2\\end{bmatrix}, \\\\ \\mathbf{r}'\\left(\\frac{\\pi}{3}\\right)&=\\begin{bmatrix}- \\frac{3}{2} \\\\ \\sqrt{3}\\end{bmatrix}.\n\\end{aligned}\n$$\n\nLet each coordinate contribution be $C_x$, $C_y$. Pair the corresponding gradient and velocity components:\n\n$$\n\\begin{aligned}\nC_{x}&=\\left(\\frac{243}{4}\\right)\\cdot\\left(- \\frac{3}{2}\\right) \\\\ &=- \\frac{729}{8} \\\\ C_{y}&=\\left(-2\\right)\\cdot\\left(\\sqrt{3}\\right) \\\\ &=- 2 \\sqrt{3}\n\\end{aligned}\n$$\n\nAdd the coordinate contributions to obtain the rate with respect to $t$:\n\n$$\n\\begin{aligned}\n\\left.\\frac{d}{dt}f(\\mathbf{r}(t))\\right|_{t=\\frac{\\pi}{3}}&=C_{x}+C_{y} \\\\ &=- (2 \\sqrt{3} + \\frac{729}{8}).\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186734077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304df230-1dd2-5c90-a0b8-108ba241f52a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{2} \\left(- \\frac{8}{\\pi} + \\ln{\\left(\\frac{\\pi}{4} \\right)}\\right) \\ln{\\left(\\frac{\\pi}{4} \\right)}" :db/id #edb/ref 17592186734067} {:answer/id #uuid "3b1b37ae-802f-5c94-9c06-1001cd8cb5d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}^{2}" :db/id #edb/ref 17592186734069} {:answer/id #uuid "b1eeebd8-f159-5f71-bd62-ca11beb97225" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{2} \\left(\\ln{\\left(\\frac{\\pi}{4} \\right)} + \\frac{8}{\\pi}\\right) \\ln{\\left(\\frac{\\pi}{4} \\right)}" :db/id #edb/ref 17592186734085} {:answer/id #uuid "bf538191-cd04-5863-9167-8742fd510497" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2} \\left(\\frac{\\pi}{2} + 4\\right) \\ln{\\left(\\frac{\\pi}{4} \\right)}^{2}" :db/id #edb/ref 17592186734087} {:answer/id #uuid "e820e4dd-9048-55c9-a686-306a6bfe5e92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{2} \\left(2 \\ln{\\left(\\frac{\\pi}{4} \\right)} + \\frac{8}{\\pi}\\right) \\ln{\\left(\\frac{\\pi}{4} \\right)}" :db/id #edb/ref 17592186734094}] :answer-field/correct {:db/id #edb/ref 17592186734085} :answer-field/id #uuid "361a5674-05cc-54da-a2c1-05b0fc03e546" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734068}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8a97e062-c48f-50af-97e0-594c4a35fd66" :question/problem "Compute the rate of change of the function $f(x,y)=y^{2} \\sin{\\left(x \\right)}$ with respect to $t$ along the curve $\\mathbf{r}(t)=\\left\\langle t,2 \\ln{\\left(t \\right)}\\right\\rangle$ at $t=\\frac{\\pi}{4}$." :question/worked-solution "The vector form of the chain rule gives\n\n$$\n\\frac{d}{dt}f(\\mathbf{r}(t))=\\nabla f(\\mathbf{r}(t))\\cdot \\mathbf{r}'(t).\n$$\n\nDifferentiate with respect to each coordinate, holding the others fixed:\n\n$$\n\\nabla f(x,y)=\\begin{bmatrix}y^{2} \\cos{\\left(x \\right)} \\\\ 2 y \\sin{\\left(x \\right)}\\end{bmatrix}.\n$$\n\nSubstitute the curve into the gradient:\n\n$$\n\\nabla f(\\mathbf{r}(t))=\\begin{bmatrix}4 \\ln{\\left(t \\right)}^{2} \\cos{\\left(t \\right)} \\\\ 4 \\ln{\\left(t \\right)} \\sin{\\left(t \\right)}\\end{bmatrix}.\n$$\n\nDifferentiate each component of the curve:\n\n$$\n\\mathbf{r}'(t)=\\begin{bmatrix}1 \\\\ \\frac{2}{t}\\end{bmatrix}.\n$$\n\nEvaluate the trigonometric factors at the stated time. Where a negative argument occurs, use $\\cos(-u)=\\cos(u)$ and $\\sin(-u)=-\\sin(u)$.\n\nThe logarithmic path requires $t>0$. Use $e^{\\ln u}=u$ for $u>0$ when simplifying the substituted expressions.\n\nAt $t=\\frac{\\pi}{4}$, evaluate the point, gradient and velocity:\n\n$$\n\\begin{aligned}\n\\mathbf{r}\\left(\\frac{\\pi}{4}\\right)&=\\begin{bmatrix}\\frac{\\pi}{4} \\\\ 2 \\ln{\\left(\\frac{\\pi}{4} \\right)}\\end{bmatrix}, \\\\ \\nabla f(\\mathbf{r}\\left(\\frac{\\pi}{4}\\right))&=\\begin{bmatrix}2 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}^{2} \\\\ 2 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}\\end{bmatrix}, \\\\ \\mathbf{r}'\\left(\\frac{\\pi}{4}\\right)&=\\begin{bmatrix}1 \\\\ \\frac{8}{\\pi}\\end{bmatrix}.\n\\end{aligned}\n$$\n\nLet each coordinate contribution be $C_x$, $C_y$. Pair the corresponding gradient and velocity components:\n\n$$\n\\begin{aligned}\nC_{x}&=\\left(2 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}^{2}\\right)\\cdot\\left(1\\right) \\\\ &=2 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}^{2} \\\\ C_{y}&=\\left(2 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}\\right)\\cdot\\left(\\frac{8}{\\pi}\\right) \\\\ &=\\frac{16 \\sqrt{2} \\ln{\\left(\\frac{\\pi}{4} \\right)}}{\\pi}\n\\end{aligned}\n$$\n\nAdd the coordinate contributions to obtain the rate with respect to $t$:\n\n$$\n\\begin{aligned}\n\\left.\\frac{d}{dt}f(\\mathbf{r}(t))\\right|_{t=\\frac{\\pi}{4}}&=C_{x}+C_{y} \\\\ &=2 \\sqrt{2} \\left(\\ln{\\left(\\frac{\\pi}{4} \\right)} + \\frac{8}{\\pi}\\right) \\ln{\\left(\\frac{\\pi}{4} \\right)}.\n\\end{aligned}\n$$"} {:answer/id #uuid "e1e50bf0-0333-5104-9df5-74a7b6aed676" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- (2 \\sqrt{3} + \\frac{729}{4})" :db/id #edb/ref 17592186734092} {:db/id #edb/ref 17592186734237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6f0eee-af27-5014-ae1f-53ecc59d6386" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3 + 9 \\pi}}{3 \\sqrt{\\pi}}" :db/id #edb/ref 17592186734235} {:answer/id #uuid "9bc0fbe9-5beb-51b9-9a7f-0164f2e84029" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\frac{1}{3} + \\pi}{\\pi}" :db/id #edb/ref 17592186734247} {:answer/id #uuid "b4280432-f71d-56e5-829e-31017b36ab3d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3 \\sqrt{\\pi}} + 1" :db/id #edb/ref 17592186734252} {:answer/id #uuid "c772e59b-0c47-5a1a-8481-f6c49fd45474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 \\pi" :db/id #edb/ref 17592186734255} {:answer/id #uuid "c8d94d81-c11c-58bc-80b4-fbbd224568d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 6 \\pi" :db/id #edb/ref 17592186734257}] :answer-field/correct {:db/id #edb/ref 17592186734257} :answer-field/id #uuid "11676ce4-0e84-51be-ac55-9d629d409a6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734230}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3e7f550d-bb57-5c14-85a7-d29dbf8b54ea" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]\\big|_{t=\\frac{3 \\pi}{2}}$ given that\n\n$$\n\\nabla f(x,y)=\\left(4 x y \\cos{\\left(x^{2} \\right)}\\right)\\,\\mathbf{i}+\\left(2 \\sin{\\left(x^{2} \\right)}\\right)\\,\\mathbf{j}\n$$\n\nand\n\n$$\n\\mathbf r(t)=\\left(\\sqrt{2} \\sqrt{t}\\right)\\,\\mathbf{i}+\\left(t\\right)\\,\\mathbf{j}.\n$$" :question/worked-solution "The vector chain rule gives\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\nabla f(\\mathbf r(t))\\cdot\\mathbf r^{\\prime}(t).\n$$\n\nDifferentiate each curve component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=\\frac{\\sqrt{2}}{2 \\sqrt{t}}\\\\y^{\\prime}(t)&=1.\\end{aligned}\n$$\n\nEvaluate the position and velocity at $t=\\frac{3 \\pi}{2}$:\n\n$$\n\\begin{aligned}x\\left(\\frac{3 \\pi}{2}\\right)&=\\sqrt{3} \\sqrt{\\pi}\\\\y\\left(\\frac{3 \\pi}{2}\\right)&=\\frac{3 \\pi}{2}\\\\x^{\\prime}\\left(\\frac{3 \\pi}{2}\\right)&=\\frac{\\sqrt{3}}{3 \\sqrt{\\pi}}\\\\y^{\\prime}\\left(\\frac{3 \\pi}{2}\\right)&=1.\\end{aligned}\n$$\n\nSubstitute this position into the supplied gradient:\n\n$$\n\\begin{aligned}x^{2}&=\\left(\\sqrt{3} \\sqrt{\\pi}\\right)^{2}=3 \\pi\\\\f_x(\\mathbf r\\left(\\frac{3 \\pi}{2}\\right))&=\\left(4 \\left(\\sqrt{3} \\sqrt{\\pi}\\right) \\left(\\frac{3 \\pi}{2}\\right) \\cos{\\left(3 \\pi \\right)}\\right)\\\\&=- 6 \\sqrt{3} \\pi^{\\frac{3}{2}}\\\\f_y(\\mathbf r\\left(\\frac{3 \\pi}{2}\\right))&=\\left(2 \\sin{\\left(3 \\pi \\right)}\\right)\\\\&=0.\\end{aligned}\n$$\n\nMultiply matching components and add. This is a rate with respect to $t$, so the velocity is not normalized.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]\\big|_{t=\\frac{3 \\pi}{2}}&=\\left(- 6 \\sqrt{3} \\pi^{\\frac{3}{2}}\\right)\\cdot\\left(\\frac{\\sqrt{3}}{3 \\sqrt{\\pi}}\\right)\\\\&\\quad+\\left(0\\right)\\cdot\\left(1\\right)\\\\&=\\left(- 6 \\pi\\right)+\\left(0\\right)\\\\&=- 6 \\pi.\\end{aligned}\n$$\n\nUse the familiar trigonometric values at the displayed angles; for negative arguments, $\\sin(-u)=-\\sin(u)$, $\\cos(-u)=\\cos(u)$ and $\\arctan(-u)=-\\arctan(u)$."} {:db/id #edb/ref 17592186734259 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146c02e4-28d2-5e9a-8a70-1fc4e1c605ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{40}{13}" :db/id #edb/ref 17592186734231} {:answer/id #uuid "16764399-c169-52d5-986d-e699862fc12b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{32}{13}" :db/id #edb/ref 17592186734232} {:answer/id #uuid "616fa443-8f5e-55ec-989a-70eb3c5de2b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186734240} {:answer/id #uuid "8914e2cd-e654-5924-8b42-1ac6a965278f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{36}{13}" :db/id #edb/ref 17592186734243} {:answer/id #uuid "92738692-d894-5275-987c-24a8b5874dd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20}{13}" :db/id #edb/ref 17592186734246}] :answer-field/correct {:db/id #edb/ref 17592186734246} :answer-field/id #uuid "27e2f534-530a-5f18-8ce1-5fa2460ef7e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734234}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d3047e10-fe5f-58f2-ac69-770f6dc06a08" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]\\big|_{t=\\frac{3 \\pi}{4}}$ given that\n\n$$\n\\nabla f(x,y)=\\left(\\frac{4 x}{x^{2} + y^{2}}\\right)\\,\\mathbf{i}+\\left(\\frac{4 y}{x^{2} + y^{2}}\\right)\\,\\mathbf{j}\n$$\n\nand\n\n$$\n\\mathbf r(t)=\\left(2 \\sin{\\left(t \\right)}\\right)\\,\\mathbf{i}+\\left(3 \\cos{\\left(t \\right)}\\right)\\,\\mathbf{j}.\n$$" :question/worked-solution "The vector chain rule gives\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]=\\nabla f(\\mathbf r(t))\\cdot\\mathbf r^{\\prime}(t).\n$$\n\nDifferentiate each curve component:\n\n$$\n\\begin{aligned}x^{\\prime}(t)&=2 \\cos{\\left(t \\right)}\\\\y^{\\prime}(t)&=- 3 \\sin{\\left(t \\right)}.\\end{aligned}\n$$\n\nEvaluate the position and velocity at $t=\\frac{3 \\pi}{4}$:\n\n$$\n\\begin{aligned}x\\left(\\frac{3 \\pi}{4}\\right)&=\\sqrt{2}\\\\y\\left(\\frac{3 \\pi}{4}\\right)&=- \\frac{3 \\sqrt{2}}{2}\\\\x^{\\prime}\\left(\\frac{3 \\pi}{4}\\right)&=- \\sqrt{2}\\\\y^{\\prime}\\left(\\frac{3 \\pi}{4}\\right)&=- \\frac{3 \\sqrt{2}}{2}.\\end{aligned}\n$$\n\nSubstitute this position into the supplied gradient:\n\n$$\n\\begin{aligned}f_x(\\mathbf r\\left(\\frac{3 \\pi}{4}\\right))&=\\left(\\frac{4 \\left(\\sqrt{2}\\right)}{\\left(\\sqrt{2}\\right)^{2} + \\left(- \\frac{3 \\sqrt{2}}{2}\\right)^{2}}\\right)\\\\&=\\frac{8 \\sqrt{2}}{13}\\\\f_y(\\mathbf r\\left(\\frac{3 \\pi}{4}\\right))&=\\left(\\frac{4 \\left(- \\frac{3 \\sqrt{2}}{2}\\right)}{\\left(\\sqrt{2}\\right)^{2} + \\left(- \\frac{3 \\sqrt{2}}{2}\\right)^{2}}\\right)\\\\&=- \\frac{12 \\sqrt{2}}{13}.\\end{aligned}\n$$\n\nMultiply matching components and add. This is a rate with respect to $t$, so the velocity is not normalized.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(\\mathbf{r}(t))]\\big|_{t=\\frac{3 \\pi}{4}}&=\\left(\\frac{8 \\sqrt{2}}{13}\\right)\\cdot\\left(- \\sqrt{2}\\right)\\\\&\\quad+\\left(- \\frac{12 \\sqrt{2}}{13}\\right)\\cdot\\left(- \\frac{3 \\sqrt{2}}{2}\\right)\\\\&=\\left(- \\frac{16}{13}\\right)+\\left(\\frac{36}{13}\\right)\\\\&=\\frac{20}{13}.\\end{aligned}\n$$\n\nUse the familiar trigonometric values at the displayed angles; for negative arguments, $\\sin(-u)=-\\sin(u)$, $\\cos(-u)=\\cos(u)$ and $\\arctan(-u)=-\\arctan(u)$."} {:db/id #edb/ref 17592186734835 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6135462f-3bb0-5b4b-9eb0-a3cced549cfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{99}{2}" :db/id #edb/ref 17592186734846} {:answer/id #uuid "616194ee-1d27-5bb7-ae16-2ca4049a38fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{99 \\ln{\\left(2 \\right)}}{4} + \\frac{99 \\ln{\\left(4 \\right)}}{4}" :db/id #edb/ref 17592186734847} {:answer/id #uuid "d6b80eeb-7217-5624-b0b6-8cbdd5d947e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{99 \\ln{\\left(2 \\right)}}{2} + \\frac{99 \\ln{\\left(4 \\right)}}{2}" :db/id #edb/ref 17592186734860} {:answer/id #uuid "dc013a34-47ca-535f-ad49-e573f3404e5b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{99 \\ln{\\left(2 \\right)}}{8} + \\frac{99 \\ln{\\left(4 \\right)}}{8}" :db/id #edb/ref 17592186734863} {:answer/id #uuid "ed2dd240-6349-51fe-b7f3-1c196f3bc70e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 99 \\ln{\\left(2 \\right)} + 99 \\ln{\\left(4 \\right)}" :db/id #edb/ref 17592186734868}] :answer-field/correct {:db/id #edb/ref 17592186734847} :answer-field/id #uuid "75c1d28b-22c4-51f1-8b5c-3ca7124b03a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734852}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "03dc0a48-443d-5a17-9ce7-60b4ea080ec8" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D \\frac{3 x^{2} - 3 y^{2}}{\\left(x - y\\right)^{2}}\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(3,1)$, $(\\frac{9}{2},\\frac{5}{2})$, $(\\frac{11}{2},\\frac{3}{2})$ and $(4,0)$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nFactor and cancel, wherever the denominator is nonzero:\n\n$$\n\\begin{aligned}f(x,y)&=\\frac{3 x^{2} - 3 y^{2}}{\\left(x - y\\right)^{2}} \\\\ &=3\\frac{(x+y)(x-y)}{(x-y)^2} \\\\ &=3\\frac{x+y}{x-y}\\quad(x-y\\ne0).\\end{aligned}\n$$\n\n\n\n$$\nu=x + y,\\qquad v=x - y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(3,1)&\\longmapsto(4,2) \\\\ (\\frac{9}{2},\\frac{5}{2})&\\longmapsto(7,2) \\\\ (\\frac{11}{2},\\frac{3}{2})&\\longmapsto(7,4) \\\\ (4,0)&\\longmapsto(4,4)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):4\\le u\\le 7,\\ 2\\le v\\le 4\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/93/93fe90c9f0d852deab0b54b5c238df8c8f8d9cd11a28f1cc5dd83431964a64af.png)\n\nHere $v\\ge 2>0$, so the denominator never vanishes. The primitive of $1/v$ is $\\ln v$ on this region.\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}1&1\\\\1&-1\\end{vmatrix} \\\\ &=-2.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{u}{2} + \\frac{v}{2} \\\\ y&=\\frac{u}{2} - \\frac{v}{2}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{-2}=- \\frac{1}{2} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{2}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=\\frac{3}{2}\\int_{2}^{4}\\int_{4}^{7}\\frac{u}{v}\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{4}^{7}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{4}^{7} \\\\ &=\\left(7\\right)^{2}/2-\\left(\\left(4\\right)^{2}/2\\right) \\\\ &=\\left(\\frac{49}{2}\\right)-\\left(8\\right) \\\\ &=\\frac{33}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{2}^{4}\\frac{1}{v}\\,\\mathrm{d}v \\\\ &=\\left[\\ln{\\left(v \\right)}\\right]_{2}^{4} \\\\ &=\\ln \\left(4\\right)-\\left(\\ln \\left(2\\right)\\right) \\\\ &=\\left(\\ln{\\left(4 \\right)}\\right)-\\left(\\ln{\\left(2 \\right)}\\right) \\\\ &=- \\ln{\\left(2 \\right)} + \\ln{\\left(4 \\right)}.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=\\frac{3}{2}\\,I_u I_v \\\\ &=\\frac{3}{2}\\cdot \\left(\\frac{33}{2}\\right)\\cdot \\left(- \\ln{\\left(2 \\right)} + \\ln{\\left(4 \\right)}\\right) \\\\ &=- \\frac{99 \\ln{\\left(2 \\right)}}{4} + \\frac{99 \\ln{\\left(4 \\right)}}{4}.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29afd785-a035-5f1b-80e6-9814e7997fca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2 + 2 e^{3}" :db/id #edb/ref 17592186734840} {:answer/id #uuid "444f8d4d-be93-5648-b7dd-b222bb4c7018" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{5}{6} + \\frac{5 e^{3}}{6}" :db/id #edb/ref 17592186734844} {:answer/id #uuid "6eb40d52-bda7-52aa-914d-17dd5697b362" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{3}}{2}" :db/id #edb/ref 17592186734851} {:answer/id #uuid "86d39e70-c621-5e6d-b147-d629b0ad90ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{2} + \\frac{9 e^{3}}{2}" :db/id #edb/ref 17592186734855} {:answer/id #uuid "902f83fa-81b8-5c82-8849-4f9e7dfd46d7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{2} + \\frac{e^{3}}{2}" :db/id #edb/ref 17592186734858}] :answer-field/correct {:db/id #edb/ref 17592186734858} :answer-field/id #uuid "155af782-1f67-5118-9dd0-fe15f033692b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734837}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2d0df8b5-b5c0-548e-9d29-fbd51edc6dfd" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D \\left(x + y\\right) e^{x + 4 y}\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(\\frac{4}{3},- \\frac{1}{3})$, $(\\frac{8}{3},- \\frac{2}{3})$, $(\\frac{5}{3},\\frac{1}{3})$ and $(\\frac{1}{3},\\frac{2}{3})$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=\\left(x + y\\right) e^{x + 4 y}\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=x + y,\\qquad v=x + 4 y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(\\frac{4}{3},- \\frac{1}{3})&\\longmapsto(1,0) \\\\ (\\frac{8}{3},- \\frac{2}{3})&\\longmapsto(2,0) \\\\ (\\frac{5}{3},\\frac{1}{3})&\\longmapsto(2,3) \\\\ (\\frac{1}{3},\\frac{2}{3})&\\longmapsto(1,3)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):1\\le u\\le 2,\\ 0\\le v\\le 3\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/ac/ac61e4bdb4473eabf238a8981d6136a7bdf94c3283742e0455660fbaec705817.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}1&1\\\\1&4\\end{vmatrix} \\\\ &=3.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{4 u}{3} - \\frac{v}{3} \\\\ y&=- \\frac{u}{3} + \\frac{v}{3}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{3}=\\frac{1}{3} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{3}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=\\frac{1}{3}\\int_{0}^{3}\\int_{1}^{2}u e^{v}\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{1}^{2}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{1}^{2} \\\\ &=\\left(2\\right)^{2}/2-\\left(\\left(1\\right)^{2}/2\\right) \\\\ &=\\left(2\\right)-\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{3}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{0}^{3}e^{v}\\,\\mathrm{d}v \\\\ &=\\left[e^{v}\\right]_{0}^{3} \\\\ &=e^{3}-\\left(e^{0}\\right) \\\\ &=\\left(e^{3}\\right)-\\left(1\\right) \\\\ &=-1 + e^{3}.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=\\frac{1}{3}\\,I_u I_v \\\\ &=\\frac{1}{3}\\cdot \\left(\\frac{3}{2}\\right)\\cdot \\left(-1 + e^{3}\\right) \\\\ &=- \\frac{1}{2} + \\frac{e^{3}}{2}.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734843 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095c2a3f-7e97-59ce-b955-abdbb4952d1c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "39" :db/id #edb/ref 17592186734836} {:answer/id #uuid "5b3bfdf7-acf0-5b97-abe7-2271c7abe4f2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{91}{16}" :db/id #edb/ref 17592186734845} {:answer/id #uuid "6b8dab89-497d-5e53-ba42-2ba6b37b3abd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{273}{8}" :db/id #edb/ref 17592186734850} {:answer/id #uuid "7bad6992-7509-51cb-8818-37751624e48d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{975}{16}" :db/id #edb/ref 17592186734853} {:answer/id #uuid "c6f863e3-f9e0-5ee4-822c-0fa18e9170b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{273}{16}" :db/id #edb/ref 17592186734859}] :answer-field/correct {:db/id #edb/ref 17592186734859} :answer-field/id #uuid "e917e696-08c7-5826-ad35-1c0f5d7a37b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734864}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "433bda18-ee8a-5534-a7c9-5a30abe67983" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D \\left(x + 2 y\\right)^{2} \\left(4 x - 3\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(\\frac{3}{2},\\frac{1}{4})$, $(\\frac{7}{4},\\frac{1}{8})$, $(\\frac{7}{4},\\frac{13}{8})$ and $(\\frac{3}{2},\\frac{7}{4})$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=\\left(x + 2 y\\right)^{2} \\left(4 x - 3\\right)\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=4 x - 3,\\qquad v=x + 2 y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(\\frac{3}{2},\\frac{1}{4})&\\longmapsto(3,2) \\\\ (\\frac{7}{4},\\frac{1}{8})&\\longmapsto(4,2) \\\\ (\\frac{7}{4},\\frac{13}{8})&\\longmapsto(4,5) \\\\ (\\frac{3}{2},\\frac{7}{4})&\\longmapsto(3,5)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):3\\le u\\le 4,\\ 2\\le v\\le 5\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/7f/7ffa8f1133b7e05b995359e252c64f60ec91e06282a786df05349715e5c4b9d7.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}4&0\\\\1&2\\end{vmatrix} \\\\ &=8.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{u}{4} + \\frac{3}{4} \\\\ y&=- \\frac{u}{8} + \\frac{v}{2} - \\frac{3}{8}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{8}=\\frac{1}{8} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{8}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=\\frac{1}{8}\\int_{2}^{5}\\int_{3}^{4}u v^{2}\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{3}^{4}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{3}^{4} \\\\ &=\\left(4\\right)^{2}/2-\\left(\\left(3\\right)^{2}/2\\right) \\\\ &=\\left(8\\right)-\\left(\\frac{9}{2}\\right) \\\\ &=\\frac{7}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{2}^{5}v^{2}\\,\\mathrm{d}v \\\\ &=\\left[\\frac{v^{3}}{3}\\right]_{2}^{5} \\\\ &=\\left(5\\right)^{3}/3-\\left(\\left(2\\right)^{3}/3\\right) \\\\ &=\\left(\\frac{125}{3}\\right)-\\left(\\frac{8}{3}\\right) \\\\ &=39.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=\\frac{1}{8}\\,I_u I_v \\\\ &=\\frac{1}{8}\\cdot \\left(\\frac{7}{2}\\right)\\cdot \\left(39\\right) \\\\ &=\\frac{273}{16}.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734865 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "225207e0-f529-508c-962c-ebd78578aad5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{21 e}{8} + \\frac{21 e^{2}}{8}" :db/id #edb/ref 17592186734838} {:answer/id #uuid "6620e57a-4357-5351-901f-e04cc83ea42c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 21 e + 21 e^{2}" :db/id #edb/ref 17592186734849} {:answer/id #uuid "8912e4c2-11a9-5db6-9bbb-c7d1c1784da6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 3 e + 3 e^{2}" :db/id #edb/ref 17592186734856} {:answer/id #uuid "89b74742-fb51-5c1a-8c67-3425fa9bfe78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{21 e}{4} + \\frac{21 e^{2}}{4}" :db/id #edb/ref 17592186734857} {:answer/id #uuid "eb2b6ac2-959b-5b04-8485-729a152c954d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{21 e}{2} + \\frac{21 e^{2}}{2}" :db/id #edb/ref 17592186734866}] :answer-field/correct {:db/id #edb/ref 17592186734866} :answer-field/id #uuid "d6d3877f-095b-5363-92f3-8526886c63c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734861}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e96e175a-a601-5285-b018-37f7b8c07561" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D 3 \\left(\\frac{x}{2} + y\\right) e^{x + 4 y}\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(11,- \\frac{5}{2})$, $(15,- \\frac{7}{2})$, $(14,-3)$ and $(10,-2)$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=3 \\left(\\frac{x}{2} + y\\right) e^{x + 4 y}\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=\\frac{x}{2} + y,\\qquad v=x + 4 y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(11,- \\frac{5}{2})&\\longmapsto(3,1) \\\\ (15,- \\frac{7}{2})&\\longmapsto(4,1) \\\\ (14,-3)&\\longmapsto(4,2) \\\\ (10,-2)&\\longmapsto(3,2)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):3\\le u\\le 4,\\ 1\\le v\\le 2\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/a7/a792cb6ed5aa07538daf6f73c44bc67ea6cec6903bff69991c4ba2ac1f41b968.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}\\frac{1}{2}&1\\\\1&4\\end{vmatrix} \\\\ &=1.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=4 u - v \\\\ y&=- u + \\frac{v}{2}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{1}=1 \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=1.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=3\\int_{1}^{2}\\int_{3}^{4}u e^{v}\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{3}^{4}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{3}^{4} \\\\ &=\\left(4\\right)^{2}/2-\\left(\\left(3\\right)^{2}/2\\right) \\\\ &=\\left(8\\right)-\\left(\\frac{9}{2}\\right) \\\\ &=\\frac{7}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{1}^{2}e^{v}\\,\\mathrm{d}v \\\\ &=\\left[e^{v}\\right]_{1}^{2} \\\\ &=e^{2}-\\left(e^{1}\\right) \\\\ &=\\left(e^{2}\\right)-\\left(e\\right) \\\\ &=- e + e^{2}.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=3\\,I_u I_v \\\\ &=3\\cdot \\left(\\frac{7}{2}\\right)\\cdot \\left(- e + e^{2}\\right) \\\\ &=- \\frac{21 e}{2} + \\frac{21 e^{2}}{2}.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734871 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44db0e80-bb22-59cd-8a80-30661570b0b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{3}}{2} - e^{5} + \\frac{e^{7}}{2}" :db/id #edb/ref 17592186734878}] :answer-field/correct {:db/id #edb/ref 17592186734878} :answer-field/id #uuid "aee49866-10a7-5aae-b1c0-f87661c6d18d" :answer-field/key "value" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186734884}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "00c178e9-d123-5688-ac96-0085f0bf92d4" :question/problem "Use a change of variables to evaluate\n\n$$\n\\iint_D e^{x^{2} + x - 2 y}\\,\\mathrm{d}x\\,\\mathrm{d}y.\n$$\n\nwhere\n\n$$\nD=\\left\\{(x,y):\\begin{aligned}2&\\le x\\le 4,\\\\1&\\le x^{2} - 2 y\\le 3\\end{aligned}\\right\\}.\n$$\n\nEnter the exact value: {{value}}." :question/worked-solution "**1. Infer the coordinates and region.** The bounded expressions suggest\n\n$$\nu=x,\\qquad v=x^{2} - 2 y.\n$$\n\nThey give the rectangle\n\n$$\n\\Delta=\\{(u,v):2\\le u\\le 4,\\quad 1\\le v\\le 3\\}.\n$$\n\nSolving for the original coordinates gives\n\n$$\nx=u,\\qquad y=\\frac{u^{2}}{2} - \\frac{v}{2}.\n$$\n\nThese formulas specify a unique inverse on this rectangle.\n\n**2. Compute the area factor.**\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\det\\!\\left(\\begin{bmatrix}1 & 0\\\\2 x & -2\\end{bmatrix}\\right)\\\\&=-2.\\end{aligned}\n$$\n\nTake the reciprocal and express it in the new coordinates:\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=- \\frac{1}{2},\\qquad\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|=\\frac{1}{2}.\n$$\n\n**3. Transform and evaluate.** The integrand becomes $e^{u} e^{v}$. Use $e^{u+v}=e^u e^v$ to separate the factors. Write $I$ for the requested integral. Evaluate the displayed primitives at both endpoints:\n\n$$\n\\begin{aligned}I & =\\iint_\\Delta e^{u} e^{v}\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\int_{2}^{4} [\\int_{1}^{3} \\frac{e^{u} e^{v}}{2}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{2}\\left(\\int_{2}^{4} e^{u}\\,\\mathrm{d}u\\right)\\left(\\int_{1}^{3} e^{v}\\,\\mathrm{d}v\\right) \\\\ & =\\frac{1}{2}\\left[e^{u}\\right]_{2}^{4}\\left[e^{v}\\right]_{1}^{3} \\\\ & =\\frac{1}{2}\\left(e^{4}-(e^{2})\\right)\\left(e^{3}-(e)\\right) \\\\ & =\\frac{1}{2}\\left(- e^{2} + e^{4}\\right)\\left(e^{3} - e\\right) \\\\ & =\\frac{e^{3}}{2} - e^{5} + \\frac{e^{7}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186734872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b2b9efc-b49e-5ccc-ba63-5dc6e9fa5743" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{2}}{4} - \\frac{e}{4}" :db/id #edb/ref 17592186734879}] :answer-field/correct {:db/id #edb/ref 17592186734879} :answer-field/id #uuid "1fddad17-8268-59df-8a09-d4f3230157fd" :answer-field/key "value" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186734873}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "18711ce9-d643-5ff5-873c-643d9273d511" :question/problem "Use a change of variables to evaluate\n\n$$\n\\iint_D e^{2 x + y} \\left(y - 2\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y.\n$$\n\nwhere\n\n$$\nD=\\left\\{(x,y):\\begin{aligned}2&\\le y\\le 3,\\\\1&\\le 2 x + y\\le 2\\end{aligned}\\right\\}.\n$$\n\nEnter the exact value: {{value}}." :question/worked-solution "**1. Infer the coordinates and region.** The bounded expressions suggest\n\n$$\nu=y,\\qquad v=2 x + y.\n$$\n\nThey give the rectangle\n\n$$\n\\Delta=\\{(u,v):2\\le u\\le 3,\\quad 1\\le v\\le 2\\}.\n$$\n\nSolving for the original coordinates gives\n\n$$\nx=- \\frac{u}{2} + \\frac{v}{2},\\qquad y=u.\n$$\n\nThese formulas specify a unique inverse on this rectangle.\n\n**2. Compute the area factor.**\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\det\\!\\left(\\begin{bmatrix}0 & 1\\\\2 & 1\\end{bmatrix}\\right)\\\\&=-2.\\end{aligned}\n$$\n\nTake the reciprocal and express it in the new coordinates:\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=- \\frac{1}{2},\\qquad\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|=\\frac{1}{2}.\n$$\n\n**3. Transform and evaluate.** The integrand becomes $e^{v} \\left(u - 2\\right)$. Write $I$ for the requested integral. Evaluate the displayed primitives at both endpoints:\n\n$$\n\\begin{aligned}I & =\\iint_\\Delta e^{v} \\left(u - 2\\right)\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\int_{2}^{3} [\\int_{1}^{2} e^{v} \\left(\\frac{u}{2} - 1\\right)\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{2}\\left(\\int_{2}^{3} u - 2\\,\\mathrm{d}u\\right)\\left(\\int_{1}^{2} e^{v}\\,\\mathrm{d}v\\right) \\\\ & =\\frac{1}{2}\\left[\\frac{u^{2}}{2} - 2 u\\right]_{2}^{3}\\left[e^{v}\\right]_{1}^{2} \\\\ & =\\frac{1}{2}\\left(- \\frac{3}{2}-(-2)\\right)\\left(e^{2}-(e)\\right) \\\\ & =\\frac{1}{2}\\left(\\frac{1}{2}\\right)\\left(e^{2} - e\\right) \\\\ & =\\frac{e^{2}}{4} - \\frac{e}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186734874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e9d70a-568f-5435-add4-9cd9a7cc87e0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{e^{3}}{2} - \\frac{e^{4}}{2} - \\frac{e^{6}}{2} + \\frac{e^{7}}{2}" :db/id #edb/ref 17592186734875}] :answer-field/correct {:db/id #edb/ref 17592186734875} :answer-field/id #uuid "4ee32ae6-7fce-5261-88ae-6c671d92cc39" :answer-field/key "value" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186734880}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "24d8b48b-1f41-55d3-a63b-3e60bcbe2add" :question/problem "Use a change of variables to evaluate\n\n$$\n\\iint_D e^{2 x + y^{2} + y}\\,\\mathrm{d}x\\,\\mathrm{d}y.\n$$\n\nwhere\n\n$$\nD=\\left\\{(x,y):\\begin{aligned}2&\\le y\\le 5,\\\\1&\\le 2 x + y^{2}\\le 2\\end{aligned}\\right\\}.\n$$\n\nEnter the exact value: {{value}}." :question/worked-solution "**1. Infer the coordinates and region.** The bounded expressions suggest\n\n$$\nu=y,\\qquad v=2 x + y^{2}.\n$$\n\nThey give the rectangle\n\n$$\n\\Delta=\\{(u,v):2\\le u\\le 5,\\quad 1\\le v\\le 2\\}.\n$$\n\nSolving for the original coordinates gives\n\n$$\nx=- \\frac{u^{2}}{2} + \\frac{v}{2},\\qquad y=u.\n$$\n\nThese formulas specify a unique inverse on this rectangle.\n\n**2. Compute the area factor.**\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\det\\!\\left(\\begin{bmatrix}0 & 1\\\\2 & 2 y\\end{bmatrix}\\right)\\\\&=-2.\\end{aligned}\n$$\n\nTake the reciprocal and express it in the new coordinates:\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=- \\frac{1}{2},\\qquad\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|=\\frac{1}{2}.\n$$\n\n**3. Transform and evaluate.** The integrand becomes $e^{u} e^{v}$. Use $e^{u+v}=e^u e^v$ to separate the factors. Write $I$ for the requested integral. Evaluate the displayed primitives at both endpoints:\n\n$$\n\\begin{aligned}I & =\\iint_\\Delta e^{u} e^{v}\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\int_{2}^{5} [\\int_{1}^{2} \\frac{e^{u} e^{v}}{2}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{2}\\left(\\int_{2}^{5} e^{u}\\,\\mathrm{d}u\\right)\\left(\\int_{1}^{2} e^{v}\\,\\mathrm{d}v\\right) \\\\ & =\\frac{1}{2}\\left[e^{u}\\right]_{2}^{5}\\left[e^{v}\\right]_{1}^{2} \\\\ & =\\frac{1}{2}\\left(e^{5}-(e^{2})\\right)\\left(e^{2}-(e)\\right) \\\\ & =\\frac{1}{2}\\left(- e^{2} + e^{5}\\right)\\left(e^{2} - e\\right) \\\\ & =\\frac{e^{3}}{2} - \\frac{e^{4}}{2} - \\frac{e^{6}}{2} + \\frac{e^{7}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186734882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbf8288a-60c5-5d08-9330-7c0f74485b06" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\ln{\\left(2 \\right)}}{2}" :db/id #edb/ref 17592186734885}] :answer-field/correct {:db/id #edb/ref 17592186734885} :answer-field/id #uuid "77313b04-1df7-5d9b-b678-6e2991afc84d" :answer-field/key "value" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186734883}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5335c4d5-7cc3-5770-b14b-e5e1fbaf75e1" :question/problem "Use a change of variables to evaluate\n\n$$\n\\iint_D \\frac{x + y}{- x + y}\\,\\mathrm{d}x\\,\\mathrm{d}y.\n$$\n\nwhere\n\n$$\nD=\\left\\{(x,y):\\begin{aligned}1&\\le x + y\\le 2,\\\\1&\\le - x + y\\le 4\\end{aligned}\\right\\}.\n$$\n\nEnter the exact value: {{value}}." :question/worked-solution "**1. Infer the coordinates and region.** The bounded expressions suggest\n\n$$\nu=x + y,\\qquad v=- x + y.\n$$\n\nThey give the rectangle\n\n$$\n\\Delta=\\{(u,v):1\\le u\\le 2,\\quad 1\\le v\\le 4\\}.\n$$\n\nSolving for the original coordinates gives\n\n$$\nx=\\frac{u}{2} - \\frac{v}{2},\\qquad y=\\frac{u}{2} + \\frac{v}{2}.\n$$\n\nThese formulas specify a unique inverse on this rectangle.\n\nHere $v\\ge 1 >0$, so the denominator and logarithm are defined.\n\n**2. Compute the area factor.**\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\det\\!\\left(\\begin{bmatrix}1 & 1\\\\-1 & 1\\end{bmatrix}\\right)\\\\&=2.\\end{aligned}\n$$\n\nTake the reciprocal and express it in the new coordinates:\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\frac{1}{2},\\qquad\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|=\\frac{1}{2}.\n$$\n\n**3. Transform and evaluate.** The integrand becomes $\\frac{u}{v}$. Write $I$ for the requested integral. Evaluate the displayed primitives at both endpoints:\n\n$$\n\\begin{aligned}I & =\\iint_\\Delta \\frac{u}{v}\\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|\\,\\mathrm{d}u\\,\\mathrm{d}v \\\\ & =\\int_{1}^{2} [\\int_{1}^{4} \\frac{u}{2 v}\\,\\mathrm{d}v]\\,\\mathrm{d}u \\\\ & =\\frac{1}{2}\\left(\\int_{1}^{2} u\\,\\mathrm{d}u\\right)\\left(\\int_{1}^{4} \\frac{1}{v}\\,\\mathrm{d}v\\right) \\\\ & =\\frac{1}{2}\\left[\\frac{u^{2}}{2}\\right]_{1}^{2}\\left[\\ln{\\left(v \\right)}\\right]_{1}^{4} \\\\ & =\\frac{1}{2}\\left(2-\\left(\\frac{1}{2}\\right)\\right)\\left(\\ln{\\left(4 \\right)}-(0)\\right) \\\\ & =\\frac{1}{2}\\left(\\frac{3}{2}\\right)\\left(2 \\ln{\\left(2 \\right)}\\right) \\\\ & =\\frac{3 \\ln{\\left(2 \\right)}}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186734895 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d3daf87-761d-5e97-9300-1484715bb420" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186734889} {:answer/id #uuid "7db0a27d-9619-5e9c-aa79-138b7e605d91" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{10}{3}" :db/id #edb/ref 17592186734901} {:answer/id #uuid "98b4d116-1fb4-532b-8ff0-78e7ab21dd49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186734903} {:answer/id #uuid "bc48da9f-601b-599d-9316-19b9b99f07d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186734908} {:answer/id #uuid "cf1d71de-6fcc-5be9-8a52-6998fa6d2176" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186734910}] :answer-field/correct {:db/id #edb/ref 17592186734910} :answer-field/id #uuid "69cafcf9-526f-57e0-b06e-aadf86ad46f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734899}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3f8a81b0-dffe-5688-9465-141edde3587c" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D 2 \\left(x - y\\right) \\left(2 x + y\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(\\frac{1}{3},\\frac{1}{3})$, $(\\frac{2}{3},\\frac{2}{3})$, $(\\frac{4}{3},- \\frac{2}{3})$ and $(1,-1)$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=2 \\left(x - y\\right) \\left(2 x + y\\right)\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=2 x + y,\\qquad v=x - y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(\\frac{1}{3},\\frac{1}{3})&\\longmapsto(1,0) \\\\ (\\frac{2}{3},\\frac{2}{3})&\\longmapsto(2,0) \\\\ (\\frac{4}{3},- \\frac{2}{3})&\\longmapsto(2,2) \\\\ (1,-1)&\\longmapsto(1,2)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):1\\le u\\le 2,\\ 0\\le v\\le 2\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/55/55c06a094a2d422ff2b8e46e5befd29ba64e4ee5896873ac03a68d4f6d1f871f.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}2&1\\\\1&-1\\end{vmatrix} \\\\ &=-3.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{u}{3} + \\frac{v}{3} \\\\ y&=\\frac{u}{3} - \\frac{2 v}{3}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{-3}=- \\frac{1}{3} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{3}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=\\frac{2}{3}\\int_{0}^{2}\\int_{1}^{2}u v\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{1}^{2}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{1}^{2} \\\\ &=\\left(2\\right)^{2}/2-\\left(\\left(1\\right)^{2}/2\\right) \\\\ &=\\left(2\\right)-\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{3}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{0}^{2}v\\,\\mathrm{d}v \\\\ &=\\left[\\frac{v^{2}}{2}\\right]_{0}^{2} \\\\ &=\\left(2\\right)^{2}/2-\\left(\\left(0\\right)^{2}/2\\right) \\\\ &=\\left(2\\right)-\\left(0\\right) \\\\ &=2.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=\\frac{2}{3}\\,I_u I_v \\\\ &=\\frac{2}{3}\\cdot \\left(\\frac{3}{2}\\right)\\cdot \\left(2\\right) \\\\ &=2.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae9def2-f63b-57b4-83b3-5c13307da0f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186734887} {:answer/id #uuid "21f8962f-efdd-5eb5-98fe-3b8ec04bebf2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186734891} {:answer/id #uuid "384bd994-cd40-51fa-8c1b-76f0fa7b0287" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186734894} {:answer/id #uuid "b7813f64-1821-50fd-bf9e-686a1609f00d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186734906} {:answer/id #uuid "dd9f8aae-c5d1-5144-a3d8-74e6c6a4c29d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186734912}] :answer-field/correct {:db/id #edb/ref 17592186734891} :answer-field/id #uuid "1edb0af0-f442-5029-9332-655b6e298fe2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734890}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "63a54b55-2f72-597c-98e7-53e8988821d1" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D 2 \\left(x - y\\right) \\left(2 x + y\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(\\frac{5}{3},\\frac{2}{3})$, $(2,1)$, $(\\frac{7}{3},\\frac{1}{3})$ and $(2,0)$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=2 \\left(x - y\\right) \\left(2 x + y\\right)\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=2 x + y,\\qquad v=x - y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(\\frac{5}{3},\\frac{2}{3})&\\longmapsto(4,1) \\\\ (2,1)&\\longmapsto(5,1) \\\\ (\\frac{7}{3},\\frac{1}{3})&\\longmapsto(5,2) \\\\ (2,0)&\\longmapsto(4,2)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):4\\le u\\le 5,\\ 1\\le v\\le 2\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/21/21f1b21acda03c796271cea8f8dc4f331a383db3aa0097130dc8c7c6a033f68d.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}2&1\\\\1&-1\\end{vmatrix} \\\\ &=-3.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{u}{3} + \\frac{v}{3} \\\\ y&=\\frac{u}{3} - \\frac{2 v}{3}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{-3}=- \\frac{1}{3} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{3}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=\\frac{2}{3}\\int_{1}^{2}\\int_{4}^{5}u v\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{4}^{5}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{4}^{5} \\\\ &=\\left(5\\right)^{2}/2-\\left(\\left(4\\right)^{2}/2\\right) \\\\ &=\\left(\\frac{25}{2}\\right)-\\left(8\\right) \\\\ &=\\frac{9}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{1}^{2}v\\,\\mathrm{d}v \\\\ &=\\left[\\frac{v^{2}}{2}\\right]_{1}^{2} \\\\ &=\\left(2\\right)^{2}/2-\\left(\\left(1\\right)^{2}/2\\right) \\\\ &=\\left(2\\right)-\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{3}{2}.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=\\frac{2}{3}\\,I_u I_v \\\\ &=\\frac{2}{3}\\cdot \\left(\\frac{9}{2}\\right)\\cdot \\left(\\frac{3}{2}\\right) \\\\ &=\\frac{9}{2}.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "163c0be9-dd5e-5a33-9567-10f5c4120814" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186734888} {:answer/id #uuid "44102d5a-64f1-527b-a6e7-2fbdf68e2413" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5" :db/id #edb/ref 17592186734896} {:answer/id #uuid "93f9b598-cc80-5bab-b7d1-8ac16ccc5aa6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{2}" :db/id #edb/ref 17592186734902} {:answer/id #uuid "da76b2d3-b646-5f04-870f-865b2db999af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{45}{4}" :db/id #edb/ref 17592186734911} {:answer/id #uuid "e8787385-bbcc-5916-a738-8109e0dc07e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186734913}] :answer-field/correct {:db/id #edb/ref 17592186734913} :answer-field/id #uuid "f08acfe3-78b3-5c41-a9c2-a19adf5002b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734914}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bb4e5318-601a-50db-bbd7-5f4cc9fbb13d" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D 3 \\left(x - 2 y\\right) \\left(x + y\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(\\frac{5}{3},\\frac{1}{3})$, $(\\frac{7}{3},\\frac{2}{3})$, $(\\frac{8}{3},\\frac{1}{3})$ and $(2,0)$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=3 \\left(x - 2 y\\right) \\left(x + y\\right)\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=x + y,\\qquad v=x - 2 y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(\\frac{5}{3},\\frac{1}{3})&\\longmapsto(2,1) \\\\ (\\frac{7}{3},\\frac{2}{3})&\\longmapsto(3,1) \\\\ (\\frac{8}{3},\\frac{1}{3})&\\longmapsto(3,2) \\\\ (2,0)&\\longmapsto(2,2)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):2\\le u\\le 3,\\ 1\\le v\\le 2\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/2e/2e336456e529f708ce1b054c54b06d53d94b1f85532b38b10a816b9d8ccb5599.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}1&1\\\\1&-2\\end{vmatrix} \\\\ &=-3.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{2 u}{3} + \\frac{v}{3} \\\\ y&=\\frac{u}{3} - \\frac{v}{3}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{-3}=- \\frac{1}{3} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{3}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=1\\int_{1}^{2}\\int_{2}^{3}u v\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{2}^{3}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{2}^{3} \\\\ &=\\left(3\\right)^{2}/2-\\left(\\left(2\\right)^{2}/2\\right) \\\\ &=\\left(\\frac{9}{2}\\right)-\\left(2\\right) \\\\ &=\\frac{5}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{1}^{2}v\\,\\mathrm{d}v \\\\ &=\\left[\\frac{v^{2}}{2}\\right]_{1}^{2} \\\\ &=\\left(2\\right)^{2}/2-\\left(\\left(1\\right)^{2}/2\\right) \\\\ &=\\left(2\\right)-\\left(\\frac{1}{2}\\right) \\\\ &=\\frac{3}{2}.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=1\\,I_u I_v \\\\ &=1\\cdot \\left(\\frac{5}{2}\\right)\\cdot \\left(\\frac{3}{2}\\right) \\\\ &=\\frac{15}{4}.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186734909 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31d6a2d3-42d3-55a5-be91-dc3b1a611a49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "22" :db/id #edb/ref 17592186734893} {:answer/id #uuid "4a2381c7-fff7-5183-b0f9-dfe69e61c7a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "55" :db/id #edb/ref 17592186734897} {:answer/id #uuid "6b263720-407c-5f01-99e1-45849eea43c4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{99}{2}" :db/id #edb/ref 17592186734900} {:answer/id #uuid "a0dcb4b7-842a-57ab-af5c-83d9a1f5e2b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "44" :db/id #edb/ref 17592186734904} {:answer/id #uuid "a2be7916-3619-5501-843c-7172909172d9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186734905}] :answer-field/correct {:db/id #edb/ref 17592186734904} :answer-field/id #uuid "2fee6571-608e-592d-bb38-80fc5b4704af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186734892}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c0fea436-4007-5b76-a25a-a096ee6de7f7" :question/problem "Use a change of variables to evaluate the double integral \n\n$$\n\\iint_D 2 \\left(x - y\\right) \\left(2 x + y\\right)\\,\\mathrm{d}x\\,\\mathrm{d}y,\n$$\n\nwhere $D$ is the quadrilateral region with vertices $(\\frac{5}{3},\\frac{2}{3})$, $(\\frac{8}{3},\\frac{5}{3})$, $(\\frac{10}{3},\\frac{1}{3})$ and $(\\frac{7}{3},- \\frac{2}{3})$." :question/worked-solution "**Step 1**: Infer suitable coordinates from the integrand.\n\nThe integrand\n\n$$\nf(x,y)=2 \\left(x - y\\right) \\left(2 x + y\\right)\n$$\n\nsuggests the following coordinates.\n\n\n\n$$\nu=2 x + y,\\qquad v=x - y.\n$$\n\n**Step 2**: Transform the region.\n\nApplying these two formulas to each vertex gives\n\n$$\n\\begin{aligned}(\\frac{5}{3},\\frac{2}{3})&\\longmapsto(4,1) \\\\ (\\frac{8}{3},\\frac{5}{3})&\\longmapsto(7,1) \\\\ (\\frac{10}{3},\\frac{1}{3})&\\longmapsto(7,3) \\\\ (\\frac{7}{3},- \\frac{2}{3})&\\longmapsto(4,3)\\end{aligned}\n$$\n\nAn invertible affine map takes straight edges to straight edges. Therefore the image of $D$ is the rectangle\n\n$$\n\\Delta=\\{(u,v):4\\le u\\le 7,\\ 1\\le v\\le 3\\}.\n$$\n\n![The transformed rectangle in the uv-plane.](images/20/2063c1b72d08b3eebda24a5b46b167da6a7df136167905d65946b37b8de51559.png)\n\n**Step 3**: Compute the forward Jacobian determinant.\n\n$$\n\\begin{aligned}\\frac{\\partial(u,v)}{\\partial(x,y)}&=\\begin{vmatrix}2&1\\\\1&-1\\end{vmatrix} \\\\ &=-3.\\end{aligned}\n$$\n\n**Step 4**: Invert the transformation and use the absolute area factor.\n\nThe inverse is\n\n$$\n\\begin{aligned}x&=\\frac{u}{3} + \\frac{v}{3} \\\\ y&=\\frac{u}{3} - \\frac{2 v}{3}.\\end{aligned}\n$$\n\nThis inverse exists on the whole plane, so the transformation is one-to-one. Its signed determinant and area factor are\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\frac{1}{-3}=- \\frac{1}{3} \\\\ \\left|\\frac{\\partial(x,y)}{\\partial(u,v)}\\right|&=\\frac{1}{3}.\\end{aligned}\n$$\n\n**Step 5**: Evaluate the transformed integral.\n\nLet $I$ denote the requested integral. Then\n\n$$\nI=\\frac{2}{3}\\int_{1}^{3}\\int_{4}^{7}u v\\,\\mathrm{d}u\\,\\mathrm{d}v.\n$$\n\nThe integrand separates into a function of $u$ and a function of $v$. Evaluate both factors:\n\n\n\n$$\n\\begin{aligned}I_u&=\\int_{4}^{7}u\\,\\mathrm{d}u \\\\ &=\\left[\\frac{u^{2}}{2}\\right]_{4}^{7} \\\\ &=\\left(7\\right)^{2}/2-\\left(\\left(4\\right)^{2}/2\\right) \\\\ &=\\left(\\frac{49}{2}\\right)-\\left(8\\right) \\\\ &=\\frac{33}{2}.\\end{aligned}\n$$\n\n\n\n$$\n\\begin{aligned}I_v&=\\int_{1}^{3}v\\,\\mathrm{d}v \\\\ &=\\left[\\frac{v^{2}}{2}\\right]_{1}^{3} \\\\ &=\\left(3\\right)^{2}/2-\\left(\\left(1\\right)^{2}/2\\right) \\\\ &=\\left(\\frac{9}{2}\\right)-\\left(\\frac{1}{2}\\right) \\\\ &=4.\\end{aligned}\n$$\n\nCombining the two factors gives\n\n$$\n\\begin{aligned}I&=\\frac{2}{3}\\,I_u I_v \\\\ &=\\frac{2}{3}\\cdot \\left(\\frac{33}{2}\\right)\\cdot \\left(4\\right) \\\\ &=44.\\end{aligned}\n$$\n\n"} {:db/id #edb/ref 17592186735413 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d54211-ff5f-5051-905e-9afef9a388d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186735414}] :answer-field/correct {:db/id #edb/ref 17592186735414} :answer-field/id #uuid "2e1907e2-af40-5e56-ba01-fa8d057b4ae3" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186735415}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "0686d6db-4b3e-5c05-9b47-6ef494a7f1e2" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Solid grid lines are one unit apart; dotted lines divide each square in half.\n\n![](images/10/10bc9ef3424bcffdb9fc3958f3885062d2a026d1199477cb2ac3621933560ead.png)\n\nGiven that $\\mathbf{c}=\\frac{1}{2}\\mathbf{a}+\\lambda\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}." :question/worked-solution "Construct the known component $\\frac{1}{2}\\mathbf{a}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=\\frac{1}{2}\\,(3, -2)=(\\frac{3}{2}, -1). \\\\\n\\overrightarrow{PC} &=(3, -3).\n\\end{aligned}\n$$\n\n![](images/94/941dc7de7d4ec7ba07c82bf076a4835dfb79683a5eda4525c20ef5b88e65331c.png)\n\nCompare the remaining displacement with $\\mathbf{b}$, whose grid displacement is $(4, -4)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{3}{4}=\\frac{3}{4} \\\\\n\\text{Vertical scale} &=\\frac{-3}{-4}=\\frac{3}{4}\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{b}$. Thus $\\overrightarrow{PC}=\\frac{3}{4}\\mathbf{b}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=\\frac{1}{2}\\mathbf{a}+\\frac{3}{4}\\mathbf{b} \\\\\n&=\\frac{1}{2}\\mathbf{a}+\\frac{3}{4}\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{b}$ gives $\\lambda=\\frac{3}{4}$."} {:db/id #edb/ref 17592186735416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fbec857-bdfa-5ce4-93b7-979d192af93b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186735421}] :answer-field/correct {:db/id #edb/ref 17592186735421} :answer-field/id #uuid "43483cdb-567b-5c55-bded-236793d2adb2" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186735418}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "365903ba-b5ab-557b-8e0c-2efc9ac1761a" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Solid grid lines are one unit apart; dotted lines divide each square in half.\n\n![](images/3f/3f3d535d41f1efaf3cd1ab6af134c8264583281d49007aa1d272b84c5f04fe6c.png)\n\nGiven that $\\mathbf{c}=\\frac{5}{2}\\mathbf{a}+\\lambda\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}." :question/worked-solution "Construct the known component $\\frac{5}{2}\\mathbf{a}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=\\frac{5}{2}\\,(-3, 2)=(-\\frac{15}{2}, 5). \\\\\n\\overrightarrow{PC} &=(-4, 4).\n\\end{aligned}\n$$\n\n![](images/5d/5d25ca9ee6973a180e4aa36d516544c9f2e1f42c38a44b9c037e9dc4829ceedc.png)\n\nCompare the remaining displacement with $\\mathbf{b}$, whose grid displacement is $(-4, 4)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{-4}{-4}=1 \\\\\n\\text{Vertical scale} &=\\frac{4}{4}=1\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{b}$. Thus $\\overrightarrow{PC}=\\mathbf{b}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=\\frac{5}{2}\\mathbf{a}+\\mathbf{b} \\\\\n&=\\frac{5}{2}\\mathbf{a}+\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{b}$ gives $\\lambda=1$."} {:db/id #edb/ref 17592186735419 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fc9339a3-4ba8-5fed-81dd-9363559afd0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186735424}] :answer-field/correct {:db/id #edb/ref 17592186735424} :answer-field/id #uuid "91e00cee-ce43-5832-a32a-792f28141f58" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186735422}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "43bbfbc7-891c-5b1f-9e1b-23a6a2b10a00" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Solid grid lines are one unit apart; dotted lines divide each square in half.\n\n![](images/38/3876004b0e8b71376f6da2ec1857555cf931c29be5a83dec6b2934ce17f583d1.png)\n\nGiven that $\\mathbf{c}=\\lambda\\mathbf{a}+\\frac{1}{2}\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}." :question/worked-solution "Construct the known component $\\frac{1}{2}\\mathbf{b}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=\\frac{1}{2}\\,(-2, 1)=(-1, \\frac{1}{2}). \\\\\n\\overrightarrow{PC} &=(-\\frac{1}{2}, \\frac{1}{2}).\n\\end{aligned}\n$$\n\n![](images/e2/e2b956ddda0fb60b0ed908451578575f33dce603d78fabd26b1d2ca3dd8f5190.png)\n\nCompare the remaining displacement with $\\mathbf{a}$, whose grid displacement is $(-2, 2)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{-\\frac{1}{2}}{-2}=\\frac{1}{4} \\\\\n\\text{Vertical scale} &=\\frac{\\frac{1}{2}}{2}=\\frac{1}{4}\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{a}$. Thus $\\overrightarrow{PC}=\\frac{1}{4}\\mathbf{a}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=\\frac{1}{2}\\mathbf{b}+\\frac{1}{4}\\mathbf{a} \\\\\n&=\\frac{1}{4}\\mathbf{a}+\\frac{1}{2}\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{a}$ gives $\\lambda=\\frac{1}{4}$."} {:db/id #edb/ref 17592186735423 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68b988cb-7858-556b-80dd-e8a008beba0a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186735420}] :answer-field/correct {:db/id #edb/ref 17592186735420} :answer-field/id #uuid "3711db4a-3e75-56ed-ac3a-e2ab91002150" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186735417}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c2ac4d7e-a633-5182-a775-d21ede953b8c" :question/problem "The arrows show $\\overrightarrow{OA}=\\mathbf a$, $\\overrightarrow{OB}=\\mathbf b$, and $\\overrightarrow{OC}=\\mathbf c$. Solid grid lines are one unit apart; dotted lines divide each square in half.\n\n![](images/df/dfb02e1d9202130f955625a46621b81e8fdb9ff6c7f66e183577eb13e2ad2775.png)\n\nGiven that $\\mathbf{c}=\\frac{5}{2}\\mathbf{a}+\\lambda\\mathbf{b}$, find $\\lambda$.\n\n$\\lambda=$ {{field-1}}." :question/worked-solution "Construct the known component $\\frac{5}{2}\\mathbf{a}$ from $O$, and call its endpoint $P$. Count signed horizontal and vertical grid displacements:\n\n$$\n\\begin{aligned}\n\\overrightarrow{OP} &=\\frac{5}{2}\\,(-2, 3)=(-5, \\frac{15}{2}). \\\\\n\\overrightarrow{PC} &=(-7, 7).\n\\end{aligned}\n$$\n\n![](images/ae/ae434599433e3432485a0a5d2d410c20d7a13e0d16847cb5a6c7f281587e03b2.png)\n\nCompare the remaining displacement with $\\mathbf{b}$, whose grid displacement is $(-4, 4)$:\n\n$$\n\\begin{aligned}\n\\text{Horizontal scale} &=\\frac{-7}{-4}=\\frac{7}{4} \\\\\n\\text{Vertical scale} &=\\frac{7}{4}=\\frac{7}{4}\n\\end{aligned}\n$$\n\nThe scale is positive, so the remaining vector has the same direction as $\\mathbf{b}$. Thus $\\overrightarrow{PC}=\\frac{7}{4}\\mathbf{b}$. By the triangle law,\n\n$$\n\\begin{aligned}\n\\mathbf{c} &=\\overrightarrow{OP}+\\overrightarrow{PC} \\\\\n&=\\frac{5}{2}\\mathbf{a}+\\frac{7}{4}\\mathbf{b} \\\\\n&=\\frac{5}{2}\\mathbf{a}+\\frac{7}{4}\\mathbf{b}.\n\\end{aligned}\n$$\n\nThe vectors $\\mathbf{a}$ and $\\mathbf{b}$ are not parallel, so their coefficients are unique. Matching the coefficient of $\\mathbf{b}$ gives $\\lambda=\\frac{7}{4}$."} {:db/id #edb/ref 17592186735873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3079ddaa-3cec-56fc-b6cd-8aa69283f931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186735869} {:answer/id #uuid "55d613c5-2e74-5c6a-b422-520b2486bbae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9" :db/id #edb/ref 17592186735874} {:answer/id #uuid "95225c48-3906-54e3-b0db-311b050402d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9 \\left(-3 + \\sqrt{3}\\right)}{4}" :db/id #edb/ref 17592186735883} {:answer/id #uuid "d04b70ae-894d-5afc-bd2e-62eec646cd6e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9 \\left(1 + \\sqrt{3}\\right)}{4}" :db/id #edb/ref 17592186735890} {:answer/id #uuid "d2346410-be55-594f-8ada-e16d122043b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{4}" :db/id #edb/ref 17592186735892}] :answer-field/correct {:db/id #edb/ref 17592186735874} :answer-field/id #uuid "95285c74-d5a3-560b-9015-e313d4391a6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186735884}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "53b61d97-5c18-5af6-a853-740aae7cd0be" :question/problem "For the transformation $\\mathbf{T}$ defined by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}3 u \\cos{\\left(v \\right)} \\\\ 3 u \\sin{\\left(v \\right)}\\end{bmatrix},\n$$\n\ncompute the value of the Jacobian determinant at the input point\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}-1 \\\\ \\frac{\\pi}{3}\\end{bmatrix}.\n$$" :question/worked-solution "For the ordered input variables $u,v$ and output variables $x,y$, the Jacobian determinant is\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\begin{vmatrix}x_u & x_v \\\\ y_u & y_v\\end{vmatrix}=x_u y_v-x_v y_u.\n$$\n\nHere, $x=3 u \\cos{\\left(v \\right)}$ and $y=3 u \\sin{\\left(v \\right)}$. Holding the other variable constant, we obtain\n\n$$\n\\begin{aligned}x_u&=3 \\cos{\\left(v \\right)}, & x_v&=- 3 u \\sin{\\left(v \\right)}, \\\\ y_u&=3 \\sin{\\left(v \\right)}, & y_v&=3 u \\cos{\\left(v \\right)}.\\end{aligned}\n$$\n\nForm the determinant in this order:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\begin{vmatrix}3 \\cos{\\left(v \\right)} & - 3 u \\sin{\\left(v \\right)} \\\\ 3 \\sin{\\left(v \\right)} & 3 u \\cos{\\left(v \\right)}\\end{vmatrix} \\\\ &=\\left(3 \\cos{\\left(v \\right)}\\right)\\left(3 u \\cos{\\left(v \\right)}\\right) \\\\ &\\quad{}-\\left(- 3 u \\sin{\\left(v \\right)}\\right)\\left(3 \\sin{\\left(v \\right)}\\right).\\end{aligned}\n$$\n\nNow substitute the input point into the derivative entries and subtract the products:\n\n$$\n\\begin{aligned}J(-1,\\frac{\\pi}{3})&=\\begin{vmatrix}\\frac{3}{2} & \\frac{3 \\sqrt{3}}{2} \\\\ \\frac{3 \\sqrt{3}}{2} & - \\frac{3}{2}\\end{vmatrix} \\\\ &=\\left(\\frac{3}{2}\\right)\\left(- \\frac{3}{2}\\right) \\\\ &\\quad{}-\\left(\\frac{3 \\sqrt{3}}{2}\\right)\\left(\\frac{3 \\sqrt{3}}{2}\\right) \\\\ &=- \\frac{9}{4}-\\left(\\frac{27}{4}\\right) \\\\ &=-9.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186736003 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05243392-28d0-50a6-87e2-74637011dc31" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186735986} {:answer/id #uuid "0b02c0ac-3343-52db-a67e-babfcfda0122" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\sqrt{3}" :db/id #edb/ref 17592186735988} {:answer/id #uuid "38bfc8a0-7841-5fa5-8fce-304d6fba6bce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\sqrt{3}}{4}" :db/id #edb/ref 17592186735995} {:answer/id #uuid "66da40af-c694-5dcd-b855-0b7536132da9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3} + 6}{4}" :db/id #edb/ref 17592186736001} {:answer/id #uuid "7a7b0f31-1301-5857-86c1-ffd2b958baad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{4}" :db/id #edb/ref 17592186736004}] :answer-field/correct {:db/id #edb/ref 17592186736004} :answer-field/id #uuid "6874efaf-75c8-56c1-9082-83420d987977" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736002}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6d5b2706-a3d7-57a8-85a0-086379cb9591" :question/problem "For the transformation $\\mathbf{T}$ defined by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}- \\sin{\\left(u - 2 v \\right)} \\\\ - \\cos{\\left(u + v \\right)}\\end{bmatrix},\n$$\n\ncompute the value of the Jacobian determinant at the input point\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}- \\frac{\\pi}{6} \\\\ - \\frac{\\pi}{6}\\end{bmatrix}.\n$$" :question/worked-solution "For the ordered input variables $u,v$ and output variables $x,y$, the Jacobian determinant is\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\begin{vmatrix}x_u & x_v \\\\ y_u & y_v\\end{vmatrix}=x_u y_v-x_v y_u.\n$$\n\nHere, $x=- \\sin{\\left(u - 2 v \\right)}$ and $y=- \\cos{\\left(u + v \\right)}$. Holding the other variable constant, we obtain\n\n$$\n\\begin{aligned}x_u&=- \\cos{\\left(u - 2 v \\right)}, & x_v&=2 \\cos{\\left(u - 2 v \\right)}, \\\\ y_u&=\\sin{\\left(u + v \\right)}, & y_v&=\\sin{\\left(u + v \\right)}.\\end{aligned}\n$$\n\nForm the determinant in this order:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\begin{vmatrix}- \\cos{\\left(u - 2 v \\right)} & 2 \\cos{\\left(u - 2 v \\right)} \\\\ \\sin{\\left(u + v \\right)} & \\sin{\\left(u + v \\right)}\\end{vmatrix} \\\\ &=\\left(- \\cos{\\left(u - 2 v \\right)}\\right)\\left(\\sin{\\left(u + v \\right)}\\right) \\\\ &\\quad{}-\\left(2 \\cos{\\left(u - 2 v \\right)}\\right)\\left(\\sin{\\left(u + v \\right)}\\right).\\end{aligned}\n$$\n\nNow substitute the input point into the derivative entries and subtract the products:\n\n$$\n\\begin{aligned}J(- \\frac{\\pi}{6},- \\frac{\\pi}{6})&=\\begin{vmatrix}- \\frac{\\sqrt{3}}{2} & \\sqrt{3} \\\\ - \\frac{\\sqrt{3}}{2} & - \\frac{\\sqrt{3}}{2}\\end{vmatrix} \\\\ &=\\left(- \\frac{\\sqrt{3}}{2}\\right)\\left(- \\frac{\\sqrt{3}}{2}\\right) \\\\ &\\quad{}-\\left(\\sqrt{3}\\right)\\left(- \\frac{\\sqrt{3}}{2}\\right) \\\\ &=\\frac{3}{4}-\\left(- \\frac{3}{2}\\right) \\\\ &=\\frac{9}{4}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186736008 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c8554d-e826-5f75-8c78-2c4163fdadca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{-3 + \\sqrt{3}}{2}" :db/id #edb/ref 17592186735987} {:answer/id #uuid "4cf35260-aac1-54e3-b39f-f440d8d923e2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6" :db/id #edb/ref 17592186735998} {:answer/id #uuid "4f61495c-c502-5b55-b24b-a9a1d1d2cc92" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{2}" :db/id #edb/ref 17592186735999} {:answer/id #uuid "e8904dd0-b9b3-5057-9341-5877cc062b5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186736010} {:answer/id #uuid "f2c57417-1d11-5d11-a0d0-dc334e86afbd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186736012}] :answer-field/correct {:db/id #edb/ref 17592186735999} :answer-field/id #uuid "004dd3c8-d5b4-50c4-a56f-263758d2b6aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186735985}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bc9db0eb-5121-5ca1-b3cc-d3238d9413c1" :question/problem "For the transformation $\\mathbf{T}$ defined by\n\n$$\n\\mathbf{T}:\\begin{bmatrix}u \\\\ v\\end{bmatrix}\\longrightarrow\\begin{bmatrix}\\sin{\\left(2 u + v \\right)} \\\\ \\cos{\\left(2 u - 2 v \\right)}\\end{bmatrix},\n$$\n\ncompute the value of the Jacobian determinant at the input point\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}=\\begin{bmatrix}\\frac{\\pi}{2} \\\\ \\frac{\\pi}{6}\\end{bmatrix}.\n$$" :question/worked-solution "For the ordered input variables $u,v$ and output variables $x,y$, the Jacobian determinant is\n\n$$\n\\frac{\\partial(x,y)}{\\partial(u,v)}=\\begin{vmatrix}x_u & x_v \\\\ y_u & y_v\\end{vmatrix}=x_u y_v-x_v y_u.\n$$\n\nHere, $x=\\sin{\\left(2 u + v \\right)}$ and $y=\\cos{\\left(2 u - 2 v \\right)}$. Holding the other variable constant, we obtain\n\n$$\n\\begin{aligned}x_u&=2 \\cos{\\left(2 u + v \\right)}, & x_v&=\\cos{\\left(2 u + v \\right)}, \\\\ y_u&=- 2 \\sin{\\left(2 u - 2 v \\right)}, & y_v&=2 \\sin{\\left(2 u - 2 v \\right)}.\\end{aligned}\n$$\n\nForm the determinant in this order:\n\n$$\n\\begin{aligned}\\frac{\\partial(x,y)}{\\partial(u,v)}&=\\begin{vmatrix}2 \\cos{\\left(2 u + v \\right)} & \\cos{\\left(2 u + v \\right)} \\\\ - 2 \\sin{\\left(2 u - 2 v \\right)} & 2 \\sin{\\left(2 u - 2 v \\right)}\\end{vmatrix} \\\\ &=\\left(2 \\cos{\\left(2 u + v \\right)}\\right)\\left(2 \\sin{\\left(2 u - 2 v \\right)}\\right) \\\\ &\\quad{}-\\left(\\cos{\\left(2 u + v \\right)}\\right)\\left(- 2 \\sin{\\left(2 u - 2 v \\right)}\\right).\\end{aligned}\n$$\n\nNow substitute the input point into the derivative entries and subtract the products:\n\n$$\n\\begin{aligned}J(\\frac{\\pi}{2},\\frac{\\pi}{6})&=\\begin{vmatrix}- \\sqrt{3} & - \\frac{\\sqrt{3}}{2} \\\\ - \\sqrt{3} & \\sqrt{3}\\end{vmatrix} \\\\ &=\\left(- \\sqrt{3}\\right)\\left(\\sqrt{3}\\right) \\\\ &\\quad{}-\\left(- \\frac{\\sqrt{3}}{2}\\right)\\left(- \\sqrt{3}\\right) \\\\ &=-3-\\left(\\frac{3}{2}\\right) \\\\ &=- \\frac{9}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186736483 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0470fb05-7d38-5d00-8a0b-cc3a3d2332b6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0e/0e1d75cd757aab96c59f0dda31f0336dbd19054040d174a105577a87b51de7be.png" :db/id #edb/ref 17592186736468} {:answer/id #uuid "33cd09c3-e2bf-57a7-8b75-3a3a3790c8cf" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1b/1be8c0bfc8c36cc8c0adf1ee450f06322efcc73eec9d7a61b50ffab761d46026.png" :db/id #edb/ref 17592186736472} {:answer/id #uuid "981cd030-faae-5807-9cd2-101fa8918d3d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/94/944c065f6026a0da8eb67589fdd0c9aa3ec80d902a9fd3b86a95c58c9a952488.png" :db/id #edb/ref 17592186736481} {:answer/id #uuid "988d1360-691e-56ab-b47f-3ab2a994abaa" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/40086da37c4b39753c2e933a311924343a46e41003e286f5f7ee7fbbb078ced8.png" :db/id #edb/ref 17592186736482} {:answer/id #uuid "cccbcea7-6021-5f65-b8b8-29958b54aee7" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/45/45518da622604c04cdb2f9f34be5db894f36afb6d792d94ac914aa5841721aaa.png" :db/id #edb/ref 17592186736485}] :answer-field/correct {:db/id #edb/ref 17592186736481} :answer-field/id #uuid "4fc6d1f5-dff0-53fb-b014-9f65c7477a19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736474}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bf613a5a-8528-565c-90af-253a48d2a5af" :question/problem "Which of the following is the graph of $y=-\\frac{3}{2x}-1$?" :question/worked-solution "Start with the curve $y=-\\frac{1}{x}$.\n\n![](images/7f/7fac7995dafe59d6258005e53830f1b7e66c46688df13ca15abaf8eb56f9aaca.png)\n\nStretch it by a scale factor of $\\frac{3}{2}$ parallel to the $y$-axis to obtain $y=-\\frac{3}{2x}$.\n\n![](images/6f/6f156962b95a68b9f84348c80589bf684bd66b109510542d7abf5a0594a79da9.png)\n\nTranslate this curve $1$ unit down to obtain $y=-\\frac{3}{2x}-1$. The vertical asymptote is $x=0$ and the horizontal asymptote is $y=-1$.\n\nWhen $x=-1$, $y=\\frac{3}{2}-1=\\frac{1}{2}$; when $x=1$, $y=-\\frac{3}{2}-1=-\\frac{5}{2}$. Thus the graph passes through $(-1,\\frac{1}{2})$ and $(1,-\\frac{5}{2})$:\n\n![](images/94/944c065f6026a0da8eb67589fdd0c9aa3ec80d902a9fd3b86a95c58c9a952488.png)"} {:db/id #edb/ref 17592186736487 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ef03ab7-b5ea-5a91-aec9-5238b473729f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/70/7018535ff75efb101eceddf71c584458a156d386c340a15eae36c0d265c2a87c.png" :db/id #edb/ref 17592186736475} {:answer/id #uuid "61c5987f-90fa-53b5-9ccc-c5abbbe70574" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/40/40086da37c4b39753c2e933a311924343a46e41003e286f5f7ee7fbbb078ced8.png" :db/id #edb/ref 17592186736476} {:answer/id #uuid "7e4d156f-a1ec-532d-a3a1-f35166ac021c" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d0/d0bca969cf0559093a171acd247c9daf5e7924270c1348645b71a77f6c73467e.png" :db/id #edb/ref 17592186736477} {:answer/id #uuid "854322fb-359a-51df-8770-eb67c8d57779" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b8/b879d2ad5e5693674219a2028b4be2b5635fc7bec3ff85ad9258b993189892f3.png" :db/id #edb/ref 17592186736479} {:answer/id #uuid "c902ad65-133b-539c-91ae-b92c8c8bae50" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/94/944c065f6026a0da8eb67589fdd0c9aa3ec80d902a9fd3b86a95c58c9a952488.png" :db/id #edb/ref 17592186736484}] :answer-field/correct {:db/id #edb/ref 17592186736479} :answer-field/id #uuid "1d15cddc-bf78-5f69-a075-dc1a8549a6df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736470}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ff9d5ef5-ea7b-5cfa-9bf3-6d745cafbcd1" :question/problem "Which of the following is the graph of $y=-\\frac{3}{2(x+1)}$?" :question/worked-solution "Start with the curve $y=-\\frac{1}{x}$.\n\n![](images/7f/7fac7995dafe59d6258005e53830f1b7e66c46688df13ca15abaf8eb56f9aaca.png)\n\nTranslate it $1$ unit to the left to obtain $y=-\\frac{1}{x+1}$.\n\n![](images/d0/d0bca969cf0559093a171acd247c9daf5e7924270c1348645b71a77f6c73467e.png)\n\nThen stretch it by a scale factor of $\\frac{3}{2}$ parallel to the $y$-axis to obtain $y=-\\frac{3}{2(x+1)}$.\n\nThe vertical asymptote of the required graph is $x=-1$ and its horizontal asymptote is $y=0$. When $x=-2$, $y=-\\frac{3}{2(-1)}=\\frac{3}{2}$; when $x=0$, $y=-\\frac{3}{2(1)}=-\\frac{3}{2}$. The final graph passes through $(-2,\\frac{3}{2})$ and $(0,-\\frac{3}{2})$:\n\n![](images/b8/b879d2ad5e5693674219a2028b4be2b5635fc7bec3ff85ad9258b993189892f3.png)"} {:db/id #edb/ref 17592186736671 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0160d000-fb89-539d-bc5f-c7211bf1eb34" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/51/51cd2d066d85dea560b3ddc351c458afd7eea7423b5fb4c98b51bd75ac6f9ab6.png" :db/id #edb/ref 17592186736670} {:answer/id #uuid "b421f2fe-534c-5a07-b244-3af9ecbbd8a3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/e9/e9fbaf85d3064b566e20999dc72c2a594f313a2f224bc181c6f75269796230dd.png" :db/id #edb/ref 17592186736684} {:answer/id #uuid "bd06df08-d746-5e67-95da-6fb89b711f4f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2a/2a48ca07cf4b47a00ae9490428193710d4c5f149c33bbc226b38d9d155d375bc.png" :db/id #edb/ref 17592186736685} {:answer/id #uuid "c424cf42-c566-5ed5-8797-eee7f34f50be" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/96/9645654d76e1a0b917e27c92f1a5273a333f2e5215fd79c4ec91c7ecdbfa2070.png" :db/id #edb/ref 17592186736686} {:answer/id #uuid "d2217e89-93da-5a66-b99b-8def3b812c27" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4b/4b48e1585cb0c0ed2b8b9d2132561c949c6f8c4af0384d9108929d320bf6903e.png" :db/id #edb/ref 17592186736687}] :answer-field/correct {:db/id #edb/ref 17592186736670} :answer-field/id #uuid "f053de2b-3a7a-5983-99f0-9621397bf63e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736690}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "05754f9c-8c3a-5c68-af1f-768d1039a951" :question/problem "Which of the following is the graph of $y=\\frac{4}{3x}?$" :question/worked-solution "To plot $y=\\frac{4}{3x},$ start with the curve $y=\\frac{1}{x}.$\n\n![](images/96/9645654d76e1a0b917e27c92f1a5273a333f2e5215fd79c4ec91c7ecdbfa2070.png)\n\nMultiply every $y$-coordinate by $\\frac{4}{3}$, keeping the $x$-coordinate fixed. This is a stretch by a scale factor of $\\frac{4}{3}$ parallel to the $y$-axis.\n\nFor example, $(1,1)$ maps to $(1,\\frac{4}{3})$, and $(-1,-1)$ maps to $(-1,-\\frac{4}{3})$. The asymptotes remain $x=0$ and $y=0$, and the branches lie in quadrants I and III. The required graph is shown below.\n\n![](images/51/51cd2d066d85dea560b3ddc351c458afd7eea7423b5fb4c98b51bd75ac6f9ab6.png)"} {:db/id #edb/ref 17592186736678 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef24f43-9e9d-5740-99bd-3194e1d733d4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/92/9299a724fd44ac72d0c2fffe83dec707213900e942f25788f29794d46cc1fd81.png" :db/id #edb/ref 17592186736675} {:answer/id #uuid "4f84f9b7-2fe6-5fbe-814f-061e8718ac6a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/84/84228b85ce84376592b88dd212b7b99af6353c816f11f909e3a057ec5009b689.png" :db/id #edb/ref 17592186736676} {:answer/id #uuid "7540e320-a168-5205-afc6-54713ee65244" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/be/be92f2eaf2351289259a4d810549f260453e138a2b40ee213b9f7f6ff285003a.png" :db/id #edb/ref 17592186736679} {:answer/id #uuid "7f8e4cba-47db-52dd-b867-d60fc93f4ed1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/2c/2c594c5674888f6e4292571c73acd75e6ddb9b9bab880ffa0d56f49ce9c6fd0a.png" :db/id #edb/ref 17592186736680} {:answer/id #uuid "dd5e494e-ae01-54ed-8eb5-8c6f9d279c63" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bc/bc566fe70e0f7b363d26981909a8c389d91538cf6a29850b7a94e51525bd8bd8.png" :db/id #edb/ref 17592186736688}] :answer-field/correct {:db/id #edb/ref 17592186736679} :answer-field/id #uuid "5f3e99bc-c027-5bc5-b7aa-d7cf764e995c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736677}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "707ec6fc-37ff-57b6-88e1-b23904a0c052" :question/problem "Which of the following is the graph of $y=\\frac{7}{4x}?$" :question/worked-solution "To plot $y=\\frac{7}{4x},$ start with the curve $y=\\frac{1}{x}.$\n\n![](images/92/9299a724fd44ac72d0c2fffe83dec707213900e942f25788f29794d46cc1fd81.png)\n\nMultiply every $y$-coordinate by $\\frac{7}{4}$, keeping the $x$-coordinate fixed. This is a stretch by a scale factor of $\\frac{7}{4}$ parallel to the $y$-axis.\n\nAt $x=2$, the original curve has $y=\\frac{1}{2}$, so the new height is $\\frac{7}{4}\\cdot\\frac{1}{2}=\\frac{7}{8}$. Thus $(2,\\frac{1}{2})$ maps to $(2,\\frac{7}{8})$, and $(-2,-\\frac{1}{2})$ maps to $(-2,-\\frac{7}{8})$. The asymptotes remain $x=0$ and $y=0$, and the branches lie in quadrants I and III. The required graph is shown below.\n\n![](images/be/be92f2eaf2351289259a4d810549f260453e138a2b40ee213b9f7f6ff285003a.png)"} {:db/id #edb/ref 17592186736721 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444a9ed7-a6f4-5377-a17f-fae032281fa1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6a/6ae557eca7c4c743e6eddf9231b85ffdd87f02869ed8dd153023bc5b52b96f9c.png" :db/id #edb/ref 17592186736715} {:answer/id #uuid "7494defa-dc01-5b7c-a2a5-e58fbac8b701" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bd/bdcd6156bd8b4f83d0e02e5a634fc50418f1b2275cf9d6939ad10b48c0e944c4.png" :db/id #edb/ref 17592186736719} {:answer/id #uuid "b4f1d94a-0047-53e0-a15c-b9ceb5b9dff3" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ee/ee490cc8ccb17288a492165aba08c5d32816b1d2ae9d7ab681f8a240c35b9cff.png" :db/id #edb/ref 17592186736725} {:answer/id #uuid "e2b7b23c-a01b-5bbf-88c6-74a9ee0489bc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/63/63a936fbaa61b4632a06419e172bf0fa930371475ea348a11bb8aef7a3db5a35.png" :db/id #edb/ref 17592186736730} {:answer/id #uuid "f34ca332-6eef-5d4f-8320-0b20f9ff13ca" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cd/cd2be2dcf36d97a11ff4750a04636b363760123ce0300eda67d19402e1df1a65.png" :db/id #edb/ref 17592186736731}] :answer-field/correct {:db/id #edb/ref 17592186736731} :answer-field/id #uuid "0187a0e8-a48b-5cef-8e83-b78dda230d2f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736712}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "829a97b3-62cb-5481-a739-d90e6f15fce4" :question/problem "Which of the following is the graph of $y=-\\frac{4}{3x}$?" :question/worked-solution "To plot $y=-\\frac{4}{3x},$ start with the curve $y=-\\frac{1}{x}.$\n\n![](images/6a/6ae557eca7c4c743e6eddf9231b85ffdd87f02869ed8dd153023bc5b52b96f9c.png)\n\nStretch this curve by a scale factor of $\\frac{4}{3}$ parallel to the $y$-axis. The coordinate axes remain the asymptotes, and the branches remain in the second and fourth quadrants.\n\nThe points $(-1,1)$ and $(1,-1)$ map to $(-1,\\frac{4}{3})$ and $(1,-\\frac{4}{3})$. The required graph is shown below.\n\n![](images/cd/cd2be2dcf36d97a11ff4750a04636b363760123ce0300eda67d19402e1df1a65.png)"} {:db/id #edb/ref 17592186736729 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cca2a60-b3df-5763-bbad-17180d6ad1b2" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/79/79c76c77ecc4efbedf4c83809ae29794e1294d198715821862240fe2f4c7dae9.png" :db/id #edb/ref 17592186736714} {:answer/id #uuid "835f3dd0-5013-5dc6-8508-097ebe33950f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/37/37627f7ebf048f0e9fa794aa869d55da1ae18386125abd7b9b71f96f3b1750cd.png" :db/id #edb/ref 17592186736722} {:answer/id #uuid "842671c7-aa46-5259-bbb3-df4d9481239d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cb/cbbef42073e97d66d595ff09c67104c1c99601af289ef2bad5fca260a8939e9a.png" :db/id #edb/ref 17592186736723} {:answer/id #uuid "c4a7e190-626b-5721-ae0c-9e3f3fede1c4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/6c/6c0a7e75fbe3e32bc712ec7e16f243a79f96a25cf1b72030c2f8320354c498bf.png" :db/id #edb/ref 17592186736726} {:answer/id #uuid "ff97e45e-1971-5fc9-828c-2e354726ece8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/95/95405b4a37f2492b428056aa6c81d12b2acd94a6814db6302c1f72149d91c2d7.png" :db/id #edb/ref 17592186736732}] :answer-field/correct {:db/id #edb/ref 17592186736732} :answer-field/id #uuid "53dfb25f-cd06-5065-be2d-421e918a6d14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736717}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "df9fe727-ad68-50c7-a96b-179bdb97af11" :question/problem "Which of the following is the graph of $y=-\\frac{5}{6x}$?" :question/worked-solution "To plot $y=-\\frac{5}{6x},$ start with the curve $y=-\\frac{1}{x}.$\n\n![](images/d0/d0eb68d7abdb8ed8e145e4ab0cc25feb20c96f8c56c4634aaac232f0e810a8fa.png)\n\nStretch this curve by a scale factor of $\\frac{5}{6}$ parallel to the $y$-axis. This is a vertical contraction because the scale factor is less than $1$. The coordinate axes remain the asymptotes, and the branches remain in the second and fourth quadrants.\n\nOn $y=-\\frac{1}{x}$, the points at $x=-2$ and $x=2$ are $(-2,\\frac{1}{2})$ and $(2,-\\frac{1}{2})$. Multiplying their ordinates by $\\frac{5}{6}$ gives\n\n$$\n\\frac{5}{6}\\cdot\\frac{1}{2}=\\frac{5}{12},\\qquad \\frac{5}{6}\\cdot\\left(-\\frac{1}{2}\\right)=-\\frac{5}{12}.\n$$\n\nThus the transformed curve passes through $(-2,\\frac{5}{12})$ and $(2,-\\frac{5}{12})$. The required graph is shown below.\n\n![](images/95/95405b4a37f2492b428056aa6c81d12b2acd94a6814db6302c1f72149d91c2d7.png)"} {:db/id #edb/ref 17592186736936 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a92527-3cf2-561d-9a38-bfde13f42d42" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/0e/0e299580d17192dc541bedfd6b345e94fd4c8e9a80c2d988a73fb03e388580cf.png" :db/id #edb/ref 17592186736928} {:answer/id #uuid "4589f956-d241-5d62-93f8-d76eb071de94" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/65/65a05f3d25d1a9d01b317d5e57b18587d9f36cb1768450a596a3f31d5d5be885.png" :db/id #edb/ref 17592186736929} {:answer/id #uuid "58ae2852-2efa-5716-8a09-1707e6b3f3cd" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/11/116ffad8b2e0e33816bd30a81d6e8b5adf90a342a4f42a13f7c8b32e360f3d7b.png" :db/id #edb/ref 17592186736930} {:answer/id #uuid "5a1de695-aba5-5965-a2de-6fff08451250" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/19/193960b58f8b44e8b489feffba099e593e2d5c51c4087f016b356b8454efa0c7.png" :db/id #edb/ref 17592186736931} {:answer/id #uuid "e7eb679e-06d3-572c-a640-6b714a1d001a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ca/ca0b5519c2077f622346623e787b488521ec07e96b4272cc13bbe9bf51c8aa4c.png" :db/id #edb/ref 17592186736952}] :answer-field/correct {:db/id #edb/ref 17592186736952} :answer-field/id #uuid "870cf75a-b41a-54ca-9eba-20165db93a15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736938}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "82fecd9d-e7e5-53e9-8ef8-90641b95c542" :question/problem "Which of the following is the graph of $y=\\frac{1}{2x}-3$?" :question/worked-solution "Start with the curve $y=\\frac{1}{x}$.\n\n![](images/30/30a7bc0c953dce9fc0887f79c6f20979298be5cd27bb17477d944364e8f7e20b.png)\n\nStretch it by a scale factor of $\\frac{1}{2}$ parallel to the $y$-axis to obtain $y=\\frac{1}{2x}$.\n\n![](images/bd/bd8e8f178ec4e7d8f8d649d999aab28ef4a93fba7f357603be3c8c56db00d2b6.png)\n\nTranslate this curve $3$ units down to obtain $y=\\frac{1}{2x}-3$.\n\n![](images/ca/ca0b5519c2077f622346623e787b488521ec07e96b4272cc13bbe9bf51c8aa4c.png)\n\nThe vertical asymptote is $x=0$ and the horizontal asymptote is $y=-3$. Check the marked points:\n\n$$\n\\begin{aligned}y\\big(-1\\big) &= \\frac{1}{2}\\div\\big(-1-(0)\\big)+(-3) = -\\frac{7}{2} \\\\ y\\big(1\\big) &= \\frac{1}{2}\\div\\big(1-(0)\\big)+(-3) = -\\frac{5}{2}\\end{aligned}\n$$\n\nThe required graph passes through $(-1,-\\frac{7}{2})$ and $(1,-\\frac{5}{2})$:\n\n![](images/ca/ca0b5519c2077f622346623e787b488521ec07e96b4272cc13bbe9bf51c8aa4c.png)"} {:db/id #edb/ref 17592186736939 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c55f5bf-d2ce-5648-8fc7-f8c06b61f32b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/1c/1cc02d367902897c1437cf90749efcf4c2d431251d4fb7a8afbd7ecd1ff563b4.png" :db/id #edb/ref 17592186736933} {:answer/id #uuid "a65934a6-926d-56de-8aec-d1db443d8998" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c5/c561ff976a4fb6876962c42b14433f2142612410ca196feaee0f48b96dd79a23.png" :db/id #edb/ref 17592186736943} {:answer/id #uuid "bae58080-6ff6-55be-8293-482993fdad38" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c6/c686d6b8deda9fb53735e53100b402cc184579615dc9ddbcdc51048bf34ba916.png" :db/id #edb/ref 17592186736946} {:answer/id #uuid "c5ab5523-8314-5af5-b2c9-44b4b38278cb" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ca/ca16ea5d37650610a86d5270c5b87a681336f380f2ef39117a4c1f9dbac991a0.png" :db/id #edb/ref 17592186736948} {:answer/id #uuid "e891cd60-5898-54b1-9291-57136e5c41fc" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8a/8a22ece10f8d272373acc5ecfa25547528617e1ca27fec63c702e2b06a3b713c.png" :db/id #edb/ref 17592186736953}] :answer-field/correct {:db/id #edb/ref 17592186736943} :answer-field/id #uuid "2132303e-ce41-5905-ac1c-9e881e37aeeb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736925}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "89e58274-2ccd-5ff6-ac23-0cd5aacdb5a9" :question/problem "Which of the following is the graph of $y=\\frac{3}{2x}-2$?" :question/worked-solution "Start with the curve $y=\\frac{1}{x}$.\n\n![](images/30/30a7bc0c953dce9fc0887f79c6f20979298be5cd27bb17477d944364e8f7e20b.png)\n\nStretch it by a scale factor of $\\frac{3}{2}$ parallel to the $y$-axis to obtain $y=\\frac{3}{2x}$.\n\n![](images/60/602b7a83dc98d48258bdbb34412a6d823570ef56e9a5eefe7ea5c5358a179396.png)\n\nTranslate this curve $2$ units down to obtain $y=\\frac{3}{2x}-2$.\n\n![](images/c5/c561ff976a4fb6876962c42b14433f2142612410ca196feaee0f48b96dd79a23.png)\n\nThe vertical asymptote is $x=0$ and the horizontal asymptote is $y=-2$. Check the marked points:\n\n$$\n\\begin{aligned}y\\big(-1\\big) &= \\frac{3}{2}\\div\\big(-1-(0)\\big)+(-2) = -\\frac{7}{2} \\\\ y\\big(1\\big) &= \\frac{3}{2}\\div\\big(1-(0)\\big)+(-2) = -\\frac{1}{2}\\end{aligned}\n$$\n\nThe required graph passes through $(-1,-\\frac{7}{2})$ and $(1,-\\frac{1}{2})$:\n\n![](images/c5/c561ff976a4fb6876962c42b14433f2142612410ca196feaee0f48b96dd79a23.png)"} {:db/id #edb/ref 17592186736950 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dec6fae-4374-549f-89a3-f5204fdaa1ba" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/efca6392c85b0640c6384c337d0db29056be514cab821329c946a8b18d869fc1.png" :db/id #edb/ref 17592186736922} {:answer/id #uuid "1f32c898-2cd6-5260-ad95-d00614872036" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/59/592fba55c497973d2368ec463990aa987c6b4dd05789edaee649d03a76559045.png" :db/id #edb/ref 17592186736924} {:answer/id #uuid "326d540d-c504-5305-85ea-186951664609" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ef/ef811748385a315e301ab20c3a89cf5eb709e588ed06f506c19f43c004a38c3c.png" :db/id #edb/ref 17592186736927} {:answer/id #uuid "b56b1d17-36a1-5e6e-8aad-9d5d315e9778" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/cb/cbea9a5b5dd3a9ce1e6688d903544285ea87367436b08be6440c18bb65849ccf.png" :db/id #edb/ref 17592186736945} {:answer/id #uuid "cc58fd4e-5514-5b53-b2ad-bbf706a74aba" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8a/8a241f0c6a4a305ca42c2dc2b8bdf09eec7ed77ea0f4584582a644bd7a863e5a.png" :db/id #edb/ref 17592186736949}] :answer-field/correct {:db/id #edb/ref 17592186736945} :answer-field/id #uuid "02b1ab17-ea97-57d7-9e7a-b3c516b3b3a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736920}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d7c2eff2-f502-5f64-a94b-66cdd14b73d8" :question/problem "Which of the following is the graph of $y=\\frac{3}{4x}-1$?" :question/worked-solution "Start with the curve $y=\\frac{1}{x}$.\n\n![](images/30/30a7bc0c953dce9fc0887f79c6f20979298be5cd27bb17477d944364e8f7e20b.png)\n\nStretch it by a scale factor of $\\frac{3}{4}$ parallel to the $y$-axis to obtain $y=\\frac{3}{4x}$.\n\n![](images/f9/f9c255636ae6cda97de434b11d62cc8d0648dd422223702db1fe5588c231767f.png)\n\nTranslate this curve $1$ unit down to obtain $y=\\frac{3}{4x}-1$.\n\n![](images/cb/cbea9a5b5dd3a9ce1e6688d903544285ea87367436b08be6440c18bb65849ccf.png)\n\nThe vertical asymptote is $x=0$ and the horizontal asymptote is $y=-1$. Check the marked points:\n\n$$\n\\begin{aligned}y\\big(-1\\big) &= \\frac{3}{4}\\div\\big(-1-(0)\\big)+(-1) = -\\frac{7}{4} \\\\ y\\big(1\\big) &= \\frac{3}{4}\\div\\big(1-(0)\\big)+(-1) = -\\frac{1}{4}\\end{aligned}\n$$\n\nThe required graph passes through $(-1,-\\frac{7}{4})$ and $(1,-\\frac{1}{4})$:\n\n![](images/cb/cbea9a5b5dd3a9ce1e6688d903544285ea87367436b08be6440c18bb65849ccf.png)"} {:db/id #edb/ref 17592186736954 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "123bf716-e413-5eab-895e-c81b59ec0a6b" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/470f5db8d45f3299e90b5a75d8e4ebe466b772508758fb135d8115cfaa8fff1b.png" :db/id #edb/ref 17592186736923} {:answer/id #uuid "78bf0916-a414-50e2-a5ad-d5440fd2a4e4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c6/c6fcb4dfaa83babd7ef9a175dc1210d57ddc654dea2a2ab935c3d01a6305f3a1.png" :db/id #edb/ref 17592186736932} {:answer/id #uuid "7d657ede-7367-5596-abf1-7866966c77be" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/11/116ffad8b2e0e33816bd30a81d6e8b5adf90a342a4f42a13f7c8b32e360f3d7b.png" :db/id #edb/ref 17592186736934} {:answer/id #uuid "80d6ac34-b5b4-5f21-80fa-416ee40fd59a" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bd/bdffff6b2962576f8724f4fbec17293be2b773ef838beb3724e81f35d653ed1c.png" :db/id #edb/ref 17592186736935} {:answer/id #uuid "b08477d2-9195-509d-ae0e-aa4ee0704cd8" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/4c/4cd59a53504e60ba38a0486bea1ad910ac9f149e0a97ac83195b87d9486390fe.png" :db/id #edb/ref 17592186736944}] :answer-field/correct {:db/id #edb/ref 17592186736944} :answer-field/id #uuid "e4ddb42b-2b20-56a4-afa4-abd039276f03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186736951}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f8c12e71-2a3f-5361-b8df-82a4a4f08165" :question/problem "Which of the following is the graph of $y=\\frac{1}{4x}+2$?" :question/worked-solution "Start with the curve $y=\\frac{1}{x}$.\n\n![](images/30/30a7bc0c953dce9fc0887f79c6f20979298be5cd27bb17477d944364e8f7e20b.png)\n\nStretch it by a scale factor of $\\frac{1}{4}$ parallel to the $y$-axis to obtain $y=\\frac{1}{4x}$.\n\n![](images/87/876c609b333f8bb62ec46f4f65990e8dded708249e8e89e5f70cae0ba413bb06.png)\n\nTranslate this curve $2$ units up to obtain $y=\\frac{1}{4x}+2$.\n\n![](images/4c/4cd59a53504e60ba38a0486bea1ad910ac9f149e0a97ac83195b87d9486390fe.png)\n\nThe vertical asymptote is $x=0$ and the horizontal asymptote is $y=2$. Check the marked points:\n\n$$\n\\begin{aligned}y\\big(-1\\big) &= \\frac{1}{4}\\div\\big(-1-(0)\\big)+(2) = \\frac{7}{4} \\\\ y\\big(1\\big) &= \\frac{1}{4}\\div\\big(1-(0)\\big)+(2) = \\frac{9}{4}\\end{aligned}\n$$\n\nThe required graph passes through $(-1,\\frac{7}{4})$ and $(1,\\frac{9}{4})$:\n\n![](images/4c/4cd59a53504e60ba38a0486bea1ad910ac9f149e0a97ac83195b87d9486390fe.png)"} {:db/id #edb/ref 17592186737166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fed4927-063f-595b-a3a1-ab189d766bc6" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/44/441e07622ac8e7ba7b64a804dd46230f6a783483dbfa8dcec1d9157ce77bcdc7.png" :db/id #edb/ref 17592186737154} {:answer/id #uuid "499168fc-9704-5510-aa72-f0c23bb39d43" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ac/ac6ce72c9775a7dc279d56f63783b4722707b2ce0a787a9d16a4c991e20146b4.png" :db/id #edb/ref 17592186737163} {:answer/id #uuid "5c30865f-114a-51df-bb92-6de9af284514" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/13/1377751bb22fabdc7a194950ef4a3def13292b5366db146cfea4c8b66675f4dd.png" :db/id #edb/ref 17592186737165} {:answer/id #uuid "704cbccc-7e87-5f31-8a1f-26459a99f2ac" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/05/05ac51d374708f1fef59efb75d2be0b878842fed354803a48180a63899dc7804.png" :db/id #edb/ref 17592186737168} {:answer/id #uuid "eed24a8f-a3a6-5e40-9cf9-fd97184bccb4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/de/de1171676851e50991dda06e2d501f19645d6df3a22565b7b604a71ba78e01b1.png" :db/id #edb/ref 17592186737186}] :answer-field/correct {:db/id #edb/ref 17592186737186} :answer-field/id #uuid "247d8499-7e41-54fb-85b3-8bc962e5c3ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186737155}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5d1e4e9f-44e5-55c7-9884-c5a4a1f7e895" :question/problem "Which of the following is the graph of $y=\\frac{2}{5x}?$" :question/worked-solution "To plot $y=\\frac{2}{5x},$ start with the curve $y=\\frac{1}{x}.$\n\n![](images/4c/4c6a80fdd6cb35516c42a8629fa36060785a4e6a0cd84a37e50bfd9e0b47456d.png)\n\nMultiply every $y$-coordinate by $\\frac{2}{5}$, keeping the $x$-coordinate fixed. This is a stretch by a scale factor of $\\frac{2}{5}$ parallel to the $y$-axis.\n\nAt $x=1$, the original height is $1$. The new height is\n\n$$\n\\frac{2}{5}\\cdot 1=\\frac{2}{5}.\n$$\n\nThus $(1, 1)$ maps to $(1, \\frac{2}{5})$, and $(-1, -1)$ maps to $(-1, -\\frac{2}{5})$. The asymptotes remain $x=0$ and $y=0$, and the branches lie in quadrants I and III. The required graph is shown below.\n\n![](images/de/de1171676851e50991dda06e2d501f19645d6df3a22565b7b604a71ba78e01b1.png)"} {:db/id #edb/ref 17592186737170 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d9adfdc-173a-5000-81ea-42f0d1666324" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/47/477fd9b704b3833b7cea2402978b148bd20e1e26518c5696d85130e9338f8569.png" :db/id #edb/ref 17592186737164} {:answer/id #uuid "b910d6d1-fad3-5253-944b-72ec539dcc50" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b4/b42409e59f9a12f00f53af1aa9e004580fdb70026de5ab69cd747670b256a184.png" :db/id #edb/ref 17592186737178} {:answer/id #uuid "ddd30e7f-4f4c-5dc7-8213-1d497d40bf6d" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/07/07de1f3b191d0699c9f2c07cab57c3d23db36c4284a761bdae8b3fb3e92cb049.png" :db/id #edb/ref 17592186737183} {: