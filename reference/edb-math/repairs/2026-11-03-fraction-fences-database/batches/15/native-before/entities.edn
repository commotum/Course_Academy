/ref 17592186715141}] :answer-field/correct {:db/id #edb/ref 17592186715109} :answer-field/id #uuid "cdbb9ce6-e15e-5147-8501-ab6059416297" :answer-field/key "$(2,\\frac{\\pi}{4} + 3)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186715139} {:db/id #edb/ref 17592186715143 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b51f4e8-0208-5589-ae97-68b24880e5d7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186715105} {:answer/id #uuid "be5c4c4b-9920-5c8a-b25e-ca791a89fc66" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186715131}] :answer-field/correct {:db/id #edb/ref 17592186715105} :answer-field/id #uuid "61e796bc-5bfd-5b3d-b899-1f85d81ad269" :answer-field/key "$(\\frac{1}{2},\\frac{\\pi}{4} + 3)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186715118} {:answer-field/choices [{:answer/id #uuid "b7cfd159-c822-58a1-903f-d9344c393aa9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186715130} {:answer/id #uuid "f4c4a391-25eb-5377-beca-92dbf0fa15a6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186715146}] :answer-field/correct {:db/id #edb/ref 17592186715146} :answer-field/id #uuid "8ab5448c-d512-577b-b862-912774ca49b7" :answer-field/key "$(1,\\frac{\\pi}{4})$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186715124} {:answer-field/choices [{:answer/id #uuid "780853e5-5c89-53bb-b875-4478a2919983" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186715120} {:answer/id #uuid "780e51d1-2809-5942-87eb-11a1ae7561f9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186715121}] :answer-field/correct {:db/id #edb/ref 17592186715121} :answer-field/id #uuid "cb362292-7e7e-58c8-bcb7-d00b8a126ecd" :answer-field/key "$(1,\\frac{\\pi}{4} + 3)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186715137} {:answer-field/choices [{:answer/id #uuid "2489a509-d793-51cc-ba69-b9d03f48e8fa" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186715109} {:answer/id #uuid "d6354534-59f2-5ab8-b37d-ccfd6aac6ccf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186715141}] :answer-field/correct {:db/id #edb/ref 17592186715109} :answer-field/id #uuid "cdbb9ce6-e15e-5147-8501-ab6059416297" :answer-field/key "$(2,\\frac{\\pi}{4} + 3)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186715139}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "e50aa7db-2d04-5790-8062-ba00a39f59e9" :question/problem "Given $f(x,y)=\\left(x - 1\\right)^{2} - 2 \\left(x - 1\\right) \\cos{\\left(2 y - 6 \\right)}$, find the points $(x,y)$ where $\\nabla f=\\mathbf 0$. The domain is $3\\le y<\\frac{\\pi}{2} + 3$.\n\nSelect all that apply." :question/worked-solution "A gradient vanishes exactly when every component vanishes. Differentiate with respect to each variable, holding the others constant.\n\n$$\n\\begin{aligned}f_{x}&=2 x - 2 \\cos{\\left(2 y - 6 \\right)} - 2 \\\\ f_{y}&=4 \\left(x - 1\\right) \\sin{\\left(2 y - 6 \\right)}\\end{aligned}\n$$\n\nSet all components equal to zero:\n\n$$\n\\left\\{\\begin{aligned}2 x - 2 \\cos{\\left(2 y - 6 \\right)} - 2&=0 \\\\ 4 \\left(x - 1\\right) \\sin{\\left(2 y - 6 \\right)}&=0\\end{aligned}\\right.\n$$\n\nTo write the simultaneous equations compactly, let $u=x - 1,\\ v=y - 3$. The first equation gives $u=\\cos{\\left(2 v \\right)}$. After substitution and division by the nonzero constant $4$, the second equation becomes\n\n$$\n\\begin{aligned}\\sin{\\left(2 v \\right)} \\cos{\\left(2 v \\right)}&=0\\end{aligned}\n$$\n\nA product is zero if at least one factor is zero. In $0\\le 2 v<\\pi$, this gives $v=0$ or $v=\\frac{\\pi}{4}$. The corresponding values of $u$ are $1$ and $0$, respectively. The upper boundary is excluded. Recover the original coordinates using $x=u + 1,\\ y=v + 3$.\n\nTherefore, the complete set of points in the domain is $(2,3)$ and $(1,\\frac{\\pi}{4} + 3)$. Each satisfies every component equation."} {:answer/id #uuid "ed507749-492b-5106-944b-d1bafc39b059" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,- \\frac{1}{2})" :db/id #edb/ref 17592186715144} {:db/id #edb/ref 17592186715164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7e86177-77a7-54e3-8a96-7d0c61cbcc82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186715174}] :answer-field/correct {:db/id #edb/ref 17592186715174} :answer-field/id #uuid "3265fcb0-04dc-557f-8e18-589d30ad167a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186715162} {:answer-field/choices [{:answer/id #uuid "db6f5313-511a-512e-a4ad-343a63b12849" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186715177}] :answer-field/correct {:db/id #edb/ref 17592186715177} :answer-field/id #uuid "8ab453fe-8aa4-564b-accb-6da4459c6b60" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186715171}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5bd3102a-23b8-5459-baba-a2907d346127" :question/problem "![Circle with labeled points and marked center.](images/6c/6c4245b8f69409c6596c732b08027702b4dfedaa4e1532802d496f8dba6157f1.png)\n\nThe points $A(\\frac{1}{2},\\frac{3}{2})$, $B(2,7)$, $C(6,0)$ lie on the circle. We know that $\\overline{BC}$ passes through the center $O$; $\\overline{BA}$ does not pass through $O$. Find the coordinates $(h,k)$ of $O$.\n\n$(h,k)=(${{field-1}}$,${{field-2}}$)$" :question/worked-solution "A chord through the center is a diameter, so $\\overline{BC}$ is the diameter to use. The other chord is not a diameter. Average corresponding coordinates:\n\n$$\n\\begin{aligned}\n(h,k)&=\\left(\\frac{x_1+x_2}{2},\\frac{y_1+y_2}{2}\\right)\\\\\n&=\\left(\\frac{(2)+(6)}{2},\\frac{(7)+(0)}{2}\\right)\\\\\n&=\\left(\\frac{8}{2},\\frac{7}{2}\\right)\\\\\n&=(4,\\frac{7}{2}).\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715181 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4381bf05-59cf-5164-8798-58e814b9a555" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "64" :db/id #edb/ref 17592186715192} {:answer/id #uuid "44b932b2-e799-51ab-a86f-4b45c2bbb328" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{160}{3}" :db/id #edb/ref 17592186715194} {:answer/id #uuid "8c486199-ab33-59d6-b937-52aafe291c89" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{20}{3}" :db/id #edb/ref 17592186715202} {:answer/id #uuid "ca8549ba-08ac-5bce-a636-8bcc1e9cd00e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "32" :db/id #edb/ref 17592186715209} {:answer/id #uuid "fadb0ae7-438e-5308-94bc-1fe2bd60c123" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186715214}] :answer-field/correct {:db/id #edb/ref 17592186715194} :answer-field/id #uuid "210210f9-bf3b-5f42-ab47-3e86e71a12da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715182}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0a636888-8d28-5c5e-be75-f374d8a412fd" :question/problem "Evaluate the integral of the function $f(x,y)=x + \\sqrt{2} \\sqrt{y}$ along the line segment from $(4,0)$ to $(4,8)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(4,0)$ to $(4,8).$\n\nThe position vectors of the endpoints of our line segment are $a=(4)\\,i+(0)\\,j$ and $b=(4)\\,i+(8)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(4)\\,i+(0)\\,j+t((0)\\,i+(8)\\,j) \\\\  & =(4)\\,i+(8 \\cdot t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=4$ and $y=8 \\cdot t$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(4)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(8 \\cdot t)j \\\\  & =(0)\\,i+(8)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(0)^2+(8)^2} \\\\  & =8\\end{aligned}\n$$\n\nNow, since $f(x,y)=x + \\sqrt{2} \\cdot \\sqrt{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =4+\\sqrt{2(8 \\cdot t)} \\\\  & =4 \\cdot \\sqrt{t} + 4.\\end{aligned}\n$$\n\nWrite $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (4 \\cdot \\sqrt{t} + 4)\\cdot 8\\,\\mathrm{d}t \\\\  & =32\\int_0^1 (\\sqrt{t} + 1)\\,\\mathrm{d}t \\\\  & =32[\\frac{2 \\cdot t^{\\frac{3}{2}}}{3} + t]_0^1 \\\\  & =32(1+\\frac{2}{3})-0 \\\\  & =\\frac{160}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715185 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "391c0889-2862-5b7c-9848-932bdc7d0d21" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17 \\sqrt{5}}{6}" :db/id #edb/ref 17592186715189} {:answer/id #uuid "4f470f52-d7f0-596d-a1b0-b59b23a040dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{17 \\sqrt{5}}{30}" :db/id #edb/ref 17592186715197} {:answer/id #uuid "60d4bc76-4114-5a67-9f7b-daec47a60eec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{5}" :db/id #edb/ref 17592186715198} {:answer/id #uuid "756a07a5-5361-53a6-8748-4ad443b8ad61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{85}{6}" :db/id #edb/ref 17592186715199} {:answer/id #uuid "7d7d9913-1024-53dd-891b-a289ce32636b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 \\sqrt{5}" :db/id #edb/ref 17592186715201}] :answer-field/correct {:db/id #edb/ref 17592186715189} :answer-field/id #uuid "36b1d832-b690-50d3-981c-3110350e7197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715188}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b872693-83a3-59ed-b613-9f324c1dd7b1" :question/problem "Evaluate the integral of the function $f(x,y)=x y$ along the line segment from $(-1,-2)$ to $(-3,-1)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(-1,-2)$ to $(-3,-1).$\n\nThe position vectors of the endpoints of our line segment are $a=(-1)\\,i+(-2)\\,j$ and $b=(-3)\\,i+(-1)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(-1)\\,i+(-2)\\,j+t((-2)\\,i+(1)\\,j) \\\\  & =(- 2 \\cdot t - 1)\\,i+(t - 2)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=- 2 \\cdot t - 1$ and $y=t - 2$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(- 2 \\cdot t - 1)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(t - 2)j \\\\  & =(-2)\\,i+(1)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(-2)^2+(1)^2} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x \\cdot y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =1(- 2 \\cdot t - 1)(t - 2) \\\\  & =- 2 \\cdot t^{2} + 3 \\cdot t + 2.\\end{aligned}\n$$\n\nWrite $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (- 2 \\cdot t^{2} + 3 \\cdot t + 2)\\cdot \\sqrt{5}\\,\\mathrm{d}t \\\\  & =\\sqrt{5}\\int_0^1 (- 2 \\cdot t^{2} + 3 \\cdot t + 2)\\,\\mathrm{d}t \\\\  & =\\sqrt{5}[- \\frac{2 \\cdot t^{3}}{3} + \\frac{3 \\cdot t^{2}}{2} + 2 \\cdot t]_0^1 \\\\  & =\\sqrt{5}(\\left(- \\frac{2}{3}\\right)+\\left(\\frac{3}{2}\\right)+(2))-\\sqrt{5}(0) \\\\  & =\\frac{17 \\cdot \\sqrt{5}}{6}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25d42980-dc2d-56ad-94ee-c3459c6dd64b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{e^{2}}" :db/id #edb/ref 17592186715183} {:answer/id #uuid "43e50f2c-180e-5fb1-8a49-32c2fe0fd7a3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{2} - \\frac{1}{2 e^{2}}" :db/id #edb/ref 17592186715193} {:answer/id #uuid "4d571f1a-f650-5ad8-bd0e-8e09630b3057" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2} - \\frac{5}{2 e^{2}}" :db/id #edb/ref 17592186715196} {:answer/id #uuid "8c62e71d-629d-5d96-be4b-faba71e39535" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{e}" :db/id #edb/ref 17592186715203} {:answer/id #uuid "927cd613-0339-58bf-aa75-cf2980519053" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{2 e^{2}}" :db/id #edb/ref 17592186715205}] :answer-field/correct {:db/id #edb/ref 17592186715196} :answer-field/id #uuid "ed2746b9-6697-53fa-966a-fc6e7780e3df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715212}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "313f7369-bfdb-5e4e-8ed5-75fd5386bc7a" :question/problem "Evaluate the integral of the function $f(x,y)=e^{2 x - y}$ along the line segment from $(0,0)$ to $(-3,-4)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(0,0)$ to $(-3,-4).$\n\nThe position vectors of the endpoints of our line segment are $a=(0)\\,i+(0)\\,j$ and $b=(-3)\\,i+(-4)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(0)\\,i+(0)\\,j+t((-3)\\,i+(-4)\\,j) \\\\  & =(- 3 \\cdot t)\\,i+(- 4 \\cdot t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=- 3 \\cdot t$ and $y=- 4 \\cdot t$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(- 3 \\cdot t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(- 4 \\cdot t)j \\\\  & =(-3)\\,i+(-4)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(-3)^2+(-4)^2} \\\\  & =5\\end{aligned}\n$$\n\nNow, since $f(x,y)=e^{2 \\cdot x - y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =e^{2(- 3 \\cdot t)+-1(- 4 \\cdot t)} \\\\  & =e^{- 2 \\cdot t}.\\end{aligned}\n$$\n\nThe exponent has derivative $-2$. With $u=- 2 t$, $\\mathrm{d}u=-2\\,\\mathrm{d}t$; the new bounds are $0$ and $-2$. Write $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (e^{- 2 \\cdot t})\\cdot 5\\,\\mathrm{d}t \\\\  & =5\\int_0^1 (e^{- 2 \\cdot t})\\,\\mathrm{d}t \\\\  & =5[- \\frac{e^{- 2 \\cdot t}}{2}]_0^1 \\\\  & =5\\left(- \\frac{1}{2 \\cdot e^{2}}\\right)-5\\left(- \\frac{1}{2}\\right) \\\\  & =\\frac{5}{2} - \\frac{5}{2 \\cdot e^{2}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715208 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27ef17db-85a9-5e05-b565-20c46491936b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13} \\left(\\frac{1}{4} - \\frac{1}{4 e^{4}}\\right)" :db/id #edb/ref 17592186715184} {:answer/id #uuid "355d6ca3-cc94-5cfc-9355-c3dbfdad4439" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{4} - \\frac{13}{4 e^{4}}" :db/id #edb/ref 17592186715187} {:answer/id #uuid "3c1c9f2f-c604-5ada-be8e-91fe2c6d8be0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{\\sqrt{13}}{4 e^{4}}" :db/id #edb/ref 17592186715190} {:answer/id #uuid "4a2fba77-177c-58f9-b8f7-529e681541fa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186715195} {:answer/id #uuid "9f7f3fe1-e0de-51fd-939b-1479d864ddda" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{13}}{e^{4}}" :db/id #edb/ref 17592186715206}] :answer-field/correct {:db/id #edb/ref 17592186715184} :answer-field/id #uuid "f32734d2-670b-5bdf-adf1-29a4d1cae4d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715213}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bd4b390e-42be-5720-a814-8bcc9ccd72fe" :question/problem "Evaluate the integral of the function $f(x,y)=e^{x - 2 y}$ along the line segment from $(0,0)$ to $(2,3)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(0,0)$ to $(2,3).$\n\nThe position vectors of the endpoints of our line segment are $a=(0)\\,i+(0)\\,j$ and $b=(2)\\,i+(3)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(0)\\,i+(0)\\,j+t((2)\\,i+(3)\\,j) \\\\  & =(2 \\cdot t)\\,i+(3 \\cdot t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=2 \\cdot t$ and $y=3 \\cdot t$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(2 \\cdot t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 \\cdot t)j \\\\  & =(2)\\,i+(3)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(2)^2+(3)^2} \\\\  & =\\sqrt{13}\\end{aligned}\n$$\n\nNow, since $f(x,y)=e^{x - 2 \\cdot y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =e^{1(2 \\cdot t)+-2(3 \\cdot t)} \\\\  & =e^{- 4 \\cdot t}.\\end{aligned}\n$$\n\nThe exponent has derivative $-4$. With $u=- 4 t$, $\\mathrm{d}u=-4\\,\\mathrm{d}t$; the new bounds are $0$ and $-4$. Write $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (e^{- 4 \\cdot t})\\cdot \\sqrt{13}\\,\\mathrm{d}t \\\\  & =\\sqrt{13}\\int_0^1 (e^{- 4 \\cdot t})\\,\\mathrm{d}t \\\\  & =\\sqrt{13}[- \\frac{e^{- 4 \\cdot t}}{4}]_0^1 \\\\  & =\\sqrt{13}\\left(- \\frac{1}{4 \\cdot e^{4}}\\right)-\\sqrt{13}\\left(- \\frac{1}{4}\\right) \\\\  & =\\sqrt{13} \\cdot \\left(\\frac{1}{4} - \\frac{1}{4 \\cdot e^{4}}\\right)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715211 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b5aaa62-558c-5a75-9cb5-f75979c4c39f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{208}{3}" :db/id #edb/ref 17592186715200} {:answer/id #uuid "8efde685-6cbd-510d-ae84-0d36c2db30d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{52}{3}" :db/id #edb/ref 17592186715204} {:answer/id #uuid "ad22a76b-a84f-5174-a5a1-e1231a897ccb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{3}" :db/id #edb/ref 17592186715207} {:answer/id #uuid "cb748e28-4aba-5b38-a72b-bb64aa17dea2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186715210} {:answer/id #uuid "ffae357d-b834-58d9-b422-b7efa0fdd422" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24" :db/id #edb/ref 17592186715215}] :answer-field/correct {:db/id #edb/ref 17592186715204} :answer-field/id #uuid "3ecd51a7-f19f-548f-affc-c76063080a43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715191}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "dcb2c7fc-28da-5916-824c-451d7e631fef" :question/problem "Evaluate the integral of the function $f(x,y)=x + \\sqrt{y}$ along the line segment from $(3,0)$ to $(3,4)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(3,0)$ to $(3,4).$\n\nThe position vectors of the endpoints of our line segment are $a=(3)\\,i+(0)\\,j$ and $b=(3)\\,i+(4)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(3)\\,i+(0)\\,j+t((0)\\,i+(4)\\,j) \\\\  & =(3)\\,i+(4 \\cdot t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=3$ and $y=4 \\cdot t$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(3)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(4 \\cdot t)j \\\\  & =(0)\\,i+(4)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(0)^2+(4)^2} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $f(x,y)=x + \\sqrt{y}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =3+\\sqrt{1(4 \\cdot t)} \\\\  & =2 \\cdot \\sqrt{t} + 3.\\end{aligned}\n$$\n\nWrite $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (2 \\cdot \\sqrt{t} + 3)\\cdot 4\\,\\mathrm{d}t \\\\  & =12\\int_0^1 (\\frac{2 \\cdot \\sqrt{t}}{3} + 1)\\,\\mathrm{d}t \\\\  & =12[\\frac{4 \\cdot t^{\\frac{3}{2}}}{9} + t]_0^1 \\\\  & =12(1+\\frac{4}{9})-0 \\\\  & =\\frac{52}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715237 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d859a45-2d24-5733-b5ce-090bb96eee20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{1}{2}" :db/id #edb/ref 17592186715221} {:answer/id #uuid "af5f8014-3716-5633-b445-db2ab9fb5a55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186715234} {:answer/id #uuid "b517e76d-315f-58aa-bbe6-31bca347a6c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{9}{2}" :db/id #edb/ref 17592186715235} {:answer/id #uuid "dbdda10f-ccff-52ae-9ba8-bdeb80ab358a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{27}{2}" :db/id #edb/ref 17592186715241} {:answer/id #uuid "e4b1bda7-79a0-5976-b7c6-0d1f831b4aaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{3}{2}" :db/id #edb/ref 17592186715243}] :answer-field/correct {:db/id #edb/ref 17592186715235} :answer-field/id #uuid "855c1db7-705c-5165-be38-ad94479bd374" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715229}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c3fadd4b-2de1-5903-9803-1d2eb7373efc" :question/problem "Evaluate the integral of the function $f(x,y)=x - y$ along the line segment from $(0,3)$ to $(3,3)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(0,3)$ to $(3,3).$\n\nThe position vectors of the endpoints of our line segment are $a=(0)\\,i+(3)\\,j$ and $b=(3)\\,i+(3)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(0)\\,i+(3)\\,j+t((3)\\,i+(0)\\,j) \\\\  & =(3 \\cdot t)\\,i+(3)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=3 \\cdot t$ and $y=3$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(3 \\cdot t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(3)j \\\\  & =(3)\\,i+(0)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(3)^2+(0)^2} \\\\  & =3\\end{aligned}\n$$\n\nNow, since $f(x,y)=x - y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =1(3 \\cdot t)+-1(3) \\\\  & =3 \\cdot t - 3.\\end{aligned}\n$$\n\nWrite $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (3 \\cdot t - 3)\\cdot 3\\,\\mathrm{d}t \\\\  & =3\\int_0^1 (3 \\cdot t - 3)\\,\\mathrm{d}t \\\\  & =3[\\frac{3 \\cdot t^{2}}{2} - 3 \\cdot t]_0^1 \\\\  & =3(\\left(\\frac{3}{2}\\right)+(-3))-3(0) \\\\  & =- \\frac{9}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715257 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2eae9537-53e2-5329-a725-2b37a8456fe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\sqrt{5}" :db/id #edb/ref 17592186715248} {:answer/id #uuid "50d2d4bd-6772-5d13-9299-0adc80baada1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5} \\pi}{4}" :db/id #edb/ref 17592186715249} {:answer/id #uuid "578fb4fd-b946-550e-a1bb-57d3468590af" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{5}}{5 \\pi}" :db/id #edb/ref 17592186715251} {:answer/id #uuid "9a5ab190-3845-5322-a0ef-f24db46b7228" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{\\frac{\\sqrt{2}}{4} + \\frac{1}{2}}" :db/id #edb/ref 17592186715253} {:answer/id #uuid "f7825599-5599-5ac3-ba42-a32d53dec4ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{5}}{\\pi}" :db/id #edb/ref 17592186715258}] :answer-field/correct {:db/id #edb/ref 17592186715258} :answer-field/id #uuid "c6247103-1410-507e-bfa7-65baf8bb5c8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715254}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "d6a9db83-3d82-56b0-9ed1-9f225cbf7226" :question/problem "Evaluate the integral of the function $f(x,y)=\\sec^{2}{\\left(\\frac{\\pi \\left(- x + y\\right)}{12} \\right)}$ along the line segment from $(0,0)$ to $(1,-2)$." :question/worked-solution "We will use the formula\n\n$$\n\\int_C f(x,y)\\,\\mathrm{d}s=\\int_{t_a}^{t_b} f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t,\n$$\n\nwhere $C$ is the line segment from $(0,0)$ to $(1,-2).$\n\nThe position vectors of the endpoints of our line segment are $a=(0)\\,i+(0)\\,j$ and $b=(1)\\,i+(-2)\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =(0)\\,i+(0)\\,j+t((1)\\,i+(-2)\\,j) \\\\  & =(t)\\,i+(- 2 \\cdot t)\\,j\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x=t$ and $y=- 2 \\cdot t$ along the segment.\n\nComputing $r\\prime(t)$ and $\\|r\\prime(t)\\|,$ we get the following:\n\n$$\n\\begin{aligned}r\\prime(t) & =\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\,i+\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\,j \\\\  & =\\frac{\\mathrm{d}}{\\mathrm{d}t}(t)i+\\frac{\\mathrm{d}}{\\mathrm{d}t}(- 2 \\cdot t)j \\\\  & =(1)\\,i+(-2)\\,j \\\\ \\|r\\prime(t)\\| & =\\sqrt{\\left(\\frac{\\mathrm{d}x}{\\mathrm{d}t}\\right)^2+\\left(\\frac{\\mathrm{d}y}{\\mathrm{d}t}\\right)^2} \\\\  & =\\sqrt{(1)^2+(-2)^2} \\\\  & =\\sqrt{5}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\sec^{2}{\\left(\\frac{\\pi \\cdot \\left(- x + y\\right)}{12} \\right)}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\sec^2\\left(\\frac{\\pi((- 2 \\cdot t)-(t))}{12}\\right) \\\\  & =\\sec^2\\left(- \\frac{\\pi \\cdot t}{4}\\right).\\end{aligned}\n$$\n\nWrite $I=\\int_C f(x,y)\\,\\mathrm{d}s$. Then\n\n$$\n\\begin{aligned}I & =\\int_0^1 f(r(t))\\,\\|r\\prime(t)\\|\\,\\mathrm{d}t \\\\  & =\\int_0^1 (\\sec^2\\left(- \\frac{\\pi \\cdot t}{4}\\right))\\cdot \\sqrt{5}\\,\\mathrm{d}t \\\\  & =\\sqrt{5}\\int_0^1 (\\sec^2\\left(- \\frac{\\pi \\cdot t}{4}\\right))\\,\\mathrm{d}t\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=- \\frac{\\pi \\cdot t}{4},$ $\\mathrm{d}u=\\left(- \\frac{\\pi}{4}\\right)\\,\\mathrm{d}t$ as follows: \n\n$$\n\\begin{aligned}I & =- \\frac{4 \\cdot \\sqrt{5}}{\\pi}\\int_{0}^{- \\frac{\\pi}{4}}\\sec^2 u\\,\\mathrm{d}u \\\\  & =- \\frac{4 \\cdot \\sqrt{5}}{\\pi}[\\tan u]_{0}^{- \\frac{\\pi}{4}} \\\\  & =- \\frac{4 \\cdot \\sqrt{5}}{\\pi}(\\tan\\left(- \\frac{\\pi}{4}\\right)-\\tan(0)) \\\\  & =- \\frac{4 \\cdot \\sqrt{5}}{\\pi}(-1-0) \\\\  & =\\frac{4 \\cdot \\sqrt{5}}{\\pi}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186715875 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e3d103f-c580-5835-ae96-21c9aee51433" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R_{2}:=\\frac{1}{3}R_{2}" :db/id #edb/ref 17592186715873} {:answer/id #uuid "7aa22299-764c-5ca9-b7bb-a215c5854c48" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R_{2}:=R_{2}-2R_{1}" :db/id #edb/ref 17592186715876} {:answer/id #uuid "7bcae66e-bd5a-5572-be93-aaba7a6105ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R_{2}:=R_{2}+R_{3}" :db/id #edb/ref 17592186715877} {:answer/id #uuid "c26840a6-d0e3-529e-8611-9dd644fa0979" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R_{2}:=R_{2}+2R_{1}" :db/id #edb/ref 17592186715882} {:answer/id #uuid "d786bbf3-fd59-5226-aa73-325ff0fbc85a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R_{2}:=R_{2}-R_{3}" :db/id #edb/ref 17592186715885}] :answer-field/correct {:db/id #edb/ref 17592186715885} :answer-field/id #uuid "d2267eb9-2e41-5775-b213-c3f0aaefcfa9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186715884}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6ed33f09-b04d-5cfa-b765-7bd3f7c04da3" :question/problem "Which of the following elementary row operations transforms the matrix $A$ into the matrix $B$?\n\n$$\nA=\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & 6 & -1 \\\\ 2 & 4 & 3\\end{bmatrix}\n$$\n\n$$\nB=\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 2 & -4 \\\\ 2 & 4 & 3\\end{bmatrix}\n$$" :question/worked-solution "Only the second row changes. To identify the operation, compare the change in every entry of that row:\n\n$$\n(1-3,\\;2-6,\\;-4-(-1))=(-2,-4,-3).\n$$\n\nThis change is the negative of the third row, $(2,4,3)$, so subtract the third row from the second:\n\n$$\nR_{2}:=R_{2}-R_{3}.\n$$\n\nChecking all three entries gives\n\n$$\n3-2=1,\\qquad 6-4=2,\\qquad -1-3=-4.\n$$\n\nThe full transformation is\n\n$$\n\\begin{bmatrix}1 & 2 & 1 \\\\ 3 & 6 & -1 \\\\ 2 & 4 & 3\\end{bmatrix}\\;\\sim\\;\\begin{bmatrix}1 & 2 & 1 \\\\ 1 & 2 & -4 \\\\ 2 & 4 & 3\\end{bmatrix}=B.\n$$\n\nChecking only the first two columns would leave three candidates. The operation $R_{2}:=R_{2}-2R_{1}$ gives $(1,2,-3)$, and $R_{2}:=\\frac{1}{3}R_{2}$ gives $(1,2,-\\frac{1}{3})$. Neither matches the third entry, $-4$."} {:db/id #edb/ref 17592186716498 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "218eee34-40b1-5a10-ad05-d8f099789f6f" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b7/b7599219def48e5b530fc88388e5900513a80ea93d62fd2660168d6a82bc2ed6.png" :db/id #edb/ref 17592186716499} {:answer/id #uuid "3522052b-45c5-56cb-8ebe-a4a5bc9af323" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/10/10e790e832f4386ea039ced6a9aa43da6fd08aaab6724a9dbcfb81e0f91e91ef.png" :db/id #edb/ref 17592186716507} {:answer/id #uuid "632919d3-1e7f-51bc-9a0c-d75d75b1df01" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ab/aba594c7d5c7692bd0ee60003716aaa789df4d1cc4e30b30058d358af8735ac0.png" :db/id #edb/ref 17592186716518} {:answer/id #uuid "accbc5b9-ab0e-5e62-9eb5-15d26c8ad431" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b9/b90c225e1b54983b63effa34233dff9becd552a1e5dcb55c111bdca429a21a67.png" :db/id #edb/ref 17592186716525} {:answer/id #uuid "f27bac68-519b-56e9-9f70-96c6a9121bf0" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/bd/bd437f8d0cbe958ac529c4f362d8325a8ce1d9d273eeb65ef0b646c4e6d653a4.png" :db/id #edb/ref 17592186716548}] :answer-field/correct {:db/id #edb/ref 17592186716525} :answer-field/id #uuid "46d909e6-00ed-55c2-848f-74efbaa42d1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186716510} {:answer-field/choices [{:answer/id #uuid "c8f812cf-32a2-5f59-8bcb-4d320350c4b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186716535}] :answer-field/correct {:db/id #edb/ref 17592186716535} :answer-field/id #uuid "48b54b55-aee5-5791-84f7-842a57ca1c96" :answer-field/key "point-x" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186716511} {:answer-field/choices [{:answer/id #uuid "c5f8547b-3fea-565f-9ecf-81074ba371d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi}{3}" :db/id #edb/ref 17592186716533}] :answer-field/correct {:db/id #edb/ref 17592186716533} :answer-field/id #uuid "6ab531ba-be81-59b0-a87a-4abba83b49d9" :answer-field/key "point-y" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186716519}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1a90d0fa-f904-5b3d-ad2b-c8fa3e0d1a24" :question/problem "The graph is $f(t)=\\sin t$ restricted to $[-\\pi/2,\\pi/2]$.\n\n![Restricted sine with a marked point](images/2c/2c3aa64bdc402a55f7a725dec7f6b54191dcf56deb0f1ea5326f1fa6d113b661.png)\n\nReflect it in $y=x$ to obtain $y=\\arcsin x$. The marked point becomes a point with $x$-coordinate {{point-x}} and $y$-coordinate {{point-y}}. Give exact values.\n\nSelect the reflected graph. Every candidate has domain $[-1,1]$, range $[-\\pi/2,\\pi/2]$, the same endpoints, and increases through $(0,0)$. Use the marked interior point." :question/worked-solution "Reflection in $y=x$ swaps coordinates:\n\n$$\n(-\\frac{\\pi}{3},-\\frac{\\sqrt{3}}{2})\\longmapsto(-\\frac{\\sqrt{3}}{2},-\\frac{\\pi}{3}).\n$$\n\nThe blanks are $-\\frac{\\sqrt{3}}{2}$ and $-\\frac{\\pi}{3}$. The endpoints reflect to $(-1,-\\pi/2)$ and $(1,\\pi/2)$. Endpoint and direction checks alone do not distinguish these candidates. At $x=-\\frac{\\sqrt{3}}{2}$, only the graph below has height $-\\frac{\\pi}{3}$; it follows the reflected sine curve. The other graphs place the marked interior point too high or too low.\n\n![](images/b9/b90c225e1b54983b63effa34233dff9becd552a1e5dcb55c111bdca429a21a67.png)"} {:db/id #edb/ref 17592186716512 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7cabe7d-1586-51f4-9ade-a9719faa2c1e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\pi}{6}" :db/id #edb/ref 17592186716546}] :answer-field/correct {:db/id #edb/ref 17592186716546} :answer-field/id #uuid "15f9fd6f-a193-5122-875d-850adc0374f0" :answer-field/key "point-y" :answer-field/type {:db/id #edb/ref 17592186045492} :db/id #edb/ref 17592186716497} {:answer-field/choices [{:answer/id #uuid "2860534b-d743-5f8f-a6fa-13c490cd01ad" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/31/31da885dac479c66b7e8d7b16681510671cd6c71d9f0bcc68d1af93764775358.png" :db/id #edb/ref 17592186716500} {:answer/id #uuid "2dd66285-56e5-50f3-89be-469dbd6f4d1d" :answer/type {:db/id #edb/ref 17