(x,y)&=- 2 y \\\\ \\nabla f(2,2)&=\\langle 4,-4\\rangle\n\\end{aligned}\n$$\n\nNormalize the direction vector:\n\n$$\n\\begin{aligned}\n\\|\\mathbf v\\|&=\\sqrt{(6)^2+(8)^2}=10 \\\\ \\mathbf u&=\\langle \\frac{3}{5},\\frac{4}{5}\\rangle\n\\end{aligned}\n$$\n\nThen take the dot product:\n\n$$\n\\begin{aligned}\nD_{\\mathbf u}f&=\\langle 4,-4\\rangle\\cdot \\langle \\frac{3}{5},\\frac{4}{5}\\rangle \\\\ &=\\frac{(4)(6)+(-4)(8)}{10} \\\\ &=- \\frac{4}{5}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186732633 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2294d6-8cc9-5443-9ce8-c649481d8ae1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{12 \\sqrt{5}}{5}" :db/id #edb/ref 17592186732608} {:answer/id #uuid "3170bcb3-d228-54e6-9af4-146ac8c893ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\sqrt{2}" :db/id #edb/ref 17592186732610} {:answer/id #uuid "93c0f5b1-6761-5b3c-8799-c2817ccda258" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{6}{5}" :db/id #edb/ref 17592186732619} {:answer/id #uuid "c83a32a1-2eb4-5f33-bf44-a7942ab07a64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{24 \\sqrt{5}}{5}" :db/id #edb/ref 17592186732626} {:answer/id #uuid "d397c11a-7002-5c4a-84af-ad51332a4c1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{12 \\sqrt{5}}{5}" :db/id #edb/ref 17592186732629}] :answer-field/correct {:db/id #edb/ref 17592186732629} :answer-field/id #uuid "df56d637-a51e-5b15-b4c1-9fef0e850144" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732630}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f6db4cf8-9d3d-5972-b123-711c1455e115" :question/problem "Consider the function $f(x,y)=- x^{2} - 2 y^{2}$. What is the signed rate of change of $f$ at the point $(2,1)$ in the direction of the vector $\\mathbf v=\\langle 2,4\\rangle$?" :question/worked-solution "The rate is the directional derivative $D_{\\mathbf u}f=\\nabla f\\cdot\\mathbf u$, with $\\mathbf u$ a unit vector.\n\nCompute the partial derivatives and evaluate them at the given point:\n\n$$\n\\begin{aligned}\nf_x(x,y)&=- 2 x \\\\ f_y(x,y)&=- 4 y \\\\ \\nabla f(2,1)&=\\langle -4,-4\\rangle\n\\end{aligned}\n$$\n\nNormalize the direction vector:\n\n$$\n\\begin{aligned}\n\\|\\mathbf v\\|&=\\sqrt{(2)^2+(4)^2}=2 \\sqrt{5} \\\\ \\mathbf u&=\\langle \\frac{\\sqrt{5}}{5},\\frac{2 \\sqrt{5}}{5}\\rangle\n\\end{aligned}\n$$\n\nThen take the dot product:\n\n$$\n\\begin{aligned}\nD_{\\mathbf u}f&=\\langle -4,-4\\rangle\\cdot \\langle \\frac{\\sqrt{5}}{5},\\frac{2 \\sqrt{5}}{5}\\rangle \\\\ &=\\frac{(-4)(2)+(-4)(4)}{2 \\sqrt{5}} \\\\ &=- \\frac{12 \\sqrt{5}}{5}\n\\end{aligned}\n$$"} {:db/id #edb/ref 17592186732649 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c89c55e-c23c-577e-8a0b-5120b467f822" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186732655} {:answer/id #uuid "84bf5108-8d54-54ba-958b-e3ef9c085cad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- \\frac{2}{5}" :db/id #edb/ref 17592186732661} {:answer/id #uuid "a07bbe60-bbf5-5473-a518-a3817bfeb2de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{14}{5}" :db/id #edb/ref 17592186732665} {:answer/id #uuid "c6e08a94-13d4-585d-a048-d5051bfbc0d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186732667} {:answer/id #uuid "ff55953a-f64c-552f-a3af-17885ec4d300" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "- 2 \\sqrt{2}" :db/id #edb/ref 17592186732671}] :answer-field/correct {:db/id #edb/ref 17592186732661} :answer-field/id #uuid "0cbdb662-29c3-5f89-a20a-3845bb4929b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186732647}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1204e377-dc77-52