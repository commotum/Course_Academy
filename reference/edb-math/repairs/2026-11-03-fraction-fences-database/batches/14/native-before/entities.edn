c}{\\left(10 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|10 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0126e7ef-2ec7-5d7f-a8d7-582407009616" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7 \\operatorname{arcsec}{\\left(4 x \\right)}+C" :db/id #edb/ref 17592186676874} {:answer/id #uuid "26615563-e530-5544-b9f7-a24d5d7c3520" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7 \\operatorname{arcsec}{\\left(4 x \\right)}}{16}+C" :db/id #edb/ref 17592186676898} {:answer/id #uuid "87ac9755-9f76-571a-b175-02e2902b7b30" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "28 \\operatorname{arcsec}{\\left(4 x \\right)}+C" :db/id #edb/ref 17592186676962} {:answer/id #uuid "90251f4c-b8bc-5104-8144-8db40d11f9fe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "7 \\operatorname{arcsec}{\\left(16 x \\right)}+C" :db/id #edb/ref 17592186676966} {:answer/id #uuid "b18c1e92-4fd6-59c3-8c51-39c8501f69d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7 \\operatorname{arcsec}{\\left(4 x \\right)}}{4}+C" :db/id #edb/ref 17592186676989}] :answer-field/correct {:db/id #edb/ref 17592186676874} :answer-field/id #uuid "3e68b545-b7d2-58c5-8c66-984cc938eb0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676916}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9b337ff1-b6e2-5702-be8d-d982b1477cdc" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{7}{|x|\\sqrt{16 x^{2} - 1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=4 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=4,\\qquad \\mathrm{d}x=(\\frac{1}{4})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|4 x|=4|x|,\\qquad \\frac{1}{|x|}=\\frac{4}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{7}{|x|\\sqrt{16 x^{2} - 1}}\\,\\mathrm{d}x \\\\  &= 28\\int \\frac{1}{|4 x|\\sqrt{(4 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 28(\\frac{1}{4})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 7\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 7 \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= 7 \\operatorname{arcsec}{\\left(4 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|4 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e651b5-5ee7-5e53-9e60-c92338128ff0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(7 x \\right)}}{6}+C" :db/id #edb/ref 17592186676919} {:answer/id #uuid "5c828979-a664-5348-8e96-bb972e22d4d4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(7 x \\right)}}{42}+C" :db/id #edb/ref 17592186676935} {:answer/id #uuid "7be11b07-f96b-5a92-bd34-ccb6ddcb37ed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7 \\operatorname{arcsec}{\\left(7 x \\right)}}{6}+C" :db/id #edb/ref 17592186676952} {:answer/id #uuid "801ef18d-69aa-5378-b58a-91d4d3f3528c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(7 x \\right)}}{294}+C" :db/id #edb/ref 17592186676958} {:answer/id #uuid "f3049055-8ee7-5042-830b-a03fcd46e4c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(49 x \\right)}}{6}+C" :db/id #edb/ref 17592186677030}] :answer-field/correct {:db/id #edb/ref 17592186676919} :answer-field/id #uuid "9c355901-1679-5d66-ba00-1c7d5b2850b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676974}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a1e5824f-e979-5164-8706-b0c5bb4e54bf" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{6|x|\\sqrt{49 x^{2} - 1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=7 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=7,\\qquad \\mathrm{d}x=(\\frac{1}{7})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|7 x|=7|x|,\\qquad \\frac{1}{|x|}=\\frac{7}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{6|x|\\sqrt{49 x^{2} - 1}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{6}\\int \\frac{1}{|7 x|\\sqrt{(7 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= \\frac{7}{6}(\\frac{1}{7})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{6}\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arcsec}{\\left(u \\right)}}{6}+C \\\\  &= \\frac{\\operatorname{arcsec}{\\left(7 x \\right)}}{6}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|7 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0420b9b3-9028-5e27-bbba-45726475b49d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(6 x \\right)}+C" :db/id #edb/ref 17592186676877} {:answer/id #uuid "5c8f252f-19a7-51d6-bf28-81657f02c35f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6 \\operatorname{arcsec}{\\left(6 x \\right)}+C" :db/id #edb/ref 17592186676936} {:answer/id #uuid "5dce131d-6d