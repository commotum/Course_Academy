frac{9}{5}}{\\sqrt{36 - 7 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{10}\\int \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{7} x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{3}{10}(\\frac{6 \\sqrt{7}}{7})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{35}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(u \\right)}}{35}+C \\\\  &= \\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{35}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676643 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b6bdde3-325c-5745-872c-096f23978a80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\operatorname{arcsin}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676545} {:answer/id #uuid "5c3f3b47-ee74-5a13-8943-f93e8c5b433f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\operatorname{arcsin}{\\left(x \\right)}}{8}+C" :db/id #edb/ref 17592186676590} {:answer/id #uuid "5d33c97c-ce11-5e9e-837d-f5be1d9f54b6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\operatorname{arctan}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676592} {:answer/id #uuid "65e22a0e-845f-5a48-9bb3-ca1a76f9f8f1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24 \\operatorname{arcsin}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676597} {:answer/id #uuid "efcb1b34-754e-5763-8d6e-b7755fdc5e2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 \\operatorname{arcsin}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676692}] :answer-field/correct {:db/id #edb/ref 17592186676545} :answer-field/id #uuid "beb52e1f-9018-57f8-9c4e-4ba4b2465e07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676654}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "aeb4b559-27b4-5499-b515-6939cb760420" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{3}{\\sqrt{1 - 64 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{3}{\\sqrt{1 - 64 x^{2}}}\\,\\mathrm{d}x \\\\  &= 3\\int \\frac{1}{\\sqrt{1-(8 x)^{2}}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{1}{8})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{8}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\operatorname{arcsin}{\\left(u \\right)}}{8}+C \\\\  &= \\frac{3 \\operatorname{arcsin}{\\left(8 x \\right)}}{8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676650 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5c1395-3180-5893-89d4-0f9891c571e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\operatorname{arcsin}{\\left(\\frac{x}{2} \\right)}}{5}+C" :db/id #edb/ref 17592186676593} {:answer/id #uuid "941ef9f9-6159-51e1-a7dc-d50c626d0558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\operatorname{arcsin}{\\left(\\frac{x}{2} \\right)}}{5}+C" :db/id #edb/ref 17592186676622} {:answer/id #uuid "aa1b0bcb-60f1-50c6-b296-5783cec35c57" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arcsin}{\\left(x \\right)}}{5}+C" :db/id #edb/ref 17592186676641} {:answer/id #uuid "c74cc787-2dd0-5b0e-96b7-74518b5f3d84" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arctan}{\\left(\\frac{x}{2} \\right)}}{5}+C" :db/id #edb/ref 17592186676659} {:answer/id #uuid "c8411b89-dd93-5132-9a1f-978d794477bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arcsin}{\