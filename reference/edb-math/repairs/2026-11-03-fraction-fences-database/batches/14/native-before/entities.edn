/id #edb/ref 17592186045498} :answer/value "20 \\operatorname{arctan}{\\left(5 x \\right)}+C" :db/id #edb/ref 17592186676747} {:answer/id #uuid "4dbf7579-c4a6-5e84-b316-e43a2c06c6d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\operatorname{arcsin}{\\left(5 x \\right)}}{5}+C" :db/id #edb/ref 17592186676757} {:answer/id #uuid "c066d068-8f0f-5b8f-9079-684135eeaaa4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\operatorname{arctan}{\\left(5 x \\right)}+C" :db/id #edb/ref 17592186676827} {:answer/id #uuid "ccab861f-97b1-5360-bb18-335589f6b68d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(x \\right)}}{5}+C" :db/id #edb/ref 17592186676835} {:answer/id #uuid "d81917ec-2137-583b-8e2a-6dba3b1cbb65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(5 x \\right)}}{5}+C" :db/id #edb/ref 17592186676841}] :answer-field/correct {:db/id #edb/ref 17592186676841} :answer-field/id #uuid "b0d76d60-375d-5a12-b771-5d768e620be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676817}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ef7b058e-fc6a-5813-9eb1-d41bf53d2867" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{4}{25 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=5 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=5,\\qquad \\mathrm{d}x=(\\frac{1}{5})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{25 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 4\\int \\frac{1}{1+(5 x)^{2}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{1}{5})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4}{5}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\operatorname{arctan}{\\left(u \\right)}}{5}+C \\\\  &= \\frac{4 \\operatorname{arctan}{\\left(5 x \\right)}}{5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1354a5c6-4986-51a0-a180-095d77f61a88" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(x \\right)}}{7}+C" :db/id #edb/ref 17592186676718} {:answer/id #uuid "522f0b49-36d3-5564-8587-88f69e0b4972" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arcsin}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676760} {:answer/id #uuid "6e79f9b7-9587-51cb-9715-6d0667bfbe94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}}{7}+C" :db/id #edb/ref 17592186676780} {:answer/id #uuid "73505e5a-61de-522f-98f5-f372a4aff84d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}+C" :db/id #edb/ref 17592186676782} {:answer/id #uuid "87246861-a0f8-5866-8f47-f2e094fd4e05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}+C" :db/id #edb/ref 17592186676793}] :answer-field/correct {:db/id #edb/ref 17592186676780} :answer-field/id #uuid "6c913ac6-a686-52ea-8fea-4ea5396bf730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676777}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f49dc8f2-18d9-5ea1-864b-63e28786f067" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{4}{7 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=\\sqrt{7} x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\sqrt{7},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{7 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 4\\int \\frac{1}{1+(\\sqrt{7} x)^{2}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{\\sqrt{7}}{7})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{7}}{7}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{4 \\sqrt{7} \\operatorname{arctan}{\\left(\\sqrt{7} x \\right)}}{7}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ad1890-2cae-51ec-85ca-7aff39f86cd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{2}+C" :db/id #edb/ref 17592186676711} {:answer/id #uuid "3fb86f00-a7d3-5e1c-ab6a-eef0c1e19200" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{4}+C" :db/id #edb/ref 17592186676752} {:answer/id #uuid "9c11befe-819f-5bde-9b9b-0a8eae816193" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arctan}{\\left(2 x \\right)}+C" :db/id #edb/ref 17592186676801} {:answer/id #uuid "cbbee414-a342-56e0-8aec-8562cf05d4ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}{\\left(2 x \\right)}}{4}+C" :db/id #edb/ref 17592186676834} {:answer/id #uuid "e809e901-278c-58b4-87b5-87d3488d051b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}{\\left(x \\right)}}{4}+C" :db/id #edb/ref 17592186676856}] :answer-field/correct {:db/id #edb/ref 17592186676752} :answer-field/id #uuid "e55d26c5-0fc0-52a8-8e03-1e3787dd3fa8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676853}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f85c1197-a16c-562c-8e6f-5ec36344ebe3" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{8 x^{2} + 2}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n8 x^{2} + 2=2(1+(4)x^{2})\n$$\n\nUse the linear substitution $u=2 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=2,\\qquad \\mathrm{d}x=(\\frac{1}{2})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{8 x^{2} + 2}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int \\frac{1}{1+(2 x)^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{1}{2})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{4}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arctan}{\\left(u \\right)}}{4}+C \\\\  &= \\frac{\\operatorname{arctan}{\\left(2 x \\right)}}{4}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676884 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093e8ee9-6706-5ac0-9856-c97b4df6f556" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9 \\operatorname{arcsec}{\\left(9 x \\right)}+C" :db/id #edb/ref 17592186676879} {:answer/id #uuid "2d562848-1d97-52e5-9683-cb014d13bdb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(9 x \\right)}+C" :db/id #edb/ref 17592186676903} {:answer/id #uuid "520052f9-511f-5463-abd6-61c01b26c6c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(81 x \\right)}+C" :db/id #edb/ref 17592186676927} {:answer/id #uuid "7616d1f3-8012-52d1-b910-e3117af611f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(9 x \\right)}}{9}+C" :db/id #edb/ref 17592186676948} {:answer/id #uuid "f781316b-ad0d-5599-b0d1-a715216cc7e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(9 x \\right)}}{81}+C" :db/id #edb/ref 17592186677032}] :answer-field/correct {:db/id #edb/ref 17592186676903} :answer-field/id #uuid "60467e61-e7b2-548a-a8c4-112122fa9c9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676938}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1330265e-12c1-57f0-82dd-95378d9f20b0" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{9}{|9 x|\\sqrt{(9 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=9 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=9,\\qquad \\mathrm{d}x=(\\frac{1}{9})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|9 x|=9|x|,\\qquad \\frac{1}{|x|}=\\frac{9}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{9}{|9 x|\\sqrt{(9 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 9\\int \\frac{1}{|9 x|\\sqrt{(9 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 9(\\frac{1}{9})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= \\operatorname{arcsec}{\\left(9 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|9 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676889 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20bf9841-2595-5f27-b0e8-1e9284708c28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(x \\right)}}{8}+C" :db/id #edb/ref 17592186676896} {:answer/id #uuid "6e42acbb-4f56-56be-a048-fba84c7dc573" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676942} {:answer/id #uuid "7e019ca5-2476-5cb5-892a-c3f42ebb26e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676954} {:answer/id #uuid "b68e91f4-197a-5d0d-9aa6-776bde1a3333" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{64}+C" :db/id #edb/ref 17592186676990} {:answer/id #uuid "f2f477b1-1575-5b4e-ba38-698f5d0ef3a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186677029}] :answer-field/correct {:db/id #edb/ref 17592186676954} :answer-field/id #uuid "f8007ccb-32ea-5c4e-8b8c-8bb848c4c191" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186677033}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "184d3205-f072-5ec2-ae47-f41ae45b3346" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{|8 x|\\sqrt{(8 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|8 x|=8|x|,\\qquad \\frac{1}{|x|}=\\frac{8}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{|8 x|\\sqrt{(8 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 1\\int \\frac{1}{|8 x|\\sqrt{(8 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 1(\\frac{1}{8})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{1}{8}\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\frac{\\operatorname{arcsec}{\\left(u \\right)}}{8}+C \\\\  &= \\frac{\\operatorname{arcsec}{\\left(8 x \\right)}}{8}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|8 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676900 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49ebbcc4-6039-5bf0-998a-dded9c3941e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(14 x \\right)}}{14}+C" :db/id #edb/ref 17592186676922} {:answer/id #uuid "74cae605-ea8d-5ca5-8033-c10411a836ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(14 x \\right)}}{196}+C" :db/id #edb/ref 17592186676946} {:answer/id #uuid "ab2399d7-22bf-5740-880c-727575b60c80" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(14 x \\right)}+C" :db/id #edb/ref 17592186676984} {:answer/id #uuid "c7a55cec-6a4f-5cd8-bd20-ddc037f3250e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(196 x \\right)}+C" :db/id #edb/ref 17592186677007} {:answer/id #uuid "eed14417-4f9a-5aae-9ec6-27bba65a8975" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14 \\operatorname{arcsec}{\\left(14 x \\right)}+C" :db/id #edb/ref 17592186677026}] :answer-field/correct {:db/id #edb/ref 17592186676984} :answer-field/id #uuid "3494f9ef-9b8c-50b2-931e-8e49eba77f3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676910}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "2c86da1f-3334-519e-bd8d-02dc5abc2552" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{14}{|14 x|\\sqrt{(14 x)^{2}-1}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=14 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=14,\\qquad \\mathrm{d}x=(\\frac{1}{14})\\,\\mathrm{d}u.\n$$\n\nThe substitution factor is positive, so the absolute values satisfy\n\n$$\n|u|=|14 x|=14|x|,\\qquad \\frac{1}{|x|}=\\frac{14}{|u|}.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u=\\operatorname{arcsec}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{14}{|14 x|\\sqrt{(14 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 14\\int \\frac{1}{|14 x|\\sqrt{(14 x)^{2}-1}}\\,\\mathrm{d}x \\\\  &= 14(\\frac{1}{14})\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{|u|\\sqrt{u^{2}-1}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arcsec}{\\left(u \\right)}+C \\\\  &= \\operatorname{arcsec}{\\left(14 x \\right)}+C\\end{aligned}\n$$\n\nThis antiderivative applies on either interval where $|14 x|>1$; the constant may differ between those intervals."} {:db/id #edb/ref 17592186676901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e0be1ee-1432-52ae-9e94-69b713d648c2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec}{\\left(121 x \\right)}+C" :db/id #edb/ref 17592186676880} {:answer/id #uuid "59b25816-1279-51cb-af04-13bca7bd5f42" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(11 x \\right)}}{121}+C" :db/id #edb/ref 17592186676933} {:answer/id #uuid "626ff4e1-3b58-58c9-bc95-9f3d5bc3fad9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11 \\operatorname{arcsec}{\\left(11 x \\right)}+C" :db/id #edb/ref 17592186676939} {:answer/id #uuid "b8d7fe7e-90a9-577a-92c4-5851d113ae44" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsec}{\\left(11 x \\right)}}{11}+C" :db/id #edb/ref 17592186676992} {:answer/id #uuid "f8e06bf5-bdcb-53e3-9ea8-e3b48ff07198"