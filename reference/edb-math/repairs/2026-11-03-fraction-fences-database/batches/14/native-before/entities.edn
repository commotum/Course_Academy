m{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{\\sqrt{1 - 7 x^{2}}}\\,\\mathrm{d}x \\\\  &= 4\\int \\frac{1}{\\sqrt{1-(\\sqrt{7} x)^{2}}}\\,\\mathrm{d}x \\\\  &= 4(\\frac{\\sqrt{7}}{7})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{7}}{7}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{7} \\operatorname{arcsin}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{4 \\sqrt{7} \\operatorname{arcsin}{\\left(\\sqrt{7} x \\right)}}{7}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676700 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e32e157-a2bb-5778-9bc8-d1fe7100758f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}+C" :db/id #edb/ref 17592186676571} {:answer/id #uuid "478c075e-3783-5295-a021-8a3fa767a838" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{x}{9} \\right)}}{81}+C" :db/id #edb/ref 17592186676575} {:answer/id #uuid "617c497a-66af-5f65-8666-45f2e132805d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}{\\left(x \\right)}+C" :db/id #edb/ref 17592186676594} {:answer/id #uuid "d0d4aeaf-ef1e-5aa7-86c5-21d357f6e0bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}{\\left(\\frac{x}{9} \\right)}+C" :db/id #edb/ref 17592186676666} {:answer/id #uuid "e1e2064c-c04d-51df-9f6c-3cfbbe08e677" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{x}{9} \\right)}}{9}+C" :db/id #edb/ref 17592186676680}] :answer-field/correct {:db/id #edb/ref 17592186676666} :answer-field/id #uuid "8006da17-ecb9-5a36-aad0-18d773b11dd1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676612}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "fbda043b-7d01-51c0-ac35-cea779e23de9" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{\\sqrt{81 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{81 - x^{2}}=\\sqrt{81(1-(\\frac{1}{81})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{9},\\qquad \\mathrm{d}x=(9)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{\\sqrt{81 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{9}\\int \\frac{1}{\\sqrt{1-(\\frac{x}{9})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{9}(9)\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 1\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\operatorname{arcsin}{\\left(u \\right)}+C \\\\  &= \\operatorname{arcsin}{\\left(\\frac{x}{9} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676705 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04213b8c-a4f5-5d3a-9b15-2026b2773f38" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arcsin}{\\left(\\frac{x}{9} \\right)}}{9}+C" :db/id #edb/ref 17592186676706} {:answer/id #uuid "24ff35a2-12cf-5cee-878e-d0b766426a14" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}}{729}+C" :db/id #edb/ref 17592186676730} {:answer/id #uuid "2b636129-5f39-51a3-84e5-2abd974c2009" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arctan}{\\left(x \\right)}}{9}+C" :db/id #edb/ref 17592186676734} {:answer/id #uuid "771066be-5b08-556f-82d9-049a0d3f3ddc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}}{81}+C" :db/id #edb/ref 17592186676783} {:answer/id #uuid "d8bc0d3a-5228-5caf-9e16-ef5c59b3a33b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8 \\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}}{9}+C" :db/id #edb/ref 17592186676842}] :answer-field/correct {:db/id #edb/ref 17592186676842} :answer-field/id #uuid "33c84b16-473c-5bf4-9598-3a717f823644" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676746}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0328f6eb-ab94-54f1-a3fa-9db716e7cc30" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{8}{x^{2} + 81}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\nx^{2} + 81=81(1+(\\frac{1}{81})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{x}{9}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{9},\\qquad \\mathrm{d}x=(9)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{8}{x^{2} + 81}\\,\\mathrm{d}x \\\\  &= \\frac{8}{81}\\int \\frac{1}{1+(\\frac{x}{9})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{8}{81}(9)\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{8}{9}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{8 \\operatorname{arctan}{\\left(u \\right)}}{9}+C \\\\  &= \\frac{8 \\operatorname{arctan}{\\left(\\frac{x}{9} \\right)}}{9}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676713 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63e93ad6-e0d0-5c38-a11b-a59fd1a7feb3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\operatorname{arctan}{\\left(x \\right)}}{21}+C" :db/