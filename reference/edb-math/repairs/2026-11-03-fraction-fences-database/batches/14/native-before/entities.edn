{d}u \\\\  &= \\frac{2}{21}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\operatorname{arctan}{\\left(u \\right)}}{21}+C \\\\  &= \\frac{2 \\operatorname{arctan}{\\left(6 x \\right)}}{21}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676733 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1396f0ef-e9ef-5af5-a333-a4d0c5e73f64" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3 \\operatorname{arctan}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676719} {:answer/id #uuid "1edc6b38-1c31-5835-92d0-b46e9fbae931" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\operatorname{arctan}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676725} {:answer/id #uuid "8a786436-9219-596e-a6f7-b41b5ab5f943" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\operatorname{arctan}{\\left(x \\right)}}{8}+C" :db/id #edb/ref 17592186676797} {:answer/id #uuid "8c4e8c8b-124e-5303-bdb6-3adc03547b5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "24 \\operatorname{arctan}{\\left(8 x \\right)}+C" :db/id #edb/ref 17592186676798} {:answer/id #uuid "be1fd41f-de13-59ad-adea-a77d1673b296" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3 \\operatorname{arcsin}{\\left(8 x \\right)}}{8}+C" :db/id #edb/ref 17592186676823}] :answer-field/correct {:db/id #edb/ref 17592186676725} :answer-field/id #uuid "bff92d75-29b5-505e-9429-a2ff32acf0cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676825}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "29b02aca-6052-5e7a-87ee-eeebee2626d4" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{3}{64 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=8 x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=8,\\qquad \\mathrm{d}x=(\\frac{1}{8})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{3}{64 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 3\\int \\frac{1}{1+(8 x)^{2}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{1}{8})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{3}{8}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{3 \\operatorname{arctan}{\\left(u \\right)}}{8}+C \\\\  &= \\frac{3 \\operatorname{arctan}{\\left(8 x \\right)}}{8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676738 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ef8c30d-fd49-5779-9e5d-c7dd5a32f59e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{2} \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{343}+C" :db/id #edb/ref 17592186676740} {:answer/id #uuid "42157c23-e7cf-53d6-a1f4-7ab4e415c97d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{49}+C" :db/id #edb/ref 17592186676753} {:answer/id #uuid "47b39529-65b9-5548-844f-982292e23a7e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{2} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{7}+C" :db/id #edb/ref 17592186676754} {:answer/id #uuid "8696acc0-a3e5-5d84-91ff-758690518877" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{2} \\operatorname{arctan}{\\left(x \\right)}}{7}+C" :db/id #edb/ref 17592186676792} {:answer/id #uuid "f2bacbd4-300f-5c95-9a1b-adb46900035f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2 \\sqrt{2} \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{7}+C" :db/id #edb/ref 17592186676866}] :answer-field/correct {:db/id #edb/ref 17592186676866} :answer-field/id #uuid "89dc5d2d-8f9e-5319-aac2-fdf6c46997c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676796}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2dc8364c-3b6b-5d4f-a269-88d33ebce849" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{4}{2 x^{2} + 49}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n2 x^{2} + 49=49(1+(\\frac{2}{49})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{2} x}{7}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{2}}{7},\\qquad \\mathrm{d}x=(\\frac{7 \\sqrt{2}}{2})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{4}{2 x^{2} + 49}\\,\\mathrm{d}x \\\\  &= \\frac{4}{49}\\int \\frac{1}{1+(\\frac{\\sqrt{2} x}{7})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{4}{49}(\\frac{7 \\sqrt{2}}{2})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{2}}{7}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{2 \\sqrt{2} \\operatorname{arctan}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{2 \\sqrt{2} \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{7} \\right)}}{7}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676761 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ac2c4b5-4376-5a26-82cd-28b6e5fef581" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\sqrt{3} \\operatorname{arctan}{\\left(\\sqrt{3} x \\right)}+C" :db/id #edb/ref 17592186676765} {:answer/id #uuid "a09fdd28-10ed-5146-a8c9-c78e47e3a98d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{3} \\operatorname{arcsin}{\\left(\\sqrt{3} x \\right)}}{3}+C" :db/id #edb/ref 17592186676805} {:answer/id #uuid "a7abed00-599b-52be-a273-794e20b361cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4 \\operatorname{arctan}{\\left(\\sqrt{3} x \\right)}+C