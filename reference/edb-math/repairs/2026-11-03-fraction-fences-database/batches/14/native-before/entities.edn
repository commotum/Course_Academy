{7} x}{3} \\right)}+C" :db/id #edb/ref 17592186676626} {:answer/id #uuid "a4b55f5c-24ff-5bef-83f9-11bd528fee90" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{3} \\right)}}{7}+C" :db/id #edb/ref 17592186676633} {:answer/id #uuid "fb6c7d4b-a0dd-5017-9269-39c7f5e82f17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(x \\right)}}{7}+C" :db/id #edb/ref 17592186676698} {:answer/id #uuid "fcc4f02a-f8e8-5417-a314-b47a273aa821" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{3} \\right)}+C" :db/id #edb/ref 17592186676702}] :answer-field/correct {:db/id #edb/ref 17592186676633} :answer-field/id #uuid "6669c3de-2402-5ecc-b193-85ab401d4cad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676598}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c3725f6e-6465-5347-b4c3-9fbe02106733" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{9}{\\sqrt{9 - 7 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{9 - 7 x^{2}}=\\sqrt{9(1-(\\frac{7}{9})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{7} x}{3}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{7}}{3},\\qquad \\mathrm{d}x=(\\frac{3 \\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{9}{\\sqrt{9 - 7 x^{2}}}\\,\\mathrm{d}x \\\\  &= 3\\int \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{7} x}{3})^{2}}}\\,\\mathrm{d}x \\\\  &= 3(\\frac{3 \\sqrt{7}}{7})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7}}{7}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(u \\right)}}{7}+C \\\\  &= \\frac{9 \\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{3} \\right)}}{7}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676657 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fbe9b1d-f277-5dc4-b54d-ce84ab329d1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2} \\operatorname{arcsin}{\\left(x \\right)}}{2}+C" :db/id #edb/ref 17592186676555} {:answer/id #uuid "39fb2c59-5643-5a74-9272-aca623e70e85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{2} \\right)}}{2}+C" :db/id #edb/ref 17592186676568} {:answer/id #uuid "4061e863-62d3-504f-b147-21643eb671b3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2} \\operatorname{arctan}{\\left(\\frac{\\sqrt{2} x}{2} \\right)}}{2}+C" :db/id #edb/ref 17592186676572} {:answer/id #uuid "8d912bed-0479-5a8d-92b1-ddea3ed41c6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{2} \\right)}}{4}+C" :db/id #edb/ref 17592186676619} {:answer/id #uuid "b002eeca-bc61-5614-b62b-8eec96416915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{2} \\right)}}{2}+C" :db/id #edb/ref 17592186676646}] :answer-field/correct {:db/id #edb/ref 17592186676646} :answer-field/id #uuid "d8e1c793-b298-5ef3-8a3d-aeb9c648f8f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676672}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c401b599-aeb3-532e-ad3b-4af24ac3d788" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{1}{\\sqrt{4 - 2 x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{4 - 2 x^{2}}=\\sqrt{4(1-(\\frac{1}{2})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{2} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{2}}{2},\\qquad \\mathrm{d}x=(\\sqrt{2})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{1}{\\sqrt{4 - 2 x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int \\frac{1}{\\sqrt{1-(\\frac{\\sqrt{2} x}{2})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\sqrt{2})\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{2}}{2}\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{2} \\operatorname{arcsin}{\\left(u \\right)}}{2}+C \\\\  &= \\frac{\\sqrt{2} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{2} x}{2} \\right)}}{2}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676664 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045c4ed0-9a0a-5238-a1ce-5fc55821d32a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{x}{6} \\right)}}{3}+C" :db/id #edb/ref 17592186676539} {:answer/id #uuid "06aa1893-7344-5203-8272-5774651e1595" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\operatorname{arcsin}{\\left(x \\right)}+C" :db/id #edb/ref 17592186676541} {:answer/id #uuid "4062997c-00f3-54d8-86c9-2088252c6427" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}{\\left(\\frac{x}{6} \\right)}}{18}+C" :db/id #edb/ref 17592186676573} {:answer/id #uuid "a90839e2-0213-5afb-ae3e-1ddd2a32b599" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\operatorname{arctan}{\\left(\\frac{x}{6} \\right)}+C" :db/id #edb/ref 17592186676640} {:answer/id #uuid "e2b2290d-4132-52c9-ab25-6554b73deb8a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2 \\operatorname{arcsin}{\\left(\\frac{x}{6} \\right)}+C" :db/id #edb/ref 17592186676681}] :answer-field/correct {:db/id #edb/ref 17592186676681} :answer-field/id #uuid "e75c4dd2-8d4a-5406-8e98-9ad1ab0f5124" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676684}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "cc91b79d-2e80-5826-ab2d-40a1036ba80b" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{2}{\\sqrt{36 - x^{2}}}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n\\sqrt{36 - x^{2}}=\\sqrt{36(1-(\\frac{1}{36})x^{2})}\n$$\n\nUse the linear substitution $u=\\frac{x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{1}{6},\\qquad \\mathrm{d}x=(6)\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u=\\operatorname{arcsin}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{2}{\\sqrt{36 - x^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(\\frac{x}{6})^{2}}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{3}(6)\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2\\int \\frac{1}{\\sqrt{1-u^{2}}}\\,\\mathrm{d}u \\\\  &= 2 \\operatorname{arcsin}{\\left(u \\right)}+C \\\\  &= 2 \\operatorname{arcsin}{\\left(\\frac{x}{6} \\right)}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676665 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "691332c9-dfd1-51e4-a111-41b0aa45d969" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{9 \\operatorname{arcsin}{\\left(2 x \\right)}}{2}+C" :db/id #edb/ref 17592186676601} {:answer/id #uuid "c8375ac6-3c5b-5845-a3f6-a15c693c3a45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18 \\operatorname{arcsin}{\\left(2 x \\right)}+C" :db/id #