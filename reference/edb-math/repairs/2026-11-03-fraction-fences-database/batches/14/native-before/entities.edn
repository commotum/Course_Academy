 \\operatorname{arctan}{\\left(u \\right)}}{35}+C \\\\  &= \\frac{6 \\operatorname{arctan}{\\left(7 x \\right)}}{35}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "320d9c8f-5a9c-54a3-8244-a7f509bddcdd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{7} \\operatorname{arctan}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{216}+C" :db/id #edb/ref 17592186676744} {:answer/id #uuid "611bf0ea-6eae-501a-aac7-6c59d056db52" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{7} \\operatorname{arcsin}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{42}+C" :db/id #edb/ref 17592186676767} {:answer/id #uuid "79d6305f-5afc-5a35-bb87-98d6dc9d7707" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{7} \\operatorname{arctan}{\\left(x \\right)}}{42}+C" :db/id #edb/ref 17592186676785} {:answer/id #uuid "91023144-4d51-5538-a368-feb111219811" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\sqrt{7} \\operatorname{arctan}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{42}+C" :db/id #edb/ref 17592186676800} {:answer/id #uuid "d777ad93-d0ad-5c26-9c7f-2358124a9722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5 \\operatorname{arctan}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{36}+C" :db/id #edb/ref 17592186676840}] :answer-field/correct {:db/id #edb/ref 17592186676800} :answer-field/id #uuid "6bbb539e-e5b6-53e7-8999-f4fb189180c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676776}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e89cba94-0b9c-53a6-bd8e-752f93d9ffc2" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{5}{7 x^{2} + 36}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "First factor the constant in the denominator:\n\n$$\n7 x^{2} + 36=36(1+(\\frac{7}{36})x^{2})\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{7} x}{6}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{7}}{6},\\qquad \\mathrm{d}x=(\\frac{6 \\sqrt{7}}{7})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{5}{7 x^{2} + 36}\\,\\mathrm{d}x \\\\  &= \\frac{5}{36}\\int \\frac{1}{1+(\\frac{\\sqrt{7} x}{6})^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{5}{36}(\\frac{6 \\sqrt{7}}{7})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{5 \\sqrt{7}}{42}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{5 \\sqrt{7} \\operatorname{arctan}{\\left(u \\right)}}{42}+C \\\\  &= \\frac{5 \\sqrt{7} \\operatorname{arctan}{\\left(\\frac{\\sqrt{7} x}{6} \\right)}}{42}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10370922-a81e-5c1d-90ed-592688a39e00" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arctan}{\\left(x \\right)}}{5}+C" :db/id #edb/ref 17592186676717} {:answer/id #uuid "2c282b7e-5b06-5e40-b967-3f76ee982529" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8 \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}+C" :db/id #edb/ref 17592186676735} {:answer/id #uuid "48de8ff9-8f2a-51fc-9817-bd73df8d0c95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arcsin}{\\left(\\sqrt{10} x \\right)}}{5}+C" :db/id #edb/ref 17592186676755} {:answer/id #uuid "c50902df-30da-580b-9820-7cbc7b16912a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8 \\sqrt{10} \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}+C" :db/id #edb/ref 17592186676830} {:answer/id #uuid "dd006627-a0f0-52de-9ea1-8fc081e7df81" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4 \\sqrt{10} \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}}{5}+C" :db/id #edb/ref 17592186676848}] :answer-field/correct {:db/id #edb/ref 17592186676848} :answer-field/id #uuid "aca6f980-732b-5fcd-80e8-f202607f065d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186676811}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ec536a71-42ec-5ebc-9d40-b2754ac5878c" :question/problem "Evaluate the integral. Give an exact answer.\n\n$$\n\\int \\frac{8}{10 x^{2} + 1}\\,\\mathrm{d}x\n$$" :question/retired true :question/worked-solution "Use the linear substitution $u=\\sqrt{10} x.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\sqrt{10},\\qquad \\mathrm{d}x=(\\frac{\\sqrt{10}}{10})\\,\\mathrm{d}u.\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int \\frac{8}{10 x^{2} + 1}\\,\\mathrm{d}x \\\\  &= 8\\int \\frac{1}{1+(\\sqrt{10} x)^{2}}\\,\\mathrm{d}x \\\\  &= 8(\\frac{\\sqrt{10}}{10})\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10}}{5}\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{4 \\sqrt{10} \\operatorname{arctan}{\\left(u \\right)}}{5}+C \\\\  &= \\frac{4 \\sqrt{10} \\operatorname{arctan}{\\left(\\sqrt{10} x \\right)}}{5}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186676862 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "831c689c-2da1-5ad0-b643-c20f35616ef1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{7} \\right)}}{49}+C" :db/id #edb/ref 17592186676787} {:answer/id #uuid "883afc43-bee6-57e6-87e8-344f08fc7903" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arctan}{\\left(\\frac{x}{7} \\right)}}{7}+C" :db/id #edb/ref 17592186676794} {:answer/id #uuid "a7d75d86-11bf-5b13-b8d5-ede4fcf2dbd7" :answer/type {:db/id #edb/ref 175921