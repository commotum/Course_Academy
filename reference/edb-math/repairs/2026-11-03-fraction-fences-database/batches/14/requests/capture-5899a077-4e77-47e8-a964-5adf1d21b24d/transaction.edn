}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}(\\frac{\\sqrt{6}}{3})\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}[\\operatorname{arctan}{\\left(u \\right)}]_{- \\frac{\\sqrt{3}}{3}}^{1} \\\\  &= \\frac{\\sqrt{6}}{6}(\\operatorname{arctan}(1)-\\operatorname{arctan}(- \\frac{\\sqrt{3}}{3})) \\\\  &= \\frac{\\sqrt{6}}{6}((\\frac{\\pi}{4})-(- \\frac{\\pi}{6})) \\\\  &= \\frac{5 \\sqrt{6} \\pi}{72}\\end{aligned}\n$$" "First factor the constant in the denominator:\n\n$$\n6 x^{2} + 4=4\\left(1+\\left(\\frac{3}{2}\\right)x^{2}\\right)\n$$\n\nUse the linear substitution $u=\\frac{\\sqrt{6} x}{2}.$ Then\n\n$$\n\\frac{\\mathrm{d}u}{\\mathrm{d}x}=\\frac{\\sqrt{6}}{2},\\qquad \\mathrm{d}x=\\left(\\frac{\\sqrt{6}}{3}\\right)\\,\\mathrm{d}u.\n$$\n\nChange both bounds using the same substitution:\n\n$$\n\\begin{aligned}x=- \\frac{\\sqrt{2}}{3}&\\Longrightarrow u=\\left(\\frac{\\sqrt{6}}{2}\\right)\\left(- \\frac{\\sqrt{2}}{3}\\right)=- \\frac{\\sqrt{3}}{3} \\\\ x=\\frac{\\sqrt{6}}{3}&\\Longrightarrow u=\\left(\\frac{\\sqrt{6}}{2}\\right)\\left(\\frac{\\sqrt{6}}{3}\\right)=1\\end{aligned}\n$$\n\nApply the basic inverse-trigonometric integral:\n\n$$\n\\int \\frac{1}{1+u^{2}}\\,\\mathrm{d}u=\\operatorname{arctan}{\\left(u \\right)}+C.\n$$\n\nSubstitute and evaluate:\n\n$$\n\\begin{aligned}& \\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{2}{6 x^{2} + 4}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\int_{- \\frac{\\sqrt{2}}{3}}^{\\frac{\\sqrt{6}}{3}} \\frac{1}{1+\\left(\\frac{\\sqrt{6} x}{2}\\right)^{2}}\\,\\mathrm{d}x \\\\  &= \\frac{1}{2}\\left(\\frac{\\sqrt{6}}{3}\\right)\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}\\int_{- \\frac{\\sqrt{3}}{3}}^{1} \\frac{1}{1+u^{2}}\\,\\mathrm{d}u \\\\  &= \\frac{\\sqrt{6}}{6}[\\operatorname{arctan}{\\left(u \\right)}]_{- \\frac{\\sqrt{3}}{3}}^{1} \