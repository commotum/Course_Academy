a03a-2502b905ef6b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{2}}{4}+\\frac{1}{{x}^{3}}+C" :db/id #edb/ref 17592186249396} {:answer/id #uuid "e77f388d-8a73-59ce-8f66-bc9a394fa477" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{\\sqrt[3]{{x}^{4}}}+\\frac{{x}^{2}}{2}+\\frac{1}{x}+C" :db/id #edb/ref 17592186249466} {:answer/id #uuid "f18e54e2-bbf7-5c09-a529-02ac0e448d1b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{{x}^{3}}}{3}+4{x}^{4}+\\frac{x}{2}+C" :db/id #edb/ref 17592186249545} {:answer/id #uuid "f8f381b4-0b8f-5cfb-8192-5f7af284e5dd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt[3]{x}+\\frac{{x}^{4}}{4}-\\frac{x}{4}+C" :db/id #edb/ref 17592186249595}] :answer-field/correct {:db/id #edb/ref 17592186249171} :answer-field/id #uuid "bb1b4399-41fb-5b60-b839-8a80147e6a2e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249996}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "e132caee-594d-5f81-b6a1-2e2a44a2d5f6" :question/math-academy-id "q-113848" :question/problem "Find the antiderivative of \n$$\n\\displaystyle \\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}}.\n$$" :question/worked-solution "Using the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{1}{\\sqrt[3]{{x}^{4}}}+{x}^{3}-\\frac{1}{{x}^{2}})\\,\\text{d}x & =\\int {x}^{-4/3}\\,\\text{d}x+\\int {x}^{3}\\,\\text{d}x-\\int {x}^{-2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-4/3+1}}{(-\\frac{4}{3}+1)}+\\frac{{x}^{3+1}}{(3+1)}-\\frac{{x}^{-2+1}}{(-2+1)}+C \\\\  & =\\frac{{x}^{-1/3}}{\\left(-\\frac{1}{3}\\right)}+\\frac{{x}^{4}}{4}-\\frac{{x}^{-1}}{(-1)}+C \\\\  & =-\\frac{3}{\\sqrt[3]{x}}+\\frac{{x}^{4}}{4}+\\frac{1}{x}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba6a699-2c76-5939-bea3-f6ccf90418e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡\\left(\\frac{i}{n}\\right)\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186247526} {:answer/id #uuid "5dc3e8b1-ccac-5dd3-9d9d-d45e3aef78e8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(1+\\frac{i}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186248278} {:answer/id #uuid "6838abc3-6207-5c37-b5ce-bf7f1e4e278e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(2+\\frac{i}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186248361} {:answer/id #uuid "c2bee278-1a1b-5ed6-b379-90c3bef57aff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡\\left(\\frac{i}{n}\\right)\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186249155} {:answer/id #uuid "ff07c2f9-09be-56ca-84fa-00c7e6877d20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡\\left(\\frac{i}{n}\\right)\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186249655}] :answer-field/correct {:db/id #edb/ref 17592186249655} :answer-field/id #uuid "ab136974-ca49-55ae-a9ea-4c3e04770ab3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249975}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7115006d-07e5-5f15-ba88-d56671b9f015" :question/math-academy-id "q-113881" :question/problem "What is $$\n\\displaystyle {\\int }_{0}^{1}\\operatorname{arctan}⁡x\\,\\text{d}x\n$$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{1}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0,$ and the upper bound is $b=1.$ So, we have\n\n$$\nΔx=\\frac{1-0}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\operatorname{arctan}⁡x\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{1}{n})\\,\\cdot \\frac{1}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f\\left(\\frac{i}{n}\\right)\\cdot \\frac{1}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡\\left(\\frac{i}{n}\\right)\\cdot \\frac{1}{n}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250129 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "054d43cb-d637-5acf-ba8c-e957170e28fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n-1}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186247465} {:answer/id #uuid "0d68bdb3-37d6-567c-a5c7-49e43b6f2513" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n-1}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186247545} {:answer/id #uuid "bf3f8575-eadc-538e-bf1d-5ffd8ace6426" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186249122} {:answer/id #uuid "e5731a80-e5b5-5cb0-a9bf-0807924353a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186249445} {:answer/id #uuid "fb85a63c-400e-593e-bc73-1a7f7b612bd0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{5i/n}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186249614}] :answer-field/correct {:db/id #edb/ref 17592186249122} :answer-field/id #uuid "760a5e1b-de5d-5f17-aa82-85090115f907" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249872}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "35148af9-fe39-53be-bd54-85b1a5b3aea3" :question/math-academy-id "q-113884" :question/problem "What is $$\n\\displaystyle {\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x\n$$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x-1},$ the lower bound is $a=1,$ and the upper bound is $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{5}{e}^{x-1}\\,\\text{d}x & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+i\\cdot \\frac{4}{n})\\,\\cdot \\frac{4}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(1+\\frac{4i}{n})\\cdot \\frac{4}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{1+4i/n-1}\\cdot \\frac{4}{n}] \\\\  & =\\lim_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{4i/n}\\cdot \\frac{4}{n}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250137 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f22a0e-058f-5aea-817b-b5a693d075f5" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=\\operatorname{sin}⁡2x$ and $b=2$" :db/id #edb/ref 17592186247452} {:answer/id #uuid "65001ca1-edbf-595c-8d4a-824d38272a95" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=\\operatorname{sin}⁡x$ and $b=2$" :db/id #edb/ref 17592186248336} {:answer/id #uuid "75be311d-31c3-50ff-8ee6-ae45bf82787d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=\\operatorname{sin}⁡x$ and $b=1$" :db/id #edb/ref 17592186248460} {:answer/id #uuid "bf73c3b7-32d2-5089-bb1e-0f000f39bbb3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=\\operatorname{sin}⁡2x$ and $b=1$" :db/id #edb/ref 17592186249124} {:answer/id #uuid "c5bc191f-6851-5bc5-8b3c-5157cfe51827" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$f(x)=2\\operatorname{sin}⁡2x$ and $b=2$" :db/id #edb/ref 17592186249183}] :answer-field/correct {:db/id #edb/ref 17592186248336} :answer-field/id #uuid "c4f4ebbe-555b-5752-8041-923324c88dd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250007}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "4f080615-a4c5-5d2c-a5e1-27e9c5e2295d" :question/math-academy-id "q-113917" :question/problem "Find the function $f(x)$ and the value of $b,$ given that $$\n\\displaystyle {\\int }_{0}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[\\operatorname{sin}⁡\\left(\\frac{2k}{n}\\right)\\cdot \\frac{2}{n}].\n$$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=0.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{2}{n}.$ Therefore, \n\n$$\n\\frac{2}{n}=\\frac{b-0}{n}\\,⟹\\,b=2.\n$$\n\nConsequently,  ${x}_{k}=\\frac{2k}{n}$ and $f({x}_{k})=\\operatorname{sin}⁡{x}_{k}.$\n\nHence,\n\n$$\n{\\int }_{0}^{2}\\operatorname{sin}⁡x\\,\\text{d}x=\\lim_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[\\operatorname{sin}⁡\\left(\\frac{2k}{n}\\right)\\cdot \\frac{2}{n}].\n$$\n\nTherefore, the correct answer is $f(x)=\\operatorname{sin}⁡x$ and $b=2.$"} {:db/id #edb/ref 17592186250147 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455009c1-cd1b-5980-bebc-005c166aaab0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{47}{243}" :db/id #edb/ref 17592186248047} {:answer/id #uuid "896f555a-8df1-54e2-8351-8c2d255e5f6f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186248645} {:answer/id #uuid "af350e46-2ecb-56b8-977a-f33f11df9722" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{26}{27}" :db/id #edb/ref 17592186248994} {:answer/id #uuid "c7fb154d-0bb2-50c5-a991-8b8bf26ab955" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186249203} {:answer/id #uuid "e7b780a7-5d64-5db2-a401-0d776743ab54" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{81}" :db/id #edb/ref 17592186249470}] :answer-field/correct {:db/id #edb/ref 17592186248645} :answer-field/id #uuid "1c672aeb-3770-5ff7-9ee1-eb36a7e65af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249719}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e8ba6724-aa4a-53a8-8ea0-e040d768a286" :question/math-academy-id "q-113989" :question/problem "$$\n\\displaystyle {\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x=\n$$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x & =\\frac{{x}^{-4+1}}{(-4+1)}{|}_{-3}^{-1} \\\\  & =\\frac{{x}^{-3}}{(-3)}{|}_{-3}^{-1} \\\\  & =-\\frac{1}{3{x}^{3}}{|}_{-3}^{-1} \\\\  & =-(\\frac{1}{3(-1)^{3}}-\\frac{1}{3(-3)^{3}}) \\\\  & =-(-\\frac{1}{3}+\\frac{1}{81}) \\\\  & =-\\left(-\\frac{26}{81}\\right) \\\\  & =\\frac{26}{81}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250158 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19b38da3-5f2b-5083-b082-6baa6d33f014" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186247658} {:answer/id #uuid "812bcd0b-19c0-5f1f-bc5e-f010128ff079" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248565} {:answer/id #uuid "990243d0-e530-5c29-873f-06195a661663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{arcsin}⁡(5x)+C" :db/id #edb/ref 17592186248789} {:answer/id #uuid "9987c0f9-6105-5ebc-a015-774c178a4474" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsin}⁡\\left(\\frac{x}{5}\\right)+C" :db/id #edb/ref 17592186248793} {:answer/id #uuid "a00a5ad1-e697-5458-b48b-1b1317dfeb95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\operatorname{arcsin}⁡(x)}{5}+C" :db/id #edb/ref 17592186248850}] :answer-field/correct {:db/id #edb/ref 17592186248565} :answer-field/id #uuid "b9cd7cdb-bf34-5d1b-afd1-7a3df6dc3414" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249992}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "b2f614f9-7ab2-5976-a519-b4171e38a53c" :question/math-academy-id "q-114022" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{5}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{\\sqrt{1-25{x}^{2}}}\\,\\text{d}x & =5\\int \\frac{1}{\\sqrt{1-(5x)^{2}}}\\,\\text{d}x \\\\  & =5\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =5\\cdot \\frac{1}{5}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(5x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250159 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae94c5a-4c0e-5d18-8e16-ca2223f1d464" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247517} {:answer/id #uuid "8779f6eb-94c4-53a0-ab68-b0042bb9935b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248636} {:answer/id #uuid "8f996840-de58-519e-9ad5-b2271f08b943" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{36}\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248702} {:answer/id #uuid "a7a73405-8896-5d3b-959c-d98a3a0bf6d6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "36\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186248915} {:answer/id #uuid "dd1ebfa7-4b17-5af2-bcf2-93117f7bdcce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{6}\\operatorname{arcsin}⁡(6x)+C" :db/id #edb/ref 17592186249385}] :answer-field/correct {:db/id #edb/ref 17592186248702} :answer-field/id #uuid "d1111c22-992f-5424-8973-a294870d0e57" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250033}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "49cf1e17-5602-5d73-b695-bcf78c6bba28" :question/math-academy-id "q-114023" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{6\\sqrt{1-36{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $36{x}^{2}=(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{6\\sqrt{1-36{x}^{2}}}\\,\\text{d}x & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-(6x)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{6}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{36}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{36}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{36}\\operatorname{arcsin}⁡(6x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250160 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cd4706-704b-5191-9295-cd464731fc6a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247445} {:answer/id #uuid "3a38ccf5-fcac-5430-8dfa-c7d60a37aa2f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186247939} {:answer/id #uuid "4c9e9d8f-89aa-55a3-97cf-08796f3a38a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186248109} {:answer/id #uuid "8f55739b-0baf-52ac-867b-fcfbf2995448" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248699} {:answer/id #uuid "bff3e8f2-1813-5dfd-b250-2a81a2e1016b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249130}] :answer-field/correct {:db/id #edb/ref 17592186249130} :answer-field/id #uuid "66b8014f-e254-5931-890e-409b4231ae26" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249851}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "0f4bd8aa-6ac8-5557-b597-a73e9dcdaedc" :question/math-academy-id "q-114024" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{4}{\\sqrt{1-2{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $2{x}^{2}=(\\sqrt{2}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{\\sqrt{1-2{x}^{2}}}\\,\\text{d}x & =4\\int \\frac{1}{\\sqrt{1-(\\sqrt{2}x)^{2}}}\\,\\text{d}x \\\\  & =4\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\frac{4}{\\sqrt{2}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{4\\sqrt{2}}{2}\\operatorname{arcsin}⁡u+C \\\\  & =2\\sqrt{2}\\operatorname{arcsin}⁡(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250161 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c68f15c-76dd-5da9-8a8c-db134c0b26d5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{81}\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186247534} {:answer/id #uuid "2bcc6f85-a1b7-5000-88aa-4cd90bd376e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}\\operatorname{arcsin}⁡(x)+C" :db/id #edb/ref 17592186247814} {:answer/id #uuid "2d69f939-15a8-562a-9b01-f0a5d555430a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186247827} {:answer/id #uuid "5ba3d36c-1859-5507-bd58-e1969bafd63a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "81\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186248255} {:answer/id #uuid "cc5523a4-ec9b-5826-a4db-f3b2655b50e4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9\\operatorname{arcsin}⁡(9x)+C" :db/id #edb/ref 17592186249241}] :answer-field/correct {:db/id #edb/ref 17592186247534} :answer-field/id #uuid "b9607361-a0d1-5e53-8ce0-f961a918ae9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249991}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8d5a14b8-efd2-53f8-9736-e9a0e599835e" :question/math-academy-id "q-114025" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{9\\sqrt{1-81{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $81{x}^{2}=(9x)^{2}.$\n\nSo, let's substitute $u=9x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=9\\,⟹\\,\\text{d}x=\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{9\\sqrt{1-81{x}^{2}}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{\\sqrt{1-(9x)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{9}\\text{d}u) \\\\  & =\\frac{1}{81}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{1}{81}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{1}{81}\\operatorname{arcsin}⁡(9x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250163 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73c527d9-5fef-527b-944d-6452bf1f22ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186248439} {:answer/id #uuid "b49d7d3e-613f-5c56-842d-c0c3e5de4bcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{8}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249040} {:answer/id #uuid "bde79f17-dd2a-5f64-a9ae-c0fae23b5c8f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(3x)+C" :db/id #edb/ref 17592186249113} {:answer/id #uuid "dc9408cf-bf7c-5267-9022-0123e7766afe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249376} {:answer/id #uuid "ec0cf6c1-d063-5749-83ca-58271291edbe" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{8}\\operatorname{arcsin}⁡(3x)+C" :db/id #edb/ref 17592186249497}] :answer-field/correct {:db/id #edb/ref 17592186248439} :answer-field/id #uuid "aaa559e6-16f4-5c76-808e-c0ea0a5329cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249974}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "836b44bd-5d8f-5551-957e-758fcb5e8836" :question/math-academy-id "q-114027" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{8}{\\sqrt{1-3{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $3{x}^{2}=(\\sqrt{3}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{\\sqrt{1-3{x}^{2}}}\\,\\text{d}x & =\\int \\frac{8}{\\sqrt{1-(\\sqrt{3}x)^{2}}}\\,\\text{d}x \\\\  & =8\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{8}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{8\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250165 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2488cb64-1bbf-52da-a312-e3caf405d555" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247745} {:answer/id #uuid "38930a0c-015d-5696-ba08-428df9678156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247929} {:answer/id #uuid "3fe37be6-22eb-55e9-ba87-4d2f7527adbf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247991} {:answer/id #uuid "725143bf-9ac9-517a-9c80-3ca905fe3cce" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{x})+C" :db/id #edb/ref 17592186248422} {:answer/id #uuid "e6673b34-1ab8-57dc-8fcd-d06a4fb12faa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C" :db/id #edb/ref 17592186249454}] :answer-field/correct {:db/id #edb/ref 17592186247929} :answer-field/id #uuid "87006c2a-5518-5f50-8546-d7d44af9d5e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249905}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "4b8555c3-b26d-54b8-b47b-601c910c10ab" :question/math-academy-id "q-114032" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{3}{\\sqrt{1-3{x}^{2}}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $3{x}^{2}=(\\sqrt{3}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{\\sqrt{1-3{x}^{2}}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{1-(\\sqrt{3}x)^{2}}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{3}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{3\\sqrt{3}}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\sqrt{3}\\operatorname{arcsin}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250166 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b46bc9-97cb-5bce-918b-8b92646973b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arctan}⁡\\left(\\frac{x}{6}\\right)+C" :db/id #edb/ref 17592186247570} {:answer/id #uuid "1b1e75f2-49eb-5a5d-9cee-c6ed60930c7d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186247668} {:answer/id #uuid "3de5bd43-5bd8-5d01-8064-06ac8fdb185f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(x)+C" :db/id #edb/ref 17592186247970} {:answer/id #uuid "c07e9314-0212-563d-818b-d17717a081be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡\\left(\\frac{x}{6}\\right)+C" :db/id #edb/ref 17592186249137} {:answer/id #uuid "c7202512-7634-5743-96f4-8104d0655a3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186249191}] :answer-field/correct {:db/id #edb/ref 17592186249191} :answer-field/id #uuid "c3dd683c-9379-5f34-9cdb-095ffd9b03f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186250005}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c6b1e250-deab-5051-9d86-76fdce192937" :question/math-academy-id "q-114033" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{3}{1+36{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $36{x}^{2}=(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{1+36{x}^{2}}\\,\\text{d}x & =3\\int \\frac{1}{1+(6x)^{2}}\\text{d}x \\\\  & =3\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250167 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0539dfbd-c13f-5910-83ae-6847aafc2ffa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247464} {:answer/id #uuid "0e2ff00e-68bf-502d-98ea-81a253a73c45" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{5}}{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247554} {:answer/id #uuid "4cfc5510-a085-5eb9-b318-bbda8928e434" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}\\operatorname{arctan}⁡(\\sqrt{5}x)+C" :db/id #edb/ref 17592186248113} {:answer/id #uuid "5