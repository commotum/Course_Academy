 $\\frac{9}{2}$" :db/id #edb/ref 17592186236841} {:answer/id #uuid "ae0a4fc5-1033-5109-8969-8d7ba972a0fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨9,2,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236922} {:answer/id #uuid "b365be51-4d65-5928-9f90-0629516c1e8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,-\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236953} {:answer/id #uuid "b865178d-d257-5526-bfc0-ea89da1ca0eb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236995} {:answer/id #uuid "b88af444-ebe4-538f-b36d-7d631ef9bcbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186236998} {:answer/id #uuid "bf62ed9c-4b79-5d2c-83d9-7a2053919ece" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237033} {:answer/id #uuid "c8ade3ad-b14b-5699-bf42-c67e2fd932b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186237088} {:answer/id #uuid "c9d0e896-c4c4-58e2-a331-79ea27bb0deb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186237098} {:answer/id #uuid "cf31be4e-0647-5297-be76-a4721eb22f2a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237129} {:answer/id #uuid "d0cd46be-6ca9-56ad-98b1-e84372745705" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},4)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237141} {:answer/id #uuid "d9ca6f54-6773-56f6-8dd0-f043a63dc54a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186237197} {:answer/id #uuid "eacaf34b-cf8f-52ab-b1bd-50892fbd8315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{2},1,2⟩" :db/id #edb/ref 17592186237293} {:answer/id #uuid "ed095146-97be-5a52-a3bb-a25e4678bcb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186237311} {:answer/id #uuid "fc2a1ef9-6f90-5fd1-aa22-221a29a4b907" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237416} {:db/id #edb/ref 17592186237779 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c304fc9-c9da-5d97-9759-ccf6e138d12f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186236194} {:answer/id #uuid "53809d10-dcef-5e85-886e-cc325cd763be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186236347} {:answer/id #uuid "77c7b91a-bbc1-589a-884f-c42b2bb99fab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236569} {:answer/id #uuid "78657ffb-16ea-5821-a776-4f1b2747a9b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186236573} {:answer/id #uuid "c385379d-8237-5252-97dc-f26a22711a71" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186237053}] :answer-field/correct {:db/id #edb/ref 17592186236347} :answer-field/id #uuid "9a6e6951-f040-51c5-a0b5-e70540d8f884" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237642}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "bc8a355a-ee17-5da1-9a5f-fc0c8e06bcf1" :question/math-academy-id "q-10009" :question/problem "Find the slope of $y=\\operatorname{sin}⁡2x\\operatorname{cos}⁡3x$ at $x=\\frac{\\pi }{2}.$" :question/worked-solution "To find the slope at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nThis question requires the product rule. Let $u(x)=\\operatorname{sin}⁡2x$ and $v(x)=\\operatorname{cos}⁡3x.$ Then\n\n$$\n{u}^{′}(x)=2\\operatorname{cos}⁡2x,\\,{v}^{′}(x)=-3\\operatorname{sin}⁡3x.\n$$\n\nNote that we used the chain rule to differentiate $u$ and $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =(2\\operatorname{cos}⁡2x)(\\operatorname{cos}⁡3x)+(\\operatorname{sin}⁡2x)(-3\\operatorname{sin}⁡3x) \\\\  & =2\\operatorname{cos}⁡2x\\operatorname{cos}⁡3x-3\\operatorname{sin}⁡2x\\operatorname{sin}⁡3x.\\end{aligned}\n$$\n\nTherefore, the slope at $x=\\frac{\\pi }{2}$ is\n\n$$\n\\begin{aligned}{\\left(\\frac{\\text{d}y}{\\text{d}x}\\right)|}_{x=\\pi /2} & =2\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{2})-3\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{2}) \\\\  & =2\\operatorname{cos}⁡(\\pi )\\operatorname{cos}⁡\\left(\\frac{3\\pi }{2}\\right)-3\\operatorname{sin}⁡(\\pi )\\operatorname{sin}⁡\\left(\\frac{3\\pi }{2}\\right) \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237783 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "425bca4e-a682-5dda-80ab-6f161b50393e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186236241} {:answer/id #uuid "49c263bb-7a1f-5b4c-8b77-2165b9b3727d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186236289} {:answer/id #uuid "683b13cb-0f67-5258-ba85-303f86888925" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186236478} {:answer/id #uuid "71b48e68-9ce8-5b9c-a94b-47a842188405" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186236539} {:answer/id #uuid "e35e5636-a56e-5039-83fb-a9374c4c6ee0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186237245}] :answer-field/correct {:db/id #edb/ref 17592186237245} :answer-field/id #uuid "1b9249c7-2ae7-5846-8a18-6eb0bbf4c00f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237475}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2a9116c0-f205-5e1b-a6e8-af81ec36a619" :question/math-academy-id "q-10025" :question/problem "Find the area bounded between the curve $x=(y-1)^{2},$ the $y$-axis, and the lines $y=0$ and $y=1.$" :question/worked-solution "To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(y-1)^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}({y}^{2}-2y+1)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}\\,\\text{d}y-2{\\int }_{0}^{1}y\\,\\text{d}y+{\\int }_{0}^{1}\\,\\text{d}y \\\\  & ={\\frac{{y}^{3}}{3}|}_{0}^{1}-2\\cdot {\\frac{{y}^{2}}{2}|}_{0}^{1}+y{|}_{0}^{1} \\\\  & =(\\frac{1}{3}-0)-2(\\frac{1}{2}-0)+(1-0) \\\\  & =\\frac{1}{3}-1+1 \\\\  & =\\frac{1}{3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237785 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00342045-0995-5ac0-9082-e2c493b6cc8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186235795} {:answer/id #uuid "3e8a668f-1147-5bba-9b95-d5e99a2aacf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186236213} {:answer/id #uuid "475e4c3a-6849-5aea-86fa-e3147b75f3e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186236275} {:answer/id #uuid "5ca6a028-23d7-55ca-87ff-a8aa572e772f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186236400} {:answer/id #uuid "81bb8d7e-496a-5c65-9cc1-6883c80bc17d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186236624}] :answer-field/correct {:db/id #edb/ref 17592186236213} :answer-field/id #uuid "4955c0c5-229a-5516-9dd2-61066532a168" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237533}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6f29bfa0-dc37-515c-81cd-e8b0cf96041d" :question/math-academy-id "q-10031" :question/problem "![](images/b7/b77e20a705956f80379158fd88de70f95c94989c6bd7640d1f3c20d8cca7b4f5.png)\n\nFind the area of the finite region bounded between the curve $x=y-{y}^{3}$ and the $y$-axis, as shown above." :question/worked-solution "First, we find the $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}y-{y}^{3} & =0 \\\\ y(1-{y}^{2}) & =0 \\\\ y & =0,\\pm 1\\end{aligned}\n$$\n\nFrom the diagram, we see that we want to find the area between the curve $x=y-{y}^{3}$ and the $y$-axis from $y=0$ to $y=1.$ To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}(y-{y}^{3})\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y\\,\\text{d}y-{\\int }_{0}^{1}{y}^{3}\\,\\text{d}y \\\\  & ={\\frac{{y}^{2}}{2}|}_{0}^{1}-{\\frac{{y}^{4}}{4}|}_{0}^{1} \\\\  & =(\\frac{1}{2}-0)-(\\frac{1}{4}-0) \\\\  & =\\frac{1}{2}-\\frac{1}{4} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237786 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d18ae87-d7a6-5a7b-b4bd-16cd211fa40c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186236309} {:answer/id #uuid "5c91afc7-9b03-5114-b2a3-3b9488ad2a84" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The integral diverges" :db/id #edb/ref 17592186236398} {:answer/id #uuid "9dd01060-e778-52b3-8ccb-45a9f9ecbad5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186236805} {:answer/id #uuid "e46cf027-d71f-53f8-8b76-3c67e5ebf915" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186237253} {:answer/id #uuid "ea6fec14-48d3-52a1-9d98-c4ca5bca2f4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186237289}] :answer-field/correct {:db/id #edb/ref 17592186236805} :answer-field/id #uuid "0ddb76f7-4207-5e33-addb-c866cb19950e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237453}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "3de2b1c8-40e7-52d0-981a-62ca7ed3c790" :question/math-academy-id "q-100378" :question/problem "$$\n\\displaystyle {\\int }_{0}^{\\infty }2{e}^{-3x}\\,\\text{d}x=\n$$" :question/worked-solution "First, let's recall the following result:\n\n$$\n\\int {e}^{px+q}\\,\\text{d}x=\\frac{1}{p}{e}^{px+q}+C\n$$\n\nWe proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }2{e}^{-3x}\\,\\text{d}x & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}2{e}^{-3x}\\,\\text{d}x \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{-3x}\\,\\text{d}x \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{1}{3}{e}^{-3x}]}_{0}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{e}^{-3x}]}_{0}^{a} \\\\  & =-\\frac{2}{3}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{e}^{3a}}-1)\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y=\\frac{1}{{e}^{3x}},$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }\\frac{1}{{e}^{3x}}=\\infty $\n\n- $\\lim_{x\\to \\infty }\\frac{1}{{e}^{3x}}=0$\n\n![](images/45/45e8ddd8ddb33dc8d6a701ed75878271b331ce6b3591ba8fae9f4fa49020c12b.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }2{e}^{-3x}\\,\\text{d}x & =-\\frac{2}{3}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{e}^{3a}}-1) \\\\  & =-\\frac{2}{3}\\cdot (0-1) \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237788 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "472ea518-d11a-50f8-87ae-0c9c1703bfa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236274} {:answer/id #uuid "8ace8b2f-493b-50cf-acf2-279f0809078d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186236684} {:answer/id #uuid "8b3ca5aa-ef6f-57de-9f75-2a64e3f1b0b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186236688} {:answer/id #uuid "ad341f0f-dfa3-54de-88b1-b088c17d13e9" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The integral diverges" :db/id #edb/ref 17592186236921} {:answer/id #uuid "cca8a053-f776-5cd1-984d-85181b372bf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2" :db/id #edb/ref 17592186237116}] :answer-field/correct {:db/id #edb/ref 17592186236684} :answer-field/id #uuid "c49a57ac-b070-50b4-8b53-89002685ceb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237691}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6b1ae06b-fd9b-5498-b170-8acb123e5ca6" :question/math-academy-id "q-100424" :question/problem "Evaluate the integral $$\n\\displaystyle {\\int }_{0}^{\\infty }x{e}^{-{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "First, we substitute $u={x}^{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{2}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }x{e}^{-{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{0}^{\\infty }{e}^{-u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }x{e}^{-{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{0}^{\\infty }{e}^{-u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{-u}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }{[-{e}^{-u}]}_{0}^{a} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to \\infty }{[{e}^{-u}]}_{0}^{a} \\\\  & =-\\frac{1}{2}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{e}^{a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{e}^{x}},$ shown in the graph below:\n\n- $\\lim_{x\\to -\\infty }\\frac{1}{{e}^{x}}=\\infty $\n\n- $\\lim_{x\\to \\infty }\\frac{1}{{e}^{x}}=0$\n\n![](images/48/4844d6220d04a6a1fffdd5a485a9e6724aa6065397b8c3a009157a7a2dafc3cf.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }x{e}^{-{x}^{2}}\\,\\text{d}x & =-\\frac{1}{2}\\cdot (\\lim_{a\\to \\infty }\\frac{1}{{e}^{a}}-1) \\\\  & =-\\frac{1}{2}\\cdot (0-1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237799 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04550c7b-0d73-5442-a8c7-725dcd4c73b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186235825} {:answer/id #uuid "15ecb00b-13f7-5f52-9f60-143f66c29fe7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186235950} {:answer/id #uuid "beed3300-67b6-5a62-834b-6d15671e04c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}\\operatorname{cos}⁡(3-9x)+C" :db/id #edb/ref 17592186237031} {:answer/id #uuid "eeddc196-9f5f-51b9-8377-d64ab696355d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C" :db/id #edb/ref 17592186237323} {:answer/id #uuid "fa1174cf-350f-52d8-a72f-f4777b151d43" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{9}\\operatorname{cos}⁡(3-9x)+C" :db/id #edb/ref 17592186237398}] :answer-field/correct {:db/id #edb/ref 17592186235950} :answer-field/id #uuid "bb8fc073-d58e-5e24-bfbf-924d5974b80a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237681}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c7faa25b-953f-5de3-b7b5-5d74cb936a93" :question/math-academy-id "q-10064" :question/problem "Calculate $$\n\\displaystyle \\int \\operatorname{cos}⁡(3-9x)\\,\\text{d}x.\n$$" :question/worked-solution "If we let $u=3-9x,$ then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-9\\,⟹\\,\\text{d}x=-\\frac{1}{9}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡(3-9x)\\,\\text{d}x & =\\int \\operatorname{cos}⁡u\\cdot (-\\frac{1}{9}\\,\\text{d}u) \\\\  & =-\\frac{1}{9}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{9}\\operatorname{sin}⁡u+C \\\\  & =-\\frac{1}{9}\\operatorname{sin}⁡(3-9x)+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21b7bac2-7c49-5bca-b0a4-69dc3a8c9bcb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186236035} {:answer/id #uuid "440f0c7e-4732-5a58-8653-34d1d6a4c23f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The integral is divergent" :db/id #edb/ref 17592186236255} {:answer/id #uuid "b2d494d7-8ebd-5802-8686-db43d5ff7fbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186236949} {:answer/id #uuid "c46ac0dc-03a9-5a1a-8f79-a9bea31a3de9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186237059} {:answer/id #uuid "dac1ee25-c1c3-53e3-b4cf-2ad6e22e94c5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186237204}] :answer-field/correct {:db/id #edb/ref 17592186236255} :answer-field/id #uuid "c1733310-60f1-5249-b1c5-9809a13bbc72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237686}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "702f5890-f962-5297-b8db-429117ade5e4" :question/math-academy-id "q-100642" :question/problem "$$\n\\displaystyle {\\int }_{0}^{\\infty }\\frac{2}{\\sqrt[3]{2z+1}}\\,\\text{d}z=\n$$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt[3]{2z+1}}\\,\\text{d}z & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}\\frac{2}{\\sqrt[3]{2z+1}}\\,\\text{d}z \\\\  & =\\lim_{a\\to \\infty }{[\\frac{3}{2}(2z+1)^{2/3}]}_{0}^{a} \\\\  & =\\frac{3}{2}\\cdot {lim}_{a\\to \\infty }{[(2z+1)^{2/3}]}_{0}^{a} \\\\  & =\\frac{3}{2}\\cdot {lim}_{a\\to \\infty }((2a+1)^{2/3}-1) \\\\  & =\\frac{3}{2}\\cdot \\infty  \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent."} {:db/id #edb/ref 17592186237801 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c33a18d-104d-52e9-9c2f-5e801a820664" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "The integral is divergent" :db/id #edb/ref 17592186235881} {:answer/id #uuid "2c8d46d3-212e-5d20-a7db-1772936c7f05" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186236096} {:answer/id #uuid "3e50bf74-aff8-5e86-9467-5aa0194a6d09" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186236209} {:answer/id #uuid "468b0303-942b-5eae-80d1-6f45657de69f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\sqrt{5}}{3}" :db/id #edb/ref 17592186236271} {:answer/id #uuid "de9f84f3-7d6b-52fd-87cc-c8e2ef3fd885" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2\\sqrt{5}" :db/id #edb/ref 17592186237215}] :answer-field/correct {:db/id #edb/ref 17592186235881} :answer-field/id #uuid "f5392877-e39b-5b6d-8019-6b4895e6d441" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237757}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a8508ef3-0736-5531-a2ca-192705b437b6" :question/math-academy-id "q-100643" :question/problem "Evaluate $$\n\\displaystyle {\\int }_{-\\infty }^{-1}\\frac{\\text{d}t}{\\sqrt{2-3t}}.\n$$" :question/worked-solution "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{\\text{d}t}{\\sqrt{2-3t}} & =\\lim_{a\\to -\\infty }{\\int }_{a}^{-1}\\frac{\\text{d}t}{\\sqrt{2-3t}} \\\\  & =\\lim_{a\\to -\\infty }{[-\\frac{2}{3}\\sqrt{2-3t}]}_{a}^{-1} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to -\\infty }(\\sqrt{2+3}-\\sqrt{2-3a}) \\\\  & =-\\frac{2\\sqrt{5}}{3}+\\frac{2}{3}\\lim_{a\\to -\\infty }\\sqrt{2-3a} \\\\  & =-\\frac{2\\sqrt{5}}{3}+\\infty  \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent."} {:db/id #edb/ref 17592186237817 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fc2cef3-3779-5a84-b3dd-870af62fc39e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\infty " :db/id #edb/ref 17592186236121} {:answer/id #uuid "5e32ea1c-6e90-5598-848a-c2fe45e9b482" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186236409} {:answer/id #uuid "6deca878-52ee-517e-8baf-d36efaf4e914" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186236513} {:answer/id #uuid "78ed746d-5fde-55b5-99d0-9082aabcc249" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186236578} {:answer/id #uuid "809ec9ea-f524-5726-bc37-ff9b75ea9988" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236618}] :answer-field/correct {:db/id #edb/ref 17592186236121} :answer-field/id #uuid "8db4f528-7ef2-52a5-aae1-17fdb4db6859" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237625}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d1c1c46c-a871-5ff0-9e6c-d412da5bcf59" :question/math-academy-id "q-101312" :question/problem "$\\lim_{x\\to -\\infty }\\frac{{x}^{3}-x}{{x}^{2}-3}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}\\lim_{x\\to -\\infty }\\frac{{x}^{3}-x}{{x}^{2}-3} & =\\lim_{x\\to -\\infty }\\frac{(\\frac{{x}^{3}}{{x}^{2}}-\\frac{x}{{x}^{2}})}{(\\frac{{x}^{2}}{{x}^{2}}-\\frac{3}{{x}^{2}})} \\\\  & =\\lim_{x\\to -\\infty }\\frac{(x-\\frac{1}{x})}{(1-\\frac{3}{{x}^{2}})} \\\\  & =\\lim_{x\\to -\\infty }\\frac{x-0}{1-0} \\\\  & =\\lim_{x\\to -\\infty }x \\\\  & =-\\infty .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237818 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c55fdb4-94a8-5696-a79f-4aec4259cfa9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\infty " :db/id #edb/ref 17592186236095} {:answer/id #uuid "78c24e86-ccb0-545b-9a56-9c9a78a37b68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236575} {:answer/id #uuid "8dd4e621-fd8a-5442-bc7f-ec60a31b67e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186236714} {:answer/id #uuid "d9431812-5f39-5ef3-8901-6008588de9a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0" :db/id #edb/ref 17592186237193} {:answer/id #uuid "fce6e95c-a436-5086-811e-2e3fcc7f7312" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186237419}] :answer-field/correct {:db/id #edb/ref 17592186236095} :answer-field/id #uuid "2830c226-cabc-5d07-96b2-f645a76d5197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237492}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "13e1ae6a-783c-594e-b16d-9b94ff980ccc" :question/math-academy-id "q-101316" :question/problem "$$\n\\lim_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1}=\n$$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }\\frac{2{x}^{6}+7{x}^{3}-9}{2{x}^{3}-1} & =\\lim_{x\\to \\infty }\\frac{(\\frac{2{x}^{6}}{{x}^{3}}+\\frac{7{x}^{3}}{{x}^{3}}-\\frac{9}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}-\\frac{1}{{x}^{3}})} \\\\  & =\\lim_{x\\to \\infty }\\frac{(2{x}^{3}+7-\\frac{9}{{x}^{3}})}{(2-\\frac{1}{{x}^{3}})} \\\\  & =\\lim_{x\\to \\infty }\\frac{2{x}^{3}+7-0}{2-0} \\\\  & =\\frac{1}{2}\\lim_{x\\to \\infty }(2{x}^{3}+7) \\\\  & =\\infty .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237819 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1024cbb6-86fa-5bd4-9dd6-515aec5fd960" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186235903} {:answer/id #uuid "460a97c1-ee4a-5ca8-9a60-4edebf9c3bed" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{3}" :db/id #edb/ref 17592186236268} {:answer/id #uuid "7bc101ba-f69d-5b2d-91f6-2af06de8c5e3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186236588} {:answer/id #uuid "8066872c-efb2-56ef-b52f-d82105cf63fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2}" :db/id #edb/ref 17592186236616} {:answer/id #uuid "e8365958-c788-5b32-bacc-8b03f2b69fea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186237283}] :answer-field/correct {:db/id #edb/ref 17592186236588} :answer-field/id #uuid "e1e8c519-39ca-5e1b-810e-79ee1f71a4ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237726}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "ee5c05dd-afd4-5a6c-96ce-78c0f481e26e" :question/math-academy-id "q-101319" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{2{x}^{2}+x-1}{3x+2}.$" :question/worked-solution "The horizontal asymptote is $y=\\lim_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }f(x) & =\\lim_{x\\to \\infty }\\frac{2{x}^{2}+x-1}{3x+2} \\\\  & =\\lim_{x\\to \\infty }\\frac{(\\frac{2{x}^{2}}{x}+\\frac{x}{x}-\\frac{1}{x})}{(\\frac{3x}{x}+\\frac{2}{x})} \\\\  & =\\lim_{x\\to \\infty }\\frac{(2x+1-\\frac{1}{x})}{(3+\\frac{2}{x})} \\\\  & =\\lim_{x\\to \\infty }\\frac{(2x+1-0)}{(3+0)} \\\\  & =\\frac{1}{3}\\lim_{x\\to \\infty }(2x+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} {:db/id #edb/ref 17592186237820 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce7830f-283d-5b96-9209-b1dd78e6497b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186235886} {:answer/id #uuid "19616453-5fb9-51c1-be33-0d877a05a47e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=0" :db/id #edb/ref 17592186235975} {:answer/id #uuid "6ee8648a-721c-5e12-9682-ef6db45b54bb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{2}{5}" :db/id #edb/ref 17592186236518} {:answer/id #uuid "afee4d78-3f2e-5068-86ad-6e752c9d0cd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{4}{3}" :db/id #edb/ref 17592186236935} {:answer/id #uuid "c5281649-c8e3-5ed2-a128-c4d35753410b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{6}" :db/id #edb/ref 17592186237065}] :answer-field/correct {:db/id #edb/ref 17592186235886} :answer-field/id #uuid "3369daaa-ac55-5626-936d-a4c629a4de88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237510}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c64f5a85-aa62-5620-809a-0476c074fff3" :question/math-academy-id "q-101321" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{8{x}^{4}+x-2}{6x-5}.$" :question/worked-solution "The horizontal asymptote is $y=\\lim_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is $x.$\n\n$$\n\\begin{aligned}\\lim_{x\\to \\infty }f(x) & =\\lim_{x\\to \\infty }\\frac{8{x}^{4}+x-2}{6x-5} \\\\  & =\\lim_{x\\to \\infty }\\frac{(\\frac{8{x}^{4}}{x}+\\frac{x}{x}-\\frac{2}{x})}{(\\frac{6x}{x}-\\frac{5}{x})} \\\\  & =\\lim_{x\\to \\infty }\\frac{(8{x}^{3}+1-\\frac{2}{x})}{(6-\\frac{5}{x})} \\\\  & =\\lim_{x\\to \\infty }\\frac{(8{x}^{3}+1-0)}{(6-0)} \\\\  & =\\frac{1}{6}\\lim_{x\\to \\infty }(8{x}^{3}+1) \\\\  & =\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."} {:db/id #edb/ref 17592186237846 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fa40eb2-c180-538d-b522-de9d9f83d889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186236019} {:answer/id #uuid "695ae008-d47c-57f9-9587-05c4c533f86b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186236484} {:answer/id #uuid "a24abdba-ec13-587e-b963-32e6b30a415c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186236834} {:answer/id #uuid "aef8d084-d169-5e09-9f0e-1801f381f55c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186236932} {:answer/id #uuid "e2447701-f8a9-51c7-9d3a-46b568b874f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186237235}] :answer-field/correct {:db/id #edb/ref 17592186236484} :answer-field/id #uuid "edfc2aca-9792-5f3e-b0d4-4cac4d28ecd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237748}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "144f5038-f97a-55ee-aff4-8a719828b869" :question/math-academy-id "q-101528" :question/problem "Let $\\mathbf{a}=⟨2,-1,2⟩$ and $\\mathbf{b}=⟨6,2,-3⟩.$ Find ${\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a} & =\\frac{\\mathbf{a}\\cdot \\mathbf{b}}{|\\hspace{0.167em}\\mathbf{b}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 6+(-1)\\cdot 2+2\\cdot (-3)}{\\sqrt{{6}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{4}{\\sqrt{49}} \\\\  & =\\frac{4}{7}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{\\mathbf{b}\\cdot \\mathbf{a}}{|\\hspace{0.167em}\\mathbf{a}\\hspace{0.167em}|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{\\mathbf{b}}\\hspace{0.167em}\\mathbf{a}-{\\text{comp}}_{\\mathbf{a}}\\hspace{0.167em}\\mathbf{b} & =\\frac{4}{7}-\\frac{4}{3} \\\\  & =4(\\frac{1}{7}-\\frac{1}{3}) \\\\  & =4(\\frac{3}{21}-\\frac{7}{21}) \\\\  & =-\\frac{16}{21}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237848 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b320351-bc5f-5d30-8e1b-115490175e6d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\frac{2}{13},\\frac{3}{13}⟩" :db/id #edb/ref 17592186235874} {:answer/id #uuid "29861cc0-282e-55e8-bb73-6b1c84f3194b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\frac{2}{73},\\frac{3}{73}⟩" :db/id #edb/ref 17592186236077} {:answer/id #uuid "3aa6322d-6e21-5ba1-8a56-0d7256be7736" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186236186} {:answer/id #uuid "7ec4107b-3b2f-5d39-9dc6-6d7a9eda213d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\frac{4}{13},\\frac{6}{13}⟩" :db/id #edb/ref 17592186236603} {:answer/id #uuid "88a89953-8437-5bb0-bfe1-f370c45a6462" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\frac{4}{73},\\frac{6}{73}⟩" :db/id #edb/ref 17592186236671}] :answer-field/correct {:db/id #edb/ref 17592186236603} :answer-field/id #uuid "6b5736ba-ea23-5e79-9cac-607c5a0cd1a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237579}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "9c17c0ad-57b9-5e4e-96cf-a2591d364b0a" :question/math-academy-id "q-101541" :question/problem "Let $a=\\begin{bmatrix}9 \\\\ 7 \\\\ -4\\end{bmatrix}$ and $b=\\begin{bmatrix}0 \\\\ 2 \\\\ 3\\end{bmatrix}.$ Find the vector projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & =\\frac{a\\cdot b}{b\\cdot b}b \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}b \\\\  & =\\frac{9\\cdot 0+7\\cdot 2+(-4)\\cdot 3}{{0}^{2}+{2}^{2}+{3}^{2}}b \\\\  & =\\frac{2}{13}⟨0,2,3⟩ \\\\  & =⟨0,\\frac{4}{13},\\frac{6}{13}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237854 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "472e11dd-8537-5b30-ad11-59c4c14c5212" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186236273} {:answer/id #uuid "6d4f0ac8-1dab-5270-b011-493f700ff938" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3+8\\ln ⁡2" :db/id #edb/ref 17592186236509} {:answer/id #uuid "78e82567-e2b5-51dd-885b-f1af7319339c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "11" :db/id #edb/ref 17592186236577} {:answer/id #uuid "90cac687-dd21-570e-a62a-f9e1d628421a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\ln ⁡2-2" :db/id #edb/ref 17592186236739} {:answer/id #uuid "97421f7d-e972-5d83-b422-5d436b8e6feb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186236777}] :answer-field/correct {:db/id #edb/ref 17592186236577} :answer-field/id #uuid "3e2000d3-5ddf-572d-be68-d0feed75463e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237519}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "09ca9b0e-b19f-5aca-b14f-466e3c4366f1" :question/math-academy-id "q-101726" :question/problem "Given that $y=3x-5+8{\\log }_{2}⁡x$, find the slope of the tangent at $x=\\frac{1}{\\ln ⁡2}.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(3x-5+8{\\log }_{2}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3x)+\\frac{\\text{d}}{\\text{d}x}(-5)+\\frac{\\text{d}}{\\text{d}x}(8{\\log }_{2}⁡x) \\\\  & =3\\frac{\\text{d}}{\\text{d}x}(x)-\\frac{\\text{d}}{\\text{d}x}(5)+8\\frac{\\text{d}}{\\text{d}x}({\\log }_{2}⁡x) \\\\  & =3-0+8\\cdot \\frac{1}{x\\ln ⁡2} \\\\  & =3+\\frac{8}{x\\ln ⁡2}\\,.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=\\frac{1}{\\ln ⁡2}$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=1/\\ln ⁡2} & ={(3+\\frac{8}{x\\ln ⁡2})|}_{x=1/\\ln ⁡2} \\\\  & =3+\\frac{8}{(\\frac{1}{\\ln ⁡2}\\cdot \\ln ⁡2)} \\\\  & =3+8 \\\\  & =11\\,.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237855 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff5263a7-1895-5085-8df6-00b5e700d455" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461171} {:answer/id #uuid "6a138658-7727-5b84-9147-e75c4bc6f6be" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461172}] :answer-field/correct {:db/id #edb/ref 17592186461171} :answer-field/id #uuid "6fe9a7c8-6e85-594b-b112-88855ef364c3" :answer-field/key "${\\int }_{-\\infty }^{-2}\\frac{1}{{u}^{3}}\\,\\text{d}u$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462339} {:answer-field/choices [{:answer/id #uuid "a49961ff-3ffb-57ca-a127-a6af05c42338" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461173} {:answer/id #uuid "283b72c8-abd2-59aa-94d2-c526caba130c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461174}] :answer-field/correct {:db/id #edb/ref 17592186461173} :answer-field/id #uuid "de28bf36-f83a-5fcb-b309-eca4f69c6915" :answer-field/key "${\\int }_{0}^{\\infty }\\frac{1}{(z+3)^{2}}\\,\\text{d}z$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462340} {:answer-field/choices [{:answer/id #uuid "9a089b8d-46c8-5953-a6f9-b2962253f826" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461175} {:answer/id #uuid "ad3d8c52-3f24-5cde-b9fc-ebd2788b23f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461176}] :answer-field/correct {:db/id #edb/ref 17592186461176} :answer-field/id #uuid "292bf9b3-4412-5dd3-80d1-271235a3924d" :answer-field/key "${\\int }_{2}^{\\infty }\\frac{1}{x}\\,\\text{d}x$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462341}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "8e90080f-3ef7-5c8d-a0d7-de79fffa1eb1" :question/math-academy-id "q-101735" :question/problem "Which of the following improper integrals are divergent?\n\nSelect all that apply." :question/worked-solution "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{1}{{u}^{3}}\\,\\text{d}u & =\\lim_{a\\to -\\infty }{\\int }_{a}^{-2}\\frac{1}{{u}^{3}}\\,\\text{d}u \\\\  & =\\lim_{a\\to -\\infty }{[-\\frac{1}{2{u}^{2}}]}_{a}^{-2} \\\\  & =\\lim_{a\\to -\\infty }(-\\frac{1}{2(-2)^{2}}+\\frac{1}{2{a}^{2}}) \\\\  & =\\lim_{a\\to -\\infty }(\\frac{1}{2{a}^{2}}-\\frac{1}{8}) \\\\  & =-\\frac{1}{8},\\end{aligned}\n$$\n\nso the integral is convergent.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{1}{(z+3)^{2}}\\,\\text{d}z & =\\lim_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{(z+3)^{2}}\\,\\text{d}z \\\\  & =\\lim_{a\\to \\infty }{[-\\frac{1}{z+3}]}_{0}^{a} \\\\  & =\\lim_{a\\to \\infty }(-\\frac{1}{a+3}+\\frac{1}{0+3}) \\\\  & =\\frac{1}{3},\\end{aligned}\n$$\n\nso the integral is convergent.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{x}\\,\\text{d}x & =\\lim_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{x}\\,\\text{d}x \\\\  & =\\lim_{a\\to \\infty }[\\operatorname{ln}⁡|x|]_{2}^{a} \\\\  & =\\lim_{a\\to \\infty }(\\operatorname{ln}⁡a-\\operatorname{ln}⁡2) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nIn conclusion, only integrals $$\n\\displaystyle {\\int }_{2}^{\\infty }\\frac{1}{x}\\,\\text{d}x\n$$ is divergent."} {:db/id #edb/ref 17592186237856 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11cbf150-b683-51fa-9f8a-d203bcfb3ad7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461177} {:answer/id #uuid "5956e27d-8d17-501a-8856-f798cc05f016" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461178}] :answer-field/correct {:db/id #edb/ref 17592186461177} :answer-field/id #uuid "0c8fa3d2-c067-5b43-a12b-85e271c9cb1e" :answer-field/key "${\\int }_{-\\infty }^{0}\\frac{1}{(u-1)^{2}}\\,\\text{d}u$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462342} {:answer-field/choices [{:answer/id #uuid "4de3cb94-3a2c-5891-aae8-6ea29f0d4df4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461179} {:answer/id #uuid "8565509e-ebc2-5ae6-96ae-9d8817a43af7" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461180}] :answer-field/correct {:db/id #edb/ref 17592186461180} :answer-field/id #uuid "6f996994-3b27-587f-9d4f-5527cd7a6f32" :answer-field/key "${\\int }_{-\\infty }^{0}t\\,\\text{d}t$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462343} {:answer-field/choices [{:answer/id #uuid "70ebaee1-04f7-54b6-af95-172ae288615f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461181} {:answer/id #uuid "4626a4f4-a591-579d-a987-b3940f00bbae" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461182}] :answer-field/correct {:db/id #edb/ref 17592186461182} :answer-field/id #uuid "81f2e71e-76d6-53a1-bb19-e51bae15960a" :answer-field/key "${\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{x-2}}\\,\\text{d}x$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462344}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "30834ba5-7de3-5c58-8e09-a32166c98581" :question/math-academy-id "q-101738" :question/problem "Which of the following improper integrals are divergent?\n\nSelect all that apply." :question/worked-solution "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{1}{(u-1)^{2}}\\,\\text{d}u & =\\lim_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{1}{(u-1)^{2}}\\,\\text{d}u \\\\  & =\\lim_{a\\to -\\infty }{[-\\frac{1}{u-1}]}_{a}^{0} \\\\  & =\\lim_{a\\to -\\infty }(1+\\frac{1}{a-1}) \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}t\\,\\text{d}t & =\\lim_{a\\to -\\infty }{\\int }_{a}^{0}t\\,\\text{d}t \\\\  & =\\lim_{a\\to -\\infty }{[\\frac{1}{2}{t}^{2}]}_{a}^{0} \\\\  & =\\frac{1}{2}\\lim_{a\\to -\\infty }(0-{a}^{2}) \\\\  & =-\\frac{1}{2}\\lim_{a\\to -\\infty }{a}^{2} \\\\  & =-\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{x-2}}\\,\\text{d}x & =\\lim_{a\\to \\infty }{\\int }_{3}^{a}\\frac{2}{\\sqrt{x-2}}\\,\\text{d}x \\\\  & =\\lim_{a\\to \\infty }{[4\\sqrt{x-2}]}_{3}^{a} \\\\  & =4\\lim_{a\\to \\infty }(\\sqrt{a-2}-\\sqrt{3-2}) \\\\  & =4\\lim_{a\\to \\infty }(\\sqrt{a-2}-1) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\nIn conclusion, only integrals $$\n\\displaystyle {\\int }_{-\\infty }^{0}t\\,\\text{d}t\n$$ and $$\n\\displaystyle {\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{x-2}}\\,\\text{d}x\n$$ are divergent."} {:db/id #edb/ref 17592186237857 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07dcf4b7-f078-5a2e-a735-3b20d8605b65" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{3}{2},1,2⟩" :db/id #edb/ref 17592186235851} {:answer/id #uuid "655a2955-9481-5b82-b696-403148efe58f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{3}{2},-1,2⟩" :db/id #edb/ref 17592186236461} {:answer/id #uuid "b88af444-ebe4-538f-b36d-7d631ef9bcbc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨-\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186236998} {:answer/id #uuid "eacaf34b-cf8f-52ab-b1bd-50892fbd8315" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{3}{2},1,2⟩" :db/id #edb/ref 17592186237293} {:answer/id #uuid "ed095146-97be-5a52-a3bb-a25e4678bcb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186237311}] :answer-field/correct {:db/id #edb/ref 17592186236998} :answer-field/id #uuid "4cd55584-3d52-5dd3-a238-228e2f11f49c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237541}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "cbce6ae8-46c9-5589-9b0d-0bac9aaa8725" :question/math-academy-id "q-10195" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x+y+z &=\\frac{1}{2} \\\\ y+z &=1 \\\\ z &=2\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that  $z=2.$ Substituting this into the second equation, we get \n\n$$\ny+2=1\\,⟹\\,y=1-2=-1.\n$$\n\nNow, we substitute $z=2$ and $y=-1$into the first equation to get\n\n$$\nx+(-1)+(2)=\\frac{1}{2}\\,⟹\\,x=\\frac{1}{2}-2+1=-\\frac{1}{2}.\n$$\n\nTherefore, the solution is $x=-\\frac{1}{2}$, $y=-1$, and $z=2.$ In vector form, the solution can be written as $⟨-\\frac{1}{2},-1,2⟩.$"} {:db/id #edb/ref 17592186237860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42b32625-e9e5-563b-839b-42adeb20be73" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{11}{2},1,\\frac{1}{2}⟩" :db/id #edb/ref 17592186236242} {:answer/id #uuid "4df95115-ebe6-57f1-95ca-f41c99471efc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{9}{2},1,2⟩" :db/id #edb/ref 17592186236315} {:answer/id #uuid "5f06f67c-d421-5bdd-a544-bd3b46e1f841" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{9}{2},2,\\frac{1}{2}⟩" :db/id #edb/ref 17592186236415} {:answer/id #uuid "7cbe9c28-bf2a-5e90-8453-b0d39a6514ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨1,\\frac{9}{2},-\\frac{1}{2}⟩" :db/id #edb/ref 17592186236596} {:answer/id #uuid "c8ade3ad-b14b-5699-bf42-c67e2fd932b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨\\frac{1}{2},-1,2⟩" :db/id #edb/ref 17592186237088}] :answer-field/correct {:db/id #edb/ref 17592186236242} :answer-field/id #uuid "8d4de894-66e9-5d27-878e-0a6e914b403a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237624}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "498c3ac6-7680-54fc-be56-c8179953d99f" :question/math-academy-id "q-10197" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}x-y-z &=4 \\\\ y+2z &=2 \\\\ z &=\\frac{1}{2}\\end{aligned}\\right.\n$$" :question/worked-solution "he third equation states that  $z=\\frac{1}{2}.$ Substituting this into the second equation, we get\n\n$$\ny+2\\left(\\frac{1}{2}\\right)=2\\,⟹\\,y=2-1=1.\n$$\n\nNow, we substitute $z=\\frac{1}{2}$ and $y=1$ into the first equation to get\n\n$$\nx-(1)-\\left(\\frac{1}{2}\\right)=4\\,⟹\\,x=4+1+\\frac{1}{2}=\\frac{11}{2}.\n$$\n\nTherefore, the solution is $x=\\frac{11}{2}$,  $y=1$, and $z=\\frac{1}{2}.$  In vector form, the solution can be written as $⟨\\frac{11}{2},1,\\frac{1}{2}⟩.$"} {:db/id #edb/ref 17592186237861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0947bcb2-124b-5a9b-8c2d-caaf1dd4d78e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨12,-3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186235859} {:answer/id #uuid "4b19167d-8908-5eb5-b1b2-35217d6c79d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨9,-3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236299} {:answer/id #uuid "6b66fc33-4c80-5b0f-8c9f-716a423a5b5e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨11,3,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236494} {:answer/id #uuid "ae0a4fc5-1033-5109-8969-8d7ba972a0fb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨9,2,\\frac{1}{3}⟩" :db/id #edb/ref 17592186236922} {:answer/id #uuid "d095b16d-d82d-5f43-b45a-419f5d3af373" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨11,3,3⟩" :db/id #edb/ref 17592186237139}] :answer-field/correct {:db/id #edb/ref 17592186236494} :answer-field/id #uuid "be1426b6-aff3-5cb0-a4a0-23caf436597b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237682}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "bcc22116-bc14-5a39-b8c2-56ca9a77cd3e" :question/math-academy-id "q-10198" :question/problem "Solve the following system of equations:\n    \n\n$$\n\\left\\{\\begin{aligned}{x}_{1}-{x}_{2}+3{x}_{3} &=9 \\\\ {x}_{2}-3{x}_{3} &=2 \\\\ {x}_{3} &=\\frac{1}{3}\\end{aligned}\\right.\n$$" :question/worked-solution "The third equation states that  ${x}_{3}=\\frac{1}{3}.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}-3\\left(\\frac{1}{3}\\right)=2\\,⟹\\,{x}_{2}=2+1=3.\n$$\n\nNow, we substitute ${x}_{3}=\\frac{1}{3}$ and ${x}_{2}=3$ into the first equation to get\n\n$$\n{x}_{1}-(3)+3\\left(\\frac{1}{3}\\right)=9\\,⟹\\,{x}_{1}=9+3-1=11.\n$$\n\nTherefore, the solution is ${x}_{1}=11$, ${x}_{2}=3$, and ${x}_{3}=\\frac{1}{3}.$ In vector form, the solution can be written as $⟨11,3,\\frac{1}{3}⟩.$"} {:db/id #edb/ref 17592186237874 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "140ff256-58cb-520e-bd9f-ea7c8a886af9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{2\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186235938} {:answer/id #uuid "1b82390d-5224-5735-9b05-52d62582a7a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2\\sqrt{x}}" :db/id #edb/ref 17592186235987} {:answer/id #uuid "42c2e22e-7c41-5aba-866b-c2bfb66a3484" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3\\sqrt{{x}^{5}}}" :db/id #edb/ref 17592186236246} {:answer/id #uuid "76520e43-a300-5719-9281-b069c04cc15c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3\\sqrt{x}}" :db/id #edb/ref 17592186236558} {:answer/id #uuid "8f7c3eb2-612e-5bea-9351-f3a4af8fd436" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}" :db/id #edb/ref 17592186236726}] :answer-field/correct {:db/id #edb/ref 17592186235938} :answer-field/id #uuid "fbea9dd8-14a2-537f-a32b-13a92d5ed3d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237769}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "ec04a0d1-192f-5dcf-aa4b-20bf3669c6e0" :question/math-academy-id "q-102192" :question/problem "If $y=\\frac{1}{3\\sqrt{{x}^{3}}},$ find $\\frac{dy}{dx}.$" :question/worked-solution "We first rewrite the function as\n\n$$\ny=\\frac{1}{3\\sqrt{{x}^{3}}}=\\frac{1}{3}{x}^{-3/2}.\n$$\n\nThen, we apply the constant multiple and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}{x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-3/2}) \\\\  & =\\frac{1}{3}\\cdot \\left(-\\frac{3}{2}\\right){x}^{(-\\frac{3}{2}-1)} \\\\  & =-\\frac{1}{2}{x}^{-5/2} \\\\  & =-\\frac{1}{2\\sqrt{{x}^{5}}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237898 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e65dd22-0c47-5b8f-80fe-8a35924d61cd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{(3x+1)}+\\frac{2}{(x-4)}+\\frac{5}{(3-x)}" :db/id #edb/ref 17592186236013} {:answer/id #uuid "6b2b27c4-3f08-56f8-9ee8-a28e9e4040b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{(3x+1)}+\\frac{3}{(x-4)}+\\frac{2}{(3-x)}" :db/id #edb/ref 17592186236493} {:answer/id #uuid "8dac7305-ee26-55c0-96b1-d829bc4316c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{(3x+1)}+\\frac{1}{(x-4)}+\\frac{5}{(3-x)}" :db/id #edb/ref 17592186236713} {:answer/id #uuid "91664327-90af-56d6-941f-24de5b719221" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{(3x+1)}+\\frac{1}{(x-4)}+\\frac{4}{(3-x)}" :db/id #edb/ref 17592186236740} {:answer/id #uuid "fdcbe96b-9f18-5614-bb0d-a7a8be519329" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{3}{(3x+1)}+\\frac{7}{(x-4)}-\\frac{3}{(3-x)}" :db/id #edb/ref 17592186237430}] :answer-field/correct {:db/id #edb/ref 17592186236493} :answer-field/id #uuid "05599ffd-565f-5675-9ce1-bcbfc4aedb1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237449}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "48525aef-1401-5350-b706-3dd8e85f6bef" :question/math-academy-id "q-102531" :question/problem "Express $\\frac{37-19x}{(3x+1)(x-4)(3-x)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{37-19x}{(3x+1)(x-4)(3-x)} & =\\frac{A}{(3x+1)}+\\frac{B}{(x-4)}+\\frac{C}{(3-x)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+1)(x-4)(3-x)$ gives\n\n$$\n37-19x=A(x-4)(3-x)+B(3x+1)(3-x)+C(3x+1)(x-4).\n$$\n\nFor $x=-\\frac{1}{3}$, we get \n\n$$\n\\begin{aligned}37-19\\left(-\\frac{1}{3}\\right) & =A(-\\frac{1}{3}-4)(3-\\left(-\\frac{1}{3}\\right)) \\\\  & +B(3\\left(-\\frac{1}{3}\\right)+1)(3-\\left(-\\frac{1}{3}\\right)) \\\\  & +C(3\\left(-\\frac{1}{3}\\right)+1)(-\\frac{1}{3}-4) \\\\ 37+\\frac{19}{3} & =A\\left(-\\frac{130}{9}\\right) \\\\ \\frac{130}{3} & =A\\left(-\\frac{130}{9}\\right) \\\\ A & =-3.\\end{aligned}\n$$\n\nFor $x=4$, we get \n\n$$\n\\begin{aligned}37-19(4) & =A(4-4)(3-4) \\\\  & \\,+B(3(4)+1)(3-4) \\\\  & +C(3(4)+1)(x-4) \\\\ 37-76 & =B(-13) \\\\ B & =\\frac{-39}{-13} \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}37-19(3) & =A(3-4)(3-3) \\\\  & \\,+B(3(3)+1)(3-3) \\\\  & +C(3(3)+1)(3-4) \\\\ 37-57 & =C(-10) \\\\ C & =\\frac{-20}{-10} \\\\ C & =2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{37-19x}{(3x+1)(x-4)(3-x)}=-\\frac{3}{(3x+1)}+\\frac{3}{(x-4)}+\\frac{2}{(3-x)}.\n$$"} {:db/id #edb/ref 17592186237901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a7c16b9-ca47-5bdc-8afb-fb24b5d329e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186235865} {:answer/id #uuid "1572b304-d016-515b-a00b-811e20872dd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6" :db/id #edb/ref 17592186235946} {:answer/id #uuid "2d036771-7cf5-5a43-9518-e68dcfb124b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-5" :db/id #edb/ref 17592186236100} {:answer/id #uuid "91d30ab3-a94e-50b0-a6af-f7fe19ea56d1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-4" :db/id #edb/ref 17592186236741} {:answer/id #uuid "fd24b45f-3cdb-531f-8617-5b313bb90baa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186237422}] :answer-field/correct {:db/id #edb/ref 17592186237422} :answer-field/id #uuid "4dc20b91-0a45-5c2a-b7bf-fc2cf43de006" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237542}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "9e760206-a007-5062-8f2d-fefff458b4ed" :question/math-academy-id "q-102552" :question/problem "Given that\n\n$$\n\\frac{7{x}^{2}+20x+3}{(3x+2)(x-1)(x+5)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, calculate $A+B+C.$" :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{7{x}^{2}+20x+3}{(3x+2)(x-1)(x+5)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+2)(x-1)(x+5)$ gives\n\n$$\n7{x}^{2}+20x+3=A(x-1)(x+5)+B(3x+2)(x+5)+C(3x+2)(x-1).\n$$\n\nFor $x=-\\frac{2}{3}$, we get \n\n$$\n\\begin{aligned}7{\\left(-\\frac{2}{3}\\right)}^{2}+20\\left(-\\frac{2}{3}\\right)+3 & =A(-\\frac{2}{3}-1)(-\\frac{2}{3}+5) \\\\  & \\,+B(3\\left(-\\frac{2}{3}\\right)+2)(-\\frac{2}{3}+5) \\\\  & \\,+C(3\\left(-\\frac{2}{3}\\right)+2)(-\\frac{2}{3}-1) \\\\ \\frac{28}{9}-\\frac{40}{3}+3 & =A\\left(-\\frac{65}{9}\\right) \\\\ -\\frac{65}{9} & =A\\left(-\\frac{65}{9}\\right) \\\\ A & =1.\\end{aligned}\n$$\n\nFor $x=1$, we get \n\n$$\n\\begin{aligned}7(1)^{2}+20(1)+3 & =A(1-1)(1+5) \\\\  & \\,+B(3(1)+2)(1+5) \\\\  & \\,+C(3(1)+2)(1-1) \\\\ 7+20+3 & =B(30) \\\\ B & =\\frac{30}{30} \\\\ B & =1.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}7(-5)^{2}+20(-5)+3 & =A(-5-1)(-5+5) \\\\  & \\,+B(3(-5)+2)(-5+5) \\\\  & \\,+C(3(-5)+2)(-5-1) \\\\ 175-100+3 & =C(78) \\\\ C & =\\frac{78}{78} \\\\ C & =1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C=1+1+1=3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237903 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "241e58ea-86ce-5450-939e-02de03cdebfc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186236050} {:answer/id #uuid "2e56d505-7726-5af1-871c-95766070a7e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236112} {:answer/id #uuid "5b86c06b-4025-5e46-b183-b3a382a369a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186236390} {:answer/id #uuid "62be5c5d-404d-5b63-b96a-01802a0419b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186236442} {:answer/id #uuid "f134bbd3-d5b3-51e4-9905-9b65f60e5fa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186237336}] :answer-field/correct {:db/id #edb/ref 17592186236050} :answer-field/id #uuid "86665b82-4f5e-59d4-b139-f213cd90fc89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237619}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eeda4143-b348-582e-8960-ff5a4ad7dde2" :question/math-academy-id "q-10256" :question/problem "![](images/da/da529910e268ea4c124d7c27b085ca1799e255604459c539cc8d5809dda8f95a.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx={\\sin }^{3}⁡t,\\,y={\\cos }^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({\\sin }^{3}⁡t)=3{\\sin }^{2}⁡t\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({\\cos }^{3}⁡t)=-3{\\cos }^{2}⁡t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(3{\\sin }^{2}⁡t\\operatorname{cos}⁡t)}^{2}+{(-3{\\cos }^{2}⁡t\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{\\sin }^{4}⁡t{\\cos }^{2}⁡t+9{\\cos }^{4}⁡t{\\sin }^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{9{\\sin }^{2}⁡t{\\cos }^{2}⁡t({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =\\frac{3}{2}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{4}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{4}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{4}(-1-1) \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a98e176-de94-501d-9654-ee79fa546361" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186235866} {:answer/id #uuid "5cbcf497-35c1-530e-8b8a-1e4520aff5ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236401} {:answer/id #uuid "64a92041-6332-5b56-9a49-329279ae7898" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186236454} {:answer/id #uuid "c676c67b-ce2e-5ee3-a924-56c7b533c894" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186237076} {:answer/id #uuid "ea75476f-d42e-58e7-be1d-885fe5dc9408" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186237291}] :answer-field/correct {:db/id #edb/ref 17592186237291} :answer-field/id #uuid "dc8f08e3-d8d9-5787-8e9c-79e2c433c62c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237721}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "01f0c95b-ef07-5cce-9a1b-7f84a8200390" :question/math-academy-id "q-10257" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=2{\\cos }^{3}⁡t,\\,y=2{\\sin }^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{\\cos }^{3}⁡t)=-6{\\cos }^{2}⁡t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{\\sin }^{3}⁡t)=6{\\sin }^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(-6{\\cos }^{2}⁡t\\operatorname{sin}⁡t)}^{2}+{(6{\\sin }^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{\\cos }^{4}⁡t{\\sin }^{2}⁡t+36{\\sin }^{4}⁡t{\\cos }^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{\\sin }^{2}⁡t{\\cos }^{2}⁡t({\\cos }^{2}⁡t+{\\sin }^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}6\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{2}(-1-1) \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237911 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33d582ab-25c3-5d89-b31c-eee9f2c1897c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186236147} {:answer/id #uuid "671a11ec-27d8-52b9-9a59-8dd0d0ec54c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186236466} {:answer/id #uuid "7dedda59-24a2-5ab6-bb9d-20a20b1f41ec" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186236599} {:answer/id #uuid "c654b5a5-a703-55fd-9759-75e1cbdb9a7a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186237074} {:answer/id #uuid "e227f87d-b8bb-5a30-92ed-b9b3c38e19ca" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186237232}] :answer-field/correct {:db/id #edb/ref 17592186236466} :answer-field/id #uuid "58761fb6-2552-5c63-b655-9819d63debb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237557}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "27c17b75-37ea-5768-beae-14242dea6c22" :question/math-academy-id "q-10258" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=2(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t),\\,y=2(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t),\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)) \\\\  & =2\\operatorname{cos}⁡t-2(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =2t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)) \\\\  & =-2\\operatorname{sin}⁡t+2(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =2t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(2t\\operatorname{sin}⁡t)}^{2}+{(2t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{t}^{2}({\\sin }^{2}⁡t+{\\cos }^{2}⁡t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi }t\\,\\text{d}t \\\\  & =2\\cdot {\\frac{{t}^{2}}{2}|}_{0}^{\\pi } \\\\  & =2(\\frac{{\\pi }^{2}}{2}-0) \\\\  & ={\\pi }^{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237913 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09aa28b6-42d5-5647-8c67-6ad4ae934fea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186235862} {:answer/id #uuid "1bb02d36-4654-5167-a760-32462c48caf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\pi " :db/id #edb/ref 17592186235991} {:answer/id #uuid "3ead8f61-e137-5573-914b-52260b377c8b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186236214} {:answer/id #uuid "478c7a12-33ef-5729-9381-971f513d4e4e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\pi " :db/id #edb/ref 17592186236277} {:answer/id #uuid "c3466be1-0698-5115-8533-dbaa1ef80524" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{16}{3}" :db/id #edb/ref 17592186237050}] :answer-field/correct {:db/id #edb/ref 17592186235862} :answer-field/id #uuid "b04a5fcb-f5d2-5c81-be86-d5724d0bb948" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237664}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "31e80fe7-2790-57b6-8a22-f24ca436c4a9" :question/math-academy-id "q-10261" :question/problem "![](images/82/8288453c2625dac592a51054df332abf8ee49dbf8cbcabaf327c3ffe63b55f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t),\\,y=2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t),\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{\\left(\\frac{\\text{d}x}{\\text{d}t}\\right)}^{2}+{\\left(\\frac{\\text{d}y}{\\text{d}t}\\right)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t))}^{2}+{(2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{\\sin }^{2}⁡t-8\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t)+4{\\sin }^{2}⁡(2t)+4{\\cos }^{2}⁡t-8\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+4{\\cos }^{2}⁡(2t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4+4-8(\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡(2t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{\\sin }^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right) \\\\ \\operatorname{cos}⁡t & =1-2{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right) \\\\ 1-\\operatorname{cos}⁡t & =2{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right) \\\\ 8-8\\operatorname{cos}⁡t & =16{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right)\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{16{\\sin }^{2}⁡\\left(\\frac{t}{2}\\right)}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡\\left(\\frac{t}{2}\\right)\\,\\text{d}t \\\\  & =-8{\\operatorname{cos}⁡\\left(\\frac{t}{2}\\right)|}_{0}^{\\pi } \\\\  & =-8(\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{cos}⁡0) \\\\  & =-8(0-1) \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237916 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "166d0a6c-05a8-5786-b48c-f4e93b1f3b0c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{2}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186235955} {:answer/id #uuid "1dc3551c-3d67-5cc6-8438-b49e16bdf115" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{4}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186236011} {:answer/id #uuid "45c69b36-6d72-503c-9c36-09fae5919dba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{8}(x+3)^{2}(x-3)" :db/id #edb/ref 17592186236267} {:answer/id #uuid "d00d1ba1-3166-54b8-b47f-c8a1f0daadff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=-\\frac{1}{4}(x+3)(x-3)^{2}" :db/id #edb/ref 17592186237136} {:answer/id #uuid "f55f988f-ed06-5427-b54b-471e782de7ff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y=\\frac{1}{8}(x+3)(x-3)^{2}" :db/id #edb/ref 17592186237365}] :answer-field/correct {:db/id #edb/ref 17592186236267} :answer-field/id #uuid "8f11615a-9ff4-5a1c-97b7-4c67c3c73fb2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237627}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "440dd157-2982-5c1f-8661-23a8368ce029" :question/math-academy-id "q-102664" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=1-2t,\\,\\,\\,y=(t-2)^{2}(t+1),\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=1-2t\\,⇒\\,t=\\frac{1-x}{2}\\end{aligned}\n$$\n\nNow, substituting $t=\\frac{1-x}{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & ={(\\frac{1-x}{2}-2)}^{2}(\\frac{1-x}{2}+1) \\\\  & ={\\left(\\frac{1-x-4}{2}\\right)}^{2}\\left(\\frac{1-x+2}{2}\\right) \\\\  & ={\\left(\\frac{-x-3}{2}\\right)}^{2}\\left(\\frac{3-x}{2}\\right) \\\\  & =-\\frac{1}{8}(x+3)^{2}(x-3).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=-\\frac{1}{8}(x+3)^{2}(x-3).$"} {:db/id #edb/ref 17592186237929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23513a3f-d817-5780-894e-b04dd7e35069" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "16\\,\\text{m/s}" :db/id #edb/ref 17592186236041} {:answer/id #uuid "40ebeade-3608-5c1c-8fed-83f773b225d8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "14\\,\\text{m/s}" :db/id #edb/ref 17592186236230} {:answer/id #uuid "84b531d7-754b-5fce-853c-38846ca838de" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8\\,\\text{m/s}" :db/id #edb/ref 17592186236641} {:answer/id #uuid "90667212-a30e-5593-9bee-b6fd2e7ce544" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "12\\,\\text{m/s}" :db/id #edb/ref 17592186236735} {:answer/id #uuid "eb0f7f20-a211-5986-8f81-7531945fb465" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\,\\text{m/s}" :db/id #edb/ref 17592186237295}] :answer-field/correct {:db/id #edb/ref 17592186236641} :answer-field/id #uuid "8fa1b61e-01d5-553c-8e87-d0682f32af6f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237629}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "03e1184a-dfcf-5e57-8f84-ca58ef6a6f40" :question/math-academy-id "q-102694" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{m/s}}^{2},$ given by the function $a(t)=8-\\frac{3}{2}{t}^{2}$, where $t$ is the time in seconds. If the particle has velocity $v=-\\frac{5}{2}\\,\\text{m/s}$ when $t=0\\,\\text{s}$, calculate the speed of the particle at the moment $t=3\\,\\text{s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (8-\\frac{3}{2}{t}^{2})\\text{d}t \\\\  & =8t-\\frac{1}{2}{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=-\\frac{5}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-\\frac{5}{2} & =8(0)-\\frac{1}{2}(0)^{3}+C \\\\ -\\frac{5}{2} & =0+C \\\\ C & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=8t-\\frac{1}{2}{t}^{3}-\\frac{5}{2}.$\n\nWe evaluate the velocity at time $t=3\\,\\text{s}$:\n\n$$\n\\begin{aligned}v(3) & =8(3)-\\frac{1}{2}(3)^{3}-\\frac{5}{2} \\\\  & =24-\\frac{27}{2}-\\frac{5}{2} \\\\  & =24-16 \\\\  & =8\\,\\text{m/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $8\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186237949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b3d91a-3964-5a61-8530-cad3101f8fd6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{9x}" :db/id #edb/ref 17592186235850} {:answer/id #uuid "44abb1f0-bdc8-577c-8dd6-1440af5799c1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{2x}" :db/id #edb/ref 17592186236259} {:answer/id #uuid "50d23bcf-75e5-5737-bf34-e5970c1895a0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{-x}" :db/id #edb/ref 17592186236333} {:answer/id #uuid "c853020f-2001-5e0d-ba07-dc1fa70f24a9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186237087} {:answer/id #uuid "d663c4cc-4082-5594-85f0-9e3d21c64da4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x{e}^{-x}" :db/id #edb/ref 17592186237174}] :answer-field/correct {:db/id #edb/ref 17592186236333} :answer-field/id #uuid "74e24d8e-3039-526a-b2b3-ba2e20f2a85f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237597}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "0fbb20d5-fcba-51c4-8106-3f6884a95579" :question/math-academy-id "q-102800" :question/problem "Given that ${y}_{1}(x)={e}^{4x}$ is a solution to the equation ${y}^{″}-3{y}^{′}-4y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{4x}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{4x}+4u{e}^{4x} \\\\ {y}_{2}^{″} & ={u}^{″}{e}^{4x}+8{u}^{′}{e}^{4x}+16u{e}^{4x}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}({u}^{″}{e}^{4x}+8{u}^{′}{e}^{4x}+16u{e}^{4x})-3({u}^{′}{e}^{4x}+4u{e}^{4x})-4u{e}^{4x} & =0 \\\\ {e}^{4x}({u}^{″}+8{u}^{′}+16u-3{u}^{′}-12u-4u) & =0 \\\\ {e}^{4x}({u}^{″}+5{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${e}^{4x}\\ne 0,$ we must have\n\n$$\n{u}^{″}+5{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}=-5w.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{e}^{-5x}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{e}^{-5x}\\,⟹\\,u=-\\frac{{c}_{1}}{5}{e}^{-5x}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(x)=u{e}^{4x}$ becomes\n\n$$\n{y}_{2}(x)={e}^{4x}(-\\frac{{c}_{1}}{5}{e}^{-5x}+{c}_{2}).\n$$\n\nFinally, setting ${c}_{1}=-5$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{4x}\\cdot {e}^{-5x}={e}^{-x}.\n$$"} {:db/id #edb/ref 17592186237961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d5e141-e738-5b2a-a703-6da0a982dde0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186236350} {:answer/id #uuid "5f8ce46e-daf7-55c0-89df-337038a09ab0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186236422} {:answer/id #uuid "68ed4719-9dea-5337-9667-8f3e5657f5c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186236480} {:answer/id #uuid "7f133e8a-78f1-5235-b7a3-a3e3ba78ba25" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{\\sqrt{3}}{6}" :db/id #edb/ref 17592186236604} {:answer/id #uuid "d944ae68-297d-5663-a79f-21d577d3bda0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186237194}] :answer-field/correct {:db/id #edb/ref 17592186236350} :answer-field/id #uuid "33a55434-2f0c-5beb-95aa-d1250e59d512" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237512}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "962d8665-19cf-5669-bc0c-46b711cf96ba" :question/math-academy-id "q-102922" :question/problem "For the parametric curve \n\n$$\nx=\\operatorname{sin}2t,\\hspace{1em}y={\\operatorname{sin}}^{2}t,\\hspace{2em}0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{12}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2\\operatorname{cos}⁡2t,\\,{y}^{′}(t)=2\\operatorname{sin}⁡t\\operatorname{cos}⁡t=\\operatorname{sin}⁡2t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{\\operatorname{sin}⁡2t}{2\\operatorname{cos}⁡2t} \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡2t.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{12},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1}{2}\\operatorname{tan}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\frac{1}{2}\\operatorname{tan}⁡\\left(\\frac{\\pi }{6}\\right) \\\\  & =\\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{3} \\\\  & =\\frac{\\sqrt{3}}{6}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12419a49-8a72-5d5a-b25b-542fc5dab0b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186235925} {:answer/id #uuid "4a01b9e0-c4f0-5704-a712-09144764bfa1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186236292} {:answer/id #uuid "ba2e0013-e151-51e9-ad4a-bbb0f6be0b29" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186237009} {:answer/id #uuid "c954ba9f-6430-5221-9f47-5bf333b81728" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186237094} {:answer/id #uuid "f813ee90-74dd-524e-9db4-b206cc8dc2e5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186237382}] :answer-field/correct {:db/id #edb/ref 17592186235925} :answer-field/id #uuid "74a48016-4413-5cfa-822b-c23d4158c7f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237595}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "7720b821-7c21-51f2-9679-46c0e6df53a9" :question/math-academy-id "q-102941" :question/problem "For the parametric curve \n\n$$\nx=4\\operatorname{sin}⁡t,\\,y=\\frac{4}{\\pi }{t}^{2},\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{4}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=\\frac{8}{\\pi }t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{(\\frac{8}{\\pi }t)}{4\\operatorname{cos}⁡t} \\\\  & =\\frac{2t\\operatorname{sec}⁡t}{\\pi }.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{4},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{2\\left(\\frac{\\pi }{4}\\right)\\operatorname{sec}⁡\\left(\\frac{\\pi }{4}\\right)}{\\pi } \\\\  & =\\frac{(\\frac{\\pi }{2}\\cdot \\sqrt{2})}{\\pi } \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237964 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13c228f5-54fc-5ef5-b7fa-50841413a64b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>-2" :db/id #edb/ref 17592186235934} {:answer/id #uuid "39961e39-bc55-5d3a-92f3-aa5c6200f27f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-2<x<-\\frac{13}{7}" :db/id #edb/ref 17592186236182} {:answer/id #uuid "c4d9f260-dccd-585a-b532-95d62503e380" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<-\\frac{13}{7}" :db/id #edb/ref 17592186237062} {:answer/id #uuid "de9eb09c-253f-5040-9da9-19057889b89c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{13}{7}<x<2" :db/id #edb/ref 17592186237214} {:answer/id #uuid "e7e9442b-117a-5d25-814a-c4da5ff44b07" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0<x<2" :db/id #edb/ref 17592186237277}] :answer-field/correct {:db/id #edb/ref 17592186236182} :answer-field/id #uuid "bf1f29ff-ed10-578d-b95f-3ea67464d752" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237684}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fa64357a-e6c7-520e-a3fd-8fc5b09cc06a" :question/math-academy-id "q-102968" :question/problem "Solve the inequality ${\\log }_{7}⁡(x+2)+1<0.$" :question/worked-solution "First, we isolate the logarithm:\n\n$$\n\\begin{aligned}{\\log }_{7}⁡(x+2)+1 & <0 \\\\ {\\log }_{7}⁡(x+2) & <-1\\end{aligned}\n$$\n\nNow, we use each side of the inequality as an exponent of $7.$ We get the following:\n\n$$\n\\begin{aligned}{7}^{{\\log }_{7}⁡(x+2)} & <{7}^{-1} \\\\ x+2 & <\\frac{1}{7} \\\\ x & <-\\frac{13}{7}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithm in the original inequality. To find the domain of the logarithm, we recall that the argument of the logarithm must be positive:\n\n$$\nx+2>0\\,⇒\\,x>-2\n$$\n\nOur solution is $x<-\\frac{13}{7},$ which can be expressed as $(-\\infty ,-\\frac{13}{7}).$ Additionally, the domain of the logarithm is $x>-2,$ which can be expressed as $(-2,\\infty ).$ To find the solutions that are in the domain of the logarithm, we take the intersection:\n\n$$\n(-\\infty ,-\\frac{13}{7})\\cap (-2,\\infty )=(-2,-\\frac{13}{7})\n$$\n\nTherefore, the solution is $x\\in (-2,-\\frac{13}{7}),$ which can also be written as $-2<x<-\\frac{13}{7}.$"} {:db/id #edb/ref 17592186237965 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fade131-95a3-59ef-9154-0a3646cb9249" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le \\frac{23}{16}" :db/id #edb/ref 17592186236120} {:answer/id #uuid "347570fe-05eb-5aeb-9a37-c7c29118ce61" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le \\frac{2}{3}" :db/id #edb/ref 17592186236150} {:answer/id #uuid "7e6879c3-495b-59e2-8b10-9f7b4c2fb477" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le \\frac{23}{16}" :db/id #edb/ref 17592186236601} {:answer/id #uuid "a4f158fe-9fdc-5116-9d86-bb16d50845f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{23}{16}\\le x<\\frac{3}{2}" :db/id #edb/ref 17592186236852} {:answer/id #uuid "e3a72748-3810-5229-90e4-7f3b94f0b440" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\le x<\\frac{3}{2}" :db/id #edb/ref 17592186237251}] :answer-field/correct {:db/id #edb/ref 17592186236601} :answer-field/id #uuid "4853ea57-33fc-528e-a33f-9d2826fd60dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237530}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "eef672bc-6f7f-5228-bdaa-a70d719658a9" :question/math-academy-id "q-102970" :question/problem "Solve the inequality ${\\log }_{2}⁡(3-2x)+3\\ge 0.$" :question/worked-solution "First, we isolate the logarithm:\n\n$$\n\\begin{aligned}{\\log }_{2}⁡(3-2x)+3 & \\ge 0 \\\\ {\\log }_{2}⁡(3-2x) & \\ge -3\\end{aligned}\n$$\n\nNow, we use each side of the inequality as an exponent of $2.$ We get the following:\n\n$$\n\\begin{aligned}{2}^{{\\log }_{2}⁡(3-2x)} & \\ge {2}^{-3} \\\\ 3-2x & \\ge \\frac{1}{8} \\\\ -2x & \\ge -\\frac{23}{8} \\\\ x & \\le \\frac{23}{16}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithm in the original inequality. To find the domain of the logarithm, we recall that the argument of the logarithm must be positive:\n\n$$\n3-2x>0\\,⇒\\,x<\\frac{3}{2}\n$$\n\nOur solution is $x\\le \\frac{23}{16},$ which can be expressed as $(-\\infty ,\\frac{23}{16}].$ Additionally, the domain of the logarithm is $x<\\frac{3}{2},$ which can be expressed as $(-\\infty ,\\frac{3}{2}).$ To find the solutions that are in the domain of the logarithm, we take the intersection:\n\n$$\n(-\\infty ,\\frac{23}{16}]\\cap (-\\infty ,\\frac{3}{2})=(-\\infty ,\\frac{23}{16}]\n$$\n\nTherefore, the solution is $x\\in (-\\infty ,\\frac{23}{16}],$ which can also be written as $x\\le \\frac{23}{16}.$"} {:db/id #edb/ref 17592186237966 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1574e919-b2be-546d-b6a7-6cbf6dc388a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x\\le \\frac{{e}^{2}-5}{3}" :db/id #edb/ref 17592186235947} {:answer/id #uuid "3883d481-91f1-5e02-9960-1395adfba8c8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{5}{3}<x\\le \\frac{{e}^{2}-5}{3}" :db/id #edb/ref 17592186236176} {:answer/id #uuid "62354c8d-503a-598c-905c-f51516c6a0ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>-\\frac{5}{3}" :db/id #edb/ref 17592186236440} {:answer/id #uuid "e19e27fc-e54d-53fb-8ce5-52127014f9a1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\le x<\\frac{5}{3}" :db/id #edb/ref 17592186237229} {:answer/id #uuid "fe08de8c-e6c5-5cf1-96bf-bd7d36905cf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\le \\frac{{e}^{2}-5}{3}" :db/id #edb/ref 17592186237433}] :answer-field/correct {:db/id #edb/ref 17592186236176} :answer-field/id #uuid "d7f9097d-a08e-5cdd-aa54-f90bd4339f5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237717}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "afba54b2-08f2-5dde-83ef-3e6f5311fba9" :question/math-academy-id "q-102975" :question/problem "Solve the inequality $\\operatorname{ln}⁡(3x+5)-2\\le 0.$" :question/worked-solution "First, we isolate the logarithm:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(3x+5)-2 & \\le 0 \\\\ \\operatorname{ln}⁡(3x+5) & \\le 2\\end{aligned}\n$$\n\nNow, we use each side of the inequality as an exponent of $e.$ We get the following:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡(3x+5)} & \\le {e}^{2} \\\\ 3x+5 & \\le {e}^{2} \\\\ 3x & \\le {e}^{2}-5 \\\\ x & \\le \\frac{{e}^{2}-5}{3}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithm in the original inequality. To find the domain of the logarithm, we recall that the argument of the logarithm must be positive:\n\n$$\n3x+5>0\\,⇒\\,x>-\\frac{5}{3}\n$$\n\nOur solution is $x\\le \\frac{{e}^{2}-5}{3},$ which can be expressed as $(-\\infty ,\\frac{{e}^{2}-5}{3}].$ Additionally, the domain of the logarithm is $x>-\\frac{5}{3},$ which can be expressed as $(-\\frac{5}{3},\\infty ).$ To find the solutions that are in the domain of the logarithm, we take the intersection:\n\n$$\n(-\\infty ,\\frac{{e}^{2}-5}{3}]\\cap (-\\frac{5}{3},\\infty )=(-\\frac{5}{3},\\frac{{e}^{2}-5}{3}]\n$$\n\nTherefore, the solution is $$\n\\displaystyle x\\in (-\\frac{5}{3},\\frac{{e}^{2}-5}{3}],\n$$ which can also be written as $-\\frac{5}{3}<x\\le \\frac{{e}^{2}-5}{3}.$"} {:db/id #edb/ref 17592186237968 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "482cd0a2-002c-5095-add4-19d1f47e0cf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}<x<4" :db/id #edb/ref 17592186236282} {:answer/id #uuid "6dbae0dc-6caa-5073-8650-f067ac0ff2fd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge \\frac{8}{17}" :db/id #edb/ref 17592186236511} {:answer/id #uuid "8b1eee5e-fdc1-544c-94c6-0705585f9cdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8}{17}\\le x<4" :db/id #edb/ref 17592186236687} {:answer/id #uuid "8b89bcda-c55a-5aa3-9d94-3e1c14e7b4f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "0\\le x<\\frac{1}{4}" :db/id #edb/ref 17592186236694} {:answer/id #uuid "e54038fa-fc46-5181-b23a-81dbd3b033a6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}<x\\le \\frac{8}{17}" :db/id #edb/ref 17592186237257}] :answer-field/correct {:db/id #edb/ref 17592186236687} :answer-field/id #uuid "f408d105-b906-5018-b063-1b15b4424201" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237755}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "c5506f6d-7ff6-5f71-bdbd-49c5af679dfe" :question/math-academy-id "q-102979" :question/problem "Solve the inequality ${\\log }_{2}⁡(4x-1)\\ge {\\log }_{2}⁡(1-\\frac{x}{4}).$" :question/worked-solution "We use each side of the inequality as an exponent of $2.$ This gives the following:\n\n$$\n\\begin{aligned}{2}^{{\\log }_{2}⁡(4x-1)} & \\ge {2}^{{\\log }_{2}⁡(1-x/4)} \\\\ 4x-1 & \\ge 1-\\frac{x}{4} \\\\ \\frac{17x}{4} & \\ge 2 \\\\ x & \\ge \\frac{8}{17}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:\n\n$$\n\\begin{aligned}4x-1 & >0 & ⇒ &  & x & >\\frac{1}{4} \\\\ 1-\\frac{x}{4} & >0 & ⇒ &  & x & <4\\end{aligned}\n$$\n\nOur solution is $x\\ge \\frac{8}{17},$ which can be expressed as $[\\frac{8}{17},\\infty ).$ Additionally, the domains of the logarithms are $x>\\frac{1}{4}$ and $x<4,$ which can be expressed as $(\\frac{1}{4},\\infty )$ and $(-\\infty ,4)$ respectively. To find the solutions that are in the domains of the logarithms, we take the intersection:\n\n$$\n[\\frac{8}{17},\\infty )\\cap (\\frac{1}{4},\\infty )\\cap (-\\infty ,4)=[\\frac{8}{17},4)\n$$\n\nTherefore, the solution is $x\\in [\\frac{8}{17},4),$ which can also be written as $\\frac{8}{17}\\le x<4.$"} {:db/id #edb/ref 17592186237969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168635be-3123-5b8e-b823-3bb0194cdff5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>\\frac{5}{2}" :db/id #edb/ref 17592186235957} {:answer/id #uuid "1a6db617-7907-5e0a-8340-64535028ff2e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6<x<-\\frac{7}{4}" :db/id #edb/ref 17592186235980} {:answer/id #uuid "64250794-42f4-5178-94b3-0f446e648451" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{7}{4}<x<\\frac{5}{2}" :db/id #edb/ref 17592186236452} {:answer/id #uuid "8f7ee771-c42e-5d45-b869-baa7d02df889" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>-6" :db/id #edb/ref 17592186236727} {:answer/id #uuid "94bdbffe-965c-592d-87ea-2c750f8f6bf6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-6<x<\\frac{5}{2}" :db/id #edb/ref 17592186236760}] :answer-field/correct {:db/id #edb/ref 17592186235957} :answer-field/id #uuid "e8603b47-816a-5c75-84c7-6c6b9c6dffad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237735}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "577456f1-a6cb-5aa6-a807-7ec1c9099cfe" :question/math-academy-id "q-102982" :question/problem "Solve the inequality $\\operatorname{log}⁡(4x+7)>\\operatorname{log}⁡(2x-5).$" :question/worked-solution "We use each side of the inequality as an exponent of $10.$ This gives the following:\n\n$$\n\\begin{aligned}{10}^{\\operatorname{log}⁡(4x+7)} & >{10}^{\\operatorname{log}⁡(2x-5)} \\\\ 4x+7 & >2x-5 \\\\ 2x & >-12 \\\\ x & >-6\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:\n\n$$\n\\begin{aligned}4x+7 & >0 & ⇒ &  & x & >-\\frac{7}{4} \\\\ 2x-5 & >0 & ⇒ &  & x & >\\frac{5}{2}\\end{aligned}\n$$\n\nOur solution is $x>-6,$ which can be expressed as $(-6,\\infty ).$ Additionally, the domains of the logarithms are $x>-\\frac{7}{4}$ and $x>\\frac{5}{2},$ which can be expressed as $(-\\frac{7}{4},\\infty )$ and $(\\frac{5}{2},\\infty )$ respectively. To find the solutions that are in the domains of the logarithms, we take the intersection:\n\n$$\n(-6,\\infty )\\cap (-\\frac{7}{4},\\infty )\\cap (\\frac{5}{2},\\infty )=(\\frac{5}{2},\\infty )\n$$\n\nTherefore, the solution is $x\\in (\\frac{5}{2},\\infty ),$ which can also be written as $x>\\frac{5}{2}.$"} {:db/id #edb/ref 17592186237970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af17f28-ca55-5adb-8311-df988bf51baa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x\\ge \\frac{1}{4}" :db/id #edb/ref 17592186236085} {:answer/id #uuid "641a31c3-3532-51de-9082-710291526d68" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x>-9" :db/id #edb/ref 17592186236451} {:answer/id #uuid "6dffc1d3-b090-59ed-8642-35c2ed480fd7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-9<x\\le \\frac{1}{4}" :db/id #edb/ref 17592186236514} {:answer/id #uuid "99a7a196-69dc-55a2-80f9-d16eca24a604" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{4}\\le x<\\frac{10}{3}" :db/id #edb/ref 17592186236784} {:answer/id #uuid "a9548c33-e428-5968-9b09-918a3bc51fe6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x<\\frac{10}{3}" :db/id #edb/ref 17592186236883}] :answer-field/correct {:db/id #edb/ref 17592186236784} :answer-field/id #uuid "c73b62c4-ce92-5ba0-ac31-1fd0f58765f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237693}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "4d830393-815e-5327-a97f-2d418e68b4e5" :question/math-academy-id "q-102983" :question/problem "Solve the inequality $\\operatorname{log}⁡(10-3x)\\le \\operatorname{log}⁡(x+9).$" :question/worked-solution "We use each side of the inequality as an exponent of $10.$ This gives the following:\n\n$$\n\\begin{aligned}{10}^{\\operatorname{log}⁡(10-3x)} & \\le {10}^{\\operatorname{log}⁡(x+9)} \\\\ 10-3x & \\le x+9 \\\\ -4x & \\le -1 \\\\ x & \\ge \\frac{1}{4}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:\n\n$$\n\\begin{aligned}10-3x & >0 & ⇒ &  & x & <\\frac{10}{3} \\\\ x+9 & >0 & ⇒ &  & x & >-9\\end{aligned}\n$$\n\nOur solution is $x\\ge \\frac{1}{4},$ which can be expressed as $[\\frac{1}{4},\\infty ).$ Additionally, the domains of the logarithms are $x<\\frac{10}{3}$ and $x>-9,$ which can be expressed as $(-\\infty ,\\frac{10}{3})$ and $(-9,\\infty )$ respectively. To find the solutions that are in the domains of the logarithms, we take the intersection:\n\n$$\n[\\frac{1}{4},\\infty )\\cap (-\\infty ,\\frac{10}{3})\\cap (-9,\\infty )=[\\frac{1}{4},\\frac{10}{3})\n$$\n\nTherefore, the solution is $x\\in [\\frac{1}{4},\\frac{10}{3}),$ which can also be written as $\\frac{1}{4}\\le x<\\frac{10}{3}.$"} {:db/id #edb/ref 17592186237972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24f82c23-dce9-5d63-9fc6-34e72a047a9b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\frac{1}{16}(2+\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186236056} {:answer/id #uuid "81f69b5d-b8d0-5e49-ab9e-1569317da21b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186236628} {:answer/id #uuid "979a582b-a8de-5112-b355-8ab7f8c9af85" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\frac{1}{16}(1-2\\operatorname{cos}⁡(4t))" :db/id #edb/ref 17592186236778} {:answer/id #uuid "e4bb209f-e09e-5bb4-a6dc-5604cdd3f64a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\frac{1}{16}(2-\\operatorname{sin}⁡(4t))" :db/id #edb/ref 17592186237255} {:answer/id #uuid "ed4551c6-29d7-5e6b-9e9c-f0d16a2fdd95" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x(t)=\\frac{1}{16}(1+\\operatorname{sin}⁡(4t))" :db/id #edb/ref 17592186237314}] :answer-field/correct {:db/id #edb/ref 17592186236628} :answer-field/id #uuid "2297541f-d883-54e0-b85f-33a2ccfd6866" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237482}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "1703b9b0-ea5e-5791-98c3-9b2cad2b5e29" :question/math-academy-id "q-102994" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=\\operatorname{cos}⁡(4t)$, where $t\\ge 0$ is the time. If the particle has position $x=\\frac{1}{16}$ and velocity $v=\\frac{1}{4}$ when $t=\\frac{\\pi }{8}$, calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡(4t)\\text{d}t \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡(4t)+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $$\n\\displaystyle v\\left(\\frac{\\pi }{8}\\right)=\\frac{1}{4}.\n$$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{1}{4}\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{8})+C \\\\ \\frac{1}{4} & =\\frac{1}{4}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)+C \\\\ \\frac{1}{4} & =\\frac{1}{4}+C \\\\ C & =0.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=\\frac{1}{4}\\operatorname{sin}⁡(4t).$ \n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int \\frac{1}{4}\\operatorname{sin}⁡(4t)\\text{d}t \\\\  & =-\\frac{1}{16}\\operatorname{cos}⁡(4t)+K\\end{aligned}\n$$\n\nTo determine $K,$ we use the fact that $$\n\\displaystyle x\\left(\\frac{\\pi }{8}\\right)=\\frac{1}{16}.\n$$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{16} & =-\\frac{1}{16}\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{8})+C \\\\ \\frac{1}{16} & =-\\frac{1}{16}\\operatorname{cos}⁡\\left(\\frac{\\pi }{2}\\right)+C \\\\ \\frac{1}{16} & =0+C \\\\ K & =\\frac{1}{16}.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\n\\begin{aligned}x(t) & =-\\frac{1}{16}\\operatorname{cos}⁡(4t)+\\frac{1}{16} \\\\  & =\\frac{1}{16}(1-\\operatorname{cos}⁡(4t))\\end{aligned}\n$$"} {:db/id #edb/ref 17592186237976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "753c6bc4-8bc9-5bc4-9b17-0e7b5a4fa7a4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461243} {:answer/id #uuid "8c9cf866-8180-5637-bc9a-8cedd8a64adf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461244}] :answer-field/correct {:db/id #edb/ref 17592186461244} :answer-field/id #uuid "f5e3870e-c98a-5c4e-b773-7c15a2ad964f" :answer-field/key "The series converges at $x=2$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462375} {:answer-field/choices [{:answer/id #uuid "3f022f9a-3577-5071-863a-b61b2a5743ed" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461245} {:answer/id #uuid "bd2c4a3d-ac96-5582-8173-7504b99c0b74" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461246}] :answer-field/correct {:db/id #edb/ref 17592186461246} :answer-field/id #uuid "96a988df-c939-58e6-bed2-1175955dc667" :answer-field/key "The series converges at $x=1$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462376} {:answer-field/choices [{:answer/id #uuid "895d153f-7cd2-5072-b3ca-0e8cae1d45a3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186461247} {:answer/id #uuid "7de099d9-85b8-5974-a14f-c84279cd5b13" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186461248}] :answer-field/correct {:db/id #edb/ref 17592186461247} :answer-field/id #uuid "fbcaf317-42fe-583d-9d07-58b3779f0c9b" :answer-field/key "The series converges at $x=4$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186462377}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "93c0e2ef-7f5e-5e9b-aac8-f784a726661a" :question/math-academy-id "q-103169" :question/problem "The power series $$\n\\displaystyle {\\sum }_{n=0}^{\\infty }{a}_{n}{(x-\\frac{3}{2})}^{n}\n$$ converges at  $x=-1.$ Which of the following **must** be true?\n\nSelect all that apply." :question/worked-solution "The center of the expansion is $x=\\frac{3}{2},$ and since the series is convergent for $x=-1,$ this means that the radius of convergence $R$ is *at least* $\\frac{5}{2},$ i.e., $R\\ge \\frac{5}{2}.$ So, the series is convergent for every point in the interval $[-1,4).$ However, we know nothing about the convergence of the series at any point outside the interval $[-1,4).$\n\n![](images/d0/d01788625c7b429a15caf441c6a651fa92281dc544f99c544bdb12f9d8b6f032.png)\n\n \n\nWith this in mind, let's check each of our statements.\n\n- Statement “The series converges at $x=2$” is true. Since $2\\in [-1,4),$ the series is convergent at $x=2.$\n\n- Statement “The series converges at $x=1$” is true. Since $1\\in [-1,4),$ the series is convergent at $x=1.$\n\n- Statement “The series converges at $x=4$” is not necessarily true. The given information guarantees convergence for points strictly between $-1$ and $4$, but it does not guarantee convergence at $x=4.$\n\nTherefore, the correct answer is “The series converges at $x=2$”; “The series converges at $x=1$” only."} {:db/id #edb/ref 17592186237987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d62743dd-6b08-537d-99a1-950e0129a65b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437312} {:answer/id #uuid "ca6522af-a085-5421-9c2f-2778b4ad8bee" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437313}] :answer-field/correct {:db/id #edb/ref 17592186437313} :answer-field/id #uuid "7795f1b0-ab3b-568b-86a9-79ad8f59e765" :answer-field/key "The domain of the function is all real numbers except $x=\\frac{\\pi }{2}+n\\pi $" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438685} {:answer-field/choices [{:answer/id #uuid "62cebc6c-fb9e-5e2f-a4dc-892c8730f19c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437314} {:answer/id #uuid "7c865e34-f1b0-5ac5-896e-1465217ac529" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437315}] :answer-field/correct {:db/id #edb/ref 17592186437314} :answer-field/id #uuid "3a680935-e5c9-5bc1-9251-f1ef3483d3ef" :answer-field/key "The function has zeros at $x=\\frac{\\pi }{2}+n\\pi $ for any integer $n$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438686} {:answer-field/choices [{:answer/id #uuid "a1a71c62-3700-5f58-82ca-cdcc35abc891" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437316} {:answer/id #uuid "f8103b2e-08e3-58da-8184-32ba8bfa5da1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437317}] :answer-field/correct {:db/id #edb/ref 17592186437316} :answer-field/id #uuid "895e53e0-0454-5c88-bc63-752876bb1bff" :answer-field/key "The range of the function is $y\\in (-\\frac{\\pi }{4},\\frac{\\pi }{4})$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438687}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "2215b590-8140-5323-92bf-8ae24e1b7bb4" :question/math-academy-id "q-103289" :question/problem "Which of the following statements are true regarding the function $y=\\operatorname{tan}⁡x?$ Assume that $n$ is an integer.\n\nSelect all that apply." :question/worked-solution "Let's plot the graph of $y=\\tan ⁡x.$\n\n![](images/73/732955302ca49a41f6c43cf242d7c869e630e88d804c4b56a5beb3b081f2d230.png)\n\nLet's go through each statement.\n\n- Statement “The domain of the function is all real numbers except $x=\\frac{\\pi }{2}+n\\pi $” is true. The function is defined everywhere, except where $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement “The function has zeros at $x=\\frac{\\pi }{2}+n\\pi $ for any integer $n$” is false. The zeros occur at $x=0,\\pm \\pi ,\\pm 2\\pi ,…,$ which can be written as $x=n\\pi .$\n\n- Statement “The range of the function is $y\\in (-\\frac{\\pi }{4},\\frac{\\pi }{4})$” is false. The function takes values on all the real numbers, hence the range is $y\\in (-\\infty ,\\infty ).$\n\nSo, the correct answer is “The domain of the function is all real numbers except $x=\\frac{\\pi }{2}+n\\pi $” only."} {:db/id #edb/ref 17592186237989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36b1a6cb-d9b2-5499-9bed-f6591d1d13f1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437318} {:answer/id #uuid "6d863ba2-7deb-5dbd-a418-153187c043da" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437319}] :answer-field/correct {:db/id #edb/ref 17592186437318} :answer-field/id #uuid "b085e966-e913-5fdf-8891-5d9c59a6837a" :answer-field/key "The vertical asymptotes of the function are $x=2n\\pi $" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438688} {:answer-field/choices [{:answer/id #uuid "dff2e6d4-d7e6-5cbf-8bd1-6ae518e69246" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437320} {:answer/id #uuid "4419d897-28a5-5bc9-9d30-6eda47c75fc6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437321}] :answer-field/correct {:db/id #edb/ref 17592186437321} :answer-field/id #uuid "772ee15e-615c-53a7-b9f0-b705e3e4cbdd" :answer-field/key "Its graph passes through the point $(0,0)$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438689} {:answer-field/choices [{:answer/id #uuid "e2a96a27-f532-56b1-b071-6cec50f8503f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "false" :db/id #edb/ref 17592186437322} {:answer/id #uuid "d47830c6-0653-572d-a8a7-41bbd043f9fe" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "true" :db/id #edb/ref 17592186437323}] :answer-field/correct {:db/id #edb/ref 17592186437323} :answer-field/id #uuid "98d41179-1f25-5250-b6ec-ea5a42b8c13b" :answer-field/key "$\\tan ⁡(x-\\frac{\\pi }{6})=\\tan ⁡(x+\\frac{5\\pi }{6})$" :answer-field/type {:db/id #edb/ref 17592186408166} :db/id #edb/ref 17592186438690}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "6f5925ee-40c3-50af-9950-ecf1ea188724" :question/math-academy-id "q-103295" :question/problem "Which of the following statements are true regarding the function $y=\\tan ⁡x?$ Assume that $n$ represents any integer.\n\nSelect all that apply." :question/worked-solution "Let's recall the graph of $y=\\tan ⁡x.$\n\n![](images/c2/c2d0606829588b01f6cba2fa4785b201c47a6d9ffa325d54e64544c9769d7e4a.png)\n\nLet's examine each statement.\n\n- Statement “The vertical asymptotes of the function are $x=2n\\pi $” is false. The function has an asymptote at $x=\\frac{\\pi }{2}$ and the period is $\\pi .$ Therefore, the asymptotes occur at $x=\\frac{\\pi }{2}+n\\pi .$\n\n- Statement “Its graph passes through the point $(0,0)$” is true. Indeed, the graph of the function passes through the point $(0,0).$\n\n- Statement $$\n\\displaystyle \\tan ⁡(x-\\frac{\\pi }{6})=\\tan ⁡(x+\\frac{5\\pi }{6})\n$$ is true. The function $y=\\tan ⁡x$ has period $\\pi .$ So, $$\n\\displaystyle \\tan ⁡(x-\\frac{\\pi }{6})=\\tan ⁡(x-\\frac{\\pi }{6}+\\pi )=\\tan ⁡(x+\\frac{5\\pi }{6}).\n$$\n\nSo, the correct answer is “Its graph passes through the point $(0,0)$”; $$\n\\displaystyle \\tan ⁡(x-\\frac{\\pi }{6})=\\tan ⁡(x+\\frac{5\\pi }{6})\n$$ only."} {:db/id #edb/ref 17592186237995 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e87e22-cacf-5cc1-843a-19a2ec716dd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,4)" :db/id #edb/ref 17592186235842} {:answer/id #uuid "9bf57106-342d-514e-a74e-99b75b0d46b2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-3)" :db/id #edb/ref 17592186236794} {:answer/id #uuid "b42ec22d-1cc8-5f58-a1ba-e358d1ca91ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(5,0)" :db/id #edb/ref 17592186236957} {:answer/id #uuid "d3abaa23-9d60-5806-a662-2863fbee3b17" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-4)" :db/id #edb/ref 17592186237154} {:answer/id #uuid "d7213994-cc1a-5ec6-97eb-cbb2a482ba40" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,5)" :db/id #edb/ref 17592186237180}] :answer-field/correct {:db/id #edb/ref 17592186237180} :answer-field/id #uuid "4a83f623-00a6-570a-9332-d2e028925610" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237537}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "206c0ca2-0647-550d-b02a-fa011bdbda18" :question/math-academy-id "q-103331" :question/problem "Find where the tangent to the curve $y=\\frac{1}{x}+3$ at the point $(1,4)$ intersects the $y$-axis." :question/worked-solution "Let $f(x)=\\frac{1}{x}+3.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{x}+3)=-\\frac{1}{{x}^{2}}\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\nm={f}^{′}(1)=-\\frac{1}{(1)^{2}}=-1.\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-(x-1) \\\\ y & =-x+1+4 \\\\ y & =5-x.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $y$-axis, we set $x=0$ and solve:\n\n$$\n\\begin{aligned}y & =5-0 \\\\ y & =5\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(0,5).$"} {:db/id #edb/ref 17592186237997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06546274-02e5-5fc0-8fae-4f46fc931bd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡x=c" :db/id #edb/ref 17592186235841} {:answer/id #uuid "0b8f1609-767c-5a5f-911b-16174449c210" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(xy)-\\operatorname{ln}⁡(xy)=c" :db/id #edb/ref 17592186235877} {:answer/id #uuid "4c89f096-4fb6-5556-9833-c93820386b55" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡(xy)=c" :db/id #edb/ref 17592186236303} {:answer/id #uuid "b65d8303-f8ca-518f-8242-e51a024da3b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "xy\\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡(xy)=c" :db/id #edb/ref 17592186236971} {:answer/id #uuid "c0176ae2-6815-557e-8201-2d38ac9d6469" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "y\\operatorname{cos}⁡(xy)-\\operatorname{ln}⁡y=c" :db/id #edb/ref 17592186237039}] :answer-field/correct {:db/id #edb/ref 17592186236303} :answer-field/id #uuid "9d1c0326-b97a-59e1-9914-e218c73cd1fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237649}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2b34dbbc-c99b-5448-a113-40f6cf7c0d24" :question/math-academy-id "q-103341" :question/problem "Find the general solution of the exact differential equation\n\n$$\n(y\\operatorname{cos}⁡(xy)-\\frac{1}{x})\\text{d}x+(x\\operatorname{cos}⁡(xy)-\\frac{1}{y})\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=y\\operatorname{cos}⁡(xy)-\\frac{1}{x}$ and $Q(x,y)=x\\operatorname{cos}⁡(xy)-\\frac{1}{y}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (y\\operatorname{cos}⁡(xy)-\\frac{1}{x})\\text{d}x+f(y) \\\\  & =\\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡x+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x\\operatorname{cos}⁡(xy)-\\frac{1}{y})\\text{d}y+g(x) \\\\  & =\\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡y+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=-\\operatorname{ln}⁡x,\\,f(y)=-\\operatorname{ln}⁡y.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡x-\\operatorname{ln}⁡y & =c \\\\ \\operatorname{sin}⁡(xy)-\\operatorname{ln}⁡(xy) & =c.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "116ed1cb-cee2-51fa-b983-0d044a80cbf1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3{x}^{2}+\\ln ⁡|3x|+C" :db/id #edb/ref 17592186235911} {:answer/id #uuid "335087d8-fab5-5522-94d1-93d0d9655755" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}{x}^{2}-\\ln ⁡|3x|+C" :db/id #edb/ref 17592186236140} {:answer/id #uuid "a77100c8-1980-51d5-9cdf-fe3f251c5336" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}{x}^{2}-3\\ln ⁡|x|+C" :db/id #edb/ref 17592186236865} {:answer/id #uuid "b3489f8b-789f-5fa4-bb29-debd57283e3b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}{x}^{2}-\\ln ⁡|3x|+C" :db/id #edb/ref 17592186236952} {:answer/id #uuid "e22f3892-01f6-5e59-8632-9444a5c795ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}{x}^{2}+3\\ln ⁡|x|+C" :db/id #edb/ref 17592186237233}] :answer-field/correct {:db/id #edb/ref 17592186236865} :answer-field/id #uuid "82b1ee9b-e334-5197-b749-02b7be8b5397" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237614}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "d804d2ab-c752-5a11-a731-3f70b2a95171" :question/math-academy-id "q-103374" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{3{x}^{2}-6}{2x}\\,dx.\n$$" :question/worked-solution "Applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-6}{2x}\\,\\text{d}x & =\\int (\\frac{3{x}^{2}}{2x}-\\frac{3}{x})\\text{d}x \\\\  & =\\int (\\frac{3}{2}x-\\frac{3}{x})\\text{d}x \\\\  & =\\frac{3}{2}\\int x\\,\\text{d}x-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\frac{3}{4}{x}^{2}-3\\ln ⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238002 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35399b5c-61ff-5ca5-be4f-4c1abe0d88b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{3}{2x}+3\\ln ⁡(K|x|)" :db/id #edb/ref 17592186236154} {:answer/id #uuid "6a533669-c40f-5a00-940e-dadb7f469489" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{3}{2x}+\\ln ⁡(3K|x|)" :db/id #edb/ref 17592186236488} {:answer/id #uuid "7fce5c0b-fbff-51c0-9373-cb763d114999" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\frac{3}{2x}+3\\ln ⁡(K|x|)" :db/id #edb/ref 17592186236610} {:answer/id #uuid "8f5b6f3b-c7d8-5d5b-a12e-71a1116a0a5a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{9}{4x}+3\\ln ⁡(K|x|)" :db/id #edb/ref 17592186236725} {:answer/id #uuid "c8374c9a-abe6-515a-a258-f3f08a5ed775" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-\\frac{9}{4x}+\\ln ⁡(3K|x|)" :db/id #edb/ref 17592186237086}] :answer-field/correct {:db/id #edb/ref 17592186236725} :answer-field/id #uuid "356e1270-3ef3-5f47-b27e-aac16e288e4a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237514}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "12ca3bb3-d360-53db-af13-e44e401ba3a0" :question/math-academy-id "q-103375" :question/problem "What is the antiderivative of ${(1+\\frac{3}{2x})}^{2}?$" :question/worked-solution "Expanding the binomial and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{3}{2x})}^{2}\\text{d}x & =\\int (1+\\frac{3}{x}+\\frac{9}{4{x}^{2}})\\text{d}x \\\\  & =\\int \\text{d}x+3\\int \\frac{1}{x}\\,\\text{d}x+\\frac{9}{4}\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & =x+3\\ln ⁡|x|+\\frac{9{x}^{-2+1}}{4(-2+1)}+C \\\\  & =x+3\\ln ⁡|x|-\\frac{9}{4x}+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=3\\ln ⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $3\\ln ⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int {(1+\\frac{3}{2x})}^{2}\\text{d}x & =x-\\frac{9}{4x}+3\\ln ⁡|x|+3\\ln ⁡K \\\\  & =x-\\frac{9}{4x}+3(\\ln ⁡|x|+\\ln ⁡K) \\\\  & =x-\\frac{9}{4x}+3\\ln ⁡(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238009 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fb0cd4-c595-52e2-b7b8-f5921f1664ef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+y=-4" :db/id #edb/ref 17592186235858} {:answer/id #uuid "339a3f8d-ec60-53c0-b70c-2ad1dcb8beef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x-2y=-10" :db/id #edb/ref 17592186236143} {:answer/id #uuid "bf918fbb-8ce0-57e4-ba33-761c02c1700f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x+2y=2" :db/id #edb/ref 17592186237036} {:answer/id #uuid "cd49d0d7-034b-5674-9bb1-76d06ca38e03" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x-2y=-6" :db/id #edb/ref 17592186237119} {:answer/id #uuid "f90a028f-fc8e-54be-b155-96319e83f2b0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3x+2y=-2" :db/id #edb/ref 17592186237390}] :answer-field/correct {:db/id #edb/ref 17592186237390} :answer-field/id #uuid "be8d6f01-6ff4-56d4-9645-4daf3987bc75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237683}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5c2cb582-f805-50f4-ae14-8678782b90fa" :question/math-academy-id "q-103449" :question/problem "Find the equation of the line that passes through the point $(-2,2)$ and is perpendicular to the line passing through the points $(1,-1)$ and $(4,1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,-1)$ and $(4,1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-(-1)}{4-1} \\\\  & =\\frac{1+1}{4-1} \\\\  & =\\frac{2}{3}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot \\left(\\frac{2}{3}\\right)=-1\\,⇒\\,m=-\\frac{3}{2}.\n$$\n\nWe know that the line passes through the point $(-2,2).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =-\\frac{3}{2}(x-(-2)) \\\\ y-2 & =-\\frac{3}{2}(x+2) \\\\ y-2 & =-\\frac{3}{2}x-3 \\\\ y & =-\\frac{3}{2}x-1\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{3}{2}x-1 \\\\ \\frac{3}{2}x+y & =-1 \\\\ 2\\cdot (\\frac{3}{2}x+y) & =2\\cdot (-1) \\\\ 3x+2y & =-2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0de724df-8b1c-5535-8e44-daf76049ece3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1" :db/id #edb/ref 17592186235891} {:answer/id #uuid "23b48bbe-ffa7-54a8-99f9-dc3950946ae0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186236047} {:answer/id #uuid "4e607467-80e3-56bc-b439-ef24f59e6ec4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186236319} {:answer/id #uuid "b66f9765-eff6-521c-bc5e-6e7d22591dfd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-3" :db/id #edb/ref 17592186236972} {:answer/id #uuid "ce4263ad-8b05-53b5-bdc9-5ccb768cb0a7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3" :db/id #edb/ref 17592186237125}] :answer-field/correct {:db/id #edb/ref 17592186236319} :answer-field/id #uuid "8fef744c-c73f-546c-b977-0ab52629ab8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237630}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "602176f6-b1e0-573b-b42a-73b7532c22d1" :question/math-academy-id "q-103543" :question/problem "Find the slope of the normal line to the curve $y=\\frac{2}{{x}^{5}}+7x$ at the point $(1,9).$" :question/worked-solution "Let $f(x)=\\frac{2}{{x}^{5}}+7x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{5}}+7x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-5}+7x) \\\\  & =-10{x}^{-6}+7.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=-10(1)^{-6}+7=-3.\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=\\frac{1}{3}.\n$$"} {:db/id #edb/ref 17592186238029 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4abe304b-eb2b-5d95-b662-98795ce766a8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}{x}^{3/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236297} {:answer/id #uuid "6d00a003-0364-5b3a-b73d-cf2606acaf82" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{5}{2}{x}^{5/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236506} {:answer/id #uuid "b7b12b3f-b8dd-53cd-a79b-4f8d64e6c135" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186236984} {:answer/id #uuid "c71fc3c7-fa6d-5f20-8988-65604e335a7c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}{x}^{3/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186237078} {:answer/id #uuid "ca4ffb28-67bb-5e22-a3dc-17c627b249f7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}{x}^{5/2}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186237101}] :answer-field/correct {:db/id #edb/ref 17592186236984} :answer-field/id #uuid "67ce5cc2-6611-553c-af07-6c3510863b9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237573}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "1a6388af-23c9-54c5-98cc-a8fb2fcf5235" :question/math-academy-id "q-103593" :question/problem "Calculate $$\n\\displaystyle \\int ({x}^{3/2}+\\frac{1}{2}{x}^{-1})\\,\\text{d}x.\n$$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{3/2}+\\frac{1}{2}{x}^{-1})\\,\\text{d}x=\\int {x}^{3/2}\\,\\text{d}x+\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{3/2}\\,\\text{d}x+\\frac{1}{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{3/2+1}}{\\frac{3}{2}+1}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{2}{5}{x}^{5/2}+\\frac{1}{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13a38b29-85ad-5374-bea2-88f31b9b11e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}+\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186235933} {:answer/id #uuid "1b8e5d23-edd6-5e66-a10e-e0cae75992cb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{x}^{2}-\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186235989} {:answer/id #uuid "5cf58edf-2b25-5403-987e-544048dac46f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186236402} {:answer/id #uuid "b6e0bbcf-015a-5615-9e6f-2fe0003bc2eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x+\\operatorname{ln}⁡(|x|+K)" :db/id #edb/ref 17592186236976} {:answer/id #uuid "d4375fca-91f8-5c71-956b-c92f62e78b35" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2x-\\operatorname{ln}⁡(K|x|)" :db/id #edb/ref 17592186237158}] :answer-field/correct {:db/id #edb/ref 17592186237158} :answer-field/id #uuid "0ed20a98-5dd7-5597-b788-a5b92556c748" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237454}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "de2d042e-94ce-510a-ada4-3da6c7a2612d" :question/math-academy-id "q-103605" :question/problem "What is the antiderivative of $\\frac{2x-1}{x}?$" :question/worked-solution "We separate the integrand into the sum of two fractions so that we can simplify each term. So, we get\n\n$$\n\\begin{aligned}\\int \\frac{2x-1}{x}\\,\\text{d}x & =\\int (\\frac{2x}{x}-\\frac{1}{x})\\,\\text{d}x \\\\  & =\\int (2-\\frac{1}{x})\\,\\text{d}x \\\\  & =2\\int \\,\\text{d}x-\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =2x-\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\operatorname{ln}⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\operatorname{ln}⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int \\frac{2x-1}{x}\\,\\text{d}x & =2x-\\operatorname{ln}⁡|x|+C \\\\  & =2x-\\operatorname{ln}⁡|x|-\\operatorname{ln}⁡K \\\\  & =2x-(\\operatorname{ln}⁡|x|+\\operatorname{ln}⁡K) \\\\  & =2x-\\operatorname{ln}⁡(K|x|).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28be1daf-e4d6-5307-a254-ff0ec66dbf3f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-1" :db/id #edb/ref 17592186236072} {:answer/id #uuid "38818bd5-0d27-57c8-b3d8-774c7db2f12e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186236175} {:answer/id #uuid "b1c44bc5-c614-5b30-bc98-b29666768cd3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{2}-1" :db/id #edb/ref 17592186236943} {:answer/id #uuid "bc7dd338-893e-506e-976e-d4705148656b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}+1" :db/id #edb/ref 17592186237021} {:answer/id #uuid "d23ff9fb-7a2e-5b19-897b-5bbe777d319b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1-\\sqrt{2}" :db/id #edb/ref 17592186237146}] :answer-field/correct {:db/id #edb/ref 17592186236175} :answer-field/id #uuid "b1c613f8-ed77-50c0-b40f-a68fbaeccb76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237667}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "13ef05d7-e064-5d34-bef9-8301a2ad17b2" :question/math-academy-id "q-103658" :question/problem "Calculate \n$$\n\\displaystyle {\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\operatorname{csc}⁡\\left(\\frac{\\pi }{2}\\right)-(-\\operatorname{csc}⁡\\left(\\frac{\\pi }{4}\\right)) \\\\  & =-1-(-\\sqrt{2}) \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7c9cd2-6944-5863-bc69-62975c2906f8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}-1" :db/id #edb/ref 17592186235876} {:answer/id #uuid "98578c54-03fb-5056-afe0-ab2b99fb4ff4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186236782} {:answer/id #uuid "ab22f6fd-a96c-5284-bc89-14c5b0fabbad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186236898} {:answer/id #uuid "d8f243d1-8d1e-59c0-ba0c-0e8ecf122ac5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}-1" :db/id #edb/ref 17592186237190} {:answer/id #uuid "f855a1eb-9012-5b0e-946f-0d40498df3eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{3}+1" :db/id #edb/ref 17592186237383}] :answer-field/correct {:db/id #edb/ref 17592186236782} :answer-field/id #uuid "b49880a5-1e24-51a4-9758-7aac4e75c637" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237673}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "c44a1c94-220c-5631-9e8d-0fa005c996ce" :question/math-academy-id "q-103659" :question/problem "Calculate $$\n\\displaystyle {\\int }_{\\pi /2}^{5\\pi /6}{\\csc }^{2}⁡x\\,\\text{d}x.\n$$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /2}^{5\\pi /6}{\\csc }^{2}⁡x\\,\\text{d}x & =-\\operatorname{cot}⁡x{|}_{\\pi /2}^{5\\pi /6} \\\\  & =-\\operatorname{cot}⁡\\left(\\frac{5\\pi }{6}\\right)-(-\\operatorname{cot}⁡\\left(\\frac{\\pi }{2}\\right)) \\\\  & =-(-\\sqrt{3})-0 \\\\  & =\\sqrt{3}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160d350c-f7d2-525d-b82d-74ee79b358e3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "18+9\\pi " :db/id #edb/ref 17592186235951} {:answer/id #uuid "aa00fd63-d95b-5a71-a0e4-5193d38273ab" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{45+9\\pi }{2}" :db/id #edb/ref 17592186236890} {:answer/id #uuid "b56993e5-8a9e-59fc-a95a-d5a1b6fd20f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{36+9\\pi }{2}" :db/id #edb/ref 17592186236964} {:answer/id #uuid "bc173a5f-f60c-506c-8125-ecf6c0ac0a94" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{45+18\\pi }{2}" :db/id #edb/ref 17592186237018} {:answer/id #uuid "dec33b7c-1ed6-5d66-a9ca-ca2225ba6e37" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23+9\\pi " :db/id #edb/ref 17592186237216}] :answer-field/correct {:db/id #edb/ref 17592186236890} :answer-field/id #uuid "f50e9d84-8b40-56c8-b7c9-f0af8e3c1269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237756}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "3de3f05e-692a-5c2b-925d-7af2f750b8cf" :question/math-academy-id "q-103771" :question/problem "![](images/68/68786f08e73998de597d0d9eea5be3031f322785c05835cf7eccfa7837f36d7b.png)\n\nThe graph of a function $y=f(x)$ is shown above. It consists of two lines and the arc of a semi-circle of radius $3.$ Given $$\n\\displaystyle g(t)={\\int }_{-3}^{t}f(x)\\,\\text{d}x,\n$$ determine the value of $g(6).$" :question/worked-solution "Evaluating $g(t)$ at $t=6,$ we get the following definite integral:\n\n$$\ng(6)={\\int }_{-3}^{6}f(x)\\,\\text{d}x.\n$$\n\nThis integral gives the signed area between the curve and the $x$-axis shown below.\n\n![](images/b5/b553755a624031408b8374d06c8dc8dbf33c3ddc8d372332c945bad7e42ef068.png)\n\nNote that the graph above consists of $2$ parts:\n\n- $x\\in [-3,0],$ for which the region between the curve and the $x$-axis is a triangle. This corresponds to the area ${A}_{1}.$\n\n- $x\\in [0,6],$ for which the region between the curve and the $x$-axis is a semi-circle and a rectangle below it. This corresponds to the area ${A}_{2}.$\n\nTherefore, we can write the integral as follows:\n\n$$\ng(6)={\\int }_{-3}^{6}f(x)\\,\\text{d}x=\\underbrace{{\\int }_{-3}^{0}f(x)\\,\\text{d}x}_{{A}_{1}}+\\underbrace{{\\int }_{0}^{6}f(x)\\,\\text{d}x}_{{A}_{2}}\n$$\n\nNow, let's compute these integrals:\n\n- To find the first integral where $x\\in [-3,0],$ we compute the area ${A}_{1}$ of the triangle as follows:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 3\\cdot 3 \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\n- To find the second integral where $x\\in [0,6],$ we compute the area ${A}_{2}$ of the semi-circle and the rectangle below it as follows:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}\\pi {r}^{2}+bh \\\\  & =\\frac{1}{2}\\pi \\cdot {3}^{2}+6\\cdot 3 \\\\  & =\\frac{9}{2}\\pi +18\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}g(3) & ={\\int }_{-3}^{6}f(x)\\,\\text{d}x={A}_{1}+{A}_{2}=\\frac{9}{2}+(\\frac{9}{2}\\pi +18)=\\frac{45+9\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238051 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e4cbc54-5f79-5794-8b86-996b4d61eeba" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A(t)=\\frac{11{t}^{2}}{12}" :db/id #edb/ref 17592186236208} {:answer/id #uuid "c92055c1-431d-56bc-b8f4-13bcd409512b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A(t)=5+\\frac{5}{6}t" :db/id #edb/ref 17592186237090} {:answer/id #uuid "d4d1fe03-1de1-585a-8cda-afe5500c7fd2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A(t)=5+\\frac{11{t}^{2}}{12}" :db/id #edb/ref 17592186237162} {:answer/id #uuid "ec276c76-ff27-5ae3-8067-0cfd48f982ea" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A(t)=5+\\frac{5}{6}t+\\frac{11{t}^{2}}{12}" :db/id #edb/ref 17592186237305} {:answer/id #uuid "f673cb3b-df61-5969-80cd-a530b3874dff" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "A(t)=\\frac{5}{6}t+\\frac{11{t}^{2}}{12}" :db/id #edb/ref 17592186237373}] :answer-field/correct {:db/id #edb/ref 17592186236208} :answer-field/id #uuid "c7e1563b-11f2-5b5d-a443-5925c35927ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237695}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "8c4b3a08-f3f3-503c-a94c-8878322d740d" :question/math-academy-id "q-103778" :question/problem "A gas station pump dispenses gas into an empty gas tank at a rate of $\\frac{11}{6}t$ liters per second. Write an expression for $A(t),$ the total volume of gas in the tank at time $t,$ where $t$ is the time measured in second." :question/worked-solution "Let $f(t)=\\frac{11}{6}t$ be the rate at which the gas pump dispenses gas, and let $A(T)$ be the total number of liters in the car after $T$ seconds.\n\nUsing our formula for the accumulation of change, we have\n\n$$\nA(T)=A(0)+{\\int }_{0}^{T}f(t)\\,\\text{d}t.\n$$\n\nSubstituting the known information and carrying out the necessary integration gives\n\n$$\n\\begin{aligned}A(T) & =A(0)+{\\int }_{0}^{T}f(t)\\,\\text{d}t \\\\  & =0+{\\int }_{0}^{T}\\frac{11}{6}t\\,\\text{d}t \\\\  & ={(\\frac{11}{6}\\cdot \\frac{{t}^{2}}{2})|}_{0}^{T} \\\\  & =\\frac{11{T}^{2}}{12}.\\end{aligned}\n$$\n\nFinally, let's rewrite our final answer in terms of the original variable $t.$ We have\n\n$$\nA(t)=\\frac{11{t}^{2}}{12}.\n$$"} {:db/id #edb/ref 17592186238064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47084e96-4575-5ea2-bc29-d0119689a067" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "8" :db/id #edb/ref 17592186236272} {:answer/id #uuid "5c665951-8f9f-5315-b3f3-bac47dafdacc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4" :db/id #edb/ref 17592186236396} {:answer/id #uuid "8127b6a0-4402-576d-a67a-897bdcc56f58" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186236622} {:answer/id #uuid "d6287872-577f-5bdf-aa77-b5a797c91de2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186237171} {:answer/id #uuid "ef3ea81c-a5ed-52a6-801d-d9a3a71605f5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2" :db/id #edb/ref 17592186237328}] :answer-field/correct {:db/id #edb/ref 17592186236272} :answer-field/id #uuid "eca36830-c9ce-5e40-8c39-1b9f25663b85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237744}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "57b3d195-da37-5216-80d4-504f546a07a3" :question/math-academy-id "q-103837" :question/problem "![](images/33/3387790df770ac8645058c6f460b1f1285629d18d765668e362a8070ae4035ed.png)\n\nFind the arc length of the polar curve $r=2+2\\operatorname{cos}⁡\\theta $ for $0\\le \\theta \\le \\pi $ (shown in blue in the diagram above).\n\n*Hint: You may wish to use the following identity: $$\n\\displaystyle \\operatorname{cos}⁡\\left(\\frac{x}{2}\\right)=\\sqrt{\\frac{1+\\operatorname{cos}⁡x}{2}}.\n$$*" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2+2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(2+2\\operatorname{cos}⁡\\theta )^{2}+{(-2\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4+8\\operatorname{cos}⁡\\theta +4{\\cos }^{2}⁡\\theta +4{\\sin }^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8+8\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta  \\\\  & =\\sqrt{8}{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta \\end{aligned}\n$$\n\nNow, we recall the identity for $\\operatorname{cos}⁡\\left(\\frac{x}{2}\\right):$\n\n$$\n\\operatorname{cos}⁡\\left(\\frac{x}{2}\\right)=\\sqrt{\\frac{1+\\operatorname{cos}⁡x}{2}}\n$$\n\nTherefore, using $x=\\theta $ in the previous identity, the integral can be written as follows:\n\n$$\n\\begin{aligned}L & =2\\sqrt{2}{\\int }_{0}^{\\pi }\\sqrt{2{\\cos }^{2}⁡\\left(\\frac{\\theta }{2}\\right)}\\,\\text{d}\\theta  \\\\  & =2\\sqrt{2}\\cdot \\sqrt{2}\\cdot {\\int }_{0}^{\\pi }\\operatorname{cos}⁡\\left(\\frac{\\theta }{2}\\right)\\,\\text{d}\\theta  \\\\  & ={4\\cdot 2(\\operatorname{sin}⁡\\left(\\frac{\\theta }{2}\\right))|}_{0}^{\\pi } \\\\  & =8(\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)-\\operatorname{sin}⁡(0)) \\\\  & =8.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238068 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10eb4957-edbb-5cdb-ac64-9bc72c43dea5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186235908} {:answer/id #uuid "acce3f64-38d4-545c-a90a-98ae08560f34" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186236916} {:answer/id #uuid "d622bbba-38b9-58f1-aec8-b7200b12def3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186237170} {:answer/id #uuid "e015dcfd-6510-5e73-8639-a91aea104895" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\pi " :db/id #edb/ref 17592186237223} {:answer/id #uuid "fefc8cb9-5106-5ba6-8509-ba84de8e6560" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{16}" :db/id #edb/ref 17592186237441}] :answer-field/correct {:db/id #edb/ref 17592186236916} :answer-field/id #uuid "8bfbd4d3-1699-53a9-8de9-e66feb8a6c94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237623}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "96931358-f8ea-56cc-a85a-c2b66216308c" :question/math-academy-id "q-103842" :question/problem "![](images/03/038d135bd0d8d163808fe21be0159a1a08db37c3e33599c97033ca0d53abab36.png)\n\nFind the arc length of the polar curve $r=2\\operatorname{cos}⁡\\theta $ for $$\n\\displaystyle \\frac{3\\pi }{2}\\le \\theta \\le \\frac{7\\pi }{4}\n$$ (shown in blue in the diagram above)." :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=2\\operatorname{cos}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{sin}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{\\left(\\frac{\\text{d}r}{\\text{d}\\theta }\\right)}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /2}^{7\\pi /4}\\sqrt{(2\\operatorname{cos}⁡\\theta )^{2}+{(-2\\operatorname{sin}⁡\\theta )}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /2}^{7\\pi /4}\\sqrt{4({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{3\\pi /2}^{7\\pi /4}1\\,\\text{d}\\theta  \\\\  & =2\\theta {|}_{3\\pi /2}^{7\\pi /4} \\\\  & =2(\\frac{7\\pi }{4}-\\frac{3\\pi }{2}) \\\\  & =\\frac{\\pi }{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186238070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "268106be-19f1-5f82-813d-950192dc5718" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186236063} {:answer/id #uuid "a348d55a-36a9-5af2-81e6-6f7585bd95e1" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186236841} {:answer/id #uuid "cf31be4e-0647-5297-be76-a4721eb22f2a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},-\\frac{1}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237129} {:answer/id #uuid "d9ca6f54-6773-56f6-8dd0-f043a63dc54a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},\\frac{1}{2})$, radius: $\\frac{9}{2}$" :db/id #edb/ref 17592186237197} {:answer/id #uuid "fc2a1ef9-6f90-5fd1-aa22-221a29a4b907" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{9}{2},\\frac{3}{2})$, radius: $\\frac{3}{\\sqrt{2}}$" :db/id #edb/ref 17592186237416}] :answer-field/correct {:db/id #edb/ref 17592186236063} :answer-field/id #uuid "2e70a388-068c-5ad0-9ccf-1ecef596f218" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237503}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "072480e4-7dc0-5975-9c71-894af7eb1672" :question/math-academy-id "q-103890" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}+3x-y-2=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+3x-y-2 & =0 \\\\ ({x}^{2}+3x)+({y}^{2}-y) & =2 \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{\\left(\\frac{3}{2}\\right)}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{\\left(\\frac{1}{2}\\right)}^{2}) & =2+{\\left(\\frac{3}{2}\\right)}^{2}+{\\left(\\frac{1}{2}\\right)}^{2} \\\\ ({x}^{2}+2\\cdot \\frac{3}{2}x+{\\left(\\frac{3}{2}\\right)}^{2})+({y}^{2}-2\\cdot \\frac{1}{2}y+{\\left(\\frac{1}{2}\\right)}^{2}) & =\\frac{9}{2}\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}{(x+\\frac{3}{2})}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{9}{2} \\\\ {(x-\\left(-\\frac{3}{2}\\right))}^{2}+{(y-\\frac{1}{2})}^{2} & ={\\left(\\frac{3}{\\sqrt{2}}\\right)}^{2}\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-\\frac{3}{2},\\frac{1}{2})$ and its radius is $\\frac{3}{\\sqrt{2}}.$"} {:db/id #edb/ref 17592186238071 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1363c841-dd2f-57da-b97b-16bec04683d6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},-2)$, radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186235930} {:answer/id #uuid "47c89831-df18-53be-92f2-b52d6c8ba5b2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{1}{2},2)$, radius: $\\frac{5}{4}$" :db/id #edb/ref 17592186236279} {:answer/id #uuid "52ba3c55-6a2d-5c64-9e05-2892226192de" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(-\\frac{3}{2},-2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186236342} {:answer/id #uuid "bf62ed9c-4b79-5d2c-83d9-7a2053919ece" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},2)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237033} {:answer/id #uuid "d0cd46be-6ca9-56ad-98b1-e84372745705" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(\\frac{3}{2},4)$, radius: $\\frac{5}{2}$" :db/id #edb/ref 17592186237141}] :answer-field/correct {:db/id #edb/ref 17592186237033} :answer-field/id #uuid "c35bda4d-8c7c-53e3-9565-e1df8075b9d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237687}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "e504d2ff-bf2c-5a7b-89f3-0f34d5a7f90d" :question/math-academy-id "q-103894" :question/problem "Find the radius and center of the circle whose equation is\n${x}^{2}+{y}^{2}-3x-4y=0.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-3x-4y & =0 \\\\ ({x}^{2}-3x)+({y}^{2}-4y) & =0 \\\\ ({x}^{2}-2\\cdot \\frac{3}{2}x+{\\left(\\frac{3}{2}\\right)}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & ={\\left(\\frac{3}{2}\\right)}^{2}+{2}^{2} \\\\ ({x}^{2}-2\\cdot \\frac{3}{2}x+{\\left(\\frac{3}{2}\\right)}^{2})+({y}^{2}-2\\cdot 2y+{2}^{2}) & =\\frac{25}{4}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{(x-\\frac{3}{2})}^{2}+(y-2)^{2} & ={\\left(\\frac{5}{2}\\right)}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(\\frac{3}{2},2)$ and its radius is $\\frac{5}{2}.$"} {:db/id #edb/ref 17592186238072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "921a2627-ec10-5d1e-8639-eef8fd7f3342" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,-\\frac{1}{2})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236745} {:answer/id #uuid "9fb55b6d-6427-54d7-925a-0d7d4383ae68" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186236813} {:answer/id #uuid "b365be51-4d65-5928-9f90-0629516c1e8d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,-\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236953} {:answer/id #uuid "b865178d-d257-5526-bfc0-ea89da1ca0eb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,\\frac{1}{4})$, radius: $\\frac{3}{4}$" :db/id #edb/ref 17592186236995} {:answer/id #uuid "c9d0e896-c4c4-58e2-a331-79ea27bb0deb" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "center: $(0,\\frac{1}{2})$, radius: $\\sqrt{\\frac{3}{4}}$" :db/id #edb/ref 17592186237098}] :answer-field/correct {:db/id #edb/ref 17592186236995} :answer-field/id #uuid "94b4f34f-41d5-5588-8d90-691adc493613" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186237636}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "f6a657b9-6edf-5ed4-a2a2-a0a7062d8da7" :question/math-academy-id "q-103896" :question/problem "Find the radius and center of the circle whose equation is\n$$\n\\displaystyle {x}^{2}+{y}^{2}-\\frac{1}{2}y=\\frac{1}{2}.\n$$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-\\frac{1}{2}y & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-\\frac{1}{2}y) & =\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{\\left(\\frac{1}{4}\\right)}^{2}) & ={\\left(\\frac{1}{4}\\right)}^{2}+\\frac{1}{2} \\\\ {x}^{2}+({y}^{2}-2\\cdot \\frac{1}{4}y+{\\left(\\frac{1}{4}\\right)}^{2}) & =\\frac{9}{16}\\end{aligned}\n$$\n\nNow, we can factor the perfect square and get\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{1}{4})}^{2} & ={\\left(\\frac{3}{4}\\right)}^{2} \\\\ (x-0)^{2}+{(y-\\frac{1}{4})}^{2} & ={\\left(\\frac{3}{4}\\right)}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(0,\\frac{1}{4})$ and its radius is $\\frac{3}{4}.$"} {:answer/id #uuid "100e1515-25fc-57c5-bf1a-0fa837d35049" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-\\infty ,\\frac{1}{6})" :db/id #edb/ref 17592186238191} {:answer/id #uuid "1179ddc8-9d2b-5f37-858d-a4af5d525038" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{(x-\\frac{1}{2})}^{2}+{(y+\\frac{1}{2})}^{2}=\\sqrt{5}" :db/id #edb/ref 17592186238199} {:answer/id #uuid "154230c4-e5cc-5eb7-a10c-06c3c17162be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\theta \\in [0,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186238230} {:answer/id #uuid "25865f2a-e9ab-502a-9acf-7363a0aeafd9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "20[\\operatorname{cos}⁡\\left(\\frac{2\\theta }{5}\\right)+\\text{i}\\operatorname{sin}⁡\\left(\\frac{2\\theta }{5}\\right)]" :db/id #edb/ref 17592186238382} {:answer/id #uuid "283b8e16-5fca-5dfa-9a88-d69fd0c9c6cf" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\