c{1}{1+(\\sqrt{3}x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250169 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "253eba90-1471-5899-a022-f2a6a0dcc2f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186247751} {:answer/id #uuid "5d35edcf-35aa-5569-a7e5-3873e6df59f4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248273} {:answer/id #uuid "ae194557-e33c-5111-90ab-ccce8ece805c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248979} {:answer/id #uuid "e3d2ca92-2b60-5ab0-85fd-763ef78c1cc2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "2\\sqrt{2}\\operatorname{arctan}⁡(2x)+C" :db/id #edb/ref 17592186249431} {:answer/id #uuid "f394bc85-f9c8-541e-bb77-70203902c090" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4\\operatorname{arctan}⁡(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249555}] :answer-field/correct {:db/id #edb/ref 17592186247751} :answer-field/id #uuid "69de4702-78ad-579a-9c5d-8bfd3d6340aa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249854}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "c1b0abe8-8c03-503e-a61e-925a200b4441" :question/math-academy-id "q-114040" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{4}{1+2{x}^{2}}\\,\\text{d}x.\n$$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $2{x}^{2}=(\\sqrt{2}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{1+2{x}^{2}}\\,\\text{d}x & =4\\int \\frac{1}{1+(\\sqrt{2}x)^{2}}\\text{d}x \\\\  & =4\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\frac{4}{\\sqrt{2}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{4\\sqrt{2}}{2}\\operatorname{arctan}⁡u+C \\\\  & =2\\sqrt{2}\\operatorname{arctan}⁡(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250173 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2557c8c9-61d4-546a-b12e-2149e3cb0784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (\\sqrt{5}x)+C" :db/id #edb/ref 17592186247753} {:answer/id #uuid "4b9ffc95-a0ae-5868-bc4f-b4a2ff82ae20" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,\\operatorname{arcsec} (\\sqrt{5}x)+C" :db/id #edb/ref 17592186248100} {:answer/id #uuid "90d77fc7-cc8f-513f-84a7-ae393b51759b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "5\\,\\operatorname{arcsec} (5x)+C" :db/id #edb/ref 17592186248710} {:answer/id #uuid "da3de159-0af1-5109-a432-7a259afa945f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{5}\\,\\operatorname{arcsec} (\\sqrt{5}x)+C" :db/id #edb/ref 17592186249353} {:answer/id #uuid "f5ce8cb5-8424-5bdb-b48e-afc1856f992f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} (5x)+C" :db/id #edb/ref 17592186249568}] :answer-field/correct {:db/id #edb/ref 17592186247753} :answer-field/id #uuid "5bb9394d-1677-5845-bcf1-c7fd75b784b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186249835}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "721577ab-4fa8-5463-8c74-5d6cebd1decf" :question/math-academy-id "q-114051" :question/problem "Calculate $$\n\\displaystyle \\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x.\n$$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{5{x}^{2}-1}}=\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\operatorname{arcsec} ,$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\operatorname{arcsec} (u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{5}x.$\n\nSo, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{5}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\sqrt{5}\\cdot \\frac{1}{\\sqrt{5}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\operatorname{arcsec} u+C \\\\  & =\\operatorname{arcsec} (\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186250174 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d1c680b-da3e-532e-b768-23a73eed1830" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\sqrt{2}\\,\\operatorname{arcsec} (x)+C" :db/id #edb/ref 17592186248115} {:answer/id #uuid "76b64e00-cc9d-56bb-96a5-6ed308000d0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{arcsec} \\left(\\frac{x}{\\sqrt{2}}\\right)+C" :db/id #edb/ref 17592186248469} {:answer/id #uuid "81a2d087-34bd-5b