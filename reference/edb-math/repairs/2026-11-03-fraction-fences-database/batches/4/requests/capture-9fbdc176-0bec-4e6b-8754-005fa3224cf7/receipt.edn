{d}v}{\\text{d}x}+v & =\\frac{(vx)x}{(vx)^{2}+{x}^{2}} \\\\ x\\frac{\\text{d}v}{\\text{d}x}+v & =\\frac{v{x}^{2}}{{x}^{2}({v}^{2}+1)} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{v}{{v}^{2}+1}-v \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{v-{v}^{3}-v}{{v}^{2}+1} \\\\ x\\frac{\\text{d}v}{\\text{d}x} & =\\frac{-{v}^{3}}{{v}^{2}+1} \\\\ \\frac{{v}^{2}+1}{{v}^{3}}\\frac{\\text{d}v}{\\text{d}x} & =-\\frac{1}{x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$, we obtain:\n\n$$\n\\begin{aligned}\\int \\frac{{v}^{2}+1}{{v}^{3}}\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\int (\\frac{1}{v}+\\frac{1}{{v}^{3}})\\,\\text{d}v & =-\\int \\frac{1}{x}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|v|-\\frac{1}{2{v}^{2}} & =-\\operatorname{ln}⁡|x|+{C}_{1} \\\\ 2\\operatorname{ln}⁡|v|-\\frac{1}{{v}^{2}} & =-2\\operatorname{ln}⁡|x|+2{C}_{1} \\\\ 2\\operatorname{ln}⁡|v|-\\frac{1}{{v}^{2}} & =-2\\operatorname{ln}⁡|x|+C\\end{aligned}\n$$\n\nNotice that we introduced $C=2{C}_{1}.$\n\nFrom the transformation $y=vx$, we get\n\n$$\nv=\\frac{y}{x}.\n$$\n\nSubstituting the above into our solution, we finally obtain:\n\n$$\n\\begin{aligned}2\\operatorname{ln}⁡|\\frac{y}{x}|-\\frac{{x}^{2}}{{y}^{2}} & =-2\\operatorname{ln}⁡|x|+C \\\\ 2\\operatorname{ln}⁡|\\frac{y}{x}|+2\\operatorname{ln}⁡|x|-\\frac{{x}^{2}}{{y}^{2}} & =C \\\\ 2\\operatorname{ln}⁡|y|-\\frac{{x}^{2}}{{y}^{2}} & =C\\end{aligned}\n$$\n\nThe division by $v$ assumes $y\\ne0$. The equilibrium solution $y=0$ also satisfies the original differential equation on any interval with $x\\ne0$; it is not represented by the logarithmic family above." 13194139545750 17592186576411 false] [17592186275108 1074 "With $y=v(x)x$, we have:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =x\\frac{\\text{d}v}{\\text{d}x}+v\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =x\\frac{\\text{d}v}{\\text{d}x}+v\\end{aligned}\n$$\n\nSubstituting the above into our differential equation gives:\n\n$$\n\\begin{