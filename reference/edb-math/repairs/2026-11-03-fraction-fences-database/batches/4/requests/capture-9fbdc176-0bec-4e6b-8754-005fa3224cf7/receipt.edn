}x}+b{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+2a{y}_{1}+2b{y}_{2}.\\,\\times \\end{aligned}\n$$\n\n- The third operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})+x(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ax{y}_{1}+bx{y}_{2} \\\\  & =a[\\frac{\\text{d}{y}_{1}}{\\text{d}x}+x{y}_{1}]+b[\\frac{\\text{d}{y}_{2}}{\\text{d}x}+x{y}_{2}] \\\\  & =a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})\\,✓\\end{aligned}\n$$" 13194139545750 17592186576411 false] [17592186265878 1074 "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & ={x}^{3}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+{x}^{2}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{x}^{2}{y}_{1}+a{x}^{2}{y}_{2} \\\\  & =a\\left[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{x}^{2}{y}_{1}\\right]+b\\left[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{x}^{2}{y}_{2}\\right] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})+2(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})\\left(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x}\\right)+2a{y}_{1}+2b{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+{b}^{2}{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ab\\left({y}_{1}\\f