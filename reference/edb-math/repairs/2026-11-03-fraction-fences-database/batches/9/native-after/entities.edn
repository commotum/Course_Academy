{2/3}+1\\right]}^{3/2}" :db/id #edb/ref 17592186443519} {:answer/id #uuid "c64215ca-c1b2-57b5-bdd6-c53bbb436663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle s,\\,\\frac{4s}{3},\\,1\\right\\rangle " :db/id #edb/ref 17592186443520} {:answer/id #uuid "caf2317e-01bb-53d6-bd84-e85f0344d156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{s}{3},\\,\\frac{2s}{3},\\,1\\right\\rangle " :db/id #edb/ref 17592186443523} {:answer/id #uuid "cd7758b9-5236-5926-b5ee-c1a0c9406558" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{3s}{5},\\,2\\operatorname{sin}⁡\\left(\\frac{2s}{5}\\right),\\,2\\operatorname{cos}⁡\\left(\\frac{2s}{5}\\right)\\right\\rangle " :db/id #edb/ref 17592186443524} {:answer/id #uuid "e10e8c34-d7a5-5c32-a5fb-5487a2156990" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{3s}{5},\\,\\frac{4s}{5},\\,1\\right\\rangle " :db/id #edb/ref 17592186443526} {:db/id #edb/ref 17592186443542 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "447ff6ac-8e33-53a7-a4b3-bb9df76bffb0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{1}{35}\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{\\sqrt{6}}{14},\\,-\\frac{1}{35}\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle " :db/id #edb/ref 17592186443498} {:answer/id #uuid "6486f987-8f88-59d1-a346-9c83d923a1ac" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle 5\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{2\\sqrt{6}}{7},\\,-5\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle " :db/id #edb/ref 17592186443501} {:answer/id #uuid "a1d0d21b-45e7-55b2-a074-9a46fed29092" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{1}{35}\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{2\\sqrt{6}}{7},\\,-\\frac{1}{35}\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle " :db/id #edb/ref 17592186443512} {:answer/id #uuid "a5c74af9-8ca2-5cca-a7be-75a239dd9ecc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\operatorname{cos}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{2\\sqrt{6}}{7},\\,-\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle " :db/id #edb/ref 17592186443514} {:answer/id #uuid "b7a1952d-4592-5193-b5f8-225ef704bbd4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left\\langle \\frac{5}{7}\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{2\\sqrt{6}}{7},\\,-\\frac{5}{7}\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle " :db/id #edb/ref 17592186443517}] :answer-field/correct {:db/id #edb/ref 17592186443517} :answer-field/id #uuid "de6079b3-a0dd-5241-b8ce-a969c300edc5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443539}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "1147fbce-b0d6-511f-b878-2ccccfbc032b" :question/math-academy-id "q-78437" :question/problem "Given the curve  $r(t)=⟨5\\operatorname{sin}⁡t,\\,2\\sqrt{6}t,\\,5\\operatorname{cos}⁡t⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=7t,$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" :question/worked-solution "First, since $s=7t$, we have that $t=\\frac{s}{7}.$\n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left(\\frac{s}{7}\\right) \\\\  & =\\left\\langle 5\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right),\\,2\\sqrt{6}\\cdot \\frac{s}{7},\\,5\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle  \\\\  & =\\left\\langle 5\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{2\\sqrt{6}s}{7},\\,5\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle .\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parametrized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}s}\\left(5\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right),\\,\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{2\\sqrt{6}s}{7}\\right),\\,\\frac{\\text{d}}{\\text{d}s}\\left(5\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right)\\right)\\right\\rangle  \\\\  & =\\left\\langle \\frac{5}{7}\\operatorname{cos}⁡\\left(\\frac{s}{7}\\right),\\,\\frac{2\\sqrt{6}}{7},\\,-\\frac{5}{7}\\operatorname{sin}⁡\\left(\\frac{s}{7}\\right)\\right\\rangle .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443543 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0078bb74-f290-5ea7-a214-52b9d695f5aa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\sqrt{2s})+3\\operatorname{sin}⁡(\\sqrt{2s})" :db/id #edb/ref 17592186443489} {:answer/id #uuid "90c29a1a-cd28-5b50-b2a0-d5a7e09bc382" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\sqrt{2s})+\\sqrt{2s}\\operatorname{sin}⁡(\\sqrt{2s})" :db/id #edb/ref 17592186443508} {:answer/id #uuid "bdd6f943-95f7-5873-b8a8-4d4dc0f6b355" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡(\\sqrt{2s})+\\frac{1}{3}\\operatorname{sin}⁡(\\sqrt{2s})" :db/id #edb/ref 17592186443518} {:answer/id #uuid "e86fc481-fc66-5c0e-8cd5-654a6782aa39" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\sqrt{2s}}{3}\\right)+\\frac{\\sqrt{2s}}{3}\\operatorname{sin}⁡\\left(\\frac{\\sqrt{2s}}{3}\\right)" :db/id #edb/ref 17592186443528} {:answer/id #uuid "eeb7902b-1060-5a35-9399-e7e8e0a37d2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\operatorname{cos}⁡\\left(\\frac{\\sqrt{2s}}{9}\\right)+\\frac{\\sqrt{2s}}{9}\\operatorname{sin}⁡\\left(\\frac{\\sqrt{2s}}{9}\\right)" :db/id #edb/ref 17592186443531}] :answer-field/correct {:db/id #edb/ref 17592186443508} :answer-field/id #uuid "b84fca7e-39f0-5846-a5a5-8d1c1f76b531" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443537}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "16cdbada-67e8-5de1-a9af-81171c0d9ab3" :question/math-academy-id "q-127693" :question/problem "Consider the curve $r(t)=⟨\\operatorname{sin}⁡3t-3t\\operatorname{cos}⁡3t,\\,\\operatorname{cos}⁡3t+3t\\operatorname{sin}⁡3t⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=\\frac{9}{2}{t}^{2}.$ Given that $R(s)$ is the parametrization of the given curve by its arc length $s,$ what is the $y$-component of $R?$" :question/worked-solution "First, since $s=\\frac{9}{2}{t}^{2},$ we have that $t=\\frac{\\sqrt{2s}}{3}.$\n\nThe vector function that pametrizes the curve $r(t)$ by its arc length $s,$ with $s\\ge 0,$ is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left(\\frac{\\sqrt{2s}}{3}\\right) \\\\  & =\\left\\langle \\operatorname{sin}⁡\\left(3\\cdot \\frac{\\sqrt{2s}}{3}\\right)-3\\cdot \\frac{\\sqrt{2s}}{3}\\operatorname{cos}⁡\\left(3\\cdot \\frac{\\sqrt{2s}}{3}\\right),\\,\\operatorname{cos}⁡\\left(3\\cdot \\frac{\\sqrt{2s}}{3}\\right)+3\\cdot \\frac{\\sqrt{2s}}{3}\\operatorname{sin}⁡\\left(3\\cdot \\frac{\\sqrt{2s}}{3}\\right)\\right\\rangle  \\\\  & =⟨\\operatorname{sin}⁡(\\sqrt{2s})-\\sqrt{2s}\\operatorname{cos}⁡(\\sqrt{2s}),\\,\\operatorname{cos}⁡(\\sqrt{2s})+\\sqrt{2s}\\operatorname{sin}⁡(\\sqrt{2s})⟩.\\end{aligned}\n$$\n\n \n\nSo, the $y$-component of $R$ is\n\n$$\n\\operatorname{cos}⁡(\\sqrt{2s})+\\sqrt{2s}\\operatorname{sin}⁡(\\sqrt{2s}).\n$$"} {:db/id #edb/ref 17592186443544 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b22410-7856-5e1a-acc1-6826159d44dc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle 3\\operatorname{sin}⁡\\left(\\frac{s}{4}\\right),\\,2-3\\operatorname{cos}⁡\\left(\\frac{s}{4}\\right)\\right\\rangle " :db/id #edb/ref 17592186443491} {:answer/id #uuid "1efba70b-6e3e-5b18-88b3-cce733abfbee" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle 3\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right),\\,2-3\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right)\\right\\rangle " :db/id #edb/ref 17592186443492} {:answer/id #uuid "9b9add6d-7ad1-521a-b998-2bbe4dbdbf01" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=⟨3\\operatorname{sin}⁡(6s),\\,2-3\\operatorname{cos}⁡(6s)⟩" :db/id #edb/ref 17592186443510} {:answer/id #uuid "ae297d72-79f9-5500-a313-64fff1a8859b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle 3\\operatorname{sin}⁡\\left(\\frac{s}{12}\\right),\\,2-3\\operatorname{cos}⁡\\left(\\frac{s}{12}\\right)\\right\\rangle " :db/id #edb/ref 17592186443516} {:answer/id #uuid "fa66aa49-7286-5817-af4c-b29349ada577" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=⟨3\\operatorname{sin}⁡(3s),\\,2-3\\operatorname{cos}⁡(3s)⟩" :db/id #edb/ref 17592186443533}] :answer-field/correct {:db/id #edb/ref 17592186443492} :answer-field/id #uuid "fe722847-9990-513e-91c0-d8fbc2f2c414" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443541}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3ffd9e9c-d842-5a8a-82a2-58996823be61" :question/math-academy-id "q-127692" :question/problem "Consider the curve $r(t)=⟨3\\operatorname{sin}⁡4t,\\,2-3\\operatorname{cos}⁡4t⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=12t.$ Find $R(s),$ the parametrization of the curve by its arc length $s.$" :question/worked-solution "First, since $s=12t,$ we have that $t=\\frac{s}{12}.$\n\nThe vector function that pametrizes the curve $r(t)$ by its arc length $s,$ with $s\\ge 0,$ is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left(\\frac{s}{12}\\right) \\\\  & =\\left\\langle 3\\operatorname{sin}⁡\\left(4\\cdot \\frac{s}{12}\\right),\\,2-3\\operatorname{cos}⁡\\left(4\\cdot \\frac{s}{12}\\right)\\right\\rangle  \\\\  & =\\left\\langle 3\\operatorname{sin}⁡\\left(\\frac{s}{3}\\right),\\,2-3\\operatorname{cos}⁡\\left(\\frac{s}{3}\\right)\\right\\rangle .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443545 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69ca1aac-6b11-5376-9937-2208496cced2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}i+\\frac{1}{4}\\,j+\\frac{\\sqrt{3}}{2}\\,k" :db/id #edb/ref 17592186443503} {:answer/id #uuid "c9b146bb-770e-5edf-a89a-ddb5a4e69aef" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{4}i+\\frac{1}{2}\\,j+\\frac{\\sqrt{3}}{4}\\,k" :db/id #edb/ref 17592186443522} {:answer/id #uuid "d7a63ea5-e82d-58f3-a26d-7d87b25fa26b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}i+\\frac{1}{4}\\,j+\\frac{\\sqrt{3}}{2}\\,k" :db/id #edb/ref 17592186443525} {:answer/id #uuid "e925d7f5-a15f-5b03-9457-e819bfb1f793" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{8}i+\\frac{1}{2}\\,j+\\frac{\\sqrt{3}}{2}\\,k" :db/id #edb/ref 17592186443529} {:answer/id #uuid "f0b622e5-528f-57ff-bbcd-8e0d4e03bb0f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{1}{12}i+\\frac{1}{8}\\,j+\\frac{\\sqrt{3}}{4}\\,k" :db/id #edb/ref 17592186443532}] :answer-field/correct {:db/id #edb/ref 17592186443522} :answer-field/id #uuid "de3dc3d1-7e1d-5412-9859-e96e904a13e1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443538}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "6c7e6c99-f8ae-5d4a-9e7f-5c595417e9ec" :question/math-academy-id "q-78402" :question/problem "Given the curve  $r(t)=(3t-1)\\,i+2t\\,j+\\sqrt{3}t\\,k,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=4t,$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" :question/worked-solution "First, since $s=4t$, we have that $t=\\frac{s}{4}.$  \n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left(\\frac{s}{4}\\right) \\\\  & =\\left(3\\cdot \\frac{s}{4}-1\\right)i+\\left(2\\cdot \\frac{s}{4}\\right)j+\\left(\\sqrt{3}\\cdot \\frac{s}{4}\\right)k \\\\  & =\\left(\\frac{3s-4}{4}\\right)i+\\frac{s}{2}\\,j+\\frac{\\sqrt{3}s}{4}\\,k.\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parametrized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{3s-4}{4}\\right)i+\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{s}{2}\\right)j+\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{\\sqrt{3}s}{4}\\right)k \\\\  & =\\frac{3}{4}\\,i+\\frac{1}{2}\\,j+\\frac{\\sqrt{3}}{4}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443546 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32ff6b62-7151-50dd-84b9-f0682178bc3c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "T(s)=\\frac{1}{3}⟨2,\\,1,\\,-2⟩" :db/id #edb/ref 17592186443494} {:answer/id #uuid "5cbd1f61-356b-5e0e-97c4-264d421a9397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "T(s)=\\frac{\\sqrt{6}}{6}⟨2,\\,1,\\,-1⟩" :db/id #edb/ref 17592186443499} {:answer/id #uuid "74144c16-17c1-5293-9b2e-c5a9eeff8750" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "T(s)=\\frac{1}{3}⟨1,\\,-2,\\,-2⟩" :db/id #edb/ref 17592186443504} {:answer/id #uuid "74bae46f-6326-5411-928d-8a2bfd164ba4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "T(s)=\\frac{\\sqrt{3}}{3}⟨-1,\\,-1,\\,1⟩" :db/id #edb/ref 17592186443505} {:answer/id #uuid "e25ed8bf-2138-5064-9377-39d74381a566" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "T(s)=\\frac{\\sqrt{3}}{3}⟨1,\\,1,\\,-1⟩" :db/id #edb/ref 17592186443527}] :answer-field/correct {:db/id #edb/ref 17592186443494} :answer-field/id #uuid "65648327-28cf-5416-8e2f-6a1fc5001bde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443535}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7ba59ca0-21f4-55ed-9a11-93e0f28f7d7a" :question/math-academy-id "q-127707" :question/problem "Given the curve $r(t)=\\left\\langle {t}^{2}+3,\\,\\frac{1}{2}{t}^{2},\\,1-{t}^{2}\\right\\rangle ,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=\\frac{3{t}^{2}}{2},$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" :question/worked-solution "First, since $s=\\frac{3{t}^{2}}{2},$ we have\n\n$$\n\\begin{aligned}\\frac{3{t}^{2}}{2} & =s \\\\ {t}^{2} & =\\frac{2s}{3} \\\\ t & =\\sqrt{\\frac{2s}{3}}.\\end{aligned}\n$$\n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left(\\sqrt{\\frac{2s}{3}}\\right) \\\\  & =\\left\\langle {\\left(\\sqrt{\\frac{2s}{3}}\\right)}^{2}+3,\\,\\frac{1}{2}{\\left(\\sqrt{\\frac{2s}{3}}\\right)}^{2}\\,,1-{\\left(\\sqrt{\\frac{2s}{3}}\\right)}^{2}\\right\\rangle  \\\\  & =\\left\\langle \\frac{2s}{3}+3,\\,\\frac{s}{3},\\,1-\\frac{2s}{3}\\right\\rangle .\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parameterized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =\\left\\langle \\frac{\\text{d}}{\\text{d}s}\\left(\\frac{2s}{3}+3\\right),\\,\\frac{\\text{d}}{\\text{d}s}\\left(\\frac{s}{3}\\right),\\,\\frac{\\text{d}}{\\text{d}s}\\left(1-\\frac{2s}{3}\\right)\\right\\rangle  \\\\  & =\\left\\langle \\frac{2}{3},\\,\\frac{1}{3},\\,-\\frac{2}{3}\\right\\rangle  \\\\  & =\\frac{1}{3}⟨2,\\,1,\\,-2⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443547 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33d8185a-6a2a-5892-8eca-d2a40aec6d78" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\operatorname{sin}⁡\\left(\\frac{s}{2}\\right)i+\\operatorname{cos}⁡\\left(\\frac{s}{2}\\right)j-\\operatorname{cos}⁡\\left(\\frac{s}{2}\\right)k" :db/id #edb/ref 17592186443496} {:answer/id #uuid "357c3fed-2573-5af2-9a74-38fdbb7e9536" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=5\\operatorname{sin}⁡\\left(\\frac{s}{4}\\right)i+4\\operatorname{cos}⁡\\left(\\frac{s}{4}\\right)j-3\\operatorname{cos}⁡\\left(\\frac{s}{4}\\right)k" :db/id #edb/ref 17592186443497} {:answer/id #uuid "7e98db7f-69a7-535b-991b-a8a9c022916b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\operatorname{sin}⁡\\left(\\frac{s}{4}\\right)i+\\operatorname{cos}⁡\\left(\\frac{s}{4}\\right)j-\\operatorname{cos}⁡\\left(\\frac{s}{4}\\right)k" :db/id #edb/ref 17592186443506} {:answer/id #uuid "c8848381-e308-52a4-a707-2d321aed36f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\operatorname{sin}⁡\\left(\\frac{s}{5}\\right)i+\\operatorname{cos}⁡\\left(\\frac{s}{5}\\right)j-\\operatorname{cos}⁡\\left(\\frac{s}{5}\\right)k" :db/id #edb/ref 17592186443521} {:answer/id #uuid "eaaf160a-2424-50be-88b7-1cac758b976c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=5\\operatorname{sin}⁡\\left(\\frac{s}{5}\\right)i+4\\operatorname{cos}⁡\\left(\\frac{s}{5}\\right)j-3\\operatorname{cos}⁡\\left(\\frac{s}{5}\\right)k" :db/id #edb/ref 17592186443530}] :answer-field/correct {:db/id #edb/ref 17592186443530} :answer-field/id #uuid "dff45dea-1e54-5748-adfe-76155f49648f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443540}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "a07b5060-561f-5345-8fe4-ea776cd5863a" :question/math-academy-id "q-78400" :question/problem "What is the parametrization of the curve $r(t)=5\\operatorname{sin}⁡(4t)\\,i+4\\operatorname{cos}⁡(4t)\\,j-3\\operatorname{cos}⁡(4t)\\,k,$  $\\,t\\ge 0,$ by its arc length $s?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(5\\operatorname{sin}⁡(4t))i+\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡(4t))\\,j+\\frac{\\text{d}}{\\text{d}t}(-3\\operatorname{cos}⁡(4t))k \\\\  & =5\\cdot 4\\operatorname{cos}⁡(4t)\\,i-4\\cdot 4\\operatorname{sin}⁡(4t)\\,j+3\\cdot 4\\operatorname{sin}⁡(4t)\\,k \\\\  & =20\\operatorname{cos}⁡(4t)\\,i-16\\operatorname{sin}⁡(4t)\\,j+12\\operatorname{sin}⁡(4t)\\,k \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(20\\operatorname{cos}⁡(4t))}^{2}+{(16\\operatorname{sin}⁡(4t))}^{2}+{(12\\operatorname{sin}⁡(4t))}^{2}} \\\\  & =\\sqrt{400{\\cos }^{2}⁡(4t)+256{\\sin }^{2}⁡(4t)+144{\\sin }^{2}⁡(4t)} \\\\  & =\\sqrt{400[{\\cos }^{2}⁡(4t)+{\\sin }^{2}⁡(4t)]} \\\\  & =20\\end{aligned}\n$$\n\nNext, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}20\\,\\text{d}u \\\\  & =20u\\,{|}_{0}^{t} \\\\  & =20t\\end{aligned}\n$$\n\n  \n\nNow, since $s=20t$, we have that\n\n$$\n\\begin{aligned}s & =20t \\\\ t & =\\frac{s}{20}.\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left(\\frac{s}{20}\\right) \\\\  & =5\\operatorname{sin}⁡\\left(4\\cdot \\frac{s}{20}\\right)i+4\\operatorname{cos}⁡\\left(4\\cdot \\frac{s}{20}\\right)j-3\\operatorname{cos}⁡\\left(4\\cdot \\frac{s}{20}\\right)k \\\\  & =5\\operatorname{sin}⁡\\left(\\frac{s}{5}\\right)i+4\\operatorname{cos}⁡\\left(\\frac{s}{5}\\right)j-3\\operatorname{cos}⁡\\left(\\frac{s}{5}\\right)k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443548 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21552ed1-365f-5f5f-9f16-05c0709bc3e6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "3\\left[{\\left(\\frac{s}{2}\\right)}^{3/4}-1\\right]" :db/id #edb/ref 17592186443493} {:answer/id #uuid "3329a212-2843-5cea-8b79-3333d2a3bf2b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\left[{\\left(\\frac{s}{4}-1\\right)}^{2/3}+1\\right]}^{2/3}" :db/id #edb/ref 17592186443495} {:answer/id #uuid "63ae5483-af4f-5b7e-81e0-1879fd88e830" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\left[{\\left(\\frac{s}{2}\\right)}^{3/2}+1\\right]" :db/id #edb/ref 17592186443500} {:answer/id #uuid "9188031a-cf46-5bd8-b259-521ae93aa9b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "6\\left[{\\left(\\frac{s}{4}\\right)}^{2/3}-1\\right]" :db/id #edb/ref 17592186443509} {:answer/id #uuid "bece495d-d450-5992-940a-15e713087f67" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "4{\\left[{\\left(\\frac{s}{4}+1\\right)}^{2/3}+1\\right]}^{3/2}" :db/id #edb/ref 17592186443519}] :answer-field/correct {:db/id #edb/ref 17592186443509} :answer-field/id #uuid "93649b9b-4496-5be5-8efe-dc54d74802dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443536}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "d79c5095-b4c8-55c2-88ef-92a621d4625c" :question/math-academy-id "q-34887" :question/problem "Consider the curve  $r(t)=(6t-6)\\,i+4(t-1)^{3/2}\\,j+2\\,k,$ $t\\ge 0,$ for which the arc length from $r(0)$ to $r(t)$ is given by $s=4{t}^{3/2}.$ Given that $R(s)$ is the parameterization of the given curve by its arc length $s,$ what is the $x$-component of $R?$" :question/worked-solution "First, since  $s=4{t}^{3/2}$,  we have that \n\n$$\n\\begin{aligned}s & =4{t}^{3/2} \\\\ {t}^{3/2} & =\\frac{s}{4} \\\\ t & ={\\left(\\frac{s}{4}\\right)}^{2/3}.\\end{aligned}\n$$\n\n \n\nThe vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left({\\left(\\frac{s}{4}\\right)}^{2/3}\\right) \\\\  & =\\left[6{\\left(\\frac{s}{4}\\right)}^{2/3}-6\\right]\\,i+4{\\left[{\\left(\\frac{s}{4}\\right)}^{2/3}-1\\right]}^{3/2}\\,j+2\\,k \\\\  & =6\\left[{\\left(\\frac{s}{4}\\right)}^{2/3}-1\\right]\\,i+4{\\left[{\\left(\\frac{s}{4}\\right)}^{2/3}-1\\right]}^{3/2}\\,j+2\\,k.\\end{aligned}\n$$\n\n \n\nSo, the $x$-component of $R$ is\n\n$$\n6\\left[{\\left(\\frac{s}{4}\\right)}^{2/3}-1\\right].\n$$"} {:db/id #edb/ref 17592186443549 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88524411-7322-5c13-a0d6-4635b37af634" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{s}{5},\\,\\frac{4s}{5},\\,1\\right\\rangle " :db/id #edb/ref 17592186443507} {:answer/id #uuid "9cf6e55a-b413-5aa8-ab0c-0067c9c7f83b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{s}{\\sqrt{5}},\\,\\frac{2s}{\\sqrt{5}},\\,1\\right\\rangle " :db/id #edb/ref 17592186443511} {:answer/id #uuid "c64215ca-c1b2-57b5-bdd6-c53bbb436663" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle s,\\,\\frac{4s}{3},\\,1\\right\\rangle " :db/id #edb/ref 17592186443520} {:answer/id #uuid "caf2317e-01bb-53d6-bd84-e85f0344d156" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{s}{3},\\,\\frac{2s}{3},\\,1\\right\\rangle " :db/id #edb/ref 17592186443523} {:answer/id #uuid "e10e8c34-d7a5-5c32-a5fb-5487a2156990" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "R(s)=\\left\\langle \\frac{3s}{5},\\,\\frac{4s}{5},\\,1\\right\\rangle " :db/id #edb/ref 17592186443526}] :answer-field/correct {:db/id #edb/ref 17592186443526} :answer-field/id #uuid "369bbd24-91f1-5851-8599-621408e0023b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443534}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "f674176f-f4e0-51c5-b4b9-0830e520af3b" :question/math-academy-id "q-127733" :question/problem "What is the parametrization of the curve $r(t)=\\left\\langle {t}^{3/2},\\,\\frac{4}{3}{t}^{3/2},\\,1\\right\\rangle ,$ $t\\ge 0,$ by its arc length $s?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\left\\langle \\frac{\\text{d}}{\\text{d}t}({t}^{3/2}),\\,\\frac{\\text{d}}{\\text{d}t}\\left(\\frac{4}{3}{t}^{3/2}\\right),\\,\\frac{\\text{d}}{\\text{d}t}(1)\\right\\rangle  \\\\  & =\\left\\langle \\frac{3}{2}{t}^{1/2},\\,2{t}^{1/2},\\,0\\right\\rangle  \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{\\left(\\frac{3}{2}{t}^{1/2}\\right)}^{2}+{(2{t}^{1/2})}^{2}+(0)^{2}} \\\\  & =\\sqrt{\\frac{9}{4}t+4t} \\\\  & =\\sqrt{\\frac{25}{4}t} \\\\  & =\\frac{5}{2}\\sqrt{t}\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}\\frac{5}{2}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{5}{2}{\\int }_{0}^{t}\\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{5}{3}\\sqrt{{u}^{3}}\\,{|}_{0}^{t} \\\\  & =\\frac{5}{3}\\sqrt{{t}^{3}}\\end{aligned}\n$$\n\nSince $s=\\frac{5}{3}\\sqrt{{t}^{3}},$ we have\n\n$$\n\\begin{aligned}\\frac{5}{3}\\sqrt{{t}^{3}} & =s \\\\ \\sqrt{{t}^{3}} & =\\frac{3s}{5} \\\\ t & ={\\left(\\frac{3s}{5}\\right)}^{2/3}.\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r\\left({\\left(\\frac{3s}{5}\\right)}^{2/3}\\right) \\\\  & =\\left\\langle {\\left({\\left(\\frac{3s}{5}\\right)}^{2/3}\\right)}^{3/2},\\,\\frac{4}{3}{\\left({\\left(\\frac{3s}{5}\\right)}^{2/3}\\right)}^{3/2},\\,1\\right\\rangle  \\\\  & =\\left\\langle \\frac{3s}{5},\\,\\frac{4}{3}\\cdot \\frac{3s}{5},\\,1\\right\\rangle  \\\\  & =\\left\\langle \\frac{3s}{5},\\,\\frac{4s}{5},\\,1\\right\\rangle .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186443714 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5227129a-cf10-5014-b945-9b282b56a162" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "743" :db/id #edb/ref 17592186443648} {:answer/id #uuid "5b6624e9-ff65-58e4-bb1a-cbc97c080b3a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "432" :db/id #edb/ref 17592186443650} {:answer/id #uuid "61625b6e-fafc-5735-99c7-51bacdd3efaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,465" :db/id #edb/ref 17592186443652} {:answer/id #uuid "6729961d-5125-51e3-9441-2b4cea93a506" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "727" :db/id #edb/ref 17592186443654} {:answer/id #uuid "725d6c8e-de45-5da8-bf6d-00039ba4a5a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "1\\,447" :db/id #edb/ref 17592186443657}] :answer-field/correct {:db/id #edb/ref 17592186443657} :answer-field/id #uuid "22f32989-72b2-5437-9672-f47842734fbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443695}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "680ba03b-6073-56c3-bf2a-b6b3fb6a93d2" :question/math-academy-id "q-159847" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4}$ is an I.I.D random sample with ${X}_{i}∼Po(\\theta )$ with unknown rate parameter $\\theta .$ You're given the particular sample\n\n$$\n{x}_{1}=3,\\,{x}_{2}=2,\\,{x}_{3}=1,\\,{x}_{4}=5.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=a\\theta +b\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡c.\n$$\n\nFind the value of $a+b+c.$\n\n*Hint: The probability mass function for a Poisson distribution is given by* \n\n$$\nf(x)=\\frac{{\\theta }^{x}{e}^{-\\theta }}{x!},\\,x=0,1,2,…\n$$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=4$ independent Poisson random variables with unknown parameter $\\theta .$ Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & ={e}^{-\\theta }\\cdot \\frac{{\\theta }^{x}}{x!}.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡\\left({e}^{-\\theta }\\cdot \\frac{{\\theta }^{{x}_{i}}}{{x}_{i}!}\\right) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta })+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡(\\theta )-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-\\theta {\\sum }_{i=1}^{n}1+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-n\\theta +\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-\\operatorname{ln}⁡({\\prod }_{i=1}^{n}{x}_{i}!)\\end{aligned}\n$$\n\nNow, using the sample data with $n=4,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i}! & =3!\\cdot 2!\\cdot 1!\\cdot 5!=6\\cdot 2\\cdot 1\\cdot 120=1\\,440, \\\\ {\\sum }_{i=1}^{n}{x}_{i} & =3+2+1+5=11.\\end{aligned}\n$$\n\nTherefore, substituting the above values into our expression for $l(\\theta ),$ we get\n\n$$\n\\begin{aligned}l(\\theta ) & =-4\\theta +11\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡1\\,440.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=-4+11+1\\,440=1\\,447.\n$$"} {:db/id #edb/ref 17592186443715 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d47b835-ad4c-501a-9bf3-e4f4532ec9be" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "83" :db/id #edb/ref 17592186443631} {:answer/id #uuid "26378f4c-2152-5e0e-ba87-0cec2f7febdc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "77" :db/id #edb/ref 17592186443633} {:answer/id #uuid "8e5663ed-f2a1-58f3-9568-27128d2426ae" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "72" :db/id #edb/ref 17592186443662} {:answer/id #uuid "9c40038c-0861-5bda-a994-e9dd2d1ed1e7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "23" :db/id #edb/ref 17592186443668} {:answer/id #uuid "a8389079-b7ba-53a7-aa1f-3d18031f7581" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "41" :db/id #edb/ref 17592186443673}] :answer-field/correct {:db/id #edb/ref 17592186443633} :answer-field/id #uuid "6df3f188-93fa-57a8-a9f9-cc6be388f8c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186443699}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "766020c7-f3e3-5fda-b856-3ebb3916a4d5" :question/math-academy-id "q-159846" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3}$ is an I.I.D random sample with ${X}_{i}∼Po(\\theta )$ with unknown rate parameter $\\theta .$ You're given the particular sample\n\n$$\n{x}_{1}=3,\\,{x}_{2}=3,\\,{x}_{3}=2.\n$$\n\nThe log-likelihood function of the sample is given by\n\n$$\nl(\\theta )=a\\theta +b\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡c.\n$$\n\nFind the value of $a+b+c.$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed discrete random variables with probability mass function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the log-likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\n\\begin{aligned}l(\\theta ) & =\\operatorname{ln}⁡L(\\theta ) \\\\  & =\\operatorname{ln}⁡({\\prod }_{i=1}^{n}f({x}_{i},\\theta )) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡(f({x}_{i},\\theta )).\\end{aligned}\n$$\n\nIn our case, we are given a sample of $n=3$ independent Poisson random variables with unknown parameter $\\theta .$ Therefore, the probability mass function is\n\n$$\n\\begin{aligned}f(x,\\theta ) & ={e}^{-\\theta }\\cdot \\frac{{\\theta }^{x}}{x!}.\\end{aligned}\n$$\n\nWe can calculate the log-likelihood function as follows:\n\n$$\n\\begin{aligned}l(\\theta ) & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡\\left({e}^{-\\theta }\\cdot \\frac{{\\theta }^{{x}_{i}}}{{x}_{i}!}\\right) \\\\  & ={\\sum }_{i=1}^{n}\\operatorname{ln}⁡({e}^{-\\theta })+\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({\\theta }^{{x}_{i}})-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & ={\\sum }_{i=1}^{n}(-\\theta )+{\\sum }_{i=1}^{n}{x}_{i}\\operatorname{ln}⁡(\\theta )-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-\\theta {\\sum }_{i=1}^{n}1+\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-{\\sum }_{i=1}^{n}\\operatorname{ln}⁡({x}_{i}!) \\\\  & =-n\\theta +\\operatorname{ln}⁡\\theta {\\sum }_{i=1}^{n}{x}_{i}-\\operatorname{ln}⁡({\\prod }_{i=1}^{n}{x}_{i}!)\\end{aligned}\n$$\n\nNow, using the sample data with $n=3,$ we have\n\n$$\n\\begin{aligned}{\\prod }_{i=1}^{n}{x}_{i}! & =3!\\cdot 3!\\cdot 2!=6\\cdot 6\\cdot 2=72, \\\\ {\\sum }_{i=1}^{n}{x}_{i} & =3+3+2=8.\\end{aligned}\n$$\n\nTherefore, substituting the above values into our expression for $l(\\theta ),$ we get\n\n$$\n\\begin{aligned}l(\\theta ) & =-3\\theta +8\\operatorname{ln}⁡\\theta -\\operatorname{ln}⁡72.\\end{aligned}\n$$\n\nFinally,\n\n$$\na+b+c=-3+8+72=77.\n$$"} {:db/id #edb/ref 17592186443717 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b42731d-ab12-5439-bd94-262e8f0cb47d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "9" :db/id #edb/ref 17592186