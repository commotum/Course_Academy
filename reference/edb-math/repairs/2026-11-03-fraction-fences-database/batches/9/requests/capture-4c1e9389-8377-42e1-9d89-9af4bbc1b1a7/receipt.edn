}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}{\\int }_{1}^{{x}^{2}+2{z}^{2}+2}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}[y]_{y=1}^{y={x}^{2}+2{z}^{2}+2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}({x}^{2}+2{z}^{2}+2)-1\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}{x}^{2}+2{z}^{2}+1\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[({x}^{2}+1)z+\\frac{2{z}^{3}}{3}]}_{z=-1}^{z=1}\\,dx \\\\  & ={\\int }_{0}^{2}({x}^{2}+1)(1-(-1))+\\frac{2}{3}({1}^{3}-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{2}2{x}^{2}+\\frac{10}{3}\\,dx \\\\  & ={[\\frac{2}{3}{x}^{3}+\\frac{10}{3}x]}_{x=0}^{x=2} \\\\  & =(\\frac{2}{3}(2)^{3}+\\frac{10}{3}(2))-0 \\\\  & =12.\\end{aligned}\n$$" 13194139545755 17592186576411 false] [17592186412210 1074 "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}{\\int }_{1}^{{x}^{2}+2{z}^{2}+2}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}[y]_{y=1}^{y={x}^{2}+2{z}^{2}+2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}({x}^{2}+2{z}^{2}+2)-1\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{-1}^{1}{x}^{2}+2{z}^{2}+1\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\left[({x}^{2}+1)z+\\frac{2{z}^{3}}{3}\\right]}_{z=-1}^{z=1}\\,dx \\\\  & ={\\int }_{0}^{2}({x}^{2}+1)(1-(-1))+\\frac{2}{3}({1}^{3}-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{2}2{x}^{2}+\\frac{10}{3}\\,dx \\\\  & ={\\left[\\frac{2}{3}{x}^{3}+\\frac{10}{3}x\\right]}_{x=0}^{x=2} \\\\  & =\\left(\\frac{2}{3}(2)^{3}+\\frac{10}{3}(2)\\right)-0 \\\\  & =12.\\end{aligned}\n$$" 13194139545755 17592186576411 true] [17592186412248 1074 "The mass of an object which occupies the region $D$ with mass density $\\lambda (x,y)=\\frac{1}{{x}^{2}+{y}^{2}}$ is given by\n\n$$\n\\begin{aligned}M & ={∬}_{D}\\frac{1}{{x}^{2}+{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nWe will convert this to polar coordinates using the change of variables formula in the form\n\n$$\n{∬}_{D}\\lambda (x,y)\\text{ }\\text{d}A={∬}_{Δ}\\text{ }\\lambda (r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion between the disks of radii $1$ and $4$ centered at the origin. \n\nThe following equations connect cartesian and polar coordinates:\n\n$$\n\\left\\{\\begin{aligned}x &=r\\operatorname{cos}⁡\\theta \\\\ y &=r\\operatorname{sin}⁡\\theta\\end{aligned}\\right.\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=1,$ we obtain $r=1.$\n\n- For ${x}^{2}+{y}^{2}=16,$ we obtain $r=4.$\n\nNow, let's find the limits for the parameter $\\theta .$ The entire region lies between the radial lines $\\theta =-\\frac{\\pi }{2}$ and $\\theta =0,$ as depicted below.  \n\n![](images/f2/f2dc1c7b6e558e0f645ad3b6c3d04182554a5778dd7490103bed6ac2e928bcf3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nD={(r,\\theta )\\,:\\,1\\le r\\le 4,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0}.\n$$\n\nFinally, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{1}{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{1}^{4}\\frac{r}{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{1}^{4}\\frac{1}{r}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}[\\operatorname{ln}⁡r]_{1}^{4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}(\\operatorname{ln}⁡4-\\operatorname{ln}⁡1)\\,\\text{d}\\theta  \\\\  & =2\\operatorname{ln}⁡2{\\int }_{-\\pi /2}^{0}\\,\\text{d}\\theta  \\\\  & =2\\operatorname{ln}⁡2[\\theta ]_{-\\pi /2}^{0} \\\\  & =2\\operatorname{ln}⁡2(0-\\left(-\\frac{\\pi }{2}\\right)) \\\\  & =\\pi \\operatorname{ln}⁡2.\\end{aligned}\n$$\n\nTherefore, the 