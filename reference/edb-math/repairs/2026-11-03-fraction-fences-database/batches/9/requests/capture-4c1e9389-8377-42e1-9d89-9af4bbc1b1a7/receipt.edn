d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{x},$ we get\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{e}^{{e}^{3}}{y}^{2}\\cdot \\frac{y}{x}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}[{\\int }_{e}^{{e}^{3}}\\frac{{y}^{3}}{x}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{2}{y}^{3}[\\operatorname{ln}⁡x]_{e}^{{e}^{3}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{{y}^{4}}{2}]}_{1}^{2} \\\\  & =8-\\frac{1}{2} \\\\  & =7.5.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the $x$-axis is $7.5\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" 13194139545755 17592186576411 false] [17592186426173 1074 "For a plane lamina $D$ with mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The moment of inertia about the $x$-axis is given by\n\n$$\n{I}_{x}={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the $y$-axis is given by\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A.\n$$\n\n- The moment of inertia about the origin is given by\n\n$$\n{I}_{0}={∬}_{D}({x}^{2}+{y}^{2})\\lambda (x,y)\\,\\text{d}A={I}_{x}+{I}_{y}.\n$$\n\nUsing the formula for ${I}_{x},$ we get\n\n$$\n\\begin{aligned}{I}_{x} & ={∬}_{D}{y}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{1}^{2}{\\int }_{e}^{{e}^{3}}{y}^{2}\\cdot \\frac{y}{x}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}\\left[{\\int }_{e}^{{e}^{3}}\\frac{{y}^{3}}{x}\\,\\text{d}x\\right]\\text{d}y \\\\  & ={\\int }_{1}^{2}{y}^{3}[\\operatorname{ln}⁡x]_{e}^{{e}^{3}}\\,\\text{d}y \\\\  & ={\\int }_{1}^{2}2{y}^{3}\\,\\text{d}y \\\\  & ={\\left[\\frac{{y}^{4}}{2}\\right]}_{1}^{2} \\\\  & =8-\\frac{1}{2} \\\\  & =7.5.\\end{aligned}\n$$\n\nTherefore, the moment of inertia of the lamina about the $x$-axis is $7.5\\,\\text{kg}\\cdot {\\text{m}}^{2}.$" 13194139545755 17592186576411 true] [17592186426267 1074 "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn this problem, the break point $X$ is uniformly distributed over the interval $[0,1]$, so the probability density function is\n\n$$\nf(x)=1,\\,0\\le x\\le 1.\n$$\n\nWhen the stick is broken at point $X$, it is divided into two pieces: one of length $X$ and the other of length $1-X.$ The longer of the two pieces, $Y,$ is therefore given by\n\n$$\nY=\\max (X,1-X).\n$$\n\nTherefore, we define\n\n$$\nr(x)=\\max (x,1-x).\n$$\n\nTo evaluate the integral, we express $r(x)$ as an explicit piecewise function. Observe that,\n\n- if $0\\le x\\le \\frac{1}{2}$, then $x\\le 1-x$, so the longer piece has length $1-x,$\n\n- if $\\frac{1}{2}<x\\le 1$, then $x>1-x$, so the longer piece has length $x.$\n\nTherefore,\n\n$$\nr(x)=\\left\\{\\begin{aligned}1-x, & \\,0\\le x\\le \\frac{1}{2}, \\\\ x, & \\,\\frac{1}{2}<x\\le 1.\\end{aligned}\\right.\n$$\n\nWe now apply the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[\\max (X,1-X)] \\\\  & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1/2}(1-x)\\cdot 1\\,\\text{d}x+{\\int }_{1/2}^{1}x\\cdot 1\\,\\text{d}x \\\\  & ={\\int }_{0}^{1/2}(1-x)\\,\\text{d}x+{\\int }_{1/2}^{1}x\\,\\text{d}x \\\\  & ={[x-\\frac{{x}^{2}}{2}]}_{0}^{1/2}+{[\\frac{{x}^{2}}{2}]}_{1/2}^{1} \\\\  & =(\\frac{1}{2}-\\frac{1}{2}\\cdot {\\left(\\frac{1}{2}\\right)}^{2})+(\\frac{1}{2}-\\frac{1}{2}\\cdot {\\left(\\frac{1}{2}\\right)}^{2}) \\\\  & =(\\frac{1}{2}-\\frac{1}{8})+(\\frac{1}{2}-\\frac{1}{8}) \\\\  & =\\frac{3}{8}+\\frac{3}{8} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the expected length of the longer piece is $\\frac{3}{4}.$" 13194139545755 17592186576411 false] [17592186426267 1074 "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn this problem, the break point $X$ is uniformly distributed over the interval $[0,1]$, so the probability density function is\n\n$$\nf(x)=1,\\,0\\le x\\le 1.\n$$\n\nWhen the stick is broken at point $X$, it is divided into two pieces: one of length $X$ and the other of length $1-X.$ The longer of the two pieces, $Y,$ is therefore given by\n\n$$\nY=\\max (X,1-X).\n$$\n\nTherefore, we define\n\n$$\nr(x)=\\max (x,1-x).\n$$\n\nTo evaluate the integral, we express $r(x)$ as an explicit piecewise function. Observe that,\n\n- if $0\\le x\\le \\frac{1}{2}$, then $x\\le 1-x$, so the longer piece has length $1-x,$\n\n- if $\\frac{1}{2}<x\\le 1$, then $x>1-x$, so the longer piece has length $x.$\n\nTherefore,\n\n$$\nr(x)=\\left\\{\\begin{aligned}1-x, & \\,0\\le x\\le \\frac{1}{2}, \\\\ x, & \\,\\frac{1}{2}<x\\le 1.\\end{aligned}\\right.\n$$\n\nWe now apply the rule of the lazy statistician:\n\n$$\n\\begin{aligned}\\text{E}[Y] & =\\text{E}[\\max (X,1-X)] \\\\  & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1/2}(1-x)\\cdot 1\\,\\text{d}x+{\\int }_{1/2}^{1}x\\cdot 1\\,\\text{d}x \\\\  & ={\\int }_{0}^{1/2}(1-x)\\,\\text{d}x+{\\int }_{1/2}^{1}x\\,\\text{d}x \\\\  & ={\\left[x-\\frac{{x}^{2}}{2}\\right]}_{0}^{1/2}+{\\left[\\frac{{x}^{2}}{2}\\right]}_{1/2}^{1} \\\\  & =\\left(\\frac{1}{2}-\\frac{1}{2}\\cdot {\\left(\\frac{1}{2}\\right)}^{2}\\right)+\\left(\\frac{1}{2}-\\frac{1}{2}\\cdot {\\left(\\frac{1}{2}\\right)}^{2}\\right) \\\\  & =\\left(\\frac{1}{2}-\\frac{1}{8}\\right)+\\left(\\frac{1}{2}-\\frac{1}{8}\\right) \\\\  & =\\frac{3}{8}+\\frac{3}{8} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the expected length of the longer piece is $\\frac{3}{4}.$" 13194139545755 17592186576411 true] [17592186426270 1071 "Find $\\text{E}[\\frac{{X}^{2}}{8}],$ given that the continuous random variable $X$ has the probability density function\n\n$$\nf(x)=\\left\\{\\begin{aligned}\\frac{4}{{x}^{5}}, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\n$$" 13194139545755 17592186576411 false] [17592186426270 1071 "Find $\\text{E}\\left[\\frac{{X}^{2}}{8}\\right],$ given that the continuous random variable $X$ has the probability density function\n\n$$\nf(x)=\\left\\{\\begin{aligned}\\frac{4}{{x}^{5}}, & x\\ge 1 \\\\ 0, & \\text{otherwise}\\end{aligned}\\right.\n$$" 13194139545755 17592186576411 true] [17592186426270 1074 "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn our case, we have \n\n$$\nr(x)=\\frac{{x}^{2}}{8}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[\\frac{{X}^{2}}{8}] & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{{x}^{2}}{8}\\cdot \\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{[-\\frac{1}{2{x}^{2}}]}_{1}^{\\infty } \\\\  & =\\frac{1}{2}(-0+\\frac{1}{2}) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" 13194139545755 17592186576411 false] [17592186426270 1074 "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn our case, we have \n\n$$\nr(x)=\\frac{{x}^{2}}{8}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}\\left[\\frac{{X}^{2}}{8}\\right] & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{\\infty }\\frac{{x}^{2}}{8}\\cdot \\frac{4}{{x}^{5}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\left[-\\frac{1}{2{x}^{2}}\\right]}_{1}^{\\infty } \\\\  & =\\frac{1}{2}\\left(-0+\\frac{1}{2}\\right) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" 13194139545755 17592186576411 true] [17592186426271 1074 "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn our case, we have \n\n$$\nr(x)={e}^{2x}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{e}^{2X}] & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{2x}\\cdot \\frac{{e}^{x}}{e-1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{3x}}{e-1}\\text{d}x \\\\  & ={[\\frac{1}{3(e-1)}{e}^{3x}]}_{0}^{1} \\\\  & =\\frac{1}{3(e-1)}{e}^{3}-\\frac{1}{3(e-1)} \\\\  & =\\frac{{e}^{3}-1}{3(e-1)}.\\end{aligned}\n$$" 13194139545755 17592186576411 false] [17592186426271 1074 "For a continuous random variable $X$ and a function $r(x),$ the rule of the lazy statistician states that \n\n$$\n\\text{E}[r(X)]={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x.\n$$\n\nIn our case, we have \n\n$$\nr(x)={e}^{2x}.\n$$\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\text{E}[{e}^{2X}] & ={\\int }_{-\\infty }^{\\infty }r(x)f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{2x}\\cdot \\frac{{e}^{x}}{e-1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{{e}^{3x}}{e-1}\\text{d}x \\\\  & ={\\left[\\frac{1}{3(e-1)}{e}^{3x}\\right]}_{0}^{1} \\\\  & =\\frac{1}{3(e-1)}{e}^{3}-\\frac{1}{3(e-1)} \\\\  & =\\frac{{e}^{3}-1}{3(e-1)}.\\end{aligned}\n$$" 13194139545755 17592186576411 true] [17592186426426 1071 "If $X∼B(4,\\frac{1}{2}),$ then, **rounded to $3$ decimal places**, $P(X>2)≈${{field-1}}." 13194139545755 17592186576411 false] [17592186426426 1071 "If $X∼B\\left(4,\\frac{1}{2}\\right),$ then, **rounded to $3$ decimal places**, $P(X>2)≈${{field-1}}." 13194139545755 17592186576411 true] [17592186426426 1074 "For a binomial random variable $X∼B(n,p),$ where $n$