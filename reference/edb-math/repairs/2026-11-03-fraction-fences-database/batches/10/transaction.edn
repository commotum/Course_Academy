d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}27{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\cdot 3\\cdot \\text{d}\\theta  \\\\  & =81{\\int }_{0}^{\\pi /6}{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=\\operatorname{sin}⁡\\theta ,$ $\\text{d}u=\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta $ as follows:\n\n$$\n\\begin{aligned}81{\\int }_{0}^{\\pi /6}{\\sin }^{5}⁡\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =81{\\int }_{0}^{1/2}{u}^{5}\\,\\text{d}u \\\\  & =81\\cdot \\frac{1}{6}{u}^{6}\\,{|}_{0}^{1/2} \\\\  & =\\frac{27}{2}\\left(\\left(\\frac{1}{2}\\right)^{6}-{0}^{6}\\right) \\\\  & =\\frac{27}{128}\\end{aligned}\n$$"] [:db/cas 17592186458620 :answer/value "⟨-\\frac{1}{2},\\,\\frac{1}{2},\\,2⟩" "\\left\\langle -\\frac{1}{2},\\,\\frac{1}{2},\\,2\\right\\rangle "] [:db/cas 17592186458652 :answer/value "⟨-\\frac{1}{2},\\,1,\\,0⟩" "\\left\\langle -\\frac{1}{2},\\,1,\\,0\\right\\rangle "] [:db/cas 17592186458672 :answer/value "⟨-\\frac{1}{2},\\,-\\frac{1}{2},\\,2⟩" "\\left\\langle -\\frac{1}{2},\\,-\\frac{1}{2},\\,2\\right\\rangle "] [:db/cas 17592186458673 :answer/value "⟨\\frac{1}{2},\\,1,\\,0⟩" "\\left\\langle \\frac{1}{2},\\,1,\\,0\\right\\rangle "] [:db/cas 17592186458781 :answer/value "⟨\\frac{3}{4},\\,-3,\\,-14⟩" "\\left\\langle \\frac{3}{4},\\,-3,\\,-14\\right\\rangle "] [:db/cas 17592186458826 :answer/value "$(-1,2)$ and $(-\\frac{1}{4},-1)$" "$(-1,2)$ and $\\left(-\\frac{1}{4},-1\\right)$"] [:db/cas 17592186458870 :answer/value "⟨4,\\,1,\\,\\frac{1}{3}⟩" "\\left\\langle 4,\\,1,\\,\\frac{1}{3}\\right\\rangle "] [:db/cas 17592186458881 :answer/value "⟨0,\\,\\frac{3}{2},\\,-5⟩" "\\left\\langle 0,\\,\\frac{3}{2},\\,-5\\right\\rangle "] [:db/cas 17592186458892 :answer/value "$(1,\\frac{2}{3})$ only" "$\\left(1,\\frac{2}{3}\\right)$ only"] [:db/cas 17592186458993 :answer/value "$(0,0)$ and $(1,\\frac{2}{3})$" "$(0,0)$ and $\\left(1,\\frac{2}{3}\\right)$"] [:db/cas 17592186459010 :answer/value "⟨\\frac{1}{2},\\,-1,\\,0⟩" "\\left\\langle \\frac{1}{2},\\,-1,\\,0\\right\\rangle "] [:db/cas 17592186459205 :question/worked-solution "We combine the like terms by subtracting the coefficients:\n\n$$\n\\begin{aligned}\\frac{5}{2}q-\\frac{7}{6}q &= (\\frac{5}{2}-\\frac{7}{6})q\\end{aligned}\n$$\n\nIn order to subtract the coefficients, we have to convert them to have the same denominator:\n\n$$\n\\begin{aligned}(\\frac{5}{2}-\\frac{7}{6})q &= (\\frac{15}{6}-\\frac{7}{6})q \\\\ &= \\left(\\frac{15-7}{6}\\right)q \\\\ &= \\frac{8}{6}q \\\\ &= \\frac{4}{3}\\,q\\end{aligned}\n$$" "We combine the like terms by subtracting the coefficients:\n\n$$\n\\begin{aligned}\\frac{5}{2}q-\\frac{7}{6}q &= \\left(\\frac{5}{2}-\\frac{7}{6}\\right)q\\end{aligned}\n$$\n\nIn order to subtract the coefficients, we have to convert them to have the same denominator:\n\n$$\n\\begin{aligned}\\left(\\frac{5}{2}-\\frac{7}{6}\\right)q &= \\left(\\frac{15}{6}-\\frac{7}{6}\\right)q \\\\ &= \\left(\\frac{15-7}{6}\\right)q \\\\ &= \\frac{8}{6}q \\\\ &= \\frac{4}{3}\\,q\\end{aligned}\n$$"] [:db/cas 17592186459206 :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{y}{8}+7-\\frac{3y}{8}-11 &= (\\frac{y}{8}-\\frac{3y}{8})+(7-11) \\\\ &= \\left(\\frac{y-3y}{8}\\right)-4 \\\\ &= -\\frac{2y}{8}-4 \\\\ &= -\\frac{y}{4}-4\\end{aligned}\n$$" "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{y}{8}+7-\\frac{3y}{8}-11 &= \\left(\\frac{y}{8}-\\frac{3y}{8}\\right)+(7-11) \\\\ &= \\left(\\frac{y-3y}{8}\\right)-4 \\\\ &= -\\frac{2y}{8}-4 \\\\ &= -\\frac{y}{4}-4\\end{aligned}\n$$"] [:db/cas 17592186459207 :question/problem "Find the average value ${g}_{\\text{avg}}$ of the function $g(x)=4\\operatorname{cos}⁡5x+2\\operatorname{cos}⁡3x$ on the interval $[0,\\frac{\\pi }{6}].$ Do not round the answer.\n\n${g}_{\\text{avg}}=$\n{{field-1}}" "Find the average value ${g}_{\\text{avg}}$ of the function $g(x)=4\\operatorname{cos}⁡5x+2\\operatorname{cos}⁡3x$ on the interval $\\left[0,\\frac{\\pi }{6}\\right].$ Do not round the answer.\n\n${g}_{\\text{avg}}=$\n{{field-1}}"] [:db/cas 17592186459207 :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}g(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\frac{\\pi }{6}-0}{\\int }_{0}^{\\pi /6}(4\\operatorname{cos}⁡5x+2\\operatorname{cos}⁡3x)\\,\\text{d}x \\\\  & =\\frac{6}{\\pi }{\\int }_{0}^{\\pi /6}(4\\operatorname{cos}⁡5x+2\\operatorname{cos}⁡3x)\\,\\text{d}x \\\\  & ={\\frac{6}{\\pi }(\\frac{4}{5}\\operatorname{sin}⁡5x+\\frac{2}{3}\\operatorname{sin}⁡3x)|}_{0}^{\\pi /6} \\\\  & =\\frac{6}{\\pi }[(\\frac{4}{5}\\operatorname{sin}⁡(5\\cdot \\frac{\\pi }{6})+\\frac{2}{3}\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{6}))-(\\frac{4}{5}\\operatorname{sin}⁡(5\\cdot 0)+\\frac{2}{3}\\operatorname{sin}⁡(3\\cdot 0))] \\\\  & =\\frac{6}{\\pi }[(\\frac{4}{5}\\operatorname{sin}⁡\\left(\\frac{5\\pi }{6}\\right)+\\frac{2}{3}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right))-(0+0)] \\\\  & =\\frac{6}{\\pi }[(\\frac{4}{5}\\cdot \\frac{1}{2}+\\frac{2}{3}\\cdot 1)-0] \\\\  & =\\frac{6}{\\pi }(\\frac{2}{5}+\\frac{2}{3}) \\\\  & =\\frac{6}{\\pi }\\cdot \\frac{16}{15} \\\\  & =\\frac{32}{5\\pi }.\\end{aligned}\n$$" "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}g(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\frac{\\pi }{6}-0}{\\int }_{0}^{\\pi /6}(4\\operatorname{cos}⁡5x+2\\operatorname{cos}⁡3x)\\,\\text{d}x \\\\  & =\\frac{6}{\\pi }{\\int }_{0}^{\\pi /6}(4\\operatorname{cos}⁡5x+2\\operatorname{cos}⁡3x)\\,\\text{d}x \\\\  & ={\\frac{6}{\\pi }\\left(\\frac{4}{5}\\operatorname{sin}⁡5x+\\frac{2}{3}\\operatorname{sin}⁡3x\\right)|}_{0}^{\\pi /6} \\\\  & =\\frac{6}{\\pi }\\left[\\left(\\frac{4}{5}\\operatorname{sin}⁡\\left(5\\cdot \\frac{\\pi }{6}\\right)+\\frac{2}{3}\\operatorname{sin}⁡\\left(3\\cdot \\frac{\\pi }{6}\\right)\\right)-\\left(\\frac{4}{5}\\operatorname{sin}⁡(5\\cdot 0)+\\frac{2}{3}\\operatorname{sin}⁡(3\\cdot 0)\\right)\\right] \\\\  & =\\frac{6}{\\pi }\\left[\\left(\\frac{4}{5}\\operatorname{sin}⁡\\left(\\frac{5\\pi }{6}\\right)+\\frac{2}{3}\\operatorname{sin}⁡\\left(\\frac{\\pi }{2}\\right)\\right)-(0+0)\\right] \\\\  & =\\frac{6}{\\pi }\\left[\\left(\\frac{4}{5}\\cdot \\frac{1}{2}+\\frac{2}{3}\\cdot 1\\right)-0\\right] \\\\  & =\\frac{6}{\\pi }\\left(\\frac{2}{5}+\\frac{2}{3}\\right) \\\\  & =\\frac{6}{\\pi }\\cdot \\frac{16}{15} \\\\  & =\\frac{32}{5\\pi }.\\end{aligned}\n$$"] [:db/cas 17592186459208 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/48/4822bfa926feccb0a12c14580ac325f4f10a0e4f815d0247b2231bf08b8c2326.png)\n\nSince $P(x,y)={y}^{2}-\\operatorname{ln}(1+{\\operatorname{cos}}^{2}x)$ and $Q(x,y)={x}^{2}+3xy,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=2x+3y.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({y}^{2}-\\operatorname{ln}(1+{\\operatorname{cos}}^{2}x))\\hspace{0.167em}\\mathrm{d}x+({x}^{2}+3xy)\\hspace{0.167em}\\mathrm{d}y & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2x+3y-2y)\\hspace{0.167em}\\text{d}A \\\\  & ={∬}_{D}(2x+y)\\hspace{0.167em}\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(2x+y)\\,\\text{d}A & ={∬}_{Δ}(2r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\,{\\int }_{0}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,dr\\,d\\theta .\\end{aligned}\n$$" "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/48/4822bfa926feccb0a12c14580ac325f4f10a0e4f815d0247b2231bf08b8c2326.png)\n\nSince $P(x,y)={y}^{2}-\\operatorname{ln}(1+{\\operatorname{cos}}^{2}x)$ and $Q(x,y)={x}^{2}+3xy,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=2y,\\,\\frac{∂Q}{∂x}=2x+3y.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({y}^{2}-\\operatorname{ln}(1+{\\operatorname{cos}}^{2}x))\\hspace{0.167em}\\mathrm{d}x+({x}^{2}+3xy)\\hspace{0.167em}\\mathrm{d}y & ={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\text{d}A \\\\  & ={∬}_{D}(2x+3y-2y)\\hspace{0.167em}\\text{d}A \\\\  & ={∬}_{D}(2x+y)\\hspace{0.167em}\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(2x+y)\\,\\text{d}A & ={∬}_{Δ}(2r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\,{\\int }_{0}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,dr\\,d\\theta .\\end{aligned}\n$$"] [:db/cas 17592186459214 :question/problem "Calculate $$\n\\displaystyle {\\int }_{0}^{1}[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)]\\,\\text{d}t\n$$ given that $$\n\\displaystyle {\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨3,\\,6,\\,-3⟩\n$$ and $$\n\\displaystyle {\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨4,\\,2,\\,10⟩.\n$$" "Calculate $$\n\\displaystyle {\\int }_{0}^{1}\\left[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)\\right]\\,\\text{d}t\n$$ given that $$\n\\displaystyle {\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨3,\\,6,\\,-3⟩\n$$ and $$\n\\displaystyle {\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨4,\\,2,\\,10⟩.\n$$"] [:db/cas 17592186459214 :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{1}[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)]\\,\\text{d}t=\\frac{2}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t+\\frac{1}{2}{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)]\\,\\text{d}t & =\\frac{2}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t+\\frac{1}{2}{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =\\frac{2}{3}⟨3,\\,6,\\,-3⟩+\\frac{1}{2}⟨4,\\,2,\\,10⟩ \\\\  & =⟨2,\\,4,\\,-2⟩+⟨2,\\,1,\\,5⟩ \\\\  & =⟨4,\\,5,\\,3⟩.\\end{aligned}\n$$" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{1}\\left[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)\\right]\\,\\text{d}t=\\frac{2}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t+\\frac{1}{2}{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\left[\\frac{2}{3}f(t)+\\frac{1}{2}g(t)\\right]\\,\\text{d}t & =\\frac{2}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t+\\frac{1}{2}{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =\\frac{2}{3}⟨3,\\,6,\\,-3⟩+\\frac{1}{2}⟨4,\\,2,\\,10⟩ \\\\  & =⟨2,\\,4,\\,-2⟩+⟨2,\\,1,\\,5⟩ \\\\  & =⟨4,\\,5,\\,3⟩.\\end{aligned}\n$$"] [:db/cas 17592186459215 :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{4-(-2)}{\\int }_{-2}^{4}2{x}^{2}+10\\,\\text{d}x \\\\  & ={\\frac{1}{6}\\cdot (\\frac{2{x}^{3}}{3}+10x)|}_{-2}^{4} \\\\  & =\\frac{1}{6}[(\\frac{2\\cdot {4}^{3}}{3}+10\\cdot 4)-(\\frac{2\\cdot (-2)^{3}}{3}+10\\cdot (-2))] \\\\  & =\\frac{1}{6}\\cdot 108 \\\\  & =18.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =18 \\\\ 2{c}^{2}+10 & =18 \\\\ {c}^{2} & =4 \\\\ c & =\\pm 2\\end{aligned}\n$$" "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{4-(-2)}{\\int }_{-2}^{4}2{x}^{2}+10\\,\\text{d}x \\\\  & ={\\frac{1}{6}\\cdot \\left(\\frac{2{x}^{3}}{3}+10x\\right)|}_{-2}^{4} \\\\  & =\\frac{1}{6}\\left[\\left(\\frac{2\\cdot {4}^{3}}{3}+10\\cdot 4\\right)-\\left(\\frac{2\\cdot (-2)^{3}}{3}+10\\cdot (-2)\\right)\\right] \\\\  & =\\frac{1}{6}\\cdot 108 \\\\  & =18.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =18 \\\\ 2{c}^{2}+10 & =18 \\\\ {c}^{2} & =4 \\\\ c & =\\pm 2\\end{aligned}\n$$"] [:db/cas 17592186459219 :question/problem "Find the average value ${f}_{\\text{avg}}$ of the function $f(x)=\\operatorname{cos}⁡(2x)$ on the interval $[0,\\frac{\\pi }{3}].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" "Find the average value ${f}_{\\text{avg}}$ of the function $f(x)=\\operatorname{cos}⁡(2x)$ on the interval $\\left[0,\\frac{\\pi }{3}\\right].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}"] [:db/cas 17592186459219 :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{(\\frac{\\pi }{3}-0)}{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{3}{\\pi }{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & ={\\frac{3}{\\pi }\\left(\\frac{\\operatorname{sin}⁡(2x)}{2}\\right)|}_{0}^{\\pi /3} \\\\  & =\\frac{3}{\\pi }[\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{2\\pi }{3}\\right)-\\frac{1}{2}\\operatorname{sin}⁡(0)] \\\\  & =\\frac{3}{\\pi }(\\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{3}{\\pi }\\cdot \\frac{\\sqrt{3}}{4} \\\\  & =\\frac{3\\sqrt{3}}{4\\pi }.\\end{aligned}\n$$" "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\left(\\frac{\\pi }{3}-0\\right)}{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{3}{\\pi }{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & ={\\frac{3}{\\pi }\\left(\\frac{\\operatorname{sin}⁡(2x)}{2}\\right)|}_{0}^{\\pi /3} \\\\  & =\\frac{3}{\\pi }\\left[\\frac{1}{2}\\operatorname{sin}⁡\\left(\\frac{2\\pi }{3}\\right)-\\frac{1}{2}\\operatorname{sin}⁡(0)\\right] \\\\  & =\\frac{3}{\\pi }\\left(\\frac{1}{2}\\cdot \\frac{\\sqrt{3}}{2}\\right) \\\\  & =\\frac{3}{\\pi }\\cdot \\frac{\\sqrt{3}}{4} \\\\  & =\\frac{3\\sqrt{3}}{4\\pi }.\\end{aligned}\n$$"] [:db/cas 17592186459223 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/f3/f393d0facc98fe365e2c622e24223d6045b48b490937ba6e2f25d86d7eb4810f.png)\n\nNow, since \n\n$$\nP(x,y)={e}^{x}-8{x}^{2}y,\\,Q(x,y)={y}^{7}+8x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-8{x}^{2},\\,\\frac{∂Q}{∂x}=8{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x}-8{x}^{2}y)dx+({y}^{7}+8x{y}^{2})\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(8{y}^{2}-(-8{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}8({r}^{2}{\\cos }^{2}⁡\\theta +{r}^{2}{\\sin }^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}[2{r}^{4}]_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}32\\,\\text{d}\\theta  \\\\  & =32[\\theta ]_{-\\pi /2}^{0} \\\\  & =32\\cdot \\frac{\\pi }{2} \\\\  & =16\\pi .\\end{aligned}\n$$" "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/f3/f393d0facc98fe365e2c622e24223d6045b48b490937ba6e2f25d86d7eb4810f.png)\n\nNow, since \n\n$$\nP(x,y)={e}^{x}-8{x}^{2}y,\\,Q(x,y)={y}^{7}+8x{y}^{2},\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-8{x}^{2},\\,\\frac{∂Q}{∂x}=8{y}^{2}.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}({e}^{x}-8{x}^{2}y)dx+({y}^{7}+8x{y}^{2})\\,dy & ={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\text{d}A \\\\  & ={∬}_{D}(8{y}^{2}-(-8{x}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le 0\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows: \n\n$$\n\\begin{aligned}{∬}_{D}8({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}8({r}^{2}{\\cos }^{2}⁡\\theta +{r}^{2}{\\sin }^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}({\\cos }^{2}⁡\\theta +{\\sin }^{2}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}{\\int }_{0}^{2}8{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}[2{r}^{4}]_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{0}32\\,\\text{d}\\theta  \\\\  & =32[\\theta ]_{-\\pi /2}^{0} \\\\  & =32\\cdot \\frac{\\pi }{2} \\\\  & =16\\pi .\\end{aligned}\n$$"] [:db/cas 17592186459225 :question/worked-solution "The dot product rule states that\n\n$$\n{\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{1}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{1}^{2}f(t)\\,\\text{d}t \\\\  & =(2\\,i-\\,k)\\cdot (\\frac{\\pi }{2}\\,i+\\,j+2\\pi \\,k) \\\\  & =\\pi -2\\pi  \\\\  & =-\\pi .\\end{aligned}\n$$" "The dot product rule states that\n\n$$\n{\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{1}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{1}^{2}f(t)\\,\\text{d}t \\\\  & =(2\\,i-\\,k)\\cdot \\left(\\frac{\\pi }{2}\\,i+\\,j+2\\pi \\,k\\right) \\\\  & =\\pi -2\\pi  \\\\  & =-\\pi .\\end{aligned}\n$$"] [:db/cas 17592186459226 :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{2}{5}m+8-\\frac{6}{5}m-3 &= (\\frac{2}{5}m-\\frac{6}{5}m)+(8-3) \\\\ &= \\left(\\frac{2-6}{5}\\right)m+5 \\\\ &= -\\frac{4}{5}m+5\\end{aligned}\n$$" "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{2}{5}m+8-\\frac{6}{5}m-3 &= \\left(\\frac{2}{5}m-\\frac{6}{5}m\\right)+(8-3) \\\\ &= \\left(\\frac{2-6}{5}\\right)m+5 \\\\ &= -\\frac{4}{5}m+5\\end{aligned}\n$$"] [:db/cas 17592186459228 :question/problem "$2a+8(\\frac{5a}{2}-\\frac{b}{4})=${{field-1}}\n$a\\,-$\n{{field-2}}\n$b$" "$2a+8\\left(\\frac{5a}{2}-\\frac{b}{4}\\right)=${{field-1}}\n$a\\,-$\n{{field-2}}\n$b$"] [:db/cas 17592186459228 :question/worked-solution "First, we apply the distributive law:\n\n$$\n\\begin{aligned}2a+8(\\frac{5a}{2}-\\frac{b}{4}) &= 2a+8\\left(\\frac{5a}{2}\\right)-8\\left(\\frac{b}{4}\\right) \\\\ &= 2a+\\frac{40a}{2}-\\frac{8b}{4} \\\\ &= 2a+20a-2b\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}2a+20a-2b &= (2a+20a)-2b \\\\ &= 22\\,a-2\\,b\\end{aligned}\n$$" "First, we apply the distributive law:\n\n$$\n\\begin{aligned}2a+8\\left(\\frac{5a}{2}-\\frac{b}{4}\\right) &= 2a+8\\left(\\frac{5a}{2}\\right)-8\\left(\\frac{b}{4}\\right) \\\\ &= 2a+\\frac{40a}{2}-\\frac{8b}{4} \\\\ &= 2a+20a-2b\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}2a+20a-2b &= (2a+20a)-2b \\\\ &= 22\\,a-2\\,b\\end{aligned}\n$$"] [:db/cas 17592186459232 :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{3-0}{\\int }_{0}^{3}{x}^{2}-4x\\,\\text{d}x \\\\  & ={\\frac{1}{3}\\cdot (\\frac{{x}^{3}}{3}-2{x}^{2})|}_{0}^{3} \\\\  & =\\frac{1}{3}[(\\frac{{3}^{3}}{3}-2\\cdot {3}^{2})-(\\frac{{0}^{3}}{3}-2\\cdot {0}^{2})] \\\\  & =\\frac{1}{3}\\cdot [(9-18)-(0-0)] \\\\  & =\\frac{1}{3}\\cdot (-9) \\\\  & =-3.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =-3 \\\\ {c}^{2}-4c & =-3 \\\\ {c}^{2}-4c+3 & =0 \\\\ (c-2)^{2}-1 & =0 \\\\ c-2 & =\\pm 1 \\\\ c & =1,\\,3\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $c$ that satisfy the mean value theorem on the interval $[0,3]$ are \n\n$$\nc=1,\\,\\text{and}\\,c=3.\n$$" "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{3-0}{\\int }_{0}^{3}{x}^{2}-4x\\,\\text{d}x \\\\  & ={\\frac{1}{3}\\cdot \\left(\\frac{{x}^{3}}{3}-2{x}^{2}\\right)|}_{0}^{3} \\\\  & =\\frac{1}{3}\\left[\\left(\\frac{{3}^{3}}{3}-2\\cdot {3}^{2}\\right)-\\left(\\frac{{0}^{3}}{3}-2\\cdot {0}^{2}\\right)\\right] \\\\  & =\\frac{1}{3}\\cdot [(9-18)-(0-0)] \\\\  & =\\frac{1}{3}\\cdot (-9) \\\\  & =-3.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =-3 \\\\ {c}^{2}-4c & =-3 \\\\ {c}^{2}-4c+3 & =0 \\\\ (c-2)^{2}-1 & =0 \\\\ c-2 & =\\pm 1 \\\\ c & =1,\\,3\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $c$ that satisfy the mean value theorem on the interval $[0,3]$ are \n\n$$\nc=1,\\,\\text{and}\\,c=3.\n$$"] [:db/cas 17592186459234 :question/worked-solution "Green's theorem states that \n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/04/0470588a034222b183694b087d417e8ead0d2fd72357e796373794d00523708f.png)\n\nSince $P(x,y)=x+y$ and $Q(x,y)=-{x}^{2}y,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=1,\\,\\frac{∂Q}{∂x}=-2xy.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(x+y)\\,dx-{x}^{2}y\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(-2xy-1)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 5,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(-2xy-1)\\,\\text{d}A & ={∬}_{Δ}(-2\\cdot r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta -1)\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}(-2{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta -r)\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{\\int }_{0}^{5}-{r}^{3}\\operatorname{sin}⁡(2\\theta )-r\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" "Green's theorem states that \n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/04/0470588a034222b183694b087d417e8ead0d2fd72357e796373794d00523708f.png)\n\nSince $P(x,y)=x+y$ and $Q(x,y)=-{x}^{2}y,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=1,\\,\\frac{∂Q}{∂x}=-2xy.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(x+y)\\,dx-{x}^{2}y\\,dy & ={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\text{d}A \\\\  & ={∬}_{D}(-2xy-1)\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 5,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(-2xy-1)\\,\\text{d}A & ={∬}_{Δ}(-2\\cdot r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta -1)\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}(-2{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta -r)\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{\\int }_{0}^{5}-{r}^{3}\\operatorname{sin}⁡(2\\theta )-r\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186459237 :question/problem "Calculate $$\n\\displaystyle {\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t\n$$ given that $$\n\\displaystyle {\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨-\\frac{1}{4},\\,-\\frac{3}{2},\\,-2⟩\n$$ and $$\n\\displaystyle {\\int }_{1}^{3}g(t)\\,\\text{d}t=⟨\\frac{2}{3},\\,-1,\\,2⟩.\n$$" "Calculate $$\n\\displaystyle {\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t\n$$ given that $$\n\\displaystyle {\\int }_{1}^{3}f(t)\\,\\text{d}t=\\left\\langle -\\frac{1}{4},\\,-\\frac{3}{2},\\,-2\\right\\rangle \n$$ and $$\n\\displaystyle {\\int }_{1}^{3}g(t)\\,\\text{d}t=\\left\\langle \\frac{2}{3},\\,-1,\\,2\\right\\rangle .\n$$"] [:db/cas 17592186459237 :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t=4{\\int }_{1}^{3}f(t)\\,\\text{d}t-3{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t & =4{\\int }_{1}^{3}f(t)\\,\\text{d}t-3{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =4⟨-\\frac{1}{4},\\,-\\frac{3}{2},\\,-2⟩-3⟨\\frac{2}{3},\\,-1,\\,2⟩ \\\\  & =⟨-1,\\,-6,\\,-8⟩-⟨2,\\,-3,\\,6⟩ \\\\  & =⟨-3,\\,-3,\\,-14⟩.\\end{aligned}\n$$" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t=4{\\int }_{1}^{3}f(t)\\,\\text{d}t-3{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[4f(t)-3g(t)]\\,\\text{d}t & =4{\\int }_{1}^{3}f(t)\\,\\text{d}t-3{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =4\\left\\langle -\\frac{1}{4},\\,-\\frac{3}{2},\\,-2\\right\\rangle -3\\left\\langle \\frac{2}{3},\\,-1,\\,2\\right\\rangle  \\\\  & =⟨-1,\\,-6,\\,-8⟩-⟨2,\\,-3,\\,6⟩ \\\\  & =⟨-3,\\,-3,\\,-14⟩.\\end{aligned}\n$$"] [:db/cas 17592186459242 :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{4-0}{\\int }_{0}^{4}\\sqrt{x}\\,\\text{d}x \\\\  & ={\\frac{1}{4}\\cdot (\\frac{2}{3}{x}^{3/2})|}_{0}^{4} \\\\  & =\\frac{1}{4}[\\frac{2}{3}\\cdot {4}^{3/2}-\\frac{2}{3}\\cdot {0}^{3/2}] \\\\  & =\\frac{1}{4}\\cdot \\frac{16}{3} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =\\frac{4}{3} \\\\ \\sqrt{c} & =\\frac{4}{3} \\\\ c & =\\frac{16}{9}\\end{aligned}\n$$" "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{4-0}{\\int }_{0}^{4}\\sqrt{x}\\,\\text{d}x \\\\  & ={\\frac{1}{4}\\cdot \\left(\\frac{2}{3}{x}^{3/2}\\right)|}_{0}^{4} \\\\  & =\\frac{1}{4}\\left[\\frac{2}{3}\\cdot {4}^{3/2}-\\frac{2}{3}\\cdot {0}^{3/2}\\right] \\\\  & =\\frac{1}{4}\\cdot \\frac{16}{3} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =\\frac{4}{3} \\\\ \\sqrt{c} & =\\frac{4}{3} \\\\ c & =\\frac{16}{9}\\end{aligned}\n$$"] [:db/cas 17592186459249 :question/problem "Calculate \n$$\n\\displaystyle {\\int }_{-1}^{3}[\\frac{1}{3}f(t)+2g(t)]\\text{d}t\n$$ \ngiven that \n$$\n\\displaystyle {\\int }_{-1}^{3}f(t)\\,\\text{d}t=⟨-3,\\,6,\\,3⟩\n$$\nand \n$$\n\\displaystyle {\\int }_{-1}^{3}g(t)\\,\\text{d}t=⟨-\\frac{1}{2},\\,1,\\,-1⟩.\n$$" "Calculate \n$$\n\\displaystyle {\\int }_{-1}^{3}\\left[\\frac{1}{3}f(t)+2g(t)\\right]\\text{d}t\n$$ \ngiven that \n$$\n\\displaystyle {\\int }_{-1}^{3}f(t)\\,\\text{d}t=⟨-3,\\,6,\\,3⟩\n$$\nand \n$$\n\\displaystyle {\\int }_{-1}^{3}g(t)\\,\\text{d}t=\\left\\langle -\\frac{1}{2},\\,1,\\,-1\\right\\rangle .\n$$"] [:db/cas 17592186459249 :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{-1}^{3}[\\frac{1}{3}f(t)+2g(t)]\\text{d}t=\\frac{1}{3}{\\int }_{-1}^{3}f(t)\\,\\text{d}t+2{\\int }_{-1}^{3}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}[\\frac{1}{3}f(t)+2g(t)]\\,\\text{d}t & =\\frac{1}{3}{\\int }_{-1}^{3}f(t)\\,\\text{d}t+2{\\int }_{-1}^{3}g(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}⟨-3,\\,6,\\,3⟩+2⟨-\\frac{1}{2},\\,1,\\,-1⟩ \\\\  & =⟨-1,\\,2,\\,1⟩+⟨-1,\\,2,\\,-2⟩ \\\\  & =⟨-2,\\,4,\\,-1⟩.\\end{aligned}\n$$" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{-1}^{3}\\left[\\frac{1}{3}f(t)+2g(t)\\right]\\text{d}t=\\frac{1}{3}{\\int }_{-1}^{3}f(t)\\,\\text{d}t+2{\\int }_{-1}^{3}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}\\left[\\frac{1}{3}f(t)+2g(t)\\right]\\,\\text{d}t & =\\frac{1}{3}{\\int }_{-1}^{3}f(t)\\,\\text{d}t+2{\\int }_{-1}^{3}g(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}⟨-3,\\,6,\\,3⟩+2\\left\\langle -\\frac{1}{2},\\,1,\\,-1\\right\\rangle  \\\\  & =⟨-1,\\,2,\\,1⟩+⟨-1,\\,2,\\,-2⟩ \\\\  & =⟨-2,\\,4,\\,-1⟩.\\end{aligned}\n$$"] [:db/cas 17592186459253 :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{8-1}{\\int }_{1}^{8}\\sqrt[3]{x}\\,\\text{d}x \\\\  & ={\\frac{1}{7}(\\frac{3}{4}{x}^{4/3})|}_{1}^{8} \\\\  & =\\frac{1}{7}[(\\frac{3}{4}\\cdot {8}^{4/3})-(\\frac{3}{4}\\cdot {1}^{4/3})] \\\\  & =\\frac{1}{7}[(\\frac{3}{4}\\cdot ({8}^{1/3})^{4})-\\frac{3}{4}] \\\\  & =\\frac{1}{7}[(\\frac{3}{4}\\cdot {2}^{4})-\\frac{3}{4}] \\\\  & =\\frac{1}{7}[(\\frac{3}{4}\\cdot 16)-\\frac{3}{4}] \\\\  & =\\frac{1}{7}(12-\\frac{3}{4}) \\\\  & =\\frac{45}{28}.\\end{aligned}\n$$" "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{8-1}{\\int }_{1}^{8}\\sqrt[3]{x}\\,\\text{d}x \\\\  & ={\\frac{1}{7}\\left(\\frac{3}{4}{x}^{4/3}\\right)|}_{1}^{8} \\\\  & =\\frac{1}{7}\\left[\\left(\\frac{3}{4}\\cdot {8}^{4/3}\\right)-\\left(\\frac{3}{4}\\cdot {1}^{4/3}\\right)\\right] \\\\  & =\\frac{1}{7}\\left[\\left(\\frac{3}{4}\\cdot ({8}^{1/3})^{4}\\right)-\\frac{3}{4}\\right] \\\\  & =\\frac{1}{7}\\left[\\left(\\frac{3}{4}\\cdot {2}^{4}\\right)-\\frac{3}{4}\\right] \\\\  & =\\frac{1}{7}\\left[\\left(\\frac{3}{4}\\cdot 16\\right)-\\frac{3}{4}\\right] \\\\  & =\\frac{1}{7}\\left(12-\\frac{3}{4}\\right) \\\\  & =\\frac{45}{28}.\\end{aligned}\n$$"] [:db/cas 17592186459263 :question/problem "![](images/18/184b50ce54b01453d5b645eef7edc186823e8ae34afaefa2527e34122c1722cc.png)\n\nConsider the path $C$ shown above. Given that $\\mathbf{F}(x,y)=⟨y+\\frac{2}{3}{y}^{3},\\hspace{0.222em}\\operatorname{ln}({y}^{2}+10)+2x⟩,$ which of the following is equivalent to $$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}\\hspace{0.167em}?\n$$" "![](images/18/184b50ce54b01453d5b645eef7edc186823e8ae34afaefa2527e34122c1722cc.png)\n\nConsider the path $C$ shown above. Given that $\\mathbf{F}(x,y)=\\left\\langle y+\\frac{2}{3}{y}^{3},\\hspace{0.222em}\\operatorname{ln}({y}^{2}+10)+2x\\right\\rangle ,$ which of the following is equivalent to $$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}\\hspace{0.167em}?\n$$"] [:db/cas 17592186459263 :question/worked-solution "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∮}_{C}(y+\\frac{2}{3}{y}^{3})\\hspace{0.222em}\\mathrm{d}x+(\\operatorname{ln}({y}^{2}+10)+2x)\\hspace{0.222em}\\mathrm{d}y.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/93/93a1c20377ddd0731c6190712d9d6d77551124fa33001334e84f52049bb6b800.png)\n\nSince $P(x,y)=y+\\frac{2}{3}{y}^{3}$ and $Q(x,y)=\\operatorname{ln}⁡({y}^{2}+10)+2x,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=1+2{y}^{2},\\,\\frac{∂Q}{∂x}=2.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(y+\\frac{2}{3}{y}^{3})\\,dx+(\\operatorname{ln}⁡({y}^{2}+10)+2x)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2-(1+2{y}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}(1-2{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 9,\\,0\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(1-3{y}^{2})\\hspace{0.167em}\\text{d}A & ={∬}_{\\mathrm{Δ}}(1-2\\cdot {r}^{2}{\\operatorname{sin}}^{2}\\theta )\\hspace{0.222em}r\\hspace{0.222em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\hspace{0.222em}{\\int }_{0}^{9}(1-2{r}^{2}{\\operatorname{sin}}^{2}\\theta )r\\hspace{0.222em}\\mathrm{d}r\\hspace{0.222em}\\mathrm{d}\\theta .\\end{aligned}\n$$" "First, notice that we can rewrite our integral as \n\n$$\n{∮}_{C}\\mathbf{F}\\cdot \\mathrm{d}\\mathbf{r}={∮}_{C}\\left(y+\\frac{2}{3}{y}^{3}\\right)\\hspace{0.222em}\\mathrm{d}x+(\\operatorname{ln}({y}^{2}+10)+2x)\\hspace{0.222em}\\mathrm{d}y.\n$$\n\nGreen's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/93/93a1c20377ddd0731c6190712d9d6d77551124fa33001334e84f52049bb6b800.png)\n\nSince $P(x,y)=y+\\frac{2}{3}{y}^{3}$ and $Q(x,y)=\\operatorname{ln}⁡({y}^{2}+10)+2x,$ we obtain\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=1+2{y}^{2},\\,\\frac{∂Q}{∂x}=2.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}\\left(y+\\frac{2}{3}{y}^{3}\\right)\\,dx+(\\operatorname{ln}⁡({y}^{2}+10)+2x)\\,dy & ={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\text{d}A \\\\  & ={∬}_{D}(2-(1+2{y}^{2}))\\,\\text{d}A \\\\  & ={∬}_{D}(1-2{y}^{2})\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 9,\\,0\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nTherefore, we can write our double integral as \n\n$$\n\\begin{aligned}{∬}_{D}(1-3{y}^{2})\\hspace{0.167em}\\text{d}A & ={∬}_{\\mathrm{Δ}}(1-2\\cdot {r}^{2}{\\operatorname{sin}}^{2}\\theta )\\hspace{0.222em}r\\hspace{0.222em}\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\hspace{0.222em}{\\int }_{0}^{9}(1-2{r}^{2}{\\operatorname{sin}}^{2}\\theta )r\\hspace{0.222em}\\mathrm{d}r\\hspace{0.222em}\\mathrm{d}\\theta .\\end{aligned}\n$$"] [:db/cas 17592186459266 :question/worked-solution "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/d8/d816d9153e22dd109e20e3e387f6a0028e3f6a9eaf1d284dfae8b5fdf54cfc6e.png)\n\nNow, since \n\n$$\nP(x,y)={x}^{2}-x{y}^{2},\\,Q(x,y)=\\sqrt{{y}^{7}+3}+{x}^{2}y,\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-2xy,\\,\\frac{∂Q}{∂x}=2xy.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\sqrt{x}-x{y}^{2})dx+(\\sqrt{{y}^{7}+3}+{x}^{2}y)\\,dy & ={∬}_{D}(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})\\text{d}A \\\\  & ={∬}_{D}(2xy-(-2xy))\\,\\text{d}A \\\\  & ={∬}_{D}4xy\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}{∬}_{D}4xy\\,\\text{d}A & ={∬}_{Δ}4(r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}{\\int }_{0}^{2}2{r}^{3}\\operatorname{sin}⁡(2\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\operatorname{sin}⁡(2\\theta ){\\int }_{0}^{2}2{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\operatorname{sin}⁡(2\\theta ){[\\frac{{r}^{4}}{2}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}8\\operatorname{sin}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =4[-\\operatorname{cos}⁡(2\\theta )]_{0}^{3\\pi /2} \\\\  & =4[-\\operatorname{cos}⁡(3\\pi )+\\operatorname{cos}⁡0] \\\\  & =8.\\end{aligned}\n$$" "Green's theorem states that\n\n$$\n{∮}_{C}P\\,dx+Q\\,dy={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\,\\text{d}A.\n$$\n\nIn our case, the region $D$ and its boundary $C$ satisfy the conditions of Green's theorem:\n\n![](images/d8/d816d9153e22dd109e20e3e387f6a0028e3f6a9eaf1d284dfae8b5fdf54cfc6e.png)\n\nNow, since \n\n$$\nP(x,y)={x}^{2}-x{y}^{2},\\,Q(x,y)=\\sqrt{{y}^{7}+3}+{x}^{2}y,\n$$\n\n we have that\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y}=-2xy,\\,\\frac{∂Q}{∂x}=2xy.\\end{aligned}\n$$\n\nApplying Green's theorem, we get\n\n$$\n\\begin{aligned}{∮}_{C}(\\sqrt{x}-x{y}^{2})dx+(\\sqrt{{y}^{7}+3}+{x}^{2}y)\\,dy & ={∬}_{D}\\left(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y}\\right)\\text{d}A \\\\  & ={∬}_{D}(2xy-(-2xy))\\,\\text{d}A \\\\  & ={∬}_{D}4xy\\,\\text{d}A\\end{aligned}\n$$\n\nNow, notice that the region $D$ can be represented in polar coordinates as\n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\frac{3\\pi }{2}\\}.\n$$\n\nThe change of variables formula for plane polar coordinates states that\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFinally, we can calculate our double integral, as follows:\n\n$$\n\\begin{aligned}{∬}_{D}4xy\\,\\text{d}A & ={∬}_{Δ}4(r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}{\\int }_{0}^{2}2{r}^{3}\\operatorname{sin}⁡(2\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\operatorname{sin}⁡(2\\theta ){\\int }_{0}^{2}2{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}\\operatorname{sin}⁡(2\\theta ){\\left[\\frac{{r}^{4}}{2}\\right]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{3\\pi /2}8\\operatorname{sin}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =4[-\\operatorname{cos}⁡(2\\theta )]_{0}^{3\\pi /2} \\\\  & =4[-\\operatorname{cos}⁡(3\\pi )+\\operatorname{cos}⁡0] \\\\  & =8.\\end{aligned}\n$$"] [:db/cas 17592186459273 :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{3-(-3)}{\\int }_{-3}^{3}{x}^{2}+2x\\,\\text{d}x \\\\  & ={\\frac{1}{6}\\cdot (\\frac{{x}^{3}}{3}+{x}^{2})|}_{-3}^{3} \\\\  & =\\frac{1}{6}[(\\frac{{3}^{3}}{3}+{3}^{2})-(\\frac{(-3)^{3}}{3}+(-3)^{2})] \\\\  & =\\frac{1}{6}\\cdot [(9+9)-(-9+9)] \\\\  & =\\frac{1}{6}\\cdot 18 \\\\  & =3.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =3 \\\\ {c}^{2}+2c & =3 \\\\ {c}^{2}+2c-3 & =0 \\\\ (c+1)^{2}-4 & =0 \\\\ c+1 & =\\pm 2 \\\\ c & =-3,\\,1\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $c$ that satisfy the mean value theorem on the interval $[-3,3]$ are \n\n$$\nc=-3,\\,\\text{and}\\,c=1.\n$$" "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{3-(-3)}{\\int }_{-3}^{3}{x}^{2}+2x\\,\\text{d}x \\\\  & ={\\frac{1}{6}\\cdot \\left(\\frac{{x}^{3}}{3}+{x}^{2}\\right)|}_{-3}^{3} \\\\  & =\\frac{1}{6}\\left[\\left(\\frac{{3}^{3}}{3}+{3}^{2}\\right)-\\left(\\frac{(-3)^{3}}{3}+(-3)^{2}\\right)\\right] \\\\  & =\\frac{1}{6}\\cdot [(9+9)-(-9+9)] \\\\  & =\\frac{1}{6}\\cdot 18 \\\\  & =3.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =3 \\\\ {c}^{2}+2c & =3 \\\\ {c}^{2}+2c-3 & =0 \\\\ (c+1)^{2}-4 & =0 \\\\ c+1 & =\\pm 2 \\\\ c & =-3,\\,1\\end{aligned}\n$$\n\nTherefore, in ascending order, the values of $c$ that satisfy the mean value theorem on the interval $[-3,3]$ are \n\n$$\nc=-3,\\,\\text{and}\\,c=1.\n$$"] [:db/cas 17592186459288 :question/problem "$2(\\frac{3x}{4}+2y)+\\frac{5x}{2}=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$" "$2\\left(\\frac{3x}{4}+2y\\right)+\\frac{5x}{2}=${{field-1}}\n$x\\,+$\n{{field-2}}\n$y$"] [:db/cas 17592186459288 :question/worked-solution "First, we apply the distributive law:\n\n$$\n\\begin{aligned}2(\\frac{3x}{4}+2y)+\\frac{5x}{2} &= 2\\cdot \\frac{3x}{4}+2\\cdot 2y+\\frac{5x}{2} \\\\ &= \\frac{6x}{4}+4y+\\frac{5x}{2} \\\\ &= \\frac{3x}{2}+4y+\\frac{5x}{2}\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{3x}{2}+4y+\\frac{5x}{2} &= (\\frac{3x}{2}+\\frac{5x}{2})+4y \\\\ &= \\frac{3x+5x}{2}+4y \\\\ &= \\frac{8x}{2}+4y \\\\ &= 4\\,x+4\\,y\\end{aligned}\n$$" "First, we apply the distributive law:\n\n$$\n\\begin{aligned}2\\left(\\frac{3x}{4}+2y\\right)+\\frac{5x}{2} &= 2\\cdot \\frac{3x}{4}+2\\cdot 2y+\\frac{5x}{2} \\\\ &= \\frac{6x}{4}+4y+\\frac{5x}{2} \\\\ &= \\frac{3x}{2}+4y+\\frac{5x}{2}\\end{aligned}\n$$\n\nThen, we collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{3x}{2}+4y+\\frac{5x}{2} &= \\left(\\frac{3x}{2}+\\frac{5x}{2}\\right)+4y \\\\ &= \\frac{3x+5x}{2}+4y \\\\ &= \\frac{8x}{2}+4y \\\\ &= 4\\,x+4\\,y\\end{aligned}\n$$"] [:db/cas 17592186459293 :question/worked-solution "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{6x}{5}+15-\\frac{4x}{7}+8 &= (\\frac{6x}{5}-\\frac{4x}{7})+(15+8) \\\\ &= (\\frac{42x}{35}-\\frac{20x}{35})+(15+8) \\\\ &= \\left(\\frac{42x-20x}{35}\\right)+23 \\\\ &= \\frac{22x}{35}+23\\end{aligned}\n$$" "We collect and combine the like terms, simplifying the coefficients as much as possible:\n\n$$\n\\begin{aligned}\\frac{6x}{5}+15-\\frac{4x}{7}+8 &= \\left(\\frac{6x}{5}-\\frac{4x}{7}\\right)+(15+8) \\\\ &= \\left(\\frac{42x}{35}-\\frac{20x}{35}\\right)+(15+8) \\\\ &= \\left(\\frac{42x-20x}{35}\\right)+23 \\\\ &= \\frac{22x}{35}+23\\end{aligned}\n$$"] [:db/cas 17592186459297 :question/problem "Calculate $$\n\\displaystyle {\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t\n$$ given that $$\n\\displaystyle {\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨\\frac{1}{2},\\,2,\\,1⟩\n$$ and $$\n\\displaystyle {\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨1,\\,1,\\,1⟩.\n$$" "Calculate $$\n\\displaystyle {\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t\n$$ given that $$\n\\displaystyle {\\int }_{0}^{1}f(t)\\,\\text{d}t=\\left\\langle \\frac{1}{2},\\,2,\\,1\\right\\rangle \n$$ and $$\n\\displaystyle {\\int }_{0}^{1}g(t)\\,\\text{d}t=⟨1,\\,1,\\,1⟩.\n$$"] [:db/cas 17592186459297 :question/worked-solution "From the vector addition rule, we have\n\n$$\n{\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t & ={\\int }_{0}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =⟨\\frac{1}{2},\\,2,\\,1⟩-⟨1,\\,1,\\,1⟩ \\\\  & =⟨-\\frac{1}{2},\\,1,\\,0⟩.\\end{aligned}\n$$" "From the vector addition rule, we have\n\n$$\n{\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[f(t)-g(t)]\\,\\text{d}t & ={\\int }_{0}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}g(t)\\,\\text{d}t \\\\  & =\\left\\langle \\frac{1}{2},\\,2,\\,1\\right\\rangle -⟨1,\\,1,\\,1⟩ \\\\  & =\\left\\langle -\\frac{1}{2},\\,1,\\,0\\right\\rangle .\\end{aligned}\n$$"] [:db/cas 17592186460735 :answer-field/key "$f(x)$ is concave down on $(0,\\frac{\\pi }{2})$" "$f(x)$ is concave down on $\\left(0,\\frac{\\pi }{2}\\right)$"] [:db/cas 17592186460736 :answer-field/key "$f(x)$ is concave up on $(\\frac{\\pi }{2},\\pi )$" "$f(x)$ is concave up on $\\left(\\frac{\\pi }{2},\\pi \\right)$"] [:db/cas 17592186460737 :answer-field/key "$f(x)$ is concave down on $(\\frac{\\pi }{2},\\pi )$" "$f(x)$ is concave down on $\\left(\\frac{\\pi }{2},\\pi \\right)$"] [:db/cas 17592186460935 :answer-field/key "$(\\frac{\\pi }{4},1)$" "$\\left(\\frac{\\pi }{4},1\\right)$"] [:db/cas 17592186460936 :answer-field/key "$(1,\\frac{\\pi }{4})$" "$\\left(