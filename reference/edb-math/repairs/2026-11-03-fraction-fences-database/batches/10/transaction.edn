}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{35}{3}\\cdot \\frac{1}{2}{x}^{\\left(\\frac{1}{2}-1\\right)} \\\\  & =\\frac{35}{6}{x}^{-1/2} \\\\  & =\\frac{\\frac{35}{6}}{\\sqrt{x}}\\end{aligned}\n$$"] [:db/cas 17592186494248 :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{3}\\sqrt{x}+3) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{1}{6}{x}^{-1/2} \\\\  & =\\frac{\\frac{1}{6}}{\\sqrt{x}}\\end{aligned}\n$$" "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{1}{3}\\sqrt{x}+3\\right) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{1}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{1}{3}\\cdot \\frac{1}{2}{x}^{\\left(\\frac{1}{2}-1\\right)} \\\\  & =\\frac{1}{6}{x}^{-1/2} \\\\  & =\\frac{\\frac{1}{6}}{\\sqrt{x}}\\end{aligned}\n$$"] [:db/cas 17592186494249 :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{32}{3}\\sqrt{x}+3) \\\\  & =\\frac{32}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{32}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{32}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{16}{3}{x}^{-1/2} \\\\  & =\\frac{\\frac{16}{3}}{\\sqrt{x}}\\end{aligned}\n$$" "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{32}{3}\\sqrt{x}+3\\right) \\\\  & =\\frac{32}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{32}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{32}{3}\\cdot \\frac{1}{2}{x}^{\\left(\\frac{1}{2}-1\\right)} \\\\  & =\\frac{16}{3}{x}^{-1/2} \\\\  & =\\frac{\\frac{16}{3}}{\\sqrt{x}}\\end{aligned}\n$$"] [:db/cas 17592186494253 :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{28}{3}\\sqrt{x}+3) \\\\  & =\\frac{28}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{28}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{28}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{14}{3}{x}^{-1/2} \\\\  & =\\frac{\\frac{14}{3}}{\\sqrt{x}}\\end{aligned}\n$$" "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{28}{3}\\sqrt{x}+3\\right) \\\\  & =\\frac{28}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{28}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{28}{3}\\cdot \\frac{1}{2}{x}^{\\left(\\frac{1}{2}-1\\right)} \\\\  & =\\frac{14}{3}{x}^{-1/2} \\\\  & =\\frac{\\frac{14}{3}}{\\sqrt{x}}\\end{aligned}\n$$"] [:db/cas 17592186494273 :question/worked-solution "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{23}{3}\\sqrt{x}+3) \\\\  & =\\frac{23}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{23}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{23}{3}\\cdot \\frac{1}{2}{x}^{(\\frac{1}{2}-1)} \\\\  & =\\frac{23}{6}{x}^{-1/2} \\\\  & =\\frac{\\frac{23}{6}}{\\sqrt{x}}\\end{aligned}\n$$" "We apply the sum, constant multiple, and power rules as follows:\n\n$$\n\\begin{aligned}{g}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left(\\frac{23}{3}\\sqrt{x}+3\\right) \\\\  & =\\frac{23}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\sqrt{x})+\\frac{\\text{d}}{\\text{d}x}(3) \\\\  & =\\frac{23}{3}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}) \\\\  & =\\frac{23}{3}\\cdot \\frac{1}{2}{x}^{\\left(\\frac{1}{2}-1\\right)} \\\\  & =\\frac{23}{6}{x}^{-1/2} \\\\  & =\\frac{\\frac{23}{6}}{\\sqrt{x}}\\end{aligned}\n$$"] [:db/cas 17592186494285 :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{1}{{x}^{4}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{-4})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =2{x}^{(2-1)}+(-4){x}^{(-4-1)}-1 \\\\  & =2{x}^{1}-4{x}^{-5}-1 \\\\  & =2{x}^{1}-\\frac{4}{{x}^{5}}-1.\\end{aligned}\n$$" "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left({x}^{2}+\\frac{1}{{x}^{4}}-x\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{-4})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =2{x}^{(2-1)}+(-4){x}^{(-4-1)}-1 \\\\  & =2{x}^{1}-4{x}^{-5}-1 \\\\  & =2{x}^{1}-\\frac{4}{{x}^{5}}-1.\\end{aligned}\n$$"] [:db/cas 17592186494290 :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{1}{{x}^{3}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{-3})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =2{x}^{(2-1)}+(-3){x}^{(-3-1)}-1 \\\\  & =2{x}^{1}-3{x}^{-4}-1 \\\\  & =2{x}^{1}-\\frac{3}{{x}^{4}}-1.\\end{aligned}\n$$" "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left({x}^{2}+\\frac{1}{{x}^{3}}-x\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{-3})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =2{x}^{(2-1)}+(-3){x}^{(-3-1)}-1 \\\\  & =2{x}^{1}-3{x}^{-4}-1 \\\\  & =2{x}^{1}-\\frac{3}{{x}^{4}}-1.\\end{aligned}\n$$"] [:db/cas 17592186494292 :question/worked-solution "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{1}{{x}^{2}}-x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =2{x}^{(2-1)}+(-2){x}^{(-2-1)}-1 \\\\  & =2{x}^{1}-2{x}^{-3}-1 \\\\  & =2{x}^{1}-\\frac{2}{{x}^{3}}-1.\\end{aligned}\n$$" "The function $f(x)$ is the sum of three power functions. So, we apply the sum rule, and we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}\\left({x}^{2}+\\frac{1}{{x}^{2}}-x\\right) \\\\  & =\\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}({x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(x) \\\\  & =2{x}^{(2-1)}+(-2){x}^{(-2-1)}-1 \\\\  & =2{x}^{1}-2{x}^{-3}-1 \\\\  & =2{x}^{1}-\\frac{2}{{x}^{3}}-1.\\end{aligned}\n$$"] [:db/cas 17592186495048 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=70$ and $p=0.52.$ Therefore, \n\n$$\n\\begin{aligned}np & =70\\cdot 0.52 \\\\  & =36.4 \\\\  & >5\\,✓ \\\\ n(1-p) & =70\\cdot (1-0.52) \\\\  & =33.6 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(70)(0.52)=36.4\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(70)(0.52)(1-0.52)=17.472.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(36.4,17.472).$\n\nNow, we can estimate the desired probability $P(X\\ge 37).$ Using a continuity correction, we have\n\n$$\nP(X\\ge 37)≈P(Y\\ge 36.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 36.5) & =P(Z\\ge \\frac{36.5-36.4}{\\sqrt{17.472}}) \\\\  & ≈P(Z\\ge 0.02) \\\\  & =1-P(Z<0.02) \\\\  & =1-P(Z\\le 0.02) \\\\  & =1-Φ(0.02) \\\\  & =1-0.5080 \\\\  & =0.4920\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X\\ge 37)≈0.492.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.4905.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=70$ and $p=0.52.$ Therefore, \n\n$$\n\\begin{aligned}np & =70\\cdot 0.52 \\\\  & =36.4 \\\\  & >5\\,✓ \\\\ n(1-p) & =70\\cdot (1-0.52) \\\\  & =33.6 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(70)(0.52)=36.4\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(70)(0.52)(1-0.52)=17.472.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(36.4,17.472).$\n\nNow, we can estimate the desired probability $P(X\\ge 37).$ Using a continuity correction, we have\n\n$$\nP(X\\ge 37)≈P(Y\\ge 36.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 36.5) & =P\\left(Z\\ge \\frac{36.5-36.4}{\\sqrt{17.472}}\\right) \\\\  & ≈P(Z\\ge 0.02) \\\\  & =1-P(Z<0.02) \\\\  & =1-P(Z\\le 0.02) \\\\  & =1-Φ(0.02) \\\\  & =1-0.5080 \\\\  & =0.4920\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X\\ge 37)≈0.492.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.4905.$"] [:db/cas 17592186495049 :question/worked-solution "First, we substitute $u=2x-3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x-3$ is as follows:\n\n| $x$ | $1$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-1$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\lim_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-5}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\lim_{a\\to -\\infty }{[\\frac{{u}^{-4}}{-4}]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{4}}]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }[1-\\frac{1}{{a}^{4}}] \\\\  & =-\\frac{1}{8}\\cdot (1-0) \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$" "First, we substitute $u=2x-3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\frac{1}{2}\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x-3$ is as follows:\n\n| $x$ | $1$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-1$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}\\frac{1}{(2x-3)^{5}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}\\frac{1}{{u}^{5}}\\,\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{-\\infty }^{-1}{u}^{-5}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\lim_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-5}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\lim_{a\\to -\\infty }{\\left[\\frac{{u}^{-4}}{-4}\\right]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }{\\left[\\frac{1}{{u}^{4}}\\right]}_{a}^{-1} \\\\  & =-\\frac{1}{8}\\cdot {lim}_{a\\to -\\infty }\\left[1-\\frac{1}{{a}^{4}}\\right] \\\\  & =-\\frac{1}{8}\\cdot (1-0) \\\\  & =-\\frac{1}{8}.\\end{aligned}\n$$"] [:db/cas 17592186495050 :question/worked-solution "We have the function \n\n$$\ny={\\left(\\frac{1}{2x}\\right)}^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡({\\left(\\frac{1}{2x}\\right)}^{x}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot (\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right))+(x)\\cdot {(\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right))}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)+x\\cdot ((2x)\\cdot \\left(-\\frac{2}{(2x)^{2}}\\right)) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)-1 \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡(2x)-1 \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-y(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y={\\left(\\frac{1}{2x}\\right)}^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-{\\left(\\frac{1}{2x}\\right)}^{x}(\\operatorname{ln}⁡(2x)+1) \\\\  & =-{(2x)}^{-x}\\cdot (\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$" "We have the function \n\n$$\ny={\\left(\\frac{1}{2x}\\right)}^{x}.\n$$\n\nFirst, we take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡\\left({\\left(\\frac{1}{2x}\\right)}^{x}\\right) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}\\left(x\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)\\right) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =(x)^{′}\\cdot \\left(\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)\\right)+(x)\\cdot {\\left(\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)\\right)}^{′} \\\\ \\frac{1}{y}\\cdot {y}^{′} & =1\\cdot \\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)+x\\cdot \\left((2x)\\cdot \\left(-\\frac{2}{(2x)^{2}}\\right)\\right) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡\\left(\\frac{1}{2x}\\right)-1 \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡1-\\operatorname{ln}⁡(2x)-1 \\\\ \\frac{{y}^{′}}{y} & =-(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-y(\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$\n\nFinally, we substitute $y={\\left(\\frac{1}{2x}\\right)}^{x}:$\n\n$$\n\\begin{aligned}{y}^{′} & =-{\\left(\\frac{1}{2x}\\right)}^{x}(\\operatorname{ln}⁡(2x)+1) \\\\  & =-{(2x)}^{-x}\\cdot (\\operatorname{ln}⁡(2x)+1)\\end{aligned}\n$$"] [:db/cas 17592186495051 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=140$ and $p=0.53.$ Therefore, \n\n$$\n\\begin{aligned}np & =140\\cdot 0.53 \\\\  & =74.2 \\\\  & >5\\,✓ \\\\ n(1-p) & =140\\cdot (1-0.53) \\\\  & =65.8 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(140)(0.53)=74.2\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(140)(0.53)(1-0.53)=34.874.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(74.2,34.874).$\n\nNow, we can estimate the desired probability $P(X\\ge 70).$ Using a continuity correction, we have\n\n$$\nP(X\\ge 70)≈P(Y\\ge 69.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 69.5) & =1-P(Y<69.5) \\\\  & =1-P(Z<\\frac{69.5-74.2}{\\sqrt{34.874}}) \\\\  & ≈1-P(Z<-0.80) \\\\  & =1-Φ(-0.80) \\\\  & =1-0.2119 \\\\  & =0.7881\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X\\ge 70)≈0.788.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.7869.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=140$ and $p=0.53.$ Therefore, \n\n$$\n\\begin{aligned}np & =140\\cdot 0.53 \\\\  & =74.2 \\\\  & >5\\,✓ \\\\ n(1-p) & =140\\cdot (1-0.53) \\\\  & =65.8 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(140)(0.53)=74.2\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(140)(0.53)(1-0.53)=34.874.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(74.2,34.874).$\n\nNow, we can estimate the desired probability $P(X\\ge 70).$ Using a continuity correction, we have\n\n$$\nP(X\\ge 70)≈P(Y\\ge 69.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 69.5) & =1-P(Y<69.5) \\\\  & =1-P\\left(Z<\\frac{69.5-74.2}{\\sqrt{34.874}}\\right) \\\\  & ≈1-P(Z<-0.80) \\\\  & =1-Φ(-0.80) \\\\  & =1-0.2119 \\\\  & =0.7881\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X\\ge 70)≈0.788.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.7869.$"] [:db/cas 17592186495059 :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n0\\le y-2x\\le 2,\\,2\\le y+2x\\le 6,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-2x\\,\\text{and}\\,v=y+2x.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,0\\le u\\le 2,\\,2\\le v\\le 6\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ \\text{ }\\text{ }\\text{ }2 & 1\\end{vmatrix} \\\\  & =-4.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{4}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y-2x}{y+2x}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}\\frac{u}{v}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{u}{v}|-\\frac{1}{4}|\\text{d}u\\text{d}v \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u[{\\int }_{2}^{6}\\frac{1}{v}\\,dv]du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u[\\operatorname{ln}⁡|v|]_{2}^{6}\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2)\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u\\cdot \\operatorname{ln}⁡3\\,du \\\\  & =\\frac{\\operatorname{ln}⁡3}{4}{[\\frac{1}{2}{u}^{2}]}_{0}^{2} \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}.\\end{aligned}\n$$" "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n0\\le y-2x\\le 2,\\,2\\le y+2x\\le 6,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=y-2x\\,\\text{and}\\,v=y+2x.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,0\\le u\\le 2,\\,2\\le v\\le 6\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}-2 & 1 \\\\ \\text{ }\\text{ }\\text{ }2 & 1\\end{vmatrix} \\\\  & =-4.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=-\\frac{1}{4}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y-2x}{y+2x}\\,\\text{d}x\\text{d}y & ={∬}_{Δ}\\frac{u}{v}\\,|\\frac{∂(x,y)}{∂(u,v)}|\\,\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}\\frac{u}{v}|-\\frac{1}{4}|\\text{d}u\\text{d}v \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u\\left[{\\int }_{2}^{6}\\frac{1}{v}\\,dv\\right]du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u[\\operatorname{ln}⁡|v|]_{2}^{6}\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u(\\operatorname{ln}⁡6-\\operatorname{ln}⁡2)\\,du \\\\  & =\\frac{1}{4}{\\int }_{0}^{2}u\\cdot \\operatorname{ln}⁡3\\,du \\\\  & =\\frac{\\operatorname{ln}⁡3}{4}{\\left[\\frac{1}{2}{u}^{2}\\right]}_{0}^{2} \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}.\\end{aligned}\n$$"] [:db/cas 17592186495068 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=20$ and $p=0.55.$ Therefore, \n\n$$\n\\begin{aligned}np & =20\\cdot 0.55 \\\\  & =11 \\\\  & >5\\,✓ \\\\ n(1-p) & =20\\cdot (1-0.55) \\\\  & =9 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(20)(0.55)=11\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(20)(0.55)(1-0.55)=4.95.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(11,4.95).$\n\nNow, we can estimate the desired probability $P(X>10).$ Using a continuity correction, we have\n\n$$\nP(X>10)=P(X\\ge 11)≈P(Y\\ge 10.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 10.5) & =P(Z\\ge \\frac{10.5-11}{\\sqrt{4.95}}) \\\\  & ≈P(Z\\ge -0.22) \\\\  & =1-P(Z<-0.22) \\\\  & =1-P(Z\\le -0.22) \\\\  & =1-Φ(-0.22) \\\\  & =1-0.4129 \\\\  & =0.5871\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X>10)≈0.587.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.5914.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=20$ and $p=0.55.$ Therefore, \n\n$$\n\\begin{aligned}np & =20\\cdot 0.55 \\\\  & =11 \\\\  & >5\\,✓ \\\\ n(1-p) & =20\\cdot (1-0.55) \\\\  & =9 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(20)(0.55)=11\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(20)(0.55)(1-0.55)=4.95.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(11,4.95).$\n\nNow, we can estimate the desired probability $P(X>10).$ Using a continuity correction, we have\n\n$$\nP(X>10)=P(X\\ge 11)≈P(Y\\ge 10.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 10.5) & =P\\left(Z\\ge \\frac{10.5-11}{\\sqrt{4.95}}\\right) \\\\  & ≈P(Z\\ge -0.22) \\\\  & =1-P(Z<-0.22) \\\\  & =1-P(Z\\le -0.22) \\\\  & =1-Φ(-0.22) \\\\  & =1-0.4129 \\\\  & =0.5871\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X>10)≈0.587.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.5914.$"] [:db/cas 17592186495089 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nLet's now examine each situation.\n\n- In situation I, we have $n=10$ and $p=0.25.$ Therefore,\n\n$$\n\\begin{aligned}np & =10\\cdot 0.25 \\\\  & =2.5 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSo, we *cannot* use the normal approximation of the binomial distribution.\n\n- In situation II, we have $n=60$ and $p=\\frac{1}{6}.$ Therefore, \n\n$$\n\\begin{aligned}np & =60\\cdot \\frac{1}{6} \\\\  & =10 \\\\  & >5\\,✓ \\\\ n(1-p) & =60\\cdot (1-\\frac{1}{6}) \\\\  & =50 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can use the normal approximation of the binomial distribution.\n\n- In situation III, we have $n=7$ and $p=0.48.$ Therefore,\n\n$$\n\\begin{aligned}np & =7\\cdot 0.48 \\\\  & =3.36 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSo, we *cannot* use the normal approximation of the binomial distribution.\n\nTherefore, the correct answer is \"II only.\"" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nLet's now examine each situation.\n\n- In situation I, we have $n=10$ and $p=0.25.$ Therefore,\n\n$$\n\\begin{aligned}np & =10\\cdot 0.25 \\\\  & =2.5 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSo, we *cannot* use the normal approximation of the binomial distribution.\n\n- In situation II, we have $n=60$ and $p=\\frac{1}{6}.$ Therefore, \n\n$$\n\\begin{aligned}np & =60\\cdot \\frac{1}{6} \\\\  & =10 \\\\  & >5\\,✓ \\\\ n(1-p) & =60\\cdot \\left(1-\\frac{1}{6}\\right) \\\\  & =50 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can use the normal approximation of the binomial distribution.\n\n- In situation III, we have $n=7$ and $p=0.48.$ Therefore,\n\n$$\n\\begin{aligned}np & =7\\cdot 0.48 \\\\  & =3.36 \\\\  & ≯5.\\,\\times \\end{aligned}\n$$\n\nSo, we *cannot* use the normal approximation of the binomial distribution.\n\nTherefore, the correct answer is \"II only.\""] [:db/cas 17592186495094 :question/problem "A particle of mass $0.8\\,\\text{kg}$ is attached to a massless spring. An external periodic force \n\n$$\nF(t)=(4{cos}^{2}\\,(\\frac{5}{2}t)-2)\\,\\text{N}\n$$\n\nis applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping and the system experiences resonance, what is the spring constant $k?$\n\n$k=$\n{{field-1}}${\\text{kg/s}}^{2}$" "A particle of mass $0.8\\,\\text{kg}$ is attached to a massless spring. An external periodic force \n\n$$\nF(t)=\\left(4{cos}^{2}\\,\\left(\\frac{5}{2}t\\right)-2\\right)\\,\\text{N}\n$$\n\nis applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping and the system experiences resonance, what is the spring constant $k?$\n\n$k=$\n{{field-1}}${\\text{kg/s}}^{2}$"] [:db/cas 17592186495094 :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m$ and $F(t)$ gives\n\n$$\n0.8{y}^{″}=-ky+(4{cos}^{2}\\,(\\frac{5}{2}t)-2).\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+\\frac{5k}{4}y=\\frac{5}{2}(2{cos}^{2}\\,(\\frac{5}{2}t)-1).\n$$\n\nThe complementary solution ${y}_{c}$ here represents simple harmonic motion, and it can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration, and $\\omega $ is the system's internal frequency.\n\nIn our case,\n\n$$\n{\\omega }^{2}=\\frac{5k}{4}\\,⟹\\,k=\\frac{4}{5}{\\omega }^{2}.\n$$\n\nThe oscillator experiences resonance when the frequency of the external periodic force $$\n\\displaystyle f(t)=\\frac{5}{2}(2{cos}^{2}\\,(\\frac{5}{2}t)-1)\n$$ is equal to the frequency of the complementary solution $\\omega .$ Since\n\n$$\nf(t)=\\frac{5}{2}(2{cos}^{2}\\,(\\frac{5}{2}t)-1)=\\frac{5}{2}\\operatorname{cos}⁡(5t),\n$$\n\nthe frequency of the external periodic force is $5.$\n\nTherefore,\n\n$$\nk=\\frac{4}{5}{\\omega }^{2}=\\frac{4}{5}\\cdot {5}^{2}=20\\,{\\text{kg/s}}^{2}.\n$$" "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m$ and $F(t)$ gives\n\n$$\n0.8{y}^{″}=-ky+\\left(4{cos}^{2}\\,\\left(\\frac{5}{2}t\\right)-2\\right).\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+\\frac{5k}{4}y=\\frac{5}{2}\\left(2{cos}^{2}\\,\\left(\\frac{5}{2}t\\right)-1\\right).\n$$\n\nThe complementary solution ${y}_{c}$ here represents simple harmonic motion, and it can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration, and $\\omega $ is the system's internal frequency.\n\nIn our case,\n\n$$\n{\\omega }^{2}=\\frac{5k}{4}\\,⟹\\,k=\\frac{4}{5}{\\omega }^{2}.\n$$\n\nThe oscillator experiences resonance when the frequency of the external periodic force $$\n\\displaystyle f(t)=\\frac{5}{2}\\left(2{cos}^{2}\\,\\left(\\frac{5}{2}t\\right)-1\\right)\n$$ is equal to the frequency of the complementary solution $\\omega .$ Since\n\n$$\nf(t)=\\frac{5}{2}\\left(2{cos}^{2}\\,\\left(\\frac{5}{2}t\\right)-1\\right)=\\frac{5}{2}\\operatorname{cos}⁡(5t),\n$$\n\nthe frequency of the external periodic force is $5.$\n\nTherefore,\n\n$$\nk=\\frac{4}{5}{\\omega }^{2}=\\frac{4}{5}\\cdot {5}^{2}=20\\,{\\text{kg/s}}^{2}.\n$$"] [:db/cas 17592186495097 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=150$ and $p=0.48.$ Therefore, \n\n$$\n\\begin{aligned}np & =150\\cdot 0.48 \\\\  & =72 \\\\  & >5\\,✓ \\\\ n(1-p) & =150\\cdot (1-0.48) \\\\  & =78 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(150)(0.48)=72\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(150)(0.48)(1-0.48)=37.44.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(72,37.44).$\n\nNow, we can approximate the desired probability $P(X=67).$ Using a continuity correction, we have\n\n$$\nP(X=67)≈P(66.5\\le Y\\le 67.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(66.5\\le Y\\le 67.5) & =P(\\frac{66.5-72}{\\sqrt{37.44}}\\le Z\\le \\frac{67.5-72}{\\sqrt{37.44}}) \\\\  & ≈P(-0.90\\le Z\\le -0.74) \\\\  & =P(Z\\le -0.74)-P(Z<-0.90) \\\\  & =P(Z\\le -0.74)-P(Z\\le -0.90) \\\\  & =Φ(-0.74)-Φ(-0.90) \\\\  & =0.2297-0.1841 \\\\  & =0.046\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=67)≈0.046.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0468.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=150$ and $p=0.48.$ Therefore, \n\n$$\n\\begin{aligned}np & =150\\cdot 0.48 \\\\  & =72 \\\\  & >5\\,✓ \\\\ n(1-p) & =150\\cdot (1-0.48) \\\\  & =78 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(150)(0.48)=72\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(150)(0.48)(1-0.48)=37.44.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(72,37.44).$\n\nNow, we can approximate the desired probability $P(X=67).$ Using a continuity correction, we have\n\n$$\nP(X=67)≈P(66.5\\le Y\\le 67.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(66.5\\le Y\\le 67.5) & =P\\left(\\frac{66.5-72}{\\sqrt{37.44}}\\le Z\\le \\frac{67.5-72}{\\sqrt{37.44}}\\right) \\\\  & ≈P(-0.90\\le Z\\le -0.74) \\\\  & =P(Z\\le -0.74)-P(Z<-0.90) \\\\  & =P(Z\\le -0.74)-P(Z\\le -0.90) \\\\  & =Φ(-0.74)-Φ(-0.90) \\\\  & =0.2297-0.1841 \\\\  & =0.046\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=67)≈0.046.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0468.$"] [:db/cas 17592186495099 :question/problem "The domain of the vector-valued function $$\n\\displaystyle f(t)=\\operatorname{sin}⁡t\\,i+(1+t)\\,j+\\operatorname{cot}⁡(t-\\frac{\\pi }{4})\\,k\n$$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." "The domain of the vector-valued function $$\n\\displaystyle f(t)=\\operatorname{sin}⁡t\\,i+(1+t)\\,j+\\operatorname{cot}⁡\\left(t-\\frac{\\pi }{4}\\right)\\,k\n$$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\bbox[5pt,border:1pt solid black]{\\phantom{AAAAA}}.\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer."] [:db/cas 17592186495099 :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sin}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $1+t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{cot}⁡(t-\\frac{\\pi }{4})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt-\\frac{\\pi }{4}=\\pi n\\,⟹\\,t=\\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer." "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sin}⁡t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $1+t$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{cot}⁡\\left(t-\\frac{\\pi }{4}\\right)$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt-\\frac{\\pi }{4}=\\pi n\\,⟹\\,t=\\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer."] [:db/cas 17592186495100 :question/worked-solution "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le xy\\le 4,\\,1\\le \\frac{y}{x}\\le 5,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=xy\\,\\text{and}\\,v=\\frac{y}{x}.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,1\\le v\\le 5\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\text{ }\\text{ }\\text{ }y & x \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{vmatrix} \\\\  & =\\frac{2y}{x}.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(\\frac{2y}{x}\\right)}=\\frac{1}{2v}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{{y}^{2}}{{x}^{2}}\\operatorname{sin}⁡(\\pi xy)\\,\\text{d}x\\text{d}y & ={∬}_{D}{\\left(\\frac{y}{x}\\right)}^{2}\\operatorname{sin}⁡(\\pi xy)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{Δ}{v}^{2}\\operatorname{sin}⁡(\\pi u)|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\operatorname{sin}⁡(\\pi u)|\\frac{1}{2v}|\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u)[{\\int }_{1}^{5}v\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u){[\\frac{1}{2}\\,{v}^{2}]}_{1}^{5}\\,du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\operatorname{sin}⁡(\\pi u)\\cdot 12\\,du \\\\  & =6{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u)\\,du \\\\  & =6{[-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi u)]}_{1}^{4} \\\\  & =-\\frac{6}{\\pi }(1-(-1)) \\\\  & =-\\frac{12}{\\pi }.\\end{aligned}\n$$" "Let's define a transformation $T$ as follows:\n\n$$\nT:\\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}x(u,v) \\\\ y(u,v)\\end{bmatrix}\n$$\n\nThis transformation maps some region $Δ$ in the $uv$-plane to our region $D$ in the $xy$-plane.\n\nTo compute the required integral, we can use the change of variables formula\n\n$$\n{∬}_{D}f(x,y)\\text{ }dxdy={∬}_{Δ}\\text{ }f(x(u,v),y(u,v))\\,|\\frac{∂(x,y)}{∂(u,v)}|\\text{ }dudv\n$$\n\nwhere $\\frac{∂(x,y)}{∂(u,v)}$ is the Jacobian determinant corresponding to $T.$\n\nTo compute the required integral, we proceed as follows:\n\n**Step 1**: Find a suitable change of variables.\n\nThe inequalities that define the region $D,$\n\n$$\n1\\le xy\\le 4,\\,1\\le \\frac{y}{x}\\le 5,\n$$\n\nsuggest that we use the change of variables \n\n$$\nu=xy\\,\\text{and}\\,v=\\frac{y}{x}.\n$$\n\nThis change of variables gives us the *inverse* function ${T}^{-1},$ that is\n\n$$\n{T}^{-1}:\\begin{bmatrix}x \\\\ y\\end{bmatrix}\\to \\begin{bmatrix}u(x,y) \\\\ v(x,y)\\end{bmatrix}.\n$$\n\n**Step 2**: Find $Δ,$ which is the image of $D$ under the action of ${T}^{-1}.$ \n\nOur domain in the $uv$-plane is\n\n$$\n\\begin{aligned}Δ & =\\{(u,v)\\,:\\,1\\le u\\le 4,\\,1\\le v\\le 5\\}.\\end{aligned}\n$$\n\n**Step 3**: Compute the Jacobian determinant corresponding to ${T}^{-1}:$\n\nThe Jacobian determinant corresponding to ${T}^{-1}$ is\n\n$$\n\\begin{aligned}\\frac{∂(u,v)}{∂(x,y)} & =\\begin{vmatrix}\\frac{∂u}{∂x} & \\frac{∂u}{∂y} \\\\ \\frac{∂v}{∂x} & \\frac{∂v}{∂y}\\end{vmatrix} \\\\  & =\\begin{vmatrix}\\text{ }\\text{ }\\text{ }y & x \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{vmatrix} \\\\  & =\\frac{2y}{x}.\\end{aligned}\n$$\n\n**Step 4**: Compute the Jacobian determinant corresponding to $T:$\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}={\\left(\\frac{∂(u,v)}{∂(x,y)}\\right)}^{-1}=\\frac{1}{\\left(\\frac{2y}{x}\\right)}=\\frac{1}{2v}\n$$\n\nNote that $\\frac{∂(x,y)}{∂(u,v)}\\ne 0$ everywhere inside $Δ.$ In other words, $T$ has no critical points inside $Δ.$\n\n**Step 5**: Perform the change of variables, and evaluate the integral:\n\nPerforming the change of variables, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{{y}^{2}}{{x}^{2}}\\operatorname{sin}⁡(\\pi xy)\\,\\text{d}x\\text{d}y & ={∬}_{D}{\\left(\\frac{y}{x}\\right)}^{2}\\operatorname{sin}⁡(\\pi xy)\\,\\text{d}x\\text{d}y \\\\  & ={∬}_{Δ}{v}^{2}\\operatorname{sin}⁡(\\pi u)|\\frac{∂(x,y)}{∂(u,v)}|\\text{d}u\\text{d}v \\\\  & ={∬}_{Δ}{v}^{2}\\operatorname{sin}⁡(\\pi u)|\\frac{1}{2v}|\\text{d}u\\text{d}v \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u)[{\\int }_{1}^{5}v\\,dv]du \\\\  & =\\frac{1}{2}{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u){\\left[\\frac{1}{2}\\,{v}^{2}\\right]}_{1}^{5}\\,du \\\\  & =\\frac{1}{2}{\\int }_{1}^{2}\\operatorname{sin}⁡(\\pi u)\\cdot 12\\,du \\\\  & =6{\\int }_{1}^{4}\\operatorname{sin}⁡(\\pi u)\\,du \\\\  & =6{\\left[-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi u)\\right]}_{1}^{4} \\\\  & =-\\frac{6}{\\pi }(1-(-1)) \\\\  & =-\\frac{12}{\\pi }.\\end{aligned}\n$$"] [:db/cas 17592186495106 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=240$ and $p=0.45.$ Therefore, \n\n$$\n\\begin{aligned}np & =240\\cdot 0.45 \\\\  & =108 \\\\  & >5\\,✓ \\\\ n(1-p) & =240\\cdot (1-0.45) \\\\  & =132 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(240)(0.45)=108\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(240)(0.45)(1-0.45)=59.4.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(108,59.4).$\n\nNow, we can estimate the desired probability $P(X>100).$ Using a continuity correction, we have\n\n$$\nP(X>100)=P(X\\ge 101)≈P(Y\\ge 100.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 100.5) & =P(Z\\ge \\frac{100.5-108}{\\sqrt{59.4}}) \\\\  & ≈P(Z\\ge -0.97) \\\\  & =1-P(Z<-0.97) \\\\  & =1-P(Z\\le -0.97) \\\\  & =1-Φ(-0.97) \\\\  & =1-0.1660 \\\\  & =0.834\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X>100)≈0.834.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.8347.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=240$ and $p=0.45.$ Therefore, \n\n$$\n\\begin{aligned}np & =240\\cdot 0.45 \\\\  & =108 \\\\  & >5\\,✓ \\\\ n(1-p) & =240\\cdot (1-0.45) \\\\  & =132 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(240)(0.45)=108\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(240)(0.45)(1-0.45)=59.4.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(108,59.4).$\n\nNow, we can estimate the desired probability $P(X>100).$ Using a continuity correction, we have\n\n$$\nP(X>100)=P(X\\ge 101)≈P(Y\\ge 100.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y\\ge 100.5) & =P\\left(Z\\ge \\frac{100.5-108}{\\sqrt{59.4}}\\right) \\\\  & ≈P(Z\\ge -0.97) \\\\  & =1-P(Z<-0.97) \\\\  & =1-P(Z\\le -0.97) \\\\  & =1-Φ(-0.97) \\\\  & =1-0.1660 \\\\  & =0.834\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X>100)≈0.834.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.8347.$"] [:db/cas 17592186495114 :question/worked-solution "First, notice that the unit tangent and the principal normal at the point where $t=1$ are\n\n$$\n\\begin{aligned}T(1) & =\\frac{1}{(1)^{2}+2}(-2\\,i+2(1)\\,j+(1)^{2}\\,k)=\\frac{1}{3}(-2\\,i+2\\,j+k) \\\\ N(1) & =\\frac{1}{(1)^{2}+2}[2(1)\\,i+(2-(1)^{2})\\,j+2(1)\\,k]=\\frac{1}{3}[2\\,i+j+2\\,k].\\end{aligned}\n$$\n\nAlso, the position vector of the point where $t=1$ is\n\n$$\np=r(1)=-6(1)\\,i+3(1)^{2}\\,j+(1)^{3}\\,k=⟨-6,3,1⟩.\n$$\n\nNow, we need to find a vector that's perpendicular to the osculating plane. To do that, we use the cross product of the unit tangent $T(1)$ and the principal normal $N(1):$\n\n$$\n\\begin{aligned}T(1)\\times N(1) & =(\\frac{1}{3}(-2\\,i+2\\,j+k))\\times (\\frac{1}{3}[2\\,i+j+2\\,k]) \\\\  & =(\\frac{1}{3}\\cdot \\frac{1}{3})\\cdot \\begin{vmatrix}i & j & k \\\\ -2 & 2 & 1 \\\\ 2 & 1 & 2\\end{vmatrix} \\\\  & =\\frac{1}{9}\\left[\\text{ }\\begin{vmatrix}2 & 1 \\\\ 1 & 2\\end{vmatrix}\\,i-\\begin{vmatrix}-2 & 1 \\\\ 2 & 2\\end{vmatrix}\\,j+\\begin{vmatrix}-2 & 2 \\\\ 2 & 1\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{9}(3\\,i+6\\,j-6\\,k)\\end{aligned}\n$$\n\nSince we are interested only in the direction of the above vector, let's write our perpendicular vector $n$ as \n\n$$\nn=3\\cdot (T(1)\\times N(1))=i+2\\,j-2\\,k=⟨1,2,-2⟩.\n$$\n\nFinally, let $⟨x,y,z⟩$ denote the position vector of a point on the osculating plane. Since the plane is perpendicular to $n$ and passes through the tip of the position vector $p$, its Cartesian equation can be written as\n\n$$\n\\begin{aligned}(⟨x,y,z⟩-p)\\cdot n & =0 \\\\ ⟨x,y,z⟩\\cdot n-p\\cdot n & =0 \\\\ ⟨x,y,z⟩\\cdot n & =p\\cdot n \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,-2⟩ & =⟨-6,3,1⟩\\cdot ⟨1,2,-2⟩ \\\\ 1\\cdot x+2\\cdot y+(-2)\\cdot z & =-2 \\\\ x+2y-2z+2 & =0.\\end{aligned}\n$$" "First, notice that the unit tangent and the principal normal at the point where $t=1$ are\n\n$$\n\\begin{aligned}T(1) & =\\frac{1}{(1)^{2}+2}(-2\\,i+2(1)\\,j+(1)^{2}\\,k)=\\frac{1}{3}(-2\\,i+2\\,j+k) \\\\ N(1) & =\\frac{1}{(1)^{2}+2}[2(1)\\,i+(2-(1)^{2})\\,j+2(1)\\,k]=\\frac{1}{3}[2\\,i+j+2\\,k].\\end{aligned}\n$$\n\nAlso, the position vector of the point where $t=1$ is\n\n$$\np=r(1)=-6(1)\\,i+3(1)^{2}\\,j+(1)^{3}\\,k=⟨-6,3,1⟩.\n$$\n\nNow, we need to find a vector that's perpendicular to the osculating plane. To do that, we use the cross product of the unit tangent $T(1)$ and the principal normal $N(1):$\n\n$$\n\\begin{aligned}T(1)\\times N(1) & =\\left(\\frac{1}{3}(-2\\,i+2\\,j+k)\\right)\\times \\left(\\frac{1}{3}[2\\,i+j+2\\,k]\\right) \\\\  & =\\left(\\frac{1}{3}\\cdot \\frac{1}{3}\\right)\\cdot \\begin{vmatrix}i & j & k \\\\ -2 & 2 & 1 \\\\ 2 & 1 & 2\\end{vmatrix} \\\\  & =\\frac{1}{9}\\left[\\text{ }\\begin{vmatrix}2 & 1 \\\\ 1 & 2\\end{vmatrix}\\,i-\\begin{vmatrix}-2 & 1 \\\\ 2 & 2\\end{vmatrix}\\,j+\\begin{vmatrix}-2 & 2 \\\\ 2 & 1\\end{vmatrix}\\,k\\text{ }\\right] \\\\  & =\\frac{1}{9}(3\\,i+6\\,j-6\\,k)\\end{aligned}\n$$\n\nSince we are interested only in the direction of the above vector, let's write our perpendicular vector $n$ as \n\n$$\nn=3\\cdot (T(1)\\times N(1))=i+2\\,j-2\\,k=⟨1,2,-2⟩.\n$$\n\nFinally, let $⟨x,y,z⟩$ denote the position vector of a point on the osculating plane. Since the plane is perpendicular to $n$ and passes through the tip of the position vector $p$, its Cartesian equation can be written as\n\n$$\n\\begin{aligned}(⟨x,y,z⟩-p)\\cdot n & =0 \\\\ ⟨x,y,z⟩\\cdot n-p\\cdot n & =0 \\\\ ⟨x,y,z⟩\\cdot n & =p\\cdot n \\\\ ⟨x,y,z⟩\\cdot ⟨1,2,-2⟩ & =⟨-6,3,1⟩\\cdot ⟨1,2,-2⟩ \\\\ 1\\cdot x+2\\cdot y+(-2)\\cdot z & =-2 \\\\ x+2y-2z+2 & =0.\\end{aligned}\n$$"] [:db/cas 17592186495132 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=85$ and $p=0.56.$ Therefore, \n\n$$\n\\begin{aligned}np & =85\\cdot 0.56 \\\\  & =47.6 \\\\  & >5\\,✓ \\\\ n(1-p) & =85\\cdot (1-0.56) \\\\  & =37.4 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(85)(0.56)=47.6\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(85)(0.56)(1-0.56)=20.94.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(47.6,20.94).$\n\nNow, we can approximate the desired probability $P(X=50).$ Using a continuity correction, we have\n\n$$\nP(X=50)≈P(49.5\\le Y\\le 50.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(49.5\\le Y\\le 50.5) & =P(\\frac{49.5-47.6}{\\sqrt{20.94}}\\le Z\\le \\frac{50.5-47.6}{\\sqrt{20.94}}) \\\\  & ≈P(0.42\\le Z\\le 0.63) \\\\  & =P(Z\\le 0.63)-P(Z<0.42) \\\\  & =P(Z\\le 0.63)-P(Z\\le 0.42) \\\\  & =Φ(0.63)-Φ(0.42) \\\\  & =0.7357-0.6628 \\\\  & =0.073\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=50)≈0.073.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0758.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=85$ and $p=0.56.$ Therefore, \n\n$$\n\\begin{aligned}np & =85\\cdot 0.56 \\\\  & =47.6 \\\\  & >5\\,✓ \\\\ n(1-p) & =85\\cdot (1-0.56) \\\\  & =37.4 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(85)(0.56)=47.6\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(85)(0.56)(1-0.56)=20.94.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(47.6,20.94).$\n\nNow, we can approximate the desired probability $P(X=50).$ Using a continuity correction, we have\n\n$$\nP(X=50)≈P(49.5\\le Y\\le 50.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(49.5\\le Y\\le 50.5) & =P\\left(\\frac{49.5-47.6}{\\sqrt{20.94}}\\le Z\\le \\frac{50.5-47.6}{\\sqrt{20.94}}\\right) \\\\  & ≈P(0.42\\le Z\\le 0.63) \\\\  & =P(Z\\le 0.63)-P(Z<0.42) \\\\  & =P(Z\\le 0.63)-P(Z\\le 0.42) \\\\  & =Φ(0.63)-Φ(0.42) \\\\  & =0.7357-0.6628 \\\\  & =0.073\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=50)≈0.073.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0758.$"] [:db/cas 17592186495137 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=25$ and $p=0.58.$ Therefore, \n\n$$\n\\begin{aligned}np & =25\\cdot 0.58 \\\\  & =14.5 \\\\  & >5\\,✓ \\\\ n(1-p) & =25\\cdot (1-0.58) \\\\  & =10.5 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(25)(0.58)=14.5\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(25)(0.58)(1-0.58)=6.09.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(14.5,6.09).$\n\nNow, we can approximate the desired probability $P(X=16).$ Using a continuity correction, we have\n\n$$\nP(X=16)≈P(15.5\\le Y\\le 16.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(15.5\\le Y\\le 16.5) & =P(\\frac{15.5-14.5}{\\sqrt{6.09}}\\le Z\\le \\frac{16.5-14.5}{\\sqrt{6.09}}) \\\\  & ≈P(0.41\\le Z\\le 0.81) \\\\  & =P(Z\\le 0.81)-P(Z<0.41) \\\\  & =P(Z\\le 0.81)-P(Z\\le 0.41) \\\\  & =Φ(0.81)-Φ(0.41) \\\\  & =0.7910-0.6591 \\\\  & =0.132\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=16)≈0.132.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.1363.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=25$ and $p=0.58.$ Therefore, \n\n$$\n\\begin{aligned}np & =25\\cdot 0.58 \\\\  & =14.5 \\\\  & >5\\,✓ \\\\ n(1-p) & =25\\cdot (1-0.58) \\\\  & =10.5 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(25)(0.58)=14.5\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(25)(0.58)(1-0.58)=6.09.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(14.5,6.09).$\n\nNow, we can approximate the desired probability $P(X=16).$ Using a continuity correction, we have\n\n$$\nP(X=16)≈P(15.5\\le Y\\le 16.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(15.5\\le Y\\le 16.5) & =P\\left(\\frac{15.5-14.5}{\\sqrt{6.09}}\\le Z\\le \\frac{16.5-14.5}{\\sqrt{6.09}}\\right) \\\\  & ≈P(0.41\\le Z\\le 0.81) \\\\  & =P(Z\\le 0.81)-P(Z<0.41) \\\\  & =P(Z\\le 0.81)-P(Z\\le 0.41) \\\\  & =Φ(0.81)-Φ(0.41) \\\\  & =0.7910-0.6591 \\\\  & =0.132\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=16)≈0.132.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.1363.$"] [:db/cas 17592186495149 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=120$ and $p=0.6.$ Therefore, \n\n$$\n\\begin{aligned}np & =120\\cdot 0.6 \\\\  & =72 \\\\  & >5\\,✓ \\\\ n(1-p) & =12\\cdot (1-0.6) \\\\  & =48 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(120)(0.6)=72\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(120)(0.6)(1-0.6)=28.8.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(72,28.8).$\n\nNow, we can approximate the desired probability $P(X=80).$ Using a continuity correction, we have\n\n$$\nP(X=80)≈P(79.5\\le Y\\le 80.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(79.5\\le Y\\le 80.5) & =P(\\frac{79.5-72}{\\sqrt{28.8}}\\le Z\\le \\frac{80.5-72}{\\sqrt{28.8}}) \\\\  & ≈P(1.40\\le Z\\le 1.58) \\\\  & =P(Z\\le 1.58)-P(Z<1.40) \\\\  & =P(Z\\le 1.58)-P(Z\\le 1.40) \\\\  & =Φ(1.58)-Φ(1.40) \\\\  & =0.9429-0.9192 \\\\  & =0.0237\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=80)≈0.024.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0245.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=120$ and $p=0.6.$ Therefore, \n\n$$\n\\begin{aligned}np & =120\\cdot 0.6 \\\\  & =72 \\\\  & >5\\,✓ \\\\ n(1-p) & =12\\cdot (1-0.6) \\\\  & =48 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(120)(0.6)=72\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(120)(0.6)(1-0.6)=28.8.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(72,28.8).$\n\nNow, we can approximate the desired probability $P(X=80).$ Using a continuity correction, we have\n\n$$\nP(X=80)≈P(79.5\\le Y\\le 80.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(79.5\\le Y\\le 80.5) & =P\\left(\\frac{79.5-72}{\\sqrt{28.8}}\\le Z\\le \\frac{80.5-72}{\\sqrt{28.8}}\\right) \\\\  & ≈P(1.40\\le Z\\le 1.58) \\\\  & =P(Z\\le 1.58)-P(Z<1.40) \\\\  & =P(Z\\le 1.58)-P(Z\\le 1.40) \\\\  & =Φ(1.58)-Φ(1.40) \\\\  & =0.9429-0.9192 \\\\  & =0.0237\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=80)≈0.024.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0245.$"] [:db/cas 17592186495156 :question/worked-solution "First, we substitute $u=3t-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=3\\,⟹\\,\\text{d}u=3\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=3t-2$ is as follows:\n\n| $t$ | $2$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $4$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t & ={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{\\infty }{u}^{-5/2}\\,\\text{d}u \\\\  & =\\lim_{a\\to \\infty }{\\int }_{4}^{a}{u}^{-5/2}\\,\\text{d}u \\\\  & =\\cdot {lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{(a)^{3/2}}-\\frac{1}{(4)^{3/2}}] \\\\  & =-\\frac{2}{3}\\cdot (0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" "First, we substitute $u=3t-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=3\\,⟹\\,\\text{d}u=3\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=3t-2$ is as follows:\n\n| $t$ | $2$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $4$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{3}{\\sqrt{(3t-2)^{5}}}\\,\\text{d}t & ={\\int }_{4}^{\\infty }\\frac{1}{\\sqrt{{u}^{5}}}\\,\\text{d}u \\\\  & ={\\int }_{4}^{\\infty }{u}^{-5/2}\\,\\text{d}u \\\\  & =\\lim_{a\\to \\infty }{\\int }_{4}^{a}{u}^{-5/2}\\,\\text{d}u \\\\  & =\\cdot {lim}_{a\\to \\infty }{\\left[-\\frac{2}{3}{u}^{-3/2}\\right]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3/2}]}_{4}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }\\left[\\frac{1}{(a)^{3/2}}-\\frac{1}{(4)^{3/2}}\\right] \\\\  & =-\\frac{2}{3}\\cdot \\left(0-\\frac{1}{8}\\right) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"] [:db/cas 17592186495164 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=60$ and $p=0.58.$ Therefore, \n\n$$\n\\begin{aligned}np & =60\\cdot 0.58 \\\\  & =34.8 \\\\  & >5\\,✓ \\\\ n(1-p) & =60\\cdot (1-0.58) \\\\  & =25.2 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(60)(0.58)=34.8\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(60)(0.58)(1-0.58)=14.62.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(34.8,14.62).$\n\nNow, we can approximate the desired probability $P(X=40).$ Using a continuity correction, we have\n\n$$\nP(X=40)≈P(39.5\\le Y\\le 40.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(39.5\\le Y\\le 40.5) & =P(\\frac{39.5-34.8}{\\sqrt{14.62}}\\le Z\\le \\frac{40.5-34.8}{\\sqrt{14.62}}) \\\\  & ≈P(1.23\\le Z\\le 1.49) \\\\  & =P(Z\\le 1.49)-P(Z<1.23) \\\\  & =P(Z\\le 1.49)-P(Z\\le 1.23) \\\\  & =Φ(1.49)-Φ(1.23) \\\\  & =0.9319-0.8907 \\\\  & =0.0412\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=40)≈0.041.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0415.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=60$ and $p=0.58.$ Therefore, \n\n$$\n\\begin{aligned}np & =60\\cdot 0.58 \\\\  & =34.8 \\\\  & >5\\,✓ \\\\ n(1-p) & =60\\cdot (1-0.58) \\\\  & =25.2 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(60)(0.58)=34.8\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(60)(0.58)(1-0.58)=14.62.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(34.8,14.62).$\n\nNow, we can approximate the desired probability $P(X=40).$ Using a continuity correction, we have\n\n$$\nP(X=40)≈P(39.5\\le Y\\le 40.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(39.5\\le Y\\le 40.5) & =P\\left(\\frac{39.5-34.8}{\\sqrt{14.62}}\\le Z\\le \\frac{40.5-34.8}{\\sqrt{14.62}}\\right) \\\\  & ≈P(1.23\\le Z\\le 1.49) \\\\  & =P(Z\\le 1.49)-P(Z<1.23) \\\\  & =P(Z\\le 1.49)-P(Z\\le 1.23) \\\\  & =Φ(1.49)-Φ(1.23) \\\\  & =0.9319-0.8907 \\\\  & =0.0412\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X=40)≈0.041.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.0415.$"] [:db/cas 17592186495174 :question/worked-solution "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=50$ and $p=0.6.$ Therefore, \n\n$$\n\\begin{aligned}np & =50\\cdot 0.6 \\\\  & =30 \\\\  & >5\\,✓ \\\\ n(1-p) & =50\\cdot (1-0.6) \\\\  & =20 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(50)(0.6)=30\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(50)(0.6)(1-0.6)=12.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(30,12).$\n\nNow, we can estimate the desired probability $P(X\\ge 21).$ Using a continuity correction, we have\n\n$$\nP(X\\ge 21)≈P(Y>20.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y>20.5) & =1-P(Y\\le 20.5) \\\\  & =1-P(Z\\le \\frac{20.5-30}{\\sqrt{12}}) \\\\  & ≈1-P(Z\\le -2.74) \\\\  & =1-Φ(-2.74) \\\\  & =1-0.0031 \\\\  & =0.9969\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X\\ge 21)≈0.997.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.9966.$" "Given a binomial random variable $X∼B(n,p),$ if \n\n- $np>5,$ and\n\n- $n(1-p)>5,$\n\nwe can approximate $X$ as a normal random variable $Y$ with mean $\\mu =np$ and variance ${\\sigma }^{2}=np(1-p),$ that is, \n\n$$\nY∼N(np,np(1-p)).\n$$\n\nHere, we have $n=50$ and $p=0.6.$ Therefore, \n\n$$\n\\begin{aligned}np & =50\\cdot 0.6 \\\\  & =30 \\\\  & >5\\,✓ \\\\ n(1-p) & =50\\cdot (1-0.6) \\\\  & =20 \\\\  & >5.\\,✓\\end{aligned}\n$$\n\nSo, we can approximate our binomial random variable $X$ with a normal random variable $Y$ with mean\n\n$$\n\\mu =np=(50)(0.6)=30\n$$\n\nand variance\n\n$$\n{\\sigma }^{2}=np(1-p)=(50)(0.6)(1-0.6)=12.\n$$\n\nThat is, we can approximate $X$ by $Y∼N(30,12).$\n\nNow, we can estimate the desired probability $P(X\\ge 21).$ Using a continuity correction, we have\n\n$$\nP(X\\ge 21)≈P(Y>20.5).\n$$\n\nTo compute this probability, we transform to a standard normal random variable by $z$-scoring:\n\n$$\n\\begin{aligned}P(Y>20.5) & =1-P(Y\\le 20.5) \\\\  & =1-P\\left(Z\\le \\frac{20.5-30}{\\sqrt{12}}\\right) \\\\  & ≈1-P(Z\\le -2.74) \\\\  & =1-Φ(-2.74) \\\\  & =1-0.0031 \\\\  & =0.9969\\end{aligned}\n$$\n\nTherefore,\n\n$$\nP(X\\ge 21)≈0.997.\n$$\n\nNote: Using a software package for the approximation gives a probability of $0.9966.$"] [:db/cas 17592186495382 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=1$ and $Q(x)=2.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 1\\,\\text{d}x} \\\\  & =e^{x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{x}$ yields\n\n$$\n\\begin{aligned}e^{x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+1y) & =e^{x}\\cdot 2 \\\\ e^{x}\\frac{\\text{d}y}{\\text{d}x}+e^{x}y & =2 e^{x} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{x}) & =2 e^{x}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{x})\\,\\text{d}x & =\\int 2 e^{x}\\,\\text{d}x \\\\ ye^{x} & =2\\left(1 e^{x}\\right)+C \\\\ ye^{x} & =2 e^{x}+C \\\\ y & =\\left(C + 2 e^{x}\\right) e^{- x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=3$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(2 e^{(0)})+C}{(e^{(0)})} \\\\ 3 & =\\frac{2+C}{1} \\\\ C & =1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2 + e^{- x}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=1$ and $Q(x)=2.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 1\\,\\text{d}x} \\\\  & =e^{x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{x}$ yields\n\n$$\n\\begin{aligned}e^{x}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+1y\\right) & =e^{x}\\cdot 2 \\\\ e^{x}\\frac{\\text{d}y}{\\text{d}x}+e^{x}y & =2 e^{x} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{x}) & =2 e^{x}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{x})\\,\\text{d}x & =\\int 2 e^{x}\\,\\text{d}x \\\\ ye^{x} & =2\\left(1 e^{x}\\right)+C \\\\ ye^{x} & =2 e^{x}+C \\\\ y & =\\left(C + 2 e^{x}\\right) e^{- x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=3$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(2 e^{(0)})+C}{(e^{(0)})} \\\\ 3 & =\\frac{2+C}{1} \\\\ C & =1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2 + e^{- x}.\n$$"] [:db/cas 17592186495383 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x}{5}$ and $Q(x)=\\frac{4 x}{5}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{x}{5}\\,\\text{d}x} \\\\  & =e^{\\frac{x^{2}}{10}}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{\\frac{x^{2}}{10}}$ yields\n\n$$\n\\begin{aligned}e^{\\frac{x^{2}}{10}}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{5}y) & =e^{\\frac{x^{2}}{10}}\\cdot \\frac{4 x}{5} \\\\ e^{\\frac{x^{2}}{10}}\\frac{\\text{d}y}{\\text{d}x}+\\frac{x e^{\\frac{x^{2}}{10}}}{5}y & =\\frac{4 x e^{\\frac{x^{2}}{10}}}{5} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{10}}) & =\\frac{4 x e^{\\frac{x^{2}}{10}}}{5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{x^{2}}{10}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{10}})\\,\\text{d}x & =\\int \\frac{4 x e^{\\frac{x^{2}}{10}}}{5}\\,\\text{d}x \\\\ ye^{\\frac{x^{2}}{10}} & =\\int 4e^u\\,\\text{d}u \\\\ ye^{\\frac{x^{2}}{10}} & =4e^u+C \\\\ ye^{\\frac{x^{2}}{10}} & =4 e^{\\frac{x^{2}}{10}}+C \\\\ y & =\\left(C + 4 e^{\\frac{x^{2}}{10}}\\right) e^{- \\frac{x^{2}}{10}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=-6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(4 e^{\\frac{(0)^{2}}{10}})+C}{(e^{\\frac{(0)^{2}}{10}})} \\\\ -6 & =\\frac{4+C}{1} \\\\ C & =-10\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=4 - 10 e^{- \\frac{x^{2}}{10}}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x}{5}$ and $Q(x)=\\frac{4 x}{5}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{x}{5}\\,\\text{d}x} \\\\  & =e^{\\frac{x^{2}}{10}}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{\\frac{x^{2}}{10}}$ yields\n\n$$\n\\begin{aligned}e^{\\frac{x^{2}}{10}}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{5}y\\right) & =e^{\\frac{x^{2}}{10}}\\cdot \\frac{4 x}{5} \\\\ e^{\\frac{x^{2}}{10}}\\frac{\\text{d}y}{\\text{d}x}+\\frac{x e^{\\frac{x^{2}}{10}}}{5}y & =\\frac{4 x e^{\\frac{x^{2}}{10}}}{5} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{10}}) & =\\frac{4 x e^{\\frac{x^{2}}{10}}}{5}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{x^{2}}{10}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{10}})\\,\\text{d}x & =\\int \\frac{4 x e^{\\frac{x^{2}}{10}}}{5}\\,\\text{d}x \\\\ ye^{\\frac{x^{2}}{10}} & =\\int 4e^u\\,\\text{d}u \\\\ ye^{\\frac{x^{2}}{10}} & =4e^u+C \\\\ ye^{\\frac{x^{2}}{10}} & =4 e^{\\frac{x^{2}}{10}}+C \\\\ y & =\\left(C + 4 e^{\\frac{x^{2}}{10}}\\right) e^{- \\frac{x^{2}}{10}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=-6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(4 e^{\\frac{(0)^{2}}{10}})+C}{(e^{\\frac{(0)^{2}}{10}})} \\\\ -6 & =\\frac{4+C}{1} \\\\ C & =-10\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=4 - 10 e^{- \\frac{x^{2}}{10}}.\n$$"] [:db/cas 17592186495395 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x^{2}}{3}$ and $Q(x)=\\frac{5 x^{2}}{3}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{x^{2}}{3}\\,\\text{d}x} \\\\  & =e^{\\frac{x^{3}}{9}}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{\\frac{x^{3}}{9}}$ yields\n\n$$\n\\begin{aligned}e^{\\frac{x^{3}}{9}}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{x^{2}}{3}y) & =e^{\\frac{x^{3}}{9}}\\cdot \\frac{5 x^{2}}{3} \\\\ e^{\\frac{x^{3}}{9}}\\frac{\\text{d}y}{\\text{d}x}+\\frac{x^{2} e^{\\frac{x^{3}}{9}}}{3}y & =\\frac{5 x^{2} e^{\\frac{x^{3}}{9}}}{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{3}}{9}}) & =\\frac{5 x^{2} e^{\\frac{x^{3}}{9}}}{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{x^{3}}{9}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{3}}{9}})\\,\\text{d}x & =\\int \\frac{5 x^{2} e^{\\frac{x^{3}}{9}}}{3}\\,\\text{d}x \\\\ ye^{\\frac{x^{3}}{9}} & =\\int 5e^u\\,\\text{d}u \\\\ ye^{\\frac{x^{3}}{9}} & =5e^u+C \\\\ ye^{\\frac{x^{3}}{9}} & =5 e^{\\frac{x^{3}}{9}}+C \\\\ y & =\\left(C + 5 e^{\\frac{x^{3}}{9}}\\right) e^{- \\frac{x^{3}}{9}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(5 e^{\\frac{(0)^{3}}{9}})+C}{(e^{\\frac{(0)^{3}}{9}})} \\\\ 6 & =\\frac{5+C}{1} \\\\ C & =1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=5 + e^{- \\frac{x^{3}}{9}}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x^{2}}{3}$ and $Q(x)=\\frac{5 x^{2}}{3}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{x^{2}}{3}\\,\\text{d}x} \\\\  & =e^{\\frac{x^{3}}{9}}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{\\frac{x^{3}}{9}}$ yields\n\n$$\n\\begin{aligned}e^{\\frac{x^{3}}{9}}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+\\frac{x^{2}}{3}y\\right) & =e^{\\frac{x^{3}}{9}}\\cdot \\frac{5 x^{2}}{3} \\\\ e^{\\frac{x^{3}}{9}}\\frac{\\text{d}y}{\\text{d}x}+\\frac{x^{2} e^{\\frac{x^{3}}{9}}}{3}y & =\\frac{5 x^{2} e^{\\frac{x^{3}}{9}}}{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{3}}{9}}) & =\\frac{5 x^{2} e^{\\frac{x^{3}}{9}}}{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{x^{3}}{9}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{3}}{9}})\\,\\text{d}x & =\\int \\frac{5 x^{2} e^{\\frac{x^{3}}{9}}}{3}\\,\\text{d}x \\\\ ye^{\\frac{x^{3}}{9}} & =\\int 5e^u\\,\\text{d}u \\\\ ye^{\\frac{x^{3}}{9}} & =5e^u+C \\\\ ye^{\\frac{x^{3}}{9}} & =5 e^{\\frac{x^{3}}{9}}+C \\\\ y & =\\left(C + 5 e^{\\frac{x^{3}}{9}}\\right) e^{- \\frac{x^{3}}{9}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(5 e^{\\frac{(0)^{3}}{9}})+C}{(e^{\\frac{(0)^{3}}{9}})} \\\\ 6 & =\\frac{5+C}{1} \\\\ C & =1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=5 + e^{- \\frac{x^{3}}{9}}.\n$$"] [:db/cas 17592186495406 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=1$ and $Q(x)=6.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 1\\,\\text{d}x} \\\\  & =e^{x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{x}$ yields\n\n$$\n\\begin{aligned}e^{x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+1y) & =e^{x}\\cdot 6 \\\\ e^{x}\\frac{\\text{d}y}{\\text{d}x}+e^{x}y & =6 e^{x} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{x}) & =6 e^{x}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{x})\\,\\text{d}x & =\\int 6 e^{x}\\,\\text{d}x \\\\ ye^{x} & =6\\left(1 e^{x}\\right)+C \\\\ ye^{x} & =6 e^{x}+C \\\\ y & =\\left(C + 6 e^{x}\\right) e^{- x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=-3$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(6 e^{(0)})+C}{(e^{(0)})} \\\\ -3 & =\\frac{6+C}{1} \\\\ C & =-9\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=6 - 9 e^{- x}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=1$ and $Q(x)=6.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 1\\,\\text{d}x} \\\\  & =e^{x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{x}$ yields\n\n$$\n\\begin{aligned}e^{x}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+1y\\right) & =e^{x}\\cdot 6 \\\\ e^{x}\\frac{\\text{d}y}{\\text{d}x}+e^{x}y & =6 e^{x} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{x}) & =6 e^{x}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{x})\\,\\text{d}x & =\\int 6 e^{x}\\,\\text{d}x \\\\ ye^{x} & =6\\left(1 e^{x}\\right)+C \\\\ ye^{x} & =6 e^{x}+C \\\\ y & =\\left(C + 6 e^{x}\\right) e^{- x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=-3$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(6 e^{(0)})+C}{(e^{(0)})} \\\\ -3 & =\\frac{6+C}{1} \\\\ C & =-9\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=6 - 9 e^{- x}.\n$$"] [:db/cas 17592186495409 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=6$ and $Q(x)=6 x e^{- 6 x}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 6\\,\\text{d}x} \\\\  & =e^{6 x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{6 x}$ yields\n\n$$\n\\begin{aligned}e^{6 x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+6y) & =e^{6 x}\\cdot 6 x e^{- 6 x} \\\\ e^{6 x}\\frac{\\text{d}y}{\\text{d}x}+6 e^{6 x}y & =6 x \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{6 x}) & =6 x.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{6 x})\\,\\text{d}x & =\\int 6 x\\,\\text{d}x \\\\ ye^{6 x} & =3 x^{2}+C \\\\ y & =\\left(C + 3 x^{2}\\right) e^{- 6 x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(3 (0)^{2})+C}{(e^{6 (0)})} \\\\ 6 & =\\frac{0+C}{1} \\\\ C & =6\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=3 \\left(x^{2} + 2\\right) e^{- 6 x}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=6$ and $Q(x)=6 x e^{- 6 x}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 6\\,\\text{d}x} \\\\  & =e^{6 x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{6 x}$ yields\n\n$$\n\\begin{aligned}e^{6 x}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+6y\\right) & =e^{6 x}\\cdot 6 x e^{- 6 x} \\\\ e^{6 x}\\frac{\\text{d}y}{\\text{d}x}+6 e^{6 x}y & =6 x \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{6 x}) & =6 x.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{6 x})\\,\\text{d}x & =\\int 6 x\\,\\text{d}x \\\\ ye^{6 x} & =3 x^{2}+C \\\\ y & =\\left(C + 3 x^{2}\\right) e^{- 6 x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(3 (0)^{2})+C}{(e^{6 (0)})} \\\\ 6 & =\\frac{0+C}{1} \\\\ C & =6\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=3 \\left(x^{2} + 2\\right) e^{- 6 x}.\n$$"] [:db/cas 17592186495410 :question/worked-solution "The first step is to write the equation in standard form,\n\n$$\n\\begin{aligned}x\\frac{\\text{d}y}{\\text{d}x}+2y & =24 x^{2} \\\\ \\frac{1}{x}\\left(x\\frac{\\text{d}y}{\\text{d}x}+2y\\right) & =\\frac{1}{x}\\cdot 24 x^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y & =24 x\\end{aligned}\n$$\n\nThis equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{2}{x}$ and $Q(x)=24 x.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{2}{x}\\,\\text{d}x} \\\\  & =e^{2 \\ln{\\left(x \\right)}} \\\\  & =x^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=x^{2}$ yields\n\n$$\n\\begin{aligned}x^{2}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y) & =x^{2}\\cdot 24 x \\\\ x^{2}\\frac{\\text{d}y}{\\text{d}x}+2 xy & =24 x^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(yx^{2}) & =24 x^{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(yx^{2})\\,\\text{d}x & =\\int 24 x^{3}\\,\\text{d}x \\\\ yx^{2} & =6 x^{4}+C \\\\ y & =\\frac{C + 6 x^{4}}{x^{2}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(1)=-6$ as follows:\n\n$$\n\\begin{aligned}y(1) & =\\frac{(6 (1)^{4})+C}{((1)^{2})} \\\\ -6 & =\\frac{6+C}{1} \\\\ C & =-12\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{6 \\left(x^{4} - 2\\right)}{x^{2}}.\n$$" "The first step is to write the equation in standard form,\n\n$$\n\\begin{aligned}x\\frac{\\text{d}y}{\\text{d}x}+2y & =24 x^{2} \\\\ \\frac{1}{x}\\left(x\\frac{\\text{d}y}{\\text{d}x}+2y\\right) & =\\frac{1}{x}\\cdot 24 x^{2} \\\\ \\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y & =24 x\\end{aligned}\n$$\n\nThis equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{2}{x}$ and $Q(x)=24 x.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{2}{x}\\,\\text{d}x} \\\\  & =e^{2 \\ln{\\left(x \\right)}} \\\\  & =x^{2}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=x^{2}$ yields\n\n$$\n\\begin{aligned}x^{2}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y\\right) & =x^{2}\\cdot 24 x \\\\ x^{2}\\frac{\\text{d}y}{\\text{d}x}+2 xy & =24 x^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(yx^{2}) & =24 x^{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(yx^{2})\\,\\text{d}x & =\\int 24 x^{3}\\,\\text{d}x \\\\ yx^{2} & =6 x^{4}+C \\\\ y & =\\frac{C + 6 x^{4}}{x^{2}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(1)=-6$ as follows:\n\n$$\n\\begin{aligned}y(1) & =\\frac{(6 (1)^{4})+C}{((1)^{2})} \\\\ -6 & =\\frac{6+C}{1} \\\\ C & =-12\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{6 \\left(x^{4} - 2\\right)}{x^{2}}.\n$$"] [:db/cas 17592186495420 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x}{3}$ and $Q(x)=\\frac{4 x}{3}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{x}{3}\\,\\text{d}x} \\\\  & =e^{\\frac{x^{2}}{6}}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{\\frac{x^{2}}{6}}$ yields\n\n$$\n\\begin{aligned}e^{\\frac{x^{2}}{6}}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{3}y) & =e^{\\frac{x^{2}}{6}}\\cdot \\frac{4 x}{3} \\\\ e^{\\frac{x^{2}}{6}}\\frac{\\text{d}y}{\\text{d}x}+\\frac{x e^{\\frac{x^{2}}{6}}}{3}y & =\\frac{4 x e^{\\frac{x^{2}}{6}}}{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{6}}) & =\\frac{4 x e^{\\frac{x^{2}}{6}}}{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{x^{2}}{6}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{6}})\\,\\text{d}x & =\\int \\frac{4 x e^{\\frac{x^{2}}{6}}}{3}\\,\\text{d}x \\\\ ye^{\\frac{x^{2}}{6}} & =\\int 4e^u\\,\\text{d}u \\\\ ye^{\\frac{x^{2}}{6}} & =4e^u+C \\\\ ye^{\\frac{x^{2}}{6}} & =4 e^{\\frac{x^{2}}{6}}+C \\\\ y & =\\left(C + 4 e^{\\frac{x^{2}}{6}}\\right) e^{- \\frac{x^{2}}{6}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=3$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(4 e^{\\frac{(0)^{2}}{6}})+C}{(e^{\\frac{(0)^{2}}{6}})} \\\\ 3 & =\\frac{4+C}{1} \\\\ C & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=4 - e^{- \\frac{x^{2}}{6}}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=\\frac{x}{3}$ and $Q(x)=\\frac{4 x}{3}.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int \\frac{x}{3}\\,\\text{d}x} \\\\  & =e^{\\frac{x^{2}}{6}}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{\\frac{x^{2}}{6}}$ yields\n\n$$\n\\begin{aligned}e^{\\frac{x^{2}}{6}}\\cdot \\left(\\frac{\\text{d}y}{\\text{d}x}+\\frac{x}{3}y\\right) & =e^{\\frac{x^{2}}{6}}\\cdot \\frac{4 x}{3} \\\\ e^{\\frac{x^{2}}{6}}\\frac{\\text{d}y}{\\text{d}x}+\\frac{x e^{\\frac{x^{2}}{6}}}{3}y & =\\frac{4 x e^{\\frac{x^{2}}{6}}}{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{6}}) & =\\frac{4 x e^{\\frac{x^{2}}{6}}}{3}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x,$ making use of the substitution $u=\\frac{x^{2}}{6}:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{\\frac{x^{2}}{6}})\\,\\text{d}x & =\\int \\frac{4 x e^{\\frac{x^{2}}{6}}}{3}\\,\\text{d}x \\\\ ye^{\\frac{x^{2}}{6}} & =\\int 4e^u\\,\\text{d}u \\\\ ye^{\\frac{x^{2}}{6}} & =4e^u+C \\\\ ye^{\\frac{x^{2}}{6}} & =4 e^{\\frac{x^{2}}{6}}+C \\\\ y & =\\left(C + 4 e^{\\frac{x^{2}}{6}}\\right) e^{- \\frac{x^{2}}{6}}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=3$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(4 e^{\\frac{(0)^{2}}{6}})+C}{(e^{\\frac{(0)^{2}}{6}})} \\\\ 3 & =\\frac{4+C}{1} \\\\ C & =-1\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=4 - e^{- \\frac{x^{2}}{6}}.\n$$"] [:db/cas 17592186495424 :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=1$ and $Q(x)=6.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x)\\,\\text{d}x} \\\\  & =e^{\\int 1\\,\\text{d}x} \\\\  & =e^{x}\\end{aligned}\n$$\n\nMultiplying both sides of the equation in standard form by $I(x)=e^{x}$ yields\n\n$$\n\\begin{aligned}e^{x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+1y) & =e^{x}\\cdot 6 \\\\ e^{x}\\frac{\\text{d}y}{\\text{d}x}+e^{x}y & =6 e^{x} \\\\ \\frac{\\text{d}}{\\text{d}x}(ye^{x}) & =6 e^{x}.\\end{aligned}\n$$\n\nNow, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(ye^{x})\\,\\text{d}x & =\\int 6 e^{x}\\,\\text{d}x \\\\ ye^{x} & =6\\left(1 e^{x}\\right)+C \\\\ ye^{x} & =6 e^{x}+C \\\\ y & =\\left(C + 6 e^{x}\\right) e^{- x}\\end{aligned}\n$$\n\nThis is the general solution. To find the value of $C$ corresponding to the specific solution, we apply the initial condition $y(0)=-6$ as follows:\n\n$$\n\\begin{aligned}y(0) & =\\frac{(6 e^{(0)})+C}{(e^{(0)})} \\\\ -6 & =\\frac{6+C}{1} \\\\ C & =-12\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=6 - 12 e^{- x}.\n$$" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x),\n$$\n\nwith $P(x)=1$ and $Q(x)=6.$\n\nWe compute an integrating factor using the definition:\n\n$$\n\\begin{aligned}I(x) & =e^{\\int P(x